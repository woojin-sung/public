'========================================================================================================================
' 시간별 환전가능 여부
'========================================================================================================================
' 시간구분     06:00 ----------- 08:00 ----------- 09:00 ----------- 15:30 ---- 15:40 ----------- 17:00 ----------- 06:00
' 일반환전     -----------------불가-----------------|------실시간-----|---불가---|---------------시간외--------------|--
' 이종통화환전 -----------------불가-----------------|------실시간-----|---------------------불가------------------------
' 베트남환전   --------불가--------|-------------------------------가능-----------------------------|--------불가--------
	
'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	'-----------------------------------------------
	' 타이틀 초기화
	'-----------------------------------------------
	lblTitle.caption = g_szTitle
	lblTitle.paddinginfo = "0,0,0,0"
	
	nWidth = Form.GetTextWidth(g_szTitle, 3, false, false)
	
	imgTitleArrow.maintainratio = "2" 
	imgTitleArrow.imgpath = g_szArrowImg
	imgTitleArrow.visible = true
	imgTitleArrow.left = 47 + nWidth + 10
	
	'-----------------------------------------------
	' 뒤로가기 버튼 초기화
	'-----------------------------------------------
	imgBack.SetMaintainingRatio("2")
	imgBack.imgpath = g_szBackImg
	
	'-----------------------------------------------
	' 유의사항 버튼 초기화
	'-----------------------------------------------
	imgInfo.SetMaintainingRatio("3")
	imgInfo.imgpath = g_szInfoImg
	
	lblTab0.fgcolor = g_szTxtColor_Normal
	lblTab1.fgcolor = g_szTxtColor_Normal
	
	lblTab0.caption = "외화매수(원화→외화)"
	lblTab1.caption = "외화매도(외화→원화)"
	
	lblTab0.changeTextAttr(4, 7, 333, -2, false, false)
	lblTab1.changeTextAttr(4, 7, 333, -2, false, false)
	
	lblTabBg.imagefilepth = "tab_03_n.9"
	lblTab0.imagefilepth = "tab_03_o.9"
	
	lblTab1.imagefilepth = "empty"
	
	'-----------------------------------------------
	' 목표환율 컨트롤 초기화
	'-----------------------------------------------
	contMain.lblSubTitle04.paddinginfo = "0,0,0,0"
	contMain.lblSubTitle04.fgcolor = g_szTxtColor_Grey
	contMain.lblSubTitle04.caption = "목표환율"
	
	contMain.imgFlag02.maintainratio = "2" 
	szFlag = Form.getIconImg("CRCD", "USD")
	if szFlag = "" then
		szFlag = "flag_general"
	end if
	contMain.imgFlag02.imgpath = szFlag
	
	contMain.lblCrcd02.paddinginfo = "0,0,0,0"
	contMain.lblCrcd02.fgcolor = g_szTxtColor_Normal
	contMain.lblCrcd02.maxlinecnt = "1"
	contMain.lblCrcd02.caption = "1 USD"
	
	contMain.imgArrow02.maintainratio = "1" 
	contMain.imgArrow02.imgpath = g_szArrowImg
	
	nTxtWidth = Form.getTextWidth(contMain.lblCrcd02.caption, 0, true, false)
	contMain.imgArrow02.left = 60 + nTxtWidth + 10
	
	contMain.Image0.maintainratio = "1" 
	contMain.Image0.imgpath = "img_timeline_n.png"
	contMain.Image1.maintainratio = "1" 
	contMain.Image1.imgpath = "img_timeline_n.png"
	
	contMain.lblCrcd02.paddinginfo = "0,0,0,0"
	contMain.lblCrcd02.fgcolor = g_szTxtColor_Normal
	
	contMain.Label0.paddinginfo = "0,0,0,0"
	contMain.Label0.fgcolor = g_szTxtColor_Normal
	contMain.Label0.imagefilepth = "btn_line2_o.9"
	contMain.Label0.caption = "직접입력"
	
	contMain.Label1.paddinginfo = "20,0,5,0"
	contMain.Label1.fgcolor = g_szTxtColor_Grey
	contMain.Label1.maxlinecnt = "1"
	contMain.Label1.imagefilepth = "btn_line2_d.9"
	
	g_szOrderType = "1"
	if g_szOrderType == "1" then
		contMain.Label1.caption = "1주일내 최저"
	elseif g_szOrderType == "2" then
		contMain.Label1.caption = "1주일내 최고"
	end if
	
	contMain.lblAbleAmt0.paddinginfo = "0,0,0,0"
	contMain.lblAbleAmt0.maxlinecnt = "1"
	contMain.lblAbleAmt0.fgcolor = g_szTxtColor_Grey
	
	contMain.lblTargetRate.paddinginfo = "0,0,0,0"
	contMain.lblTargetRate.maxlinecnt = "1"
	contMain.lblTargetRate.fgcolor = g_szTxtColor_Grey2
	
	'-----------------------------------------------
	' 상단영역 컨트롤 초기화
	'-----------------------------------------------
	contMain.lblBg.bgcolor = g_szContBgColor
	contMain.lblDivLine01.bgcolor = g_szLineColor
	
	contMain.lblSubTitle00.paddinginfo = "0,0,0,0"
	contMain.lblSubTitle00.fgcolor = g_szTxtColor_Grey
	contMain.lblSubTitle00.caption = "환전금액"
	
	contMain.lblSubTitle01.paddinginfo = "0,0,0,0"
	contMain.lblSubTitle01.fgcolor = g_szTxtColor_Grey
	contMain.lblSubTitle01.caption = "예상금액"
	
	contMain.imgFlag00.maintainratio = "2" 
	contMain.imgFlag01.maintainratio = "2" 

	contMain.imgArrow00.maintainratio = "1" 
	contMain.imgArrow00.imgpath = g_szArrowImg
	contMain.imgArrow01.maintainratio = "1" 
	contMain.imgArrow01.imgpath = g_szArrowImg
	
	contMain.imgSwap.maintainratio = "1"
	contMain.imgSwap.imgpath = g_szExchangeUpImg
	
	contMain.lblCrcd00.paddinginfo = "0,0,0,0"
	contMain.lblCrcd00.fgcolor = g_szTxtColor_Normal
	
	contMain.lblCrcd01.paddinginfo = "0,0,0,0"
	contMain.lblCrcd01.fgcolor = g_szTxtColor_Normal
	
	contMain.lblExchangeAmt.paddinginfo = "0,0,0,0"
	contMain.lblExchangeAmt.fgcolor = g_szTxtColor_Grey2
	contMain.lblExchangeAmt.maxlinecnt = "1"
	contMain.lblExchangeAmt.caption = "매수금액입력"
	
	contMain.lblExpectAmt.paddinginfo = "0,0,0,0"
	contMain.lblExpectAmt.fgcolor = g_szTxtColor_Grey
	contMain.lblExpectAmt.maxlinecnt = "1"
	contMain.lblExpectAmt.caption = "0"

	
	'-----------------------------------------------
	' 하단영역 컨트롤 초기화
	'-----------------------------------------------
	contMain.lblSubTitle02.paddinginfo = "0,0,0,0"
	contMain.lblSubTitle02.fgcolor = g_szTxtColor_Grey
	contMain.lblSubTitle02.caption = "기간설정"
	
	
	contMain.lblExchangeInfo00.paddinginfo = "0,0,0,0"
	contMain.lblExchangeInfo00.fgcolor = g_szTxtColor_Normal
	contMain.lblExchangeInfo00.caption = "1일"
	
	contMain.lblExchangeInfo01.paddinginfo = "3,0,3,0"
	contMain.lblExchangeInfo01.fgcolor = g_szTxtColor_Red
	
	contMain.lblExchange00.paddinginfo = "0,0,0,0"
	contMain.lblExchange00.fgcolor = g_szTxtColor_Normal
	
	contMain.lblExchange00.caption = ""
	
	contMain.imgRe0.maintainratio = "2"
	contMain.imgRe2.maintainratio = "3"
	
	contMain.imgRe0.imgpath = g_szArrowImg
	contMain.imgRe2.imgpath = g_szRefreshImg
	
	
	contMain.lblLink.paddinginfo = "0,0,0,0"
	contMain.lblLink.fgcolor = g_szTxtColor_Grey
	contMain.lblLink.caption = "실시간 환율 조회 >"
	
	'-----------------------------------------------
	' 유의사항 초기화
	'-----------------------------------------------
	contMain.contInfo.lblInfoTitle.paddinginfo = "0,0,0,0"
	contMain.contInfo.lblInfoTitle.fgcolor = g_szTxtColor_Grey
	
	contMain.contInfo.lblInfo0.paddinginfo = "0,0,0,0"
	contMain.contInfo.lblInfo0.fgcolor = g_szTxtColor_Grey
	contMain.contInfo.lblInfo0.caption = "목표환율환전 신청은 USD, JPY, CNY, HKD만 가능합니다."
	
	contMain.contInfo.lblGuide0.paddinginfo = "0,0,0,0"
	contMain.contInfo.lblGuide0.fgcolor = g_szTxtColor_Grey
	
	contMain.contInfo.lblInfo1.paddinginfo = "0,0,0,0"
	contMain.contInfo.lblInfo1.fgcolor = g_szTxtColor_Grey
	contMain.contInfo.lblInfo1.caption = "설정기간 내 목표환율 도달 전까지 취소 가능하며, 환전 체결이 완료된 경우에는 취소가 불가합니다."
	
	contMain.contInfo.lblGuide1.paddinginfo = "0,0,0,0"
	contMain.contInfo.lblGuide1.fgcolor = g_szTxtColor_Grey
	
	contMain.contInfo.lblInfo2.paddinginfo = "0,0,0,0"
	contMain.contInfo.lblInfo2.fgcolor = g_szTxtColor_Grey
	contMain.contInfo.lblInfo2.caption = "목표환율 도달 시 자동 환전 처리되므로, 신청 후 반드시 환전 처리결과 여부를 확인하시기 바랍니다."
	
	contMain.contInfo.lblGuide2.paddinginfo = "0,0,0,0"
	contMain.contInfo.lblGuide2.fgcolor = g_szTxtColor_Grey
	
	contMain.contInfo.setExceptInvisibleCtl(true)
	contMain.contInfo.setEnableScroll(false)
	
	g_szAcno = acntMain.total
	g_szAsno = acntMain.sequence
	
	btnOk.enable = false
	btnOk.btnimage = "btn_09.9"
	
	szFlag = Form.getIconImg("CRCD", "USD")
	if szFlag = "" then
		szFlag = "flag_general"
	end if
	
	contMain.imgFlag00.imgpath = szFlag
	contMain.lblCrcd00.caption = "USD"

	
	szFlag = Form.getIconImg("CRCD", "KRW")
	if szFlag = "" then
		szFlag = "flag_general"
	end if
	
	contMain.imgFlag01.imgpath = szFlag
	contMain.lblCrcd01.caption = "KRW"
	
	
End Function

'==============================================
' 환전 가능 여부 확인
'==============================================
' szClsCd(조회구분) 
' - 0 : 서버기준 환전신청 실시간/시간외/불가 확인 	(szEvnet, 0, "", "", "", "")
' - 1 : 현재 세팅된 환전신청 타입이 거래 가능한지 	(szEvnet, 1, "", "", szSvcd, "")
' - 2 : 계좌 해외주식 약정체크 						(szEvnet, 2, szAcno, szAsno, "", "")
' - 3 : 외화 잔고 체크 							(szEvnet, 3, szAcno, szAsno, "", szCrcd)
Function Request_Tran_obtsd_fbnk_009r(szEvnet, szClsCd, szAcno, szAsno, szSvcd, szCrcd)
	g_isEnable = false
	g_szClsCd_009r = szClsCd	'조회구분(비동기 처리용)
	g_szEvent_009r = szEvnet	'이벤트명(비동기 처리용)
	
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_009r")
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r", "InBlock1", "IQRY_CLS_CODE", 0 , szClsCd)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r", "InBlock1", "ACNO", 0 , szAcno)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r", "InBlock1", "ASNO", 0 , szAsno)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r", "InBlock1", "SVCD", 0 , szSvcd)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r", "InBlock1", "CRCD", 0 , szCrcd)
	
	DATAMANAGER.RequestTranData("obtsd_fbnk_009r")
End Function

