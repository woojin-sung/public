'==============================================
' 기간별 최저/최고 환율 조회 처리
'==============================================
Function Process_Tran_obtsd_fbnk_233r()
	szExrt = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_233r", "OutBlock1", "STND_EXRT" , 0)

	Input_Target_Rate(g_szOrderType, szExrt)
	
	nAmt = replace(contMain.lblExchangeAmt.caption, ",", "")
	if nAmt <> "매수금액입력" and nAmt <> "매도금액입력" and nAmt <> "" then 
		Input_Amt(g_szAmtGbn, nAmt)
	end if
End Function


'==============================================
' 기간별 최저/최고 환율 조회
'==============================================
Function Request_Tran_obtsd_fbnk_233r(szOrdType, szPeriodType, szCrcd)	
	
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_233r")

	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_233r", "InBlock1", "IQRY_CLS_CODE" , 0 , szPeriodType)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_233r", "InBlock1", "CRCD", 0 , szCrcd)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_233r", "InBlock1", "APLT_CLS_CODE" , 0 , szOrdType)
	
	DATAMANAGER.RequestTranData("obtsd_fbnk_233r")
End Function


'==============================================
' 통화코드 변경 
'==============================================
Function Select_Target_Crcd(szCrcd)
	szFlag = Form.getIconImg("CRCD", szCrcd)
	if szFlag = "" then
		szFlag = "flag_general"
	end if
	
	g_nExRate_Target = 0
	
	g_szCrcd_Target = szCrcd
	
	contMain.imgFlag02.imgpath = szFlag
	
	if szCrcd == "JPY" then
		contMain.lblCrcd02.caption = "100 " & szCrcd
	else
		contMain.lblCrcd02.caption = "1 " & szCrcd
	end if
	
	contMain.imgFlag00.imgpath = szFlag
	contMain.lblCrcd00.caption = szCrcd
	
	nTxtWidth = Form.getTextWidth(contMain.lblCrcd02.caption, 0, true, false)
	contMain.imgArrow02.left = 60 + nTxtWidth + 10
	
	Input_Amt("1", "")
	
	'환율 조회
	g_szPeriodType = ""
	
	if g_szAcno <> "" then
		Request_Tran_obtsd_fbnk_009r_1()
	end if
End Function

Function Request_ExchangeRate()
	'환전(매수/매도)
	if g_szCrcd_Sell == "KRW" or g_szCrcd_Buy == "KRW" then
		
		'원화 매수/매도 여부에 따라 환전환율 대응
		if g_szCrcd_Sell == "KRW" then
			Request_Tran_obtsd_fbnk_201r(g_szCrcd_Buy)	
			
		elseif g_szCrcd_Buy = "KRW" then
			Request_Tran_obtsd_fbnk_201r(g_szCrcd_Sell)	
		end if
	
	'이종통화(매수/매도)
	else
		
		if g_szCrcd_Sell == "VND" or g_szCrcd_Buy == "VND" then 
			if g_szExStep == "Step1" then
				Form.openPopupAnimation("pwdcheckpopup", g_szAcno & g_szAsno & "☆0" ,"","2")
			end if
		else
			
			Request_Tran_obtsd_fbnk_201r(g_szCrcd_Sell)
			Request_Tran_obtsd_fbnk_201r(g_szCrcd_Buy)
		end if
	end if
End Function

Function Process_Retry_ExchangeRate()
	
	if g_szCrcd_Sell == "KRW" or g_szCrcd_Buy == "KRW" then
		
		if g_szExStep == "Step1`Y" then
			Form.openPopupAnimation("pwdcheckpopup", g_szAcno & g_szAsno & "☆0" ,"","2")
			
		elseif g_szExStep == "Step1`N" then
			Form.MsgBox("알림", "환율이 변동되었습니다.\n최근 환율로 재 조회 후 환전 신청을 진행해주세요.", "StepBack", 6)
		end if
	
	'이종통화(매수/매도)
	else
		if g_szCrcd_Sell == "VND" or g_szCrcd_Buy == "VND" then 
			'none
		else
			if g_szExStep == "Step1`Y`Y" then
				Form.openPopupAnimation("pwdcheckpopup", g_szAcno & g_szAsno & "☆0" ,"","2")
				
			elseif g_szExStep == "Step1`N`Y" or g_szExStep == "Step1`Y`N" or g_szExStep == "Step1`N`N" then
				Form.MsgBox("알림", "환율이 변동되었습니다.\n최근 환율로 재 조회 후 환전 신청을 진행해주세요.", "StepBack", 6)
			
			end if
		end if
	end if
End Function

Function Input_Amt(szGbn, szAmt)
	if szAmt <> "" then
		Request_Tran_obtsd_fbnk_008r("1", g_szOrderType, "1", szAmt)
		
		szResult = ""
		szResult = Convert_FormatNumber(g_szCrcd_Target, szAmt)
		
		contMain.lblExchangeAmt.fgcolor = g_szTxtColor_Normal
		contMain.lblExchangeAmt.caption = szResult
		
		'Request_Tran_obtsd_fbnk_008r(Cdbl(szAmt), "")	
		
'		nResult = Cdbl(szAmt) * g_nExRate_Target
'		truncateToDecimalPlaces(nResult, 0)
'		
'		contMain.lblExpectAmt.caption = Convert_FormatNumber("KRW", szAmt)
	else
		contMain.lblExchangeAmt.fgcolor = g_szTxtColor_Grey2
		if g_szOrderType == "1" then
			contMain.lblExchangeAmt.caption = "매수금액입력"
		elseif g_szOrderType = "2" then
			contMain.lblExchangeAmt.caption = "매도금액입력"
		end if
		
		contMain.lblExpectAmt.fgcolor = g_szTxtColor_Grey
		contMain.lblExpectAmt.caption = "0"
	end if

	Check_Order()
	g_szAmtGbn = ""
End Function

Function Input_Target_Rate(szGbn, szRate)
	if szGbn == "1" then
		if szRate <> "" then
			g_nExRate_Target = Cdbl(szRate)
			szResult = FormatNumber(szRate,2)
			
			contMain.lblTargetRate.fgcolor = g_szTxtColor_Normal
			contMain.lblTargetRate.caption = szResult & "원 이하"

		else
			g_nExRate_Target = 0
			contMain.lblTargetRate.fgcolor = g_szTxtColor_Grey2
			contMain.lblTargetRate.caption =  FormatNumber(g_nExRate_Base, 2) & "원 이하"
		end if
	elseif szGbn == "2" then
		if szRate <> "" then
			g_nExRate_Target = Cdbl(szRate)
			szResult = FormatNumber(szRate,2)
			
			contMain.lblTargetRate.fgcolor = g_szTxtColor_Normal
			contMain.lblTargetRate.caption = szResult & "원 이상"

		else
			g_nExRate_Target = 0
			contMain.lblTargetRate.fgcolor = g_szTxtColor_Grey2
			contMain.lblTargetRate.caption =  FormatNumber(g_nExRate_Base, 2) & "원 이상"
		end if
	end if
	
	Check_Order()
End Function

Function Calc_Exchange(szGbn, nAmt)
	'매도금액 입력
	if szGbn == "0" then
		if g_szCrcd_Sell == "KRW" then 
			
			if g_nExRate_Base <> 0 then
				nResult1 = round(nAmt / g_nExRate_Base, 6)
				nResult2 = 0
				if g_szCrcd_Buy == "JPY" then
					nResult2 = truncateToDecimalPlaces(nResult1, 0)
				else
					nResult2 = truncateToDecimalPlaces(nResult1, 2)
				end if
				
				contMain.lblExpectAmt.fgcolor = g_szTxtColor_Normal
				contMain.lblExpectAmt.caption = Convert_FormatNumber(g_szCrcd_Buy, nResult2)
				
				nResult_Reverse = int(nResult2 * g_nExRate_Base)
				
				contMain.lblExchangeAmt.fgcolor = g_szTxtColor_Normal
				contMain.lblExchangeAmt.caption = Convert_FormatNumber(g_szCrcd_Sell, nResult_Reverse)
			end if
			
		elseif g_szCrcd_Buy == "KRW" then 
			
			if g_nExRate_Base <> 0 then
				nResult1 = nAmt * g_nExRate_Base
				nResult2 = truncateToDecimalPlaces(nResult1, 0)
				
				contMain.lblExpectAmt.fgcolor = g_szTxtColor_Normal
				contMain.lblExpectAmt.caption = Convert_FormatNumber(g_szCrcd_Buy, nResult2)
			end if
		else
			if g_nExRate_Base <> 0 and g_nExRate_2 <> 0 then
				nResult1 = nAmt * g_nExRate_Base
				nResult2 = truncateToDecimalPlaces(nResult1, 0)
				
				nResult3 = round(nResult2 / g_nExRate_2, 6)
				nResult4 = 0 
				
				if g_szCrcd_Buy == "JPY" then
					nResult4 = truncateToDecimalPlaces(nResult3, 0)
				else
					nResult4 = truncateToDecimalPlaces(nResult3, 2)
				end if
				
				contMain.lblExpectAmt.fgcolor = g_szTxtColor_Normal
				contMain.lblExpectAmt.caption = Convert_FormatNumber(g_szCrcd_Buy, nResult4)
			end if
		end if
		
	'매수금액 입력
	elseif szGbn == "1" then
		if g_szCrcd_Sell == "KRW" then 
			
			if g_nExRate_Base <> 0 then
				nResult = int(nAmt * g_nExRate_Base)
					
				contMain.lblExchangeAmt.fgcolor = g_szTxtColor_Normal
				contMain.lblExchangeAmt.caption = Convert_FormatNumber(g_szCrcd_Sell, nResult)
			end if
			
		elseif g_szCrcd_Buy == "KRW" then 
			
			if g_nExRate_Base <> 0 then
				nResult1 = round(nAmt / g_nExRate_Base, 6)
				nResult2 = 0
				
				if g_szCrcd_Sell == "JPY" then
					nResult2 = truncateToDecimalPlaces(nResult1, 0)
				else
					nResult2 = truncateToDecimalPlaces(nResult1, 2)
				end if
				
				nResult_Reverse = round(nResult2 * g_nExRate_Base, 0)
				
				if nAmt > nResult_Reverse then
					if g_szCrcd_Sell == "JPY" then
						'none
					else
						nResult2 = nResult2 + 0.01
					end if
				end if
				
				contMain.lblExchangeAmt.fgcolor = g_szTxtColor_Normal
				contMain.lblExchangeAmt.caption = Convert_FormatNumber(g_szCrcd_Sell, nResult2)
				
				nResult_Reverse = int(nResult2 * g_nExRate_Base)
				
				contMain.lblExpectAmt.fgcolor = g_szTxtColor_Normal
				contMain.lblExpectAmt.caption = Convert_FormatNumber(g_szCrcd_Buy, nResult_Reverse)
			end if
		else
			if g_nExRate_Base <> 0 and g_nExRate_2 <> 0 then
				nResult1 = nAmt * g_nExRate_2
				nResult2 = truncateToDecimalPlaces(nResult1, 0)
				
				nResult3 = round(nResult2 / g_nExRate_Base, 6)
				nResult4 = 0 
				
				if g_szCrcd_Sell == "JPY" then
					nResult4 = truncateToDecimalPlaces(nResult3, 0)
				else
					nResult4 = truncateToDecimalPlaces(nResult3, 2)
				end if
				
				contMain.lblExchangeAmt.fgcolor = g_szTxtColor_Normal
				contMain.lblExchangeAmt.caption = Convert_FormatNumber(g_szCrcd_Sell, nResult4)
				
				nResult_Reverse1 = int(nResult4 * g_nExRate_Base)
				
				nResult_Reverse2 = round(nResult_Reverse1 / g_nExRate_2, 6)
				nResult_Reverse3 = 0
				
				if g_szCrcd_Buy == "JPY" then
					nResult_Reverse3 = truncateToDecimalPlaces(nResult_Reverse2, 0)
				else
					nResult_Reverse3 = truncateToDecimalPlaces(nResult_Reverse2, 2)
				end if
				
				contMain.lblExpectAmt.fgcolor = g_szTxtColor_Normal
				contMain.lblExpectAmt.caption = Convert_FormatNumber(g_szCrcd_Buy, nResult_Reverse3)
				
			end if
		end if
	end if
	
End Function


Function truncateToDecimalPlaces(nVal, nDeimalPlaces)
	nFactor = 10 ^ nDeimalPlaces
	return int(nVal*nFactor) / nFactor
End Function

Function Convert_FormatNumber(szCrcd, szAmt)
	if szCrcd == "KRW" or szCrcd == "JPY" then
		return FormatNumber(szAmt, 0) 
	else
		return FormatNumber(szAmt, 2)
	end if
End Function


Function Swap_OrderType()	
'	Select_Crcd("2", g_szCrcd_Buy, g_szCrcd_Sell)
End Function

Function Select_TargetType(szOrdType, szPeriodType)
	if szPeriodType == "" then
		g_isEnable_Target = true
		contMain.Label0.fgcolor = g_szTxtColor_Normal
		contMain.Label0.imagefilepth = "btn_line2_o.9"
		
		contMain.Label1.fgcolor = g_szTxtColor_Grey
		contMain.Label1.imagefilepth = "btn_line2_d.9"
		
		if szOrdType == "1" then
			contMain.Label1.caption = "1주일내 최저"
		elseif szOrdType == "2" then
			contMain.Label1.caption = "1주일내 최고"
		end if
		
		contMain.Image0.imgpath = "img_timeline_n.png"
		contMain.Image1.imgpath = "img_timeline_n.png"
		
		Input_Target_Rate(g_szOrderType, "")
		
	elseif szPeriodType == "1" then
		g_isEnable_Target = false
		
		contMain.Label0.fgcolor = g_szTxtColor_Grey
		contMain.Label0.imagefilepth = "btn_line2_d.9"
		
		contMain.Label1.fgcolor = g_szTxtColor_Normal
		contMain.Label1.imagefilepth = "btn_line2_o.9"
		
		if szOrdType == "1" then
			contMain.Label1.caption = "1주일내 최저"
			
			contMain.Image0.imgpath = "img_timeline_o.png"
			contMain.Image1.imgpath = "img_timeline_n.png"
			
		elseif szOrdType == "2" then
			contMain.Label1.caption = "1주일내 최고"
			
			contMain.Image0.imgpath = "img_timeline_o.png"
			contMain.Image1.imgpath = "img_timeline_n.png"
		end if
		
		Request_Tran_obtsd_fbnk_233r(g_szOrderType, g_szPeriodType, g_szCrcd_Target)
	elseif szPeriodType == "2" then
		g_isEnable_Target = false
		
		contMain.Label0.fgcolor = g_szTxtColor_Grey
		contMain.Label0.imagefilepth = "btn_line2_d.9"
		
		contMain.Label1.fgcolor = g_szTxtColor_Normal
		contMain.Label1.imagefilepth = "btn_line2_o.9"
		
		if szOrdType == "1" then
			contMain.Label1.caption = "1개월내 최저"
			
			contMain.Image0.imgpath = "img_timeline_n.png"
			contMain.Image1.imgpath = "img_timeline_o.png"
			
		elseif szOrdType == "2" then
			contMain.Label1.caption = "1개월내 최고"
			
			contMain.Image0.imgpath = "img_timeline_n.png"
			contMain.Image1.imgpath = "img_timeline_o.png"
		end if
		
		Request_Tran_obtsd_fbnk_233r(g_szOrderType, g_szPeriodType, g_szCrcd_Target)
	end if
End Function

Function Check_Order()
	szAmt = replace(contMain.lblExchangeAmt.caption, ",", "")
	
	if szAmt == "매수금액입력" or szAmt == "매도금액입력" then
		szAmt = 0
	else
		szAmt = Cdbl(szAmt)
	end if
	
	if Cdbl(g_nExRate_Target) > 0 and szAmt > 0 then
		btnOk.enable = true
		btnOk.btnimage = "btn_20.9"
		btnOk.fgcolor = g_szTxtColor_White
	else
		btnOk.enable = false
		btnOk.btnimage = "btn_09.9"
		btnOk.fgcolor = g_szTxtColor_Grey
	end if
End Function

Function DisplaySetting_Info()
	nLineCnt0 = contMain.contInfo.lblInfo0.linecnt
	nLineCnt1 = contMain.contInfo.lblInfo1.linecnt
	nLineCnt2 = contMain.contInfo.lblInfo2.linecnt
	
	szTextSize = Form.getEnvData("common.textsize")
	szOsType = Form.GetSharedData("&OS_TYPE", false)
	
	nGap = 1
	
	if szOsType == "1" then
		nGap = 1
	elseif szOsType == "2" then
		nGap = 3
	end if
	
	nHeight = 18 + (cint(szTextSize) * nGap)
	
	'showalert nLineCnt0 .. "|" .. nLineCnt1 .. "|" .. nLineCnt2
	
	contMain.contInfo.lblInfo0.height = nLineCnt0 * nHeight
	
	contMain.contInfo.lblInfo1.top = 34 + nLineCnt0 * nHeight + 2
	contMain.contInfo.lblGuide1.top = 34 + nLineCnt0 * nHeight + 2
	contMain.contInfo.lblInfo1.height = nLineCnt1 * nHeight
	
	contMain.contInfo.lblInfo2.top = 34 + nLineCnt0 * nHeight  + 2 + nLineCnt1 * nHeight + 2
	contMain.contInfo.lblGuide2.top = 34 + nLineCnt0 * nHeight + 2 + nLineCnt1 * nHeight + 2
	contMain.contInfo.lblInfo2.height = nLineCnt2 * nHeight
	
	contMain.contInfo.height = 34 + nLineCnt0 * nHeight + 2 + nLineCnt1 * nHeight + 2 + nLineCnt2 * nHeight + 20
	
	contMain.setScrollAutoSize()
End Function
