'===============================================
' Form_OnPopupReturn
'===============================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "SELECT_CRCD" then
		if g_szCrcdGbn == "2" then
			Select_Target_Crcd(sRet)
		end if
		
		Request_Tran_obtsd_fbnk_009r("SELECT_CRCD", "4", "", "", "", g_szCrcd_Target)
		Request_Tran_obtsd_fbnk_009r_2()
	elseif sKeyName = "INPUT_AMT" then
		if sRet == "Cancel" then
			g_szAmtGbn = "" 
			Exit Sub
		end if
		
		Input_Amt(g_szAmtGbn, sRet)
		
	elseif sKeyName = "INPUT_TARGET_RATE" then
		if sRet == "Cancel" then
			g_nExRate_Target = 0 
			Exit Sub
		end if
	
		Input_Target_Rate(g_szOrderType, sRet)
		
		nAmt = replace(contMain.lblExchangeAmt.caption, ",", "")
		if nAmt <> "매수금액입력" and nAmt <> "매도금액입력" and nAmt <> "" then 
			Input_Amt(g_szAmtGbn, nAmt)
		end if
		
	elseif sKeyName = "PERIOD_SET" then
		arrRet = split(sRet, "@")
		
		if #arrRet > 2 then
			SettingDisplay_Period(arrRet(0), arrRet(1), arrRet(2))
		end if
	elseif sKeyName = "EXCHANGE_INFO_RETURN" then
		'시간외환전 안내팝업 리턴
		if sRet == "0" then
			if g_szEvent_009r == "FORM_INIT" or g_szEvent_009r == "CHANGE_ACCOUNT" then
				Request_Tran_obtsd_fbnk_009r(g_szEvent_009r, "2", g_szAcno, g_szAsno, "", "")
			else
				'컨트롤 입력 가능
				g_isEnable = true
			end if
		end if
	
	elseif sKeyName = "EXCHANGE_STEP0" then
			
		if sRet = "OK" then
			g_szExStep = "Step1"
			Form.openPopupAnimation("pwdcheckpopup", g_szAcno & g_szAsno & "☆0" ,"","2")
		end if
		
	elseif sKeyName = "EXCHANGE_END" then
		' 초기설정 값(원화>달러)
'		Select_Crcd("2", "KRW", "USD")
		Select_Target_Crcd("USD")
		Request_Tran_obtsd_fbnk_009r("FORM_INIT", "4", "", "", "", g_szCrcd_Target)
		Request_Tran_obtsd_fbnk_009r_2()
		
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim tData
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
				g_szPwd = tData(0)
			end if
			
			g_szExStep = "Step2"
			
			szCertUserType= Form.GetSharedData("&CERT_USE_TYPE", false )
			
			If szCertUserType == "1" Or szCertUserType == 1 Then 
			    Form.OpenFramePopup( "mhetc90060_px" , "" , "")
			Else
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
			End if
		end if
		
	elseif sKeyName = "mhetc90060_p5" or sKeyName = "mhetc90060_px" then
		if sRet == "ok" then
			
			g_szExStep = "Step3"
			
			
			Request_Tran_obtsd_fbnk_231a()	
				
		
		else
			exit sub
		end if
	elseif sKeyName == "해외주식거래신청" then
		if sRet == "ok" then
			Form.OpenScreen("87051", "")
		end if
	end if
End Sub

