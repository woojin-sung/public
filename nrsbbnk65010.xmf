'===============================================
' Form_OnTimerEvent
' 화면 진입 시, 환전가능여부 체크
'===============================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(sTimerID, 0, 0)
	
	if Cint(sTimerID) == 1 then
		DisplaySetting_Info()
		
		' 초기설정 값(원화>달러)
		Select_Target_Crcd("USD")
		
		if g_szAcno == "" then
			g_isEnable = false
		else
			Request_Tran_obtsd_fbnk_009r("FORM_INIT", "4", "", "", "", g_szCrcd_Target)
			Request_Tran_obtsd_fbnk_009r_2()
		end if
		
	elseif Cint(sTimerID) == 2 then
		DisplaySetting_Info()
		
		' 초기설정 값(원화>달러)
		if g_szCrcd_Target == "" then
			Select_Target_Crcd("USD")
		else
			Select_Target_Crcd(g_szCrcd_Target)
		end if
		
		if g_szAcno == "" then
			g_isEnable = false
		else
			Request_Tran_obtsd_fbnk_009r("FORM_INIT", "4", "", "", "", g_szCrcd_Target)
			Request_Tran_obtsd_fbnk_009r_2()
		end if
	end if
End Sub

