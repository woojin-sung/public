'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
DIM g_szCom, g_szAss, g_szLP
Dim g_Count
Dim g_JongCode
Dim g_foldFlag
Dim g_GridIndex
Dim g_szSelectedItem	'그리드 선택된 아이템

Dim g_IsNext
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData( "ohhts_0502_001r" )
	DATAMANAGER.RequestTranData( "ohhts_0503_001r" )
	DATAMANAGER.RequestTranData( "ohhts_0500_001r" )
	DATAMANAGER.RequestTranData( "ohhts_3810_001r" )
	contSrh.cmbAss.caption ="기초자산"
	contSrh.cmbCom.caption = "발행사"
	contSrh.cmbEnd.caption = "만기일"
	contSrh.cmbLP.caption = "LP"
	contSrh.cmbPay.caption = "결제방법"
	contSrh.cmbPrc.caption = "행사가"
	contSrh.cmbRgt.caption = "권리유형"
	contSrh.cmbStd.caption = "상장일"
	contSrh.cmbSty.caption = "잔존일"
	g_foldFlag = 0
	g_GridIndex = 0
	g_IsNext = 0
	
	contBtn_btnFold_OnClick()
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "ohhts_3810_001r" then
		
	   if contSrh.cmbSty.currentindex = "0" then
	      DATAMANAGER.SetDataValue( 0 , "ohhts_3810_001r", "InBlock1", "FID_INPUT_RMNN_DYNU2" , 0 , "0" ) '잔존일설정값
	    
	   elseif contSrh.cmbSty.currentindex = "1" then
	      DATAMANAGER.SetDataValue( 0 , "ohhts_3810_001r", "InBlock1", "FID_INPUT_RMNN_DYNU2" , 0 , "5" )
	     
	   elseif contSrh.cmbSty.currentindex = "2" then
	      DATAMANAGER.SetDataValue( 0 , "ohhts_3810_001r", "InBlock1", "FID_INPUT_RMNN_DYNU2" , 0 , "10" ) 
	      
	   else 
	      DATAMANAGER.SetDataValue( 0 , "ohhts_3810_001r", "InBlock1", "FID_INPUT_RMNN_DYNU2" , 0 , "999999" )
	   end if 
 	   DATAMANAGER.SetDataValue( 0, "ohhts_3810_001r", "InBlock1", "FID_INPUT_TRGT_CLS_CODE" , 0 , "111111111" ) '검색조건 체크값
	end if   
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	DATAMANAGER.CancelRealData( "ohhts_elw_cntg" )
	if szTranID = "ohhts_0502_001r" then
	    ncnt = DATAMANAGER.GetDataCount( 0 ,  "ohhts_0502_001r", "OutBlock1" )
	    for i = 1 to ncnt-1
           contSrh.cmbCom.cbadddatatext = DATAMANAGER.GetDataValue( 0 , "ohhts_0502_001r", "OutBlock1", "FID_ELW_PBLC_CO_CODE", i )&"`"&DATAMANAGER.GetDataValue( 0 , "ohhts_0502_001r", "OutBlock1", "FID_ELW_PBLC_CO_NAME", i )
'	       g_szCom = g_szCom & "\r\n" & DATAMANAGER.GetDataValue( 0 , "ohhts_0502_001r", "OutBlock1", "FID_ELW_PBLC_CO_CODE", i )&"`"&DATAMANAGER.GetDataValue( 0 , "ohhts_0502_001r", "OutBlock1", "FID_ELW_PBLC_CO_NAME", i )
	    next
'	    cmbCom.cbinputdatatext = g_szCom
		contSrh.cmbCom.caption = "발행사"
	end if     
	if szTranID = "ohhts_0503_001r" then
	    ncnt1 = DATAMANAGER.GetDataCount( 0 ,  "ohhts_0503_001r", "OutBlock1" )
	    for i = 1 to ncnt1-1
	       contSrh.cmbLP.cbadddatatext = DATAMANAGER.GetDataValue( 0 , "ohhts_0503_001r", "OutBlock1", "FID_MBCR_NO", i )&"`"&DATAMANAGER.GetDataValue( 0 , "ohhts_0503_001r", "OutBlock1", "FID_MBCR_NAME", i )
'	       g_szLP = g_szLP & vbNEWLINE & DATAMANAGER.GetDataValue( 0 , "ohhts_0503_001r", "OutBlock1", "FID_MBCR_NO", i )&"`"&DATAMANAGER.GetDataValue( 0 , "ohhts_0503_001r", "OutBlock1", "FID_MBCR_NAME", i )
	    next
'	    cmbLP.cbinputdatatext = g_szLP
		contSrh.cmbLP.caption = "LP"
	end if 
    if szTranID = "ohhts_0500_001r" then
	    ncnt2 = DATAMANAGER.GetDataCount( 0 ,  "ohhts_0500_001r", "OutBlock1" )
	    for i = 0 to ncnt2-1
	       contSrh.cmbAss.cbadddatatext = DATAMANAGER.GetDataValue( 0 , "ohhts_0500_001r", "OutBlock1", "FID_UNAS_SHRN_ISCD", i )&"`"&DATAMANAGER.GetDataValue( 0 , "ohhts_0500_001r", "OutBlock1", "FID_UNAS_ISNM", i )
'	       g_szAss = g_szAss & vbNEWLINE & DATAMANAGER.GetDataValue( 0 , "ohhts_0500_001r", "OutBlock1", "FID_UNAS_SHRN_ISCD", i )&"`"&DATAMANAGER.GetDataValue( 0 , "ohhts_0500_001r", "OutBlock1", "FID_UNAS_ISNM", i )
	    next
'	    cmbAss.cbinputdatatext = g_szAss
		contSrh.cmbAss.caption ="기초자산"
	end if 
End Sub



'============================================================================
' 20160323 추가
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "ohhts_3810_001r" then
		Dim nRow
		Dim szName, szPrc
		
		if g_IsNext == 0 then
			g_GridIndex = 0
		end if	
		g_IsNext = 0

		nRow = DATAMANAGER.GetDataCount(0, "ohhts_3810_001r", "OutBlock1")
		
		For i = 0 to nRow - 1
			szName = Trim(DATAMANAGER.GetDataValue(0, "ohhts_3810_001r", "OutBlock1", "FID_UNAS_ISNM", i))
			szPrc  = Trim(DATAMANAGER.GetDataValue(0, "ohhts_3810_001r", "OutBlock1", "FID_EXER_PRC",  i))
			
			if szPrc == "" then
				szPrc = 0
			end if
			
			if szName <> "코스피200지수" then
				szPrc = CInt(szPrc)
				contBtn.Grid0.SetCellData("bd_cell8", g_GridIndex, szPrc)
				
			end if
			g_GridIndex = g_GridIndex + 1
		Next
	End IF 
End Sub


