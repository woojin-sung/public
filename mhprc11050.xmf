'============================================================================
Sub contBtn_Grid0_OnHeaderClickUp(lRow, szCellID)
	If szCellID = "th_cell2" then
	   contBtn.Grid0.SetVisibleCol( 3, 0 )
	   contBtn.Grid0.SetVisibleCol( 4, 1 )
	ElseIf szCellID = "th_cell18" then
	   contBtn.Grid0.SetVisibleCol( 4, 0 )
	   contBtn.Grid0.SetVisibleCol( 3, 1 )   
	End If   
End Sub

'============================================================================
Sub contBtn_btnFold_OnClick()
	if g_foldFlag = 0 then
	   contBtn.btnFold.btnimage = "btn_filter.9.png"
	   
	   'contSrh.visible= false'contSrh.left = 376
	   contSrh.height =50
	   contSrh.cmbRgt.visible= false
	   contSrh.cmbLP.visible= false
	   contSrh.cmbPrc.visible= false
	   contSrh.cmbStd.visible= false
	   contSrh.cmbEnd.visible= false
	   contSrh.cmbSty.visible= false
	   	   
	   contBtn.top = 54
	   contBtn.Grid0.height = 457  
	   contBtn.height = 508
	   'Form.SetCtlPropEx( 'szCtlName, szPropName, szParam, szValue )Form.SetCtlProp( 'szCtlName, szPropName, szValue ) 
	   g_foldFlag = 1
	else 
	   contBtn.btnFold.btnimage = "btn_filter2.9.png"
	   'contSrh.visible= true'contSrh.left = 0
	   contSrh.height = 141
	   contSrh.cmbRgt.visible= true
	   contSrh.cmbLP.visible= true
	   contSrh.cmbPrc.visible= true
	   contSrh.cmbStd.visible= true
	   contSrh.cmbEnd.visible= true
	   contSrh.cmbSty.visible= true
	   
	   contBtn.top = 141
	   contBtn.Grid0.height = 370
	   contBtn.height = 421
	   g_foldFlag = 0
	end if    
End Sub


'============================================================================
Sub contBtn_Grid0_OnClickUp(lRow, szCellID)
	g_szSelectedItem	= contBtn.Grid0.GetCellData( "bd_cell36", lRow )

	listLocation =  Split(contBtn.Grid0.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	sPopupType = "0"

	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "차트" & "★" & "관심등록" & "★" & "매수" & "★" & "매도")

End Sub

'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim szListItems
	
	if sKeyName = "MOVEPOP_RETURN"	then
		szListItems	=	split(sRet,"★")
		
		if	szListItems(1)	=	"0"	then			'현재가
			Form.OpenScreen("11000" , g_szSelectedItem & "★" & "0") 
		elseif	szListItems(1)	=	"1"	then		'차트
			Form.OpenScreen("11000" , g_szSelectedItem & "★" & "3") 
		elseif 	szListItems(1)	=	"2"	then		'관심등록?-종목편집?
		    'Form.OpenScreen("11010" , g_szSelectedItem & "★" & "4") 
		    Form.OpenPopup("mhprc11000_pd" , g_szSelectedItem , "")
		elseif 	szListItems(1)	=	"3"	then		'매수
			Form.OpenScreen("12000" , "기타" &  "★" & "0" &  "★"& g_szSelectedItem) 
		elseif 	szListItems(1)	=	"4"	then		'매도
			Form.OpenScreen("12000" , "기타" &  "★" & "1" &  "★"& g_szSelectedItem) 
		else
		end if
	end if 
End Sub
