		<IMAGE name="imgBtn" autosize="1" imgpath="img_bground_12_5.9" ly_vert="272,8,90,26,1" />
		<LABEL name="lblBtn" fgcolor="062:255255255" fontsize="-2" caption="자주하는 질문" halign="1" click="1" ly_vert="272,8,90,26,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="7129" _ulen="6915" >
'============================================================================
' 01. 화 면 명 : 제안하기
' 02. 작    성 : 신명준
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nNextFlag
Dim g_WHOL_CPNO

'===========================================================================
' 							FORM 함수
'============================================================================
Sub Form_OnFormInit()
	Form.SetTitleCaption("고객의 소리(제안/문의)")
	
	Container0.Table2.SetCellString(1 , 2,  Mid(Calendar0.caption,1,4) & "." & Mid(Calendar0.caption,5,2) & "." &  Mid(Calendar0.caption,7,2) & " 기준"  )
	
	DATAMANAGER.RequestTranData("obcpp_cbbs_001r")
	DATAMANAGER.RequestTranData("obcpp_cbbs_004r")
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mbcpp11000" then
		
		if sRet == "REFRESH" then
			Container0.Grid0.rowcount = 0
			DATAMANAGER.RequestTranData("obcpp_cbbs_001r")
			DATAMANAGER.RequestTranData("obcpp_cbbs_004r")
		end if
	end if
	
End Sub

'===========================================================================
' 							DATAMANAGER 함수
'===========================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim STA_DATE, FIN_DATE
	STA_DATE = Left(Form.GetSharedData("&HOST_DATE", false), 6)

	if szTranID == "obcpp_cbbs_001r" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "IQRY_CLS_CODE", 	0, "1")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CLMN_TYPE_NAME", 	0, "")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "STA_DATE", 		0, "11110101")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "FIN_DATE", 		0, "99991231")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ELFN_ID", 		0, Form.GetSharedData("&USER_ID", false))
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "VC_TYPE_CODE", 		0, "%")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "EXMN_RSLT_CODE", 		0, "%")		
		
	elseif szTranID == "obcpp_cbbs_004r" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "REG_DATE", 	0, Calendar0.caption )
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcpp_cbbs_001r" then
		Dim nCnt, nRowCnt
		nCnt 	= DATAMANAGER.GetDataCount(false, szTranID, "OutBlock1")
		nRowCnt	= Container0.Grid0.rowcount
		
		if CInt(nCnt) > 0 and DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "PROP_REG_ID", 0) <> "" then
			Dim x, y
			
			Container0.Grid0.visible		= true
			Container0.Label0.visible	= false

			for i = 0 to nCnt - 1
				TITL_NAME			= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TITL_NAME",				i)
				REG_DATE 			= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "REG_DATE",					i)
				ANSR_REG_YN			= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ANSR_REG_YN",				i)
				g_WHOL_CPNO			= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "WHOL_CPNO",				i)
				PROP_REG_ID			= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "PROP_REG_ID",				i)
				
				if ANSR_REG_YN == "Y" then
					ANSR_REG_YN = "답변완료"
				else
					ANSR_REG_YN = "접수중"
				end if

				Container0.Grid0.AddRow()
				Container0.Grid0.SetCellData("BD_TITL_NAME", 				nRowCnt + i,	TITL_NAME)
				Container0.Grid0.SetCellData("BD_REG_DATE", 				nRowCnt + i,	REG_DATE)
				Container0.Grid0.SetCellData("BD_ANSR_REG_YN", 				nRowCnt + i,	ANSR_REG_YN)
				Container0.Grid0.SetCellData("BD_PROP_REG_ID",				nRowCnt + i,	PROP_REG_ID)
			next
			
			g_nNextFlag = DATAMANAGER.IsMoreNextData(szTranID)
		else
			g_WHOL_CPNO		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "WHOL_CPNO", i)
			Container0.Grid0.visible		= false
			Container0.Label0.visible	= true
		end if
	elseif  szTranID == "obcpp_cbbs_004r" then
	
		Container0.Table2.SetCellString(2, 3, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "UI_1_CSNU",				0)) '전일접속건수
		Container0.Table2.SetCellString(2, 4, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "UI_4_CSNU",				0)) '전일답변등록건수
		
		Container0.Table2.SetCellString(3, 3, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "UI_2_CSNU",				0)) '일주일접속건수
		Container0.Table2.SetCellString(3, 4, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "UI_5_CSNU",				0)) '일주일답변등록건수
		
		Container0.Table2.SetCellString(4, 3, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "UI_3_CSNU",				0)) '한달접속건수
		Container0.Table2.SetCellString(4, 4, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "UI_6_CSNU",				0)) '한달답변등록건수
		
		'Form.ShowAlert ("test", DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "UI_1_CSNU",				0) )
	end if
	
End Sub	

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szSubMsg <> null and szSubMsg <> "" then
		Form.ShowAlert( "안내" , szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert( "안내" , szErrMsg)
	end if
	
End Sub

'============================================================================
' 							CONTORL 함수
'============================================================================
' 게시글 조회
'============================================================================
Sub Container0_Grid0_OnClickUp(lRow, szCellID)	
	Dim PROP_REG_ID
	PROP_REG_ID = Container0.Grid0.GetCellData("BD_PROP_REG_ID", lRow)
	
	if Container0.Grid0.GetCellData("BD_ANSR_REG_YN", lRow) == "답변완료" then
		Form.OpenPopup("mbcpp11000_p2", PROP_REG_ID, "")
	else		
		Form.OpenPopup("mbcpp11000_p3", PROP_REG_ID, "")
	end if
	
End Sub

'============================================================================
' 게시글 스크롤 엔드
'============================================================================
Sub Container0_Grid0_OnScrollEnd()

	if g_nNextFlag == "1" or g_nNextFlag == true then
		DATAMANAGER.RequestNextData("obcpp_cbbs_001r")
	end if
	
End Sub

'============================================================================
' 제안하기 버튼
'============================================================================
Sub Button0_OnClick()
	Form.OpenPopup("mbcpp11000_p1", g_WHOL_CPNO, "")
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	Form.openPrevScreen()
	'Form.CloseForm()
End Sub

'============================================================================
Sub lblBtn_OnClick()
	Form.OpenScreen("89023" , "")
End Sub

	</SCRIPT_INFO>
