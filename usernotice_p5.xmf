Sub Form_OnFormInit()	
	g_sDev 		= Form.GetSharedData("&SERVER_MODE", False)
	g_sOSType	= Form.GetSharedData("&OS_TYPE", False )
	
	sData = Form.getOpenLinkData()

	Label5.caption = "수신거부 : 설정 > 알림 > 스마트톡 미사용"

	if sData <> null and sData <> "" then
		arrData = split(sData, "^SEPARATOR^")
		nDataSize = #arrData
		
		if nDataSize >= 7 then
			Label1.caption = arrData(0)
			
			szYear 	= Left(arrData(1), 4)
			szMonth 	= Mid(arrData(1), 5, 2)
			szDate 	= Mid(arrData(1), 7, 2)
			szHour 	= Mid(arrData(1), 9, 2)
			szMinute = Mid(arrData(1), 11, 2)
			szSecond = Mid(arrData(1), 13, 2)
		
			Label2.caption = szYear & "-" & szMonth & "-" & szDate & " " & szHour & ":" & szMinute & ":" & szSecond
			g_sMsg = trim(replace(arrData(2), "※ 수신거부 : 설정 > 알림 > 스마트톡", ""))
			Cont0.Label3.caption = arrData(2)
			
			g_sMkCode = arrData(3)
			
			g_sBtnName = arrData(4)
			g_sBtnLinkType = arrData(5)
			g_sBtnLink = arrData(6)
		end if
	end if
	
	if g_sBtnName <> "" then
		Button1.caption = g_sBtnName
	end if
	
