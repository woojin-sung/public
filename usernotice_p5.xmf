'============================================================================
Sub Form_OnFormInitBefore()
	Image1.SetMaintainingRatio("1")
	Cont0.Image0.SetMaintainingRatio("1")
	imgYoutube.SetMaintainingRatio("1")
	imgKakao.SetMaintainingRatio("1")
End Sub

'============================================================================
Sub Image1_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Button0_OnClick()
	if g_sBtnLinkType == "0" then
		openLinkData = ""
		if g_sBtnLink = "88062" then
			openLinkData = "88062"
		end if
		Form.OpenScreen(g_sBtnLink , openLinkData)
	elseif g_sBtnLinkType == "1" then
		Form.openExternalBrowser(g_sBtnLink)
	end if
End Sub

'============================================================================
Sub imgKakao_OnClick()
	Form.openExternalBrowser("http://pf.kakao.com/_SsZqxb")
End Sub

'============================================================================
Sub imgYoutube_OnClick()
	Form.openExternalBrowser("https://m.youtube.com/@meritzon")
End Sub

'============================================================================
Sub Button1_OnClick()
	
	if g_sBtnLinkType == "0" or g_sBtnLinkType == "1" then
		if g_sBtnLinkType == "0" then
			openLinkData = ""
			if g_sBtnLink = "88062" then
				openLinkData = "88062"
			end if
			Form.OpenScreen(g_sBtnLink , openLinkData)
			Form.CloseForm()
		elseif g_sBtnLinkType == "1" then
			Form.openExternalBrowser(g_sBtnLink)
			
			'20240514_01 HWG START : 앱연동 URL 경우 팝업 닫기
			if instr(g_sBtnLink, "https://home.imeritz.com/biz/appLink.html") > 0 or instr(g_sBtnLink, "https://testhome.imeritz.com/biz/appLink.html") > 0 then
				Form.CloseForm()
			end if
			'20240514_01 HWG END
		end if
	else
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(Cint(sTimerID), 0, 0)
	if cint(sTimerID) = 1 then
		if g_sOSType = "1" then
			Form.closePopup("notice_p0")
			Form.closePopup("notice_event")
		end if
	elseif cint(sTimerID) = 2 then
		DATAMANAGER.RequestTranData("ooopc_push_011r")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "ooopc_push_011r" then
		DATAMANAGER.SetDataValue(0, "ooopc_push_011r", "InBlock1", "ADVR_PUSH_ID" , 0 , g_sMkCode)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ooopc_push_011r" then
		szEpmdMsg = DATAMANAGER.GetDataValue(0, "ooopc_push_011r", "OutBlock1", "EPMD_MSG_CNTT" , 0)
		
		if szEpmdMsg <> "" then
			Cont0.Label3.caption = g_sMsg & "\n\n" & szEpmdMsg & "\n\n" & "※ 수신거부 : 설정 > 알림 > 스마트톡"
		else
			Cont0.Label3.caption = g_sMsg & "\n\n" & "※ 수신거부 : 설정 > 알림 > 스마트톡"
		end if
	end if
End Sub

