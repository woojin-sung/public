'============================================================================
'데이터가 모두 입력되면 확인버튼 활성화
'============================================================================
function CheckEnableOKButton()

	if Trim(ContMain.edtName.caption) <> "" and Trim(ContMain.edtAddr.caption) <> ""   
	   and Trim(ContMain.cmbJobName.caption) <> "" and Trim(ContMain.edtComName.caption) <> ""   
	   and Trim(ContMain.edtComAddr.caption) <> "" 
	   and Trim(ContMain.cmbClpsName.caption) <> "" and ContMain.cmbClpsName.caption <> "선택해주세요"  
	   and Trim(ContMain.cmbBswrName.caption) <> "" and ContMain.cmbBswrName.caption <> "선택해주세요" then	
		btnOK.enable = true
	else
		btnOK.enable = false	
	end if 	
end function 

'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.setMaintainingRatio("1")
	ContMain.Img1.setMaintainingRatio("1")
	ContMain.Img2.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	'Form.SetScreenName("해외주식 시세신청 신청자정보입력")
	
	ContMain.cmbJobName.caption = ""
	ContMain.edtJobName.caption = ""
	ContMain.cmbClpsName.caption = ""
	ContMain.edtClpsName.caption = ""
	ContMain.cmbBswrName.caption = ""
	ContMain.edtBswrName.caption = ""
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" then
		g_szOlnyCustEdit = Left(szOpenData, 1)
		g_szAcntNo = Right(szOpenData, 10) 
	end if
'g_szOlnyCustEdit = "Y" 'for TEST

	'해외주식 실시간 추가정보 조회(조회)
	Grid0.rowcount = 0
	DATAMANAGER.RequestTranData( "obtro_acnt_206r_1" )
			
	'*****************************************************
	'주의: init 했을 때 컨트롤 위치 셋팅 후 setApplyLabel
	'에디트 컨트롤 입력항목명 생성
	'*****************************************************
	ContMain.edtName.setApplyLabel ("영문명", 0 , 268 , "left" , true)
	ContMain.edtAddr.setApplyLabel("주소", 0 , 268 , "left" , true)
	ContMain.edtComName.setApplyLabel("회사명", 0 , 268 , "left" , true)	
	ContMain.cmbJobName.setApplyLabel("직업", 0 , 268 , "left" , true, 111)	
	ContMain.cmbClpsName.setApplyLabel("직급 및 직위", 0 , 268 , "left" , true, 111)
	ContMain.cmbBswrName.setApplyLabel("담당업무", 0 , 268 , "left" , true, 111)	
	ContMain.edtComAddr.setApplyLabel("회사 주소", 0 , 268 , "left" , true)	
	
	ContMain.cmbJobName.cbtype = "5"
	ContMain.cmbClpsName.cbtype = "5"
	ContMain.cmbBswrName.cbtype = "5"	
	
	'240729
	ContMain.lblAddr.maxlinecnt = "1^-2"
	ContMain.lblAddr.bringfront("0")
	ContMain.lblComAddr.maxlinecnt = "1^-2"
	ContMain.lblComAddr.bringfront("0")
	
	'20240624_01 HWG 주소팝업 버튼추가
	ContMain.btnAddr.bringFront("1")
	ContMain.btnComAddr.bringFront("1")
	
	Label1.setHighlight(332, 0, 7)	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCUST_NUM
	szCUST_NUM = Form.GetSharedData("&CUST_NUM", false)
		
	'해외주식 실시간 추가정보 조회(조회)
	if szTranID == "obtro_acnt_206r_1" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 	0 , "2" )				'처리구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" , 			0 , szCUST_NUM )			'고객번호
		
	'해외주식 실시간 추가정보 조회(정합성체크)
	elseif szTranID == "obtro_acnt_206r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 	0 , "1" )				'처리구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" , 			0 , szCUST_NUM )			'고객번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CUST_ENG_NAME" , 	0 , ContMain.edtName.caption )		'고객영문명
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_ADDR" , 		0 , ContMain.edtAddr.caption )		'영문주소
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_OCPT_NAME" , 	0 , ContMain.cmbJobName.cbkeydata )	'영문직업명
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_CO_NAME" , 	0 , ContMain.edtComName.caption )	'영문회사명
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_CO_ADDR" , 	0 , ContMain.edtComAddr.caption )	'영문회사주소
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CLPS_NAME" , 		0 , g_szInPutClpsName )	'영문직급명
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "RSNS_BSWR_NAME" , 	0 , g_szInPutBswrName )	'영문담당업무명
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'해외주식 실시간 추가정보 조회(조회)
	if szTranID == "obtro_acnt_206r_1" then
		Dim szENG_OCPT_NAME
		Dim szCLPS_NAME
		Dim szBSWR_NAME
		'Dim szSearchFlag
		
		ContMain.edtName.caption = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "CUST_ENG_NAME" , 0 )	     '고객영문명
		ContMain.edtAddr.caption = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ENG_ADDR" , 0 )		     '영문주소
		'240729
		if ContMain.edtAddr.caption <> "" then
			ContMain.lblAddr.caption = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ENG_ADDR" , 0 )		     '영문주소
			ContMain.lblAddr.visible = true
			ContMain.lblAddr.transmode = "0"
		else
			ContMain.lblAddr.visible = false
		end if
		
		ContMain.edtComName.caption = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ENG_CO_NAME" , 0 )	     '영문회사명
		szENG_OCPT_NAME = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ENG_OCPT_NAME" , 0 )	'영문직업명
		szCLPS_NAME     = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "CLPS_NAME"     , 0 )	'영문직급명
		szBSWR_NAME = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "RSNS_BSWR_NAME" , 0 )	'영문담당업무명
		ContMain.edtComAddr.caption = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ENG_CO_ADDR" , 0 )	     '영문회사주소
		
		'240729
		if ContMain.edtComAddr.caption <> "" then
			ContMain.lblComAddr.caption = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ENG_CO_ADDR" , 0 )	 '영문회사주소
			ContMain.lblComAddr.visible = true
			ContMain.lblComAddr.transmode = "0"
		else
			ContMain.lblComAddr.visible = false
		end if
		
		'영문직급명 g_nBefIndex1
		g_szInPutClpsName = cmbClpsNameFindKeyData(szCLPS_NAME)
		ContMain.cmbClpsName.caption = Trim(g_szInPutClpsName)
		ContMain.cmbClpsName.currentindex = ContMain.cmbClpsName.currentindex
	
		'영문담당업무 g_nBefIndex2
		g_szInPutBswrName = cmbBswrNameFindKeyData(szBSWR_NAME)
		ContMain.cmbBswrName.caption = Trim(g_szInPutBswrName)
		ContMain.cmbBswrName.currentindex = ContMain.cmbBswrName.currentindex	
		
		'영문직업명 g_nBefIndex
		g_szInPutJobName  = cmbJobNameFindKeyData(szENG_OCPT_NAME)
		ContMain.cmbJobName.caption = Trim(g_szInPutJobName)
		ContMain.cmbJobName.currentindex = ContMain.cmbJobName.currentindex
		
		ContMain.SetScrollAutoSize()
		
	'해외주식 실시간 추가정보 조회(정합성체크)
	elseif szTranID == "obtro_acnt_206r" then
		Dim szNRML_YN, szNRML_REAS
		szNRML_YN = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "NRML_YN" , 0 )		'정상여부
		szNRML_REAS = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "NRML_REAS" , 0 )	'정상사유
		
		'정상
		if szNRML_YN == "Y" then	
			'고객정보가 변경되었을 경우 
			if g_szOlnyCustEdit == "Y" then	
				Form.openPopupAnimation("pwdcheckpopup",g_szAcntNo & "☆0" ,"","2") '결제계좌
			else
				btnUpdate_OnClick()
			end if 
		else
			'Form.ShowAlert("알림", "입력데이터 확인이 필요합니다.("..szNRML_REAS..")")
			Form.ShowAlert("알림", DATAMANAGER.GetDataMsgText("obtro_acnt_206r") .."("..szNRML_REAS..")")
		end if
		
	elseif szTranID == "obtro_acnt_207a" then
	
		'고객정보가 변경되었을 경우 
		if g_szOlnyCustEdit == "Y" then
			g_szOKType = "5"
			Form.OpenPopup("nrsbtro16090_p7" , g_szOKType, "5")
		else
			szSendData = ContMain.edtName.caption & "★" & ContMain.edtAddr.caption & "★" & ContMain.cmbJobName.cbkeydata & "★" & ContMain.edtComName.caption & "★" & ContMain.edtComAddr.caption & "★" & g_szInPutClpsName & "★" & g_szInPutBswrName
			Form.SendReturnToParent("INFO_RETURN" , szSendData)
			Form.CloseForm()
		end if 
	end if
End Sub

'============================================================================
Sub btnQuit_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	Dim szSendData

	if Trim(ContMain.edtName.caption) = "" then
		Form.ShowAlert("알림", "영문이름을 입력해주세요.")			
		Exit Sub
	end if
	
	if Trim(ContMain.edtAddr.caption) = "" then
		Form.ShowAlert("알림", "영문주소를 입력해주세요.")		
		Exit Sub
	end if
	
	if Trim(ContMain.cmbJobName.caption) = "" then
		Form.ShowAlert("알림", "영문직업을 입력해주세요.")		
		Exit Sub
	end if
	
	if Trim(ContMain.edtComName.caption) = "" then
		Form.ShowAlert("알림", "영문회사명을 입력해주세요.")		
		Exit Sub
	end if
	
	if Trim(ContMain.edtComAddr.caption) = "" then
		Form.ShowAlert("알림", "영문회사주소를 입력해주세요.")		
		Exit Sub
	end if

	if Trim(ContMain.cmbClpsName.caption) = "" then
		Form.ShowAlert("알림", "영문직급및직위를 입력해주세요.")		
		Exit Sub
	end if
	
	if Trim(ContMain.cmbBswrName.caption) = "" then
		Form.ShowAlert("알림", "영문담당업무를 입력해주세요.")		
		Exit Sub
	end if	
	
	'고객정보 변경 버튼 클릭시 
	if g_szOlnyCustEdit == "Y" then 
		'고객정보가 변경되었을 경우 
		if (ContMain.edtName.caption <> Grid0.GetCellData("bd_cell2", 0))  '고객영문명
		   or (ContMain.edtAddr.caption <>  Grid0.GetCellData("bd_cell3", 0)) '영문주소
		   or (ContMain.cmbJobName.cbkeydata <> Grid0.GetCellData("bd_cell4", 0)) '영문직업명
		   or (ContMain.edtComName.caption <> Grid0.GetCellData("bd_cell5", 0)) '영문회사명
		   or (ContMain.edtComAddr.caption <> Grid0.GetCellData("bd_cell6", 0)) '영문회사주소
		   or (g_szInPutClpsName <> Grid0.GetCellData("bd_cell7", 0)) '직급명
		   or (ContMain.cmbBswrName.cbkeydata <> Grid0.GetCellData("bd_cell8", 0) ) then '담당업무명
			g_szOKType = "4"
			Form.OpenPopup("nrsbtro16090_p7" , g_szOKType, "5")
			Exit Sub
		'고객정보가 변경되지 않은 경우
		else
			g_szOlnyCustEdit = "N"
		end if 
	end if 
	
	'해외주식 실시간 추가정보 조회(정합성체크)
	DATAMANAGER.RequestTranData( "obtro_acnt_206r" )	
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'영문직업
	if sKeyName == "mbtro16090_p7_RETURN" then
		ContMain.cmbJobName.cbkeydata = sRet
	elseif sKeyName == "INFO_POPUP4" then	'변경
		if sRet == "OK" then
			'해외주식 실시간 추가정보 조회(정합성체크)
			DATAMANAGER.RequestTranData( "obtro_acnt_206r" )
		end if 
		
	elseif sKeyName == "INFO_POPUP5" then	'변경 후 확인
		if sRet == "OK" then
			szSendData = ContMain.edtName.caption & "★" & ContMain.edtAddr.caption & "★" & ContMain.cmbJobName.cbkeydata & "★" & ContMain.edtComName.caption & "★" & ContMain.edtComAddr.caption & "★" & g_szInPutClpsName & "★" & ContMain.edtBswrName.caption
			Form.SendReturnToParent("INFO_RETURN" , szSendData)
			Form.CloseForm()
		end if 		 
	elseif sKeyName == "mbbdm85150_p4" Then	'주소
	
		If sRet == "OK" Then
			Set_Address()
			CheckEnableOKButton()
		End If
		
	elseif sKeyName == "CORRECT_PWD" then
	     '고객변경시 
		if sRet <> "" and g_szOlnyCustEdit == "Y" then
			'Dim tData
			'tData = Split(sRet, "★")
			
			'if UBOUND(tData) > 0 then
				btnUpdate_OnClick()
			'end if 
		end if 
	end if
End Sub

'============================================================================
Sub Set_Address()
	ContMain.RadioSelectGbn0.SetResultLabel("0", "complete", "", "ContMain") 'helpmsg Reset

	s_AD_YN 		= Form.GetSharedData("16090_ADDRESS_ENG_YN"      , False ) 'Y: 신주소 N: 구주소
	s_AD_REGN_ZIP	= Form.GetSharedData("16090_ADDRESS_ENG_REGN_ZIP", False )
	s_AD_DTL_ZIP	= Form.GetSharedData("16090_ADDRESS_ENG_DTL_ZIP" , False )
	s_AD_POST 	= Form.GetSharedData("16090_ADDRESS_ENG_POST"    , False )
	s_AD_DTAD 	= Form.GetSharedData("16090_ADDRESS_ENG_DTAD"    , False )
	s_AD_BLDN 	= Form.GetSharedData("16090_ADDRESS_ENG_BLDN"    , False )

		
	If g_InagTypeCode = "01" Then
		'자택 주소
		ContMain.edtAddr.caption = Trim(s_AD_DTAD) .." ".. Trim(s_AD_POST) .." (".. Trim(s_AD_DTL_ZIP) .. Trim(s_AD_REGN_ZIP) ..")"
		'240729
		if ContMain.edtAddr.caption <> "" then
			ContMain.lblAddr.caption = ContMain.edtAddr.caption
			ContMain.lblAddr.visible = true
			ContMain.lblAddr.transmode = "0"
		else
			ContMain.lblAddr.visible = false
		end if
		
	ElseIf g_InagTypeCode = "02" Then
		'직장 주소
		ContMain.edtComAddr.caption = Trim(s_AD_DTAD) .." ".. Trim(s_AD_POST) .." (".. Trim(s_AD_DTL_ZIP) .. Trim(s_AD_REGN_ZIP) ..")"
		'240729
		if ContMain.edtComAddr.caption <> "" then
			ContMain.lblComAddr.caption = ContMain.edtComAddr.caption
			ContMain.lblComAddr.visible = true
			ContMain.lblComAddr.transmode = "0"
		else
			ContMain.lblComAddr.visible = false
		end if
		
	End If
		
End Sub 

'============================================================================
Sub btnUpdate_OnClick()
	Dim szCUST_NUM
	Dim szTranID
	szCUST_NUM = Form.GetSharedData("&CUST_NUM", false)
	szTranID   = "obtro_acnt_207a"
	
	DATAMANAGER.ClearInputData(0, szTranID)
	
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 	0 , "U" )				'처리구분코드
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" , 			0 , szCUST_NUM )			'고객번호
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CUST_ENG_NAME" , 	0 , ContMain.edtName.caption )		'고객영문명
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_ADDR" , 		0 , ContMain.edtAddr.caption )		'영문주소
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_OCPT_NAME" , 	0 , g_szInPutJobName )	'영문직업명
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_CO_NAME" , 	0 , ContMain.edtComName.caption )	'영문회사명
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_CO_ADDR" , 	0 , ContMain.edtComAddr.caption )	'영문회사주소
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CLPS_NAME" , 		0 , g_szInPutClpsName )	'직급명
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "RSNS_BSWR_NAME" , 	0 , g_szInPutBswrName )	'담당업무명
	
	DATAMANAGER.RequestTranData(szTranID)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErrMsg
	szSubErrMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	if szTranID == "obtro_acnt_207a" then
		Form.ShowAlert("알림", szErrMsg.."("..szSubErrMsg..")")
	end if
End Sub

'============================================================================
Function cmbClpsNameFindKeyData(KeyData)
	Dim szSearchFlag

	for i = 0 to ubound(g_szKeyClpsName)
		if g_szKeyClpsName(i) == KeyData then
			'ContMain.cmbClpsName.currentindex = i
			szSearchFlag = "Y"
		end if
	next
	
	if szSearchFlag == "Y" then
		ContMain.cmbClpsName.cbkeydata = KeyData
		g_nBefIndex1 = ContMain.cmbClpsName.currentindex
	else
		ContMain.cmbClpsName.caption = ""
		ContMain.cmbClpsName.cbkeydata = ""		
		ContMain.cmbClpsName.currentindex = -1
		ContMain.cmbClpsName.caption = "선택해주세요"	
		ContMain.cmbClpsName.popuptitle = "선택해주세요"
		ContMain.cmbClpsName.fgcolor = 241
		g_nBefIndex1 = -1
	end if

	return KeyData
End Function

'============================================================================
Function cmbJobNameFindKeyData(KeyData)
	Dim szSearchFlag
	for i = 0 to ubound(g_szKeyJobName)
		if g_szKeyJobName(i) == KeyData then
			'ContMain.cmbClpsName.currentindex = i
			szSearchFlag = "Y"
		end if
	next
	
	if szSearchFlag == "Y" then
		ContMain.cmbJobName.cbkeydata = KeyData
		g_nBefIndex = ContMain.cmbJobName.currentindex
	else
		ContMain.cmbJobName.caption = ""
		ContMain.cmbJobName.cbkeydata = ""		
		ContMain.cmbJobName.currentindex = -1
		ContMain.cmbJobName.caption = "선택해주세요"	
		ContMain.cmbJobName.popuptitle = "선택해주세요"
		ContMain.cmbJobName.fgcolor = 241		
		g_nBefIndex = -1
	end if
	
	return KeyData
End Function

'============================================================================
Function cmbBswrNameFindKeyData(KeyData)
	Dim szSearchFlag
	for i = 0 to ubound(g_szKeyBswrName)
		if g_szKeyBswrName(i) == KeyData then
			'ContMain.cmbBswrName.currentindex = i
			szSearchFlag = "Y"
		end if
	next
	if szSearchFlag == "Y" then
		ContMain.cmbBswrName.cbkeydata = KeyData
		g_nBefIndex2 = ContMain.cmbBswrName.currentindex
	else
		ContMain.cmbBswrName.caption = ""
		ContMain.cmbBswrName.cbkeydata = ""		
		ContMain.cmbBswrName.currentindex = -1
		ContMain.cmbBswrName.caption = "선택해주세요"	
		ContMain.cmbBswrName.popuptitle = "선택해주세요"
		ContMain.cmbBswrName.fgcolor = 241	
		g_nBefIndex2 = -1
	end if
	return KeyData
End Function

'============================================================================
Sub ContMain_cmbClpsName_OnEditComplete(iIndex)
	g_szInPutClpsName =  ContMain.cmbClpsName.cbkeydata
	ContMain.edtClpsName.caption =  ContMain.cmbClpsName.caption
	ContMain.cmbClpsName.fgcolor = 4
	g_nBefIndex1 = ContMain.cmbClpsName.currentindex	
	
	CheckEnableOKButton()	
End Sub

'============================================================================
Sub ContMain_cmbJobName_OnEditComplete(iIndex)
'msgbox g_nBefIndex .." *** " .. iIndex
     '학생,주부,무직,기타
	if iIndex == 19 or iIndex == 16 or iIndex == 18 or iIndex == 13 then
		ContMain.cmbClpsName.currentindex = 9 '담당업무
		ContMain.edtComName.caption  = "Other" '회사명
		ContMain.edtComAddr.caption  = "Other" '회사주소		
		ContMain.cmbBswrName.currentindex = 10 '담당업무
		
		ContMain.cmbClpsName.enable = false
		ContMain.edtComName.enable = false
		ContMain.edtComAddr.enable = false
		ContMain.btnComAddr.enable = false
		'ContMain.edtBswrName.enable = false
		ContMain.cmbBswrName.enable = false	
		
		ContMain.edtComName.fgcolor = 146
		ContMain.edtComAddr.fgcolor = 146		
		ContMain.cmbClpsName.fgcolor = 146	
		ContMain.cmbBswrName.fgcolor = 146		
		
		'0729
		ContMain.lblComAddr.caption  = "Other" '회사주소
		ContMain.lblComAddr.visible = false
		
	elseif (Cint(g_nBefIndex) == 19 or Cint(g_nBefIndex) == 16 or Cint(g_nBefIndex) == 18 or Cint(g_nBefIndex) == 13) and (iIndex <> 19 and iIndex <> 16 and iIndex <> 18 and iIndex <> 13) then

		ContMain.cmbClpsName.currentindex = -1
		ContMain.cmbClpsName.caption = ""
		ContMain.cmbClpsName.cbkeydata = ""		
		ContMain.cmbClpsName.caption = "선택해주세요"	
		ContMain.cmbClpsName.fgcolor = 241
		g_szInPutClpsName = ""
		ContMain.edtComName.caption  = ""
		ContMain.edtComAddr.caption  = ""
		ContMain.cmbBswrName.currentindex = -1
		ContMain.cmbBswrName.caption = ""
		ContMain.cmbBswrName.cbkeydata = ""		
		ContMain.cmbBswrName.caption = "선택해주세요"	
		ContMain.cmbBswrName.fgcolor = 241
		g_szInPutBswrName = ""
		
		ContMain.cmbClpsName.enable = true
		ContMain.edtComName.enable = true
		ContMain.edtComAddr.enable = true
		ContMain.btnComAddr.enable = true
		ContMain.cmbBswrName.enable = true
		
		ContMain.edtComName.fgcolor = 4
		ContMain.edtComAddr.fgcolor = 4

		'0729
		ContMain.lblComAddr.caption = ""
		ContMain.lblComAddr.visible = false
	else	
	
		ContMain.cmbClpsName.enable = true
		ContMain.edtComName.enable = true
		ContMain.edtComAddr.enable = true
		ContMain.btnComAddr.enable = true
		ContMain.cmbBswrName.enable = true
		
		ContMain.edtComName.fgcolor = 4
		ContMain.edtComAddr.fgcolor = 4		
		ContMain.lblComAddr.fgcolor = 4		
		ContMain.cmbClpsName.fgcolor = 4	
		ContMain.cmbBswrName.fgcolor = 4
		
		if g_nBefIndex1 == -1 then
			ContMain.cmbClpsName.currentindex = -1
			ContMain.cmbClpsName.caption = ""
			ContMain.cmbClpsName.cbkeydata = ""		
			ContMain.cmbClpsName.caption = "선택해주세요"	
			ContMain.cmbClpsName.fgcolor = 241
		end if 
		if g_nBefIndex2 == -1 then
			ContMain.cmbBswrName.currentindex = -1
			ContMain.cmbBswrName.caption = ""
			ContMain.cmbBswrName.cbkeydata = ""		
			ContMain.cmbBswrName.caption = "선택해주세요"	
			ContMain.cmbBswrName.fgcolor = 241
		end if
			
	end if
	
	g_szInPutJobName = ContMain.cmbJobName.cbkeydata
	g_nBefIndex = ContMain.cmbJobName.currentindex
	
	CheckEnableOKButton()
End Sub

'============================================================================
Sub ContMain_cmbBswrName_OnEditComplete(iIndex)
	g_szInPutBswrName = ContMain.cmbBswrName.cbkeydata
	ContMain.edtBswrName.caption =  ContMain.cmbBswrName.caption	
	ContMain.cmbBswrName.fgcolor = 4
	g_nBefIndex2 = ContMain.cmbBswrName.currentindex
	
	CheckEnableOKButton()
End Sub

