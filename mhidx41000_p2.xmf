'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	dim szGridCnt
	dim szLinkData
	
	call SaveSettings()		'상세설정저장
	LoadSettings_P1()			'보여줄값로드
	ShowSettings_P1()			'보여줄값세팅
	
	
	szGridCnt = grdMain00.rowcount
	
	szLinkData = szGridCnt & "★"
	
	for i = 0 to  szGridCnt - 1
		szLinkData = szLinkData & grdMain00.GetCellData("bd_cell3", i) & "★" & grdMain00.GetCellData("bd_cell5", i) &  "★"
	next 
	
	Form.SaveConfigData(g_szInputFile_P1, "41000P2_LISTITEMS", szLinkData)
	Form.SendReturnToParent("REFRESH_MAIN" , szLinkData)
	Form.SendReturnToParent("REFRESH" , sData)
End Sub


