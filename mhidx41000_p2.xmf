'============================================================================
' 01.화면명 	: 시장종합
' 02.화면설명	: 시장종합_정보추가팝업
' 03.작성	: 2016.01.07
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_szFileName		'파일명
dim g_szKeys			'체크박스명리스트
dim g_szKeys_P1
dim	g_szInputFile_P1	'파일명_정보추가
g_szKeys=Array(	"chkTile", "chkInvr", "chkProg","chkChg","chkProd","chkRate")

g_szKeys_P1=Array(	"41000P2_TILE", "41000P2_TILE6ROW" , "41000P2_INVR", "41000P2_PROG", "41000P2_CHNG", 
			"41000P2_PROD", "41000P2_RATE") 				'7개
g_szInputFile_P1 = "41000P2ITEMS.ini"	
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'LoadSettings() : 파일에서 세팅값을 읽어들임
'============================================================================
Function LoadSettings_P1()
	dim szVal

	g_szValues = Array()
	
	For i = 0 to UBound(g_szKeys_P1)
		szVal = Form.LoadConfigData(g_szInputFile_P1,g_szKeys_P1(i))
		'Form.ShowAlert("output",g_szKeys(i) & "=" & szVal & ",," & i)
		g_szValues(i) = szVal
	Next
	
	'TEST 출력용 
'	For j = 0 to UBound(g_szKeys)
'		Form.ShowAlert("output22",g_szKeys(j) & "=" & g_szValues(j)  & ",," & j )
'	Next
	
End Function




'============================================================================
'ShowSettings() : 파일에서 세팅값을 읽어들여서 화면 세팅
'============================================================================
Function ShowSettings_P1()
	dim nGridIdx
	dim szOutputData
	
	nGridIdx = 0 
	call LoadSettings()
	
	grdMain00.SetClear()
	grdMain00.rowcount = 1
	
	for i = 0 to UBound(g_szKeys_P1) 
		szOutputData = g_szValues (i)
		
		if szOutputData = "1" then
			'grdMain00.SetCellData("bd_cell0", nGridIdx, "DEL")
			'grdMain00.SetCellData("bd_cell1", nGridIdx, g_szNames(i))
			grdMain00.SetCellData("bd_cell3", nGridIdx, g_szKeys_P1(i))
			grdMain00.SetCellData("bd_cell5", nGridIdx, g_szValues(i))
			nGridIdx = nGridIdx + 1
			grdMain00.AddRow()
		end if 
	next 
	
	grdMain00.SetDeleteRow(nGridIdx)
	
End Function



'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		return szList(nIdx)
	end if 
	
end function


'============================================================================
'chkCount:	체크한 값이 3개 이하로 내려가지 않도록 체크버튼 선택시마다 체크
'============================================================================
Function chkCount()
	dim szVal
	dim nTotalCnt
	
	nTotalCnt = 0 
	For i = 0 to UBound(g_szKeys)
		szVal = Form.GetCtlProp(g_szKeys(i), "checkstate")
		'Form.ShowAlert("output",g_szKeys(i) & "=" & szVal & ",," & i)
		if szVal = "1"  then
			nTotalCnt = nTotalCnt +1 			'체크된 카운트 갯수
		end if 
	Next 
	
	if nTotalCnt <  3 then
		return -1
	end if 
	
	return 0
End Function


'============================================================================
'SaveSettings() : 화면에서 세팅값 읽어들여서 파일로 저장
'============================================================================
Function SaveSettings()

	if rdoTile.currentindex		 = 	"0" then
		Form.SaveConfigData(g_szFileName, "41000P2_TILE"	, chkTile.checkstate )
		Form.SaveConfigData(g_szFileName, "41000P2_TILE6ROW"	, "0" )
	else
		Form.SaveConfigData(g_szFileName, "41000P2_TILE6ROW"	, chkTile.checkstate )
		Form.SaveConfigData(g_szFileName, "41000P2_TILE"	, "0" )
	end if 
	
	Form.SaveConfigData(g_szFileName, "41000P2_INVR"	, chkInvr.checkstate )
	Form.SaveConfigData(g_szFileName, "41000P2_PROG"	, chkProg.checkstate )
	Form.SaveConfigData(g_szFileName, "41000P2_CHNG"	, chkChg.checkstate )
	Form.SaveConfigData(g_szFileName, "41000P2_PROD"	, chkProd.checkstate )
	Form.SaveConfigData(g_szFileName, "41000P2_RATE"	, chkRate.checkstate )
	
	Form.SaveConfigData(g_szFileName, "41000P2_TILECNT", rdoTile.currentindex)
	

End Function


'============================================================================
'LoadSettings() : 파일에서 세팅값을 읽어들여서 화면 세팅
'============================================================================
Function LoadSettings()

	chkInvr.checkstate 	=  Form.LoadConfigData(g_szFileName, "41000P2_INVR"	)
	chkProg.checkstate 	=  Form.LoadConfigData(g_szFileName, "41000P2_PROG"	)
	
	if	Form.LoadConfigData(g_szFileName, "41000P2_TILE"	)	=	"0"	and
		Form.LoadConfigData(g_szFileName, "41000P2_TILE6ROW"	)	=	"0"	then
		chkTile.checkstate = "0"
	else
		chkTile.checkstate = "1"
	end if
	
	chkChg.checkstate 	=	Form.LoadConfigData(g_szFileName, "41000P2_CHNG")
	chkProd.checkstate	=	Form.LoadConfigData(g_szFileName, "41000P2_PROD")
	chkRate.checkstate	=	Form.LoadConfigData(g_szFileName, "41000P2_RATE")
			
	rdoTile.currentindex		= Form.LoadConfigData(g_szFileName, "41000P2_TILECNT"	)

	
	

End Function

'============================================================================
'InitSettings() : 값이 없을때 초기세팅
'============================================================================
Function	InitSettings()
	call 	SaveSettings()	'임시로 세팅 요청에 따라 수정예정
end Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim szCheckInit
	
	g_szFileName	= "41000P2ITEMS.ini"
	Form.SetScreenName("정보추가")
	
	szCheckInit = Form.LoadConfigData(g_szFileName, "41000P2_INVR"	)
	
	if	szCheckInit	<>	""	then
		call LoadSettings()
	else
		InitSettings()
	end	if
	
End Sub


'============================================================================
'chkTile_OnChange
'============================================================================
Sub chkTile_OnChange(sCheckState)
	dim szRet
	szRet =  chkCount()
	
	if szRet = -1 and sCheckState = "0" then
		Form.ShowAlert("안내", "3개 이상 선택하세요")
		chkTile.checkstate =  1
	end if 
End Sub


