'============================================================================
Sub Form_OnFormClose()
'20211028 HSZ 마이데이터 쉐어드변수 저장
	cusno = Form.GetSharedData("MAP_MYDATA_CUSNO" , false)
	cusnm = Form.GetSharedData("MAP_MYDATA_CUSNM" , false)
	orgCode = Form.GetSharedData("MAP_MYDATA_OFFER_ORG_CODE" , false)
	clientID = Form.GetSharedData("MAP_MYDATA_CLIENT_ID" , false)
	userCI = Form.GetSharedData("MAP_MYDATA_USER_CI" , false)
'	strmsg = cusno & "*" & cusnm & "*" & orgCode & "*" & clientID & "*" & userCI 
'	Form.ShowAlert("title", strmsg)
	Form.SetSharedData("&MYDATA_CUSNO" , cusno)
	Form.SetSharedData("&MYDATA_CUSNM" , cusnm)
	Form.SetSharedData("&MYDATA_OFFER_ORG_CODE" , orgCode)
	Form.SetSharedData("&MYDATA_CLIENT_ID" , clientID)
	Form.SetSharedData("&MYDATA_USER_CI" , userCI)
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName = "error" and sRet = "close" then
		Form.triggerEvent( "#", "CloseForm", "1" )
		Form.runMyDataApp(g_urlschme, "02")
	end if
End Sub

