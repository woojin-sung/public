'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_Setchkacnt		'체크한 계좌리스트 문자열로 setshared

Dim g_userci
Dim g_acntcnt			'총 보유계좌 개수
Dim g_chkcnt			'&invest.account.cnt 체크한 계좌 개수
Dim g_allchk			'전체선택 여부

Dim g_nNextCount
Dim g_urlschme
'============================================================================
Sub Button0_OnClick()
	g_Setchkacnt = ""
	Save_chkAcntList()
	Form.triggerEvent( "#", "NextStep", "1" )
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_acntcnt = 0 
	g_chkcnt = 0 
	g_nNextCount = 0 
	g_allchk = 0
'	Button0.enable = False
	g_userci = Form.GetSharedData("&MYDATA_USER_CI", false )
	DATAMANAGER.SetDataValue( 0 , "obaci_myif_001r", "InBlock1", "IF_CI" , 0 , g_userci )
	DATAMANAGER.RequestTranData("obaci_myif_001r")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.MsgBox("알림", "[TR]"&szErrMsg, "", 6)
End Sub

'============================================================================
'Sub DATAMANAGER_OnSendTranBefore(szTranID)
'	DATAMANAGER.SetDataValue( 0 , "obaci_myif_001r", "InBlock1", "IF_CI" , 0 , g_userci )
'End Sub
'
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obaci_myif_001r" then	'원장조회 서비스가 아니라, 단건조회로 grid에 addrow
		nxtdata = DATAMANAGER.GetDataValue( 0 , "obaci_myif_001r", "OutBlock1", "IF_NXET_PAGE" , 0)
		g_acntcnt = g_acntcnt + int(DATAMANAGER.GetDataValue( 0 , "obaci_myif_001r", "OutBlock1", "IF_HLDN_ACNT_CNT" , 0))
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obaci_myif_001r", "OutBlock2")-1
			szTemp  = DATAMANAGER.GetDataValue( 0 , "obaci_myif_001r", "OutBlock2", "IF_20_ACNO" , i) 		'계좌번호
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obaci_myif_001r", "OutBlock2", "IF_60_ACNM" , i) 		'계좌명
'			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obaci_myif_001r", "OutBlock2", "IF_ACNT_KIND_COD" , i) '계좌종류코드
			Add_GrdAcntRow(szTemp, szTemp1, nxtdata)
		next
		if nxtdata = ""  or nxtdata = null then
			GrdAcnt.SetDeleteRow( g_acntcnt )
			LblAcntCnt.caption = g_acntcnt
			
			nDev = Form.GetSharedData("&SERVER_MODE", false )
			if nDev == "1" then '테스트
				Form.requestMyData("MYDATA_003", "https://mytest.imeritz.com:9443/internal/trsms", "2")
			else
				Form.requestMyData("MYDATA_003", "https://mydata.imeritz.com:9443/internal/trsms", "2")
			end if
		else 
			DATAMANAGER.SetDataValue( 0 , "obaci_myif_001r", "InBlock1", "IF_CI" , 0 , g_userci )
			DATAMANAGER.SetDataValue( 0 , "obaci_myif_001r", "InBlock1", "IF_NXET_PAGE" , 0 , nxtdata )
			DATAMANAGER.RequestTranData("obaci_myif_001r")
		end if
	end if
End Sub

'============================================================================
Sub GrdAcnt_OnClickUp(lRow, szCellID)
	if szCellID = "bd_cell0" then
'		if CInt(lRow) = 0 then
'			GrdAcnt.SetAllCheck("bd_cell0", bSet)
'		end if
		chk = GrdAcnt.GetCellData( "bd_cell0", lRow)
		if Int(chk) = 1 then 
			g_chkcnt = g_chkcnt + 1
		else 
			g_chkcnt = g_chkcnt - 1
		end if
		LblChkCnt.caption = g_chkcnt
	end if
End Sub

'============================================================================
'등록했던 계좌 체크박스에 세팅해주는 함수
Function Grd_ChkAcnt(Acnt_chklst)
	'등록했던 계좌 수 0개 일때
	if g_chkcnt = 0 then
		exit Function
	end if

	'등록했던 계좌를 계좌목록에서 찾아서 체크해주기
	for i = 0 to GrdAcnt.rowcount - 1
		checkAcnt = GrdAcnt.GetCellData("bd_cell1" , i)
		
		if Instr(Acnt_chklst,checkAcnt) > 0 then
			GrdAcnt.SetCellData( "bd_cell0", i, 1)
		end if
	next 
	
	
End Function 

'============================================================================
'보유계좌 그리드에 세팅해주는 함수
Function Add_GrdAcntRow(szTemp, szTemp1, nxtdata)
	GrdAcnt.AddRow()
	GrdAcnt.SetCellData("bd_cell1", g_nNextCount , szTemp)
	GrdAcnt.SetCellData("bd_cell2", g_nNextCount , szTemp1)
'	GrdAcnt.SetCellData("bd_cell3", g_nNextCount , szTemp2)
	
	g_nNextCount = g_nNextCount + 1
End Function 

'============================================================================	
'체크한 계좌 shared변수에 저장하는 함수
Function Save_chkAcntList()
	acntSetting = "" 	'완료페이지 계좌목록 세팅용 변수
	g_Setchkacnt = "invest.list" & "★" & "" & "★" & "" & "★" & "" & "★" & "" & "★" & "" & "●"
	
	annAcnt = "" '연금계좌여부
	
	for i = 0 to GrdAcnt.rowcount - 1
		chk = GrdAcnt.GetCellData( "bd_cell0", i)
		 
		'계좌목록 필드 : 계좌번호★시쿼스번호(단순순번)-null★계좌명★업권값(null)★부가내용(null)●
		if Int(chk) = 1 then
			AcntNum  = GrdAcnt.GetCellData( "bd_cell1", i) '계좌번호
			AcntName = GrdAcnt.GetCellData( "bd_cell2", i) '계좌명
'			AcntCode = GrdAcnt.GetCellData( "bd_cell3", i) '계좌코드
			if InStr(AcntName, "연금") > 0 then
				annAcnt = "available"
			end if
			g_Setchkacnt = g_Setchkacnt & "invest.account" & "★" & AcntNum & "★" & " " & "★" & AcntName & "★" & " " & "★" & " " & "●"
			acntSetting =  acntSetting & AcntNum & "★" & AcntName & "★"
		end if 
	next 
	
	if int(g_chkcnt)>0 then
		Form.SetSharedData("&MYDATA_SCOPE", "invest.account" )
	else
		Form.SetSharedData("&MYDATA_SCOPE", " " )
	end if
	'20211103 HSZ START
	g_chkcnt = g_chkcnt + 1
	if g_chkcnt = 1 then
		g_Setchkacnt = "invest.list" & "★" & "" & "★" & "" & "★" & "" & "★" & "" & "★" & "" & "●"
	end if
	'20211103 HSZ END

	Form.SetSharedData("&MYDATA_ASSET_LIST", g_Setchkacnt)
	Form.SetSharedData("&MYDATA_ASSET_CNT" , g_chkcnt)
	Form.SetSharedData("&MYDATA_MAP_ACNTLIST" , acntSetting)
	Form.SetSharedData("&MYDATA_MAP_ACNTNUM" , g_chkcnt)		'완료페이지 선택계좌 개수 세팅용 변수
	Form.SetSharedData("&MYDATA_MAP_ANNACNT" , annAcnt)		'연금계좌 여부 세팅용 변수
'	Form.ShowAlert("g_Setchkacnt", g_Setchkacnt)
'	Form.ShowAlert("g_chkcnt", g_chkcnt)
End Function
			
'============================================================================
'iOS는 호출화면에서 TriggerEventMyData 받고, 안드로이드는 껍데기화면에서 받은 후 원래 화면으로 Trigger 보내기
Sub Form_OnTriggerEvent(sEventName, sParam)
	g_urlschme = Form.GetSharedData("&MYDATA_APP_SCHEME", false )
	if sEventName = "MYDATA_RETURN_003" then
		if sParam = "ERROR" then
			Form.MsgBox("확인 필요", "계좌연결이 정상적으로 완료되지 않았습니다. \n사업자 앱으로 연결되오니, 재확인하시기 바랍니다.", "error", 6)
		else
			g_chkcnt = Form.GetSharedData("&MYDATA_ASSET_CNT",False)
			if len(g_chkcnt) = 0 or Int(g_chkcnt) < 0 then
				g_chkcnt = 0
			end if
			LblChkCnt.caption = g_chkcnt
			chkAcntList = Form.GetSharedData("&MYDATA_ASSET_LIST", False) 
	'		Form.ShowAlert("chkAcntList", chkAcntList)
			'등록했던 계좌 체크박스에 세팅
			Grd_ChkAcnt(chkAcntList)
		end if
	end if
End Sub
'============================================================================
Sub Form_OnTriggerEventMyData(sEventName, sParam)
	g_urlschme = Form.GetSharedData("&MYDATA_APP_SCHEME", false )
	if sParam = "ERROR" then
		Form.MsgBox("확인 필요", "계좌연결이 정상적으로 완료되지 않았습니다. \n사업자 앱으로 연결되오니, 재확인하시기 바랍니다.", "error", 6)
	else
		if sEventName = "MYDATA_RETURN_003" then
	'		Form.requestMyData("MYDATA_003", "https://mytest.imeritz.com:9443/internal/trsms", "2")
			g_chkcnt = Form.GetSharedData("&MYDATA_ASSET_CNT",False)
'			Form.ShowAlert("g_chkcnt", g_chkcnt)
			if len(g_chkcnt) = 0 or Int(g_chkcnt) < 0 then
				g_chkcnt = 0
			end if
			LblChkCnt.caption = g_chkcnt
			
			chkAcntList = Form.GetSharedData("&MYDATA_ASSET_LIST", False) 
'			Form.ShowAlert("chkAcntList", chkAcntList)
			'등록했던 계좌 체크박스에 세팅
			Grd_ChkAcnt(chkAcntList)
		end if
	End if
End Sub 
'============================================================================
Sub GrdAcnt_OnHeaderClickUp(lRow, szCellID) '그리드 헤더 체크박스 선택시, 전체선택/선택해지
	if szCellID = "th_cell0" then 'lRow = -1 and 
		if g_allchk = 0 then 
			g_allchk = 1
			GrdAcnt.SetCellTopCaption(szCellID, "1")
			LblChkCnt.caption = g_acntcnt
			g_chkcnt = g_acntcnt
		elseif g_allchk = 1 then
			g_allchk = 0
			GrdAcnt.SetCellTopCaption(szCellID, "0")
			g_chkcnt = 0
			LblChkCnt.caption = "0"
		end if
		
		for i = 0 to GrdAcnt.rowcount - 1
			GrdAcnt.SetCellData( "bd_cell0", i, g_allchk)
		next 

	end if
End Sub

