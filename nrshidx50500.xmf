'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************
'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	'===============================================
	' 뒤로가기 버튼 초기화
	'===============================================
	imgBack.SetMaintainingRatio("2")
	imgBack.imgpath = g_szBackImg
	
	'===============================================
	' 타이틀 초기화
	'===============================================
	lblTitle.paddinginfo = "0,0,0,0"
	lblTitle.caption = g_szTitle
	
	'-----------------------------------------------
	' 유의사항 버튼 초기화
	'-----------------------------------------------
	imgInfo.SetMaintainingRatio("3")
	imgInfo.imgpath = g_szInfoImg
	
	contTop.lblBg.bgcolor = g_szContBgColor
	contTop.lblThemeTitle.paddinginfo = "0,0,0,0"
	contTop.lblThemeSubTitle.paddinginfo = "0,0,0,0"
	
	contTop.lblLine0.bgcolor = g_szLineColor
	contTop.lblLine1.bgcolor = g_szLineColor
	
	contTop.lblToday.fgcolor = g_szTxtColor_Grey
	contTop.lblToday.caption = "현재"
	
	contTop.lblTodayData.paddinginfo = "0,0,0,0"
	contTop.lblTodayData.fgcolor = g_szTxtColor_Normal
	
	contTop.lbl1Month.fgcolor = g_szTxtColor_Grey
	contTop.lbl1Month.caption = "1개월"
	
	contTop.lblMonthData1.paddinginfo = "0,0,0,0"
	contTop.lblMonthData1.fgcolor = g_szTxtColor_Normal
	
	contTop.lbl3Month.fgcolor = g_szTxtColor_Grey
	contTop.lbl3Month.caption = "3개월"
	
	contTop.lblMonthData3.paddinginfo = "0,0,0,0"
	contTop.lblMonthData3.fgcolor = g_szTxtColor_Normal
	
	contTop.lblContent.paddinginfo = "0,0,0,0"
	contTop.lblContent.maxlinecnt = "5^-4"
	contTop.lblContent.fgcolor = g_szTxtColor_Grey
	
	contMain.imgFilter.setMaintainingRatio("3")
	contMain.imgFilter.imgpath = g_szFilterImg
	
	contMain.lblFilter.paddinginfo = "0,0,0,0"
	contMain.lblFilter.maxlinecnt = "1"
	contMain.lblFilter.fgcolor = g_szTxtColor_Normal
	contMain.lblFilter.Caption = "필터"
	
	contMain.lblItemCnt.paddinginfo = "0,0,0,0"
	contMain.lblItemCnt.maxlinecnt = "1"
	contMain.lblItemCnt.fgcolor = g_szTxtColor_Grey
	
	'contMain.lblFilter.caption = "전체\n거래량 많은순"
	contMain.bgcolor = g_szTxtColor_White
	contMain.gesture = true
	
	contMain.Pannel0.enable = false
	
	contMain.lblLine0.bgcolor = g_szLineColor
	
	
	contMain.lblEmpty.paddinginfo = "0,0,0,0"
	contMain.lblEmpty.fgcolor = g_szTxtColor_Grey
	contMain.lblEmpty.top = 200
	contMain.lblEmpty.visible = false
	
	contMain.imgEmpty.maintainratio = "2"
	contMain.imgEmpty.imgpath = "icon_notice_3"
	contMain.imgEmpty.top = 150
	contMain.imgEmpty.visible = false
End Function

Function RequestTranData_Theme_Top(szData0)
	DATAMANAGER.ClearInputData(0, "ohhts_metf_019r")
	DATAMANAGER.SetDataValue(0, "ohhts_metf_019r", "InBlock1", "FID_MDDV_CODE_NAME", 0 , szData0)
	
	DATAMANAGER.RequestTranData("ohhts_metf_019r")
End Function

Function ResponseTranData_Theme_Top()
		'종목수
		szItem0 = DATAMANAGER.GetDataValue(0, "ohhts_metf_019r", "OutBlock1", "FID_ISSU_CNT", 0)
		'당일 수익률
		szItem1 = DATAMANAGER.GetDataValue(0, "ohhts_metf_019r", "OutBlock1", "FID_INPUT_ERT", 0)
		'1개월 수익률
		szItem2 = DATAMANAGER.GetDataValue(0, "ohhts_metf_019r", "OutBlock1", "FID_M1_ERT", 0)
		'3개월 수익률
		szItem3 = DATAMANAGER.GetDataValue(0, "ohhts_metf_019r", "OutBlock1", "FID_M3_ERT", 0)
		'테마 설명
		szItem4 = DATAMANAGER.GetDataValue(0, "ohhts_metf_019r", "OutBlock1", "FID_ETF_TMST_EXPL", 0)
		
		'테마명 / 구성종목수 / 테마설명 / 당일수익률 / 1개월수익률 / 3개월수익률
		DisplaySetting_Top(g_szThemeNm, szItem0, szItem4, szItem1, szItem2, szItem3) 
End Function

'테마명 / 구성종목수 / 테마설명 / 당일수익률 / 1개월수익률 / 3개월수익률
Function DisplaySetting_Top(szThemeName, nThemeCnt, szThemeInfo, nData0, nData1, nData2) 
	
	contTop.lblThemeTitle.caption = szThemeName
	contTop.lblThemeSubTitle.caption = "("&Clng(nThemeCnt)&"종목)"
	
	contTop.lblTodayData.caption = nData0
	contTop.lblMonthData1.caption = nData1
	contTop.lblMonthData3.caption = nData2
	
	contTop.lblContent.caption = szThemeInfo
End Function

Function RequestTranData_Intr()
	DATAMANAGER.ClearInputData(0, "ohhts_intr_006r")
	DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))
	DATAMANAGER.RequestTranData("ohhts_intr_006r")
End Function

Function ResponseTranData_Intr()
	g_szIntrGrpCnt = DATAMANAGER.GetDataCount(0, "ohhts_intr_006r" , "OutBlock1")
End Function

Function RequestTranData_Theme(szData0, szData1, szData2, szData3)
	contMain.Pannel0.rowcount = "0"
	
	DATAMANAGER.ClearInputData(0, "ohhts_metf_004r")
	
	DATAMANAGER.SetDataValue(0, "ohhts_metf_004r", "InBlock1", "FID_MDDV_CODE_NAME" 			, 0 , szData0)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_004r", "InBlock1", "FID_INPUT_CLS_CODE" 			, 0 , szData1)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_004r", "InBlock1", "FIDX_INPUT_NTNL_CODE"			, 0 , szData2)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_004r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE"	, 0 , szData3)
	
		rtChk = Form.GetSharedData( "REALTIME_AX", false )
	DATAMANAGER.SetDataValue(0,"ohhts_metf_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "AX")
	DATAMANAGER.SetDataValue(0,"ohhts_metf_004r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 0 , rtChk)
	
	rtChk = Form.GetSharedData( "REALTIME_OQ", false )
	DATAMANAGER.SetDataValue(0,"ohhts_metf_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 1 , "OQ")
	DATAMANAGER.SetDataValue(0,"ohhts_metf_004r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 1 , rtChk)
	
	rtChk = Form.GetSharedData( "REALTIME_NY", false )
	DATAMANAGER.SetDataValue(0,"ohhts_metf_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 2 , "NY")
	DATAMANAGER.SetDataValue(0,"ohhts_metf_004r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 2 , rtChk)
	
	rtChk = Form.GetSharedData( "REALTIME_HK", false )
	DATAMANAGER.SetDataValue(0,"ohhts_metf_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 3 , "HK")
	DATAMANAGER.SetDataValue(0,"ohhts_metf_004r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 3 , rtChk)
	
	rtChk = Form.GetSharedData( "REALTIME_SH", false )
	DATAMANAGER.SetDataValue(0,"ohhts_metf_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 4 , "SH")
	DATAMANAGER.SetDataValue(0,"ohhts_metf_004r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 4 , rtChk)
	
	rtChk = Form.GetSharedData( "REALTIME_SZ", false )
	DATAMANAGER.SetDataValue(0,"ohhts_metf_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 5 , "SZ")
	DATAMANAGER.SetDataValue(0,"ohhts_metf_004r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 5 , rtChk)
	
	rtChk = Form.GetSharedData( "REALTIME_JP", false )
	DATAMANAGER.SetDataValue(0,"ohhts_metf_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 6 , "JP")
	DATAMANAGER.SetDataValue(0,"ohhts_metf_004r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 6 , rtChk)
	
	DATAMANAGER.RequestTranData("ohhts_metf_004r")
End Function

Function RequestNextTranData_Theme()
	if DATAMANAGER.IsMoreNextData("ohhts_metf_004r") = true then
		DATAMANAGER.RequestNextData("ohhts_metf_004r")
	end if
End Function

Function ResponseTranData_Theme()
	nDataCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_004r", "OutBlock2")
	
	szItemCnt 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock1", "FID_IQRY_CSNU", 0)
	if szItemCnt = "" then 
		contMain.lblItemCnt.visible = false
	else
		contMain.lblItemCnt.visible = true
		contMain.lblItemCnt.caption = "검색결과 "&FormatNumber(szItemCnt, 0)&"건"
	end if
	
	for i = 0 to nDataCnt-1
		'종목코드
		szItem_Cd 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_OVRS_ISCD", i)
		'종목명
		szItem_Nm 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FIDX_KOR_ISNM", i)
		'현재가
		szItem_Prc 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_PRPR", i)
		'전일대비율
		szItem_Rate 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_PRDY_CTRT", i)
		szItem_Rate_Attr 	= trim(DATAMANAGER.GetDataAttr (0, "ohhts_metf_004r", "OutBlock2", "FID_PRDY_CTRT", i))
		
		'거래량
		szItem_Vol 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_VOL" , i)
		'총보수비율
		szItem_Pay		= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_TOTAL_PAY_RATE", i)
		'NAV
		szItem_NAV 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FIDX_NAV", i)
		
		'거래정지여부
		szItem_Stop 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_TRHT_YN", i)
		'신규상장여부
		szItem_New 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_NEW_LSTN_YN", i)
		
		'상장국가코드
		szItem_NationCd 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_LSTN_NTNL_CODE", i)
		'입력시장구분코드
		szItem_MrktCd 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", i)
		
		'레버리지
		szItem_Lvrg 		= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_LVRG" , i)
		
		nIdx = contMain.Pannel0.addRow()
		
		'종목코드 & 시장조치(거래정지/신규상장)
		szItemCd = szItem_Cd
		if szItem_Stop = "Y" then
			szItemCd = szItemCd & " | " & "거래정지"
		end if
		
		if szItem_New = "Y" then
			szItemCd = szItemCd & " | " & "신규상장"
		end if
		
		'현재가 & 수익률
		if szItem_MrktCd = "AX" or szItem_MrktCd = "NY" or szItem_MrktCd = "OQ" then
			szPrc = FormatNumber(szItem_Prc,4)
		elseif szItem_MrktCd = "JP" then
			szPrc = FormatNumber(szItem_Prc,1)
		elseif szItem_MrktCd = "SH" or szItem_MrktCd = "SZ" then
			szPrc = FormatNumber(szItem_Prc,3)
		elseif szItem_MrktCd = "HK" then
			szPrc = FormatNumber(szItem_Prc,3)
		else
			szPrc = FormatNumber(szItem_Prc,0)
		end if
		szPrcRate = szPrc & " | " & FormatNumber(szItem_Rate,2) & "%"
		
		szOsType = Form.GetSharedData("&OS_TYPE", false)
		if szOsType = "2" then
			if Cdbl(szItem_Rate) > 0 then
				szItem_Rate_Attr = "43"
			elseif Cdbl(szItem_Rate) < 0 then
				szItem_Rate_Attr = "45"
			else
				szItem_Rate_Attr = ""
			end if
		end if
		
		'보수율
		nItem_Pay = FormatNumber(szItem_Pay,4)
		szPayRate = ""
		if nItem_Pay = "0.0000" then
			szPayRate = "보수 -"
		else
			szPayRate = "보수 " &  nItem_Pay & "%"
		end if
		
		
		'NAV
		nNav = FormatNumber(szItem_NAV,2)
		szNav = ""
		if nNav = "0.00" then
			szNav = "NAV -"
		else
			szNav = "NAV " & FormatNumber(szItem_NAV,2)
		end if
		
		'거래량
		szVol = ""
		if Clng(szItem_Vol) = 0 then
			szVol = "거래량 -"
		else
			szVol = "거래량 " & FormatNumber(szItem_Vol, 0)
		end if
		
		
		'국기이미지
		szFlag = Form.getIconImg("FLAG", szItem_NationCd)
		if szFlag = "" then
			szFlag = "flag_genral"
		end if
		'관심종목 포함여부
		szIntrCd = ""
		if szItem_NationCd = "KOR" then
			szIntrCd = szItem_Cd
		else
			szIntrCd = szItem_MrktCd&"@"&szItem_Cd
		end if

		isIntrItem = Form.isIntrItemList(szIntrCd)
	
		'인덱스 / 종목코드(시장조치) / 종목명 / 현재가(전일대비) / 국기이미지 / 레버리지인버스 배율 / 관심여부 / 보수율 / NAV / 거래량 / 종목코드
		DisplaySetting_Pannel(nIdx, szItemCd, szItem_Nm, szPrcRate, szItem_Rate_Attr, szFlag, szItem_Lvrg, isIntrItem, szPayRate, szNav, szVol, szIntrCd, szItem_MrktCd, szItem_Nm) 
	next
	
	szidx = Form.GetSharedData("50500_ROW_INDEX", false)
	
	if g_isPrev = true and szidx <> "" then
		nRowCnt = contMain.Pannel0.rowcount
		nIdx = Cint(szidx)
		
		if Cint(nRowCnt) < nIdx+1 then
			RequestNextTranData_Theme()
		else
			if Form.GetSharedData("&OS_TYPE", false) = "1" then
				contMain.fixTopAreaWhenScrolling(true, 132, "Up")
			end if
			
			contMain.Pannel0.toprow = nIdx
			Form.GetSharedData("50500_ROW_INDEX", true)
			'Form.SetTimerEvent2(1,1,0.5)
			
			g_isPrev = false
		end if
	end if
End Function

'인덱스 / 종목코드(시장조치) / 종목명 / 현재가(전일대비) / 국기이미지 / 레버리지인버스 배율 / 관심여부 / 보수율 / NAV / 거래량 / 종목코드
Function DisplaySetting_Pannel(nIdx, szItemCd, szItemNm, szPrcRate, szPrcRateAttr, szFlag, szScale, szIntrYN, szData0, szData1, szData2, szHideData0, szHideData1, szHideData2) 
	'상단 라인표시
	contMain.Pannel0.setPropCardCell("bgcolor","lblLine2", nIdx , g_szLineColor)
	
	'종목 국가 국기이미지 
	contMain.Pannel0.setPropCardCell("maintainratio", "imgFlag", nIdx, "2")
	contMain.Pannel0.setPropCardCell("imgpath","imgFlag", nIdx, szFlag)
	
	'레버리지/인버스 배율
	contMain.Pannel0.setPropCardCell("paddinginfo","lblBadge",nIdx, "0,0,0,0")
	if Cint(szScale) > 0 then
		contMain.Pannel0.setPropCardCell("bgcolor","lblBadge",nIdx, g_szBadgeBgColor_Red)
		contMain.Pannel0.setPropCardCell("fgcolor","lblBadge",nIdx, g_szTxtColor_Red)
	else
		contMain.Pannel0.setPropCardCell("bgcolor","lblBadge",nIdx, g_szBadgeBgColor_Blue)
		contMain.Pannel0.setPropCardCell("fgcolor","lblBadge",nIdx, g_szTxtColor_Blue)
	end if
	contMain.Pannel0.setPropCardCell("caption","lblBadge",nIdx, Cdbl(szScale)&"X")
	
	
	'관심종목 아이콘 (관심등록 여부 확인 후 표시 필요)
	contMain.Pannel0.setPropCardCell("maintainratio", "imgIntr", nIdx, "3")
	if szIntrYN = true then
		contMain.Pannel0.setPropCardCell("imgpath","imgIntr", nIdx, g_szIntrImg_Select)
	else
		contMain.Pannel0.setPropCardCell("imgpath","imgIntr", nIdx, g_szIntrImg_Normal)
	end if
	
	contMain.Pannel0.setPropCardCell("maintainratio", "imgCompChk", nIdx, "3")
	contMain.Pannel0.setPropCardCell("imgpath","imgCompChk", nIdx, g_szChkImg_Normal)
		
	if g_isCompChk = false then
		contMain.Pannel0.setPropCardCell("visible","imgCompChk", nIdx, false)
		contMain.Pannel0.setPropCardCell("visible", "imgIntr", nIdx, true)
	else
		contMain.Pannel0.setPropCardCell("visible","imgCompChk", nIdx, true)
		contMain.Pannel0.setPropCardCell("visible", "imgIntr", nIdx, false)
	end if
	
	'종목명
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemName",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemName",nIdx, g_szTxtColor_Normal)
	contMain.Pannel0.setPropCardCell("maxlinecnt","lblItemName",nIdx, "1^-4")
	contMain.Pannel0.setPropCardCell("fontsize","lblItemName",nIdx, "-2")
	contMain.Pannel0.setPropCardCell("caption","lblItemName",nIdx, szItemNm)
	
	'종목코드(시장조치)
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemCode",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemCode",nIdx, g_szTxtColor_Grey)
	contMain.Pannel0.setPropCardCell("fontsize","lblItemCode",nIdx, "-2")
	contMain.Pannel0.setPropCardCell("caption","lblItemCode",nIdx, szItemCd)
	
	'현재가(전일대비)
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemPrc",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Grey)
	contMain.Pannel0.setPropCardCell("fontsize","lblItemPrc",nIdx, "-2")
	contMain.Pannel0.setPropCardCell("caption","lblItemPrc",nIdx, szPrcRate)
	
'	arrTemp = split(szPrcRate, "|")
'
'	if #arrTemp > 1 then
'		nLen_Prc = Form.getLen(arrTemp(0))
'		nLen_Rate = Form.getLen(arrTemp(1))
'	
'		contMain.Pannel0.setPropCardCell("textattr","lblItemPrc",nIdx, nLen_Prc & "^1^333^-2^false^"&szPrcRate&"^2" )
'		
'		if szPrcRateAttr = "43" then
'			contMain.Pannel0.setPropCardCell("textattr","lblItemPrc",nIdx, nLen_Prc+1 & "^" & nLen_Rate & "^290^-2^true^" & szPrcRate & "^2" )
'		elseif szPrcRateAttr = "45" then
'			contMain.Pannel0.setPropCardCell("textattr","lblItemPrc",nIdx, nLen_Prc+1 & "^" & nLen_Rate & "^291^-2^true^" & szPrcRate & "^2" )
'		else
'			contMain.Pannel0.setPropCardCell("textattr","lblItemPrc",nIdx, nLen_Prc+1 & "^" & nLen_Rate & "^333^-2^true^" & szPrcRate & "^2" )
'		end if
'	else	
		if szPrcRateAttr = "43" then
			contMain.Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Buy)
		elseif szPrcRateAttr = "45" then
			contMain.Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Sell)
		else
			contMain.Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Grey)
		end if
'	end if

	'보수
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemData0",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemData0",nIdx, g_szTxtColor_Grey)
	contMain.Pannel0.setPropCardCell("fontsize","lblItemData0",nIdx, "-4")
	contMain.Pannel0.setPropCardCell("caption","lblItemData0",nIdx, szData0)
	
	'NAV
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemData1",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemData1",nIdx, g_szTxtColor_Grey)
	contMain.Pannel0.setPropCardCell("fontsize","lblItemData1",nIdx, "-4")
	contMain.Pannel0.setPropCardCell("caption","lblItemData1",nIdx, szData1)
	
	'거래량
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemData2",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemData2",nIdx, g_szTxtColor_Grey)
	contMain.Pannel0.setPropCardCell("fontsize","lblItemData2",nIdx, "-4")
	contMain.Pannel0.setPropCardCell("caption","lblItemData2",nIdx, szData2)
	
	'(숨김)종목코드
	contMain.Pannel0.setPropCardCell("caption","lblHideData0",nIdx, szHideData0)
	contMain.Pannel0.setPropCardCell("caption","lblHideData1",nIdx, szHideData1)
	contMain.Pannel0.setPropCardCell("caption","lblHideData2",nIdx, szHideData2)
	
	'화면연동 버튼
	contMain.Pannel0.setPropCardCell("paddinginfo","btnHyun",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnHyun",nIdx, g_szTxtColor_Grey)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnChart",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnChart",nIdx, g_szTxtColor_Grey)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnInfo",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnInfo",nIdx, g_szTxtColor_Grey)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnOrder0",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnOrder0",nIdx, g_szTxtColor_White)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnOrder1",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnOrder1",nIdx, g_szTxtColor_White)
End Function

Function Make_NationSet(szData)
	szResult = ""
	
	if instr(szData, "전체") > 0 then
		szResult = "YNNNNN"
	else
		szResult = "N"
		if instr(szData, "국내") > 0 then
			szResult = szResult & "Y"
		else
			szResult = szResult & "N"
		end if
		
		if instr(szData, "미국") > 0 then
			szResult = szResult & "Y"
		else
			szResult = szResult & "N"
		end if
		
		if instr(szData, "중국") > 0 then
			szResult = szResult & "Y"
		else
			szResult = szResult & "N"
		end if
		
		if instr(szData, "홍콩") > 0 then
			szResult = szResult & "Y"
		else
			szResult = szResult & "N"
		end if
		
		if instr(szData, "일본") > 0 then
			szResult = szResult & "Y"
		else
			szResult = szResult & "N"
		end if
		
		if szResult = "NNNNNN" then
			szResult = "YNNNNN"
		end if
	end if
	
	return szResult
End Function

Function Make_SortIndex(szData)
	szResult = "0"
	
	if szData = "상승률 높은순" then
		szResult = "1"
	elseif szData = "상승률 낮은순" then
		szResult = "2"	
	elseif szData = "거래량 많은순" then
		szResult = "3"
	elseif szData = "보수 낮은순" then
		szResult = "4"
	elseif szData = "거래량 적은순" then
		szResult = "5"
	elseif szData = "보수 높은순" then
		szResult = "6"
	elseif szData = "배당 낮은순" then
		szResult = "7"
	elseif szData = "배당 높은순" then
		szResult = "8"
	end if
	
	return szResult
End Function

Function MovePopup(nidx, nGbn)
	szMktCd = contMain.Pannel0.getPropCardCell("caption","lblHideData1",nidx)
	szItemCd = contMain.Pannel0.getPropCardCell("caption","lblHideData0",nidx)
	szItemNm = contMain.Pannel0.getPropCardCell("caption","lblHideData2",nidx)
	
	Form.SetSharedData("50500_INDEX", "1")

	Form.SetSharedData("50500_FILTER" , g_szSaveFilterData1)
			
	Form.SetSharedData("50500_ROW_INDEX", nidx)
	
	Select Case szMktCd
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			Form.SetSharedData( "&ITEM_CODE" , szItemCd )
			Form.SetSharedData( "&ITEM_KORNAME" , szItemNm )
			Form.SetSharedData( "&ITEM_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )					
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )
			
			if nGbn == 0 then						' 현재가
				Form.OpenScreen("16000", szItemCd&"★ETF★1")				
			elseif nGbn == 1 then					' 차트
				Form.OpenScreen("16020", "")
			elseif nGbn == 2 then				
				Form.OpenScreen("16000", szItemCd&"★ETF★0")		
			elseif nGbn == 3 then					' 매수
				Form.OpenScreen("16060", "0")
			elseif nGbn == 4 then					' 매도
				Form.OpenScreen("16060", "1")
			end if
			
			Form.manageTotalSearch("ETF_SUPER_HISTORY", "set", szItemCd)
		Case Else
			if nGbn == 0 then							' 현재가
				Form.OpenScreen("11000", szItemCd&"★ETF★1")
			elseif nGbn == 1 then						' 차트
				Form.OpenScreen("13000", szItemCd)
			elseif nGbn == 2 then						' 뉴스
				Form.OpenScreen("11000", szItemCd&"★ETF★0")
			elseif nGbn == 3 then						' 매수
				Form.OpenScreen("12000", "스크리너★0" & "★" & szItemCd)
			elseif nGbn == 4 then						' 매도
				Form.OpenScreen("12000", "스크리너★1" & "★" & szItemCd)
			end if	
			
			Form.manageTotalSearch("ETF_SUPER_HISTORY", "set", "J@"&szItemCd)
	End Select

End Function

