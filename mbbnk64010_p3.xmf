'============================================================================
' 화 면 명 : 외화이체 금융기관팝업
'============================================================================

Dim g_szSeparator

Dim GridBankRowCount

Dim g_szCurrencyCode

Dim g_szBankCode
Dim g_szBankName
Dim g_szBankAcno
Dim g_szBicCode
Dim g_nSendAmt

Dim g_AcntCopyYn

'============================================================================
' Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	contEdtAcno.imgLogo.setMaintainingRatio("1")
	contEdtAcno.ImgPrcreset.setMaintainingRatio("1")
	Container0.ContainerBank.GridBank.setMaintainingRatio( "bd_Bimage1" , 0, "1")
	Container0.ContainerBank.GridBank.setMaintainingRatio( "bd_Bimage2" , 0, "1")
End Sub

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	contEdtAcno.imgLogo.setMaintainingRatio("1")
	contEdtAcno.ImgPrcreset.setMaintainingRatio("1")

	Container0.ContainerBank.GridBank.SetClear()
	
	GridBankRowCount = 0
	
	g_szSeparator = "★"
	g_AcntCopyYn = "0"
	
	szData = Form.GetOpenLinkData()
	
	If szData <> "" and szData <> null then
		arrBankInfo = Split(szData, "★")
		g_szType = arrBankInfo(4)
		g_nSendAmt = arrBankInfo(5)
		g_szCurrencyCode = Form.GetSharedData("64010_CurrencyCode")

		If g_szType == "SelectBank" then
			Container0.visible =  "1"
		ElseIf g_szType == "EditAcno" then
			g_szBankCode = arrBankInfo(0)
			g_szBankAcno = arrBankInfo(1)
			g_szBankName = arrBankInfo(2)
			g_szBicCode  = arrBankInfo(3)
						
			If Trim(g_szBankAcno) <> "" Then '계좌번호 입력받고 들어온 경우(계좌복사인 경우밖에 없음)
			    
			    If Trim(g_szBankName) <> "" Then '은행명이 있을경우
                      contEdtAcno.lblBankName.caption = g_szBankName
			        contEdtAcno.imgLogo.imgpath = "bank"..g_szBankCode..".png"
			        contEdtAcno.edtRecAcno.caption = g_szBankAcno
			    Else '계좌만 있을 경우
			        g_AcntCopyYn = "1"
			        contEdtAcno.lblBankSelect.visible = "1"
                      contEdtAcno.lblBankName.caption = ""
			        contEdtAcno.imgLogo.imgpath = ""
			        contEdtAcno.edtRecAcno.caption = g_szBankAcno
			    End If
			    
			Else
			    contEdtAcno.lblBankName.caption = g_szBankName
			    contEdtAcno.imgLogo.imgpath = "bank"..g_szBankCode..".png"
			    contEdtAcno.edtRecAcno.caption = ""
			End If
			
			contEdtAcno.visible =  "1"
			btnConfirm.visible = "1"
		End If
		f_CheckAmtFont()
	End If
	
	DATAMANAGER.RequestTranData("obtsp_comm_001r")

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	szACNO = acntList.total
	szASNO = acntList.sequence
	
	If szTranID = "obtsp_comm_001r" then
		DATAMANAGER.SetDataValue(0, "obtsp_comm_001r", "InBlock1", "ISTU_CLCD"     , 0 , "3")	'기관구분코드(1 은행, 2 증권, 3 외화)
		DATAMANAGER.SetDataValue(0, "obtsp_comm_001r", "InBlock1", "IQRY_CLS_CODE" , 0 , "5")	'조회구분코드(5 외화이체기관)
		
	'외화송금 예금주명조회
	elseIf szTranID == "obtsd_fbnk_121r" then
		if g_szBankCode = "287" then
			szTACT_LNKD_ISTU_CODE = "287"
		else
			szTACT_LNKD_ISTU_CODE = "702"
		end if

		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "PROS_CLS_CODE"           , 0 , "1")	'처리구분코드 (1.수취조회)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "ACNO"                    , 0 , szACNO)	'출금계좌
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "ASNO"                    , 0 , szASNO)	'출금계좌
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "TACT_LNKD_ISTU_CODE"     , 0 , szTACT_LNKD_ISTU_CODE)	'이체연계기관코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "BANK_CODE"               , 0 , g_szBankCode)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "BANK_ACNO"               , 0 , g_szBankAcno)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "CRCD"                    , 0 , g_szCurrencyCode)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "FRCR_TR_AMT"             , 0 , g_nSendAmt)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "RRNO"                    , 0 , Form.GetSharedData("&RET_RSNO", False))
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "BIC_CODE"                , 0 , g_szBicCode)				
	
	end if
End Sub

'============================================================================
' 데이터 수신 
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtsp_comm_001r" Then
		tmpcount = DATAMANAGER.GetDataCount( 0 , "obtsp_comm_001r", "OutBlock1")	
		image1	=""
		name1	=""
		code1	=""
		biccode1 =""
		image2	=""
		name2	=""
		code2	=""
		biccode2 =""
	
		for i = 0 to tmpcount-1	step 2
			Container0.ContainerBank.GridBank.AddRow()
			j = i+1
			
			image1    = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, i	) '이미지명
			name1     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, i	) '이미지명
			code1     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, i	) '이미지명
			biccode1  = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BIC_CODE"				, i	) '이미지명
			
	      'contEdtAcno.imgLogo.setMaintainingRatio("1")
	      'contEdtAcno.ImgPrcreset.setMaintainingRatio("1")
			Container0.ContainerBank.GridBank.setMaintainingRatio( "bd_Bimage1" , GridBankRowCount, "1")
			Container0.ContainerBank.GridBank.setMaintainingRatio( "bd_Bimage2" , GridBankRowCount, "1")
			
			Container0.ContainerBank.GridBank.SetCellData("bd_Bimage1" 	, GridBankRowCount, image1	 ) 
			Container0.ContainerBank.GridBank.SetCellData("bd_Bname1" 	, GridBankRowCount, name1	 ) 
			Container0.ContainerBank.GridBank.SetCellData("bd_Bcode1" 	, GridBankRowCount, code1	 ) 
			Container0.ContainerBank.GridBank.SetCellData("bd_BicCode1" , GridBankRowCount, biccode1 ) 
			
			if tmpcount%2 ==0 and j+1 ==tmpcount then '짝수개 리턴, 마지막일경우
				image2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, j) '이미지명
				name2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, j) '이미지명
				code2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, j) '이미지명
				biccode2  = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BIC_CODE"				, j) '이미지명

				Container0.ContainerBank.GridBank.SetCellData("bd_Bimage2" 	, GridBankRowCount, image2	 ) 
				Container0.ContainerBank.GridBank.SetCellData("bd_Bname2" 	, GridBankRowCount, name2	 )
				Container0.ContainerBank.GridBank.SetCellData("bd_Bcode2" 	, GridBankRowCount, code2	 )
				Container0.ContainerBank.GridBank.SetCellData("bd_BicCode2" , GridBankRowCount, biccode2 ) 
				Exit Sub
			
			elseif tmpcount%2 == 1 and j == tmpcount then '홀수개 리턴, 마지막일경우
				Container0.ContainerBank.GridBank.SetCellData("bd_Bimage2" 	,GridBankRowCount, "alpha"	 ) 
				Container0.ContainerBank.GridBank.SetCellData("bd_Bname2" 	,GridBankRowCount, ""	 )
				Container0.ContainerBank.GridBank.SetCellData("bd_Bcode2" 	,GridBankRowCount, ""	 )
				Container0.ContainerBank.GridBank.SetCellData("bd_BicCode2"	,GridBankRowCount, ""	 )
				Exit Sub
			end if
			
			image2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, j) '이미지명
			name2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, j) '이미지명
			code2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, j) '이미지명
			biccode2  = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BIC_CODE"				, j) '이미지명
			
			Container0.ContainerBank.GridBank.SetCellData("bd_Bimage2" 	, GridBankRowCount, image2	 ) 
			Container0.ContainerBank.GridBank.SetCellData("bd_Bname2" 	, GridBankRowCount, name2	 )
			Container0.ContainerBank.GridBank.SetCellData("bd_Bcode2" 	, GridBankRowCount, code2	 )
			Container0.ContainerBank.GridBank.SetCellData("bd_BicCode2"	, GridBankRowCount, biccode2 )
			
			
			GridBankRowCount = GridBankRowCount +1
		next

	elseIf szTranID == "obtsd_fbnk_121r" then
		szName = DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "ENG_RMT_NAME", 0 )
		
		szData = g_szBankCode..g_szSeparator..g_szBankAcno..g_szSeparator..g_szBankName..g_szSeparator..szName
'		szData = g_szBankCode..g_szSeparator..g_szBankAcno..g_szSeparator..g_szBankName..g_szSeparator..szName..g_szSeparator..g_szBicCode

		Form.SendReturnToParent("mbbnk64010_p3" , szData)
		Form.CloseForm()
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = Trim(DATAMANAGER.GetDataMsgSubText( szTranID ))
	If szSubErr == "" Then
		Form.MsgBox( "알림", szErrMsg, "", 6 )		
	Else
		Form.MsgBox( "알림", szSubErr, "", 6 )
	End if
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_ContainerBank_GridBank_OnClickUp(lRow, szCellID)

	if szCellID =="bd_Bimage1" or szCellID =="bd_Bname1" or szCellID =="bd_Bcode1" or szCellID =="bd_BicCode1" or szCellID =="bd_cell0" or szCellID =="bd_cell1" or szCellID =="bd_cell2" or szCellID =="bd_cell7" then
		szBankNm   = Container0.ContainerBank.GridBank.GetCellData("bd_Bname1", lRow)
		szBankCode = Container0.ContainerBank.GridBank.GetCellData("bd_Bcode1", lRow)
		szBankImage= Container0.ContainerBank.GridBank.GetCellData("bd_Bimage1", lRow)
		szBicCode  = Container0.ContainerBank.GridBank.GetCellData("bd_BicCode1", lRow)
	elseif szCellID =="bd_Bimage2" or szCellID =="bd_Bname2" or szCellID =="bd_Bcode2" or szCellID =="bd_BicCode2" or szCellID =="bd_cell3" or szCellID =="bd_cell4" or szCellID =="bd_cell5" or szCellID =="bd_cell8" then
		szBankNm   = Container0.ContainerBank.GridBank.GetCellData("bd_Bname2", lRow)
		szBankCode = Container0.ContainerBank.GridBank.GetCellData("bd_Bcode2", lRow)
		szBankImage= Container0.ContainerBank.GridBank.GetCellData("bd_Bimage2", lRow)
		szBicCode  = Container0.ContainerBank.GridBank.GetCellData("bd_BicCode2", lRow)
	end if
	
	if trim(szBankNm)  ="" then '홀수개 리턴시 하단 우측 공백
		Exit Sub
	end if
			
	'2023-12-07 CNY 제외
	if g_szCurrencyCode = "CNY" and szBankCode <> "287" and szBankCode <> "004" then
		Form.MsgBox("알림", "["..g_szCurrencyCode.."] 타행 이체는 국민은행 또는\n영업점을 통해 이체 가능합니다.", "", 0)
		Exit Sub
	end if

	g_szBankCode = szBankCode
	g_szBankName = szBankNm
	g_szBicCode  = szBicCode
	Form.SetSharedData("64010_BicCode", g_szBicCode)
	
	contEdtAcno.lblBankName.caption = szBankNm
	contEdtAcno.imgLogo.imgpath = "bank"..szBankCode..".png"

    If Trim(contEdtAcno.edtRecAcno.caption) == "" Then
		contEdtAcno.edtRecAcno.fontsize = 0
    Else
		contEdtAcno.edtRecAcno.fontsize = 7
    End If
    
	Container0.visible =  "0"
	contEdtAcno.visible =  "1"
	btnConfirm.visible = "1"
	
End Sub

