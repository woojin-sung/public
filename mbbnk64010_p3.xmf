End Sub

'============================================================================
Sub f_CheckAmtFont()
	if contEdtAcno.edtRecAcno.caption == null or contEdtAcno.edtRecAcno.caption == "" then
		btnConfirm.enable = "0"
		btnConfirm.btnimage = "btn_21.9"
		contEdtAcno.ImgPrcreset.visible = "0"
		contEdtAcno.edtRecAcno.fontsize = 0
	else
		btnConfirm.enable = "1"
		btnConfirm.btnimage = "btn_20.9"
		contEdtAcno.ImgPrcreset.visible = "1"
		contEdtAcno.edtRecAcno.fontsize = 7
	end if
End Sub

'============================================================================
Sub btnConfirm_OnClick()
	if Len(contEdtAcno.edtRecAcno.caption) == 0 then
		Form.MsgBox("알림", "입금계좌번호를 입력해주세요.", "", 6)
		Exit Sub
	end if
	
	g_szBankAcno = contEdtAcno.edtRecAcno.caption
	
	DATAMANAGER.RequestTranData( "obtsd_fbnk_121r" ) '외화 수취인조회

End Sub

'============================================================================
Sub contEdtAcno_btnSelectBank_OnClick()
	if g_szCurrencyCode = "" or g_szCurrencyCode == NULL then
		Form.MsgBox("알림", "통화코드를 확인하십시요.", "", 6)
		Exit Sub
	
	elseif g_szCurrencyCode = "USD" or g_szCurrencyCode = "JPY" or g_szCurrencyCode = "HKD" or g_szCurrencyCode ="CNY" then
	
		'2023-12-07 CNY 제외
		if g_szCurrencyCode = "CNY" and g_szBankCode <> "287" and g_szBankCode <> "004" then
			Form.MsgBox("알림", "["..g_szCurrencyCode.."] 타행 이체는 국민은행 또는\n영업점을 통해 이체 가능합니다.", "", 0)
			Exit Sub
		else	
			Container0.visible =  "1"
			contEdtAcno.visible =  "0"
			btnConfirm.visible = "0"
		
			If g_AcntCopyYn == "0" Then '계좌복사 아니면
			    contEdtAcno.edtRecAcno.caption = ""
			End If
			g_AcntCopyYn = "0"
			contEdtAcno.lblBankSelect.visible = "0"	
		end if
     
	else
	
		Form.MsgBox("알림", "["..g_szCurrencyCode.."] 타행 이체는 영업점 또는\n고객지원센터를 통해 이체 가능합니다.", "", 0)
		Exit Sub
		
	end if
End Sub

'============================================================================
Sub contEdtAcno_ImgPrcreset_OnClick()
    btnConfirm.enable = "0"
    btnConfirm.btnimage = "btn_21.9"
    contEdtAcno.ImgPrcreset.visible = "0"
    contEdtAcno.edtRecAcno.fontsize = 0
    contEdtAcno.edtRecAcno.caption = ""
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

    If sKey == "&LOGIN_AUTH" Then
        
        If sValue == "0" Or sValue == "1" Then
            Form.CloseForm()
        End If
    
    End If

End Sub

