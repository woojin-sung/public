	<SCRIPT_INFO _len="1549" _ulen="1461" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Wrap상품 목록 조회
' 02. 화면설명 : 
' 03. 이    력 : 2023.12.12 : 고승연 : v0002 : 이해관계인 문구 수정
'                2024.06.28 : 고승연 : v0003 : 오타 수정
'-------------------------------------------------------------------------------------------

Dim g_sType, g_tContTop
Dim g_sAdcpClsName

'============================================================================
Sub Form_OnFormInit()
	cont0.Label0.changeTextAttr(16, 11, 1, -1, false)
	cont0.Label1.changeTextAttr(8, 11, 1, -1, false)
	
	g_sType = Form.GetOpenLinkData()
	
	if g_sType <> null and g_sType <> "" then
		Dim tData
		tData = Split(g_sType, "|")
		
		g_sType = tData(0)
		
		if #tData > 1 then
			g_sAdcpClsName = tData(1)
			
			if g_sAdcpClsName <> null and g_sAdcpClsName <> "" then
				cont1.tblText1.SetCellString(5, 1, "투자자는 ["..g_sAdcpClsName.."] (으)로부터 투자")
			end if
		end if
		
		Form.SetCtlProp("cont"..g_sType, "visible", "1")
		imgBg.top = Form.GetCtlProp("cont"..g_sType, "top") - 15
		imgBg.height = 647 - (Form.GetCtlProp("cont"..g_sType, "top") - 15)
	end if
End Sub

'============================================================================
Sub btnOk_OnClick()
	Form.SendReturnToParent("RETURN", g_sType)
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>