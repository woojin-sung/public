'===========================================================================
'===========================================================================

Dim g_GridCnt
'============================================================================
Sub Form_OnFormInit()

	g_GridCnt = 0
	DATAMANAGER.RequestTranData("obrgt_oscm_772r")
	ItemCode0.code="empty"
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	
	if szTranID == "obrgt_oscm_772r" then
		szCmb0 = Combo0.cbkeydata
		szCmb1 = Combo1.cbkeydata
		szCmb2 = Combo2.cbkeydata
		
		if szCmb0 == "0" then
			DATAMANAGER.SetDataValue( 0, "obrgt_oscm_772r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , szCmb1 )
		else
			DATAMANAGER.SetDataValue( 0, "obrgt_oscm_772r", "InBlock1", "ISCD" , 0 , ItemCode0.code)
		end if 
		
		DATAMANAGER.SetDataValue( 0, "obrgt_oscm_772r", "InBlock1", "OVRS_STCK_RGHT_CLS_CODE" , 0 , "03" )
'		DATAMANAGER.SetDataValue( 0, "obrgt_oscm_772r", "InBlock1", "OVRS_STCK_ISSU_TPCD", 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obrgt_oscm_772r", "InBlock1", "CASH_STCK_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obrgt_oscm_772r", "InBlock1", "DATE_CLS" , 0 , szCmb2 )
		DATAMANAGER.SetDataValue( 0, "obrgt_oscm_772r", "InBlock1", "STA_DATE" , 0 , cldFromDate.caption )
		DATAMANAGER.SetDataValue( 0, "obrgt_oscm_772r", "InBlock1", "FIN_DATE" , 0 , cldToDate.caption )
	end if
End Sub

'============================================================================
' grd0_OnScrollEnd()
'============================================================================
Sub Grid0_OnScrollEnd()
	g_GridCnt = Grid0.rowcount
	DATAMANAGER.RequestNextData("obrgt_oscm_772r")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrgt_oscm_772r" then
		szCnt = Grid0.rowcount
		'for i = 0 to szCnt-1
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obrgt_oscm_772r", "OutBlock1")
			Grid0.SetCellData("bd_cell7", i+g_GridCnt, "현금배당")
		next
	end if
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	if iIndex == 0 then
		Combo1.visible = true
		ItemCode0.visible = false
		ItemCode0.caption = ""

	elseif iIndex == 1 then
		Combo1.visible = false
		ItemCode0.visible = true
	end if
	DATAMANAGER.RequestTranData("obrgt_oscm_772r")
End Sub

'============================================================================
Sub Combo1_OnEditComplete(iIndex)
	DATAMANAGER.RequestTranData("obrgt_oscm_772r")
End Sub

'============================================================================
Sub Combo2_OnEditComplete(iIndex)
	DATAMANAGER.RequestTranData("obrgt_oscm_772r")
End Sub

'============================================================================
Sub cldFromDate_OnEditComplete()
	DATAMANAGER.RequestTranData("obrgt_oscm_772r")
End Sub

'============================================================================
Sub cldToDate_OnEditComplete()
	DATAMANAGER.RequestTranData("obrgt_oscm_772r")
End Sub

