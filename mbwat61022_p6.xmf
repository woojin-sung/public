	<SCRIPT_INFO _len="1095" _ulen="1045" >
--===========================================================================
--===========================================================================

'============================================================================
Sub Form_OnFormInit()
	imgCheck0.setMaintainingRatio("1")
	imgCheck1.setMaintainingRatio("1")
	btnAgree.setApplySwitch("OFF", "ON", "294", "200", "270", "289")
	btnAgree.switchindex = 1
End Sub

'============================================================================
Sub btnAgree_OnClick()
	if btnAgree.switchindex == "1" then
		lblAgreeText.caption = "숙려기간 종료 후 즉시 운용"
	else
		lblAgreeText.caption = "미동의시, 숙려기간 종료 7일 후 운용"
	end if
End Sub

'============================================================================
Sub btnOk_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Dim sAgree
	sAgree = (btnAgree.switchindex = "1" and "Y" or "N")
	
	Form.SendReturnToParent("Check", sAgree)
End Sub

	</SCRIPT_INFO>
