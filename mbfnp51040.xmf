						<CELL cell_ly="1,1,3,1" import="1,1,2" halign="2" line="0,0" fontsize="-2" mask="0,0,,원,0,,0,1,1,0,0" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<IMAGE name="imgTooltip" autosize="1" imgpath="icon_question" ly_vert="85,170,16,15,1" />
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="22339" _ulen="19903" >
'============================================================================
' 01. 화 면 명 : 고객자산평가_상품별잔고_펀드
' 02. 화면설명 : 고객자산평가_상품별잔고_펀드
' 03. 작    성 : 2016. 01. 19. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nAcntCount	'계좌 개수	
Dim g_nAllCount	'전체조회시 계좌 Index
Dim g_szList

Dim g_szDate

Dim g_szStndCd
Dim g_szShortCd
Dim g_szRmndSrno

dim g_szHGDTYn	'고난도상품여부
dim g_szFITYn		'적정성상품여부

Dim g_szID
Dim g_szLinkedYn

Dim g_SellBuy     '1: 매도, 2: 매수
Dim g_szSendData

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_nAllCount = 0
	
	g_szDate = Form.GetSharedData("&HOST_DATE",0)
	szDate = right(g_szDate, 6)
	cont0.lblDate.caption = szDate
	
	g_nAcntCount = 1		'계좌개수	
	g_nNextCount = 0		'서비스 날리기전 인덱스 초기화
	
	g_szID = Form.GetSharedData("&USER_ID", false )
	
	DATAMANAGER.RequestTranData("obcsb_acif_799r") '고객번호로 전문투자자여부 조회
	
	'상단 카드뷰 평가금액 서비스 호출 후 자산조회
	call VltnAmt_Request()
		
	cont0.setScrollBarVisible("0") 
End Sub

'============================================================================
Sub cmbAccount_ChangeAccount()
	g_nNextCount = 0
	
	'상단 카드뷰 평가금액 서비스 호출 후 자산조회
	call VltnAmt_Request()
End Sub

'============================================================================
Function VltnAmt_Request()
	DATAMANAGER.RequestTranData("obacb_balc_154r")	
End Function

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_acif_799r" then 
		dim szCust_Num	'고객번호
		szCust_Num = Form.GetSharedData("&CUST_NUM", false )
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , szCust_Num)
	
	elseif szTranID == "obacb_balc_154r" then 
		DATAMANAGER.ClearInputData(0, "obacb_balc_154r")
		szCsno = Form.GetSharedData("&CUST_NUM", false )
		
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ACNO"		  , 0 , cmbAccount.total)
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASNO"		  , 0 , cmbAccount.sequence)
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASET_CLS_CODE" , 0 , "07")
		
	elseif	szTranID	=	"obsim_idmn_018r"	then				'종목집투기본정보조회
		DATAMANAGER.SetDataValue(0, "obsim_idmn_018r", "InBlock1", "ISCD", 0, g_szShortCd)
		
	elseif szTranID = "obsai_deal_700r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE", 		0, g_SellBuy)			'1:매도, 2:매수
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 				0, cmbAccount.total)	'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 				0, cmbAccount.sequence)'계좌일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RMND_SRNO", 			0, g_szRmndSrno)		'잔고일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD", 				0, g_szShortCd)		'종목코드
		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp0, szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp11, szTemp12, szTemp13, szTemp14, TempCount
	
	dim	szAbleYN 	 
	dim	szErrCode 
	dim	szErrMsg	 
	
	if szTranID == "obcsb_acif_799r" then 
	
		g_KYC_SPCL_INVR_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "KYC_SPCL_INVR_YN", 0)	'KYC전문투자자여부
			
	'---------------------------------------------------------
	'평가금액 조회
	'---------------------------------------------------------
	elseif szTranID == "obacb_balc_154r" then
		'20230828 아이디 연결여부 추가
		g_szLinkedYn = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "ID_LNKN_YN" , i)
		Form.SetSharedData("71052_ID_LNKN_YN" , g_szLinkedYn)
		
		nPrlsrate = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "PLRT" , i)			'손익률
		nPrlsamt = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "VLTN_PRLS_AMT" , i)	'평가손익
		if CDBL(nPrlsrate) > 0 then
			szPrls = "+"..FormatNumber(nPrlsamt,0).."원   |   +"..FormatNumber(nPrlsrate,2).."%"
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "10")
		elseif CDBL(nPrlsrate) < 0 then
			szPrls = FormatNumber(nPrlsamt,0).."원   |   "..FormatNumber(nPrlsrate,2).."%"
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "11")
		else
			szPrls = FormatNumber(nPrlsamt,0).."원   |   "..FormatNumber(nPrlsrate,2).."%"
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "4")
		end if
		
		cont0.grd1.rowcount = 0
		DATAMANAGER.ClearInputData(0, "obacb_balc_030r")
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_030r", "InBlock1", "UI_UNIT_CLS" , 0 , "2" )		'개별계좌 조회
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_030r", "InBlock1", "ACNO" , 0 , cmbAccount.total )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_030r", "InBlock1", "ASNO" , 0 , cmbAccount.sequence )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_030r", "InBlock1", "STND_DATE" , 0 , g_szDate )	'날짜

		DATAMANAGER.RequestTranData( "obacb_balc_030r" )		
		
	'계좌번호블록에 계좌번호+계좌명으로 출력
	elseif szTranID == "obacb_balc_030r" then
	
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obacb_balc_030r", "OutBlock2")-1
			
			cont0.grd1.AddRow()
			
			szTemp0 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "ACNO" , i) 
			szTemp0 = Left(szTemp0, 4).."-"..Right(szTemp0, 4).."-"
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "RMND_SRNO" , i)	'잔고일련번호
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "ABRV_ISNM" , i)	'축약종목명
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "PSNT_RMND_ACNU" , i)	'체결잔고
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "BYOV_AMT" , i)	'매수금액
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "VLTN_AMT" , i)	'평가금액
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "VLTN_PRLS_AMT" , i)	'평가손익
			szTemp7 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "ERT" , i)	'수익률
			szTemp8 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "LOAN_BAL" , i)	'대출잔액
			szTemp10 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "MTRT_DATE" , i)	'만기일자
			szTemp10 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "MTRT_DATE" , i)	'만기일자
			TempCount = Len(DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "ACNT_PRNM" , i))
			szTemp9 = Mid(DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "ACNT_PRNM" , i), 3, TempCount - 2)'상품명
			szTemp0 = szTemp0 & DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "ASNO" , i) & szTemp9
			szTemp11 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "ISCD" , i)	'종목코드
			szTemp12 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "SCTY_STND_CODE" , i)	'표준코드
			szTemp13 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "IISC_SVNG_TYPE_CODE" , i)	'집합투자증권저축유형코드
			szTemp14 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "ACNO" , i) 
			szTemp15 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "ASNO" , i) 

			cont0.grd1.SetCellData("bd_cell0", g_nNextCount , szTemp1)
			cont0.grd1.SetCellData("bd_cell1", g_nNextCount , szTemp1)
			cont0.grd1.SetCellData("bd_cell2", g_nNextCount , szTemp2)
			cont0.grd1.SetCellData("bd_cell3", g_nNextCount , szTemp3)
			cont0.grd1.SetCellData("bd_cell4", g_nNextCount , szTemp4)
			cont0.grd1.SetCellData("bd_cell5", g_nNextCount , szTemp5)
			cont0.grd1.SetCellData("bd_acc", g_nNextCount , szTemp14..szTemp15)
			
			cont0.grd1.SetCellData("bd_gubun", g_nNextCount, "펀드")	'펀드잔고->obacb_balc_028r MKSC_CLS_NAME 필드
			if CLng(szTemp8) <> 0 then
				szJango = "대출"
				cont0.grd1.SetCellImage("bd_img", g_nNextCount, "btn_blue_bg_02.9.png")
				cont0.grd1.SetCellData("bd_img", g_nNextCount, szJango)
				cont0.grd1.SetCellData("bd_gubun", g_nNextCount, szJango)
				cont0.grd1.SetCellData("bd_loan", g_nNextCount, szTemp8) '대출금액
				cont0.grd1.SetCellData("bd_cell10", g_nNextCount, szTemp10) '만기일
				cont0.grd1.SetCellFgColor("bd_img", g_nNextCount, "250")
			end if
			
			if CDBL(szTemp7) > 0 then
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , "+"..CInt(szTemp6))
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , "+"..FormatNumber(szTemp7, 2))
				cont0.grd1.SetCellFgColor("bd_cell6", g_nNextCount, "10")
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "10")
			elseif CDBL(szTemp7) < 0 then
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , CInt(szTemp6))
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , FormatNumber(szTemp7, 2))
				cont0.grd1.SetCellFgColor("bd_cell6", g_nNextCount, "11")
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "11")
			else
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , CInt(szTemp6))
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , FormatNumber(szTemp7, 2))
			end if	
			
			cont0.grd1.SetCellData("bd_cell11", g_nNextCount , szTemp11)
			cont0.grd1.SetCellData("bd_cell12", g_nNextCount , szTemp12)
			cont0.grd1.SetCellData("bd_cell13", g_nNextCount , szTemp13)
		
		
'			cont0.grd1.SetCellImage("bd_Info", g_nNextCount, "standby_line_w.png")	'"img_bgbox.9.png"
			cont0.grd1.SetCellFgColor("bd_Info", g_nNextCount, "4")
			cont0.grd1.SetCellData("bd_Info", g_nNextCount, "펀드정보")
'			
'			cont0.grd1.SetCellImage("bd_Add", g_nNextCount, "standby_line_w.png")
			cont0.grd1.SetCellFgColor("bd_Add", g_nNextCount, "10")
			cont0.grd1.SetCellData("bd_Add", g_nNextCount, "추가매수")
'			
'			cont0.grd1.SetCellImage("bd_Sell", g_nNextCount, "standby_line_w.png")
			cont0.grd1.SetCellFgColor("bd_Sell", g_nNextCount, "11")
			cont0.grd1.SetCellData("bd_Sell", g_nNextCount, "매도")
			
			
			g_nNextCount = g_nNextCount + 1
		next
		
		cont0.grd1.rowcount = g_nNextCount

		if  DATAMANAGER.IsMoreNextData( "obacb_balc_030r" ) == True then 
			DATAMANAGER.RequestNextData( "obacb_balc_030r" )
		else
			lblVisible()
		end if
	

	elseif	szTranID	=	"obsim_idmn_018r"	then				'종목집투기본정보조회	
		g_szHGDTYn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock5", "HGDT_PROD_YN", 0)	'고난도상품여부
		g_szFITYn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock5", "FIT_PROD_YN", 0)	'적정성상품여부

	
	elseif	szTranID	=	"obcsb_acif_798r"	then			'투자성향등급조회
'		g_szInvType = DATAMANAGER.GetDataValue(0, "obcsb_acif_798r" , "OutBlock1" , "KYC_INVT_INCL_GRAD_CODE" , 0)	'KYC투자성향등급코드
		g_szRcmdClsCode = DATAMANAGER.GetDataValue(0, "obcsb_acif_798r" , "OutBlock1" , "KYC_INVT_RCMD_CLS_CODE" , 0) 'KYC투자권유구분코드
		'g_szModDate = DATAMANAGER.GetDataValue(0, "obcsb_acif_798r" , "OutBlock1" , "MOD_DATE" , 0) '변경일자
		g_szMtrtDate = DATAMANAGER.GetDataValue(0, "obcsb_acif_798r" , "OutBlock1" , "KYC_VALD_PRD_MTRT_DATE" , 0) '만기일자

		if g_KYC_SPCL_INVR_YN<>"Y" AND (g_szMtrtDate = "" or g_szMtrtDate = Null) then
	
			Dim szAlertData, szTitle
			szTitle = "고객투자성향등급 안내"
			g_ErrMsgText = "고객님의 투자성향 정보가 등록되지 않아\n해당 상품 가입이 불가합니다.\n투자성향 등록 후 진행해 주세요."
			szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."투자성향 등록"
			
			Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
		
		elseif g_KYC_SPCL_INVR_YN<>"Y" AND ( int(g_szMtrtDate) < int(Form.GetSharedData( "&HOST_DATE", false))) then
		
			Dim szAlertData, szTitle
			szTitle = "고객투자성향등급 안내"
			g_ErrMsgText = "고객님의 투자성향 유효기간이 경과되어\n해당 상품 가입이 불가합니다.\n투자성향 등록 후 진행해 주세요."
			szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."투자성향 등록"
			
			Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
			
		elseif g_KYC_SPCL_INVR_YN<>"Y" AND ((g_szRcmdClsCode = "2" or g_szRcmdClsCode ="4")  and (g_szHGDTYn = "Y" or g_szFITYn = "Y")) then
			'적정성대상상품인 경우에만 띄움.
		
			Dim szAlertData, szTitle
			szTitle = "고객투자성향등급 안내"
			g_ErrMsgText = "고객님의 투자정보가 확인되지 않아\n해당 금융상품을 가입할 수 없습니다.\n고객님의 성향에 적합한 금융상품 투자를\n위하여 투자성향 등록 후 진행해 주세요."
			szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."투자성향 등록"
			
			Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
			
		else	

			'정상이면, 투자성향 및 위험등급 확인 화면 오픈!
			Dim szSendData
			szSendData = Form.GetSharedData("ADD_FUND_KYC_SPCL_INVR_YN") & "★" & Form.GetSharedData("ADD_FUND_ACCOUNT_NO") & "★" & g_szShortCd & "★" & g_szStndCd & "★" & g_szRmndSrno & "★" & "ADD"					
			Form.OpenPopup("mbfnp51000_p8", szSendData, sPosInfo)
			
		end if
				
		
	elseIf szTranID = "obsap_acif_999a" Then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
	
'		'금융소비자확인팝업에서 723a 호출할때 필요!
'		Form.SetSharedData( "FNPR_JOIN_SRNO", g_szFnprJoinSrno )
'		Form.SetSharedData( "SPCL_CNFR_ACNO", cmbAccount.total )	
'
'		'금융소비자유형 확인
'		Form.OpenPopup("mbonl81010_p20" , "" , "")
		
		DATAMANAGER.RequestTranData("obsai_deal_700r") '매매처리 사전체크
	'---------------------------------------
	'매매처리 사전체크
	'---------------------------------------
	elseif szTranID = "obsai_deal_700r" then  
		szAbleYN	 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_ABLE_YN", 		0)  	'처리가능여부
		szErrCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ERR_CODE", 			0)	'계좌번호
		szErrMsg	 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ERR_MSG", 			0)	'계좌일련번호
		
		if szAbleYN == "Y" then
			if g_SellBuy == 1 then		
				' 매도
				Form.OpenPopup("mbfnp51012", g_szSendData, "")
				
			else
				' 매수
				'금융소비자확인팝업에서 723a 호출할때 필요!
				Form.SetSharedData( "FNPR_JOIN_SRNO", g_szFnprJoinSrno )
				Form.SetSharedData( "SPCL_CNFR_ACNO", cmbAccount.total )	
		
				'금융소비자유형 확인
				Form.OpenPopup("mbonl81010_p20" , "" , "")
			end if
			
		else
			Form.ShowAlert("알림", szErrMsg)
					
		end if
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	g_nNextCount = 0
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	g_szAlertTitle = "알림"
	if szTranID = "obsai_deal_700r" then
	
		if	len(trim(szSubMsg))	>	0	then
			Form.ShowAlert(g_szAlertTitle, szErrMsg & "\n(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szAlertTitle, szErrMsg )
		end	if
	else
		if	len(trim(szSubMsg))	>	0	then
			Form.ShowAlert(g_szAlertTitle, szErrMsg & "\n(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szAlertTitle, szErrMsg )
		end	if
	end if
End Sub

'============================================================================
Function lblVisible()
	if CInt(cont0.grd1.rowcount) = 0 then
		cont0.lblNone.visible = true
	else
		cont0.lblNone.visible = false
		Form.SetTimerEvent2("1", 1, 0.01)		'20230118 HSZ : 계약번호 폰트굵기 적용
	end if
End Function 

'============================================================================
Sub cont0_grd1_OnClickUp(lRow, szCellID)
	Dim szSendData
	Dim szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp14

	'종목명, 평가금액, 매입금액, 평가손익, 수익률, 잔고구분, 체결잔고, 대출금, 대출일, 만기일, 종목코드, 잔고일련번호
	szTemp1 = cont0.grd1.GetCellData("bd_cell2", lRow)
	szTemp2 = cont0.grd1.GetCellData("bd_cell5", lRow)
	szTemp3 = cont0.grd1.GetCellData("bd_cell4", lRow)
	szTemp4 = cont0.grd1.GetCellData("bd_cell6", lRow)
	szTemp5 = cont0.grd1.GetCellData("bd_cell7", lRow)
	szTemp6 = cont0.grd1.GetCellData("bd_gubun", lRow)		'잔고구분 (추가필요)
	szTemp7 = cont0.grd1.GetCellData("bd_cell3", lRow)
	szTemp8 = cont0.grd1.GetCellData("bd_loan", lRow)
	szTemp9 = ""											'대출일 (데이터 확인 필요)
	szTemp10 = cont0.grd1.GetCellData("bd_cell10", lRow)
	g_szShortCd = cont0.grd1.GetCellData("bd_cell11", lRow)
	g_szRmndSrno = cont0.grd1.GetCellData("bd_cell1", lRow)		'잔고일련번호
	g_szStndCd = cont0.grd1.GetCellData("bd_cell12", lRow)		'표준코드
	szTemp14 = cont0.grd1.GetCellData("bd_cell13", lRow)		'저축유형코드

	'화면 연동시, 선택한 계좌로 세팅
	szAccString = cont0.grd1.GetCellData("bd_acc", lRow)
	szIdx = cmbAccount.GetIndexByAccountinfo(szAccString)
	cmbAccount.currentindex = szIdx

	Form.SetSharedData("ADD_FUND_KYC_SPCL_INVR_YN" , g_KYC_SPCL_INVR_YN)	'추가매수에서 사용
	Form.SetSharedData("ADD_FUND_ACCOUNT_NO", cmbAccount.total)			'추가매수에서 사용
	Form.SetSharedData("ADD_FUND_ACCOUNT_SEQ", cmbAccount.sequence)		'추가매수에서 사용
	
	Form.SetSharedData("ADD_FUND_SAVETYPE" , szTemp14)			'추가매수위함
	Form.SetSharedData("ADD_FUND_RMNDNO" , g_szRmndSrno)			'추가매수위함
	
	Form.SetSharedData("FNDNAME_51010" , szTemp1)			'목표시장비교팝업에서 사용!
	
	
	if szCellID = "bd_Info" then
		'펀드정보
		Dim szSendData
		szSendData = szTemp1 & "☆" & szTemp2 & "☆" & szTemp3 & "☆" & szTemp4 & "☆" & szTemp5 & "☆" & szTemp6 & "☆" & szTemp7 & "☆" & szTemp8 & "☆" & szTemp9 & "☆" & szTemp10 & "☆" & g_szShortCd & "☆" & g_szRmndSrno & "☆" & g_szStndCd & "☆" & szTemp14
		Form.OpenPopupAnimation("mbact71052_pf", szSendData, "", "2")

	elseif szCellID = "bd_Add" then			
		'20230828 아이디 연결여부 추가
		if g_szLinkedYn == "N" then
			Form.MsgBox("안내", "ID에 계좌가 연결되어 있지 않습니다.\nID계좌연결 후 진행해주세요.", "NO_ID_LINKED", 7, "ID계좌연결", "취소")
			exit sub
		end if
		
		g_SellBuy = 2  '매수설정
		
		DATAMANAGER.RequestTranData("obsim_idmn_018r")
		DATAMANAGER.RequestTranData("obsap_acif_999a") '금융상품 일련번호 GET 
		'DATAMANAGER.RequestTranData("obsai_deal_700r") '매매처리 사전체크 -> 23.11.08 sync문제로 999a complete 이후 호출로 이동
		
	elseif szCellID = "bd_Sell" then
		'20230828 아이디 연결여부 추가
		if g_szLinkedYn == "N" then
			Form.MsgBox("안내", "ID에 계좌가 연결되어 있지 않습니다.\nID계좌연결 후 진행해주세요.", "NO_ID_LINKED", 7, "ID계좌연결", "취소")
			exit sub
		end if
		
		g_SellBuy = 1 '매도설정
		
		'매도	'잔고일련번호★축약코드★종목코드(표준코드)★저축유형코드
		g_szSendData = g_szRmndSrno & "★" & g_szShortCd & "★" & g_szStndCd & "★" & szTemp14
		
		DATAMANAGER.RequestTranData("obsai_deal_700r") '매매처리 사전체크		
		
'		Form.OpenPopup("mbfnp51012", g_szSendData, "")

	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'20230828 아이디 연결여부 추가
	if sKeyName == "NO_ID_LINKED" and sRet == "ok" then
		Form.OpenScreen("85000", "")
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	'20230118 HSZ START : 계약번호 폰트굵기 적용
	If trim(sTimerID) = "1" Or sTimerID == 1 Then 
		Form.SetTimerEvent2(sTimerID, 0, 0.01)
		for i = 0 to CDbl(cont0.grd1.rowcount)
			cont0.grd1.SetPropGridCell("fontstyle", "bd_cell0" , i, true)	
		next
	end if
	'20230118 HSZ END
End Sub

'============================================================================
Sub cont0_imgTooltip_OnClick()
	szToolTipText = "예금자보호에 관한 사항\n\n이 금융상품은 예금자보호법에 따라 보호되지 않습니다. 단, 증권매수 미사용 현금 잔액은 예금자보호법에 따라 원금과 소정의 이자를 합하여 1인당 " & Chr(34) &"5천만원까지"&Chr(34)&" (본 금융회사의 여타 보호상품과 합산) 보호됩니다."
	
	cont0.imgTooltip.openToolTip(szToolTipText, 330, 150, 1)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if	sKeyName = 	"KYCCHK_RETURN"	then
		if	sRet	=	"Y"	then	'예	
'			contInput.btnBuy.enable = true

		else	'아니오
'			contInput.btnBuy.enable = false
			Exit Sub
			
		end if
		
	elseIf sKeyName == "errMsgBox"  Then 
		if sRet = "Right" then				
			'투자성향재진단 화면 연결
			Form.OpenFramePopup("mbonl81010" , "" , "")
		end if	
				
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then	
			'추가매수 : 투자성향 여부 체크
			DATAMANAGER.SetDataValue(0, "obcsb_acif_798r", "InBlock1", "ELFN_ID", 0 , g_szID)
			DATAMANAGER.RequestTranData("obcsb_acif_798r")
			
		elseif sRet == "CANCEL_mbonl81010_p20" then
			
		end if
		
	end if
End Sub

