'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "BTN_CHANGE_GROUP" then	
		If sRet == "ok" Then
			DATAMANAGER.RequestTranData("obtrc_acnt_001a") '국내CFD 일반 계좌 대용수수료 부과 동의 처리
		End If
	end if
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obtrc_acnt_001r" trcode="obtrc_acnt_001r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtrc_acnt_001a" trcode="obtrc_acnt_001a" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obtrc_acnt_001r" title="국내CFD_대용수수료 부과동의 조" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="170" _ulen="126" >

ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
ACNT_PWD^계좌비밀번호^68^0^0^0^0^0^0
IQRY_CLS_CODE^조회구분코드^1^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="304" _ulen="232" >

CFD_MARG_GRAD_CODE^CFD증거금등급코드^1^0^0^0^0^0^0
