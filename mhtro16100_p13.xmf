Dim gGubun,gAcno,gAsno,gCode,gVndrCode,gCashCredit,gPrice,gQty,gDecimal,gCurrency
gGubun = ""
gAcno = ""
gAsno = "" 
gCode = ""
gVndrCode = ""
gCashCredit = ""
gPrice = ""
gQty = ""
gDecimal = ""
gCurrency = ""

Dim gHabsan,gLoanType,gLoanDate,gLoanSrno,gRepayAll
gHabsan = ""
gLoanType = ""
gLoanDate = ""
gLoanSrno = ""
gRepayAll = ""

Dim gMask
gMask = ""

Dim gOsType

Dim gbLargeFont
gbLargeFont = false

'============================================================================
