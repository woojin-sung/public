	LabelOrdPrcData.paddinginfo = "0,0,0,0"
	
	'---------------------------------------------------
	' 현금(정산금액 영역)
	'---------------------------------------------------
	contCash.LabelCashPrePrcTitle.paddinginfo = "0,0,0,0"
	contCash.LabelCashOrdPrcTitle.paddinginfo = "0,0,0,0"
	contCash.LabelCashFeeTitle.paddinginfo = "0,0,0,0"
	contCash.LabelCashTaxTitle.paddinginfo = "0,0,0,0"
	contCash.LabelCashPreOrdPrcTitle.paddinginfo = "0,0,0,0"
	contCash.LabelCashExchangeRatetitle.paddinginfo = "0,0,0,0"
	contCash.LabelCashWonTitle.paddinginfo = "0,0,0,0"
	
	contCash.LabelCashOrdPrcData.paddinginfo = "0,0,0,0"
	contCash.LabelCashFeeData.paddinginfo = "0,0,0,0"
	contCash.LabelCashTaxData.paddinginfo = "0,0,0,0"
	contCash.LabelCashPreOrdPrcData.paddinginfo = "0,0,0,0"
	contCash.LabelCashExchangeRateData.paddinginfo = "0,0,0,0"
	contCash.LabelCashWonData.paddinginfo = "0,0,0,0"
	
	'---------------------------------------------------
	' 대출(정산금액 영역)
	'---------------------------------------------------
	contCredit.LabelCreditPrePrcTitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditOrdPrcTitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditFeeTitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditTaxTitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditRepayTitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditIntrTitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditPreOrdPrcTitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditExchangeRatetitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditWonTitle.paddinginfo = "0,0,0,0"
	
	contCredit.LabelCreditOrdPrcData.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditFeeData.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditTaxData.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditRepayData.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditIntrData.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditPreOrdPrcData.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditExchangeRateData.paddinginfo = "0,0,0,0"
