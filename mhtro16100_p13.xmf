End Sub

'============================================================================
Sub Form_OnFormInit()

	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		gbLargeFont = true
	end if	


	'매수/매도구분값★종합계좌★계좌일련번호★종목코드★거래소코드★현금/대출구분값★입력가격★입력수량★소수점자리수★통화
	'★일반/신용합산여부★대출상세유형코드★대출일자★대출일련번호★전액상환여부
	szLinkData = Form.GetOpenLinkData()
	'Form.ShowAlert("szLinkData", szLinkData)
	
	arrData = Split(szLinkData,"★")
	
	if #arrData > 9 then
		
		gGubun 		= arrData(0) '매수(2)/매도(1)
		gAcno 		= arrData(1)
		gAsno 		= arrData(2)
		gCode 		= arrData(3)
		gVndrCode 	= arrData(4)
		gCashCredit 	= arrData(5) '현금(0)/대출(1)
		gPrice 		= arrData(6)
		gQty 		= arrData(7)
		gDecimal 	= arrData(8)
		gCurrency 	= arrData(9)
		gHabsan		= arrData(10) '일반(1)/신용합산(2)
		
		'대출일때 대출관련 데이터 GET
		if gCashCredit == "1" then
			gLoanType 	= arrData(11)
			gLoanDate 	= arrData(12)
			gLoanSrno 	= arrData(13)
			gRepayAll 	= arrData(14)
		end if
	
	end if
	
	SetContType(gCashCredit)
	SetOrderPrice(gPrice,gQty,gDecimal,gCurrency)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obtro_oder_263r" then
			
		ordPrcData 		= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "DEAL_CAMT" 		, 0)
		ordFeeData 		= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "ODER_CFEE" 		, 0)
		ordTaxData 		= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "RCGN_CTAX" 		, 0)
		
		ordRepayData		= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "RDMP_AMT" 		, 0)
		ordIntrData		= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "RDMP_INT" 		, 0)
		
		ordPrePrcData 	= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "EXCL_CAMT" 		, 0)
		ordExchangeData  	= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "DEAL_STND_EXRT" 	, 0)
		ordWonData 		= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "WNCR_EXCL_AMT" 	, 0)
		
		'==========================================================
		' 현금
		'==========================================================
		if gCashCredit == "0" then
		
			'----------------------------------------------------------
			' 주문금액
			'----------------------------------------------------------
			if ordPrcData <> "" then
				contCash.LabelCashOrdPrcData.mask = gMask
				contCash.LabelCashOrdPrcData.caption = ordPrcData
			else
				contCash.LabelCashOrdPrcData.caption = "-"
			end if
			
			'----------------------------------------------------------
			' 수수료
			'----------------------------------------------------------
			contCash.LabelCashFeeData.mask = gMask
			contCash.LabelCashFeeData.caption = ordFeeData
			
			'----------------------------------------------------------
			' 세금
			'----------------------------------------------------------
			contCash.LabelCashTaxData.mask = gMask
			contCash.LabelCashTaxData.caption = ordTaxData
			
			'----------------------------------------------------------
			' 정산금액(예상)
			'----------------------------------------------------------
			if ordPrePrcData <> "" then
				contCash.LabelCashPreOrdPrcData.mask = gMask
				contCash.LabelCashPreOrdPrcData.caption = ordPrePrcData
			else
				contCash.LabelCashPreOrdPrcData.caption = "-"
			end if
			
			'----------------------------------------------------------
			' 환율
			'----------------------------------------------------------
			if gCurrency == "JPY" then
				LabelExchangeRateMaskData = "0,1,," .."".. ",0,,4,1,1,0,0"
			else
				LabelExchangeRateMaskData = "0,1,," .."".. ",0,,2,1,1,0,0"	
			end if
			
			contCash.LabelCashExchangeRateData.mask = LabelExchangeRateMaskData
			contCash.LabelCashExchangeRateData.caption = ordExchangeData
			
			'----------------------------------------------------------
			' 원화환산(예상)
			'----------------------------------------------------------
			contCash.LabelCashWonData.caption = ordWonData
		
		'==========================================================
		' 대출
		'==========================================================
		elseif gCashCredit == "1" then
			
			'----------------------------------------------------------
			' 주문금액
			'----------------------------------------------------------
			if ordPrcData <> "" then
				contCredit.LabelCreditOrdPrcData.mask = gMask
				contCredit.LabelCreditOrdPrcData.caption = ordPrcData
			else
				contCredit.LabelCreditOrdPrcData.caption = "-"
			end if
			
			'----------------------------------------------------------
			' 수수료
			'----------------------------------------------------------
			contCredit.LabelCreditFeeData.mask = gMask
			contCredit.LabelCreditFeeData.caption = ordFeeData
			
			'----------------------------------------------------------
			' 세금
			'----------------------------------------------------------
			contCredit.LabelCreditTaxData.mask = gMask
			contCredit.LabelCreditTaxData.caption = ordTaxData
			
			'----------------------------------------------------------
			' 상환금액
			'----------------------------------------------------------
			'contCredit.LabelCreditRepayData.mask = gMask
			contCredit.LabelCreditRepayData.caption = ordRepayData
			
			'----------------------------------------------------------
			' 이자
			'----------------------------------------------------------
			'contCredit.LabelCreditIntrData.mask = gMask
			contCredit.LabelCreditIntrData.caption = ordIntrData
			
			
			'----------------------------------------------------------
			' 정산금액(예상)
			'----------------------------------------------------------
			if ordPrePrcData <> "" then
				contCredit.LabelCreditPreOrdPrcData.mask = gMask
				contCredit.LabelCreditPreOrdPrcData.caption = ordPrePrcData
			else
				contCredit.LabelCreditPreOrdPrcData.caption = "-"
			end if
			
			'----------------------------------------------------------
			' 환율
			'----------------------------------------------------------
			if gCurrency == "JPY" then
				LabelExchangeRateMaskData = "0,1,," .."".. ",0,,4,1,1,0,0"
			else
				LabelExchangeRateMaskData = "0,1,," .."".. ",0,,2,1,1,0,0"	
			end if
			
			contCredit.LabelCreditExchangeRateData.mask = LabelExchangeRateMaskData
			contCredit.LabelCreditExchangeRateData.caption = ordExchangeData
			
			'----------------------------------------------------------
			' 원화환산(예상)
			'----------------------------------------------------------
			contCredit.LabelCreditWonData.caption = ordWonData
		
		
		end if
		
	end if
	
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Function RequestData()

	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "ACNO" 				, 0 , gAcno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "ASNO" 				, 0 , gAsno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "OVRS_STCK_SYMB_ISCD" 	, 0 , gCode)
	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "OVRS_EXCH_VNDR_IDNO" 	, 0 , gVndrCode)
	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "SELN_BYOV_CLCD" 		, 0 , gGubun)
	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "ODQT" 				, 0 , gQty)
	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "OVRS_STCK_ODER_PRC" 	, 0 , gPrice)
	
	'대출일때
	if gCashCredit == "1" then
		DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "LOAN_DTL_TYPE_CODE" 	, 0 , gLoanType)
		DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "LOAN_DATE" 			, 0 , gLoanDate)
		DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "LOAN_SRNO" 			, 0 , gLoanSrno)
	end if
	
	'매도일때
	if gGubun == "1" then
		DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "RDMP_CLS_CODE" 		, 0 , gRepayAll)
	end if
	
	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "IQRY_CLS_CODE" 		, 0 , gHabsan)
	DATAMANAGER.RequestTranData("obtro_oder_263r")

End Function
'============================================================================
Function SetContType(sType)
	
	if sType == "1" then
		
		contCash.visible = false
		
		contCredit.left = 0
		contCredit.visible = true
		
		imgMain.top = 160
		imgMain.height = 489
		
		LabelTitle0.top = 180
		imgOrdPrcBg.top = 215
		
		LabelPrcTitle.top = 224
		LabelPrcData.top = 224
		
		LabelQtyTitle.top = 245
		LabelQtyData.top = 245
		
		LabelOrdPrcTitle.top = 267
		LabelOrdPrcData.top = 267
		
		if gOsType == "1" then
			imgInfo0.top = 184
			imgInfo1.top = 314
		else
			imgInfo0.top = 182
			imgInfo1.top = 312
		end if
		
	end if
	
	if gbLargeFont then
		imgInfo0.left = 90
		imgInfo1.left = 160
	end if
	

End Function
'============================================================================
Function SetOrderPrice(sPrice,sQty,sDecimal,sCurrency)
	
	Dim sMask
	sMask = ""
	
	'-----------------------------------------------------------------------
	' 소수점 자리수 세팅 / 통화기호 세팅
	'-----------------------------------------------------------------------
	if sCurrency <> "" and sDecimal <> "" then
		sMask = "0,0,,".. " " .. sCurrency .. ",0,,"..sDecimal..",1,1,2,0"
	else
		sMask = "0,0,,,0,,".."4"..",1,1,2,0"
	end if
	
	gMask = sMask
	
	'-----------------------------------------------------------------------
	' 주문금액 세팅
	'-----------------------------------------------------------------------
	if sPrice == "" then
		LabelPrcData.caption = "- "  .. sCurrency
	else
		LabelPrcData.mask = sMask
		LabelPrcData.caption = sPrice
	end if
	
	if sQty == "" then
		LabelQtyData.caption = "-"
	else
		LabelQtyData.caption = FormatNumber(sQty,0)
	end if
	
	if sPrice <> "" and sQty <> "" then
		nOrdPrice = Cdbl(sPrice) * Cint(sQty)
		LabelOrdPrcData.mask = sMask
		LabelOrdPrcData.caption = nOrdPrice
	else
		LabelOrdPrcData.caption = "- " .. sCurrency
	end if
	
	'-----------------------------------------------------------------------
	' 정산금액 미리보기 
	'-----------------------------------------------------------------------
	'contCash.LabelCashOrdPrcData.mask = sMask
	'contCash.LabelCashFeeData.mask = sMask
	'contCash.LabelCashPreOrdPrcData.mask = sMask
	
	
	'-----------------------------------------------------------------------
	' 정산금액 조회 서비스 호출
	'-----------------------------------------------------------------------
	if sPrice <> "" and sQty <> "" then
		RequestData()
	end if

End Function

'============================================================================
' 주문금액 툴팁
'============================================================================
Sub imgInfo0_OnClick()
	
	if gbLargeFont then
		sText = " '단가, 수량' 을 모두 입력한 경우만 조회되며,\n주문화면에서는 제비용(수수료/세금)이 제외되어 조회돼요"
		imgInfo0.openToolTip(sText, 345, 90, 2)
	else
		sText = " '단가, 수량' 을 모두 입력한 경우만 조회되며,\n주문화면에서는 제비용(수수료/세금)이 제외되어 조회돼요"
		imgInfo0.openToolTip(sText, 320, 90, 2)
	end if
	
End Sub

'============================================================================
' 정산금액 툴팁
'============================================================================
Sub imgInfo1_OnClick()
	
	if gbLargeFont then
		sText = "종목별 합산되어 정산되므로, 최종 정산금액은 현재 조회되는 금액과 상이 할 수 있어요."
		imgInfo1.openToolTip(sText, 340, 75, 0)
	else
		sText = "종목별 합산되어 정산되므로, 최종 정산금액은 현재 조회되는 금액과 상이 할 수 있어요."
		imgInfo1.openToolTip(sText, 320, 70, 0)
	end if
	
End Sub

