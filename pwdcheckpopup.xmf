--===========================================================================
--===========================================================================
Dim m_sEditIndex
Dim m_bShowSwitch
Dim m_bErrorCheck
Dim m_bCloseForm
Dim m_bOpenPopup
Dim g_szPwd
Dim g_szPwdLen
Dim g_szAccount
g_szAccount = ""

'============================================================================
'초기화 함수
'============================================================================
Function Func_Clear_Pwd()
	g_szPwd = ""
	g_szPwdLen = ""
	Edit0.clear = true
	m_sEditIndex = 0
	
	PwdFail0.left = 126
	PwdFail1.left = 162
	PwdFail2.left = 195
	PwdFail3.left = 228
	
	PwdFail0.imgpath = "pwd_gray"
	PwdFail1.imgpath = "pwd_gray"
	PwdFail2.imgpath = "pwd_gray"
	PwdFail3.imgpath = "pwd_gray"
	
	PwdFail4.visible = false
	PwdFail5.visible = false
	PwdFail6.visible = false
	PwdFail7.visible = false
End Function

'============================================================================
Sub Form_OnFormInit()
	'iOS 에디트컨트롤 설정
	g_DeviceOS 	= Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	'20220714 HSZ START : 버튼 스위치 적용
	appVer = Form.GetSharedData("&APP_VERSION", false )
	appVer = replace(appVer,".","")
	'20220714 HSZ END
	
'	if g_DeviceOS == "2" then
'		Edit0.SetApplyLabel("숫자 6자리 입력", 0 , 76 , "left" , true)
'	end if
	
	'20220531 아이티젠 김성수 START
	'특정 화면에서 사용 시 저장 토글 안보이게 설정
	dim szScreenNo
	szScreenNo = Form.GetSharedData("&SCREEN_NO", false )
	
	szData = Form.GetOpenLinkData()
	arrData = Split(szData, "☆")
	
	if UBOUND(arrData) == 0 then
		g_szAccount = arrData(0)
		Button0.visible = true
		szVisible = true
		
	elseif UBOUND(arrData) == 1 then
		g_szAccount = arrData(0)
		
		if arrData(1) == "1" then
			Button0.visible = true
			szVisible = true
		else
			Button0.visible = false
			szVisible = false
		end if 
	else
		Form.CloseForm()
	end if	
	
	if szScreenNo == "16093" or szScreenNo == "87052" or szScreenNo == "16094"  or szScreenNo == "16404" then
		Button0.visible = false
		szVisible = false
	end if

	'20220714 HSZ START : 버튼 스위치 적용
	if szVisible = true then
		if Cint(appVer) > 2518 or Cint(appVer) > 223 then 'iOS 앱버전 2.5.18 '안드로이드 앱버전 2.2.3
			Button0.setApplySwitch("OFF", "ON", "294", "200", "270", "249") 'CI색상
	'		Button0.setApplySwitch("OFF", "ON", "269", "261", "286", "289") '공통남색
		else
			Button0.setApplySwitch("OFF", "ON")
		end if
	end if
'	20220714 HSZ END
	'20220531 아이티젠 김성수 END
	
	m_sEditIndex = 0 
	
	'계좌비밀번호 저장기능 설정적용
	m_bShowSwitch 	= true	'스위치버튼 초기설정 
	Button0.switchindex = Form.GetEnvData("order.save_orderpwd")
	m_bShowSwitch 	= false
	
	m_bErrorCheck 	= false	'
	m_bCloseForm 		= true	'비밀번호 검증 완료 시, 팝업종료 여부 
	m_bOpenPopup 		= false	'자동저장기능 안내팝업 여부
	
	'0.5초 후 보안키패드 띄움
	Form.SetTimerEvent2(1, 1, 0.5)             
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(sTimerID, 0, 0.5)

	'Form_OnFormInit()
	if Cint(sTimerID) = 1 then
		
		if g_szAccount = "" then
			Form.MsgBox("알림", "계좌번호가 입력되지 않았습니다.", "pwdcheck", 0)
		else
			nIdx = acnt.GetIndexByAccountInfo(g_szAccount)
			acnt.currentindex = nIdx
			Edit0.setShowKeypad(True)
		end if
	end if
End Sub

'============================================================================
Sub Edit0_OnEditComplete()
	if m_bCloseForm = true then
		g_szPwd = Edit0.caption
		g_szPwdLen = Edit0.pwdlen
		Form.CloseForm()
	else
		m_bCloseForm = true
	end if
End Sub

'============================================================================
Sub Edit0_OnEditError()
	'비밀번호 검증 오류 발생 시, 자동저장기능 안내팝업 뜬경우 후처리 비활성화
	if m_bOpenPopup = false then
		Func_Clear_Pwd()
		
		m_bErrorCheck = true
		Edit0.setShowKeypad(True)
		
		PwdFail0.imgpath 	= "pwd_gray"
		PwdFail1.imgpath 	= "pwd_gray"
		PwdFail2.imgpath 	= "pwd_gray"
		PwdFail3.imgpath 	= "pwd_gray"
		PwdFail4.imgpath 	= "pwd_gray"
		PwdFail5.imgpath 	= "pwd_gray"
		PwdFail6.imgpath 	= "pwd_gray"
		PwdFail7.imgpath 	= "pwd_gray"
	end if
End Sub

'============================================================================
Sub Edit0_OnEditChar(CharCode)
	m_bCloseForm = true
	
	if m_bErrorCheck then
		m_bErrorCheck = false
		Func_Clear_Pwd()
	end if
	
	if CharCode == "0" then
		m_sEditIndex = m_sEditIndex + 1 
		
		if CInt(m_sEditIndex) = 1 then
			PwdFail0.imgpath = "pwd_blue"
		elseif CInt(m_sEditIndex) = 2 then
			PwdFail1.imgpath = "pwd_blue"
		elseif CInt(m_sEditIndex) = 3 then
			PwdFail2.imgpath = "pwd_blue"
		elseif CInt(m_sEditIndex) = 4 then
			PwdFail3.imgpath = "pwd_blue"
		elseif CInt(m_sEditIndex) = 5 then
			PwdFail0.left 	= 110
			PwdFail1.left 	= 146
			PwdFail2.left 	= 179
			PwdFail3.left 	= 212
			
			PwdFail4.visible 	= true
			PwdFail4.imgpath 	= "pwd_blue"
			PwdFail4.left 	= 245
			
			Button1.left 		= 110
			Button1.width		= 155
		elseif CInt(m_sEditIndex) = 6 then
			PwdFail0.left = 94
			PwdFail1.left = 130
			PwdFail2.left = 163
			PwdFail3.left = 199
			PwdFail4.left = 232
			
			PwdFail5.visible = true
			PwdFail5.imgpath = "pwd_blue"
			PwdFail5.left = 265
			
			Button1.left 		= 94
			Button1.width		= 188
		elseif CInt(m_sEditIndex) = 7 then
			PwdFail0.left = 78
			PwdFail1.left = 114
			PwdFail2.left = 147
			PwdFail3.left = 180
			PwdFail4.left = 214
			PwdFail5.left = 246
			
			PwdFail6.visible = true
			PwdFail6.imgpath = "pwd_blue"
			PwdFail6.left = 279
			
			Button1.left 		= 78
			Button1.width		= 221
		
		elseif CInt(m_sEditIndex) = 8 then
			PwdFail0.left = 62
			PwdFail1.left = 98
			PwdFail2.left = 131
			PwdFail3.left = 164
			PwdFail4.left = 197
			PwdFail5.left = 230
			PwdFail6.left = 263
			
			PwdFail7.visible = true
			PwdFail7.imgpath = "pwd_blue"
			PwdFail7.left = 296
			
			Button1.left 		= 62
			Button1.width		= 254
		end if
	elseif CharCode == "1" then
		if CInt(m_sEditIndex) > 0 then 
			m_sEditIndex = m_sEditIndex - 1
		end if
		
		if CInt(m_sEditIndex) = 0 then
			PwdFail0.imgpath = "pwd_gray"
		elseif CInt(m_sEditIndex) = 1 then
			PwdFail1.imgpath = "pwd_gray"
		elseif CInt(m_sEditIndex) = 2 then
			PwdFail2.imgpath = "pwd_gray"
		elseif CInt(m_sEditIndex) = 3 then
			PwdFail3.imgpath = "pwd_gray"
		elseif CInt(m_sEditIndex) = 4 then
			PwdFail0.left = 126
			PwdFail1.left = 162
			PwdFail2.left = 195
			PwdFail3.left = 228
			
			PwdFail4.visible = false
			
			Button1.left 		= 126
			Button1.width		= 122
		elseif CInt(m_sEditIndex) = 5 then
			PwdFail0.left = 110
			PwdFail1.left = 146
			PwdFail2.left = 179
			PwdFail3.left = 212
			PwdFail4.left = 245
			
			PwdFail5.visible = false
			
			Button1.left 		= 110
			Button1.width		= 155
		elseif CInt(m_sEditIndex) = 6 then
			PwdFail0.left = 94
			PwdFail1.left = 130
			PwdFail2.left = 163
			PwdFail3.left = 199
			PwdFail4.left = 232
			PwdFail5.left = 265
			
			PwdFail6.visible = false
			
			Button1.left 		= 94
			Button1.width		= 188
		elseif CInt(m_sEditIndex) = 7 then
			PwdFail0.left = 78
			PwdFail1.left = 114
			PwdFail2.left = 147
			PwdFail3.left = 180
			PwdFail4.left = 213
			PwdFail5.left = 246
			PwdFail6.left = 279
			
			PwdFail7.visible = false
			
			Button1.left 		= 78
			Button1.width		= 221
		end if

	elseif CharCode == "2" then
		If g_DeviceOS == "2" then
			Edit0.setShowKeypad(True)
		End if
	end if
End Sub

'============================================================================
Sub Button1_OnClick()
	Func_Clear_Pwd()
	Edit0.setShowKeypad(True)
	m_bCloseForm = false
End Sub

'============================================================================
Sub Button2_OnClick()
	Func_Clear_Pwd()
	Edit0.setShowKeypad(True)
	m_bCloseForm = false
End Sub

'============================================================================
Sub Button0_OnClick()
	m_bCloseForm = false
	Func_Clear_Pwd()
	if m_bShowSwitch = false then
		strSwitchIndex = Button0.switchindex
	
		if strSwitchIndex = "1" then
			Form.SetEnvData(1, "order.save_orderpwd", "1")
			m_bOpenPopup = true
			Form.OpenPopup("pwdcheckpopup_p1" , "", "")
			Edit0.setShowKeypadNoCheck(False)
		
		elseif strSwitchIndex = "0" then
			Form.SetEnvData(1, "order.save_orderpwd", "0")
			Edit0.setShowKeypad(True)
		end if
	end if 
End Sub

'============================================================================
Sub Button3_OnClick()
	m_bCloseForm = false
	g_szPwd = ""
	g_szPwdLen = ""
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	if g_szPwd = "" or g_szPwd = null then
		Form.SendReturnToParent("CORRECT_PWD" , "")
	else
		Form.SendReturnToParent("CORRECT_PWD" , g_szPwd .."★"..g_szPwdLen)
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	m_bOpenPopup = false
	Edit0.setShowKeypad(True)
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName = "pwdcheck" then
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	'20220622 아이티젠 START:
	'20220622 아이티젠 END:
	PwdFail0.setMaintainingRatio("1")
	PwdFail1.setMaintainingRatio("1")
	PwdFail2.setMaintainingRatio("1")
	PwdFail3.setMaintainingRatio("1")
	PwdFail4.setMaintainingRatio("1")
	PwdFail5.setMaintainingRatio("1")
	PwdFail6.setMaintainingRatio("1")
	PwdFail7.setMaintainingRatio("1")
End Sub

Sub Edit0_OnEditCancel()
	'20220622 아이티젠 START: 안드로이드에서 비번입력후 백버튼 탭시 부모폼으로 비번넘기는 현상 수정
	'20220622 아이티젠 END:
	Func_Clear_Pwd()
End Sub
