'============================================================================
'============================================================================
' 01. 화 면 명 : 
' 02. 화면설명 : 
' 03. 작    성 : 

'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
'============================================================================
Dim g_AryTitle, g_AryDate, g_AryUrl, g_AryszCls
Dim g_szTitle, g_szUrl, g_szDate, g_szCls
Dim g_Init
g_szTitle = ""
g_szUrl = ""
g_szDate = ""
g_szCls = ""

Dim g_szOSType

'============================================================================
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	'OS별 퀵메뉴 색상에 맞추기
	g_szOSType = Form.GetSharedData("&OS_TYPE", false)
	If CInt(g_szOSType) = 2 Then		'iOS
		cont0.lblBack1.bgcolor = "090"
	end if
	
	cont0.grd0.transmode = 1
	cont0.setScrollBarVisible("0")
	
	DATAMANAGER.RequestTranData("ohhts_note_003r")
End Sub
'============================================================================
Sub Form_OnFormInitBefore()
	cont0.Img0.setMaintainingRatio("1")  
	cont0.Img1.setMaintainingRatio("1")  
	cont0.Img2.setMaintainingRatio("1")  
	cont0.Img3.setMaintainingRatio("1")  
	cont0.Img4.setMaintainingRatio("1")  
	cont0.Img5.setMaintainingRatio("1")  
	cont0.Img6.setMaintainingRatio("1")  
	cont0.Img7.setMaintainingRatio("1")  
	
	cont0.Img8.setMaintainingRatio("1")  
	cont0.Img9.setMaintainingRatio("1")  
	cont0.Img10.setMaintainingRatio("1")  
	cont0.Img11.setMaintainingRatio("1")  
	cont0.Img12.setMaintainingRatio("1")  
	cont0.Img13.setMaintainingRatio("1")  
End Sub
'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "ohhts_note_003r" then			'국내
		g_szTitle = ""
		g_szDate	 = ""
		g_szUrl = ""
		g_szCls = ""
		g_AryTitle = ""
		g_AryDate = ""
		g_AryUrl = ""
		g_AryCls = ""
	
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_CLS" , 0 , "99" )			'00(공지사항),01(증거금변경)만 조회
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_CLS_CODE" , 0 , "02" )
		
	elseif szTranID = "ooopc_rprt_006r" then		'해외
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "IQRY_CLS_CODE" , 0 , "1" )		'작성일시 내림차순
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "IQRY_CNT" , 0 , "3" )			'조회건수
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2", "BBS_ID" , 0 , "fstock" )			'해외주식 - 공지사항
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2", "BBS_GRP_ID" , 0 , "bascGrp" )
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2", "BBS_ID" , 1 , "fstock2" )		'해외주식 - 권리사항
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2", "BBS_GRP_ID" , 1 , "bascGrp" )
	end if
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_note_003r" then
		cont0.visible = true
		
		nDataCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		
		cont0.grd0.rowcount = 7
		cont0.scrollenable = "0"
		cont0.grd0.scrollenable = "0"
		cont0.grd0.SetCellMaxLineCount("bd_text",1)
		
		for i = 0 to 2
			szTitle = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_TITL" , i)
			szDate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_REG_DATE" , i)
			szUrl = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_EXTS_URL_ADDR" , i)
			szCls = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_CLS" , i)

			g_szTitle = g_szTitle..szTitle.."|"
			g_szDate	 = g_szDate..szDate.."|"
			g_szUrl = g_szUrl..szUrl.."|"
			g_szCls = g_szCls..szCls.."|"
			
			cont0.grd0.SetCellData("bd_text", i, szTitle)
			cont0.grd0.SetCellData("bd_index", i, i)
		next
		
		DATAMANAGER.RequestTranData("ooopc_rprt_006r")

	elseif szTranID = "ooopc_rprt_006r" then
		nDataCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		for i = 0 to 2
			szTitle = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_CNTT_TITL_NAME" , i)
			szDate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_CNTT_WRTN_YMDH" , i)
			szUrl = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_CNTT_TURN_NO" , i)
			szCls = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_ID" , i)

			g_szTitle = g_szTitle..szTitle.."|"
			g_szDate	 = g_szDate..szDate.."|"
			g_szUrl = g_szUrl..szUrl.."|"
			g_szCls = g_szCls..szCls.."|"
		
		next
		
		g_AryTitle = Split(g_szTitle,"|")
		g_AryDate = Split(g_szDate,"|")
		g_AryUrl = Split(g_szUrl,"|")
		g_AryCls = Split(g_szCls,"|")
		
		cont0.grd0.SetCellData("bd_text", 3, g_AryTitle(3))
		cont0.grd0.SetCellData("bd_index", 3, 3)
		cont0.grd0.SetCellData("bd_text", 4, g_AryTitle(4))
		cont0.grd0.SetCellData("bd_index", 4, 4)
		cont0.grd0.SetCellData("bd_text", 5, g_AryTitle(5))
		cont0.grd0.SetCellData("bd_index", 5, 5)
		cont0.grd0.SetCellData("bd_text", 6, g_AryTitle(0))
		cont0.grd0.SetCellData("bd_index", 6, 0)

		if Trim(g_szTitle) <> "" then
			Form.triggerEvent("#", "NOTICE_SHOW", "")
			cont0.setAutoVerticalScroll(true, 30, 7)
		else
			Form.triggerEvent("#", "NOTICE_HIDE", "")

		end if
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'서비스 오류 시, 숨김처리
	Form.triggerEvent("#", "NOTICE_HIDE", "")
End Sub

'============================================================================
'Sub cont0_grd0_OnClickUp(lRow, szCellID)
Sub grd0_popup(nRow)

	nRow = nRow - 1
		
	szIndex = CInt(cont0.grd0.GetCellData("bd_index", nRow))
	
	if szIndex > -1 then
		szData = g_AryTitle(szIndex).."|"..g_AryDate(szIndex).."|"..g_AryUrl(szIndex).."|"..g_AryCls(szIndex).."|"
	else
		exit sub
	end if
	
	if szIndex > 2 and szIndex < 6 then	'해외주식 공지사항 / 권리사항
		Form.OpenPopup("mhetc90200_p1" , szData , "")
	else								'공지사항 / 증거금변경
		Form.OpenPopup("mhetc90100_p2" , szData , "")
	end if
	
End Sub

'============================================================================
Sub lblClick_OnClick()
	nRow = CInt(cont0.getAutoVerticalScroll())

	if nRow > 6 then
		nRow = 6
	end if
	
	szText = cont0.grd0.GetCellData("bd_text", nRow)
	if trim(szText) = "" then
		Form.triggerEvent("#", "NOTICE_HIDE", "")
	else
		call grd0_popup(nRow)
	end if
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	if g_szOSType = "2" then
		cont0.grd0.SetClear()
		DATAMANAGER.RequestTranData("ohhts_note_003r")
	end if
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if g_szOSType = "1" then
		if Trim(g_szTitle) = "" then
			cont0.grd0.SetClear()
			DATAMANAGER.RequestTranData("ohhts_note_003r")
		end if
	end if
End Sub

