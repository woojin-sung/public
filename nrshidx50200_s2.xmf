<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="50200" scrname="ETF투자가이드_ETF란_특징" version="2" writer="함원규" />
	<FORM_INFO name="Form" ly_vert="0,0,375,1020,1" />
	<CONTROL_INFO>
		<CONTAINER name="contMain" ly_vert="0,0,375,1020,1" scroll_ly_vert="0,0,375,1020,1" >
			<CONTROL_INFO>
				<LABEL name="lblTitle0" fgcolor="334:034034034" fontsize="2" fontstyle="01" caption="ETF는 주식거래의 장점과 펀드의 장점을" paddinginfo="1,0,0,0" ly_vert="20,30,335,25,1" />
				<LABEL name="lblTitle1" fgcolor="334:034034034" fontsize="2" fontstyle="01" caption="모두 가지고 있는 상품입니다." paddinginfo="1,0,0,0" ly_vert="20,55,335,25,1" />
				<IMAGE name="imgBg0" imgpath="input_01_n.9" ly_vert="20,102,335,220,1" />
				<IMAGE name="imgIcon0" autosize="1" imgpath="etf_icon01" ly_vert="162,122,50,50,1" />
				<LABEL name="lblText0" fontsize="2" fontstyle="01" caption="소액으로 분산투자" halign="1" ly_vert="20,179,335,25,1" />
				<LABEL name="lblText1" fgcolor="321:115118124" fontsize="-2" caption="1주만 매수해도 ETF를 구성하는 모든 종목에
투자하는 것과 유사한 효과를 볼 수 있습니다.
소액으로도 시장전체에 투자할 수 있을 뿐만 아니라
모든 종목의 성과를 그대로 누릴 수 있어 분산 투자
효과를 누릴 수 있습니다." halign="1" valign="0" multiline="1" ly_vert="35,211,305,100,1" />
				<IMAGE name="imgBg1" imgpath="input_01_n.9" ly_vert="20,332,335,205,1" />
				<IMAGE name="imgIcon1" autosize="1" imgpath="etf_icon02" ly_vert="162,352,50,50,1" />
				<LABEL name="lblText2" fontsize="2" fontstyle="01" caption="저렴한 비용" halign="1" ly_vert="20,409,335,25,1" />
				<LABEL name="lblText3" fgcolor="321:115118124" fontsize="-2" caption="일반적인 펀드에 비해 운용보수(판매보수 및
수수료)가 없어 저렴하게 투자할 수 있습니다.
또한 매매 시 증권거래세가 부과되지 않아
거래비용을 최소화 할 수 있습니다." halign="1" valign="0" multiline="1" ly_vert="35,441,305,90,1" />
				<IMAGE name="imgBg2" imgpath="input_01_n.9" ly_vert="20,547,335,240,1" />
				<IMAGE name="imgIcon2" autosize="1" imgpath="etf_icon03" ly_vert="162,567,50,50,1" />
				<LABEL name="lblText4" fontsize="2" fontstyle="01" caption="투명한 운용" halign="1" ly_vert="20,624,335,25,1" />
				<LABEL name="lblText5" fgcolor="321:115118124" fontsize="-2" caption="일반펀드는 펀드의 구성내역을 실시간으로 확인할
수 없지만, ETF는 HTS 등 온라인 채널에서
기초지수를 구성하는 포트폴리오 구성내역을
실시간으로 확인 할 수 있습니다. 보유종목과 순자산
가치를 영업일 기준으로 매일 공시하기 때문에
투명한 운용이 가능합니다." halign="1" valign="0" multiline="1" ly_vert="35,656,305,110,1" />
				<IMAGE name="imgBg3" imgpath="input_01_n.9" ly_vert="20,797,335,180,1" />
				<IMAGE name="imgIcon3" autosize="1" imgpath="etf_icon04" ly_vert="162,817,50,50,1" />
				<LABEL name="lblText6" fontsize="2" fontstyle="01" caption="주식처럼 거래" halign="1" ly_vert="20,874,335,25,1" />
				<LABEL name="lblText7" fgcolor="321:115118124" fontsize="-2" caption="ETF는 거래소에 상장되어 일반 주식과 같은
방식으로 매매가 이루어지기 때문에 장중
실시간으로 편리하고 쉽게 매매가 가능합니다." halign="1" valign="0" multiline="1" ly_vert="35,896,305,130,1" />
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="489" _ulen="489" >

'============================================================================
Sub Form_OnFormInitBefore()
	contMain.imgIcon0.setMaintainingRatio("1")
	contMain.imgIcon1.setMaintainingRatio("1")
	contMain.imgIcon2.setMaintainingRatio("1")
	contMain.imgIcon3.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	contMain.lblTitle0.setHighlight(332)
	contMain.lblTitle1.setHighlight(332)
End Sub

	</SCRIPT_INFO>
</ROOT>