'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCust_Num
Dim g_PlainRm
Dim g_szSelectSrno, g_szAcno, g_szAsno
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
Function f_AddGridRegCell()
	cont0.Grid0.AddRow()
	cont0.Grid0.SetCellData("bd_acntinfo", CInt(cont0.Grid0.rowcount)-1, "서비스 신청 후 거래가 가능해요.\r\n거래하실 계좌를 등록해 주세요.")
	cont0.Grid0.SetCellData("bd_btn", CInt(cont0.Grid0.rowcount)-1, "+")
	cont0.Grid0.SetCellFgColor( "bd_btn", CInt(cont0.Grid0.rowcount)-1, "13" )
End Function

'============================================================================
Function f_SetGridCellData()
	dim nRowCnt, szTotal, szSequence
	nRowCnt = CInt(cont0.Grid0.rowcount)
	
	for i=0 to nRowCnt-1
		dim szAcntInfo, szProdCd, szProdText
		cont0.Grid0.SetCellData("bd_btn", i, "해지하기")
		szTotal = cont0.Grid0.GetCellData("bd_total", i)
		szSequence = cont0.Grid0.GetCellData("bd_sequence", i)
		szProdCd = cont0.Grid0.GetCellData("bd_product", i)
		szProdText = Form.GetMetaData("상품코드", szProdCd)
		szAcntInfo = "["&szProdText&"] "&Left(szTotal, 4)&"-"&Right(szTotal, 4)&"-"&szSequence
		cont0.Grid0.SetCellData("bd_acntinfo", i, szAcntInfo)
	next
End Function

'============================================================================
Function f_SetGrdHeight()
	dim nGrd_H, nGrdCell_H
	nGrdCell_H = 100
	nGrd_H = CInt(cont0.Grid0.rowcount) * nGrdCell_H
	cont0.Grid0.height = nGrd_H
End Function

'============================================================================
Function f_SetBtmContTop()
	dim nAcntCnt, nRowCnt
	nAcntCnt = CInt(cmbAccount.accountcount)
	nRowCnt = CInt(cont0.Grid0.rowcount)

'	if nAcntCnt == nRowCnt and nAcntCnt > 0 then
'		cont0.contBtm.visible = false
'	else
'		cont0.contBtm.visible = true
'		cont0.contBtm.top = CInt(cont0.Grid0.height)
'	end if

	'  항상 보이게 수정
	cont0.contBtm.visible = true
	cont0.contBtm.top = CInt(cont0.Grid0.height)
	
End Function


'============================================================================
Sub Form_OnFormInit()
	'암호화 버전
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE )
	cont0.Grid0.setUseCardView(true, 10, "img_bgbox.9.png")
	'고객번호
	dim szCust_Num
	szCust_Num = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
	
	if szCust_Num <> "" and szCust_Num <> null then
		g_szCust_Num = szCust_Num
		DATAMANAGER.RequestTranData( "obpds_srvc_056r" )
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "mbonl87056_p1" or sKeyName == "mbonl87056_p2" then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obpds_srvc_056r" )
		end if
	elseif sKeyName == "CORRECT_PWD" then
		if sRet <> "" and sRet <> null then
			dim szTranID, tData, szPwd
			tData = Split(sRet,"★")
			
			if CInt(tData(1)) > 3 then
				'패스워드 암호화여부
				If g_PlainRm = "1" Then
					szPwd = tData(0)
				Else
					szPwd = Form.GetEncData(tData(0))
				End If
			else
				Exit Sub
			end if
			
			szTranID = "obpds_srvc_183a"
			'고객번호
			dim szCust_Num
			szCust_Num = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"		, 0 , "D")			'처리구분(D해지)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" 			, 0 , szPwd)			'계좌비밀번호
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" 				, 0 , szCust_Num)		'고객번호
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 				, 0 , g_szAcno)		'계좌번호
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 				, 0 , g_szAsno)		'계좌일련번호
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" 				, 0 , "079")			'서비스 코드
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_SRNO"			, 0 , g_szSelectSrno)	'서비스 일련번호
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_MANG_UNIT_CODE"	, 0 , "03")			'서비스 관리 단위코드(03상품)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID"				, 0 , Form.GetSharedData("&USER_ID" , false))	'HTS ID
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE" 		, 0 , "4")			'접촉 구분코드(4온라인)
			
			DATAMANAGER.RequestTranData( szTranID )
		else
			g_szSelectSrno = ""
			g_szAcno = ""
			g_szAsno = ""
		end if
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'상단 유의사항 아이콘 클릭 이벤트
	if sEventName == "INFO_CLICK" then 
		Form.OpenFramePopup("mbonl87056_p9", "", "")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obpds_srvc_056r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "MANG_BRCD" , 0 , "%"	)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_PRD_CLCD" , 0 , "02"	)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STA_DATE" , 0 , "00010101"	)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FIN_DATE" , 0 , Form.GetSharedData("&HOST_DATE", false ))	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "079"	)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , g_szCust_Num)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STPL_STAT_CLS_CODE" , 0 , "01")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , "0")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , "%")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "EXLS_YN" , 0 , "N")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obpds_srvc_056r" then
		if CInt(cont0.Grid0.rowcount) > 0 then
			f_SetGridCellData()
		end if
		f_SetGrdHeight()
		f_SetBtmContTop()
		cont0.SetScrollAutoSize()
		g_szSelectSrno = ""
		g_szAcno = ""
		g_szAsno = ""
	elseif szTranID == "obpds_srvc_183a" then
		DATAMANAGER.RequestTranData( "obpds_srvc_056r" )
		Form.ShowAlert("안내", "해외주식 소수점 거래서비스가 해지되었습니다.")
		g_szSelectSrno = ""
		g_szAcno = ""
		g_szAsno = ""
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubMsg <> "" and szSubMsg <> null then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")" )
	else
		Form.ShowAlert("알림", szErrMsg )
	end if 
End Sub


'============================================================================
Sub cont0_Grid0_OnClickUp(lRow, szCellID)
	if szCellID == "bd_btn" then '해지하기 버튼
		g_szSelectSrno = cont0.Grid0.GetCellData( "bd_srno", lRow)
		if g_szSelectSrno <> "" and g_szSelectSrno <> null then
			dim szAcntInfo
			g_szAcno = cont0.Grid0.GetCellData( "bd_total", lRow)
			g_szAsno = cont0.Grid0.GetCellData( "bd_sequence", lRow)
			
			szAcntInfo = g_szAcno & g_szAsno
			'계좌 비밀번호 팝업 호출
			Form.openPopupAnimation("pwdcheckpopup", szAcntInfo, "", "2")
		end if
	end if
End Sub

'============================================================================
Sub cont0_contBtm_btnAdd_OnClick()
	Form.OpenPopup("mbonl87056_p1", "", "")
End Sub













