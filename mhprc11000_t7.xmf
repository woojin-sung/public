'============================================================================
Sub Form_OnFormInitBefore()
	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemName = Form.GetItemCodeInfo( g_szItemCode , "name")
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		'20220124 SWJ START
		'DATAMANAGER.CancelRealData("ohhts_news_real")
		for i = 0 to 18
			DATAMANAGER.CancelRealData("ohhts_news_real")
		next
		'20220124 SWJ END
	
		g_szItemCode = sValue
		'20160502 NOHES : 종목명 변경
		g_szItemName = Form.GetItemCodeInfo( g_szItemCode , "name")
		DATAMANAGER.RequestTranData( "ohhts_news_001r" )
'		DATAMANAGER.RequestRealData( "ohhts_news_real" )
	end	if
End Sub

'============================================================================
Sub Form_OnFormInit()
'	DATAMANAGER.RequestTranData( "ohhts_news_001r" )	
'	DATAMANAGER.RequestRealData( "ohhts_news_real" )
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
'			Form.triggerEvent( "#", "REQUEST_ITEMCODE", "")
			Exit Sub
		End If
		
		g_szItemCode   =  sParam
		
		'20220124 SWJ START
		'DATAMANAGER.CancelRealData("ohhts_news_real")
		for i = 0 to 18
			DATAMANAGER.CancelRealData("ohhts_news_real")
		next
		'20220124 SWJ END		
		
		DATAMANAGER.RequestTranData( "ohhts_news_001r" )
		
	 end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
'	grdNews.SetClear() '20171013 HAMWG : 뉴스 재조회 시, 그리드 클리어	230117 HSZ : NEXT조회 시, 클리어현상 조치
	DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock1", "FID_INPUT_NEWS_ITN_EXCP_CLCD"	, 0 , "Y" )
	
	'20210622 LES START
	'DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock2", "FID_INPUT_ISCD"				, 0 , g_szItemCode )
	DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock2", "FID_NEW_INPUT_ISCD"				, 0 , g_szItemCode )
	'20210622 LES END
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	'DATAMANAGER.SetDataValue( 1 , "ohhts_news_real", "InBlock1", "FIDR_NEWS_OFER_ENTP_CODE" 		, 0 , "*" )
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	Dim szTitle, szDate, szTime, szNewKey, szNewCorpName, szNewsCorpCode
	Dim	szDiv
	
	szDiv 		  = DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEWS_ITN_EXCP_CLCD" , 0 )
	szNewsCorpCode  = DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEWS_OFER_ENTP_CODE" , 0)
	
'    If g_szValue = "Y" And szDiv = "N" Then
    If szDiv = "N" Then
	    Exit Sub
    End If
    
    '이데일리뉴스 제외
    if szNewsCorpCode = "EY" Then
	    Exit Sub
    End If
    
    '20210622 LES START
    'If g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_SHRN_ISCD" , 0 )
	'	AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_SHRN_ISCD2" , 0 ) 
	'	AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_SHRN_ISCD3" , 0 ) 
	'	AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_SHRN_ISCD4" , 0 ) 
	'	AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_SHRN_ISCD5" , 0 ) 
	'	AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_SHRN_ISCD6" , 0 ) 
	'	AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_SHRN_ISCD7" , 0 ) 
	'	AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_SHRN_ISCD8" , 0 ) Then
	 '   Exit Sub
    'End If
    
    If g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD" , 0 )
		AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD2" , 0 ) 
		AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD3" , 0 ) 
		AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD4" , 0 ) 
		AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD5" , 0 ) 
		AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD6" , 0 ) 
		AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD7" , 0 ) 
		AND g_szItemCode <> DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEW_SHRN_ISCD8" , 0 ) Then
	    Exit Sub
    End If
    '20210622 LES END
    
    
    szTitle		= DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEWS_TITL", 0 )
    szDate		= DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_DATE", 0 )
    szTime		= Left( DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_BSOP_HOUR", 0 ), 4)
    szNewKey		= DATAMANAGER.GetDataValue( 1, "ohhts_news_real", "OutBlock1", "FIDR_NEWS_KEY", 0 )
    
    
    If 		szNewsCorpCode == "n0" then szNewCorpName = "시황속보"
    elseif 	szNewsCorpCode == "HK" then szNewCorpName = "한경뉴스"
    elseif 	szNewsCorpCode == "EY" then szNewCorpName = "이데일리뉴스"
    elseif 	szNewsCorpCode == "F0" then szNewCorpName = "공시정보"
    elseif 	szNewsCorpCode == "MT" then szNewCorpName = "머니투데이"
    elseif 	szNewsCorpCode == "SD" then szNewCorpName = "이투데이"
    elseif 	szNewsCorpCode == "IS" then szNewCorpName = "인포스탁"
    elseif 	szNewsCorpCode == "MK" then szNewCorpName = "매경뉴스"
    elseif 	szNewsCorpCode == "FN" then szNewCorpName = "파이낸셜뉴스"
    elseif 	szNewsCorpCode == "YN" then szNewCorpName = "연합뉴스"
    elseif 	szNewsCorpCode == "NP" then szNewCorpName = "뉴스핌"
    elseif 	szNewsCorpCode == "AE" then szNewCorpName = "아시아경제"
    elseif 	szNewsCorpCode == "HE" then szNewCorpName = "헤럴드경제"
    elseif 	szNewsCorpCode == "CD" then szNewCorpName = "CEO스코어데일리"
    '20161226 LES START - 서울경제, 컨슈머타임스 추가
    elseif 	szNewsCorpCode == "SE" then szNewCorpName = "서울경제"
    elseif 	szNewsCorpCode == "CT" then szNewCorpName = "컨슈머타임스"
    '20200909 SWJ START - 팍스넷뉴스 추가
    elseif 	szNewsCorpCode == "PAX" then szNewCorpName = "딜사이트"		'20221227 SWJ START : 팍스넷뉴스 사명변경
    '20240626_01 KBC : 뉴스원추가
    elseif 	szNewsCorpCode == "NSP" then szNewCorpName = "NSP통신"
    end if
    
    grdNews.insertrow = 0
    
    grdNews.SetCellData( "bd_cell0", 0, szTitle 		)	'제목
    grdNews.SetCellData( "bd_cell1", 0, szDate 		)	'일자
    grdNews.SetCellData( "bd_cell3", 0, szTime 		)	'시간
    grdNews.SetCellData( "bd_cell9", 0, szNewCorpName 	)	'뉴스제공업체명
    grdNews.SetCellData( "bd_cell4", 0, szNewKey 		)	'뉴스키
    grdNews.SetCellData( "bd_cell5", 0, szNewsCorpCode )	'뉴스제공업체코드
    
End Sub

'============================================================================
Sub grdNews_OnClickUp(lRow, szCellID)
	Dim szTitle, szDate, szTime, szNewCorpName, szNewKey, szNewsCorpCode, szMsg

	szTitle			= grdNews.GetCellData( "bd_cell0", lRow )	' 제목
	szDate			= grdNews.GetCellData( "bd_cell1", lRow )	' 날짜
	szTime			= grdNews.GetCellData( "bd_cell3", lRow )	' 시간
	szNewCorpName		= grdNews.GetCellData( "bd_cell9", lRow )	' 뉴스제공업체명
	szNewKey			= grdNews.GetCellData( "bd_cell4", lRow )	' 뉴스키
	szNewsCorpCode	= grdNews.GetCellData( "bd_cell5", lRow )	' 뉴스제공업체코드

	szMsg = szTitle & "|" & szDate & "|" & szTime & "|" & szNewCorpName & "|" & szNewKey & "|" & szNewsCorpCode & "|" & g_szItemName

'	Form.OpenFramePopup( "mhprc11000_p6" , szMsg, "" )
	Form.OpenPopup( "mhprc11000_p6" , szMsg, "" )

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)	

	If szTranID = "ohhts_news_001r" Then
		Dim nCnt, szTime
		
		nCnt = DATAMANAGER.GetDataCount( 0, "ohhts_news_001r", "OutBlock1" )
		
		For i = 0 To nCnt - 1
			szTime = DATAMANAGER.GetDataValue( 0, "ohhts_news_001r", "OutBlock1", "FID_CNTG_HOUR" , i )
			
			DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "OutBlock1", "FID_CNTG_HOUR" , i , Left(szTime, 4) )
		Next
	End If
End Sub


