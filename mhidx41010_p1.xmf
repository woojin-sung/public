'20211013 HSZ : HOME(시장종합)설정 편집 중단
Dim g_Flag

'============================================================================
Sub Form_OnFormInit()
	ButtonC.fgcolor = 269
	Image2.imgpath = "alpha128.png"
End Sub
'============================================================================
'취소버튼 클릭시
Sub ButtonC_OnClick()
	g_Flag = ""	
	Form.CloseForm()
End Sub

'============================================================================
'확인버튼 클릭시
Sub ButtonO_OnClick()
	
	g_Flag = "ok"
	
	'SharedData 초기화
'	Form.SetSharedData("BDM_NMETBSWRGB"           , "" )
'	Form.SetSharedData("BDM_FRST_MAPID"           , "" )
	
	Form.CloseForm()
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	 Form.SendReturnToParent("mhidx41010_p1" , g_Flag)
End Sub

