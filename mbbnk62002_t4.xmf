'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szRet	'리턴값
g_szRet	=	"0"

Dim g_URLheader
Dim g_ServerMode

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)
	
	If g_ServerMode == "1" Then	'개발기
		g_URLheader = "http://testhome.imeritz.com/include/resource/comm/ctcn/pdf/"
	Else
		g_URLheader = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/"
	End If
	WebView0.viewtype = 0
	WebView0.urlpath = g_URLheader & "openbanking_withdrawal_agree.html"	
	
	Form.SetScreenName("오픈뱅킹 출금이체 약관")
	
End Sub

'============================================================================
'BtnOK_OnClick
'============================================================================
Sub BtnOK_OnClick()
		g_szRet	=	"1"
		Form.CloseForm()
	
End Sub


'============================================================================
'BtnCancel_OnClick
'============================================================================
Sub BtnCancel_OnClick()
	g_szRet	=	"0"
	Form.CloseForm()
End Sub


'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("MBBNK62002_T4" , g_szRet)
End Sub






	</SCRIPT_INFO>
