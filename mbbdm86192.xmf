	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obpds_srvc_312r" trcode="obpds_srvc_312r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obcsb_oimf_520r" trcode="obcsb_oimf_520r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obpds_srvc_316a" trcode="obpds_srvc_316a" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="ohhts_pauth_004" trcode="ohhts_pauth_004" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obpds_srvc_069r" trcode="obpds_srvc_069r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="ohhts_pauth_004_1" trcode="ohhts_pauth_004" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obcsb_acif_809r" trcode="obcsb_acif_809r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obpds_srvc_312r" title="전자금융ID 조회(해지건 제외)" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="79" _ulen="63" >

CSNO^고객번호^10^0^0^0^0^0^0
ELFN_ID^전자금융ID^20^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" occurs="30" inout="out" _len="92" _ulen="72" >

ELFN_ID^전자금융ID^20^0^0^0^0^0^0
ATMT_ISNC_YN^자동발급여부^1^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="NextBlock1" inout="next" _len="45" _ulen="37" >

ELFN_ID^전자금융ID^20^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
			<TRAN name="obcsb_oimf_520r" title="개인별보안매체상태조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="205" _ulen="157" >

INPUT_CLS^입력 구분^1^0^0^0^0^0^0
RCNO^실명확인번호^13^0^0^0^0^0^0
ELFN_ID^전자금융 ID^20^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0
RCNO_PIP^실명확인번호PIP^68^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="614" _ulen="460" >

RSLT_CLS^결과 구분^1^0^0^0^0^0^0
HTS_STPL_YN^HTS 약정 여부^1^0^0^0^0^0^0
SCRC_STAT_CODE^보안카드 상태 코드^2^0^0^0^0^0^0
ADIF_CNFR_QSTN_CNTT1^부가정보 확인 질문 내용1^2^0^0^0^0^0^0
ADIF_CNFR_QSTN_CNTT2^부가정보 확인 질문 내용2^2^0^0^0^0^0^0
ACNT_OPNG_YN^계좌 개설 여부^1^0^0^0^0^0^0
SCRC_IDX_NO1^보안카드 인덱스 번호1^3^0^7^0^0^0^0
SCRC_IDX_NO2^보안카드 인덱스 번호2^3^0^7^0^0^0^0
ELFN_ID_EXST_YN^전자금융 ID 존재 여부^1^0^0^0^0^0^0
CUST_FULL_NAME^고객 풀 명^100^0^0^0^0^0^0
UI_SMRT_OTP_YN^UI스마트OTP여부^1^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
			<TRAN name="obpds_srvc_316a" title="HTS계좌연결 계좌등록" realdata="0" dessvr="9" >
