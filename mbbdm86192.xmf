'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REG_CERT_1" then
		if sRet == "ok" then
			Form.OpenNextPopup("mhetc90190_s3", "", "")
		else
			Form.SetSharedData("&SCREEN_AUTH" , "")
			
			Form.OpenNextPopup("mhetc90021" , "" , "")
		end if
		
	elseif sKeyName == "REG_CERT_2" then
		if sRet == "ok" then
			Form.SetSharedData("&SCREEN_AUTH" , "")
			
			Form.OpenNextPopup("mhetc90021" , "" , "")
		else
			Form.OpenScreen( "41000" , "")
			Form.CloseForm()
		end if
	
	elseif sKeyName == "REG_CERT_3" then
		if sRet == "ok" then
			Form.OpenNextPopup("mhetc90190_s3", "", "")
		else
			Form.OpenScreen( "41000" , "")
			Form.CloseForm()
		end if
	end if
End Sub

