						<LABEL name="Label3" bgcolor="144:034034034" transmode="0" ly_vert="30,29,315,1,1" />
					</CONTROL_INFO>
				</CONTAINER>
			</CONTROL_INFO>
		</CONTAINER>
		<BUTTON name="btnSkip" visible="0" fontsize="4" btnimage="btn_pop1.9" ly_vert="0,587,188,60,0" />
		<BUTTON name="btnNext" visible="0" fontsize="4" fontstyle="01" btnimage="btn_20.9" ly_vert="187,587,188,60,0" />
		<BUTTON name="btnApltExist" visible="0" bgcolor2="040:125125125" fontsize="4" btnimage="btn_20.9" ly_vert="0,588,375,60,0" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="29691" _ulen="26935" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 계좌개설 완료_즉시완료
' 02. 화면설명 : 계좌개설 완료
' 03. 작    성 : 2021.01.11 김유경
' 04. 수    정 : 
' 2021.10.26 : v0001 : 김수진 : 해외 CFD/ 중개형ISA 추가
' 2022.02.14 : v0002 : 김수진 : 국내/해외 CFD 계좌개설시_국가/계좌 유형 일괄개설 추가
'							국내/해외 2개가 국내(일반/안심),해외(일반/안심)_미국,중국,홍콩,일본 10개로 늘어남
'							CFD 계약서 동의가 된 경우 개설완료화며네서 절차 안내팝업 제외 반영
'-------------------------------------------------------------------------------------------

'****************************************************************************
'GetSharedData (계좌개설-본인계좌인증(2/2) mbbdm10071)
'****************************************************************************
'OutBlock1
Dim getCsno         
Dim getAcnoOutData         
Dim getAcntOpngYn   
Dim getApltAbleYn   
Dim getHtsStplApltYn
Dim getOtpIsncYn    
Dim getScrcIsncYn 
Dim getCfdCndcSgntYN	'v0002
Dim getAthnMdiaUseYn
Dim getElfnId

'OutBlock2
Dim getAcno
Dim getAsno
Dim getPrnm
Dim getPrcd	'v0001
Dim getDataCnt
Dim gTempAcnt

Dim gScrcIsncYN
	gScrcIsncYN = "N"

Dim gRcno
'Dim CloseFlag

Dim g_OsType

Dim sTail
Dim sTail1
Dim sTail2
Dim sTail3	'v0001

Dim gPopupData

'간편인증, 無아이디 관련
Dim g_szSelectID			'선택한 연결처리 아이디
Dim g_szExstCustYn		'기존고객 여부

'============================================================================

Sub Form_OnFormInit()

	g_MediaCd		= "MERITZSMART" '기존 채널유형구분코드 사용안함. 아톤에서 구분하는 채널코드로 지정
	g_OSVersion		= Form.GetSharedData("&OS_VERSION", false)
	g_DeviceModel		= Form.GetSharedData("&DEVICE_MODEL", false)
	g_DeviceId		= Form.GetDeviceID2() 	
	
	g_OsType = Form.GetSharedData("&OS_TYPE", False)
	
	'CloseFlag = 0
	btnNext.bgcolor = 265
	btnSkip.fgcolor = 269
	
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		ContMain.setScrollBarVisible("2")
	end if
	
	ContMain.Table0.SetCellFgColor(1, 1, 268)
	ContMain.Table0.SetCellFgColor(2, 1, 268)
	ContMain.Table0.SetCellFgColor(3, 1, 268)
	ContMain.Table0.SetCellFgColor(4, 1, 268)
	ContMain.Table0.SetCellFgColor(5, 1, 268)
	ContMain.Table0.SetCellFgColor(6, 1, 268)
	ContMain.Table0.SetCellFgColor(7, 1, 268)
	
	ContMain.Table0.SetCellFgColor(1, 3, 268)
	ContMain.Table0.SetCellFgColor(2, 3, 268)
	ContMain.Table0.SetCellFgColor(3, 3, 268)
	ContMain.Table0.SetCellFgColor(4, 3, 268)
	ContMain.Table0.SetCellFgColor(5, 3, 268)
	ContMain.Table0.SetCellFgColor(6, 3, 268)
	ContMain.Table0.SetCellFgColor(7, 3, 268)
	
	getAcno = Form.GetSharedData("gSharedDataAcno"   , false ) 
	getAsno = Form.GetSharedData("gSharedDataAsno"   , false ) 
	getPrnm = Form.GetSharedData("gSharedDataPrnm"   , false ) 	
	getPrcd = Form.GetSharedData("gSharedDataPrcd"   , false )	'v0001
	getDataCnt = Form.GetSharedData("gSharedDataCnt" , false ) 	
	gRCNO      = Form.GetSharedData("BDM_RCNO_PIP"   , false ) '주민등록번호
	gName   = Form.GetSharedData("BDM_NAME"   , false )
	
	getCsno          = Form.GetSharedData("gCsno"          , false ) 
	getAcnoOutData   = Form.GetSharedData("gAcno"          , false ) 
	getAcntOpngYn    = Form.GetSharedData("gAcntOpngYn"    , false ) 
	getApltAbleYn    = Form.GetSharedData("gApltAbleYn"    , false ) 
	getHtsStplApltYn = Form.GetSharedData("gHtsStplApltYn" , false ) 
	getOtpIsncYn     = Form.GetSharedData("gOtpIsncYn"     , false ) 
	getScrcIsncYn    = Form.GetSharedData("gScrcIsncYn"    , false ) 
	getCfdCndcSgntYN = Form.GetSharedData("gCfdCndcSgntYN"    , false ) 'v0002 CFD 기본계약서 서명 여부
	getAthnMdiaUseYn = Form.GetSharedData("gAthnMdiaUseYn"    , false ) 
	getElfnId	   = Form.GetSharedData("gElfnId"    , false ) 
	
	g_szExstCustYn = Form.GetSharedData("BDM_EXSN_CUST_YN"    , false )
	
'	getAcno = "30163422"
'	getAsno = "01"
'	getPrnm = "CMA자산관리(RP)"
'	getDataCnt = 1
'	gRCNO      = "0013F7F01772D39A2B87FC3A3C7582F1FBD4"
'	
'	getCsno = "3000416232"
'	getAcno = "30209233"
'	getAsno = "01"
'	getPrnm = "종합매매"
'	getDataCnt = 1
'	gRCNO      = "0013C7B66E43C696DC20EAC781B48FB8DC1A"
'	getAcntOpngYn    = "Y"
	
'	Form.ShowAlert(getCsno, gRCNO)
	
''	getCsno          = "1000478990"
'	getCsno          = "3000391427"
''	getCsno          = "1000390184"
'	getAcnoOutData   = "30163422"
'	getAcntOpngYn    = "Y"
'	getApltAbleYn    = "N"
'	getHtsStplApltYn = "N"
'	getOtpIsncYn     = "N"
'	getScrcIsncYn    = "Y"
	
	sTail  = split(getAcno, "#")
	sTail1 = split(getAsno, "#")
	sTail2 = split(getPrnm, "#")
	sTail3 = split(getPrcd, "#")	'v0001
	Dim szIsaAcntOpngClcd			'v0001
	szIsaAcntOpngClcd	= Form.GetSharedData("BDM_ISA_ACNT_OPNG_CLCD"    , False )	'v0001
	
	szMnyAcntYn = Form.GetSharedData("BDM_CNFR_TRGT_CUST_CLCD"    , False )
	'test
'	szMnyAcntYn = "01"
	
	if getAcntOpngYn == "Y" then
		btnApltExist.visible = false
		ContMain.Label0.caption = "계좌 개설 완료"
		
		'단기다수 대상일때만 보여줌
		if szMnyAcntYn == "01" then
			ContMain.contNoti.tblText1.visible = false
			ContMain.contNoti.tblText2.visible = true
			ContMain.contNoti.tblText2.top = 41
			
		'즉시 개설 완료면 단기다수대상 없으면 아래 영역 안보임 처리
		else
			ContMain.contNoti.visible = false
		end if
		
		
'		'기고객 유무 판단 TR 호출
'		DATAMANAGER.RequestTranData("obcsb_acif_809r")
		
		'보안매체 여부 체크
		DATAMANAGER.RequestTranData( "obcsb_oimf_520r" )	
		
		'test
		'전자금융ID 조회
'		DATAMANAGER.RequestTranData( "obpds_srvc_312r" )	
		
	else
		ContMain.Label0.caption = "계좌 개설 신청 완료"
		
		btnSkip.visible = False
		btnNext.width	= 375
		btnNext.caption = "확인"
		btnNext.visible = False
		
		'-----------------------------------
		btnApltExist.width	= 377
		btnApltExist.visible = true
		btnApltExist.caption = "확인"
		btnApltExist.bgcolor = 265
		'btnApltExist.fgcolor = 265
		'-----------------------------------
		
		'단기다수 대상일때만 보여줌
		if szMnyAcntYn == "01" then
			ContMain.contNoti.tblText2.visible = true
		else
			ContMain.contNoti.tblText2.visible = false
		end if
	end if
	
	
	
	'JMY 실제개설되는 건수만큼만 표시되도록 Table 높이 강제조정
    '현재 총10Row.
    '0Row.타이틀, 1~8Row.개설된계좌리스트, 9Row.패딩    
	'v0001 해외 CFD 추가로 nNowHeight 변경, Row 추가
	'v0002 국내/해외 국가/계좌유형 일괄개설 추가로 nNowHeight변경 Row 추가
	'연금저축, 랩, 다드림 계좌 추가로 최대 Row 갯수 변경
	nNowHeight = 774  'ContMain.Table0.height
	nCnt = 20 - Cint(getDataCnt)
	nDelHeight = 36 * nCnt		'38=한Row당높이
	ContMain.Table0.height = CInt(nNowHeight) - CInt(nDelHeight) 	
	ContMain.contNoti.top = 209 + CInt(nNowHeight) - CInt(nDelHeight) + 20
	ContMain.LblScrollPos.top = 209 + CInt(nNowHeight) - CInt(nDelHeight) + 20 + 3
	
	ContMain.SetScrollAutoSize()
	
	'JMY 
	If Cint(getDataCnt) == 1 Then
		If Len(Trim(getAcno)) > 0 and Len(Trim(getAsno)) > 0 and Len(Trim(getPrnm)) > 0 Then 
			'ContMain.Table0.SetCellString( 1 , 3, Trim(getAcno).."-"..Trim(getAsno))
			ContMain.Table0.SetCellString( 1 , 3, Trim(getAcno)&Trim(getAsno))
			ContMain.Table0.SetCellString( 1 , 1, Trim(getPrnm))
		End If
	Else
		For i = 0 to Cint(getDataCnt) -1 
			If ubound(sTail) > 0 and ubound(sTail1) > 0 and ubound(sTail2) > 0 Then 
				
				'tempACnt = sTail[i].."-"..sTail1[i]
				tempACnt = sTail[i]&sTail1[i]
				
				ContMain.Table0.SetCellString( i+1 , 3, tempACnt)
				ContMain.Table0.SetCellString( i+1 , 1, sTail2[i])
			End If
			i = i + 1
		Next 	
	End If

	'v0001 sta CFD/중개형 ISA 이수 개설시 안내팝업 띄우기
	Dim szMISAYN, szCFDYN, szFUOT, szOVFO
	szMISAYN = "N"
	szCFDYN = "N"
	szFUOT = "N"
	szOVFO = "N"
	
	For i = 0 to Cint(getDataCnt) -1 
		If sTail3[i] == "140" Then	'중개형 ISA
			szMISAYN = "Y"
		Elseif sTail3[i] == "136" or sTail3[i] == "137" Then	'CFD
			szCFDYN = "Y"
		ElseIf sTail3[i] == "101" Then	'국내선옵
			szFUOT = "Y"
		ElseIf sTail3[i] == "135" Then	'해외선옵
			szOVFO = "Y"
		End if
	Next 
	
	'v0002 sta CFD기본계약서서명여부가 Y값 or null값일경우 팝업제외
	If szCFDYN == "Y" Then
		If getCfdCndcSgntYN == "Y" Or getCfdCndcSgntYN == "" Or getCfdCndcSgntYN == null Then
			szCFDYN = "N"
		End If
	End If
	
	If szMISAYN == "Y" Or szCFDYN == "Y" Or szFUOT == "Y" Or szOVFO == "Y" Then
		gPopupData = szMISAYN & "★" & szCFDYN & "★" & szFUOT & "★" & szOVFO
		Form.SetTimerEvent(10, 1, 1)
	End If
	
	'2021.04.20. 김유경. 로그인 상태인 경우 계좌리스트 재조회.
	Dim sLOGIN_TYPE 
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
	
	If CInt(sLOGIN_TYPE) > 1 then '로그인상태
		Form.RequestCommand("RE_ACCT_LIST" , "" , "")
	End If
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	ContMain.Image0.setMaintainingRatio("1")
	ContMain.ImgInfo.setMaintainingRatio("1")
	ContMain.contNoti.imgInfo.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == 10 or sTimerID == "10" then
		Form.SetTimerEvent(10, 0, 1)
		
		'추가 안내사항 바텀 팝업
		Form.OpenPopupAnimation("mbbdm86192_p1", gPopupData, "", "2")
	end if
End Sub

'============================================================================
Sub btnNext_OnClick()
	Form.SetSharedData( "mOTP_IntoClcd"	, "NMET_ACNT" )
	Form.SetSharedData( "NMET_ACNO"		, getAcnoOutData )
	
	if Trim(btnNext.caption) == "메리츠 간편인증 등록" then
		Form.OpenNextPopup("mhetc90190_s3" , "" , "")
		
	elseif Trim(btnNext.caption) == "로그인" then
		Form.SetSharedData("&SCREEN_AUTH" , "")
		
		Form.OpenNextPopup("mhetc90021" , "" , "")
		
	elseif Trim(btnNext.caption) == "확인" then
		'아이디 다건 고객 : 아이디 연결 후 간편인증 여부 체크
		
		if g_szSelectID == "" or g_szSelectID == null then
			Form.ShowAlert("알림", "연결할 ID를 선택해주세요.")
			exit sub
		end if
		
		'악정내역조회
		DATAMANAGER.RequestTranData( "obpds_srvc_069r" )
	end if
End Sub
'============================================================================
Sub btnApltExist_OnClick()
	if Trim(btnApltExist.caption) == "확인" then
		Form.OpenScreen( "41000" , "")
		Form.CloseForm()
	end if
End Sub
'============================================================================
Sub btnSkip_OnClick()
	'홈으로 가기.
	'CloseFlag = "2"
'	Form.OpenScreen( "41000" , "")
'	Form.CloseForm()

	if Trim(btnSkip.caption) == "로그인" then
		Form.SetSharedData("&SCREEN_AUTH" , "")
		
		Form.OpenNextPopup("mhetc90021" , "" , "")
		
	elseif Trim(btnSkip.caption) == "다음에 하기" then
		Form.OpenScreen( "41000" , "")
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetUserID("meritz")
	
	if szTranID == "obcsb_oimf_520r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "INPUT_CLS"	, 0, "2" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"	, 0, gRcno )
	
	'전자금융ID 조회
	elseif szTranID == "obpds_srvc_312r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO"	, 0, getCsno )
	
	'약정내역 조회
	elseif szTranID == "obpds_srvc_069r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO"	, 0, getCsno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVCD"	, 0, "016" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"	, 0, getAcnoOutData )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"	, 0, "1" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "STPL_STAT_CLS_CODE"	, 0, "98" )
	
	'기존고객 여부 조회
	elseIf szTranID = "obcsb_acif_809r" Then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 0, gRcno)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		Dim szRsltCls, szElfnId
		szRsltCls	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "RSLT_CLS", 0 )
		szElfnId	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ELFN_ID_EXST_YN", 0 )
		
		'후속절차를 위해 ID 여부도 저장
		Form.SetSharedData( "gElfnIdExstYn"		,  szElfnId)
		
		'메리츠간편인증, 無아이디 내용추가
		'mhetc90190_s3 에서 사용하는 Shared값 
		'"NMET_OTP_ISNC_YN" , "NMET_SIMPLE_ATHN", "Meritz_OTP_ACNO", "Meritz_OTP_PhoneNum", "Meritz_OTP_CSNO", "Meritz_OTP_RCNOPIP" 세팅
		Dim szHP1, szHP2, szHP3
		szHP1                = Form.GetSharedData("BDM_HP1"                , false)  '휴대폰번호
		szHP2                = Form.GetSharedData("BDM_HP2"                , false)
		szHP3                = Form.GetSharedData("BDM_HP3"                , false)
		if szRsltCls == "2" then
			Form.SetSharedData("NMET_OTP_ISNC_YN" , "Y")
		else
			Form.SetSharedData("NMET_OTP_ISNC_YN" , "N")
		end if
		Form.SetSharedData("NMET_SIMPLE_ATHN" , "Y")
		Form.SetSharedData("Meritz_OTP_ACNO" , getAcnoOutData)
		Form.SetSharedData("Meritz_OTP_PhoneNum" , szHP1 & szHP2 & szHP3)
		Form.SetSharedData("Meritz_OTP_CSNO" , getCsno)
		Form.SetSharedData("Meritz_OTP_RCNOPIP" , gRCNO)
		
		g_CustNo = Form.GetSharedData("Meritz_OTP_CSNO" , false )
		g_RcnoPip = Form.GetSharedData("Meritz_OTP_RCNOPIP" , false )
		
		'전자금융ID 조회
		DATAMANAGER.RequestTranData( "obpds_srvc_312r" )	
		
	elseif szTranID == "obpds_srvc_312r" then
		Dim nCnt
		nCnt = CInt(DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1"))
		
		'test
'		nCnt = 2
		
		'신규고객 : 개설완료 후 자동으로 아이디 채번 후 계좌에 연결
		'기존고객(아이디 단건) : 개설완료 후 자동으로 아이디에 연결
		'기존고객(아이디 다건) : 개설완료 후 연결 할 아이디 선택하여 화면에서 연결 처리
		'공통 : 연결 후 메리츠 간편인증 등록 여부 체크
		
'		Form.ShowAlert("nCnt", nCnt)
		
		if nCnt == 0 then
			btnNext.visible = true
			btnSkip.visible = true
			btnSkip.fgcolor = 269
			btnNext.left	= 187
			btnNext.width	= 188
			
			'메리츠 간편인증 등록 여부 판단
			if fnGetSBInfo("") == False then
				btnSkip.caption = "로그인"
				btnNext.caption = "메리츠 간편인증 등록"
			else
				DATAMANAGER.SetDataValue(0, "ohhts_pauth_004", "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , g_MediaCd)		'매체구분코드
				DATAMANAGER.SetDataValue(0, "ohhts_pauth_004", "InBlock1", "PAU_CERT_SEQ_NO" 				, 0 , g_SBAlias)		'인증서일련번호 (고객번호, 일련번호 중 1개는 필수)
				DATAMANAGER.SetDataValue(0, "ohhts_pauth_004", "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId)		'이용자접속기기ID
					
				DATAMANAGER.RequestTranData("ohhts_pauth_004")
			end if
			
		elseif nCnt == 1 then
			if g_szExstCustYn == "Y" then
				btnNext.visible = true
				btnSkip.visible = true
				btnSkip.fgcolor = 269
				btnNext.left	= 187
				btnNext.width	= 188
				
				'메리츠 간편인증 등록 여부 판단
				if fnGetSBInfo("") == False then
					btnSkip.caption = "로그인"
					btnNext.caption = "메리츠 간편인증 등록"
				else
					DATAMANAGER.SetDataValue(0, "ohhts_pauth_004", "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , g_MediaCd)		'매체구분코드
					DATAMANAGER.SetDataValue(0, "ohhts_pauth_004", "InBlock1", "PAU_CERT_SEQ_NO" 				, 0 , g_SBAlias)		'인증서일련번호 (고객번호, 일련번호 중 1개는 필수)
					DATAMANAGER.SetDataValue(0, "ohhts_pauth_004", "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId)		'이용자접속기기ID
						
					DATAMANAGER.RequestTranData("ohhts_pauth_004")
				end if
			else
				btnSkip.visible = false
				btnNext.visible = true
				btnNext.left = 0
				btnNext.width = 375
				btnNext.caption = "메리츠 간편인증 등록"
			end if
			
		'아이디 다건 보유시 연결할 아이디 선택
		else
			btnNext.left = 0
			btnNext.width = 375
			btnSkip.visible = false
			btnNext.visible = true
			btnNext.caption = "확인"
			
			'20230704 아이디 선택 후 하단 버튼 활성화 되게 변경 
			btnNext.enable = false
			if Form.GetEnvData("common.theme") = "black" then
				btnNext.btnimage = "btn_27.9"
			else
				btnNext.btnimage = "btn_21.9"
			end if
			btnNext.fgcolor = "269"

			Dim szID
'			Form.ShowAlert("nCnt", nCnt)
			for i = 0 to nCnt - 1
				szID = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ELFN_ID" , i)
'				szID = "liquider" & i
				Form.SetCtlProp("ContMain.contIDList.lblID" & i, "caption", szID)
			next
			
			f_SetIDList(nCnt)
		end if
	
	'메리츠 간편인증 등록 여부 조회(ID 단건)
	elseif szTranID == "ohhts_pauth_004" then
		sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" ,0)
		sKeyAlias	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_SEQ_NO" ,0) 	'인증서일련번호
		sCustNo		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CUST_NO" ,0) 		'고객번호
		'Form.ShowAlert("jsi", sErrorCode)
		if sErrorCode <> "000000" then
			btnSkip.caption = "로그인"
			btnNext.caption = "메리츠 간편인증 등록"
		else
			if sCustNo == getCsno then
				btnSkip.caption = "다음에 하기"
				btnNext.caption = "로그인"
			else
				btnSkip.caption = "다음에 하기"
				btnNext.caption = "메리츠 간편인증 등록"
			end if
		end if
		
	'약정내역 조회
	elseif szTranID == "obpds_srvc_069r" then
		Dim nCnt
		Dim szStplStatClsCode, szSvcd, szSvcSrno
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		for i = 0 to nCnt - 1
			szStplStatClsCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STPL_STAT_CLS_CODE" , i)
			if szStplStatClsCode == "01" then
				szSvcd = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "SVCD" , i)
				szSvcSrno = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "SVC_SRNO" , i)
				exit for
			end if
		next
		
		'필요한 데이터 획득 후 obpds_srvc_316a 호출
		DATAMANAGER.SetDataValue(0, "obpds_srvc_316a" , "InBlock1" , "PROS_CLS_CODE" , 0 , "I")
		DATAMANAGER.SetDataValue(0, "obpds_srvc_316a" , "InBlock1" , "CSNO" , 0 , getCsno)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_316a" , "InBlock1" , "ACNO" , 0 , getAcnoOutData)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_316a" , "InBlock1" , "SVCD" , 0 , szSvcd)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_316a" , "InBlock1" , "SVC_SRNO" , 0 , szSvcSrno)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_316a" , "InBlock1" , "HTS_SOON_YN" , 0 , "N")
		DATAMANAGER.SetDataValue(0, "obpds_srvc_316a" , "InBlock1" , "CONT_CLS_CODE" , 0 , "4")
		
		if CInt(getDataCnt) == 1 then
			DATAMANAGER.SetDataValue(0, "obpds_srvc_316a" , "InBlock2" , "ACNO" , 0 , getAcno)
			DATAMANAGER.SetDataValue(0, "obpds_srvc_316a" , "InBlock2" , "ASNO" , 0 , getAsno)
			DATAMANAGER.SetDataValue(0, "obpds_srvc_316a" , "InBlock2" , "ELFN_ID" , 0 , g_szSelectID)
		else
			Dim tTempAcnt, tTempAsno
			tTempAcnt  = split(getAcno, "#")
			tTempAsno  = split(getAsno, "#")
			
			for i = 0 to CInt(getDataCnt) - 1
				DATAMANAGER.SetDataValue(0, "obpds_srvc_316a" , "InBlock2" , "ACNO" , i , tTempAcnt[i])
				DATAMANAGER.SetDataValue(0, "obpds_srvc_316a" , "InBlock2" , "ASNO" , i , tTempAsno[i])
				DATAMANAGER.SetDataValue(0, "obpds_srvc_316a" , "InBlock2" , "ELFN_ID" , i , g_szSelectID)
			next
		end if
		
		DATAMANAGER.RequestTranData( "obpds_srvc_316a" )
	
	elseif szTranID == "obpds_srvc_316a" then
		'등록 후 메리츠 간편인증 등록 여부 판단
		if fnGetSBInfo("") == False then
			Form.MsgBox("안내", "선택하신 ID에 계좌가 연결되었습니다.\n로그인 후 이용해주세요.", "REG_CERT_1", 7, "간편인증 등록", "로그인")
		else
			DATAMANAGER.SetDataValue(0, "ohhts_pauth_004_1", "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , g_MediaCd)		'매체구분코드
			DATAMANAGER.SetDataValue(0, "ohhts_pauth_004_1", "InBlock1", "PAU_CERT_SEQ_NO" 				, 0 , g_SBAlias)		'인증서일련번호 (고객번호, 일련번호 중 1개는 필수)
			DATAMANAGER.SetDataValue(0, "ohhts_pauth_004_1", "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId)		'이용자접속기기ID
				
			DATAMANAGER.RequestTranData("ohhts_pauth_004_1")
		end if
	
	'메리츠 간편인증 등록 여부 조회(ID 다건)
	elseif szTranID == "ohhts_pauth_004_1" then
		sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" ,0)
		sKeyAlias	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_SEQ_NO" ,0) 	'인증서일련번호
		sCustNo		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CUST_NO" ,0) 		'고객번호
		
		if sErrorCode <> "000000" then
			Form.MsgBox("안내", "선택하신 ID에 계좌가 연결되었습니다.\n로그인 후 이용해주세요.", "REG_CERT_1", 7, "간편인증 등록", "로그인")
		else
			if sCustNo == getCsno then
				Form.MsgBox("안내", "선택하신 ID에 계좌가 연결되었습니다.\n로그인 후 이용해주세요.", "REG_CERT_2", 7, "로그인", "다음에 하기")
			else
				Form.MsgBox("안내", "선택하신 ID에 계좌가 연결되었습니다.\n로그인 후 이용해주세요.", "REG_CERT_3", 7, "간편인증 등록", "다음에 하기")
			end if
		end if
	
	'기존고객 여부 조회
	elseIf szTranID = "obcsb_acif_809r" Then
		g_szExstCustYn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "EXSN_CUST_YN" ,0)
		
		'보안매체 여부 체크
		DATAMANAGER.RequestTranData( "obcsb_oimf_520r" )	
	end if
End Sub

'============================================================================
Function f_SetIDList(nCnt)
	nCnt = CInt(nCnt)
	
	'갯수만큼 아이디 리스트 보임
	for i = 0 to 9
		Form.SetCtlProp("ContMain.contIDList.imgBg" & i, "visible", 0)
		Form.SetCtlProp("ContMain.contIDList.lblID" & i, "visible", 0)
	next
	
	for i = 0 to nCnt - 1
		Form.SetCtlProp("ContMain.contIDList.imgBg" & i, "visible", 1)
		Form.SetCtlProp("ContMain.contIDList.lblID" & i, "visible", 1)
	next
	
	'갯수에 따른 컨테이너 높이 설정
	Dim nContHeight
	
	if CInt(nCnt / 2) == 5 then
		nContHeight = 270
		ContMain.contIDList.height = 270
	elseif CInt(nCnt / 2) == 4 then
		if (nCnt % 2) <> 0 then	'9개
			nContHeight = 270
			ContMain.contIDList.height = 270
		else						'8개
			nContHeight = 230
			ContMain.contIDList.height = 230
		end if
	elseif CInt(nCnt / 2) == 3 then
		if (nCnt % 2) <> 0 then	'7개
			nContHeight = 230
			ContMain.contIDList.height = 230
		else						'6개
			nContHeight = 185
			ContMain.contIDList.height = 185
		end if
	elseif CInt(nCnt / 2) == 2 then
		if (nCnt % 2) <> 0 then	'5개
			nContHeight = 185
			ContMain.contIDList.height = 185
		else						'4개
			nContHeight = 140
			ContMain.contIDList.height = 140
		end if
	elseif CInt(nCnt / 2) == 1 then
		if (nCnt % 2) <> 0 then	'3개
			nContHeight = 140
			ContMain.contIDList.height = 140
		else						'2개
			nContHeight = 95
			ContMain.contIDList.height = 95
		end if
	else
		nContHeight = 95					'1개
		ContMain.contIDList.height = 95
	end if
	
	'컨테이너 높이 설정 후 아래 위치한 컨트롤들 위치 조정
	nNowHeight = 774  'ContMain.Table0.height
	nTempCnt = 20 - Cint(getDataCnt)
	nDelHeight = 36 * nTempCnt		'38=한Row당높이 	
	ContMain.contIDList.top = 209 + CInt(nNowHeight) - CInt(nDelHeight)
	ContMain.contNoti.top = 209 + CInt(nNowHeight) - CInt(nDelHeight) + 20 + nContHeight
	ContMain.LblScrollPos.top = 209 + CInt(nNowHeight) - CInt(nDelHeight) + 20 + nContHeight
	
	ContMain.contIDList.visible = true
	
	ContMain.contIDList.SetScrollAutoSize()
	ContMain.SetScrollAutoSize()
End Function

'============================================================================
Function f_SelectIDList(nIndex)
	'전부 초기화 후 선택항목 활성화
	for i = 0 to 9
		Form.SetCtlProp("ContMain.contIDList.imgBg" & i, "imgpath", "input_01_n.9")
		Form.SetCtlProp("ContMain.contIDList.lblID" & i, "fontbold", 0)
	next
	
	Form.SetCtlProp("ContMain.contIDList.imgBg" & nIndex, "imgpath", "input_01_o.9")
	Form.SetCtlProp("ContMain.contIDList.lblID" & nIndex, "fontbold", 1)
	
	'연결할 아이디 변수에 지정
	g_szSelectID = Form.GetCtlProp("ContMain.contIDList.lblID" & nIndex, "caption")
	
	'20230704 아이디 선택 후 하단 버튼 활성화 되게 변경 
	btnNext.enable = true
	btnNext.btnimage = "btn_20.9"
	btnNext.fgcolor = "273"
End Function

