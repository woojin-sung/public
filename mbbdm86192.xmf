Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
     if len(trim(DATAMANAGER.GetDataMsgSubText(szTranID))) == 0 then
	     ShowAlert "안내", szErrMsg
     else
		ShowAlert "안내", szErrMsg&"\n("&DATAMANAGER.GetDataMsgSubText(szTranID)&")"
	end if
End Sub

