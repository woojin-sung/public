'============================================================================
' 01. 화 면 명 : 고객자산평가_계좌별자산
' 02. 화면설명 : 고객자산평가_계좌별자산
' 03. 작    성 : 2016. 02. 04. 유창재
' 2021.07.05 : 정민영 : v0001 : obcsb_efif_005r IO재매핑
' 2024.01.17 : 전상일 : v0002 : 계좌표시순서 적용을 위한 id 맵핑
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim szACNO			'계좌번호
Dim szTemp			'트리거에서 받아온 데이터 저장 변수
Dim szUSERID

Dim nAmt
Dim nPrlsamt
Dim nDrngamt
Dim nPrlsrate
Dim szAcc
Dim szGrdname
Dim grdIdx
Dim szAccprcd			'20221110 HSZ 1차 개선 건
DIM g_UI_PRLS_AMT
Dim szAccProd
Dim g_AccSubname

Dim g_btnFlag			'스위치 플래그
Dim g_szRate
g_szRate = 0

dim g_szInputFile	'읽어들일세팅파일
g_szInputFile	 = "mbact71052.ini"
dim g_szKey		'키값		
g_szKey = "71052T2switch"
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetInput(szData) : TR의 입력값 세팅
'============================================================================
Function SetInput(szData)
	DATAMANAGER.SetDataValue( 0 , "obacb_balc_153r", "InBlock1", "CSNO" , 0 , szData)
	'v0002 : 계좌표시순서 적용을 위한 id 맵핑
	szCustID = Form.GetSharedData("&USER_ID", false)
	DATAMANAGER.SetDataValue( 0 , "obacb_balc_153r", "InBlock1", "ELFN_ID" , 0 , szCustID)
	DATAMANAGER.RequestTranData( "obacb_balc_153r" )
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam) : 트리거에서 입력받은 계좌번호를 사용하여 입력 세팅
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "mbact71052_t2" then				'계좌별자산
		grd1.SetClear()
		grd2.SetClear()
		grdCmb.SetClear()
		
		DATAMANAGER.SetDataValue( 0, "ooopc_cuma_093r", "InBlock1", "CSNO" , 0 , sParam)
		DATAMANAGER.RequestTranData("ooopc_cuma_093r")	'종합계좌 리스트 조회
	
		grdIdx = 0
		szTemp = sParam
		Call SetInput(szTemp)
	end if	
End Sub 
'============================================================================
' grd1_OnClickUp(lRow, szCellID)	행을 누를시 상세팝업 띄움
'============================================================================
Sub grd1_OnClickUp(lRow, szCellID)
	Dim szData
	szData = ""
	
	'종합계좌 데이터
	szAsnoList = ""
	for i=0 to CInt(grd2.rowcount)-1
		szAcctotal = grd2.GetCellData("bd_cell0", i)
		szAsnoList = szAsnoList & "○" & szAcctotal	'종합계좌 리스트
	next

	'개별계좌 데이터
	szAccCmb = ""
	szAccCmbTxt = ""
	for i=0 to CInt(grdCmb.rowcount)-1
		szAcnoCmb = grdCmb.GetCellData("bd_cell0", i)
		szAsnoCmb = grdCmb.GetCellData("bd_cell1", i)
		szNameCmb = grdCmb.GetCellData("bd_cell2", i)
		szfullacc = szAcnoCmb..szAsnoCmb
		if szNameCmb <> "" then
			szaccname = "["..szNameCmb.."] "..left(szAcnoCmb, 4).."-"..right(szAcnoCmb, 4).."-"..szAsnoCmb
		else
			szaccname = left(szAcnoCmb, 4).."-"..right(szAcnoCmb, 4).."-"..szAsnoCmb
		end if
		szAccCmb = szAccCmb & "○" & szfullacc				'개별계좌 리스트
		szAccCmbTxt = szAccCmbTxt & "○" & szaccname			'개별계좌명 리스트
	next
	
	'화면 연동시, 선택한 계좌로 세팅
	szAccString = grd1.GetCellData("bd_acc", lRow)
	szIdx = acc1.GetIndexByAccountinfo(szAccString)
	acc1.currentindex = szIdx
	
	'행을 누를때 각각의 상세팝업
	if lRow <> "" or IRow <> -1 then
		if szCellID = "bd_left" then					'거래내역 화면
			Form.OpenScreen("71040" , "")
		elseif szCellID = "bd_center" then				'이체 화면
			szAcc = grd1.GetCellData("bd_acc", lRow)
			Form.OpenScreen("63010" , szAcc)
			Form.PostLinkData("mbbnk63010setDrngAcnt", szAcc) '20221123 JWH
		elseif szCellID = "bd_right" then				'기간손익 화면
			Dim szData, sACNO, sASNO, sAMT
			sACNO	= grd1.GetCellData("bd_ACNO", 	lRow)
			sASNO	= grd1.GetCellData("bd_ASNO", 	lRow)
			sAMT		= grd1.GetCellData("bd_amt",	lRow)
			szData	= sACNO.."|"..sASNO.."|"..sAMT
			
			Form.OpenFramePopup("mbtrs15000_p1", szData, "")
		
		'계좌복사기능 추가 - 20240612
		elseif szCellID = "bd_name" or szCellID = "bd_copy" then				
			szOSType = Form.GetSharedData("&OS_TYPE", false) 
			szClipAcc = grd1.GetCellData("bd_name", lRow)
			
			Form.setClipboardText(szClipAcc)
			
			if szOSType == "2" then 	'iOS
				Form.Toast(0, "클립보드에 복사되었어요.", 0.2)
			end if 
			
'		else													'잔고팝업 - 20240612
		elseif szCellID = "bd_amt" or szCellID = "bd_img" then		'잔고팝업 - 20240612
			szACNO	=	grd1.GetCellData("bd_acc", lRow)
			'20221110 HSZ START: 1차 개선 건
'			szIndex	=  	"0"
			szGetPrcd	= 	grd1.GetCellData("bd_cell4", lRow)	'20221110 HSZ
			'if szGetPrcd = "118" then		'CMA
			'	szIndex = "7"
			if szGetPrcd = "136" then	'국내CFD
				szIndex	=  	"2"
			elseif szGetPrcd = "137" then	'해외CFD
				szIndex	=  	"3"
			elseif szGetPrcd = "101" then	'선물옵션
				szIndex	=  	"4"
			else
				szIndex	=  	"7"
			end if
			'20221110 HSZ END

			szData = szIndex & "☆" & CInt(grd2.rowcount) & "☆" & "t2" & "☆" & szACNO & "☆" & szAsnoList& "☆" & CInt(grdCmb.rowcount) & "☆" & szAccCmb & "☆" & szAccCmbTxt 
					'tab인덱스, 종합계좌개수, 탭, 선택계좌번호, 종합계좌리스트, 개별계좌개수, 개별계좌리스트

			Form.OpenPopup( "mbact71052_p1" , szData , "")
		
		end if
	end if
End Sub


'============================================================================
Sub Form_OnFormInit()
	szACNO = ""
	Button0.SetApplySwitch( "보기", "숨김", 269, 261, 286, 67) 
	szLoadData = Form.LoadConfigData(g_szInputFile, g_szKey)
	if szLoadData = "" or szLoadData = null then
		g_btnFlag = "0"
	else
		g_btnFlag = szLoadData
	end if
	if g_btnFlag = "1" then
		Button0.switchindex = "1"
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacb_balc_153r" then
		
		 szCurAcnt = Form.LoadConfigData("mbact71052", "cur_Acnt") '20240219 SWJ
		
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obacb_balc_153r", "OutBlock1")-1
			nAmt 		= DATAMANAGER.GetDataValue(0, "obacb_balc_153r", "OutBlock1", "VLTN_AMT", 		i)
			nPrlsamt 	= DATAMANAGER.GetDataValue(0, "obacb_balc_153r", "OutBlock1", "VLTN_PRLS_AMT", 	i)
			nDrngamt 	= DATAMANAGER.GetDataValue(0, "obacb_balc_153r", "OutBlock1", "DRNG_ABLE_AMT", 	i)
			nPrlsrate 	= DATAMANAGER.GetDataValue(0, "obacb_balc_153r", "OutBlock1", "PLRT", 			i)
			szAcc 		= DATAMANAGER.GetDataValue(0, "obacb_balc_153r", "OutBlock1", "ACNO", 			i) & DATAMANAGER.GetDataValue(0, "obacb_balc_153r" , "OutBlock1" , "ASNO" , i)
			szAccProd	= DATAMANAGER.GetDataValue(0, "obacb_balc_153r", "OutBlock1", "UI_PROD_CLS_NAME",	i)
			szAccacno 	= DATAMANAGER.GetDataValue(0, "obacb_balc_153r", "OutBlock1", "ACNO", 			i)
			szAccasno 	= DATAMANAGER.GetDataValue(0, "obacb_balc_153r", "OutBlock1", "ASNO", 			i)
			szAccprcd 	= DATAMANAGER.GetDataValue(0, "obacb_balc_153r", "OutBlock1", "UI_PRCD", 		i)	'20221110 HSZ : 1차개선 건
			g_UI_PRLS_AMT	= DATAMANAGER.GetDataValue(0, "obacb_balc_153r", "OutBlock1", "UI_PRLS_AMT", 		i)	'금일_손익금액
			g_AccSubname	= DATAMANAGER.GetDataValue(0, "obacb_balc_153r", "OutBlock1", "INPR_BKKP_NAME", 	i)	'계좌별명

'			if szAccProd <> "" then
'				szGrdname = LEFT(szAccacno, 4).."-"..RIGHT(szAccacno, 4).."-"..szAccasno.." ("..szAccProd..")"
'			else
'				szGrdname = LEFT(szAccacno, 4).."-"..RIGHT(szAccacno, 4).."-"..szAccasno
'			end if
			szGrdname = LEFT(szAccacno, 4).."-"..RIGHT(szAccacno, 4).."-"..szAccasno
			
			if g_btnFlag = "1" then
				if CDBL(nAmt) = 0 then
				else
					grd1.AddRow()
					Setgrd1Data(grdIdx)
					grdIdx = grdIdx+1
				end if
			elseif g_btnFlag = "0" then
				grd1.AddRow()
				Setgrd1Data(grdIdx)
				grdIdx = grdIdx+1
			end if
			
			'20240219 SWJ START
			if szAcc == szCurAcnt then
				szSaveRow = i
			end if
			'20240219 SWJ END
		next
		
		if  DATAMANAGER.IsMoreNextData( "obacb_balc_153r" ) == True then 
			DATAMANAGER.RequestNextData("obacb_balc_153r")
		else
		'20230116 HSZ START : 개별계좌 속성에 따라 폼탭 구성
			szGrpIdx = CInt(grdCmb.rowcount)
			for i=0 to CInt(grdCmb.rowcount)-1
				szidx = CInt(grdCmb.GetCellData("bd_cell3", i))
				szGrpIdx = szGrpIdx & "☆" & szidx
			next
			Form.SetSharedData("71052_Index" , szGrpIdx)	'계좌개수☆개별계좌의 그룹인덱스
			
			'20240219 SWJ START
			if szSaveRow <> "" then
				grd1.toprow = Cint(szSaveRow)
			end if
			'20240219 SWJ END
			
			'20240327 홈화면 My자산탭에서 물고온 계좌 toprow 세팅
			Dim szSelectAcnt
			szSelectAcnt = Form.GetSharedData("50030_Acnt", false)	'획득 후 클리어 처리
			if szSelectAcnt <> "" and szSelectAcnt <> null then
				Dim szListAcnt
				for i = 0 to grd1.rowcount - 1
					szListAcnt = grd1.GetCellData("bd_ACNO", i) .. grd1.GetCellData("bd_ASNO", i)
					if szListAcnt == szSelectAcnt then
						grd1.toprow = i
						
						'화면구조상 마지막 인덱스의 계좌는 스크롤 처리 필요
						if i + 1 == CInt(grd1.rowcount) then
							Form.triggerEvent("#", "SCROLL_POS", "")
						end if
						exit for
					end if
				next
			end if
			
		'20230116 HSZ END	
		end if
	elseif szTranID == "ooopc_cuma_093r" then
		if  DATAMANAGER.IsMoreNextData( "ooopc_cuma_093r" ) == True then 
			DATAMANAGER.RequestNextData("ooopc_cuma_093r")
		end if
	end if
End Sub
'============================================================================
Sub Setgrd1Data(i)
	grd1.SetCellData("bd_txt0",		i, "평가금액")
	grd1.SetCellData("bd_txt0",		i, "평가금액")
	grd1.SetCellData("bd_txt1",		i, "평가손익")
	grd1.SetCellData("bd_txt3",		i, "당일손익")
	grd1.SetCellData("bd_txt2",		i, "출금가능금액")
	grd1.SetCellData("bd_amt", 		i, nAmt)
	grd1.SetCellData("bd_cash",		i, nDrngamt)
	grd1.SetCellData("bd_acc",		i, szAcc)
	grd1.SetCellData("bd_name",		i, szGrdname)
	grd1.SetCellData("bd_cell4",	i, szAccprcd)	'20221110 HSZ 1차 개선 건
	grd1.SetCellData("bd_ACNO",		i, szAccacno)
	grd1.SetCellData("bd_ASNO",		i, szAccasno)
	grd1.SetCellData("bd_bar0",		i, "│")
'	grd1.SetCellData("bd_bar1",		i, "│")

	' 계좌타입
	if szAccProd <> "" then
		grd1.SetCellImage("bd_type", i, "img_bgsquare_grade_316.png")
		grd1.SetCellFgColor("bd_type", i, 321)
		grd1.SetCellData("bd_type",		i, szAccProd)
	else
		grd1.SetCellImage("bd_type", i, "empty.png")
	end if
	
	'계좌복사 기능
	grd1.SetCellImage("bd_copy", i, "icon_copy_gray.png")
	
	' 계좌별명(미설정 시, 공백 내려옴)
	if trim(g_AccSubname) <> "" then
		grd1.SetCellFgColor("bd_subname",	i, 321)
		grd1.SetCellData("bd_subname"	,	i, g_AccSubname)
	end if
	
	if CDBL(nPrlsamt) > 0 then
		grd1.SetCellData("bd_prls", i, "+"..FormatNumber(nPrlsamt,0).."원  |  +"..FormatNumber(nPrlsrate,2).."%")
		grd1.SetCellFgColor("bd_prls", i, "10")
	elseif CDBL(nPrlsamt) < 0 then
		grd1.SetCellData("bd_prls", i, FormatNumber(nPrlsamt,0).."원  |  "..FormatNumber(nPrlsrate,2).."%")
		grd1.SetCellFgColor("bd_prls", i, "11")
	else
		grd1.SetCellData("bd_prls", i, FormatNumber(nPrlsamt,0).."원  |  "..FormatNumber(nPrlsrate,2).."%")
	end if
	
	if CDBL(g_UI_PRLS_AMT) > 0 then
		grd1.SetCellData("bd_today_prls", 			i, "+"..FormatNumber(g_UI_PRLS_AMT,0).."원")
		grd1.SetCellFgColor("bd_today_prls", 		i, "10")
	elseif CDBL(g_UI_PRLS_AMT) < 0 then
		grd1.SetCellData("bd_today_prls", 			i, FormatNumber(g_UI_PRLS_AMT,0).."원")
		grd1.SetCellFgColor("bd_today_prls", 		i, "11")
	else
		grd1.SetCellData("bd_today_prls", 			i, FormatNumber(g_UI_PRLS_AMT,0).."원")
	end if
	
	grd1.SetCellData("bd_left", 		i, "거래내역")
	grd1.SetCellFgColor("bd_left",		i, "100")
	grd1.SetCellData("bd_center",		i, "이체")
	grd1.SetCellFgColor("bd_center",	i, "100")
	grd1.SetCellData("bd_right",		i, "기간손익")
	grd1.SetCellFgColor("bd_right",		i, "100")
End Sub 
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
End Sub

'============================================================================
Sub Button0_OnClick()
	g_btnFlag = Button0.switchindex
	grd1.SetClear()
	grdIdx = 0
	SetInput(szTemp)
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SaveConfigData(g_szInputFile,	g_szKey,	g_btnFlag)
End Sub

'============================================================================


'============================================================================
Sub Form_OnFormInitBefore()
	grd1.SetMaintainingRatio("bd_type", 0, "1")
	grd1.SetMaintainingRatio("bd_copy", 0, "1")
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obacb_balc_153r" trcode="obacb_balc_153r" compress="1" encryption="1" timeout="120" inputcheck="1" useattr="0" >
				<TRBLOCK name="InBlock1" >
					<FIELD name="IQRY_CLS_CODE" idx="0" defconst="2" />
				</TRBLOCK>
			</TRAN>
			<TRAN tranid="ooopc_cuma_093r" trcode="ooopc_cuma_093r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obacb_balc_153r" title="고객 개별계좌별 자산현황조회(M" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="160" _ulen="124" >

IQRY_CLS_CODE^조회구분코드^1^0^0^0^0^0^0
ELFN_ID^전자금융ID^20^0^0^0^0^0^0
CSNO^고객번호^10^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0

				</TRBLOCK>
