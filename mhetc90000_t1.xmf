Sub Cont0_Image9_OnClick()
	'로그인 여부 체크
	Dim sLOGIN_TYPE  
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
		
	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
	else
		Form.OpenScreen("90020" , "90022")
		Exit Sub 
	end if
	
	'20230612 팝업알림 후 허용/  
	if (g_szPAndICheck == "N") and (Cont0.Table0.GetCellString(9, 1) == "차단" )  then
		Form.OpenPopupAnimation(G_ONLINESIMCONN_FILE, g_szPAndICheckKey,"Y", "2")
		
	elseif (g_szPAndICheck == "Y") and (Cont0.Table0.GetCellString(9, 1) == "허용" )  then
		DATAMANAGER.SetDataValue(0, "obcsb_efif_167a", "InBlock1", "ELFN_ID" , 0 , g_szId)
		DATAMANAGER.SetDataValue(0, "obcsb_efif_167a", "InBlock1", "CNCC_CONN_INFR_YN", 0 , "N")		
		DATAMANAGER.RequestTranData("obcsb_efif_167a")
		
	end if 	
End Sub

