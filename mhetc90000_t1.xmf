'============================================================================
'20180607 HAMWG START : 백그라운드 앱종료 방지기능 추가 
'============================================================================
Sub Cont0_btnBack2_OnClick()

	if Form.GetSharedData("&OS_TYPE", False ) <> "2" then
		szAppVerCode = Form.GetSharedData("&APP_VERSION_CODE", False)

		if Cint(szAppVerCode) < 42 then
			Form.MsgBox("알림", "'메리츠 SMART' 앱 업데이트 후\n백그라운드 앱 실행유지 기능을 사용하실 수 있습니다.\n\nGoogle Play 스토어로 이동하시겠습니까?", "UPDATE_MTS", "1")
			Exit Sub
		end if
	    
	    szUseBack = Cont0.Table0.GetCellString( 11, 1 )				    
	    if szUseBack == "미사용" then
			Form.MsgBox("알림", "백그라운드 앱 실행유지 기능을 사용하시면 알림창에 '메리츠 SMART' 가 항상 표시됩니다.\n\n백그라운드 앱 실행유지 기능을 사용하시겠습니까?", "NOTI_MTS", "1")
		else
			SetConfigData(g_sBackgroundRunKey, 11, 1)
			GetConfigData(g_sBackgroundRunKey, 11, 1)
		end if
	else
		'Cont0.Table0.SetCellString( 11, 1, "미사용" )
		Cont0.btnBackgroundRun.switchindex = 0 
		Cont0.btnBackgroundRun.enable = false 	
		'0814 JJH START--------------------------------------------------------
		Cont0.btnBackgroundRun0.switchindex = 0 
		Cont0.btnBackgroundRun0.enable = false 
		
		Cont0.Table0.SetCellFgColor( 13, 0, "17" )
		Cont0.Table0.SetCellFgColor( 14, 0, "17" )
		Cont0.Table0.SetCellFgColor( 11, 1, "17" )
		
		Cont0.Table1.SetCellFgColor( 13, 0, "17" )
		Cont0.Table1.SetCellFgColor( 14, 0, "17" )
		Cont0.Table1.SetCellFgColor( 11, 1, "17" )
		'0814 JJH END--------------------------------------------------------
		Form.MsgBox("알림", "아이폰(IOS 단말기)에선\n사용할 수 없는 기능입니다.", "", "0")
	end if	
End Sub
'20230518 KKM END

