'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sScreenKey '앱실행시첫화면
'20180515 HAMWG : 공인인증설정 삭제 
'Dim g_sCertScreenKey '공인인증서로그인시첫화면
Dim g_sSideChangeKey '사이드종목변경버튼
'2016.02.29 지수티커삭제
'Dim g_sTickerKey '지수티커
Dim g_sThemeKey '스킨설정
Dim g_sTextSizeKey '글자크기
Dim g_sCurTouchKey '현재가터치이동
Dim g_sAutoLogoutKey '자동로그아웃
Dim g_sKeepLightKey '화면자동꺼짐방지
Dim g_sInterestCloudKey '관심종목동기화
Dim g_szPAndICheckKey ' 온라인동시접속
Dim G_SCREENCHOICE_FILE '선택화면팝업
Dim G_TICKERCHOICE_FILE '지수티커팝업
Dim G_ONLINESIMCONN_FILE '온라인매체동시접속 팝업
Dim g_OS_Type			 'OS타입(Android("1") iOS("2"))	'20170904_03 LKM 

Dim g_sBackgroundRunKey '20180607 HAMWG : 백그라운드 앱종료 방지기능 추가
Dim g_sViewARSKey ' 20191202 보이는 ARS 설정추가 YGH

Dim g_szId			'사용자아이디
Dim g_szPAndICheck
g_szPAndICheck = "N"
Dim g_isFirst
g_isFirst = true

