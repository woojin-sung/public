'============================================================================
Sub Form_OnFormInit()
	'0814 JJH START : 테스트에서만 보이게끔 설정
	nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	if nType == "0" then
		Cont0.Button3.visible = false
	elseif nType == "1" then
		Cont0.Button3.visible = true
	end if
	'0814 JJH END
	'20230518 KKM 스위치버튼 변경		
	Cont0.btnInterestCloud.SetApplySwitch( "", "", 269, 261, 286, 289) 
	Cont0.btnKeepLight.SetApplySwitch( "", "", 269, 261, 286, 289) 
	Cont0.btnBackgroundRun.SetApplySwitch( "", "", 269, 261, 286, 289) 
	Cont0.btnViewARS.SetApplySwitch( "", "", 269, 261, 286, 289) 	
	'0814 JJH START--------------------------------------------------------
	Cont0.btnKeepLight0.SetApplySwitch( "", "", 269, 261, 286, 289) 
	Cont0.btnBackgroundRun0.SetApplySwitch( "", "", 269, 261, 286, 289) 
	Cont0.btnViewARS0.SetApplySwitch( "", "", 269, 261, 286, 289) 	
	
	Cont0.btnBack1.bringfront("1") 
	Cont0.btnBack2.bringfront("1") 	
	Cont0.btnBack3.bringfront("1") 	
	'20230518 KKM END
	'0814 JJH END--------------------------------------------------------
	G_SCREENCHOICE_FILE = "mhetc90000_p3"
	G_TICKERCHOICE_FILE = "mhetc90000_p4"
	G_ONLINESIMCONN_FILE = "mhetc90000_p8"
	g_sScreenKey = "common.start_screen"
'	g_sCertScreenKey = "common.cert_start_screen" '20180515 HAMWG : 공인인증설정 삭제 
	g_sSideChangeKey = "common.side_modify"
'	g_sTickerKey = "alrim.ticker.use"
'	g_sThemeKey = "common.theme"				'20230426 HSZ 테마설정 삭제
	g_sTextSizeKey = "common.textsize"
	g_sCurTouchKey = "common.curtouch_swing"
	g_sAutoLogoutKey = "common.autologout"
	g_sKeepLightKey = "common.keep_light"
	g_sInterestCloudKey = "common.interest_cloud"
	g_szPAndICheckKey = "common.pandlcheck" '20230508 KKM 온라인 동시접속 추가(임의)
	
	g_sBackgroundRunKey = "common.background_run" '20180607 HAMWG : 백그라운드 앱종료 방지기능 추가
	g_sViewARSKey = "callgate_svc_agree"	

	GetConfigData(g_sScreenKey, 1, 1)
'	GetConfigData(g_sCertScreenKey, 2, 1) '20180515 HAMWG : 공인인증설정 삭제 
	GetConfigData(g_sSideChangeKey, 2, 1)
'	GetConfigData(g_sTickerKey, 4, 1)
'	GetConfigData(g_sThemeKey, 4, 1)	 '20230426 HSZ: 테마설정 삭제
	GetConfigData(g_sTextSizeKey, 4, 1)	
	GetConfigData(g_sCurTouchKey, 5, 1)
	GetConfigData(g_sInterestCloudKey, 6, 1)	
	GetConfigData(g_sAutoLogoutKey, 8, 1)
	GetConfigData(g_szPAndICheckKey, 9, 1) '20230508 KKM 온라인 동시접속 추가
	GetConfigData(g_sKeepLightKey, 10, 1)
	
	'20180607 HAMWG START : 백그라운드 앱종료 방지기능 추가  
	if Form.GetSharedData("&OS_TYPE", False ) <> "2" then
		GetConfigData(g_sBackgroundRunKey, 11, 1) 
	else
		'Cont0.Table0.SetCellString( 11, 1, "미사용" )
		Cont0.btnBackgroundRun.switchindex = 0 
		Cont0.btnBackgroundRun.enable = false '20230518 KKM 스위치버튼 변경		
		'0814 JJH START--------------------------------------------------------
		Cont0.btnBackgroundRun0.switchindex = 0 
		Cont0.btnBackgroundRun0.enable = false 
		
		Cont0.Table0.SetCellFgColor( 13, 0, "17" )
		Cont0.Table0.SetCellFgColor( 14, 0, "17" )
		Cont0.Table0.SetCellFgColor( 11, 1, "17" )
		
		Cont0.Table1.SetCellFgColor( 13, 0, "17" )
		Cont0.Table1.SetCellFgColor( 14, 0, "17" )
		Cont0.Table1.SetCellFgColor( 11, 1, "17" )
		'0814 JJH END--------------------------------------------------------
	end if
	'20180607 HAMWG END
	GetConfigData(g_sViewARSKey, 12, 1)
	
	Dim sVersion
	sVersion = Form.GetSharedData("&APP_VERSION", false )
	g_OS_Type = Form.GetSharedData("&OS_TYPE", false )    '20170904_03 LKM 	

	'Cont0.Table0.SetCellString( 16, 1, "VER "..sVersion ) '버전정보 '20180607 HAMWG : 백그라운드 앱종료 방지기능 추가
	Cont0.btnVersion.caption = "VER "..sVersion
	
	'20230509 KKM 온라인동시접속 설정 조회
	g_szId = Form.GetSharedData("&USER_ID" , false)
	DATAMANAGER.SetDataValue(0, "obcsb_efif_166r", "InBlock1", "ELFN_ID", 0 , g_szId)
	DATAMANAGER.RequestTranData("obcsb_efif_166r")	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "updateiOS" then
		if sRet == "close" then
			'20170906_01 LKM START:마스터파일 정상 수신하지 못하는 케이스 보완
			Form.reUpdateFile("mts_master.crc")
			
			'ORG
			'Form.RestartApp()
			'20170906_01 LKM END
		end if
	elseif sKeyName == "updateAndroid" then
		if sRet == "ok" then
			'20170906_01 LKM START:마스터파일 정상 수신하지 못하는 케이스 보완
			Form.reUpdateFile("mts_master.crc")
			
			'ORG
			'Form.RestartApp()
			'20170906_01 LKM END
		end if
	elseif sKeyName == "clear" then
		if sRet == "ok" then
			SetInitData()
		end if
		
	'20180607 HAMWG START : 백그라운드 앱종료 방지기능 추가
	elseif sKeyName == "UPDATE_MTS" then
		if sRet == "ok" then
			nDev = Form.GetSharedData("&SERVER_MODE", 0 )
			if nDev == "1" then
				bRtn = Form.runStoreApp("", "http://211.201.184.164/meritzmts")	' 20181203 HWG : 테스트 웹서버 변경대응(211.255.202.106 -> 211.201.184.164)
			else
				bRtn = Form.runStoreApp("", "market://details?id=com.imeritz.smartmeritz")
			end if		
		end if
		
	elseif sKeyName == "NOTI_MTS" then
		if sRet == "ok" then
			SetConfigData(g_sBackgroundRunKey, 11, 1)
			GetConfigData(g_sBackgroundRunKey, 11, 1)
		end if
	'20180607 HAMWG END	
	
	'20230619 HSZ START: 퀵메뉴 설정 초기화 추가 - iOS는 재접속 시 적용, 안드는 안해도 됨.
	elseif sKeyName == "quickmenuiOS" then
		if sRet == "ok" then
			Form.resetQuickMenu()
			Form.RestartApp()
		end if
	elseif sKeyName == "quickmenuAND" then
		if sRet == "ok" then
			Form.resetQuickMenu()
		end if
		'0814 JJH START--------------------------------------------------------
	elseif sKeyName == "SYNCHRONIZE" then
		if sRet == "ok" then
			Form.SetEnvData(1, g_sInterestCloudKey, "1")
			GetConfigData(g_sInterestCloudKey, 6, 1)
		end if
		'0814 JJH END--------------------------------------------------------
	end if
	'20230619 HSZ END

End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == G_SCREENCHOICE_FILE or sKeyName == G_TICKERCHOICE_FILE or sKeyName == G_ONLINESIMCONN_FILE then
		if sRet == g_sScreenKey then
			GetConfigData(g_sScreenKey, 1, 1)
'		elseif sRet == g_sCertScreenKey then		'20180515 HAMWG : 공인인증설정 삭제 
'			GetConfigData(g_sCertScreenKey, 2, 1)
		elseif sRet == g_sSideChangeKey then
			GetConfigData(g_sSideChangeKey, 2, 1)
'		elseif sRet == g_sTickerKey then
'			GetConfigData(g_sTickerKey, 4, 1)
'		elseif sRet == g_sThemeKey then
'			GetConfigData(g_sThemeKey, 4, 1)
		elseif sRet == g_sTextSizeKey then
			GetConfigData(g_sTextSizeKey, 4, 1)
		elseif sRet == g_sCurTouchKey then
			GetConfigData(g_sCurTouchKey, 5, 1)
		elseif sRet == g_sAutoLogoutKey then
			GetConfigData(g_sAutoLogoutKey, 8, 1)
		elseif sRet == g_sViewARSKey then
			GetConfigData(g_sViewARSKey, 12, 1)
		elseif sRet == g_szPAndICheckKey then
			'20230508 KKM 온라인 동시접속 추가
			Form.Toast(1, "온라인 동시접속이 허용되었습니다.", true)
			DATAMANAGER.SetDataValue(0, "obcsb_efif_166r", "InBlock1", "ELFN_ID", 0 , g_szId)
			DATAMANAGER.RequestTranData("obcsb_efif_166r")			
		end if
	end if
End Sub

