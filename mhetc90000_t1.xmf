Sub Cont0_Table1_OnClick(lRow , lColumn)
	if lColumn == 0 then
	elseif lColumn == 1 then
		if lRow == 1 then '앱실행시첫화면
			Form.OpenPopup(G_SCREENCHOICE_FILE , g_sScreenKey, "")
		elseif lRow == 2 then '사이드종목변경버튼
			Form.OpenPopup(G_SCREENCHOICE_FILE , g_sSideChangeKey, "")
		elseif lRow == 4 then '글자크기
			Form.OpenPopup(G_SCREENCHOICE_FILE , g_sTextSizeKey, "")
		elseif lRow == 5 then '현재가터치이동
			Form.OpenPopup(G_SCREENCHOICE_FILE , g_sCurTouchKey, "")			
		elseif lRow == 8 then '자동로그아웃
			Form.OpenPopup(G_SCREENCHOICE_FILE , g_sAutoLogoutKey, "")
		elseif lRow == 9 then '온라인 동시접속			
			Cont0_Image9_OnClick() '20230508 KKM 온라인 동시접속 추가
		end if
	end if	
End Sub
