		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'20230509 KKM 온라인 동시접속 차단/허용
	if szTranID == "obcsb_efif_166r" then	
		Dim szPAndI
		szPAndI = DATAMANAGER.GetDataValue(0, "obcsb_efif_166r", "OutBlock1", "CNCC_CONN_INFR_YN" , 0)
		if szPAndI == "Y" then
			g_szPAndICheck = "Y"
			Cont0.Table0.SetCellString( 9, 1, "허용" ) 
			'0814 JJH START--------------------------------------------------------
			Cont0.Table1.SetCellString( 9, 1, "허용" ) 
		else'if szPAndI == "N" then
			g_szPAndICheck = "N"
			Cont0.Table0.SetCellString( 9, 1, "차단" ) 
			Cont0.Table1.SetCellString( 9, 1, "차단" ) 
			'0814 JJH END--------------------------------------------------------
		end if
		'SetConfigData(g_szPAndICheckKey, 9, 1)
	'20230612 허용/차단 후 재조회 
	elseif szTranID == "obcsb_efif_167a" then
		'DATAMANAGER.SetDataValue(0, "obcsb_efif_166r", "InBlock1", "ELFN_ID", 0 , g_szId)
		'DATAMANAGER.RequestTranData("obcsb_efif_166r")
		g_szPAndICheck = "N"
		Cont0.Table0.SetCellString( 9, 1, "차단" ) 		
		'0814 JJH START--------------------------------------------------------
		Cont0.Table1.SetCellString( 9, 1, "차단" ) 	
		'0814 JJH END--------------------------------------------------------
		Form.Toast(1, "온라인 동시접속이 차단되었습니다.", true)
	end if	
End Sub


