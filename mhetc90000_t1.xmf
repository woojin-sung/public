'0814 JJH 관심 동기화 해제 불가 조치
'============================================================================
Function f_CtlLocationMod(szCheck)
	
	if szCheck == "1" then
		
		Cont0.Table0.visible = false
		Cont0.Table0.height = 0
		Cont0.Table1.visible = true
		Cont0.btnInterestCloud.visible = false
		Cont0.Image7.visible = false
		
		Cont0.Label2.top = 226
		Cont0.Label3.top = 258
		Cont0.Label4.top = 482
		Cont0.Label5.top = 514
		
		Cont0.Image8.top = 270
		Cont0.Image9.top = 311
		Cont0.Image10.top = 353
		Cont0.Image11.top = 396
		Cont0.Image12.top = 438
		
		Cont0.btnBack3.visible = false
		Cont0.btnBack2.top = 386
		Cont0.btnBack1.top = 428
		
		Cont0.btnKeepLight0.visible = "1"
		Cont0.btnBackgroundRun0.visible = "1"
		Cont0.btnViewARS0.visible = "1"
		Cont0.btnKeepLight.visible = "0"
		Cont0.btnBackgroundRun.visible = "0"
		Cont0.btnViewARS.visible = "0"
		
		Cont0.Button0.top = 520
		Cont0.Button1.top = 562
		Cont0.Button2.top = 604
		Cont0.btnVersion.top = 646
	else
		Cont0.Table0.visible = true
		Cont0.Table1.visible = false
		
		Cont0.btnBack3.visible = true
	
		Cont0.btnKeepLight0.visible = "0"
		Cont0.btnBackgroundRun0.visible = "0"
		Cont0.btnViewARS0.visible = "0"
		Cont0.btnKeepLight.visible = "1"
		Cont0.btnBackgroundRun.visible = "1"
		Cont0.btnViewARS.visible = "1"
		
	end if	
	Cont0.SetScrollAutoSize()
end Function

