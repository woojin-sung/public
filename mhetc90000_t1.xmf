'============================================================================
' 환경설정초기화함수
'============================================================================
Function SetInitData()
	'앱실행시첫화면 - 종합화면("0")
	'공인인증서로그인시첫화면 - 전체계좌조회("0")
	'사이드종목변경버튼 - 오른쪽("0")
	'지수티커 - 사용하지않음(false)
	'스킨설정 - "white"
	'글자크기 - 32("0")
	'현재가터치이동 - 최근조회종목("0")
	'자동로그아웃 - 1시간("60")
	'화면자동꺼짐방지 - 사용(true)
	'관심종목동기화 - 사용("1")
	'온라인 동시접속 - 불가(false)
	
	Cont0.Table0.SetCellString( 1, 1, "종합화면" )
	'Cont0.Table0.SetCellString( 2, 1, "이체" )'20180515 HAMWG : 공인인증설정 삭제 
	Cont0.Table0.SetCellString( 2, 1, "오른쪽" )
'	Cont0.Table0.SetCellString( 4, 1, "미사용" )
'	Cont0.Table0.SetCellString( 4, 1, "화이트" )	20230426 HSZ 테마삭제(화이트 고정)
	Cont0.Table0.SetCellString( 4, 1, "보통" )
	Cont0.Table0.SetCellString( 5, 1, "최근조회종목" )		
	Cont0.Table0.SetCellString( 8, 1, "1시간" )
	Cont0.Table0.SetCellString( 9, 1, "차단" )  '20230508 KKM 온라인 동시접속 추가 
	
	'0814 JJH START--------------------------------------------------------
	Cont0.Table1.SetCellString( 1, 1, "종합화면" )
	Cont0.Table1.SetCellString( 2, 1, "오른쪽" )
	Cont0.Table1.SetCellString( 4, 1, "보통" )
	Cont0.Table1.SetCellString( 5, 1, "최근조회종목" )		
	Cont0.Table1.SetCellString( 8, 1, "1시간" )
	Cont0.Table1.SetCellString( 9, 1, "차단" )  '20230508 KKM 온라인 동시접속 추가 
	'END--------------------------------------------------------------------
	'20230509 KKM START : 스위치 버튼 변경
	'Cont0.Table0.SetCellString( 6, 1, "사용" ) '관심종목동기화
	'Cont0.Table0.SetCellString( 10, 1, "사용" )	 '화면자동꺼짐
	'Cont0.Table0.SetCellString( 11, 1, "미사용" ) '20180607 HAMWG : 백그라운드 앱종료 방지기능 추가	
	'Cont0.Table0.SetCellString( 12, 1, "거부" ) '20191202 YGH : 보이는 ARS설정 추가
	Cont0.btnInterestCloud.switchindex =  1  '관심종목동기화(사용)
	Cont0.btnKeepLight.switchindex =  1		'화면자동꺼짐(사용)
	Cont0.btnBackgroundRun.switchindex = 0   '백그라운드 앱종료 방지기능(미사용)
	Cont0.btnViewARS.switchindex = 0	     '보이는 ARS설정 추가(거부)	
	
	Cont0.btnKeepLight0.switchindex =  1		'화면자동꺼짐(사용)
	Cont0.btnBackgroundRun0.switchindex = 0   '백그라운드 앱종료 방지기능(미사용)
	Cont0.btnViewARS0.switchindex = 0	     '보이는 ARS설정 추가(거부)	
	'20230509 KKM  END 
	
	SetFgColor(1, 1)
	'SetFgColor(2, 1)'20180515 HAMWG : 공인인증설정 삭제 
	SetFgColor(2, 1)
	SetFgColor(4, 1)	
	SetFgColor(5, 1)
	SetFgColor(8, 1)
	SetFgColor(9, 1)  '20230508 KKM 온라인 동시접속 추가
	
	'20230509 KKM START : 스위치 버튼 변경
	'SetFgColor(6, 1) '관심종목동기화
	'SetFgColor(10, 1) '화면자동꺼짐
	'SetFgColor(11, 1) '20180607 HAMWG : 백그라운드 앱종료 방지기능 추가
	'SetFgColor(12, 1) '20191202 YGH : 보이는 ARS설정 추가
	'20230509 KKM  END 
	
	Form.SetEnvData(1, g_sScreenKey, "0") 		'SetConfigData(g_sScreenKey, 1, 1)
	'20180515 HAMWG : 공인인증설정 삭제 
	'Form.SetEnvData(1, g_sCertScreenKey, "0") 	'SetConfigData(g_sCertScreenKey, 2, 1) 
	Form.SetEnvData(1, g_sSideChangeKey, "0")	'SetConfigData(g_sSideChangeKey, 3, 1)
'	SetConfigData(g_sTickerKey, 4, 1)
'	20230426 HSZ 테마설정 삭제
'	Form.SetEnvData(1, g_sThemeKey, "white")		'SetConfigData(g_sThemeKey, 5, 1)
	Form.SetEnvData(1, g_sTextSizeKey, "0")		'SetConfigData(g_sTextSizeKey, 6, 1)
	Form.SetEnvData(1, g_sCurTouchKey, "0")		'SetConfigData(g_sCurTouchKey, 7, 1)
	Form.SetEnvData(1, g_sAutoLogoutKey, "60")	'SetConfigData(g_sAutoLogoutKey, 9, 1)	
	Form.SetEnvData(1, g_szPAndICheckKey, "N")	'20230508 KKM 온라인 동시접속 추가(불가)
	
	Form.SetEnvData(1, g_sKeepLightKey, 1)		'SetConfigData(g_sKeepLightKey, 10, 1)
	Form.SetEnvData(1, g_sInterestCloudKey, "1")	'SetConfigData(g_sInterestCloudKey, 12, 1)
	
	'20180607 HAMWG START: 백그라운드 앱종료 방지기능 추가
	if Form.GetSharedData("&OS_TYPE", False ) <> "2" then
		Form.SetEnvData(1, g_sBackgroundRunKey, False)
		Form.SendMessageToMain("BACKGROUND_RUN", "", "")
	end if
	'20180607 HAMWG END
	'20191202  YGH START
	Form.SetEnvData(1, g_sViewARSKey, "0")
	'20191202  YGH END
End Function 

'============================================================================
' 환경설정값리턴함수
'============================================================================
Function GetConfigData(sKey, nRow, nCol)
	Dim sValue
	sValue = Form.GetEnvData(sKey)
	
	if sValue == null or Trim(sValue) == "" then
'		if sKey == g_sThemeKey then
'			sValue = "white"
'		elseif sKey == g_sTickerKey then
'			sValue = false '기본값 false
		if sKey == g_sAutoLogoutKey then
			sValue = "60" '기본값 60
		elseif sKey == g_sInterestCloudKey then 
			sValue = "1" '기본값 1
		elseif sKey == g_sKeepLightKey then
			sValue = true '기본값 true
		else
			sValue = "0" '기본값 0
		end if
	end if
	
	if sKey == g_sScreenKey then
		if sValue == "0" then
			sValue = "종합화면"
		elseif sValue == "1" then
			sValue = "관심종목"
		elseif sValue == "2" then
			sValue = "주식현재가"
		elseif sValue == "3" then
			sValue = "차트"
		elseif sValue == "4" then
			sValue = "선물옵션현재가"
		else
			sValue = "뉴스"
		end if
		
	'20180515 HAMWG : 공인인증설정 삭제 
'	elseif sKey == g_sCertScreenKey then
'		if sValue == "0" then
'			sValue = "이체"
'		elseif sValue == "1" then
'			sValue = "전체계좌조회"
'		else
'			sValue = "입출금내역"
'		end if

	elseif sKey == g_sSideChangeKey then
		if sValue == "0" then
			sValue = "오른쪽"
		elseif sValue == "1" then
			sValue = "왼쪽"
		else
			sValue = "미사용"
		end if

'PSM3 START => 2016.03.08 환경설정에서 사이드 종목변경 버튼 변경후 바로 적용되도록 처리함. 
		Form.SendMessageToMain("CONFIG_CHANGE", "", "")
'PSM3 END		
'	elseif sKey == g_sThemeKey then		20230426 HSZ 테마설정 삭제
'		if sValue == "white" then
'			sValue = "화이트"
'		else
'			sValue = "블랙"
'		end if
	elseif sKey == g_sTextSizeKey then
		'20230508 KKM START : 글자크기 명칭변경 
		if sValue == "-2" then
			'sValue = "28"
			sValue = "작게"	   
		elseif sValue == "-1" then
			'sValue = "30"
			sValue = "조금 작게"	   
		elseif sValue == "0" then
			'sValue = "32"
			sValue = "보통"
		elseif sValue == "1" then
			'sValue = "34"
			sValue = "조금 크게"
		else
			'sValue = "36"
			sValue = "크게"
		end if
		'20230508 KKM END
	elseif sKey == g_sCurTouchKey then
		if sValue == "0" then
			sValue = "최근조회종목"
		elseif sValue == "1" then
			sValue = "관심종목"
		elseif sValue == "2" then
			sValue = "watching 등록종목"
		else
			sValue = "업종조회"
		end if
	elseif sKey == g_sAutoLogoutKey then
		if sValue == "10" then
			sValue = "10분"
		elseif sValue == "30" then
			sValue = "30분"
		elseif sValue == "60" then
			sValue = "1시간"
		elseif sValue == "120" then
			sValue = "2시간"
		elseif sValue == "180" then
			sValue = "3시간"
		'20180910_01 KBC START : 자동로그아웃시간 확대 6시간->10시간			
		elseif sValue == "360" then
			sValue = "6시간"
		else
			sValue = "10시간" 
		'20180910_01 KBC END
		end if
'	elseif sKey == g_sTickerKey then
'		if sValue == true or sValue == "1" or sValue == 1 then
'			sValue = "사용"
'		else
'			sValue = "미사용"
'		end if
'20230517 KKM START 스위치 버튼으로 수정
	'화면 자동꺼짐 방지
	elseif sKey == g_sKeepLightKey then 
		if sValue == true or sValue == "1" or sValue == 1 then
			'sValue = "사용"
			Cont0.btnKeepLight.switchindex = 1
			'0814 JJH START--------------------------------------------------------
			Cont0.btnKeepLight0.switchindex = 1
		else
			'sValue = "미사용"
			Cont0.btnKeepLight.switchindex = 0
			Cont0.btnKeepLight0.switchindex = 0
			'0814 JJH END--------------------------------------------------------
		end if
		Exit Function		
	'관심종목 동기화
	elseif sKey == g_sInterestCloudKey then 
		if sValue == true or sValue == "1" or sValue == 1 then
			'sValue = "사용"
			Cont0.btnInterestCloud.switchindex = 1
			'0814 JJH START--------------------------------------------------------
			f_CtlLocationMod("1")
		else
			'sValue = "미사용"
			Cont0.btnInterestCloud.switchindex = 0
			
			f_CtlLocationMod("0")
			'0814 JJH END--------------------------------------------------------
		end if
		Exit Function
	'20180607 HAMWG START : 백그라운드 앱종료 방지기능 추가
	elseif sKey == g_sBackgroundRunKey then
		if sValue == true or sValue == "1" or sValue == 1 then
			sValue = "사용"
			Cont0.btnBackgroundRun.switchindex = 1 
			'0814 JJH START--------------------------------------------------------
			Cont0.btnBackgroundRun0.switchindex = 1 
		else
			sValue = "미사용"
			Cont0.btnBackgroundRun.switchindex = 0 
			Cont0.btnBackgroundRun0.switchindex = 0 
			'0814 JJH END--------------------------------------------------------
		end if
		'if nRow == 11 and Form.GetSharedData("&OS_TYPE", False ) == "2" then 
		if Form.GetSharedData("&OS_TYPE", False ) == "2" then 
			Cont0.Table0.SetCellFgColor( 13, 0, "17" )
			Cont0.Table0.SetCellFgColor( 14, 0, "17" )
			Cont0.Table0.SetCellFgColor( 11, 1, "17" )
			'0814 JJH START--------------------------------------------------------
			Cont0.Table1.SetCellFgColor( 13, 0, "17" )
			Cont0.Table1.SetCellFgColor( 14, 0, "17" )
			Cont0.Table1.SetCellFgColor( 11, 1, "17" )
			'0814 JJH END--------------------------------------------------------
		end if
	'20180607 HAMWG END	
	'20191202 YGH START : 보이는 ARS설정 추가
	elseif sKey == g_sViewARSKey then
		if sValue == true or sValue == "1" or sValue == 1 then
			sValue = "허용"
			Cont0.btnViewARS.switchindex = 1 
			'0814 JJH START--------------------------------------------------------
			Cont0.btnViewARS0.switchindex = 1 
		else
			sValue = "거부"
			Cont0.btnViewARS.switchindex = 0 
			Cont0.btnViewARS0.switchindex = 0 
			'0814 JJH END--------------------------------------------------------
		end if
	'20191202 YGH END
		'Exit Function
'20230517 KKM END

	'20230508 KKM START : 온라인 동시접속 추가
	elseif sKey == g_szPAndICheckKey then
		if g_szPAndICheck == "Y" then
			sValue = "허용"
		else
			sValue = "차단"
		end if
	end if
	'20230508 KKM END		
	
	Cont0.Table0.SetCellString( nRow, nCol, sValue )
	'0814 JJH START--------------------------------------------------------
	Cont0.Table1.SetCellString( nRow, nCol, sValue )
	'20230517 KKM START 스위치 버튼을 변경
	if sKey <> g_sBackgroundRunKey and sKey <> g_sViewARSKey then
		Cont0.Table0.SetCellFgColor( nRow, nCol, "12" )
		Cont0.Table1.SetCellFgColor( nRow, nCol, "12" )
	'0814 JJH END--------------------------------------------------------
	'if sValue == "미사용" or sValue == "거부"  or sValue == "차단" then '20191202 보이는 ARS이용동의 거부 추가 '20230508 KKM 온라인 동시접속 차단추가
		'Cont0.Table0.SetCellFgColor( nRow, nCol, "4" )
	'else
		'Cont0.Table0.SetCellFgColor( nRow, nCol, "128" )
	end if
	'20230517 KKM END 	
	
End Function 

'============================================================================
' 환경설정값세팅함수
'============================================================================
Function SetConfigData(sKey, nRow, nCol)
	Dim sValue
	sValue = Cont0.Table0.GetCellString( nRow, nCol )

	'20230517 KKM START 스위치 버튼을 변경
	if sKey == g_sInterestCloudKey then ' 관심종목 동기화	
		Form.SetEnvData(1, sKey, Cont0.btnInterestCloud.switchindex)

	elseif sKey == g_sKeepLightKey then '화면 자동꺼짐 방지
		'0814 JJH START--------------------------------------------------------
		if Cont0.Table0.visible == true or Cont0.Table0.visible == "1" then		'스위치 top값을 설정할 수 없어서 두개로 나눔
			Form.SetEnvData(0, sKey, Cont0.btnKeepLight.switchindex)
		else
			Form.SetEnvData(0, sKey, Cont0.btnKeepLight0.switchindex)
		end if
		'0814 JJH END--------------------------------------------------------
	'20180607 HAMWG START : 백그라운드 앱종료 방지기능 추가
	elseif sKey == g_sBackgroundRunKey then
		if sValue == "사용" then
			sValue = false
		else
			sValue = true
		end if
		
		Form.SetEnvData(1, sKey, sValue)
		Form.SendMessageToMain("BACKGROUND_RUN", "", "")
	'20180607 HAMWG END

	'20191202 YGH START : 보이는 ARS 설정 추가 (스위치 버튼) 
	elseif sKey == g_sViewARSKey then
		if sValue == "허용" then
			'거부로 바뀌는게아니라 메시지팝업만 띄운다
			ShowAlert("알림", "서비스 이용동의 철회를 원하시면\r\n고객지원센터(1588-3400)로 연락바랍니다.")
		else
			Form.requestCommand("CALLGATE_POPUP")
			Form.SendReturnToParent( "CALLGATE_POPUP" , "0" )
		end if
	'20191202 YGH START : 보이는 ARS 설정 추가
	end if
	'20230517 KKM END 
End Function 

'============================================================================
' 글자색상함수
'============================================================================
Function SetFgColor(nRow, nCol)
	Dim sValue
	sValue = Cont0.Table0.GetCellString( nRow, nCol )
	
	if sValue == "미사용" or sValue == "거부" or sValue == "차단" then '20191202 보이는 ARS서비스이용동의 "거부"추가 '20230508 KKM 온라인 동시접속 차단추가
		'Cont0.Table0.SetCellFgColor( nRow, nCol, "4" )
	else
		'Cont0.Table0.SetCellFgColor( nRow, nCol, "128" )
		Cont0.Table0.SetCellFgColor( nRow, nCol, "12" )
		'0814 JJH START--------------------------------------------------------
		Cont0.Table1.SetCellFgColor( nRow, nCol, "12" ) 
		'0814 JJH END--------------------------------------------------------
	end if
	
	'20180607 HAMWG START : 백그라운드 앱종료 방지기능 추가 (스위치 버튼) 
	if nRow == 11 and Form.GetSharedData("&OS_TYPE", False ) == "2" then
		Cont0.Table0.SetCellFgColor( 13, 0, "17" )
		Cont0.Table0.SetCellFgColor( 14, 0, "17" )
		Cont0.Table0.SetCellFgColor( 11, 1, "17" )
		
		'0814 JJH START--------------------------------------------------------
		Cont0.Table1.SetCellFgColor( 13, 0, "17" )
		Cont0.Table1.SetCellFgColor( 14, 0, "17" )
		Cont0.Table1.SetCellFgColor( 11, 1, "17" )
		'0814 JJH END--------------------------------------------------------
	end if
	'20180607 HAMWG END
End Function 

