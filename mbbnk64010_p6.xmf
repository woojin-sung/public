	<SCRIPT_INFO _len="2245" _ulen="2117" >

'============================================================================
' 화 면 명 : 외화이체 이체한도알림
'============================================================================

Dim g_szSelectButton
Dim g_szReturnKey

Dim g_szCurrencyCode	'통화코드
Dim g_szTotalLimit	'잔여한도
Dim g_szOneLimit		'1회한도
Dim g_szDayLimit		'1일한도


'============================================================================
Sub Form_OnFormInit()

	g_szCurrencyCode = ""
	g_szTotalLimit = ""
	g_szOneLimit = ""
	g_szDayLimit = ""
	
	szData = Form.GetOpenLinkData()

	If szData <> "" And szData <> Null Then
	
		'잔여한도★1회한도★1일한도★통화코드
		tOpenData = Split(szData, "★")
		
		g_szTotalLimit   = tOpenData[0]
		g_szOneLimit     = tOpenData[1]
		g_szDayLimit     = tOpenData[2]
		g_szCurrencyCode = tOpenData[3]
		
		
		if g_szCurrencyCode = "JPY" then
			g_szDecimal = 0
		else
			g_szDecimal = 2
		end if
		
		sMask = "0,0,,,1,,"..g_szDecimal..",1,0,0,0"
		sMask = "0,0,," .. " " ..g_szCurrencyCode .. ",1,,"..g_szDecimal..",1,0,0,0"
		
		'잔여한도 마스킹
		cont.lblTotalLimit.caption = g_szTotalLimit
'		sMask = "0,0,,,1,,"..g_szDecimal..",1,0,0,0"
'		sMask = "0,0,," .. " " ..g_szCurrencyCode .. ",1,,"..g_szDecimal..",1,0,0,0"
		cont.lblTotalLimit.mask = sMask
		
		'1회한도 마스킹
		cont.lblOneLimit.caption = g_szOneLimit
'		sMask = "0,0,,,1,,"..g_szDecimal..",1,0,0,0"
'		sMask = "0,0,," .. " " ..g_szCurrencyCode .. ",1,,"..g_szDecimal..",1,0,0,0"
		cont.lblOneLimit.mask = sMask
		
		'1일한도 마스킹
		cont.lblDayLimit.caption = g_szDayLimit
'		sMask = "0,0,,,1,,"..g_szDecimal..",1,0,0,0"
'		sMask = "0,0,," .. " " ..g_szCurrencyCode .. ",1,,"..g_szDecimal..",1,0,0,0"
		cont.lblDayLimit.mask = sMask
		
	end if
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbbnk64010_p6" , "N")
End Sub

'============================================================================
Sub cont_btnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

