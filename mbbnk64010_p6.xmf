				<LABEL name="Label3" caption="1회 한도" ly_vert="15,131,80,20,1" />
				<LABEL name="Label4" caption="1일 한도" ly_vert="15,152,80,20,1" />
				<LABEL name="lblTotalLimit" fontstyle="01" mask="0,0,,,0,,2,1,1,0,0" halign="2" autofontsize="1" ly_vert="105,110,190,20,1" />
