			<CONTROL_INFO>
				<IMAGE name="imgHeader" imgpath="popup_bg_2.9" ly_vert="0,0,311,190,1" />
				<BUTTON name="btnOK" caption="확인" fontsize="2" fontstyle="01" btnimage="btn_22.9" ly_vert="0,190,311,50,1" />
				<LABEL name="lblTitle" fontsize="3" fontstyle="01" caption="알림" halign="1" ly_vert="0,6,311,40,1" />
				<LABEL name="Label0" caption="입력하신 금액이 이체한도를 초과합니다." halign="1" multiline="1" ly_vert="10,50,291,20,1" />
				<LABEL name="Label1" caption="확인 후 다시 입력해주세요." halign="1" multiline="1" ly_vert="10,70,291,20,1" />
