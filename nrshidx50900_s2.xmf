<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="50900" scrname="TAX365-절세투자Sub2" version="2" writer="노일호" />
	<FORM_INFO name="Form" ly_vert="0,0,343,412,1" />
	<CONTROL_INFO>
		<IMAGE name="imgBg" imgpath="bg_listbox.9.png" ly_vert="0,0,343,412,1" />
		<IMAGE name="imgPoint" autosize="1" imgpath="tax365_roundbg.png" ly_vert="132,38,80,28,1" />
		<LABEL name="lblPoint" fontsize="-2" fontstyle="01" caption="Point 2" halign="1" ly_vert="139,42,67,20,1" />
		<LABEL name="lblTitle" fontsize="8" fontstyle="01" caption="CFD 절세 포인트" halign="1" ly_vert="27,79,288,32,1" />
		<LABEL name="lblDesc" caption="똑똑한 투자자라면 절세 투자도 한수 위?" halign="1" ly_vert="13,113,317,22,1" />
		<IMAGE name="imgDesc" autosize="1" ly_vert="106,144,130,130,1" />
		<LABEL name="lblTag" halign="1" multiline="1" ly_vert="20,283,305,60,1" />
		<LABEL name="lblMore" fontsize="-2" fontstyle="10" caption="더 알아보기" halign="1" click="1" ly_vert="118,344,108,30,1" />
		<LABEL name="lblForClick" click="1" ly_vert="0,0,343,412,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1796" _ulen="1646" >

'***************************************************
'               전역 변수
'***************************************************
Dim g_szTitle

'***************************************************
'               공용 함수
'***************************************************
'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	call Init_Control("1")    ' Personal Function 호출시 call 붙여준다.
End Sub

'***************************************************
'               개별 함수
'***************************************************
'===============================================
' Init_Control(szCbn) 
'===============================================
Function Init_Control(szCbn) --> 리턴과 상관없이 Function으로 정의한다.
	'텍스트
	lblTag.caption = "#똑똑한 절세수단\n#전문투자자들이 선택한 절세 효과"

	'폼 배경색 지정
	Form.bgcolor = "320"
	
	' 텍스트색상
	lblPoint.fgcolor = "416"
	lblTitle.fgcolor = "334"
	lblDesc.fgcolor = "334"
	lblTag.fgcolor = "333"
	lblMore.fgcolor = "334"
	
	'이미지경로
	imgDesc.setMaintainingRatio("1")
	imgDesc.imgpath = "tax365_icon_cfd.png"
End Function

'============================================================================
Sub lblForClick_OnClick(sParam)
	g_serverMode = Form.GetSharedData("&SERVER_MODE", false)
	If g_serverMode == "1" Then	'개발기
		sURL = "https://testhome.imeritz.com/bbs/mwCtn1.do?bbsId=MoWbTax&bbsCnttTurnNo=4"
	else
		sURL = "https://home.imeritz.com/bbs/mwCtn1.do?bbsId=MoWbTax&bbsCnttTurnNo=4"
	end if
	
	Form.SetSharedData("TAX365_SUB", "2")
	Form.OpenPopup("nrshidx50900_s4", sURL, "")
End Sub

	</SCRIPT_INFO>
</ROOT>