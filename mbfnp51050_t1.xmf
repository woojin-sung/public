'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obcsb_acad_102r" then	
		if DATAMANAGER.IsMoreNextData("obcsb_acad_102r") then
			DATAMANAGER.RequestNextData("obcsb_acad_102r")
		else
	
		n102Cnt 		=	contList.Grid0.rowcount
		szDataCnt	=	DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")

		If szDataCnt = 0 then
			contList.lblNoData.visible = 1
			contList.Grid0.visible = 0
			contList.contInfo.visible = 1
			contList.contInfo.top = 300
			Exit Sub
		else
			contList.lblNoData.visible = 0
			contList.Grid0.visible = 1
			contList.contInfo.visible = 1
		End if
		
		'date = 1건 height = 150
		for	i=0 to n102Cnt-1
			
			'----- 종목명 -----
			contList.Grid0.setCellMaxLineCount("bd_cell5", 2)	''컨트롤 라인 제한 함수
			'----- 종목명 -----
		
			contList.Grid0.SetCellData("bd_cell6", i, "계좌번호")
			contList.Grid0.SetCellData("bd_cell7", i, "통보처")
		
			contList.Grid0.SetCellData("bd_cell11", i, "변경하기")

			'계좌번호
			szAccNo = Left(contList.Grid0.GetCellData("bd_cell17", i), 4) & "-" & Right(contList.Grid0.GetCellData("bd_cell17", i), 4) & "-" & contList.Grid0.GetCellData("bd_cell27", i)
			
			contList.Grid0.SetCellData("bd_cell14", i, szAccNo)	
			
			
			'통보처
			szINAG_TYPE_CODE = contList.Grid0.GetCellData("bd_cell30", i)	
			contList.Grid0.GetCellData("bd_cell29", i)

			If szINAG_TYPE_CODE == "51" then 	'수신거부
				contList.Grid0.SetCellData("bd_cell15", i, "온라인(직접)조회")
				
			ElseIf szINAG_TYPE_CODE == "31" then 	'알림톡
				contList.Grid0.SetCellData("bd_cell15", i, "알림톡(SMS)")
				
			ElseIf szINAG_TYPE_CODE == "21" then 	'E-mail
				contList.Grid0.SetCellData("bd_cell15", i, "이메일")
				
			elseIf szINAG_TYPE_CODE == "01" then 		'자택
				contList.Grid0.SetCellData("bd_cell15", i, "자택")
				
			ElseIf szINAG_TYPE_CODE == "02" then 	'직장
				contList.Grid0.SetCellData("bd_cell15", i, "직장")
				
			End If
			
		next
		
		'그리드랑 컨테이너 데이터 건수에 맞게 높이 조절
		contList.Grid0.height = 150 * szDataCnt	
		contList.contInfo.top = (150 * szDataCnt) + 15
		
		
		contList.SetScrollAutoSize()
		end if			
	elseif szTranID = "obcsb_acad_103a" then		
		Form.MsgBox("안내", "통보처 변경이 완료되었습니다.", "RELOAD", 0)
	end if
End Sub

'============================================================================
Sub contList_Grid0_OnClickUp(lRow, szCellID)
	g_szACNO					= contList.Grid0.GetCellData("bd_cell17", lRow)
	g_szASNO					= contList.Grid0.GetCellData("bd_cell27", lRow)
	g_szRMND_SRNO				= contList.Grid0.GetCellData("bd_cell28", lRow)
	g_szINAG_TYPE_CODE		= contList.Grid0.GetCellData("bd_cell30", lRow)
	g_szCSNO 				= contList.Grid0.GetCellData("bd_cell33", lRow)
	g_szCUST_TYPE_CODE		= contList.Grid0.GetCellData("bd_cell34", lRow)
	g_szMGRI_RPRT_INAG_SRNO	= contList.Grid0.GetCellData("bd_cell31", lRow)
	'g_szMGRI_INFR_YN			= contList.Grid0.GetCellData("bd_cell35", lRow)
	g_szINAG_TYPE_NAME		= contList.Grid0.GetCellData("bd_cell15", lRow)
	
	
	
	if	szCellID	=	"bd_cell11"	then	'변경하기
		Dim szSendData
		szSendData = g_szACNO  & "★" &  g_szASNO  & "★" &  g_szRMND_SRNO  & "★" &  g_szINAG_TYPE_CODE	
		Form.openPopupAnimation("mbfnp51050_p1", szSendData, "", "2")
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName = "mbfnp51050_p1" then
		if sRet <> "" then	
			tData = Split(sRet, "★")
			
			g_szACNO 		= tData[0]
			g_szASNO 		= tData[1]
			g_szRMND_SRNO		= tData[2]
			g_InagTypeCode 	= tData[3]	'선택한유형코드
			g_AllFundYn 		= tData[4]	'모든펀드일괄적용여부
		

			If g_InagTypeCode == "51" then 	'수신거부
				g_szINAG_TYPE_NAME = "온라인(직접)조회"
				
			ElseIf g_InagTypeCode == "31" then 	'알림톡
				g_szINAG_TYPE_NAME = "알림톡(SMS)"
				
			ElseIf g_InagTypeCode == "21" then 	'E-mail
				g_szINAG_TYPE_NAME = "이메일"
				
			elseIf g_InagTypeCode == "01" then 		'자택
				g_szINAG_TYPE_NAME = "자택"
				
			ElseIf g_InagTypeCode == "02" then 	'직장
				g_szINAG_TYPE_NAME = "직장"
				
			End If
			
			if g_InagTypeCode = "51" then
				g_szMGRI_INFR_YN = "N"
			else
				g_szMGRI_INFR_YN = "Y"
			end if
			
			Dim sSendData
			sSendData = g_szACNO&g_szASNO&"☆"&"0"
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")	
		end if
		
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	Elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			tData = Split(sRet, "★")
	
			if UBOUND(tData) > 0 then
				Form.SetCtlProp("#edtPassword", "pwdlen", tData(1))
				Form.SetCtlProp("#edtPassword", "caption", tData(0))
				
				g_szPwd = tData(0)
		

				'통보처 변경
				FundAddrProc()
				
'				DATAMANAGER.RequestTranData("obcsb_acad_103a")
			end if
		end if
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szErrCode = "5820" then	''5820 : 조회할 내역(자료)이 없습니다.
		contList.lblNoData.visible = 1
		contList.Grid0.visible = 0
		contList.contInfo.visible = 1
		contList.contInfo.top = 300
	else
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		'Form.ShowAlert("알림", szTranID .. " : " .. szErrMsg & "(" & szSubMsg & ")")
		Form.ShowAlert("알림", szSubMsg)
		
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName = "RELOAD" then	
		'통보처 재조회
		DATAMANAGER.RequestTranData("obcsb_acad_102r")
	end if
End Sub

