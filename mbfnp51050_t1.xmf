	<SCRIPT_INFO _len="14098" _ulen="13458" >

Dim g_szACNO
Dim g_szASNO
Dim g_szPwd

Dim g_szCSNO
Dim g_szRMND_SRNO
Dim g_szINAG_TYPE_CODE
Dim g_szINAG_TYPE_NAME
Dim g_szCUST_TYPE_CODE
Dim g_szMGRI_RPRT_INAG_SRNO
Dim g_szMGRI_INFR_YN

Dim g_AllFundYn	'모든펀드일괄적용

'============================================================================
Sub Form_OnFormInit()
	contList.contInfo.lblChangeAddr.caption = "연락처변경 바로가기 >"
	contList.contInfo.lblChangeAddr.fgcolor = "67"
	
	g_AllFundYn = "N"
	
	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	contList.Grid0.setUseCardView(true, 15, "input_03_n.9")
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		contList.setScrollBarVisible("2")
	end if
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName == "INIT_SCREEN" And sParam <> "" And sParam <> null Then

		g_szAcno = Left(sParam, 8)
		g_szAsno = Right(sParam, 2)

		DATAMANAGER.RequestTranData("obcsb_acad_102r")
	End If
End Sub

'============================================================================
Sub contList_contInfo_lblChangeAddr_OnClick()
	Dim sSendData, sTabIdx
	sSendData = ""
	sTabIdx = "1"

	Form.OpenFramePopup("mbonl81000" , sSendData , "")
End Sub


'============================================================================
Sub FundAddrProc()

	if g_AllFundYn == "Y" then	'모든펀드일괄적용

		for 	i = 0	to	contList.Grid0.rowcount - 1				
			szACNO					= contList.Grid0.GetCellData("bd_cell17", i)
			szASNO					= contList.Grid0.GetCellData("bd_cell27", i)
			szRMND_SRNO				= contList.Grid0.GetCellData("bd_cell28", i)
			szCSNO 					= contList.Grid0.GetCellData("bd_cell33", i)
			g_szCUST_TYPE_CODE		= contList.Grid0.GetCellData("bd_cell34", i)
			g_szMGRI_RPRT_INAG_SRNO	= contList.Grid0.GetCellData("bd_cell31", i)
			'g_szMGRI_INFR_YN			= contList.Grid0.GetCellData("bd_cell35", i)
		
			if g_InagTypeCode = "51" then
				g_szMGRI_INFR_YN = "N"
			else
				g_szMGRI_INFR_YN = "Y"
			end if 
		
			DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "PROS_CLS_CODE"			, 0, "U" )
			DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "ACNO"					, 0, szACNO )
			DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "ASNO"					, 0, szASNO )
			DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "RMND_SRNO"				, 0, szRMND_SRNO )
			DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "MGRI_RPRT_INAG_TYPE_CODE"	, 0, g_InagTypeCode )	'선택한유형코드				
			DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "CSNO"					, 0, szCSNO )
			DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "CONT_CLS_CODE"			, 0, "4" )
			DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "MGRI_RPRT_INAG_SRNO"		, 0, g_szMGRI_RPRT_INAG_SRNO )
			DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "MGRI_INFR_YN"			, 0, g_szMGRI_INFR_YN )
			DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "CUST_TYPE_CODE"			, 0, g_szCUST_TYPE_CODE )
			DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "INAG_TYPE_NAME"			, 0, g_szINAG_TYPE_NAME )	'선택한유형코드명
			DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "PWD"					, 0, g_szPwd)	'비밀번호		
			
			
			DATAMANAGER.RequestTranData("obcsb_acad_103a")
		next
	
	else
	
		DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "PROS_CLS_CODE"			, 0, "U" )
		DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "ACNO"					, 0, g_szACNO )
		DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "ASNO"					, 0, g_szASNO )
		DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "RMND_SRNO"				, 0, g_szRMND_SRNO )
		DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "MGRI_RPRT_INAG_TYPE_CODE"	, 0, g_InagTypeCode )			
		DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "CSNO"					, 0, g_szCSNO )
		DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "CONT_CLS_CODE"			, 0, "4" )
		DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "MGRI_RPRT_INAG_SRNO"		, 0, g_szMGRI_RPRT_INAG_SRNO )
		DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "MGRI_INFR_YN"			, 0, g_szMGRI_INFR_YN )
		DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "CUST_TYPE_CODE"			, 0, g_szCUST_TYPE_CODE )
		DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "INAG_TYPE_NAME"			, 0, g_szINAG_TYPE_NAME )
		DATAMANAGER.SetDataValue(0, "obcsb_acad_103a", "InBlock1", "PWD"					, 0, g_szPwd)	'비밀번호
		
		
		DATAMANAGER.RequestTranData("obcsb_acad_103a")
		
	end if

End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obcsb_acad_102r" then	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, g_szAcno )	'계좌번호	
		
