	<SCRIPT_INFO _len="10192" _ulen="9800" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 탭_호가
' 02. 화면설명 : 주식현재가 호가탭화면
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sCode
Dim g_sNatCd
Dim g_sToggle
Dim g_rtChk
Dim g_szChrtType

g_sToggle = "0"
g_szChrtType = "D" '일

'============================================================================
Sub Form_OnFormInitBefore()

	ChartEx0.SetLoadChart("foreignstock")
	ChartEx0.SetMarketCategory("7")
	g_szToday = Form.GetSharedData("&HOST_DATE", 0 )
End Sub

'[[ Form Init ]]
'============================================================================
Sub Form_OnFormInit()
	contHoga.Table0.visible = false
	contHoga.Table1.visible = false
	contHoga.Table2.visible = false
End Sub

'[[ 트리거 이벤트 ]]
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INIT_CODE" then
		
		g_sCode = sParam
		PeriodSet(g_szChrtType)
	
		'국가 구분값 가져오기(USA, HKG, JPY CHN)
		g_sNatCd = Form.GetItemCodeInfo(g_sCode, "ovsnation")
		
		if g_sNatCd == "HKG" then
			SetTableImgVisible("0") '상하한가 없는 테이블 visible
			
		elseif g_sNatCd == "USA" or g_sNatCd == "CHN" or g_sNatCd == "JPY" or g_sNatCd == "VND" then
			SetTableImgVisible("1") '상하한가 있는 테이블 visible
		end if
		contHoga.HogaTbl.SetCellClear()	
		
		DATAMANAGER.RequestTranData( "ohhts_6000_001r" )
		DATAMANAGER.RequestTranData( "ohhts_6000_002r" )
		DATAMANAGER.RequestTranData( "ohhts_6000_003r" )
		DATAMANAGER.RequestTranData( "ohhts_5041_001r" )
		
	end if
end Sub


'[[ DATAMANAGER 조회 BEFORE ]]
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sTemp, sExid, sCode
	
	DATAMANAGER.CancelRealData("ohhts_exst_cntg")
	DATAMANAGER.CancelRealData("ohhts_exst_aspr")
		
	sTemp = split(g_sCode, "@")
	sExid = sTemp[0] '시장구분
	sCode = sTemp[1] '종목코드 
	g_rtChk = Form.GetSharedData( "REALTIME_"..sExid, false )
	
	if szTranID == "ohhts_6000_001r" then
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCode)
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sExid)
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk) '실시간구분코드
		
	elseif szTranID == "ohhts_6000_002r" then
		DATAMANAGER.SetDataValue( false, "ohhts_6000_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, "ohhts_6000_002r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCode )
