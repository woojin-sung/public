'============================================================================
' 01. 화 면 명 : OTP관리_사용등록
' 02. 화면설명 : OTP관리_사용등록
' 03. 작    성 : 2016. 02. 25. 유창재
' 04. 수	   정 : 2016. 12. 06. 윤유정 :  아이폰 조회 오류 수정
'									타기관 스마트OTP 사용등록 후 일회용PIN 탭으로 이동 v0001
'              : 2016.01.05. 김유경 : 법인 OTP 해지시 통보처로 추가인증 하도록 수정 v0002
'              : 2017.01.17  김동구 : OTP등록/해지시 전문수신조회중 오류 개선(타이머 추가) v0003
' 2020.09.23 : 정민영 : v0004 : [T2008250015] 메모리취약점 보완
'            : 프로세스 오류 수정
' 2020.11.13 : 정민영 : v0005 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obacp_opop_064r,obcsb_oimf_124a,140c,141a,143a,160r IO 변경분 반영
' 2020.12.03 : v006 : T2011030015 : 금결원 OTP 개선
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szList			'계좌번호와 비밀번호
Dim g_szSTTN_NO		'요청시작번호, 전문인련번호, 기준일자
Dim g_szSRNO
Dim g_szSTND_DATE
Dim g_nGrdCount		'TR OUTPUT 수
Dim g_nNextCount		'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_szPassWord
Dim g_nClickIndex
Dim g_Flag			'v0001
Dim g_plain_rm  		'v0004 메모리평문적용여부
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetFirst() : 조회 TR 초기 세팅 전송
'============================================================================
Function SetFirst()
		
		edtSTNDDATE.caption = ""
		edtotp.caption = ""
		
		'v0004 기조회내역 초기화
		grd0.SetClear()
		
		edtSTTNNO.caption = "001"
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_160r", "InBlock1", "APRV_YN" , 0 , "N")
		
		DATAMANAGER.RequestTranData("obcsb_oimf_160r")
		
'		Call Query()
		
End Function
'============================================================================
' SetOTP() : OTP 등록/해지 처리
'============================================================================
Function SetOTP(nIndex)
	
	if grd0.GetCellData( "bd_cell5" , nIndex) == "OTP등록" then
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c", "InBlock1", "REG_CLCD", 0 , "1")
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c", "InBlock1", "APRV_YN" , 0 , "N")
		DATAMANAGER.RequestTranData( "obcsb_oimf_140c" )
	elseif grd0.GetCellData( "bd_cell5" , nIndex) == "OTP교체" then
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c", "InBlock1", "REG_CLCD", 0 , "5")
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c", "InBlock1", "APRV_YN" , 0 , "N")
		DATAMANAGER.RequestTranData( "obcsb_oimf_140c" )
	else
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a", "InBlock1", "APRV_YN" , 0 , "N")
		DATAMANAGER.RequestTranData( "obcsb_oimf_141a" )
	end if
		
End Function
'============================================================================
' Query() : 조회TR OTP값 가지고 Data 조회 
'============================================================================
Function Query()

'	if Len(trim(edt0.caption)) < 1 then					'전문수신응답코드가 없을 경우
'		if DATAMANAGER.IsMoreNextData("obcsb_oimf_160r_1") == True then
'			DATAMANAGER.RequestNextData("obcsb_oimf_160r_1")
'		else
'			if edtSTTNNO.caption == "001" then
'				DATAMANAGER.RequestTranData("obcsb_oimf_160r_1")
'			end if
'		end if
'	else
'		Exit Function
'	end if
	
	'5건 이상인 경우에도 다음조회조건이 성립하고 edt0 에 전문수신응답코드가 수신되므로 조건 추가함
	if DATAMANAGER.IsMoreNextData("obcsb_oimf_160r_1") == True then
		DATAMANAGER.RequestNextData("obcsb_oimf_160r_1")
	else
		if edtSTTNNO.caption == "001" then
			DATAMANAGER.RequestTranData("obcsb_oimf_160r_1")
		end if
	end if	

End Function 
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' btnNotice_OnClick()
'============================================================================
Sub btnNotice_OnClick()
	Form.OpenPopup( "mbonl86000_p1" , "사용등록" , sPosInfo)
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	edtSTTNNO.caption = "001"
	
	g_nNextCount = 0
	
	if sEventName == "사용등록" then
		g_szList = Split(sParam, "★")
		
		if UBOUND(g_szList) < 1 then
			Exit Sub
		End if
	end if
	
	if g_szList(1) <> "" then
		'v0004
		if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
		    g_szPassWord = g_szList(1)
		else  'MTS메모리평문 미적용상태일때-부모(mbonl86000)에서 미암호화된정보로 넘어오므로 암호화 필요
			g_szPassWord = Form.GetEncData(g_szList(1))
		end if		
	else
		g_szPassWord = ""
	end if
	edt0.caption = ""
	
	DATAMANAGER.SetDataValue( 0 , "obacp_opop_064r", "InBlock1", "ACNO" , 0 , g_szList(0) ) 
	
	DATAMANAGER.RequestTranData("obacp_opop_064r")
	
	Form.SetSharedData( "CERT_ACNO" , g_szList(0)) 'v0002	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim StateCode, StateCodeName, ResponeCode, ResponeMs
	Dim temp
	
	if szTranID == "obacp_opop_064r" then
		
		edtJumin.caption = DATAMANAGER.GetDataValue( 0 , "obacp_opop_064r", "OutBlock1", "RCNO_PIP" , 0)  'v0005 RCNO->RCNO_PIP
		'v0005 edtJumin.caption 전송데이터 In.RCNO->In.RCNO_PIP 모두변경
	
		Call SetFirst()
		
	elseif szTranID == "obcsb_oimf_160r" then
		
'		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obcsb_oimf_160r", "OutBlock1") - 1
'			
'			StateCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r", "OutBlock1", "OTP_STAT_CLS_CODE" , i)
'			StateCodeName = Form.GetMetaData("인증센터OTP상태코드", StateCode) 
'			grd0.SetCellData("bd_cell2", i, StateCodeName)
'		next
		
		
		
		g_szSTTN_NO = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r", "OutBlock2", "RQST_STA_STTN_NO" , 0)		'요청시작번호
		g_szSRNO = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r", "OutBlock2", "OTP_TLMS_SRNO" , 0)			'전문일련번호
		g_szSTND_DATE = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r", "OutBlock2", "TLMS_PROS_DATE" , 0)		'기준일자
		
		if Len(trim(g_szSRNO)) > 7 then		'전문일련번호
			edtotp.caption = g_szSRNO
		end if
		if Len(trim(g_szSTTN_NO)) == 3 then		'시작요청위치
			edtSTTNNO.caption = g_szSTTN_NO
		end if
		if Len(trim(g_szSTND_DATE)) == 8 then	'기준일자
			edtSTNDDATE.caption = g_szSTND_DATE
		end if
			
		Call Query()
		
	elseif szTranID == "obcsb_oimf_160r_1" then
	     
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obcsb_oimf_160r_1", "OutBlock1") - 1
			if DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock1", "UTLZ_REG_YN" , i) == "Y" then			'등록여부
				grd0.SetCellData("bd_cell5", i, "OTP해지")
				grd0.SetCellFgColor("bd_cell5", i, "4")
			elseif DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock1", "UTLZ_REG_YN" , i) == "C" then '등록여부 v006
				grd0.SetCellData("bd_cell5", i, "OTP교체")
				grd0.SetCellFgColor("bd_cell5", i, "4")
			elseif DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock1", "UTLZ_REG_YN" , i) == "N" then			'등록여부
				grd0.SetCellData("bd_cell5", i, "OTP등록")
				grd0.SetCellFgColor("bd_cell5", i, "4")
			else
				grd0.SetCellData("bd_cell5", i, "사용불가") 'v006
				grd0.SetCellEnable( "bd_cell5", i, False )
			end if
			
'			if DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock1", "OTP_STAT_NAME" , 0) == "사고신고" then
''				grd0.SetCellEnable( "bd_cell5", i, false )
'			end if
		next
		
		g_nGrdCount = DATAMANAGER.GetDataCount( 0 , "obcsb_oimf_160r_1", "OutBlock1")
		for i = 0 to g_nGrdCount - 1
			g_nNextCount = g_nNextCount + 1
			StateCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock1", "OTP_STAT_CLS_CODE" , i)
			StateCodeName = Form.GetMetaData("인증센터OTP상태코드", StateCode) 
			grd0.SetCellData("bd_cell2", g_nNextCount - 1, StateCodeName)
		next
		
		'v0001
		if g_nGrdCount > 0 then
			g_Flag = 0
		end if
		
		ResponeCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_160r_1", "OutBlock2", "OTP_RSPN_CODE" , 0)
		ResponeMs = Form.GetMetaData("OTP응답코드", ResponeCode)			
		edt1.caption = ResponeMs

	elseif szTranID == "obcsb_oimf_140c" then
		if DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_140c", "OutBlock1", "OTP_RSPN_CODE" , 0) <> ""then
			edt0.caption = ""
			Form.SetTimerEvent(0, 0, 1)
			DATAMANAGER.RequestTranData("obacp_opop_064r")
		else
              Form.SetTimerEvent(0, 1, 1) 'v0001
			'DATAMANAGER.RequestTranData("obcsb_oimf_140c_1")		
		end if
		
	elseif szTranID == "obcsb_oimf_141a" then
		if DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_141a", "OutBlock1", "OTP_RSPN_CODE" , 0) <> ""then
			edt0.caption = ""
			Form.SetTimerEvent(1, 0, 1)
			DATAMANAGER.RequestTranData("obacp_opop_064r")
		else
              Form.SetTimerEvent(1, 1, 1) 'v0001		
			'v0004 Timer Event로 처리하므로 TR호출불필요
			'DATAMANAGER.RequestTranData("obcsb_oimf_141a_1")
		end if
		
	elseif szTranID == "obcsb_oimf_141a_1" then
		temp = Form.GetMetaData( "OTP응답코드" , DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_141a_1", "OutBlock1", "OTP_RSPN_CODE" , 0))
		edt1.caption = temp
		Form.triggerEvent( "#" , "Reset", szParam)			'비밀번호 초기화 요청
		'g_szPassWord = ""			'비밀번호 초기화
		Form.SetTimerEvent(1, 0, 1)
		'v0004 정상처리된 경우에만 해지완료표시 및 재조회/정상처리 아닌경우 처리불가 팝업메시지
		rspnCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_141a_1", "OutBlock1", "OTP_RSPN_CODE" , 0)
		if rspnCode == "0000" or rspnCode == "3999" then
			Form.MsgBox( "알림", "OTP해지가 완료되었습니다.", 0, 6)
			DATAMANAGER.RequestTranData("obacp_opop_064r")			'재조회
		else
			if rspnCode <> "3021" then  '3021.수신전문 조회 중 입니다.
				Form.ShowAlert( "알림" , "처리에 실패하였습니다.("..temp..")")
			end if
		end if
		
	elseif szTranID == "obcsb_oimf_140c_1" then
		temp = Form.GetMetaData( "OTP응답코드" , DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_140c_1", "OutBlock1", "OTP_RSPN_CODE" , 0))
		edt1.caption = temp
		Form.triggerEvent( "#" , "Reset1", szParam)			'비밀번호 초기화 요청
		'g_szPassWord = ""			'비밀번호 초기화
		Form.SetTimerEvent(0, 0, 1)
		'v0004 정상처리된 경우에만 등록완료표시 및 재조회/정상처리 아닌경우 처리불가 팝업메시지
		rspnCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_140c_1", "OutBlock1", "OTP_RSPN_CODE" , 0)
		if rspnCode == "0000" or rspnCode == "3999" then
			Form.MsgBox( "알림", "OTP등록이 완료되었습니다.", 0, 6)
			'Form.OpenPopup( "mbonl86000_p2" , "일회용PIN이동" , sPosInfo)
			DATAMANAGER.RequestTranData("obacp_opop_064r")			'재조회
		else
			if temp <> "3021" then	  '3021.수신전문 조회 중 입니다.	
				Form.ShowAlert( "알림" , "처리에 실패하였습니다.("..temp..")")
			end if
		end if		
	end if
	
	
'	if Len(trim(g_szSRNO)) > 7 then		'전문일련번호
'		edtotp.caption = g_szSRNO
'	end if
'	if Len(trim(g_szSTTN_NO)) == 3 then		'시작요청위치
'		edtSTTNNO.caption = g_szSTTN_NO
'	end if
'	if Len(trim(g_szSTND_DATE)) == 8 then	'기준일자
'		edtSTNDDATE.caption = g_szSTND_DATE
'	end if
'	
	
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID)
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	edtSTNDDATE.caption = ""
	edtotp.caption = ""
	edt0.caption = ""
	edt1.caption = ""
	
	g_nClickIndex = lRow
	if szCellID == "bd_cell5" then
		if grd0.GetCellData( "bd_cell5" , g_nClickIndex) == "OTP등록" then
			if Len( g_szPassWord ) < 4 or Form.GetCtlProp( "#edtPW", "caption") == "" then
				Form.ShowAlert("알림", "비밀번호를 확인하여 주십시오.")
			else
'				SetOTP(g_nClickIndex)					'Test용
				Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)
			end if
		elseif grd0.GetCellData( "bd_cell5" , g_nClickIndex) == "OTP교체" then 'v006
			if Len( g_szPassWord ) < 4 or Form.GetCtlProp( "#edtPW", "caption") == ""then
				Form.ShowAlert("알림", "비밀번호를 확인하여 주십시오.")
			else
'				SetOTP(g_nClickIndex)					'Test용
				'추가인증팝업 필요 -
				Form.OpenFramePopup( "mhetc90060_p8" , "otp" , sPosInfo)
			end if
		else
			if Len( g_szPassWord ) < 4 or Form.GetCtlProp( "#edtPW", "caption") == ""then
				Form.ShowAlert("알림", "비밀번호를 확인하여 주십시오.")
			else
'				SetOTP(g_nClickIndex)					'Test용
				'추가인증팝업 필요 -
				Form.OpenFramePopup( "mhetc90060_p8" , "otp" , sPosInfo)
			end if
		end if
	end if
	
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "mhetc90060_p5" then
		if sRet ~= "cancel" then
			Call SetOTP(g_nClickIndex)		'OTP 등록/해지 처리
		end if
	elseif sKeyName == "mhetc90060_p8" then
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)
		end if
'	elseif sKeyName == "mbonl86000_p2" then 'v0001
'		if sRet == "ok" then
'			Form.triggerEvent( "#" , "TabChg", szParam)
'		end if
	end if
	
End Sub
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
	g_nNextCount = 0
	g_Flag = 0 'v0001
	
	'v0004 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
End Sub
'============================================================================
' grd0_OnScrollEnd()
'============================================================================
Sub grd0_OnScrollEnd()
	DATAMANAGER.RequestNextData("obcsb_oimf_160r")
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obcsb_oimf_140c" then						'OTP 등록
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c", "InBlock1", "ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c", "InBlock1", "ACNT_PWD" , 0 , g_szPassWord)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c", "InBlock1", "OTP_CARD_SRNO" , 0 , grd0.GetCellData("bd_cell1", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c", "InBlock1", "OTP_SUPL_CO_CODE" , 0 , grd0.GetCellData("bd_cell8", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c", "InBlock1", "OTP_ISNC_ISTU_CODE" , 0 , grd0.GetCellData("bd_cell7", g_nClickIndex))	
	elseif szTranID == "obcsb_oimf_141a" then					'OTP 해지
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a", "InBlock1", "ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a", "InBlock1", "ACNT_PWD" , 0 , g_szPassWord)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a", "InBlock1", "OTP_CARD_SRNO" , 0 , grd0.GetCellData("bd_cell1", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a", "InBlock1", "OTP_SUPL_CO_CODE" , 0 , grd0.GetCellData("bd_cell8", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a", "InBlock1", "OTP_ISNC_ISTU_CODE" , 0 , grd0.GetCellData("bd_cell7", g_nClickIndex))
	elseif szTranID == "obcsb_oimf_141a_1" then					'OTP 해지
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a_1", "InBlock1", "ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a_1", "InBlock1", "ACNT_PWD" , 0 , g_szPassWord)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a_1", "InBlock1", "OTP_CARD_SRNO" , 0 , grd0.GetCellData("bd_cell1", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a_1", "InBlock1", "OTP_SUPL_CO_CODE" , 0 , grd0.GetCellData("bd_cell8", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_141a_1", "InBlock1", "OTP_ISNC_ISTU_CODE" , 0 , grd0.GetCellData("bd_cell7", g_nClickIndex))	
	elseif szTranID == "obcsb_oimf_140c_1" then					'OTP 등록
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c_1", "InBlock1", "ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c_1", "InBlock1", "ACNT_PWD" , 0 , g_szPassWord)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c_1", "InBlock1", "OTP_CARD_SRNO" , 0 , grd0.GetCellData("bd_cell1", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c_1", "InBlock1", "OTP_SUPL_CO_CODE" , 0 , grd0.GetCellData("bd_cell8", g_nClickIndex))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c_1", "InBlock1", "OTP_ISNC_ISTU_CODE" , 0 , grd0.GetCellData("bd_cell7", g_nClickIndex))
		if grd0.GetCellData( "bd_cell5" , g_nClickIndex) == "OTP교체" then
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c_1", "InBlock1", "REG_CLCD", 0 , "5")
		else
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_140c_1", "InBlock1", "REG_CLCD", 0 , "1")
		End If
	elseif szTranID == "obcsb_oimf_160r" then			'재조회시
		g_nNextCount = 0
	end if
	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr

	if szTranID == "obcsb_oimf_141a_1" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_141a_1" )
		if szErrCode <> "3021" then
			Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")		
		end if
	elseif szTranID == "obcsb_oimf_140c_1" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_140c_1" )
		if szErrCode <> "3021" then		
			Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		end if
	elseif szTranID == "obcsb_oimf_141a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_141a" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	elseif szTranID == "obcsb_oimf_140c" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_140c" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	elseif szTranID == "obcsb_oimf_160r_1" then 'v0001
		if szErrCode == "3021" then
			if g_Flag == 0 then  '그리드건수가 0보다 크면 --> 조회가 된 경우
				g_Flag = 1
				Query()
			else  
				szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_161r_1" )
			'	Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
			end if
		else	
			szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_161r_1" )
			Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		end if
	end if
End Sub

'OTP등록/해지시 전문수신조회중 오류 개선(타이머 추가) v0003
Sub Form_OnTimerEvent(sTimerID) 'v0001
	if sTimerID == 0 or sTimerID == "0" then
		Form.SetTimerEvent(0, 0, 1)
		DATAMANAGER.RequestTranData("obcsb_oimf_140c_1")
	elseif sTimerID == 1 or sTimerID == "1" then	
		Form.SetTimerEvent(1, 0, 1)
		DATAMANAGER.RequestTranData("obcsb_oimf_141a_1")
	end if
End Sub


