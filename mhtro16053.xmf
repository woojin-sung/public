'============================================================================
'전역변수
'============================================================================
Dim g_szToday '오늘날짜
'============================================================================
'FORM
'============================================================================
Sub Form_OnFormInit()
	
	if cmbPeriod.cbkeydata == 3 then '지정일
		calFrom.enable = true
		calTo.enable = true
	else '전일/월간/주간
		calFrom.enable = false 
		calTo.enable = false
	end if

	DATAMANAGER.RequestTranData("ohhts_6222_010r")
	
	g_szToday = Replace(Date(),"-","") '2021-05-26 -> 20210526
	
End Sub
'============================================================================
Sub Form_OnRefresh()
	DATAMANAGER.RequestTranData("ohhts_6222_010r")
End Sub

'============================================================================
'DATAMANAGER
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	Dim szNtnl, nPeriod, nSortCode
	
	szNtnl = cmbNtnl.cbkeydata
	nPeriod = cmbPeriod.cbkeydata
	nSortCode = cmbSort.cbkeydata
	
	if szTranID == "ohhts_6222_003r" then '기간별 등락
		'상해/심천 거래소는 시장코드로 구분(거래소별 실시간 여부 다름)
		if szNtnl == "SH" or szNtnl == "SZ" then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_NTNL_CODE" , 0 , "CN" )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , szNtnl )
		else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_NTNL_CODE" , 0 , szNtnl )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , "" )
		end if

		DATAMANAGER.SetDataValue( false, szTranID ,"InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, szTranID ,"InBlock1", "FID_INPUT_COND_SCR_DIV_CODE", 0 , "62222" )
		DATAMANAGER.SetDataValue( false, szTranID ,"InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 0 , "1" )
		DATAMANAGER.SetDataValue( false, szTranID ,"InBlock1", "FID_INPUT_DATE1",0,calFrom.caption)
		DATAMANAGER.SetDataValue( false, szTranID ,"InBlock1", "FID_INPUT_DATE2",0,calTo.caption)
		DATAMANAGER.SetDataValue( false, szTranID ,"InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE4",0,nSortCode)
	
	elseif szTranID == "ohhts_6222_010r" then ' 영업일 조회
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1", "INPUT_CLS", 0 , nPeriod )
		
		'상해/심천 거래소는 시장코드로 구분(거래소별 실시간 여부 다름)
		if szNtnl == "SH" or szNtnl == "SZ" then
			DATAMANAGER.SetDataValue( false, szTranID , "InBlock1", "FIDX_INPUT_NTNL_CODE", 0 , "CN")
		else
			DATAMANAGER.SetDataValue( false, szTranID , "InBlock1", "FIDX_INPUT_NTNL_CODE", 0 , szNtnl)
		end if
		
		if nPeriod == 3 then '지정일
			DATAMANAGER.SetDataValue( false, szTranID , "InBlock1", "FID_INPUT_DATE1", 0 , calFrom.caption )
			DATAMANAGER.SetDataValue( false, szTranID , "InBlock1", "FID_INPUT_DATE2", 0 , calTo.caption )
		end if

	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	Dim szFromDate, szToDate
	
	if szTranID == "ohhts_6222_010r" then '영업일조회
	
		if cmbPeriod.cbkeydata <> "3" then '지정일이 아닐경우
		
			szFromDate = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "FID_STND_DATE1" , 0 ) '시작일
			szToDate = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "FID_STND_DATE2" , 0 ) '종료일
	
			calFrom.caption = szFromDate
			calTo.caption = szToDate
			
		end if

		DATAMANAGER.RequestTranData("ohhts_6222_003r") '기간별등락
		
	end if
		
End Sub
'============================================================================
'콤보박스
'============================================================================
Sub cmbPeriod_OnEditComplete(iIndex) '구분
	if iIndex == 3 then '지정일
		calFrom.enable = true
		calTo.enable = true
	else ' 전일/주간/월간
		calFrom.enable = false
		calTo.enable = false
	end if
	DATAMANAGER.RequestTranData("ohhts_6222_010r")
End Sub

'============================================================================
Sub cmbNtnl_OnEditComplete(iIndex) '국가
	grdEtfRate.SetClear()
	DATAMANAGER.RequestTranData("ohhts_6222_010r")
End Sub
'============================================================================
Sub cmbSort_OnEditComplete(iIndex) '정렬
	grdEtfRate.SetClear()
	DATAMANAGER.RequestTranData("ohhts_6222_003r")
End Sub
'============================================================================
'캘린더
'============================================================================
Sub calFrom_OnEditComplete() '기준일일(지정일)
	if tonumber(calFrom.caption) < tonumber(calTo.caption) then '기준일 < 비교일
		grdEtfRate.SetClear()
		DATAMANAGER.RequestTranData("ohhts_6222_010r")
	else '기준일 >= 비교일
		Form.MsgBox("알림", "입력하신 기준일이 비교일과 같거나 초과합니다.", "", 0)
		calFrom.caption = tonumber(calTo.caption)-1
	end if
	
End Sub

'============================================================================
Sub calTo_OnEditComplete()'비교일(지정일)
	if tonumber(calTo.caption) <= tonumber(g_szToday) then '비교일 <= 당일날짜
		if tonumber(calTo.caption) <= tonumber(calFrom.caption) then '기준일 >= 비교일
			Form.MsgBox("알림", "입력하신 기준일이 비교일과 같거나 초과합니다.", "", 0)
		else ' 기준일 < 비교일 <= 당일날짜
			grdEtfRate.SetClear()
			DATAMANAGER.RequestTranData("ohhts_6222_010r")
		end if
	
	else '비교일 > 당일날짜
		calTo.todaymode = 0
		grdEtfRate.SetClear()
		DATAMANAGER.RequestTranData("ohhts_6222_010r")
	end if

End Sub
'============================================================================
'그리드
'============================================================================
Sub grdEtfRate_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("ohhts_6222_003r") == true then 
		DATAMANAGER.RequestNextData("ohhts_6222_003r")
	end if
End Sub

'============================================================================
Sub grdEtfRate_OnClickUp(lRow, szCellID)
	Dim szExChange,szItemCode,szItemNm '거래소코드,종목코드,종목명
	
	szItemNm = grdEtfRate.GetCellData("bd_cell0", lRow )
	szItemCode= grdEtfRate.GetCellData("bd_cell4", lRow )
	szExChange = grdEtfRate.GetCellData("bd_cell10", lRow )
	
	Form.SendMessageToMain("CHANGE_ITEMCODE_OVERSTOCK", szExChange.."@"..szItemCode.."★"..szItemNm.."★".."", "" )
	Form.OpenScreen("16000" , "" )
	
End Sub


