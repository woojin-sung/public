'============================================================================
Function open_HTS()

	'sub1 = "온라인서비스 신청시 "
	'sub2 = "온라인이체한도"
	'sub4 = "를 등록하셔야합니다."

	'======== 1. 팝업 메세지 처리 ========
	'If  g_Chk2_007r <> 0 and g_Tact_Limit == "N" Then 
	'		showalert("안내",sub1..sub2..sub4)
	'End If

	'======== 2. 각 업무 화면오픈 ========
	'1) 이체한도 
	'g_Tact_Limit ="N" '테스트입력고정dfdf
	'g_Chk2_007r  =1 'dfdf
	If g_Chk2_007r <> 0 and g_Tact_Limit == "N" and strTRGT_YN == "N" Then '이체한도등록이 필요한경우 and 은행개설계좌가 아닌경우
		ContMain.T1TactLimt.visible  =true
		ContMain.D1TactLimt.visible  =true
		ContMain.TactLimtReg.visible =true
		
		'온라인이체한도등록 show 로 안내사항 위치 조정
		TactLimtReg_yn = "Y"
		ContMain.Container1.top = 480
		ContMain.SetScrollAutoSize()
		
	End If

	ContMain.ChkButton1.enable  = true
	ContMain.ImageB.enable      = true
End Function
'============================================================================
Function btnOK_Change()
	If  ContMain.ChkButton1.checkstate == "1" Then
		If g_Chk2_007r <> 0 and g_Tact_Limit == "N" Then '이체한도등록이 필요한경우
			If cdbl(ContMain.T1TactLimt.caption) >0 AND cdbl(ContMain.D1TactLimt.caption) >0  and ContMain.D1TactLimt.caption <>"" and ContMain.T1TactLimt.caption <>"" Then
				btnOK.enable 		= true
				btnOK.btnimage	 = "btn_20.9"
				btnOK.fgcolor		= "273"
			else
				btnOK.enable 		= false
				if szTheme = "black" then
					btnOK.btnimage	= "btn_27.9"
				else
					btnOK.btnimage	= "btn_21.9"
				end if
				btnOK.fgcolor		= "269"
			end if
			
		else
			btnOK.enable 		= true
			btnOK.btnimage	 = "btn_20.9"
			btnOK.fgcolor		 = "273"
			
		end if
	else
		btnOK.enable 		= false
		if szTheme = "black" then
			btnOK.btnimage	= "btn_27.9"
		else
			btnOK.btnimage	= "btn_21.9"
		end if
		btnOK.fgcolor		= "269"
	
	end if
End Function

'============================================================================
'1회 한도 체크
'============================================================================
Sub ContMain_T1TactLimt_OnEditComplete()
	
	If ContMain.T1TactLimt.caption == "0" or ContMain.T1TactLimt.caption == "" Then
		'ShowAlert("안내", "금액을 확인해주세요.")
		ContMain.T1TactLimt.SetResultLabel("1", "error", "이체 한도 금액을 확인하세요.", "ContMain")
		Form.SetTimerEvent2("9999", 1, 0.5)
		ContMain.T1TactLimt.caption = ""
		btnOK_Change()
		Exit Sub
	Else
		'V001 한도상향 1억->10억
		'If cdbl(ContMain.T1TactLimt.caption) > 100000000 Then
		If cdbl(ContMain.T1TactLimt.caption) > 1000000000 Then
			'ShowAlert("안내", "등록가능한도 초과입니다. (입력금액:"&cdbl(ContMain.T1TactLimt.caption)&")")
			'ContMain.T1TactLimt.SetResultLabel("1", "error", "1회 최대한도는 1억원 입니다.", "ContMain")
			ContMain.T1TactLimt.SetResultLabel("1", "error", "1회 최대한도는 10억원 입니다.", "ContMain")	'V001
			Form.SetTimerEvent2("9999", 1, 0.5)
			ContMain.T1TactLimt.caption = ""
			btnOK_Change()
			Exit Sub
		End If
				
		If cdbl(ContMain.T1TactLimt.caption)> 0 and cdbl(ContMain.D1TactLimt.caption) >0 Then	
		
			If cdbl(ContMain.T1TactLimt.caption) > cdbl(ContMain.D1TactLimt.caption) Then
			
				ContMain.T1TactLimt.SetResultLabel("1", "error", "1회 이체한도 금액이 1일 이체한도\n금액을 초과했습니다.", "ContMain",2)
				'Form.SetTimerEvent2("9999", 1, 0.5)
				
				ContMain.InfoPos.top = 532
				ContMain.SetScrollAutoSize()
				ContMain.scroll_pos =  107
				
				ContMain.T1TactLimt.caption = ""
				btnOK_Change()
				Exit Sub
			End If
		End If
		
	End if
	
	btnOK_Change()
	ContMain.scroll_pos = 180
	ContMain.D1TactLimt.SetShowKeypad(true)
End Sub

'============================================================================
'1일 한도 체크
'============================================================================
Sub ContMain_D1TactLimt_OnEditComplete()

	
	ContMain.scroll_pos = Form.calcUnResize(ContMain.Combo0.top,"1")
	
	
	If ContMain.D1TactLimt.caption == "0" or ContMain.D1TactLimt.caption == ""Then
		ContMain.D1TactLimt.SetResultLabel("1", "error", "이체 한도 금액을 확인하세요.", "ContMain")
		Form.SetTimerEvent2("9999", 1, 0.5)
		ContMain.D1TactLimt.caption = ""
		btnOK_Change()
		Exit Sub
	Else
		'V001 한도상향 5억->10억		
		'If cdbl(ContMain.D1TactLimt.caption) > 500000000 Then
		If cdbl(ContMain.D1TactLimt.caption) > 1000000000 Then
			'ShowAlert("안내", "등록가능한도 초과입니다. (입력금액:"&cdbl(ContMain.D1TactLimt.caption)&")")
			'V001 ContMain.D1TactLimt.SetResultLabel("1", "error", "1일 최대한도는 5억원 입니다.", "ContMain")
			ContMain.D1TactLimt.SetResultLabel("1", "error", "1일 최대한도는 10억원 입니다.", "ContMain")
			Form.SetTimerEvent2("9999", 1, 0.5)
			ContMain.D1TactLimt.caption = ""
			btnOK_Change()
			Exit Sub
		End If
		
		If cdbl(ContMain.T1TactLimt.caption)> 0 and cdbl(ContMain.D1TactLimt.caption) >0 Then	
			If cdbl(ContMain.T1TactLimt.caption) > cdbl(ContMain.D1TactLimt.caption) Then
				ContMain.D1TactLimt.SetResultLabel("1", "error", "1회 이체한도 금액이 1일 이체한도\n금액을 초과했습니다.", "ContMain",2)
				'Form.SetTimerEvent2("9999", 1, 0.5)
				
				ContMain.InfoPos.top = 532
				ContMain.SetScrollAutoSize()
				ContMain.scroll_pos =  107
				
				
				ContMain.D1TactLimt.caption = ""
				btnOK_Change()
				Exit Sub
			End If
		End If
	End If
	
	btnOK_Change()
End Sub

'============================================================================
' 최종업무신청
'============================================================================
Sub btnOK_OnClick()
	if ContMain.EditPwd.caption ="" then
		ShowAlert("안내", "비밀번호를 입력하세요.")
		Exit Sub
	End If
	
	If pwSetYn <> 1 Then
		ShowAlert("안내", "계좌비밀번호 재설정 신청내역이 존재합니다. 영업점 승인 및 재설정 완료 후 신청가능합니다.")
		Exit Sub
	End If
	
	
	'=== 2. 온라인이체한도 서비스 ===
	'금액 미입력, 이체한도 초과 입력, 감액 시 오류
	'기존 약정내역이 있는 고객에 한해 1회 / 1일 선택 신청 가능
	'================================
	If g_Chk2_007r <> 0 and g_Tact_Limit == "N" Then '이체한도등록이 필요한경우
		g_15007s1_T1 = cdbl(ContMain.T1TactLimt.caption)
		g_15007s1_D1 = cdbl(ContMain.D1TactLimt.caption)
		strT1 = Form.GetSharedData( "15007_T1" , false )
		strD1 = Form.GetSharedData( "15007_D1" , false )
		
		
		'은행이체한도가 등록안된상태에서 금액이없을때 fail
		If strSTPL_YN2 == "Y" Then	
			If g_15007s1_D1 == 0 or g_15007s1_T1 == 0 Then
				showalert("안내", "이체한도금액을 확인하세요.")
				Exit Sub
			End If
		End If
		
		If g_15007s1_T1> 0 and g_15007s1_D1 >0 Then	
			If cdbl(g_15007s1_T1) > cdbl(g_15007s1_D1) Then
				showalert("안내", "1회 이체한도 금액이 1일 이체한도 금액을 초과했습니다.")
				Exit Sub
			End If
		End If
		
		strApltYn5 ="Y"
		
		
	End If

	DATAMANAGER.RequestTranData("obaci_nmet_005a")
End Sub
'================================
'안내사항
'================================
Sub ContMain_Container1_Label1_OnClick()
	ContMain.T1TactLimt.SetResultLabel("0", "complete", "",  "ContMain")
	ContMain.D1TactLimt.SetResultLabel("0", "complete", "",  "ContMain")
	
	if bWide == false then
		bWide = true
		
		if TactLimtReg_yn == "N" then
			ContMain.InfoPos.top = 727
			ContMain.SetScrollAutoSize()
			ContMain.Container1.Image3.imgpath = "icon_caret_up.png"
			
			
			ContMain.Container1.SetHeightResize(305)
			ContMain.scroll_pos =  262
		else
			ContMain.InfoPos.top = 760
			ContMain.SetScrollAutoSize()
			ContMain.Container1.Image3.imgpath = "icon_caret_up.png"
			
			ContMain.Container1.SetHeightResize(315)
			ContMain.scroll_pos =  295
		end if
	else
		
		bWide = false
		ContMain.Container1.SetHeightResize(40)
		ContMain.InfoPos.top = 0
		'ContMain.scroll_pos = Form.calcUnResize(ContMain.Combo0.top,"1") -10
		'ContMain.scroll_pos = 20
		ContMain.scroll_pos = 0
		ContMain.Container1.Image3.imgpath = "icon_caret_down.png"
		
		Form.SetTimerEvent2("9999", 1, 0.5)
		'ContMain.SetScrollAutoSize()

	end if
end Sub

Sub ContMain_Container1_Image1_OnClick()
	ContMain_Container1_Label1_OnClick()
End SUb

Sub ContMain_Container1_Image3_OnClick()
	ContMain_Container1_Label1_OnClick()
End SUb

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if trim(sTimerID) == "9999" then
		Form.SetTimerEvent2("9999", 0, 0.5)
		ContMain.SetScrollAutoSize()
	end if
End Sub
'================================

Sub Container2_Image2_OnClick()
	
	Form.OpenPopup("mbbdm85200_p9" , "100" , "5")
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용
	
	Container2_Image2_OnClick()
End Sub

'============================================================================
Function Combo_AccMask(szAcc)
           Combo_AccMask = Left(szAcc, 4)&"-"&Mid(szAcc, 5, 4)
End Function


'============================================================================
Sub ContMain_T1TactLimt_OnClick()
	'한도입력완료시 안내사항 접음
	'bWide = true
	'ContMain_Container1_Label1_OnClick()

	ContMain.T1TactLimt.SetResultLabel("0", "complete", "",  "ContMain")
	ContMain.D1TactLimt.SetResultLabel("0", "complete", "",  "ContMain")
	ContMain.scroll_pos = 100
	
End Sub

'============================================================================
Sub ContMain_D1TactLimt_OnClick()
	ContMain.T1TactLimt.SetResultLabel("0", "complete", "",  "ContMain")
	ContMain.D1TactLimt.SetResultLabel("0", "complete", "",  "ContMain")
	
	'한도입력완료시 안내사항 접음
	'bWide = true
	'ContMain_Container1_Label1_OnClick()
	ContMain.scroll_pos = 200
	
End Sub



