		ShowAlert("안내","이미 신청된 업무가 존재합니다.")
		
		ContMain.ChkButton1.checkstate  = 0
		ContMain.ChkButton1.enable 		= false
		ContMain.ImageB.enable      	= false
		
		btnOK.enable 			= false
		if szTheme = "black" then
			btnOK.btnimage	= "btn_27.9"
		else
			btnOK.btnimage	= "btn_21.9"
		end if
		btnOK.fgcolor		= "269"
		
