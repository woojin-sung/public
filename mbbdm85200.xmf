Sub Container0_Image2_OnClick()
	'Form.OpenPopup("mbbdm85200_p9" , "100" , "5")
	Form.SetSharedData("BDM_NMETBSWRGB", "") '업무구분초기화 JMY
	
	'20231012_01 HWG START : 뒤로가기 로직 변경
	'로그인화면 진입이 아닌 경우
	if Form.GetSharedData("BDM_FRST_MAPID", false) <> "mhetc90022" then
		if g_next == "Y" then
			Form.OpenNextPopup("mbbdm86130", "" , "" ) '비대면휴대폰인증
			Exit Sub
		end if
		
	end if
	
	'20230608 SWJ START
	if g_next2 == "Y" then
		Form.OpenNextPopup("mhetc90023", "", "")
		Exit Sub
	end if
	'20230608 SWJ END
	
	Form.CloseForm()
	'20231012_01 HWG END
End Sub

'============================================================================
' 탭(업무신청 / 매체사용등록)
'============================================================================
Sub Tab0_OnTabChanged(nCurrentTab)
	
	' 업무신청
	if nCurrentTab == 0 then
		ContMain.visible	= true
		ContMain1.visible	= false
		btnOK0.caption	= "다음"
	
	' 매체사용등록
	else
		ContMain.visible	= false
		ContMain1.visible	= true
		btnOK0.caption	= "신청"
	end if
	
End Sub

'============================================================================
' 다음/신청 버튼
'============================================================================
Sub btnOK0_OnClick()
	if btnOK0.caption == "다음" then
	
		'로그인화면 진입일 경우
		if Form.GetSharedData("BDM_FRST_MAPID", false) == "mhetc90022" then
		
			'20231012_01 HWG START : 뒤로가기 로직 변경
			'20230608 SWJ START
			g_Next2 = "Y"
			'20230608 SWJ END
			
			'Form.CloseForm()
			
			'20230608 SWJ START
			if g_next2 == "Y" then
				Form.OpenNextPopup("mhetc90023", "", "")
			end if
			'20230608 SWJ END
			'20231012_01 HWG END
		else
			Form.SetSharedData("BDM_NMETBSWRGB", bdm_choice) 'v0001
			
			'20231012_01 HWG START : 뒤로가기 로직 변경
			g_next = "Y"
			
			'Form.CloseForm()
				
			if g_next == "Y" then
				Form.OpenNextPopup("mbbdm86130", "" , "" ) '비대면휴대폰인증
			end if
			'20231012_01 HWG END
		end if
		
	elseif btnOK0.caption == "신청" then
		g_nReqCnt = 0		'매체사용 신청 갯수
		g_nRcvCnt = 0		'매체사용 신청 결과 갯수
		
		g_bRcvOK0 = False
		g_bRcvOK1 = False
		g_bRcvOK2 = False
		
		if RequestCheck() == False then	
			Exit Sub
		end if
		
		'종합/IC카드
		if ContMain1.contBtm.chk0.checkstate == "1" then
			DATAMANAGER.RequestTranData("obaci_mdia_003r")	'거래매체사용등록정보조회
		end if
		
		'보안카드
		if ContMain1.contBtm.chk1.checkstate == "1" then	
			DATAMANAGER.RequestTranData("obcsb_oimf_494a")	'보안카드 사용 등록
		end if
		
		'통장
		if ContMain1.contBtm.chk2.checkstate == "1" then
			DATAMANAGER.RequestTranData("obaci_mdia_003r_1")	'거래매체사용등록정보조회
		end if
		
	end if
	
End Sub

'============================================================================
' 업무신청현황조회 버튼
'============================================================================
Sub ContMain_Button9_OnClick()
	'Form.OpenNextPopup("mbbdm85183", "", "" )
	Form.SetSharedData("BDM_CONNECTING", "2") '업무신청상태조회
	Form.SetSharedData("&SCREEN_AUTH" , "99")
	Form.SetSharedData("BDM_NMETBSWRGB", "999")
	Form.OpenPopup("mbbdm86130" , "" , "")
End Sub

'============================================================================
'내국인/외국인/법인 선택에 따른 CONTAINER SWITCH
'============================================================================
Sub ContMain1_rdoGubn_OnClick(nIndex)
	ContMain1.contBirth.visible		= False
	ContMain1.contForeign.visible	= False
	ContMain1.contLicens.visible	= False
	
	if nIndex == 0 then		'내국인
		ContMain1.contBirth.visible		= True
		ContMain1.contBtm.top			= 84
	elseif nIndex == 1 then	'외국인
		ContMain1.contForeign.visible	= True
		ContMain1.contBtm.top			= 100
	elseif nIndex == 2 then	'법인
		ContMain1.contLicens.visible	= True
		ContMain1.contBtm.top			= 84
	end if
	
End Sub

'============================================================================
'확인 버튼 클릭
'============================================================================
Sub ContMain1_contBtm_btnOK_OnClick()
	if ValidatCheck() == False then		'필수정보 입력 여부 확인
		Exit Sub
	end if
	
	DATAMANAGER.RequestTranData("obacp_opop_008r")	'고객정보 체크
End Sub

'============================================================================
'계좌번호
'============================================================================
Sub ContMain1_contBtm_edtAcnt_OnEditChar(CharCode)
	g_bAcntChk = False
	
	if ContMain1.contBtm.edtBank.caption <> "" then
		ContMain1.contBtm.edtBank.caption = ""
	end if
	ContMain1.contBtm.lblName.caption = ""
End Sub

'============================================================================
'통장 체크시 팝업 후 선택
'============================================================================
Sub ContMain1_contBtm_chk2_OnChange(sCheckState)
	If sCheckState == "1" then
		if g_bAcntChk == False then
			Form.MsgBox( "알림", "계좌확인 후 신청가능합니다.", "", 6 )
			ContMain1.contBtm.chk2.checkstate = "0"
			Exit Sub
		end if
	
		Form.OpenPopup("mbisa56040_p1" , ContMain1.contBtm.edtAcnt.caption , "")
	else
		ContMain1.contBtm.edtBank.caption = ""
	End If
End Sub

