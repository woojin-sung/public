'============================================================================
'내국인/외국인/법인 선택에 따른 실명번호
'============================================================================
Function GetRCNO()
	Dim sRCNO

	'v0002
	if g_plain_rm == "1" then 'MTS메모리평문적용
		if ContMain1.rdoGubn.currentindex == "0" then		'내국인
			sRCNO = ContMain1.contBirth.edt0.caption
		elseif ContMain1.rdoGubn.currentindex == "1" then	'외국인(재외국민)
			sRCNO = ContMain1.contForeign.edt0.caption
		else									'법인
			sRCNO = ContMain1.contLicens.edt0.caption
		end if
	else
		if ContMain1.rdoGubn.currentindex == "0" then		'내국인
			sRCNO = Form.GetEncData(ContMain1.contBirth.edt0.caption)			
		elseif ContMain1.rdoGubn.currentindex == "1" then	'외국인(재외국민)
			sRCNO = Form.GetEncData(ContMain1.contForeign.edt0.caption)
		else									'법인
			sRCNO = Form.GetEncData(ContMain1.contLicens.edt0.caption)
		end if
	end If
	return sRCNO
End Function


'============================================================================
'필수정보 입력 여부 확인
'============================================================================
Function ValidatCheck()
	if ContMain1.rdoGubn.currentindex == "0" then		'내국인
		if Len(ContMain1.contBirth.edt0.caption) < 6 then
			Form.MsgBox( "알림", "생년월일을 입력해 주세요.", "", 6 )
			return False
		end if
	elseif ContMain1.rdoGubn.currentindex == "1" then	'외국인(재외국민)
		if ContMain1.contForeign.edt0.caption == "" then
			Form.MsgBox( "알림", "실명확인번호를 입력해 주세요.", "", 6 )
			return False
		end if
	else									'법인
		if ContMain1.contLicens.edt0.caption == "" then
			Form.MsgBox( "알림", "사업자등록번호를 입력해 주세요.", "", 6 )
			return False
		end if
	end if
	
	if Len(ContMain1.contBtm.edtAcnt.caption) < 8 then
		Form.MsgBox( "알림", "계좌번호를 입력해 주세요.", "", 6 )
		return False
	end if
	
	'v0001 화면단에서의 자릿수 체크는 MTS메모리평문 미적용일때만 체크
	if g_plain_rm ~= "1" and (Len(ContMain1.contBtm.edtPW0.caption) < 4 or Len(ContMain1.contBtm.edtPW0.caption) > 8) then
		Form.MsgBox( "알림", "계좌 비밀번호는 4~8자리만 가능합니다.", "", 6 )
		return False
	end if

	return True
End Function

'============================================================================
Function RequestCheck()
	if g_bAcntChk == False then
		Form.MsgBox( "알림", "계좌확인 후 신청가능합니다.", "", 6 )
		return False
	end if
	
	g_sChk0 = ContMain1.contBtm.chk0.checkstate
	g_sChk1 = ContMain1.contBtm.chk1.checkstate
	g_sChk2 = ContMain1.contBtm.chk2.checkstate
	
	if g_sChk0 = "1" then
		g_nReqCnt = g_nReqCnt + 1
	end if
	
	if g_sChk1 = "1" then
		g_nReqCnt = g_nReqCnt + 1
	end if
	
	if g_sChk2 = "1" then
		g_nReqCnt = g_nReqCnt + 1
	end if
	
	if g_nReqCnt == 0 then
		Form.MsgBox( "알림", "최소 하나 이상의 매체를 선택하시기 바랍니다.", "", 6 )
		return False
	end if
	
	if g_sChk2 == "1" and Trim(ContMain1.contBtm.edtBank.caption) == "" then
		Form.MsgBox( "알림", "통장을 선택해주세요.", "", 6 )
		return False
	end if
	
	if g_sChk0 == "1" and g_sYN0 == "Y" then
		Form.MsgBox( "알림", "이미 등록되어 있는 종합/IC 카드 입니다.", "", 6 )
		ContMain1.contBtm.chk0.checkstate = "0"
		return False
	end if
	
	if g_sChk1 == "1" and g_sYN1 == "Y" then
		Form.MsgBox( "알림", "이미 등록되어 있는 보안카드 입니다.", "", 6 )
		ContMain1.contBtm.chk1.checkstate = "0"
		return False
	end if
End Function

'============================================================================
'결과 메세지 팝업
'============================================================================
Sub ShowResult()
	Dim sMsg
	sMsg = ""

	if g_nReqCnt > 0 and g_nReqCnt == g_nRcvCnt then		
		if g_sChk0 == "1" and g_bRcvOK0 == True then
			sMsg = sMsg & "[종합/IC카드] "
		end if
		
		if g_sChk1 == "1" and g_bRcvOK1 == True then
			sMsg = sMsg & "[보안카드] "
		end if
		
		if g_sChk2 == "1" and g_bRcvOK2 == True then
			sMsg = sMsg & "[통장] "
		end if
		
		if sMsg <> "" then
			Form.MsgBox( "알림", sMsg & "매체사용 등록이 완료되었습니다." , 0 )
		end if
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	ContMain.ImageA.setMaintainingRatio("1")	
	ContMain.ImageB.setMaintainingRatio("1")	
	ContMain.ImageC.setMaintainingRatio("1")	
End Sub

