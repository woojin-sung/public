	<SCRIPT_INFO _len="34653" _ulen="31107" >
'===========================================================================
' 01. 화 면 명 : 업무신청
' 02. 화면설명 : 업무신청(업무신청, 매체사용등록)
' 03. 작    성 : 2023. 05. 25 신명준
' 04. 업무신청_통합안내(mbbdm85200) 매체사용신청(mbisz56040) 통합
' 2024.07.30 : 전상일 : v0001 단기다수 해지 메뉴트리에서 삭제
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim bdm_choice
Dim g_next
Dim g_Opng_File	'오픈할화면
Dim g_Send_Data	'인자정보

Dim g_bAcntChk	'계좌 확인 여부(True인 경우에만 신청할 수 있음)
g_bAcntChk = False

Dim g_sYN0		'종합/IC 카드 기등록 여부
Dim g_sYN1		'보안카드 기등록 여부

Dim g_nReqCnt		'매체사용 신청 갯수
Dim g_nRcvCnt		'매체사용 신청 결과 갯수

Dim g_sChk0		'종합/IC카드 CheckState
Dim g_sChk1		'보안카드 CheckState	
Dim g_sChk2		'통장 CheckState

Dim g_bRcvOK0		'종합/IC카드 매체사용신청 성공
g_bRcvOK0 = False

Dim g_bRcvOK1		'보안카드 매체사용신청 성공
g_bRcvOK1 = False

Dim g_bRcvOK2		'통장 매체사용신청 성공
g_bRcvOK2 = False

Dim g_plain_rm	'v0001 MTS메모리평문적용여부
Dim g_next2		'20230608
'****************************************************************************
'            					FORM 함수
'****************************************************************************
Sub Form_OnFormInit()
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if Form.GetSharedData("&OS_TYPE", false) == "1" then	'Android("1") iOS("2")
		ContMain.setScrollBarVisible("2")
		ContMain1.setScrollBarVisible("2")
	end if
	
	Shared_Data_Reset()
    
	bdm_choice	= Form.GetSharedData("BDM_NMETBSWRGB", false)		'로그인화면
	
	default_color = Form.GetEnvData("common.theme")
	Form.SetSharedData( "mOTP_IntoClcd" , "NMET_BSWR" )
	
	scr_num = Form.GetSharedData("&POPUP_SCREEN_NO", false)
		'Form.ShowAlert("scr_num", scr_num)
	
	'20230710 SWJ START : 사설인증 보안매체 없음 팝업에서 진입(타기관 OTP등록 시)
	szScrPoint = Form.GetOpenLinkData()
	
	if szScrPoint == "mhetc90190_p1" then
		'&USER_ID값이 없을 때(로그인한 적 없을 때는) OpenScreen으로 열면 로그인 창 뜸 
		'OpenPopup으로 열어서 &POPUP_SCREEN_NO 값이 없음
		scr_num = "86106"
	else
		Form.SetSharedData("MeritzAuth_Security", "") '사설인증 진행 사항 초기화 (업무신청에서는 들어올 수 없음)
	end if
	'20230710 SWJ END
	
	if scr_num == "85210" or scr_num == 85210 then	'온라인 서비스신청
		bdm_choice = "004"
		Form.SetSharedData("BDM_FRST_MAPID", "screen41000") 		'메뉴진입은 시장종합(openscreen호출) 이므로 임의 screen41000 전달
	elseif scr_num == "85220" or scr_num == 85220  then	'이체한도 등록 및 증액
		bdm_choice = "005"
		Form.SetSharedData("BDM_FRST_MAPID", "screen41000") 		
	elseif scr_num == "86106" or scr_num == 86106  then	'타기관otp이용등록
		bdm_choice = "006"
		Form.SetSharedData("BDM_FRST_MAPID", "screen41000") 		
	elseif scr_num =="86100" or scr_num == 86100  then	'메리츠 모바일 otp발급
		bdm_choice = "009"
		Form.SetSharedData("BDM_FRST_MAPID", "screen41000") 		
	elseif scr_num == "85250" or scr_num == 85250  then	'온라인개설계좌 실명확인
		bdm_choice = "001"
		Form.SetSharedData("BDM_FRST_MAPID", "screen41000") 		
	elseif scr_num == "85260" or scr_num == 85260  then	'공인인증서 온라인 신원확인
		bdm_choice = "003"
		Form.SetSharedData("BDM_FRST_MAPID", "screen41000") 		
	elseif scr_num == "85270" or scr_num == 85270  then	'타기관 은행이체등록
		bdm_choice = "007"
		Form.SetSharedData("BDM_FRST_MAPID", "screen41000") 		
	elseif scr_num == "85280" or scr_num == 85280  then	'메리츠 대체등록
		bdm_choice = "008"
		Form.SetSharedData("BDM_FRST_MAPID", "screen41000") 		
