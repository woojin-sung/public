Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mbisa56040_p1" then
	
		if sRet == "cancel" then
			ContMain1.contBtm.chk2.checkstate = "0"
		else
			ContMain1.contBtm.edtBank.caption = sRet
		end if
		
	end if
	
End Sub

