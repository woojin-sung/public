'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문 주문확인창
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


Dim g_nCount
	g_nCount = 0

Dim g_nIndex				' 
Dim g_szOrder_MarketType	' 주문종류 ( J:주식, W:ELW )
Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szOrd_ItmCode		' 종목코드
Dim 	g_szOrd_ItmName		' 종목명
Dim 	g_szOrd_OrdType		' 주문구분
Dim 	g_szOrd_Security		' 현금/신용
Dim 	g_szOrd_SecType		' 신용구분
Dim 	g_szOrd_SecDate		' 대출일자
Dim 	g_nOrd_Qty			' 주문수량
Dim 	g_nOrd_Price			' 주문가격
Dim 	g_nOrd_OrdNo			' 원주문번호
Dim 	g_nOrd_ChkAll			' 잔량전부	
Dim g_szINPUT_ODER_KIND_CODE
Dim g_szLOAN_DTL_TYPE_CODE
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)

	If g_nOrd_ChkAll = "1" Then
	    g_nOrd_Qty = "잔량전부"
	End If

	Dim szStr1,szStr2,szStr3
	szStr1 = left(g_szOrder_Acc,4)
	szStr2 = mid(g_szOrder_Acc,5,4)
	szStr3 = right(g_szOrder_Acc,2)
	'현금
	tblModi.SetCellString( 0, 1, szStr1.."-".. szStr2 .."-".. szStr3.." "..g_szOrder_AccName)
	tblModiSin.SetCellString( 0, 1, szStr1.."-".. szStr2 .."-".. szStr3.." "..g_szOrder_AccName)

'	매도수구분 (2:매수, 1:매도)
	if CInt(g_nIndex) == 2 then
		tblModi.SetCellString( 1, 1, "매수")'매매구분 + 색상 변경
		tblModi.SetCellFgColor(1,1,326)
		tblModiSin.SetCellString( 1, 1, "매수")'매매구분 + 색상 변경
		tblModiSin.SetCellFgColor(1,1,326)
		
		'	   g_szLOAN_DTL_TYPE_CODE
		if CInt(g_szOrd_SecDate) == 0 then'현금
			tblModi.visible = true
			tblModiSin.visible = false
		else'신용
			tblModi.visible = false
			tblModiSin.visible = true
			Image0.top = 366
			Image0.height = 355
			tblModiSin.SetCellString( 2, 1, "신용융자")
		end if
	elseif CInt(g_nIndex) == 1 then
		tblModi.SetCellString( 1, 1, "매도")'매매구분 + 색상 변경
		tblModi.SetCellFgColor(1,1,331)
		tblModiSin.SetCellString( 1, 1, "매도")'매매구분 + 색상 변경
		tblModiSin.SetCellFgColor(1,1,331)
		
		Dim szText
		szText = ""

		if g_szINPUT_ODER_KIND_CODE <> "" or g_szLOAN_DTL_TYPE_CODE <> "" then	'신용 대출 or '유통융자 자기융자 등
			tblModi.visible = false
			tblModiSin.visible = true
			
			Image0.top = 366
			Image0.height = 355
			
			if g_szINPUT_ODER_KIND_CODE <> "" then
				szText = g_szINPUT_ODER_KIND_CODE
			end if
			
			if g_szLOAN_DTL_TYPE_CODE <> "" then		'유통융자 자기융자 등
				szText = g_szLOAN_DTL_TYPE_CODE
			end if
			
			if CInt(g_szOrd_SecDate) == 0 then'현금
				szText = szText.." | 합산"
			else'신용
				szText = szText.." | 20"..left(g_szOrd_SecDate,2).."."..mid(g_szOrd_SecDate,3,2).."."..right(g_szOrd_SecDate,2)
			end if
			
			tblModiSin.SetCellString( 2, 1, szText)
		else
			tblModi.visible = true
			tblModiSin.visible = false
		end if
'	elseif CInt(g_nIndex) == 2 then
'		tblModi.SetCellString( 1, 1, "정정")'매매구분 + 색상 변경
'		tblModi.SetCellFgColor(1,1,328)
'	elseif CInt(g_nIndex) == 3 then
'		tblModi.SetCellString( 1, 1, "취소")'매매구분 + 색상 변경
'		tblModi.SetCellFgColor(1,1,329)
'	elseif CInt(g_nIndex) == 11 then
'		tblModi.SetCellString( 1, 1, "예약매수")'매매구분 + 색상 변경
'		tblModi.SetCellFgColor(1,1,326)
'	elseif CInt(g_nIndex) == 12 then
'		tblModi.SetCellString( 1, 1, "예약매도")'매매구분 + 색상 변경
'		tblModi.SetCellFgColor(1,1,331)
'	elseif CInt(g_nIndex) == 14 then
'		tblModi.SetCellString( 1, 1, "예약취소")'매매구분 + 색상 변경
'		tblModi.SetCellFgColor(1,1,329)
	end if

	f_SetSize()
	
	tblModi.SetCellString( 2, 1, g_szOrd_ItmName		)
	tblModi.SetCellString( 3, 1, g_szOrd_OrdType		)
	
	tblModiSin.SetCellString( 3, 1, g_szOrd_ItmName		)
	tblModiSin.SetCellString( 4, 1, g_szOrd_OrdType		)
	
	if g_nOrd_ChkAll == "1" then
		tblModi.SetCellString( 4, 1, g_nOrd_Qty			)
		tblModiSin.SetCellString( 5, 1, g_nOrd_Qty			)
	else
		tblModi.SetCellString( 4, 1, FormatNumber(g_nOrd_Qty,0).."주"			)'마스킹 처리
		tblModiSin.SetCellString( 5, 1, FormatNumber(g_nOrd_Qty,0).."주"			)'마스킹 처리
	end if
	
	if g_nOrd_Price == "" then
		tblModi.SetCellString( 5, 1, "-" 		)
		tblModiSin.SetCellString( 6, 1, "-" 		)
	else
		tblModi.SetCellString( 5, 1, FormatNumber(g_nOrd_Price,0).."원" 		)'마스킹 처리
		tblModiSin.SetCellString( 6, 1, FormatNumber(g_nOrd_Price,0).."원" 		)'마스킹 처리
	end if
	
	tblModi.SetCellString( 6, 1, g_nOrd_OrdNo		)
	tblModiSin.SetCellString( 7, 1, g_nOrd_OrdNo		)

'	If g_szOrder_MarketType = "W" Then	'ELW
'	    lblModifyTitle.Caption = "ELW 정정주문"
'    End If
	   
End Function

function f_SetSize()
	if tblModiSin.visible == true or tblModiSin.visible == 1 or tblModiSin.visible == "1" then
		imgMain.top = 276
		Label0.top = 276
		lblMaesu1Title.top = 276
		Label3.top = 336
		Image0.top = 366
		Image0.height = 206
	end if
end function

'============================================================================
Function SendOrder()
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문전송" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
    End If
    
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	g_nIndex				= arrData( 0) ' 2매수 1매도
	g_szOrder_MarketType	= arrData( 1)	' 주문종류 ( J:주식, W:ELW )
	g_szOrder_Acc			= arrData( 2)	' 계좌번호
	g_szOrder_AccName		= arrData( 3)	' 고객명
	g_szOrd_ItmCode 		= arrData( 4)	' 종목코드
	g_szOrd_ItmName 		= arrData( 5)	' 종목명
	g_szOrd_OrdType  		= arrData( 6)	' 주문구분
	g_szOrd_Security 		= arrData( 7)	' 현금/신용
	g_szOrd_SecType 		= arrData( 8)	' 신용구분
	g_szOrd_SecDate 		= arrData( 9)	' 대출일자
	g_nOrd_Qty   			= arrData(10)	' 주문수량
	g_nOrd_Price 			= arrData(11)	' 주문가격
	g_nOrd_OrdNo 			= arrData(12)	' 원주문번호
	g_nOrd_ChkAll 		= arrData(13)	' 잔량전부
	g_szINPUT_ODER_KIND_CODE = arrData(14)	' 대출 신용 공란
	g_szLOAN_DTL_TYPE_CODE = arrData(15)	'유통융자/자기융자/예탁주식(대출)/공란
End Sub

'============================================================================
Sub Form_OnFormInit()
    Set_Data(g_nIndex)
    
End Sub

'============================================================================
Sub btnmodi_OnClick()
	SendOrder()
End Sub

'============================================================================
Sub btnModiClose_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>