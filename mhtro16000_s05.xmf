	contMain.lblData12.fgcolor = g_szTxtColor_Normal
	contMain.lblData12.paddinginfo = "0,0,0,0"
	
	contMain.imgTooltip0.setMaintainingRatio("2")
	contMain.imgTooltip0.imgpath = g_szToolTipImg
	
	nTextWidth = Form.getTextWidth("연보수", -4, true, false)
	contMain.imgTooltip0.left = 217 + nTextWidth

	contMain.lblTitle9.setNeighborCtlPos("imgTooltip0", "right", 3, "연보수")
	
	contMove.btnHyun.paddinginfo = "0,0,0,0"
