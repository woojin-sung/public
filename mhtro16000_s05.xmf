	contMain.lblTitle5.paddinginfo = "0,0,0,0"
	contMain.lblTitle6.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle6.paddinginfo = "0,0,0,0"
	contMain.lblTitle7.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle7.paddinginfo = "0,0,0,0"
	contMain.lblTitle8.fgcolor = g_szTxtColor_Grey
	contMain.lblTitle8.paddinginfo = "0,0,0,0"
