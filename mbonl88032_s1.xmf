Dim g_szPwd					'계좌 비밀번호
Dim g_szPhoneNum, g_szPhoneInagTypeCode, g_szPhoneInagSrno		'알림톡/문자 정보
Dim g_szEmail, g_szEmailInagTypeCode, g_szEmailInagSrno		'이메일 정보
Dim g_szFnprJoinSrno			'금융상품가입일련번호
Dim g_szSvcSrno				'서비스 일련번호
Dim g_szCustNum				'고객번호
Dim g_szRegAcno, g_szRegAsno	'약정체결한 계좌번호(해지처리시 사용)

Dim g_szProcType
DIm gTactYn

'============================================================================
Sub Form_OnFormInitBefore()
	imgBack.setMaintainingRatio("1")
	imgInfo.setMaintainingRatio("1")
	contReg.imgCheck0.setMaintainingRatio("1")
	contReg.imgCheck1.setMaintainingRatio("1")
	contReg.imgCheck2.setMaintainingRatio("1")
	contReg.imgAmtInfo.setMaintainingRatio("1")
	contReg.imgCtcnInfo.setMaintainingRatio("1")
	contReg.imgTooltip.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	contReg.lblCtcnTitle.setNeighborCtlPos("imgTooltip", "right", 8, "")
	
	g_szCustNum = Form.GetSharedData("&CUST_NUM", false )
	
	if Form.GetEnvData("common.theme") = "black" then
		contReg.btnReg.btnimage = "btn_27.9"
	else
		contReg.btnReg.btnimage = "btn_21.9"
	end if
	contReg.btnReg.fgcolor = "269"	
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
'	szOpenData = "reg"
	if szOpenData == "reg" then
		lblTitle.caption = "바로출금서비스 신청"
		
		contReg.visible = true
		contCancel.visible = false
		
		'등록된 휴대폰번호, 이메일 조회
		if contReg.acnt.caption <> "" and contReg.acnt.caption <> null then
			DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
		else
			contReg.lblBlock.visible = true
		end if
		
	else
		lblTitle.caption = "바로출금서비스 신청내역"
		
		contReg.visible = false
		contCancel.visible = true
		
		'바로출금서비스 약정현황 조회
		if contReg.acnt.caption <> "" and contReg.acnt.caption <> null then
			DATAMANAGER.RequestTranData( "obpds_srvc_436r" )
		end if
		
		'grdList test
'		nCnt = 5
'		contCancel.grdList.rowcount = nCnt
'		contCancel.grdList.SetCellData("bd_title", 0, "서비스 가능계좌")
'		for i = 0 to nCnt - 1
'			contCancel.grdList.SetCellData("bd_acnt", i, "1234567810")
'		next
'		
'		contCancel.grdList.height = 30 * nCnt
'		
'		contCancel.btnCancel.top = 180 + (30 * nCnt)
'		contCancel.imgBg.height = 210 + (30 * nCnt)
	end if
	
'	gTactYn = Form.GetSharedData("mbonl88032_s1_TactYn", false )
'Form.ShowAlert("gTactYn", gTactYn)	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'약관팝업 리턴
	if sKeyName == "mbonl88032_p2" then
		if sRet == "ok" then
			g_szProcType = "1"
			
			'약관 정상확인 후 계좌비밀번호 체크
			Form.openPopupAnimation( "pwdcheckpopup", contReg.acnt.caption & "☆2", "", "2" )
		end if
	
	'계좌 비밀번호 팝업 리턴
	elseif sKeyName == "CORRECT_PWD" and sRet <> "" and sRet <> null then
		Dim tPwd
		tPwd = Split(sRet, "★") '"nPwdLen★sEncPwd(암호화된 비밀번호)"
		
		if UBOUND(tPwd) > 0 then
			g_szPwd = tPwd(0)
			
			'약정등록
			if g_szProcType == "1" then
				'2023-06-08 추가인증절차 삭제 -> 바로 인증서 인증 수행
				'계좌 비밀번호 정상 확인 후 추가인증 + 인증서 인증 절차 진행
				'Form.OpenFramePopup("mhetc90060_p8" , "svc_ins" , "")
				
				Dim szCertUseType 
					
				'0.공인인증서(ID로그인,인증서로그인) 1.간편인증(공인인증서) 2.코스콤지문(공인인증서) 3.결제원(FIDO인증서) 4.금투협(공동인증서)
				szCertUseType = Form.GetSharedData("&CERT_USE_TYPE", false )  '로그인타입
				
				if szCertUseType == "1" or szCertUseType == 1 then '간편인증
					Form.OpenFramePopup( "mhetc90060_px" , "" , "" )		'공인인증서_비밀번호입력 풀팝업
				else
					Form.OpenFramePopup( "mhetc90060_p5" , "" , "" )		'공인인증서_비밀번호입력 풀팝업
				end if
				
			'약정해지
			else
				Dim szCertUseType 
			
				'0.공인인증서(ID로그인,인증서로그인) 1.간편인증(공인인증서) 2.코스콤지문(공인인증서) 3.결제원(FIDO인증서) 4.금투협(공동인증서)
				szCertUseType = Form.GetSharedData("&CERT_USE_TYPE", false )  '로그인타입
				
				if szCertUseType == "1" or szCertUseType == 1 then '간편인증
					Form.OpenFramePopup( "mhetc90060_px" , "" , "" )		'공인인증서_비밀번호입력 풀팝업
				else
					Form.OpenFramePopup( "mhetc90060_p5" , "" , "" )		'공인인증서_비밀번호입력 풀팝업
				end if
			end if
		end if
	
	'추가인증 리턴
	elseif sKeyName == "mhetc90060_p8" and sRet == "ok" then
		Dim szCertUseType 
			
		'0.공인인증서(ID로그인,인증서로그인) 1.간편인증(공인인증서) 2.코스콤지문(공인인증서) 3.결제원(FIDO인증서) 4.금투협(공동인증서)
		szCertUseType = Form.GetSharedData("&CERT_USE_TYPE", false )  '로그인타입
		
		if szCertUseType == "1" or szCertUseType == 1 then '간편인증
			Form.OpenFramePopup( "mhetc90060_px" , "" , "" )		'공인인증서_비밀번호입력 풀팝업
		else
			Form.OpenFramePopup( "mhetc90060_p5" , "" , "" )		'공인인증서_비밀번호입력 풀팝업
		end if
	
	'공동인증 및 바이오인증 완료
	elseif sKeyName == "mhetc90060_p5" then
		if sRet ~= "cancel" then
			if g_szProcType == "1" then
				'금융상품가입일련번호 채번
				DATAMANAGER.RequestTranData( "obsap_acif_999a" )
			else
				'바로출금서비스 약정해지
				DATAMANAGER.RequestTranData( "obpds_srvc_435a_1" )
			end if
		end if
		
	'간편인증 완료
	elseif sKeyName == "mhetc90060_px" then
		if sRet == "ok" then
			if g_szProcType == "1" then
				'금융상품가입일련번호 채번
				DATAMANAGER.RequestTranData( "obsap_acif_999a" )
			else
				'바로출금서비스 약정해지
				DATAMANAGER.RequestTranData( "obpds_srvc_435a_1" )
			end if
		end if
	
	'연락처 변경
	elseif sKeyName == "mbonl81000" and sRet == "ok" then
		DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
	
	'약정완료팝업
	elseif sKeyName == "mbonl88032_p3" then
'Form.ShowAlert("test", sRet)	
		'닫아서 초기안내화면 보여줌
		'Form.SendReturnToParent("mbonl88032_s1" , "")
		Form.SendReturnToParent("mbonl88032_p3" , sRet)
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "CANCEL_CONFIRM" and sRet == "ok" then
		g_szProcType = "2"
		
		Form.openPopupAnimation( "pwdcheckpopup", g_szRegAcno & g_szRegAsno & "☆2", "", "2" )
	
	elseif sKeyName == "CANCEL_COMPLETE" then
		Form.SendReturnToParent("mbonl88032_s1" , "CancelSucc")
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'등록된 휴대폰번호, 이메일 조회
	if szTranID == "obcsb_acif_140r" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , contReg.acnt.total)
	
	'가입계약서류 제공방식 관리
	elseif szTranID == "obcsb_acad_122a" then
		if CInt(contReg.rdoCtcn.currentindex) == 0 then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "HNDV_MTHD_CODE" , 0 , "04")
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "INAG_TYPE_CODE" , 0 , "13")
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UI_CUST_TEL_NO" , 0 , g_szPhoneNum)
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "INAG_SRNO" , 0 , g_szPhoneInagSrno)
		else
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "HNDV_MTHD_CODE" , 0 , "02")
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "INAG_TYPE_CODE" , 0 , "21")
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ADDR" , 0 , g_szEmail)
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "INAG_SRNO" , 0 , g_szEmailInagSrno)
		end if
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "FNPR_JOIN_SRNO" , 0 , g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1")
	
	'바로출금서비스 약정신청
	elseif szTranID == "obpds_srvc_435a" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CSNO" , 0 , g_szCustNum)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SVCD" , 0 , "093")
'		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SVC_SRNO" , 0 , "0")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , contReg.acnt.total)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" , 0 , contReg.acnt.sequence)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , g_szPwd)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4")
	
	'바로출금서비스 약정해지
	elseif szTranID == "obpds_srvc_435a_1" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "3")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CSNO" , 0 , g_szCustNum)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SVCD" , 0 , "093")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SVC_SRNO" , 0 , g_szSvcSrno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , contCancel.acnt.total)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" , 0 , contCancel.acnt.sequence)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , g_szPwd)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4")
		
	'계약서류 교부처리
	elseif szTranID == "obcsb_dbif_322a" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , contReg.acnt.total)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "FNPR_JOIN_SRNO" , 0 , g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSWR_LRDV_CODE" , 0 , "017")
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "FNPR_JOIN_DETL_SRNO" , 0 , "00001")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "ISCD" , 0 , "093")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "BSWR_DIV_CODE" , 0 , "02093")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "CNRC_DOCU_KEY_VAL" , 0 , g_szCustNum & "$" & "093" & "$" & g_szSvcSrno )
	
	'바로출금서비스 약정현황 조회
	elseif szTranID == "obpds_srvc_436r" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SVCD" , 0 , "093")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CSNO" , 0 , g_szCustNum)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , contCancel.acnt.total)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" , 0 , contCancel.acnt.sequence)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'등록된 휴대폰번호, 이메일 조회
	if szTranID == "obcsb_acif_140r" then
		Dim nCnt, nCnt1
		if DATAMANAGER.IsMoreNextData(szTranID) = True then
			DATAMANAGER.RequestNextData(szTranID)
		else
			'이메일 주소
			nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2")
			for i = 0 to nCnt - 1
			    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_TYPE_CODE" , i)
			    strInagSrno2     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_SRNO"      , i)
			    strAddr          = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ADDR"           , i)
			    if strInagTypeCode2 = "21" then
					g_szEmail = strAddr
					g_szEmailInagTypeCode = strInagTypeCode2
					g_szEmailInagSrno = strInagSrno2
			    end if
			next 	
			'휴대폰 번호
			nCnt1 = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock3")
			for i = 0 to nCnt1 - 1
			    strInagTypeCode3 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_TYPE_CODE" , i)
			    strInagSrno3     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_SRNO"      , i)
			    strCustTelno     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UI_CUST_TELNO"  , i)
			    if strInagTypeCode3 = "13" then
				    g_szPhoneNum = strCustTelno
				    g_szPhoneInagTypeCode = strInagTypeCode3
				    g_szPhoneInagSrno = strInagSrno3
			    end if
			next
		end if
		
		'재조회 시 표시영역에 바뀐 정보 보여줌
		if CInt(contReg.rdoCtcn.currentindex) == 0 then
			contReg.tblCtcn.SetCellString(0, 0, g_szPhoneNum)
			contReg.lblCtcnInfo.caption = "고객정보에 등록된 휴대폰 번호로 발송되오니, 휴대폰 번호를 반드시 확인해 주세요."
		elseif CInt(contReg.rdoCtcn.currentindex) == 1 then
			contReg.tblCtcn.SetCellString(0, 0, g_szEmail)
			contReg.lblCtcnInfo.caption = "고객정보에 등록된 이메일로 발송되오니, 이메일 주소를 반드시 확인해 주세요."
		end if
	
	'금융상품가입일련번호 채번
	elseif szTranID == "obsap_acif_999a" then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO"  , 0)
		
		'가입계약서류 제공방식 관리
		DATAMANAGER.RequestTranData( "obcsb_acad_122a" )
	
	'가입계약서류 제공방식 관리
	elseif szTranID == "obcsb_acad_122a" then
		'바로출금서비스 약정신청
		DATAMANAGER.RequestTranData( "obpds_srvc_435a" )
	
	'바로출금서비스 약정신청
	elseif szTranID == "obpds_srvc_435a" then
		g_szSvcSrno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SVC_SRNO"  , 0)
		
		'계약서류 교부처리
		DATAMANAGER.RequestTranData( "obcsb_dbif_322a" )
		
	'계약서류 교부처리
	elseif szTranID == "obcsb_dbif_322a" then
		
		'완료화면 오픈
		Form.OpenPopup("mbonl88032_p3" , "" , "")
	
	'바로출금서비스 약정현황 조회
	elseif szTranID == "obpds_srvc_436r" then
		g_szRegAcno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ACNO"  , 0)
		g_szRegAsno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ASNO"  , 0)
		g_szSvcSrno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SVC_SRNO"  , 0)
		
		Dim szHndvMthdCode, szStplAmt
		szHndvMthdCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "HNDV_MTHD_CODE"  , 0)
		szStplAmt = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "STPL_AMT"  , 0)
		
'		contCancel.tblData.SetCellString(0, 1, g_szRegAcno & g_szRegAsno)
		contCancel.tblData.SetCellString(0, 1, szStplAmt)
		if szHndvMthdCode == "04" then
			contCancel.tblData.SetCellString(1, 1, "알림톡·문자")
		else
			contCancel.tblData.SetCellString(1, 1, "이메일")
		end if
		
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock2")
		if nCnt > 0 then
			contCancel.grdList.rowcount = nCnt
			contCancel.grdList.SetCellData("bd_title", 0, "서비스 가능계좌")
			
			Dim szAcno, szAsno
			Dim nRowIdx
			nRowIdx = CInt(contCancel.grdList.rowcount)
			for i = 0 to nCnt - 1
				szAcno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ACNO"  , i)
				szAsno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ASNO"  , i)
				
				contCancel.grdList.SetCellData("bd_acnt", i, szAcno & szAsno)
				
				contCancel.grdList.height = 30 * nCnt + 2
				contCancel.btnCancel.top = 200 + (30 * nCnt)
				contCancel.imgBg.height = 180 + (30 * nCnt)
			next
			
			'다 세팅 되고 그리드 보임 처리
			contCancel.grdList.visible = true
		end if
	
	'바로출금서비스 약정해지
	elseif szTranID == "obpds_srvc_435a_1" then
		Form.MsgBox("알림", "바로출금서비스 약정이 해지되었습니다.", "CANCEL_COMPLETE", 6)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szMsgCode, szMsgText, szSubText
	szMsgCode = DATAMANAGER.GetDataMsgCode(szTranID)
	szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
	szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szSubText <> "" and szSubText <> null then
		Form.ShowAlert("알림", szMsgText & "(" & szSubText &")")
	else
		Form.ShowAlert("알림", szMsgText)
	end if
End Sub

'============================================================================
Sub contReg_rdoCtcn_OnClick(nIndex)
	contReg.tblCtcn.visible = true
	contReg.lblCtcnInfo.visible = true
	contReg.imgCtcnInfo.visible = true
	
	if nIndex == 0 then
		contReg.tblCtcn.SetCellString(0, 0, g_szPhoneNum)
		contReg.lblCtcnInfo.caption = "고객정보에 등록된 휴대폰 번호로 발송되오니, 휴대폰 번호를 반드시 확인해 주세요."
	else
		contReg.tblCtcn.SetCellString(0, 0, g_szEmail)
		contReg.lblCtcnInfo.caption = "고객정보에 등록된 이메일로 발송되오니, 이메일 주소를 반드시 확인해 주세요."
	end if
	
	contReg.btnReg.enable = true
	
	contReg.btnReg.btnimage = "btn_20.9"
	contReg.btnReg.fgcolor = "273"
End Sub

'============================================================================
Sub contReg_btnReg_OnClick()
	'약관팝업
	Form.OpenPopupAnimation("mbonl88032_p2", "", "", "2")
End Sub

'============================================================================
Sub contReg_tblCtcn_OnClick(lRow , lColumn)
	'연락처 정보 변경
	if lRow == 0 and lColumn == 1 then
		Form.OpenFramePopup("mbonl81000" , "" , "")
	end if
End Sub

'============================================================================
Sub contCancel_btnCancel_OnClick()
	Form.MsgBox("알림", "바로출금서비스 약정을\n해지하시겠습니까?", "CANCEL_CONFIRM", 7, "확인", "취소")
End Sub

'============================================================================
Sub contReg_imgTooltip_OnClick()
	contReg.imgTooltip.openToolTip("약관, 설명서 등 확인 서류를\n알림톡·문자 또는 이메일로 받을 수 있어요.", 300, 60, 1)
End Sub

'============================================================================
Sub imgBack_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
Sub imgInfo_OnClick()
	Form.OpenFramePopup("mbonl88032_p4" , "" , "")
End Sub

