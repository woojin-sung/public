'============================================================================
' 01.화면명 	: 펀드매매_매수신청완료팝업
' 02.화면설명	: 
' 03.작성	: 2021.08.03 JHY
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szMode
Dim g_szReturn

g_szMode = ""
g_szReturn = ""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' getListItem(szInput, nIdx) : 해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			if Ubound(szList) >= nIdx then
				if szList(nIdx) <> NULL then
					return szList(nIdx)
				else
					return
				end if
				
			else
				return
			end if
		else
			return
		end if 
	end if 
end function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	tblInfo.visible = false
	tblConfirm.visible = false
	
	Dim szData
	szData = Form.GetOpenLinkData()
	
	g_szMode = getListItem(szData, 0)
	
	if g_szMode == "confirm" then
		tblConfirm.visible = true
		btnLeft.visible = true
		btnRight.visible = true
		lblDesc.visible = true
		
		tblConfirm.SetCellString( 0, 1, getListItem(szData, 1)) '계좌번호
		lblFndName.caption = getListItem(szData, 2) '펀드명
		tblConfirm.SetCellString( 2, 1, getListItem(szData, 3)) '저축방법
		tblConfirm.SetCellString( 3, 1, getListItem(szData, 4)) '매수신청금액
		
		lblFndName.top = 100
		lblLine.top = 320
		lblTitle.caption = "신규매수 가입 확인"
		
		Form.height = 405
	
	else
		tblInfo.visible = true
		btnFull.visible = true
		
		Dim szCafuYN '숙려대상여부
		szCafuYN = getListItem(szData, 6)
		
		if szCafuYN == "Y" then
			tblInfo.SetCellString( 3, 1, "투자의사확정 후 확인 가능") '결제일
			tblInfo.SetCellFgColor( 3, 1, "10" )
			tblInfo.SetCellMaskInfo( 3, 1, "1,0,,,1,,0,1,1,0,0" )
			tblInfo.SetCellString( 6, 1, "숙려대상") '숙려대상여부
		else
			tblInfo.SetCellString( 3, 1, getListItem(szData, 3)) '결제일
			tblInfo.SetCellString( 6, 1, "해당없음") '숙려대상여부
		end if
		
		lblFndName.caption = getListItem(szData, 0) '펀드명
		tblInfo.SetCellString( 1, 1, getListItem(szData, 1)) '저축방법
		tblInfo.SetCellString( 2, 1, getListItem(szData, 2)) '매수신청금액
		tblInfo.SetCellString( 4, 1, getListItem(szData, 4)) '선취수수료
		tblInfo.SetCellString( 5, 1, getListItem(szData, 5)) '접수번호
	end if
End Sub

'============================================================================
' ImageClose_OnClick : 팝업 닫기
'============================================================================
Sub ImageClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnFull_OnClick : 팝업 닫기
'============================================================================
Sub btnFull_OnClick
	Form.CloseForm()
End Sub

'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("close_mbfnp51010_p11" , g_szReturn)
End Sub
'============================================================================
Sub btnLeft_OnClick()	
	Form.CloseForm()
End Sub

'============================================================================
' btnRight_OnClick() : 매수 신청 날리도록 리턴
'============================================================================
Sub btnRight_OnClick()
	if g_szMode == "confirm" then
		g_szReturn = "BUY"
	end if
	
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
