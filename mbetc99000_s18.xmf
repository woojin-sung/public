Sub Form_OnFormInit()

 incl_clcd = CStr(Form.GetSharedData("incl_clcd", false))
 
 
 	if incl_clcd == "1" then
		Label2.caption = "안정형"
	  
		elseif incl_clcd == "2" then
		Label2.caption = "안정추구형"
	
		elseif incl_clcd =="3" then
		Label2.caption = "중립형"
	
		elseif incl_clcd == "4" then
		Label2.caption = "수익추구형"
	
		elseif incl_clcd =="5" then
		Label2.caption = "고수익추구형"
	
		end if





 Label0.visible = 0
 
 select_cnt = 0
 select_prtf_id=""
 cnt_flag = 0
 
 DATAMANAGER.SetDataValue(0, "obcpp_intr_771r", "InBlock1", "INVT_OBJT_TYPE_NAME" , 0 , CStr(Form.GetSharedData("purpose", false))) '투자목적
 DATAMANAGER.SetDataValue(0, "obcpp_intr_771r", "InBlock1", "INP_INVT_INCL_CLCD" , 0 , CStr(Form.GetSharedData("incl_clcd", false))) '투자성향
 
 DATAMANAGER.SetDataValue(0, "obcpp_intr_771r", "InBlock1", "CNRC_PRD" , 0 , Cint(Form.GetSharedData("input3", false))) '투자기간개월수
 DATAMANAGER.SetDataValue(0, "obcpp_intr_771r", "InBlock1", "INVT_AMT", 0 , Cint(Form.GetSharedData("input1", false)*10000)) '투자금액
 DATAMANAGER.SetDataValue(0, "obcpp_intr_771r", "InBlock1", "UI_ERT_MAX_VAL", 0 , Cint(Form.GetSharedData("input10", false))) '목표자금 최대 기대 수익률
 DATAMANAGER.SetDataValue(0, "obcpp_intr_771r", "InBlock1", "UI_ERT" , 0 , Cint(Form.GetSharedData("input4", false))) '목표자금 목표 수익률
 DATAMANAGER.SetDataValue(0, "obcpp_intr_771r", "InBlock1", "UI_ERT_MIN_VAL", 0 , Cint(Form.GetSharedData("input6", false))) '목표자금 최소 기대 수익률
 
 DATAMANAGER.SetDataValue(0, "obcpp_intr_771r", "InBlock1", "OMBN_FULL_NRSN_STAC_STAS_PRC", 0 , Cdbl(Form.GetSharedData("prd_avrg_prc", false))) '투자기간 가이드값
 DATAMANAGER.SetDataValue(0, "obcpp_intr_771r", "InBlock1", "OMBN_FULL_NRSN_STAS_PRC", 0 , Cdbl(Form.GetSharedData("tmp_avrg_prc", false))) '투자금액 가이드값
 DATAMANAGER.SetDataValue(0, "obcpp_intr_771r", "InBlock1", "OMBN_FULL_RNVS_STAS_PRC", 0 , Cdbl(Form.GetSharedData("ert_1_avrg_prc", false))) '목표자금 최대 기대 수익률 가이드값
 DATAMANAGER.SetDataValue(0, "obcpp_intr_771r", "InBlock1", "OMBN_FULL_RNVS_STND_PRC" , 0 , Cint(Form.GetSharedData("ert_avrg_prc", false))) '목표자금 목표 수익률 가이드값
 DATAMANAGER.SetDataValue(0, "obcpp_intr_771r", "InBlock1", "OMBN_FULL_RSDT_STAC_STAS_PRC", 0 , Cint(Form.GetSharedData("ert_2_avrg_prc", false))) '목표자금 최소 기대 수익률 가이드값
 
 'DATAMANAGER.SetDataValue(0, "obcpp_intr_714r", "InBlock1", "PRTF_ID" , 0 , "%%")
 
 
'DATAMANAGER.SetDataValue(0, "obcpp_intr_722r", "InBlock1", "EXPT_ERT" , 0 , Cint(Form.GetSharedData("input4", false))) '기대수익률 -> 목표수익률
'DATAMANAGER.SetDataValue(0, "obcpp_intr_722r", "InBlock1", "INVT_EXPT_ERT", 0 , Cint(Form.GetSharedData("input5", false))) '투자기대수익률 ->기대최대수익률
'DATAMANAGER.SetDataValue(0, "obcpp_intr_722r", "InBlock1", "PRTF_EXPT_ERT", 0 , Cint(Form.GetSharedData("input6", false))) '포트폴리오 기대수익률 -> 기대최저수익률

'DATAMANAGER.SetDataValue(0, "obcpp_intr_722r", "InBlock1", "INVT_OBJT_TYPE_NAME" , 0 ,Form.GetSharedData("purpose", false) ) '투자목적
'DATAMANAGER.SetDataValue(0, "obcpp_intr_722r", "InBlock1", "INP_INVT_INCL_CLCD" , 0 , Cint(Form.GetSharedData("incl_clcd", false)) ) '고객 투자성향 
'DATAMANAGER.SetDataValue(0, "obcpp_intr_722r", "InBlock1", "INVT_PRD_MN_CNT" , 0 , Cint(Form.GetSharedData("input3", false))) '투자기간개월수
'DATAMANAGER.SetDataValue(0, "obcpp_intr_722r", "InBlock1", "INVT_AMT", 0 , Cint(Form.GetSharedData("input1", false))) '투자금액


 Grid0.SetVisibleCol(1, 0)
 c_score = 0
 
 'DATAMANAGER.SetDataValue(0, "obcpp_intr_714r", "InBlock2", "PRTF_ID" , 0 , "%%")

 
 DATAMANAGER.RequestTranData("obcpp_intr_771r")
 
 tmp_cnt = 0
 
 real_data_cnt = 0
 real_i = 0
 
 
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if cnt_flag == 0 then
		cnt = DATAMANAGER.GetDataCount(0, "obcpp_intr_771r" ,"OutBlock1")
	
	   for i = 0 to cnt-1
	
		if DATAMANAGER.GetDataValue(0, "obcpp_intr_771r", "OutBlock1", "ADCP_NAME", i) == "" then
		'아무것도 안함
		
		else
		real_data_cnt = real_data_cnt + 1
		
		
		
		end if
		
	   next
	   
	   if DATAMANAGER.IsMoreNextData("obcpp_intr_771r") then
			DATAMANAGER.RequestNextData("obcpp_intr_771r")
	
	
	   else
		   cnt_flag = 1
		'   Form.ShowAlert("리얼데이터끝 다음 함수 호출", real_data_cnt)
		Form.ShowAlert("포트폴리오 추천결과", "총 "&real_data_cnt&" 건의 포트폴리오가 추천되었습니다.")
		   
		   for i = 0 to real_data_cnt-2
			   Grid0.AddRow()
			next
		   
		 '  Form.SetTimerEvent(0, 0, 0.1)
		   
		   DATAMANAGER.RequestTranData("obcpp_intr_771r")
		   
		  '   Form.SetTimerEvent(0, 0, 5)
		   
		   
		   
	   end if
	   
	   
'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''	   
		
		
   elseif cnt_flag == 1 then 
   
	
	cnt = DATAMANAGER.GetDataCount(0, "obcpp_intr_771r" ,"OutBlock1")
	
	if cnt == 0 then 
'	Form.ShowAlert("포트폴리오 추천결과", "추천된 포트폴리오가 없습니다.")
	Grid0.SetDeleteRow(0)
	Label0.visible = 1
	
	
	else
	
	
	Label0.visible = 0
	
	tmp_cnt = tmp_cnt+cnt
	
	
'	Form.MsgBox("테스트", cnt&"/"&tmp_cnt, "", "")
	
	for i = 0 to cnt-1
	
		
	
	'	if real_i == real_data_cnt then
	'	exit for
	'	end if
	
		if DATAMANAGER.GetDataValue(0, "obcpp_intr_771r", "OutBlock1", "ADCP_NAME", i) == "" then
		'아무것도 안함
		
	
		else 
		
	'	Grid0.AddRow()
		
		tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_771r", "OutBlock1", "ADCP_NAME", i)
		Grid0.SetCellData("bd_cell7", real_i, tmp)
	
	
		tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_771r", "OutBlock1", "PRTF_NAME", i)
		Grid0.SetCellData("bd_cell8", real_i, tmp)
		
	'	Form.ShowAlert("테스트", real_i&"/"&tmp)
	
	
		tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_771r", "OutBlock1", "INP_INVT_INCL_CLCD", i) '위험등급'
	
	
	
	
		if abs(tmp) == 1 then
		tmp = "안정형"
	  
		elseif abs(tmp) == 2 then
		tmp = "안정추구형"
	
		elseif abs(tmp) ==3 then
		tmp = "중립형"
	
		elseif abs(tmp) == 4 then
		tmp = "수익추구형"
	
		elseif abs(tmp) ==5 then
		tmp = "고수익추구형"
	
		end if
	
	
		Grid0.SetCellData("bd_cell9", real_i, tmp)
	
	
		tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_771r", "OutBlock1", "FERT", i) '수수료
		Grid0.SetCellData("bd_cell10", real_i, Cint(tmp)&"%")
	
	
		tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_771r", "OutBlock1", "ANTC_ERT", i) '예상수익률
		Grid0.SetCellData("bd_cell11", real_i, Cint(tmp)&"%")
	
	
		tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_771r", "OutBlock1", "PRTF_ID", i) '포트폴리오코드
		Grid0.SetCellData("bd_cell14", real_i, tmp)
	
	
		tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_771r", "OutBlock1", "INP_RBDV_VLPN", i) '고객평점
		c_score = round(tmp)
	
	
	
		if round(tmp) == 0 then
		tmp = "☆☆☆☆☆"
	
	
		elseif round(tmp) == 1 then
		tmp = "★☆☆☆☆"
	  
		elseif round(tmp) == 2 then
		tmp = "★★☆☆☆"
	
		elseif round(tmp) ==3 then
		tmp = "★★★☆☆"
	
		elseif round(tmp) == 4 then
		tmp = "★★★★☆"
	
		elseif round(tmp) ==5 then
		tmp = "★★★★★"
	
		end if
	
	
	
	
	
		Grid0.SetCellData("bd_cell12", real_i, tmp)
		Grid0.SetCellData("bd_cell0", real_i, "자문사명")
		Grid0.SetCellData("bd_cell1", real_i, "포트폴리오명")
		Grid0.SetCellData("bd_cell2", real_i, "위험등급")
		Grid0.SetCellData("bd_cell3", real_i, "수수료")
		Grid0.SetCellData("bd_cell4", real_i, "예상수익률")
		Grid0.SetCellData("bd_cell5", real_i, "고객평가")
	
	
		Grid0.SetCellData("bd_cell6", real_i, "비교선택")
		Grid0.SetCellFgColor("bd_cell6", real_i, 90)
	
		Grid0.SetCellData("bd_cell13", real_i, "상세보기")
		Grid0.SetCellFgColor("bd_cell13", real_i, 90)
	
		Grid0.SetCellBgColor("bd_cell21",real_i, "23")
	
		Grid0.SetCellBgColor("bd_cell0", real_i, "90")
		Grid0.SetCellBgColor("bd_cell1", real_i, "90")
		Grid0.SetCellBgColor("bd_cell2", real_i, "90")
		Grid0.SetCellBgColor("bd_cell3", real_i, "90")
		Grid0.SetCellBgColor("bd_cell4", real_i, "90")
		Grid0.SetCellBgColor("bd_cell5", real_i, "90")
		
		
		real_i = real_i +1 
		
		
		
	
	
		end if 'else의 end if -> 데이터가 있으면 그리드에 추가
	
	
	 next
	
	
	if DATAMANAGER.IsMoreNextData("obcpp_intr_771r") == true then
	
	'Form.SetTimerEvent(0, 0, 10)
	DATAMANAGER.RequestNextData("obcpp_intr_771r")
	
	
	end if
	
	
	end if''''''''

	end if 'cnt_flag = 1 의 end if
	
	
	
	
	
	'Form.ShowAlert("리얼아이", real_i)
	
	
'	for j = real_i to tmp_cnt
'	Grid0.SetDeleteRow(j)
	
'	next
	
	
	
	
End Sub


