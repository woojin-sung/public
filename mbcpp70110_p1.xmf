'============================================================================
Sub Form_OnFormClose()
	
	Form.PostLinkData("TAB_CHANGE","1")
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "CLOSEPLZ" then
		if sValue == "1" then
			Form.CloseForm()
			Form.SendReturnToParent("POPUP_CLOSE" , "1")
		end if
	elseif sKey == "POPUP_CLOSE" then
		if sValue == "mbcpp70130.xmf" then
			Form.CloseForm()
		elseif sValue == "mbcpp70110_t4.xmf" then
			Form.CloseForm()
		end if
	end if
End Sub

