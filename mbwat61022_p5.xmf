	<SCRIPT_INFO _len="4834" _ulen="4692" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Wrap 계약정보 변경
' 02. 화면설명 : 
' 03. 이    력 : 2022.10.21 : 고승연 : v0001 : 신규개발
'                2024.01.19 : 고승연 : v0002 : 예약시간 기준 수정
'-------------------------------------------------------------------------------------------

Dim g_sAsisTime

'============================================================================
Sub Form_OnFormInitBefore()
	imgClose.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim sData
	sData = Form.GetOpenLinkData()
	g_sAsisTime = Form.GetSharedData("AsisTime", true)
	
	if sData <> null and sData <> "" then
		Dim tData, nAmCnt, nPmCnt, bNoDataFlag
		tData = Split(sData, "|")
		nAmCnt = 0
		nPmCnt = 0
		bNoDataFlag = true
		
		for i = 0 to #tData-1 step 4
			Dim sTime, sText, sStartTime, sEndTime
			
			sStartTime = TransTime(tData(i))
			sEndTime = TransTime(tData(i+1))
			sTime = Mid(sStartTime, 1, Len(sStartTime) - 2).." : "..Mid(sStartTime, Len(sStartTime) - 1, 2).." ~ "
			sTime = sTime..Mid(sEndTime, 1, Len(sEndTime) - 2).." : "..Mid(sEndTime, Len(sEndTime) - 1, 2)
			
			if g_sAsisTime <> null and g_sAsisTime == sTime then
				sText = "예약"
				bNoDataFlag = false
			elseif (tonumber(tData(i+2)) - tonumber(tData(i+3)) > 0) then
				sText = "예약가능"
				bNoDataFlag = false
			else
				sText = "예약불가"
			end if
			
			'Form.ShowAlert(tonumber(tData(i)) & ":" & TransTime("1200"))
			
			'if tonumber(tData(i)) == tonumber(sStartTime) then
			if tonumber(tData(i)) < tonumber(TransTime("1200")) then
				grdAM.AddRow()
				grdAM.SetCellData("time", nAmCnt, sTime)
				grdAM.SetCellData("text", nAmCnt, sText)
				grdAM.SetCellData("starttime", nAmCnt, tData(i))
				grdAM.SetCellData("endtime", nAmCnt, tData(i+1))
				
				if sText == "예약" then
					grdAM.SetCellFgColor("text", nAmCnt, "001")
				elseif sText == "예약가능" then
					grdAM.SetCellFgColor("text", nAmCnt, "002")
				else
					grdAM.SetCellFgColor("time", nAmCnt, "146")
					grdAM.SetCellFgColor("text", nAmCnt, "146")
				end if
				
				nAmCnt = nAmCnt + 1
				
			else
				grdPM.AddRow()
				grdPM.SetCellData("time", nPmCnt, sTime)
				grdPM.SetCellData("text", nPmCnt, sText)
				grdPM.SetCellData("starttime", nPmCnt, tData(i))
				grdPM.SetCellData("endtime", nPmCnt, tData(i+1))
				
				if sText == "예약" then
					grdPM.SetCellFgColor("text", nPmCnt, "001")
				elseif sText == "예약가능" then
					grdPM.SetCellFgColor("text", nPmCnt, "002")
				else
					grdPM.SetCellFgColor("time", nPmCnt, "146")
					grdPM.SetCellFgColor("text", nPmCnt, "146")
				end if
				
				nPmCnt = nPmCnt + 1
				
			end if
		next
		
		if bNoDataFlag then
			lblNoData.visible = bNoDataFlag
			imgBg.top = 200 - 10
			imgBg.height = 452 + 60
			lblTitle.top = 227 - 20
			imgClose.top = 225 - 10
			lblAM.top = 260 - 20
			grdAM.top = 282 - 20
			lblPM.top = 415 - 20
			grdPM.top = 437 - 20
		end if
	end if
End Sub

Function TransTime(sTime)
	Dim sTranTime
	sTranTime = ""
	
	if tonumber(sTime) >= 1300 then
		sTranTime = tostring(tonumber(sTime) - 1200)
	else
		sTranTime = tostring(tonumber(sTime))
	end if
	
	Dim nLength
	nLength = len(sTranTime)
	
	if nLength < 4 then
		for i = nLength to 3
			sTranTime = "0"..sTranTime
		next
	end if
	
	TransTime = sTranTime
End Function

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub grdAM_OnClickUp(lRow, szCellID)
	Dim sText
	sText = grdAM.GetCellData("text", lRow)
	
	if sText == "예약" or sText == "예약가능" then
		Dim sStartTime, sEndTime, sTime
		
		sStartTime = grdAM.GetCellData("starttime", lRow)
		sEndTime = grdAM.GetCellData("endtime", lRow)
		sTime = "오전 "..grdAM.GetCellData("time", lRow)
		
		Form.SendReturnToParent("ABLETIME" , sTime.."|"..sStartTime.."|"..sEndTime)
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub grdPM_OnClickUp(lRow, szCellID)
	Dim sText
	sText = grdPM.GetCellData("text", lRow)
	
	if sText == "예약" or sText == "예약가능" then
		Dim sStartTime, sEndTime, sTime
		
		sStartTime = grdPM.GetCellData("starttime", lRow)
		sEndTime = grdPM.GetCellData("endtime", lRow)
		sTime = "오후 "..grdPM.GetCellData("time", lRow)
		
		Form.SendReturnToParent("ABLETIME" , sTime.."|"..sStartTime.."|"..sEndTime)
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>