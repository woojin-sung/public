	<SCRIPT_INFO _len="12536" _ulen="9762" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 인증서
' 02. 화면설명 : 인증서메인
' 03. 작    성 : 2016.01.13 김보라
'-------------------------------------------------------------------------------------------
'202011126 SWJ START : 공인인증서 '공인'글자 삭제
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim G_EXPORT_CERT_FILE '인증서내보내기풀팝업
Dim G_IMPORT_CERT_FILE '인증서가져오기풀팝업
Dim G_UPDATE_CERT_FILE '인증서갱신풀팝업
Dim G_MGM_CERT_FILE '인증서관리풀팝업
Dim G_REGI_CERT_FILE '인증서발급/타기관등록풀팝업
Dim g_sDeviceOS
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	G_EXPORT_CERT_FILE = "mhetc90060_p1"
	G_IMPORT_CERT_FILE = "mhetc90060_p2"
	G_UPDATE_CERT_FILE = "mhetc90060_p3"
	G_MGM_CERT_FILE = "mhetc90060_p4"
	G_REGI_CERT_FILE = "mhetc90060_p7"
	
	'20211026 SWJ START : 안드로이드 targetSDK ver30 안내 팝업 게시
	'인증센터에서 띄워줄 때
	sOpenYN = Form.LoadConfigData("NoticeSetting", "SDK30_AUTH")
	sDeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	if sOpenYN <> "1" and sDeviceOS = "1" then
		Form.OpenPopup("notice_p7" , "OPEN_FROM_AUTH" , "")
	end if
	'20211026 SWJ END
End Sub
'============================================================================
Sub Table0_OnClick(lRow , lColumn)

	'20160519_01 KBC START
	if lRow == 0 or lRow == 1 or lRow == 2 then '인증서 타기관등록
		Image2_OnClick()'인증서 타기관등록
		
	elseif lRow == 3 or lRow == 4 or lRow == 5  then  '인증서 내보내기 
		Image3_OnClick()'인증서 내보내기 
		
	elseif lRow == 6 or lRow == 7 or lRow == 8 then  '인증서 갱신
		Image4_OnClick()'인증서 갱신
		
	elseif lRow == 9 or lRow == 10 or lRow == 11  then'인증서 관리
		Image5_OnClick()'인증서 관리
		
	end if
	'20160519_01 KBC END

End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == G_EXPORT_CERT_FILE then
		if sRet == "ok" then
			Form.MsgBox( "알림", "인증서 내보내기를 완료하였습니다.", "", 6 )
		end if
	elseif sKeyName == G_IMPORT_CERT_FILE then
		if sRet == "ok" then
			Form.MsgBox( "알림", "인증서 가져오기를 완료하였습니다.", "", 6 )
		end if
	elseif sKeyName == G_UPDATE_CERT_FILE then
		if sRet == "ok" then
			Form.MsgBox( "알림", "인증서 갱신을 완료하였습니다.", "", 6 )
		end if
	elseif sKeyName == G_MGM_CERT_FILE then
		if sRet == "delete" then
			Form.MsgBox( "알림", "인증서 삭제를 완료하였습니다.", "", 6 )
		end if
	elseif sKeyName == G_REGI_CERT_FILE then
		if sRet == "new" then
			Form.MsgBox( "알림", "인증서 발급/재발급을 완료하였습니다.", "", 6 )
		elseif sRet == "regi" then
			Form.MsgBox( "알림", "인증서 타기관 등록을 완료하였습니다.", "", 6 )
		end if
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "UPDATE_MSG" then
		if sRet == "ok" then
			Form.OpenPopup( G_UPDATE_CERT_FILE , "" , "" )
		end if
	elseif sKeyName == "NEW_MSG" then
		if sRet == "ok" then
			Form.OpenPopup( G_REGI_CERT_FILE , "new" , "" )
		end if
	elseif sKeyName == "LOGOUT_MSG" then
		if sRet == "ok" then
			 '20170117 NOHES START : 로그아웃실행
		     '(1param(0:문구없음,1문구있음), 
		     '2param(0:권한상관없이 로그아웃만 함, 1:화면권한에 따라 닫을 화면 닫고 로그아웃 함)
		      Form.LogOut(0, 1) 		
			 '20170117 NOHES END
			
			'20240326 SWJ START : 노민아 과장 요청으로 위치 옮김
			'16-04-15 YCJ 전요셉 과장님 요청사항 로그아웃시 바로 팝업이 뜨게 요청
'			Dim sText
'			sText = "스마트폰(모바일) 상에서 인증서를 발급 받을 경우, 기존의 인증서는 폐기되며, PC에서 발급받은 인증서도 함께 폐기됩니다.\n"..
'					"인증서는 PC로 내보내기하여 사용 가능합니다.\n\n"..
'					"인증서를 발급/재발급 신청을 하시겠습니까?"
'			Form.MsgBox( "인증서 발급/재발급 안내", sText, "NEW_MSG", 1 )
			
			Form.MsgBox( "알림", "로그아웃이 완료되었습니다.", "LOGOUT_MSG_NEW", 6 )
			'20240326 SWJ END
		end if
	'20240326 SWJ START
	elseif sKeyName == "LOGOUT_MSG_NEW" then
			Dim sText
			sText = "스마트폰(모바일) 상에서 인증서를 발급 받을 경우, 기존의 인증서는 폐기되며, PC에서 발급받은 인증서도 함께 폐기됩니다.\n"..
					"인증서는 PC로 내보내기하여 사용 가능합니다.\n\n"..
					"인증서를 발급/재발급 신청을 하시겠습니까?"
			Form.MsgBox( "인증서 발급/재발급 안내", sText, "NEW_MSG", 1 )
		
	'20240326 SWJ END
	
	'20160519_01 KBC START
	'갱신시에도 로그아웃 추가
	elseif sKeyName == "LOGOUT_MSG2" then
		if sRet == "ok" then
			 '20170117 NOHES START : 로그아웃실행
		     '(1param(0:문구없음,1문구있음), 
		     '2param(0:권한상관없이 로그아웃만 함, 1:화면권한에 따라 닫을 화면 닫고 로그아웃 함)
		      Form.LogOut(0, 1) 		
			 '20170117 NOHES END
			
			Dim sText
			sText = "스마트폰(모바일) 상에서 인증서를 갱신 하는 경우, PC 등 다른 매체에 저장된 인증서는 사용이 불가능 합니다.\n"..
					"PC 등 다른 매체에서 인증서를 계속 사용하시려면, 인증서를 갱신 하신 후 PC 등 다른 매체로 복사하여 사용하시면 됩니다.\n\n"..
					"인증서를 갱신 신청을 하시겠습니까?"
			Form.MsgBox( "인증서 갱신 안내", sText, "UPDATE_MSG", 1 )
				
			Form.MsgBox( "알림", "로그아웃이 완료되었습니다.", "", 6 )
			
		end if	
		
	'타기관등록시에도 로그아웃 추가
	elseif sKeyName == "LOGOUT_MSG3" then
		if sRet == "ok" then
			 '20170117 NOHES START : 로그아웃실행
		     '(1param(0:문구없음,1문구있음), 
		     '2param(0:권한상관없이 로그아웃만 함, 1:화면권한에 따라 닫을 화면 닫고 로그아웃 함)
		      Form.LogOut(0, 1) 		
			 '20170117 NOHES END
			
			Form.OpenPopup( G_REGI_CERT_FILE , "regi" , "" )	
			Form.MsgBox( "알림", "로그아웃이 완료되었습니다.", "", 6 )
			
		end if	
		
	'인증서관리시에도 로그아웃 추가
	elseif sKeyName == "LOGOUT_MSG4" then
		if sRet == "ok" then
			 '20170117 NOHES START : 로그아웃실행
		     '(1param(0:문구없음,1문구있음), 
		     '2param(0:권한상관없이 로그아웃만 함, 1:화면권한에 따라 닫을 화면 닫고 로그아웃 함)
		      Form.LogOut(0, 1) 		
			 '20170117 NOHES END
			
			Form.OpenPopup( G_MGM_CERT_FILE , "" , "" )	
			Form.MsgBox( "알림", "로그아웃이 완료되었습니다.", "", 6 )
			
		end if		
	'20160519_01 KBC END
		
	end if
End Sub

'============================================================================
Sub Table1_OnClick(lRow , lColumn)
	Image0_OnClick()
End Sub

'============================================================================
Sub Table2_OnClick(lRow , lColumn)
	'인증서 가져오기
	Form.OpenPopup( G_IMPORT_CERT_FILE , "" , "" )
End Sub

'============================================================================
Sub Image0_OnClick()	
	Dim sLOGIN_TYPE  '인증서 발급/재발급
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
	Form.SetSharedData("CRET_NEW_REG" , "Y")	'20230125 HSZ START : 개인정보 노출자 체크 추가(인증서발급시에만)
	
	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
		Dim sText
		sText = "인증서 발급/재발급을 위하여 로그아웃을 진행하시겠습니까?"	
		Form.MsgBox( "인증서 발급/재발급 안내", sText, "LOGOUT_MSG", 1 )
	else
		Dim sText
		sText = "스마트폰(모바일) 상에서 인증서를 발급 받을 경우, 기존의 인증서는 폐기되며, PC에서 발급받은 인증서도 함께 폐기됩니다.\n"..
			    "인증서는 PC로 내보내기하여 사용 가능합니다.\n\n"..
			    "인증서를 발급/재발급 신청을 하시겠습니까?"
		Form.MsgBox( "인증서 발급/재발급 안내", sText, "NEW_MSG", 1 )
	end if	
End Sub

'============================================================================
Sub Image4_OnClick()'인증서 갱신

	'20160519_01 KBC START
	Dim sLOGIN_TYPE  '인증서 갱신
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )

	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
		Dim sText
		sText = "인증서 갱신을 위하여 로그아웃을 진행하시겠습니까?"	
		Form.MsgBox( "인증서 갱신 안내", sText, "LOGOUT_MSG2", 1 )
	else
		Dim sText
		sText = "스마트폰(모바일) 상에서 인증서를 갱신 하는 경우, PC 등 다른 매체에 저장된 인증서는 사용이 불가능 합니다.\n"..
				"PC 등 다른 매체에서 인증서를 계속 사용하시려면, 인증서를 갱신 하신 후 PC 등 다른 매체로 복사하여 사용하시면 됩니다.\n\n"..
				"인증서를 갱신 신청을 하시겠습니까?"
		Form.MsgBox( "인증서 갱신 안내", sText, "UPDATE_MSG", 1 )
	end if
	'20160519_01 KBC END

End Sub

'============================================================================
Sub Image5_OnClick()'인증서 관리

	'20160519_01 KBC START
	Dim sLOGIN_TYPE  '인증서 관리
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )

	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
		Dim sText
		sText = "인증서 관리를 위하여 로그아웃을 진행하시겠습니까?"	
		Form.MsgBox( "인증서 관리 안내", sText, "LOGOUT_MSG4", 1 )
	else
		Form.OpenPopup( G_MGM_CERT_FILE , "" , "" )
	end if
	'20160519_01 KBC END
	
End Sub

'============================================================================
Sub Image2_OnClick()'인증서 타기관등록

	'20160519_01 KBC START
	Dim sLOGIN_TYPE  '인증서타기관등록
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
	Form.SetSharedData("CRET_NEW_REG" , "N")	'20230125 HSZ START : 개인정보 노출자 체크 추가(인증서발급시에만)

	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
		Dim sText
		sText = "인증서 타기관등록을 위하여 로그아웃을 진행하시겠습니까?"	
		Form.MsgBox( "인증서 타기관등록 안내", sText, "LOGOUT_MSG3", 1 )
	else
		Form.OpenPopup( G_REGI_CERT_FILE , "regi" , "" )
	end if
	'20160519_01 KBC END	
End Sub

