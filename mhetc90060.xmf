' 인증서온라인 신원확인 동의 화면 링크
'============================================================================
Sub BtnLinkPage_OnClick()

	sLoginID = Form.GetSharedData( "&USER_ID", 0 )
	if Trim(sLoginID) == "" then
		Form.MsgBox( "알림", "최초 1회 로그인이 필요합니다.", "", 0 )
	else
'		Form.OpenScreen("81030" , "")
		Form.OpenScreen("85260" , "")	'20230109 HSZ
	end if
	
End Sub
