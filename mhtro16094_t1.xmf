--===========================================================================
--===========================================================================
Dim g_sPlain_rm
Dim g_nSelectRow
Dim g_szAcntInfo
Dim g_nProcCnt
Dim g_tProcRow
Dim g_nProcIdx
g_tProcRow = {}
Dim g_nAbleCnt
'============================================================================
Function f_SetBtnEnable()
	if CInt(grid0.rowcount) > 0 then
		dim bCheckState, nQty, bFlag, nChkCnt
		bFlag = true
		nChkCnt = 0
		for i=0 to CInt(grid0.rowcount)-1 
			nQty = CInt(grid0.GetCellData( "bd_regqty", i ))
			bCheckState = CInt(grid0.GetCellData( "bd_check", i ))
			
			if bCheckState == 1 then
				nChkCnt = nChkCnt + 1
				'수량 입력 여부 확인
				if nQty <= 0 or nQty == "" or nQty == null then
					bFlag = false
				end if
			end if
		next
		
		if nChkCnt > 0 then
			if bFlag == true then
				BtnProcess.enable = true
			else
				BtnProcess.enable = false
			end if
		else
			BtnProcess.enable = false
		end if
	end if
End Function

'============================================================================
Function f_ToDo()
	dim nRowCnt, nIdx
	nRowCnt = CInt(grid0.rowcount)
	nIdx = 0
	if nRowCnt > 0 then
		for i=0 to nRowCnt-1 
			sChk = grid0.GetCellData("bd_check", i)
			
			if sChk == "1" then
				g_tProcRow(nIdx) = i
				nIdx = nIdx + 1
			end if
		next
		g_nProcIdx = 1
		f_GetDataFor493a(g_tProcRow(0))
	else
		Form.ShowAlert("알림", "선택한 종목이 없습니다.")
	end if
End Function

'============================================================================
Function f_GetDataFor493a(iIdx)
	dim szItemCd, nQty
	szItemCd = grid0.GetCellData("bd_itemcd", iIdx)
	nQty = CInt(grid0.GetCellData("bd_regqty", iIdx))
	if (szItemCd <> "" and szItemCd <> null) and (nQty <> 0 and nQty <> null) then
'		Form.ShowAlert(iIdx, nQty)
		f_Request493a(szItemCd, nQty)
	end if
End Function

'============================================================================
Function f_Request493a(szItemCd, nQty)
	dim szTranID
	szTranID = "obtro_stlm_493a"
	
	dim sPwd
	'비밀번호 암호화
	If g_sPlain_rm == "1" Then
		sPwd = Form.GetCtlProp( "#edtPassword", "caption" )
	else
		sPwd = Form.GetCtlProp( "#edtPassword", "encdata" )
	end if
	
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO", 0, Left(g_szAcntInfo,8))
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ASNO", 0, Right(g_szAcntInfo,2))
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNT_PWD", 0, sPwd )
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ISCD", 0, szItemCd )
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "CNVR_QTY", 0, nQty )
	
	DATAMANAGER.RequestTranData( szTranID )
End Function

'============================================================================
Function f_ChageAllCheckState(nType)
	dim nRowCnt
	nRowCnt = CInt(grid0.rowcount)
	if nRowCnt > 0 then
		dim nIntQty
		for i=0 to nRowCnt-1
			'보유잔고 수량이 1이상일 때만 체크 활성화
			nIntQty = CInt(grid0.GetCellData("bd_ableqty", i))
			if nIntQty >= 1 then
				if nType == 1 then
					grid0.SetCellData("bd_check", i, true)
					grid0.SetCellImage("bd_regqty", i, "input_02_n.9")
				else
					grid0.SetCellData("bd_check", i, false)
					grid0.SetCellImage("bd_regqty", i, "input_02_d.9")
					grid0.SetCellData("bd_regqty", i, "")
				end if
			end if
		next
		
		f_SetBtnEnable()
	end if
End Function

'============================================================================
Function f_SetAllCheckState()
	dim nCheck, nChkCnt
	nChkCnt = 0
	if CInt(grid0.rowcount) > 0 then
		for i=0 to CInt(grid0.rowcount)-1
			nCheck = CInt(grid0.GetCellData( "bd_check", i ))
			if nCheck == 1 then
				nChkCnt = nChkCnt + 1
			end if
		next
		if g_nAbleCnt == nChkCnt then
			chkAll.chksilence = "1"
		else
			chkAll.chksilence = "0"
		end if
	end if
End Function

'============================================================================
Function f_SetGridUI(nDataCnt)
	dim nRowCnt, iRow
	nRowCnt = CInt(grid0.rowcount)
	iRow = nRowCnt - nDataCnt
	if nDataCnt > 0 then
		dim nIntQty, szCd, szNm, szQty
		for i=iRow to nRowCnt-1
			dim tCode
			szCd = grid0.GetCellData("bd_itemcd", i)
			szNm = grid0.GetCellData("bd_itemnm", i)
			tCode = Split(szCd, ".")
			nIntQty = CInt(grid0.GetCellData("bd_ableqty", i))
			grid0.SetCellData("bd_text1", i, "전환가능")
			grid0.SetCellData("bd_text2", i, "전환신청")
'			grid0.SetCellData("bd_uicode", i, tCode(0) & " | " & szNm )
			grid0.SetCellData("bd_uicode", i, tCode(0) )
			grid0.SetCellData("bd_split", i, "|" )
			grid0.SetCellData("bd_uiname", i, szNm )
			'Android는 그리드 마스킹에서 공백이 포함된 " 주"가 적용되지만 
			'iOS는 공백을 없애고 마스킹을 적용해버려서 아래와 같이 적용함
			if nIntQty > 0 then
				szQty = FormatNumber(nIntQty, 0) & " 주"
			else
				szQty = "0 주"
			end if
			
			grid0.SetCellData("bd_uiableqty", i, szQty )
			grid0.SetCellImage("bd_regqty", i, "input_02_d.9")
			grid0.SetCellImage("bd_uiableqty", i, "input_02_d.9")
			if nIntQty < 1 then
				grid0.SetCellEnable( "bd_check", i, false )
			end if
		next
	end if
End Function

'============================================================================
Function f_BeforeCheckProc()
	dim sPwd
	sPwd = Form.GetCtlProp( "#edtPassword", "caption" )
'	비밀번호 입력 여부 확인
	if sPwd == "" or sPwd == null then
		Form.ShowAlert("알림", "계좌비밀번호를 입력해 주세요.")
		return false
	end if
	
	if CInt(grid0.rowcount) > 0 then
		dim bCheckState, nChkCnt, nQty
		nChkCnt = 0
		for i=0 to CInt(grid0.rowcount)-1 
			nQty = CInt(grid0.GetCellData( "bd_regqty", i ))
			bCheckState = CInt(grid0.GetCellData( "bd_check", i ))
			if bCheckState == 1 then
				nChkCnt = nChkCnt + 1
				'수량 입력 여부 확인
				if nQty <= 0 or nQty == "" or nQty == null then
					Form.ShowAlert("알림", "전환신청 수량을 입력해 주세요.")
					return false
				end if
			end if
		next
		g_nProcCnt = nChkCnt
		'Check 상태 확인
		if nChkCnt == 0 then
			Form.ShowAlert("알림", "선택한 종목이 없습니다.")
			return false
		end if
	else
		'보유잔고 확인
		Form.ShowAlert("알림", "보유잔고가 없습니다.")
		return false
	end if
	
	return true
End Function
'============================================================================
Sub Form_OnFormInit()
	g_sPlain_rm = Form.GetSharedData("&PLAIN_RM" , false) '암호화 여부
	grid0.setUseCardView(true, 15, "input_03_n.9")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obtro_stlm_490r" then
		dim sPwd
		'비밀번호 암호화
		If g_sPlain_rm == "1" Then
			sPwd = Form.GetCtlProp( "#edtPassword", "caption" )
		else
			sPwd = Form.GetCtlProp( "#edtPassword", "encdata" )
		end if
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO", 0, Left(g_szAcntInfo,8))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ASNO", 0, Right(g_szAcntInfo,2))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNT_PWD", 0, sPwd )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtro_stlm_490r" then
		dim nDataCnt
		nDataCnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
		if nDataCnt > 0 then
			f_SetGridUI(nDataCnt)
			
			dim isMore
			isMore = DATAMANAGER.IsMoreNextData( szTranID )
			if isMore == "1" or isMore == true or isMore == 1 then
				DATAMANAGER.RequestNextData( szTranID )
				Exit Sub
			end if
			
			g_nAbleCnt = 0
			lblNoData.visible = false
			Label0.visible = true
			
			grid0.visible = true
'			BtnProcess.enable = true
			Label1.visible = true
			chkAll.visible = true
			
			dim nQty
			if CInt(grid0.rowcount) > 0 then
				for i=0 to CInt(grid0.rowcount)-1
					nQty = CInt(grid0.GetCellData( "bd_ableqty", i ))
					if nQty > 0 then
						g_nAbleCnt = g_nAbleCnt + 1
					end if
				next
			end if
		else
			lblNoData.visible = true
			Label0.visible = false
			grid0.visible = false
			grid0.visible = true
			BtnProcess.enable = false
			Label1.visible = false
			chkAll.visible = false
		end if
	elseif szTranID == "obtro_stlm_493a" then
		if g_nProcCnt > g_nProcIdx then
			g_nProcIdx = g_nProcIdx + 1
			f_GetDataFor493a(g_tProcRow(g_nProcIdx-1))
		else
			DATAMANAGER.RequestTranData( "obtro_stlm_490r" )
			'Form.ShowAlert("알림", "전환 신청이 완료되었습니다.\r\n전환내역을 확인해 주세요.")
			Form.OpenPopup("mhtro16094_p3" , "" , "")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtro_stlm_490r" or szTranID == "obtro_stlm_493a" then
		dim szSubMsg
		szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		if szSubMsg <> "" and szSubMsg <> null then
			Form.ShowAlert("알림", szErrMsg & " " & szSubMsg)
		else
			Form.ShowAlert("알림", szErrMsg)
		end if
	end if
End Sub

'============================================================================
Sub btnAllChk_OnClick()
	if CInt(chkAll.checkstate) == 0 then
		chkAll.chksilence = "1"
		f_ChageAllCheckState(1)
	else
		chkAll.chksilence = "0"
		f_ChageAllCheckState(0)
	end if
End Sub

'============================================================================
Sub grid0_OnClickUp(lRow, szCellID)
	if szCellID == "bd_regqty" or szCellID == "bd_check" then
		if szCellID == "bd_regqty" then
			dim nQty, nChkState
			g_nSelectRow = lRow 
			nQty = CInt(grid0.GetCellData( "bd_ableqty", lRow ))
			
			if nQty >= 1 then
				dim nRegQty, nAbleQty, sItemNm
				nRegQty = CInt(grid0.GetCellData( "bd_regqty", lRow ))
				nAbleQty = CInt(grid0.GetCellData( "bd_ableqty", lRow ))
				sItemNm = grid0.GetCellData( "bd_itemnm", lRow )
				
				Form.OpenPopup("mhtro16094_p1", nRegQty&"★"&nAbleQty&"★"&sItemNm, "")
			else
				Form.ShowAlert("알림", "전환 가능수량이 없습니다.")
				Exit Sub
			end if
		elseif szCellID == "bd_check" then
			nQty = CInt(grid0.GetCellData( "bd_ableqty", lRow ))
			nChkState = CInt(grid0.GetCellData( "bd_check", lRow ))
			
			if nChkState == 1 then
				if nQty >= 1 then
					grid0.SetCellImage("bd_regqty", lRow, "input_02_n.9")
				else
					grid0.SetCellData( "bd_check", lRow, "0" )
					Form.ShowAlert("알림", "전환 가능수량이 없습니다.")
					Exit Sub
				end if
			else
				grid0.SetCellImage("bd_regqty", lRow, "input_02_d.9")
				grid0.SetCellData("bd_regqty", lRow, "")
			end if
			
			f_SetAllCheckState()
			f_SetBtnEnable()
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "QTY_POPUP" then
		dim nQty, nRegQty
		nQty = CInt(grid0.GetCellData( "bd_ableqty", g_nSelectRow ))
		nRegQty = CInt(sRet)
		if nRegQty > nQty then
			Form.ShowAlert("알림", "보유 수량 내에서 입력해 주세요.")
		else
			grid0.SetCellData( "bd_regqty", g_nSelectRow, nRegQty )
			grid0.SetCellData( "bd_check", g_nSelectRow, "1" )
			
			f_SetBtnEnable()
		end if
	elseif sKeyName == "Refresh" then
		grid0.rowcount = 0
		DATAMANAGER.RequestTranData( "obtro_stlm_490r" )
	elseif sKeyName == "ShowTransList" then
		Form.triggerEvent("#", sKeyName, sRet)
	end if
End Sub

'============================================================================
Sub BtnProcess_OnClick()
	if f_BeforeCheckProc() then
		Form.MsgBox("알림", "전환 후 취소가 불가합니다.\r\n전환 신청 하시겠습니까?", "REG", 1)
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REG" then
		if sRet == "ok" then
			f_ToDo()
		end if
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "Request" then
		g_szAcntInfo = sParam
		grid0.rowcount = 0
		Label1.visible = false
		chkAll.visible = false
		if Form.GetCtlProp( "#edtPassword", "caption" ) <> "" and Form.GetCtlProp( "#edtPassword", "caption" ) <> null then
'		if g_szAcntInfo <> "" and g_szAcntInfo <> null then
			DATAMANAGER.RequestTranData( "obtro_stlm_490r" )
		end if
	end if
End Sub




