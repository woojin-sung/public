'============================================================================
Sub Form_OnFormInitBefore()
'	contMain.imgMain.setMaintainingRatio("1")
	
	'20231128_01 HWG START : 고해상도 이미지 적용(임시조치)
	sOsType = Form.GetSharedData("&OS_TYPE", false)
	
	if sOsType = "2" then
'		contMain.imgMain.imgpath = "super365_main_total2"
		contMain.imgMain.imgpath = "super365_main_total3"
	else
		sSdkVer = Form.GetSharedData("&SDK_VERSION", false)
		
		if cint(sSdkVer) > 27 then
'			contMain.imgMain.imgpath = "super365_main_total2"	
			contMain.imgMain.imgpath = "super365_main_total3"	
		end if
	end if
	'20231128_01 HWG END
	
	ImgBackPress.setMaintainingRatio("1")
	contInfo.imgTopTitle.setMaintainingRatio("1")
	
	contMain.imgNum1.setMaintainingRatio("1")
	contMain.imgNum2.setMaintainingRatio("1")
	contMain.imgNum3.setMaintainingRatio("1")
	
	contMain.contCheck.Image1.setMaintainingRatio("1") '20240415 KKM 추가	
	'contMain.imgMain.setMaintainingRatio("1") '20240415 KKM 추가	

End Sub

'============================================================================
Sub Form_OnFormInit()	
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	
'	if szOSType == "1" then
'		contMain.btnMove.top = 2865
'		contMain.btnMove.top = 2850
'	end if
'	contMain.imgMain.height = 2932
'	contMain.contCheck.top = 2932 + 20
'	contMain.lblText.top = 2932 + 20 + 32 

	'20240412 KKM 위치조정 START
	if szOSType == "1" then
		contMain.btnMove.top = 3415
	end if
	contMain.imgMain.height = 3440
	contMain.contCheck.top = 3440 + 60
	contMain.lblText.top = 3440 + 60 + 32 	
	'20240412 KKM 위치조정 END
	
	g_szOpenData = Form.GetOpenLinkData()
	if g_szOpenData <> "" and g_szOpenData <> null then
		contInfo.lblSubText10.visible = false
		
		'잠시 백버튼 풀어줌.. 화면 이탈할때 다시 잠금
		Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")
		
		'20240118 HSZ START: 스크롤 위치이동 기능 추가
		if Instr(g_szOpenData, "★") > 0 then
			szData = Split(g_szOpenData, "★")
			g_szScroll = szData(1)
		end if
		'20240118 HSZ END
	end if
	
	lblTitleBg.bgcolor = "351"
	
	Form.SetTimerEvent(1, 1, 1)

'FOR test	
'	g_szScroll =  "RP"
'	g_szScroll =  "BARO"
'	g_szScroll =  "FEE"
'	g_szScroll =  "SIN"
'	g_szScroll =  "OVERSEA" '해외추가
'	g_szScroll =  "OTHER"   '타사추가
End Sub

'============================================================================
Sub contMain_contCheck_btnFold_OnClick()
	Dim szimgFile

	if bFoldState then
		szimgFile = "btn_filter.9.png"
	else
		szimgFile = "btn_filter2.9.png"
	end if
	
	bFoldState = not bFoldState
	contMain.contCheck.btnFold.btnimage = szimgFile
	f_ShowInfo(bFoldState)
End Sub

'============================================================================
Function f_ShowInfo(bState)
'	if bState then
'		contMain.lblText.top = 2984+1165+1025-20	'Label999.top + Table2.height + Table3.height
'		contMain.contCheck.height = 1165+1025+30	'''Table2.height +Table3.height + 50
'		contMain.SetScrollAutoSize()
'		contMain.scroll_pos = 	2952
'	else
'		contMain.lblText.top = 2984
'		contMain.contCheck.height = 32
'		contMain.SetScrollAutoSize()
'	end if


	'20240412 KKM 위치조정 START
	if bState then
		contMain.lblText.top = 3532+1099+1325 - 67 + 80 ''Label999.top + Table2.height + Table3.height
		contMain.contCheck.height = 1090+1325 + 80	''''Table2.height +Table3.height + 50
		contMain.SetScrollAutoSize()
		contMain.scroll_pos = 	3500
	else
		contMain.lblText.top = 3532
		contMain.contCheck.height = 32
		contMain.SetScrollAutoSize()
	end if
	'20240412 KKM 위치조정 END
End Function 

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "LOGOUT_MSG" then	'로그아웃 후
		if sRet == "ok" then
			'1parm (0.문구없음 1.문구있음)
			'2parm (0.권한상관없이 로그아웃만 함 1.화면권한에 따라 닫을 화면 로그아웃)
			Form.LogOut(0,1)
			Form.SetSharedData("&SCREEN_AUTH" , "99")
			Form.OpenPopup("mbbdm85100", ",★Super365Acnt", "")
			'Form.OpenPopup("mbbdm86130", "Super365Acnt", "")
		end if
	end if
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	'비대면 타고 들어왔을때만 다시 백버튼 잠금
	if g_szOpenData == "BDM" then
		Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	end if
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	ImgBackPress_OnClick()
End Sub

'============================================================================
Sub contMain_btnMove_OnClick()
	'계좌개설하기 클릭
	dim sloginType
	sloginType = Form.GetSharedData( "&LOGIN_TYPE", false )

	if Cint(sloginType) > 1 then
		sText = "로그아웃이 필요한 메뉴입니다. 로그아웃하시겠습니까?"
		Form.MsgBox("알림",sText, "LOGOUT_MSG" , 1 )
	else
		Form.SetSharedData("&SCREEN_AUTH" , "99")
		Form.OpenPopup("mbbdm85100", "★Super365Acnt", "")
		'Form.OpenPopup("mbbdm86130", "Super365Acnt", "")
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obsim_bdsv_023r" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "INRT_APLY_DATE" , 0 , g_ChkDate)
	elseif szTranID == "oblon_basc_503r" then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "STND_DATE" , 0 , g_ChkDate)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obsim_bdsv_023r" then
	
		Dim nCnt
		if DATAMANAGER.IsMoreNextData(szTranID) = True then
			DATAMANAGER.RequestNextData(szTranID)
		else
			'이메일 주소
			nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
			for i = 0 to nCnt - 1
			    strIscd 	  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD" , i)
			    strAplyInrt = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "APLY_INRT"      , i)
			    
			    if strIscd == "RP10200" then
				    contMain.TblRPrt.SetCellString(0, 0, strAplyInrt)
			    elseif strIscd == "USDRP200" then	    
			        contMain.TblRPrt.SetCellString(1, 0, strAplyInrt)
			    end if
			next 
			
			DATAMANAGER.RequestTranData( "oblon_basc_503r" )
			
		end if	
		
	elseif szTranID == "oblon_basc_503r" then
		Svcd093RtDate = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock4", "APLY_STA_DATE" , 0)
		Svcd093Rt     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock4", "UI_APLY_MNRT1" , 0)
		
		contMain.LblDate2.caption = Left(Svcd093RtDate,4)&"."&Mid(Svcd093RtDate,5,2)&"."&Right(Svcd093RtDate,2) &" 기준"
		contMain.TblSvc093Rt.SetCellString(0, 0, Svcd093Rt)
		
		CrdtRtDate = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "APLY_STA_DATE" , 0)
		CrdtRt1    = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_APLY_MNRT1" , 0)
		CrdtRt2    = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_APLY_MNRT3" , 0)
		CrdtRt3    = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_APLY_MNRT4" , 0)
		
		contMain.LblDate3.caption = Left(CrdtRtDate,4)&"."&Mid(CrdtRtDate,5,2)&"."&Right(CrdtRtDate,2) &" 기준"
		contMain.TblCrdtRt.SetCellString(0, 0, CrdtRt1)
		contMain.TblCrdtRt.SetCellString(0, 1, CrdtRt2)
		contMain.TblCrdtRt.SetCellString(0, 2, CrdtRt3)
	end if
End Sub
'============================================================================
Sub Form_OnTimerEvent(sTimerID)  
	If sTimerID == "1" or sTimerID == 1 Then
		Form.SetTimerEvent(1, 0, 1)
		g_ChkDate = Form.GetSharedData("&HOST_DATE",0)	'v0001
		DATAMANAGER.RequestTranData( "obsim_bdsv_023r" )
		
		contMain.LblDate1.caption = Left(g_ChkDate,4)&"."&Mid(g_ChkDate,5,2)&"."&Right(g_ChkDate,2) &" 기준"
		
		'금리는 나중에..
		contMain.TblRPrt.visible = true
		contMain.LblDate2.visible = true
		contMain.TblSvc093Rt.visible = true
		contMain.TblCrdtRt.visible = true
		contMain.LblDate3.visible = true
		
		'20240118 HSZ START: 스크롤 위치이동 기능 추가
		if Trim(g_szScroll) = "" then
			exit Sub
		else
			szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
			if szDeviceOS == "2" then	'iOS
				call Scroll_iOS()
			else						'안드
				call Scroll_AOS()
			end if
		end if
		'20240118 HSZ END
	End If
End Sub

'20240118 HSZ START: 스크롤 위치이동 기능 추가
'============================================================================
Sub Scroll_AOS()
	Dim nScrollpos
	Select Case g_szScroll
	Case "RP"     'RP
		nScrollpos = 740
	Case "BARO"   '바로출금
		nScrollpos = 1950
	Case "FEE"    '수수료
		nScrollpos = 1250
	Case "SIN"    '신용
		nScrollpos = 1665
	Case "OVERSEA" '20240412 KKM 해외주식 추가
		nScrollpos = 2710	
	Case "OTHER"   '20240412 KKM 타사 추가
		nScrollpos = 2395			
	End Select
	contMain.scroll_pos = nScrollpos
End Sub
'============================================================================
Sub Scroll_iOS()
	Dim nScrollpos
	Select Case g_szScroll
	Case "RP"
		contMain.scroll_pos_noAni = contMain.scroll0.top
	Case "BARO"
		contMain.scroll_pos_noAni = contMain.scroll1.top
	Case "FEE"
		contMain.scroll_pos_noAni = contMain.scroll2.top
	Case "SIN"
		contMain.scroll_pos_noAni = contMain.scroll3.top
	Case "OVERSEA" '20240412 KKM 해외주식 추가
		contMain.scroll_pos_noAni = contMain.scroll4.top
	Case "OTHER"     '20240412 KKM 타사 추가
		contMain.scroll_pos_noAni = contMain.scroll5.top
	End Select
End Sub
'20240118 HSZ END
