'============================================================================
' 화 면 명 : 야간선물옵션주문_미체결팝업
' 화면설명 : 야간선물옵션주문 정정/취소화면에서 미체결버튼 클릭시 오픈
' 작    성 : 2017.04.25
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szFundCd, g_szFundPwd, g_Tab	'20200331 HWG : 고유MTS


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	Dim tData
	
	Form.SetScreenName("(야)선물옵션미체결")	

	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szFundCd   	= tData(0) '20200331 HWG : 고유MTS
		g_szFundPwd 	= tData(1) '20200331 HWG : 고유MTS
		g_Tab     	= tData(2)

		DATAMANAGER.RequestTranData("obtrf_cntg_821r")	'20200331 HWG : 고유MTS
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szDate
	
	'20200331 HWG START : 고유MTS
	' ----------------------------------------------------------------------
	' 장내파생 계좌별 주문체결 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtrf_cntg_821r" then
		grdList.rowcount = 0
		DATAMANAGER.ClearInputData(0, "obtrf_cntg_821r")
		
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_821r", "InBlock1", "ACNO" 			, 0, "000000" & Left(g_szFundCd,2))	' 펀드코드
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_821r", "InBlock1", "ASNO" 			, 0, Right(g_szFundCd,2))			' 펀드코드
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_821r", "InBlock1", "ACNT_PWD" 		, 0, g_szFundPwd)					' 비밀번호
		
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_821r", "InBlock2", "DEAL_CLS_CODE" 	, 0, "%")		' 매매구분코드
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_821r", "InBlock2", "IQRY_CLS_CODE"	, 0, "0")		' 조회구분코드
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_821r", "InBlock2", "DATA_CLS"		, 0, "1")		' 데이터 구분
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_821r", "InBlock2", "UNAS_CNFG_CLCD"	, 0, "0") 		' 기초자산구성구분코드
	end if
	'20200331 HWG END
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szData

	' ----------------------------------------------------------------------
	' 장내파생 계좌별 주문체결 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtrf_cntg_821r" then	'20200331 HWG : 고유MTS
		For i = 0 To grdList.rowcount - 1
			'20200331 HWG START : 고유MTS
			szCd = Right(grdList.GetCellData( "bd_Cd", i), 8)
			szNm = Form.GetItemCodeInfo(szCd, "name_night")
			grdList.SetCellData("bd_Nm", i, szNm)
			'20200331 HWG END
			
			'매매구분
			szData = grdList.GetCellData( "bd_Gbn", i)
			Select Case szData
				Case "1" grdList.SetCellData("bd_GbnNm", i, "매도")
						grdList.SetCellFgColor("bd_GbnNm", i, "11")
				Case "2" grdList.SetCellData("bd_GbnNm", i, "매수")
						grdList.SetCellFgColor("bd_GbnNm", i, "10")
				Case "3" grdList.SetCellData("bd_GbnNm", i, "매수청산")
				Case "4" grdList.SetCellData("bd_GbnNm", i, "매도청산")
				Case "5" grdList.SetCellData("bd_GbnNm", i, "권리행사")
				Case "6" grdList.SetCellData("bd_GbnNm", i, "의무배정")
				Case "7" grdList.SetCellData("bd_GbnNm", i, "행사포기")
				Case "8" grdList.SetCellData("bd_GbnNm", i, "의무면제")
				Case "A" grdList.SetCellData("bd_GbnNm", i, "인수대금")
				Case "B" grdList.SetCellData("bd_GbnNm", i, "인도대금")
				Case "C" grdList.SetCellData("bd_GbnNm", i, "단주행사")
				Case "D" grdList.SetCellData("bd_GbnNm", i, "단주배정")
				Case "0" grdList.SetCellData("bd_GbnNm", i, "상계")
			End Select
			
			'주문유형
			szData = grdList.GetCellData( "bd_Type", i)
			Select Case szData
				Case "1" grdList.SetCellData("bd_TypeNm", i, "시장가")
				Case "2" grdList.SetCellData("bd_TypeNm", i, "지정가")
				Case "3" grdList.SetCellData("bd_TypeNm", i, "경쟁대량(현물만 해당)")
				Case "I" grdList.SetCellData("bd_TypeNm", i, "조건부지정가")
				Case "X" grdList.SetCellData("bd_TypeNm", i, "최유리 지정가")
				Case "Y" grdList.SetCellData("bd_TypeNm", i, "최우선 지정가")
				Case "T" grdList.SetCellData("bd_TypeNm", i, "시장가(실시간 가격제한)")
				Case "W" grdList.SetCellData("bd_TypeNm", i, "최유리지정가(실시간 가격제한)")
				Case "J" grdList.SetCellData("bd_TypeNm", i, "지정가 전환")		
			End Select
		Next
	end if
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szOdrNo, szOdrType, szOdrPrc, szClsCd, szData
	
	if lRow > -1 then
		szCd      = grdList.GetCellData("bd_Cd", lRow)
		szCd = Mid(szCd, 2, Len(szCd))
		
		szMk = Form.GetItemCodeInfo(szCd, "market_night")
		
		'20200331 HWG START : 고유MTS
		' 지수선물/미니선물/옵션/미니옵션만 가능
'		if Trim(szMk) == "CM" or Trim(szMk) == "EO" or Trim(szMk) == "EM" then		
			szQty     = grdList.GetCellData("bd_MicheQty", lRow)
			szOdrNo   = grdList.GetCellData("bd_OdrNo",    lRow)	
			szOdrType = grdList.GetCellData("bd_Type",     lRow)
			szOdrPrc  = grdList.GetCellData("bd_OdrPrc",   lRow)
			szClsCd   = grdList.GetCellData("bd_ClsCd",    lRow)
			
			' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
			szData = "미체결" & "★" & g_Tab & "★" & szCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd
			
			Form.SendReturnToParent("01000_CONTRACT", szData)	'20200331 HWG : 고유MTS
			Form.CloseForm()
'		else
'			Form.ShowAlert("알림", "선택상품은 MTS에서 거래되지 않는 상품입니다.")
'		end if
		'20200331 HWG END
	end if	
End Sub

'============================================================================
' btnInquiry_OnClick : 조회버튼
'============================================================================
Sub btnInquiry_OnClick()
	DATAMANAGER.RequestTranData("obtrf_cntg_821r")	'20200331 HWG : 고유MTS
End Sub

