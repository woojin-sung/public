Sub imgSearch_OnClick()
	Form.OpenPopup("mhtro16080_p4" , g_szFullAcnt , "")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	Dim szTempData
	szTempData = Split(sRet, ";")

	if sKeyName =		"16080_Frbalc" then
		if sRet = "1"		then
			'1. 설정값 가져옴
			szFrCrcd	= Form.GetSharedData("G_bcpp_commonFrCd", 0 )
			g_szCrcd = Left(szFrCrcd, 3)
			szFrBalc	= Form.GetSharedData("G_bcpp_commonFrBalc", 0 )
			szFrBalcMax = Form.GetSharedData("G_bcpp_commonFrBalcMax", 0 ) 'v003
			
			'화면 초기화 함수
			Call cleardata()
			
			btnAddSell.enable = True
			
			'매수하려는 매수통화 세팅
			edtCrcd.caption = szFrCrcd
			
			'최대환전가능금액 v003
			edtAbleMax.caption = szFrBalcMax
			'매도가능금액 세팅
			edtAble.caption = szFrBalc
			'외화 환율 조회
			DATAMANAGER.RequestTranData("obtsd_fbnk_201r")
			
			'v001 sta ============================
	
			DATAMANAGER.SetDataValue(0, "obrtp_comn_035r" , "InBlock1" , "BASC_CODE" , 0 , "EXCAP"                 )
	
			if Left(edtCrcd.caption, 3) = "USD" Or Left(edtCrcd.caption, 3) = "CNY" Or Left(edtCrcd.caption, 3) = "CNH" Or Left(edtCrcd.caption, 3) = "HKD" Or Left(edtCrcd.caption, 3) = "JPY" then
			    DATAMANAGER.SetDataValue(0, "obrtp_comn_035r", "InBlock1", "DTL_CODE"  , 0 , Left(edtCrcd.caption, 3))
			else
			    DATAMANAGER.SetDataValue(0, "obrtp_comn_035r", "InBlock1", "DTL_CODE"  , 0 , "ETC")
			end if
	
			DATAMANAGER.RequestTranData("obrtp_comn_035r")
	
			'v001 fin ============================
			
			
		else
			Form.ShowAlert("알림", "매수할 통화를 선택바랍니다.")
			
		end if
	'20220418 아이티젠 김성수 추가
'	elseif sKeyName = "mhetc90060_p5" then
	elseif sKeyName = "mhetc90060_p5" or sKeyName = "mhetc90060_px" then
		'20220418 아이티젠 김성수 추가
		if szTempData(0) == "ok" or sRet == "ok" then
			DATAMANAGER.RequestTranData("obtsd_fbnk_202a")
		else
			exit sub
		end if
		
	end if
End Sub

