'--===========================================================================
' 01.화면명 		: 실시간환전신청
' 02.화면설명		: 실시간환전신청_외화매도탭
' 03.작성		: 2018.01.15
' 04.수정         : 2020.03.23. v001 장원혁 : 통화별 1회 한도 적용
'                 : 2020.10.08. v002 장원혁 : 메모리 평문 제거
'                 : 2021.09.02. v003 장원혁 : 통합증거금 개발
'                 : 2022.08.23. v005 장원혁 : 다드림계좌 개발
'--===========================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szFullAcnt	'계좌번호 (8+2)
dim	g_szPasswd	'계좌비밀번호
Dim  g_MaxMnecYN  '최대환전여부 v003
Dim g_szCertUserType '로그인 타입 20220417 아이티젠 김성수 추가
g_szFullAcnt	=""
g_szPasswd	=""
g_szCrcd		=""

'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName		= "PWDINFO_CHG" then
		g_szPasswd	=	sParam
'		
'		if len(trim(g_szFullAcnt))	>	8	and	len(trim(g_szPasswd))	then
'			DATAMANAGER.RequestTranData("obrtd_fcur_001r")
'			DATAMANAGER.RequestTranData("obtsd_fbnk_209r")
'		end if
	
	elseif sEventName	=	"ACNTINFO_CHG" then
		g_szFullAcnt = Form.GetSharedData("&ACCOUNT", 0 )
		
		if len(trim(g_szFullAcnt))	>	8	then
			
			
			'화면 초기화 함수
			Call cleardata()
			
			DATAMANAGER.RequestTranData("obrtd_fcur_001r")
			Call Ios_NumberPad()
		end if
	
	end if
	
End Sub

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	'20220418 아이티젠 김성수 수정
	g_szCertUserType= Form.GetSharedData("&CERT_USE_TYPE", false )  'v001 로그인타입

	g_szFullAcnt= Form.GetCtlProp("#acnt01", "caption")
	g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")
	Call cleardata()
	
	btnAddSell.enable = True
	
	g_MaxMnecYN = "N" 'v003
	DATAMANAGER.RequestTranData("obrtd_fcur_001r")
	Call Ios_NumberPad()
	
End Sub

'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")
	g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")
	
	if	szTranID	=	"obrtd_fcur_001r"	then
		
		DATAMANAGER.SetDataValue(0, "obrtd_fcur_001r", "InBlock1", "ACNO" , 0 , left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0, "obrtd_fcur_001r", "InBlock1", "ASNO" , 0 , mid(g_szFullAcnt,9,2))
		DATAMANAGER.SetDataValue(0, "obrtd_fcur_001r", "InBlock1", "SVCD" , 0 , "001")
		
		plain_rm = Form.GetSharedData("&PLAIN_RM" , False) 'v002
		If plain_rm == "1" Then
		    DATAMANAGER.SetDataValue(0, "obrtd_fcur_001r", "InBlock1", "ACNT_PWD" , 0 , g_szPasswd)
		Else
		    DATAMANAGER.SetDataValue(0, "obrtd_fcur_001r", "InBlock1", "ACNT_PWD" , 0 , Form.GetEncData(g_szPasswd))
		End If
	
	elseif szTranID =	"obtsd_fbnk_201r" then
	
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_201r" , "InBlock1" , "CRCD" , 0 , g_szCrcd )
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_201r" , "InBlock1" , "SVCD" , 0 , "001")
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_201r" , "InBlock1" , "ACNO" , 0 , left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_201r" , "InBlock1" , "ASNO"      , 0 , mid(g_szFullAcnt,9,2))
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_201r" , "InBlock1" , "MNEC_CLCD" , 0 , "2")
		
	elseif szTranID = "obtsd_fbnk_202a" then
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "ACNO" 			, 0 , left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "ASNO" 			, 0 , mid(g_szFullAcnt,9,2))
		
		plain_rm = Form.GetSharedData("&PLAIN_RM" , False) 'v002
		If plain_rm == "1" Then
		    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "ACNT_PWD" ,  0 , g_szPasswd)
		Else
		    DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "ACNT_PWD" ,  0 , Form.GetEncData(g_szPasswd))
		End If
		
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "MNEC_CLCD"		, 0 , 			"2"			) '환전구분코드 2 : 외화매도
		if RadioGroup0.currentindex = "1" then	'외화
			DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "FRCR_AMT" 		, 0 , edtAmt.caption			) '환전외화금액
			DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "WNCR_AMT" 		, 0 , "0"			) '
		else
			DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "WNCR_AMT" 		, 0 , edtAmt.caption			) '환전외화금액
			DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "FRCR_AMT" 		, 0 , "0"			) '
		end if
		
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "WNCR_AMT" 		, 0 , 	0					) '원화금액 0원
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "FRCR_AMT" 		, 0 , Edit3.caption			) '환전외화금액
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "IQRY_EXRT"		, 0 , EdtExRate.caption		) '조회환율
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "SVCD"			, 0 , "001"					) '
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "CRCD"			, 0 , g_szCrcd				) '통화코드
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "CONT_CLS_CODE"	, 0 , 			"4"			) '접촉구분코드 4 : 온라인
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "TRMD_CLS_CODE"	, 0 , 			"04"			) '거래매체구분코드 04 : 무매체
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "MAX_MNEC_YN"    , 0 , g_MaxMnecYN               ) '최대환전여부 v004
		
	end if
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	dim szDataCnt
	dim szCrcd, szCrcdKrNm, szApBy
	
	szDataCnt = ""
	szCrcd =	""
	szCrcdKrNm = ""
	szExDealAmt = ""
	
	if	szTranID =	"obrtd_fcur_001r" then

		szDataCnt =	DATAMANAGER.GetDataCount(0, "obrtd_fcur_001r", "OutBlock1")
		
		
		for	i=0 to szDataCnt - 1
		
			szCrcd		 =	DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "CRCD", i )
			szCrcdKrNm	 =	DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "CRCD_KOR_NAME", i )
			'szExDealAmt	 =	DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "UI_FRCR_WTMN_ABLE_AMT", i ) v005 주석처리
			szExDealAmt	 =	DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "ATMT_INVT_VLTN_ADUP_FRCR_AMT", i ) 'v005
			szExDealAmtMax =  DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "UI_MAX_MNEC_ABLE_FRCR_AMT", i ) 'v004 최대환전금액
			'매도 할 환전 보유 외화 세팅
			if szCrcd	=	Left(edtCrcd.Caption, 3) then
				edtAble.caption = szExDealAmt			
				edtAbleMax.caption = szExDealAmtMax 'v004
			end if 
		next
		
		g_MaxMnecYN = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock3" , "MAX_MNEC_YN" , 0) 'v003
	
	elseif szTranID = "obtsd_fbnk_201r" then
							
		szApBy =  DATAMANAGER.GetDataValue(0, "obtsd_fbnk_201r", "OutBlock1", "TLTR_APLY_SLRT" , 0)
		szAptm =	 DATAMANAGER.GetDataValue(0, "obtsd_fbnk_201r", "OutBlock1", "EXRT_STND_TIME" , 0)
		
		EdtExRate.caption = szApBy
		EdtExRateTime.caption = Right(szAptm, 6)
		
		'매수금액, 외화매수신청금액 초기화
		edtAmt.caption = ""
		Edit3.caption = ""	
		Edit0.caption = ""	
		
	elseif szTranID = "obtsd_fbnk_202a" then
		
		szCRCD	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "CRCD" 		, 0)		' 통화코드
		szTFPR	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "TFAM_PRRM" , 0)		' 예수금전잔
		szTFNW	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "TFAM_NWRM" , 0)		' 예수금금잔
		szTRAM	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "TR_AMT" 	, 0)		' 실제환전원화금액
		
		szFCRCD	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "UI_CRCD" 		, 0)	' 외화통화코드
		szFTFPR	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "FRCR_TFAM_PRRM" , 0)	' 외화전잔
		szFTFNW	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "FRCR_TFAM_NWRM" , 0)	' 외화금잔
		szFTRAM	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "FRCR_TR_AMT" 	, 0)	' 실제환전외화금액
		
		
		btnAddSell.enable = False
		
		Form.OpenPopup("mhtro16080_p1" , szCRCD & "★" &  szTFPR & "★" &  szTFNW & "★" & szTRAM & "★" &
									 szFCRCD & "★" &  szFTFPR & "★" &  szFTFNW & "★" & szFTRAM & "★" &
									 "사는통화" & "★" & "파는통화"
											, sPosInfo)
		
											
		DATAMANAGER.RequestTranData("obrtd_fcur_001r")
	
	end if
	
	
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	
	edtAmt.caption = ""
	Edit3.caption = ""
	Edit0.caption = ""
	
	'매수금액기준 원화를 선택한 경우
	if nIndex = 1 then
		btnAll.caption = "500만"
		btn100.caption = "100만"
		btn50.caption = "50만"
		btn10.caption = "10만"
		btn5.caption = "5만"
		btn1.caption = "1만"
		
	'매수금액기준 외화를 선택한 경우
	else
		btnAll.caption = "전액"
		btn100.caption = "1000"
		btn50.caption = "500"
		btn10.caption = "100"
		btn5.caption = "50"
		btn1.caption = "10"
	
	end if
End Sub

'============================================================================
Sub btnShRate_OnClick()
	If g_szCrcd = "" then
		Form.ShowAlert("알림", "통화 선택 후 조회하세요.")
		Exit sub
	elseif g_szCrcd = "KRW" then
		Exit sub
	end if
	
	DATAMANAGER.RequestTranData("obtsd_fbnk_201r")
	
End Sub


'============================================================================
Sub btnAddSell_OnClick()
	
	if g_szCrcd = "" then
		Form.ShowAlert("알림", "매도통화를 선택해주시기 바랍니다.")
		Exit Sub
	end if
	
	if g_szPasswd = "" then
		Form.ShowAlert("알림", "비밀번호를 입력해주세요.")
		Exit sub
	elseif Edit3.caption = "" then
		Form.ShowAlert("알림", "환전하실 외화 값을 입력해주세요.")
		Exit sub	
	end if	
	
	if Edit4.caption = "703" then
		if RadioGroup0.currentindex <> "0" then
			Form.ShowAlert("알림", "해당통화는 외화기준만 가능(은행환전).")
			Exit Sub
		end if
	end if
	
     If CDBL(Edit3.caption) > CDBL(LmtAmt.caption) And TRIM(LmtAmt.caption) <> "" Then 'v001
        Form.MsgBox("알림", "1회 한도금액 초과입니다.", "", 0)
        Exit Sub
     End If	
     
	call SendReg()
		
End Sub

'============================================================================
Function	cleardata()

	btnAddSell.enable = True
	edtCrcd.caption = ""
	EdtExRateTime.caption = ""
	EdtExRate.caption = ""
	
	edtAble.caption = "0"
	edtAbleMax.caption = "0" 'v003
	edtAmt.caption = ""
	
	'최종매도외화 클리어
	Edit3.caption = ""
	
	LmtAmt.caption = ""

end Function

