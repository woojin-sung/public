'============================================================================


'============================================================================
Function Calc_Simul()
	Dim frAmt, exchRate, sprRate, wnAmt, feeAmt, rateUnit		
	
	rateUnit = 1
	
	if g_szCrcd = "JPY" or g_szCrcd = "VND" or g_szCrcd = "IDR" then
		rateUnit = 100
	end if
	
	if EdtExRate.caption = "" then
		exit Function
	end if
	
	'가계산기준 외화 선택인 경우
	if RadioGroup0.currentindex = "0" then
		if Left(edtCrcd.caption, 3) = "" or edtAmt.caption = "" then
			exit Function
		end if
		
		frAmt = edtAmt.caption
		exchRate = FormatNumber(EdtExRate.caption,2)
		sprRate = FormatNumber(Edit2.caption,2)
		
		
		
		'wnAmt = frAmt * exchRate / rateUnit
		'feeAmt = frAmt * sprRate
		
		'Edit3.caption = frAmt
		
	'가계산기준 원화 선택인 경우
	else
		Dim tmpFrAmt2, strFrAmt2
		
		if edtAmt.caption = "" then
			exit Function
		end if
		
		wnAmt = CDBL(edtAmt.caption)
		exchRate = CDBL(EdtExRate.caption)
		sprRate = CDBL(Edit2.caption)
		frAmt = wnAmt / exchRate * rateUnit
		tmpFrAmt2 = Round(frAmt, 5)
		strFrAmt2 = CStr(CLng(tmpFrAmt2 * 100))
		
		frAmt = CDBL(strFrAmt2/100)
		
	    feeAmt = frAmt * sprRate
	     'Edit3.Caption = frAmt
	     'Form.ShowAlert( "알림", frAmt)
	     
		if wnAmt > CLNG(Round(frAmt * exchRate, 5) / rateUnit) then
			if rateUnit = 100 then
				frAmt = frAmt + 1
			else
				frAmt = frAmt + 0.01
			end if
		end if
		
		if rateUnit = 100 then
		    frAmt = CLNG(CSTR(frAmt))
	    End if
	end if
	
	'계산된 매수외화금액을 최종 매수신청 외화에 세팅
	Dim tmpFrAmt , strFrAmt
	tmpFrAmt = Round(frAmt, 5)
'Form.ShowAlert( "알림", CLNG(Round(tmpFrAmt * 100, 5)) )
	strFrAmt = CStr(ROUND(tmpFrAmt * 100, 5))

	Edit3.caption =  CDbl(strFrAmt / 100)
	Edit0.caption =  CDbl(strFrAmt / 100) * CDBL(EdtExRate.caption) / rateUnit
	
end Function

