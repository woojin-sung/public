'============================================================================
' Cal_Btn(nAdd)
'============================================================================
Function Cal_Btn(nAdd)	
   Dim nAmt
   if Trim(edtAmt.caption) == "" then
      nAmt = 0
   else 
      nAmt = CDbl(edtAmt.caption)
      
   end if
   edtAmt.caption = nAmt + nAdd
   edtAmt_OnEditComplete()
End Function   

'============================================================================
Sub edtAmt_OnEditComplete()
	Dim szTempMoney1, szTempMoney2
	
	if RadioGroup0.currentindex = "0" then
	    If g_MaxMnecYN == "Y" Then
	        szTempMoney1 = edtAbleMax.caption 'v003
	    Else
	        szTempMoney1 = edtAble.caption
	    End If
		
		szTempMoney2 = edtAmt.caption
		
		if CDbl(szTempMoney1) < CDbl(szTempMoney2) then
			Form.ShowAlert("알림", "매도신청금액이 매도가능금액을 초과했습니다.")
			edtAmt.caption = ""
			Edit3.caption = ""
			Edit0.caption = ""
			exit sub
		end if
		
	end if
	
	Call Calc_Simul()
	
	if RadioGroup0.currentindex = "1" then
	    If g_MaxMnecYN == "Y" Then
	        szTempMoney1 = edtAbleMax.caption 'v003
	    Else
	        szTempMoney1 = edtAble.caption
	    End If
		
		szTempMoney2 = Edit3.caption
		
		if CDbl(szTempMoney1) < CDbl(szTempMoney2) then
			Form.ShowAlert("알림", "매도신청금액이 매도가능금액을 초과했습니다.")
			edtAmt.caption = ""
			Edit3.caption = ""
			Edit0.caption = ""
			exit sub
		end if
		
	end if
	
End Sub

'============================================================================
Sub btnAll_OnClick()
	if RadioGroup0.currentindex = "1" then
		Cal_Btn(5000000)
	else
		'edtAmt.caption = FormatNumber(edtAble.caption,2)
		If g_MaxMnecYN == "Y" Then 
		    edtAmt.caption = edtAbleMax.caption 'v003
		Else
		    edtAmt.caption = edtAble.caption
		End If
		
		'Edit3.caption = FormatNumber(edtAble.caption,2)
		If g_MaxMnecYN == "Y" Then 
		    Edit3.caption = edtAbleMax.caption 'v003
		Else
		    Edit3.caption = edtAble.caption
		End If
		
		edtAmt_OnEditComplete()
	end if
		
End Sub

