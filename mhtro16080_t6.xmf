'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	if szTranID = "obtsd_fbnk_201r" then
		
		szSubErr = DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.ShowAlert( "알림", szErrMsg.."\n("..szSubErr..")" )
		
		edtCrcd.caption = ""
		EdtExRateTime.caption = ""
		EdtExRate.caption = ""
		edtAmt.caption = ""
		Edit3.caption = ""
			
		
	
	elseif szTranID = "obtsd_fbnk_202a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.ShowAlert( "알림", szErrMsg.."\n("..szSubErr..")")
	
	
		
	end if
	
End Sub

