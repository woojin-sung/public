'****************************************************************************
'  V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCloud		' 관심동기화(0:미사용(로컬), 1:사용(서버))

Dim g_szCode
g_szCode = ""

Dim g_szRow
Dim g_szTitle
g_szTitle = "알림"



'****************************************************************************
'  F  O  R  M
'****************************************************************************
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit( )
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	
	if Trim(g_szCloud) == "" then '초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	' //////////////////////////////////////////////////////////////////////
	
	' 그리드 로우 위치 변경 위한 속성
	grdGroup.rowmove = "1"
	
	' ITGEN START => 2019.01.10(해외파생)
	Get_GWGroup( )
	' ITGEN ORGSRC
'	grdGroup.rowcount = 0
'	if g_szCloud == "1" then		' Server 저장시
'		' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
'		DATAMANAGER.RequestTranData("ohhts_intr_026r")
'	else							' Local 저장시
'		' 로컬 저장된 관심그룹 가져오기	
'		Load_GWGroup( )
'	end if
	'ITGEN END
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sRet <> "" then
		tData = Split(sRet, "★")
		
		' 그룹 추가
		if sKeyName == "GLOBAL_INTR_GROUP_ADD" then
			g_szRow = grdGroup.rowcount
			g_szCode = tData(0)
			grdGroup.insertrow = g_szRow
			
			grdGroup.SetCellData("bd_count", g_szRow, 0)
		end if
		
		grdGroup.SetCellData("bd_code", g_szRow, tData(0))
		grdGroup.SetCellData("bd_name", g_szRow, tData(1))
			
		if g_szCloud == "1" then		' Server 저장시
			' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
			DATAMANAGER.RequestTranData("ohhts_intr_028r")
			Save_GWGroup( )
		else							' Local 저장시
			' 로컬 저장된 관심그룹 저장하기
			Save_GWGroup( )
		end if
		
	end if
End Sub

'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	' 그룹삭제
	if sKeyName == "DELETE" then
		if sRet == "ok" then
			' 20160324 그룹삭제시 파일에 저장되어 있는 관련 종목도 삭제 시킴 //
			szCode = grdGroup.GetCellData("bd_code", g_szRow)
			Form.SaveConfigData("GLOBAL_INTR", szCode, "")
			' ////////////////////////////////////////////////////////////////
			grdGroup.SetDeleteRow(g_szRow)
			
			if g_szCloud == "1" then
				DATAMANAGER.RequestTranData("ohhts_intr_028r")
				Save_GWGroup( )
			else
				Save_GWGroup( )
			end if			
		end if	
	end if	
End Sub



'****************************************************************************
'  C  O  N  T  R  O  L  L
'****************************************************************************
'============================================================================
Sub btnAdd_OnClick( )	
	Dim szCode, szChk
	Dim nRow
	
	nRow = CInt(grdGroup.rowcount) - 1

	if nRow == 99 then
		Form.ShowAlert(g_szTitle, "관심그룹은 최대 100개까지입니다")
		Exit Sub
	end if
	
	' 관심그룹 명칭 초기 설정위해.. 코드로 정한다. //////////////////////////
	if nRow < 0 then
		szCode = "00"
	else
		'20180905_01 NOHES START : 관심그룹 생성 시, 순차적으로 확인해서 코드 빠졌을 때 채워넣으면서 만든다.
		'                          그룹이 10개 이상인 경우에 szCd == szCode 처리 못해서 CStr 처리함.
		For i = 0 to 99
			if Len(i) == 1 then
				szCode = "0" & i
			else
				szCode = CStr(i)
			end if
			
			For j = 0 to nRow		
				szCd = grdGroup.GetCellData("bd_code", j)
				if szCd == szCode then					
					szChk = "0"
					Exit For
				else 
					szChk = "1"
				end if
			Next
			if szChk == "1" then
				Exit For
			end if	
		Next
	end if
	' ////////////////////////////////////////////////////////////////////////
	
	Form.OpenPopup("mhtrd43110_p3" , "GLOBAL_INTR_GROUP_ADD★" & szCode & "★", "")
End Sub

'============================================================================
' grdGroup_OnClickUp
'============================================================================
Sub grdGroup_OnClickUp(lRow, szCellID)
	if szCellID == "bd_cancel" then	
		if grdGroup.rowcount == "1" then
			Form.ShowAlert(g_szTitle, "관심그룹은 최소 1개이상 존재하여야합니다.")
			exit Sub
		end if
		
		g_szRow = lRow
	
		szCode = grdGroup.GetCellData("bd_code", lRow)
		szName = grdGroup.GetCellData("bd_name", lRow)
		
		Form.MsgBox("알림", "선택된 관심그룹을 삭제하겠습니까?", "DELETE", 1)
	elseif szCellID == "bd_mod" then
		g_szRow = lRow
		
		szCode = grdGroup.GetCellData("bd_code", lRow)
		szName = grdGroup.GetCellData("bd_name", lRow)
		
		Form.OpenPopup("mhtrd43110_p3" , "GROUP_MOD★" & szCode & "★" & szName , "")
	end if	
End Sub

'============================================================================
' grdGroup_OnDropRow
'============================================================================
Sub grdGroup_OnDropRow( )
	g_szCode = ""
	DATAMANAGER.RequestTranData("ohhts_intr_028r")
End Sub



'****************************************************************************
'D  A  T  A  M  A  N  A  G  E  R
'****************************************************************************
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_026r" then
		DATAMANAGER.SetDataValue(0, "ohhts_intr_026r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))	' USER ID
	' ----------------------------------------------------------------------
	' 관심 수정 TR :그룹추가, 종목추가, 빈칸추가
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_028r" then
		' ITGEN START => 2019.01.10(해외파생)
		DATAMANAGER.ClearInputData(false, "ohhts_intr_028r")
		DATAMANAGER.ClearOutputData(false, "ohhts_intr_028r")
		' ITGEN END
		
		' ////////////// 종목추가, 빈칸적용시 ////////////////
		' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_028r", "InBlock1", "FID_USER_ID",     0, Form.GetSharedData("&USER_ID", false))		
		' FID버전ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_028r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)	
		'DATAMANAGER.SetDataValue(0, "ohhts_intr_028r", "InBlock1", "FID_VRSN_ID",     0, "12")	
		' FID수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_028r", "InBlock1", "FID_MOD_YN",      0, "0")				
		' FID종목수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_028r", "InBlock1", "FID_ISSU_MOD_YN", 0, "0")				
		
		For i = 0 to grdGroup.rowcount - 1
			' FID관심종목그룹ID
			DATAMANAGER.SetDataValue(0, "ohhts_intr_028r", "InBlock2", "FID_CNCN_ISSU_GRP_ID", i, grdGroup.GetCellData("bd_code", i))
			' FID관심그룹명
			DATAMANAGER.SetDataValue(0, "ohhts_intr_028r", "InBlock2", "FID_CNCN_GRP_NAME",    i, grdGroup.GetCellData("bd_name", i))	

			' FID종목수정여부
			'if cmbGroup.cbkeydata == grdGroup.GetCellData("bd_code", i) then	
			'if g_szCode == grdGroup.GetCellData("bd_code", i) then	
			
			'	DATAMANAGER.SetDataValue(0, "ohhts_intr_028r", "InBlock2", "FID_ISSU_MOD_YN", i, "1")			' 수정
			'else
				DATAMANAGER.SetDataValue(0, "ohhts_intr_028r", "InBlock2", "FID_ISSU_MOD_YN", i, "0")			' 수정안함
			'end if
		Next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 관심 수정 TR
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_028r" then
		Form.SetCtlProp("#edtChange", "caption", "1")	' 그룹변경을 알리기 위해..	
		Form.SetSharedData("GLOBAL_INTR_VRSN_ID", edtvrsnID.caption) ' 20160317 편집시 ID가 메인화면과 연동안되는부분 때문에 추가
		
		' ITGEN START => 2019.01.10(해외파생)
		Get_GWGroup( )
		' ITGEN END
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	' ----------------------------------------------------------------------
	' 관심 수정 TR
	' ----------------------------------------------------------------------
'	if szTranID == "ohhts_intr_028r" then
'		Form.Toast(1, "[" & szErrCode & "]" & szErrMsg, true)
'	end if		
End Sub



'****************************************************************************
'  P  E  R  S  O  N  A  L
'****************************************************************************
'============================================================================
' Load_GWGroup :  로컬에 저장된 관심그룹 가져오기
'============================================================================
Function Load_GWGroup( )
	Dim tGroup, tList
	
'	grdGroup.rowcount = 0	
	szGroup = Form.LoadConfigData("GLOBAL_INTR", "GROUP")
	
	if Trim(szGroup ) <> "" then
		tGroup = Split(szGroup, "♣")
		
		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdGroup.insertrow = i
	
			grdGroup.SetCellData("bd_code",  i, tList(0))
			grdGroup.SetCellData("bd_name",  i, tList(1))
			grdGroup.SetCellData("bd_count", i, tList(2))
		Next
	end if
End Function	

'============================================================================
' Save_GWGroup :  관심그룹을 로컬에 저장
'============================================================================
Function Save_GWGroup( )
	Form.SaveConfigData("GLOBAL_INTR", "GROUP", "")
	
	For i = 0 to grdGroup.rowcount-1
		szCode = grdGroup.GetCellData("bd_code",  i)
		szName = grdGroup.GetCellData("bd_name",  i)
		szCnt  = grdGroup.GetCellData("bd_count", i)
		if i == 0 then
			szGroup = szCode & "★" & szName & "★" & szCnt
		else
			szGroup = szGroup & "♣" & szCode & "★" & szName & "★" & szCnt
		end if
	Next
	
	' 동기화 시는 파일 저장만.. /////////////////////////////////////////////
	if g_szCloud == "0" then
		Form.SetCtlProp("#edtChange", "caption", "1")	' 그룹변경을 알리기 위해..
	end if
	
	Form.SaveConfigData("GLOBAL_INTR", "GROUP", szGroup)
End Function

' ITGEN START => 2019.01.10(해외파생)
'============================================================================
' Get_GWGroup :  관심그룹을 불러오기
'============================================================================
Function Get_GWGroup( )
	grdGroup.rowcount = 0
	
	if g_szCloud == "1" then		' Server 저장시
		' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
		DATAMANAGER.RequestTranData("ohhts_intr_026r")
	else							' Local 저장시
		' 로컬 저장된 관심그룹 가져오기	
		Load_GWGroup( )
	end if
End Function
