	<SCRIPT_INFO _len="7293" _ulen="6899" >
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nTRCount		'조회된 TR 개수
Dim g_szList
Dim g_nNextCount		'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nSelectCount	'선택한 셀의 개수
Dim g_nSuccesCount	'처리한 TR의 회수

'============================================================================
' 							FORM 함수
'============================================================================
Sub Form_OnFormInit()
	g_nSelectCount = 0
	g_nSuccesCount = 0
	
	grd0.SetCellData("bd_cell0", 0, 0)
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName = "계좌추가" then
		g_szList = Split(sParam , "★")
	end if
	
	DATAMANAGER.SetDataValue(0 , "obpds_srvc_314r", "InBlock1", "CSNO",		0 , g_szList(0))
	DATAMANAGER.SetDataValue(0 , "obpds_srvc_314r", "InBlock1", "ELFN_ID",	0 , g_szList(1))

	g_nNextCount = 0
	
	DATAMANAGER.RequestTranData("obpds_srvc_314r")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	'공인인증서 인증 화면 리턴
	if sKeyName == "mhetc90060_p5"  then
	
		if sRet ~= "cancel" then
			Call f_StrtAdd()
		end if
		
	end if
	
End Sub

'============================================================================
' 							DATAMANAGER 함수
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obpds_srvc_314r" then
		g_nTRCount = DATAMANAGER.GetDataCount(0, "obpds_srvc_314r", "OutBlock1")
		
		if g_nTRCount > 0 then
			Label0.visible	= false
			grd0.visible		= true
			lbl0.visible		= true
'			LblInfo.visible	= true
			
			for i = 0 to g_nTRCount - 1
				grd0.SetCellData("bd_cell0", i, 0)
				g_nNextCount = g_nNextCount + 1
				grd0.SetCellBgColor("bd_cell0", i, "38")
				grd0.SetCellBgColor("bd_cell1", i, "38")
				grd0.SetCellBgColor("bd_cell2", i, "38")
			next
			
			if DATAMANAGER.IsMoreNextData( "obpds_srvc_314r" ) == true then
				DATAMANAGER.RequestNextData( "obpds_srvc_314r" )
			end if
			
		else
			Label0.visible	= true
			grd0.visible		= false
			lbl0.visible		= false
			LblInfo.visible	= false
		end if
		
		btn0.enable		= false
		g_nSelectCount	= 0
		g_nSuccesCount	= 0
			
	elseif szTranID == "obpds_srvc_316a" then
	
		if g_nSuccesCount ~= 0 and g_nSuccesCount == g_nSelectCount then
			g_nSelectCount = 0
			g_nSuccesCount = 0
			Form.ShowAlert("알림", "ID계좌번호가 변경 되었습니다.(계좌추가)")
			
			'20230901 계좌리스트 재조회 추가
			Form.RequestCommand("RE_ACCT_LIST" , "" , "")
			
			DATAMANAGER.RequestTranData("obpds_srvc_314r")			'완료후 재조회
		end if
		
		DATAMANAGER.RequestTranData("obpds_srvc_314r")			'버퍼로 인해 처리만 되고 팝업창이 안뜨고 재조회도 안되는 경우 대비
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr

	if szTranID == "obpds_srvc_314r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText("obpds_srvc_314r")
		
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		
	elseif szTranID == "obpds_srvc_316a" then
		szSubErr			= DATAMANAGER.GetDataMsgSubText("obpds_srvc_316a")
		g_nSuccesCount	= 0
		
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		
		DATAMANAGER.ClearInputData(0, "obpds_srvc_316a")
	end if
	
End Sub

'============================================================================
' 							CONTORL 함수
'============================================================================
' 연결 버튼
'============================================================================
Sub btn0_OnClick()
	Dim szAcnt

	if g_nSelectCount == 0 then
		Form.MsgBox("Meritz", "연결할 계좌를 선택하여 주십시오.", 0, 6)
		Exit Sub
	end if
	
	Form.OpenFramePopup("mhetc90060_p5", "" , "")	'공인인증서 인증 화면 팝업
End Sub

'============================================================================
' 계좌 선택
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	
	if szCellID == "bd_cell0" then
		if grd0.GetCellData("bd_cell0", lRow) == "0" then
			g_nSelectCount = g_nSelectCount - 1
		elseif grd0.GetCellData("bd_cell0", lRow) == "1" then
			'16-03-31 다건 처리 30건 제한 안내 문구 추가
			g_nSelectCount = g_nSelectCount + 1
		end if
	end if
	
	if g_nSelectCount > 0 then
		btn0.enable = true
	else
		btn0.enable = false
	end if
	
	if g_nSelectCount > 29 then
		Form.ShowAlert( "알림", "최대 30건씩 처리 가능합니다.")
		for i = 0 to grd0.rowcount 
			if grd0.GetCellData("bd_cell0", i) ~= "1" then
				grd0.SetCellEnable( "bd_cell0", i, false)
			end if
		next
		Exit Sub
	elseif g_nSelectCount == 29 then
		for i = 0 to grd0.rowcount 
			if grd0.GetCellData("bd_cell0", i) ~= "1" then
				grd0.SetCellEnable( "bd_cell0", i, true)
			end if
		next
		Exit Sub
	end if
			
End Sub

'============================================================================
' grd0_OnScrollEnd()
'============================================================================
Sub grd0_OnScrollEnd()
	DATAMANAGER.RequestNextData("obpds_srvc_314r")
End Sub

'============================================================================
' 							사용자 함수
'============================================================================
' 계좌연결 시작
'============================================================================
Function f_StrtAdd()

	for i = 0 to grd0.rowcount - 1
		if grd0.GetCellData("bd_cell0", i) == "1" then
			Call SetAdd(i)
		end if
	next
	
	DATAMANAGER.RequestTranData("obpds_srvc_316a")
End Function

'============================================================================
' 계좌추가 처리 세팅 함수(obpds_srvc_316a)
'============================================================================
Function SetAdd(nIndex)
	szAcnt = grd0.GetCellData("bd_cell1", nIndex)

	DATAMANAGER.SetDataValue(0 , "obpds_srvc_316a", "InBlock1", "PROS_CLS_CODE",	g_nSuccesCount, "I")
	DATAMANAGER.SetDataValue(0 , "obpds_srvc_316a", "InBlock1", "SVCD",			g_nSuccesCount, "016")
	DATAMANAGER.SetDataValue(0 , "obpds_srvc_316a", "InBlock1", "HTS_SOON_YN",	g_nSuccesCount, "N")
	DATAMANAGER.SetDataValue(0 , "obpds_srvc_316a", "InBlock1", "CONT_CLS_CODE",	g_nSuccesCount, "4")
	DATAMANAGER.SetDataValue(0 , "obpds_srvc_316a", "InBlock1", "CSNO",			g_nSuccesCount, g_szList(0))
	DATAMANAGER.SetDataValue(0 , "obpds_srvc_316a", "InBlock1", "ACNO",			g_nSuccesCount, szAcnt)
	DATAMANAGER.SetDataValue(0 , "obpds_srvc_316a", "InBlock2", "ACNO",			g_nSuccesCount, szAcnt)
	DATAMANAGER.SetDataValue(0 , "obpds_srvc_316a", "InBlock2", "ELFN_ID",		g_nSuccesCount, g_szList(1))
	
	g_nSuccesCount = g_nSuccesCount + 1
End Function

