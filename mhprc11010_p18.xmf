	<SCRIPT_INFO _len="2923" _ulen="2885" >
'20240524_01 KBC : 해외주식 고도화 START (신규맵파일)


Dim g_sColor
g_sColor = ""

Dim g_color_list
g_color_list = {"231230230","191191191","127127127","255124128","244177131","255217102","169209142", "143170220", "068084106", "112048160", "255255255", "000000000"}

'============================================================================
Sub ImgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnAdd_OnClick()
	Form.SendReturnToParent("COLOR_SECLECT" , g_sColor)
	Form.CloseForm()
End Sub

'============================================================================
Sub procSelect(idx)
	for i = 0 to 11
		Form.SetCtlProp("Image" & CStr(i), "visible", false)
	next
	
	Form.SetCtlProp("Image" & CStr(idx), "visible", true)

	bgcolor = g_color_list(idx)

	edtColor.caption = bgcolor
	g_sColor = bgcolor
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	lblColor0.bgcolor = "255255255"
	lblColor1.bgcolor = "255255255"
	lblColor2.bgcolor = "255255255"
	lblColor3.bgcolor = "255255255"
	lblColor4.bgcolor = "255255255"
	lblColor5.bgcolor = "255255255"
	lblColor6.bgcolor = "255255255"
	lblColor7.bgcolor = "255255255"
	lblColor8.bgcolor = "255255255"
	lblColor9.bgcolor = "255255255"
	lblColor10.bgcolor = "255255255"
	lblColor11.bgcolor = "255255255"
	
	lblColor0.setRound("1")
	lblColor1.setRound("1")
	lblColor2.setRound("1")
	lblColor3.setRound("1")
	lblColor4.setRound("1")
	lblColor5.setRound("1")
	lblColor6.setRound("1")
	lblColor7.setRound("1")
	lblColor8.setRound("1")
	lblColor9.setRound("1")
	lblColor10.setRound("1")
	lblColor11.setRound("1")


	for i = 0 to 11	
		Form.SetCtlProp("Image" & CStr(i), "imgpath", "icon_check_on") '검정색
		
		if i == 2 or i == 8 or i == 9 or i == 11 then 
			Form.SetCtlProp("Image" & CStr(i), "imgpath", "icon_check_off") '연한회색
		end if
		
		Form.SetCtlProp("Image" & CStr(i), "maintainratio", "1")
		Form.SetCtlProp("lblColor" & CStr(i), "bgcolor", g_color_list[i])
	next
	

End Sub

'============================================================================
Sub lblColor0_OnClick()
	procSelect(0)
End Sub

Sub lblColor1_OnClick()
	procSelect(1)
End Sub

Sub lblColor2_OnClick()
	procSelect(2)
End Sub

