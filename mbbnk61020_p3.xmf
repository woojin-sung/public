'============================================================================
' ㅇ 증권 잔액조회 : 증권비밀번호 불필요
' ㅇ 은행 잔액조회 : 은행비밀번호 필요
' ㅇ 입금 : 은행비밀번호 필요 & 공동인증 필요
' ㅇ 출금 : 증권비밀번호 필요 & 공동인증 필요
'
' 2024.07.10. 임종현 v001 : 토스뱅크 은행  출금시 공동인증 생략
'============================================================================

Dim g_szAccountNumber 
Dim g_szAccountSerialNumber
Dim g_szAccountName
Dim g_szPass
Dim g_szBankCode
Dim g_szBankAcc
Dim g_sName
Dim g_sAmt
Dim g_szCertUserType
Dim g_szUserId
Dim g_szTrMsg
Dim g_sOtpTrMsg
Dim g_mSBValue
Dim g_mOTPInfo
Dim g_mOTPData

Dim g_tactLmtAmt_Day   'TOSS 이체한도 (누적)
Dim g_tactLmtAmt_Total  'TOSS 이체한도 (총)

'============================================================================
Sub imgClose_OnClick()

    Form.SendReturnToParent( "CORNFORM_POPUP" , "CANCEL" )
    Form.CloseForm()
    
End Sub

