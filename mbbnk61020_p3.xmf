'============================================================================
Sub Button1_OnClick()
    Form.SendReturnToParent( "CORNFORM_POPUP" , "CANCEL" )
    Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()

    szData = Form.GetOpenLinkData()
    szList = Split(szData, "★")
	
    If UBOUND(szList) < 1 Then
        Exit Sub
    End if
	
    g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE" , False)
    g_szUserId       = Form.GetSharedData("&USER_ID"       , False)
    
    g_szAccountNumber       = szList(0)
    g_szAccountSerialNumber = szList(1)
    g_szAccountName         = szList(2)
    g_szPass                = szList(3)
    g_szBankAcc             = szList(5)
    g_szBankCode            = szList(7) '은행코드
    g_sName                 = szList(8) '수취인명
    g_sAmt                  = szList(6)

    Table0.SetCellString(1, 1, g_szAccountNumber & g_szAccountSerialNumber) '계좌번호
    Table0.SetCellString(2, 1, g_szAccountName)
	
    Table1.SetCellString(1, 1, szList(4) & " " & g_szBankAcc)
    Table1.SetCellString(2, 1, g_sName )
    Table1.SetCellString(3, 1, g_sAmt)'이체금액
    
    g_sOtpTrMsg = szList(4)  & "#" & g_szBankAcc & "#" & g_sName & "#" & FormatNumber(CDbl(g_sAmt), 0, 0, 0, -1) & "원#"
    
    If g_szCertUserType == "3" Then '바이오
        g_szTrMsg = "BIO_trType★1★이체예정내역\n" & "입금기관 : " & szList(4) & "\n" & "입금계좌 : " & g_szBankAcc & "\n" & "예금주명 : " & g_sName & "\n" & "이체금액 : " & FormatNumber(CDbl(g_sAmt), 0, 0, 0, -1) & "원\n★0"
    ElseIf g_szCertUserType == "4" Then '바이오
        g_szTrMsg = "BCHAIN_trType★1★이체예정내역\n" & "입금기관 : " & szList(4) & "\n" & "입금계좌 : " & g_szBankAcc & "\n" & "예금주명 : " & g_sName & "\n" & "이체금액 : " & FormatNumber(CDbl(g_sAmt), 0, 0, 0, -1) & "원\n★0"
    ElseIf g_szCertUserType == "5" Then '메리츠 사설인증데이터 Set
        g_szTrMsg = "ATON_trType★이체예정내역\n" & "입금기관 : " & szList(4) & "\n" & "입금계좌 : " & g_szBankAcc & "\n" & "예금주명 : " & g_sName & "\n" & "이체금액 : " & FormatNumber(CDbl(g_sAmt), 0, 0, 0, -1) & "원\n"
    Else
        g_szTrMsg = ""
    End if
    
    if g_szBankCode <> "092" then
	    DATAMANAGER.RequestTranData("obcsb_oimf_638r") '보안매체유형조회
    end if 
    
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    
    If szTranID == "obcsb_oimf_638r" Then '보안매체유형조회
    
        szScrcOtpClsCode = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "SCRC_OTP_CLS_CODE" , 0)
	
        If szScrcOtpClsCode == "9" Then '기타오류
            Form.MsgBox("알림", "인증오류가 발생했습니다." , "" , 6)
            Exit Sub	
        End If

        If g_szCertUserType == "0" Then '공동인증서
	
            Select Case szScrcOtpClsCode '보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 4:mOTP, 9:에러
                Case "0"
                    LinkForm0.linkfile = "mbbnk61010_s1"  '공인인증서_보안카드화면
                Case "1"
                    LinkForm0.linkfile = "mbbnk61010_s3"  '공인인증서만
                Case "2"	
                    LinkForm0.linkfile = "mbbnk61010_s3"  '공인인증서만
                Case "3"
                    Form.SetSharedData("OTP_TR_MSG_1" , g_sOtpTrMsg) '링크폼에서 사용할 Shared변수 세팅
                    LinkForm0.linkfile = "mbbnk61010_s2"  '공인인증서_일반/스마트OTP
                Case "4"
                    LinkForm0.linkfile = "mbbnk61010_suo" '공인인증서_mOTP
            End Select	

        ElseIf g_szCertUserType == "1" Then '간편인증
	
            Select Case szScrcOtpClsCode '보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 4:mOTP, 9:에러
                Case "0"
                    LinkForm0.linkfile = "mbbnk61010_s5"  '간편인증_보안카드
                Case "1"
                    LinkForm0.linkfile = "mbbnk61010_s7"  '간편인증만
                Case "2"
                    LinkForm0.linkfile = "mbbnk61010_s7"  '간편인증만		    
                Case "3"
                    Form.SetSharedData("OTP_TR_MSG_1" , g_sOtpTrMsg) '링크폼에서 사용할 Shared변수 세팅		
                    LinkForm0.linkfile = "mbbnk61010_s6"  '간편인증_OTP
                Case "4"
                    LinkForm0.linkfile = "mbbnk61010_sso" '간편인증_mOTP
            End Select
	    
        Else '그 외(사설인증 및 바이오인증)

            Select Case szScrcOtpClsCode '보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 4:mOTP, 9:에러
                Case "0"
                    Form.OpenPopupAnimation("seccardcheckpopup" , " " , "" , "2") '보안카드 인증
                Case "1"
                    Form.OpenFramePopup("mhetc90060_p5" , g_szTrMsg , "")
                Case "2"
                    Form.OpenFramePopup("mhetc90060_p5" , g_szTrMsg , "")		    
                Case "3"
                    Form.SetSharedData("OTP_TR_AUTH_MSG" , g_sOtpTrMsg)	  '팝업에서 사용할 Shared변수 세팅		    
                    Form.OpenPopupAnimation("otpcheckpopup" , " " , "" , "2") '일반/스마트OTP 인증
                Case "4"
                    Form.OpenPopupAnimation("otpcheckpopup" , " " , "" , "2") 'mOTP 인증
            End Select	
	    
        End If
	
    End If
    
    If szTranID == "obtsd_asou_060a" OR  szTranID == "obtss_elbs_133u"  Then
    
        Form.MsgBox("알림", "전송되었습니다.\n이체결과를 확인하세요." , "" , 0)
        Form.SendReturnToParent("CORNFORM_POPUP" , "OK")
        Form.CloseForm()

    End If    
    
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

    If szTranID == "obcsb_oimf_638r" Then '보안매체유형조회
    
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PROS_CLS"     , 0 , "1"              ) '1.일반입출금
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ELFN_ID"      , 0 , g_szUserId       )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"         , 0 , g_szAccountNumber)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "RRNO"         , 0 , ""               )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "MAC_ADDR"     , 0 , ""               ) '휴대폰 MAC주소
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "DISK_SERL_NO" , 0 , ""               ) 'PC 디스크일련번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "RRNO_PIP"     , 0 , ""               )    
    
    End If

    If szTranID == "obrtp_comn_017r" Then '출납_이체누적금액조회
	DATAMANAGER.SetDataValue(0,  "obrtp_comn_017r", "InBlock1", "RCPY_DATE"                     , 0 ,Form.GetSharedData("&HOST_DATE", false)  )'출납일자       
	DATAMANAGER.SetDataValue(0,  "obrtp_comn_017r", "InBlock1", "ACNO"                              , 0 , g_szAccountNumber                                  )'계좌번호  
	DATAMANAGER.SetDataValue( 0, "obrtp_comn_017r" , "InBlock1" , "ODER_CHAN_TYPE_CLS_CODE" , 0 , "020" )
    End If

    If szTranID == "obrtp_comn_018r" Then '출납_이체한도조회
        DATAMANAGER.SetDataValue(0,  "obrtp_comn_018r", "InBlock1", "TACT_CLS_CODE"             , 0 , "03"    )'이체구분코드 (즉시이체-은행) 
        DATAMANAGER.SetDataValue(0,  "obrtp_comn_018r", "InBlock1", "ACNO"                              , 0 , g_szAccountNumber  )'계좌번호  
        DATAMANAGER.SetDataValue(0,  "obrtp_comn_018r" ,"InBlock1" , "ODER_CHAN_TYPE_CLS_CODE" , 0 , "020" )
    End If

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    If Trim(szSubMsg) == "" Then
        szTotalMsg = szErrMsg
    Else
        szTotalMsg = szErrMsg .. "\n(" .. szSubMsg .. ")"
    End If
    
    If szTranID == "obtsd_asou_060a"  OR  szTranID == "obtss_elbs_133u"  Then
        Form.MsgBox( "알림", szTotalMsg, "", 0 )
	Button0.enable = false
    End If

End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam) '링크폼 인증(보안매체 + 전자서명)처리 완료 시

    If sEventName == "인증서" Then
    
        If sParam == "Success" Then
            TR_Inquiry()  
        End If
	
    ElseIf sEventName == "보안카드" Then
        If sParam == "Success" Then
            TR_Inquiry()
        End If
    ElseIf sEventName == "간편인증" Then
    
        If sParam == "Success" Then
            Button0_OnClick()
        End If
	
    ElseIf sEventName == "바이오인증" Or sEventName == "공동인증" Then
    
        If sParam == "Success" Then
            TR_Inquiry()		
        End If
	
    ElseIf sEventName == "간편인증OTP" Then
    
        If sParam == "Success" Then
            TR_Inquiry()
        End If
	
    ElseIf sEventName == "mOTP_GenReq" Then
	
	    Form.requestMOTP("MOTP_REQ_OTP_ENC", sParam , "61010p0")
	    
    End If
    
End Sub

'============================================================================ 
Sub Form_OnTriggerEventMOTP(sEventName, sParam) 'Form.requestMOTP 호출 시 발생 이벤트

    If sEventName == "MOTP_GET_VERSION_RETURN_61010p0" Then
        g_mSBValue = Split(sParam , "★") 'resultcode★resultMsg★mSBVersion
		
        If g_mSBValue[0] <> "00000" Then
            Form.MsgBox( "알림", g_mSBValue(1), "close", 6 )
        Else
            Form.SetSharedData( "mOTP_MsbVrsn" , g_mSBValue[2] )
        End If
		
    ElseIf sEventName == "MOTP_GETINFO_RETURN_61010p0" Then
		
        g_mOTPInfo = Split(sParam , "★") 'resultcode★resultMsg★otpAlias(일련번호)
		
        If g_mOTPInfo[0] <> "00000" Then
            Form.MsgBox( "알림", g_mOTPInfo(1), "close", 6 )
        Else
            Form.SetSharedData( "mOTP_OTPSrno" , g_mOTPInfo(2) )
        End If

    ElseIf sEventName == "MOTP_REQ_OTP_ENC_RETURN_61010p0" Then

        g_mOTPData = Split(sParam , "★")
		
        If g_mOTPData[0] <> "00000" Then
            Form.MsgBox( "알림", g_mOTPData(1), "close", 6 )
        Else
            Form.SetSharedData( "mOTP_SrnoGen" , g_mOTPData[2])
            Form.triggerEvent("LinkForm0" , "mOTP_Gen" , "Success")
        End If
	
    End If
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

    If sKeyName == "보안카드" Or sKeyName == "OTP" Then '보안매체인증
    
        If sRet == "Success" Then
            Form.OpenFramePopup("mhetc90060_p5" , g_szTrMsg , "")
        End If
	
    End If
    
    If sKeyName == "mhetc90060_p5" Then '전자서명인증
    
        szData = Split(sRet, ";")
        If szData(0) == "ok" or sRet == "ok" Then
	    if g_szBankCode == "092" then
	        TR_Inquiry_TOSS()
	    else
	        TR_Inquiry()
	    end if 
            
        End If
	
    End If
	
End Sub

'============================================================================
Sub TR_Inquiry()

    DATAMANAGER.SetDataValue(0 , "obtsd_asou_060a" , "InBlock1" , "JOB_CLS_CODE"   , 0 , "0"                    ) '작업구분코드			
    DATAMANAGER.SetDataValue(0 , "obtsd_asou_060a" , "InBlock1" , "ACNO"           , 0 , g_szAccountNumber      ) '계좌번호
    DATAMANAGER.SetDataValue(0 , "obtsd_asou_060a" , "InBlock1" , "ASNO"           , 0 , g_szAccountSerialNumber) '계좌번호	
    DATAMANAGER.SetDataValue(0 , "obtsd_asou_060a" , "InBlock1" , "PWD"            , 0 , g_szPass               ) '비밀번호
    DATAMANAGER.SetDataValue(0 , "obtsd_asou_060a" , "InBlock1" , "TACT_BANK_CODE" , 0 , g_szBankCode           ) '은행코드
    DATAMANAGER.SetDataValue(0 , "obtsd_asou_060a" , "InBlock1" , "BANK_ACNO"      , 0 , g_szBankAcc            ) '은행계좌번호
    DATAMANAGER.SetDataValue(0 , "obtsd_asou_060a" , "InBlock1" , "TACT_AMT"       , 0 , g_sAmt                 ) '이체금액
    DATAMANAGER.SetDataValue(0 , "obtsd_asou_060a" , "InBlock1" , "TACT_CLS_CODE"  , 0 , "03"                   ) '이체구분코드
    DATAMANAGER.SetDataValue(0 , "obtsd_asou_060a" , "InBlock1" , "RMT_NAME"       , 0 , g_sName                ) '수취인명

    DATAMANAGER.RequestTranData("obtsd_asou_060a")
	
End Sub

'============================================================================
Sub TR_Inquiry_TOSS()

    DATAMANAGER.SetDataValue(0, "obtss_elbs_133u" , "InBlock1" , "MNRC_BANK_CODE"                     , 0 , g_szBankCode       )'입금은행코드
    DATAMANAGER.SetDataValue(0, "obtss_elbs_133u" , "InBlock1" , "JOB_TRNO"                                  , 0 , "031"                     ) '단말번호
    DATAMANAGER.SetDataValue(0, "obtss_elbs_133u" , "InBlock1" , "MNRC_ACNO"                              , 0 , g_szBankAcc         )'입금계좌번호
    DATAMANAGER.SetDataValue(0, "obtss_elbs_133u" , "InBlock1" , "TR_AMT"                                     , 0 , g_sAmt                  )'출금액
    DATAMANAGER.SetDataValue(0, "obtss_elbs_133u" , "InBlock1" , "DRNG_ACNO"                               , 0 , g_szAccountNumber         )  '출금계좌
    DATAMANAGER.SetDataValue(0, "obtss_elbs_133u" , "InBlock1" , "ACNT_PROD_CLS_CODE"              , 0 , g_szAccountSerialNumber  ) '출금계좌일련번호
    DATAMANAGER.SetDataValue(0, "obtss_elbs_133u" , "InBlock1" , "RMRK"                                         , 0 , ""                               )'비고
    DATAMANAGER.SetDataValue(0, "obtss_elbs_133u" , "InBlock1" , "RMT_NAME"                                , 0 , g_sName                    )'수취인명
    DATAMANAGER.SetDataValue(0, "obtss_elbs_133u" , "InBlock1" , "FEE"                                            , 0 , 0                                )'수수료
    DATAMANAGER.SetDataValue(0, "obtss_elbs_133u" , "InBlock1" , "STDL_CNFT_BRCD"                       , 0 , ""                              ) '타행지점코드
    DATAMANAGER.SetDataValue(0, "obtss_elbs_133u" , "InBlock1" , "CLNT_INFO_CNTT"                       , 0 , ""                               )'의뢰인정보내용
    DATAMANAGER.SetDataValue(0, "obtss_elbs_133u" , "InBlock1" , "PMPP_INFO_CNTT"                       , 0 , ""                              ) '받는분통장표기	
    DATAMANAGER.SetDataValue(0, "obtss_elbs_133u" , "InBlock1" , "TACT_CLS_CODE"                        , 0 , "03"                            ) '이체구분코드 (즉시이체-은행)
    DATAMANAGER.SetDataValue(0, "obtss_elbs_133u" , "InBlock1" , "DRNG_ACNT_BNKB_EXRS_CNTT"  , 0 , ""                               ) '내통장표기
	
    DATAMANAGER.RequestTranData("obtss_elbs_133u")
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	    
    If szTranID == "obrtp_comn_017r"  Then
    	    g_tactLmtAmt_Day = DATAMANAGER.GetDataValue(0 , "obrtp_comn_017r" , "OutBlock1" , "TR_AMT" , 0)
	    
	    DATAMANAGER.RequestTranData("obrtp_comn_018r")
    End If    
    
    
    If szTranID == "obrtp_comn_018r"  Then
        g_tactLmtAmt_Total = DATAMANAGER.GetDataValue(0 , "obrtp_comn_018r" , "OutBlock1" , "D1_TACT_LIMT_AMT" , 0)

        If CDbl(g_tactLmtAmt_Total) < CDbl(g_tactLmtAmt_Day) + CDBL(g_sAmt) Then
	    Form.MsgBox("알림", "1일 이체한도 초과입니다." , "" , 0)
	    Form.CloseForm()
	    Exit Sub
	End If
	
	Form.triggerEvent("LinkForm0", "이체확인" , "")
		
	If g_szCertUserType == "3" Or g_szCertUserType == "4" Or g_szCertUserType == "5" Then '메리츠 사설인증 or 바이오인증
	    Form.OpenFramePopup("mhetc90060_p5" , g_szTrMsg , "")
	else
		    Form.MsgBox("알림", "1일 zzz." , "" , 0)

	End If
	    
	    
    End If    


    
End Sub

