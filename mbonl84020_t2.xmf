'============================================================================
' 01. 화 면 명 : 사고등록/해지_사고해지
' 02. 화면설명 : 사고등록/해지_사고해지
' 03. 작    성 : 2016. 02. 03. 유창재
' 2020.09.18 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
'            :        : v0002 ; [obaci_accd_008r]서비스IO 변경분 재반영
' 2021.02.18 : 권오상 : v0003 : MOTP 적용
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szList		'계좌번호,비밀번호
Dim g_szPW		'비밀번호 암호화 처리
Dim g_PwEnable	'비밀번호값 보유 여부
Dim g_nTranCount	'TR Output Count
Dim g_SelectCount	'사고해지 선택 여부 판단
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_plain_rm  	'v0001 메모리평문적용여부

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetCancel() : 사고해지 처리
'============================================================================
Function SetCancel()
	DATAMANAGER.ClearInputData( 0 , "obaci_accd_007u")

	for i = 0 to g_nTranCount - 1
		if grd0.GetCellData("bd_cell0", i) == "1" then 'and grd0.GetCellData("bd_cell7", i) == "가능" then
			DATAMANAGER.SetDataValue( 0, "obaci_accd_007u", "InBlock1", "ACNO" , 0 , grd0.GetCellData("bd_cell1", i))	'계좌번호
			DATAMANAGER.SetDataValue( 0, "obaci_accd_007u", "InBlock2", "ASNO" , 0 , grd0.GetCellData("bd_cell5", i))	'계좌일련번호
			DATAMANAGER.SetDataValue( 0, "obaci_accd_007u", "InBlock2", "ACDN_REG_DATE" , 0 , grd0.GetCellData("bd_cell3", i))	'사고등록일자
			DATAMANAGER.SetDataValue( 0, "obaci_accd_007u", "InBlock2", "ACDN_REG_SRNO" , 0 , grd0.GetCellData("bd_cell4", i))	'사고등록일련번호
			DATAMANAGER.SetDataValue( 0, "obaci_accd_007u", "InBlock2", "ACDN_REG_TRGT_CLS_CODE" , 0 , grd0.GetCellData("bd_cell9", i))	'사고등록대상구분코드
			DATAMANAGER.SetDataValue( 0, "obaci_accd_007u", "InBlock2", "ACDN_TYPE_CODE" , 0 , grd0.GetCellData("bd_cell11", i))	'사고유형코드
			DATAMANAGER.SetDataValue( 0, "obaci_accd_007u", "InBlock2", "PRVS_SUSP_OCRN_SRNO" , 0 , grd0.GetCellData("bd_cell8", i))	'지급정지발생일련번호
			DATAMANAGER.SetDataValue( 0, "obaci_accd_007u", "InBlock2", "PRVS_SUSP_TRGT_CLS_CODE" , 0 , grd0.GetCellData("bd_cell10", i))	'지급정지대상구분코드
			
			DATAMANAGER.RequestTranData("obaci_accd_007u")
		else
'			Form.ShowAlert("", "사고해지가 불가능 합니다.")
		end if
	next

'	DATAMANAGER.SetDataValue( 0, "obaci_accd_007u", "InBlock2", "ACNO" , 0 , g_szList(0))
'	DATAMANAGER.SetDataValue( 0, "obaci_accd_007u", "InBlock1", "ACNT_PWD" , 0 , g_szPW)
	
'	DATAMANAGER.RequestTranData("obaci_accd_007u")
End Function

'============================================================================
' ReplaceACDN(szData) : 사고단위 매크로 처리
'============================================================================
Function ReplaceACDN(szData, nIndex)

	Select Case szData
		Case "01"	grd0.SetCellData("bd_cell6", nIndex , "사망")
		Case "02"	grd0.SetCellData("bd_cell6", nIndex , "카드분실")
		Case "03"	grd0.SetCellData("bd_cell6", nIndex , "IC카드분실")
		Case "04"	grd0.SetCellData("bd_cell6", nIndex , "인감분실")
		Case "05"	grd0.SetCellData("bd_cell6", nIndex , "통장분실")
		Case "06"	grd0.SetCellData("bd_cell6", nIndex , "보안카드분실")
		Case "07"	grd0.SetCellData("bd_cell6", nIndex , "OTP분실")
		Case "08"	grd0.SetCellData("bd_cell6", nIndex , "OTP교체")
		Case "09"	grd0.SetCellData("bd_cell6", nIndex , "고객요청 출금(고)불응")
		Case "10"	grd0.SetCellData("bd_cell6", nIndex , "고객요청 주문불응")
		Case "11"	grd0.SetCellData("bd_cell6", nIndex , "고객요청 주문불응(일부)")
		Case "12"	grd0.SetCellData("bd_cell6", nIndex , "회사조치 출금(고)불응")
		Case "13"	grd0.SetCellData("bd_cell6", nIndex , "회사조치 주문불응")
		Case "14"	grd0.SetCellData("bd_cell6", nIndex , "질권설정")
		Case "15"	grd0.SetCellData("bd_cell6", nIndex , "법적지급정지(압류)")
		Case "16"	grd0.SetCellData("bd_cell6", nIndex , "실질주주증명서발급")
		Case "17"	grd0.SetCellData("bd_cell6", nIndex , "예탁증명서발급")
		Case "18"	grd0.SetCellData("bd_cell6", nIndex , "회사조치 주문제한(KYC)")
		Case "19"	grd0.SetCellData("bd_cell6", nIndex , "회사조치 주문제한(KYC고위험)")
		Case "20"	grd0.SetCellData("bd_cell6", nIndex , "불공정수탁거부(현물)")
		Case "21"	grd0.SetCellData("bd_cell6", nIndex , "불공정수탁거부(선물)")
		Case "22"	grd0.SetCellData("bd_cell6", nIndex , "외국인일일변동사고")
		Case "23"	grd0.SetCellData("bd_cell6", nIndex , "카드미수령")
		Case "24"	grd0.SetCellData("bd_cell6", nIndex , "콜실패")
		Case "25"	grd0.SetCellData("bd_cell6", nIndex , "체크카드분실")
		Case "26"	grd0.SetCellData("bd_cell6", nIndex , "개설대행 온라인 미등록")
		Case "27"	grd0.SetCellData("bd_cell6", nIndex , "[전단채]채권자증명서발급")
		Case "28"	grd0.SetCellData("bd_cell6", nIndex , "[전단채]소유내용통지요청")
		Case "29"	grd0.SetCellData("bd_cell6", nIndex , "금융사기 지급정지(피해자)")
		Case "30"	grd0.SetCellData("bd_cell6", nIndex , "금융사기 지급정지(이용계좌)")
		Case "31"	grd0.SetCellData("bd_cell6", nIndex , "금융사기 입금제한(이용계좌)")
		Case "32"	grd0.SetCellData("bd_cell6", nIndex , "금융사기 의심계좌 임시지급정지(이용계좌)")
		Case "33"	grd0.SetCellData("bd_cell6", nIndex , "금융사기 전자금융거래제한(이용계좌)")
		Case "34"	grd0.SetCellData("bd_cell6", nIndex , "해킹사고 지급정지(이용계좌)")
		Case "35"	grd0.SetCellData("bd_cell6", nIndex , "해킹사고 입금제한(이용계좌)")
		Case "36"	grd0.SetCellData("bd_cell6", nIndex , "해킹사고 비대면채널 출납제한")
		Case "37"	grd0.SetCellData("bd_cell6", nIndex , "해킹사고 지급정지-금액(이용계좌)")
		Case "38"	grd0.SetCellData("bd_cell6", nIndex , "금융사기 비대면채널 출납제한(이용계좌)")
		Case "40"	grd0.SetCellData("bd_cell6", nIndex , "은행연계카드사고")
		Case "99"	grd0.SetCellData("bd_cell6", nIndex , "기타")
	End Select	

End Function
'============================================================================
' SelectCheck() : 사고해지 선택 여부 판단
'============================================================================
Function SelectCheck()
	g_SelectCount = 0
	
	for i = 0 to g_nTranCount - 1
		if grd0.GetCellData("bd_cell0", i) == "1" then
			g_SelectCount = g_SelectCount + 1
		end if
	next
	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' btnNotice_OnClick() : 유의사항 팝업 
'============================================================================
Sub btnNotice_OnClick()
	Form.OpenPopup("mbonl84020_p1" , "사고해지" , sPosInfo)
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	g_SelectCount = 0
	
	if sEventName <> "사고해지" then
		Exit Sub		
	end if
	
	g_szList = Split(sParam, "★")
		
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	'v0001 메모리평문적용여부에 따라 암호화/비암호화된 정보로 넘어오므로 연계화면 변경시 확인필수(mbonl84020)
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
	    g_szPW = g_szList(1)
	else  'MTS메모리평문 미적용상태일때
	    g_szPW = Form.GetEncData(g_szList(1))
	end if	
	
	DATAMANAGER.SetDataValue( 0 , "obaci_accd_008r", "InBlock1", "ACNO" , 0 , g_szList(0))
	DATAMANAGER.SetDataValue( 0 , "obaci_accd_008r", "InBlock1", "ACNO" , 0 , g_szPW)
	
	g_nNextCount = 0
	
	if UBOUND(g_szList) > 2 then
		Exit Sub
	End if
	
	DATAMANAGER.RequestTranData("obaci_accd_008r")
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szData, szData1, szData2
	
	'사고구분, 사고단위, 해제가능여부 매크로 처리
	if szTranID == "obaci_accd_008r" then
		g_nTranCount = DATAMANAGER.GetDataCount( 0 , "obaci_accd_008r", "OutBlock1")
		for i = 0 to g_nTranCount - 1
			g_nNextCount = g_nNextCount + 1
			
			grd0.SetCellData("bd_cell0", i, 0)
			grd0.SetCellBgColor("bd_cell0", i, "38")
			grd0.SetCellBgColor("bd_cell1", i, "38")
			grd0.SetCellBgColor("bd_cell2", i, "38")
			grd0.SetCellBgColor("bd_cell3", i, "38")
			grd0.SetCellBgColor("bd_cell5", i, "38")
			grd0.SetCellBgColor("bd_cell6", i, "38")
			grd0.SetCellBgColor("bd_cell7", i, "38")
			
			szData = DATAMANAGER.GetDataValue( 0 , "obaci_accd_008r", "OutBlock1", "ACDN_REG_TRGT_CLS_CODE" , i)
			szData1 = DATAMANAGER.GetDataValue( 0 , "obaci_accd_008r", "OutBlock1", "ACDN_TYPE_CODE" , i)
			szData2 = DATAMANAGER.GetDataValue( 0 , "obaci_accd_008r", "OutBlock1", "CANC_ABLE_YN" , i)
			
			Call ReplaceACDN(szData1, i)
			if szData2 == "Y" then
				grd0.SetCellData("bd_cell7", i, "가능")
				 grd0.SetCellEnable( "bd_cell0", i, true)
			elseif szData2 == "N" then
				grd0.SetCellData("bd_cell7", i, "불가능")
				grd0.SetCellEnable( "bd_cell0", i, false)
			end if
			
			Select Case szData
				Case "1"		grd0.SetCellData("bd_cell2", i, "고객")
				Case "2"		grd0.SetCellData("bd_cell2", i, "종합계좌")
				Case "3"		grd0.SetCellData("bd_cell2", i, "개별계좌")
				Case "4"		grd0.SetCellData("bd_cell2", i, "잔고")
			End Select	
		next
		
	elseif szTranID == "obcsb_oimf_625r" then	'보안인증
		Dim sSPLM_ATHN_NCSR_YN 
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			Case "4" 'mOTP v0003
				Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "" )
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	elseif szTranID == "obaci_accd_007u" then
		Form.ShowAlert( "알림" , "해지가 완료되었습니다.")
		Form.triggerEvent( "#", "Clear", "Two")
	end if
End Sub
'============================================================================
' btn0_OnClick() : 보안매체 확인 처리
'============================================================================
Sub btn0_OnClick()
	Dim TopPW	'어미 화면의 PW 체크
	TopPW = Form.GetCtlProp( "#edtPW", "caption")
	
	if g_szPW == "" or g_szPW == Null or TopPW == "" then
		Form.MsgBox("알림", "비밀번호를 입력해 주십시오.", 0, 6)
		Exit Sub
	else
		Call SelectCheck()
		
		if g_SelectCount <> 0 then		'상품선택 여부 확인
'			Call SetCancel()				'Test 용
			DATAMANAGER.RequestTranData("obcsb_oimf_625r")
		else
			Form.MsgBox("알림", "해지할 사고를 선택하십시오.", 0, 6)
		end if
	end if	
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 보안매체 처리하기 위한 TR 입력
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obcsb_oimf_625r" then
		Dim sDeviceID, sACNO', sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		sACNO = g_szList(0)
'		sACNO_PWD = Form.GetEncData(g_szList(2))
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , g_szPW )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
	elseif szTranID == "obaci_accd_008r" then
		DATAMANAGER.SetDataValue( 0, "obaci_accd_008r", "InBlock1", "ACNO" , 0 , g_szList(0))		'계좌번호
		DATAMANAGER.SetDataValue( 0, "obaci_accd_008r", "InBlock1", "ACNT_PWD" , g_szPW)			'비밀번호
		
	elseif szTranID == "obaci_accd_007u" then
		DATAMANAGER.SetDataValue( 0, "obaci_accd_007u", "InBlock2", "ACNO" , 0 , g_szList(0))		'계좌번호
		DATAMANAGER.SetDataValue( 0, "obaci_accd_007u", "InBlock1", "ACNT_PWD" , 0 , g_szPW)			'비밀번호
	end if
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mhetc90060_p9" or sKeyName == "mhetc90060_pa" or sKeyName == "mhetc90060_pb" or sKeyName == "mhetc90060_motp" then 'v0003
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		end if 
	'2024-02-01 : 인증매체 등록(mhetc90190_p1)
	elseif sKeyName == "mhetc90190_p1" then
'		if sRet == "ok" then
'			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo )	'공인인증서_비밀번호입력 풀팝업
'		end if 		
	elseif sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			'청약실행
			Call SetCancel()
'			Form.ShowAlert("Test", "청약실행ㄱ")
		end if
	end if
	
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID)
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	
'	for i = 0 to g_nTranCount -1'g_nNextCount - 1 
	if grd0.GetCellData("bd_cell7", lRow) == "가능" then
		if grd0.GetCellData("bd_cell0", lRow) == "0" then
'			grd0.SetCellData("bd_cell0", lRow, 0)
			grd0.SetCellBgColor("bd_cell0", lRow, "38")
			grd0.SetCellBgColor("bd_cell1", lRow, "38")
			grd0.SetCellBgColor("bd_cell2", lRow, "38")
			grd0.SetCellBgColor("bd_cell3", lRow, "38")
			grd0.SetCellBgColor("bd_cell5", lRow, "38")
			grd0.SetCellBgColor("bd_cell6", lRow, "38")
			grd0.SetCellBgColor("bd_cell7", lRow, "38")
		elseif grd0.GetCellData("bd_cell0", lRow) == "1" then
'			grd0.SetCellData("bd_cell0", lRow, 1)
			grd0.SetCellBgColor("bd_cell0", lRow, "44")				'셀 선택시 하이라이트색 사용
			grd0.SetCellBgColor("bd_cell1", lRow, "44")
			grd0.SetCellBgColor("bd_cell2", lRow, "44")
			grd0.SetCellBgColor("bd_cell3", lRow, "44")
			grd0.SetCellBgColor("bd_cell5", lRow, "44")
			grd0.SetCellBgColor("bd_cell6", lRow, "44")
			grd0.SetCellBgColor("bd_cell7", lRow, "44")
		end if
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obaci_accd_007u" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obaci_accd_007u" )
		Form.MsgBox("알림", szErrMsg.."("..szSubErr..")", 0, 6)
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
End Sub

'============================================================================
'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
'============================================================================
Sub RegisterOTP()
	'계좌번호★주민번호(필수아님)★Y/N( 모바일OTP/타기관OTP 발급 완료 후 인증 처리 진행여부를 판단함)★Y/N(처리 완료시 화면닫기)	
	Form.OpenPopup("mhetc90190_p1", g_szList(0) &"★"& "" &"★"& "N" &"★"& "Y", "")	
	'Form.OpenPopup("mhetc90190_p1", g_szList(0) &"★"& "" &"★"& "Y" &"★"& "Y", "")	
End Sub

