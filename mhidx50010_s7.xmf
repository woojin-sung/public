				<TRBLOCK name="InBlock1" >
					<FIELD name="FID_INPUT_COND_MRKT_DIV_CODE" idx="0" defconst="J" />
					<FIELD name="FID_INPUT_COND_SCR_DIV_CODE" idx="2" defconst="1001" />
					<FIELD name="FID_INPUT_RANK_SORT_CLS_CODE" idx="3" defconst="01" />
				</TRBLOCK>
			</TRAN>
		</TRID_INFO>
		<TRIO_INFO>
