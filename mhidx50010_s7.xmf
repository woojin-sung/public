	<SCRIPT_INFO _len="3830" _ulen="3658" >
'============================================================================
' 01. 화 면 명 : HOME_주목받는 섹터
' 02. 화면설명 : 주목받는 섹터 -> 섹터리스트 조회
' 03. 작    성 : 
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_arrayCode
Dim g_arrayData

Dim g_nTab
'============================================================================
Sub Form_OnFormInit()
	linkfm0.gesture = true
	
	g_nTab = 0
	FormTab0.currenttab = g_nTab
	
	lblTitle.fgcolor = 334
	DATAMANAGER.RequestTranData("ohhts_1033_002r")	'섹터 조회: 등락률 상승률 순
End Sub

'============================================================================
Sub lblMore0_OnClick()
	Form.OpenScreen("11030" , "1")
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_1033_002r" then
		g_arrayCode = ""
		g_arrayData = ""
		
		'데이터가 없는 경우
		nCnt = Cint(DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1"))
		
		if nCnt = 0 then
			contNone.left = 0
			linkfm0.linkfile = "empty"
			exit sub
		else
			linkfm0.linkfile = "mhidx50010_t5"
			
			if nCnt > 3 then
				nCnt = 3
			end if
		end if
			
		for i = 0 to nCnt-1
			szCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_TMST_CODE" , i)
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_PRDY_CTRT" , i)
			
			g_arrayCode = g_arrayCode..szCode.."★"
			g_arrayData = g_arrayData..szData.."★"
		next
		
		call FormTab0_OnTabChanged(g_nTab)
	end if
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	arrayCode = Split(g_arrayCode, "★")
	arrayData = Split(g_arrayData, "★")
	szData = arrayCode(nCurrentTab).."★"..arrayData(nCurrentTab)

'	Form.triggerEvent( "FormTab0."..FormTab0.currenttabpageid, "INIT", arrayCode(nCurrentTab).."★"..arrayData(nCurrentTab))
	Form.triggerEvent( "linkfm0", "INIT", szData)

End Sub

'============================================================================
Sub linkfm0_OnGestureEvent(sEvent)
	Form.triggerEvent( "linkfm0", "CLEAR", "")

	if sEvent == "RtoL" then
		btnNext()
	elseif sEvent == "LtoR" then
		btnPrev()
	end if
	
End Sub

'============================================================================
' btnPrev_OnClick : 관심그룹보기 ◁(이전)버튼
'============================================================================
Function btnPrev()
	if Int(g_nTab) == 0 then
		g_nTab = 0
	else
		g_nTab = g_nTab - 1
	end if
	
	FormTab0.currenttab = g_nTab
	call FormTab0_OnTabChanged(g_nTab)
End Function

'============================================================================
' btnNext_OnClick : 관심그룹보기 ▷(다음)버튼
'============================================================================
Function btnNext()
	if g_nTab == 2 then
		g_nTab = 2		
	else
		g_nTab = g_nTab + 1		
	end if
	
	FormTab0.currenttab = g_nTab
	call FormTab0_OnTabChanged(g_nTab)
End Function

'============================================================================
Sub Form_OnRefresh()
	DATAMANAGER.RequestTranData("ohhts_1033_002r")	'섹터 조회: 등락률 상승률 순
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	contNone.left = 1000
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	contNone.imgNotice.setmaintainingratio("1")
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
