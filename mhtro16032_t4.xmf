End Sub

'============================================================================
'grd01_OnClickUp
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	dim szSymbol
	dim szMarket
	dim szName
	
	szSymbol = Grid0.GetCellData("bd_cell3", lRow)
	szMarket = Grid0.GetCellData("bd_cell7", lRow)
	szName = Grid0.GetCellData("bd_cell0", lRow)

	Form.OpenFramePopup("mhidx42040_p1" , szSymbol & "★" &  szMarket & "★" & szName , sPosInfo)
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_1682_001r" then
		dim nDataCnt
		nDataCnt = 31
		
		for i = 0 to nDataCnt - 1
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" ,i ,"FN")
		next
		
		'귀금속비
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 0,  "COM@GC")	'금
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 1,  "COM@SI")	'은
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 2,  "NYM@PL")	'백금
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 3,  "NYM@PA")	'팔라듐
		
		'비철금속
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 4,  "LME@CDA")	'전기동
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 5,  "COM@HG")	'동
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 6,  "LME@ADY")	'알루미늄 H/G 캐시
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 7,  "LME@NAA")	'NA 알루미늄 3M
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 8,  "LME@ZDY")	'아연 캐시
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 9,  "LME@ZDA")	'아연 3M
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 10,  "LME@NDY")	'니켈 캐시
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 11, "LME@NDA")	'니켈 3M
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 12, "LME@SDY")	'주석 캐시
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 13, "LME@SDA")	'주석 3M
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 14, "LME@PDY")	'납 캐시
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 15, "LME@PDA")	'납 3M
'		
'		'곡물
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 16, "CBT$ZC")	'옥수수
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 17, "CBT$ZW")	'소맥
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 18, "CBT$ZS")	'대두
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 19, "CBT$ZM")	'대두박
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 20, "CBT$ZL")	'대두유
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 21, "CBT$ZO")	'귀리
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 22, "NYB@KC")	'커피
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 23, "NYB@CC")	'코코아
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 24, "NYB@SB")	'설탕
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 25, "NYB@CT")	'면화
		
'		'원유
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 26, "SPT@CL")	'WTI 현물
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 27, "NYM@CL")	'WTI
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 28, "SPT@DU")	'두바이유 현물
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 29, "SPT@EB")	'브렌트유 현물
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 30, "IPE@EB")	'브렌트유

		DATAMANAGER.CancelRealData( "ohhts_nfut_cntg" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_1682_001r" then
		dim ncnt1682, szDataCnt
		dim szCode, szRealCode
		dim szOrgTime
		dim nMulti
			
		ncnt1682 = Grid0.rowcount
		szDataCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		
		nMulti =  ( ncnt1682 / szDataCnt ) - 1
		
		for i=0+(nMulti * szDataCnt) to ncnt1682-1
			szCode =	Grid0.GetCellData("bd_cell3", i)
			szOrgTime = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_CNCN_DATE", i)
			szRealCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_CNCN_ISCD", i)
			
			if len(trim(szCode)) >	0 then
				szRealCode = "(종가)"
			else	
				szRealCode = " "
			end	if
			if szOrgTime = "" or szOrgTime = null then '20220228 HSZ 예외처리 추가
				exit Sub
			else
				szOrgTime = mid(szOrgTIme,5,2) .."/".. mid(szOrgTIme,7,2)
			
				Grid0.SetCellData("bd_cell8", i, szOrgTime..szRealCode)
			end if
		next
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	Grid0.SetClear( )
	DATAMANAGER.RequestTranData("ohhts_1682_001r")
End Sub

'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData( "ohhts_nfut_cntg" )
End Sub

