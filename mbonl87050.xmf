'-------------------------------------------------------------------------------------------
' 01. 화 면 명	: 해외파생ETF 거래신청
' 02. 화면설명	: 해외파생ETF 거래신청
' 03. 작    성	: 2017.12.19 윤유정
' 04. 수    정	: 2018.02.21 윤유정 : ETP 약관 텍스트 > 파일로 변경 v0001
'             	: 2018.02.26 윤유정 : 약관파일 URL 개발/운영 분리 v0002
'			: 2020.09.16 권오상 : v003 : T2008250015 : 메모리평문 취약점 수정
' 2021.05.22 : 정민영 : v004 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obpds_srvc_045a IO변경분 적용
'            : 2023.10.27 : 전상일 : v005 비밀번호 클리어 로직 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim	g_Csno
Dim	g_Acno
Dim	g_Asno
Dim	g_nPassword
Dim	g_AprvYN 
	g_AprvYN = ""
Dim	g_SvcSrno 
	g_SvcSrno = 0 
Dim	g_ProsCls
	g_ProsCls = ""
Dim	g_URLheader 'v0002
Dim g_PlainRm 'v003
Dim g_szFnprJoinSrno		'금융상품일련번호
Dim g_szSvcSrno			'서비스일련번호

Dim g_FinCustomer 		'금융소비자 팝업 진행상태
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' 컨트롤 초기화
'============================================================================
Function ClearCnt()
	
	'g_Csno 		= ""
	g_AprvYN 	= ""
	g_SvcSrno 	= 0
	g_ProsCls	= ""
	g_szSvcSrno	= ""
'	g_szFnprJoinSrno = ""
'	Form.SetSharedData( "FNPR_JOIN_SRNO", "" )
	
	'edtPassword.caption = ""
'	g_nPassword = Form.GetEncData(edtPassword.caption) 'v003
	'v003
	If g_PlainRm = "1" Then '보안모듈 적용
		g_nPassword = edtPassword.caption 'v003
	Else
		g_nPassword = Form.GetEncData(edtPassword.caption) 'v003
	End If

	edtSrno.caption = ""
	tblState.SetCellString(0, 1, "")
	btnEnroll.enable = False
	btnEnroll.visible = True
	btnCancle.enable = False
	btnCancle.visible = False
	
	'서류제공방식 선택 관련 추가(초기값 비활성화)
	btnProvision.enable = false
	btnModiTel.enable = false
	chkProvision.checkstate = "0"
End Function
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	edtPassword.caption = "" 'v005 
	g_szFnprJoinSrno		= ""
	Form.SetSharedData( "FNPR_JOIN_SRNO", "" )
	
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v003
'	Dim szText
'	szText = "<html><body><strong>해외주식 파생상품ETF 투자위험 고지문</strong><br><br>"&
'			"1. 해외주식 파생상품ETF란 해외시장에 상장된 기초지수의 일간변동률 변화의 음의 배율 또는 1배를 초과한 배율로 연동하여 운용하는 것을 목표로 하는 상장지수집합투자기구의 집합투자증권(레버리지, 인버스 등)을 말합니다.<br><br>"&
'			"2. 해외주식 파생상품ETF는 해외증권(해외주식 및 해외ETF) 매매에 관한 위험을 모두 포함하고 있습니다.<br><br>"&
'			"3. 해외주식 파생상품ETF는 권리사항 발생 시 현지에서는 정상 거래 중이더라도 국내에는 반영이 즉시 되지 않아 거래가 제한될 수 있으며 그 기간은 한국예탁결제원이 정하는 바에 따릅니다.<br><br>"&
'			"4. 해외주식 파생상품ETF의 투자위험등급과 적합한 투자자유형을 확인하시고, 귀하의 투자경력이나 투자성향에 적합한 상품인지 신중하게 검토한 뒤 투자결정을 하시기 바랍니다.<br><br>"&
'			"5. 해외주식 파생상품ETF의 경우 파생상품의 가치를 결정하는 기초변수 등이 예상과 다른 변화를 보일 때에는 당초 예상과 달리 큰 손실을 입거나 원금전체의 손실을 입을 수 있습니다.<br><br>"&
'			"6. 레버리지ETF는 기초지수의 일간변동률의 양의 배수로 연동되도록 설계되어 있기 때문에 2일 이상의 기간에는 일별수익률의 복리화 효과의 결과로 기초지수의 양의 배수 수익률과 레버리지 ETF의 누적수익률간 불일치가 발생합니다.<br>"&
'			" 또한, 시간이 경과함에 따라 투자신탁에 영향을 주는 다양한 요인에 의해 누적수익률이 기초지수 누적수익률의 양의 배수를 추적하지 못할 수 있습니다. 심지어 일시적으로는 또는 지속적으로 누적수익률간의 음의 상관관계가 나타날 수도 있습니다.<br><br>"&
'			"7. 인버스ETF는 기초지수 일간변동률의 음의 배수로 연동되도록 설계되어 있기 때문에 2일 이상의 기간에는 일별 수익률의 복리화 효과로 기초지수의 음의 배수 수익률과 인버스 ETF의 누적수익률 간 불일치가 발생합니다.<br>"&
'			" 또한, 시간이 경과함에 따라 투자신탁에 영향을 주는 다양한 요인에 의해 누적수익률이 기초지수 누적수익률의 음의 배수를 추적하지 못할 수 있습니다."
'			&"</body></html>"
'	web0.loaddata = szText
	
	'v0002 sta
	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)
	If g_ServerMode == "1" Then	'개발기
		'g_URLheader = "http://211.255.202.106/include/resource/htsdown/PDF/"
		g_URLheader = "http://testhome.imeritz.com/include/resource/htsdown/PDF/"
	Else
		g_URLheader = "http://home.imeritz.com/include/resource/htsdown/PDF/"
	End If

	'web0.urlpath = "http://211.255.202.106/include/resource/htsdown/PDF/htsdown_20.htm" 'v0001
	web0.urlpath = g_URLheader & "htsdown_20.htm"
	'v0002 fin
	
	btnEnroll.enable = True     
	btnEnroll.visible = True
	btnCancle.enable = False
	btnCancle.visible = False
	
	'서류제공방식 선택 관련 추가(초기값 비활성화)
	btnProvision.enable = false
	btnModiTel.enable = false
	chkProvision.checkstate = "0"
	
	g_Acno = Left(cmbAccount.caption, 8)
	g_Asno = Right(cmbAccount.caption, 2)
'	g_nPassword = Form.GetEncData(edtPassword.caption) 'v003
	'v003
	If g_PlainRm = "1" Then '보안모듈 적용
		g_nPassword = edtPassword.caption 'v003
	Else
		g_nPassword = Form.GetEncData(edtPassword.caption) 'v003
	End If
	
	'계좌고객 정보 조회
	DATAMANAGER.SetDataValue(0,"obacp_opop_064r", "InBlock1", "ACNO" , 0 , g_Acno)
	DATAMANAGER.RequestTranData("obacp_opop_064r")

End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obacp_opop_064r" Then
		g_Csno		= DATAMANAGER.GetDataValue(0, "obacp_opop_064r", "OutBlock1", "CSNO" , 0)
		
'		'해외주식거래신청여부 조회 
'		'180209 주석(ETP는 고객단위, 해외주식은 상품단위로 약정여부 체크에 제한이 있어 ETP 약정 등록 후 팝업으로 고객알림 대체)
'		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "CSNO" , 0 , g_Csno)	
'		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "ACNO" , 0 , "")	
'		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "ASNO" , 0 , "")	
'		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r", "InBlock1", "SVCD" , 0 , "082")	
'		DATAMANAGER.RequestTranData("obpds_srvc_323r")

		btnEnroll.enable = True
		btnEnroll.visible = True
		btnCancle.enable = False
		btnCancle.visible = False
		
		'해외파생ETF신청여부 조회
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "CSNO" , 0 , g_Csno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "ACNO" , 0 , "")	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "ASNO" , 0 , "")	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "SVCD" , 0 , "083")	
		DATAMANAGER.RequestTranData("obpds_srvc_323r_1")
		
'	ElseIf szTranID == "obpds_srvc_323r" Then ''180209 주석
'		strAprvYN	= DATAMANAGER.GetDataValue(0, "obpds_srvc_323r", "OutBlock1", "APRV_YN" , 0)
'		strSvcSrno	= cdbl(DATAMANAGER.GetDataValue(0, "obpds_srvc_323r", "OutBlock1", "SVC_SRNO" , 0))
'		
'		If (strAprvYN = "Y" and strSvcSrno > 0) or strAprvYN = "N" and strSvcSrno > 0 Then
'			btnEnroll.enable = True
'			btnEnroll.visible = True
'			btnCancle.enable = False
'			btnCancle.visible = False
'			
'			'해외파생ETF신청여부 조회
'			DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "CSNO" , 0 , g_Csno)	
'			DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "ACNO" , 0 , "")	
'			DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "ASNO" , 0 , "")	
'			DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "SVCD" , 0 , "083")	
'			DATAMANAGER.RequestTranData("obpds_srvc_323r_1")
'		Else
'			btnEnroll.enable = False
'			btnEnroll.visible = True
'			btnCancle.enable = False
'			btnCancle.visible = False
'			
'			'해외주식거래신청 화면으로 이동
'			Form.MsgBox("알림", "해외주식 거래신청 후 해외파생ETF 신청을 진행하시기 바랍니다.", "MOVE", 2)
'			
'		End If
	ElseIf szTranID == "obpds_srvc_323r_1" Then
		g_AprvYN		= DATAMANAGER.GetDataValue(0, "obpds_srvc_323r_1", "OutBlock1", "APRV_YN" , 0)
		g_SvcSrno	= cdbl(edtSrno.caption)
		
		If g_AprvYN = "Y" and g_SvcSrno > 0 Then
			tblState.SetCellString(0, 1, "약정")
			btnEnroll.enable = False
			btnEnroll.visible = False
			btnCancle.enable = True
			btnCancle.visible = True
			
			'서류제공방식 선택 관련 추가
			btnProvision.enable = false
			btnModiTel.enable = false
			chkProvision.checkstate = "0"
			
			g_FinCustomer = "Y"
			btnEnroll.enable = true
		ElseIf g_AprvYN = "N" and g_SvcSrno > 0 Then
			tblState.SetCellString(0, 1, "약정")
			btnEnroll.enable = False
			btnEnroll.visible = False
			btnCancle.enable = True
			btnCancle.visible = True
			
			'서류제공방식 선택 관련 추가
			btnProvision.enable = false
			btnModiTel.enable = false
			chkProvision.checkstate = "0"
			
			g_FinCustomer = "Y"
			btnEnroll.enable = true
		Else
			tblState.SetCellString(0, 1, "미약정")
			btnEnroll.enable = True
			btnEnroll.visible = True
			btnCancle.enable = False
			btnCancle.visible = False
			
			'서류제공방식 선택 관련 추가
			btnProvision.enable = true
			btnModiTel.enable = true
			chkProvision.checkstate = "0"
			
			btnEnroll.enable = false
			
		End If
	ElseIf szTranID == "obpds_srvc_045a" Then
	
		If g_ProsCls == "I" Then
			Form.ShowAlert( "알림" , "등록이 완료되었습니다. \n해외주식 거래신청이 미등록된 경우 추가로 신청하시기 바랍니다.")
			
			'서비스일련번호
			g_szSvcSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SVC_SRNO", 0)
			g_szSvcSrno = tonumber(g_szSvcSrno)
			g_szSvcSrno = tostring(g_szSvcSrno)
			
			'계약서류교부처리(계좌고객상품)
		    DATAMANAGER.RequestTranData( "obcsb_dbif_322a" )
		    
		ElseIf g_ProsCls == "D" Then
			Form.ShowAlert( "알림" , "해지가 완료되었습니다.")
			
			
		End If
		edtPassword.caption = ""
		ClearCnt()		
	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "CSNO" , 0 , g_Csno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "ACNO" , 0 , g_Acno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "ASNO" , 0 , g_Asno)	
		DATAMANAGER.SetDataValue(0,"obpds_srvc_323r_1", "InBlock1", "SVCD" , 0 , "083")	
		DATAMANAGER.RequestTranData("obpds_srvc_323r_1")
	
	ElseIf szTranID == "obsap_acif_999a" then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		Form.SetSharedData( "FNPR_JOIN_SRNO", g_szFnprJoinSrno )
		
		'20230717 초기화추가
		chkProvision.checkstate = "0"
		
		Form.SetSharedData("SPCL_CNFR_ACNO", cmbAccount.caption )
		Form.OpenPopup("mbonl81010_p20" , "" , "")	'2023.05.22 금융소비자 팝업 추가		
		
'		If g_szFnprJoinSrno <> "" Then
'			Form.OpenPopup("mbonl81010_p16" , g_Acno & "★" & g_szFnprJoinSrno, "")
'		End If
		
	ElseIf szTranID == "obcsb_dbif_322a" then
'		ClearCnt()
		DATAMANAGER.RequestTranData( "obcsb_acif_199a" )
	elseif szTranID == "obcsb_acif_199a" then 
		g_szFnprJoinSrno = ""
		Form.SetSharedData( "FNPR_JOIN_SRNO", "" ) 
	End If
End Sub


'============================================================================
Sub cmbAccount_ChangeAccount()
	g_Acno = Left(cmbAccount.caption, 8)
	g_Asno = Right(cmbAccount.caption, 2)

	Call ClearCnt()
	g_szFnprJoinSrno = ""
	Form.SetSharedData( "FNPR_JOIN_SRNO", "" )
	
	'계좌고객 정보 조회
	DATAMANAGER.SetDataValue(0,"obacp_opop_064r", "InBlock1", "ACNO" , 0 , g_Acno)
	DATAMANAGER.RequestTranData("obacp_opop_064r")
End Sub

'============================================================================
Sub btnEnroll_OnClick()
	If g_nPassword <> "" and Trim(edtPassword.caption) <> "" then
		If tblState.GetCellString(0, 1) == "미약정" Then	
			
			if chkProvision.checkstate == "1" then
	'			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE"		, 0 , "I")			'처리구분(I등록)
	'			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ACNT_PWD" 			, 0 , g_nPassword)	'계좌비밀번호
	'			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "CSNO" 				, 0 , g_Csno)			'고객번호
	'			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ACNO" 				, 0 , g_Acno)			'계좌번호
	'			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ASNO" 				, 0 , g_Asno)			'계좌일련번호
	'			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVCD" 				, 0 , "083")			'서비스 코드(083해외파생ETF)
	'			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVC_SRNO"			, 0 , g_SvcSrno)		'서비스 일련번호
	'			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVC_MANG_UNIT_CODE"	, 0 , "03")			'서비스 관리 단위코드(03상품)
	'			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ELFN_ID"				, 0 , Form.GetSharedData("&USER_ID" , false))	'HTS ID
	'			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "CONT_CLS_CODE" 		, 0 , "4")			'접촉 구분코드(4온라인)
	'			
	'			DATAMANAGER.RequestTranData("obpds_srvc_045a")
				
				If g_FinCustomer <> "Y" Then
					Form.MsgBox("알림", "전문, 일반 금융소비자를 확인 바랍니다.", "Show_mbonl81010", "1")
					Exit Sub		
				End If
				
				Dim sSendData 
				sSendData = "87050" & "★" & g_Acno & "★" & g_Asno & "★" & edtPassword.caption & "★" & "083"
				Form.OpenPopup("mbonl81010_p1" , sSendData , "")
			else
				Form.ShowAlert( "알림" , "서류 제공방식을 선택하세요.")
			end if
		Else
			Form.MsgBox("알림", "이미 등록된 약정입니다.", "", 0)
			g_nPassword = ""
			edtPassword.caption = ""
		End if
	Else
		Form.MsgBox("알림", "비밀번호를 확인해주세요.", "", 0)
		Exit Sub
	End If
End Sub

'============================================================================
Sub edtPassword_OnEditComplete()
'	g_nPassword = Form.GetEncData(edtPassword.caption) 'v003
	'v003
	If g_PlainRm = "1" Then '보안모듈 적용
		g_nPassword = edtPassword.caption 'v003
	Else
		g_nPassword = Form.GetEncData(edtPassword.caption) 'v003
	End If
		
'	if g_szFnprJoinSrno <> "" and g_szFnprJoinSrno <> null then
	'20230717 길이체크 조건 추가
	if trim(tblState.GetCellString(0, 1)) <> "약정" and len(trim(g_szFnprJoinSrno)) == 0 then
		DATAMANAGER.RequestTranData( "obsap_acif_999a" ) 'v007 금융상품 일련번호 GET
	end if
'	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	If szTranID == "obpds_srvc_323r" Then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		Call ClearCnt()
		g_szFnprJoinSrno = ""
		Form.SetSharedData( "FNPR_JOIN_SRNO", "" )
	Else
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		'Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		
		if len(trim(szSubErr)) = 0 then
			Form.ShowAlert( "알림" , szErrMsg)
		else
			Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		end if		
	End If
	
End Sub
'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)	
	If sKeyName == "MOVE" Then
		If sRet == "ok" Then
			Form.OpenScreen("87051" , "")
			
		Else
			Call ClearCnt()
			g_szFnprJoinSrno = ""
			Form.SetSharedData( "FNPR_JOIN_SRNO", "" )
		End If
	elseif sKeyName == "Show_mbonl81010" then
		if sRet == "ok" then
			Form.OpenPopup("mbonl81010_p20" , "" , "")
		end if
	end if
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "KYCCHK_RETURN" Then
		If sRet == "Y" Then
'			g_nPassword = Form.GetEncData(edtPassword.caption) 'v003
			'v003
			If g_PlainRm = "1" Then '보안모듈 적용
				g_nPassword = edtPassword.caption 'v003
			Else
				g_nPassword = Form.GetEncData(edtPassword.caption) 'v003
			End If

			g_ProsCls	= "I"
			
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE"		, 0 , "I")			'처리구분(I등록)
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ACNT_PWD" 			, 0 , g_nPassword)	'계좌비밀번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "CSNO" 				, 0 , g_Csno)			'고객번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ACNO" 				, 0 , g_Acno)			'계좌번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ASNO" 				, 0 , g_Asno)			'계좌일련번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVCD" 				, 0 , "083")			'서비스 코드(083해외파생ETF)
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVC_SRNO"			, 0 , g_SvcSrno)		'서비스 일련번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVC_MANG_UNIT_CODE"	, 0 , "01")			'서비스 관리 단위코드(01고객)
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ELFN_ID"				, 0 , Form.GetSharedData("&USER_ID" , false))	'HTS ID
			DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "CONT_CLS_CODE" 		, 0 , "4")			'접촉 구분코드(4온라인)
			
			DATAMANAGER.RequestTranData("obpds_srvc_045a")
		Else
'			Call ClearCnt()
		End If
	
	'서류제공방식선택 팝업 리턴
	Elseif sKeyName == "ok_mbonl81010_p16" then
		If Trim(sRet) == "OK" then
			chkProvision.checkstate = "1"	
		else
			chkProvision.checkstate = "0"
		end if		
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			g_FinCustomer = "Y"
			btnEnroll.enable = true
		elseif sRet == "CANCEL_mbonl81010_p20" then
'			g_FinCustomer = "N"
			btnEnroll.enable = false
			
			'가입중단시 처리미완료인경우 메뉴트리로 빠지도록 함 (2023.06.14)
			tRst = Form.GetSharedData( "81010_P20_RST" , false )
			if trim(tRst) <> "Y" then
				Form.OpenMainMenuWithIndex(0,1,0)
			end if			
		end if
	End If
End Sub

'============================================================================
Sub btnCancle_OnClick()
	g_ProsCls	= "D"
	
	DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE"		, 0 , "D")			'처리구분(I등록)
	DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ACNT_PWD" 			, 0 , g_nPassword)	'계좌비밀번호
	DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "CSNO" 				, 0 , g_Csno)			'고객번호
	DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ACNO" 				, 0 , g_Acno)			'계좌번호
	DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ASNO" 				, 0 , g_Asno)			'계좌일련번호
	DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVCD" 				, 0 , "083")			'서비스 코드(083해외파생ETF)
	DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVC_SRNO"			, 0 , g_SvcSrno)		'서비스 일련번호
	DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "SVC_MANG_UNIT_CODE"	, 0 , "01")			'서비스 관리 단위코드(01고객)
	DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "ELFN_ID"				, 0 , Form.GetSharedData("&USER_ID" , false))	'HTS ID
	DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "CONT_CLS_CODE" 		, 0 , "4")			'접촉 구분코드(4온라인)
	
	DATAMANAGER.RequestTranData("obpds_srvc_045a")
End Sub

'============================================================================
Sub btnProvision_OnClick()
	If GetPWCheck() == false Then
		Exit Sub
	End If

	If g_Acno <> "" and g_Acno <> null Then
		If g_szFnprJoinSrno <> "" and g_szFnprJoinSrno <> null Then
			Form.SetSharedData("mbonl81010_p16_LOAN_YN", "Y")	'Y로 넘기면 처리완료 팝업이 안뜸..
			Form.OpenPopup("mbonl81010_p16" , g_Acno & "★" & g_szFnprJoinSrno, "")
'		Else
'			DATAMANAGER.RequestTranData( "obsap_acif_999a" ) 'v0002 금융상품 일련번호 GET
		End If
	End If
End Sub

'============================================================================
Sub btnModiTel_OnClick()
	chkProvision.checkstate = "0"
	Form.OpenFramePopup( "mbonl81000" , "" , "")	'연락처변경
End Sub

'============================================================================
Function GetPWCheck()
    If edtPassword.caption == "" or edtPassword.caption == null then
        Form.MsgBox( "알림" , "비밀번호를 입력십시오." , "" , 6 )
        Return False
    End If
	
    Return True
	
End Function	

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_dbif_322a" then 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 				 , 0 , g_Acno	) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO" 	 , 0 , g_szFnprJoinSrno	) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "BSWR_LRDV_CODE" 	 , 0 , "017"				)	'001:계좌개설 / 017:서비스약정 
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "FNPR_JOIN_DETL_SRNO" , 0 , "00001"			)	'다건일경우 하나씩 증가
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ISCD"				 , 0 , "083"				)	'prcd:계좌개설 / svcd:서비스약정 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "CNRC_DOCU_KEY_VAL"	 , 0 , g_Csno & "$" & "083" & "$" & g_szSvcSrno )	'고객번호$서비스코드$서비스일련번호 
	'v0002 FIN
	elseif szTranID == "obcsb_acif_199a" then 
		
		'ShowAlert("g_szFnprJoinSrnoasd",g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO" 			, 0 , g_szFnprJoinSrno	) 	'금융상풍일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_DETL_SRNO" 	 	, 0 , "00001"			) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_LRDV_LEVL_CODE" 	, 0 , "01"			)'	"01"투자성
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_MDDV_LEVL_CODE" 	, 0 , "02"			)	'02 서비스약정
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_SMDV_LEVL_CODE"	, 0 , "02"& "083"		)	'&서비스약정코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_DTL_DIV_LEVL_CODE"	, 0 , "000" 			)	'CMA전환신청인경우 "009" 그외엔 "000"
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_ISSU_DIV_LEVL_CODE", 0 , "000"			) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISCD" 	 					, 0 , "083"			)	'083 서비스약정 코드
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "KOR_ISNM" 					, 0 , ""				)	
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CSNO"						, 0 , g_Csno		)	'고객번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "SVC_MANG_UNIT_CODE"	 		, 0 , "01" 			)	'서비스관리단위코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO"	 					, 0 , cmbAccount.caption 	)	'계좌컨트롤 8자리
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" 	 					, 0 , ""				) 	'SVC_MANG_UNIT_CODE가 03일때만 매핑
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CONT_CLS_CODE" 	 			, 0 , "4"			)	'온라인
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CHAN_TYPE_CLS_CODE" 		, 0 , ""				)	
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CAFU_TRGT_YN"				, 0 , ""				)	
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ODER_DATE"	 				, 0 , "" 			)	
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "OM_ODER_SRNO"	 			, 0 , "" 			)	
		
	end if
End Sub

