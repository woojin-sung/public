'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 담보대출신청
' 02. 화면설명 : 담보대출신청_유의사항안내
' 03. 작    성 : 2017.07.25 양현정
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData 

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("유의사항")
	g_sRetData = "cancel"
	
	Container0.Label0.caption =		"·업무처리 가능시간 : 평일 08:00 ~ 17:00\n"&
								"   (지점 업무 마감 후에는 처리불가)\n\n"&
								"·융자기간은 90일입니다.(융자처리내역은\n"&
								"    인터넷뱅킹>조회>거래내역조회 화면에서\n"&
								"    확인하실 수 있습니다.)\n\n"&
								"·당일 융자 후 추가 융자 시 예수금 및 잔고\n"& 
								"    변동으로 인하여 담보 가능수량 및 융자\n"&
								"    가능 금액이 변경될 수 있습니다.\n\n"&
								"·융자가능금액이 조회가 되어도 기타 제약\n"&
								"    조건에 따라 융자가 불가할 수 있습니다.\n\n"&
								"·융자금으로 미수주문시 계좌에 대용금,대용\n"& 
								"    증권이 없거나 부족할 경우 결제일에 담보\n"&  
								"    유지비율이 미달될 수 있으니 유의하시기\n"&  
								"    바랍니다.\n\n"&
								"·담보종목을 발행한 회사와 관계(최대주주\n"& 
								"    및 그 특수 관계인, 지분율 5%이상 주주)\n"&
								"    가 없음을 확인하여야 합니다.\n"&
								"    만약 당사의 승인없이 관계인 담보융자가\n"&
								"    집행되었을 시에는 그 사실이 확인되는\n"&
								"    그 즉시 상환하여야 합니다.\n\n"&
								" [개인 신용정보 관련 유의사항]\n\n"&
								"·고객은 신용공여 사실만으로 신용점수가 하락할 수 \n"&
								"    있습니다.\n\n"&
								"·개인신용평점 하락 시 신용공여한도, 담보유지비율, \n" &
								"    신용 기본형의 보증금율, 선물옵션 매매제한 등 \n"&
								"    불이익이 발생할 수 있습니다. \n\n"&
								"·평균적으로 연체율이 높은 형태의 신용공여 및\n"&
								"    연체율이 높은 금융권역의 신용공여는 여타\n"&
								"    신용공여보다 신용점수가 더 큰 폭으로 하락할 수\n"&
								"    있습니다.\n\n"&
								"·신용공여 변제나 이에 준하는 방식으로 거래가 종료된\n"&
								"    경우에도 일정기간 개인신용평점의 산정에 영향을 줄\n"&
								"    수 있습니다."
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl82020_p7" , g_sRetData)
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.SendReturnToParent("mbonl82020_p7" , g_sRetData)
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
