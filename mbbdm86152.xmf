'============================================================================
Sub Form_OnFormInit()
	szMsg = Form.GetOpenLinkData()
	
	
	'szMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
	'szMsg = "이 신분증은 사용할 수 없습니다.\n확인 후 이용바랍니다."
	'szMsg = "재외국민은 비대면 계좌개설이 불가합니다."
	'szMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
	
	Label2.caption = szMsg
	

End Sub
'============================================================================
Sub Button0_OnClick()
	Form.SendReturnToParent("mbbdm86152" , "Retry")
	Form.CloseForm()
End Sub



