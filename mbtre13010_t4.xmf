'-------------------------------------------------------------------------------------------
'20200910 SWJ START 메모리평문제거 (plain_rm = 0 미적용 / plain_rm = 1 적용)
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'*****************************************ㅋ***********************************
Dim gszSet_OrdChkPop  		'주문확인창표시
Dim g_szMarketType 		'주문종류 ( J:주식, W:ELW, T:프리보드 )
	g_szMarketType 	= "J"

'주문확인창 및 주문에 사용
Dim g_szItmCode			'종목코드
Dim g_szOrdNo			'원주문번호	
Dim g_szOrd_SecDate		'대출일자
Dim g_szOrd_ChkAll		'잔량전부
Dim g_szWarnClsCode		'경고메시지코드
Dim g_szPopupData			'주문확인창 데이터
Dim g_szTitle
Dim g_szDate				'예약등록일자
' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm

g_szWarnClsCode	= "N"
g_szTitle = "알림"
plain_rm = ""

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
'============================================================================
'	주문설정값 가져오기
'============================================================================
Function Load_OrderSet()
	'주문확인창 설정
	gszSet_OrdChkPop = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")' 주문확인창	
	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
End Function

'============================================================================
'	계좌번호/비밀번호 확인
'	내역조회는 비밀번호 없이 조회가능하도록 수정함. 20160502 LKM 
'	주문올릴때만 비밀번호 확인하도록 로직 수정
'============================================================================
Function Check_Accout()
'	20160502 LKM START
	Dim szAcctNo
	szAcctNo = Form.GetTopCtlProp("acnt", "caption")
    If Len(Trim(szAcctNo)) < 10 Then
	    Form.ShowAlert( g_szTitle, "계좌번호를 확인후 다시 입력하십시오." )
	    Check_Accout = False
	    Exit Function
	End If
	Check_Accout = True
End Function

'============================================================================
'	주문전송(주문확인창)
'============================================================================
Function Send_Order()	
	'주문전송
	If gszSet_OrdChkPop <> "0" Then	'주문입력확인창 사용시(주문설정) '20130715 scm start 주문고도화(주문확인창 방어로직)
	    Form.OpenPopup( "mhtro16060_p6" , g_szPopupData , "")
	Else	'주문입력확인창 사용안함(주문설정) - 주문전송
		OrderRequest()
	End If   
End Function

'============================================================================
'<<<<주문전 확인사항>>>> 
'============================================================================
Function Check_Order(nRowIdx)
	Dim 	szAcctNo				'계좌번호
	Dim	szAcctName			'계좌명
	Dim 	szItmName			'종목명

	'계좌번호 확인 
    If Check_Accout() = False Then
	    Exit Function
    End If
    
    Dim szAcpw
    szAcpw	= Form.GetTopCtlProp("edtPwd", "caption")
    If szAcpw = "" Then
	    Form.ShowAlert( g_szTitle, "비밀번호를 확인후 다시 입력하십시오." )
	    Exit Function
	End If
    
	' 계좌번호, 계좌명
	szAcctNo 	= Form.GetTopCtlProp("acnt", "caption")
	szAcctName 	= Form.GetTopCtlProp("acnt", "accountname")
	' 종목코드확인   
	g_szItmCode 	= grd0.GetCellData("bd_iteminfo", nRowIdx)
	' 예약주문번호  
	g_szOrdNo = grd0.GetCellData("bd_cell11", nRowIdx)		
	' 예약등록일자
	g_szDate = grd0.GetCellData( "bd_cell1", nRowIdx)
	' 종목명
	szItmName = grd0.GetCellData("bd_cell13", nRowIdx)
	' 잔량전부(취소주문은 잔량 전부)
	g_szOrd_ChkAll = "1"
	'주문데이터    
	g_szPopupData = "12"										' 예약취소
	g_szPopupData = g_szPopupData & "|" & Trim(szAcctNo)			' 계좌번호
	g_szPopupData = g_szPopupData & "|" & szAcctName				' 고객명
	g_szPopupData = g_szPopupData & "|" & g_szItmCode				' 종목코드
	g_szPopupData = g_szPopupData & "|" & szItmName				' 종목명
	g_szPopupData = g_szPopupData & "|" & "보통"					' 주문구분
	g_szPopupData = g_szPopupData & "|" & "1"					' 현금/신용
	g_szPopupData = g_szPopupData & "|" & ""						' 주문수량
	g_szPopupData = g_szPopupData & "|" & g_szOrdNo				' 원주문번호
	g_szPopupData = g_szPopupData & "|" & g_szOrd_ChkAll			' 잔량전부
	'주문전송
	Send_Order()
End Function

'============================================================================
''''''주문전송''''''
'============================================================================
Function OrderRequest()
    DATAMANAGER.RequestTranData( "obtre_oder_008a" )	'예약취소
End Function

'============================================================================
' 거래소코드 -> 거래소벤더코드 변환
'============================================================================
Function Transform_Name(sValue)
	if sValue == "0104" then	' 홍콩
		return "홍콩"
	elseif sValue == "0529" then ' 항셍 지수
		return "항셍"
	elseif sValue == "0215" then ' 상해
		return "상해"
	elseif sValue == "0214" then ' 심천거래소 종목
		return "심천"
	elseif sValue == "0321" then ' 뉴욕
		return "뉴욕"
	elseif sValue == "0066" then ' 아멕스
		return "아멕스"
	elseif sValue == "0537" then ' 나스닥
		return "나스닥"
	elseif sValue == "0130" then ' 미국 OTCBB
		return "미국 OTCBB"
	elseif sValue == "0625" then ' S&P 지수
		return "S&P"
	elseif sValue == "0310" then ' 다우존스 지수
		return "다우존스"
	elseif sValue == "0106" then ' 도쿄
		return "도쿄"
	elseif sValue == "0107" then ' 오사카거래소 종목
		return "오사카"
	elseif sValue == "0112" then ' 자스닥거래소 종목
		return "자스닥"
	elseif sValue == "0889" then ' 니케이 지수
		return "니케이"
	elseif sValue == "0538" then ' 미국 나스닥 지수
		return "미국 나스닥"
	elseif sValue == "0770" then ' 베트남 호치민
		return "호치민"
	elseif sValue == "0771" then ' 베트남 하노이
		return "하노이"
	end if
end Function

'============================================================================
' Set_Unit
'============================================================================
Function Set_Unit(szData, sDecimal)
	
	sztemp = CStr(szData)
	szChk = InStr(sztemp, ".")
	sDecimal = CStr(CInt(sDecimal))
	
	if CStr(szChk) == "0" then
		if sDecimal = "1" then
			sztemp = sztemp & ".0"	
		elseif sDecimal = "2" then
			sztemp = sztemp & ".00"	
		elseif sDecimal = "3" then
			sztemp = sztemp & ".000"	
		elseif sDecimal = "4" then
			sztemp = sztemp & ".0000"	
		end if 
	else
		szCha = CInt(Len(sztemp) - szChk)
		
		if CStr(szCha) == "1" then 
			if sDecimal == "2" then
				sztemp = sztemp & "0"	
			elseif sDecimal == "3" then
				sztemp = sztemp & "00"	
			elseif sDecimal == "4" then
				sztemp = sztemp & "000"
			else 
				sztemp = sztemp
			end if 	
		elseif CStr(szCha) == "2" then 
			if sDecimal == "3" then
				sztemp = sztemp & "0"	
			elseif sDecimal == "4" then
				sztemp = sztemp & "00"
			else
				sztemp = sztemp
			end if	
		elseif CStr(szCha) == "3" then 
			if sDecimal == "4" then
				sztemp = sztemp & "0"
			else 
				sztemp = sztemp
			end if	
		else
			sztemp = sztemp
		end if
	end if
	
	return sztemp
End Function
