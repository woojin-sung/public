'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szAcno,szAsno, szAcpw
	szAcno = Form.GetTopCtlProp("acnt", 		"total")
	szAsno = Form.GetTopCtlProp("acnt", 		"sequence")
	'20200910 SWJ START
	'MTS메모리평문제거 적용상태일 때
	if plain_rm == "1" then
		szAcpw = Form.GetTopCtlProp("edtPwd", 	"caption")
	'MTS메모리평문제거 미적용상태일 때
	else	
		szAcpw = Form.GetTopCtlProp("edtPwd", 	"encdata")
	end if
	'20200910 SWJ END
	If szTranID = "obtre_oder_009r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 		, 0 , szAcno 	)	' 계좌번호(8)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 		, 0 , szAsno 	)	' 계좌일련번호(2)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 	, 0 , szAcpw	)	' 계좌비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_STA_DATE" 	, 0 , cld0.caption	)	' 계좌비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_FIN_DATE" 	, 0 , cld1.caption	)	' 계좌비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DEAL_CLS_CODE" 	, 0 , "0"	)		' 매매구분코드(0:전체,1:매도,2:매수)
		'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" 	, 0 , "1"	)		' 조회구분코드(1:주문일자,2:예약일자)
		'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_IDNT_CLCD" 	, 0 , "0"	)	' 조회식별구분코드(0:전체,1:발주,2:미발주)
	'예약취소
	ElseIf szTranID = "obtre_oder_008a" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"				, 0 , szAcno		)  	' 계좌번호(8)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"				, 0 , szAsno 		)  	' 계좌일련번호(2)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD"			, 0 , szAcpw 		)	' 계좌비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ODER_RSEV_MST_DATE"	, 0 , g_szDate	)	' 주문예약마스터일자(8) - 2019.10.14
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ODER_RSEV_MST_NO"	, 0 , g_szOrdNo	)	' 주문예약마스터번호    - 2019.10.14
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obtre_oder_009r" Then
		For i = 0 To grd0.rowcount -1 
			dim tCodeInfo
			tCodeInfo = {}
			szType    = grd0.GetCellData( "bd_cell6"	, i)	'매매구분
			rSevType  = grd0.GetCellData( "bd_cell8"	, i)	'주문예약구분코드     - 2019.10.14
			hOurType  = grd0.GetCellData( "bd_cell18", i)	'주문예약시간구분코드 - 2019.10.14
			'20201124 LES START 해외주식 시장가매도
			szOrdType = grd0.GetCellData("bd_cell22", i)
			' 버튼 폰트색		
			grd0.SetCellData("bd_cell21", i, "취소")
			grd0.SetCellFgColor( "bd_cell21", i, "4")
			
			tCodeInfo = Split(grd0.GetCellData("bd_iteminfo", i), ".")
			grd0.SetCellData("bd_cell3", i, tCodeInfo[0])
			
			Select Case szOrdType
				Case "1"
					grd0.SetCellData("bd_cell12", i, "지정가")
				Case "2"
					grd0.SetCellData("bd_cell12", i, "시장가")
			End Select
			'20201124 LES END
			
			'주문종류
			Select Case szType
				Case "1"	
					'20201124 LES START 해외주식 시장가매도
					grd0.SetCellFgColor( "bd_cell2", i, "2" )
					grd0.SetCellData( "bd_cell2", i, "신규매도")
					
				Case "2"	
					grd0.SetCellFgColor( "bd_cell2", i, "1" )
					grd0.SetCellData( "bd_cell2", i, "신규매수")
				Case "3"	
					grd0.SetCellFgColor( "bd_cell2", i, "1" )
					grd0.SetCellData( "bd_cell2", i, "청산매수")
				Case "4"	
					grd0.SetCellFgColor( "bd_cell2", i, "2" )
					grd0.SetCellData( "bd_cell2", i, "청산매도")
					
			End Select
			
			'주문예약구분코드 - 2019.10.14
			Select Case rSevType
				Case "1"
					grd0.SetCellData( "bd_cell8", i, "일반예약")
				Case "2" 
					grd0.SetCellData( "bd_cell8", i, "기간잔량")
				Case "3" 
					grd0.SetCellData( "bd_cell8", i, "기간예약")
				Case "4" 
					grd0.SetCellData( "bd_cell8", i, "특정일주문")
			End Select
			
			'20230223 SWJ START: 명칭 변경(정규장)
			'주문예약시간구분코드 - 2019.10.14
			Select Case hOurType
				Case "0"
					grd0.SetCellData( "bd_cell18", i, "정규장개시")
				Case "1" 
					grd0.SetCellData( "bd_cell18", i, "정규장마감 10분전")
				Case "2" 
					grd0.SetCellData( "bd_cell18", i, "정규장마감 30분전")
				
				'20200911 LES START 예약시간 추가
				Case "3" 
					grd0.SetCellData( "bd_cell18", i, "정규장개시 30분후")
				'20200911 LES END
			End Select
		Next
	ElseIf szTranID = "obtre_oder_008a" Then
		g_szTR   = ""
		szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
		szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
'		Form.ShowAlert(szOrdCd, szOrdMsg)
		' 정상주문
		if Trim(szOrdCd) = "0000" then			
			Form.Toast(0, szOrdMsg, true)
			' 주문후 초기화
			if g_szAfterInit = "1" then		
				Init_InputControl()
			end if
		end if
		
		g_szPopupData = ""
		btnSearch_OnClick()
	End If
End Sub

'============================================================================
Sub btnSearch_OnClick()
	If Check_Accout() = False Then
		Exit Sub
	End If
	DATAMANAGER.RequestTranData( "obtre_oder_009r" )
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "주문전송" Then
		OrderRequest()
	End If	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
'		Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
'		Form.Toast(0, szErrMsg, true)
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then	
		btnSearch_OnClick()
	'20160502 LKM START - 계좌변경 
	elseif sEventName = "ChangeAcnt" Then
		grd0.rowcount = 0	'기존내역 Clear
		
		If Check_Accout() = False Then
			Exit Sub
		End If
		
		btnSearch_OnClick()
	'20160502 LKM END
	End If
End Sub

'============================================================================
Sub Form_OnRefresh()
	btnSearch_OnClick()
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	'20201124 LES START 해외주식 시장가 매도
	If szCellID == "bd_cell21" Then
		Call Check_Order(lRow)
	End If
End Sub

