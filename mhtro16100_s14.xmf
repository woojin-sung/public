'============================================================================
Sub LabelData15_OnSizeAutoFit()
	
	'테이블 높이값 조정
	nOrgnTop = Form.GetCtlProp("LabelData15", "top")
	nOrgnHeight = Form.GetCtlProp("LabelData15", "height")
	
	if gOsType == "1" then
		nTargetHeight = Form.calcUnResize(nOrgnTop + nOrgnHeight, "1") + 10
	else
		nTargetHeight = nOrgnTop + nOrgnHeight + 10
	end if
	
	Table0.height = nTargetHeight
	
	'테이블 타이틀라벨 Top값 지정
	nTableTitleTop = nTargetHeight / 2 - 50
	LabelData16.top = nTableTitleTop
	
	'부모화면에 자기사이즈 알리기
	Form.triggerEvent("#", "USA_LinkForm4_Height", nTargetHeight + 20)
	
End Sub
