'============================================================================
Sub Form_OnFormInit()

	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		gbLargeFont = true
		gsLargeFontsize = szTextSize
	end if
	
	'--------------------------------------------------------------
	' 텍스트 속성 변경
	'--------------------------------------------------------------
	ChangeTextAttr("LabelData0")
	ChangeTextAttr("LabelData1")
	ChangeTextAttr("LabelData2")
	ChangeTextAttr("LabelData3")
	ChangeTextAttr("LabelData4")
	ChangeTextAttr("LabelData5")
	ChangeTextAttr("LabelData6")
	ChangeTextAttr("LabelData7")
	ChangeTextAttr("LabelData8")
	ChangeTextAttr("LabelData9")
	ChangeTextAttr("LabelData10")
	ChangeTextAttr("LabelData11")
	ChangeTextAttr("LabelData12")
	ChangeTextAttr("LabelData13")
	ChangeTextAttr("LabelData14")
	ChangeTextAttr("LabelData15")
	
	'--------------------------------------------------------------
	' 텍스트 입력
	'--------------------------------------------------------------
	LabelData0.sizeAutoFit()
	LabelData0.caption = "* 미국 주간거래는 FINRA(미국 금융산업규제국)가 승인한 대체거래소(BOATS, Blue Ocean ATS)를 통해 거래됩니다."
	
	LabelData1.sizeAutoFit()
	LabelData1.caption = "* Blue Ocean ATS에서 제공하는 시세 및 거래가능 종목은 약 1,000여개 종목입니다.\n(정규거래소의 거래량 차이가 크게 있을 수 있음)"

	LabelData2.sizeAutoFit()
	LabelData2.caption = "* 주간거래 미체결 주문은 Pre-market, 정규장, After-market에서 유효하지 않습니다. (주간거래 종료 후 미체결 주문 자동 취소)"
	
	LabelData3.sizeAutoFit()
	LabelData3.caption = "* 주간거래는 지정가 주문만 가능합니다.         "
	
	LabelData4.sizeAutoFit()
	LabelData4.caption = "* 주간거래 시 전종목 주문이 가능하나 호가를 제출하더라도 표기 및 체결되지 않을 수 있습니다."
	
	LabelData5.sizeAutoFit()
	LabelData5.caption = "* 주간거래 시 호가가 없는 종목의 경우 체결이 되지 않을 수 있습니다."
	
	LabelData6.sizeAutoFit()
	LabelData6.caption = "* 주간거래 체결분은 당일 Pre-market, 정규장, After-market에 체결된 주식과 함께 T+2일 결제됩니다."
	
	LabelData7.sizeAutoFit()
	LabelData7.caption = "* 주간거래 시세는 별도의 신청없이 실시간 20호가가 제공되지만, 일부종목에 대해서는 시세가 제공되지 않을 수 있습니다."
	
	LabelData8.sizeAutoFit()
	LabelData8.caption = "* 전일종가 대비 ±20%를 상회하는 주문은 거부될 수 있습니다."
	
	LabelData9.sizeAutoFit()
	LabelData9.caption = "* 주간거래는 정규장 대비 거래량이 적고, 가격변동이 크거나 불리한 가격에 체결될 수 있습니다."
	
	LabelData10.sizeAutoFit()
	LabelData10.caption = "* 주간거래 주문은 현지 거래소, 브로커 및 시세 벤더 등의 사정으로 거부되거나 취소될 수 있습니다."
	
	LabelData11.sizeAutoFit()
	LabelData11.caption = "* 주간거래는 별도 약정이 필요하지 않으며, 기존 해외주식 거래신청이 되어 있는 경우 거래가 가능합니다."
	
	LabelData12.sizeAutoFit()
	LabelData12.caption = "* 당일 권리(분할, 병합, 티커변경, 거래소변경 등) 발생으로 해당종목에 대해 거래 정지 상태가 될 수 있습니다."

	LabelData13.sizeAutoFit()
	LabelData13.caption = "* 주간거래의 휴장일은 정규장 휴장일과 동일합니다."
	
	LabelData14.sizeAutoFit()
	LabelData14.caption = "* 주간거래 수수료는 정규장 거래 수수료율과 동일하게 적용됩니다."
	
	LabelData15.sizeAutoFit()
	LabelData15.caption = "* 주간거래는 정규장과 다른 이유로 거래의 불편함 또는 불리함이 있을 수 있습니다."


	
End Sub
'============================================================================
Function ChangeTextAttr(sCtlName)
	
	'-------------------------------------
	' 글자크기 결정(큰글씨모드 대응)
	'-------------------------------------
	if gbLargeFont then
		
		if gOsType == "1" then
			sTargetTextSize = - Cint((gsLargeFontsize * 2))
		else
			sTargetTextSize = - Cint((gsLargeFontsize * 2))
		end if
		
		sTextSize = sTargetTextSize - 1
	else
		sTargetTextSize = -2
		sTextSize = sTargetTextSize - 1
	end if
	
	'-------------------------------------
	' 글자크기
	'-------------------------------------
	Form.SetCtlProp(sCtlName, "fontsize", sTextSize)
	
	'-------------------------------------
	' 속성변경
	'-------------------------------------
