--===========================================================================
--===========================================================================

Dim g_szItemCode '종목코드
Dim g_szQty '청산가능수량

Dim g_szACNO, g_szASNO	'20200331 HWG : 고유MTS

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("해외파생보유잔고")
	
	Dim szData
	szData = Form.GetOpenLinkData( )

	if szData <> "" then
		Dim tData
		tData = Split(szData,"★")
		
		if UBound(tData) > 0 then
			'20200331 HWG START : 고유MTS
			DATAMANAGER.SetDataValue( false, "obfnp_fnmt_011r", "InBlock1", "FNCD" , 0, tData(0) )
			DATAMANAGER.RequestTranData( "obfnp_fnmt_011r" )
			'20200331 HWG END
		end if
	end if
End Sub

'20200331 HWG START : 고유MTS
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obfnd_oder_012r" then 
		DATAMANAGER.SetDataValue( false, "obfnd_oder_012r", "InBlock1", "ACNO" 			, 0 , g_szACNO)
		DATAMANAGER.SetDataValue( false, "obfnd_oder_012r", "InBlock1", "ASNO" 			, 0 , g_szASNO)
		DATAMANAGER.SetDataValue( false, "obfnd_oder_012r", "InBlock1", "FTOT_TPCD" 		, 0 , "A")
		DATAMANAGER.SetDataValue( false, "obfnd_oder_012r", "InBlock1", "OVDV_ACNT_CLCD"	, 0 , "3")
		DATAMANAGER.SetDataValue( false, "obfnd_oder_012r", "InBlock1", "PROS_CLS_CODE" 	, 0 , "1")
	end if
End Sub
'20200331 HWG END

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'20200331 HWG START : 고유MTS
	if szTranID = "obfnp_fnmt_011r" then 
		g_szACNO  = DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ACNO" , i) '계좌번호
		g_szASNO  = DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ASNO" , i) '계좌일련번호
		
		'해외파생 주문체결내역 호출
		DATAMANAGER.RequestTranData("obfnd_oder_012r")
	elseif szTranID = "obfnd_oder_012r" then
		Dim nCount, nIndex
		
		nCount = DATAMANAGER.GetDataCount( false, "obfnd_oder_012r", "OutBlock1" )
		nIndex = tonumber(grdData.rowcount) - nCount
		
		if nCount > 0 then
			for i = 0 to nCount step 1
				Dim szDealCode, szOTST_VPAL_FAMT, szCRCD
		
				szDealCode  = DATAMANAGER.GetDataValue( false, "obfnd_oder_012r", "OutBlock1", "DEAL_CLS_NAME" , i )'매매구분코드 1:매수, 2:매도
				szOTST_VPAL_FAMT  = DATAMANAGER.GetDataValue( false, "obfnd_oder_012r", "OutBlock1", "OTST_VPAL_FAMT" , i )
				szCRCD    = DATAMANAGER.GetDataValue( false, "obfnd_oder_012r", "OutBlock1", "CRCD" , i )
				szRATE    = DATAMANAGER.GetDataValue( false, "obfnd_oder_012r", "OutBlock1", "RATE" , i ) '평가율

				if szDealCode = "매수" then
					grdData.SetCellData("Deal", nIndex+i, "매수")
					grdData.SetCellFgColor("Deal", nIndex+i, "1")
				elseif szDealCode = "매도" then
					grdData.SetCellData("Deal", nIndex+i, "매도")
					grdData.SetCellFgColor("Deal", nIndex+i, "2")
				end if
		
				if szCRCD = "KRW" or szCRCD = "JPY" then
					nPosition = 0
				else
					nPosition = 2
				end if
		
				if szOTST_VPAL_FAMT <> nil and szOTST_VPAL_FAMT <> "" then
					if tonumber(szOTST_VPAL_FAMT) > 0 then
						grdData.SetCellFgColor("bd_cell6", nIndex+i, "1")
					elseif tonumber(szOTST_VPAL_FAMT) < 0 then
						grdData.SetCellFgColor("bd_cell6", nIndex+i, "2")
					end if
					
					grdData.SetCellData("bd_cell6", nIndex+i, FormatNumber(szOTST_VPAL_FAMT, nPosition))
				end if
				
				if szRATE <> null and szRATE <> "" then
					if tonumber(szRATE) > 100 then
						grdData.SetCellFgColor("bd_cell7", nIndex+i, "1")
					elseif tonumber(szRATE) < 100 then
						grdData.SetCellFgColor("bd_cell7", nIndex+i, "2")
					end if
				end if
				
			next
		end if
	end if
	'20200331 HWG END
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert("알림", "[TR]" & szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert("알림", "[TR]" & szErrMsg)
	end if
End Sub

'============================================================================
Sub grdData_OnClickUp(lRow, szCellID)
	Dim tlistLocation, nYPos, nheight, szExchName
	
	g_szItemCode = grdData.GetCellData("ItemCode", lRow)
	if Trim(g_szItemCode) == "" then
		Exit Sub
	end if
	
	tlistLocation =  Split(grdData.location,":")
	nYPos = Int(tlistLocation[1])
	nheight = tlistLocation[3]
	szExchName = Form.GetItemCodeInfo(g_szItemCode, "exchname")
	g_szQty = grdData.GetCellData("Qty", lRow)
	
	if szExchName <> "" then
		Form.OpenPopup("movepopup" , nYPos & "★" & nheight & "★" & "2" & "★" &  szExchName  & "★" & "현재가" & "★" & "매수" & "★" & "매도" & "★" & "" & "★" & "")
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "MOVEPOP_RETURN" then
		Dim tChk, szChk, szData
		
		if sRet == "" then
			Exit Sub
		end if
		
		tChk = Split(sRet, "★")
		szChk = tChk(0)
		
		If szChk <> "" Then
			If tChk(1) == "0" Then						' 현재가
				Form.OpenScreen("43100", g_szItemCode)
			ElseIf tChk(1) == "1" Then					' 매수
				szData = "0" & "★" & g_szItemCode & "★" & g_szQty
				Form.SendReturnToParent("QTY" , szData)
				Form.CloseForm()
			ElseIf tChk(1) == "2" Then					' 매도
				szData = "1" & "★" & g_szItemCode & "★" & g_szQty
				Form.SendReturnToParent("QTY" , szData)
				Form.CloseForm()
			End If
		End If
	end if
End Sub

