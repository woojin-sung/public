<ROOT>
	<MAP_INFO scrno="90020" scrname="은행/지점개설계좌 ID등록_안내팝업" version="2" writer="이학록" />
	<FORM_INFO name="Form" transmode="0" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="imgBg" imgpath="alpha" ly_vert="0,0,375,647,1" />
		<IMAGE name="imbPopUp" imgpath="popup_bg.9" ly_vert="0,265,375,382,1" />
		<LABEL name="lblText0" fgcolor="095:000000000" fontsize="2" fontstyle="01" caption="ID등록 안내" halign="1" ly_vert="0,280,375,30,1" />
		<TABLE name="Table0" insidelinecolor="102:255255255" colcount="1" rowcount="5" outline="0000" designorder="1" ly_vert="10,320,355,65,1" >
			<COL_INFO ly_vert_width="355" />
			<ROW_INFO ly_vert_height="15,15,15,5,15" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" halign="0" line="0,0" caption="ID등록은 계좌개설 및 온라인 서비스 신청을 한 경우만" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,1,0,1" halign="0" line="0,0" caption="가능합니다. 온라인 서비스 미신청 고객은 온라인 서비스 " fontsize="-2" impidxs="" />
				<CELL cell_ly="0,2,0,2" halign="0" line="0,0" caption="신청 후 이용해주세요." fontsize="-2" impidxs="" />
				<CELL cell_ly="0,3,0,3" halign="0" line="0,0" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,4,0,4" fgcolor="067:049081150" halign="0" line="0,0" caption="온라인 서비스 신청하기" fontsize="-2" impidxs="" />
			</CELL_INFO>
		</TABLE>
		<TABLE name="tbl0" insidelinecolor="038:255255255" colcount="3" rowcount="15" outline="0000" designorder="1" ly_vert="10,390,365,195,1" >
			<COL_INFO ly_vert_width="5,20,340" />
			<ROW_INFO ly_vert_height="5,15,15,15,15,5,15,15,15,15,15,15,15,15,5" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" impidxs="" />
				<CELL cell_ly="1,0,1,0" halign="2" fontsize="-5" impidxs="" />
				<CELL cell_ly="2,0,2,0" halign="0" fontsize="-5" impidxs="" />
				<CELL cell_ly="0,1,2,1" halign="0" caption="사용자 ID 입력시 유의사항" fontsize="-4" fontstyle="01" impidxs="" />
				<CELL cell_ly="0,2,2,2" halign="0" caption="· 영문, 영문+숫자조합 사용가능하며 특수문자 등의 사용은 불가능합니다." fontsize="-5" impidxs="" />
				<CELL cell_ly="0,3,2,3" halign="0" caption="· 자릿수는 6~12자리 입니다." fontsize="-5" impidxs="" />
				<CELL cell_ly="0,4,2,4" halign="0" caption="· 영문인 경우 대소문자를 구분하오니, 주의하시기 바랍니다." fontsize="-5" impidxs="" />
				<CELL cell_ly="0,5,0,5" impidxs="" />
				<CELL cell_ly="1,5,1,5" halign="2" fontsize="-5" impidxs="" />
				<CELL cell_ly="2,5,2,5" halign="0" fontsize="-5" impidxs="" />
				<CELL cell_ly="0,6,2,6" halign="0" caption="ID 비밀번호 입력시 유의사항" fontsize="-4" fontstyle="01" impidxs="" />
				<CELL cell_ly="0,7,2,7" halign="0" caption="· 영문+숫자+특수문자 혼합 필수이며, 자릿수는 8~12자리 입니다." fontsize="-5" impidxs="" />
				<CELL cell_ly="0,8,2,8" halign="0" caption="· 비밀번호는 대·소문자를 구분하오니, 주의하시기 바랍니다." fontsize="-5" impidxs="" />
				<CELL cell_ly="0,9,2,9" halign="0" caption="· 사용자 ID, 주민등록번호, 전화번호(직장, 자택, 휴대폰)의 4자리 이상" fontsize="-5" impidxs="" />
				<CELL cell_ly="0,10,2,10" halign="0" caption="  일치 시 설정이 불가합니다." fontsize="-5" impidxs="" />
				<CELL cell_ly="0,11,2,11" halign="0" caption="· 3자리 이상 연속숫자/연속문자/동일숫자/동일문자 사용이 불가합니다." fontsize="-5" impidxs="" />
				<CELL cell_ly="0,12,2,12" halign="0" caption="ex : 1234, 5678 / abcd, efghi, cbad, zyxb / 5431, 3219, 5555, 0222 /" fontsize="-5" impidxs="" />
				<CELL cell_ly="0,13,2,13" halign="0" caption="        aaaa, bbbb 등" fontsize="-5" impidxs="" />
				<CELL cell_ly="0,14,0,14" impidxs="" />
				<CELL cell_ly="1,14,1,14" halign="2" fontsize="-5" impidxs="" />
				<CELL cell_ly="2,14,2,14" halign="0" fontsize="-5" impidxs="" />
			</CELL_INFO>
		</TABLE>
		<BUTTON name="btnOK" caption="확인" btnimage="btn_20.9" ly_vert="0,597,375,50,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="840" _ulen="796" >

'============================================================================
Sub Form_OnFormInit()
	Table0.SetCellString(4, 0, "온라인 서비스 신청하기 >")
End Sub

'============================================================================
' 확인
'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' 온라인 서비스 신청하기
'============================================================================
Sub Table0_OnClick(lRow, lColumn)

	if lRow == 4 then
		Form.OpenPopup("mhetc90023", "", "")
	end if
	
End Sub

	</SCRIPT_INFO>
