'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' v0001 sta : 보안매체, 전자서명 생략 및 간편이체한도 미적용 > 외화대체처리 TR만 살림
'	if szTranID == "obcsb_oimf_625r" then		'보안매체확인
'		Dim sDeviceID, sACNO, sACNO_PWD
'		
'		sDeviceID = Form.GetDeviceID()
'		sACNO = g_WithdrawAcntNo
'		sACNO_PWD = g_Pswd
'		
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_CLCD" , 0 , "1" )
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DRNG_ACNO" , 0 , sACNO )
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD" , 0 , sACNO_PWD )
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_ACNO" , 0 , "" )
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TACT_AMT" , 0 , "" )
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
		
	if szTranID == "obrtd_fcur_004a" then '외화대체처리
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "SVCD"        , 0 , "201"                    )    
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"        , 0 , Left(g_WithdrawAcntNo,8) )
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ASNO"        , 0 , Right(g_WithdrawAcntNo,2))
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNT_PWD"    , 0 , g_Pswd                   )	
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CNFT_ACNO"   , 0 , Left(g_RcvnAcntNo,8)     )
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CNFT_ASNO"   , 0 , Right(g_RcvnAcntNo,2)    )
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CRCD"        , 0 , g_Crcd                   )        
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "FRCR_TR_AMT" , 0 , g_TrAmt                  )
	
	' 21.10.20 JHY START
	' 공인인증서 성공 여부 저장 ( 인증오류횟수 shared 값으로 가지고 있어서 여기서 성공하면 다른 화면에서 오류 초기화 횟수 초기화 된 값으로 가지고 있어야 하므로 )
'	elseif szTranID == "obcpp_logn_015a" then 
'		Dim szUserID
'		szUserID = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID	
'		
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "USER_ID" , 0 , szUserID ) '사용자ID
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SUCS_YN" , 0 , "Y" ) 
	' 21.10.20 JHY END
	' v0001 fin
	end if
End Sub

