'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
    Form.SetScreenName("외화대체예정내역 확인")
    
    ' v0001 : 보안매체, 전자서명 생략 및 간편이체한도 미적용 > 사용하지 않는 변수 주석처리
'    g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )     

    szData = Form.GetOpenLinkData()

    Dim szList
	
    szList = Split(szData, "★")
	
    if UBOUND(szList) < 1 then
        exit sub
    end if
    
    g_WithdrawAcntNo   = szList(0) '출금계좌번호
    g_WithdrawAcntName = szList(1) '출금계좌명
    g_RcvnAcntNo       = szList(2) '입금계좌번호
    g_RcvnAcntName     = szList(3) '입금계좌명
    g_Crcd             = szList(4) '통화코드
    g_CrcdName         = szList(5) '통화명
    g_TrAmt            = szList(6) '금액
    g_Pswd             = szList(7) '비밀번호
	
    cont01.Table0.SetCellString(0 , 1 , g_WithdrawAcntNo  ) '출금계좌번호
    cont01.Table0.SetCellString(1 , 1 , g_WithdrawAcntName) '출금계좌명
    cont01.Table1.SetCellString(1 , 1 , g_RcvnAcntNo) '입금계좌번호
    cont01.Table1.SetCellString(2 , 1 , g_RcvnAcntName) '입금계좌명
    cont01.Table1.SetCellString(3 , 1 , g_Crcd & " " & g_CrcdName) '통화코드 & 통화명
    cont01.Table1.SetCellString(4 , 1 , g_TrAmt) '금액

    ' v0001 sta : 보안매체, 전자서명 생략 및 간편이체한도 미적용
    ' 21.10.19 JHY START : 바이오 인증시 필요한 거래내역
'    if g_szCertUserType == "3" OR g_szCertUserType == "4" then	'3 -bio 인증 '4 - 공동인증
'		g_sBioTrMsg = "이체예정내역\n" & "입금기관 : " & "메리츠증권" & "\n" & "입금계좌 : " & g_RcvnAcntNo & "\n" & "예금주명 : " & g_RcvnAcntName & "\n" & "이체금액 : " & FormatNumber(CDbl(g_TrAmt), 0, 0, 0, -1) & "원\n" 
'		Form.SetSharedData("BIO_TR_MSG_1" , g_sBioTrMsg)
'	End if
	' 21.10.19 JHY END	
'    DATAMANAGER.RequestTranData("obcsb_oimf_625r")
	' v0001 fin
End Sub

