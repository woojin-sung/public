Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' v0001 sta : 보안매체, 전자서명 생략 및 간편이체한도 미적용 > 외화대체처리 TR만 살림
	if szTranID == "obrtd_fcur_004a" then	'외화대체처리
		Form.OpenPopup("mbbnk61090_p4" , "" , "")

'	elseif szTranID == "obcsb_oimf_625r" then
