	<SCRIPT_INFO _len="1515" _ulen="1439" >
'--===========================================================================
' 01. 화 면 명 : 지정심사안내
' 02. 화면설명 : 
' 03. 작    성 : 2021.06.08 정효영
' 04. 수    정 : 
'
'--===========================================================================

''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	Container0.imgStep1.setMaintainingRatio("1")
	Container0.imgStep2.setMaintainingRatio("1")
	Container0.imgStep3.setMaintainingRatio("1")
	Container0.imgStep4.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szTheme
	szTheme = Form.GetEnvData("common.theme")

	if szTheme == "white" then
		Container0.imgStep5.imgpath = "icon_5step_w"
	else
		Container0.imgStep5.imgpath = "icon_5step_b"
	end if
	
	
	Container0.Label1.changeTextAttr(8, 19, 6, -2, false)
	
	Container0.lblSubTitle1.setHighlight(332)
	Container0.lblSubTitle2.setHighlight(332)
	Container0.lblSubTitle3.setHighlight(332)
	
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		Container0.setScrollBarVisible("2")
	end if
	
End Sub

	</SCRIPT_INFO>
