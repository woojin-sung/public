'============================================================================
Sub Form_OnFormInit()
	g_nMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
'	Form.ShowAlert("OnFormInit", g_nMode)
'	g_nMode = 0
	if CInt(g_nMode) == 0 then
		g_szUrl = "https://home.imeritz.com/include/resource/research/WorkFlow"	'운영계 주소
	elseif CInt(g_nMode) == 1 then
		g_szUrl = "https://testhome.imeritz.com/include/resource/research/WorkFlow"	'테스트계주소
	end if
	
	g_OStype = Form.GetSharedData("&OS_TYPE", false)		'iOS("2") Android("1")
	
	if g_OStype == "1" then
		gridData.visible = True
		gridDataios.visible = False
		
	else
		gridData.visible = False
		gridDataios.visible = True
		
	end if

	gridData.rowcount = 0
	gridDataios.rowcount = 0
	
	DATAMANAGER.RequestTranData( "ooopc_rprt_001r")
End Sub

