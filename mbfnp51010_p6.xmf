'============================================================================
' 01.화면명 		: 펀드매매
' 02.화면설명		: 펀드매매_취소확인창
' 03.작성		: 2016.02.26
' 04.설명		: obacp_opop_068r	-> 공인인증 -> obsai_deal_070a(취소)	
' 05.수정		: 2020.09.15 비밀번호 메모리 평문 노출 취약점 조치 v001 
'                       : 2022.06.21 매도취소화면으로부터 '매도방법구분코드' 추가 v002
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szFullAcnt	'계좌번호 (8+2)
dim	g_szPasswd	'계좌비밀번호
dim	g_szAlertTitle'알림타이틀

dim	g_szFundName, g_szOrdno, g_szReqDate, g_szAplDate 
dim	g_szDealDate,	g_szBuySell, g_szReqQty, g_szReqAmt,	g_szRmndSrno, g_szIiscSelnFormClsCode
	
g_szFullAcnt	=""
g_szPasswd	=""

g_szFundName =""	'펀드명
g_szOrdno=""		'주문번호
g_szReqDate=""	'신청일자
g_szAplDate=""	'기준가적용일
g_szDealDate=""	'결제일
g_szBuySell=""	'매매구분
g_szReqQty="" 	'신청좌수
g_szReqAmt=""		'신청금액
g_szRmndSrno	=""	'잔고번호
g_szAlertTitle	="알림"
g_szIiscSelnFormClsCode = ""     ' 매도방법구분코드 v002
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim	szLinkedData

	
	szLinkedData = Form.GetOpenLinkData()
	
	if	len(trim(szLinkedData))	>	11	then
		g_szFundName		                = 	getListItem(szLinkedData, 0)	'펀드명
		g_szOrdno		                        = 	getListItem(szLinkedData, 1)	'주문번호
		g_szReqDate		                =	getListItem(szLinkedData, 2)	'신청일자
		g_szAplDate		                =	getListItem(szLinkedData, 3)	'기준가적용일
		g_szDealDate		                =	getListItem(szLinkedData, 4)	'결제일
		g_szBuySell		                =	getListItem(szLinkedData, 5)	'매매구분
		g_szReqQtyAmt		                =	getListItem(szLinkedData, 6)	'신청좌수금액
		'g_szReqAmt		                 =	getListItem(szLinkedData, 7)	'신청금액
		g_szRmndSrno		                =	getListItem(szLinkedData, 7)	'잔고번호
		g_szIiscSelnFormClsCode		=	getListItem(szLinkedData, 10)	'매도방법구분코드 v002
		
		lblFndName.caption	=	g_szFundName
		'tbl01.SetCellString(0, 1, g_szFundName)
		tbl01.SetCellString(1, 1, g_szOrdno)
		tbl01.SetCellString(2, 1, g_szReqDate)
		tbl01.SetCellString(3, 1, g_szAplDate)
		tbl01.SetCellString(4, 1, g_szDealDate)
		tbl01.SetCellString(5, 1, g_szBuySell)
		
		if	trim(g_szBuySell)	=	"매수"	then
			tbl01.SetCellString(6, 1, "0")
			tbl01.SetCellString(7, 1, g_szReqQtyAmt)
		else
		        IF TRIM(g_szIiscSelnFormClsCode) = "01" THEN '01.정액매도 v002
			    tbl01.SetCellString(6, 1, "0")
			    tbl01.SetCellString(7, 1, g_szReqQtyAmt)
			ELSE
			    tbl01.SetCellString(6, 1, g_szReqQtyAmt)
			    tbl01.SetCellString(7, 1, "0")
			END IF
		end	if
		
	
		
		g_szFullAcnt	=	getListItem(szLinkedData, 8)
		g_szPasswd	=	getListItem(szLinkedData, 9)

	end if
	
End Sub


'============================================================================
'ImageClose_OnClick
'============================================================================
Sub ImageClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'btnCloseBot_OnClick	:	닫기
'============================================================================
Sub btnCloseBot_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
'btnOK_OnClick	:	확인버튼
'============================================================================
Sub btnOK_OnClick()
	if	len(trim(g_szPasswd))	<	4	then
		Form.ShowAlert("알림", "비밀번호를 입력하여주십시오.")
	end	if
	
	if	len(trim(g_szPasswd))	>=	4	or	len(trim(g_szFullAcnt)) >=	10	then
		DATAMANAGER.RequestTranData("obacp_opop_068r")
	end if
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if	szTranID	=	"obacp_opop_068r"	then
		DATAMANAGER.SetDataValue(0, "obacp_opop_068r", "InBlock1", "ACNO", 0, left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0, "obacp_opop_068r", "InBlock1", "ASNO", 0, mid(g_szFullAcnt, 9, 2))
		
		'v001
		'MTS메모리평문 적용유무
		'plain_rm = ( 0 : 미적용 / 1: 적용)
		plain_rm = Form.GetSharedData("&PLAIN_RM", false )
		'MTS메모리평문 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obacp_opop_068r", "InBlock1", "ACNT_PWD", 0, g_szPasswd)
		'MTS메모리평문 미적용상태 일 때
		else
			DATAMANAGER.SetDataValue(0, "obacp_opop_068r", "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPasswd))
		end if
				
	elseif	szTranID	=	"obsai_deal_070a"	then
		DATAMANAGER.SetDataValue(0,"obsai_deal_070a", "InBlock1", "CONT_CLS_CODE", 0, "4")
		DATAMANAGER.SetDataValue(0,"obsai_deal_070a", "InBlock1", "ACNO", 0, left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0,"obsai_deal_070a", "InBlock1", "ASNO", 0, mid(g_szFullAcnt, 9, 2))
		DATAMANAGER.SetDataValue(0,"obsai_deal_070a", "InBlock1", "RMND_SRNO"	, 0, g_szRmndSrno)
		DATAMANAGER.SetDataValue(0,"obsai_deal_070a", "InBlock1", "ODER_DATE"	, 0, g_szReqDate )
		DATAMANAGER.SetDataValue(0,"obsai_deal_070a", "InBlock1", "OM_ODER_SRNO", 0, g_szOrdno)
		
		'v001
		'MTS메모리평문 적용유무
		'plain_rm = ( 0 : 미적용 / 1: 적용)
		plain_rm = Form.GetSharedData("&PLAIN_RM", false )
		'MTS메모리평문 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0,"obsai_deal_070a", "InBlock1", "ACNT_PWD"		, 0, g_szPasswd)
		'MTS메모리평문 미적용상태 일 때
		else
			DATAMANAGER.SetDataValue(0,"obsai_deal_070a", "InBlock1", "ACNT_PWD"		, 0, Form.GetEncData(g_szPasswd))
		end if
		
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if	szTranID	=	"obacp_opop_068r"	then
	
		if	len(trim(g_szPasswd))	>=	4	or	len(trim(g_szFullAcnt)) >=	10	then
			DATAMANAGER.RequestTranData("obsai_deal_070a")
		end if
	elseif	szTranID	=	"obsai_deal_070a"	then
		Form.SendReturnToParent("CANCELRETURN_070A" , "Y")
		Form.CloseForm()
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'
'	if	szTranID	=	"obsai_deal_070a"	then
'		Form.ShowAlert("알림", "취소에 실패했습니다. 재시도 하여 주십시오.")
'	end	if
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if	len(trim(szSubMsg))	>	0	then
		Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert(g_szAlertTitle, szErrMsg )
	end	if
End Sub


