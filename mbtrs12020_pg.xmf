'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문 경고안내
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


Dim g_nCount
	g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
Dim g_szOrder_MarketType	' 주문종류 ( J:주식, W:ELW )
Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szOrd_ItmCode		' 종목코드
Dim 	g_szOrd_ItmName		' 종목명
Dim 	g_szOrd_OrdType		' 주문구분
Dim 	g_szOrd_Security		' 현금/신용
Dim 	g_szOrd_SecType		' 신용구분
Dim 	g_szOrd_SecDate		' 대출일자
Dim 	g_nOrd_Qty			' 주문수량
Dim 	g_nOrd_Price			' 주문가격
Dim 	g_nOrd_OrdNo			' 원주문번호
Dim 	g_nOrd_ChkAll			' 잔량전부
Dim 	g_szErrMsg			' 경고메세지

'20200824 LES START 제도개선
Dim g_WarnClsCode			'경고구분코드
Dim gScrNo				'부모화면번호


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)

	If g_nOrd_ChkAll = "1" Then
		If g_nIndex = "2" Then
			g_nOrd_Qty = "잔량"
		ElseIf g_nIndex = "3" Then
			g_nOrd_Qty = "전부"
		End If
	End If
	
	If g_szOrder_MarketType = "W" Then	'ELW
		If g_nIndex = "0" Then
			lblTitle.caption = "ELW매수주문"
		ElseIf g_nIndex = "1" Then
			lblTitle.caption = "ELW매도주문"
		ElseIf g_nIndex = "2" Then
			lblTitle.caption = "ELW정정주문"
		End If
	End If
			
	If g_szOrd_Security = "1" Then
		If g_nIndex = "0" Then
			lblTitle.caption = "신용매수주문"
		ElseIf g_nIndex = "1" Then
			lblTitle.caption = "신용매도주문"
		ElseIf g_nIndex = "2" Then
			lblTitle.caption = "신용정정주문"
		End If
	End If
	
	'20200824 LES START 제도개선
	if gScrNo = "12000" or gScrNo = "12010" or gScrNo = "12020" then
	
		'20201116 SWJ START 제도개선
		lbl0.caption = Get_Warn_CLS_Name(g_WarnClsCode) '& " 안내"
		
		Select Case g_WarnClsCode
			Case "3","6","9","c","f"
				
				lbl0.top = 32'lbl0.top - 18
				lblMsg.top = 55'lblMsg.top - 18
				lblMsg.height = 110'lblMsg.height + 18
				
			Case "4","7","a","d","g"
				lbl0.top = 32'lbl0.top - 18
				lblMsg.top = 55'lblMsg.top - 18
				lblMsg.height = 110'lblMsg.height + 18
			
		End Select
	
'		if g_WarnClsCode = "3" then
'			lbl0.caption = "투자유의 안내"
'			
''			lbl0.top = lbl0.top '- 18
''			lblMsg.top = lblMsg.top '- 18
''			lblMsg.height = lblMsg.height + 18
'			
'		elseif g_WarnClsCode = "4" then
'			lbl0.caption = "투자유의/경고 안내"
'			
''			lbl0.top = lbl0.top - 18
''			lblMsg.top = lblMsg.top - 18
''			lblMsg.height = lblMsg.height + 18
'			
'		else
'			lbl0.caption = "경고 안내"
'		end if
		'20201116 SWJ END
	end if
	'20200824 LES END
	
	
	lblMsg.caption = g_szErrMsg	
	
	tbl0.SetCellString( 0, 1, g_szOrder_Acc 	)
	tbl0.SetCellString( 0, 2, g_szOrder_AccName	)
	tbl0.SetCellString( 1, 1, g_szOrd_ItmCode 	)
	tbl0.SetCellString( 2, 1, g_szOrd_ItmName	)
	tbl0.SetCellString( 3, 1, g_nOrd_Qty		)
	tbl0.SetCellString( 4, 1, g_nOrd_Price 		)

End Function

'============================================================================
Function SendOrder()
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문경고" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
    End If
    
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	g_nIndex				= arrData( 0) ' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
	g_szOrder_MarketType	= arrData( 1)	' 주문종류 ( J:주식, W:ELW )
	g_szOrder_Acc			= arrData( 2)	' 계좌번호
	g_szOrder_AccName		= arrData( 3)	' 고객명
	g_szOrd_ItmCode 		= arrData( 4)	' 종목코드
	g_szOrd_ItmName 		= arrData( 5)	' 종목명
	g_szOrd_OrdType  		= arrData( 6)	' 주문구분
	g_szOrd_Security 		= arrData( 7)	' 현금/신용
	g_szOrd_SecType 		= arrData( 8)	' 신용구분
	g_szOrd_SecDate 		= arrData( 9)	' 대출일자
	g_nOrd_Qty   			= arrData(10)	' 주문수량
	g_nOrd_Price 			= arrData(11)	' 주문가격
	g_nOrd_OrdNo 			= arrData(12)	' 원주문번호
	g_nOrd_ChkAll 		= arrData(13)	' 잔량전부
	g_szErrMsg	 		= arrData(14)	' 경고메세지
	
	
	'20200824 LES START 제도개선
	'주식주문/예약주문/호가주문 화면에서 주문냈을 경우에만 탐.
	gScrNo = Form.GetSharedData( "&SCREEN_NO" , false )
	
	if gScrNo = "12000" or gScrNo = "12010" or gScrNo = "12020" then
		g_WarnClsCode 	= arrData(15) '경고구분코드	 
	end if
	'20200824 LES END
	
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	If g_nIndex = "0" Then
		lblTitle.caption = "현금매수주문"
		lblTitle.bgcolor = "92"
		tbl0.SetCellFgColor( 4, 0, "6" )
		tbl0.SetCellFgColor( 4, 1, "6" )
		btnOrder.btnimage = "btn_05.9"
		btnOrder.caption="매수"
		
	ElseIf g_nIndex = "1" Then
		lblTitle.caption = "현금매도주문"
		lblTitle.bgcolor = "91"
		tbl0.SetCellFgColor( 4, 0, "7" )
		tbl0.SetCellFgColor( 4, 1, "7" )
		btnOrder.btnimage = "btn_06.9"
		btnOrder.caption="매도"
	
	ElseIf g_nIndex = "2" Then
		lblTitle.caption = "현금정정주문"
		lblTitle.bgcolor = "93"
		tbl0.SetCellFgColor( 4, 0, "8" )		
		tbl0.SetCellFgColor( 4, 1, "8" )
		btnOrder.btnimage = "btn_07.9"
		btnOrder.caption="정정"
		
	End If	

    Set_Data(g_nIndex)
    
End Sub


'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm( )	
End Sub


'============================================================================
Sub btnOrder_OnClick()
	SendOrder()
End Sub


'============================================================================
Sub imgClose1_OnClick()
	Form.CloseForm( )
End Sub
'============================================================================
'20201116 SWJ START : 제도개선
'============================================================================
Function Get_Warn_CLS_Name(clsCode)
	
	Select Case clsCode
		Case "1"
			Get_Warn_CLS_Name = "경고"
		Case "2"
			Get_Warn_CLS_Name = "보류"
		Case "3"
			Get_Warn_CLS_Name = "투자유의"
		Case "4"
			Get_Warn_CLS_Name = "투자유의/경고"
		Case "5"
			Get_Warn_CLS_Name = "투자유의/보류"
		Case "6"
			Get_Warn_CLS_Name = "단기과열종목"
			
		Case "7"
			Get_Warn_CLS_Name = "단기과열종목/경고"
		Case "8"
			Get_Warn_CLS_Name = "단기과열종목/보류"
		Case "9"
			Get_Warn_CLS_Name = "투자경고"
		Case "a"
			Get_Warn_CLS_Name = "투자경고/경고"
		Case "b"
			Get_Warn_CLS_Name = "투자경고/보류"
		Case "c"
			Get_Warn_CLS_Name = "투자위험"
		Case "d"
			Get_Warn_CLS_Name = "투자위험/경고"
		Case "e"
			Get_Warn_CLS_Name = "투자위험/보류"
		Case "f"
			Get_Warn_CLS_Name = "정리매매"
		Case "g"
			Get_Warn_CLS_Name = "정리매매/경고"
		Case "h"
			Get_Warn_CLS_Name = "정리매매/보류"
		Case Else
			Get_Warn_CLS_Name = "경고"
	End Select
	
	
	
End Function





	</SCRIPT_INFO>
</ROOT>