'============================================================================
' 가격 호가단위 맞추기 
'============================================================================
Function ReSet_Prc(szData, nGbn)	
	if nGbn == 0 then
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))

		if nResult <> 0 and nResult <> CDbl(g_szUnit) then
			return CDbl(szData) - nResult
		else
			return szData
		end if
	else
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))
	
		if nResult <> 0 then
			return CDbl(szData) + (CDbl(g_szUnit) - nResult)
		else
			return szData
		end if
	end if
End Function

'============================================================================
' Return_BorrowScreen : 잔고팝업에서 리턴된 값 적용
'============================================================================
Function Return_BorrowScreen(szRet)
	tData = Split(szRet, "★")

	if UBound(tData) > 0 then
		arrCode = Split(tData(2), ".")

		if UBound(tData) > 0 then
			sCode = arrCode(1) .. "@" .. arrCode(0)
			Form.triggerEvent("#", "13000_BORROW", sCode & "★" & tData(1))
		End if
		
		'Form.triggerEvent("#", "13000_BORROW", szMkCd & "@" & tData(2) & "★" & tData(1))
		
		' 수량
		g_szQty = ""
		edtQty.caption = Fix(tData(3))	
		edtQty_OnEditComplete()
		g_szQty = Fix(tData(3))
		
	end if
End Function		

'============================================================================
' Return_AutoQty
'============================================================================
Function Return_AutoQty()
	if g_szSelQty == "1" then		' 보유잔고수량
		Request_Able()
	elseif g_szSelQty == "2" then
		edtQty.caption = g_szSelQtyCnt
		edtQty_OnEditComplete()
	end if
End Function

'============================================================================
' Request_Able
'============================================================================
Function Request_Able()
	g_szWarnFlag = "N"	' 20181022 HWG : 해외주식 주문착오 방지
	DATAMANAGER.RequestTranData("obtre_oder_004r")	' 주문가능금액 조회	
End Function

'============================================================================
' 거래소코드 <- 거래소 벤더코드
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "0104" then	' 홍콩
		return "HK"
	elseif sValue == "0215" then ' 상해
		return "SH"
	elseif sValue == "0214" then ' 심천거래소 종목
		return "SZ"
	elseif sValue == "0321" then ' 뉴욕
		return "NY"
	elseif sValue == "0066" then ' 아멕스
		return "AX"
	elseif sValue == "0537" then ' 나스닥
		return "OQ"
	elseif sValue == "0106" then ' 도쿄
		return "JP"
	end if
end Function

'============================================================================
' Return_ContractScreen : 미체결팝업에서 리턴된 값 적용
'============================================================================
Function Return_ContractScreen(szRet)
	tData = Split(szRet, "★")
	
	
	if UBound(tData) > 0 then
		szMkCd = Transform_Exid(tData(2))
		
		arrCode = Split(tData(1), ".")

		if UBound(tData) > 0 then
			sCode = arrCode(0)
			Form.triggerEvent("#", "13000_CONTRACT", szMkCd & "@" & sCode & "★" & tData(3))
		End if
		
		' 수량
		g_szQty = ""
		edtQty.caption = Fix(tData(6))	
		edtQty_OnEditComplete()
		g_szQty = Fix(tData(6))

		' 주문가격
		edtPrc.caption = tData(7)
		edtPrc_OnEditComplete()	
	end if
End Function

'============================================================================
Function _tonumber(data)
	return tonumber(data) or 0
end Function

'====================================
'CFD 거래소 코드 함수
'====================================
Function Get_CFDExch(stmpExidCode)
	Dim szVndrCode
    Select Case stmpExidCode 
	    Case "0537", "0321", "0066"
		    szVndrCode = "US"
	    Case "0215", "0214"
		    szVndrCode = "CN"
	    Case "0104"
		    szVndrCode = "HK"
	    Case "0106"
		    szVndrCode = "JP"
    End Select
    
    return szVndrCode

End Function

'============================================================================
'시장거래구분코드
'============================================================================
Function Get_MarketClsCode(szMarketCode)
	Dim szMarketClsCode
	Select Case szMarketCode
	    
	Case "0537", "0321", "0066"  			'미국
	    szMarketClsCode = "01"
	Case "0214"								'심천
	    szMarketClsCode = "04"
	Case "0215"								'상해
	    szMarketClsCode = "03"     
	Case "0104"								'홍콩
	    szMarketClsCode = "02"
	Case "0106"								'일본
	    szMarketClsCode = "05"
	End Select
	
	return szMarketClsCode
End Function

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption
	
	if Trim(szQty) <> "" then
		if CDbl(szQty) >= 99000000 then
			if nGbn == 0 then
				Exit Function
			end if
		end if
	end if
	
	
	if Trim(szQty) == "" then
		if nGbn == 0 then
			szQty = g_szOrdSize
		else
			Exit Function
		end if
	else
'		if Len(szQty) = 1 or Len(szQty) = 2 then
'			nUnit = 1
'		else
'			nCnt = Len(szQty)-1
'			
'			For i = 0 to nCnt-1
'				if i == 0 then
'					szUnit = "1"
'				else
'					szUnit = szUnit & "0"
'				end if
'			Next
'			
'			nUnit = CDbl(szUnit)
'		end if

		nUnit = g_szOrdSize
		
		if nGbn == 0 then
			szQty = CDbl(szQty) + nUnit
		elseif nGbn == 1 then
			if CDbl(szQty) == 0 then
				Exit Function
			else
				szQty = CDbl(szQty) - nUnit
			end if
		end if
	end if
	
	edtQty.caption = szQty
	edtQty_OnEditComplete()
End Function

