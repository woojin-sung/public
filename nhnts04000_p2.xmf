'chkTile_OnChange
'============================================================================
Sub chkTile_OnChange(sCheckState)
	dim szRet
	szRet =  chkCount()
	
	if szRet = -1 and sCheckState = "0" then
		Form.ShowAlert("안내", "1개 이상 선택하세요")	'20200331 HWG : 고유MTS
		chkTile.checkstate =  1
	end if 
End Sub

