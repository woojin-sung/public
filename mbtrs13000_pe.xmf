'============================================================================
' 화 면 명 : 주식주문_예수금팝업
' 화면설명 : 주식주문에서 상단연결팝업에서 예수금 선택시 오픈
' 작    성 : 2016.02.12 ~ 2016.  .       ssang
' [Modify] ==================================================================
' 2020.08.20 : 정민영 : v0001 : [T2007130018] 레버리지ETF/ETN 기본예탁금관련(OutBlock6) obacb_balc_024rTR 재매핑
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	Dim tData

	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)
		
		'20220524 SWJ START : 기존 obtrc_rmnd_001r에서 003r 서비스로 변경
		'계좌 없을 땐 조회하지 않도록
		if g_szAcnt <> "" then
			DATAMANAGER.RequestTranData("obtrc_rmnd_003r")
			DATAMANAGER.RequestTranData("obtrc_marg_006r")
		end if
		'20220524 SWJ END
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 예수금 조회
	' ----------------------------------------------------------------------	
	if szTranID = "obtrc_rmnd_003r" then	 
		DATAMANAGER.ClearInputData(0, "obtrc_rmnd_003r")
		
		DATAMANAGER.SetDataValue(0, "obtrc_rmnd_003r", "InBlock1", "ACNO", 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtrc_rmnd_003r", "InBlock1", "ASNO", 0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obtrc_rmnd_003r", "InBlock1", "STND_DATE", 0 , Form.GetSharedData("&HOST_DATE", false ))
		DATAMANAGER.SetDataValue(0, "obtrc_rmnd_003r", "InBlock1", "IQRY_CLS_CODE", 0 , "2")
	
	elseif szTranID = "obtrc_marg_006r" then	 
		'20211021 아이티젠(김성수) 대용 추가 START
		DATAMANAGER.SetDataValue(0, "obtrc_marg_006r", "InBlock1", "ACNO", 0 , g_szAcnt )
		DATAMANAGER.SetDataValue(0, "obtrc_marg_006r", "InBlock1", "ASNO", 0 , g_szAcntCd )
		'20211021 아이티젠(김성수) 대용 추가 END
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtrc_rmnd_003r" then
		
		'위험도 계산
		Dim nAcntRate, nRiskRate, nData, nReturnValue '계좌증거금율, 위험도, 반환값
		nData = CDbl(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "ACNT_MGRT", 0 ))
		
		if nData == 0 or nData == "" then
			nReturnValue = 0
		else
			'20220623 SWJ START : 그냥 2자리 절사 처리로 변경
			nAcntRate = Fix(Cdbl(tbl1.GetCellString(2, 3)) * 100) * 0.01	 	'소수 둘째자리까지 재가공
			nRiskRate = 100 - nAcntRate  									'(1-계좌증거금율) * 100
			'20220623 SWJ END
			
'			Form.ShowAlert(nAcntRate, nRiskRate)
			if nRiskRate < 0 then
				nReturnValue = 0
			elseif nRiskRate >= 100 then
				nReturnValue = 100
			else
				nReturnValue = nRiskRate
			end if
		end if
		
		Label0.caption = nReturnValue
		
		if nReturnValue > 40 then
			Label0.fgcolor = "10"
		else
			Label0.fgcolor = "4"
		end if
	
	'20220524 SWJ START : 마진콜 여유금액 추가
	ElseIf szTranID == "obtrc_marg_006r" then
		'마진콜여유금액 
		Dim nAcntVltnAmt, nMntnMarg, nAmt '계좌평가금액, 유지증거금
		nAcntVltnAmt = Cdbl(tbl0.GetCellString(2, 1))
		nMntnMarg = Cdbl(tbl2.GetCellString(2, 1))
		
		nAmt = nAcntVltnAmt - nMntnMarg	'마진콜여유금액
		
		If nAmt < 0 Then
			nAmt = 0
		End If
		tbl2.SetCellString(2, 2, nAmt)
	'20220524 SWJ END
	end if
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
'	if Trim(szSubMsg) <> "" then
'		Form.Toast(1, szErrMsg & "(" & szSubMsg & ")", true)	
'	else
'		Form.Toast(1, szErrMsg, true)
'	end if
End Sub

'============================================================================
' imgClose_OnClick : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnClose_OnClick : 닫기
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================


