'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sUserID
Dim g_sBioCertYn
Dim g_sSecCardCertYn
Dim g_sBioTrData
Dim g_szCertUserType
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	'EditInput1.certname = "보안카드 "&Label0.caption&Label1.caption
	'EditInput2.certname = "보안카드 "&Label3.caption&Label4.caption

	g_sBioCertYn = "N"
	g_sSecCardCertYn = "N"
	g_sRetData = "cancel"
	g_sUserID = Form.GetSharedData("CERT_ID" , false)
	if g_sUserID == null or g_sUserID == "" then
		g_sUserID = Form.GetSharedData("&USER_ID" , false)
	end if

	g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
	
	if g_szCertUserType = "4" then
		Label5.caption = "공동인증을 수행합니다."
	elseif g_szCertUserType = "3" then
		Label5.caption = "바이오인증을 수행합니다."
	elseif g_szCertUserType = "5" then
		Label5.caption = ""
	end if
	
	'Form.SetScreenName( "보안매체 인증" )

	'if g_sUserID ~= null and g_sUserID ~= "" then
	'	DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
	'end if
	
	g_sBioTrData = ""
	g_sBioTrData = Form.GetSharedData("BIO_TR_MSG_1", false )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
End Sub

'============================================================================
Sub BioCertCall()
	sBIO_TR_CODE = "1"                                       '바이오거래유형코드 0: 인증 1: 서명 
	sATHN_USAG_CLS_CODE = "0"								' 서명데이터 생성여부
	
    sTRAN_CNTT = g_sBioTrData
    
    if g_szCertUserType = "4" then
	    sData = "BCHAIN_trType★"& sBIO_TR_CODE  &"★"&  sTRAN_CNTT &"★"& sATHN_USAG_CLS_CODE 
    elseif g_szCertUserType = "5" then
	    sData = "ATON_trType★"&  sTRAN_CNTT
    else
	    sData = "BIO_trType★"& sBIO_TR_CODE  &"★"&  sTRAN_CNTT &"★"& sATHN_USAG_CLS_CODE 
    end if


	'Form.OpenPopup("mhetc90060_p5", sData, "")
	'MsgBox sData
	Form.OpenFramePopup("mhetc90060_p5" , sData , "")
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	Call BioCertCall()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "이체확인" then
		ButtonOK_OnClick()  
	end if   
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szErrMsg ~= "" or szErrMsg ~= Null then
		szErrMsg = szErrMsg.."("..szSubErr..")"
	end if
	
	Form.ShowAlert( "알림", szErrMsg)
End Sub

'============================================================================
' Form_OnPopupReturn 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)	
	If sKeyName == "mhetc90060_p5" Then
		If sRet == "ok" Then
		'MsgBox( "바이오 succ return")
			g_sBioCertYn = "Y"
			if g_szCertUserType = "4" then
				Form.triggerEvent("#", "공동인증", "Success")
			else
				Form.triggerEvent("#", "바이오인증", "Success")
			end if
			
		ElseIf sRet == "cancel" Then
			g_sBioCertYn = "N"			
			'Form.ShowAlert("알림", "간편인증 실패.")
		End If
	End If
	
End Sub



