				<CONTAINER name="Container6" scroll_pos="0,0" ly_vert="0,2350,375,50,1" scroll_ly_vert="0,0" >
					<CONTROL_INFO>
						<LABEL name="Label4" fontstyle="01" caption="융자기간 및 만기연장 안내" click="1" ly_vert="10,0,315,50,1" />
