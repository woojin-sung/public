'============================================================================
Sub Form_OnFormInitBefore()
	imgClose.setMaintainingRatio("1")
	contScroll.Container0.Image0.setMaintainingRatio("1")
	contScroll.Container2.Image2.setMaintainingRatio("1")
	contScroll.Container4.Image4.setMaintainingRatio("1")
	contScroll.Container6.Image0.setMaintainingRatio("1")
	contScroll.Container8.Image6.setMaintainingRatio("1")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "oblon_basc_501r" then
		'서비스에서 MTS는 당일자 넣어줌.
		DATAMANAGER.SetDataValue(0, "oblon_basc_501r", "InBlock1", "STND_DATE", "")
	elseif szTranID == "oblon_basc_503r" then
		DATAMANAGER.SetDataValue(0, "oblon_basc_503r", "InBlock1", "STND_DATE", "")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "oblon_basc_501r" then
		tmpDate  = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock2", "APLY_STA_DATE", 0)
		tmpRate1 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock2", "UI_APLY_MNRT1", 0) 'platinum
		tmpRate2 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock2", "UI_APLY_MNRT2", 0) 'premium
		tmpRate3 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock2", "UI_APLY_MNRT3", 0) 'gold
		tmpRate4 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock2", "UI_APLY_MNRT4", 0) 'silver
		
		tmpBsrt1 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock2", "UI_BSRT1", 0) 'platinum
		tmpBsrt2 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock2", "UI_BSRT2", 0) 'premium
		tmpBsrt3 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock2", "UI_BSRT3", 0) 'gold
		tmpBsrt4 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock2", "UI_BSRT4", 0) 'silver
		
		tmpSprd1 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock2", "UI_SPRD1", 0) 'platinum
		tmpSprd2 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock2", "UI_SPRD2", 0) 'premium
		tmpSprd3 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock2", "UI_SPRD3", 0) 'gold
		tmpSprd4 = DATAMANAGER.GetDataValue(0, "oblon_basc_501r", "OutBlock2", "UI_SPRD4", 0) 'silver

		szAplyRate1 = "연 "..FormatNumber(tmpRate1,2).."%"
		szAplyRate2 = "연 "..FormatNumber(tmpRate2,2).."%"
		szAplyRate3 = "연 "..FormatNumber(tmpRate3,2).."%"
		szAplyRate4 = "연 "..FormatNumber(tmpRate4,2).."%"
		
		szBsrt1 = "연 "..FormatNumber(tmpBsrt1,2).."%"
		szBsrt2 = "연 "..FormatNumber(tmpBsrt2,2).."%"
		szBsrt3 = "연 "..FormatNumber(tmpBsrt3,2).."%"
		szBsrt4 = "연 "..FormatNumber(tmpBsrt4,2).."%"
		
		szSprd1 = "연 "..FormatNumber(tmpSprd1,2).."%"
		szSprd2 = "연 "..FormatNumber(tmpSprd2,2).."%"
		szSprd3 = "연 "..FormatNumber(tmpSprd3,2).."%"
		szSprd4 = "연 "..FormatNumber(tmpSprd4,2).."%"
		
		contScroll.Container5.Table6.SetCellString(1, 1, szAplyRate1)
		contScroll.Container5.Table6.SetCellString(1, 2, szAplyRate2)
		contScroll.Container5.Table6.SetCellString(1, 3, szAplyRate3)
		contScroll.Container5.Table6.SetCellString(1, 4, szAplyRate4)
		
		contScroll.Container5.Table6.SetCellString(2, 1, szBsrt1)
		contScroll.Container5.Table6.SetCellString(2, 2, szBsrt2)
		contScroll.Container5.Table6.SetCellString(2, 3, szBsrt3)
		contScroll.Container5.Table6.SetCellString(2, 4, szBsrt4)
		
		contScroll.Container5.Table6.SetCellString(3, 1, szSprd1)
		contScroll.Container5.Table6.SetCellString(3, 2, szSprd2)
		contScroll.Container5.Table6.SetCellString(3, 3, szSprd3)
		contScroll.Container5.Table6.SetCellString(3, 4, szSprd4)
		
		contScroll.Container5.Table6.SetCellString(1, 5, tmpDate)
		
		contScroll.Container5.Table8.SetCellString(1, 1, szAplyRate4)
		contScroll.Container5.Table8.SetCellString(2, 1, szBsrt4)
		contScroll.Container5.Table8.SetCellString(3, 1, szSprd4)
		
		contScroll.Container5.Table8.SetCellString(1, 2, tmpDate)
		
		contScroll.Container5.Label23.caption = "· 시행일 신규 증권담보융자(만기연장)분부터 적용\n"..
										   "· 이자율은 기준금리+가산금리로 구성되며, 수시로 변경될 수 있습니다\n"..
										   "   - 기준금리 : 전전월 1개월 평균 CD수익률\n"..
										   "   - 가산금리 : 리스크 프리미엄, 신용 및 유동성 프리미엄, 제반 비용, 목표 이익률 등을 반영\n"
	elseif szTranID == "oblon_basc_503r" then
		tmpDate  = DATAMANAGER.GetDataValue(0, "oblon_basc_503r", "OutBlock4", "APLY_STA_DATE", 0)
		tmpRate1 = DATAMANAGER.GetDataValue(0, "oblon_basc_503r", "OutBlock4", "UI_APLY_MNRT1", 0) 
		tmpBsrt1 = DATAMANAGER.GetDataValue(0, "oblon_basc_503r", "OutBlock4", "UI_BSRT1", 0) 
		tmpSprd1 = DATAMANAGER.GetDataValue(0, "oblon_basc_503r", "OutBlock4", "UI_SPRD1", 0) 
		
		szAplyRate1 = "연 "..FormatNumber(tmpRate1,2).."%"
		szBsrt1 = "연 "..FormatNumber(tmpBsrt1,2).."%"
		szSprd1 = "연 "..FormatNumber(tmpSprd1,2).."%"
		
		contScroll.Container5.Table9.SetCellString(1, 1, szAplyRate1)
		contScroll.Container5.Table9.SetCellString(2, 1, szBsrt1)
		contScroll.Container5.Table9.SetCellString(3, 1, szSprd1)
		
		contScroll.Container5.Table9.SetCellString(1, 2, tmpDate)
		
	end if
End Sub

