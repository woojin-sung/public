				</CONTAINER>
				<CONTAINER name="Container8" scroll_pos="0,0" ly_vert="0,2595,375,50,1" scroll_ly_vert="0,0" >
					<CONTROL_INFO>
						<LABEL name="Label4" fontstyle="01" caption="유의사항" click="1" ly_vert="10,0,315,50,1" />
						<IMAGE name="Image6" autosize="1" imgpath="icon_arrow_down" ly_vert="335,18,15,12,1" />
						<LABEL name="Label14" bgcolor="026:186186186" transmode="0" ly_vert="10,0,355,1,1" />
					</CONTROL_INFO>
				</CONTAINER>
				<CONTAINER name="Container9" scroll_pos="0,0" ly_vert="1,2695,375,1135,1" scroll_ly_vert="0,0" >
					<CONTROL_INFO>
						<LABEL name="Label16" fontsize="-2" caption="· 증권담보융자약정은 주민등록번호 단위로 등록되나, 융자 실행은 해당 종합계좌에서 가능하오니, 해당 外 종합계좌에서 융자 실행하고자 하는 경우 융자가능계좌를 추가 등록하여야 합니다." valign="0" multiline="1" ly_vert="10,5,355,65,1" />
						<LABEL name="Label15" fontsize="-2" caption="· 수입인지대: 약정 총액 기준으로 5천만원 초과 시부터 인지대가 부과됩니다. (누적관리)" valign="0" multiline="1" ly_vert="10,70,355,40,1" />
						<LABEL name="Label17" fontsize="-2" caption="· 융자구분 : 증권담보융자는 주식, 해외주식, 채권, 집합투자증권, 주가연계증권(ELS), 주식매도자금, 집합투자증권/ELS환매자금을 담보로 하여 융자를 받는 것이며, 해외주식담보융자를 받기 위해서는 해외주식담보융자약정을 추가로 체결하셔야 합니다." valign="0" multiline="1" ly_vert="10,104,355,80,1" />
						<LABEL name="Label18" fontsize="-2" caption="· 해외주식담보융자 : 
   - 해외주식담보융자는 '증권담보융자 약정'과
      '해외주식거래신청'이 등록되어있어야 신청가능합니다.
   - 계좌에 해외주식 외 잔고가 존재(국내 주식 등)하는 경우
      약정이 불가합니다.
   - 해외주식담보융자 약정계좌는 해외주식거래만 가능하며,
      해외주식거래 외 거래(국내 주식매매, 원화RP거래 등)는
      불가합니다.
   - 해외주식담보융자 약정계좌는 해외주식 이외의 상품은
      입고가 제한될 수 있습니다.(국내주식, 국내채권 등의
      입고제한)
" valign="0" multiline="1" ly_vert="10,184,355,170,1" />
						<LABEL name="Label20" fontsize="-2" caption="[약관·이자율 등 변경 및 담보관련 통보]" click="1" ly_vert="10,364,315,20,1" />
						<LABEL name="Label19" fontsize="-2" caption="· 약관·이자율 등 변경통보 
   - SMS(또는 알림톡)로 변경내용을 요약 통보합니다." valign="0" multiline="1" ly_vert="10,384,355,40,1" />
						<LABEL name="Label113" fontsize="-2" caption="· 담보관련통보 
   - 담보부족, 반대매매, 만기예정 내역을 SMS(또는
     알림톡)로 통보합니다.
   - 추가담보요구(담보부족) 시 전화(핸드폰→원장통보지→
     통보지외전화 순) 및 SMS/이메일(이메일은 선택한
     경우에 한함)로 통보하며, 전화/SMS/이메일 모두
     통보불가(발송실패) 시 내용증명으로 통보합니다.
" valign="0" multiline="1" ly_vert="10,418,355,110,1" />
						<IMAGE name="Image0" imgpath="img_bgbox.9.png" ly_vert="10,540,355,590,1" />
						<LABEL name="Label110" fontsize="-2" caption="· 메리츠증권은 신용/증권담보융자에 관하여 충분히 설명할 의무가 있으며, 투자자는 투자에 앞서 그러한 설명을 충분히 들으시기 바랍니다." valign="0" multiline="1" ly_vert="10,555,355,50,1" />
						<LABEL name="Label114" fontsize="-2" caption="· 신용/증권담보융자 서비스 이용 전 반드시 약관 및 설명서 등을 확인하시기 바랍니다." valign="0" multiline="1" ly_vert="10,604,355,35,1" />
						<LABEL name="Label115" fontsize="-2" caption="· 상환능력에 비해 대출금이 과도할 경우 개인신용평점이 하락 할 수 있으며, 이로 인해 금융거래와 관련된 불이익이 발생할 수 있습니다." valign="0" multiline="1" ly_vert="10,640,355,50,1" />
						<LABEL name="Label116" fontsize="-2" caption="· 신용/증권담보융자 이용 시 당사가 정한 적정 담보유지비율을 유지하셔야 하며, 적정 담보유지비율에 미달하실 경우 기한 내 자체 처분하시거나 추가담보를 제공하지 않으면 약관에서 정한 방법에 따라 해당
담보증권이 임의 처분될 수 있습니다.
" valign="0" multiline="1" ly_vert="10,690,355,80,1" />
						<LABEL name="Label111" fontsize="-2" caption="· 이자율 
   - 당사의 이자율은 기준금리와 가산금리 합산이며,
      약관에서 정하는 바에 따라 수시로 변경될 수 있으므로
      당사 홈페이지에서 확인하시기 바랍니다.
      (홈페이지(www.imeritz.com) ＞ 고객지원 ＞
      서비스안내 ＞ 신용/대출안내 ＞ 신용거래융자/대주 or
      증권담보융자) 
   - 연체이자율 
      (신용거래융자/대주) 연 '기간별 최고금리 이자율+3%p' 
      (증권담보융자) 연 '약정이자율+3%p' 
   - 융자이자는 정기이자의 경우 매월 첫 영업일에 후취하며,
      중도상환의 경우 상환 시 징수합니다. (단, 매도(환매)
      자금담보융자는 정기이자 및 중도상환 없음)
" valign="0" multiline="1" ly_vert="10,770,355,205,1" />
						<LABEL name="Label112" fontsize="-2" caption="· 원리금상환방법
   - 상환기일 전이라도 전부 또는 일부 현금/매도상환/매수상환/현물상환 가능 (매매에 의한 상환시에는 당해 매매거래의 결제일에 상환됨) 
   - 매도상환: 매도결제일까지의 이자 + 대출금 상환 
   - 현금상환: 상환요청일까지의 이자 + 대출금 상환 
   - 매수상환: 매수결제일까지의 이자 + 대주매도한 종목을
      다시 매수하여 상환 
   - 현물상환: 상환요청일까지의 이자 + 대주거래한 동일
      종목으로 상환" valign="0" multiline="1" ly_vert="10,970,355,160,1" />
					</CONTROL_INFO>
				</CONTAINER>
			</CONTROL_INFO>
		</CONTAINER>
		<IMAGE name="imgClose" imgpath="icon_close" ly_vert="343,11,20,20,1" />
		<LABEL name="lblPopupTitle" fontsize="3" fontstyle="01" caption="담보대출약정 안내" halign="1" ly_vert="0,0,375,45,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="9487" _ulen="9097" >
Dim g_szDeviceOS
Dim g_nOpenIndex
g_nOpenIndex = -1
'============================================================================
Sub contScroll_Container1_btnCheck_OnClick()
	Form.OpenPopupAnimation( "mbonl82010_p8", "", "", "2")
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
Sub Form_OnFormInit()
	g_szDeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	f_ContainerSetting(1)
	
	DATAMANAGER.RequestTranData("oblon_basc_501r")
	DATAMANAGER.RequestTranData("oblon_basc_503r")
End Sub

'============================================================================
Sub contScroll_Container0_Image0_OnClick()
	f_ContainerSetting(1)
End Sub

'============================================================================
Sub contScroll_Container2_Image2_OnClick()
	f_ContainerSetting(3)
End Sub

'============================================================================
Sub contScroll_Container4_Image4_OnClick()
	f_ContainerSetting(5)
End Sub

'============================================================================
Sub contScroll_Container6_Image6_OnClick()
	f_ContainerSetting(7)
End Sub

'============================================================================
Sub contScroll_Container8_Image6_OnClick()
	f_ContainerSetting(9)
End Sub


Function f_ContainerSetting(nIndex)	
	if g_nOpenIndex ~= CInt(nIndex) then
		'다 닫아주고 이번에 들어온거만 열어주고
		g_nOpenIndex = nIndex
	else
		'이번에 들어온거만 닫아주고		
		g_nOpenIndex = -1
	end if
	
	Dim tHeight
	Dim nTop
	
	'tHeight = { "51","1075", "51","675", "51","360","51","185","51","1132" }
	'tHeight = { "51","1071", "51","676", "51","361","51","186","51","1135" }
	tHeight = { "51","1071", "51","676", "51","421","51","186","51","1135" }
	nTop = 10		
	
	for i = 0 to 9
		if g_nOpenIndex == i then			
			Form.SetCtlProp("contScroll.Container"..i, "top", nTop)
			Form.SetCtlProp("contScroll.Container"..i, "height", tHeight[i])
			Form.SetCtlProp("contScroll.Container"..i, "visible", "1")	
			nTop = nTop + tHeight[i]
			'LHR 수정
			if g_szDeviceOS == "2" then
				contScroll.scroll_pos_noAni = Cint(Form.calcUnResize( Form.GetCtlProp("contScroll.Container"..i-1, "top") ))
			else
				contScroll.scroll_pos = Cint(Form.calcUnResize( Form.GetCtlProp("contScroll.Container"..i-1, "top") ))
			end if
		else
			if i % 2 == 0 then
				'타이틀 영역은 늘 보이는 영역
				Form.SetCtlProp("contScroll.Container"..i, "top", nTop)
				Form.SetCtlProp("contScroll.Container"..i, "height", tHeight[i])
				Form.SetCtlProp("contScroll.Container"..i..".Image"..i, "imgpath", "icon_arrow_down")
				nTop = nTop + 51
			else
				'펼쳐지지 않은 컨텐츠는 다 안보임
				Form.SetCtlProp("contScroll.Container"..i, "top",0)
				Form.SetCtlProp("contScroll.Container"..i, "height", 0)
				Form.SetCtlProp("contScroll.Container"..i, "visible", "0")	
			end if 			
		end if 		
	next
	
	
	'열림이미지처리
	if g_nOpenIndex > 0 then
		Form.SetCtlProp("contScroll.Container"..g_nOpenIndex, "visible", "1")
		Form.SetCtlProp("contScroll.Container"..(g_nOpenIndex-1)..".Image"..(g_nOpenIndex-1), "imgpath", "icon_arrow_up")
	end if 
	
	contScroll.SetScrollAutoSize()
	
End Function 

