'============================================================================
' 01. 화 면 명 : CFD 계좌 상태 조회
' 02. 화면설명 : CFD 계좌 상태 조회
' 03. 작    성 : 2021. 08. 20. KSJ
'============================================================================
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	f_Clear() 
	DATAMANAGER.RequestTranData( "obtrc_comm_004r" )
End Sub

'============================================================================
' Form_OnRefresh()
'============================================================================
Sub Form_OnRefresh()
	f_Clear() 
	DATAMANAGER.RequestTranData( "obtrc_comm_004r" )
End Sub

'============================================================================
' Container0_acnt0_ChangeAccount()
'============================================================================
Sub Container0_acnt0_ChangeAccount()
	f_Clear() 
	DATAMANAGER.RequestTranData( "obtrc_comm_004r" )
End Sub

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Clear
'============================================================================
Function f_Clear()    
	Container0.lblInfoA0.caption = ""
	Container0.lblInfoA1.caption = ""
	Container0.lblInfoA2.caption = ""
	Container0.lblInfoA3.caption = ""
	Container0.lblInfoA3a.caption = ""
	Container0.lblInfoA3b.caption = ""
	Container0.lblInfoA4.caption = ""
	Container0.lblInfoA5.caption = ""
	Container0.lblInfoA6.caption = ""
	Container0.lblInfoA7.caption = ""
	Container0.lblInfoA8.caption = ""
	Container0.lblInfoA9.caption = ""
	Container0.lblInfoA10.caption = ""
	Container0.lblInfoA11.caption = ""
	Container0.lblInfoA12.caption = ""  '(v001) 대용수수료율
End Function

'****************************************************************************
'				     	D A T A M A N A G E R
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore()
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)   
	If szTranID == "obtrc_comm_004r" or szTranID == "obtrc_comm_016r" Then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , Container0.acnt0.total)'Left(cmb0.caption , 8))		'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , Container0.acnt0.sequence)'Right(cmb0.caption , 2))	'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" , 0 , "")'비밀번호
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete()
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obtrc_comm_004r" Then
		Dim szCFD_DEAL_ABLE_YN_CODE
		szCFD_DEAL_ABLE_YN_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CFD_DEAL_ABLE_YN_CODE", 0)
		'20230308 HSZ START: 안심계좌는 CFD 이자율 숨김처리
		szAcntCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CFD_MARG_GRAD_CODE", 0)
		if szAcntCode = "B" then	'안심계좌
			Container0.lblInfo4.visible = false
			Container0.lblInfoA4.visible = false
			Container0.lblInfo6.visible = false
			Container0.lblInfoA3.visible = false
			Container0.lblInfo7.visible = false
			Container0.lblInfoA6.visible = false
			Container0.lblInfo8.visible = false
			Container0.lblInfoA7.visible = false
			Container0.lblInfo9.visible = false
			Container0.lblInfoA8.visible = false
			Container0.lblInfo10.visible = false '유지증거금률 숨김
			Container0.lblInfoA9.visible = false '유지증거금률 숨김
			Container0.lblInfo11.visible = false
			Container0.lblInfoA10.visible = false
			
			Container0.lblInfo5.visible = true    '(v001) 증거금유형
			Container0.lblInfoA5.visible = true   '(v001) 증거금유형
			Container0.lblInfo15.visible = false  '(v001) 대용수수료율
			Container0.lblInfoA12.visible = false '(v001) 대용수수료율
			
			Container0.lblLine0.top = 255
			Container0.lblInfo5.top = 425- 38
			Container0.lblInfoA5.top = 425 - 38
		else
			Container0.lblInfo4.visible = true
			Container0.lblInfoA4.visible = true
			Container0.lblInfo6.visible = true
			Container0.lblInfoA3.visible = true
			Container0.lblInfo7.visible = true
			Container0.lblInfoA6.visible = true
			Container0.lblInfo8.visible = true
			Container0.lblInfoA7.visible = true
			Container0.lblInfo9.visible = true
			Container0.lblInfoA8.visible = true
			Container0.lblInfo10.visible = true '유지증거금률
			Container0.lblInfoA9.visible = true '유지증거금률
			Container0.lblInfo11.visible = true
			Container0.lblInfoA10.visible = true
			
			Container0.lblInfo5.visible = false  '(v001) 증거금유형
			Container0.lblInfoA5.visible = false '(v001) 증거금유형
			Container0.lblInfo15.visible = true  '(v001) 대용수수료율
			Container0.lblInfoA12.visible = true '(v001) 대용수수료율
			
			Container0.lblLine0.top = 293
			Container0.lblInfo5.top = 425
			Container0.lblInfoA5.top = 425
		end if
		'20230308 HSZ END
		Container0.lblInfoA0.caption = Form.GetMetaData("CFD매매가능여부코드", szCFD_DEAL_ABLE_YN_CODE)
		
		DATAMANAGER.RequestTranData( "obtrc_comm_016r" )
	End If
End Sub

