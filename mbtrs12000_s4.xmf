				<CELL cell_ly="5,0,5,0" fgcolor="006:199056017" halign="2" line="1,0" fontsize="-2" mask="0,1,,,0,,0,1,1" plusminuscolor="1" autofontsize="1" impidxs="" />
			</CELL_INFO>
		</TABLE>
		<IMAGE name="imgLDown2" autosize="1" imgpath="icon_util_01" ly_horz="104,279,8,8,1" />
