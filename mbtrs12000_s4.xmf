'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주식주문(가로)_호가 -> mhprc11000_h1 참조
' 02. 화면설명 : 주식주문(가로) 호가화면 
' 03. 작    성 : 2016.02.18 ssang
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket, g_szItemName
Dim g_szDiplayrest							'호가직전수량표시

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
'============================================================================
Function RequestData()
	If Trim(g_szItemCode) = "" Then
		Form.ShowAlert("알림", "재조회하시기 바랍니다.")
		Exit Function
	End If

	DATAMANAGER.CancelRealData( "ohhts_elw_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_elw_aspr" )
	DATAMANAGER.CancelRealData( "ohhts_stck_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_stck_aspr" )
	DATAMANAGER.CancelRealData( "ohhts_stck_mbcr" )
	DATAMANAGER.CancelRealData( "ohhts_frbr_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_frbr_aspr" )

	DATAMANAGER.RequestTranData( "ohhts_1001_001r" )
	DATAMANAGER.RequestTranData( "ohhts_1001_004r" )
	DATAMANAGER.RequestTranData( "ohhts_1001_005r" )
'	DATAMANAGER.RequestTranData( "ohhts_1001_011r" )

	'차트 조회-----------------------------------------------------------------------
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)

	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR" , 0,"D")  'D/W/M/Y 일/주/월/년 
	
	szToday = Form.GetSharedData("&HOST_DATE", 0 )
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DATE1" , 0,"szToday")
	DATAMANAGER.RequestTranData("ohhts_5010_001r")	
	'-------------------------------------------------------------------------------------
end Function


Function Set_HogaTable()
	Dim szDispdiff, szJangraph, szPriceoutline, szBoldHoga, szBoldJan, szBoldRest
	Dim szColWidth

	szDispdiff		= Form.LoadConfigData("mhprc11000", "Dispdiff"	)	'호가등락률
	szJangraph		= Form.LoadConfigData("mhprc11000", "Jangraph"	)	'호가잔량그래프
	g_szDiplayrest	= Form.LoadConfigData("mhprc11000", "Diplayrest"	)	'호가직전수량표시
	szPriceoutline	= Form.LoadConfigData("mhprc11000", "Priceoutline")	'현재가 외곽선 표시
	szBoldHoga		= Form.LoadConfigData("mhprc11000", "BoldHoga"	)	'텍스트굵기 호가
	szBoldJan		= Form.LoadConfigData("mhprc11000", "BoldJan"		)	'텍스트굵기 호가잔량
	szBoldRest		= Form.LoadConfigData("mhprc11000", "BoldRest"	)	'텍스트굵기 직전대비
	
	'설정된 값이 없을 경우 초기값 Insert 함.
	If szDispdiff = "" Then
		szDispdiff 		= "1"
		szJangraph 		= "1"
		g_szDiplayrest 	= "0"
		szPriceoutline 	= "1"
		szBoldHoga 		= "1"
		szBoldJan 		= "0"
		szBoldRest		= "0"
		
		Form.SaveConfigData("mhprc11000", "Dispdiff"		, szDispdiff		)	'호가등락률
		Form.SaveConfigData("mhprc11000", "Jangraph"		, szJangraph		)	'호가잔량그래프
		Form.SaveConfigData("mhprc11000", "Diplayrest"	, g_szDiplayrest	)	'호가직전수량표시
		Form.SaveConfigData("mhprc11000", "Priceoutline"	, szPriceoutline	)	'현재가 외곽선 표시
		Form.SaveConfigData("mhprc11000", "Style"		, "0"			)	'현재가 스타일
		Form.SaveConfigData("mhprc11000", "BoldHoga"		, szBoldHoga		)	'텍스트굵기 호가
		Form.SaveConfigData("mhprc11000", "BoldJan"		, szBoldJan		)	'텍스트굵기 호가잔량
		Form.SaveConfigData("mhprc11000", "BoldRest"		, szBoldRest		)	'텍스트굵기 직전대비
	End If
	

	If szDispdiff = "1" Then
		'호가직전수량표시
		If g_szDiplayrest = "1" Then
			szColWidth = "40,64,84,40,65,40"
		Else
			szColWidth = "0,104,84,40,105,0"
		End If
	
	ElseIf szDispdiff = "0" Then
		If g_szDiplayrest = "1" Then
			szColWidth = "40,64,124,0,65,40"
		Else
			szColWidth = "0,104,124,0,105,0"
		End If		
	End If	
	
'	Form.ShowAlert(g_szDiplayrest, szColWidth)	
	
	'호가등락률
	contHoga.hogaTbl.SetColumnWidth( szColWidth )
	
	'호가잔량그래프
	contHoga.hogaTbl.hojangraph = szJangraph
	
	'현재가 외곽선 표시
	contHoga.hogaTbl.priceoutline = szPriceoutline
	
	For i = 0 To 19
		'호가
		If szBoldHoga = "1" Then
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 2 , "01")
		Else 
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 2 , "00")
		End If
		
		'호가잔량
		If szBoldJan = "1" Then
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 3 , "01")
		Else 
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 3 , "00")
		End If
		
		'직전대비
		If szBoldRest = "1" Then
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 0 , "01")
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 5 , "01")
		Else 
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 0 , "00")
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 5 , "00")
		End If
		
	Next

End Function



'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	
	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	g_szItemName   = Form.GetItemCodeInfo( g_szItemCode , "name")

End Sub

'============================================================================
Sub Form_OnFormInit()
	tblTime.visible   = false				' 시간외
	tblMaeDoSu.visible = true
	contHoga.tblPrice2.visible = false		' 예상체결
	contHoga.tblPrice3.visible = false		' 변동성
	
	'환경설정 Load
	Set_HogaTable()
	
	RequestData()	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
'	if sKey = "ITEMCODE" then
'		g_szItemCode = sValue
'		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
'		g_szItemName   = Form.GetItemCodeInfo( g_szItemCode , "name")
'		
'		RequestData()
		
'	end	if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		g_szItemName   = Form.GetItemCodeInfo( g_szItemCode , "name")
		
		RequestData()
		
	ElseIf sEventName = "HOGA_SETUP" Then
		Set_HogaTable()

	end if
	 
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
    If szTranID = "ohhts_1001_001r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)

    ElseIf szTranID = "ohhts_1001_002r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_002r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)

	Elseif szTranID = "ohhts_1001_004r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_004r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
	    
	Elseif szTranID = "ohhts_1001_005r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_005r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
	    
	Elseif szTranID = "ohhts_1001_011r" then
	    DATAMANAGER.SetDataValue( 0, "ohhts_1001_011r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
	    DATAMANAGER.SetDataValue( 0, "ohhts_1001_011r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
	    
'	    Call TRANMANAGER.SetFIDBlockDefaultArraySize( "ohhts_1001_011r", "OutBlock1", Mct_1.GetMaxMAValue( 30, 30 ) )

	Elseif szTranID = "ohhts_3800_004r" then
	    DATAMANAGER.SetDataValue( 0, "ohhts_3800_004r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)

	Elseif szTranID = "ohhts_1126_001r" then
		Dim szOrdCode
	
	    DATAMANAGER.CancelRealData("ohhts_stck_stat")
	    
	    If Left(g_szItemCode, 1) = "J" or Left(g_szItemCode, 1) = "F" Then
		    szOrdCode = g_szItemCode		    
	    ElseIf g_szItemMarket = "J" or g_szItemMarket= "T" Then	'주식	    
		    szOrdCode = "A" + g_szItemCode		    
		ElseIf g_szItemMarket = "W" Then	'ELW
		    szOrdCode = "J" + g_szItemCode		    
		Else
		    szOrdCode = g_szItemCode		    
		End If
	    
	    DATAMANAGER.SetDataValue( 0, "ohhts_1126_001r", "InBlock1", "FID_SHRN_ISCD", 0 , szOrdCode )
	    
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	Dim szCode
	
	szCode = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_SHRN_ISCD" , 0 )
	
	If szTranID = "ohhts_stck_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_stck_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_stck_mbcr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_mbcr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	ElseIf szTranID = "ohhts_stck_stat" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_stat", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	ElseIf szTranID = "ohhts_elw_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_elw_aspr" , "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_elw_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg" , "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_frbr_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_frbr_aspr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_frbr_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_smns_rate" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_smns_rate", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	
	If szTranID = "ohhts_1001_001r" Then
		'호가컨트롤 속성		
		contHoga.hogaTbl.startprice = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_OPRC" , 0 )
		contHoga.hogaTbl.highprice	 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_HPRC" , 0 )
		contHoga.hogaTbl.lowprice	 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_LPRC" , 0 )
		
'		g_szItemName = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_KOR_ISNM" , 0)
	
	ElseIf szTranID = "ohhts_1001_004r" Then
		
		For i = 0 To contHoga.grdCNTG.rowcount - 1
			Dim nData
			nData = CDbl( contHoga.grdCNTG.GetCellData( "bd_cell2", i ) )
			
			If nData > 0 Then
				contHoga.grdCNTG.SetCellFgColor( "bd_cell0", i, "10")
			ElseIf nData < 0 Then
				contHoga.grdCNTG.SetCellFgColor( "bd_cell0", i, "11")
			Else
				contHoga.grdCNTG.SetCellFgColor( "bd_cell0", i, "12")
			End If
		
		Next
	
	ElseIf szTranID = "ohhts_1001_005r" Then
		Dim nTOTAL_BIDP_RSQN		' 총매수잔량
		Dim nTOTAL_ASKP_RSQN		' 총매도잔량
		
		nTOTAL_BIDP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_TOTAL_BIDP_RSQN" , 0 )
		nTOTAL_ASKP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_TOTAL_ASKP_RSQN" , 0 )
		
		tblMaeDoSu.SetCellString( 0,  2, nTOTAL_BIDP_RSQN - nTOTAL_ASKP_RSQN )
	
		'예상체결 Visible 여부
	    if Left( DATAMANAGER.GetDataValue( false, "ohhts_1001_005r", "OutBlock1", "FID_NW_MKOP_CLS_CODE", 0 ),1) = "0" OR 
	             DATAMANAGER.GetDataValue( false, "ohhts_1001_005r", "OutBlock1", "FID_NW_MKOP_CLS_CODE", 0 )    = "49" then
		    	contHoga.tblPrice1.visible = false
			contHoga.tblPrice2.visible = true
	    end if
		
		If g_szItemMarket = "W" Then
			DATAMANAGER.RequestRealData( "ohhts_elw_aspr" )
			DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
		Else
			DATAMANAGER.RequestRealData( "ohhts_stck_aspr" )
			DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		End If
		
		
		DATAMANAGER.RequestTranData( "ohhts_1126_001r" )
		
	ElseIf szTranID = "ohhts_1126_001r" Then
		Dim szAplyCode, szKindCode
		
		szAplyCode = DATAMANAGER.GetDataValue( false , "ohhts_1126_001r", "OutBlock1", "FID_APLY_CLS_CODE" , 0 )'1:발동 , 2:해제 
		
	    If szAplyCode = "1" Then 	
		    contHoga.tblPrice1.Visible = false
		    contHoga.tblPrice2.Visible = false
		    contHoga.tblPrice3.Visible = True 

		    szKindCode = DATAMANAGER.GetDataValue( false, "ohhts_1126_001r", "OutBlock1", "FID_KIND_CODE" , 0 ) '1:정적VI 2:동적VI 3:정적+동적VI
		    
		    if szKindCode = "1" Then 
			    contHoga.tblPrice3.SetCellString( 11, 1, "정적" )
			    
		    elseif szKindCode = "2" Then 
			    contHoga.tblPrice3.SetCellString( 11, 1, "동적" )
			    
		    elseif szKindCode = "3" Then
			    contHoga.tblPrice3.SetCellString( 11, 1, "정+동적" )
			    
		    End if 
	    End if 
	   
		DATAMANAGER.RequestRealData( "ohhts_stck_stat" )		

	End If
	
	'10호가창 중간위치
	contHoga.scroll_pos = "vcenter"
	
End Sub


'============================================================================
Sub tblTime_OnClick(lRow , lColumn)
	If lColumn = 1 And lRow  = 0 then
		tblTime.visible = false
		tblMaeDoSu.visible = true
	End If
End Sub


'============================================================================
Sub tblMaeDoSu_OnClick(lRow , lColumn)
	If lColumn = 2 And lRow  = 0 then
		tblTime.visible = true
		tblMaeDoSu.visible = false
	End If
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName = "mhprc11000_p4" then	
		contHoga.scroll_pos = "vcenter"		'10호가창 중간위치
	End If	
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	If szTranID = "ohhts_stck_aspr" Or szTranID = "ohhts_elw_aspr" Then
		Dim nTOTAL_BIDP_RSQN		' 총매수잔량
		Dim nTOTAL_ASKP_RSQN		' 총매도잔량				
		
		nTOTAL_BIDP_RSQN 		= DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_BIDP_RSQN" 		, 0 )
		nTOTAL_ASKP_RSQN 		= DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_ASKP_RSQN" 		, 0 )		
				
		tblMaeDoSu.SetCellString( 0, 2, nTOTAL_BIDP_RSQN - nTOTAL_ASKP_RSQN )
		
		'환경설정에서 직전비수량 표시시
		If g_szDiplayrest = "1" Then
			Dim nTOTAL_BIDP_RSQN_ICDC	' 총매수잔량증감
			Dim nTOTAL_ASKP_RSQN_ICDC	' 총매도잔량증감
		
			nTOTAL_BIDP_RSQN_ICDC 	= DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_BIDP_RSQN_ICDC"	, 0 )
			nTOTAL_ASKP_RSQN_ICDC 	= DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_ASKP_RSQN_ICDC" , 0 )
			
			tblMaeDoSu.SetCellString( 0, 0, nTOTAL_ASKP_RSQN_ICDC )
			tblMaeDoSu.SetCellString( 0, 5, nTOTAL_BIDP_RSQN_ICDC )
		Else
			tblMaeDoSu.SetCellString( 0, 0, "" )
			tblMaeDoSu.SetCellString( 0, 5, "" )
		End If
	End If
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	If szTranID = "ohhts_1001_001r" Then
		Dim nSDPR , nOPRC, nHPRC, nLPRC
		
		nSDPR = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_SDPR" , 0 ) )	'기준가
		nOPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_OPRC" , 0 ) )	'시가
		nHPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_HPRC" , 0 ) )	'고가
		nLPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_LPRC" , 0 ) )	'저가
		
		If nSDPR < nOPRC Then
			contHoga.tblPrice1.SetCellFgColor( 1, 1, "10" )
			contHoga.tblPrice2.SetCellFgColor( 1, 1, "10" )
			contHoga.tblPrice3.SetCellFgColor( 1, 1, "10" )
			
		ElseIf nSDPR > nOPRC Then
			contHoga.tblPrice1.SetCellFgColor( 1, 1, "11" )
			contHoga.tblPrice2.SetCellFgColor( 1, 1, "11" )
			contHoga.tblPrice3.SetCellFgColor( 1, 1, "11" )
		Else
			contHoga.tblPrice1.SetCellFgColor( 1, 1, "12" )
			contHoga.tblPrice2.SetCellFgColor( 1, 1, "12" )
			contHoga.tblPrice3.SetCellFgColor( 1, 1, "12" )
			
		End If
		
		If nSDPR < nHPRC Then
			contHoga.tblPrice1.SetCellFgColor( 2, 1, "10" )
			contHoga.tblPrice2.SetCellFgColor( 2, 1, "10" )
			contHoga.tblPrice3.SetCellFgColor( 2, 1, "10" )
			
		ElseIf nSDPR > nHPRC Then
			contHoga.tblPrice1.SetCellFgColor( 2, 1, "11" )
			contHoga.tblPrice2.SetCellFgColor( 2, 1, "11" )
			contHoga.tblPrice3.SetCellFgColor( 2, 1, "11" )
		Else
			contHoga.tblPrice1.SetCellFgColor( 2, 1, "12" )
			contHoga.tblPrice2.SetCellFgColor( 2, 1, "12" )
			contHoga.tblPrice3.SetCellFgColor( 2, 1, "12" )
		End If
		
		If nSDPR < nLPRC Then
			contHoga.tblPrice1.SetCellFgColor( 3, 1, "10" )
			contHoga.tblPrice2.SetCellFgColor( 3, 1, "10" )
			contHoga.tblPrice3.SetCellFgColor( 3, 1, "10" )
			
		ElseIf nSDPR > nLPRC Then
			contHoga.tblPrice1.SetCellFgColor( 3, 1, "11" )
			contHoga.tblPrice2.SetCellFgColor( 3, 1, "11" )
			contHoga.tblPrice3.SetCellFgColor( 3, 1, "11" )
		Else
			contHoga.tblPrice1.SetCellFgColor( 3, 1, "12" )
			contHoga.tblPrice2.SetCellFgColor( 3, 1, "12" )
			contHoga.tblPrice3.SetCellFgColor( 3, 1, "12" )
		End If	
	
	End If
End Sub


