<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="99999" scrname="My자산_롤링배너" version="2" writer="김인섭" />
	<FORM_INFO name="Form" ly_vert="0,0,375,120,1" />
	<CONTROL_INFO>
		<FORMTAB name="FormTab0" tabcount="4" tabheadheight="0" usepg="1" pgbarheight="10" ly_vert="10,11,355,109,1" >
			<PAGE name="page007308" caption="nrsmyastbanner1" linkfile="myast_banner1" loadingtype="1" />
			<PAGE name="page003239" caption="nrsmyastbanner2" linkfile="myast_banner2" loadingtype="1" />
			<PAGE name="page009388" caption="nrsmyastbanner3" linkfile="myast_banner3" loadingtype="1" />
			<PAGE name="page000121" caption="nrsmyastbanner4" linkfile="myast_banner4" loadingtype="1" />
		</FORMTAB>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="819" _ulen="811" >
Dim g_curTab
Dim g_nRandom

g_curTab = 0
'============================================================================
Sub Form_OnFormInit()
	'Label1.caption = "meritz Bond365"	
	'nLen = Form.getLen(Label1.caption)
	'Label1.changeTextAttr(0, nLen, 334, 2, true)
	'Label1.changeTextAttr(0, 6, 323, 2, true)
	'난수생성
	g_nRandom = math.random(1, 3)
	Form.triggerEvent("FormTab0."& FormTab0.currenttabpageid, "Forminit", g_nRandom)

	FormTab0.setAutoScroll(true, 4)
	FormTab0.SetPageBarPos("TR",10) 
	
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	if g_curTab <> nCurrentTab then
		Form.triggerEvent("FormTab0."& FormTab0.currenttabpageid, "TabChange", nCurrentTab.."|"..g_nRandom)
		g_curTab = nCurrentTab
	end if
End Sub

	</SCRIPT_INFO>
</ROOT>