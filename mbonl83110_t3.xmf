'============================================================================
' 01. 화 면 명 : ELS/DLS청약_취소탭
' 02. 화면설명 : ELS/DLS청약_취소탭
' 03. 작    성 : 2016. 03. 05. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szOSTest			'OS Type, 1:안드로이드, 2:IOS
Dim g_szOSType			'OS Type, 안드로이드 = 157, IOS = 156
Dim g_szPW				'비밀번호
Dim g_nRowIndex			'RowIndex
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
	g_szOSTest = Form.GetSharedData( "&OS_TYPE", false )
	
	if g_szOSTest == "1" then
		g_szOSType = 157			'안드로이드
	else
		g_szOSType = 156			'IOS
	end if
	
	DATAMANAGER.RequestTranData( "obibk_pssp_001r" )
	
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	Form_OnFormInit()
	
End Sub
'============================================================================
' edtPW_OnEditComplete()
'============================================================================

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obibk_pssp_001r" then
		DATAMANAGER.SetDataValue( 0 , "obibk_pssp_001r", "InBlock1", "SBSC_APLT_DATE" , 0 , cld1.caption)			'신청일자(당일날자)
		DATAMANAGER.SetDataValue( 0 , "obibk_pssp_001r", "InBlock1", "ACNO" , 0 , acnt0.total)					'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssp_001r", "InBlock1", "ASNO" , 0 , acnt0.sequence)	
		DATAMANAGER.SetDataValue( 0 , "obibk_pssp_001r", "InBlock1", "IQRY_FIN_DATE" , 0 , cld2.caption)			
		IF RadioGroup0.currentindex == "0" then
			DATAMANAGER.SetDataValue( 0 , "obibk_pssp_001r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1")
		elseif 	RadioGroup0.currentindex == "1" then
			DATAMANAGER.SetDataValue( 0 , "obibk_pssp_001r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2")
		elseif 	RadioGroup0.currentindex == "2" then
			DATAMANAGER.SetDataValue( 0 , "obibk_pssp_001r", "InBlock1", "IQRY_CLS_CODE" , 0 , "3")
		end if
		'DATAMANAGER.SetDataValue( 0 , "obibk_pssp_001r", "InBlock1", "IQRY_CLS_CODE" , 0 , RadioGroup0.GetRadioCaption('nIdx)
		'일련번호

	end if
	
End Sub
