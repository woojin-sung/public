'============================================================================
Sub cmb0_OnEditComplete(iIndex)
	g_ComboIndex = iIndex
	
	cld2.caption = Form.GetSharedData("&HOST_DATE", false)
	'showalert(GetSharedData("&HOST_DATE", false), GetSharedData("&HOST_DATE", false))
	'ComboIndex에 따라 조회 기간 설정
	Select Case g_ComboIndex
		Case 0
			cld1.caption = Left(Form.calcDateTime( nYear, nMonth, nDay, nHour, nMinute, nSecond ), 8)
		Case 1
			cld1.caption = Left(Form.calcDateTime( nYear, nMonth, -7, nHour, nMinute, nSecond ), 8)
		Case 2
			cld1.caption = Left(Form.calcDateTime( nYear, -1, nDay, nHour, nMinute, nSecond ), 8)
		Case 3
			cld1.caption = Left(Form.calcDateTime( nYear, -3, nDay, nHour, nMinute, nSecond ), 8)
	End Select

	
	DATAMANAGER.RequestTranData( "obibk_pssp_001r" )
End Sub

