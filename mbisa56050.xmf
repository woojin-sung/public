	<SCRIPT_INFO _len="9594" _ulen="8522" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 가입진행상태조회
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.18 김은숙
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_bIsCancel	'취소 후 재조회시 "온라인 가입신청 내역이 없습니다." 메세지 띄우지 않음
g_bIsCancel = False


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub RequestData()
	'Clear Data
	For i = 0 to 7
		cont0.tbl0.SetCellString( i, 1, "")
	Next
	
	cont0.btnCancel.enable = False
	cont0.btnOK.enable = False
	
	If acnt0.caption == "" then
		'Form.ShowAlert("알림", "계좌번호는 필수값입니다.")
		Exit Sub
	End If
	
	DATAMANAGER.RequestTranData("obwat_ctad_039r")	'온라인 신규계약 조회
End Sub

'============================================================================
'가입진행상태 OutBlock Array 중 제일 마지막(최신) 데이터를 가져와 뿌려줌
Sub GetJoinStatus()

	Dim sRowData(13)
	'sRowData(0)  : 신청일자
	'sRowData(1)  : 신청시각
	'sRowData(2)  : 신청번호
	'sRowData(3)  : 신청계좌
	'sRowData(4)  : 신청계좌일련번호
	'sRowData(5)  : 계약금액
	'sRowData(6)  : 가입자유형
	'sRowData(7)  : 계약번호
	'sRowData(8)  : CNRC_APLT_STAT_CLCD
	'sRowData(9)  : HPCL_LAST_CNFR_YN
	'sRowData(10) : PRCH_PROS_YN
	'sRowData(11) : HPCL_CNFR_EMPNO
	'sRowData(12) : PRCH_EMPNO
	'sRowData(13) : EXAM_RSLT_CLCD

	For i = 0 to 13
		sRowData(i) = cont0.grd0.GetCellData("bd_cell" & i, cont0.grd0.rowcount-1)
	Next
	
	cont0.tbl0.SetCellString( 0, 1, sRowData(0))	'신청일자
	cont0.tbl0.SetCellString( 1, 1, sRowData(1))	'신청시각
	cont0.tbl0.SetCellString( 2, 1, sRowData(2))	'신청번호
	cont0.tbl0.SetCellString( 4, 1, sRowData(5))	'계약금액
	cont0.tbl0.SetCellString( 7, 1, sRowData(7))	'계약번호
	
	'------------------------------------------
	'신청계좌
	'------------------------------------------
	If sRowData(3) <> "" and sRowData(4) <> "" then
		cont0.tbl0.SetCellString( 3, 1, sRowData(3) & sRowData(4) )
	End If
	
	'------------------------------------------
	'가입자유형
	'------------------------------------------
	Dim sTypeText

	Select Case sRowData(6)
		Case "66"
			sTypeText = "일반형"
		Case "67"
			sTypeText = "청년형"
		Case "73"
			sTypeText = "서민형"
	End Select
	
	cont0.tbl0.SetCellString( 5, 1, sTypeText )
	
	'------------------------------------------
	'진행상태	
	'------------------------------------------
	Dim sStatText
	
	Select Case sRowData(8)
		Case "04"
			sStatText = "가입신청"
			
		Case "05"
			If sRowData(13) == "02" then
				sStatText = "심사 부적격"
			Else
				sStatText = "서류접수"
			End If
			
		Case "06"
			sStatText = "심사완료"
			
		Case "07"
			sStatText = "계약등록 완료"
			
		Case "08"
			If sRowData(9) == "Y" or sRowData(10) == "Y" then
				sStatText = "해피콜완료"
			ElseIf (sRowData(11) <> "" and sRowData(9) == "N") or (sRowData(12) <> "" and sRowData(9) == "N") then
				sStatText = "해피콜실패"
			Else
				sStatText = "입금완료"
			End If
			
		Case "09"
			sStatText = "정상가입"
			
		Case "10"
			sStatText = "신청취소"
			
	End Select
	
	cont0.tbl0.SetCellString( 6, 1, sStatText)
	
	'상태가 가입신청인 경우에만 취소가능
	If sRowData(8) == "04" then	
		cont0.btnCancel.enable = True
	Else
		cont0.btnCancel.enable = False
	End If
	
	'상태가 신청취소인 경우 가입신청 버튼 활성화 위해 정상계약 체크
	If sRowData(8) == "10" then	
		g_bIsCancel = True
		DATAMANAGER.RequestTranData("obwat_ctad_011r")	'정상인 계약이 존재하는지 한번 더 체크
	End If
	
	'가입취소 TR INPUT값 셋팅
	DATAMANAGER.SetDataValue( 0 , "obwat_ctad_038a", "InBlock1", "APLT_DATE" , 0 , sRowData(0) )
	DATAMANAGER.SetDataValue( 0 , "obwat_ctad_038a", "InBlock1", "APLT_SRNO" , 0 , sRowData(2) )
End Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()

	'ISA 계좌가 존재하지 않는 경우
	If Trim(acnt0.caption) == "" then
		contOnline.visible = True
		cont0.visible = False
	'ISA 계좌가 존재하는 경우
	Else
		contOnline.visible = False
		cont0.visible = True
		
		Call RequestData()
	End If
End Sub

'============================================================================
Sub Form_OnRefresh()
	Call RequestData()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "mbisa56050_p1" and sRet <> "" then
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_038a", "InBlock1", "PWD" , 0 , sRet)
		DATAMANAGER.RequestTranData("obwat_ctad_038a")
	End If
End Sub

'============================================================================
Sub acnt0_ChangeAccount()
	Call RequestData()
End Sub

'============================================================================
'가입절차안내 PDF 보기
Sub cont0_btnNotice_OnClick()
	Dim nType
	nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	if nType == "0" then
		Form.OpenPdfViewer( "http://home.imeritz.com/include/resource/htsdown/PDF/mts_isa_2.pdf", "가입절차 안내")	'운영계 주소
	elseif nType == "1" then
		Form.OpenPdfViewer( "http://211.201.184.87/include/resource/htsdown/PDF/mts_isa_2.pdf", "가입절차 안내")	'테스트계주소
	end if	
End Sub

'============================================================================
'가입취소
Sub cont0_btnCancel_OnClick()
	g_bIsCancel = True
	Form.OpenPopup( "mbisa56050_p1" , "" , "")
End Sub

'============================================================================
'가입신청
Sub cont0_btnOK_OnClick()
	Form.OpenScreen("56060" , "")	
	Form.CloseForm()	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obwat_ctad_038a" or szTranID == "obwat_ctad_039r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , acnt0.sequence)
	End If
	
	If szTranID == "obwat_ctad_011r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , acnt0.total)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nCnt, sOutPut0, sOutPut1
	
	If szTranID == "obwat_ctad_039r" then
		'다음 데이터 조회시 자동 조회
		if  DATAMANAGER.IsMoreNextData( szTranID ) == True then 
			DATAMANAGER.RequestNextData( szTranID )
		else
	
			nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" )
			If nCnt == 0 then
				DATAMANAGER.RequestTranData("obwat_ctad_011r")	'정상인 계약이 존재하는지 한번 더 체크
			Else				
				Call GetJoinStatus()
			End If
		End If
	End If
	
	If szTranID == "obwat_ctad_011r" then
		'Output이 있으면, 정상계약이 존재하는 경우이므로 가입신청 버튼 비활성화
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" )
		If nCnt > 0 then
			cont0.btnOK.enable = False
			Form.ShowAlert("알림", "기 가입된 ISA계약이 있습니다. ISA계좌는 전금융기관 1인 1계좌만 가입 가능합니다.")
		Else
			If g_bIsCancel = False then		'취소 후 재조회시 메세지 띄우지 않음	
				Form.ShowAlert("알림", "온라인 가입신청 내역이 없습니다.")
			End If
			
			g_bIsCancel = False	'초기화
			cont0.btnOK.enable = True	
		End If
		
		'DATAMANAGER.RequestTranData("obwat_ctad_040r")		'랩어카운트_온라인 신규계약 상세조회
	End If
	
	'가입취소
	If szTranID == "obwat_ctad_038a" then
		Form.ShowAlert("알림", "ISA 가입취소가 완료되었습니다.")
		Call RequestData()
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

'============================================================================
'온라인 ISA 계좌개설
Sub contOnline_btnOnline_OnClick()
	Form.OpenScreen("84010" , "")
End Sub

'============================================================================
'비대면 계좌개설
Sub contOnline_btnApp_OnClick()
	sVer = Form.GetSharedData("&APP_VERSION")
	
	if sVer == "1.0.49" then 'Open 시 최초 버전 1.0.49
		Form.openExternalBrowser("https://play.google.com/store/apps/details?id=com.imeritz.smartmeritzact" ) 
	else
		'1.0.50이후부터 지원되는 API
		Form.RunSmartMeritzAct()
	end if
End Sub

