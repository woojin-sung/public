'============================================================================
'인증 실패 UI
'============================================================================
Function PasswordFail()
	ContAton.PwdFail0.visible = true
	ContAton.PwdFail1.visible = true
	ContAton.PwdFail2.visible = true
	ContAton.PwdFail3.visible = true
	ContAton.PwdFail4.visible = true
	ContAton.PwdFail5.visible = true
	ContAton.Pwdbasic0.visible = false		
	ContAton.Pwdbasic1.visible = false		
	ContAton.Pwdbasic2.visible = false		
	ContAton.Pwdbasic3.visible = false		
	ContAton.Pwdbasic4.visible = false		
	ContAton.Pwdbasic5.visible = false
	ContAton.PwdInsert0.visible = false	
	ContAton.PwdInsert1.visible = false	
	ContAton.PwdInsert2.visible = false	
	ContAton.PwdInsert3.visible = false	
	ContAton.PwdInsert4.visible = false	
	ContAton.PwdInsert5.visible = false
End Function

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'20230614 SWJ START
	'PIN 오류 후 키패드 바로 올려달라는 요건
	if sKeyName == "PinError" then
		'인증 에디트 초기화
		g_nCnt = 0
		PasswordInsert()
				
		'비밀번호 입력키패드 Show
		Form.SetTimerEvent2(1, 1, 0.6)
		
	elseif sKeyName == "E4106" then
		if sRet == "ok" then
		else
			Form.CloseForm()
		end if
	elseif sKeyName == "renew" then
		Form.CloseForm()
	end if
	'20230614 SWJ END
End Sub


