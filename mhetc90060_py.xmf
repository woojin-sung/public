'20230614 SWJ START
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mpopup_auth" then
		if sRet == "register" then		'핀 5회 에러 후 재등록 클릭 시
			g_register = "Y"
			Form.CloseForm()
		end if
	end if
End Sub
'20230614 SWJ END

'============================================================================
'인증성공 시 에디트 파란색으로 변환
'============================================================================
Sub ButtonAtonOk_OnClick()
	if ContAton.EditReal.caption == null or ContAton.EditReal.caption == "" then
		Form.MsgBox( "안내", g_sButtonText, "", 6 )
	else	
		Call PasswordInsert()
	end if
	
	g_nCnt = 0
End Sub


'============================================================================
'고객에게 보여지는 에디트 위치 클릭시 키패드 활성화(에디트 위치에 버튼 올려서)
'============================================================================
Sub ContAton_Button0_OnClick()
	
	g_AhtnTchnCode = DEF_ATON_PIN '10
	
	ContAton.EditReal.SetShowKeypad(True)
	
	'인증 에디트 초기화
	g_nCnt = 0
	PasswordInsert()	
End Sub

'============================================================================
'패스워드 글자 개수 카운트
'============================================================================
Sub ContAton_EditReal_OnEditChar(CharCode)
	Select Case CharCode
	
	Case "0"
		'입력값 6초과할 때 초과 카운팅 방지
		if g_nCnt == 6 then
			g_nCnt = 6
		else
			g_nCnt = g_nCnt + 1
		end if
		
		g_CountSave = g_nCnt
	Case "1"	
		'입력값 없을 때 마이너스 카운팅 방지
		if g_nCnt == 0 then
			g_nCnt = 0
		else
			g_nCnt = g_nCnt - 1
		end if
		
		g_CountSave = g_nCnt
	'취소, 입력완료일 때
	Case "2"
		g_nCnt = 0
	End Select

	PasswordInsert()
	
	'20240717 SWJ START: 입력완료 전에 완료 처리
	if g_nCnt = 6 then		
		'입력완료 호출 API
		ContAton.EditReal.runSecKeypadFinish()
	end if
	'20240717 SWJ END
	
End Sub

'============================================================================
'사용자에게 보여지는 패스워드 함수
'============================================================================
Function PasswordInsert()
	
	'입력완료일 시에 따로 개수 세이브해서 UI보이기
	if g_CharFlag == "N" then
		g_nCnt = g_CountSave
		g_CharFlag = ""
	end if
	
	Select Case g_nCnt
	
