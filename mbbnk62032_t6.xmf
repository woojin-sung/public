	<SCRIPT_INFO _len="3250" _ulen="2986" >
'===========================================================================
' 화 면 명: 다른 금융기관 거래내역 조회_오픈뱅킹해지
' 화면설명: 
' 작    성: 2020.10.12 송기영
' 수    정:
'===========================================================================
'***************************************************************************
'     G L O B A L   V A R I A B L E
'***************************************************************************
Dim g_szID         '사용자 아이디
Dim g_szCheck      '체크박스
Dim g_szCount

	
'===========================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()

	g_szID = Form.GetSharedData("&USER_ID", false )
	
	g_szCheck = "0"
	
End Sub

'============================================================================
Sub chk_OnChange(sCheckState)
	g_szCheck = sCheckState
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nCount
	
	if szTranID == "obtss_opnf_006a" then
		
		nCount = DATAMANAGER.GetDataCount(0, "obtss_opnf_006a", "OutBlock1")
		
		if nCount > 0 then
			Form.MsgBox("알림", "오픈뱅킹이 해지되었습니다", "", 0)	
		end if
		
	end if	
End Sub


'============================================================================
' Form_OnTriggerEvent(sEventName, sParam) : 트리거에서 입력받은 계좌번호를 사용하여 입력 세팅
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	Dim szList
	
	if sEventName == "mbbnk62032_t6" then
	
		if sParam = "" then
			g_szCount = 0
		else
			g_szCount = sParam
		end if
	end if
	
End Sub


'============================================================================
Sub btnClose_OnClick()

	if g_szCheck == "1" then
		Form.MsgBox("알림", "등록된 이용계좌는 " + g_szCount + "건 입니다." + "\n" + "오픈뱅킹을 해지 하시겠습니까?", "CLOSE", 2)
	elseif g_szCheck == "0" then
		Form.MsgBox("알림", "주의사항을 확인해주세요", "", 0)
	end if
	
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranError (szTranID , szErrCode , szErrMsg)
	if szTranID = "obtss_opnf_006a" then 
		Dim SubMsg
	
		SubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
		if SubMsg = "" then
			Form.MsgBox("알림", szErrMsg, 0)	
		else
			Form.MsgBox("알림", szErrMsg & "(" & SubMsg & ")", 0)
		end if
	end if
End Sub


'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)	
	if sKeyName == "CLOSE" then
		if sRet == "ok" then	'삭제 후 재조회		
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_006a", "InBlock1", "PROS_CLS_CODE" , 0 ,  "1" ) '예비(공란)
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_006a", "InBlock1", "ELFN_ID", 0 , g_szID)
			
			DATAMANAGER.RequestTranData("obtss_opnf_006a")
			
		end if
	end if
End Sub


	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obtss_opnf_006a" trcode="obtss_opnf_006a" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obtss_opnf_006a" title="오픈뱅킹_이용기관약정해지" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="126" _ulen="98" >

PROS_CLS_CODE^처리구분코드^1^0^0^0^0^0^0
ELFN_ID^전자금융ID^20^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="130" _ulen="94" >

API_TLMS_CLCD^API전문구분코드^3^0^0^0^0^0^0
OPN_OTSD_TR_UNIQ_NO^오픈뱅킹대외거래고유번호^20^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
	</DATAIO_INFO>
