'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szSect	=	"0"		'기본값 금액(억원)세팅
	DATAMANAGER.RequestTranData("ohhts_1531_001r")
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if szTranID = "ohhts_nmix_pgm" then
	    
	    '20221117 LES START
	    '업종코드 변경 (0001 => KGG01P)
	    DATAMANAGER.SetDataValue(1, "ohhts_nmix_pgm", "InBlock1", "FIDR_BSTP_CLS_CODE" , 0 , "KGG01P" )
	    '20221117 LES END
	    
	End if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID = "ohhts_1531_001r" then
		DATAMANAGER.CancelRealData("ohhts_nmix_pgm")
		DATAMANAGER.RequestRealData("ohhts_nmix_pgm")
	end if 
End Sub


'============================================================================
'btnChg01_OnClick
'============================================================================
Sub btnChg01_OnClick()
	if g_szSect	=	"1"	then
		btnChg01.caption	=	"금액\r\n(억원)"
		g_szSect	=	"0"
		tbl01.left = 61
		tbl02.left = 400
	else
		btnChg01.caption	=	"수량\r\n(천주)"
		g_szSect	=	"1"
		tbl01.left = 400
		tbl02.left = 61
	end if
End Sub
	


'============================================================================
Sub tbl01_OnClick(lRow , lColumn)
	'Form.OpenFramePopup("mhprc43000_t4", "", sPosInfo)
	
	Form.SetSharedData( "&SCREEN_NO" , "43010" )
'	Form.OpenFramePopup("mhprc43000_t4", "", sPosInfo)	'[프로그램 매매동향	=> 화면 하단 짤리는 현상..
	Form.OpenFramePopup("mhprc43000", "", sPosInfo)		'[투자자별 & 프로그램 매매동향] Tab이동 시키는 방법 확인...
	
End Sub

