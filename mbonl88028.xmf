	<SCRIPT_INFO _len="1310" _ulen="1310" >

'============================================================================
Sub Form_OnFormInitBefore()
	cont0.Image0.setMaintainingRatio("1")
	cont0.Image1.setMaintainingRatio("1")
	cont0.Image2.setMaintainingRatio("1")
	cont0.Image3.setMaintainingRatio("1")
	cont0.Image4.setMaintainingRatio("1")
	cont0.Image5.setMaintainingRatio("1")
	cont0.Image6.setMaintainingRatio("1")
	cont0.Image7.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	cont0.Label2.changeTextAttr(0, 28, 4, -1, true)
	
	Dim szTheme
	szTheme = Form.GetEnvData("common.theme")
	If szTheme == "white" Then
		cont0.Image1.imgpath = "cds_business_basic_w"
		cont0.Image2.imgpath = "cds_business_meritz_w"
		cont0.Image3.imgpath = "cds_joinprocess_w"
		cont0.Image4.imgpath = "title01_white"
		cont0.Image5.imgpath = "title02_white"
		cont0.Image6.imgpath = "title03_white"
		cont0.Image7.imgpath = "title04_white"
	Else
		cont0.Image1.imgpath = "cds_business_basic_b"
		cont0.Image2.imgpath = "cds_business_meritz_b"
		cont0.Image3.imgpath = "cds_joinprocess_b"
		cont0.Image4.imgpath = "title01_black"
		cont0.Image5.imgpath = "title02_black"
		cont0.Image6.imgpath = "title03_black"
		cont0.Image7.imgpath = "title04_black"
	End If
End Sub

