<ROOT>
	<MAP_INFO scrno="94005" scrname="장외파생거래요건등록내역" version="2" writer="김철중" />
	<FORM_INFO name="Form" transmode="0" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="imgDim" autosize="1" imgpath="alpha" ly_vert="0,0,375,647,1" />
		<IMAGE name="imgBg" imgpath="popup_bg.9" ly_vert="0,390,375,274,1" />
		<BUTTON name="BtnClose" btnimage="alpha" ly_vert="-1,0,375,647,1" />
		<LABEL name="lblTitle" fontsize="3" fontstyle="01" caption="유효기간 만료 안내" halign="1" ly_vert="32,410,304,30,1" />
		<LABEL name="lblText" fontstyle="01" halign="1" valign="0" multiline="1" ly_vert="20,470,335,40,1" />
		<LABEL name="lblText1" caption="만료일이 지난 후에는 장외파생상품 거래가 
불가하오니, 미리 재등록을 해주시기 바랍니다." halign="1" valign="0" multiline="1" ly_vert="20,520,335,70,1" />
		<BUTTON name="BtnOK" caption="확인" bgcolor="289:255255255" bgcolor2="233:102101101" fontsize="2" btnimage="btn_26.9" ly_vert="-3,597,381,50,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="899" _ulen="869" >

'============================================================================
Sub Form_OnFormInit()

	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()

	If szOpenData <> "" And szOpenData <> null Then	
		szOpenData = Left(szOpenData, 4) .. "." .. Mid(szOpenData,5,2) .. "." .. Right(szOpenData,2)
		
		lblText.caption = "거래요건 유효기간 만료일은\n" .. szOpenData .. " 입니다."
		lblText.changeTextAttr(10, 15, 6, 0, false)
	end if
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl94005_p1", "close")
End Sub

'============================================================================
Sub BtnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm( )
End Sub

	</SCRIPT_INFO>
</ROOT>