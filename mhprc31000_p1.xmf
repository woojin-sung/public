Sub contSet_imgBoldRest_OnClick()
	If g_tSetTable.BoldRest = "1" Then
		g_tSetTable.BoldRest = "0"
		Set_TableData(9, "미선택")
	Else
		g_tSetTable.BoldRest = "1"
		Set_TableData(9, "선택")
	End If
	
	g_szClick = "CLICK"
