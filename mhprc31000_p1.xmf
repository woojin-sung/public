	Else
		g_tSetTable.Priceoutline = "1"
		Set_TableData(3, "선택")
	End If
	
	g_szClick = "CLICK"
	Form.SaveConfigData("mhprc31000", "Priceoutline"	, g_tSetTable.Priceoutline	)	'현재가 외곽선 표시

End Sub

'============================================================================
Sub contSet_imgStyle_OnClick()
	
End Sub

'============================================================================
Sub contSet_imgTab_OnClick()
	Form.SendReturnToParent( "FORMTAB_SET", g_szClick )
	
End Sub

'============================================================================
Sub contSet_imgBoldHoga_OnClick()
	If g_tSetTable.BoldHoga = "1" Then
		g_tSetTable.BoldHoga = "0"
		Set_TableData(7, "미선택")
	Else
		g_tSetTable.BoldHoga = "1"
		Set_TableData(7, "선택")
	End If
	
	g_szClick = "CLICK"
	Form.SaveConfigData("mhprc31000", "BoldHoga"		, g_tSetTable.BoldHoga		)	'텍스트굵기 호가

End Sub

'============================================================================
Sub contSet_imgBoldJan_OnClick()
	If g_tSetTable.BoldJan = "1" Then
		g_tSetTable.BoldJan = "0"
		Set_TableData(8, "미선택")
	Else
		g_tSetTable.BoldJan = "1"
		Set_TableData(8, "선택")
	End If
	
	g_szClick = "CLICK"
	Form.SaveConfigData("mhprc31000", "BoldJan"		, g_tSetTable.BoldJan		)	'텍스트굵기 호가잔량
	
End Sub

