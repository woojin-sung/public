End Sub

'============================================================================
Sub contSet_btnInit_OnClick()
	Init_Control( 1 )
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "HOGA_STYLE" Then
		g_tSetTable.Style = sRet 
		
		If g_tSetTable.Style = "0" Then
			contSet.lblStyle.caption = "스타일1"
		ElseIf g_tSetTable.Style = "1" Then
			contSet.lblStyle.caption = "스타일2"
		End If
	End If
End Sub

'============================================================================
Sub contSet_tblSet_OnClick(lRow , lColumn)
	
	if lColumn = 1 or lColumn = 2 then
		if lRow = 0 then						' 호가등락률
			contSet_imgDispdiff_OnClick()
		elseif lRow = 1 then					' 호가잔량그래프
			contSet_imgjangraph_OnClick()
		elseif lRow = 2 then					' 호가직전수량표시
			contSet_imgDiplayrest_OnClick()
		elseif lRow = 3 then					' 현재가 외곽선 표시
			contSet_imgPriceoutline_OnClick()
		elseif lRow = 4 then					' 현재가 스타일
			contSet_imgStyle_OnClick()
		elseif lRow = 5 then					' 탭표시
			contSet_imgTab_OnClick()
		elseif lRow = 7 then					' 텍스트굵기 호가
			contSet_imgBoldHoga_OnClick()
		elseif lRow = 8 then					' 텍스트굵기 호가잔량
			contSet_imgBoldJan_OnClick()
		elseif lRow = 9 then					' 텍스트굵기 직전대비
			contSet_imgBoldRest_OnClick()
		end if
	end if
	
End Sub

'============================================================================
Sub contSet_cmbStyle_OnEditComplete(iIndex)
'	if g_bFirst = false then
'		g_bFirst = true
'	else
		g_szClick = "CLICK"
		Form.SaveConfigData("mhprc31000", "Style", iIndex		)	'현재가 스타일
'	end if
	
	contSet.lblStyle.caption = contSet.cmbStyle.caption
End Sub

