'============================================================================
' 01. 화 면 명 : 선옵 추가증거금/반대매매
' 02. 화면설명 : 선옵 추가증거금/반대매매 테이블 그리드
' 03. 작    성 : 2016.01.12 ~ 최지희
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAccountNumber		'계좌번호 8글자 ex)18431988
Dim g_nAccountSerialNumber	'계좌 일련번호 2글자 ex)01
Dim g_szAccountPassword	'계좌비밀번호
Dim g_szLiquidationDate	'반대일자


'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry() - TR(계좌번호와 일련번호, 날짜로 조회)
'============================================================================
Function TR_Inquiry(g_nAccountNumber, g_nAccountSerialNumber, g_szAccountPassword, g_szLiquidationDate)
		

	DATAMANAGER.SetDataValue(0, "obtrf_lqdt_102r", "InBlock1", "ACNO", 0 , g_nAccountNumber)
	DATAMANAGER.SetDataValue(0, "obtrf_lqdt_102r", "InBlock1", "ASNO", 0 , g_nAccountSerialNumber)
	DATAMANAGER.SetDataValue(0,"obtrf_lqdt_102r", "InBlock1", "ACNT_PWD" , 0 , g_szAccountPassword)
	DATAMANAGER.SetDataValue(0, "obtrf_lqdt_102r", "InBlock1", "LQDT_ODER_DATE", 0 , g_szLiquidationDate)
	DATAMANAGER.RequestTranData("obtrf_lqdt_102r")
End Function

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	edtPassword.visible = false
	
	g_nAccountNumber = cmbAccount.total
	g_nAccountSerialNumber = cmbAccount.sequence
	g_szAccountPassword = edtPassword.caption	
	g_szLiquidationDate = cldLiquidationDate.caption
	
	btnSearch_OnClick()
End Sub


'============================================================================
' btnSearch_OnClick - 조회를 눌릴때만 TR요청
'============================================================================
Sub btnSearch_OnClick()
	for i=0 to 5
		tblGiftOption.SetCellString( i, 1, "" )
		tblGiftOption.SetCellString( i, 3, "" )
	next
	
	g_nAccountNumber = cmbAccount.total
	g_nAccountSerialNumber = cmbAccount.sequence
	g_szAccountPassword = edtPassword.caption	
	g_szLiquidationDate = cldLiquidationDate.caption

	TR_Inquiry(g_nAccountNumber, g_nAccountSerialNumber, g_szAccountPassword, g_szLiquidationDate)

End Sub


'============================================================================
' cldLiquidationDate_OnEditComplete
'============================================================================
Sub cldLiquidationDate_OnEditComplete()
	g_szLiquidationDate = cldLiquidationDate.caption
	
	btnSearch_OnClick()
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtrf_lqdt_102r" then
		Dim nCashOA	'현금미수금
		Dim nCommissionOA	'수수료미수금		
		Dim nOA	'미수금 = 현금미수금 + 수수료미수금
		
		nCashOA = DATAMANAGER.GetDataValue(0, "obtrf_lqdt_102r", "OutBlock1", "CASH_UNAM", 0)
		nCommissionOA = DATAMANAGER.GetDataValue(0, "obtrf_lqdt_102r", "OutBlock1", "FEE_UNAM" , 0)
		nOA = nCashOA + nCommissionOA
		tblGiftOption.SetCellString(3, 1, nOA)		
		
	end if
End Sub


'============================================================================
' cmbAccount_ChangeAccount
'============================================================================
Sub cmbAccount_ChangeAccount()
	
	g_nAccountNumber = cmbAccount.total
	g_nAccountSerialNumber = cmbAccount.sequence
	g_szAccountPassword = edtPassword.caption
	
	
	btnSearch_OnClick()
End Sub

'============================================================================
' Grid0_OnScrollEnd
'============================================================================
Sub Grid0_OnScrollEnd()
	DATAMANAGER.RequestNextData("obtrf_lqdt_102r")
End Sub

