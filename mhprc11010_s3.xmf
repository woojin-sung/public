'============================================================================
' 화 면 명 : 관심종목_스타일2(ELW)
' 화면설명 : 관심종목_스타일2에서 ELW종목 선택시 조회
' 작    성 : 2016.01.05 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCd, g_szBase

Dim g_szGwanData
g_szGwanData = ""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Init_tblInfo
'============================================================================
Function Init_tblInfo()
	tblInfo.SetCellString(0, 0, "")
	tblInfo.SetCellString(1, 0, "")
	tblInfo.SetCellString(7, 0, "")	
	
	For i = 3 to tblInfo.rowcount-1
		tblInfo.SetCellString(i, 1, "")
		tblInfo.SetCellString(i, 2, "")
	Next
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.setChartType("minibong")   
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' 스타일2화면에서 트리거 받음
	if sEventName == "JMCODE" then
		DATAMANAGER.CancelRealData("ohhts_elw_cntg")			' ELW체결 자동갱신 취소
		DATAMANAGER.CancelRealData("ohhts_elw_cntg_1")		' ELW체결 자동갱신 취소(차트)
		
		Init_tblInfo()
	
		if Trim(sParam) <> "" then
			tData = Split(sParam, "★")
			tblInfo.SetCellString(0, 0, tData(0))			' 종목코드
			tblInfo.SetCellString(1, 0, tData(2))			' 종목명
			
			g_szCd = tData(0)
			g_szBase = Form.GetELWBaseCode(g_szCd)
		
			' 기본 세팅후 조회
			DATAMANAGER.RequestTranData("ohhts_3800_002r")	' ELW현재가
			DATAMANAGER.RequestTranData("ohhts_0506_001r")	' ELW종목의 소속 기초자산리스트
			DATAMANAGER.RequestTranData("ohhts_5010_001r")	' 현재가(차트[일])				
		end if
		
		g_szGwanData = Form.GetSharedData("PRE_GWAN_GRID_POS", true )
	end if
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData("ohhts_elw_cntg")			' ELW체결 자동갱신 취소
	DATAMANAGER.CancelRealData("ohhts_elw_cntg_1")		' ELW체결 자동갱신 취소(차트)
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	
	' ----------------------------------------------------------------------
	' ELW현재가
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_3800_002r" then
		DATAMANAGER.SetDataValue(0, "ohhts_3800_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "W")
		DATAMANAGER.SetDataValue(0, "ohhts_3800_002r", "InBlock1", "FID_INPUT_ISCD",               0 , g_szCd)		
	' ----------------------------------------------------------------------
	' ELW종목의 소속 기초자산리스트
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_0506_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_0506_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE", 0, "0506")
		'DATAMANAGER.SetDataValue(0, "ohhts_0506_001r", "InBlock1", "FID_INPUT_ISCD",              0, g_szBase)
		DATAMANAGER.SetDataValue(0, "ohhts_0506_001r", "InBlock1", "FID_INPUT_ISCD",              0, g_szCd)
	' ----------------------------------------------------------------------
	' 현재가(차트[일])
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_5010_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "W")
		DATAMANAGER.SetDataValue(0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
	
		DATAMANAGER.SetDataValue(0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "W")
		DATAMANAGER.SetDataValue(0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_ISCD",               0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE",  0, "Y")
		DATAMANAGER.SetDataValue(0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR",  0, "D")  'D/W/M/Y 일/주/월/년 
		DATAMANAGER.SetDataValue(0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DATE1",              0, Form.GetSharedData("&HOST_DATE", 0))		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' ELW현재가
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_3800_002r" then
		DATAMANAGER.RequestRealData("ohhts_elw_cntg")
	' ----------------------------------------------------------------------
	' ELW종목의 소속 기초자산리스트
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_0506_001r" then

	' ----------------------------------------------------------------------
	' 현재가(차트[일])
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_5010_001r" then
		DATAMANAGER.RequestRealData("ohhts_stck_cntg_1")
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	DATAMANAGER.ClearInputData(1, szTranID)
	
	' ----------------------------------------------------------------------
	' ELW체결 자동갱신 자동갱신
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_elw_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' ELW체결 자동갱신(차트)
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_stck_cntg_1" then
		DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg_1", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)
	end if
End Sub

'============================================================================
' btnHyun_OnClick
'============================================================================
Sub btnHyun_OnClick()
	Form.OpenScreen("11000" , g_szCd)
	
	Form.SetSharedData("PRE_GWAN_GRID_POS" ,g_szGwanData)
End Sub

'============================================================================
' btnChart_OnClick
'============================================================================
Sub btnChart_OnClick()
	Form.OpenScreen("13000" , g_szCd)
	
	Form.SetSharedData("PRE_GWAN_GRID_POS" ,g_szGwanData)
End Sub

'============================================================================
' btnBuy_OnClick
'============================================================================
Sub btnBuy_OnClick()
	Form.OpenScreen("12000" , "관심종목★0" & "★" & g_szCd)
	
	Form.SetSharedData("PRE_GWAN_GRID_POS" ,g_szGwanData)
End Sub

'============================================================================
' btnSell_OnClick
'==========================================================================
Sub btnSell_OnClick()
	Form.OpenScreen("12000" , "관심종목★1" & "★" & g_szCd)
	
	Form.SetSharedData("PRE_GWAN_GRID_POS" ,g_szGwanData)
End Sub


