	<SCRIPT_INFO _len="9723" _ulen="9437" >
Dim g_nPage
Dim g_xPos
Dim g_nIndex
Dim sOsType
g_nPage = 1
g_xPos  = ""
g_nIndex = 0
g_nRqNum = 200

'============================================================================
Sub Form_OnFormInit()
	sOsType = Form.GetSharedData("&OS_TYPE", false)
	Combo0.bgimagetype = "1"
	Combo1.bgimagetype = "1"
	Dim szCombo0
	Dim szCombo1
	szCombo0 = Form.GetEnvData("16051_T2_COMBO0")
	if szCombo0 <> null and szCombo0 <> ""	then
		Combo0.cbkeydata = szCombo0
	end if
	DATAMANAGER.RequestTranData("ohhts_6229_012r")

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCmb0
	Dim szCmb1
	
	szCmb0 = Combo0.cbkeydata
	szCmb1 = Combo1.cbkeydata

	if szTranID == "ohhts_6229_002r"	then
		Grid1.SetClear( )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_NTNL_CODE" , 0 , szCmb0 )
	elseif szTranID == "ohhts_6229_004r"	then
		Dim szCmb0
		Dim szCmb1

		szCmb0 = Combo0.cbkeydata
		szCmb1 = Combo1.cbkeydata
		
		if szCmb1 == "1" then '기타일경우
			szCmb1 = ""
		end if
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "OV" ) '시장분류코드	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE", 0, "62290" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIDX_INPUT_NTNL_CODE", 0, szCmb0 ) '국가코드 000:ALL/US:미국/HK:홍콩/JP:일본
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIDX_INPUT_ETF_TYPE_DIV_CODE", 0, "000" ) '상품코드 000:ALL/001:ETF/002:ETN/003:ETC/004:기타/005:VIX ETF/006:VIX ETN	    
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIDX_INPUT_ETF_GRP_CODE", 0, "" )	'그룹코드	    
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_LVRG1", 0, "" )'레버리지
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIDX_INPUT_MGCO_CODE", 0, szCmb1)'운용사  	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIDX_INPUT_TMST_CODE", 0, "")'인기테마  	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIDX_INPUT_DVDN_CYCL", 0, "")'배당주기
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_SRCH_NAME", 0, edtSearch.caption)'검색어

	elseif szTranID ==  "ohhts_6229_005r" then
		Dim szDelay, nMod, nCount
		szDelay = ""
		nMod = _tonumber(Grid2.rowcount) Mod g_nRqNum '나머지
		
		if _tonumber(Grid2.rowcount) <= g_nRqNum Then
			nCount = Grid2.rowcount
		else
			if (_tonumber(Grid2.rowcount) - g_nIndex) == nMod then
				nCount = nMod
			else
				nCount = g_nRqNum
			end if
		end if

		for i = 0 to nCount-1
			szDelay = "1"
			
			szMarket = Grid2.GetCellData("Market", g_nIndex+i)
			szCode = Grid2.GetCellData("Code", g_nIndex+i)
			if szMarket <> "" then
				szDelay = Form.GetSharedData("REALTIME_"..szMarket, 0 )
			end if
			
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i, "OV")'시장분류코드
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_COND_MRKT_CLS_CODE", i, szMarket)'시장구분코드 HK:홍콩, SH:상해, SZ:심천, NY:뉴욕, AM:아멕스, NS:나스닥 JP:도쿄
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_OVRS_ISCD", i, szCode)'해외종목코드
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE", i, szDelay)'입력지연실시간구분코드 0:실시간(Default), 1:지연
		next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	if szTranID == "ohhts_6229_002r"	then
	if szTranID == "ohhts_6229_012r"	then
		Combo1.clear = ""
		Combo1.cbadddatatext = "`전체"			

		Dim nRowCount
		nRowCount = Grid1.rowcount
		for i = 0 to nRowCount-1
			Dim szCode, szName
			szCode = Grid1.GetCellData("Code", i)
			szName = Grid1.GetCellData("Name", i)
			Combo1.cbadddatatext =  szCode.."`"..szName
		next
		Combo1.cbadddatatext = "1`기타"
		
		Dim szCombo1
		szCombo1 = Form.GetEnvData("16051_T2_COMBO1")
		
		if szCombo1 <> null and szCombo1 <> ""	then
			Combo1.cbkeydata = szCombo1
		else
			Combo1.currentindex = "0"
		end if
		Grid2.SetClear( )
		DATAMANAGER.CancelRealData("ohhts_exst_ictg")
		DATAMANAGER.RequestTranData( "ohhts_6229_004r" ) 
	elseif szTranID == "ohhts_6229_004r"	then
		Dim szNext
		szNext = DATAMANAGER.IsMoreNextData("ohhts_6229_004r")
		if szNext == "1" or szNext == true then
			DATAMANAGER.RequestNextData( "ohhts_6229_004r" )
		else
			DATAMANAGER.ClearInputData(0, "ohhts_6229_005r")
			DATAMANAGER.RequestTranData("ohhts_6229_005r")
		end if
	elseif szTranID == "ohhts_6229_005r"	then
		nCount = _tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1"))
		
		for i = 0 to nCount-1
			szCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "FIDX_ISCD" , i) '종목코드
			szName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "FIDX_KOR_ISNM" , i) '종목한글명
			szExid = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "FID_COND_MRKT_CLS_CODE" , i) '거래소코드
			nPrice = _tonumber(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "FIDX_PRPR" , i)) '현재가
			nSign = _tonumber(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "FIDX_PRDY_VRSS_SIGN" , i)) '대비부호
			nChange = _tonumber(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "FIDX_PRDY_VRSS" , i)) '대비
			szRate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "FIDX_PRDY_CTRT" , i) '대비율
			szVolume = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "FIDX_ACML_VOL" , i) '거래량
			nLevg = _tonumber(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "FID_CNCN_LVRG" , i)) '레버리지
			nPoint = _tonumber(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "FIDX_DCPN_CNT" , i)) '소수점수

			Grid0.AddRow()
			Grid0.SetCellData("bd_cell10", g_nIndex+i, szExid.."@"..szCode)
			Grid0.SetCellData("bd_cell0", g_nIndex+i, szName)
			Grid0.SetCellData("bd_cell1", g_nIndex+i, szExid)
			Grid0.SetCellData("bd_cell2", g_nIndex+i, Replace( FormatNumber(nPrice, nPoint) , "," , "" ))
			Grid0.SetCellData("bd_cell3", g_nIndex+i, nSign)
			Grid0.SetCellData("bd_cell4", g_nIndex+i, Replace( FormatNumber(nChange, nPoint) , "," , "" ))
			Grid0.SetCellData("bd_cell6", g_nIndex+i, szCode)
			if nLevg > 0  then
				Grid0.SetCellData( "bd_cell7", g_nIndex+i, "+" .. tostring(nLevg) )
			elseif nLevg < 0  then
				Grid0.SetCellData( "bd_cell7", g_nIndex+i, (nLevg) )
			else 
				Grid0.SetCellData( "bd_cell7", g_nIndex+i, "" )
			end if
			Grid0.SetCellData("bd_cell8", g_nIndex+i, szVolume)
			Grid0.SetCellData("bd_cell9", g_nIndex+i, szRate)
			
			if nSign == 1 or nSign == 2 then
				szColor = "1"
			elseif nSign == 3 then
				szColor = "3"
			elseif nSign == 4 or nSign == 5 then
				szColor = "2"
			end if
			Grid0.SetCellFgColor("bd_cell2", g_nIndex+i, szColor)
			Grid0.SetCellFgColor("bd_cell3", g_nIndex+i, szColor)
			Grid0.SetCellFgColor("bd_cell4", g_nIndex+i, szColor)
			Grid0.SetCellFgColor("bd_cell9", g_nIndex+i, szColor)
			
			DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , i , szExid.."@"..szCode )
			
		next
		Grid0.keyall = "1"
		DATAMANAGER.RequestRealData("ohhts_exst_ictg")
		g_nIndex = _tonumber(Grid0.rowcount)
	end if
End Sub

Function _tonumber(data)
	return tonumber(data) or 0
end Function
'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	g_nPage  = 1
	g_nIndex = 0
	Grid0.SetClear( )
	Grid2.SetClear( )
	DATAMANAGER.CancelRealData("ohhts_exst_ictg")
	DATAMANAGER.RequestTranData( "ohhts_6229_012r" )
End Sub

'============================================================================
Sub Combo1_OnEditComplete(iIndex)
	Grid0.SetClear( )
	Grid2.SetClear( )
	g_nPage  = 1
	g_nIndex = 0
	Form.SetEnvData(1, "16051_T2_COMBO1", Combo1.cbkeydata)
	Dim tmp
	tmp = Form.GetEnvData("16051_T2_COMBO1")
	DATAMANAGER.CancelRealData("ohhts_exst_ictg")
	DATAMANAGER.RequestTranData( "ohhts_6229_004r" ) 
End Sub
'============================================================================
Sub Form_OnRefresh()
	g_nPage  = 1
	g_nIndex = 0
	Grid0.SetClear( )
	Grid2.SetClear( )
	DATAMANAGER.CancelRealData("ohhts_exst_ictg")
	DATAMANAGER.RequestTranData( "ohhts_6229_004r" )
end Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	Dim szNext		
		
	if _tonumber(Grid2.rowcount) <= g_nIndex then
		szNext = "0"
	else
		szNext = "1"
	end if
	
	if szNext == "1" then
		DATAMANAGER.RequestTranData( "ohhts_6229_005r" )
	end if
end Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	Dim sCode, listlocation, nYPos, szData, sExid, sProCode, sName
	sExid = Grid0.GetCellData("bd_cell1", lRow)
	sProCode = Grid0.GetCellData("bd_cell6", lRow)
	sName = Grid0.GetCellData("bd_cell0", lRow)
	
	sCode = sExid.."@"..sProCode
	if sCode <> null and sCode <> ""	then
		listlocation = split(Grid0.location, ":")
		nYPos = Int(listLocation[1])
		szData = sCode.."^"..sProCode.."^"..sName.."^".."".."^"..sExid.."^"..nYPos
		Form.OpenPopup("mhtro16052_p1" , szData , "")
	end if
End Sub

