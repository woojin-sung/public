'	DATAMANAGER.ClearInputData( true, "ohhts_exst_cntg")
	
	DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , g_szExidCd & "@" & g_szOnlyCd )
	
	DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )
End Function

