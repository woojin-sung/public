	</CONTROL_INFO>
	<SCRIPT_INFO _len="13399" _ulen="12517" >
'============================================================================
' 저축장려정보제공동의
'============================================================================

dim g_szAcno	'계좌번호
dim g_szAsno	'계좌일련번호
'dim g_szPwd	'계좌비밀번호

dim g_szOsType

dim g_Pros_Gb	'처리구분 (1.동의신청, 9.동의철회)

dim g_Agree_YN_ALL	'동의서 전체체크여부
dim g_Agree_YN_1		'동의서 체크여부
dim g_Agree_YN_2		'동의서 체크여부


'============================================================================
Sub Form_OnFormInitBefore()
	ContReg.imgChkAll.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
    g_szAcno = ""
    g_szAsno = ""
    
    g_Pros_Gb = ""
    
    g_Agree_YN_ALL = "N"
    g_Agree_YN_1 = "N"
    g_Agree_YN_2 = "N"


	g_szOsType	= Form.GetSharedData("&OS_TYPE", False)  '1.안드로이드 2.iOS
	if g_szOsType = "1" then
		szCutCnt = 6
	else
		szCutCnt = 7
	end if
	ContReg.Label4.ChangeTextAttr(20, szCutCnt, 67, 0, false)


	'저축장려정보제공동의 조회
	DATAMANAGER.RequestTranData("obrtp_save_018r")
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			tData = Split(sRet, "★")
			If tData(0) <> "" then
				edtPassword.caption = tData(0)
				
				'저축장려정보제공동의처리 신청 및 철회
				DATAMANAGER.RequestTranData("obrtp_save_019a")
			else
				Exit Sub
			end if
		end if
	
	Elseif sKeyName="mbpds10613_p1" then	
		if	sRet	=	"1"	then
			if g_Agree_YN_ALL = "Y" then
				g_Agree_YN_1 = "Y"
				g_Agree_YN_2 = "Y"				
			else
				g_Agree_YN_1 = "Y"		
			end if
		end	if

		f_SetChkImage()
		
		f_SetBtnRegEnable()
		
	Elseif sKeyName = "mbonl81000" then
		'고객연락처정보 조회
		DATAMANAGER.RequestTranData( "obcsb_acad_002r" )		
	End if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName = "Go_Cancel" then
		if sRet = "ok" then	'동의 철회
			Dim sSendData
			sSendData = g_szAcno & g_szAsno & "☆" & "0"
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")	
		else 		'아니오
			Exit Sub
		end if
		
	Elseif sKeyName == "Go_Home" then
		Form.OpenScreen("99999","")	'Home으로 이동!
		'메뉴트리(OS별로 다름)로 이동
		if g_szOsType = "1" then
			Form.OpenMainMenuWithIndex(3,1,1)
		else
			Form.OpenMainMenuWithIndex(3,1,6)
		end if
		
	Elseif sKeyName == "Go_018r" then
		ContReg.visible = false
		ContCancel.visible = false
		
		'저축장려정보제공동의 조회
		DATAMANAGER.RequestTranData("obrtp_save_018r")
	End if
End Sub

'============================================================================
Sub ContReg_imgAllAgreeBox_OnClick()
	ContReg_lblAgreeAll_OnClick()
End Sub

'============================================================================
Sub ContReg_btnAgreeAll_OnClick()
	ContReg_lblAgreeAll_OnClick()
End Sub

'============================================================================
Sub ContReg_imgChkAll_OnClick()
	ContReg_lblAgreeAll_OnClick()
End Sub

'============================================================================
Sub ContReg_lblAgreeAll_OnClick()
	if g_Agree_YN_1 = "Y" and g_Agree_YN_2 = "Y" then
		g_Agree_YN_ALL = "N"
		g_Agree_YN_1 = "N"
		g_Agree_YN_2 = "N"
		
	else
		g_Agree_YN_ALL = "Y"
		Form.OpenFramePopup("mbpds10613_p1" , sOpenData , sPosInfo)
		
	end if
	
	f_SetChkImage()
	
	f_SetBtnRegEnable()
End Sub

'============================================================================
Sub ContReg_imgChk1_OnClick()
	ContReg_lblAgree1_OnClick()
End Sub

'============================================================================
Sub ContReg_imgViewPDF_OnClick()
	ContReg_lblAgree1_OnClick()
'	Form.OpenFramePopup("mbpds10613_p1" , sOpenData , sPosInfo)
End Sub

'============================================================================
Sub ContReg_lblAgree1_OnClick()
	if g_Agree_YN_1 = "Y" then	'현재 동의상태이면 미동의로 변경
		g_Agree_YN_ALL = "N"
		g_Agree_YN_1 = "N"

		f_SetChkImage()
		
		f_SetBtnRegEnable()		
	else
		Form.OpenFramePopup("mbpds10613_p1" , sOpenData , sPosInfo)
	end if
End Sub

'============================================================================
Sub ContReg_imgChk2_OnClick()
	ContReg_lblAgree2_OnClick()
End Sub

'============================================================================
Sub ContReg_lblAgree2_OnClick()
	if g_Agree_YN_2 = "Y" then	'현재 동의상태이면 미동의로 변경
		g_Agree_YN_ALL = "N"		
		g_Agree_YN_2 = "N"
	else
		g_Agree_YN_2 = "Y"		
	end if

	f_SetChkImage()
	
	f_SetBtnRegEnable()
End Sub	

'============================================================================
Sub ContReg_tblInfo_OnClick(lRow , lColumn)
	'연락처 정보 변경
	if lRow = 0 and lColumn = 1 then
		sTabIdx = "1"	'email
		sSendData = g_szAcno..";"..edtPassword.caption..";"..sTabIdx
		Form.OpenFramePopup("mbonl81000" , sSendData , "")
	end if
End Sub

'============================================================================
Sub ContReg_btnOK_OnClick()
	g_Pros_Gb = "1"	'동의신청
	
	Dim sSendData
	sSendData = g_szAcno & g_szAsno & "☆" & "0"
	'비밀번호 팝업 띄움..	
	Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")	
End Sub

'============================================================================
Function f_SetChkImage()

	if g_Agree_YN_1 = "Y" and g_Agree_YN_2 = "Y" then
		ContReg.imgChkAll.imgpath = "checkmenu_o.png"
		ContReg.imgChk1.imgpath = "check_line_o.png"
		ContReg.imgChk2.imgpath = "check_line_o.png"
		
	elseif g_Agree_YN_1 = "Y" and g_Agree_YN_2 = "N" then
		ContReg.imgChkAll.imgpath = "checkmenu_n.png"
		ContReg.imgChk1.imgpath = "check_line_o.png"
		ContReg.imgChk2.imgpath = "check_line_n.png"
		
	elseif g_Agree_YN_1 = "N" and g_Agree_YN_2 = "Y" then
		ContReg.imgChkAll.imgpath = "checkmenu_n.png"
		ContReg.imgChk1.imgpath = "check_line_n.png"
		ContReg.imgChk2.imgpath = "check_line_o.png"
		
	else
		ContReg.imgChkAll.imgpath = "checkmenu_n.png"
		ContReg.imgChk1.imgpath = "check_line_n.png"
		ContReg.imgChk2.imgpath = "check_line_n.png"

	end if
	
End Function

'============================================================================
Function f_SetBtnRegEnable()
	ContReg.btnOK.btnimage = "btn_15.9"
	ContReg.btnOK.enable = false
	
	if ContReg.lblCoNm.caption = "" or ContReg.lblCoNm.caption = NULL then
		ContReg.btnOK.enable = false
		Exit Function	
	end if
	
	if g_Agree_YN_1 = "N" or g_Agree_YN_2 = "N" then
		ContReg.btnOK.enable = false
		Exit Function	
	end if
	
	if ContReg.tblInfo.GetCellString(0, 0) = "" or ContReg.tblInfo.GetCellString(0, 0) = NULL then
		ContReg.btnOK.enable = false
		Exit Function	
	end if
	
	'동의신청가능
	ContReg.btnOK.enable = true	
	ContReg.btnOK.btnimage = "btn_20.9"
	ContReg.btnOK.fgcolor = "273"
End Function



'============================================================================
Sub ContCancel_btnCancel_OnClick()
	g_Pros_Gb = "9"	'동의철회
	
	Dim szAccount
	szAccount = cmbAccount.caption
	
	if szAccount <> "" and szAccount <> NULL then
		Form.MsgBox( "안내", "금융거래정보 이용 제공 동의를\n철회 하시겠습니까?", "Go_Cancel", 7, "동의 철회", "닫기" )
	end if
End Sub



'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    If szTranID == "obrtp_save_018r" Then
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PROS_CLS_CODE"      , 0 , "1")	'1:조회
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ELFN_ID"            , 0 , Form.GetSharedData("&USER_ID", False))
	
	Elseif szTranID = "obrtp_save_019a" then
		if g_Pros_Gb = "1" then	'동의신청
			szAGRM_YN = "Y"
		elseif g_Pros_Gb = "9" then	'동의철회
			szAGRM_YN = "N"
		end if
		
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PROS_CLS_CODE"     , 0 , g_Pros_Gb)	'1:동의신청, 9:동의철회
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"      		, 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ASNO"      		, 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "AGRM_YN"      		, 0 , szAGRM_YN)
	
	Elseif szTranID = "obcsb_acad_002r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szAcno )
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD" , 0 , g_szPwd )
		
    End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obrtp_save_018r" Then
		cmbAccount.clear = ""
	
		szAcno 			= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ACNO" , 0)
		szAsno 			= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ASNO" , 0)
		szPrnm 			= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "PRNM" , 0)
		szCUST_FULL_NAME 	= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "CUST_FULL_NAME" , 0)
		cmbAccount.cbadddatatext = szAcno .. szAsno .. "`[" .. szPrnm .."] " .. Left(szAcno, 4) .. "-" .. Right(szAcno, 4) .. "-" .. szAsno .. " " .. szCUST_FULL_NAME
    
		g_szAcno = szAcno
		g_szAsno = szAsno
    
		szACO_CLS_CODE	= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ACO_CLS_CODE" , 0)	'자회사구분코드
		szITEM_CLS_NAME	= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ITEM_CLS_NAME" , 0)	'항목구분명
		szAGRM_YN		= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "AGRM_YN" , 0)		'동의여부
		szAPLT_DATE		= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "APLT_DATE" , 0)		'신청일자
		szEMAIL_ADDR		= DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "EMAIL_ADDR" , 0)	'이메일주소
		
		if Trim(szEMAIL_ADDR) = "" or Trim(szEMAIL_ADDR) = NULL then
			szEMAIL_ADDR = ""
		end if
		
'	szACO_CLS_CODE = "EE"	
		if szACO_CLS_CODE <> "" and szACO_CLS_CODE <> NULL then
			if szACO_CLS_CODE = "FF" then
				if szAGRM_YN = "Y" then	'동의 상태이면, 신청정보 조회 & 철회 가능
					ContReg.visible = false
					ContCancel.visible = true
					
					ContCancel.lblData1.caption = szITEM_CLS_NAME
					ContCancel.lblData2.caption = "동의"
					ContCancel.lblData3.caption = szAPLT_DATE
					ContCancel.lblData4.caption = szEMAIL_ADDR
					
				else		'미동의 상태이면, 신청화면 조회
					ContReg.visible = true
					
					ContReg.lblCoNm.caption = szITEM_CLS_NAME
					
					g_Agree_YN_1 = "N"
					g_Agree_YN_2 = "N"
					
					ContReg.imgChkAll.imgpath = "checkmenu_n.png"
					ContReg.imgChk1.imgpath = "check_line_n.png"
					ContReg.imgChk2.imgpath = "check_line_n.png"
					
					if szEMAIL_ADDR = "" then
						ContReg.tblInfo.SetCellString(0, 0, "")
						ContReg.tblInfo.SetCellString(0, 1, "등록하기 〉")
					else
						ContReg.tblInfo.SetCellString(0, 0, szEMAIL_ADDR)
						ContReg.tblInfo.SetCellString(0, 1, "변경하기 〉")
					end if
					
					ContCancel.visible = false
					
					f_SetBtnRegEnable()
				end if
				
			Else
				cmbAccount.cbadddatatext = ""
				cmbAccount.caption = "선택할 수 있는 계좌가 없습니다."
				cmbAccount.enable = false
				
				ContReg.visible = true
				
				Form.MsgBox( "안내", "계열사 임직원 전용화면으로\n대상 고객만 이용 가능합니다.", "Go_Home", 6, "확인" )
				Exit Sub
			End if
		ELSE
			cmbAccount.cbadddatatext = ""
			cmbAccount.caption = "선택할 수 있는 계좌가 없습니다."
			cmbAccount.enable = false
			
			ContReg.visible = true
			
			Form.MsgBox( "안내", "계열사 임직원 전용화면으로\n대상 고객만 이용 가능합니다.", "Go_Home", 6, "확인" )
			Exit Sub
		End if
		
	Elseif szTranID = "obrtp_save_019a" then		
		if g_Pros_Gb = "1" then
			szResultMsg = "신청이 완료되었습니다."			
		elseif g_Pros_Gb = "9" then
			szResultMsg = "동의 철회가 완료되었습니다."			
		end if
		
		Form.MsgBox( "안내", szResultMsg, "Go_018r", 6, "확인" )
		
	Elseif szTranID = "obcsb_acad_002r" then
		Dim nCount
		nCount = DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock1" )
			
		if nCount > 0 then		
			for i = 0 to nCount-1
				Dim sINAG_TYPE_CODE
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "INAG_TYPE_CODE" , i )
				
				if sINAG_TYPE_CODE == "21" then 'E-mail
					Dim sEmail
					sEmail = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "EMAIL_ADDR" , i )

					if sEmail = "" then
						ContReg.tblInfo.SetCellString(0, 0, "")
						ContReg.tblInfo.SetCellString(0, 1, "등록하기 〉")
					else
						ContReg.tblInfo.SetCellString(0, 0, sEmail)
						ContReg.tblInfo.SetCellString(0, 1, "변경하기 〉")
					end if
				end if
			next
		end if
		
		f_SetBtnRegEnable()
	End if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    szSubErr = Trim(DATAMANAGER.GetDataMsgSubText( szTranID ))

    If szSubErr == "" Then
        Form.MsgBox( "알림", szErrMsg, "", 6 )		
    Else
        Form.MsgBox( "알림", szErrMsg.."\n("..szSubErr..")", "", 6 )		
    End If
End Sub

