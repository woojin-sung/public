				<LABEL name="lblAgree2" fontsize="-2" caption="해당 계열사에 금융거래정보 이용ㆍ제공에
동의합니다." valign="0" multiline="1" paddinginfo="1,0,0,0" click="1" ly_vert="70,287,265,40,1" />
