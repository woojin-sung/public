'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 오픈뱅킹 휴대폰 본인인증
' 02. 화면설명 : 오픈뱅킹 휴대폰 본인인증 (범용사용 가능)
' 03. 작    성 : 2016.01.25 성주혁
' 2021.01.19 : 정민영 : v0001 : obcsb_oimf_653a 변경IO 적용
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sUserID 	'고객ID
Dim g_sUserName 	'고객명
Dim g_sUserRCNO 	'고객주민번호
Dim g_sSMSSeqNo 	'SMS인증전문일련번호
Dim g_sSMSSeqNo1 	'SMS인증전문일련번호
Dim g_nTryCnt  	'SMS/ARS인증검증요청횟수
Dim G_AGREE_FILE 	'개인정보수집이용제공동의풀팝업
Dim g_sCiKey		'CIKEY 번호

'============================================================================
Sub Form_OnFormInit()
	Dim sTemp, sRevData
	sRevData = Form.GetOpenLinkData()
	g_sUserID = Form.GetSharedData("&USER_ID" , false)
	g_sUserName = Form.GetSharedData("&USER_NAME" , false)
	g_sUserRCNO = Form.GetSharedData("&JUMIN_NUM" , false)
	g_nTryCnt = 0
	g_sSMSSeqNo = ""
	g_sSMSSeqNo1 = ""
	g_sRetData = "cancel"
	G_AGREE_FILE = "mbonl81000_p6"
	
	Form.SetScreenName("휴대폰 본인인증")
	
	DATAMANAGER.RequestTranData( "obcsb_oimf_638r" ) '전자금융사기예방고객종합조회
End Sub

Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_oimf_638r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
	elseif szTranID == "obcsb_oimf_653a" then
		'1:본인확인 2:본인확인+SMS인증  3:SMS인증
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_653a", "InBlock1", "ATHN_BSWR_CLCD" , 0 , "4" )
		if RadioGroup0.currentindex == "0" then 'SKT
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_653a", "InBlock1", "MCCO_CODE" , 0 , "SKT" )
		elseif RadioGroup0.currentindex == "1" then 'KT
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_653a", "InBlock1", "MCCO_CODE" , 0 , "KT " )
		elseif RadioGroup0.currentindex == "2" then 'LG U+
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_653a", "InBlock1", "MCCO_CODE" , 0 , "LGT" )
		elseif RadioGroup0.currentindex == "3" then 'SKT 알뜰폰
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_653a", "InBlock1", "MCCO_CODE" , 0 , "AL " )
		elseif RadioGroup0.currentindex == "4" then 'KT 알뜰폰
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_653a", "InBlock1", "MCCO_CODE" , 0 , "KAL" )
		elseif RadioGroup0.currentindex == "5" then 'LG U+ 알뜰폰
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_653a", "InBlock1", "MCCO_CODE" , 0 , "LAL" )
		end if		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_653a", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_653a", "InBlock1", "CLPH_ARCD" , 0 , Edit0.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_653a", "InBlock1", "CLPH_TONO" , 0 , Edit1.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_653a", "InBlock1", "CLPH_SRNO" , 0 , Edit2.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_653a", "InBlock1", "SVCD" , 0 , "000" )
	
	elseif szTranID == "obcsb_oimf_654a" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_654a", "InBlock1", "PROS_CLS" , 0 , "2" )
		'1:본인확인 2:본인확인+SMS인증  3:SMS인증
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_654a", "InBlock1", "ATHN_BSWR_CLCD" , 0 , "4" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_654a", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_654a", "InBlock1", "NICE_ISTU_TLMS_MNNO" , 0 , g_sSMSSeqNo )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_654a", "InBlock1", "SMS_ATHN_NO" , 0 , EditInput.caption )
	elseif szTranID == "obcsb_oimf_654a_1" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_654a_1", "InBlock1", "PROS_CLS" , 0 , "1" )
		'1:본인확인 2:본인확인+SMS인증  3:SMS인증
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_654a_1", "InBlock1", "ATHN_BSWR_CLCD" , 0 , "4" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_654a_1", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_654a_1", "InBlock1", "NICE_ISTU_TLMS_MNNO" , 0 , g_sSMSSeqNo )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_654a_1", "InBlock1", "SMS_ATHN_NO" , 0 , "" )
	elseif szTranID == "obcsb_oimf_655r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_655r", "InBlock1", "ATHN_BSWR_CLCD" , 0 , "4" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_655r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_655r", "InBlock1", "SMS_ATHN_NO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_655r", "InBlock1", "NICE_ISTU_TLMS_MNNO" , 0 , g_sSMSSeqNo1 )
		
	end if
	
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_638r" then
		'Dim CLPH_ARCD, CLPH_TONO, CLPH_SRNO
		'CLPH_ARCD = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "CLPH_ARCD" , 0 )
		'CLPH_TONO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "CLPH_TONO" , 0 )
		'CLPH_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "CLPH_SRNO" , 0 )
		
		'Table0.SetCellString( 6, 1, CLPH_ARCD..CLPH_TONO..CLPH_SRNO )
	elseif szTranID == "obcsb_oimf_653a" then
		g_sSMSSeqNo = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_653a", "OutBlock1", "NICE_ISTU_TLMS_MNNO" , 0 )
		
		Form.SetTimerEvent( 0 , 1, 1)

	elseif szTranID == "obcsb_oimf_654a" then
		g_sSMSSeqNo1 = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_654a", "OutBlock1", "NICE_ISTU_TLMS_MNNO" , 0 )

		Form.SetTimerEvent( 1 , 1, 1)
	elseif szTranID == "obcsb_oimf_654a_1" then
		g_sSMSSeqNo1 = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_654a_1", "OutBlock1", "NICE_ISTU_TLMS_MNNO" , 0 )
	elseif szTranID == "obcsb_oimf_655r" then
		g_sCiKey	    = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_655r"	, "OutBlock1", "CIKEY_NO" , 0 )

		g_sRetData = "ok" & "★" & g_sCiKey
		'Form.SendReturnToParent("mbbnk62006", szData)
		Form.CloseForm( )

	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obcsb_oimf_654a_1" then			'16-03-15 YCJ 수정
		if szErrCode == "3021" then
			Form.SetTimerEvent( 0 , 1, 1)
		else
			Form.MsgBox( "알림", szErrMsg, "", 6 )
		end if
	elseif szTranID == "obcsb_oimf_655r" then
		if szErrCode == "3021" then
			Form.SetTimerEvent( 1 , 1, 1)
		else
			Form.MsgBox( "알림", szErrMsg, "", 6 )
		end if
	elseif szTranID == "obcsb_oimf_653a" then
		Form.ShowAlert( "알림", szErrMsg)
	end if

End Sub


'============================================================================
Sub ButtonView_OnClick()
	Form.OpenFramePopup(G_AGREE_FILE , "" , "")
	
End Sub

'============================================================================
Sub ButtonRequest_OnClick()
	if Edit0.caption == "" or Edit1.caption == "" or Edit2.caption == "" then
		Form.MsgBox( "알림", "전화번호를 입력해주세요.", "", 6 )
		Exit Sub
	end if
	
	if ChkButton0.chksilence == "0" then
		Form.MsgBox( "알림", "본인명의 인증서비스를 위한 약관에 전체 동의가 필요합니다. ", "", 6 )
		Exit Sub
	end if
	
	g_nTryCnt = 0
	g_sSMSSeqNo = ""
	g_sSMSSeqNo1 = ""
	EditInput.enable = true
	DATAMANAGER.RequestTranData( "obcsb_oimf_653a" ) ''인증번호요청조회
End Sub
'============================================================================
Sub ButtonOK_OnClick()
	if ChkButton0.chksilence == "0" then
		Form.MsgBox( "알림", "본인명의 인증서비스를 위한 약관에 전체 동의가 필요합니다.", "", 6 )
		Exit Sub
	end if
	
	if g_sSMSSeqNo == "" then
		Form.MsgBox( "알림", "[인증번호 전송]을 실행해 주세요.", "", 6 )
		Exit Sub
	end if
	
	if EditInput.caption == "" then
		Form.MsgBox( "알림", "인증번호를 입력하세요.", "", 6 )
		Exit Sub
	end if
	
	g_nTryCnt = 0
	DATAMANAGER.RequestTranData( "obcsb_oimf_654a" ) '613a인증확인요청
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbbnk62006" , g_sRetData)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == G_AGREE_FILE then
		if sRet == "ok" then
			ChkButton0.chksilence = "1"
		end if
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if sTimerID == 0 or sTimerID == "0" then
		Form.SetTimerEvent( 0 , 0, 1)
		g_nTryCnt = g_nTryCnt+1
		if g_nTryCnt > 40 then			'4~50초 정도만 적용해놓음
			Form.ShowAlert( "알림", "본인인증확인에 실패하였습니다. 다시 시도하여 주시기 바랍니다.")
			Exit Sub
		end if
			
		DATAMANAGER.RequestTranData( "obcsb_oimf_654a_1" ) '613a인증확인요청
	
	elseif sTimerID == 1 or sTimerID == "1" then
		Form.SetTimerEvent( 1 , 0, 1)
		g_nTryCnt = g_nTryCnt+1
		if g_nTryCnt > 40 then			'4~50초 정도만 적용해놓음
			Form.ShowAlert( "알림", "본인인증확인에 실패하였습니다. 다시 시도하여 주시기 바랍니다.")
			Exit Sub
		end if
			
		DATAMANAGER.RequestTranData( "obcsb_oimf_655r" ) '인증번호확인요청
	
	end if	
End Sub

'============================================================================
Sub Edit0_OnEditChar(CharCode)
	if #CharCode >=3 then
		Edit1.SetShowKeypad( true )
	end if
End Sub

'============================================================================
Sub Edit1_OnEditChar(CharCode)
	if #CharCode >=4 then
		Edit2.SetShowKeypad( true )
	end if
End Sub
