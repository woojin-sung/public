'============================================================================
' 2017.10.20 -  LSS
' 연합인포맥스 종목검색-홍콩 화면
'
' 1. 화면상의 모든 DEFINE 은 initDefine() 함수에서 처리 함.
'
' 2017.10.24 - LSS
' 1. 관심관련 내용 추가
'============================================================================

Dim g_tblDefine, g_tintrList
'============================================================================
Sub Form_OnFormInit()
	initDefine()
	initDefault()
End Sub

'============================================================================
Sub Form_OnChangeOrientation(nOrientation)
	initOrientation(nOrientation)
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if Null == g_tblDefine then
		Exit Sub
	end if

	if (g_tblDefine["IS_INTR"] == sEventName) then
		g_tblDefine.isIntr = (sParam == "1") and true or false
		
	elseif (g_tblDefine["SELECT_ITEMLIST"] == sEventName) and ( not isNull(sParam) ) then
		g_tintrList = Split( sParam, g_tblDefine["SPLIT"] )
	
	elseif (g_tblDefine["REMOVE_ITEM"] == sEventName) and ( not isNull(sParam) ) then
		Dim tCode, nRowCount, szItemCode
		
		tCode = Split(sParam, g_tblDefine["SPLIT"])
		if Null <> tCode and #tCode >= 1 then
			nRowCount = CInt( grdList.rowcount )
			For i = 0 to nRowCount-1
				szItemCode = grdList.GetCellData( "code", i )
				if szItemCode == tCode[0] then					
					swapSelItemFgColor( false, i )
					Exit Sub
				end if
			Next
		end if
	end if
End Sub

'----------------------------------------------------------------------------
' 2017.10.18 -  LSS
' 통신 함수
'----------------------------------------------------------------------------
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	' 해외주식 종목검색 리스트
	if szTranID == g_tblDefine["TRAN_LIST"] then
		Dim tData, nRowCount, nCount
		nRowCount = CInt( grdList.rowcount )
		nCount = CInt( DATAMANAGER.GetDataCount( false, szTranID , "itemList" ) )
		
		tData = {
			"code", "engname", "industry", "isin", "korname", 
			"ordersize", "symbol"
		}
				
		For i = 0 to nCount-1
			grdList.insertrow = nRowCount + i
			
			For _, val in pairs( tData )
				grdList.SetCellData( val, nRowCount + i, DATAMANAGER.GetDataValue( false, szTranID , "itemList" , val , i) )
			Next
			
			if g_tblDefine.isIntr then
				swapIntrListFgColor( nRowCount + i, DATAMANAGER.GetDataValue( false, szTranID , "itemList" , tData[0] , i) )
			end if
		Next
		
		g_tblDefine.szNextKey = DATAMANAGER.GetDataValue( false, szTranID , "itemInfo" , "nextkey" , 0 )

	' 해외주식 종목 상세
	elseif szTranID == g_tblDefine["TRAN_DETAIL"] then
		Dim szItemCode, szItemName, szOrderState
		
		szItemCode = DATAMANAGER.GetDataValue( false, szTranID , "price" , "code" , 0 )
		szItemName = DATAMANAGER.GetDataValue( false, szTranID , "price" , "korname" , 0 )
		szOrderState = DATAMANAGER.GetDataValue( false, szTranID , "price" , "subx" , 0 )
		
		' 수신된 정보 메인화면으로 전달
		Form.triggerEvent( "#", g_tblDefine[ "SELECT_ITEM" ], szItemCode & g_tblDefine["SPLIT"] & szItemName & g_tblDefine["SPLIT"] & szOrderState)
		
	end if
End Sub

'============================================================================
'해외주식 종목검색 조회
'============================================================================
Sub reqItemInfo(isNext)
	if not isNext then
		g_tblDefine.szNextKey = ""
		grdList.SetClear()
	else
		if g_tblDefine["END_NEXT"] == g_tblDefine.szNextKey then
			return
		end if
	end if
	
	Form.triggerEvent( "#", g_tblDefine[ "SELECT_ITEMLIST" ], "" )

	Dim tData
	tData = {
		["exid"] = "HKS",
		["instrument"] = getIndustry(),
		["keyword"] = edtSearch.caption,
		["nextkey"] = g_tblDefine.szNextKey,
		["searchkeytype"] = getSearchType()
	}
	
	DATAMANAGER.ClearInputData( false, g_tblDefine["TRAN_LIST"] )
	For key, val in pairs( tData )
		DATAMANAGER.SetDataValue( false, g_tblDefine["TRAN_LIST"], "inblock", key , 0 , val )
	Next
	DATAMANAGER.RequestTranData( g_tblDefine["TRAN_LIST"] )
		
End Sub

'============================================================================
'해외주식 종목상세 조회
'============================================================================
Sub reqItemDetail(szItemValue)
	DATAMANAGER.SetDataValue( false, g_tblDefine["TRAN_DETAIL"], "inblock", "code" , 0 , szItemValue )
	DATAMANAGER.RequestTranData( g_tblDefine["TRAN_DETAIL"] )
	
End Sub

'----------------------------------------------------------------------------
' 2017.10.20 -  LSS
' 컨트롤 함수
'----------------------------------------------------------------------------
'============================================================================
Sub edtSearch_OnEditChar(CharCode)
	reqItemInfo(false)
End Sub

'============================================================================
Sub rdoVertical_OnClick(nIndex)
	reqItemInfo(false)
End Sub

'============================================================================
Sub rdoHorizontal_OnClick(nIndex)
	reqItemInfo(false)
End Sub

'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szItemExchange, szItemCode, szItemName
	szItemExchange = grdList.GetCellData( "symbol", lRow )
	szItemCode = grdList.GetCellData( "code", lRow )
	szItemName = grdList.GetCellData( "korname", lRow )
	
	if( g_tblDefine.isIntr ) then
		swapSelItemFgColor( true, CInt(lRow) )
		Form.triggerEvent( "#", g_tblDefine[ "SELECT_ITEM" ], szItemCode & g_tblDefine["SPLIT"] & szItemName )
	else
		reqItemDetail( szItemCode )	
	end if
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	reqItemInfo(true)
End Sub

'----------------------------------------------------------------------------
' 2017.10.20 -  LSS
' 사용자 함수
'----------------------------------------------------------------------------
'============================================================================
' 기본 설정된 정보들 설정
'============================================================================
Sub initDefine()
	g_tblDefine = {
		["SPLIT"] = "★",
		["TRAN_LIST"] = "getGtsItemInfoList",
		["TRAN_DETAIL"] = "getGtsHogaDetail",
		["END_NEXT"] = "!endcode",
		' 폰트색상
		["CL_DEF"] = 4,
		["CL_INTR_SELECT"] = 64,
		' 포지션
		["DEF_POS"] = 5,
		["VERT_POS"] = 677,
		["HORI_POS"] = 375,
		' 반환 이벤트
		["IS_INTR"] = "IS_INTR",
		["REMOVE_ITEM"] = "REMOVE_ITEM",
		["SELECT_ITEM"] = "SELECT_ITEM",
		["SELECT_ITEMLIST"] = "SELECT_ITEMLIST",
	}
	
	g_tblDefine.isIntr = false
	g_tblDefine.szNextKey = ""
	
	g_tintrList = {}
End Sub

'============================================================================
' 기본 정보 및 컨트롤 설정
'============================================================================
Function initDefault()	
	initOrientation( CInt( Form.GetOrientation( ) ) )
	
	reqItemInfo(false)
End Function

'============================================================================
' 폰트 색상 변경
'============================================================================
Function swapSelItemFgColor(isSelect, nIndex)
	grdList.SetCellFgColor( "symbol", nIndex, g_tblDefine[ isSelect and "CL_INTR_SELECT" or "CL_DEF" ] )
	grdList.SetCellFgColor( "korname", nIndex, g_tblDefine[ isSelect and "CL_INTR_SELECT" or "CL_DEF" ] )
End Function

'============================================================================
' List폰트 색상 변경
'============================================================================
Sub swapIntrListFgColor(nIndex, szItemCode)
	if  not g_tblDefine.isIntr or Null == g_tintrList or #g_tintrList <= 0 then
		Exit Sub
	end if
	
	Dim isSelect
	For i = 0 to #g_tintrList-1
		isSelect = ( szItemCode == g_tintrList[i] ) and true or false
		if isSelect then
			Exit For
		end if		
	Next
	
	swapSelItemFgColor( isSelect, nIndex )
End Sub

'============================================================================
' 시장타입 반환
'============================================================================
Function getIndustry()
	Dim nOrientation, nRdoIndex
	nOrientation = CInt( Form.GetOrientation() )
	nRdoIndex = CInt( Form.GetCtlProp( ( nOrientation == 1 and "rdoHorizontal" or "rdoVertical" ) , "currentindex") )
	
	Select Case nRdoIndex
	Case 0
		return 0
	Case 1
		return 1
	Case 2
		return 7
	End Select
	
End Function

'============================================================================
' 라디오컨트롤 세로/가로에 따라 변경
'============================================================================
Sub initOrientation(nOrientation)
	rdoVertical.left = ( nOrientation == 0 ) and g_tblDefine["DEF_POS"] or g_tblDefine["VERT_POS"]
	rdoVertical.visible = ( nOrientation == 0 ) and true or false
	
	rdoHorizontal.left = ( nOrientation == 1 ) and g_tblDefine["DEF_POS"] or g_tblDefine["HORI_POS"]
	rdoHorizontal.visible = ( nOrientation == 1 ) and true or false
End Sub

'============================================================================
' null 체크
'============================================================================
Function isNull(str)
	if null == str or "" == str or Len(Trim(str)) <= 0 then
		return true
	end if
	
	return false
End Function

Function getSearchType()
	Dim nRadioIndex
	nRadioIndex = Form.GetCtlProp( "RadioGroup0" , "currentindex")
	if nRadioIndex == "0" then
		return "1"
	elseif nRadioIndex == "1" then
		return "2"
	else
		return "1"
	end if
End Function

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	reqItemInfo(false)
End Sub
