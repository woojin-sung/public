			<CELL_INFO>
				<CELL cell_ly="0,0,1,0" halign="0" caption="발행어음 상품" fontsize="-2" fontstyle="01" impidxs="" />
				<CELL cell_ly="0,1,0,1" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="매매 가능시간" fontsize="-2" fontstyle="01" impidxs="" />
				<CELL cell_ly="1,1,1,1" halign="0" caption="08:00 ~ 17:00" fontsize="-3" impidxs="" />
				<CELL cell_ly="0,2,0,2" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="예금자보호대상" fontsize="-2" fontstyle="01" impidxs="" />
				<CELL cell_ly="1,2,1,2" halign="0" caption="이 예금은 예금자보호법에 따라 예금보험공사
가 보호하되, 보호 한도는 당사에 있는 귀하의
모든 예금보호 대상 금융상품의 원금과 소정의
이자를 합하여 1인당 '최고 5천만원'이며, 
5천만원을 초과하는 나머지 금액은 보호하지
않습니다." fontsize="-3" impidxs="" />
				<CELL cell_ly="0,3,0,3" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="확정금리 상품" fontsize="-2" fontstyle="01" impidxs="" />
				<CELL cell_ly="1,3,1,3" halign="0" caption="금리 변동과 관계없이 저축시점에 금리가 확정
되며, 중도환매 시 당사가 정한 중도환매
이자율이 적용됨" fontsize="-3" impidxs="" />
				<CELL cell_ly="0,4,0,4" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="가입대상 및 한도" fontsize="-2" fontstyle="01" impidxs="" />
				<CELL cell_ly="1,4,1,4" halign="0" caption="최소가입금액 100만원 이상
개인 최소 100만원 ~ (한도 없음)
법인 최소 100만원 ~ 최대 100억" fontsize="-3" impidxs="" />
				<CELL cell_ly="0,5,0,5" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="투자기간" fontsize="-2" fontstyle="01" impidxs="" />
				<CELL cell_ly="1,5,1,5" halign="0" caption="1일 이상 1년 이하 일단위로 자유롭게 결정
