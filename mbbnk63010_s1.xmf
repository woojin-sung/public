--===========================================================================
--===========================================================================

Dim g_szSeparator
Dim g_szCustNo '고객번호
Dim g_szUserID '고객아이디
Dim g_szUserNm '고객명

Dim g_szBankCode
Dim g_szBankName
Dim g_szBankAcno
Dim g_szBankAcntNm

Dim g_szLNKD_BANK_CLS_CODE 
Dim g_szTR_DATE            
Dim g_szOTSD_TR_UNIQ_NO    
Dim g_szTACT_LNKD_ISTU_CODE
Dim g_szTACT_STND_TR_CODE  
Dim g_szLNKD_TLMS_MNNO     
Dim g_szRcvn_iqry_tmnu     

Dim g_nTranIndex
Dim g_szTransInfo1
Dim g_szTransInfo2
Dim g_szTransInfo3
Dim g_szTransInfo4
Dim g_szTransInfo5

Dim g_szAlias
Dim g_szCertUserType

'============================================================================
Sub Form_OnFormInitBefore()
	imgLogo.setMaintainingRatio("1")
	imgBack.setMaintainingRatio("1")
	imgInfo.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_szSeparator = "★"

	szData = Form.GetOpenLinkData()
	
	if szData <> "" and szData <> null then
		arrTransInfo = Split(szData, "♥")
		g_nTranIndex = CInt(arrTransInfo(0))
		g_szTransInfo1 = arrTransInfo(1)
		g_szTransInfo2 = arrTransInfo(2)
		g_szTransInfo3 = arrTransInfo(3)
		g_szTransInfo4 = arrTransInfo(4)
		g_szTransInfo5 = arrTransInfo(5)
		
		if g_nTranIndex > 1 then
			contDirectTrans.visible = "1"
			if (g_nTranIndex-1) == 1 then
				contDirectTrans.imgBg.imgpath = "icon_tact_acpt_1.png"
			elseif (g_nTranIndex-1) == 2 then
				contDirectTrans.imgBg.imgpath = "icon_tact_acpt_2.png"
			elseif (g_nTranIndex-1) == 3 then
				contDirectTrans.imgBg.imgpath = "icon_tact_acpt_3.png"
			elseif (g_nTranIndex-1) == 4 then
				contDirectTrans.imgBg.imgpath = "icon_tact_acpt_4.png"
			end if
		end if
		
		f_SetRecieveText()
		f_SetRecieveScreen("1", "")
	end if

End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	Form.SendReturnToParent(sKeyName , sRet)
	Form.CloseForm()
End Sub


'============================================================================
Sub Form_OnTimerEvent(sTimerID)
     '수취조회
	if trim(sTimerID) == "1" then
		Form.SetTimerEvent2(1,0,0)
		
		DATAMANAGER.RequestTranData( "obtss_elbs_221r" )
		
	elseif trim(sTimerID) == "9999" then 'remove
		Form.removeWaitCursor()
		Form.SetTimerEvent(9999,0,1)
	end if

End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	szACNO = acntList.total
	szASNO = acntList.sequence

	'타행이체 수취조회 전문발송 ( 당행도 가능 )
	if szTranID == "obtss_elbs_121r" then
		szTransInfo = f_GetTransInfoItem(g_nTranIndex)
		arrTransInfo = Split(szTransInfo, g_szSeparator)
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "MNRC_BANK_CODE"		, 0 , arrTransInfo(0)	) '입금은행코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "JOB_TRNO"			, 0 , "031"			) '작업단말번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "MNRC_ACNO"			, 0 , arrTransInfo(1)	) '입금계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "TR_AMT"			, 0 , "1"			) '거래금액
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "DRNG_ACNO"			, 0 , szACNO			) '출금계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNT_PROD_CLS_CODE" , 0 , szASNO			) '계좌상품구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "PWD"				, 0 , ""				) '비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "RMRK"				, 0 , "N"			) '비고  ( N:비밀번호 스킵 )

		Form.addWaitCursor()
		
	'타행이체 수취조회 응답수신 ( 타행만 호출 )
	elseif szTranID == "obtss_elbs_221r" then
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "LNKD_BANK_CLS_CODE" , 0, g_szLNKD_BANK_CLS_CODE  )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TR_DATE"            , 0, g_szTR_DATE             )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "OTSD_TR_UNIQ_NO"    , 0, g_szOTSD_TR_UNIQ_NO     )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TACT_LNKD_ISTU_CODE", 0, g_szTACT_LNKD_ISTU_CODE )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TACT_STND_TR_CODE"  , 0, g_szTACT_STND_TR_CODE   )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "LNKD_TLMS_MNNO"     , 0, g_szLNKD_TLMS_MNNO      )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "RPCS_TMNU"          , 0, g_szRcvn_iqry_tmnu      )
		
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "DRNG_ACNO"          , 0, szACNO      		   ) '계좌번호
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "ACNT_PROD_CLS_CODE" , 0, szASNO			   ) '계좌일련번호
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "PWD"                , 0, ""				   ) '비밀번호

	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	'타행이체 수취조회 전문발송
	if szTranID == "obtss_elbs_121r" then
	    if DATAMANAGER.GetDataMsgCode( szTranID ) == "6617" then  '처리 대기중입니다.
			g_szLNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_BANK_CLS_CODE" , 0 )
			g_szTR_DATE             = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TR_DATE"            , 0 )
			g_szOTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "OTSD_TR_UNIQ_NO"    , 0 )
			g_szTACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_LNKD_ISTU_CODE", 0 )
			g_szTACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_STND_TR_CODE"  , 0 )
			g_szLNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_TLMS_MNNO"     , 0 )

			Form.SetTimerEvent2(1,1,0.5) '처음은 0.5초 후 조회

			exit sub
		else
			szTransInfo = f_GetTransInfoItem(g_nTranIndex)
			arrTransInfo = Split(szTransInfo, g_szSeparator)
			
			if arrTransInfo(0) == "287" then
				g_szLNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_BANK_CLS_CODE" , 0 )
				g_szTR_DATE             = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TR_DATE"            , 0 )
				g_szOTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "OTSD_TR_UNIQ_NO"    , 0 )
				g_szTACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_LNKD_ISTU_CODE", 0 )
				g_szTACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_STND_TR_CODE"  , 0 )
				g_szLNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_TLMS_MNNO"     , 0 )
				
				g_szBankCode = arrTransInfo(0)
				g_szBankAcno = arrTransInfo(1)
				g_szBankName = arrTransInfo(2)
				g_szBankAcntNm = DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "ACNM", 0 )
				
'				szMsgCode = DATAMANAGER.GetDataMsgCode( szTranID )
'		
'				f_SetRecieveScreen("1", szMsgCode)
'				f_SetRecieveText()
				
				szTransInfo = f_GetTransInfoItem(g_nTranIndex)
				szData = g_szBankCode..g_szSeparator..g_szBankAcno..g_szSeparator..g_szBankName..g_szSeparator..g_szBankAcntNm .. g_szSeparator .. "0" .. g_szSeparator .. "0"

				f_SetTransInfoItem(szData, g_nTranIndex)
				
				f_SetRecieveText()
				
			end if
			Form.SetTimerEvent(9999, 1, 1) 'remove
		end if

	'타행이체 수취조회 응답수신	
	elseif szTranID == "obtss_elbs_221r" then
		if DATAMANAGER.GetDataMsgCode( szTranID ) == "6617" then  '처리 대기중입니다.
			g_szLNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_BANK_CLS_CODE" , 0 )
			g_szTR_DATE             = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TR_DATE"            , 0 )
			g_szOTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "OTSD_TR_UNIQ_NO"    , 0 )
			g_szTACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_LNKD_ISTU_CODE", 0 )
			g_szTACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_STND_TR_CODE"  , 0 )
			g_szLNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_TLMS_MNNO"     , 0 )
		    
		    	g_szRcvn_iqry_tmnu = g_szRcvn_iqry_tmnu + 1 '수취조회횟수 증가
			
			if g_szRcvn_iqry_tmnu < 5 then '5초 MAX
				SLEEP_SEC = g_szRcvn_iqry_tmnu
			else
				SLEEP_SEC = 5
			end if
		    
			g_TRAN_ID = szTranID
			Form.SetTimerEvent2(1,1,SLEEP_SEC)
			
			exit sub
		else
			
			Form.SetTimerEvent(9999, 1, 1) 'remove
	
			szTransInfo = f_GetTransInfoItem(g_nTranIndex)
			arrTransInfo = Split(szTransInfo, g_szSeparator)
			g_szBankCode = arrTransInfo(0)
			g_szBankAcno = arrTransInfo(1)
			g_szBankName = arrTransInfo(2)
			g_szBankAcntNm = DATAMANAGER.GetDataValue (0, "obtss_elbs_221r", "OutBlock1", "ACNM", 0 )
			szBankName = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "TACT_BANK_NAME", 0)
			if szBankName <> "" then
				g_szBankName = szBankName
			end if
			
			szMsgCode = DATAMANAGER.GetDataMsgCode( szTranID )

'			f_SetRecieveScreen("1", szMsgCode)
'			f_SetRecieveText()
			
			g_szFee = DATAMANAGER.GetDataValue( 0, "obtss_elbs_221r", "OutBlock1", "FEE" , 0 )
			
			szTransInfo = f_GetTransInfoItem(g_nTranIndex)
			szData = g_szBankCode..g_szSeparator..g_szBankAcno..g_szSeparator..g_szBankName..g_szSeparator..g_szBankAcntNm .. g_szSeparator .. "0" .. g_szSeparator .. g_szFee
			
			f_SetTransInfoItem(szData, g_nTranIndex)
			
			f_SetRecieveText()
			
		end if

	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Form.ShowAlert(szTranID, szErrMsg)
	if szTranID == "obtss_elbs_121r" or szTranID == "obtss_elbs_221r" then
		Form.SetTimerEvent(9999, 1, 1) 'remove
		
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

		if szSubErr <> "" and szSubErr <> null then
			szErrMsg = szErrMsg.."("..szSubErr..")"
		end if
		
		Form.MsgBox( "알림", szErrMsg, "", 6 )
		lblRecName.caption = ""
		f_SetRecieveScreen("0", "")
	 end if
End Sub

'============================================================================
Sub f_SetTransInfoItem(szData, nIndex)
	if nIndex == 1 then
		g_szTransInfo1 = szData
	elseif nIndex == 2 then
		g_szTransInfo2 = szData
	elseif nIndex == 3 then
		g_szTransInfo3 = szData
	elseif nIndex == 4 then
		g_szTransInfo4 = szData
	elseif nIndex == 5 then
		g_szTransInfo5 = szData
	end if
End Sub

'============================================================================
Function f_GetTransInfoItem(nIndex)
	if nIndex == 1 then
		Return g_szTransInfo1
	elseif nIndex == 2 then
		Return g_szTransInfo2
	elseif nIndex == 3 then
		Return g_szTransInfo3
	elseif nIndex == 4 then
		Return g_szTransInfo4
	elseif nIndex == 5 then
		Return g_szTransInfo5
	end if
End Function

'============================================================================
Sub f_SetRecieveScreen(szVisible, szMsgCode)
	if szMsgCode <> "4941" then
		lblRecName.visible = szVisible
		lblRecText.visible = szVisible
	end if
End Sub

'============================================================================
Sub f_SetRecieveText()
	szTransInfo = f_GetTransInfoItem(g_nTranIndex)
	arrTransInfo = Split(szTransInfo, g_szSeparator)
	
	imgLogo.imgpath = "bank"..arrTransInfo(0)..".png"
	edtRecAcno.caption = arrTransInfo(1)
	lblBankName.caption = arrTransInfo(2)
	lblRecName.caption = arrTransInfo(3)
	
	if arrTransInfo(3) == "9432_TAX" then
		lblRecText.visible = "0"
		lblRecName.visible = "0"
	end if
End Sub


'============================================================================
' 입금계좌 은행 입력 부분 클릭
'============================================================================
Sub btnSelectBank_OnClick()
	szTransInfo = f_GetTransInfoItem(g_nTranIndex)
	arrTransInfo = Split(szTransInfo, g_szSeparator)
	
	szData = arrTransInfo(0)..g_szSeparator..arrTransInfo(1)..g_szSeparator..arrTransInfo(2)..g_szSeparator.."SelectBank"
	
	Form.OpenPopupAnimation("mbbnk63010_p3", szData , "","2")
End Sub

'============================================================================
' 입금계좌번호 입력 부분 클릭
'============================================================================
Sub btnRecAcno_OnClick()
	szTransInfo = f_GetTransInfoItem(g_nTranIndex)
	arrTransInfo = Split(szTransInfo, g_szSeparator)
	szData = arrTransInfo(0)..g_szSeparator..arrTransInfo(1)..g_szSeparator..arrTransInfo(2)..g_szSeparator.."EditAcno"
	
	Form.OpenPopupAnimation("mbbnk63010_p3", szData , "","2")
End Sub

'============================================================================
' 입금계좌 입력 완료 후 확인 버튼
'============================================================================
Sub btnConfirm_OnClick()
	szData = g_nTranIndex.."♥"..
			g_szTransInfo1.."♥"..
			g_szTransInfo2.."♥"..
			g_szTransInfo3.."♥"..
			g_szTransInfo4.."♥"..
			g_szTransInfo5
			
	Form.OpenPopup("mbbnk63010_s2", szData , "")
End Sub

'============================================================================
Sub imgBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgInfo_OnClick()
	Form.OpenPopup("mbbnk63010_p11" , "" , "")
End Sub

'============================================================================
Sub contDirectTrans_imgBg_OnClick()
	nTranIndex = g_nTranIndex - 1
	szData = nTranIndex.."♥"..
			g_szTransInfo1.."♥"..
			g_szTransInfo2.."♥"..
			g_szTransInfo3.."♥"..
			g_szTransInfo4.."♥"..
			g_szTransInfo5.."♥".."DirectTrans"
			
	Form.OpenPopup("mbbnk63010_s2", szData , "")
End Sub

'============================================================================
Sub btnBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
    Form.removeWaitCursor()	
End Sub

