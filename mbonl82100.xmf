'============================================================================
Sub contScroll_btnDetail_OnClick()
	Form.OpenPopup("mbonl82100_p3", "", "")
End Sub

'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 신용거래약정
' 02. 화면설명 : 신용거래약정
' 03. 작    성 : 2022.09.04 이아영
' 04. 수    정 : v001. 2023.07.13 이학록 / 약정 처리 완료 후 금융상품 일련번호 채번 로직 호출
'-------------------------------------------------------------------------------------------
' 1.obacp_opop_065r 인지세납부계좌조회
' 2.obaci_acct_095r 약정가능여부 조회 신규 추가
' 3.oblon_basc_103r 대출kyc
' 4.oblon_basc_801r 약정등록조회
' 5.obcsb_acad_002r 연락처 조회 -> 법인이라면 obaci_acct_095r 연락처조회 추가

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_bContract  '대출구분 (01:신용)
Dim g_szTrData
Dim g_szASNO
Dim g_bChange
Dim g_szACNO
Dim szFnprJoinSrno
Dim g_FinCustomer           'v001

'============================================================================
Sub Form_OnFormInit()
	g_FinCustomer = "N"			'v001 변수 초기화 추가
	
	g_szACNO = Left(Account0.caption,8)
	DATAMANAGER.RequestTranData("obacp_opop_065r")
	
	'LHR 수정
	contScroll.Image0.setMaintainingRatio("1")
	contScroll.Image1.setMaintainingRatio("2")
	contScroll.Image2.setMaintainingRatio("2")
	contScroll.Image3.setMaintainingRatio("2")
	contScroll.Image4.setMaintainingRatio("2")
	contScroll.Image5.setMaintainingRatio("2")
	contScroll.imgQuestion.setMaintainingRatio("2")
	
	contScroll.Label0.bgcolor = "397"
	contScroll.Label1.fgcolor = "334"
	contScroll.Label2.fgcolor = "398"
	
	
	DATAMANAGER.RequestTranData( "obsap_acif_999a" ) '금융상품 일련번호 GET
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "End" then
		lnkMain.left = "375"
		lnkMain.linkfile = ""
		
		DATAMANAGER.RequestTranData("obacp_opop_065r")
		DATAMANAGER.RequestTranData( "obsap_acif_999a" ) '금융상품 일련번호 GET
		
	elseif sEventName == "Change" then
		if trim(sParam) ~= "" then
			lnkMain.linkfile = "mbonl82100_s1"
			g_szACNO = Left(sParam, 8)
			Account0.caption = sParam,
			g_szASNO = Right(sParam, 2)			
			g_bChange = true
			
			DATAMANAGER.RequestTranData("oblon_basc_801r")
			
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obacp_opop_065r" then
		DATAMANAGER.SetDataValue( 0, "obacp_opop_065r", "InBlock1", "ACNO" , 0 , g_szACNO )	

	elseif szTranID == "oblon_basc_801r" then		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801r", "InBlock1", "ACNO" , 0 , g_szACNO )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801r", "InBlock1", "ASNO" , 0 , g_szASNO )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801r", "InBlock1", "ACNT_PWD" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801r", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
	elseif szTranID	= "obsap_acif_999a" then
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obacp_opop_065r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, "obacp_opop_065r", "OutBlock1" )
		
		if nCnt > 0 then
			Dim ACNT_STAT_CODE, PRCD, ACNO, ASNO, CSNM, UI_INPR_NAME 
			
			for i = 0 to nCnt-1 
				ACNT_STAT_CODE = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "ACNT_STAT_CODE" , i )
				PRCD = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "PRCD" , i )
				
				if ACNT_STAT_CODE == "1" and PRCD == "100" or PRCD == "105" or PRCD == "106" or PRCD == "107" or PRCD == "119" then
					g_szASNO = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "ASNO" , i )
					Exit For
				else
					g_szASNO = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "ASNO" , 0 )
				end if
			next
		end if
		
		DATAMANAGER.RequestTranData("oblon_basc_801r")
		
	elseif szTranID == "oblon_basc_801r" then
	
		Dim szLoanData 
		Dim sUI_PROD_OPNG_YN1, sUI_PROD_OPNG_YN2
		sUI_PROD_OPNG_YN1 = DATAMANAGER.GetDataValue( 0, "oblon_basc_801r", "OutBlock2", "UI_PROD_OPNG_YN1" , 0 ) '담보관련통보방법 SMS
		sUI_PROD_OPNG_YN2 = DATAMANAGER.GetDataValue( 0, "oblon_basc_801r", "OutBlock2", "UI_PROD_OPNG_YN2" , 0 ) '담보관련통보방법 E-mail
		
		szLoanData = sUI_PROD_OPNG_YN1.."★"..sUI_PROD_OPNG_YN2
		
		Dim nCnt 
		nCnt = DATAMANAGER.GetDataCount( 0, "oblon_basc_801r", "OutBlock1" )
		
		if nCnt > 0 then
			if nCnt > 2 then
				nCnt = 2
			end if
		
			Dim CANC_YN, LIMT_AMT, REG_DATE
			for i = 0 to nCnt-1
				CANC_YN = DATAMANAGER.GetDataValue( 0, "oblon_basc_801r", "OutBlock1", "CANC_YN" , i ) '해지여부 0번째 인덱스 증권담보융자 / 1번쨰 인덱스 매도담보융자
				' 값이 "" or "Y"면 미등록, 나머지는 등록
				LIMT_AMT = trim(DATAMANAGER.GetDataValue( 0, "oblon_basc_801r", "OutBlock1", "LIMT_AMT" , i ) )'약정금액 매도담보융자는 약정금액없음
				REG_DATE = DATAMANAGER.GetDataValue( 0, "oblon_basc_801r", "OutBlock1", "REG_DATE" , i ) '약정일자
				
				szLoanData = szLoanData.."★"..CANC_YN.."☆"..LIMT_AMT.."☆"..REG_DATE
				
				if i == 0 then
					if CANC_YN == "" or CANC_YN == "Y" then
						btnBottom.caption = "담보대출약정 신청"
						g_bContract = false
					else
						btnBottom.caption = "신청정보 보기"
						g_bContract = true
					end if
				end if 
				
			next
		end if

		Dim NmetAcntYn, LoanGradCode, LoanGrad, LimtAmt, LimtAmt1
		NmetAcntYn   = DATAMANAGER.GetDataValue(0, "oblon_basc_801r", "OutBlock2", "NMET_ACNT_YN" , 0)
		LoanGradCode = DATAMANAGER.GetDataValue(0, "oblon_basc_801r", "OutBlock2", "LOAN_GRAD_CODE" , 0)
		LoanGrad     = Form.GetMetaData("대출등급코드", LoanGradCode)
		LimtAmt      = DATAMANAGER.GetDataValue(0, "oblon_basc_801r", "OutBlock2", "UI_LIMT_STND_AMT1" , 0)
		LimtAmt1     = LimtAmt/100000000
		
		if LimtAmt1 > 0 then
			LimtStndAmt = LimtAmt1 & " 억원"
		else
			LimtStndAmt = FormatNumber(LimtAmt, 0) & " 원"
		end if
		
		if NmetAcntYn = "Y" then
			sMseg = "이벤트 계좌인 경우 한도증액이 불가할 수 있으니, 약정금액 설정에 유의하여 주시기 바랍니다\n" & "현재기준 귀하의 총 신용공여한도는 " & LimtStndAmt & "( " & LoanGrad & " ) 입니다.\n\n" & "* 한도는 매월 산정되는 대출등급에 따라 변경될 수 있습니다."
			Form.ShowAlert("안내", sMseg)
		end if
		'LHR 추가 szCustClsCode
		szCustClsCode = DATAMANAGER.GetDataValue(0, "oblon_basc_801r", "OutBlock2", "CUST_CLS_CODE", 0)
		g_szTrData = g_szACNO..g_szASNO.."★"..szLoanData.."★"..szCustClsCode.."★"..szFnprJoinSrno

		if g_bChange == true then
			g_bChange = false
			lnkMain.left = "0"
			Form.triggerEvent("lnkMain", "InitChange", g_szTrData) ' 등록여부, 기본형투자형, SMS, Email	
			
			szFnprJoinSrno = ""
			g_FinCustomer = "N"
		end if
	elseif szTranID	= "obsap_acif_999a" then
'		Dim szFnprJoinSrno
		szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		
		Form.SetSharedData( "FNPR_JOIN_SRNO", szFnprJoinSrno )
		Form.SetSharedData( "LoanYN", "Y" )
		Form.OpenPopup("mbonl81010_p20" , "" , "")
	end if
End Sub

'============================================================================
Sub btnBottom_OnClick()
	If g_FinCustomer <> "Y" Then
		Form.MsgBox("알림", "전문, 일반 금융소비자를 확인 바랍니다.", "Show_mbonl81010", "1")
'		Form.OpenMainMenuWithIndex(0,1,0)
		Exit Sub		
	End If
	
	if g_bContract == true then
		lnkMain.linkfile = "mbonl82100_s3"
		Form.triggerEvent("lnkMain", "Init", g_szTrData) 
	else	
		lnkMain.linkfile = "mbonl82100_s1"
		g_szTrData = g_szACNO..g_szASNO.."★"..szFnprJoinSrno
		Form.triggerEvent("lnkMain", "Init", g_szTrData) ' 등록여부, 기본형투자형, SMS, Email	
		
		szFnprJoinSrno = ""
		g_FinCustomer = "N"
	end if
	
	lnkMain.left = "0"	
End Sub 


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSub
	szSub = DATAMANAGER.GetDataMsgSubText( szTranID)
	
	if trim(szSub) <> "" then
		szErrMsg = szErrMsg.."\n"..szSub
	end if
	Form.ShowAlert("알림", szErrMsg)
End Sub
'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData( "FNPR_JOIN_SRNO", "" )
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "Show_mbonl81010" then
		if sRet == "ok" then
			Form.OpenPopup("mbonl81010_p20" , "" , "")
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			g_FinCustomer = "Y"
		elseif sRet == "CANCEL_mbonl81010_p20" then
			g_FinCustomer = "N"
		end if
	end if
End Sub

