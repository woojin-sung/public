'============================================================================
' 화 면 명 : 대주주문_미체결팝업
' 화면설명 : 주식주문 정정/취소화면에서 미체결버튼 클릭시 오픈
' 작    성 : 2021.11.30 ~ 2021.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_Tab
Dim g_szOpen '20181210_01 KBC

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	Dim tData
	
	Form.SetScreenName("대주주문 미체결")	

	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if
	
	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)
		g_Tab      = tData(2)
		g_szGbn    = tData(3)
		
'		DATAMANAGER.RequestTranData("obtrs_comn_612r")
		DATAMANAGER.RequestTranData("obtrs_cntg_638r")
		
		'20181210_01 KBC START
		g_szOpen = szOpen 
		
'		if g_Tab == "3" then '취소주문탭
'			btnOrdCancel.visible = true
'			grdList.height = 560
'		end if
		'20181210_01 KBC END
		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szDate
	'일자변수 변경 20160810 (HOST_DATE==>BIZ_DT)
	'szDate = Form.GetSharedData("&HOST_DATE", false)  
	szDate = Form.GetSharedData("&BIZ_DT", false)
	
	grdList.rowcount = 0
	
	' ----------------------------------------------------------------------
	' 주문체결내역 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtrs_comn_612r" then		
		
		DATAMANAGER.ClearInputData(0, "obtrs_comn_612r")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_612r", "InBlock1", "ACNO"         , 0, g_szAcnt)		' 계좌번호
		DATAMANAGER.SetDataValue(0, "obtrs_comn_612r", "InBlock1", "ASNO"         , 0, g_szAcntCd)		' 계좌일련번호
		DATAMANAGER.SetDataValue(0, "obtrs_comn_612r", "InBlock1", "ODER_DATE"    , 0, szDate)			' 주문일자
		DATAMANAGER.SetDataValue(0, "obtrs_comn_612r", "InBlock1", "DEAL_CLS_CODE", 0, "0")			' 매매구분코드(0:전체, 1:매수, 2:매도)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_612r", "InBlock1", "CNTG_CLS_CODE", 0, "2")			' 체결구분코드(0:전체, 1:체결, 2:미체결)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_612r", "InBlock1", "UI_SORT_STND_CODE", 0 , "1" )		'1:역순
		
	Elseif szTranID == "obtrs_cntg_638r" then
		DATAMANAGER.ClearInputData(0, "obtrs_cntg_638r")
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "ACNO"			, 0 , g_szAcnt   )
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "ASNO"			, 0 , g_szAcntCd )
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "ODER_DATE"		, 0 , szDate     )
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "DEAL_CLS_CODE"	, 0 , "0" )' 매매구분코드(0:전체, 1:매수, 2:매도)
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "CNTG_CLS_CODE"	, 0 , "2" )' 체결구분코드(0:전체, 1:체결, 2:미체결)
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "IQRY_CLS_CODE"	, 0 , "9" )'9:대주종목
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "PROS_CLS"		, 0 , "2" )
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "DATA_CLS"		, 0 , "0" )
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iCnt, szData, szData2
	Dim szItem, szMarket
	
	' ----------------------------------------------------------------------
	' 주문체결내역 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtrs_comn_612r" OR szTranID == "obtrs_cntg_638r" then	
		For iCnt = grdList.rowcount - 1 To 0 Step -1
			szItem = grdList.GetCellData( "bd_Cd", iCnt)
			szMarket = Trim(Form.GetItemCodeInfo(szItem, "market"))
			
'			If szMarket = "BN" or szMarket = "MM" Then
'				grdList.SetDeleteRow( iCnt )
'			Else
		
				'매매구분
				szData = grdList.GetCellData( "bd_TypeCd", iCnt)
				szData2 = grdList.GetCellData( "bd_EditDelType", iCnt)	'정정/취소구분(1신규,2정정, 3취소)
				szData3	= grdList.GetCellData( "bd_cell0", iCnt)		'신용주문구분코드
				szData4	= grdList.GetCellData( "bd_cell1", iCnt) 		'대출상세유형코드
						
				If szData2 = "1" Then									'정상
					Select Case szData3				'보통
						Case "10"
							If szData = "1" Then
								If szData4 = "0201" Then
									grdList.SetCellData("bd_TypeNm", iCnt, "예탁담보매도")
								Else
									grdList.SetCellData("bd_TypeNm", iCnt, "매도")
								End If
								grdList.SetCellFgColor("bd_TypeNm", iCnt, "11")
							Else
								grdList.SetCellData("bd_TypeNm", iCnt, "매수")
								grdList.SetCellFgColor("bd_TypeNm", iCnt, "10")
							End If
						
						Case "21", "31"								'신용매수
							grdList.SetCellData("bd_TypeNm", iCnt, "신용매수")
							grdList.SetCellFgColor("bd_TypeNm", iCnt, "10")
						
						Case "22", "32"								'신용매도
							grdList.SetCellData("bd_TypeNm", iCnt, "신용매도")
							grdList.SetCellFgColor("bd_TypeNm", iCnt, "11")
						
						Case "23", "33"								'대주매도
							grdList.SetCellData("bd_TypeNm", iCnt, "대주매도")
							grdList.SetCellFgColor("bd_TypeNm", iCnt, "11")
		
						Case "24", "34"								'대주매수
							grdList.SetCellData("bd_TypeNm", iCnt, "대주매수")
							grdList.SetCellFgColor("bd_TypeNm", iCnt, "10")
						
					End Select
				ElseIf szData2 = "2" Then								'정정
					If szData = "1" Then
						grdList.SetCellData("bd_TypeNm", iCnt, "매도정정")
						grdList.SetCellFgColor("bd_TypeNm", iCnt, "11")
					Else
						grdList.SetCellData("bd_TypeNm", iCnt, "매수정정")
						grdList.SetCellFgColor("bd_TypeNm", iCnt, "10")
					End If
					
				ElseIf szData2 = "3" Then								'취소
					If szData = "1" Then
						grdList.SetCellData("bd_TypeNm", iCnt, "매도취소")
						grdList.SetCellFgColor("bd_TypeNm", iCnt, "11")
					Else
						grdList.SetCellData("bd_TypeNm", iCnt, "매수취소")
						grdList.SetCellFgColor("bd_TypeNm", iCnt, "10")
						
					End If
				End If
				
'				'주문종류
'				szData = grdList.GetCellData( "bd_OdrType", iCnt)
'				Select Case szData
'					Case "01" grdList.SetCellData("bd_OdrTypeNm", iCnt, "보통")
'					Case "05" grdList.SetCellData("bd_OdrTypeNm", iCnt, "시장가")
'					Case "06" grdList.SetCellData("bd_OdrTypeNm", iCnt, "조건부지정가")
'					Case "09" grdList.SetCellData("bd_OdrTypeNm", iCnt, "자기주식")
'					Case "10" grdList.SetCellData("bd_OdrTypeNm", iCnt, "S-OPTION 자기주식")
'					Case "11" grdList.SetCellData("bd_OdrTypeNm", iCnt, "금전신탁자기주식")
'					Case "12" grdList.SetCellData("bd_OdrTypeNm", iCnt, "최유리 지정가")
'					Case "13" grdList.SetCellData("bd_OdrTypeNm", iCnt, "최우선 지정가")
'					Case "20" grdList.SetCellData("bd_OdrTypeNm", iCnt, "코넥스 경매매")
'					Case "51" grdList.SetCellData("bd_OdrTypeNm", iCnt, "장중 대량매매")
'					Case "52" grdList.SetCellData("bd_OdrTypeNm", iCnt, "장중 바스켓 매매")
'					Case "53" grdList.SetCellData("bd_OdrTypeNm", iCnt, "장중 경쟁 대량매매")
'					Case "61" grdList.SetCellData("bd_OdrTypeNm", iCnt, "장개시전 시간외종가")
'					Case "62" grdList.SetCellData("bd_OdrTypeNm", iCnt, "장개시전 시간외대량")
'					Case "63" grdList.SetCellData("bd_OdrTypeNm", iCnt, "장개시전 시간외 바스켓")
'					Case "64" grdList.SetCellData("bd_OdrTypeNm", iCnt, "장개시전 시간외 경쟁 대량매매")
'					Case "67" grdList.SetCellData("bd_OdrTypeNm", iCnt, "장개시전 시간외대량 자사주 신탁")
'					Case "69" grdList.SetCellData("bd_OdrTypeNm", iCnt, "장개시전 시간외대량 자사주")
'					Case "71" grdList.SetCellData("bd_OdrTypeNm", iCnt, "시간외 종가")
'					Case "72" grdList.SetCellData("bd_OdrTypeNm", iCnt, "시간외 종가 대량매매")
'					Case "77" grdList.SetCellData("bd_OdrTypeNm", iCnt, "금전신탁자기주식 시간외 대량매매")
'					Case "79" grdList.SetCellData("bd_OdrTypeNm", iCnt, "자기주식 시간외 대량매매")
'					Case "80" grdList.SetCellData("bd_OdrTypeNm", iCnt, "시간외 바스켓")
'					Case "81" grdList.SetCellData("bd_OdrTypeNm", iCnt, "시간외 단일가")
'					Case "X1" grdList.SetCellData("bd_OdrTypeNm", iCnt, "ECN")
'				End Select
				
				'처리구분
				szData = grdList.GetCellData( "bd_ProcCd", iCnt)
				
				Select Case szData
					Case "0" grdList.SetCellData("bd_ProcNm", iCnt, "미접수")
					Case "1" grdList.SetCellData("bd_ProcNm", iCnt, "접수")
					Case "2" grdList.SetCellData("bd_ProcNm", iCnt, "확인")
					Case "3" grdList.SetCellData("bd_ProcNm", iCnt, "거부")
					Case "4" grdList.SetCellData("bd_ProcNm", iCnt, "PT효력정지")
				End Select
'			End If
		Next
	end if
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szOdrNo, szOdrType, szOdrPrc, szClsCd, szDate, szData
	
	if lRow > -1 then
		szCd      = grdList.GetCellData("bd_Cd",       lRow)
		szQty     = grdList.GetCellData("bd_MicheQty", lRow)
		szOdrNo   = grdList.GetCellData("bd_OdrNo",    lRow)	
		szOdrType = grdList.GetCellData("bd_OdrType",  lRow)
		szOdrPrc  = grdList.GetCellData("bd_OdrPrc",   lRow)
		szClsCd   = grdList.GetCellData("bd_ClsCd",    lRow)
		szDate    = grdList.GetCellData("bd_LoanDate", lRow)
		
		szMk = Form.GetItemCodeInfo(szCd, "market")
		
		'20180719 LES START - KOTC시장(T) 추가
		if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then		
			' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
			szData = "미체결" & "★" & g_Tab & "★" & szCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd
		
			Form.SendReturnToParent("16000_CONTRACT", szData)
			Form.CloseForm()
		else
			szCutCd = Mid(szCd, 2, Len(szCd))
			szMk = Form.GetItemCodeInfo(szCutCd, "market")
			
			'20180719 LES START - KOTC시장(T) 추가
			if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then
				' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
				szData = "미체결" & "★" & g_Tab & "★" & szCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd

				Form.SendReturnToParent("16000_CONTRACT", szData)
				Form.CloseForm()			
			else
				Form.ShowAlert("알림", "선택하신 상품은 MTS에서는 거래가 불가능한 상품입니다.")
			end if
		end if
	end if	
End Sub

