--===========================================================================
Dim g_CalTogleFlag '1일별 2월별
Dim g_isCalTogle	 '1토글 2달력
Dim g_DealTogleFlag'1매매 2매수 3매도
Dim g_IOTogleFlag  '1입출 2입금 3출금

'============================================================================
Sub Form_OnFormInit()
	Label1.caption  = "※일별 : 최근 2년 이내 조회가능\n    월별 : 2008년 2월 이후 조회가능"
	g_CalTogleFlag  = "1"
	g_isCalTogle    = "2"
	g_DealTogleFlag = "1"
	g_IOTogleFlag   = "1"
	
	SetGrid()
	SetControl()
	
	RequestTR()
	
End Sub 


'============================================================================
Sub LblTogle_OnClick()
	if g_CalTogleFlag = "1" then
		g_CalTogleFlag = "2"
		

		SetControl()
	elseif g_CalTogleFlag = "2" then
		g_CalTogleFlag = "1"
		
		
		SetControl()
	else
		Form.ShowAlert("오류", "유효하지않은 구분값입니다.")
		exit sub
	end if
	
	RequestTR()
End Sub
'============================================================================
Sub SetControl()
	g_isCalTogle   = "1"
	
	if g_CalTogleFlag = "1" then
		LblTogle.caption = "일별"
		
		Calendar0.visible = true
		Calendar1.visible = true
		
		Calendar0.dispmode = false
		Calendar1.dispmode = false
		
		Calendar0.todaymode = true
		Calendar1.todaymode = true
		
		Calendar2.visible = false
		Calendar3.visible = false
		
		Grid0.SetCellIDMaskInfo("bd_cell0", "1,0, , ,1,####/##/##,0,0,0")
	else
		LblTogle.caption = "월별"

		Calendar0.visible = true
		Calendar1.visible = true
		
		Calendar0.dispmode = true
		Calendar1.dispmode = true
		
		Calendar0.todaymode = true
		Calendar1.todaymode = true
		
		Calendar2.visible = false
		Calendar3.visible = false
		
         Grid0.SetCellIDMaskInfo("bd_cell0", "1,0, , ,1,####/##,0,0,0")
	end if
	
	
	
End Sub
'============================================================================
Sub RequestTR()
	 Grid0.SetClear()
	 DATAMANAGER.ClearInputData(0, "obacb_balc_105r")
	 Dim szACNO, szASNO
	 
	 szACNO = Form.GetCtlProp("Account0", "total")
	 szASNO = Form.GetCtlProp("Account0", "sequence")
	 
	
	 DATAMANAGER.SetDataValue(0, "obacb_balc_105r" , "InBlock1" , "WRAP_ACNT_YN" , 0 , "N")
	 DATAMANAGER.SetDataValue(0, "obacb_balc_105r" , "InBlock1" , "ACNO" 	, 0 , szACNO)
	 DATAMANAGER.SetDataValue(0, "obacb_balc_105r" , "InBlock1" , "ASNO" 	, 0 , szASNO)
	 DATAMANAGER.SetDataValue(0, "obacb_balc_105r" , "InBlock1" , "ACNT_PWD" , 0 , ""	   )
	 
	 DATAMANAGER.RequestTranData("obacb_balc_105r")
	 
	 g_isCalTogle   = "2"
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obacb_balc_105r" then
		szACNO = Form.GetCtlProp("Account0", "total")
		szASNO = Form.GetCtlProp("Account0", "sequence")
		
		DATAMANAGER.SetDataValue(0, "ooase_erma_012r", "InBlock1", "ACNO" , 0 , szACNO)
		DATAMANAGER.SetDataValue(0, "ooase_erma_012r", "InBlock1", "ASNO" , 0 , szASNO)
		
		if g_CalTogleFlag = "1" then
			DATAMANAGER.SetDataValue(0, "ooase_erma_012r", "InBlock1", "DATE_CLS_CODE" , 0 , "01")
			DATAMANAGER.SetDataValue(0, "ooase_erma_012r", "InBlock1", "STA_DATE" 	  , 0 , Calendar0.caption)
			DATAMANAGER.SetDataValue(0, "ooase_erma_012r", "InBlock1", "FIN_DATE" 	  , 0 , Calendar1.caption)
		else
			DATAMANAGER.SetDataValue(0, "ooase_erma_012r", "InBlock1", "DATE_CLS_CODE" , 0 , "02")
			DATAMANAGER.SetDataValue(0, "ooase_erma_012r", "InBlock1", "STA_YYMM" 	  , 0 , Calendar0.caption)
			DATAMANAGER.SetDataValue(0, "ooase_erma_012r", "InBlock1", "FIN_YYMM" 	  , 0 , Calendar1.caption)
		end if

		
		TDAY_VLTN_AMT = DATAMANAGER.GetDataValue(0,  "obacb_balc_105r", "OutBlock1", "VLTN_AMT", 0)
		
		DATAMANAGER.SetDataValue(0,  "ooase_erma_012r", "InBlock1", "TDAY_VLTN_AMT"	, 0 , TDAY_VLTN_AMT)
		DATAMANAGER.SetDataValue(0,  "ooase_erma_012r", "InBlock1", "ACNT_PWD"	  	, 0 , "")
		DATAMANAGER.SetDataValue(0,  "ooase_erma_012r", "InBlock1", "UI_CHCK_CLS"	, 0 , "Y")
		DATAMANAGER.SetDataValue(0,  "ooase_erma_012r", "InBlock1", "UI_SORT_CLS_VAL"	, 0 , "0")
		
		DATAMANAGER.RequestTranData("ooase_erma_012r")
		
	elseif szTranID = "ooase_erma_012r" then
'		Dim rowcnt
'		Dim datacnt 
'		Dim nIndex
'		
'		rowcnt = Grid0.rowcount
'		datacnt = DATAMANAGER.GetDataCount(0, "ooase_erma_012r", "OutBlock1")
'		msgbox datacnt
'		nIndex = 0
'		
'		for i = rowcnt to rowcnt + datacnt - 1
'			Grid0.AddRow()
'			
'			Grid0.SetCellData("bd_cell0" , i, DATAMANAGER.GetDataValue(0, "ooase_erma_012r" , "OutBlock1" , "STND_DATE" 	       , nIndex))
'			Grid0.SetCellData("bd_cell1" , i, DATAMANAGER.GetDataValue(0, "ooase_erma_012r" , "OutBlock1" , "PRLS_AMT" 				   , nIndex))
'			Grid0.SetCellData("bd_cell2" , i, DATAMANAGER.GetDataValue(0, "ooase_erma_012r" , "OutBlock1" , "PLRT" 							 , nIndex))
'			Grid0.SetCellData("bd_cell3" , i, DATAMANAGER.GetDataValue(0, "ooase_erma_012r" , "OutBlock1" , "ACML_VLTN_PRLS_AMT" , nIndex))
'			Grid0.SetCellData("bd_cell4" , i, DATAMANAGER.GetDataValue(0, "ooase_erma_012r" , "OutBlock1" , "ACML_ERT" , nIndex)          )
'			Grid0.SetCellData("bd_cell5" , i, DATAMANAGER.GetDataValue(0, "ooase_erma_012r" , "OutBlock1" , "VLTN_AMT" , nIndex)          )
'			Grid0.SetCellData("bd_cell6" , i, DATAMANAGER.GetDataValue(0, "ooase_erma_012r" , "OutBlock1" , "DEAL_AMT" , nIndex)          )
'			Grid0.SetCellData("bd_cell7" , i, DATAMANAGER.GetDataValue(0, "ooase_erma_012r" , "OutBlock1" , "BYOV_AMT" , nIndex)          )
'			Grid0.SetCellData("bd_cell8" , i, DATAMANAGER.GetDataValue(0, "ooase_erma_012r" , "OutBlock1" , "SELN_AMT" , nIndex)          )
'			Grid0.SetCellData("bd_cell9" , i, DATAMANAGER.GetDataValue(0, "ooase_erma_012r" , "OutBlock1" , "IO_AMT" , nIndex)            )
'			Grid0.SetCellData("bd_cell10", i, DATAMANAGER.GetDataValue(0, "ooase_erma_012r" , "OutBlock1" , "RCAM" 	 , nIndex)            )
'			Grid0.SetCellData("bd_cell11", i, DATAMANAGER.GetDataValue(0, "ooase_erma_012r" , "OutBlock1" , "AMDR"   , nIndex)            )
'
'			
'			nIndex = nIndex + 1
'		next
	end if
End Sub

'============================================================================
Sub Calendar0_OnEditComplete()
	if g_isCalTogle = "2" then
		requestTR()
	end if
End Sub
'============================================================================
Sub Calendar1_OnEditComplete()
	if g_isCalTogle = "2" then
		requestTR()
	end if
End Sub
'============================================================================
Sub Account0_ChangeAccount()
	requestTR()
End Sub

'============================================================================
Sub Grid0_OnHeaderClickUp(lRow, szCellID)
	if szCellID = "th_cell6" then
		g_DealTogleFlag = "2"
	elseif szCellID = "th_cell8" then
		g_DealTogleFlag = "3"
	elseif szCellID = "th_cell9" then
		g_DealTogleFlag = "1"
	elseif szCellID = "th_cell7" then
		g_IOTogleFlag = "2"
	elseif szCellID = "th_cell10" then
		g_IOTogleFlag = "3"
	elseif szCellID = "th_cell11" then
		g_IOTogleFlag = "1"
	end if
	SetGrid()
End Sub
'============================================================================
Sub SetGrid()
	if g_DealTogleFlag = "1" then
		Grid0.SetVisibleCol(6, TRUE)
		Grid0.SetVisibleCol(7, FALSE)
		Grid0.SetVisibleCol(8, FALSE)
	elseif g_DealTogleFlag = "2" then
		Grid0.SetVisibleCol(6, FALSE)
		Grid0.SetVisibleCol(7, TRUE)
		Grid0.SetVisibleCol(8, FALSE)
	elseif g_DealTogleFlag = "3" then
		Grid0.SetVisibleCol(6, FALSE)
		Grid0.SetVisibleCol(7, FALSE)
		Grid0.SetVisibleCol(8, TRUE)
	end if
	
	if g_IOTogleFlag = "1" then
		Grid0.SetVisibleCol(9, TRUE)
		Grid0.SetVisibleCol(10, FALSE)
		Grid0.SetVisibleCol(11, FALSE)
	elseif g_IOTogleFlag = "2" then
		Grid0.SetVisibleCol(9, FALSE)
		Grid0.SetVisibleCol(10, TRUE)
		Grid0.SetVisibleCol(11, FALSE)
	elseif g_IOTogleFlag = "3" then
		Grid0.SetVisibleCol(9, FALSE)
