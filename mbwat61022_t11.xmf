	<SCRIPT_INFO _len="4240" _ulen="4110" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 
' 02. 화면설명 : 
' 03. 이    력 : 2023.11.10 : 고승연 : v0002 : 상품위험등급 구분 변경, obwat_pdad_065r IO 수정
'                2024.03.26 : 고승연 : v0004 : [T2402290007] obwat_pdad_065r IO 수정
'-------------------------------------------------------------------------------------------

dim g_szWA_PRCD, g_bConfirm, g_sDIV_GRP_CODE, g_sWA_OTCM_PAY_YN, g_nBASC_RMRT, g_nOTCM_PAY_SDRT, g_nOTCM_RMRT

'============================================================================
Sub Form_OnFormInitBefore()
	imgConfirm.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_szWA_PRCD = Form.GetSharedData("WA_PRCD", true)

	if g_szWA_PRCD <> null and g_szWA_PRCD <> "" then
		DATAMANAGER.RequestTranData("obwat_pdad_065r")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obwat_pdad_065r" then
		DATAMANAGER.SetDataValue(0, "obwat_pdad_065r", "InBlock1", "WA_PRCD" , 0 , g_szWA_PRCD)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_pdad_065r" then
		g_sDIV_GRP_CODE	= Trim(DATAMANAGER.GetDataValue(0, "obwat_pdad_065r", "OutBlock1", "DIV_GRP_CODE"		, 0))
		g_sWA_OTCM_PAY_YN	= Trim(DATAMANAGER.GetDataValue(0, "obwat_pdad_065r", "OutBlock1", "WA_OTCM_PAY_YN"	, 0))
		g_nBASC_RMRT		= Trim(DATAMANAGER.GetDataValue(0, "obwat_pdad_065r", "OutBlock1", "BASC_RMRT"		, 0))
		g_nOTCM_PAY_SDRT	= Trim(DATAMANAGER.GetDataValue(0, "obwat_pdad_065r", "OutBlock1", "OTCM_PAY_SDRT" 	, 0))
		g_nOTCM_RMRT		= Trim(DATAMANAGER.GetDataValue(0, "obwat_pdad_065r", "OutBlock1", "OTCM_RMRT" 		, 0))
		
		'체차적용인 경우
		if g_sDIV_GRP_CODE  = "A" or g_sDIV_GRP_CODE = "B" or g_sDIV_GRP_CODE = "C" then
			g_sDIV_GRP_CODE = "A"
		elseif g_sDIV_GRP_CODE  = "D" or g_sDIV_GRP_CODE = "E" or g_sDIV_GRP_CODE = "F" then
			g_sDIV_GRP_CODE = "D"
		else
			'수익금 비율인 경우
			if g_sDIV_GRP_CODE = "WA000355" then
				g_sDIV_GRP_CODE = "X"
			else
				'성과보수 없는경우
				if g_sWA_OTCM_PAY_YN = "Y" then
					g_sDIV_GRP_CODE = "Y"
				else
					g_sDIV_GRP_CODE = "N"
				end if
			end if
		end if
	
		'확인버튼 위치
'		if g_sDIV_GRP_CODE = "A" then
'			Image5.top = 310
'			lblConfirm.top = 308
'			imgConfirm.top = 321
'		elseif g_sDIV_GRP_CODE = "D" then
'			Image5.top = 330
'			lblConfirm.top = 328
'			imgConfirm.top = 341
'		else
'			Image5.top = 200
'			lblConfirm.top = 198
'			imgConfirm.top = 211
'		end if
		
		Dim nTop
		nTop = 65
		
		'보수테이블 위치
		if g_sDIV_GRP_CODE = "A" then
			TableA.left = 27
			TableA.top = nTop
			nTop = nTop + 233 + 50
		elseif g_sDIV_GRP_CODE = "D" then
			TableD.left = 27
			TableD.top = nTop
			nTop = nTop + 253 + 70
		elseif g_sDIV_GRP_CODE = "N" then
			TableOTCMPAYN.left = 27
			TableOTCMPAYN.top = nTop
			nTop = nTop + 113 + 30
			
			TableOTCMPAYN.SetCellString(0, 5, FormatNumber(g_nBASC_RMRT , 2 ))
		elseif g_sDIV_GRP_CODE = "Y" then
			TableOTCMPAYY.left = 27
			TableOTCMPAYY.top = nTop
			nTop = nTop + 153 + 10
			
			TableOTCMPAYY.SetCellString(0, 5, FormatNumber(g_nBASC_RMRT , 2 ))
			TableOTCMPAYY.SetCellString(5, 2, FormatNumber(g_nOTCM_PAY_SDRT , 2 ) & "%")
			TableOTCMPAYY.SetCellString(5, 5, FormatNumber(g_nOTCM_RMRT , 2 ))
		elseif g_sDIV_GRP_CODE = "X" then
			TableWA000355.left = 27
			TableWA000355.top = nTop
			nTop = nTop + 153 + 10
		end if
		
		imgBg.height = nTop - 41 + 15
		
		nTop = nTop - 5 - 33
		Image5.top = nTop
		imgConfirm.top = nTop + 10
		lblConfirm.top = nTop - 3
	end if
End Sub

'============================================================================
Sub lblConfirm_OnClick()

	if g_bConfirm then
		Image5.imgpath = "img_bgbox.9.png"
		lblConfirm.fgcolor = "004:000000000"
	else
		Image5.imgpath = "btn_15_n.9.png"
		lblConfirm.fgcolor = "062:255255255"
	end if
	g_bConfirm = not(g_bConfirm)
	
	Form.triggerEvent("#", "AGREE_PAY", g_bConfirm)
End Sub

