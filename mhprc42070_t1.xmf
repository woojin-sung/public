'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵현재가_호가
' 02. 화면설명 : 선옵현재가 호가탭화면
' 03. 작    성 : 2016.04.30 LJS
' 04. 참    고 : ohhts_3050_003r : 차트용 
'-------------------------------------------------------------------------------------------

Dim g_szItemCode, g_szItemMarket,g_szMask

Dim g_realLimit 	'[파생 실시간 가격 제한] 0: 실시간 상하한 적용, 1: 실시간 상하한 미적용 종목, 
				'					  2: 실시간 상하한 미적용 시간, 3: 실시간 상하한 KRX 적용 해제 시
Dim g_Rup

g_realLimit = 0
g_Rup = 1

Dim g_nPrice


'============================================================================
' 오른쪽 상단 테이블 Change
'============================================================================
Function Change_RightUp()

    If g_Rup = 3 Then		
	    g_Rup = 1
	Else
	    g_Rup = g_Rup + 1
	End If

    Set_RightUp()
    

End Function

'============================================================================
' 오른쪽 상단 테이블 setVisible
'============================================================================
Function Set_RightUp()
	
   
	    if g_Rup = 1 then
			tblFutRT1.visible = true
			tblFutRT2.visible = false
			ChartEx0.visible = false
			
		    
		elseif g_Rup = 2 then
		    tblFutRT1.visible = false
		    tblFutRT2.visible = true
		    ChartEx0.visible = false
		

		    
		elseif g_Rup = 3 then
		    tblFutRT1.visible = false
		    tblFutRT2.visible = false
		    ChartEx0.visible = true
		
		end if
    
End Function

'============================================================================
' 컨트롤 위치/보임 여부 설정
'============================================================================
Function FormInit()
	
	'오른쪽 상단
	tblFutRT1.left = 258
	tblFutRT2.left = 258
	
	tblFutRT1.visible = false
	tblFutRT2.visible = false
	ChartEx0.visible = false

	'왼쪽 하단
	tblLT1.left = 0
	tblLT2.left = 0
	tblLT3.left = 0
	tblLT4.left = 0
	
	tblLT1.top = 211
	tblLT2.top = 211
	tblLT3.top = 211
	tblLT4.top = 211

	
	tblRLimitF.left = 0
	tblRLimitF.top  = 211
	
	tblExpectation.left = 0
	tblExpectation.top  = 210
	
	
	tblLT2.visible = false
	tblLT3.visible = false
	tblLT4.visible = false	
	tblExpectation.visible = false

End Function

'============================================================================
' 서비스 호출
'============================================================================
Function RequestData()

	Change_Mini_Table()
	Set_RightUp()
	
	DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
	DATAMANAGER.RequestTranData( "ohhts_3050_004r" )

	'차트
	DATAMANAGER.SetDataValue( 0, "ohhts_3080_007r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_3080_007r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)

	'DATAMANAGER.SetDataValue( 0, "ohhts_3080_007r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	'DATAMANAGER.SetDataValue( 0, "ohhts_3080_007r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
	
	'szToday = Form.GetSharedData("&HOST_DATE", 0 )
	'DATAMANAGER.SetDataValue( 0, "ohhts_3080_007r", "InBlock2", "FID_INPUT_DATE1" , 0,szToday)
	'DATAMANAGER.SetDataValue( 0, "ohhts_3080_007r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR" , 0,"D")  'D/W/M/Y 일/주/월/년 

	DATAMANAGER.RequestTranData("ohhts_3080_007r")	

end Function

'===============================================================================
' 호가테이블 설정값 세팅
'==============================================================================
Function Set_HogaTable()
	Dim szDispdiff, szJangraph, szPriceoutline, szBoldHoga, szBoldJan, szBoldRest
	Dim szColWidth, szHAlign

	szDispdiff		= Form.LoadConfigData("mhprc31000", "Dispdiff"	)	'호가등락률
	szJangraph		= Form.LoadConfigData("mhprc31000", "Jangraph"	)	'호가잔량그래프
	g_szDiplayrest	= Form.LoadConfigData("mhprc31000", "Diplayrest"	)	'호가직전수량표시
	szPriceoutline	= Form.LoadConfigData("mhprc31000", "Priceoutline")	'현재가 외곽선 표시
	szBoldHoga		= Form.LoadConfigData("mhprc31000", "BoldHoga"	)	'텍스트굵기 호가
	szBoldJan		= Form.LoadConfigData("mhprc31000", "BoldJan"		)	'텍스트굵기 호가잔량
	szBoldRest		= Form.LoadConfigData("mhprc31000", "BoldRest"	)	'텍스트굵기 직전대비
	
	'설정된 값이 없을 경우 초기값 Insert 함.
	If szDispdiff = "" Then
		szDispdiff 		= "1"
		szJangraph 		= "1"
		g_szDiplayrest 	= "0"
		szPriceoutline 	= "1"
		szBoldHoga 		= "1"
		szBoldJan 		= "0"
		szBoldRest		= "0"
		
		Form.SaveConfigData("mhprc31000", "Dispdiff"		, szDispdiff		)	'호가등락률
		Form.SaveConfigData("mhprc31000", "Jangraph"		, szJangraph		)	'호가잔량그래프
		Form.SaveConfigData("mhprc31000", "Diplayrest"	, g_szDiplayrest	)	'호가직전수량표시
		Form.SaveConfigData("mhprc31000", "Priceoutline"	, szPriceoutline	)	'현재가 외곽선 표시
		Form.SaveConfigData("mhprc31000", "Style"		, "0"			)	'현재가 스타일
		Form.SaveConfigData("mhprc31000", "BoldHoga"		, szBoldHoga		)	'텍스트굵기 호가
		Form.SaveConfigData("mhprc31000", "BoldJan"		, szBoldJan		)	'텍스트굵기 호가잔량
		Form.SaveConfigData("mhprc31000", "BoldRest"		, szBoldRest		)	'텍스트굵기 직전대비
	End If
	

	If szDispdiff = "1" Then
		'호가직전수량표시
		If g_szDiplayrest = "1" Then
			szColWidth = "45,74,90,48,73,45"
		Else
			szColWidth = "0,119,90,48,118,0"
		End If
		szHAlign = "2"
		
	ElseIf szDispdiff = "0" Then
		If g_szDiplayrest = "1" Then
			szColWidth = "45,74,138,0,73,45"
		Else
			szColWidth = "0,119,138,0,118,0"
		End If		
		szHAlign = "1"
		
	End If	

	
	'호가등락률
	hogaTbl.SetColumnWidth( szColWidth )
	
	'호가잔량그래프
	hogaTbl.hojangraph = szJangraph
	
	'현재가 외곽선 표시
	hogaTbl.priceoutline = szPriceoutline
	
	For i = 0 To 9
		'호가
		If szBoldHoga = "1" Then
			hogaTbl.setPropTable("fontstyle" , i , 2 , "01")
		Else 
			hogaTbl.setPropTable("fontstyle" , i , 2 , "00")
		End If
		
		'호가잔량
		If szBoldJan = "1" Then
			hogaTbl.setPropTable("fontstyle" , i , 1 , "01")
			hogaTbl.setPropTable("fontstyle" , i , 4 , "01")
		Else 
			hogaTbl.setPropTable("fontstyle" , i , 1 , "00")
			hogaTbl.setPropTable("fontstyle" , i , 4 , "00")
		End If
		
		'직전대비
		If szBoldRest = "1" Then
			hogaTbl.setPropTable("fontstyle" , i , 3 , "01")
		Else 
			hogaTbl.setPropTable("fontstyle" , i , 3 , "00")
		End If
		
		'호가 가로 정렬
		hogaTbl.SetCellHAlign(i, 2, szHAlign)
	Next

End Function

'============================================================================
Sub Form_OnFormInitBefore()
	
	'g_szItemCode =  "175M9000" 
	'g_szItemMarket = "CF"		

	
	if Len(Trim(g_szItemMarket)) == 0 Then
		g_szItemMarket = "CF"			
	end if
	
	ChartEx0.setChartType("minibong")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	'컨트롤 Ini
	FormInit()		
	
	'환경설정 Load
	Set_HogaTable()
	
	RequestData()	
	
End Sub


'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	if sKey = "ITEMCODE" then
		g_szItemCode = 	sValue
		g_szItemMarket =	Form.GetItemCodeInfo( g_szItemCode , "market")

		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "CF"			
		end if
			
		RequestData()
		
	end	if

End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
	
		tmp = Split(sParam, "★")
		
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
			Exit Sub
		End If
		
		g_szItemCode  = tmp(0)
		g_szMask 	= tmp(1)
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
				
		Set_MaskInfo(g_szMask)
		
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "CF"			
		end if
		
	
		RequestData()
		
	ElseIf sEventName = "HOGA_SETUP" Then
		Set_HogaTable()
	End If

End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
    If szTranID = "ohhts_3050_001r" then
	   
	    DATAMANAGER.CancelRealData( "ohhts_pric_rstc" )
	    
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
		
	ElseIf szTranID = "ohhts_3000_022r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_3000_022r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3000_022r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
		
	ElseIf szTranID = "ohhts_3050_004r" then
		
		DATAMANAGER.CancelRealData( "ohhts_cfut_antg" )
		DATAMANAGER.CancelRealData( "ohhts_cfut_aspr" )
		DATAMANAGER.CancelRealData( "ohhts_cfut_cntg" )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_004r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
	    
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	Dim szCode
	
	szCode = DATAMANAGER.GetDataValue( 0, "ohhts_3050_004r", "OutBlock1", "FID_SHRN_ISCD" , 0 )
	
	If szTranID = "ohhts_cfut_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_cfut_aspr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	
	ElseIf szTranID = "ohhts_cfut_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_cfut_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	
	ElseIf szTranID = "ohhts_cfut_antg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_cfut_antg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )

	ElseIf szTranID = "ohhts_pric_rstc" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_pric_rstc", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )

	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "ohhts_3050_001r" Then
		Dim nSDPR , nOPRC, nHPRC, nLPRC
		Dim szRstcYn
		
		nSDPR = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_SDPR2" , 0 ) )	'기준가
		nOPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_OPRC2" , 0 ) )	'시가
		nHPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_HPRC2" , 0 ) )	'고가
		nLPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_LPRC2" , 0 ) )	'저가
		szRstcYn = DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_RLTM_PRC_RSTC_YN", 0 )	'실시간가격제한여부
	
		'호가컨트롤 속성		
'		hogaTbl.startprice = nOPRC
'		hogaTbl.highprice	 = nHPRC
'		hogaTbl.lowprice	 = nLPRC
		
	    If szRstcYn <> "" Then
		    g_realLimit = CInt(szRstcYn)
		    Change_Mini_Table()
	    End If
		
		'시가
		If nSDPR < nOPRC Then
			tblFutRT2.SetCellFgColor( 0, 1, "10" )				
		ElseIf nSDPR > nOPRC Then
			tblFutRT2.SetCellFgColor( 0, 1, "11" )
		Else
			tblFutRT2.SetCellFgColor( 0, 1, "12" )				
		End If			
		
		'고가
		If nSDPR < nHPRC Then
			tblFutRT2.SetCellFgColor( 1, 1, "10" )				
		ElseIf nSDPR > nHPRC Then
			tblFutRT2.SetCellFgColor( 1, 1, "11" )
		Else
			tblFutRT2.SetCellFgColor( 1, 1, "12" )				
		End If
		

		'저가
		If nSDPR < nLPRC Then
			tblFutRT2.SetCellFgColor( 2, 1, "10" )				
		ElseIf nSDPR > nLPRC Then
			tblFutRT2.SetCellFgColor( 2, 1, "11" )
		Else
			tblFutRT2.SetCellFgColor( 2, 1, "12" )
		End If
			
	    DATAMANAGER.RequestRealData( "ohhts_pric_rstc" )
	  
	End If
	
	If szTranID = "ohhts_3050_004r" Then
		Dim nTOTAL_BIDP_RSQN		' 총매수잔량
		Dim nTOTAL_ASKP_RSQN		' 총매도잔량
		
		nTOTAL_BIDP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_3050_004r", "OutBlock1", "FID_TOTAL_BIDP_RSQN" , 0 )
		nTOTAL_ASKP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_3050_004r", "OutBlock1", "FID_TOTAL_ASKP_RSQN" , 0 )
		
		hogaTbl.SetCellString( 10, 2, nTOTAL_BIDP_RSQN - nTOTAL_ASKP_RSQN )
	

		DATAMANAGER.RequestRealData( "ohhts_cfut_aspr" )
		DATAMANAGER.RequestRealData( "ohhts_cfut_cntg" )
		DATAMANAGER.RequestRealData( "ohhts_cfut_antg" )

		
		DATAMANAGER.RequestTranData( "ohhts_3000_022r" )
		
		'10호가창 중간위치
		scroll_pos = "vcenter"

	End If
	
    If szTranID = "ohhts_3000_022r" then
	    Dim szACNT_CODE
	    szACNT_CODE = DATAMANAGER.GetDataValue( 0, "ohhts_3000_022r", "OutBlock1", "FID_ANTC_CLS_CODE" , 0 )
	    
	    If szACNT_CODE <> "" then
		    If szACNT_CODE <> "0" then
			    tblExpectation.visible = True
			    
			    	tblLT2.visible = false
				tblLT3.visible = false
				tblLT4.visible = false	
				tblRLimitF.visible = false
				
    
		    Else
			    tblExpectation.visible = false
			    
			    Change_Mini_Table()
		    End if
	    End if
	End if
	
End Sub



'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName = "mhprc31000_p4" then	
		scroll_pos = "vcenter"		'10호가창 중간위치
	End If	
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)

	If szTranID = "ohhts_cfut_aspr" Then

		Dim nTOTAL_BIDP_RSQN		' 총매수잔량
		Dim nTOTAL_ASKP_RSQN		' 총매도잔량
		Dim szACNT_CODE
		
		nTOTAL_BIDP_RSQN = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_BIDP_RSQN" , 0 )
		nTOTAL_ASKP_RSQN = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_ASKP_RSQN" , 0 )
		szACNT_CODE = DATAMANAGER.GetDataValue( 1, "ohhts_3000_022r", "OutBlock1", "FID_ANTC_CLS_CODE" , 0 )
		
		hogaTbl.SetCellString( 10, 2, nTOTAL_BIDP_RSQN - nTOTAL_ASKP_RSQN )
		
		If szACNT_CODE <> "" then
		    If szACNT_CODE <> "0" then
			    tblExpectation.visible = True
			    
			    	tblLT2.visible = false
				tblLT3.visible = false
				tblLT4.visible = false	
				
				tblRLimitF.visible = false
    
		    Else
			    tblExpectation.visible = false
			    
			    Change_Mini_Table()
		    End if
	    End if
	    
	ElseIf szTranID = "ohhts_pric_rstc" then
		Dim szRstcYN
	    szRstcYN = DATAMANAGER.GetDataValue( 1, "ohhts_pric_rstc", "OutBlock1", "FIDR_RLTM_PRC_RSTC_YN" , 0 )
	    
	    If szRstcYN <> "" Then
		    g_realLimit = CInt( szRstcYN )
		    Change_Mini_Table()
	    End If
	End If
End Sub

'============================================================================
Sub tblFutRT1_OnClick(lRow , lColumn)

	If lRow = 0 And lColumn = 0 Then
		Change_RightUp()
	End If
End Sub

'============================================================================
Sub tblFutRT2_OnClick(lRow , lColumn)

	If lRow = 0 And lColumn = 0 Then
		Change_RightUp()
	End If
End Sub

'============================================================================
Sub imgRUp_OnClick()
	Change_RightUp()
End Sub

'============================================================================
Sub Image0_OnClick()
	Change_RightUp()
End Sub

'============================================================================
Function Change_Mini_Table()

      If g_realLimit = 0 Then
	    tblLT1.visible = true
	    tblLT2.visible = false
	    tblLT3.visible = false
	    tblLT4.visible = false

    ElseIf g_realLimit = 1 Then
	    tblLT1.visible = false
	    tblLT2.visible = true
	    tblLT3.visible = false
	    tblLT4.visible = false

    ElseIf g_realLimit = 2 Then
	    tblLT1.visible = false
	    tblLT2.visible = false
	    tblLT3.visible = true
	    tblLT4.visible = false

    ElseIf g_realLimit = 3 Then
	    tblLT1.visible = false
	    tblLT2.visible = false
	    tblLT3.visible = false
	    tblLT4.visible = true

    End If
	
End Function

'=============================================================================
' 미국달러선물인 경우 소수점 한자리 까지만 나타내기 위해 마스킹처리를 해준다.
'=============================================================================
Sub Set_MaskInfo(szMask)

	if szMask == 1 or szMask == "1" then
		for i = 0 to 9
			hogaTbl.SetCellMaskInfo(i, 2, "0,1,,,1,,1,1,0")
		next
		
		tblFutRT1.SetCellMaskInfo(0, 1, "0,1,,,1,,1,1,0")
		tblFutRT1.SetCellMaskInfo(1, 1, "0,1,,,1,,1,1,0")
		tblFutRT1.SetCellMaskInfo(2, 1, "0,1,,,1,,1,1,0")
	
		tblFutRT2.SetCellMaskInfo(0, 1, "0,1,,,1,,1,1,0")
		tblFutRT2.SetCellMaskInfo(1, 1, "0,1,,,1,,1,1,0")
		tblFutRT2.SetCellMaskInfo(2, 1, "0,1,,,1,,1,1,0")
		
		tblRLimitF.SetCellMaskInfo(4, 1, "0,1,,,1,,1,1,0")
		tblLT1.SetCellMaskInfo(0, 2, "0,1,,,1,,1,1,0")
		tblLT1.SetCellMaskInfo(1, 2, "0,1,,,1,,1,1,0")
		
	elseif szMask == 2 or szMask == "2" then
		for i = 0 to 9
			hogaTbl.SetCellMaskInfo(i, 2, "0,1,,,1,,2,1,0")
		next
		
		
		tblFutRT1.SetCellMaskInfo(0, 1, "0,1,,,1,,2,1,0")
		tblFutRT1.SetCellMaskInfo(1, 1, "0,1,,,1,,2,1,0")
		tblFutRT1.SetCellMaskInfo(2, 1, "0,1,,,1,,2,1,0")
	
		tblFutRT2.SetCellMaskInfo(0, 1, "0,1,,,1,,2,1,0")
		tblFutRT2.SetCellMaskInfo(1, 1, "0,1,,,1,,2,1,0")
		tblFutRT2.SetCellMaskInfo(2, 1, "0,1,,,1,,2,1,0")
		
		tblRLimitF.SetCellMaskInfo(4, 1, "0,1,,,1,,2,1,0")
		tblLT1.SetCellMaskInfo(0, 2, "0,1,,,1,,2,1,0")
		tblLT1.SetCellMaskInfo(1, 2, "0,1,,,1,,2,1,0")
		
	else
	
		for i = 0 to 9
			hogaTbl.SetCellMaskInfo(i, 2, "0,1,,,1,,0,1,0")
		next
		
		tblFutRT1.SetCellMaskInfo(0, 1, "0,1,,,1,,0,1,0")
		tblFutRT1.SetCellMaskInfo(1, 1, "0,1,,,1,,0,1,0")
		tblFutRT1.SetCellMaskInfo(2, 1, "0,1,,,1,,0,1,0")
	
		tblFutRT2.SetCellMaskInfo(0, 1, "0,1,,,1,,0,1,0")
		tblFutRT2.SetCellMaskInfo(1, 1, "0,1,,,1,,0,1,0")
		tblFutRT2.SetCellMaskInfo(2, 1, "0,1,,,1,,0,1,0")
		
		tblRLimitF.SetCellMaskInfo(4, 1, "0,1,,,1,,0,1,0")
		tblLT1.SetCellMaskInfo(0, 2, "0,1,,,1,,0,1,0")
		tblLT1.SetCellMaskInfo(1, 2, "0,1,,,1,,0,1,0")
		
		
	end if

End Sub
