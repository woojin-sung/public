--===========================================================================
Dim g_szAcnt, g_szAcntCd, g_szStartDt, g_szEndDt, g_szGbCd, g_szLndnFeeYN, g_szFeecdName

'============================================================================
Sub imgExit_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgExitBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	'imgAlpha.imgpath = "alpha128.png"
	
	contLndn.grdLndnM.setUseCardView(true, 10, "img_bgbox.9.png")
	'contLndn.setScrollBarVisible("0")
	
	contUsd.grdUsdM.setUseCardView(true, 10, "img_bgbox.9.png")
	'contUsd.setScrollBarVisible("0")
	
	contWon.grdWonM.setUseCardView(true, 10, "img_bgbox.9.png")
	'contWon.setScrollBarVisible("0")
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	
	if trim(szOpenData) <> "" and szOpenData <> null then
		
		dim tData
		tData = Split(szOpenData, "★")
		
		g_szAcnt   	= tData(0)
		g_szAcntCd 	= tData(1)
		g_szStartDt	= tData(2)
		g_szEndDt	= tData(3)
		g_szGbCd		= tData(4)	'1:원화RP 2:외화RP
		g_szLndnFeeYN = tData(5)
		g_szFeecdName = tData(6)
		
		if g_szGbCd == "1" then
			lblTitle.caption = "원화RP 수익금 내역"
			contWon.visible = true
			contUsd.visible = false
			contLndn.visible = false
		elseif g_szGbCd == "2" then
			lblTitle.caption = "외화RP 수익금 내역"
			contWon.visible = false
			contUsd.visible = true
			contLndn.visible = false
		elseif g_szGbCd == "3" then
			lblTitle.caption = "대여 수익금 내역"
			contWon.visible = false
			contUsd.visible = false
			contLndn.visible = true
		end if
	end if
	
	'TimerEvnet. animation 정상처리를 위함.
	Form.SetTimerEvent2(1, 1, 0.5)
'	if g_szGbCd == "3" then
'		DATAMANAGER.RequestTranData( "oblon_lndn_050r" )
'	else
'		DATAMANAGER.RequestTranData("obsav_bsop_322r") '수익금조회
'	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obsav_bsop_323r" Then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"	 		, 0 , g_szAcnt)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 	  		, 0 , g_szAcntCd)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STA_DATE" 		, 0 , g_szStartDt)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FIN_DATE" 		, 0 , g_szEndDt)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE"	, 0 , g_szGbCd)
	elseif szTranID == "obsav_bsop_322r" Then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"	 		, 0 , g_szAcnt)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 	  		, 0 , g_szAcntCd)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STA_DATE" 		, 0 , g_szStartDt)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FIN_DATE" 		, 0 , g_szEndDt)	
	elseif szTranID == "oblon_lndn_050r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"	 		, 0 , g_szAcnt)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 	  		, 0 , g_szAcntCd)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STA_DATE" 		, 0 , g_szStartDt)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FIN_DATE" 		, 0 , g_szEndDt)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"	, 0 , g_szLndnFeeYN)
	elseif szTranID == "oblon_lndn_051r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"	 		, 0 , g_szAcnt)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 	  		, 0 , g_szAcntCd)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STA_DATE" 		, 0 , g_szStartDt)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FIN_DATE" 		, 0 , g_szEndDt)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"	, 0 , g_szLndnFeeYN)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obsav_bsop_323r" then
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		ngrdWonCnt = Cint(contWon.grdWonS.rowcount)
		ngrdUsdCnt = Cint(contUsd.grdUsdS.rowcount)
		
		if g_szGbCd == "1" then
			for i = 0 to nCnt - 1
				
				tmpDate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_DATE"   , i)
				tmpAmt  = CLng(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCAM"      , i))
				tmpPrls = CDbl(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "APLY_INRT" , i))

				contWon.grdWonS.AddRow()
				contWon.grdWonS.SetCellData("bd_date", ngrdWonCnt + i, tmpDate)
				contWon.grdWonS.SetCellData("bd_amt" , ngrdWonCnt + i, tmpAmt)
				contWon.grdWonS.SetCellData("bd_prls", ngrdWonCnt + i, tmpPrls)
				contWon.grdWonS.SetCellData("bd_line", ngrdWonCnt + i, "|")
			next
			
			if nCnt == 0 then
				lblNoData.visible = true
				lblNoData.caption = "제공 받은 수익금이 없어요."
				contWon.visible = false
			else
				lblNoData.visible = false
				contWon.visible = true
			end if
		else
			for i = 0 to nCnt - 1
				
				tmpDate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_DATE"   , i)
				tmpAmt  = CDbl(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FRCR_RCAM" , i))
				tmpPrls = CDbl(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "APLY_INRT" , i))

				contUsd.grdUsdS.AddRow()
				contUsd.grdUsdS.SetCellData("bd_date", ngrdUsdCnt + i, tmpDate)
				contUsd.grdUsdS.SetCellData("bd_amt" , ngrdUsdCnt + i, tmpAmt)
				contUsd.grdUsdS.SetCellData("bd_prls", ngrdUsdCnt + i, tmpPrls)
				contUsd.grdUsdS.SetCellData("bd_line", ngrdUsdCnt + i, "|")
			next
			
			
			if nCnt == 0 then
				lblNoData.visible = true
				lblNoData.caption = "제공 받은 수익금이 없어요."
				contUsd.visible = false
			else
				lblNoData.visible = false
				contUsd.visible = true
			end if
		end if
		
		if DATAMANAGER.IsMoreNextData(szTranID) == true then
			DATAMANAGER.RequestNextData(szTranID)
		end if
		
		'test
		if DATAMANAGER.IsMoreNextData(szTranID) == false then
			if g_szGbCd == "1" then
				contWon.grdWonS.height = 90 + (Cint(contWon.grdWonS.rowcount)) * 45
				contWon.height = Form.GetCtlProp("contWon", "height") + CInt(Form.calcUnResize(contWon.lblWonText1.top, "1"))
				contWon.SetScrollAutoSize()
			else
				contUsd.grdUsdS.height = 90 + (Cint(contUsd.grdUsdS.rowcount)) * 45
				contUsd.height = Form.GetCtlProp("contUsd", "height") + CInt(Form.calcUnResize(contUsd.lblUsdText1.top, "1"))
				contUsd.SetScrollAutoSize()
			end if
		end if
	elseif szTranID == "obsav_bsop_322r" then
		if g_szGbCd == "1" then
			'nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock2")
			contWon.grdWonM.SetCellData("bd_prd", 0, g_szFeecdName)
		else
			'nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock3")
			contUsd.grdUsdM.SetCellData("bd_prd", 0, g_szFeecdName)
		end if
		
		if DATAMANAGER.IsMoreNextData(szTranID) == false then
			DATAMANAGER.RequestTranData("obsav_bsop_323r")
		end if
	elseif szTranID == "oblon_lndn_050r" then
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		nTotalAmt   = CLng(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TOTAL_FEE"     , 0))
		nTotalErt   = CDbl(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACML_ERT"      , 0))
		nStckAmt    = CLng(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "STCK_FEE"      , 0))
		nStckAmtErt = CDbl(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "STCK_ACML_ERT" , 0))
		nBondAmt    = CLng(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "BOND_FEE"      , 0))
		nBondAmtErt = CDbl(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "BOND_ACML_ERT" , 0))
	
'		if nTotalErt * 10000 MOD 100  == 0 then
'			nTotalErt = FormatNumber(nTotalErt,2)
'		elseif nTotalErt * 10000 MOD 10 == 0 then
'			nTotalErt = FormatNumber(nTotalErt,3)
'		else
'			nTotalErt = FormatNumber(nTotalErt,4)
'		end if
'		
'		if nStckAmtErt * 10000 MOD 100  == 0 then
'			nStckAmtErt = FormatNumber(nStckAmtErt,2)
'		elseif nStckAmtErt * 10000 MOD 10 == 0 then
'			nStckAmtErt = FormatNumber(nStckAmtErt,3)
'		else
'			nStckAmtErt = FormatNumber(nStckAmtErt,4)
'		end if
'
'		if nBondAmtErt * 10000 MOD 100  == 0 then
'			nBondAmtErt = FormatNumber(nBondAmtErt,2)
'		elseif nBondAmtErt * 10000 MOD 10 == 0 then
'			nBondAmtErt = FormatNumber(nBondAmtErt,3)
'		else
'			nBondAmtErt = FormatNumber(nBondAmtErt,4)
'		end if
			
		contLndn.grdLndnM.SetCellData("bd_prd1", 0, g_szFeecdName)
		contLndn.grdLndnM.SetCellData("bd_prd2", 0, "· 주식수익")
		contLndn.grdLndnM.SetCellData("bd_prd3", 0, "· 채권수익")
		contLndn.grdLndnM.SetCellData("bd_amt1", 0, nTotalAmt)
		contLndn.grdLndnM.SetCellData("bd_amt2", 0, nStckAmt)
		contLndn.grdLndnM.SetCellData("bd_amt3", 0, nBondAmt)
		contLndn.grdLndnM.SetCellData("bd_prls1", 0, nTotalErt)
		contLndn.grdLndnM.SetCellData("bd_prls2", 0, nStckAmtErt)
		contLndn.grdLndnM.SetCellData("bd_prls3", 0, nBondAmtErt)
		contLndn.grdLndnM.SetCellData("bd_line1", 0, "|")
		contLndn.grdLndnM.SetCellData("bd_line2", 0, "|")
		contLndn.grdLndnM.SetCellData("bd_line3", 0, "|")
		
		if DATAMANAGER.IsMoreNextData(szTranID) == false then
			DATAMANAGER.RequestTranData("oblon_lndn_051r")
		end if
	elseif szTranID == "oblon_lndn_051r" then
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		ngrdLndnCnt = Cint(contLndn.grdLndnS.rowcount)
		
		for i = 0 to nCnt - 1
			tmpDate    = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STND_DATE"      , i)
			tmpPrvsYN  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "PRVS_YN"        , i)
			tmpStckAmt = CLng(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STCK_FEE"       , i))
			tmpStckErt = CDbl(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STCK_ACML_ERT"  , i))
			tmpBondAmt = CLng(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BOND_FEE"       , i))
			tmpBondErt = CDbl(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BOND_ACML_ERT"  , i))
			tmpDateFmt = ""
			
			if trim(tmpDate) <> "" and tmpDate <> null then
				tmpDateFmt = left(tmpDate,4).."."..mid(tmpDate,5,2).."."..right(tmpDate,2)
				
				if tmpPrvsYN == "N" then
					tmpDateFmt = tmpDateFmt.." (예정)"
				end if
			end if
			
'			if tmpStckErt * 10000 MOD 100  == 0 then
'				tmpStckErt = FormatNumber(tmpStckErt,2)
'			elseif tmpStckErt * 10000 MOD 10 == 0 then
'				tmpStckErt = FormatNumber(tmpStckErt,3)
'			else
'				tmpStckErt = FormatNumber(tmpStckErt,4)
'			end if
'
'			if tmpBondErt * 10000 MOD 100  == 0 then
'				tmpBondErt = FormatNumber(tmpBondErt,2)
'			elseif tmpBondErt * 10000 MOD 10 == 0 then
'				tmpBondErt = FormatNumber(tmpBondErt,3)
'			else
'				tmpBondErt = FormatNumber(tmpBondErt,4)
'			end if
			
			contLndn.grdLndnS.AddRow()
			contLndn.grdLndnS.SetCellData("bd_date1" , ngrdLndnCnt + i, tmpDateFmt)
			contLndn.grdLndnS.SetCellData("bd_date2" , ngrdLndnCnt + i, "주식수익")
			contLndn.grdLndnS.SetCellData("bd_date3" , ngrdLndnCnt + i, "채권수익")
			contLndn.grdLndnS.SetCellData("bd_amt2"  , ngrdLndnCnt + i, tmpStckAmt)
			contLndn.grdLndnS.SetCellData("bd_amt3"  , ngrdLndnCnt + i, tmpBondAmt)
			contLndn.grdLndnS.SetCellData("bd_prls2" , ngrdLndnCnt + i, tmpStckErt)
			contLndn.grdLndnS.SetCellData("bd_prls3" , ngrdLndnCnt + i, tmpBondErt)
			contLndn.grdLndnS.SetCellData("bd_line2" , ngrdLndnCnt + i, "|")
			contLndn.grdLndnS.SetCellData("bd_line3" , ngrdLndnCnt + i, "|")
			
		next
		
		if nCnt == 0 then
			lblNoData.visible = true
			lblNoData.caption = "제공 받은 수익금이 없어요."
			contLndn.visible = false
		else
			lblNoData.visible = false
			contLndn.visible = true
		end if
		
		if DATAMANAGER.IsMoreNextData(szTranID) == true then
			DATAMANAGER.RequestNextData(szTranID)
		end if
		
		'test
		if DATAMANAGER.IsMoreNextData(szTranID) == false then
			contLndn.grdLndnS.height = 140 + (Cint(contLndn.grdLndnS.rowcount)) * 99
			contLndn.height = Form.GetCtlProp("contLndn", "height") + CInt(Form.calcUnResize(contLndn.lblLndnText1.top, "1"))
			contLndn.SetScrollAutoSize()
		end if
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "안내" , szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "안내" , szErrMsg)
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	contLndn.imgTip.setMaintainingRatio("1")
	imgExit.setMaintainingRatio("1")
End Sub

'============================================================================
Sub contLndn_imgTip_OnClick()
	tmpToolTipText1 = "채권 수익률 기준\n"
	tmpToolTipText2 = "·국고채                                       0.25%\n"
	tmpToolTipText3 = "·통안채                                       0.20%"
	tmpToolTipText  = tmpToolTipText1..tmpToolTipText2..tmpToolTipText3
	
	contLndn.imgTip.openToolTip(tmpToolTipText, 270, 80, 2)
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if sTimerID == 1 or sTimerID == "1" then
		'하이라이트
		lblTitle.setHighlight(332)
		
		if g_szGbCd == "3" then
			DATAMANAGER.RequestTranData( "oblon_lndn_050r" )
		else
			DATAMANAGER.RequestTranData("obsav_bsop_322r") '수익금조회
		end if
		
		Form.SetTimerEvent2(1, 0, 0)
	end if
End Sub

'============================================================================
Sub contLndn_imgTipBg_OnClick()
	contLndn_imgTip_OnClick()
End Sub

