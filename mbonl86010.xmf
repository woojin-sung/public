'============================================================================
' fmtabTerminalService_OnTabChanged - 탭 변경할 때 조회
'============================================================================
Sub fmtabTerminalService_OnTabChanged(nCurrentTab)
	if nCurrentTab == 0 then
		Form.triggerEvent("fmtabTerminalService." & fmtabTerminalService.currenttabpageid, "enroll", szParam)

	elseif nCurrentTab == 1 then
		Form.triggerEvent("fmtabTerminalService." & fmtabTerminalService.currenttabpageid, "cancel", szParam)

	end if
End Sub



'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	if CInt(fmtabTerminalService.currenttab) == 0 then
	   Form.triggerEvent("fmtabTerminalService." & fmtabTerminalService.currenttabpageid, "enroll", szParam)
	elseif CInt(fmtabTerminalService.currenttab) == 1 then   
	   Form.triggerEvent("fmtabTerminalService." & fmtabTerminalService.currenttabpageid, "cancel", szParam) 
	end if   
End Sub

	</SCRIPT_INFO>
