	<SCRIPT_INFO _len="17311" _ulen="15563" >
'============================================================================
' 화 면 명 : CFD해외권리화면_권리상세
' 화면설명 : CFD해외권리화면의 상세 팝업창
' 작    성 : 2023.09.12 KKM
'============================================================================

Dim g_szItemCd, g_szItemNm, g_szRghtCd, g_szRghtNm, g_szStatCd, g_szStndDate, g_szWrhsDate
Dim g_szFRSK, g_szFRSKDate, g_szFRSKQty, g_szASGM_RATE
Dim g_szPSTNCd, g_szPSTNNm
Dim g_Left, g_Top
g_Left = 12
g_Top = 350

Function SetVisible()
	Table031.left = 512
	Select Case g_szRghtCd	
			
		Case "01" '01	유상
			if g_szStatCd == "2" then '예정
				Table012.left = g_Left 
				Table012.top = g_Top
				Table012.SetCellString(0, 1, g_szRghtNm)
				Table012.SetCellString(1, 1, g_szPSTNNm) '매매구분
				
			else
				Table011.left = g_Left 
				Table011.top = g_Top
				Table011.SetCellString(0, 1, g_szRghtNm)
				Table011.SetCellString(1, 1, g_szPSTNNm) '매매구분
			end if 
			
		Case "02" '02 무상		
			if g_szStatCd == "2" then '예상
'				if g_szPSTNCd == "1" then '매수
					Table022.left = g_Left 
					Table022.top = g_Top
					Table022.SetCellString(0, 1, g_szRghtNm)
					Table022.SetCellString(1, 1, g_szPSTNNm) '매매구분
'				else
'					Table0221.left = g_Left
'					Table0221.top = g_Top
'					Table0221.SetCellString(0, 1, g_szRghtNm)
'					Table0221.SetCellString(1, 1, g_szPSTNNm) '매매구분
'				end if
			else '지급
'				if g_szPSTNCd == "1" then '매수
					Table021.left = g_Left 
					Table021.top = g_Top
					Table021.SetCellString(0, 1, g_szRghtNm)
					Table021.SetCellString(1, 1, g_szPSTNNm) '매매구분
'				else
'					Table0211.left = g_Left 
'					Table0211.top = g_Top
'					Table0211.SetCellString(0, 1, g_szRghtNm)
'					Table0211.SetCellString(1, 1, g_szPSTNNm) '매매구분
'				end if
			end if 	
			
		Case "03" '03	 배당(현금, 주식, 동시배당)	
			if g_szRghtNm == "현금배당" then
				Table031.left = g_Left 
				Table031.top = g_Top
				Table031.SetCellString(0, 1, g_szRghtNm)
				Table031.SetCellString(1, 1, g_szPSTNNm) '매매구분
			elseif g_szRghtNm == "주식배당"  then 
				Table030.left = g_Left 
				Table030.top = g_Top
				Table030.SetCellString(0, 1, g_szRghtNm)
				Table030.SetCellString(1, 1, g_szPSTNNm) '매매구분
			end if 
			
	End Select
end Function

Function SetData()
	Dim szCRCD, szCRCD2
	'통화코드
	szCRCD = grd1.GetCellData("bd_cell11", 0)
	if szCRCD <> "원" then
		szCRCD = " "& szCRCD
	end if 
	'액면통화코드
	szCRCD2 = grd1.GetCellData("bd_cell31", 0)
	if szCRCD2 <> "원" then
		szCRCD2 = " "& szCRCD2
	end if 
	
	Select Case g_szRghtCd
			Case "01" '01	유상			
			if g_szStatCd == "2" then '예정
				Table012.SetCellString(2, 1, grd1.GetCellData("bd_cell18", 0)) '주당배정률				
				Table012.SetCellMaskInfo(3, 1, "0,0,,"& szCRCD2 & ",0,,-1,1,0,0,0")
				Table012.SetCellString(3, 1, grd1.GetCellData("bd_cell29", 0)) '배정환율				
				Table012.SetCellString(4, 1, grd1.GetCellData("bd_cell17", 0)) '배정수량
				Table012.SetCellMaskInfo(6, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")
				if g_szPSTNNm == "매도" then
					Table012.SetCellString(5, 0, "CFD차입유상증서매각대금출금일")
					Table012.SetCellString(6, 0, "CFD차입유상증서매각대금출금액")
					Table012.SetCellString(5, 1, grd1.GetCellData("bd_cell16", 0)) 
					Table012.SetCellString(6, 1, CDbl(grd1.GetCellData("bd_cell13", 0))) 
				else '매수
					Table012.SetCellString(5, 0, "CFD차입유상증서매각대금입금일")
					Table012.SetCellString(6, 0, "CFD차입유상증서매각대금입금액")
					Table012.SetCellString(5, 1, grd1.GetCellData("bd_cell16", 0)) 
					Table012.SetCellString(6, 1, CDbl(grd1.GetCellData("bd_cell12", 0))) 
				end if
				
				'단수주지급일
				if Trim(g_szFRSKDate) == "" then
					Table012.SetCellMaskInfo(7, 1, "1,0,,,1,,0,0,1,0,0")
					Table012.SetCellString(7, 0, "")
					Table012.SetCellString(7, 1, "")
				else
					Table012.SetCellString(7, 1, g_szFRSKDate) 'CFD단수지급일
				end if 
				
				'단수주수량
				if Trim(g_szFRSKQty) == "" then
					Table012.SetCellMaskInfo(8, 1, "1,0,,,1,,0,0,1,0,0")
					Table012.SetCellString(8, 0, "")
					Table012.SetCellString(8, 1, "")
				else
					Table012.SetCellString(8, 1, g_szFRSKQty) 'CFD단수주수량
				end if 				
			
				'단수주대금(세전)
				'if Trim(g_szFRSKQty) == "" or Trim(g_szFRSK) == "" then
				if Trim(g_szFRSK) == "" then
					Table012.SetCellMaskInfo(9, 1,"1,0,,,1,,0,0,1,0,0")
					Table012.SetCellString(9, 0, "")					
					Table012.SetCellString(9, 1, "")					
				else
					Table012.SetCellMaskInfo(9, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")
					Table012.SetCellString(9, 1, g_szFRSK) 'CFD단수주대금(세전)
				end if 				
			
			else ' 지급
				Table011.SetCellMaskInfo(3, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")			
				if g_szPSTNNm == "매도" then
					Table011.SetCellString(2, 0, "CFD유상증서매각대금출금일")
					Table011.SetCellString(3, 0, "CFD유상증서매각대금출금액")
					Table011.SetCellString(2, 1, grd1.GetCellData("bd_cell16", 0)) 
					Table011.SetCellString(3, 1, CDbl(grd1.GetCellData("bd_cell13", 0))) 
				else '매수
					Table011.SetCellString(2, 0, "CFD유상증서매각대금입금일")
					Table011.SetCellString(3, 0, "CFD유상증서매각대금입금액")
					Table011.SetCellString(2, 1, grd1.GetCellData("bd_cell16", 0)) 
					Table011.SetCellString(3, 1, CDbl(grd1.GetCellData("bd_cell12", 0))) 
				end if				
				
				'단수주지급일
				if Trim(g_szFRSKDate) == "" then
					Table011.SetCellMaskInfo(4, 1,  "1,0,,,1,,0,0,1,0,0")
					Table011.SetCellString(4, 0, "")
					Table011.SetCellString(4, 1, "")
				else
					Table011.SetCellString(4, 1, g_szFRSKDate) 'CFD단수지급일
				end if 
				
				'단수주수량
				if Trim(g_szFRSKQty) == "" then
					Table011.SetCellMaskInfo(5, 1, "1,0,,,1,,0,0,1,0,0")
					Table011.SetCellString(5, 0, "")
					Table011.SetCellString(5, 1, "")
				else
					Table011.SetCellString(5, 1, g_szFRSKQty) 'CFD단수주수량
				end if 				
			
				'단수주대금(세전)
				'if Trim(g_szFRSKQty) == "" or Trim(g_szFRSK) == "" then
				if Trim(g_szFRSK) == "" then
					Table011.SetCellMaskInfo(6, 1,"1,0,,,1,,0,0,1,0,0")
					Table011.SetCellString(6, 0, "")					
					Table011.SetCellString(6, 1, "")					
				else					
					Table011.SetCellMaskInfo(6, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")
					Table011.SetCellString(6, 1, g_szFRSK) 'CFD단수주대금(세전)
				end if 				
			end if 
			
		Case "02" '02 무상
		
			'매칭이 필요
			if g_szStatCd == "2" then '예정
			
				Table022.SetCellString(2, 1, grd1.GetCellData("bd_cell18", 0)) '주당배정률	
				if g_szPSTNNm == "매도" then
					Table022.SetCellString(3, 0, "CFD권리분차입일")
					Table022.SetCellString(4, 0, "CFD권리분차입수량")				
					Table022.SetCellString(3, 1, grd1.GetCellData("bd_cell16", 0)) 
					Table022.SetCellString(4, 1, grd1.GetCellData("bd_cell15", 0)) 				
				else '매수 
					Table022.SetCellString(3, 0, "CFD무상주입고일")
					Table022.SetCellString(4, 0, "CFD무상주입고수량")
					Table022.SetCellString(3, 1, grd1.GetCellData("bd_cell16", 0)) 
					Table022.SetCellString(4, 1, grd1.GetCellData("bd_cell14", 0)) 				
				end if 
				
				'단수주수 또는 단수주지급일자
				'if Trim(g_szFRSKQty) == "" or Trim(g_szFRSKDate) == "" then
				if Trim(g_szFRSKDate) == "" then
					Table022.SetCellMaskInfo(5, 1,  "1,0,,,1,,0,0,1,0,0")
					Table022.SetCellString(5, 0, "")
					Table022.SetCellString(5, 1, "")
				else
					Table022.SetCellString(5, 1, g_szFRSKDate) 'CFD단수지급일
				end if 
			
				'단수주수 또는 단수주대금(세전)
				'if Trim(g_szFRSKQty) == "" or Trim(g_szFRSK) == "" then
				if Trim(g_szFRSK) == "" then
					Table022.SetCellMaskInfo(6, 1,  "1,0,,,1,,0,0,1,0,0")
					Table022.SetCellString(6, 0, "")					
					Table022.SetCellString(6, 1, "")					
				else
					Table022.SetCellMaskInfo(6, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")
					Table022.SetCellString(6, 1, g_szFRSK) 'CFD단수주대금(세전)
				end if 	
				
				'단수주수량
				if Trim(g_szFRSKQty) == "" then
					Table022.SetCellMaskInfo(7, 1, "1,0,,,1,,0,0,1,0,0")
					Table022.SetCellString(7, 0, "")
					Table022.SetCellString(7, 1, "")
				else
					Table022.SetCellString(7, 1, g_szFRSKQty) 'CFD단수주수량
				end if 				
			else '지급
				if g_szPSTNNm == "매도" then
					Table021.SetCellString(2, 0, "CFD권리분차입일")
					Table021.SetCellString(3, 0, "CFD권리분차입수량")				
					Table021.SetCellString(2, 1, grd1.GetCellData("bd_cell16", 0)) 
					Table021.SetCellString(3, 1, grd1.GetCellData("bd_cell15", 0)) 				
				else '매수 
					Table021.SetCellString(2, 0, "CFD무상주입고일")
					Table021.SetCellString(3, 0, "CFD무상주입고수량")
					Table021.SetCellString(2, 1, grd1.GetCellData("bd_cell16", 0)) 
					Table021.SetCellString(3, 1, grd1.GetCellData("bd_cell14", 0)) 				
				end if 
				
				'단수주수 또는 단수주지급일자
				'if Trim(g_szFRSKQty) == "" or Trim(g_szFRSKDate) == "" then
				if Trim(g_szFRSKDate) == "" then
					Table021.SetCellMaskInfo(4, 1,  "1,0,,,1,,0,0,1,0,0")
					Table021.SetCellString(4, 0, "")
					Table021.SetCellString(4, 1, "")
				else
					Table021.SetCellString(4, 1, g_szFRSKDate) 'CFD단수지급일
				end if 
			
				'단수주수 또는 단수주대금(세전)
				'if Trim(g_szFRSKQty) == "" or Trim(g_szFRSK) == "" then
				if Trim(g_szFRSK) == "" then
					Table021.SetCellMaskInfo(5, 1,  "1,0,,,1,,0,0,1,0,0")
					Table021.SetCellString(5, 0, "")					
					Table021.SetCellString(5, 1, "")					
				else
					Table021.SetCellMaskInfo(5, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")
					Table021.SetCellString(5, 1, g_szFRSK) 'CFD단수주대금(세전)
				end if 
				
				'단수주수량
				if Trim(g_szFRSKQty) == "" then
					Table021.SetCellMaskInfo(6, 1, "1,0,,,1,,0,0,1,0,0")
					Table021.SetCellString(6, 0, "")
					Table021.SetCellString(6, 1, "")
				else
					Table021.SetCellString(6, 1, g_szFRSKQty) 'CFD단수주수량
				end if				
							
			end if 			
	
		Case "03" '03	 배당(현금, 주식, 동시배당)	
'			if g_szRghtNm == "주식배당" or g_szRghtNm == "동시배당" then			
			if g_szRghtNm == "현금배당"  then			
				Table031.SetCellMaskInfo(2, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")
				Table031.SetCellString(2, 1, CDbl(grd1.GetCellData("bd_cell23", 0))) '주당배당금
				
				Table031.SetCellMaskInfo(3, 1, "0,0,,"& szCRCD2 & ",0,,-1,1,0,0,0")
				Table031.SetCellString(3, 1, grd1.GetCellData("bd_cell29", 0) ) '배정환율
				
				Table031.SetCellMaskInfo(5, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")
				if g_szPSTNNm == "매도" then
					Table031.SetCellString(4, 0, "CFD차입배당상당액입금일") 
					Table031.SetCellString(5, 0, "CFD차입배당상당액")	
					Table031.SetCellString(5, 1, CDbl(grd1.GetCellData("bd_cell13", 0))) 'CFD배당상당액			
				else 
					Table031.SetCellString(4, 0, "CFD배당상당액입금일") 
					Table031.SetCellString(5, 0, "CFD배당상당액")					
					Table031.SetCellString(5, 1, CDbl(grd1.GetCellData("bd_cell12", 0)) ) 'CFD배당상당액			
				end if 
		
				Table031.SetCellString(4, 1, grd1.GetCellData("bd_cell16", 0)) 'CFD배당상당액입금일 입고일자
				
				'단수주수 또는 단수주지급일자
				'if Trim(g_szFRSKQty) == "" or Trim(g_szFRSKDate) == "" then
				if Trim(g_szFRSKDate) == "" then
					Table031.SetCellMaskInfo(6, 1,  "1,0,,,1,,0,0,1,0,0")
					Table031.SetCellString(6, 0, "")
					Table031.SetCellString(6, 1, "")
				else
					Table031.SetCellString(6, 1, g_szFRSKDate) 'CFD단수지급일
				end if 
			
				'단수주수 또는 단수주대금(세전)
				'if Trim(g_szFRSKQty) == "" or Trim(g_szFRSK) == "" then
				if Trim(g_szFRSK) == "" then
					Table031.SetCellMaskInfo(7, 1,  "1,0,,,1,,0,0,1,0,0")
					Table031.SetCellString(7, 0, "")					
					Table031.SetCellString(7, 1, "")					
				else
					Table031.SetCellMaskInfo(7, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")
					Table031.SetCellString(7, 1, g_szFRSK) 'CFD단수주대금(세전)
				end if 
				
				'단수주수량
				if Trim(g_szFRSKQty) == "" then
					Table031.SetCellMaskInfo(8, 1, "1,0,,,1,,0,0,1,0,0")
					Table031.SetCellString(8, 0, "")
					Table031.SetCellString(8, 1, "")
				else
					Table031.SetCellString(8, 1, g_szFRSKQty) 'CFD단수주수량
				end if					
			elseif g_szRghtNm == "주식배당" then

				Table030.SetCellMaskInfo(2, 1, "0,0,,"& szCRCD2 & ",0,,-1,1,0,0,0")
				Table030.SetCellString(2, 1, grd1.GetCellData("bd_cell29", 0) ) '배정환율
			
				if g_szPSTNNm == "매도" then				
					Table030.SetCellString(3, 0, "CFD배당주출고일")
					Table030.SetCellString(3, 1, grd1.GetCellData("bd_cell16", 0) ) 'CFD배당주출고일
					
					'Table030.SetCellString(4, 0, "수량")
					'Table030.SetCellMaskInfo(4, 1, "0,0,,주,0,,0,1,0,0,0")
					Table030.SetCellString(4, 1, grd1.GetCellData("bd_cell15", 0) ) '수량							
					Table030.SetCellString(5, 0, "CFD배당차입단수주대금출금일")
					Table030.SetCellString(6, 0, "CFD배당차입단수주대금출금")
				else  '매수
					Table030.SetCellString(3, 0, "CFD배당주입고일")
					Table030.SetCellString(3, 1, grd1.GetCellData("bd_cell16", 0) ) 'CFD배당주입고일
					
					'Table030.SetCellString(4, 0, "수량")
					'Table030.SetCellMaskInfo(4, 1, "0,0,,주,0,,0,1,0,0,0")
					Table030.SetCellString(4, 1, grd1.GetCellData("bd_cell14", 0) ) '수량	
					
					Table030.SetCellString(5, 0, "CFD배당단수주대금입금일")
					Table030.SetCellString(6, 0, "CFD배당단수주대금입금")
				end if 
				
				'단수주수 또는 단수주지급일자
				'if Trim(g_szFRSKQty) == "" or Trim(g_szFRSKDate) == "" then
