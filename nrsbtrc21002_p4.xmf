					Table030.SetCellString(5, 0, "")
					Table030.SetCellString(5, 1, "")
				else
					Table030.SetCellString(5, 1, g_szFRSKDate) 'CFD배당단수주대금입금일/출금일
				end if 
			
				'단수주수 또는 단수주대금(세전)
