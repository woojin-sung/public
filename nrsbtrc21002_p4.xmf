					Table030.SetCellString(6, 0, "")					
					Table030.SetCellString(6, 1, "")					
				else
					Table030.SetCellMaskInfo(6, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")
					Table030.SetCellString(6, 1, g_szFRSK) 'CFD배당단수주대금입금/출금
				end if 
			end if 
	End Select
end Function 


'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim sTemp
	grd1.rowcount = 0	
	szData = Form.GetOpenLinkData()
	if szData <> "" then
		grd1.AddRow(0)
		tData = Split(szData, "★")
		For i = 0 to grd1.colcount -1  ' 33개
			grd1.SetCellData("bd_cell"&CStr(i), 0, tData(i))
		Next			
		
		g_szItemCd = tData(8) '종목코드
		g_szItemNm = tData(9) '종목코드
		g_szRghtCd = tData(4) '권리유형코드
		g_szRghtNm = tData(5) '권리유형명		
		g_szStatCd = tData(6) '상태처리코드		
		g_szStndDate = tData(10) '기준일
		g_szWrhsDate = tData(16) '입고일
		lblItem.caption = "[" & g_szItemCd & "]" & g_szItemNm
		
		lblDate.caption = "기준일 "& Left(g_szStndDate, 4) &"."& Mid(g_szStndDate, 5, 2) &"."& Right(g_szStndDate, 2) 

		'단수주수량이 0 이상일 경우에만 단수주지금일, 단수주금액이 보여짐
		'단수주수량은 소숫점(10자리)이나 금액은 정수로 나옴.. 23-10-18
		'단수주수량
		if grd1.GetCellData("bd_cell28", 0) <> nil then 
			g_szFRSKQty = CDbl(grd1.GetCellData("bd_cell28", 0))
			if g_szFRSKQty == "0" or g_szFRSKQty == 0 then
				g_szFRSKQty = ""
			end if
		else 
			g_szFRSKQty = ""
		end if 		
		'단수주대금(세전)
		if grd1.GetCellData("bd_cell30", 0) <> nil then 
			g_szFRSK = CDbl(grd1.GetCellData("bd_cell30", 0))
			if g_szFRSK == "0" or g_szFRSK == 0 then
				g_szFRSK = ""
			else
				'g_szFRSK = g_szFRSK & " " & grd1.GetCellData("bd_cell11", 0) '단수주대금(세전)
				g_szFRSK = g_szFRSK '단수주대금(세전)
			end if
		else 
			g_szFRSK = ""
		end if
		'단수주지급일
		g_szFRSKDate = Trim(grd1.GetCellData("bd_cell19", 0))	
		
		'매매구분코드
		g_szPSTNCd = grd1.GetCellData("bd_cell7", 0) ' 1.매도 2.매수
		if g_szPSTNCd == "1" then
			g_szPSTNNm = "매수"
		elseif g_szPSTNCd == "2" then
			g_szPSTNNm = "매도"
		else
			g_szPSTNNm = ""
		end if 
		
		SetVisible()
		SetData()	
	else

	end if 
End Sub

'============================================================================
' Form_OnFormClose 
'============================================================================
Sub Form_OnFormClose()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnSave_OnClick()
	Form.CloseForm()	
End Sub
	</SCRIPT_INFO>
</ROOT>