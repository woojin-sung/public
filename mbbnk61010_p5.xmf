'============================================================================
' 01. 화 면 명 : 최근이체/입금지정계좌
' 02. 화면설명 : 최근이체 or 입금지정 조회선택 팝업화면
' 03. 작    성 : 2016.02.27 ~ Test3
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szAccountNumber	'계좌번호 (10)
Dim g_szUserJumin		'실명확인번호(주민번호)
Dim g_szUserNum			'고객번호
Dim g_szIRow			'선택된 행의 인덱스

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================






'============================================================================
Sub Form_OnFormInit()
    
    g_szAccountNumber = Form.GetOpenLinkData()
    sFlag = Form.GetSharedData("61010_p5", True )

	tabOften.currenttab = sFlag
	tabOften_OnTabChanged(CInt(sFlag))
	if tabOften.currenttab = "0" then    	
	   DATAMANAGER.RequestTranData("obrtp_tran_032r")
	   Label10.caption = "최근이체계좌"
	elseif tabOften.currenttab = "1" then
	   DATAMANAGER.RequestTranData("obpds_srvc_409r")
	   Label10.caption = "입금지정계좌"
	end if   
'	DATAMANAGER.RequestTranData("obrtp_tact_002r")

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obrtp_tran_032r" then
		DATAMANAGER.SetDataValue(0, "obrtp_tran_032r", "InBlock1", "ACNO" , 0 , Left(g_szAccountNumber, 8))
		DATAMANAGER.SetDataValue(0,  "obrtp_tran_032r", "InBlock1", "ASNO", 0 , Right(g_szAccountNumber, 2))
	elseif szTranID == "obpds_srvc_409r" then
	    'DATAMANAGER.SetDataValue(0, "obpds_srvc_409r", "InBlock1", "IQRY_CSNU" , 0 , "0" )
	    'DATAMANAGER.SetDataValue(0, "obpds_srvc_409r", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
	    DATAMANAGER.SetDataValue(0, "obpds_srvc_409r", "InBlock1", "ACNO" , 0 , Left( g_szAccountNumber, 8 ) )
	    'DATAMANAGER.SetDataValue(0, "obpds_srvc_409r", "InBlock1", "ASNO" , 0 , Right(g_szAccountNumber, 2 ) )
	end if
	
End Sub

'============================================================================
Sub tabOften_OnTabChanged(nCurrentTab)
	If nCurrentTab = 0 then
	   DATAMANAGER.RequestTranData("obrtp_tran_032r")
	   Label10.caption = "최근이체계좌"
	ElseIf nCurrentTab = 1 then
	   DATAMANAGER.RequestTranData("obpds_srvc_409r")
	   Label10.caption = "입금지정계좌"
	End If   
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrtp_tran_032r" then	'최근계좌조회
'	  nCnt = DATAMANAGER.GetDataCount(0, "obrtp_tact_002r", "OutBlock1")
'	  if nCnt >0 then
'		 for i=0 to nCnt-1
'			if DATAMANAGER.GetDataValue(0, "obrtp_tact_002r", "OutBlock1", "BANK_CODE" , i) == "" or DATAMANAGER.GetDataValue(0, "obrtp_tact_002r", "OutBlock1", "BANK_CODE" , i) == "287" then
'				Dim szTempAccount', szTempNickName
'				'tabOften.page004401.grdOften.SetCellData( "bd_cell1", i, "메리츠종금증권" )	'은행명
'				tabOften.page004401.grdOften.SetCellData( "bd_cell2", i, DATAMANAGER.GetDataValue(0, "obrtp_tact_002r", "OutBlock1", "CNFT_ACNM" , i) )	'상대계좌명
'				szTempAccount = tabOften.page004401.grdOften.GetCellData( "bd_cell6", i ) & tabOften.page004401.grdOften.GetCellData( "bd_cell7", i )
'				tabOften.page004401.grdOften.SetCellData( "bd_cell1", i, szTempAccount)	'계좌번호				
'			else
'				tabOften.page004401.grdOften.SetCellData( "bd_cell2", i, DATAMANAGER.GetDataValue(0, "obrtp_tact_002r", "OutBlock1", "BANK_ACNM" , i) )	
'				tabOften.page004401.grdOften.SetCellData( "bd_cell1", i, DATAMANAGER.GetDataValue(0, "obrtp_tact_002r", "OutBlock1", "BANK_USE_ACNO" , i))	'계좌번호
'			end if	
'		  next
'	  end if
	elseif szTranID == "obpds_srvc_409r" then	'입금지정계좌
		for i=0 to DATAMANAGER.GetDataCount(0, "obpds_srvc_409r", "OutBlock1")-1
		    szCode = DATAMANAGER.GetDataValue(0, "obpds_srvc_409r", "OutBlock1", "BANK_CODE" , i)
		    szName = Form.GetMetaData("은행코드", szCode)
		    tabOften.page003622.grdAgree.SetCellData("bd_cell0", i, szName)	
'			if  szCode == "" or  szCode == "287" then	
'			   tabOften.page003622.grdAgree.SetCellData( "bd_cell1", i, DATAMANAGER.GetDataValue(0, "obpds_srvc_409r", "OutBlock1", "TACT_BANK_ACNM" , i ))
'			end if 
		next	
	end if
End Sub

'============================================================================
Sub tabOften_page002347_grdOften_OnClickUp(lRow, szCellID)
	Dim szCd, szAccNo , szAccNm , szBank , szData
	
	if lRow > -1 then
		szCd        = tabOften.page002347.grdOften.GetCellData("bd_cell4",       lRow)
		szAccNo     = tabOften.page002347.grdOften.GetCellData("bd_cell1",     lRow)
		szAccNm     = tabOften.page002347.grdOften.GetCellData("bd_cell2", lRow)	
		szBank      = tabOften.page002347.grdOften.GetCellData("bd_cell0",   lRow)	

		
		'  전달내용/은행코드/계좌번호/수취인/은행명
		szData = "자주계좌" & "★" & szCd & "★" & szAccNo & "★" & szAccNm & "★" & szBank
        
		Form.SendReturnToParent("61010_OFTEN", szData)''''''
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub tabOften_page003622_grdAgree_OnClickUp(lRow, szCellID)
	Dim szCd, szAccNo , szAccNm , szBank , szData	
	if lRow > -1 then
	  szCd        = tabOften.page003622.grdAgree.GetCellData( "bd_cell4",       lRow)
	  szAccNo     = tabOften.page003622.grdAgree.GetCellData("bd_cell1",     lRow)
	  szAccNm     = tabOften.page003622.grdAgree.GetCellData("bd_cell2", lRow)	
	  szBank      = tabOften.page003622.grdAgree.GetCellData("bd_cell0",   lRow)	
	  
	  '  전달내용/은행코드/계좌번호/수취인/은행명
	  szData = "자주계좌" & "★" & szCd & "★" & szAccNo & "★" & szAccNm & "★" & szBank
        
	  Form.SendReturnToParent("61010_OFTEN", szData)''''''
	  Form.CloseForm()
	end if  
End Sub

