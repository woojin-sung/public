'============================================================================
Function f_SetFromToDate(nIndex)
	sHostDate = Container0.CarFinDate.caption
	sTempHostDate = LEFT(sHostDate,4) & "-" & RIGHT(LEFT(sHostDate,6),2) & "-" & RIGHT(sHostDate,2)

	Select Case nIndex
		Case 0	'0:당일
			Container0.CalStaDate.caption = Container0.CarFinDate.caption
	
		Case 1	'1주일
			Container0.CalStaDate.caption = Replace(DateAdd("d",-7,sTempHostDate), "-", "")
			
		Case 2	'1개월
			Container0.CalStaDate.caption = Replace(DateAdd("m",-1,sTempHostDate), "-", "")
			
		Case 3	'3개월
			Container0.CalStaDate.caption = Replace(DateAdd("m",-3,sTempHostDate), "-", "")		
			
	End Select
End Function

'============================================================================
Sub Container0_grdData_OnClickUp(lRow, szCellID)
	Dim szData

	'---------주문취소시 필수 START-------------
	g_Order_ProsCode	= "2"	'처리구분코드(PROS_CLS_CODE)
'	g_AccNo		= Container0.cmbAccount.total
'	g_AccSeq		= Container0.cmbAccount.sequence
	g_AccNo		= g_szAcno
	g_AccSeq		= g_szAsno
	g_IsCd		= Container0.grdData.GetCellData("bd_ISCD", lRow)
	g_Deal_Qty	= Container0.grdData.GetCellData("bd_DEAL_QTY", lRow)
	g_DEAL_AMT	= Container0.grdData.GetCellData("bd_DEAL_AMT", lRow)
	g_Order_Date 	= Container0.grdData.GetCellData("bd_ODER_DATE" , lRow)	'주문일자(ODER_DATE)
	g_Order_Srno 	= Container0.grdData.GetCellData("bd_OM_ODER_SRNO" , lRow)	'장외주문일련번호(OM_ODER_SRNO)
	g_Oms_Srno 	= Container0.grdData.GetCellData("bd_OMS_SRNO" , lRow)	'장외결제일련번호(OMS_SRNO)
	'---------주문취소시 필수 END-------------

	szAccNoSeq = g_AccNo & g_AccSeq
	
	szISNM		= Container0.grdData.GetCellData("bd_KOR_ISNM", lRow)
	szDealClsCode	= Container0.grdData.GetCellData("bd_DEAL_CLS_CODE", lRow)
	szGNRL_INTRT	= Container0.grdData.GetCellData("bd_GNRL_INTRT", lRow)
	szPBLC_DATE	= Container0.grdData.GetCellData("bd_PBLC_DATE", lRow)
	szMTRT_DATE	= Container0.grdData.GetCellData("bd_MTRT_DATE", lRow)

	if szDealClsCode  == "2" then
		szDealClsNm = "매수"
	end if

	if szCellID == "bd_cell44" then '취소하기		
		if Trim(Container0.grdData.GetCellData("bd_cell44", lRow)) == "" then
			Exit Sub
		else		
			'계좌번호&계좌순번, 종목코드, 종목명, 매매구분, 액면금액, 결제금액
			szData = ""
			szData = szAccNoSeq & "★" & g_IsCd & "★" & szISNM & "★" & szDealClsNm & "★" & g_Deal_Qty & "★" & g_DEAL_AMT 
			
			if Container0.grdData.GetCellData("bd_ODER_PROS_RSLT_CLS_CODE", lRow)  == "03" then
				Form.openPopupAnimation( "mbonl88061_p2" , szData , "", "2")
			end if
		end if
		
	elseif szCellID == "bd_cell108" then	'상세보기
	
		if Trim(Container0.grdData.GetCellData("bd_cell108", lRow)) == "" then
			Exit Sub
		else		
			'2023.03.06 ADD
			DATAMANAGER.RequestTranData("obsac_deal_210r")	'전자단기사채 온라인매수 투자확인서 출력


'			'종목명, 매매구분, 액면금액(수량), 결제금액, 수익률, 세금납입방식, 신청일, 매수일, 만기일
'			szData = ""
'			szData = szISNM & "★" & szDealClsNm & "★" & g_Deal_Qty & "★" & g_DEAL_AMT & "★" & szGNRL_INTRT & "★" & "후취" & "★" & g_Order_Date & "★" & szPBLC_DATE  & "★" & szMTRT_DATE
'			
'			Form.openPopupAnimation( "mbonl88061_p1", szData, "", "2")
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "Cancel_Success" then
		if sRet == "close" then
		
			'20230224
			f_ResetFn()
			'20230224
			
			DATAMANAGER.RequestTranData( "obsap_deal_004r" )
			DATAMANAGER.RequestTranData("obsap_deal_004r_1")	'장외_전단채매수신청내역 보유건수 조회
'			'2023.03.06 ADD
