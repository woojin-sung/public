	<SCRIPT_INFO _len="32758" _ulen="29996" >
'============================================================================
' 2023.05.26. 김유경 : v001. 유통물의 매수일자 변경
'============================================================================

'============================================================================
' 단기사채 매매
'============================================================================

Dim g_plain_rm  		'v0002 메모리평문적용여부

'' 주문취소시 값
Dim g_Order_ProsCode
Dim g_AccNo
Dim g_AccSeq
Dim g_IsCd
Dim g_Deal_Qty
Dim g_DEAL_AMT
Dim g_Order_Date
Dim g_Order_Srno
Dim g_Oms_Srno

Dim g_SHTR_BOND_REG_CLS_CODE 'v001

Dim g_szAcno
Dim g_szAsno

'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.setMaintainingRatio("1")
	Container0.Image1.setMaintainingRatio("5")
	Container0.grdData.SetMaintainingRatio("bd_cell41", 0, "1")
	
	Container0.imgArrow.SetMaintainingRatio("1")
	Container0.imgArrow2.SetMaintainingRatio("1")
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		Container0.setScrollBarVisible("2")
	end if
	
End Sub

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	Container0.cmbProdCd.left 	= 205
	Container0.cmbPridGb.left 	= 292
	Container0.imgArrow.left	= 250
	Container0.imgArrow2.left	= 335
	
	
'	Container0.grdData.setUseCardView(true, 15, "btn_12_n.9")
	
	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	Container0.lblTotalCnt.caption = "0건 보유 >"
	Container0.lblTotalCnt.changeTextAttr(0, 2, "", 1, true)
	
	'20230908 단기사채 고객별 최근거래계좌 조회
'	DATAMANAGER.RequestTranData( "obsac_deal_216r" )
	
	'계좌 체크
	if Container0.cmbAccount.caption <> "" and Container0.cmbAccount.caption <> null then 
		Dim szOpenData
		szOpenData = Form.GetOpenLinkData()
		if InStr(szOpenData, "88063") > 0 then
			Form.SetTimerEvent2(2, 1, 1)
		else
'			DATAMANAGER.RequestTranData("obsap_deal_004r")	'장외_전단채매수신청내역다건조회
'			DATAMANAGER.RequestTranData("obsap_deal_004r_1")	'장외_전단채매수신청내역 보유건수 조회
			
			'20230908 단기사채 고객별 최근거래계좌 조회
			DATAMANAGER.RequestTranData( "obsac_deal_216r" )
			
		end if
'		'2023.03.06 ADD
'		DATAMANAGER.RequestTranData("obsac_deal_210r")	'전자단기사채 온라인매수 투자확인서 출력
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				DATAMANAGER.RequestTranData( "obsac_deal_209a" )	'온라인 전단채 매수취소 신청
			end if
		end if
		
	'===============================================
	'********** 신청내역 취소 팝업       ***********
	'===============================================
	elseif sKeyName == "mbonl88061_p2" then
		if sRet == "cancel" then
			Dim sSendData
'			sSendData = Container0.cmbAccount.total&Container0.cmbAccount.sequence&"☆"&"0"
			sSendData = g_szAcno&g_szAsno&"☆"&"0"
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")
		end if
		
	'===============================================
	'********** 공통 얼럿 팝업 리턴      ***********
	'===============================================
	ElseIf sKeyName == "errMsgBox"  Then
		if sRet = "Mid" then	'목록 재조회
			DATAMANAGER.RequestTranData( "obsap_deal_004r" )
			DATAMANAGER.RequestTranData("obsap_deal_004r_1")	'장외_전단채매수신청내역 보유건수 조회
'			'2023.03.06 ADD
'			DATAMANAGER.RequestTranData("obsac_deal_210r")	'전자단기사채 온라인매수 투자확인서 출력
		end if	
		
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obsap_deal_004r" then
		'f_ResetFn()
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szAcno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , g_szAsno )
'		'v0002 컨트롤매핑->스크립트 변경
'		if g_plain_rm == "1" then
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD" , 0 , edtPassword.caption)	'비밀번호
'		else
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD" , 0 , Form.GetCtlProp("edtPassword", "encdata"))
'		end if
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "STA_DATE" , 0 , Container0.CalStaDate.caption )	'시작일자
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIN_DATE" , 0 , Container0.CarFinDate.caption )	'종료일자
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "INVT_TRGT_TYPE_CODE" , 0 , Container0.cmbProdCd.cbkeydata )	'투자대상유형코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ODER_PROS_RSLT_CLS_CODE" , 0 , "%" )	'주문처리결과구분코드(%:전체/03:매수신청완료/04:결제완료)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNCL_YN" , 0 , "%" )	'취소여부
		
	elseif szTranID == "obsap_deal_004r_1" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szAcno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , g_szAsno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "STA_DATE" , 0 , Container0.CalStaDate.caption )	'시작일자
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIN_DATE" , 0 , Container0.CarFinDate.caption )	'종료일자
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "INVT_TRGT_TYPE_CODE" , 0 , Container0.cmbProdCd.cbkeydata )	'투자대상유형코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ODER_PROS_RSLT_CLS_CODE" , 0 , "%" )	'주문처리결과구분코드(%:전체/03:매수신청완료/04:결제완료)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNCL_YN" , 0 , "%" )	'취소여부

	elseif szTranID == "obsac_deal_210r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ODER_DATE" , 0 , g_Order_Date )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OM_ODER_SRNO" , 0 , g_Order_Srno )

	'전자단기사채 온라인 매수취소 처리
	elseif szTranID == "obsac_deal_209a" then
		g_Order_ProsCode = "2"
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , g_Order_ProsCode)	'1:신청/2:취소
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , g_AccNo )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , g_AccSeq )
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD" , 0 , g_IsCd )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODQT" , 0 , g_Deal_Qty )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "DEAL_AMT" , 0 , g_DEAL_AMT )
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_DATE" , 0 , g_Order_Date)	'주문일자
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OM_ODER_SRNO" , 0 , g_Order_Srno)	'장외주문일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OMS_SRNO" , 0 , g_Oms_Srno)	'장외결제일련번호
	
	'단기사채 고객별 최근거래계좌 조회
	elseif szTranID == "obsac_deal_216r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , Container0.cmbAccount.total )
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obsap_deal_004r" then 
		Dim nCnt, nGridCnt
		nCnt 	= CDBL(DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock1" ))
		nGridCnt	= CInt(Container0.grdData.rowcount)

		if nCnt > 0 then
			Container0.grdData.height = 273 * nGridCnt ' 그리드 한칸 높이 273
			
			'20230224
			Container0.Button0.top = 273 * (nGridCnt+1) + 45
			Container0.lblButtonBottom.top = 273 * (nGridCnt+1) + 75
			'20230224
			
			'20230224
			'Container0.SetScrollAutoSize()
			'Container0.scroll_pos = 0
			'20230224
			
			for i = (nGridCnt - nCnt) to nGridCnt - 1
				Dim sTODAY, sMTRT_DATE
				sTODAY		= CInt(Form.GetSharedData("&HOST_DATE", false))
				sMTRT_DATE	= CInt(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "MTRT_DATE", i))
				
				if sTODAY > sMTRT_DATE then
					Container0.grdData.SetCellData("bd_cell94", i, "상환")
					Container0.grdData.SetCellFgColor("bd_cell94", i, 200)
				end if
				
				Container0.grdData.SetCellData("bd_cell23", i, "매수")
				Container0.grdData.SetCellFgColor("bd_cell23", i, 326)

				Container0.grdData.SetCellData("bd_cell66", i, "단기사채")
				Container0.grdData.SetCellFgColor("bd_cell66", i, 333)
				
				Container0.grdData.SetCellData("bd_cell35", i, "매수신청일")
				Container0.grdData.SetCellFgColor("bd_cell35", i, 333)
				Container0.grdData.SetCellData("bd_cell37", i, "만기일")
				Container0.grdData.SetCellFgColor("bd_cell37", i, 333)
				Container0.grdData.SetCellData("bd_cell43", i, "액면금액")
				Container0.grdData.SetCellFgColor("bd_cell43", i, 333)
	
'				Container0.grdData.SetCellData("bd_cell34", 		i, "결제완료")
'				Container0.grdData.SetCellFgColor("bd_cell34", 	i, 333)
				Container0.grdData.SetCellData("bd_cell120", 		i, "매수완료")
				Container0.grdData.SetCellFgColor("bd_cell120", 	i, 333)

				Dim sODER_PROS_RSLT_CLS_CODE, sCNCL_YN
				sODER_PROS_RSLT_CLS_CODE 	= Container0.grdData.GetCellData("bd_ODER_PROS_RSLT_CLS_CODE", i)	' 주문처리결과구분코드
				sCNCL_YN 				= Container0.grdData.GetCellData("bd_CNCL_YN", i) 				' 취소여부
					
				'2023.03.06 ADD
				g_Order_Date 	= Container0.grdData.GetCellData("bd_ODER_DATE" , lRow)	'주문일자(ODER_DATE)
				g_Order_Srno 	= Container0.grdData.GetCellData("bd_OM_ODER_SRNO" , lRow)	'장외주문일련번호(OM_ODER_SRNO)
	
				'v001. 유통물의 매수일자 변경
				g_SHTR_BOND_REG_CLS_CODE 	= Container0.grdData.GetCellData("bd_cell84", lRow)	'단기사채등록구분코드
					
				' ------------------------------------------------------------
				' 매수완료
				if sODER_PROS_RSLT_CLS_CODE == "04" then				
					Container0.grdData.SetCellData("bd_cell108", 		i, "상세보기")
					
					Container0.grdData.SetCellData("bd_cell44", 		i, "")
					
					Container0.grdData.SetCellData("bd_cell47", 		i, "매수신청")	'발행준비중
					Container0.grdData.SetCellFgColor("bd_cell47", 	i, 333)
				
					Container0.grdData.SetCellFgColor("bd_cell120", 	i, 326) ' 매수완료 빨간글씨
					
				' ------------------------------------------------------------
				' 발행준비중(취소완료/매수신청) 
				elseif sODER_PROS_RSLT_CLS_CODE == "03" then
				
					' ------------------------------------------------------------
					' 취소완료
					if sCNCL_YN = "Y" then
						Container0.grdData.SetCellData("bd_cell108", 		i, "")

						Container0.grdData.SetCellData("bd_cell44", 		i, "")
						
						Container0.grdData.SetCellData("bd_cell47", 		i, "취소완료")
						Container0.grdData.SetCellFgColor("bd_cell47", 	i, 334)
						
					' ------------------------------------------------------------
					' 발행준비중
					else
						Container0.grdData.SetCellData("bd_cell108", 		i, "상세보기")

						Container0.grdData.SetCellData("bd_cell44", 		i, "취소하기")
						Container0.grdData.SetCellFgColor("bd_cell44", 	i, 333)
						
						Container0.grdData.SetCellData("bd_cell47",		i, "매수신청")	'발행준비중
						Container0.grdData.SetCellFgColor("bd_cell47", 	i, 326)
					end if
					
				end if		

			next

		end if

		
		
		'안드로이드인 경우, 타이머 이벤트에서 그리드 이미지 세팅
		if  Form.GetSharedData("&OS_TYPE", false ) == "1" then 'iOS("2")Android("1")
			Form.SetTimerEvent2(1, 1, 0.1)
		else
			f_GridSetForiOS()
		end if
		
	elseif szTranID == "obsap_deal_004r_1" then
		sSHTR_BOND_HLDN_CSNU = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "SHTR_BOND_HLDN_CSNU", 0))
		
		Container0.lblTotalCnt.caption = sSHTR_BOND_HLDN_CSNU & "건 보유 >"
		Container0.lblTotalCnt.changeTextAttr(0, Len(trim(sSHTR_BOND_HLDN_CSNU)) + 1, "", 1, true)	
		
	elseif szTranID == "obsac_deal_210r" then
		nSTAS_AMT = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "STAS_AMT", 0))
		nINTX = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INTX", 0))
		nRSTX = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSTX", 0))
		nSELN_EXCL_AMT = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SELN_EXCL_AMT", 0))
		
		nTotTax = nINTX + nRSTX
		
		'상세 팝업 오픈!
		
		'v001. 유통물의 매수일자 변경(매수일: 발행일자 -> 매수신청일자
		If g_SHTR_BOND_REG_CLS_CODE == "2" then	'유통물
			'종목명, 매매구분, 액면금액(수량), 결제금액, 수익률, 세금납입방식, 신청일, 매수일(매수신청일자), 만기일
			szData = ""
			szData = szISNM & "★" & szDealClsNm & "★" & g_Deal_Qty & "★" & g_DEAL_AMT & "★" & szGNRL_INTRT & "★" & "후취" & "★" & nSTAS_AMT  & "★" & nTotTax  & "★" & nSELN_EXCL_AMT & "★" & g_Order_Date & "★" & g_Order_Date & "★" & szMTRT_DATE
		Else	
			'종목명, 매매구분, 액면금액(수량), 결제금액, 수익률, 세금납입방식, 신청일, 매수일(발행일자), 만기일
			szData = ""
			szData = szISNM & "★" & szDealClsNm & "★" & g_Deal_Qty & "★" & g_DEAL_AMT & "★" & szGNRL_INTRT & "★" & "후취" & "★" & nSTAS_AMT  & "★" & nTotTax  & "★" & nSELN_EXCL_AMT & "★" & g_Order_Date & "★" & szPBLC_DATE  & "★" & szMTRT_DATE		
		End If
		
		Form.openPopupAnimation( "mbonl88061_p1", szData, "", "2")
		
	elseif szTranID == "obsac_deal_209a" then	'전자단기사채 온라인 매수취소 처리
		sOM_ODER_SRNO = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OM_ODER_SRNO" , 0)

		g_ErrTitle = "안내"
		g_ErrMsgText = "단기사채 주문이\n취소 되었습니다."
		szAlertData = "1".."★"..g_ErrTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."확인"'.."★".."투자성향 등록"
		
		Form.OpenPopup("mbonl88060_p8", szAlertData, "")
		
'		Form.MsgBox("알림", "단기사채 주문이\n취소 되었습니다.", "Cancel_Success", 0)
	
	'단기사채 고객별 최근거래계좌 조회
	elseif szTranID == "obsac_deal_216r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
'		Form.ShowAlert("nCnt", nCnt)
		
		if DATAMANAGER.IsMoreNextData(szTranID) then
			DATAMANAGER.RequestNextData(szTranID)
		else
			Dim nGrdCnt
			nGrdCnt = CInt(grdAcnt.rowcount)
			
			if nGrdCnt > 0 then
				for i = 0 to nGrdCnt - 1
					Dim szAcno, szAsno, szPrnm, szName
					szAcno = grdAcnt.GetCellData("bd_acno", i)
					szAsno = grdAcnt.GetCellData("bd_asno", i)
					szPrnm = grdAcnt.GetCellData("bd_prnm", i)
					szName = grdAcnt.GetCellData("bd_name", i)
					
					Container0.cmbAcnt.cbadddatatext = szAcno & szAsno & "`" & "[" & szPrnm & "] " & Left(szAcno, 4) & "-" & Right(szAcno, 4) & "-" & szAsno & " " & szName
				next
				
				g_szAcno = Left(Container0.cmbAcnt.cbkeydata, 8)
				g_szAsno = Right(Container0.cmbAcnt.cbkeydata, 2)
'				Form.ShowAlert(g_szAcno, g_szAsno)
				
				DATAMANAGER.RequestTranData("obsap_deal_004r")	'장외_전단채매수신청내역다건조회
				DATAMANAGER.RequestTranData("obsap_deal_004r_1")	'장외_전단채매수신청내역 보유건수 조회
			end if
		end if
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szTranID == "obsap_deal_004r" then
	
		
		if szErrCode == "9906" then
			Form.ShowAlert( "알림" , szSubErr)
			Exit Sub
		end if
	'KEK 9906, 7246.에러코드추가
	elseif szTranID == "obsac_deal_209a" then
		if szErrCode == "7246" or szErrCode == "9906" then
			Form.ShowAlert( "알림" , szSubErr)
			'Exit Sub
		end if
		
	else
	
		if szSubErr <> null and Trim(szSubErr) <> "" then
			Form.ShowAlert( "알림" , szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
		else
			Form.ShowAlert( "알림" , szErrCode .. " : ".. szErrMsg)
		end if
		
	end if

	'KEK STA.
	'계좌 체크
	if szTranID <> "obsap_deal_004r" and szTranID <> "obsap_deal_004r_1" then
		DATAMANAGER.RequestTranData("obsap_deal_004r")	'장외_전단채매수신청내역다건조회
		DATAMANAGER.RequestTranData("obsap_deal_004r_1")	'장외_전단채매수신청내역 보유건수 조회
	end if
	'KEK FIN.
'	'2023.03.06 ADD
'	DATAMANAGER.RequestTranData("obsac_deal_210r")	'전자단기사채 온라인매수 투자확인서 출력
End Sub

