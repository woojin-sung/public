'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(sTimerID, 0, 0)
	
	if Cint(sTimerID) = 1 then
		Dim nCnt, nGridCnt
		nCnt 	= CDBL(DATAMANAGER.GetDataCount(0,"obsap_deal_004r" , "OutBlock1"))
		nGridCnt	= CInt(Container0.grdData.rowcount)
		
		if nCnt == 0 then
			Container0.lblNoData.visible	= 1
			
		elseif nCnt > 0 then
			Container0.lblNoData.visible	= 0
			
'			' 데이터 건수에 맞게 그리드, 컨테이너 조절
'			Container0.grdData.height = 263 * nCnt ' 그리드 한칸 높이 263
'			Container0.SetScrollAutoSize()
'			Container0.scroll_pos = 0
			
			for i = (nGridCnt - nCnt) to nGridCnt - 1
				
				if CInt(Form.GetSharedData("&HOST_DATE", false)) > CInt(Container0.grdData.GetCellData("bd_MTRT_DATE", i)) then
					Container0.grdData.SetCellImage("bd_cell94", i, "bg_tag_sell.png")
				end if
				
				Container0.grdData.SetCellImage("bd_cell23", i, "bg_tag_buy.9.png")
				Container0.grdData.SetCellImage("bd_cell66", i, "bg_tag_default.9.png")

				Dim sODER_PROS_RSLT_CLS_CODE, sCNCL_YN, sRCRT_FIN_DATE, sRCRT_CLSN_HOUR
				sODER_PROS_RSLT_CLS_CODE 	= Container0.grdData.GetCellData("bd_ODER_PROS_RSLT_CLS_CODE",	i)	' 주문처리결과구분코드
				sCNCL_YN 				= Container0.grdData.GetCellData("bd_CNCL_YN", 				i) 	' 취소여부
				sRCRT_FIN_DATE			= Container0.grdData.GetCellData("bd_RCRT_FIN_DATE", 			i) 	' 모집종료일자
				sRCRT_CLSN_HOUR			= Container0.grdData.GetCellData("bd_RCRT_CLSN_HOUR", 			i) 	' 모집마감시간
				' ------------------------------------------------------------
				' 매수완료
				if sODER_PROS_RSLT_CLS_CODE == "04" then				
					Container0.grdData.SetMaintainingRatio("bd_cell41", i, "1")
					Container0.grdData.SetCellImage("bd_cell41", 		i, "icon_arrow_right2.png")		
					Container0.grdData.SetCellImage("bd_StatusBar", 	i, "img_progressbar_payment03.png")
					
				' ------------------------------------------------------------
				' 발행준비중(취소완료/발행준비중) 
				elseif sODER_PROS_RSLT_CLS_CODE == "03" then
				
					' ------------------------------------------------------------
					' 취소완료
					if sCNCL_YN = "Y" then
						Container0.grdData.SetMaintainingRatio("bd_cell41", i, "1")
						Container0.grdData.SetCellImage("bd_cell41", 		i, "alpha")
						Container0.grdData.SetCellImage("bd_StatusBar", 	i, "img_progressbar_cancel.png")
						
					' ------------------------------------------------------------
					' 발행준비중
					else
						Container0.grdData.SetMaintainingRatio("bd_cell41", i, "1")
						Container0.grdData.SetCellImage("bd_cell41", 		i, "icon_arrow_right2.png")
						Container0.grdData.SetCellImage("bd_StatusBar", 	i, "img_progressbar_payment02.png")
					end if
					
				end if
				
				' -------------------------------------------------------------------------------------------
				' 모집종료일자&모집마감시간 이후 취소 불가능
				if Form.GetSharedData("&HOST_DATE" , false) >= sRCRT_FIN_DATE and Form.GetSharedData("&HOST_TIME" , false) >= sRCRT_CLSN_HOUR then
					Container0.grdData.SetCellData("bd_cell44", i, "")
				end if
				' -------------------------------------------------------------------------------------------
			next

		end if
		
		'20230224
		if DATAMANAGER.IsMoreNextData("obsap_deal_004r") == true then
			'DATAMANAGER.RequestNextData("obsap_deal_004r")
			Container0.Button0.visible = true
			Container0.lblButtonBottom.visible = true
		else
			Container0.Button0.visible = false
			Container0.lblButtonBottom.visible = false
		end if
		
		Container0.SetScrollAutoSize()
		'20230224
		
	elseif Cint(sTimerID) == 2 then
		Form.SetTimerEvent2(2, 0, 1)
		
'		DATAMANAGER.RequestTranData("obsap_deal_004r")	'장외_전단채매수신청내역다건조회
'		DATAMANAGER.RequestTranData("obsap_deal_004r_1")	'장외_전단채매수신청내역 보유건수 조회
		
		'20230908 단기사채 고객별 최근거래계좌 조회
		DATAMANAGER.RequestTranData( "obsac_deal_216r" )
	end if	
	
End Sub

'============================================================================
' 리셋 함수
Function f_ResetFn()
	Container0.grdData.height = 0
	Container0.SetScrollAutoSize()
	Container0.scroll_pos = 0
	
	'20230224
	Container0.Button0.top = 548
	Container0.lblButtonBottom.top = 575
	Container0.Button0.visible = false
	Container0.lblButtonBottom.visible = false
	'20230224
	
End Function

'============================================================================
Function f_GridSetForiOS()
	
	Dim nCnt, nGridCnt
	nCnt 	= CDBL(DATAMANAGER.GetDataCount(0,"obsap_deal_004r" , "OutBlock1"))
	nGridCnt	= CInt(Container0.grdData.rowcount)
		
	if nCnt == 0 then
		Container0.lblNoData.visible	= 1
			
	elseif nCnt > 0 then
		Container0.lblNoData.visible	= 0
			
		' 데이터 건수에 맞게 그리드, 컨테이너 조절
		'Container0.grdData.height = 263 * nCnt ' 그리드 한칸 높이 263
		'Container0.SetScrollAutoSize()
		'Container0.scroll_pos = 0
			
		for i = (nGridCnt - nCnt) to nGridCnt - 1

			if CInt(Form.GetSharedData("&HOST_DATE", false)) > CInt(Container0.grdData.GetCellData("bd_MTRT_DATE", i)) then
				Container0.grdData.SetCellImage("bd_cell94", i, "bg_tag_sell.png")
			end if
				
			Container0.grdData.SetCellImage("bd_cell23", i, "bg_tag_buy.9.png")
			Container0.grdData.SetCellImage("bd_cell66", i, "bg_tag_default.9.png")

			Dim sODER_PROS_RSLT_CLS_CODE, sCNCL_YN, sRCRT_FIN_DATE, sRCRT_CLSN_HOUR
			sODER_PROS_RSLT_CLS_CODE 	= Container0.grdData.GetCellData("bd_ODER_PROS_RSLT_CLS_CODE",	i)	' 주문처리결과구분코드
			sCNCL_YN 				= Container0.grdData.GetCellData("bd_CNCL_YN", 				i) 	' 취소여부
			sRCRT_FIN_DATE			= Container0.grdData.GetCellData("bd_RCRT_FIN_DATE", 			i) 	' 모집종료일자
			sRCRT_CLSN_HOUR			= Container0.grdData.GetCellData("bd_RCRT_CLSN_HOUR", 			i) 	' 모집마감시간
			' ------------------------------------------------------------
			' 매수완료
			if sODER_PROS_RSLT_CLS_CODE == "04" then				
				Container0.grdData.SetMaintainingRatio("bd_cell41", i, "1")
				Container0.grdData.SetCellImage("bd_cell41", 		i, "icon_arrow_right2.png")		
				Container0.grdData.SetCellImage("bd_StatusBar", 	i, "img_progressbar_payment03.png")
			
			' ------------------------------------------------------------
			' 발행준비중(취소완료/발행준비중) 
			elseif sODER_PROS_RSLT_CLS_CODE == "03" then
		
				' ------------------------------------------------------------
				' 취소완료
				if sCNCL_YN = "Y" then
					Container0.grdData.SetMaintainingRatio("bd_cell41", i, "1")
					Container0.grdData.SetCellImage("bd_cell41", 		i, "alpha")
					Container0.grdData.SetCellImage("bd_StatusBar", 	i, "img_progressbar_cancel.png")
				
				' ------------------------------------------------------------
				' 발행준비중
				else
					Container0.grdData.SetMaintainingRatio("bd_cell41", i, "1")
					Container0.grdData.SetCellImage("bd_cell41", 		i, "icon_arrow_right2.png")
					Container0.grdData.SetCellImage("bd_StatusBar", 	i, "img_progressbar_payment02.png")
				end if
			
			end if
				
			' -------------------------------------------------------------------------------------------
			' 모집종료일자&모집마감시간 이후 취소 불가능
			if Form.GetSharedData("&HOST_DATE" , false) >= sRCRT_FIN_DATE and Form.GetSharedData("&HOST_TIME" , false) >= sRCRT_CLSN_HOUR then
				Container0.grdData.SetCellData("bd_cell44", i, "")
			end if
			' -------------------------------------------------------------------------------------------
		next

	end if
	
	'20230224
	if DATAMANAGER.IsMoreNextData("obsap_deal_004r") == true then
		'DATAMANAGER.RequestNextData("obsap_deal_004r")
		Container0.Button0.visible = true
		Container0.lblButtonBottom.visible = true
	else
		Container0.Button0.visible = false
		Container0.lblButtonBottom.visible = false
	end if
	
	Container0.SetScrollAutoSize()
	'20230224
	
End Function

