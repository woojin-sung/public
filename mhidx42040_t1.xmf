'============================================================================
'해외 지수/종목 주기를 리턴해준다 . ( 종가 또는 지연)
'============================================================================
Function gf_GetForeignCycle(szCode)
' 20190603 HWG START : HTS 해외지수/종목 주기 동기화
'	Select Case szCode  
'		Case "DJI@DJI", "NAS@IXIC", "SPI@SPX", "DJI@DJC", "NYS@NYA", "USI@SOXX" '미국
'			return "종가"  
'		Case  "CME@ND", "CME@SP", "CME@NQ", "CME@ES"	', "USI@RUT" '미국 PSM3 2016.12.30 러셀2000지수 삭제
'			return"지연(15분)"
'		Case "HSI@HSCE", "SHS@000001", "SHS@000002", "SHS@000003","SZS@399107", "SZS@399108", "HSI@HSI"  '아시아
'	    		return "지연(15분)"  
'		Case "NII@NI225" 	'아시아
'			return "지연(20분)"    	    
'		Case "ILI@TA125", "TWS@TI01" 	'아시아 '20180619 HAMWG : 대만 가권지수 데이터제공 변경(지연20분->종가)
'			return "종가"  
'		Case "NLI@AEX", "PAS@CAC40", "INI@BSE30", "XTR@DAX30", "STX@SX5E"   	'유럽(네덜란드 AEX, 프랑스 CAC 40, 인도 SENSEX, 독일DAX, 유로스톡스50) ' 20190528 HWG : 해외지수추가 
'			return "종가"
'		Case "TRI@ISE100"   			'유럽(터키 ISE100)
'			return "지연(15분)"	    
'		Case "AUI@AORD" 				'미주/오세아니아주 
'			return "지연(20분)"   
'		Case "JPYKRWCOMP","CNYKRWCOMP" 	'원화포함 환율   "USDKRWSMBS", 
'			return "지연(5분)"   
'		Case "USDKRWSMBS", "EURUSDCOMP", "USDJPYCOMP","EURJPYCOMP", "GBPUSDCOMP", "USDCHFCOMP", "USDCADCOMP", "AUDUSDCOMP", "USDHKDCOMP", "USDSGDCOMP"  '원화가 없는 이종통화환율 실시간 	
'			return "실시간" 	
'	End Select
	
	Select Case szCode  
		case "DJI@DJI", "NAS@IXIC", "SPI@SPX", "DJI@DJC", "NYS@NYA", "NAS@SOX" '미국 '20190813 HWG : 미국 필라델피아 반도체 지수 심볼변경
		    return "종가"  
		    
		Case  "CME@ND", "CME@NQ", "CME@ES", "USI@RUT" '미국 '"CME@SP"20220209 HSZ S&P500 선물 삭제
		    return "지연(15분)"
		    
		Case "HSI@HSCE", "SZS@399107", "SZS@399108", "HSI@HSI", "SHS@000001", "SHS@000002", "SHS@000003" '아시아
		    return "지연(15분)"  
		
		Case "NII@NI225" '아시아
		    return "지연(20분)"    
		    
		Case "ILI@TA100", "ILI@TA125", "TWS@TI01", "INI@BSE30", "IDI@JKSE", "PHI@COMP", "VNI@VIDX"  '아시아 
		    return "종가"   
		
		Case "NLI@AEX", "PAS@CAC40", "XTR@DAX30", "STX@SX5E", "RUI@RTSI" '유럽
		    return "종가"
		
		Case "TRI@ISE100"	'유럽  			
		    return "지연(15분)"
		    
		Case "BRI@BVSP", "CAI@SPTSX", "ETC@DXY00", "MXI@IPC", "NZI@NZ50"	'미주/오세아니아주 
		    return "종가" 
		    
		Case "AUI@AORD" '미주/오세아니아주
		    return "지연(20분)"   
			
		Case "USDKRWSMBS", "EURUSDCOMP", "USDJPYCOMP","EURJPYCOMP", "GBPUSDCOMP", "USDCHFCOMP", "USDCADCOMP", "AUDUSDCOMP", "USDHKDCOMP", "USDSGDCOMP","CNYKRWCOMP", "JPYKRWCOMP"  
			return "실시간" 	

		Case "USDCNYCOMP", "USDTWDCOMP", "USDGBPCOMP", "USDBRLCOMP", "USDVNDCOMP", "USDEURCOMP", "GBPKRWCOMP", "EURKRWCOMP", "USDRUBCOMP", "USDQARCOMP", "USDOMRCOMP", "USDMYRCOMP", "USDJODCOMP", "USDKWDCOMP", "USDAEDCOMP", "USDIDRCOMP", "USDEGPCOMP", "USDILSCOMP", "USDARSCOMP", "USDMXNCOMP", "USDNZDCOMP", "USDAUDCOMP", "USDTHBCOMP", "USDSEKCOMP", "USDNOKCOMP", "USDSARCOMP", "USDDKKCOMP", "USDINRCOMP", "USDHUFCOMP", "USDTRYCOMP", "USDPHPCOMP", "BRLKRWCOMP"		 
			return "실시간"
	End Select
' 20190603 HWG END
End Function

'============================================================================
'TR_Query()
'============================================================================
Function TR_Query()
	dim szIdx
	szIdx = rdoCounty00.currentindex
	DATAMANAGER.ClearInputData(0, "ohhts_1682_001r")
	grd01.SetClear()
	
	if szIdx = "0" then	'전체		
	      DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" ,0 ,"N")
