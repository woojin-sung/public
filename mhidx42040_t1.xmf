Sub rdoCounty00_OnClick(nIndex)
	TR_Query()
End Sub


'============================================================================
'grd01_OnClickUp
'============================================================================
Sub grd01_OnClickUp(lRow, szCellID)
	dim szSymbol
	dim szMarket
	dim szName
	
	szSymbol = grd01.GetCellData("bd_cell0", lRow)
	szMarket = grd01.GetCellData("bd_cell1", lRow)
	szName = grd01.GetCellData("bd_cell2", lRow)
	
	Form.OpenFramePopup("mhidx42040_p1" , szSymbol & "★" &  szMarket & "★" & szName , sPosInfo)

End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	dim ncnt1682
	dim szOrgTime
		
	ncnt1682 = DATAMANAGER.GetDataCount(0, "ohhts_1682_001r" , "OutBlock1")
	
	if szTranID = "ohhts_1682_001r" then
		
		for i = 0 to ncnt1682 - 1
			szOrgTime = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_DATE", i)
			if szOrgTime = "" or szOrgTime = null then '20220302 HSZ : 예외처리 추가
				exit Sub
			else
				DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_DATE", i , mid(szOrgTIme,3,2) &  mid(szOrgTIme,5,2)  &  mid(szOrgTIme,7,2)  )
			end if
		next	
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim ncnt1682
	dim szRealCode
		
	ncnt1682 = DATAMANAGER.GetDataCount(0, "ohhts_1682_001r" , "OutBlock1")
	
	if szTranID = "ohhts_1682_001r" then
		
		for i = 0 to ncnt1682 - 1
			szRealCode = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_ISCD", i)
			grd01.SetCellData("bd_cell8", i, gf_GetForeignCycle(szRealCode))
		next	
		
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveRealData
'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	dim ncntOvrs
	dim ncntNfut
	dim szOrgTime, szOrgTime2
		
	ncntOvrs = DATAMANAGER.GetDataCount(1, "ohhts_ovrs_nmix", "OutBlock1")
	ncntNfut = DATAMANAGER.GetDataCount(1, "ohhts_nfut_cntg", "OutBlock1")
	if szTranID = "ohhts_ovrs_nmix" then
		
		for i = 0 to ncntOvrs - 1
			szOrgTime = DATAMANAGER.GetDataValue(1, "ohhts_ovrs_nmix", "OutBlock1", "FIDR_DATE", i)
			DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "OutBlock1", "FIDR_DATE", i , mid(szOrgTIme,3,2) &  mid(szOrgTIme,5,2)  &  mid(szOrgTIme,7,2)  )
		next	
	end if 

	if szTranID = "ohhts_nfut_cntg" then
		
		for i = 0 to ncntNfut - 1
			szOrgTime2 = DATAMANAGER.GetDataValue(1, "ohhts_nfut_cntg", "OutBlock1", "FIDR_DATE", i)
			DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg", "OutBlock1", "FIDR_DATE", i , mid(szOrgTime2,3,2) &  mid(szOrgTime2,5,2)  &  mid(szOrgTime2,7,2)  )
		next	
	end if 
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	TR_Query()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SELECT_RADIO" then
		if sParam == "아시아" then
			rdoCounty00.currentindex = "2"
		elseif sParam == "미국" then
			rdoCounty00.currentindex = "1"
		end if
	end if
End Sub

