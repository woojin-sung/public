'============================================================================
Sub btnPrderPricePopup_OnClick()

	Dim szType, szCode, szPrice, szInner, szInrMk, szAcnt, szAcntCd
	
	'계좌번호
	szAcnt   = Form.GetCtlProp("#acnt", "total")
	szAcntCd = Form.GetCtlProp("#acnt", "sequence")
	
'	if Check_InputData(2) == false then
'		Exit Sub
'	end if

 	'20220602 LES START 정산금 호출로직 개선
	szInner = Form.GetItemCodeInfo(g_szCd, "innermarket")
	
	'시장구분
	if szInner == "002" then		'코스닥
	    szInrMk = "02"
	elseif szInner == "033" then	'코넥스
		szInrMk = "21"
	
	'현재 AOS = 25 , iOS = 11 (메인에서 맞춰야됨)
	elseif szInner == "011" or szInner == "025" then  '프리보드 
		szInrMk = "03"
	else
		szInrMk = "01"
	end if
	'20220602 LES END 
	
	'주문유형에 따른 주문단가
	szType = cmbType.cbkeydata
    
	Select Case szType
		Case "11"										' 장개시전시간외(전일종가)
			szPrice =  Form.GetCtlProp("#lblStd", "caption")
		Case "12"										' 시간외종가(현재가)
			szPrice =  Form.GetCtlProp("#lblHyun", "caption")
		Case "01", "03", "04", "06", "07", "09", "10" 		' 시장/최유리/최우선지정가
			szPrice =  Form.GetCtlProp("#lblLow", "caption")		' 매수시(상한가), 매도시 ( 하한가 )	
		Case else
			if edtPrc.caption == "" then
				szPrice = "0"
			else
				szPrice = edtPrc.caption
			end if
		    
'			if edtPrc.caption = "0" or edtPrc.caption = "" then
'				Form.ShowAlert(g_szTitle, "주문가격을 입력하세요")
'				exit Sub
'			end if	    
	End Select

    '종목코드
	szCode = Change_ItemCode()
	
	
	'20170713 HAMWG START : 주식 신용매도 시 정산금 데이터 추가 
	'현금/신용 구분
	szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
	
    if szCLS <> "0" then		' 신용/대출	
    '20230619 htw start 신용-신용합산 변경으로 인한 조건문 변경
	    if f_IsCheckedHabSan() then'신용합산O
			szLoanDate = " "
			szLoanSr   = " "
			if cmbCredit.currentindex == "2" then	  ' 예탁담보
				szLoanCd = "0201"
			elseif cmbCredit.currentindex == "1" then  ' 유통융자
				szLoanCd = "0102"
			else									  ' 신용융자
				szLoanCd = "0101"
			end if
		else
			szLoanDate = cldCredit.caption
			if cmbCredit.currentindex == "1" then	' 예탁담보
				szLoanCd = "0201"
				if g_szLoanSrno = "" or g_szLoanSrno = 0 then
					szLoanSr = 0
				else
					szLoanSr = g_szLoanSrno
				end if
			else									' 신용융자
				szLoanCd = "0101"
				szLoanSr = 1
			end if
	'20230619 htw end 신용-신용합산 변경으로 인한 조건문 변경
	    end if
	end if
	
	Dim szQty
	if edtQty.caption == "" then
		szQty = 0
	else
		szQty = edtQty.caption
	end if
	
   '====
    if szCLS = "0" then
	    '계좌번호|채널유형|시장구분|매매구분(1매도, 2매수)|주문수량|주문단가|종목코드|주문유형
		szData = szAcnt & "★" & szAcntCd & "★" & szInrMk & "★" & "1" & "★" & szQty & "★" & szPrice & "★" & szCode & "★" & szType
		Form.OpenPopupAnimation("mbtrs12000_pm" , szData , "","2")
	else
	'20230619 htw start 신용-신용합산 추가로 조건문 변경
		'20230621 htw start 조건문 주석처리
'		if g_tJangoData == "" and f_IsCheckedHabSan() == false then '신용/대출일 때 잔고 팝업에서 받아온 data
'			Form.ShowAlert("안내", "잔고에서 매도할 종목 선택 후 진행해주세요.","","1")
'		else
			'20180614 LES START - 전액상환방식 추가
			if chkRepay.checkstate == "1" then
				szRdmpClcd = "2"
			else
				szRdmpClcd = "1"
			end if
			'LES END
			'계좌번호|채널유형|시장구분|매매구분(1매도, 2매수)|주문수량|주문단가|종목코드
			'szCLS(신용1대출2)|szLoanCd|신용합산|대출일|대출번호|전액상환방식|주문유형
			Dim szSendCLSChk
			if f_IsCheckedHabSan() then
				szSendCLSChk = "1"
			else
				szSendCLSChk = "0"
			end if
			
			szData = szAcnt & "★" & szAcntCd & "★" & szInrMk & "★" & "1" & "★" & szQty & "★" & szPrice & "★" & szCode
			szData = szData & "★" & szCLS & "★" & szLoanCd & "★" & szSendCLSChk & "★" & szLoanDate & "★" & szLoanSr & "★" & szRdmpClcd & "★" & szType
'			szData = szData & "★" & szCLS & "★" & szLoanCd & "★" & szCLSChk & "★" & szLoanDate & "★" & szLoanSr & "★" & szRdmpClcd & "★" & szType
			Form.OpenPopupAnimation("mbtrs12000_pn" , szData , "","2")
'		end if
		'20230621 htw end 조건문 주석처리
	'20230619 htw end 신용-신용합산 추가로 조건문 변경
	end if
	'===
End Sub

'20230619 htw start 신용-신용합산 추가로 신용합산 판단 추가
function f_IsCheckedHabSan()
	szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
	szCLSChk = chkCredit.checkstate ' (대출)신용합산
	scSinJagiChk = chkSinJagi.checkstate ' (신용-자기)신용합산
	scSinUtongChk = chkSinUtong.checkstate ' (신용-유통)신용합산
	
	'신용:자기/유통 중 합산 1개라도 체크거나, 대출:합산 체크 시 true 반환
	if (szCLS == "1" and (scSinJagiChk == "1" or scSinUtongChk == "1")) or (szCLS == "2" and szCLSChk == "1") then
		return true
	else
		return false
	end if
end function
'20230619 htw end 신용-신용합산 추가로 신용합산 판단 추가

'============================================================================
Sub chkSinUtong_OnChange(sCheckState)
	'신용-신용합산 유통
	if CInt(g_szODER_ABLE_SIN_UTONG_QTY) <> 0 then
		if chkSinUtong.checkstate == "1" then
			Init_cmbCredit("1")'신용합산o
			edtQty.caption = g_szODER_ABLE_SIN_UTONG_QTY
			tblDate.SetCellString( 0, 0, "유통융자" )
			tblDate.SetCellString( 0, 1, "" )
			tblDate.visible = true
			chkSinJagi.checkstate = "0"
			cmbCredit.currentindex = 1
			if g_bAfterGetJangoData then
				'
			else
				g_tJangoData = ""'잔고에서 받아온 data 초기화
			end if
		else
			Init_cmbCredit("0")'신용합산x
			'20230717 htw start 조건 변경
'			if #g_tJangoData == 0 then
			if g_tJangoData == "" then
			'20230717 htw end 조건 변경
				tblDate.SetCellString( 0, 0, "" )
				tblDate.SetCellString( 0, 1, "" )
				tblDate.visible = false
				cmbCredit.currentindex = 0
				edtQty.caption = ""
			else
				'20230724 htw start g_bAfterGetJangoData가 F이면 초기화 T면 잔고에서 받아온 상황
				if g_bAfterGetJangoData then
					'
				else
					g_tJangoData = ""'잔고에서 받아온 data 초기화
					tblDate.SetCellString( 0, 0, "" )
					tblDate.SetCellString( 0, 1, "" )
					tblDate.visible = false
					cmbCredit.currentindex = 0
					edtQty.caption = ""
				end if	
				'20230724 htw end g_bAfterGetJangoData가 F이면 초기화 T면 잔고에서 받아온 상황
			end if
		end if
		
		edtCredit.caption = cmbCredit.cbkeydata
		
		edtQty_OnEditComplete()
	else
		chkSinUtong.checkstate = "0"
	end if
	
	'20230807 SWJ START : 주문화면에서 신용합산 체크가 있으면, 잔고화면에서도 체크
	if f_IsCheckedHabSan() then
		Form.SaveConfigData("mbtrs12000", "balance1", "1")
	else
		Form.SaveConfigData("mbtrs12000", "balance1", "0")
	end if
	'20230807 SWJ END
End Sub

'============================================================================
Sub lblAbleQty_OnClick()
	'20230621 htw start 
	'대출-신용합산
	szGbn = Form.GetCtlProp("#rdoSellGbn", "currentindex")
	if szGbn == "2" then
		Dim szChk
		if CInt(chkCredit.checkstate) == 1 then
			szChk = "0"
		else
			szChk = "1"
		end if
		chkCredit.checkstate = szChk
		chkCredit_OnChange(szChk)
	elseif szGbn == "0" then
		Dim nQty
		if g_szODER_ABLE_QTY <> "" then
			nQty = CInt(g_szODER_ABLE_QTY)
			edtQty.caption = nQty
			edtQty_OnEditComplete()
		end if
	end if
End Sub
'============================================================================
Sub lblAbleQty0_OnClick()
	'신용-신용합산 유통
	if chkSinUtong.checkstate == "1" then
		chkSinUtong.checkstate = "0"
		chkSinUtong_OnChange("0")
	else
		chkSinUtong.checkstate = "1"
		chkSinUtong_OnChange("1")
	end if
End Sub

