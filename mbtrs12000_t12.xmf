Sub f_SetOrderPrice()
	Dim nPrc,nQty,nOrderPrice
	nPrc = 0
	nQty = 0
	nOrderPrice = 0
	
	if edtPrc.caption <> "" then
		nPrc = CInt(edtPrc.caption)
	else
		lblOrderPrice.caption = "-"
		Exit Sub
	end if
	
	if edtQty.caption <> "" then
		nQty = CInt(edtQty.caption)
	end if
	
	nOrderPrice = nPrc * nQty
	lblOrderPrice.caption = FormatNumber(nOrderPrice,0).." 원"
End Sub 
