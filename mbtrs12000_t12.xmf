'============================================================================
' Init_AfterOrder : 주문후 초기화
'============================================================================
Function	Init_InputControl()
	edtQty.caption = ""
	edtQty_OnEditComplete()
	edtPrc.caption = ""
	edtPrc_OnEditComplete()
End Function

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
'	g_szBtnMkt     = Form.LoadConfigData("SET_ORDER", "BTN_MARKET")				' 시장가 주문버튼
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력
	
	g_szSelQty     = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTY")		' 매도수량 자동입력
	g_szSelQtyCnt  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTYCNT")	' 매도수량 주수(수량입력 선택시)

	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 시장가 주문버튼(기본값 : 미사용)
'	if Trim(g_szBtnMkt) = "1" then
'		btnMkSel.visible = true
'	else
'		btnMkSel.visible = false
'	end if	
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170919 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170919 HAMWG END

	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	' 매도수량 자동입력(기본값 : 사용하지 않음)
	if Trim(g_szSelQty) = "" then
		g_szSelQty = "0"		
	end if	
End Function

'============================================================================
' Set_rdoGbnCaption : nGbn(0:현금, 1:신용, 2:대출)
'============================================================================
Function Set_rdoGbnCaption(szGbn)
	if szGbn == "1" or szGbn == "2" then
		
		if szGbn == "1" then'신용
			btnSell.caption = "신용매도"
'			chkSinUtong.checkstate = "0"
'			chkSinJagi.checkstate = "0"
			
			chkSinUtong.top = 190
			imgInfo1.top = 192
			lblAbleQty0.top = 202
			
			chkSinJagi.top = 230
			imgInfo2.top = 232
			lblAbleQty1.top = 242
			
			chkCredit.visible = false
			chkSinUtong.visible = true
			chkSinJagi.visible = true
			lblAbleQty.visible = false
			lblAbleQty0.visible = true
			lblAbleQty1.visible = true
			imgInfo0.visible = false
			imgInfo1.visible = true
			imgInfo2.visible = true
		else'대출
			btnSell.caption = "대출매도"
			
			chkCredit.top = 200
			imgInfo0.top = 203
			lblAbleQty.top = 220
			lblAbleQty.left = 185
			lblAbleQty.width = 118
			
			chkCredit.visible = true
			chkSinUtong.visible = false
			chkSinJagi.visible = false
			lblAbleQty.visible = true
			lblAbleQty0.visible = false
			lblAbleQty1.visible = false
			imgInfo0.visible = true
			imgInfo1.visible = false
			imgInfo2.visible = false
		end if
		
		chkRepay.visible = true
		
		tblDate.top = 314 - 38 - 10
		
		btnOrderPrice.top = 314 - 28
		btnPrderPricePopup.top = 314 - 28
		Label1.top = 314 - 28
		
		lblOrderPrice.top = 314 - 28
		Image0.top = 314 - 28
		imgInfo.top = 323 - 28
	else'현금
		'20230711 htw start KOTC인 경우 위치 조정 변경
		if g_szMk == "T" then
			lblAbleQty.top = 142
		else
			lblAbleQty.top = 200
		end if
		'20230711 htw end KOTC인 경우 위치 조정 변경
		lblAbleQty.left = 160
		lblAbleQty.width = 138
			
		btnSell.caption = "현금매도"
		
		chkCredit.visible = false
		chkSinUtong.visible = false
		chkSinJagi.visible = false
		lblAbleQty.visible = true
		lblAbleQty0.visible = false
		lblAbleQty1.visible = false
		imgInfo0.visible = false
		imgInfo1.visible = false
		imgInfo2.visible = false
		
		chkRepay.visible = false
		
		btnOrderPrice.top = 314
		btnPrderPricePopup.top = 314
		Label1.top = 314
		
		lblOrderPrice.top = 314
		Image0.top = 314
		imgInfo.top = 323
	end if
	Request_Able()
End Function

'============================================================================
' Visible_Control : nGbn(유형)
'============================================================================
Function Visible_Control(nGbn)
	if g_szMk == "W" then		' 20160325 ELW는 제외 적용
		edtPrc.enable = true
		btnPrc.enable = true
		btnPPlus.enable = true
		btnPMinus.enable = true
		
	'20180716 LES START
	elseif g_szMk == "T" then
		
		edtPrc.enable = true
		btnPrc.enable = true
		btnPPlus.enable = true
		btnPMinus.enable = true
	'20180716 LES END
		
	else
		' 보통, 조건부지정가, 보통(IOC), 보통(FOK), 시간외단일가
		Select case nGbn
			case 0, 2, 5, 8, 13
				edtPrc.enable = true
				btnPrc.enable = true
				btnPPlus.enable = true
				btnPMinus.enable = true	
			case else
				edtPrc.enable = false	
				btnPrc.enable = false
				btnPPlus.enable = false
				btnPMinus.enable = false
				
				edtPrc.caption = ""
				edtPrc_OnEditComplete()
		End Select
	end if
End Function

'============================================================================
' Set_OrdType : 종목코드에 따라 주문유형 설정
' 20160329 : "market"이 같고 "ineermarket"이 다른 상태의 예외처리 추가(코넥스 때문)
'============================================================================
Function Set_OrdType()
	Dim szMk, szInner
	szMk, szInner = "", ""
	
	szMk = Form.GetItemCodeInfo(g_szCd, "market")
	szInner = Form.GetItemCodeInfo(g_szCd, "innermarket")
	
	if g_szMk <> szMk then
		cmbType.currentindex = "0"					' 0으로 변경해야 die안됨
'		Form.SetCtlProp("cmbGroup", "clear", "")		' 콤보 리스트 클리어
	
		if szMk == "W" then
			szList = Set_TypeList(0)
			'20230615 htw start K-OTC,ELW인 경우 시장가 enable 연동 추가
			chkMarketPrice.enable = false
		else
			if Trim(szInner) =="033" then		' 코넥스
				szList = Set_TypeList(1)
			else
				szList = Set_TypeList(2)
			end if
			if szMk == "T" then
				chkMarketPrice.enable = false
			else
				chkMarketPrice.enable = true
			end if
			'20230615 htw end K-OTC,ELW인 경우 시장가 enable 연동 추가
		end if
		
		g_szMk = szMk
	else
		if szMk == "W" then
			szList = Set_TypeList(0)
			'20230615 htw start K-OTC,ELW인 경우 시장가 enable 연동 추가
			chkMarketPrice.enable = false
		else
			if g_szInner <> szInner then
				if Trim(szInner) =="033" then		' 코넥스
					szList = Set_TypeList(1)
				else
					szList = Set_TypeList(2)
				end if
				
				g_szInner = szInner
			end if
		end if
	end if
	
	cmbType.cbinputdatatext = szList
	
	

	
End Function

'============================================================================
' Set_TypeList : "market" or "ineermarket"에 따른 주문유형 변경 (20160329 추가)
'============================================================================
Function Set_TypeList(nGbn)
	if nGbn == 0 then
		return "00`보통(지정가)\r\n01`보통(IOC)\r\n02`보통(FOK)"
	elseif nGbn == 1 then
		return "00`보통(지정가)\r\n01`시장가\r\n02`장후시간외"
	else
		return "00`보통(지정가)\r\n01`시장가\r\n02`조건부지정가\r\n03`최유리지정가\r\n04`최우선지정가\r\n05`보통(IOC)\r\n06`시장가(IOC)\r\n07`최유리(IOC)\r\n08`보통(FOK)\r\n09`시장가(FOK)\r\n10`최유리(FOK)\r\n11`장전시간외\r\n12`장후시간외\r\n13`시간외단일가"
	end if
End Function


'============================================================================
' Check_OrdType : 주문유형확인
'============================================================================
Function Check_OrdType()
	Dim szIdx
	szIdx = CStr(cmbType.currentindex)
	
	if g_bBtnMkClk == true Then					'시장가 주문
		return "05"	
	elseIf g_szInner == "033" then				' 코넥스 
		Select Case szIdx
			Case "0"	'지정
				return "01"
			Case "1"	'시장
				return "05"
			Case "2"	'장후
				return "71"
		End Select
	elseIf g_szMk == "W" then					' ELW인경우 -  보통
		return "01"
	else '일반주문
		Select Case szIdx
			Case "0", "5", "8"	' 지정(일반, IOC, FOK)
				return "01"
			Case "1", "6", "9"	' 시장(일반, IOC, FOK)
				return "05"
			Case "2"				' 조건부
				return "06"
			Case "3", "7", "10"	' 최유리(일반, IOC, FOK)
				return "12"
			Case "4"				' 최우선
				return "13"   
			Case "11"			' 장전
				return "61"
			Case "12"			' 장후
				return "71"
			Case "13" 
				return "81" 		' 시간외단일가
		End Select 			
    End If
End Function

'============================================================================
' Check_CondCode : 주문조건 구분 확인
'============================================================================
Function Check_CondCode()
	Dim szIdx
	
	if g_bBtnMkClk == true Then					'시장가 주문
		return "0"
	elseIf g_szInner == "033" then				' 코넥스 
		return "0"		
	elseIf g_szMk == "W" then					'ELW인경우 -  보통
		'20230714 htw start 주문 유형에 따른 분기 추가
		szIdx = cmbType.currentindex
		if szIdx == "0" then
			return "0"
		elseif szIdx == "1" then
			return "3"
		elseif szIdx == "2" then
			return "4"
		end if
		'20230714 htw end 주문 유형에 따른 분기 추가
	else '일반주문
		szIdx = cmbType.currentindex

		Select Case szIdx
			Case "5", "6", "7"	' IOC
				return "3"
			Case "8", "9", "10"	' FOK
				return "4"
			Case Else
				return "0" 	
		End Select 			
    End If
End Function

'============================================================================
' Change_ItemCode
'============================================================================
Function Change_ItemCode()
	Dim szMk
	
	szMk = Form.GetItemCodeInfo(g_szCd, "market")

	if Left(g_szCd, 1) = "J" or Left(g_szCd, 1) = "F" then
		return g_szCd
	elseif szMk = "J" or szMk = "T" then	'주식
		return "A" & g_szCd
	elseif szMk = "W" then	'ELW
		return "J" & g_szCd
	else
		return g_szCd
	end if 
End Function

'============================================================================
' Check_InputData
'============================================================================
Function Check_InputData(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Check_Account(nGbn) == false then
		return false
	end if

	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if
	
	if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
		Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
		return false
	end if
	
	if nGbn == 0 then
		szType = Check_OrdType()
		
		if szType == "01" or szType = "06" or szType = "81" then	' 지정, 조건부, 시간외단일가
			if Trim(edtPrc.caption) == "" or Trim(edtPrc.caption) == "0" then
				Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
				return false
			end if	
		end if
	end if	
		
	if nGbn <> 2 then	
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup()
		else
			Request_Order()
		end if
	end if
	
	return true
End Function

'============================================================================
' Open_ConfirmPopup
'============================================================================
Function Open_ConfirmPopup(szWarn)
	Dim szData, szGbn
	
	szGbn = Form.GetCtlProp("#rdoSellGbn", "currentindex")
	'20230720 htw start 경고창, 확인창 분기 추가
	Dim szData
	if Trim(szWarn) <> "" then		' 경고팝업 오픈
		szData = "1"												' 매매구분(경고창은 1 고정)
	else
		szData = szGbn											' 매매구분(1=신용 2=대출)
	end if
	'20230720 htw end 경고창, 확인창 분기 추가
	
	szData = szData & "|" & g_szMk									' 시장구분
	szData = szData & "|" & Form.GetCtlProp("#acnt", "caption")			' 계좌번호
	szData = szData & "|" & Form.GetCtlProp("#acnt", "accountname")		' 계좌명
	szData = szData & "|" & g_szCd									' 종목코드
	szData = szData & "|" & Form.GetItemCodeInfo(g_szCd, "name")		' 종목명
	szData = szData & "|" & cmbType.caption							' 주문구분
	szData = szData & "|" & szGbn									' 현금/신용/대출
	szData = szData & "|" & cmbCredit.cbkeydata						' 신용구분
	
	'20230619 htw start 신용합산 체크 판단 함수 추가
	if f_IsCheckedHabSan() then
	'20230619 htw end 신용합산 체크 판단 함수 추가
		szData = szData & "|" & ""									' 대출일자(신용합산일때 날짜 빼기)
	else
		szData = szData & "|" & cldCredit.caption					' 대출일자
	end if
	
	szData = szData & "|" & edtQty.caption							' 주문수량
	szData = szData & "|" & edtPrc.caption							' 주문가격
	szData = szData & "|" & ""										' 원주문번호
	szData = szData & "|" & ""										' 전량전부
	
	if Trim(szWarn) <> "" then		' 경고팝업 오픈
		szData = szData & "|" & szWarn								' 경고메세지
		
		Form.OpenPopupAnimation("mbtrs12020_p18", szData , "","2")		
	else							' 주문확인팝업 오픈
		if szGbn == "0" then	' 현금
			Form.OpenPopupAnimation("mbtrs12020_p14", szData , "","2")
		else					' 신용/대출
			'20230628 htw start 신용-일반 주문인 경우 기존 신용융자 표기->유통/자기융자 text로 변경을 위한 data 추가
			if szGbn == "1" then	' 신용
				if f_IsCheckedHabSan() == false then'신용합산이 아닌 경우
					szData = szData & "|" & tblDate.GetCellString(0, 0)'유통/자기융자 text
				end if
			end if
			
			'20230628 htw end 신용-일반 주문인 경우 기존 신용융자 표기->유통/자기융자 text로 변경을 위한 data 추가
			Form.OpenPopupAnimation("mbtrs12020_p15", szData , "","2")
		end if
	end if
End Function

'============================================================================
' Request_Order
'============================================================================
Function Request_Order()
	Dim szKey 
	
	g_szWarnFlag = "N"
	
	' 현금/신용 구분
	szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
	
	if szCLS == "0" then
		DATAMANAGER.RequestTranData("obtrs_oder_101a")			' 주식주문
	else
		szKey = cmbCredit.cbkeydata
		'20230616 htw start 신용-합산주문 case 변경
		if f_IsCheckedHabSan() then	' 신용합산
			DATAMANAGER.RequestTranData("obtrs_oder_211a")		' 신용합산주문
		else
			DATAMANAGER.RequestTranData("obtrs_oder_201a")		' 신용주문
		end if
		'20230616 htw end 신용-합산주문 case 변경
	end if
End Function

'============================================================================
' Check_Account
'============================================================================
Function Check_Account(nGbn)
	Dim szAcnt, szPwd
	
	szAcnt = Form.GetCtlProp("#acnt", "caption")
	
	If Len(szAcnt) < 10 Then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
		return False
	End If
	
	if nGbn <> 2 then
		szPwd = Form.GetCtlProp("#edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function

'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn)
	Dim szPrc, szUnit, szHigh, szLow, szHyun
	
	szPrc  = edtPrc.caption
	szUnit = Form.GetCtlProp("#lblUnit", "caption")
	szHigh = Form.GetCtlProp("#lblHigh", "caption")	
	szLow  = Form.GetCtlProp("#lblLow", "caption")
	szHyun = Form.GetCtlProp("#lblHyun", "caption")
	
	'=======================================================================
	'20221116 HWG START : (거래소 차세대) 호가단위 개선
	'=======================================================================
	'20231122 HSZ START:  (거래소 차세대) ETF,ETN 호가단위 개선
	'=======================================================================
	' ETN
	'=======================================================================
	if g_szMk == "Q" then
		if CDbl(szPrc) < 2000 then
			szUnit = 1
		elseif CDbl(szPrc) >= 2000 then
			szUnit = 5
		end if
	'=======================================================================
	' ELW
	'=======================================================================	
	elseif  g_szMk == "W" then
		szUnit = 5
		
	'=======================================================================
	' ETN/ELW 외
	'=======================================================================
	else
		szInnerMk = Form.GetItemCodeInfo(g_szCd, "innermarket")
		
		'=======================================================================
		' ETF
		'=======================================================================
		if szInnerMk = "013" then
			if CDbl(szPrc) < 2000 then
				szUnit = 1
			elseif CDbl(szPrc) >= 2000 then
				szUnit = 5
			end if
	'20231122 HSZ END
		
		'=======================================================================
		' KOTC
		'=======================================================================
'		elseif szInnerMk = "025" then
'			if CDbl(szPrc) < 1000 then
'				szUnit = 1
'			elseif (CDbl(szPrc) >= 1000 and CDbl(szPrc) < 5000) then
'				szUnit = 5 
'			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 10000) then
'				szUnit = 10
'			elseif (CDbl(szPrc) >= 10000 and CDbl(szPrc) < 50000) then
'				szUnit = 50
'			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 100000) then
'				szUnit = 100
'			elseif (CDbl(szPrc) >= 100000 and CDbl(szPrc)<  500000) then
'				szUnit = 500
'			elseif CDbl(szPrc) >= 500000 then
'				szUnit = 1000
'			end if
'			
'			if nGbn == 1 then
'				if CDbl(szPrc) = 1000 then
'					szUnit = 1
'				elseif CDbl(szPrc) = 5000 then
'					szUnit = 5 
'				elseif CDbl(szPrc) = 20000 then
'					szUnit = 10
'				elseif CDbl(szPrc) = 10000 then
'					szUnit = 50
'				elseif CDbl(szPrc) = 50000 then
'					szUnit = 100
'				elseif CDbl(szPrc) = 100000 then
'					szUnit = 500
'				elseif CDbl(szPrc) = 500000 then
'					szUnit = 1000
'				end if
'			end if
		
		'=======================================================================
		' KOSPI/KOSDAQ/KONEX/신주인수권/수익증권 등
		'=======================================================================
		else
			if CDbl(szPrc) < 2000 then
				szUnit = 1
			elseif (CDbl(szPrc) >= 2000 and CDbl(szPrc) < 5000) then
				szUnit = 5 
			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 20000) then
				szUnit = 10
			elseif (CDbl(szPrc) >= 20000 and CDbl(szPrc) < 50000) then
				szUnit = 50
			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 200000) then
				szUnit = 100
			elseif (CDbl(szPrc) >= 200000 and CDbl(szPrc) < 500000) then
				szUnit = 500
			elseif CDbl(szPrc) >= 500000 then
				szUnit = 1000
			end if
			
			if nGbn == 1 then
				if CDbl(szPrc) = 2000 then
					szUnit = 1
				elseif CDbl(szPrc) = 5000 then
					szUnit = 5 
				elseif CDbl(szPrc) = 20000 then
					szUnit = 10
				elseif CDbl(szPrc) = 50000 then
					szUnit = 50
				elseif CDbl(szPrc) = 200000 then
					szUnit = 100
				elseif CDbl(szPrc) = 500000 then
					szUnit = 500
				end if
			end if
		end if
	end if
	'20221116 HWG END
	
	'이전소스
'	'=======================================================================
'	' 20190403 LES START 호가단위 설정
'	'=======================================================================
'	if g_szMk == "J" or g_szMk == "T" then
'			
'		szInnerMk = Form.GetItemCodeInfo(g_szCd, "innermarket")
'			
'		'-------------------------------------------------------------------
'		'코스닥, 코넥스
'		'-------------------------------------------------------------------
'		if szInnerMk == "002" or szInnerMk == "033" then
'			if CDbl(szPrc) < 1000 then
'				szUnit = 1
'			elseif (CDbl(szPrc) >= 1000 and CDbl(szPrc) < 5000) then
'				szUnit = 5 
'			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 10000) then
'				szUnit = 10
'			elseif (CDbl(szPrc) >= 10000 and CDbl(szPrc) < 50000) then
'				szUnit = 50
'			elseif CDbl(szPrc) >= 50000 then
'				szUnit = 100
'			end if
'				
'		'-------------------------------------------------------------------
'		'ETF
'		'-------------------------------------------------------------------
'		elseif szInnerMk = "013" then
'			szUnit = 5
'						
'		'-------------------------------------------------------------------
'		'코스피, 신주인수권, 수익증권, K-OTC
'		'-------------------------------------------------------------------
'		else
'					
'			if CDbl(szPrc) < 1000 then
'				szUnit = 1
'			elseif (CDbl(szPrc) >= 1000 and CDbl(szPrc) < 5000) then
'				szUnit = 5 
'			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 10000) then
'				szUnit = 10
'			elseif (CDbl(szPrc) >= 10000 and CDbl(szPrc) < 50000) then
'				szUnit = 50
'			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 100000) then
'				szUnit = 100
'			elseif (CDbl(szPrc) >= 100000 and CDbl(szPrc) < 500000) then
'				szUnit = 500
'			elseif CDbl(szPrc) >= 500000 then
'				szUnit = 1000
'			end if
'					
'		end if
'		
'	'-------------------------------------------------------------------
'	'ETN, ELW
'	'-------------------------------------------------------------------
'	elseif g_szMk == "Q" or g_szMk == "W" then
'		szUnit = 5
'					
'	end if
'	'20190318 LES END
	
	
	'=======================================================================
	' +,- 버튼 클릭시 동작 
	'=======================================================================		
	
	'----------------------------------------------------------------------
	' ELW
	'----------------------------------------------------------------------
	if g_szMk = "W" then
		if Trim(szUnit) == "" then
			szUnit = "5"
		end if

		if Trim(szPrc) == "" then
			szPrc = szHyun
		else
			' + 버튼 클릭 /////////////////////////////
			if nGbn == 0 then							
				szPrc = CDbl(szPrc) + CDbl(szUnit)
			' - 버튼 클릭 ////////////////////////////	
			elseif nGbn == 1 then					
				if CDbl(szPrc) == 0 then		' 0상태에서 "-"선택시 현재가로 복귀
					szPrc = szHyun
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if
			end if
		end if
	
	
	' ----------------------------------------------------------------------
	' 그외 (코스피, 코스닥, KOTC, ETF, ETN ..)
	' ----------------------------------------------------------------------		
	else
		if Trim(szUnit) == "" then
			szUnit = "1"
		end if
		
		if Trim(szPrc) == "" then
			szPrc = szHyun
		else
			' + 버튼 클릭 /////////////////////////////
			if nGbn == 0 then
			
			'20210216 SWJ START : 신주인수권 가격 +/- 버튼 입력오류 수정(상한가, 하한가 항상 0이어서 생긴 오류)
				if Left(g_szCd,1) == "J" then
					szPrc = CDbl(szPrc) + CDbl(szUnit)
					
					if szPrc <= 0 then
						szPrc = szHyun
					end if
				else
					'20230622 htw start 0일 때 현재가로 복귀 추가
					if CDbl(szPrc) == 0 then
						szPrc = szHyun
					elseif CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
						szPrc = szHigh
					elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀	
						szPrc = szLow
					else
						szPrc = CDbl(szPrc) + CDbl(szUnit)
					end if
				end if
				
			' - 버튼 클릭 ////////////////////////////
			elseif nGbn == 1 then
			
				if Left(g_szCd,1) == "J" then
					
					szPrc = CDbl(szPrc) - CDbl(szUnit)
					
					if szPrc <= 0 then
						szPrc = szHyun
					end if
				else
					if CDbl(szPrc) == 0 then
						szPrc = szHyun
					'20230622 htw end 0일 때 현재가로 복귀 추가
					elseif CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
						szPrc = szHigh		
					elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
						szPrc = szLow
					else
						szPrc = CDbl(szPrc) - CDbl(szUnit)
					end if
				end if
			'20210216 SWJ END
			end if
		end if
	end if
	
	edtPrc.caption = szPrc
	edtPrc_OnEditComplete()
End Function


'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption

	
	if Trim(szQty) == "" then
		szQty = 1
	else
		'20230718 htw start 수량 변경 단위 1로 고정
'		if Len(szQty) = 1 or Len(szQty) = 2 then
'			nUnit = 1
'		else
'			nCnt = Len(szQty)-1
'			
'			For i = 0 to nCnt-1
'				if i == 0 then
'					szUnit = "1"
'				else
'					szUnit = szUnit & "0"
'				end if
'			Next
'			
'			nUnit = CDbl(szUnit)
'		end if
		nUnit = 1
		'20230718 htw end 수량 변경 단위 1로 고정
		if nGbn == 0 then
			szQty = CDbl(szQty) + nUnit
		elseif nGbn == 1 then
			if CDbl(szQty) == 0 then
				Exit Function
			else
				szQty = CDbl(szQty) - nUnit
			end if
		end if
	end if
	
	edtQty.caption = szQty
	edtQty_OnEditComplete()
End Function

'============================================================================
' Init_cmbCredit
'============================================================================
Function Init_cmbCredit(szChk)			
	Dim szList,szCLS
	' 현금/신용 구분
	szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
			
	Form.SetCtlProp("cmbCredit", "clear", "")		' 콤보 리스트 클리어
	
	if szChk == "1" then
		szList = "05`자기융자\r\n06`유통융자\r\n03`예탁담보"
	else
		szList = "01`신용융자\r\n03`예탁담보"		
	end if
	
'	if szCLS == "1" or szCLS == "2" then
'		szList = "05`자기융자\r\n06`유통융자\r\n03`예탁담보"
'	else
'		szList = "01`신용융자\r\n03`예탁담보"		
'	end if
	cmbCredit.cbinputdatatext = szList
	
End Function

'============================================================================
' Return_BalanceScreen : 잔고팝업에서 리턴된 값 적용
'============================================================================
Function Return_BalanceScreen(szRet)
	tData = Split(szRet, "♥")
'	0수량/1대출일자/2대출상세/3신용합산여부/4대출일련번호/5대출일련번호/6종목코드
'	szData = szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & chk1.checkstate & "♥" & szLoanSr & "♥" & szLoanSr	
	if UBound(tData) > 0 then
		if Trim(tData(0)) == "" then
			'20230628 htw start 잔고에서 종목 미클릭 후 종료시 화면 무반응 처리
'			chkCredit.checkstate = tData(3)			' 신용합산체크
'			Form.SetSharedData("S_CSM", chkCredit.checkstate)
			
'			Init_cmbCredit(tData(3))
			' 현금/신용 구분
'			szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
'			
'			if szCLS == "0" then
'				chkCredit.visible = false
'				imgInfo0.visible = false
'				cldCredit.visible = false
'			end if
		else
			'20230628 htw end 잔고에서 종목 미클릭 후 종료시 화면 무반응 처리
			g_tJangoData = tData	'신용/대출일 때 잔고 팝업에서 받아온 data(0수량/1대출일자/2대출상세/3신용합산여부/4대출일련번호/5대출일련번호)
			g_bAfterGetJangoData = true
			cmbType.currentindex = "0"
			
			edtQty.caption = CInt(tData(0))				' 수량
			edtQty_OnEditComplete()
			
'			edtPrc.caption = ""
'			edtPrc_OnEditComplete()
			
			if Trim(tData(3)) == "0" then
				if Trim(tData(1)) == "" then	' 20160325 대출일자 없을때는 당일적용 (오택경차장 요청)
					cldCredit.caption = Form.GetSharedData("&HOST_DATE", false)
				else
					cldCredit.caption = tData(1)		' 대출일자
				end if
				tblDate.visible = true
				tblDate.SetCellString(0, 1, cldCredit.caption)
			else
				tblDate.SetCellString(0, 1, "")
			end if
	
			if Trim(tData(2)) <> "0000" then		' 대출상세
				
				chkCredit.checkstate = tData(3)			' 신용합산체크
				Form.SetSharedData("S_CSM", chkCredit.checkstate)
				
				Init_cmbCredit(tData(3))	
				'tData(2)==0101=자기융자 0102=유통융자 0201=예탁담보
'				if Trim(tData(2)) == "0101" or Trim(tData(2)) == "0102" then
				if Trim(tData(2)) == "0101" then
					'20230626 htw start 트리거로 변경
					'Form.SetCtlProp("#rdoSellGbn", "eventindex", "1")
					Form.triggerEvent("#", "RDO_SELL_CHANGE", "1")
					'20230626 htw end 트리거로 변경
					tblDate.visible = true
					if Trim(tData(3)) == "1" then							' 신용합산
'						if Trim(tData(2)) == "0201" then		' 유통융자
'							g_szODER_ABLE_SIN_UTONG_QTY = tData(0)
'							cmbCredit.currentindex = 1
'							chkSinUtong.checkstate = "1"
'							chkSinUtong_OnChange("1")
'						else									' 자기융자
							g_szODER_ABLE_SIN_JAGI_QTY = tData(0)
							cmbCredit.currentindex = 0
							'20230717 htw start 조건문 추가
							if CInt(chkSinJagi.checkstate) == 0 then
								chkSinJagi.checkstate = "1"
								chkSinJagi_OnChange("1")
							end if
							'20230717 htw end 조건문 추가
'						end if					
					else													' 신용일반
						cmbCredit.currentindex = 0
						'20230717 htw start 조건문 추가
						if CInt(chkSinUtong.checkstate) == 1 then
							chkSinUtong.checkstate = "0"
							chkSinUtong_OnChange("0")
						end if
						if CInt(chkSinJagi.checkstate) == 1 then
							chkSinJagi.checkstate = "0"
							chkSinJagi_OnChange("0")
						end if
						'20230717 htw end 조건문 추가
					end if
				elseif Trim(tData(2)) == "0201" or Trim(tData(2)) == "0211" or Trim(tData(2)) == "0401" then
					'20230626 htw start 트리거로 변경
					'Form.SetCtlProp("#rdoSellGbn", "eventindex", "2")
					Form.triggerEvent("#", "RDO_SELL_CHANGE", "2")
					'20230626 htw end 트리거로 변경
					if Trim(tData(2)) == "0201" or Trim(tData(2)) == "0211" then
						tblDate.visible = true
						if Trim(tData(3)) == "1" then							' 신용합산
							cmbCredit.currentindex = 2			' 예탁담보
						else													' 신용일반
							cmbCredit.currentindex = 1			' 예탁담보
						end if
					end if
					g_szLoanSrno = tData(4)	   '대출일련번호
				
				'20180424 LES START - 유통융자 적용
				elseif Trim(tData(2)) == "0102" then
					'20230626 htw start 트리거로 변경
					'Form.SetCtlProp("#rdoSellGbn", "eventindex", "1")
					Form.triggerEvent("#", "RDO_SELL_CHANGE", "1")
					'20230626 htw end 트리거로 변경
					tblDate.visible = true
					if Trim(tData(3)) == "1" then
						g_szODER_ABLE_SIN_UTONG_QTY = tData(0)
						cmbCredit.currentindex = 1
						'20230717 htw start 조건문 추가
						if CInt(chkSinUtong.checkstate) == 0 then
							chkSinUtong.checkstate = "1"
							chkSinUtong_OnChange("1")
						end if
					else
						cmbCredit.currentindex = 0
						if CInt(chkSinUtong.checkstate) == 1 then
							chkSinUtong.checkstate = "0"
							chkSinUtong_OnChange("0")
						end if
						if CInt(chkSinJagi.checkstate) == 1 then
							chkSinJagi.checkstate = "0"
							chkSinJagi_OnChange("0")
						end if
						'20230717 htw end 조건문 추가
					end if
				'20180424 LES END
				end if
				
				'230530 htw start 신용/대출 기존 유형 text 값 그대로 매칭
				Dim szReturnValue, szCode
				szCode = Trim(tData(2))
				szReturnValue = ""
				Select Case szCode
					Case "0000"	szReturnValue = "보통"
					Case "0101"	szReturnValue = "자기융자"
					Case "0102"	szReturnValue = "유통융자"
					Case "0103"	szReturnValue = "자기대주"
					Case "0104"	szReturnValue = "유통대주"
					Case "0201"	szReturnValue = "예탁주식"
					Case "0202"	szReturnValue = "예탁채권"
					Case "0203"	szReturnValue = "예탁집합투자"
					Case "0204"	szReturnValue = "예탁장외파생"
					Case "0211"	szReturnValue = "예탁유통주식"
					Case "0212"	szReturnValue = "예탁유통채권"
					Case "0213"	szReturnValue = "예탁유통집합투자"
					Case "0214"	szReturnValue = "예탁유통장외파생"
					Case "0301"	szReturnValue = "매도증권담보대출"
					Case "0302"	szReturnValue = "수익증권환매"
					Case "0303"	szReturnValue = "ELS환매자금대출"
					Case "0401"	szReturnValue = "소액주식"
					Case "0402"	szReturnValue = "소액채권"
					Case "0403"	szReturnValue = "소액수익증권"
					Case "0404"	szReturnValue = "소액 ELS"
					Case "0501"	szReturnValue = "공모주청약"
					Case "0502"	szReturnValue = "ELS청약"
					Case "0503"	szReturnValue = "주식매입"
					Case "0601"	szReturnValue = "매입자금대출"
					Case "0701"	szReturnValue = "초단기대출"
					Case "0801"	szReturnValue = "CMA담보대출"
					Case "9201"   szReturnValue = "대출(대여)"'v002
					Case "8201"   szReturnValue = "양도담보"'v003
				End Select
				
				tblDate.SetCellString(0, 0, szReturnValue)
				'230530 htw end 신용/대출 기존 유형 text 값 그대로 매칭
			else
				'20230626 htw start 트리거로 변경
				'Form.SetCtlProp("#rdoSellGbn", "eventindex", "0")
				Form.triggerEvent("#", "RDO_SELL_CHANGE", "0")
				'20230626 htw end 트리거로 변경
				tblDate.visible = false
				tblDate.SetCellString(0, 0, "")
				tblDate.SetCellString(0, 1, "")
			end if
			
			'20230703 SWJ START
			Select Case szCode
				
			Case "0000"
				g_szRdoTab = "0"
			Case "0201"
				g_szRdoTab = "2"
			Case Else
				g_szRdoTab = "1"
				
			End Select
			'20230703 SWJ END
			
			'======20230724 htw start 기존 종목과 동일한 종목을 잔고에서 가져온 경우 init_code 트리거를 호출하지 않기 때문에 여기서 변수 F처리
			'20230725 htw start data갯수 상이로 마지막 데이터로 변경(종목코드)
			Dim szTemp
			nSize = CInt(#tData) - 1
			szTemp = tData(nSize)
			'20230725 htw end data갯수 상이로 마지막 데이터로 변경(종목코드)
		'	'신주인수권(증서)/수익증권/ETN
			if (Left(szTemp, 1) == "J" and len(szTemp) == 9) or Left(szTemp, 1) == "F" or left(szTemp, 1) == "Q" then
				szTemp = szTemp
			'주식/KOTC/ELW
			else
				if Left(szTemp, 1, 1) == "A" or Left(szTemp, 1, 1) == "J" then
					szTemp = Trim(Mid(szTemp,2,Len(szTemp)))
				end if
			end if
			
			if g_szCd == szTemp then
				g_bAfterGetJangoData = false
			end if
			'======20230724 htw end 기존 종목과 동일한 종목을 잔고에서 가져온 경우 init_code 트리거를 호출하지 않기 때문에 여기서 변수 F처리
		end if
		Request_Able()
		
	end if
End Function		
	
'============================================================================
' Return_AutoQty
'============================================================================
Function Return_AutoQty()
	if g_szSelQty == "1" then		' 보유잔고수량
		Request_Able()
	elseif g_szSelQty == "2" then
		if g_tJangoData <> "" then
			'
		else
			if g_szChangeInit == "0" then
				edtQty.caption = g_szSelQtyCnt
			else
				edtQty.caption = ""
			end if
			edtQty_OnEditComplete()
		end if
	end if
End Function

'============================================================================
' Request_Able
'============================================================================
Function Request_Able()
	Dim szCLS
	
	g_bBtnMkClk = false
	g_szWarnFlag = "N"
	
	' 현금/신용 구분
	szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
	
	'20230615 htw start 가능 수량 조회 조건 변경
	if szCLS == "1" then'신용		
		chkRepay.visible = true
		DATAMANAGER.RequestTranData("obtrs_comn_421r_1")				' 신용합산 주문가능수량조회
	elseif szCLS == "2" then'대출
		' 신용합산여부
		'20230621 htw start 대출 가능수량은 합산으로 조회 변경
'		if f_IsCheckedHabSan() then
			
			DATAMANAGER.RequestTranData("obtrs_comn_421r")				' 신용합산 주문가능수량조회
'		else
'			DATAMANAGER.RequestTranData("obtrs_comn_405r")				' 주문가능금액 조회
'		end if
		'20230621 htw end 대출 가능수량은 합산으로 조회 변경
	else'현금
		
		DATAMANAGER.RequestTranData("obtrs_comn_405r")					' 주문가능금액 조회
	end if
	'20230615 htw start 가능 수량 조회 조건 변경
End Function

'============================================================================
' PrdCode : 조회구분코드
' 주문가능수량 obtrs_comn_405r 신용-매도가능수량조회인 경우에만 사용
'============================================================================
Function PrdCode()
	Dim szCd
	szCd = Form.GetCtlProp("#acnt", "itemcodetype")
	
	Select Case szCd
		Case "100", "105", "107", "112","119", "140", "200" '20211207 SWJ START : 중개형ISA 추가	'20230112_01 HWG : SUPER365 추가
		    return "1"
		Case "102", "108"	'저축계좌
		    return "2"
	End Select
End Function


