'============================================================================
' 20180716 LES START - K-OTC종목 선택 시, 컨트롤 위치조정
'============================================================================
Sub Position_Control()
	'20191106 HWG START : 수량필드 스핀컨트롤 추가
	if g_szMk == "T" then
		cmbType.top = 7
		chkMarketPrice.top = 7
'		btnAble.top = 54
		
'		btnQty.top = 101
'		edtQty.top = 101
'		btnQPlus.top = 101
'		btnQMinus.top = 101
		
		btnQty.top = 99
		edtQty.top = 99
		btnQPlus.top = 99
		btnQMinus.top = 99
		
'		btnPrc.top = 148
'		edtPrc.top = 148
'		btnPPlus.top = 148
'		btnPMinus.top = 148
		
		btnPrc.top = 53
		edtPrc.top = 53
		btnPPlus.top = 53
		btnPMinus.top = 53
		
		cmbType.enable = false
		chkMarketPrice.visible = false
		lblAbleQty.top = 142
		btnBalance.top = 142
	else
		cmbType.top = 54
		chkMarketPrice.top = 54
		
		btnQty.top = 148
		edtQty.top = 148
		btnQPlus.top = 148
		btnQMinus.top = 148
		
		btnPrc.top = 101
		edtPrc.top = 101
		btnPPlus.top = 101
		btnPMinus.top = 101
		btnBalance.top = 200
		lblAbleQty.top = 200
		
		szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
		Set_rdoGbnCaption(szCLS)
		
		cmbType.enable = true
		'20230623 htw start K-OTC,ELW인 경우 시장가 visible 연동 추가
		if g_szMk == "W" then
			chkMarketPrice.visible = false
		else
			chkMarketPrice.visible = true
		end if
		'20230623 htw end K-OTC,ELW인 경우 시장가 visible 연동 추가
	end if
	'20191106 HWG END

End Sub

