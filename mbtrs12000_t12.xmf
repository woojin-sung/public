		'	end if
			'20230620 htw end 환경설정 data 적용
			'20230703 SWJ END
			
			f_SetAbleQtyVisible()
		Case "obtrs_oder_202r"
			Dim szRMND_EXST_YN
			szRMND_EXST_YN = DATAMANAGER.GetDataValue(0, "obtrs_oder_202r", "OutBlock1", "RMND_EXST_YN", 0)			' 잔고존재여부
			if szRMND_EXST_YN == "Y" then
				Check_InputData(0)
			else
				Form.ShowAlert("안내", "잔고에서 매도할 종목 선택 후 매도를 진행해주세요.","GO_JANGO","1")
			end if
		Case "obtrs_comn_421r_1"'유통
			g_szODER_ABLE_SIN_UTONG_QTY = CInt(DATAMANAGER.GetDataValue( 0, "obtrs_comn_421r_1", "OutBlock1", "ODER_ABLE_QTY" , 0 ))
			
			'20230703 SWJ START : 잔고 탭에서 신용/대출 잔고를 클릭해 매도 탭 진입 시, 현금 라디오 -> 신용/대출 라디오 전환이 있음
			'서비스 호출을 대출 라디오가 먼저하지만, iOS는 현금수량 조회 서비스를 더 늦게 조회 완료함
			'영향이 없도록 현금/신용/대출 구분 값 분기
			if Form.GetCtlProp("#rdoSellGbn", "currentindex") == "1" then
				lblAbleQty0.caption = "매도가능 "..FormatNumber(g_szODER_ABLE_SIN_UTONG_QTY,0).."주"
			end if
			'20230703 SWJ END
			
			'===20230629 htw start 신용합산 체크 상태에서 상단 종목 변경 시 합산 가능 수량이 0이면 체크 해제 추가
			if CInt(g_szODER_ABLE_SIN_UTONG_QTY) == 0 then
				if CInt(chkSinUtong.checkstate) == 1 then
					chkSinUtong.checkstate = "0"
					chkSinUtong_OnChange(0)
				end if
			end if
			'===20230629 htw end 신용합산 체크 상태에서 상단 종목 변경 시 합산 가능 수량이 0이면 체크 해제 추가
			
			DATAMANAGER.RequestTranData("obtrs_comn_421r_2")				' 신용합산 주문가능수량조회
		Case "obtrs_comn_421r_2"'자기
			g_szODER_ABLE_SIN_JAGI_QTY = CInt(DATAMANAGER.GetDataValue( 0, "obtrs_comn_421r_2", "OutBlock1", "ODER_ABLE_QTY" , 0 ))
			
			'20230703 SWJ START : 잔고 탭에서 신용/대출 잔고를 클릭해 매도 탭 진입 시, 현금 라디오 -> 신용/대출 라디오 전환이 있음
			'서비스 호출을 대출 라디오가 먼저하지만, iOS는 현금수량 조회 서비스를 더 늦게 조회 완료함
			'영향이 없도록 현금/신용/대출 구분 값 분기
			szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
			
			if szCLS == "1" then
				lblAbleQty1.caption = "매도가능 "..FormatNumber(g_szODER_ABLE_SIN_JAGI_QTY,0).."주"
			end if
			'20230703 SWJ END
			
			'===20230629 htw start 신용합산 체크 상태에서 상단 종목 변경 시 합산 가능 수량이 0이면 체크 해제 추가
			if CInt(g_szODER_ABLE_SIN_JAGI_QTY) == 0 then
				if CInt(chkSinJagi.checkstate) == 1 then
					chkSinJagi.checkstate = "0"
					chkSinJagi_OnChange(0)
				end if
			end if
			'===20230629 htw end 신용합산 체크 상태에서 상단 종목 변경 시 합산 가능 수량이 0이면 체크 해제 추가
			
			'20230706 htw start=====================================================================================
			if g_bRdoChangeInSellTab then
				'단순라디오 변경 = 수량,단가 유지 + 신용은 합산 체크 제거(WHY?종목 변경하여 탭변경 했을 때 기존 합산체크 된 유형의 수량이 0이면 체크되면 안 되니까 아예 체크 해제)
				g_bRdoChangeInSellTab = false
				chkSinJagi.checkstate = "0"
				chkSinUtong.checkstate = "0"
			else
				'환경설정 값 적용 대상
				'기존 대출탭에서 종목 변경 or 계좌변경 or 잔고선택
				'다른 탭(현금/신용)에서 잔고팝업 잔고선택
				'잔고선택은 초기화 유무와 상관없이 가능 수량 삽입(특정수량설정인 경우 특정수량 삽입)
				'(합산X)잔고선택인 경우 해당 잔고 수량 삽입(합산 잔고 삽입X)
				'(합산O)잔고선택인 경우 합산 잔고 수량 삽입
				'20230718 htw start============환경설정-종목/탭변경 시 초기화 사용인 경우 잔고 클릭 시 매도수량 자동입력 값 모두 무시하고 잔고수량 삽입
				'20230720 htw start 정상주문시 매도 주문 후 가능 수량 조회시에 환경설정에 따른 수량 값 기입을 통제하기 위한 변수
				if g_bAfterOrder then
					g_bAfterOrder = false
				else
					if g_szChangeInit == "0" then
						'초기화 미사용
						if g_tJangoData <> "" then
							'잔고에서 넘어온 자료가 있으면
							if g_szSelQty == "2" then	'특정수량
								if g_szSelQtyCnt <> "" then
									edtQty.caption = g_szSelQtyCnt
									edtQty_OnEditComplete()
								end if
							else						'특정수량 제외 다른 케이스
								edtQty.caption = g_tJangoData(0)
								edtQty_OnEditComplete()
							end if
						else
							'잔고에서 넘어온 자료가 없으면
							
							if CInt(chkSinJagi.checkstate) == 1 or CInt(chkSinUtong.checkstate) == 1 then
							'자기/신용-신용합산 체크된 경우=가능 수량 기입
								'여기로 오는 케이스
								'종목 변경(잔고 있는 case만)
								'계좌 변경(잔고 있는 case만)
								if CInt(chkSinJagi.checkstate) == 1 then
									edtQty.caption = g_szODER_ABLE_SIN_JAGI_QTY
								elseif CInt(chkSinUtong.checkstate) == 1 then
									edtQty.caption = g_szODER_ABLE_SIN_UTONG_QTY
								end if
								
								edtQty_OnEditComplete()
							else
								'신용합산 미체크된 경우
								'여기로 오는 케이스
								'종목 변경
								'계좌 변경
								if g_szSelQty == "1" then		' 보유잔고수량
	'								edtQty.caption = g_szODER_ABLE_QTY
	'								edtQty_OnEditComplete()
									UtongJagiQty(g_szODER_ABLE_SIN_UTONG_QTY, g_szODER_ABLE_SIN_JAGI_QTY)
								elseif g_szSelQty == "2" then		' 특정수량
									if g_szSelQtyCnt <> "" then
										edtQty.caption = g_szSelQtyCnt
										edtQty_OnEditComplete()
									end if
								end if
							end if
						end if
					else
						'초기화 사용
						if g_tJangoData <> "" then
							'잔고에서 넘어온 자료가 있으면
							edtQty.caption = g_tJangoData(0)
							edtQty_OnEditComplete()
						else
							'잔고에서 넘어온 자료가 없으면
							edtQty.caption = ""
							edtPrc.caption = ""
							edtQty_OnEditComplete()
						end if
					end if
				end if
