Sub cmbCredit_OnEditComplete(iIndex)
	szChk = Form.GetSharedData("STOCKORDER_ORIENTATION", false)
	
	edtCredit.caption = cmbCredit.cbkeydata
	
	if szChk == "1" then
		Form.SetSharedData("STOCKORDER_ORIENTATION", "0")		' 세로의 신용구분콤보를 위해 설정추가
	else
		Form.SetSharedData("S_CGN", iIndex)
	end if
End Sub

