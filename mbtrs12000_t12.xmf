			f_SetAbleQtyVisible()
	' ----------------------------------------------------------------------
	' 신용합산 주문가능수량 조회
	' ----------------------------------------------------------------------	
		 Case "obtrs_comn_421r"
			 '#################대출일 때만 이 TR 사용#######################
			g_szODER_ABLE_QTY = DATAMANAGER.GetDataValue(0, "obtrs_comn_421r", "OutBlock1", "ODER_ABLE_QTY", 0)			' 주문가능수량
			
			
			'20230703 SWJ START : 잔고 탭에서 신용/대출 잔고를 클릭해 매도 탭 진입 시, 현금 라디오 -> 신용/대출 라디오 전환이 있음
			'서비스 호출을 대출 라디오가 먼저하지만, iOS는 현금수량 조회 서비스를 더 늦게 조회 완료함
			'영향이 없도록 현금/신용/대출 구분 값 분기			
			if Form.GetCtlProp("#rdoSellGbn", "currentindex") == "2" then
				lblAbleQty.visible = true
				lblAbleQty.caption = "매도가능 "..FormatNumber(g_szODER_ABLE_QTY,0).."주"
			end if
			'20230703 SWJ END

			'20230706 htw start=====================================================================================
			if g_bRdoChangeInSellTab then
				'단순라디오 변경 = 수량,단가 유지
				g_bRdoChangeInSellTab = false
				if CInt(chkCredit.checkstate) == 1 then
					'라디오 변경 시 신용합산이 되어있다면 합산 수량 삽입
					edtQty.caption = g_szODER_ABLE_QTY
					edtQty_OnEditComplete()
				end if
			else
				'환경설정 값 적용 대상
				'기존 대출탭에서 종목 변경 or 계좌변경 or 잔고선택
				'다른 탭(현금/신용)에서 잔고팝업 잔고선택
				'잔고선택은 초기화 유무와 상관없이 가능 수량 삽입(특정수량설정인 경우 특정수량 삽입)
				'(합산X)잔고선택인 경우 해당 잔고 수량 삽입(합산 잔고 삽입X)
				'(합산O)잔고선택인 경우 합산 잔고 수량 삽입
				
				'20230718 htw start============환경설정-종목/탭변경 시 초기화 사용인 경우 잔고 클릭 시 매도수량 자동입력 값 모두 무시하고 잔고수량 삽입
				
				'20230720 htw start 정상주문시 매도 주문 후 가능 수량 조회시에 환경설정에 따른 수량 값 기입을 통제하기 위한 변수
				if g_bAfterOrder then
					g_bAfterOrder = false
				else
					if g_szChangeInit == "0" then
						'초기화 미사용
						if g_tJangoData <> "" then
							'잔고에서 넘어온 자료가 있으면
							if g_szSelQty == "2" then	'특정수량
								if g_szSelQtyCnt <> "" then
									edtQty.caption = g_szSelQtyCnt
									edtQty_OnEditComplete()
								end if
							else						'특정수량 제외 다른 케이스
								edtQty.caption = g_tJangoData(0)
								edtQty_OnEditComplete()
							end if
						else
							'잔고에서 넘어온 자료가 없으면
							
							if CInt(chkCredit.checkstate) == 1 then
							'신용합산 체크된 경우=가능 수량 기입
								'여기로 오는 케이스
								'현금/신용 탭에서 대출로 변경 시(기존 대출탭에서 신용합산 체크한 상태로 다른 탭 간 케이스)
								'종목 변경
								'계좌 변경
								edtQty.caption = g_szODER_ABLE_QTY
								edtQty_OnEditComplete()
							else
								'신용합산 미체크된 경우
									'여기로 오는 케이스
									'종목 변경
									'계좌 변경
								if g_szSelQty == "1" then		' 보유잔고수량
									edtQty.caption = g_szODER_ABLE_QTY
									edtQty_OnEditComplete()
								elseif g_szSelQty == "2" then		' 특정수량
									if g_szSelQtyCnt <> "" then
										edtQty.caption = g_szSelQtyCnt
										edtQty_OnEditComplete()
									end if
								end if
							end if
						end if
					else
						'초기화 사용
						if g_tJangoData <> "" then
							'잔고에서 넘어온 자료가 있으면
							edtQty.caption = g_tJangoData(0)
							edtQty_OnEditComplete()
						else
							'잔고에서 넘어온 자료가 없으면
							edtQty.caption = ""
							edtPrc.caption = ""
							edtQty_OnEditComplete()
						end if
					end if
				end if
				'20230720 htw end 정상주문시 매도 주문 후 가능 수량 조회시에 환경설정에 따른 수량 값 기입을 통제하기 위한 변수
				
'				if g_tJangoData <> "" then
