Sub Form_OnFormInitBefore()
	imgInfo.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
	imgInfo0.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
	imgInfo1.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
	imgInfo2.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
End Sub
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	'20230707 htw start 큰글씨일 때 체크 텍스트 잘림으로 인한 텍스트 크기 감소
	szTextSize = Form.GetEnvData("common.textsize")
	szDeviceOS = Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	
	if CInt(szTextSize) > 0 and szDeviceOS == "2" then '큰글씨 + IOS 이면
		if CInt(szTextSize) == 2 then
			chkSinUtong.fontsize = -3 - CInt(szTextSize)
			chkSinJagi.fontsize = -3 - CInt(szTextSize)
		else
			chkSinUtong.fontsize = -2 - CInt(szTextSize)
			chkSinJagi.fontsize = -2 - CInt(szTextSize)
		end if
		
		chkCredit.fontsize = -2 - CInt(szTextSize)
		chkRepay.fontsize = -2 - CInt(szTextSize)
		chkMarketPrice.fontsize = -2 - CInt(szTextSize)
		Label1.fontsize = -2 - CInt(szTextSize)
	end if
	'20230707 htw end 큰글씨일 때 체크 텍스트 잘림으로 인한 텍스트 크기 감소

	g_bFirstStartScreen = false
'	szMod = Form.GetSharedData("&SERVER_MODE", false ) '1이면 개발 서버
'	if szMod == "1" then
'		ChkButton0.visible = true
'	end if
	
	Dim szChkCrdt
	
	Load_OrderSet() '주문설정값 읽어오기 
	
	chkCredit.setNeighbolCtlPos("imgInfo0","right",0,"")
	
	'20230706 htw start 신용합산 연동 제거
	' 잔고화면의 신용합산 체크여부를 화면과 연동(2016.03.15 오택경 차장) ///
'	szChkCrdt = Form.LoadConfigData("mbtrs15000", "balance1")		'신용합산
'	chkCredit.checkstate = szChkCrdt		' 신용합산체크
'	Form.SetSharedData("S_CSM", chkCredit.checkstate)
	'20230706 htw end 신용합산 연동 제거
	
	Init_cmbCredit(szChkCrdt)
	' 현금/신용 구분
	szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
	
	if szCLS == "0" then
		chkCredit.visible = false
		imgInfo0.visible = false
'		cldCredit.visible = false
	end if
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'20200910 SWJ END
	
	Label1.setNeighbolCtlPos("imgInfo","right",0,"")
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 현금/신용구분 변경
	' ----------------------------------------------------------------------
'	if sEventName == "ORDER_GBN" then
	if sEventName == "ORDER_GBN" or sEventName == "ORDER_GBN_IN_SELL_TAB" then
		'기존 매도탭에서 현금/신용/대출 탭 변경 전용 trigger추가(수량 초기화 등을 방지화하기 위함)
		if sEventName == "ORDER_GBN_IN_SELL_TAB" then
			g_bRdoChangeInSellTab = true
		end if
		tblDate.visible = false
		Set_rdoGbnCaption(sParam)
		g_tJangoData = ""	'신용/대출일 때 잔고 팝업에서 받아온 data
		'20230619 htw start 신용콤보 셋팅 적용
		if f_IsCheckedHabSan() then '신용합산
			Init_cmbCredit("1")
		else
			Init_cmbCredit("0")
		end if
		
		if sParam == "2" then'대출
			if f_IsCheckedHabSan() then '신용합산
				cmbCredit.currentindex = "2"
			else
				cmbCredit.currentindex = "1"
			end if
		elseif sParam == "1" then'신용
			if f_IsCheckedHabSan() then '신용합산
				if chkSinJagi.checkstate == "1" then
					cmbCredit.currentindex = "0"
				elseif chkSinUtong.checkstate == "1" then
					cmbCredit.currentindex = "1"
				end if
			else
				cmbCredit.currentindex = "0"
			end if
		end if
		
		'20230703 SWJ START
		'현금/신용/대출 바뀐 탭 업데이트	
		'탭 바뀔 때 수량 제대로 세팅
'		Form.showalert("ORDER_GBN",sParam)
'		RdoQtyClear("ORDER_GBN", sParam)
		'주석 처리
		'20230719 htw start 주석처리(해당 함수가 동일 트리거에서 중복으로 호출 되고 있음)
'		Request_Able()
		'20230719 htw end 주석처리(해당 함수가 동일 트리거에서 중복으로 호출 되고 있음)
		'20230703 SWJ END
		
		'20230619 htw end 신용콤보 셋팅 적용
		
	'20230629 htw start 잔고data 유지하는 Trigger 추가
	elseif sEventName == "ORDER_GBN_JANGO" then'
		tblDate.visible = false
		Set_rdoGbnCaption(sParam)
		
		if f_IsCheckedHabSan() then '신용합산
			Init_cmbCredit("1")
		else
			Init_cmbCredit("0")
		end if
		
		if sParam == "2" then'대출
			if f_IsCheckedHabSan() then '신용합산
				cmbCredit.currentindex = "2"
			else
				cmbCredit.currentindex = "1"
			end if
		elseif sParam == "1" then'신용
			if f_IsCheckedHabSan() then '신용합산
				if chkSinJagi.checkstate == "1" then
					cmbCredit.currentindex = "0"
				elseif chkSinUtong.checkstate == "1" then
					cmbCredit.currentindex = "1"
				end if
			else
				cmbCredit.currentindex = "0"
			end if
		end if
		
		'20230703 SWJ START
		'매도보유수량 환경설정 시 잔고 데이터 클리어
		'탭 바뀔 때 수량 제대로 세팅
'		Form.showalert("ORDER_GBN_JANGO",sParam)
'		RdoQtyClear("ORDER_GBN_JANGO", sParam)
		Request_Able()
		'20230703 SWJ END
		
	'20230703 SWJ START
	'잔고 팝업에서 리턴하는 것보다 "ORDER_GBN_JANGO"는 빨리 받을 때가 있어서
	'PostTriggerEvent로 받음 (잔고 팝업 리턴보다 늦게 받아야 탭변경 이벤트 구분 가능)
	'elseif sEventName == "ORDER_GBN_JANGO_LATER" then
		
		'if g_szRdoTab == "" then
			
			'매도보유수량 환경설정 시 잔고 데이터 클리어
			'탭 바뀔 때 수량 제대로 세팅
			'RdoQtyClear("ORDER_GBN_JANGO_LATER", sParam)	
		'end if
		
		'g_szRdoTab = ""
	'20230703 SWJ END
	
	'20230629 htw end 잔고data 유지하는 Trigger 추가
	' ----------------------------------------------------------------------
	' 메인화면의 호가 클릭시
	' ----------------------------------------------------------------------		
	elseif sEventName == "12000_HOGA" then		
		if sParam <> "" then
			'주문유형에 따른 주문단가
			szType = Check_OrdType()
			
			if szType == "01" or szType == "06" or szType == "81" then		'지정, 조건부, 시간외 주문
				edtPrc.caption = sParam
				edtPrc_OnEditComplete()
			end if	
		else
			edtPrc.caption = sParam
			edtPrc_OnEditComplete()
		end if
	' ----------------------------------------------------------------------
	' 메인화면에서 종목코드 받기
	' ----------------------------------------------------------------------			
	elseif sEventName == "INIT_CODE" then
'		edtPrc.caption = ""
'		edtQty.caption = ""
		
		Form.SetCtlProp("#edtOrgNo", "caption", "")	
'		tblDate.visible = false

		if g_bRtnData == false then
			if g_szCd <> sParam then
				g_szCd = sParam
				if g_bAfterGetJangoData == false then
					g_tJangoData = ""	'신용/대출일 때 잔고 팝업에서 받아온 data
					tblDate.SetCellString( 0, 0, "" )
					tblDate.SetCellString( 0, 1, "" )
					tblDate.visible = false
				else
					if g_tJangoData <> "" then
						edtQty.caption = CInt(g_tJangoData(0))
					end if
					g_bAfterGetJangoData = false
				end if
				'====
				szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
				if szCLS == "1" then
					if chkSinUtong.checkstate == "1" then
						edtQty.caption = g_szODER_ABLE_SIN_UTONG_QTY
					elseif chkSinJagi.checkstate == "1" then
						edtQty.caption = g_szODER_ABLE_SIN_JAGI_QTY
					end if
				end if
				'====
				Set_OrdType()		' 종목코드에 따라 주문유형 설정
				
				if g_bRtnData1 == true then
					g_bRtnData1 = false
				else
					if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
						Init_InputControl()
					end if
				end if		
			end if
		else
			' 20160331 : 주문구분(시간외)에 따른 예외처리로 인하여 종목코드 미변경사항으로 인해 추가
			if g_szCd <> sParam then
				g_szCd = sParam
			end if
		end if
		edtPrc_OnEditComplete()
		'20180716 LES START
		Position_Control()

		
	' ----------------------------------------------------------------------
	' 메인화면에서 탭 체인지
	' ----------------------------------------------------------------------			
	elseif sEventName == "CHNAGE_TAB" then
		if g_bAfterGetJangoData == false then
			tblDate.visible = false
		end if
'		edtQty.caption = ""
'		edtQty_OnEditComplete()
		g_tJangoData = ""	'신용/대출일 때 잔고 팝업에서 받아온 data
		'===================================================================================
		' 20170726 LES START - 주문 데이터연동 오류 수정 (탭 변경시 주문유형 연동오류 수정)'===================================================================================
		
		if g_szCd <> sParam then
			g_szCd = sParam
			Set_OrdType()		' 종목코드에 따라 주문유형 설정
		
		end if
		
		'===================================================================================
		' 20170726 LES END - 주문 데이터연동 오류 수정 (탭 변경시 주문유형 연동오류 수정)
		'===================================================================================
		
		'g_szCd = sParam
		'Set_OrdType()		' 종목코드에 따라 주문유형 설정
		
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if
		
		'20170816 LES START - 주문유형콤보세팅 여기다가???
		szType = Form.GetSharedData("S_TYPE", false)		' 주문구분
		cmbType.currentindex = szType					' 주문구분 콤보박스 세팅
		'20170816 LES END
				
		
		'===================================================================================
		
		'20180716 LES START
		Position_Control()

		
	' ----------------------------------------------------------------------
	' 잔고팝업에서 리턴된 값 적용하기
	' ----------------------------------------------------------------------			
	elseif sEventName == "12000_BALANCE_RETURN" then	
		g_bRtnData = true
		g_bRtnData1 = true
		g_tJangoData = ""	'신용/대출일 때 잔고 팝업에서 받아온 data
		tblDate.visible = false
		
		if sParam == "" then
			Exit Sub
		end if

		Return_BalanceScreen(sParam)
		
		'20180716 LES START
		Position_Control()
	' ----------------------------------------------------------------------
	' 자동가격입력
	' ----------------------------------------------------------------------		
	elseif sEventName == "AUTO_PRICE" then
		Dim szPrc
	
		if g_bRtnData == true then
			g_bRtnData = false
		end if
		
		'20170919 HAMWG START : 탭/종목 변경시 초기화 여부
		if g_szChangeInit <> "1" then		
			Return_AutoQty()
		end if
		'20170919 HAMWG END
		
'		szPrc = Form.GetSharedData("HYUN_RETURN", true)
'		Form.SetSharedData("HYUN_RETURN", "")
		szPrc = sParam
		'230601 htw start 시간외- 타 주문유형 간 주문가격 자동입력 방지 케이스 추가
		
		Dim szInner, szCmb
		szInner = Form.GetItemCodeInfo(g_szCd, "innermarket")
		szCmb = cmbType.cbkeydata
		
		if g_szMk <> "W" then
			if Trim(szInner) =="033" then		' 코넥스
				if szCmb =="01" or szCmb == "02" then '시장가, 시간외종가
					return false
				end if
			else
				Select Case szCmb
					Case "01", "03", "04", "06", "07", "09", "10", "11", "12" 		' 시장/최유리/최우선지정가 등
						return false
				end select
			end if
		end if
		'230601 htw end 시간외- 타 주문유형 간 주문가격 자동입력 방지 케이스 추가

		if g_sz12000_HYUN_RETURN == "" then
			if Trim(szPrc) <> "" and szPrc <> null then
				'20230626 htw end 환경설정 조건(g_szChangeInit) 추가
				if g_szChangeInit == "1" then
					'20230710 htw start 잔고data가 있는 경우 초기화 X추가(잔고에서 현재 종목이 아닌 다른 종목 클릭 시 종목을 새롭게 조회하면서 이 부분 코드가 타서 초기화 되는 이슈였음)
					if g_tJangoData == "" then
						'종목/탭 변경시 단가/수량 초기화 O
						edtPrc.caption = ""
						edtQty.caption = ""
					end if
				else
					'종목/탭 변경시 단가/수량 초기화 X
					edtPrc.caption = szPrc
				end if
				edtPrc_OnEditComplete()
			else
				if g_szChangeInit == "1" then
					if g_tJangoData == "" then
						'종목/탭 변경시 단가/수량 초기화 O
						edtPrc.caption = ""
						edtQty.caption = ""
					end if
					'20230710 htw end 잔고data가 있는 경우 초기화 X추가(잔고에서 현재 종목이 아닌 다른 종목 클릭 시 종목을 새롭게 조회하면서 이 부분 코드가 타서 초기화 되는 이슈였음)
				else
'					edtPrc.caption = sParam
				end if
				edtPrc_OnEditComplete()
			end if
		else
'			if g_szChangeInit == "1" then
'				'종목/탭 변경시 단가/수량 초기화 O
'				edtPrc.caption = ""
'				edtQty.caption = ""
'			else
				edtPrc.caption = g_sz12000_HYUN_RETURN
'			end if
			edtPrc_OnEditComplete()
			g_sz12000_HYUN_RETURN = ""
		end if
	' ----------------------------------------------------------------------
	' 종목등 변경사항 전혀 없을때
	' ----------------------------------------------------------------------		
	elseif sEventName == "NO_RETURN" then		
		g_bRtnData = false
	' ----------------------------------------------------------------------
	' 가로에서 받은 조건
	' ----------------------------------------------------------------------		
	elseif sEventName == "CHANGE_DATA" then
		szType = Form.GetSharedData("S_TYPE", false)		' 주문구분
		cmbType.currentindex = szType
		
		szPrc = Form.GetSharedData("S_PRC", false)		' 가격
		edtPrc.caption = szPrc
		edtPrc_OnEditComplete()
		
		szQty = Form.GetSharedData("S_QTY", false)		' 수량
		edtQty.caption = szQty
		edtQty_OnEditComplete()	
		
		szCSm = Form.GetSharedData("S_CSM", false)		' 신용합산
		chkCredit.checkstate = szCSm
		
		Init_cmbCredit(szCSm)	
		
		if szCSm == "0" then
			szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
			
			if szCLS == "0" then
'				cldCredit.visible = false
			else
'				cldCredit.visible = true
			end if
			
			szCDt = Trim(Form.GetSharedData("S_CDT", false))		' 신용날짜
			
			if szCDt == "" then
				cldCredit.caption = Form.GetSharedData("&HOST_DATE", false)
			else
				cldCredit.caption = szCDt
			end if
			
		else
'			cldCredit.visible = false
		end if
		
		
		szCGn = Form.GetSharedData("S_CGN", false)		' 신용구분
		cmbCredit.currentindex = szCGn
		edtCredit.caption = cmbCredit.cbkeydata
	' ----------------------------------------------------------------------
	' 현재가에서 리턴된 값 적용 : 20160321 추가
	' ----------------------------------------------------------------------		
	elseif sEventName == "12000_HYUN_RETURN" then
		'20230524 htw start 현재가에서 넘어온 단가 셋팅
		if sParam <> "" then
			g_sz12000_HYUN_RETURN = sParam
		end if
		'20230524 htw end 현재가에서 넘어온 단가 셋팅
	elseif sEventName == "ACNT_CHANGE" then'계좌 변경
		'20230623 htw start 계좌 변경 시 환경설정 셋팅 추가
		Return_AutoQty()
		Request_Able()
'		edtPrc.caption = ""
'		edtQty.caption = ""
		'20230623 htw end 계좌 변경 시 환경설정 셋팅 추가
		edtPrc_OnEditComplete()
		Form.SetCtlProp("#edtOrgNo", "caption", "")
		tblDate.visible = false
		g_tJangoData = ""	'신용/대출일 때 잔고 팝업에서 받아온 data		
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	' ----------------------------------------------------------------------
	' 수량/금액입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		edtQty_OnEditComplete()
	' ----------------------------------------------------------------------
	' 가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then		
		edtPrc.caption = sRet		
		edtPrc_OnEditComplete()
	elseif sKeyName == "mbtrs12000_pl" then		
		'20230601 htw start 유형에 따른 단가 입력 케이스 추가
		if sRet <> "" then
			Dim tTemp
			tTemp = Split(sRet, "★")
			
			if tTemp(2) == "1" then '시장가 선택
				edtQty.caption = tTemp(1)
				chkMarketPrice.checkstate = "1"
				chkMarketPrice_OnChange("1")
			else
				Dim szType
				szType = Trim(tTemp(5))
'				g_szPrc .."★".. edtQty.caption.."★0".."★"..g_szMk.."★"..g_szInner.."★"..g_szType
				if tTemp(3) <> "W" then
					if Trim(tTemp(4)) == "033" then		' 코넥스
						if szType == "02" then	'시간외종가
							edtQty.caption = tTemp(1)
							f_SetOrderPrice()
						else
							edtPrc.caption = tTemp(0)
							edtQty.caption = tTemp(1)
							edtPrc_OnEditComplete()
						end if
					else
						Select Case szType
							Case "01", "03", "04", "06", "07", "09", "10", "11", "12" 		' 시장/최유리/최우선지정가
								edtQty.caption = tTemp(1)
								f_SetOrderPrice()
							Case Else
								edtPrc.caption = tTemp(0)
								edtQty.caption = tTemp(1)
								edtPrc_OnEditComplete()
						end Select
					end if
				else
					edtPrc.caption = tTemp(0)
					edtQty.caption = tTemp(1)
					edtPrc_OnEditComplete()
				end if
			end if
		end if
		'20230601 htw end 유형에 따른 단가 입력 케이스 추가
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCd, szType, szPrc, szCLS, szCLSCd, szIqry, szLoanCd, szLoanDate
	
	' 종목코드
	szCd = Change_ItemCode()

	'주문유형
	szType = Check_OrdType()

	' 주문조건 구분코드
	szCondCd = Check_CondCode()
	
	'주문유형에 따른 주문단가
	Select Case szType
		Case "05", "12", "13", "61", "71"					'시장가,최유리,최우선 주문
			szPrc = "0"
		Case Else
			szPrc = edtPrc.caption
	End Select

	' 현금/신용 구분
	szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
	
	if szCLS == "1" then		' 신용
		if f_IsCheckedHabSan() then	' 신용합산
'			if cmbCredit.currentindex == "2" then	' 예탁담보
'				szCLSCd = "203"
'			else									' 신용융자(자기융자/유통융자)
				szCLSCd = "201"
'			end if
		else
			szLoanDate = cldCredit.caption
			
'			if cmbCredit.currentindex == "1" then	' 예탁담보
'				szCLSCd = "203"
'				szIqry = "5"
'				szLoanCd = "0201"
'			else									' 신용융자
				szCLSCd = "201"
				szIqry = "4"
				szLoanCd = "0102"
'			end if
		end if
	elseif szCLS == "2" then		' 대출(=예탁담보)
		if f_IsCheckedHabSan() then	' 신용합산
			szCLSCd = "203"
		else
			szLoanDate = cldCredit.caption
			szCLSCd = "203"
			szIqry = "5"
			szLoanCd = "0201"
		end if
	else						' 현금
		szLoanDate = ""
		szCLSCd = "101"
		'szIqry = "1"
		szIqry = PrdCode()
		szLoanCd = "0201"
		'szLoanCd = "0101"
		'szLoanCd = "0000"
	end if
		
	' ----------------------------------------------------------------------
	' 주식 현금 매도주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtrs_oder_101a" then
		g_szTR = szTranID
		DATAMANAGER.ClearInputData(0, "obtrs_oder_101a")
				
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acnt", "total"))			' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ISCD"				, 0, szCd)									' 종목코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODER_UNPR"			, 0, szPrc)									' 주문단가
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODQT"				, 0, edtQty.caption)							' 주문수량
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODER_CLS_CODE"		, 0, szType)									' 주문구분코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, szCondCd)								' 주문조건구분코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag)							' 경고확인여부
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "SVC_CLS_CODE"		, 0, szCLSCd)									' 서비스 구분 코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "PGM_ASPR_DCLR_CLS_CODE", 0, "0")									' 프로그램호가신고구분코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01")									' 주문발생유형코드(01:일반주문)
	' ----------------------------------------------------------------------
	' 주식 신용 매도주문
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtrs_oder_201a" then
		g_szTR = szTranID
		DATAMANAGER.ClearInputData(0, "obtrs_oder_201a")
		
		'20180614 LES START - 전액상환방식 추가
		if chkRepay.checkstate == "1" then
			chkWhole = "Y"
		else
			chkWhole = "N"
		end if
		'20180614 LES END
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acnt", "total"))			' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		'20200910 SWJ END
'		g_tJangoData	'신용/대출일 때 잔고 팝업에서 받아온 data(0수량/1대출일자/2대출상세/3신용합산여부/4대출일련번호/5대출일련번호)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ISCD" 				, 0, szCd)									' 종목코드 
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ODER_CLS_CODE" 		, 0, szType)									' 주문구분코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, szCondCd)								' 주문조건구분코드		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ODQT" 				, 0, edtQty.caption)							' 주문수량
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ODER_UNPR" 			, 0, szPrc)									' 주문가격
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "LOAN_ODER_CLS_CODE" 	, 0, cmbCredit.cbkeydata)						' 신용구분
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "LOAN_DATE" 			, 0, cldCredit.caption)						' 대출일자
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "SVC_CLS_CODE" 		, 0, szCLSCd)									' 서비스구분코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01")									' 주문발생유형코드(01:일반주문)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "CHAN_TYPE_CLS_CODE" 	, 0, "")										' 채널유형구분
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "LOAN_SRNO" 			, 0, g_szLoanSrno)							' 대출일련번호
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "UI_WHOL_AMT_RDMP_YN" 	, 0, chkWhole)									' 전체금액상환여부
		DATAMANAGER.SetDataValue(0, "obtrs_oder_201a", "InBlock1", "WARN_CNFR_YN" 		, 0, g_szWarnFlag)							' 경고확인여부
	' ----------------------------------------------------------------------
	' 주식 신용합산 매도주문
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtrs_oder_211a" then
		g_szTR = szTranID
		DATAMANAGER.ClearInputData(0, "obtrs_oder_211a")
		
		'20180614 LES START - 전액상환방식 추가
		if chkRepay.checkstate == "1" then
			chkWhole = "Y"
		else
			chkWhole = "N"
		end if
		'20180614 LES END
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acnt", "total"))			' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ISCD" 				, 0, szCd)									' 종목코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ODER_CLS_CODE" 		, 0, szType)									' 주문구분코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, szCondCd)								' 주문조건구분코드		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ODQT" 				, 0, edtQty.caption)							' 주문수량
		DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ODER_UNPR" 			, 0, szPrc)									' 주문가격
		DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "LOAN_ODER_CLS_CODE" 	, 0, cmbCredit.cbkeydata)						' 신용구분
		DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "LOAN_DATE" 			, 0, "")	 									' 대출일자
		DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "SVC_CLS_CODE" 		, 0, szCLSCd)									' 서비스구분코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01")									' 주문발생유형코드 01:일반주문
		DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "CHAN_TYPE_CLS_CODE" 	, 0, "")										' 채널유형구분
		DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "LOAN_SRNO" 			, 0, g_szLoanSrno)							' 대출일련번호
		DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "UI_WHOL_AMT_RDMP_YN" 	, 0, chkWhole)									' 전체금액상환여부
		DATAMANAGER.SetDataValue(0, "obtrs_oder_211a", "InBlock1", "WARN_CNFR_YN" 		, 0, g_szWarnFlag)							' 경고확인여부		
	' ----------------------------------------------------------------------
	' 주문가능수량 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtrs_comn_405r" then
		Dim szLoanSr
		DATAMANAGER.ClearInputData(0, "obtrs_comn_405r")
		
		if g_szLoanSrno = "" then
			szLoanSr = 1
		elseif g_szLoanSrno = 0 then
			szLoanSr = 1
		else
			szLoanSr = g_szLoanSrno
		end if
	    
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "IQRY_CLS_CODE" 		, 0, szIqry )									'조회구분코드
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acnt", "total"))			' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acnt", "sequence"))		' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "ISCD"				, 0, szCd)									' 종목코드
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "LOAN_DATE"			, 0, szLoanDate)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "LOAN_SRNO"			, 0, szLoanSr)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "LOAN_DTL_TYPE_CODE"	, 0, szLoanCd)
		
	' ----------------------------------------------------------------------
	' 신용합산 주문가능수량 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtrs_comn_421r" then
		DATAMANAGER.ClearInputData(0, "obtrs_comn_421r")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_421r", "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acnt", "total"))			' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_421r", "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acnt", "sequence"))		' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_421r", "InBlock1", "ISCD"				, 0, szCd)									' 종목코드		
'		DATAMANAGER.SetDataValue(0, "obtrs_comn_421r", "InBlock1", "LOAN_ODER_CLS_CODE"	, 0, cmbCredit.cbkeydata)						' 대출주문구분코드
		DATAMANAGER.SetDataValue(0, "obtrs_comn_421r", "InBlock1", "LOAN_ODER_CLS_CODE"	, 0, "03")' 예탁담보 대출주문구분코드
'20230615 htw start 신용-신용합산 자기융자(05)/유통융자(06) 조회
		'자기융자(05)/유통융자(06)/예탁담보(03)
	elseif szTranID == "obtrs_comn_421r_1" or szTranID == "obtrs_comn_421r_2" then
		DATAMANAGER.ClearInputData(0, szTranID)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acnt", "total"))			' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acnt", "sequence"))		' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD"				, 0, szCd)									' 종목코드		
		if szTranID == "obtrs_comn_421r_1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_ODER_CLS_CODE"	, 0, "06")								' 유통융자 대출주문구분코드
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_ODER_CLS_CODE"	, 0, "05")								' 자기융자 대출주문구분코드
		end if
'20230615 htw end 신용-신용합산 자기융자(05)/유통융자(06) 조회
	elseif szTranID == "obtrs_oder_202r" then
		DATAMANAGER.ClearInputData(0, "obtrs_oder_202r")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acnt", "total"))			' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acnt", "sequence"))		' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD"				, 0, szCd)									' 종목코드		
		
		Dim szGbn, szchkCredit
		szGbn = Form.GetCtlProp("#rdoSellGbn", "currentindex")
		
		'20230619 htw start 신용-신용합산 체크 함수 추가 
		if f_IsCheckedHabSan() then
			szchkCredit = "1"'신용합산
		else
			szchkCredit = "0"'신용합산
		end if
		
		if szchkCredit == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_DTL_TYPE_CODE"	, 0, "0201")	' (대출,신용합산인 경우 이 값만 넘김 나머지 공란/0201=예탁담보)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_DATE"			, 0, "")	' 
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_SRNO"			, 0, "")	' 
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_DTL_TYPE_CODE"	, 0, g_tJangoData(2))	' 
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_DATE"			, 0, g_tJangoData(1))	' 
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_SRNO"			, 0, g_tJangoData(4))	' 
		end if
		
		if f_IsCheckedHabSan() then	' 신용합산 O
		'20230619 htw end 신용-신용합산 체크 함수 추가 
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CRDT_ADUP_ODER_YN"				, 0, "Y")
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CRDT_ADUP_ODER_YN"				, 0, "N")
		end if
	end if
End Sub
				
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szWarnMsg, szOrdCd, szOrdMsg, szOrgNo
	
	' ----------------------------------------------------------------------
	' 주식 매도주문
	' ----------------------------------------------------------------------	
	Select Case szTranID
		Case "obtrs_oder_101a", "obtrs_oder_201a", "obtrs_oder_211a" 	
			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
			
			if szWarnCd = "1" then							' 경고
				Open_ConfirmPopup(szWarnMsg)
			elseif szWarnCd = "2" then						' 보류
				g_szTR = ""
				'Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
			else
				g_szTR = ""
				
				szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
				szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)

				if Trim(szOrdCd) == "0001" then			' 정상주문					
					'20230720 htw start 정상주문시 매도 주문 후 가능 수량 조회시에 환경설정에 따른 수량 값 기입을 통제하기 위한 변수
					g_bAfterOrder = true
					
					Form.Toast(0, szOrdMsg, true)
					
					if g_szAfterInit == "1" then		' 주문후 초기화
						Init_InputControl()
						g_tJangoData = ""
						'20230720 htw start 주문 후 금액 위 text 클리어
						tblDate.SetCellString( 0, 1, "" )
						tblDate.SetCellString( 0, 0, "" )
						'20230720 htw end 주문 후 금액 위 text 클리어
					end if
					
					if g_szAfterOrg == "1" then			' 주문번호 연동
						szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
						
						Form.SetCtlProp("#edtOrgNo", "caption", szOrgNo)
					else
						Form.SetCtlProp("#edtOrgNo", "caption", "")
					end if
					'20230627 htw start 주문 후 가능수량 조회
					Request_Able()
					'20230627 htw end 주문 후 가능수량 조회
				end if
			end If
	' ----------------------------------------------------------------------
	' 주문가능수량 조회
	' ----------------------------------------------------------------------	
		Case "obtrs_comn_405r"
			g_szODER_ABLE_QTY = DATAMANAGER.GetDataValue(0, "obtrs_comn_405r", "OutBlock1", "ODER_ABLE_QTY", 0)			' 주문가능수량
			
			'20230703 SWJ START : 잔고 탭에서 신용/대출 잔고를 클릭해 매도 탭 진입 시, 현금 라디오 -> 신용/대출 라디오 전환이 있음
			'서비스 호출을 대출 라디오가 먼저하지만, iOS는 현금수량 조회 서비스를 더 늦게 조회완료함
			'영향이 없도록 현금/신용/대출 구분 값 분기
			if Form.GetCtlProp("#rdoSellGbn", "currentindex") == "0" then
				lblAbleQty.visible = true
				lblAbleQty.caption = "매도가능 "..FormatNumber(g_szODER_ABLE_QTY,0).."주"
			end if
			'20230703 SWJ END
			
			
			'20230706 htw start=====================================================================================
			if g_bRdoChangeInSellTab then
				'단순라디오 변경 = 수량,단가 유지
				g_bRdoChangeInSellTab = false
			else
				'20230718 htw start============환경설정-종목/탭변경 시 초기화 사용인 경우 잔고 클릭 시 매도수량 자동입력 값 모두 무시하고 잔고수량 삽입
				'20230720 htw start 정상주문시 매도 주문 후 가능 수량 조회시에 환경설정에 따른 수량 값 기입을 통제하기 위한 변수
				if g_bAfterOrder then
					g_bAfterOrder = false
				else
					if g_szChangeInit == "0" then
						'초기화 미사용
						if g_tJangoData <> "" then
							'잔고에서 넘어온 자료가 있으면
							if g_szSelQty == "2" then	'특정수량
								if g_szSelQtyCnt <> "" then
									edtQty.caption = g_szSelQtyCnt
									edtQty_OnEditComplete()
								end if
							else						'특정수량 제외 다른 케이스
								edtQty.caption = g_tJangoData(0)
								edtQty_OnEditComplete()
							end if
						else
							'잔고에서 넘어온 자료가 없으면
							'종목변경/계좌변경
							
							if g_szSelQty == "1" then		' 보유잔고수량
								edtQty.caption = g_szODER_ABLE_QTY
								edtQty_OnEditComplete()
							elseif g_szSelQty == "2" then		' 특정수량
								if g_szSelQtyCnt <> "" then
									edtQty.caption = g_szSelQtyCnt
									edtQty_OnEditComplete()
								end if
							end if
						end if
					else
						'초기화 사용
						if g_tJangoData <> "" then
							'잔고에서 넘어온 자료가 있으면 잔고수량
							edtQty.caption = g_tJangoData(0)
							edtQty_OnEditComplete()
						else
							'잔고에서 넘어온 자료가 없으면
							'종목변경/계좌변경
							edtQty.caption = ""
							edtPrc.caption = ""
							edtQty_OnEditComplete()
						end if
					end if
				end if
				'20230720 htw end 정상주문시 매도 주문 후 가능 수량 조회시에 환경설정에 따른 수량 값 기입을 통제하기 위한 변수
				
'				if g_tJangoData <> "" then
'					'잔고에서 넘어온 자료가 있으면
'					if g_szSelQty == "2" then	'특정수량
'						if g_szSelQtyCnt <> "" then
