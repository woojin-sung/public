'============================================================================
' btnSell_OnClick : 매도버튼 클릭
'============================================================================
Sub btnSell_OnClick()
	Dim szGbn, szchkCredit
	szGbn = Form.GetCtlProp("#rdoSellGbn", "currentindex")
	'20230619 htw start 신용합산 판단 함수 추가
	szchkCredit = f_IsCheckedHabSan()'신용합산
	
	if szchkCredit == true then
		szchkCredit = "1"
	else
		szchkCredit = "0"
	end if

	if szGbn == "1" or szGbn == "2" then	'신용,대출일 때
		if szchkCredit == "0" then		'신용합산 X
			'신용, 대출 잔고 팝업 후 와야함
			'20230717 htw start 조건 변경
'			if #g_tJangoData == 0 then
			if g_tJangoData == "" then
			'20230717 htw end 조건 변경
				Form.ShowAlert("안내", "잔고에서 매도할 종목 선택 후 매도를 진행해주세요.","GO_JANGO","1")
			else
				Check_InputData(0)
			end if
		elseif szchkCredit == "1" then	'신용합산 O
			Check_InputData(0)
		end if
	else
		Check_InputData(0)
	end if
	'20230619 htw end 신용합산 판단 함수 추가
End Sub

'============================================================================
' btnBalance_OnClick : 잔고버튼 클릭
'============================================================================
Sub btnBalance_OnClick()
	'20230619 htw start 신용합산 판단 함수 추가
	Dim szChecked

	'20230725 htw start 현금인 경우 마지막 저장한 신용합산 값으로 오픈
	szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
	if szCLS == "0" then
		szChecked = Form.LoadConfigData( "mbtrs15000", "balance1" )		'신용합산		
	else
		if f_IsCheckedHabSan() then	
			szChecked = "1"
		else
			szChecked = "0"
		end if
	end if
	'20230725 htw end 현금인 경우 마지막 저장한 신용합산 값으로 오픈
	Form.triggerEvent("#", "12000_BALANCE_OPEN", szChecked)
	'20230619 htw end 신용합산 판단 함수 추가
End Sub

