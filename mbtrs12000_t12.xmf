'============================================================================
Sub btnQty_OnClick()
	'종목코드, 종목마켓, 단가, 수량, 매도탭(1),최대 매도 가능 수량,상한가, 하한가, 주문 타입,주문 타입명,단가or수량or금액(단가=0수량=1금액=2)
	Dim szSendData, szPrc, szQty,szHigh,szLow,szCmbType,szCmbCap
	
	if edtPrc.caption <> "" then
		szPrc = edtPrc.caption
	else'현재가
		szPrc = Form.GetCtlProp("#lblHyun", "caption")
	end if
	
	if edtQty.caption <> "" then
		szQty = edtQty.caption
	else
		szQty = "0"
	end if
	
	szHigh =  Form.GetCtlProp("#lblHigh", "caption")
	szLow =  Form.GetCtlProp("#lblLow", "caption")
	szCmbType = cmbType.cbkeydata
	szCmbCap = cmbType.caption
	
	'20230713 htw start 신용-가능수량 조건 추가
	szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
	szSendAbleQty = "0"
	if szCLS == "0" or szCLS == "2" then
		szSendAbleQty = g_szODER_ABLE_QTY
	else
		if CInt(g_szODER_ABLE_SIN_UTONG_QTY) > 0 and CInt(g_szODER_ABLE_SIN_JAGI_QTY) > 0 then
			'둘 다 보유수량이 있으면 가능 수량 0주 셋팅
			szSendAbleQty = "0"
		else
			if CInt(g_szODER_ABLE_SIN_UTONG_QTY) > 0 then
				szSendAbleQty = g_szODER_ABLE_SIN_UTONG_QTY
			elseif CInt(g_szODER_ABLE_SIN_JAGI_QTY) > 0 then
				szSendAbleQty = g_szODER_ABLE_SIN_JAGI_QTY
			end if
		end if
	end if
	
'	szSendData = g_szCd.."★".. g_szMk .."★"..szPrc.."★"..szQty.."★".."1".."★"..g_szODER_ABLE_QTY.."★"..szHigh.."★"..szLow.."★"..szCmbType.."★"..szCmbCap.."★".."1"
	szSendData = g_szCd.."★".. g_szMk .."★"..szPrc.."★"..szQty.."★".."1".."★"..szSendAbleQty.."★"..szHigh.."★"..szLow.."★"..szCmbType.."★"..szCmbCap.."★".."1"
	'20230713 htw end 신용-가능수량 조건 추가
	Form.OpenPopupAnimation("mbtrs12000_pl" , szSendData, "","2")
'	Dim szPrc, szData
'
'	if Trim(edtPrc.caption) <> "" then
'		szPrc = edtPrc.caption
'	else
'		szPrc = Form.GetCtlProp("#lblHyun", "caption")
'	end if
'
'	' 종목코드
'	szCd = Change_ItemCode()
'		
'	'주문유형
'	szType = Check_OrdType()
'	
'	szData = "1★" & edtQty.caption & "★" & g_szMk & "★" & szPrc
'	szData = szData & "♥" & Form.GetCtlProp("#acnt", "total")			' 계좌번호(8)
'	szData = szData & "♥" & Form.GetCtlProp("#acnt", "sequence")		' 계좌일련번호(2)
'	'szData = szData & "♥" & Form.GetCtlProp("#edtPwd", "encdata")		' 계좌비밀번호
'	szData = szData & "♥" & ""										' 계좌비밀번호
'	szData = szData & "♥" & szCd									' 종목코드
'	szData = szData & "♥" & szType									' 주문구분코드
'	szData = szData & "♥" & "1"									' 매매구분코드(매도) ' 20190108 HWG : 매매구분코드 오류수정(매도:1 매수:2)
'	szData = szData & "♥" & "1"									' 조회구분코드
