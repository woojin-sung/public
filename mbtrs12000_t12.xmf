'============================================================================
'20230703 SWJ START
'주문환경설정에서 '매도보유수량'으로 설정되어있을 때
'한 종목이 유통융자, 자기융자 모두 잔고를 가지고 있으면 미설정
'이 외 경우는 잔고 가지고 있는대로 세팅
'============================================================================
Function UtongJagiQty(szQty1, szQty2)
	'chkSinUtong, chkSinJagi에서 g_tJangoData를 클리어함
	'그 이후에 잔고수량을 조회하다보니
	'이 함수를 타게 되고
	'밑에 로직을 타서 edtQty가 클리어 됨, 이를 방지
	'(유통융자 자기융자 잔고 모두 있을 때의 경우)
	if chkSinUtong.checkstate == "1" then
		edtQty.caption = szQty1
		edtQty_OnEditComplete()
		exit function
	end if
	
	if chkSinJagi.checkstate == "1" then
		edtQty.caption = szQty2
		edtQty_OnEditComplete()
		exit function
	end if

	'자기융자, 유통융자 잔고가 모두 있는 경우와
	'자기융자, 유통융자 잔고가 모두 0인  경우 클리어 해준다
	if szQty1 <> "" and szQty2 <> ""then
		if (szQty1 <> 0 and szQty2 <> 0) or (szQty1 == 0 and szQty2 == 0) then
			edtQty.caption = 0
			edtQty_OnEditComplete()
			exit function
		end if
	end if
	
	if szQty1 <> "" then
		if Cdbl(szQty1) <> 0 then 
			edtQty.caption = szQty1
			edtQty_OnEditComplete()
			exit function
		end if
	end if
	
	if szQty2 <> "" then
		if Cdbl(szQty2) <> 0 then 
			edtQty.caption = szQty2
			edtQty_OnEditComplete()
			exit function
		end if
	end if
End Function
'============================================================================
'20230703 SWJ START
'라디오가 바뀔 때 수량 클리어 해준다
'============================================================================
Sub RdoQtyClear(szEventName, szCurrentTab)
	'탭 바뀔 시 클리어
	if g_szSelQty == "1" then
		if szEventName == "ORDER_GBN" then
			if szCurrentTab == "1" then
				UtongJagiQty(g_szODER_ABLE_SIN_UTONG_QTY, g_szODER_ABLE_SIN_JAGI_QTY)
			else
				edtQty.caption = g_szODER_ABLE_QTY
				edtQty_OnEditComplete()
			end if
		end if
	else
		if szEventName == "ORDER_GBN" or szEventName == "ORDER_GBN_JANGO_LATER" then
			edtQty.caption = ""
			edtQty_OnEditComplete()
		end if
	end if
	
End Sub
'============================================================================
'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if
	
	' ----------------------------------------------------------------------
	' 주식 매도주문(주문에러는 초기화 안함 : 20160314 전요셉과장)
	' ----------------------------------------------------------------------	
'	if szTranID == "obtrs_oder_101a" or szTranID == "obtrs_oder_201a" or szTranID == "obtrs_oder_211a" then
'		if g_szAfterInit == "1" then		' 주문후 초기화
'			Init_InputControl()
'		end if	
'	end if
End Sub

'===='20230628 htw start 수량 조회 후 컨트롤 visible 설정 함수 생성
function f_SetAbleQtyVisible()
	' 현금/신용 구분
	szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
	'20230615 htw start 가능 수량 조회 조건 변경
	if szCLS == "1" then'신용
		'20230626 htw start 잔고 클릭 후 현재 라디오와 다른 라디오인 경우 컨트롤 visible이 중복되어 마지막 부분에 재적용 추가
		chkCredit.visible = false
		chkSinUtong.visible = true
		chkSinJagi.visible = true
		lblAbleQty.visible = false
		lblAbleQty0.visible = true
		lblAbleQty1.visible = true
		imgInfo0.visible = false
		imgInfo1.visible = true
		imgInfo2.visible = true
		
		chkRepay.visible = true
	elseif szCLS == "2" then'대출
		chkCredit.visible = true
		chkSinUtong.visible = false
		chkSinJagi.visible = false
		lblAbleQty.visible = true
		lblAbleQty0.visible = false
		lblAbleQty1.visible = false
		imgInfo0.visible = true
		imgInfo1.visible = false
		imgInfo2.visible = false
		
		chkRepay.visible = true
	else'현금
		chkCredit.visible = false
		chkSinUtong.visible = false
		chkSinJagi.visible = false
		lblAbleQty.visible = true
		lblAbleQty0.visible = false
		lblAbleQty1.visible = false
		imgInfo0.visible = false
		imgInfo1.visible = false
		imgInfo2.visible = false
		
		chkRepay.visible = false
	end if
end function
'===='20230628 htw end 수량 조회 후 컨트롤 visible 설정 함수 생성

'============================================================================
' cmbType_OnEditComplete
'============================================================================
Sub cmbType_OnEditComplete(iIndex)
	Form.SetSharedData("S_TYPE", cmbType.currentindex)
	Form.SetSharedData("STOCK_SELTYPE", cmbType.cbkeydata)
	Form.triggerEvent("#", "12000_SELTYPE", "")
	Visible_Control(iIndex)
	
	if iIndex == 1 then
		chkMarketPrice.chksilence = true
		edtPrc.caption = ""
	else
		chkMarketPrice.chksilence = false
	end if
	
	'htw 230525 장전시간외 최초 클릭 시 토스트 메세지 제공 start
	if iIndex == 11 then
		if g_bFirstSelectBeforeMarket == false then
			g_bFirstSelectBeforeMarket = true
'			Form.Toast(1, "장전시간외로 주문시 08:15~08:30에는 정정 및 취소가 불가하오니 유의해주세요.", 1)
			Form.triggerEvent("#", "FirstBeforeMarketClick", "")
		end if
	end if	
	'htw 230525 장전시간외 최초 클릭 시 토스트 메세지 제공 end
End Sub

'============================================================================
' edtPrc_OnEditComplete
'============================================================================
Sub edtPrc_OnEditComplete()
	Form.SetSharedData("S_PRC", edtPrc.caption)
	Form.SetCtlProp("#lblPrc", "caption", edtPrc.caption)
	
	Dim szCLS
	szCLS = Form.GetCtlProp("#rdoSellGbn", "currentindex")
	
'	if szCLS == "0" then
'20230626 htw start Request_Able() 주석처리
'		Request_Able()
'20230626 htw end Request_Able() 주석처리
'	end if
	
	f_SetOrderPrice()
	
End Sub

'============================================================================
' edtQty_OnEditComplete 
'============================================================================
Sub edtQty_OnEditComplete()
	Form.SetSharedData("S_QTY", edtQty.caption)
	f_SetOrderPrice()
End Sub

