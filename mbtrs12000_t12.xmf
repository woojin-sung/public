'============================================================================
' chkCredit_OnChange
'============================================================================
Sub chkCredit_OnChange(sCheckState)
	
'	tblDate.visible = false
	Form.SetSharedData("S_CSM", chkCredit.checkstate)
	g_tJangoData = ""'잔고에서 받아온 data 초기화
	
	if CInt(sCheckState) == 0 then
		tblDate.SetCellString( 0, 0, "" )
		tblDate.SetCellString( 0, 1, "" )
		tblDate.visible = false
		'20230720 htw start 합산체크 해제시 수량 클리어 + 합산 체크 시 가능수량삽입
		edtQty.caption = ""
	else
		tblDate.SetCellString( 0, 0, "예탁주식" )
		tblDate.SetCellString( 0, 1, "" )
		tblDate.visible = true
		edtQty.caption = g_szODER_ABLE_QTY
	end if
	
	edtCredit.caption = cmbCredit.cbkeydata
	Init_cmbCredit(sCheckState)	
	Select_cmbCredit(sCheckState)
	edtQty_OnEditComplete()
	'20230720 htw end 합산체크 해제시 수량 클리어 + 합산 체크 시 가능수량삽입
	
	'20230807 SWJ START : 주문화면에서 신용합산 체크가 있으면, 잔고화면에서도 체크
	if f_IsCheckedHabSan() then
		Form.SaveConfigData("mbtrs12000", "balance1", "1")
	else
		Form.SaveConfigData("mbtrs12000", "balance1", "0")
	end if
	'20230807 SWJ END
End Sub

Function Select_cmbCredit(szChk)
	Dim szCredit
	szCredit = edtCredit.caption
	
	if szChk == "1" then
		if szCredit == "01" or szCredit == "05" or szCredit == "06" then
			cmbCredit.cbkeydata = "01"
		elseif szCredit == "03" then
			cmbCredit.cbkeydata = "03"
		end if
	else
		if szCredit == "01" or szCredit == "05" or szCredit == "06" then
			cmbCredit.cbkeydata = "05"
		elseif szCredit == "03" then
			cmbCredit.cbkeydata = "03"
		end if
	end if
	
	edtCredit.caption = cmbCredit.cbkeydata
	Form.SetSharedData("S_CGN", cmbCredit.currentindex)
End Function

