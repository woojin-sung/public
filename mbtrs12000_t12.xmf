'						else
'							'초기화 사용
'							edtQty.caption = ""
'							edtPrc.caption = ""
'							edtQty_OnEditComplete()
'						end if
'					end if
'				end if
				'20230718 htw end============환경설정-종목/탭변경 시 초기화 사용인 경우 잔고 클릭 시 매도수량 자동입력 값 모두 무시하고 잔고수량 삽입
			end if
			
			'20230706 htw end=====================================================================================
			
			'20230703 SWJ START : g_bFirstStartScreen 관련 분기 주석 처리
			'20230620 htw start 환경설정 data 적용
			'if g_bFirstStartScreen == false then
				'매도화면 첫 전입시 환경설정 내용 반영
				'g_bFirstStartScreen = true
