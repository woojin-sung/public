	<MAP_INFO scrno="50200" scrname="ETF투자가이드_FAQ" version="2" writer="홍수지" />
	<FORM_INFO name="Form" ly_vert="0,0,375,608,1" />
	<CONTROL_INFO>
		<CONTAINER name="cont" ly_vert="20,130,335,458,1" scroll_ly_vert="20,130,335,458,1" >
			<CONTROL_INFO/>
		</CONTAINER>
		<LABEL name="Label1" fontstyle="01" caption="ETF에 대한
궁금한 점을 해결해드립니다." valign="0" multiline="1" paddinginfo="1,1,0,0" ly_vert="20,31,230,59,1" />
		<IMAGE name="Image0" autosize="1" imgpath="guide_img_faq" ly_vert="267,10,88,100,1" />
