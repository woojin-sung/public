'============================================================================
Sub BtnNext_OnClick()
	'안내팝업 실행
	Form.OpenPopup("mbbdm85181_p1" , "" , "")
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "mbbdm85181_p1_end" Then
		If sRet == "ok" Then
			Form.CloseForm()
			Form.OpenScreen( "41000" , "")
		End If
	End If 
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
	Form.OpenPopup("mbbdm85181_p1" , "" , "") 
End Sub

