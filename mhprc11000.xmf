Sub fmTab00_OnTabChanged(nCurrentTab)
	'20240503_01 HWG START : MTS ETF 고도화 대응
	Form.SetEnvData(1, "11000_SELECT_TABPAGE_0_ID" , fmTab00.currenttabpageid)
	'20240503_01 HWG END
	
	'20220330 HSZ START : CFD현재가 화면 분기처리
	if g_szScreenNo = "13100" then
		innerMarket = Int(Form.GetItemCodeInfo( g_szItemCode , "innermarket"))
		if g_szItemMarket = "J" or g_szItemMarket = "Q" then
			if Left(g_szItemCode, 1) = "J" or Left(g_szItemCode, 1) = "F" or innerMarket = 033 then '신주인수권,수익증권,코넥스 제외
				g_szItemCode = Form.GetSharedData("&ITEM_STOCK_CFD", 0)
			end if
		else
			g_szItemCode = Form.GetSharedData("&ITEM_STOCK_CFD", 0)
		end if
	end if
	'20220330 HSZ END
	
	Dim szType
	
	If fmTab00.GetTabPageCaption( fmTab00.currenttabpageid ) = "단일가" Then
		szType = "13"
	Else
		szType = "00"
	End If
	
	Form.triggerEvent("linkfmHoga", "HOGA_TYPE", szType) 						' 링크화면에 시장구분 던지기
	
'	g_nfmTab = nCurrentTab
	Form.triggerEvent("fmTab00." & fmTab00.currenttabpageid, "INIT_CODE", g_szItemCode)
	
End Sub

