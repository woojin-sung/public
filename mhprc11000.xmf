'============================================================================
Sub Form_OnFormInitBefore()
	'------------------------------------------------------------------
	' 20190814 HWG START : MTS 위변조체크로직 추가
	'------------------------------------------------------------------
	'MTS 위변조방지 스킵 대응
	szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	szDev 		= Form.GetSharedData("&SERVER_MODE", False)
	szAppVer 	= Form.GetSharedData("&APP_VERSION_CODE", False)
	szPrivateKey	= "vjdDoV5kQc7lNK4VARxk0TSWA4k=\n"
	
	if szDev <> "1" and szOsType == "1" and Cint(szAppVer) > 39 then
		szKeyValue = Form.GetSharedData("&KEY_VALUE", False)
		if trim(szPrivateKey) <> trim(szKeyValue) then
			
			'20180912_01 KBC START : 모의해킹결과조치
			if Cint(szAppVer) > 44 then
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.SetSharedData("&SGB" , "BBE") 
				
				Form.sendItemPrice()			'App 종료API 추가 (네이밍무관)
				Form.sendMessage()			'App 종료API 추가 (네이밍무관)
				Form.TerminateApp()
				
			else 
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.TerminateApp()
			end if

			'20180912_01 KBC END
			exit sub
		end if
	end if
	'------------------------------------------------------------------
	
	Form.SetSharedData("&CODE_DUPR_USE" , "YES")	'20191022 HWG : 해외파생 중복실행 차단
	
	Form.SetButtonTitle("주문")	'SETSEARCHTYPE 이전에 세팅

'시장 인자(2번째 값)
'SEARCH_TYPE_INTR        = "0"
'SEARCH_TYPE_STOCK_ALL   = "1"
'SEARCH_TYPE_STOCK       = "2"
'SEARCH_TYPE_ELW         = "3"
'SEARCH_TYPE_FUOPT       = "4"
'SEARCH_TYPE_ETF         = "5"
'SEARCH_TYPE_ETN         = "6"
'SEARCH_TYPE_BOND        = "7"
'SEARCH_TYPE_OVERSEA     = "8"
'SEARCH_TYPE_JISU        = "9"
'SEARCH_TYPE_K200        = "10"
'SEARCH_TYPE_K200_MINI   = "11"
'SEARCH_TYPE_FUND        = "12"
'20210823 HSZ START : CFD현재가 화면 추가
'SEARCH_TYPE_전체_CFD       = "22"
'SEARCH_TYPE_주식_CFD       = "23"
'SEARCH_TYPE_ETF_CFD        = "24"
'SEARCH_TYPE_ETN_CFD        = "25"

	g_szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	if g_szScreenNo = "13100" then	'CFD현재가
		Form.SetSearchType("22:23:24:25")
	else							'주식현재가
		Form.setSearchTypeClick("1")
		Form.SetSearchType("29:1:5:6:3:15")
		'Form.SetSearchType ("40:41:42:43:44:45:46:47:48")	'20180712 HAMWG : K-OTC MTS 도입	'20220922 SWJ START : 국내주식 최근조회종목 탭 추가
	end if

End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
'	MSGBOX sEventName..sParam

	If sEventName = "TITLE_CLICK" Then
		'20220922 SWJ START : 종목정보 없애고 종목선택 팝업 추가
		'현재가 스타일 메인 화면에서 메모 이미지 클릭했을 때는 이전처럼 종목정보 떠야 함
		if sParam = "11000_MEMO" then
			If g_bPopupFg = false Then
				Form.OpenPopup("mhprc11000_p1" , "" , "")
				g_bPopupFg = true
			End If
		else
			if g_szScreenNo = "13100" then
				Form.OpenCommonDialog("SEARCH", "22:23:24:25", "")
			else
				Form.OpenPopup("msearchdialog", "종목검색★40:41:42:43:44:45:46:47:48★INTG_DIVIDE_HISTORY★KRX★16000", "")
'				Form.OpenCommonDialog("SEARCH", "29:1:5:6:3:15", "")
			end if		
		end if	
		'20220922 SWJ END	
	
	ElseIf sEventName = "FORMTAB_SET" Then							' 폼탭 셋팅
		'20180712 HAMWG START : K-OTC MTS 도입
		If g_szItemMarket = "T" Then
			fmTab01.showconfig("탭표시 순서 변경")
		Else
			'20230425 KKM START: ETF/ETN/ELW 폼탭 추가
			If ((g_szItemMarket = "J") and (g_szInnerMarket = "013")) or (g_szItemMarket = "Q") or (g_szItemMarket = "W") Then
				'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
				szOsType 	= Form.GetSharedData("&OS_TYPE", False)
				if szOsType = "2" then
					szAppVer 	= Form.GetSharedData("&APP_VERSION", False)
					arrAppVer	= split(szAppVer, ".")
					
					if #arrAppVer > 2 then
						nAppVer = Cint(arrAppVer(0)) * 1000 + Cint(arrAppVer(1)) * 100 + Cint(arrAppVer(2))
						
						if nAppVer < 2546 then
							Form.ShowAlert("안내", "업데이트 후 이용이 가능해요.\n앱스토어에서 업데이트를 진행해주세요.")
						else
							g_szTabChange = "1"
							fmTab02.showconfig("탭표시 순서 변경")
						end if
					else
						Form.ShowAlert("안내", "업데이트 후 이용이 가능해요.\n앱스토어에서 업데이트를 진행해주세요.")
					end if
					
				else
					g_szTabChange = "1"
					fmTab02.showconfig("탭표시 순서 변경")
				end if
				'20240613_01 HWG END
			Else		
				fmTab00.showconfig("탭표시 순서 변경")
			End If 
			'20230425 KKM END
		End If
		'20180712 HAMWG END
	ElseIf sEventName = "FORMTAB_INIT" Then							' 폼탭 초기화
		fmTab00.SetDefaultHeader()
		fmTab02.SetDefaultHeader()
		fmTab01.SetDefaultHeader()	'20180712 HAMWG : K-OTC MTS 도입
		
		szOsType 	= Form.GetSharedData("&OS_TYPE", False)
		if szOsType = "2" then
			Change_Tab()
		end if
		
	ElseIf sEventName = "HOGA_SETUP" Then			' 폼탭 초기화
		Dim szStyle
		szStyle	= Form.LoadConfigData("mhprc11000", "Style"	)	'현재가 스타일
		
		'20210823 HSZ START : CFD현재가 화면 추가 (현재가 스타일2로 고정)
		if g_szScreenNo = "13100" then			
			szStyle = "1"
		end if
		'20210823 HSZ END 
		
'		If szStyle = "0" Then
'			'20211021 아이티젠(김성수) 현재가 개선
'			linkfmHoga.linkfile = "mhprc11000_s4" 
'		ElseIf szStyle = "1" Then
'			linkfmHoga.linkfile = "mhprc11000_s5" 
'		ElseIf szStyle = "2" Then
'			linkfmHoga.linkfile = "mhprc11000_s6"
'		Else
'			linkfmHoga.linkfile = "mhprc11000_s5"
'		End If

		'20230407 KKM: 현재가 개선 - 스타일 하나로 고정
		linkfmHoga.linkfile = "mhprc11000_s7" 
		
		'20180712 HAMWG START : K-OTC MTS 도입
		If g_szItemMarket = "T" Then
			If fmTab01.currenttab = "0" or  fmTab01.currenttab =  0 Then
				Form.triggerEvent("fmTab01." & fmTab01.currenttabpageid, "HOGA_SETUP", "" )
			End If
		Else
			'20230425 KKM START: ETF/ETN/ELW 폼탭 추가
			If ((g_szItemMarket = "J") and (g_szInnerMarket = "013")) or (g_szItemMarket = "Q") or (g_szItemMarket = "W") Then
				If fmTab02.currenttab = "0" or  fmTab02.currenttab =  0 Then
					Form.triggerEvent("fmTab02." & fmTab02.currenttabpageid, "HOGA_SETUP", "" )
				End If
			Else
				If fmTab00.currenttab = "0" or  fmTab00.currenttab =  0 Then
					Form.triggerEvent("fmTab00." & fmTab00.currenttabpageid, "HOGA_SETUP", "" )
				End If
			End if 
			'20230425 KKM END 
		
		End If
		'20180712 HAMWG END
		
		Form.SetItemCode(g_szItemCode)	'종목스타일 변경시 종목을 던져서 재조회		
		
'	ElseIf sEventName = "REQUEST_ITEMCODE" Then						' 종목코드 못받을시 다시 보냄.
'		Form.triggerEvent("fmTab00." & fmTab00.currenttabpageid, "INIT_CODE", g_szItemCode)
			
	ElseIf sEventName = "SCREEN_MENU" Then							' 연결정보(상단 ...)
		
		If sParam = "CON_INQUIRY" Then								' 연속조회
			Form.OpenPopupAnimation("mhprc11000_ir", "", "", "2")
		ElseIf sParam = "REG_INTR" Then								' 관심종목등록
			'20230525 KKM 등록 팝업 START
'			Form.OpenPopup("mhprc11000_pd" , g_szItemCode , "")
			Form.OpenPopupAnimation("mhprc11000_pd", g_szItemCode& "★"& sParam,"", "2")	'종목등록
			'20230525 KKM END
		ElseIf sParam = "REG_WATCHING" Then							' Watching종목등록
			Form.OpenFramePopup("mhprc11020_p1" , g_szItemCode , "")
			
		ElseIf sParam = "SET_SCREEN" Then							' 화면설정
			Form.OpenFramePopup("mhprc11000_pc" , "" , "")
			
		ElseIf sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns" , "1", "")
		End If
	elseif sEventName = "sharedata" Then
		Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
		
	'20230511 KKM START 관심종목등록 / 주문버튼 클릭시  
	elseif sEventName = "CLICK_GWANSIM" Then
		Form.triggerEvent("linkfmHoga", sEventName, "") ' 링크화면 알림	
'		Form.OpenPopupAnimation("mhprc11000_pd", g_szItemCode, "", "2")
	elseif sEventName = "CLICK_BUTTON" Then
		SendOrder(0) '매수
	'20230511 KKM END 
	'20230525 KKM START: 등록/삭제화면 팝업 - linkfmHoga에서 받은 트리거
	elseif sEventName = "mhprc11000_pd_popup" then 
		Form.OpenPopupAnimation("mhprc11000_pd", g_szItemCode& "★"& sParam,"", "2")	'종목등록
	elseif sEventName = "mhprc11000_pe_popup" then 
		Form.OpenPopup("mhprc11000_pe", g_szItemCode& "★"& sParam,"", "")	'종목삭제
	elseif sEventName = "mhprc11000_pf_popup" then 
		Form.OpenPopup("mhprc11000_pf", sParam & "★" & g_szItemCode & "★", "")	'관심그룹과 관심종목 동시추가
'	20230525 KKM END 	
	End If

End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "11000_p1_Close" Then
		If Trim(sRet) = "종목없음" Then
			g_bPopupFg = false
		Else
			g_bPopupFg = false
			g_szItemCode = sRet
			
			'20180712 HAMWG START : K-OTC MTS 도입
			szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
			If g_szItemMarket <> szItemMarket then
				If g_szItemMarket = "T" or szItemMarket = "T" Then
					g_bChangeMk = True
				End If
			End if
			g_szItemMarket = szItemMarket
			'20180712 HAMWG END
			
			lblItemCode.caption = g_szItemCode
			Form.SetItemCode(g_szItemCode)
			
			SetTabPage()
			
			ResponseTran_021r()	'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
		End If
	ElseIf sKeyName = "11000_pb_Close" Then
		g_bPopupFg = false
		
	ElseIf sKeyName = "FORMTAB_SET" Then		' 폼탭 셋팅
		'20180712 HAMWG START : K-OTC MTS 도입
		If g_szItemMarket = "T" Then
			fmTab01.showconfig("탭표시 순서 변경")
		Else
			'20230425 KKM START: ETF/ETN/ELW 폼탭 추가
			If ((g_szItemMarket = "J") and (g_szInnerMarket = "013")) or (g_szItemMarket = "Q") or (g_szItemMarket = "W") Then
				'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
				szOsType 	= Form.GetSharedData("&OS_TYPE", False)
				if szOsType = "2" then
					szAppVer 	= Form.GetSharedData("&APP_VERSION", False)
					arrAppVer	= split(szAppVer, ".")
					
					if #arrAppVer > 2 then
						nAppVer = Cint(arrAppVer(0)) * 1000 + Cint(arrAppVer(1)) * 100 + Cint(arrAppVer(2))
						
						if nAppVer < 2546 then
							Form.ShowAlert("안내", "업데이트 후 이용이 가능해요.\n앱스토어에서 업데이트를 진행해주세요.")
						else
							g_szTabChange = "1"
							fmTab02.showconfig("탭표시 순서 변경")
						end if
					else
						Form.ShowAlert("안내", "업데이트 후 이용이 가능해요.\n앱스토어에서 업데이트를 진행해주세요.")
					end if
				else
					g_szTabChange = "1"
					fmTab02.showconfig("탭표시 순서 변경")
				end if
				'20240613_01 HWG END
			Else
				fmTab00.showconfig("탭표시 순서 변경")
			End if
			'20230425 KKM END 
		End If
		'20180712 HAMWG END
		
	ElseIf sKeyName = "FORMTAB_INIT" Then		' 폼탭 초기화
		fmTab00.SetDefaultHeader()
		fmTab02.SetDefaultHeader()
		fmTab01.SetDefaultHeader()	'20180712 HAMWG : K-OTC MTS 도입
		
		szOsType 	= Form.GetSharedData("&OS_TYPE", False)
		if szOsType = "2" then
			Change_Tab()
		end if
	
	ElseIf sKeyName = "HOGA_SETUP" Then			' 폼탭 초기화
		Dim szStyle
		szStyle	= Form.LoadConfigData("mhprc11000", "Style"	)	'현재가 스타일
		
		'20210823 HSZ START : CFD현재가 화면 추가 (현재가 스타일2로 고정)
		if g_szScreenNo = "13100" then			
			szStyle = "1"
		end if
		'20210823 HSZ END 
		
'		If szStyle = "0" Then
'			'20211021 아이티젠(김성수) 현재가 개선
'			linkfmHoga.linkfile = "mhprc11000_s4" 
'		ElseIf szStyle = "1" Then
'			linkfmHoga.linkfile = "mhprc11000_s5" 
'		ElseIf szStyle = "2" Then
'			linkfmHoga.linkfile = "mhprc11000_s6" 
'		Else
'			linkfmHoga.linkfile = "mhprc11000_s5"
'		End If
		'20230407 현재가 개선
		linkfmHoga.linkfile = "mhprc11000_s7" 	
		
		'20180712 HAMWG START : K-OTC MTS 도입
		If g_szItemMarket = "T" Then
			If fmTab01.currenttab = "0" or  fmTab01.currenttab =  0 Then
				Form.triggerEvent("fmTab01." & fmTab01.currenttabpageid, "HOGA_SETUP", "" )
			End If
		Else
			'20230425 KKM START : ETF/ETN/ELW 폼탭 추가
			If ((g_szItemMarket = "J") and (g_szInnerMarket = "013")) or (g_szItemMarket = "Q") or (g_szItemMarket = "W") Then		
				If fmTab02.currenttab = "0" or  fmTab02.currenttab =  0 Then
					Form.triggerEvent("fmTab02." & fmTab02.currenttabpageid, "HOGA_SETUP", "" )
				End If
			Else
				If fmTab00.currenttab = "0" or  fmTab00.currenttab =  0 Then
					Form.triggerEvent("fmTab00." & fmTab00.currenttabpageid, "HOGA_SETUP", "" )
				End If
			End if 
			'20230425 KKM END 
		End If
		'20180712 HAMWG END
		
		Form.SetItemCode(g_szItemCode)	'종목스타일 변경시 종목을 던져서 재조회
	elseif sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else
			Form.triggerEvent("linkfmHoga", "sharedata", "")
		End If
		
	'20211022 아이티젠(김성수) 현재가 개선 START
	elseif sKeyName = "mhprc11000_save" then '관심등록 완료 후
		Form.triggerEvent("linkfmHoga", sKeyName, sRet)  ' ADD, DEL, GROUP_ADD2
	'20211022 아이티젠(김성수) 현재가 개선 END
	elseif sKeyName = "DLG_SELECT" then
		szOsType 	= Form.GetSharedData("&OS_TYPE", False)
'		if szOsType == "2" then
			g_szItemCode = Form.GetSharedData("&ITEM_STOCK", false)
			Form.SetItemCode(g_szItemCode)
'		end if
	End If
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		'20180712 HAMWG START : K-OTC MTS 도입
		g_szItemCode = sValue
		szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		g_szInnerMarket= Form.GetItemCodeInfo(g_szItemCode, "innermarket")	
		
		If g_szItemMarket <> szItemMarket then
			If g_szItemMarket = "T" or szItemMarket = "T" Then
				g_bChangeMk = True
			End If
		End if
		g_szItemMarket = szItemMarket
		lblItemCode.caption = g_szItemCode
		
		'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
		SetTabPage()
		
		ResponseTran_021r()
		'20240613_01 HWG END
		
	elseif sKey = "&ACR_ITEM" then
		'20180712 HAMWG START : K-OTC MTS 도입
		g_szItemCode = sValue

		szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		If g_szItemMarket <> szItemMarket then
			If g_szItemMarket = "T" or szItemMarket = "T" Then
				g_bChangeMk = True
			End If
		End if
		g_szItemMarket = szItemMarket
		Form.SetItemCode(g_szItemCode)
		lblItemCode.caption = g_szItemCode
		
		'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
		SetTabPage()
		
		ResponseTran_021r()
		'20240613_01 HWG END
	end	if
End Sub

'20180712 HAMWG START : K-OTC MTS 도입
Function SetTabPage()
	Dim bCheckPage
	bCheckPage = False
	
	If g_szItemMarket = "T" Then		
		'If g_bChangeMk = True Then
			g_szfmTabPage = Form.getEnvData("11000_SELECT_TABPAGE_0_ID")
			
			For i=0 to UBOUND(g_szfmTab01List)
				If g_szfmTabPage = g_szfmTab01List(i) Then
					bCheckPage = True
				End If
			Next
			
			If bCheckPage = True Then
				fmTab01.currenttabpageid = g_szfmTabPage
			Else
				fmTab01.currenttabpageid = g_szfmTab01List(0)
			End If	
		'End If
		
		g_bChangeMk = False
	Else
		'If g_bChangeMk = True Then
			'20230425 KKM START: ETF/ETN/ELW 폼탭 추가
			If ((g_szItemMarket = "J") and (g_szInnerMarket = "013")) then		
				g_szfmTabPage = Form.getEnvData("11000_SELECT_TABPAGE_0_ID")	'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
				
				For i=0 to UBOUND(g_szfmTab02List)
					If g_szfmTabPage = g_szfmTab02List(i) Then
						bCheckPage = True
					End If
				Next
				
				'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
				if g_szfmTabPage == "page004230" then
					bCheckPage = True
				end if
				'20240613_01 HWG END
				
				If bCheckPage = True Then
					fmTab02.currenttabpageid = g_szfmTabPage
				Else
					fmTab02.currenttabpageid = g_szfmTab02List(0)
				End If			
			elseif (g_szItemMarket = "Q") or (g_szItemMarket = "W") Then
			
				g_szfmTabPage = Form.getEnvData("11000_SELECT_TABPAGE_0_ID")	'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
				
				For i=0 to UBOUND(g_szfmTab02List)
					If g_szfmTabPage = g_szfmTab02List(i) Then
						bCheckPage = True
					End If
				Next
				
				
				If bCheckPage = True Then
					fmTab02.currenttabpageid = g_szfmTabPage
				Else
					fmTab02.currenttabpageid = g_szfmTab02List(0)
				End If			
			Else		
				g_szfmTabPage = Form.getEnvData("11000_SELECT_TABPAGE_0_ID")	'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
				
				For i=0 to UBOUND(g_szfmTab00List)
					If g_szfmTabPage = g_szfmTab00List(i) Then
						bCheckPage = True
					End If
				Next
			
				If bCheckPage = True Then
					fmTab00.currenttabpageid = g_szfmTabPage
				Else
					fmTab00.currenttabpageid = g_szfmTab00List(0)
				End If			
			End If
			'20230425 KKM END 
		'End If
		
		g_bChangeMk = False
	End If
End Function
'20180712 HAMWG END

'============================================================================
Sub Form_OnRefresh()
	Form.triggerEvent("linkfmHoga", "INIT_CODE", g_szItemCode) 						' 링크화면에 종목코드 던지기
	'20230425 KKM 종목종류별 탭리플래쉬 START
	If g_szItemMarket = "T" Then		
		Form.triggerEvent("fmTab01." & fmTab01.currenttabpageid, "INIT_CODE", g_szItemCode)	' 탭화면에 종목코드 던지기
	Else
		'20230425 KKM START: ETF/ETN/ELW 폼탭 추가
		If ((g_szItemMarket = "J") and (g_szInnerMarket = "013")) or (g_szItemMarket = "Q") or (g_szItemMarket = "W") Then
			Form.triggerEvent("fmTab02." & fmTab02.currenttabpageid, "INIT_CODE", g_szItemCode)	' 탭화면에 종목코드 던지기
		Else 
			Form.triggerEvent("fmTab00." & fmTab00.currenttabpageid, "INIT_CODE", g_szItemCode)	' 탭화면에 종목코드 던지기
		End if
	End if
	'20230425 KKM END 	
End Sub

'============================================================================
'20220922 SWJ START : 종목정보 없애고 종목선택 팝업 추가
'============================================================================
' Form_OnCommonDialogReturn
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	' 종목컨트롤에서 리턴
	if sDlgName == "SEARCH" then
		if Trim(sReturn1) <> "" then
			Form.SetItemCode(sReturn1)
		end if
	end if
End Sub


'20230523 KKM 주문 추가 START
Function SendOrder( szTab )
	Dim szData
	
	'20210823 HSZ START : CFD현재가 화면 추가 
	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	if szScreenNo = "13100" then	
		' 전달내용/탭위치/종목코드/가격
		'szData = "현재가" & "★" & szTab & "★" & g_szItemCode & "★" & g_nPrice
		szData = "현재가" & "★" & szTab & "★" & g_szItemCode 
		
		Form.OpenScreen( "13200" , szData )
		exit Function 
	end if
	'20210823 HSZ END

	' 전달내용/탭위치/종목코드/가격
	'szData = "현재가" & "★" & szTab & "★" & g_szItemCode & "★" & g_nPrice
	szData = "현재가" & "★" & szTab & "★" & g_szItemCode  
	
	Form.OpenScreen( "12000" , szData )

End Function
'20230523 KKM END

'20240503_01 HWG START : MTS ETF 고도화 대응
