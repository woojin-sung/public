Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_metf_021r" then
		ResponseTran_021r()
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(sTimerID,0,0)
	
	if Cint(sTimerID) = 1 then
		if fmTab02.currenttabpageid = "page004230" then
			fmTab02.currenttabpageid = "page001725"
		end if
	end if
End Sub
