'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주식현재가
' 02. 화면설명 : 주식현재가
' 03. 작    성 : 2016.04.30 LJS
' 202304 KKM: 현재가 개선건 - 폼탭추가(ETF/ETN/ELW일 경우 기업재무/투자의견/섹터 탭 삭제) 및 폼탭 별 구성 수정
' 202305 KKM: 현재가 개선건 - 상단트리거 추가 (주문화면이동, 관심종목 등록/삭제)
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_nfmTab, g_szItemCode, g_szItemMarket, g_szInnerMarket
Dim g_bPopupFg
Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북

Dim g_szfmTabPage

g_szfmTabPage = "page001725"

Dim g_szfmTab00List, g_szfmTab01List, g_szfmTab02List 
Dim g_bChangeMk
g_bChangeMk = False

'202304 KKM START : 폼탭(fmtab2) 추가 및 폼탭 별 구성 수정
'기본		: 호가|시세|차트|투자의견|거래원|상세|뉴스|종목토론|투자자|기업/재무|단일가|신용|CFD|섹터|설정
g_szfmTab00List = {"page001725", "page004447", "page000316", "page002976", "page000774", "page006928", "page004685", "page005730", "page008812", "page000595", "page007633", "page001059", "page003111", "page004059", "page004879" }
'KOTC		: 호가|시세|차트|상세|뉴스|종목토론|기업/재무|호가상세|종합시세|설정
g_szfmTab01List = {"page001725", "page004447", "page000316", "page006928", "page004685", "page005730", "page000595", "page007899", "page007924", "page004879" }
'ETF/ETN/ELW	: 호가|시세|차트|거래원|상세|뉴스|종목토론|투자자|단일가|신용|CFD|설정 
g_szfmTab02List = {"page001725", "page004447", "page000316", "page000774", "page006928", "page004685", "page005730", "page008812", "page007633", "page001059", "page003111", "page001699", "page004879" }
'202304 KKM END

'20220713_01 KBC START : 투자의견 탭위치 변경
'g_szfmTab00List = {"page001725", "page004447", "page005730", "page000316", "page002976", "page000774", "page006928", "page004685", "page008812", "page000595", "page007633", "page001059", "page004059", "page004879" }
'g_szfmTab01List = {"page001725", "page004447", "page005730", "page000316", "page002976", "page006928", "page004685", "page000595", "page007899", "page007924", "page004879" }
'20220713_01 KBC END

Dim g_szScreenNo '20210823 HSZ CFD현재가 화면 추가

'20240503_01 HWG START : MTS ETF 고도화 대응
Dim g_nETF_Link_Tab
g_nETF_Link_Tab = ""

Dim g_nETF_Link_SubTab
g_nETF_Link_SubTab = ""

Dim g_szTabChange
g_szTabChange = ""

'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
Dim g_PrevTab
g_PrevTab = ""
'20240613_01 HWG END
'20240503_01 HWG END
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'20240503_01 HWG START : MTS ETF 고도화 대응
Function RequestTran_021r(szData)
	DATAMANAGER.ClearInputData(0, "ohhts_metf_021r")
	
	if instr(szData, "@") > 0 then
		arrData = split(szData, "@")
		
		DATAMANAGER.SetDataValue(0, "ohhts_metf_021r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , arrData(1))
		DATAMANAGER.SetDataValue(0,  "ohhts_metf_021r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , arrData(0))
	end if
	
	DATAMANAGER.RequestTranData("ohhts_metf_021r")
End Function

Function ResponseTran_021r()				
	If g_szItemMarket = "T" Then
		fmTab00.visible = False
		fmTab02.visible = False  
		fmTab01.visible = True
		
		Form.triggerEvent("fmTab01." & fmTab01.currenttabpageid, "INIT_CODE", g_szItemCode)	' 탭화면에 종목코드 던지기
		
		'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
		fmTab01.callTabChanged()			
		g_PrevTab = "fmTab01"
		'20240613_01 HWG END
	Else
		fmTab01.visible = False
		If ((g_szItemMarket = "J") and (g_szInnerMarket = "013")) or (g_szItemMarket = "Q") or (g_szItemMarket = "W") Then
			fmTab00.visible = False 
			fmTab02.visible = True 
			
			'szMorning_YN 	 = DATAMANAGER.GetDataValue(0, "ohhts_metf_021r", "OutBlock1", "FID_APLY_YN" , 0)
			'Form.SetSharedData("IsMorningStar" , szMorning_YN)
			'if g_szScreenNo <> "13100" and szMorning_YN = "Y" then
			if g_szScreenNo <> "13100" and ((g_szItemMarket = "J") and (g_szInnerMarket = "013")) then
				
				fmTab02.showpage = "page004230"
				fmTab02.showpage = "page001699"
				if g_nETF_Link_Tab <> "" then
					
					' 연동화면 정보가 있는 경우
					if g_nETF_Link_Tab = "1" then
						'현재가 연동
					
						fmTab02.currenttabpageid = "page001725"
					elseif g_nETF_Link_Tab = "0" then
						'종목정보 연동
						fmTab02.currenttabpageid = "page004230"
					end if
					
					if g_nETF_Link_SubTab <> "" then
						Form.triggerEvent("fmTab02." & fmTab02.currenttabpageid, "ETF_SUB_TAB", g_nETF_Link_SubTab)	' 탭화면에 종목코드 던지기
					end if
				
					g_nETF_Link_SubTab = ""
					g_nETF_Link_Tab = ""
				end if
			else
				if fmTab02.currenttabpageid = "page004230" or fmTab02.currenttabpageid = "page001699" then
					fmTab02.currenttabpageid = "page001725"
				end if
				
				fmTab02.hidepage = "page004230"
				fmTab02.hidepage = "page001699"
			end if
			'Form.TriggerEvent("fmTab02." & fmTab02.currenttabpageid, "IsMorningStar", szMorning_YN )		
			Form.triggerEvent("fmTab02." & fmTab02.currenttabpageid, "INIT_CODE", g_szItemCode)	' 탭화면에 종목코드 던지기

			If fmTab02.GetTabPageCaption( fmTab02.currenttabpageid ) = "단일가" Then
				Form.triggerEvent("linkfmHoga", "HOGA_TYPE", "13") 						' 링크화면에 시장구분 던지기
			End If
			
			'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
			fmTab02.callTabChanged()
			g_PrevTab = "fmTab02"
			'20240613_01 HWG END
		Else		
			fmTab00.visible = True
			fmTab02.visible = False
		
			if g_nETF_Link_Tab <> "" then
				' 연동화면 정보가 있는 경우
				if g_nETF_Link_Tab = "1" then
					'현재가 연동
					fmTab00.currenttabpageid = "page001725"
				elseif g_nETF_Link_Tab = "0" then
					'종목정보 연동
					fmTab00.currenttabpageid = "page000595"
				end if
				
				Form.triggerEvent("fmTab00." & fmTab00.currenttabpageid, "ETF_SUB_TAB", g_nETF_Link_SubTab)	' 탭화면에 종목코드 던지기
			
				g_nETF_Link_SubTab = ""
				g_nETF_Link_Tab = ""
			end if
			
			Form.triggerEvent("fmTab00." & fmTab00.currenttabpageid, "INIT_CODE", g_szItemCode)	' 탭화면에 종목코드 던지기

			If fmTab00.GetTabPageCaption( fmTab00.currenttabpageid ) = "단일가" Then
				Form.triggerEvent("linkfmHoga", "HOGA_TYPE", "13") 						' 링크화면에 시장구분 던지기
			End If	
			
			'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
			fmTab00.callTabChanged()
			g_PrevTab = "fmTab00"
			'20240613_01 HWG END
		End If		
	End If
End Function

Function Change_Tab()
	If ((g_szItemMarket = "J") and (g_szInnerMarket = "013")) or (g_szItemMarket = "Q") or (g_szItemMarket = "W") Then
		if g_szScreenNo <> "13100" and ((g_szItemMarket = "J") and (g_szInnerMarket = "013")) then
			fmTab02.showpage = "page004230"
			fmTab02.showpage = "page001699"
		else
			
			fmTab02.hidepage = "page004230"
			fmTab02.hidepage = "page001699"
			Form.SetTimerEvent2(1,1,0.5)
		end if
	End If
End Function
'20240503_01 HWG END

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
' 설    명 : Form 호출시 최초실행
' 파람미터 : N/A
' 리 턴 값 : N/A
'============================================================================
Sub Form_OnFormInit()
	
	Dim szData, arrData, szStyle
	
	g_bPopupFg = false
	
	szStyle	= Form.LoadConfigData("mhprc11000", "Style"	)	'현재가 스타일
	
	'20210823 HSZ START : CFD현재가 화면 추가 (현재가 스타일2로 고정)
	if g_szScreenNo = "13100" then
		szStyle = "1"
	end if
	'20210823 HSZ END
	
	'202304 KKM START : 현재가 개선건 - 스타일 하나로 고정
'	If szStyle = "0" Then
'		'20211021 아이티젠(김성수) 현재가 개선
'		linkfmHoga.linkfile = "mhprc11000_s4" 
'	ElseIf szStyle = "1" Then
'		linkfmHoga.linkfile = "mhprc11000_s5" 
'	ElseIf szStyle = "2" Then
'		linkfmHoga.linkfile = "mhprc11000_s6" 
'	Else
'		linkfmHoga.linkfile = "mhprc11000_s4" 
'		
'	End If	
	linkfmHoga.linkfile = "mhprc11000_s7" 	
	'202304 KKM END
	
	'폼탭 위치 저장 주석처리
'	g_nfmTab = CInt( Form.LoadConfigData( "mhprc11000", "frmTab" ) )
'	fmTab00.currenttab = g_nfmTab
	
	'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
	szSelTabPage0 =  Form.getEnvData("11000_SELECT_TABPAGE_0_ID")

	if szSelTabPage0 = "" then
		fmTab00.currenttabpageid = "page001725"
		fmTab01.currenttabpageid = "page001725"
		fmTab02.currenttabpageid = "page001725"
	end if
	'20240613_01 HWG END

	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"★")
	
	if Trim(arrData(0)) <> "" then
		nCodelen = Form.getLen(arrData(0))
		If Left(arrData(0), 1) = "A" Then
			g_szItemCode = Right(arrData(0), Len(arrData(0)) - 1)
		Elseif Left(arrData(0), 1) = "J" and nCodelen = 7 Then	'ELW - J포함 7자리 20230714 HSZ
			g_szItemCode = Right(arrData(0), Len(arrData(0)) - 1)
		Else
			g_szItemCode = arrData(0)			
		End If	
		
		'20240503_01 HWG START : MTS ETF 고도화 대응
		szChk = Form.GetItemCodeInfo(g_szItemCode, "name")
		if szChk = "" then
			'Form.ShowAlert("안내", "현재가를 제공하지 않는 종목입니다. 종목을 확인해주세요")
			'20210823 HSZ START : CFD현재가 화면 추가
			if g_szScreenNo = "13100" then
				g_szItemCode = Form.GetSharedData("&ITEM_STOCK_CFD", 0)		' CFD 최근조회종목
			'20210823 HSZ END
			else
				g_szItemCode = Form.GetSharedData("&ITEM_STOCK", 0)		' 최근조회종목
			end if
		end if
		'20240503_01 HWG END
		
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")	'20180712 HAMWG : K-OTC MTS 도입
		g_szInnerMarket = Form.GetItemCodeInfo( g_szItemCode , "innermarket")	'20240119 SWJ	: 타 화면에서 ETF일 때 정상 동작 안하는 오류 수정
		
		' 타화면에서 호출되는 탭으로 이동
		If #arrData > 1 Then
		
			'20180712 HAMWG START : K-OTC MTS 도입
			If g_szItemMarket = "T" then
'				If arrData(1) = "투자의견" Or arrData(1) = "10"  then
'					fmTab01.currenttabpageid = "page002976"
'				ElseIf arrData(1) = "신용" Or arrData(1) = "9" then
'					fmTab01.currenttabpageid = "page001059"
'					Form.triggerEvent("fmTab01." & fmTab01.currenttabpageid, "SELECT_Rdo", arrData(2))	' 융자, 공매도
'				ElseIf arrData(1) = "투자자" Or arrData(1) = "7" then
'					fmTab01.currenttabpageid = "page008812"
				If arrData(1) = "뉴스" Or arrData(1) = "6" then
					fmTab01.currenttabpageid = "page004685"
					Form.SetEnvData(1, "11000_SELECT_TABPAGE_0_ID" , "page004685")	'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
				ElseIf arrData(1) = "호가" Or arrData(1) = "0"  then
					fmTab01.currenttabpageid = "page001725"
					Form.SetEnvData(1, "11000_SELECT_TABPAGE_0_ID" , "page001725")	'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
				'20240430 SWJ START
				ElseIf arrData(1) = "차트" Or arrData(1) = "2"  then
					fmTab01.currenttabpageid = "page000316"
					Form.SetEnvData(1, "11000_SELECT_TABPAGE_0_ID" , "page000316")	'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
				'20240430 SWJ END
				
				Else
					If arrData(1) <> "" then
						fmTab01.currenttab = arrData(1)
					End If
				End If
			Else
				'20240503_01 HWG START : MTS ETF 고도화 대응
				if arrData(1) = "ETF" or arrData(1) = "INCOME" then
					
					g_nETF_Link_Tab = ""
					g_nETF_Link_SubTab = ""
					
					if #arrData > 2 then
						g_nETF_Link_Tab = arrData(2)
						
						if #arrData > 3 then
							g_nETF_Link_SubTab = arrData(3) 
						end if
					end if
				else
					'20230425 KKM ETF/ETN/ELW
					If ((g_szItemMarket = "J") and (g_szInnerMarket = "013")) or (g_szItemMarket = "Q") or (g_szItemMarket = "W") Then
	'					If arrData(1) = "투자의견" Or arrData(1) = "10"  then
	'						fmTab02.currenttabpageid = "page002976"
						If arrData(1) = "신용" Or arrData(1) = "9" then
							fmTab02.currenttabpageid = "page001059"
							Form.SetEnvData(1, "11000_SELECT_TABPAGE_0_ID" , "page001059")	'20240613_01 HWG START : 탭순서변경 및 연동기능 개선
							Form.triggerEvent("fmTab02." & fmTab02.currenttabpageid, "SELECT_Rdo", arrData(2))	' 융자, 공매도
