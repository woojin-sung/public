'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	if nIndex == 0 then		'일
		g_flagMin = false
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "D"
		
		PeriodSet(g_szChrtType)
		
	elseif nIndex == 1 then	'주/월/년
		g_flagMin = false
		g_flagTic = false
		
		if g_flagWeek == false then
			sTemp = RadioGroup0.GetRadioCaption(1)
			if sTemp == "월" then
				g_szChrtType = "M"
				
			elseif sTemp == "년" then
				g_szChrtType = "Y"
				
			else
				g_szChrtType = "W"
				
			end if
			
			g_flagWeek = true
			PeriodSet(g_szChrtType)
			
		else
			sTemp = RadioGroup0.GetRadioCaption(1)
			Form.OpenPopup( "mhcht13000_p4.xmf", sTemp, "" )	
			
		end if

	elseif nIndex == 2 then   	'분
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "A"
		
		if g_flagMin == false then
			g_flagMin = true
			tmpMin = split(RadioGroup0.GetRadioCaption(2), "분")
			g_szMinType = tmpMin[0]
			
			PeriodSet(g_szChrtType)
			
		else
			If g_flagMinTic = true Then
				PeriodSet(g_szChrtType)
			Else
				Form.OpenPopup( "mhtro16020_p1.xmf", g_szMinType, "" )
				exit Sub
			End If
			
		end if
		
	elseif nIndex == 3 then   	'틱
		g_flagMin = false
		g_flagWeek = false
		g_szChrtType = "T"
		
		if g_flagTic == false then
			g_flagTic = true
			tmpTic = split(RadioGroup0.GetRadioCaption(3), "틱")
			g_szTicType = tmpTic[0]
			
			PeriodSet(g_szChrtType)
			
		else
			If g_flagMinTic = true Then
				PeriodSet(g_szChrtType)
			Else
				Form.OpenPopup( "mhtro16020_p2.xmf", g_szTicType, "" )
			End If
		end if
	end if
	
	Form.SetEnvData(1, "mhtro16020_RADIO", RadioGroup0.currentindex)
	
	'20240610 SWJ START
	'처음 오픈했을 때 방지 및
	'클릭했을 때는 인덱스가 달라졌을 때만
	if g_sInitFlag = False then
		if gRadioIndex <> nIndex then
			ChartEx0.setTradeData("")
			Form.SetTimerEvent2(1, 1, 0.2)
		end if
	end if
	
	
	gRadioIndex = nIndex
	'20240610 SWJ END
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "Chart_Min" then
		g_szMinType = sRet		
		RadioGroup0.SetRadioCaption( 2, g_szMinType )
		tmpMin = split(RadioGroup0.GetRadioCaption(2), "분")
		g_szMinType = tmpMin[0]
		
		PeriodSet(g_szChrtType)
		
		'20240610 SWJ START
		'콤보 인덱스가 달라졌을 때만
		if gCmbIndex <> g_szMinType then 
			'Chart_UseWhatLine()
			ChartEx0.setTradeData("")
			Form.SetTimerEvent2("2", 1, 0.2)
		end if	
		
		gCmbIndex = g_szMinType
		'20240610 SWJ END
		
	elseif sKeyName == "Chart_Tic" then
		g_szTicType = sRet	
		RadioGroup0.SetRadioCaption( 3, g_szTicType )
		tmpTic = split(RadioGroup0.GetRadioCaption(3), "틱")
		g_szTicType = tmpTic[0]
		
		PeriodSet(g_szChrtType)
		
	elseif sKeyName == "Chart_WEEK" then
		if sRet == "월" then
			g_szChrtType = "M"
		elseif sRet == "년" then
			g_szChrtType = "Y"
		else
			g_szChrtType = "W"
		end if
		
		RadioGroup0.SetRadioCaption( 1, sRet )
		
		PeriodSet(g_szChrtType)
		
	elseif sKeyName == "LAND_CHART_TYPE" then	' 가로 화면에서 타입 변경
		ChartEx0.SetLoadChart("reload")
		
		sData = split(sRet,"^")
		g_szItemCode = sData[0]
		
		sTypeData = split(sData[1],"`")
		g_szChrtType = sTypeData[0]
		
		if g_szChrtType == "A" then
			g_szMinType = sTypeData[1]
			
		elseif g_szChrtType == "T" then
			g_szTicType = sTypeData[1]
			
		else
			g_szMinType = 1
			g_szTicType = 1
			
		end if
		
		setChart()
		PeriodSet(g_szChrtType)
		
		szName = Form.GetItemCodeInfo(g_szItemCode, "name")
		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", g_szItemCode.."★"..szName.."★".."", "" )
	
	'20231016 LES START
	elseif sKeyName = "AvgBuyPrice_Accnt_Select" then
		Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "USE", "1")		'20240610 SWJ : 다른 ID일 때 고려
		Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "ACNT", sRet)		'20240610 SWJ : 다른 ID일 때 고려
		Apply_Use_AvgBuyPrice()
	'20231016 LES END
	
	'20240610 SWJ START
	elseif sKeyName = "OrderList_Accnt_Select" then
		
'		Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK", "USE", "1")
'		Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK", "ACNT", sRet)
'		Apply_Use_AvgBuyPrice()

		szData = Split(sRet, "★")
		
		if Ubound(szData) > 0 then
			
			g_sUserID = Form.GetSharedData("&USER_ID", false)

			Form.SaveConfigData("CHART_USE_LINE_OVERSTOCK".."_"..g_sUserID, "USE", szData(1))
			
			'매수평균단가
			if szData(1) == "AvgBuyPrice" then
				
				Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "USE", "1")
				Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "ACNT", szData(0))
				Apply_Use_AvgBuyPrice()
		
			'매매내역
			elseif szData(1) == "OrderList" then
				
				Form.SaveConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "USE", "1")
				Form.SaveConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "ACNT", szData(0))
				Apply_Use_OrderList()
			
			'둘 다
			elseif szData(1) == "Both" then
				
				Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "USE", "1")
				Form.SaveConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "USE", "1")
				
				Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "ACNT", szData(0))
				Form.SaveConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "ACNT", szData(0))
				
				Apply_Use_OrderList()
				Apply_Use_AvgBuyPrice()
			'20240619
			
			end if
			
		end if
	'20240610 SWJ END
	
	'--------------------------------
	'20240710 HSZ START - 해외/국내 종목선택창 통합
	'--------------------------------
	elseif sKeyName == "DLG_SELECT" then
		
		'--------------------------------
		'sRet = OQ@AAPL★애플★OVRS
		'--------------------------------		
		Dim arrRetData, sItemCd, sItemName
		arrRetData = Split(sRet,"★")
		
		if #arrRetData > 2 then
			sItemCd = arrRetData(0)
			
			if CheckMasterFile(sItemCd) then
				sItemName = Form.GetItemCodeInfo(sItemCd, "name")
				Form.setOverStockItemCode(sItemCd.."★"..sItemName)
				ItemCode0.code = sItemCd.."★"..sItemName
				
				if g_bApplyVersion then
					if g_bApplyVersion then
							
						Form.SetTimerEvent2("2", 1, 0.2)
					else
						Apply_Use_AvgBuyPrice()
					end if
				end if
			end if
			
		End if
		
	elseif sKeyName = "mhprc11000_save" then '관심등록 완료 후
		RequestTranData_Intr()			' 관심그룹 갯수 조회	(관심그룹추가 팝업리턴도 같은 keyname으로 내려옴)
		Form.requestIntrItemList("00")	' 관심종목 목록 조회
		
	'--------------------------------
	'20240710 HSZ END
	'--------------------------------
	end if
End Sub

'20240710 HSZ START - 해외/국내 종목선택창 통합
'============================================================================
' 마스터파일에 있는 종목인지 체크
'============================================================================
Function CheckMasterFile(szCode)
	
	arrCode = Split(szCode,"@")
	szTransExidCode = Transform_Exid(arrCode(0))
	
	szTransItemCode = szTransExidCode .. "@" .. arrCode(1)

	szCheckData = Form.GetItemCodeInfo(szTransItemCode, "exchid")
	
	if szCheckData = "" or szCheckData = null then
		CheckMasterFile = false
		Exit Function
	end if
	
	CheckMasterFile = true
	
End Function

'============================================================================
Function Transform_Exid(szExid)

	if szExid = "HKS" then
		Transform_Exid = "HK"
		exit Function
	elseif szExid = "SHS" then
		Transform_Exid = "SH"
		exit Function
	elseif szExid = "SZS" then
		Transform_Exid = "SZ"
		exit Function
	elseif szExid = "NYS" then
		Transform_Exid = "NY"
		exit Function
	elseif szExid = "AMX" then
		Transform_Exid = "AX"
		exit Function
	elseif szExid = "NAS" then
		Transform_Exid = "OQ"
		exit Function
	elseif szExid = "TSE" then
		Transform_Exid = "JP"
		exit Function
	else
		Transform_Exid = szExid
	end if

End Function

'============================================================================
Function RequestTranData_Intr()
	DATAMANAGER.ClearInputData(0, "ohhts_intr_006r")
	DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))
	DATAMANAGER.RequestTranData("ohhts_intr_006r")
End Function

'============================================================================
Function ResponseTranData_Intr()
	g_szIntrGrpCnt = DATAMANAGER.GetDataCount(0, "ohhts_intr_006r" , "OutBlock1")
End Function

