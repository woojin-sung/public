'============================================================================
' 20231016 LES START
'============================================================================
Function Change_ItemCode()
	
	Dim sCodeData
	
	if g_szItemCode <> "" and g_szItemCode <> null then
	
		sCodeData = Split( g_szItemCode, "@" )
	
		if #sCodeData > 1 then
	
			szExid = sCodeData[0] '시장구분
			szCode = sCodeData[1] '종목코드 
'			
			'20240619_4
			if szExid == "JP" then
				g_sCurrency = "JPY"
				g_sMarketCode = "05"
			elseif szExid == "SH" then
				g_sCurrency = "CNY"
				g_sMarketCode = "03"
			elseif szExid == "SZ" then
				g_sCurrency = "CNY"
				g_sMarketCode = "04"
			elseif szExid == "AX" or szExid == "NY" or szExid == "OQ" then
				g_sCurrency = "USD"
				g_sMarketCode = "01"
			elseif szExid == "HK" then
				g_sCurrency = "HKD"
				g_sMarketCode = "02"
			end if
			'20240619_4
			
			return szCode.."."..szExid
		
		end if
		
	end if

	
End Function
'============================================================================
' 20240610 SWJ START
'============================================================================
Function Chart_UseWhatLine()
	sLineSetting = Form.LoadConfigData( "CHART_USE_LINE_OVERSTOCK".."_"..g_sUserID,"USE")
	
	g_sUserID = Form.GetSharedData("&USER_ID", false)		'20240624 SWJ START
	
	if sLineSetting == "AvgBuyPrice" then
		Apply_Use_AvgBuyPrice()
	elseif sLineSetting == "OrderList" then
		Apply_Use_OrderList()
	
	elseif sLineSetting == "Both" then
		Apply_Use_OrderList()
		Apply_Use_AvgBuyPrice()
	
	end if
	
	'화면 첫 오픈 여부 판단
	g_sInitFlag = False
End Function
'============================================================================
Function LoginCheck_PopupSetting()
	
	'로그인 여부 체크
	Dim sLOGIN_TYPE  
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
			
	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
	else
		Form.OpenScreen("90020" , "90022")
		Exit Function
	end if
	
	Form.OpenPopupAnimation(g_sChartPopup, "100,119,200" , "", "2") '20240619_3

End Function

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	Form.SetTimerEvent2(sTimerID, 0, 0.2)
	
	if Cint(sTimerID) == 1 then
		sLineSetting = Form.LoadConfigData( "CHART_USE_LINE_OVERSTOCK".."_"..g_sUserID,"USE")
	
		if sLineSetting == "OrderList" then
			Apply_Use_OrderList()
		
		elseif sLineSetting == "Both" then
			Apply_Use_OrderList()
		
		end if
	elseif Cint(sTimerID) == 2 then
		Chart_UseWhatLine()
		
	elseif Cint(sTimerID) == 3 then
		ChartEx0.setTradeData("")
	
	'20240710 SWJ START
	elseif Cint(sTimerID) == 4 then
		SetTradeData()
	'20240710 SWJ END
	
	end if
End Sub
'============================================================================
Function SetPriceMask(nPrice)
	
	LblInvisible.caption = nPrice
	
	if g_sCurrency == "JPY" then
		LblInvisible.mask = "0,0,,"..""..""..",1,1,1,1,0,0,0"
	elseif g_sCurrency == "CNY" then
		LblInvisible.mask = "0,0,,"..""..""..",1,1,3,1,0,0,0"
	elseif g_sCurrency == "USD" then
		LblInvisible.mask = "0,0,,"..""..""..",1,1,4,1,0,0,0"
	elseif g_sCurrency == "HKD" then
		LblInvisible.mask = "0,0,,"..""..""..",1,1,3,1,0,0,0"
	end if
	
	nMaskedPrice = LblInvisible.dispcaption
	
	return nMaskedPrice
End Function


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtro_cntg_611r" then
		ChartEx0.setTradeData("")
	end if
End Sub
