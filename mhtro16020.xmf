		DATAMANAGER.SetDataValue( false, "ohhts_5041_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
		
		DATAMANAGER.SetDataValue( false, "ohhts_5041_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, "ohhts_5041_001r", "InBlock2", "FID_INPUT_OVRS_ISCD" , 0 , g_szCode )
		DATAMANAGER.SetDataValue( false, "ohhts_5041_001r", "InBlock2", "FID_COND_MRKT_CLS_CODE" , 0 , g_szExid)
