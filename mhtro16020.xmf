Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_5041_001r" or szTranID == "ohhts_5041_002r" or szTranID == "ohhts_5041_003r" or szTranID == "ohhts_5041_004r" or szTranID == "ohhts_5041_005r" or szTranID == "ohhts_5041_006r" then
		Dim sCodeData
		sCodeData = Split( g_szItemCode, "@" )
		g_szExid = sCodeData[0] '시장구분
		g_szCode = sCodeData[1] '종목코드 
		g_rtChk = Form.GetSharedData( "REALTIME_"..g_szExid, false )
	end if
	
	if szTranID == "ohhts_5041_001r" then
		DATAMANAGER.SetDataValue( false, "ohhts_5041_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, "ohhts_5041_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , g_szCode )
