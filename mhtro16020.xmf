'[화면오픈 시]
'-----------------------------------------------------------------------
'1. Check_Version()   : 앱실행 시, 적용가능 버전인지 체크
'2. Apply_Use_AvgBuyPrice() : 매수평균가 사용여부 확인 후 차트에 적용
'
'
'-----------------------------------------------------------------------
'[화면오픈 후 설정변경 시]
'-----------------------------------------------------------------------
'
'(기존에 사용상태인 경우)
'1. Change_Use_AvgBuyPrice() : 매수평균가 미사용으로 변경
'2. Apply_Use_AvgBuyPrice()  : 매수평균가 사용여부 확인 후 차트에 적용

'(기존에 미사용 상태인 경우)
'1. AvgBuyPrice_Accnt_Select : 팝업리턴 후, 사용가능여부/사용계좌 데이터 설정
'2. Apply_Use_AvgBuyPrice()  : 매수평균가 사용여부 확인 후 차트에 적용


'============================================================================
Function Check_Version()

	szOsType = Form.GetSharedData("&OS_TYPE", False) 
	szAppVer	= Form.GetSharedData("&APP_VERSION", False)
	szAppVer	= Replace(szAppVer, ".", "")
	
	'1.안드로이드 2.iOS
	if szOsType == "1" then
		
		'20240610 SWJ START: 이전 버전은 매수평균단가만
		
		'-----------------------------------------------------------------------
		'추세선 숨김처리
		'-----------------------------------------------------------------------
		BtnLine.visible = false 
			
		'-----------------------------------------------------------------------
		'Image5 : 매매평균가 스위치 이미지
		'-----------------------------------------------------------------------
		Image5.visible = true
		Image5.left = 197
		Image5.setMaintainingRatio("1")
			
		'-----------------------------------------------------------------------
		'Label0 : 매수평균 텍스트라벨
		'Image3 : 버튼배경이미지 뷰
		'Image4 : 클릭이벤트 처리 이미지 뷰
		'-----------------------------------------------------------------------
		Label0.visible = true
		Image3.visible = true
		Image3.imgpath = "btn_line_o.9"
		Image4.visible = true
		Image4.bringFront("1")
		
		if Cint(szAppVer) > 246 then
			'-----------------------------------------------------------------------
			' 적용가능 버전
			'-----------------------------------------------------------------------
			g_bApplyVersion = true
		
			Label0.caption = "매매내역"
			g_sChartPopup = "mhcht13000_p6"
			Form.SetTimerEvent2("2", 1, 0.2)
		else
			Label0.caption = "매수평균"
			g_sChartPopup = "mhcht13000_p5"
			Apply_Use_AvgBuyPrice()
		end if
		'20240610 SWJ END
		
		'추후 237으로 수정필요
'		if Cint(szAppVer) > 237 then
'			
'			'-----------------------------------------------------------------------
'			' 적용가능 버전
'			'-----------------------------------------------------------------------
'			g_bApplyVersion = true
'		
'			'-----------------------------------------------------------------------
'			'추세선 숨김처리
'			'-----------------------------------------------------------------------
'			BtnLine.visible = false 
'			
'			'-----------------------------------------------------------------------
'			'Image5 : 매매평균가 스위치 이미지
'			'-----------------------------------------------------------------------
'			Image5.visible = true
'			Image5.setMaintainingRatio("1")
'			
'			'-----------------------------------------------------------------------
'			'Label0 : 매수평균 텍스트라벨
'			'Image3 : 버튼배경이미지 뷰
'			'Image4 : 클릭이벤트 처리 이미지 뷰
'			'-----------------------------------------------------------------------
'			Label0.visible = true
'			Image3.visible = true
'			Image3.imgpath = "btn_line_o.9"
'			Image4.visible = true
'			Image4.bringFront("1")
'			
'			'20240610 SWJ START
'			'Apply_Use_AvgBuyPrice()
'			'Chart_UseWhatLine()
