'============================================================================
Function Change_Use_AvgBuyPrice()

	gUseAvgBuyPrice = Form.LoadConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "USE")

	if gUseAvgBuyPrice == "1" then
		
		gUseAvgBuyPrice = "0"
		Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "USE", "0")
		
	
	else
	
		gUseAvgBuyPrice = "1"
		Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "USE", "1")
		Image5.imgpath = "btn_switch_o"
	
	end if
	
	Apply_Use_AvgBuyPrice()

End Function
'============================================================================
'20231016 LES END
'============================================================================

'============================================================================
'20231016 LES START
'============================================================================
Function Apply_Use_AvgBuyPrice()

	'로그인 여부 체크
	Dim sLOGIN_TYPE  
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
	
	g_sUserID = Form.GetSharedData("&USER_ID", false)		'20240610 SWJ START
	
	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
	else
		Image5.imgpath = "btn_switch_n"
		ChartEx0.SetAvgBuyPrice(""..";".."0")
		Exit Function
	end if

	gUseAvgBuyPrice = Form.LoadConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "USE")	'20240610 SWJ START
	
	if gUseAvgBuyPrice == "1" then
		
		Image5.imgpath = "btn_switch_o"
		sSettingAcnt = Form.LoadConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "ACNT")	'20240610 SWJ START
		
		if sSettingAcnt <> "" then
		
			szAcno = Left(sSettingAcnt,8)
			szAsno = Right(sSettingAcnt,2)
			szItemCode = Change_ItemCode()
			
			DATAMANAGER.SetDataValue(0, "obtrs_comn_430r", "InBlock1", "ACNO" , 0 , szAcno)
			DATAMANAGER.SetDataValue(0, "obtrs_comn_430r", "InBlock1", "ASNO" , 0 , szAsno)
			DATAMANAGER.SetDataValue(0, "obtrs_comn_430r", "InBlock1", "ISCD" , 0 , szItemCode)
			DATAMANAGER.RequestTranData("obtrs_comn_430r")
		
		end if
		
	else
		
		'초기화
		Image5.imgpath = "btn_switch_n"
		
		if g_szItemCode <> "" and g_szItemCode <> null then
			ChartEx0.SetAvgBuyPrice(""..";".."0")
		end if
		
		
	end if
	
End Function
'============================================================================
'20231016 LES END
'============================================================================

'============================================================================
'20240610 SWJ START
'============================================================================
Function Change_Use_OrderList()

	gUseOrderList = Form.LoadConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "USE")

	if gUseOrderList == "1" then
		
		gUseOrderList = "0"
		Form.SaveConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "USE", "0")
		
	
	else
	
		gUseOrderList = "1"
		Form.SaveConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "USE", "1")
		Image5.imgpath = "btn_switch_o"
	
	end if
	
	Apply_Use_OrderList()

End Function
'============================================================================
Function Apply_Use_OrderList()
	
	'로그인 여부 체크
	Dim sLOGIN_TYPE  
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
	
	g_sUserID = Form.GetSharedData("&USER_ID", false)		'20240624 SWJ START
	
	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
	else
		Image5.imgpath = "btn_switch_n"
		ChartEx0.SetTradeData("")
		Exit Function
	end if

	gUseOrderList = Form.LoadConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "USE")
	
	if gUseOrderList == "1" then
		
		Image5.imgpath = "btn_switch_o"
		sSettingAcnt = Form.LoadConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "ACNT")
		
		if sSettingAcnt <> "" then
		
			szAcno = Left(sSettingAcnt,8)
			szAsno = Right(sSettingAcnt,2)
			szItemCode = Change_ItemCode()
			
			if Cint(RadioGroup0.currentindex) == 0 then
				gChartPeriod = "D"
				
			elseif Cint(RadioGroup0.currentindex) == 2 then
				
				szTempMin = split(RadioGroup0.GetRadioCaption(2), "분")
				
				if Ubound(szTempMin) > 0 then
					if szTempMin(0) == "1" then
						gChartPeriod = "1"
					elseif szTempMin(0) == "3" then
						gChartPeriod = "3"
					elseif szTempMin(0) == "5" then
						gChartPeriod = "5"
					elseif szTempMin(0) == "10" then
						gChartPeriod = "T"
					else
						exit Function
					end if
				end if
			
			else
				exit function
			end if
			
			szItemCode = Change_ItemCode()
			
			DATAMANAGER.SetDataValue(0, "obtro_cntg_611r", "InBlock1", "IQRY_COND_CODE" , 0 , gChartPeriod)
			DATAMANAGER.SetDataValue(0, "obtro_cntg_611r", "InBlock1", "ACNO" , 0 , szAcno)
			DATAMANAGER.SetDataValue(0, "obtro_cntg_611r", "InBlock1", "ASNO" , 0 , szAsno)
			DATAMANAGER.SetDataValue(0, "obtro_cntg_611r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , g_sMarketCode)	'20240619_4
			DATAMANAGER.SetDataValue(0, "obtro_cntg_611r", "InBlock1", "ISCD" , 0 , szItemCode)
			DATAMANAGER.RequestTranData("obtro_cntg_611r")
		
		end if
		
	else
		
		'초기화
		Image5.imgpath = "btn_switch_n"
		ChartEx0.SetTradeData("")
		
	end if
End Function
'============================================================================
'20240610 SWJ END
