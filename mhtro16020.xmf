'20240710 HSZ END

'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================
function ChartEx0_OnGetPeriodInfo()
	Dim sPeriodType
	Dim sMin, sTic
	sPeriodType = ""
	
   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	for i = 0 to 8
		sMin = Form.GetEnvData( "mhtro16020_chart_min"..i )	'분차트
		if sMin <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sMin&"/"
			else
				sPeriodType = sPeriodType&sMin&";"
			end if
		end if
	next
	
	for i = 0 to 8
		sTic = Form.GetEnvData( "mhtro16020_chart_tic"..i )	'분차트
		if sTic <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sTic&"/"
			else
				sPeriodType = sPeriodType&sTic&";"
			end if
		end if
	next

	if sPeriodType <> "" then
		ChartEx0.setSyncPeriodValueToChart(sPeriodType)
	end if
end function
'============================================================================
function ChartEx0_OnChangePeriod(sPeriodType)
	sMinArr = {}
	sTicArr = {}
	sDataArr = {}
	
	g_sIsRequestChartEvent = "1"

   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	if InStr(sPeriodType, "/") > 0 then
		sTemp = split(sPeriodType, "/")
		sMinArr = split(sTemp[0], ";")
		sTicArr = split(sTemp[1], ";")
		Form.Log("sPeriodType", sPeriodType)
	   
		for i = 0 to 7 step 1
			Form.SetEnvData( 1, "mhtro16020_chart_min"..i, sMinArr[i] )
			Form.SetEnvData( 1, "mhtro16020_chart_tic"..i, sTicArr[i] )
		next
	end if
end function

'============================================================================
' 차트 설정 개수 변경시
'============================================================================
function ChartEx0_OnByNumber(Count)
	if #Count == 1 then
		Count = "000"..Count
	   
	elseif #Count == 2 then
		Count = "00"..Count
	   
	elseif #Count == 3 then
		Count = "0"..Count
	   
	end if

	g_sChartCnt = Count
	RequestData()
end function

'============================================================================
' 분,틱 설정파일 저장
'============================================================================
function Save_ini()
	dim sMin, sTic, sflag
	
	for i = 0 to 6
		Form.SetEnvData( 1, "mhtro16020_chart_mflag"..i, g_chartMinFlagArr[i] )
		Form.SetEnvData( 1, "mhtro16020_chart_min"..i, g_chartMinArr[i] )
		Form.SetEnvData( 1, "mhtro16020_chart_tflag"..i, g_chartTicFlagArr[i] )
		Form.SetEnvData( 1, "mhtro16020_chart_tic"..i, g_chartTicArr[i] )
	next

'	Form.SetEnvData( 1, "chart_Count", g_sChartCnt )			' 데이터갯수...필요 없음 삭제 해도 됩니다.

end function

'============================================================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'============================================================================
function PeriodSet(sPeriodType)
	if sPeriodType = "T" then
	   g_sPeriod = g_szTicType
	   g_sPeriodType = "0"
	   
	elseif sPeriodType = "A" then
	   g_sPeriod = CInt(g_szMinType) 
	   g_sPeriodType = "1"
	   
	elseif sPeriodType = "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod = "1"
	   
	elseif sPeriodType = "W" then 
	   g_sPeriodType = "3"
	   g_sPeriod = "1"
	    
	elseif sPeriodType = "M" then 
	   g_sPeriodType = "4"
	   g_sPeriod = "1"
	   
	elseif sPeriodType = "Y" then 		'PENTA13 START => 2019.03.04
	   g_sPeriodType = "5"
	   g_sPeriod = "1"

	end if

	sPeriod = CInt( g_sPeriod )
	
	if Len( sPeriod ) = 1 then
		g_sPeriod = "00"..g_sPeriod
	   
	elseif Len( sPeriod ) = 2 then
		g_sPeriod = "0"..g_sPeriod
	   
	end if
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)

	' 조회TR 보내기
	RequestData()	
end function
'============================================================================
'20230905 한국금융IT START : 일주월분 차트 주기 설정
function PeriodSetChart(sPeriodType)
	if sPeriodType = "T" then
	   g_sPeriod = g_szTicType
	   g_sPeriodType = "0"
	   
	elseif sPeriodType = "A" then
	   g_sPeriod = CInt(g_szMinType) 
	   g_sPeriodType = "1"
	   
	elseif sPeriodType = "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod = "1"
	   
	elseif sPeriodType = "W" then 
	   g_sPeriodType = "3"
	   g_sPeriod = "1"
	    
	elseif sPeriodType = "M" then 
	   g_sPeriodType = "4"
	   g_sPeriod = "1"
	   
	elseif sPeriodType = "Y" then
	   g_sPeriodType = "5"
	   g_sPeriod = "1"

	end if

	sPeriod = CInt( g_sPeriod )
	
	if Len( sPeriod ) = 1 then
		g_sPeriod = "00"..g_sPeriod
	   
	elseif Len( sPeriod ) = 2 then
		g_sPeriod = "0"..g_sPeriod
	   
	end if
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
end function
'20230905 한국금융IT END : 일주월분 차트 주기 설정
'============================================================================
'차트 불러오기
'============================================================================
function ChartEx0_OnRequestData(nIndex, sData)
	if sData = "" or sData = null then
		exit function
	end if
	
	Data = split(sData, ";")

   '현재가내의 차트에서는 종목코드를 변경하지 않는다.
	g_szItemCode	= Cstr(Trim(Data[0]))             '코드
	g_sPeriodType	= Cstr(Trim(Data[1]))             '일주월년분틱
	g_sPeriod	= Cstr(Trim(Data[2]))             '주기(1,5,...)
	sRefresh		= Cstr(Trim(Data[3]))
	radioIndex	= ""
	
	if sRefresh = 1 or sRefresh = "1" or sRefresh = true then
		g_sPeriodType = "2"
		g_sPeriod = "1"
		radioIndex = 0
		g_szChrtType = "D"
		
		sTic = Form.GetEnvData( "mhtro16020_chart_tic0" )
		sMin = Form.GetEnvData( "mhtro16020_chart_min0" )

		if sTic = "" then
			sTic = "1"
		end if
		
		if sMin = "" then
			sMin = "1"
		end if
		
		RadioGroup0.SetRadioCaption( 3, sTic.."틱" )
		RadioGroup0.SetRadioCaption( 2, sMin.."분" )
		
	else
		'PENTA13 START => 2023.07.04(차트성능개선)
		Select case g_sPeriodType
			case "0"
				g_szChrtType = "T"
				radioIndex = 3
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."틱" )
				g_szTicType = g_sPeriod
				
			case "1"
				g_szChrtType = "A"
				radioIndex = 2
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."분" )
				g_szMinType = g_sPeriod	'PENTA13 START => 2023.08.08(차트성능개선)
				
			case "2"
				g_szChrtType = "D"
				radioIndex = 0
			
			case "3"
				g_szChrtType = "W"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "주" )
			
			case "4"
				g_szChrtType = "M"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "월" )

			case "5"					'PENTA13 START => 2019.03.04
				g_szChrtType = "Y"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "년" )

		end Select
		'PENTA13 END
	end if
	
'PENTA13 START => 2023.07.31(차트성능개선)
	if ChartEx0.GetDivideNum() == 1 then
		RadioGroup0.currentindex = radioIndex
	else
		RadioGroup0.setCurIndexSilent(radioIndex)
	end if
	
	Dim sDwmm
	sDwmm = ChartEx0.GetStateDWMM()
	if sDwmm == "0" then
		RadioGroup0.enable = 1
	end if
'PENTA13 END
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)

	Dim szName
	szName = Form.GetItemCodeInfo(g_szItemCode, "name")
	Form.setOverStockItemCode(g_szItemCode.."★"..szName)
	RequestData()
end function

'============================================================================
'PENTA13 START => 2023.07.25(차트성능개선)
function ChartEx0_OnSelectedChart(nIndex, sData)
	if sData == "" then
		Exit function
	end if

	if nIndex < 1 then
		Exit function
	end if

	Data = split(sData, ";")
	
	g_sPeriodType   = Cstr(Trim(Data[2]))
	g_sPeriod       = Cstr(Trim(Data[3]))
	
	if g_sPeriodType == "0" or g_sPeriodType == "1" then
		if g_sPeriodType == "0" then		'틱
			g_TempIndex = 3
			g_szChrtType = "T"
			g_szTicType = g_sPeriod
			
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			
		else								'분
			g_TempIndex = 2
			g_szChrtType = "A"
			g_szMinType = g_sPeriod
			
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
			
		end if
	
	else
		g_sPeriod = "1"
		
		if g_sPeriodType == "2" then		'일
			g_TempIndex = 0
			g_szChrtType = "D"			'PENTA13 START => 2023.08.08(차트성능개선)
			
		elseif g_sPeriodType == "3" then	'주
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			RadioGroup0.SetRadioCaption( g_TempIndex, "주" )
			
		elseif g_sPeriodType == "4" then	'월
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			RadioGroup0.SetRadioCaption( g_TempIndex, "월" )
			
		else
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "Y"
			RadioGroup0.SetRadioCaption( g_TempIndex, "년" )
		
		end if
		
	end if
	
	RadioGroup0.setCurIndexSilent(g_TempIndex)
	
	Dim sDwmm
	sDwmm = ChartEx0.GetStateDWMM()
	if sDwmm == "1" then
		RadioGroup0.enable = 0
	end if

end function
'PENTA13 END
'============================================================================
Sub ChartEx0_OnScrollEnd()
	' Chart Next Data
	if g_szChrtType = "A" then
		DATAMANAGER.RequestNextData("ohhts_5041_005r")
		
	elseif g_szChrtType = "T" then
		DATAMANAGER.RequestNextData("ohhts_5041_006r")
		
	elseif g_szChrtType = "D" then	
		DATAMANAGER.RequestNextData("ohhts_5041_001r")
		
	elseif g_szChrtType == "W" then 
		DATAMANAGER.RequestNextData("ohhts_5041_002r")
		
	elseif g_szChrtType == "M" then 
		DATAMANAGER.RequestNextData("ohhts_5041_003r")
		
	elseif g_szChrtType == "Y" then 
		DATAMANAGER.RequestNextData("ohhts_5041_004r")
		
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "CHANGE_ORIENTATION" Then
		ChartEx0.SetSaveChart("1")
		Form.SetEnvData( 1, "mhtro16020_chart_setting" , g_sPeriodType.."^"..g_sPeriod )
		Form.SetEnvData( 1, "mhtro16020_chart_settingmintick", g_szMinType.."^"..g_szTicType )
		
		Dim sReturn
		sReturn = g_szChrtType
		if g_szChrtType == "A" then
			sReturn = sReturn.."`"..g_szMinType
		elseif g_szChrtType == "T" then
			sReturn = sReturn.."`"..g_szTicType
		end if
		
		Form.OpenPopup("mhtro16020_h1" , g_szItemCode.."^"..sReturn , "")
		
	ElseIf sEventName = "SCREEN_MENU" Then			' 연결정보(상단 ...)
		If sParam == "REG_INTR" Then				' 화면설정
'			Form.OpenPopup("mhtro16010_p5" , ItemCode0.code , "")
			isIntrItem = Form.isIntrItemList(g_szItemCode)
			
			if CInt(g_szIntrGrpCnt) < 1 then
				g_szAction = "GROUP_ADD2"			
				Form.OpenPopup("mhprc11000_pf", g_szAction & "★" & g_szItemCode & "★", "")
			else
				Form.OpenPopupAnimation("mhprc11000_pd", g_szItemCode& "★"& "ADD","", "2")	'종목등록
			end if
			
		end if
		
	Elseif sEventName == "REG_INTR" then
'		Form.OpenPopup( "mhtro16010_p5" , ItemCode0.code, "" )
		isIntrItem = Form.isIntrItemList(g_szItemCode)
		
		if isIntrItem = true then
			Form.OpenPopup("mhprc11000_pe", g_szItemCode& "★"& "DEL","", "")
		else
			if CInt(g_szIntrGrpCnt) < 1 then
				g_szAction = "GROUP_ADD2"			
				Form.OpenPopup("mhprc11000_pf", g_szAction & "★" & g_szItemCode & "★", "")
			else
				Form.OpenPopupAnimation("mhprc11000_pd", g_szItemCode& "★"& "ADD","", "2")	'종목등록
			end if
		end if
		
	' 상단바 클릭 시
	'20220922 SWJ START : 상단 바 클릭 시, 종목선택창 팝업 추가
	elseif sEventName == "TITLE_CLICK" then
'		Form.OpenCommonDialog("SEARCH", "19", "")
	'20220922 SWJ END
		Form.OpenPopup("msearchdialog", "종목검색★50:51:52:53:54:55★INTG_DIVIDE_HISTORY★OVRS★13000", "")		'20240710 HSZ
	
	'20240710 HSZ START
	elseif sEventName = "REFRESH_INTR_ITEM" then
		' Form.requestIntrItemList("00") -> 호출 후 응답오는 부분
		isIntrItem = Form.isIntrItemList(g_szItemCode)
		
		if isIntrItem == true then
			Form.SetInterestTitle("Y")
		else
			Form.SetInterestTitle("N")
		end if
	'20240710 HSZ END
	End if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetEnvData( 1, "mhtro16020_chart_setting", g_sPeriodType.."^"..g_sPeriod )
	Form.SetEnvData( 1, "mhtro16020_chart_settingmintick", g_szMinType.."^"..g_szTicType )

	ChartEx0.SetSaveChart("1")
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	Dim nDecimal
	nDecimal = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_DCPN_CNT" , 0))
	ChartEx0.SetDecimal(nDecimal)
	ChartEx0.SetJisuCode(g_szItemCode)
	
	'20211209 HWG START : 해외주식 차트 종목명 길이체크 로직추가
	Dim szName, sz40Name
	szName = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_KOR_ISNM" , 0)
	
	if len(szName) > 39 then
		sz40Name = Left(szName, 39)
		DATAMANAGER.SetDataValue(0, szTranID, "OutBlock1", "FIDX_KOR_ISNM" , 0 , sz40Name)
	end if
	'20211209 HWG END
	
	'20221213_01 KBC START : 해외주식주간거래
	if szTranID = "ohhts_5041_006r" or szTranID = "ohhts_5041_005r" then	
		sPRPR 			= DATAMANAGER.GetDataValue(false, szTranID , "OutBlock2" , "FIDX_PRPR" , 0)
		sPRDY_VRSS_SIGN 	= DATAMANAGER.GetDataValue(false, szTranID , "OutBlock2" , "FIDX_PRDY_VRSS_SIGN" , 0)
		sPRDY_CTRT 		= DATAMANAGER.GetDataValue(false, szTranID , "OutBlock2" , "FIDX_PRDY_CTRT" , 0)
		sACML_VOL 		= DATAMANAGER.GetDataValue(false, szTranID , "OutBlock2" , "FIDX_ACML_VOL" , 0)
		
		DATAMANAGER.SetDataValue(false, szTranID , "OutBlock1" , "FIDX_PRPR"				, 0 , sPRPR)
		DATAMANAGER.SetDataValue(false, szTranID , "OutBlock1" , "FIDX_PRDY_VRSS_SIGN"	, 0 , sPRDY_VRSS_SIGN)
		DATAMANAGER.SetDataValue(false, szTranID , "OutBlock1" , "FIDX_PRDY_CTRT"		, 0 , sPRDY_CTRT)
		DATAMANAGER.SetDataValue(false, szTranID , "OutBlock1" , "FIDX_ACML_VOL"			, 0 , sACML_VOL)
	end if
	'20221213_01 KBC END
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD", 0, g_szItemCode )
	DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )
	
	'20221213_01 KBC 해외주식주간거래
	if szTranID = "ohhts_5041_006r" or szTranID = "ohhts_5041_005r" then
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntd", "InBlock1", "FIDXR_ISCD", 0, g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_exst_cntd" )
	
	'20231016 LES START
	elseif szTranID == "obtrs_comn_430r" then
	
		avgPrice = DATAMANAGER.GetDataValue(0, "obtrs_comn_430r", "OutBlock1", "AVRG_BYOV_PRC" , 0)
		ChartEx0.SetAvgBuyPrice(g_szItemCode..";"..Cdbl(avgPrice))
		
	end if
	'20231016 LES END
	
	'20240610 SWJ START
	
	Dim sChartSetting
	sChartSetting = ""
	
	if szTranID == "obtro_cntg_611r" then
		
		'20240710 SWJ START
		g_sChartSetting = ""
		g_nCount = 0
		'20240710 SWJ END
		
		nCount = DATAMANAGER.GetDataCount(0, "obtro_cntg_611r" , "OutBlock1")
		
		sAcnt = Form.LoadConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "ACNT")
		sAcntNumber = Left(sAcnt, 4) & "-" & Mid(sAcnt, 5, 4) & "-" & Right(sAcnt, 2)
		
		Dim arrayOrderDate, arrayOrderTime, arrayBuyPrice, arraySellPrice, arrayBuyQuantity, arraySellQuantity, arrayDealClsCode
		
		arrayOrderDate = Array()
		
		arrayOrderTime = Array()
		
		arrayBuyPrice = Array()
		
		arraySellPrice = Array()

		arrayBuyQuantity = Array()
		
		arraySellQuantity = Array()
		
		arrayDealClsCode = Array()
		
		for i = 0 to nCount - 1 
			
			'주문일자
			arrayOrderDate(i) = DATAMANAGER.GetDataValue(0, "obtro_cntg_611r", "OutBlock1", "ODER_DATE" , i)
			
			'체결시각
			arrayOrderTime(i) = DATAMANAGER.GetDataValue(0, "obtro_cntg_611r", "OutBlock1", "CNTG_RCMS_TIME" , i)
			
			'매수평균단가
			arrayBuyPrice(i) = DATAMANAGER.GetDataValue(0, "obtro_cntg_611r", "OutBlock1", "BYOV_UNPR" , i)
			
			'매도평균단가
			arraySellPrice(i) = DATAMANAGER.GetDataValue(0, "obtro_cntg_611r", "OutBlock1", "SELN_UNPR" , i)
			
			'매수평균체결합계
			arrayBuyQuantity(i) = DATAMANAGER.GetDataValue(0, "obtro_cntg_611r", "OutBlock1", "BYOV_CNTG_SMTN" , i)
			
			'매도평균체결합계
			arraySellQuantity(i) = DATAMANAGER.GetDataValue(0, "obtro_cntg_611r", "OutBlock1", "SELN_CNTG_SMTN" , i)
			
			'매매구분코드
			arrayDealClsCode(i) = DATAMANAGER.GetDataValue(0, "obtro_cntg_611r", "OutBlock1", "SELN_BYOV_CLCD" , i)
			
			
			if gChartPeriod == "D" then
				
				'매수 2, 매도 1
				if arrayDealClsCode(i) == "2" then

					'차트엔 매수구분 0으로 세팅
					'sSetting = "0".."^"..arrayOrderDate(i).."^"..sAcntNumber.."^"..Cdbl(arrayBuyPrice(i)).."원".."^"..Cdbl(arrayBuyQuantity(i)).."주"
					sSetting = "0".."^"..arrayOrderDate(i).."^"..sAcntNumber.."^"..SetPriceMask(Cdbl(arrayBuyPrice(i))).."^"..Cdbl(arrayBuyQuantity(i))
				else
					'sSetting = arrayDealClsCode(i).."^"..arrayOrderDate(i).."^"..sAcntNumber.."^"..Cdbl(arraySellPrice(i)).."원".."^"..Cdbl(arraySellQuantity(i)).."주"
					sSetting = arrayDealClsCode(i).."^"..arrayOrderDate(i).."^"..sAcntNumber.."^"..SetPriceMask(Cdbl(arraySellPrice(i))).."^"..Cdbl(arraySellQuantity(i))
				end if
				
			else
			
				'매수 2, 매도 1
				if arrayDealClsCode(i) == "2" then
					'차트엔 매수구분 0으로 세팅
					'sSetting = "0".."^"..arrayOrderTime(i).."^"..sAcntNumber.."^"..Cdbl(arrayBuyPrice(i)).."원".."^"..Cdbl(arrayBuyQuantity(i)).."주"
					sSetting = "0".."^"..Right(arrayOrderDate(i),4)..arrayOrderTime(i).."^"..sAcntNumber.."^"..SetPriceMask(Cdbl(arrayBuyPrice(i))).."^"..Cdbl(arrayBuyQuantity(i))
				else
					'sSetting = arrayDealClsCode(i).."^"..arrayOrderTime(i).."^"..sAcntNumber.."^"..Cdbl(arraySellPrice(i)).."원".."^"..Cdbl(arraySellQuantity(i)).."주"
					sSetting = arrayDealClsCode(i).."^"..Right(arrayOrderDate(i),4)..arrayOrderTime(i).."^"..sAcntNumber.."^"..SetPriceMask(Cdbl(arraySellPrice(i))).."^"..Cdbl(arraySellQuantity(i))
				end if
			end if
			
			if i == 0 then
				g_sChartSetting = sSetting							'20240710 SWJ START
			else
				g_sChartSetting = g_sChartSetting .. ";"..sSetting	'20240710 SWJ START
			end if
			
		next
		
	'	Form.ShowAlert("Test",  nCount..";"..sChartSetting)
		
		'20240710 SWJ START
		g_nCount = nCount
		
		'처음 화면 오픈하고 첫 조회 후 세팅 시에만
		'차트 로드 속도 등 고려하여 타이머 이벤트를 태운다.
		'간헐적으로 표기되지 않는 현상 있음
		'(데이터 조회 -> setTradeData까지 정상적으로 데이터 전달되지만
		' 표기되지 않을 때가 있음)
		
		if g_bChartSetFlag then
			Form.SetTimerEvent2(4 , 1, 0.2)
		else
			SetTradeData()
		end if
		
		g_bChartSetFlag = False
		'20240710 SWJ END
		
	'20240610 SWJ END	
	
	elseif szTranID == "ohhts_intr_006r" then	'20240710 HSZ
		ResponseTranData_Intr()
		
	end if
	
	g_flagInit = false
	g_flagMinTic = false
End Sub
