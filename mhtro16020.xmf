		DATAMANAGER.SetDataValue( false, "ohhts_5041_005r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
	
	elseif szTranID == "ohhts_5041_006r" then
		DATAMANAGER.SetDataValue( false, "ohhts_5041_006r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, "ohhts_5041_006r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , g_szCode )
