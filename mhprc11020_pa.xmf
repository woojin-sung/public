	<SCRIPT_INFO _len="15430" _ulen="14060" >
'============================================================================
' 01.화면명 	: 메리츠Watching_상세세팅
' 02.화면설명	: 메리츠Watching_상세세팅
' 03.작성		: 2016.02.29
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szContList		'컨테이너리스트
dim	g_szRdoList		'라디오리스트
dim	g_szNameList		'타이틀리스트
dim	g_szUserID		'사용자ID
dim	g_szCustNum		'고객번호

dim	g_szSect			'선택구분
dim	g_szAcntList		'계좌리스트		--팝업통해리턴
dim	g_szAsnoList		'일련번호리스트	--팝업통해리턴
dim	g_szRegYNList		'등록여부리스트	--팝업통해리턴
dim	g_szCanYNList		'ooase_user_001a에 들어갈 값	입력은 리턴받은 순서에 따라 input 세팅
dim	g_szProcList		'ooase_user_001a에 들어갈 값	기존데이터가 있으면 U, 없으면 I 세팅
dim	g_sz1stSect	'대분류	총14개
dim	g_sz2ndSect	'중분류	총14개
dim	g_szAcntEvalIdx	'계좌평가 인덱스
dim	g_nLinkLen		'리턴받은 데이터의 갯수
dim	g_nAcntMAX	'계좌평가 push등록MAX값
dim	g_nAcntResetIdx	'계좌평가 reset index	

g_nAcntMAX		=	30
g_nAcntResetIdx	=	0

'--------------------INIT	-------------------------------------------------
g_szContList		=	Array( "cont01"	, "cont02"	, "cont03"	, "cont04", 
						  "cont05" 	, "cont07"	, "cont08"	, "cont09", 
						  "cont10"	, "cont11"	, "cont12"	, "cont13", 
						  "cont14"	, "cont15"	, "cont16")
g_szRdoList		=	Array( "cont01.rdoCur01"		,"cont02.rdoHigh01"		, "cont03.rdoLow01",
						  "cont04.rdoFluct01"		,"cont05.rdoResearch01"	, "cont07.rdoOrgFrgn01",
						  "cont08.rdoKSPKDQ01"		, "cont09.rdoChn01"		, "cont10.rdoHongKong01",
						  "cont11.rdoJpn01"		, "cont12.rdoChng01"		, "cont13.rdoUSEnd01",
						  "cont14.rdoUSMarket01"	, "cont15.rdoDomMarket01"  ,"cont16.rdoAcnt01")
g_szNameList		=	Array("현재가"			,"신고가"			,"신저가"			,"급등/급락",
						 "리서치리포트"		,"기관,외국인 순매수"	,"KOSPI, KOSDAQ 지수"  ,"중국시장지수", 
						 "홍콩시장지수"		,"일본시장지수"		,"원/달러 환율정보"	, "미국시장 마감지수", 
						 "미국시장시황"		,"국내시황"			,"계좌평가")
g_szUserID	= ""					 
g_szSect		= ""			
g_szCustNum	= ""
g_szAcntList	=	Array()
g_szAsnoList	=	Array()
g_szRegYNList	=	Array()
g_szCanYNList	=	Array()
g_szProcList	=	Array()

g_nLinkLen	=	0

g_sz1stSect		= Array("J", "J", "J", "J",				'종목
					   "T", "T",					'투자정보
					   "I", "I", "I", "I", "I", "I",	'지수
					   "S", "S")						'시황
g_sz2ndSect		= Array("a", "b", "c", "d",				'종목
					   "a", "c",					'투자정보
					   "a", "b", "c", "d", "e", "f",	'지수
					   "a", "b")						'시황
g_szAcntEvalIdx	="14"
'--------------------INIT	-------------------------------------------------


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'ProcCanSetting	: 계좌세팅에서 받은 리턴값을 DB에 있는 내용과 비교하여 
'			   I:입력인지 , U:수정인지 세팅
'============================================================================
Function ProcCanSetting(szInAcno, szInAsno, szInRegYN, szIndex)	'계좌번호, 세팅된 값에 따라서 Input세팅한다.
	dim	nCnt, szAcno,	szAsno, szCanYn
'	g_szCanYNList	=	Array()
'	g_szProcList	=	Array()
	nCnt	= 0
	szAcno	=	""
	szAsno	=	""
	szCanYn	=	""
	
	nCnt	=	cont16.grdWatchAcnt01.rowcount
					
	for	i = 0 	to	nCnt - 1
		szAcno	= 	cont16.grdWatchAcnt01.GetCellData("bd_acno", i)
		szAsno	= 	cont16.grdWatchAcnt01.GetCellData("bd_asno", i)
		szCanYn	= 	cont16.grdWatchAcnt01.GetCellData("bd_canc_yn", i)
	

		if	trim(szAcno)	=	trim(szInAcno)	and
			trim(szAsno)	=	trim(szInAsno)	then
			
			
			'--------------------------------
			' 처리구분코드
			'--------------------------------
			'1. 데이터가 공백일시	I
			'2. 데이터가 있을시	U
			if	len(trim(szCanYn)) =	0	then
				g_szProcList(szIndex)	=	"I"
			else
				g_szProcList(szIndex)	=	"U"
			end	if
			
			'--------------------------------
			' 해지여부
			' 1.계좌체크에서 체크되었을시 "1"
			' 2.체크없을시
			'--------------------------------
			if	szInRegYN	=	"1"	then		
				g_szCanYNList(szIndex)	=	"N"
			else
				g_szCanYNList(szIndex)	=	"Y"
			end if
		end	if
	next

End	Function


'============================================================================
'getListItem : 해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function


'============================================================================
'ShowConts:	입력값에 따른 환경설정화면을 보여준다.
'============================================================================
Function	ShowConts(szInput,	szidx)
		
	for	i=0	to	Ubound(g_szContList)
	
		if	i  = 	szInput		then
			Form.SetCtlProp(g_szContList(i), "left", 0)
			Form.SetCtlProp(g_szRdoList(i), "currentindex",	szidx)
		else
			Form.SetCtlProp(g_szContList(i), "left", 400)
		end	if		
	next
	
end	Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim	szVal
	dim	szLinkedData

	szVal	=	""
	szLinkedData	=	""
	
	
	szLinkedData	=	Form.GetOpenLinkData()
	
	
	if	len(trim(szLinkedData))	<	2	then
		Exit Sub
	else
		g_szSect	=	getListItem(szLinkedData,0)
		szVal	=	getListItem(szLinkedData,1)
	end	if
	
	g_szUserID	=	Form.GetSharedData("&USER_ID", 0 )
	g_szCustNum	=	Form.GetSharedData("&CUST_NUM", 0 )


	if		g_szSect	=	g_szAcntEvalIdx	then
		ShowConts(CInt(g_szSect), szVal)
		lblTitle01.caption	=	"계좌평가"
		DATAMANAGER.RequestTranData("ooase_user_100r")
	else
		ShowConts(CInt(g_szSect), szVal)
		lblTitle01.caption	=	g_szNameList(CInt(g_szSect))
	end	if
	
	
End Sub


'============================================================================
'btnSave_OnClick
'============================================================================
Sub btnSave_OnClick()

	Dim	nLoopCnt
	Dim	nTotalCnt		'처리해야할갯수
	Dim	nLeftCnt			'남은갯수
	Dim	nInputCnt		'Input할 loop
		
	
	nLoopCnt	=	0
	nTotalCnt	=	CDbl(g_nLinkLen)					'총 처리해야할 갯수
	nLeftCnt		=	CDbl(g_nLinkLen)					'처리해야할갯수
	nInputCnt	=	0

	if	g_szSect	=	g_szAcntEvalIdx	then			'계좌평가일때만 다른 TR
		
		
		if	g_nLinkLen	<> 	0	then
		
			DATAMANAGER.ClearInputData(0, "ooase_user_001a")
			
			szIdx = cont16.rdoAcnt01.currentindex
			
			'input값은 0:미사용, 1:일 2:월, 3:주, 그러므로 radio값에 따라 변환 필요
			
			if	szIdx	=	"0"	then	'미사용
				szPeriod	=	"0"
			elseif	szIdx	=	"1"	then	'장마감
				szPeriod	=	"1"
			elseif	szIdx	=	"2"	then	'매주
				szPeriod	=	"3"
			elseif	szIdx	=	"3"	then	'매월
				szPeriod	=	"2"
			end	if
			
			
			'몇번에 걸쳐서 넣을지 계산
			
	
			if	CInt(g_nLinkLen)	mod	CInt(g_nAcntMAX)	> 0 then
				nLoopCnt	=	CInt( CInt(g_nLinkLen)	/ CInt(g_nAcntMAX)) + 1
			else
				nLoopCnt	=	1
			end	if
			
			for	j =0 	to	nLoopCnt	-1	
			
				'1. INPUT 클리어
				DATAMANAGER.ClearInputData(0, "ooase_user_001a")
			
			
				'2. COUNT
				'처리해야할 건수가 MAX보다 크면 MAX값을 넣는다.
				if	nLeftCnt	>	g_nAcntMAX	then
					nInputCnt	=	g_nAcntMAX
				else
					nInputCnt	=	nLeftCnt
				end	if
				
				'3. INPUT에 데이터 채워넣음
				for	i = 0  	to nInputCnt -1
					DATAMANAGER.SetDataValue(0,"ooase_user_001a", "InBlock1", "PROS_CLS_CODE", i, g_szProcList(g_nAcntResetIdx))
					DATAMANAGER.SetDataValue(0,"ooase_user_001a", "InBlock1", "ACNO", i, g_szAcntList(g_nAcntResetIdx))
					DATAMANAGER.SetDataValue(0,"ooase_user_001a", "InBlock1", "ASNO", i, g_szAsnoList(g_nAcntResetIdx))
					DATAMANAGER.SetDataValue(0,"ooase_user_001a", "InBlock1", "CYCL_CLCD", i, szPeriod)
					DATAMANAGER.SetDataValue(0,"ooase_user_001a", "InBlock1", "CANC_YN", i, g_szCanYNList(g_nAcntResetIdx))
					DATAMANAGER.SetDataValue(0,"ooase_user_001a", "InBlock1", "ELFN_ID", i, g_szUserID)
					
					g_nAcntResetIdx	=	g_nAcntResetIdx + 1
				next
				
						
				'4. 등록TR 전송
				if	g_nAcntResetIdx	>	0	then
					DATAMANAGER.RequestTranData("ooase_user_001a")
				end	if
				
				
				'5.처리된 갯수 제외
				nLeftCnt	=	nLeftCnt	-	nInputCnt
			next
			
		end	if
		
	else
		DATAMANAGER.RequestTranData("ohhts_watch_002")
	end	if
End Sub


'============================================================================
'cont16_btnAcntSet01_OnClick
'============================================================================
Sub cont16_btnAcntSet01_OnClick()
	Form.OpenPopup("mhprc11020_pc" , sOpenData , sPosInfo)
End Sub

