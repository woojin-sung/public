'ImageClose_OnClick
'============================================================================
Sub ImageClose_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim	szPeriod			'ooase_user_001a	주기코드
	dim	szIdx
	dim	szRdoIdx


	
	szPeriod = "0"
	szIdx	= ""	
	szRdoIdx	= "0"
	
	'-----------------------------------------
	' 일반 Watching 조건등록
	'-----------------------------------------
	if	szTranID =	"ohhts_watch_002"	then
			
		szRdoIdx = Form.GetCtlProp(g_szRdoList(Cint(g_szSect)), "currentindex")			'현재 선택된 Index
		DATAMANAGER.SetDataValue(0,"ohhts_watch_002", "InBlock1", "FID_INPUT_WRTR_ID", 0, g_szCustNum)
		
		DATAMANAGER.SetDataValue(0,"ohhts_watch_002", "InBlock2", "FID_INPUT_CLS", 0, g_sz1stSect(Cint(g_szSect)))
		DATAMANAGER.SetDataValue(0,"ohhts_watch_002", "InBlock2", "FID_INPUT_CLS1", 0, g_sz2ndSect(Cint(g_szSect)))
		DATAMANAGER.SetDataValue(0,"ohhts_watch_002", "InBlock2", "FID_INPUT_OPTN_CODE", 0, szRdoIdx)
	'-----------------------------------------
	' 계좌평가 Watching 조회
	'-----------------------------------------
	elseif		szTranID	=	"ooase_user_100r"	then
		DATAMANAGER.SetDataValue(0,"ooase_user_100r", "InBlock1", "ELFN_ID", 0, g_szUserID)
				
		
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	szAsno,	szAcno,	szRegYN		'계좌평가용
	dim	n100Cnt
	dim	bIsNext
	szAsno	=	""
	szAcno	=	""
	szRegYN	=	""
	n100Cnt  =   0 
	bIsNext	=   false
	'-----------------------------------------------
	' 일반 조건저장
	'-----------------------------------------------
	if	szTranID	=	"ohhts_watch_002"	then
		Form.SendReturnToParent("ALARMSET_11020" , "0")
		Form.CloseForm()
		
	'-----------------------------------------------
	' Watching 계좌평가 조회
	'-----------------------------------------------
	elseif		szTranID	=	"ooase_user_100r"	then
			

		if	g_nLinkLen	>	0	then			'팝업리턴
		
			bIsNext	=	DATAMANAGER.IsMoreNextData("ooase_user_100r")
			
			
			if	bIsNext	=	false	then
				for	i =0 	to	g_nLinkLen - 1
					szAcno	=	g_szAcntList(i)
					szAsno	=	g_szAsnoList(i)
					szRegYN	=	g_szRegYNList(i)
					ProcCanSetting	(szAcno, szAsno, szRegYN, i)	'계좌번호, 세팅된 값에 따라서 Input세팅한다. (처리코드, 해지여부)
				next
	'					for	i = 0  	to g_nLinkLen -1
	'						Form.ShowAlert(g_szAcntList(i) & g_szAsnoList(i), g_szProcList(i))
	'					next
			else
				DATAMANAGER.RequestNextData("ooase_user_100r")
			end	if
	
		else									'초기조회
		
		
			bIsNext	=	DATAMANAGER.IsMoreNextData("ooase_user_100r")
			
			if	bIsNext	=	false	then
				n100Cnt	=	cont16.grdWatchAcnt01.rowcount

				'List에 초기화 값넣음
				for j =0 	to	n100Cnt	- 1
					g_szAcntList(j)	=	cont16.grdWatchAcnt01.GetCellData("bd_acno", j)				 		
					g_szAsnoList(j)	=	cont16.grdWatchAcnt01.GetCellData("bd_asno", j)
					g_szCanYNList(j)	=	cont16.grdWatchAcnt01.GetCellData("bd_canc_yn", j)
					
					if	len(trim(g_szCanYNList(j)))	  =	0	then		'초기에는 DATA가 공백일수도 있다.
						g_szCanYNList(j)		=	"Y"
						g_szProcList(j)		=	"I"				'데이터없으므로 INSERT
					else	
						g_szProcList(j)		=	"U"				'데이터있으니 UPDATE
					end	if
					
				next
	
				g_nLinkLen	=	CDbl(n100Cnt)	'카운팅이 없으면 TR조회안함
			else
				DATAMANAGER.RequestNextData("ooase_user_100r")
			end	if
		end	if
		
'		for	i = 0  	to g_nLinkLen -1
'			Form.ShowAlert(g_szAcntList(i) & g_szAsnoList(i), g_szProcList(i))
'		next
		
	
	'-----------------------------------------------
	' Watching 계좌평가 등록
	'-----------------------------------------------
	elseif		szTranID	=	"ooase_user_001a"	then
		Form.SendReturnToParent("ALARMSET_11020" , "0")
		Form.CloseForm()
	end	if
End Sub



'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)


	if	sKeyName	=	"mhprc11020_pc"	then
			
		if	len(trim(sRet))	<>	0	then
			g_nLinkLen	=	Cdbl(getListItem(sRet,0))
			'-----------------------------
			' 1. 계좌의 등록여부값을 가져옴
			'-----------------------------
			if	g_nLinkLen	<>	0	then
				for	i = 0 	to	g_nLinkLen - 1 
					g_szAcntList(i)	=	getListItem(sRet, (i*3)+1 )		'계좌리스트(8)
					g_szAsnoList(i)	=	getListItem(sRet, (i*3)+2 )		'일련번호리스트(2)
					g_szRegYNList(i)	=	getListItem(sRet, (i*3)+3 )		'등록여부리스트(2)
				next	
			
			'-----------------------------
			' 2. 비교를 위해 DB에 등록되어있는 내용가져옴
			'-----------------------------
				DATAMANAGER.RequestTranData("ooase_user_100r")			'DB있는 내역조회후 비교하여 INPUT값 세팅
			end	if
			
'			for	i = 0  	to g_nLinkLen -1
'				Form.ShowAlert(i, g_szAcntList(i) & ".." & g_szRegYNList(i)	)
'			next

		end	if
	end	if
End Sub



