'============================================================================
' 01.화면명 	: 펀드검색
' 02.화면설명	: 펀드검색_수익률Best탭
' 03.작성		: 2016.02.11
'===========================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szShortCd		'선택된아이템 코드값
dim	g_szStndCd		'선택된아이템 풀코드
dim	g_szSortCls		'정렬구분값
dim	g_szFundName		'펀드명
dim	g_szIsDesc		'desc/asc인지
dim	g_szAlertTitle	'알림타이틀

g_szSortCls	=	"C"		'수익률 1개월 내림
g_szIsDesc	=	"1"		'내림차순으로 기본세팅
g_szAlertTitle	=	"알림"
'------------------------------------
'oocwi_mall_002r : SORT_CLS_CODE 값
'펀드검색 		 R 
'수익률 1개월 올림 B 
'수익률 1개월 내림 C 
'수익률 3개월 올림 D 
'수익률 3개월 내림 E 
'수익률 6개월 올림 F 
'수익률 6개월 내림 G 
'수익률 12개월 올림 H 
'수익률 12개월 내림 I 
'설정잔고 올림 O 
'　       내림 Q  
'------------------------------------

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'getGradeColor	:	 등급코드 색상을 리턴한다.
'============================================================================
Function getGradeColor (szOrgGrad)
	if	szOrgGrad = "01" 	or	szOrgGrad = "02"		then
		return "1"
	elseif	szOrgGrad = "03" 	or	szOrgGrad = "04"		then
		return "101"
	elseif	szOrgGrad = "05"		then
		return "57"
	else
		return "4"
	end	if
End Function


'============================================================================
'ShowCol	: 조회후에 보여지는 값 처리
'============================================================================
Function ShowCol()
	dim szSort
	
	szSort	=""
	szSort	=	cmbPeriod01.cbkeydata

	if	szSort	=	"1"	then			'1개월
		grd01T2.SetVisibleCol(2, 1)
		grd01T2.SetVisibleCol(3, 0)
		grd01T2.SetVisibleCol(4, 0)
		grd01T2.SetVisibleCol(5, 0)	
	elseif	szSort	=	"3"	then		'3개월
		grd01T2.SetVisibleCol(2, 0)
		grd01T2.SetVisibleCol(3, 1)
		grd01T2.SetVisibleCol(4, 0)
		grd01T2.SetVisibleCol(5, 0)
	elseif	szSort	=	"6"	then		'6개월
		grd01T2.SetVisibleCol(2, 0)
		grd01T2.SetVisibleCol(3, 0)
		grd01T2.SetVisibleCol(4, 1)
		grd01T2.SetVisibleCol(5, 0)

	elseif	szSort	=	"12"	then		'12개월
		grd01T2.SetVisibleCol(2, 0)
		grd01T2.SetVisibleCol(3, 0)
		grd01T2.SetVisibleCol(4, 0)
		grd01T2.SetVisibleCol(5, 1)

	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim szData
	dim szList
	DATAMANAGER.RequestTranData("oocwi_mall_002r")
	
End Sub


'============================================================================
'btnCaution01_OnClick
'============================================================================
Sub btnCaution01_OnClick()
	Form.OpenPopup("mbfnp51000_p3" , sOpenData , sPosInfo)
End Sub



'============================================================================
'cmbPeriod01_OnEditComplete
'============================================================================
Sub cmbPeriod01_OnEditComplete(iIndex)


	'임시 세팅 추후 TR input 값으로 처리함
	
	if	iIndex	=	0	then			'1개월
		if	g_szIsDesc	=	"1"	then
			g_szSortCls	=	"C"
		else
			g_szSortCls	=	"B"
		end	if	
	elseif	iIndex	=	1	then		'3개월
		if	g_szIsDesc	=	"1"	then
			g_szSortCls	=	"E"
		else
			g_szSortCls	=	"D"
		end	if

	elseif	iIndex	=	2	then		'6개월
		if	g_szIsDesc	=	"1"	then
			g_szSortCls	=	"G"
		else
			g_szSortCls	=	"F"
		end	if

	elseif	iIndex	=	3	then		'12개월
		if	g_szIsDesc	=	"1"	then
			g_szSortCls	=	"I"
		else
			g_szSortCls	=	"H"
		end	if
	end if
End Sub


'============================================================================
'grd01T2_OnClickUp
'============================================================================
Sub grd01T2_OnClickUp(lRow, szCellID)
		
	g_szShortCd		=	grd01T2.GetCellData("bd_cell0", lRow)
	g_szStndCd		= 	grd01T2.GetCellData("bd_cell5", lRow)
	g_szFundName		=	grd01T2.GetCellData("bd_name", lRow)
	
	listLocation =  Split(grd01T2.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	sPopupType = "2"

	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "신규가입" & "★" & "펀드상세" & "★" & "관심등록" & "★" & " " & "★" & " ")
End Sub



'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if	szTranID	=	"oocwi_mall_002r"	then
		DATAMANAGER.SetDataValue(0, "oocwi_mall_002r", "InBlock1", "IISC_INVT_REGN_CLS_CODE", 0, cmbArea01.cbkeydata)
		DATAMANAGER.SetDataValue(0 ,"oocwi_mall_002r", "InBlock1", "SORT_CLS", 0, g_szSortCls)
	end if
	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	n002Cnt, szDataCnt
	dim	szOrgGrad, szTransGrad
	dim  nMulti, szColor


	dim nIntrIdx			'관심등록 위치
	dim szIntrCD			'관심등록된 코드
	dim	bIsmore

	nIntrIdx	=	0
	szIntrCD	=	""
	bIsmore	=	false
	
	
	if	szTranID	=	"oocwi_mall_002r"	then
	
		ShowCol()
		
		n002Cnt 	=	grd01T2.rowcount
		szDataCnt	=	DATAMANAGER.GetDataCount(0, "oocwi_mall_002r", "OutBlock2")

		nMulti =  ( n002Cnt / szDataCnt ) - 1
		for	i=0+(nMulti * szDataCnt) to	n002Cnt-1
			szOrgGrad 	 =	grd01T2.GetCellData("bd_grade", i)
			szColor	=	getGradeColor (szOrgGrad)
			
		
			szTransGrad =  Form.GetMetaData("상품등급코드", szOrgGrad)
			grd01T2.SetCellFgColor("bd_grade", i, szColor)
			grd01T2.SetCellData("bd_grade", i, szTransGrad)
		next
		
	elseif	szTranID	=	"oocwi_mall_002r_1"	then	
	
		bIsmore	=	DATAMANAGER.IsMoreNextData("oocwi_mall_002r_1")
			
		if	bIsmore	=	true		then
			DATAMANAGER.SetDataValue(0, "oocwi_mall_002r_1", "InBlock1", "PROS_CLS_CODE", 0 , "2")
			DATAMANAGER.RequestNextData("oocwi_mall_002r_1")
		else	
			nIntrIdx = grdIntrFund01.rowcount
			
			'1. 기존관심펀드에 등록되어있는지 확인
			for	i = 0	to	nIntrIdx	
				szIntrCD	=	grdIntrFund01.GetCellData("bd_cell0", i)
				if	trim(szIntrCD)	=	trim(g_szShortCd)	then
					Form.ShowAlert(g_szAlertTitle, "이미 등록된 펀드가 존재합니다.")
					exit sub
				end if
			next
			
			
			'2. 기존에 관심펀드 없을경우 있을경우만 그리드에 추가
			grdIntrFund01.AddRow()
			grdIntrFund01.SetCellData("bd_cell0", nIntrIdx  , g_szShortCd)
						
			nIntrIdx = grdIntrFund01.rowcount		'등록되기전 조회하여 데이터 들어간 갯수체크 재확인

			'3. 등록 TR 전송
			for	i = 0	to	nIntrIdx -1 
				DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock1", "EMPL_CNIS_TYPE_CLCD", i  , "1")	'집합투자증권 1
				DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock2", "ISCD", i, grdIntrFund01.GetCellData("bd_cell0", i))
			next
			
			DATAMANAGER.SetEventFlag("oocwi_gmyg_011a", "A")
			DATAMANAGER.RequestTranData("oocwi_gmyg_011a")
		end	if
	elseif	szTranID	=	"oocwi_gmyg_011a"	then
		Form.ShowAlert(g_szAlertTitle, "관심펀드에 등록되었습니다.")
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if	szTranID	=	"oocwi_gmyg_011a"	then
		Form.ShowAlert(g_szAlertTitle, szErrMsg)
	end if
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	szListItems	=	split(sRet,"★")
		
	if sKeyName = "MOVEPOP_RETURN"	then				'미니팝업처리

		if	szListItems(1)	=	"0"	then			'신규매수
			Form.OpenScreen("51010" , g_szShortCd & "★" & g_szStndCd & "★" & g_szFundName) 
			
		elseif	szListItems(1)	=	"1"	then		'펀드상세
			Form.OpenFramePopup("mbfnp51000_p2", g_szShortCd & "★" & g_szStndCd , sPosInfo)
			
		elseif 	szListItems(1)	=	"2"	then		'관심등록
			
			'관심펀드		
			grdIntrFund01.SetClear()
			DATAMANAGER.ClearInputData(0, "oocwi_mall_002r_1")
			DATAMANAGER.SetDataValue(0, "oocwi_mall_002r_1", "InBlock1", "PROS_CLS_CODE", 0 , "2")
			DATAMANAGER.RequestTranData("oocwi_mall_002r_1")	
		end if
	end if
	
End Sub


'============================================================================
'grd01T2_OnHeaderClickUp
'============================================================================
Sub grd01T2_OnHeaderClickUp(lRow, szCellID)
	dim	szIndex

	szIndex	=	cmbPeriod01.currentindex
	
	if	g_szIsDesc	=	"1"	then		'내림차순일때
		g_szIsDesc	=	"0"
	else
		g_szIsDesc	=	"1"			'오름차순일때
	end	if

	if	szIndex	=	"0"	then			'1개월
		if	g_szIsDesc	=	"1"	then
			g_szSortCls	=	"C"
		else
			g_szSortCls	=	"B"
		end	if	
	elseif	szIndex	=	"1"	then		'3개월
		if	g_szIsDesc	=	"1"	then
			g_szSortCls	=	"E"
		else
			g_szSortCls	=	"D"
		end	if

	elseif	szIndex	=	"2"	then		'6개월
		if	g_szIsDesc	=	"1"	then
			g_szSortCls	=	"G"
		else
			g_szSortCls	=	"F"
		end	if

	elseif	szIndex	=	"3"	then		'12개월
		if	g_szIsDesc	=	"1"	then
			g_szSortCls	=	"I"
		else
			g_szSortCls	=	"H"
		end	if
	end if

	DATAMANAGER.RequestTranData("oocwi_mall_002r")


	
End Sub

