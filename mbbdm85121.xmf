			end if
			
		Else
		     
		     'JMY 테스트-SKIP처리인경우, 정상으로 처리
			if ChkButton0.checkstate = "1" or ChkButton0.checkstate = 1 then								
				
				sRSPNTYPECODE = "0"   '진위확인유형
				g_IDNTF_TORF_YN = "Y" '신분증진위확인여부

				'비대면계좌개설
				if g_NMETBSWRGB == "100" then 
					DATAMANAGER.RequestTranData("obaci_acct_049c")			
				'비대면업무신청(0xx), 모바일OTP(3xX)
				else 
					DATAMANAGER.RequestTranData("obcsb_nmet_102c")
				end if
				
			else
     			       'v0001 신분증진위확인여부
			       sRSPNTYPECODE = "9"
			       g_IDNTF_TORF_YN = "N"
				'v0001 진위확인 오류내역 생성추가
				DATAMANAGER.RequestTranData("obaci_idvs_003a")
		  
