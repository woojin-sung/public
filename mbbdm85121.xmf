'					'strMsg = "처리불가합니다."
'					strMsg = "이 신분증은 사용할 수 없습니다.\n확인 후 이용바랍니다."
'					Form.OpenPopup("mbbdm85122" , strMsg)
'					
'					Exit Sub
'				
'				
'				ElseIf sRSPNTYPECODE = "7" Then
'				
'					'20210503 LES START
'					'strMsg = "처리불가합니다."
'					strMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
'					Form.OpenPopup("mbbdm85122" , strMsg)
'					
'					Exit Sub
'				
'				Else
'					
'					strMsg = sRSPNMSG
'					Form.OpenPopup("mbbdm85122" , strMsg)
'				
'				End If
			
			end if
		End If
	'v0008 jsi end
    'v0001 진위확인이력생성 
	ElseIf szTranID = "obaci_idvs_003a" Then	
					
		If sRSPNTYPECODE = "8" Then  '수기허용 
			'수기허용도 진위확인 오류로 처리함
			strMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
		ElseIf sRSPNTYPECODE = "R" Then	'재시도
			strMsg = "신분증정보가 불일치 합니다.\n재촬영하시거나,인식된 정보를 \n확인해주시기 바랍니다."
		ElseIf sRSPNTYPECODE = "9" Then	'오류
			'szMsg = "이 신분증은 사용할 수 없습니다.\n확인 후 이용바랍니다."		
			szMsg = "죄송합니다. \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."		
		ElseIf sRSPNTYPECODE = "7" Then		
			strMsg = "죄송합니다. 시스템 문제로 \n신분증 진위확인을 하지 못하였습니다.\n추후 다시 시도하여 주시기 바랍니다."
		Else
