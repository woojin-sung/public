'============================================================================
Function User_SharedData_Set(gb)	'JMY

    '진입점에서 설정되는 정보 ---------------------------------------
    Form.SetSharedData("BDM_FRST_MAPID"  , g_BDM_FRST_MAPID  )	'최초진입화면ID
    Form.SetSharedData("BDM_NMETBSWRGB"  , g_BDMNMETBSWRGB   )	'비대면업무구분
    Form.SetSharedData("mOTP_IntoClcd"	, g_mOTP_IntoClcd   )	'(모바일OTP)진입구분코드
    Form.SetSharedData("BDM_CSNO"  		, g_BDM_CSNO		 ) '고객번호


    if gb == "Init" then
		'휴대폰본인인증에서 설정되는 정보 ---------------------------------------
		Form.SetSharedData("BDM_REG_UNIQ_NO"    		, "")	'등록고유번호
		Form.SetSharedData("BDM_REG_STAG_CLS_CODE"	, "")	'등록단계구분코드
		Form.SetSharedData("BDM_NAME"         		, "")	'이름
		Form.SetSharedData("BDM_RCNO_PIP"       		, "")	'주민등록번호
		Form.SetSharedData("BDM_COMPANY_CODE"  	 	, "")	'통신사 정보
		Form.SetSharedData("BDM_HP1"          		, "")	'휴대폰번호
		Form.SetSharedData("BDM_HP2"              	, "")
		Form.SetSharedData("BDM_HP3"              	, "")
		
		'신분증진위확인에서 설정되는 정보 ---------------------------------------
		Form.SetSharedData("BDM_IDNTF_SRNO"          	, "")	'신분증일련번호

		'이어하기안내용, 진행상태보기용 Data ---------------------------------------
		Form.SetSharedData("BDM_LAST_STAG_CLS_CODE"	, "" )	'최종등록단계구분코드
		Form.SetSharedData("BDM_CLEAR_YN"     		, "" )	'이어하기여부
		Form.SetSharedData("BDM_PRNM"       			, "" )	'개설상품명
		Form.SetSharedData("BDM_BDM_APLTDATE"   		, "" )	'신청일자
		Form.SetSharedData("BDM_BDM_CLSNDATE"   		, "" )	'신청마감일자

    else
		'휴대폰본인인증에서 설정되는 정보 ---------------------------------------
		Form.SetSharedData("BDM_REG_UNIQ_NO"       	, g_BDM_REG_UNIQ_NO   		)	'등록고유번호
		Form.SetSharedData("BDM_REG_STAG_CLS_CODE"	, g_BDM_REG_STAG_CLS_CODE 	)	'등록단계구분코드
		Form.SetSharedData("BDM_NAME"         		, g_BDM_NAME        		)	'이름
		Form.SetSharedData("BDM_RCNO_PIP"       		, g_BDM_RCNO_PIP      		)	'주민등록번호
		Form.SetSharedData("BDM_COMPANY_CODE"   		, g_BDM_COMPANY_CODE    	)	'통신사 정보
		Form.SetSharedData("BDM_HP1"          		, g_BDM_HP1         		)	'휴대폰번호
		Form.SetSharedData("BDM_HP2"              	, g_BDM_HP2       		)
		Form.SetSharedData("BDM_HP3"              	, g_BDM_HP3       		)

		'신분증진위확인에서 설정되는 정보 ---------------------------------------
		Form.SetSharedData("BDM_IDNTF_SRNO"          	, g_BDM_IDNTF_SRNO		)	'신분증일련번호

		'이어하기안내용, 진행상태보기용 Data ---------------------------------------
		Form.SetSharedData("BDM_LAST_STAG_CLS_CODE"	, g_BDM_LAST_STAG_CLS_CODE	)	'최종등록단계구분코드
		Form.SetSharedData("BDM_CLEAR_YN"     		, g_BDM_CLEAR_YN      		)	'이어하기여부
		Form.SetSharedData("BDM_PRNM"       			, g_BDM_PRNM        		)	'개설상품명
		Form.SetSharedData("BDM_APLTDATE"     		, g_BDM_APLTDATE      		)	'신청일자
		Form.SetSharedData("BDM_CLSNDATE"     		, g_BDM_CLSNDATE      		)	'신청마감일자
      
	end if

End Function
'============================================================================
Function User_SharedData_Get()	'JMY

	'진입점에서 설정되는 정보 ---------------------------------------
	g_BDM_FRST_MAPID        	= Form.GetSharedData("BDM_FRST_MAPID"		, false)	'최초진입화면ID
	g_BDMNMETBSWRGB         	= Form.GetSharedData("BDM_NMETBSWRGB"		, false)	'비대면업무구분
	g_NMETBSWRGB			   	= Form.GetSharedData("BDM_NMETBSWRGB"		, false)	'비대면업무구분
	g_mOTP_IntoClcd			= Form.GetSharedData("mOTP_IntoClcd"			, false)	'(모바일OTP)진입구분코드
	g_BDM_CSNO   				= Form.GetSharedData("BDM_CSNO"   			, false) '고객번호

	'휴대폰본인인증에서 설정되는 정보 ---------------------------------------
	g_BDM_REG_UNIQ_NO       	= Form.GetSharedData("BDM_REG_UNIQ_NO"        , false) '등록고유번호
	g_BDM_REG_STAG_CLS_CODE 	= Form.GetSharedData("BDM_REG_STAG_CLS_CODE"  , false) '등록단계구분코드
	g_BDM_NAME              	= Form.GetSharedData("BDM_NAME"               , false) '이름
	g_BDM_RCNO_PIP        	  	= Form.GetSharedData("BDM_RCNO_PIP"           , false) '주민등록번호
	g_BDM_COMPANY_CODE   	  	= Form.GetSharedData("BDM_COMPANY_CODE"       , false) '통신사 정보
	g_BDM_HP1             	  	= Form.GetSharedData("BDM_HP1"                , false) '휴대폰번호
	g_BDM_HP2              	= Form.GetSharedData("BDM_HP2"                , false)
	g_BDM_HP3               	= Form.GetSharedData("BDM_HP3"                , false)

	'신분증진위확인에서 설정되는 정보 ---------------------------------------
	g_BDM_IDNTF_SRNO			= Form.GetSharedData("BDM_IDNTF_SRNO"        	, false)	'신분증일련번호

	'이어하기안내용, 진행상태보기용 Data ---------------------------------------
	g_BDM_LAST_STAG_CLS_CODE 	= Form.GetSharedData("BDM_LAST_STAG_CLS_CODE"	, false)	'최종등록단계구분코드
	g_BDM_CLEAR_YN          	= Form.GetSharedData("BDM_CLEAR_YN"    		, false) '이어하기여부
	g_BDM_PRNM              	= Form.GetSharedData("BDM_PRNM"         		, false) '개설상품명
	g_BDM_APLTDATE          	= Form.GetSharedData("BDM_APLTDATE" 			, false) '신청일자
	g_BDM_CLSNDATE          	= Form.GetSharedData("BDM_CLSNDATE" 			, false) '신청마감일자

	'비대면업무구분1자리 설정
	g_sz_SubNmetBswrGb = Mid(g_BDMNMETBSWRGB,1,1)
End Function


'============================================================================
Sub Form_OnFormInit()
	
		
	'==================================
	' TEST
	'==================================
	nDev = Form.GetSharedData("&SERVER_MODE", false )	
	if nDev == "1" then
		ChkButton0.visible = true
	else
		ChkButton0.visible = false
		ChkButton0.checkstate = 0
	end if
	'==================================
	
	'라벨글자색
	Container0.Label0.fgcolor = 269
	Container0.Label1.fgcolor = 269
	
	Container0.Label3.fgcolor = 268
	Container0.Label4.fgcolor = 268
	Container0.Label5.fgcolor = 268
	Container0.Label6.fgcolor = 268
	
	

	'OS타입
	g_OsType = Form.GetSharedData("&OS_TYPE", false)
	
	
	if g_OsType == "1" then 'AOS
		Form.setCaptureEnblYN("N")
	end if
	
	g_TR_DATE  = Form.GetSharedData("&HOST_DATE", false )

	'공유변수 데이터GET
	User_SharedData_Get()
	
	'비대면계좌개설인 경우에만 진행단계표시
	if g_NMETBSWRGB == "100" then
		ImgF.visible = true
	else
		ImgF.visible = false
	end if		
		
	Container0.EditName.imagefilepth			= "login_input_off.9.png"
	Container0.EditRcno.imagefilepth			= "login_input_off.9.png"
	
	Container0.Label3.fgcolor = 268
	Container0.Label4.fgcolor = 268
	Container0.Label5.fgcolor = 268
	Container0.Label6.fgcolor = 268
		
	
	'발급일자 컨트롤 세팅(평문으로 보여야함)
	Container0.EditIssueDate.SetDispPlain()
	
	'신분증 데이터 세팅
	Call DATA_SET()
	

	
	
End Sub


'============================================================================
' 사진촬영 후 메인에서 받은 데이터 세팅
'============================================================================
Sub DATA_SET()

	
	g_ImgData = ""
	g_ImgDataLen = 0


	'주민등록증 10, 주민등록증(재외국민)12, 면허증11
	g_IdCardType = Form.GetSharedData("&RET_CARD_TYPE", 0)
	
	If g_IdCardType = "10" or g_IdCardType = "12" then
		
		Container0.EditLicenseNo.left = 500
		Container0.EditLicenseNo.visible = false
		Container0.Label5.visible = false
		
		
		Container0.EditIssueDate.top = 377
		Container0.Label6.top = 379
		Container0.Button0.height = 152
		
		
		g_IDNTF_CODE     =  "1"  
		g_IDNTF_CLS_CODE =  "01" 
		
	Elseif g_IdCardType = "11" then
	
		'면허번호 중요정보로 숨김처리
		Container0.EditLicenseNo.left = 500
		Container0.EditLicenseNo.visible = false
		Container0.Label5.visible = false
		
		
		Container0.EditIssueDate.top = 377
		Container0.Label6.top = 379
		Container0.Button0.height = 152
	
				
		g_IDNTF_CODE     =  "2"  'v0002
		g_IDNTF_CLS_CODE =  "02" 'v0004
	
	End if
	
	
	'OCR정보 세팅
	Container0.EditName.caption  		= Form.GetSharedData("&RET_NAME", 0)				'이름
	Container0.EditRcno.caption  		= left(Form.GetSharedData("&RET_BIRTHDAY", 0), 6)	'생년월일
	Container0.EditLicenseNo.caption 	= Form.GetSharedData("&RET_LICENSE_NUM", 0) 		'
	Container0.EditIssueDate.caption 	= Form.GetSharedData("&RET_ISSU_DATE", 0) 		'v0004. 발급일자. 컨트롤 변경
	
	
	g_NAME		    = Form.GetSharedData("&RET_NAME", 0)				'이름
	g_RCNO 		    = Form.GetSharedData("&RET_JUMIN_NUM", 0 )		'암호화된 실명확인번호
	g_ISSU_DATE	    = Form.GetSharedData("&RET_ISSU_DATE", 0)			'발급일자
	
	ImgMskData 	    = Form.GetSharedData("&RET_MASK_IMAGE_ENC" , 0)	'주민번호 마스킹이미지 
	g_ImgData  	    = Form.GetSharedData("&RET_IMAGE_ENC", 0)			'주민번호 마스킹없는이미지

	'v0004
	g_FEATURE 	  = Form.GetSharedData("&RET_FEATURE"		, 0 ) 	'특징점데이터
	g_FEATURE_SCORE = Form.GetSharedData("&RET_FEATURE_SCORE"	, 0 ) 	'특징점 점수
	g_FEATURE_LEN   = Form.GetSharedData("&RET_FEATURE_LEN"	, 0 ) 	'특징점데이터 길이
	g_SERIAL    	  = Form.GetSharedData("&RET_SERIAL"			, 0 ) 	'발급번호
	g_LISENCE_NUM   = Form.GetSharedData("&RET_LICENSE_NUM"	, 0 ) 	'신분증번호
	g_RCNO_7		  = Form.GetSharedData("&RET_JUMIN_NUM_BACK"	, 0 ) 	'실명확인번호 뒷 7자리
	
	if ImgMskData <> "" and g_ImgData <> "" then 
		
		g_ImgDataLen 	= LEN(g_ImgData)
		ImgMskDataLen = LEN(ImgMskData)
		
		if g_ImgDataLen > 0  and ImgMskDataLen > 0 then
			Container0.Image0.SetImageDataEnc(ImgMskData)
		end if
	end if
	
End Sub


'============================================================================
' 신분증전송
'============================================================================
Sub BtnSend_OnClick()
	
	strName = Trim(Container0.EditName.caption)
	strRCNO = Trim(Container0.EditRcno.caption)
	strDate = Container0.EditIssueDate.caption
	
	'본인인증 입력 데이터와 신분증데이터 비교
	
	'비대면계좌개설
	if g_NMETBSWRGB == "100" Then
		g_sharedName    = Form.GetSharedData("BDM_NAME", false )		'이름 
		g_sharedBirth   = Form.GetSharedData("&RET_BIRTHDAY", false )	'생년월일 
					
		'재외국민 주민등록증인 경우 비대면 계좌개설 불가
		If g_IdCardType = "12" then 
			
			'20210503 LES START
			'strTitle = "알림"
			'strMsg = "재외국민은 비대면 계좌개설 불가"
			'strFlag = "error"
			'Form.OpenPopup("mbbdm85121_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
			strMsg = "재외국민은 비대면 계좌개설이 불가합니다."
			Form.OpenPopup("mbbdm85122" , strMsg)
			
			
			Exit Sub 
		End if
	
	'업무신청
	elseif g_sz_SubNmetBswrGb == "0" then
	
		g_sharedName    = Form.GetSharedData("BDM_NAME", false )		'이름 
		g_sharedBirth   = Form.GetSharedData("&RET_BIRTHDAY", false )	'생년월일
		
		'재외국민 주민등록증인 경우 업무신청불가
		If g_IdCardType = "12" then 
			
			strMsg = "재외국민은 비대면 업무신청이 불가합니다."
			Form.OpenPopup("mbbdm85122" , strMsg)
			Exit Sub 
		End if
		
	'모바일OTP	
	else
		g_sharedName    = Form.GetSharedData("BDM_NAME", false )		'이름 
		g_sharedBirth   = Form.GetSharedData("&RET_BIRTHDAY", false )	'생년월일 
		
		'재외국민 주민등록증인 경우 모바일OTP
		If g_IdCardType = "12" then 
			
			strMsg = "재외국민은 모바일OTP 발급이 불가합니다."
			Form.OpenPopup("mbbdm85122" , strMsg)
			Exit Sub 
		End if
		
		
	end if
	
	'JMY 테스트Skip인경우, 체크 제외
	if CInt(ChkButton0.checkstate) ~= 1 then 
		'-------------------------------------------------
		'입력데이터 확인 및 OCR데이터와 전단계화면 입력데이터 비교
		'-------------------------------------------------
		if strName = "" then 
			
			strTitle = "알림"
			strMsg = "이름을 확인하세요."
			strFlag = "error"
			Form.OpenPopup("mbbdm85121_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
			
			exit Sub 
		end if
		
		if strRCNO = "" then
		
			strTitle = "알림"
			strMsg = "생년월일을 확인하세요.(주민번호 앞 6자리)"
			strFlag = "error"
			Form.OpenPopup("mbbdm85121_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
			
			exit Sub 
		end if
		
		
		rcnoLen = Container0.EditRcno.getLen(Container0.EditRcno.caption)
		
		if cint(rcnoLen) < 6 then
		
			strTitle = "알림"
			strMsg = "생년월일을 확인하세요.(주민번호 앞 6자리)"
			strFlag = "error"
			Form.OpenPopup("mbbdm85121_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
			
			exit Sub 
		
		end if
		
				
		if g_sharedName <> strName then
			
			strTitle = "알림"
			strMsg = "이름을 확인하세요."
			strFlag = "error"
			Form.OpenPopup("mbbdm85121_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
			
			exit Sub 
		end if
		
		if CInt(left(strDate,4)) < 8 then 'v0004
			
			strTitle = "알림"
			strMsg = "발급일자를 확인하주시기 바랍니다."
			strFlag = "error"
			Form.OpenPopup("mbbdm85121_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
			
			exit Sub  
		end if
	end if
	
	'-------------------------------------------------
	'서비스호출
	'재시도의 경우 obaci_acct_158a SKIP 후 obtss_idvs_001a Call
	'-------------------------------------------------
	g_RCNO_PIP		= g_RCNO
	
	'JMY Sta ---------------------------------------
	'비대면계좌개설(100), 비대면업무신청(0xx), 모바일OTP(3xx) 모두 진위확인 체크함
	If sRSPNTYPECODE <> "R" Then
		if Len(g_ImgData) < 102400 then	'이미지 최대사이즈 
			DATAMANAGER.RequestTranData("obaci_acct_158a")
		end if	
	Else
		sRSPNTYPECODE = ""
		g_BIORetry = 0 '초기화
		DATAMANAGER.RequestTranData("obtss_idvs_001a") 
		'Form.SetTimerEvent("1", 1, 30) '1:Set
	End If

End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	Select Case szTranID
		Case "obaci_acct_158a"
			
			DATAMANAGER.SetDataValue( 0, "obaci_acct_158a", "InBlock1", "ATCH_FILE_SIZE"		, 0 	, g_ImgDataLen 				) 
			DATAMANAGER.SetDataValue( 0, "obaci_acct_158a", "InBlock1", "UI_IMG_DATA"		, 0 	, g_ImgData 					) 
			DATAMANAGER.SetDataValue( 0, "obaci_acct_158a", "InBlock1", "IDNTF_KIND_CODE"		, 0 	, g_IDNTF_CODE 				) 
			
			DATAMANAGER.SetDataValue( 0, "obaci_acct_158a", "InBlock1", "ORGL_RCNO_PIP"		, 0 	, g_BDM_RCNO_PIP				)
			DATAMANAGER.SetDataValue( 0, "obaci_acct_158a", "InBlock1", "BRDT"  				, 0 	, Container0.EditRcno.caption	) 
			DATAMANAGER.SetDataValue( 0, "obaci_acct_158a", "InBlock1", "MDAF_RCNO_PIP"		, 0 	, g_RCNO_7 	 				)
	Case "obaci_acct_049c"
			
			DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock1", "REG_UNIQ_NO" 		, 0 , g_BDM_REG_UNIQ_NO	)
			DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock1", "REG_STAG_CLS_CODE"	, 0 , "1")
			
			DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock3", "OTSD_TR_UNIQ_NO"		, 0 , g_OTSDTRUNIQNO		)
			DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock3", "TR_DATE"				, 0 , g_TR_DATE			)
			DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock3", "IDNTF_SRNO"			, 0 , Container0.EditSRNO.caption		)
			
			if ChkButton0.checkstate = "1" or ChkButton0.checkstate = 1 then  'JMY TEST Skip
				DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock3", "RSPN_TYPE_CODE"	, 0 , "T")
			else
				DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock3", "RSPN_TYPE_CODE"	, 0 , sRSPNTYPECODE		)
			end if
			
			DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock3", "IDNTF_TORF_YN"		, 0 , g_IDNTF_TORF_YN		)
			DATAMANAGER.SetDataValue(0, "obaci_acct_049c", "InBlock3", "IDNTF_IMG_DATA_SIZE"	, 0 , g_FEATURE_LEN		)

	Case "obcsb_nmet_102c"
			
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock1", "NMET_BSWR_CLCD" 		, 0 , g_NMETBSWRGB	)
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock1", "REG_UNIQ_NO" 		, 0 , g_BDM_REG_UNIQ_NO	)
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock1", "BSWR_CLS_CODE"		, 0 , "2")	'2.신분증진위확인
			
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock3", "OTSD_TR_UNIQ_NO"		, 0 , g_OTSDTRUNIQNO		)
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock3", "TR_DATE"				, 0 , g_TR_DATE			)
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock3", "IDNTF_SRNO"			, 0 , Container0.EditSRNO.caption		)
			
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock3", "RSPN_TYPE_CODE"		, 0 , sRSPNTYPECODE		)
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock3", "IDNTF_TORF_YN"		, 0 , g_IDNTF_TORF_YN		)
			DATAMANAGER.SetDataValue(0, "obcsb_nmet_102c", "InBlock3", "IDNTF_IMG_DATA_SIZE"	, 0 , g_FEATURE_LEN		)
		
	'신분증 진위확인 SVC CALL
	Case "obtss_idvs_001a"			
			
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "IDNTF_CLS_CODE"       	, 0 	, g_IDNTF_CLS_CODE			)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "RCNO_PIP"                	, 0 	, g_AFT_RCNO_PIP				)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "ORGL_RCNO_PIP"           	, 0 	, g_RCNO_PIP					)
			
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "IDNTF_FLNM"           	, 0 	, Container0.EditName.caption	)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "ORGL_IDNTF_FLNM"      	, 0 	, g_NAME						)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "ISNC_DATE_PIP"            , 0 	, Container0.EditIssueDate.caption	)
			
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "ORGL_ISNC_DATE_PIP"       , 0 	, g_ISSU_DATE					)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "OLD_DRVN_LCNS_NO_PIP"     , 0 	, g_LISENCE_NUM 				)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "ORGL_OLD_DRVN_LCNS_NO_PIP", 0 	, g_LISENCE_NUM   			)
			
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "IDNTF_SPFT_VLTN_SCOR" 	, 0 	, g_FEATURE_SCORE				)
			
			'10:비대면모바일
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "NMET_CLS_CODE"        	, 0 	, "10" 						)
			
			'TEST 용. 금융결제원 연결전까지 SVCD 에 응답코드를 입력하면 해당응답코드로 service return
			'DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "SVCD"                 	, 0 	, "000" 						) 
		
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "ATCH_FILE_SIZE"       	, 0 	, g_FEATURE_LEN 				)
			DATAMANAGER.SetDataValue( 0, "obtss_idvs_001a", "InBlock1", "UI_PHTG_DATA_CNTT"     	, 0 	, g_FEATURE					)
	
	'신분증 특징점 저장 TR 호출 
	Case "obaci_acct_234a"	
			
			DATAMANAGER.SetDataValue( 0, "obaci_acct_234a", "InBlock1", "REG_STAG_CLS_CODE"		, 0  , "1"				)
			DATAMANAGER.SetDataValue( 0, "obaci_acct_234a", "InBlock1", "REG_UNIQ_NO"			, 0  , g_BDM_REG_UNIQ_NO	)
			DATAMANAGER.SetDataValue( 0, "obaci_acct_234a", "InBlock1", "ATCH_FILE_SIZE"			, 0  , g_FEATURE_LEN		)
			DATAMANAGER.SetDataValue( 0, "obaci_acct_234a", "InBlock1", "UI_PHTG_DATA_CNTT"		, 0  , g_FEATURE			)
		
	'v0001 진위확인오류내역 
	Case "obaci_idvs_003a"
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_TORF_CNFR_RSLT_CLCD", 0  , sRSPNTYPECODE 	                )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "RCNO_PIP"                 , 0  , g_AFT_RCNO_PIP	                )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_TORF_CNFR_RCNO_PIP" , 0  , g_AFT_RCNO_PIP                  )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_CLS_CODE"           , 0  , g_IDNTF_CLS_CODE                )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ORGL_RCNO_PIP"            , 0  , g_RCNO_PIP                      )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_FLNM"           	, 0  , Container0.EditName.caption     )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ORGL_IDNTF_FLNM"      	, 0  , g_NAME                          )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ISNC_DATE_PIP"            , 0  , Container0.EditIssueDate.caption)
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ORGL_ISNC_DATE_PIP"       , 0  , g_ISSU_DATE                     )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "OLD_DRVN_LCNS_NO_PIP"     , 0  , g_LISENCE_NUM                   )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "ORGL_OLD_DRVN_LCNS_NO_PIP", 0  , g_LISENCE_NUM                   )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_SPFT_VLTN_SCOR" 	, 0  , g_FEATURE_SCORE                 )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "TR_DATE"         		, 0  , g_TR_DATE                       )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "OTSD_TR_UNIQ_NO" 		, 0  , g_OTSDTRUNIQNO                  )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "IDNTF_TORF_YN" 			, 0  , g_IDNTF_TORF_YN                 )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1", "SCR_TYPE_CLS_CODE" 		, 0  , "1"                             )
			DATAMANAGER.SetDataValue( 0, "obaci_idvs_003a", "InBlock1",  "REG_UNIQ_NO" 			, 0  , g_BDM_REG_UNIQ_NO	           )
	
	End Select
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obaci_acct_158a" then
		
	'JMY Sta ---------------------------------------
	'비대면계좌개설(100), 비대면업무신청(0xx), 모바일OTP(3xx) 모두 진위확인 체크함
		g_AFT_RCNO_PIP = DATAMANAGER.GetDataValue(0, "obaci_acct_158a" , "OutBlock1" , "MDAF_RCNO_PIP" , 0)
		g_BIORetry = 0 '초기화
		sRSPNTYPECODE = ""
		DATAMANAGER.RequestTranData("obtss_idvs_001a") 
		'Form.SetTimerEvent("1", 1, 30)
			
	Elseif szTranID = "obaci_acct_049c" then 
		
		g_BDM_REG_STAG_CLS_CODE = DATAMANAGER.GetDataValue(0, "obaci_acct_049c" , "OutBlock1" , "REG_STAG_CLS_CODE", 0)	'등록단계구분코드
		g_BDM_REG_UNIQ_NO 	 = DATAMANAGER.GetDataValue(0, "obaci_acct_049c" , "OutBlock1" , "REG_UNIQ_NO"      , 0)	'등록고유번호
		
		'공유변수 설정
		User_SharedData_Set()
		
		DATAMANAGER.RequestTranData("obaci_acct_234a") 
	
	Elseif szTranID = "obcsb_nmet_102c" then
		g_BDM_REG_STAG_CLS_CODE = ""	'등록단계구분코드
		g_BDM_REG_UNIQ_NO 	 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "REG_UNIQ_NO"      , 0)	'등록고유번호

		'공유변수 설정
		User_SharedData_Set()

		strTitle = "알림"
		strMsg = "신분증 전송이 완료 되었습니다."
		strFlag = "complete"
		Form.OpenPopup("mbbdm85121_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")

	ElseIf szTranID = "obaci_acct_234a" Then
	
		strTitle = "알림"
		strMsg = "신분증 전송이 완료 되었습니다."
		strFlag = "complete"
		Form.OpenPopup("mbbdm85121_p1" , strTitle.."#"..strMsg.."#"..strFlag , "5")
		
	'
	ElseIf szTranID = "obtss_idvs_001a" Then 
		
		'v0008 jsi start
		'Form.SetTimerEvent("1", 0, 30) '1:Set
		g_BIOTrName	= szTranID
		g_BIORetry	= 0
		'g_TR_DATE 	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_DATE" 		, 0)
		g_OTSDTRUNIQNO = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OTSD_TR_UNIQ_NO" , 0)
		
		Form.SetTimerEvent2(2,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회
		
		
		'v0008 jsi end
	'v0008 jsi start
	ElseIf szTranID == "obtss_idvs_002a" Then	
		sCODE 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_CODE" 		, 0)
		sCNTT 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_MSG_CNTT" 	, 0)
		sRSPNTYPECODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RSPN_TYPE_CODE"	, 0) '0:정상 9:오류  8:수기허용 R:재시도
		Recv_TR_Code	= DATAMANAGER.GetDataMsgCode(szTranID)
		
		g_sRSPNMSG = DATAMANAGER.GetDataValue(0, "obtss_idvs_002a", "OutBlock1", "RSPN_MSG_CNTT" , 0)  'v0001 전역변수로 변경(sRSPNMSG -> g_sRSPNMSG)
		
		if sCODE == "6617" or Recv_TR_Code == "6617" then
			g_BIORetry = g_BIORetry + 1
			'v0009
			'if g_BIORetry >= 3 then 
			if g_BIORetry >= 21 then 
				Form.ShowAlert("알림", "등록에 실패하였습니다. 결제원 전문 처리중 오류")
				g_BIORetry = 0 '초기화
				Exit Sub 
			end if 
			
			Form.SetTimerEvent(3,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			Exit Sub 
		end if
		
		'정상
		If sRSPNTYPECODE = "0" Then 
			
			g_TR_DATE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_DATE" 		, 0)
			
			
			'Form.ShowAlert("알림", "수취일자 ::" & g_TR_DATE )
			
