'주문설정값
Dim g_szOdrPop
Dim g_szAfterInit
Dim g_szChangeInit
Dim g_szAfterOrg
Dim g_szModPrc

Dim g_szItemCode '종목코드
Dim g_szExchName '거래소명

Dim g_szType '주문유형 지정가:2, 시장가:1, STOP:3, S/L:4
Dim g_szTickSize '틱사이즈
Dim g_szDeal '해외파생매매구분코드 매수:1, 매도:2
Dim g_szJobCode '작업구분코드 정정:2, 취소:3
Dim g_szOrgNo '주문번호
Dim g_tTempData '내역 데이터
Dim g_szTempPrc '자동입력 가격
Dim g_bMicheFlag '미체결내역 클리어 플레그

Dim	g_szWarnFlag ' 주문 경고 확인플래그

g_szType = "2"
g_szTickSize = "0"
g_szOrgNo = ""
g_szTempPrc = ""
g_bMicheFlag = false
g_szWarnFlag = "N"

'============================================================================
' 주문후 초기화
'============================================================================
Function f_InputClear()
	edtOrgNo.caption = ""
	g_szOrgNo = ""
	edtCnt.caption = ""
	edtLPrc.caption = ""
	edtSPrc.caption = ""
End Function

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력
	
	'20200331 HWG START : 고유MTS
	g_szModPrc     = Form.LoadConfigData("SET_ORDER", "AUTO_FUTOPT_MODPRC")		' 정정주문가격 자동입력
	'20200331 HWG END
	
	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170726 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170726 HAMWG END

	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	' 정정주문가격 자동입력(기본값 : 사용하지 않음)
	if Trim(g_szModPrc) = "" then
		g_szModPrc = "0"		
	end if
End Function

'============================================================================
' Open_ConfirmPopup
'============================================================================
Function Open_ConfirmPopup()
	Dim szData
	
	'20200331 HWG START : 고유MTS
	szData = Form.GetCtlProp("#edtFundCd", "caption")							' 펀드코드
	szData = szData & "|" & Form.GetCtlProp("#lblFundNm", "caption")			' 펀드명
	szData = szData & "|" & g_szItemCode										' 종목코드
	szData = szData & "|" & Form.GetItemCodeInfo(g_szItemCode, "name")			' 종목명
	if g_szJobCode = "2" then
		szData = szData & "|" & rdoType.GetRadioCaption(rdoType.currentindex)	' 주문구분
		'기간
		if rdoDG.currentindex = "0" then
			szData = szData & "|" & "DAY"
		elseif rdoDG.currentindex = "1" then
			szData = szData & "|" & "GTD"
			if cldGTD.caption <> "" and Len(cldGTD.caption) = 8 then
				szData = szData & " (" & Mid(cldGTD.caption,1,4)
				szData = szData & "/" & Mid(cldGTD.caption,5,2)
				szData = szData & "/" & Mid(cldGTD.caption,7,2) & "까지)"
			end if
		end if
		szData = szData & "|" & edtLPrc.caption								' 주문가격
		szData = szData & "|" & edtSPrc.caption								' 조건가격
	end if
	szData = szData & "|" & edtCnt.caption									' 주문수량
	szData = szData & "|" & CInt(Mid(g_szOrgNo,7))							' 주문번호
	
	if g_szJobCode = "2" then '정정
		Form.OpenPopup("nbnts03000_p5", szData , "")		' 주문확인팝업 오픈
	elseif g_szJobCode = "3" then '취소
		Form.OpenPopup("nbnts03000_p6", szData , "")		' 주문확인팝업 오픈
	end if
	'20200331 HWG END
End Function

'============================================================================
Sub Form_OnFormInit()
	' 에디트 폰트 크기 자동 조정 체크시 안드로이드에서 힌트글자가 작아져서 초기화 넣어줌
	edtCnt.caption = ""
	edtLPrc.caption = ""
	edtSPrc.caption = ""
	
	Load_OrderSet() '주문설정값 읽어오기
	
	Dim szItemCode
	szItemCode = Form.GetSharedData("&ITEM_GLOBAL_FUTOPT", 0) '최근조회종목
	
	if szItemCode <> "" then
		f_FormStart(szItemCode)
	end if
End Sub

'============================================================================
' 주문내역 셋팅
'============================================================================
Function f_SetOrgNo()
	if g_tTempData <> nil and UBound(g_tTempData) > 0 then
		g_szItemCode = g_tTempData(0)
		g_szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname")
		g_szTickSize = Form.GetItemCodeInfo( g_szItemCode , "ticksize")
		g_szDeal = g_tTempData(1)
		
		if g_szAfterOrg == "1" then			' 주문번호 연동
			Form.SetCtlProp("#edtOrgNo", "caption", g_tTempData(2))
		end if
		g_szOrgNo = g_tTempData(2)
		edtOrgNo.caption = CInt(Mid(g_szOrgNo,7))
		if g_tTempData(3) = "2" then
			rdoType.currentindex = "0"
			rdoType_OnClick(0)
		elseif g_tTempData(3) = "1" then
			rdoType.currentindex = "1"
			rdoType_OnClick(1)
		elseif g_tTempData(3) = "3" then
			rdoType.currentindex = "2"
			rdoType_OnClick(2)
		elseif g_tTempData(3) = "4" then
			rdoType.currentindex = "3"
			rdoType_OnClick(3)
		elseif g_tTempData(3) = "5" then
			rdoType.currentindex = "4"
			rdoType_OnClick(4)
		end if
		edtCnt.caption = g_tTempData(4)
		edtLPrc.caption = ""
		edtSPrc.caption = ""
		if g_szType = "2" or g_szType = "4" then
			if g_szModPrc = "0" then
				edtLPrc.caption = g_tTempData(5)
			else
				Form.triggerEvent("#", "AUTO_PRICE", "")
			end if
		end if
		if g_szType = "3" or g_szType = "4" then
			if g_szModPrc = "0" then
				edtSPrc.caption = g_tTempData(6)
			else
				Form.triggerEvent("#", "AUTO_PRICE", "")
			end if
		end if
		if g_tTempData(7) = "0" then
			rdoDG.currentindex = "0"
		elseif g_tTempData(7) = "6" then
			rdoDG.currentindex = "1"
		end if
		cldGTD.caption = g_tTempData(8)
		
		ReDim g_tTempData
	end if
End Function

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "HOGA" then	'메인화면의 호가 클릭시
		if g_szOrgNo <> "" then
			if Trim(sParam) <> "" then
				f_SetPrc(sParam) '가격셋팅
			end if
		end if
	
	elseif sEventName == "AUTO_PRICE" then '자동가격입력
		if Trim(sParam) <> "" and edtOrgNo.caption <> "" and g_szModPrc <> "0" then
			if g_szType = "2" or g_szType = "4" then
				edtLPrc.caption = sParam
			end if
			if g_szType = "3" or g_szType = "4" then
				edtSPrc.caption = sParam
			end if
		end if
		
	elseif sEventName == "CONTRACT" then '미체결팝업 리턴
		if Trim(sParam) <> "" then
			g_tTempData = Split(sParam, "★")
			
			if UBound(g_tTempData) > 0 then
				if g_szItemCode <> g_tTempData(0) then
					g_bMicheFlag = true
					Form.SetItemCode(g_tTempData(0)) '상단헤더에 종목코드 셋팅
					exit sub
				end if
				
				f_SetOrgNo() '주문내역 셋팅
			end if
		end if
		
	elseif sEventName = "AFTER_ORGNO" then '주문번호 연동
		if g_szAfterOrg == "1" then	
			g_szOrgNo = Form.GetCtlProp("#edtOrgNo", "caption")
			edtOrgNo.caption = CInt(Mid(g_szOrgNo,7))
			
			if Len(Form.GetCtlProp("#acnt", "caption")) < 10 then
				exit sub
			end if
	
			if g_szOrgNo <> "" then
				if g_szExchName <> "" then
					DATAMANAGER.RequestTranData( "obtrd_oder_522r" ) '주문체결내역 조회
				end if
			end if
		end if
		
	elseif sEventName = "CHANGE_FUNDCD" then '계좌번경	'20200331 HWG : 고유MTS
		f_InputClear()
		g_szType = "2"
		Form.SetCtlProp("#edtOrgNo", "caption", "")
		rdoType.currentindex = "0"
		f_LPrcEnable(false) '주문가격 활성 셋팅
		f_SPrcEnable(false) '조건가격 활성 셋팅
		rdoDG_OnClick(0)
		cldGTD.caption = Form.GetSharedData("&HOST_DATE", false )
		cldGTD.visible = false
		
	end if
End Sub

'============================================================================
' 가격 셋팅
' sParam : 셋팅가격
'============================================================================
Function f_SetPrc(sParam)
	edtLPrc.caption = ""
	edtSPrc.caption = ""
	
	if tonumber(sParam) > 0 then
		'지정가, S/L 주문가격 셋팅
		if g_szType = "2" or g_szType = "4" then
			edtLPrc.caption = sParam
		end if
		
		'STOP, S/L 조건가격 셋팅
		if g_szType = "3" or g_szType = "4" then
			edtSPrc.caption = sParam
		end if
	end if
End Function

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		Dim szItemCode
		szItemCode = g_szItemCode
		
		f_FormStart(sValue)
		if sValue = szItemCode or g_bMicheFlag = true then
			f_SetOrgNo() '주문내역 셋팅
		else
			Form.SetCtlProp("#edtOrgNo", "caption", "")
			f_InputClear()
			rdoType.currentindex = "0"
			f_LPrcEnable(false) '주문가격 활성 셋팅
			f_SPrcEnable(false) '조건가격 활성 셋팅
		end if
		
		g_bMicheFlag = false
	end if
End Sub

'============================================================================
'화면 시작
'============================================================================
Function f_FormStart(szItemCode)
	if szItemCode <> "" then
		if g_szChangeInit == "1" then '종목변경시 인풋항목 초기화
			f_InputClear()
		end if
		
		g_szTickSize = "0"
		g_szItemCode = szItemCode
		g_szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname")
		g_szTickSize = Form.GetItemCodeInfo( g_szItemCode , "ticksize")
	end if
end Function

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtrd_oder_522r" then '주문체결내역 조회
		DATAMANAGER.SetDataValue( false, "obtrd_oder_522r", "InBlock1", "ACNO" , 0 , "0000" & Form.GetCtlProp("#edtFundCd", "caption") ) '펀드코드	'20200331 HWG : 고유MTS
		DATAMANAGER.SetDataValue( false, "obtrd_oder_522r", "InBlock1", "ASNO" , 0 , "51" ) '일련번호	'20200331 HWG : 고유MTS
		DATAMANAGER.SetDataValue( false, "obtrd_oder_522r", "InBlock1", "FUTS_OPTN_CLCD" , 0 , "A" ) '선물옵션구분코드 A:전체, F:선물, O:옵션
		DATAMANAGER.SetDataValue( false, "obtrd_oder_522r", "InBlock1", "PROS_CLS_CODE" , 0 , "A" ) '처리구분코드 A:전체, 1:미체결, 2:체결
		DATAMANAGER.SetDataValue( false, "obtrd_oder_522r", "InBlock1", "OVDV_ODER_NO" , 0 , g_szOrgNo ) '주문번호
		DATAMANAGER.SetDataValue( false, "obtrd_oder_522r", "InBlock1", "OVDV_DEAL_CLCD" , 0 , "A" ) '매매구분코드 A:전체, 1:매수, 2:매도
	
	'20200331 HWG START : 고유MTS
	elseif szTranID = "obfnd_oder_101c" then '주문처리
		DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "JOB_CLS_CODE" , 0 , g_szJobCode ) '작업구분코드 신규:1, 정정:2, 취소:3
'		DATAMANAGER.SetDataValue( false, "obtrd_oder_101c", "InBlock1", "ACNO" , 0 , Form.GetCtlProp("#acnt", "total") ) '계좌번호
'		DATAMANAGER.SetDataValue( false, "obtrd_oder_101c", "InBlock1", "ASNO" , 0 , Form.GetCtlProp("#acnt", "sequence") ) '계좌일련번호
		DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "FNCD", 0 , Form.GetCtlProp("#edtFundCd", "caption") ) '펀드코드
		DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "PWD" , 0 , Form.GetCtlProp("#edtPwd", "encdata") ) '계좌비밀번호
		DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "ORGL_OVDV_ODER_NO" , 0 , g_szOrgNo ) '주문번호
		DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "FISCD" , 0 , g_szItemCode ) '해외종목코드
		DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "OVDV_DEAL_CLCD" , 0 , g_szDeal ) '해외파생매매구분코드 매수:1, 매도:2
		DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "STTG_ODER_CLCD" , 0 , "0" ) '전략주문구분코드 일반:0, IFD:1, IFO:2, OCO:3
		DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "ODER_TPCD" , 0 , g_szType ) '주문유형코드
		'해외파생주문구분코드 DAY:0, GTC:1, GTD:6
		if rdoDG.currentindex = "0" then
			DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "OVDV_ODER_CLCD" , 0 , "0" )
		elseif rdoDG.currentindex = "1" then
			DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "OVDV_ODER_CLCD" , 0 , "6" )
		end if
		DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "ODQT" , 0 , edtCnt.caption ) '주문수량
		'지정가, 시장가, S/L인경우 주문해외가격 셋팅
		if g_szType = "2" or g_szType = "1" or g_szType = "4" then
			DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "ODER_FPRC" , 0 , edtLPrc.caption )
		end if
		'STOP, S/L인경우 거래소손절매해외가격 셋팅
		if g_szType = "3" or g_szType = "4" then
			DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "EXCH_STPS_FPRC" , 0 , edtSPrc.caption )
		end if
		'유효일자
		if rdoDG.currentindex = "1" then
			DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "VALD_DATE" , 0 , cldGTD.caption )
		end if
		DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "OPTN_BYOV_EXRC_YN" , 0 , "N" ) '옵션매수행사예약여부
		DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "OVDV_HEDG_CLCD" , 0 , "1" ) '해외파생헷지구분코드 Net:1, Hedge:2
		DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "WARN_CNFR_YN" , 0 , g_szWarnFlag ) '경고확인여부
		DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "ODER_OCRN_TYPE_CODE" , 0 , "00" ) '주문발생유형코드 일반주문:00
		DATAMANAGER.SetDataValue( false, "obfnd_oder_101c", "InBlock1", "PRC_STUP_CLCD" , 0 , "P" ) '가격설정구분 P:가격, T:TICK수
'		DATAMANAGER.SetDataValue( false, "obtrd_oder_101c", "InBlock1", "PSNT_FPRC" , 0 , LTrim(Form.GetCtlProp("#lblHyun", "caption")) ) '현재해외가격
'		DATAMANAGER.SetDataValue( false, "obtrd_oder_101c", "InBlock1", "PROS_SRNO" , 0 , "0" ) '처리일련번호
	'20200331 HWG END	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtrd_oder_522r" then '주문체결내역 조회
		Dim nCount
		nCount = DATAMANAGER.GetDataCount( false, "obtrd_oder_522r", "OutBlock1" )
		
		if nCount > 0 then
			Dim szOvdvCode
			
			g_szDeal = DATAMANAGER.GetDataValue( false, "obtrd_oder_522r", "OutBlock1", "OVDV_DEAL_CLCD" , 0 ) '매매구분코드 1:매수, 2:매도
			g_szType = DATAMANAGER.GetDataValue( false, "obtrd_oder_522r", "OutBlock1", "ODER_TPCD" , 0 ) '주문유형코드 1:시장가, 2:지정가, 3:STOP, 4:S/L
			if g_szType = "2" then
				rdoType.currentindex = "0"
				rdoType_OnClick(0)
			elseif g_szType = "1" then
				rdoType.currentindex = "1"
				rdoType_OnClick(1)
			elseif g_szType = "3" then
				rdoType.currentindex = "2"
				rdoType_OnClick(2)
			elseif g_szType = "4" then
				rdoType.currentindex = "3"
				rdoType_OnClick(3)
			end if
			edtCnt.caption = DATAMANAGER.GetDataValue( false, "obtrd_oder_522r", "OutBlock1", "ODER_RSQN" , 0 ) '주문잔량
			
			if g_szType = "2" or g_szType = "4" then
				if g_szModPrc = "0" then
					edtLPrc.caption = DATAMANAGER.GetDataValue( false, "obtrd_oder_522r", "OutBlock1", "ODER_FPRC" , 0 ) '주문가격
				else
					Form.triggerEvent("#", "AUTO_PRICE", "")
				end if
			end if
			if g_szType = "3" or g_szType = "4" then
				if g_szModPrc = "0" then
					edtSPrc.caption = DATAMANAGER.GetDataValue( false, "obtrd_oder_522r", "OutBlock1", "EXCH_STPS_FPRC" , 0 ) '조건가격
				else
					Form.triggerEvent("#", "AUTO_PRICE", "")
				end if
			end if
			szOvdvCode = DATAMANAGER.GetDataValue( false, "obtrd_oder_522r", "OutBlock1", "OVDV_ODER_CLCD" , 0 ) '해외파생주문구분코드 0:DAY, 6:GTD
			if szOvdvCode = "0" then
				rdoDG.currentindex = "0"
			elseif szOvdvCode = "6" then
				rdoDG.currentindex = "1"
			end if
			cldGTD.caption = DATAMANAGER.GetDataValue( false, "obtrd_oder_522r", "OutBlock1", "ODER_FIN_DATE" , 0 )
		end if
		
	'20200331 HWG START : 고유MTS	
	elseif szTranID = "obfnd_oder_101c" then '주문처리
	
		Form.Toast(0, DATAMANAGER.GetDataMsgText("obfnd_oder_101c"), true)
			
		if g_szAfterInit == "1" then		' 주문후 초기화
			f_InputClear()
		end if
		
		if g_szAfterOrg == "1" then			' 주문번호 연동
			szOrgNo = DATAMANAGER.GetDataValue(0, "obfnd_oder_101c", "OutBlock1", "OVDV_ODER_NO", 0)
			
			Form.SetCtlProp("#edtOrgNo", "caption", szOrgNo)
			Form_OnTriggerEvent("AFTER_ORGNO", "")
		else
			Form.SetCtlProp("#edtOrgNo", "caption", "")
		end if
			
'		Dim szWarnCd, szWarnMsg
'		
'		szWarnCd = DATAMANAGER.GetDataValue( false, "obtrd_oder_101c", "OutBlock1", "WARN_CLS_CODE" , 0 ) '경고구분코드 (0.정상, 1.경고, 2.보류)
'		szWarnMsg = DATAMANAGER.GetDataValue( false, "obtrd_oder_101c", "OutBlock1", "WARN_MSG_CNTT" , 0 ) '경고메시지
'		
'		if szWarnCd = "1" then '경고
'			Dim szData
'			
'			szData = "2" 													'매수도구분
'			szData = szData & "|" & Form.GetCtlProp("#acnt", "caption")			'계좌번호
'			szData = szData & "|" & Form.GetCtlProp("#acnt", "accountname") 	'계좌명
'			szData = szData & "|" & g_szItemCode 							'종목코드
'			szData = szData & "|" & Form.GetItemCodeInfo(g_szItemCode, "name")	'종목명
'			szData = szData & "|" & edtLPrc.caption 							'주문가격
'			szData = szData & "|" & edtSPrc.caption 							'조건가격
'			szData = szData & "|" & edtCnt.caption 							'주문수량
'			szData = szData & "|" & szWarnMsg 								'경고메시지
'	
'			Form.OpenPopup("mbtrd44300_p11", szData , "")		' 주문경고안내창 오픈
'	
'		elseif szWarnCd = "0" then ' 정상
'			Form.Toast(0, DATAMANAGER.GetDataMsgText("obtrd_oder_101c"), true)
'			
'			if g_szAfterInit == "1" then		' 주문후 초기화
'				f_InputClear()
'			end if
'			
'			if g_szAfterOrg == "1" then			' 주문번호 연동
'				szOrgNo = DATAMANAGER.GetDataValue(0, "obtrd_oder_101c", "OutBlock1", "OVDV_ODER_NO", 0)
'				
'				Form.SetCtlProp("#edtOrgNo", "caption", szOrgNo)
'				Form_OnTriggerEvent("AFTER_ORGNO", "")
'			else
'				Form.SetCtlProp("#edtOrgNo", "caption", "")
'			end if
'		end if

	'20200331 HWG END	
	end if
End Sub

'============================================================================
' 주문유형 선택
'============================================================================
Sub rdoType_OnClick(nIndex)
	Dim bLPrcEnable, bSPrcEnable
	
	if nIndex = 0 then '지정가
		bLPrcEnable = true '주문가격 활성
		bSPrcEnable = false '조건가격 비활성
		g_szType = "2"
		
	elseif nIndex = 1 then '시장가
		bLPrcEnable = false '주문가격 비활성
		bSPrcEnable = false '조건가격 비활성
		g_szType = "1"
		
	elseif nIndex = 2 then 'STOP
		bLPrcEnable = false '주문가격 비활성
		bSPrcEnable = true '조건가격 활성
		g_szType = "3"
		
	elseif nIndex = 3 then 'S/L
		bLPrcEnable = true '주문가격 활성
		bSPrcEnable = true '조건가격 활성
		g_szType = "4"
		
	end if
	
	f_LPrcEnable(bLPrcEnable) '주문가격 활성 셋팅
	f_SPrcEnable(bSPrcEnable) '조건가격 활성 셋팅
End Sub

'============================================================================
' 주문가격 활성 셋팅
'============================================================================
Function f_LPrcEnable(bValue)
	btnLPrcSelect.enable = bValue
	edtLPrc.enable = bValue
	btnLPrcMinus.enable = bValue
	btnLPrc.enable = bValue
	btnLPrcPlus.enable = bValue
End Function

'============================================================================
' 조건가격 활성 셋팅
'============================================================================
Function f_SPrcEnable(bValue)
	btnSPrcSelect.enable = bValue
	edtSPrc.enable = bValue
	btnSPrcMinus.enable = bValue
	btnSPrc.enable = bValue
	btnSPrcPlus.enable = bValue
End Function

'============================================================================
' 계좌 비밀번호 체크
'============================================================================
Function f_CheckAccount()
	if Len(Form.GetCtlProp("#edtFundCd", "caption")) < 4 then	'20200331 HWG : 고유MTS
		Form.ShowAlert("알림", "펀드코드를 확인후 다시 입력하십시오.")
		return false
		
	elseif Trim(Form.GetCtlProp("#edtPwd", "caption")) = "" then
		Form.ShowAlert("알림", "비밀번호를 확인후 다시 입력하십시오.")
		return false
		
	end if
	
	return true
End Function

