	end if
End Sub

'============================================================================
' 정정
'============================================================================
Sub btnMod_OnClick()
	if f_CheckAccount() = false then
		Exit Sub
	end if
	
	if g_szItemCode = "" then
		Form.ShowAlert("알림", "종목코드를 입력하십시요.")
		Exit Sub
	end if
	
	if Trim(edtOrgNo.caption) == "" then
		Form.ShowAlert("알림", "원주문번호를 확인하십시요.")
		Exit Sub
	end if
	
	if Trim(edtCnt.caption) = "" or Trim(edtCnt.caption) = "0" then
		Form.ShowAlert("알림", "주문수량을 확인하십시요.")
		Exit Sub
	end if
	
	if g_szType <> "1" then '시장가가 아닌 경우
		if Trim(edtLPrc.caption) = "" then 'or Trim(edtLPrc.caption) = "0" or Trim(edtLPrc.caption) = "0.00" then
			'지정가, S/L인 경우
			if g_szType = "2" or g_szType = "4" then
				Form.ShowAlert("알림", "주문가격을 입력하십시요.")
				Exit Sub
			end if
		end if
		
		if Trim(edtSPrc.caption) = "" then 'or Trim(edtSPrc.caption) = "0" or Trim(edtSPrc.caption) = "0.00" then
			'STOP, S/L인 경우
			if g_szType = "3" or g_szType = "4" then
				Form.ShowAlert("알림", "조건가격을 입력하십시요.")
				Exit Sub
			end if
		end if
		
		'STOP인 경우
		if g_szType = "3" or g_szType = "4" then
			'S/L인 경우
			if g_szType = "4" then
				if g_szDeal = "1" then '매수
					if tonumber(edtLPrc.caption) < tonumber(edtSPrc.caption) then
						Form.ShowAlert("알림", "주문가격은 조건가격보다 같거나 커야 합니다.")
						Exit Sub
					end if
				elseif g_szDeal = "2" then '매도
					if tonumber(edtLPrc.caption) > tonumber(edtSPrc.caption) then
						Form.ShowAlert("알림", "주문가격은 조건가격보다 같거나 작아야 합니다.")
						Exit Sub
					end if
				end if
			end if
			
			if g_szDeal = "1" then '매수
				if tonumber(edtSPrc.caption) < tonumber(Form.GetCtlProp("#lblHyun", "caption")) then
					Form.ShowAlert("알림", "조건가격은 현재가보다 같거나 커야 합니다.")
					Exit Sub
				end if
			elseif g_szDeal = "2" then '매도
				if tonumber(edtSPrc.caption) > tonumber(Form.GetCtlProp("#lblHyun", "caption")) then
					Form.ShowAlert("알림", "조건가격은 현재가보다 같거나 작아야 합니다.")
					Exit Sub
				end if
			end if
		end if
		
	else '시장가
		
	end if
	
	g_szJobCode = "2" '정정
	g_szWarnFlag = "N" '주문착오방지 플래그 N으로 초기화
	
	' 주문확인창 오픈여부
	if g_szOdrPop == "1" then
		Open_ConfirmPopup()
	else
		'20200331 HWG START : 고유MTS
		DATAMANAGER.ClearInputData( false, "obfnd_oder_101c" )
		DATAMANAGER.ClearOutputData( false, "obfnd_oder_101c" )
		if g_szExchName <> "" then
			DATAMANAGER.RequestTranData( "obfnd_oder_101c" ) '주문처리
		end if
		'20200331 HWG END
	end if
End Sub

'============================================================================
' 취소
'============================================================================
Sub btnCnl_OnClick()
	if f_CheckAccount() = false then
		Exit Sub
	end if
	
	if g_szItemCode = "" then
		Form.ShowAlert("알림", "종목코드를 입력하십시요.")
		Exit Sub
	end if
	
	if Trim(edtOrgNo.caption) == "" then
		Form.ShowAlert("알림", "원주문번호를 입력하십시요.")
		Exit Sub
	end if
	
	g_szJobCode = "3" '취소
	g_szWarnFlag = "N" '주문착오방지 플래그 N으로 초기화
	
	' 주문확인창 오픈여부
	if g_szOdrPop == "1" then
		Open_ConfirmPopup()
	else
		'20200331 HWG START : 고유MTS
		DATAMANAGER.ClearInputData( false, "obfnd_oder_101c" )
		DATAMANAGER.ClearOutputData( false, "obfnd_oder_101c" )
		if g_szExchName <> "" then
			DATAMANAGER.RequestTranData( "obfnd_oder_101c" ) '주문처리
		end if
		'20200331 HWG END
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "LIMIT_PRC" then '주문가격 리턴
		edtLPrc.caption = sRet
		
	elseif sKeyName = "STOP_PRC" then '조건가격 리턴
		edtSPrc.caption = sRet
		
	elseif sKeyName = "ODER" then '주문확인창 리턴
		'20200331 HWG START : 고유MTS
		DATAMANAGER.ClearInputData( false, "obfnd_oder_101c" )
		DATAMANAGER.ClearOutputData( false, "obfnd_oder_101c" )
		if g_szExchName <> "" then
			DATAMANAGER.RequestTranData( "obfnd_oder_101c" ) '주문처리
		end if
'	elseif sKeyName = "WARN_ODER" then '주문경고안내창 리턴
'		g_szWarnFlag = "Y"
'		DATAMANAGER.RequestTranData( "obtrd_oder_101c" ) '주문처리
		'20200331 HWG END
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert("알림", "[TR]" & szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert("알림", "[TR]" & szErrMsg)
	end if
End Sub

'============================================================================
' 미체결 팝업
'============================================================================
Sub btnMiche_OnClick()
	if Len(Form.GetCtlProp("#edtFundCd", "caption")) < 4 then	'20200331 HWG : 고유MTS
		Form.ShowAlert("알림", "펀드코드를 확인후 다시 입력하십시오.")
		Exit Sub
	end if
	
	Form.triggerEvent("#", "CONTRACT_OPEN", "")
End Sub

