'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim szURL

	szURL = "http://dmcmobile.koscom.co.kr/meritz/clause_privacy.html"
	
	web01.viewtype = 0
	web01.urlpath = szURL
	
	Form.SetScreenName("개인정보제공 및 활용동의")
End Sub
'============================================================================
Sub btnOk01_OnClick()
	if chkAgree01.checkstate <> "1" then
		Form.ShowAlert("알림", "내용에 동의해주세요")
	else
		Form.SendReturnToParent("PRIVACYAGREE", sData)
		Form.CloseForm()
	end if 
End Sub

