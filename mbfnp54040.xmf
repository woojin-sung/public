'============================================================================
' 01. 화 면 명 : 채권잔고
' 02. 화면설명 : 채권잔고
' 03. 작    성 : 2016.1.14 하원만
'		      : 2022.03.22 김유경 : 예금자보호법 관련 안내 문구 추가
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAcNo	  '계좌번호 8자리
Dim g_nAsNo	  '계좌 일련번호 2자리
Dim g_szItemCode
Dim g_szData

Dim g_GrdIndex 
g_GrdIndex = 0
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()

	Form.transmode = True
	DATAMANAGER.RequestTranData("obtrs_comn_314r")

End Sub

'============================================================================
'출력 Data 초기화
Sub Output_Data_Clear()
	
    '그리드 초기화
	grdList.ClearAllData( )
	grdList.DeleteAllRow( )

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obtrs_comn_314r" then
		g_GrdIndex = 0
		
		g_nAcNo = cmbAcnt.total    'Left( cmbAccount.caption, 8)
		g_nAsNo = cmbAcnt.sequence 'Right( cmbAccount.caption, 2)

		DATAMANAGER.SetDataValue(0, "obtrs_comn_314r", "InBlock1", "ACNO", 0 , g_nAcNo)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_314r", "InBlock1", "ASNO", 0 , g_nAsNo)

	End if
	
End Sub

'============================================================================
Sub btnSearch_OnClick()
	
	Call Output_Data_Clear()
	DATAMANAGER.RequestTranData("obtrs_comn_314r")	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obtrs_comn_314r" then

		Dim iCnt, sCode, sCodeName, iDataCount
		iDataCount = DATAMANAGER.GetDataCount( 0, "obtrs_comn_314r", "OutBlock1" )

		For iCnt = 0 To iDataCount - 1

			sCode = DATAMANAGER.GetDataValue( 0, "obtrs_comn_314r", "OutBlock1", "OVRL_SPTX_CLS_CODE", iCnt )
			sName = Form.GetMetaData( "종합분리과세구분코드", sCode )
			grdList.SetCellData( "bd_cell9", ( (grdList.rowcount - iDataCount) + iCnt), sName )

		Next
		
		szCode = grdList.GetCellData("bd_cell8", g_GrdIndex)
	    if szCode <> "" then
		    DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "B")
		    DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD", 0 , szCode)
		    
		    DATAMANAGER.RequestTranData("ohhts_7052_001r")
		end if
	elseif szTranID = "ohhts_7052_001r" then
		
		szSrfcMnrt = DATAMANAGER.GetDataValue(0, "ohhts_7052_001r", "OutBlock1", "FID_SRFC_MNRT" , 0 )
		grdList.SetCellData("bd_cell13", g_GrdIndex, szSrfcMnrt)

		if Cint(g_GrdIndex) < Cint(grdList.rowcount) then
		    g_GrdIndex = g_GrdIndex + 1
		    
		    szCode = grdList.GetCellData("bd_cell8", g_GrdIndex)
		    if szCode <> "" then
			    DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "B")
			    DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD", 0 , szCode)
			    
			    DATAMANAGER.RequestTranData("ohhts_7052_001r")
			end if
		end if
	end if
	
End Sub

'============================================================================
Sub cmbAcnt_ChangeAccount()
	
	btnSearch_OnClick()
	
End Sub

'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)  

	if sEventName == "CHANGE_ORIENTATION" then
		Form.OpenPopup("mbfnp54040_h1", "" , "")
	elseif sEventName == "SCREEN_MENU" then
		if sParam == "SHA_SNS" then
			Dim szTmp
			szTmp = ""
			Form.OpenDialog("sharesns1" , "0", "")
		end if
	end if 

End Sub

