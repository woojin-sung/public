'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "mbfnp54040_h1" then
		
		if sRet ~= "" then
			cmbAcnt.caption = sRet
			btnSearch_OnClick()
		End if
		
	elseIf sKeyName == "MOVEPOP_RETURN"	then
		
		Dim szListItems
		szListItems = split(sRet,"★")
		
		if 	szListItems(1) == "1"	then			'정정
			
			if g_szData ~= "" then
				Form.OpenScreen("54020" , "채권잔고" & "★" & "1" & "★" & g_szData ) 
			end if
			
		end if
		
		g_szData = ""
	elseif sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else
			Form.triggerEvent("linkfmHoga", "sharedata", "")
		End If
	end if
End Sub


'============================================================================
Sub grdList_OnScrollEnd()
	
	DATAMANAGER.RequestNextData( "obtrs_comn_314r" )
	
End Sub

'============================================================================
Sub Form_OnRefresh()

	btnSearch_OnClick()

End Sub

