	<SCRIPT_INFO _len="5174" _ulen="5088" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주식현재가
' 02. 화면설명 : 주식현재가 신용탭
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
Function RequestData()
	If rdo0.currentindex = "2" Then
		DATAMANAGER.RequestTranData( "ohhts_1152_001r" )
	Else
		DATAMANAGER.RequestTranData( "ohhts_1146_001r" )
	End If
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket	= Form.GetItemCodeInfo( g_szItemCode , "market")
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket	= Form.GetItemCodeInfo( g_szItemCode , "market")
		
		RequestData()
	end	if	
End Sub

'============================================================================
Sub Form_OnFormInit()
	szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
	if szDeviceOS == "1" then '안드로이드
		lblFrom.setNeighborCtlPos(cldFrom, "left", 1, "") '20230522 KKM 안드로이드 공통적용	
     end if	
	
	grd1.top = 50
	grd1.visible = false
	
	lblFrom.visible = fasle
	cldFrom.visible = fasle


'	DATAMANAGER.RequestTranData( "ohhts_1146_001r" )
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
'			Form.triggerEvent( "#", "REQUEST_ITEMCODE", "")
			Exit Sub
		End If
	
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		  
		rdo0_OnClick( CInt(rdo0.currentindex ) )
		
	ElseIf sEventName = "SELECT_Rdo" then
		rdo0.eventindex = sParam
		
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	If szTranID = "ohhts_1146_001r" Then
		DATAMANAGER.SetDataValue( 0, "ohhts_1146_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_1146_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode )

	ElseIf szTranID = "ohhts_1152_001r" Then
		Dim szDateFr, szDateTo
		szDateTo = Form.GetSharedData("&HOST_DATE", false )
		szDateFr = Replace( DateAdd("d", -60, Left(szDateTo, 4) & "-" & Mid(szDateTo, 5,2) & "-" & Right(szDateTo, 2)) , "-", "")
		
		DATAMANAGER.SetDataValue( 0, "ohhts_1152_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_1152_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_1152_001r", "InBlock1", "FID_INPUT_DATE1"				, 0 , cldFrom.caption)
		DATAMANAGER.SetDataValue( 0, "ohhts_1152_001r", "InBlock1", "FID_INPUT_DATE2"				, 0 , szDateTo )
		
	End If
	
End Sub

'============================================================================
Sub rdo0_OnClick(nIndex)
	
	Select Case nIndex
		Case 0				'융자
			For i=1 To 6
				grd0.SetVisibleCol( i, 1 )
				grd0.SetVisibleCol( i+6, 0 )
			Next
			
			grd0.visible = true
			grd1.visible = false
			lbl0.visible = true
			lblFrom.visible = false
			cldFrom.visible = false
			
'			DATAMANAGER.RequestTranData( "ohhts_1146_001r" )
	
		Case 1				'대주
			For i=1 To 6
				grd0.SetVisibleCol( i, 0 )
				grd0.SetVisibleCol( i+6, 1 )
			Next
			
			grd0.visible = true
			grd1.visible = false
			lbl0.visible = true
			lblFrom.visible = false
			cldFrom.visible = false
			
'			DATAMANAGER.RequestTranData( "ohhts_1146_001r" )
			
		Case 2				'공매도
			Dim szDateTo, szDateFr
			szDateTo = Form.GetSharedData("&HOST_DATE", false )
			szDateFr = Replace( DateAdd("d", -30, Left(szDateTo, 4) & "-" & Mid(szDateTo, 5,2) & "-" & Right(szDateTo, 2)) , "-", "")
			cldFrom.caption = szDateFr

			grd0.visible = false
			grd1.visible = true
			lbl0.visible = false
			lblFrom.visible = True
			cldFrom.visible = True			
			
'			DATAMANAGER.RequestTranData( "ohhts_1152_001r" )
			
	End Select

	RequestData()

End Sub




'============================================================================
Sub cldFrom_OnEditComplete()
	RequestData()	
End Sub

