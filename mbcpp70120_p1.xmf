Dim favID, favmodYMDH, favcustID, favptName, fav3ERT, favsvptname
'============================================================================
Sub Form_OnFormInitBefore()
	favID	= Form.GetSharedData("szfavID", false )
	favmodYMDH = Form.GetSharedData("szfavmodYMDH", false )
	favcustID = Form.GetSharedData("szfavcustID", false )
	favptName = Form.GetSharedData("szfaptName", false ) 
	fav3ERT = Form.GetSharedData("szfa3ERT", false ) 
	favsvptname = Form.GetSharedData("szfasvptname", false ) 
End Sub



'============================================================================
Sub Form_OnFormInit()

	Label4.caption =  favsvptname
	Label5.caption =  favptName
	Label6.caption =  fav3ERT
	
End Sub

'============================================================================

Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_018a", "InBlock1" , "PROS_CLS_CODE" , 0 , "D" )
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_018a", "InBlock1" , "CUST_ID" , 0 , favcustID )
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_018a", "InBlock1" , "PRTF_ID" , 0 , favID )
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_018a", "InBlock1" , "MOD_YMDH" , 0 , favmodYMDH )
End Sub

'============================================================================

Sub Button0_OnClick()
	DATAMANAGER.RequestTranData("obcpp_rbit_018a")
End Sub




'============================================================================
Sub Button1_OnClick()
	Form.CloseForm( )
End Sub
'============================================================================

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcpp_rbit_018a" then
		Form.CloseForm( )
		Form.SendReturnToParent( "cancel" , "" )
	end if
End Sub

