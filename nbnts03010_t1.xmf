	<SCRIPT_INFO _len="7511" _ulen="7023" >
Dim g_szACNO
Dim g_szASNO
Dim g_szFncd
Dim g_szCntgType '체결/미체결 조회타입
Dim g_szDealType '매도/매수 조회타입
Dim g_bFlag

'============================================================================
Sub Form_OnFormInit()
'	DATAMANAGER.RequestTranData( "obtrd_oder_522r" )
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "REQUEST" THEN
		if sParam <> null then
			g_szFncd = sParam
			'펀드코드 계좌조회
			DATAMANAGER.RequestTranData("obfnp_fnmt_011r")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID = "obfnp_fnmt_011r" then		
		if Trim(g_szFncd) = "" or Len(g_szFncd) < 4 Then
			Form.ShowAlert("알림", "펀드코드를 입력하십시요.")
			Exit Sub
		end if
		DATAMANAGER.SetDataValue( false, "obfnp_fnmt_011r", "InBlock1", "FNCD"	, 0, g_szFncd )
	End If
	
	if szTranID = "obfnd_oder_010r" then
		if rdoType.currentindex = "0" then
			g_szCntgType = "A"
		elseif rdoType.currentindex = "1" then
			g_szCntgType = "1"
		else
			g_szCntgType = "2"
		end if
		
		if rdoType2.currentindex = "0" then
			g_szDealType = "A"
		elseif rdoType2.currentindex = "1" then
			g_szDealType = "1"
		elseif rdoType2.currentindex = "2" then
			g_szDealType = "2"
		end if
		
'		DATAMANAGER.SetDataValue( false, "obfnd_oder_010r", "InBlock1", "ACNO" , 0 , Form.GetCtlProp("#acnt", "total") ) '계좌번호
'		DATAMANAGER.SetDataValue( false, "obfnd_oder_010r", "InBlock1", "ASNO" , 0 , Form.GetCtlProp("#acnt", "sequence") ) '계좌일련번호
'		DATAMANAGER.SetDataValue( false, "obfnd_oder_010r", "InBlock1", "PWD" , 0 , Form.GetCtlProp("#edtPwd", "encdata") ) '계좌비밀번호

		DATAMANAGER.SetDataValue( false, "obfnd_oder_010r", "InBlock1", "ACNO" , 0 , g_szACNO ) '계좌번호
		DATAMANAGER.SetDataValue( false, "obfnd_oder_010r", "InBlock1", "ASNO" , 0 , g_szASNO ) '계좌일련번호
		DATAMANAGER.SetDataValue( false, "obfnd_oder_010r", "InBlock1", "FUTS_OPTN_CLCD" , 0 , "A" ) '선물옵션구분코드 A:전체, F:선물, O:옵션
		DATAMANAGER.SetDataValue( false, "obfnd_oder_010r", "InBlock1", "PROS_CLS_CODE" , 0 , g_szCntgType ) '처리구분코드 A:전체, 1:미체결, 2:체결	
		DATAMANAGER.SetDataValue( false, "obfnd_oder_010r", "InBlock1", "OVDV_DEAL_CLCD" , 0 , g_szDealType ) '매매구분코드 A:전체, 1:매수, 2:매도
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID = "obfnp_fnmt_011r" then	
		g_szACNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ACNO" , i) '계좌번호
		g_szASNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ASNO" , i) '계좌일련번호
		'해외파생 주문체결내역 호출
		DATAMANAGER.RequestTranData("obfnd_oder_010r")
	end if
	
	if szTranID = "obfnd_oder_010r" then
		Dim nCount, nIndex
		nCount = DATAMANAGER.GetDataCount( false, "obfnd_oder_010r", "OutBlock1" )
		nIndex = tonumber(grdData.rowcount) - nCount
		
		if nCount > 0 then
			for i = 0 to nCount step 1
				Dim szOderNo, szOrglOderNo, szProsType, szDealCode, szErrCode, szStateCode, szCntgQty, szTpcd, szOvdvCode
				
				szOderNo = DATAMANAGER.GetDataValue( false, "obfnd_oder_010r", "OutBlock1", "OVDV_ODER_NO" , i ) '주문번호
				if Len(szOderNo) > 6 then
					szOderNo = CInt(Mid(szOderNo,7))
				end if
				szOrglOderNo = DATAMANAGER.GetDataValue( false, "obfnd_oder_010r", "OutBlock1", "ORGL_OVDV_ODER_NO" , i ) '원주문번호
				if Len(szOrglOderNo) > 6 then
					szOrglOderNo = CInt(Mid(szOrglOderNo,7))
				end if
				szProsType	= DATAMANAGER.GetDataValue( false, "obfnd_oder_010r", "OutBlock1", "ODER_PROS_TPCD" , i ) '주문처리유형코드 1:신규, 2:정정, 3:취소
				szDealCode	= DATAMANAGER.GetDataValue( false, "obfnd_oder_010r", "OutBlock1", "OVDV_DEAL_CLCD" , i ) '매매구분코드 1:매수, 2:매도
				szErrCode	= DATAMANAGER.GetDataValue( false, "obfnd_oder_010r", "OutBlock1", "OVDV_ERR_CODE" , i ) '에러코드
				szStateCode	= DATAMANAGER.GetDataValue( false, "obfnd_oder_010r", "OutBlock1", "ODER_STAT_CODE" , i ) '주문상태코드 0:미접수, 1:접수, 2:확인, 3:처리완료
				szCntgQty	= DATAMANAGER.GetDataValue( false, "obfnd_oder_010r", "OutBlock1", "CNTG_QTY" , i ) '체결수량
				szTpcd		= DATAMANAGER.GetDataValue( false, "obfnd_oder_010r", "OutBlock1", "ODER_TPCD" , i ) '주문유형코드 1:시장가, 2:지정가, 3:STOP, 4:S/L, 5:OCO
				szOvdvCode	= DATAMANAGER.GetDataValue( false, "obfnd_oder_010r", "OutBlock1", "OVDV_ODER_CLCD" , i ) '해외파생주문구분코드 0:DAY, 6:GTD
				
				grdData.SetCellData("OderNo", nIndex+i, szOderNo)
				grdData.SetCellData("OrglOderNo", nIndex+i, szOrglOderNo)
				if szProsType = "1" then '신규
					grdData.SetCellData("ProsType", nIndex+i, "")
				elseif szProsType = "2" then '정정
					grdData.SetCellData("ProsType", nIndex+i, "정정")
				elseif szProsType = "3" then '취소
					grdData.SetCellData("ProsType", nIndex+i, "취소")
				end if
				if szDealCode = "1" then
					grdData.SetCellData("Deal", nIndex+i, "매수")
					grdData.SetCellFgColor("Deal", nIndex+i, "1")
				elseif szDealCode = "2" then
					grdData.SetCellData("Deal", nIndex+i, "매도")
					grdData.SetCellFgColor("Deal", nIndex+i, "2")
				end if
				if szErrCode <> "0" then
					if Len(szErrCode) > 0 then
						grdData.SetCellData("State", nIndex+i, "거부")
					end if
				else
					if szStateCode = "0" then
						grdData.SetCellData("State", nIndex+i, "미접수")
					elseif szStateCode = "1" then
						grdData.SetCellData("State", nIndex+i, "접수")
					elseif szStateCode = "2" then
						grdData.SetCellData("State", nIndex+i, "확인")
					elseif szStateCode = "3" then
						grdData.SetCellData("State", nIndex+i, "처리완료")
					end if
				end if
				if szCntgQty <> nil and szCntgQty <> "" and tonumber(szCntgQty) > 0 then
					grdData.SetCellData("State", nIndex+i, "체결")
				end if
				if szTpcd = "1" then
					grdData.SetCellData("Type", nIndex+i, "시장가")
				elseif szTpcd = "2" then
					grdData.SetCellData("Type", nIndex+i, "지정가")
				elseif szTpcd = "3" then
					grdData.SetCellData("Type", nIndex+i, "STOP")
				elseif szTpcd = "4" then
					grdData.SetCellData("Type", nIndex+i, "STOP-LIMIT")
				elseif szTpcd = "5" then
					grdData.SetCellData("Type", nIndex+i, "OCO")
				end if
				if szOvdvCode = "0" then
					grdData.SetCellData("Ovdv", nIndex+i, "DAY")
				elseif szOvdvCode = "6" then
					grdData.SetCellData("Ovdv", nIndex+i, "GTD")
				end if
			next
		end if
	end if
End Sub

