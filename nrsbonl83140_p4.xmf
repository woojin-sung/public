'============================================================================
' 화 면 명 : 반대의사 신청팝업 유의사항, 매수청구 신청팝업 유의사항
' 작    성 : 2023.10.06 KKM
'============================================================================

'============================================================================
Sub Form_OnFormInitBefore()
	imgClose.setMaintainingRatio("1")	
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		If InStr(szOpenData, "반대의사") <> 0 Then
			Table0.left = 11
			Table1.left = 500		
		else
			Table0.left = 500	
			Table1.left = 11
		end if 
		lblTitle.caption = szOpenData
	else
		Table0.left = 11
		Table1.left = 500
	end if 	
End Sub

'============================================================================
Sub Form_OnFormClose()
	'Form.SendReturnToParent("PROC_SET", g_szBuySellCd)
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()	
End Sub
