	<SCRIPT_INFO _len="6684" _ulen="5693" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 은행개설계좌 ID등록_개인정보필수동의
' 02. 화면설명 : 
' 03. 작    성 : 2016.03.07 김은숙
' 04. 수    정 : 2017.11.23 윤유정 : 개인신용정보제공동의서 개편(일부항목 동의>고지로 변경) v0001
'              : 2019.04.23 조승행 : 개인신용정보 처리 동의서 항목 변경 v0002 T1904100006 rdo8 추가
'-------------------------------------------------------------------------------------------
'============================================================================
' v0001
' 개인(신용)정보동의서 개선 설명
'============================================================================
'	변경 내용 : 기존 "동의" 항목을 "고지"로 변경 & 각 항목 번호를 숫자>알파벳으로 변경(전 채널 통일)
'	대상 항목 : 1. 필수동의서(공통)
'					1) 수집,이용				>>> "Y"(화면에서 강제 셋팅_초기선택값 2->0으로 변경)
'			   2. 필수동의서(상품별)
'					1) 수집,이용 전체(1~7번)	>>> "Y"
'					2) 업무위탁				>>> "Y"
'					3) 고유식별정보의 처리		>>> "Y"
'			   3. 일괄동의여부
'					1) 업무위탁				>>> NULL(선택값 없이 서비스 호출_초기선택값 2 유지)
'					2) 제공					>>> NULL
'	기타 항목들은 현상 유지
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sPopupFileName
Dim g_sSendData	'마지막 팝업화면으로 각 페이지의 입력 데이터 전달

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'라디오그룹 선택인덱스("0"/"1")를 문자열("Y"/"N")로 치환
Function CovertYN(sIndex)
	if sIndex == "0" then
		return "Y"
	elseif sIndex == "1" then
		return "N"
	else
		return ""
	end if
End Function

'============================================================================
'다음 버튼 클릭시 필수정보 입력 여부 확인
Function ValidatCheck()
	if chkAgree0.chksilence == "0" then
		Form.MsgBox( "알림", "개인(신용)정보 필수동의서를 확인하시기 바랍니다.", "", 6 )
		return False
	end if
	
	if rdo0.currentindex <> "0" or rdo1.currentindex <> "0" then
		Form.MsgBox("알림", "필수동의서(공통) 항목은 동의 선택이 필수입니다.", 0, 6)
		return False
	end if

	if rdo2.currentindex <> "0" then
		Form.MsgBox("알림", "필수동의서(상품) 수집·이용 항목은 동의 선택이 필수입니다.", 0, 6)
		return False
	end if

	if rdo3.currentindex <> "0" then
		Form.MsgBox("알림", "필수동의서(상품) 조회 항목은 동의 선택이 필수입니다.", 0, 6)
		return False
	end if
	
	if rdo5.currentindex <> "0" then
		Form.MsgBox("알림", "필수동의서(상품) 제공 신용정보 조회 및 집중 항목은 동의 선택이 필수입니다.", 0, 6)
		return False
	end if
	
	if rdo6.currentindex <> "0" then
		Form.MsgBox("알림", "필수동의서(상품) 고유식별정보의 처리 항목은 동의 선택이 필수입니다.", 0, 6)
		return False
	end if
	
	return True
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_sRetData = "cancel"
	g_sPopupFileName = "mhetc90020_p5"
	Form.SetScreenName("은행개설계좌 ID등록")
End Sub

'============================================================================
'취소 버튼
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'다음 버튼
Sub btnOK_OnClick()
	if ValidatCheck() == False then		'입력값 확인
		Exit Sub
	end if
	
	g_sSendData = "은행" + "★"
	g_sSendData = g_sSendData + CovertYN(rdo2.currentindex) + "★"
	g_sSendData = g_sSendData + CovertYN(rdo3.currentindex) + "★"
	g_sSendData = g_sSendData + CovertYN(rdo4.currentindex) + "★"
	g_sSendData = g_sSendData + CovertYN(rdo5.currentindex) + "★"
	g_sSendData = g_sSendData + CovertYN(rdo6.currentindex) + "★"
	g_sSendData = g_sSendData + CovertYN(rdo7.currentindex) + "★"
	g_sSendData = g_sSendData + CovertYN(rdo8.currentindex) + "★"	'v0002 추가
	
	Form.OpenFramePopup( g_sPopupFileName , g_sSendData , sPosInfo)
End Sub

'============================================================================
'개인(신용)정보 필수동의서 보기
Sub btnView_OnClick()
    'v0002 필수동의서 변경
	'Form.OpenFramePopup( "mhetc90020_p9" , "Personal" , "")
	Form.OpenFramePopup( "mbonl81020_t3" , "common" , "")
End Sub

'============================================================================
Sub Form_OnFormClose()	
	Form.SendReturnToParent( "mhetc90020_p4" , g_sRetData )
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == g_sPopupFileName then
		if sRet == "ok" then
			g_sRetData = "ok"
			Form.CloseForm( )
		end if
	end if
	
	'v0002 수정 mbonl81020_t3로...
'	if sKeyName == "mhetc90020_p9" then
'		if sRet <> "" then
'			chkAgree0.checkstate = "1"
'		end if
'	end if
	if sKeyName == "mbonl81020_t3" then
		if sRet == "ok" then
			chkAgree0.checkstate = "1"
		end if
	end if

End Sub

'============================================================================
Sub ChkAll0_OnChange(sCheckState)
	Dim sCurIdx
	
	if sCheckState == "0" then
		sCurIdx = "-1"
	else
		sCurIdx = "0"
	end if
	
	rdo0.currentindex = sCurIdx
	rdo1.currentindex = sCurIdx
End Sub

'============================================================================
Sub ChkAll1_OnChange(sCheckState)
	Dim sCurIdx
	
	if sCheckState == "0" then
		sCurIdx = "-1"
	else
		sCurIdx = "0"
	end if
	
	rdo2.currentindex = sCurIdx
	rdo3.currentindex = sCurIdx
	rdo4.currentindex = sCurIdx
	rdo5.currentindex = sCurIdx
	rdo6.currentindex = sCurIdx
	rdo7.currentindex = sCurIdx
	rdo8.currentindex = sCurIdx	 'v0002
End Sub
	</SCRIPT_INFO>
