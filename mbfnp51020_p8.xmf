	<SCRIPT_INFO _len="13255" _ulen="12327" >
'============================================================================
' 01. 화 면 명 : 펀드자동이체신청_약관 동의 팝업
' 02. 화면설명 : 펀드자동이체신청_약관 동의 팝업
' 03. 작    성 : 2023.09.01 신명준
' 04. 수    정 : 
'
'============================================================================
Dim g_sRetData 						'리턴데이터

Dim g_szUnAllCheckImg, g_szAllCheckImg	'전체동의 체크이미지
Dim g_szUnCheckImg, 	g_szCheckImg		'체크이미지
Dim g_szUnCheckFg, 	g_szCheckFg		'체크 폰트 컬러

Dim g_ChkAll							'전체동의여부
Dim g_Chk1
Dim g_Chk2
Dim g_Chk3
Dim g_Chk4

Dim g_szINVT_FILE
Dim g_szCORE_FILE
Dim g_szPROD_FILE

Dim g_iscd
Dim g_tact_cls_code

'============================================================================
'								FORM 함수
'============================================================================
Sub Form_OnFormInitBefore()
	g_szUnAllCheckImg	= "checkmenu_n.png"
	g_szAllCheckImg	= "checkmenu_o.png"
	g_szUnCheckImg 	= "check_line_n.png"
	g_szCheckImg 		= "check_line_o.png"
	g_szUnCheckFg 	= "127"
	g_szCheckFg 		= "4"
	g_sRetData		= "cancel"
End Sub


'============================================================================
Sub Form_OnFormInit()
	'초기화..
	f_SetChkState(0, false)

	Dim sOpenData
	Dim g_tData
	sOpenData = Form.GetOpenLinkData()
	g_tData = Split(sOpenData, "☆")

	g_iscd = g_tData[0]
	g_tact_cls_code = g_tData[1]
	if g_iscd == "" or g_iscd == null then
		ShowAlert("알림", "종목코드를 입력해주세요.")
		Exit Sub
	end if
	
	g_szIscd = g_iscd
	if g_tact_cls_code = "2" then
		Button3.visible = TRUE
		lblChkText3.visible = TRUE
		imgChk3.visible = TRUE
		imgUIChk3.visible = TRUE
	else
		Button3.visible = FALSE
		lblChkText3.visible = FALSE
		imgChk3.visible = FALSE
		imgUIChk3.visible = FALSE
	end if
	
	DATAMANAGER.RequestTranData("obsim_idmn_080r")	'약관 파일목록조회
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mbfnp51020_p10" then

		If sRet == "투자설명서" Then
			f_SetChkState(1, true)
		ElseIf sRet == "간이투자설명서" Then
			f_SetChkState(2, true)
		ElseIf sRet == "핵심(요약)상품설명서" Then
			f_SetChkState(3, true)
		ElseIf sRet == "개인(신용)정보 수집ㆍ이용ㆍ제공 동의" Then
			f_SetChkState(4, true)
		End If

	'전체동의
	elseif sKeyName == "mbfnp51020_p11" then
	
		if sRet == "AGREE" then		
			f_SetChkState(0, true)
		elseif sRet == "cancel" then	
			f_SetChkState(0, false)
		end if
		
	end if
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbfnp51020_p8", g_sRetData)
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용_백버튼
	Form.CloseForm()
End Sub

'============================================================================
'							DATAMANAGER 함수
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obsim_idmn_080r" then
		DATAMANAGER.SetDataValue(0, "obsim_idmn_080r", "InBlock1", "ISCD"				, 0,		g_szIscd)
		DATAMANAGER.SetDataValue(0, "obsim_idmn_080r", "InBlock1", "MFI_ATCH_FILE_CLCD" 	, 0,		"%")
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
		 
	if szTranID == "obsim_idmn_080r" then
		g_szINVT_FILE = DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_INVT_ATCH_FILE_ORTX_NAME", 0)	'투자설명서 파일명
		g_szCORE_FILE = DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_CORE_ATCH_FILE_ORTX_NAME", 0)	'간이설명서 파일명
		g_szPROD_FILE = DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_PROD_ATCH_FILE_ORTX_NAME", 0)	'UI상품첨부파일원본명		 
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
End Sub

'============================================================================
'							CONTROL 함수
'============================================================================
' 백그라운드 클릭
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' 필수약관에 모두 동의 클릭
'============================================================================
Sub btnAllChk_OnClick()

	if CInt(g_ChkAll) == 1 then
		f_SetChkState(0, false)		
	else
		f_OpenChkPopup(0)
	end if
	
End Sub

'============================================================================
' 투자설명서 띄움
'============================================================================
Sub Button0_OnClick()

	if CInt(g_Chk1) == 1 then
		f_SetChkState(1, false)
	else
		f_OpenChkPopup(1)
	end if
	
End Sub

'============================================================================
' 간이투자설명서 띄움
'============================================================================
Sub Button1_OnClick()

	if CInt(g_Chk2) == 1 then
		f_SetChkState(2, false)
	else
		f_OpenChkPopup(2)
	end if
	
End Sub

'============================================================================
' 핵심(요약)상품설명서 띄움
'============================================================================
Sub Button2_OnClick()

	if g_szPROD_FILE == NULL or g_szPROD_FILE == "" then
		Form.ShowAlert(g_szAlertTitle, "핵심상품설명서 파일이 없습니다.(조회오류)")
		Exit Sub
	end if
	
	if CInt(g_Chk3) == 1 then
		f_SetChkState(3, false)
	else
		f_OpenChkPopup(3)
	end if
	
End Sub

'============================================================================
' 개인(신용)정보 수집ㆍ이용ㆍ제공 동의 띄움
'============================================================================
Sub Button3_OnClick()

	if CInt(g_Chk4) == 1 then
		f_SetChkState(4, false)
	else
		f_OpenChkPopup(4)
	end if
	
End Sub

'============================================================================
' 확인 버튼
'============================================================================
Sub BtnContinue_OnClick()
	
	if g_Chk1 = "1" and g_Chk2 = "1" and g_Chk3 = "1" then 
	
		if g_tact_cls_code = "2" then
			if g_Chk4 = "1" then
				g_sRetData = "ok"			
			else 
				g_sRetData = "cancel"		
			end if
		else
			g_sRetData = "ok"
		end if
	else
		g_sRetData = "cancel"		
	end if 
	
	Form.CloseForm()
End Sub

'============================================================================
'							사용자 함수
'============================================================================
'f_sGetURLTitle(iIdx) : 각 동의체크 별 타이틀 리턴
'============================================================================
Function f_sGetURLTitle(iIdx)
	Dim szTitle
	
	Select Case iIdx
		Case 1
			szTitle = "투자설명서"
		Case 2
			szTitle = "간이투자설명서"
		Case 3
			szTitle = "핵심(요약)상품설명서"
		Case 4
			szTitle = "개인(신용)정보 수집ㆍ이용ㆍ제공 동의"
	End Select
	
	return szTitle
End Function

'============================================================================
'f_sGetURL(iIdx) : 각 동의체크 별 안내팝업 URL 리턴
'============================================================================
Function f_sGetURL(iIdx)		
	Dim sURLheader, sURL
	sURLheader = "http://home.imeritz.com/include/ocw/"

	Select Case iIdx
		Case 1
			'"'투자설명서"
			sURL = sURLheader & g_szINVT_FILE	'"meritz_yk_51.pdf"
		Case 2
			'"간이설명서"
			sURL = sURLheader & g_szCORE_FILE	'"meritz_ts_51.pdf"
		Case 3
			'"핵심(요약)상품설명서"
			sURL = sURLheader & g_szPROD_FILE	'"meritz_ts_51.pdf"
		Case 4
			'"개인(신용)정보 수집ㆍ이용ㆍ제공 동의"
			sURL = "CMA"
	End Select
	
	return sURL
End Function

'============================================================================
'f_OpenChkPopup(iIdx) : 각 동의체크 별 안내팝업 호출
'============================================================================
Function f_OpenChkPopup(iIdx)

	if iIdx == 0 then
		if g_tact_cls_code = "2" then
			szURL = f_sGetURL(1) & "★" & f_sGetURL(2) & "★" & f_sGetURL(3) & "★" & f_sGetURL(4)
			szTitle = f_sGetURLTitle(1) & "★" & f_sGetURLTitle(2) & "★" & f_sGetURLTitle(3) & "★" & f_sGetURLTitle(4)
		else 
			szURL = f_sGetURL(1) & "★" & f_sGetURL(2) & "★" & f_sGetURL(3) 
			szTitle = f_sGetURLTitle(1) & "★" & f_sGetURLTitle(2) & "★" & f_sGetURLTitle(3) 
		end if
		'팝업 호출
		if szURL <> "" then
			Form.OpenPopup("mbfnp51020_p11" , szURL&"♥"&szTitle&"♥"&" ", "")
		end if		
	else
		Form.SetSharedData("OPEN_URL", f_sGetURL(iIdx))
		Form.OpenFramePopup("mbfnp51020_p10", f_sGetURLTitle(iIdx), "")	
	end if
	
End Function

'============================================================================
'각 체크 별 기능 동작
'============================================================================
Function f_SetChkState(iIdx, bValue)

	'전체동의
	if iIdx == 0 then
	
		if bValue == true then	
			g_ChkAll = "1"	
			imgUIAllChk.imgpath = g_szAllCheckImg
			lblAllText.fgcolor  = g_szCheckFg			
		
			g_Chk1 = "1"	
			imgUIChk0.imgpath   = g_szCheckImg
			lblChkText0.fgcolor = g_szCheckFg
			
			g_Chk2 = "1"	
			imgUIChk1.imgpath   = g_szCheckImg
			lblChkText1.fgcolor = g_szCheckFg			
			
			g_Chk3 = "1"	
			imgUIChk2.imgpath   = g_szCheckImg
			lblChkText2.fgcolor = g_szCheckFg			
			
			g_Chk4 = "1"	
			imgUIChk3.imgpath   = g_szCheckImg
			lblChkText3.fgcolor = g_szCheckFg
		else
			g_ChkAll = "0"	
			imgUIAllChk.imgpath = g_szUnAllCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg			
			
			g_Chk1 = "0"
			imgUIChk0.imgpath   = g_szUnCheckImg
			lblChkText0.fgcolor = g_szUnCheckFg
			
			g_Chk2 = "0"
			imgUIChk1.imgpath   = g_szUnCheckImg
			lblChkText1.fgcolor = g_szUnCheckFg		
			
			g_Chk3 = "0"	
			imgUIChk2.imgpath   = g_szUnCheckImg
			lblChkText2.fgcolor = g_szUnCheckFg			
			
			g_Chk4 = "0"	
			imgUIChk3.imgpath   = g_szUnCheckImg
			lblChkText3.fgcolor = g_szUnCheckFg
		end if	
	
	'투자설명서 동의
	elseif iIdx == 1 then
	
		if bValue == true then	
			g_Chk1 = "1"	
			imgUIChk0.imgpath   = g_szCheckImg
			lblChkText0.fgcolor = g_szCheckFg
		else
			g_Chk1 = "0"
			imgUIChk0.imgpath   = g_szUnCheckImg
			lblChkText0.fgcolor = g_szUnCheckFg
		end if		
	
	'간이투자설명서 동의
	elseif iIdx == 2 then
	
		if bValue == true then	
			g_Chk2 = "1"	
			imgUIChk1.imgpath   = g_szCheckImg
			lblChkText1.fgcolor = g_szCheckFg
		else
			g_Chk2 = "0"
			imgUIChk1.imgpath   = g_szUnCheckImg
			lblChkText1.fgcolor = g_szUnCheckFg
		end if		
		
	'핵심(요약)상품설명서 동의
	elseif iIdx == 3 then
	
		if bValue == true then	
			g_Chk3 = "1"	
			imgUIChk2.imgpath   = g_szCheckImg
			lblChkText2.fgcolor = g_szCheckFg
		else
			g_Chk3 = "0"
			imgUIChk2.imgpath   = g_szUnCheckImg
			lblChkText2.fgcolor = g_szUnCheckFg
		end if		
		
	'개인(신용)정보 수집ㆍ이용ㆍ제공 동의 동의
	elseif iIdx == 4 then
	
		if bValue == true then	
			g_Chk4 = "1"	
			imgUIChk3.imgpath   = g_szCheckImg
			lblChkText3.fgcolor = g_szCheckFg
		else
			g_Chk4 = "0"
			imgUIChk3.imgpath   = g_szUnCheckImg
			lblChkText3.fgcolor = g_szUnCheckFg
		end if		

	end if

	f_SetBtnRegEnable()
End Function

'============================================================================
' 확인 버튼 상태 결정
'============================================================================
Function f_SetBtnRegEnable()
	g_ChkAll = "0"
	imgUIAllChk.imgpath = g_szUnAllCheckImg
	lblAllText.fgcolor  = g_szUnCheckFg			
	
	if g_Chk1 <> "1" then
		BtnContinue.enable = false
		
		if g_Chk2 <> "1" or g_Chk3 <> "1" or g_Chk4 <> "1" then
			imgUIAllChk.imgpath = g_szUnAllCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg	
		end if		
		Exit Function	
		
	end if
	
	if g_Chk2 <> "1" then
		BtnContinue.enable = false
		
		if g_Chk1 <> "1" or g_Chk3 <> "1" or g_Chk4 <> "1" then
			imgUIAllChk.imgpath = g_szUnAllCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg	
		end if
		Exit Function
		
	end if
	
	if g_Chk3 <> "1" then
		BtnContinue.enable = false
		
		if g_Chk2 <> "1" or g_Chk2 <> "1" or g_Chk4 <> "1" then
			imgUIAllChk.imgpath = g_szUnAllCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg	
		end if
		Exit Function
		
	end if
	
	if g_tact_cls_code = "2" AND g_Chk4 <> "1" then
		BtnContinue.enable = false
		
		if g_Chk1 <> "1" or g_Chk2 <> "1" or g_Chk3 <> "1" then
			imgUIAllChk.imgpath = g_szUnAllCheckImg
			lblAllText.fgcolor  = g_szUnCheckFg	
		end if
		Exit Function
		
	end if
	
	g_ChkAll = "1"	
	imgUIAllChk.imgpath = g_szAllCheckImg
	lblAllText.fgcolor  = g_szCheckFg			
	
	'신청가능
	BtnContinue.enable = true
End Function

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obsim_idmn_080r" trcode="obsim_idmn_080r" compress="1" encryption="1" inputcheck="1" useattr="0" />
