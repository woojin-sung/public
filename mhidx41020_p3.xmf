'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	grd00.setUseCardView(true, 10, "img_bgbox_line1.9.png")
	grd01.setUseCardView(true, 10, "img_bgbox_line1.9.png")
	grd02.setUseCardView(true, 10, "img_bgbox_line1.9.png")
	grd03.setUseCardView(true, 10, "img_bgbox_line1.9.png")

	grd00.SetCellData("bd_name", 0, "상해종합")
	grd01.SetCellData("bd_name", 0, "항셍")
	grd02.SetCellData("bd_name", 0, "홍콩H")
'	grd03.SetCellData("bd_name", 0, "니케이225")
	grd03.SetCellData("bd_name", 0, "심천A")

	grd00.scrollenable = "0"
	grd01.scrollenable = "0"
	grd02.scrollenable = "0"
	grd03.scrollenable = "0"
	TR_Query()
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'grd_OnClickUp
'============================================================================
Sub grd_OnClickUp(lRow, szCellID)
	dim szSymbol
	dim szMarket
	dim szName
	
	szSymbol = grd.GetCellData("bd_cell0", lRow)
	szMarket = grd.GetCellData("bd_cell1", lRow)
	szName = grd.GetCellData("bd_cell2", lRow)
	
	Form.OpenFramePopup("mhidx42040_p1" , szSymbol & "★" &  szMarket & "★" & szName , "")

End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	dim ncnt1682
	dim szOrgTime
		
	ncnt1682 = DATAMANAGER.GetDataCount(0, "ohhts_1682_001r" , "OutBlock1")
	
	if szTranID = "ohhts_1682_001r" then
		
		for i = 0 to ncnt1682 - 1
			szOrgTime = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_DATE", i)
			szOrgTime = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r_1", "OutBlock1", "FID_CNCN_DATE", i)
			szOrgTime = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r_2", "OutBlock1", "FID_CNCN_DATE", i)
			szOrgTime = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r_3", "OutBlock1", "FID_CNCN_DATE", i)
			if szOrgTime = "" or szOrgTime = null then '20220302 HSZ : 예외처리 추가
				exit Sub
			else
				DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_DATE", i , mid(szOrgTIme,3,2) &  mid(szOrgTIme,5,2)  &  mid(szOrgTIme,7,2)  )
				DATAMANAGER.SetDataValue(0, "ohhts_1682_001r_1", "OutBlock1", "FID_CNCN_DATE", i , mid(szOrgTIme,3,2) &  mid(szOrgTIme,5,2)  &  mid(szOrgTIme,7,2)  )
				DATAMANAGER.SetDataValue(0, "ohhts_1682_001r_2", "OutBlock1", "FID_CNCN_DATE", i , mid(szOrgTIme,3,2) &  mid(szOrgTIme,5,2)  &  mid(szOrgTIme,7,2)  )
				DATAMANAGER.SetDataValue(0, "ohhts_1682_001r_3", "OutBlock1", "FID_CNCN_DATE", i , mid(szOrgTIme,3,2) &  mid(szOrgTIme,5,2)  &  mid(szOrgTIme,7,2)  )
			end if
		next	
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim ncnt1682
	dim szRealCode
	
	ncnt1682 = CDbl(DATAMANAGER.GetDataCount(0, "ohhts_1682_001r" , "OutBlock1"))
	if szTranID = "ohhts_1682_001r" then
		
		for i = 0 to ncnt1682 - 1
			szRealCode = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_ISCD", i)
			DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", i, szRealCode)
		next	
		DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")
	end if 
	
	grd00.rowcount = 1
End Sub

