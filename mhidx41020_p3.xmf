'============================================================================
'해외 지수/종목 주기를 리턴해준다 . ( 종가 또는 지연)
'============================================================================
Function gf_GetForeignCycle(szCode)
	Select Case szCode  
		case "DJI@DJI", "NAS@IXIC", "SPI@SPX", "DJI@DJC", "NYS@NYA", "NAS@SOX" '미국 '20190813 HWG : 미국 필라델피아 반도체 지수 심볼변경
		    return "종가"  
		    
		Case  "CME@ND", "CME@NQ", "CME@ES", "USI@RUT" '미국 '"CME@SP"20220209 HSZ S&P500 선물 삭제
		    return "지연(15분)"
		    
		Case "HSI@HSCE", "SZS@399107", "SZS@399108", "HSI@HSI", "SHS@000001", "SHS@000002", "SHS@000003" '아시아
		    return "지연(15분)"  
		
		Case "NII@NI225" '아시아
		    return "지연(20분)"    
		    
		Case "ILI@TA100", "ILI@TA125", "TWS@TI01", "INI@BSE30", "IDI@JKSE", "PHI@COMP", "VNI@VIDX"  '아시아 
		    return "종가"   
		
		Case "NLI@AEX", "PAS@CAC40", "XTR@DAX30", "STX@SX5E", "RUI@RTSI" '유럽
		    return "종가"
		
		Case "TRI@ISE100"	'유럽  			
		    return "지연(15분)"
		    
		Case "BRI@BVSP", "CAI@SPTSX", "ETC@DXY00", "MXI@IPC", "NZI@NZ50"	'미주/오세아니아주 
		    return "종가" 
		    
		Case "AUI@AORD" '미주/오세아니아주
		    return "지연(20분)"   
			
		Case "USDKRWSMBS", "EURUSDCOMP", "USDJPYCOMP","EURJPYCOMP", "GBPUSDCOMP", "USDCHFCOMP", "USDCADCOMP", "AUDUSDCOMP", "USDHKDCOMP", "USDSGDCOMP","CNYKRWCOMP", "JPYKRWCOMP"  
			return "실시간" 	

		Case "USDCNYCOMP", "USDTWDCOMP", "USDGBPCOMP", "USDBRLCOMP", "USDVNDCOMP", "USDEURCOMP", "GBPKRWCOMP", "EURKRWCOMP", "USDRUBCOMP", "USDQARCOMP", "USDOMRCOMP", "USDMYRCOMP", "USDJODCOMP", "USDKWDCOMP", "USDAEDCOMP", "USDIDRCOMP", "USDEGPCOMP", "USDILSCOMP", "USDARSCOMP", "USDMXNCOMP", "USDNZDCOMP", "USDAUDCOMP", "USDTHBCOMP", "USDSEKCOMP", "USDNOKCOMP", "USDSARCOMP", "USDDKKCOMP", "USDINRCOMP", "USDHUFCOMP", "USDTRYCOMP", "USDPHPCOMP", "BRLKRWCOMP"		 
			return "실시간"
	End Select
' 20190603 HWG END
End Function

'============================================================================
'TR_Query()
'============================================================================
Function TR_Query()
	DATAMANAGER.CancelRealData("ohhts_ovrs_nmix")
	DATAMANAGER.ClearInputData(1, "ohhts_ovrs_nmix")
	DATAMANAGER.ClearInputData(0, "ohhts_1682_001r")
	DATAMANAGER.ClearInputData(0, "ohhts_1682_001r_1")
	DATAMANAGER.ClearInputData(0, "ohhts_1682_001r_2")
	DATAMANAGER.ClearInputData(0, "ohhts_1682_001r_3")

	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0,"N")
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 1,"N")
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 2,"N")
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 3,"N")
	
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0,"N")
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r_2", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0,"N")
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r_3", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0,"N")
	
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" , 0, "SHS@000001")		'상해종합
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" , 1, "HSI@HSCE")		'홍콩H
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" , 2, "HSI@HSI")			'항생
'	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" , 3, "NII@NI225")		'니케이
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" , 3, "SZS@399107")		'심천A
	
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r_1", "InBlock1", "FID_INPUT_ISCD" , 0, "HSI@HSCE")		'홍콩H
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r_2", "InBlock1", "FID_INPUT_ISCD" , 0, "HSI@HSI")		'항생
'	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r_3", "InBlock1", "FID_INPUT_ISCD" , 0, "NII@NI225")		'니케이
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r_3", "InBlock1", "FID_INPUT_ISCD" , 0, "SZS@399107")	'심천A
	
	DATAMANAGER.RequestTranData("ohhts_1682_001r" )
	DATAMANAGER.RequestTranData("ohhts_1682_001r_1" )
	DATAMANAGER.RequestTranData("ohhts_1682_001r_2" )
	DATAMANAGER.RequestTranData("ohhts_1682_001r_3" )

end Function 

