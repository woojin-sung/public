'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'고객정보조회
	If szTranID == "obcsb_acif_000r" Then	
		g_szCSNO = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CSNO" , 0 )
		
		If g_szCSNO <> null and Trim(g_szCSNO) <> "" Then
			DATAMANAGER.RequestTranData( "obpds_srvc_069r" ) '약정조회
		End If
	
	'약정조회
	ElseIf szTranID == "obpds_srvc_069r" Then
		btnOK.caption = "신청"
		btnProvision.enable = true
		btnModiTel.enable = true
		
		If DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock1" ) > 0 Then
			Dim szCode	
			szCode = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "STPL_STAT_CLS_CODE" , 0 )
			g_szSVC_SRNO = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SVC_SRNO" , 0 )
			
			If szCode == "03" Then
				tblState.SetCellString( 0, 1, "신청중" )
				btnProvision.enable = false
				btnModiTel.enable = false
				
				g_FinCustomer = "Y"
			ElseIf szCode == "01" Then
				tblState.SetCellString( 0, 1, "등록" )
				btnOK.caption = "해지"
				btnProvision.enable = false
				
				g_FinCustomer = "Y"
			Else
				tblState.SetCellString( 0, 1, "미등록" )				
			End If
		Else
			tblState.SetCellString( 0, 1, "미등록" )				
		End If
		
	'신청
	ElseIf szTranID == "obpds_srvc_045a" Then
		If g_szApproveCode == "I" Then 'v0002 
			Dim szMsg, szSubMsg
			szMsg = DATAMANAGER.GetDataMsgText( szTranID )
			szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
			
			If szSubMsg ~= null and Trim(szSubMsg) ~= "" Then
				szMsg = szMsg.." "..szSubMsg
			end if
			Form.ShowAlert("알림", szMsg)
			
			'v0001 STA
			g_szSVC_SRNO = tostring(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SVC_SRNO" , 0))
			DATAMANAGER.RequestTranData( "obcsb_dbif_322a" ) 
			'v0001 FIN
			
		ElseIf g_szApproveCode == "D" Then 'v0002 
			Form.ShowAlert( "알림" , "해지가 완료되었습니다.")
			
			f_ClearData()
			DATAMANAGER.RequestTranData( "obpds_srvc_069r" ) '약정조회			
		End If
		
	'고위험상품가입여부처리	
	ElseIf szTranID == "obcsb_acif_705u" Then
		f_ClearData()
		DATAMANAGER.RequestTranData( "obpds_srvc_069r" ) '약정조회
		
	'v0001 STA
	elseif szTranID	= "obsap_acif_999a" then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		Form.SetSharedData( "FNPR_JOIN_SRNO", g_szFnprJoinSrno )
		
		Form.SetSharedData("SPCL_CNFR_ACNO", acntList.caption )
		Form.OpenPopup("mbonl81010_p20" , "" , "")	'2023.05.22 금융소비자 팝업 추가
		
'		If g_szFnprJoinSrno <> "" Then
'			Form.OpenPopup("mbonl81010_p16" , acntList.total & "★" & g_szFnprJoinSrno, "")
'		End If
	elseif szTranID	= "obcsb_dbif_322a" then	
		DATAMANAGER.RequestTranData( "obcsb_acif_199a" )
	elseif szTranID == "obcsb_acif_199a" then 
		Dim szSUCS_YN
		szSUCS_YN = Form.GetSharedData("KYC_SUCS_YN", false)
		
		If szSUCS_YN == null or szSUCS_YN == "" or szSUCS_YN ~= "Y" Then
			f_ClearData()
			DATAMANAGER.RequestTranData( "obpds_srvc_069r" ) '약정조회
		Else
			DATAMANAGER.RequestTranData( "obcsb_acif_705u" ) '고위험상품가입여부처리
		End if	
	'v0001 Fin 	
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubMsg <> null and Trim(szSubMsg) <> "" Then
		szErrMsg = szErrMsg & "(" & szSubMsg & ")" 
	end if
	
	If szTranID == "obpds_srvc_069r" or szTranID == "obpds_srvc_045a" or
		szTranID == "obcsb_acif_705u" or szTranID == "obcsb_dbif_322a" Then 'v0001 obcsb_dbif_322a 추가
		Form.ShowAlert( "알림", szErrMsg )
	End if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "Show_mbonl81010" then
		if sRet == "ok" then
			Form.OpenPopup("mbonl81010_p20" , "" , "")
		end if
	end if
End Sub

