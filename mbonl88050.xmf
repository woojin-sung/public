'--===========================================================================
' 01. 화 면 명 : K-OTC 거래신청
' 02. 화면설명 : K-OTC 거래신청
' 03. 작    성 : 2021.12.22 김수진
' 04. 수    정 : 
' 2022.04.11 : 김수진 : v0001 : 계약서류 교부처리, obsap_acif_999a obcsb_dbif_322a IO 추가
' 2022.06.10 : 전상일 : v0002 : 해지시 오류 수정
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szPlain_rm	'메모리 평문적용 여부
Dim g_szCSNO		'고객번호

Dim g_szSVC_SRNO	'서비스일련번호

'투자성향진단
Dim g_szKYC_INVT_INCL_GRAD_CODE 	'KYC투자성향등급코드
Dim g_szKYC_PROD_GRAD_CODE 			'KYC상품등급코드
Dim g_szKYC_DVPD_EPMD_CODE 			'KYC파생상품유의코드
Dim g_szKYC_DRVT_PROS_YN 			'KYC파생처리여부
Dim g_szKYC_STND_DATE 				'기준일자
Dim g_szKYC_REG_SRNO 				'등록일련번호
Dim g_nYN						'투자성향 체크

Dim g_szFnprJoinSrno		'v0001 금융상품일련번호
Dim g_szApproveCode		'v0002 : 처리구분코드

Dim g_FinCustomer 		'금융소비자 팝업 진행상태
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'===========================================================================
' f_GetPWCkeck() : 계좌비밀번호 입력체크함수
'===========================================================================
Function f_GetPWCkeck()
	Dim szACNT_PWD 
	szACNT_PWD = Form.GetCtlProp( "edtPswd", "caption" )
	
	If szACNT_PWD == null or szACNT_PWD == "" Then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	End If
	
	return false
End Function	


'============================================================================
' f_ClearData() : 초기화
'============================================================================
Function f_ClearData()
	tblState.SetCellString( 0, 1, "" )
	
	'v0001 STA
	chkProvision.checkstate = "0"
	g_szFnprJoinSrno = ""
	g_szSVC_SRNO = ""
	'v0001 FIN
	
	edtPswd.caption = ""
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()    
	f_ClearData()
	edtPswd.caption = ""
	
	g_szCSNO = ""
	g_szSVC_SRNO = ""
	
	g_szKYC_INVT_INCL_GRAD_CODE = ""	'KYC투자성향등급코드
	g_szKYC_PROD_GRAD_CODE = ""			'KYC상품등급코드
	g_szKYC_DVPD_EPMD_CODE = ""			'KYC파생상품유의코드
	g_szKYC_DRVT_PROS_YN = ""			'KYC파생처리여부
	g_szKYC_STND_DATE = ""				'기준일자
	g_szKYC_REG_SRNO = ""				'등록일련번호
	g_nYN = 0
	
	'메모리평문적용여부(0:미적용 / 1:적용)
	g_szPlain_rm 		= Form.GetSharedData("&PLAIN_RM", false)
	
	sMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	if sMode == "1" then
		webInfo.urlpath = "http://testhome.imeritz.com/include/resource/comm/ctcn/files/kotc_noti.html"
	else 
		webInfo.urlpath = "http://home.imeritz.com/include/resource/comm/ctcn/files/kotc_noti.html"
	end if
	
	
	
	'고객정보조회
	DATAMANAGER.RequestTranData("obcsb_acif_000r")
End Sub

'============================================================================
' acntList_ChangeAccount() : 다른 계좌로 변경 되었을때 초기화 등록내역 조회
'============================================================================
Sub acntList_ChangeAccount()
	f_ClearData()
	edtPswd.caption = "" 
	g_szCSNO = "" 'v0001
	
	'고객정보조회
	DATAMANAGER.RequestTranData("obcsb_acif_000r")
End Sub
