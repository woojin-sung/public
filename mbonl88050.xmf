'============================================================================
' btnModiTel_OnClick() : 연락처 변경 v0001
'============================================================================
Sub btnModiTel_OnClick()
	chkProvision.checkstate = "0"
	Form.OpenFramePopup( "mbonl81000" , "" , "")	'연락처변경
End Sub

'============================================================================
' btnProvision_OnClick() : 서류제공방식선택 > obsap_acif_999a > mbonl81010_p16 호출 v0001
'============================================================================
Sub btnProvision_OnClick()
	'계좌비밀번호 입력체크함수
	If f_GetPWCkeck() Then
		Exit Sub
	End If
	
	If acntList.total <> "" and acntList.total <> null Then
		If g_szFnprJoinSrno <> "" Then
			Form.SetSharedData("mbonl81010_p16_LOAN_YN", "Y")	'Y로 넘기면 처리완료 팝업이 안뜸..
			Form.OpenPopup("mbonl81010_p16" , acntList.total & "★" & g_szFnprJoinSrno, "")
'		Else
'			DATAMANAGER.RequestTranData( "obsap_acif_999a" ) 'v0001 금융상품 일련번호 GET
		End If
	End If
End Sub

'============================================================================
' BtnOK_OnClick() : 신청
'============================================================================
Sub btnOK_OnClick()
	'계좌비밀번호 입력체크함수
	If f_GetPWCkeck() Then
		Exit Sub
	End If
	
	If tblState.GetCellString( 0, 1 ) = "신청중" Then
		Form.ShowAlert("알림", "승인 신청중 입니다.")
		Exit Sub
	End If

	'서류제공방식체크 v0001 STA
	If btnOK.caption = "신청" Then	
		If chkProvision.checkstate == 0 or chkProvision.checkstate == "0" Then
			Form.ShowAlert( "알림" , "서류 제공방식을 선택하세요.")
			Exit Sub		
		End If
	End If
	
	'v0001 FIN

	If g_FinCustomer <> "Y" Then
		Form.MsgBox("알림", "전문, 일반 금융소비자를 확인 바랍니다.", "Show_mbonl81010", "1")
		Exit Sub		
	End If

	If btnOK.caption = "해지" Then
		DATAMANAGER.RequestTranData( "obpds_srvc_045a" ) '거래신청
	Else
		Dim szSendData 
		szSendData = "88050★"..acntList.total.."★"..edtPswd.caption
		Form.OpenPopup("mbonl81010_p1" , szSendData , "")	'투자성향진단화면
	End If
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet) 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'-----------------------------------
	' 투자성향진단
	'-----------------------------------
	if sKeyName == "KYCCHK_RETURN" then
		'투자성향진단 OK면 Y값내려줌
		if sRet == "Y" then			'700 = N,X 정상리턴		
			g_szKYC_INVT_INCL_GRAD_CODE = Form.GetSharedData( "KYC_INVT_INCL_GRAD_CODE", false )
			g_szKYC_PROD_GRAD_CODE = Form.GetSharedData( "KYC_PROD_GRAD_CODE", false )
			g_szKYC_DVPD_EPMD_CODE = Form.GetSharedData( "KYC_DVPD_EPMD_CODE", false )
			g_szKYC_DRVT_PROS_YN = Form.GetSharedData( "KYC_DRVT_PROS_YN", false )
			
			g_szKYC_STND_DATE = Form.GetSharedData("KYC_STND_DATE", false)
			g_szKYC_REG_SRNO = Form.GetSharedData("KYC_REG_SRNO",false)
	
			if Trim(g_szKYC_REG_SRNO) <> "" or Trim(g_szKYC_REG_SRNO) <> Null then
				g_nYN = 1
			else
				g_nYN = 0
			end if
			
			DATAMANAGER.RequestTranData( "obpds_srvc_045a" ) '거래신청
		end if
		
	'-----------------------------------
	' 서류제공방식선택팝업 (mbonl81010_p16) v0001 STA
	'-----------------------------------			
	elseif sKeyName == "ok_mbonl81010_p16" then
		If Trim(sRet) == "OK" then
			chkProvision.checkstate = "1"	
		else
			chkProvision.checkstate = "0"
		end if		
	'v0001 FIN
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			g_FinCustomer = "Y"
			DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
		elseif sRet == "CANCEL_mbonl81010_p20" then
'			g_FinCustomer = "N"

			'가입중단시 처리미완료인경우 메뉴트리로 빠지도록 함 (2023.06.14)
			tRst = Form.GetSharedData( "81010_P20_RST" , false )
			if trim(tRst) <> "Y" then
				Form.OpenMainMenuWithIndex(0,1,0)
			end if
		end if
	end if
End Sub
'============================================================================
' Form_OnFormClose()
'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("KYC_SUCS_YN", "")		
	Form.SetSharedData("KYC_CSNO", "")
	Form.SetSharedData("KYC_STND_DATE", "")
	Form.SetSharedData("KYC_REG_SRNO", "")
	Form.SetSharedData("FNPR_JOIN_SRNO", "" )
	Form.SetSharedData("mbonl81010_p16_LOAN_YN", "")
End Sub

'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 통신에 필요한 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	Dim szACNT_PWD 
	If g_szPlain_rm == "1" Then  			'MTS메모리평문 적용상태일때
	    szACNT_PWD = edtPswd.caption
	Else  								'MTS메모리평문 미적용상태일때
	    szACNT_PWD = Form.GetEncData(edtPswd.caption)
	End If
	
	'고객정보조회
	If szTranID == "obcsb_acif_000r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 	, 0 , "I" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 			, 0 , acntList.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 		, 0 , szACNT_PWD )
	'약정조회
	ElseIf szTranID == "obpds_srvc_069r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO" 				, 0 , g_szCSNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVCD" 				, 0 , "061" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 				, 0 , acntList.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 		, 0 , "0" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "STPL_STAT_CLS_CODE" 	, 0 , "98" )

	'신청
	ElseIf szTranID == "obpds_srvc_045a" Then
		if g_nYN <> 1 then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "STND_DATE" 				, 0 , g_szKYC_STND_DATE )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_SRNO" 				, 0 , g_szKYC_REG_SRNO )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_INVT_INCL_GRAD_CODE" 	, 0 , g_szKYC_INVT_INCL_GRAD_CODE )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_PROD_GRAD_CODE" 		, 0 , g_szKYC_PROD_GRAD_CODE )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_DVPD_EPMD_CODE" 		, 0 , g_szKYC_DVPD_EPMD_CODE )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_DRVT_PROS_YN" 		, 0 , g_szKYC_DRVT_PROS_YN )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_YN" 				, 0 , "Y" )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_BSWR_DIV_CODE" 		, 0 , "02" )
		end if
		
		
		If Trim(tblState.GetCellString( 0, 1 )) == "등록" Then
			g_szApproveCode = "D"  'v0002
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVC_SRNO" 		, 0 , g_szSVC_SRNO )
		Else
			g_szApproveCode = "I"   'v0002
		End If
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 		, 0 , g_szApproveCode )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO" 				, 0 , g_szCSNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SVCD" 				, 0 , "061" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 				, 0 , acntList.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" 			, 0 , szACNT_PWD )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE" 		, 0 , "4" )	
		
	'고위험상품가입여부처리	
	ElseIf szTranID == "obcsb_acif_705u" Then		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO" 				, 0 , g_szCSNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "STND_DATE" 			, 0 , g_szKYC_STND_DATE )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_SRNO" 			, 0 , g_szKYC_REG_SRNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "JOIN_YN" 			, 0 , "Y" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_DRVT_PROS_YN" 	, 0 , g_szKYC_DRVT_PROS_YN )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_DVPD_EPMD_CODE" 	, 0 , g_szKYC_DVPD_EPMD_CODE )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE" 		, 0 , "4" )
	'v0001 STA
	elseif szTranID == "obcsb_dbif_322a" then 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 				 , 0 , acntList.total		) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO" 	 , 0 , g_szFnprJoinSrno	) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "BSWR_LRDV_CODE" 	 , 0 , "017"				)	'001:계좌개설 / 017:서비스약정 
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "FNPR_JOIN_DETL_SRNO" , 0 , "00001"			)	'다건일경우 하나씩 증가
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ISCD"				 , 0 , "061"				)	'prcd:계좌개설 / svcd:서비스약정 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "CNRC_DOCU_KEY_VAL"	 , 0 , g_szCSNO & "$" & "061" & "$" & g_szSVC_SRNO )	'고객번호$서비스코드$서비스일련번호 
	'v0001 FIN
	elseif szTranID == "obcsb_acif_199a" then 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO" 			, 0 , g_szFnprJoinSrno	) 	'금융상풍일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_DETL_SRNO" 	 	, 0 , "00001"			) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_LRDV_LEVL_CODE" 	, 0 , "01"			)'	"01"투자성
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_MDDV_LEVL_CODE" 	, 0 , "02"			)	'02 서비스약정
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_SMDV_LEVL_CODE"	, 0 , "02"& "061"		)	'&서비스약정코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_DTL_DIV_LEVL_CODE"	, 0 , "000" 			)	'CMA전환신청인경우 "009" 그외엔 "000"
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_ISSU_DIV_LEVL_CODE", 0 , "000"			) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISCD" 	 					, 0 , "061"			)	'061 서비스약정 코드
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "KOR_ISNM" 					, 0 , ""				)	
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CSNO"						, 0 , g_szCSNO		)	'고객번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "SVC_MANG_UNIT_CODE"	 		, 0 , "01" 			)	'서비스관리단위코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO"	 					, 0 , acntList.caption 	)	'계좌컨트롤 8자리
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" 	 					, 0 , ""				) 	'SVC_MANG_UNIT_CODE가 03일때만 매핑
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CONT_CLS_CODE" 	 			, 0 , "4"			)	'온라인
