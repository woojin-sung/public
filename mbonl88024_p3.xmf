	<SCRIPT_INFO _len="2967" _ulen="2631" >
'============================================================================
' 01. 화 면 명 : 보유주식 수익 서비스 약정완료 팝업
' 02. 화면설명 : 보유주식 수익 서비스 약정완료 팝업
' 03. 작    성 : 2022.08.02 양현정
' 04. 수    정 : 
'
'============================================================================

dim gAcnt
dim g_szNotiFlag				'이용동의서류 제공방식 선택 상태
dim g_InfrMthdFlag			'대차거래 통보방법 선택 상태
dim g_5IssuHldnFlag			'지분율5%이상 종목보유 여부 선택 상태
dim g_ProsClsCd				'처리구분

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		
		dim tData, szProdCd, szProdText
		tData = Split(szOpenData, "★")
		
		szProdCd = Form.GetAccountInfo(tData(0), "productcode")
		szProdText = Form.GetMetaData("상품코드", szProdCd)
		
		gAcnt = tData(0)
		g_ProsClsCd = tData(1)
		g_InfrMthdFlag = tData(2)
		g_szNotiFlag = tData(3)
		g_5IssuHldnFlag = tData(4)
		
		'Label0.caption = "["&szProdText&"] "&Left(gAcnt,4)&"-"&Mid(gAcnt,5,4)&"-"&Right(gAcnt,2)
		Label0.caption = Left(gAcnt,4)&"-"&Mid(gAcnt,5,4)&"-"&Right(gAcnt,2)
		
		if g_InfrMthdFlag = "1" then
			Label1.caption = "알림톡·문자"
		elseif g_InfrMthdFlag = "2" then
			Label1.caption = "온라인 직접 조회"
		end if
		
		if g_szNotiFlag = "talk" then
			Label2.caption = "알림톡·문자"
		elseif g_szNotiFlag = "email" then
			Label2.caption = "이메일"
		end if
		
		if g_5IssuHldnFlag = "Y" then
			Label3.caption = "보유"
		elseif g_5IssuHldnFlag = "N" then
			Label3.caption = "미보유"
		else
			'Label3.visible = false
			'lblTableSub4.visible = false
			'lblTableSub3.top = 414
			'Label2.top = 414
		end if

		if g_ProsClsCd = "I" then
			Table0.SetCellString(0, 0, "보유주식 수익 서비스 신청이")
			Table0.SetCellString(1, 0, "완료 되었습니다.")
			
			lblTableSub3.visible = true
			Label2.visible = true
		elseif g_ProsClsCd = "U" then
			Table0.SetCellString(0, 0, "보유주식 수익 서비스 정보가")
			Table0.SetCellString(1, 0, "변경 되었습니다.")
			
			lblTableSub3.visible = false
			Label2.visible = false
		end if

	end if
End Sub

'============================================================================
Sub btnOk_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용_백버튼
	Form.CloseForm()
End Sub


'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl88024_p3" , "CLOSE")
End Sub
	</SCRIPT_INFO>
</ROOT>