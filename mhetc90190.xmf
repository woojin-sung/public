'-------------------------------------------------------------------------------------------
'20230519 SWJ START : 메리츠 사설인증 신규 개발 (메리츠 간편인증센터)
' 2024.01.19 : 전상일 : v0001 : obcsb_oimf_658a ui_cust_cont_cls_code 추가 (별도 맵핑 x)
'-------------------------------------------------------------------------------------------
Dim g_LoginType
Dim g_sPauCustNo, g_DeviceId
Dim g_AtonBioYn			'바이오 사용여부
Dim g_ScrPoint			'진입한 곳
Dim g_sBioType
Dim g_CustNo, g_SBVersion, g_SBAlias
Dim g_sAthnTchnCode
Dim g_PinPWD
Dim g_complete
Dim g_StartYMD, g_EndYMD
Dim g_sCsName				'고객명
Dim g_AlarmRegi
Dim g_Open

'인증유형구분
Dim DEF_ATON_PIN
Dim DEF_ATON_BIO

'인증유형 바이오 구분
Dim DEF_ATON_FINGER
Dim DEF_ATON_FACE

DEF_ATON_PIN			= "10"
DEF_ATON_BIO			= "20"

DEF_ATON_FINGER 		= "100"
DEF_ATON_FACE 		= "200"
'============================================================================
Sub Form_OnFormInitBefore()
	
	Image0.setMaintainingRatio("1")
	Image1.setMaintainingRatio("1")
	Image2.setMaintainingRatio("1")
	ImgBackPress.setMaintainingRatio("1")
	imgCaution.setMaintainingRatio("1")
End Sub


'============================================================================
Sub ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	sLoginID = Form.GetSharedData( "&USER_ID", 0 )
	sFlag	= Form.GetOpenLinkData()				'로그인>인증센터>메리츠간편인증을 통해서 화면 오픈시 sFlag = Y
												'공지사항을 통해서 화면 오픈시 sFlag = P
	if Trim(sLoginID) == "" then
		if sFlag <> "Y" then						' 최초 1회 로그인 필요 O + 바이오정보 등록(로그인화면)으로 열렸을 시
			if sFlag == "P" then					' 최초 1회 로그인 필요 O + 공지사항에서 이동하였을 시
			else
				if g_sBioType == "1" then
					Form.SetEnvData(1, "login.input.atonathntchncode", "100") 
				elseif g_BioType == "2" then
					Form.SetEnvData(1, "login.input.atonathntchncode", "200") 
				end if
	
				Form.OpenPopup("mhetc90021" , "")		'20180911_01 KBC : 바이오인증 인증방식 추가
			end if
		end if
	
	else
		if sFlag <> "Y" and g_complete = "Y" then	' 최초 1회 로그인 필요 X + 바이오정보 등록(로그인화면)으로 열렸을 시 
			if sFlag == "P" then					' 최초 1회 로그인 필요 X + 공지사항에서 이동하였을 시
			else
				Form.OpenPopup("mhetc90021" , "")		'20180911_01 KBC : 바이오인증 인증방식 추가
			end if
		end if
	end if
	
	if sFlag == "Y" then
		Form.SendReturnToParent("FORM_CLOSE" , "") '20220805_01 KBC : 로그인개선
	end if
	
	'20230619 SWJ START
'	if sFlag == "YY" and g_Open <> "" then
'		Form.SendReturnToParent("FORM_CLOSE" , "")
'	end if
	'20230619 SWJ END
	
	Form.SendReturnToParent("BTN_IMAGE_ENABLE" , "")
End Sub

'============================================================================
Sub Table1_OnClick(lRow , lColumn)
	Select Case lRow
	
	'간편인증 등록/재등록
	Case	 0,1,2
		'계좌인증화면
		Form.OpenNextPopup("mhetc90190_s1" , "" , "")	
	'생체인증 추가 등록
	Case 3,4,5
		
		if CInt(g_LoginType) > 1 then '로그인상태
			'-----------------------------------------------------------------------
			'전문전송
			'-----------------------------------------------------------------------	
			procRequestAtonTR_INQUIRYCERT(sAlias)
		else
			g_Open = "1"
			Form.OpenPopup("mhetc90021" , "" , "")
			'Form.MsgBox("알림", "ID인증 또는 로그인이\n필요한 메뉴입니다.\n로그인하시겠습니까?", "LOG_FORCE", 1)
		end if
	'인증 관리
	Case 6,7,8
		if CInt(g_LoginType) > 1 then '로그인상태	
			Form.OpenNextPopup("mhetc90192" , ""  , "")
		else
			g_Open = "2"
			Form.OpenPopup("mhetc90021" , "" , "")
		end if
	End Select
End Sub
'============================================================================
Sub Image0_OnClick()
	Table1_OnClick(0 , lColumn)
End Sub
'============================================================================
Sub Image1_OnClick()
	Table1_OnClick(3 , lColumn)
End Sub
'============================================================================
Sub Image2_OnClick()
	Table1_OnClick(6 , lColumn)
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "LOG_FORCE" then
		if sRet == "ok" then
			Form.OpenPopup("mhetc90021" , "" , "")	
		else
			Form.CloseForm()			
		end if
	elseif sKeyName == "BioRegister" then
		Form.OpenFramePopup("mhetc90060_py" , "mhetc90190" , "")
		
	elseif sKeyName == "E4106" then
		if sRet == "ok" then
		else
			Form.CloseForm()
		end if
	elseif sKeyName == "E3201" then
		if sRet == "ok" then
			Form.OpenNextPopup("mhetc90190_s1" , "" , "")
		end if
	end if
End Sub
'============================================================================
Sub Form_OnFormInit()

	g_LoginType = Form.GetSharedData("&LOGIN_TYPE", false )
	g_DeviceId  = Form.GetDeviceID2()
	g_sBioType = Form.getBiometryType() '생체/지문 기기 및 사용가능여부 판단 : 0.사용불가 1.TOUCH ID 2.FACE ID
	
	'생체인증 시는 로그인 시키니까 Shared변수 공유값 가져오자
	g_CustNo = Form.GetSharedData("&CUST_NUM", false)
	g_ScrPoint = Form.GetOpenLinkData()
	
	'로그인 화면에서 안내 메시지 이후 생체인증 등록 시킬 때
	if g_ScrPoint == "LoginBioRegister" then
		'Table1_OnClick(3 , lColumn)
		'-----------------------------------------------------------------------
		'전문전송
		'-----------------------------------------------------------------------	
		procRequestAtonTR_INQUIRYCERT(sAlias)
	end if
	
	'-----------------------------------------------------------------------
	'발급여부 미리 판단
	'-----------------------------------------------------------------------
	'ATON_GETALLINFO
	'-----------------------------------------------------------------------
'	sRet = Form.requestAtonAuth("ATON_GETALLINFO" , "" , "")
'	sRetItem = Split(sRet, "★")
'		
'	sErrorCode	= sRetItem[0]
'	sErrorMsg	= sRetItem[1]	
'	sSBVersion 	= sRetItem[2] 'SafeBox 버전
'	sAlias 		= sRetItem[3] '인증서일련번호(식별자)
'	
'	'발급시 인증서 일련번호에 해당하는 고객번호를 획득
'	g_sCsName = Form.LoadConfigData("MERITZATONAUTH2", sAlias)
'	
'	'식별자 없으면 앱에 간편인증 등록 정보 없는 것
'	if sAlias == "" or sAlias == null then
'		exit sub
'	end if
	
End Sub
'-----------------------------------------------------------------------------
'SafeBox 정보획득
function fnGetSBInfo(sParam)
	'-----------------------------------------------------------------------
	'ATON_GETALLINFO
	'-----------------------------------------------------------------------
	sRet = Form.requestAtonAuth("ATON_GETALLINFO" , "" , "")
	sRetItem = Split(sRet, "★")
	
	sErrorCode	= sRetItem[0]
	sErrorMsg	= sRetItem[1]
	g_SBVersion  	= sRetItem[2] 'SafeBox 버전 (에러여도 값 있음)
	g_SBAlias 	= sRetItem[3] '인증서일련번호(식별자)

	if sErrorCode == "00000" then
		
		'if sParam <> "ISSUE" then
			'발급시 인증서 일련번호에 해당하는 고객번호를 획득
			'g_CustNo = Form.LoadConfigData("MERITZATONAUTH", g_SBAlias) '발급 시, 고객번호를 앱에 저장 후 이값을 인증 시 사용 (인증서조회 1 transaction을 줄이고자 함)
		'end if
		
		return True
	else
		if sParam <> "ISSUE" then
			if sErrorCode == "E3201" then
				Form.MsgBox("안내", "메리츠 간편인증 등록 후\n이용해주세요.", "E3201", 7, "간편인증 등록","취소")
			else
				Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			end if
		end if
	
		return False
	end if
	
	return True
end function
'============================================================================
Sub procRequestAtonTR_INQUIRYCERT(paramKeyAlias)	
	sTranID = "ohhts_pauth_004"
	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , "MERITZSMART")	'매체구분코드
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CUST_NO" 					, 0 , g_CustNo)		'(고객번호, 일련번호 중 1개는 필수)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId)		'이용자접속기기ID
		
	DATAMANAGER.RequestTranData(sTranID)
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
		
	Form.MsgBox( "안내", szErrMsg, "", 6 )

End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_pauth_004" then
		sErrorCode 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" 					,0)
		sKeyAlias	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_SEQ_NO" 				,0) 		'인증서일련번호		
		g_sPauCustNo	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CUST_NO" 					,0) 	     '고객번호
		szPauDeviceID	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_USR_CCTN_MCTL_ID"   		,0) 	     '기기 UUID
		g_AtonBioYn	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_BIO_USE_YN"   				,0) 	     '지문/Face ID
		g_StartYMD	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_VLTE_STTG_YMD"   			,0) 	     '인증서유효시작년월일
		g_EndYMD		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_VLTE_EXPY_YMD"				,0) 	     '인증서유효만료년월일
		
		sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode , "")
		
		if sErrorCode  == "000000" or sErrorCode  == "E3201" then
		
		'000101은 필수항목 누락 시 사용하는 메시지
		elseif sErrorCode  == "030102" or sErorCode = "000101" then
			Form.MsgBox("안내", "메리츠 간편인증 등록 후\n이용해주세요.", "E3201", 7, "간편인증 등록","취소")
			exit sub
		else
			'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
			sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode , "")
			
			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if		
		
		CheckBioRegister()
		
	elseif szTranID == "obcsb_oimf_657r" then
		szGrpNo = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_657r", "OutBlock1", "GRP_NO" , 0 )	'0.정상
		
		szMsgbox = true
		
		Select Case Right(szGrpNo, 1)
		
		'등록 가능
		Case "0" 		
			szMsgbox = false
			
			Form.OpenNextPopup("mhetc90190_s1" , "" , "")
		'미성년자
		Case "1"
			szErrMsg = "미성년자는 간편인증 등록이\n불가합니다."
		'법인
		Case "2"
			szErrMsg = "법인은 간편인증 등록이\n불가합니다."
		'HTS 약정계좌 O & ID미등록 상태
		Case "3"
			szErrMsg = "ID등록 후 이용 가능합니다."
		'HTS 약정계좌 X & ID미등록 상태
		Case "4"
			szErrMsg = "온라인 서비스 신청 및 ID등록 후 이용 가능합니다."
		'정보노출자로 등록된 고객
		Case "5"
			szErrMsg = "서비스가 제한된 고객입니다."
		'휴대폰 미등록 계좌
		Case "6"
			szErrMsg = "당사에 등록된 휴대폰 정보가 없습니다.\n고객정보에 휴대폰 정보 등록 후 이용해주세요."
		'인증계좌 연결ID X & ID등록 상태
		Case "7"
			szMsgbox = false
			Form.OpenPopup("mpopup_auth" , "IDConnect" , "")
		'예외처리
		Case Else
			szErrMsg = "간편인증 등록이 불가합니다.(기타오류)"
		End Select
		
		if szMsgbox then
			Form.MsgBox( "안내", szErrMsg, "", 6 )
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	 '간편인증 재등록 안내 팝업
    if sKeyName == "mpopup_auth" then
	    if sRet == "register" then
			''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''등록불가조건 체크(서비스 호출)
		   DATAMANAGER.SetDataValue(0, "obcsb_oimf_657r", "InBlock1", "CSNO", 0, g_sPauCustNo		   )
		   DATAMANAGER.RequestTranData("obcsb_oimf_657r")
		   '''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''등록불가조건 체크(서비스 호출)
	    elseif sRet == "BioRegister" then
		    fnGetSBInfo("")
		    
		    Form.OpenFramePopup("mhetc90060_py" , "mhetc90190" , "")
		
		elseif sRet == "IDConnect" then
		    Form.OpenScreen("85000" , "")
		    
	    '생체인증 등록완료 후 로그인
	    elseif sRet == "BioFingerComplete" then
		    g_complete = "Y"
		    Form.SetEnvData(1, "login.input.atonathntchncode", "100") 
		    Form.OpenStartScreen()
	    elseif sRet == "BioFaceComplete" then
		    g_complete = "Y"
		    Form.SetEnvData(1, "login.input.atonathntchncode", "200") 
		    Form.OpenStartScreen()
	    end if
	
	'로그인 이후 로그인 권한 재설정
	elseif sKeyName == "Login_Type" then
		g_LoginType = sRet
		
		if Cint(g_LoginType) > 1 then
			
			g_LoginType = Form.GetSharedData("&LOGIN_TYPE", false )
			g_DeviceId  = Form.GetDeviceID2()
			g_sBioType = Form.getBiometryType() '생체/지문 기기 및 사용가능여부 판단 : 0.사용불가 1.TOUCH ID 2.FACE ID
			
			'생체인증 시는 로그인 시키니까 Shared변수 공유값 가져오자
			g_CustNo = Form.GetSharedData("&CUST_NUM", false)
			g_ScrPoint = Form.GetOpenLinkData()
			
			'생체인증일 때만 타도록
			if g_Open == "1" then
				'-----------------------------------------------------------------------
				'전문전송
				'-----------------------------------------------------------------------	
				procRequestAtonTR_INQUIRYCERT(sAlias)
				
			elseif g_Open == "2" then
				Form.OpenNextPopup("mhetc90192","","")
			end if

		end if
	'생체인증등록을 위해 PIN검증 완료
    elseif sKeyName == "mhetc90060_py" then
		if sRet == "ok" then
			'-----------------------------------------------------------------------
			'ATON_SETBIOSIGNATURE
			'-----------------------------------------------------------------------
			Form.requestAtonAuth("ATON_SETBIOSIGNATURE" , "" , "90190")
		end if
    end if
End Sub

'============================================================================
'BIO인증구분코드 획득
function fnGetCrtc()
	
	if g_sBioType == "2" then
		return "02" 
	else
		return "01"
	end if
	
end function
'============================================================================
Sub CheckBioRegister()
	'20230612 KBC : 체크순서 변경
	'	스마트폰 생체인증 지원여부 -> 스마트폰 생체정보 등록여부 -> 생체인증서버 등록정보
	'	g_sBioType : 0.사용불가 1.TOUCH ID 2.FACE ID
	'	sFingerEnrolled : "0".미등록 "1".등록
	
	'-------------------------------------------------------------------------	
	'바이오 지원여부
	'-------------------------------------------------------------------------	
	if g_sBioType = "0" then
		Form.MsgBox("안내", "생체인증 등록이 불가능한\n스마트폰입니다.", "", 6)
		exit sub
	end if
			
	'-----------------------------------------------------------------------
	'ATON_CHECKBIOSIGNATURE
	'-----------------------------------------------------------------------
	sRet = Form.requestAtonAuth("ATON_CHECKBIOSIGNATURE" , "" , "")
			
	sRetItem = Split(sRet, "★")
	
	sErrorCode	= sRetItem[0]
	sErrorMsg	= sRetItem[1]
	
	'E4106, E4108 에러일 때
	'Form.isTouchIDSupported() 함수에서 false 줌
	if sErrorCode <> "00000" then
		if sErrorCode == "E4106" then
			Form.MsgBox("안내", "시도 횟수가 너무 많습니다.\n다음에 등록해주세요.", "E4106", 6)
			exit sub
		end if
	end if
	
	'iOS 전용 함수 (이 함수가 없으면 setBio를 통해서만 권한 체크 가능함)
	sBioStatus = Form.getBiometryStatus()
	
	'생체인증 권한 없을 때
	if sBioStatus == "-6" then
		Form.MsgBox("안내", "생체정보 접근 권한을 확인해주세요.", "", 0)
		exit sub
	end if
	
	'지문/얼굴 등록여부 판단
	sFingerEnrolled = Form.isTouchIDSupported()
	
	if sFingerEnrolled <> "1" then
		if Form.GetSharedData("&OS_TYPE", false) == "1" then
			szErrMsg = "스마트폰에 등록된 지문이 없습니다.\n지문 등록 후 이용해주세요."
		else
			szErrMsg = "스마트폰에 등록된 생체 정보가 없습니다.\n생체 정보 등록 후 이용해주세요."
		end if
	
		Form.MsgBox("안내", szErrMsg, "", 6)
		exit sub
	end if
	
	'-------------------------------------------------------------------------	
	'생체 간편인증 등록여부 (g_AtonBioYn : 인증서버 조회)
	'-------------------------------------------------------------------------	
	'E4101일 때는 SKIP 
	'(그냥 재등록 시키면 됨. 이미 등록된 생체인증이 있는지 알림메시지 안띄워줘도 됨)
	if g_AtonBioYn = "Y" and sErrorCode <> "E4101" then
		Form.OpenPopup("mpopup_auth" , "BioRegister" , "")
		exit sub
	end if
	
	'20230612 KBC END
	
	'-------------------------------------------------------------------------	
	'바이오 등록여부
	'-------------------------------------------------------------------------		
	if fnGetSBInfo("") == False then 
		exit sub
	end if
	
	'20230612 KBC START : 지문/얼굴 등록여부 판단 (어차피 안탐)
	if sErrorCode == "00000" or sErrorCode == "E4101" or sErrorCode == "E4102" or sErrorCode == "E4103" then
		'바이오 등록시에는 아래 에러는 무시 (더 있는지 테스트필요)
		'	E4101 : 생체 등록 정보가 변경되었습니다.
		'	E4102 : 단말에 등록된 생체 정보가 없습니다.
		'	E4103 : 생체 인증 등록 키가 존재하지 않습니다.
	
		Form.MsgBox("안내", "생체인증을 추가로 등록 하시겠어요?", "BioRegister", 6)
	
	else
		Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
		exit sub
	end if

End Sub
'============================================================================
Sub Form_onTriggerEventAton(sEventName, sParam)
	'ATON_SETBIOSIGNATURE, ATON_VERIFYBIOSIGNATURE 만 여기로만 진입
	
	if sEventName == "ATON_SETBIOSIGNATURE_RETURN_90190E4108" then
		sRet = Split(sParam, "★")
	
		sErrorCode	= sRet[0]
		sErrorMsg	= sRet[1]			
		sBioSignature	= sRet[2]
		
		'생체인증 접근 권한 허용하지 않았을 때
		if sErrorCode == "E4108" then
			Form.MsgBox("안내", "생체정보 접근 권한을 확인해주세요.", "", 0)
		end if
		
		exit sub
	end if
	
	if sEventName == "ATON_SETBIOSIGNATURE_RETURN_90190" then
		
		sRet = Split(sParam, "★")
	
		sErrorCode	= sRet[0]
		sErrorMsg	= sRet[1]			
		sBioSignature	= sRet[2]
		
		'E4100	생체 데이터에 오류가 발생하였습니다.
		'E4101	생체 등록 정보가 변경되었습니다.
		'E4102	단말에 등록된 생체 정보가 없습니다.
		'E4103	생체 인증 등록 키가 존재하지 않습니다.
		'E4104	생체 인증에 실패하였습니다.
		'E4105	생체 인증을 취소하였습니다.
		'E4106	TouchID/FaceID가 잠겨있습니다.
		'E4107	단말에 등록된 패스워드가 없습니다.
		'E4108	생체 정보를 사용할 수 없습니다.
		
		if sErrorCode == "E4106" then
			Form.MsgBox("안내", "시도 횟수가 너무 많습니다.\n다음에 등록해주세요.", "E4106", 6)
			exit sub
		elseif sErrorCode == "E4105" then
			exit sub
		elseif sErrorCode == "E4108" then
			Form.MsgBox("안내", "생체정보 접근 권한을 확인해주세요.", "", 0)
			exit sub
		end if
		
		'-----------------------------------------------------------------------
		'PIN데이터입력받아야함 (1회) - 바이오등록 시, PIN번호 검증 필수
		'-----------------------------------------------------------------------
		g_PinPWD = Form.GetSharedData("90060py_AuthPwd", false)
		'-----------------------------------------------------------------------
		'전문전송
		'-----------------------------------------------------------------------
		procRequestAtonTR_REQBIO(sBioSignature, g_PinPWD)
	end if
End Sub
'============================================================================
Sub procRequestAtonTR_REQBIO(paramElsgCon, paramPinData)
	sTranID = "ohhts_pauth_111"
	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , "MERITZSMART")	'매체구분코드
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CUST_NO" 					, 0 , g_CustNo)		'고객번호
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_MSB_VRSN_VL" 				, 0 , g_SBVersion)	'mSB버전값 (라이브러리 버전 정보)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId)		'이용자접속기기ID
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_BIO_ELSG_CON"	 			, 0 , paramElsgCon)	'BIO전자서명내용
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_BIO_CRTC_DCD" 				, 0 , fnGetCrtc())	'BIO인증구분코드 (01 : 지문, 02 : 안면) 'FACEID가 안면인증 임
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_PIN_DATA_CON" 				, 0 , paramPinData)	'PIN데이터내용

	DATAMANAGER.RequestTranData(sTranID)		
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "ohhts_pauth_111" then
		sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" ,0)
		
		if sErrorCode <> "000000" then
			'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
			sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode, "")

			Form.MsgBox("안내", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if		
		
		if g_sBioType == "2" then
			g_AlarmRegi = "02"
			Form.OpenPopup("mpopup_auth" , "BioFaceComplete", "")
		else
			g_AlarmRegi = "03"
			Form.OpenPopup("mpopup_auth" , "BioFingerComplete", "")
		end if
		
		'알리미 발송
		DATAMANAGER.RequestTranData("obcsb_oimf_658a")
	end if
	
	if szTranID == "obcsb_oimf_658a" then
		
		szProsYN = DATAMANAGER.GetDataValue(0, "obcsb_oimf_658a", "OutBlock1", "PROS_YN" ,0)
		
		if szProsYN <> "Y" then
			Form.MsgBox("안내", "생체인증이 등록되었습니다.(알리미서비스 오류)", "close" , 6)
			exit sub
		end if
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'알리미 발송 서비스
	if szTranID == "obcsb_oimf_658a" then
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "PROS_CLS"			, 0 , "5"       ) '등록/재등록
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "UI_EASY_ATHN_KEY_VAL" , 0 , g_AlarmRegi) '간편인증/지문/Face ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "CSNO" 				, 0 , g_CustNo  ) 
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_658a", "InBlock1", "REG_YN_IQRY_KEY"		, 0 , g_SBAlias  ) 
	end if
End Sub

