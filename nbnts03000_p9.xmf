'============================================================================
' 해외선물옵션 관심종목 종목추가 화면
'============================================================================

'****************************************************************************
'  V  A  R  I  A  B  L  E
'****************************************************************************
Dim m_szData
Dim m_szUserID
Dim g_tblDefine



'****************************************************************************
'  F  O  R  M
'****************************************************************************
'============================================================================
Sub Form_OnFormInit( )
	m_szUserID = Form.GetSharedData("&USER_ID", false)
	
	g_tblDefine = { }
	g_tblDefine.nItemCount = 0
	g_tblDefine.szVrsnID = ""
	g_tblDefine.tLinkData = { }
	g_tblDefine.tGrpList = { }
	g_tblDefine.tItemList = { }
	
	initDefault( )
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'종목 중복 결과
	If sKeyName == "DUPLICATE_ITEMS" And sRet == "ok" Then
		table.insert( g_tblDefine.tItemList, 1, g_tblDefine.tLinkData )
		
		reqIntrGroupUpdate( )
	End If
End Sub



'****************************************************************************
'  T  R  A  N     D  A  T  A  M  A  N  A  G  E  R
'****************************************************************************
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim tValue, nCount
	
	' 관심그룹 리스트 수신
	If szTranID = "ohhts_intr_026r" Then
		g_tblDefine.tGrpList = { }
		
		g_tblDefine.szVrsnID = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock2" , "FID_VRSN_ID" , 0 )
		nCount = CInt( DATAMANAGER.GetDataCount( 0 , szTranID , "OutBlock1" ) )
		
		For i = 0 To nCount-1
			tValue = { }
			tValue.szGrpKey  = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "FID_CNCN_ISSU_GRP_ID" , i )
			tValue.szGrpName = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "FID_CNCN_GRP_NAME"    , i )
			
			If Not isNull( tValue.szGrpKey ) Then
				table.insert( g_tblDefine.tGrpList, tValue )
			End If
		Next
		
		grdList.selectrow = 0
		grdList_OnClickUp( 0 , "gnam" )
					
	' 관심종목 리스트 수신
	ElseIf szTranID == "ohhts_intr_027r" Then
		g_tblDefine.tItemList = { }
		
		nCount = CInt( DATAMANAGER.GetDataCount( 0 , szTranID , "OutBlock1" ) )
		g_tblDefine.nItemCount = nCount
		
		For i = 0 To nCount
			tValue = { }
			tValue.clscode = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "FID_CODE_CLS_CODE" , i )
			tValue.symbol  = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "FID_OVDV_ISCD" , i )
			tValue.memo    = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "FID_MEMO_CNTT" , i )
			tValue.exch    = Form.GetItemCodeInfo( tValue.symbol , "exchname" )
			tValue.korName = Form.GetItemCodeInfo( tValue.symbol , "name" )
			
			If Not isNull( tValue.symbol ) Then
				table.insert( g_tblDefine.tItemList, tValue )
			End If
		Next
			
	' 관심그룹 업데이트
	elseif szTranID == "ohhts_intr_029r" then
		if not isNull( g_tblDefine.tLinkData.symbol ) then
			Form.Toast( 0, "[" & g_tblDefine.tLinkData.symbol & "] 종목이 [" & grdList.GetCellData( "gnam", grdList.selectrow ) & "]에 등록되었습니다." , 0 )
		end if
		
		Form.CloseForm( )
			
	end if
End Sub



'****************************************************************************
'  C  O  N  T  R  O  L  L
'****************************************************************************
'============================================================================
Sub imgClose_OnClick( )
	Form.CloseForm( )
End Sub

'============================================================================
Sub btnCancel_OnClick( )
	imgClose_OnClick( )
End Sub

'============================================================================
Sub btnSave_OnClick( )
	If Not isDuplicate( ) Then
		reqIntrGroupUpdate( )
	End If
End Sub

'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szGrpKey
	szGrpKey = grdList.GetCellData( "grop", lRow )
	
	DATAMANAGER.SetDataValue( 0 , "ohhts_intr_027r" , "InBlock1" , "FID_USER_ID"          , 0 , m_szUserID )
	DATAMANAGER.SetDataValue( 0 , "ohhts_intr_027r" , "InBlock1" , "FID_CNCN_ISSU_GRP_ID" , 0 , szGrpKey )
	DATAMANAGER.RequestTranData( "ohhts_intr_027r" )
End Sub



'****************************************************************************
'  P  E  R  S  O  N  A  L
'****************************************************************************
'============================================================================
' 기본 정보 및 컨트롤 설정
'============================================================================
Sub initDefault( )
	m_szData = Form.GetOpenLinkData( )
	
	If not isNull( m_szData ) Then
		g_tblDefine.tLinkData.clscode = "1"
		g_tblDefine.tLinkData.symbol  = m_szData
		g_tblDefine.tLinkData.memo    = ""
		g_tblDefine.tLinkData.exch    = Form.GetItemCodeInfo( m_szData , "exchname" )
		g_tblDefine.tLinkData.korName = Form.GetItemCodeInfo( m_szData , "name" )
	End If
	
	' 관심그룹 리스트 조회
	DATAMANAGER.SetDataValue( 0 , "ohhts_intr_026r" , "InBlock1" , "FID_USER_ID" , 0 , m_szUserID )
	DATAMANAGER.RequestTranData( "ohhts_intr_026r" )
End Sub

'============================================================================
' 중복종목 체크
'============================================================================
Function isDuplicate( )
	If #g_tblDefine.tItemList > 0 Then
		For _, val in pairs( g_tblDefine.tItemList )
			If "table" == type(val) Then
				If ( val.symbol == g_tblDefine.tLinkData.symbol ) Then
					Form.MsgBox( "알림", "[" & g_tblDefine.tLinkData.symbol & "] 은(는) 이미 등록되어 있습니다.\r\n\n중복해서 등록하시겠습니까?", "DUPLICATE_ITEMS", 1)
					return true
				End If
			End If
		Next
	End If
	
	table.insert( g_tblDefine.tItemList, 1, g_tblDefine.tLinkData )
	return false
End Function

'============================================================================
' 관심그룹 추가 : ohhts_intr_029r
'============================================================================
Sub reqIntrGroupUpdate( )
	Dim szTranID
	szTranID = "ohhts_intr_029r"
	
	If g_tblDefine.nItemCount < 100	Then
		Dim szGrpKey, szGrpName, nSelIndex
		nSelIndex = grdList.selectrow
		
		szGrpKey = grdList.GetCellData( "grop", nSelIndex )
		szGrpName = grdList.GetCellData( "gnam", nSelIndex )
		
		If isNull( szGrpKey ) Then
			Form.ShowAlert( "알림", "관심그룹을 선택하세요." )
			Exit Sub
		End If
		
		DATAMANAGER.ClearInputData( 0 , szTranID )
		
		DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FID_USER_ID"     , 0 , m_szUserID )	' FID사용자ID
		DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FID_VRSN_ID"     , 0 , g_tblDefine.szVrsnID ) ' FID버전ID	
		DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FID_MOD_YN"      , 0 , "0" ) ' FID수정여부				
		DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FID_ISSU_MOD_YN" , 0 , "0" ) ' FID종목수정여부
		
		DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock2" , "FID_CNCN_ISSU_GRP_ID" , 0 , szGrpKey ) ' FID관심종목그룹ID
		DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock2" , "FID_CNCN_GRP_NAME"    , 0 , szGrpName ) ' FID관심그룹명	
		DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock2" , "FID_ISSU_MOD_YN"      , 0 , "1" ) ' FID종목수정여부
		
		If Null <> g_tblDefine.tItemList And table.getn( g_tblDefine.tItemList ) > 0 Then
			For i = 0 To table.getn( g_tblDefine.tItemList ) - 1
				DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock3" , "FID_CNCN_ISSU_GRP_ID"    , i , szGrpKey ) ' FID관심종목그룹
				DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock3" , "FID_CNCN_ISSU_ID2"       , i , Change_Len(i) ) ' FID관심종목
				DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock3" , "FID_CODE_CLS_CODE"       , i , g_tblDefine.tItemList[i].clscode ) ' 종목 / FID코드구분코드
				DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock3" , "FID_OVDV_ISCD"           , i , g_tblDefine.tItemList[i].symbol ) ' FID관심종목코드
				DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock3" , "FID_MEMO_CNTT"           , i , g_tblDefine.tItemList[i].memo ) ' FID메모내용
				DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock3" , "FID_INPUT_MRKT_CLS_CODE" , i , g_tblDefine.tItemList[i].exch ) ' FID입력시장구분코드
			Next
		End If
		
		DATAMANAGER.RequestTranData( szTranID )
	Else
		Form.ShowAlert( "알림", "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
	End If
End Sub

'============================================================================
' null 체크
'============================================================================
Function isNull(str)
	if null == str or "" == str or Len(Trim(str)) <= 0 then
		return true
	end if
	
	return false
End Function

'============================================================================
Function _tonumber(str)
	return tonumber(str) or 0
End Function

'============================================================================
' Change_Len
'============================================================================
Function Change_Len(szData)
	if Len(szData) == 1 then
		Change_Len = "0" & CStr(szData)
	else
		Change_Len = CStr(szData)
	end if 
End Function

