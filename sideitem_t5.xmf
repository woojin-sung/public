	<SCRIPT_INFO _len="13205" _ulen="12275" >
'============================================================================
' 01. 화 면 명 : 사이드종목_계좌잔고
' 02. 화면설명 : 사이드종목_계좌잔고
' 03. 작    성 : 2023.04.19 신규작성 KKM
' 2024.01.17 : 전상일 : v0001 : 계좌표시순서 적용을 위한 id 맵핑
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
'Dim nCellType			'토글 상태를 구분하기 위한 변수
Dim g_szCust_Num		'고객번호
Dim szACNO			'계좌번호

Dim g_szSelectedItem	'그리드 선택된 아이템
Dim g_szJumin           '사용자 주민번호 
Dim g_nTva              '평가금액 총합
Dim g_nTaa              '출금가능금액 총합
Dim g_sSelRow

'--- 확인필요

Dim nAmt
Dim nPrlsamt
Dim nDrngamt
Dim nPrlsrate
Dim szAcc
Dim szGrdname
Dim szGrdname1
Dim grdIdx
Dim szAccprcd			'20221110 HSZ 1차 개선 건

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetInput(szData) : TR의 입력값 세팅
'============================================================================
Function SetInput(szData)
	DATAMANAGER.SetDataValue( 0 , "obacb_balc_153r", "InBlock1", "CSNO" , 0 , szData)
	'v0001 : 계좌표시순서 적용을 위한 id 맵핑
	szCustID = Form.GetSharedData("&USER_ID", false)
	DATAMANAGER.SetDataValue( 0 , "obacb_balc_153r", "InBlock1", "ELFN_ID" , 0 , szCustID)
	DATAMANAGER.RequestTranData( "obacb_balc_153r" )	
End Function

'============================================================================
' RequestData : 20160330 미로그인시 Refresh이벤트로 인해 오류현상발생으로 함수화
'============================================================================
Function RequestData()
	Dim sLOGIN_TYPE 
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )

	if CInt(sLOGIN_TYPE) > 1 then '로그인 상태
		szDate = right(Form.GetSharedData("&HOST_DATE" , false), 6)
		lblDate.caption = szDate
		szACNO = ""
		
		g_szCust_Num = Form.GetSharedData("&CUST_NUM", false )		'로그인 해야만 고객번호 받아옴
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_151r", "InBlock1", "CSNO" , 0 , g_szCust_Num)
		DATAMANAGER.RequestTranData( "obacb_balc_151r" )
		
		grd1.SetClear()
		grd2.SetClear()
		grdCmb.SetClear()
		
		DATAMANAGER.SetDataValue( 0, "ooopc_cuma_093r", "InBlock1", "CSNO" , 0 , g_szCust_Num)
		DATAMANAGER.RequestTranData("ooopc_cuma_093r")	'종합계좌 리스트 조회
	
		grdIdx = 0
		Call SetInput(g_szCust_Num)

	else
		Form.MsgBox( "알림", "로그인이 필요한 화면입니다.\n로그인 하시겠습니까?", "NEED_LOGIN", 2 )
		
	end if
End Function

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()		자산유형 출력값 세팅
'============================================================================
Sub Form_OnFormInit()
	grd1.setUseCardView(true, 10, "bg_infobox.9")	
	
	RequestData()		
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "&LOGIN" then
		RequestData()	
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if (sKeyName == "NEED_LOGIN") then
		if (sRet == "ok") then	
			Form.OpenPopup( "mhetc90021" , "2" , "" )
		end if 
	end if 
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim szListItems
	
	if sKeyName = "MOVEPOP_RETURN"	then
		szListItems	=	split(sRet,"★")
		
		if	szListItems(1)	=	"0"	then			'이체
			Form.OpenScreen("61010" , g_szSelectedItem & "★" & "0") 
		elseif	szListItems(1)	=	"1"	then		'입출금
		    szPrcd =  grdAcc.GetCellData( "bd_cell4", g_sSelRow )
		    szBkop =  grdAcc.GetCellData( "bd_cell6", g_sSelRow )

		    if szPrcd == "101" then
		       if szBkop == "N" then
		          Form.OpenScreen("61060" , g_szSelectedItem & "★" & "0")
			   else 
			      Form.OpenScreen("61020" , g_szSelectedItem & "★" & "2") '은행입출금
			   end if
			elseif szPrcd == "105" or szPrcd == "106" or szPrcd == "107" or szPrcd == "108" then
			   Form.OpenScreen("61020" , g_szSelectedItem & "★" & "2") 
			else   
			   Form.OpenScreen("61060" , g_szSelectedItem & "★" & "0")
			end if   
		end if	
	end if	
End Sub

'============================================================================
Sub Form_OnRefresh()
	RequestData()	
End Sub

'============================================================================
