	<SCRIPT_INFO _len="1447" _ulen="1327" >
Dim szCheck

'============================================================================
Sub Button0_OnClick()
	Form.SendReturnToParent( "Close" , sData)
	Form.CloseForm()
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.SendReturnToParent( "Close" , sData)
	Form.CloseForm()
End Sub


'============================================================================
'Button2_OnClick - 입출력내역
'============================================================================
Sub Button2_OnClick()
'	Form.OpenScreen("61060", "")
	Form.SendReturnToParent( "Close" , "61060")
	Form.CloseForm()
End Sub


'============================================================================
' Button1_OnClick - 지연이체접수내역
'============================================================================
Sub Button1_OnClick()
'	Form.OpenScreen("61010", "1")
	Form.SendReturnToParent( "Close" , "61010")
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szData
	szData = Form.GetOpenLinkData()
	
	szCheck = Trim(szData)
	
	if szCheck == "Y" then	' 지연이체접수
		Label1.caption = "지연이체 접수되었습니다.\n접수내역을 확인하세요."
	else	
		Label1.caption = "대체처리 되었습니다.\n입출금내역을 확인하세요."
	end if
End Sub

