'============================================================================
' btnBack_OnClick
'============================================================================
Sub btnBack_OnClick()
	Dim nLen
	nLen = Len(edtPrc.caption)

	if nLen <> 0 then
		szPrc = Left(edtPrc.caption, nLen-1)
		edtPrc.caption = szPrc
	else
		'EK ADD
		edtInit.visible = true
	end if
	
	g_szReceive = ""
End Sub

'============================================================================
' btnClear_OnClick
'============================================================================
Sub btnClear_OnClick()
	edtPrc.caption = ""
	
	'EK ADD
	edtInit.visible = true
End Sub

'============================================================================
' btnConfirm_OnClick
'============================================================================
Sub btnConfirm_OnClick()
	szPrc = edtPrc.caption
	Form.SendReturnToParent("PRC_POPUP", szPrc)
	Form.CloseForm()
End Sub

'============================================================================
' LblClose_OnClick : 닫기
'============================================================================
Sub LblClose_OnClick()
	Form.SendReturnToParent("PRC_POPUP", g_szopenPrc)
	Form.CloseForm()
End Sub
'============================================================================
Sub Form_OnRefresh()
	Form.CloseForm()
End Sub

'============================================================================
' BtnClose_OnClick : 닫기
'============================================================================
Sub BtnClose_OnClick()
	if g_szopenPrc == 0 or g_szopenPrc == "" or g_szopenPrc == null then
		edtInit.visible = true
	else
		edtInit.visible = false
	end if
	
	Form.SendReturnToParent("PRC_POPUP", g_szopenPrc)
						
	Form.CloseForm()	
End Sub

