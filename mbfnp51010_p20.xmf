' 20160317 가격 Max : 7 (전요셉과장)

'============================================================================
' 화 면 명 : 주식주문_가격입력창
' 화면설명 : 주식주문 가격입력시
' 작    성 : 2016.02.15 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCd, g_szMk, g_szUnit, g_szType, g_szReceive, g_szopenPrc
g_szCd, g_szMk, g_szUnit, g_szType, g_szReceive = "", "", "", "", ""

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn)
	Dim szPrc, szUnit, szHigh, szLow, szHyun, nResult
	
	g_szReceive = ""
	szPrc  = edtPrc.caption

	 ' 20160317 예외처리 추가 //////////////////////////////////////////////
	if Trim(szPrc) <> "" then
		if CDbl(szPrc) >= 9900000 then
			if nGbn == 0 then
				Exit Function
			end if
		end if
	end if
	' //////////////////////////////////////////////////////////////////////
	
	Sum_Prc(szPrc)
End Function

'============================================================================
' Calc_Plus
'============================================================================
Function Calc_Plus(nPlus)
	Dim szPrc
	
	edtInit.visible = false

	if g_szReceive == "1" then
		g_szReceive = ""
		edtPrc.caption = nPlus
	else
		szPrc = edtPrc.caption
		
		szPrc = szPrc & nPlus
		Sum_Prc(szPrc)
	end if
End Function

'============================================================================
' Calc_Zero
'============================================================================
Function Calc_Zero(szPlus)
	Dim szPrc
	
	edtInit.visible = false

	if g_szReceive == "1" then
		g_szReceive = ""
		edtPrc.caption = ""
	else
		szPrc = edtPrc.caption	
		
		if Len(edtPrc.caption) > 0 then
			szPrc = edtPrc.caption & szPlus
			
			Sum_Prc(szPrc)
		end if
	end if
End Function

'============================================================================
' Sum_Prc
'============================================================================
Function Sum_Prc(szData)
	if Len(szData) < 13 then		' Max 12
		edtPrc.caption = szData
	end if
End Function	
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	
	Form.SetScreenName("가격입력기")
	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) <> "" then
		tData = Split(szOpen, "★")
		
		g_szopenPrc	= tData(0)
		edtPrc.caption = g_szopenPrc

		g_szMaxPrc	= tData(1)
		
'		tData = int(szOpen)
'		g_szopenPrc = tData
'		edtPrc.caption = tData

	else
		g_szReceive = "1"
		tData = 0
		
		edtInit.visible = true
	end if
	
	
	LblClose.visible = 0	'X(닫기) 버튼.
	imgClose.visible = 0
	
End Sub

