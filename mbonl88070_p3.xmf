					<ROW_INFO ly_vert_height="20,20,20" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" halign="0" line="0,0" caption="금융소비자가 충분히 이해 없이 확인했다고 답변할 경우" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,1,0,1" halign="0" line="0,0" caption="추후 소송이나 분쟁에서 소비자에게 불리하게 작용할 수" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,2,0,2" halign="0" line="0,0" caption="있으니 신중하게 답변해주시기 바랍니다." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<LABEL name="lblTitle0" fgcolor="326:228073065" fontsize="-2" fontstyle="01" caption="1.  금융상품의 주요사항, 투자위험, 불이익/권리사항을 
      확인하셨나요?" valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,117,335,40,1" />
				<RADIOGROUP name="rdoQuestion0" fontsize="-2" buttonshape="1" ly_vert="20,162,335,40,1" >
					<RADIO_INFO>
						<RADIO no="0" text="예" radioimage="input_01.9.png" position="0,0,162,40" />
						<RADIO no="1" text="아니오" radioimage="input_01.9.png" position="172,0,162,40" />
					</RADIO_INFO>
				</RADIOGROUP>
				<LABEL name="lblTitle1" fgcolor="326:228073065" fontsize="-2" fontstyle="01" caption="2.  본 상품은 예금자 보호법에 따라 예금보험공사가 보호
      하지 않는 상품임을 확인하셨습니까?" valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,242,335,40,1" />
				<RADIOGROUP name="rdoQuestion1" fontsize="-2" buttonshape="1" ly_vert="20,287,335,90,1" >
					<RADIO_INFO>
						<RADIO no="0" text="원금손실은 발생 할 수 있음" radioimage="input_01.9.png" position="0,0,335,40" />
						<RADIO no="1" text="원금손실은 발생하지 않음" radioimage="input_01.9.png" position="0,50,335,40" />
					</RADIO_INFO>
				</RADIOGROUP>
				<LABEL name="lblTitle2" fgcolor="326:228073065" fontsize="-2" fontstyle="01" caption="3.  본 상품의 원금손실위험 발생 가능성을
      확인하시고 이해하셨습니까?" valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,417,335,40,1" />
				<RADIOGROUP name="rdoQuestion2" fontsize="-2" buttonshape="1" ly_vert="20,462,335,40,1" >
					<RADIO_INFO>
						<RADIO no="0" text="이해하지 못하였음" radioimage="input_01.9.png" position="0,0,162,40" />
						<RADIO no="1" text="내용확인 후 이해하였음" radioimage="input_01.9.png" position="172,0,162,40" />
					</RADIO_INFO>
				</RADIOGROUP>
				<LABEL name="lblTitle3" fgcolor="326:228073065" fontsize="-2" fontstyle="01" caption="4.  발행사의 신용위험(부도, 파산 등) 및 시장위험 등에
      따라 원금의 일부 또는 전부손실이 발생할 수 있다는
      사실을 이해하셨습니까?" valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,542,335,56,1" />
				<RADIOGROUP name="rdoQuestion3" fontsize="-2" buttonshape="1" ly_vert="20,608,335,90,1" >
