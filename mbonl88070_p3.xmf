	<SCRIPT_INFO _len="2661" _ulen="2649" >


'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("이해여부 확인")
	
	contMain.lblTitle0.changeTextAttr(0, 2, 4, -2, true)
	contMain.lblTitle1.changeTextAttr(0, 2, 4, -2, true)
	contMain.lblTitle2.changeTextAttr(0, 2, 4, -2, true)
	contMain.lblTitle3.changeTextAttr(0, 2, 4, -2, true)
	contMain.lblTitle4.changeTextAttr(0, 2, 4, -2, true)
	
	btnNext.enable = false
End Sub

'============================================================================
Function f_CheckAnswer()
	if CInt(contMain.rdoQuestion0.currentindex) == 1 or CInt(contMain.rdoQuestion1.currentindex) == 1 or CInt(contMain.rdoQuestion2.currentindex) == 0 or 
		CInt(contMain.rdoQuestion3.currentindex) == 1 or CInt(contMain.rdoQuestion4.currentindex) == 1 then
		
		btnNext.enable = false
		
	elseif CInt(contMain.rdoQuestion0.currentindex) == 0 and CInt(contMain.rdoQuestion1.currentindex) == 0 and CInt(contMain.rdoQuestion2.currentindex) == 1 and
		CInt(contMain.rdoQuestion3.currentindex) == 0 and CInt(contMain.rdoQuestion4.currentindex) == 0 then
		
		btnNext.enable = true
		
	else	
		btnNext.enable = false
	end if
End Function

'============================================================================
Sub contMain_rdoQuestion0_OnClick(nIndex)
	if nIndex == 0 then
		contMain.lblError0.visible = false
	else
		contMain.lblError0.visible = true
	end if
	f_CheckAnswer()
End Sub

'============================================================================
Sub contMain_rdoQuestion1_OnClick(nIndex)
	if nIndex == 0 then
		contMain.lblError1.visible = false
	else
		contMain.lblError1.visible = true
	end if
	f_CheckAnswer()
End Sub

'============================================================================
Sub contMain_rdoQuestion2_OnClick(nIndex)
	if nIndex == 0 then
		contMain.lblError2.visible = true
	else
		contMain.lblError2.visible = false
	end if
	f_CheckAnswer()
End Sub

'============================================================================
Sub contMain_rdoQuestion3_OnClick(nIndex)
	if nIndex == 0 then
		contMain.lblError3.visible = false
	else
		contMain.lblError3.visible = true
	end if
	f_CheckAnswer()
End Sub

'============================================================================
Sub contMain_rdoQuestion4_OnClick(nIndex)
	if nIndex == 0 then
		contMain.lblError4.visible = false
	else
		contMain.lblError4.visible = true
	end if
	f_CheckAnswer()
End Sub

'============================================================================
Sub btnNext_OnClick()
	Form.SendReturnToParent("mbonl88070_p3", "ok")
	Form.CloseForm()
End Sub

