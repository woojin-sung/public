						<RADIO no="1" text="이해하지 못하였음" radioimage="input_01.9.png" position="0,50,335,40" />
					</RADIO_INFO>
				</RADIOGROUP>
				<LABEL name="lblTitle4" fgcolor="326:228073065" fontsize="-2" fontstyle="01" caption="5.  발행어음 투자설명서(상품설명서)에서 상품에 대한
      내용을 확인하고 이해하셨습니까?" valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,738,335,40,1" />
