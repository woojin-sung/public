'--===========================================================================
' 01. 화 면 명 : 신용담보활용동의
' 02. 화면설명 : 신용담보활용동의
' 03. 작    성 : 2021.11.24 김수진 
' 04. 수    정 : 
' 2021.12.22	: KSJ : 유통잔고 동의시 약관 설명서 확인 필수 추가
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szPlain_rm		'메모리 평문적용 여부
Dim g_szTrx_Tp		'처리구분 (I:등록, U:수정)
Dim g_szBf_AgrmIdx	'조회된 동의여부 인덱스
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_ClearData() : 초기화
'============================================================================
Function f_ClearData()
	g_szTrx_Tp = ""
	g_szBf_AgrmIdx = ""
	
	contBody.rdoSelect.enable = true
	contBody.rdoSelect.currentindex = -1
	
	contBody.rdoReject.currentindex = -1
	contBody.rdoReject.enable = false
	
	'약관/설명서 확인 및 동의 초기화	
	contBody.ChkView1.chksilence = "0"
	contBody.ChkView2.chksilence = "0"
	contBody.ChkView1.enable = false
	contBody.ChkView2.enable = false
	contBody.btnView1.enable = false
	contBody.btnView2.enable = false
	
	'실행버튼 비활성화 (정보조회후 활성화처리)
	BtnOK.enable = False
End Function

'===========================================================================
' f_GetPWCkeck() : 계좌비밀번호 입력체크함수
'===========================================================================
Function f_GetPWCkeck()
	Dim szACNT_PWD 
	szACNT_PWD = Form.GetCtlProp( "edtPswd", "caption" )
	
	If szACNT_PWD == null or szACNT_PWD == "" Then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	End If
	
	return false
End Function	
'============================================================================
' f_OpenUrl() : 약관 OPEN
'============================================================================
Function f_OpenUrl(szTitle, szUrl)
	If f_GetPWCkeck() Then
		contBody.ChkView1.chksilence = "0"
		contBody.ChkView2.chksilence = "0"
		Exit Function
	End if

	If szTitle <> "" and szTitle <> null and szUrl <> "" and szUrl <> null Then
		Form.SetSharedData("OPEN_URL", szURL )
		Form.OpenFramePopup("mbonl82020_p6" , szTitle , "") 	
	End If
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()    
	f_ClearData()
	edtPswd.caption = ""

	'메모리평문적용여부(0:미적용 / 1:적용)
	g_szPlain_rm 		= Form.GetSharedData("&PLAIN_RM", false)
End Sub

'============================================================================
' Form_OnRefresh()
'============================================================================
Sub Form_OnRefresh()
	f_ClearData()
	edtPswd.caption = ""	
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "mbonl82020_p6" Then
		If sRet == "신용거래설명서" Then
			contBody.ChkView1.chksilence = "1"
		ElseIf sRet == "신용거래약관" Then
			contBody.ChkView2.chksilence = "1"
		End If
	End If
End Sub

'============================================================================
' acntList_ChangeAccount() : 다른 계좌로 변경 
'============================================================================
Sub acntList_ChangeAccount()
	f_ClearData()
	edtPswd.caption = ""
End Sub

'============================================================================
' edtPswd_OnEditComplete() : 비밀번호 입력완료시 초기화 및 신용 담보활용 동의/철회 조회
'============================================================================
Sub edtPswd_OnEditComplete()
	f_ClearData()
	
	'신용 담보활용 동의/철회 조회
	DATAMANAGER.RequestTranData("oblon_basc_703r")	
End Sub

'============================================================================
' contBody_rdoSelect_OnClick() : 담보활용 동의 여부를 선택 
'============================================================================
Sub contBody_rdoSelect_OnClick(nIndex)
	'비밀번호 확인
	If f_GetPWCkeck() Then
		contBody.rdoSelect.currentindex = -1
		Exit Sub
	End If


	If nIndex == 0 Then
		contBody.ChkView1.enable = true
		contBody.ChkView2.enable = true
		contBody.btnView1.enable = true
		contBody.btnView2.enable = true
	Else
		contBody.ChkView1.chksilence = "0"
		contBody.ChkView2.chksilence = "0"	
		contBody.ChkView1.enable = false
		contBody.ChkView2.enable = false
		contBody.btnView1.enable = false
		contBody.btnView2.enable = false	
	End If
End Sub

'============================================================================
' 약관/설명서 확인 및 동의
'============================================================================
'============================================================================
' contBody_ChkView1_OnChange() : 신용거래설명서
'============================================================================
Sub contBody_ChkView1_OnChange(sCheckState)
	If sCheckState == "1" Then
		contBody.ChkView1.chksilence = "0"
		Dim szURL 
		If g_szServerMode = "1" Then
			szURL = "http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/meritz_info_03.pdf"
		Else
			szURL = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_03.pdf"
		End If
		f_OpenUrl("신용거래설명서", szUrl)
	End If
End Sub

'============================================================================
' contBody_ChkView2_OnChange() : 신용거래약관
'============================================================================
Sub contBody_ChkView2_OnChange(sCheckState)
	If sCheckState == "1" Then
		contBody.ChkView2.chksilence = "0"
		Dim szURL 
		If g_szServerMode = "1" Then
			szURL = "https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/meritz_yk_9.pdf"
		else
			szURL = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_yk_9.pdf"
		End If
		f_OpenUrl("신용거래약관", szUrl)
	End If
End Sub

'============================================================================
' contBody_btnView1_OnClick() : 신용거래설명서
'============================================================================
Sub contBody_btnView1_OnClick()
	Dim szURL 
	If g_szServerMode = "1" Then
		szURL = "https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_03.pdf"
	Else
		szURL = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_03.pdf"
	End If
	f_OpenUrl("신용거래설명서", szUrl)
End Sub

'============================================================================
' contBody_btnView2_OnClick() : 신용거래약관
'============================================================================
Sub contBody_btnView2_OnClick()
	Dim szURL 
	If g_szServerMode = "1" Then
		szURL = "https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/meritz_yk_9.pdf"
	else
		szURL = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_yk_9.pdf"
	End If
	f_OpenUrl("신용거래약관", szUrl)
End Sub

'============================================================================
' BtnOK_OnClick() : 실행 
'============================================================================
Sub BtnOK_OnClick()
	'비밀번호 확인
	If f_GetPWCkeck() Then
		Exit Sub
	End If
	
	If g_szTrx_Tp == "X" then
		Form.ShowAlert("알림", "철회신청일로부터 5영업일 이후에 동의신청 가능합니다.")
		Exit Sub
	End if
	
	'담보활용 동의 여부 체크 확인
	If CStr(contBody.rdoSelect.currentindex) == "-1" Then
		Form.ShowAlert("알림", "담보활용 동의 여부를 선택해 주세요.")
		Exit Sub
	End If
	
	'중복처리 체크
	If g_szTrx_Tp == "U" and (g_szBf_AgrmIdx == CStr(contBody.rdoSelect.currentindex)) Then
		Form.ShowAlert("알림", "담보활용 동의 여부를 확인해 주세요. (기등록된 내역 입니다)")
		Exit Sub	
	End If
	
	'약정확인 체크
	If CStr(contBody.rdoSelect.currentindex) == "0" Then
		If contBody.ChkView1.chksilence == "0" Then
			Form.MsgBox( "알림", "신용거래설명서에 동의하셔야 합니다.", "", 6 )	
			Exit Sub
		End If
		If contBody.ChkView2.chksilence == "0" Then
			Form.MsgBox( "알림", "신용거래약관에 동의하셔야 합니다.", "", 6 )	
			Exit Sub
		End if
	End If
	
	'신용 담보활용 동의/철회 등록
	DATAMANAGER.RequestTranData("oblon_basc_703a")
End Sub


'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 통신에 필요한 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNT_PWD 
	if g_szPlain_rm == "1" then  			'MTS메모리평문 적용상태일때
	    szACNT_PWD = edtPswd.caption
	else  								'MTS메모리평문 미적용상태일때
	    szACNT_PWD = Form.GetEncData(edtPswd.caption)
	end if
	
	'신용 담보활용 동의/철회 조회
	If szTranID == "oblon_basc_703r" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"          , 0 , acntList.total	)	'Left(acntList.caption, 8)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO"          , 0 , acntList.sequence	)	'Right(acntList.caption, 2)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD"      , 0 , szACNT_PWD		)
	
	'신용 담보활용 동의/철회 등록
	ElseIf szTranID == "oblon_basc_703a" Then
		Dim szAGRM_YN
		If contBody.rdoSelect.currentindex == "0" or contBody.rdoSelect.currentindex == 0 then
			szAGRM_YN = "Y"
		Else
			szAGRM_YN = "N"
		End If		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"         	 	, 0 , acntList.total		)	'Left(acntList.caption, 8)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO"          		, 0 , acntList.sequence	)	'Right(acntList.caption, 2)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD"      		, 0 , szACNT_PWD			)		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE"      , 0 , g_szTrx_Tp			)	'처리구분 (I:등록, U:수정)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "AGRM_YN"      		, 0 , szAGRM_YN			)
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'신용 담보활용 동의/철회 조회
	If szTranID == "oblon_basc_703r" Then
		BtnOK.enable = True
		
		'담보활용 동의 구분값 세팅
		Dim szBf_Agrm_Yn 'Y:동의, N:철회, X:철회 중
		szBf_Agrm_Yn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_COND_RSLT_CLS_VAL", 0)
		
		if szBf_Agrm_Yn = "Y" then
			contBody.rdoSelect.enable = true
			contBody.rdoSelect.currentindex = 0
			g_szTrx_Tp = "U" 			'기등록된내역 -> 수정
			
			contBody.rdoReject.enable = false
			
			'약관/설명서 확인 및 동의
			contBody.ChkView1.enable = true
			contBody.ChkView2.enable = true
			contBody.btnView1.enable = true
			contBody.btnView2.enable = true
			
		elseif szBf_Agrm_Yn = "N" then
			contBody.rdoSelect.enable = true
			contBody.rdoSelect.currentindex = 1
			g_szTrx_Tp = "U" 			'기등록된내역 -> 수정
			
			contBody.rdoReject.enable = false
			
		elseif szBf_Agrm_Yn = "X" then
			contBody.rdoSelect.currentindex = -1
			contBody.rdoSelect.enable = false
			g_szTrx_Tp = "X"
			
			contBody.rdoReject.currentindex = 0
			contBody.rdoReject.enable = true
			
		else 
			contBody.rdoSelect.enable = true
			contBody.rdoSelect.currentindex = -1
			g_szTrx_Tp = "I"			'등록
			
			contBody.rdoReject.enable = false
		end if
		
		g_szBf_AgrmIdx = CStr(contBody.rdoSelect.currentindex)
		
	'신용 담보활용 동의/철회 등록	
	ElseIf szTranID == "oblon_basc_703a" Then
		Form.ShowAlert("알림", "등록 완료되었습니다.")
		
		f_ClearData()
		'신용 담보활용 동의/철회 조회
		DATAMANAGER.RequestTranData("oblon_basc_703r")		
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubMsg <> NULL and szSubMsg <> "" Then
		Form.ShowAlert( "알림", szErrMsg & "(" & szSubMsg & ")" )
	Else
		Form.ShowAlert( "알림", szErrMsg )
	End If
End Sub





