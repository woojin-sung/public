--===========================================================================
--===========================================================================
Dim g_szSeparator

Dim GridBankRowCount
Dim GridSecRowCount

Dim g_szBankCode
Dim g_szBankName
Dim g_szBankAcno

Dim g_szLNKD_BANK_CLS_CODE 
Dim g_szTR_DATE            
Dim g_szOTSD_TR_UNIQ_NO    
Dim g_szTACT_LNKD_ISTU_CODE
Dim g_szTACT_STND_TR_CODE  
Dim g_szLNKD_TLMS_MNNO     
Dim g_szRcvn_iqry_tmnu   

'============================================================================
' Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	Container0.ContainerBank.GridBank.setMaintainingRatio( "bd_Bimage1" , 0, "1")
	Container0.ContainerBank.GridBank.setMaintainingRatio( "bd_Bimage2" , 0, "1")
	Container0.ContainerSec.GridSec.GridBank.setMaintainingRatio( "bd_Bimage1" , 0, "1")
	Container0.ContainerSec.GridSec.GridBank.setMaintainingRatio( "bd_Bimage2" , 0, "1")
End Sub

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Container0.ContainerBank.GridBank.SetClear()
	Container0.ContainerSec.GridSec.SetClear()
	
	GridBankRowCount = 0
	GridSecRowCount = 0
	
	DATAMANAGER.RequestTranData("obtsp_comm_001r")

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	szACNO = acntList.total
	szASNO = acntList.sequence
	
	If szTranID = "obtsp_comm_001r" then
		If CStr(Container0.Tab0.currenttab) == "0" then
			DATAMANAGER.SetDataValue(0, "obtsp_comm_001r", "InBlock1", "ISTU_CLCD" , 0 , "1")	'은행
		Else
			DATAMANAGER.SetDataValue(0, "obtsp_comm_001r", "InBlock1", "ISTU_CLCD" , 0 , "2")	'증권
		end if

		DATAMANAGER.SetDataValue(0, "obtsp_comm_001r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1")	'메리츠 포함
	end if
End Sub

'============================================================================
' 데이터 수신 
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtsp_comm_001r" Then
		tmpcount = DATAMANAGER.GetDataCount( 0 , "obtsp_comm_001r", "OutBlock1")	
		image1	=""
		name1	=""
		code1	=""
		image2	=""
		name2	=""
		code2	=""
		
		If CStr(Container0.Tab0.currenttab) == "0" then

			for i = 0 to tmpcount-1	step 2
				Container0.ContainerBank.GridBank.AddRow()
				j = i+1
				
				image1    = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, i	) '이미지명
				name1     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, i	) '이미지명
				code1     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, i	) '이미지명
				
	              'contEdtAcno.imgLogo.setMaintainingRatio("1")
	              'contEdtAcno.ImgPrcreset.setMaintainingRatio("1")
	              Container0.ContainerBank.GridBank.setMaintainingRatio( "bd_Bimage1" , GridBankRowCount, "1")
	              Container0.ContainerBank.GridBank.setMaintainingRatio( "bd_Bimage2" , GridBankRowCount, "1")
	              'Container0.ContainerSec.GridSec.GridBank.setMaintainingRatio( "bd_Bimage1" , 0, "1")
	              'Container0.ContainerSec.GridSec.GridBank.setMaintainingRatio( "bd_Bimage2" , 0, "1")
				
				Container0.ContainerBank.GridBank.SetCellData("bd_Bimage1" 	, GridBankRowCount, image1	 ) 
				Container0.ContainerBank.GridBank.SetCellData("bd_Bname1" 	, GridBankRowCount, name1	 ) 
				Container0.ContainerBank.GridBank.SetCellData("bd_Bcode1" 	, GridBankRowCount, code1	 ) 
				
				if tmpcount%2 ==0 and j+1 ==tmpcount then '짝수개 리턴, 마지막일경우
					image2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, j) '이미지명
					name2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, j) '이미지명
					code2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, j) '이미지명
					
					Container0.ContainerBank.GridBank.SetCellData("bd_Bimage2" 	, GridBankRowCount, image2	 ) 
					Container0.ContainerBank.GridBank.SetCellData("bd_Bname2" 	, GridBankRowCount, name2	 )
					Container0.ContainerBank.GridBank.SetCellData("bd_Bcode2" 	, GridBankRowCount, code2	 )
					Exit Sub
				
				elseif tmpcount%2 == 1 and j == tmpcount then '홀수개 리턴, 마지막일경우
					Container0.ContainerBank.GridBank.SetCellData("bd_Bimage2" 	,GridBankRowCount, "alpha"	 ) 
					Container0.ContainerBank.GridBank.SetCellData("bd_Bname2" 	,GridBankRowCount, ""	 )
					Container0.ContainerBank.GridBank.SetCellData("bd_Bcode2" 	,GridBankRowCount, ""	 )
					Exit Sub
				end if
				
				image2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, j) '이미지명
				name2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, j) '이미지명
				code2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, j) '이미지명
				
				Container0.ContainerBank.GridBank.SetCellData("bd_Bimage2" 	, GridBankRowCount, image2	 ) 
				Container0.ContainerBank.GridBank.SetCellData("bd_Bname2" 	, GridBankRowCount, name2	 )
				Container0.ContainerBank.GridBank.SetCellData("bd_Bcode2" 	, GridBankRowCount, code2	 )
				
				
				GridBankRowCount = GridBankRowCount +1
			next
		
		elseIf CStr(Container0.Tab0.currenttab) == "1" then '증권

			for i = 0 to tmpcount-1	step 2
				Container0.ContainerSec.GridSec.AddRow()
				j = i+1
			
				image1    = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, i	) '이미지명
				name1     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, i	) '이미지명
				code1     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, i	) '이미지명
				
	              Container0.ContainerSec.GridSec.GridBank.setMaintainingRatio( "bd_Bimage1" , GridSecRowCount, "1")
	              Container0.ContainerSec.GridSec.GridBank.setMaintainingRatio( "bd_Bimage2" , GridSecRowCount, "1")

				Container0.ContainerSec.GridSec.SetCellData("bd_Bimage1" 	, GridSecRowCount, image1	 ) 
				Container0.ContainerSec.GridSec.SetCellData("bd_Bname1" 	, GridSecRowCount, name1	 ) 
				Container0.ContainerSec.GridSec.SetCellData("bd_Bcode1" 	, GridSecRowCount, code1	 ) 
				
				if tmpcount%2 ==0 and j+1 ==tmpcount then '짝수개 리턴, 마지막일경우
					image2    = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, j) '이미지명
					name2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, j) '이미지명
					code2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, j) '이미지명
					
					Container0.ContainerSec.GridSec.SetCellData("bd_Bimage2" 	, GridSecRowCount, image2	 ) 
					Container0.ContainerSec.GridSec.SetCellData("bd_Bname2" 	, GridSecRowCount, name2	 )
					Container0.ContainerSec.GridSec.SetCellData("bd_Bcode2" 	, GridSecRowCount, code2	 )
					Exit Sub
				
				elseif tmpcount%2 == 1 and j == tmpcount then '홀수개 리턴, 마지막일경우
					Container0.ContainerSec.GridSec.SetCellData("bd_Bimage2" 	,GridSecRowCount, "alpha"	 ) 
					Container0.ContainerSec.GridSec.SetCellData("bd_Bname2" 	,GridSecRowCount, ""	 )
					Container0.ContainerSec.GridSec.SetCellData("bd_Bcode2" 	,GridSecRowCount, ""	 )
					Exit Sub
				end if
				
				image2    = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_IMG_FILE_NAME"		, j) '이미지명
				name2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_NAME"				, j) '이미지명
				code2     = DATAMANAGER.GetDataValue( 0 ,"obtsp_comm_001r", "OutBlock1", "BANK_CODE"				, j) '이미지명
				
				Container0.ContainerSec.GridSec.SetCellData("bd_Bimage2" 	, GridSecRowCount, image2	 ) 
				Container0.ContainerSec.GridSec.SetCellData("bd_Bname2" 	, GridSecRowCount, name2	 )
				Container0.ContainerSec.GridSec.SetCellData("bd_Bcode2" 	, GridSecRowCount, code2	 )
				
				GridSecRowCount = GridSecRowCount +1
			next
		end if	
	end if
End Sub

'============================================================================
Sub Container0_Tab0_OnTabChanged(tmp)
	Container0.ContainerBank.GridBank.SetClear()
	Container0.ContainerSec.GridSec.SetClear()
	
	GridBankRowCount = 0
	GridSecRowCount = 0

	If CStr(Container0.Tab0.currenttab) == "0" then
		Container0.ContainerBank.visible = true
		Container0.ContainerSec.visible  = false

	elseIf CStr(Container0.Tab0.currenttab) == "1" then '증권
		Container0.ContainerBank.visible = false
		Container0.ContainerSec.visible  = true
	End If
	
	DATAMANAGER.RequestTranData("obtsp_comm_001r")
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_ContainerBank_GridBank_OnClickUp(lRow, szCellID)
	if szCellID =="bd_Bimage1" or szCellID =="bd_Bname1" or szCellID =="bd_Bcode1" or szCellID =="bd_cell0" or szCellID =="bd_cell1" or szCellID =="bd_cell2" then
		szBankNm   = Container0.ContainerBank.GridBank.GetCellData("bd_Bname1", lRow)
		szBankCode = Container0.ContainerBank.GridBank.GetCellData("bd_Bcode1", lRow)
		szBankImage= Container0.ContainerBank.GridBank.GetCellData("bd_Bimage1", lRow)
	elseif szCellID =="bd_Bimage2" or szCellID =="bd_Bname2" or szCellID =="bd_Bcode2" or szCellID =="bd_cell3" or szCellID =="bd_cell4" or szCellID =="bd_cell5" then
		szBankNm   = Container0.ContainerBank.GridBank.GetCellData("bd_Bname2", lRow)
		szBankCode = Container0.ContainerBank.GridBank.GetCellData("bd_Bcode2", lRow)
		szBankImage= Container0.ContainerBank.GridBank.GetCellData("bd_Bimage1", lRow)
	end if
	
	if trim(szBankNm)  ="" then '홀수개 리턴시 하단 우측 공백
		Exit Sub
	end if
	
	g_szBankCode = szBankCode
	g_szBankName = szBankNm
	
	sRet =  g_szBankName   &"★"& g_szBankCode
	
	Form.SetSharedData("BANK_NAME" , g_szBankName  )
	Form.SetSharedData("BANK_CODE" , g_szBankCode)
	
	Form.SendReturnToParent("mbbdm86190_p1" , sRet)
	Form.CloseForm()
End Sub

'============================================================================
