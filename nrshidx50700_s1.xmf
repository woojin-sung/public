<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="50700" scrname="REITs 투자가이드-리츠란-리츠(REITs)안내" version="2" writer="노일호" />
	<FORM_INFO name="Form" ly_vert="0,0,375,408,1" />
	<CONTROL_INFO>
		<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="리츠(REITs)란 무엇일까요?" ly_vert="20,32,340,34,1" />
		<LABEL name="lblS1Desc" fontsize="-2" caption="부동산투자회사(Real Estate Investment Trusts)의 영문 약자로 부동산, 부동산 관련 증권 등에 투자·운용하고 수익을 투자자들에게 돌려주는 부동산 간접투자기구인 주식회사 입니다." valign="0" multiline="1" ly_vert="20,68,335,92,1" />
		<IMAGE name="imgS1Desc" ly_vert="20,168,335,200,1" />
		<LABEL name="lblTopDivider" caption=" " bgcolor="263:216216216" transmode="0" ly_vert="0,0,375,10,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1230" _ulen="1132" >
'***************************************************
'               전역 변수
'***************************************************
Dim g_szTitle

'***************************************************
'               공용 함수
'***************************************************
'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	call Init_Control("1")    ' Personal Function 호출시 call 붙여준다.
End Sub

'***************************************************
'               개별 함수
'***************************************************
'===============================================
' Init_Control(szCbn) 
'===============================================
Function Init_Control(szCbn) --> 리턴과 상관없이 Function으로 정의한다.
	'topbar #F6F7F8 (RGB 246,247,248)로 색칠하기
	lblTopDivider.bgcolor = 320
	
	'여백 지우기
	lblTitle.paddinginfo = "0,0,0,0"
	lblS1Desc.paddinginfo = "0,0,0,0"
	
	'색칠
	lblTitle.setHighlight(332)
	lblS1Desc.fgcolor = "333"
	
	'이미지 설정
	imgS1Desc.setMaintainingRatio("1")
	imgS1Desc.imgpath = "reits_img01.png"
End Function

	</SCRIPT_INFO>
</ROOT>