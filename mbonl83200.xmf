'============================================================================
' fmtab0_OnTabChanged(nCurrentTab)
'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
	
	g_nTabIndex = nCurrentTab
'	g_szData = acnt0.total & "★" & acnt0.sequence & "★" & edtPW.caption
'	
'	Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "청약신청", g_szData )
	Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "MOTP_GETINFO_RETURN_83200_FROM_MAINPAGE", g_motpAppYN )
End Sub

'============================================================================
Sub Form_OnRefresh()
	
	'fmtab0_OnTabChanged(g_nTabIndex) v0002
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INFO_CLICK" then '유의사항
		Form.OpenFramePopup("mbonl83200_p6", "", "")
	elseif sEventName == "REFRESH_FROM_83200_T1" then 'v0001
		Form.requestMOTP("MOTP_GETINFO"     , "" , "83200")     '등록된 OTP alias 존재하는지 확인
		'Form.ShowAlert( "알림" , sEventName)
	end if
End Sub
'============================================================================
'Form.requestMOTP로 호출하면 여기로 리턴됨
'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam)
	'Form.ShowAlert( "알림" , sEventName)
	if sEventName == "MOTP_GETINFO_RETURN_83200" then
		mOTPInfo  = Split(sParam,"★")    'resultcode★resultMsg★otpAlias(일련번호)
		if Ubound(mOTPInfo) < 1 then
			exit sub
		else	
			g_motpAppYN = mOTPInfo(0)
		end if
		'Form.ShowAlert( "알림" , g_motpAppYN)
		'call Form_OnRefresh() 'v0002
		call fmtab0_OnTabChanged(g_nTabIndex)' v0002
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'Form.ShowAlert( "알림" , sKeyName&"-"&sRet)
End Sub

