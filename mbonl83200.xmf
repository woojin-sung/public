'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_DeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS 'v0001
	
	g_nTabIndex = CInt(fmtab0.currenttab)

	Dim szScreenNo, szTab
'	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
'	if szScreenNo == "83010" then

'	elseif szScreenNo == "83000" then

'	end if
	
	
	szOpen = Form.GetOpenLinkData()

	' ----------------------------------------------------------------------
	' 다른화면에서 화면오픈시
	' ----------------------------------------------------------------------	
	if szOpen <> "" then
'		tData = Split(szOpen, "★")
		
		' 폼탭변경(0:공개매수 신청, 1:신청내역/취소)
'		if tData(0) = "0" then
'			fmtab0.currenttab = 0
'			Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "공개매수 신청", "" )
		if szOpen = "2" then
			fmtab0.currenttab = 1
'			Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "신청내역/취소", "" )
		end if 
	end if 
		
	fmtab0.tabheadheight = 0
	
'	if g_DeviceOS == "1" then '1.안드로이드 2.iOS 
'		'v0001 sta
'		'모바일OTP 보안매체가 원장 기준으로는 있더라도
'		'앱에 없을 때 보안매체 없는 고객이라고 띄우기 위함
'		Form.requestMOTP("MOTP_GETINFO"     , "" , "83200")     '등록된 OTP alias 존재하는지 확인 
'		'v0001 fin
'	end if
	Form.requestMOTP("MOTP_GETINFO"     , "" , "83200")     '등록된 OTP alias 존재하는지 확인 'v0001
End Sub
