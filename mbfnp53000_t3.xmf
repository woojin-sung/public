	<SCRIPT_INFO _len="6353" _ulen="5751" >
'============================================================================
' 01. 화 면 명 : ELS/DLS청약_청약완료상품탭
' 02. 화면설명 : ELS/DLS청약_청약완료상품탭
' 03. 작    성 : 2016. 03. 05. 유창재
' 04. 수    정 : 2024.02.16. 김유경. v001. 청약완료내역 조회 안되도록 수정 (T2402150001)
'			   2024.07.05. 김유경. v002. 청약완료내역 조회하도록 수정 (토스)
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Seting(nIndex) : 그리드 값 세팅
'============================================================================
Function Seting(nIndex)

'	grd0.SetCellData( "cell2_3" , nIndex, "/")
	'grd0.SetCellData( "cell2_1" , nIndex, "기대수익 :")
	'grd0.SetCellFgColor( "cell2_1" , nIndex, "61")
	'grd0.SetCellFgColor( "cell2_4" , nIndex, "61")
'	grd0.SetCellData( "bd_cell19" , nIndex, "상세\r\n보기")
	grd0.SetCellData( "cell2_8" , nIndex, "기준가")
	grd0.SetCellFgColor( "cell2_8" , nIndex, "61")
	grd0.SetCellData( "cell3_8" , nIndex, "조회")
	grd0.SetCellFgColor( "cell3_8" , nIndex, "61")
	grd0.SetCellData( "cell3_1" , nIndex, "청약기간 :")
'	grd0.SetCellData( "cell3_3" , nIndex, ":")
	grd0.SetCellData( "cell3_5" , nIndex, "~")
	grd0.SetCellData( "cell4_1" , nIndex, "기초자산 :")
'	grd0.SetCellData( "cell4_3" , nIndex, ":")
	
End Function

'============================================================================
' GradeCheck(nIndex , szIssueCode, szCode, szYN) : 그리드값 구분해서 세팅
'============================================================================
Function GradeCheck(nIndex , szIssueCode, szCode, szYN)
	Dim szText
	
	if szIssueCode == "10" then
		grd0.SetCellData( "cell1_1", nIndex, "[DLS]")
	elseif szIssueCode == "07" then
		grd0.SetCellData( "cell1_1", nIndex, "[ELS]")
	end if

	Select Case szCode			'위험도 체크
		Case "01"
			szText = "초고위험/"
'			grd0.SetCellData( "cell2_6" , nIndex, "초고위험/")
		Case "02"
'			grd0.SetCellData( "cell2_6" , nIndex, "고위험/")
			szText = "고위험/"
		Case "03"
'			grd0.SetCellData( "cell2_6" , nIndex, "중위험/")
			szText = "중위험/"
		Case "04"
'			grd0.SetCellData( "cell2_6" , nIndex, "저위험/")
			szText = "저위험/"
		Case "05"
'			grd0.SetCellData( "cell2_6" , nIndex, "초저위험/")
			szText = "초저위험/"
		Case "09"
'			grd0.SetCellData( "cell2_6" , nIndex, "미지정/")
			szText = "미지정/"
		Case "99"
'			grd0.SetCellData( "cell2_6" , nIndex, "투자목적기재서거부/")
			szText = "투자목적기재서거부/"
	End Select

	if szYN == "Y" then			'보장여부
		szText = szText.."원금보장형"
		grd0.SetCellData( "cell2_6" , nIndex, szText )		
	else
		szText = szText.."원금비보장형"
		grd0.SetCellData( "cell2_6" , nIndex, szText )	
	end if
	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_042r", "InBlock1", "STND_DATE" , 0 , cld0.caption)
	
	'v001. 청약완료내역 조회 안되도록 수정 (T2402150001)
	'v002. 청약완료내역 조회하도록 수정 (토스)
	DATAMANAGER.RequestTranData( "obibk_pssb_042r" )
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	Form_OnFormInit()
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nDataCount			'데이터 개수
	Dim szIssuCode			'청약종목구분코드
	Dim szGradeCode			'위험등급코드
	Dim szProtectYN			'보장여부
	
	if szTranID == "obibk_pssb_042r" then
		nDataCount = DATAMANAGER.GetDataCount( 0 , "obibk_pssb_042r", "OutBlock1") - 1
		for i = 0 to nDataCount
			Seting( i )
			szIssuCode = DATAMANAGER.GetDataValue( 0 , "obibk_pssb_042r", "OutBlock1", "PROD_CLS_CODE" , i)			'상품코드
			szGradeCode = DATAMANAGER.GetDataValue( 0 , "obibk_pssb_042r", "OutBlock1", "KYC_PROD_GRAD_CODE" , i)	'위험도Code
			szProtectYN = DATAMANAGER.GetDataValue( 0 , "obibk_pssb_042r", "OutBlock1", "PRNC_GUAR_YN" , i)			'보장여부
			GradeCheck( i, szIssuCode, szGradeCode, szProtectYN)
		next
	end if
	
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szData, szData1, g_szFileName, g_szUrl
	
	'종목코드, 시작일, 현재일, 청약일자, 청약종목일련번호
'	szData = grd0.GetCellData( "bd_cell8", lRow) & "★" & grd0.GetCellData( "cell3_4", lRow) & "★" &  cld0.caption & "★" &  
'			grd0.GetCellData( "bd_cell9", lRow) & "★" & grd0.GetCellData( "bd_cell10", lRow)

	szData1 = grd0.GetCellData( "bd_cell8", lRow) & "★" & grd0.GetCellData( "cell3_4", lRow) & "★" &  cld0.caption & "★" &
			grd0.GetCellData( "cell1_1", lRow) & "★" & grd0.GetCellData( "cell1_2", lRow)
	
	if szCellID == "bd_cell18" then
'		Form.OpenFramePopup( "mbfnp53000_p3" , szData , sPosInfo)
		g_szFileName = "IBK_PRODMAN"&grd0.GetCellData( "bd_cell9", lRow)&CDbl(grd0.GetCellData( "bd_cell10", lRow))&".pdf"
		
		nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
		if nType == "0" then
			g_szUrl = "http://home.imeritz.com/include/ocw/"&g_szFileName	'운영계
		elseif nType == "1" then
			g_szUrl = "http://211.255.202.106/include/ocw/"&g_szFileName	'개발계
		end if
		
		Form.OpenPdfViewer( g_szUrl, "")		'안드로이드 정상, IOS View 나타나지 않음
	elseif szCellID == "cell2_8" or szCellID == "cell3_8" then
		Form.OpenFramePopup( "mbfnp53000_p4" , szData1 , sPosInfo)
	end if
	
End Sub

