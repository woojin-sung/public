'		OR Container0.ctnCheck.ChkButton2.checkstate == "0" OR Container0.ctnCheck.ChkButton3.checkstate == "0" OR Container0.ctnCheck.ChkButton4.checkstate == "0" OR Container0.ctnCheck.chkAll.checkstate == "0" then
	if  g_szFileName <> "mbfnp51010_t4" and (Container0.ctnCheck.ChkButton0.checkstate == "0" OR Container0.ctnCheck.ChkButton1.checkstate == "0" 
		OR Container0.ctnCheck.ChkButton2.checkstate == "0" OR Container0.ctnCheck.chkAll.checkstate == "0") then
	'21.07.12 JHY END
	

	   Form.ShowAlert ("알림", "투자자 확인사항 체크를 해주셔야 합니다.")
	else
		Form.SendReturnToParent("mbonl81010_p9" , "OK")
