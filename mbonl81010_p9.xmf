'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 고객투자성향진단
' 02. 화면설명 : 고객투자성향진단_고위험거래확인팝업
' 03. 작    성 : 2016.02.17	
' 04. 수    정 : 2016.11.10 주식 공모주청약 관련 프로세스 추가 v002 
'                2017.07.11 CME/EUREX 약정 추가 v003
'                2017.12.21 윤유정 :  해외주식, 해외파생ETF 약정 추가 v004
'		      : 2018.03.14 : 김유경 : 변동성ETN거래신청 추가 v005
'		      : 2021.07.21 : 정효영 : 고난도 금융상품 펀드 관련 내용 수정 v006
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szScrNo 	'호출한 화면번호

Dim g_szRetData 
Dim g_szKYC_INVT_INCL_GRAD_CODE 	'KYC투자성향등급코드
Dim g_szKYC_PROD_GRAD_CODE 		'KYC상품등급코드
Dim g_szKYC_DVPD_EPMD_CODE 		'KYC파생상품유의코드
Dim g_szKYC_DRVT_PROS_YN 			'KYC파생처리여부
Dim g_szDVPD_GRAD_CODE 			'파생상품등급코드
Dim	g_szAlertTitle			'알림타이틀
Dim g_szRet

g_szRet	=	"CANCEL"
g_szAlertTitle	=	"알림"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'setItemSetting: 각 업무에 따라 입력값 세팅
'============================================================================
Function	setGlobalItems(szInput)	
	g_szRMND_SRNO 	=	getListItem(szInput, 0)
	g_szKOR_ISNM 		=	getListItem(szInput, 1)
	g_szSAVE_TYPE		=	getListItem(szInput, 2)
	g_szSAVE_TYPE_NM  =    Form.GetMetaData("집합투자증권저축유형코드"		, g_szSAVE_TYPE)
	g_szCAFU_REAS		=	getListItem(szInput, 3)
	
	'21.08.26 JHY START (v006) : 잔고번호 3자리로 나오도록, 고난도 상품 -> 고난도 금융투자상품 투자로 문구 변경
	if g_szCAFU_REAS == "고난도상품" then
		g_szCAFU_REAS = "고난도 금융투자상품 투자"
	end if

	if Len(g_szRMND_SRNO) < 3 then
		if Len(g_szRMND_SRNO) == 1 then
			g_szRMND_SRNO = "00" & g_szRMND_SRNO
			
		elseif Len(g_szRMND_SRNO) == 2 then
			g_szRMND_SRNO = "0" & g_szRMND_SRNO
		end if 
	end if
	'21.08.26 JHY END
	
	'21.07.30 JHY START
	'v006
	': 기존에 쓰던 DATE 함수는 현재일자 보여주는 것으로 날짜 표기 잘못되고 있어,
	'   VB 기본 제공 Format 함수 썼으나, 에러 발생해 함수(SetDateFormat) 만든걸로 날짜 포맷팅
	g_szCAFU_DDLN_STA_DATE		=	SetDateFormat(getListItem(szInput, 4))
	g_szCAFU_DDLN_FIN_DATE		=	SetDateFormat(getListItem(szInput, 5))
	g_szINTN_DTRM_STA_DATE		=	SetDateFormat(getListItem(szInput, 6))
	g_szINTN_DTRM_FIN_DATE		=	SetDateFormat(getListItem(szInput, 7))
	'21.07.30 JHY END
	
	Container0.tblData.SetCellString(0, 1, g_szCAFU_REAS)
	Container0.tblData.SetCellString(1, 1, g_szCAFU_DDLN_STA_DATE & getWeek(g_szCAFU_DDLN_STA_DATE) & "~" & g_szCAFU_DDLN_FIN_DATE & getWeek(g_szCAFU_DDLN_FIN_DATE))
	Container0.tblData.SetCellString(2, 1, g_szINTN_DTRM_STA_DATE & getWeek(g_szINTN_DTRM_STA_DATE) & "~" & g_szINTN_DTRM_FIN_DATE & getWeek(g_szINTN_DTRM_FIN_DATE) & "\n·투자의사확정 마감시간 : 오후 5시")
	
	'21.07.21 JHY START : 조회/취소 탭에서 오픈시, 체크버튼 없애기 위해 파일명 추가 
	'v006
	g_szFileName				=	getListItem(szInput, 8)

	if g_szFileName == "mbfnp51010_t4" then
'		Container0.tblCheckTitle1.visible = true
'		Container0.tblCheckTitle2.visible = false
		
		Container0.ctnCheck.chkAll.visible = false
		Container0.ctnCheck.chkAll.top = 0
		
		Container0.ctnCheck.ChkButton0.visible = false
		Container0.ctnCheck.ChkButton1.visible = false
		Container0.ctnCheck.ChkButton2.visible = false
		
		Container0.ctnCheck.left = -15
		Container0.ctnCheck.top = 797
		Container0.ctnCheck.height = 330
		Container0.ctnCheck.SetScrollAutoSize()
		Container0.SetScrollAutoSize()
	end if
	'21.07.21 JHY END
End Function


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			'21.07.28 JHY START : 예외처리 추가
			'v006
			if Ubound(szList) >= nIdx then
				if szList(nIdx) <> NULL then
					return szList(nIdx)
				else
					return
				end if
				
			else
				return
			end if
			'21.07.28 JHY END
		else
			return
		end if 
	end if 
	
end function

'============================================================================
' 21.07.30 JHY : SetDateFormat : 날짜 형식으로 포맷팅 ( 기존 DATE 함수 쓰면 오늘날짜 반환하고 있어서 추가 )
'============================================================================
Function SetDateFormat(szDate)
	Dim szFormatDate
	szFormatDate = ""

	if szDate <> NULL then
		if Len(szDate) <= 4 then
			szFormatDate = szDate
	
		elseif Len(szDate) <= 6 then		
			szFormatDate = Left(szDate, 4) & "-" & Mid(szDate, 5, Len(szDate))
			
		else
			szFormatDate = Left(szDate, 4) & "-" &  Mid(szDate, 5, 2) & "-" &  Mid(szDate, 7, 8)
		end if
	end if
	
	return szFormatDate
end function

'============================================================================
'요일을 리턴
'============================================================================
Function getWeek(input_date)
	week = Weekday(input_date)
	weeknm = ""
	SELECT CASE week
		CASE 1
			weeknm = "(일)"
		CASE 2
			weeknm = "(월)"
		CASE 3
			weeknm = "(화)"
		CASE 4
			weeknm = "(수)"
		CASE 5
			weeknm = "(목)"
		CASE 6
			weeknm = "(금)"
		CASE 7
			weeknm = "(토)"
	END SELECT
	
	return weeknm
end function

'===========================================================================
' 숫자 리턴함수
'===========================================================================
Function GetTonumber(sNum)
	Dim nDbl
	nDbl = 0
	
	if sNum == null or Trim(sNum) == "" then
		return nDbl
	end if
	
	nDbl = CDbl(sNum)
	
	return nDbl
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	'21.07.12 JHY START
	'v006
'	Container0.tblCheckTitle1.visible = false
	'21.07.12 JHY END
	
	dim szLinkedData
	g_sRetData = "cancel"
	
	Form.SetScreenName("펀드가입 및 투자자 숙려제도 안내")
	
	szLinkedData = Form.GetOpenLinkData( )


	if szLinkedData = "" then
		Form.ShowAlert(g_szAlertTitle, "입력값이 없습니다.")
	else
		setGlobalItems(szLinkedData)
	end if 
	
	Dim	szOSType
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	if szOSType = "1" then
		Container0.lblDescLine1.changeTextAttr(39, 11, 6, 0, false)
		Container0.lblDescLine1.changeTextAttr(63, 28, 6, 0, false)
		Container0.lblDescLine1.changeTextAttr(93, 9, 6, 0, false)
		
		Container0.Label0.changeTextAttr(54, 19, 67, 0, false)	'67
		Container0.Label0.changeTextAttr(86, 8, 67, 0, false)
	else	'IOS
		Container0.lblDescLine1.changeTextAttr(40, 11, 6, 0, false)
		Container0.lblDescLine1.changeTextAttr(65, 29, 6, 0, false)
		Container0.lblDescLine1.changeTextAttr(96, 9, 6, 0, false)
		
		Container0.Label0.changeTextAttr(54, 20, 67, 0, false)
		Container0.Label0.changeTextAttr(86, 9, 67, 0, false)
	end if
	
