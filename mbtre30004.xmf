'============================================================================
' 01. 화 면 명 : 해외주식CFD 안심계좌 헷지수수료 조회
' 02. 화면설명 : 해외주식CFD 안심계좌 헷지수수료 조회
' 03. 작    성 : 2023. 08. 30. 유재하
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Sub Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	Form.setTitleCaption( "해외주식CFD 안심계좌 헷지수수료 조회" )
	
	grd0.SetClear()
	
	'당월 1일 세팅
	szhostDate = Form.GetSharedData("&HOST_DATE" , false)
	szMonth = Mid(szhostDate, 5, 2)
	cldFrom.caption = cldFrom.calyear & szMonth & "01"

	f_RequestAcntStateTR()

	DATAMANAGER.RequestTranData( "obtre_rmnd_007r" )
End Sub

'============================================================================
' acnt0_ChangeAccount()
'============================================================================
Sub acnt0_ChangeAccount()
	grd0.SetClear()
	
	f_RequestAcntStateTR()
	
	DATAMANAGER.RequestTranData( "obtre_rmnd_007r" )
End Sub

'============================================================================
Sub cldFrom_OnEditComplete()
	DATAMANAGER.RequestTranData( "obtre_rmnd_007r" )
End Sub

'============================================================================
Sub cldTo_OnEditComplete()
	DATAMANAGER.RequestTranData( "obtre_rmnd_007r" )
End Sub

'============================================================================
Sub rdoKind_OnClick(nIndex)
	DATAMANAGER.RequestTranData( "obtre_rmnd_007r" )
End Sub

'============================================================================
' Form_OnCommonDialogReturn()
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	grd0.SetClear()
	
	if sDlgName == "SEARCH" then
		
		if sReturn1 <> "" then
			DATAMANAGER.RequestTranData( "obtre_rmnd_007r" )
		end if
	end if
End Sub

'============================================================================
' grd0_OnScrollEnd() : NextData 조회
'============================================================================
Sub grd0_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData( "obtre_rmnd_007r" ) == True Then
		DATAMANAGER.RequestNextData( "obtre_rmnd_007r" )
	End If
End Sub

'============================================================================
' btnRefresh_OnClick()
'============================================================================
Sub btnRefresh_OnClick()
	grd0.SetClear()
	
	DATAMANAGER.RequestTranData( "obtre_rmnd_007r" )
End Sub

'============================================================================
' Form_OnRefresh()
'============================================================================
Sub Form_OnRefresh()
	grd0.SetClear()
	
	DATAMANAGER.RequestTranData( "obtre_rmnd_007r" )
End Sub

'============================================================================
'ChkButton0_OnChange()
'============================================================================
Sub ChkButton0_OnChange(sCheckState)
	DATAMANAGER.RequestTranData( "obtre_rmnd_007r" )
End Sub

'****************************************************************************
'				     	D A T A M A N A G E R
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore()
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obtre_rmnd_007r" Then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "MANG_BRCD" 		, 0 ,	"%"				) '관리지점코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" 		, 0 ,	""				) '계좌비밀번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "STA_DATE" 		, 0 ,	cldFrom.caption		) '시작일자
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FIN_DATE" 		, 0 ,	cldTo.caption		) '종료일자
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "IQRY_CLS_CODE" 	, 0 ,	rdoKind.currentindex	) '조회구분코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 			, 0 , 	acnt0.total			) '계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" 			, 0 , 	acnt0.sequence		) '계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CTCD" 			, 0 , 	"%"                            ) '국가코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PROS_CLS_CODE" 	, 0 , 	ChkButton0.checkstate) '처리구분코드
	elseif szTranID == "obtre_comm_004r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 			, 0 , 	acnt0.total			) '계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" 			, 0 , 	acnt0.sequence		) '계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" 		, 0 ,	""				) '계좌비밀번호
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtre_comm_004r" then
		Dim szNationalCode
		szNationalCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CTCD", 0)

	        if szNationalCode = "840" then '미국
		    szCurrency = "USD"
		elseif szNationalCode = "344" then '홍콩
		    szCurrency = "HKD"
		elseif szNationalCode = "156" then '중국
		    szCurrency = "CNY"
		elseif szNationalCode = "392" then '일본
		    szCurrency = "JPY"
	        end if
		
		Table0.SetCellString( 0, 2, szCurrency)
		Table0.SetCellString( 1, 2, "원")
	end if
End Sub

