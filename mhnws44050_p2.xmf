'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	Grid0.SetClear()
	Grid0.rowmove= "1"
	temp = Split(Form.GetOpenLinkData(), "●" )
	temp_arrKeyword = temp[0]
	
	arrKeyword = Split(temp_arrKeyword, "★")
	arrLen = temp[1]
	
	if Cint(arrLen) < 1 then
		Label0.visible = true
		Grid0.visible = false
		btnok.visible = false
		btnCancel.visible = false
		Image1.visible = true
		
	
	else
		Label0.visible = false
		Image1.visible = false
		Grid0.visible = true
		btnok.visible = true
		btnCancel.visible = true
		
		for i = 0 to arrLen-1
			Grid0.AddRow()
			Grid0.SetCellData("bd_cell20", i, arrKeyword(i))
		next
	
	end if
		
	
End Sub

'============================================================================
'
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	
	
	if szCellID == "bd_cell0" then
	' 20170529 NOHES : 건별 키워드삭제 시 toast 너무 많이 떠서 성가심. 제거함.	
	'	Form.Toast(0,"'" & Grid0.GetCellData("bd_cell20", lRow) & "'" & "(을)를 키워드에서 삭제하였습니다.", 0.5)
		Grid0.SetDeleteRow(lRow)
		'Form.SendReturnToParent("keywordDelete" , IRow)
		'Form.CloseForm()
		
	elseif szCellID == "bd_cell40" then
	
		Form.OpenPopup("mhnws44050_p1","keywordMod★"& Grid0.GetCellData("bd_cell20", lRow) & "★"& lRow,"")
	
	end if
	
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnok_OnClick()
	g_Keyword = ""
	g_KeywordNum = 0
	for i = 0 to Grid0.rowcount -1
		if i == 0 then
			g_Keyword = Grid0.GetCellData("bd_cell20", i)
		else
			g_Keyword = g_Keyword & "★" & Grid0.GetCellData("bd_cell20", i)
		end if
		
		g_KeywordNum = g_KeywordNum + 1
		
	next
	'Form.ShowAlert("g_Keyword", g_Keyword)
	
	Form.SendReturnToParent("keywordMod" , g_Keyword&"●"&g_KeywordNum)
	Form.Toast(0,"키워드 편집이 완료되었습니다.", 0.5)
	Form.CloseForm()
		
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "keywordMod" then
		temp = Split(sRet,"★")
		
		Grid0.SetCellData("bd_cell20", temp(1), Cstr(temp(0)))
	end if
		
End Sub

