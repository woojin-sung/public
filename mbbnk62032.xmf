'===========================================================================
' 화 면 명: 다른 금융기관 계좌관리
' 화면설명: 
' 작    성: 2020.10.12. 송기영
' 수    정: 2021.01.13. 장원혁 v001 계좌해지 시 콤보박스에서 계좌 삭제
'===========================================================================
'***************************************************************************
'     G L O B A L   V A R I A B L E
'***************************************************************************
Dim g_szID         '사용자 아이디

Dim g_szBANKACNO   '은행계좌번호
Dim g_szBANKNAME   '은행명
Dim g_szBANKCODE   '은행코드

Dim g_szTabC       '탭 위치
Dim g_szCombC      '콤보 위치
Dim g_szSet        '세팅여부

Dim DrngAcntAls  '별명 
Dim DrngEmail    '이메일 
Dim DrngAgrmYn   '출금이체동의
Dim Prnm         '예금명
Dim EmailAddr    '이메일주소
Dim LinkYn       '다른곳에서 호출됐나 여부
Dim cblistcount  '콤보카운트

Dim g_isDelete   'v001 해지여부

'============================================================================
' AllSearch() : 데이터 전체조회시
'============================================================================
Function AllSearch()
	
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "PROS_CLS_CODE" , 0 ,  "1" )
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "OPN_ACNT_KIND_CODE", 0 , "%" ) 
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "ELFN_ID", 0 , g_szID) 'acno랑 둘중하나만
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "SNMS_YN", 0 , "N")
	
	DATAMANAGER.RequestTranData("obtss_opnf_008r")
End Function


'===========================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_szTabC     = 0  '탭 위치
	g_szSet 	    = 0
	g_szCombC    = 0  '콤보 위치
	DrngEmail    = ""
	DrngAgrmYn   = ""
	LinkYn = "N"
	
	g_szID = Form.GetSharedData("&USER_ID", false )
	
	szData = Form.GetOpenLinkData()
		
	if szData <> "" then
		Dim szData
		szData = Form.GetOpenLinkData()
		g_szList = Split(szData, "★")
	
		g_szBANKACNO = g_szList(0)
		g_szBANKNAME = g_szList(1)
		g_szBANKCODE = g_szList(2)
		
		if UBOUND(g_szList) < 1 THEN
			EXIT SUB
		END IF
		
		LinkYn = "Y"
	else
		LinkYn = "N"
	end if
	
	AllSearch()
	
End Sub


Sub AcComb_OnEditComplete (iIndex)
	
	dim Drng

	dim BANK_CODE
	dim BANK_NAME
	dim BANK_ACNO
	dim OPN_TIMS_NO
	
	DrngEmail = ""
	DrngAgrmYn = ""
	
	g_szCombC   =  iIndex  '콤보 위치
	LinkYn = "N"
	
	BANK_CODE = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "BANK_CODE" , g_szCombC)
	BANK_NAME = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "BANK_NAME" , g_szCombC)
	BANK_ACNO = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "BANK_ACNO" , g_szCombC)
	OPN_TIMS_NO = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "OPN_TIMS_NO" , g_szCombC)
	Prnm =  DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "PRNM" , g_szCombC)	    
	    
	if g_szTabC == 0 then '계좌순서
	    
	elseif g_szTabC == 1 then '계좌별명
	    DrngAcntAls = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "DRNG_ACNT_ALS" , g_szCombC)
	    Form.triggerEvent("fmtab." & fmtab.currenttabpageid , "mbbnk62032_t2", DrngAcntAls & "★" & BANK_CODE & "★" & BANK_ACNO & "★" & OPN_TIMS_NO)
	
	elseif g_szTabC == 2 then '이메일변경
	    if DrngEmail = "" then
		    DrngEmail = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "EMAIL_ADDR" , g_szCombC)
	    end if
	    
		Form.triggerEvent("fmtab." & fmtab.currenttabpageid , "mbbnk62032_t3", DrngEmail & "★" & BANK_CODE & "★" & BANK_ACNO & "★" & OPN_TIMS_NO)
		
		'DrngEmail = ""
		
	elseif g_szTabC == 3 then '출금이체동의
	    
	    if DrngAgrmYn = "" then
		    DrngAgrmYn = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "DRNG_AGRM_YN" , g_szCombC)
	    end if
	    
	    DrngAcntAls = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "DRNG_ACNT_ALS" , g_szCombC)
	    EmailAddr   = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "EMAIL_ADDR" 	, g_szCombC)
	    Form.triggerEvent("fmtab." & fmtab.currenttabpageid , "mbbnk62032_t4", Prnm & "★" & DrngAgrmYn & "★" & BANK_CODE & "★" & BANK_ACNO & "★" & OPN_TIMS_NO & "★" & EmailAddr)
		
		'DrngAgrmYn = ""
		
	elseif g_szTabC == 4 then '계좌등록해지
	    DrngAcntAls = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "DRNG_ACNT_ALS" , g_szCombC)
	    Form.triggerEvent("fmtab." & fmtab.currenttabpageid , "mbbnk62032_t5", DrngAcntAls & "★" & BANK_CODE & "★" & BANK_ACNO & "★" & OPN_TIMS_NO)
	
	elseif g_szTabC == 5 then '오픈뱅킹해지
	    Form.triggerEvent("fmtab." & fmtab.currenttabpageid , "mbbnk62032_t6", cblistcount)
	end if
	
End Sub


Sub fmTab_OnTabChanged(nCurrentTab)
	
	g_szTabC = nCurrentTab
	LinkYn = "N"
 
	BANK_CODE = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "BANK_CODE" , g_szCombC)
	BANK_NAME = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "BANK_NAME" , g_szCombC)
	BANK_ACNO = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "BANK_ACNO" , g_szCombC)
	OPN_TIMS_NO = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "OPN_TIMS_NO" , g_szCombC)
	Prnm =  DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "PRNM" , g_szCombC)	    
	    
	if nCurrentTab == 1 then '계좌별명
	    DrngAcntAls = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "DRNG_ACNT_ALS" , g_szCombC)
	    Form.triggerEvent("fmtab." & fmtab.currenttabpageid , "mbbnk62032_t2", DrngAcntAls & "★" & BANK_CODE & "★" & BANK_ACNO & "★" & OPN_TIMS_NO)
	
	elseif nCurrentTab == 2 then '이메일변경
	    if DrngEmail = "" then
		    DrngEmail = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "EMAIL_ADDR" , g_szCombC)
	    end if
	    
		Form.triggerEvent("fmtab." & fmtab.currenttabpageid , "mbbnk62032_t3", DrngEmail & "★" & BANK_CODE & "★" & BANK_ACNO & "★" & OPN_TIMS_NO)
				
	elseif nCurrentTab == 3 then '출금이체동의
	
	    if DrngAgrmYn = "" then
		    DrngAgrmYn = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "DRNG_AGRM_YN" , g_szCombC)
	    end if
	    
	    DrngAcntAls = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "DRNG_ACNT_ALS" , g_szCombC)
	    EmailAddr   = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "EMAIL_ADDR" 	, g_szCombC)
	    Form.triggerEvent("fmtab." & fmtab.currenttabpageid , "mbbnk62032_t4", Prnm & "★" & DrngAgrmYn & "★" & BANK_CODE & "★" & BANK_ACNO & "★" & OPN_TIMS_NO & "★" & EmailAddr)
				
	elseif nCurrentTab == 4 then '계좌등록해지
	    DrngAcntAls = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "DRNG_ACNT_ALS" , g_szCombC)
	    Form.triggerEvent("fmtab." & fmtab.currenttabpageid , "mbbnk62032_t5", DrngAcntAls & "★" & BANK_CODE & "★" & BANK_ACNO & "★" & OPN_TIMS_NO)
	
	elseif g_szTabC == 5 then '오픈뱅킹해지
	    Form.triggerEvent("fmtab." & fmtab.currenttabpageid , "mbbnk62032_t6", cblistcount)
	end if

End Sub


Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obtss_opnf_008r" Then 
		Dim nCount
		Dim BankAcno, BankName
		BankAcno, BankName = "", ""
		
		nCount = DATAMANAGER.GetDataCount(0, "obtss_opnf_008r", "OutBlock1")
		
		if g_szSet = 0 then 
			cblistcount  = 0
			
			For i = 0 to nCount-1
				BankAcno = DATAMANAGER.GetDataValue(0, "obtss_opnf_008r", "OutBlock1", "BANK_ACNO"     , i)
				BankName = DATAMANAGER.GetDataValue(0, "obtss_opnf_008r", "OutBlock1", "BANK_NAME"     , i)
								
				'AcComb.cbadddatatext = BankName .. " ".. BankAcno .. " " .. cblistcount
				AcComb.cbadddatatext = BankName .. " ".. BankAcno
				
				if BankAcno = g_szBANKACNO and BankName = g_szBANKNAME then
					CombNum = i
				end if
				
				cblistcount = cblistcount + 1
			next
		End if
		
		if LinkYn = "Y" then
			AcComb.currentindex = CombNum
		end if
		
		g_szSet = 1
		
		If g_isDelete == "Y" Then 'v001
		
	        dim BANK_CODE
	        dim BANK_NAME
	        dim BANK_ACNO
	        dim OPN_TIMS_NO
	
	        DrngEmail = ""
	        DrngAgrmYn = ""
	
	        g_szCombC   =  0  '콤보 위치
	        LinkYn = "N"
	
	        BANK_CODE = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "BANK_CODE" , g_szCombC)
	        BANK_NAME = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "BANK_NAME" , g_szCombC)
	        BANK_ACNO = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "BANK_ACNO" , g_szCombC)
	        OPN_TIMS_NO = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "OPN_TIMS_NO" , g_szCombC)
	        Prnm =  DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "PRNM" , g_szCombC)	    		
		
	        DrngAcntAls = DATAMANAGER.GetDataValue( 0 , "obtss_opnf_008r", "OutBlock1", "DRNG_ACNT_ALS" , g_szCombC)
	        Form.triggerEvent("fmtab." & fmtab.currenttabpageid , "mbbnk62032_t5", DrngAcntAls & "★" & BANK_CODE & "★" & BANK_ACNO & "★" & OPN_TIMS_NO)	
		
		   g_isDelete = ""
		
		End If
		
	End If  
End Sub	   


Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "mbbnk62032_t1" then
		AcComb.clear = ""
		g_szSet = 0		
		AllSearch()
		
	elseif sEventName == "mbbnk62032_t2" then
		g_szSet = 1
		AllSearch()
		
	elseif sEventName == "mbbnk62032_t3" then	
		g_szSet = 1
		DrngEmail = sParam
		
		'이메일의 경우 바뀌기 전 값을 가져오므로 다르게 처리[api 영향]
		'AllSearch()
		
	elseif sEventName == "mbbnk62032_t4" then		
		DrngAgrmYn = sParam
		g_szSet = 1
		
		'위와 동일
		'AllSearch()
		
	elseif sEventName == "mbbnk62032_t5" then 'v001
		AcComb.clear = ""
		g_szSet = 0		
		g_isDelete = "Y"
		
		AllSearch()		
		
	end if
	
	LinkYn = "N"
	
End Sub 


