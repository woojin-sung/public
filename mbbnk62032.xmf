			<PAGE name="page2" caption="계좌별명" linkfile="mbbnk62032_t2" loadingtype="1" />
			<PAGE name="page3" caption="이메일변경" linkfile="mbbnk62032_t3" loadingtype="1" />
			<PAGE name="page4" caption="출금이체동의" linkfile="mbbnk62032_t4" loadingtype="1" />
			<PAGE name="page5" caption="계좌등록해지" linkfile="mbbnk62032_t5" loadingtype="1" />
