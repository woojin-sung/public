'----------------------------------------------------------------------------
' 01. 화 면 명 : 서브_종목검색창
' 02. 화면설명 : 주식현재가 종목검색창
' 03. 작    성 : 2016.04.30 LJS
'----------------------------------------------------------------------------
'20210223 HSZ 야간선물 제도개편 [기존 실시간 서비스 변경]
'			호가 : ohhts_cmef_aspr -> ohhts_efut_aspr
'			체결 : ohhts_cmef_cntg -> ohhts_efut_cntg
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket

Dim g_szCurtouch								' 현재가 터치이동 ( 최근조회종목("0"),관심종목("1"),watching등록종목("2") - 초기값 "0" )
Dim g_szSwingGroup							' 관심종목일경우 관심그룹키
Dim g_szInterest_cloud							' 관심종목동기화(0:로컬, 1:서버)

Dim g_szSearchItems							' 조회종목(최근조회종목, 관심종목, Watching종목)
Dim g_nIndexItem								' 조회종목의 Index
Dim g_bMoveItem								' 화면에서 발생 여부


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Move_ItemCode
'============================================================================
Function Move_ItemCode( szType )
	
	If szType = "Right" Then
		g_szItemCode = Form.ACRGetProp( "nextitem" )
	
	ElseIf szType = "Left" Then
		g_szItemCode = Form.ACRGetProp( "previtem" )
		
	End If
	
	g_bMoveItem = false
	
	g_szItemCode 	 = g_szSearchItems( g_nIndexItem )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")

	'MarketType Default : "CM"로 결정
	if Len(Trim(g_szItemMarket)) == 0 Then
		g_szItemMarket = "CM"			
	end if
	

	Form.SetItemCode(g_szItemCode)
	DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
	DATAMANAGER.RequestTranData( "ohhts_5030_003r" )
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Function SetHogaTblFgColor( nPrice )

	If nPrice  > 0 then 
		tblHoga.SetCellFgColor( 0, 0, "10" )
	ElseIf nPrice < 0 then 
		tblHoga.SetCellFgColor( 0, 0, "11" )
	Else
		tblHoga.SetCellFgColor( 0, 0, "12" )
	End If

End Function


'============================================================================
Sub Form_OnFormInitBefore()
	g_szCurtouch		 = Form.GetEnvData( "common.curtouch_swing" 		)	' 현재가 터치이동
	g_szSwingGroup	 = Form.GetEnvData( "common.curtouch_swing_group"	)	' 관심종목일경우 관심그룹키
	g_szInterest_cloud = Form.GetEnvData( "common.interest_cloud" 		)	' 관심종목동기화(0:로컬, 1:서버)
	
	If g_szCurtouch = "" Then
		g_szCurtouch = "0"
	End If
	
	If g_szSwingGroup = "" Then
		g_szSwingGroup = ""
	End If
	
	If g_szInterest_cloud = "" Then
		g_szInterest_cloud = "0"
	End If
	
	
	ChartEx0.SetChartType("line")
	ChartEx0.SetPeriodType("1")
	ChartEx0.SetPeriodTime("5")
	ChartEx0.SetCMEChart("1") '20210721 HSZ 미달러 제도개선
	'test
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_bMoveItem 	= true
	g_nIndexItem = 0
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	If sKey = "ITEMCODE" Then
		If g_bMoveItem = true Then
			g_szItemCode = sValue
			g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")

			'MarketType Default : "CM"
			if Len(Trim(g_szItemMarket)) == 0 Then
				g_szItemMarket = "CM"			
			end if
						
			End If
			
		Set_MaskInfo()
		DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
		DATAMANAGER.RequestTranData( "ohhts_5030_003r" )
		
	end	if
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	

	DATAMANAGER.CancelRealData( "ohhts_nmix_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_efut_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_eopt_cntg" )
'	DATAMANAGER.CancelRealData( "ohhts_cmef_cntg" )	'20210223 HSZ 야간선물 제도개편
'	DATAMANAGER.CancelRealData( "ohhts_cusf_cntg" )	'20210712 HSZ 야간 미국달러선물 제도개편

	If szTranID = "ohhts_3050_001r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket 	)
		
	ElseIf szTranID = "ohhts_5030_003r" then
		Dim szToday
		szToday = Form.GetSharedData("&HOST_DATE", 0 )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode	)

		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_ISCD" 				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_DATE1" 			, 0 , szToday			)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" 		, 0 , "300"			)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" 	, 0 , "N"			)	
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_VRTL_TICK_INCU_YN" 	, 0 , "N"			)
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)

	If szTranID = "ohhts_nmix_cntg" then
		DATAMANAGER.SetDataValue( 1,  "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE" , 0 , "K2G01P" )		'20221111 SWJ START : 거래소 차세대 관련 지수 변경 (2029 -> K2G01P)
		
	ElseIf szTranID = "ohhts_futs_cntg" then
		DATAMANAGER.SetDataValue( 1,  "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" 	, 0 , g_szItemCode )

	ElseIf szTranID = "ohhts_optn_cntg" then
		DATAMANAGER.SetDataValue( 1,  "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD"  	, 0 , g_szItemCode )
	
	ElseIf szTranID = "ohhts_eopt_cntg" or szTranID = "ohhts_efut_cntg" then ' szTranID = "ohhts_cmef_cntg"  szTranID = "ohhts_cusf_cntg" 	'20210223 HSZ 야간선물 제도개편
		DATAMANAGER.SetDataValue(1, szTranID ,  "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode)
	
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim 	szItemCodeInfo
	Dim 	nPrice					'전일대비

	nPrice = DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_PRDY_VRSS2" , 0 )

	
	If g_szItemMarket = "EM" then
	    DATAMANAGER.RequestRealData( "ohhts_efut_cntg" )
	elseif g_szItemMarket = "CM" then
'		DATAMANAGER.RequestRealData( "ohhts_cmef_cntg" )	'20210223 HSZ 야간선물 제도개편
		DATAMANAGER.RequestRealData( "ohhts_efut_cntg" )
	elseif g_szItemMarket = "CD" then
'	    DATAMANAGER.RequestRealData( "ohhts_cusf_cntg" ) 	'20210712 HSZ 야간 미국달러선물 제도개편
		DATAMANAGER.RequestRealData( "ohhts_efut_cntg" ) 
	elseif g_szItemMarket = "EO" then					
	    DATAMANAGER.RequestRealData( "ohhts_eopt_cntg" )
	elseif g_szItemMarket = "EW" then					'20220307 HSZ 야간 위클리옵션 신규상장
	    DATAMANAGER.RequestRealData( "ohhts_eopt_cntg" )
	End If
	
	DATAMANAGER.RequestRealData( "ohhts_nmix_cntg" )
	
	g_bMoveItem 	= true

End Sub



'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")

		'MarketType Default : "CM"
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "CM"			
		end if
		

		DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
		DATAMANAGER.RequestTranData( "ohhts_5030_003r" )
	 end if
	 
	if sEventName = "sharedata" then
		Dim szFlag
	
		sName = Form.GetItemCodeInfo(g_szItemCode, "name")
		sCurpirce = FormatNumber( tblHoga.GetCellString(0, 0),  2)
		
		If CDbl(tblHoga.GetCellString(0, 3)) > 0 Then
			szFlag	= "▲"			
		ElseIf CDbl(tblHoga.GetCellString(0, 3)) < 0 Then
			szFlag	= "▼"
		Else
			szFlag	= ""
		End If
		
		sDiff    = FormatNumber( abs(tblHoga.GetCellString(0, 3)),  2)
		sRate     = FormatNumber( tblHoga.GetCellString(1, 2),  2)
		sQuqn	 = FormatNumber( tblHoga.GetCellString(1, 1),  0)
		szParam = sName.."\n"..sCurpirce.."\n ("..szFlag..sDiff.." / "..sRate.."% / "..sQuqn..")"
		Form.triggerEvent("#", "sharedata", szParam)
	end if
	
End Sub

'============================================================================
Sub btnItemLeft_OnClick()
	Move_ItemCode( "Left" )
End Sub

'============================================================================
Sub btnItemRight_OnClick()
	Move_ItemCode( "Right" )
End Sub
'============================================================================
Sub Form_OnRefresh()
	DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
	DATAMANAGER.RequestTranData( "ohhts_5030_003r" )
	
End Sub

'=============================================================================
Sub Set_MaskInfo()

if g_szItemMarket = "CD" then
 
 tblHoga.SetCellMaskInfo(0, 0, "0,0,,,1,,1,1,0")
else
	
tblHoga.SetCellMaskInfo(0, 0, "0,0,,,1,,2,1,0")
	
end if

End Sub

