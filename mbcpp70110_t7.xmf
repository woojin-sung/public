Dim g_pid



--===========================================================================

'============================================================================
Sub Form_OnFormInitBefore()
	
'	Dim szText
'	
'	szText = "<html><body ><center><b>Robo-Advisor를 통한 완벽한 수익추구!</b><br><br>"&
'			"투자자 성향이 이자 소득형인<br>"&
'			"투자자들에게 적합한 포트폴리오 입니다.<br><br>"&
'			"주식 17%, 채권 30% 예/적금 27% 비중으로<br>"&
'			"구성되며 포트폴리오 목표수익률은<br>"&
'			"5.2% / 표준편차는 3.1% 이내입니다.<br><br>"&
'			"이 포트폴리오가 추종하는 벤치마크는<br>"&
'			"KOSPI지수 20%+채권지수 80% 입니다.<br><br>"&
'			"</center></body></html>"
'			
'	Container0.WebView0.loaddata = szText

		
	g_pid=	Form.GetSharedData("Shared_PID", false )
	
	DATAMANAGER.SetDataValue(0,"obcpp_rbit_004r", "InBlock1", "PRTF_ID" , 0 , g_pid)
		
	DATAMANAGER.RequestTranData("obcpp_rbit_004r")
	
	
End Sub




'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

'	if szTranID = "obcpp_rbit_004r" then
'
'	end if
	
	temp1= "- 중도 해지(해지 수수료 없음)\n- 전환해지,현금해지 가능 일부 해지 불가\n(개별 요청에 의해 편입자산 일부 매각후 출금은 가능)"&
	"\n- 로보랩이 아닌 타 랩 상품과 상호 변경 불가"
	
	Container0.Grid0.SetCellData("bd_cell7",0,temp1)
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	Container0.Grid0.SetCellData("bd_cell0",0,"최저 가입 금액")
	Container0.Grid0.SetCellData("bd_cell2",0,"계약 기간")
	Container0.Grid0.SetCellData("bd_cell4",0,"Wrap Fee")
	Container0.Grid0.SetCellData("bd_cell6",0,"기타")
	
	
End Sub

