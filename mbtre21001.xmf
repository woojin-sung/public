'============================================================================
' 01. 화 면 명 : CFD 반대매매 내역
' 02. 화면설명 : CFD 반대매매 내역
' 03. 작    성 : 2021. 07. 19. KSJ
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_tItemCodeInfo 	'종목정보 배열
Dim g_szItemCode		'종목코드
Dim g_szItemSym		'종목거래소심볼
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' 구분에 따른 서비스 ID 얻기
'============================================================================
Function f_GetTranID()    
	Dim szGetTranID 
    If rdoKind.currentindex == 0 or rdoKind.currentindex == "0" Then
	    szGetTranID = "obtre_brng_112r"	' 종목별
    Else
	    szGetTranID = "obtre_brng_113r"	' 차입상세
    End If     
    
    return szGetTranID
End Function

'============================================================================
' f_InitCodeInfo : 종목정보 초기화
'============================================================================
Function f_InitCodeInfo()
	g_tItemCodeInfo = {}
	g_szItemCode = ""
	g_szItemSym = ""
	
End Function

'============================================================================
' f_SetCodeInfo : 종목정보 SET
'============================================================================
Function f_SetCodeInfo(szCodeInfo, szSplitType)
	if szCodeInfo <> "" and szSplitType <> "" then
		g_tItemCodeInfo = split(szCodeInfo, szSplitType)
		
		if szSplitType == "@" then '종목컨트롤에서 넘어온 종목정보(시장@코드 형식)
			g_szItemCode = g_tItemCodeInfo(1)
			g_szItemSym = g_tItemCodeInfo(0)
			
		elseif szSplitType == "." then '잔고팝업에서 넘어온 종목정보(코드.시장 형식)
			g_szItemCode = g_tItemCodeInfo(0)
			g_szItemSym = g_tItemCodeInfo(1)
			
			'20220527 SWJ START : 종목코드에 "."이 들어간 경우 파싱 오류 수정(EX.버크셔해서웨이)
			if instr(szCodeInfo,".") <> instrRev(szCodeInfo,".") then
				sztempExid = Right(szCodeInfo,len(szCodeInfo) - instrRev(szCodeInfo,"."))
				sztempCode = Replace(szCodeInfo,"." & sztempExid,"")
				
				g_szItemCode = sztempCode
				g_szItemSym = sztempExid
			end if
			'20220527 SWJ END 
		end if 
	end if
End Function

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Sub Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	Form.setTitleCaption( "해외주식CFD차입잔고 조회" )

	f_InitCodeInfo()
	ItemCode0.code = "empty"
	
	grd0.SetClear()
	grd1.SetClear()
	
	DATAMANAGER.RequestTranData( "obtre_comm_511r" )
	
End Sub
'============================================================================
' acnt0_ChangeAccount()
'============================================================================
Sub acnt0_ChangeAccount()
	grd0.SetClear()
	grd1.SetClear()
	DATAMANAGER.RequestTranData( f_GetTranID() )
End Sub

'============================================================================
' Form_OnCommonDialogReturn()
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	grd0.SetClear()
	grd1.SetClear()
	
	if sDlgName == "SEARCH" then
		f_InitCodeInfo()
		
		if sReturn1 <> "" then
			f_SetCodeInfo(sReturn1, "@")
			DATAMANAGER.RequestTranData( f_GetTranID() )
		end if
	end if
End Sub

'============================================================================
' btnAll_OnClick() : 종목전체조회
'============================================================================
Sub btnAll_OnClick()
	f_InitCodeInfo()
	ItemCode0.code = "empty"

	grd0.SetClear()
	grd1.SetClear()
	DATAMANAGER.RequestTranData( f_GetTranID() )
End Sub

'============================================================================
' rdoKind_OnClick() : 잔고조회구분 변경
'============================================================================
Sub rdoKind_OnClick(nIndex)
	' 잔고조회구분 : 종목별
	If nIndex = 0 Then
	    grd0.visible = True
	    grd1.visible = False
	' 잔고조회구분 : 차입상세
	Else 
	    grd0.visible = False
	    grd1.visible = True	    
	End If
	
	'조회구분 변경시 재조회	
	grd0.SetClear()
	grd1.SetClear()
	DATAMANAGER.RequestTranData( f_GetTranID() )
End Sub

'============================================================================
' grd0_OnClickUp() : 종목조회
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szCodeInfo
	szCodeInfo = grd0.GetCellData( "bd_cell0", lRow )
	
	if szCodeInfo ~= "" and szCodeInfo ~= null and len(szCodeInfo) > 0 Then
		f_InitCodeInfo()
		f_SetCodeInfo(szCodeInfo, ".")
		ItemCode0.code = g_szItemSym & "@" & g_szItemCode
		
		grd0.SetClear()
		DATAMANAGER.RequestTranData( "obtre_brng_112r" )
	end if
End Sub

'============================================================================
' grd0_OnScrollEnd() : NextData 조회
'============================================================================
Sub grd0_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData("obtre_brng_112r") == True Then
		DATAMANAGER.RequestNextData( "obtre_brng_112r" )
	End If
End Sub

'============================================================================
' grd1_OnScrollEnd() : NextData 조회
'============================================================================
Sub grd1_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData("obtre_brng_113r") == True Then
		DATAMANAGER.RequestNextData("obtre_brng_113r")
	End If
End Sub
'============================================================================
' btnRefresh_OnClick()
'============================================================================
Sub btnRefresh_OnClick()
	grd0.SetClear()
	grd1.SetClear()
	DATAMANAGER.RequestTranData( f_GetTranID() )
End Sub
'============================================================================
' Form_OnRefresh()
'============================================================================
Sub Form_OnRefresh()
	grd0.SetClear()
	grd1.SetClear()
	DATAMANAGER.RequestTranData( f_GetTranID() )
End Sub


'****************************************************************************
'				     	D A T A M A N A G E R
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore()
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obtre_brng_112r" or szTranID == "obtre_brng_113r" Then
		dim szExType, szCodeInfo
		szCodeInfo = ""
		szExType = cmbMktType.cbkeydata
		
		if szExType == "" or szExType == null then
			szExType = "%"
		end if
		
		if g_szItemSym <> "" and g_szItemCode <> "" then
			szCodeInfo = g_szItemCode & "." & g_szItemSym
		end if
'		Form.ShowAlert(szTranID, szCodeInfo)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 			, 0 , 	acnt0.total		)'Left(cmb0.caption , 8))'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" 			, 0 , 	acnt0.sequence	)'Right(cmb0.caption , 2))'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" 		, 0 ,	""				)'계좌비밀번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISCD" 			, 0 , 	szCodeInfo		)'종목코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CFD_EXCH_CODE"	, 0 , 	szExType			)'종목코드
	
	elseif szTranID == "obtre_comm_511r" then
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , 	acnt0.total)'Left(cmb0.caption , 8))		'계좌번호
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , 	acnt0.sequence)'Right(cmb0.caption , 2))	'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CFD_EXCH_CODE" , 0 , "%" ) '코드 %:전체조회
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CFD_EXCH_NAME" , 0 , "%" ) '거래소 %:전체조회
		
	End If
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtre_comm_511r" then
		Dim nTranCnt, szComboList
		nTranCnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
		szComboList = ""
		
		for i=0 to nTranCnt-1
			dim szCode, szName
			szCode = Trim(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CFD_EXCH_CODE", i ))
			szName = Trim(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CFD_EXCH_NAME", i ))
			
			if szComboList == "" then
				szComboList = szCode & "`" & szName
			else
				szComboList = szComboList & "\r\n" & szCode & "`" & szName
			end if
			
		next
		
		if szComboList <> "" then
			cmbMktType.cbinputdatatext = "%`전체\r\n" & szComboList
			
			DATAMANAGER.RequestTranData( f_GetTranID() )
		end if
	end if
End Sub

'============================================================================
Sub cmbMktType_OnEditComplete(iIndex)
	DATAMANAGER.RequestTranData( f_GetTranID() )
End Sub

