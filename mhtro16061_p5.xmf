'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문 기간설정 창
' 03. 작    성 : 2016.07.15 NOHES
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


Dim g_Vendor
Dim g_szTextSize, g_szDeviceOS

'============================================================================
Sub Form_OnFormInit()
	g_szTextSize = Form.GetEnvData("common.textsize")
	g_szDeviceOS = Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS

	sData = Form.GetOpenLinkData()
	tData = Split(sData, "★")
	If UBound(tData) > 0 then
		'거래소
		g_Vendor = tData(0)
		
		'주문유형별 주문시간 콤보 세팅
		szOrdType = tData(1)
		if szOrdType = "31" or szOrdType = "32" or szOrdType = "33" or szOrdType = "34" then
			rgptime.currentindex = 0
			rdoOrdTime.enable = false
		else
			rdoOrdTime.currentindex = 0
			rdoOrdTime.enable = true
		end if
		
		call rdoOrdType_OnClick(0)
		DATAMANAGER.RequestTranData("obtro_comn_006r"  )
	end if
End Sub

'============================================================================
Sub btnSave_OnClick()

	Dim flag 
	'예약구분★시작일자★종료일자★시간구분
	nType = CInt(rdoOrdType.currentindex)
	nRange = CInt(rdoRange.currentindex)
	
	if nType = 1 then
		if nRange < 0 then
			ShowAlert "기간설정", "주문유형을 선택해주세요."
			exit sub
		else
			flag = nRange + 1
		end if
	else
		flag = nType
	end if
	
	If flag == 1 or flag == 2 Then
		If cldStart.caption == "" or Len(cldStart.caption) <> 8 Then
			ShowAlert "기간설정", "예약주문 시작일자가 유효하지 않습니다."
			Exit Sub
		End If
		If cldFinish.caption == "" or Len(cldFinish.caption) <> 8 Then
			ShowAlert "기간설정", "예약주문 종료일자가 유효하지 않습니다."
			Exit Sub
		End If
		If CDbl(cldStart.caption) >= CDbl(cldFinish.caption) Then
			ShowAlert "기간설정", "기간예약 종료일이 시작일과 같거나 앞설 수 없습니다."
			Exit Sub
		End If
		
		'20200911 LES START 예약시간 추가
		sLnkData = flag &"★"& cldStart.caption &"★"& cldFinish.caption & "★" & rgptime.cbkeydata
		'20200911 LES END
	
	Elseif flag == 3 Then
			If cldStart.caption == "" or Len(cldStart.caption) <> 8 Then
				ShowAlert "기간설정", "예약주문 시작일자가 유효하지 않습니다."
				Exit Sub
			End If
		
		'20200911 LES START 예약시간 추가
		sLnkData =  flag &"★"& cldStart.caption &"★"& "" & "★" & rgptime.cbkeydata
		'20200911 LEs END
		
	Else
		'20200911 LES START 예약시간 추가
		sLnkData =  flag &"★"& Form.GetSharedData("&HOST_DATE", false) &"★"& Form.GetSharedData("&HOST_DATE", false) & "★" & rgptime.cbkeydata
		'20200911 LES END
	End If
		
	Form.SendReturnToParent("Range" , sLnkData)

	Form.CloseForm()
End Sub

'============================================================================
Sub cldStart_OnEditComplete()
	If Len(cldStart.caption) <> 8 Then
		ShowAlert "기간설정", "예약주문 시작일자가 유효하지 않습니다."
		cldStart.caption = ""
		Exit Sub
	End If
	
	If CDbl(cldStart.caption) > CDbl(cldadd30.caption) Then
		ShowAlert "기간설정", "주문예약기간은 30일 이내만 지정가능합니다."
		cldStart.caption = cldadd30.caption
		cldFinish.caption = cldadd30.caption
		Exit Sub
	End If
	If CDbl(cldStart.caption) < CDbl(cldHost.caption) Then
		'-----------------------------------------------------------------------
		'국가별 메시지 분기처리 추가
		'-----------------------------------------------------------------------
		'미국(뉴욕, 나스닥, 아멕스)
		if g_Vendor == "0321" or g_Vendor == "0537" or g_Vendor == "0066" then
			ShowAlert "기간설정", "시작일을 오늘날짜로 변경합니다."
		'그 외(중국, 홍콩, 일본)
		else
			ShowAlert "기간설정", "시작일은 익영업일부터 지정 가능합니다."
		end if
		
		cldStart.caption = cldHost.caption
	End If
	
End Sub

'============================================================================
Sub cldFinish_OnEditComplete()
	If Len(cldFinish.caption) <> 8 Then
		ShowAlert "기간설정", "예약주문 종료일자가 유효하지 않습니다."
		cldFinish.caption = ""
		Exit Sub
	End If
		
	If cldadd30.caption == "" Then
		ShowAlert "기간설정", "예약 시작날짜를 확인해주십시오."
		Exit Sub
	End If
	If CDbl(cldFinish.caption) > CDbl(cldadd30.caption) Then
		ShowAlert "기간설정", "주문예약기간은 30일 이내만 지정가능합니다.(종료일자 30일 이후 지정 불가)"
		cldFinish.caption = cldadd30.caption
		Exit Sub
	End If
	
End Sub

'============================================================================
Sub rdoRange_OnClick(nIndex)
	lblRangeTxt.caption = " "
	lblTxt0.visible = false
	
	If CInt(nIndex) == 2  Then
		cldFinish.caption = cldHost.caption
		cldStart.visible = True
		cldStart.caption = cldHost.caption
		lblcal.visible = false
		cldFinish.visible = False
		cldFinish.caption = ""
	Elseif CInt(nIndex) == 0 or CInt(nIndex) == 1 then
		cldStart.visible = True
		cldStart.caption = cldHost.caption
		lblcal.visible = True
		cldFinish.visible = True
		cldFinish.caption = cldHost.caption
	End If
	
	Select Case Cint(rdoRange.currentindex)
	' 기간잔량
	Case 0
		if CInt(g_szTextSize) > 0 then '글자크기 세팅(특정일주문 선택 후 글자크기 초기화 필요)
			lblRangeTxt.fontsize = -2
		end if
		lblRangeTxt.caption = "예약수량이 전부 체결될 때까지 주문이 진행돼요. \n기간은 30일 이내만 지정 가능해요."
		lblRangeTxt.changeTextAttr(6, 8, 10, -2, false)
	
	' 기간예약
	Case 1
		if CInt(g_szTextSize) > 0 then '글자크기 세팅(특정일주문 선택 후 글자크기 초기화 필요)
			lblRangeTxt.fontsize = -2
		end if
		lblRangeTxt.caption = "지정기간 동안 예약수량을 매일 반복해서 주문이 진행돼요. 기간은 30일 이내만 지정 가능해요."
		lblRangeTxt.changeTextAttr(0, 7, 10, -2, false)
		lblRangeTxt.changeTextAttr(14, 14, 10, -2, false)
	
	'특정일주문
	Case 2
		if g_Vendor == "0321" or g_Vendor == "0537" or g_Vendor == "0066" then	'미국
			if CInt(g_szTextSize) > 0 then '큰글씨
				nSize = - 3 - CInt(szTextSize)
				lblRangeTxt.fontsize = nSize
			else
				nSize = -2
			end if
			
			lblRangeTxt.caption = "지정한 날짜에 예약 주문이 진행돼요. \n익영업일부터 지정 가능하며, 기간은 30일 이내만 지정 가능해요."
		else																'미국 외(중국, 홍콩, 일본)
			nSize = -2
			lblRangeTxt.caption = "지정한 날짜에 예약 주문이 진행돼요. \n기간은 30일 이내만 지정 가능해요."
		end if
		
		lblRangeTxt.changeTextAttr(0, 7, 10, nSize, false)
	End Select
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue( False, "obtro_comn_006r", "InBlock1", "OVRS_EXCH_VNDR_IDNO", 0 , g_Vendor)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obtro_comn_006r" Then
		cldHost.caption =  DATAMANAGER.GetDataValue(False, "obtro_comn_006r", "OutBlock1", "BSOP_DATE"  , 0)
		cldadd30.caption =  DATAMANAGER.GetDataValue(False, "obtro_comn_006r", "OutBlock1", "BSOP_DATE"  , 0)
		Form.SetCtlProp("cldadd30", "addday", "29")
	End If
End Sub

'============================================================================
Sub rdoOrdType_OnClick(nIndex)
	if CInt(nIndex) == 0 then		'일반예약
		imgBG.top = 140
		lblTitle.top = 140
		lblTitle1.top = 195
		rdoOrdType.top = 225
		lblTxt.top = 272
		
		lblTxt.visible = true
		lblTxt0.visible = false
		rdoRange.visible = false
		cldStart.visible = false
		cldFinish.visible = false
		lblcal.visible = false
		lblRangeTxt.visible = false
		
	elseif CInt(nIndex) == 1 then	 '기간설정
		imgBG.top = 50
		lblTitle.top = 50
		lblTitle1.top = 110
		rdoOrdType.top = 140
		lblTxt.top = 202
		
		lblTxt.visible = false
		rdoRange.visible = true
		lblRangeTxt.visible = true
		cldStart.visible = false
		cldFinish.visible = false
		lblcal.visible = false
		
		nIdx = CInt(rdoRange.currentindex)
		if nIdx >= 0 then
			call rdoRange_OnClick(nIdx)
		else
			lblTxt0.visible = true
		end if
	end if
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub rdoOrdTime_OnClick(nIndex)
	rgptime.currentindex = nIndex
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgInfo.setmaintainingratio("1")
End Sub

	</SCRIPT_INFO>
