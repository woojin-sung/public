		<IMAGE name="Image2" autosize="1" imgpath="img_rental02" ly_vert="2,226,370,118,1" />
		<LABEL name="lblSubTitle0" fgcolor="146:124124124" fontsize="-2" caption="- 보유주식 수익 서비스로 발생하는 수수료는 기타 소득으로
  분류되며 22%의 기타 소득세가 부가됩니다. (연간 합계 
  300만원 초과시 종합과세 대상에 포함)

- 대주주, 주요주주 및 특수관계인, 주식을 발생한 기업의
   임원인 경우, 주식 재활용시 지분공시 의무가 발생합니다.
   특정주식을 제외하고 싶다면 주식재활용불가 종목 설정을
   하거나 별도 계좌를 개설하여 관리하시기 바랍니다.
   단, 재활용의 제한이 요청된 주식은 보유주식 수수료 지급
   대상에서 제외됩니다." valign="0" multiline="1" ly_vert="6,431,352,164,1" />
		<LABEL name="lblSubTitle1" fontsize="-2" caption="모두 고객에게 귀속됩니다. (의결권 제외)" valign="0" multiline="1" ly_vert="16,401,352,18,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="3943" _ulen="3319" >
'============================================================================
' 01. 화 면 명 : 보유주식 수익 서비스 대차거래 안내팝업
' 02. 화면설명 : 보유주식 수익 서비스 대차거래안내팝업
' 03. 작    성 : 2022.08.02 양현정
' 04. 수    정 : 
'
'============================================================================

Dim  g_szTheme                  '테마구분  white/black

'============================================================================
'문구 색깔 변경..
'============================================================================
Function f_SetLabelColor()

	Dim nStaOffset, nLen
	
	'3 Line
	'lbl1Line3.caption = "대여주식으로부터 발생된 대여 수수료를 받아"

	'nStaOffset = lbl1Line3.getLen("대여주식으로부터 발생된 ")
	'nLen       = lbl1Line3.getLen("대여 수수료를 받아")
	
	'lbl1Line3.changeTextAttr(0, nStaOffset-1, 146, -1, false)
	'lbl1Line3.changeTextAttr(nStaOffset, nLen, 289, -1, false)	
	
	'4 Line
	'lbl1Line4.caption = "추가수익을 낼 수 있는 거래입니다."
	
	'nStaOffset = lbl1Line4.getLen("추가수익을 ")
	'nLen       = lbl1Line4.getLen("낼 수 있는 거래입니다.")	
	
	'lbl1Line4.changeTextAttr(0, nStaOffset-1, 289, -1, false)
	'lbl1Line4.changeTextAttr(nStaOffset, nLen, 146, -1, false)	
	
	'5 Line
	lbl1Line5.caption = "재활용주식은 [대여주문화면]에서 언제든지 매도가"
	
	nStaOffset = lbl1Line5.getLen("재활용주식은 ")
	nLen       = lbl1Line5.getLen("[대여주문화면]")
	
	'lbl1Line5.changeTextAttr(0, nStaOffset-1, 146, -1, false)
	lbl1Line5.changeTextAttr(nStaOffset, nLen, 4, -1, false)	

	nStaOffset = lbl1Line5.getLen("재활용주식은 [대여주문화면]에서 ")
	nLen       = lbl1Line5.getLen("언제든지 매도")
	
	lbl1Line5.changeTextAttr(nStaOffset, nLen, 4, -1, false)		
	
	'6 Line
	lbl1Line6.caption = "가능하며 재활용주식은 언제든지 반환요청(상환)"
	
	nStaOffset = lbl1Line5.getLen("가능하며 재활용주식은 ")
	nLen       = lbl1Line5.getLen("언제든지 반환요청")	
	
	lbl1Line6.changeTextAttr(nStaOffset, nLen, 4, -1, false)		
			
	
End Function

'============================================================================
Sub Form_OnFormInit()
	
	'안드로이드-백버튼 작동Y
	'부모창(mbonl88024) 백버튼N 상태에서 팝업오픈 되므로 백버튼 동작하도록 설정	
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")

    '테마구분 white/black
	g_szTheme = Form.GetEnvData("common.theme")
	
	If g_szTheme = "black" Then
		Image2.imgpath   = "img_rental03"   
	Else
		Image2.imgpath   = "img_rental02"  'white모드도 동일 
	End If

     '이미지설정
	'imgBg.imgpath       = "alpha128"
	imgExit.imgpath     = "icon_close"

	BtnContinue.imgpath = "btn_20.9"
	
	'라벨 색상 변경
	f_SetLabelColor()
	
End Sub


'============================================================================
Sub BtnContinue_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	'화면닫기전 안드로이드-백버튼 작동N 원복(부모화면에서 호출했던 상태로)
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

	'Form.SendReturnToParent("mbbdm85110_p2" , g_BDM_CLEAR_YN)
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용_백버튼
	imgExit_OnClick()
End Sub
'============================================================================
Sub imgBg_OnClick()
	imgExit_OnClick()
End Sub
'============================================================================
Sub imgExit_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Image2.setMaintainingRatio("1")

End Sub

