	<SCRIPT_INFO _len="10215" _ulen="8915" >
'============================================================================
' 01. 화 면 명 : 레버리지ETF/ETN교육등록
' 02. 화면설명 : 레버리지ETF/ETN 사전교육이수번호 등록
' 03. 작    성 :
' 2020.08.04 : 정민영 : 신규개발
' 2020.09.17 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
'============================================================================
' Form 기본정보 0,0,375,562,1
'============================================================================
'****************************************************************************
'         G L O B A L V A R I A B L E
'****************************************************************************
Dim g_szPW        '비밀번호

'교육이수등록정보
Dim g_CorpYN       '법인여부
Dim g_ETFStplYN    'ETF약정여부
Dim g_ETNStplYN    'ETN약정여부
Dim g_CmcoYN       '교육이수여부 X.미존재 Y.이수완료(정상승인) N.이수이력존재(취소또는승인중)
Dim g_AprvClsCode  '승인구분코드 00.승인대기 01.승인 03.반려
Dim g_plain_rm     'v0001 메모리평문적용여부

'****************************************************************************
'         P E R S O N A L F U N C T I O N
'****************************************************************************
'============================================================================
Sub USER_Info_Init()
    '교육이수 등록정보 초기화
    g_CorpYN       = ""    '법인여부
    g_ETFStplYN    = ""    'ETF약정여부
    g_ETNStplYN    = ""    'ETN약정여부
    g_CmcoYN       = ""    '교육이수여부
    g_AprvClsCode  = ""    '승인구분코드
End Sub
'****************************************************************************
'         C O M M O N F U N C T I O N
'****************************************************************************
'============================================================================
' Form
'============================================================================
'============================================================================
Sub Form_OnFormInit()
    'v0001 메모리평문적용여부(0:미적용 / 1:적용)
    g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)

    edtPW.caption = ""
    btnOK.enable = false

    '교육이수정보 등록여부 조회
    Call USER_Info_Init()
    DATAMANAGER.RequestTranData( "obpds_srvc_425r" )

End Sub
'============================================================================
' 계좌번호
'============================================================================
'============================================================================
Sub acnt0_ChangeAccount()

    '계좌번호 변경시, 정보 초기화
    edtPW.caption = ""    '비밀번호
    g_szPW        = ""    '비밀번호
    edt1.caption  = ""    '교육이수번호

    '교육이수정보 등록여부 조회
    Call USER_Info_Init()
    DATAMANAGER.RequestTranData( "obpds_srvc_425r" )

End Sub
'============================================================================
' 비밀번호
'============================================================================
'============================================================================
Sub edtPW_OnEditComplete()

    'v0001
	if g_plain_rm == "1" then  'MTS메모리평문 적용상태일때
		g_szPW = edtPW.caption	
	else  'MTS메모리평문 미적용상태일때
	    g_szPW = Form.GetEncData( edtPW.caption )
	end if

    '교육이수정보 등록여부 조회
    DATAMANAGER.RequestTranData( "obpds_srvc_425r" )

End Sub
'============================================================================
' 신청(변경)
'============================================================================
'============================================================================
Sub btnOK_OnClick()
    if g_CorpYN == "Y" then
        Form.ShowAlert( "알림", "개인 투자자만 등록 가능합니다.")
        Exit Sub
    elseif g_ETFStplYN ~= "Y" and g_ETNStplYN ~= "Y" then
        Form.ShowAlert( "알림", "파생상품ETF 또는 ETN 거래신청 약정 상태에서만 등록 가능합니다.")
        Exit Sub
    elseif edtPW.caption == "" or edtPW.caption == Null then
        Form.ShowAlert( "알림", "비밀번호를 입력해 주세요.")
        Exit Sub
    elseif g_AprvClsCode == "00" then  '00.승인대기
        Form.ShowAlert( "알림", "교육이수번호 등록정보가 접수되어 확인중에 있습니다.")
        Exit Sub
    elseif edt1.caption == "" then
        Form.ShowAlert( "알림", "레버리지ETF/ETN 교육이수번호를 입력해 주세요.")
        Exit Sub
    elseif g_AprvClsCode == "01" then  '01.승인완료        
        Form.MsgBox( "알림", "신청시 기등록된 정보는 자동 취소됩니다.\n새로운 교육이수번호 정보로 신청(변경) 하시겠습니까?", "btnCancelOK", 1)
        Exit Sub
    else
        'ETF/ETN 사전교육이수 정보 등록(변경)
        DATAMANAGER.RequestTranData( "obpds_srvc_425a" )
    end if

End Sub
'============================================================================
' Form_OnMsgBoxClose
'============================================================================
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
    if sKeyName == "btnCancelOK" then
        if sRet == "ok" then
            'ETF/ETN 사전교육이수 정보 신청(변경)
            DATAMANAGER.RequestTranData( "obpds_srvc_425a" )
        'else
        '    Form.ShowAlert("알림", "등록(변경) 신청이 취소되었습니다.")
        end if
    end if
End Sub
'============================================================================
' DATAMANAGER
'============================================================================
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

    if szTranID == "obpds_srvc_425r" then
        DATAMANAGER.SetDataValue( 0 , "obpds_srvc_425r", "InBlock1", "ACNO" , 0 , acnt0.caption)  '계좌번호
    elseif szTranID == "obpds_srvc_425a" then
        DATAMANAGER.SetDataValue( 0 , "obpds_srvc_425a", "InBlock1", "PROS_CLS_CODE" , 0 , "I" )  'I.등록 D.삭제(MTS는삭제없음)
        DATAMANAGER.SetDataValue( 0 , "obpds_srvc_425a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )  '4.온라인
        DATAMANAGER.SetDataValue( 0 , "obpds_srvc_425a", "InBlock1", "ACNO"          , 0 , acnt0.caption  )  '계좌번호
        DATAMANAGER.SetDataValue( 0 , "obpds_srvc_425a", "InBlock1", "ACNT_PWD"      , 0 , g_szPW         )  '비밀번호
        DATAMANAGER.SetDataValue( 0 , "obpds_srvc_425a", "InBlock1", "EDCT_CMCO_NO"  , 0 , edt1.caption   )  '교육이수번호
    end if

End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    Dim szErr

    if szTranID == "obpds_srvc_425r" then
        szErr = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_425r")
        Form.ShowAlert( "알림", szErrMsg.."\n("..szErr..")")
	
        '정보 조회 오류시, 등록처리 못하도록 버튼 비활성화
        btnOK.enable  = false
    elseif szTranID == "obpds_srvc_425a" then
        szErr = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_425a")
        Form.ShowAlert( "알림", szErrMsg.."\n("..szErr..")")
    end if

End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    Dim szText, szSubText

    if szTranID == "obpds_srvc_425r" then
        g_CorpYN       = DATAMANAGER.GetDataValue( 0, "obpds_srvc_425r", "OutBlock1", "CORP_YN"       , 0)  '법인여부
        g_ETFStplYN    = DATAMANAGER.GetDataValue( 0, "obpds_srvc_425r", "OutBlock1", "ETF_STPL_YN"   , 0)  'ETF약정여부
        g_ETNStplYN    = DATAMANAGER.GetDataValue( 0, "obpds_srvc_425r", "OutBlock1", "ETN_STPL_YN"   , 0)  'ETN약정여부
        g_CmcoYN       = DATAMANAGER.GetDataValue( 0, "obpds_srvc_425r", "OutBlock2", "UI_CMCO_YN"    , 0)  '교육이수여부
        g_AprvClsCode  = DATAMANAGER.GetDataValue( 0, "obpds_srvc_425r", "OutBlock2", "APRV_CLS_CODE" , 0)  '승인구분코드

        '현재 이수상태에 따른 컨트롤 설정
        '교육이수여부 X.미존재 Y.이수완료(정상승인) N.이수이력존재(취소또는승인중)
        '승인구분코드 00.승인대기 01.승인 03.반려
        if g_CmcoYN == "X" then
            lblStat.caption = ""
            btnOK.caption = "신청"
            btnOK.enable  = true
        elseif g_CmcoYN == "Y" then
            lblStat.caption = "상태:신청완료"
            btnOK.caption = "신청(변경)"
            btnOK.enable  = true
        else
            if g_AprvClsCode == "00" then
                lblStat.caption = "상태:승인신청중"
                btnOK.caption = "신청(변경)"
                btnOK.enable  = false
            else
                if g_AprvClsCode == "03" then
                    lblStat.caption = "상태:승인취소"
                else
                    lblStat.caption = "상태:취소"
                end if
                btnOK.caption = "신청(변경)"
                btnOK.enable  = true
            end if
        end if
    elseif szTranID == "obpds_srvc_425a" then
        szText = DATAMANAGER.GetDataMsgText( "obpds_srvc_425a" )
        szSubText = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_425a")
        Form.ShowAlert( "알림", szText&"\n"&szSubText)
    end if

End Sub
'============================================================================
' Popup Return
'============================================================================
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'화면연동에 따른 로직 없음
End Sub



	</SCRIPT_INFO>
