'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl82100_p2" , "")
End Sub



'============================================================================
Sub Form_OnFormInitBefore()
	imgIcon.setMaintainingRatio("1")

End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	Dim tData
	
	szOpenData = trim(Form.GetOpenLinkData( ))
	if szOpenData ~= "" then
		' g_szAccount.."★"..g_szButtonRadio1.."★"..g_szButtonEmail.."★"..g_szButtonRadio2.."★"..contScroll.btnOnOff.switchindex
		tData = Split(szOpenData, "★" )
		
		'계좌
		lblData1.caption = f_SetAccountMask(tData[0])

		lblData2.caption = CInt(trim(tData[1]))
		
		lblData3.caption = CInt(trim(tData[2]))
		
		'담보관련 통보방법
		if tData[3] == "1" then
			lblData4.caption = "SMS, 이메일"
		else
			lblData4.caption = "SMS"
		end if 
		
		'계약서류 통보방법
		if tData[4] == "1" then
			lblData5.caption = "알림톡·문자"
		else
			lblData5.caption = "이메일"
		end if 
		
		'처리구분
		if tData[5] == "1" then
			lblResult1.visible = true
			lblResult2.visible = false
		else
			lblResult1.visible = false
			lblResult2.visible = true
		end if 
		

	end if
End Sub



'============================================================================
Function f_SetAccountMask(szAccount)
	Dim szReturnData 
	if trim(szAccount) ~= "" then
		if #szAccount == 10 then
			szReturnData = Left(szAccount,4)&"-"&Mid(szAccount,5,4)&"-"&Right(szAccount,2)		
		elseif #szAccount == 8 then
			szReturnData = Left(szAccount,4)&"-"&Right(szAccount,4)
		else
			szReturnData = szAccount
		end if
	end if
	
	return szReturnData
	
End Function

