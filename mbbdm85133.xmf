Sub Form_OnFormClose()
	'화면닫기전 안드로이드-백버튼 작동Y 원복
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")	
	
	'v0006 2022.03.24 추가 
	If szFlag == "HOME" Then
		Form.OpenScreen( "41000" , "" )
	End If 
End Sub

'============================================================================
'화면 진입시 연금저축 영역에 대한 데이터 세팅
'============================================================================
Function SetPnsnDataSet()
	Container1.SetScrollAutoSize()
	
	g_bAcntVerified = false
	g_bPnsnView = false
	g_bTrTimer = false
	
	g_bErrorFlag1 = false
	g_bErrorFlag2 = false
	g_bErrorFlag3 = false
	g_nErrorCnt = 0
	
	g_nPnsnCmaCnt = 0
	
	Container1.lblAcntTitle.fgcolor = "267"
	
	Container1.edtBank.fgcolor = "103"
	
	'연금지급기관, 계좌 초기화
	g_BDM_PNSN_PRVS_BANK_CODE = ""
'	g_BDM_PNSN_PRVS_BANK_CODE = "287"		'초기선택 메리츠
	g_BDM_PNSN_PRVS_BANK_ACNO = ""			'지급계좌번호
	Form.SetSharedData("BDM_PNSN_PRVS_BANK_CODE"           , g_BDM_PNSN_PRVS_BANK_CODE)
	Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , g_BDM_PNSN_PRVS_BANK_ACNO)
	
	'비대면계좌개설 이어가기 조회
	'조회 후 연금지급개시 예정일자 세팅
	DATAMANAGER.RequestTranData( "obaci_acct_072r" )
	
	'은행연합회 한도금액 조회
	DATAMANAGER.RequestTranData( "obaci_acct_089r" )
End Function 

