'============================================================================
Function User_SharedData_Set(gb)
    '진입점에서 설정되는 정보 --------------------------------------------------
    Form.SetSharedData("BDM_FRST_MAPID" , g_BDM_FRST_MAPID )  '최초진입화면ID

    If Mid(gb, 1, 4) == "init" Then
        strInitGb = Mid(gb, 5, 1)
        If strInitGb == "A" Then
            '진입점에서 설정되는 정보 ------------------------------------------
            Form.SetSharedData("BDM_NMETBSWRGB"         , ""  )  '비대면업무구분
            Form.SetSharedData("mOTP_IntoClcd"          , ""  )  '(모바일OTP)진입구분코드
            Form.SetSharedData("BDM_CSNO"               , ""  )  '고객번호
            Form.SetSharedData("BDM_REG_UNIQ_NO"        , ""  )  '등록고유번호
            Form.SetSharedData("BDM_RCNO_PIP"           , ""  )  '실명확인번호
            Form.SetSharedData("BDM_HP1"                , ""  )  '휴대폰번호
            Form.SetSharedData("BDM_HP2"                , ""  )
            Form.SetSharedData("BDM_HP3"                , ""  )
            Form.SetSharedData("BDM_CLEAR_YN"           , ""  )  '이어가기여부
        End If
        If strInitGb == "A" Or (strInitGb == "1" Or strInitGb == 1) Then
            '2단계진입 설정정보 ------------------------------------------------
            Form.SetSharedData("BDM_ABLE_YN"            , ""  )  '개별추가가능여부
            Form.SetSharedData("BDM_OVRL_ACNT_OPNG_YN"  , ""  )  '종합개설가능여부(최근30일내종합신규개설여부) Y.불가 N.가능
            Form.SetSharedData("BDM_DREM_YN"            , ""  )  'Y.임직원 N.고객
            Form.SetSharedData("BDM_REG_SRNO"				, ""	)	'등록일련번호	'ksj 2021-07-23
		   Form.SetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, ""	)	'목표시장부적합여부	'ksj 2021-07-23
		    'v0002 sta
		   Form.SetSharedData("BDM_ACFD_REG_SRNO"			, "" )	'해외CFD목표시장등록일련번호	
            Form.SetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, "" )	'해외CFD목표시장부적합여부	
		   'v0002 fin
            'G_STEP2_1_FILE 설정정보 -----------------------------------------------
            Form.SetSharedData("BDM_PRCD100"            , ""  )  '종합매매 가입여부
            Form.SetSharedData("BDM_PRCD118RP"          , ""  )  'CMA(증권형) 가입여부
            Form.SetSharedData("BDM_PRCD100F"           , ""  )  '종합매매(금상전용) 가입여부
            Form.SetSharedData("BDM_PRCD101"            , ""  )  '선물옵션 가입여부
            Form.SetSharedData("BDM_PRCD135"            , ""  )  '해외파생 가입여부
            Form.SetSharedData("BDM_PRCD133"            , ""  )  'ISA 가입여부
            Form.SetSharedData("BDM_CtcnChkCFD"        , ""  )   'CFD계좌 주요약관/설명서
            'v0002 
            Form.SetSharedData("BDM_PRCD137"			, ""	)	'해외 CFD 가입여부
            Form.SetSharedData("BDM_ISA_PROD_TYPE"	, ""	)	'ISA type
			'연금저축, 랩 추가 
		   Form.SetSharedData("BDM_PRCD131"			, ""	)	'연금저축 가입여부
            Form.SetSharedData("BDM_WRAP"	, ""	)	'랩 가입여부
        End If
        If strInitGb == "A" Or (strInitGb == "2" Or strInitGb == 2) Then
            'G_STEP2_2_FILE 설정정보 -------------------------------------------
            G_STEP2_2_FILE_Init_Data()	'v0002
	    
            'G_STEP2_2_P2_FILE 설정정보 ----------------------------------------
            Form.SetSharedData("BDM_MndtC"              , ""  )  '(공통)고유식별정보처리
            Form.SetSharedData("BDM_MndtD"              , ""  )  '(상품)조회
            Form.SetSharedData("BDM_MndtE"              , ""  )  '(상품)제공
            Form.SetSharedData("BDM_MndtE1"             , ""  )  '(상품)신용정보조회및집중
            Form.SetSharedData("BDM_MndtE2"             , ""  )  '(상품)해외증권/파생
            Form.SetSharedData("BDM_MndtF"              , ""  )  '(상품)민감정보
            'G_STEP2_2_P3_FILE 설정정보 ----------------------------------------
            Form.SetSharedData("BDM_SlctG"              , ""  )  '(선택)수집이용
            Form.SetSharedData("BDM_SlctH"              , ""  )  '(선택)고유식별정보처리
            Form.SetSharedData("BDM_SlctTel"            , ""  )  '홍보수신_전화
            Form.SetSharedData("BDM_SlctSMS"            , ""  )  '홍보수신_문자
            Form.SetSharedData("BDM_SlctEmail"          , ""  )  '홍보수신_이메일
            Form.SetSharedData("BDM_SlctPost"           , ""  )  '홍보수신_우편
        End If
        If strInitGb == "A" Or (strInitGb == "3" Or strInitGb == 3) Then
            'G_STEP2_3_FILE 설정정보 -------------------------------------------
            Form.SetSharedData("BDM_ACNT_OPNG_CLCD"     , ""  )  '개설구분
        End If
        If strInitGb == "A" Or (strInitGb == "4" Or strInitGb == 4) Then
            'G_STEP2_4_FILE, G_STEP2_5_FILE 설정정보 ---------------------------
            Form.SetSharedData("BDM_MANG_BRCD"          , ""  )  '관리점
            Form.SetSharedData("BDM_DALY_TACT_AMT"      , ""  )  '1일이체한도
            Form.SetSharedData("BDM_ONTR_TACT_AMT"      , ""  )  '1회인체한도
            Form.SetSharedData("BDM_MARG_GRAD_CODE"     , ""  )  '증거금등급
            Form.SetSharedData("BDM_ACNT_PWD"           , ""  )  '계좌비밀번호
            'v0002
            Form.SetSharedData("BDM_ACFD_CTCD"           , ""  )  '해외CFD국가코드
            'v0005
            G_STEP2_4_5_FILE_Init_Data_v0005()
	    
            '투자성향 정보 -----------------------------------------------------
            Form.SetSharedData("BDM_KYC_GRAD"           , ""  )  '투자성향등급
            Form.SetSharedData("BDM_PROD_GRAD"          , ""  )  '상품등급
            Form.SetSharedData("BDM_UNFIT_YN"           , ""  )  '부적합여부
            Form.SetSharedData("BDM_DVPD_KYC_GRAD"      , ""  )  '파생상품투자성향등급
            Form.SetSharedData("BDM_DVPD_PROD_GRAD"     , ""  )  '파생상품상품등급
            Form.SetSharedData("BDM_DVPD_UNFIT_YN"      , ""  )  '파생상품부적합여부
            Form.SetSharedData("BDM_WEAK_FNNC_YN"       , ""  )  '취약금융소비자여부
            Form.SetSharedData("BDM_KYC_INVT_RCMD_CLS_CODE"       , ""  )  'KYC투자권유구분코드
        End If
        If strInitGb == "A" or (strInitGb == "5" or strInitGb == 5) then
		  'G_STEP2_2_P4_FILE 설정정보 ---------------------------------------------------
		   Confirm_CFD_Init_Data()
        End If 
    Else
        '진입점에서 설정되는 정보 ----------------------------------------------
        Form.SetSharedData("BDM_NMETBSWRGB"         , g_BDMNMETBSWRGB              )  '비대면업무구분
        Form.SetSharedData("mOTP_IntoClcd"          , g_mOTP_IntoClcd              )  '(모바일OTP)진입구분코드
        Form.SetSharedData("BDM_CSNO"               , g_BDM_CSNO                   )  '고객번호
        Form.SetSharedData("BDM_REG_UNIQ_NO"        , g_BDM_REG_UNIQ_NO            )  '등록고유번호
        Form.SetSharedData("BDM_RCNO_PIP"           , g_BDM_RCNO_PIP               )  '실명확인번호
        Form.SetSharedData("BDM_HP1"                , g_BDM_HP1                    )  '휴대폰번호
        Form.SetSharedData("BDM_HP2"                , g_BDM_HP2                    )
        Form.SetSharedData("BDM_HP3"                , g_BDM_HP3                    )
        Form.SetSharedData("BDM_CLEAR_YN"           , g_BDM_CLEAR_YN               )  '이어가기여부
        '2단계진입 설정정보 ----------------------------------------------------
        Form.SetSharedData("BDM_ABLE_YN"            , g_BDM_ABLE_YN                )  '개별추가가능여부
        Form.SetSharedData("BDM_OVRL_ACNT_OPNG_YN"  , g_BDM_OVRL_ACNT_OPNG_YN      )  '종합개설가능여부(최근30일내종합신규개설여부) Y.불가 N.가능
        Form.SetSharedData("BDM_DREM_YN"            , g_BDM_DREM_YN                )  'Y.임직원 N.고객
        Form.SetSharedData("BDM_REG_SRNO"			, g_BDM_REG_SRNO			)	'등록일련번호	'ksj 2021-07-23
        Form.SetSharedData("BDM_GOAL_MRKT_UNFIT_YN"	, g_BDM_GOAL_MRKT_UNFIT_YN	)	'목표시장부적합여부	'ksj 2021-07-23
        'v0002 sta
        Form.SetSharedData("BDM_ACFD_REG_SRNO"			, g_BDM_ACFD_REG_SRNO			)	'해외CFD목표시장등록일련번호	
        Form.SetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	)	'해외CFD목표시장부적합여부		
        'v0002 fin
	
        'G_STEP2_1_FILE 설정정보 -----------------------------------------------
        Form.SetSharedData("BDM_PRCD100"            , g_BDM_PRCD100                )  '종합매매 가입여부
        Form.SetSharedData("BDM_PRCD118RP"          , g_BDM_PRCD118RP              )  'CMA(증권형) 가입여부
        Form.SetSharedData("BDM_PRCD100F"           , g_BDM_PRCD100F               )  '종합매매(금상전용) 가입여부
        Form.SetSharedData("BDM_PRCD101"            , g_BDM_PRCD101                )  '선물옵션 가입여부
        Form.SetSharedData("BDM_PRCD135"            , g_BDM_PRCD135                )  '해외파생 가입여부
        Form.SetSharedData("BDM_PRCD133"            , g_BDM_PRCD133                )  'ISA 가입여부
        Form.SetSharedData("BDM_PRCDCFD"            , g_BDM_PRCDCFD                )  'CFD 가입여부
        'v0002 
        Form.SetSharedData("BDM_PRCD137"		, g_BDM_PRCD137				)	'해외 CFD 가입여부
        Form.SetSharedData("BDM_ISA_PROD_TYPE"	, g_BDM_ISA_PROD_TYPE			)	'ISA type
		
		'연금저축, 랩 추가
        Form.SetSharedData("BDM_PRCD131"		, g_BDM_PRCD131				)	'연금저축 가입여부
        Form.SetSharedData("BDM_WRAP"		, g_BDM_WRAP			)			'랩 가입여부
        Form.SetSharedData("BDM_PRCD200"		, g_BDM_PRCD200				)	'다드림 가입여부	
	
	
        'G_STEP2_2_FILE 설정정보 ----------------------------------------
		G_STEP2_2_FILE_Set_Data()  'v0002
		
        'G_STEP2_2_P2_FILE 설정정보 --------------------------------------------
        Form.SetSharedData("BDM_MndtC"              , g_BDM_MndtC                  )  '(공통)고유식별정보처리
        Form.SetSharedData("BDM_MndtD"              , g_BDM_MndtD                  )  '(상품)조회
        Form.SetSharedData("BDM_MndtE"              , g_BDM_MndtE                  )  '(상품)제공
        Form.SetSharedData("BDM_MndtE1"             , g_BDM_MndtE1                 )  '(상품)신용정보조회및집중
        Form.SetSharedData("BDM_MndtE2"             , g_BDM_MndtE2                 )  '(상품)해외증권/파생
        Form.SetSharedData("BDM_MndtF"              , g_BDM_MndtF                  )  '(상품)민감정보
        'G_STEP2_2_P3_FILE 설정정보 --------------------------------------------
        Form.SetSharedData("BDM_SlctG"              , g_BDM_SlctG                  )  '(선택)수집이용
        Form.SetSharedData("BDM_SlctH"              , g_BDM_SlctH                  )  '(선택)고유식별정보처리
        Form.SetSharedData("BDM_SlctTel"            , g_BDM_SlctTel                )  '홍보수신_전화
        Form.SetSharedData("BDM_SlctSMS"            , g_BDM_SlctSMS                )  '홍보수신_문자
        Form.SetSharedData("BDM_SlctEmail"          , g_BDM_SlctEmail              )  '홍보수신_이메일
        Form.SetSharedData("BDM_SlctPost"           , g_BDM_SlctPost               )  '홍보수신_우편
        'G_STEP2_3_FILE 설정정보 -----------------------------------------------
        Form.SetSharedData("BDM_ACNT_OPNG_CLCD"     , g_BDM_ACNT_OPNG_CLCD         )  '개설구분
        'G_STEP2_4_FILE, G_STEP2_5_FILE 설정정보 -------------------------------
        Form.SetSharedData("BDM_MANG_BRCD"          , g_BDM_MANG_BRCD              )  '관리점
        Form.SetSharedData("BDM_DALY_TACT_AMT"      , g_BDM_DALY_TACT_AMT          )  '1일이체한도
