'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    If szTranID = "obaci_acct_185r" Then
        DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 0, g_BDM_RCNO_PIP)
	
    ElseIf szTranID = "obacp_opop_066r" Then
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"     , 0 , Container0.Combo0.cbkeydata )
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Container0.Edit0.caption    )

	ElseIf szTranID = "obaci_acct_049c" Then
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock1", "REG_UNIQ_NO" 		, 0 , g_BDM_REG_UNIQ_NO )	'등록고유번호
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock1", "REG_STAG_CLS_CODE" 	, 0 , "2"               )	'등록단계구분코드 2.계좌정보입력
		
		'G_STEP2_3_FILE 설정정보 ----------------------------------------
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "ACNT_OPNG_CLCD"                 , 0 , g_BDM_ACNT_OPNG_CLCD	)  '계좌개설구분코드
		'G_STEP2_1_FILE 설정정보 ----------------------------------------
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "OVTR_JOIN_APLT_YN"              , 0 , g_BDM_PRCD100       	)  '종합매매가입신청여부
		'G_STEP2_4_FILE, G_STEP2_5_FILE 설정정보 ------------------------
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "MARG_GRAD_CODE"                 , 0 , g_BDM_MARG_GRAD_CODE	)  '증거금등급코드
		'G_STEP2_1_FILE 설정정보 ----------------------------------------
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "DEAL_PRMS_YN"                   , 0 , "Y"					)  '매매허용여부 -약관동의로간주
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "OVTR_FNPR_JOIN_APLT_YN"         , 0 , g_BDM_PRCD100F			)  '종합매매금융상품가입신청여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "CMA_RP_JOIN_APLT_YN"            , 0 , g_BDM_PRCD118RP		)  'CMARP가입신청여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "ISA_ACNT_APLT_YN"               , 0 , g_BDM_PRCD133			)  'ISA계좌신청여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "FUTS_OPTN_ACNT_APLT_YN"         , 0 , g_BDM_PRCD101			)  '선물옵션계좌신청여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "OVDV_ACNT_APLT_YN"              , 0 , g_BDM_PRCD135			)  '해외파생계좌신청여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PNSN_SVNG_ACNT_APLT_YN"         , 0 , g_BDM_PRCD131			)  '연금저축신청여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "WRAP_ACNT_APLT_YN"              , 0 , g_BDM_WRAP				)  '랩신청여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "SAC_ACNT_APLT_YN"               , 0 , g_BDM_PRCD200			)  '다드림신청여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "SAC_MARG_GRAD_CODE"             , 0 , g_BDM_MARG_GRAD_CODE	)  '다드림증거금코드
		'G_STEP2_2_P2_FILE 설정정보 -------------------------------------
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "COMN_UNIQ_INFO_PROS_AGRM_YN"    , 0 , g_BDM_MndtC			)  '공통고유정보처리동의여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PROD_GTHR_UTLZ_CRDT_AGRM_YN"    , 0 , g_BDM_MndtE1			)  '상품수집이용신용동의여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PROD_IQRY_AGRM_YN"              , 0 , g_BDM_MndtD			)  '상품조회동의여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PROD_OFER_AGRM_YN"              , 0 , g_BDM_MndtE			)  '상품제공동의여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PROD_GTHR_UTLZ_OVDV_AGRM_YN"    , 0 , g_BDM_MndtE2			)  '상품수집이용해외파생동의여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PROD_SNTV_INFO_PROS_AGRM_YN"    , 0 , g_BDM_MndtF			)  '상품민감정보처리동의여부
		'G_STEP2_2_P3_FILE 설정정보 -------------------------------------
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "SLCT_GTHR_UTLZ_AGRM_YN"         , 0 , g_BDM_SlctG			)  '선택수집이용동의여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "SLCT_UNIQ_INFO_PROS_AGRM_YN"    , 0 , g_BDM_SlctH			)  '선택고유정보처리동의여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PBLT_TLPH_RCMS_YN"              , 0 , g_BDM_SlctTel			)  '홍보전화수신여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PBLT_SMS_RCMS_YN"               , 0 , g_BDM_SlctSMS			)  '홍보SMS수신여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PBLT_EMAIL_RCMS_YN"             , 0 , g_BDM_SlctEmail		)  '홍보이메일수신여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PRML_RCMS_YN"                   , 0 , g_BDM_SlctPost			)  '홍보물수신여부
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "CNFR_TRGT_CUST_CLCD"            , 0 , "04"					)  '확인대상고객구분코드
		
		'변수한도초과로 인해 에러나서 사용자함수 생성(일부 분리해서 인풋세팅)
		Set_Input_obaci_acct_049c()
	
	'은행연합회 한도금액 조회
	ElseIf szTranID == "obaci_acct_089r" Then
		Set_Input_obaci_acct_089r()
	
	'비대면용 설정가능 계좌조회(CMA)
	ElseIf szTranID == "obaci_nmet_016r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_CLS_CODE"            , 0 , "1"	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"            , 0 , g_BDM_RCNO_PIP	)
	
	'타행수취인조회
	ElseIf szTranID == "obtss_elbs_129r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_BANK_CODE"            , 0 , g_BDM_PNSN_PRVS_BANK_CODE	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "JOB_TRNO"            , 0 , "031"	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_ACNO"            , 0 , Container1.edtAcnt.caption	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TR_AMT"            , 0 , 1	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DRNG_ACNO"            , 0 , "XXXXXXXX"	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PROD_CLS_CODE"            , 0 , ""	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD"            , 0 , ""	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RMRK"            , 0 , ""	)
	
	'비대면계좌개설 이어가기 조회
	ElseIf szTranID == "obaci_acct_072r" Then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"	 	 , 0 , g_BDM_RCNO_PIP      )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE"     , 0 , "2"		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_UNIQ_NO"		 , 0 , g_BDM_REG_UNIQ_NO	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_STAG_CLS_CODE" , 0 , "2"	)
	End If
End Sub

'============================================================================
'DATAMANAGER_OnSendTranBefore에 변수가 너무 많이 들어가 사용자 함수로 생성
