	<SCRIPT_INFO _len="138902" _ulen="119492" >
'--===========================================================================
' 04. 수    정 :
' 2021.10.26 : 김수진 : v0002 : 중개형ISA/해외CFD 상품 추가. obaci_acct_049c 변경IO 적용
' 2021.12.24 : 김수진 : v0003 : 해외CFD 약관 수정, CFD 약관 금융거래 정보제공 동의서 추가 > Shared 값 정리
' 2022.01.24 : 김수진 : v0004 : 국내/해외 CFD 계좌개설시_계좌 유형 선택 추가 
' 2022.02.15 : 김수진 : v0005 : 국내/해외 CFD 계좌개설시_국가/계좌 유형 일괄개설 추가, obaci_acct_049c 변경IO 적용
' 2022.03.16 : 김수진 : v0006 : 관리점 지정 프로세스 개선
' 2022.05.04 : 김수진 : v0007 : 계약서류 제공방식 추가 > obaci_acct_049c 변경IO 적용
' 2022.11.03 : 양현정 : v0008 : 해외CFD-안심계좌 임직원개설제한 해지
'--===========================================================================

Dim  g_Invt_YN		  '투자성향진단여부 
Dim  g_sz_OSType         'OS타입
Dim  g_szTheme           '테마구분  white/black
Dim  szFlag
Dim  g_PwdPass
Dim  g_nDev

'연금저축 화면처리 관련
Dim  g_bPnsnView			'연금저축 가입정보를 보여줄때 true
Dim  g_bTrTimer			'은행연합회 서비스 타이머 플래그
Dim  g_szLnkdTlmsMnno		'은행연합회 서비스 연계전문번호
Dim  g_szOldDate			'지급예정일 변경 전 날짜
Dim  g_nRemainLmt			'연금잔여한도
Dim  g_bAcntVerified		'지급계좌 수취인조회 정상 여부
Dim  g_szBaseDate			'처음 계산한 지급예정날짜
Dim  g_nPnsnCmaCnt		'연금지급 CMA 계좌 갯수

'연금저축 오류문구 스크롤 영역 문제로 인해 추가
'여러번 오류가 날 수 있으므로 boolean으로 작업함
Dim  g_bErrorFlag1		'계약기간 오류문구 여부
Dim  g_bErrorFlag2		'예정일 오류문구 여부
Dim  g_bErrorFlag3		'계약금액 오류문구 여부
Dim  g_nErrorCnt			'오류문구 갯수

'2단계 ==============================================================================================
Dim G_STEP2_1_FILE           '상품선택
Dim G_STEP2_2_FILE           '약관목록
Dim G_STEP2_2_P1_FILE        '약관보기
Dim G_STEP2_2_P2_FILE        '개인(신용)정보처리필수동의
Dim G_STEP2_2_P3_FILE        '개인(신용)정보처리선택동의
Dim G_STEP2_3_FILE           '개설방식선택
Dim G_STEP2_4_FILE           '종합개설
Dim G_STEP2_5_FILE           '개별추가
Dim G_STEP2_6_FILE           '투자성향공통
Dim G_STEP2_2_P4_FILE        'CFD 계약서 등 확인 및 동의
'진입점에서 설정되는 정보 --------------------------------------------------
Dim g_BDM_FRST_MAPID         '최초진입점화면ID
Dim g_BDMNMETBSWRGB          '비대면업무구분 : 100.비대면계좌개설    0xx.비대면업무신청 3xx.모바일OTP발급    999.비대면진행상태조회
Dim g_mOTP_IntoClcd          '(모바일OTP)진입구분코드 NMET_ACNT.계좌개설후처리, NMET_BSWR.업무처리, MTS.MTS
Dim g_BDM_CSNO               '고객번호 :비대면업무신청/모바일OTP발급업무시 1원역이체 화면에서 사용
Dim g_BDM_REG_UNIQ_NO        '등록고유번호
Dim g_BDM_RCNO_PIP           '실명확인번호
Dim g_BDM_HP1                '휴대폰번호
Dim g_BDM_HP2
Dim g_BDM_HP3
Dim g_BDM_CLEAR_YN           '이어가기여부
