Sub Container0_contACFD_chkAllSafe_OnChange(sCheckState)
	If sCheckState == "1" Then
		Container0.contACFD.imgUSASafe.SetStatus("focus")	 
		Container0.contACFD.imgCHNSafe.SetStatus("focus")	 
		Container0.contACFD.imgHKGSafe.SetStatus("focus")	 
		Container0.contACFD.imgJPNSafe.SetStatus("focus")
		g_BDM_OVRS_CFD_ACNT_APLT_YN2 = f_UserChkBold("contACFD", "USASafe", "N")
		g_BDM_OVRS_CFD_ACNT_APLT_YN4 = f_UserChkBold("contACFD", "CHNSafe", "N")
		g_BDM_OVRS_CFD_ACNT_APLT_YN6 = f_UserChkBold("contACFD", "HKGSafe", "N")
		g_BDM_OVRS_CFD_ACNT_APLT_YN8 = f_UserChkBold("contACFD", "JPNSafe", "N")
	Else
		Container0.contACFD.imgUSASafe.SetStatus("normal")
		Container0.contACFD.imgCHNSafe.SetStatus("normal")
		Container0.contACFD.imgHKGSafe.SetStatus("normal")
		Container0.contACFD.imgJPNSafe.SetStatus("normal")
		g_BDM_OVRS_CFD_ACNT_APLT_YN2 = f_UserChkBold("contACFD", "USASafe", "Y")
		g_BDM_OVRS_CFD_ACNT_APLT_YN4 = f_UserChkBold("contACFD", "CHNSafe", "Y")
		g_BDM_OVRS_CFD_ACNT_APLT_YN6 = f_UserChkBold("contACFD", "HKGSafe", "Y")
