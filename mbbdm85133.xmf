Function Set_Input_obaci_acct_089r()
	'obaci_acct_089r 인풋 세팅
	If g_bTrTimer Then
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "BSWR_PROS_CLS_CODE"          , 0 , 	"4"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "PRCD"          , 0 , 	"131"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "RCNO_PIP"          , 0 , 	g_BDM_RCNO_PIP	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "TXCM_PRCD"          , 0 , 	"36"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "CUST_CLS_CODE"          , 0 , 	"1"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "TXCM_TRPR_CLS_CODE"          , 0 , 	"0"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "LNKD_TLMS_MNNO"          , 0 , 	g_szLnkdTlmsMnno	)  
	Else
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "BSWR_PROS_CLS_CODE"          , 0 , 	"3"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "PRCD"          , 0 , 	"131"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "RCNO_PIP"          , 0 , 	g_BDM_RCNO_PIP	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "TXCM_PRCD"          , 0 , 	"36"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "CUST_CLS_CODE"          , 0 , 	"1"	) 
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "TXCM_TRPR_CLS_CODE"          , 0 , 	"0"	)  
		DATAMANAGER.SetDataValue( 0, "obaci_acct_089r", "InBlock1", "LNKD_TLMS_MNNO"          , 0 , 	""	)  
	End If
End Function

'============================================================================
Function Set_Input_obaci_acct_049c()
	'obaci_acct_049c 인풋 세팅
	
	'G_STEP2_4_FILE, G_STEP2_5_FILE 설정정보 ------------------------
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "MANG_BRCD"                      , 0 , g_BDM_MANG_BRCD		)  '관리지점코드
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "DALY_TACT_LIMT_AMT"             , 0 , g_BDM_DALY_TACT_AMT		)  '일일이체한도금액
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "ONTR_TACT_LIMT_AMT"             , 0 , g_BDM_ONTR_TACT_AMT		)  '일회이체한도금액
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "ACNO"                           , 0 , g_BDM_ACNO				)  '계좌번호           -> 개별추가개설시 선택된 종합계좌번호
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "ACNT_PWD"                       , 0 , g_BDM_ACNT_PWD    		)  '계좌비밀번호       -> 선택한 종합계좌의 비밀번호
	
	'투자성향 정보  -------------------------------------------------
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "UI_INVT_INCL_ACMP_YN"           , 0 , g_Invt_YN               )  'UI투자성향수행여부
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "KYC_INVT_INCL_GRAD_CODE"        , 0 , g_BDM_KYC_GRAD          )  'KYC투자성향등급코드
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "KYC_PROD_GRAD_CODE"             , 0 , g_BDM_PROD_GRAD         )  'KYC상품등급코드
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "UNFIT_YN"                       , 0 , g_BDM_UNFIT_YN          )  '부적합여부
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "FTOT_INVT_INCL_GRAD_CODE"       , 0 , g_BDM_DVPD_KYC_GRAD     )  '선물옵션투자성향등급코드
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "FTOT_PROD_GRAD_CODE"            , 0 , g_BDM_DVPD_PROD_GRAD    )  '선물옵션상품등급코드
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "FTOT_UNFIT_YN"                  , 0 , g_BDM_DVPD_UNFIT_YN     )  '선물옵션부적합여부
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "WEAK_FNNC_SMAL_VISA_YN"         , 0 , g_BDM_WEAK_FNNC_YN      )  '취약금융소비자여부
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "KYC_INVT_RCMD_CLS_CODE"         , 0 , g_BDM_KYC_INVT_RCMD_CLS_CODE      )  'KYC투자권유구분코드
	'G_STEP2_1_FILE 설정정보 ----------------------------------------	
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "DMST_CFD_ACNT_APLT_YN"          , 0 , g_BDM_PRCDCFD			)  'CFD계좌신청여부
	'2021-07-23 ksj
	'CFD상품개설이 아닌경우, 0 CFD상품개설인 경우 obaci_acct_266a.OutBlock1.REG_SRNO
	'CFD상품개설이 아닌경우, NULL CFD상품개설인 경우 obaci_acct_266a.OutBlock1 BDM_GOAL_MRKT_UNFIT_YN
	'g_BDM_GOAL_MRKT_UNFIT_YN (Y.목표시장부적합 N.정상)
	If g_BDM_PRCDCFD == "Y" Then
		Dim szDMST_CFD_GOAL_MRKT_AGR_YN
		szDMST_CFD_GOAL_MRKT_AGR_YN = ""
		If g_BDM_GOAL_MRKT_UNFIT_YN == "Y" Then
			szDMST_CFD_GOAL_MRKT_AGR_YN = "N"
		ElseIf g_BDM_GOAL_MRKT_UNFIT_YN == "N" Then
			szDMST_CFD_GOAL_MRKT_AGR_YN = "Y"
		End If
		
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "UI_SRNO"					, 0 , g_BDM_REG_SRNO     			)  '국내CFD목표시장일련번호
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "DMST_CFD_GOAL_MRKT_AGR_YN"	, 0 , szDMST_CFD_GOAL_MRKT_AGR_YN	)  '국내CFD목표시장일치여부
	Else
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "UI_SRNO"         			, 0 , 0							)  '국내CFD목표시장일련번호
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "DMST_CFD_GOAL_MRKT_AGR_YN"	, 0 , ""							)  '국내CFD목표시장일치여부
	End If
	'v0002 sta
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "ISA_PROD_TYPE_CLCD"				, 0 , g_BDM_ISA_PROD_TYPE			)  'ISA상품유형구분코드(2:일임형 / 3:중개형)
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "ISA_JOIN_TPCD"					, 0 , "66"						)  'ISA가입유형코드
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "ISA_ACNT_OPNG_CLCD"				, 0 , g_BDM_ISA_ACNT_OPNG_CLCD		)  'ISA계좌개설구분코드(1:신규 / 2:이수)
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "OVRS_CFD_ACNT_APLT_YN"			, 0 , g_BDM_PRCD137				)  '해외CFD계좌신청여부
	'G_STEP2_4_FILE, G_STEP2_5_FILE 설정정보 -----------------------------------
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "ACFD_CTCD"						, 0 , g_BDM_ACFD_CTCD    			)  '해외CFD국가코드
	'G_STEP2_1_FILE 설정정보 ----------------------------------------		
	'g_BDM_ACFD_GOAL_MRKT_UNFIT_YN (Y.목표시장부적합 N.정상)
	If g_BDM_PRCD137 == "Y" Then
		Dim szOVRS_CFD_GOAL_MRKT_AGR_YN	
		szOVRS_CFD_GOAL_MRKT_AGR_YN = ""
		If g_BDM_ACFD_GOAL_MRKT_UNFIT_YN == "Y" Then
			szOVRS_CFD_GOAL_MRKT_AGR_YN = "N"
		ElseIf g_BDM_ACFD_GOAL_MRKT_UNFIT_YN == "N" Then
			szOVRS_CFD_GOAL_MRKT_AGR_YN = "Y"
		End If
		
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "ACFD_GOAL_MRKT_SRNO"         , 0 , g_BDM_ACFD_REG_SRNO     		) '해외CFD목표시장일련번호
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "ACFD_GOAL_MRKT_AGR_YN"       , 0 , szOVRS_CFD_GOAL_MRKT_AGR_YN     ) '해외CFD목표시장일치여부
	Else
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "ACFD_GOAL_MRKT_SRNO"         , 0 , 0     )  '해외CFD목표시장일련번호
		DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "ACFD_GOAL_MRKT_AGR_YN"       , 0 , ""    ) 	'해외CFD목표시장일치여부
	End If
	'v0002 fin
	'v0005 sta
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "DMST_CFD_ACNT_APLT_YN1"          , 0 , g_BDM_DMST_CFD_ACNT_APLT_YN1		)  '국내CFD 계좌신청여부(일반)
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "DMST_CFD_ACNT_APLT_YN2"          , 0 , g_BDM_DMST_CFD_ACNT_APLT_YN2		)  '국내CFD 계좌신청여부(안심)
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "OVRS_CFD_ACNT_APLT_YN1"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN1		)  '해외CFD 계좌신청여부(미국/일반)
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "OVRS_CFD_ACNT_APLT_YN2"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN2		)  '해외CFD 계좌신청여부(미국/안심)
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "OVRS_CFD_ACNT_APLT_YN3"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN3		)  '해외CFD 계좌신청여부(중국/일반)
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "OVRS_CFD_ACNT_APLT_YN4"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN4		)  '해외CFD 계좌신청여부(중국/일반)
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "OVRS_CFD_ACNT_APLT_YN5"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN5		)  '해외CFD 계좌신청여부(홍콩/일반)
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "OVRS_CFD_ACNT_APLT_YN6"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN6		)  '해외CFD 계좌신청여부(홍콩/일반)
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "OVRS_CFD_ACNT_APLT_YN7"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN7		)  '해외CFD 계좌신청여부(일본/일반)
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "OVRS_CFD_ACNT_APLT_YN8"          , 0 , g_BDM_OVRS_CFD_ACNT_APLT_YN8		)  '해외CFD 계좌신청여부(일본/일반)
	'v0005 fin
	
	'2_4 연금저축 관련 추가
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PNSN_TCTR_CLS_CODE"                        , 0 , g_BDM_PNSN_TCTR_CLS_CODE		)			'연금이관구분코드(신규/이수전용)
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PNSN_CNRC_PRD"             		        , 0 , g_BDM_PNSN_CNRC_PRD		)                 '연금계약기간
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PNSN_PRVS_BEGN_SCDL_DATE"                  , 0 , g_BDM_PNSN_PRVS_BEGN_SCDL_DATE		)    	'연금지급개시예정일
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PNSN_CNRC_AMT"                             , 0 , g_BDM_PNSN_CNRC_AMT				)        '연금계약금액
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PNSN_PRVS_BANK_CODE"                       , 0 , g_BDM_PNSN_PRVS_BANK_CODE    		)    	'연금지급은행코드
	DATAMANAGER.SetDataValue( 0, "obaci_acct_049c", "InBlock4", "PNSN_PRVS_BANK_ACNO"                       , 0 , g_BDM_PNSN_PRVS_BANK_ACNO    		)    	'연금지급은행계좌번호
End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'오류메시지 설정
    strSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    If Trim(strSubMsg) ~= null Or Trim(strSubMsg) ~= "" Then
        strMsg = szErrMsg.."("..Trim(strSubMsg)..")"
    Else
        strMsg = szErrMsg
    End If
    
	If szTranID == "obaci_acct_089r" Then
		'은행연합회 한도조회 오류
	    Container1.edtAmount.hintcaption = "잔여한도 0원"
	    
	    Form.OpenPopup("mbbdm85132_p3", "", "")
	    
	    Form.ShowAlert("오류", strMsg )
	    
	ElseIf szTranID == "obtss_elbs_129r" Then
	    g_bAcntVerified = false
	    
	    g_BDM_PNSN_PRVS_BANK_ACNO = ""
		Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , g_BDM_PNSN_PRVS_BANK_ACNO)
		
		Form.ShowAlert("오류", strMsg )
		
	Else
		Form.ShowAlert("오류", strMsg )
	End If
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    If szTranID = "obaci_acct_185r" Then
        If DATAMANAGER.IsMoreNextData("obaci_acct_185r") = true Then
            DATAMANAGER.RequestNextData("obaci_acct_185r")
            exit sub
        End If

        '선택가능한 종합계좌 설정
        nCnt = DATAMANAGER.GetDataCount(0, "obaci_acct_185r" , "OutBlock1")
        If nCnt > 0 Then
            USER_Acno_Set()
        Else
	       Container0.Combo0.caption = "선택가능한 종합계좌가 없습니다."
        End If

    ElseIf szTranID = "obacp_opop_066r" Then
        g_PwdPass = "Y"

        g_BDM_ACNT_PWD = Container0.Edit0.caption
        Form.SetSharedData("BDM_ACNT_PWD" , g_BDM_ACNT_PWD)

        '계좌 비밀번호 검증완료후, 계좌의 관리점 자동설정
        Container0.Combo1.visible = true
        'v0006 관리점 변경 선택 컨트롤 visible
        Container0.lblMangChg.visible = true
        Container0.chkMangChg.visible = true	
		
        For i = 0 To Grid0.rowcount -1
            strAcno = Grid0.GetCellData("bd_cell1", i )
            If CInt(Trim(g_BDM_ACNO)) == CInt(Trim(strAcno)) Then
                strDpcd = Grid0.GetCellData("bd_cell2", i)
                strDpNm = Grid0.GetCellData("bd_cell3", i)
                If Len(strDpcd) > 0 Then
                    '현재등록된정보 지우고 선택한계좌의 관리점으로 표시(cbinputdatatext)
                    Form.SetCtlProp("Container0.Combo1","cbinputdatatext", Trim(strDpcd).."`"..Trim(strDpNm))
                    exit for
                End If
            End If
        Next
		'관리점 자동선택
		Container0.Combo1.caption = "관리점을 선택해주세요"
		'Container0.Combo1.cbkeydata = strDpcd
		Container0.Combo1.currentindex = 0  '   .cbkeydata = strDpcd

		'종합 매매개설/ 국내,해외CFD 동시 개설일때도 일단 종합 매매 개설부터
		If g_BDM_PRCD100 == "Y" Or g_BDM_PRCD200 == "Y" Then	'종합매매개설인 경우,
			Container0.Combo2.visible = true
	
			'증거금등급 리스트 자동오픈
			If Trim(g_BDM_MARG_GRAD_CODE) == "" Or Trim(g_BDM_MARG_GRAD_CODE) == null Then
				Form.SetTimerEvent2("8888", 1, 0.8)
				Container0.Combo2.Setstatus("focus")
			End If
		Else
			'v0004 sta 국내CFD 개설 (종합매매개설 아닌경우)
			'해외CFD 국내CFD 동시 개설일때도 국내CFD 개설부터
			If g_BDM_PRCDCFD == "Y" and g_BDM_PRCD137 == "Y" Then '국내 CFD 개설인 경우	
				'v0005 sta	v0006 값변경
				Container0.contCFD.top = 292		'Container0.Combo2.top
				Container0.contACFD.top = 412
				Container0.contCFD.visible = true
				Container0.contACFD.visible = true
				'v0005 fin
			Else
				If g_BDM_PRCDCFD == "Y" Then '국내 CFD 개설인 경우	
					'v0005 sta	v0006 값변경
					Container0.contCFD.top = 292		'Container0.Combo2.top
					Container0.contCFD.visible = true
					'v0005 fin
				ElseIf g_BDM_PRCD137 == "Y" Then '해외 CFD 개설인 경우	
					'v0005 sta	v0006 값변경
					Container0.contACFD.top = 292		'Container0.Combo2.top
					Container0.contACFD.visible = true
					'v0005 fin
				End If
			End If
		End If
		
		'v0006 스크롤 설정 변경
		'v0005 스크롤 설정 변경
		'스크롤 설정 ---------------------------------
		nTop        = 0
		nContResize = 0		
		If g_BDM_PRCD137 == "Y" Then
			nContResize = CInt(Form.calcUnResize(Container0.Label0.top, "1")) + CInt(Form.calcUnResize(Container0.Combo1.top, "1")) + CInt(Form.calcUnResize(Container0.Combo1.top, "1"))
			if g_BDM_PRCD100 == "Y" Or g_BDM_PRCD200 == "Y" Then
				nContResize = nContResize + CInt(Form.calcUnResize(Container0.Edit0.top, "1"))
			End If
			if g_BDM_PRCDCFD == "Y" Then
				nContResize = nContResize + CInt(Form.calcUnResize(Container0.Edit0.top, "1"))
			End If
			nTop        = Cint(Form.calcUnResize(Container0.Combo1.top, "1"))	
			Container0.Label0.top = nContResize
		Else
			If (g_BDM_PRCD100 == "Y" Or g_BDM_PRCD200 == "Y") and g_BDM_PRCDCFD == "Y" Then
				nContResize = CInt(Form.calcUnResize(Container0.Label0.top, "1")) + CInt(Form.calcUnResize(Container0.Edit0.top, "1"))
			End If
			Container0.Label0.top = nContResize
		End If
		Container0.SetScrollAutoSize()  
		Container0.scroll_pos = nTop	
		
    ElseIf szTranID = "obaci_acct_049c" Then
        szFlag = "NEXT"
        NextStep()

	'은행연합회 한도금액 조회
	ElseIf szTranID == "obaci_acct_089r" Then
		If g_bTrTimer Then
			Dim szProsClsCode
			szProsClsCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_CLS_CODE", 0)			'처리구분코드
			'최초 조회 후에 PROS_CLS_CODE 가 "2"로 나올때까지 타이머 이용하여 재호출
			If szProsClsCode == "2" Then
				Dim szUI_SVNG_LIMT_UNSD_AMT, szJOIN_LIMT_AMT
				szUI_SVNG_LIMT_UNSD_AMT = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_SVNG_LIMT_UNSD_AMT", 0)
				szJOIN_LIMT_AMT = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "JOIN_LIMT_AMT", 0)
				
				g_nRemainLmt = CInt(szUI_SVNG_LIMT_UNSD_AMT)
				
				'연금저축 잔여한도 없을 시 안내창 노출
'				If CInt(szUI_SVNG_LIMT_UNSD_AMT) <= 0 Then
'					Form.OpenPopup("mbbdm85132_p3", "", "")
'					Exit Sub
'				Else
					Container1.edtAmount.hintcaption = "잔여한도 " .. FormatNumber(szUI_SVNG_LIMT_UNSD_AMT, 0) .. "원"
'				End If
				
				'비대면용 설정가능계좌 조회(CMA)
				DATAMANAGER.RequestTranData( "obaci_nmet_016r" )
			Else
				Form.SetTimerEvent2("5555", 1, 1.5)
			End If
		Else
			g_szLnkdTlmsMnno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "LNKD_TLMS_MNNO", 0)		'연계전문번호
			g_bTrTimer = true
			
			DATAMANAGER.RequestTranData( szTranID )
		End If
	
	'비대면용 설정가능 계좌조회(CMA)
	ElseIf szTranID == "obaci_nmet_016r" Then
		If DATAMANAGER.IsMoreNextData(szTranID) Then
			DATAMANAGER.RequestNextData( szTranID )
			Exit Sub
		End If
		
		Dim nCnt
		nCnt = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "IQRY_CSNU", 0))
		
		g_nPnsnCmaCnt = nCnt
		
		Dim szAcno, szAsno, szPrcd
		'당사 CMA 계좌 보유시 기본세팅 메리츠증권
		If nCnt > 0 Then
'			cmbCMA.clear = "1"
			
			'연금지급기관
			g_BDM_PNSN_PRVS_BANK_CODE = "287"		'초기선택 메리츠
			Form.SetSharedData("BDM_PNSN_PRVS_BANK_CODE"           , g_BDM_PNSN_PRVS_BANK_CODE)
			
			Container1.edtBank.caption = "메리츠증권"
			Container1.edtBank.fgcolor = "4"
			
			For i = 0 to nCnt - 1
				szAcno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ACNO", i) 
				szAsno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ASNO", i) 
				szPrcd = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PRCD", i) 
				' "118":CMA 만 콤보에 추가
				If szPrcd == "118" Then
					cmbCMA.cbadddatatext = szAcno & szAsno & "`" & "[CMA]" & Left(szAcno, 4) & "-" & Right(szAcno, 4) & "-" & szAsno
				End If
			Next
			
'			cmbCMA.caption = ""
			
'			cmbCMA.openList()
		Else
			'연금지급기관
			g_BDM_PNSN_PRVS_BANK_CODE = ""		'초기선택 없음
			Form.SetSharedData("BDM_PNSN_PRVS_BANK_CODE"           , g_BDM_PNSN_PRVS_BANK_CODE)
			
'			'CMA 계좌 없을시 메시지 띄워주고 타사기관 선택 팝업 오픈
'			Form.MsgBox("안내", "당사 보유중인 CMA계좌가 없습니다.", "NO_CMA_ACNT", 6)
		End If
	
	'타행수취인조회
	ElseIf szTranID == "obtss_elbs_129r" Then
		'입력한 계좌 수취인명
		Dim szName, szStartName
		szName = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ACNM", 0) 
		
		'앞단계에서 입력받은 고객명
		szStartName = Form.GetSharedData("BDM_NAME", false)
		
		If szName <> szStartName Then
			g_BDM_PNSN_PRVS_BANK_ACNO = ""
			Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , g_BDM_PNSN_PRVS_BANK_ACNO)
			
			Form.ShowAlert("안내", "수취인이 일치하지 않습니다.")
			g_bAcntVerified = false
		Else
			Form.ShowAlert("안내", "계좌 수취인 확인 완료.")
			g_bAcntVerified = true
		End If
		
		NextBtn_Enable()
	
	'비대면계좌개설 이어가기 조회
	ElseIf szTranID == "obaci_acct_072r" Then
		'실명확인번호 가져와서 날짜 계산
		Dim szRcno
		szRcno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock5", "RCNO", 0) 
'		If szRcno <> "" and szRcno <> null Then
			'연금지급개시 예정일자 세팅
			'1.신청일자 기준 5년후
			Dim szDateOne
			Calendar0.caption = Form.GetSharedData("&HOST_DATE", false)
			szDateOne = Replace(DateAdd("m", 60, Calendar0.calyear & "-" & Calendar0.calmonth & "-" & Calendar0.calday), "-", "")
			
			'2.만 55세 생일 중 늦은 날짜로 세팅
			Dim szFront, szRear, szDateTwo, szYear
			szFront = Left(szRcno, 6)
			szRear = Right(szRcno, 1)
			
			'주민번호의 7번째 자리가 3, 4, 7, 8 중 하나이면 20 + YYMMDD
			'그 외 19 + YYMMDD
			'생년월일 구한 후 55년 더하기
			If szRear == "3" or szRear == "4" or szRear == "7" or szRear == "8" Then
				szDateTwo = "20" & szFront
			Else
				szDateTwo = "19" & szFront
			End If
			szYear = CInt(Left(szDateTwo, 4)) + 55		'55년후 계산
			szDateTwo = szYear & Right(szDateTwo, 4)		'계산된 년도 + 월 일
			
			'계산한 2가지 날짜중 더 늦는 날짜를 세팅
			If CInt(szDateOne) > CInt(szDateTwo) Then
				Calendar0.caption = szDateOne
'				Container1.edtStartDate.caption = szDateOne
			Else
				Calendar0.caption = szDateTwo
'				Container1.edtStartDate.caption = szDateTwo
			End If
			
			g_szBaseDate = Calendar0.caption
			
			g_BDM_PNSN_PRVS_BEGN_SCDL_DATE = Calendar0.caption
			Form.SetSharedData("BDM_PNSN_PRVS_BEGN_SCDL_DATE"    , g_BDM_PNSN_PRVS_BEGN_SCDL_DATE)	
			
			Container1.edtStartDate.caption = Left(Calendar0.caption, 4) & "년 " & Mid(Calendar0.caption, 5, 2) & "월 " & Right(Calendar0.caption, 2) & "일"
'		End If
	End If
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
    '종합계좌콤보 포커싱 및 자동펼치기
    If sTimerID == "9999" Or sTimerID == 9999 Then
        Form.SetTimerEvent2(sTimerID, 0, 0.8)

        If CInt(Container0.Combo0.currentindex) < 1 Then
            Container0.Combo0.openList()
        End If

	'증거금등급 포커싱 및 자동펼치기
	ElseIf sTimerID == "8888" Or sTimerID == 8888 Then
        Form.SetTimerEvent2(sTimerID, 0, 0.8)

        'If CInt(Container0.Combo2.currentindex) < 1 Then
	   If Trim(g_BDM_MARG_GRAD_CODE) == "" Or Trim(g_BDM_MARG_GRAD_CODE) == null Then
            Container0.Combo2.openList()
        End If
	
	'은행연합회 한도조회 타이머
	ElseIf sTimerID == "5555" Or sTimerID == 5555 Then
		Form.SetTimerEvent2(sTimerID, 0, 1.5)
		
		'재조회
		DATAMANAGER.RequestTranData("obaci_acct_089r")
    End If
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()  '안드로이드전용
    ImgBackPress_OnClick()
End Sub
'============================================================================
Sub ImgBackPress_OnClick()
	If g_bPnsnView Then
		Container0.visible = true
		Container1.visible = false
		
		g_bPnsnView = false
		
		NextBtn_Enable()
	Else
		szFlag = "BACK"		
		NextStep()
	End If
End Sub


'============================================================================
Sub Button0_OnClick()
    If Chk_Data() == True Then
	    '연금저축 개설시 연금저축 정보입력 띄워줌
		If g_BDM_PRCD131 == "Y" Then
			If g_bPnsnView == false Then
				Container0.visible = false
				
				Container1.visible = true
				
				g_bPnsnView = true
				NextBtn_Enable()
			Else
				'test
'				g_BDM_PNSN_TCTR_CLS_CODE = "1"
'				g_BDM_PNSN_CNRC_PRD = "60"
'				g_BDM_PNSN_PRVS_BEGN_SCDL_DATE = "22600601"
'				g_BDM_PNSN_CNRC_AMT = "10000000"
'				g_BDM_PNSN_PRVS_BANK_CODE = "004"
'				g_BDM_PNSN_PRVS_BANK_ACNO = "02800104267338"
'				
'				Form.SetSharedData("BDM_PNSN_TCTR_CLS_CODE"          , g_BDM_PNSN_TCTR_CLS_CODE)	
'				Form.SetSharedData("BDM_PNSN_CNRC_PRD"           	, g_BDM_PNSN_CNRC_PRD)	
'				Form.SetSharedData("BDM_PNSN_PRVS_BEGN_SCDL_DATE"    , g_BDM_PNSN_PRVS_BEGN_SCDL_DATE)	
'				Form.SetSharedData("BDM_PNSN_CNRC_AMT"           	, g_BDM_PNSN_CNRC_AMT)	
'				Form.SetSharedData("BDM_PNSN_PRVS_BANK_CODE"           , g_BDM_PNSN_PRVS_BANK_CODE)
'				Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , g_BDM_PNSN_PRVS_BANK_ACNO)
				
				'공유변수 설정
				User_SharedData_Set("")
				
				g_Invt_YN = "N"  '투자성향진단전
				'Form.OpenNextPopup(G_STEP2_6_FILE, "", "")
				Form.OpenPopup(G_STEP2_6_FILE, "", "")  '투자성향은 부모창close없이 진행->투자성향처리결과 받고 후속업무 처리
			End If
		Else
			'공유변수 설정
			User_SharedData_Set("")
			
			g_Invt_YN = "N"  '투자성향진단전
			'Form.OpenNextPopup(G_STEP2_6_FILE, "", "")
			Form.OpenPopup(G_STEP2_6_FILE, "", "")  '투자성향은 부모창close없이 진행->투자성향처리결과 받고 후속업무 처리
		End If
    End If
End Sub


'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

    '투자성향진단 미완료 
    If sKeyName == "Invt_Error" Then
        If sRet == "ok" Then  '예.ok / 아니오.no
            User_Invt_Proc()

            g_Invt_YN = "Y"  '투자성향진단완료
		   DATAMANAGER.RequestTranData("obaci_acct_049c")
	    End If

    ElseIf sKeyName == "ReTryPrcd" Then
        If sRet == "ok" Then  'ok.예 no.아니오
            szFlag = sKeyName
            NextStep()
        Else
            Container0.Combo0.caption = "종합계좌를 선택해주세요."
            g_BDM_ACNO = ""
            Form.SetSharedData("BDM_ACNO" , g_BDM_ACNO)
        End If

	'연금저축 케이스) 보유중인 CMA 계좌 없을시 기관선택 팝업 띄워줌
    ElseIf sKeyName == "NO_CMA_ACNT" Then
	    Form.OpenPopupAnimation("mbbdm85170_p1" , "pass"  ,"","2")
		Container1.edtAcnt.caption = ""
		Container1.Label3.visible = true
    End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

    '투자성향진단
    'If sKeyName == G_STEP2_6_FILE Then
    If sKeyName == "MBBDM85140" Then
        If sRet == "ok" Then
            'Form.ShowAlert("투자성향진단완료", sRet)
		   User_Invt_Proc()
		   DATAMANAGER.RequestTranData("obaci_acct_049c")
        Else
            '투자성향진단 비정상종료와 부적합(적정성보고서) 비정상종료 분리
            If sRet == "unfit_fail" Then
                Form.ShowAlert("알림", "[투자성향 대비 고위험거래 가입확인],\n[투자성상품 적정성 판단 보고서확인] 이\n올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행해주세요.")
                Exit Sub
            '투자권유 희망 확인서 미처리에 따른 진행불가 알럿	
            ElseIf sRet == "hopeRecInv_fail" Then
                Form.ShowAlert("알림", "[투자권유 희망 여부 확인],\n[투자권유 희망 여부 확인서 확인] 이\n올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행해주세요.")
                Exit Sub	
            Else
                'TEST용 SKIP 종료
                'Form.MsgBox("알림", "투자성향 진단이 올바르게 처리되지 않았습니다.\n계속 진행하시겠습니까?", "Invt_Error", "2")  '2.예/아니오
                Form.ShowAlert("알림", "투자성향 진단이 올바르게 처리되지 않아 다음 단계 진행이 불가합니다.\n\n다시 진행해주세요.")
                Exit Sub	    
            End If
        End If
    End If
    
    'v0006 관리점변경 단기다수 개설불가 안내(mbbdm85133_p1화면)
    If sKeyName == "85133_P1_BNK_MNY_MSG" Then
	    If sRet == "no" Then
		    '다음에 개설하기 : Home으로 이동
		    szFlag = "HOME" 
		    NextStep()    
	    Else
		    '현재 화면 유지
		    Container0.chkMangChg.chksilence = "0" 	
	    End If
    End If
    
    'v0006 관리점변경 원할시 신규종합계좌개설로 가능 안내(mbbdm85133_p1화면)
    If sKeyName == "85133_P1_MANG_CHG_MSG" Then
	    If sRet == "yes" Then
		    '신규 종합계좌 개설하여 진행하기 > 일임형 ISA 개설시 에외처리
		    If g_BDM_PRCD133 == "Y" and g_BDM_ISA_PROD_TYPE == "2" Then    
			    If g_BDM_PRCD100 <> "Y" and g_BDM_PRCD118RP <> "Y" Then	'v0006 CMA계좌 보유시에도 개설 가능하도록 변경
				    Dim szData
				    'szData : KeyName★타이틀명★버튼 개수★버튼넓이(Left)★버튼명(Left)★버튼명(Right)★안내문 정렬(0(왼),1(중),2(오))★총 안내문 수★안내문 줄 수★imgdot 사용여부★안내내용
				    
					szData = "85133_P1_ISA_TYPE2_MSG".."★".."안내".."★"..
							"2".."★".."".."★".."기존계좌에\n개설하기".."★".."예".."★"..
							"0".."★".."2".."★"..
							"3".."★".."false".."★".."일임형ISA 개설시 현물, 현금해지, 입금을 위한 별도 계좌 (종합매매 또는 CMA)를 개설해야 합니다.".."★"..
							"1".."★".."false".."★".."개설상품 선택화면으로 이동하시겠습니까?"
					Form.OpenPopup("mbbdm85133_p1", szData, "")	
				Else
					': 신규종합계좌 개설로 이동
					szFlag = "CHANGE"
					NextStep() 
				End If
		    Else
		    		': 신규종합계좌 개설로 이동
				szFlag = "CHANGE"
				NextStep()   
		    End If
	    Else		 
			'확인 : 현재 화면 유지
		    Container0.chkMangChg.chksilence = "0"
	    End If
    End If
    
    'v0006 관리점변경 원하지만 일임형 ISA 개설시 예외처리 안내(mbbdm85133_p1화면)
    If sKeyName == "85133_P1_ISA_TYPE2_MSG" Then
 	    If sRet == "yes" Then
		    '예 : 개설상품선택 화면으로 이동
		    szFlag = "ReTryPrcd" 
		    NextStep()  	    
	    Else
		    '기존계좌에 개설하기 : 현재 화면 유지
		    Container0.chkMangChg.chksilence = "0"   	    
	    End If   
    End If
    
    '연금지급 기관선택 팝업 리턴
    If sKeyName == "mbbdm85170_p1" Then
	    If sRet <> "" & sRet <> null Then
			'[0]:기관명, [1]:기관코드
			Dim tData
			tData = Split(sRet, "★")
			Container1.edtBank.caption = tData[0]
			Container1.edtBank.fgcolor = "4"
			g_BDM_PNSN_PRVS_BANK_CODE = tData[1]
			g_BDM_PNSN_PRVS_BANK_ACNO = ""
			Form.SetSharedData("BDM_PNSN_PRVS_BANK_CODE"           , g_BDM_PNSN_PRVS_BANK_CODE)
			Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , g_BDM_PNSN_PRVS_BANK_ACNO)
			
			Container1.Label3.visible = false
			
			If tData[1] == "287" Then		'메리츠
				Container1.btnShowAcntList.visible = true
				Container1.btnShowAcntList.bringFront("1")
			Else							'그 외 타사
				Container1.btnShowAcntList.visible = false
			End If
	    End If
    End If
    
    '연금저축 잔여한도 0원 팝업 리턴
    If sKeyName == "mbbdm85132_p3" Then
	    If sRet == "Quit" Then
			'비대면 정보들 초기화 시키고 안내화면으로 돌아감
			User_SharedData_Set("")
			User_SharedData_Set("init1")  '상품선택
			User_SharedData_Set("init2")  '약관정보
			User_SharedData_Set("init3")  '개설구분
			User_SharedData_Set("init4")  '계좌정보
		    
			Form.OpenNextPopup("mbbdm85100", "", "")
		Else
			'화면에 잔류할시 연금저축 영역 초기화
			Container1.edtPeriod.visible = false
			Container1.edtStartDate.visible = false
			Container1.edtAmount.visible = false
			Container1.imgAcntBg.visible = false
			Container1.lblAcntTitle.visible = false
			Container1.edtBank.visible = false
			Container1.imgBankSearch.visible = false
			Container1.edtAcnt.visible = false
			Container1.btnCalendar.visible = false
			Container1.chkSkip.visible = false
			Container1.Label3.visible = false
			
			Container1.rdoType.currentindex = "-1"
			
			'입력값 및 에러문구 초기화
			Container1.edtAmount.SetResultLabel("0","complete","","Container1")
			Container1.edtPeriod.SetResultLabel("0","complete","","Container1")
			Container1.edtStartDate.SetResultLabel("0","complete","","Container1")
			
			g_BDM_PNSN_CNRC_AMT = ""
			Container1.edtAmount.caption = g_BDM_PNSN_CNRC_AMT
			Form.SetSharedData("BDM_PNSN_CNRC_AMT", g_BDM_PNSN_CNRC_AMT)
			
			Container1.edtPeriod.caption = ""
			Form.SetSharedData("BDM_PNSN_CNRC_PRD", "")
			
			Calendar0.caption = g_szBaseDate
			Form.SetSharedData("BDM_PNSN_PRVS_BEGN_SCDL_DATE"    , g_szBaseDate)	
			Container1.edtStartDate.caption = Left(Calendar0.caption, 4) & "년 " & Mid(Calendar0.caption, 5, 2) & "월 " & Right(Calendar0.caption, 2) & "일"
			
			g_BDM_PNSN_PRVS_BANK_CODE = "287"		'초기선택 메리츠
			g_BDM_PNSN_PRVS_BANK_ACNO = ""			'지급계좌번호
			Form.SetSharedData("BDM_PNSN_PRVS_BANK_CODE"           , g_BDM_PNSN_PRVS_BANK_CODE)
			Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , g_BDM_PNSN_PRVS_BANK_ACNO)
			
			Form.SetSharedData("BDM_PNSN_TCTR_CLS_CODE", "")
		End If
    End If
End Sub

