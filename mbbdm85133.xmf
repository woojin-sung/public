'============================================================================
Function USER_Acno_Set()
    nCnt = 0
    For i = 0 To Grid0.rowcount -1
        strExstYN = Grid0.GetCellData("bd_cell0", i ) '종합계좌존재여부
        strAcno   = Grid0.GetCellData("bd_cell1", i ) '계좌번호

        'If strExstYN == "Y" And Len( Trim(strAcno)) == 8 Then
        If Len( Trim(strAcno)) == 8 Then
            Form.SetCtlProp("Container0.Combo0", "cbadddatatext", strAcno.."`"..Left(strAcno, 4).."-"..Mid(strAcno, 5, 4) )
            nCnt = CInt(nCnt) + 1
        End If
     Next

	If CInt(nCnt) > 0 Then
	    '초기선택없음
	    Container0.Combo0.caption = "종합계좌를 선택해주세요"
	    
        '기입력정보 존재시
	   '재선택 유도
        'If g_BDM_ACNO ~= "" Or g_BDM_ACNO ~= null Then
        '    Container0.Combo0.cbkeydata = g_BDM_ACNO	
        '    Container0.Combo1.cbinputdatatext = g_BDM_MANG_BRCD
        'End If
	
        '종합계좌콤보 리스트 자동오픈
        Form.SetTimerEvent2("9999", 1, 0.8)
	   Container0.Combo0.Setstatus("focus")
	Else 
         Container0.Combo0.caption = "선택가능한 종합계좌가 없습니다"
         Button0.enable = false
	End If
End Function
'============================================================================
Function User_Invt_Proc()

    g_BDM_KYC_GRAD           = Form.GetSharedData("BDM_KYC_GRAD"           , false)  '투자성향등급
    g_BDM_PROD_GRAD          = Form.GetSharedData("BDM_PROD_GRAD"          , false)  '상품등급
    g_BDM_UNFIT_YN           = Form.GetSharedData("BDM_UNFIT_YN"           , false)  '부적합여부
    g_BDM_DVPD_KYC_GRAD      = Form.GetSharedData("BDM_DVPD_KYC_GRAD"      , false)  '파생상품투자성향등급
    g_BDM_DVPD_PROD_GRAD     = Form.GetSharedData("BDM_DVPD_PROD_GRAD"     , false)  '파생상품상품등급
    g_BDM_DVPD_UNFIT_YN      = Form.GetSharedData("BDM_DVPD_UNFIT_YN"      , false)  '파생상품부적합여부
    g_BDM_WEAK_FNNC_YN       = Form.GetSharedData("BDM_WEAK_FNNC_YN"       , false)  '취약금융소비자여부
    g_BDM_KYC_INVT_RCMD_CLS_CODE	= Form.GetSharedData("BDM_KYC_INVT_RCMD_CLS_CODE"       , false)  'KYC투자권유구분코드
    User_SharedData_Set("")
		   
    g_Invt_YN = "Y"  '투자성향진단완료
End Function
'============================================================================
Function NextStep()
    'Form.ShowAlert("hp2", g_BDM_HP1..g_BDM_HP2..g_BDM_HP3 )
    
'화면오픈후현재창닫아야하는경우 : Form.OpenNextPopup()  -> 별도의Form.CloaseForm() 불필요
'화면오픈만하는경우 : Form.OpenPopup()

	'이전 ---------------------------------------------------------------------
    If szFlag == "BACK" Then
        '공유변수 설정
        User_SharedData_Set("")
        '약관으로 돌아가는 경우, 상품선택,약관 설정정보외 모두 초기화
        'User_SharedData_Set("init1")  '상품선택
        'User_SharedData_Set("init2")  '약관정보
        User_SharedData_Set("init3")  '개설구분
        User_SharedData_Set("init4")  '계좌정보

        'Form.OpenPopup(G_STEP2_2_FILE, "" , "")
		if g_BDM_PRCDCFD == "Y" or g_BDM_PRCD137 == "Y" then	'v0002 해외 CFD 추가
			Form.OpenNextPopup(G_STEP2_2_P4_FILE, "StepBack" , "")
		else
			User_SharedData_Set("init5")  'CFD약관
			Form.OpenNextPopup(G_STEP2_2_FILE, "StepBack" , "")

		end if
    'NEXT --------------------------------------------------
    ElseIf szFlag == "NEXT" Then
        '공유변수 설정
        User_SharedData_Set("")

        '개별개설 - mbbdm85153
        Form.OpenNextPopup("mbbdm85153", "" , "")
	
    '상품재선택--------------------------------------------------
    ElseIf szFlag == "ReTryPrcd" Then
        '공유변수 설정
        User_SharedData_Set("")
        '상품선택으로 돌아가는 경우, 상품선택 설정정보외 모두 초기화
        'User_SharedData_Set("init1")  '상품선택
        User_SharedData_Set("init2")  '약관정보
        User_SharedData_Set("init3")  '개설구분
        User_SharedData_Set("init4")  '계좌정보
        User_SharedData_Set("init5")  'CFD약관
        Form.OpenNextPopup(G_STEP2_1_FILE, "", "")	
	
    '관리점 변경 > 신규개설로 이동----------------------------------
    ElseIf szFlag == "CHANGE" Then
	    g_BDM_ACNT_OPNG_CLCD = "1"		'1.종합계좌개설 2.개별추가 
			
        '공유변수 설정
		User_SharedData_Set("")
        	User_SharedData_Set("init4")  '계좌정보

		Form.OpenNextPopup(G_STEP2_4_FILE, "", "")
		
    '홈으로 -------------------------------------------------------
    ElseIf szFlag == "HOME" Then
        '공유변수 설정
		User_SharedData_Set("")    
        	User_SharedData_Set("initA")
		
		'v0006 CloseForm을 해주지 않으면 아이폰에서 화면 안닫힘 > onFormClose 시에 OpenScreen
		Form.CloseForm()	
   End If
End Function
'============================================================================
Function Chk_Data()
    '종합계좌
    If Len(Trim(Container0.Combo0.caption)) <= 0 Then
        Form.ShowAlert("오류", "종합계좌를 선택해주세요.")
        return False
    End If

    '계좌비밀번호
    If Len(Trim(Container0.Edit0.caption)) <= 0 Then
        Form.ShowAlert("오류", "계좌비밀번호를 입력해주세요.")
        return False
    Else
        If g_PwdPass <> "Y" Then
            Form.ShowAlert("오류", "계좌비밀번호가 유효하지 않습니다.")
            return False
        End If
    End If

    '관리점 -종합계좌선택시 자동입력됨
    If Len(Trim(Container0.Combo1.caption)) <= 0 Then
        Form.ShowAlert("오류", "관리점이 입력되지 않았습니다.\n계좌추가할 종합계좌를 선택해주세요.")
        return False
    End If

    '종합매매개설시, 증거금등급
    If g_BDM_PRCD100 == "Y" Or g_BDM_PRCD200 == "Y"  Then
        If Len(Trim(Container0.Combo2.Caption)) <= 0 Then
            Form.ShowAlert("오류", "증거금등급을 선택해주세요.")    
            return False
        End If

		'임직원인 경우, 4.증거금100프로 만 가능
		If g_BDM_DREM_YN == "Y" Then
			'4`수수료포함 100%(미수거래불가) 6`종목별 차등(미수거래가능)
			If g_BDM_MARG_GRAD_CODE <> "4" Then
				Form.ShowAlert("오류", "임직원은 위탁증거금-[수수료포함 100%(미수거래불가)]만 선택 가능합니다.")
				return False
			End If
		End If
    End If
    
    'v0005 sta 콤보(v0002,v0004) > 컨테이너로 변경, 변수로 체크
    '국내CFD개설시
    If g_BDM_PRCDCFD == "Y" Then
        '-계좌유형
        If g_BDM_DMST_CFD_ACNT_APLT_YN1 <> "Y" and g_BDM_DMST_CFD_ACNT_APLT_YN2 <> "Y" Then
            Form.ShowAlert("오류", "국내 CFD 계좌 유형을 선택해주세요.")
            return False
        End If
	
        '임직원인 경우, 국내CFD 일반/안심 동시 선택 불가
        If g_BDM_DREM_YN == "Y" Then
		    If g_BDM_DMST_CFD_ACNT_APLT_YN1 == "Y" and g_BDM_DMST_CFD_ACNT_APLT_YN2 == "Y" Then
                 Container0.scroll_pos = CInt(Form.calcUnResize(Container0.Combo1.top, "1"))
			   'Form.ShowAlert("오류", "임직원은 CFD 추가 개설이 불가능합니다.\n\n- 국내 CFD : 1계좌, 1개 유형만 개설 가능\n\n- 해외 CFD : 국가별 1개 유형만 개설 가능")
                 Form.ShowAlert("오류", "임직원은 CFD 추가 개설이 불가능합니다.\n\n- 국내 CFD : 1계좌, 1개 유형만 개설 가능\n\n- 해외 CFD : 일반 유형은 국가별 1계좌만 가능") 'v0008
			   return False
		    End If
        End If
    End If   

    '해외CFD개설시 
    If g_BDM_PRCD137 == "Y" Then
        '-계좌유형
        If g_BDM_OVRS_CFD_ACNT_APLT_YN1 <> "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN3 <> "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN5 <> "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN7 <> "Y" and
		g_BDM_OVRS_CFD_ACNT_APLT_YN2 <> "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN4 <> "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN6 <> "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN8 <> "Y" Then
            Form.ShowAlert("오류", "해외 CFD 거래희망 국가의 계좌 유형을 선택해주세요.")
            return False
        End If
	
	    '임직원인 경우, 해외CFD 국가별 일반/안심 동시 선택 불가
	    'v0008 해외CFD 일반/안심 동시개설 가능해짐에 따라 주석처리함.
        'If g_BDM_DREM_YN == "Y" Then
		'    If (g_BDM_OVRS_CFD_ACNT_APLT_YN1 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN2 == "Y") or (g_BDM_OVRS_CFD_ACNT_APLT_YN3 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN4 == "Y") or
		'     (g_BDM_OVRS_CFD_ACNT_APLT_YN5 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN6 == "Y") or (g_BDM_OVRS_CFD_ACNT_APLT_YN7 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN8 == "Y") Then
         '        Container0.scroll_pos = CInt(Form.calcUnResize(Container0.Combo1.top, "1"))
         '        Form.ShowAlert("오류", "임직원은 CFD 추가 개설이 불가능합니다.\n\n- 국내 CFD : 1계좌, 1개 유형만 개설 가능\n\n- 해외 CFD : 국가별 1개 유형만 개설 가능")
		'	   return False
		'    End If
        'End If
	End If
    'v0005 fin
    
    '연금저축 개설시
'    If g_BDM_PRCD131 == "Y" Then
'	    If g_BDM_PNSN_CNRC_PRD == "" 
'    End If
    
    return True
End Function 
'============================================================================
Function NextBtn_Enable()
    '입력항목이 모두 펼쳐져있는 경우에만 버튼 활성화
    '연금저축 가입정보 입력 화면
    If g_BDM_PRCD131 == "Y" and g_bPnsnView Then
		Button0.enable = False
		If g_szTheme = "black" Then
			Button0.btnimage = "btn_27.9"
		Else 
			Button0.btnimage = "btn_21.9"
		End If
		Button0.fgcolor = "269"
	    
		If Container1.rdoType.currentindex ~= "0" and Container1.rdoType.currentindex ~= "1" Then
			Exit Function
		End If
		
		'계약기간 체크
		If Container1.edtPeriod.caption == "" or Container1.edtPeriod.caption == null or CInt(Container1.edtPeriod.caption) < 60 Then
			Exit Function
		End If
		
		'연금지급예정일 체크
		If Container1.edtStartDate.caption == "" or Container1.edtStartDate.caption == null Then
			Exit Function
		End If
		
		'계약금액 체크(신규계좌일시에만))
		If Container1.rdoType.currentindex == "0" Then
			If Container1.edtAmount.caption == "" or Container1.edtAmount.caption == null or CInt(Container1.edtAmount.caption) == 0 Then
				Exit Function
			End If
		End If
		
		If g_bAcntVerified == false Then
			Exit Function
		End If

	'기본 계좌정보 입력 화면
	Else
	    '종합계좌
	    If Len(Trim(Container0.Combo0.Caption)) <= 0 Then
		Exit Function 
	    End If 
	
	    '비밀번호
	    If Container0.Edit0.visible == False Then
		Exit Function
	    End If
	
	    '관리점
	    If Container0.Combo1.visible == False Then
		Exit Function 
	    End If
	    
	    '종합매매개설시, 증거금등급
	    If g_BDM_PRCD100 == "Y" Or g_BDM_PRCD200 == "Y" Then
		If Container0.Combo2.visible == False Then
		    Exit Function 
		End If
	    End If   
	    
		'v0005 Combo2 콤보제거 > 요건에 맞추기 위해 컨테이너로 변경(컨테이너는 IOS에서 visible 여부를 못가져와 변수로 변경)
		'v0004 sta 국내CFD개설시, 국가
	    If g_BDM_PRCDCFD == "Y" Then
		    If g_BDM_DMST_CFD_ACNT_APLT_YN1 == "N" and g_BDM_DMST_CFD_ACNT_APLT_YN2 == "N" Then
		    Exit Function 
		    End If    
		End If
	    'v0004 fin 
	    
		'v0005 Combo3,Combo4 콤보제거 > 요건에 맞추기 위해 컨테이너로 변경(컨테이너는 IOS에서 visible 여부를 못가져와 변수로 변경)
		'v0002 sta 해외CFD개설시, 국가
	    If g_BDM_PRCD137 == "Y" Then
		    If g_BDM_OVRS_CFD_ACNT_APLT_YN1 == "N" and g_BDM_OVRS_CFD_ACNT_APLT_YN3 == "N" and g_BDM_OVRS_CFD_ACNT_APLT_YN5 == "N" and g_BDM_OVRS_CFD_ACNT_APLT_YN7 == "N" and
			g_BDM_OVRS_CFD_ACNT_APLT_YN2 == "N" and g_BDM_OVRS_CFD_ACNT_APLT_YN4 == "N" and g_BDM_OVRS_CFD_ACNT_APLT_YN6 == "N" and g_BDM_OVRS_CFD_ACNT_APLT_YN8 == "N" Then	
		    Exit Function 
		    End If    
		End If
	    'v0002 fin  
	    
	    '연금저축 관련 추가
	'    If g_BDM_PRCD131 == "Y" Then
	'	    
	'    End If
	End If
	
	'다음버튼 활성화
	Button0.enable = True
	Button0.btnimage = "btn_20.9"
	Button0.fgcolor = "273"

End Function

'============================================================================
'v0005 국내/해외 CFD 계좌 유형 선택시 폰트 볼드처리 설정
'============================================================================
Function f_UserChkBold(szCFDType,sztrgt, szChk) 
	if szChk == "N" Then '미선택 -> 선택
		Form.SetCtlProp( "Container0."..szCFDType..".lbl"..sztrgt, "fontbold", true)
		Form.SetCtlProp( "Container0."..szCFDType..".lbl"..sztrgt.."Sub", "fontbold", true)
		szChk = "Y"
	else 
		Form.SetCtlProp( "Container0."..szCFDType..".lbl"..sztrgt, "fontbold", false)
		Form.SetCtlProp( "Container0."..szCFDType..".lbl"..sztrgt.."Sub", "fontbold", false)
		szChk = "N"
	end if	
	return szChk
End Function

'============================================================================
'v0005 국내/해외 CFD 계좌 유형 체크 확인
'============================================================================
Function f_UserChk() 
	If g_BDM_PRCD137 == "Y" Then		
	
		'해외 CFD 계좌유형 일반/안심 각각모두 선택된 경우, 전체개설 자동체크
		'일반
		If g_BDM_OVRS_CFD_ACNT_APLT_YN1 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN3 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN5 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN7 == "Y" Then
			Container0.contACFD.chkAllNor.chksilence = "1"
		Else
			Container0.contACFD.chkAllNor.chksilence = "0"	
		End If	
		'안심
		If g_BDM_OVRS_CFD_ACNT_APLT_YN2 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN4 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN6 == "Y" and g_BDM_OVRS_CFD_ACNT_APLT_YN8 == "Y" Then
			Container0.contACFD.chkAllSafe.chksilence = "1"
		Else
			Container0.contACFD.chkAllSafe.chksilence = "0"	
		End If
	
		'해당 국가에 일반/안심 하나라도 개설시 국가 체크 표시
		'USA
		If g_BDM_OVRS_CFD_ACNT_APLT_YN1 == "Y" or g_BDM_OVRS_CFD_ACNT_APLT_YN2 == "Y" Then
			Container0.contACFD.imgUSAChk.visible = true
			Container0.contACFD.imgUSAChk.imgpath = "check_on.png"
		Else
			Container0.contACFD.imgUSAChk.visible = false
		End If
		'CHN
		If g_BDM_OVRS_CFD_ACNT_APLT_YN3 == "Y" or g_BDM_OVRS_CFD_ACNT_APLT_YN4 == "Y" Then
			Container0.contACFD.imgCHNChk.visible = true
			Container0.contACFD.imgCHNChk.imgpath = "check_on.png"
		Else
			Container0.contACFD.imgCHNChk.visible = false
		End If	
		'HKG
		If g_BDM_OVRS_CFD_ACNT_APLT_YN5 == "Y" or g_BDM_OVRS_CFD_ACNT_APLT_YN6 == "Y" Then
			Container0.contACFD.imgHKGChk.visible = true
			Container0.contACFD.imgHKGChk.imgpath = "check_on.png"
		Else
			Container0.contACFD.imgHKGChk.visible = false
		End If	
		'JPN
		If g_BDM_OVRS_CFD_ACNT_APLT_YN7 == "Y" or g_BDM_OVRS_CFD_ACNT_APLT_YN8 == "Y" Then
			Container0.contACFD.imgJPNChk.visible = true
			Container0.contACFD.imgJPNChk.imgpath = "check_on.png"
		Else
			Container0.contACFD.imgJPNChk.visible = false
		End If
	End If	
End Function



'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

	g_sz_OSType = Form.GetSharedData("&OS_TYPE", false)
	
	'테스트용 연금저축 계좌확인스킵 체크
    g_nDev = Form.GetSharedData("&SERVER_MODE", False )
	
    '테마구분 white/black
	g_szTheme = Form.GetEnvData("common.theme")

    '다음버튼 비활성화
	Button0.enable = False
	If g_szTheme = "black" Then
		Button0.btnimage = "btn_27.9"
	Else 
		Button0.btnimage = "btn_21.9"
	End If
	Button0.fgcolor = "269"

	'파일설정
	User_File_Set()
	
	'공유정보Get
	User_SharedData_Get()	
	
	g_Invt_YN = ""  '투자성향진단
	
	'에디트 컨트롤 입력항목명 생성 (267.검정색)
     Container0.Combo0.SetApplyLabel("종합계좌번호" 	  ,0 , 267 , "left", true , 111)
     Container0.Combo1.SetApplyLabel("종합계좌의 관리점" ,0 , 267 , "left", false, 111)
     Container0.Combo2.SetApplyLabel("위탁증거금"     	  ,0 , 267 , "left", true , 111)
     Container0.Edit0.SetApplyLabel ("종합계좌 비밀번호" ,1 , 267 , "left", true)

	'관리점 -사용불가(계좌 선택시, 자동선택)
	'순서주의! SetApplyLabel 올린 이후, 같이 False 처리해야함
	Container0.Combo1.enable = false
	
	'연금저축 가입정보 추가
	Container1.edtPeriod.SetApplyLabel ("계약기간" ,1 , 267 , "left", false)
	Container1.edtStartDate.SetApplyLabel ("연금지급개시 예정일" ,1 , 267 , "left", false)
	Container1.edtAmount.SetApplyLabel ("계약금액(납입한도)" ,1 , 267 , "left", false)
	
	Container1.edtPeriod.SetUseResultLabel(True, 1)
	Container1.edtStartDate.SetUseResultLabel(True, 1)
	Container1.edtAmount.SetUseResultLabel(True, 1)

	Container1.btnCalendar.bringFront("1")
	Container1.imgBankSearch.bringFront("1")
	Container1.btnShowAcntList.bringFront("1")
	Container1.Button1.bringFront("1")
	
	'iOS만 처리
	If g_sz_OSType == "2" or g_sz_OSType == 2 Then
		Container1.edtAcnt.SetOnOffImage("alpha", "alpha")
	End If
	
	'연금저축 가입정보 항목들 개설구분 제외 처음엔 숨김
	Container1.edtPeriod.visible = false
	Container1.edtStartDate.visible = false
	Container1.edtAmount.visible = false
	Container1.imgAcntBg.visible = false
	Container1.lblAcntTitle.visible = false
	Container1.edtBank.visible = false
	Container1.imgBankSearch.visible = false
	Container1.edtAcnt.visible = false
	Container1.btnCalendar.visible = false
	Container1.chkSkip.visible = false
	Container1.Label3.visible = false
	
	'연금저축 개설 케이스일시
	If g_BDM_PRCD131 == "Y" Then
		SetPnsnDataSet()
	End If
	
	'v0005 sta
	Container0.contCFD.imgCFDBack.SetStatus("normal")	
	Container0.contCFD.imgCFDNor.SetStatus("normal")
	Container0.contCFD.imgCFDSafe.SetStatus("normal")
	Container0.contACFD.imgACFDBack.SetStatus("normal")	
	Container0.contACFD.imgUSANor.SetStatus("normal")
	Container0.contACFD.imgCHNNor.SetStatus("normal")	
	Container0.contACFD.imgHKGNor.SetStatus("normal")
	Container0.contACFD.imgJPNNor.SetStatus("normal")
	Container0.contACFD.imgUSASafe.SetStatus("normal")	
	Container0.contACFD.imgCHNSafe.SetStatus("normal")	
	Container0.contACFD.imgHKGSafe.SetStatus("normal")	
	Container0.contACFD.imgJPNSafe.SetStatus("normal")	

	g_BDM_DMST_CFD_ACNT_APLT_YN1	= "N"		'국내CFD 일반계좌 Y/N
	g_BDM_DMST_CFD_ACNT_APLT_YN2	= "N"		'국내CFD 안심계좌 Y/N
	g_BDM_OVRS_CFD_ACNT_APLT_YN1	= "N"		'미국 일반계좌 Y/N
	g_BDM_OVRS_CFD_ACNT_APLT_YN2 	= "N"		'미국 안심계좌 Y/N
	g_BDM_OVRS_CFD_ACNT_APLT_YN3 	= "N"		'중국 일반계좌 Y/N
	g_BDM_OVRS_CFD_ACNT_APLT_YN4 	= "N"		'중국 안심계좌 Y/N	
	g_BDM_OVRS_CFD_ACNT_APLT_YN5	= "N"		'홍콩 일반계좌 Y/N
	g_BDM_OVRS_CFD_ACNT_APLT_YN6 	= "N"		'홍콩 안심계좌 Y/N
	g_BDM_OVRS_CFD_ACNT_APLT_YN7	= "N"		'일본 일반계좌 Y/N
	g_BDM_OVRS_CFD_ACNT_APLT_YN8	= "N"		'일본 안심계좌 Y/N
	'v0005 fin
	
	'개설가능 종합계좌정보 조회
	DATAMANAGER.RequestTranData("obaci_acct_185r")
End Sub

'============================================================================
Sub Container0_Combo0_OnEditComplete(iIndex)
    If iIndex >= 0 Then
        g_BDM_ACNO = Container0.Combo0.cbkeydata
        Form.SetSharedData("BDM_ACNO" , g_BDM_ACNO)
	
	   '관리점 초기화
	   Container0.Combo1.clear = 0 
	   g_BDM_MANG_BRCD = ""
        Form.SetSharedData("BDM_MANG_BRCD" , g_BDM_MANG_BRCD)
	
        'ISA개설-동일 종합계좌내에 종합매매 상품이 없는경우, 종합매매(ISA고유의 현물&현금해지&입금용) 필수선택 체크
        If g_BDM_PRCD133 == "Y" and g_BDM_ISA_PROD_TYPE == "2" Then
            For i = 0 To Grid0.rowcount -1
                strAcno = Grid0.GetCellData("bd_cell1", i )
                If CInt(Trim(g_BDM_ACNO)) == CInt(Trim(strAcno)) Then
                    strExstYN = Grid0.GetCellData("bd_cell0", i)
                    If Trim(strExstYN) <> "Y" Then  '종합계좌내 종합매매 미존재
                        If g_BDM_PRCD100 <> "Y" and g_BDM_PRCD118RP <> "Y" Then	'v0006 CMA계좌 보유시에도 개설 가능하도록 변경
                            Form.MsgBox("안내", "선택하신 종합계좌에 일임형ISA의 현물,\n현금해지, 입금을 위한 별도 계좌\n(종합매매 또는 CMA)가 필요 합니다.\n\n"..
									    "ISA와 별도계좌를 동시 개설하기 위해 개설상품 선택화면으로 이동하시겠습니까?", "ReTryPrcd", 2)
                            Exit Sub
                        End If                    
                    End If
                    Exit For
                End If
            Next
        End If

        NextBtn_Enable()

        '비밀번호 포커싱
        Container0.Edit0.visible = true        
        Container0.Edit0.SetShowKeypad(true)
    End If
End Sub


'============================================================================
Sub Container0_Edit0_OnEditComplete()
    g_PwdPass = ""
    If Container0.Edit0.caption ~= "" Or Container0.Edit0.caption ~=  null Then
        '비밀번호 검증
        nLen = Container0.Edit0.pwdlen
        If CInt(nLen) < 4 Then
            Form.ShowAlert("알림", "4자리 이상 입력해 주세요.")
        Else 
            DATAMANAGER.RequestTranData("obacp_opop_066r")
        End If
    End If
End Sub

'============================================================================
Sub Container0_Combo1_OnEditComplete(iIndex)
    If iIndex >= 0 Then
        g_BDM_MANG_BRCD = Container0.Combo1.cbkeydata
	    Form.SetSharedData("BDM_MANG_BRCD" , g_BDM_MANG_BRCD)
	    NextBtn_Enable()
    End If
End Sub
'============================================================================
'v0006 관리점지정 프로세스 개선 > 안내팝업 호출
'============================================================================
Sub Container0_lblMangChg_OnClick()
	If Container0.chkMangChg.chksilence == "0" Then
		Container0.chkMangChg.chksilence = "1" 
		
		Dim szData		
		'szData : KeyName★타이틀명★버튼 개수★버튼넓이(Left)★버튼명(Left)★버튼명(Right)★안내문 정렬(0(왼),1(중),2(오))★총 안내문 수★안내문 줄 수★imgdot 사용여부★안내내용

		If g_BDM_BNK_MNY_OPNG_YN == "Y" Then
			'단기다수개설 고객인경우 관리점 변경 원할시 개설 불가 안내
			szData = "85133_P1_BNK_MNY_MSG".."★".."안내".."★"..
					"2".."★".."".."★".."다음에\n개설하기".."★".."확인".."★"..
					"1".."★".."3".."★"..
					"2".."★".."false".."★".."관리점 지정은\n신규계좌개설시에만 가능해요.".."★"..
					"2".."★".."false".."★".."고객님은 최근 20일(영업일 기준) 이내 개설된\n계좌가 존재하여 신규 개설이 제한됩니다.".."★"..			
					"1".."★".."false".."★".."기존계좌를 이용하여 개설 하시겠습니까?"			
		Else 
			'관리점지정은 신규계좌개설시에만 가능 안내 
			'szData : KeyName★타이틀명★버튼 개수★버튼넓이(Left)★버튼명(Left)★버튼명(Right)★안내문 정렬(0(왼),1(중),2(오))★총 안내문 수★안내문 줄 수★imgdot 사용여부★안내내용
			szData = "85133_P1_MANG_CHG_MSG".."★".."안내".."★"..
					"2".."★".."140".."★".."확인".."★".."신규 종합계좌\n개설하여 진행하기".."★"..
					"1".."★".."2".."★"..
					"2".."★".."false".."★".."관리점 지정은\n신규계좌개설시에만 가능해요.".."★"..
					"3".."★".."false".."★".."관리점 변경을 원하신다면\n신규계좌를 개설하여\n관리점을 지정해주세요."
		End If
		Form.OpenPopup("mbbdm85133_p1", szData, "")	
	End If
End Sub

'============================================================================
Sub Container0_Combo2_OnEditComplete(iIndex)
'	Container0.Label0.top = 437
'	Container0.SetScrollAutoSize()

	'증거금등등급 ---------------------------------
	If iIndex ~= "" Or iIndex ~= null Then
	    g_BDM_MARG_GRAD_CODE = Container0.Combo2.cbkeydata
		
		'임직원인 경우, 4.증거금100프로 만 가능
		If g_BDM_DREM_YN == "Y" Then
			'4`수수료포함 100%(미수거래불가) 6`종목별 차등(미수거래가능)
			If g_BDM_MARG_GRAD_CODE <> "4" Then
				Form.ShowAlert("오류", "임직원은 위탁증거금-[수수료포함 100%(미수거래불가)]만 선택 가능합니다.")
				Container0.Combo2.caption = ""
				g_BDM_MARG_GRAD_CODE = ""
				Exit Sub
			End If
		End If

		Form.SetSharedData("BDM_MARG_GRAD_CODE" , g_BDM_MARG_GRAD_CODE)
		
		'v0005 sta
		'v0004 sta 국내CFD 개설 (종합매매개설 아닌경우)
		'해외CFD 국내CFD 동시 개설일때도 국내CFD 개설부터
		If g_BDM_PRCDCFD == "Y" and g_BDM_PRCD137 == "Y" Then '국내 CFD 개설인 경우		
			Container0.contCFD.visible = true
			Container0.contACFD.visible = true	
		Else
			If g_BDM_PRCDCFD == "Y" Then '국내 CFD 개설인 경우	
				Container0.contCFD.visible = true
			ElseIf g_BDM_PRCD137 == "Y" Then '해외 CFD 개설인 경우	
				Container0.contACFD.top = 386		'Container0.contCFD.top	v0006 값변경
				Container0.contACFD.visible = true
			End If
		End If
		'v0005 fin
		NextBtn_Enable()
	End If
End Sub


