'============================================================================
'연금지급예정일 영역 터치시 달력 팝업
'============================================================================
Sub Container1_btnCalendar_OnClick()
	Calendar0.showcalendar = "1"
End Sub

'============================================================================
'연금지급예정일 변경 세팅
'============================================================================
Sub Calendar0_OnEditComplete()
	'자동세팅된 날짜 이전으로 선택시 예외처리
	If CInt(g_szBaseDate) > CInt(Calendar0.caption) Then
		Container1.edtStartDate.SetResultLabel("1","error","연금지급개시예정일 이후로 변경 가능합니다.","Container1")
		Calendar0.caption = g_szBaseDate
		
'		'오류문구로 밀려난 만큼 컨테이너 스크롤 영역 재설정
'		If Not g_bErrorFlag3 Then
'			g_bErrorFlag3 = true
'			g_nErrorCnt = g_nErrorCnt + 1
'			
'			f_SetPnsnContScroll()
'			
'			Container1.SetScrollAutoSize()
'		End If
		Exit Sub
	End If
	
	Container1.edtStartDate.SetResultLabel("0","","","Container1")
	
'	If g_bErrorFlag3 Then
'		g_bErrorFlag3 = false
'		g_nErrorCnt = g_nErrorCnt - 1
'			
'		f_SetPnsnContScroll()
'		
'		Container1.SetScrollAutoSize()
'	End If
	
	g_BDM_PNSN_PRVS_BEGN_SCDL_DATE = Calendar0.caption
	Form.SetSharedData("BDM_PNSN_PRVS_BEGN_SCDL_DATE"    , g_BDM_PNSN_PRVS_BEGN_SCDL_DATE)	
	
	Container1.edtStartDate.caption = Left(Calendar0.caption, 4) & "년 " & Mid(Calendar0.caption, 5, 2) & "월 " & Right(Calendar0.caption, 2) & "일"
	
	NextBtn_Enable()
End Sub

'============================================================================
'당사 CMA 계좌 선택팝업
'============================================================================
Sub Container1_btnShowAcntList_OnClick()
	If g_BDM_PNSN_PRVS_BANK_CODE <> "" Then
		If g_nPnsnCmaCnt > 0 Then
			cmbCMA.openList()
		Else
			'CMA 계좌 없을시 메시지 띄워주고 타사기관 선택 팝업 오픈
			Form.MsgBox("안내", "당사 보유중인 CMA계좌가 없습니다.", "NO_CMA_ACNT", 6)
		End If
	Else
		Form.MsgBox("안내", "금융기관을 선택해주세요.", "NO_CMA_ACNT", 6)
	End If

	'이 버튼을 누르는 시점에 CMA 계좌 조회
	'비대면용 설정가능계좌 조회(CMA)
'	DATAMANAGER.RequestTranData( "obaci_nmet_016r" )
End Sub

'============================================================================
'연금지급계좌 당사CMA 계좌선택
'============================================================================
Sub cmbCMA_OnEditComplete(iIndex)
	Dim szAcnt
	szAcnt = cmbCMA.cbkeydata
	If szAcnt <> "" and szAcnt <> null Then
	
		Container1.Label3.visible = false
		
		g_BDM_PNSN_PRVS_BANK_ACNO = szAcnt
		Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , g_BDM_PNSN_PRVS_BANK_ACNO)
		Container1.edtAcnt.caption = Left(szAcnt, 4) & "-" & Mid(szAcnt, 5, 4) & "-" & Right(szAcnt, 2)
		
		g_bAcntVerified = true
	End If
	
	NextBtn_Enable()
End Sub

'============================================================================
'연금지급계좌 기관선택 팝업
'============================================================================
Sub Container1_imgBankSearch_OnClick()
	Form.OpenPopupAnimation("mbbdm85170_p1" , "pass"  ,"","2")
	Container1.edtAcnt.caption = ""
	Container1.Label3.visible = true
End Sub

'============================================================================
'연금지급계좌 입력
'============================================================================
Sub Container1_edtAcnt_OnEditComplete()
	'타사일경우만 수취인 조회 실행
	If g_BDM_PNSN_PRVS_BANK_CODE <> "287" Then
		g_BDM_PNSN_PRVS_BANK_ACNO = Container1.edtAcnt.caption
		Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , g_BDM_PNSN_PRVS_BANK_ACNO)
		
		If Container1.edtAcnt.caption == "" Then
			Container1.Label3.visible = true
			Exit Sub
		End If
		
		g_bAcntVerified = false
		'타행수취인조회
		If Container1.chkSkip.checkstate == "1" Then
			Form.ShowAlert("안내", "계좌 수취인 확인 완료.")
			g_bAcntVerified = true
		
			NextBtn_Enable()
		Else
			DATAMANAGER.RequestTranData( "obtss_elbs_129r" )
		End If
	Else
		g_bAcntVerified = true
	End If
	
	NextBtn_Enable()
End Sub

