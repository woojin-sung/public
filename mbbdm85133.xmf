'============================================================================
Sub Container1_rdoType_OnClick(nIndex)
	'아이폰용 예외처리
	If CInt(nIndex) == -1 Then
		Exit Sub
	End If
		
	'연금저축 개설구분
	'신규계좌 개설은 화면처리 전에 잔여한도 체크
	If nIndex == 0 Then
'		g_nRemainLmt = 0
		If CInt(g_nRemainLmt) <= 0 Then
			Form.OpenPopup("mbbdm85132_p3", "", "")
			Exit Sub
		End If
	End If
	
	Container1.edtPeriod.visible = true
	Container1.edtStartDate.visible = true
	
	Container1.imgAcntBg.visible = true
	Container1.lblAcntTitle.visible = true
	Container1.edtBank.visible = true
	Container1.imgBankSearch.visible = true
	Container1.edtAcnt.visible = true
	Container1.btnCalendar.visible = true
	Container1.Label3.visible = true
	
	If g_nDev == "1" Or g_nDev == 1 Then
		Container1.chkSkip.visible = true
	End If
	
	'입력값 및 에러문구 초기화
	Container1.edtAmount.SetResultLabel("0","complete","","Container1")
	Container1.edtPeriod.SetResultLabel("0","complete","","Container1")
	Container1.edtStartDate.SetResultLabel("0","complete","","Container1")
	
	g_BDM_PNSN_CNRC_AMT = ""
	Container1.edtAmount.caption = g_BDM_PNSN_CNRC_AMT
	Form.SetSharedData("BDM_PNSN_CNRC_AMT", g_BDM_PNSN_CNRC_AMT)
	
	Container1.edtPeriod.caption = ""
	Form.SetSharedData("BDM_PNSN_CNRC_PRD", "")
	
'	Calendar0.caption = g_BDM_PNSN_PRVS_BEGN_SCDL_DATE
'	Form.SetSharedData("BDM_PNSN_PRVS_BEGN_SCDL_DATE"    , g_BDM_PNSN_PRVS_BEGN_SCDL_DATE)	
	Calendar0.caption = g_szBaseDate
	Form.SetSharedData("BDM_PNSN_PRVS_BEGN_SCDL_DATE"    , g_szBaseDate)	
	Container1.edtStartDate.caption = Left(Calendar0.caption, 4) & "년 " & Mid(Calendar0.caption, 5, 2) & "월 " & Right(Calendar0.caption, 2) & "일"
	
	Container1.Label3.visible = true
	Container1.edtAcnt.caption = ""
	g_BDM_PNSN_PRVS_BANK_ACNO = Container1.edtAcnt.caption
	Form.SetSharedData("BDM_PNSN_PRVS_BANK_ACNO"           , g_BDM_PNSN_PRVS_BANK_ACNO)
	g_bAcntVerified = false
	
	'금융기관 초기화 : 당사보유 CMA 계좌가 있으면 메리츠증권 아니면 미선택 처리
	If g_nPnsnCmaCnt > 0 Then
		g_BDM_PNSN_PRVS_BANK_CODE = "287"
		Container1.edtBank.caption = "메리츠증권"
		Container1.edtBank.fgcolor = "4"
	Else
		g_BDM_PNSN_PRVS_BANK_CODE = ""
		Container1.edtBank.caption = "금융기관"
		Container1.edtBank.fgcolor = "103"
	End If
	Container1.btnShowAcntList.visible = true
	Form.SetSharedData("BDM_PNSN_PRVS_BANK_CODE"           , g_BDM_PNSN_PRVS_BANK_CODE)
	
	'신규계좌
	If nIndex == 0 Then
		'계약금액은 신규계좌 선택시에만 보여줌
		Container1.edtAmount.visible = true
		Container1.edtAmount.caption = ""
		
		Container1.imgAcntBg.top = 405
		Container1.lblAcntTitle.top = 415
		Container1.edtBank.top = 438
		Container1.imgBankSearch.top = 442
		Container1.edtAcnt.top = 438
		Container1.Label3.top = 438
		Container1.btnShowAcntList.top = 438
		Container1.Button1.top = 438
		
		Container1.chkSkip.top = 405
		
		g_BDM_PNSN_TCTR_CLS_CODE = "1"
		
		Container1.lblSpace.top = 600
		
	'이수전용계좌
	ElseIf nIndex == 1 Then 
		'계약금액은 신규계좌 선택시에만 보여줌
		Container1.edtAmount.visible = false
		Container1.edtAmount.caption = ""
		
		Container1.imgAcntBg.top = 320
		Container1.lblAcntTitle.top = 330
		Container1.edtBank.top = 353
		Container1.imgBankSearch.top = 357
		Container1.edtAcnt.top = 353
		Container1.Label3.top = 353
		Container1.btnShowAcntList.top = 353
		Container1.Button1.top = 353
		
		Container1.chkSkip.top = 320
		
		g_BDM_PNSN_TCTR_CLS_CODE = "2"
		
		Container1.lblSpace.top = 450
	End If 
	
	'구분에 따른 안내팝업 오픈
	If nIndex == 0 Then
		Form.OpenPopup("mbbdm85132_p5", "1", "")
	ElseIf nIndex == 1 Then
		Form.OpenPopup("mbbdm85132_p5", "2", "")
	End If
	
	
	Form.SetSharedData("BDM_PNSN_TCTR_CLS_CODE", g_BDM_PNSN_TCTR_CLS_CODE)			'신규 / 이수전용계좌코드
	
	NextBtn_Enable()
	
	'입력영역으로 스크롤 조정
	Dim nTop
	nTop = CInt(Form.calcUnResize(Container1.lbl1.top, "1"))
	Container1.scroll_pos = nTop
	
	Container1.SetScrollAutoSize()
End Sub

'============================================================================
'계약기간 입력
'============================================================================
Sub Container1_edtPeriod_OnEditComplete()
	Dim nPeriod
	nPeriod = CInt(Container1.edtPeriod.caption)
	'60개월 미만 입력시 
	If nPeriod < 60 Then
'		Container1.scroll_pos = CInt(Form.calcUnResize(Container1.edtPeriod.top, "1"))
		Container1.edtPeriod.SetResultLabel("1","error","계약기간은 60개월 이상으로 입력해주세요.","Container1")
		
		
'		'오류문구로 밀려난 만큼 컨테이너 스크롤 영역 재설정
'		If Not g_bErrorFlag1 Then
'			g_bErrorFlag1 = true
'			g_nErrorCnt = g_nErrorCnt + 1
'			
'			f_SetPnsnContScroll()
'			
'			Container1.SetScrollAutoSize()
'		End If
		Exit Sub
	End If
	
	g_BDM_PNSN_CNRC_PRD = Container1.edtPeriod.caption
	Form.SetSharedData("BDM_PNSN_CNRC_PRD", g_BDM_PNSN_CNRC_PRD)
	
	Container1.edtPeriod.SetResultLabel("0","complete","","Container1")
	
	Container1.scroll_pos = CInt(Form.calcUnResize(Container1.edtPeriod.top, "1"))
	
'	If g_bErrorFlag1 Then
'		g_bErrorFlag1 = false
'		g_nErrorCnt = g_nErrorCnt - 1
'			
'		f_SetPnsnContScroll()
'		
'		Container1.SetScrollAutoSize()
'	End If
	
	NextBtn_Enable()
End Sub

'============================================================================
'계약금액 입력
'============================================================================
Sub Container1_edtAmount_OnEditComplete()
	Dim nAmount
	nAmount = CInt(Container1.edtAmount.caption)
	'남은한도금액보다 계약금액이 크거나 입력금액이 0원일시
	If nAmount > g_nRemainLmt or nAmount == 0 Then
'		Container1.scroll_pos = CInt(Form.calcUnResize(Container1.edtAmount.top, "1"))

		If nAmount > g_nRemainLmt Then
			Container1.edtAmount.SetResultLabel("1","error","계약금액을 확인해주세요.(납입한도 초과)","Container1")
		ElseIf nAmount == 0 Then
			Container1.edtAmount.SetResultLabel("1","error","계약금액을 확인해주세요.(최소 계약금액 1원)","Container1")
		End If
		
'		'오류문구로 밀려난 만큼 컨테이너 스크롤 영역 재설정
'		If Not g_bErrorFlag2 Then
'			g_bErrorFlag2 = true
'			g_nErrorCnt = g_nErrorCnt + 1
'			
'			f_SetPnsnContScroll()
'			
'			Container1.SetScrollAutoSize()
'		End If
		Exit Sub
	Else
		Container1.edtAmount.SetResultLabel("0","","","Container1")
	End If
	
	g_BDM_PNSN_CNRC_AMT = Container1.edtAmount.caption
	Form.SetSharedData("BDM_PNSN_CNRC_AMT", g_BDM_PNSN_CNRC_AMT)
	
'	Container1.edtAmount.SetResultLabel("0","","","Container1")
'	
'	If g_bErrorFlag2 Then
'		g_bErrorFlag2 = false
'		g_nErrorCnt = g_nErrorCnt - 1
'			
'		f_SetPnsnContScroll()
'		
'		Container1.SetScrollAutoSize()
'	End If
	
	NextBtn_Enable()
End Sub

