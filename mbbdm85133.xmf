        Form.SetSharedData("BDM_DVPD_UNFIT_YN"      , g_BDM_DVPD_UNFIT_YN          )  '파생상품부적합여부
        Form.SetSharedData("BDM_WEAK_FNNC_YN"       , g_BDM_WEAK_FNNC_YN           )  '취약금융소비자여부
        Form.SetSharedData("BDM_KYC_INVT_RCMD_CLS_CODE"       , g_BDM_KYC_INVT_RCMD_CLS_CODE )  'KYC투자권유구분코드
