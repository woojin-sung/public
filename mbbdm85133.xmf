'============================================================================
'v0005 해외 CFD 일반으로 전체개설 체크 선택
'============================================================================
Sub Container0_contACFD_chkAllNor_OnChange(sCheckState)
	If sCheckState == "1" Then
		Container0.contACFD.imgUSANor.SetStatus("focus")	 
		Container0.contACFD.imgCHNNor.SetStatus("focus")	 
		Container0.contACFD.imgHKGNor.SetStatus("focus")	 
		Container0.contACFD.imgJPNNor.SetStatus("focus")
		g_BDM_OVRS_CFD_ACNT_APLT_YN1 = f_UserChkBold("contACFD", "USANor", "N")
		g_BDM_OVRS_CFD_ACNT_APLT_YN3 = f_UserChkBold("contACFD", "CHNNor", "N")
		g_BDM_OVRS_CFD_ACNT_APLT_YN5 = f_UserChkBold("contACFD", "HKGNor", "N")
		g_BDM_OVRS_CFD_ACNT_APLT_YN7 = f_UserChkBold("contACFD", "JPNNor", "N")
	Else
		Container0.contACFD.imgUSANor.SetStatus("normal")
		Container0.contACFD.imgCHNNor.SetStatus("normal")
		Container0.contACFD.imgHKGNor.SetStatus("normal")
		Container0.contACFD.imgJPNNor.SetStatus("normal")
		g_BDM_OVRS_CFD_ACNT_APLT_YN1 = f_UserChkBold("contACFD", "USANor", "Y")
		g_BDM_OVRS_CFD_ACNT_APLT_YN3 = f_UserChkBold("contACFD", "CHNNor", "Y")
		g_BDM_OVRS_CFD_ACNT_APLT_YN5 = f_UserChkBold("contACFD", "HKGNor", "Y")
		g_BDM_OVRS_CFD_ACNT_APLT_YN7 = f_UserChkBold("contACFD", "JPNNor", "Y")
	End If
	f_UserChk() 
	NextBtn_Enable()
End Sub
