<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="44500" scrname="해외파생_시세신청_유의사항팝업" version="2" writer="이준행" />
	<FORM_INFO name="Form" ly_vert="0,0,375,607,1" />
	<CONTROL_INFO>
		<LABEL name="Label3" fontsize="-1" caption="* 23:50 ~ 00:20에는 실시간시세 신청이 불가능합니다." valign="0" multiline="1" ly_vert="10,18,355,18,1" />
		<LABEL name="Label4" fontsize="-1" caption="* 실시간시세는 1개의 단말에서만 조회가 가능하며 " valign="0" multiline="1" ly_vert="10,83,355,18,1" />
		<LABEL name="Label5" fontsize="-1" caption="* 실시간시세는 1개월 단위로 신청가능합니다." valign="0" multiline="1" ly_vert="10,124,355,18,1" />
		<LABEL name="Label6" fontsize="-1" caption="* 실시간시세를 월 중도에 신청하는 경우에도 1개월 
비용이 부과됩니다." valign="0" multiline="1" ly_vert="10,147,355,36,1" />
		<LABEL name="Label7" fontsize="-1" caption="* 실시간시세 신청 시, 시세 사용료가 즉시 출금됩니다." valign="0" multiline="1" ly_vert="10,188,355,18,1" />
		<LABEL name="Label8" fontsize="-1" caption="* 실시간시세 중도 해지 시 기납부된 시세 이용료는 
반환되지 않습니다." valign="0" multiline="1" ly_vert="10,211,355,36,1" />
		<LABEL name="Label9" fontsize="-1" caption="* 실시간시세 이용료 지급 방식은 '자동연장', '기간선택', 
'당월' 중 선택할 수 있습니다." valign="0" multiline="1" ly_vert="10,252,355,36,1" />
		<LABEL name="Label10" fontsize="-1" caption="* 실시간시세 자동연장을 선택한 경우 1개월 단위로 
자동연장되며 시세이용료는 매월 첫 영업일에 계좌의 
외화잔고에서 신청시장의 통화로 출금됩니다. 
(외화잔고에 시세비용을 납부할 금액이 부족한 경우 
자동해지 되오니 유의하시기 바랍니다.)" valign="0" multiline="1" ly_vert="10,293,355,86,1" />
		<LABEL name="Label11" fontsize="-1" caption="* 자동연장을 원하시지 않는 고객은 기간선택 또는 당월 실시간시세 신청하시기 바랍니다." valign="0" multiline="1" ly_vert="10,384,355,36,1" />
		<LABEL name="Label0" fontsize="-1" caption="* 유선 신청은 불가능하며 유선을 통한 해지만 가능합니다." valign="0" multiline="1" ly_vert="10,425,355,36,1" />
		<LABEL name="Label1" fontsize="-1" caption="* 개인 전문가 고객은 가까운 영업점에 방문 후 신청하시기 바랍니다." valign="0" multiline="1" ly_vert="10,466,355,36,1" />
		<LABEL name="Label2" fontsize="-1" caption="* 법인 고객은 전문가로 신청가능합니다." valign="0" multiline="1" ly_vert="10,507,355,18,1" />
		<LABEL name="Label12" fontsize="-1" caption="* 실시간시세" valign="0" multiline="1" ly_vert="10,42,91,18,1" />
		<LABEL name="Label13" fgcolor="007:030080200" fontsize="-1" fontstyle="01" caption="신청 후 재접속" valign="0" multiline="1" ly_vert="94,42,101,18,1" />
		<LABEL name="Label14" fontsize="-1" caption="하셔야 실시간시세 조회가" valign="0" multiline="1" ly_vert="188,42,168,18,1" />
		<LABEL name="Label15" fontsize="-1" caption="가능합니다." valign="0" multiline="1" ly_vert="10,60,168,18,1" />
		<LABEL name="Label16" fgcolor="007:030080200" fontsize="-1" fontstyle="01" caption="동일 ID로 복수 접속이 불가능" valign="0" multiline="1" ly_vert="10,101,205,18,1" />
		<LABEL name="Label17" fontsize="-1" caption="합니다." valign="0" multiline="1" ly_vert="191,101,147,18,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="271" _ulen="241" >
'============================================================================


'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("해외주식 실시간 시세신청 유의사항")
End Sub

	</SCRIPT_INFO>
