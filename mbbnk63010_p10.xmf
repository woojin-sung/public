	<SCRIPT_INFO _len="8198" _ulen="7886" >
--===========================================================================
' 작성 : 2022.10.11. 장원혁
--===========================================================================
Dim szData '전역변수(계좌번호 8자리)
Dim g_CSNO          '고객번호
Dim g_CUST_CLS_CODE '고객구분코드
Dim g_SECU_GRAD_CLS_CODE '보안등급구분코드
Dim g_SVCD_SRNO '서비스일련번호
Dim SECU_T1_TACT_LIMT_AMT '보안등급1회이체한도
Dim SECU_D1_TACT_LIMT_AMT '보안등급1일이체한도
Dim CUST_T1_TACT_LIMT_AMT '고객지정1회이체한도
Dim CUST_D1_TACT_LIMT_AMT '고객지정1일이체한도
Dim APLY_T1_TACT_LIMT_AMT '고객적용1회이체한도
Dim APLY_D1_TACT_LIMT_AMT '고객적용1일이체한도
Dim TR_AMT                '누적이체금액
Dim RMNN_AMT              '잔여한도

Dim g_bFlipFlag
'============================================================================
Sub Form_OnFormInit()
	g_bFlipFlag = false

	szData = Form.GetOpenLinkData()

	If szData <> "" And szData <> Null Then
	
        DATAMANAGER.SetDataValue(0, "obpds_srvc_070r" , "InBlock1" , "ACNO" , 0 , szData)
        DATAMANAGER.RequestTranData("obpds_srvc_070r")
	
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

    If szTranID == "obpds_srvc_070r" Then
    
        g_CSNO          = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CSNO"          , 0)
        g_CUST_CLS_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CUST_CLS_CODE" , 0)
	
        DATAMANAGER.SetDataValue(0, "obpds_srvc_120r" , "InBlock1" , "ACNO" , 0 , szData)
        DATAMANAGER.RequestTranData("obpds_srvc_120r")
	
    End If
    
    If szTranID == "obpds_srvc_120r" Then
    
        g_SECU_GRAD_CLS_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "SECU_GRAD_CLS_CODE" , 0)
	
        If g_SECU_GRAD_CLS_CODE == "01" Then
           Label6.caption = "1등급[OTP]"
        ElseIf g_SECU_GRAD_CLS_CODE == "04" Then
           Label6.caption = "1등급[모바일OTP]"
        ElseIf g_SECU_GRAD_CLS_CODE == "02" Then
           Label6.caption = "2등급[보안카드]"
        ElseIf g_SECU_GRAD_CLS_CODE == "03" Then
           Label6.caption = "3등급[보안카드]"
        Else
           Label6.caption = "없음"
        End If
	
        DATAMANAGER.SetDataValue(0, "obpds_srvc_123r" , "InBlock1" , "SVCD"               , 0 , "019")
        DATAMANAGER.SetDataValue(0, "obpds_srvc_123r" , "InBlock1" , "CUST_CLS_CODE"      , 0 , g_CUST_CLS_CODE)
        DATAMANAGER.SetDataValue(0, "obpds_srvc_123r" , "InBlock1" , "SECU_GRAD_CLS_CODE" , 0 , g_SECU_GRAD_CLS_CODE)
        DATAMANAGER.RequestTranData("obpds_srvc_123r")
	
    End If
    
    If szTranID == "obpds_srvc_123r" Then
    
        SECU_T1_TACT_LIMT_AMT = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "T1_TACT_LIMT_AMT" , 0)
        SECU_D1_TACT_LIMT_AMT = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "D1_TACT_LIMT_AMT" , 0)
	
        tblTrans1.SetCellString(0, 1, SECU_T1_TACT_LIMT_AMT) '보안등급별 1회한도
        tblTrans1.SetCellString(1, 1, SECU_D1_TACT_LIMT_AMT) '보안등급별 1일한도
    
        DATAMANAGER.SetDataValue(0, "obpds_srvc_069r" , "InBlock1" , "CSNO"               , 0 , g_CSNO)
        DATAMANAGER.SetDataValue(0, "obpds_srvc_069r" , "InBlock1" , "SVCD"               , 0 , "019")
        DATAMANAGER.SetDataValue(0, "obpds_srvc_069r" , "InBlock1" , "ACNO"               , 0 , szData)
        DATAMANAGER.SetDataValue(0, "obpds_srvc_069r" , "InBlock1" , "PROS_CLS_CODE"      , 0 , "U")
        DATAMANAGER.SetDataValue(0, "obpds_srvc_069r" , "InBlock1" , "STPL_STAT_CLS_CODE" , 0 , "")
        DATAMANAGER.RequestTranData("obpds_srvc_069r")
	
    End If
    
    If szTranID == "obpds_srvc_069r" Then
    
        g_SVCD_SRNO = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "SVC_SRNO" , 0)
	
        DATAMANAGER.SetDataValue(0, "obpds_srvc_072r" , "InBlock1" , "SVCD"          , 0 , "019")
        DATAMANAGER.SetDataValue(0, "obpds_srvc_072r" , "InBlock1" , "SVC_SRNO"      , 0 , g_SVCD_SRNO)
        DATAMANAGER.SetDataValue(0, "obpds_srvc_072r" , "InBlock1" , "CSNO"          , 0 , g_CSNO)
        DATAMANAGER.SetDataValue(0, "obpds_srvc_072r" , "InBlock1" , "ACNO"          , 0 , szData)
        DATAMANAGER.SetDataValue(0, "obpds_srvc_072r" , "InBlock1" , "CONT_CLS_CODE" , 0 , "")
        DATAMANAGER.RequestTranData("obpds_srvc_072r")
	
    End If
    
    If szTranID == "obpds_srvc_072r" Then
    
        CUST_T1_TACT_LIMT_AMT = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "T1_TACT_LIMT_AMT" , 0)
        CUST_D1_TACT_LIMT_AMT = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "D1_TACT_LIMT_AMT" , 0)
    
        tblTrans0.SetCellString(0, 1, CUST_T1_TACT_LIMT_AMT)
        tblTrans0.SetCellString(1, 1, CUST_D1_TACT_LIMT_AMT)

        DATAMANAGER.SetDataValue(0, "obrtp_comn_018r" , "InBlock1" , "ACNO"                    , 0 , szData)
        DATAMANAGER.SetDataValue(0, "obrtp_comn_018r" , "InBlock1" , "TACT_CLS_CODE"           , 0 , "00")
        DATAMANAGER.SetDataValue(0, "obrtp_comn_018r" , "InBlock1" , "ODER_CHAN_TYPE_CLS_CODE" , 0 , "020")
        DATAMANAGER.RequestTranData("obrtp_comn_018r")
    
    End If
    
    If szTranID == "obrtp_comn_018r" Then
    
        APLY_T1_TACT_LIMT_AMT = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "T1_TACT_LIMT_AMT" , 0)
        APLY_D1_TACT_LIMT_AMT = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "D1_TACT_LIMT_AMT" , 0)
	
        tblTrans.SetCellString(3, 1, APLY_T1_TACT_LIMT_AMT)
        tblTrans.SetCellString(4, 1, APLY_D1_TACT_LIMT_AMT)
		
		 If APLY_T1_TACT_LIMT_AMT == CUST_T1_TACT_LIMT_AMT then
			 ImageChk1.visible = "1"
			 tblTrans1.SetCellFgColor(0, 0, 146)
			 tblTrans1.SetCellFgColor(0, 1, 146)
		 elseIf APLY_T1_TACT_LIMT_AMT == SECU_T1_TACT_LIMT_AMT then
			 ImageChk3.visible = "1"
			 tblTrans0.SetCellFgColor(0, 0, 146)
			 tblTrans0.SetCellFgColor(0, 1, 146)
		 end if
		 
		 if APLY_D1_TACT_LIMT_AMT == CUST_D1_TACT_LIMT_AMT then
			 ImageChk2.visible = "1"
			 tblTrans1.SetCellFgColor(1, 0, 146)
			 tblTrans1.SetCellFgColor(1, 1, 146)
		 elseif APLY_D1_TACT_LIMT_AMT == SECU_D1_TACT_LIMT_AMT then
			 ImageChk4.visible = "1"
			 tblTrans0.SetCellFgColor(1, 0, 146)
			 tblTrans0.SetCellFgColor(1, 1, 146)
		 end if
        DATAMANAGER.SetDataValue(0, "obrtp_comn_017r" , "InBlock1" , "RCPY_DATE"               , 0 , "00000000") '서비스에서 거래일자 자동세팅
        DATAMANAGER.SetDataValue(0, "obrtp_comn_017r" , "InBlock1" , "ACNO"                    , 0 , szData) 
        DATAMANAGER.SetDataValue(0, "obrtp_comn_017r" , "InBlock1" , "ODER_CHAN_TYPE_CLS_CODE" , 0 , "020") 
        DATAMANAGER.RequestTranData("obrtp_comn_017r")
	
    End If
    
    If szTranID == "obrtp_comn_017r" Then
    
        TR_AMT = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_AMT" , 0)
        RMNN_AMT = APLY_D1_TACT_LIMT_AMT - TR_AMT
	
        tblTrans.SetCellString(0, 1, RMNN_AMT)
	
    End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	szSubErr = Trim(DATAMANAGER.GetDataMsgSubText( szTranID ))
	
	If szSubErr <> "" And szSubErr <> Null Then
		szErrMsg = szErrMsg.."("..szSubErr..")"
	End If

	Form.MsgBox( "알림", szErrMsg, "", 6 )
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnFlip_OnClick()
	if g_bFlipFlag == false then
		g_bFlipFlag = true
		lblWhite.visible = "0"
		imgFlip.imgpath = "icon_arrow_up"
	else
		g_bFlipFlag = false
		lblWhite.visible = "1"
		imgFlip.imgpath = "icon_arrow_down"
	end if
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

    If sKey == "&LOGIN_AUTH" Then
        
        If sValue == "0" Or sValue == "1" Then
            Form.CloseForm()
        End If
    
    End If

End Sub


	</SCRIPT_INFO>
