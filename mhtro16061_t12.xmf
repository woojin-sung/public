		<LABEL name="lblstart" visible="0" fontsize="-3" mask="1,0,,,1,####.##.##,0,1,1,0,0" halign="1" ly_vert="6,256,84,15,0" />
		<LABEL name="lblend" visible="0" fontsize="-3" mask="1,0,,,1,####.##.##,0,1,1,0,0" halign="1" ly_vert="97,256,84,16,0" />
