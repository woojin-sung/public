		<CHKBUTTON name="chkRepay" visible="0" fontsize="-1" chkcaption="전액상환" unchkcaption="전액상환" chkbtnimage="checkmenu_o.png" unchkbtnimage="checkmenu_n.png" ly_vert="10,280,90,24,0" />
