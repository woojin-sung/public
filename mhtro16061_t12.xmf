	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "SVCD" 			, 0 , "081")
		
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ACNO" 			, 0 , Form.GetTopCtlProp("acnt", "total"))
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ASNO" 			, 0 , Form.GetTopCtlProp("acnt", "sequence"))
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "RMND_SRNO" 		, 0 , " ")
	
	DATAMANAGER.RequestTranData("obpds_srvc_323r")
	

End Function

'============================================================================
' 고시환율 조회 서비스 호출
