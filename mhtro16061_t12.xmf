Sub chkRepay_OnChange(sCheckState)
	if sCheckState == "1" then
		Form.MsgBox("안내", "전액상환방식을 선택시,\n매도금액의 97%는 대출금을 상환합니다.", "CHECK_REPAY", 6)
	end if
End Sub

'============================================================================
' Apply_Balance_ReturnData : 잔고팝업에서 리턴된 값 적용
'============================================================================
Function Apply_Balance_ReturnData(szRet)
	
	'-----------------------------------------------------------
	'szRet  = [0]:구분명
	'    	 [1]:종목명
	'		 [2]:종목코드 
	'		 [3]:시장구분코드(4자리)
	'		 [4]:매도가능수량
	'		 [5]:대출일자
	'		 [6]:대출구분코드
	'		 [7]:대출일련번호
	'-----------------------------------------------------------
	tData = Split(szRet, "★")

	if UBound(tData) > 0 then
	
		'============================================================================
		' 선택한 종목 종목코드/종목명 전달
		'============================================================================
		szMkCd = Transform_Exid(tData(3))
		Form.triggerEvent("#", "16100_BALANCE", szMkCd & "@" & tData(2) & "★" & tData(1))

		'============================================================================
		' 매도가능 수량 세팅
		' 수량세팅 우선순위 : 자동입력 설정값 > 리턴 데이터값
		'============================================================================
		szQty = tData(4)	
		edtQty.caption = szQty
		
		'============================================================================
		' 가격은 종목변경 후, 가격입력설정대로 세팅
		'============================================================================
		'edtPrc.caption = ""
		
		'============================================================================
		' 현금/대출 구분에 따른 주문창 세팅
		'============================================================================
		gLoanType = tData(6)
			
		'-----------------------------------------------------------
		' 대출종목
		'-----------------------------------------------------------
		if gLoanType <> "0000" then
		
			'-----------------------------------------------------------
			' 잔고팝업에서 리턴된 대출정보가 있는지 여부 세팅
			'-----------------------------------------------------------
			gReturnLoanData = true
			
			'-----------------------------------------------------------
			'대출탭으로 변경
			'-----------------------------------------------------------
			rdoGbn.currentindex = 1
			
			'-----------------------------------------------------------
			'대출일자 세팅
			'-----------------------------------------------------------
			gLoanDate = tData(5)
			LabelLoanName.visible = true
			LabelLoanDate.caption = gLoanDate
			
			'-----------------------------------------------------------
			'대출일련번호
			'-----------------------------------------------------------
			gLoanSrno = tData(7)
			LabelLoanSrno.caption = gLoanSrno
			
			'if gLoanSrno == "0251" then
			'	cmbCredit0.currentindex = 0
			'end if
		
		'-----------------------------------------------------------
		' 일반종목 (gLoanType : 0000 = 일반종목)
		'-----------------------------------------------------------
		else
			
			'-------------------------------------------------------------------------------------
			'대출정보 클리어
			'------------------------------------------------------------------------------------
			'여기서 클리어해주지 않으면 잔고에서 대출종목 선택한 후에 다시 일반종목으로 선택했을때
			'현금/신용 라디오버튼 변경하면 이전 종목의 대출정보가 남아있음
			gLoanDate = ""
			LabelLoanDate.caption = ""
			gLoanSrno = ""
			LabelLoanSrno.caption = ""
			
			rdoGbn.currentindex = 0
			
		end if
		
		'---------------------------------------------------------------------------------------
		' 20240715 종목 미변경 시, 주문유형 유지를 위해 주석 처리 주문유형 보통(지정가)로 초기화
		'---------------------------------------------------------------------------------------
		'cmbType.currentindex = "0"
		
	end if
	
	
End Function	

'============================================================================
' 거래소코드(4자리) <- 거래명(2자리)
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "0104" then	  ' 홍콩
		return "HK"
	elseif sValue == "0215" then ' 상해
		return "SH"
	elseif sValue == "0214" then ' 심천
		return "SZ"
	elseif sValue == "0321" then ' 뉴욕
		return "NY"
	elseif sValue == "0066" then ' 아멕스
		return "AX"
	elseif sValue == "0537" then ' 나스닥
		return "OQ"
	elseif sValue == "0106" then ' 도쿄
		return "JP"
	end if
end Function

'============================================================================
Sub btnPrderPricePopup_OnClick()
	
	Dim szData
	szData = ""
	
	szData = "1"												'매수(2)/매도(1)구분값
	szData = szData & "★" & Form.GetTopCtlProp("acnt", "total") 	'종합계좌(8자리)
	szData = szData & "★" & Form.GetTopCtlProp("acnt", "sequence") '계좌일련번호(2자리)
	
	sCodeData = Split(g_szCd, "@")
	
	if #sCodeData > 0 then
		szData = szData & "★" & sCodeData[1] 					'종목코드(티커)
	else
		szData = szData & "★" & "" 
	end if
	
	szData = szData & "★" & g_szMk 							'거래소코드(4자리)
	
	szCashCreditGubun = rdoGbn.currentindex
	szData = szData & "★" & szCashCreditGubun					'현금(0)/대출(1)구분
	
	szData = szData & "★" & edtPrc.caption  					'입력가격
	szData = szData & "★" & edtQty.caption						'입력수량
	szData = szData & "★" & g_szDecimal							'소수점자리수
	szData = szData & "★" & g_szCurrency						'통화
	szData = szData & "★" & "1"								'일반(1)/신용합산(2)
	
	szData = szData & "★" & "0251"								'대출상세유형코드(예탁담보:0251)
	szData = szData & "★" & LabelLoanDate.caption				'대출일자
	szData = szData & "★" & LabelLoanSrno.caption				'대출일련번호
	
	if chkRepay.checkstate == "1" then
		szData = szData & "★" & "Y"								'전액상환여부
	else
		szData = szData & "★" & "N"								'전액상환여부
	end if
	
	Form.OpenPopupAnimation("mhtro16100_p13", szData, "", "2")

	
End Sub

