	if szTranID == "obtro_oder_112a" then
		
		g_szTR = szTranID
		szPrc = edtPrc.caption
		
		sCodeData = Split(g_szCd, "@")
		DATAMANAGER.ClearInputData(0, "obtro_oder_112a")

		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ACNO"				, 0 , Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ASNO"				, 0 , Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ACNT_PWD"			, 0 , Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "OVRS_STCK_SYMB_ISCD"	, 0 , sCodeData[1])							' 종목코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "OVRS_EXCH_VNDR_IDNO"	, 0 , g_szMk)									' 거래소코드	
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "SELN_BYOV_CLCD"		, 0 , "1")									' 매도/매수구분코드
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "RSEV_ASPR_TPCD"		, 0,  Check_OrdCond())			' 주문구분코드
'		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_CLS_CODE"		, 0 , Check_OrdType())							' 주문구분코드
'		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_COND_CLS_CODE"	, 0 , Check_OrdCond())							' 주문조건구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODQT"				, 0 , edtQty.caption)							' 주문수량
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "OVRS_STCK_ODER_PRC"	, 0 , szPrc)									' 주문단가
'		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0 , "01")									' 주문발생유형코드(01:일반주문)
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "WARN_CNFR_YN"		, 0 , g_szWarnFlag)
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_GRP_NO"			, 0, "0")			' 주문그룹번호
		
		'해외주식 예약 
		if Label0.caption = "일반예약" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_RSEV_CLS_CODE" , 0, "1")								'예약구분 1: 일반예약 2: 기간잔량 3: 기간예약 4: 특정일주문
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_RSEV_HOUR_CLCD", 0, lblgubn.caption)
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_STA_DATE", 0, Form.GetSharedData("&HOST_DATE", false))
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_FIN_DATE", 0, Form.GetSharedData("&HOST_DATE", false))
		elseif Label0.caption = "기간잔량" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_RSEV_CLS_CODE", 0, "2")
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_RSEV_HOUR_CLCD", 0, lblgubn.caption)
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_STA_DATE", 0, lblstart.caption)
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_FIN_DATE", 0, lblend.caption)
		elseif Label0.caption = "기간예약" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_RSEV_CLS_CODE", 0, "3")
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_RSEV_HOUR_CLCD", 0, lblgubn.caption)
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_STA_DATE", 0, lblstart.caption)
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_FIN_DATE", 0, lblend.caption)
		elseif Label0.caption = "특정일주문" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_RSEV_CLS_CODE", 0, "4")
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_RSEV_HOUR_CLCD", 0, lblgubn.caption)
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_STA_DATE", 0, lblstart.caption)
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_FIN_DATE", 0, lblstart.caption)
		end if
		
		'20201021 LES START 해외주식 매도상환
		'신용주문일때
		if rdoGbn.currentindex == "1" or rdoGbn.currentindex == 1 then
			sLoanSrno = LabelLoanSrno.caption
			sLoanDate = LabelLoanDate.caption
			
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "LOAN_ODER_CLS_CODE" 	, 0 , "03")
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "SVC_CLS_CODE" 		, 0 , "203")
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "LOAN_DATE" 			, 0 , sLoanDate)
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "LOAN_SRNO" 			, 0 , sLoanSrno)
			
			if chkRepay.checkstate = "1" then
				DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "UI_WHOL_AMT_RDMP_YN" 	, 0 , "Y")
			else
				DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "UI_WHOL_AMT_RDMP_YN" 	, 0 , "N")
			end if
			
		end if
		'20201021 LES END
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'==========================================================================
	'해외주식 매수주문 
	'==========================================================================
	if szTranID == "obtro_oder_112a" then
	
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0) '경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
	
		'--------------------------------
		' 경고
		'--------------------------------
		if szWarnCd = "1" then							
		
			Open_ConfirmPopup(szWarnMsg)
		
		'--------------------------------
		' 보류(해외주식 제외)
		'--------------------------------
		elseif szWarnCd = "2" then						'
			
			g_szTR = ""
		
		'--------------------------------
		' 해외주식 미국PTP 종목과세관련
		'--------------------------------
		elseif szWarnCd = "3" then
			
			szData = "1" & "|" & szWarnMsg	' 매매구분|메시지
			'Form.OpenPopup("mhtro16060_p15", szData , "")	'OnPopupReturn -> "PTP주문경고"
			Form.OpenPopupAnimation("mhtro16100_p15", szData, "", "2")
			
		'--------------------------------
		' 정상주문 처리
		'--------------------------------
		else
		
			g_szTR = ""
				
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
	
			'-----------------------------
			' 정상주문
			'-----------------------------
			if Trim(szOrdCd) == "0001" or Trim(szOrdCd) == "5620" then	
				
				'-----------------------------
				'매도가능수량 재조회
				'주문전송 후 가능수량 재조회 후 
				'매도수량 자동입력이 "보유잔고수량"으로 설정되어있어도,
				'"주문전송 후 초기화" 설정이 활성화 되어있으면 수량입력창에 자동입력되지 않도록
				'g_AfterOrdAbleReq을 true로 변경
				'-----------------------------
				g_AfterOrdAbleReq = true
				Request_Able()
				
				'-----------------------------
				' 주문후 초기화
				'-----------------------------
				if g_szAfterInit == "1" then		
					Reset_AfterOrd()
				end if
				
				'-----------------------------
				' 주문번호 연동
				'-----------------------------
				if g_szAfterOrg == "1" then			
					szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
					Form.triggerEvent("#", "AfterOrd", szOrgNo)
				end if
				
				'-----------------------------
				' 주문처리 메시지 출력
				'-----------------------------
				Form.Toast(0, szOrdMsg, true)
				
					
			end if
			
		end if
	
	
	'==========================================================================
	'통합증거금 약정조회
	'==========================================================================
	elseif szTranID == "obpds_srvc_323r" then
	
		'------------------------------------------------------------------------------------
		'SVCD 값이 0이면, 통합증거금 미약정 계좌
		'------------------------------------------------------------------------------------
		g_TotalReqComplete = true
		
		szCnt = DATAMANAGER.GetDataValue(0, "obpds_srvc_323r" , "OutBlock1" , "SVC_SRNO" , 0)
		
		if Cint(szCnt) <> 0 then
			gTotalYN = true
		else
			gTotalYN = false
		end if
		
		'------------------------------------------------------------------------------------
		' ★ [계좌변경 시] 매도가능수량 재조회
		'------------------------------------------------------------------------------------
		Request_Able()
	
	'==========================================================================
	'통화별 환율조회
	'==========================================================================
	elseif szTranID == "obtro_comn_025r" then
	
		szAnncExrt = DATAMANAGER.GetDataValue( 0, "obtro_comn_025r", "OutBlock1", "ANNC_EXRT" , 0 )	' 고시환율
		
		'엔화일때만 환율 4자리 표기 그외에는 2자리 표기
		if g_szCurrency == "JPY" then
			LabelExchangeRateMaskData = "0,1,환율 ," .."".. ",0,,4,1,1,0,0"
		else
			LabelExchangeRateMaskData = "0,1,환율 ," .."".. ",0,,2,1,1,0,0"	
		end if
		
		LabelExchangeRate.mask = LabelExchangeRateMaskData
		LabelExchangeRate.caption = szAnncExrt
		
		'수량/가격 자동입력 설정 시
		'환율조회가 되기 전, 주문금액 가계산이 진행된 경우 
		'원화금액이 빈값으로 나올 수 있어 환율 조회 이후에 다시 한번 주문금액 계산
		Calc_OrderPrice()
		
	
	'==========================================================================
	'매도가능수량 조회 Complete
	'==========================================================================
	elseif szTranID == "obtro_oder_264r" then
	
		'---------------------------------------------------------
		' 현금/대출 구분
		'---------------------------------------------------------
		szCashCreditGubun = rdoGbn.currentindex
		
		'---------------------------------------------------------
		'[대출] 매도 가능수량
		'---------------------------------------------------------
		if szCashCreditGubun == 1 or szCashCreditGubun == "1" then
			
			sOrdAbleQty 		= DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "LOAN_SELN_RDMP_ABLE_QTY" 	, 0)
			sInputCode 		= DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "OVRS_STCK_SYMB_ISCD" 		, 0)
			sInputMarket		= DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "OVRS_STCK_EXCH_IDNO" 		, 0)
			
			if sInputCode <> "" and sInputMarket <> "" then
				
				sInputData = sInputMarket & "@" & sInputCode
				
				if g_szCd ==  sInputData then
					LabelCashAbleQty.caption = sOrdAbleQty
				end if
				
			else
				LabelCashAbleQty.caption = sOrdAbleQty
			end if
		
		'---------------------------------------------------------
		'[현금] 매도 가능수량
		'---------------------------------------------------------
		else
			sOrdAbleQty 		= DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "ODER_ABLE_QTY"			 	, 0)
			sInputCode 		= DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "OVRS_STCK_SYMB_ISCD" 		, 0)
			sInputMarket		= DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "OVRS_STCK_EXCH_IDNO" 		, 0)
			
			if sInputCode <> "" and sInputMarket <> "" then
			
				sInputData = sInputMarket & "@" & sInputCode
				
				if g_szCd ==  sInputData then
					LabelCashAbleQty.caption = sOrdAbleQty
				end if
				
			else	
				LabelCashAbleQty.caption = sOrdAbleQty
			end if
			
		end if
		
		'---------------------------------------------------------
		' 매도수량 자동입력(보유잔고수량인 경우 수량 자동입력)
		'---------------------------------------------------------
		if g_szChangeInit <> "1" and  g_szSellQty == "1" then	
			
			'주문전송 후 가능수량 재조회 시에는
			'수량이 자동입력 안되도록 막음.
			if g_AfterOrdAbleReq <> true then
				edtQty.caption = sOrdAbleQty
				Calc_OrderPrice()
			end if
			
		end if
		
		g_AfterOrdAbleReq = false
		
	
	end if
	
	'해외주식 주문착오 방지
	g_szWarnFlag = "N"	
	
End Sub

'============================================================================
' 서비스 오류처리
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	'------------------------------------------------------------------
	' 주문가능수량 조회/고시환율 조회 에러메시지는 스킵처리
	'------------------------------------------------------------------
	if szTranID == "obtro_oder_264r" then
		LabelCashAbleQty.caption = ""
		Exit Sub
	elseif szTranID == "obtro_comn_025r" then
		Exit Sub
	end if
	'------------------------------------------------------------------
	
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	'------------------------------------------------------------------
	' 해외ETP 미약정 고객
	'------------------------------------------------------------------
	if szErrCode == "6207" then
		
		Form.MsgBox("안내", "해외ETP 거래 미신청 계좌 입니다.\n해당 화면으로 이동하시겠습니까?", "ETP_MSG", 7, "거래신청하기","취소")
	
	'------------------------------------------------------------------
	' 대출주문 대출일자/대출일련번호 미입력 시
	'------------------------------------------------------------------
	elseif szErrCode == "1256" or szErrCode == "1258" then
		
		Form.MsgBox("안내", "대출일자 선택 후 주문이 가능해요.\n잔고에서 매도할 종목 선택 후 매도를 진행해주세요.", "CEHCK_LOAN_DATE", 6)
	
	'------------------------------------------------------------------
	' 그외
	'------------------------------------------------------------------
	else
		if Trim(szSubMsg) <> "" then
			Form.ShowAlert(g_szTitle, szErrMsg & "\n(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szTitle, szErrMsg)
		end if
	end if
	
End Sub

'============================================================================
' 메시지박스 리턴
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

	if sKeyName == "ETP_MSG" then
		
		if sRet == "ok" then
			
			'계좌번호
			szAcnt = Form.GetTopCtlProp("acnt", "caption")
			Form.OpenScreen("87051" , szAcnt)
			
		end if
	
	elseif sKeyName = "MARKET_ORDER_NOTICE" then
	
		if sRet <> "ok" then
		
			Form.SetEnvData(1,"OrdNotice_16061", "1")
		
		end if
	
	end if
	
End Sub

'============================================================================
' btnBuy_OnClick : 매수버튼 클릭
'============================================================================
Sub btnBuy_OnClick()
	
	if Check_InputData("Order") == true then
		'팝업화면으로 보낼데이터 세팅 거래소벤더★주문유형
		szData = g_szMk & "★" & cmbType.cbkeydata & "★"
		Form.OpenPopupAnimation("mhtro16061_p5", szData , "", "2")
		
'		' 주문확인창 오픈여부
'		if g_szOdrPop == "1" then
'			Open_ConfirmPopup("")
'		else
'			Request_Order()
'		end if
		
	end if
	
End Sub

'============================================================================
' 주문전송 전 입력값 정합성 검증
'============================================================================
Function Check_InputData(sGubun)
	
	
	if sGubun == "Order" then
		
		'계좌번호
		szAcnt = Form.GetTopCtlProp("acnt", "caption")
		If Len(szAcnt) < 10 Then
			Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
			return False
		End If
		
		'계좌비밀번호
		szPwd = Form.GetTopCtlProp("edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.triggerEvent("#", "ShowPasswordKeyPad", "")
			return False
		end if
		
		'종목코드
		if Trim(g_szCd) == "" then
			Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
			return false
		end if
		
		'수량
		if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
			Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
			return false
		end if
		
		'가격
		if Trim(edtPrc.caption) == "" or Trim(edtPrc.caption) == "0" then
		
			'시장가/지정가 확인
			if Check_PrcOrd() <> "시장가" then
				Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
				return false
			end if
		end if
		
		'대출일자/대출일련번호
		szCLS = rdoGbn.currentindex
		if szCLS == 1 or szCLS == "1" then
			
			szLoanDate = LabelLoanDate.caption
			szLoanSrno = LabelLoanSrno.caption
			
			if szLoanDate == "" or szLoanSrno == "" then
				Form.ShowAlert("안내", "대출일자 선택 후 주문이 가능해요.\n잔고에서 매도할 종목 선택 후 매도를 진행해주세요.")
				return false
			end if
			
		end if
		
		return true
		
	end if
	
End Function

'============================================================================
' 주문확인창/경고팝업 오픈
'============================================================================
Function Open_ConfirmPopup(szWarn)
	
	Dim szData, szOrdNm, szOrdGubun,szPrcOrd
	
	'주문유형명
	szOrdNm = Check_OrdName()
	
	'현금/대출구분
	szOrdGubun = rdoGbn.currentindex
	
	'시장가/지정가
	szPrcOrdNm = Check_PrcOrd()
	
	sCodeData = Split(g_szCd, "@")
	szData = "11"													' 매매구분
	szData = szData & "|" & Form.GetTopCtlProp("acnt", "caption")		' 계좌번호
	szData = szData & "|" & Form.GetTopCtlProp("acnt", "accountname")	' 계좌명
	szData = szData & "|" & sCodeData[1]								' 종목코드
	szData = szData & "|" & g_szKorName								' 종목명
	szData = szData & "|" & szOrdNm									' 주문구분
	szData = szData & "|" & szOrdGubun								' 현금(0:현금/1:대출)
	szData = szData & "|" & edtQty.caption							' 주문수량
	szData = szData & "|" & edtPrc.caption							' 주문가격
	szData = szData & "|" & ""										' 원주문번호
	szData = szData & "|" & ""										' 전량전부
	szData = szData & "|" & g_szDecimal								' 가격자릿수
	szData = szData & "|" & g_szCurrency								' 통화기호
	szData = szData & "|" & szPrcOrdNm								' 시장가or지정가
	
	'대출관련 추가 정보
	szData = szData & "|" & gLoanType 								' 대출구분
	szData = szData & "|" & gLoanDate 								' 대출일자
	szData = szData & "|" & gLoanSrno 								' 대출일련번호
	
	szType = Label0.caption
	szData = szData & "|" & Label0.caption									' 예약주문유형
	if szType = "일반예약" then
		szData = szData & "|" & ""
	elseif szType = "특정일주문" then
		szData = szData & "|" & lblstart.dispcaption							' 예약기간
	else
		szData = szData & "|" & lblstart.dispcaption & "~" & lblend.dispcaption	' 예약기간
	end if
	
	szData = szData & "|" & lblgubnStr.caption								' 예약주문시간구분
	'----------------------------------------------------
	' 경고팝업 오픈
	'----------------------------------------------------
	if Trim(szWarn) <> "" then		
		
		'경고메세지 추가	
		szData = szData & "|" & szWarn			
		Form.OpenPopupAnimation("mhtro16100_p8", szData , "", "2")
	
	'----------------------------------------------------
	' 주문확인팝업 오픈
	'----------------------------------------------------
	else					
		Form.OpenPopupAnimation("mhtro16100_p4", szData , "", "2")
		
	end if
	
End Function

'============================================================================
' 주문유형코드
'============================================================================
Function Check_OrdType()
	
	Dim szIdx
	szIdx = CStr(cmbType.currentindex)
	
	Select Case szIdx
		Case "0"
			return "01" '지정가
		Case "1"
			return "05" '시장가
'		Case "2" 
'			return "31" 'LOO
		Case "2"
			return "32" 'LOC
'		Case "4"
'			return "33" 'MOO
		Case "3"
			return "34" 'MOC
		Case "4"
			return "37" 'VWAP
		Case "5"
			return "38" 'TWAP
		Case "6"
			return "35" 'Limit VWAP
		Case "7"
			return "36" 'Limit TWAP
	End Select
	
End Function
'============================================================================
' 주문조건구분코드
'============================================================================
Function Check_OrdCond()
	
	Dim szIdx
	szIdx = Check_OrdType()
	
	Select Case szIdx
		Case "01"
			return "1" '지정가
		Case "05"
			return "2" '시장가
		Case "31"
			return "4" 'LOO
		Case "32"
			return "5" 'LOC
		Case "33"
			return "6" 'MOO
		Case "34"
			return "7" 'MOC
		Case "35"
			return "8" 'Limit VWAP
		Case "36"
			return "9" 'Limit TWAP
		Case "37"
			return "A" 'VWAP
		Case "38"
			return "B" 'TWAP
	End Select
	
End Function

'============================================================================
' 주문유형명 가져오기
'============================================================================
Function Check_OrdName()
	
	Dim szIdx
	szIdx = Check_OrdType()
	
	Select Case szIdx
		Case "01"
			return "보통(지정가)"
		Case "05"
			return "시장가"
		Case "31"
			return "LOO(장개시지정가)" 
		Case "32"
			return "LOC(장마감지정가)" 
		Case "33"
			return "MOO(장개시시장가)" 
		Case "34"
			return "MOC(장마감시장가)" 
		Case "35"
			return "Limit VWAP(가격제한수량분할)" 
		Case "36"
			return "Limit TWAP(가격제한시간분할)" 
		Case "37"
			return "VWAP(수량분할)" 
		Case "38"
			return "TWAP(시간분할)" 
	End Select
	
End Function

'============================================================================
' Check_PrcOrd 지정가/시장가 구분
'============================================================================
Function Check_PrcOrd()
	
	Dim szIdx
	szIdx = Check_OrdType()
	
	if szIdx == "05" or szIdx == "33" or szIdx == "34" or szIdx == "37" or szIdx == "38" then
		return "시장가"
	else
		return "지정가"
	end if
	
End Function

'============================================================================
' 주문전송
'============================================================================
Function Request_Order()
	
	'------------------------
	' 해외주식 주문착오 방지
	'------------------------
	g_szWarnFlag	= "N"
	
	'----------------------------------
	' 현금/대출 구분 & 주문서비스 호출
	'----------------------------------
'	szCLS = rdoGbn.currentindex
'	
'	if szCLS == "0" or szCLS == 0 then
		DATAMANAGER.RequestTranData("obtro_oder_112a")
'	else
'		DATAMANAGER.RequestTranData("obtro_oder_150a")
'	end if
	
End Function

'============================================================================
' 팝업창 리턴처리
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	' ----------------------------------------------------------------------
	' (사용)해외주식 주문착오 방지 (경고팝업에서 리턴)
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end if	
	
	' ----------------------------------------------------------------------
	' (사용)PTP경고팝업에서 리턴 (20221206_01 KBC START : 해외주식 미국PTP 종목과세관련)
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PTP주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end if		
	
	' ----------------------------------------------------------------------
	' (사용)주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	
	' ----------------------------------------------------------------------
	' (미사용)수량/금액입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		edtQty_OnEditComplete()
		
		 btnCash.btnimage = "btn_02.9.png"
		 btnMax.btnimage  = "btn_02.9.png"
			
	' ----------------------------------------------------------------------
	' (미사용)가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then		
		edtPrc.caption = sRet		
		edtPrc_OnEditComplete()
	
	' ----------------------------------------------------------------------
	' (사용)가격/수량 입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "InputKeyPad" then
		
		arrData = Split(sRet,"★")
		edtPrc.caption = arrData(0)	
		edtQty.caption = arrData(1)	
		Calc_OrderPrice()
		
	'----------------------------------------------------------------------
	' (사용)잔고화면(16100_pb)에서 선택 종목정보 전달
	'----------------------------------------------------------------------
	elseif sKeyName == "16100_BALANCE" then
	
		if sRet == "" then
			Exit Sub
		end if
		
		gReturnQty = true
		Apply_Balance_ReturnData(sRet)
	
	'----------------------------------------------------------------------
	' (미사용)20210329 LES START 통합증거금 - 수량조회팝업 리턴
	'----------------------------------------------------------------------
	elseif sKeyName == "16060_p8" then
		edtQty.caption = sRet
		edtQty_OnEditComplete()
	
	' ----------------------------------------------------------------------
	' (사용) 기간예약창에서 리턴
	' ----------------------------------------------------------------------
	elseif sKeyName = "Range" then
		
		'예약구분★시작일자★종료일자★시간구분
		tData = Split(sRet, "★")
		If UBound(tData) > 0 then
		
			Dim szGubun
'			0`장개시
'			3`장개시 30분 후
'			1`장마감 10분 전
'			2`장마감 30분 전
			szGubun = tData(3)
			Select Case szGubun
			Case "0"
				szGubun = "장개시"
			Case "1"
				szGubun = "장마감 10분 전"
			Case "2"
				szGubun = "장마감 30분 전"
			Case "3"
				szGubun = "장개시 30분 후"
			End Select
			
			if tData(0) == "0" then
				Label0.caption = "일반예약"
				lblstart.caption = tData(1)
				lblend.caption = tData(2)
				lblgubn.caption = tData(3)
				lblgubnStr.caption = szGubun

			elseif tData(0) == "1" then
				Label0.caption = "기간잔량"
				lblstart.caption = tData(1)
				lblend.caption = tData(2)
				lblgubn.caption = tData(3)
				lblgubnStr.caption = szGubun

			elseif tData(0) == "2" then
				Label0.caption = "기간예약"
				lblstart.caption = tData(1)
				lblend.caption = tData(2)
				lblgubn.caption = tData(3)
				lblgubnStr.caption = szGubun

			elseif tData(0) == "3" then
				Label0.caption = "특정일주문"
				lblstart.caption = tData(1)
				lblend.caption = tData(2)
				lblgubn.caption = tData(3)
				lblgubnStr.caption = szGubun

			end if
			
			
			' 주문확인창 오픈여부
			if g_szOdrPop == "1" then
				Open_ConfirmPopup("")
			else
				Request_Order()
			end if
		end if
		
	end if
	
End Sub

'============================================================================
' 매도가능수량 조회
'============================================================================
Function Request_Able()	

	g_szWarnFlag = "N"
	
	if g_szCd == "" then
		Exit Function
	end if
	
	DATAMANAGER.ClearInputData(0, "obtro_oder_264r")
	DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IQRY_CLS_CODE" 		, 0 , "1")
	DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ACNO" 				, 0 , Form.GetTopCtlProp("acnt", "total"))
	DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ASNO" 				, 0 , Form.GetTopCtlProp("acnt", "sequence"))
	
	sCodeData = Split(g_szCd, "@")
	DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_STCK_SYMB_ISCD" 	, 0 , sCodeData[1])
	
	DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_EXCH_VNDR_IDNO" 	, 0 , g_szMk)
	DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "SELN_BYOV_CLCD" 		, 0 , "1")
	DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ODER_CRNC_PRC" 		, 0 , edtPrc.caption)
	
	if gTotalYN == true then
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IF_INTG_MARG_IQRY_YN"	, 0 , "Y")
	else
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IF_INTG_MARG_IQRY_YN"	, 0 , "N")
	end if
	
	'---------------------------------------------------------------------------
	'대출탭에 있는 경우 대출상세유형 코드(예탁담보:0251)를 넘겨줌.
	'수량조회 시, 합산수량으로 조회되어 대출일자/일련번호는 넘겨줄 필요없음.
	'---------------------------------------------------------------------------
	szCashCreditGubun = rdoGbn.currentindex
	
	if szCashCreditGubun == 1 or szCashCreditGubun == "1" then
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "LOAN_DTL_TYPE_CODE" 	, 0 , "0251")
	end if
	'---------------------------------------------------------------------------
	
	DATAMANAGER.RequestTranData("obtro_oder_264r")	
	
End Function

