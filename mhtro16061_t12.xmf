	<SCRIPT_INFO _len="93183" _ulen="82617" >

Dim g_szOdrPop
Dim g_szAfterInit
Dim g_szChangeInit
Dim g_szSellQty, g_szSellQtyCnt 
Dim g_szAfterOrg

Dim g_szCd, g_szMk, g_szNg	' 종목코드, 거래소코드, 국가코드
g_szCd = ""
g_szMk = ""
g_szNg = ""

Dim	g_szWarnFlag			' 주문 경고 확인플래그
g_szWarnFlag	= "N"

Dim g_szTR
g_szTR = ""

Dim g_szTitle
g_szTitle = "알림"

Dim g_szOrdSize		' 매매단위
g_szOrdSize = ""

Dim g_szCurPrice		' 현재가
g_szCurPrice = ""

Dim g_szUpLimit		' 상한가
g_szUpLimit =  ""

Dim g_szDnLimit		' 하한가
g_szDnLimit =  ""

Dim g_szUnit			' 호가단위
g_szUnit =  ""

Dim g_szDecimal		' 종목가격 자릿수
g_szDecimal =  ""

Dim g_szKorName		' 한글종목명
g_szKorName =  ""

Dim g_szTickType		' 종목틱타입
g_szTickType =  ""

Dim g_szCurrency		' 통화
g_szCurrency = ""

Dim g_szCashNT		' 통합증거금 조회구분(N:일반 / T:통합)
g_szCashNT = ""

Dim gLoanType			' 대출구분
gLoanType = ""

Dim gLoanDate 		' 대출일자
gLoanDate = ""

Dim gLoanSrno 		' 대출일련번호
gLoanSrno = ""

Dim gReturnQty		' 잔고팝업에서 리턴된 수량이 있는지 여부
gReturnQty = false

Dim gReturnLoanData	' 잔고팝업에서 리턴된 대출정보가 있는지 여부
gReturnLoanData = false

Dim gTotalYN			' 통합증거금 약정여부
gTotalYN = false

Dim g_TotalReqComplete	' 통합증거금 조회완료 여부
g_TotalReqComplete = false

Dim g_AfterOrdAbleReq	' 주문전송 후 가능수량 재조회 여부
g_AfterOrdAbleReq = false

Dim gSettingSelectPrice	' 현재가 화면에서 연동된 가격이 있는지 여부
gSettingSelectPrice = false

Dim gSettingSelectPriceForAutoPrice '20240729
gSettingSelectPriceForAutoPrice = false

Dim gAlReadyCallAutoPrice '20240729
gAlReadyCallAutoPrice = false

Dim gOsType
Dim gMaxLen
gMaxLen = 12

'============================================================================
Sub Form_OnFormInitBefore()

	'--------------------------------------------------
	' 매체구분
	'--------------------------------------------------
	gOsType = Form.GetSharedData("&OS_TYPE", false)
	
	'--------------------------------------------------
	'이미지 찌그러짐 방지 API
	'--------------------------------------------------
	imgInfo.setMaintainingRatio("1")
	
	'--------------------------------------------------
	'컨트롤 패딩값 조절
	'--------------------------------------------------
	lblOrderPrice.paddinginfo = "0,0,0,0"
	lblOrderPriceWon.paddinginfo = "0,0,0,0"

End Sub

'============================================================================
Sub Form_OnFormInit()
	
	'--------------------------------------------------
	'주문환경설정 값 Load
	'--------------------------------------------------
	Load_OrderSet()
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	'============================================================================
	' 종목정보 연동
	'============================================================================
	if sEventName == "SEND_ITEM_INFO" then
	
		'-----------------------------------------------------------------------------------------------
		'현재가★상한가★하한가★매매단위(매수)★통화★소수점자리수★한글종목명★틱타입★매매단위(매도)
		'-----------------------------------------------------------------------------------------------
		arrItemInfo = Split(sParam, "★")
		
		g_szCurPrice 	= arrItemInfo(0)
		g_szUpLimit	= arrItemInfo(1)
		g_szDnLimit	= arrItemInfo(2)
		g_szOrdSize 	= arrItemInfo(8)
		g_szCurrency	= arrItemInfo(4)
		g_szDecimal	= arrItemInfo(5)
		g_szKorName	= arrItemInfo(6)
		g_szTickType	= arrItemInfo(7)
		g_szUnit		= GetHogaUnit(g_szMk, g_szCurPrice, 0)
	
		'-----------------------------------------------------------------------
		'가격입력창 소수점 자리수 세팅 / 통화기호 세팅
		'-----------------------------------------------------------------------
		if g_szCurrency <> "" then
			sMask = "0,0,,".. " " .. g_szCurrency .. ",0,,"..g_szDecimal..",1,1,2,0"
		else
			sMask = "0,0,,,0,,"..g_szDecimal..",1,1,2,0"
		end if
		
		edtPrc.mask = sMask
		
		'-----------------------------------------------------------------------
		'수량입력창 매매단위 세팅
		'-----------------------------------------------------------------------
		if g_szOrdSize <> "" then
			edtQty.hintcaption = FormatNumber(g_szOrdSize,0).."주 단위"
		end if
		
		'-----------------------------------------------------------------------
		'주문금액 가계산 초기세팅
		'-----------------------------------------------------------------------
		if g_szCurrency <> "" then
			lblOrderPrice.caption = "- ".. g_szCurrency
			lblOrderPriceWon.caption = "- " .. "원"
		else
			lblOrderPrice.caption = "- "
			lblOrderPriceWon.caption = "- " .. "원"
		end if
		
		'-----------------------------------------------------------------------
		'종목/탭 변경시 가격입력창/수량입력창 입력값 초기화 
		'-----------------------------------------------------------------------
		if g_szChangeInit == "1" then
			Init_InputControl()
		end if
		
		'-----------------------------------------------------------------------
		'국가별 주문가능 주문유형 설정
		'-----------------------------------------------------------------------
		SetOrderTypeList(g_szNg)
		
		'-----------------------------------------------------------------------
		'통화별 환율 조회
		'-----------------------------------------------------------------------
		RequestExChangeRate()
	
	'============================================================================
	' 호가조회 완료(가격/수량 자동입력 요청)
	'============================================================================
	elseif sEventName == "HOGA_COMPLETE" then
	
		'---------------------------------------------------------------------------------
		' [금액 자동입력]
		'---------------------------------------------------------------------------------
		' 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅(위치변경 ChangeAcnt)
		' 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
		'---------------------------------------------------------------------------------
		'sPrice = Form.GetSharedData("PRICE", true)
		'
		'if sPrice <> "" and sPrice <> null	then
		'	edtPrc.caption = sPrice
		'	
		'else
			
			if g_szChangeInit <> "1" then
				RequestAutoPrice()
			end if
		
		'end if
		
		'---------------------------------------------------------------------------------
		' [수량 자동입력]
		'---------------------------------------------------------------------------------
		if g_szChangeInit <> "1" then
			RequestAutoQty()
		end if
		
		
	'============================================================================
	' 클릭 호가 연동
	'============================================================================
	elseif sEventName == "CLICK_HOGA" then
		'------------------------------------
		' 가격 에디트 활성화인 경우에만 연동
		'------------------------------------
		szEnable = edtPrc.enable
		if szEnable = "1" or szEnable = 1 then
			edtPrc.caption = sParam
			Calc_OrderPrice()
		end if
		
	'============================================================================
	' 종목코드 초기화/종목코드 변경/탭 변경
	'============================================================================
	elseif sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then
		
		'-------------------------------------------------------------------------
		'종목이 바뀐 경우
		'-------------------------------------------------------------------------
		if g_szCd <> sParam then
			g_szCd = sParam
			g_szNg = Form.GetItemCodeInfo(g_szCd, "ovsnation")	' 국가구분코드
			g_szMk = Form.GetItemCodeInfo(g_szCd, "exchid")		' 거래소벤더코드
			
			'---------------------------------------------------------------------------------
			'환율정보 라벨 클리어(이전 데이터 남아있어 깜빡임 방지)
			'---------------------------------------------------------------------------------
			LabelExchangeRate.caption = ""
			
			'---------------------------------------------------------------------------------
			'20240613 대출정보 클리어 (잔고팝업에서 넘어온 대출정보가 있는 경우 제외)
			'잔고팝업에서 발생한 리턴이벤트가 먼저 발생하여 선택한 대출종목 정보 세팅되있는 상태임.
			'---------------------------------------------------------------------------------
			'아 근데.. 대출잔고 보고 > 일반잔고로 종목변경하고 > 현금/신용 이동하면 대출정보 남아있네...
			'그러면.. 잔고팝업 리턴 이벤트에서 일반종목일 경우에 대출정보 클리어해주자
			'---------------------------------------------------------------------------------
			ClearLoanData()
			
			
			if sEventName == "ChangeTab" then
				
				'---------------------------------------------------------------------------------
				' [금액 자동입력]
				'---------------------------------------------------------------------------------
				' 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅
				' 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
				'---------------------------------------------------------------------------------
				'sPrice = Form.GetSharedData("PRICE", true)
				'
				'if sPrice <> "" and sPrice <> null	then
				'	edtPrc.caption = sPrice
					
				'else
					
					if g_szChangeInit <> "1" then
						RequestAutoPrice()
					end if
				
				'end if
				
				'---------------------------------------------------------------------------------
				' [수량 자동입력]
				'---------------------------------------------------------------------------------
				if g_szChangeInit <> "1" then
					RequestAutoQty()
				end if
				
			end if
			
			'---------------------------------------------------------------------
			'20240613매도가능수량 조회
			'미사용(0)이거나 수량입력(2)으로 설정되어있는 경우 여기서 조회
			'보유잔고수량(1) 인 경우 수량 자동입력가능 상태이면 => RequestAutoQty() 에서 Request_Able 호출
			'보유잔고수량(1) 이지만 수량 자동입력가능 상태가 아닌 경우 => 여기서 조회
			'---------------------------------------------------------------------
			if g_szSellQty <> "1" then
				Request_Able()
			else
				
				if g_szChangeInit == "1" then
					Request_Able()
				end if
			
			end if
			
		'-------------------------------------------------------------------------
		'종목이 안바뀐 경우
		'-------------------------------------------------------------------------
		else
			
			'---------------------------------------------------------------------------------
			' [금액 자동입력]
			'---------------------------------------------------------------------------------
			' 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅(위치변경 ChangeAcnt)
			' 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
			'---------------------------------------------------------------------------------
			'sPrice = Form.GetSharedData("PRICE", true)
			'
			'if sPrice <> "" and sPrice <> null	then
			'	edtPrc.caption = sPrice
			'	
			'else
				
				if g_szChangeInit <> "1" then
					RequestAutoPrice()
				end if
			
			'end if
			
			'---------------------------------------------------------------------------------
			' [수량 자동입력]
			'---------------------------------------------------------------------------------
			if g_szChangeInit <> "1" then
				RequestAutoQty()
			end if
			
			'---------------------------------------------------------------------
			'20240613매도가능수량 조회
			'미사용(0)이거나 수량입력(2)으로 설정되어있는 경우 여기서 조회
			'보유잔고수량(1) 인 경우 수량 자동입력가능 상태이면 => RequestAutoQty() 에서 Request_Able 호출
			'보유잔고수량(1) 이지만 수량 자동입력가능 상태가 아닌 경우 => 여기서 조회
			'---------------------------------------------------------------------
			if g_szSellQty <> "1" then
				Request_Able()
			
			else
				
				if g_szChangeInit == "1" then
					Request_Able()
				end if
				
			end if
			
			'---------------------------------------------------------------------------------
			'20240613대출정보 클리어 (잔고팝업에서 넘어온 대출정보가 있는 경우 제외)
			'잔고팝업에서 발생한 리턴이벤트가 먼저 발생하여 선택한 대출종목 정보 세팅되있는 상태임.
			'---------------------------------------------------------------------------------
			ClearLoanData()
			
		end if
		
	'============================================================================
	' 매수가격 자동입력
	'============================================================================
	elseif sEventName == "ReturnAutoPrice" then
		
		'--------------------------------------------------------
		' 종목/탭 변경 시 초기화가 꺼져있어도, 
		' 주문가격 자동입력이 미사용으로 되어있으면 빈값이 넘어옴.
		' 빈값으로 넘어온 경우에는 세팅해주지 않는다
		'--------------------------------------------------------
		if g_szChangeInit <> "1" and sParam <> "" and gSettingSelectPriceForAutoPrice <> true then '20240729
			edtPrc.caption = sParam
			Calc_OrderPrice()
		end if
		
		'20240729
		if sParam <> "" then
			gAlReadyCallAutoPrice = true
			gSettingSelectPriceForAutoPrice = false
		end if
		
	'============================================================================
	' 계좌변경(통합증거금 약정여부 조회 및 입력창 초기화)
	'============================================================================	
	elseif sEventName == "ChangeAcnt" then
	
		RequestCombinedMargin()
		
		if g_szChangeInit == "1" then
			Init_InputControl()
		end if
		
		ClearLoanData()
		
		'----------------------------------------------------------------------------------------------------------------
		' 해외주식현재가 화면에서 가격연동 데이터가 있으면 데이터 세팅
		'----------------------------------------------------------------------------------------------------------------
		' ### gSettingSelectPrice 변수설명 ###
		'----------------------------------------------------------------------------------------------------------------
		' : 현재가에서 연동된 호가가 있는 경우 [SEND_DAYMARKET_PRC] or [SEND_AFTERMARKET_PRC]에서 가격세팅 방지
		'
		'----------------------------------------------------------------------------------------------------------------
		' ### gSettingSelectPriceForAutoPrice 변수설명 ###
		'----------------------------------------------------------------------------------------------------------------
		' 정상적인 호출 순서 : [ReturnAutoPrice]호출 후 [ChangeAcnt]가 호출되면서 현재가 링크가격을 세팅
		' 간헐적으로 [ChangeAcnt] 호출 후에 [ReturnAutoPrice]가 호출되는 케이스 발생(설정한 자동가격으로 덮어씌어짐)
		' [ChangeAcnt]가 먼저 호출되어 gSettingSelectPriceForAutoPrice = true인 경우 [ReturnAutoPrice]에서 가격세팅 방지
		'
		'----------------------------------------------------------------------------------------------------------------
		' ### gAlReadyCallAutoPrice 변수 설명 ###
		' 정상적으로 [ReturnAutoPrice]호출 후 [ChangeAcnt]가 호출되면 gSettingSelectPriceForAutoPrice를 true로 변경해줄 필요가 없음.
		' 정상적으로 호출되었을때 gSettingSelectPriceForAutoPrice를 true로 변경해주면 오히려 문제가됨. 
		' ex) 다른탭으로 이동 후에 다시 돌아왔을때 설정한 자동입력 가격으로 세팅이 안됨
		' [ReturnAutoPrice]가 먼저 호출되었는지 판단하기 위해 gAlReadyCallAutoPrice 변수를 사용
		'-----------------------------------------------------------------------------------------------------------------
		sPrice = Form.GetSharedData("PRICE", true)
		
		if sPrice <> "" and sPrice <> null	then
			gSettingSelectPrice = true
			
			'20240729
			if gAlReadyCallAutoPrice <> true then
				gSettingSelectPriceForAutoPrice = true 
			end if
			
			edtPrc.caption = sPrice
		end if
		
		'---------------------------------------------
		' 20240617 LES START 외부 타화면에서 잔고 링크
		'---------------------------------------------
		sJanGo = Form.GetSharedData("JANGO", true )
		
		if sJanGo <> "" and sJanGo <> null	then
			
			'---------------------------------------------------------------------------
			'매도매수구분/수량/대출일자/대출상세유형코드/대출일련번호
			'---------------------------------------------------------------------------
			szData = Split(sJanGo,"★")
			
			'-----------------------------------------------------------
			' 수량연동
			'-----------------------------------------------------------
			edtQty.caption = szData(1)
			
			'-----------------------------------------------------------
			' 대출유형코드 세팅
			'-----------------------------------------------------------
			gLoanType = szData(3)
			
			'-----------------------------------------------------------
			'대출잔고인 경우
			'-----------------------------------------------------------
			if gLoanType <> "0000" then
			
				'-----------------------------------------------------------
				'대출탭으로 변경
				'-----------------------------------------------------------
				rdoGbn.currentindex = 1
				LabelLoanName.visible = true
				
				'-----------------------------------------------------------
				'대출일자 세팅
				'-----------------------------------------------------------
				gLoanDate = szData(2)
				LabelLoanDate.caption = gLoanDate
				
				'-----------------------------------------------------------
				'대출일련번호
				'-----------------------------------------------------------
				gLoanSrno =  szData(4)
				LabelLoanSrno.caption = gLoanSrno
				
			
			'-----------------------------------------------------------
			'일반잔고인 경우
			'-----------------------------------------------------------
			else
				
				'-----------------------------------------------------------
				' 현금탭으로 변경
				'-----------------------------------------------------------
				rdoGbn.currentindex = 0
			
				'-------------------------------------------------------------------------------------
				'대출정보 클리어
				'------------------------------------------------------------------------------------
				ClearLoanData()	
				
			end if
			
			'------------------------------------------
			' 주문유형 보통(지정가)로 초기화
			'------------------------------------------
			cmbType.currentindex = "0"
		
		end if
		
	'============================================================================
	' 잔고탭 종목 연동
	'============================================================================
	elseif sEventName == "SendJangoItem" then
		
		'----------------------------------------------------------------------------------------------------
		'sParam : MAESU★szMk@szItemCode★szName★sOrdAbleQty★sJangoGubun★sLoanType★sLoanDate★sLoanSrno
		'----------------------------------------------------------------------------------------------------
		arrData = Split(sParam,"★")
		
		'============================================================================
		' 매도가능 수량 세팅
		' 수량세팅 우선순위 : 자동입력 설정값 > 리턴 데이터값
		'============================================================================
		'수량 자동입력 설정이 안되어있으면 넘어온 매도가능수량 세팅
		'gReturnQty = true로 변경하여 클리어 방지
		'---------------------------------------------------------------------------
		gReturnQty = true
		edtQty.caption = arrData(3)
		
		'============================================================================
		' 현금/대출 구분에 따른 주문창 세팅
		'============================================================================
		gLoanType = arrData(5)
		
		'-----------------------------------------------------------
		' 대출종목
		'-----------------------------------------------------------
		if gLoanType <> "0000" then
			
			'-----------------------------------------------------------
			' 링크로 넘어온 대출정보가 있는지 여부 세팅
			'-----------------------------------------------------------
			gReturnLoanData = true
			
			'-----------------------------------------------------------
			'대출탭으로 변경
			'-----------------------------------------------------------
			rdoGbn.currentindex = 1
			LabelLoanName.visible = true
			
			'-----------------------------------------------------------
			'대출일자 세팅
			'-----------------------------------------------------------
			gLoanDate = arrData(6)
			LabelLoanDate.caption = gLoanDate
			
			'-----------------------------------------------------------
			'대출일련번호
			'-----------------------------------------------------------
			gLoanSrno = arrData(7)
			LabelLoanSrno.caption = gLoanSrno
		
		'-----------------------------------------------------------
		' 일반종목 (gLoanType : 0000 = 일반종목)
		'-----------------------------------------------------------
		else
			
			'-------------------------------------------------------------------------------------
			'대출정보 클리어
			'------------------------------------------------------------------------------------
			gLoanDate = ""
			LabelLoanDate.caption = ""
			gLoanSrno = ""
			LabelLoanSrno.caption = ""
			
			rdoGbn.currentindex = 0
			
		end if
		
		'------------------------------------------
		' 주문유형 보통(지정가)로 초기화
		'------------------------------------------
		cmbType.currentindex = "0"
		
	'============================================================================
	' 주간장 현재가 세팅(가격자동입력 활성화 & 현재가 세팅으로 되어있을때)
	'============================================================================
	elseif sEventName == "SEND_DAYMARKET_PRC" or sEventName == "SEND_AFTERMARKET_PRC" then
	
		if g_szChangeInit <> "1" and sParam <> "" then
			
			g_szCurPrice 	= sParam '20240627
			szAuto  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELPRC")
			
			if szAuto == "11" and gSettingSelectPrice <> true then
				if Check_PrcOrd() <> "시장가" then
					edtPrc.caption = sParam
					Calc_OrderPrice()
				end if
			end if
			
		end if
		
		gSettingSelectPrice = false '20240729
		
	'============================================================================
	' 비밀번호 검증 후 주문확인창 자동 오픈
	'============================================================================
	elseif sEventName == "OPEN_CONFIRM" then
		btnBuy_OnClick()
		
	'============================================================================
	' 20240715 종목 미변경 시, 필요한 데이터만 재조회(매도가능수량/환율)
	'============================================================================
	elseif sEventName == "RefreshData" then
		
		gReturnLoanData = false
		RequestExChangeRate()
		g_AfterOrdAbleReq = true
		Request_Able()
		
	end if
	
End Sub

'============================================================================
Sub edtPrc_OnEditComplete()
	
End Sub

'============================================================================
Sub edtQty_OnEditComplete()
	
End Sub

'============================================================================
' (가격)자동입력값 요청
'============================================================================
Function RequestAutoPrice()

	Form.triggerEvent("#", "RequestAutoPrice", "SELL")

End Function

'============================================================================
' (수량)자동입력값 요청
'============================================================================
Function RequestAutoQty()

	if g_szSellQty == "1" then			' 보유잔고수량
		
		Request_Able()
		
	elseif g_szSellQty == "2" then		' 수량입력
	
		edtQty.caption = g_szSellQtyCnt
		Calc_OrderPrice()
		
	end if

End Function

'============================================================================
' (가격/수량)입력창 입력값 초기화
'============================================================================
Function Init_InputControl()
	
	if g_szChangeInit == "1" then
		
		'----------------------------------------------------
		' 잔고팝업에서 종목선택한 경우 gReturnQty = true
		' gReturnQty == true인 경우에는 잔고팝업에서 넘어온
		' 매도가능수량이 수량입력창에 세팅될 수 있도록 
		' 수량입력창 클리어해주지 않음.
		'----------------------------------------------------
		if gReturnQty == true then
			gReturnQty = false
		else
			gReturnQty = false
			edtQty.caption = ""
			
		end if
		
		edtPrc.caption = ""
		
	end if
	
End Function

'============================================================================
' (가격/수량)입력창 주문전송 후 초기화
'============================================================================
Function Reset_AfterOrd()
	
	'----------------------------
	' 수량/가격 클리어
	'----------------------------
	edtQty.caption = ""
	edtPrc.caption = ""
	Calc_OrderPrice()
	
	'----------------------------
	' 대출정보 클리어
	'----------------------------
	LabelLoanName.visible = false
		
	gLoanSrno = ""
	LabelLoanSrno.caption = ""
			
	gLoanDate = ""
	LabelLoanDate.caption = ""
	
	'----------------------------
	' 예약정보 클리어
	'----------------------------
	Label0.caption = ""
	lblstart.caption = ""
	lblend.caption = ""
	lblgubn.caption = ""
	lblgubnStr.caption = ""
				
End Function

'============================================================================
' 거래소 호가단위 설정
'============================================================================
Function GetHogaUnit(szMk, szPrc, nGbn) 
	
	'-----------------------------------------------------------------------
	' 호가단위 초기화
	'-----------------------------------------------------------------------
	szOrdPrc = CDbl(szPrc)
	
	if szOrdPrc == "" then
		if g_szCurPrice = "" or CDbl(g_szCurPrice) == 0 then
			szOrdPrc = 0		
		else
			szOrdPrc = CDbl(g_szCurPrice)
		end if	
	end if
	
	szUnit = "1.000"
	
	'-----------------------------------------------------------------------
	' 틱타입 확인
	'-----------------------------------------------------------------------
	szTtype = Cint(g_szTickType)

	if szTtype == 0 or szTtype == "" then
		szTtype = "0"
	end if
	
	'-----------------------------------------------------------------------
	' 중국(상해/심천) 호가단위 설정
	'-----------------------------------------------------------------------
	if szMk == "0215" then '상해
	
		'20240613 LES START 틱단위 수정
		if szTtype = 2 then 'ETF
			szUnit = "0.001"
		else
			szUnit = "0.010"
		end if
		'20240613 LES END
		
	elseif szMk == "0214" then '심천
		
		'20240613 LES START 틱단위 수정
		if szTtype = 2 then 'ETF
			szUnit = "0.001"
		else
			szUnit = "0.010"
		end if
		'20240613 LES END
		
	'-----------------------------------------------------------------------
	' 미국(뉴욕/나스닥/아멕스) 호가단위 설정
	'-----------------------------------------------------------------------
	elseif szMk == "0321" or szMk == "0537" or szMk == "0066" then '뉴욕, 나스닥, 아멕스
		
		'20240702 LES START - 1달러미만 종목 0.0001단위
		if szOrdPrc < 1.00 then
			szUnit = "0.0001"
		else
			
			if szTtype == 1 then
				szUnit = "0.010"
				
			elseif szTtype == 2 then
				szUnit = "0.050"
				
			elseif szTtype == 3 then
				szUnit = "0.050"
				
			elseif szTtype == 4 then
				szUnit = "0.050"
				
			else
				szUnit = "0.010"
			end if
			
		end if
	
	'-----------------------------------------------------------------------
	' 홍콩 호가단위 설정, (홍콩ETF종목 호가단위 변경)
	'-----------------------------------------------------------------------
	elseif szMk == "0104" then '홍콩
		
		if szTtype == 3 then
			szUnit = "0.050"
			
		'홍콩 ETF종목 호가단위 변경
		'type = 5 (ETF종목) 추가
		elseif szTtype == 5 then
			
			if nGbn == 0 then
				if szOrdPrc < 1.00 then
					szUnit = "0.001"
				elseif szOrdPrc < 5.00 then
					szUnit = "0.002"
				elseif szOrdPrc < 10.00 then
					szUnit = "0.005"
				elseif szOrdPrc < 20.00 then
					szUnit = "0.010"
				elseif szOrdPrc < 100.00 then
					szUnit = "0.020"
				elseif szOrdPrc < 200.00 then
					szUnit = "0.050"
				elseif szOrdPrc < 500.00 then
					szUnit = "0.100"
				elseif szOrdPrc < 1000.00 then
					szUnit = "0.200"
				elseif szOrdPrc < 2000.00 then
					szUnit = "0.500"
				else
					szUnit = "1.000"
				end if
			
			else
				if szOrdPrc <= 1.00 then
					szUnit = "0.001"
				elseif szOrdPrc <= 5.00 then
					szUnit = "0.002"
				elseif szOrdPrc <= 10.00 then
					szUnit = "0.005"
				elseif szOrdPrc <= 20.00 then
					szUnit = "0.010"
				elseif szOrdPrc <= 100.00 then
					szUnit = "0.020"
				elseif szOrdPrc <= 200.00 then
					szUnit = "0.050"
				elseif szOrdPrc <= 500.00 then
					szUnit = "0.100"
				elseif szOrdPrc <= 1000.00 then
					szUnit = "0.200"
				elseif szOrdPrc <= 2000.00 then
					szUnit = "0.500"
				else
					szUnit = "1.000"
				end if
			
			end if
		
		else
			if nGbn == 0 then
				if szOrdPrc < 0.25 then
					szUnit = "0.001"
		
				elseif szOrdPrc < 0.50 then
					szUnit = "0.005"
		
				elseif szOrdPrc < 10.00 then
					szUnit = "0.010"
		
				elseif szOrdPrc < 20.00 then	
					szUnit = "0.020"
		
				elseif szOrdPrc < 100.00 then
					szUnit = "0.050"
					
				elseif szOrdPrc < 200.00 then
					szUnit = "0.100"
		
				elseif szOrdPrc < 500.00 then
					szUnit = "0.200"
		
				elseif szOrdPrc < 1000.00 then
					szUnit = "0.500"
		
				elseif szOrdPrc < 2000.00 then
					szUnit = "1.000"
		
				elseif szOrdPrc < 5000.00 then
					szUnit = "2.000"
		
				else 
					szUnit = "5.000"
		
				end if
			else
				if szOrdPrc <= 0.25 then
					szUnit = "0.001"
		
				elseif szOrdPrc <= 0.50 then
					szUnit = "0.005"
		
				elseif szOrdPrc <= 10.00 then
					szUnit = "0.010"
		
				elseif szOrdPrc <= 20.00 then	
					szUnit = "0.020"
		
				elseif szOrdPrc <= 100.00 then
					szUnit = "0.050"
					
				elseif szOrdPrc <= 200.00 then
					szUnit = "0.100"
		
				elseif szOrdPrc <= 500.00 then
					szUnit = "0.200"
		
				elseif szOrdPrc <= 1000.00 then
					szUnit = "0.500"
		
				elseif szOrdPrc <= 2000.00 then
					szUnit = "1.000"
		
				elseif szOrdPrc <= 5000.00 then
					szUnit = "2.000"
		
				else
					szUnit = "5.000"
		
				end if
			
			end if
			
		end if
	
	'-----------------------------------------------------------------------
	' 해외주식 일본시장(도쿄거래소) 추가
	'-----------------------------------------------------------------------
	elseif szMk == "0106" then '도쿄
		if szTtype == 3 then
			if nGbn == 0 then
				if szOrdPrc < 1000 then
					szUnit = "0.1"
		
				elseif szOrdPrc < 3000 then
					szUnit = "0.5"
		
				elseif szOrdPrc < 5000 then
					szUnit = "1"
		
				elseif szOrdPrc < 10000 then	
					szUnit = "1"
		
				elseif szOrdPrc < 30000 then
					szUnit = "5"
					
				elseif szOrdPrc < 50000 then
					szUnit = "10"
		
				elseif szOrdPrc < 100000 then
					szUnit = "10"
		
				elseif szOrdPrc < 300000 then
					szUnit = "50"
		
				elseif szOrdPrc < 500000 then
					szUnit = "100"
		
				elseif szOrdPrc < 1000000 then
					szUnit = "100"
				
				elseif szOrdPrc < 3000000 then
					szUnit = "500"
					
				elseif szOrdPrc < 5000000 then
					szUnit = "1000"
					
				elseif szOrdPrc < 10000000 then
					szUnit = "1000"
					
				elseif szOrdPrc < 30000000 then
					szUnit = "5000"
		
				else 
					szUnit = "10000"
		
				end if
			else
				if szOrdPrc <= 1000 then
					szUnit = "0.1"
		
				elseif szOrdPrc <= 3000 then
					szUnit = "0.5"
		
				elseif szOrdPrc <= 5000 then
					szUnit = "1"
		
				elseif szOrdPrc <= 10000 then	
					szUnit = "1"
		
				elseif szOrdPrc <= 30000 then
					szUnit = "5"
					
				elseif szOrdPrc <= 50000 then
					szUnit = "10"
		
				elseif szOrdPrc <= 100000 then
					szUnit = "10"
		
				elseif szOrdPrc <= 300000 then
					szUnit = "50"
		
				elseif szOrdPrc <= 500000 then
					szUnit = "100"
		
				elseif szOrdPrc <= 1000000 then
					szUnit = "100"
		
				elseif szOrdPrc <= 3000000 then
					szUnit = "500"
					
				elseif szOrdPrc <= 5000000 then
					szUnit = "1000"
					
				elseif szOrdPrc <= 10000000 then
					szUnit = "1000"
					
				elseif szOrdPrc <= 30000000 then
					szUnit = "5000"
		
				else 
					szUnit = "10000"
		
				end if
			
			end if	
		else
			if nGbn == 0 then
				if szOrdPrc < 1000 then
					szUnit = "1"
		
				elseif szOrdPrc < 3000 then
					szUnit = "1"
		
				elseif szOrdPrc < 5000 then
					szUnit = "5"
		
				elseif szOrdPrc < 10000 then	
					szUnit = "10"
		
				elseif szOrdPrc < 30000 then
					szUnit = "10"
					
				elseif szOrdPrc < 50000 then
					szUnit = "50"
		
				elseif szOrdPrc < 100000 then
					szUnit = "100"
		
				elseif szOrdPrc < 300000 then
					szUnit = "100"
		
				elseif szOrdPrc < 500000 then
					szUnit = "500"
		
				elseif szOrdPrc < 1000000 then
					szUnit = "1000"
				
				elseif szOrdPrc < 3000000 then
					szUnit = "1000"
					
				elseif szOrdPrc < 5000000 then
					szUnit = "5000"
					
				elseif szOrdPrc < 10000000 then
					szUnit = "10000"
					
				elseif szOrdPrc < 30000000 then
					szUnit = "10000"
		
				else 
					szUnit = "50000"
		
				end if
			else
				if szOrdPrc <= 1000 then
					szUnit = "1"
		
				elseif szOrdPrc <= 3000 then
					szUnit = "1"
		
				elseif szOrdPrc <= 5000 then
					szUnit = "5"
		
				elseif szOrdPrc <= 10000 then	
					szUnit = "10"
		
				elseif szOrdPrc <= 30000 then
					szUnit = "10"
					
				elseif szOrdPrc <= 50000 then
					szUnit = "50"
		
				elseif szOrdPrc <= 100000 then
					szUnit = "100"
		
				elseif szOrdPrc <= 300000 then
					szUnit = "100"
		
				elseif szOrdPrc <= 500000 then
					szUnit = "500"
		
				elseif szOrdPrc <= 1000000 then
					szUnit = "1000"
				
				elseif szOrdPrc <= 3000000 then
					szUnit = "1000"
					
				elseif szOrdPrc <= 5000000 then
					szUnit = "5000"
					
				elseif szOrdPrc <= 10000000 then
					szUnit = "10000"
					
				elseif szOrdPrc <= 30000000 then
					szUnit = "10000"
		
				else 
					szUnit = "50000"
				end if
			
			end if
		
		end if
	
	end if
	
	return szUnit
	
End Function

'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn)

	szPrc  = ReSet_Prc(edtPrc.caption, nGbn)
	szHigh = g_szUpLimit
	szLow  = g_szDnLimit

	g_szUnit = GetHogaUnit(g_szMk, szPrc, nGbn) '20180710 HAMWG : 호가단위 설정함수 변경
	szUnit = g_szUnit
	
	if Trim(szPrc) == "" or CDbl(szPrc) == 0 then
		if g_szCurPrice == "" or CDbl(g_szCurPrice) == 0 then
			szPrc = 0
		else
			szPrc = g_szCurPrice
		end if
	else
		
		'------------------------------------------------
		' + 버튼 클릭
		'------------------------------------------------
		if nGbn == 0 then							
			if CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if 
			elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀
				if szLow <> "0" then
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if 
			else
				szPrc = CDbl(szPrc) + CDbl(szUnit)
			end if
		
		'------------------------------------------------
		' - 버튼 클릭 
		'------------------------------------------------
		elseif nGbn == 1 then						
			if CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if 		
			elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
				if szLow <> "0" then
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if 
			else
				szPrc = CDbl(szPrc) - CDbl(szUnit)
			end if
		end if
	end if
	
	if CDbl(szPrc) < 0 then
		szPrc = 0
	end if
	
	edtPrc.caption = szPrc
	Calc_OrderPrice()
	
End Function

'============================================================================
' 가격 호가단위 맞추기 
'============================================================================
Function ReSet_Prc(szData, nGbn)	
	if nGbn == 0 then
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))

		if nResult <> 0 and nResult <> CDbl(g_szUnit) then
			return CDbl(szData) - nResult
		else
			return szData
		end if
	else
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))
	
		if nResult <> 0 then
			return CDbl(szData) + (CDbl(g_szUnit) - nResult)
		else
			return szData
		end if
	end if
End Function

'============================================================================
' btnPPlus_OnClick : 가격 + 버튼
'============================================================================
Sub btnPPlus_OnClick()
	Calc_Price(0)
End Sub

'============================================================================
' btnPMinus_OnClick : 가격 - 버튼
'============================================================================
Sub btnPMinus_OnClick()
	Calc_Price(1)
End Sub

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn,nUnit)
	
	szQty = edtQty.caption
	
'	'---------------------------------------------------------
'	' (기존요건) 최대입력 가능 수량 99000000
'	'---------------------------------------------------------
'	if Trim(szQty) <> "" then
'		if CDbl(szQty) >= 99000000 then
'			if nGbn == 0 then
'				Exit Function
'			end if
'		end if
'	end if
	
	'---------------------------------------------------------
	' 수량이 빈값인 경우 매매단위로 초기화
	'---------------------------------------------------------
	if Trim(szQty) == "" then
		if nGbn == 0 then
			szQty = CDbl(nUnit)
		else
			Exit Function
		end if
	
	'---------------------------------------------------------
	' 수량이 빈값이 아닌 경우
	'---------------------------------------------------------
	else
			
		'---------------------------------------------------------
		' [+]버튼 클릭
		'---------------------------------------------------------
		if nGbn == 0 then
			szQty = CDbl(szQty) + CDbl(nUnit)
			nResult = CDbl(szQty) Mod CDbl(nUnit)
			
			if nResult <> 0 then
				szQty = CDbl(szQty) - nResult
			end if
			
		'---------------------------------------------------------
		' [-]버튼 클릭
		'---------------------------------------------------------
		elseif nGbn == 1 then
			
			if CDbl(szQty) == 0 then
				Exit Function
			else		
				szQty = szQty - CDbl(nUnit)
				nResult = CDbl(szQty) Mod CDbl(nUnit)
				
				'20240726
				if Cdbl(szQty) < 0 then
					szQty = 0
				end if
				
			end if
			
		end if
		
	end if
	
	'---------------------------------------------------------
	' 입력값 자리수 체크
	'---------------------------------------------------------
	if Len(szQty) <= gMaxLen then		
		if CStr(szQty) == "0" or CStr(szQty) == "" then
			edtQty.caption = ""
		else
			edtQty.caption = szQty
		end if
	end if
	
	Calc_OrderPrice()
	
	
End Function

'============================================================================
Sub btnQPlus_OnClick()
	Calc_Qty(0,g_szOrdSize)
End Sub

'============================================================================
Sub btnQMinus_OnClick()
	Calc_Qty(1,g_szOrdSize)
End Sub

'============================================================================
' 주문금액 가계산
'============================================================================
Function Calc_OrderPrice()
	
	nPrc = Cdbl(edtPrc.caption)
	nQty = Cint(edtQty.caption)
	
	if nPrc <> "" and nPrc > 0 and nQty <> "" and nQty > 0 then
		
		nOrderPrice = nPrc * nQty
		
		if g_szDecimal <> "" then
			lblOrderPrice.caption = FormatNumber(nOrderPrice,g_szDecimal).." " .. g_szCurrency
		else
			lblOrderPrice.caption = FormatNumber(nOrderPrice,0).." " .. g_szCurrency
		end if
		
		nExChangeRate = Cdbl(LabelExchangeRate.caption)
		
		if nExChangeRate <> "" and nExChangeRate > 0 then
			nOrderPriceWon = nOrderPrice * nExChangeRate
			nOrderPriceWon = Cint(nOrderPriceWon)
			lblOrderPriceWon.caption = FormatNumber(nOrderPriceWon,0).."원"
		else
			lblOrderPriceWon.caption = "- " .. "원"
		end if
	
	else
	
		lblOrderPrice.caption = "- " .. g_szCurrency
		lblOrderPriceWon.caption = "- " .. "원"
		
	end if
	
End Function

'============================================================================
' (공통) 주문 환경설정값 적용
'============================================================================
Function Load_OrderSet()
	
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력
	
	g_szSellQty     = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTY")		' 매도수량 자동입력(0:미사용, 1:현금가능수량, 2:최대가능수량(미수포함), 3:수량입력
	g_szSellQtyCnt  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTYCNT")	' 매도수량 주수(수량입력 선택시)
	
	'--------------------------------------------
	' 주문확인창(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	'--------------------------------------------
	' 주문전송 후 초기화(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'--------------------------------------------
	'종목/탭 변경시 초기화 사용을 초기값으로 설정
	'종목/탭 변경시 초기화(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	

	'--------------------------------------------
	' 원주문번호 자동입력(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	'--------------------------------------------
	' 매수수량 자동입력(기본값 : 사용하지 않음)
	'--------------------------------------------
	if Trim(g_szSellQty) = "" then
		g_szSellQty = "0"		
	end if
	
End Function

'============================================================================
' 시장에 따른 주문유형
'============================================================================
Function SetOrderTypeList(sNation)
	
	if gOsType == "1" or gOsType == "2" then
		if sNation == "USA" then
			sList = "00`보통(지정가)`원하는 가격을 지정하여 주문\r\n" &
			"01`시장가`시장가격으로 즉시 체결되는 주문\r\n" &
			"32`LOC(장마감지정가)`장 마감과 동시에 종가가 지정한 가격보다 같거나 유리하면 체결시키는 주문\r\n" & 
			"34`MOC(장마감시장가)`장 마감과 동시에 시장가로 주문을 내어 종가로 체결시키는 주문\r\n" & 
			"37`VWAP(수량분할)`주문한 수량을 장중에 나누어 체결시키는 알고리즘 주문으로, 과거 거래량을 분석하여 현지 브로커 자체 기준으로 장중 분할 체결하는 주문\r\n" &
			"38`TWAP(시간분할)`주문한 수량을 장중 시간별로 나누어 체결시키는 알고리즘 주문으로, 과거 거래시간을 분석하여 현지 브로커 자체 기준으로 장중 분할 체결하는 주문\r\n" &
			"35`Limit VWAP(가격제한수량분할)`과거 거래량을 분석하여 현지 브로커 자체 기준으로 가격을 제한한 장중 분할 체결하는 알고리즘 주문\r\n" &
			"36`Limit TWAP(가격제한시간분할)`과거 거래시간을 분석하여 현지 브로커 자체 기준으로 장중 시간별로 분할 체결하는 알고리즘 주문으로 지정한 가격과 동일하거나 유리하면 체결하는 주문\r\n"
		else 
			sList = "00`보통(지정가)`원하는 가격을 지정하여 주문\r\n"
		end if
	else
		if sNation == "USA" then
			sList = "00`보통(지정가)\r\n" &
			"01`시장가\r\n" &
			"32`LOC(장마감지정가)\r\n" & 
			"34`MOC(장마감시장가)\r\n" & 
			"37`VWAP(수량분할)\r\n" &
			"38`TWAP(시간분할)\r\n" &
			"35`Limit VWAP(가격제한수량분할)\r\n" &
			"36`Limit TWAP(가격제한시간분할)\r\n"
		else 
			sList = "00`보통(지정가)\r\n"
		end if
	end if
	
	cmbType.currentindex = "0"	
	cmbType.clear = true
	cmbType.cbinputdatatext = sList
	
End Function

'============================================================================
' 통합증거금 약정여부 조회 서비스 호출
