'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	'----------------------------------------------------------
	'정정/취소 주문용
	'----------------------------------------------------------
	if szTranID == "obtro_oder_102a" then
		
		g_szTR = szTranID
		
		nSelectIndex = GetCheckIndex()
		
		szOrdDate = Grid0.GetCellData("bd_orderdate", nSelectIndex)
		szOrdOrgnNo = Grid0.GetCellData("bd_orderno", nSelectIndex)
		szQty = edtQty.caption
		szPrc = edtPrc.caption
		
		if gOrderReqIndex == 1 then
			szModeCancelType = "1"
		elseif gOrderReqIndex == 2 or gOrderReqIndex == 3 then
			szModeCancelType = "2" 
		end if
		
		
		DATAMANAGER.ClearInputData(0, "obtro_oder_102a")
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ACNO"					, 0, Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ASNO"					, 0, Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ACNT_PWD"				, 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_DATE"				, 0, szOrdDate)								' 주문일자
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ORGL_ODER_NO"			, 0, szOrdOrgnNo)								' 원주문번호
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "PRTN_WHOL_TPCD"			, 0, "2")									' 전량체크
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODQT"					, 0, szQty)									' 주문수량
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "OVRS_STCK_ODER_PRC"		, 0, szPrc)									' 주문가격
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_RCTF_CNCL_CLS_CODE"	, 0, szModeCancelType)							' 주문정정취소구분("1":정정/"2":취소)
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_CLS_CODE"			, 0, Check_OrdType())							' 주문구분코드 
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_COND_CLS_CODE"		, 0, Check_OrdCond())							' 주문조건구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_OCRN_TYPE_CODE"		, 0, "01")									' 주문발생유형코드(01:일반주문)	
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "WARN_CNFR_YN"			, 0, g_szWarnFlag)		
		
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'==========================================================================
	' 정정/취소 주문용(102a)
	'==========================================================================
	if szTranID == "obtro_oder_102a" then
	
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0) '경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
	
		'--------------------------------
		' 경고
		'--------------------------------
		if szWarnCd = "1" then							
		
			Open_ConfirmPopup(szWarnMsg)
		
		'--------------------------------
		' 보류(해외주식 제외)
		'--------------------------------
		elseif szWarnCd = "2" then						'
			
			g_szTR = ""
		
		'--------------------------------
		' 정상주문 처리
		'--------------------------------
		else
		
			g_szTR = ""
				
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
	
			'-----------------------------
			' 정상주문
			'-----------------------------
			
			if Trim(szOrdCd) == "0001" then			
				
				'-----------------------------
				' 주문처리 메시지 출력
				'-----------------------------
				Form.Toast(0, szOrdMsg, true)
				
				'-----------------------------
				' 주문후 초기화
				'-----------------------------
				if g_szAfterInit == "1" then		
					Init_InputControl()
				end if
				
				'-----------------------------
				' 주문번호 연동
				'-----------------------------
				if g_szAfterOrg == "1" then			
					szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
					Form.triggerEvent("#", "AfterOrd", szOrgNo)
				end if
				
				'-----------------------------
				' 정정/취소 주문 후 미체결내역 재조회
				'-----------------------------
				Form.SetTimerEvent2(1, 1, 0.5)
				'imgRefresh_OnClick()
					
			end if
			
		end if
		
	
	'==========================================================================
	' 일괄취소 주문용(102a_1)
	'==========================================================================
	elseif szTranID == "obtro_oder_102a_1" then
	
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0) '경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
		
		'--------------------------------
		' 경고
		'--------------------------------
		if szWarnCd = "1" then							
		
			Open_ConfirmPopup(szWarnMsg)
		
		'--------------------------------
		' 보류(해외주식 제외)
		'--------------------------------
		elseif szWarnCd = "2" then						'
			
			g_szTR = ""
			
		'--------------------------------
		' 정상주문 처리
		'--------------------------------
		else
		
			g_szTR = ""
			
			'----------------------------------
			'남은 주문건수 -1
			'----------------------------------
			gRemainItemCnt = gRemainItemCnt - 1
			
			'----------------------------------
			'남은 건수가 0건이면 주문완료
			'----------------------------------
			if gRemainItemCnt == 0 then
			
				'--------------------------------------
				'주문전송에 실패한 건수가 있는지 체크
				'--------------------------------------
				
				'실패건수가 없을 때
				if gOrdFailItemCnt == 0 then
					Form.ShowAlert("알림", "주문이 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
				
				'모두 실패했을 때
				elseif gCanCelItemCnt == gOrdFailItemCnt then
					Form.ShowAlert("알림", "취소가 불가합니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
				
				'일부만 실패했을 때
				else
					Form.ShowAlert("알림", "주문이 일부만 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
				end if
				
				gCanCelItemCnt = -1
				gOrdFailItemCnt = 0
				gOrderIndex  = 0
				gCanCelFirstItem = true
				
				'--------------------------------------
				' 일괄취소 후 미체결내역 재조회
				'--------------------------------------
				Form.SetTimerEvent2(1, 1, 0.5)
				'imgRefresh_OnClick()
				
				
			else
			
				Request_OrderAllCancel()
			
			end if
			
		
		end if
	
	
	'==========================================================================
	'통합증거금 약정조회
	'==========================================================================
	elseif szTranID == "obpds_srvc_323r" then
	
		'------------------------------------------------------------------------------------
		'SVCD 값이 0이면, 통합증거금 미약정 계좌
		'------------------------------------------------------------------------------------
		szCnt = DATAMANAGER.GetDataValue(0, "obpds_srvc_323r" , "OutBlock1" , "SVC_SRNO" , 0)
		
		if Cint(szCnt) <> 0 then
			gTotalYN = true
		else
			gTotalYN = false
		end if
	
	'==========================================================================
	'통화별 환율조회
	'==========================================================================
	elseif szTranID == "obtro_comn_025r" then
	
		szAnncExrt = DATAMANAGER.GetDataValue( 0, "obtro_comn_025r", "OutBlock1", "ANNC_EXRT" , 0 )	' 고시환율
		LabelExchangeRate.caption = szAnncExrt
		
		'수량/가격 자동입력 설정 시
		'환율조회가 되기 전, 주문금액 가계산이 진행된 경우 
		'원화금액이 빈값으로 나올 수 있어 환율 조회 이후에 다시 한번 주문금액 계산
		'Calc_OrderPrice()
		
	'==========================================================================
	' 미체결건수 조회
	'==========================================================================
	elseif szTranID == "obtro_oder_115r" then
	
		nCnt = Cint(DATAMANAGER.GetDataValue(0, "obtro_oder_115r", "OutBlock1", "IQRY_CSNU" , 0))
		FormTab0.SetTabPageCaption( "page1", "전체("..nCnt.."건)" )
	
	
	'==========================================================================
	' 미체결내역 조회
	'==========================================================================
	elseif szTranID == "obtro_oder_103r" then
		
		if DATAMANAGER.IsMoreNextData("obtro_oder_103r") then
			DATAMANAGER.RequestNextData("obtro_oder_103r")
		else
			
			nDataCnt = Cint(Grid0.rowcount)
			
			if nDataCnt == 0 then
				
				'데이터없음 이미지/라벨 표시
				imgNodata.left = 162
				lblNodata.left = 0
				imgNodata.visible = true
				lblNodata.visible = true
				
				'호가테이블 숨기기
				ChangeGridType("3")
				Form.triggerEvent("#", "ChangeContHoga", "3")
				
				'전체취소버튼 비활성화
				chkAllCancel.enable = false
				chkAllCancel.setAlpha("0.5")
				
			else
				imgNodata.left = 500
				lblNodata.left = 500
				imgNodata.visible = false
				lblNodata.visible = false
				
				'호가테이블 숨기기
				ChangeGridType("3")
				Form.triggerEvent("#", "ChangeContHoga", "3")
				
				'전체취소버튼 활성화
				chkAllCancel.enable = true
				chkAllCancel.setAlpha("1.0")
				
			end if
		
			'------------------------------------------------------------
			' 종목명 최대라인수 설정
			'------------------------------------------------------------
			Grid0.SetCellMaxLineCount("bd_name",2)
			
			for i = 0 to Grid0.rowcount - 1
			
				'------------------------------------------------------------
				' 현금/대출 구분
				'------------------------------------------------------------
				sCashCredit = Grid0.GetCellData("bd_loantype", i)
				if sCashCredit == "0251" then
					Grid0.SetCellData("bd_cash", i, "대출")
				else
					Grid0.SetCellData("bd_cash", i, "현금")
				end if
				
				'------------------------------------------------------------
				'매매구분
				'------------------------------------------------------------
				sGubunCode = Grid0.GetCellData("bd_maemaegubun", i)
				sModeCancelCode = Grid0.GetCellData("bd_modcancelcode", i)
				sGubunName = GetGubunNameByCode(sGubunCode,sModeCancelCode,i)
				Grid0.SetCellData("bd_ordergubun", i, "| ".. sGubunName)
				
				'------------------------------------------------------------
				'시장구분
				'------------------------------------------------------------
				sCountryCode = Grid0.GetCellData("bd_marketgubun", i)
				sVndrCode = Grid0.GetCellData("bd_vndrcode", i)
				sCountryName = GetCountryNameByCode(sCountryCode,sVndrCode)
				Grid0.SetCellData("bd_marketgubun", i, sCountryName)
				
				'------------------------------------------------------------
				'주문구분
				'------------------------------------------------------------
				sOrderCode = Grid0.GetCellData("bd_ordercode", i)
				sOrderName = GetOrderNameByCode(sOrderCode)
				Grid0.SetCellData("bd_ordername", i, sOrderName)
				
				'------------------------------------------------------------
				'주문상태
				'------------------------------------------------------------
				sOrderStateCode = Grid0.GetCellData("bd_orderstatecode", i)
				sOrderStateName = GetOrderStateNameByCode(sOrderStateCode)
				Grid0.SetCellData("bd_orderstate", i, sOrderStateName)
			
			
			next
			
			'-------------------------------------------------------------------------------------------
			' 주문/체결 탭에서 미체결 종목 정보가 넘어온 경우에는 해당 종목 자동선택 및 컨트롤 자동조정
			'-------------------------------------------------------------------------------------------
			if gbLinkMiCheItem == true then
				
				'Form.ShowAlert("gLinkMiCheItemInfo", gLinkMiCheItemInfo)
				
				if gLinkMiCheItemInfo <> "" then
					
					'gLinkMiCheItemInfo = 거래소코드★종목코드★주문가격★주문수량★주문번호
					arrData = Split(gLinkMiCheItemInfo,"★")
					
					sTempVndrCode 	= arrData(0)
					sTempItemCode 	= arrData(1)
					sTempOrdPrice 	= arrData(2)
					sTempOrdMicheQty 	= arrData(3)
					sTempOrdNo		= arrData(4)
					
					nMiCheIndex = SearchMiCheLinkItemIndex(sTempVndrCode,sTempItemCode,sTempOrdNo) 
					
					if nMiCheIndex >= 0 then
						ChangeGridType("4")
						Form.triggerEvent("#", "ChangeContHoga", "4")
						edtQty.caption = sTempOrdMicheQty
						
						Grid0.toprow = nMiCheIndex
						SetCheckExceptSelectRow(nMiCheIndex,"manual")
						
						'---------------------------------------------------------------------
						'20240709 주문유형에 따라 가격입력창 비활성화
						'시장가/MOO/MOC/VWAP/TWAP 처럼 가격을 입력하지 않는 주문의 경우 정정불가
						'---------------------------------------------------------------------
						sOrdClsCode = Grid0.GetCellData("bd_ordercode", nMiCheIndex)
						SetcmbTypeIndex(sOrdClsCode)
						
						'------------------------------------------------------------------------
						'20240716 정정가격 자동입력 사용불가(미사용) 할때만 주문가격 연동해줌.
						'------------------------------------------------------------------------
						'edtPrc.caption = sTempOrdPrice
						'------------------------------------------------------------------------
						'Form.ShowAlert("sTempOrdPrcie", sTempOrdPrcie)
						if g_szChangeInit <> "1" then
							
							if g_szModAutoPrc == "0" or g_szModAutoPrc == "" then
								if Cdbl(sTempOrdPrice) == 0 then
									edtPrc.caption = ""
								else
									edtPrc.caption = sTempOrdPrice
								end if
							else
								RequestAutoPrice()
							end if
							
						else
							
							if Cdbl(sTempOrdPrice) == 0 then
								edtPrc.caption = ""
							else
								edtPrc.caption = sTempOrdPrice
							end if
							
						end if
						'------------------------------------------------------------------------
						
						
					end if
					
					gbLinkMiCheItem = false
					gLinkMiCheItemInfo = ""
					 
				end if
			
			end if
			
			'-------------------------------------------------------------------------------------------
			' 주문/체결 탭에서 [미체결] 내역 조회 시, [전체 취소하기] 버튼 클릭 연동일 시
			'-------------------------------------------------------------------------------------------
			if gAllCancelSend == true then
				chkAllCancel.checkstate = 1
				chkAllCancel_OnChange("1")
				gAllCancelSend = false
			end if
		
		end if
	
	end if
	
	'해외주식 주문착오 방지
	g_szWarnFlag = "N"	
	
End Sub

'============================================================================
' 서비스 오류처리
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szTranID == "obtro_oder_102a_1" then
	
		
		g_szTR = ""
			
		'----------------------------------
		'남은 주문건수 -1
		'----------------------------------
		gRemainItemCnt = gRemainItemCnt - 1
		gOrdFailItemCnt = gOrdFailItemCnt + 1
		
		'----------------------------------
		'남은 건수가 0건이면 주문완료
		'----------------------------------
		if gRemainItemCnt == 0 then
		
			'--------------------------------------
			'주문전송에 실패한 건수가 있는지 체크
			'--------------------------------------
			
			'실패건수가 없을 때
			if gOrdFailItemCnt == 0 then
				Form.ShowAlert("알림", "주문이 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
			
			'모두 실패했을 때
			elseif gCanCelItemCnt == gOrdFailItemCnt then
				Form.ShowAlert("알림", "취소가 불가합니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
			
			'일부만 실패했을 때
			else
				Form.ShowAlert("알림", "주문이 일부만 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
			end if
			
			gCanCelItemCnt = -1
			gOrdFailItemCnt = 0
			gOrderIndex  = 0
			gCanCelFirstItem = true
			
			'--------------------------------------
			' 일괄취소 후 미체결내역 재조회
			'--------------------------------------
			Form.SetTimerEvent2(1, 1, 0.5)
			'imgRefresh_OnClick()
			
		else
		
			Request_OrderAllCancel()
		
		end if
	
	
	else
		
		'------------------------------------------------------------------
		' 해외ETP 미약정 고객
		'------------------------------------------------------------------
		if szErrCode == "6207" then
			
			Form.MsgBox("안내", "해외ETP 거래 미신청 계좌 입니다.\n해당 화면으로 이동하시겠습니까?", "ETP_MSG", 7, "거래신청하기","취소")
		
		'------------------------------------------------------------------
		' 대출주문 대출일자/대출일련번호 미입력 시
		'------------------------------------------------------------------
		elseif szErrCode == "1256" or szErrCode == "1258" then
			
			Form.ShowAlert("안내", "대출일자 선택 후 주문이 가능해요.\n잔고에서 매도할 종목 선택 후 매도를 진행해주세요.")
		
		'------------------------------------------------------------------
		' 그외
		'------------------------------------------------------------------
		else
			if Trim(szSubMsg) <> "" then
				Form.ShowAlert(g_szTitle, szErrMsg & "\n(" & szSubMsg & ")")
			else
				Form.ShowAlert(g_szTitle, szErrMsg)
			end if
		end if
		
	end if
	
End Sub

'============================================================================
' 메시지박스 리턴
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

	if sKeyName == "ETP_MSG" then
		
		if sRet == "ok" then
			
			'계좌번호
			szAcnt = Form.GetTopCtlProp("acnt", "caption")		
			Form.OpenScreen("87051" , szAcnt)
			
		end if
	
	end if
	
End Sub

'============================================================================
' 정정버튼 클릭
'============================================================================
Sub btnMod_OnClick()

	gOrderReqIndex = 1
	
	if Check_InputData("Order") == true then
		
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup("")
		else
			Request_Order()
		end if
		
	end if
	
End Sub

'============================================================================
' 취소버튼 클릭
'============================================================================
Sub btnCancel_OnClick()

	gOrderReqIndex = 2
	
	if Check_InputData("Order") == true then
		
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup("")
		else
			Request_Order()
		end if
		
	end if

	
	
End Sub

'============================================================================
' 전체취소 버튼
'============================================================================
Sub btnAllCancel_OnClick()

	gOrderReqIndex = 3
	
	if Check_InputData("ALL_CANCEL") == true then
		
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup("")
		else
			Request_OrderAllCancel()
		end if
		
	end if
	
End Sub

'============================================================================
' 주문전송 전 입력값 정합성 검증
'============================================================================
Function Check_InputData(sGubun)
	
	if sGubun == "Order" then
		
		'-----------------------------------------------------------------
		'계좌번호
		'-----------------------------------------------------------------
		szAcnt = Form.GetTopCtlProp("acnt", "caption")
		If Len(szAcnt) < 10 Then
			Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
			return False
		End If
		
		'-----------------------------------------------------------------
		'계좌비밀번호
		'-----------------------------------------------------------------
		szPwd = Form.GetTopCtlProp("edtPwd", "caption")
		
		If Trim(szPwd) = "" Then
			Form.triggerEvent("#", "ShowPasswordKeyPad", "")
			return False
		end if
		
		'-----------------------------------------------------------------
		'종목코드
		'-----------------------------------------------------------------
		if Trim(g_szCd) == "" then
			Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
			return false
		end if
		
		'-----------------------------------------------------------------
		'수량
		'-----------------------------------------------------------------
		if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
			Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
			return false
		end if
		
		'-----------------------------------------------------------------
		'가격(정정주문일때만 가격입력 검증)
		'-----------------------------------------------------------------
		if gOrderReqIndex == 1 then
		
			if Trim(edtPrc.caption) == "" or Trim(edtPrc.caption) == "0" then
			
				'시장가/지정가 확인
				if Check_PrcOrd() <> "시장가" then
					Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
					return false
				end if
			end if
		
		end if
		
		'-----------------------------------------------------------------
		' 시장체크(중국주식 정정주문 불가/취소주문만 가능)
		'-----------------------------------------------------------------
		if gOrderReqIndex == 1 then
			
			if g_szNg == "CHN" then
				Form.MsgBox("안내", "중국 주식은 정정이 불가합니다.\n(취소만 가능)", "CHECK_MOD_ORDER_NATION", 6)
				return false
			end if
			
		end if
		
		'-----------------------------------------------------------------------------------------------------
		' 20240709 주문유형 체크(시장가/MOO/MOC/VWAP/TWAP) 주문가격 미입력 주문의 경우 정정주문 불가/취소주문만 가능
		'-----------------------------------------------------------------------------------------------------
		if gOrderReqIndex == 1 then
		
			'선택행
			nSelectIndex = GetCheckIndex()
		
			'매매구분
			sSelectOrdClsCode = Grid0.GetCellData("bd_ordercode", nSelectIndex)
			
			if sSelectOrdClsCode == "1" or sSelectOrdClsCode == "6" or sSelectOrdClsCode == "7" or sSelectOrdClsCode == "A" or sSelectOrdClsCode == "B" then
				Form.MsgBox("안내", "해당 주문 유형은 정정이 불가합니다.\n(취소만 가능)", "CHECK_MOD_ORDER_CLS_CODE", 6)
				return false
			end if
		
		end if
		
		'-----------------------------------------------------------------------------------------------------
		' 특이사항 없을 시, 주문전송 허용
		'-----------------------------------------------------------------------------------------------------
		return true
		
	elseif sGubun == "ALL_CANCEL" then
		
		'-----------------------------------------------------------------
		'계좌번호
		'-----------------------------------------------------------------
		szAcnt = Form.GetTopCtlProp("acnt", "caption")
		If Len(szAcnt) < 10 Then
			Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
			return False
		End If
		
		'-----------------------------------------------------------------
		'계좌비밀번호
		'-----------------------------------------------------------------
		szPwd = Form.GetTopCtlProp("edtPwd", "caption")
		
		If Trim(szPwd) = "" Then
			Form.triggerEvent("#", "ShowPasswordKeyPad", "")
			return False
		end if
	
		'-----------------------------------------------------------------
		'일괄취소 건수확인
		'-----------------------------------------------------------------
		nCheckNum = GetCheckNum()
		
		if nCheckNum > 0 then
			return true
		else
			Form.MsgBox("안내", "일괄취소할 주문을 선택해주세요.", "CHECK_ALL_CANCEL", 6)
			return false
		end if
		
	end if
	
End Function

'============================================================================
' 주문확인창/경고팝업 오픈
'============================================================================
Function Open_ConfirmPopup(szWarn)
	
	Dim szData, szOrdNm, szOrdGubun,szPrcOrd
	
	'--------------------------------------------------
	'정정/취소
	'--------------------------------------------------
	if gOrderReqIndex == 1 or gOrderReqIndex == 2 then
	
		'선택행
		nSelectIndex = GetCheckIndex()
		
		'매매구분
		szGubunCode = Grid0.GetCellData("bd_maemaegubun", nSelectIndex)
		
		'주문유형명
		szOrdNm = Check_OrdName()
		'szOrdCode = Grid0.GetCellData("bd_ordercode", nSelectIndex)
		'szOrdNm = GetOrderNameByCode(szOrdCode)
		
		
		'현금/대출구분(선택행의 대출상세유형 코드로 구분)
		szLoanType = Grid0.GetCellData("bd_loantype", nSelectIndex)
		szLoanDate = Grid0.GetCellData("bd_loandate", nSelectIndex)
		szLoanSrno = Grid0.GetCellData("bd_loansrno", nSelectIndex)
		
		'원주문번호
		szOrderOrgnNo = Grid0.GetCellData("bd_orderno", nSelectIndex)
		
		if szLoanType == "0251" then
			szOrdGubun = "1"
		else
			szOrdGubun = "0"
		end if
		
		'시장가/지정가
		szPrcOrdNm = Check_PrcOrd()
		
		sCodeData = Split(g_szCd, "@")
		
		if Trim(szWarn) == "" then	
			szData = szGubunCode											' 매매구분(1:매도/2:매수)
		else
			szData = "2"
		end if
		
		szData = szData & "|" & Form.GetTopCtlProp("acnt", "caption")		' 계좌번호
		szData = szData & "|" & Form.GetTopCtlProp("acnt", "accountname")	' 계좌명
		szData = szData & "|" & sCodeData[1]								' 종목코드
		szData = szData & "|" & g_szKorName								' 종목명
		szData = szData & "|" & szOrdNm									' 주문구분
		szData = szData & "|" & szOrdGubun								' 현금(0:현금/1:대출)
		szData = szData & "|" & edtQty.caption							' 주문수량
		szData = szData & "|" & edtPrc.caption							' 주문가격
		szData = szData & "|" & szOrderOrgnNo							' 원주문번호
		szData = szData & "|" & "Y"										' 전량전부
		szData = szData & "|" & g_szDecimal								' 가격자릿수
		szData = szData & "|" & g_szCurrency								' 통화기호
		szData = szData & "|" & szPrcOrdNm								' 시장가or지정가
		
		'대출관련 추가 정보
		szData = szData & "|" & szLoanType 								' 대출구분
		szData = szData & "|" & szLoanDate 								' 대출일자
		szData = szData & "|" & szLoanSrno 								' 대출일련번호
	
	'--------------------------------------------------
	' 전체취소
	'--------------------------------------------------
	elseif gOrderReqIndex == 3 then
	
		szData = "3"
		szData = szData & "|" & Form.GetTopCtlProp("acnt", "caption")		' 계좌번호
		szData = szData & "|" & Form.GetTopCtlProp("acnt", "accountname")	' 계좌명
		
		nGridRowCnt = Cint(Grid0.rowcount)
		nCheckNum = Cint(GetCheckNum())
		
		szData = szData & "|" & nCheckNum								' 선택건수
		
		if nGridRowCnt == nCheckNum then
			szData = szData & "|" & "Y"									' 선택건수가 전체선택인지 여부
		else
			szData = szData & "|" & "N"
		end if
	
	end if

	'----------------------------------------------------
	' 경고팝업 오픈 (취소는 경고팝업 안뜸)
	' 20240723 정정 경고확인창 별도로 분리. 
	'----------------------------------------------------
	if Trim(szWarn) <> "" then		
		
		'원주문 매수/매도 구분
		szOrgnOrdGubunCode = Grid0.GetCellData("bd_maemaegubun", nSelectIndex)
		szData = szData & "|" & szOrgnOrdGubunCode	
		
		'경고메세지 추가	
		szData = szData & "|" & szWarn			
		Form.OpenPopupAnimation("mhtro16100_p9", szData , "", "2")
	
	'----------------------------------------------------
	' 주문확인팝업 오픈
	'----------------------------------------------------
	else							
		
		'gOrderReqIndex => 1:정정/2:취소/3:전체취소 서비스 호출
		if gOrderReqIndex == 1 then
			Form.OpenPopupAnimation("mhtro16100_p5", szData , "", "2")
		elseif gOrderReqIndex == 2 then
			Form.OpenPopupAnimation("mhtro16100_p6", szData , "", "2")
		elseif gOrderReqIndex == 3 then
			Form.OpenPopupAnimation("mhtro16100_p7", szData , "", "2")
		end if
		
	end if
	
End Function

'============================================================================
' 주문유형코드
'============================================================================
Function Check_OrdType()
	
	Dim szIdx
	szIdx = CStr(cmbType.currentindex)
	
	Select Case szIdx
		Case "0"
			return "01" '지정가
		Case "1"
			return "05" '시장가
		Case "2" 
			return "31" 'LOO
		Case "3"
			return "32" 'LOC
		Case "4"
			return "33" 'MOO
		Case "5"
			return "34" 'MOC
		Case "6"
			return "37" 'VWAP
		Case "7"
			return "38" 'TWAP
		Case "8"
			return "35" 'Limit VWAP
		Case "9"
			return "36" 'Limit TWAP
	End Select
	
End Function
'============================================================================
' 주문조건구분코드
'============================================================================
Function Check_OrdCond()
	
	Dim szIdx
	szIdx = Check_OrdType()
	
	Select Case szIdx
		Case "01"
			return "0" '지정가
		Case "05"
			return "0" '시장가
		Case "31"
			return "2" 'LOO
		Case "32"
			return "7" 'LOC
		Case "33"
			return "2" 'MOO
		Case "34"
			return "7" 'MOC
		Case "35"
			return "0" 'Limit VWAP
		Case "36"
			return "0" 'Limit TWAP
		Case "37"
			return "0" 'VWAP
		Case "38"
			return "0" 'TWAP
	End Select
	
End Function

'============================================================================
' 주문유형명 가져오기
'============================================================================
Function Check_OrdName()
	
	Dim szIdx
	szIdx = Check_OrdType()
	
	Select Case szIdx
		Case "01"
			return "보통(지정가)"
		Case "05"
			return "시장가"
		Case "31"
			return "LOO(장개시지정가)" 
		Case "32"
			return "LOC(장마감지정가)" 
		Case "33"
			return "MOO(장개시시장가)" 
		Case "34"
			return "MOC(장마감시장가)" 
		Case "35"
			return "Limit VWAP(가격제한수량분할)" 
		Case "36"
			return "Limit TWAP(가격제한시간분할)" 
		Case "37"
			return "VWAP(수량분할)" 
		Case "38"
			return "TWAP(시간분할)" 
	End Select
	
End Function

'============================================================================
' Check_PrcOrd 지정가/시장가 구분
'============================================================================
Function Check_PrcOrd()
	
	Dim szIdx
	szIdx = Check_OrdType()
	
	'시장가/MOO(장개시시장가)/MOC(장마감시장가)/VWAP(수량분할)/TWAP(시간분할)
	if szIdx == "05" or szIdx == "33" or szIdx == "34" or szIdx == "37" or szIdx == "38" then
		return "시장가"
	else
		return "지정가"
	end if
	
End Function

'============================================================================
' 주문전송
'============================================================================
Function Request_Order()
	
	'------------------------
	' 해외주식 주문착오 방지
	'------------------------
	g_szWarnFlag	= "N"
	
	'----------------------------------
	' 주문서비스 호출
	'----------------------------------
	DATAMANAGER.RequestTranData("obtro_oder_102a")
	
End Function

'============================================================================
' 전체취소 주문전송
'============================================================================
Function Request_OrderAllCancel()

	'--------------------------------------------
	' 주문나갈 행 인덱스
	'--------------------------------------------
	Dim szIdx
	szIdx = "" 
	
	'--------------------------------------------
	'gCanCelItemCnt : 주문이 나가야되는 전체건수
	'gRemainItemCnt : 주문이 나가고 남은 건수
	'--------------------------------------------
	if gCanCelItemCnt < 0 then
		gCanCelItemCnt = GetCheckNum()
		gRemainItemCnt = gCanCelItemCnt
		gOrderIndex = 0
		gCanCelFirstItem = true
	end if
	
	
	'----------------------------------------------
	' 첫번째 주문은 0번째 행부터 서칭
	'----------------------------------------------
	if gCanCelFirstItem == true then
		
		for i = gOrderIndex to Cint(Grid0.rowcount) - 1
			
			szChk = Cint(Grid0.GetCellData("bd_check", i))
			
			if szChk == 1 then
				szIdx = i
				gOrderIndex  = szIdx
				gCanCelFirstItem = false
				exit for
			end if
			
		next
	
	'----------------------------------------------
	' 두번째 주문부터는 직전 인덱스 다음부터 서칭
	'----------------------------------------------
	else
		
		for i = gOrderIndex + 1 to Cint(Grid0.rowcount) - 1
			
			szChk = Cint(Grid0.GetCellData("bd_check", i))
			
			if szChk == 1 then
				szIdx = i
				gOrderIndex  = szIdx
				exit for
			end if
		
		next
	
	end if
	
	
	'----------------------------------------------
	' 주문나갈 종목 정보가져오기
	'----------------------------------------------
	if gOrderIndex  <> "" then
		
		nGridLastIndex = Cint(Grid0.rowcount) - 1
		
		if gOrderIndex <= nGridLastIndex then
			
			'Form.ShowAlert("TEST", "(예정)총 주문건수 : " .. gCanCelItemCnt .."\n".. "주문전송행 : "..gOrderIndex.."\n".. "남은 건수 : " .. gRemainItemCnt .."\n".. "실패건수 : "..gOrdFailItemCnt)
			
			g_szTR = "obtro_oder_102a_1"
		
			szOrdDate = Grid0.GetCellData("bd_orderdate", gOrderIndex)
			szOrdOrgnNo = Grid0.GetCellData("bd_orderno", gOrderIndex)
			szQty = Grid0.GetcellData("bd_micheqty",gOrderIndex)
			szPrc = Grid0.GetcellData("bd_orderprice", gOrderIndex)
			szModeCancelType = "2" 
			
			
			DATAMANAGER.ClearInputData(0, "obtro_oder_102a_1")
	
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a_1", "InBlock1", "ACNO"					, 0, Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a_1", "InBlock1", "ASNO"					, 0, Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a_1", "InBlock1", "ACNT_PWD"				, 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
			
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a_1", "InBlock1", "ODER_DATE"				, 0, szOrdDate)								' 주문일자
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a_1", "InBlock1", "ORGL_ODER_NO"			, 0, szOrdOrgnNo)								' 원주문번호
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a_1", "InBlock1", "PRTN_WHOL_TPCD"			, 0, "2")									' 전량체크
			
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a_1", "InBlock1", "ODQT"					, 0, szQty)									' 주문수량
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a_1", "InBlock1", "OVRS_STCK_ODER_PRC"		, 0, szPrc)									' 주문가격
			
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a_1", "InBlock1", "ODER_RCTF_CNCL_CLS_CODE"	, 0, szModeCancelType)							' 주문정정취소구분("1":정정/"2":취소)
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a_1", "InBlock1", "ODER_CLS_CODE"			, 0, Check_OrdType())							' 주문구분코드 
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a_1", "InBlock1", "ODER_COND_CLS_CODE"		, 0, Check_OrdCond())							' 주문조건구분코드
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a_1", "InBlock1", "ODER_OCRN_TYPE_CODE"		, 0, "01")									' 주문발생유형코드(01:일반주문)	
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a_1", "InBlock1", "WARN_CNFR_YN"			, 0, g_szWarnFlag)	
			
			DATAMANAGER.RequestTranData("obtro_oder_102a_1")
			
		end if
	
	end if
	
	
	
End Function 

'============================================================================
' 팝업창 리턴처리
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	' ----------------------------------------------------------------------
	' (사용)해외주식 주문착오 방지 (경고팝업에서 리턴)
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end if	
	
	' ----------------------------------------------------------------------
	' (사용)PTP경고팝업에서 리턴 (20221206_01 KBC START : 해외주식 미국PTP 종목과세관련)
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PTP주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end if		
	
	' ----------------------------------------------------------------------
	' (사용)주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
		
	'----------------------------------------------------------------------
	' (사용) 전체취소 주문확인창에서 리턴
	'----------------------------------------------------------------------
	elseif sKeyName == "전체취소주문전송" then
		if sRet == "1" then
			Request_OrderAllCancel()
		end if
	
	' ----------------------------------------------------------------------
	' (미사용)수량/금액입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		edtQty_OnEditComplete()
		
		 btnCash.btnimage = "btn_02.9.png"
		 btnMax.btnimage  = "btn_02.9.png"
			
	' ----------------------------------------------------------------------
	' (미사용)가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then		
		edtPrc.caption = sRet		
		edtPrc_OnEditComplete()
	
	' ----------------------------------------------------------------------
	' (사용)가격/수량 입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "InputKeyPad" then
		
		arrData = Split(sRet,"★")
		edtPrc.caption = arrData(0)	
		edtQty.caption = arrData(1)	
		'Calc_OrderPrice()
		
	'----------------------------------------------------------------------
	' (미사용)20210329 LES START 통합증거금 - 수량조회팝업 리턴
	'----------------------------------------------------------------------
	elseif sKeyName == "16060_p8" then
		edtQty.caption = sRet
		edtQty_OnEditComplete()
	
	end if
	
End Sub

