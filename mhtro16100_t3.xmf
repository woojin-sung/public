'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn)

	szPrc  = ReSet_Prc(edtPrc.caption, nGbn)
	szHigh = g_szUpLimit
	szLow  = g_szDnLimit

	g_szUnit = GetHogaUnit(g_szMk, szPrc, nGbn) '20180710 HAMWG : 호가단위 설정함수 변경
	szUnit = g_szUnit
	
	if Trim(szPrc) == "" or CDbl(szPrc) == 0 then
		if g_szCurPrice == "" or CDbl(g_szCurPrice) == 0 then
			szPrc = 0
		else
			szPrc = g_szCurPrice
		end if
	else
		
		'------------------------------------------------
		' + 버튼 클릭
		'------------------------------------------------
		if nGbn == 0 then							
			if CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if 
			elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀
				if szLow <> "0" then
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if 
			else
				szPrc = CDbl(szPrc) + CDbl(szUnit)
			end if
		
		'------------------------------------------------
		' - 버튼 클릭 
		'------------------------------------------------
		elseif nGbn == 1 then						
			if CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if 		
			elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
				if szLow <> "0" then
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if 
			else
				szPrc = CDbl(szPrc) - CDbl(szUnit)
			end if
		end if
	end if
	
	if CDbl(szPrc) < 0 then
		szPrc = 0
	end if
	
	'---------------------------------------------------------
	' 입력값 자리수 체크
	'---------------------------------------------------------
	'if Len(szPrc) > gMaxLen then	
	'	Exit Function
	'end if
	
	edtPrc.caption = szPrc
	
End Function

'============================================================================
' 가격 호가단위 맞추기 
'============================================================================
Function ReSet_Prc(szData, nGbn)	
	if nGbn == 0 then
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))

		if nResult <> 0 and nResult <> CDbl(g_szUnit) then
			return CDbl(szData) - nResult
		else
			return szData
		end if
	else
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))
	
		if nResult <> 0 then
			return CDbl(szData) + (CDbl(g_szUnit) - nResult)
		else
			return szData
		end if
	end if
End Function

'============================================================================
' btnPPlus_OnClick : 가격 + 버튼
'============================================================================
Sub btnPPlus_OnClick()
	Calc_Price(0)
End Sub

'============================================================================
' btnPMinus_OnClick : 가격 - 버튼
'============================================================================
Sub btnPMinus_OnClick()
	Calc_Price(1)
End Sub

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn,nUnit)
	
	szQty = edtQty.caption
	
	'---------------------------------------------------------
	' (기존요건) 최대입력 가능 수량 99000000
	'---------------------------------------------------------
	'if Trim(szQty) <> "" then
	'	if CDbl(szQty) >= 99000000 then
	'		if nGbn == 0 then
	'			Exit Function
	'		end if
	'	end if
	'end if
	
	'---------------------------------------------------------
	' 수량이 빈값인 경우 매매단위로 초기화
	'---------------------------------------------------------
	if Trim(szQty) == "" then
		if nGbn == 0 then
			szQty = CDbl(nUnit)
		else
			Exit Function
		end if
	
	'---------------------------------------------------------
	' 수량이 빈값이 아닌 경우
	'---------------------------------------------------------
	else
			
		'---------------------------------------------------------
		' [+]버튼 클릭
		'---------------------------------------------------------
		if nGbn == 0 then
			szQty = CDbl(szQty) + CDbl(nUnit)
			nResult = CDbl(szQty) Mod CDbl(nUnit)
			
			if nResult <> 0 then
				szQty = CDbl(szQty) - nResult
			end if
			
		'---------------------------------------------------------
		' [-]버튼 클릭
		'---------------------------------------------------------
		elseif nGbn == 1 then
			
			if CDbl(szQty) == 0 then
				Exit Function
			else		
				szQty = szQty - CDbl(nUnit)
				nResult = CDbl(szQty) Mod CDbl(nUnit)
			end if
			
		end if
		
	end if
	
	'---------------------------------------------------------
	' 입력값 자리수 체크
	'---------------------------------------------------------
	if Len(szQty) <= gMaxLen then		
		if CStr(szQty) == "0" or CStr(szQty) == "" then
			edtQty.caption = ""
		else
			edtQty.caption = szQty
		end if
	end if
	
	Calc_OrderPrice()
	
	
End Function

'============================================================================
Sub btnQPlus_OnClick()
	Calc_Qty(0,g_szOrdSize)
End Sub

'============================================================================
Sub btnQMinus_OnClick()
	Calc_Qty(1,g_szOrdSize)
End Sub

'============================================================================
' (공통) 주문 환경설정값 적용
'============================================================================
Function Load_OrderSet()
	
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력
	g_szModAutoPrc = Trim(Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_MODPRC"))	' 주식정정주문가격 자동입력
	
	'--------------------------------------------
	' 주문확인창(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	'--------------------------------------------
	' 주문전송 후 초기화(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'--------------------------------------------
	'종목/탭 변경시 초기화 사용을 초기값으로 설정
	'종목/탭 변경시 초기화(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	

	'--------------------------------------------
	' 원주문번호 자동입력(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
End Function

