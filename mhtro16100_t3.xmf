		<CHKBUTTON name="chkAllCancel" fontsize="-2" chkcaption="전체취소" unchkcaption="전체취소" chkbtnimage="checkmenu_o" unchkbtnimage="checkmenu_n" ly_vert="284,5,91,34,1" />
		<LABEL name="LabelExchangeRate" fgcolor="333:115118124" fontsize="-3" mask="0,1,환율 ,,0,,2,1,0,0,0" bgcolor="035:237246255" halign="2" autofontsize="1" click="1" ly_vert="170,370,195,20,1" />
		<BUTTON name="btnAllCancel" visible="0" caption="일괄 취소" btnimage="btn_33.9.png" ly_vert="125,342,125,38,0" />
	</CONTROL_INFO>
