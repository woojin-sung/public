'============================================================================
' 거래소코드(4자리) <- 거래명(2자리)
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "0104" then	  ' 홍콩
		return "HK"
	elseif sValue == "0215" then ' 상해
		return "SH"
	elseif sValue == "0214" then ' 심천
		return "SZ"
	elseif sValue == "0321" then ' 뉴욕
		return "NY"
	elseif sValue == "0066" then ' 아멕스
		return "AX"
	elseif sValue == "0537" then ' 나스닥
		return "OQ"
	elseif sValue == "0106" then ' 도쿄
		return "JP"
	end if
end Function

'============================================================================
' 정정/취소화면 전용 함수
'============================================================================
Function ChangeGridType(sType)
	
	'sType : 3 => 선택종목이 없는 경우(디폴트)
	if sType == "3" then
	
		Grid0.height = 346
		
		btnMod.visible = false
		btnCancel.visible = false
		btnAllCancel.visible = false
		
		chkAll.visible = false
		LabelExchangeRate.visible = false
	
	'sType : 4 => 선택종목이 있는 경우
	elseif sType == "4" then
	
		Grid0.height = 140
		
		btnMod.visible = true
		btnCancel.visible = true
		btnAllCancel.visible = false
		
		chkAll.visible = true
		LabelExchangeRate.visible = false
		
	'sType : 5 => 전체취소 모드
	elseif sType == "5" then
	
		Grid0.height = 288
		
		btnMod.visible = false
		btnCancel.visible = false
		btnAllCancel.visible = true
		
		chkAll.visible = false
		LabelExchangeRate.visible = false
	
	end if

End Function

'============================================================================
' 미체결내역 & 미체결건수 조회
'============================================================================
Function RequestData()

	'------------------------------------------------------------------------------------
	' 미체결 내역
	'------------------------------------------------------------------------------------
	Grid0.rowcount = 0
	
	DATAMANAGER.ClearInputData(0, "obtro_oder_103r")
	
	szAcno = Form.GetTopCtlProp("acnt", "total")
	szAsno = Form.GetTopCtlProp("acnt", "sequence")
	
	nCurTabIndex = FormTab0.currenttab
	
	'전체
	if nCurTabIndex == 0 or nCurTabIndex == "0" then
		sType = "0"
	
	'매수
	elseif nCurTabIndex == 1 or nCurTabIndex == "1" then
		sType = "2"
	
	'매도
	elseif nCurTabIndex == 2 or nCurTabIndex == "2" then
		sType = "1"
	end if
	
	DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "ACNO"			, 0 , szAcno )
	DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "ASNO"			, 0 , szAsno )
	DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "ACNT_PWD"		, 0 , "" )
	DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "CNTG_CLS_CODE"	, 0 , "3")			' 체결구분코드(0:전체, 1:체결, 2:미체결, 3:미체결&온라인주문)
	DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "SELN_BYOV_CLCD"	, 0 , sType)			' 매매구분코드(0:전체, 1:매도, 2:매수)
	DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "IQRY_CLS_CODE"	, 0 , "4" )			' 조회구분코드(미사용)
	DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "PROS_CLS"		, 0 , "2" )			' 처리구분코드(1:오름차순 2:내림차순)
	DATAMANAGER.SetDataValue( 0, "obtro_oder_103r", "InBlock1", "DATA_CLS"		, 0 , "0" )			' 데이터구분코드(1:상품 그외:위탁)
	
	DATAMANAGER.RequestTranData("obtro_oder_103r")
	
	'------------------------------------------------------------------------------------
	' 미체결건수
	'------------------------------------------------------------------------------------
	DATAMANAGER.ClearInputData(0, "obtro_oder_115r")
	
	DATAMANAGER.SetDataValue( 0, "obtro_oder_115r", "InBlock1", "ACNO"			, 0 , szAcno )
	DATAMANAGER.SetDataValue( 0, "obtro_oder_115r", "InBlock1", "ASNO"			, 0 , szAsno )
	DATAMANAGER.SetDataValue( 0, "obtro_oder_115r", "InBlock1", "CNTG_CLS_CODE"	, 0 , "3")			' 체결구분코드(0:전체, 1:체결, 2:미체결, 3:미체결&온라인주문)
	DATAMANAGER.SetDataValue( 0, "obtro_oder_115r", "InBlock1", "SELN_BYOV_CLCD"	, 0 , "0")			' 매매구분코드(0:전체, 1:매도, 2:매수)
	DATAMANAGER.SetDataValue( 0, "obtro_oder_115r", "InBlock1", "PROS_CLS"		, 0 , "2" )			' 정렬구분코드(1:오름차순, 2:내림차순)
	DATAMANAGER.SetDataValue( 0, "obtro_oder_115r", "InBlock1", "DATA_CLS"		, 0 , "2" )			' 상품위탁구분코드(1:상품, 2:위탁)
	
	DATAMANAGER.RequestTranData("obtro_oder_115r")
	
End Function

'============================================================================
' 국가코드 => 국가명 가져오기
'============================================================================
Function GetCountryNameByCode(sCountryCode,sVndrCode)

	if sCountryCode = "01" then
		return "미국"
	elseif sCountryCode = "02" then
		return "홍콩"
	elseif sCountryCode = "03" then
		'return "상해"
		return "중국"
	elseif sCountryCode = "04" then
		'return "심천"
		return "중국"
	elseif sCountryCode = "05" then 
		return "일본"
	elseif sCountryCode = "06" then
		return "호주"
	elseif sCountryCode = "07" then
		return "싱가폴"
	elseif sCountryCode = "08" then
		return "영국"
	elseif sCountryCode = "09" then
		return "영국"
	elseif sCountryCode = "10" then
		return "독일"
	elseif sCountryCode = "11" then
		return "핀란드"
	elseif sCountryCode = "12" then
		return "프랑스"
	elseif sCountryCode = "13" then
		return "벨기에"
	elseif sCountryCode = "14" then
		return "네덜란드"
	elseif sCountryCode = "15" then
		return "포르투갈"
	elseif sCountryCode = "16" then
		return "그리스"
	elseif sCountryCode = "17" then
		return "아일랜드"
	elseif sCountryCode = "18" then
		return "이탈리아"
	elseif sCountryCode = "19" then
		return "스페인"
	elseif sCountryCode = "20" then
		return "오스트리아"
	elseif sCountryCode = "21" then
		return "캐나다"
	elseif sCountryCode = "23" then
		return "인도네시아"
	elseif sCountryCode = "24" then
		
		if sVndrCode == "XSTC" then 
			return "호치민"
		elseif sVndrCode == "HSTC" then
			return "하노이"
		end if
	
	elseif sCountryCode = "26" then
		return "스위스"
		
	else
		return ""
	end if 

End Function

'============================================================================
' 주문유형코드 => 주문유형명 가져오기
'============================================================================
Function GetOrderNameByCode(sCode)
	
	if sCode == "1" then
		return "시장가"
	elseif sCode == "2" then
		return "지정가"
	elseif sCode == "4" then
		return "LOO"
	elseif sCode == "5" then
		return "LOC"
	elseif sCode == "6" then
		return "MOO"
	elseif sCode == "7" then
		return "MOC"
	elseif sCode == "8" then
		return "Limit VWAP"
	elseif sCode == "9" then
		return "Limit TWAP"
	elseif sCode == "A" then
		return "VWAP"
	elseif sCode == "B" then
		return "TWAP"
	else
		return ""
	end if

End Function

'============================================================================
' 주문상태코드 => 주문상태명 가져오기
'============================================================================
Function GetOrderStateNameByCode(sCode)

	if sCode == "0" then
		return "정상"
	elseif sCode == "1" then
		return "거부"
	elseif sCode == "2" then
		return "자동거부"
	elseif sCode == "3" then
		return "자동취소"
	elseif sCode == "4" then
		return "미접수"
	else
		return ""
	end if
	
End Function

'============================================================================
' 매매구분코드 => 매매구분명
'============================================================================
Function GetGubunNameByCode(sCode,sRctCode,nIndex)

	' 매매구분
	if sCode == "1" then
	
		Grid0.SetCellFgColor( "bd_ordergubun", nIndex, "2" )
		
		if sRctCode == "1" then
			return "매도정정"
		elseif sRctCode == "2" then
			return "매도취소"
		else
			return "매도"
		end if
		
	elseif sCode == "2" then
	
		Grid0.SetCellFgColor( "bd_ordergubun", nIndex, "1" )
		
		if sRctCode == "1" then
			return "매수정정"
		elseif sRctCode == "2" then
			return "매수취소"
		else
			return "매수"
		end if
		
	end if 

	
End Function

'============================================================================
' 미체결 종목 선택
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)

	'-----------------------------------------------
	'전체취소 체크 상태
	'-----------------------------------------------
	if chkAllCancel.checkstate == "1" then
	
		'-----------------------------------------------
		' 선택한 행이 체크상태이면 미체크/미체크상태이면 체크
		'-----------------------------------------------
		SetCheckReverse(lRow,szCellID)
		
		'-----------------------------------------------
		'체크종목 개수 확인
		'-----------------------------------------------
		nCheckCnt = GetCheckNum()
		
		'-----------------------------------------------
		'체크된 행의 개수에 따라 전체취소모드 설정/해제
		'-----------------------------------------------
		nRowCnt = Grid0.rowcount
		
		'-----------------------------------------------
		'모든행이 체크되어있는 경우 전체취소모드 자동전환
		'-----------------------------------------------
		if nCheckCnt == nRowCnt then
			chkAllCancel.chksilence = "1"
			ChangeGridType("5")
		end if
		
		'-----------------------------------------------
		'모든행이 미체크되어있는 경우 전체취소모드 자동해제
		'-----------------------------------------------
		if nCheckCnt == 0 then
			chkAllCancel.chksilence = "0"
			ChangeGridType("3")
		end if
		
	
	'-----------------------------------------------
	'전체취소 미체크 상태
	'-----------------------------------------------
	else
		
		'-----------------------------------------------
		'선택한 행 이외에 나머지 행 체크되어있다면 해제
		'-----------------------------------------------
		SetCheckExceptSelectRow(lRow,szCellID)
		
		'-----------------------------------------------
		'체크종목 개수 확인
		'-----------------------------------------------
		nCheckCnt = GetCheckNum()
		
		'-----------------------------------------------
		'체크된 행개수에 따른 현재화면 컨트롤 위치조정
		'-----------------------------------------------
		if nCheckCnt > 0 then
			ChangeGridType("4")
		else
			ChangeGridType("3")
		end if
		
		'-----------------------------------------------
		'체크된 행개수에 따른 메인화면 호가영역 위치조정
		'-----------------------------------------------
		if nCheckCnt > 0 then
			Form.triggerEvent("#", "ChangeContHoga", "4")
		else
			Form.triggerEvent("#", "ChangeContHoga", "3")
		end if
		
		
		'-----------------------------------------------
		'메인화면에 선택한 종목정보 던지기
		'-----------------------------------------------
		sVndrCode = Grid0.GetCellData("bd_vndrcode", lRow)
		
		sMarektCode = Transform_Exid(sVndrCode)
		sCode = Grid0.GetCellData("bd_code", lRow) 
		sName = Grid0.GetCellData("bd_name", lRow)
		
		szData = sMarektCode .. "@" .. sCode .. "★" .. sName
		Form.triggerEvent("#", "SendModCancelItem", szData)
		
		'-----------------------------------------------
		'선택행 주문에 필요한 데이터 가져오기
		'-----------------------------------------------
		szChk = CInt(Grid0.GetCellData("bd_check", lRow))
		
		if szChk == 1 then
		
			'---------------------------------------------------------------------
			'미체결그리드에서 넘어온 가격/수량이 클리어 되지 않도록해주는 변수
			'---------------------------------------------------------------------
			gReturnQtyPrice = true
			
			'---------------------------------------------------------------------
			'자동 수량/가격 세팅해주기 위해 일회성으로 얻어오는 값.
			'실제로 주문전송 시에는 컨트롤에 있는 값을 읽어와서 주문 낸다.
			'---------------------------------------------------------------------
			sOrdMiChecQty	 = Grid0.GetCellData("bd_micheqty", lRow)
			sOrdPrice	 = Grid0.GetCellData("bd_orderprice", lRow)
			
			edtQty.caption = sOrdMiChecQty
			
			'------------------------------------------------------------------------
			'20240716 정정가격 자동입력 사용불가(미사용)할때만 주문가격 연동해줌.
			'------------------------------------------------------------------------
			'edtPrc.caption = sOrdPrice
			'------------------------------------------------------------------------
			'Form.ShowAlert("sOrdPrice", sOrdPrice)
			if g_szChangeInit <> "1" then
				if g_szModAutoPrc == "0" or g_szModAutoPrc == "" then
					edtPrc.caption = sOrdPrice
				end if
			else
				edtPrc.caption = sOrdPrice
			end if
			'------------------------------------------------------------------------
			
			'---------------------------------------------------------------------
			'20240709 주문유형에 따라 가격입력창 비활성화
			'시장가/MOO/MOC/VWAP/TWAP 처럼 가격을 입력하지 않는 주문의 경우 정정불가
			'---------------------------------------------------------------------
			sOrdClsCode = Grid0.GetCellData("bd_ordercode", lRow)
			SetcmbTypeIndex(sOrdClsCode)	
			'if sOrdClsCode == "1" or sOrdClsCode == "6" or sOrdClsCode == "7" or sOrdClsCode == "A" or sOrdClsCode == "B" then
			'	
			'	btnPrc.enable = false
			'	btnPPlus.enable = false
			'	btnPMinus.enable = false
			'	edtPrc.enable = false
			'	
			'else
			'
			'	btnPrc.enable = true
			'	btnPPlus.enable = true
			'	btnPMinus.enable = true
			'	edtPrc.enable = true
			'
			'end if
			'---------------------------------------------------------------------
			
		end if
		
	
	end if

	
	
End Sub

'============================================================================
' 선택행의 체크상태를 반대로 바꿔준다.
'============================================================================
Function SetCheckReverse(nRow,sCellD)

	if sCellD <> "bd_check" then
	
		szChk = CInt(Grid0.GetCellData("bd_check", nRow))
		
		if szChk == 1 then
			Grid0.SetCellData("bd_check", nRow, "0")
		else
			Grid0.SetCellData("bd_check", nRow, "1")
		end if
	
	end if
	

End Function
'============================================================================
' 선택행 외에 체크된 행이 있다면 체크해제 / 선택행이 이미 체크되어있는 상태이면 체크해제
'============================================================================
Function SetCheckExceptSelectRow(nRow,sCellID)
	
	nRowCnt = Grid0.rowcount
	
	for i = 0 to nRowCnt - 1
	
		if i <> nRow then
			Grid0.SetCellData("bd_check", i, "0")
		else
		
			'체크버튼을 직접 클릭한 경우에는 자기가 알아서 체크/체크해제 되므로
			'toprow세팅만 해준다.
			if sCellID <> "bd_check" then
		
				szChk = CInt(Grid0.GetCellData("bd_check", i))
				
				if szChk == 1 then
					Grid0.SetCellData("bd_check", i, "0")
				else
			
					Grid0.SetCellData("bd_check", i, "1")
					Grid0.toprow = nRow
					
				end if
			else
			
				Grid0.toprow = nRow
			
			end if
			
		end if
	
	next


End Function
'============================================================================
' 체크종목 개수 확인
'============================================================================
Function GetCheckNum()
	
	nRowCnt = Grid0.rowcount
	nCheckCnt = 0
	
	for i = 0 to nRowCnt - 1
	
		szChk = CInt(Grid0.GetCellData("bd_check", i))
		
		if szChk == 1 then
			nCheckCnt = nCheckCnt + 1
		end if
		
	
	next
	
	return nCheckCnt

End Function
'============================================================================
' 체크되어있는 인덱스 가져오기
' for문 돌아서 비효율적이긴한데 안전하게...
'============================================================================
Function GetCheckIndex()
	
	Dim nRowCnt
	nRowCnt = Grid0.rowcount
	
	for i = 0 to nRowCnt - 1
	
		szChk = CInt(Grid0.GetCellData("bd_check", i))
		
		if szChk == 1 then
			return i
		end if
	next
	
	return -1

End Function

'============================================================================
Sub chkAllCancel_OnChange(sCheckState)
	
	if sCheckState == 1 or sCheckState == "1" then
		
		'----------------------------------
		' 전체 미체결내역 체크
		'----------------------------------
		if gOsType == "1" then
			
			nCnt = Grid0.rowcount
			
			for i = 0 to nCnt - 1
				Grid0.SetCellData("bd_check", i, "1")
			next
			
		else
			Grid0.SetPropGridCell("allcheck","bd_check",0,"")
		end if
		
		'전체취소 모드 일때는 
		'현재화면/메인화면 선택종목 없을때 처럼 컨트롤 위치 이동
		Form.triggerEvent("#", "ChangeContHoga", "3")
		ChangeGridType("5")
	
	else
		
		'----------------------------------
		' 전체 미체결내역 체크해제
		'----------------------------------
		if gOsType == "1" then
			
			nCnt = Grid0.rowcount
			
			for i = 0 to nCnt - 1
				Grid0.SetCellData("bd_check", i, "0")
			next
			
		else
			Grid0.SetPropGridCell("alluncheck","bd_check",0,"")
		end if
		
		
		ChangeGridType("3")
	
	end if
	
End Sub

'============================================================================
' 새로고침
'============================================================================
Sub imgRefresh_OnClick()
	
	'미체결조회 서비스 호출
	RequestData()
	
	'전체취소버튼 미체크 상태로 전환
	chkAllCancel.chksilence = "0"
	
	'메인화면 호가영역 숨기기
	Form.triggerEvent("#", "ChangeContHoga", "3")
	
	'그리드상태 초기화
	ChangeGridType("3")
	Grid0.SetPropGridCell("alluncheck","bd_check",0,"")
	
	
End Sub

'============================================================================
' 탭변경
'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	
	'전체취소버튼 미체크 상태로 전환
	chkAllCancel.chksilence = "0"
	
	'그리드 체크 모두 해제
	Grid0.SetPropGridCell("alluncheck","bd_check",0,"")

	'미체결조회 서비스 호출
	RequestData()
	
End Sub

'====================================================================================
' 주문/체결 탭에서 넘어온 미체결종목을 찾는다. 있으면 해당 인덱스 리턴 없으면 -1 리턴
'====================================================================================
Function SearchMiCheLinkItemIndex(sLinkVndrCode,sLinkItemCode,sLinkOrdNo) 
	
	for i = 0 to Cint(Grid0.rowcount) -1
		
		sRowVndrCode = Grid0.GetCellData("bd_vndrcode", i)
		sRowItemCode = Grid0.GetCellData("bd_code", i)
		sRowOrdNo = Grid0.GetCellData("bd_orderno", i)
		'Form.showAlert(sLinkVndrCode.."//"..sLinkItemCode.."//"..sLinkOrdNo,sRowVndrCode.."//"..sRowItemCode.."//"..sRowOrdNo)
		if sRowVndrCode == sLinkVndrCode and sRowItemCode == sLinkItemCode and sRowOrdNo == sLinkOrdNo then
			return i
		end if
		
	next
	
	return -1
	
End Function

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(1, 0, 0.5)
	imgRefresh_OnClick()
End Sub

'============================================================================
Function SetcmbTypeIndex(sOrdClsCode)
	
	'--------------------------------
	' 시장가
	'--------------------------------
	if sOrdClsCode == "1" then
		'return "시장가"
		cmbType.currentindex = "1"
		cmbType.fontsize = -2
	
	'--------------------------------
	' 지정가
	'--------------------------------
	elseif sOrdClsCode == "2" then
		'return "지정가"
		cmbType.currentindex = "0"
		cmbType.fontsize = -2
	
	'--------------------------------
	' LOO
	'--------------------------------
	elseif sOrdClsCode == "4" then
		'return "LOO"
		cmbType.currentindex = "2"
		cmbType.fontsize = -2
	
	'--------------------------------
	' LOC
	'--------------------------------
	elseif sOrdClsCode == "5" then
		'return "LOC"
		cmbType.currentindex = "3"
		cmbType.fontsize = -2
	
	'--------------------------------
	' MOO
	'--------------------------------
	elseif sOrdClsCode == "6" then
		'return "MOO"
		cmbType.currentindex = "4"
		cmbType.fontsize = -2
	
	'--------------------------------
	' MOC
	'--------------------------------
	elseif sOrdClsCode == "7" then
		'return "MOC"
		cmbType.currentindex = "5"
		cmbType.fontsize = -2
	
	'--------------------------------
	' Limit VWAP
	'--------------------------------
	elseif sOrdClsCode == "8" then
		'return "Limit VWAP"
		cmbType.currentindex = "8"
		cmbType.fontsize = -3
	
	'--------------------------------
	' Limit TWAP
	'--------------------------------
	elseif sOrdClsCode == "9" then
		'return "Limit TWAP"
		cmbType.currentindex = "9"
		cmbType.fontsize = -3
	
	'--------------------------------
	' VWAP
	'--------------------------------
	elseif sOrdClsCode == "A" then
		'return "VWAP"
		cmbType.currentindex = "6"
		cmbType.fontsize = -2
	
	'--------------------------------
	' TWAP
	'--------------------------------
	elseif sOrdClsCode == "B" then
		
		cmbType.currentindex = "7"
		cmbType.fontsize = -2
	
	'--------------------------------
	' 예외처리(값이없을 경우 지정가로 세팅)
	'--------------------------------
	else
		
		cmbType.currentindex = "0"
		cmbType.fontsize = -2
		
	end if
	
End Function

'============================================================================
Function CheckSelectItemAndCurrentItem()

	'-----------------------------------------------
	'전체취소 체크 상태가 아닐 때
	'-----------------------------------------------
	if chkAllCancel.checkstate <> "1" then
		
		'------------------------------------------------------------------
		'선택되어있는 종목과 현재 종목이 다를 시, 체크해제 및 컨트롤 초기화
		'------------------------------------------------------------------
		nSelectIndex = GetCheckIndex()
		
		
		
		if nSelectIndex >= 0 then
		
			sVndrCode = Grid0.GetCellData("bd_vndrcode", nSelectIndex)
			sMarektCode = Transform_Exid(sVndrCode)
			sCode = Grid0.GetCellData("bd_code", nSelectIndex) 
		
			sSelectItemCode = sMarektCode & "@" & sCode
			
			
			if g_szCd <> sSelectItemCode then
				imgRefresh_OnClick()
			
			else
				
				'------------------------------------------------------------------------
				'20240716 [종목변경되었을때] CheckSelectItemAndCurrentItem가 호출 됨.
				'정정주문가격 자동입력 설정여부에 따라 가격 자동입력
				'------------------------------------------------------------------------
				if g_szChangeInit <> "1" and g_szModAutoPrc <> "0" and g_szModAutoPrc <> "" then
					RequestAutoPrice()
				end if
				'------------------------------------------------------------------------
			
			end if
			
'		else
'			
'			if gbLinkMiCheItem == true then
'				
'				'------------------------------------------------------------------------
'				'20240716 [종목변경되었을때] CheckSelectItemAndCurrentItem가 호출 됨.
'				'주문/체결탭에서 미체결종목이 연동되었을때, nSelectIndex값이 아직 설정되기 전임.
'				'gbLinkMiCheItem값으로 미체결종목 연동 시
'				'정정주문가격 자동입력 설정여부에 따라 가격 자동입력
'				'------------------------------------------------------------------------
'				if g_szChangeInit <> "1" and g_szModAutoPrc <> "0" then
'					RequestAutoPrice()
'				end if
'				'------------------------------------------------------------------------
'				
'			end if
			
		end if
		
	end if

End Function

