'============================================================================
Sub Form_OnFormInitBefore()

	gOsType = Form.GetSharedData("&OS_TYPE", false)

	imgRefresh.setMaintainingRatio("1")
	imgNodata.setMaintainingRatio("1")

End Sub
'============================================================================
Sub Form_OnFormInit()
	
	'--------------------------------------------------
	' 컨트롤 설정
	'--------------------------------------------------
	btnQMinus.visible = false
	btnQPlus.visible = false
	edtQty.enable = false
	
	btnQty.left = 170
	btnQty.width = 195
	
	edtQty.left = 170
	edtQty.width = 195
	
	Grid0.SetUseLoadFast(true) 'iOS전용(체크이미지 변경 속도개선)
	chkAll.SetAlpha("0.5")
	
	
	'--------------------------------------------------
	'그리드 타입 설정(디폴트:선택종목 없는 상태)
	'--------------------------------------------------
	ChangeGridType("3")
	
	'--------------------------------------------------
	' 폼탭 헤더 생성(전체/매수/매도)
	'--------------------------------------------------
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 6) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") 								 '활성화/비활성화 폰트색상

	FormTab0.insertPage( FormTab0.tabcount, "page1", "page1", "empty", "0", "전체")
	FormTab0.insertPage( FormTab0.tabcount, "page2", "page2", "empty", "0", "매수")
	FormTab0.insertPage( FormTab0.tabcount, "page3", "page3", "empty", "0", "매도")

	FormTab0.currenttab = 0

	'--------------------------------------------------
	' 주문환경설정 값 Load
	'--------------------------------------------------
	Load_OrderSet()
	
	
	'--------------------------------------------------
	' 주문유형콤보리스트 세팅
	'--------------------------------------------------
	SetOrderTypeList("")
	
	'--------------------------------------------------
	' 미체결 내역 조회
	'--------------------------------------------------
	RequestData()
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'Form.ShowAlert(sEventName, sParam)
	'============================================================================
	' 종목정보 연동
	'============================================================================
	if sEventName == "SEND_ITEM_INFO" then
	
		'-----------------------------------------------------------------------
		'현재가★상한가★하한가★매매단위★통화★소수점자리수★한글종목명★틱타입
		'-----------------------------------------------------------------------
		arrItemInfo = Split(sParam, "★")
		
		g_szCurPrice 	= arrItemInfo(0)
		g_szUpLimit	= arrItemInfo(1)
		g_szDnLimit	= arrItemInfo(2)
		g_szOrdSize 	= arrItemInfo(3)
		g_szCurrency	= arrItemInfo(4)
		g_szDecimal	= arrItemInfo(5)
		g_szKorName	= arrItemInfo(6)
		g_szTickType	= arrItemInfo(7)
		g_szUnit		= GetHogaUnit(g_szMk, g_szCurPrice, 0)
	
		'-----------------------------------------------------------------------
		'가격입력창 소수점 자리수 세팅 / 통화기호 세팅
		'-----------------------------------------------------------------------
		if g_szCurrency <> "" then
			sMask = "0,0,,".. " " .. g_szCurrency .. ",0,,"..g_szDecimal..",1,1,2,0"
		else
			sMask = "0,0,,,0,,"..g_szDecimal..",1,1,2,0"
		end if
		
		edtPrc.mask = sMask
		
		'-----------------------------------------------------------------------
		'수량입력창 매매단위 세팅
		'-----------------------------------------------------------------------
		if g_szOrdSize <> "" then
			edtQty.hintcaption = Cint(g_szOrdSize).."주 단위"
		end if
		
		'-----------------------------------------------------------------------
		'종목/탭 변경시 가격입력창/수량입력창 입력값 초기화 
		'-----------------------------------------------------------------------
		if g_szChangeInit == "1" then
			Init_InputControl()
		end if
		
		'-----------------------------------------------------------------------
		'국가별 주문가능 주문유형 설정
		'-----------------------------------------------------------------------
		'SetOrderTypeList(g_szNg)
		
		'-----------------------------------------------------------------------
		'통화별 환율 조회
		'-----------------------------------------------------------------------
		RequestExChangeRate()
	
	'============================================================================
	' 호가조회 완료(가격/수량 자동입력 요청)
	'============================================================================
	elseif sEventName == "HOGA_COMPLETE" then
	
		'---------------------------------------------------------------------------------
		' [금액 자동입력]
		'---------------------------------------------------------------------------------
		' 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅
		' 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
		'---------------------------------------------------------------------------------
		'sPrice = Form.GetSharedData("PRICE", true)
		'
		'if sPrice <> "" and sPrice <> null	then
		'	edtPrc.caption = sPrice
		'	
		'else
		'	
		'	if g_szChangeInit <> "1" then
		'		RequestAutoPrice()
		'	end if
		'
		'end if
		
		'---------------------------------------------------------------------------------
		' [수량 자동입력]
		'---------------------------------------------------------------------------------
		'if g_szChangeInit <> "1" then
		'	RequestAutoQty()
		'end if
		
		CheckSelectItemAndCurrentItem()
		
	'============================================================================
	' 클릭 호가 연동
	'============================================================================
	elseif sEventName == "CLICK_HOGA" then
		
		if Check_PrcOrd() <> "시장가" then
			edtPrc.caption = sParam
			'Calc_OrderPrice()
		end if
		
	'============================================================================
	' 종목코드 초기화/종목코드 변경/탭 변경
	'============================================================================
	elseif sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then
		
		if g_szCd <> sParam then
			
			g_szCd = sParam
			g_szNg = Form.GetItemCodeInfo(g_szCd, "ovsnation")	' 국가구분코드
			g_szMk = Form.GetItemCodeInfo(g_szCd, "exchid")		' 거래소벤더코드
			
			'---------------------------------------------------------------------------------
			'환율정보 라벨 클리어(이전 데이터 남아있어 깜빡임 방지)
			'---------------------------------------------------------------------------------
			LabelExchangeRate.caption = ""
			
			if sEventName == "ChangeTab" then
				
				'---------------------------------------------------------------------------------
				' [금액 자동입력]
				'---------------------------------------------------------------------------------
				' 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅
				' 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
				'---------------------------------------------------------------------------------
				'sPrice = Form.GetSharedData("PRICE", true)
				'
				'if sPrice <> "" and sPrice <> null	then
				'	edtPrc.caption = sPrice
				'	
				'else
				'	
				'	if g_szChangeInit <> "1" then
				'		RequestAutoPrice()
				'	end if
				'
				'end if
				
				'--------------------------------------------------
				' 전체취소 체크해제
				'--------------------------------------------------
				chkAllCancel.checkstate = 0
				
				'--------------------------------------------------
				' 미체결 내역 조회
				'--------------------------------------------------
				RequestData()
							
			end if
			
		
		else
		
			'---------------------------------------------------------------------------------
			' 정정/취소 탭에 위치한 상태에서 다시 정정/취소 탭 눌렀을때, 
			' 종목코드는 그대로지만 그리드 타입 초기화
			'---------------------------------------------------------------------------------
			if sEventName == "ChangeTab" then
				'전체취소버튼 미체크 상태로 전환
				chkAllCancel.chksilence = "0"
					
				'메인화면 호가영역 숨기기
				Form.triggerEvent("#", "ChangeContHoga", "3")
				
				'그리드상태 초기화
				ChangeGridType("3")
				Grid0.SetPropGridCell("alluncheck","bd_check",0,"")
				
				'--------------------------------------------------
				' 미체결 내역 조회
				'--------------------------------------------------
				RequestData()
				
			end if
			
		end if
		
	'============================================================================
	' 매수가격 자동입력
	'============================================================================
	elseif sEventName == "ReturnAutoPrice" then
		
		'------------------------------------------------------------------------
		'20240716
		'------------------------------------------------------------------------
		if Check_PrcOrd() <> "시장가" then
			edtPrc.caption = sParam
		end if
		
	'============================================================================
	' 계좌변경(통합증거금 약정여부 조회 및 입력창 초기화)
	'============================================================================	
	elseif sEventName == "ChangeAcnt" then
	
		RequestCombinedMargin()
		imgRefresh_OnClick()
		
		if g_szChangeInit == "1" then
			Init_InputControl()
		end if
		
	'============================================================================
	' 주문/체결 탭에서 미체결수량이 있는 종목 선택 시 연동
	'============================================================================
	elseif sEventName == "SendMiChegyulItem" then
		
		'----------------------------------------------------------------------------------------
		'Init_InputControl() 		: gReturnQtyPrice가 true 일떄 입력창 클리어안함
		'obtro_oder_103r Complete 	: gbLinkMiCheItem가 true 일때 입력창 클리어 안함.
		'----------------------------------------------------------------------------------------
		'입력창 클리어해주는 부분이 호출되는 시점이 랜덤이라.. 둘다 true로 변환하여
		'입력창이 클리어되지 않고, 주문/체결탭에서 넘어온 미체결종목의 수량/가격이 세팅되게한다.
		'----------------------------------------------------------------------------------------
		gReturnQtyPrice = true
		gbLinkMiCheItem = true
		
		'--------------------------------------------------
		' 미체결 종목정보
		'--------------------------------------------------
		gLinkMiCheItemInfo = sParam	
		
		'--------------------------------------------------
		'전체탭으로 이동
		'--------------------------------------------------
		FormTab0.currenttab = 0
		
		'--------------------------------------------------
		'전체취소버튼 미체크 상태로 전환
		'--------------------------------------------------
		chkAllCancel.chksilence = "0"
	
		'--------------------------------------------------
		'그리드 체크 모두 해제
		'--------------------------------------------------
		Grid0.SetPropGridCell("alluncheck","bd_check",0,"")
		
		'--------------------------------------------------
		' 미체결 내역 조회
		'--------------------------------------------------
		RequestData()
		
	'============================================================================
	' 약정 계좌 > 미약정 계좌로 변경 시 데이터 클리어를 위해 호출
	'============================================================================
	elseif sEventName == "ClearData" then
		
		imgRefresh_OnClick()
		
	'============================================================================
	' 주문/체결 탭에서 [미체결] 조회 시, [전체 취소하기] 버튼 클릭 이벤트
	'============================================================================
	elseif sEventName == "SEND_ALL_CANCEL" then
		
		gAllCancelSend = true
		FormTab0.currenttab = 0
		RequestData()
		
	'============================================================================
	' 비밀번호 검증 후 주문확인창 자동 오픈
	'============================================================================
	elseif sEventName == "OPEN_CONFIRM" then
		
		if gOrderReqIndex == 1 then
			btnMod_OnClick()
		elseif gOrderReqIndex == 2 then
			btnCancel_OnClick()
		elseif gOrderReqIndex == 3 then
			btnAllCancel_OnClick()
		end if
		
	'============================================================================
	'20240716 정정/취소탭은 동일종목 선택하거나, 앱 포그라운드 전환 시에도 
	'종목변경되었을때 처럼 이벤트 발생시켜 미사용 트리거
	'============================================================================
	'elseif sEventName == "RefreshData" then
	
		'Form.ShowAlert(sEventName, sParam)
		'------------------------------------------------------------------------
		'20240716 [종목변경 안되었을때] 호출됨.
		'정정주문가격 자동입력 설정여부에 따라 가격 자동입력
		'------------------------------------------------------------------------
		'if g_szChangeInit <> "1" and g_szModAutoPrc <> "" then
		'	RequestAutoPrice()
		'end if
		'------------------------------------------------------------------------
		
	'============================================================================
	' 20240716 주간장 현재가 세팅(가격자동입력 활성화 & 현재가 세팅으로 되어있을때)
	'============================================================================
	elseif sEventName == "SEND_DAYMARKET_PRC" or sEventName == "SEND_AFTERMARKET_PRC" then
	
		if g_szChangeInit <> "1" and sParam <> "" then
			
			if g_szModAutoPrc == "11" and Check_PrcOrd() <> "시장가" then
				edtPrc.caption = sParam
			end if
			
		end if
		
		
	'주문번호 연동 => 원주문번호만으로 주문가능? 주문일자 반드시 넣어줘야하면 무쓸모임
	elseif sEventName == "AFTER_ORGNO" then
		
	end if
	
End Sub

