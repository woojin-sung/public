'============================================================================
' (가격)자동입력값 요청
'============================================================================
Function RequestAutoPrice()
	
	Form.triggerEvent("#", "RequestAutoPrice", "MOD")

End Function

'============================================================================
' (가격/수량)입력창 입력값 초기화
'============================================================================
Function Init_InputControl()
	
	if g_szChangeInit == "1" then
		
		'----------------------------------------------------
		' 미체결 그리드에서 종목선택한 경우 gReturnQtyPrice = true
		' gReturnQtyPrice == true인 경우에는 미체결그리드에서 넘어온
		' 미체결수량/주문가격이 입력창에 세팅될 수 있도록 
		' 입력창 클리어해주지 않음.
		'
		' 주문/체결탭에서 종목 선택한 경우 gbLinkMiCheItem = true
		' gbLinkMiCheItem == true인 경우에는 주문/체결탭에서 넘어온
		' 미체결수량/주문가격이 입력창에 세팅될 수 있도록
		' 입력창 클리어해주지 않음.
		'----------------------------------------------------
		if gReturnQtyPrice == true then
			gReturnQtyPrice = false
		
		else
			gReturnQtyPrice = false
			edtQty.caption = ""
			edtPrc.caption = ""
		end if
		
	end if
	
End Function

'============================================================================
' 거래소 호가단위 설정
'============================================================================
Function GetHogaUnit(szMk, szPrc, nGbn) 
	
	'-----------------------------------------------------------------------
	' 호가단위 초기화
	'-----------------------------------------------------------------------
	szOrdPrc = CDbl(szPrc)
	
	if szOrdPrc == "" then
		if g_szCurPrice = "" or CDbl(g_szCurPrice) == 0 then
			szOrdPrc = 0		
		else
			szOrdPrc = CDbl(g_szCurPrice)
		end if	
	end if
	
	szUnit = "1.000"
	
	'-----------------------------------------------------------------------
	' 틱타입 확인
	'-----------------------------------------------------------------------
	szTtype = Cint(g_szTickType)

	if szTtype == 0 or szTtype == "" then
		szTtype = "0"
	end if
	
	'-----------------------------------------------------------------------
	' 중국(상해/심천) 호가단위 설정
	'-----------------------------------------------------------------------
	if szMk == "0215" then '상해
		
		'20240613 LES START 틱단위 수정
		if szTtype = 2 then 'ETF
			szUnit = "0.001"
		else
			szUnit = "0.010"
		end if
		'20240613 LES END
		
	elseif szMk == "0214" then '심천
		
		'20240613 LES START 틱단위 수정
		if szTtype = 2 then 'ETF
			szUnit = "0.001"
		else
			szUnit = "0.010"
		end if
		'20240613 LES END
		
	'-----------------------------------------------------------------------
	' 미국(뉴욕/나스닥/아멕스) 호가단위 설정
	'-----------------------------------------------------------------------
	elseif szMk == "0321" or szMk == "0537" or szMk == "0066" then '뉴욕, 나스닥, 아멕스
		
		'20240702 LES START - 1달러미만 종목 0.0001단위
		if szOrdPrc < 1.00 then
			szUnit = "0.0001" 
		else
			if szTtype == 1 then
				szUnit = "0.010"
				
			elseif szTtype == 2 then
				szUnit = "0.050"
				
			elseif szTtype == 3 then
				szUnit = "0.050"
				
			elseif szTtype == 4 then
				szUnit = "0.050"
				
			else
				szUnit = "0.010"
			end if
		end if
		
	'-----------------------------------------------------------------------
