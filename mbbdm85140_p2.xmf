						<CELL cell_ly="0,1,0,1" halign="0" line="0,0" caption="따라 고객님의 투자자 정보를 파악하여, 그에 적합한" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,2,0,2" halign="0" line="0,0" caption="투자권유를 해드리기 위한 기초 자료로 활용됩니다." fontsize="-1" impidxs="" />
						<CELL cell_ly="0,3,0,3" halign="0" line="0,0" caption="고객님이 적정성 원칙 대상 상품을 거래하고자 하는" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,4,0,4" halign="0" line="0,0" caption="경우에는 반드시 작성하셔야 합니다." fontsize="-1" impidxs="" />
						<CELL cell_ly="0,5,0,5" halign="0" line="0,0" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,6,0,6" halign="0" line="0,0" caption="투자자정보확인서 작성 후 유효기간(24개월)이 경과" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,7,0,7" halign="0" line="0,0" caption="하거나 적정성 원칙 대상상품을 신청한 경우 투자자" fontsize="-1" impidxs="" />
						<CELL cell_ly="0,8,0,8" halign="0" line="0,0" caption="정보확인서를 작성하셔야 거래 가능합니다." fontsize="-1" impidxs="" />
