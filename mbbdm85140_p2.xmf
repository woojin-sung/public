	<SCRIPT_INFO _len="791" _ulen="773" >

Dim g_szReturn

'============================================================================
Sub Form_OnFormInit()
	g_szReturn = "N"
	
	Dim szOSType
	szOSType = Form.GetSharedData("&OS_TYPE", false)

	'OS별로 컨트롤 위치 조정
	If szOSType == "2" Then
		Container.Label0.top = 30
		Container.Table0.top = 72
	End If
End Sub

'============================================================================
Sub BtnNew_OnClick()
	g_szReturn = "Y"
	Form.CloseForm()
End Sub

'============================================================================
Sub ImgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbbdm85140_p2" , g_szReturn)
End Sub

