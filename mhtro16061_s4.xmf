'****************************************************************************

' ----- 주문설정값 공통변수 Start -------------------------------------------
'주문 환경
Dim g_szOdrPop

' 가격, 수량 설정
Dim g_szAfterInit
Dim g_szChangeInit

' 주문후 
Dim g_szAfterOrg

' ----- 주문설정값 공통변수 End ---------------------------------------------
Dim g_szCd, g_szNg, g_szMk

Dim g_szTR

Dim g_szTitle
g_szTitle = "알림"

Dim g_szQty
g_szQty = ""

Dim g_bCntrtRtn		' 미체결리턴
g_bCntrtRtn = false

' 20171204 HAMWG START : 해외주식_공유변수 선언
Dim g_szOrdSize		' 매매단위
g_szOrdSize = ""

Dim g_szLast			' 현재가
g_szLast = ""

Dim g_szUpLimit		' 상한가
g_szUpLimit	=  ""

Dim g_szDnLimit		' 하한가
g_szDnLimit	=  ""

Dim g_szUnit			' 호가단위
g_szUnit		=  ""

Dim g_szDecimal		' 종목가격 자릿수
g_szDecimal	=  ""

Dim g_szKorName		' 한글종목명
g_szKorName	=  ""

Dim g_szTickType		' 종목틱타입
g_szTickType	=  ""
' 20171204 HAMWG END

