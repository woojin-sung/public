'============================================================================
' Init_AfterOrder : 주문후 초기화
'============================================================================
Function	Init_InputControl()
'	edtOrgNo.caption = ""
'	edtOrgNo_OnEditComplete()

	if g_bCntrtRtn == false then
	edtOrgNo.caption = ""
	edtOrgNo_OnEditComplete()
	
		g_szQty = ""	
		edtQty.caption = ""
		edtQty_OnEditComplete()	
	end if
End Function

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력
	
	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170725 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170725 HAMWG END
	
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if	
End Function

'============================================================================
' Check_InputData
'============================================================================
Function Check_InputData(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Check_Account(nGbn) == false then
		return false
	end if

	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if

	if Trim(edtOrgNo.caption) == "" then
		Form.ShowAlert(g_szTitle, "원주문번호를 입력하십시요.")
		return false
	end if
	
	if chkAll.checkstate == "0" then		' 일부잔량 선택시
		if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
			Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
			return false
		end if
	end if
		
	if nGbn <> 2 then	
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup()
		else
			Request_Order()
		end if
	end if
	
	return true
End Function

'============================================================================
' Open_ConfirmPopup
'============================================================================
Function Open_ConfirmPopup(szWarn)
	Dim szData
	
	szData = "3"													' 매매구분
	szData = szData & "|" & Form.GetTopCtlProp("acnt", "caption")		' 계좌번호
	szData = szData & "|" & Form.GetTopCtlProp("acnt", "accountname")	' 계좌명
	szData = szData & "|" & g_szCd									' 종목코드
	szData = szData & "|" & g_szKorName								' 종목명
	szData = szData & "|" & "보통"									' 주문구분
	szData = szData & "|" & "0"										' 현금
	szData = szData & "|" & edtQty.caption							' 주문수량
	szData = szData & "|" & edtOrgNo.caption							' 원주문번호
	szData = szData & "|" & chkAll.checkstate						' 전량전부
	
	Form.OpenPopup("mhtro16060_p6", szData , "")		' 주문확인팝업 오픈
End Function

'============================================================================
' Request_Order
'============================================================================
Function Request_Order()
	DATAMANAGER.RequestTranData("obtrs_oder_102a")
End Function

'============================================================================
' Check_Account
'============================================================================
Function Check_Account(nGbn)
	Dim szAcnt, szPwd
	
	szAcnt = Form.GetTopCtlProp("acnt", "caption")
	
	If Len(szAcnt) < 10 Then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
		return False
	end If
	
	if nGbn <> 2 then
		szPwd = Form.GetTopCtlProp("edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function

'============================================================================
' Return_ContractScreen : 미체결팝업에서 리턴된 값 적용
'============================================================================
Function Return_ContractScreen(szRet)
	tData = Split(szRet, "♥")
	
	if UBound(tData) > 0 then
		' 메인화면에서 종목변경에 따른 구분자를 넣어준것
		if tData(5) == "1" then
			g_bCntrtRtn = true
		else
			g_bCntrtRtn = false
		end if
		
		if g_szAfterOrg == "1" then			' 주문번호 연동
			Form.SetCtlProp("#edtOrgNo", "caption", tData(0))
		end if
		
		edtOrgNo.caption = tData(0)						' 주문번호
		edtOrgNo_OnEditComplete()
		
		g_szQty = ""
		Form.SetSharedData("C_QTY", "")
		Form.SetSharedData("C_QCK", chkAll.checkstate)
		
		' 수량
		if chkAll.checkstate == "1" then
			edtQty.caption = ""						
			g_szQty = tData(1)
			Form.SetSharedData("C_QTY", g_szQty)
		else
			edtQty.caption = tData(1)
			g_szQty = tData(1)
			edtQty_OnEditComplete()
		end if

		Set_OrdType()		' 종목코드에 따라 주문유형 설정
		
		edtClsCd.caption = tData(4)
	end if
End Function

'============================================================================
' 거래소코드 -> 국가코드
'============================================================================
Function GetNationGubun(sValue)
	if sValue == "HKS" then	' 홍콩, 항셍 지수
		return "HKG"
	
	elseif sValue == "SHS" or sValue == "SZS" then ' 상해, 심천거래소 종목
		return "CHN"
	
	elseif sValue == "NYS" or sValue == "AMX" or sValue == "NAS" or sValue == "NAO" then 
		return "USA"
	
	elseif sValue == "TSE" or sValue == "OSE" or sValue == "JSD" then ' 도쿄,오사카거래소 종목,자스닥거래소 종목
		return "JPY"
		
	elseif sValue == "HSX" or sValue == "HNX" then ' 베트남(호치민,하노이) 종목
		return "VND"
	else
		return false
	end if
end Function
'============================================================================
' 거래소코드 -> 거래소 벤더코드
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "HKS" then	' 홍콩
		return "0104"
	elseif sValue == "HSI" then ' 항셍 지수
		return "0529"
	elseif sValue == "SHS" then ' 상해
		return "0215"
	elseif sValue == "SZS" then ' 심천거래소 종목
		return "0214"
	elseif sValue == "NYS" then ' 뉴욕
		return "0321"
	elseif sValue == "AMX" then ' 아멕스
		return "0066"
	elseif sValue == "NAS" then ' 나스닥
		return "0537"
	elseif sValue == "NAO" then ' 미국 OTCBB
		return "0130"
	elseif sValue == "SPI" then ' S&P 지수
		return "0625"
	elseif sValue == "DJI" then ' 다우존스 지수
		return "0310"
	elseif sValue == "TSE" then ' 도쿄
		return "0106"
	elseif sValue == "OSE" then ' 오사카거래소 종목
		return "0107"
	elseif sValue == "JSD" then ' 자스닥거래소 종목
		return "0112"
	elseif sValue == "NII" then ' 니케이 지수
		return "0889"
	elseif sValue == "NAI" then ' 미국 나스닥 지수
		return "0538"
	elseif sValue == "HSX" then ' 베트남 호치민
		return "0770"
	elseif sValue == "HNX" then ' 베트남 하노이
		return "0771"
	end if
end Function
