'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Load_OrderSet() '주문설정값 읽어오기   
	Form.SetSharedData("STOCK_CNLTYPE", "00" )	' 20160318 : 주문구분이 없으므로, 디폴트 설정
	
	chkAll_OnChange("1")		
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 메인화면 이벤트 처리 (종목변경, 탭변경)
	' ----------------------------------------------------------------------		
	' 20171127 HAMWG START : 해외주식 종목코드 가져오기
	if sEventName == "ITEMCODE_TEMP" then
		if g_szCd <> sParam then
			g_szCd = sParam
			sCodeData = Split(sParam, "@")		
			g_szNg = GetNationGubun(sCodeData[0])	' 국가구분코드
			g_szMk = Transform_Exid(sCodeData[0])	' 거래소벤더코드
			
			if g_bCntrtRtn == false then
				Form.SetTopCtlProp("edtOrgNo", "caption", "")
				edtOrgNo.caption = ""
			else
				if g_szChangeInit == "1" then
					Form.SetTopCtlProp("edtOrgNo", "caption", "")
				else
					Form.SetTopCtlProp("edtOrgNo", "caption", edtOrgNo.caption)
				end if
			end if
			
			DATAMANAGER.RequestTranData( "getGtsHogaDetail" )
		else
			if g_szChangeInit == "1" then
				Form.SetTopCtlProp("edtOrgNo", "caption", "")
			else
				edtOrgNo.caption = Form.GetTopCtlProp("edtOrgNo", "caption")
			end if
		end if
		
		if g_bRtnData == false then
			if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
				Init_InputControl()
			end if
		else
			g_bRtnData = false
		end if
		
	' 20171127 HAMWG END	
	' ----------------------------------------------------------------------
	' 주문번호 연동
	' ----------------------------------------------------------------------			
	elseif sEventName == "AFTER_ORGNO" then		
		if g_szAfterOrg == "1" then			' 주문번호 연동
			edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
			edtOrgNo_OnEditComplete()
		end if
	' ----------------------------------------------------------------------
	' 미체결팝업에서 리턴된 값 적용하기
	' ----------------------------------------------------------------------
	elseif sEventName == "12000_CONTRACT_RETURN" then		
		if sParam == "" then
			Exit Sub
		end if

		Return_ContractScreen(sParam)
	' ----------------------------------------------------------------------
	' 가로에서 받은 조건
	' ----------------------------------------------------------------------		
	elseif sEventName == "CHANGE_DATA" then
		szOrg = Form.GetSharedData("C_ORG", false)		' 원주문번호
		
'		if g_szAfterOrg == "1" then			' 주문번호 연동
'			edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
'		end if		
		
		edtOrgNo.caption = szOrg
		edtOrgNo_OnEditComplete()
		
		szQck = Form.GetSharedData("C_QCK", false)		' 잔량여부
		chkAll.checkstate = szQck
		
		szQty = Form.GetSharedData("C_QTY", false)		' 수량
		g_szQty = szQty
		
		if szQck == "0" then
			edtQty.caption = szQty
			edtQty.enable = true
			btnQty.enable = true
		else
			edtQty.caption = ""
			edtQty.enable = false
			btnQty.enable = false
		end if
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	' ----------------------------------------------------------------------
	' 수량입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		g_szQty = sRet		
		edtQty_OnEditComplete()
	' ----------------------------------------------------------------------
	' 해외주식 미체결팝업 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "16060_MICHE" then
		if sRet == "" then
			Exit Sub
		end if
		
		g_bCntrtRtn = true
		Return_ContractScreen(sRet)	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCd, szPrc, szCLS, szCLSCd, szAll, szQty
		
	' 주문유형(지정가)
	szType = "01"

	' 주문조건 구분코드
	szCondCd = "0"
	
	' 매매유형 구분코드
	szCLSCd = "104" 

	' 잔량전부 여부
	if chkAll.checkstate == "1" then
		szAll = "Y"
		szQty = g_szQty
	else
		szAll = "N"
		szQty = edtQty.caption
	end if
	
	' ----------------------------------------------------------------------
	' 해외주식 취소주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtro_oder_102a" then
		g_szTR = szTranID
		DATAMANAGER.ClearInputData(0, "obtro_oder_102a")

		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ACNO"					, 0, Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ASNO"					, 0, Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ACNT_PWD"				, 0, Form.GetTopCtlProp("edtPwd", "encdata"))		' 계좌 비밀번호
		
		'DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_DATE"				, 0, )		' 주문일자
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ORGL_ODER_NO"			, 0, edtOrgNo.caption)							' 원주문번호
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_RCTF_CNCL_CLS_CODE"	, 0, "2")									' 주문정정취소구분
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODER_CLS_CODE"			, 0, szCLSCd)									' 주문구분코드
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "PRTN_WHOL_TPCD"			, 0, szAll)									' 전량체크
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODQT"					, 0, szQty)									' 주문수량
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_COND_CLS_CODE"		, 0, szCondCd)								' 주문조건구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_OCRN_TYPE_CODE"		, 0, szType)									' 주문발생유형코드(01:일반주문)	
			
	' ----------------------------------------------------------------------
	' 해외주식 시세조회
	' ----------------------------------------------------------------------	
	'20171204 HAMWG START : 해외주식_시세조회 서비스 세팅
	elseif szTranID == "getGtsHogaDetail" then
		DATAMANAGER.SetDataValue( 0, "getGtsHogaDetail", "inblock", "code" , 0 , g_szCd )
		
	' ----------------------------------------------------------------------
	' 고시환율 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtro_comn_025r" then
		szDate = Form.GetSharedData("&HOST_DATE", false)
		DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "STND_DATE" 	, 0 , szDate )
		DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "CRCD"		, 0 , g_szCur )

	end if
	'20171204 HAMWG END
End Sub
				
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szOdrMsg
	
	' ----------------------------------------------------------------------
	' 해외주식 취소주문
	' ----------------------------------------------------------------------	
	Select Case szTranID		
		Case "obtro_oder_102a"	
			g_szTR = ""
			
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)

			if Trim(szOrdCd) == "0001" then			' 정상주문
				Form.Toast(0, szOrdMsg, true)
				
				if g_szAfterInit == "1" then		' 주문후 초기화
					Init_InputControl()
				end if
				
				if g_szAfterOrg == "1" then			' 주문번호 연동
					szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
					
					Form.SetTopCtlProp("edtOrgNo", "caption", szOrgNo)
				else
					Form.SetTopCtlProp("edtOrgNo", "caption", "")
				end if
			end if

	' ----------------------------------------------------------------------
	' 해외주식 시세조회
	' ----------------------------------------------------------------------	
	' 20171204 HAMWG START : 해외주식_시세조회 데이터세팅
		Case "getGtsHogaDetail"
			
			g_szLast		=  DATAMANAGER.GetDataValue( 0, "getGtsHogaDetail", "price", "last" 		, 0 )	' 현재가
			g_szUpLimit	=  DATAMANAGER.GetDataValue( 0, "getGtsHogaDetail", "price", "uplimit" 	, 0 )	' 상한가
			g_szDnLimit	=  DATAMANAGER.GetDataValue( 0, "getGtsHogaDetail", "price", "dnlimit" 	, 0 )	' 하한가
			g_szUnit		=  DATAMANAGER.GetDataValue( 0, "getGtsHogaDetail", "price", "askunit" 	, 0 )	' 호가단위
			g_szOrdSize 	=  DATAMANAGER.GetDataValue( 0, "getGtsHogaDetail", "price", "ordersize" , 0 )	' 매매단위
			g_szCur		=  DATAMANAGER.GetDataValue( 0, "getGtsHogaDetail", "price", "currency" 	, 0 )	' 통화
			g_szDecimal 	=  DATAMANAGER.GetDataValue( 0, "getGtsHogaDetail", "price", "decimal" 	, 0 )	' 가격소수점
			g_szKorName	=  DATAMANAGER.GetDataValue( 0, "getGtsHogaDetail", "price", "korname" 	, 0 )	' 한글종목명
			g_szTickType	=  DATAMANAGER.GetDataValue( 0, "getGtsHogaDetail", "price", "ttyp" 		, 0 )	' 종목 틱타입
			g_szKofx		=  DATAMANAGER.GetDataValue( 0, "getGtsHogaDetail", "price", "kofx" 		, 0 )	' 환율
			sMask = "0,0,,,0,,"..g_szDecimal..",1,1,2,0"
	
			Label9.mask = sMask
			
			Label7.caption = g_szCur
			Label8.caption = g_szOrdSize & "주"
			Label9.caption = Cdbl(g_szKofx) / Cdbl(g_szLast)
			
			'DATAMANAGER.RequestTranData("obtro_comn_025r")
		Case "obtro_comn_025r"
			szAnncExrt = DATAMANAGER.GetDataValue( 0, "obtro_comn_025r", "OutBlock1", "ANNC_EXRT" , 0 )	' 고시환율
			Label9.caption = Cdbl(szAnncExrt)
			
		Case "obtro_oder_234r"
			szAbleQty = DATAMANAGER.GetDataValue( 0, "obtro_oder_234r", "OutBlock1", "ODER_ABLE_QTY" , 0 )	' 현금가능수량
			edtQty.caption = szAbleQty
	'20171204 HAMWG END
	End Select
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if	
End Sub

'============================================================================
' btnCnl_OnClick : 취소버튼 클릭
'============================================================================
Sub btnCnl_OnClick()
	Dim szCLS
	
	Check_InputData(0)
End Sub

'============================================================================
' edtOrgNo_OnEditComplete
'============================================================================
Sub edtOrgNo_OnEditComplete()
	Form.SetSharedData("C_ORG", edtOrgNo.caption)
End Sub

'============================================================================
' edtQty_OnEditComplete 
'============================================================================
Sub edtQty_OnEditComplete()
	Form.SetSharedData("C_QTY", edtQty.caption)
End Sub

'============================================================================
' btnMiche_OnClick : 미체결버튼 클릭
'============================================================================
Sub btnMiche_OnClick()
	Form.triggerEvent("#", "12000_CONTRACT_OPEN", "")
End Sub

'============================================================================
' chkAll_OnChange
'============================================================================
Sub chkAll_OnChange(sCheckState)
	Form.SetSharedData("C_QCK", sCheckState)
	
	if sCheckState == "1" then
		edtQty.caption = ""
		edtQty.enable = false
		btnQty.enable = false
		btnQPlus.enable = false
		btnQMinus.enable = false
	else
		edtQty.caption = g_szQty
		edtQty.enable = true
		btnQty.enable = true
		btnQPlus.enable = true
		btnQMinus.enable = true
	end if
End Sub

'============================================================================
' btnQty_OnClick
'============================================================================
Sub btnQty_OnClick()
	if chkAll.checkstate == "0" then
		szData = "3★" & edtQty.caption & "★" & g_szOrdSize
		Form.OpenPopup("mhtro16060_p1", szData, "")
	end if
End Sub

