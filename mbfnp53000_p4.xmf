'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obfno_otiq_040r" then
		DATAMANAGER.SetDataValue( 0 , "obfno_otiq_040r", "InBlock1", "OTC_FUND_ISCD" , 0 , g_szList(0) )		'펀드 종목 코드
		DATAMANAGER.SetDataValue( 0 , "obfno_otiq_040r", "InBlock1", "STA_DATE" , 0 , g_szList(1) )		'시작일자
		DATAMANAGER.SetDataValue( 0 , "obfno_otiq_040r", "InBlock1", "FIN_DATE" , 0 , g_szList(2) )		'종료일자
	end if
	
End Sub



'============================================================================
Sub Grid0_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("obfno_otiq_040r") == true then
		DATAMANAGER.RequestNextData( "obfno_otiq_040r" )
	end if
End Sub

