'============================================================================
' 01. 화 면 명 : 제안하기_제안내용보기(답변완료)
' 02. 작    성 : 신명준
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************

Dim g_PROP_REG_ID
Dim g_PROP_REG_ID
Dim g_REG_DTL_CNTT
Dim g_ANSR_CNTT

Dim maxLength				' 한 줄 최대 글자수
Dim g_LinHeight_answer		' 한 줄당 추가되는 컨트롤 높이 '20230511 수정
Dim g_LinHeight_response	' 한 줄당 추가되는 컨트롤 높이 '20230511 수정

Dim g_URL_Type1
Dim g_URL_Type2
Dim g_URL_Type3
Dim g_URL_Link1
Dim g_URL_Link2
Dim g_URL_Link3

Dim g_Label1Height
Dim g_ButtonCnt
Dim g_szOsType

maxLength					= 23	
g_LinHeight_answer			= 35 '20230511 수정

'20231030 android, ios 별로 답변 높이를 따로 지정
g_LinHeight_response_ios		= 20 
g_LinHeight_response_android	= 20 

g_LinHeight_notice          	= 18
'===========================================================================
' 							FORM 함수
'============================================================================
Sub Form_OnFormInit()
	g_PROP_REG_ID = Form.GetOpenLinkData()
	g_szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iO
	
	if g_szOsType == "1" then
		g_LinHeight_response = g_LinHeight_response_android
	else
		g_LinHeight_response = g_LinHeight_response_ios
	end if 
		
	if g_PROP_REG_ID <> "" and g_PROP_REG_ID <> null then
		DATAMANAGER.RequestTranData("obcpp_cbbs_002r")
	end if
End Sub

'============================================================================
' 							CONTORL 함수
'============================================================================
' 확인
'============================================================================
Sub Button0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' 돌아가기
'============================================================================
Sub btnBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' 							사용자 함수
'============================================================================

Function f_getLineCount(szText)
	Dim heightCnt, overLine
	Dim iNoticeLength
	
	iNoticeLength = Form.getLen(Trim(szText))
	' 현재 체크 중인 라인이 한 줄에 표시 가능한 최대 글자수를 넘겼는지 체크
	if CInt(iNoticeLength) > CInt(maxLength) then
		overLine = CInt(textLength) / CInt(maxLength)
		
		if (overLine - CInt(overLine)) > 0 then
			overLine = CInt(overLine) + 1
		end if

		' 한 줄에 표시 가능한 최대 글자수 초과 시 컨트롤 높이 추가
		if CInt(overLine) > 0 then
			heightCnt = CInt(overLine)
		end if

	else
		heightCnt = 1
	end if
	
	return heightCnt
end Function



' 라벨 높이 조절 함수(줄 카운트)
'============================================================================
Function f_CountLine(index)
	Dim txt, textArr, heightCnt, overLine
	txt			= index == 1 and g_REG_DTL_CNTT or g_ANSR_CNTT
	
	'textArr		= split(txt, "\n")
	textArr		= split(txt, CHR(10))
	heightCnt	= 0

'	if index == 2 then
'		Form.ShowAlert("txt", txt)
'	end if

'	Form.ShowAlert("", txt)

	' ===================================================================
	' 입력 데이터가 멀티라인인 경우
	' ===================================================================
	if UBound(textArr) > 0 then
		Dim textLength
		
		for i = 0 to Ubound(textArr)
		
			if textArr(i) <> null then
'				if index == 2 then
'					Form.ShowAlert("textArr(i)", textArr(i))
'				end if
				
				textLength	= Form.getLen(textArr(i))

				if CInt(textLength) > CInt(maxLength) then
				
					' 현재 체크 중인 라인이 한 줄에 표시 가능한 최대 글자수를 넘겼는지 체크
					overLine = CInt(textLength) / CInt(maxLength)
										
					' 한 줄에 표시 가능한 최대 글자수 초과 시 컨트롤 높이 추가
					if CInt(overLine) > 0 then
						heightCnt = heightCnt + CInt(overLine)
					end if
	
				else
					heightCnt = heightCnt + 1
				end if
			
'				if index == 2 then
'					Form.ShowAlert("heightCnt", heightCnt)
'				end if
				
				
			end if			
		next

	' ===================================================================
	' 입력 데이터가 멀티라인인이 아닐 경우 or 엔터(\n)없이 입력한 경우
	' ===================================================================
	else
		
		if textArr(0) <> null then
			textLength = Form.getLen(textArr(0))

			' 현재 체크 중인 라인이 한 줄에 표시 가능한 최대 글자수를 넘겼는지 체크
			if CInt(textLength) > CInt(maxLength) then
				overLine = CInt(textLength) / CInt(maxLength)
	
				' 한 줄에 표시 가능한 최대 글자수 초과 시 컨트롤 높이 추가
				if CInt(overLine) > 0 then
					heightCnt = CInt(overLine)
				end if
	
			else
				heightCnt = 1
			end if
			
		end if

	end if
	
'	Form.ShowAlert(index, heightCnt)
	
	' 제안내용
	if index == 1 then
		'Dim Label1Height
		g_Label1Height = CInt(g_LinHeight_answer * heightCnt)
		
		Container0.Label1.height	= g_Label1Height '20230511 수정
		Container0.Label1.caption	= g_REG_DTL_CNTT
		
		Container0.Title2.top		= 120 + g_Label1Height	'20230511 수정
		Container0.Label2.top		= 150 + g_Label1Height	'20230511 수정
		
		
	' 답변내용
	elseif index == 2 then
		dim iLabel2Height, iNoticeLength, iNoticeHeight1, iNoticeHeight2, iNoticeHeight3
		dim szOsType
		
		iLabel2Height = (g_LinHeight_response * heightCnt)
				
		'Form.ShowAlert("iLabel2Height", iLabel2Height)
		
		Container0.Label2.height 	= (g_LinHeight_response * heightCnt) '20230511 수정
		Container0.Label2.caption	= g_ANSR_CNTT
				
'		Container0.LabelNotice1.top = Container0.Label2.top + Container0.Label2.height + 30
'		Container0.LabelNotice2.top = Container0.LabelNotice1.top + 30
'		Container0.LabelNotice3.top = Container0.LabelNotice2.top + 30
		
		
		'Container0.안에서는 컨트롤의 top, height등의 위치값이 위치가 정확하게 나오지 않는다.
		'공지라벨 설정
		if CInt(g_ButtonCnt) > 0 then 
			Container0.LabelNotice1.top = 150 + g_Label1Height + iLabel2Height + 10
			
			heightCnt = f_getLineCount(Container0.LabelNotice1.caption)			
			if heightCnt > 1 then
				Container0.LabelNotice1.multiline = True
			end if
			
			iNoticeHeight1 = g_LinHeight_notice * heightCnt
			Container0.LabelNotice1.height = iNoticeHeight1
					
			Container0.LabelNotice2.top = 150 + g_Label1Height + iLabel2Height + iNoticeHeight1 + 20
			
			heightCnt = f_getLineCount(Container0.LabelNotice1.caption)
			if heightCnt > 1 then
				Container0.LabelNotice2.multiline = True
			end if
	
			iNoticeHeight2 = g_LinHeight_notice * heightCnt
			Container0.LabelNotice2.height = iNoticeHeight2	
			
			Container0.LabelNotice3.top = 150 + g_Label1Height + iLabel2Height + iNoticeHeight1 + iNoticeHeight2 + 30
			
			heightCnt = f_getLineCount(Container0.LabelNotice1.caption)						
			if heightCnt > 1 then
				Container0.LabelNotice3.multiline = True
			end if
			
			iNoticeHeight3 = g_LinHeight_notice * heightCnt
			Container0.LabelNotice3.height = iNoticeHeight3
		end if
	end if

	Container0.SetScrollAutoSize()	
End Function

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obcpp_cbbs_002r" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROP_REG_ID", 0, g_PROP_REG_ID)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iTextLength
	Dim stCaption
	
	if szTranID == "obcpp_cbbs_002r" then
	
		Dim TITL_NAME
		TITL_NAME		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TITL_NAME",	0)
		g_REG_DTL_CNTT	= Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "REG_DTL_CNTT",	0))
		g_ANSR_CNTT		= Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ANSR_CNTT",	0))
		
		Container0.Label0.caption = TITL_NAME
		
		g_ButtonCnt = Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "PROS_CLS_CODE",	0))  '버튼 갯수		  
		
'		Form.ShowAlert("Receive " + szTranID, iButtonCnt)
		
		'LabelNotice 캡션 설정
		if CInt(g_ButtonCnt) > 0 then	
			Container0.LabelNotice1.caption = Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BTN_CNTT1",	0))
			gURL_Type1					= Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BTN_LNKN_TYPE_CODE1",	0))  'M: 화면번호, U: url
			gURL_Link1 					= Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BTN_URL1",	0))
			Container0.LabelNotice1.visible = CInt(g_ButtonCnt) >= 1
			
'			Form.ShowAlert("gURL_Type1 " + szTranID, gURL_Type1)
'			Form.ShowAlert("gURL_Link1 " + szTranID, gURL_Link1)
						
			Container0.LabelNotice2.caption = Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BTN_CNTT2",	0))
			gURL_Type2					= Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BTN_LNKN_TYPE_CODE2",	0))  'M: 화면번호, U: url
			gURL_Link2	 				= Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BTN_URL2",	0))
			Container0.LabelNotice2.visible = CInt(g_ButtonCnt) >= 2
			
			Container0.LabelNotice3.caption = Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BTN_CNTT3",	0))
			gURL_Type3					= Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BTN_LNKN_TYPE_CODE3",	0))  'M: 화면번호, U: url
			gURL_Link3	 				= Trim(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BTN_URL3",	0))
			Container0.LabelNotice3.visible = CInt(g_ButtonCnt) >= 3
		
		else
			Container0.LabelNotice1.visible = False
			Container0.LabelNotice2.visible = False
			Container0.LabelNotice3.visible = False
		end if

		call f_CountLine(1)
		call f_CountLine(2)	
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szSubMsg <> null and szSubMsg <> "" then
		Form.ShowAlert( "안내" , szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert( "안내" , szErrMsg)
	end if
	
End Sub

'============================================================================
Sub Container0_LabelNotice1_OnClick()
	'M: 화면번호, U: url
	if gURL_Type1 == "M" then
		Form.OpenScreen(gURL_Link1, "")
	else
		Form.openExternalBrowser(gURL_Link1)
	end if
End Sub

'============================================================================
Sub Container0_LabelNotice2_OnClick()
	'M: 화면번호, U: url
	if gURL_Type2 == "M" then
		Form.OpenScreen(gURL_Link2, "")
	else
		Form.openExternalBrowser(gURL_Link2)
	end if
End Sub

'============================================================================
Sub Container0_LabelNotice3_OnClick()
	'M: 화면번호, U: url
	if gURL_Type3 == "M" then
		Form.OpenScreen(gURL_Link3, "")
	else
		Form.openExternalBrowser(gURL_Link3)
	end if
End Sub

