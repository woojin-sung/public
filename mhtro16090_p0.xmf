'============================================================================
Function Move_ItemCode( szType )
	If szType = "Right" Then
		Form.ACRSetProp( "moveitem", "1" )
	ElseIf szType = "Left" Then
		Form.ACRSetProp( "moveitem", "-1" )
	End If
End Function

'============================================================================
Sub ImgItem_OnClick()
	Form.OpenCommonDialog("SEARCH", "28", "")
End Sub
'============================================================================
' Form_OnCommonDialogReturn : 종목검색창에서 선택된 종목 가져오기
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName == "SEARCH" then
		if Trim(sReturn1)  <> "" then
			g_sDecimal = "0"
			sItemCode = sReturn1
			Dim sTemp
			sTemp = split(sReturn1, "@")
			
			if UBOUND(sTemp)<1 then
				exit Sub
			end if
			
			g_sExid = sTemp[0] '시장구분
			g_sCode = sTemp[1] '종목코드 
			
			szName = Form.GetItemCodeInfo(sItemCode, "name")
			LblName.caption = szName
			
'			DATAMANAGER.CancelRealData("ohhts_exst_cntg")
			if Len(sItemCode) > 0	then
				DATAMANAGER.RequestTranData( "ohhts_6000_001r" )
				DATAMANAGER.RequestTranData( "obsim_oscm_343r" )
				Form.triggerEvent("#", "CHANGE_CODE", sItemCode)
			end if
		end if
	end if
End Sub
'============================================================================
Sub ImgGwan_OnClick()
	Form.triggerEvent("#", "SCREEN_MENU", "REG_INTR") '메인화면에 관심등록팝업 오픈 요청
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	ImgItem.SetMaintainingRatio("1")
	ImgGwan.SetMaintainingRatio("1")
End Sub

