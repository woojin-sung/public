	<SCRIPT_INFO _len="10777" _ulen="10207" >
Dim nExid
Dim sItemCode
Dim g_sDecimal
Dim nNat

Dim g_sCode
Dim g_sExid
Dim g_rtChk
Dim g_sClsCd '현재가 종목상태구분코드 Y : 거래정지
Dim g_sSellOnly '현재가 거래상태 1 : 매도만가능

Dim g_szCur

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "RequestData"	then
		g_sDecimal = "0"
		sItemCode = sParam
		Dim sTemp
		sTemp = split(sParam, "@")
		'20211223 HSZ START
		if UBOUND(sTemp)<1 then
			exit Sub
		end if
		'20211223 HSZ END
		
		g_sExid = sTemp[0] '시장구분
		g_sCode = sTemp[1] '종목코드 
		                           
		szName = Form.GetItemCodeInfo(sItemCode, "name") 'hsz
		LblName.caption = szName
'		initRealCheck(g_sExid)
		
'		DATAMANAGER.CancelRealData("ohhts_exst_cntg")
		if Len(sItemCode) > 0	then
			DATAMANAGER.RequestTranData( "ohhts_6000_001r" )
			DATAMANAGER.RequestTranData( "obsim_oscm_343r" )
			
		end if
		
	
	'------------------------------------------------
	'20240626 LES START
	'------------------------------------------------
	elseif sEventName == "SET_INTR_YN" then
		
		if sParam == "Y" then
			ImgGwan.imgpath = "icon_like_o.png"
		else
			ImgGwan.imgpath = "icon_like2_n.png"
		end if
	'------------------------------------------------
	'20240626 LES END
	'------------------------------------------------
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "ohhts_6000_001r"	then
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , g_sExid)
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , g_sCode )
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
	elseif szTranID == "obsim_oscm_343r"	then
		DATAMANAGER.SetDataValue( false, "obsim_oscm_343r", "InBlock1", "ISCD" , 0 , g_sCode.."."..g_sExid )
		DATAMANAGER.SetDataValue( false, "obsim_oscm_343r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , Transform_Mrkt(sItemCode))
	elseif szTranID == "obsim_oscm_331r"	then
		DATAMANAGER.SetDataValue( false, "obsim_oscm_331r", "InBlock1", "ISCD" , 0 , g_sCode.."."..g_sExid )
	elseif szTranID == "obtro_comn_025r" then
		szDate = Form.GetSharedData("&HOST_DATE", false)
		DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "STND_DATE" 	, 0 , szDate )
		DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "CRCD"		, 0 , g_szCur )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6000_001r"	then
		
		nNat = Form.GetItemCodeInfo(sItemCode, "ovsnation") '국가구분 코드
		
		Dim sExid
		
		'USA, HKG JPY, CHN
		if nNat == "USA"	then
			LblNat.caption = "미국"
		elseif nNat == "HKG"	then
			LblNat.caption = "홍콩"
		elseif nNat == "CHN"	then
			LblNat.caption = "중국"
		elseif nNat == "JPY"	then		'해외주식 일본 추가
			LblNat.caption = "일본"
		end if

		nExid = Form.GetItemCodeInfo(sItemCode, "exchcode3") '거래소 구분코드
		sExid = Transform_Exid(nExid)
		LblExid.caption = sExid
		
		g_sClsCd = DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_ISSU_STAT_CLS_CODE", 0) ' 종목상태구분코드 Y : 거래정지
		g_sSellOnly = CInt(DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_SELL_ONLY", 0)) '거래상태 ' 1매도만가능
		
		sEtfYn = DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FIDX_ETF_YN", 0) ' ETF여부
		sLvrg = DATAMANAGER.GetDataValue(false,"ohhts_6000_001r", "OutBlock1", "FID_LVRG", 0) ' 레버리지
		g_szCur		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_CRNC_CODE" 	, 0 )	' 통화
'		if sEtfYn = "Y" then
'			LblIndu.caption = "ETF(" & FormatNumber(sLvrg,1) & ")"
'			LblIndu1.caption = "ETF(" & FormatNumber(sLvrg,1) & ")"
'		end if
		
		DATAMANAGER.RequestTranData( "obsim_oscm_331r" )
		DATAMANAGER.RequestTranData("obtro_comn_025r") 'hsz
'		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , sItemCode )
'		DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )

	elseif szTranID == "obsim_oscm_331r"	then
	
		Dim ssSellOnly,sStatus,WeekDate,sMrktCls
		
		sSellOnly   = DATAMANAGER.GetDataValue(false,"obsim_oscm_331r", "OutBlock1", "BYOV_PRHB_YN", 0) ' 매수불가여부
		sStatus     = DATAMANAGER.GetDataValue(false,"obsim_oscm_331r", "OutBlock1", "TRHT_YN", 0) 		' 거래정지여부
		sWeekDate   = DATAMANAGER.GetDataValue(false,"obsim_oscm_331r", "OutBlock2", "STND_DATE", 0) 	' 기준일
		sMrktCls    = DATAMANAGER.GetDataValue(false,"obsim_oscm_331r", "OutBlock2", "HLDY_YN", 0) 		' 휴일여부
		

		sWeekDate = WeekDay( CDate( Left( sWeekDate, 4 ) & "-" & Mid( sWeekDate, 5, 2 ) & "-" & Right( sWeekDate, 2 ) ) )
		If Trim( sMrktCls ) = "Y" And Trim( sWeekDate ) <> "1" And Trim( sWeekDate ) <> "7" Then		'일요일, 토요일 제외
			LblStatus.caption = "휴장"
		Else
			if g_sClsCd == "Y" then
				LblStatus.caption = "거래정지"
			else
				LblStatus.caption = ""
				if g_sSellOnly == 1 then
					LblStatus.caption = "매도만가능"
				end if
			end if
		End If
		
'		if LblStatus.caption == "" then
'			LblIndu1.visible = true
'			LblIndu.visible = false
'		else
'			LblIndu1.visible = false
'			LblIndu.visible = true
'		end if
	elseif "obtro_comn_025r" then
		szAnncExrt = DATAMANAGER.GetDataValue( 0, "obtro_comn_025r", "OutBlock1", "ANNC_EXRT" , 0 )	' 고시환율
'		Table0.SetCellString(0, 1, szAnncExrt)
		nNat = Form.GetItemCodeInfo(sItemCode, "ovsnation") '국가구분 코드
		sWonPrc = Cdbl(szAnncExrt) * Cdbl(LblPrice.caption)

		'USA, HKG JPY, CHN
		if nNat == "USA"	then
			LblWonpriceUS.caption = sWonPrc
			LblWonpriceUS.visible = true 
			LblWonpriceCH.visible = false
			LblWonpriceHK.visible = false
			LblWonpriceJP.visible = false
		elseif nNat == "HKG"	then
			LblWonpriceHK.caption = sWonPrc
			LblWonpriceUS.visible = false 
			LblWonpriceCH.visible = false
			LblWonpriceHK.visible = true
			LblWonpriceJP.visible = false
		elseif nNat == "CHN"	then
			LblWonpriceCH.caption = sWonPrc
			LblWonpriceUS.visible = false 
			LblWonpriceCH.visible = true
			LblWonpriceHK.visible = false
			LblWonpriceJP.visible = false
		elseif nNat == "JPY"	then		'해외주식 일본 추가
			LblWonpriceJP.caption = sWonPrc
			LblWonpriceUS.visible = false 
			LblWonpriceCH.visible = false
			LblWonpriceHK.visible = false
			LblWonpriceJP.visible = true
		end if
	end if
End Sub

'============================================================================
' 거래소 ID 이름으로 변환
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "HKS" then	' 104
		return "홍콩"
	elseif sValue == "HSI" then ' 529
		return "항셍 지수"
'		return "중국"
	elseif sValue == "SHS" then ' 215
		return "상해"
'		return "중국"
	elseif sValue == "SZS" then ' 214
		return "심천"
'		return "중국"
	elseif sValue == "NYS" then ' 321
		return "뉴욕"
'		return "미국"
	elseif sValue == "AMX" then ' 66
		return "아멕스"
'		return "미국"
	elseif sValue == "NAS" then ' 537
		return "나스닥"
'		return "미국"
	elseif sValue == "NAO" then ' 130
		return "미국"
	elseif sValue == "SPI" then ' 625
		return "S&P"
	elseif sValue == "DJI" then ' 310
		return "다우존스"
	elseif sValue == "TSE" then ' 106
		return "도쿄"
	elseif sValue == "OSE" then ' 107
		return "오사카"
	elseif sValue == "JSD" then ' 112
		return "자스닥"
	elseif sValue == "NII" then ' 889
		return "니케이"
	elseif sValue == "NAI" then ' 538
		return "나스닥"
	elseif sValue == "HSX" then ' 770
		return "호치민"
	elseif sValue == "HNX" then ' 771
		return "하노이"
	end if


end Function
'============================================================================
Function Transform_Mrkt(sItemCode)
	nNat = Form.GetItemCodeInfo(sItemCode, "ovsnation") '국가구분 코드
	if nNat == "USA"	then 
		return "01" '미국
	elseif nNat == "HKG"	then
		return "02" '홍콩
	elseif nNat == "CHN" then
		nExid = Form.GetItemCodeInfo(sItemCode, "exchcode3") '거래소 구분코드
		if nExid = "SHS" then
			return "03" '상해
		elseif nExid == "SZS" then
			return "04" '심천
		end if
	elseif nNat == "JPY" then
		return "05" '일본
	end if
end Function 
