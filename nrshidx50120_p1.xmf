					<RADIO_INFO>
						<RADIO no="0" text="상승률 낮은순" radioimage="input_06.9.png" transfervalue="01" position="0,0,162,44" />
						<RADIO no="1" text="상승률 높은순" radioimage="input_06.9.png" transfervalue="02" position="172,0,162,44" />
						<RADIO no="2" text="거래량 적은순" radioimage="input_06.9.png" transfervalue="03" position="0,54,162,44" />
						<RADIO no="3" text="거래량 많은순" radioimage="input_06.9.png" transfervalue="04" position="172,54,162,44" />
						<RADIO no="4" text="보수 낮은순" radioimage="input_06.9.png" transfervalue="05" position="0,108,162,44" />
						<RADIO no="5" text="보수 높은순" radioimage="input_06.9.png" transfervalue="06" position="172,108,162,44" />
