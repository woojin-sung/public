'--===========================================================================
' 01.화면명 		: 실시간환전신청
' 02.화면설명		: 실시간환전신청_외화매도탭
' 03.작성		: 2018.01.15
'--===========================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szFullAcnt	'계좌번호 (8+2)
dim	g_szPasswd	'계좌비밀번호

g_szFullAcnt	=""
g_szPasswd	=""

'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName		= "PWDINFO_CHG" then
		g_szPasswd	=	sParam
'		
'		if len(trim(g_szFullAcnt))	>	8	and	len(trim(g_szPasswd))	then
'			DATAMANAGER.RequestTranData("obrtd_fcur_001r")
'			DATAMANAGER.RequestTranData("obtsd_fbnk_209r")
'		end if
	
	elseif sEventName	=	"ACNTINFO_CHG" then
		g_szFullAcnt = Form.GetSharedData("&ACCOUNT", 0 )
		
		if len(trim(g_szFullAcnt))	>	8		then
			Combo0.clear = ""
			'화면 초기화 함수
			Call cleardata()
			
			DATAMANAGER.RequestTranData("obrtd_fcur_001r")
			DATAMANAGER.RequestTranData("obtsd_fbnk_209r")
		end if
		
	end if
	
End Sub


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szFullAcnt= Form.GetCtlProp("#acnt01", "caption")
	g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")
	
	Call cleardata()
	
	Edit0.enable = True
	Edit1.enable = False
	
	Combo0.clear = ""
	
	DATAMANAGER.RequestTranData("obrtd_fcur_001r")
	DATAMANAGER.RequestTranData("obtsd_fbnk_209r")
	
End Sub




'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")
	g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")
	
	if	szTranID	=	"obrtd_fcur_001r"	then
		
		DATAMANAGER.SetDataValue(0, "obrtd_fcur_001r", "InBlock1", "ACNO" , 0 , left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0, "obrtd_fcur_001r", "InBlock1", "ASNO" , 0 , mid(g_szFullAcnt,9,2))
		DATAMANAGER.SetDataValue(0, "obrtd_fcur_001r", "InBlock1", "SVCD" , 0 , "001")
		DATAMANAGER.SetDataValue(0, "obrtd_fcur_001r", "InBlock1", "ACNT_PWD" , 0 , Form.GetEncData(g_szPasswd))
	
	elseif szTranID =	"obtsd_fbnk_201r" then
	
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_201r" , "InBlock1" , "CRCD" , 0 , Combo0.caption )
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_201r" , "InBlock1" , "SVCD" , 0 , "001")
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_201r" , "InBlock1" , "ACNO" , 0 , left(g_szFullAcnt,8))
		
	elseif szTranID = "obtsd_fbnk_202a" then
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "ACNO" 			, 0 , left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "ASNO" 			, 0 , mid(g_szFullAcnt,9,2))
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "ACNT_PWD" 		, 0 , Form.GetEncData(g_szPasswd))
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "MNEC_CLCD"		, 0 , 			"2"			) '환전구분코드 1 : 외화매도
	
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "WNCR_AMT" 		, 0 , 	0					) '원화금액 0원
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "FRCR_AMT" 		, 0 , Table2.GetCellString(0, 2)) '환전외화금액
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "IQRY_EXRT"		, 0 , Label0.caption			) '조회환율
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "SVCD"			, 0 , "001"					) '
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "CRCD"			, 0 , Table2.GetCellString(0, 1)) '통화코드
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "CONT_CLS_CODE"	, 0 , 			"4"			) '접촉구분코드 4 : 온라인
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_202a" , "InBlock1" , "TRMD_CLS_CODE"	, 0 , 			"04"			) '거래매체구분코드 04 : 무매체
		
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	dim szDataCnt
	dim szCrcd, szCrcdKrNm, szExDealAmt, szApBy
	
	szDataCnt = ""
	szCrcd =	""
	szCrcdKrNm = ""
	szExDealAmt = ""
	
	if	szTranID =	"obrtd_fcur_001r" then
		
		szDataCnt =	DATAMANAGER.GetDataCount(0, "obrtd_fcur_001r", "OutBlock1")
		
		
		for	i=0 to szDataCnt - 1
		
			szCrcd		=	DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "CRCD", i )
			szCrcdKrNm	=	DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "CRCD_KOR_NAME", i )
			szExDealAmt	=	DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "UI_AMT_LETT3", i )
			
			Grid0.SetCellData("bd_cell0", i, szCrcd & " " & szCrcdKrNm)
			Grid0.SetCellData("bd_cell1", i, szExDealAmt)
			
		next
		
	elseif szTranID = "obtsd_fbnk_209r" then
	
		szDataCnt =	DATAMANAGER.GetDataCount(0, "obtsd_fbnk_209r", "OutBlock1")
		
		for i=0 to szDataCnt - 1
			szCrcd		=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_209r", "OutBlock1", "CRCD", i )
			szCrcdKrNm	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_209r", "OutBlock1", "CRCD_KOR_NAME", i )
			
			'콤보박스에 서비스로 가져온 거래가능 통화 추가
			Combo0.cbadddatatext = szCrcd & "`" & szCrcd & " " & szCrcdKrNm
					
		next
		'환율 초기 조회
		DATAMANAGER.RequestTranData("obtsd_fbnk_201r")
	
	elseif szTranID = "obtsd_fbnk_201r" then
		
		
		
		szDataCnt =  DATAMANAGER.GetDataCount(0, "obtsd_fbnk_201r", "OutBlock1")
		
		'Form.MsgBox("",DATAMANAGER.GetDataValue(0, "obtsd_fbnk_201r" , "OutBlock1" , "TLTR_APLY_BYRT" , 0),0,0)
		
		szApBy =  DATAMANAGER.GetDataValue(0, "obtsd_fbnk_201r", "OutBlock1", "TLTR_APLY_SLRT" , 0)
	
		 'Form.ShowAlert("알림", szDataCnt)
		Label0.caption = szApBy
		
	elseif szTranID = "obtsd_fbnk_202a" then
	
		szCRCD	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "CRCD" 		, 0)		' 통화코드
		szTFPR	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "TFAM_PRRM" , 0)		' 예수금전잔
		szTFNW	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "TFAM_NWRM" , 0)		' 예수금금잔
		szTRAM	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "TR_AMT" 	, 0)		' 실제환전원화금액
		
		szFCRCD	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "UI_CRCD" 		, 0)	' 외화통화코드
		szFTFPR	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "FRCR_TFAM_PRRM" , 0)	' 외화전잔
		szFTFNW	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "FRCR_TFAM_NWRM" , 0)	' 외화금잔
		szFTRAM	=	DATAMANAGER.GetDataValue(0, "obtsd_fbnk_202a", "OutBlock1", "FRCR_TR_AMT" 	, 0)	' 실제환전외화금액
		
		btnAddSell.enable = False
		
		Form.OpenPopup("mhtro16080_p1" , szCRCD & "★" &  szTFPR & "★" &  szTFNW & "★" & szTRAM & "★" &
									 szFCRCD & "★" &  szFTFPR & "★" &  szFTFNW & "★" & szFTRAM & "★" & 
									 "사는통화" & "★" & "파는통화"
											, sPosInfo)
		
		DATAMANAGER.RequestTranData("obrtd_fcur_001r")
		
	end if
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	
	'가계산기준 외화를 선택한 경우
	if nIndex = 0 then
		Edit0.enable = True
		Edit1.enable = False
		Edit0.caption = ""
		Edit1.caption = ""
	'가계산기준 원화를 선택한 경우
	else
		Edit0.enable = False
		Edit1.enable = True
		Edit0.caption = ""
		Edit1.caption = ""
	
	end if
End Sub

'============================================================================
Sub btnShRate_OnClick()
	If Combo0.caption = "" then
		Form.ShowAlert("알림", "통화 선택 후 조회하세요.")
		Exit sub
	elseif Combo0.caption = "KRW" then
		Exit sub
	end if
	
	DATAMANAGER.RequestTranData("obtsd_fbnk_201r")
	
End Sub

'============================================================================
Sub btnAddSell_OnClick()
	if g_szPasswd = "" then
		Form.ShowAlert("알림", "비밀번호를 입력해주세요.")
		Exit sub
	elseif trim( Table2.GetCellString(0, 2) ) = "" then
		Form.ShowAlert("알림", "환전하실 외화 값을 입력해주세요.")
		Exit sub	
	end if
	
	DATAMANAGER.RequestTranData("obtsd_fbnk_202a")
End Sub

'============================================================================
Function	cleardata()

	btnAddSell.enable = True
	Label0.caption = ""
	Edit0.caption = ""
	Edit1.caption = ""
	Table2.SetCellString(0, 1, "")
	Table2.SetCellString(0, 2, "")

end Function

'============================================================================
Sub Edit0_OnEditComplete()
	Call Calc_Simul()
	
End Sub

'============================================================================
Sub Edit1_OnEditComplete()
	Call Calc_Simul()
	
End Sub

'============================================================================
Function Calc_Simul()
	Dim frAmt, exchRate, sprRate, wnAmt, feeAmt, rateUnit
	
	rateUnit = 1
	
	if Combo0.caption = "JPY" or Combo0.caption = "VND" or Combo0.caption = "IDR" then
		rateUnit = 100
	end if
	
	if Label0.caption = "" then
		exit Function
	end if
	
	'가계산기준 외화 선택인 경우
	if RadioGroup0.currentindex = "0" then
		if Combo0.caption = "" or Edit0.caption = "" then
			exit Function
		end if
		
		frAmt = CDBL(Edit0.caption)
		exchRate = CDBL(Label0.caption)
		sprRate = CDBL(Edit2.caption)
		wnAmt = frAmt * exchRate / rateUnit
		feeAmt = frAmt * sprRate
		Edit1.caption = wnAmt
			
	'가계산기준 원화 선택인 경우
	else
		if Edit1.caption = "" then
			exit Function
		end if
		
		wnAmt = CDBL(Edit1.caption)
		exchRate = CDBL(Label0.caption)
		sprRate = CDBL(Edit2.caption)
		frAmt = wnAmt / exchRate * rateUnit
	    feeAmt = frAmt * sprRate
	     Edit0.Caption = frAmt
		
	end if
	
	'계산된 매수외화금액을 최종 매수신청 외화에 세팅
	Table2.SetCellString(0, 1, Combo0.cbkeydata )
	Table2.SetCellString(0, 2, frAmt)
	
end Function

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	cleardata()
	'환율 초기 조회
	DATAMANAGER.RequestTranData("obtsd_fbnk_201r")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	if szTranID = "obtsd_fbnk_201r" then
		if szErrCode = "3005" then
			'szSubErr = DATAMANAGER.GetDataMsgText( "obtsd_fbnk_201r" )
			Form.ShowAlert( "알림", szErrMsg )
			Edit0.caption = ""
			Edit1.caption = ""
			Label0.caption = ""
			
		end if
	end if
	
End Sub



