	<SCRIPT_INFO _len="7866" _ulen="7052" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 계약정보_가입정보
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.01 김은숙
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'계약상태를 가져오기 위해 obwat_mgmt_271r(계약평가현황)을 태우는데, 
'obwat_ctcs_032r(계약종합정보)와의 Receive 시차가 커서 
'다른 항목은 다 뜬 상태에서 계약상태 한개 항목만 나중에 뜨는 문제 발생
'-> obwat_mgmt_271r(계약평가현황) 먼저 호출 후 계약상태를 Global 변수에 담아 두었다가
'   obwat_ctcs_032r(계약종합정보) Receive시 함께 뿌려줌

Dim g_sCnrcStat		'계약상태

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Function Account_Check()
	If Form.GetCtlProp("#acnt0", "total") = "" Then
		Form.ShowAlert("알림", "계좌번호는 필수값입니다.")
		Return False
	End If

	If Form.GetCtlProp("#cmbSeq", "caption") = "" Then
'		Form.ShowAlert("알림", "계약번호는 필수값입니다.")
		Return False
	End If
	
	Return true
End Function

'============================================================================
Function RequestData()
	'Clear Data
	For i = 0 to 16
		cont0.tbl0.SetCellString(i, 1, "")
		cont0.tbl0.SetCellString(i, 3, "")
	Next
	
	If Account_Check() == True then		
		'TR 호출 시점 변경
		'DATAMANAGER.RequestTranData( "obwat_ctcs_032r" )	'계약종합정보 조회
		DATAMANAGER.RequestTranData( "obwat_mgmt_271r" )	'계약평가현황 조회(계약상태 가져오기 위해 호출)
	End If
End Function

'============================================================================
'코드 치환
Sub SetTableData(szTranID)
	'------------------------------------------
	'가입자 구분
	'------------------------------------------
	Dim sCode1, sText1
	sCode1 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "JOIN_TYPE_CODE" , 0 )
		
	Select Case sCode1
		Case "66"
			sText1 = "일반형"
		Case "67"
			sText1 = "일반형 청년"
		Case "68"
			sText1 = "일반형 자산형성지원금지급자"
		Case "69"
			sText1 = "농어민"
		Case "70"
			sText1 = "농어민 청년"
		Case "72"
			sText1 = "농어민 자산형성지원금지급자"
		Case "73"
			sText1 = "서민형"
	End Select
		
	cont0.tbl0.SetCellString( 1 , 1 , sText1 )
		
	'------------------------------------------
	'고객투자성향
	'------------------------------------------
	Dim sCode3, sText3
	sCode3 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WA_KYC_GRAD_CODE" , 0 )
		
	Select Case sCode3
		Case "01"
			sText3 = "고수익지향형"
		Case "02"
			sText3 = "성장지향형"
		Case "03"
			sText3 = "중립형"
		Case "04"
			sText3 = "안정지향형"
		Case "05"
			sText3 = "이자소득형"
		Case "00"
			sText3 = "해당사항없음"
	End Select
		
	cont0.tbl0.SetCellString( 2 , 3 , sText3 )	
		
	'------------------------------------------
	'만기처리
	'------------------------------------------
	Dim sCode4, sText4
	sCode4 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "ATMT_CANC_YN" , 0 )
	
	Select Case sCode4
		Case "Y"
			sText4 = "자동매도"
		Case "N"
			sText4 = "지정매도"
	End Select
	
	cont0.tbl0.SetCellString( 8 , 1 , sText4 )	
	
	'------------------------------------------
	'성과보고서 발송처
	'------------------------------------------
	Dim sCode5, sText5
	sCode5 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "SNML_INAG_TYPE_CODE" , 0 )	

	Select Case sCode5
		Case "01"
			sText5 = "자택"
		Case "02"
			sText5 = "직장"
		Case "21"
			sText5 = "E-Mail"
	End Select
	
	cont0.tbl0.SetCellString( 9 , 1 , sText5 )	
	
	'------------------------------------------
	'운용통지 발송처
	'------------------------------------------
	Dim sCode6, sText6
	sCode6 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "ASET_RE_DSTR_PRIR_NTFY_CLCD" , 0 )
	
	Select Case sCode6
		Case "01"
			sText6 = "SMS"
	End Select
	
	cont0.tbl0.SetCellString( 9 , 3 , sText6 )
		
	'------------------------------------------
	'증권약정계좌
	'------------------------------------------	
	Dim sACNO, sASNO, sText7
	sACNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "LNKD_ACNO" , 0 )
	sASNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "LNKD_ASNO" , 0 )
	
	If Trim(sACNO) <> "" and Trim(sASNO) <> "" then
		sText7 = Left(sACNO, 4) & "-" & Right(sACNO, 4) & "-" & sASNO 
		cont0.tbl0.SetCellString( 14 , 1 , sText7 )
	End If
	
	'------------------------------------------
	'계열사종목
	'------------------------------------------
	Dim sCode8, sText8
	sCode8 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "WA_AFCO_LIST_INVT_YN" , 0 )
	Select Case sCode8
		Case "Y"
			sText8 = "운용"
		Case "N"
			sText8 = "제한"
	End Select
	
	cont0.tbl0.SetCellString( 11 , 3 , sText8 )
End Sub

'============================================================================
'계약상태 글로벌 변수에 셋팅
Sub SetCnrcStat(szTranID)
	Dim sCode
	sCode = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WA_CNRC_STAT_CLCD" , 0 )
		
	g_sCnrcStat = ""		'계약상태 
	Select Case sCode
		Case "01"
			g_sCnrcStat = "운용불가"
		Case "02"
			g_sCnrcStat = "정상"
		Case "03"
			g_sCnrcStat = "청산진행"
		Case "04"
			g_sCnrcStat = "청산완료"
		Case "05"
			g_sCnrcStat = "계약해지"
		Case "06"
			g_sCnrcStat = "계약취소"
		Case "07"
			g_sCnrcStat = "승인대기"
		Case "08"
			g_sCnrcStat = "거부"
	End Select
End Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()

End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "RECEIVE" Then
		RequestData()
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNO, szASNO
	
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#cmbSeq", "caption")

	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_ACNO" 	, 0 , szACNO )
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_CNRC_NO" , 0 , szASNO )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	'계약평가현황
	If szTranID == "obwat_mgmt_271r" then
		Call SetCnrcStat(szTranID)						'계약상태 글로벌 변수에 셋팅
		DATAMANAGER.RequestTranData( "obwat_ctcs_032r" )	'계약종합정보 조회
	End If
	
	'계약종합정보
	If szTranID == "obwat_ctcs_032r" then
		Call SetTableData(szTranID)						'코드 치환
		cont0.tbl0.SetCellString( 2 , 1 , g_sCnrcStat )	'계약상태 Display
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub
	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obwat_ctcs_032r" trcode="obwat_ctcs_032r" inputcheck="1" />
			<TRAN tranid="obwat_mgmt_271r" trcode="obwat_mgmt_271r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obwat_ctcs_032r" title="계약종합정보_랩계약정보조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="145" _ulen="101" >

WA_ACNO^랩어카운트계좌번호^8^0^0^0^0^0^0
WA_CNRC_NO^랩어카운트계약번호^10^0^0^0^0^0^0
PWD^비밀번호^68^0^0^0^0^0^0

				</TRBLOCK>
