	<SCRIPT_INFO _len="14525" _ulen="13683" >
'===========================================================================
' 01. 화 면 명: 전체계좌조회
' 02. 화면설명: 
' 03. 작    성: 2015.1.18 test3
' 2020.11.13 : 정민영 : v0001 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_efif_021r IO 변경분 반영
' 2022.06.08 : 장원혁 : v0002 : 고객이 마지막에 선택한 값에 따라 카드형/리스트형 초기값 세팅
'===========================================================================
'***************************************************************************
'     G L O B A L   V A R I A B L E
'***************************************************************************
Dim g_szSelectedItem	'그리드 선택된 아이템
Dim g_szJumin           '사용자 주민번호 
Dim g_szID         '사용자 아이디
Dim g_nTva              '평가금액 총합
Dim g_nTaa              '출금가능금액 총합
Dim g_sSelRow
Dim g_szToggleState, g_szListType

'20240531 SWJ START
Dim g_sOSType
g_sOSType = ""

Dim g_AcntNameFlag
g_AcntNameFlag = ""
'20240531 SWJ END
'===========================================================================
'20220104 아이티젠 김성수 리뉴얼 START
'===========================================================================
' f_SetToggleUI() : 토글 버튼 UI SET
'============================================================================
Function f_SetToggleUI()
	Dim szImgFile1, szImgFile2, szSelectColor, szNoneSelectColor, szToggle
	'szImgFile : 토글 선택 이미지1 = grdchart_lft.png, 선택 이미지2 = grdchart_rgt.png
	
	szImgFile1		= "grdchart_lft.png"
	szImgFile2		= "grdchart_rgt.png"
	szSelectColor		= "62" '글자색_버튼글자색(255,255,255)
	szNoneSelectColor	= "18" '글자색_소제목글자색(102,102,102)
'	szToggle			= g_szToggleState
	
	'	if szCellID == "th_cell1" then
'		 
'	elseif szCellID == "th_cell2" then
'		
'	end if
	
	if szToggle == "0" then
		cont0.imgToggle4.imgpath = szImgFile1
		cont0.lblToggle0.fgcolor = szSelectColor
		cont0.lblToggle1.fgcolor = szNoneSelectColor
		
		cont0.grdAcc.SetVisibleCol( 2, 1 )
		cont0.grdAcc.SetVisibleCol( 1, 0 )

	elseif szToggle == "1" then
		cont0.imgToggle4.imgpath = szImgFile2
		cont0.lblToggle0.fgcolor = szNoneSelectColor
		cont0.lblToggle1.fgcolor = szSelectColor
		
		cont0.grdAcc.SetVisibleCol( 2, 0 )
		cont0.grdAcc.SetVisibleCol( 1, 1 )
		
	end if
	
	DATAMANAGER.RequestTranData("obcsb_efif_021r")
End Function


Function f_SetListUI()
	if g_szListType == "LIST" then
		cont0.grdAcc2.visible = false
		cont0.grdAcc.visible = true
		
		cont0.lblType.caption = "리스트형"
		cont0.imgType.imgpath = "img_style1.png"
		
	elseif g_szListType == "CARD" then
		cont0.grdAcc.visible = false
		cont0.grdAcc2.visible = true
		
		cont0.lblType.caption = "카드형"
		cont0.imgType.imgpath = "img_style5.png"
	
	end if
	
End Function 
'20220104 아이티젠 김성수 리뉴얼 END
'***************************************************************************
'     C O M M O N   F U N C T I O N
'***************************************************************************
'===========================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
'    g_szJumin = Form.GetSharedData("&JUMIN_NUM", false )
    g_szID = Form.GetSharedData("&USER_ID", false )
	
	'20220104 아이티젠 김성수 리뉴얼 START
	g_szToggleState = "0" '출금가능 토글상태로 초기화
	'g_szListType = "CARD" v0002 주석처리
	g_szListType = Form.GetEnvData("whole_acnt_iqry") 'v0002
	If g_szListType <> "CARD" And g_szListType <> "LIST" Then 'v0002
	    g_szListType = "CARD" 'v0002
	End If
	
	f_SetListUI()
	f_SetToggleUI()
	'20220104 아이티젠 김성수 리뉴얼 END
	
	'20240531 SWJ START
	DATAMANAGER.SetDataValue(0, "obcsb_efif_028r", "InBlock1", "IQRY_CLS_CODE" 	, 0 , "1")
	DATAMANAGER.SetDataValue(0, "obcsb_efif_028r", "InBlock1", "ELFN_ID" 		, 0 , g_szID)
	DATAMANAGER.RequestTranData("obcsb_efif_028r")
	'20240531 SWJ END
	
	DATAMANAGER.RequestTranData("obcsb_efif_021r")
'	cont0.Button0.SetApplySwith("출금가능", "평가금액")

	'20240531 SWJ START
	g_sOSType = Form.GetSharedData("&OS_TYPE", false)
	'20240531 SWJ END
End Sub

	

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	sLoginType = Form.GetSharedData("&LOGIN_TYPE", false )
	sJumin	  = Form.GetSharedData("&JUMIN_NUM", false )  'v0001 취약점보완적용후 암호화된실명번호로 내려옴
	if sLoginType == "2" then
		DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )'주민번호(2)->아이디(1)로 구분설정
	else 
		DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1" )'주민번호(2)->아이디(1)로 구분설정
	end if
	
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "RCNO_PIP" , 0 ,  sJumin )  'v0001 RCNO->RCNO_PIP
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "VLTN_ACMP_YN", 0 , "Y" )'평가수행여부 설정
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "ELFN_ID", 0 , g_szID)
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    nCnt = DATAMANAGER.GetDataCount( 0, "obcsb_efif_021r" , "OutBlock1" )
    g_nTva = 0
    g_nTaa = 0
'    Form.ShowAlert("Count", nCnt)
    If nCnt > 0 then
       For i = 0 To nCnt-1           
	       szAcno = DATAMANAGER.GetDataValue( 0 , "obcsb_efif_021r", "OutBlock1", "REG_ACNO" , i )
	       szAsno = DATAMANAGER.GetDataValue( 0 , "obcsb_efif_021r", "OutBlock1", "REG_ASNO" , i )
	       vAmt = DATAMANAGER.GetDataValue( 0 , "obcsb_efif_021r", "OutBlock1", "VLTN_AMT", i)
	       aAmt = DATAMANAGER.GetDataValue( 0 , "obcsb_efif_021r", "OutBlock1", "DRNG_ABLE_AMT", i )
	       'DATAMANAGER.SetDataValue( 0 , "obcsb_efif_021r", "OutBlock1", "REG_ACNO" , 0 , szAcno& szAsno )
	       g_nTva = g_nTva + CDbl(vAmt)
	       g_nTaa = g_nTaa + CDbl(aAmt)
	       cont0.grdAcc.SetCellData( "bd_cell0" , i , szAcno & szAsno )
	       
		  '20220104 아이티젠 김성수 리뉴얼 START
	       cont0.grdAcc2.SetCellData( "bd_acnt" , i , szAcno & szAsno )
	       
	       cont0.grdAcc2.SetCellData( "bd_btnsend", i , "이체" )
	       cont0.grdAcc2.SetCellData( "bd_btnlist", i , "입출금내역" )
	       cont0.grdAcc2.SetCellFgColor("bd_btnsend", i, "274")
	       cont0.grdAcc2.SetCellFgColor("bd_btnlist", i, "274")
	       
		  cont0.grdAcc2.SetCellData( "bd_cash", i , CDbl(aAmt) )
		  cont0.grdAcc2.SetCellData( "bd_typenm" , i , "출금가능" )
	       
		  cont0.grdAcc2.SetCellData( "bd_cash1", i , CDbl(vAmt) )
		  cont0.grdAcc2.SetCellData( "bd_typenm1" , i , "평가금액" )
	       
		  '20220104 아이티젠 김성수 리뉴얼 END
		  
		  cont0.grdAcc2.setMaintainingRatio( "bd_copyImg", i, "1")
		  
		  '20240531 SWJ START
		  if g_sOSType == "2" then
			  cont0.grdAcc.setMaintainingRatio( "bd_copyImg", i, "1")
		  else
			  cont0.grdAcc.setMaintainingRatio( "bd_copyImg", i, "4")
		  end if
		  
		  cont0.grdAcc.SetCellData( "bd_copyImg" , i , "icon_copy_gray.png")
		  cont0.grdAcc2.SetCellData( "bd_copyImg" , i , "icon_copy_gray.png")
		  
		  szCustName = DATAMANAGER.GetDataValue(0 , "obcsb_efif_021r", "OutBlock1", "CUST_ABWR_NAME" , i)	'고객명
		  szNickName = DATAMANAGER.GetDataValue(0 , "obcsb_efif_021r", "OutBlock1", "INPR_BKKP_NAME" , i)	'별명
		  
		  if g_AcntNameFlag == "2" then
			  cont0.grdAcc.SetCellData("bd_cell1", i, szNickName)
		  else
			  cont0.grdAcc.SetCellData("bd_cell1", i, "")
		  end if
		 '20240531 SWJ END
	   Next
	   
	   cont0.Table0.SetCellString( 1, 1, g_nTva )
	   cont0.Table0.SetCellString( 2, 1, g_nTaa )
	End If   
	
	'20240531 SWJ START
	'계좌별명 설정여부 판단
	if szTranID == "obcsb_efif_028r" then
		szAcntExrsCode = DATAMANAGER.GetDataValue( 0, "obcsb_efif_028r", "OutBlock1", "ACNT_ALS_EXRS_CODE" , 0)
		
		'별명
		if szAcntExrsCode == "2" then
			'별명 선택 시
			g_AcntNameFlag = "2"
		else
			'계좌명 선택 시
			g_AcntNameFlag = "1"
		end if
	end if
	'20240531 SWJ END
End Sub

'============================================================================
Sub cont0_grdAcc_OnClickUp(lRow, szCellID)
   
     g_sSelRow = lRow;
	g_szSelectedItem	= cont0.grdAcc.GetCellData( "bd_cell0", lRow )'계좌번호 
'    szPrcd =  cont0.grdAcc.GetCellData( "bd_cell4", lRow )
	listLocation =  Split( cont0.grdAcc.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]

'	Select Case szPrcd
'	szBkop =  cont0.grdAcc.GetCellData( "bd_cell6", lRow )	 
	sPopupType = "3"
	
	'20240531 SWJ START
	if szCellID == "bd_copyImg" or szCellID == "bd_cell0" then
		Form.setClipboardText(g_szSelectedItem)  '클립보드에 복사
		
		if g_sOSType == "2" then
			Form.Toast(0, "클립보드에 복사되었어요.", 0.2)
		end if
		
		exit sub
	end if
	'20240531 SWJ END
	
	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "이체" & "★" & "입출금내역" & "★" & " " & "★" & " " & "★" & " ")''
'	End Select
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim szListItems
	
	if sKeyName = "MOVEPOP_RETURN"	then
		szListItems	=	split(sRet,"★")
		
		if	szListItems(1)	=	"0"	then			'이체
			szPrcd =  cont0.grdAcc.GetCellData( "bd_cell4", g_sSelRow )
		    szBkop =  cont0.grdAcc.GetCellData( "bd_cell6", g_sSelRow )

		    if szPrcd == "101" then
		       if szBkop == "N" then
                     Form.OpenScreen("63010" , g_szSelectedItem)
                     Form.PostLinkData("mbbnk63010setDrngAcnt", g_szSelectedItem)
			   else 
			      Form.OpenScreen("61020" , g_szSelectedItem & "★" & "0") '은행입출금
			   end if
			elseif szPrcd == "105" or szPrcd == "106" or szPrcd == "107" or szPrcd == "108" then
			   Form.OpenScreen("61020" , g_szSelectedItem & "★" & "0")    
			
			else
			
			Form.OpenScreen("63010" , g_szSelectedItem)
			Form.PostLinkData("mbbnk63010setDrngAcnt", g_szSelectedItem)
			
			end if
		elseif	szListItems(1)	=	"1"	then		'입출금
		    
			   'Form.OpenScreen("61060" , g_szSelectedItem & "★" & "0")
			   Form.OpenScreen("63030" , g_szSelectedItem)
			 
		end if	
	end if	
End Sub

'============================================================================
Sub cont0_grdAcc_OnHeaderClickUp(lRow, szCellID)
	if szCellID == "th_cell1" then
		 cont0.grdAcc.SetVisibleCol( 2, 0 )
		 cont0.grdAcc.SetVisibleCol( 1, 1 )
	elseif szCellID == "th_cell2" then
		 cont0.grdAcc.SetVisibleCol( 2, 1 )
		 cont0.grdAcc.SetVisibleCol( 1, 0 )	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obcsb_efif_021r" then
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림", szErrMsg & " " & sSubMsg )
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	DATAMANAGER.RequestTranData("obcsb_efif_021r")
End Sub

