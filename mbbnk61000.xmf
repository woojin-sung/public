'============================================================================
Sub cont0_grdAcc2_OnClickUp(lRow, szCellID)
	Dim szSelectedAcnt
	szSelectedAcnt = cont0.grdAcc2.GetCellData( "bd_acnt", lRow )
	
	if szSelectedAcnt <> "" and szSelectedAcnt <> null then
		if szCellID == "bd_btnsend" then '이체
			dim szPrcd, szBkop
			szPrcd =  cont0.grdAcc2.GetCellData( "bd_prcd", lRow )
			szBkop =  cont0.grdAcc2.GetCellData( "bd_bnkopen", lRow )
			
			if szPrcd == "101" then
			   if szBkop == "N" then
			      
			      Form.OpenScreen("63010" , szSelectedAcnt)
			      Form.PostLinkData("mbbnk63010setDrngAcnt", szSelectedAcnt)
			      
			   else 
			      Form.OpenScreen("61020" , szSelectedAcnt & "★" & "0") '은행입출금
			   end if
			   
			elseif szPrcd == "105" or szPrcd == "106" or szPrcd == "107" or szPrcd == "108" then
			   Form.OpenScreen("61020" , szSelectedAcnt & "★" & "0")    
			
			else
				
				Form.OpenScreen("63010" , szSelectedAcnt)
				Form.PostLinkData("mbbnk63010setDrngAcnt", szSelectedAcnt)
				
			end if
		elseif szCellID == "bd_btnlist" then '입출금내역
			'Form.OpenScreen("61060" , szSelectedAcnt & "★" & "0")
			Form.OpenScreen("63030" , szSelectedAcnt)
		
		'20240531 SWJ START
		elseif szCellID == "bd_copyImg" or szCellID == "bd_acnt" then
			Form.setClipboardText(szSelectedAcnt)  '클립보드에 복사

			if g_sOSType == "2" then
				Form.Toast(0, "클립보드에 복사되었어요.", 0.2)
			end if
		
		'20240531 SWJ END
		end if
	
	else
		Form.ShowAlert("", "계좌정보가 없습니다.")
	end if
End Sub

'============================================================================
Sub cont0_grdAcc2_OnScrollEnd()
	Dim isMore
	isMore = DATAMANAGER.IsMoreNextData( "obcsb_efif_021r" )
	if isMore == true or isMore == "1" or isMore == 1 then
		DATAMANAGER.RequestNextData( "obcsb_efif_021r" )
	end if
End Sub

'============================================================================
Sub cont0_lblType_OnClick()
    
	if g_szListType == "CARD" then
		g_szListType = "LIST"
		Form.SetEnvData( 1, "whole_acnt_iqry", "LIST" ) 'v0002
	elseif g_szListType == "LIST" then
		g_szListType = "CARD"
		Form.SetEnvData( 1, "whole_acnt_iqry", "CARD" ) 'v0002
	end if
	
	f_SetListUI()
End Sub

'============================================================================
Sub cont0_imgType_OnClick()
    
	if g_szListType == "CARD" then
		g_szListType = "LIST"
		Form.SetEnvData( 1, "whole_acnt_iqry", "LIST" ) 'v0002
	elseif g_szListType == "LIST" then
		g_szListType = "CARD"
		Form.SetEnvData( 1, "whole_acnt_iqry", "CARD" ) 'v0002
	end if
	
	f_SetListUI()
End Sub

