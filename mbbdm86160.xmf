'============================================================================
Sub Form_OnFormInit()
	'2021.04.07. 김유경 추가
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	g_szTheme = Form.GetEnvData("common.theme")
		
	ContMain.EdtName.fgcolor    = 267
	ContMain.EdtJumin.fgcolor   = 267
	ContMain.EdtEngName.fgcolor = 267
	ContMain.Label1.fgcolor     = 269
	
	closeFlag = "0"
	setRadioButtonData = ""
	sProsAbleYn  = 0
	sProsAbleYn1 = 0
	
	bAddrSlct = false
	g_FirstYn = false
	
	g_szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	'iOS 스크롤 제어용
	if g_szOSType == "2" then
'		ContMain.vscroll = "0"
		
		ContMain.setExceptInvisibleCtl(true)
		ContMain.setScrollAutoSize()
	else
		ContMain.setScrollBarVisible("2")	
	end if
	
	'***************************************************************
	'주의: Label5.top 처럼 top 값을 셋팅해주면 컨트롤 움직임 이상이
	'발생할 수있으므로 컨트롤.top 말고 숫자로 셋팅해줘야함.
	'***************************************************************
	
	'영역별 top 간격 45
	
	'주소 정보 입력
	ContMain.EdtAddr.top    = 411 + 15 '주소지 정보 Lable2 + 간격
	ContMain.BtnAddr.top    = 411 + 15 '주소지 정보 Lable2 + 간격
	 
	'에디트 위에 다른 컨트롤이 올라가면 꼭 호출해줘야함
	ContMain.BtnAddr.bringFront("1")
	
	ContMain.EdtAddrDtl.top = 411 + 15 + 74 + 10 
	ContMain.BtnAddrDtl.top = 411 + 15 + 74 + 10
	
	'에디트 위에 다른 컨트롤이 올라가면 꼭 호출해줘야함
	ContMain.BtnAddrDtl.bringFront("1") 
	
	ContMain.EdtOwhsNum.top  = 411 + 15 + 74 + 10 + 74 + 10 '자택전화번호
	ContMain.EdtOwhsNum.left = 20
	ContMain.EdtWrplNum.top  = 411 + 15 + 74 + 10 + 74 + 10 '직장전화번호
	ContMain.EdtWrplNum.left = 20
	
	'주소지정보의 자택/직장 선택 여부에 따라 보여줘야 하므로 처음엔 숨김처리
	ContMain.EdtOwhsNum.visible = false
	ContMain.EdtWrplNum.visible = false
		
	'연락처정보 	
	ContMain.Label5.top = 689
	ContMain.Label5.left = 18

	ContMain.EdtPhone.top  = 689 + 20 + 10	  '연락처
	ContMain.EdtPhone.left = 20
	
	ContMain.EdtEmail.top   = 689 + 20 + 10 + 74 + 10 '이메일주소
	ContMain.EdtEmail.left  = 20	
		
	
	'통보지 정보 (우편물/거래내역/계약서류/연금수익률) 858
	ContMain.Label4.top = 898
	ContMain.Label4.left = 12
	
	ContMain.chkMobile.top = 898
	ContMain.imgTooltip1.top = 898
	
	'우편물 통보 라디오버튼
	ContMain.cmbMailInform.top = 898 + 20 + 10		
	ContMain.cmbMailInform.left = 20
	
	'거래내역 통보 라디오버튼
	ContMain.cmbTransInform.top = 898 + 20 + 10 + 74 + 10
	ContMain.cmbTransInform.left = 20
	
	'v0007 STA : 계약서류 제공 방식 추가
	ContMain.cmbCtcn.top = 898 + 20 + 10 + 74 + 10 + 74 + 10
	ContMain.cmbCtcn.left = 20
	
	'연금수익률보고서 통보지 추가
	ContMain.cmbPension.top = 898 + 20 + 10 + 74 + 10 + 74 + 10 + 74 + 10
	ContMain.cmbPension.left = 20
	
	'빈라인하나 추가..
	ContMain.Label3.top = 898 + 20 + 10 + 74 + 10 + 74 + 10 + 74 + 10 
	ContMain.Label3.left = 20
	
	ContMain.cmbMailInform.visible = false
	ContMain.cmbTransInform.visible = false
	ContMain.cmbCtcn.visible = false
	ContMain.cmbPension.visible = false
	
	BtnNext.enable = False
	If g_szTheme = "black" Then
		BtnNext.btnimage = "btn_27.9"
	Else 
		BtnNext.btnimage = "btn_21.9"
	End If
	BtnNext.fgcolor = "269"
	
	'*****************************************************
	'주의: init 했을 때 컨트롤 위치 셋팅 후 setApplyLabel
	'에디트 컨트롤 입력항목명 생성
	'*****************************************************
	ContMain.EdtName.setApplyLabel   ("이름" 	   , 0 , 268 , "left" , false)
	ContMain.EdtJumin.setApplyLabel  ("주민등록번호" , 0 , 268 , "left" , false)
	ContMain.EdtEngName.setApplyLabel("영문명"       , 0 , 268 , "left" , true)
	ContMain.EdtAddr.setApplyLabel   ("주소" 	   , 0 , 268 , "left" , true)
	ContMain.EdtAddrDtl.setApplyLabel("상세주소" 	   , 0 , 268 , "left" , true)	
	ContMain.EdtPhone.setApplyLabel  ("휴대폰번호"   , 0 , 268 , "left" , true)
	ContMain.EdtEmail.setApplyLabel  ("이메일 주소"  , 0 , 268 , "left" , true)
	ContMain.EdtOwhsNum.setApplyLabel("자택 전화번호", 0 , 268 , "left" , false)
	ContMain.EdtWrplNum.setApplyLabel("직장 전화번호", 0 , 268 , "left" , false)
	
	ContMain.cmbMailInform.setApplyLabel("우편물 통보" 	   , 0 , 268 , "left" , true)
	ContMain.cmbTransInform.setApplyLabel("거래내역 통보" 	   , 0 , 268 , "left" , true)
	ContMain.cmbCtcn.setApplyLabel("계약서류 통보" 	   , 0 , 268 , "left" , true)
	ContMain.cmbPension.setApplyLabel("연금 수익률 통보" 	   , 0 , 268 , "left" , true)
	
	ContMain.cmbMailInform.cbtype = "5"
	ContMain.cmbTransInform.cbtype = "5"
	ContMain.cmbCtcn.cbtype = "5"
	ContMain.cmbPension.cbtype = "5"
	
	'Default값 셋팅 후 비활성화 컨트롤: 컨트롤 속성에서 사용가능으로 체크한 후에 setApplyLabel 아래에서 enable = False
	ContMain.EdtName.enable = False
	ContMain.EdtJumin.enable = False
	ContMain.EdtPhone.enable = False
	
	'help msg
	ContMain.EdtEmail.SetUseResultLabel(true,2)
	ContMain.EdtOwhsNum.SetUseResultLabel(true, 1) '2021.04.12.김유경. 자택/직장전화번호 체크 추가
	ContMain.EdtWrplNum.SetUseResultLabel(true, 1) '2021.04.12.김유경. 자택/직장전화번호 체크 추가
	ContMain.EdtEngName.SetUseResultLabel(true, 1) '2021.04.13.김유경. 영문명 help msg 추가
	'2021.04.14. 김유경 입력값 체크 추가
	ContMain.EdtAddr.SetUseResultLabel(true, 1)
	ContMain.EdtAddrDtl.SetUseResultLabel(true, 1)
	
	'****************
	' 컨트롤 초기화 
	'****************
	Call ContClear()
	
	'*****************************************************************************************
	' 데이터 셋팅
	'*****************************************************************************************
	gRCNO = Form.GetSharedData("BDM_RCNO_PIP"  , false ) '주민등록번호
	HP1	 = Form.GetSharedData("BDM_HP1"	      , false ) '휴대폰번호
	HP2 	 = Form.GetSharedData("BDM_HP2"	      , false )
	HP3 	 = Form.GetSharedData("BDM_HP3"	      , false )
	gRegUniqNo = Form.GetSharedData("BDM_REG_UNIQ_NO"  , false ) '등록고유번호
	gMaskRcno  = Form.GetSharedData("BDM_MaskRcno" , false)
	
	gPageID    = "1" '화면단계 구분
	ContMain.EdtPhone.caption = HP1 & "-" & HP2  & "-" & HP3
	
	'20230428 디폴트값 추가
	g_SnmlInagCd = "0"
		
	'2021.04.15. 김유경. 이전화면 데이터 셋팅 추가
	Call GetSharedData_Setting()
		
	sRevData = Form.GetOpenLinkData()
	
	'이전 화면에서 돌아오면 컨트롤 모두보이기
	If sRevData == "StepBack" then
		'고객정보
		ContMain.Label6.visible     = true
		ContMain.EdtName.visible    = true
		ContMain.EdtJumin.visible   = true
		ContMain.EdtEngName.visible = true
		
		'주소지정보
		ContMain.Label2.visible     = true
		'ContMain.Button0.visible    = true
		ContMain.RadioSelectGbn2.visible    = true '2021.04.16. 김유경 Butto0 -> RadioSelectGbn2 컨트롤 변경
		ContMain.EdtAddr.visible    = true
		ContMain.EdtAddrDtl.visible = true
		ContMain.BtnAddr.visible    = true
		ContMain.BtnAddrDtl.visible = true
		
		'우편물 통보
		ContMain.Label4.visible          = true
		ContMain.chkMobile.visible		 = true
		ContMain.imgTooltip1.visible	 = true
		
		'연락처 정보
		ContMain.Label5.visible      = true
		
		ContMain.EdtPhone.visible    = true
		ContMain.EdtEmail.visible    = true
		ContMain.EdtOwhsNum.visible  = true
		ContMain.EdtWrplNum.visible  = true

		'계약서류 제공 정보
		ContMain.cmbCtcn.visible = true
		'v0007 END

		'입력한 정보 Setting
		ContMain.EdtName.caption    = getDataName
		ContMain.EdtJumin.caption   = gMaskRcno 'Form.GetSharedData( "BDM_MaskRcno" , false)
		ContMain.EdtEngName.caption = getDataEngname
		
		'주소지정보
		'2021.04.16 . 김유경 Butto0 -> RadioSelectGbn2 컨트롤 변경
		'Contmain.Button0.SetApplySwitch("자택","직장")
		If getDataAddrgbn == "01" Then
			'ContMain.Button0.switchIndex = "0"
			ContMain.RadioSelectGbn2.currentindex = "0"
		ElseIf getDataAddrgbn == "02" Then
			'ContMain.Button0.switchIndex = "1"
			ContMain.RadioSelectGbn2.currentindex = "1"
		End If
		
		ContMain.EdtRegnZip.caption	    = getDataRegnzip
		ContMain.EdtDtlZip.caption     = getDataDtlzip
		ContMain.EdtAddr.caption       = getDataAddr
		ContMain.EdtAddrDtl.caption    = getDataAddrdtl
		ContMain.CYN.caption           = getDataCyn
		ContMain.Cbldn.caption         = getDataCbldn
	
		If getDataAddrgbn = "01" Then
			'자택 주소
			g_OwhsRegnZip 	= ContMain.EdtRegnZip.caption 			
			g_OwhsDtlZip 		= ContMain.EdtDtlZip.caption			
			g_OwhsPost 		= ContMain.EdtAddr.caption					
			g_OwhsDtad 		= ContMain.EdtAddrDtl.caption				
			g_OwhsNwAddrUseYN	= ContMain.CYN.caption				
			g_OwhsBldnMnno 	= ContMain.Cbldn.caption				
					
		ElseIf getDataAddrgbn = "02" Then
			'직장 주소
			g_CoRegnZip 		= ContMain.EdtRegnZip.caption 				
			g_CoDtlZip 		= ContMain.EdtDtlZip.caption					
			g_CoPost 		= ContMain.EdtAddr.caption						
			g_CoDtad 		= ContMain.EdtAddrDtl.caption						
			g_CoNwAddrUseYN	= ContMain.CYN.caption		
			g_CoBldnMnno 		= ContMain.Cbldn.caption	
			
		End If
	
		'거래내역 통보
		If getDataSnmlclcd == "13" Then					'"13": 알림톡 추가
			ContMain.cmbTransInform.currentindex = "0"
		ElseIf getDataSnmlclcd == "21" Then
			ContMain.cmbTransInform.currentindex = "1"
		ElseIf getDataSnmlclcd == "01" Then
			ContMain.cmbTransInform.currentindex = "2"
		ElseIf getDataSnmlclcd == "02" Then
			ContMain.cmbTransInform.currentindex = "3"
		End If
		
		'우편물 통보
		If getDataMailclcd == "01" Then
			ContMain.cmbMailInform.currentindex = "0"
		ElseIf getDataMailclcd == "02" Then
			ContMain.cmbMailInform.currentindex = "1"
		End If
		
		ContMain.EdtEmail.caption    = getDataEmail
		ContMain.EdtOwhsNum.caption  = getDataOwhsnum
		ContMain.EdtWrplNum.caption  = getDataWrplnum
		
		'v0007 STA : 계약서류 제공 정보
		If getHndvMthdCd == "04" Then
			ContMain.cmbCtcn.currentindex = "0"
		ElseIf getHndvMthdCd == "02" Then
			ContMain.cmbCtcn.currentindex = "1"
		End If	
		'v0007 END
		
		'연금수익률보고서 통보처 유형코드
		If getPRCD131 == "Y" Then
'			ContMain.lblPension.visible = true
'			ContMain.rdoPension.visible = true
			
			ContMain.cmbPension.visible = true
			
			If getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE == "99" Then
				ContMain.cmbPension.currentindex = "0"
			ElseIf getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE == "21" Then
				ContMain.cmbPension.currentindex = "1"
			ElseIf getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE == "01" Then
				ContMain.cmbPension.currentindex = "2"
			ElseIf getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE == "02" Then
				ContMain.cmbPension.currentindex = "3"
			End If
		End If
		
		If f_CheckOnlyWrap() Then
			'유효한 종합계좌 또는 CMA 계좌가 있는지 조회
			'있으면 계약서류발송방식 영역을 보여줌
			
			'비대면용 설정가능계좌 내역조회
			DATAMANAGER.RequestTranData( "obaci_nmet_016r" )
		End If
		
		
		BtnNext.enable = True
		BtnNext.btnimage = "btn_20.9"
		BtnNext.fgcolor = "273"
	
		'ContMain.scroll_pos = 1194
		ContMain.setScrollAutoSize()
	Else
		DATAMANAGER.RequestTranData("obaci_acct_058r")
	End If
	
	
End Sub

'============================================================================
Sub ContMain_EdtEngName_OnEditComplete()
	If Str_Chk(ContMain.EdtEngName.caption, "ENG_NAME") == False then		 
		ContMain.EdtEngName.SetResultLabel("1","error","고객영문명은 영문만 입력 가능합니다.","ContMain")
		Exit Sub
	Else
		ContMain.EdtEngName.SetResultLabel("0","complete","","ContMain")
	End If
	
	if Trim(ContMain.EdtEngName.caption) <> "" then
		'하위항목 입력 후 영문명 수정하는 경우 대비
		if ContMain.RadioSelectGbn2.currentindex == "-1" then
		
			'20230420 추가
			if bOld == "Y" and (g_MailInagCode == "01" or g_MailInagCode == "02") then
			
				'주소지정보 라벨 
				ContMain.Label2.visible  = true
				
				'직장/자택 선택버튼
				ContMain.RadioSelectGbn2.visible = true
				'ContMain.RadioSelectGbn2.currentindex = "-1"
				
				'주소입력 에디트
				ContMain.EdtAddr.visible = true
				ContMain.BtnAddr.visible = true
				
				'상세주소 입력에디트 
				ContMain.EdtAddrDtl.visible = true
				ContMain.BtnAddrDtl.visible = true
				
				
				if g_MailInagCode == "01" then
					ContMain_RadioSelectGbn2_OnClick(0)
					ContMain.RadioSelectGbn2.currentindex = "0"
				else
					ContMain_RadioSelectGbn2_OnClick(0)
					ContMain.RadioSelectGbn2.currentindex = "1"
				end if	
				
				'20230428 처음 조회후 세팅시 타지 않도록 하기 위함
				if g_FirstYn then
					Form.SetTimerEvent2(2, 1, 0.6)	
				end if
				
			else		
				'주소지정보 라벨 
				ContMain.Label2.visible  = true
				
				'직장/자택 선택버튼
				ContMain.RadioSelectGbn2.visible = true
				ContMain.RadioSelectGbn2.currentindex = "-1"
				
				'주소입력 에디트
				ContMain.EdtAddr.visible = true
				ContMain.BtnAddr.visible = true
				
				'상세주소 입력에디트 
				ContMain.EdtAddrDtl.visible = true
				ContMain.BtnAddrDtl.visible = true
				
				'20230428 처음 조회후 세팅시 타지 않도록 하기 위함
				if g_FirstYn then
					Form.SetTimerEvent2(2, 1, 0.6)	
				end if
			end if
		end if
	End if
	
	f_CheckNextEnable()
End Sub

'============================================================================
'주소지정보 입력완료
'============================================================================
Sub ContMain_EdtAddr_OnEditComplete()
	If ContMain.EdtAddr.caption <> "" then
		'상세주소 입력에디트 
		ContMain.EdtAddrDtl.visible = true
	End if
	
End Sub
'============================================================================
'상세주소 정보 입력완료
'============================================================================
Sub ContMain_EdtAddrDtl_OnEditComplete()
	If ContMain.EdtAddrDtl.caption <> ""  then
		
		'iOS 스크롤 제어용
'		if g_szOSType == "2" then
'			ContMain.vscroll = "1"
'		end if

		'20230420 분기추가..
		'첫고객은 그대로..
		if bOld == "N" then
		
			'스크롤 이동은 timerEvent 함수에서 발생시키지만 예외CASE
			if g_PNSNYN == "Y" then
				nLabStndTop = 1250
			else
				nLabStndTop = 1150
			end if
			
			'주소 검색 후, 자택/직장 라디오 각각 스크롤 위치 분기
			if bAddrSlct then
				nCtrlTop = Cint(Form.calcUnResize(ContMain.RadioSelectGbn2.top, "1"))
				bAddrSlct = false
			else
				nCtrlTop = Cint(Form.calcUnResize(ContMain.Label5.top, "1"))
			end if
			ContMain.LabStnd.top = nLabStndTop
			ContMain.setScrollAutoSize()
			ContMain.scroll_pos = nCtrlTop		
		
		'20230428 기존고객은 주소세팅시.. 스크롤 안되게 해달라함(김지원과장)
		'기존고객은... 주소세팅시 이 로직 타지 않도록 함.		
'		elseif g_FirstYn then
'		
'			'스크롤 이동은 timerEvent 함수에서 발생시키지만 예외CASE
'			if g_PNSNYN == "Y" then
'				nLabStndTop = 1250
'			else
'				nLabStndTop = 1150
'			end if
'			
'			'주소 검색 후, 자택/직장 라디오 각각 스크롤 위치 분기
'			if bAddrSlct then
'				nCtrlTop = Cint(Form.calcUnResize(ContMain.RadioSelectGbn2.top, "1"))
'				bAddrSlct = false
'			else
'				nCtrlTop = Cint(Form.calcUnResize(ContMain.Label5.top, "1"))
'			end if
'			ContMain.LabStnd.top = nLabStndTop
'			ContMain.setScrollAutoSize()
'			ContMain.scroll_pos = nCtrlTop
		
		end if
		
		'연락처 영역 보임
		ContMain.Label5.visible = true
	
		ContMain.EdtPhone.visible = true
		
		ContMain.EdtEmail.visible = true
		
		'우편물통보
		ContMain.Label4.visible = true
		ContMain.chkMobile.visible		 = true
		ContMain.imgTooltip1.visible	 = true
		
		ContMain.Label3.visible = true
		
		'자택/직장 라디오버튼
'		ContMain.cmbMailInform.currentindex = setRadioButtonData
		
		ContMain.cmbMailInform.visible = true
		ContMain.cmbTransInform.visible = true
		
		'v0007 STA
		'교부방식
		If f_CheckOnlyWrap() == False then
			ContMain.cmbCtcn.visible = true
		Else
			'유효한 종합계좌 또는 CMA 계좌가 있는지 조회
			'있으면 계약서류발송방식 영역을 보여줌
			
			'비대면용 설정가능계좌 내역조회
			DATAMANAGER.RequestTranData( "obaci_nmet_016r" )
		End If
		
		if g_PNSNYN == "Y" then
			ContMain.cmbPension.visible = true
		else
			ContMain.cmbPension.visible = false
		end if
		
		'우편물통보 디폴트설정
		if ContMain.RadioSelectGbn2.currentindex == "0" then
			ContMain.cmbMailInform.currentindex = "0" 
		elseif ContMain.RadioSelectGbn2.currentindex == "1" then
			ContMain.cmbMailInform.currentindex = "1" 
		end if
		
		'각 콤보가 노출될때 디폴트 세팅해줌
		'거래내역, 계약서류 통보 디폴트 > 알림톡 문자
		'연금수익률통보 디폴트 > 이메일
		
		'20230428 디폴트값 수정
		'ContMain.cmbTransInform.currentindex = "0"
		ContMain.cmbTransInform.currentindex = g_SnmlInagCd
		
		ContMain.cmbCtcn.currentindex = "0"
		
		'20230523 추가
		ContMain.setScrollAutoSize()		
		
		'연금수익률통보 디폴트는 이메일이 입력이 되어있다면 세팅(신규고객은 해당 없을듯)
		'이메일 정보 없으면 우편물 통보처와 같게 세팅
		if g_PNSNYN == "Y" then
			if ContMain.EdtEmail.caption <> "" and ContMain.EdtEmail.caption <> null then
				ContMain.cmbPension.currentindex = "1"
			else
				if ContMain.RadioSelectGbn2.currentindex == "0" then
					ContMain.cmbPension.currentindex = "2" 
				elseif ContMain.RadioSelectGbn2.currentindex == "1" then
					ContMain.cmbPension.currentindex = "3" 
				end if
			end if
		end if

		'20230417 활성화
		f_SetComboOption()
	End if
	
End Sub

