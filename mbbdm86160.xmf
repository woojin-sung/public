'============================================================================
Sub Set_Address()
	s_AD_YN 		= Form.GetSharedData("10050_ADDRESS_YN"      , False ) 'Y: 신주소 N: 구주소
	s_AD_REGN_ZIP	= Form.GetSharedData("10050_ADDRESS_REGN_ZIP", False )
	s_AD_DTL_ZIP	= Form.GetSharedData("10050_ADDRESS_DTL_ZIP" , False )
	s_AD_POST 	= Form.GetSharedData("10050_ADDRESS_POST"    , False )
	s_AD_DTAD 	= Form.GetSharedData("10050_ADDRESS_DTAD"    , False )
	s_AD_BLDN 	= Form.GetSharedData("10050_ADDRESS_BLDN"    , False )
	
	ContMain.EdtRegnZip.caption  = Trim(s_AD_REGN_ZIP)
	ContMain.EdtDtlZip.caption   = Trim(s_AD_DTL_ZIP)
	ContMain.EdtAddr.caption     = Trim(s_AD_POST)
	ContMain.EdtAddrDtl.caption  = Trim(s_AD_DTAD)
	
	ContMain.CYN.caption = s_AD_YN
	ContMain.Cbldn.caption = s_AD_BLDN

	ContMain.EdtAddr.SetResultLabel("0","complete","","ContMain")
	ContMain.EdtAddrDtl.SetResultLabel("0","complete","","ContMain")
	
	If ContMain.RadioSelectGbn2.currentindex == "0" or ContMain.RadioSelectGbn2.currentindex == 0 Then
		g_InagTypeCode = "01"
	ElseIf ContMain.RadioSelectGbn2.currentindex == "1" or ContMain.RadioSelectGbn2.currentindex == 1 Then
	     g_InagTypeCode = "02"
	End If 
		
	If g_InagTypeCode = "01" Then
		'자택 주소
		g_OwhsRegnZip 	= ContMain.EdtRegnZip.caption 			
		g_OwhsDtlZip 		= ContMain.EdtDtlZip.caption			
		g_OwhsPost 		= ContMain.EdtAddr.caption					
		g_OwhsDtad 		= ContMain.EdtAddrDtl.caption				
		g_OwhsNwAddrUseYN	= ContMain.CYN.caption				
		g_OwhsBldnMnno 	= ContMain.Cbldn.caption		
		
		ContMain.cmbMailInform.currentindex = "0"
		
	ElseIf g_InagTypeCode = "02" Then
		'직장 주소
		g_CoRegnZip 		= ContMain.EdtRegnZip.caption 				
		g_CoDtlZip 		= ContMain.EdtDtlZip.caption					
		g_CoPost 		= ContMain.EdtAddr.caption						
		g_CoDtad 		= ContMain.EdtAddrDtl.caption						
		g_CoNwAddrUseYN	= ContMain.CYN.caption		
		g_CoBldnMnno 		= ContMain.Cbldn.caption	
		
		ContMain.cmbMailInform.currentindex = "1"
	End If

	f_SetComboOption()
	
	If g_InagTypeCode = "01" Then
		ContMain.cmbMailInform.currentindex = "0"
	ElseIf g_InagTypeCode = "02" Then
		ContMain.cmbMailInform.currentindex = "1"
	end if
	
	
	Call ContMain_EdtAddrDtl_OnEditComplete()
	
	f_CheckNextEnable()
	
End Sub 

'============================================================================
'화면 내 콤보 선택가능항목 세팅
'============================================================================
Function f_SetComboOption()
	Dim szEmail
	szEmail = ContMain.EdtEmail.caption
	if szEmail == "" or szEmail == null then
		szEmail = ""
	end if
	
	'체크 전 초기화
	ContMain.cmbMailInform.SetDisableIndex(false, "")
	ContMain.cmbTransInform.SetDisableIndex(false, "")
	ContMain.cmbCtcn.SetDisableIndex(false, "")
	if g_PNSNYN == "Y" then
		ContMain.cmbPension.SetDisableIndex(false, "")
	end if
	
	
'	'자택주소 입력 안된 경우
'	if g_OwhsRegnZip == "" then
'		ContMain.cmbMailInform.SetDisableIndex(true, "0")	'0.자택
'		ContMain.cmbTransInform.SetDisableIndex(true, "2")	'2.자택
'		if g_PNSNYN == "Y" then
'			ContMain.cmbPension.SetDisableIndex(true, "2")	'2.자택
'		end if	
'	end if
'	
'	if g_CoRegnZip == "" then
'		ContMain.cmbMailInform.SetDisableIndex(true, "1")	'1.직장
'		ContMain.cmbTransInform.SetDisableIndex(true, "3")	'3.직장
'		if g_PNSNYN == "Y" then
'			ContMain.cmbPension.SetDisableIndex(true, "3")	'3.직장
'		end if	
'	end if
'	
'	if szEmail == "" then
'		ContMain.cmbTransInform.SetDisableIndex(true, "1")	'1.이메일
'		ContMain.cmbCtcn.SetDisableIndex(true, "1")			'1.이메일
'		if g_PNSNYN == "Y" then
'			ContMain.cmbPension.SetDisableIndex(true, "1")	'1.이메일
'		end if	
'	end if
	
	
	
	
	
	'직장주소 입력 안된 경우
	if g_OwhsRegnZip <> "" and g_CoRegnZip == "" then
		'이메일 입력 여부도 추가로 체크
		if szEmail == "" then
			ContMain.cmbMailInform.SetDisableIndex(true, "1")
			ContMain.cmbTransInform.SetDisableIndex(true, "1:3")
			ContMain.cmbCtcn.SetDisableIndex(true, "1")
			if g_PNSNYN == "Y" then
				ContMain.cmbPension.SetDisableIndex(true, "1:3")
			end if
		else
			ContMain.cmbMailInform.SetDisableIndex(true, "1")
			ContMain.cmbTransInform.SetDisableIndex(true, "3")
			if g_PNSNYN == "Y" then
				ContMain.cmbPension.SetDisableIndex(true, "3")
			end if
		end if
	
	'자택주소 입력 안된 경우
	elseif g_OwhsRegnZip == "" and g_CoRegnZip <> "" then
		'이메일 입력 여부도 추가로 체크
		if szEmail == "" then
			ContMain.cmbMailInform.SetDisableIndex(true, "0")
			ContMain.cmbTransInform.SetDisableIndex(true, "1:2")
			ContMain.cmbCtcn.SetDisableIndex(true, "1")
			if g_PNSNYN == "Y" then
				ContMain.cmbPension.SetDisableIndex(true, "1:2")
			end if
		else
			ContMain.cmbMailInform.SetDisableIndex(true, "0")
			ContMain.cmbTransInform.SetDisableIndex(true, "2")
			if g_PNSNYN == "Y" then
				ContMain.cmbPension.SetDisableIndex(true, "2")
			end if
		end if
	'자택, 직장주소 둘 다 입력되어있음
	else
		'이메일만 체크
		if szEmail == "" then
			ContMain.cmbTransInform.SetDisableIndex(true, "1")
			ContMain.cmbCtcn.SetDisableIndex(true, "1")
			if g_PNSNYN == "Y" then
				ContMain.cmbPension.SetDisableIndex(true, "1")
			end if
		end if
	end if
	
	
End Function

'============================================================================
Function Str_Chk(str, sGubn)
	dim i							'루프용 
	dim chk_n						'숫자 체크
	dim chk_c						'영문 체크
	dim chk_t						'특수 체크
    
	chk_n = 0 '숫자
	chk_c = 0 '영어
	chk_t = 0 '특수문자
    
	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))
		
	    '48~57 : 0~9
	    '65~90 : A~Z
	    '97~122: a~z
		If nAscii >=48 and nAscii <=57 Then 
		    chk_n = 1 	
		Elseif   (nAscii >=65 and nAscii <=90) or ( nAscii >=97 and nAscii <=122) Then
		    chk_c = 1 
		Elseif   (nAscii >=33 and nAscii <=47) or ( nAscii >=58 and nAscii <=64)  or ( nAscii >=91 and nAscii <=96)  or ( nAscii >=123 and nAscii <=126) Then
		    chk_t = 1 
		Else 
		   If nAscii <> 32 Then 'space	
			   return False
		   End If
		End if 		    
	Next
    
	If sGubn == "ENG_NAME" then
		If chk_n == 1 Then  
			return False
		End if
	End if
	
	return True
End Function 

'============================================================================
Sub ContMain_RadioSelectGbn2_OnClick(nIndex)
	If nIndex == 0 Then '자택
		ContMain.EdtRegnZip.caption  = ""
		ContMain.EdtDtlZip.caption   = ""
		ContMain.EdtAddr.caption     = ""
		ContMain.EdtAddrDtl.caption  = ""
		ContMain.CYN.caption         = ""
		ContMain.Cbldn.caption       = ""
		 
		'자택 주소        
		ContMain.EdtRegnZip.caption  = g_OwhsRegnZip 
		ContMain.EdtDtlZip.caption   = g_OwhsDtlZip 			
		ContMain.EdtAddr.caption     = g_OwhsPost 		    
		ContMain.EdtAddrDtl.caption  = g_OwhsDtad 			  
		ContMain.CYN.caption         = g_OwhsNwAddrUseYN  
		ContMain.Cbldn.caption       = g_OwhsBldnMnno
		
		'(AS-IS와 동일) 주소 선택값을 우편물 통보 값으로 셋팅
		setRadioButtonData = "0"	
		
		if g_OwhsRegnZip <> "" and g_OwhsRegnZip <> null then
			ContMain.cmbMailInform.currentindex = setRadioButtonData
		end if
		
	ElseIf nIndex == 1 Then '직장
		
		ContMain.EdtRegnZip.caption  = ""
		ContMain.EdtDtlZip.caption   = ""
		ContMain.EdtAddr.caption     = ""
		ContMain.EdtAddrDtl.caption  = ""
		ContMain.CYN.caption         = ""
		ContMain.Cbldn.caption       = ""
		
		ContMain.EdtRegnZip.caption	  =  g_CoRegnZip 		  
		ContMain.EdtDtlZip.caption   =  g_CoDtlZip 			
		ContMain.EdtAddr.caption     =  g_CoPost 			  
		ContMain.EdtAddrDtl.caption  =  g_CoDtad 			  
		ContMain.CYN.caption       	  =  g_CoNwAddrUseYN  
		ContMain.Cbldn.caption     	  =  g_CoBldnMnno 	
		
		'(AS-IS와 동일) 주소 선택값을 우편물 통보 값으로 셋팅
		setRadioButtonData = "1"
		
		if g_CoRegnZip <> "" and g_CoRegnZip <> null then
			ContMain.cmbMailInform.currentindex = setRadioButtonData
		end if
	End If
	
	ContMain.EdtAddr.SetResultLabel("0","complete","","ContMain")
	
	if nIndex == 0 then
		ContMain.EdtOwhsNum.visible = true
		ContMain.EdtWrplNum.visible = false
	else
		ContMain.EdtOwhsNum.visible = false
		ContMain.EdtWrplNum.visible = true
	end if
	
	'20230428 주석처리 해지, 처음 조회시엔 안타도록 함
	if g_FirstYn then
		'2021.04.30. 김유경 로직 추가
		ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.RadioSelectGbn2.top, "1"))	
	end if 
	
	If Trim(ContMain.EdtAddr.caption) <> "" Then
		
		Call ContMain_EdtAddrDtl_OnEditComplete()
	End If
	
	f_CheckNextEnable()
End Sub


'===========================================================================
'화면내부 모든 컨트롤 및 변수 CLEAR
'===========================================================================
Function ContClear()
	ContMain.EdtRegnZip.caption = ""
	ContMain.EdtPhone.caption   = ""
	ContMain.EdtOwhsNum.caption = ""
	ContMain.EdtWrplNum.caption = ""
	ContMain.EdtEmail.caption   = ""
End Function 
'============================================================================
Sub ContMain_EdtEmail_OnEditComplete()
'	ContMain.EdtEmail.SetResultLabel("0","complete","","ContMain")	'v0007 Email help msg 줄 수 설정설정 전 리셋(야후/핫메일 help msg 줄수로 인한)
'	ContMain.EdtEmail.SetUseResultLabel(true, 1)			'v0007 Email help msg 줄 수 설정
	
	Dim sParam, sTail, sTailTemp, sTailDetail
	sParam  = ""
	sTail   = ""
	sTailTemp = ""
	sTailDetail = ""

	sParam = ContMain.EdtEmail.caption
	If LEN(TRIM(sParam)) > 0 Then 
		sTail = split(sParam, "@")
		
		If ubound(sTail) > 0 Then 
		
			'2021.05.01. 김유경. 개선사항 추가
			If Str_Chk_Email(ContMain.EdtEmail.caption, "EMAIL") == False then		 
				ContMain.EdtEmail.SetResultLabel("1","error","이메일을 확인하세요.","ContMain")
				f_CheckNextEnable()
				Exit Sub
			End If
	
			sTailTemp = sTail[1]
			sTailDetail = split(sTailTemp, ".")
			
			If sTailDetail[0] == "yahoo" or sTailDetail[0] == "hotmail" Then
				'ShowAlert("알림", "야후코리아(yahoo.co.kr), 핫메일(hotmail.com) 계정은 사용이 불가합니다.")
'				ContMain.EdtEmail.SetUseResultLabel(true, 3)		'v0007 Email help msg 줄 수 설정
				ContMain.EdtEmail.SetResultLabel("1", "error","야후코리아(yahoo.co.kr), 핫메일(hotmail.com)\n계정은 사용이 불가합니다.","ContMain")	'v0007
				ContMain.EdtEmail.caption = ""
				
				Exit Sub
			Else 
				ContMain.EdtEmail.SetResultLabel("0","complete","","ContMain")
				
				'연금수익률통보처 디폴트 이메일 입력 시점에 세팅
'				if g_PNSNYN == "Y" then
'					If CInt(ContMain.cmbPension.currentindex) == -1 then
'						ContMain.cmbPension.currentindex = "1"
'					end if
'				end if
			End If
		
		else
			If Str_Chk_Email(ContMain.EdtEmail.caption, "EMAIL") == False then		 
				ContMain.EdtEmail.SetResultLabel("1","error","이메일을 확인하세요.","ContMain")
				f_CheckNextEnable()
				Exit Sub
			End If
		End If
	
	else
		'하단 콤보들에서 이메일 항목 선택 상태에서 이메일 지우는 경우
		 if ContMain.cmbTransInform.currentindex == "1" or ContMain.cmbCtcn.currentindex == "1" or ContMain.cmbPension.currentindex == "1" then
			 ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.EdtEmail.top, "1"))	
			 ContMain.EdtEmail.SetResultLabel("1","error","이메일 주소를 입력해 주세요.","ContMain")
		 end if
	End If
	
	'20230428 스크롤추가.. 처음 조회시엔 안타도록 함
	if g_FirstYn then
		ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.Label5.top, "1"))	
	end if 	
	
	f_SetComboOption()
	f_CheckNextEnable()
	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	'애니메이션#1 - START
	'영문명이있으면 => 주소지입력까지 노출 & 포커스 없음
	'영문명이없으면 => 영문명까지만 노출 & 영문명입력란 포커스
	If sTimerID == "1" or sTimerID == 1 then

		'타이머중지
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		
		'스크롤이동
		nCtrlTop = 0 
		nLabStndTop = 0
		
		
		if ContMain.EdtEngName.caption <> "" then
			
			'iOS 스크롤 제어용
'			if g_szOSType == "2" then
'				ContMain.vscroll = "1"
'			end if
			
			if ContMain.EdtAddr.caption <> "" then
				
				nLabStndTop = 861
				nCtrlTop = Cint(Form.calcUnResize(ContMain.Label2.top, "1")) - 20
				
				ContMain.LabStnd.top = nLabStndTop
				
				
				ContMain.scroll_pos = nCtrlTop
				ContMain.setScrollAutoSize()
				
				'우편물통보
				ContMain.Label4.visible = true
				ContMain.chkMobile.visible		 = true
				ContMain.imgTooltip1.visible	 = true	
				
				'자택/직장 라디오버튼
'				ContMain.cmbMailInform.currentindex = setRadioButtonData
			
			else
			
				nLabStndTop = 631
				nCtrlTop = Cint(Form.calcUnResize(ContMain.EdtJumin.top, "1"))
			
				ContMain.LabStnd.top = nLabStndTop
				
				ContMain.scroll_pos = nCtrlTop
				ContMain.setScrollAutoSize()
			end if
		
		else
			nLabStndTop = 500
			CtrlTop = Cint(Form.calcUnResize(ContMain.Label1.top, "1"))
			
			ContMain.LabStnd.top = nLabStndTop
			
			ContMain.scroll_pos = CtrlTop
			ContMain.setScrollAutoSize()
			
			ContMain.EdtEngName.SetShowKeypad(true)
			
		End If 
		
	
	'애니메이션#2 - START
	'영문명없는 경우, 영문명 입력완료 시
	elseif sTimerID == "2" or sTimerID == 2 then
	
		
		'iOS 스크롤 제어용
'		if g_szOSType == "2" then
'			ContMain.vscroll = "1"
'		end if
		
		'타이머중지
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		
		'스크롤이동
		nCtrlTop = 0 
		nLabStndTop = 0
		
		nLabStndTop = 680
		nCtrlTop = Cint(Form.calcUnResize(ContMain.EdtJumin.top, "1"))
		
		ContMain.LabStnd.top = nLabStndTop
		
		ContMain.scroll_pos = nCtrlTop
		ContMain.setScrollAutoSize()
		
		'2021.04.16 . 김유경 Butto0 -> RadioSelectGbn2 컨트롤 변경
		'주소 입력이 안된 초기 상태에서만
		if ContMain.RadioSelectGbn2.currentindex == "-1" then
			Call ContMain_RadioSelectGbn2_OnClick()
		end if
		
	'#애니메이션3 - START
	'우편물통보 선택 후 스크롤 이동
	elseif sTimerID == "3" or sTimerID == 3 then
		
		'타이머중지
		Form.SetTimerEvent2(sTimerID, 0, 0.4)
		
		'스크롤이동
		nCtrlTop = 0 
		nLabStndTop = 0
	
		'v0007 스크롤 사이지 변경 1296 > 1366
		'20210308 HWG START
		nLabStndTop = 1366'CInt(Form.calcUnResize(ContMain.LabStnd.top, "1")) + 110
		
		'v0007 스크롤 위치 변경
'		nCtrlTop = Cint(Form.calcUnResize(ContMain.Label4.top, "1"))	
		nCtrlTop = Cint(Form.calcUnResize(ContMain.Label5.top, "1"))

		ContMain.LabStnd.top = nLabStndTop
		ContMain.setScrollAutoSize()
		ContMain.scroll_pos = nCtrlTop 
		

	ElseIf sTimerID == "4" or sTimerID == 4 then
		
		Form.SetTimerEvent2(sTimerID, 0, 0.4)
		If TRIM(ContMain.EdtEmail.caption) = "" Then 
			ContMain.EdtEmail.SetShowKeypad(true)
		End If 
		
	ElseIf sTimerID == "5" or sTimerID == 5 then
		
		Form.SetTimerEvent2(sTimerID, 0, 0.4)

		'스크롤이동
		nCtrlTop = 0 
		nLabStndTop = 0
				
		ContMain.LabStnd.top = nLabStndTop
		ContMain.setScrollAutoSize()
		ContMain.scroll_pos = nCtrlTop 
		
	End If
	
	'20230428 기존고객은 강제scroll 안되게 하라함.
'	If sTimerID <> "1" and sTimerID <> 1 then
'		'한번 조회한 후..
'		g_FirstYn = true
'	end if
	
End Sub

