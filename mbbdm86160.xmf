Sub ContMain_cmbPension_OnEditComplete(nIndex)
	'연금수익률보고서 통보지 선택
	
	'선택한 통보지가 입력이 되어있는지 체크
	If nIndex == 1 Then		'이메일
		If TRIM(ContMain.EdtEmail.caption) == "" Then  
'			Form.OpenPopup("mbbdm85150_p3" , "1", "")
			Form.ShowAlert("알림", "등록된 이메일 정보가 없습니다. 다른 통보처를 선택해주세요.")
			ContMain.cmbPension.currentindex = "-1"
			Exit Sub
		End If
	End If
			
	If nIndex == 2 Then	'자택주소
		If TRIM(g_OwhsDtad) == "" Then
'			Form.OpenPopup("mbbdm85150_p3" , "2", "")
			Form.ShowAlert("알림", "등록된 자택 정보가 없습니다. 다른 통보처를 선택해주세요.")
			ContMain.cmbPension.currentindex = "-1"
			Exit Sub
		End If 
	End If
	
	If nIndex == 3 Then	'직장주소
		If TRIM(g_CoDtad) == "" Then
'			Form.OpenPopup("mbbdm85150_p3" , "3", "")
			Form.ShowAlert("알림", "등록된 직장 정보가 없습니다. 다른 통보처를 선택해주세요.")
			ContMain.cmbPension.currentindex = "-1"
			Exit Sub
		End If 
	End If
	
'	if ContMain.cmbMailInform.currentindex == "-1" or ContMain.cmbMailInform.currentindex == -1 then
'		BtnNext.enable = false
'		exit sub
'	end if
'	if ContMain.cmbTransInform.currentindex == "-1" or ContMain.cmbTransInform.currentindex == -1 then
'		BtnNext.enable = false
'		exit sub
'	end if
'	if ContMain.cmbCtcn.currentindex == "-1" or ContMain.cmbCtcn.currentindex == -1 then
'		BtnNext.enable = false
'		exit sub
'	end if
'	if g_PNSNYN == "Y" then
'		if ContMain.cmbPension.currentindex == "-1" or ContMain.cmbPension.currentindex == -1 then
'			BtnNext.enable = false
'			exit sub
'		end if
'	end if
'	
'	BtnNext.enable = true
	
	f_CheckNextEnable()
End Sub

'============================================================================
Function f_CheckNextEnable()
	'영문명 입력체크 
	if ContMain.EdtEngName.caption == "" or ContMain.EdtEngName.caption == null then
		BtnNext.enable = False
		If g_szTheme = "black" Then
			BtnNext.btnimage = "btn_27.9"
		Else 
			BtnNext.btnimage = "btn_21.9"
		End If
		BtnNext.fgcolor = "269"
		exit function
	end if
	
	'v0008 밑에 로직에 합침
	'이메일입력 체크
'	if ContMain.EdtEmail.caption == "" or ContMain.EdtEmail.caption == null then
'		BtnNext.enable = false
'		If g_szTheme = "black" Then
'			BtnNext.btnimage = "btn_27.9"
'		Else 
'			BtnNext.btnimage = "btn_21.9"
'		End If
'		BtnNext.fgcolor = "269"
'		exit function
'	end if
	'입력은 됐지만 유효성 검증 안된 상태일 경우도 체크
'	if Str_Chk_Email(ContMain.EdtEmail.caption, "EMAIL") == False then
'		BtnNext.enable = false
'		If g_szTheme = "black" Then
'			BtnNext.btnimage = "btn_27.9"
'		Else 
'			BtnNext.btnimage = "btn_21.9"
'		End If
'		BtnNext.fgcolor = "269"
'		exit function
'	end if
	
	'v0008 이메일체크로직 : 기존로직+사용불가계정체크 추가
	Dim sParam, sTail, sTailTemp, sTailDetail
	sParam  = ""
	sTail   = ""
	sTailTemp = ""
	sTailDetail = ""
	
	sParam = ContMain.EdtEmail.caption
	If LEN(TRIM(sParam)) > 0 Then 
	
		'입력은 됐지만 유효성 검증 안된 상태일 경우도 체크
		if Str_Chk_Email(ContMain.EdtEmail.caption, "EMAIL") == False then
			BtnNext.enable = false
			If g_szTheme = "black" Then
				BtnNext.btnimage = "btn_27.9"
			Else 
				BtnNext.btnimage = "btn_21.9"
			End If
			BtnNext.fgcolor = "269"
			exit function
		end if
		
		sTail = split(sParam, "@")
		
		If ubound(sTail) > 0 Then
			sTailTemp = sTail[1]
			sTailDetail = split(sTailTemp, ".")
			
			'사용불가계정 체크..
			If sTailDetail[0] == "yahoo" or sTailDetail[0] == "hotmail" Then
				BtnNext.enable = false
				If g_szTheme = "black" Then
					BtnNext.btnimage = "btn_27.9"
				Else 
					BtnNext.btnimage = "btn_21.9"
				End If
				BtnNext.fgcolor = "269"
				exit function			
			
			end if		
		end if
	else
		'이메일미입력
		BtnNext.enable = false
		If g_szTheme = "black" Then
			BtnNext.btnimage = "btn_27.9"
		Else 
			BtnNext.btnimage = "btn_21.9"
		End If
		BtnNext.fgcolor = "269"
		exit function		
	end if
	
	
	'주소입력 체크
	if ContMain.RadioSelectGbn2.currentindex == "-1" then
		'주소 미선택(자택/직장)
		BtnNext.enable = false
		If g_szTheme = "black" Then
			BtnNext.btnimage = "btn_27.9"
		Else 
			BtnNext.btnimage = "btn_21.9"
		End If
		BtnNext.fgcolor = "269"
		exit function
	else
		if ContMain.RadioSelectGbn2.currentindex == "0" then
			if g_OwhsRegnZip == "" or g_OwhsRegnZip == null then
				BtnNext.enable = false
				If g_szTheme = "black" Then
					BtnNext.btnimage = "btn_27.9"
				Else 
					BtnNext.btnimage = "btn_21.9"
				End If
				BtnNext.fgcolor = "269"
				exit function
			end if
		else
			if g_CoRegnZip == "" or g_CoRegnZip == null then	
				BtnNext.enable = false
				If g_szTheme = "black" Then
					BtnNext.btnimage = "btn_27.9"
				Else 
					BtnNext.btnimage = "btn_21.9"
				End If
				BtnNext.fgcolor = "269"
				exit function
			end if
		end if
	end if
	
	'우편물통보 선택여부
	if ContMain.cmbMailInform.currentindex == "-1" or ContMain.cmbMailInform.currentindex == -1 then
		BtnNext.enable = false
		If g_szTheme = "black" Then
			BtnNext.btnimage = "btn_27.9"
		Else 
			BtnNext.btnimage = "btn_21.9"
		End If
		BtnNext.fgcolor = "269"
		exit function
	end if
	'거래내역 선택여부
	if ContMain.cmbTransInform.currentindex == "-1" or ContMain.cmbTransInform.currentindex == -1 then
		BtnNext.enable = false
		If g_szTheme = "black" Then
			BtnNext.btnimage = "btn_27.9"
		Else 
			BtnNext.btnimage = "btn_21.9"
		End If
		BtnNext.fgcolor = "269"
		exit function
	end if
	'계약서류 선택여부
	if ContMain.cmbCtcn.currentindex == "-1" or ContMain.cmbCtcn.currentindex == -1 then
		BtnNext.enable = false
		If g_szTheme = "black" Then
			BtnNext.btnimage = "btn_27.9"
		Else 
			BtnNext.btnimage = "btn_21.9"
		End If
		BtnNext.fgcolor = "269"
		exit function
	end if
	'연금수익률통보 선택여부
	if g_PNSNYN == "Y" then
		if ContMain.cmbPension.currentindex == "-1" or ContMain.cmbPension.currentindex == -1 then
			BtnNext.enable = false
			If g_szTheme = "black" Then
				BtnNext.btnimage = "btn_27.9"
			Else 
				BtnNext.btnimage = "btn_21.9"
			End If
			BtnNext.fgcolor = "269"
			exit function
		end if
	end if
	
	BtnNext.btnimage = "btn_20.9"
	'BtnNext.fgcolor = "62"
	BtnNext.fgcolor = "273"
	
	BtnNext.enable = true
End Function 

'============================================================================
Function f_CheckOnlyWrap()
	'랩 계좌만 단독으로 개설하는 케이스인지 체크
	If g_WRAPYN == "Y" And (g_STOCKYN == "N" And g_CMAYN == "N" And g_FSTOCKYN == "N" And g_OPTNYN == "N" And g_OVDVYN == "N" And g_ISAYN == "N" And g_CFDYN == "N" And g_ACFDYN == "N" And g_PNSNYN == "N" And g_365YN == "N") Then
		Return True
	Else
		Return False
	End If
End Function

