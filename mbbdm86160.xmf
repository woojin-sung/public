Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "ABORT" and sRet == "ok" then	
		Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")	
		
'		Form.CloseForm()
		
		Form.OpenNextPopup("mbbdm85100", "", "")
	elseif sKeyName == "PrgsExit" then		
		Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")	
		
'		Form.CloseForm()		
		Form.OpenNextPopup("mbbdm85100", "", "")	
	end if
End Sub

'============================================================================
Sub ContMain_imgTooltip1_OnClick()
	Dim szText
	szText = "우편 발송물을 알림톡(또는 SMS)으로\n보내드려요.\n\n- 퇴직자 잔고통보\n- 수시잔고통보\n- 금융거래정보제공 사실통보\n- 금융소득원천징수 세액명세서"
	ContMain.imgTooltip1.openToolTip(szText, 280, 180, 2)
End Sub

