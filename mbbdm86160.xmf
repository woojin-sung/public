'============================================================================
Sub f_ChkPhoneNum(szType)
	Dim tmpNum
	
	'전화번호 샘플케이스 체크
	If szType == "Home" Then
		tmpNum = Replace(ContMain.EdtOwhsNum.caption,"-","")
		
		If Left(ContMain.EdtOwhsNum.caption, 3) == "000" Then
			ContMain.EdtOwhsNum.SetResultLabel("1","error","자택전화번호를 확인해주세요.","ContMain")
			Exit Sub
		End If
		
		If Len(Trim(tmpNum)) == 9 Or Len(Trim(tmpNum)) == 10 or Len(Trim(tmpNum)) == 11 Then
			If Right(Trim(tmpNum), 7) == "0000000" Or Right(Trim(tmpNum), 7) == "1111111" Or Right(Trim(tmpNum), 7) == "1234567" Then
				ContMain.EdtOwhsNum.SetResultLabel("1","error","자택전화번호를 확인해주세요.","ContMain")
				Exit Sub
			End If
		End If
		
		If Trim(tmpNum) == "022000000" Then
			ContMain.EdtOwhsNum.SetResultLabel("1","error","자택전화번호를 확인해주세요.","ContMain")
			Exit Sub
		End If
		
		ContMain.EdtOwhsNum.SetResultLabel("0","complete","","ContMain")
	Else
		tmpNum = Replace(ContMain.EdtWrplNum.caption,"-","")
		
		If Left(ContMain.EdtWrplNum.caption, 3) == "000" Then
			ContMain.EdtWrplNum.SetResultLabel("1","error","자택전화번호를 확인해주세요.","ContMain")
			Exit Sub
		End If
		
		If Len(Trim(tmpNum)) == 9 Or Len(Trim(tmpNum)) == 10 or Len(Trim(tmpNum)) == 11 Then
			If Right(Trim(tmpNum), 7) == "0000000" Or Right(Trim(tmpNum), 7) == "1111111" Or Right(Trim(tmpNum), 7) == "1234567" Then
				ContMain.EdtWrplNum.SetResultLabel("1","error","자택전화번호를 확인해주세요.","ContMain")
				Exit Sub
			End If
		End If
		
		If Trim(tmpNum) == "022000000" Then
			ContMain.EdtWrplNum.SetResultLabel("1","error","자택전화번호를 확인해주세요.","ContMain")
			Exit Sub
		End If
		
		ContMain.EdtWrplNum.SetResultLabel("0","complete","","ContMain")
	End If
End Sub

'============================================================================
Sub ContMain_EdtOwhsNum_OnEditComplete()
	sProsAbleYn = 0  'v0001 오입력플래그 초기화하고 체크시작

	ContMain.EdtOwhsNum.caption = Replace(ContMain.EdtOwhsNum.caption, "-" , "")
	
	Dim tmpOwhsNum
	
	If Trim(Mid(ContMain.EdtOwhsNum.caption, 1, 2)) == "01" Then
		ContMain.EdtOwhsNum.SetResultLabel("1","error","자택전화번호의 국번을 확인해주세요.","ContMain")
		sProsAbleYn = 1
		Exit Sub
	End If 
			
	tmpOwhsNum = replace(ContMain.EdtOwhsNum.caption,"-","")
	
	If Len(Trim(tmpOwhsNum)) > 0  and Len(Trim(tmpOwhsNum)) < 9 Then
		ContMain.EdtOwhsNum.SetResultLabel("1","error","자택전화번호를 확인해주세요.","ContMain")
		sProsAbleYn = 1
		Exit Sub	
	End If
			
	If Trim(Mid(ContMain.EdtOwhsNum.caption, 1, 2)) == "02" Then
		If Len(Trim(tmpOwhsNum)) > 10 Then
			ContMain.EdtOwhsNum.SetResultLabel("1","error","자택전화번호를 확인해주세요.","ContMain")
			sProsAbleYn = 1
			Exit Sub
		End If 
		
		'02-1111-1111
		If LEN(Trim(ContMain.EdtOwhsNum.caption)) == 10 Then
			Dim sMaskNum
			sMaskNum = Left(ContMain.EdtOwhsNum.caption, 2).."-"..MID(ContMain.EdtOwhsNum.caption,3,4).."-"..Right(ContMain.EdtOwhsNum.caption, 4)
			ContMain.EdtOwhsNum.caption = sMaskNum
		'02-111-1111
		ElseIf LEN(Trim(ContMain.EdtOwhsNum.caption)) == 9 Then
			Dim sMaskNum
			sMaskNum = Left(ContMain.EdtOwhsNum.caption, 2).."-"..MID(ContMain.EdtOwhsNum.caption,3,3).."-"..Right(ContMain.EdtOwhsNum.caption, 4)
			ContMain.EdtOwhsNum.caption = sMaskNum
		'Else
			'ContMain.EdtOwhsNum.caption 기존 입력 값 
		End If 
	Else  '02가 아닌 3자리 국번
		If Len(Trim(tmpOwhsNum)) > 11 Then
			ContMain.EdtOwhsNum.SetResultLabel("1","error","자택전화번호를 확인해주세요.","ContMain")
			sProsAbleYn = 1
			Exit Sub
		End If 

		'031-1111-1111
		If LEN(Trim(ContMain.EdtOwhsNum.caption)) == 11 Then
			Dim sMaskNum
			sMaskNum = Left(ContMain.EdtOwhsNum.caption, 3).."-"..MID(ContMain.EdtOwhsNum.caption,4,4).."-"..Right(ContMain.EdtOwhsNum.caption, 4)
			ContMain.EdtOwhsNum.caption = sMaskNum
		''031-111-1111
		ElseIf LEN(Trim(ContMain.EdtOwhsNum.caption)) == 10 Then
			Dim sMaskNum
			sMaskNum = Left(ContMain.EdtOwhsNum.caption, 3).."-"..MID(ContMain.EdtOwhsNum.caption,4,3).."-"..Right(ContMain.EdtOwhsNum.caption, 4)
			ContMain.EdtOwhsNum.caption = sMaskNum
		'Else
			'ContMain.EdtOwhsNum.caption 기존 입력 값 
		End If
	End If 
	
	'전화번호 샘플케이스 체크 추가
	If Left(ContMain.EdtOwhsNum.caption, 3) == "000" Then
		ContMain.EdtOwhsNum.SetResultLabel("1","error","자택전화번호를 확인해주세요.","ContMain")
		sProsAbleYn = 1
		Exit Sub
	End If
	
	If Len(Trim(tmpOwhsNum)) == 9 Or Len(Trim(tmpOwhsNum)) == 10 or Len(Trim(tmpOwhsNum)) == 11 Then
		If Right(Trim(tmpOwhsNum), 7) == "0000000" Or Right(Trim(tmpOwhsNum), 7) == "1111111" Or Right(Trim(tmpOwhsNum), 7) == "1234567" Then
			ContMain.EdtOwhsNum.SetResultLabel("1","error","자택전화번호를 확인해주세요.","ContMain")
			sProsAbleYn = 1
			Exit Sub
		End If
	End If
	
	If Trim(tmpOwhsNum) == "022000000" Then
		ContMain.EdtOwhsNum.SetResultLabel("1","error","자택전화번호를 확인해주세요.","ContMain")
		sProsAbleYn = 1
		Exit Sub
	End If
	
	ContMain.EdtOwhsNum.SetResultLabel("0","complete","","ContMain")
	sProsAbleYn = 0
End Sub

