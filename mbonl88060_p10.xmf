	<FORM_INFO name="Form" ly_vert="0,0,375,607,1" />
	<CONTROL_INFO>
		<WEBVIEW name="web01" urlpath="about:blank" ly_vert="0,0,375,564,1" />
		<BUTTON name="BtnOK" caption="확인" fgcolor="128:188030030" btnimage="btn_pop2.9.png" ly_vert="187,561,188,45,1" />
		<BUTTON name="BtnCancel" caption="취소" fgcolor="004:000000000" btnimage="btn_pop1.9.png" ly_vert="0,561,187,45,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="2172" _ulen="2148" >
'============================================================================
' 화면명 	: 단기사채 약관
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szRet	'리턴값
g_szRet	=	"0"

'Dim g_URLheader
'Dim g_ServerMode
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()

	If szOpenData <> "" And szOpenData <> null Then
		web01.viewtype = 0
		web01.urlpath = szOpenData
	
		szScreenName = Form.GetSharedData("OPEN_SCREE_NAME")
	
		Form.SetScreenName(szScreenName)
	end if
End Sub

'============================================================================
'BtnOK_OnClick
'============================================================================
Sub BtnOK_OnClick()
	g_szRet	=	"1"
	Form.CloseForm()
End Sub


'============================================================================
'BtnCancel_OnClick
'============================================================================
Sub BtnCancel_OnClick()
	g_szRet	=	"0"
	Form.CloseForm()
End Sub


'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("ACCOUNTPOLICY" , g_szRet)
End Sub


	</SCRIPT_INFO>
</ROOT>