			Cont0.Label20.caption = "6등급"
			
	End Select

	'컨테이너 스크롤 크기변경
	Cont0.SetScrollAutoSize()
	
End Function

'============================================================================
Sub Cont0_Tab1_OnTabChanged(nCurrentTab)
	Call SetSubScreen(CInt(nCurrentTab))
End Sub

'============================================================================
Function SetSubScreen(nIndex)
	Select Case nIndex
		Case 0
			Cont0.Label11.caption = "회사채(BBB-)"
									.. "\n외화표시채권(BBB+ ~ BBB0)"
			Cont0.Label12.caption = "A3-"
			Cont0.Label13.caption = "원금비보장형 ELS(고난도_지수형)"
									.. "\n원금비보장형DLS(고난도)"
									.. "\n외화표시 ELS/DLS(원금 80%이상 부분지급형)"
			Cont0.Label14.caption = "-"
			Cont0.Label15.caption = "-"
			Cont0.Label16.caption = "국내주식,\nETF(파생상품ETF제외)"
			Cont0.Label17.caption = "-"
			Cont0.Label18.caption = "-"
			Cont0.Label19.caption = "-"
			Cont0.Label20.caption = "2등급"
		Case 1
			Cont0.Label11.caption = "회사채(BBB+ ~ BBB0)"
									.. "\n외화표시채권(A+ ~ A-)"
			Cont0.Label12.caption = "A3+ ~ A30"
			Cont0.Label13.caption = "ELS/DLS(원금 80% 이상 부분지급형)"
			Cont0.Label14.caption = "-"
			Cont0.Label15.caption = "-"
			Cont0.Label16.caption = "-"
			Cont0.Label17.caption = "-"
			Cont0.Label18.caption = "-"
			Cont0.Label19.caption = "-"
			Cont0.Label20.caption = "3등급"
	End Select
	
End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obcsb_acif_709a"	then
		Cont0.Label2.caption = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "INVT_INCL_OVRV_EXPL", 0 )
	end if
End Sub

