	<SCRIPT_INFO _len="11504" _ulen="10340" >
Dim g_szOsType

'============================================================================
Sub Form_OnFormInitBefore()
	ImgClose.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Tab0.setTabHeaderImageWithIndex(0,"tab_07_o.9","tab_03_n.9")
	Tab0.setTabHeaderImageWithIndex(1,"tab_08_o.9","tab_03_n.9")
	Tab0.setTabHeaderImageWithIndex(2,"tab_09_o.9","tab_03_n.9")
	Tab0.setTabHeaderImageWithIndex(3,"tab_10_o.9","tab_03_n.9")
	Tab0.setTabHeaderImageWithIndex(4,"tab_11_o.9","tab_03_n.9")
	
	g_szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iO
	
	Cont0.Label4.visible = false
	
	Cont0.Table0.SetCellString( 0, 1, "" )
	Cont0.Table0.SetCellString( 1, 1, "" )
	Cont0.Table0.SetCellString( 2, 1, "" )
	Cont0.Table0.SetCellString( 3, 1, "" )
	Cont0.Table0.SetCellString( 4, 1, "" )
	Cont0.Table0.SetCellString( 5, 1, "" )
	Cont0.Table0.SetCellString( 6, 1, "" )
	Cont0.Table0.SetCellString( 7, 1, "" )
	Cont0.Table0.SetCellString( 8, 1, "" )
	Cont0.Table0.SetCellString( 9, 1, "" )

	if g_szOsType = "!" then
		nCnt = 25
	else
		nCnt = 26
	end if
	
	'Cont0.Label7.changeTextAttr(0, 6, 4, -2, false)
	'Cont0.Label7.changeTextAttr(7, 25, 4, -6, false)
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData( )	

	If szOpenData <> "" And szOpenData <> null Then
		g_szInvType = szOpenData
		
		if g_szInvType = "01" then	'고수익지향형
			Tab0.currenttab = 0
			Tab0_OnTabChanged("0")
		elseif g_szInvType = "02" then	'성장지향형
			Tab0.currenttab = 1
			Tab0_OnTabChanged("1")
		elseif g_szInvType = "03" then	'중립형
			Tab0.currenttab = 2
			Tab0_OnTabChanged("2")
		elseif g_szInvType = "04" then	'안정지향형
			Tab0.currenttab = 3
			Tab0_OnTabChanged("3")
		elseif g_szInvType = "05" then	'이자소득형
			Tab0.currenttab = 4
			Tab0_OnTabChanged("4")
		else
			Tab0.currenttab = 4
			Tab0_OnTabChanged("4")
		end if
	else
		Tab0.currenttab = 4
		Tab0_OnTabChanged("4")
	end if
		
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		Cont0.setScrollBarVisible("2")
	end if
	
End Sub

'============================================================================
Sub ImgClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub Tab0_OnTabChanged(nCurrentTab)

	'nTabIndex = nCurrentTab
	
	Call SetScreen(CInt(nCurrentTab))
	
	if CInt(nCurrentTab) = 0 then
		kycInvtInclGradCode = "01"
	elseif CInt(nCurrentTab) = 1 then
		kycInvtInclGradCode = "02"
	elseif CInt(nCurrentTab) = 2 then
		kycInvtInclGradCode = "03"
	elseif CInt(nCurrentTab) = 3 then
		kycInvtInclGradCode = "04"
	elseif CInt(nCurrentTab) = 4 then
		kycInvtInclGradCode = "05"
	else
		kycInvtInclGradCode = "01"
	end if
	
	'투자성향설명 조회
	DATAMANAGER.SetDataValue(0, "obcsb_acif_709a", "InBlock1", "PROS_CLS_CODE", 0, "S")
	DATAMANAGER.SetDataValue(0, "obcsb_acif_709a", "InBlock1", "KYC_INVT_RCMD_CLS_CODE", 0, "1")
	DATAMANAGER.SetDataValue(0, "obcsb_acif_709a", "InBlock1", "KYC_INVT_INCL_GRAD_CODE", 0, kycInvtInclGradCode)
	DATAMANAGER.SetDataValue(0, "obcsb_acif_709a", "InBlock1", "ENTR_YN", 0, "N")
	DATAMANAGER.RequestTranData("obcsb_acif_709a")
End Sub

'============================================================================
Function SetScreen(nIndex)
	
	Cont0.Image0.height = 160
	Cont0.Label1.top = 245
	Cont0.Label3.top = 287
	Cont0.Label4.top = 285
	Cont0.Label5.top = 285
	Cont0.Label8.top = 320
	Cont0.Label9.top = 840
	
	Cont0.Tab1.visible = false
	Cont0.Label4.visible = false
	
	Cont0.Table0.top = 330
	Cont0.Label11.top = 335	'채권
	Cont0.Label12.top = 385	'CD/단기사채
	Cont0.Label13.top = 435	'ELS/DLS
	Cont0.Label14.top = 495	'ELB/DLB
	Cont0.Label15.top = 545	'ELW/ETN
	Cont0.Label16.top = 595	'주식
	Cont0.Label17.top = 655	'RP
	Cont0.Label18.top = 705	'CMA
	Cont0.Label19.top = 755	'파생상품
	Cont0.Label20.top = 805	'집합투자증권
	
	Cont0.Label6.top = 860
	
	Select Case nIndex
		Case 0
			' 상단
			Cont0.Label0.caption = "고수익지향형"
			Cont0.Label0.fgcolor = 378
			
			'적합한투자상품 뱃지_1
'			Cont0.Label4.visible = false

			'적합한투자상품 뱃지_2
			Cont0.Label5.left = 235
			Cont0.Label5.width = 120	'245*110
			Cont0.Label5.caption = "1등급 매우높은 위험"
			Cont0.Label5.bgcolor = 378
			Cont0.Label5.fgcolor = "16"
			
			'적합한 투자상품
			Cont0.Label11.caption = "회사채(BB+이하)/무등급채권/"
									.. "\n외화표시채권(BBB-이하)"
			Cont0.Label12.caption = "A3- 미만"
			Cont0.Label13.caption = "원금비보장형 ELS(고난도_종목형)"
									.. "\n원금비보장형 DLS(레버리지)"
									.. "\n외화표시 ELS/DLS(고난도)"
			Cont0.Label14.caption = "-"
			Cont0.Label15.caption = "ELW/ETN"
			Cont0.Label16.caption = "신용거래,투자주의·경고·위험,관리종목,"
									.. "K-OTC,\nK-OTC-BB,KONEX,비상장주식,"
									.. "해외주식,\n해외ETP,파생상품 ETF, 신기술사업투자조합"
			Cont0.Label17.caption = "-"
			Cont0.Label18.caption = "-"
			Cont0.Label19.caption = "선물옵션, 장외파생상품"
			Cont0.Label20.caption = "1등급"
			
		Case 1
			Cont0.Label0.caption = "성장지향형"
			'Cont0.Label0.fgcolor = 379
			Cont0.Label0.fgcolor = 384
			
			'적합한투자상품 뱃지_1
			Cont0.Label4.visible = true			
			Cont0.Label4.left = 135
			Cont0.Label4.width = 95	'130*110
			Cont0.Label4.caption = "2등급 높은 위험"		
			Cont0.Label4.bgcolor = 379
			Cont0.Label4.fgcolor = "4"
						
			'적합한투자상품 뱃지_2
			Cont0.Label5.left = 235
			Cont0.Label5.width = 120	'245*110
			Cont0.Label5.caption = "3등급 다소높은 위험"
			Cont0.Label5.bgcolor = 380
			Cont0.Label5.fgcolor = "4"
			
			
			'적합한 투자상품 테이블
			Cont0.Label8.top = 350
			Cont0.Tab1.visible = true
			Cont0.Table0.top = 360
	
			Cont0.Label11.top = 365	'채권
			Cont0.Label12.top = 415	'CD/단기사채
			Cont0.Label13.top = 465	'ELS/DLS
			Cont0.Label14.top = 525	'ELB/DLB
			Cont0.Label15.top = 575	'ELW/ETN
			Cont0.Label16.top = 625	'주식
			Cont0.Label17.top = 685	'RP
			Cont0.Label18.top = 735	'CMA
			Cont0.Label19.top = 785	'파생상품
			Cont0.Label20.top = 835	'집합투자증권
			
			Call Cont0_Tab1_OnTabChanged(0)
			
			Cont0.Label6.top = 890
		Case 2
			Cont0.Image0.height = 175
			Cont0.Label2.height = 155
			Cont0.Label1.top = 260
			Cont0.Label3.top = 302
			Cont0.Label4.top = 300
			Cont0.Label5.top = 300
			Cont0.Label8.top = 335
			
			'접합한 투자상품 테이블
			Cont0.Table0.top = 345
			Cont0.Label11.top = 350
			Cont0.Label12.top = 400
			Cont0.Label13.top = 450
			Cont0.Label14.top = 510
			Cont0.Label15.top = 560
			Cont0.Label16.top = 610
			Cont0.Label17.top = 670
			Cont0.Label18.top = 720
			Cont0.Label19.top = 770
			Cont0.Label20.top = 820
			
			Cont0.Label0.caption = "중립형"
			'Cont0.Label0.fgcolor = 381
			Cont0.Label0.fgcolor = 385
			
			'적합한투자상품 뱃지_1
'			Cont0.Label4.visible = false

			'적합한투자상품 뱃지_2
			Cont0.Label5.left = 260
			Cont0.Label5.width = 95	'245*110
			Cont0.Label5.caption = "4등급 보통 위험"
			Cont0.Label5.bgcolor = 381
			Cont0.Label5.fgcolor = "4"
			
			'적합한 투자상품
			Cont0.Label11.caption = "회사채(A+ ~ A-)\n외화표시채권(AA+ ~ AA-)"
			Cont0.Label12.caption = "A2+ ~ A2-"
									.. "\n(단, A1유동화증권 해당)"
			Cont0.Label13.caption = "ELS/DLS(원금 90% 이상 부분지급형)"
									.. "\n외화표시 ELS/DLS(원금 95% 이상 부분지급형)"
			Cont0.Label14.caption = "외화표시 원금지급형"
			Cont0.Label15.caption = "-"
			Cont0.Label16.caption = "-"
			Cont0.Label17.caption = "-"
			Cont0.Label18.caption = "-"
			Cont0.Label19.caption = "-"
			Cont0.Label20.caption = "4등급"
			
			Cont0.Label6.top = 875
		Case 3
			Cont0.Label0.caption = "안정지향형"
			'Cont0.Label0.fgcolor = 382
			Cont0.Label0.fgcolor = 386
			
			'적합한투자상품 뱃지_1
'			Cont0.Label4.visible = false

			'적합한투자상품 뱃지_2
			Cont0.Label5.left = 260
			Cont0.Label5.width = 95	'245*110
			Cont0.Label5.caption = "5등급 낮은 위험"
			Cont0.Label5.bgcolor = 382
			Cont0.Label5.fgcolor = "4"
			
			'적합한 투자상품
			Cont0.Label11.caption = "회사채(AA+ ~ AA-)"
									.. "\n외화표시채권(AAA)"
			Cont0.Label12.caption = "A1"
									.. "\n(단, A1유동화증권 제외)"
			Cont0.Label13.caption = "ELS/DLS(원금 95% 이상 부분지급형)"
			Cont0.Label14.caption = "원금지급형"
			Cont0.Label15.caption = "-"
			Cont0.Label16.caption = "-"
			Cont0.Label17.caption = "외화RP"
			Cont0.Label18.caption = "-"
			Cont0.Label19.caption = "-"
			Cont0.Label20.caption = "5등급"
			
		Case 4
			Cont0.Label0.caption = "이자소득형"
			Cont0.Label0.fgcolor = 383
			
			'적합한투자상품 뱃지_1
'			Cont0.Label4.visible = false

			'적합한투자상품 뱃지_2
			Cont0.Label5.left = 235
			Cont0.Label5.width = 120	'245*110
			Cont0.Label5.caption = "6등급 매우낮은 위험"
			Cont0.Label5.bgcolor = 383
