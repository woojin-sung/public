'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 
' 02. 화면설명 : 
' 03. 이    력 : 2023.11.10 : 고승연 : v0003 : 상품위험등급 구분 변경, obwat_pdad_065r IO 수정
'                2024.03.26 : 고승연 : v0004 : [T2402290007] obwat_pdad_065r IO 수정
'-------------------------------------------------------------------------------------------

Dim g_sAcno, g_sAsno

'============================================================================
Sub btnOk_OnClick()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
	Form.OpenScreen("57020", "")
End Sub

'============================================================================
Sub btnSearch_OnClick()
	Form.SetSharedData("mbwat61022_ACNO", g_sAcno)
	Form.SetSharedData("mbwat61022_ASNO", g_sAsno)
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
	Form.OpenScreen("57030" , "")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "Text" then
		if sParam <> "" then
			Dim tData, sCsno
			sCsno = Form.GetSharedData("&CUST_NUM", false)
			tData = Split(sParam, "|")
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1" )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "NMET_APLT_DATE" , 0 , tData(0) )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "NMET_APLT_SRNO" , 0 , tData(1) )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "CSNO" , 0 , sCsno )
			DATAMANAGER.RequestTranData( "obwat_onln_001r" )
			
			lblText1.caption = tData(2).."에\n연락드릴께요."
		end if
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgStep.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
	Form.OpenScreen("57020", "")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_onln_001r" then
		Dim sDate, sSrno, sCode, sData1, sData2, sData3
		
		sDate = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "NMET_APLT_DATE" , 0 )
		sSrno = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "NMET_APLT_SRNO" , 0 )
		g_sAcno = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "ACNO" , 0 )
		g_sAsno = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "ASNO" , 0 )
		sCode = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "ISCD" , 0 )
		sData1 = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "SVC_DTL_CNTT1" , 0 )
		sData2 = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "SVC_DTL_CNTT2" , 0 )
		sData3 = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "SVC_DTL_CNTT3" , 0 )
		
		Dim tsData2, sText1, sText2, sText3, sText4
		tsData2 = Split(sData2, "|")
		
		If Trim(tsData2(3)) = "Y" Or Trim(tsData2(4)) = "Y" Or Trim(tsData2(11)) = "Y" Then
			sText1 = "예약하신 화상상담 종료 후 최종계약이 완료되며,"
			sText2 = "계약 완료 시점에 선택하신 운용대상 자산에 따른"
			sText3 = "서비스 약정이 자동 신청됩니다."
			
			sText4 = "( "
			
			If Trim(tsData2(4)) = "Y" Then
				sText4 = sText4 & "K-OTC거래신청"
			End If
			
			If Trim(tsData2(11)) = "Y" Then
				If Len(Trim(sText4)) > 1 Then
					sText4 = sText4 & " / "
				End If
				sText4 = sText4 & "파생ETF거래신청"
			End If
			
			If Trim(tsData2(3)) = "Y" Then
				If Len(Trim(sText4)) > 1 Then
					sText4 = sText4 & " / "
				End If
				sText4 = sText4 & "ETN거래신청"
			End If
			
			sText4 = sText4 & " )"
			
		Else
			sText1 = ""
			sText2 = ""
			sText3 = ""
			sText4 = ""
		End If
		
		grdData.SetCellData("bdText1", 0, sText1)
		grdData.SetCellData("bdText2", 0, sText2)
		grdData.SetCellData("bdText3", 0, sText3)
		grdData.SetCellData("bdText4", 0, sText4)
		
		'Form.ShowAlert("ETN=" & tsData2(3) & "K-OTC" & tsData2(4) & "ETF" & tsData2(11))
	End If
End Sub


