	<SCRIPT_INFO _len="2392" _ulen="2216" >
'============================================================================
' 01. 화 면 명 : 선옵 당일/익일 증거금 익일증거금
' 02. 화면설명 : 선옵 당일/익일 증거금 익일증거금 팝업
' 03. 작    성 : 2016.01.12 ~ 최지희
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAccountNumber			'계좌번호
Dim g_nAccountSerialNumber		'계좌일련번호
Dim g_nKospiNmix				'KOSPI_NMIX(현재가/입력가에 따른 가격) 
Dim g_szAccountPassword		'계좌비밀번호

Dim g_szData					'계좌번호★일련번호


'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()

	Dim szList
	
	g_szData = Form.GetOpenLinkData()
	szList = Split(g_szData, "★")	
	
	if UBOUND(szList) < 1 then
		exit sub
	end if

	g_nAccountNumber = szList(0)
	g_nAccountSerialNumber	= szList(1)
	g_nKospiNmix = szList(2)
	if szList(3) <> "" then
		g_szAccountPassword = szList(3)
	else
		g_szAccountPassword = ""
	end if
	
	DATAMANAGER.SetDataValue(0, "obtrf_cntg_324r", "InBlock1", "ACNO" , 0 , g_nAccountNumber)
	DATAMANAGER.SetDataValue(0,  "obtrf_cntg_324r", "InBlock1", "ASNO", 0 , g_nAccountSerialNumber)
	DATAMANAGER.SetDataValue(0,  "obtrf_cntg_324r", "InBlock1", "KOSPI_NMIX", 0 , g_nKospiNmix)
	if g_szAccountPassword <> "" then
		DATAMANAGER.SetDataValue(0,  "obtrf_cntg_324r", "InBlock1", "ACNT_PWD", 0 , g_szAccountPassword)
	else
		DATAMANAGER.SetDataValue(0,  "obtrf_cntg_324r", "InBlock1", "ACNT_PWD", 0 , "")
	end if
	
	DATAMANAGER.RequestTranData("obtrf_cntg_324r")
	
	Form.SetScreenName("익일 예상증거금 상세")
End Sub



	</SCRIPT_INFO>
