	<SCRIPT_INFO _len="4283" _ulen="3809" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 해외파생 개인정보동의 상세
' 02. 화면설명 : 해외파생 개인정보동의 상세
' 03. 작    성 : 2021.05.27 이현우
'-------------------------------------------------------------------------------------------
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim AgreeYN
AgreeYN = "N"

Dim g_AllYn		'개인정보동의 전체동의여부
g_AllYn = "N"

Dim g_CloseCnt
g_CloseCnt = 0
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim sURL
	
	BtnConfirm.enable = False
	
	'메모리 받아오기
	Account1.caption    = Form.GetSharedData("MHETC90021POP_ACNO"       , TRUE)  '계좌번호(TOTAL)
	LblEmpYn.caption    = Form.GetSharedData("MHETC90021POP_EMPL_YN"    , TRUE)  '직원여부
	LblEmpNo.caption    = Form.GetSharedData("MHETC90021POP_EMPNO"      , TRUE)  '직원번호
	LblAgrmClcd.caption = Form.GetSharedData("MHETC90021POP_AGRM_CLCD"  , TRUE)  '동의구분 (05:해주, 07:해파)
	
	'직원여부가 없으면 고객으로 처리
	If len(LblEmpYn.caption) = 0 Then
	    LblEmpYn.caption = "N"
	End If
	
	'동의구분이 없으면 07:해파로 처리
	If len(LblAgrmClcd.caption) = 0 Then
	    LblAgrmClcd.caption = "07"
	End If
End Sub
'============================================================================
' 폼 종료
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mhtrd44500_onepop" , "Y")
	if g_AllYn = "N" Then
		Form.ShowAlert("알림", "미동의 선택 시, 해외파생 시세신청이 불가합니다.")
	end if
	
	
End Sub
'============================================================================
' 개인신용정보 체크
'============================================================================
Sub ChkButton0_OnChange(sCheckState)
	if sCheckState = "1" Then
	    AgreeYN = "Y"
	    BtnConfirm.enable = True
	else
	    sCheckState = "N"
	    BtnConfirm.enable = False
	End If	
End Sub
'============================================================================
' 확인버튼
'============================================================================
Sub BtnConfirm_OnClick()
	if AgreeYN = "N" Then
	    Form.ShowAlert("알림", "개인(신용)정보 처리 동의에 체크해주세요")
	else
		Dim sURL 
		sURL = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm6.pdf"
	    Form.SetSharedData ("ACNO"    , Account1.caption ) 'TOTAL계좌번호
	    Form.SetSharedData ("EMPLYN"  , LblEmpYn.caption) '직원여부
	    Form.SetSharedData ("OPEN_URL", sURL )	'PDF링크
	    Form.OpenFramePopup("mhtrd44500_pop" , "해외파생 개인정보처리 요약동의서" , "")
	end if
End Sub
'============================================================================
' 취소버튼
'============================================================================
Sub BtnCancel_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
' 팝업리턴
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'전체동의 키
	if sKeyName = "ALL_YN" then
		if sRet <> "" then
			g_AllYn = sRet
			'전체동의가 Y이면, 개인신용정보동의 체크처리
			if g_AllYn = "Y" Then
				Form.CloseForm()
			else
				Form.ShowAlert("알림", "미동의 선택 시, 해외파생 시세신청이 불가합니다.")
				exit Sub
			end if
		end if
	end if
End Sub

	</SCRIPT_INFO>
