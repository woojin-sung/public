'============================================================================
Sub btnClose_OnClick()
	
	Form.SetSharedData("15020_CldFrom"	, cldFrom.caption	)
	Form.SetSharedData("15020_CldTo" 	, cldTo.caption	)
	Form.SetSharedData("15020_ACCNO" 	, acnt0.caption	)	
	Form.SetSharedData("15020_ItemCode" 	, ItemCode0.caption	)
	Form.SetSharedData("15020_chkGrid" 	, chkGrid.checkstate	)	
	
	Form.CloseForm()
	Form.SendReturnToParent("mbtrs15020" , "")
	
End Sub


'============================================================================
Sub btnSearch_OnClick()
	RequestData()	
End Sub

