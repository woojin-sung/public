Sub Form_OnFormInitBefore()
	
'	g_szForm 	= Form.GetSharedData( "15020_CldFrom"	, true  )
'	g_szTo		= Form.GetSharedData( "15020_CldTo"		, true  )	
''	g_szItemCode	= Form.GetSharedData( "15020_ItemCode"	, true  )

End Sub

'============================================================================
Sub Form_OnFormInit()

	g_szForm 	= Form.GetSharedData( "15020_CldFrom"	, true  )
	g_szTo		= Form.GetSharedData( "15020_CldTo"		, true  )
	g_szchkGrid   = Form.GetSharedData( "15020_chkGrid"	, true  )
'	g_szItemCode	= Form.GetSharedData( "15020_ItemCode"	, true  )

	cldFrom.caption  	  = g_szForm
	cldTo.caption		  = g_szTo
	chkGrid.checkstate  = g_szchkGrid
	ItemCode0.caption = Form.GetSharedData("&ITEM_STOCK", false )
	
'	ItemCode0.caption	  = g_szItemCode
	
	RequestData()
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
Dim szACNO, szASNO
	
	szACNO = acnt0.total
	szASNO = acnt0.sequence

	szMarketGubun = Form.GetItemCodeInfo(ItemCode0.code, "market")
	
	if szMarketGubun = "W" then
		szMarketGubun = "Q"
	elseif szMarketGubun = "Q" then
		szMarketGubun = ""
	elseif szMarketGubun = "J" then
		if Left(ItemCode0.code, 1) = "J" then
			szMarketGubun = ""
		else
			szMarketGubun = "A"
		end if
	elseif szMarketGubun = "K" then
		szMarketGubun = "A"
	end if
	
	'szISCD = szMarketGubun + ItemCode0.caption
	g_szISCD = szMarketGubun + ItemCode0.code
	

'	if szTranID = "obtrs_cntg_534r" then
'		DATAMANAGER.SetDataValue( false, "obtrs_cntg_534r", "InBlock1", "IQRY_CLS_CODE"	, 0, "2"    		)	'조회구분코드
'		DATAMANAGER.SetDataValue( false, "obtrs_cntg_534r", "InBlock1", "ACNO"			, 0, szACNO 		)	'계좌번호
'		DATAMANAGER.SetDataValue( false, "obtrs_cntg_534r", "InBlock1", "ASNO"			, 0, szASNO 		)	'계좌일련번호
'		DATAMANAGER.SetDataValue( false, "obtrs_cntg_534r", "InBlock1", "ETC_EXPN_INCU_YN", 0, "N" 			)	'기타비용포함여부	
''		DATAMANAGER.SetDataValue( false, "obtrs_cntg_534r", "InBlock1", "ISCD"			, 0,  g_ItemCode	)	'종목코드
'		
'	elseif szTranID = "obtrs_cntg_530r" then
'		DATAMANAGER.SetDataValue( false, "obtrs_cntg_530r", "InBlock1", "ACNO"			, 0, szACNO 		)	'계좌번호
'		DATAMANAGER.SetDataValue( false, "obtrs_cntg_530r", "InBlock1", "ASNO"			, 0, szASNO 		)	'계좌일련번호
''		DATAMANAGER.SetDataValue( false, "obtrs_cntg_530r", "InBlock1", "ISCD"			, 0,  g_ItemCode	)	'종목코드
'		
'	end if
	
	if szTranID = "obtrs_cntg_537r" then
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_537r", "InBlock1", "ACNO"	, 0,     szACNO		)
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_537r", "InBlock1", "ASNO"	, 0,     szASNO		)
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_537r", "InBlock1", "ISCD"	, 0,     g_szISCD		)
		if chkGrid.checkstate = "1" then
			DATAMANAGER.SetDataValue( false, "obtrs_cntg_537r", "InBlock1", "CRDT_EXPN_INCU_YN"	, 0,     "Y"		)
		else
			DATAMANAGER.SetDataValue( false, "obtrs_cntg_537r", "InBlock1", "CRDT_EXPN_INCU_YN"	, 0,     "N"		)
		end if

	elseif szTranID = "obtrs_cntg_538r" then
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_538r", "InBlock1", "ACNO"	, 0,     szACNO		)
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_538r", "InBlock1", "ASNO"	, 0,     szASNO		)
		DATAMANAGER.SetDataValue( false, "obtrs_cntg_538r", "InBlock1", "ISCD"	, 0,     g_szISCD		)
		if chkGrid.checkstate = "1" then
			DATAMANAGER.SetDataValue( false, "obtrs_cntg_538r", "InBlock1", "CRDT_EXPN_INCU_YN"	, 0,     "Y"		)
		else
			DATAMANAGER.SetDataValue( false, "obtrs_cntg_538r", "InBlock1", "CRDT_EXPN_INCU_YN"	, 0,     "N"		)
		end if
	end if

End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "RECEIVE" then
		DATAMANAGER.RequestTranData( "obtrs_cntg_534r" )
		DATAMANAGER.RequestTranData( "obtrs_cntg_530r" )
	
	ElseIf sEventName = "CHANGE_ORIENTATION" Then
		Form.SetSharedData("15020_CldFrom"	, cldFrom.caption	)
		Form.SetSharedData("15020_CldTo" 	, cldTo.caption	)
		Form.SetSharedData("15020_chkGrid" 	, chkGrid.checkstate	)
		
		Form.OpenPopup( "mbtrs15020_h1" , "" , "" )
	
	end if
End Sub


'============================================================================


'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName = "SEARCH" then
		g_ItemCode = sReturn1
		
	end	if
End Sub

