		<LABEL name="Label0" fgcolor="065:000000000" fontsize="-2" caption="빠른이체명 입력" ly_vert="25,70,105,39,1" />
		<EDIT name="Edit0" fonttype="3" imetype="0" ly_vert="142,70,142,39,1" />
		<LABEL name="Label1" caption="해당 계좌의 빠른이체 등록을 위하여  빠른이체명을 지정하시기 바랍니다." multiline="1" ly_vert="25,140,259,39,1" />
		<BUTTON name="Button0" caption="취소" fgcolor="095:000000000" fontstyle="01" btnimage="btn_02.9" ly_vert="25,194,127,39,1" />
		<BUTTON name="Button1" caption="등록" fontstyle="01" btnimage="btn_01.9" ly_vert="157,194,127,39,1" />
		<IMAGE name="imgTitle" autosize="1" imgpath="pop_header.9" ly_vert="0,0,309,55,1" />
		<LABEL name="Label10" fontsize="2" fontstyle="01" caption="빠른이체명 등록" bgcolor="064:197070070" halign="1" ly_vert="0,0,309,55,1" />
