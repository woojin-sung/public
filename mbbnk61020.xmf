'============================================================================
' 수정 : 2020.09.21. 장원혁 v001 메모리 평문 제거
'============================================================================
Dim g_szAccountNumber	'계좌번호(8자리)
Dim g_szAccountSerialNumber	'계좌일련번호(2자리)
Dim g_szAccountPassword	'계좌비밀번호
Dim g_szAccountName		'계좌이름
Dim g_szPrcd
Dim g_szPrnm
Dim g_szMangBrcd
Dim g_szMangBrcdName
Dim g_nDrngAbleAmt
Dim g_szBankCode
Dim g_szBankName
Dim g_szBankAcnt

'============================================================================
Sub Form_OnFormInit()

    g_szAccountNumber       = ""
    g_szAccountSerialNumber = ""
    g_szAccountPassword     = ""
    g_szAccountName         = ""
    g_szPrcd                = ""
    g_szPrnm                = ""
    g_szMangBrcd            = ""
    g_szMangBrcdName        = ""
    g_nDrngAbleAmt          = 0
    g_szBankCode            = ""
    g_szBankName            = ""
    g_szBankAcnt            = ""
	
    DATAMANAGER.RequestTranData("obaci_acct_306r")
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

    If szTranID == "obaci_acct_306r" Then
    
        If Trim(g_szAccountName) == "" Then
            g_szAccountName = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "ACNM" , 0)
        End If
    
        For i = 0 To DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1") - 1
            szAcno = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ACNO" , i)
            szAsno = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ASNO" , i)
            szPrnm = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "PRNM" , i)
            cmbAcnt.cbadddatatext = szAcno .. szAsno .. "`[" .. szPrnm .."] " .. Left(szAcno, 4) .. "-" .. Right(szAcno, 4) .. "-" .. szAsno .. " " .. g_szAccountName
        Next
	
        If DATAMANAGER.IsMoreNextData(szTranID) == True Then
            DATAMANAGER.RequestNextData(szTranID)
            Exit Sub
        End If
        
        g_szAccountNumber       = Left(cmbAcnt.cbkeydata,8)
        g_szAccountSerialNumber = Right(cmbAcnt.cbkeydata,2)
	
        For i = 0 To GrpAcntList.rowcount - 1
            If g_szAccountNumber == GrpAcntList.GetCellData("bd_cell0" , i) And g_szAccountSerialNumber == GrpAcntList.GetCellData("bd_cell1" , i) Then
                g_szPrcd         = GrpAcntList.GetCellData("bd_cell2" , i)
                g_szPrnm         = GrpAcntList.GetCellData("bd_cell3" , i)
                g_szMangBrcd     = GrpAcntList.GetCellData("bd_cell4" , i)
                g_szMangBrcdName = GrpAcntList.GetCellData("bd_cell5" , i)
                g_nDrngAbleAmt   = GrpAcntList.GetCellData("bd_cell6" , i)
                g_szBankCode     = GrpAcntList.GetCellData("bd_cell7" , i)
                g_szBankName     = GrpAcntList.GetCellData("bd_cell8" , i)
                g_szBankAcnt     = GrpAcntList.GetCellData("bd_cell9" , i)
            End If
        Next
	
        f_Trigger("AllAccount")
	
    End If
    
    If szTranID == "obacp_opop_066r" Then '비밀번호 정상
        f_Trigger("Password")
    End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

    If szTranID == "obaci_acct_306r" Then
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNT_STAT_CODE"     , 0 , "1")
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "LNKD_BANK_CLS_CODE" , 0 , "%")
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CSNO"               , 0 , "" )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ELFN_ID"            , 0 , Form.GetSharedData("&USER_ID", False))
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"               , 0 , "")
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "VLTN_ACMP_YN"       , 0 , "Y")
    End If
    
    If szTranID == "obacp_opop_066r" Then
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"     , 0 , g_szAccountNumber      )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ASNO"     , 0 , g_szAccountSerialNumber)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNT_PWD" , 0 , g_szAccountPassword    )
    End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    szSubErr = Trim(DATAMANAGER.GetDataMsgSubText( szTranID ))

    If szSubErr == "" Then
        Form.MsgBox( "알림", szErrMsg, "", 6 )		
    Else
        Form.MsgBox( "알림", szErrMsg.."\n("..szSubErr..")", "", 6 )		
    End If
    
    If szTranID == "obacp_opop_066r" Then '비밀번호 오류
        g_szAccountPassword = ""
        f_Trigger("Password")
    End If
		
End Sub

'============================================================================
Sub cmbAcnt_OnEditComplete(iIndex)

    g_szAccountNumber       = Left(cmbAcnt.cbkeydata,8)
    g_szAccountSerialNumber = Right(cmbAcnt.cbkeydata,2)
    
    For i = 0 To GrpAcntList.rowcount - 1
        If g_szAccountNumber == GrpAcntList.GetCellData("bd_cell0" , i) And g_szAccountSerialNumber == GrpAcntList.GetCellData("bd_cell1" , i) Then
            g_szPrcd         = GrpAcntList.GetCellData("bd_cell2" , i)
            g_szPrnm         = GrpAcntList.GetCellData("bd_cell3" , i)
            g_szMangBrcd     = GrpAcntList.GetCellData("bd_cell4" , i)
            g_szMangBrcdName = GrpAcntList.GetCellData("bd_cell5" , i)
            g_nDrngAbleAmt   = GrpAcntList.GetCellData("bd_cell6" , i)
            g_szBankCode     = GrpAcntList.GetCellData("bd_cell7" , i)
            g_szBankName     = GrpAcntList.GetCellData("bd_cell8" , i)
            g_szBankAcnt     = GrpAcntList.GetCellData("bd_cell9" , i)
        End If
    Next

    edtPwd01.caption = ""
    g_szAccountPassword = ""
    
    f_Trigger("AllAccount")
    
End Sub

'============================================================================
Sub fmtabTran_OnTabChanged(nCurrentTab)

    if g_szAccountNumber <> "" then
        f_Trigger("AllAccount")
    end if
	
    If nCurrentTab == 2 then
        edtPwd01.enable = false
    Else
        edtPwd01.enable = true
    End If
    
End Sub

'============================================================================
Sub edtPwd01_OnClick()
	g_szAccountPassword = ""
	f_Trigger("Password")
End Sub

'============================================================================
Sub edtPwd01_OnEditComplete()

	plain_rm = Form.GetSharedData("&PLAIN_RM" , false)
	If plain_rm = "1" Then
	    g_szAccountPassword = edtPwd01.caption
	Else
	    g_szAccountPassword = Form.GetEncData(edtPwd01.caption)
	End If
	
    DATAMANAGER.RequestTranData("obacp_opop_066r")

End Sub

'============================================================================
Sub fmtabTran_OnTabChanged(nCurrentTab)

    if g_szAccountNumber <> "" then
        f_Trigger("AllAccount")
    end if
	
	if nCurrentTab == 2 then
		edtPwd01.enable = false
	else
		edtPwd01.enable = true
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

    If sEventName == "CORNFORM_OK" Then
    
	    g_szAccountPassword = ""
	    edtPwd01.caption    = ""
	    f_Trigger("Password")    
    
        fmtabTran.currenttab = sParam
        fmtabTran_OnTabChanged(CInt(sParam))
	
    End If
	
End Sub

'============================================================================
Sub f_Trigger(sEventName)

    szData = g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & g_szAccountPassword & "★" & g_szAccountName &
             "★" & g_szPrcd & "★" & g_szPrnm & "★" & g_szMangBrcd & "★" & g_szMangBrcdName & "★" & g_nDrngAbleAmt & "★" &
             g_szBankCode & "★" & g_szBankName & "★" & g_szBankAcnt
    Form.triggerEvent("fmtabTran." & fmtabTran.currenttabpageid , sEventName , szData)
    
End Sub


	</SCRIPT_INFO>
	<DATAIO_INFO>
