'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' ClearData() : 이전 테이블 내용 초기화
'============================================================================
Function ClearData()
    '가입정보
	tblJoinInfo.SetCellString(0, 1, "") '가입일자
	tblJoinInfo.SetCellString(0, 3, "") '해지일
	tblJoinInfo.SetCellString(1, 1, "") '납입금액
	tblJoinInfo.SetCellString(1, 3, "") '해지구분
	tblJoinInfo.SetCellString(2, 2, "") '해지예상 수령금액
	
	'해지예상내역
	tblExpected.SetCellString(0, 1, "") '세전 평가금액
	tblExpected.SetCellString(0, 3, "") '유가증권
	tblExpected.SetCellString(1, 1, "") '세금 및 비용내역
	tblExpected.SetCellString(1, 3, "") '현금
	tblExpected.SetCellString(2, 1, "") '보수 및 수수료
	tblExpected.SetCellString(2, 3, "") '소득세
	tblExpected.SetCellString(3, 3, "") '지방소득세
	tblExpected.SetCellString(4, 3, "") '세후 평가금액
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()    
    if Account0.caption <> NULL and Account0.caption <> "" then
	    DATAMANAGER.RequestTranData( "obsap_bisa_001r" )
    end if
End Sub

'============================================================================
' Account0_ChangeAccount() : 계좌 변경시 재조회
'============================================================================
Sub Account0_ChangeAccount()
	ClearData()
	
	if Account0.caption <> NULL and Account0.caption <> "" then
	    DATAMANAGER.RequestTranData( "obsap_bisa_001r" )
    end if
End Sub

'****************************************************************************
'               		D A T A				M A N A G E R               
'****************************************************************************

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 통신에 필요한 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obsap_bisa_001r" then
		Dim szACNO, szASNO
		szACNO = Left( Account0.caption, 8 )
		szASNO = Right( Account0.caption, 2 )
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, szACNO) '계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0, szASNO) '계좌일련번호
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obsap_bisa_001r" then
		Dim nMkscAmt, nCash, nFeeSum ' 유가증권, 현금, 세전평가금액 (유가증권 + 현금)
		Dim nTax, nLocalTax, nPreEvalAmt ' 소득세, 지방소득세, 세금 및 비용내역 (소득세 + 지방소득세)
	
		nMkscAmt		= CDbl(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MKSC_VLTN_AMT", 0)) ' 유가증권
		nCash		= CDbl(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CASH_AMT", 0)) ' 현금
		nFeeSum		= nMkscAmt + nCash ' 세전평가금액 (유가증권 + 현금)
		
		nTax			= CDbl(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INCM_TXAM", 0)) ' 소득세
		nLocalTax	= CDbl(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PRVN_TXAM", 0)) ' 지방소득세
		nPreEvalAmt	= nTax + nLocalTax ' 세금 및 비용내역 (소득세 + 지방소득세)
		
		tblExpected.SetCellString(0, 1, nFeeSum) '세전 평가금액
		tblExpected.SetCellString(1, 1, nPreEvalAmt) '세금 및 비용내역
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szSubMsg <> NULL and szSubMsg <> "" then
		Form.ShowAlert( "알림", szErrMsg & "(" & szSubMsg & ")" )
	else
		Form.ShowAlert( "알림", szErrMsg )
	end if
End Sub

