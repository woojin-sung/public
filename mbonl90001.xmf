								<CELL cell_ly="0,7,0,7" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,7,1,7" halign="0" line="0,0" caption="투자자는 금융투자상품(채권, 단기사채, ETN)에 대하여" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,8,0,8" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,8,1,8" halign="0" line="0,0" caption="메리츠증권으로부터 충분한 설명을 받을 권리가 있으며," fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,9,0,9" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,9,1,9" halign="0" line="0,0" caption="투자 전 상품설명서 및 약관을 반드시 읽어보시기 바랍니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,10,0,10" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,10,1,10" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,11,0,11" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,11,1,11" halign="0" line="0,0" caption="금융투자상품(채권, 단기사채, ETN)은 자산가격 변동, 신용" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,12,0,12" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,12,1,12" halign="0" line="0,0" caption="등급 하락 등에 따라 투자원금의 손실(0~100%)이 발생할" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,13,0,13" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,13,1,13" halign="0" line="0,0" caption="수 있으며, 그 손실은 투자자에게 귀속됩니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,14,0,14" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,14,1,14" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,15,0,15" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,15,1,15" halign="0" line="0,0" caption="금융투자상품(채권, 단기사채, ETN)은 예금자보호법에 따라" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,16,0,16" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,16,1,16" halign="0" line="0,0" caption="보호되지 않습니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,17,0,17" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,17,1,17" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,18,0,18" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,18,1,18" halign="0" line="0,0" caption="본 안내는 청약의 권유를 목적으로 하지 않으며, 청약의 " fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,19,0,19" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,19,1,19" halign="0" line="0,0" caption="권유는 (예비, 간이) 투자설명서에 따릅니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,20,0,20" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,20,1,20" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,21,0,21" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,21,1,21" halign="0" line="0,0" caption="채권, ETN은 발행사의 신용등급(각 채권별 상이하므로 상품" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,22,0,22" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,22,1,22" halign="0" line="0,0" caption="상세화면 등을 참고)의 하락, 신용상태 변동 등에 따라 원금" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,23,0,23" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,23,1,23" halign="0" line="0,0" caption="손실 발생이 가능하고, 발행사의 파산·부도시 원금 100%" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,24,0,24" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,24,1,24" halign="0" line="0,0" caption="손실이 발생할 수 있습니다. [메리츠증권의 신용등급 : AA-" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,25,0,25" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,25,1,25" halign="0" line="0,0" caption="(NICE신용평가 2024.04.12, 한국신용평가 2024.04.12)]" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,26,0,26" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,26,1,26" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,27,0,27" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,27,1,27" halign="0" line="0,0" caption="투자적격등급은 AAA/AA·A·BBB 각 +,0,-순으로 구분됩니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,28,0,28" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,28,1,28" halign="0" line="0,0" caption="(단기사채의 경우 투자적격등급은 A1/A2·A3 각 +,0,-" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,29,0,29" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,29,1,29" halign="0" line="0,0" caption="순으로 구분됩니다.)" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,30,0,30" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,30,1,30" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,31,0,31" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,31,1,31" halign="0" line="0,0" caption="만기일이 영업일이 아닌 경우(공휴일 포함), 다음 영업일에 " fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,32,0,32" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,32,1,32" halign="0" line="0,0" caption="만기상환 됩니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,33,0,33" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,33,1,33" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,34,0,34" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,34,1,34" halign="0" line="0,0" caption="당사는 본 단기사채와 관련하여 만기 전 환매, 재매도 등" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,35,0,35" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,35,1,35" halign="0" line="0,0" caption="투자에 의한 중도상환 또는 현금화를 보장하지 않습니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,36,0,36" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,36,1,36" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,37,0,37" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,37,1,37" halign="0" line="0,0" caption="당사가 제공하는 투자설명서는 신뢰할만하다고 판단하는 " fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,38,0,38" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,38,1,38" halign="0" line="0,0" caption="자료와 정보에 근거하여 작성되었으나 당사가 그 정확성이나" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,39,0,39" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,39,1,39" halign="0" line="0,0" caption="완전성을 보장하지 않습니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
