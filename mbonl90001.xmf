'============================================================================
Sub Form_OnFormInitBefore()
	contMain.contMine.imgMine.setMaintainingRatio("1")
	contMain.contCheck.imgFold.setMaintainingRatio("1")
	
	contMain.contMine.Label0.setNeighborCtlPos("contMain.contMine.imgMine", "left", 0, "")
	contMain.contMine.Label0.setNeighborCtlPos("contMain.contMine.ChkMine", "left", 0, "")
End Sub


'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	
	g_bFoldState = False
	
	szOpenData = Form.GetOpenLinkData()
	
	'고객ID
	g_szUSERID = Form.GetSharedData("&USER_ID", false )
	
	'고객번호
	g_szCsno = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴

	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	g_COMN_PFIN_YN = "N"
	
	'고객 투자성향 및 상품위험등급 조회
	g_szQryType = "2"
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		contMain.setScrollBarVisible("2")
	end if
	
	DATAMANAGER.RequestTranData( "obsab_deal_601r" )
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , szErrCode .. " : ".. szErrMsg)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obsab_deal_601r" then		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , "9")  '9:투자성향 조회
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID" , 0 , g_szUSERID)
		
	end if  'end of if szTranID == "obsab_deal_601r"
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	 
	if szTranID == "obsab_deal_601r" then
		g_HLDY_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "HLDY_YN" , 0)		'휴일여부		
		g_DEAL_ABLE_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "DEAL_ABLE_YN" , 0)	'매매가능여부
		g_IQRY_CSNU = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "IQRY_CSNU" , 0)	'조회건수
		g_CUST_CLS_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CUST_CLS_CODE" , 0)	'고객구분코드 2:법인
		
		g_COMN_PFIN_YN      = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "COMN_PFIN_YN" , 0)	'공통전문투자자여부
		g_PFIN_VLDT_EXPR_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "PFIN_VLDT_EXPR_YN" , 0)	'전문투자자효력경과여부
		
		g_KYC_INVT_INCL_GRAD_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "KYC_INVT_INCL_GRAD_CODE" , 0)	'KYC투자성향등급코드
		g_KYC_INVT_INCL_GRAD_NAME = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "KYC_INVT_INCL_GRAD_NAME" , 0)	'KYC투자성향등급명
		g_IVIC_VLDT_EXPR_YN       = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "IVIC_VLDT_EXPR_YN" , 0)		'투자성향효력경과여부
		g_KYC_INVT_RCMD_CLS_CODE  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "KYC_INVT_RCMD_CLS_CODE" , 0)	'KYC투자권유구분코드
					
'			Form.ShowAlert("TranComplete", g_HLDY_YN & " : " &
'									    g_DEAL_ABLE_YN & " : " &
'									    g_COMN_PFIN_YN & " : " &
'									    g_PFIN_VLDT_EXPR_YN & " : " &
'									    g_KYC_INVT_INCL_GRAD_CODE & " : " &
'									    g_KYC_INVT_INCL_GRAD_NAME & " : " &
'									    g_IVIC_VLDT_EXPR_YN & " : " &
'									    g_KYC_INVT_RCMD_CLS_CODE)			
		
		f_setState()
		
'		f_sendTrigger()
	end if
	
End Sub


'============================================================================
Sub contMain_contMine_btnMine_OnClick()
	if CInt(contMain.contMine.ChkMine.checkstate) == 0 then
		f_SetCheckState(True)
	else
		f_SetCheckState(False)
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'	Form.ShowAlert(sKeyName, sRet)
	if sKeyName == "mbonl88060_p11" then
		if (sRet <> "") and (int(sRet) <> 0) and (sRet <> null) then
			g_szQryType = "1"	'내성향맞춤해제시
			f_sendTrigger()
			
		end if
		
	elseif sKeyName == "mbonl88060_p1" then		
		f_sendTrigger()
	
	elseif sKeyName == "mbonl90201_s1" then
		'투자성향 미등록인 경우 투자성향 재진단 연결
		if sRet == "MOVE" then
			'투자성향재진단 화면 연결
			Form.OpenScreen("81010", "")
			Form.CloseForm()
		else
			f_sendTrigger()
			
		end if 
		
	elseif sKeyName == "close" then
		Form.CloseForm()
		
'	elseif sKeyName == "MBBDM85143" then
	
	elseif sKeyName == "errMsgBox"  Then 
		'mbfnp51000_p15 에서 리턴
		if sRet = "Left" then	
			contMain.contMine.ChkMine.chksilence = "0"
			contMain.contMine.imgMine.imgpath = "checkmenu_n.png"
		
			g_szQryType = "1"	'내성향맞춤해제시			
			f_sendTrigger()
			
		else'if sRet = "Right" then				
			'투자성향재진단 화면 연결
			Form.OpenScreen("81010", "")
			
		end if
	end if
	
End Sub

