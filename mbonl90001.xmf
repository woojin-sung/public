Sub contMain_contCheck_imgFold_OnClick()
	Dim szimgFile

	if g_bFoldState then
		szimgFile = "icon_gray_down.png"
	else
		szimgFile = "icon_gray_up.png"
	end if
	
	g_bFoldState = not g_bFoldState
	contMain.contCheck.imgFold.imgpath = szimgFile
	
	f_ShowInfo(g_bFoldState)
End Sub

