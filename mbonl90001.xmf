						<TABLE name="Table2" insidelinecolor="102:255255255" colcount="2" rowcount="42" outline="0000" transmode="1" designorder="1" ly_vert="20,573,335,590,1" >
							<COL_INFO ly_vert_width="10,325" />
							<ROW_INFO ly_vert_height="10,15,15,15,10,15,15,15,15,10,15,15,15,15,15,15,10,15,15,10,15,15,15,15,10,15,15,15,10,15,15,10,15,15,10,15,15,10,15,15,15,25" />
							<CELL_INFO>
								<CELL cell_ly="0,0,0,0" line="0,0" impidxs="" />
								<CELL cell_ly="1,0,1,0" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,1,0,1" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,1,1,1" halign="0" line="0,0" caption="본 상품은 판매회사의 투자권유 없이 본인의 판단과 책임" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,2,0,2" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,2,1,2" halign="0" line="0,0" caption="하에 투자결정을 하므로, 투자에 따른 모든 위험은 모두" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,3,0,3" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,3,1,3" halign="0" line="0,0" caption="투자자에게 귀속되고 당사는 책임을 지지 않습니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,4,0,4" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,4,1,4" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,5,0,5" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,5,1,5" halign="0" line="0,0" caption="ETN은 기초지수 구성종목의 가격에 연계해 증권의 수익률" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,6,0,6" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,6,1,6" halign="0" line="0,0" caption="이 결정되므로 투자결정 시 기초자산의 성격 및 과거 가격" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,7,0,7" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,7,1,7" halign="0" line="0,0" caption="추이, 기초자산 관련 경영환경 변화 등에 따른 권리변경 가" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,8,0,8" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,8,1,8" halign="0" line="0,0" caption="능성 등을 충분히 감안하시기 바랍니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,9,0,9" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,9,1,9" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,10,0,10" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,10,1,10" halign="0" line="0,0" caption="파생결합증권은 거래소에 상장되어 거래되는 상품으로 거래" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,11,0,11" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,11,1,11" halign="0" line="0,0" caption="소 상장 규정에 따라 상장폐지 될 수 있습니다. 투자자가 투" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,12,0,12" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,12,1,12" halign="0" line="0,0" caption="자금 회수를 위해 발행인에게 중도상환을 요청할 시 상환비" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,13,0,13" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,13,1,13" halign="0" line="0,0" caption="용이 발생할 수 있으므로, 투자자에게 지급되는 금액은 원금" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,14,0,14" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,14,1,14" halign="0" line="0,0" caption="에 미달할 수 있습니다. 중도상환절차 및 상환가격 결정방법" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,15,0,15" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,15,1,15" halign="0" line="0,0" caption="등을 반드시 확인하시기 바랍니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,16,0,16" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,16,1,16" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,17,0,17" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,17,1,17" halign="0" line="0,0" caption="과세기준 및 과세방법은 향후 법령 개정 등에 따라 변동될" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,18,0,18" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,18,1,18" halign="0" line="0,0" caption="수 있습니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,19,0,19" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,19,1,19" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,20,0,20" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,20,1,20" halign="0" line="0,0" caption="온라인에서 제공한 ETN, 기초지수 및 지표가치 등의 과거" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,21,0,21" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,21,1,21" halign="0" line="0,0" caption="성과는 제비용, 세금, 증권거래수수료 등으로 인해 실제 성" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,22,0,22" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,22,1,22" halign="0" line="0,0" caption="과와 다를 수 있으며, 과거 수익이 미래 수익을 보장하지" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,23,0,23" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,23,1,23" halign="0" line="0,0" caption="않습니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,24,0,24" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,24,1,24" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,25,0,25" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,25,1,25" halign="0" line="0,0" caption="온라인에서 제공하는 지수 및 수익률 정보는 투자 참고사항" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,26,0,26" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,26,1,26" halign="0" line="0,0" caption="이며 오류가 발생하거나 지연될 수 있습니다. 제공된 정보에" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,27,0,27" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,27,1,27" halign="0" line="0,0" caption="의한 투자 결과에 대해 당사는 법적인 책임을 지지 않습니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,28,0,28" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,28,1,28" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,29,0,29" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,29,1,29" halign="0" line="0,0" caption="ETN의 총보수는 상품별로 상이(0.10% ~ 0.80%)하며, 자세" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,30,0,30" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,30,1,30" halign="0" line="0,0" caption="한 내용은 홈페이지 및 투자설명서를 참고하시기 바랍니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,31,0,31" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,31,1,31" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,32,0,32" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,32,1,32" halign="0" line="0,0" caption="외화자산의 경우 환율변동에 따라 손실이 발생할 수 있습" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,33,0,33" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,33,1,33" halign="0" line="0,0" caption="니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,34,0,34" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,34,1,34" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,35,0,35" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,35,1,35" halign="0" line="0,0" caption="주식(ETF, ETN)거래 수수료는 0.009% ~ 0.498132%이며," fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,36,0,36" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,36,1,36" halign="0" line="0,0" caption="자세한 내용은 홈페이지 등을 참고하시기 바랍니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,37,0,37" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,37,1,37" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,38,0,38" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,38,1,38" halign="0" line="0,0" caption="장내채권거래 수수료는 0.015% ~ 0.6%(소액국공채 액면가" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,39,0,39" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,39,1,39" halign="0" line="0,0" caption="5천만원 이하 기준)이며, 자세한 내용은 홈페이지 등을 참고" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,40,0,40" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,40,1,40" halign="0" line="0,0" caption="하시기 바랍니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,41,0,41" line="0,0" impidxs="" />
								<CELL cell_ly="1,41,1,41" line="0,0" impidxs="" />
							</CELL_INFO>
