	<SCRIPT_INFO _len="15169" _ulen="13261" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Bond Home
' 02. 화면설명 : Bond Home
' 03. 작    성 : 
'  2023.11.06  신규 작성
'     Bond Home  	mbonl90001
'             
'-------------------------------------------------------------------------------------------

'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_LinkData
Dim g_bFoldState
Dim g_plain_rm  		'v0002 메모리평문적용여부
Dim g_szQryType		'조회 구분 1:전체조회, 2:투자성향맞는 종목만 조회, 9:투자성향조회

Dim g_szUSERID    '고객 ID
Dim g_szCsno 		'v0004 고객번호

Dim g_HLDY_YN            '휴일여부
Dim g_DEAL_ABLE_YN       '매매가능 여부
Dim g_IQRY_CSNU		  '조회건수
Dim g_CUST_CLS_CODE	  '고객구분코드(2:법인)
Dim g_COMN_PFIN_YN	  '전문투자자 여부
Dim g_PFIN_VLDT_EXPR_YN  '전문투자자 만료 여부

Dim g_KYC_INVT_INCL_GRAD_CODE   'KYC투자성향등급코드
Dim g_KYC_INVT_INCL_GRAD_NAME   'KYC투자성향등급명
Dim g_IVIC_VLDT_EXPR_YN         '투자성향효력경과여부
Dim g_KYC_INVT_RCMD_CLS_CODE    'KYC투자권유구분코드

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Sub f_setState()
'	g_KYC_INVT_RCMD_CLS_CODE = "1"
'	g_KYC_INVT_INCL_GRAD_CODE = "01"
		
	if g_COMN_PFIN_YN = "Y" then
		contMain.contMine.lblMine.caption = "전문투자자"
		contMain.contMine.lblMine.fgcolor = "330"			
		
		g_szQryType = 1
		f_sendTrigger()
		
	elseif g_KYC_INVT_INCL_GRAD_CODE = "" then
		'투자자정보 없는 고객은 내성향맞춤 상관없이 무조건 전체상품조회
		contMain.contMine.lblMine.caption = "미등록"
		contMain.contMine.lblMine.fgcolor = "146"

		Dim szAlertData, szTitle
		
		szTitle = "투자자정보 미등록 안내"
		g_ErrMsgText = "투자성향에 맞는 상품 가입을 위해\n투자자정보 등록이 필요합니다."
		szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."전체조회".."★".."투자성향 등록"
		
		Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
		
	elseif g_IVIC_VLDT_EXPR_YN == "Y" then
		'투자자정보 없는 고객은 내성향맞춤 상관없이 무조건 전체상품조회
		contMain.contMine.lblMine.caption = "미등록"	'유효기간만료
		contMain.contMine.lblMine.fgcolor = "146"
			
		Dim szAlertData, szTitle
		
		szTitle = "투자자정보 만료 안내"
		g_ErrMsgText = "투자자정보 유효기간이 경과되었습니다.\n투자성향에 맞는 상품 가입을 위해\n투자자정보 등록이 필요합니다."
		szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."전체조회".."★".."투자성향 등록"
		
		Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
		
	elseif g_KYC_INVT_RCMD_CLS_CODE = "2" or g_KYC_INVT_RCMD_CLS_CODE ="4" then
		'투자자정보 없는 고객은 내성향맞춤 상관없이 무조건 전체상품조회
		contMain.contMine.lblMine.caption = "정보미제공"
		contMain.contMine.lblMine.fgcolor = "321"
		
		Dim szAlertData, szTitle
		
		szTitle = "투자자정보 미제공 안내"
		g_ErrMsgText = "투자성향에 맞는 상품 가입을 위해\n투자자정보 제공이 필요합니다."
		szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."전체조회".."★".."투자성향 등록"
		
		Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
		
	else
		'v0001 sta 투자성향에 맞는 펀드 우선 검색
		if g_KYC_INVT_INCL_GRAD_CODE = "01" then
			contMain.contMine.lblMine.caption = "고수익지향형"
			contMain.contMine.lblMine.fgcolor = "326"
		
		elseif g_KYC_INVT_INCL_GRAD_CODE = "02" then
			contMain.contMine.lblMine.caption = "성장지향형"
			contMain.contMine.lblMine.fgcolor = "321"
			
		elseif g_KYC_INVT_INCL_GRAD_CODE = "03" then
			contMain.contMine.lblMine.caption = "중립형"
			contMain.contMine.lblMine.fgcolor = "328"
			
		elseif g_KYC_INVT_INCL_GRAD_CODE = "04" then
			contMain.contMine.lblMine.caption = "안정지향형"
			contMain.contMine.lblMine.fgcolor = "328"
			
		elseif g_KYC_INVT_INCL_GRAD_CODE = "05" then	
			contMain.contMine.lblMine.caption = "이자소득형"
			contMain.contMine.lblMine.fgcolor = "329"
		'v0001 fin
				
		end if
		
		f_sendTrigger()
		
	end if
	
end sub	

'============================================================================
Sub f_SetCheckState(bValue)
	if bValue == true then
		contMain.contMine.ChkMine.chksilence = "1"
		contMain.contMine.imgMine.imgpath = "checkmenu_o.png"
				
		g_szQryType = 2
		f_setState()
		
	else
		contMain.contMine.ChkMine.chksilence = "0"
		contMain.contMine.imgMine.imgpath = "checkmenu_n.png"
		
		'전문투자자인 경우 체크해지하더라도 팝업 미생성
		if g_COMN_PFIN_YN == "Y" then
			g_szQryType = 1		'내성향맞춤해제시			
			f_sendTrigger()
			
		else			
			if g_KYC_INVT_RCMD_CLS_CODE == "3" or g_KYC_INVT_RCMD_CLS_CODE == "4" then
				'미희망(불원)&미제공 or 미희망(불원)&제공 인 경우, 체크해지하면 팝업 생성 후 전체상품조회
				Form.openPopupAnimation("mbonl88060_p11", "", "", "2")
			else
				' 내성향맞춤 체크해제시, 안내 팜업 확인 후 전체등급의 상품 조회 가능.
				Form.openPopupAnimation("mbonl88060_p11", "", "", "2")
			end if
		end if
		
	end if
	
End Sub

'============================================================================
'오늘의 채권 배너와 수익률Top5 화면으로 투자성향 조회한 데이타 전달.
sub f_sendTrigger()
	g_LinkData = g_szQryType & "|" &				'0 조회구분  1, 2
			    g_HLDY_YN & "|" &					'1 휴일여부
			    g_DEAL_ABLE_YN & "|" &				'2 거래가능 여부
			    g_COMN_PFIN_YN & "|" &				'3 전문투자자여부
			    g_PFIN_VLDT_EXPR_YN & "|" &			'4 전문투자자효력경과여부
			    g_KYC_INVT_INCL_GRAD_CODE & "|" &	'5 KYC투자성향등급코드
			    g_KYC_INVT_INCL_GRAD_NAME & "|" &	'6 KYC투자성향등급명
			    g_IVIC_VLDT_EXPR_YN & "|" &			'7 투자성향효력경과여부
			    g_KYC_INVT_RCMD_CLS_CODE & "|" &		'8 KYC투자권유구분코드
			    cmbAccount.total & "|" &			'9 계좌번호
			    cmbAccount.sequence & "|" &			'10 계좌seq
			    g_IQRY_CSNU & "|" &				'11 조회건수
			    g_CUST_CLS_CODE					'12 고객구분코드(2:법인)
			    
	if g_plain_rm == "1" then
		g_LinkData = g_LinkData & "|" & edtPassword.caption
	else
		g_LinkData = g_LinkData & "|" & Form.GetCtlProp("edtPassword", "encdata")
	end if
	
	Form.triggerEvent("linkfmBanner",	"obsab_deal_601r", g_LinkData)
	Form.triggerEvent("linkfmTop5",		"obsab_deal_601r", g_LinkData)
end sub

'============================================================================
'채권 리스트 하단의 투자유의사항 컨트롤
Sub f_ShowInfo(bState)
	if bState then
		contMain.contCheck.height = 1160
		contMain.contCheck.SetScrollAutoSize()
				
		contMain.SetScrollAutoSize()
		contMain.scroll_pos = 2139	
	else
		contMain.contCheck.height = 30
		contMain.contCheck.SetScrollAutoSize()

		contMain.SetScrollAutoSize()
		contMain.scroll_pos = 1645
		
	end if
	
End Sub 

