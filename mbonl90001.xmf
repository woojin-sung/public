Sub contMain_contLink_imgLink1_OnClick()
	Dim szLinkData
	
	szLinkData = "2"		& "★" &		'장외채권
			    "1|2"	& "★" 		'국채, 공사채
		
	'국채/공사채
	if g_CUST_CLS_CODE == "2" then
		Form.ShowAlert("알림", "법인은 신청이 불가합니다.")
		Exit Sub
	else
		Form.triggerEvent("#", "QUICK_LINK", szLinkData)
	end if
End Sub

