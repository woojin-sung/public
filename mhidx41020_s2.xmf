'============================================================================
'20210916 SWJ START
'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	Select Case nCurrentTab
		Case 0
			imgIndic.imgpath = "icon_4step1"
		Case 1
			imgIndic.imgpath = "icon_4step2"
		Case 2
			imgIndic.imgpath = "icon_4step3"
		Case 3
			imgIndic.imgpath = "icon_4step4"
	End Select

	'폼탭 움직이면 지수부분 양쪽에서
	'실시간이 끊기는 현상이 있어서 재조회 하도록 수정
	Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "Reload_Data", "")
	
End Sub
'============================================================================
Sub Form_OnFormInit()
	Form.bgcolor = "320"
	Label1.fgcolor = 334
	FormTab0_OnTabChanged(0)
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgIndic.setMaintainingRatio("1")
End Sub


