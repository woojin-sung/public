'============================================================================
' 화 면 명 : 선물옵션주문_잔고팝업
' 화면설명 : 선물주문 매수/매도에서 잔고버튼 클릭시 오픈
' 작    성 : 2016.02.02 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szFundCd, g_szFundPwd, g_szGbn	'20200331 HWG : 고유MTS

Dim g_szTitle
g_szTitle = "알림"


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Request_Data()
'============================================================================
Function Request_Data()
	grdList.rowcount = 0
	
	DATAMANAGER.RequestTranData( "obtrf_cntg_820r" )
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("(야)선물옵션잔고")
	
	szOpen = Form.GetopenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szFundCd   = tData(0)	'20200331 HWG : 고유MTS
		g_szFundPwd  = tData(1)	'20200331 HWG : 고유MTS
		g_szGbn      = tData(2)		
	
'		if tData(2) == "1" then		' 예약주문에서 여는경우
'			chk1.left = 1000
'			chk2.left = 1000
'			grdList.top = 0
'			grdList.height = 563		
'		end if
		
		Request_Data()
	end if
End Sub

'============================================================================
' chk1_OnChange
'============================================================================
Sub chk1_OnChange(sCheckState)
	Request_Data()
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 장내파생실시간주문체결잔고조회
	' ----------------------------------------------------------------------
	if szTranID = "obtrf_cntg_820r" then
		DATAMANAGER.ClearInputData(0, "obtrf_cntg_820r")
		
		'20200331 HWG START : 고유MTS
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_820r", "InBlock1", "ACNO"    	, 0, "000000" & Left(g_szFundCd,2))
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_820r", "InBlock1", "ASNO"    	, 0, Right(g_szFundCd, 2))
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_820r", "InBlock1", "ACNT_PWD"    , 0, g_szFundPwd)
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_820r", "InBlock1", "DATA_CLS", 0, "1")
		'20200331 HWG END
		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	Dim nCnt
	Dim nVLTN_PRLS_AMT, nDEAL_FEE	'평가손익금액, 매매수수료
	
	' ----------------------------------------------------------------------
	' 장내파생실시간주문체결잔고조회
	' ----------------------------------------------------------------------
	if szTranID = "obtrf_cntg_820r" then	
		nCnt = DATAMANAGER.GetDataCount( 0, "obtrf_cntg_820r", "OutBlock2" )
		
		if chk1.checkstate = "1" then
			For i = 0 to nCnt - 1
				
				nVLTN_PRLS_AMT = CDbl(DATAMANAGER.GetDataValue(0, "obtrf_cntg_820r", "OutBlock2", "VLTN_PRLS_AMT", i))
				nDEAL_FEE      = CDbl(DATAMANAGER.GetDataValue(0, "obtrf_cntg_820r", "OutBlock2", "DEAL_FEE"     , i))
				
				DATAMANAGER.SetDataValue(0, "obtrf_cntg_820r", "OutBlock2", "VLTN_PRLS_AMT", i, nVLTN_PRLS_AMT - nDEAL_FEE)			
			Next
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nCLPR, nPRPR
	Dim szData
			
	' ----------------------------------------------------------------------
	' 장내파생실시간주문체결잔고조회
	' ----------------------------------------------------------------------	
	if szTranID = "obtrf_cntg_820r" then
		
		For i = 0 to grdList.rowcount - 1 
			szData = grdList.GetCellData( "bd_Gbn", i )
			
			if szData == "1" then
				grdList.SetCellData("bd_GbnNm", i, "매도")
				grdList.SetCellFgColor("bd_GbnNm", i, "11")
			elseif szData == "2" then
				grdList.SetCellData("bd_GbnNm", i, "매수")
				grdList.SetCellFgColor("bd_GbnNm", i, "10")
			end if
			
			'전일대비
			nCLPR = CDbl(grdList.GetCellData("bd_Jong", i))
			nPRPR = CDbl(grdList.GetCellData("bd_Hyun", i))
			
			grdList.SetCellData("bd_Debi", i, nPRPR - nCLPR)
		Next
	end if
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szGbn, szMk, szData
	
	if lRow > -1 then
		szCd  = grdList.GetCellData("bd_Cd", lRow)
		szCd = Mid(szCd, 2, Len(szCd))
		
		szMk = Form.GetItemCodeInfo(szCd, "market_night")

		'20200331 HWG START
		' CME선물, EUREX선물옵션 만 가능
'		if Trim(szMk) == "CM" or Trim(szMk) == "EO" or Trim(szMk) == "EM" then
			szQty = grdList.GetCellData("bd_Able", lRow)
			szGbn = grdList.GetCellData("bd_Gbn",  lRow)
			
			if szGbn == "1" then		' 매도 -> 매수
				szGbn = "0"
			else						' 매수 -> 매도
				szGbn = "1"
			end if
			
			' 잔고/탭구분/종목코드/가능수량		
			szData = "잔고" & "★" & szGbn & "★" & szCd & "★" & szQty 

			Form.SendReturnToParent("01000_BALANCE", szData)	'20200331 HWG : 고유MTS		
			Form.CloseForm()
'		else
'			Form.ShowAlert(g_szTitle, "선택상품은 MTS에서 거래되지 않는 상품입니다.")
'		end if
		'20200331 HWG END
	end if
End Sub

'============================================================================
' btnInquiry_OnClick : 조회버튼 클릭
'============================================================================
Sub btnInquiry_OnClick()
	Request_Data()
End Sub

