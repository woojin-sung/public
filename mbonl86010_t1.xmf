'============================================================================
' 01. 화 면 명 : 중요거래단말지정서비스_이용단말등록
' 02. 화면설명 : 중요거래단말지정서비스_이용단말등록 탭
' 03. 작    성 : 2016.01.18 ~ 최지희
' 2020.11.19 : 정민영 : v0001 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_oimf_638r IO 변경분 반영
' 2021.02.18 : 권오상 : v0002 : MOTP 적용
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szUserId	'고객아이디
Dim g_szMacAddr	'맥주소
Dim g_szOneTimeNo	'고객인증번호
Dim g_szCertType	'인증유형코드
Dim g_szCheck	'입력 유효성 체크
Dim g_bExit	

Dim sSPLM_ATHN_NCSR_YN	'추가인증필요여부
Dim g_sGubunCode '보안카드 otp구분
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID )
	if szTranID == "obcsb_oimf_638r" then	'전자금융사기예방 고객조회'
		edtEnrollStatus.caption = ""
		edtServiceStatus.caption = ""
		edtNickName.caption = ""
		
		'16-03-08 YCJ Input값 수정 MAC주소 -> DeviceID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , g_szUserId)	'사용자ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID())	'UI단말식별키
'		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "MAC_ADDR" , 0 , g_szMacAddr)	'MAC 주소
		DATAMANAGER.RequestTranData("obcsb_oimf_638r")
	end if
	
	if szTranID == "obcsb_oimf_636a" then	'이용단말등록
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "PROS_CLS" , 0 , "1")	'처리구분
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "ELFN_ID" , 0 , Trim(g_szUserId))	'전자금융ID
		DATAMANAGER.SetDataValue(0,  "obcsb_oimf_636a", "InBlock1", "TERM_NAME", 0 , Trim(edtNickName.caption))	'단말명
		DATAMANAGER.SetDataValue(0,  "obcsb_oimf_636a", "InBlock1", "MAC_ADDR", 0 , g_szMacAddr)	'맥주소
		if Len(g_szOneTimeNo) == 6 then
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "UI_CUST_ATHN_NO" , 0 , g_szOneTimeNo)	'고객인증번호(6자리)/1회용인증번호
		end if
		DATAMANAGER.SetDataValue(0,  "obcsb_oimf_636a", "InBlock1", "ATHN_TYPE_CODE", 0 , g_szCertType)	'인증유형코드(1자리)
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "TERM_DSGT_CLS_CODE" , 0 , rdoService.currentindex+1) '
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID()) 'rdoService.currentindex+1
		DATAMANAGER.RequestTranData("obcsb_oimf_636a")
	end if


End Function


'============================================================================
' SendReg
'============================================================================
Function SendReg()
	if g_szMacAddr == "" then
		Form.MsgBox("알림", "단말식별 정보획득이 불가능한 단말은 이용단말등록을 할 수 없습니다.", "", 0)
	else
		'보안매체 확인처리해야함		
		Call TR_Inquiry("obcsb_oimf_636a")		
	end if

End Function

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "enroll" then
		btnSearch_OnClick()
	end if
End Sub

'============================================================================
' btnSearch_OnClick - 조회
'============================================================================
Sub btnSearch_OnClick()
	edtServiceStatus.caption = ""
	edtEnrollStatus.caption = ""
	edtNickName.caption = "" 
	rdoService.currentindex = -1
	chkLimitAgree.checkstate = "0"
	g_szCheck = "0"
	chkLimitAgree.enable = false
'	btnEnroll.enable = false
	edtNickName.enable = false
	g_bExit = false
	
	g_szOneTimeNo = ""	'고객인증번호
	g_szCertType = ""	'인증유형코드
	
	g_szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID
	g_szMacAddr = Trim(Form.GetSharedData("&MAC_ADDRESS", false ))	'MAC 주소
	
	g_szOneTimeNo = ""
	g_szCertType = ""
	
	TR_Inquiry("obcsb_oimf_638r")
End Sub


'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Label5.caption = "전자금융사기 예방을 위하여 미등록 된 단말에서는 이체 및 공인인증서 발급 등 주요거래가 제한됩니다."	'이용제한에 대한 동의

	Dim szScreenName
	szScreenName = Form.GetOpenLinkData()
	
	if szScreenName == "mbbnk61010" then
		btnSearch_OnClick()
	end if
End Sub


'============================================================================
' btnInform_OnClick - 안내사항 클릭
'============================================================================
Sub btnInform_OnClick()
	Form.OpenPopup("mbonl86010_p1" , "이용단말등록안내" , "")
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_638r" then	'전자금융사기예방 고객조회
		Dim szDsgtCls
		szDsgtCls = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "TERM_DSGT_STPL_YN" , 0)) '단말지정약정여부
		if szDsgtCls == "1" then	'지정단말 only
			edtServiceStatus.caption = "약정 등록"
			rdoService.currentindex = 0
			chkLimitAgree.enable = true
			edtNickName.enable = true
			'btnEnroll.enable = false
		elseif szDsgtCls == "2" then	'지정단말 및 미지정단말 추가인증
			edtServiceStatus.caption = "약정 등록"
			rdoService.currentindex = 1
			chkLimitAgree.enable = false
			edtNickName.enable = true
			'btnEnroll.enable = true
		else								'N 이면 미등록/미약정
			edtServiceStatus.caption = "약정 미등록"
			rdoService.currentindex = -1
			chkLimitAgree.enable = true
			edtNickName.enable = true
			'btnEnroll.enable = false
		end if
		
		if Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "REG_YN" , 0)) == "Y" then
			edtEnrollStatus.caption = "등록단말"
			btnEnroll.caption = "이용단말 변경"
		else
			edtEnrollStatus.caption = "미등록 단말"
			btnEnroll.caption = "이용단말 등록"
		end if
		
		'기존 단말별명취득
		for i=0 to DATAMANAGER.GetDataCount(0, "obcsb_oimf_638r", "OutBlock2")-1
			Dim szTrMac
			szTrMac = Trim(DATAMANAGER.GetDataValue(0,  "obcsb_oimf_638r", "OutBlock2", "MAC_ADDR", i))
				
			if szTrMac == g_szMacAddr then
				if edtEnrollStatus.caption == "등록단말" then
					edtNickName.caption = Trim(DATAMANAGER.GetDataValue(0,  "obcsb_oimf_638r", "OutBlock2", "TERM_NAME", i))
				end if
			end if			
		next	
	end if
	
	if szTranID == "obcsb_oimf_636a" then
'		Dim szMsg
'		
'		szMsg = DATAMANAGER.GetDataMsgText("obcsb_oimf_636a")
		Form.ShowAlert("알림", "이용단말로 등록 처리 되었습니다.")
		Form.SendReturnToParent( "mbonl86010" , "Yes")
		btnSearch_OnClick()
	end if
	
End Sub


'============================================================================
' btnEnroll_OnClick - 등록/변경 버튼
'============================================================================
Sub btnEnroll_OnClick()
	Dim szPhoneName
	szPhoneName = Trim(edtNickName.caption)
	
	if szPhoneName == "" then
		Form.MsgBox("알림", "단말기 별명을 입력하세요.", "", 0)
		exit sub
	end if
	
	
	if rdoService.currentindex <> "0" and rdoService.currentindex <> "1" then
		Form.MsgBox("알림", "이용단말 지정 서비스 방식을 선택하시기 바랍니다.", "", 0)
		exit sub
	end if
	
	'16-03-28 YCJ 시스템개발팀 김인섭 차장님 요청, 2번째 라디오 선택이 체크박스 선택 없이도 다음으로 넘어가야함 (HTS 동일)
	if (chkLimitAgree.checkstate == 0 or chkLimitAgree.checkstate == "0") And rdoService.currentindex == "0" then
		Form.MsgBox("알림", "이용제한 동의를 확인해주세요", "", 0)
		exit sub
	end if
	
	Dim nCnt
	nCnt = GridPro1.rowcount
	g_bExit = false
	
	
	for i = 0 to nCnt -1
	    if Trim(GridPro1.GetCellData( "bd_cell0", i )) = "" then
		    exit for
		end if
    
	    if szPhoneName = Trim(GridPro1.GetCellData( "bd_cell0", i )) then
		    g_bExit = True
	    end if 
	next
	
'	SendReg()		'Test용
	Form.OpenFramePopup("mhetc90060_p8" , "mobile_enroll" , "")

	
End Sub



'============================================================================
'chkLimitAgree_OnChange
'============================================================================
Sub chkLimitAgree_OnChange(sCheckState)
	g_szCheck = sCheckState
	
'	if g_szCheck == "0" then
'		btnEnroll.enable = false
'		
'	elseif g_szCheck == "1" then
'		btnEnroll.enable = true
'	end if
	
End Sub


'============================================================================
'rdoService_OnClick
'============================================================================
Sub rdoService_OnClick(nIndex)
	if nIndex == 0 then
'		if chkLimitAgree.checkstate == "0" then
'			btnEnroll.enable = true
'		else 
'			btnEnroll.enable = false
'		end if
		chkLimitAgree.enable = true
'		btnEnroll.enable = false
	elseif nIndex == 1 then
'		btnEnroll.enable = true
		chkLimitAgree.enable = false
		g_szCheck = "0"
		chkLimitAgree.checkstate = "0"
	end if
End Sub


'============================================================================
' edtNickName_OnEditComplete
'============================================================================
Sub edtNickName_OnEditComplete()
	Dim szLen
	szLen = Form.GetByteLength(edtNickName.caption)
'	if Len(edtNickName.caption) > 20 then
	if CDbl( szLen ) > 20 then
		Form.MsgBox("알림", "한글10자, 영문/숫자 20자까지 입력가능", "keypadok", 0)

	end if
End Sub

'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "keypadok" then		
		if sRet == "close" then
			edtNickName.caption = ""
			'edtNickName.SetShowKeypad( true )
		end if
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p8" then	'추가인증화면 
		if sRet == "ok" then				'추가인증 성공 -> 보안매체조회 및 인증
			g_szCertType = Form.GetSharedData("MobileCertRadio", true )
			if g_szCertType == "4" or g_szCertType == "1" then
				g_szOneTimeNo = Form.GetSharedData("MobileCertNumber", true )
			else 
				g_szOneTimeNo = ""
			end if	
			
			szScrcOtpClsCode = DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0)
			if DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SPLM_ATHN_STPL_YN" , 0) == "Y" then	'추가인증약정여부
				if szScrcOtpClsCode == "0" then	'보안카드
					Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
				elseif szScrcOtpClsCode == "1" then	'부가정보
					Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
				elseif szScrcOtpClsCode == "2" then	'보안매체없음
					'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 이용단말등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
					RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
				elseif szScrcOtpClsCode == "3" then	'OTP
					Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
				elseif szScrcOtpClsCode == "4" then	'mOTP
					Form.OpenPopup( "mhetc90060_motp" , "motp_success" , sPosInfo)		'공인인증서_일반/스마트OTP
				else			'오류
					Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
				end if
			else '추가인증하지 않아도 됨
				Call SendReg()
			end if	
		else		'실패
		
		end if		
	end if
	
	if sKeyName == "mhetc90060_p9" then	'보안카드(보안매체1)
		if sRet == "ok" then			'성공
			Call SendReg()	'이용단말등록
'			Form.OpenFramePopup("mhetc90060_p5" , "" , "")			
		else 					'실패
			exit sub
		end if	
	end if
	
	
	if sKeyName == "mhetc90060_pa" then	'부가정보인증
		if sRet == "ok" then			'성공
			Call SendReg()	'이용단말등록
'			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else 					'실패
			exit sub
		end if
	end if
	
	
	if sKeyName == "mhetc90060_pb" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
			Call SendReg()	'이용단말등록
'			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else						'실패		
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_motp" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
			Call SendReg()	'이용단말등록
'			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else						'실패		
			exit sub
		end if	
	end if
	
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
'	if sKeyName == "mhetc90190_p1" then										
'		'if sRet == "ok" then									
'		'end if
'	end if 	
End Sub


