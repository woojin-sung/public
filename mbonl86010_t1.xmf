'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obcsb_oimf_636a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_636a" )
		Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
	end if
	
End Sub

