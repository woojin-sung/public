'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	g_szLinkData = sParam
	
'	Form.ShowAlert("", sParam)
	if sEventName == "Forminit" then
		g_szList = Split(g_szLinkData , "|")
'		Form.ShowAlert("TriggerEvent_Init1", g_szLinkData)

'		g_szList(0)  '순번
'		g_szList(1)  '전체 개수
'		g_szList(2)  '조회구분   1:전체조회, 2:성향맞춤
'		g_szList(3)  '조회우선순위
'		g_szList(4)  '일련번호
'		g_szList(5)  '상품유형코드		  09:채권(장내)  12:단기사채  99:채권(장외)
'		g_szList(6)  '투자대상유형코드    13:장외채권 46:단기사채(발행물) 20:단기사채(유통물)
'		g_szList(7)  '종목코드
'		g_szList(8)  '종목명
'		g_szList(9)  '매수수익률
'		g_szList(10) '상품추천상세내용
'		g_szList(11) '계좌번호
'		g_szList(12) '계좌 seq
'		g_szList(13) '비번
'		g_szList(14) '전문투자자 여부
'		g_szList(15) '전문투자자 만료 여부
'		g_szList(16) '고객구분코드(2:법인)		
'		g_szList(17)  '17 KYC상품등급코드	
'		g_szList(18)	'18 장외)신용등급
'		g_szList(19)	'19 장외)채권분류명
'		g_szList(20)	'20 장외)잔존일수
'		g_szList(21)	'21 장외)표면이자율
'		g_szList(22)	'22 장외)매매단가
'		g_szList(23)	'23 단기사채)투자기간
'		g_szList(24)	'24 단기사채)만기일
'		g_szList(25)	'25 단기사채)가능수량

'		Form.ShowAlert("", UBound(g_szList))
'		if UBound(g_szList) > 0 then
'		Form.ShowAlert("", #g_szList)

		if #g_szList > 0 then
			g_szSymbolCode = g_szList(7)
			g_szQryType = g_szList(2)
			g_szSymbolType = g_szList(5)
			g_szAccount = g_szList(11)
			g_CUST_CLS_CODE = g_szList(16)

			'2024.05.02 항목 추가------------------------------
			if g_szSymbolType = "12" then	'12:단기사채 
				g_szBadge1 = g_szList(17)
				g_szBadge2 = g_szList(18)
				g_szBadge3 = ""
				
'				'투자기간 : 00년000일 포맷으로 변경.
'				iYear = CInt(CInt(g_szList(23)) / 365)
'				if iYear >= 1 then
'					szValue = iYear & "년 " & (CInt(g_szList(23)) - (iYear * 365)) & "일"
'				else
'					szValue = CInt(g_szList(23)) & "일"
'				end if 
				g_szInfo1 = "투자기간 " .. Cint(g_szList(23)) .. "일"	'투자일수(투자기간)
				g_szInfo2 = "만기일 " .. Mid(g_szList(24),3,2) .."."..Mid(g_szList(24),5,2).."."..Right(g_szList(24),2)	'만기일자(만기일)
				
'				g_szInfo1 = "투자기간 : " .. Cint(g_szList(23)) .. "일"	'투자일수(투자기간)
'				g_szInfo2 = "만기일 : " .. Mid(g_szList(24),3,2) .."."..Mid(g_szList(24),5,2).."."..Right(g_szList(24),2)	'만기일자(만기일)
				if Clng(g_szList(25))/100000000 >= 1 then	
					g_szInfo3 = "가능수량 " .. Int(Clng(g_szList(25))/100000000, 0) .. "억"	'잔여원화금액(가능수량)
'					g_szInfo3 = "가능수량 : " .. Int(Clng(g_szList(25))/100000000, 0) .. "억"	'잔여원화금액(가능수량)
				else
					g_szInfo3 = "SOLD OUT"
				end if
				
				' $로 구분해서 줄바꿈..
				if InStr(g_szList(10), "$") <> 0 Then
					g_szInfo4 = Replace(g_szList(10), "$", "\n")
				else
					g_szInfo4 = g_szList(10)
				end if
				
			else		 '99:채권(장외)
			
				g_szBadge1 = g_szList(17)
				if (g_szList(18) == "" or g_szList(18) == null) and (trim(g_szList(19)) == "국채" or trim(g_szList(19)) == "지방채") then
					g_szBadge2 = "국공채"
				else
					g_szBadge2 = g_szList(18)
				end if
				g_szBadge3 = g_szList(19)	
				g_szInfo1 = "투자기간 " .. Cint(g_szList(20),0) .. "일"	'잔존일수(투자기간)
				g_szInfo2 = "표면금리 " .. FormatNumber(round(g_szList(21),3),3) .."%"	'표면이자율(표면금리)
				g_szInfo3 = "매수단가 " .. FormatNumber(g_szList(22),0) .."원"	'매매단가(매수단가)
				
'				g_szInfo1 = "투자기간 : " .. Cint(g_szList(20),0) .. "일"	'잔존일수(투자기간)
'				g_szInfo2 = "표면금리 : " .. FormatNumber(round(g_szList(21),3),3) .."%"	'표면이자율(표면금리)
'				g_szInfo3 = "매수단가 : " .. FormatNumber(g_szList(22),0) .."원"	'매매단가(매수단가)
'				
				' $로 구분해서 줄바꿈..
				if InStr(g_szList(10), "$") <> 0 Then
					g_szInfo4 = Replace(g_szList(10), "$", "\n")
				else
					g_szInfo4 = g_szList(10)
				end if
				
			end if
			'2024.05.02 항목 추가------------------------------
			
			
'			Form.ShowAlert("TriggerEvent_Init1", g_szSymbolType)
			
'			'상품 유형에 따라 배경색 다르게
'			if g_szSymbolType == "09" then
''				Form.ShowAlert("TriggerEvent_Init1", g_szSymbolType)
'				cont0.imgBg.imgpath = "img_bground_358_359_10"
'			elseif g_szSymbolType == "12" then
''				Form.ShowAlert("TriggerEvent_Init2", g_szSymbolType)
'				cont0.imgBg.imgpath = "img_bground_335_336_10"
'			else
'				cont0.imgBg.imgpath = "img_bground_360_361_10"
'			end if
			
			'순서에 따라 배경색 다르게
'			Form.ShowAlert(CInt(g_szList(0)), CInt(g_szList(0)) % 4)
			select case CInt(CInt(g_szList(0)) % 4)
				case 1	cont0.imgBg.imgpath = "img_bgbox_red.9.png"
				case 2	cont0.imgBg.imgpath = "img_bgbox_yellow.9.png"
				case 3	cont0.imgBg.imgpath = "img_bgbox_green.9.png"
				case 0	cont0.imgBg.imgpath = "img_bgbox_blue.9.png"
			end select
			
			cont0.lblPage.caption = g_szList(0) & "/" & g_szList(1)
'			Form.ShowAlert("TriggerEvent_Init3", cont0.lblPage.caption)
			
			'2024.04.24 상품별 뱃지 추가 ------------------------------------------------------			
			'상품등급 badge_1
			if g_szBadge1 = "01" then
				cont0.imgBadge1.imgpath = "img_bgsquare_grade_372.png"
				cont0.lblBadge1.caption = "매우높은위험"	
				cont0.lblBadge1.fgcolor = 273
			elseif g_szBadge1 = "02" then
				cont0.imgBadge1.imgpath = "img_bgsquare_grade_373.png"
				cont0.lblBadge1.caption = "높은위험"	
				cont0.lblBadge1.fgcolor = 144
			elseif g_szBadge1 = "03" then
				cont0.imgBadge1.imgpath = "img_bgsquare_grade_374.png"
				cont0.lblBadge1.caption = "다소높은위험"
				cont0.lblBadge1.fgcolor = 144
			elseif g_szBadge1 = "04" then
				cont0.imgBadge1.imgpath = "img_bgsquare_grade_375.png"
				cont0.lblBadge1.caption = "보통위험"
				cont0.lblBadge1.fgcolor = 144
			elseif g_szBadge1 = "05" then
				cont0.imgBadge1.imgpath = "img_bgsquare_grade_376.png"
				cont0.lblBadge1.caption = "낮은위험"	
				cont0.lblBadge1.fgcolor = 144
			elseif g_szBadge1 = "06" then
				cont0.imgBadge1.imgpath = "img_bgsquare_grade_377.png"
				cont0.lblBadge1.caption = "매우낮은위험"	
				cont0.lblBadge1.fgcolor = 273
			end if		
				
			'badge_2 신용등급
			cont0.imgBadge2.imgpath = "img_bgsquare_grade_316.png"
			cont0.lblBadge2.caption = g_szBadge2
			
			'badge_3 채권분류
			if Trim(g_szBadge3) = "" then
				cont0.imgBadge3.visible = false
				cont0.lblBadge3.visible = false
			else
				cont0.imgBadge3.visible = true
				cont0.lblBadge3.visible = true
				cont0.imgBadge3.imgpath = "img_bgsquare_grade_363.png"
				cont0.lblBadge3.caption = g_szBadge3
			end if
			'2024.04.24 상품별 뱃지 추가 ------------------------------------------------------


			
			'종목명
'			szValue = Replace(g_szList(8), " ", "\n")
			cont0.lblSymbol.caption = g_szList(8)
	'		cont0.tblSymbol.SetCellString(0, 0, szValue)	 '종목명		
	
	'		cont0.tblSymbol.SetCellString(1, 0, g_szList(5))	
			cont0.tblSymbol.SetCellString(1, 2, FormatNumber(CDbl(g_szList(9)), 3))
'			cont0.tblSymbol.SetCellString(3, 0, Replace(g_szList(10), ",", " "))
						
			'2024.04.24 항목 추가----------------
			cont0.tblSymbol.SetCellString(3, 0, g_szInfo1)	'투자기간
			cont0.tblSymbol.SetCellString(3, 1, g_szInfo2)	'표면금리 or 만기일
			cont0.tblSymbol.SetCellString(3, 2, g_szInfo3)	'매수단가 or 가능수량
			cont0.lblEtc.caption = g_szInfo4
'			cont0.tblSymbol.SetCellString(5, 0, g_szInfo4)	'해당종목의 코멘트??			
			'2024.04.24 항목 추가----------------
			
			
	'		Form.ShowAlert("TriggerEvent_Init2", g_szSymbolCode)
			
			'단기사채일 경우 추가 정보 요청
			if g_szSymbolType == "12" then
'				Form.ShowAlert("Trigger_" & sEventName, g_szSymbolType)
				DATAMANAGER.RequestTranData( "obsab_deal_609r" )
			end if
		end if
		
	end if
	
End Sub

'============================================================================
Sub cont0_btnSearch_OnClick()
	Dim szData
	
'	Form.ShowAlert("btnSearch_OnClick", g_szSymbolType)
	
	if g_CUST_CLS_CODE == "2" then
		Form.ShowAlert("알림", "법인은 신청이 불가합니다.")
		Exit Sub
	end if
	
	if g_szSymbolType == "09" or g_szSymbolType == "99" then      '채권일 경우
		
		szData = g_szSymbolCode & "|" &		'종목코드
				g_szList(11) & "|" &		'계좌번호
				g_szList(12) & "|" &		'계좌seq
				g_szList(13) & "|" &		'계좌비번
				g_szList(14) & "|" &		'전문투자자여부
			     g_szList(15)				'전문투자자 만료여부
			     
		Form.OpenPopup("mbonl90201_s1", szData , "")
				
	elseif g_szSymbolType == "12" then  '단기사채일 경우
		szData = ""
		
		szParam0 	= g_szAccount				'계좌번호
		szParam1 	= g_szList(12)			'계좌순번
		szParam2 	= g_SymbolData[0]			'종목코드
		szParam3 	= g_SymbolData[1]			'종목한글명
		szParam4 	= g_SymbolData[13]		'모집종료일자
		szParam5 	= ""						'모집마감시간 (사용안함)
		szParam6 	= g_SymbolData[17]		'투자일수
		szParam7 	= g_SymbolData[7]			'일반이자율
		szParam8 	= g_SymbolData[5]			'만기일자
		'szParam9 	= g_SymbolData[2]	  		'상품등급코드
		szParam10 	= g_SymbolData[3]			'신용등급코드
		szParam11 	= g_SymbolData[8]			'잔여원화금액
		szParam12 	= g_SymbolData[9]			'총주문한도금액
		szParam13 	= g_SymbolData[4]			'발행일자
		szParam14 	= g_SymbolData[11]		'투자대상유형코드
		szParam15 	= g_SymbolData[20]		'홈페이지첨부파일경로명(MTS사용)  HMPG_ATCH_FILE_PATH_NAME
		szParam16 	= g_SymbolData[21]		'홈페이지평가파일경로명(MTS사용)  HMPG_ATCH_FILE_PATH_NAME1
		szParam17 	= g_SymbolData[19]		'투자가능금액   INVT_ABLE_AMT
		                              
		szParam18	= "%"					'투자대상유형코드
		szParam19	= "1"					'조회구분코드
		szParam20	= g_szQryType				'대상구분코드
	                                  			
		szParam21 	= g_SymbolData[12]		'모집시작일자
		szParam22 	= ""  					'모집시작시간 (사용안함)
	                                  			
		szParam23 	= g_SymbolData[15]		'단기사채등록구분코드(1:발행물/2:유통물
		szParam24 	= g_SymbolData[16]		'신용보강회사명(타행물인 경우에만)
		szParam25 	= g_SymbolData[18]		'현재일자(타행물인 경우 매수일)   PSNT_DATE

		g_tmpsRiskGrade = g_SymbolData[2] 
		'상품등급코드
		if g_tmpsRiskGrade = "01" Then
			szParam9 	= "매우높은위험" 		
		elseif g_tmpsRiskGrade = "02" then
			szParam9 	= "높은위험" 	
		elseif g_tmpsRiskGrade = "03" then
			szParam9 	= "다소높은위험" 	
		elseif g_tmpsRiskGrade = "04" then
			szParam9 	= "보통위험" 	
		elseif g_tmpsRiskGrade = "05" then
			szParam9 	= "낮은위험" 	
		elseif g_tmpsRiskGrade = "06" then
			szParam9 	= "매우낮은위험" 	
		end if

		szParam3 = Replace(szParam3, " ", "\n")
		szData = szParam0 & "★" & szParam1 & "★" & szParam2 & "★" & szParam3 & "★" & szParam4 & "★" &
				szParam5 & "★" & szParam6 & "★" & szParam7 & "★" & szParam8 & "★" & szParam9 & "★" & 
				szParam10 & "★" &szParam11 & "★" & szParam12 & "★" & szParam13 & "★" & szParam14 & "★" & 
				szParam15 & "★" & szParam16 & "★" & szParam17 & "★" & szParam18 & "★" & szParam19 & "★" & 
				szParam20 & "★" & szParam21 & "★" & szParam22 & "★" & szParam23 & "★" & szParam24 & "★" & szParam25
	
	
		Form.OpenPopup("mbonl88060_p1" , szData , "")
	
	end if 
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)	
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , "mbonl90001_b1("..szTranID..")\n" .. szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , "mbonl90001_b1("..szTranID..")\n" .. szErrCode .. " : ".. szErrMsg)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szUserID
	
	if szTranID == "obsab_deal_609r" then 
		'고객ID
		szUserID = Form.GetSharedData("&USER_ID", false )
	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID",	0, szUserID)
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",		0, "")
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",		0, "")
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD",	0, "")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD",		0, g_szSymbolCode)
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obsab_deal_609r" then
		szValue = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD",	0)
'		Form.ShowAlert("TranComplete_" & szTranID, szValue)
		
		g_SymbolData = {}
		
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD",					0))	'0 종목코드
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KOR_ISNM",				0))	'1 한글종목명
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_PROD_GRAD_CODE",		0))	'2 KYC상품등급코드
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CRDT_GRAD",				0))	'3 신용등급
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PBLC_DATE",				0))	'4 발행일자
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MTRT_DATE",				0))	'5 만기일자
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ESBD_STND_DYNU_CLCD",		0))	'6 전자단기사채기준일수구분코드
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "GNRL_INTRT",				0))	'7 일반이자율
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RMNN_WNCR_AMT",			0))	'8 잔여원화금액
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TOTAL_ODER_LIMT_AMT",		0))	'9 총주문한도금액
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TOTAL_BYOV_APLT_AMT",		0))	'10 총매수신청금액
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INVT_TRGT_TYPE_CODE",		0))	'11 투자대상유형코드
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RCRT_STA_DATE",			0))	'12 모집시작일자
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RCRT_FIN_DATE",			0))	'13 모집종료일자
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FNCD",					0))	'14 펀드코드
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SHTR_BOND_REG_CLS_CODE",	0))	'15 단기사채등록구분코드
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CREN_CO_NAME",			0))	'16 신용보강회사명
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INVT_DYNU",				0))	'17 투자일수
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PSNT_DATE",				0))	'18 현재일자
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INVT_ABLE_AMT",			0))	'19 투자가능금액
		
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "ATCH_FILE_PATH_NAME",		0))	'20 첨부파일경로명  투자설명서
		
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "ATCH_FILE_PATH_NAME",		1))	'21 첨부파일경로명  신용평가서
	
	end if
	
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl90201_s1" then
		'투자성향 미등록인 경우 투자성향 재진단 연결
		if sRet == "MOVE" then
			'투자성향재진단 화면 연결
			Form.OpenScreen("81010", "")
			Form.CloseForm()
			
		end if
	
	elseif sKeyName == "mbonl88060_p1" then	
		'투자성향 미등록인 경우 투자성향 재진단 연결
		if sRet == "MOVE" then
			'투자성향재진단 화면 연결
			Form.OpenScreen("81010", "")
			Form.CloseForm()
		end if
		
	end if
End Sub

