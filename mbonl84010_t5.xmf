			<TRAN name="obcsb_efif_021r" title="HTS사용등록계좌정보조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="228" _ulen="172" >

IQRY_CLS_CODE^조회구분코드^1^0^0^0^0^0^0
