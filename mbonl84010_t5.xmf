'============================================================================
' 01.화면명 	: 온라인계좌개설
' 02.화면설명	: 온라인계좌개설_CMA매매계좌개설완료
' 03.작성	: 2016.01.14
'====== [Modify] ============================================================
' 2016.06.27 : 정민영 : obaci_acct_003c IO 변경분 적용 및 발행어음 매수단위등록 popup 연계 v0001
' 2020.09.16 : 권오상 : v002 : T2008250015 : 메모리평문 취약점 수정
' 2020.11.10 : 정민영 : v002 보완
' 2020.11.13 : 정민영 : v003 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obaci_acct_003c,obcsb_efif_021r IO 변경분 반영
' 2021.05.26 : 김수진 : obaci_acct_003c IO 변경분 적용 v0001 PROS_DATE, PROS_SRNO
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szAccNo
dim	g_szPassword
dim  g_szUserID			'사용자 id
dim	g_szBRCODE			'for obaci_acct_003c.BRCODE
dim	g_szMangCD
dim	g_szSect			'0종금형	1증권형
dim	g_szDVPDCode		'Form.GetSharedData("ONLINE_DVPDCODE" , 0 )		'파생상품유의코드
dim	g_szAlertTitle
Dim	g_PlainRm 'v002

g_szAlertTitle	=	"알림"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	'g_szPassword = "1357"		'임시세팅
	'g_szAccNo = "30076961"		'임시세팅
	'g_szUserID = "chikoo81"		'임시세팅
	
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v002

	g_szUserID = Form.GetSharedData("&USER_ID", 0)
	DATAMANAGER.RequestTranData("obcsb_efif_021r")
	
	g_szAccNo 		= 	Form.GetSharedData("ONLINE_ACNT", 0)
'	g_szPassword 	= 	Form.GetSharedData("ONLINE_PSWD", 0) 'v002
	g_szDVPDCode	=	Form.GetSharedData("ONLINE_DVPDCODE" , 0 )	
	
	'v002 평문적용/미적용에 따라 앞 화면(mbonl84010_t4)에서 암호화/비암호화 비밀번호로 넘어옴
	'If g_PlainRm = "1" Then '보안모듈 적용
		g_szPassword 	= 	Form.GetSharedData("ONLINE_PSWD", 0)
	'Else
	'	g_szPassword 	= 	Form.GetEncData(Form.GetSharedData("ONLINE_PSWD", 0))
	'End If

	tbl01.SetCellString(1, 1, left(g_szAccNo,4) & "-" & mid(g_szAccNo,5,4))
	'edtAcc01.caption = left(g_szAccNo,4) & "-" & mid(g_szAccNo,5,4)
End Sub

'============================================================================
'btnPrv01_OnClick
'============================================================================
Sub btnPrv01_OnClick()
	Form.triggerEvent("#", "OPENACC_MAIN", "3")
End Sub

'============================================================================
'btnNext01_OnClick
'============================================================================
Sub btnNext01_OnClick()
	'분기에 따라 dept_006혹은 acct003c로 간다
	if	g_szSect	=	"0"	then		'종금형
		DATAMANAGER.RequestTranData("obcpp_dept_006r")
	else
		DATAMANAGER.RequestTranData("obaci_acct_003c")
	end if
End Sub

'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID = "obcpp_dept_006r" then
		 DATAMANAGER.SetDataValue(0,"obcpp_dept_006r", "InBlock1", "DPCD", 0, g_szMangCD)
	elseif szTranID = "obaci_acct_003c" then
		'BRCODE HEADER : MRBN_BSWR_HNDL_YN = "N" --> obcsb_efif_021r.MRBN_BSWR_VCEX_BRCD			'''헤더??? DATAMANAGER.SetBranchCode(sTranID,sFlag)
		'BRCODE HEADER : MRBN_BSWR_HNDL_YN = "Y" --> obcsb_efif_021r.MANG_BRCD					'''헤더??? DATAMANAGER.SetBranchCode(sTranID,sFlag)
		
		'ACNO	: 받아오는값
		'ACNT_PWD	: 받아오는값
		'MANG_EMPNO	:	obcpp_dept_006r, 부지점정보조회에서 저장한 "C"+MANG_BRCD  			or	'''증권형일때는?  obcsb_efif_021r에 들어있는 MANG_BRCD
		'MANG_EMPNO	:	obcpp_dept_006r, 부지점정보조회에서 저장한 "C"+MRBN_BSWR_VCEX_BRCD  		'''증권형일때는?
		'ISSU_DETL_DVCD	:	증권형 "06",	종금형 "02"
		'KYC_DVPD_EPMD_CODE	:	투자성향진단시에 받아놓은 KYC파생상품유의코드					'''obcsb_acif_713r? '701r에서 가져온 KYC_CVPD_EMMD_CODE참조
		'KYC_DRVT_PROS_YN	:	투자성향진단시에 받아놓은 KYC파생처리여부						'''obcsb_acif_713r? '종합매매일때는 세팅하지않아도 됨.
		
		'처리일자, 처리일련번호
		Dim sProsDate, sProsSrno 
		sProsDate = Form.GetSharedData( "PROS_DATE", false )
		sProsSrno = Form.GetSharedData( "PROS_SRNO", false )
		
		DATAMANAGER.SetBranchCode("obaci_acct_003c", g_szBRCODE)
		
		DATAMANAGER.SetDataValue(0,"obaci_acct_003c", "InBlock1", "ACNO", 0, g_szAccNo)
'		DATAMANAGER.SetDataValue(0,"obaci_acct_003c", "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPassword))
		DATAMANAGER.SetDataValue(0,"obaci_acct_003c", "InBlock1", "ACNT_PWD", 0, g_szPassword)
		
		DATAMANAGER.SetDataValue(0, "obaci_acct_003c", "InBlock1", "MANG_EMPNO", 0, g_szBRCODE)
		
		if g_szSect	=	"0"		then
			DATAMANAGER.SetDataValue(0,"obaci_acct_003c", "InBlock1", "ISSU_DETL_DVCD", 0, "02")		'종금형 "02"
		else
			DATAMANAGER.SetDataValue(0,"obaci_acct_003c", "InBlock1", "ISSU_DETL_DVCD", 0, "06")		'증권형 "06"
		end if 

		DATAMANAGER.SetDataValue(0,"obaci_acct_003c", "InBlock1", "KYC_DVPD_EPMD_CODE", 0, g_szDVPDCode)		
		'DATAMANAGER.SetDataValue(0,"obaci_acct_003c", "InBlock1", "KYC_DRVT_PROS_YN", 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0,"obaci_acct_003c", "InBlock1", "PROS_DATE", 0, sProsDate)
		DATAMANAGER.SetDataValue(0,"obaci_acct_003c", "InBlock1", "PROS_SRNO", 0, sProsSrno)
	elseif	szTranID = "obcsb_efif_021r"	then
		DATAMANAGER.SetDataValue(0, "obcsb_efif_021r", "InBlock1", "ELFN_ID" , 0, g_szUserID)
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	szAcno
	dim	szAsno
	dim	szAcAs
	
	szAcno	=	""
	szAsno	=	""
	szAcAs	=	""

	'	if 증권형 :	obaci_acct_003c(종합매매개별상품가입)
	'	else		:	obcpp_dept_006r(부지점정보조회)
	
	''''''''''''''''''''''''''
	'"obcsb_efif_021r"
	''''''''''''''''''''''''''
	dim n021Cnt
	dim szAcnt
	
	if szTranID = "obcsb_efif_021r" then
		n021Cnt	=	DATAMANAGER.GetDataCount(0, "obcsb_efif_021r", "OutBlock1")
		
		for i = 0 to n021Cnt -1 
			szAcnt = grdAcnt01.GetCellData("bd_cell1", i)
			if	trim(szAcnt)	=	trim(g_szAccNo)	then
				g_szMangCD = grdAcnt01.GetCellData("bd_cell3", i)
				g_szBRCODE = "C" & g_szMangCD
			end if
		next
	end if 
	
	
	''''''''''''''''''''''''''
	'"obcpp_dept_006r"
	''''''''''''''''''''''''''
	if szTranID = "obcpp_dept_006r" then
		szIsMRBN = DATAMANAGER.GetDataValue(0, "obcpp_dept_006r", "OutBlock1", "MRBN_BSWR_HNDL_YN", 0)
		
		if szIsMRBN = "Y" then
			g_szBRCODE	= "C" & DATAMANAGER.GetDataValue(0, "obcpp_dept_006r", "InBlock1", "DPCD", 0)
		else
			g_szBRCODE =  "C" & DATAMANAGER.GetDataValue(0, "obcpp_dept_006r", "OutBlock1", "MRBN_BSWR_VCEX_BRCD", 0)	
		end if 
		
		DATAMANAGER.RequestTranData("obaci_acct_003c")
	end if 

		
	''''''''''''''''''''''''''
	'"obaci_acct_003c"
	''''''''''''''''''''''''''
	if szTranID = "obaci_acct_003c" then
		szAcno	=	DATAMANAGER.GetDataValue(0,"obaci_acct_003c", "OutBlock1", "ACNO", 0)
		szAsno	=	DATAMANAGER.GetDataValue(0,"obaci_acct_003c", "OutBlock1", "ASNO", 0)
		
		szAcAs	=	left(szAcno,4) & "-" & mid(szAcno,5,4)  & "-" & szAsno

		'정상일때
		'v0001 CMA-RP가 아닌경우, '발행어음매수단위등록' 연계 Popup
		If g_szSect = "0" Then
		    Form.OpenPopup("mbonl84010_p9" , "" , "")
		Else
		    Form.MsgBox("알림", szAcAs & " 온라인 계좌개설이 완료 되었습니다.재로그인하시면, 개설된 계좌를 잔고등 조회시 선택할 수 있습니다." , "OPENACCOK", 6)
		End If
	end if
End Sub


'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if	sEventName	=	"CMASECT"	then
		g_szSect = sParam
		
		if	g_szSect = "0"	then
			tbl01.SetCellString(2,1,  "THE CMA plus")
		else
			tbl01.SetCellString(2,1, "CMA RP")
		end if
	end if 
End Sub

'============================================================================
'Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if	sKeyName	=	"OPENACCOK"	then
		Form.CloseForm()
		Form.triggerEvent("#", "OPENACC_MAIN", "0")
	end if 
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
End Sub


'============================================================================
' v0001
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl84010_p9" then     
		if sRet == "ok" then
			Form.triggerEvent("#", "OPENACC_MAIN", "0")
			Form.CloseForm()
			Form.SetSharedData( "PROS_DATE", "" )
			Form.SetSharedData( "PROS_SRNO", "" )
		end if
	end if
End Sub

