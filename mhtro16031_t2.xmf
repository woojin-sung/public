	<SCRIPT_INFO _len="5579" _ulen="5435" >
'===========================================================================
' 01. 업무구분 : 해외주식
' 02. 화면 :  ETF
' 03. 화면설명 : 
' 04. 작성자 : 정성헌
' 05. 작성일 : 2015.04.27
' 06. 수정이력 :
'===========================================================================

'215`상해
'214`심천
'104`홍콩
'990`미국
'321`뉴욕
'66`아멕스

Dim g_nIndex
Dim szNext
g_nIndex = 0
szNext = ""
Dim sSaveCmb0
'============================================================================
Sub Form_OnFormInit()
	Dim szCombo0
	
	szCombo0 = Form.GetEnvData("16031_T02_COMBO0")
	
	if szCombo0 <> nil and szCombo0 <> "" then
		Combo0.cbkeydata = szCombo0
	end if
	
	'콤보 배경색 : 검정색
	Combo0.bgimagetype = "1" 
	
	DATAMANAGER.RequestTranData( "getPriceListByType" ) 
end Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCmb0
	szCmb0 = Combo0.cbkeydata
	
	if szTranID == "getPriceListByType" then
		DATAMANAGER.SetDataValue( false, szTranID , "inblock" , "codeList" , 0 , "" )  '
		DATAMANAGER.SetDataValue( false, szTranID , "inblock" , "exid" , 0 , szCmb0 )  '거래소
		DATAMANAGER.SetDataValue( false, szTranID , "inblock" , "type" , 0 , "")  '
		DATAMANAGER.SetDataValue( false, szTranID , "inblock" , "regist" , 0 , false )    '
	end if
end Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "getPriceListByType" then
		
		Dim nCount
		nCount    = CInt( DATAMANAGER.GetDataCount( false, szTranID , "priceList" ) )
		nRowCount = Grid0.rowcount
		
		Dim szDecimal
		Dim szMaskFormat
		szDecimal = TransformName_Decimal(Combo0.caption)
		szMaskFormat = "0,0,,,0,,"..szDecimal..",1,0"
		Grid0.SetCellIDMaskInfo( "bd_cell1", szMaskFormat )
		Grid0.SetCellIDMaskInfo( "bd_cell3", szMaskFormat )
		for i=0 to nCount-1
			Grid0.insertrow = nRowCount + i
			Dim nClose
			nClose = CInt( DATAMANAGER.GetDataValue( false, szTranID , "priceList" , "close" , i ) ) '대비
			Dim nChan
			nChan  = CInt( DATAMANAGER.GetDataValue( false, szTranID , "priceList" , "diff" , i ) ) '대비
			
			Dim nRate
			nRate  = nChan/(nClose-nChan)*100
			Grid0.SetCellData( "bd_cell4", nRowCount + i, nRate ) 
			Dim sName, sClose, sDiff, sTotalVol, sTime, sOrgCode, sRealCode
			sName = DATAMANAGER.GetDataValue(false, "getPriceListByType", "priceList", "name" , i)
			sClose = DATAMANAGER.GetDataValue(false, "getPriceListByType", "priceList", "close" , i)
			sDiff = DATAMANAGER.GetDataValue(false, "getPriceListByType", "priceList", "diff" , i)
			sTotalVol = DATAMANAGER.GetDataValue(false, "getPriceListByType", "priceList", "totalVol" , i)
			sTime = DATAMANAGER.GetDataValue(false, "getPriceListByType", "priceList", "time" , i)
			sOrgCode = DATAMANAGER.GetDataValue(false, "getPriceListByType", "priceList", "orgcode" , i)
			sRealCode = DATAMANAGER.GetDataValue(false, "getPriceListByType", "priceList", "realcode" , i)
			Grid0.SetCellData("bd_cell0", nRowCount + i, sName)
			Grid0.SetCellData("bd_cell1", nRowCount + i, sClose)
			Grid0.SetCellData("bd_cell2", nRowCount + i, sDiff)
			Grid0.SetCellData("bd_cell3", nRowCount + i, sDiff)
			Grid0.SetCellData("bd_cell5", nRowCount + i, sTotalVol)
			Grid0.SetCellData("bd_cell6", nRowCount + i, sTime)
			Grid0.SetCellData("bd_cell7", nRowCount + i, sOrgCode)
			Grid0.SetCellData("bd_cell8", nRowCount + i, sRealCode)
			'현재가, 등락률 글자색, 대비부호 셋팅                                     
			if nChan > 0  then
				Grid0.SetCellFgColor( "bd_cell1", nRowCount + i, "1" ) 
				Grid0.SetCellFgColor( "bd_cell3", nRowCount + i, "1" ) 
				Grid0.SetCellFgColor( "bd_cell4", nRowCount + i, "1" ) 
				Grid0.SetCellData( "bd_cell2", nRowCount + i, "2" ) '1
				
			elseif nChan < 0  then
				Grid0.SetCellFgColor( "bd_cell1", nRowCount + i, "2" )
				Grid0.SetCellFgColor( "bd_cell3", nRowCount + i, "2" ) 
				Grid0.SetCellFgColor( "bd_cell4", nRowCount + i, "2" ) 
				Grid0.SetCellData( "bd_cell2", nRowCount + i, "5" ) '3
				
			else
				Grid0.SetCellFgColor( "bd_cell1", nRowCount + i, "3" )
				Grid0.SetCellFgColor( "bd_cell3", nRowCount + i, "3" ) 
				Grid0.SetCellFgColor( "bd_cell4", nRowCount + i, "3" ) 
				Grid0.SetCellData( "bd_cell2", nRowCount + i, "0" ) '5
			end if								
		next
		
		Combo0.cbkeydata = sSaveCmb0
	end if
	
end Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	Dim szComboData
	szComboData = Combo0.cbkeydata
	Form.SetEnvData(1, "16031_T02_COMBO0", szComboData)
	
	g_nIndex = 0
	Grid0.SetClear( )
	DATAMANAGER.RequestTranData( "getPriceListByType" )
	
end Sub

'============================================================================
Sub Form_OnRefresh()
	g_nIndex = 0
	Grid0.SetClear( )
	Combo0.cbkeydata = sSaveCmb0
	DATAMANAGER.RequestTranData( "getPriceListByType" )
end Sub


'============================================================================
Function CInt(data)
	return tonumber(data) or 0
end Function

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

'============================================================================
Sub TransformName_Decimal(sValue)
	Dim sDecimal
	if sValue == "미국" then
		sDecimal = "4"
	else
		sDecimal = "3"
	end if
	return sDecimal
End Sub


