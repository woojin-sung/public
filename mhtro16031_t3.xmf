	<SCRIPT_INFO _len="6798" _ulen="6592" >
'===========================================================================
' 01. 업무구분 : 해외주식
' 02. 화면 : 
' 03. 화면설명 : 
' 04. 작성자 : 
' 05. 작성일 : 
' 06. 수정이력 :
'===========================================================================
Dim g_sNatCd	' 국가구분코드
Dim g_sExCd	' 거래소구분코드
Dim g_rtChk	' 실시간 구분코드 
Dim g_sBstpCd ' 입력 업종 코드 
Dim g_grdCnt	' 그리드 갯수


g_sBstpCd = ""
g_grdCnt = 0

'============================================================================
Sub Form_OnFormInit()
	
	Dim szCombo0
	szCombo0 = Form.GetEnvData("16031_T03_COMBO0")
	
	if szCombo0 <> nil and szCombo0 <> "" then
		Combo0.cbkeydata = szCombo0
	else
		szCombo0 = Combo0.cbkeydata
	end if
	
	g_sExCd = Transform_Exid(szCombo0) 
	g_sNatCd = GetNationGubun(g_sExCd)
	g_rtChk = Form.GetSharedData( "REALTIME_"..g_sExCd, false )
		
	'콤보 배경색 : 검정색
	Combo0.bgimagetype = "1" 
	Combo1.bgimagetype = "1"
	
	DATAMANAGER.RequestTranData("ohhts_6250_010r") 
end Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_6250_010r" then
		DATAMANAGER.SetDataValue( false, "ohhts_6250_010r", "InBlock1", "FIDX_NTNL_CODE" , 0 , g_sNatCd )
		DATAMANAGER.SetDataValue( false, "ohhts_6250_010r", "InBlock1", "FIDX_EXCH_CODE" , 0 , g_sExCd )
		
	elseif szTranID == "ohhts_6250_002r" then
		DATAMANAGER.SetDataValue( false, "ohhts_6250_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" ) 
		DATAMANAGER.SetDataValue( false, "ohhts_6250_002r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "62500" ) '화면번호
		DATAMANAGER.SetDataValue( false, "ohhts_6250_002r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk) 
		DATAMANAGER.SetDataValue( false, "ohhts_6250_002r", "InBlock1", "FIDX_INPUT_NTNL_CODE" , 0 , g_sNatCd) 
		DATAMANAGER.SetDataValue( false, "ohhts_6250_002r", "InBlock1", "FID_INPUT_COND_MRKT_CLS_CODE" , 0 , g_sExCd)
		DATAMANAGER.SetDataValue( false, "ohhts_6250_002r", "InBlock1", "FIDX_INPUT_BSTP_CODE" , 0 , g_sBstpCd) 
		
	end if
end Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "ohhts_6250_010r" then
		Combo1_Setting()
		DATAMANAGER.RequestTranData( "ohhts_6250_002r" ) 
	elseif szTranID == "ohhts_6250_002r" then
		
		nCount    = CInt( DATAMANAGER.GetDataCount( false, "ohhts_6250_002r", "OutBlock1" ) )
	
		For i = 0 To nCount - 1
			Dim sCode
			szNat = DATAMANAGER.GetDataValue(false, "ohhts_6250_002r", "OutBlock1", "FID_COND_MRKT_CLS_CODE" , i)
			szIsCd = DATAMANAGER.GetDataValue(false, "ohhts_6250_002r", "OutBlock1", "FIDX_ISCD" , i)
			sCode = szNat.."@"..szIsCd
			Grid0.SetCellData("bd_cell11", g_grdCnt + i, sCode)
			DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , i , sCode )
			
		Next
			g_grdCnt = Grid0.rowcount
			Grid0.keyall = "1"
			DATAMANAGER.RequestRealData( "ohhts_exst_ictg" )
		
		
	end if
	
end Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	Dim szComboData
	szComboData = Combo0.cbkeydata
	
	g_sExCd = Transform_Exid(szComboData) 
	g_sNatCd = GetNationGubun(g_sExCd)
	g_rtChk = Form.GetSharedData( "REALTIME_"..g_sExCd, false )
	
	Form.SetEnvData(1, "16031_T03_COMBO0", szComboData)
	Grid0.SetClear( )
	g_grdCnt = 0
	DATAMANAGER.RequestTranData("ohhts_6250_010r") 
end Sub

'============================================================================
Sub Combo1_OnEditComplete(iIndex)		
	Dim szComboData
	g_sBstpCd = Combo1.cbkeydata
	Form.SetEnvData(1, "16031_T03_COMBO1", g_sBstpCd)
	Grid0.SetClear()
	g_grdCnt = 0
	DATAMANAGER.RequestTranData( "ohhts_6250_002r" ) 
	
end Sub

'============================================================================
Sub Form_OnRefresh()
	szCombo0 = Form.GetEnvData("16031_T03_COMBO0")
	if szCombo0 <> nil and szCombo0 <> "" then
		Combo0.cbkeydata = szCombo0
	end if
	
	Grid0.SetClear()
	g_grdCnt = 0
	DATAMANAGER.RequestTranData("ohhts_6250_010r") 
	
end Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "ohhts_6250_002r" ) then
		DATAMANAGER.RequestNextData( "ohhts_6250_002r" )
	end if
end Sub


'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	
	Dim sCode, sSymbol, sKorName, sExid

	sSymbol	= Grid0.GetCellData( "bd_cell7", lRow )
	sKorname	= Grid0.GetCellData( "bd_cell0", lRow )
	sExid	= Grid0.GetCellData( "bd_cell4", lRow ) 
	
	if sExid ~= "" then
		sCode = sExid.."@"..sSymbol
		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", sCode.."★"..sKorName.."★".."", "" )
		Form.OpenScreen("16000", "")		
	end if
end Sub


'============================================================================
Function Transform_Exid(sValue)
	if sValue == "0537" then ' 나스닥
		return "OQ"
	elseif sValue == "0321" then ' 뉴욕
		return "NY"
	elseif sValue == "0066" then ' 아멕스
		return "AX"
	elseif sValue == "0215" then ' 상해
		return "SH"
	elseif sValue == "0214" then ' 심천
		return "SZ"
	elseif sValue == "0104" then ' 홍콩
		return "HK"
	elseif sValue == "0106" then ' 일본
		return "JP"
	end if
end Function

'============================================================================
Function GetNationGubun(sValue)
	if sValue == "HK" then	' 홍콩
		return "HK"
	elseif sValue == "SH" or sValue == "SZ" then ' 상해, 심천거래소 종목
		return "CN"
	elseif sValue == "OQ" or sValue == "AX" or sValue == "NY" then 
		return "US"
	elseif sValue == "JP" then 
		return "JP"
	else
		return false
	end if
end Function


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

'============================================================================
Function Combo1_Setting()
			
	Dim nCount
	nCount = CInt(DATAMANAGER.GetDataCount( false, "ohhts_6250_010r", "OutBlock1" )) '데이터 개수

	Combo1.clear = true
	Combo1.cbadddatatext = "`전체"

	Dim szClsCd , szDivNm
	for i = 0 to nCount -1
		szClsCd = DATAMANAGER.GetDataValue(false, "ohhts_6250_010r", "OutBlock1", "FIDX_BSTP_CLS_CODE" , i)
		szDivNm = DATAMANAGER.GetDataValue(false, "ohhts_6250_010r", "OutBlock1", "FIDX_BSTP_DIV_NAME" , i)
		Combo1.cbadddatatext = szClsCd.."`"..szDivNm
	next
	
	szCombo1 = Form.GetEnvData("16031_T03_COMBO1")
	if szCombo1 <> nil and szCombo1 <> "" then
		Combo1.cbkeydata = szCombo1
		g_sBstpCd = szCombo1
	end if
	
End Function 

