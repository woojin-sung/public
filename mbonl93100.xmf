'============================================================================
' 2024.03.05 : 고승연 : v0002 : obaci_acct_132r IO 수정
'============================================================================

Sub Form_OnFormInit()

    f_ClearData()
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	
	
    If szTranID == "obaci_acct_132r" Then
    
        szAcntClcd = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACNT_CLS_CODE" , 0)
        If Trim(szAcntClcd) == "3" Or Trim(szAcntClcd) == "A" Then
            cont0.tblData1.SetCellString(7, 1, "주택거래차액납입계좌")
        ElseIf Trim(szAcntClcd) == "2" Then
            cont0.tblData1.SetCellString(7, 1, "이수전용계좌")
        Else
            cont0.tblData1.SetCellString(7, 1, "일반계좌")
        End If	
        
    End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

    szAcno = Mid(acnt.caption,1,8)
    szAsno = Mid(acnt.caption,9,2)
	
	If szTranID == "obaci_acct_132r" Then '신연금저축가입정보조회
	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"          , 0 , szAcno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO"          , 0 , szAsno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD"      , 0 , ""    )
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "PRTX_VLTN_AMT" , 0 , 0)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "PRLS_AMT"      , 0 , 0)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "TFAM"          , 0 , 0)
		
    End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    Form.MsgBox("오류" , szErrMsg , "" , 6)
End Sub

'============================================================================
Sub acnt_ChangeAccount()
    f_ClearData()	
End Sub

'============================================================================
Sub edtPwd_OnEditComplete() '계좌비밀번호 입력 성공시
    DATAMANAGER.RequestTranData("obaci_acct_132r") '신연금저축가입정보조회
End Sub

'============================================================================
Sub cont0_btnToolTip1_OnClick()

	cont0.contTooltip.top = 442
	szText = "납입원금 = 총납입누적금액 - 총누적인출금액"
	cont0.contTooltip.tblText.SetCellString(0, 0, szText)
	cont0.contTooltip.visible = True
	cont0.btnAlpha.visible    = True
	
End Sub

'============================================================================
Sub cont0_btnToolTip2_OnClick()

	cont0.contTooltip.top = 480
	szText = "손익금액 = 평가금액(세전) - 납입원금"
	cont0.contTooltip.tblText.SetCellString(0, 0, szText)	
	cont0.contTooltip.visible = True
	cont0.btnAlpha.visible    = True
	
End Sub

'============================================================================
Sub cont0_btnAlpha_OnClick()

	cont0.contTooltip.visible = False
	cont0.btnAlpha.visible    = False
	
End Sub

'============================================================================
Function f_ClearData()

    cont0.contTooltip.visible = False
    cont0.btnAlpha.visible    = False
	
    '화면 내 테이블 초기화
    cont0.tblData1.SetCellString(0 , 1 , "")
    cont0.tblData1.SetCellString(1 , 1 , "")
    cont0.tblData1.SetCellString(2 , 1 , "")
    cont0.tblData1.SetCellString(3 , 1 , "")
    cont0.tblData1.SetCellString(4 , 1 , "")
    cont0.tblData1.SetCellString(5 , 1 , "")
    cont0.tblData1.SetCellString(6 , 1 , "")
    cont0.tblData1.SetCellString(7 , 1 , "")	
    cont0.tblData1.SetCellString(8 , 1 , "")
	
    cont0.tblData2.SetCellString(0 , 1 , "")
    cont0.tblData2.SetCellString(1 , 1 , "")
    cont0.tblData2.SetCellString(2 , 1 , "")
    cont0.tblData2.SetCellString(3 , 1 , "")
    cont0.tblData2.SetCellString(4 , 1 , "")
	
    cont0.tblData3.SetCellString(0 , 1 , "")
    cont0.tblData3.SetCellString(1 , 1 , "")
    cont0.tblData3.SetCellString(2 , 1 , "")
    cont0.tblData3.SetCellString(3 , 1 , "")
	
    cont0.tblData4.SetCellString(0 , 1 , "")
    cont0.tblData4.SetCellString(1 , 1 , "")
    cont0.tblData4.SetCellString(2 , 1 , "")
    
End Function

