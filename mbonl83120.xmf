'===========================================================================
' 01. 화 면 명 : 공모주 자동 대체 약정(환불금 입금, 공모주 입고)
' 02. 화면설명 : 공모주 자동대체약정 서비스 폼탭
' 03. 작    성 : 2016.11.09 : 윤유정
' 04. 수    정 : 2020. 09. 16. 성주혁 MTS 메모리 보안 v0001
'===========================================================================
'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szData  '계좌번호 & 비밀번호
Dim g_Acno    '계좌번호
Dim g_TabType '폼탭
Dim g_szCSNO  '고객번호
Dim g_Asno	 '계좌일련번호
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
'TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)
	if szTranID == "obpds_srvc_070r" then	'약정고객정보조회
		DATAMANAGER.SetDataValue(0,"obpds_srvc_070r", "InBlock1", "ACNO"  , 0 , acnt0.total)
		DATAMANAGER.RequestTranData("obpds_srvc_070r")
	elseif szTranID == "obacp_opop_066r" then
	
		'v0001
		'AS-IS
		'sACNT_PWD = Form.GetEncData(edtPW.caption)
		
		'TO-BE
		if plain_rm =="1" then
			sACNT_PWD = edtPW.caption
		else
			sACNT_PWD = Form.GetEncData(edtPW.caption)
		end if

		DATAMANAGER.SetDataValue( 0, "obacp_opop_066r", "InBlock1", "ACNO" , 0 , acnt0.total )
		DATAMANAGER.SetDataValue( 0, "obacp_opop_066r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		DATAMANAGER.RequestTranData("obacp_opop_066r")
	
	end if
	
	
End Function
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obpds_srvc_070r" then	'약정고객정보조회
		g_szCSNO = DATAMANAGER.GetDataValue(0, "obpds_srvc_070r", "OutBlock1", "CSNO" , 0)
		Form.SetSharedData("CSNO_83130" , g_szCSNO)
	elseif szTranID == "obacp_opop_066r" then
'		g_szData = acnt0.total & "★" & edtPW.caption & "★" & "No"			'계좌번호 & 비밀번호
'	
'		if edtPW.caption == "" or edtPW.caption == Null then
'			szData = acnt0.total & "★" & "" & "★" & "No"			'계좌번호 & 비밀번호
'			
'		end if
'		
'		g_TabType = CInt(FormTab0.currenttab)
'		
'		if g_TabType == 0 then
'			Form.SetSharedData("ASNO_83130" , acnt0.sequence)
'			Form.triggerEvent( "FormTab0." & FormTab0.currenttabpageid, "환불금입금", g_szData)
'		elseif g_TabType == 1 then
'			Form.triggerEvent( "FormTab0." & FormTab0.currenttabpageid, "공모주입고", g_szData)
'		end if
		
		g_szData = acnt0.total & "★" & edtPW.caption  '계좌번호 & 비밀번호
		g_TabType = CInt(FormTab0.currenttab)
		
		if g_TabType == 0 then
			Form.SetSharedData("ASNO_83130" , acnt0.sequence)
			Form.triggerEvent( "FormTab0." & FormTab0.currenttabpageid, "환불금입금", g_szData)
		elseif g_TabType == 1 then
			Form.SetSharedData("ASNO_83130" , acnt0.sequence)
			Form.triggerEvent( "FormTab0." & FormTab0.currenttabpageid, "공모주입고", g_szData)
		end if
		
		'edtPW.caption = ""
		
		
		Form.SetSharedData("CSNO_83130" , g_szCSNO)
	end if
End Sub
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	'Form.SetScreenName("공모주 자동 대체 약정")
	Form.SetTitleCaption("공모주 자동 대체 약정")

	'v0001
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용 / 1 : 적용 )
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )

	TR_Inquiry("obpds_srvc_070r")

	edtPW.caption = ""
	g_szData = acnt0.total & "★" & ""
	FormTab0.currenttab = "0"	
	g_TabType = CInt(FormTab0.currenttab)
	
	if g_TabType == 0 then
	   Form.SetSharedData("ASNO_83130" , acnt0.sequence)
	   Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "환불금입금", g_szData)
	else
	   Form.SetSharedData("ASNO_83130" , acnt0.sequence)
	   Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "공모주입고", g_szData) 
	end if   
End Sub
'============================================================================
' FormTab0_OnTabChanged - 탭 변경할 때 조회
'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	
	'edtPW.caption = ""
	g_szData = acnt0.total & "★" & edtPW.caption
	g_TabType = CInt(FormTab0.currenttab)
	
	if g_TabType == 0 then
		Form.SetSharedData("ASNO_83130" , acnt0.sequence)
		Form.triggerEvent( "FormTab0." & FormTab0.currenttabpageid, "환불금입금", g_szData)
	elseif g_TabType == 1 then
		Form.SetSharedData("ASNO_83130" , acnt0.sequence)
		Form.triggerEvent( "FormTab0." & FormTab0.currenttabpageid, "공모주입고", g_szData)
	end if
	
	'edtPW.caption = ""
End Sub
'============================================================================
' edtPW_OnEditComplete()
'============================================================================
Sub edtPW_OnEditComplete()
	if edtPW.caption ~= null then
		TR_Inquiry( "obacp_opop_066r" ) '비밀번호검증
	end if
End Sub
'============================================================================
Sub acnt0_ChangeAccount()
	edtPW.caption = "" '계좌 바뀔때마다 비밀번호 초기화
	g_szData = acnt0.total & "★" & edtPW.caption  '계좌번호 & 비밀번호
	g_TabType = CInt(FormTab0.currenttab)
	
	if g_TabType == 0 then
		Form.SetSharedData("ASNO_83130" , acnt0.sequence)
		Form.triggerEvent( "FormTab0." & FormTab0.currenttabpageid, "환불금입금", g_szData)
	elseif g_TabType == 1 then
		Form.SetSharedData("ASNO_83130" , acnt0.sequence)
		Form.triggerEvent( "FormTab0." & FormTab0.currenttabpageid, "공모주입고", g_szData)
	end if
	
	'edtPW.caption = ""
End Sub
'============================================================================
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	if szTranID == "obacp_opop_066r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	elseif szTranID == "obpds_srvc_070r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	end if
	
End Sub
