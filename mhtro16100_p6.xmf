'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_nCount
g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
Dim g_szOrder_Acc			' 계좌번호
Dim g_szOrder_AccName		' 고객명
Dim g_szOrd_ItmCode		' 종목코드
Dim g_szOrd_ItmName		' 종목명
Dim g_szOrd_OrdType		' 주문구분
Dim g_szOrd_Security		' 현금/대출
Dim g_nOrd_Qty			' 주문수량
Dim g_nOrd_Price			' 주문가격
Dim g_nOrd_OrdNo			' 원주문번호
Dim g_nOrd_ChkAll			' 잔량전부	
Dim g_nOrd_Decimal		' 가격자릿수
Dim g_nOrd_Currency		' 통화기호
Dim g_szOrd_PrcName		' 시장가/지정가

Dim g_nOrd_LoanType		' 대출구분
Dim g_szOrd_LoanDate		' 대출일자
Dim g_szOrd_LoanSrno		' 대출일련번호

Dim g_OsType

'============================================================================
Sub Form_OnFormInitBefore()

	g_OsType = Form.GetSharedData("&OS_TYPE", false)

	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	'-----------------------------------------------------------
	' 일반주문(현금/대출)
	'-----------------------------------------------------------
	g_nIndex				= arrData( 0) ' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소, 10:예약매수, 11:예약매도, 12:예약취소)
	g_szOrder_Acc			= arrData( 1)	' 계좌번호
	g_szOrder_AccName		= arrData( 2)	' 고객명
	g_szOrd_ItmCode 		= arrData( 3)	' 종목코드
	g_szOrd_ItmName 		= arrData( 4)	' 종목명
	g_szOrd_OrdType  		= arrData( 5)	' 주문구분
	g_szOrd_Security 		= arrData( 6)	' 현금/대출구분 (0:현금/1:대출)
	g_nOrd_Qty   			= arrData( 7)	' 주문수량
	g_nOrd_Price 			= arrData( 8)	' 주문가격
	g_nOrd_OrdNo 			= arrData( 9)	' 원주문번호
	g_nOrd_ChkAll 		= arrData(10)	' 잔량전부
	g_nOrd_Decimal		= arrData(11)	' 가격자릿수
	g_nOrd_Currency		= arrData(12)	' 통화
	g_szOrd_PrcName		= arrData(13)	' 시장가or지정가
	
	'대출일경우
	if g_szOrd_Security == "1" then
		g_nOrd_LoanType		= arrData(14)	' 대출구분
		g_szOrd_LoanDate		= arrData(15)	' 대출일자
		g_szOrd_LoanSrno		= arrData(16)	' 대출일련번호
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()

    Set_Data(g_nIndex)
    
End Sub

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)

    '===========================================================
    ' 일반주문
    '===========================================================
		
	'===========================================================
	' 대출
	'===========================================================
	if g_szOrd_Security == "1" then
		
		'-----------------------------------------------------------
		' 일반주문 : (현금)숨김처리 / (대출) 보임처리
		'-----------------------------------------------------------
		Label0.top = 250
		lblMaesu1Title.top = 250
		
		imgMain.top = 246
		imgMain.height = 491 
		Image0.top = 340
		Image0.height = 236
		Label3.top = 310
		
		tblMaedo2.top = 352
	
		tblMaedo1.visible = false
		tblMaedo2.visible = true
		
		'-----------------------------------------------------------
		' 계좌번호/고객명
		'-----------------------------------------------------------
		szStr1 = left(g_szOrder_Acc,4)
		szStr2 = mid(g_szOrder_Acc,5,4)
		szStr3 = right(g_szOrder_Acc,2)
		tblMaedo2.SetCellString( 0, 1, szStr1.."-".. szStr2 .."-".. szStr3.." "..g_szOrder_AccName)
		
		'-----------------------------------------------------------
		' 매매구분
		'-----------------------------------------------------------
		if nIndex == 1 or nIndex == "1" then
			
			tblMaedo2.SetCellFgColor(1, 1, 291)
			tblMaedo2.SetCellString( 1, 1, "매도")
		
		elseif nIndex == 2 or nIndex == "2" then
			
			tblMaedo2.SetCellFgColor(1, 1, 290)
			tblMaedo2.SetCellString( 1, 1, "매수")
			
		end if
		
		'-----------------------------------------------------------
		' 대출구분/대출일자
		'-----------------------------------------------------------
		sLoanName = ""
		if g_nOrd_LoanType = "0251" then
			sLoanName = "예탁주식"
		end if
		
		sLoanDate = Left(g_szOrd_LoanDate,4) .. "." .. Mid(g_szOrd_LoanDate,5,2) .. "." .. Right(g_szOrd_LoanDate,2)
		
		tblMaedo2.SetCellString( 2, 1, sLoanName .. " | " .. sLoanDate)
		
		'-----------------------------------------------------------
		' 종목코드/종목명
		'-----------------------------------------------------------
		tblMaedo2.SetCellString( 3, 1, g_szOrd_ItmCode)
		
		'tblMaedo2.SetCellString( 4, 1, g_szOrd_ItmName)
		if g_OsType == "1" then
			LabelItemName.paddinginfo = "0,2,10,0"
		else
			LabelItemName.paddinginfo = "0,0,8,0"
		end if
		
		LabelItemName.maxlinecnt = "2^-8"
		LabelItemName.caption = g_szOrd_ItmName
		
		'-----------------------------------------------------------
		' 주문구분
		'-----------------------------------------------------------
		tblMaedo2.SetCellString( 5, 1, g_szOrd_OrdType)
		
		'-----------------------------------------------------------
		' 수량
		'-----------------------------------------------------------
		If g_nOrd_ChkAll = "Y" Then
			g_nOrd_Qty = "잔량전부"
		End If
		
		tblMaedo2.SetCellString( 6, 1, g_nOrd_Qty)
		
		'-----------------------------------------------------------
		' 시장가/지정가 여부에따라 가격 세팅
		'-----------------------------------------------------------
		if g_szOrd_PrcName == "시장가" then
		
			tblMaedo2.SetCellString( 7, 1, "-" )	
			
		else
		
			'-----------------------------------------------------------
			' 단가(시장별 소수점처리 및 통화처리)
			'-----------------------------------------------------------
			sMask = "0,0,,".. " "..g_nOrd_Currency ..",0,,"..g_nOrd_Decimal..",1,1,2,0"
			tblMaedo2.SetCellMaskInfo( 7, 1, sMask )
			tblMaedo2.SetCellString( 7, 1, g_nOrd_Price )	
		
		end if
		
		'-----------------------------------------------------------
		' 원주문번호
		'-----------------------------------------------------------
		tblMaedo2.SetCellString( 8, 1, g_nOrd_OrdNo )	
	
	
	'===========================================================
	' 현금
	'===========================================================	
	else
	
		'-----------------------------------------------------------
		' 일반주문 : (현금)보임처리 / (대출) 숨김처리
		'-----------------------------------------------------------
		tblMaedo1.visible = true
		tblMaedo2.visible = false
		
		'-----------------------------------------------------------
		' 계좌번호/고객명
		'-----------------------------------------------------------
		szStr1 = left(g_szOrder_Acc,4)
		szStr2 = mid(g_szOrder_Acc,5,4)
		szStr3 = right(g_szOrder_Acc,2)
		tblMaedo1.SetCellString( 0, 1, szStr1.."-".. szStr2 .."-".. szStr3.." "..g_szOrder_AccName)
		
		'-----------------------------------------------------------
		' 매매구분(매수/매도)
		'-----------------------------------------------------------
		if nIndex == 1 or nIndex == "1" then
			
			tblMaedo1.SetCellFgColor(1, 1, 291)
			tblMaedo1.SetCellString( 1, 1, "매도")
		
		elseif nIndex == 2 or nIndex == "2" then
			
			tblMaedo1.SetCellFgColor(1, 1, 290)
			tblMaedo1.SetCellString( 1, 1, "매수")
			
		end if
		
		'-----------------------------------------------------------
		' 종목코드/종목명
		'-----------------------------------------------------------
		tblMaedo1.SetCellString( 2, 1, g_szOrd_ItmCode)
		
		'tblMaedo1.SetCellString( 3, 1, g_szOrd_ItmName)
		if g_OsType == "1" then
			LabelItemName.paddinginfo = "0,2,10,0"
		else
			LabelItemName.paddinginfo = "0,0,8,0"
		end if
		LabelItemName.maxlinecnt = "2^-8"
		LabelItemName.caption = g_szOrd_ItmName
		
		'-----------------------------------------------------------
		' 주문구분(지정가/시장가)
		'-----------------------------------------------------------
		tblMaedo1.SetCellString( 4, 1, g_szOrd_OrdType)
		
		'-----------------------------------------------------------
		' 수량
		'-----------------------------------------------------------
		If g_nOrd_ChkAll = "Y" Then
			g_nOrd_Qty = "잔량전부"
		End If
		
		tblMaedo1.SetCellString( 5, 1, g_nOrd_Qty)
		
		'-----------------------------------------------------------
		' 시장가/지정가 여부에따라 가격 세팅
		'-----------------------------------------------------------
		if g_szOrd_PrcName == "시장가" then
			
			tblMaedo1.SetCellString( 6, 1, "-" )
			
		else
			
			'-----------------------------------------------------------
			' 단가(시장별 소수점처리 및 통화처리)
			'-----------------------------------------------------------
			sMask = "0,0,,".. " "..g_nOrd_Currency ..",0,,"..g_nOrd_Decimal..",1,1,2,0"
			tblMaedo1.SetCellMaskInfo( 6, 1, sMask )
			tblMaedo1.SetCellString( 6, 1, g_nOrd_Price )	
		
		end if
		
		'-----------------------------------------------------------
		' 원주문번호
		'-----------------------------------------------------------
		tblMaedo1.SetCellString( 7, 1, g_nOrd_OrdNo )	
	
	end if
	  

End Function

'============================================================================
Function SendOrder()
    
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문전송" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
	    
    End If
    
End Function
'============================================================================
Sub btnMaesu1Close_OnClick()
	Form.CloseForm()	
End Sub
'============================================================================
Sub btnMaesu1_OnClick()
	SendOrder()
End Sub
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================


	</SCRIPT_INFO>
</ROOT>