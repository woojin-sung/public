	<SCRIPT_INFO _len="4143" _ulen="3673" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 중개형 ISA 소개
' 02. 화면설명 : 
' 03. 이    력 : 2022.11.10 : 고승연 : v0002 : 투자시 유의사항 이미지 늘어남 현상 수정
'                2023.02.10 : 고승연 : v0003 : 심사필 내용 수정
'                2024.02.20 : 고승연 : v0004 : 심사필 문구 삭제
'                2024.06.28 : 고승연 : v0005 : 예금자보호 문구 수정
'-------------------------------------------------------------------------------------------

Dim bFoldState 
bFoldState = false

'============================================================================
Sub Form_OnFormInitBefore()
	'이미지 찌그러짐 현상 개선
	contTab0.contCheck.Image1.setMaintainingRatio("1")
	contTab0.contCheck.imgInfo.setMaintainingRatio("1")
	f_SetUI(0)
End Sub


'============================================================================
Function f_ShowInfo(bState)
	'v0003
	if bState then
		contTab0.contCheck.height = 505
		contTab0.SetScrollAutoSize()
		contTab0.scroll_pos = contTab0.scrolpoint.top
	
	else
		contTab0.contCheck.height = 32
		contTab0.SetScrollAutoSize()
		
	end if

End Function 

'============================================================================
Function f_SetUI(nIdx)
	dim imageHeight
	
	'v0003
	if nIdx == 0 then
		imageHeight = 910
		contTab0.btnMoveInfo.visible = false			'영업점안내 이동 버튼
	
	else
		imageHeight = 610
		contTab0.btnMoveInfo.visible = true			'영업점안내 이동 버튼
		
	end if
	
	contTab0.imgInfo.height = imageHeight
	contTab0.btnOpenAcnt.top = imageHeight + 20		'계좌개설 이동버튼
	contTab0.contCheck.top = imageHeight + 50 + 20
	contTab0.scrolpoint.top = imageHeight + 50 + 20
	
	contTab0.SetScrollAutoSize()
End Function

'============================================================================
Sub contTab0_contCheck_btnFold_OnClick()
	Dim szimgFile

	if bFoldState then
		szimgFile = "btn_filter.9.png"
	else
		szimgFile = "btn_filter2.9.png"
	end if
	
	bFoldState = not bFoldState
	contTab0.contCheck.btnFold.btnimage = szimgFile
	f_ShowInfo(bFoldState)
End Sub

'============================================================================
Sub Tab0_OnTabChanged(nCurrentTab)
	if CInt(nCurrentTab) == 0 then
		contTab0.imgInfo.imgpath = "mdtp_isa_benefit.png"
	else
		contTab0.imgInfo.imgpath = "mdtp_isa_feature.png"
	end if

	contTab0.scroll_pos = "top"
	f_SetUI(CInt(nCurrentTab))
End Sub

'============================================================================
Sub Form_OnFormInit()
	'f_SetUI(0)
	dim str
	
	str = "이 개인종합자산관리계좌(ISA)는 예금자보호법에 따라 예금" & chr(10) & ""
		.. " 보호 대상으로 운용되는 금융상품에 한하여 1인당 " & chr(34) & "5천만원" & chr(10) & ""
		.. "까지" & chr(34) & "(운용되는 금융상품 판매회사별 보호상품 합산) 보호" & chr(10) & ""
		.. "됩니다."
	
	contTab0.contCheck.Table2.SetCellString(1, 1, str)
End Sub

'============================================================================
Sub contTab0_btnMoveInfo_OnClick()
	Form.OpenScreen("89000", "")
End Sub

'============================================================================
Sub contTab0_btnOpenAcnt_OnClick()
	sloginType = Form.GetSharedData( "&LOGIN_TYPE", false )
	
	if Cint(sloginType) > 1 then
		sText = "로그아웃이 필요한 메뉴입니다. 로그아웃하시겠습니까?"
		Form.MsgBox("알림",sText, "LOGOUT_MSG" , 1 )
	else
		Form.SetSharedData("&SCREEN_AUTH" , "99")
		Form.OpenPopup("mbbdm85100", "", "")
	end if
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "LOGOUT_MSG" then
		if sRet == "ok" then
			'1parm (0.문구없음 1.문구있음)
			'2parm (0.권한상관없이 로그아웃만 함 1.화면권한에 따라 닫을 화면 로그아웃)
			Form.LogOut(0,1)
			Form.SetSharedData("&SCREEN_AUTH" , "99")
			Form.OpenPopup("mbbdm85100", "", "")
		end if
	end if
End Sub


	</SCRIPT_INFO>
</ROOT>