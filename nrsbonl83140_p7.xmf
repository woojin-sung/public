'============================================================================
' 화 면 명 : 매수청구 신청 기본정보
' 화면설명 : 매수청구 신청 기본정보 화면
' 작    성 : 2023.10.31 KKM
'============================================================================

Dim g_sPlain_rm
Dim g_OsType
Dim g_szPreKeyPad
Dim g_sGubunCode
Dim g_bFlag
Dim g_szMangCode

Dim g_szJobClsCode  ' 신청-1, 취소-2, 상세보기-0
g_szJobClsCode = "0"

'============================================================================
Sub Form_OnFormInitBefore()
	imgClose.setMaintainingRatio("1")
	cont1.bgcolor = "246247248"
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		dim tData
		tData = Split(szOpenData, "★")
		'전달데이터
		'0 : 종목코드
		'1 : 종목명
		'2 : 마감일
		'3 : 기준일
		'4 : 청구금액
		'5 : 전일종가
		'6 : 현금 가능 수량
		'7 : 신용 가능 수량
		'8 : 유통 가능 수량
		'9 : 관리 지점코드
		'10 : 매수청구수량
		'11 : 작업구분코드(신청 -1 , 취소 - 2)  231027 추가
		cont1.Label14.caption = tData(0)  '종목코드
		cont1.Label7.caption = tData(1)   '종목명		
		cont1.Label8.caption = CDbl(tData(4)) 	'매수청구가격
		cont1.Label9.caption = tData(5)			'전일종가
		cont1.Label10.caption = tData(2)		'매수청구마감일
		cont1.Label11.caption = tData(3)		'기준일
		cont1.Label12.caption = CDbl(tData(6))	'현금 가능수량
		cont1.Label13.caption = CDbl(tData(7))	'신용 가능수량
		cont1.Label16.caption = CDbl(tData(8))	'유통 가능수량
		g_szMangCode = tData(9)	'관리지점코드
		g_szJobClsCode = tData(11) '작업구분코드
		
		Dim nQty1, nQty2, nQty3
		nQty1 = CDbl(tData(6))	'매수청구 현금수량
		nQty2 = CDbl(tData(7))	'매수청구 신용수량
		nQty3 = CDbl(tData(8))	'매수청구 유통수량
		'blTotal.caption = CDbl(nQty1 + nQty2 + nQty3)			
		lblTotal.caption = CDbl(tData(10)) '매수청구수량			
	
		cont1.Label12.setHighlight(332)
		cont1.Label13.setHighlight(332)
		cont1.Label16.setHighlight(332)
		lblTotal.setHighlight(54)			
	end if
	
End Sub

'============================================================================
Sub btnReg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

