'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if	szTranID	=	"oocwi_mall_002r"	then
	
				
		'0.	입력값 COUNT 초기화
		g_nIdx	=	0	
		
		nTypeCnt	=	0
		nFeeCnt	=	0
		nGradeCnt	=	0
		nChanCnt	=	0
		
		'DATAMANAGER.SetDataValue(0, "oocwi_mall_002r", "InBlock1", "SORT_CLS", 0, "R")	'민츠,홈페이지동일하도록 추천펀드
		
				
'		if	edtSearch01.caption 	<>	""	then
'			g_szKeyword = edtSearch01.caption 
'		else
'			g_szKeyword	=""
'		end	if
		
		'2. 각각 조건의 COUNT 가져옴
		if	g_szType <> ""	then
			nTypeCnt	=	getListItem(g_szType, 0)
		end if 
		if	g_szGrade <> ""	then
			nGradeCnt	=	getListItem(g_szGrade, 0)
		end if 
		if	g_szFee <> ""	then
			nFeeCnt	=	getListItem(g_szFee, 0)
		end if 
		if	g_szChan <> "" then
			nChanCnt	=	getListItem(g_szChan, 0)
		end if
		
		'Form.ShowAlert("test", nTypeCnt & ".." & nGradeCnt &".." & nFeeCnt &".."& nChanCnt)
		
		'3.분류해서 INPUT Array에 넣음.
		if	nTypeCnt	<>	0	then
			setInputItems(g_szType, nTypeCnt)
		end if
		if	nGradeCnt	<>	0	then
			setInputItems(g_szGrade, nGradeCnt)
		end if	
		if	nFeeCnt	<>	0	then
			setInputItems(g_szFee, nFeeCnt)
		end if
		if	nChanCnt <>	0	then
			setInputItems(g_szChan, nChanCnt)
		end if

'		for i = 0 to Ubound(g_szMainValues) 
'			Form.ShowAlert("main", g_szMainValues(i) & ".." & i)
'		next

		'4. 실제 TR에 세팅
		DATAMANAGER.ClearInputData(0, "oocwi_mall_002r")
				
		if	len(trim(g_szKeyword))		<>	""	then
			DATAMANAGER.SetDataValue(0, "oocwi_mall_002r", "InBlock1", "KOR_ISNM" , 0 , g_szKeyword)
		end if
		
		DATAMANAGER.SetDataValue(0, "oocwi_mall_002r", "InBlock1", "IISC_INVT_REGN_CLS_CODE" , 0 , g_szArea)
		DATAMANAGER.SetDataValue(0, "oocwi_mall_002r", "InBlock1", "SORT_CLS", 0, cmbSort01.cbkeydata)
		
		for 	i = 0	to	g_nIdx - 1	
			DATAMANAGER.SetDataValue(0,"oocwi_mall_002r", "InBlock2", "ZI_HGRN_ATRB_CODE", i, g_szMainValues(i))
			DATAMANAGER.SetDataValue(0,"oocwi_mall_002r", "InBlock2", "DTL_CODE", i, g_szSubValues(i))
		next
	end if
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	n002Cnt, szDataCnt
	dim	szOrgGrad, szTransGrad
	dim  nMulti, szColor
	
	dim szFee, szSaleChan, szCDSC_yn, szCLEN_yn, szCLAS_yn, szWaFd_yn, szCNVR_yn, szPNSN_yn, szAPAN_yn, szPfSv_yn 	
	
	dim nIntrIdx			'관심등록 위치
	dim szIntrCD			'관심등록된 코드
	dim	bIsmore
	
	dim div3_cnt			'펀드 한글클래스 3차분류 갯수

	dim tData1
	dim tData2

	nIntrIdx	=	0
	szIntrCD	=	""
	bIsmore	=	false
	
	if	szTranID	=	"oocwi_mall_002r"	then
		ShowCol()
		
	
		n002Cnt 	=	grd01T1.rowcount
		szDataCnt	=	DATAMANAGER.GetDataCount(0, "oocwi_mall_002r", "OutBlock2")
		
		nMulti =  ( n002Cnt / szDataCnt ) - 1
		
		' 펀드비교함에 추가한 테이터를 가져온다.
		'tData1 = Split(g_szCompareData1, "★")
		'tData2 = Split(g_szCompareData2, "★")
		
		for	i=0+(nMulti * szDataCnt) to	n002Cnt-1
		
			div3_cnt		= 0
			szOrgGrad 	 =	grd01T1.GetCellData("bd_grade", i)
	
			szTransGrad =  Form.GetMetaData("집합투자증권상품등급코드", szOrgGrad)
			szColor	=	getGradeColor (szOrgGrad)
			grd01T1.SetCellFgColor("bd_grade", i, szColor)
			grd01T1.SetCellData("bd_grade", i, szTransGrad)
			
			'1. 계열사구분코드 > 변환 매크로 v0001 sta
			szSaComCode = grd01T1.GetCellData("bd_cell4", i)
			
			if szSaComCode = "Y" then
				szSaComName = "계열사"
				grd01T1.SetCellFgColor("bd_cell4", i, "1")
								
			else
				szSaComName = ""
			end if
			
			grd01T1.SetCellData("bd_cell4", i, szSaComName)
			'v0001 fin
			
			'v0002 sta 펀드 한글화 클래스 관련 수정
			
			'초기화
			grd01T1.SetCellData("bd_cell9", i, "")
			grd01T1.SetCellData("bd_cell11", i, "")
			grd01T1.SetCellData("bd_cell13", i, "")
			grd01T1.SetCellData("bd_cell14", i, "")
			
			'1차분류 : 수수료
			szFee = grd01T1.GetCellData("bd_cell7", i)
			if szFee = "02" then
				grd01T1.SetCellData("bd_cell9", i, "수수료선취")
				'grd01T1.SetCellImage("bd_cell9", i, "1st_01.png")
			elseif szFee = "04" then
				grd01T1.SetCellData("bd_cell9", i, "수수료후취")
				'grd01T1.SetCellImage("bd_cell9", i, "1st_02.png")
			else
				grd01T1.SetCellData("bd_cell9", i, "수수료미징구")
				'grd01T1.SetCellImage("bd_cell9", i, "1st_03.png")
			end if
			
			grd01T1.SetCellFgColor("bd_cell9", i, "133")
						
			'2차분류 : 판매채널
			szSaleChan = grd01T1.GetCellData("bd_cell2", i)
			
			if szSaleChan = "1" then
				grd01T1.SetCellData("bd_cell11", i, "오프라인")
				'grd01T1.SetCellImage("bd_cell11", i, "2nd_02.png")
			elseif szSaleChan = "2" then
				grd01T1.SetCellData("bd_cell11", i, "온라인")
				'grd01T1.SetCellImage("bd_cell11", i, "2nd_01.png")
			else
				grd01T1.SetCellData("bd_cell11", i, "오프라인")
			end if
			
			grd01T1.SetCellFgColor("bd_cell11", i, "206")
			
			'3차분류
			szCDSC_yn = grd01T1.GetCellData("bd_cell20", i)
			szCLEN_yn = grd01T1.GetCellData("bd_cell15", i)
			szCLAS_yn = grd01T1.GetCellData("bd_cell16", i)
			szWaFd_yn = grd01T1.GetCellData("bd_cell17", i)
			szCNVR_yn = grd01T1.GetCellData("bd_cell18", i)
			szPNSN_yn = grd01T1.GetCellData("bd_cell19", i)
			szAPAN_yn = grd01T1.GetCellData("bd_cell21", i)
			szPfSv_yn = grd01T1.GetCellData("bd_cell22", i)
			
			if szCDSC_yn <> "N" then
				'한글클래스 3차분류 1개 펀드
				grd01T1.SetCellData("bd_cell13", i, "보수체감")
				'grd01T1.SetCellImage("bd_cell13", i, "3rd_01.png")
				
				div3_cnt = div3_cnt + 1
			end if
			
			if szCLEN_yn <> "N" then
				'한글클래스 3차분류 2개 펀드
				if div3_cnt = 1 then
					grd01T1.SetCellData("bd_cell14", i, "무권유저비용")
					'grd01T1.SetCellImage("bd_cell14", i, "3rd_02.png")
				else
					grd01T1.SetCellData("bd_cell13", i, "무권유저비용")
					'grd01T1.SetCellImage("bd_cell13", i, "3rd_02.png")
				end if
				div3_cnt = div3_cnt + 1
			end if
			
			if szCLAS_yn <> "N" then
				'한글클래스 3차분류 2개 펀드
				if div3_cnt = 1 then
					if szCLAS_yn = "F" then
						grd01T1.SetCellData("bd_cell14", i, "기관전용")
						'grd01T1.SetCellImage("bd_cell14", i, "3rd_04.png")
					elseif szCLAS_yn = "W" then
						grd01T1.SetCellData("bd_cell14", i, "랩전용")
					else
						grd01T1.SetCellData("bd_cell14", i, "고액")
						'grd01T1.SetCellImage("bd_cell14", i, "3rd_05.png")
					end if
				'한글클래스 3차분류 1개 펀드
				else
					if szCLAS_yn = "F" then
						grd01T1.SetCellData("bd_cell13", i, "기관전용")
						'grd01T1.SetCellImage("bd_cell13", i, "3rd_04.png")
					elseif szCLAS_yn = "W" then
						grd01T1.SetCellData("bd_cell13", i, "랩전용")
					else
						grd01T1.SetCellData("bd_cell13", i, "고액")
						'grd01T1.SetCellImage("bd_cell13", i, "3rd_05.png")
					end if
				end if
				div3_cnt = div3_cnt + 1
			end if
			
			'190927 박미선 대리 szCLAS_yn : W일때 랩전용 표기요청
'			if szWaFd_yn <> "N" then
'				'한글클래스 3차분류 2개 펀드
'				if div3_cnt = 1 then
'					grd01T1.SetCellData("bd_cell14", i, "랩전용")
'					'grd01T1.SetCellImage("bd_cell14", i, "3rd_06.png")
'				else
'					grd01T1.SetCellData("bd_cell13", i, "랩전용")
'					'grd01T1.SetCellImage("bd_cell13", i, "3rd_06.png")
'				end if
'				div3_cnt = div3_cnt + 1
'			end if
			
			if szCNVR_yn <> "N" then
				'한글클래스 3차분류 2개 펀드
				if div3_cnt = 1 then
					grd01T1.SetCellData("bd_cell14", i, "전환가능")
					'grd01T1.SetCellImage("bd_cell14", i, "3rd_08.png")
				else
					grd01T1.SetCellData("bd_cell13", i, "전환가능")
					'grd01T1.SetCellImage("bd_cell13", i, "3rd_08.png")
				end if
				div3_cnt = div3_cnt + 1
			end if
			
			if szPNSN_yn <> "N" then
				'한글클래스 3차분류 2개 펀드
				if div3_cnt = 1 then
					grd01T1.SetCellData("bd_cell14", i, "개인연금")
					'grd01T1.SetCellImage("bd_cell14", i, "3rd_07.png")
				else
					grd01T1.SetCellData("bd_cell13", i, "개인연금")
					'grd01T1.SetCellImage("bd_cell13", i, "3rd_07.png")
				end if
				div3_cnt = div3_cnt + 1
			end if
			
			if szAPAN_yn <> "N" then
				'한글클래스 3차분류 2개 펀드
				if div3_cnt = 1 then
					grd01T1.SetCellData("bd_cell14", i, "주택마련")
					'grd01T1.SetCellImage("bd_cell14", i, "3rd_03.png")
				else
					grd01T1.SetCellData("bd_cell13", i, "주택마련")
					'grd01T1.SetCellImage("bd_cell13", i, "3rd_03.png")
				end if
				div3_cnt = div3_cnt + 1
			end if
			
			if szPfSv_yn <> "N" then
				'한글클래스 3차분류 2개 펀드
				if div3_cnt = 1 then
					grd01T1.SetCellData("bd_cell14", i, "재형저축")
					'grd01T1.SetCellImage("bd_cell14", i, "3rd_09.png")
				else
					grd01T1.SetCellData("bd_cell13", i, "재형저축")
					'grd01T1.SetCellImage("bd_cell13", i, "3rd_09.png")
				end if
				div3_cnt = div3_cnt + 1
			end if
			
			grd01T1.SetCellFgColor("bd_cell13", i, "131")
			grd01T1.SetCellFgColor("bd_cell14", i, "131")
			
			'v0002 fin
			
			'21.07.12 JHY START
			'v0003
			Dim szHGDTYn, szFITYn
			szHGDTYn = grd01T1.GetCellData("bd_HGDT_YN", i)
			szFITYn = grd01T1.GetCellData("bd_FIT_YN", i)
			
			'21.09.28 JHY START : 데이터 컨트롤에 세팅해서 새로 호출할때 지우지 않고 그리고 있어, 이전 데이터가 남아있는 오류 있어 추가
			grd01T1.SetCellData("bd_StrHGDT", i, "")
			grd01T1.SetCellData("bd_StrHGDT2", i, "")
			'21.09.28 JHY END

			if szFITYn == "Y" then
				grd01T1.SetCellData("bd_StrHGDT", i, "적정성금융투자상품")
			end if
			
			if szHGDTYn == "Y" then
				if szFITYn == "Y" then
					grd01T1.SetCellData("bd_StrHGDT2", i, "고난도금융투자상품")
				else
					grd01T1.SetCellData("bd_StrHGDT", i, "고난도금융투자상품")
				end if
			end if
			'21.07.12 JHY END	
			
			' 조회된 펀드목록중 펀드비교함에 추가된 펀드와 동일펀드 존재시 체크박스 활성화 해준다
		        IF  Trim(contCompare.grdList.GetCellData("bd_iscd", 0)) == grd01T1.GetCellData("bd_cell0", i) THEN
			        ' 펀드비교함 첫번째 펀드
			        grd01T1.SetCellData("bd_cell10", i, "1")
			ELSEIF Trim(contCompare.grdList.GetCellData("bd_iscd", 1)) == grd01T1.GetCellData("bd_cell0", i) THEN
			        ' 펀드비교함 두번째 펀드
			        grd01T1.SetCellData("bd_cell10", i, "1")
			ELSE
			        grd01T1.SetCellData("bd_cell10", i, "0")
			END IF

		next
	elseif	szTranID	=	"oocwi_mall_002r_1"	then
	
	
		bIsmore	=	DATAMANAGER.IsMoreNextData("oocwi_mall_002r_1")
			
		if	bIsmore	=	true		then
			DATAMANAGER.SetDataValue(0, "oocwi_mall_002r_1", "InBlock1", "PROS_CLS_CODE", 0 , "2")
			DATAMANAGER.RequestNextData("oocwi_mall_002r_1")
		else
		
			nIntrIdx = grdIntrFund01.rowcount
			
			'Form.ShowAlert("code", g_szShortCd)
				
			'1. 기존관심펀드에 등록되어있는지 확인
			for	i = 0	to	nIntrIdx	
				szIntrCD	=	grdIntrFund01.GetCellData("bd_cell0", i)
				if	trim(szIntrCD)	=	trim(g_szShortCd)	then
					Form.ShowAlert("알림", "이미 등록된 펀드가 존재합니다.")
					exit sub
				end if
			next
				
				
			'2. 기존에 관심펀드 없을경우 있을경우만 그리드에 추가
			grdIntrFund01.AddRow()
			grdIntrFund01.SetCellData("bd_cell0", nIntrIdx  , g_szShortCd)
				
			nIntrIdx = grdIntrFund01.rowcount		'등록되기전 조회하여 데이터 들어간 갯수체크 재확인
	
			'3. 등록 TR 전송
			for	i = 0	to	nIntrIdx -1 
				DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock1", "EMPL_CNIS_TYPE_CLCD", i  , "1")	'집합투자증권 1
				DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock2", "ISCD", i, grdIntrFund01.GetCellData("bd_cell0", i))
			next
				
			DATAMANAGER.SetEventFlag("oocwi_gmyg_011a", "A")
			DATAMANAGER.RequestTranData("oocwi_gmyg_011a")		
		end	if
			
	
	elseif	szTranID	=	"oocwi_gmyg_011a"	then
		Form.ShowAlert("알림", "정상적으로 관심펀드에 등록되었습니다.")
	
	'v0001 추가
	elseif	szTranID =	"obcsb_acif_798r" then
		
		g_szMainValues	=	Array()
		g_szSubValues	=	Array()
		g_szInvType = ""
		g_szGrade = ""
				
		g_szInvType = DATAMANAGER.GetDataValue(0, "obcsb_acif_798r" , "OutBlock1" , "KYC_INVT_INCL_GRAD_CODE" , 0)
		g_szCsno = DATAMANAGER.GetDataValue(0, "obcsb_acif_798r" , "OutBlock1" , "CSNO" , 0) 'v0004	
		g_szRcmdClsCode = DATAMANAGER.GetDataValue(0, "obcsb_acif_798r" , "OutBlock1" , "KYC_INVT_RCMD_CLS_CODE" , 0) 'v0004
		g_szModDate = DATAMANAGER.GetDataValue(0, "obcsb_acif_798r" , "OutBlock1" , "MOD_DATE" , 0) 'v0004
		
		
		if g_szInvType = "01" then
			g_szInvTranType = "01"
		elseif g_szInvType = "02" then
			g_szInvTranType = "03"
		elseif g_szInvType = "03" then
			g_szInvTranType = "04"
		elseif g_szInvType = "04" then
			g_szInvTranType = "05"
		elseif g_szInvType = "05" then
			g_szInvTranType = "06"
		else
			g_szInvTranType = ""
		end if
		
		g_szInvTypeNm = Form.GetMetaData("집합투자증권상품등급코드", g_szInvTranType)
		szInvColor = getInvTypeColor(g_szInvTranType)
				
		'로그인은 했으나 투자성향값이 없는 고객
		if (g_logintype <> "1" and g_szInvType = "") or (g_logintype <> "1" and g_szInvType = "00") then
			
			Table0.top = 	50
			Table0.SetCellString(0, 0, "투자성향을 확인하시면 고객님 투자")
			Table0.SetCellString(1, 0, "성향에 적합한 펀드를 안내드립니다.")
			Table0.SetCellString(2, 0, " ")
			Table0.SetCellString(2, 1, " ")
			
			Image1.imgpath = "invgrade07.png"
		'로그인 & 투자성향값이 있는 고객
		elseif g_logintype <> "1" and g_szInvType <> "" then
			Table0.top = 	33
			Table0.SetCellString(0, 0, " ")
			Table0.SetCellString(1, 0, g_szNm & "님의 투자성향에 적합한 상품은")
			Table0.SetCellFgColor(2, 0, szInvColor)
			Table0.SetCellString(2, 0, g_szInvTypeNm)
			Table0.SetCellString(2, 1, "이하 등급의 펀드입니다.")
			
			if g_szInvType = "01" then
				Image1.imgpath = "invgrade01.png"
			elseif g_szInvType = "02" then
				Image1.imgpath = "invgrade02.png"
			elseif g_szInvType = "03" then
				Image1.imgpath = "invgrade03.png"
			elseif g_szInvType = "04" then
				Image1.imgpath = "invgrade04.png"
			elseif g_szInvType = "05" then
				Image1.imgpath = "invgrade05.png"
			else
				Image1.imgpath = "invgrade07.png"
			end if
		'로그인을 하지 않은 고객
		else
			Table0.top = 	50	
			Table0.SetCellString(0, 0, "로그인을 하시면 고객님 투자성향에")
			Table0.SetCellString(1, 0, "적합한 펀드를 안내드립니다.")
			Table0.SetCellString(2, 0, " ")
			Table0.SetCellString(2, 1, " ")
			
			Image1.imgpath = "invgrade06.png"
			
		end if
		'v0001 초기검색일 경우 온라인판매 검색
		g_szChan = "1★SALE★2★"
		
		'v0001 sta 투자성향에 맞는 펀드 우선 검색
		IF g_szInvType = "01" then
		
			g_szGrade = "6★KYCD★01★KYCD★02★KYCD★03★KYCD★04★KYCD★05★KYCD★06★"
		
		elseif g_szInvType = "02" then
		
			g_szGrade = "4★KYCD★03★KYCD★04★KYCD★05★KYCD★06★"
			
		elseif g_szInvType = "03" then
		
			g_szGrade = "3★KYCD★04★KYCD★05★KYCD★06★"
			
		elseif g_szInvType = "04" then
						
			g_szGrade = "2★KYCD★05★KYCD★06★"
			
		elseif g_szInvType = "05" then	
		
			g_szGrade = "1★KYCD★06★"
		'v0001 fin
				
		end if
				
		DATAMANAGER.SetDataValue(0, "oocwi_mall_002r", "InBlock1", "SORT_CLS" , 0 , "R")
		DATAMANAGER.RequestTranData("oocwi_mall_002r")
	'v0004
	elseif	szTranID =	"oocwi_mall_005r" then
		if DATAMANAGER.GetDataValue(0, "oocwi_mall_005r" , "OutBlock1" , "PPP_YN" , 0) == "Y" then
			szData = g_szInvType & "☆" & g_szModDate
			Form.OpenFramePopup("mbfnp51000_p9" , szData , sPosInfo)
		end if
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim	szKeyword, szArea, szType, szFee, szGrade
	dim	nTypeCnt,	nFeeCnt, nGradeCnt
	
	dim szListItems		'미니팝업아이템
	
	if	sKeyName	=	"51000_SEARCH"	then						'펀드검색창에서 돌아올때

		if	sRet		=	"1"		then
			g_szMainValues	=	Array()
			g_szSubValues	=	Array()
			
			'1. 설정값 가져옴
			g_szKeyword = Form.GetSharedData("51000_KEYWORD", 0)
			g_szChan = Form.GetSharedData("51000_CHAN", 0)
			g_szArea = Form.GetSharedData("51000_AREA" , 0)
			g_szType = Form.GetSharedData("51000_TYPE" , 0)
			g_szGrade = Form.GetSharedData("51000_GRADE" , 0)
			g_szFee = Form.GetSharedData("51000_FEE" , 0)
			'msgbox "g_szKeyword: " & g_szKeyword & " g_szChan: " & g_szChan & " g_szArea: " & g_szArea & " g_szType: "& g_szType &" g_szGrade: " & g_szGrade & " g_szFee: " & g_szFee 
			'v0004
			if LEN(trim(g_szKeyword)) > 0 then
				DATAMANAGER.SetDataValue(0, "oocwi_mall_005r", "InBlock1", "KOR_ISNM" , 0 , g_szKeyword)
				DATAMANAGER.SetDataValue(0, "oocwi_mall_005r", "InBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0 , g_szInvType)
				DATAMANAGER.SetDataValue(0, "oocwi_mall_005r", "InBlock1", "CSNO" , 0 , g_szCsno)
				DATAMANAGER.SetDataValue(0, "oocwi_mall_005r", "InBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0 , g_szRcmdClsCode)
				DATAMANAGER.RequestTranData("oocwi_mall_005r")
			end if


			DATAMANAGER.RequestTranData("oocwi_mall_002r")

		else
			g_szKeyword	=""
			g_szChan =""
			g_szArea	=""
			g_szType	=""
			g_szGrade=""
			g_szFee	=""
		end	if
		
	
	elseif sKeyName = "MOVEPOP_RETURN"	then				'미니팝업처리
		szListItems	=	split(sRet,"★")
		
		
		if	szListItems(1)	=	"0"	then		'펀드상세
			'Form.SetSharedData("51000_Sal_Cha_Type" , g_szSaleChanTp)
			Form.OpenFramePopup("mbfnp51000_p2", g_szShortCd & "★" & g_szStndCd & "★" & g_szFundName & "★" & g_szSaleChanTp, sPosInfo)
		
		elseif	szListItems(1)	=	"1"	then		'다른클래스
			Form.OpenPopup("mbfnp51000_p4" , g_szShortCd, sPosInfo)
		elseif 	szListItems(1)	=	"2"	then		'관심등록	
			DATAMANAGER.ClearInputData(0, "oocwi_mall_002r_1")
			DATAMANAGER.SetDataValue(0, "oocwi_mall_002r_1", "InBlock1", "PROS_CLS_CODE", 0 , "2")
			DATAMANAGER.RequestTranData("oocwi_mall_002r_1")		
		elseif	szListItems(1)	=	"3"	then			'신규매수

			Form.OpenScreen("51010" , g_szShortCd & "★" & g_szStndCd & "★" & g_szFundName) 

		end if
	
	elseif sKeyName = "mbfnp51000_p5_refresh" then
		Refresh()
	' 임동군
	elseif sKeyName = "mbfnp51000_p5_refresh" then
		Refresh()
	end if
End Sub


