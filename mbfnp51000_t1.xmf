'============================================================================
' 01.화면명 	: 펀드검색
' 02.화면설명	: 펀드검색_펀드검색탭
' 03.작성	: 2016.02.11
'============================================================================
' 2017.10.24 조승행 : 표준투자권유준칙 변경에 따른 투자성향에 맞는 펀드 우선 검색 v0001
' 2019.09.06 조승행 : 펀드 한글 클래스 명칭 기재 v0002
' 2021.07.12 정효영 : 고난도 금융투자상품 추가 v0003
' 2022.09.19 정우희 : v0004 펀드 검색 프로세스 개선 (부적합 상품 조회 시 팝업)
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szMainValues	'검색조건에 따른 메인분류 input값
dim	g_szSubValues		'검색조건에 따른 서브분류 input값
dim	g_nIdx			'입력인덱스값
dim	g_szShortCd		'선택된아이템 코드값
dim	g_szStndCd		'선택된아이템 풀코드
dim	g_szFundName		'선택된아이템 펀드명
dim 	g_logintype
dim	g_szSaleChanTp	'선택된아이템 판매채널

dim	g_szKeyword 		'키워드
dim	g_szArea 		'투자지역
dim	g_szType 		'펀드유형
dim	g_szGrade 		'위험등급
dim	g_szFee 			'펀드비용
dim	g_szInvType		'사용자투자성향등급
dim	g_szChan			'판매채널
dim	g_szCustIvicGradCntt
dim	g_szInvtProdRiskGradCntt

dim g_szRcmdClsCode 'v0004 권유구분코드
dim g_szCsno 'v0004 고객번호
dim g_szModDate 'v004 투자성향변경일자

g_szKeyword	=""
g_szArea		=""
g_szType		=""
g_szGrade	=""
g_szFee		=""
g_szChan		=""

Dim g_szCompareData1
Dim g_szCompareData2
Dim g_bCompareBox

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'ShowCol	: 조회후에 보여지는 값 처리
'============================================================================
Function ShowCol()
	dim szSort
	
	szSort	=""
	szSort	=	cmbSort01.cbkeydata

	if	szSort	=	"C"	then			'1개월
		grd01T1.SetVisibleCol(2, 0)
		grd01T1.SetVisibleCol(3, 1)
		grd01T1.SetVisibleCol(4, 0)
		grd01T1.SetVisibleCol(5, 0)	
	elseif	szSort	=	"G"	then		'6개월
		grd01T1.SetVisibleCol(2, 0)
		grd01T1.SetVisibleCol(3, 0)
		grd01T1.SetVisibleCol(4, 1)
		grd01T1.SetVisibleCol(5, 0)
	elseif	szSort	=	"I"	then		'12개월
		grd01T1.SetVisibleCol(2, 0)
		grd01T1.SetVisibleCol(3, 0)
		grd01T1.SetVisibleCol(4, 0)
		grd01T1.SetVisibleCol(5, 1)
	else
		grd01T1.SetVisibleCol(2, 1)
		grd01T1.SetVisibleCol(3, 0)
		grd01T1.SetVisibleCol(4, 0)
		grd01T1.SetVisibleCol(5, 0)
	end if
End Function

'============================================================================
'getGradeColor	:	 등급코드 색상을 리턴한다.
'============================================================================
Function getGradeColor (szOrgGrad)
	if		szOrgGrad = "01"	then
		return "1"
	elseif	szOrgGrad = "02"	then
		return "101"
	elseif	szOrgGrad = "03"	then
		return "207"
	elseif	szOrgGrad = "04"	then
		return "202"
	elseif	szOrgGrad = "05"	then
		return "56"
	elseif	szOrgGrad = "06"	then
		return "158"
	else
		return "4"
	end	if
End Function

'============================================================================
'getInvTypeColor	:	 투자성향등급코드 색상을 리턴한다.
'============================================================================
Function getInvTypeColor (szInvGrad)
	if		szInvGrad = "01" or szInvGrad = "02"	then
		return "1"
	elseif	szInvGrad = "03"	then
		return "207"
	elseif	szInvGrad = "04"	then
		return "202"
	elseif	szInvGrad = "05"	then
		return "56" 
	elseif	szInvGrad = "06"	then
		return "158"
	else
		return "4"
	end	if
End Function


'============================================================================
'getListItem: 설정값에서 가져온 조건을 input 배열에 넣는다.
'============================================================================
Function	setInputItems( szInput, nCnt )
	for	i = 0	to	nCnt	- 	1
			g_szMainValues(g_nIdx)	=	getListItem(szInput, (i*2 + 1))
			g_szSubValues(g_nIdx)	=	getListItem(szInput, ((i+1)*2))
			g_nIdx = g_nIdx + 1
	next
End Function


'============================================================================
'getListItem: 해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function



