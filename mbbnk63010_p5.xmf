End Sub

'============================================================================
Sub Form_OnFormInit()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

    If sKey == "&LOGIN_AUTH" Then
        
        If sValue == "0" Or sValue == "1" Then
            Form.CloseForm()
        End If
    
    End If

End Sub

