'============================================================================
Sub Edit2_OnEditComplete()
	
	rate = Cint(Edit2.caption)
	
	if rate >= 0 and rate <20 then
	
	score = 3
	
	elseif rate >=20 and rate <40 then
	
	score = 6
	
	elseif rate >=40 and rate <60 then
	
	score = 9
	
	elseif rate>=60 and rate <80 then
	score = 12
	
	elseif rate >=80 then
	score = 15
	
	end if
	
	Form.SetSharedData("score5", score)
	
	
	if Edit0.caption <> "" and Edit1.caption <> "" and Edit2.caption <> "" and Edit3.caption <> "" then
	check_flag_3 = 1
	Form.SetSharedData("check_flag_3" , check_flag_3)
	
	elseif Edit0.caption == "" or Edit1.caption == "" or Edit2.caption == "" or Edit3.caption <> "" then
	check_flag_3 = 0
	Form.SetSharedData("check_flag_3" , check_flag_3)
	
	end if
	
	
	
	
	
End Sub



'============================================================================
Sub Edit3_OnEditComplete()
	
	rate2 = Cint(Edit3.caption)
	
	if rate2 >= 0 and rate2 <20 then
	
	score2 = 2
	
	elseif rate2 >=20 and rate2 <40 then
	
	score2 = 4
	
	elseif rate2 >=40 and rate2 <60 then
	
	score2 = 6
	
	elseif rate2>=60 and rate2 <80 then
	score2 = 8
	
	elseif rate2 >=80 then
	score2 = 10
	
	end if
	
	Form.SetSharedData("score6", score2)
	
	
	if Edit0.caption <> "" and Edit1.caption <> "" and Edit2.caption <> "" and Edit3.caption <> "" then
	check_flag_3 = 1
	Form.SetSharedData("check_flag_3" , check_flag_3)
	
	elseif Edit0.caption == "" or Edit1.caption == "" or Edit2.caption == "" or Edit3.caption <> "" then
	check_flag_3 = 0
	Form.SetSharedData("check_flag_3" , check_flag_3)
	
	end if

	
	
	
	
End Sub

