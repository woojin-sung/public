'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
'Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	g_szID 	= Form.GetSharedData("&USER_ID", false )
	g_empno 	= Form.GetSharedData("&EMPL_NO", false )
	DATAMANAGER.RequestTranData("obcpp_aprv_051r")
	
		
End Sub


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	g_szToday 		= Calendar0.caption
	Calendar0.addday 	= -60  '초기 검색 범위 최근 3개월
	DATAMANAGER.RequestTranData("obcpp_aprv_061r")
		
End Sub



'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
		
	if szTranID = "obcpp_aprv_061r" then
		DATAMANAGER.SetDataValue(0, "obcpp_aprv_061r", "InBlock1", "STA_DATE", 				0 , Calendar0.caption)
		DATAMANAGER.SetDataValue(0, "obcpp_aprv_061r", "InBlock1", "FIN_DATE", 				0 , Calendar1.caption)
		DATAMANAGER.SetDataValue(0, "obcpp_aprv_061r", "InBlock1", "UI_APRV_APLT_SHRN_NO", 	0 , 000000)
		DATAMANAGER.SetDataValue(0, "obcpp_aprv_061r", "InBlock1", "APRV_PRCS_ID", 			0 , "9999999")
		DATAMANAGER.SetDataValue(0,	 "obcpp_aprv_061r", "InBlock1", "APRV_PRGS_STAT_CODE" , 	0 , "99")
		DATAMANAGER.SetDataValue(0, "obcpp_aprv_061r", "InBlock1", "APRV_CLS_CODE", 			0 , "00")
		DATAMANAGER.SetDataValue(0, "obcpp_aprv_061r", "InBlock1", "APRV_APLT_DPCD", 			0 , "999")
		DATAMANAGER.SetDataValue(0, "obcpp_aprv_061r", "InBlock1", "APRV_APLT_EMPNO", 		0 , "99999")
		DATAMANAGER.SetDataValue(0, "obcpp_aprv_061r", "InBlock1", "APRV_EMPNO", 			0 , g_empno)

	elseif szTranID = "obcpp_aprv_051r" then
		DATAMANAGER.SetDataValue(0,"obcpp_aprv_051r", "InBlock1", "APRV_ROLE_ID", 			0 , "%")
		DATAMANAGER.SetDataValue(0,"obcpp_aprv_051r", "InBlock1", "EMPNO", 					0 ,g_empno)
		DATAMANAGER.SetDataValue(0,"obcpp_aprv_051r", "InBlock1", "DPCD", 					0 , "%")
	end if
		
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obcpp_aprv_061r" then
		
		count = DATAMANAGER.GetDataCount(0, "obcpp_aprv_061r", "OutBlock1") '그리드0 신청번호 마스킹
			for i = nRow to nRow+count-1 
				temp =  Right(Grid0.GetCellData("bd_cell1", i),5)  
				Grid0.SetCellData("bd_cell1",i, temp)
				nRow = nRow+1 					
			next 
			
		
	elseif szTranID = "obcpp_aprv_051r" then
			
			temp_empno =  DATAMANAGER.GetDataValue(0, "obcpp_aprv_051r", "OutBlock1", "EMPNO" ,0) 
			
			if g_empno = ""then
				Label2.enable 	= True	
				Label2.visible 	=  True		
			
			else 
				Label2.enable = False
				Label2.visible = False
			end if
		end if
	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if	len(trim(szSubMsg))	>	0	then
		Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert(g_szAlertTitle, szErrMsg )
	end	if
End Sub


'============================================================================
'Grid0_OnClickUp
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)

	Form.SetSharedData("aprv_prcs_id" , 		Grid0.GetCellData("bd_cell6", lRow))
	Form.SetSharedData("aprt_aplt_date" , 	Grid0.GetCellData("bd_cell0", lRow))
	Form.SetSharedData("aprv_aplt_no" , 		Grid0.GetCellData("bd_cell10", lRow))
	Form.SetSharedData("aprv_empno" , 		g_empno)
	Form.SetSharedData("aprv_dpnm" , 		Grid0.GetCellData("bd_cell8", lRow))
	Form.SetSharedData("empl_name" , 		Grid0.GetCellData("bd_cell9", lRow))
	Form.setSharedData("aprv_prcs_name" ,	Grid0.GetCellData("bd_cell2", lRow))
	Form.setSharedData("aprv_aplt_titl_cntt",Grid0.GetCellData("bd_cell3", lRow))
	Form.setSharedData("aprv_aplt_expl" ,	Grid0.GetCellData("bd_cell5", lRow))
	
	Form.OpenPopup("mbonl91004_p1.xmf", "" , "")
	
	
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
		
	if sKeyName = "POPUP_CLOSE" then
		
		l_flag = sRet
		
		if l_flag = "0" then
			
		
		elseif l_flag = "1" then
			Form.Toast(0, "정상적으로  승인 되었습니다.", 200)
		
		elseif l_flag = "2" then
			Form.Toast(0, "정상적으로  반려 되었습니다.", 200)
		
		else 
			Form.Toast(0,"승인 요청 중 오류가 발생했습니다", 200)
		
		end if
			
	end if
	nRow = 0
	DATAMANAGER.RequestTranData("obcpp_aprv_061r")
	
End Sub


'============================================================================
'Calendar0_OnEditComplete
'============================================================================
Sub Calendar0_OnEditComplete()
	
		if Calendar0.caption > Calendar1.caption then
			
			Form.ShowAlert( "알림", "조회날짜를 확인하여 주십시오.")
			Calendar0.caption = g_szToday 
			
			Exit Sub
		end if
		
	nRow = 0	
	
	DATAMANAGER.RequestTranData("obcpp_aprv_061r")
		
End Sub

'============================================================================
'Calendar1_OnEditComplete
'============================================================================
Sub Calendar1_OnEditComplete()
	nRow = 0
	
	if Calendar0.caption > Calendar1.caption  OR Calendar1.caption > g_szToday  then
	
			Form.ShowAlert( "알림", "조회날짜를 확인하여 주십시오.")
			Calendar1.caption = g_szToday 
			Exit Sub
		end if
	nRow = 0	
	DATAMANAGER.RequestTranData("obcpp_aprv_061r")
	
End Sub

'============================================================================
'Button0_OnClick
'============================================================================
Sub Button0_OnClick()
		nRow = 0	
		DATAMANAGER.RequestTranData("obcpp_aprv_061r")
	
End Sub

