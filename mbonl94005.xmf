'			elseif Form.GetSharedData("123r_CNCL_CNTT") = "B" then	'A:요건미충족취소/B:서류확인불가취소
			elseif Form.GetSharedData("123r_CNCL_CNTT") = "3" then	'A:요건미충족취소/B:서류확인불가취소
				Container0.contVCALL.lblVStep2.caption = "접수불가"
				Container0.contVCALL.lblVStep2.fgcolor = "6"

