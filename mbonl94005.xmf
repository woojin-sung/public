			elseif  Form.GetSharedData("123r_CNCL_CNTT") = "4" then	'C:영상통화불가취소
				Container0.contVCALL.lblVStep2.caption = "접수완료"
				Container0.contVCALL.lblVStep3.caption = "영상통화불가"
				Container0.contVCALL.lblVStep3.fgcolor = "6"

				g_DetailHidden = "Y"	'상세정보 박스안에 미표시
			elseif  Form.GetSharedData("123r_CNCL_CNTT") = "5" then	'C:영상통화불가취소
				Container0.contVCALL.lblVStep2.caption = "접수완료"
				Container0.contVCALL.lblVStep3.caption = "본인확인불가"
				Container0.contVCALL.lblVStep3.fgcolor = "6"

				g_DetailHidden = "Y"	'상세정보 박스안에 미표시
			else
				Container0.contVCALL.lblVStep4.caption = "취소완료"
			end if

		elseif g_szINVE_APLT_STCD = "" then		'취소
			Container0.contCALL.visible = false
			Container0.lblNoData.visible = true
		end if

