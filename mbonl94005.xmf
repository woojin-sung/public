				Container0.contCALL.lblStep2.fgcolor = "146"
				Container0.contCALL.lblStep3.fgcolor = "4"
			else
				Container0.contCALL.imgStep1.imgpath = "wrap_btn_check_gray"
				Container0.contCALL.imgStep2.imgpath = "wrap_btn_check_gray"
				Container0.contCALL.imgStep3.imgpath = "wrap_btn_check_gray"

				Container0.contCALL.lblStep1.fgcolor = "4"
				Container0.contCALL.lblStep2.fgcolor = "146"
				Container0.contCALL.lblStep3.fgcolor = "4"

			end if
		else
			Container0.contCALL.visible = false
			Container0.lblNoData.visible = true

		end if

		'-----------------------------------------------------------------------------
		Container0.contCALL.lblStep1.caption = "등록신청"
		Container0.contCALL.lblStep2.caption = "접수진행"

		if Form.GetSharedData("123r_CNCL_CNTT") = "S" then
			Container0.contCALL.lblStep3.caption = "등록완료"
		end if

	end if
End Function

'============================================================================
'진행현황 상태 메시지(취소버튼 포함) 셋팅
'============================================================================
Function f_setProgress_2()

	Container0.lblNoData.visible = false

	if g_szINVE_APLT_STCD = "0" or	'등록신청
			g_szINVE_APLT_STCD = "1" or		'접수완료
			g_szINVE_APLT_STCD = "2" or		'영상통화
			g_szINVE_APLT_STCD = "3" then	'영상통화

		'취소 버튼 노출
		Container0.btnCancel.visible = true
		Container0.lblCancelMsg.visible = false

	elseif g_szINVE_APLT_STCD = "4" or
			g_szINVE_APLT_STCD = "9" then

		'처리 결과 노출
		Container0.btnCancel.visible = false
		Container0.lblCancelMsg.visible = true

		if g_szINVE_APLT_STCD = "4" and
					szVALD_FIN_DATE<> NULL and (cint(szVALD_FIN_DATE) < cint(Form.GetSharedData("&HOST_DATE", false))) then
			Container0.lblCancelMsg.caption = "유효기간 만료일이 경과했습니다."
			Container0.lblCancelMsg.fgcolor = "6"
		elseif g_szINVE_APLT_STCD = "4" and (Form.GetSharedData("123r_CNCL_CNTT") = "S" or Form.GetSharedData("123r_CNCL_CNTT") = "") then
			Container0.lblCancelMsg.caption = "장외파생상품 거래가 가능해졌습니다."
			Container0.lblCancelMsg.fgcolor = "4"
		end if

		'if g_szVCALL_TRGT_YN = "Y" then	'영상통화 대상
			if g_szINVE_APLT_STCD = "9" then
'				if Form.GetSharedData("123r_CNCL_CNTT") = "A" then	'요건미충족 or 서류확인불가
				if Form.GetSharedData("123r_CNCL_CNTT") = "2" then	'요건미충족 or 서류확인불가
					Container0.lblCancelMsg.caption = "거래요건 미충족으로 자동 취소되었습니다."
					Container0.lblCancelMsg.fgcolor = "6"

					g_DetailHidden = "Y"	'상세정보 박스안에 미표시

'				elseif Form.GetSharedData("123r_CNCL_CNTT") = "B" then	'요건미충족 or 서류확인불가
				elseif Form.GetSharedData("123r_CNCL_CNTT") = "3" then	'요건미충족 or 서류확인불가
					Container0.lblCancelMsg.caption = "서류확인 불가로 자동취소 되었습니다.."
					Container0.lblCancelMsg.fgcolor = "6"

					g_DetailHidden = "Y"	'상세정보 박스안에 미표시

'				elseif Form.GetSharedData("123r_CNCL_CNTT") = "C" then	'영상불가
				elseif Form.GetSharedData("123r_CNCL_CNTT") = "4" then	'영상불가
					Container0.lblCancelMsg.caption = "영상통화 미수신으로 자동 취소되었습니다."
					Container0.lblCancelMsg.fgcolor = "6"

					g_DetailHidden = "Y"	'상세정보 박스안에 미표시

				elseif Form.GetSharedData("123r_CNCL_CNTT") = "9" then
					Container0.lblCancelMsg.caption = "신청 내역이 취소되었습니다."
					Container0.lblCancelMsg.fgcolor = "4"

					g_DetailHidden = "Y"	'상세정보 박스안에 미표시
				else
					Container0.lblCancelMsg.caption = "신청 내역이 취소되었습니다."
					Container0.lblCancelMsg.fgcolor = "4"

					g_DetailHidden = "Y"	'상세정보 박스안에 미표시
				end if
			'end if

'		elseif g_szVCALL_TRGT_YN = "N" then
'			if g_szINVE_APLT_STCD = "9" and (Form.GetSharedData("123r_CNCL_CNTT") = "A" then
'				Container0.lblCancelMsg.caption = "거래요건 미충족으로 자동 취소되었습니다."
'				Container0.lblCancelMsg.fgcolor = "6"
'
'				g_DetailHidden = "Y"	'상세정보 박스안에 미표시
'
'
'
'				or Form.GetSharedData("123r_CNCL_CNTT") = "B") then	'요건미충족 or 서류확인불가
'
'
'			elseif g_szINVE_APLT_STCD = "9" and Form.GetSharedData("123r_CNCL_CNTT") = "9" then
'				Container0.lblCancelMsg.caption = "신청 내역이 취소되었습니다."
'				Container0.lblCancelMsg.fgcolor = "4"
'
'				g_DetailHidden = "Y"	'상세정보 박스안에 미표시
'
'			end if

		end if

	end if

End Function

