	<SCRIPT_INFO _len="36934" _ulen="34182" >
'--===========================================================================
' 01. 화 면 명 : 장외파생상품 투자요건 등록내역
' 02. 화면설명 : 메인화면
' 03. 작    성 :
' 04. 수    정 :
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_nStep '현재 스텝
Dim g_szApplyAbleYN '신청 가능YN
Dim g_szSRNO 	'신분증 진위 확인 후, 받은 일련번호

Dim g_szVCALL_TRGT_YN
Dim g_szINVE_APLT_STCD

Dim g_DetailHidden	'상세정보 박스안에 내용 모두 미표시
Dim g_DetailDateHidden		'상세정보 박스안에 내용 중 등록일자, 유효기간 미표시

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N
'****************************************************************************

''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N
''****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	Container0.contVCALL.imgVStep1.setMaintainingRatio("1")
	Container0.contVCALL.imgVStep2.setMaintainingRatio("1")
	Container0.contVCALL.imgVStep3.setMaintainingRatio("1")
	Container0.contVCALL.imgVStep4.setMaintainingRatio("1")

	Container0.contCALL.imgVStep1.setMaintainingRatio("1")
	Container0.contCALL.imgVStep2.setMaintainingRatio("1")
	Container0.contCALL.imgVStep3.setMaintainingRatio("1")

	Container0.contCheck.imgFold.setMaintainingRatio("1")
End Sub

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	Container0.lblList.caption = "신청내역 >"
	Container0.lblList.fgcolor = "67"

	f_InitScreen()

	g_DetailHidden = ""
	g_DetailDateHidden = ""

	DATAMANAGER.RequestTranData( "obcsb_acif_123r" )
	DATAMANAGER.RequestTranData( "obcsb_acif_125r" )	'취소한 내역만 있는 고객의 경우 신청내역 버튼 보이기 위해 추가.

	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		Container0.contCheck.setScrollBarVisible("2")
		Container0.setScrollBarVisible("2")
	end if


End Sub

'============================================================================
' Form_OnMsgBoxClose(sKeyName, sRet)
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "Close_Form" then
		if sRet == "ok" then
			Form.CloseForm()
		end if

	elseif sKeyName = "Cancel_YN" then
		if sRet = "ok" then	'예

			DATAMANAGER.RequestTranData( "obcsb_acif_124a" )
		else 		'아니오
			Exit Sub
		end if
	end if
End Sub

'============================================================================
Sub Container0_btnCancel_OnClick()
	Dim szAccount
	szAccount = Account0.caption


	if szAccount <> "" and szAccount <> NULL then
		Form.MsgBox("알림", "신청 취소 하시겠습니까?", "Cancel_YN", "1")
	else
		Form.ShowAlert("알림", "계좌번호를 확인하세요.")
	end if
End Sub

'============================================================================
Sub Container0_lblList_OnClick()
	Dim szAccount
	szAccount = Account0.caption

	if szAccount <> "" and szAccount <> NULL then
		Form.openPopupAnimation("mbonl94005_p2", szAccount,"","2")
	else
		Form.ShowAlert("알림", "계좌번호를 확인하세요.")
	end if
End Sub


''****************************************************************************
''               		D A T A				M A N A G E R
''****************************************************************************

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 인풋 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCustNum, szHostDate, szAccount

	szCustNum = Form.GetSharedData("&CUST_NUM", false )
	szHostDate = Form.GetSharedData("&HOST_DATE", false)
	szAccount = Account0.caption

	if szTranID == "obcsb_acif_123r" then	'장외파생투자요건 상태조회
		DATAMANAGER.ClearInputData(0, "obcsb_acif_123r")
'		DATAMANAGER.ClearOutputData(0, "obcsb_acif_123r")

		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "2"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ACNO" , 0 , szAccount )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0 , szCustNum  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0 , szCustNum  )

	elseif szTranID == "obcsb_acif_124a" then	'장외파생투자요건 등록 취소
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ACNO" , 0 , szAccount )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0 , szCustNum  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "INVE_APLT_STCD" , 0 , "9"  )	'0:등록/9:취소
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "INVE_CNCL_CLCD" , 0 , "1"  )	'Z:고객요청
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "VCALL_TRGT_YN" , 0 , g_szVCALL_TRGT_YN )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "APLT_DATE" , 0 , szHostDate )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "IDNTF_SRNO" , 0 , g_szSRNO  )

	elseif szTranID == "obcsb_acif_125r" then
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ACNO" , 0 , szAccount  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "IQRY_STA_DATE" , 0 , "00010101"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "IQRY_FIN_DATE" , 0 , "99991231" )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "APLT_DPCD" , 0 , "%"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "INVE_APLT_STCD" , 0 , "%"  )

	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcsb_acif_123r" then
		'---------- 초기화 ----------
		g_szVCALL_TRGT_YN = ""
		g_szSRNO = ""
		g_szINVE_APLT_STCD = ""
		szAPLT_DATE = ""
		szSFCN_YN = ""
		szAVRG_RMND_AMT = 0
		szCONT_CLS_CODE = ""
		szVALD_STA_DATE = ""
		szVALD_FIN_DATE = ""
		szREG_DATE = ""
		szINVE_CNCL_CLCD = ""
		szPFIN_RGNO = ""

		'---------- OutBlock1 ----------
		g_szVCALL_TRGT_YN		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "VCALL_TRGT_YN" , 0 )	'영상통화여부
		g_szSRNO				= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "APLT_SRNO" , 0 )	'신청일련번호
		g_szINVE_APLT_STCD	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "INVE_APLT_STCD" , 0 )	'투자경험신청상태코드

		szAPLT_DATE 		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "APLT_DATE" , 0 )	'신청일자
		szSFCN_YN 		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "SFCN_YN" , 0 )	'충족여부
		szAVRG_RMND_AMT	= FormatNumber(DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "AVRG_RMND_AMT" , 0  ),0) '평균잔고금액
		szCONT_CLS_CODE 	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "CONT_CLS_CODE" , 0 )	'접촉구분코드
		szPRSN_PFIN_YN 	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "PRSN_PFIN_YN" , 0  ) 	'개인전문투자자여부

'		szVALD_STA_DATE 	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "VALD_STA_DATE" , 0 )	'유효시작일자
		szVALD_FIN_DATE_Outblock1 	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "VALD_FIN_DATE" , 0 )	'유효종료일자
'		szREG_DATE		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "REG_DATE" , 0 )	'등록일자
		szINVE_CNCL_CLCD	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "INVE_CNCL_CLCD" , 0 )	'취소내용
		szOTCO_INPUT_CSNU	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "OTCO_INPUT_CSNU" , 0 )	'타사입력건수

		'---------- OutBlock2 ----------
		szPFIN_RGNO 			= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "PFIN_RGNO" , 0 )	'전문투자자등록번호
		szDSGT_DATE 			= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "DSGT_DATE" , 0  ) 	'지정일자
		szVALD_STA_DATE_2 	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "VALD_STA_DATE" , 0  )
		szVALD_FIN_DATE_2 	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "VALD_FIN_DATE" , 0  )

		'---------- OutBlock3 ----------
		szREG_DATE 		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock3" , "REG_DATE" , 0  )
		szVALD_STA_DATE 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock3" , "VALD_STA_DATE" , 0  )
		szVALD_FIN_DATE 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock3" , "VALD_FIN_DATE" , 0  )

		'----- 유효기간 만료 3개월 전 안내팝업 오픈 -----
		if szVALD_FIN_DATE_Outblock1 <> "" and szVALD_FIN_DATE_Outblock1 <> Null then
			szHostDate = Form.GetSharedData("&HOST_DATE", false)

			szFromDate = Left(szHostDate,4) .."-" ..Mid(szHostDate,5,2) .."-"..Right(szHostDate,2)
			szToDate = Left(szVALD_FIN_DATE_Outblock1,4) .."-" ..Mid(szVALD_FIN_DATE_Outblock1,5,2) .."-"..Right(szVALD_FIN_DATE_Outblock1,2)

			if DateDiff("m", szFromDate, szTodate) > 0 and DateDiff("m", szFromDate, szTodate) < 4 then
				Form.openPopupAnimation("mbonl94005_p1", szVALD_FIN_DATE_Outblock1, "", "2")
			end if
		end if
		'----- 유효기간 만료 3개월 전 안내팝업 오픈 -----


		'----- '진행현황 셋팅 -----
		Form.SetSharedData("123r_CNCL_CNTT" , szINVE_CNCL_CLCD)	'취소내용
'ShowAlert(szVALD_FIN_DATE_2 , szVALD_FIN_DATE)
'ShowAlert(g_szVCALL_TRGT_YN, g_szINVE_APLT_STCD .. ";" .. Form.GetSharedData("123r_CNCL_CNTT"))
'
'g_szVCALL_TRGT_YN = "Y"
'g_szINVE_APLT_STCD = "4"
'Form.SetSharedData("123r_CNCL_CNTT" , "")
'szVALD_STA_DATE_2 = ""
'szVALD_FIN_DATE_2 = ""
'szVALD_STA_DATE = "20230801"
'szVALD_FIN_DATE = "20240801"

		f_setProgress()	'영상통화 대상/미대상 진행현황 상태 이미지 셋팅
		f_setProgress_2()	'진행현황 상태 메시지(취소버튼 포함) 셋팅
		'----- '진행현황 셋팅 -----

		'----- '상세정보 셋팅 -----
		if g_szINVE_APLT_STCD = "T"  then	'등록내역없음

			Container0.contVCALL.visible = false
			Container0.contCALL.visible = false
			Container0.btnCancel.visible = false

			'미신청상태에는 상세정보 표시 안함. (박효정과장 요청)
			Container0.lblTitle0.visible = false
			Container0.imgBoxDetail.visible = false
			Container0.lblNoDataDetail.visible = false

			Container0.tblInfo.visible = false

			Container0.Label0.visible = false
			Container0.lblLine.visible = false
			Container0.Label7.visible = false
			Container0.Label1.visible = false
			Container0.Label2.visible = false
			Container0.Label3.visible = false
			Container0.Label4.visible = false
			Container0.Label5.visible = false
			Container0.Label6.visible = false

			Container0.lblStatus.visible = false
			Container0.lblData0.visible = false
			Container0.lblData1.visible = false
			Container0.lblData2.visible = false
			Container0.lblData3.visible = false
			Container0.lblData4.visible = false
			Container0.lblData5.visible = false
			Container0.lblData6.visible = false
			Container0.lblNoData.visible = true

		elseif g_DetailHidden = "Y" then	'고객취소, 요건미충족취소, 서류확인불가취소, 영상통화불가취소시 상세정보 박스안에 미표시

			Container0.lblTitle0.visible = true
			Container0.imgBoxDetail.visible = true
			Container0.lblNoDataDetail.visible = true

			Container0.imgBoxDetail.visible = true

			Container0.Label0.visible = false
			Container0.lblLine.visible = false
			Container0.Label7.visible = false
			Container0.Label1.visible = false
			Container0.Label2.visible = false
			Container0.Label3.visible = false
			Container0.Label4.visible = false
			Container0.Label5.visible = false
			Container0.Label6.visible = false

			Container0.lblStatus.visible = false
			Container0.lblData0.visible = false
			Container0.lblData1.visible = false
			Container0.lblData2.visible = false
			Container0.lblData3.visible = false
			Container0.lblData4.visible = false
			Container0.lblData5.visible = false
			Container0.lblData6.visible = false

		elseif g_szINVE_APLT_STCD = "" then
			Container0.lblTitle0.visible = true
			Container0.imgBoxDetail.visible = true
			Container0.lblNoDataDetail.visible = true
			Container0.lblNoData.visible = true

		else

			Container0.lblTitle0.visible = true
			Container0.imgBoxDetail.visible = true
			Container0.lblNoDataDetail.visible = false

			Container0.tblInfo.visible = true

			Container0.Label0.visible = true
			Container0.lblLine.visible = true
			Container0.Label7.visible = true
			Container0.Label1.visible = true
			Container0.Label2.visible = true
			Container0.Label3.visible = true
			Container0.Label4.visible = true
			Container0.Label5.visible = true
			Container0.Label6.visible = true

			Container0.lblStatus.visible = true
			Container0.lblData0.visible = true
			Container0.lblData1.visible = true
			Container0.lblData2.visible = true
			Container0.lblData3.visible = true
			Container0.lblData4.visible = true
			Container0.lblData5.visible = true
			Container0.lblData6.visible = true


			'----- '신청방식 -----
			if szCONT_CLS_CODE == "1" then
				szCONT_CLS_CODE_NAME = "창구"
			elseif szCONT_CLS_CODE == "3" then
				szCONT_CLS_CODE_NAME = "방문판매"
			elseif szCONT_CLS_CODE == "4" then
				szCONT_CLS_CODE_NAME = "MTS"
			else
				szCONT_CLS_CODE_NAME = szCONT_CLS_CODE
			end if

			Container0.lblData0.caption = szPFIN_RGNO			'기준 전문투자자 지정번호
			Container0.lblData1.caption = szCONT_CLS_CODE_NAME	'신청방식
			Container0.lblData2.caption = szAPLT_DATE			'신청일자

			if Cint(szOTCO_INPUT_CSNU) = 0 then
				szOTCO_INPUT_CSNU = "당사"
			else
				szOTCO_INPUT_CSNU = "당사+타사"
			end if
			Container0.lblData3.caption = szOTCO_INPUT_CSNU			'투자경험


			'충족여부 | 잔고
			if szSFCN_YN = "Y" then
				Container0.lblData4.caption = "충족" .. " | " .. szAVRG_RMND_AMT .. "원"
				Container0.lblData4.changeTextAttr(0, 2, 7, -1, true)
			else
				Container0.lblData4.caption = "미충족" .. " | " .. szAVRG_RMND_AMT .. "원"
				Container0.lblData4.changeTextAttr(0, 3, 6, -1, true)
			end if

			'등록일자
			if g_DetailDateHidden = "Y" then
				Container0.lblData5.caption = "-"
			elseif szREG_DATE <> "" and szREG_DATE <> "NULL" then
				Container0.lblData5.caption = szREG_DATE
			elseif szDSGT_DATE <> "" and szDSGT_DATE <> "NULL" then
				Container0.lblData5.caption = szDSGT_DATE
			else
				Container0.lblData5.caption = "-"
			end if

			'유효기간
			if g_DetailDateHidden = "Y" then
				Container0.lblData6.caption = "-"

				Form.SetSharedData("Real_VALD_FIN_DATE" , "")

			elseif (szVALD_FIN_DATE <> "" and szVALD_FIN_DATE <> "NULL") then
				Form.SetSharedData("Real_VALD_FIN_DATE" , szVALD_FIN_DATE)

				szVALD_STA_DATE = Left(szVALD_STA_DATE,4) .. "." .. Mid(szVALD_STA_DATE,5,2) .. "." .. Right(szVALD_STA_DATE,2)
				szVALD_FIN_DATE = Left(szVALD_FIN_DATE,4) .. "." .. Mid(szVALD_FIN_DATE,5,2) .. "." .. Right(szVALD_FIN_DATE,2)
				Container0.lblData6.caption = szVALD_STA_DATE .. " ~ " .. szVALD_FIN_DATE 	'유효기간

			elseif (szVALD_FIN_DATE_2 <> "" and szVALD_FIN_DATE_2 <> "NULL") then
				Form.SetSharedData("Real_VALD_FIN_DATE" , szVALD_FIN_DATE_2)
				szVALD_STA_DATE_2 = Left(szVALD_STA_DATE_2,4) .. "." .. Mid(szVALD_STA_DATE_2,5,2) .. "." .. Right(szVALD_STA_DATE_2,2)
				szVALD_FIN_DATE_2 = Left(szVALD_FIN_DATE_2,4) .. "." .. Mid(szVALD_FIN_DATE_2,5,2) .. "." .. Right(szVALD_FIN_DATE_2,2)
				Container0.lblData6.caption = szVALD_STA_DATE_2 .. " ~ " .. szVALD_FIN_DATE_2 	'유효기간

			else
				Container0.lblData6.caption = "-"

				Form.SetSharedData("Real_VALD_FIN_DATE" , "")
			end if


			'거래요건 등록 상태 : 등록 또는 미등록 으로만 표시.
			'					진행현황 등록 완료 후,
			'						- 유효기간 내 "등록"
			'						- 유효기간 만료 또는 없는 경우 "미등록"
			if Trim(g_szINVE_APLT_STCD) <> "" and Trim(g_szINVE_APLT_STCD) <> NULL then
				if g_szINVE_APLT_STCD = "0" then	'등록신청
					szStatusNm = "미등록"
				elseif g_szINVE_APLT_STCD = "1" then	'접수완료
					szStatusNm = "미등록"
				elseif g_szINVE_APLT_STCD = "2" then	'영상통화
					szStatusNm = "미등록"
				elseif g_szINVE_APLT_STCD = "3" then	'영상통화(등록요청)
					szStatusNm = "미등록"
				elseif g_szINVE_APLT_STCD = "4" then	'등록완료
					if Cint(Form.GetSharedData("Real_VALD_FIN_DATE")) > Cint(Form.GetSharedData("&HOST_DATE", false)) then	' 효력일이 남아있으니 "등록"
						szStatusNm = "등록"
					else
						szStatusNm = "미등록"
					end if
				elseif g_szINVE_APLT_STCD = "9" then	'취소
					szStatusNm = "미등록"
				elseif g_szINVE_APLT_STCD = "T" then	'임시저장
					szStatusNm = "미등록"
				end if

				Container0.lblStatus.caption = szStatusNm
			end if
		end if
		'----- '상세정보 셋팅 -----


	elseif szTranID == "obcsb_acif_124a" then	'장외파생투자요건 등록 취소
		Form.ShowAlert("알림", "신청이 취소되었습니다.")

		f_InitScreen()

		g_DetailHidden = ""
		g_DetailDateHidden = ""

		DATAMANAGER.RequestTranData( "obcsb_acif_123r" )
		DATAMANAGER.RequestTranData( "obcsb_acif_125r" )	'취소한 내역만 있는 고객의 경우 신청내역 버튼 보이기 위해 추가.

	elseif szTranID == "obcsb_acif_125r" then
		Dim nCnt
		nCnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock1" ))
		if nCnt = 0 or nCnt = NULL  then
			Container0.lblList.visible = false
		else
			Container0.lblList.visible = true
		end if

	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	if szTranID == "obcsb_acif_123r" then
		Dim szErrorMsg
		szErrorMsg = szErrMsg & "(" & szSubMsg & ")"

		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")

	else
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	end if
End Sub

'============================================================================
Sub Container0_contCheck_lblInfo_OnClick()
	Container0_contCheck_imgFold_OnClick()
End Sub

'============================================================================
Sub Container0_contCheck_imgFold_OnClick()
	Dim szimgFile

	if bFoldState then
		szimgFile = "icon_arrow_down.png"
	else
		szimgFile = "icon_arrow_up.png"
	end if

	bFoldState = not bFoldState
	Container0.contCheck.imgFold.imgpath = szimgFile
	f_ShowInfo(bFoldState)
End Sub

'============================================================================
Function f_ShowInfo(bState)
	if bState then
		Container0.contCheck.height = 30+90
		Container0.contCheck.SetScrollAutoSize()

		Container0.scroll_pos = 30+90

		Container0.SetScrollAutoSize()
	else
		Container0.contCheck.height = 35
		Container0.contCheck.SetScrollAutoSize()

		Container0.scroll_pos = 0

		Container0.SetScrollAutoSize()
	end if
End Function

'============================================================================
Sub btnBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Function f_InitScreen()
	Container0.contVCALL.visible = false
	Container0.contCALL.visible = false
	Container0.btnCancel.visible = false

	Container0.lblNoData.visible = true

	'미신청상태에는 상세정보 표시 안함. (박효정과장 요청)
	Container0.lblTitle0.visible = false
	Container0.imgBoxDetail.visible = false
	Container0.lblNoDataDetail.visible = false

	Container0.tblInfo.visible = false

	Container0.Label0.visible = false
	Container0.lblLine.visible = false
	Container0.Label7.visible = false
	Container0.Label1.visible = false
	Container0.Label2.visible = false
	Container0.Label3.visible = false
	Container0.Label4.visible = false
	Container0.Label5.visible = false
	Container0.Label6.visible = false

	Container0.lblStatus.visible = false
	Container0.lblData0.visible = false
	Container0.lblData1.visible = false
	Container0.lblData2.visible = false
	Container0.lblData3.visible = false
	Container0.lblData4.visible = false
	Container0.lblData5.visible = false
	Container0.lblData6.visible = false
End Function

'============================================================================
'영상통화 대상/미대상 진행현황 상태 이미지 셋팅
'============================================================================
Function f_setProgress()

	if g_szVCALL_TRGT_YN = "Y" then	'영상통화 대상
		Container0.lblNoData.visible = false
		Container0.contVCALL.visible = true
		Container0.contCALL.visible = false

		if g_szINVE_APLT_STCD = "0" then	'등록신청
			Container0.contVCALL.imgVStep1.imgpath = "wrap_btn_check_navy"
			Container0.contVCALL.imgVStep2.imgpath = "wrap_btn_check_gray"
			Container0.contVCALL.imgVStep3.imgpath = "wrap_btn_check_gray"
			Container0.contVCALL.imgVStep4.imgpath = "wrap_btn_check_gray"

			Container0.contCALL.lblVStep1.fgcolor = "4"
			Container0.contCALL.lblVStep2.fgcolor = "146"
			Container0.contCALL.lblVStep3.fgcolor = "146"
			Container0.contCALL.lblVStep4.fgcolor = "146"

			g_DetailDateHidden = "Y"

		elseif g_szINVE_APLT_STCD = "1" then		'접수완료
			Container0.contVCALL.imgVStep1.imgpath = "wrap_btn_check_navy"
			Container0.contVCALL.imgVStep2.imgpath = "wrap_btn_check_navy"
			Container0.contVCALL.imgVStep3.imgpath = "wrap_btn_check_gray"
			Container0.contVCALL.imgVStep4.imgpath = "wrap_btn_check_gray"

			Container0.contCALL.lblVStep1.fgcolor = "4"
			Container0.contCALL.lblVStep2.fgcolor = "4"
			Container0.contCALL.lblVStep3.fgcolor = "146"
			Container0.contCALL.lblVStep4.fgcolor = "146"

			g_DetailDateHidden = "Y"

		elseif g_szINVE_APLT_STCD = "2" or g_szINVE_APLT_STCD = "3" then		'영상통화
			Container0.contVCALL.imgVStep1.imgpath = "wrap_btn_check_navy"
			Container0.contVCALL.imgVStep2.imgpath = "wrap_btn_check_navy"
			Container0.contVCALL.imgVStep3.imgpath = "wrap_btn_check_navy"
			Container0.contVCALL.imgVStep4.imgpath = "wrap_btn_check_gray"

			Container0.contCALL.lblVStep1.fgcolor = "4"
			Container0.contCALL.lblVStep2.fgcolor = "4"
			Container0.contCALL.lblVStep3.fgcolor = "4"
			Container0.contCALL.lblVStep4.fgcolor = "146"

			g_DetailDateHidden = "Y"

		elseif g_szINVE_APLT_STCD = "4" then		'등록완료
			if szVALD_FIN_DATE<> NULL and (cint(szVALD_FIN_DATE) < cint(Form.GetSharedData("&HOST_DATE", false))) then
				Container0.contVCALL.imgVStep1.imgpath = "wrap_btn_check_gray"
				Container0.contVCALL.imgVStep2.imgpath = "wrap_btn_check_gray"
				Container0.contVCALL.imgVStep3.imgpath = "wrap_btn_check_gray"
				Container0.contVCALL.imgVStep4.imgpath = "wrap_btn_check_gray"

			elseif Form.GetSharedData("123r_CNCL_CNTT") = "S" or Form.GetSharedData("123r_CNCL_CNTT") = ""   then
				Container0.contVCALL.imgVStep1.imgpath = "wrap_btn_check_navy"
				Container0.contVCALL.imgVStep2.imgpath = "wrap_btn_check_navy"
				Container0.contVCALL.imgVStep3.imgpath = "wrap_btn_check_navy"
				Container0.contVCALL.imgVStep4.imgpath = "wrap_btn_check_navy"

			end if
			Container0.contCALL.lblVStep1.fgcolor = "4"
			Container0.contCALL.lblVStep2.fgcolor = "4"
			Container0.contCALL.lblVStep3.fgcolor = "4"
			Container0.contCALL.lblVStep4.fgcolor = "4"

		elseif g_szINVE_APLT_STCD = "9" then
'			if Form.GetSharedData("123r_CNCL_CNTT") = "A" or Form.GetSharedData("123r_CNCL_CNTT") = "B" then	'A:요건미충족취소/B:서류확인불가취소
			if Form.GetSharedData("123r_CNCL_CNTT") = "2" or Form.GetSharedData("123r_CNCL_CNTT") = "3" then	'2:요건미충족취소/3:서류확인불가취소
				Container0.contVCALL.imgVStep1.imgpath = "wrap_btn_check_navy"
				Container0.contVCALL.imgVStep2.imgpath = "wrap_btn_check_navy"
				Container0.contVCALL.imgVStep3.imgpath = "wrap_btn_check_gray"
				Container0.contVCALL.imgVStep4.imgpath = "wrap_btn_check_gray"

				Container0.contCALL.lblVStep1.fgcolor = "4"
				Container0.contCALL.lblVStep2.fgcolor = "6"
				Container0.contCALL.lblVStep3.fgcolor = "4"
				Container0.contCALL.lblVStep4.fgcolor = "4"

'			elseif  Form.GetSharedData("123r_CNCL_CNTT") = "C" then	'C:영상통화불가취소
			elseif  Form.GetSharedData("123r_CNCL_CNTT") = "4" then	'4:영상통화불가취소
				Container0.contVCALL.imgVStep1.imgpath = "wrap_btn_check_navy"
				Container0.contVCALL.imgVStep2.imgpath = "wrap_btn_check_navy"
				Container0.contVCALL.imgVStep3.imgpath = "wrap_btn_check_navy"
				Container0.contVCALL.imgVStep4.imgpath = "wrap_btn_check_gray"

				Container0.contCALL.lblVStep1.fgcolor = "4"
				Container0.contCALL.lblVStep2.fgcolor = "4"
				Container0.contCALL.lblVStep3.fgcolor = "6"
				Container0.contCALL.lblVStep4.fgcolor = "4"

			else	'고객취소
				Container0.contVCALL.imgVStep1.imgpath = "wrap_btn_check_gray"
				Container0.contVCALL.imgVStep2.imgpath = "wrap_btn_check_gray"
				Container0.contVCALL.imgVStep3.imgpath = "wrap_btn_check_gray"
				Container0.contVCALL.imgVStep4.imgpath = "wrap_btn_check_gray"

			end if

		elseif g_szINVE_APLT_STCD = "" then		'취소

			Container0.contVCALL.visible = false
			Container0.lblNoData.visible = true

		end if

		'-----------------------------------------------------------------------------
		Container0.contVCALL.lblVStep1.caption = "등록신청"
		Container0.contVCALL.lblVStep2.caption = "접수완료"
		Container0.contVCALL.lblVStep3.caption = "영상통화"
		Container0.contVCALL.lblVStep4.caption = "등록완료"

		if g_szINVE_APLT_STCD = "0" then	'등록신청
			'Container0.contVCALL.lblVStep1.caption = "등록신청"
			Container0.btnCancel.visible = false

		elseif g_szINVE_APLT_STCD = "1" then		'접수완료
			Container0.contVCALL.lblVStep2.caption = "접수완료"
			Container0.contVCALL.lblVStep2.fgcolor = "4"

		elseif g_szINVE_APLT_STCD = "2" or g_szINVE_APLT_STCD = "3" then		'영상통화

			Container0.contVCALL.lblVStep3.caption = "영상통화"
			Container0.contVCALL.lblVStep3.fgcolor = "4"

		elseif g_szINVE_APLT_STCD = "4" then		'등록완료
