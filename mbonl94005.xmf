		elseif g_szINVE_APLT_STCD = "9" then
'			if Form.GetSharedData("123r_CNCL_CNTT") = "A" then
			if Form.GetSharedData("123r_CNCL_CNTT") = "2" then
				Container0.contVCALL.lblVStep2.caption = "접수불가"
				Container0.contVCALL.lblVStep2.fgcolor = "6"

