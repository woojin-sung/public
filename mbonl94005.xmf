			Container0.contVCALL.lblVStep4.caption = "등록완료"
		end if


	else			'영상통화 미대상

		Container0.lblNoData.visible = false
		Container0.contVCALL.visible = false
		Container0.contCALL.visible = true

		if g_szINVE_APLT_STCD = "0" then	'등록신청
			Container0.contCALL.imgStep1.imgpath = "wrap_btn_check_navy"
			Container0.contCALL.imgStep2.imgpath = "wrap_btn_check_gray"
			Container0.contCALL.imgStep3.imgpath = "wrap_btn_check_gray"

			Container0.contCALL.lblStep1.fgcolor = "4"
			Container0.contCALL.lblStep2.fgcolor = "146"
			Container0.contCALL.lblStep3.fgcolor = "146"

			g_DetailDateHidden = "Y"

		elseif g_szINVE_APLT_STCD = "1" or g_szINVE_APLT_STCD = "2" or g_szINVE_APLT_STCD = "3" then		'접수완료
			Container0.contCALL.imgStep1.imgpath = "wrap_btn_check_navy"
			Container0.contCALL.imgStep2.imgpath = "wrap_btn_check_navy"
			Container0.contCALL.imgStep3.imgpath = "wrap_btn_check_gray"

			Container0.contCALL.lblStep1.fgcolor = "146"
			Container0.contCALL.lblStep2.fgcolor = "4"
			Container0.contCALL.lblStep3.fgcolor = "146"

			g_DetailDateHidden = "Y"

		elseif g_szINVE_APLT_STCD = "4" then		'등록완료
			Container0.contCALL.imgStep1.imgpath = "wrap_btn_check_navy"
			Container0.contCALL.imgStep2.imgpath = "wrap_btn_check_navy"
			Container0.contCALL.imgStep3.imgpath = "wrap_btn_check_navy"

			Container0.contCALL.lblStep1.fgcolor = "146"
			Container0.contCALL.lblStep2.fgcolor = "146"
			Container0.contCALL.lblStep3.fgcolor = "4"

		elseif g_szINVE_APLT_STCD = "9" then
'			if Form.GetSharedData("123r_CNCL_CNTT") = "A" or Form.GetSharedData("123r_CNCL_CNTT") = "B" or Form.GetSharedData("123r_CNCL_CNTT") = "C"  then
			if Form.GetSharedData("123r_CNCL_CNTT") = "2" or Form.GetSharedData("123r_CNCL_CNTT") = "3" or Form.GetSharedData("123r_CNCL_CNTT") = "4"  then
