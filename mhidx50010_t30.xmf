	</CONTROL_INFO>
	<SCRIPT_INFO _len="546" _ulen="480" >
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "SELECT_JISU" then
		
		arrData = Split(sParam,"@")
		
		if #arrData > 1 then
		
			'부모화면 맵 이미지 변경 트리거
			Form.triggerEvent("#", "CHANGE_MAP_IMAGE", sParam)
			
			'폼탭화면 현재 선택된 지수 외 포커스 이미지 해제
			for i = 0 to 1 
				Form.triggerEvent("FormTab0.".."page"..i, "SELECT_INDEX", arrData(1))
			next
			
		
		end if
		
	
	end if

End Sub
	</SCRIPT_INFO>
