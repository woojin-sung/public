	<FORM_INFO name="Form" transmode="0" ly_vert="0,0,360,222,1" />
	<CONTROL_INFO>
		<FORMTAB name="FormTab0" tabcount="2" tabheadheight="0" usepg="1" pgbarheight="20" ly_vert="0,0,375,222,1" >
