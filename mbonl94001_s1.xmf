	<SCRIPT_INFO _len="13876" _ulen="12852" >
'--===========================================================================
' 01. 화 면 명 : 전문투자자상태조회_지정상태탭
' 02. 화면설명 : 
' 03. 작    성 : 2021.06.08 정효영
' 04. 수    정 : 
'
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_nClick
g_nClick = 0

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' f_RequestTR() : 고객 번호 체크후 TR 요청
'============================================================================
Function f_RequestTR()
	Dim szCustNum
	szCustNum = Form.GetSharedData("&CUST_NUM", false )
	
	if szCustNum <> "" then
		DATAMANAGER.RequestTranData( "obcsb_acif_097r" )
	end if
End Function

'============================================================================
' f_SetData(szTranID) : 데이터 세팅
'============================================================================
Function f_SetData(szTranID)
	Dim nCount
	nCount = tonumber(DATAMANAGER.GetDataCount( false, szTranID , "OutBlock3" ))	
	
	Container0.grdHistory.rowcount = nCount
	
	if nCount == 0 then
		Container0.contState.lblNoData.caption = "지정 신청 내역이 없습니다."
			
		Container0.contState.tblState.visible = false
		Container0.contState.lblNoData.visible = true
			
	else
		Dim isIngList
		Dim szApltDate, szStatCode, szPrgsCode, szResultCode, szApltSrno
	
		isIngList = false
	
		'형식 맞춰주고 코드 내려오는걸로 매핑해서 담아야 하므로 여기서 세팅
		for i=0 to (nCount-1)
			szApltDate = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock3" , "APLT_DATE" , i )
			szStatCode = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock3" , "EXAM_PRGS_STAT_CODE" , i )
			szApltSrno = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock3" , "APLT_SRNO" , i )
			szPrgsCode = Form.GetMetaData("심사진행상태코드", szStatCode)
			szResultCode = Form.GetMetaData("심사결과코드", DATAMANAGER.GetDataValue( false, szTranID , "OutBlock3" , "EXAM_RSLT_CODE" , i ))
		
			'상태가 "심사취소"이면 심사 결과 "취소"로 표기 (06.29 권오상 차장님요청)
			if szPrgsCode == "심사취소" then
				szResultCode = "취소"
			
			else
				'채화석 부장님 요청으로 심사결과 치환 : 해당없음-> 신청중, 녹취완료 -> 심사중
				if szResultCode == "해당없음" then
					isIngList = true
					szResultCode = "신청중"
					
				elseif szResultCode == "녹취완료" then
					szResultCode = "심사중"
				end if
			end if
			
			Container0.grdHistory.SetCellData( "bd_Date", i, szApltDate )
			Container0.grdHistory.SetCellData( "bd_Result", i, szResultCode )
			Container0.grdHistory.SetCellData( "bd_StateCode", i, szStatCode )
			Container0.grdHistory.SetCellData( "bd_ReqNum", i, szApltSrno )
			
			if szStatCode == "0" or szStatCode == "2" then
				Container0.grdHistory.SetCellData( "bd_State", i, "취소" )
				Container0.grdHistory.SetCellEnable( "bd_State", i, true )
			else
'				Container0.grdHistory.SetCellData( "bd_State", i, szPrgsCode & "`alpha")
				Container0.grdHistory.SetCellData( "bd_State", i, szPrgsCode)
				Container0.grdHistory.SetCellEnable( "bd_State", i, false )
			end if
		next
		
		Dim szRegYN

'		szRegYN 			= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "REG_YN" , 0  )
		
		Dim szStartDate, szFinDate, szToday

		szStaDate = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "RSLT_REG_DATE" , 0  ) '시작일자
		szFinDate = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "FIN_DATE" , 0  ) '종료일자
		szToday = Trim(Form.GetSharedData( "&HOST_DATE" , false ))

		If szFinDate < szToday Then
			szDsgtYn	= "E"
		Else
			szDsgtYn	= "D"
		End If

		if szDsgtYn == "D" then
			Container0.contState.tblState.SetCellString( 0, 2, "지정" )
		elseif szDsgtYn == "E" then
			Container0.contState.tblState.SetCellString( 0, 2, "만료" )
		else
			Container0.contState.tblState.SetCellString( 0, 2, "미지정" )
		end if

'		if szRegYN == "Y" then
'			Container0.contState.tblState.SetCellString( 0, 2, "등록" )
'		elseif szRegYN == "N" then
'			Container0.contState.tblState.SetCellString( 0, 2, "미등록" )
'		elseif szRegYN == "C" then
'			Container0.contState.tblState.SetCellString( 0, 2, "해지" )
'		end if
		
		Dim szChannel, szProcCode, szResultCode, szQlfcCode, szQlfcString
		
		szChannel 		= Form.GetMetaData("채널유형구분코드", DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "CHAN_TYPE_CLS_CODE" , 0  )) '채널유형구분코드
		szProcCode 		= Form.GetMetaData("심사진행상태코드", DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "EXAM_PRGS_STAT_CODE" , 0  )) '심사진행상태코드
		szResultCode 		= Form.GetMetaData("심사결과코드", DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "EXAM_RSLT_CODE" , 0  )) '심사결과코드
		
		szQlfcCode 		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "PFIN_QLFC_CLCD" , 0  )

		' Form.GetMetaData 썼으나, 버전처리 문제있는 것으로 보인다고 하여 화면에서 분기 처리 (06.30 권오상 차장님 요청)
		if szQlfcCode == "1" then
			szQlfcString = "소득"
			
		elseif szQlfcCode == "2" then
			szQlfcString = "전문가"
			
		elseif szQlfcCode == "3" then
			szQlfcString = "자산"
		end if

		Container0.contState.tblState.SetCellString( 1, 2, szChannel )
		Container0.contState.tblState.SetCellString( 3, 2, szQlfcString )
		Container0.contState.tblState.SetCellString( 4, 2, szProcCode )
		Container0.contState.tblState.SetCellString( 5, 2, szResultCode )
	
'		Dim szStartDate, szFinDate, szToday
'
'		szStaDate = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "RSLT_REG_DATE" , 0  ) '시작일자
'		szFinDate = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "FIN_DATE" , 0  ) '종료일자
'		
'		szToday = Trim(Form.GetSharedData( "&HOST_DATE" , false ))

		if tonumber(szStaDate) <> NULL and tonumber(szFinDate) <> NULL then
			if tonumber(szStaDate) <= tonumber(szToday) and tonumber(szToday) <= tonumber(szFinDate) then
				Dim szFormatStart, szFormatExp '형식에 맞게 포맷팅
			
				szFormatStart = Mid(szStaDate, 1, 4) & "-" & Mid(szStaDate, 5, 2) & "-" & Mid(szStaDate, 7, 2)
				szFormatExp = Mid(szFinDate, 1, 4) & "-" & Mid(szFinDate, 5, 2) & "-" & Mid(szFinDate, 7, 2)
				
				Container0.contState.tblState.SetCellString( 7, 2, szFormatStart & " ~ " & szFormatExp )
	
				Container0.contState.tblState.visible = true
				Container0.contState.lblNoData.visible = false
	'			
			else
				if isIngList == true then
					Container0.contState.lblNoData.caption = "심사가 완료되면 상세 정보가 조회 됩니다"
				else
					Container0.contState.lblNoData.caption = "유효한 지정 내역이 없습니다."
				end if
				
				Container0.contState.tblState.visible = false
				Container0.contState.lblNoData.visible = true
			end if
		else
			if isIngList == true then
				Container0.contState.lblNoData.caption = "심사가 완료되면\n상세 정보가 조회 됩니다"
			else
				Container0.contState.lblNoData.caption = "유효한 지정 내역이 없습니다."
			end if
				
			Container0.contState.tblState.visible = false
			Container0.contState.lblNoData.visible = true
		end if
	end if
End Function

''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	Container0.contState.lblNodata.visible = false
	Container0.contState.tblState.visible = false
	
	f_RequestTR()
End Sub

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "changeTab" then
		f_RequestTR()
	end if
End Sub

'============================================================================
' Form_OnMsgBoxClose(sKeyName, sRet)
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "cancel_application_history" then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obcsb_acif_091a" )
		end if
	end if
End Sub

'============================================================================
' Container0_contNoti_btnAlpha_OnClick() : 안내 사항 접기/열기
'============================================================================
Sub Container0_contNoti_btnAlpha_OnClick()
	'컨테이너 사이즈 나중에 바꾸면 아이폰 밑에서 올라와서 사이즈 바꾸고 스크롤 위치 바꾸도록
	
	if tonumber(Container0.contNoti.chkArrow.checkstate) == 1 then
		Container0.contNoti.chkArrow.checkstate = 0

		Container0.lblScrollPos.top = 0
'		Container0.contNoti.setHeightResize(40)
		Container0.contNoti.height = 40 '늘어난 뒤에 줄이는거는 제대로 적용 안되는듯, 그래서 height로 아예 설정 (AND 확인)		
		
		Container0.scroll_pos = 0
		Container0.SetScrollAutoSize()
		
	else
		Container0.contNoti.chkArrow.checkstate = 1

		Container0.lblScrollPos.top = 430 + 215
		Container0.contNoti.setHeightResize(215)
		
		'21.06.17 JHY : 스크롤 포스 하고 스크롤 높이 조정하면 밑에서 올라와서 순서 반대로 처리
		Container0.SetScrollAutoSize()
		Container0.scroll_pos = 537 - 430
	end if
End Sub

'============================================================================
' Container0_grdHistory_OnClickUp(lRow, szCellID) :신청 취소 가능 내역 취소 신청 날리기
'============================================================================
Sub Container0_grdHistory_OnClickUp(lRow, szCellID)
	if szCellID == "bd_State" then
		Dim szStatCode
		szStatCode = Container0.grdHistory.GetCellData( "bd_StateCode", lRow )
		
		if szStatCode == "0" or szStatCode == "2" then
			g_nClick = lRow
			Form.MsgBox("알림", "신청 취소 하시겠습니까?", "cancel_application_history", 2)
		end if
	end if
End Sub

''****************************************************************************
''               		D A T A				M A N A G E R               
''****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCustNum
	szCustNum = Form.GetSharedData("&CUST_NUM", false )
'	szCustNum = "3000343500"
'	szCustNum = "3000353088"
'	szCustNum = "3000301651"

	if szTranID == "obcsb_acif_097r" then
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0 , szCustNum  )
		
	elseif szTranID == "obcsb_acif_091a" then
		Dim szApltDate, szApltSrno
		szApltDate = Container0.grdHistory.GetCellData( "bd_Date", g_nClick )
		szApltSrno = Container0.grdHistory.GetCellData( "bd_ReqNum", g_nClick )
		
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0 , szCustNum  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "2"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "EXAM_PRGS_STAT_CODE" , 0 , "0"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "EXAM_RSLT_CODE" , 0 , "C"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CNCL_YN" , 0 , "N"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ACNO" , 0 , Left(Container0.Account0.caption, 8))
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "APLT_DATE" , 0 , szApltDate )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "APLT_SRNO" , 0 , szApltSrno  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "DOCU_RPLT_CLCD" , 0 , "N"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4"  )
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acif_097r" then
		f_SetData(szTranID)
	
	elseif szTranID == "obcsb_acif_091a" then
		Dim szCustNum
		szCustNum = Form.GetSharedData("&CUST_NUM", false )
		
		if szCustNum <> "" then
			DATAMANAGER.RequestTranData( "obcsb_acif_097r" )
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 오류
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	Form.ShowAlert("알림", szErrMsg & "\n(" & szSubMsg & ")")

	if szTranID == "obcsb_acif_097r" then
		Container0.contState.lblNodata.visible = true
		Container0.contState.tblState.visible = false
	end if
End Sub

