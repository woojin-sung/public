	<SCRIPT_INFO _len="3425" _ulen="3013" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 로그인 인증방법 선택
' 02. 화면설명 : 인증방법 팝업
' 03. 작    성 : 2016.11.10 NOHES 
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'Dim g_sCertLogin		'0 : ID로그인, 1 : 인증서 로그인, 2 : 간편인증 로그인, 3 : 바이오인증 로그인
Dim g_sRet			'바이오인증 지원 여부   0:미지원 1:지원
Dim g_bChk			'초기 선택 여부
g_bChk = 0

'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()

	'20170111 NOHES : Android)결제원 앱 설치 상관없이 바이오인증 지원 가능 단말 여부
	'				IOS)결제원 앱에서 판단하는 바이오인증 지원 가능 단말 여부
	g_sRet = Form.GetKftcBioDeviceEnbl()	'바이오인증 지원 여부   0:미지원 1:지원
	
	'20170111 NOHES : IOS) 결제원 앱 미설치 및 비정상 시 바이오인증 지원여부 확인이 불가하므로,
	' 무조건 전체 선택창 보여주는 방식으로 변경함
	s_OSTYPE = Form.GetSharedData("&OS_TYPE", false ) 'iOS("2")Android("1")
	if s_OSTYPE == "2" Then
		g_sRet = "1"
	end if
	
	if g_sRet == "1" then
		Cont0.visible = True
		Cont1.visible = False

		if szData == NULL or szData == "" then
			Cont0.RdoCert.currentindex = "3" 
		else
			Cont0.RdoCert.currentindex = szData
		end if
	else
		Cont0.visible = False
		Cont1.visible = True
		
		if szData == NULL or szData == "" or szData == "1" then
			Cont1.RdoCert.currentindex = "2" 
		elseif szData == "0" then
			Cont1.RdoCert.currentindex = szData
		elseif szData == "2" or szData == "3"then
			Cont1.RdoCert.currentindex = CInt(szData)-1
		end if
	end if	
	
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	Dim sTemp
	If g_sRet == "1" Then	
		sTemp = Cont0.RdoCert.currentindex()
		
		if sTemp == NULL or sTemp == "" or sTemp == "-1" then
			Form.MsgBox( "알림", "로그인 인증방법을 선택하세요", "", 0 )
			return
		end if
	else
		sTemp = Cont1.RdoCert.currentindex()
		if sTemp == NULL or sTemp == "" or sTemp == "-1" then
			Form.MsgBox( "알림", "로그인 인증방법을 선택하세요", "", 0 )
			return
		elseif sTemp <> "0" then
			sTemp = CInt(sTemp)+1
		end if
		
	end if
	
	Form.SendReturnToParent("mhetc90020_pf" , sTemp )
	Form.CloseForm()
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub Cont0_RdoCert_OnClick(nIndex)
	if g_bChk == 0 or g_bChk == "0" Then
		g_bChk = 1
		return
	end if
	
	call btnOK_OnClick()
End Sub

'============================================================================
Sub Cont1_RdoCert_OnClick(nIndex)
	if g_bChk == 0 or g_bChk == "0" Then
		g_bChk = 1
		return
	end if

	call btnOK_OnClick()
End Sub

	</SCRIPT_INFO>
</ROOT>