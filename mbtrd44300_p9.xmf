--===========================================================================
--===========================================================================

Dim g_szAcnt
Dim g_szAsno

g_szAcnt = ""
g_szAsno = ""

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("해외파생예탁자산현황")
	f_DataClear()
	
	Dim szData
	szData = Form.GetOpenLinkData( )
	
	if szData <> "" then
		Dim tData
		tData = Split(szData,"★")
		
		if UBound(tData) > 0 then
			g_szAcnt = tData(0)
			g_szAsno = tData(1)
		end if
	end if
	
	if g_szAcnt <> "" and g_szAsno <> "" then
		DATAMANAGER.RequestTranData( "obtrd_acnt_002r" ) '예수금 조회
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtrd_acnt_002r" then '예수금 조회
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_002r", "InBlock1", "BSOP_DATE" , 0 , Form.GetSharedData("&HOST_DATE", false ) )
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_002r", "InBlock1", "ACNO" , 0 , g_szAcnt ) '계좌번호
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_002r", "InBlock1", "ASNO" , 0 , g_szAsno ) '계좌일련번호
		DATAMANAGER.SetDataValue( false, "obtrd_acnt_002r", "InBlock1", "CRCD" , 0 , contData.cmbCurrency.cbkeydata )
		
	end if
End Sub

'============================================================================
Function f_DataClear()
	Dim szKey
	szKey = contData.cmbCurrency.cbkeydata
	
	if szKey = "KRW" or szKey = "JPY" then
		for i = 0 to 9 step 1
			contData.tblData0.SetCellString(i, 1, "")
			contData.tblData0.SetCellMaskInfo( i, 1, "0,0,,,0,,0,1,1,0,0" ) '소수점 없음
		next
		for i = 0 to 5 step 1
			contData.tblData1.SetCellString(i, 1, "")
			if i <> 5 then '위험도는 마스킹 안바꿈
				contData.tblData1.SetCellMaskInfo( i, 1, "0,0,,,0,,0,1,1,0,0" ) '소수점 없음
			end if
		next
		for i = 0 to 4 step 1
			contData.tblData2.SetCellString(i, 1, "")
			contData.tblData2.SetCellMaskInfo( i, 1, "0,0,,,0,,0,1,1,0,0" ) '소수점 없음
		next
	else
		for i = 0 to 9 step 1
			contData.tblData0.SetCellString(i, 1, "")
			contData.tblData0.SetCellMaskInfo( i, 1, "0,0,,,0,,2,1,1,0,0" ) '소수점 2자리까지 표시
		next
		for i = 0 to 5 step 1
			contData.tblData1.SetCellString(i, 1, "")
			if i <> 5 then '위험도는 마스킹 안바꿈
				contData.tblData1.SetCellMaskInfo( i, 1, "0,0,,,0,,2,1,1,0,0" ) '소수점 2자리까지 표시
			end if
		next
		for i = 0 to 4 step 1
			contData.tblData2.SetCellString(i, 1, "")
			contData.tblData2.SetCellMaskInfo( i, 1, "0,0,,,0,,2,1,1,0,0" ) '소수점 2자리까지 표시
		next
	end if
End Function

'============================================================================
Sub contData_cmbCurrency_OnEditComplete(iIndex)
	f_DataClear()
	
	DATAMANAGER.RequestTranData( "obtrd_acnt_002r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert("알림", szErrMsg)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID = "obtrd_acnt_002r" then '예수금 조회
		Dim szOutBlock, nIndex
		
		if left(contData.cmbCurrency.caption,3) = "TOT" then
			szOutBlock = "OutBlock1"
			nIndex = 0
		else
			szOutBlock = "OutBlock2"
			nIndex = -1
			Dim nCount, szCRCD
			nCount = DATAMANAGER.GetDataCount( false, "obtrd_acnt_002r", "OutBlock2" )
			
			for i = 0 to nCount-1 step 1
				szCRCD = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", "OutBlock2", "CRCD" , i )
				if contData.cmbCurrency.cbkeydata = szCRCD then
					nIndex = i
					exit for
				end if
			next
		end if
		
		if nIndex <> nil and nIndex >= 0 then
			Dim szTDAY_DEPS_FAMT, szCLRN_PRLS_FAMT, szOPTN_BYOV_FAMT, szOPTN_SELN_FAMT, szFFEE
			Dim szUI_NXDY_DEPS_FAMT, szVPAL_FAMT, szOPTN_BYOV_MAWO_FAMT, szOPTN_SELN_MAWO_FAMT, szTIAW_FAMT
			Dim szODER_FMARG, szOTST_FMARG, szENTM_FMARG, szMNTN_FMARG, szSPLM_FMARG, szRISK_ESTI_RATE
			Dim szODER_ABLE_FAMT, szWTMN_ABLE_FAMT, szMNEC_ABLE_FAMT, szMNEC_ANTC_FAMT, szUNCL_FAMT
			
			szTDAY_DEPS_FAMT = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "TDAY_DEPS_FAMT" , nIndex )
			szCLRN_PRLS_FAMT = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "CLRN_PRLS_FAMT" , nIndex )
			szOPTN_BYOV_FAMT = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "OPTN_BYOV_FAMT" , nIndex )
			szOPTN_SELN_FAMT = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "OPTN_SELN_FAMT" , nIndex )
			szFFEE = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "FFEE" , nIndex )
			szUI_NXDY_DEPS_FAMT = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "UI_NXDY_DEPS_FAMT" , nIndex )
			szVPAL_FAMT = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "VPAL_FAMT" , nIndex )
			szOPTN_BYOV_MAWO_FAMT = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "OPTN_BYOV_MAWO_FAMT" , nIndex )
			szOPTN_SELN_MAWO_FAMT = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "OPTN_SELN_MAWO_FAMT" , nIndex )
			szTIAW_FAMT = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "TIAW_FAMT" , nIndex )
			
			szODER_FMARG = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "ODER_FMARG" , nIndex )
			szOTST_FMARG = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "OTST_FMARG" , nIndex )
			szENTM_FMARG = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "ENTM_FMARG" , nIndex )
			szMNTN_FMARG = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "MNTN_FMARG" , nIndex )
			szSPLM_FMARG = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "SPLM_FMARG" , nIndex )
			szRISK_ESTI_RATE = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "RISK_ESTI_RATE" , nIndex )
			
			szODER_ABLE_FAMT = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "ODER_ABLE_FAMT" , nIndex )
			szWTMN_ABLE_FAMT = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "WTMN_ABLE_FAMT" , nIndex )
			szMNEC_ABLE_FAMT = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "MNEC_ABLE_FAMT" , nIndex )
			szMNEC_ANTC_FAMT = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "MNEC_ANTC_FAMT" , nIndex )
			szUNCL_FAMT = DATAMANAGER.GetDataValue( 0, "obtrd_acnt_002r", szOutBlock , "UNCL_FAMT" , nIndex )
			
			contData.tblData0.SetCellString(0, 1, szTDAY_DEPS_FAMT)
			contData.tblData0.SetCellString(1, 1, szCLRN_PRLS_FAMT)
			contData.tblData0.SetCellString(2, 1, szOPTN_BYOV_FAMT)
			contData.tblData0.SetCellString(3, 1, szOPTN_SELN_FAMT)
			contData.tblData0.SetCellString(4, 1, szFFEE)
			contData.tblData0.SetCellString(5, 1, szUI_NXDY_DEPS_FAMT)
			contData.tblData0.SetCellString(6, 1, szVPAL_FAMT)
			contData.tblData0.SetCellString(7, 1, szOPTN_BYOV_MAWO_FAMT)
			contData.tblData0.SetCellString(8, 1, szOPTN_SELN_MAWO_FAMT)
			contData.tblData0.SetCellString(9, 1, szTIAW_FAMT)
			
			contData.tblData1.SetCellString(0, 1, szODER_FMARG)
			contData.tblData1.SetCellString(1, 1, szOTST_FMARG)
			contData.tblData1.SetCellString(2, 1, szENTM_FMARG)
			contData.tblData1.SetCellString(3, 1, szMNTN_FMARG)
			contData.tblData1.SetCellString(4, 1, szSPLM_FMARG)
			contData.tblData1.SetCellString(5, 1, szRISK_ESTI_RATE)
			
			contData.tblData2.SetCellString(0, 1, szODER_ABLE_FAMT)
			contData.tblData2.SetCellString(1, 1, szWTMN_ABLE_FAMT)
			contData.tblData2.SetCellString(2, 1, szMNEC_ABLE_FAMT)
			contData.tblData2.SetCellString(3, 1, szMNEC_ANTC_FAMT)
			contData.tblData2.SetCellString(4, 1, szUNCL_FAMT)
		end if
	end if
End Sub

