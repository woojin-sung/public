	<SCRIPT_INFO _len="3881" _ulen="3755" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 장외채권 상품 목록 조회
' 02. 화면설명 : 장외채권 상품 목록 간단필터 팝업
'                

' 03. 이    력 : 
' - 2023.11.01 : 윤혁 : v0001 : 신규개발


'-------------------------------------------------------------------------------------------
'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************

Dim g_szDateType

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim szLinkData, szList
	
	szLinkData = Form.GetOpenLinkData()
	szList = split(szLinkData, "|")
	
	if szLinkData == "" or szLinkData == null then
		Container0.RgDateType.currentindex = 0
		Container0_RgDateType_OnClick(0)
	else
		Container0.RgDateType.currentindex = CInt(szList(0)) - 1
		
		if Container0.RgDateType.currentindex == 3 then
			Container0.calStart.caption = szList(1)
			Container0.calEnd.caption = szList(2)
		end if
				
	end if

End Sub

'============================================================================
Sub imgDim_OnClick()
	Form.CloseForm("")
End Sub

'============================================================================
Sub Container0_btnOK_OnClick()
	Dim szData
	
	szData = g_szDateType & "|" &
			Container0.calStart.caption & "|" &
			Container0.calEnd.caption
	
	Form.SendReturnToParent("SEARCH_DATE" , szData)
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_calStart_OnEditComplete()
	f_CheckDate()
End Sub

'============================================================================
Sub Container0_calEnd_OnEditComplete()
	
End Sub

'============================================================================
Sub f_CheckDate()
	if Container0.calStart.caption > Container0.calEnd.caption then
		Form.ShowAlert( "알림", "조회 시작일을 확인하세요.")
		
		Exit Sub
			
	end if
End Sub

'============================================================================
Sub Container0_RgDateType_OnClick(nIndex)
	if nIndex == 0 then      '6개월
		g_szDateType = "1"
		Container0.calStart.enable = False
		Container0.calEnd.enable = False
		
		Container0.calStart.caption = Left(Form.calcDateTime( nYear, nMonth, nDay, nHour, nMinute, nSecond ), 8)
		Container0.calEnd.caption = Container0.calStart.caption
	elseif nIndex == 1 then  '1년
		g_szDateType = "2"
		Container0.calStart.enable = False
		Container0.calEnd.enable = False
		
		Container0.calStart.caption = Left(Form.calcDateTime( nYear, nMonth, -7, nHour, nMinute, nSecond ), 8)
		Container0.calEnd.caption = Left(Form.calcDateTime( nYear, nMonth, nDay, nHour, nMinute, nSecond ), 8)	
		
	elseif nIndex == 2 then  '직접입력
		g_szDateType = "3"
		Container0.calStart.enable = False
		Container0.calEnd.enable = False
		
		Container0.calStart.caption = Left(Form.calcDateTime( nYear, -1, nDay, nHour, nMinute, nSecond ), 8)
		Container0.calEnd.caption = Left(Form.calcDateTime( nYear, nMonth, nDay, nHour, nMinute, nSecond ), 8)
		
	elseif nIndex == 3 then  '직접입력
		g_szDateType = "4"
		Container0.calStart.enable = True
		Container0.calEnd.enable = True
	
	end if
End Sub

	</SCRIPT_INFO>
</ROOT>