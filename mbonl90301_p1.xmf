	<CONTROL_INFO>
		<IMAGE name="imgDim" imgpath="alpha" ly_vert="0,0,375,650,1" />
		<CONTAINER name="Container0" ly_vert="0,355,375,292,1" scroll_ly_vert="0,355,375,292,1" >
			<CONTROL_INFO>
				<IMAGE name="imgBg" imgpath="popup_bg.9" ly_vert="0,0,375,400,1" />
				<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="기간을 선택해 주세요." bgcolor="092:185046046" halign="1" ly_vert="0,0,375,70,1" />
				<RADIOGROUP name="RgDateType" fontsize="-2" buttonshape="1" buttonsnumber="4" ly_vert="20,70,337,44,1" >
					<RADIO_INFO>
						<RADIO no="0" text="당일" radioimage="input_06.9.png" transfervalue="01" position="0,0,80,44" />
						<RADIO no="1" text="일주일" radioimage="input_06.9.png" transfervalue="02" position="85,0,80,44" />
						<RADIO no="2" text="한달" radioimage="input_06.9.png" transfervalue="03" position="170,0,80,44" />
						<RADIO no="3" text="직접입력" radioimage="input_06.9.png" transfervalue="04" position="255,0,80,44" />
					</RADIO_INFO>
				</RADIOGROUP>
				<LABEL name="lblTitle0" fontstyle="01" caption="직접입력" ly_vert="20,126,100,32,1" />
				<CALENDAR name="calStart" fontsize="-2" dispmode="65537" ly_vert="24,159,150,44,1" />
				<LABEL name="Label2" fontsize="-2" caption="~" halign="1" ly_vert="182,159,16,44,1" />
				<CALENDAR name="calEnd" fontsize="-2" dispmode="1398757700" ly_vert="204,159,150,44,1" />
				<BUTTON name="btnOK" caption="확인" fontsize="1" btnimage="btn_20.9" ly_vert="0,232,375,60,1" />
