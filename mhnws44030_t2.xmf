'============================================================================
' TR_Inquiry(nSanupGubun, nMiddleGubun, nSmallGubun, szDate) - TR
'============================================================================
Function TR_Inquiry(nSanupGubun, nMiddleGubun, nSmallGubun, szDate)

	DATAMANAGER.SetDataValue(0, "ohhts_1653_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "J")
	DATAMANAGER.SetDataValue(0, "ohhts_1653_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE", 0, 1653)
	DATAMANAGER.SetDataValue(0, "ohhts_1653_001r", "InBlock1", "FID_INPUT_ISCD", 0, nSanupGubun)
	DATAMANAGER.SetDataValue(0, "ohhts_1653_001r", "InBlock1", "FID_INPUT_ISCD2", 0 , nMiddleGubun)
	DATAMANAGER.SetDataValue(0, "ohhts_1653_001r", "InBlock1", "FID_INPUT_ISCD3", 0 , nSmallGubun)
	DATAMANAGER.SetDataValue(0, "ohhts_1653_001r", "InBlock1", "FID_INPUT_DATE1", 0 , szDate)
	DATAMANAGER.RequestTranData("ohhts_1653_001r")

End Function

'============================================================================
' IsValidDate() - 유효날짜 확인 
'============================================================================
Function IsValidDate()
	
	Dim bIsValidDate
	Dim szDataTo
	Dim szDataFrom
	
	bIsValidDate = True	
	szDataTo = cldTo.caption
	szDataFrom = cldFrom.caption
	

	If Len(Trim(szDataFrom)) <> 8 then
		Form.ShowAlert("알림", "날짜입력이 정확하지 않습니다.")
		bIsValidDate = False
		Exit Function
	end if	
	
	If CDbl(Trim(szDataFrom)) > CDbl(Trim(szDataTo)) then
		Form.ShowAlert("알림", "날짜입력이 정확하지 않습니다.")
		bIsValidDate = False
		Exit Function
	end if
	
	'/////////////////////////////////////////////
	'//// IOS 오류로 인해 주석 처리 '/////////////
	'/////////////////////////////////////////////
'	If Len(Trim(szDataTo)) > Form.GetSharedData("#BP_CURR_DATE", 0) then
'		Form.ShowAlert("날짜오류", "날짜입력이 정확하지 않습니다.")
'		bIsValidDate = False
'		Exit Function
'	end if
'	
'	If Len(Trim(szDataFrom)) > Form.GetSharedData("#BP_CURR_DATE", 0) then
'		Form.ShowAlert("날짜오류", "날짜입력이 정확하지 않습니다.")
'		bIsValidDate = False
'		Exit Function
'	end if	
	'/////////////////////////////////////////////
	'//// IOS 오류로 인해 주석 처리 '/////////////
	'/////////////////////////////////////////////

End Function



'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'============================================================================
' Form_OnFormInit() - 화면 초기
'============================================================================
Sub Form_OnFormInit()

	'산업 대/중/소분류를 99(전체)로, 날짜를 오늘날짜로 초기화
	g_nSanupGubun = 99
	g_nMiddleGubun = 99
	g_nSmallGubun = 99
	g_szDate = cldFrom.caption
	
	TR_Inquiry(g_nSanupGubun, g_nMiddleGubun, g_nSmallGubun, g_szDate)

End Sub




'============================================================================
' cldFrom_OnEditComplete() - 달력조회
'============================================================================
Sub cldFrom_OnEditComplete()
	if cldFrom.caption > cldToday.caption then
		Form.MsgBox("알림", "오늘 이전 날짜를 선택해 주세요", "", 0)
		cldFrom.caption = cldToday.caption
	end if
	g_szDate = cldFrom.caption
	btnSearch_OnClick()
End Sub


'============================================================================
' cmbSanupGubun_OnEditComplete(iIndex) - 산업대분류
'============================================================================
Sub cmbSanupGubun_OnEditComplete(iIndex)
	if iIndex == 0 then
		g_nSanupGubun = 99
	else
		g_nSanupGubun = cmbSanupGubun.cbkeydata
	end if
	
	g_nMiddleGubun = 99
	g_nSmallGubun = 99
	call SetComboMiddleOpinion(g_nSanupGubun)
	call SetComboSmallOpinion(g_nSanupGubun, g_nMiddleGubun)
	btnSearch_OnClick()
End Sub


'============================================================================
' cmbMiddleGubun_OnEditComplete(iIndex) - 산업중분류
'============================================================================
Sub cmbMiddleGubun_OnEditComplete(iIndex)
	if iIndex == 0 then
		g_nMiddleGubun = 99
		g_nSmallGubun = 99
	end if
	
	g_nMiddleGubun = cmbMiddleGubun.cbkeydata
	if g_nMiddleGubun == 99 then
		g_nMiddleGubun = 01
	end if
		g_nSmallGubun = 99
	call SetComboSmallOpinion(g_nSanupGubun, g_nMiddleGubun)
	btnSearch_OnClick()
End Sub


'============================================================================
' cmbSmallGubun_OnEditComplete(iIndex) - 산업소분류
'============================================================================
Sub cmbSmallGubun_OnEditComplete(iIndex)
	g_nSmallGubun = cmbSmallGubun.cbkeydata
	btnSearch_OnClick()
End Sub


'============================================================================
' btnSearch_OnClick() - 조회
'============================================================================
Sub btnSearch_OnClick()
	call IsValidDate()
	call TR_Inquiry(g_nSanupGubun, g_nMiddleGubun, g_nSmallGubun, g_szDate)
End Sub


'============================================================================
' grdIndustryOpinion_OnScrollEnd()
'============================================================================
Sub grdIndustryOpinion_OnScrollEnd()
	DATAMANAGER.RequestNextData( "ohhts_1653_001r" )
End Sub


'============================================================================
' grdIndustryOpinion_OnClickUp(lRow, szCellID)
'============================================================================
Sub grdIndustryOpinion_OnClickUp(lRow, szCellID)
	if lRow >= 0 then	
		g_szUrl = "http://home.imeritz.com/HKCPDF"
		g_szPdf = g_szUrl & grdIndustryOpinion.GetCellData( "bd_cell5", lRow )	
		Form.OpenPdfViewer( g_szPdf, "리포트" )		
	end if	
End Sub




