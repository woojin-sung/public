'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nSanupGubun	'대분류
Dim g_nMiddleGubun	'중분류
Dim g_nSmallGubun	'소분류
Dim g_szDate			'날짜
Dim g_szUrl, g_szPdf	'pdf경로

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
