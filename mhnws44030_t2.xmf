'============================================================================
' SetMiddleOpinion(nSanupGubun) - 산업대분류 키값으로 중분류, 소분류 콤보설정
'============================================================================
Function SetComboMiddleOpinion(nSanupGubun)

	cmbMiddleGubun.clear = true
	cmbSmallGubun.clear = true

	szMiddleList = ""	'중분류리스트
	szSmallList = ""	'소분류리스트
	
	'대분류 키값에 따른 중분류, 소분류 리스트 재설정
	if nSanupGubun = "99" then
		szMiddleList = "99`전체"
		szSmallList = "99`전체"
	elseif nSanupGubun = "00" then
		szMiddleList = "99`전체" & "\r\n" & "01`광업"
		szSmallList = "99`전체"
	elseif nSanupGubun = "01" then
		szMiddleList = "99`전체" & "\r\n" & "00`기타음식료" & "\r\n" & "01`식료" & "\r\n" & "02`음료" & "\r\n" & "03`담배"
		szSmallList = "99`전체"
	elseif nSanupGubun = "02" then
		szMiddleList = "99`전체" & "\r\n" & "01`섬유" & "\r\n" & "02`의복" & "\r\n" & "03`피혁"
		szSmallList = "99`전체"
	elseif nSanupGubun = "03" then
		szMiddleList = "99`전체" & "\r\n" & "01`목재" & "\r\n" & "02`제지" & "\r\n" & "03`출판"
		szSmallList = "99`전체"
	elseif nSanupGubun = "04" then
		szMiddleList = "99`전체" & "\r\n" & "01`기초화학" & "\r\n" & "02`농약비료" & "\r\n" & "03`정유" & "\r\n" & "04`페인트" & "\r\n" & "05`화장품" & "\r\n" & "06`화학가공" & "\r\n" & "07`무기화학"
		szSmallList = "99`전체"
	elseif nSanupGubun = "05" then
		szMiddleList = "99`전체" & "\r\n" & "01`제약"
		szSmallList = "99`전체"
	elseif nSanupGubun = "06" then
		szMiddleList = "99`전체" & "\r\n" & "01`비금속광물"
		szSmallList = "99`전체"
	elseif nSanupGubun = "07" then
		szMiddleList = "99`전체" & "\r\n" & "01`철강" & "\r\n" & "02`비철금속"
		szSmallList = "99`전체"
	elseif nSanupGubun = "08" then
		szMiddleList = "99`전체" & "\r\n" & "01`조립금속" & "\r\n" & "02`기계" & "\r\n" & "03`정밀기계"
		szSmallList = "99`전체"
	elseif nSanupGubun = "09" then
		szMiddleList = "99`전체" & "\r\n" & "01`전자제품" & "\r\n" & "02`사무용기기" & "\r\n" & "03`전자제품" & "\r\n" & "04`전자기기"
		szSmallList = "99`전체"
	elseif nSanupGubun = "10" then
		szMiddleList = "99`전체" & "\r\n" & "00`기타운송기기" & "\r\n" & "01`자동차" & "\r\n" & "02`조선"
		szSmallList = "99`전체"	
	elseif nSanupGubun = "11" then
		szMiddleList = "99`전체" & "\r\n" & "01`일반제조" 
		szSmallList = "99`전체"
	elseif nSanupGubun = "12" then
		szMiddleList = "99`전체" & "\r\n" & "01`전력" & "\r\n" & "02`가스" 
		szSmallList = "99`전체"	
	elseif nSanupGubun = "13" then
		szMiddleList = "99`전체" & "\r\n" & "01`건설" 
		szSmallList = "99`전체"	
	elseif nSanupGubun = "14" then
		szMiddleList = "99`전체" & "\r\n" & "01`도매" & "\r\n" & "02`소매" & "\r\n" & "03`운송" 
		szSmallList = "99`전체"	
	elseif nSanupGubun = "15" then
		szMiddleList = "99`전체" & "\r\n" & "01`통신" 
		szSmallList = "99`전체"	
	elseif nSanupGubun = "16" then
		szMiddleList = "99`전체" & "\r\n" & "01`여수신금융" & "\r\n" & "02`창업투자" & "\r\n" & "03`증권" & "\r\n" & "04`보험" 
		szSmallList = "99`전체"
	elseif nSanupGubun = "17" then
		szMiddleList = "99`전체" & "\r\n" & "01`서비스" & "\r\n" & "02`IT서비스" 
		szSmallList = "99`전체"	
	else
		szMiddleList = "99`전체"
		szSmallList = "99`전체"		
	end if	

	
	
	cmbMiddleGubun.currentindex = 0
	cmbSmallGubun.currentindex = 0
	
	cmbMiddleGubun.cbinputdatatext = szMiddleList
	cmbSmallGubun.cbinputdatatext = szSmallList
End Function




'============================================================================
' SetComboSmallOpinion(nSanupGubun, nMiddleGubun) - 산업대분류, 중분류 키값으로 소분류 콤보설정
'============================================================================
Function SetComboSmallOpinion(nSanupGubun, nMiddleGubun)

	cmbSmallGubun.clear = true

	szSmallList = ""	'소분류리스트	
	
	if nMiddleGubun = "99" then		
		szSmallList = "99`전체"
	end if
	
	if nSanupGubun = "99" and nMiddleGubun = "99" then
		szSmallList = "99`전체"
	elseif nSanupGubun = "00" and nMiddleGubun = "01" then
		szSmallList = "99`전체" & "\r\n" & "01`광업"
	elseif nSanupGubun = "01" and nMiddleGubun = "00" then
		szSmallList = "99`전체" & "\r\n" & "00`기타음식료"
	elseif nSanupGubun = "01" and nMiddleGubun = "01" then
		szSmallList = "99`전체" & "\r\n" & "01`수산및수산가공" & "\r\n" & "02`유가공" & "\r\n" & "03`사료" & "\r\n" & "04`제분제당" & "\r\n" & "05`제과" & "\r\n" & "06`라면" & "\r\n" & "07`빵"
	elseif nSanupGubun = "01" and nMiddleGubun = "02" then
		szSmallList = "99`전체" & "\r\n" & "01`소주" & "\r\n" & "02`맥주" & "\r\n" & "03`음료"
	elseif nSanupGubun = "01" and nMiddleGubun = "03" then
		szSmallList = "99`전체" & "\r\n" & "01`담배" 
	elseif nSanupGubun = "02" and nMiddleGubun = "01" then
		szSmallList = "99`전체" & "\r\n" & "00`기타섬유" & "\r\n" & "01`면사" & "\r\n" & "02`면직물" & "\r\n" & "03`모직물" & "\r\n" & "04`화섬사" & "\r\n" & "05`화섬직물"
	elseif nSanupGubun = "02" and nMiddleGubun = "02" then
		szSmallList = "99`전체" & "\r\n" & "00`기타의복" & "\r\n" & "01`내의" & "\r\n" & "02`수출의류" & "\r\n" & "03`패션의류"
	elseif nSanupGubun = "02" and nMiddleGubun = "03" then
		szSmallList = "99`전체" & "\r\n" & "01`피혁" 
	elseif nSanupGubun = "03" and nMiddleGubun = "01" then
		szSmallList = "99`전체" & "\r\n" & "01`목재"
	elseif nSanupGubun = "03" and nMiddleGubun = "02" then
		szSmallList = "99`전체" & "\r\n" & "00`기타제지" & "\r\n" & "01`인쇄용지" & "\r\n" & "02`판지" & "\r\n" & "03`팩"
	elseif nSanupGubun = "03" and nMiddleGubun = "03" then
		szSmallList = "99`전체" & "\r\n" & "00`기타출판" & "\r\n" & "01`출판" & "\r\n" & "02`음반"
	elseif nSanupGubun = "04" and nMiddleGubun = "01" then
		szSmallList = "99`전체" & "\r\n" & "00`기타기초화학" & "\r\n" & "01`합성수지" & "\r\n" & "02`비누계면활성제" & "\r\n" & "03`염료안료" & "\r\n" & "04`합성고무"
	elseif nSanupGubun = "04" and nMiddleGubun = "02" then
		szSmallList = "99`전체" & "\r\n" & "01`농약비료"
	elseif nSanupGubun = "04" and nMiddleGubun = "03" then
		szSmallList = "99`전체" & "\r\n" & "00`정유" & "\r\n" & "01`윤활유"
	elseif nSanupGubun = "04" and nMiddleGubun = "04" then
		szSmallList = "99`전체" & "\r\n" & "01`페인트"
	elseif nSanupGubun = "04" and nMiddleGubun = "05" then
		szSmallList = "99`전체" & "\r\n" & "01`화장품"
	elseif nSanupGubun = "04" and nMiddleGubun = "06" then
		szSmallList = "99`전체" & "\r\n" & "00`기초화학가공" & "\r\n" & "01`프라스틱가공" & "\r\n" & "02`필름" & "\r\n" & "03`타이어" & "\r\n" & "04`합성피혁" & "\r\n" & "05`자기테이프"
	elseif nSanupGubun = "04" and nMiddleGubun = "07" then
		szSmallList = "00`무기화학"
	elseif nSanupGubun = "05" and nMiddleGubun = "01" then
		szSmallList = "01`제약"
	elseif nSanupGubun = "06" and nMiddleGubun = "01" then
		szSmallList = "99`전체" & "\r\n" & "00`기타비금속광물" & "\r\n" & "01`시멘트" & "\r\n" & "02`유리병" & "\r\n" & "03`판유리" & "\r\n" & "04`비금속건자재" & "\r\n" & "05`내화물"
	elseif nSanupGubun = "07" and nMiddleGubun = "01" then
		szSmallList = "99`전체" & "\r\n" & "00`기타철강" & "\r\n" & "01`철판" & "\r\n" & "02`철근형강" & "\r\n" & "03`강관" & "\r\n" & "04`봉강" & "\r\n" & "05`스텐" & "\r\n" & "06`배관이음쇠" & "\r\n" & "07`철강유통" 
	elseif nSanupGubun = "07" and nMiddleGubun = "02" then
		szSmallList = "99`전체" & "\r\n" & "01`전기동가공" & "\r\n" & "02`알미늄가공" & "\r\n" & "03`아연"
	elseif nSanupGubun = "08" and nMiddleGubun = "01" then
