Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()		
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgClose.setMaintainingRatio("1")
	imgLight.setMaintainingRatio("1")
	Image0.setMaintainingRatio("1")
	Image1.setMaintainingRatio("1")
	Image2.setMaintainingRatio("1")
	
	lblInfo.setHighlight(332, 0, 15)
	
	Dim szOsType
	szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	if szOsType = "2" then	
		Label3.Top = 484
		Label3.left = 144
		Label0.Top = 501
		Label0.left = 209
		
		
	end if	
End Sub

