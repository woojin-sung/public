				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16060", "1") '매도	
			end if
		
		end if
	
	end if

End Function

'============================================================================
' 이전 검색 조건값 적용
'============================================================================
Function ApplyExCondData()
	
	'----------------------------------------------------------------------------
	'이전값 가져오기
	'----------------------------------------------------------------------------
	sTabIndex 		 	= Form.GetSharedData("ETF_THEME_TAB_INDEX"		, false )
	sBtnIndex	 	 	= Form.GetSharedData("ETF_THEME_BTN_INDEX"		, false )
	
	sFilterNationCode  	= Form.GetSharedData("ETF_THEME_FILTER_NATION"	, false )
	sFilterSortingCode 	= Form.GetSharedData("ETF_THEME_FILTER_SORT"		, false )
	nIndex 			 	= Form.GetSharedData("ETF_THEME_SELECT_INDEX"		, false )
	sWideState			= Form.GetSharedData("ETF_THEME_WIDE_STATE"		, false )
	
	'----------------------------------------------------------------------------
	'이전값 메모리영역 데이터 클리어
	'----------------------------------------------------------------------------
	Form.SetSharedData("50100_INDEX" 			, "")
	Form.SetSharedData("ETF_THEME_TAB_INDEX" 	, "")
	Form.SetSharedData("ETF_THEME_BTN_INDEX" 	, "")
	Form.SetSharedData("ETF_THEME_FILTER_NATION" 	, "")
	Form.SetSharedData("ETF_THEME_FILTER_SORT" 	, "")
	Form.SetSharedData("ETF_THEME_SELECT_INDEX" 	, "")
	Form.SetSharedData("ETF_THEME_WIDE_STATE" 	, "")
	
	'----------------------------------------------------------------------------
	'이전값 세팅
	'----------------------------------------------------------------------------
		
	'1) 테마 인덱스
	gSelectThemeTabIndex = sTabIndex
	gSelectThemeIndex = sBtnIndex
	
	if gSelectThemeTabIndex == "" or gSelectThemeIndex == "" then
		gSelectThemeTabIndex = -1
		gSelectThemeIndex = -1
	end if
	
	
	'2) 필터 국가
	gFilterNationCode = sFilterNationCode
	
	if gFilterNationCode == "" then
		gFilterNationCode = "Y@N@N@N@N@N"
	end if
	
	'3) 필터 정렬
	gFilterSortingCode = sFilterSortingCode
	
	'---------------------------------------------------------
	' 20240612 LES START ETF추가개선 - 필더추가 및 인덱스변경
	'---------------------------------------------------------
	if gFilterSortingCode == "" then
		gFilterSortingCode = "3" 
	end if
	'---------------------------------------------------------
	' 20240612 LES END
	'---------------------------------------------------------
	
	'4) 선택행
	gExSelectIndex = nIndex
	if nIndex == "" then
		gExSelectIndex = "-1"
	end if
	
	'5) 펼침여부
	'20240411
	gContState = sWideState
	if sWideState == "" then
		gContState = "NORMAL"
	end if
	
	'6) 펼침여부 적용
	'20240411
	if gContState == "EXPAND" then			
		SetContHeight("contBody","EXPAND_MANUAL")
	else
		SetContHeight("contBody","NORMAL_MANUAL")
	end if
				
	'Form.ShowAlert("test", "테마 탭 : ".. gSelectThemeTabIndex.."\n".. "테마 버튼 : " .. gSelectThemeIndex.."\n".. "필터국가 : " .. gFilterNationCode.."\n".."필터정렬 : ".. gFilterSortingCode.."\n".. "선택행 : " .. gExSelectIndex.."\n".. "펼침 : " .. gContState)
	

End Function
'============================================================================
' 현재 검색 조건값 저장
'============================================================================
Function SaveCurCondData(nIndex)
	
	'---------------------------------------------------------------
	'저장 검색조건 리스트
	'---------------------------------------------------------------
	'테마 선택값 : gSelectThemeTabIndex(선택 테마 탭 인덱스), gSelectThemeIndex(선택 테마 버튼 인덱스)
	'필터조건값(국가/정렬) : gFilterNationCode (초기값 Y@N@N@N@N@N) / gFilterSortingCode (초기값 3) '20240328 디폴트값 변경
	'선택종목 인덱스 : nIndex
	'---------------------------------------------------------------
	
	'------------------------------------------
	' 현재화면 탭 인덱스
	'------------------------------------------
	'Form.SetSharedData("ETF_SUPER_SEARCH_INDEX" , "2")
	Form.SetSharedData("50100_INDEX" , "2")

	'------------------------------------------
	' 테마 인덱스
	'------------------------------------------
	Form.SetSharedData("ETF_THEME_TAB_INDEX" , gSelectThemeTabIndex)
	Form.SetSharedData("ETF_THEME_BTN_INDEX" , gSelectThemeIndex)
	
	'------------------------------------------
	' 필터 국가
	'------------------------------------------
	sFilterNationCode = gFilterNationCode
	Form.SetSharedData("ETF_THEME_FILTER_NATION" , sFilterNationCode)
	
	'------------------------------------------
	' 필터 정렬
	'------------------------------------------
	sFilterSortingCode = Cstr(gFilterSortingCode)
	Form.SetSharedData("ETF_THEME_FILTER_SORT" , sFilterSortingCode)
	
	'------------------------------------------
	' 선택종목 인덱스
	'------------------------------------------
	Form.SetSharedData("ETF_THEME_SELECT_INDEX" , Cstr(nIndex))
	
	'------------------------------------------
	'리스트 펼침상태 '20240411
	'------------------------------------------
	Form.SetSharedData("ETF_THEME_WIDE_STATE" , gContState)
	
	
End Function

'============================================================================
Function SetFilterText()

	'-------------------------------------------------
	' 국가필터값 텍스트 추출
	'-------------------------------------------------
	sNationFilterText = ""
	if gFilterNationCode == "" then
		sNationFilterText = "필터"
	else
	
		arrNationFlag = Split(gFilterNationCode,"@")
		
		for i = 0 to #arrNationFlag - 1
			
			if i == 0 then
				
				sFlag = arrNationFlag(0)
				
				if sFlag == "Y" then
					sNationFilterText = "전체"
					exit for
				end if
				
			else
				
				sFlag = arrNationFlag(i)
				
				if sFlag = "Y" then
					
					if i == 1 then
						if sNationFilterText == "" then
							sNationFilterText = "국내"
						else
							sNationFilterText = sNationFilterText.."·국내"
						end if
					elseif i == 2 then
						if sNationFilterText == "" then
							sNationFilterText = "미국"
						else
							sNationFilterText = sNationFilterText.."·미국"
						end if
					elseif i == 3 then
						if sNationFilterText == "" then
							sNationFilterText = "중국"
						else
							sNationFilterText = sNationFilterText.."·중국"
						end if
					elseif i == 4 then
						if sNationFilterText == "" then
							sNationFilterText = "홍콩"
						else
							sNationFilterText = sNationFilterText.."·홍콩"
						end if
					elseif i == 5 then
						if sNationFilterText == "" then
							sNationFilterText = "일본"
						else
							sNationFilterText = sNationFilterText.."·일본"
						end if
					end if
				
				end if
			
			end if
		
		next
		
	
	end if
	
	'---------------------------------------------------------
	' 20240612 LES START ETF추가개선 - 필더추가 및 인덱스변경
	'---------------------------------------------------------
	' 정렬기준 필터 텍스트 추출
	'-------------------------------------------------
	sFilterSortingCode = ""
	if gFilterSortingCode == 0 or gFilterSortingCode == "0" then
		sFilterSortingCode = "상승률 낮은순"
	elseif gFilterSortingCode == 1 or gFilterSortingCode == "1" then
		sFilterSortingCode = "상승률 높은순"
	elseif gFilterSortingCode == 2 or gFilterSortingCode == "2" then
		sFilterSortingCode = "거래량 적은순"
	elseif gFilterSortingCode == 3 or gFilterSortingCode == "3" then
		sFilterSortingCode = "거래량 많은순"
	elseif gFilterSortingCode == 4 or gFilterSortingCode == "4" then
		sFilterSortingCode = "    보수 낮은순"
	elseif gFilterSortingCode == 5 or gFilterSortingCode == "5" then
		sFilterSortingCode = "    보수 높은순"
	end if
	'-------------------------------------------------
	' 20240612 LES END
	'-------------------------------------------------
	
	'-------------------------------------------------
	' 세팅
	'-------------------------------------------------
	if sNationFilterText == "전체" and sFilterSortingCode == "거래량 많은순" then
			
			contBody.LabelFilter.fontsize = -2
			contBody.LabelFilter.SetMaxLineCount(1)
			contBody.LabelFilter.caption = "필터"
	else
			
			
			if sFilterSortingCode == "" then
				contBody.LabelFilter.fontsize = -2
				contBody.LabelFilter.SetMaxLineCount(1)
				contBody.LabelFilter.caption = sNationFilterText
			else
			
				contBody.LabelFilter.fontsize = -2
				contBody.LabelFilter.SetMaxLineCount(2)
				contBody.LabelFilter.caption = sNationFilterText.." ".."\n"..sFilterSortingCode
				
			end if
	end if
	
	

End Function

'============================================================================
' 상태별 컨테이너 사이즈 '20240411
'============================================================================
Function SetContHeight(sGubun,sType)
	
	if sGubun == "contBody" then
	
		if sType == "NORMAL_MANUAL" then
			
			if gCompareBtnShow then
				contBody.top = 433
				contBody.height = 118
				contBody.Pannel0.height = 58
			
			else
				contBody.top = 433
				contBody.height = 178
				contBody.Pannel0.height = 118	
			end if
			
			gContState = "NORMAL"
			
		elseif sType == "NORMAL_AUTO" then
		
			if gCompareBtnShow then
				contBody.height = 118
				contBody.Pannel0.height = 58
			else
				contBody.height = 178
				contBody.Pannel0.height = 118
			end if
			
			gContState = "NORMAL"
			
		elseif sType == "EXPAND_MANUAL" then
					
			if gCompareBtnShow then
				contBody.top = 0
				contBody.height = 551
				contBody.Pannel0.height = 491
			else
				contBody.top = 0
				contBody.height = 611
				contBody.Pannel0.height = 551
			end if
			
			gContState = "EXPAND"
		
		elseif sType == "EXPAND_AUTO" then

			if gCompareBtnShow then
				contBody.height = 551
				contBody.Pannel0.height = 491
			else
				contBody.height = 611
				contBody.Pannel0.height = 551 
			end if
		
			gContState = "EXPAND"
			
		elseif sType == "SEARCH_NOT_FOUND" then
			
			contBody.top = 271
			contBody.height = 60
			
			gContState = "NOT_FOUND"
			
		end if
	
	end if

	'test
	'contBody.LabelFilter.caption = "["..Cstr(contBody.height).."]".."["..Cstr(contBody.Pannel0.height).."]"

End Function
'============================================================================
' 가장많이 담고있는 종목클릭 시, 화면 이동 (종목코드/시장 구분 모두 있는 경우만 이동)
'============================================================================
Sub contKeyword_LabelMostItemName_OnClick()

	szMk = contKeyword.LabelMostItemMarket.caption
	szItemCode = contKeyword.LabelMostItemCode.caption
	szName = contKeyword.LabelMostItemName.caption
	
	if szMk <> "" and szItemCode <> "" and szName <> "" then
		
		SaveCurCondData("")
		
		if szMk == "J" then
			Form.OpenScreen("11000" , szItemCode)
		else
			Form.OpenScreen("16000" , szMk.."@"..szItemCode.."★"..szName)
		end if
		
	end if
	
End Sub

'============================================================================
' 국가별 실시간 시세여부 
'============================================================================
Function GetRealTimeSiseYN(sMarketCode)
	
	szRealAble = Form.GetSharedData( "REALTIME_"&sMarketCode, false )
	return szRealAble
	
End Function

'============================================================================
'(iOS 전용) 스크롤링 속도 원복 20240429
'============================================================================
Sub contBody_Pannel0_OnVisibleRow(nEventStartRow, nEventEndRow)
	
	if gOsType == "2" then
		contBody.Pannel0.setScrollSpeed(False, 0)
	end if
	
End Sub

'============================================================================
' 20240612 LES START ETF추가개선 - 필더추가 및 인덱스변경
'============================================================================
Function GetSortingCodeForTran()
	
	'-----------------------------------------------------------------------------
	' [gFilterSortingCode] 화면에서 가지고 있는 값으로 서비스에 올려야되는 값 추출 
	'-----------------------------------------------------------------------------
	' [구분]		    [화면값]	 [서비스값]
	'-----------------------------------------------------------------------------
	' 디폴트 		: -1			0
	' 상승률 낮은순 	: 0			2
	' 상승률 높은순 	: 1			1
	' 거래량 적은순 	: 2			5
	' 거래량 많은순 	: 3			3
	' 보수 낮은순   	: 4			4
	' 보수 높은순   	: 5			6
	'-----------------------------------------------------------------------------

	if gFilterSortingCode == -1 or gFilterSortingCode == "-1" then
		return "0"
	elseif gFilterSortingCode == 0 or gFilterSortingCode == "0" then
		return "2"
	elseif gFilterSortingCode == 1 or gFilterSortingCode == "1" then
		return "1"
	elseif gFilterSortingCode == 2 or gFilterSortingCode == "2" then
		return "5"
	elseif gFilterSortingCode == 3 or gFilterSortingCode == "3" then
		return "3"
	elseif gFilterSortingCode == 4 or gFilterSortingCode == "4" then
		return "4"
	elseif gFilterSortingCode == 5 or gFilterSortingCode == "5" then
		return "6"
	end if
	 

End Function



