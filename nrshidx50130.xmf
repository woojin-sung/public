Function OpenPopupCond()
	'Form.OpenPopupAnimation("nrshidx50120_p1", "2★N@Y@Y@Y@Y@N★1", "", "2")
	Form.OpenPopupAnimation("nrshidx50120_p1", "2".."★"..gFilterNationCode .. "★".. gFilterSortingCode.. "★".."THEME_SEARCH", "", "2")
