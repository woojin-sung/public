Dim gOsType				'OS타입
Dim gPannelIndex 			'현재 판넬 인덱스값
Dim gWidePannelIndex 		'펼쳐보기한 판넬 인덱스값

Dim gFoldPannelHeight		'펼쳐보기 시 판넬 행높이
Dim gUnFoldPannelHeight	'평상 시 판넬 행높이

Dim gContState			'결과리스트 펼침상태
Dim gCompareMode 			'종목비교 모드여부

Dim gContUpPos			'위로 스크롤 시 컨테이너 top값
Dim gContDownPos			'아래로 스크롤 시 컨테이너 top값

Dim gCompareItemIndex1 	'선택종목1
Dim gCompareItemIndex2		'선택종목2
Dim gCompareBtnShow		'비교하기버튼 보임여부

Dim gThemeList			'테마리스트 조회결과(이미지명@테마명@테마코드^....)
gThemeList = ""

Dim gMAX_CNT				'테마리스트 한페이지당 최대 개수
gMAX_CNT = 8

Dim gThemeTabCnt 
Dim gSelectThemeTabIndex	'선택 테마 탭 인덱스
Dim gSelectThemeIndex		'선택 테마 버튼 인덱스
Dim gSelectThemeName		'선택 테마명

Dim gbLargeFont			'큰글씨 사용여부
Dim gsLargeFontsize		'큰글씨 폰트크기(1:조금크게 2:크게)

gbLargeFont = false
gsLargeFontsize = 0

Dim gFilterNationCode
Dim gFilterSortingCode

Dim gExSelectIndex
gExSelectIndex = -1

Dim gETF_SUPER_HIS_KEY
gETF_SUPER_HIS_KEY = "ETF_SUPER_HISTORY"

Dim gMostItemName,gMostItemCode,gMostItemMarket
gMostItemName,gMostItemCode,gMostItemMarket = ""

Dim gOvrsMarketList()
gOvrsMarketList = {"AX","NY","OQ","SZ","SH","HK","JP"}

'============================================================================
Sub Form_OnFormInitBefore()

	'--------------------------------------------------------------
	'이미지 비율유지
	'--------------------------------------------------------------
	contBody.Image0.setMaintainingRatio("1")
	imgNotice.setMaintainingRatio("1")
	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		gbLargeFont = true
		gsLargeFontsize = szTextSize
		
		contBody.BtnCompare.fontsize = - Cint((gsLargeFontsize * 2))
		contBody.LabelFilter.fontsize = -3 - Cint((gsLargeFontsize * 2))
		
	end if	

	'--------------------------------------------------------------
	'OS타입
	'--------------------------------------------------------------
	gOsType = Form.GetSharedData("&OS_TYPE", false)
	
	'--------------------------------------------------------------
	'판넬관련 전역변수 설정 
	'--------------------------------------------------------------
	
	'행 펼쳤을때/접혔을때 높이값
	if gOsType == "1" then
		gFoldPannelHeight = 174
		gUnFoldPannelHeight = 103
	else
		gFoldPannelHeight = 174
		gUnFoldPannelHeight = 102
	end if
	
	gPannelIndex = 0
	gWidePannelIndex = -1
	gCompareMode = false
	gContState = "NORMAL"
	
	'--------------------------------------------------------------
	' 스크롤관련 전역변수 설정
	'--------------------------------------------------------------
	'위/아래 스크롤 시 컨테이너 top값 지정
	gContUpPos = 0
	gContDownPos = 433
	
	'--------------------------------------------------------------
	' 종목비교관련  전역변수 설정
	'--------------------------------------------------------------
	gCompareItemIndex1 = -1
	gCompareItemIndex2 = -1
	gCompareBtnShow = false
	
	'--------------------------------------------------------------
	' 테마선택관련  전역변수 설정
	'--------------------------------------------------------------
	'선택테마 인덱스 초기값
	gThemeTabCnt = 3
	gSelectThemeTabIndex = -1
	gSelectThemeIndex = -1
	
	'--------------------------------------------------------------
	' 필터(조회국가/정렬기준) 관련 전역변수 설정 
	'--------------------------------------------------------------
	gFilterNationCode = "Y@N@N@N@N@N"
	
	'---------------------------------------------------------
	' 20240612 LES START ETF추가개선 - 필더추가 및 인덱스변경
	'---------------------------------------------------------
	'gFilterSortingCode = "2" 
	gFilterSortingCode = "3" 
	
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'(iOS전용) 판넬컨트롤 렌더링 오류 수정
	contBody.Pannel0.setDataNormal(true)
	
	'-------------------------------------------------------
	'테마/주요 키워드 영역 컨트롤 설정
	'-------------------------------------------------------
	contTheme.bgcolor = 320
	'contKeyword.bgcolor = 355
	
	'-------------------------------------------------------
	' 데이터영역 컨트롤 설정
	'-------------------------------------------------------
	contBody.LabelSearchResultCnt.paddinginfo = "0,0,0,0"
	contBody.LabelSearchResultCnt.fgcolor = 321
	contBody.LabelFilter.paddinginfo = "0,0,0,0"
	
	'--------------------------------------------------------------
	'이전 설정값 존재 시 설정
	'--------------------------------------------------------------
	ApplyExCondData()
	
	'20240221 START
	'관심종목리스트 조회
	Form.requestIntrItemList("00")
	
	'------------------------------------------------------------------------------------------------------------------------------
	'테마 생성 및 데이터 조회순서
	'RequestThemeList => MakeThemeList => InsertFormTabPage -> SendIndexInfo -> SendThemeList -> CheckSelectTheme => OnTriggerEvent(SELECT_THEME)
	'------------------------------------------------------------------------------------------------------------------------------
	'1) 테마리스트 데이터 조회 (RequestThemeList)
	'	- 사용서비스 : ohhts_metf_032r
	'
	'2) 테마리스트 데이터 생성 (MakeThemeList)
	'	- 전체 테마리스트 정보(테마코드/테마명) 저장
	'	- 한 페지이에 노출되는 테마수(gMAX_CNT)에 따라 폼탭 페이지 수 결정
	'
	'3) 테마리스트 화면 생성 (InsertFormTabPage)
	'	- 결정된 폼탭 페이지 수에따라 폼탭 페이지 동적 생성
	'	- 생성된 페이지에 각 페이지 인덱스 전달 (SendIndexInfo)
	'	- 해당 페이지에 표시될 테마정보(테마코드/테마명) 한페이지당 노출되는 수(gMAX_CNT)만큼 전달 (SendThemeList)
	'	- 이전 선택정보가 있는지 확인 후 재세팅 없으면 디폴트 세팅 (CheckSelectTheme)
	'
	'4) 테마 선택 시 종목 데이터 조회 ( OnTriggerEvent 내 SELECT_THEME 이벤트)
	'	- 이전 선택정보가 있으면 CheckSelectTheme 를 통해서 테마 선택
	'	- 이전 선택정보가 없으면 사용자가 테마버튼을 클릭해서 테마 선택
	'	- 실제 선택한 테마에 대한 종목리스트를 조회하는 부분
	'------------------------------------------------------------------------------------------------------------------------------
	RequestThemeList()
	
	contBody.gesture = true
	
	
End Sub

'============================================================================
'
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
End Sub

'============================================================================
'
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "ohhts_metf_032r" then
		
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_032r", "OutBlock1")
		
		for i = 0 to nCnt -1
			
			sThemeName = DATAMANAGER.GetDataValue(0, "ohhts_metf_032r", "OutBlock1", "FID_ETF_MDDV_NAME" , i)
			sThemeCode = DATAMANAGER.GetDataValue(0, "ohhts_metf_032r", "OutBlock1", "FID_ETF_MDDV_SRNO" , i)
			
			if Len(sThemeCode) > 4 then
				sThemeCode = Right(sThemeCode,4)
			end if
			
			'gThemeList : 테마리스트 조회결과(테마명@테마코드^....)
			if gThemeList == "" then
				gThemeList = sThemeName .."@" .. sThemeCode
			else
				gThemeList = gThemeList.. "^"..sThemeName .."@" .. sThemeCode
			end if
			
			
		next
		
		if DATAMANAGER.IsMoreNextData("ohhts_metf_032r") then
			DATAMANAGER.RequestNextData( "ohhts_metf_032r" )
		else
			MakeThemeList()
		end if
	
	
	elseif szTranID == "ohhts_metf_004r" then
	
		'가장많이 담고있는 종목정보 세팅
		gMostItemName = DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock1", "FIDX_KOR_ISNM" , 0)
		gMostItemCode = DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock1", "FID_OVRS_ISCD" , 0) 
		gMostItemMarket = DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0)
	
		'--------------------------
		' 토탈조회건수 세팅
		'--------------------------
		nTotalCnt = DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock1", "FID_IQRY_CSNU" , 0)
		contBody.LabelSearchResultCnt.caption = "검색결과 "..Cint(nTotalCnt).."건"
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_004r", "OutBlock2")
		
		'20240223
		'토탈건수로 contBody 내 데이터조회 영역 컨트롤 보임/숨김처리
		'현재아웃블럭 개수에 따라 데이터행 개수 세팅
		CheckDataCnt(Cint(nTotalCnt))
		SetPannelRowCnt(gPannelIndex + nCnt)
		
		for i = 0 to nCnt - 1
		
			'--------------------------
			'데이터 가져오기
			'--------------------------
			sName 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FIDX_KOR_ISNM" , i)
			sCode 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_OVRS_ISCD" , i)
			sMarket  = DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , i)
			sPrice 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_PRPR" , i)
			sDebi 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_PRDY_CTRT" , i)
			sBosu 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_TOTAL_PAY_RATE" , i)
			sNAV 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FIDX_NAV" , i)
			sVol 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_VOL" , i)
			sNation 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_LSTN_NTNL_CODE" , i)
			
			sNew		= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_NEW_LSTN_YN" , i)
			sTrht	= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_TRHT_YN", i)
			
			sSign 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_004r", "OutBlock2", "FID_PRDY_VRSS_SIGN" , i)
			
			'--------------------------
			'바디데이터 행 생성 및 컨트롤 위치조정
			'--------------------------
			
			'20240223
			'contBody.Pannel0.AddRow()
			ChangeControlPosAndRowHeight(1,i + gPannelIndex)
			
			
			'--------------------------
			'바디데이터 입력
			'--------------------------
			
			'국가
			sNationFlagName = GetNationFlagName(sNation)
			contBody.Pannel0.setPropCardCell("maintainratio","ImageFlag",i + gPannelIndex,"1")
			contBody.Pannel0.setPropCardCell("imgpath","ImageFlag",i + gPannelIndex,sNationFlagName)
			
			'종목명
			'sName = "["..Cstr(i + gPannelIndex).."]".. sName
			contBody.Pannel0.SetCellValue("LabelName",i + gPannelIndex,sName)
			
			'종목코드(티커)
			contBody.Pannel0.SetCellValue("LabelCode",i + gPannelIndex,sCode)
			contBody.Pannel0.SetCellValue("LabelBodyTicker",i + gPannelIndex,sCode)
			
			'거래소구분코드
			contBody.Pannel0.SetCellValue("LabelBodyMarket",i + gPannelIndex,sMarket)
			
			'현재가
			nDecimalLen = GetNationDecimalLen(sNation)
			sPrice = FormatNumber(sPrice,nDecimalLen)
			contBody.Pannel0.SetCellValue("LabelHyun",i + gPannelIndex,sPrice.." | "..sDebi.."%")
			
			
			'등락률(현재가 라벨과 통합)
			'contBody.Pannel0.SetCellValue("LabelDebi",i + gPannelIndex,sDebi)
			
			'--------------------------
			'현재가/등락률 색상표시
			'--------------------------
			if sSign == "2" then '상승
				contBody.Pannel0.setPropCardCell("fgcolor","LabelHyun",i + gPannelIndex,"290")
				contBody.Pannel0.setPropCardCell("fgcolor","LabelDebi",i + gPannelIndex,"290")
			elseif sSign == "5" then '하락
				contBody.Pannel0.setPropCardCell("fgcolor","LabelHyun",i + gPannelIndex,"291")
				contBody.Pannel0.setPropCardCell("fgcolor","LabelDebi",i + gPannelIndex,"291")
			else '보합
				contBody.Pannel0.setPropCardCell("fgcolor","LabelHyun",i + gPannelIndex,"333")
				contBody.Pannel0.setPropCardCell("fgcolor","LabelDebi",i + gPannelIndex,"333")
			end if
			
			
			'보수
			if Cdbl(sBosu) == 0 then
				sTransBosu = "-"
			else
				'sTransBosu = Decimal_Setting(sBosu,2) .. "%"
				sTransBosu = sBosu .. "%"
			end if
			contBody.Pannel0.SetCellValue("LabelBosuData",i + gPannelIndex,sTransBosu)
			
			'NAV
			if Cdbl(sNAV) == 0 then
				sTransNAV = "-"
			else
				'sTransNAV = Decimal_Setting(sNAV,2)
				sTransNAV = FormatNumber(sNAV,2)
			end if
			contBody.Pannel0.SetCellValue("LabelNAVData",i + gPannelIndex,sTransNAV)
			
			'거래량
			contBody.Pannel0.SetCellValue("LabelVolData",i + gPannelIndex,sVol)
			
			'거래정지
			if sTrht == "Y" then
				sText = contBody.Pannel0.GetCellValue("LabelCode",i + gPannelIndex)
				sText = sText .. " | " .. "거래정지"
				contBody.Pannel0.SetCellValue("LabelCode",i + gPannelIndex,sText)
			end if
			
			'신규상장 여부
			if sNew == "Y" then
				sText = contBody.Pannel0.GetCellValue("LabelCode",i + gPannelIndex)
				sText = sText .. " | " .. "신규상장"
				contBody.Pannel0.SetCellValue("LabelCode",i + gPannelIndex,sText)
			end if
			
			'관심종목/체크 이미지 세팅
			if gCompareMode then
				contBody.Pannel0.setPropCardCell("maintainratio","ImageIntrCheck",i + gPannelIndex,"1")
				contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i + gPannelIndex,"checkmenu_n")
			else
				
				'20240221 START
				'국내=종목코드 / 해외=거래소구분@종목코드
				bReg = false
				if sNation == "KOR" then
					bReg = Form.isIntrItemList(sCode)
				else
					bReg = Form.isIntrItemList(sMarket.."@"..sCode)
				end if
				
				if bReg then
					contBody.Pannel0.SetCellValue("LabelBodyIntrYN",i + gPannelIndex,"Y")
					contBody.Pannel0.setPropCardCell("maintainratio","ImageIntrCheck",i + gPannelIndex,"1")
					contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i + gPannelIndex,"icon_like_o")
				else
					contBody.Pannel0.SetCellValue("LabelBodyIntrYN",i + gPannelIndex,"N")
					contBody.Pannel0.setPropCardCell("maintainratio","ImageIntrCheck",i + gPannelIndex,"1")
					contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i + gPannelIndex,"icon_like_n")
				end if
				'20240221 END
				
			end if
			
		
		next
		
		'20240223
		'CheckDataCnt(Cint(contBody.Pannel0.rowcount))
		
		'------------------------------------------------------------------------------
		'이전 선택행 인덱스값 존재 시 이전행 인덱스가 나올떄까지 자동 재조회 후 자동이동
		'------------------------------------------------------------------------------
		if gExSelectIndex <> "-1" then
			nRow = Cint(contBody.Pannel0.rowcount)
			nIndex = Cint(gExSelectIndex)
			
			'아직 선택행만큼 행수가 생기지 않았으면 재조회
			'선택행만큼 행수가 생겼으면 해당위치로 이동 후 gExSelectIndex 초기화
			'연속조회 끝까지 선택행이 안나오면 그냥 초기화
			if nRow >= nIndex then
				contBody.Pannel0.toprow = nIndex
				gExSelectIndex = "-1"
		
			else
				
				if DATAMANAGER.IsMoreNextData("ohhts_metf_004r") then
					gPannelIndex = _tonumber( contBody.Pannel0.rowcount )	
					DATAMANAGER.RequestNextData("ohhts_metf_004r")
				else
					gExSelectIndex = "-1"
				end if
				
			end if
			
			
		end if
		'------------------------------------------------------------------------------
		'
		'------------------------------------------------------------------------------	
		
	end if

	
End Sub

'============================================================================
' 판넬컨트롤 스크롤 완료 시
'============================================================================
Sub contBody_Pannel0_OnScrollEnd()

	if DATAMANAGER.IsMoreNextData("ohhts_metf_004r") then
		gPannelIndex = _tonumber( contBody.Pannel0.rowcount )	
		DATAMANAGER.RequestNextData( "ohhts_metf_004r" )
	end if 
	
End Sub

'============================================================================
'
'============================================================================
Sub contBody_Pannel0_OnClick(nIndex, sCellID)


		'-------------------------------------------------------
		'펼쳐진 행이 없을 경우
		'-------------------------------------------------------
		if gWidePannelIndex < 0 then
		
			'관심종목등록/종목비교 체크버튼 이 아닌 경우에는 행을 펼침
			'ButtonIntrCheck => 하트/체크이미지를 너무 정확하게 눌러야되서 근처영역 클릭 시 동작할 수 있게 버튼하나 올림
			if sCellID <> "ImageIntrCheck" and sCellD <> "LabelDebi" and sCellID <> "ButtonIntrCheck" then
				gWidePannelIndex = nIndex
				foldBottomLinkArea(nIndex,gFoldPannelHeight)
			
			else
			
				'종목비교모드가 아니면 관심종목 등록 버튼 클릭 시 관심종목 추가팝업 오픈
				if gCompareMode <> true then
					szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
					szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
					
					'20240221 START 등록완료 후 몇번째 행을 처리했는지 리턴받기 위해 넘김.
					sReg = contBody.Pannel0.GetCellValue("LabelBodyIntrYN",nIndex)
					
					if sReg == "Y" then
						sParam = "DEL" .. "★" .. nIndex
						'Form.OpenPopupAnimation("nrshidx50600_p4", szMk.."@"..szItemCode& "★"& sParam,"", "2")	'종목삭제
						if szMk == "J" then
							Form.OpenPopup("nrshidx50600_p4" , szItemCode& "★"& sParam , "")
						else
							Form.OpenPopup("nrshidx50600_p4" , szMk.."@"..szItemCode& "★"& sParam , "")
						end if
						
					else
						sParam = "ADD" .. "★" .. nIndex
						
						if szMk == "J" then
							Form.OpenPopupAnimation("nrshidx50600_p2", szItemCode& "★"& sParam,"", "2")	'종목등록
						else
							Form.OpenPopupAnimation("nrshidx50600_p2", szMk.."@"..szItemCode& "★"& sParam,"", "2")	'종목등록
						end if
						
					end if
					'20240221 END
				
				'종목비교모드라면 선택행 체크(단 최대 2개까지만 선택가능)
				else
					
					SetCompareItem(nIndex)
				
				end if
				
			end if
		
		'-------------------------------------------------------
		'펼쳐진 행이 있을 경우
		'-------------------------------------------------------
		else
		
			'링크버튼or관심종목 등록 영역 클릭 시(접히면 안되는 경우임)
			'ButtonIntrCheck => 하트/체크이미지를 너무 정확하게 눌러야되서 근처영역 클릭 시 동작할 수 있게 버튼하나 올림
			if isLinkButton(sCellID) then
				
				if sCellID == "ImageIntrCheck" or sCellID == "LabelDebi" or sCellID == "ButtonIntrCheck" then
					
					'종목비교모드가 아니면 관심종목 추가팝업 오픈
					if gCompareMode <> true then
						szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
						szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
					
						'20240221 START 등록완료 후 몇번째 행을 처리했는지 리턴받기 위해 넘김.
						sReg = contBody.Pannel0.GetCellValue("LabelBodyIntrYN",nIndex)
						
						if sReg == "Y" then
							sParam = "DEL" .. "★" .. nIndex
							'Form.OpenPopupAnimation("nrshidx50600_p4", szMk.."@"..szItemCode& "★"& sParam,"", "2")	'종목삭제
							if szMk == "J" then
								Form.OpenPopup("nrshidx50600_p4" , szItemCode& "★"& sParam , "")
							else
								Form.OpenPopup("nrshidx50600_p4" , szMk.."@"..szItemCode& "★"& sParam , "")
							end if
						else
							sParam = "ADD" .. "★" .. nIndex
							
							if szMk == "J" then
								Form.OpenPopupAnimation("nrshidx50600_p2", szItemCode& "★"& sParam,"", "2")	'종목등록
							else
								Form.OpenPopupAnimation("nrshidx50600_p2", szMk.."@"..szItemCode& "★"& sParam,"", "2")	'종목등록
							end if
						
						end if
						'20240221 END
					
					'종목비교모드라면 선택행 체크(단 최대 2개까지만 선택가능)
					else
						
						SetCompareItem(nIndex)
					
					end if
					
				'화면링크버튼 클릭 시, 히스토리 리스트에 쌓는다.
				elseif sCellID == "ButtonLink0" then '현재가
					
					SetHistory("set",nIndex)
					MoveScreen("hyun",nIndex)
				
				elseif sCellID == "ButtonLink1" then '차트
				
					SetHistory("set",nIndex)
					MoveScreen("chart",nIndex)
				
				elseif sCellID == "ButtonLink2" then '종목정보
				
					SetHistory("set",nIndex)
					MoveScreen("info",nIndex)
				
				elseif sCellID == "ButtonLink3" then '매수
				
					SetHistory("set",nIndex)
					MoveScreen("mesu",nIndex)
				
				elseif sCellID == "ButtonLink4" then '매도
				
					SetHistory("set",nIndex)
					MoveScreen("medo",nIndex)
					
				end if
				
				
			'링크버튼 외 영역 클릭 시(접혀도 되는 경우임)
			else
			
				'이미 펼쳐진 행을 다시 선택했을때는 접음
				if gWidePannelIndex == nIndex then
					gWidePannelIndex = -1
					unfoldBottomLinkArea(nIndex,gUnFoldPannelHeight)
			
				'이미 펼쳐진 행과 다른행을 선택한 경우
				'기존 펼쳐진 행을 접고 선택한 행을 펼침
				else
					unfoldBottomLinkArea(gWidePannelIndex,gUnFoldPannelHeight)
					gWidePannelIndex = nIndex
					foldBottomLinkArea(nIndex,gFoldPannelHeight)
				
				end if
			
			
			end if
			
		end if
		
		
	

	
End Sub

'============================================================================

'============================================================================
Function RequestData(szTranID)

	if szTranID == "ohhts_metf_004r" then
	
		SetDefaultGlobalVariable()
		
		'20240223
		'contBody.Pannel0.rowcount = 0
		
		'---------------------------------------------------------------------------------------------------
		'sThemeName 		  => 검색 테마명
		'sClsCode 		  => 1: 일반테마 / 2 : 메리츠 테마 (테마검색화면은 일반테마 고정)
		'sTransNationCode   => 화면에서는 Y@N@N... 이런식으로 관리 서비스에 올릴때는 YNN 형식으로 올려줘야함.
		'sTransSortingCode  => 화면에서 default = -1 , 서비스 default = 0이므로 하나 더해서 올려줌.
		'---------------------------------------------------------------------------------------------------
		sThemeName = gSelectThemeName
		sClsCode = 1
		sTransNationCode = replace(gFilterNationCode,"@","")
		
		'---------------------------------------------------------
		' 20240612 LES START ETF추가개선 - 필더추가 및 인덱스변경
		'---------------------------------------------------------
		'sTransSortingCode = gFilterSortingCode+1
		sTransSortingCode = GetSortingCodeForTran()
		'---------------------------------------------------------
		' 20240612 LES END
		'---------------------------------------------------------
	
		DATAMANAGER.SetDataValue(0, "ohhts_metf_004r", "InBlock1", "FID_MDDV_CODE_NAME", 			 0, sThemeName)
		DATAMANAGER.SetDataValue(0, "ohhts_metf_004r", "InBlock1", "FID_INPUT_CLS_CODE", 			 0, sClsCode)
		DATAMANAGER.SetDataValue(0, "ohhts_metf_004r", "InBlock1", "FIDX_INPUT_NTNL_CODE", 		 0, sTransNationCode)
		DATAMANAGER.SetDataValue(0, "ohhts_metf_004r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE",	 0, sTransSortingCode)
		
		for i = 0 to #gOvrsMarketList - 1 
			
			'0:지연 / 1:실시간
			sRealSiseYN = GetRealTimeSiseYN(gOvrsMarketList[i])
			
			if sRealSiseYN == "" then
				sRealSiseYN = "0"
			end if
			
			DATAMANAGER.SetDataValue(0, "ohhts_metf_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , i , gOvrsMarketList[i])
			DATAMANAGER.SetDataValue(0, "ohhts_metf_004r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , i , sRealSiseYN)
			
		next
	
	
		DATAMANAGER.RequestTranData("ohhts_metf_004r")
		
		SetFilterText()
	
	end if


End Function

'============================================================================
'
'============================================================================
Function _tonumber(data)
	return tonumber(data) or 0
end Function

'============================================================================
' 선택행 링크영역 펼치기
'============================================================================
Function foldBottomLinkArea(nIndex,nHeight)
	
	'판넬 높이 조정
	contBody.Pannel0.SetCardWHAt(nIndex,nHeight)
	
	'링크영역 컨트롤 조정
	contBody.Pannel0.setPropCardCell("top","ImageBottomLinkBG",nIndex,"100") 
	contBody.Pannel0.setPropCardCell("top","ButtonLink0",nIndex,"114")
	contBody.Pannel0.setPropCardCell("top","ButtonLink1",nIndex,"114")
	contBody.Pannel0.setPropCardCell("top","ButtonLink2",nIndex,"114")
	contBody.Pannel0.setPropCardCell("top","ButtonLink3",nIndex,"114")
	contBody.Pannel0.setPropCardCell("top","ButtonLink4",nIndex,"114")
	contBody.Pannel0.setPropCardCell("top","LabelSeperator",nIndex,"173")
	
	contBody.Pannel0.setPropCardCell("visible","ImageBottomLinkBG",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink0",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink1",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink2",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink3",nIndex,"1")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink4",nIndex,"1")
	
	'마지막행 클릭 시 스크롤 자동 이동
	nLastIndex = contBody.Pannel0.rowcount - 1
	
	if nIndex ==  nLastIndex then
		contBody.Pannel0.toprow = nIndex
	end if
	
	'선택한 행이 첫행일 경우에는 리스트 수동으로 펼침
	'20240411
	if nIndex == 0 then
		if gContState <> "EXPAND" then
			SetContHeight("contBody","EXPAND_MANUAL")
		end if
	end if

End Function

'============================================================================
' 선택행 링크영역 접기
'============================================================================
Function unfoldBottomLinkArea(nIndex,nHeight)

	'판넬 높이 조정
	contBody.Pannel0.SetCardWHAt(nIndex,nHeight)
	
	'링크영역 컨트롤 조정
	contBody.Pannel0.setPropCardCell("top","LabelSeperator",nIndex,"101")
	
	contBody.Pannel0.setPropCardCell("visible","ImageBottomLinkBG",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink0",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink1",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink2",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink3",nIndex,"0")
	contBody.Pannel0.setPropCardCell("visible","ButtonLink4",nIndex,"0")
	
End Function

'============================================================================
' 판넬클릭 시, 링크버튼 + 관심종목 버튼 클릭 여부 확인
'============================================================================
Function isLinkButton(sCellID)
	
	if sCellID == "ButtonLink0" or sCellID == "ButtonLink1" or sCellID == "ButtonLink2" or sCellID == "ButtonLink3" or sCellID == "ButtonLink4" or sCellID == "ImageIntrCheck" or sCellID == "LabelDebi" or sCellID == "ButtonIntrCheck" then
		return true
	else
		return false
	end if

End Function

Function SetPannelRowCount(nCnt)
	contBody.Pannel0.rowcount = nCnt
End Function

'============================================================================
' 판넬 행개수 세팅
'============================================================================
'20240223
Function SetPannelRowCnt(nCnt)
	'Form.ShowAlert("SetPannelRowCnt", nCnt)
	contBody.Pannel0.rowcount = nCnt
End Function

'============================================================================
' 조회건수에 따라 컨트롤 위치조정 
'============================================================================
Function CheckDataCnt(nCnt)
	
	if nCnt > 0 then

		'----------------------------
		'선택테마 테마명 세팅
		'----------------------------
		'깜빡이는 현상을 최소화하기 위해 여기서 세팅
		contKeyword.LblSelectTheme.caption = gSelectThemeName '.."@"..sSelectThemeCode
		nLen = Form.getLen(contKeyword.LblSelectTheme.caption)
		contKeyword.LblSelectTheme.setHighLight(415,0,nLen)
		
		'--------------------------------------------------------------------------
		'가장많이담고있는 종목정보(종목명/코드/거래소구분) 세팅
		'--------------------------------------------------------------------------
		'깜빡이는 현상을 최소화하기 위해 여기서 세팅
		contKeyword.LabelMostItemName.caption = gMostItemName
		contKeyword.LabelMostItemCode.caption = gMostItemCode
		contKeyword.LabelMostItemMarket.caption = gMostItemMarket
		
		contKeyword.visible = true
		contBody.visible = true
		
		'20240405
		'contBody.top = 433
		'contBody.height = 178
		
		'Next조회 일경우에는 컨테이너 사이즈 유지하기 위해 미호출
		'(Next조회 : gPannelIndex > 0)
		'호출할때는 gContState 구분값에 따라 호출
		'20240411
		if gPannelIndex <= 0 then
			if gContState == "EXPAND" then
				SetContHeight("contBody","EXPAND_MANUAL")
			else
				SetContHeight("contBody","NORMAL_MANUAL")
			end if
		end if
		
		LabelGuideText.visible  = false
		imgNotice.visible = false
		
		contBody.Pannel0.visible = true
		contBody.Pannel0.left = 0
		
	else
		
		contKeyword.visible = false
		contBody.visible = true
		
		'20240405
		'contBody.top = 271
		'contBody.height = 60
		SetContHeight("contBody","SEARCH_NOT_FOUND")
		
		LabelGuideText.top = contBody.top + 200
		imgNotice.top = contBody.top + 140
		
		LabelGuideText.caption = "검색된 종목이 없어요."
		LabelGuideText.visible  = true
		imgNotice.visible = true
	
		contBody.Pannel0.visible = false
		contBody.Pannel0.left = 500
		
		
	end if

End Function

'============================================================================
' 필터설정 팝업오픈
'============================================================================
Function OpenPopupPeriod(sOpenData)
	'Form.OpenPopupAnimation("nrshidx50600_p1", sOpenData, "", "2")
End Function


'============================================================================
' 종목비교 버튼 클릭이벤트
'============================================================================
Sub contBody_BtnCompare_OnClick()
	
	'종목비교모드 OFF
	if gCompareMode then
	
		'종목비교/초기화 버튼 SHOW -> HIDE
		if gCompareBtnShow then
			SetShowCompareButton(false)
		end if
	
		gCompareMode = false
		
		contBody.BtnCompare.fgcolor = 338
		contBody.BtnCompare.caption = "종목비교"
		contBody.BtnCompare.btnimage = "btn_36.9"
		
		gCompareItemIndex1 = -1
		gCompareItemIndex2 = -1
		
		ChangeIntrCehckImage("2")
	
	'종목비교모드 ON
	else
		
		gCompareMode = true
		
		contBody.BtnCompare.fgcolor = 326
		contBody.BtnCompare.caption = "비교해제"
		contBody.BtnCompare.btnimage = "btn_42.9"
		
		gCompareItemIndex1 = -1
		gCompareItemIndex2 = -1
		
		ChangeIntrCehckImage("1")	
	
	end if

	
End Sub

'============================================================================
' 판넬 데이터행 관심종목 등록버튼 <-> 체크 버튼 변환
' sType 1: 관심종목 등록버튼 => 체크 버튼
'       2: 체크버튼 => 관심종목 등록버튼
'============================================================================
Function ChangeIntrCehckImage(sType)

	dataCnt = Cint(contBody.Pannel0.rowcount)
	
	if dataCnt > 0 then
	
		if sType == "1" then
		
			for i= 0 to dataCnt - 1
				contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i,"checkmenu_n")
			next
			
		else
		
			for i= 0 to dataCnt - 1
				
				'20240221 START
				sIntrReg = contBody.Pannel0.GetCellValue("LabelBodyIntrYN",i)
				if sIntrReg == "Y" then
					contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i,"icon_like_o")
				else
					contBody.Pannel0.setPropCardCell("imgpath","ImageIntrCheck",i,"icon_like_n")
				end if
				'20240221 END
			
			next
	
		end if
		
	end if

End Function

'============================================================================
' 데이터행 높이 및 컨트롤 위치 조정
' sType 1:(기본)접힌상태 2:펼침상태
'============================================================================
Function ChangeControlPosAndRowHeight(nType,nIndex)

	if nType == 1 then
	
		'종목명
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelName",nIndex,"0,0,0,0")
		contBody.Pannel0.setPropCardCell("fontsize","LabelName",nIndex,"0")
		contBody.Pannel0.setPropCardCell("maxlinecnt","LabelName",nIndex,"1^-4")
		
		'종목코드(티커)
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelCode",nIndex,"0,0,0,0")
		
		'현재가
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelHyun",nIndex,"0,0,0,0")
			
		'등락률
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelDebi",nIndex,"0,0,0,0")
			
		'보수
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelBosuTitle",nIndex,"0,0,0,0")
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelBosuData",nIndex,"0,0,0,0")
			
		'NAV
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelNAVTitle",nIndex,"0,0,0,0")
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelNAVData",nIndex,"0,0,0,0")
			
		'거래량
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelVolTitle",nIndex,"0,0,0,0")
		contBody.Pannel0.setPropCardCell("paddinginfo","LabelVolData",nIndex,"0,0,0,0")
		
		'구분선
		contBody.Pannel0.setPropCardCell("top","LabelSeperator",nIndex,"101")	
		contBody.Pannel0.SetCardWHAt(nIndex,gUnFoldPannelHeight)
		
		'큰글씨 사용모드일때 폰트크기 대응
		if gbLargeFont then
		
			'기본폰트크기(-3) - (큰글씨 설정값 * 2)
			'큰글씨 설정값 = 1:조금 크게 / 2 : 크게
			sTransFontsize = Cstr( -3 - (Cint(gsLargeFontsize) * 2))
					
			'보수
			contBody.Pannel0.setPropCardCell("fontsize","LabelBosuTitle",nIndex,sTransFontsize)
			contBody.Pannel0.setPropCardCell("fontsize","LabelBosuData",nIndex,sTransFontsize)
			
			'NAV
			contBody.Pannel0.setPropCardCell("fontsize","LabelNAVTitle",nIndex,sTransFontsize)
			contBody.Pannel0.setPropCardCell("fontsize","LabelNAVData",nIndex,sTransFontsize)
			
			'거래량
			contBody.Pannel0.setPropCardCell("fontsize","LabelVolTitle",nIndex,sTransFontsize)
			contBody.Pannel0.setPropCardCell("fontsize","LabelVolData",nIndex,sTransFontsize)
			
		end if
		
		
	else
		contBody.Pannel0.SetCardWHAt(nIndex,gFoldPannelHeight)
	end if

End Function

'============================================================================
' 이전 세팅값에 따라 펼쳐진 경우 && 데이터가 적은 경우 20240411
'============================================================================
Sub contBody_OnGestureEvent(sParam)
	
	'ApplyExCondData값에 의해
	'자동으로 펼쳐진 경우 && 조회된 데이터의 개수가 판넬에 스크롤이 안생기는 개수(6개미만) 일경우
	'Gesture이벤트에서 Down이 내려올 경우 컨테이너가 내려갈 수 있게 세팅해준다.
	nCount = Cint(contBody.Pannel0.rowcount)
	nTop   = Cint(contBody.top)
	
	if nCount < 6 and nTop == 0 then
		if sParam == "Down" then
			contBody.fixTopAreaWhenScrolling("1", gContDownPos, "Down")
		end if
	end if
	
	
End Sub
'============================================================================
'스크롤 위치가 TOP이 아닌 경우
'============================================================================
Sub contBody_Pannel0_OnScrollNoTop()
	contBody.fixTopAreaWhenScrolling("1", gContUpPos, "Up")
	
	'20240429
	if gOsType == "2" then
		contBody.Pannel0.setScrollSpeed(True, 0)
	end if
	
End Sub
'============================================================================
'스크롤 위치가 TOP인 경우
'============================================================================
Sub contBody_Pannel0_OnScrollTop()
	contBody.fixTopAreaWhenScrolling("1", gContDownPos, "Down")
End Sub

'============================================================================
'fixTopAreaWhenScrolling Api에 대한 애니메이션 동작이 시작됐을 때
'============================================================================
Sub contBody_OnAnimationStart(sParam1,sParam2)
	
	
	'종목비교가 활성화 되있는 상태에서 
	'스크롤 시 버튼이 뒤로 숨는 현상조치
	btnReset.bringFront("1")
	btnOk.bringFront("1")
	
	'Up Swipe
	if sParam1 == "Up" then
		if gCompareBtnShow == true then
			
			'20240405
			'기존사이즈 + 숨겨지는 영역 사이즈 - 종목비교/초기화 버튼 사이즈
			'contBody.height = 178 + 162 + 271 - 60
			'contBody.Pannel0.height = 118 + 162 + 271 - 60
			SetContHeight("contBody","EXPAND_AUTO")
		
		else
		
			'20240405
			'기존사이즈 + 숨겨지는 영역 사이즈
			'contBody.height = 178 + 162 + 271
			'contBody.Pannel0.height = 118 + 162 + 271
			SetContHeight("contBody","EXPAND_AUTO")
			
		end if
		
	end if
	
End Sub
'============================================================================
'fixTopAreaWhenScrolling Api에 대한 애니메이션 동작이 완료됐을 때
'============================================================================
Sub contBody_OnAnimationComplete(sParam1,sParam2)
	
	'Down Swipe
	if sParam1 == "Down" then
		
		if gCompareBtnShow == true then
			
			'20240405
			'기존 사이즈 - 종목비교/초기화 버튼 사이즈
			'contBody.height = 178 - 60
			'contBody.Pannel0.height = 118 - 60
			SetContHeight("contBody","NORMAL_AUTO")
			
		else
			
			'20240405
			'기존사이즈 
			'contBody.height = 178
			'contBody.Pannel0.height = 118
			SetContHeight("contBody","NORMAL_AUTO")
			
		end if
	
		
	end if
	
End Sub
