'============================================================================
' 
'============================================================================
Function MakeThemeList()

	if gThemeList <> "" then
		
		arrThemeList = Split(gThemeList,"^")
		
		if #arrThemeList > 0 then
			
			arrCnt = #arrThemeList
			
			if arrCnt >= gMAX_CNT then
				gThemeTabCnt = Round(arrCnt/gMAX_CNT,0)
			else
				gThemeTabCnt = 1
			end if
			
		end if
		
	end if
	
	InsertFormTabPage()

End Function

'============================================================================
'
'============================================================================
Function InsertFormTabPage()
	
	'----------------------------------------------------------------
	'페이지생성
	'----------------------------------------------------------------
	for i = 0 to gThemeTabCnt - 1
		contTheme.FormTab0.insertPage(i, "page"..i, "page"..i, "nrshidx50130_s1", "0", "테마"..i)
		contTheme.FormTab0.currenttab = i
	next
	
	'----------------------------------------------------------------
	'초기페이지 지정
	'----------------------------------------------------------------
	contTheme.FormTab0.currenttab = 0
	contTheme.FormTab0_OnTabChanged(0)
	
	'----------------------------------------------------------------
	'페이지 인덱스 전달
	'----------------------------------------------------------------
	SendIndexInfo()
	
	'----------------------------------------------------------------
	'테마리스트 전달
	'----------------------------------------------------------------
	SendThemeList()
	
	'----------------------------------------------------------------
	'선택된 테마인덱스가 있었는지 확인
	'----------------------------------------------------------------
	CheckSelectTheme()

End Function

'============================================================================
'
'============================================================================
Function SendIndexInfo()
	
	for i = 0 to gThemeTabCnt - 1
		Form.triggerEvent("FormTab0.".."page"..i, "INIT_INDEX", i)
	next
	
End Function

'============================================================================
' 조회된 테마리스트를 각 폼탭 페이지에 8개씩 짤라서 전달.
'============================================================================
Function SendThemeList()

	'----------------------------------------------------------------
	'생성된 폼탭에 이미지명@테마명@테마코드 전달(gMAX_CNT(8) 개씩 짤라서 전달)
	'----------------------------------------------------------------
	arrThemeList = Split(gThemeList,"^")
	
	for i = 0 to gThemeTabCnt - 1
		
		if i == 0 then
			
			endIndex = 0
			
			if #arrThemeList >= gMAX_CNT then
				endIndex = gMAX_CNT -1
			else
				endIndex = #arrThemeList - 1
			end if
			
			for j = 0 to endIndex
			
				if j == 0 then
					szList = arrThemeList(0)
				else
					szList = szList .. "^" .. arrThemeList(j)
				end if
				
			next
			
			'Form.ShowAlert("page"..i, szList)
			Form.triggerEvent("FormTab0.".."page"..i, "SEND_THEME_LIST", szList)
		
		else
		
			endIndex = i * gMAX_CNT
			
			if #arrThemeList >= gMAX_CNT * (i+1) then
				endIndex = gMAX_CNT * (i+1) -1
			else
				endIndex = gMAX_CNT * i + (#arrThemeList - gMAX_CNT * i) -1
			end if 
			
			
			for j = i * gMAX_CNT to endIndex
				
				if j == i * gMAX_CNT then
					szList = arrThemeList(i * gMAX_CNT)
				else
					szList = szList .. "^" .. arrThemeList(j)
				end if
			
			next 
			
			'Form.ShowAlert("page"..i, szList)
			Form.triggerEvent("FormTab0.".."page"..i, "SEND_THEME_LIST", szList)
		
		end if
	
	next
	
End Function

