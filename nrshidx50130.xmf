'============================================================================
Function MoveScreen(sType,nIndex)

	'화면이동 전 현재설정 값 저장
	SaveCurCondData(nIndex)

	'---------------------------------------------------------
	'현재가 > 호가
	'---------------------------------------------------------
	if sType == "hyun" then
		
		szMk = contBody.Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = contBody.Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = contBody.Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
			Form.OpenScreen("11000" , szItemCode.."★".."ETF".."★".."1")
		else
		
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
