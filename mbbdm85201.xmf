	<SCRIPT_INFO _len="3844" _ulen="3504" >
'===========================================================================
'진입점에서 설정되는 정보 ---------------------------------------
Dim g_BDM_FRST_MAPID			'최초진입점화면ID

Dim Acno
Dim ApltGubun
Dim ApltCntt
Dim ApltTime


Dim g_Flag
'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	'계좌번호★신청업무★신청일시
	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"★")
	
	Acno 		= arrData(0)
	ApltGubun	= arrData(1)
	ApltTime		= arrData(2)
	'Acno = "30105876"
	'ApltGubun = "HTS"
	'ApltTime ="20210415145112871"
	'ShowAlert("안내",ApltTime)
	'Acno 		= "12345678"
	'ApltGubun	= "HTS_LIMIT"
	'ApltGubun	= "RESET"
	
	'ApltTime		= "2020.12.12 17 :21"
	
	g_BDM_FRST_MAPID = Form.GetSharedData("BDM_FRST_MAPID"         , false)  '최초진입화면ID
	'ShowAlert("g_BDM_FRST_MAPID", g_BDM_FRST_MAPID)
	
	Container0.Container1.Table0.visible = false
	Container0.Container1.Table1.visible = false
	
	
	'온라인서비스 + 이체한도등록 동시신청시 별도 그리드
	if ApltGubun == "HTS_LIMIT" then 
		Container0.Container1.Table1.visible = true
	else 
		Container0.Container1.Table0.visible = true
		
	end if
	
	if ApltGubun == "HTS" then
		ApltCntt = "온라인서비스 신청"
		
	elseif ApltGubun == "LIMIT" then
		ApltCntt = "온라인 이체한도 등록 및 증액"
		
	elseif ApltGubun == "UNCONFIRM" then
		ApltCntt = "온라인개설계좌 실명확인"
		
	elseif ApltGubun == "AGREE" then
		ApltCntt = "인증서 온라인신원확인 동의"		
	
	elseif ApltGubun == "BANKACCT" then
		ApltCntt = "타기관 은행이체 등록"
		
	elseif ApltGubun == "MERITZACCT" then
		ApltCntt = "메리츠 종합계좌간 대체 등록"		
		
	elseif ApltGubun == "RESET" then
		ApltCntt = "계좌비밀번호 재설정"
	end if
	
	'Table Data Set
	if ApltGubun == "HTS_LIMIT" then 
		
		Table1_colorSet()
		Container0.Container1.Table1.SetCellString( 3, 2, Acno 						)
		Container0.Container1.Table1.SetCellString( 4, 2, "온라인서비스신청" 			)
		Container0.Container1.Table1.SetCellString( 5, 2, "온라인 이체한도 등록 및 증액" 	)
		Container0.Container1.Table1.SetCellString( 6, 2, ApltTime 						)
	else 
		Table0_colorSet()
		Container0.Container1.Table0.SetCellString( 3, 2, Acno 	)
		Container0.Container1.Table0.SetCellString( 4, 2, ApltCntt )
		Container0.Container1.Table0.SetCellString( 5, 2, ApltTime )
	end if
	
End Sub
'============================================================================

Sub Table0_colorSet()

	for i=0 to 7
		for j=0 to 4
			Container0.Container1.Table0.SetCellBgColor(i , j , "276")
		next
	next
	Container0.Container1.Table0.SetCellBgColor(2 , 1 , "267")
	Container0.Container1.Table0.SetCellBgColor(2 , 2 , "267")
	
End Sub
'============================================================================

Sub Table1_colorSet()

	for i=0 to 8
		for j=0 to 4
			Container0.Container1.Table1.SetCellBgColor(i , j , "276")
		next
	next
	Container0.Container1.Table1.SetCellBgColor(2 , 1 , "267")
	Container0.Container1.Table1.SetCellBgColor(2 , 2 , "267")
	
End Sub
'============================================================================
Sub btnOK_OnClick()
	g_Flag = "ok"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("BDM_NMETBSWRGB", "") '업무구분초기화 JMY
	Form.SendReturnToParent("mbbdm85201_end" , g_Flag)
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용
	btnOK_OnClick()
End Sub


	</SCRIPT_INFO>
</ROOT>