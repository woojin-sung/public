Dim g_OsType
Dim gFoldPannelHeight		'펼쳐보기 시 판넬 행높이
Dim gUnFoldPannelHeight	'평상 시 판넬 행높이

Dim gETF_SUPER_HIS_KEY
gETF_SUPER_HIS_KEY = "ETF_SUPER_HISTORY"

Dim gOvrsMarketList()
gOvrsMarketList = {"AX","NY","OQ","SZ","SH","HK","JP"}

'============================================================================
Sub Form_OnFormInitBefore()

	g_OsType = Form.GetSharedData("&OS_TYPE", false)
	Image0.setMaintainingRatio("1")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	'행 펼쳤을때/접혔을때 높이값 설정
	if gOsType == "1" then
		gFoldPannelHeight = 131
		gUnFoldPannelHeight = 60
	else
		gFoldPannelHeight = 132
		gUnFoldPannelHeight = 60
	end if
	
	gWidePannelIndex = -1

	FormTab0.SetUseOnlyHeader(true)
	InsertFormTabPage()

	
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	
	DATAMANAGER.RequestTranData("ohhts_metf_018r")
	
End Sub

'============================================================================
' UI설정
'============================================================================
Sub SettingUI(nRowCnt)
	
	
	
	if nRowCnt == 0 then
	
		imgNotice.visible = true
		LabelGuideText.visible = true
		Pannel0.visible = false
	
	else
	
		imgNotice.visible = false
		LabelGuideText.visible = false
		Pannel0.visible = true
		
	end if



	'------------------------------
	'공통
	'------------------------------
	'행개수 설정
	Pannel0.rowcount = nRowCnt 
		
	'글자색상/최대라인/패딩값 조정
	for i = 0 to nRowCnt -1
		Pannel0.setPropCardCell("fgcolor","LabelCode"	,		i,"333")	'회색
		Pannel0.setPropCardCell("fgcolor","LabelGubun",		i,"333")	'회색
		Pannel0.setPropCardCell("fgcolor","LabelGubunData",	i,"333")	'회색
		
		Pannel0.setPropCardCell("maxlinecnt","LabelName",i,"1^-4") '컨트롤 속성에 멀티라인이 체크되있어야 적용됨.
		
		Pannel0.setPropCardCell("paddinginfo","LabelNo",i,"0,0,0,0") 
		Pannel0.setPropCardCell("paddinginfo","LabelCode",i,"0,0,0,0")
		Pannel0.setPropCardCell("paddinginfo","LabelName",i,"0,0,0,0") 
		Pannel0.setPropCardCell("paddinginfo","LabelGubun",i,"0,0,0,0") 
		Pannel0.setPropCardCell("paddinginfo","LabelGubunData",i,"0,0,0,0") 
		Pannel0.setPropCardCell("paddinginfo","LabelHyun",i,"0,0,0,0") 
		Pannel0.setPropCardCell("paddinginfo","LabelDebi",i,"0,0,0,0") 
	next

	'------------------------------
	'OS별
	'------------------------------
	if g_OsType == "1" then
		
		'폼탭/판넬 위치 조정
		FormTab0.left = 10
		FormTab0.width = 345
		
		Pannel0.left = 10
		Pannel0.width = 345
		
		for i = 0 to nRowCnt -1
			if i == nRowCnt -1 then
				Pannel0.setPropCardCell("width","LabelSeperator",4, "0" ) '마지막행구분선은 숨김처리
			else
				Pannel0.setPropCardCell("width","LabelSeperator",i,"345")
			end if	
		next
		
	else
		
		Pannel0.setPropCardCell("width","LabelSeperator",nRowCnt -1, "0" )	'마지막행구분선은 숨김처리
		
	end if
	
	

End Sub

'============================================================================
' 상단 폼탭 페이지 생성
'============================================================================
Sub InsertFormTabPage()
	
	'활성화/비활성화/여백
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 5)   
	
	'활성화/비활성화 폰트색상
	FormTab0.setTabHeaderFgColor("28" , "321") 								   

	'페이지생성
	if g_OsType == "1" then
		FormTab0.insertPage( 0, "page0", "page0", "nrsempty", "0", "상승")
		FormTab0.insertPage( 1, "page1", "page1", "nrsempty", "0", "하락")
		FormTab0.insertPage( 2, "page2", "page2", "nrsempty", "0", "거래량")	
		FormTab0.insertPage( 3, "page3", "page3", "nrsempty", "0", "시가총액")
		FormTab0.insertPage( 4, "page4", "page4", "nrsempty", "0", "배당률")	
		FormTab0.insertPage( 5, "page5", "page5", "nrsempty", "0", "신규상장")
		FormTab0.insertPage( 6, "page6", "page6", "nrsempty", "0", "순매수")
		FormTab0.insertPage( 7, "page7", "page7", "nrsempty", "0", "순매도")
	else
		FormTab0.insertPage( 0, "page0", "page0", "nrsempty", "0", " 상승 ")
		FormTab0.insertPage( 1, "page1", "page1", "nrsempty", "0", " 하락 ")
		FormTab0.insertPage( 2, "page2", "page2", "nrsempty", "0", " 거래량 ")	
		FormTab0.insertPage( 3, "page3", "page3", "nrsempty", "0", " 시가총액 ")
		FormTab0.insertPage( 4, "page4", "page4", "nrsempty", "0", "  배당률  ")	
		FormTab0.insertPage( 5, "page5", "page5", "nrsempty", "0", "신규상장")
		FormTab0.insertPage( 6, "page6", "page6", "nrsempty", "0", " 순매수 ")
		FormTab0.insertPage( 7, "page7", "page7", "nrsempty", "0", " 순매도 ")
	end if
	
	'초기페이지 지정
	FormTab0.currenttab = 0
	FormTab0_OnTabChanged(0)
	
End Sub

'============================================================================
' 선택 카테고리 한글명 가져오기
'============================================================================
Function GetCategoryName()

	'상승,하락,신규상장인 경우에는 추가로 보여주는 데이터 없음.
	nTab = Cint(FormTab0.currenttab)
	
	Select Case nTab
		Case 0
			return "" '상승
		Case 1
			return "" '하락
		Case 2
			return "거래량"
		Case 3
			return "시가총액"
		Case 4
			return "배당률"
		Case 5
			return "" '신규상장
		Case 6
			return "순매수"
		Case 7
			return "순매도"
	End Select

End Function

'============================================================================
' 선택 카테고리 데이터가져오기
'============================================================================
Function GetCategoryData(nIndex)

	'상승,하락,신규상장인 경우에는 추가로 보여주는 데이터 없음.
	nTab = Cint(FormTab0.currenttab)
	szData = ""
	
	Select Case nTab
		Case 0 '상승
		
		Case 1 '하락
		
		Case 2 '거래량
			Pannel0.setPropCardCell("mask","LabelGubunData",nIndex,"0,0,,,0,,0,1,0")
			szData = Cint(DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_VOL" , nIndex))
		
		Case 3 '시가총액
			Pannel0.setPropCardCell("mask","LabelGubunData",nIndex,"0,0,,,0,,0,1,0")
			szData = CDbl(DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_AVLS" , nIndex))
		
		Case 4 '배당률
			Pannel0.setPropCardCell("mask","LabelGubunData",nIndex,"1,0,,,0,,2,1,0")
			szData = Cdbl(DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_DVDN_ERT" , nIndex)) .."%"
		
		Case 5 '신규상장
		
		Case 6 '순매수
			Pannel0.setPropCardCell("mask","LabelGubunData",nIndex,"0,0,,,0,,0,1,0")
			szData = Cint(DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_TOTAL_SHNU_QTY" , nIndex))
		
		Case 7 '순매도
			Pannel0.setPropCardCell("mask","LabelGubunData",nIndex,"0,0,,,0,,0,1,0")
			szData = Cint(DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_TOTAL_SELN_QTY" , nIndex))
			
	End Select
	
	return szData

End Function

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "ohhts_metf_018r" then
	
		nTab = CInt(FormTab0.currenttab)
		
		DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock1", "FID_INPUT_CLS_CODE" , 0 , nTab)
		DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock1", "FIDX_INPUT_NTNL_CODE", 0 , "YNNNNN")
		
		for i = 0 to #gOvrsMarketList - 1 
			
			'0:지연 / 1:실시간
			sRealSiseYN = GetRealTimeSiseYN(gOvrsMarketList[i])
			
			if sRealSiseYN == "" then
				sRealSiseYN = "0"
			end if
			
			DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , i , gOvrsMarketList[i])
			DATAMANAGER.SetDataValue(0, "ohhts_metf_018r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , i , sRealSiseYN)
			
		next
		
	
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "ohhts_metf_018r" then
		
		'nCnt = 조회데이터 수(최대 5개까지만 보여주므로 5개이상일 경우 상위 5개까지만 보여줌)
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_018r", "OutBlock1")
		
		if nCnt > 5 then
			nCnt = 5
		end if
		
		'데이터개수에 따라 UI설정
		SettingUI(nCnt)
				
		'판넬에 데이터 삽입
		for nIndex = 0 to nCnt -1
		
			'sFlag = 국가구분
			'sName = 종목명
			'sCode = 종목코드(티커)
			'sHyun = 현재가
			'sDebi = 등락률
			
			sName 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FIDX_KOR_ISNM"					, nIndex)
			sCode 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_OVRS_ISCD" 				, nIndex)
			sHyun 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_PRPR" 					, nIndex)
			sDebi 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_PRDY_CTRT" 				, nIndex)
			sNation 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_LSTN_NTNL_CODE" 			, nIndex)
			sMarket  = DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, nIndex)
			
			sNew		= DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_NEW_LSTN_YN" 				, nIndex)
			sTrht	= DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_TRHT_YN"					, nIndex)
			sSign 	= DATAMANAGER.GetDataValue(0, "ohhts_metf_018r", "OutBlock1", "FID_PRDY_VRSS_SIGN" 			, nIndex)
						
			ChangeControlPosAndRowHeight(1,nIndex)
			
			sNationFlagName = GetNationFlagName(sNation)
			Pannel0.setPropCardCell("maintainratio","ImageFlag",nIndex,"1")
			Pannel0.setPropCardCell("imgpath","ImageFlag",nIndex,sNationFlagName)
			
			sGubun = GetCategoryName()
			sGubunData = GetCategoryData(nIndex)
			
			Pannel0.SetCellValue("LabelNo"	,		nIndex,	nIndex+1 .. ".")
			Pannel0.SetCellValue("LabelName",		nIndex,	sName)
			Pannel0.SetCellValue("LabelCode",		nIndex,	sCode)
			
			'--------------------------
			'현재가
			'--------------------------
			nDecimalLen = GetNationDecimalLen(sNation)
			sHyun = FormatNumber(sHyun,nDecimalLen)
			Pannel0.SetCellValue("LabelHyun",nIndex,sHyun.." | "..sDebi.."%")
			
			
			'등락률(현재가 라벨과 통합)
			'Pannel0.SetCellValue("LabelDebi",		nIndex,	sDebi)
			
			Pannel0.SetCellValue("LabelGubun",		nIndex,	sGubun)
			Pannel0.SetCellValue("LabelGubunData",	nIndex,	sGubunData)
			Pannel0.SetCellValue("LabelBodyTicker",  nIndex,	sCode)
			Pannel0.SetCellValue("LabelBodyMarket",	nIndex,	sMarket)

			'--------------------------
			'현재가/등락률 색상표시
			'--------------------------
			if sSign == "2" then '상승
				Pannel0.setPropCardCell("fgcolor","LabelHyun",nIndex,"290")
				Pannel0.setPropCardCell("fgcolor","LabelDebi",nIndex,"290")
			elseif sSign == "5" then '하락
				Pannel0.setPropCardCell("fgcolor","LabelHyun",nIndex,"291")
				Pannel0.setPropCardCell("fgcolor","LabelDebi",nIndex,"291")
			else '보합
				Pannel0.setPropCardCell("fgcolor","LabelHyun",nIndex,"333")
				Pannel0.setPropCardCell("fgcolor","LabelDebi",nIndex,"333")
			end if
			
			'--------------------------
			'거래정지
			'--------------------------
			if sTrht == "Y" then
				sText = Pannel0.GetCellValue("LabelCode",nIndex)
				sText = sText .. " | " .. "거래정지"
				Pannel0.SetCellValue("LabelCode",nIndex,sText)
			end if
			
			'--------------------------
			'신규상장 여부
			'--------------------------
			if sNew == "Y" then
				sText = Pannel0.GetCellValue("LabelCode",nIndex)
				sText = sText .. " | " .. "신규상장"
				Pannel0.SetCellValue("LabelCode",nIndex,sText)
			end if
			
			
			
		next
		

	end if
	
End Sub

