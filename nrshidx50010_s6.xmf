'============================================================================
' 국가코드별 국기이미지 명
'============================================================================
Function GetNationFlagName(sNation)
	
	if sNation == "USA" then
		return "flag_us2"
	elseif sNation =="KOR" then
		return "flag_kor_round"
	elseif sNation =="HKG" then
		return "flag_hk"
	elseif sNation =="CHN" then
		return "flag_chn"
	elseif sNation =="JPN" then
		return "flag_jp2"
	else
		return "flag_general"
	end if

End Function

'============================================================================
' 선택행 링크영역 펼치기
'============================================================================
Function foldBottomLinkArea(nIndex,nHeight)
	
	'판넬 높이 조정
	Pannel0.SetCardWHAt(nIndex,nHeight)
	
	'링크영역 컨트롤 조정
	Pannel0.setPropCardCell("top","ImageBottomLinkBG",nIndex,"62") 
	Pannel0.setPropCardCell("top","ButtonLink0",nIndex,"76")
	Pannel0.setPropCardCell("top","ButtonLink1",nIndex,"76")
	Pannel0.setPropCardCell("top","ButtonLink2",nIndex,"76")
	Pannel0.setPropCardCell("top","ButtonLink3",nIndex,"76")
	Pannel0.setPropCardCell("top","ButtonLink4",nIndex,"76")
	Pannel0.setPropCardCell("top","LabelSeperator",nIndex,"131")
	
	Pannel0.setPropCardCell("visible","ImageBottomLinkBG",nIndex,"1")
	Pannel0.setPropCardCell("visible","ButtonLink0",nIndex,"1")
	Pannel0.setPropCardCell("visible","ButtonLink1",nIndex,"1")
	Pannel0.setPropCardCell("visible","ButtonLink2",nIndex,"1")
	Pannel0.setPropCardCell("visible","ButtonLink3",nIndex,"1")
	Pannel0.setPropCardCell("visible","ButtonLink4",nIndex,"1")
		

End Function

'============================================================================
' 선택행 링크영역 접기
'============================================================================
Function unfoldBottomLinkArea(nIndex,nHeight)

	'판넬 높이 조정
	Pannel0.SetCardWHAt(nIndex,nHeight)
	
	'링크영역 컨트롤 조정
	Pannel0.setPropCardCell("top","LabelSeperator",nIndex,"59")
	
	Pannel0.setPropCardCell("visible","ImageBottomLinkBG",nIndex,"0")
	Pannel0.setPropCardCell("visible","ButtonLink0",nIndex,"0")
	Pannel0.setPropCardCell("visible","ButtonLink1",nIndex,"0")
	Pannel0.setPropCardCell("visible","ButtonLink2",nIndex,"0")
	Pannel0.setPropCardCell("visible","ButtonLink3",nIndex,"0")
	Pannel0.setPropCardCell("visible","ButtonLink4",nIndex,"0")
	
End Function

'============================================================================
' 판넬클릭 시, 링크버튼 + 관심종목 버튼 클릭 여부 확인
'============================================================================
Function isLinkButton(sCellID)
	
	if sCellID == "ButtonLink0" or sCellID == "ButtonLink1" or sCellID == "ButtonLink2" or sCellID == "ButtonLink3" or sCellID == "ButtonLink4" then
		return true
	else
		return false
	end if

End Function

'============================================================================
' 데이터행 높이 및 컨트롤 위치 조정
' sType 1:(기본)접힌상태 2:펼침상태
'============================================================================
Function ChangeControlPosAndRowHeight(nType,nIndex)

	if nType == 1 then
	
		'종목명
		Pannel0.setPropCardCell("paddinginfo","LabelName",nIndex,"0,0,0,0")
		Pannel0.setPropCardCell("fontsize","LabelName",nIndex,"-2")
		Pannel0.setPropCardCell("maxlinecnt","LabelName",nIndex,"1^-4")
		
		'종목코드(티커)
		Pannel0.setPropCardCell("paddinginfo","LabelCode",nIndex,"0,0,0,0")
		
		'현재가
		Pannel0.setPropCardCell("paddinginfo","LabelHyun",nIndex,"0,0,0,0")
			
		'등락률
		Pannel0.setPropCardCell("paddinginfo","LabelDebi",nIndex,"0,0,0,0")
		
		'카테고리 구분
		Pannel0.setPropCardCell("paddinginfo","LabelGubun",nIndex,"0,0,0,0")
		
		'카테고리 데이터
		Pannel0.setPropCardCell("paddinginfo","LabelGubunData",nIndex,"0,0,0,0")
		
		'구분선
		Pannel0.setPropCardCell("top","LabelSeperator",nIndex,"59")	
		Pannel0.SetCardWHAt(nIndex,gUnFoldPannelHeight)
		
'		'큰글씨 사용모드일때 폰트크기 대응
'		if gbLargeFont then
'		
'			'기본폰트크기(-3) - (큰글씨 설정값 * 2)
'			'큰글씨 설정값 = 1:조금 크게 / 2 : 크게
'			sTransFontsize = Cstr( -3 - (Cint(gsLargeFontsize) * 2))
'					
'			'보수
'			Pannel0.setPropCardCell("fontsize","LabelBosuTitle",nIndex,sTransFontsize)
'			Pannel0.setPropCardCell("fontsize","LabelBosuData",nIndex,sTransFontsize)
'			
'			'NAV
'			Pannel0.setPropCardCell("fontsize","LabelNAVTitle",nIndex,sTransFontsize)
'			Pannel0.setPropCardCell("fontsize","LabelNAVData",nIndex,sTransFontsize)
'			
'			'거래량
'			Pannel0.setPropCardCell("fontsize","LabelVolTitle",nIndex,sTransFontsize)
'			Pannel0.setPropCardCell("fontsize","LabelVolData",nIndex,sTransFontsize)
'			
'		end if
		
		
	else
		Pannel0.SetCardWHAt(nIndex,gFoldPannelHeight)
	end if

End Function
'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)

		'-------------------------------------------------------
		'펼쳐진 행이 없을 경우
		'-------------------------------------------------------
		if gWidePannelIndex < 0 then
		
			gWidePannelIndex = nIndex
			foldBottomLinkArea(nIndex,gFoldPannelHeight)
			
			'마지막행 클릭 시 스크롤 자동 이동
			if nIndex == 4 then
				Pannel0.toprow = nIndex
			end if
				
		'-------------------------------------------------------
		'펼쳐진 행이 있을 경우
		'-------------------------------------------------------
		else
		
			if isLinkButton(sCellID) then
				
				'화면링크버튼 클릭 시, 히스토리 리스트에 쌓는다.
				if sCellID == "ButtonLink0" then '현재가
					
					SetHistory("set",nIndex)
					MoveScreen("hyun",nIndex)
				
				elseif sCellID == "ButtonLink1" then '차트
				
					SetHistory("set",nIndex)
					MoveScreen("chart",nIndex)
				
				elseif sCellID == "ButtonLink2" then '종목정보
				
					SetHistory("set",nIndex)
					MoveScreen("info",nIndex)
				
				elseif sCellID == "ButtonLink3" then '매수
				
					SetHistory("set",nIndex)
					MoveScreen("mesu",nIndex)
				
				elseif sCellID == "ButtonLink4" then '매도
				
					SetHistory("set",nIndex)
					MoveScreen("medo",nIndex)
					
				end if
				
				
			'링크버튼 외 영역 클릭 시(접혀도 되는 경우임)
			else
			
				'이미 펼쳐진 행을 다시 선택했을때는 접음
				if gWidePannelIndex == nIndex then
					gWidePannelIndex = -1
					unfoldBottomLinkArea(nIndex,gUnFoldPannelHeight)
			
				'이미 펼쳐진 행과 다른행을 선택한 경우
				'기존 펼쳐진 행을 접고 선택한 행을 펼침
				else
					unfoldBottomLinkArea(gWidePannelIndex,gUnFoldPannelHeight)
					gWidePannelIndex = nIndex
					foldBottomLinkArea(nIndex,gFoldPannelHeight)
					
					'마지막행 클릭 시 스크롤 자동 이동
					if nIndex == 4 then
						Pannel0.toprow = nIndex
					end if
				
				end if
			
			
			end if
			
		end if
		
		
	
End Sub

'============================================================================
Function SetHistory(sGubun,nIndex)

	szItemCode = Pannel0.GetCellValue("LabelBodyTicker",nIndex)
	szMk = Pannel0.GetCellValue("LabelBodyMarket",nIndex)
	sData = szMk .. "@" .. szItemCode
	
	Form.manageTotalSearch(gETF_SUPER_HIS_KEY, sGubun, sData)
	
	'테스트확인용
	'test = Form.manageTotalSearch(gETF_SUPER_HIS_KEY, "get", "")
	'Form.ShowAlert("test", test)

End Function

'============================================================================
' 링크버튼 화면이동 이벤트
'============================================================================
Function MoveScreen(sType,nIndex)

	'화면이동 전 현재설정 값 저장
	'SaveCurCondData(nIndex)
	Form.triggerEvent("#", "SAVE_ETF_HOME_SCROLL", "")
	
	'---------------------------------------------------------
	'현재가 > 호가
	'---------------------------------------------------------
	if sType == "hyun" then
		
		szMk = Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
			Form.OpenScreen("11000" , szItemCode.."★".."ETF".."★".."1")
		else
			
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16000" , szMk.."@"..szItemCode.."★".."ETF".."★".."1")
			end if
			
		end if
	
	'---------------------------------------------------------
	'차트
	'---------------------------------------------------------
	elseif sType == "chart" then
		
		szMk = Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
			Form.OpenScreen("13000" , szItemCode)
		else
		
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16020", "")	
			end if
			
		end if
	
	'---------------------------------------------------------
	' 현재가 > 종목정보
	'---------------------------------------------------------
	elseif sType == "info" then
		
		szMk = Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
			Form.OpenScreen("11000" , szItemCode.."★".."ETF".."★".."0")
		else
			
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16000" , szMk.."@"..szItemCode.."★".."ETF".."★".."0")
			end if
		
		end if
	
	'---------------------------------------------------------
	' 주문(매수)
	'---------------------------------------------------------
	elseif sType == "mesu" then
		
		szMk = Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
			
			Form.OpenScreen("12000" , "기타".."★".."0".."★"..szItemCode)
			
		else
			
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16060", "0") '매수	
			end if
			
		
		end if
	
	'---------------------------------------------------------
	' 주문(매도)
	'---------------------------------------------------------
	elseif sType == "medo" then
		
		szMk = Pannel0.GetCellValue("LabelBodyMarket",nIndex)
		szItemCode = Pannel0.GetCellValue("LabelBodyTicker",nIndex)
		szName = Pannel0.GetCellValue("LabelName",nIndex)
		
		if szMk == "J" then
		
			Form.OpenScreen("12000" , "기타".."★".."1".."★"..szItemCode)
			
		else
			
			if szMk <> "" and szItemCode <> "" then
				Form.SetSharedData( "&ITEM_CODE" , szMk.."@"..szItemCode)
				Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
				Form.SetSharedData( "&ITEM_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMk.."@"..szItemCode.."★"..szName.."★".."", "" )
				Form.OpenScreen("16060", "1") '매도	
			end if
		
		end if
		
	
	'---------------------------------------------------------
	' 더보기
	'---------------------------------------------------------
	elseif sType == "more" then
	
		'----------------------------------------------------------------------------
		'순위화면 > 링크화면 이동 후 되돌아 왔을때 사용하는 값인데
		'여기서 진입할때는 모두 클리어하고 진입한다. 
		'----------------------------------------------------------------------------
		Form.SetSharedData("ETF_RANKING_GUBUN" 			, "")
		Form.SetSharedData("ETF_RANKING_FILTER_NATION" 	, "")
		Form.SetSharedData("ETF_RANKING_FILTER_INDEX" 	, "")
		Form.SetSharedData("ETF_RANKING_FILTER_FROM" 		, "")
		Form.SetSharedData("ETF_RANKING_FILTER_TO" 		, "")
		Form.SetSharedData("ETF_RANKING_SELECT_INDEX" 	, "")
		
		Form.OpenScreen("50511" , FormTab0.currenttab)
	
	end if

End Function

'============================================================================
'
'============================================================================
Function GetRealTimeSiseYN(sMarketCode)
	
	szRealAble = Form.GetSharedData( "REALTIME_"&sMarketCode, false )
	return szRealAble
	
End Function
'============================================================================
' 국가코드별 소수점자리 수
'============================================================================
Function GetNationDecimalLen(sNation)
	
	if sNation == "USA" then
		return 4
	elseif sNation =="KOR" then
		return 0
	elseif sNation =="HKG" then
		return 3
	elseif sNation =="CHN" then
		return 3
	elseif sNation =="JPN" then
		return 1
	else
		return 4
	end if
	
End Function




