'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_szGbn, g_szChk, g_szTab, g_szSelect
g_szAcnt, g_szAcntCd, g_szGbn, g_szChk, g_szTab, g_szSelect = "", "", "", "", "", ""

Dim g_szAcntPwd
g_szAcntPwd = ""

'20200331 HWG START : 고유MTS
Dim g_szFundCd, g_szFundPwd
g_szFundCd, g_szFundPwd = "", ""
'20200331 HWG END

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' Set_Unit
'============================================================================
Function Set_Unit(szData, sDecimal)
	
	sztemp = CStr(szData)
	szChk = InStr(sztemp, ".")
	sDecimal = CStr(CInt(sDecimal))
	
	if CStr(szChk) == "0" then
		if sDecimal = "1" then
			sztemp = sztemp & ".0"	
		elseif sDecimal = "2" then
			sztemp = sztemp & ".00"	
		elseif sDecimal = "3" then
			sztemp = sztemp & ".000"	
		elseif sDecimal = "4" then
			sztemp = sztemp & ".0000"	
		end if 
	else
		szCha = CInt(Len(sztemp) - szChk)

		if szCha > CInt(sDecimal) then
			sztemp = Round(sztemp, CInt(sDecimal))
		end if
		
		szCha = CInt(Len(sztemp) - szChk)
		
		if CStr(szCha) == "1" then 
			if sDecimal == "2" then
				sztemp = sztemp & "0"	
			elseif sDecimal == "3" then
				sztemp = sztemp & "00"	
			elseif sDecimal == "4" then
				sztemp = sztemp & "000"
			else 
				sztemp = sztemp
			end if 	
		elseif CStr(szCha) == "2" then 
			if sDecimal == "3" then
				sztemp = sztemp & "0"	
			elseif sDecimal == "4" then
				sztemp = sztemp & "00"
			else
				sztemp = sztemp
			end if	
		elseif CStr(szCha) == "3" then 
			if sDecimal == "4" then
				sztemp = sztemp & "0"
			else 
				sztemp = sztemp
			end if	
		else
			sztemp = sztemp
		end if
	end if
	
	return sztemp
End Function
'============================================================================
' SetGridData
'============================================================================
Function SetGridData()
	For iCnt = grdList.rowcount - 1 To 0 Step -1
		szType 	= grdList.GetCellData("bd_cell7" , iCnt)
		szVndr 	= grdList.GetCellData("bd_cell17" , iCnt)
		
		'20200331 HWG START : 고유MTS
		' 시장구분
		if szType == "01" then
			grdList.SetCellData("bd_cell16", iCnt, "미국")
		elseif szType == "02" then
			grdList.SetCellData("bd_cell16", iCnt, "홍콩")
		elseif szType == "03" then
			grdList.SetCellData("bd_cell16", iCnt, "중국") '20201218 SWJ START : 컬럼이 국가이므로 국가로(시장일땐 상해, 심천)
		elseif szType == "04" then
			grdList.SetCellData("bd_cell16", iCnt, "중국") '20201218 SWJ END
		elseif szType == "05" then
			grdList.SetCellData("bd_cell16", iCnt, "일본")
		elseif szType == "06" then
			grdList.SetCellData("bd_cell16", iCnt, "호주")
		elseif szType == "07" then
			grdList.SetCellData("bd_cell16", iCnt, "싱가포르")
		
		'20201218 SWJ START : 국가명 추가
		elseif szType = "08" then
			grdList.SetCellData("bd_cell16", iCnt, "영국")
			
		elseif szType = "09" then
			grdList.SetCellData("bd_cell16", iCnt, "영국")
	
		elseif szType = "10" then
			grdList.SetCellData("bd_cell16", iCnt, "독일")
			
		elseif szType = "11" then
			grdList.SetCellData("bd_cell16", iCnt, "핀란드")
	
		elseif szType = "12" then
			grdList.SetCellData("bd_cell16", iCnt, "프랑스")
			
		elseif szType = "13" then
			grdList.SetCellData("bd_cell16", iCnt, "벨기에")
			
		elseif szType = "14" then
			grdList.SetCellData("bd_cell16", iCnt, "네덜란드")
			
		elseif szType = "15" then
			grdList.SetCellData("bd_cell16", iCnt, "포르투갈")
			
		elseif szType = "16" then
			grdList.SetCellData("bd_cell16", iCnt, "그리스")
			
		elseif szType = "17" then		
			grdList.SetCellData("bd_cell16", iCnt, "아일랜드")
				
		elseif szType = "18" then
			grdList.SetCellData("bd_cell16", iCnt, "이탈리아")
			
		elseif szType = "19" then
			grdList.SetCellData("bd_cell16", iCnt, "스페인")
			
		elseif szType = "20" then
			grdList.SetCellData("bd_cell16", iCnt, "오스트리아")			
		'20201218 SWJ END
		
		elseif szType == "21" then
			grdList.SetCellData("bd_cell16", iCnt, "캐나다")
		elseif szType == "23" then
			grdList.SetCellData("bd_cell16", iCnt, "인도네시아")
		elseif szType == "24" then
			grdList.SetCellData("bd_cell16", iCnt, "베트남")
		'20240321 HWG START : 스위스 거래소 오프라인 주문 대응
		elseif szType = "26" then
			grdList.SetCellData("bd_cell16", iCnt, "스위스")
		'20240321 HWG END	
		end if
		
		'20201218 SWJ START : 거래소명 데이터로 연결 
		szVndrStr = Transform_Exid(szVndr)
		grdList.SetCellData("bd_cell6", iCnt, szVndrStr)
		'20201218 SWJ END
		
		rate = grdList.GetCellData("bd_cell3" , iCnt)

		if rate <> null or rate <> "" then
			if tonumber(rate) > 1 then
				grdList.SetCellFgColor("bd_cell13", iCnt, "1")
			elseif tonumber(rate) < 1 Then
				grdList.SetCellFgColor("bd_cell13", iCnt, "2")
			end if
		end if
		'20200331 HWG END
		
'		szRsflTpcd = grdList.GetCellData("bd_cell18", iCnt)
'
'		if szRsflTpcd == "1" or szRsflTpcd == "2" then
'			'grdList.SetCellFgColor( "bd_cell3",  iCnt, "1" )
'			grdList.SetCellFgColor( "bd_cell13", iCnt, "1" )
'		elseif szRsflTpcd == "4" or szRsflTpcd == "5" then
'			'grdList.SetCellFgColor( "bd_cell3",  iCnt, "2" )
'			grdList.SetCellFgColor( "bd_cell13", iCnt, "2" )
'		else
'			'grdList.SetCellFgColor( "bd_cell3",  iCnt, "3" )
'			grdList.SetCellFgColor( "bd_cell13", iCnt, "3" )
'		end if	
	Next
End Function

'============================================================================
' Request_Data()
'============================================================================
Function Request_Data()
	grdList.rowcount = 0
	
	DATAMANAGER.RequestTranData("obtro_oder_303r")
	
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szChkVal
	
	Form.SetScreenName("해외주식잔고")

	szChkVal = Form.LoadConfigData( "mhtro16060", "balance" )		'수수료비용반영

	If szChkVal <> "" Then
		chk1.checkstate = szChkVal
	End If
	
	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		'20200331 HWG START : 고유MTS
		g_szFundCd   	= tData(0)
		g_szFundPwd	= tData(1)
		'20200331 HWG END
		
		Request_Data()
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
'20200331 HWG START : 고유MTS
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	If szTranID = "obtro_oder_303r" Then
		DATAMANAGER.ClearInputData(0, "obtro_oder_303r")
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_303r", "InBlock1", "FNCD"			, 0, g_szFundCd)		
		DATAMANAGER.SetDataValue(0, "obtro_oder_303r", "InBlock1", "PROD_PSTN_CLS_CODE"	, 0, "1")
	End If
End Sub
'20200331 HWG END

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
'20200331 HWG START : 고유MTS
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obtro_oder_303r" Then
		SetGridData()
	End If
End Sub
'20200331 HWG END

'============================================================================
' chk_OnChange
'============================================================================
Sub chk_OnChange(sCheckState)
	If Trim(g_szAcnt) == "" Then
		Exit Sub
	End If
	
	g_szChk = "1"
	Request_Data()
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szLoanDate, szLoanCd, szLoanSr, szData
	Dim errmsg
	
	errmsg = "종목마스터의 오류로 주문 및 시세 조회가 불가능합니다. 동일 증상 반복 시 확인 버튼을 눌러 주시기 바랍니다.\n\n ※기타문의사항은 고객지원센터 (1588-3400)로 문의하여 주시기 바랍니다."

	if lRow > -1 then
		szCdName		= grdList.GetCellData("bd_cell11"	,    lRow)
		szCd			= grdList.GetCellData("bd_cell1"	,    lRow)
		szVndrCd		= grdList.GetCellData("bd_cell17"	,    lRow)
		szQty		= grdList.GetCellData("bd_cell12"	,    lRow)
		
		if szVndrCd = "0066" or szVndrCd = "0104" or szVndrCd = "0215" or szVndrCd = "0214" or szVndrCd = "0106" or szVndrCd = "0321" or szVndrCd = "0537" then	'20201218 SWJ START : 나스닥 추가로 넣음 (오류수정)
			szData = "잔고" & "★" & szCdName & "★" & szCd & "★" & szVndrCd & "★" & szQty 
			Form.SendReturnToParent("02000_BALANCE", szData)	'20200331 HWG : 고유MTS
			Form.CloseForm()
		else
			Form.ShowAlert("안내", "선택상품은 MTS에서 거래되지 않는 상품입니다.")
		end if
	else
		Form.MsgBox("알림", errmsg, "REUPDATE", 1)		
	end if

End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Form.SaveConfigData("mhtro16060", "balance", chk.checkstate ) '비용반영
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obtro_oder_303r" )
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REUPDATE" then
		if sRet == "ok" then
			Form.reUpdateFile("mts_master.crc")
		else
			exit sub
		end if
	end if
End Sub
'============================================================================
' 거래소코드 -> 거래소벤더코드 변환
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "0104" then	' 홍콩
		return "홍콩"
	elseif sValue == "HS0529I" then ' 항셍 지수
		return "항셍"
	elseif sValue == "0215" then ' 상해
		return "후강통"
	elseif sValue == "0214" then ' 심천거래소 종목
		return "선강통"
	elseif sValue == "0321" then ' 뉴욕
		return "뉴욕"
	elseif sValue == "0066" then ' 아멕스
		return "아멕스"
	elseif sValue == "0537" then ' 나스닥
		return "나스닥"
	elseif sValue == "0130" then ' 미국 OTCBB
		return "미국 OTCBB"
	elseif sValue == "0625" then ' S&P 지수
		return "S&P"
	elseif sValue == "0310" then ' 다우존스 지수
		return "다우존스"
	elseif sValue == "0106" then ' 도쿄
		return "도쿄"
	elseif sValue == "0107" then ' 오사카거래소 종목
		return "오사카"
	elseif sValue == "0112" then ' 자스닥거래소 종목
		return "자스닥"
	elseif sValue == "0889" then ' 니케이 지수
		return "니케이"
	elseif sValue == "0538" then ' 미국 나스닥 지수
		return "미국 나스닥"
	elseif sValue == "XSTC" then ' 베트남 호치민
		return "호치민"
	elseif sValue == "HSTC" then ' 베트남 하노이
		return "하노이"
		
'20201218 SWJ START : 오프라인 주문 거래국가 추가		
	elseif sValue == "XLON" then ' 영국
		if szType == "08" Then
			return "런던"
		elseif szType == "09" Then
			return "런던인터네셔널"
		end if
	elseif sValue == "0762" then ' 독일
	     return "독일"
	elseif sValue == "XHEL" then ' 핀란드
		return "핀란드"					   '20210114 SWJ START : 거래소명 변경(헬싱키 -> 핀란드)	
	elseif sValue == "0787" then
		if szType == "12" Then '프랑스
			return "프랑스"
	     elseif szType == "13" Then '벨기에
			return "벨기에"				   '20210114 SWJ START : 거래소명 변경(브뤼셀 -> 벨기에)
		elseif szType == "14" Then '네덜란드
			return "네덜란드"
		elseif szType == "15" Then '포르투갈
			return "포르투갈"
		end if
	elseif sValue == "ASEX" then ' 그리스
		 return "그리스"
	elseif sValue == "XDUB" then ' 아일랜드
		 return "아일랜드"
	elseif sValue == "XMIL" then ' 이탈리아
		 return "이탈리아"
	elseif sValue == "0216" then ' 스페인
		 return "스페인"
	elseif sValue == "XWBO" then ' 오스트리아
		 return "오스트리아"						   '20210114 SWJ START : 거래소명 변경(빈 -> 오스트리아)
     elseif sValue == "0372" then '캐나다
	      return "토론토"
     elseif sValue == "0556" then '인도네시아
	      return "인도네시아"
     elseif sValue == "0728" then '호주
	      return "호주"
     elseif sValue == "0713" then '싱가포르
	      return "싱가포르"
	'20240321 HWG START : 스위스 거래소 오프라인 주문 대응
	elseif sValue == "XSWX" then ' 스위스
		 return "스위스증권거래소"
	'20240321 HWG END     
	elseif sValue == "0000" then
		if szType == "01" or szType == "02" then '미국 OTC, 홍콩 OTC
			return "OTC"
		end if
'20201218 SWJ END
	end if
end Function
