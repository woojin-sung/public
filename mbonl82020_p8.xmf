	<SCRIPT_INFO _len="2669" _ulen="2175" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 대출만기연장신청(예탁)
' 02. 화면설명 : 대출만기연장신청(예탁)_유의사항안내
' 03. 작    성 : 2016.09.12 양현정
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData 

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("유의사항")
	g_sRetData = "cancel"
	
	Container0.Label0.caption = 	"·업무처리 가능시간\n"&
								"    - 평일 08:00~17:00\n"&
								"      (지점 업무 마감 후에는 불가)\n\n"&
								"·만기연장 신청 가능 조건\n"& 
								"    - 만기연장 신청 시, 해당 종목이 신용공여\n"&
								"      불가 종목인 경우 연장처리 불가합니다.\n"&
								"    - 담보부족 및 이자미납계좌일 경우 연장\n"&
								"      처리 불가합니다.\n"&
								"    - 만기 10영업일 전부터 만기일까지 90일\n"& 
								"      단위로 연장신청 가능합니다.\n"&  
								"      (A,B군:요건 충족 시 횟수제한 없음,\n"&  
								"       C군 및 기타담보 :요건 충족 시 90일 단위\n"&
								"                총기간 360일까지 연장가능)\n"& 
								"    - 이자율은 현재기준 이자율로 연장일부터\n"&
								"      적용되며, 현재기준 이자율은 만기연장\n"&
								"      종목 선택하시면 하단 변경이자율에서 확\n"&
								"      인 가능합니다."
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl82020_p8" , g_sRetData)
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.SendReturnToParent("mbonl82020_p8" , g_sRetData)
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
