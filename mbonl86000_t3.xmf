'============================================================================
' 01. 화 면 명 : OTP관리_사고등록
' 02. 화면설명 : OTP관리_사고등록
' 03. 작    성 : 2016. 02. 01. 유창재
' 04. 수    정 : 2017.07.26 김유경 : 온라인OTP 사고해지 추가 v0001
'			                     : 사고등록시 타이머 추가(개선)
'              : 2017.12.05 김유경 : 금결원상태 기준 OTP사고등록 버튼 활성/비활성 v0002
'							   : 당사OTP상태(obcsb_oimf_390r)->금결원OTP상태(obcsb_oimf_230r)로 변경
'							   : 당사사고없는 경우 obcsb_oimf_501a 사고회복처리
'		      : 2019.11.07 김유경 : obaci_accd_007u -> obcsb_oimf_504a 타이머 기능을 통해 1초 텀 추가. v0003
' 2020.09.23 : 정민영 : v0004 : [T2008250015] 메모리취약점 보완
' 2020.11.19 : 정민영 : v0005 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_oimf_390r,501a IO 변경분 반영
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szList		 '계좌번호, 비밀번호
Dim g_szPW		 '암호화 PW
Dim g_szSRNO		 'OTP 전문일련번호

Dim g_AcctYN 		 '사고등록해지여부 Y:등록 N:해지 v0001
Dim strOthrRcvrYn  'v0001
dim strOtpStatClcd 'v0001
Dim g_nTryCnt  	 '사고내역조회요청횟수 v0001
Dim strYN		 'v0002

Dim strRcno 	 
Dim strCurDate 
Dim strCurTime 
Dim strTlmsCode

Dim g_plain_rm  	'v0004 메모리평문적용여부
		
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetRegist() : 사고등록
'============================================================================
Function SetRegist()

	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_503a", "InBlock1", "ACNO" , 0 , g_szList(0))
	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_503a", "InBlock1", "ACNT_PWD" , 0 , g_szPW)
	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_503a", "InBlock1", "APRV_YN" , 0 , "N")
	DATAMANAGER.RequestTranData( "obcsb_oimf_503a")

End Function
'============================================================================
' SetCancel() : 사고해지 v0001
'============================================================================
Function SetCancel()

	'v0002 당사사고없으면 사고회복처리TR Call
	If strYN = "N" Then
		strRcno 	   = Form.GetSharedData("&JUMIN_NUM", false) '실명확인번호  v0005 메모리취약점보완이후 암호화된실명번호로 내려옴
		strCurDate  = Form.GetSharedData("&HOST_DATE", false) '현재일자
		strCurTime  = Form.GetSharedData("&HOST_TIME", false) '현재시간
		strTlmsCode = "0200200305"		'사고회복 전문코드
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_501a", "InBlock1", "APRV_YN" , 0 , "N"	)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_501a", "InBlock1", "OTP_TLMS_CLSF_CODE" , 0 , strTlmsCode	)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_501a", "InBlock1", "RCNO_PIP" 		    , 0 , strRcno		)  'v0005 RCNO->RCNO_PIP
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_501a", "InBlock1", "ACDN_RVOK_DATE" 	, 0 , strCurDate	)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_501a", "InBlock1", "ACDN_RVOK_TIME" 	, 0 , strCurTime	)
		DATAMANAGER.RequestTranData( "obcsb_oimf_501a")	
		
	Else 
		DATAMANAGER.SetDataValue( 0 , "obaci_accd_007u", "InBlock1", "CONT_CLS_CODE" , 0 , "4"		   )
		DATAMANAGER.SetDataValue( 0 , "obaci_accd_007u", "InBlock1", "ACNO" 		    , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obaci_accd_007u", "InBlock1", "ACNT_PWD" 	    , 0 , g_szPW	   )
	
		DATAMANAGER.SetDataValue( 0 , "obaci_accd_007u", "InBlock2", "ACNO" 		    , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obaci_accd_007u", "InBlock2", "ACDN_REG_DATE" , 0 , Grid0.GetCellData( "bd_cell0" , 0))
		DATAMANAGER.SetDataValue( 0 , "obaci_accd_007u", "InBlock2", "ACDN_REG_SRNO" , 0 , Grid0.GetCellData( "bd_cell1" , 0))
		DATAMANAGER.SetDataValue( 0 , "obaci_accd_007u", "InBlock2", "ACDN_TYPE_CODE" , 0 , "07"	   )
		DATAMANAGER.SetDataValue( 0 , "obaci_accd_007u", "InBlock2", "ACDN_REG_TRGT_CLS_CODE" , 0 , "1")
		DATAMANAGER.RequestTranData( "obaci_accd_007u")	
		Form.SetTimerEvent("11", 1, 1) '1초 타이머 실행 'v0003
		
	End If
	


End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	Container0.edt1.enable = True
	Container0.btn0.enable = False	
	g_nTryCnt = 0

	'v0004 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
 
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "사고등록" then
		g_szList = Split(sParam , "★")
		
		if UBOUND(g_szList) < 1 then
			Exit Sub
		End if
	    'g_szPW = Form.GetEncData( g_szList(1) ) v0001 주석처리
	end if	
	
	'v0001 sta
	if g_szList(1) <> "" then
		'v0004
		if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
		    g_szPW = g_szList(1)
		else  'MTS메모리평문 미적용상태일때-부모(mbonl86000)에서 미암호화된정보로 넘어오므로 암호화 필요
			g_szPW = Form.GetEncData( g_szList(1) )
		end if
	else
		g_szPW = ""
	end if
	
	Container0.edt2.caption = ""
	
	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_390r", "InBlock1", "ACNO" , 0 , g_szList(0) ) 
	DATAMANAGER.RequestTranData("obcsb_oimf_390r") 'OTP카드발급내역조회
	'v0001 fin
	
	Form.SetSharedData( "CERT_ACNO" , g_szList(0)) 'v0001	
	
End Sub
'============================================================================
' btn0_OnClick()
'============================================================================
Sub Container0_btn0_OnClick()

	if g_szPW == "" or g_szPW == Null then
		Form.ShowAlert( "알림", "비밀번호를 입력하세요")
		Exit Sub
	end if
	'SetRegist()							'Test용
	
	
	'v0001 sta
	If g_AcctYN == "Y" Then '사고등록
		'Form.MsgBox("알림", "OTP 사고해지는 지점내방 하셔야 합니다. 사고등록하시겠습니까?", "OTPYesorNo", 1)
		Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)			'공인인증서 암호 입력
	Else					 '사고해지
		'strOthrRcvrYn = "0" ' 임시 TEST
		If strOtpStatClcd == "120" and strOthrRcvrYn = "0" Then 
			'추가인증
			Form.OpenFramePopup("mhetc90060_p8" , "otp_acci" , "")		
			'Call SetCancel()  'Test
		Else
			Form.MsgBox("알림", "처리불가합니다.(온라인 사고해지는 타 금융기관의 사고해지 이력이 있는 경우 가능합니다.)", "", 0)
			Exit Sub
		End If
		
	End If	
	'v0001 fin	
End Sub
'============================================================================
' Form_OnMsgBoxClose(sKeyName, sRet)
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	
	if sKeyName == "OTPYesorNo" then		
		if sRet == "ok" then			'사고등록 확인 절차
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)			'공인인증서 암호 입력
		end if
	end if
	
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "mhetc90060_p5" then
		if sRet ~= "cancel" then				'공인인증서 암호입력 성공시
			'v0001 sta
			If g_AcctYN == "Y" Then '사고등록
				SetRegist()
			Else					 '사고해지
				SetCancel()
			End If
		end if
	end if
	
	'v0001 sta
	if sKeyName == "mhetc90060_p8" then	'추가인증
		if sRet == "ok" then	'추가인증 성공		
			'공인인증서
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)			'공인인증서 암호 입력		
		end if
	end if	
	'v0001 fin	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim ResCode, ResCodeName			'매크로 처리를 위한 OTP응답 코드, 응답 메세지
	
	if szTranID == "obcsb_oimf_503a" then
		
'		ResCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_503a", "OutBlock1", "OTP_RSPN_CODE" , 0)
'		ResCodeName = Form.GetMetaData("OTP응답코드", ResCode)
'		edt3.caption = ResCodeName
		
		g_szSRNO = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_503a", "OutBlock1", "OTP_TLMS_SRNO" , 0)
		if Len(Trim(g_szSRNO)) > 7 then			'전문일련번호 8자리
			edt0.caption = g_szSRNO
		end if
		
		If Len( Trim( Container0.edt2.caption) ) > 0 then
			Exit Sub
		else
			DATAMANAGER.RequestTranData( "obcsb_oimf_503a_1")
		end if
	elseif szTranID == "obcsb_oimf_503a_1" then
		if DATAMANAGER.GetDataMsgCode( "obcsb_oimf_503a_1") == "2515" then
			Form.ShowAlert( "알림" , "사고등록이 완료되었습니다.")
		end if
		ResCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_503a_1", "OutBlock1", "OTP_RSPN_CODE" , 0)
		ResCodeName = Form.GetMetaData("OTP응답코드", ResCode)
		Container0.edt3.caption = ResCodeName
	'v0001 sta
	elseif szTranID == "obcsb_oimf_390r" then 'OTP 발급내역 조회
				
		strOtpStatCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_390r", "OutBlock1", "OTP_STAT_CODE" , 0)
		'Container0.edt5.caption = Form.GetMetaData("OTP상태코드", strOtpStatCode)
		
		'v0002 주석처리 sta
'		If strOtpStatCode = "02" Then
'			Container0.btn0.caption = "OTP사고해지"
'			Container0.edt1.enable = False
'			g_AcctYN = "N"
'		
'			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_230r", "InBlock1", "APRV_YN" , 0 , "N" ) 
'			DATAMANAGER.RequestTranData("obcsb_oimf_230r") 'OTP기기상세조회
		
'			DATAMANAGER.SetDataValue( 0 , "obaci_accd_008r", "InBlock1", "ACNO" , 0 , g_szList(0) 	)
'			DATAMANAGER.SetDataValue( 0 , "obaci_accd_008r", "InBlock1", "PROS_CLS_CODE" , 0 , "9" ) 
'			DATAMANAGER.RequestTranData("obaci_accd_008r") '사고내역조회
'			Container0.edt5.caption = "OTP사고등록"
'		Else
'			Container0.btn0.caption = "OTP사고등록"
'			g_AcctYN = "Y"
'			Container0.edt1.enable = True
'			Container0.btn0.enable = True
'			Container0.edt6.caption = ""
'			Container0.edt5.caption = "OTP사고미등록"
'		End If
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_230r", "InBlock1", "APRV_YN" , 0 , "N" ) 
		DATAMANAGER.RequestTranData("obcsb_oimf_230r") 'OTP기기상세조회
		'v0002 주석처리 fin
		
	elseif szTranID == "obcsb_oimf_230r" then 'OTP기기상세조회
		If Len( Trim( Container0.edt2.caption) ) > 0 then
			Exit Sub
		else
			DATAMANAGER.RequestTranData( "obcsb_oimf_230r_1")
		end if		
	elseif szTranID == "obcsb_oimf_230r_1" then 'OTP기기상세조회2
		Container0.btn0.enable = True
		'타 기관 사고 회복 여부 (1:사고회복기관없음 0:사고회복기관있음)
		strOthrRcvrYn = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_230r_1", "OutBlock1", "OTHR_ISTU_ACDN_RCVR_YN" , 0)		
		'OTP 상태 구분 코드 (120 사고신고)
		strOtpStatClcd = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_230r_1", "OutBlock1", "OTP_STAT_CLS_CODE" , 0)		
		g_nTryCnt = 0
		
		'v0002 당사OTP상태->금결원OTP 상태 기준으로 변경
		If strOtpStatClcd = "120" Then
			Container0.btn0.caption = "OTP사고해지"
			Container0.edt1.enable = False
			g_AcctYN = "N"
			DATAMANAGER.SetDataValue( 0 , "obaci_accd_008r", "InBlock1", "ACNO" , 0 , g_szList(0) 	)
			DATAMANAGER.SetDataValue( 0 , "obaci_accd_008r", "InBlock1", "PROS_CLS_CODE" , 0 , "9" ) 
			DATAMANAGER.RequestTranData("obaci_accd_008r") '사고내역조회
			Container0.edt5.caption = "OTP사고등록"		
		Else
			Container0.btn0.caption = "OTP사고등록"
			g_AcctYN = "Y"
			Container0.edt1.enable = True
			Container0.btn0.enable = True
			Container0.edt6.caption = ""
			Container0.edt5.caption = "OTP사고미등록"
		End If
		'v0002
		
	elseif szTranId == "obaci_accd_007u" Then
		
		tmpOtpTlmsSrno = DATAMANAGER.GetDataValue( 0 , "obaci_accd_007u", "OutBlock1", "OTP_TLMS_SRNO" , 0)				
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_504a", "InBlock1", "ACNO" 				    , 0 , g_szList(0) 					   )
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_504a", "InBlock1", "ACDN_REG_DATE" 		    , 0 , Grid0.GetCellData( "bd_cell0" , 0)) 
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_504a", "InBlock1", "ACDN_REG_SRNO" 		    , 0 , Grid0.GetCellData( "bd_cell1" , 0))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_504a", "InBlock1", "ACDN_TYPE_CODE" 	    , 0 , "07" 						   ) 
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_504a", "InBlock1", "ACDN_REG_TRGT_CLS_CODE" , 0 , "1" 						   ) 
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_504a", "InBlock1", "OTP_TLMS_SRNO" 		    , 0 , tmpOtpTlmsSrno				   ) 

		Container0.edt2.caption = ""
		Container0.edt3.caption = ""
		
		'DATAMANAGER.RequestTranData("obcsb_oimf_504a") '사고내역조회 'v0003
		Form.SetTimerEvent("11", 1, 1) 
	elseif szTranId == "obcsb_oimf_504a" Then
		
		tmpCode = DATAMANAGER.GetDataMsgCode( "obcsb_oimf_504a")
		if tmpCode == "8194" then
			
			Form.ShowAlert( "알림" , "사고해지가 완료되었습니다.")
		end if
		
		g_szSRNO = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_504a", "OutBlock1", "OTP_TLMS_SRNO" , 0)
		if Len(Trim(g_szSRNO)) > 7 then			'전문일련번호 8자리
			edt10.caption = g_szSRNO
		end if
		
		If Len( Trim( Container0.edt2.caption) ) > 0 then
			Exit Sub
		else
			DATAMANAGER.RequestTranData( "obcsb_oimf_504a_1")
		end if
	elseif szTranID == "obcsb_oimf_504a_1" then
		if DATAMANAGER.GetDataMsgCode( "obcsb_oimf_504a_1") == "8194" then
			Form.ShowAlert( "알림" , "사고해지가 완료되었습니다.")
		end if
		ResCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_504a_1", "OutBlock1", "OTP_RSPN_CODE" , 0)
		ResCodeName = Form.GetMetaData("OTP응답코드", ResCode)
		Container0.edt3.caption = ResCodeName		
	'v0001 fin
	'v0002 당사사고없으면 사고회복처리TR Call
	elseif szTranID == "obaci_accd_008r" then
		strYN = ""
		iDataCount = DATAMANAGER.GetDataCount( 0, "obaci_accd_008r", "OutBlock1" )
		If  iDataCount < 1 Then
			strYN = "N"
		End If	
	elseif szTranID == "obcsb_oimf_501a" then
		
		g_szSRNO = ""
		g_szSRNO = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_501a", "OutBlock1", "OTP_TLMS_SRNO" , 0)
		g_szStndDate = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_501a", "OutBlock1", "STND_DATE" 	  , 0)
		
		if Len(Trim(g_szSRNO)) > 7 then			'전문일련번호 8자리
			edt11.caption = g_szSRNO
			edt12.caption = g_szStndDate
		end if
		
		If Len( Trim( Container0.edt2.caption) ) > 0 then
			Exit Sub
		else
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_501a_1", "InBlock1", "OTP_TLMS_CLSF_CODE" , 0 , strTlmsCode	)
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_501a_1", "InBlock1", "RCNO_PIP" 		  , 0 , strRcno		)  'v0005 RCNO->RCNO_PIP
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_501a_1", "InBlock1", "ACDN_RVOK_DATE" 	  , 0 , strCurDate	)
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_501a_1", "InBlock1", "ACDN_RVOK_TIME" 	  , 0 , strCurTime	)
			
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_501a_1", "InBlock1", "STND_DATE" 	  	  , 0 , g_szStndDate	)
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_501a_1", "InBlock1", "OTP_TLMS_SRNO" 	  , 0 , g_szSRNO	)
			
			DATAMANAGER.RequestTranData( "obcsb_oimf_501a_1")
		end if
	elseif szTranID == "obcsb_oimf_501a_1" then
		
		ResCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_501a_1", "OutBlock1", "OTP_RSPN_CODE" , 0)
		
		If ResCode = "0000" Then 
			Form.ShowAlert( "알림" , "사고해지가 완료되었습니다.")
		End If
		
		ResCodeName = Form.GetMetaData("OTP응답코드", ResCode)
		Container0.edt3.caption = ResCodeName	
	'v0002
	End if
	
End Sub
