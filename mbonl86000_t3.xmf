Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_oimf_503a_1" then
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_503a_1", "InBlock1", "ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_503a_1", "InBlock1", "ACNT_PWD" , 0 , g_szPW)
	end if	
End Sub

