Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obcsb_oimf_503a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_503a" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	elseif szTranID == "obcsb_oimf_503a_1" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_503a_1" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	'v0001 sta
	elseif szTranID == "obcsb_oimf_390r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_390r" )  'v0004 TR오류수정
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	elseif szTranID == "obcsb_oimf_230r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_230r" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	elseif szTranID == "obcsb_oimf_230r_1" then
		if szErrCode == "3021" Then
			DATAMANAGER.RequestTranData( "obcsb_oimf_230r_1")
		Else 
			szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_230r_1" )
			Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")		
		End If
	elseif szTranID == "obaci_accd_007u" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obaci_accd_007u" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	elseif szTranID == "obaci_accd_008r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obaci_accd_008r" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	elseif szTranID == "obcsb_oimf_504a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_504a" )
		'Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")	 'v0003. 처리내역 없을 경우 재처리 요청중 이므로 응답코드없으면 재처리.	
	elseif szTranID == "obcsb_oimf_504a_1" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_504a_1" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	'v0001 fin
	'v0002
	elseif szTranID == "obcsb_oimf_501a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_501a" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")		
	elseif szTranID == "obcsb_oimf_501a_1" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_501a_1" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	end if
	
End Sub
'============================================================================
'타이머 추가 v0001
Sub Form_OnTimerEvent(sTimerID) 'v0001

	if sTimerID == 0 or sTimerID == "0" then
		Form.SetTimerEvent(0, 0, 1)
		
		g_nTryCnt = g_nTryCnt+1
		if g_nTryCnt > 30 then		
			Form.ShowAlert( "알림", "사고내역 조회에 실패하였습니다. 다시 시도하여 주시기 바랍니다.")
			Exit Sub
		end if
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_230r_1", "InBlock1", "ACNO" , 0 , g_szList(0) ) 
		DATAMANAGER.RequestTranData("obcsb_oimf_230r_1") 'OTP기기상세조회	
	'v0003. obaci_accd_007u call 1초 뒤 obcsb_oimf_504a call
	Elseif sTimerID == 11 or sTimerID == "11" Then
	
		Form.SetTimerEvent("11", 0, 1) '타이머 정지
		g_nTryCnt = 0
		g_nTryCnt = g_nTryCnt+1
		if g_nTryCnt > 0 then		
			DATAMANAGER.RequestTranData("obcsb_oimf_504a") '사고내역조회
		end if
	end if
End Sub 
