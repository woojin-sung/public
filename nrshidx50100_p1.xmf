	if szTextSize = "2" then
		Pannel0.SetCardWHAt(nIdx,80)
	elseif szTextSize = "-2" then
		Pannel0.SetCardWHAt(nIdx,50)
	else
		Pannel0.SetCardWHAt(nIdx,60)
	end if
	
	nIdx = Pannel0.AddRow()
	Pannel0.setPropCardCell("paddinginfo" ,"lblGuide",nIdx,"0,1,0,0")
	Pannel0.setPropCardCell("fgcolor" ,"lblGuide",nIdx,g_szTxtColor_Grey)
	Pannel0.setPropCardCell("caption" ,"lblGuide",nIdx,"·")
	
	szText = "또한 제3자 데이터 제공업체에서 자료를 제공하므로 수신이 지연되거나 일부 정보가 정확하지 않을 수 있습니다."
	Pannel0.setPropCardCell("paddinginfo" ,"lblInfo",nIdx,"0,0,0,0")
	Pannel0.setPropCardCell("fgcolor" ,"lblInfo",nIdx,g_szTxtColor_Grey)
	Pannel0.setPropCardCell("fontbold" ,"lblInfo",nIdx,"0")
	Pannel0.setPropCardCell("fontsize" ,"lblInfo",nIdx,"-2")
	Pannel0.setPropCardCell("caption" ,"lblInfo",nIdx,szText)
	Pannel0.SetCellValue("lblInfo",nIdx,szText)
	
	Pannel0.setPropCardCell("maintainratio" ,"imgGuide0",nIdx, "1")
	Pannel0.setPropCardCell("imgpath" ,"imgGuide0",nIdx, "alpha")
	
	Pannel0.setPropCardCell("bgcolor" ,"lblDiv",nIdx,g_szLineColor_Grey)
	Pannel0.setPropCardCell("left" ,"lblDiv",nIdx, "500")
	if szTextSize = "2" then
		Pannel0.SetCardWHAt(nIdx,80)
	elseif szTextSize = "-2" then
		Pannel0.SetCardWHAt(nIdx,50)
	else
		Pannel0.SetCardWHAt(nIdx,60)
	end if
	
	nIdx = Pannel0.AddRow()
	Pannel0.setPropCardCell("paddinginfo" ,"lblGuide",nIdx,"0,1,0,0")
	Pannel0.setPropCardCell("fgcolor" ,"lblGuide",nIdx,g_szTxtColor_Grey)
	Pannel0.setPropCardCell("caption" ,"lblGuide",nIdx,"·")
	
	szText = "ETF는 예금자보호법에 따라 보호되지 않습니다."
	Pannel0.setPropCardCell("paddinginfo" ,"lblInfo",nIdx,"0,0,0,0")
	Pannel0.setPropCardCell("fgcolor" ,"lblInfo",nIdx,g_szTxtColor_Grey)
	Pannel0.setPropCardCell("fontbold" ,"lblInfo",nIdx,"0")
	Pannel0.setPropCardCell("fontsize" ,"lblInfo",nIdx,"-2")
	Pannel0.setPropCardCell("caption" ,"lblInfo",nIdx,szText)
	Pannel0.SetCellValue("lblInfo",nIdx,szText)
	
	Pannel0.setPropCardCell("maintainratio" ,"imgGuide0",nIdx, "1")
	Pannel0.setPropCardCell("imgpath" ,"imgGuide0",nIdx, "alpha")
	
	Pannel0.setPropCardCell("bgcolor" ,"lblDiv",nIdx,g_szLineColor_Grey)
	Pannel0.setPropCardCell("left" ,"lblDiv",nIdx, "500")
	if szTextSize = "2" then
		Pannel0.SetCardWHAt(nIdx,50)
	elseif szTextSize = "-2" then
		Pannel0.SetCardWHAt(nIdx,35)
	else
		Pannel0.SetCardWHAt(nIdx,45)
	end if
End Function

