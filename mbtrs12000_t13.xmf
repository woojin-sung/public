'============================================================================
' Init_AfterOrder : 주문후 초기화
'============================================================================
Function	Init_InputControl()
	edtQty.caption = ""
	edtQty_OnEditComplete()

	if g_bCntrtRtn == false then
		g_szQty = ""
'		edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")	

		edtOrgNo.caption = ""	
		edtOrgNo_OnEditComplete()
		edtPrc.caption = ""
		edtPrc_OnEditComplete()
	end if
End Function

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	' 환경설정값 정의
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력

	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if

	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170919 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170919 HAMWG END

	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
End Function

'============================================================================
' Visible_Control : nGbn(유형)
'============================================================================
Function Visible_Control(nGbn)
	if g_szMk == "W" then		' 20160325 ELW는 제외 적용
		edtPrc.enable = true
		btnPrc.enable = true
		btnPPlus.enable = true
		btnPMinus.enable = true
		
	else
		
		' 보통, 조건부지정가, 보통(IOC), 보통(FOK), 시간외단일가
		Select case nGbn
			case 0, 2, 5, 8, 13
				edtPrc.enable = true
				btnPrc.enable = true
				btnPPlus.enable = true
				btnPMinus.enable = true	
			case else
				edtPrc.caption = ""
				edtPrc_OnEditComplete()
				
				edtPrc.enable = false	
				btnPrc.enable = false
				btnPPlus.enable = false
				btnPMinus.enable = false
		End Select
	end if
End Function

'============================================================================
' Set_OrdType : 종목코드에 따라 주문유형 설정
' 20160329 : "market"이 같고 "ineermarket"이 다른 상태의 예외처리 추가(코넥스 때문)
'============================================================================
Function Set_OrdType()
	Dim szMk, szInner
	szMk, szInner = "", ""
	
	'===20230710 htw start 종목코드 수정 코드 변경
	'TOBE
	szResult = g_szCd
'	'신주인수권(증서)/수익증권/ETN
	if (Left(g_szCd, 1) == "J" and len(g_szCd) == 9) or Left(g_szCd, 1) == "F" or left(g_szCd, 1) == "Q" then
		g_szCd = g_szCd
	'주식/KOTC/ELW
	else
		if Left(g_szCd, 1, 1) == "A" or Left(g_szCd, 1, 1) == "J" then
			g_szCd = Trim(Mid(g_szCd,2,Len(g_szCd)))
		end if
	end if
	
	'ASIS
'	if Len(g_szCd) == 7 then'앞에 A,J처럼 붙은 것 제거
'		'20230707 htw start Q(ETN)인 경우에는 자르지 않게 수정
'		szFirst = left(g_szCd,1)
'		if szFirst <> "Q" and szFirst <> "q" then
'			g_szCd = right(g_szCd,6)
'		end if
'		'20230707 htw end Q(ETN)인 경우에는 자르지 않게 수정
'	end if
	'===20230710 htw end 종목코드 수정 코드 변경
	
	szMk = Form.GetItemCodeInfo(g_szCd, "market")
	szInner = Form.GetItemCodeInfo(g_szCd, "innermarket")
	
	'20170816 LES START
	
	szType = Form.GetSharedData("M_TYPE", false)		' 주문구분
	cmbType.currentindex = szType
	
	'20170816 LES END	
	if g_szMk <> szMk then
		cmbType.currentindex = "0"					' 0으로 변경해야 die안됨
		Form.SetCtlProp("cmbGroup", "clear", "")		' 콤보 리스트 클리어
	
		if szMk == "W" then
			chkMarketPrice.visible = false
			szList = Set_TypeList(0)
			'Form.SetCtlProp("#rdoGbn", "visible", false)
		else
			if szMk == "T" then
				chkMarketPrice.visible = false
			else
				chkMarketPrice.visible = true
			end if
			if Trim(szInner) =="033" then		' 코넥스
				szList = Set_TypeList(1)
			else
				szList = Set_TypeList(2)
			end if
			'Form.SetCtlProp("#rdoGbn", "visible", true)
		end if
		
		g_szMk = szMk
	else
		if szMk == "W" then
			szList = Set_TypeList(0)
			'20230615 htw start K-OTC,ELW인 경우 시장가 enable 연동 추가
			chkMarketPrice.enable = false
		else
			if g_szInner <> szInner then
				if Trim(szInner) =="033" then		' 코넥스
					szList = Set_TypeList(1)
				else
					szList = Set_TypeList(2)
				end if
				
				g_szInner = szInner
			end if
		end if
	end if

	cmbType.cbinputdatatext = szList
End Function

'============================================================================
' Set_TypeList : "market" or "ineermarket"에 따른 주문유형 변경 (20160329 추가)
'============================================================================
Function Set_TypeList(nGbn)
	
	szScrNo = Form.GetSharedData("&SCREEN_NO", false)
	
	if nGbn == 0 then
		return "00`보통(지정가)\r\n01`보통(IOC)\r\n02`보통(FOK)"
	elseif nGbn == 1 then
		return "00`보통(지정가)\r\n01`시장가\r\n02`장후시간외"
	else
		
		'20200416 LES START 대여주문 관련수정(대여주문 시간외단일가/장후시간외 주문타입 삭제 - 양현정 과장 요청)
		if szScrNo = "12060" then
			return "00`보통(지정가)\r\n01`시장가\r\n02`조건부지정가\r\n03`최유리지정가\r\n04`최우선지정가\r\n05`보통(IOC)\r\n06`시장가(IOC)\r\n07`최유리(IOC)\r\n08`보통(FOK)\r\n09`시장가(FOK)\r\n10`최유리(FOK)\r\n11`장전시간외"'\r\n12`장후시간외\r\n13`시간외단일가"
		else
			return "00`보통(지정가)\r\n01`시장가\r\n02`조건부지정가\r\n03`최유리지정가\r\n04`최우선지정가\r\n05`보통(IOC)\r\n06`시장가(IOC)\r\n07`최유리(IOC)\r\n08`보통(FOK)\r\n09`시장가(FOK)\r\n10`최유리(FOK)\r\n11`장전시간외\r\n12`장후시간외\r\n13`시간외단일가"
		end if
		
	end if
End Function

'============================================================================
' Check_OrdType : 주문유형확인
'============================================================================
Function Check_OrdType()
	Dim szIdx
	szIdx = CStr(cmbType.currentindex)
	
	if g_bBtnMkClk == true Then					'시장가 주문
		return "05"	
	elseIf g_szInner == "033" then				' 코넥스 
		Select Case szIdx
			Case "0"	'지정
				return "01"
			Case "1"	'시장
				return "05"
			Case "2"	'장후
				return "71"
		End Select
	elseIf g_szMk == "W" then					'ELW인경우 -  보통
		return "01"
	else '일반주문
		Select Case szIdx
			Case "0", "5", "8"	' 지정(일반, IOC, FOK)
				return "01"
			Case "1", "6", "9"	' 시장(일반, IOC, FOK)
				return "05"
			Case "2"				' 조건부
				return "06"
			Case "3", "7", "10"	' 최유리(일반, IOC, FOK)
				return "12"
			Case "4"				' 최우선
				return "13"   
			Case "11"			' 장전
				return "61"
			Case "12"			' 장후
				return "71"
			Case "13" 
				return "81" 		' 시간외단일가
		End Select 			
    End If
End Function

'============================================================================
' Return_OrdType
'============================================================================
Function Return_OrdType(szOdrType, szClsCd)
	Dim szIdx
	
	If g_szInner == "033" then				' 코넥스 
		Select Case szOdrType
			Case "01"	'지정
				szIdx = "0"
			Case "05"	'시장
				szIdx = "1"
			Case "71"	'장후
				szIdx = "2"
		End Select
	elseIf g_szMk == "W" then					'ELW인경우 -  보통
		szIdx = "0"
	else '일반주문
		szIdx = cmbType.currentindex

		Select Case szOdrType
			Case "01"		' 지정(일반, IOC, FOK)
				if szClsCd == "1" then
					szIdx = "5"
				elseif szClsCd == "2" then
					szIdx = "8"
				else
					szIdx = "0"
				end if
			Case "05"		' 시장(일반, IOC, FOK)
				if szClsCd == "1" then
					szIdx = "6"
				elseif szClsCd == "2" then
					szIdx = "9"
				else
					szIdx = "1"
				end if
			Case "06"		' 조건부
				szIdx = "2"
			Case "12"		' 최유리(일반, IOC, FOK)
				if szClsCd == "1" then
					szIdx = "7"
				elseif szClsCd == "2" then
					szIdx = "10"
				else
					szIdx = "3"
				end if			
			Case "13"		' 최우선
				szIdx = "4"
			Case "61"		' 장전
				szIdx = "11"
			Case "71"		' 장후
				szIdx = "12"
			Case "81"		' 시간외단일가
				 szIdx = "13"
		End Select 			
    End If
    cmbType.currentindex = szIdx
End Function

'============================================================================
' Check_CondCode : 주문조건 구분 확인
'============================================================================
Function Check_CondCode()
	Dim szIdx
	
	if g_bBtnMkClk == true Then					'시장가 주문
		return "0"
	elseIf g_szInner == "5" then				' 코넥스 
		return "0"		
	elseIf g_szMk == "W" then					'ELW인경우 -  보통
		'20230714 htw start 주문 유형에 따른 분기 추가
		szIdx = cmbType.currentindex
		if szIdx == "0" then
			return "0"
		elseif szIdx == "1" then
			return "3"
		elseif szIdx == "2" then
			return "4"
		end if
		'20230714 htw end 주문 유형에 따른 분기 추가
	else '일반주문
		szIdx = cmbType.currentindex

		Select Case szIdx
			Case "5", "6", "7"	' IOC
				return "3"
			Case "8", "9", "10"	' FOK
				return "4"
			Case Else
				return "0" 	
		End Select 			
    End If
End Function

'============================================================================
' Change_ItemCode
'============================================================================
Function Change_ItemCode()
	Dim szMk
	
	szMk = Form.GetItemCodeInfo(g_szCd, "market")

	if Left(g_szCd, 1) = "J" or Left(g_szCd, 1) = "F" then
		return g_szCd
	elseif szMk = "J" or szMk = "T" then	'주식
		return "A" & g_szCd
	elseif szMk = "W" then	'ELW
		return "J" & g_szCd
	else
		return g_szCd
	end if 
End Function

'============================================================================
' Check_InputData
'============================================================================
Function Check_InputData(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Check_Account(nGbn) == false then
		return false
	end if

	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if

	
	if Trim(Grid0.GetCellData("bd_cell15", g_szTRIdx)) == "" then
		Form.ShowAlert(g_szTitle, "원주문번호를 입력하십시요.")
		return false
	end if
	
	if chkAll.checkstate == "0" then		' 일부잔량 선택시
		if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
			Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
			return false
		end if
	end if
	
	if nGbn == 0 and g_OrderGubn == "0" then	'정정일때만 체크
		szType = Check_OrdType()
		
		if szType == "01" or szType = "06" or szType = "81" then	' 지정, 조건부, 시간외단일가
			if Trim(edtPrc.caption) == "" or Trim(edtPrc.caption) == "0" then
				Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
				return false
			end if	
		end if
	end if	
		
'	if g_nGridClickedIdx > -1 then
'	
'	end if
		
	if nGbn <> 2 then	
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup()
		else
			Request_Order()
		end if
	end if
	
	return true
End Function

'============================================================================
' Open_ConfirmPopup
'============================================================================
Function Open_ConfirmPopup(szWarn)
	
	Dim szData
	
	'20230720 htw start 경고창일 경우 정정=2로 변경
	if Trim(szWarn) <> "" then
		szData = "2"
	else
		szData = Grid0.GetCellData( "bd_TypeCd", g_nGridClickedIdx)
	end if
	'20230720 htw end 경고창일 경우 정정=2로 변경
	
	szData = szData & "|" & g_szMk											' 시장구분
	szData = szData & "|" & Form.GetCtlProp("#acnt", "caption")					' 계좌번호
	szData = szData & "|" & Form.GetCtlProp("#acnt", "accountname")				' 계좌명
	szData = szData & "|" & g_szCd											' 종목코드
	szData = szData & "|" & Form.GetItemCodeInfo(g_szCd, "name")				' 종목명
'	if g_OrderGubn == "0" then'정정
		szData = szData & "|" & cmbType.caption									' 주문구분
'	else'취소
'		szData = szData & "|" & ""												' 주문구분
'	end if

	szData = szData & "|" & Grid0.GetCellData("bd_cell2", g_nGridClickedIdx)		' 현금/신용	7
	szData = szData & "|" & Grid0.GetCellData("bd_cell20", g_nGridClickedIdx)	' 신용구분
	szData = szData & "|" & Grid0.GetCellData("bd_cell7", g_nGridClickedIdx)		' 대출일자('있다면 YYMMDD형태 없으면 공란)
	szData = szData & "|" & edtQty.caption									' 주문수량
	
	if g_OrderGubn == "0" then'정정
		szData = szData & "|" & edtPrc.caption									' 주문가격
	else'취소
		szData = szData & "|" & Grid0.GetCellData("bd_cell3", g_nGridClickedIdx)		' 주문가격
	end if
	
	szData = szData & "|" & Grid0.GetCellData("bd_cell15", g_nGridClickedIdx)		' 주문번호
	szData = szData & "|" & chkAll.checkstate								' 전량전부	13
	
	'취소 확인팝업에 신용구분 case 구분=	INPUT_ODER_KIND_CODE 값이 신용or 대출 케이스일 때만
	'취소 확인팝업에 합산 case 구분 = LOAN_DATE("bd_cell7") 값이 없으면 합산O, 있으면 합산X
	'유통융자/자기융자/예탁주식(대출) case 구분 = LOAN_DTL_TYPE_CODE 
	
	'INPUT_ODER_KIND_CODE 값("bd_cell10")=========
	'대용=03 23  93 94
	'대여=91
	'대출=04 05 24 25
	'신용=11 13 15 17
	'대주=12 14 16 18
	'차입=10 30
	'권리= 92
	'나머지=현금
	'================================
	'LOAN_DTL_TYPE_CODE 값("bd_cell21")==========
	'자기융자=0101
	'유통융자=0102
	'예탁주식(대출)=0201
	'================================

	if Trim(szWarn) <> "" then
		szData = szData & "|" & szWarn								' 경고메세지
		Form.OpenPopupAnimation("mbtrs12020_p18", szData , "","2")		' 경고팝업 오픈
	else
		'20230720 htw start 경고창을 제외한 팝업에서만 사용함으로 if-else 안으로 옮김
		Dim szINPUT_ODER_KIND_CODE, szLOAN_DTL_TYPE_CODE
		szINPUT_ODER_KIND_CODE	= Grid0.GetCellData("bd_cell10", g_nGridClickedIdx)
		szLOAN_DTL_TYPE_CODE	= Grid0.GetCellData("bd_cell21", g_nGridClickedIdx)
		
		Select Case szINPUT_ODER_KIND_CODE										'14
			Case "04", "05", "24", "25"'대출
				szData = szData & "|" & "대출"
			Case "11", "13", "15", "17"'신용
				szData = szData & "|" & "신용"
			Case else
				szData = szData & "|" & ""
		End Select
	
		Select Case szLOAN_DTL_TYPE_CODE										'15
			Case "0101"
				szData = szData & "|" & "자기융자"
			Case "0102"
				szData = szData & "|" & "유통융자"
			Case "0201"
				szData = szData & "|" & "예탁주식(대출)"
			Case else
				szData = szData & "|" & ""
		end Select
		'20230720 htw end 경고창을 제외한 팝업에서만 사용함으로 if-else 안으로 옮김
		if g_OrderGubn == "0" then'정정
			Form.OpenPopupAnimation("mbtrs12020_p16", szData , "","2")		' 주문확인팝업 오픈
		elseif g_OrderGubn == "1" then'취소
			Form.OpenPopupAnimation("mbtrs12020_p17", szData , "","2")		' 주문확인팝업 오픈
		end if
	end if
End Function

'============================================================================
' Request_Order
'============================================================================
Function Request_Order()
	g_szWarnFlag = "N"
	
	DATAMANAGER.RequestTranData("obtrs_oder_101a")
End Function

'============================================================================
' Check_Account
'============================================================================
Function Check_Account(nGbn)
	Dim szAcnt, szPwd
	
	szAcnt = Form.GetCtlProp("#acnt", "caption")
	
	If Len(szAcnt) < 10 Then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
		return False
	End If
	
	if nGbn <> 2 then
		szPwd = Form.GetCtlProp("#edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function

'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn)
	Dim szPrc, szUnit, szHigh, szLow, szHyun
	
	szPrc  = edtPrc.caption
	szUnit = Form.GetCtlProp("#lblUnit", "caption")
	szHigh = Form.GetCtlProp("#lblHigh", "caption")	
	szLow  = Form.GetCtlProp("#lblLow", "caption")
	szHyun = Form.GetCtlProp("#lblHyun", "caption")
	
	'=======================================================================
	'20221116 HWG START : (거래소 차세대) 호가단위 개선
	'=======================================================================
	'20231122 HSZ START:  (거래소 차세대) ETF,ETN 호가단위 개선
	'=======================================================================
	' ETN
	'=======================================================================
	if g_szMk == "Q" then
		if CDbl(szPrc) < 2000 then
			szUnit = 1
		elseif CDbl(szPrc) >= 2000 then
			szUnit = 5
		end if
	'=======================================================================
	' ELW
	'=======================================================================	
	elseif  g_szMk == "W" then
		szUnit = 5
		
	'=======================================================================
	' ETN/ELW 외
	'=======================================================================
	else
		szInnerMk = Form.GetItemCodeInfo(g_szCd, "innermarket")
		
		'=======================================================================
		' ETF
		'=======================================================================
		if szInnerMk = "013" then
			if CDbl(szPrc) < 2000 then
				szUnit = 1
			elseif CDbl(szPrc) >= 2000 then
				szUnit = 5
			end if
	'20231122 HSZ END
		
		'=======================================================================
		' KOTC
		'=======================================================================
'		elseif szInnerMk = "025" then
'			if CDbl(szPrc) < 1000 then
'				szUnit = 1
'			elseif (CDbl(szPrc) >= 1000 and CDbl(szPrc) < 5000) then
'				szUnit = 5 
'			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 10000) then
'				szUnit = 10
'			elseif (CDbl(szPrc) >= 10000 and CDbl(szPrc) < 50000) then
'				szUnit = 50
'			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 100000) then
'				szUnit = 100
'			elseif (CDbl(szPrc) >= 100000 and CDbl(szPrc)<  500000) then
'				szUnit = 500
'			elseif CDbl(szPrc) >= 500000 then
'				szUnit = 1000
'			end if
'			
'			if nGbn == 1 then
'				if CDbl(szPrc) = 1000 then
'					szUnit = 1
'				elseif CDbl(szPrc) = 5000 then
'					szUnit = 5 
'				elseif CDbl(szPrc) = 20000 then
'					szUnit = 10
'				elseif CDbl(szPrc) = 10000 then
'					szUnit = 50
'				elseif CDbl(szPrc) = 50000 then
'					szUnit = 100
'				elseif CDbl(szPrc) = 100000 then
'					szUnit = 500
'				elseif CDbl(szPrc) = 500000 then
'					szUnit = 1000
'				end if
'			end if
		
		'=======================================================================
		' KOSPI/KOSDAQ/KONEX/신주인수권/수익증권 등
		'=======================================================================
		else
			if CDbl(szPrc) < 2000 then
				szUnit = 1
			elseif (CDbl(szPrc) >= 2000 and CDbl(szPrc) < 5000) then
				szUnit = 5 
			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 20000) then
				szUnit = 10
			elseif (CDbl(szPrc) >= 20000 and CDbl(szPrc) < 50000) then
				szUnit = 50
			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 200000) then
				szUnit = 100
			elseif (CDbl(szPrc) >= 200000 and CDbl(szPrc) < 500000) then
				szUnit = 500
			elseif CDbl(szPrc) >= 500000 then
				szUnit = 1000
			end if
			
			if nGbn == 1 then
				if CDbl(szPrc) = 2000 then
					szUnit = 1
				elseif CDbl(szPrc) = 5000 then
					szUnit = 5 
				elseif CDbl(szPrc) = 20000 then
					szUnit = 10
				elseif CDbl(szPrc) = 50000 then
					szUnit = 50
				elseif CDbl(szPrc) = 200000 then
					szUnit = 100
				elseif CDbl(szPrc) = 500000 then
					szUnit = 500
				end if
			end if
		end if
	end if
	'20221116 HWG END
	
	'이전소스
'	'=======================================================================
'	' 20190403 LES START 호가단위 설정
'	'=======================================================================
'	if g_szMk == "J" or g_szMk == "T" then
'			
'		szInnerMk = Form.GetItemCodeInfo(g_szCd, "innermarket")
'			
'		'-------------------------------------------------------------------
'		'코스닥, 코넥스
'		'-------------------------------------------------------------------
'		if szInnerMk == "002" or szInnerMk == "033" then
'			if CDbl(szPrc) < 1000 then
'				szUnit = 1
'			elseif (CDbl(szPrc) >= 1000 and CDbl(szPrc) < 5000) then
'				szUnit = 5 
'			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 10000) then
'				szUnit = 10
'			elseif (CDbl(szPrc) >= 10000 and CDbl(szPrc) < 50000) then
'				szUnit = 50
'			elseif CDbl(szPrc) >= 50000 then
'				szUnit = 100
'			end if
'				
'		'-------------------------------------------------------------------
'		'ETF
'		'-------------------------------------------------------------------
'		elseif szInnerMk = "013" then
'			szUnit = 5
'						
'		'-------------------------------------------------------------------
'		'코스피, 신주인수권, 수익증권, K-OTC
'		'-------------------------------------------------------------------
'		else
'					
'			if CDbl(szPrc) < 1000 then
'				szUnit = 1
'			elseif (CDbl(szPrc) >= 1000 and CDbl(szPrc) < 5000) then
'				szUnit = 5 
'			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 10000) then
'				szUnit = 10
'			elseif (CDbl(szPrc) >= 10000 and CDbl(szPrc) < 50000) then
'				szUnit = 50
'			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 100000) then
'				szUnit = 100
'			elseif (CDbl(szPrc) >= 100000 and CDbl(szPrc) < 500000) then
'				szUnit = 500
'			elseif CDbl(szPrc) >= 500000 then
'				szUnit = 1000
'			end if
'					
'		end if
'		
'	'-------------------------------------------------------------------
'	'ETN, ELW
'	'-------------------------------------------------------------------
'	elseif g_szMk == "Q" or g_szMk == "W" then
'		szUnit = 5
'					
'	end if
'	'20190318 LES END
	
	
	
	'=======================================================================
	' +,- 버튼 클릭시 동작 
	'=======================================================================		
	
	'----------------------------------------------------------------------
	' ELW
	'----------------------------------------------------------------------
	if g_szMk = "W" then
		if Trim(szUnit) == "" then
			szUnit = "5"
		end if

		if Trim(szPrc) == "" then
			szPrc = szHyun
		else
			' + 버튼 클릭 /////////////////////////////
			if nGbn == 0 then							
				szPrc = CDbl(szPrc) + CDbl(szUnit)
			' - 버튼 클릭 ////////////////////////////	
			elseif nGbn == 1 then					
				if CDbl(szPrc) == 0 then		' 0상태에서 "-"선택시 현재가로 복귀
					szPrc = szHyun
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if
			end if
		end if
	
	
	' ----------------------------------------------------------------------
	' 그외 (코스피, 코스닥, KOTC, ETF, ETN ..)
	' ----------------------------------------------------------------------		
	else
		if Trim(szUnit) == "" then
			szUnit = "1"
		end if
		
		if Trim(szPrc) == "" then
			szPrc = szHyun
		else
			' + 버튼 클릭 /////////////////////////////
			if nGbn == 0 then
			
			'20210216 SWJ START : 신주인수권 가격 +/- 버튼 입력오류 수정(상한가, 하한가 항상 0이어서 생긴 오류)
				if Left(g_szCd,1) == "J" then
					szPrc = CDbl(szPrc) + CDbl(szUnit)
					
					if szPrc <= 0 then
						szPrc = szHyun
					end if
				else
					'20230622 htw start 0일 때 현재가로 복귀 추가
					if CDbl(szPrc) == 0 then
						szPrc = szHyun
					elseif CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
						szPrc = szHigh
					elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀	
						szPrc = szLow
					else
						szPrc = CDbl(szPrc) + CDbl(szUnit)
					end if
				end if
				
			' - 버튼 클릭 ////////////////////////////
			elseif nGbn == 1 then
			
				if Left(g_szCd,1) == "J" then
					
					szPrc = CDbl(szPrc) - CDbl(szUnit)
					
					if szPrc <= 0 then
						szPrc = szHyun
					end if
				else
					if CDbl(szPrc) == 0 then
						szPrc = szHyun
					'20230622 htw end 0일 때 현재가로 복귀 추가
					elseif CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
						szPrc = szHigh		
					elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
						szPrc = szLow
					else
						szPrc = CDbl(szPrc) - CDbl(szUnit)
					end if
				end if
			'20210216 SWJ END	
			end if
		end if
	end if
	
	edtPrc.caption = szPrc
	edtPrc_OnEditComplete()
End Function

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption

	
	if Trim(szQty) == "" then
		szQty = 1
	else
		'20230718 htw start 수량 변경 단위 1로 고정
'		if Len(szQty) = 1 or Len(szQty) = 2 then
'			nUnit = 1
'		else
'			nCnt = Len(szQty)-1
'			
'			For i = 0 to nCnt-1
'				if i == 0 then
'					szUnit = "1"
'				else
'					szUnit = szUnit & "0"
'				end if
'			Next
'			
'			nUnit = CDbl(szUnit)
'		end if
		nUnit = 1
		'20230718 htw end 수량 변경 단위 1로 고정
		if nGbn == 0 then
			szQty = CDbl(szQty) + nUnit
		elseif nGbn == 1 then
			if CDbl(szQty) == 0 then
				Exit Function
			else
				szQty = CDbl(szQty) - nUnit
			end if
		end if
	end if
	
	edtQty.caption = szQty
	edtQty_OnEditComplete()
End Function

'============================================================================
' Return_ContractScreen : 미체결팝업에서 리턴된 값 적용
'============================================================================
Function Return_ContractScreen(szRet)
	tData = Split(szRet, "♥")
	
	if UBound(tData) > 0 then
	'tData = 주문번호/미체결수량/주문유형/주문가격/주문조건/구분자/종목코드
		' 메인화면에서 종목변경에 따른 구분자를 넣어준것
		if tData(5) == "1" then
			g_bCntrtRtn = true
		else
			g_bCntrtRtn = false
		end if	
	
		if g_szAfterOrg == "1" then			' 주문번호 연동
			Form.SetCtlProp("#edtOrgNo", "caption", tData(0))
		end if
		
		'정정 취소 통합으로 하나의 shared로
		g_szQty = ""
		Form.SetSharedData("M_QTY", "")
		Form.SetSharedData("M_QCK", chkAll.checkstate)
		
		' 수량
'		if chkAll.checkstate == "1" then
'			edtQty.caption = ""						
'			g_szQty = tData(1)
'			Form.SetSharedData("M_QTY", g_szQty)
'		else
'			edtQty.caption = tData(1)
'			g_szQty = tData(1)
'			edtQty_OnEditComplete()
'		end if
		'정정 취소 통합으로 하나의 shared로
		
		Set_OrdType()		' 종목코드에 따라 주문유형 설정
		
		' 주문유형 선택
		Return_OrdType(tData(2), tData(4))
		
'		if tData(2) == "01" or tData(2) == "06" or tData(2) == "81" then	' 지정, 조건부, 시간외
'			' 주문가격
'			edtPrc.caption = tData(3)
'			edtPrc_OnEditComplete()
'		end if
'		
'		edtOrgNo.caption = tData(0)						' 주문번호
'		edtOrgNo_OnEditComplete()	
		szData = tData(6) &"★"& tData(0) &"★" & tData(3) & "★" & tData(1)
		g_tGetData = Split(szData,"★")'종목코드★주문번호★호가★미체결수량
				
		g_szGbnCode = "0"	' 매매구분코드(0:전체, 1:매도, 2:매수)
		FormTab0.currenttab = 0
		Grid0.rowcount = 0
		DATAMANAGER.RequestTranData("obtrs_cntg_638r")
	end if
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit() 
	Grid0.height = 366

	'20230707 htw start 큰글씨일 때 체크 텍스트 잘림으로 인한 텍스트 크기 감소
	szTextSize = Form.GetEnvData("common.textsize")
	szDeviceOS = Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	
	if CInt(szTextSize) > 0 and szDeviceOS == "2" then '큰글씨 + IOS 이면
		chkMarketPrice.fontsize = - 3 - CInt(szTextSize)
	end if
	'20230707 htw end 큰글씨일 때 체크 텍스트 잘림으로 인한 텍스트 크기 감소

	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 6) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상

	FormTab0.insertPage( FormTab0.tabcount, "page1", "page1", "empty", "0", "전체")
	FormTab0.insertPage( FormTab0.tabcount, "page2", "page2", "empty", "0", "매수")
	FormTab0.insertPage( FormTab0.tabcount, "page3", "page3", "empty", "0", "매도")

	FormTab0.currenttab = 0
	
	Load_OrderSet() '주문설정값 읽어오기   
	
'	chkAll_OnChange("1")
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'20230712 htw start 종목명 멀티라인 설정
	Grid0.SetCellMaxLineCount("bd_cell9", 2)
	'20230712 htw end 종목명 멀티라인 설정
	
	'20200910 SWJ END
	g_szGbnCode = "0"	' 매매구분코드(0:전체, 1:매도, 2:매수)
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
'MsgBox(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 메인화면의 호가 클릭시
	' ----------------------------------------------------------------------		
	if sEventName == "12000_HOGA" then
		if sParam <> "" then
			'주문유형에 따른 주문단가
			szType = Check_OrdType()
			
			if szType == "01" or szType == "06" or szType == "81" then		'지정, 조건부, 시간외 주문
				edtPrc.caption = sParam
				edtPrc_OnEditComplete()
			end if	
		else
			edtPrc.caption = sParam
			edtPrc_OnEditComplete()
		end if
	' ----------------------------------------------------------------------
	' 메인화면에서 종목코드 받기
	' ----------------------------------------------------------------------			
	elseif sEventName == "INIT_CODE" then	' 20160316
		'20230725 htw start 정정취소탭에서 환경설정 클릭 후, 환경설정에서 <로 나올 경우 init_code를 타서 오류 발생하여 방지용
		if Trim(g_szCd) <> "" then
			'20230721 htw start AOS와 IOS간의 시점 차이로 인한 종목코드가 달라 동작이 달랐음. 이를 보완하기 위해 코드 추가
			Dim szTempCd
			szTempCd = g_szCd
			if (Left(g_szCd, 1) == "J" and len(g_szCd) == 9) or Left(g_szCd, 1) == "F" or left(g_szCd, 1) == "Q" then
				szTempCd = g_szCd
			'주식/KOTC/ELW
			else
				if Left(g_szCd, 1, 1) == "A" or Left(g_szCd, 1, 1) == "J" then
					szTempCd = Trim(Mid(g_szCd,2,Len(g_szCd)))
				end if
			end if
			'20230721 htw end AOS와 IOS간의 시점 차이로 인한 종목코드가 달라 동작이 달랐음. 이를 보완하기 위해 코드 추가
			
			if szTempCd == sParam then
				'그리드에서 선택해서 종목이 변경 된 경우는 이쪽을 탄다
				if g_szChangeInit == "1" then
					Form.SetCtlProp("#edtOrgNo", "caption", "")
				else
					edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
				end if
				
				g_bCntrtRtn = false
			else
				'종목검색기로 종목을 변경한 경우 이쪽을 탄다
			
				'20230714 htw start 그리드 선택 상태에서 화면 최상단 종목변경(메인) 시 기존 선택한 리스트 선택 해제
				'20230718 htw start if문 g_nGridClickedIdxdp CInt() 추가
	'			if CInt(g_nGridClickedIdx) > -1 then
				'20230718 htw end if문 g_nGridClickedIdxdp CInt() 추가
					'20230719 htw start IOS 그리드 리스트 체크 상태 적용을 위한 변수 추가
	'				szOsType = Form.GetSharedData("&OS_TYPE", false )
	'				if szOsType == "2" then'IOS
	'					if g_nAlreadyClickIdx > -1 then'유지
	'						g_nAlreadyClickIdx = -1
	'					else'초기화
	'						Grid0.SetCellData("bd_cell0", g_nGridClickedIdx, "0")
	'						Grid0.selectrow = -1
	'						g_nGridClickedIdx = -1
	'					end if
	'				elseif szOsType == "1" then'AOS
						Grid0.SetCellData("bd_cell0", g_nGridClickedIdx, "0")
						Grid0.selectrow = -1
						g_nGridClickedIdx = -1
						chkAllCancel.checkstate = "0"
						btnAllCancel.visible = false
						Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")
						Grid0.height = 366
	'				end if
	'				if g_nAlreadyClickIdx > -1 then'유지
	'					g_nAlreadyClickIdx = -1
	'				else'초기화
	'					Grid0.SetCellData("bd_cell0", g_nGridClickedIdx, "0")
	'					Grid0.selectrow = -1
	'					g_nGridClickedIdx = -1
	'				end if
					'20230719 htw end IOS 그리드 리스트 체크 상태 적용을 위한 변수 추가
	'			end if
				'20230714 htw end 그리드 선택 상태에서 화면 최상단 종목변경(메인) 시 기존 선택한 리스트 선택 해제
				
	'			edtPrc.caption = ""
	'			edtQty.caption = ""
			
				if g_bCntrtRtn == false then
					Form.SetCtlProp("#edtOrgNo", "caption", "")
					edtOrgNo.caption = ""
				else
					if g_szChangeInit == "1" then
						Form.SetCtlProp("#edtOrgNo", "caption", "")
					else
						Form.SetCtlProp("#edtOrgNo", "caption", edtOrgNo.caption)
					end if
				end if
				
			'===================================================================================
			' 20170726 LES START - 주문 데이터연동 오류 수정 (탭 변경시 주문유형 연동오류 수정)
			'===================================================================================
			
				if g_szCd <> sParam then
					g_szCd = sParam
					Set_OrdType()		' 종목코드에 따라 주문유형 설정
				
				end if
			
			'===================================================================================
			' 20170726 LES END - 주문 데이터연동 오류 수정 (탭 변경시 주문유형 연동오류 수정)
			'===================================================================================
			
				if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
					Init_InputControl()
				end if	
			end if
			
			
			'20180716 LES START
			Position_Control()
		end if
		'20230725 htw end 정정취소탭에서 환경설정 클릭 후, 환경설정에서 <로 나올 경우 init_code를 타서 오류 발생하여 방지용
	' ----------------------------------------------------------------------
	' 메인화면에서 탭 체인지
	' ----------------------------------------------------------------------			
	elseif sEventName == "CHNAGE_TAB" then
'		edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
		
		'230525 htw 컨트롤 visible초기화 start
		btnAllCancel.visible = false
		chkAllCancel.checkstate = "0"
		'230525 htw 컨트롤 visible초기화 end
		
		'===================================================================================
		' 20170726 LES START - 주문 데이터연동 오류 수정 (탭 변경시 주문유형 연동오류 수정)
		'===================================================================================
		
		if g_szCd <> sParam then
			g_szCd = sParam
			Set_OrdType()		' 종목코드에 따라 주문유형 설정
		
		end if
		
		'===================================================================================
		' 20170726 LES END - 주문 데이터연동 오류 수정 (탭 변경시 주문유형 연동오류 수정)
		'===================================================================================
		
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if	
		
		'20170816 LES START - 주문유형콤보세팅 여기다가???
		szType = Form.GetSharedData("M_TYPE", false)		' 주문구분
		cmbType.currentindex = szType					' 주문구분 콤보박스 세팅
		'20170816 LES END
		
		
		'20180716 LES START
		Position_Control()
		Grid0.height = 366
		chkAllCancel.checkstate = "0"
		btnAllCancel.visible = false
		'20230705 htw start 탭변경시 전체/매수/매도 탭 유지
'		g_szGbnCode = "0"	' 매매구분코드(0:전체, 1:매도, 2:매수)
'		FormTab0.currenttab = 0
		'20230705 htw end 탭변경시 전체/매수/매도 탭 유지
		Grid0.rowcount = 0
		DATAMANAGER.RequestTranData("obtrs_cntg_638r")
		
	' ----------------------------------------------------------------------
	' 주문번호 연동
	' ----------------------------------------------------------------------			
	elseif sEventName == "AFTER_ORGNO" then		
		if g_szAfterOrg == "1" then			' 주문번호 연동
			edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
			edtOrgNo_OnEditComplete()
		end if
	' ----------------------------------------------------------------------
	' 미체결팝업에서 리턴된 값 적용하기
	' ----------------------------------------------------------------------			
	elseif sEventName == "12000_CONTRACT_RETURN" then		
		if sParam == "" then
			Exit Sub
		end if
		
'		g_bCntrtRtn = true
		Return_ContractScreen(sParam)	
	' ----------------------------------------------------------------------
	' 자동가격입력
	' ----------------------------------------------------------------------		
	elseif sEventName == "AUTO_PRICE" then
		'20230724 htw start 그리드 선택시에만 단가 변경
		if g_bCntrtRtn == false and g_nAlreadyClickIdx <> -1 and g_bClickHeaderItem == false then
			if Trim(sParam) <> "" then		
				'230601 htw start 시간외- 타 주문유형 간 주문가격 자동입력 방지 케이스 추가
		
				Dim szInner, szCmb
				szInner = Form.GetItemCodeInfo(g_szCd, "innermarket")
				szCmb = cmbType.cbkeydata
				
				if g_szMk <> "W" then
					if Trim(szInner) =="033" then		' 코넥스
						if szCmb =="01" or szCmb == "02" then '시장가, 시간외종가
							return false
						end if
					else
						Select Case szCmb
							Case "01", "03", "04", "06", "07", "09", "10", "11", "12" 		' 시장/최유리/최우선지정가 등
								return false
						end select
					end if
				end if
				'230601 htw end 시간외- 타 주문유형 간 주문가격 자동입력 방지 케이스 추가
				
			'20230724 htw start 초기화 사용 시 주문한 단가, 초기화 미사용 시  단가 자동입력 값 삽입
				'20230626 htw start 환경설정 조건(g_szChangeInit) 추가
				if g_szChangeInit == "1" then
					'종목/탭 변경시 단가/수량 초기화 O
					edtPrc.caption = g_szOdrPrc
				else
					edtPrc.caption = sParam
				end if	
				'20230626 htw end 환경설정 조건(g_szChangeInit) 추가
			else
				edtPrc.caption = g_szOdrPrc
			end if
			edtPrc_OnEditComplete()				
			g_bClickHeaderItem = true
			'20230724 htw end 초기화 사용 시 주문한 단가, 초기화 미사용 시  단가 자동입력 값 삽입
		else
			g_bCntrtRtn = false
		end if
		'20230724 htw end 그리드 선택시에만 단가 변경
	' ----------------------------------------------------------------------
	' 가로에서 받은 조건
	' ----------------------------------------------------------------------		
	elseif sEventName == "CHANGE_DATA" then
		szType = Form.GetSharedData("M_TYPE", false)		' 주문구분
		cmbType.currentindex = szType
		
		szPrc = Form.GetSharedData("M_PRC", false)		' 가격
		edtPrc.caption = szPrc
		edtPrc_OnEditComplete()
		
		szOrg = Form.GetSharedData("M_ORG", false)		' 원주문번호
		
		edtOrgNo.caption = szOrg
		edtOrgNo_OnEditComplete()
		
		szQck = Form.GetSharedData("M_QCK", false)		' 잔량여부
		chkAll.checkstate = szQck
		
		szQty = Form.GetSharedData("M_QTY", false)		' 수량
		g_szQty = szQty
		
		if szQck == "0" then
			edtQty.caption = szQty
'			edtQty.enable = true
'			btnQty.enable = true
		else
			edtQty.caption = ""
'			edtQty.enable = false
'			btnQty.enable = false
		end if
	elseif sEventName == "ACNT_CHANGE" then'계좌변경
		edtPrc.caption = ""
		edtQty.caption = ""
		f_Reset()
		DATAMANAGER.RequestTranData("obtrs_cntg_638r")
		
	elseif sEventName == "SEND_MOD" then'주문/체결 탭에서 미체결 주문 클릭 시
		if sParam <> "" then
			g_tGetData = Split(sParam,"★")'종목코드★주문번호★호가★미체결수량
			
			g_szGbnCode = "0"	' 매매구분코드(0:전체, 1:매도, 2:매수)
			FormTab0.currenttab = 0
			Grid0.rowcount = 0
			DATAMANAGER.RequestTranData("obtrs_cntg_638r")
		end if
	elseif sEventName == "SEND_ALL_CANCEL" then'주문/체결 탭에서 미체결 전체취소하기
		g_tAllCancelData = "ALL_CANCEL"
		'20230724 htw start 환경설정에 설정한 단가 get하는 트리거 추가
	elseif sEventName == "MOD_SEND_SETTING_HOGA" then'환경설정에 설정한 단가 get
		if sParam <> "" then
			edtPrc.caption = sParam
			g_szOdrPrc = CInt(sParam)
		else
			edtPrc.caption = g_szOdrPrc
		end if
		'20230724 htw end 환경설정에 설정한 단가 get하는 트리거 추가
	end if
End Sub

Sub f_Reset()
	Grid0.rowcount = 0
	Form.triggerEvent("#", "MOD_CAN_RESET", "")
end Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	' ----------------------------------------------------------------------
	' 수량입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		g_szQty = sRet
		edtQty_OnEditComplete()
	' ----------------------------------------------------------------------
	' 가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then		
		edtPrc.caption = sRet		
		edtPrc_OnEditComplete()
	elseif sKeyName == "mbtrs12000_pl" then		'키패드

		'20230601 htw start 유형에 따른 단가 입력 케이스 추가
		if sRet <> "" then
			Dim tData, szQty
			tData = Split(sRet,"★")'가격★수량★시장가 선택여부(1,0)
			szQty = Grid0.GetCellData("bd_cell13", g_nGridClickedIdx)
			
			if chkAll.checkstate == "1" then
				if CInt(szQty) <> CInt(tData(1)) then
					chkAll.checkstate = "0"
					chkAll_OnChange("0")
					edtQty.caption = tData(1)
				end if
			else
				edtQty.caption = tData(1)
			end if
			
			if tData(2) == "1" then '시장가 선택
				chkMarketPrice.checkstate = "1"
				chkMarketPrice_OnChange("1")
			else
				'===
				Dim szType
				szType = Trim(tData(5))
'				g_szPrc .."★".. edtQty.caption.."★0".."★"..g_szMk.."★"..g_szInner.."★"..g_szType
				if tData(3) <> "W" then
					if Trim(tData(4)) == "033" then		' 코넥스
						if szType == "02" then	'시간외종가
						else
							edtPrc.caption = tData(0)
						end if
					else
						Select Case szType
							Case "01", "03", "04", "06", "07", "09", "10", "11", "12" 		' 시장/최유리/최우선지정가
							Case Else
								edtPrc.caption = tData(0)
						end Select
					end if
				else
					edtPrc.caption = tData(0)
				end if
				'===
'				edtPrc.caption = tData(0)
			end if
		end if
		'20230601 htw end 유형에 따른 단가 입력 케이스 추가
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCd, szType, szPrc, szCLS, szCLSCd, szAll, szQty
	
	' 종목코드
	szCd = Change_ItemCode()
		
	'주문유형
	szType = Check_OrdType()

	' 주문조건 구분코드
	szCondCd = Check_CondCode()
	
	'주문유형에 따른 주문단가
	Select Case szType
		Case "05", "12", "13", "61", "71"					'시장가,최유리,최우선 주문
			szPrc = "0"
		Case Else
			szPrc = edtPrc.caption
	End Select

	if g_OrderGubn == "0" then	'정정
		' 정정
		szCLSCd = "103"
	else
		' 취소
		szCLSCd = "104"
	end if

	' 잔량전부 여부
	if chkAll.checkstate == "1" then
		szAll = "Y"
		szQty = Grid0.GetCellData("bd_cell13", g_szTRIdx)'미체결 수량
	else
		szAll = "N"
		szQty = edtQty.caption
	end if

	' ----------------------------------------------------------------------
	' 주식 정정/취소주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtrs_oder_101a" then
		g_szTR = szTranID
		DATAMANAGER.ClearInputData(0, "obtrs_oder_101a")
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acnt", "sequence"))	' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "caption"))	' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "encdata"))	' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ISCD"				, 0, Grid0.GetCellData("bd_Cd", g_szTRIdx))' 종목코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODQT"				, 0, edtQty.caption)						' 주문수량
		
		'==================================
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ORGL_ODER_NO"		, 0, Grid0.GetCellData("bd_cell15", g_szTRIdx))' 원주문번호
		'==================================
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "WHOL_RCTF_CNCL_YN"	, 0, szAll)								' 전체 정정 취소여부
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag)						' 경고확인여부
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "SVC_CLS_CODE"		, 0, szCLSCd)								' 서비스 구분 코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "PGM_ASPR_DCLR_CLS_CODE", 0, "0")								' 프로그램호가신고구분코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01")								' 주문발생유형코드(01:일반주문)
		
		if g_OrderGubn == "0" then	'정정
			DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODER_UNPR"			, 0, szPrc)								' 주문단가
			DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODER_CLS_CODE"		, 0, szType)								' 주문구분코드
			DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, szCondCd)							' 주문조건구분코드
		else'취소
			'확인해야하는 data ODER_COND_CLS_CODE
			DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, Grid0.GetCellData("bd_cell18", g_szTRIdx))							' 주문조건구분코드
			if g_OrderGubn == "2" then	'일괄 취소
				DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "WHOL_RCTF_CNCL_YN"	, 0, "Y")							' 전체 정정 취소여부
				DATAMANAGER.SetDataValue(0, "obtrs_oder_101a", "InBlock1", "ODQT"				, 0, Grid0.GetCellData("bd_cell13", g_szTRIdx))						' 주문수량
			end if
		end if
	'20230719 htw start 매수/매도여도 전체건수 표시 요청
	elseif szTranID == "obtrs_cntg_638r" or szTranID == "obtrs_cntg_638r_1" then
		Dim szDate
		szDate = Form.GetSharedData("&BIZ_DT", false)
		DATAMANAGER.ClearInputData(0, szTranID)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"			, 0 , Form.GetCtlProp("#acnt", "total") )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"			, 0 , Form.GetCtlProp("#acnt", "sequence") )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ODER_DATE"		, 0 , szDate )
		if szTranID == "obtrs_cntg_638r_1" then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DEAL_CLS_CODE"	, 0 , "0")			' 매매구분코드(0:전체, 1:매도, 2:매수)
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DEAL_CLS_CODE"	, 0 , g_szGbnCode)			' 매매구분코드(0:전체, 1:매도, 2:매수)
		end if
		'20230719 htw end 매수/매도여도 전체건수 표시 요청
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNTG_CLS_CODE"	, 0 , "2")			' 체결구분코드(0:전체, 1:체결, 2:미체결)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE"	, 0 , "4" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS"		, 0 , "2" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DATA_CLS"		, 0 , "0" )
	end if
End Sub
				
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "obtrs_cntg_638r" then
		Dim szDate, nCnt
		nCnt = DATAMANAGER.GetDataCount( false, szTranID , "OutBlock1" )
		for i = 0 to nCnt - 1
			szDate = DATAMANAGER.GetDataValue( false, "obtrs_cntg_638r", "OutBlock1", "LOAN_DATE" , i )
			szDate = right(szDate,6)
			DATAMANAGER.SetDataValue( false, "obtrs_cntg_638r", "OutBlock1", "LOAN_DATE" , i , szDate )
		next
	end if
End Sub				
				
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szWarnMsg, szOrdCd, szOrdMsg
	' ----------------------------------------------------------------------
	' 주식 정정/취소주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtrs_oder_101a" then
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
		
		if szWarnCd = "1" then							' 경고
			Open_ConfirmPopup(szWarnMsg)
		elseif szWarnCd = "2" then						' 보류
			g_szTR = ""
			
			if g_OrderGubn == "2" then '일괄취소
				Dim szIdx
				szIdx = ""
				
				for i = g_szTRIdx + 1 to Grid0.rowcount - 1
					if Grid0.GetCellData("bd_cell0", i) == "1" then
						szIdx = i
						exit for
					end if
				next
				
				if szIdx <> "" then	'다음 취소할 대상을 찾으면
					g_szTRIdx = szIdx
					g_nMultiCancelOrderCnt = g_nMultiCancelOrderCnt + 1	'다건 취소 주문 갯수 증가
					'20230718 htw start 보류= 주문 완료가 아니므로 g_MultiCancelOrderNotAcceptCnt 추가
					g_MultiCancelOrderNotAcceptCnt = g_MultiCancelOrderNotAcceptCnt + 1
					'20230718 htw end 보류= 주문 완료가 아니므로 g_MultiCancelOrderNotAcceptCnt 추가
					DATAMANAGER.RequestTranData("obtrs_oder_101a")
				else	'끝이면
					'20230627 htw start 취소 문구 케이스별로 분류
					'다건일 경우 주문 완료 알럿 제공
					
					g_nMultiCancelOrderCnt = g_nMultiCancelOrderCnt + 1
					
					if g_MultiCancelOrderNotAcceptCnt == 0 then
						Form.ShowAlert("알림", "주문이 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
					elseif g_nMultiCancelOrderCnt == g_MultiCancelOrderNotAcceptCnt then'취소주문요청갯수=불가갯수
						Form.ShowAlert("알림", "취소가 불가합니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
					else
						Form.ShowAlert("알림", "주문이 일부만 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
					end if
					
					g_MultiCancelOrderNotAcceptCnt = 0'취소 주문 불가 갯수 카운트 초기화
					g_nMultiCancelOrderCnt = 0	'다건 취소 주문 갯수 초기화
					'20230627 htw end 취소 문구 케이스별로 분류
					chkAllCancel.checkstate = "0"
					btnAllCancel.visible = false
					Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")
					Grid0.height = 366
					imgRefresh_OnClick()
				end if
			end if
		else
			g_szTR = ""
			
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)

			if Trim(szOrdCd) == "0001" then
				if g_szAfterInit == "1" then		' 주문후 초기화
					Init_InputControl()
				end if
				
				if g_OrderGubn <> "2" then '일괄취소
					Form.Toast(0, szOrdMsg, true)
				end if
				
				if g_OrderGubn == "0" then	'정정
					' 20160322  정정주문에서도 주문번호 연동 추가 ////////////
					if g_szAfterOrg == "1" then			' 주문번호 연동
						szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
						
						Form.SetCtlProp("#edtOrgNo", "caption", szOrgNo)
						edtOrgNo.caption = szOrgNo
					else
						Form.SetCtlProp("#edtOrgNo", "caption", "")
					end if				
					' ////////////////////////////////////////////////////////
				end if
				
				if g_OrderGubn == "2" then '일괄취소
					Dim szIdx
					szIdx = ""
					
					for i = g_szTRIdx + 1 to Grid0.rowcount - 1
						if Grid0.GetCellData("bd_cell0", i) == "1" then
							szIdx = i
							exit for
						end if
					next
					
					if szIdx <> "" then	'다음 취소할 대상을 찾으면
						g_szTRIdx = szIdx
						g_nMultiCancelOrderCnt = g_nMultiCancelOrderCnt + 1	'다건 취소 주문 갯수 증가
						DATAMANAGER.RequestTranData("obtrs_oder_101a")
						return false
					else	'끝이면
						'20230627 htw start 취소 문구 케이스별로 분류
						'다건일 경우 주문 완료 알럿 제공
						g_nMultiCancelOrderCnt = g_nMultiCancelOrderCnt + 1
						
						if g_MultiCancelOrderNotAcceptCnt == 0 then
							Form.ShowAlert("알림", "주문이 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
						elseif g_nMultiCancelOrderCnt == g_MultiCancelOrderNotAcceptCnt then'취소주문요청갯수=불가갯수
							Form.ShowAlert("알림", "취소가 불가합니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
						else
							Form.ShowAlert("알림", "주문이 일부만 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
						end if
						
						g_MultiCancelOrderNotAcceptCnt = 0'취소 주문 불가 갯수 카운트 초기화
						g_nMultiCancelOrderCnt = 0	'다건 취소 주문 갯수 초기화
						'20230627 htw end 취소 문구 케이스별로 분류
					end if
				end if
				
				chkAllCancel.checkstate = "0"
				btnAllCancel.visible = false
				Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")
				Grid0.height = 366
				imgRefresh_OnClick()
			end if
		end If
	elseif szTranID == "obtrs_cntg_638r" then
		Dim nCnt
		nCnt = CInt(Grid0.rowcount)

		if nCnt > 0 then
			imgNodata.visible = false
			lblNodata.visible = false
		else
			Grid0.height = 366
			Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")'호가 visible처리
			imgNodata.visible = true
			lblNodata.visible = true
		end if
		if g_szGbnCode == "0" then
			FormTab0.SetTabPageCaption( "page1", "전체("..nCnt.."건)" )
		'20230719 htw start 매수/매도여도 전체건수 표시 요청
		else
			DATAMANAGER.RequestTranData( "obtrs_cntg_638r_1" )
		'20230719 htw end 매수/매도여도 전체건수 표시 요청
		end if
		
		For iCnt = Grid0.rowcount - 1 To 0 Step -1
			'매매구분
			
			'20230615 htw start 구분 data 변경
'			01현금 02대출 03신용 04대주 05대여 06대용 07재활용 99기타			
			szGbn = Grid0.GetCellData("bd_cell11",iCnt)'주식잔고구분코드
			
			Select Case szGbn
				Case "01"
					Grid0.SetCellData("bd_cell1", iCnt, "현금")
				Case "02"
					Grid0.SetCellData("bd_cell1", iCnt, "대출")	
				Case "03"
					Grid0.SetCellData("bd_cell1", iCnt, "신용")
				Case "04"
					Grid0.SetCellData("bd_cell1", iCnt, "대주")
				Case "05"
					Grid0.SetCellData("bd_cell1", iCnt, "대여")
				Case "06"
					Grid0.SetCellData("bd_cell1", iCnt, "대용")
				Case "07"
					Grid0.SetCellData("bd_cell1", iCnt, "재활용")
				Case "99"
					Grid0.SetCellData("bd_cell1", iCnt, "기타")
			end Select
			'20230615 htw end 구분 data 변경
			
			szData = Grid0.GetCellData( "bd_TypeCd", iCnt)
			szData2 = Grid0.GetCellData( "bd_EditDelType", iCnt)	'정정/취소구분(1신규,2정정, 3취소)
			szData3	= Grid0.GetCellData( "bd_cell20", iCnt)		'신용주문구분코드
			szData4	= Grid0.GetCellData( "bd_cell21", iCnt) 		'대출상세유형코드

			'===
			If szData2 = "1" Then					'정상
				Select Case szData3				'보통
					Case "10"
						If szData = "1" Then
							If szData4 = "0201" Then
								Grid0.SetCellData("bd_TypeNm", iCnt, "| 매도")
'								Grid0.SetCellData("bd_TypeNm", iCnt, "예탁담보매도")
							Else
								Grid0.SetCellData("bd_TypeNm", iCnt, "| 매도")
							End If
							Grid0.SetCellFgColor("bd_TypeNm", iCnt, "11")
						Else
							Grid0.SetCellData("bd_TypeNm", iCnt, "| 매수")
							Grid0.SetCellFgColor("bd_TypeNm", iCnt, "10")
						End If
					
					Case "21", "31"								'신용매수
'						Grid0.SetCellData("bd_TypeNm", iCnt, "신용매수")
						Grid0.SetCellData("bd_TypeNm", iCnt, "| 매수")
						Grid0.SetCellFgColor("bd_TypeNm", iCnt, "10")
					
					Case "22", "32"								'신용매도
'						Grid0.SetCellData("bd_TypeNm", iCnt, "신용매도")
						Grid0.SetCellData("bd_TypeNm", iCnt, "| 매도")
						Grid0.SetCellFgColor("bd_TypeNm", iCnt, "11")
					
					Case "23", "33"								'대주매도
'						Grid0.SetCellData("bd_TypeNm", iCnt, "대주매도")
						Grid0.SetCellData("bd_TypeNm", iCnt, "| 매도")
						Grid0.SetCellFgColor("bd_TypeNm", iCnt, "11")
	
					Case "24", "34"								'대주매수
'						Grid0.SetCellData("bd_TypeNm", iCnt, "대주매수")
						Grid0.SetCellData("bd_TypeNm", iCnt, "| 매수")
						Grid0.SetCellFgColor("bd_TypeNm", iCnt, "10")
					
				End Select
			ElseIf szData2 = "2" Then								'정정
				If szData = "1" Then
					Grid0.SetCellData("bd_TypeNm", iCnt, "| 매도정정") 
					Grid0.SetCellFgColor("bd_TypeNm", iCnt, "11")
				Else
					Grid0.SetCellData("bd_TypeNm", iCnt, "| 매수정정")
					Grid0.SetCellFgColor("bd_TypeNm", iCnt, "10")
				End If
'20230621 htw start IOS에서 기본 체크 이미지로 나오고 해당 기능 불필요
'				Grid0.SetCellEnable("bd_cell0", iCnt, "0")
			ElseIf szData2 = "3" Then								'취소
				If szData = "1" Then
					Grid0.SetCellData("bd_TypeNm", iCnt, "| 매도취소")
					Grid0.SetCellFgColor("bd_TypeNm", iCnt, "11")
				Else
					Grid0.SetCellData("bd_TypeNm", iCnt, "| 매수취소")
					Grid0.SetCellFgColor("bd_TypeNm", iCnt, "10")
					
				End If
'				Grid0.SetCellEnable("bd_cell0", iCnt, "0")
'20230621 htw end IOS에서 기본 체크 이미지로 나오고 해당 기능 불필요
			End If
			
			szData = Grid0.GetCellData( "bd_ProcCd", iCnt)
			
			Select Case szData
				Case "0" Grid0.SetCellData("bd_ProcNm", iCnt, "미접수")
				Case "1" Grid0.SetCellData("bd_ProcNm", iCnt, "접수")
				Case "2" Grid0.SetCellData("bd_ProcNm", iCnt, "확인")
				Case "3" Grid0.SetCellData("bd_ProcNm", iCnt, "거부")
				Case "4" Grid0.SetCellData("bd_ProcNm", iCnt, "PT효력정지")
			End Select
			
			Dim szRMND_CLCD, szReturnValue
			
			Select Case szData4
				Case "0000" szReturnValue = "보통"
				Case "0101" szReturnValue = "자기융자"
				Case "0102" szReturnValue = "유통융자"
				Case "0103" szReturnValue = "자기대주"
				Case "0104" szReturnValue = "유통대주"
				Case "0201" szReturnValue = "예탁주식"
				Case "0202" szReturnValue = "예탁채권"
				Case "0203" szReturnValue = "예탁집합투자"
				Case "0204" szReturnValue = "예탁장외파생"
				Case "0211" szReturnValue = "예탁유통주식"
				Case "0212" szReturnValue = "예탁유통채권"
				Case "0213" szReturnValue = "예탁유통집합투자"
				Case "0214" szReturnValue = "예탁유통장외파생"
				Case "0301" szReturnValue = "매도증권담보대출"
				Case "0302" szReturnValue = "수익증권환매"
				Case "0303" szReturnValue = "ELS환매자금대출"
				Case "0401" szReturnValue = "소액주식"
				Case "0402" szReturnValue = "소액채권"
				Case "0403" szReturnValue = "소액수익증권"
				Case "0404" szReturnValue = "소액 ELS"
				Case "0501" szReturnValue = "공모주청약"
				Case "0502" szReturnValue = "ELS청약"
				Case "0503" szReturnValue = "주식매입"
				Case "0601" szReturnValue = "매입자금대출"
				Case "0701" szReturnValue = "초단기대출"
				Case "0801" szReturnValue = "CMA담보대출"
				Case "9201" szReturnValue = "대출(대여)" 'v003
				Case "8201" szReturnValue = "양도담보" 'v004
				Case Else   szReturnValue = szData4
			End Select
			
			Grid0.SetCellData( "bd_cell17", iCnt, szReturnValue )
			'===
		next
		
		if g_tGetData <> "" and #g_tGetData > 0 then
			Dim szOrdNo, szCd, szQty, szOdrNo, szOdrType, szOdrPrc, szClsCd, szDate, szMk, szCredit, szData
			
			For lRow = 0 to Grid0.rowcount - 1
				
				szOrdNo = Grid0.GetCellData("bd_cell15", lRow)'주문번호
				if szOrdNo == g_tGetData(1) then
					Grid0.SetCellData("bd_cell0", lRow, "1")
					'20230718 htw start 선택색상 추가
					Grid0.selectrow = lRow
					'20230718 htw end 선택색상 추가
					g_nGridClickedIdx = lRow
					szCd      = Grid0.GetCellData("bd_Cd",       lRow)
					szQty     = Grid0.GetCellData("bd_cell13", lRow)
					szOdrNo   = Grid0.GetCellData("bd_cell15",    lRow)	
					szOdrType = Grid0.GetCellData("bd_cell23",  lRow)
					szOdrPrc  = Grid0.GetCellData("bd_cell3",   lRow)
					szClsCd   = Grid0.GetCellData("bd_cell18",    lRow)
					szDate    = Grid0.GetCellData("bd_cell7", lRow)
					
					szMk = Form.GetItemCodeInfo(szCd, "market")
					
					g_szCd = szCd
					
					'20211228 SWJ START : 신용대주
					szCredit    = Grid0.GetCellData("bd_cell20", lRow)
					
					if szCredit = "33" or szCredit = "34" then
						Form.ShowAlert("알림", "해당 종목은 대주주문화면에서 주문실행하시기 바랍니다.")
			'			Grid0.SetCellData("bd_cell0", lRow, 0)
			'			f_GridCheck()
						Exit Sub
					end if
					'20211228 SWJ END
					
					Dim g_Tab
					g_Tab = "2"'임시
					'20180719 LES START - KOTC시장(T) 추가
					if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then		
						' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
						szData = "미체결" & "★" & g_Tab & "★" & szCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd
						Form.triggerEvent("#", "12000_CONTRACT", szData)
					else
						szCutCd = Mid(szCd, 2, Len(szCd))
						szMk = Form.GetItemCodeInfo(szCutCd, "market")
						
						'20180719 LES START - KOTC시장(T) 추가
						if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then
							' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
							szData = "미체결" & "★" & g_Tab & "★" & szCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd
							Form.triggerEvent("#", "12000_CONTRACT", szData)
						else
							Form.ShowAlert("알림", "선택하신 상품은 MTS에서는 거래가 불가능한 상품입니다.")
			'				Grid0.SetCellData("bd_cell0", lRow, 0)
			'				f_GridCheck()
						end if
					end if
					
					if chkAll.checkstate == "1" then
						btnQty.enable = false
						btnQMinus.enable = false
						btnQPlus.enable = false
						edtQty.enable = false
						edtQty.caption = ""
					else
						btnQty.enable = true
						btnQMinus.enable = true
						btnQPlus.enable = true
						edtQty.enable = true
						edtQty.caption = Grid0.GetCellData("bd_cell13", lRow)'미체결 수량
						'20230724 htw start 주문한 단가 셋팅
						g_szOdrPrc = CInt(szOdrPrc)
						'20230724 htw start 주문한 단가 셋팅
					end if
					Set_OrdType()		' 종목코드에 따라 주문유형 설정
					Return_OrdType(szOdrType,szClsCd)
					
					'20230620 htw start 환경설정에 설정한 정정취소 주문 단가 입력으로 인한 주석처리
'					edtPrc.caption = Grid0.GetCellData("bd_cell3", lRow)'단가
					'20230620 htw end 환경설정에 설정한 정정취소 주문 단가 입력으로 인한 주석처리
					
'					Grid0.toprow = lRow
					Grid0.height = 152
					Form.SetTimerEvent2(1, 1, 0.1)
					
					Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "1")'호가 visible처리
					exit for
				end if
			next
			g_tGetData = ""
		elseif g_tAllCancelData <> "" then
			chkAllCancel.checkstate = 1
			chkAllCancel_OnChange("1")
			g_tAllCancelData = ""
		end if
	'20230719 htw start 매수/매도여도 전체건수 표시 요청
	elseif "obtrs_cntg_638r_1" == szTranID then
		nCnt = DATAMANAGER.GetDataCount( false, "obtrs_cntg_638r_1", "OutBlock1" )
		FormTab0.SetTabPageCaption( "page1", "전체("..nCnt.."건)" )
	'20230719 htw end 매수/매도여도 전체건수 표시 요청
	end if
	
	g_szWarnFlag = "N"	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg, szTranMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szTranID == "obtrs_oder_101a" then
		'20230718 htw start 일괄취소 1개를 할 경우도 있으므로 오류로 들어온 경우 무조건 갯수 증가
		if g_OrderGubn == "2" then
			g_MultiCancelOrderNotAcceptCnt = g_MultiCancelOrderNotAcceptCnt + 1'취소 주문 불가 갯수 카운트 증가
		end if
		'20230718 htw end 일괄취소 1개를 할 경우도 있으므로 오류로 들어온 경우 무조건 갯수 증가
		
		Dim szIdx
		szIdx = ""
		
		for i = g_szTRIdx + 1 to Grid0.rowcount - 1
			if Grid0.GetCellData("bd_cell0", i) == "1" then
				szIdx = i
				exit for
			end if
		next
		
		
		if szIdx <> "" then	'다음 취소할 대상을 찾으면
			g_szTRIdx = szIdx
			g_nMultiCancelOrderCnt = g_nMultiCancelOrderCnt + 1	'다건 취소 주문 갯수 증가
			'20230718 htw start 주석처리
'			g_MultiCancelOrderNotAcceptCnt = g_MultiCancelOrderNotAcceptCnt + 1'취소 주문 불가 갯수 카운트 증가
			'20230718 htw start 주석처리
			DATAMANAGER.RequestTranData("obtrs_oder_101a")
			return false
		else
			if g_OrderGubn == "0" or g_OrderGubn == "1" then
				'단건일 경우 에러는 무조건 에러알림창 제공
				if Trim(szSubMsg) <> "" then
					Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
				else
					Form.ShowAlert(g_szTitle, szErrMsg)
				end if
			else
				'20230720 htw start 
				g_nMultiCancelOrderCnt = g_nMultiCancelOrderCnt + 1
				'20230627 htw start 취소 문구 케이스별로 분류
				'다건일 경우 주문 완료 알럿 제공
				if g_MultiCancelOrderNotAcceptCnt == 0 then
					Form.ShowAlert("알림", "주문이 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
				elseif g_nMultiCancelOrderCnt == g_MultiCancelOrderNotAcceptCnt then'취소주문요청갯수=불가갯수
					Form.ShowAlert("알림", "취소가 불가합니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
				else
					Form.ShowAlert("알림", "주문이 일부만 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
				end if
				
				g_MultiCancelOrderNotAcceptCnt = 0'취소 주문 불가 갯수 카운트 초기화
				g_nMultiCancelOrderCnt = 0	'다건 취소 주문 갯수 초기화
				'20230627 htw end 취소 문구 케이스별로 분류
				chkAllCancel.checkstate = "0"
				btnAllCancel.visible = false
				Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")
				Grid0.height = 366
				imgRefresh_OnClick()
			end if
		end if
	else
		if Trim(szSubMsg) <> "" then
			Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szTitle, szErrMsg)
		end if
	end if
End Sub
'============================================================================
' cmbType_OnEditComplete
'============================================================================
Sub cmbType_OnEditComplete(iIndex)
	Form.SetSharedData("M_TYPE", cmbType.currentindex)
	Form.SetSharedData("STOCK_MODTYPE", cmbType.cbkeydata)
	Form.triggerEvent("#", "12000_MODTYPE", "")
	Visible_Control(iIndex)
	
	if iIndex == 1 then
		chkMarketPrice.chksilence = true
		edtPrc.caption = ""
	else
		chkMarketPrice.chksilence = false
	end if
	
	'htw 230525 장전시간외 최초 클릭 시 토스트 메세지 제공 start
	if iIndex == 11 then
		if g_bFirstSelectBeforeMarket == false then
			g_bFirstSelectBeforeMarket = true
'			Form.Toast(1, "장전시간외로 주문시 08:15~08:30에는 정정 및 취소가 불가하오니 유의해주세요.", 1)
			Form.triggerEvent("#", "FirstBeforeMarketClick", "")
		end if
	end if	
	'htw 230525 장전시간외 최초 클릭 시 토스트 메세지 제공 end
End Sub

