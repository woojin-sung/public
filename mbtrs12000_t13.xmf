'============================================================================
' chkAll_OnChange
'============================================================================
Sub chkAllCancel_OnChange(sCheckState)
'	Form.SetSharedData("M_QCK", sCheckState)
	if CInt(Grid0.rowcount) > 0 then
		if sCheckState == "1" then
			btnAllCancel.visible = true
			Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")
		else
			btnAllCancel.visible = false
		end if
		
		Grid0.height = 366
		for i = 0 to Grid0.rowcount - 1
			Grid0.SetCellData("bd_cell0", i, sCheckState)
		next
	else
		chkAllCancel.checkstate = "0"
		Grid0.selectrow = -1
	end if
End Sub

'============================================================================
Sub chkAll_OnChange(sCheckState)
	Form.SetSharedData("M_QCK", sCheckState)
	
	if sCheckState == "1" then
		edtQty.caption = ""	
		edtQty.enable = false
		btnQty.enable = false
		btnQPlus.enable = false
		btnQMinus.enable = false
	else
		'20230704 htw start 잔량 전부 체크 비활성화 시 수량 삽입 추가
		'20230718 htw start if문 g_nGridClickedIdxdp CInt() 추가
		if CInt(g_nGridClickedIdx) > -1 then
		'20230718 htw end if문 g_nGridClickedIdxdp CInt() 추가
			szAbleQty = Grid0.GetCellData("bd_cell13", g_nGridClickedIdx)
			edtQty.caption = szAbleQty
		else
			edtQty.caption = ""
		end if
		'20230704 htw end 잔량 전부 체크 비활성화 시 수량 삽입 추가
		edtQty.enable = true
		btnQty.enable = true
		btnQPlus.enable = true
		btnQMinus.enable = true
	end if
End Sub

'============================================================================
' btnQty_OnClick
'============================================================================
Sub btnQty_OnClick()
	'종목코드, 종목마켓, 단가, 수량, 정정취소탭 2●(매수정정 ?,매도정정 1),원주문 수량,상한가, 하한가, 주문 타입,주문 타입명,단가or수량or금액(단가=0수량=1금액=2)
	Dim szSendData, szPrc, szQty,szHigh,szLow,szCmbType,szCmbCap
	Dim szOrderQty'원주문 수량
	Dim szOrderGbn
	if edtPrc.caption <> "" then
		szPrc = edtPrc.caption
	else'현재가
		szPrc = Form.GetCtlProp("#lblHyun", "caption")
	end if
	
	if chkAll.checkstate == "1" then
		szQty = Grid0.GetCellData("bd_cell13", g_nGridClickedIdx)
	else
		if edtQty.caption <> "" then
			szQty = edtQty.caption
		else
			szQty = "0"
		end if
	end if
	
	szHigh =  Form.GetCtlProp("#lblHigh", "caption")
	szLow =  Form.GetCtlProp("#lblLow", "caption")
	szCmbType = cmbType.cbkeydata
	szCmbCap = cmbType.caption
	
	szOrderQty = Grid0.GetCellData("bd_cell13", g_nGridClickedIdx)	
	szOrderGbn = "2●"..Grid0.GetCellData( "bd_TypeCd", g_nGridClickedIdx)'1매도
	
	szSendData = g_szCd.."★".. g_szMk .."★"..szPrc.."★"..szQty.."★"..szOrderGbn.."★"..szOrderQty.."★"..szHigh.."★"..szLow.."★"..szCmbType.."★"..szCmbCap.."★".."1"
	Form.OpenPopupAnimation("mbtrs12000_pl" , szSendData, "","2")
	
'	if chkAll.checkstate == "0" then
'		Form.OpenPopup("mbtrs12000_p1", "2★" & edtQty.caption & "★" & g_szMk & "★", "")
'	end if
End Sub

