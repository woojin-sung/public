	DATAMANAGER.RequestTranData("obtrs_cntg_638r")
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	if chkAllCancel.checkstate == "1" then'전체취소 체크 상태
		Dim szCheck, bFlag
		szCheck = Grid0.GetCellData("bd_cell0", lRow)
		
		if szCellID <> "bd_cell0" then
			if szCheck == "1" then
				Grid0.SetCellData("bd_cell0", lRow, 0)
			else
				Grid0.SetCellData("bd_cell0", lRow, 1)
			end if
		end if
		
		
		bFlag = false
		for i = 0 to Grid0.rowcount - 1
			szCheck = Grid0.GetCellData("bd_cell0", i)
			
			if szCheck == "1" then
				bFlag = true
			end if
		next
		
		if bFlag == false then '모든 리스트가 체크 해제 상태
			chkAllCancel.checkstate = "0"
			chkAllCancel_OnChange("0")
		end if
		Grid0.selectrow = -1
	else'미체크 상태
		DIm szChecked
		szChecked = Grid0.GetCellData("bd_cell0", lRow)
		
		if szCellID <> "bd_cell0" then'체크 이외를 누른 경우
			if szChecked == "1" then'이미눌려서 체크 해제
				Grid0.SetCellData("bd_cell0", lRow, "0")
				szChecked = "0"
			else
				Grid0.SetCellData("bd_cell0", lRow, "1")
				szChecked = "1"
			end if
		end if
		
		if szChecked == "1" then '누름(특정 종목 조회 + 그리드 작게)
			'20230719 htw start IOS 그리드 리스트 체크 상태 적용을 위한 변수 추가
			Dim bFlag
			bFlag = false
			for i = 0 to Grid0.rowcount - 1			
				if i <> lRow then
					szChk = CInt(Grid0.GetCellData("bd_cell0", i))
					if szChk == 1 then
						bFlag = true
						g_nAlreadyClickIdx = CInt(lRow)
					end if
					Grid0.SetCellData("bd_cell0", i, 0)
				end if
			next
			
			if bFlag == false then'아무것도 선택 안한 상태라면
				g_nAlreadyClickIdx = CInt(lRow)
			end if
			'20230719 htw end IOS 그리드 리스트 체크 상태 적용을 위한 변수 추가
			
			g_nGridClickedIdx = lRow
			'===ASIS미체결 팝업
			Dim szCd, szQty, szOdrNo, szOdrType, szOdrPrc, szClsCd, szDate, szData
			
			if lRow > -1 then
				Form.SetTimerEvent2(1, 1, 0.1)
				Grid0.height = 152
				
				szCd      = Grid0.GetCellData("bd_Cd",       lRow)
				szQty     = Grid0.GetCellData("bd_cell13", lRow)
				szOdrNo   = Grid0.GetCellData("bd_cell15",    lRow)	
				szOdrType = Grid0.GetCellData("bd_cell23",  lRow)
				szOdrPrc  = Grid0.GetCellData("bd_cell3",   lRow)
				szClsCd   = Grid0.GetCellData("bd_cell18",    lRow)
				szDate    = Grid0.GetCellData("bd_cell7", lRow)
				
				szMk = Form.GetItemCodeInfo(szCd, "market")
				
				'20230724 htw start 주문한 단가 셋팅
				Dim szTempCd
				szTempCd = szCd
				if (Left(szCd, 1) == "J" and len(szCd) == 9) or Left(szCd, 1) == "F" or left(szCd, 1) == "Q" then
					szTempCd = szCd
				'주식/KOTC/ELW
				else
					if Left(szCd, 1, 1) == "A" or Left(szCd, 1, 1) == "J" then
						szTempCd = Trim(Mid(szCd,2,Len(szCd)))
					end if
				end if

				if szTempCd == g_szCd then'같은 종목일 경우 init code가 타지 않는다+auto price
					g_szOdrPrc = CInt(szOdrPrc)
					if g_szChangeInit == "1" then'초기화 사용=그리드 단가 입력
						edtPrc.caption = g_szOdrPrc
					else'초기화 미사용=설정 단가 입력
						'부모화면에서 호가 가져온다
						Form.triggerEvent( "#", "MOD_GET_SETTING_HOGA", "" )
					end if
				else
					g_bClickHeaderItem = false
					g_szOdrPrc = CInt(szOdrPrc)
				end if
				'20230724 htw end 주문한 단가 셋팅
				
				g_szCd = szCd
				
				'20211228 SWJ START : 신용대주
				szCredit    = Grid0.GetCellData("bd_cell20", lRow)
				
				if szCredit = "33" or szCredit = "34" then
					Form.ShowAlert("알림", "해당 종목은 대주주문화면에서 주문실행하시기 바랍니다.")
		'			Grid0.SetCellData("bd_cell0", lRow, 0)
		'			f_GridCheck()
					Exit Sub
				end if
				'20211228 SWJ END
				
				Dim g_Tab
				g_Tab = "2"'임시
				'20180719 LES START - KOTC시장(T) 추가
				if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then		
					' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
					szData = "미체결" & "★" & g_Tab & "★" & szCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd
					Form.triggerEvent("#", "12000_CONTRACT", szData)
				else
					szCutCd = Mid(szCd, 2, Len(szCd))
					szMk = Form.GetItemCodeInfo(szCutCd, "market")
					
					'20180719 LES START - KOTC시장(T) 추가
					if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then
						' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
						szData = "미체결" & "★" & g_Tab & "★" & szCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd
						Form.triggerEvent("#", "12000_CONTRACT", szData)
					else
						Form.ShowAlert("알림", "선택하신 상품은 MTS에서는 거래가 불가능한 상품입니다.")
		'				Grid0.SetCellData("bd_cell0", lRow, 0)
		'				f_GridCheck()
					end if
				end if
				
				if chkAll.checkstate == "1" then
					btnQty.enable = false
					btnQMinus.enable = false
					btnQPlus.enable = false
					edtQty.enable = false
					edtQty.caption = ""
				else
					btnQty.enable = true
					btnQMinus.enable = true
					btnQPlus.enable = true
					edtQty.enable = true
					edtQty.caption = Grid0.GetCellData("bd_cell13", lRow)'미체결 수량
				end if
				Set_OrdType()		' 종목코드에 따라 주문유형 설정
				Return_OrdType(szOdrType,szClsCd)
				'20230620 htw start 환경설정에 설정한 정정취소 주문 단가 입력으로 인한 주석처리
'				edtPrc.caption = Grid0.GetCellData("bd_cell3", lRow)'단가
				'20230620 htw end 환경설정에 설정한 정정취소 주문 단가 입력으로 인한 주석처리
			
				Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "1")'호가 visible처리
			end if	
			'===
		else'체크 해제(=리스트 전체로 보이기)
			'20230719 htw start IOS 그리드 리스트 체크 상태 적용을 위한 변수 추가
			g_nAlreadyClickIdx = -1
			'20230719 htw start end 그리드 리스트 체크 상태 적용을 위한 변수 추가
			Grid0.selectrow = -1
			g_nGridClickedIdx = -1'선택 상품 해제
			Grid0.height = 366
			Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")'호가 visible처리
		end if
	end if
End Sub 

Function f_GridCheck()
	Dim szChecked, bFlag
	bFlag = false
	
	for i = 0 to Grid0.rowcount - 1
		szChecked = Grid0.GetCellData("bd_cell0", i)
		if szChecked == "1" then
			bFlag = true
			exit for
		end if
	next
	
	if bFlag then
		'그리드에 1개라도 체크가 되어있다
		Grid0.height = 152
		Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "1")'호가 visible처리
	else
		'그리드에 체크된게 없다
		Grid0.height = 366
		Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")'호가 visible false처리
	end if
end Function 
'============================================================================
Sub chkMarketPrice_OnChange(sCheckState)
	if sCheckState == "1" then
		'시장가
		cmbType.currentindex = 1
		edtPrc.caption = ""
	else
		cmbType.currentindex = 0
	end if
End Sub


'============================================================================
Sub btnAllCancel_OnClick()
	if Check_Account(0) == false then
		return false
	end if
	'일괄취소
	dim bFlag, nCnt,szData
	nCnt = 0
	bFlag = false
	szData = ""
	
	for i = 0 to Grid0.rowcount - 1
		if Grid0.GetCellData("bd_cell0", i) == "1" then
			if bFlag == false then
				g_szTRIdx = i
				bFlag = true
			end if
			
			nCnt = nCnt + 1
		end if
	next
	
	if bFlag == true then
		g_OrderGubn = "2"

		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
'			
			szData = Form.GetCtlProp("#acnt", "caption")					' 계좌번호
			szData = szData & "|" & Form.GetCtlProp("#acnt", "accountname")				' 계좌명
			szData = szData & "|" & nCnt
			
			if CInt(nCnt) == CInt(Grid0.rowcount) then
				szData = szData & "|" & "전종목"
			else
				szData = szData & "|" & "선택종목"
			end if
			
			Form.OpenPopupAnimation("mbtrs12020_p10", szData , "","2")		' 주문확인팝업 오픈
		else
			Request_Order()
		end if
	else
		'선택한게 하나도 없다면
		Form.ShowAlert("알림", "일괄취소할 주문을 선택해주세요.")
	end if
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	if nCurrentTab == 1 then
		g_szGbnCode = "2"	' 매매구분코드(0:전체, 1:매도, 2:매수)
	elseif nCurrentTab == 2 then
		g_szGbnCode = "1"
	else
		g_szGbnCode = CStr(nCurrentTab)	' 매매구분코드(0:전체, 1:매도, 2:매수)
	end if
	g_nGridClickedIdx = -1
	Grid0.rowcount = 0
	'20230724 htw start 변경시 그리드 펼치기 추가
	Grid0.selectrow = -1
	Grid0.height = 366
	'20230724 htw start 전체취소 체크 클리어 추가
	chkAllCancel.checkstate = "0"
	Form.triggerEvent("#", "MOD_HOGA_VISIBLE_SET", "0")'호가 visible처리
	'20230724 htw end 변경시 그리드 펼치기 추가
	DATAMANAGER.RequestTranData("obtrs_cntg_638r")

End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgRefresh.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
	imgNodata.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.setTimerEvent2(1,0,0.1)
	Grid0.toprow = g_nGridClickedIdx
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.setTimerEvent2(1,0,0.1)
End Sub

