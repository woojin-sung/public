	<SCRIPT_INFO _len="1478" _ulen="1306" >
'실시간시세신청_완료

'============================================================================
Sub Form_OnFormInit()
	Dim szData, szList
	szData = Form.GetOpenLinkData()	
	'szData = "16090" & "★" & "미국" & "★" & "24.02.09 ~ 자동연장" & "★" &  "5 USD"& "★" & "1234567890"& "★" & "실시간 시세 신청이\n완료되었습니다."
	'화면번호★고객번호★신청계좌★계약서류제공방식★완료문구
  	if InStr(szData, "★") > 0 then
		szList = Split(szData, "★")
		If UBOUND(szList) < 1 then
			Exit Sub
		end if 		
		
		lblTitle.caption = szList(5)
		Table0.SetCellString(4, 2, szList(1)) '시장
		Table0.SetCellString(7, 2, szList(2)) '신청기간
		Table0.SetCellString(9, 2, szList(3)) '월이용료
		Table0.SetCellString(11, 2, szList(4)) '계좌번호			
	End if
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()		
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("nrsmbtro16090_p4_end", "ok")
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
	ImageInfo.setMaintaningRatio("1")
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용
	btnOK_OnClick()
End Sub
