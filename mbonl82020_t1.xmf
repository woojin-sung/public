Sub Cont0_Account0_ChangeAccount()
	Cont0.EditPW.caption = ""
End Sub

'============================================================================
Sub Cont0_EditPW_OnEditComplete()
	if Cont0.EditPW.caption ~= null and Cont0.EditPW.caption ~= "" then
		DATAMANAGER.RequestTranData( "obacp_opop_066r" ) '계좌비밀번호검증
	end if
End Sub

'============================================================================
' 신청구분 선택
'============================================================================
Sub Cont0_RdoGubun_OnClick(nIndex)

	Select Case nIndex	'16-03-23 YCJ 전요셉과장님이 라디오 선택에 따른 하단 버튼명 변경 요청
		Case 0 
			Cont0.ButtonOK.caption = "융자약정등록"
		Case 1 
			Cont0.ButtonOK.caption = "융자약정변경"
		Case 2 
			Cont0.ButtonOK.caption = "융자약정해지"
	End Select
	
	Cont0.ChkTypeM.chksilence = "0"
	Cont0.ChkTypeY.chksilence = "0"
	
	SetControlType()	
End Sub

'============================================================================
' 예탁담보융자 체크박스
'============================================================================
Sub Cont0_ChkTypeY_OnChange(sCheckState)
	if GetPWCkeck() then
		Exit Sub
	end if

	if Cont0.RdoGubun.currentindex == "2" and sCheckState == "1" and Cont0.Table0.GetCellString( 2, 4 ) == "등록" then
		Cont0.ChkTypeM.chksilence = "1" 
	elseif Cont0.RdoGubun.currentindex ~= "1" then 
		if sCheckState == "0" then
			Cont0.ChkTypeM.chksilence = "0" 
			Cont0.ChkTypeM.enable = true
		end if
	end if
End Sub

'============================================================================
' 매도담보융자 체크박스
'============================================================================
Sub Cont0_ChkTypeM_OnChange(sCheckState)
	if Cont0.RdoGubun.currentindex == "0" and Cont0.ChkTypeY.chksilence == "0" and Cont0.Table0.GetCellString( 1, 4 ) == "미등록" then
		if sCheckState == "1" then
			Form.MsgBox( "안내", "증권담보융자를 선택하셔야 매도담보융자 신청이 가능합니다.", "", 6 )
			Cont0.ChkTypeM.chksilence = "0"
		end if
	end if
	
	if Cont0.RdoGubun.currentindex == "2" and Cont0.ChkTypeY.chksilence == "1" and Cont0.Table0.GetCellString( 1, 4 ) == "등록" then
		if sCheckState == "0" then
			Form.MsgBox( "안내", "매도담보융자를 해지하셔야 증권담보융자 해지가 가능합니다.", "", 6 )
			Cont0.ChkTypeM.chksilence = "1"
		end if
	end if
End Sub

