'============================================================================
Sub Cont0_ButtonOK_OnClick()
	if GetPWCkeck() then
		Exit Sub
	end if
	
	if Cont0.ChkTypeY.chksilence == "0" and Cont0.ChkTypeM.chksilence == "0" then
		Form.MsgBox( "안내", "처리대상을 선택하시기 바랍니다.", "", 6 )
		Exit Sub
	end if
	
	if Cont0.RdoGubun.currentindex ~= "2" then '등록/변경
		if Cont0.ChkTypeY.chksilence == "1" then '예탁담보융자 약정금액,인지세납부계좌확인
			if Cont0.Table0.GetCellString( 4, 1 ) == "" then
				Form.MsgBox( "안내", "약정금액을 확인하시기 바랍니다.", "", 6 )
				Exit Sub
			end if
			
			if Cont0.Account0.caption == "" then
				Form.MsgBox( "안내", "인지세납부계좌를 확인하시기 바랍니다.", "", 6 )
				Exit Sub
			end if
			
			if Cont0.EditPW.caption == "" then
				'추가납부인지세가 없는 경우엔 비밀번호 입력하지 않아도 처리
				if CDbl(Cont0.Table0.GetCellString( 5, 1 )) > 0 then
					Form.MsgBox( "안내", "인지세납부계좌 비밀번호를 입력해주세요.", "", 6 )
					Exit Sub
				end if
			end if
			
			'인지세 납부계좌를 설정할때 "출금가능금액 >= (추가납부인지세/2) 금액이상이어야 설정 가능.
			'(고객과 회사 50%씩 부담)
			Dim nAbleAmt, nNum 
			nAbleAmt = GetTonumber(LabelAbleAmt.caption) '출금가능금액
			nNum = GetTonumber(Cont0.Table0.GetCellString( 5, 1 )) '추가납부인지세
		
			'if (nAbleAmt <= 0) or (nAbleAmt < (nNum/2)) then
			if nAbleAmt < (nNum/2) then
				Form.MsgBox( "안내", "출금가능금액이 부족합니다.", "", 6 )
				Exit Sub
			end if
		end if
		
		if Cont0.ChkView1.chksilence == "0" then
			if g_sCustClsCd ~= "2" then '개인경우만체크(법인스킵)
				Form.MsgBox( "안내", "개인정보제공 및 활용동의에 동의하셔야 합니다.", "", 6 )	
				Exit Sub
			end if
		end if
		
		if Cont0.ChkView2.chksilence == "0" then
			Form.MsgBox( "안내", "증권담보융자약관에 동의하셔야 합니다.", "", 6 )	
			Exit Sub
		end if
		
		if Cont0.ChkView3.chksilence == "0" then
			Form.MsgBox( "안내", "증권담보융자설명서 내용에 동의하셔야 합니다.", "", 6 )	
			Exit Sub
		end if
		
		if Cont0.ChkSMS.chksilence == "0" and Cont0.ChkEmail.chksilence == "0" then
			Form.MsgBox( "안내", "담보부족통보처를 선택하셔야 합니다.", "", 6 )	
			Exit Sub
		end if
		
		if Cont0.ChkSMS.chksilence == "0" then
			Form.MsgBox( "안내", "SMS는 필수 선택 사항입니다.", "", 6 )	
			Exit Sub
		end if
	end if
	
	'개인 and 등록 and 예탁담보융자인경우 신용정보조회체크(약정금액설정버튼클릭시실행됨)
	if g_bTryFlag == false then
		if g_sCustClsCd == "1" and Cont0.RdoGubun.currentindex == "0" and Cont0.ChkTypeY.chksilence == "1" then
			Form.MsgBox( "안내", "약정금액을 확인하시기 바랍니다.", "", 6 )
			Exit Sub
		end if
	end if
	'20191118 LHR T1911130021
	if Cont0.RdoGubun.currentindex == "-1" or Cont0.RdoGubun.currentindex == "0" then
		Form.MsgBox( "안내", "약관 및 설명서 내 최소담보유지비율(고객별/종목군별 적용)에 대한 내용을 충분히 숙지하여 주시기 바랍니다.\n" & "처리하시겠습니까?", "exec", 1 )
	elseif Cont0.RdoGubun.currentindex == "1" then 
		Form.MsgBox( "안내", "약관 및 설명서 내 최소담보유지비율(고객별/종목군별 적용)에 대한 내용을 충분히 숙지하여 주시기 바랍니다.\n" & "약정변경(감액)시, 인지세 환급은 불가합니다. 처리하시겠습니까?", "exec", 1 )
	else
		Form.MsgBox( "안내", "약정해지 시, 인지세 환급은 불가합니다. 처리하시겠습니까?", "exec", 1 )
	end if
End Sub

