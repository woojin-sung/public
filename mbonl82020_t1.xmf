'	    if trim(sParam) = "" then
'		    Form.ShowAlert("알림", "부적정여부를 수신받지 못했습니다. IT에 연락해주세요.")
'		    exit sub
'	    end if	
'	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == G_PERSONAL_AGREE_FILE then
		if sRet == "ok" then
			Cont0.ChkView1.chksilence = "1"
		end if
	elseif sKeyName == G_MODIFY_INFO_FILE then 
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obcsb_acad_002r" ) '연락처조회
		end if
	elseif sKeyName == G_PRCSET_FILE then
		if sRet == "ok" then
			Dim Amt1, Amt2, Amt3
			Amt1 = Form.GetSharedData("mbonl82020_p2_Amt1" , false)
			Amt2 = Form.GetSharedData("mbonl82020_p2_Amt2" , false)
			Amt3 = Form.GetSharedData("mbonl82020_p2_Amt3" , false)
		
			Cont0.Table0.SetCellString( 4, 1, Amt1 )			
			Cont0.Table0.SetCellString( 5, 1, Amt2 )
			Cont0.Table0.SetCellString( 6, 1, Amt3 )
			Cont0.Table0.SetCellString( 7, 1, tonumber(Amt2)+tonumber(Amt3) )
		end if
	elseif sKeyName == G_PW_CERT_FILE then
		if sRet ~= "cancel" then
			DATAMANAGER.SetEventFlag( "oblon_basc_801a", "A" )
			DATAMANAGER.RequestTranData( "oblon_basc_801a" ) '약정등록
		end if 
	elseif sKeyName == G_OPENURL_FILE then
		if sRet == "증권담보융자약관" then
			Cont0.ChkView2.chksilence = "1"
		elseif sRet == "증권담보융자설명서" then
			Cont0.ChkView3.chksilence = "1"
		end if
	end if
	'2021.03.17 - KYC
	'설문지 리턴
	if sKeyName = "mbonl93500" Then
		g_szAnxtAprt_Yn = sRet	'부적정여부
		if g_szAnxtAprt_Yn = "N" then	'부적정여부 리턴: 적정
			Cont0.ButtonOK.enable = true
			Form.MsgBox("알림", "부적정여부 : [적정]. 계속 진행하세요", "kyc_check", 0)	'확인 버튼만
		elseif g_szAnxtAprt_Yn = "Y" then	'부적정여부 리턴: 부적정
			'대출_고객정보 확인서 징구 여부 관련 조회로 처음부터 체크한다. 
			Form.MsgBox("알림", "부적정여부 : [부적정]", "kyc_check", 0) '확인 버튼만
		else
			'처리없음.
		end If
		
		DATAMANAGER.RequestTranData("oblon_basc_103r")
	'부적정보고서 리턴
	elseif sKeyName = "mbonl93503" Then
		if sRet = "Y" then	'보고서 확인
			Cont0.ButtonOK.enable = true
		else
			'대출_고객정보 확인서 징구 여부 관련 조회로 처음부터 체크한다. 
			DATAMANAGER.RequestTranData("oblon_basc_103r")
		end If
	'v001
	elseif sKeyName == "ok_mbonl81010_p16" then
		if sRet == "OK" then
			Form.OpenFramePopup(G_PW_CERT_FILE , "" , "") '공인인증비밀번호검증
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "prcset" then
		if sRet == "ok" then
			LabelCRINCLCD.caption = "TR01"
			LabelSDRCSRNO.caption = ""
			g_nTryCnt = 0
			g_bTryFlag = false
			
			DATAMANAGER.SetDataValue( 0, "obcsb_nice_010r", "InBlock1", "SDRC_CLS_CODE" , 0 , "1" ) '송신
			DATAMANAGER.RequestTranData( "obcsb_nice_010r" ) '고객정보확인조회
		end if
	elseif sKeyName == "exec" then
		if sRet == "ok" then
			'v001 순서변경 등록/변경 -> 계약서류교부, 해지 -> 공인인증서
			if GetTonumber(Cont0.RdoGubun.currentindex)+1 ~= 3 then
				DATAMANAGER.RequestTranData("obsap_acif_999a")
			else
				Form.OpenFramePopup(G_PW_CERT_FILE , "" , "") '공인인증비밀번호검증
			end if
			'Form.OpenFramePopup(G_PW_CERT_FILE , "" , "") '공인인증비밀번호검증
		end if
	
	'2021.03.17 : 대출KYC
	elseif sKeyName == "kyc" then
		if sRet == "ok" then			
			szData = setKycSharedData("mbonl93500")
			Form.OpenFramePopup("mbonl93500" , szData , "") '대출 KYC 설문 메인
		else
			Form.ShowAlert("알림", "고객정보확인 후 약정 가능합니다.")
			exit Sub
		End if
	'적정성 여부 확인 MsgBox
	elseif sKeyName == "kyc_check" then	'적정성 여부 확인
		'확인
		if g_szAnxtAprt_Yn = "Y" Then	'부적정
			DATAMANAGER.RequestTranData("oblon_basc_103r")
		end if
	elseif sKeyName == "kyc_report" then
		if sRet == "ok" then
			setKycSharedData("mbonl93503")
			Form.OpenFramePopup("mbonl93503" , "" , "") '대출 KYC 부적합 보고서
		else
			Form.ShowAlert("알림", "부적정확인서를 발급하여야 진행하실 수 있습니다.")
			exit sub
		end if
	end if
		
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sACNT_PWD 
	'sACNT_PWD = Form.GetCtlProp( "#EditPW0", "caption" )
	Dim plain_rm
	
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then
		sACNT_PWD = Form.GetCtlProp( "#EditPW0", "caption" )
	'MTS메모리평문 미적용상태일때
	else
		sACNT_PWD = Form.GetCtlProp( "#EditPW0", "encdata" )
	end if
	'MTS메모리보안
	'sACNT_PWD = Form.GetEncData(sACNT_PWD)
	
	if szTranID == "obacp_opop_065r" then
		DATAMANAGER.SetDataValue( 0, "obacp_opop_065r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
	elseif szTranID == "obacp_opop_066r" then
		Dim sPWD 
		'sPWD = Form.GetEncData(Cont0.EditPW.caption)
		'sPWD = Cont0.EditPW.caption
		
		if plain_rm == "1" then
			sPWD = Cont0.EditPW.caption
		else
			sPWD = Form.GetEncData(Cont0.EditPW.caption)
		end if
		
		DATAMANAGER.SetDataValue( 0, "obacp_opop_066r", "InBlock1", "ACNO" , 0 , Left(Cont0.Account0.caption, 8) )
		DATAMANAGER.SetDataValue( 0, "obacp_opop_066r", "InBlock1", "ASNO" , 0 , Right(Cont0.Account0.caption, 2) )
		DATAMANAGER.SetDataValue( 0, "obacp_opop_066r", "InBlock1", "ACNT_PWD" , 0 , sPWD )
	elseif szTranID == "obrtp_drab_001r" then
		Dim sToday 
		sToday = Form.GetSharedData("&HOST_DATE", false )
		
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "ACNO" , 0 , Left(Cont0.Account0.caption, 8) )
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "ASNO" , 0 , Right(Cont0.Account0.caption, 2) )
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "PROS_DATE" , 0 , sToday )
	elseif szTranID == "oblon_basc_801r" then
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801r", "InBlock1", "ASNO" , 0 , LabelASNO.caption )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801r", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
	elseif szTranID == "obcsb_acad_002r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "PWD" , 0 , sACNT_PWD )
	'20160811 obaci_acct_095r TR조회 추가
	elseif szTranID == "obaci_acct_095r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"     , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )		
'	elseif szTranID == "obcsb_acif_556r" then
'		DATAMANAGER.SetDataValue( 0, "obcsb_acif_556r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
'		DATAMANAGER.SetDataValue( 0, "obcsb_acif_556r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
	elseif szTranID == "obcsb_nice_010r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_nice_010r", "InBlock1", "BSWR_CLS_CODE", 0 , "1" ) '개설
		DATAMANAGER.SetDataValue( 0, "obcsb_nice_010r", "InBlock1", "CRIN_IQRY_CLCD", 0 , LabelCRINCLCD.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_nice_010r", "InBlock1", "ACNO", 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "obcsb_nice_010r", "InBlock2", "SDRC_SRNO", 0 , LabelSDRCSRNO.caption )
	elseif szTranID == "oblon_basc_801a" then
		DATAMANAGER.ClearInputData( 0, szTranID )
		
		Dim nIndex, sPWD
		nIndex = 0
		'MTS메모리보안
		'sPWD = Form.GetEncData(Cont0.EditPW.caption)
		'sPWD =Cont0.EditPW.caption
		if plain_rm == "1" then
			sPWD = Cont0.EditPW.caption
		else
			sPWD = Form.GetEncData(Cont0.EditPW.caption)
		end if
		
		if Cont0.ChkTypeY.chksilence == "1" then '예탁담보융자
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "PROS_YN" , nIndex , "Y" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "LOAN_TYPE_CODE" , nIndex , "02" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "LIMT_AMT" , nIndex , Cont0.Table0.GetCellString( 4, 1 ) ) '약정금액
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "STPL_CANC_CLS_CODE" , nIndex , "0" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "UNCL_ATMT_LOAN_YN" , nIndex , "N" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "FEE_LEVY_CLS_CODE" , 0 , "2" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "SPLM_PAYM_AMT" , 0 , Cont0.Table0.GetCellString( 5, 1 ) ) '추가납부인지세
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_MNRC_AMT1" , 0 , Cont0.Table0.GetCellString( 5, 1 ) ) '추가납부인지세
			
			nIndex = nIndex+1
		end if
		
		if Cont0.ChkTypeM.chksilence == "1" then '매도담보융자
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "PROS_YN" , nIndex , "Y" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "LOAN_TYPE_CODE" , nIndex , "03" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "LIMT_AMT" , nIndex , Cont0.Table0.GetCellString( 4, 1 ) ) '약정금액
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock1", "STPL_CANC_CLS_CODE" , nIndex , "0" )
		end if
		
		'처리일자, 처리일련번호
		Dim sProsDate, sProsSrno 
		sProsDate = Form.GetSharedData( "PROS_DATE", false )
		sProsSrno = Form.GetSharedData( "PROS_SRNO", false )
		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "ASNO" , 0 , LabelASNO.caption )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "ACNT_PWD" , 0 , sACNT_PWD )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "PROS_CLS_CODE" , 0 , GetTonumber(Cont0.RdoGubun.currentindex)+1 )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "DRNG_ACNO" , 0 , Left(Cont0.Account0.caption, 8) ) '인지세납부계좌번호
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "DRNG_ASNO" , 0 , Right(Cont0.Account0.caption, 2) ) '인지세납부계좌번호
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_CNFR_PWD" , 0 , sPWD )
		DATAMANAGER.SetDataValue(0,"oblon_basc_801a", "InBlock2", "CRDT_AGRM_BSWR_KIND_CLCD", 0, "014")
		DATAMANAGER.SetDataValue(0,"oblon_basc_801a", "InBlock2", "PROS_DATE", 0, sProsDate)
		DATAMANAGER.SetDataValue(0,"oblon_basc_801a", "InBlock2", "PROS_SRNO", 0, sProsSrno)
		DATAMANAGER.SetDataValue(0,"oblon_basc_801a", "InBlock2", "FNPR_JOIN_SRNO", 0, g_szFnprJoinSrno) 'v001
		DATAMANAGER.SetDataValue(0,"oblon_basc_801a", "InBlock2", "CONT_CLS_CODE" , 0, "4") 'v001
		
		if Cont0.ChkSMS.chksilence == "1" then
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_PROD_OPNG_YN1" , 0 , "Y" )
		else
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_PROD_OPNG_YN1" , 0 , "N" )
		end if
		if Cont0.ChkEmail.chksilence == "1" then
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_PROD_OPNG_YN2" , 0 , "Y" )
		else
			DATAMANAGER.SetDataValue( 0, "oblon_basc_801a", "InBlock2", "UI_PROD_OPNG_YN2" , 0 , "N" )
		end if
	'2021.03.17 대출_고객정보 확인서 징구 여부 관련 조회
	elseif szTranID == "oblon_basc_103r" then
		g_ACNO 	  = Left(g_sAcc, 8)
		g_sloanType = "02" '담보대출
		DATAMANAGER.SetDataValue( 0, "oblon_basc_103r", "InBlock1", "ACNO" 		   , 0 , g_ACNO )	'계좌번호
		DATAMANAGER.SetDataValue( 0, "oblon_basc_103r", "InBlock1", "BSWR_DIV_CODE" , 0 , "16001" )	'대출약정
		DATAMANAGER.SetDataValue( 0, "oblon_basc_103r", "InBlock1", "LOAN_TYPE_CODE", 0 , g_sloanType )	'신용
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obacp_opop_066r" then
		DATAMANAGER.RequestTranData( "obrtp_drab_001r" ) '출금가능금액조회
	elseif szTranID == "obacp_opop_065r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, "obacp_opop_065r", "OutBlock1" )
		
		if nCnt > 0 then
			Dim ACNT_STAT_CODE, PRCD, ACNO, ASNO, CSNM, UI_INPR_NAME 
			
			for i = 0 to nCnt-1 
				ACNT_STAT_CODE = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "ACNT_STAT_CODE" , i )
				PRCD = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "PRCD" , i )
				
				if ACNT_STAT_CODE == "1" and PRCD == "100" or PRCD == "105" or PRCD == "106" or PRCD == "107" or PRCD == "119" then
					LabelASNO.caption = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "ASNO" , i )
		
					Exit For
				else
					LabelASNO.caption = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "ASNO" , 0 )
				end if
			next
		end if
		'2021.03.17 : 대출KYC 추가
		g_sCsnm = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "CSNM" , 0 )
	    '대출_고객정보 확인서 징구 여부 관련 조회
	    DATAMANAGER.RequestTranData("oblon_basc_103r")
	    
	'2021.03.17 : 대출KYC 추가
	elseif szTranID == "oblon_basc_103r" then
		Cont0.ButtonOK.enable = False
		szCase = DATAMANAGER.GetDataValue( 0, "oblon_basc_103r", "OutBlock1", "PROS_YN" , 0 )
		SELECT CASE szCase
		    Case "Y"	'처리가능
			    '처리가능한 경우 기존대로 실행하면 됨.
			    Cont0.ButtonOK.enable = True
		    Case "1"	'미등록
			    '고객정보확인서 등록하도록 화면 open
			    Form.MsgBox("알림", "고객정보확인서 미등록 고객입니다. 확인하시겠습니까?" , "kyc", 1)
		    Case "2"	'고객정보 확인서 만기경과
			    Form.MsgBox("알림", "고객정보확인서 만기경과 고객입니다. 확인하시겠습니까?" , "kyc", 1)
		    Case "3"	'대출약정을 위한 설문 미응답
			    Form.MsgBox("알림", "고객정보확인서 설문 미응답 고객입니다. 확인하시겠습니까?" , "kyc", 1)
		    Case "4"	'부적정확인서 발급필요
			    Form.MsgBox("알림", "부적정확인서를 발급합니다." , "kyc_report", 1)
		END SELECT
		
		DATAMANAGER.RequestTranData( "oblon_basc_801r" ) '약정등록조회
		
	elseif szTranID == "oblon_basc_801r" then
		g_bTryFlag = false
		
		Dim sUI_PROD_OPNG_YN1, sUI_PROD_OPNG_YN2
		sUI_PROD_OPNG_YN1 = DATAMANAGER.GetDataValue( 0, "oblon_basc_801r", "OutBlock2", "UI_PROD_OPNG_YN1" , 0 ) 'SMS
		sUI_PROD_OPNG_YN2 = DATAMANAGER.GetDataValue( 0, "oblon_basc_801r", "OutBlock2", "UI_PROD_OPNG_YN2" , 0 ) 'E-mail
		
		if sUI_PROD_OPNG_YN1 == "Y" then
			Cont0.ChkSMS.chksilence = "1" 
			'Cont0.ChkSMS.enable = false
			'LHR 수정
			Cont0.Image0.enable = true
		else
			Cont0.ChkSMS.chksilence = "0" 
			'Cont0.ChkSMS.enable = true
			'LHR 수정
			Cont0.Image0.enable = false
		end if
		
		if sUI_PROD_OPNG_YN2 == "Y" then
			Cont0.ChkEmail.chksilence = "1" 
			'Cont0.ChkEmail.enable = false
			'LHR 수정
			Cont0.Image1.enable = true
		else
			Cont0.ChkEmail.chksilence = "0" 
			'Cont0.ChkEmail.enable = true
			'LHR 수정
			Cont0.Image1.enable = false
		end if
		
		Dim nCnt 
		nCnt = DATAMANAGER.GetDataCount( 0, "oblon_basc_801r", "OutBlock1" )
		
		if nCnt > 0 then
			Dim CANC_YN, LIMT_AMT, REG_DATE
			
			for i = 0 to nCnt-1
				CANC_YN = DATAMANAGER.GetDataValue( 0, "oblon_basc_801r", "OutBlock1", "CANC_YN" , i ) '해지여부
				LIMT_AMT = DATAMANAGER.GetDataValue( 0, "oblon_basc_801r", "OutBlock1", "LIMT_AMT" , i ) '약정금액
				REG_DATE = DATAMANAGER.GetDataValue( 0, "oblon_basc_801r", "OutBlock1", "REG_DATE" , i ) '약정일자
						
				if i == 0 then
					if CANC_YN == "" or CANC_YN == "Y" then
						Cont0.Table0.SetCellString( 1, 4, "미등록" )
					else
						Cont0.Table0.SetCellString( 1, 1, LIMT_AMT )
						Cont0.Table0.SetCellString( 1, 2, REG_DATE )
						Cont0.Table0.SetCellString( 1, 4, "등록" )
					end if
				elseif i == 1 then
					if CANC_YN == "" or CANC_YN == "Y" then
						Cont0.Table0.SetCellString( 2, 4, "미등록" )
					else
						Cont0.Table0.SetCellString( 2, 2, REG_DATE )
						Cont0.Table0.SetCellString( 2, 4, "등록" )
					end if
				end if
			next
		end if
		
		if Cont0.Table0.GetCellString( 1, 4 ) == "미등록" and Cont0.Table0.GetCellString( 2, 4 ) == "미등록" then '약정전혀없는경우
			Cont0.RdoGubun.currentindex = "0"
			Cont0.RdoGubun.enableindex = "0,1"
			Cont0.RdoGubun.enableindex = "1,0"
			Cont0.RdoGubun.enableindex = "2,0"
		elseif Cont0.Table0.GetCellString( 1, 4 ) == "등록" and Cont0.Table0.GetCellString( 2, 4 ) == "미등록" then '예탁담보만있는경우
			Cont0.RdoGubun.currentindex = "0"
			Cont0.RdoGubun.enableindex = "0,1"
			Cont0.RdoGubun.enableindex = "1,1"
			Cont0.RdoGubun.enableindex = "2,1"
		elseif Cont0.Table0.GetCellString( 1, 4 ) == "미등록" and Cont0.Table0.GetCellString( 2, 4 ) == "등록" then '매도담보만있는경우
			Cont0.RdoGubun.currentindex = "0"
			Cont0.RdoGubun.enableindex = "0,1"
			Cont0.RdoGubun.enableindex = "1,1"
			Cont0.RdoGubun.enableindex = "2,1"
		else
			Cont0.RdoGubun.currentindex = "1"
			Cont0.RdoGubun.enableindex = "0,0"
			Cont0.RdoGubun.enableindex = "1,1"
			Cont0.RdoGubun.enableindex = "2,1"
		end if
		
		if Cont0.RdoGubun.currentindex <> "2" then
			NmetAcntYn   = DATAMANAGER.GetDataValue(0, "oblon_basc_801r", "OutBlock2", "NMET_ACNT_YN" , 0)
			LoanGradCode = DATAMANAGER.GetDataValue(0, "oblon_basc_801r", "OutBlock2", "LOAN_GRAD_CODE" , 0)
			LoanGrad     = Form.GetMetaData("대출등급코드", LoanGradCode)
			LimtAmt      = DATAMANAGER.GetDataValue(0, "oblon_basc_801r", "OutBlock2", "UI_LIMT_STND_AMT1" , 0)
			LimtAmt1     = LimtAmt/100000000
			
			if LimtAmt1 > 0 then
				LimtStndAmt = LimtAmt1 & " 억원"
			else
				LimtStndAmt = FormatNumber(LimtAmt, 0) & " 원"
			end if
			
			if NmetAcntYn = "Y" then
				sMseg = "이벤트 계좌인 경우 한도증액이 불가할 수 있으니, 약정금액 설정에 유의하여 주시기 바랍니다\n" & "현재기준 귀하의 총 신용공여한도는 " & LimtStndAmt & "( " & LoanGrad & " ) 입니다.\n\n" & "* 한도는 매월 산정되는 대출등급에 따라 변경될 수 있습니다."
				Form.ShowAlert("안내", sMseg)
			end if
		end if
		
		SetControlType()	
			
		DATAMANAGER.RequestTranData( "obcsb_acad_002r" ) '연락처조회
'		DATAMANAGER.RequestTranData( "obcsb_acif_556r" ) '개인신용정보조회
	elseif szTranID == "obcsb_acad_002r" then
		Dim nCnt, sARCD, sTONO, sTELNO, sEMAIL_ADDR, sINAG_TYPE_CODE
		
		nCnt = DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock1" )
		
		if nCnt > 0 then
			for i = 0 to nCnt-1
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_TYPE_CODE" , i )
	
				if sINAG_TYPE_CODE == "21" then 'E-mail
					sEMAIL_ADDR = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "EMAIL_ADDR" , i )
			
					Cont0.Table1.SetCellString( 1, 1, sEMAIL_ADDR )
					
					Exit for	'첫번째껄 세팅후 out
				end if
			next
		end if
		
		nCnt = DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock3" )
		
		if nCnt > 0 then
			for i = 0 to nCnt-1
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_TYPE_CODE" , i )
				
				if sINAG_TYPE_CODE == "13" then '휴대폰번호
					sARCD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
					sTONO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
					sTELNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
				
					'20160811 마스크삭제 ###-####-####
					'Cont0.Table1.SetCellString( 0, 1, sARCD..sTONO..sTELNO )
					Cont0.Table1.SetCellString( 0, 1, sARCD&"-"&sTONO&"-"&sTELNO )
					
					Exit for	'첫번째껄 세팅후 out - 박정숙과장이 seq=1인걸 세팅해달라 함.
				end if
			next
		end if	
		'2021.03.17 KYC
		g_sCustClsCd = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock5", "CUST_CLS_CODE" , 0 )
		
		if g_sCustClsCd == "2" then '법인
			Cont0.ButtonView1.enable = false
			
			DATAMANAGER.RequestTranData( "obaci_acct_095r" ) '법인 연락처조회 20160811추가
		end if
	
	'20160811 법인통보처TR추가에 따른 처리 추가
	elseif szTranID == "obaci_acct_095r" then
		Dim nCnt, sINAG_TYPE_CODE, sCustTelNo
		
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock2" )
		
		if nCnt > 0 then
			for i = 0 to nCnt-1
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "INAG_TYPE_CODE" , i )
				
				if sINAG_TYPE_CODE == "13" then '휴대폰번호
					sCustTelNo = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "UI_CUST_TELNO" , i )
				
					Cont0.Table1.SetCellString( 0, 1, sCustTelNo )
					
					Exit for	'박정숙과장요청. #22007 법인계좌 통보처 관리에 등록된 휴대폰 번호
				end if
			next
		end if	
		
'	elseif szTranID == "obcsb_acif_556r" then
'		Dim sUI_COMN_AGRM_YN1, sUI_COMN_AGRM_YN2, sUI_COMN_AGRM_YN3, sUI_PROD_AGRM_YN7
'		sUI_COMN_AGRM_YN1 = DATAMANAGER.GetDataValue( 0, "obcsb_acif_556r", "OutBlock1", "UI_COMN_AGRM_YN1" , 0 ) 
'		sUI_COMN_AGRM_YN2 = DATAMANAGER.GetDataValue( 0, "obcsb_acif_556r", "OutBlock1", "UI_COMN_AGRM_YN2" , 0 ) 
'		sUI_COMN_AGRM_YN3 = DATAMANAGER.GetDataValue( 0, "obcsb_acif_556r", "OutBlock1", "UI_COMN_AGRM_YN3" , 0 ) 
'		sUI_PROD_AGRM_YN7 = DATAMANAGER.GetDataValue( 0, "obcsb_acif_556r", "OutBlock2", "UI_PROD_AGRM_YN7" , 0 ) 
'		
'		if sUI_COMN_AGRM_YN1 == "Y" and sUI_COMN_AGRM_YN2 == "Y" and sUI_COMN_AGRM_YN3 == "Y" and sUI_PROD_AGRM_YN7 == "Y" then
'			Cont0.ChkView1.chksilence = "1"
'		end if
	elseif szTranID == "obcsb_nice_010r" then
		Dim sRSLT_CLS
		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_nice_010r", "OutBlock1", "RSLT_CLS" , 0 )
		
		' RSLT_CLS = '0' : 전문 전송하지 않아도 되는 정상적인 경우
		' RSLT_CLS = '1' : 전문 송신한 경우
		' RSLT_CLS = '2' : 전문 송신 후 응답 대기 중
		' RSLT_CLS = '3' : 전문 수신 결과 정상 응답	
		if sRSLT_CLS == "0" or sRSLT_CLS == "3" then '정상/전문수신결과정상응답
			if LabelCRINCLCD.caption == "TR01" then '첫번째호출후재호출
				LabelCRINCLCD.caption = "SA25"
				
				DATAMANAGER.SetDataValue( 0, "obcsb_nice_010r", "InBlock1", "SDRC_CLS_CODE" , 0 , "1" ) '송신
				DATAMANAGER.RequestTranData( "obcsb_nice_010r" ) '고객정보확인조회
			elseif LabelCRINCLCD.caption == "SA25" then '두번째호출후 실질적인업무처리
				LabelSDRCSRNO.caption = DATAMANAGER.GetDataValue( 0, "obcsb_nice_010r", "OutBlock2", "SDRC_SRNO" , 0 )
				g_bTryFlag = true
				
				Form.SetSharedData("mbonl82020_p2_Amt1" , "")
				Form.SetSharedData("mbonl82020_p2_Amt2" , "")
				Form.SetSharedData("mbonl82020_p2_Amt3" , "")
	
				Dim sSendData
				sSendData = Left(g_sAcc, 8)..LabelASNO.caption
				Form.OpenFramePopup(G_PRCSET_FILE , sSendData , "")	
			end if
		elseif sRSLT_CLS == "1" or sRSLT_CLS == "2" then
			LabelSDRCSRNO.caption = DATAMANAGER.GetDataValue( 0, "obcsb_nice_010r", "OutBlock2", "SDRC_SRNO" , 0 )
			
			g_nTryCnt = g_nTryCnt+1
			if g_nTryCnt < 20 then
				DATAMANAGER.SetDataValue( 0, "obcsb_nice_010r", "InBlock1", "SDRC_CLS_CODE" , 0 , "2" ) '송신응답	
				DATAMANAGER.RequestTranData( "obcsb_nice_010r" ) '고객정보확인조회
			else
				g_nTryCnt = 0
				Form.MsgBox( "안내", "신용 정보 조회 실패입니다.", "", 6 )
				Exit Sub
			end if
		end if
	elseif szTranID == "oblon_basc_801a" then
		Dim sMsg, sSubMsg
		sMsg = DATAMANAGER.GetDataMsgText( szTranID )
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			sMsg = sMsg.." "..sSubMsg
		end if
		
		Form.MsgBox( "안내", sMsg, "", 6 )
		
		SetControlViewClear()
		DATAMANAGER.RequestTranData( "oblon_basc_801r" ) '약정등록조회
	'v001
	elseif szTranID == "obsap_acif_999a" then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue(0, "obsap_acif_999a" , "OutBlock1" , "FNPR_JOIN_SRNO" , 0)
		
		'Form.SetSharedData("mbonl81010_p16_ACNO" 	, Left(g_sAcc, 8))
		'Form.SetSharedData("mbonl81010_p16_FRNO_SRNO", g_szFnprJoinSrno)
		
'		Form.SetSharedData("mbonl81010_p16_Lv1"  , "02")
'		Form.SetSharedData("mbonl81010_p16_Lv2"  , "06")
'		Form.SetSharedData("mbonl81010_p16_Lv3"  , "06001")
'		Form.SetSharedData("mbonl81010_p16_Lv4"  , "013")
'		Form.SetSharedData("mbonl81010_p16_Lv5"  , "000")
'		Form.SetSharedData("mbonl81010_p16_ISCD" , "%")
		Form.SetSharedData( "mbonl81010_p16_LOAN_YN", "Y")

		tmp_szData = Left(g_sAcc, 8) & "★" & g_szFnprJoinSrno
		Form.OpenPopup(G_RPRT_FILE , tmp_szData , "")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obacp_opop_066r" then
		Cont0.EditPW.caption = ""
		
		Form.MsgBox( "안내", szErrMsg, "", 6 )
	elseif szTranID == "obcsb_nice_010r" then
		Form.MsgBox( "안내", szErrMsg, "", 6 )
	elseif szTranID == "obrtp_drab_001r" then
		Form.MsgBox( "안내", szErrMsg, "", 6 )
	elseif szTranID == "oblon_basc_801a" then
		Form.MsgBox( "안내", szErrMsg, "", 6 )
	'2021.03.17 대출KYC추가
	elseif szTranID == "oblon_basc_103r" then
		Form.MsgBox( "안내", szErrMsg, "", 6 )
	end if
End Sub

