'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 담보대출신청
' 02. 화면설명 : 담보대출신청_약정등록
' 03. 작    성 : 2016.02.01 김보라
' 04. 수    정 : 2021.03.17 이현우 : 대출KYC 추가
'		        2021.05.26 : 김수진 : 개인신용정보동의 공통팝업처리, oblon_basc_801a IO 변경분 적용 PROS_DATE, PROS_SRNO
'			   2022.03.22 : 이학록 : v001. 계약서류교부방식 선택 팝업 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'계좌컨트롤
'100종합매매 ~ 118CMA자산관리,123비과세종합저축 ~ 128비과세재형저축
Dim g_sAcc '계좌번호
Dim g_sPwd '비밀번호
Dim g_sCsnm	'고객명
Dim g_sloanType   '대출형식
Dim g_nTryCnt '신용정보조회요청수
Dim g_bTryFlag '신용정보조회완료여부
Dim g_sCustClsCd '고객구분코드
Dim G_PERSONAL_AGREE_FILE '개인정보제공 및 활용동의풀팝업
Dim G_MODIFY_INFO_FILE '연락처변경풀팝업
Dim G_INFO_FILE '신용계좌안내풀팝업
Dim G_PRCSET_FILE '약정금액설정풀팝업
Dim G_PW_CERT_FILE '공인인증서비밀번호입력풀팝업
Dim G_OPENURL_FILE '약관설명서풀팝업
Dim g_ServerMode '서버모드
Dim g_szAnxtAprt_Yn '부적정여부 (Y,N)
Dim G_RPRT_FILE '계약서류교부방식선택팝업 v001
Dim g_szFnprJoinSrno '금융상품가입일련번호 
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'===========================================================================
' 계좌비밀번호 입력체크함수
'===========================================================================
Function GetPWCkeck()
	Dim sACNT_PWD 
	sACNT_PWD = Form.GetCtlProp( "#EditPW0", "caption" )
	
	if sACNT_PWD == null or sACNT_PWD == "" then
		Form.MsgBox( "안내", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	end if
	
	return false
End Function	

'===========================================================================
' 예탁담보/매도담보 속성 세팅함수
'===========================================================================
Function SetControlType()	
	if Cont0.RdoGubun.currentindex == "0" or Cont0.RdoGubun.currentindex == "-1" then '등록	
		if Cont0.Table0.GetCellString( 1, 4 ) == "미등록" and Cont0.Table0.GetCellString( 2, 4 ) == "미등록" then '약정전혀없는경우
			Cont0.ChkTypeY.enable = true
			Cont0.ChkTypeM.enable = true
			
			Cont0.ButtonPrcSet.enable = true
		elseif Cont0.Table0.GetCellString( 1, 4 ) == "등록" and Cont0.Table0.GetCellString( 2, 4 ) == "미등록" then '예탁담보만있는경우
			Cont0.ChkTypeY.enable = false
			Cont0.ChkTypeM.enable = true
			
			Cont0.ButtonPrcSet.enable = false
		elseif Cont0.Table0.GetCellString( 1, 4 ) == "미등록" and Cont0.Table0.GetCellString( 2, 4 ) == "등록" then '매도담보만있는경우
			Cont0.ChkTypeY.enable = true
			Cont0.ChkTypeM.enable = false
			
			Cont0.ButtonPrcSet.enable = true
		end if
		
		Cont0.ButtonView1.enable = true
		Cont0.ButtonView2.enable = true
		Cont0.ButtonView3.enable = true
	elseif Cont0.RdoGubun.currentindex == "1" then '변경
		Cont0.ChkTypeM.enable = false
		
		if Cont0.Table0.GetCellString( 1, 4 ) == "등록" and Cont0.Table0.GetCellString( 2, 4 ) == "등록" then '모두약정있는경우
			Cont0.ChkTypeY.enable = true

			Cont0.ButtonPrcSet.enable = true
		elseif Cont0.Table0.GetCellString( 1, 4 ) == "등록" and Cont0.Table0.GetCellString( 2, 4 ) == "미등록" then '예탁담보만있는경우
			Cont0.ChkTypeY.enable = true
			
			Cont0.ButtonPrcSet.enable = true
		elseif Cont0.Table0.GetCellString( 1, 4 ) == "미등록" and Cont0.Table0.GetCellString( 2, 4 ) == "등록" then '매도담보만있는경우
			Cont0.ChkTypeY.enable = false
			
			Cont0.ButtonPrcSet.enable = false
		end if

		Cont0.ButtonView1.enable = true
		Cont0.ButtonView2.enable = true
		Cont0.ButtonView3.enable = true
	elseif Cont0.RdoGubun.currentindex == "2" then '해지
		if Cont0.Table0.GetCellString( 1, 4 ) == "등록" and Cont0.Table0.GetCellString( 2, 4 ) == "등록" then '모두약정있는경우
			Cont0.ChkTypeY.enable = true
			Cont0.ChkTypeM.enable = true
		elseif Cont0.Table0.GetCellString( 1, 4 ) == "등록" and Cont0.Table0.GetCellString( 2, 4 ) == "미등록" then '예탁담보만있는경우
			Cont0.ChkTypeY.enable = true
			Cont0.ChkTypeM.enable = false
		elseif Cont0.Table0.GetCellString( 1, 4 ) == "미등록" and Cont0.Table0.GetCellString( 2, 4 ) == "등록" then '매도담보만있는경우
			Cont0.ChkTypeY.enable = false
			Cont0.ChkTypeM.enable = true
		end if
		
		Cont0.ButtonPrcSet.enable = false
		
		Cont0.ButtonView1.enable = false
		Cont0.ButtonView2.enable = false
		Cont0.ButtonView3.enable = false
	end if
End Function

'===========================================================================
' 설명서 속성 초기화함수
'===========================================================================
Function SetControlViewClear()
	Cont0.Table0.SetCellString( 1, 1, "" )
	Cont0.Table0.SetCellString( 1, 2, "" )
	Cont0.Table0.SetCellString( 1, 4, "미등록" )
	Cont0.Table0.SetCellString( 2, 1, "" )
	Cont0.Table0.SetCellString( 2, 2, "" )
	Cont0.Table0.SetCellString( 2, 4, "미등록" )
	Cont0.Table0.SetCellString( 5, 1, "" )
	Cont0.Table0.SetCellString( 6, 1, "" )
	Cont0.Table0.SetCellString( 7, 1, "" )
	Cont0.Table0.SetCellString( 8, 1, "" )
	Cont0.Table1.SetCellString( 0, 1, "" )
	Cont0.Table1.SetCellString( 1, 1, "" )
	
	Cont0.ChkTypeY.chksilence = "0"
	Cont0.ChkTypeM.chksilence = "0"
	
	Cont0.ChkView1.chksilence = "0"
	Cont0.ChkView2.chksilence = "0"
	Cont0.ChkView3.chksilence = "0"
	
	Cont0.ButtonView1.enable = true
	Cont0.ButtonView2.enable = true
	Cont0.ButtonView3.enable = true
End Function

'===========================================================================
' 숫자 리턴함수
'===========================================================================
Function GetTonumber(sNum)
	Dim nDbl
	nDbl = 0
	
	if sNum == null or Trim(sNum) == "" then
		return nDbl
	end if
	
	nDbl = CDbl(sNum)
	
	return nDbl
End Function

