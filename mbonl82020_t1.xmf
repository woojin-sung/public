'============================================================================
Sub Form_OnFormInit()
	g_sAcc = ""
	g_nTryCnt = 0
	g_bTryFlag = false
	g_sCustClsCd = ""
	G_PERSONAL_AGREE_FILE = "mbonl81020"
	G_MODIFY_INFO_FILE = "mbonl81000"
	G_INFO_FILE = "mbonl82020_p1"
	G_PRCSET_FILE = "mbonl82020_p2"
	G_PW_CERT_FILE = "mhetc90060_p5"
	G_OPENURL_FILE = "mbonl82020_p6"
	G_RPRT_FILE = "mbonl81010_p16"
	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)
	
	Cont0.scroll_pos = "top"
	
	'2021.03.17 : KYC
	Cont0.ButtonOK.enable = true
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "TabChange" then
		'비밀번호없이 조회되도록 요청하여 주석처리
'		if GetPWCkeck() then
'			Exit Sub
'		end if
		
		g_sAcc = sParam
		
		SetControlViewClear()
		DATAMANAGER.RequestTranData( "obacp_opop_065r" ) '인지세납부계좌조회
	end if
	
'	if sEventName == "ANXT_APRT_YN" then
'		'Data Split
'		g_szAnxtAprt_Yn = sParam
'		'Form.ShowAlert("TEST", "부적정여부 : " & g_szAnxtAprt_Yn)
'		
