''			if grdGroup.rowcount <= 0 then
''				nRow = 0
''			else
'				nRow = grdGroup.rowcount
''			end if
''			
'			g_szCode = tData(0)
'			grdGroup.insertrow = nRow
'			grdGroup.SetCellData("bd_code", nRow, tData(0))
'			grdGroup.SetCellData("bd_name", nRow, tData(1))
'			grdGroup.SetCellData("bd_count", nRow, 0)
''			
'		' 그룹 수정
'		elseif sKeyName == "GROUP_MOD" then
'			grdGroup.SetCellData("bd_code", g_szRow, tData(0))
'			grdGroup.SetCellData("bd_name", g_szRow, tData(1))	
'		end if	
'		
'		if g_szCloud == "1" then		' Server 저장시
'			' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
