'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	' 그룹삭제
	if sKeyName == "DELETE" then
		if sRet == "ok" then
			' 20160324 그룹삭제시 파일에 저장되어 있는 관련 종목도 삭제 시킴 //
			szCode = grdGroup.GetCellData("bd_code", g_szRow)
			Form.SaveConfigData("GWANSIM", szCode, "")
			' ////////////////////////////////////////////////////////////////
			grdGroup.SetDeleteRow(g_szRow)
			
			if g_szCloud == "1" then
				DATAMANAGER.RequestTranData("ohhts_intr_008r")
				Save_GWGroup()
			else
				Save_GWGroup()
			end if			
		end if	
	end if	
End Sub



'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
		DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))	' USER ID
	' ----------------------------------------------------------------------
	' 관심 수정 TR :그룹추가, 종목추가, 빈칸추가
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_008r" then
'PENTA13 START => 2019.01.25
		DATAMANAGER.ClearInputData(false, "ohhts_intr_008r")
		DATAMANAGER.ClearOutputData(false, "ohhts_intr_008r")
'PENTA13 END	
		' ////////////// 종목추가, 빈칸적용시 ////////////////
		' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_USER_ID",     0, Form.GetSharedData("&USER_ID", false))		
		' FID버전ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)	
		'DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_VRSN_ID",     0, "12")	
		' FID수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_MOD_YN",      0, "0")				
		' FID종목수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_ISSU_MOD_YN", 0, "0")				
		
		For i = 0 to grdGroup.rowcount - 1
			' FID관심종목그룹ID
			DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_CNCN_ISSU_GRP_ID", i, grdGroup.GetCellData("bd_code", i))
			' FID관심그룹명
			DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_CNCN_GRP_NAME",    i, grdGroup.GetCellData("bd_name", i))	

			' FID종목수정여부
			'if cmbGroup.cbkeydata == grdGroup.GetCellData("bd_code", i) then	
			'if g_szCode == grdGroup.GetCellData("bd_code", i) then	
			
			'	DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_ISSU_MOD_YN", i, "1")			' 수정
			'else
				DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_ISSU_MOD_YN", i, "0")			' 수정안함
			'end if
		Next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 관심 수정 TR
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_008r" then
		Form.SetCtlProp("#edtChange", "caption", "1")	' 그룹변경을 알리기 위해..	
		Form.SetSharedData("VRSN_ID", edtvrsnID.caption) ' 20160317 편집시 ID가 메인화면과 연동안되는부분 때문에 추가
		Get_GWGroup()		'PENTA13 START => 2019.01.23
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	' ----------------------------------------------------------------------
	' 관심 수정 TR
	' ----------------------------------------------------------------------
'	if szTranID == "ohhts_intr_008r" then
'		Form.Toast(1, "[" & szErrCode & "]" & szErrMsg, true)
'	end if		
End Sub
'============================================================================
'PENTA13 START => 2019.01.23
Function Get_GWGroup( )
	grdGroup.rowcount = 0
	if g_szCloud == "1" then		' Server 저장시
		' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
		DATAMANAGER.RequestTranData("ohhts_intr_006r")
	else							' Local 저장시
		' 로컬 저장된 관심그룹 가져오기
		Load_GWGroup( )
	end if
End Function
'PENTA13 END


