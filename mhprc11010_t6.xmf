Sub Form_OnPopupReturn(sKeyName, sRet)
	if sRet <> "" then
		tData = Split(sRet, "★")
		
		' 그룹 추가
		if sKeyName == "GROUP_ADD" then
'			if grdGroup.rowcount <= 0 then
'				nRow = 0
'			else
				g_szRow = grdGroup.rowcount
'			end if
'			
			g_szCode = tData(0)
			grdGroup.insertrow = g_szRow
			
			grdGroup.SetCellData("bd_count", g_szRow, 0)
		end if
		
		grdGroup.SetCellData("bd_code", g_szRow, tData(0))
		grdGroup.SetCellData("bd_name", g_szRow, tData(1))
			
		if g_szCloud == "1" then		' Server 저장시
			' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
			DATAMANAGER.RequestTranData("ohhts_intr_008r")
			Save_GWGroup()
		else							' Local 저장시
			' 로컬 저장된 관심그룹 저장하기
			Save_GWGroup()
		end if
		Form.SaveConfigData("GWANSIM", tData(0), "") '0811 JJH
