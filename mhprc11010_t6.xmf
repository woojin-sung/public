'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	' 관심 동기화 //////////////////////////////////////////////////////////
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	' //////////////////////////////////////////////////////////////////////
	
	' 그리드 로우 위치 변경 위한 속성
	grdGroup.rowmove = "1"
	
'PENTA13 START => 2019.01.23
	Get_GWGroup()
'PENTA13 ORGSRC
'	if g_szCloud == "1" then		' Server 저장시
'		' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
'		DATAMANAGER.RequestTranData("ohhts_intr_006r")
'	else							' Local 저장시
'		' 로컬 저장된 관심그룹 가져오기	
'		Load_GWGroup()
'	end if
'PENTA13 END
End Sub

'============================================================================
' btnAdd_OnClick
'============================================================================
Sub btnAdd_OnClick()	
	Dim szCode, szChk
	Dim nRow
	
	nRow = CInt(grdGroup.rowcount)-1

	if nRow == 99 then
		'Form.ShowAlert("관심그룹 추가", "관심그룹은 최대 100개까지입니다")
		Form.ShowAlert(g_szTitle, "관심그룹은 최대 100개까지입니다")
		Exit Sub
	end if
	
	' 관심그룹 명칭 초기 설정위해.. 코드로 정한다. //////////////////////////
	if nRow < 0 then
		szCode = "00"
	else
		'20180905_01 NOHES START : 관심그룹 생성 시, 순차적으로 확인해서 코드 빠졌을 때 채워넣으면서 만든다.
		'                          그룹이 10개 이상인 경우에 szCd == szCode 처리 못해서 CStr 처리함.
		'0811 JJH 200개까지 추가 가능
		For i = 0 to 199
			if Len(i) == 1 then
				szCode = "00" & i
			elseif Len(i) == 2 then
				szCode = "0" & i
			else
				szCode = CStr(i)
			end if
			
			For j = 0 to nRow		
				szCd = grdGroup.GetCellData("bd_code", j)
				if szCd == szCode then					
					szChk = "0"
					Exit For
				else 
					szChk = "1"
				end if
			Next
			if szChk == "1" then
				Exit For
			end if	
		Next
		'20180905_01 NOHES ORG	
'		For i = 0 to 99
'			if Len(i) == 1 then
'				szCode = "0" & i
'			else
'				szCode = i
'			end if
'				
'			For j = 0 to nRow
'				szCd = grdGroup.GetCellData("bd_code", j)
'								
'				if szCd == szCode then
'				
'					szChk = "0"
'					Exit For
'				end if
'				
'				if j == nRow then
'					szChk = "1"
'				end if				
'			Next	
'			
'			if szChk = "1" then
'				Exit For
'			end if
'		Next
		'20180905_01 NOHES END
	end if
	' ////////////////////////////////////////////////////////////////////////
	
	Form.OpenPopup("mhprc11010_p3" , "GROUP_ADD★" & szCode & "★", "")
End Sub

'============================================================================
' grdGroup_OnClickUp
'============================================================================
Sub grdGroup_OnClickUp(lRow, szCellID)
	if szCellID == "bd_cancel" then	
		'0822 JJH 요건삭제 START---------------------------------
'		if grdGroup.rowcount == "1" then
'			'Form.ShowAlert("관심그룹삭제", "관심그룹은 최소 1개이상 존재하여야합니다.")
'			Form.ShowAlert(g_szTitle, "관심그룹은 최소 1개이상 존재하여야합니다.")
'			exit Sub
'		end if
		'0822 JJH 요건삭제 END---------------------------------
		g_szRow = lRow
	
		szCode = grdGroup.GetCellData("bd_code", lRow)
		szName = grdGroup.GetCellData("bd_name", lRow)
	
		'Form.MsgBox("관심그룹삭제", "선택된 관심그룹을 삭제하겠습니까?\r\n\n["& szCode & "] " & szName , "DELETE", 1)
		Form.MsgBox("알림", "선택된 관심그룹을 삭제하겠습니까?", "DELETE", 1)
	elseif szCellID == "bd_mod" then
		g_szRow = lRow
		
		szCode = grdGroup.GetCellData("bd_code", lRow)
		szName = grdGroup.GetCellData("bd_name", lRow)
		
		Form.OpenPopup("mhprc11010_p3" , "GROUP_MOD★" & szCode & "★" & szName , "")
	end if	
End Sub

'============================================================================
' grdGroup_OnDropRow
'============================================================================
Sub grdGroup_OnDropRow()
	g_szCode = ""
	DATAMANAGER.RequestTranData("ohhts_intr_008r")
End Sub

'============================================================================
' Form_OnPopupReturn
