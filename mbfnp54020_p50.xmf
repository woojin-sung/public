	<SCRIPT_INFO _len="4180" _ulen="4008" >
dim g_nAcNo,g_nAsNo,g_szItemCode, g_szBun
'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData( )
	pann.rowcount = 0
	if szData <> "" then
		tData = split(szData,"★")
		g_nAcNo = tData[0]
		g_nAsNo = tData[1]
		g_szItemCode = tData[2]
		lblKind.caption = tData[3]
		g_szBun = tData[3]
		DATAMANAGER.RequestTranData( "obtrs_comn_314r" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if "obtrs_comn_314r" == szTranID then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0 , g_nAcNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0 , g_nAsNo)
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SORT_CLCD", 0 , Combo0.cbkeydata)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE", 0 , "1")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD", 0 , g_szItemCode)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if "obtrs_comn_314r" == szTranID then
		nCnt = CInt(DATAMANAGER.GetDataCount( false, szTranID , "OutBlock1" ))
		pann.rowcount = nCnt
		
		if nCnt > 0 then
			szMTRT_DATE = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "MTRT_DATE" , i )'만기일자
			tbl0.SetCellString(0, 1, szMTRT_DATE)
		end if
		
		nTotalQty = 0
		nTotalValPrc = 0
		nTotalBuy = 0
		
		for i = 0 to nCnt - 1
			szBYOV_DATE = 	DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "BYOV_DATE" , i )'매수일자
			szODER_ABLE_QTY = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "ODER_ABLE_QTY" , i )'잔고수량
			szBYOV_ERT = 		DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "BYOV_ERT" , i )'수익률
			szBOND_VLTN_AMT = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "BOND_VLTN_AMT" , i )'평가금액
			szBYNG_AMT = 		DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "BYNG_AMT" , i )''매입금액
			'평가손익 = 평가금액 - 매입금액
			szBYNG_UNPR = 	DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "BYNG_UNPR" , i )'매입단가
			
			szBYOV_DATE2 = mid(szBYOV_DATE,3,6)
			pann.SetCellValue("lblBuyDate",i,szBYOV_DATE2)
			pann.SetCellValue("lblRealDate",i,szBYOV_DATE)
			
			nODER_ABLE_QTY = len(szODER_ABLE_QTY)			
			szODER_ABLE_QTY2 = left(szODER_ABLE_QTY,nODER_ABLE_QTY - 3)
			
			pann.SetCellValue("lblRealQty",i,szODER_ABLE_QTY)
			pann.SetCellValue("lblQty",i,szODER_ABLE_QTY2)
			pann.SetCellValue("lblPer",i,szBYOV_ERT)
			pann.SetCellValue("lblValPrc",i,szBOND_VLTN_AMT)
			pann.SetCellValue("lblBuyPrc",i,szBYNG_AMT)
			pann.SetCellValue("lblAvBuyPrc",i,szBYNG_UNPR)
			
			nTotalQty = nTotalQty + CDbl(szODER_ABLE_QTY)
			nTotalValPrc = nTotalValPrc + CDbl(szBOND_VLTN_AMT)
			nTotalBuy = nTotalBuy + CDbl(szBYNG_AMT)
		next
		
		tbl0.SetCellString(1, 1, nTotalQty)
		tbl0.SetCellString(0, 3, nTotalValPrc)
		tbl0.SetCellString(1, 3, nTotalBuy)
	end if
End Sub

'============================================================================
Sub pann_OnClick(nIndex, sCellID)
	innermarket = Form.GetItemCodeInfo(g_szItemCode, "innermarket")
	szDate = pann.GetCellValue("lblRealDate",nIndex)
	szQty = pann.GetCellValue("lblRealQty",nIndex)
	if sCellID == "btnBuy" then
		if f_CheckAble(innermarket) then
			'  "잔고"/탭위치/종목코드/매수구분
			Form.SendReturnToParent("mbfnp54020_p50" , "잔고★0★"&g_szItemCode&"★"&"★"&g_szBun)
			Form.CloseForm()
		end if
	elseif sCellID == "btnSell" then
		if f_CheckAble(innermarket) then
			Form.SendReturnToParent("mbfnp54020_p50" , "잔고★1★"&g_szItemCode&"★"&szQty&"★"&szDate&"★"&g_szBun)
			Form.CloseForm()
		end if
	end if
End Sub

Sub f_CheckAble(szinnermarket)
	if szinnermarket == "" then
		Form.MsgBox("알림", "선택상품은 MTS에서 거래되지 않는 상품입니다.", "", 3)
		return false
	else
		return true
	end if
end Sub
'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

