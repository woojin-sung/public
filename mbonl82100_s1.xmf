		<LABEL name="lblErrorText" halign="1" multiline="1" ly_vert="25,220,325,100,1" />
		<LINKFORM name="lnkSub" linkfile="mbonl82100_s2" ly_vert="0,48,375,514,1" />
		<BUTTON name="btnError" visible="0" fontsize="-1" btnimage="btn_10.9" ly_vert="80,320,215,40,0" />
		<ACCOUNT name="Account0" itemcodetype="100,101,102,103,104,105,106,107,108,109,110,112,113,114,115,117,118,119,120,121,123,124,125,126,127,128,129,130,131,132,133" etcfunctions="" totalacc="1" finaceexcept="1" cmaexcept="1" ly_vert="6,9,363,39,1" />
	</CONTROL_INFO>
