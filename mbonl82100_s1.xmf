'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
'	Form.ShowAlert("TranBefore", szTranID)

	Dim szAct	
	Dim sACNT_PWD
	Dim plain_rm
	
	szAct = Account0.caption
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then
		sACNT_PWD = EditPW.caption
	'MTS메모리평문 미적용상태일때
	else
		sACNT_PWD = Form.GetEncData(EditPW.caption)
	end if
	
	if szTranID == "obacp_opop_065r" then
		DATAMANAGER.SetDataValue( 0, "obacp_opop_065r", "InBlock1", "ACNO" , 0 , Left(szAct,8) )	

	elseif szTranID == "oblon_basc_810r" then
		g_szMoveScreen = ""
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , Left( szAct, 8))
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , g_szASNO)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOAN_TYPE_CODE" , 0 , "02" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "8" ) 'v001
	
	elseif szTranID == "oblon_basc_103r" then
		DATAMANAGER.SetDataValue( 0, "oblon_basc_103r", "InBlock1", "ACNO" 		   , 0 , Left(szAct, 8) )	'계좌번호
		DATAMANAGER.SetDataValue( 0, "oblon_basc_103r", "InBlock1", "BSWR_DIV_CODE" , 0 , "16001" )	'대출약정
		DATAMANAGER.SetDataValue( 0, "oblon_basc_103r", "InBlock1", "LOAN_TYPE_CODE", 0 , "02" )	'신용
	
	elseif szTranID == "oblon_basc_801r" then	
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801r", "InBlock1", "ACNO" , 0 , Left(szAct, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801r", "InBlock1", "ASNO" , 0 , g_szASNO )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_801r", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
	
	elseif szTranID == "obcsb_acad_002r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "ACNO" , 0 , Left(szAct, 8) )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "PWD" , 0 , sACNT_PWD )
		
	elseif szTranID == "obaci_acct_095r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"     , 0 , Left(szAct, 8) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )	
	elseif szTranID == "obcsb_acad_120r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"     , 0 , Left(szAct, 8) )
	elseif szTranID == "obacp_comm_007r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"     , 0 , Left(szAct, 8) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , "9" )
	elseif szTranID == "oblon_nice_001r" then
		DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock1", "NICE_TR_CLCD", 0 , "2P001")
		DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock1", "ACNO"		, 0 , szAct)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	
'	Form.ShowAlert("DATAMANAGER_OnReceiveTranComplete", szTranID)

	if szTranID == "obacp_opop_065r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, "obacp_opop_065r", "OutBlock1" )
		g_szCsnm = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "CSNM" , 0 )
		tmpCsno = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "CSNO" , 0 )
		
		if nCnt > 0 then
			Dim ACNT_STAT_CODE, PRCD, ACNO, ASNO, CSNM, UI_INPR_NAME 
			
			for i = 0 to nCnt-1 
				ACNT_STAT_CODE = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "ACNT_STAT_CODE" , i )
				PRCD = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "PRCD" , i )
				
				if ACNT_STAT_CODE == "1" and PRCD == "100" or PRCD == "105" or PRCD == "106" or PRCD == "107" or PRCD == "119" then
					g_szASNO = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "ASNO" , i )
					Exit For
				else
					g_szASNO = DATAMANAGER.GetDataValue( 0, "obacp_opop_065r", "OutBlock1", "ASNO" , 0 )
				end if
			next
		end if
		
		if tmpCsno <> g_szCustNum then
			g_szCustNum = tmpCsno
			DATAMANAGER.RequestTranData("oblon_basc_810r")
		else
			DATAMANAGER.RequestTranData("oblon_basc_103r")
		end if
		
	elseif szTranID == "oblon_basc_810r" then
		Dim szLoanYn
		szLoanYn = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "LOAN_ABLE_YN" , 0 )
		
		if szLoanYn == "Y" then
			DATAMANAGER.RequestTranData("oblon_basc_103r")
			
		else
			Dim szErrMsg
			Dim sSubMsg 
			Dim szErrCode
			
			sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
			szErrMsg = DATAMANAGER.GetDataMsgText( szTranID )
			szErrCode = DATAMANAGER.GetDataMsgCode( szTranID )
			
			if trim(sSubMsg) ~= "" then
				szErrMsg = szErrMsg.." "..sSubMsg
			end if
			
			Form.ShowAlert(szTranID, "["..szErrCode.."]"..szErrMsg)
		end if 
	'v002
	elseif szTranID == "oblon_nice_001r" then
		tmpRSLT_CLS = DATAMANAGER.GetDataValue(0, "oblon_nice_001r", "OutBlock1", "RSLT_CLS", 0)
		if tmpRSLT_CLS == "1" then
			g_NICE_TR_SRNO = DATAMANAGER.GetDataValue(0, "oblon_nice_001r", "OutBlock2", "SDRC_SRNO", 0)
			g_Timer_TRY_CNT = 0
			
			Form.SetTimerEvent(1, 1, 1)
			'Form.addWaitCursor()
		elseif tmpRSLT_CLS == "0" or tmpRSLT_CLS == "3" then
			Form.SetTimerEvent(1, 0, 1)
			'Form.clearWaitCursor()
			
			if DATAMANAGER.GetDataValue(0, "oblon_nice_001r", "OutBlock3", "PROS_ABLE_YN", 0) == "Y" then
				if g_PROS_CLS = "1" then
					DATAMANAGER.RequestTranData("oblon_basc_801r")
				end if
			else
				DIm szAlertData
				Dim szErrMsg
				szErrMsg = chr(34)&"여신거래 안심차단"&chr(34)&" 서비스 이용 중이므로,"&chr(10)&"대출거래가 제한됩니다."
				szAlertData = "1".."★"..szErrMsg.."★".."0000".."★".."확인".."★".."확인"
			
				Form.OpenPopup("mbonl82010_p6", szAlertData, "")	
				
				lblErrorText.caption = szErrMsg
				lblErrorText.visible = "1"
				lnkSub.visible = "0"
			end if
		end if
		
	elseif szTranID == "oblon_basc_103r" then	
		Dim szCase 
		szCase = DATAMANAGER.GetDataValue( 0, "oblon_basc_103r", "OutBlock1", "PROS_YN" , 0 )
		
		SELECT CASE szCase
		    Case "Y"	'처리가능
			    '처리가능한 경우 기존대로 실행하면 됨.
'			    Cont0.ButtonOK.enable = True
				
				'v002
				'DATAMANAGER.RequestTranData("oblon_basc_801r")
				g_PROS_CLS = "1"
				NICE_LN01_CALL()
				
		    Case "1"	'미등록
			    '고객정보확인서 등록하도록 화면 open
'			    Form.MsgBox("알림", "고객정보확인서 미등록 고객입니다. 확인하시겠습니까?" , "kyc", 1)
			    
			    lblErrorText.caption = "신용공여 고객정보확인 등록 후\n신청 가능합니다."
			    lnkSub.visible = "0"
				lblErrorText.visible = "1"
				btnError.visible = "1"
				btnError.caption = " 신용공여 고객정보확인서 등록"
				g_szMoveScreen = "93500"
			    
			    Dim szAlertData
				szAlertData = "2".."★".."신용공여 고객정보확인 등록 후\n신청 가능합니다.".."★".."kyc".."★".."취소".."★".."등록하기"
				
				Form.OpenPopup("mbonl82010_p6", szAlertData, "")
				
		    Case "2"	'고객정보 확인서 만기경과
'			    Form.MsgBox("알림", "고객정보확인서 만기경과 고객입니다. 확인하시겠습니까?" , "kyc", 1)

				lblErrorText.caption = "신용공여 고객정보확인서\n만기가 경과되었습니다.\n재등록 후 신청 가능합니다."
			    lnkSub.visible = "0"
				lblErrorText.visible = "1"
				btnError.visible = "1"
				btnError.caption = " 신용공여 고객정보확인서 등록"
				g_szMoveScreen = "93500"
			    
			    Dim szAlertData
				szAlertData = "2".."★".."신용공여 고객정보확인서\n만기가 경과되었습니다.\n재등록 후 신청 가능합니다.".."★".."kyc".."★".."취소".."★".."등록하기"
				
				Form.OpenPopup("mbonl82010_p6", szAlertData, "")
			    
		    Case "3"	'대출약정을 위한 설문 미응답
'			    Form.MsgBox("알림", "고객정보확인서 설문 미응답 고객입니다. 확인하시겠습니까?" , "kyc", 1)
			    
			    'lblErrorText.caption = "신용공여 고객정보확인 등록 후\n신청 가능합니다."
			    lblErrorText.caption = "고객정보확인서 설문 항목 중 대출용도를\n약정 유형에 맞춰서 등록해주세요."
			    lnkSub.visible = "0"
				lblErrorText.visible = "1"
				btnError.visible = "1"
				btnError.caption = "신용공여 고객정보확인서 등록"
				g_szMoveScreen = "93500"
			    
			    Dim szAlertData
				'szAlertData = "2".."★".."고객정보확인서 설문 미응답 고객입니다.\n확인하시겠습니까?".."★".."kyc".."★".."취소".."★".."등록하기"
				szAlertData = "2".."★".."고객정보확인서 설문 항목 중 대출용도를\n약정 유형에 맞춰서 등록해주세요.".."★".."kyc".."★".."취소".."★".."등록하기"
				
				Form.OpenPopup("mbonl82010_p6", szAlertData, "")
			    
		    Case "4"	'부적정확인서 발급필요
'			    Form.MsgBox("알림", "부적정확인서를 발급합니다." , "kyc_report", 1)
			    
			    lblErrorText.caption = "부적정확인서를 발급합니다."
			    lnkSub.visible = "0"
				lblErrorText.visible = "1"
				btnError.visible = "1"
				btnError.caption = "부적정확인서 발급"
				g_szMoveScreen = "mbonl93503"
			    
			    Dim szAlertData
				szAlertData = "2".."★".."부적정확인서를 발급합니다.".."★".."kyc_report".."★".."취소".."★".."발급하기"
				Form.OpenPopup("mbonl82010_p6", szAlertData, "")
		END SELECT
		'기존로직 실행	
	
	elseif szTranID == "oblon_basc_801r" then
		Dim szLoanData 
		Dim sUI_PROD_OPNG_YN1, sUI_PROD_OPNG_YN2
		sUI_PROD_OPNG_YN1 = DATAMANAGER.GetDataValue( 0, "oblon_basc_801r", "OutBlock2", "UI_PROD_OPNG_YN1" , 0 ) '담보관련통보방법 SMS
		sUI_PROD_OPNG_YN2 = DATAMANAGER.GetDataValue( 0, "oblon_basc_801r", "OutBlock2", "UI_PROD_OPNG_YN2" , 0 ) '담보관련통보방법 E-mail
		
		szLoanData = sUI_PROD_OPNG_YN1.."★"..sUI_PROD_OPNG_YN2
		
		Dim nCnt 
		nCnt = DATAMANAGER.GetDataCount( 0, "oblon_basc_801r", "OutBlock1" )
		
		if nCnt > 0 then
			Dim CANC_YN, LIMT_AMT, REG_DATE
			for i = 0 to nCnt-1
				CANC_YN = DATAMANAGER.GetDataValue( 0, "oblon_basc_801r", "OutBlock1", "CANC_YN" , i ) '해지여부 0번째 인덱스 증권담보융자 / 1번쨰 인덱스 매도담보융자
				' 값이 "" or "Y"면 미등록, 나머지는 등록
				LIMT_AMT = trim(DATAMANAGER.GetDataValue( 0, "oblon_basc_801r", "OutBlock1", "LIMT_AMT" , i ) )'약정금액 매도담보융자는 약정금액없음
				REG_DATE = DATAMANAGER.GetDataValue( 0, "oblon_basc_801r", "OutBlock1", "REG_DATE" , i ) '약정일자
				
				szLoanData = szLoanData.."★"..CANC_YN.."☆"..LIMT_AMT.."☆"..REG_DATE
				
			next
		end if
		
		'LHR 수정
		Dim szCustClsCode
		szCustClsCode = DATAMANAGER.GetDataValue(0, "oblon_basc_801r", "OutBlock2", "CUST_CLS_CODE", 0)
		Dim szSendData
		szSendData = left(Account0.caption,8)..g_szASNO.."★"..EditPW.caption.."★"..szLoanData.."★"..szCustClsCode.."★"..szFnprJoinSrno
		
		Form.triggerEvent("lnkSub", "InitData", szSendData)
		
		lnkSub.visible = "1"
		lblErrorText.visible = "0"
		btnError.visible = "0"
		
		DATAMANAGER.RequestTranData( "obcsb_acad_002r" ) '연락처조회	
		
	elseif szTranID == "obcsb_acad_002r" then		
		Dim nCnt 
		
		nCnt = tonumber(DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock1" )	)	
		if nCnt > 0 then
			for i = 0 to nCnt-1
				Dim sINAG_TYPE_CODE
				Dim sEMAIL_ADDR
				Dim szSRNO
				
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_TYPE_CODE" , i )	
				if sINAG_TYPE_CODE == "21" then 'E-mail
					sEMAIL_ADDR = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "EMAIL_ADDR" , i )	
					szSRNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_SRNO" , i )	
					Form.triggerEvent("lnkSub", "SetEmailInfo", sEMAIL_ADDR.."★"..szSRNO)
					Exit for '첫번째껄 세팅후 out
				end if
			next
		end if
		
		g_szCustClsCode = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock5", "CUST_CLS_CODE" , 0 )
		If g_szCustClsCode = "2" Then '법인
			'DATAMANAGER.RequestTranData( "obaci_acct_095r" ) '법인연락처조회	     
			'DATAMANAGER.RequestTranData("obacp_comm_007r")	'HTS 고객연락처조회
			DATAMANAGER.RequestTranData("obcsb_acad_120r")	'HTS 고객연락처조회 
		else
			'개인
			Dim nCnt
			nCnt = tonumber(DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock3" )	)	
			if nCnt > 0 then
				for i = 0 to nCnt-1
					Dim  sINAG_TYPE_CODE
					Dim szSRNO
					
					sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_TYPE_CODE" , i )	
					
					if sINAG_TYPE_CODE == "13" then '휴대폰번호
						Dim sARCD
						Dim sTONO
						Dim sTELNO
						
						sARCD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
						sTONO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
						sTELNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
						szSRNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_SRNO" , i )	

						Form.triggerEvent("lnkSub", "SetPhoneInfo", sARCD&"-"&sTONO&"-"&sTELNO.."★"..szSRNO)
						
						Exit for '첫번째껄 세팅후 out - 박정숙과장이 seq=1인걸 세팅해달라 함.
					end if
				next
			end if	
		end if
		
	     
	'20160811 법인통보처TR추가에 따른 처리 추가
	elseif szTranID == "obaci_acct_095r" then	 	     
		Dim nCnt 
		nCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock2" )		)
		if nCnt > 0 then
			for i = 0 to nCnt-1
				Dim sINAG_TYPE_CODE
				Dim szSRNO
				
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "INAG_TYPE_CODE" , i )
				
				if sINAG_TYPE_CODE == "13" then '휴대폰번호
					Dim sCustTelNo
					sCustTelNo = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "UI_CUST_TELNO" , i )	
					szSRNO = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "INAG_SRNO" , i )	
					Form.triggerEvent("lnkSub", "SetPhoneInfo", sCustTelNo.."★"..szSRNO)
					
					Exit for '박정숙과장요청. #22007 법인계좌 통보처 관리에 등록된 휴대폰 번호
				end if
			next
		end if
	'20160811 법인통보처TR추가에 따른 처리 추가
	elseif szTranID == "obcsb_acad_120r" then
		Dim sCustTelNo
		Dim szSrno
		
		tmpArcd = DATAMANAGER.GetDataValue(0, "obcsb_acad_120r", "OutBlock1", "CLPH_ARCD", 0)
		tmpTono = DATAMANAGER.GetDataValue(0, "obcsb_acad_120r", "OutBlock1", "CLPH_TONO", 0)
		tmpTelno = DATAMANAGER.GetDataValue(0, "obcsb_acad_120r", "OutBlock1", "CLPH_TELNO", 0)
		szSRNO = DATAMANAGER.GetDataValue(0, "obcsb_acad_120r", "OutBlock1", "UI_CLPH_CNPL_SRNO", 0)
		
		if trim(tmpArcd) <> "" or trim(tmpTono) <> "" or trim(tmpTelno) <> "" then
			sCustTelNO = tmpArcd.."-"..tmpTono.."-"..tmpTelno
		else
			sCustTelNo = ""
		end if
		
		Form.triggerEvent("lnkSub", "SetPhoneInfo", sCustTelNo.."★"..szSRNO)
'	elseif szTranID == "obacp_comm_007r" then
'		Dim sCustTelNo
'		Dim szSrno
'		
'		szSrno = ""
'		sCustTelNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "WHOL_CPNO", 0)
'		
'		Form.triggerEvent("lnkSub", "SetPhoneInfo", sCustTelNo.."★"..szSRNO)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg 
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	btnError.visible = "0"
	
	if trim(sSubMsg) ~= "" then
		sSubMsg = "("..sSubMsg..")"
		szErrMsg = szErrMsg.."\n"..sSubMsg
	end if
	
	if szTranID == "oblon_basc_810r" then
		Dim szAlertData
		
		if szErrCode == "8970" then			
			szAlertData = "1".."★".."담보대출약정 가능시간이 아닙니다.\n(가능시간 : 영업일 8시~17시)".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "8971" then	
			szAlertData = "2".."★".."외국인은 지점 또는 고객지원센터로\n문의주시기 바랍니다.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"
		elseif szErrCode == "8972" then	
			szAlertData = "1".."★".."약정 가능한 개별계좌가 없습니다.\n다른 계좌를 선택해주세요.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "8973" then	
			szAlertData = "1".."★".."담보대출약정이 불가능한 계좌입니다.\n계좌상태를 확인해주세요.\n"..sSubMsg.."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "8974" then	
			szAlertData = "1".."★".."담보대출약정이 불가능한 계좌입니다.\n다른 계좌를 선택해주세요.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "8975" then	
			szAlertData = "1".."★".."신용불량자는 담보대출약정이\n불가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "8976" then	
			szAlertData = "1".."★".."대출등급이 충족되지 않아\n담보대출약정이 불가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "7423" then	
			szAlertData = "2".."★".."반송계좌 보유 고객은\n담보대출약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"
		elseif szErrCode == "8978" then	
			szAlertData = "1".."★".."미성년자는 담보대출약정이\n불가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "8979" then	
			szAlertData = "1".."★".."비거주외국인은\n담보대출약정이 불가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "8980" then	
			szAlertData = "2".."★".."안전카드 분실/훼손 계좌는\n담보대출약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "8981" then	
			szAlertData = "2".."★".."OTP 분실/훼손 계좌는\n담보대출약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "8982" then	
			szAlertData = "2".."★".."카드 분실 계좌는\n담보대출약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "8983" then	
			szAlertData = "2".."★".."체크카드 분실/훼손 계좌는\n담보대출약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "8984" then	
			szAlertData = "2".."★".."인감 분실/훼손 계좌는\n담보대출약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "8985" then	
			szAlertData = "2".."★".."사망 계좌는\n담보대출약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "8986" then	
			szAlertData = "2".."★".."질권계좌 보유 고객은 계좌는\n담보대출약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "8987" then	
			szAlertData = "2".."★".."실명 미확인 계좌는\n담보대출약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "8988" then	
			szAlertData = "1".."★".."금융사기이용계좌는\n담보대출약정이 불가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "8989" then	
			szAlertData = "2".."★".."휴대폰 미등록 계좌는\n담보대출약정이 불가능합니다.\n휴대폰 정보 등록 후 이용해주세요.".."★"..szErrCode.."★".."확인".."★등록하기"
		elseif szErrCode == "8990" then	
			szAlertData = "1".."★".."등기임원 등록 계좌는\n담보대출약정이 불가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "8998" then
			szAlertData = "2".."★".."법적 지급 금지 계좌는\n담보대출약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "8967" then
			szAlertData = "1".."★".."통합증거금 약정 계좌는\n담보대출약정이 불가능합니다.\n다른 계좌를 선택해주세요.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "3245" then
			szAlertData = "1".."★".."장외파생전용계좌는\n신청이 불가합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		end if
		
		if trim(szAlertData) == "" then
			DIm szAlertData 
			szAlertData = "1".."★"..szErrMsg.."★"..szErrCode.."★".."확인".."★".."확인"
		
			Form.OpenPopup("mbonl82010_p6", szAlertData, "")
			
			lblErrorText.caption = szErrMsg
			lblErrorText.visible = "1"
			lnkSub.visible = "0"
		else
			Form.OpenPopup("mbonl82010_p6", szAlertData, "")
			
			Dim tMsg
			tMsg = Split(szAlertData, "★")		
			lblErrorText.caption = tMsg[1]
			lblErrorText.visible = "1"
			lnkSub.visible = "0"
			btnError.visible = "0"
			
			if trim(tMsg[4]) ~= "확인" then
				btnError.caption = tMsg[4]
				btnError.visible = "1"
				g_szMoveScreen = szErrCode
			end if
		end if	
	'v002
	elseif szTranID == "oblon_nice_001r" then
		DIm szAlertData 
		szAlertData = "1".."★"..szErrMsg.."★"..szErrCode.."★".."확인".."★".."확인"
	
		Form.OpenPopup("mbonl82010_p6", szAlertData, "")	
		
		lblErrorText.caption = szErrMsg
		lblErrorText.visible = "1"
		lnkSub.visible = "0"
		
		Form.SetTimerEvent(1, 0, 1)
		'Form.clearWaitCursor()
	'2021.03.17 대출KYC추가
	elseif szTranID == "oblon_basc_103r" then
		DIm szAlertData 
		szAlertData = "1".."★"..szErrMsg.."★"..szErrCode.."★".."확인".."★".."확인"
	
		Form.OpenPopup("mbonl82010_p6", szAlertData, "")	
		
		lblErrorText.caption = szErrMsg
		lblErrorText.visible = "1"
		lnkSub.visible = "0"
	else
		DIm szAlertData 
		szAlertData = "1".."★"..szErrMsg.."★"..szErrCode.."★".."확인".."★".."확인"
	
		Form.OpenPopup("mbonl82010_p6", szAlertData, "")
	end if
End Sub

'============================================================================
Sub btnError_OnClick()
	if g_szMoveScreen == "8971" or g_szMoveScreen == "7423" or g_szMoveScreen == "8980" or g_szMoveScreen == "8981" or g_szMoveScreen == "8982" or sKeyName == "8983" 
		   or g_szMoveScreen == "8984" or g_szMoveScreen == "8985" or g_szMoveScreen == "8986" or g_szMoveScreen == "8987" or g_szMoveScreen == "8998" then
		   
		'고객지원센터 이동
		Form.OpenScreen("89020" , "")
		
	elseif g_szMoveScreen == "8989" then
		
		'휴대폰정보 등록하기 이동
		'Form.OpenScreen("81000" , "")
		Form.OpenFramePopup("mbonl81000" , "" , "")
	
	elseif g_szMoveScreen == "93500" then
	
		'신용공여 이동
		Dim szData
		szData = setKycSharedData("mbonl93500")
		Form.OpenFramePopup("mbonl93500" , szData , "") '대출 KYC 설문 메인
		
	elseif g_szMoveScreen == "mbonl93503" then
		setKycSharedData("mbonl93503")
		Form.OpenPopup("mbonl93503" , "" , "") '대출 KYC 부적합 보고서
		
	end if 
	
End Sub

'============================================================================
Sub NICE_LN01_CALL()
	g_NICE_TR_CODE = "LN01"
	g_NICE_TR_SRNO = 0
	g_Timer_TRY_CNT = 0
	'Form.SetTimerEvent( 1, 1, 1 )
	DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock1", "SDRC_CLS_CODE", 0 , "1")
	DATAMANAGER.RequestTranData("oblon_nice_001r")
End Sub
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	'Form.ShowAlert("Form_OnTimerEvent" , sTimerID)
	if Cint(sTimerID) = 1 then
		g_Timer_TRY_CNT = g_Timer_TRY_CNT + 1
		if g_Timer_TRY_CNT > 6 then
			Form.SetTimerEvent(1, 0, 1)
			'Form.clearWaitCursor()
			
			DIm szAlertData
			Dim szErrMsg
			szErrMsg = "여신거래 안심차단 정보 조회 지연중입니다."
			szAlertData = "2".."★"..szErrMsg.."★".."LN01".."★".."확인".."★".."다시 조회"
		
			Form.OpenPopup("mbonl82010_p6", szAlertData, "")	
			
			lblErrorText.caption = szErrMsg
			lblErrorText.visible = "1"
			lnkSub.visible = "0"
		else
			DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock1", "SDRC_CLS_CODE", 0, "2")
			DATAMANAGER.SetDataValue(0, "oblon_nice_001r", "InBlock2", "SDRC_SRNO"	 , 0 , g_NICE_TR_SRNO)
			DATAMANAGER.RequestTranData("oblon_nice_001r")
		end if
	end if
End Sub

