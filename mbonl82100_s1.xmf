Sub Account0_ChangeAccount()
'	Form.ShowAlert("Account0_ChangeAccount", Account0.caption)
	if trim(g_szChangeData) ~= "" then
		g_szChangeData = ""
		DATAMANAGER.RequestTranData("oblon_basc_103r")
	else
		DATAMANAGER.RequestTranData("obacp_opop_065r")
	end if
End Sub

