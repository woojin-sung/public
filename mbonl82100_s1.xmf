'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 신용거래약정
' 02. 화면설명 : 신용거래약정
' 03. 작    성 : 2022.09.04 이아영
' 04. 수    정 : v001.이학록.담보대출 계좌변경시 oblon_basc_810r을 호출하면서 이미 약정이 존재한다고 처리하여 업무처리가 불가한 현상 수정.
'              : v002.이학록.금융거래안심차단 서비스 내용 추가
'-------------------------------------------------------------------------------------------
' 2.oblon_basc_810r 약정가능여부 조회 신규 추가
' 3.oblon_basc_103r 대출kyc
' 4.oblon_basc_801r 약정등록조회
' 5.obcsb_acad_002r 연락처 조회 -> 법인이라면 obaci_acct_095r 연락처조회 추가
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szChangeData
Dim g_szAnxtAprt_Yn '부적정여부 (Y,N)
Dim g_szASNO
DIm g_szMoveScreen
Dim g_szCustClsCode
Dim g_szCsnm
'v001
Dim g_szCustNum
Dim szFnprJoinSrno
'v002
Dim g_NICE_TR_CODE
Dim g_NICE_TR_SRNO
Dim g_Timer_TRY_CNT 
Dim g_PROS_CLS'1.조회 2.처리
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "Init" then
		g_szASNO = ""
		
		if trim(sParam) ~= "" then
			Dim tParamData
			tParamData = Split(sParam, "★")
			g_szASNO = Right(tParamData[0],2)
			szFnprJoinSrno = tParamData[1]

'			Form.ShowAlert(g_szASNO, sParam)
		end if
		
		lnkSub.linkfile = "mbonl82100_s2"
		
		g_szCustNum = Form.GetSharedData("&CUST_NUM", false)
		DATAMANAGER.RequestTranData("oblon_basc_810r")
	elseif sEventName  == "InitChange" then
		if trim(sParam) ~= "" then
			g_szASNO = ""
			
			lnkSub.linkfile = "mbonl82100_s2"
			Dim tParamData
			tParamData = Split(sParam, "★")
			
'			DIm nActIndex
'			for i = 0 to CInt(Account0.accountcount) - 1
'				Dim szTmpAct
'				szTmpAct = Account0.GetAccountByIndex( i )
'				
'				if szTmpAct == tParamData[0] then
'					nActIndex = i
'				end	
'			next
			
'			Account0.currentindex = nActIndex
'			Form.ShowAlert("accpunt", tParamData[0])
						
			g_szASNO = Right(tParamData[0],2)			
			g_szChangeData = tParamData[1]
			Account0.caption = Left(tParamData[0], 8)
			g_szCustNum = Form.GetSharedData("&CUST_NUM", false)
			szFnprJoinSrno = tParamData[6]

		end if
		
	elseif sEventName == "CORRECT_PWD" then
		if nil ~= sParam and "" ~= sParam then
			EditPW.encdata = sParam
		end if
		
	elseif sEventName == "NextView" then
		if trim(sParam) ~= "" then
			Form.OpenPopup("mbonl82100_p2" , sParam , "")
			
		end if
	end if 
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "CORRECT_PWD" then
		if nil ~= sRet and "" ~= sRet then
			Dim tPwd
			tPwd = Split(sRet, "★") '"nPwdLen★sEncPwd(암호화된 비밀번호)"
			 
			if UBOUND(tPwd) > 0 then
				EditPW.pwdlen = tPwd(1)
				EditPW.caption = tPwd(0)
			end if
			
			Dim szSendData
			szSendData = left(Account0.caption,8).."☆"..EditPW.caption
			Form.triggerEvent("lnkSub", "PwdComplete", szSendData)
		end if
		
	elseif sKeyName == "mbonl82100_p2" then
		Form.triggerEvent("#", "End", "")
	
	elseif sKeyName == "kyc" then
		if sRet == "Right" then
			Dim szData
			szData = setKycSharedData("mbonl93500")
			Form.OpenFramePopup("mbonl93500" , szData , "") '대출 KYC 설문 메인
		end if 
		
	elseif sKeyName == "kyc_report" then
		if sRet == "Right" then
			setKycSharedData("mbonl93503")
			Form.OpenPopup("mbonl93503" , "" , "") '대출 KYC 부적합 보고서
		end if
		
	elseif sKeyName = "mbonl93500" Then
		g_szAnxtAprt_Yn = sRet	'부적정여부
		if g_szAnxtAprt_Yn = "N" then	'부적정여부 리턴: 적정			
		    Dim szAlertData
			szAlertData = "1".."★".."부적정여부 : [적정]. 계속 진행하세요".."★".."kyc_check".."★".."확인".."★".."확인"
			Form.OpenPopup("mbonl82010_p6", szAlertData, "")
			
		elseif g_szAnxtAprt_Yn = "Y" then	'부적정여부 리턴: 부적정
			Dim szAlertData
			szAlertData = "1".."★".."부적정여부 : [부적정]".."★".."kyc_check".."★".."확인".."★".."확인"
			Form.OpenPopup("mbonl82010_p6", szAlertData, "")
		end If
		
		DATAMANAGER.RequestTranData("oblon_basc_103r")
		
	elseif sKeyName == "8971" or sKeyName == "7423" or sKeyName == "8980" or sKeyName == "8981" or sKeyName == "8982" or sKeyName == "8983" 
		   or sKeyName == "8984" or sKeyName == "8985" or sKeyName == "8986" or sKeyName == "8987" or sKeyName == "8998" then
		   
		'고객지원센터 이동
		if sRet == "Right" then
			Form.OpenScreen("89020" , "")
		end if 
		
	elseif sKeyName == "8989" then
		
		'휴대폰정보 등록하기 이동
		if sRet == "Right" then
			'Form.OpenScreen("81000" , "")
			Form.OpenFramePopup("mbonl81000" , "" , "")
		end if 
		
	'부적정보고서 리턴
	elseif sKeyName = "mbonl93503" Then
		'대출_고객정보 확인서 징구 여부 관련 조회로 처음부터 체크한다. 
		DATAMANAGER.RequestTranData("oblon_basc_103r")
	elseif sKeyName = "mbonl81000" then
		if sRet == "ok" then
			'DATAMANAGER.RequestTranData( "obcsb_acad_002r" ) '연락처조회
			DATAMANAGER.RequestTranData( "oblon_basc_810r" )
		end if
	'v002
	elseif sKeyName == "LN01" then
		if sRet == "Right"then
			g_PROS_CLS = "1"
			NICE_LN01_CALL()
		end if
	end if
End Sub


'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'2021.03.17 : 대출KYC
	if sKeyName == "kyc" then
		if sRet == "ok" then			
			szData = setKycSharedData("mbonl93500")
			Form.OpenFramePopup("mbonl93500" , szData , "") '대출 KYC 설문 메인
		End if
	'적정성 여부 확인 MsgBox
	elseif sKeyName == "kyc_check" then	'적정성 여부 확인
		'확인
		if g_szAnxtAprt_Yn = "Y" Then	'부적정
			DATAMANAGER.RequestTranData("oblon_basc_103r")
		end if
	elseif sKeyName == "kyc_report" then
		if sRet == "ok" then
			setKycSharedData("mbonl93503")
			Form.OpenPopup("mbonl93503" , "" , "") '대출 KYC 부적합 보고서
		end if
		
	end if
End Sub

'============================================================================
' setKycSharedData : 파일 오픈 공유데이터 설정 : 대출KYC : 2021.03.17
'============================================================================
Function setKycSharedData(fileName)
	Dim szCsnm
	Dim szClsCd 
	
	'MTS 메모리평문 적용유무 (0:미적용 / 1:적용)
	szPlainRm = Form.GetSharedData("&PLAIN_RM", false)
	
	'MTS 메모리평문 적용
	if szPlainRm = "1" Then
		szPwd = Form.GetCtlProp( "EditPW", "caption" )	'비밀번호
	'MTS메모리평문 미적용
	else
		szPwd = Form.GetCtlProp( "EditPW", "encdata" )
	end if
	
	'대출 KYC MTS_메인
	if fileName = "mbonl93500" Then
		szAcno = Left(Account0.caption, 8)        '계좌번호
		if g_szCsnm ~= null and g_szCsnm ~= "" then
			szCsnm = g_szCsnm			    	'고객명
		else
			szCsnm = ""
		end if 
		
		if g_szCustClsCode ~= null and g_szCustClsCode ~= "" then
			szClsCd = g_szCustClsCode			    	'개인법인구분
		else
			szClsCd = ""
		end if 
		
		szLoanTypeCode = "02"	
		g_szData = szAcno & "||" & szPwd & "||" & szCsnm & "||" & szClsCd & "||" & szLoanTypeCode
		  
	'대출성 상품 적정성 판단 보고서(MTS)
	elseif fileName = "mbonl93503" Then	
		'보고서는 Shared Memory로 통신한다.
		szAcno = Left(Account0.caption, 8)        '계좌번호
		if g_szCsnm ~= null and g_szCsnm ~= "" then
			szCsnm = g_szCsnm			    	'고객명
		else
			szCsnm = ""
		end if 
		szBswrdivcode = "16001"		'해외주식 대출약정'
		szLoanTypeCode = "02"	'
		Form.SetSharedData( "mbonl93503_acno" 	  		, szAcno )
		Form.SetSharedData( "mbonl93503_acnopwd" 		, szPwd )
		Form.SetSharedData( "mbonl93503_csnm"             , szCsnm )
		Form.SetSharedData( "mbonl93503_loan_type_code"   , szLoanTypeCode )
		Form.SetSharedData( "mbonl93503_bswr_div_code"    , szBswrdivcode )
		Form.SetSharedData( "mbonl93503_cont_cls_code"    , "4" )
	end if

	return g_szData
End Function

