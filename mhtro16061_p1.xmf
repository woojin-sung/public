'============================================================================
Sub btnOK_OnClick()
	Form.SaveConfigData("mhtro16061", "mhtro16061_p1", chk0.checkstate )
	Form.CloseForm()
	
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szPopup
	szPopup = Form.LoadConfigData( "mhtro16061", "mhtro16061_p1" )
	
	If szPopup == "1" Then
		chk0.checkstate = "1"
	End If
End Sub

