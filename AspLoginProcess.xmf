<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO formclass="InfoMaxLoginView" scrno="9999" scrname="연합인포맥스 로그인 Process" version="2" writer="임성수" />
	<FORM_INFO name="Form" transmode="0" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO/>
	<SCRIPT_INFO _len="11881" _ulen="10611" >
'============================================================================
' 2017.10.16 -  LSS
' 연합인포맥스 로그인 프로세스 화면
'
' 1. 화면상의 모든 DEFINE 은 initDefine() 함수에서 처리 함.
' 2. DLL은 항상 triggerEvent를 전달받아서 처리
' 3. 기본적으로 동작은 버전처리로 처리할 수 있도록 화면단에서 처리
' 4. 처리가 완료 되면 무조건 Form.CloseForm()
'
' 2017.10.23 - LSS
' 1. 화면번호 전달받아 로그인 완료 후 화면이동 처리
' 2. 로그아웃 시 시작화면으로 화면이동 처리
'============================================================================

Dim g_tblDefine
'============================================================================
Sub Form_OnFormInit()
	initDefine()
	initDefault()
End Sub

'============================================================================
Sub Form_OnFormClose()
	if g_tblDefine.isPost then
		Form.PostLinkData( g_tblDefine[ "refreshExtra" ], "1" )
		
		if( not isNull( g_tblDefine.szOpenScreen ) ) then
			Form.OpenScreen( g_tblDefine.szOpenScreen, "" )
		end if
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if g_tblDefine[ "dupLogin" ] == sKeyName then
		' 강제 로그인 요청
		if "ok" == sRet then
			Form.triggerEvent( "", g_tblDefine[ "runLogin" ], "1" )
		else
			Form.CloseForm()
		end if
	end if
End Sub

'----------------------------------------------------------------------------
' 2017.10.16 - LSS
' 데이터 함수
'----------------------------------------------------------------------------
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szMsgCode, szMessage
	
	szMsgCode = DATAMANAGER.GetDataMsgCode( szTranID )
	szMessage = DATAMANAGER.GetDataMsgText( szTranID )
	
	if g_tblDefine[ "TRAN_LOGIN" ] == szTranID then
		Dim bComplete, nHistoryCount, szItemInfo, nState
		' 앱 기동 후 히스토리도 없고 연결정보도 존재하지 않으면 최초 종목정보를 얻어오자.
		nHistoryCount = Form.GetRecentHistoryIMaxCount()
		szItemInfo = Form.GetSharedData( g_tblDefine["LINKDATA"] , false )	
	
		' 연결정보가 존재하지 않으나 히스토리가 있으면 히스토리로 설정( 연결정보 없는 경우는 앱 기동시 화면에 첫진입 할 때뿐임. )
		if isNull( szItemInfo ) and nHistoryCount > 0 then
			szItemInfo = Form.GetRecentHistoryIMax( nHistoryCount-1 )
			Form.SetSharedData( g_tblDefine["LINKDATA"], szItemInfo )			
		end if
		
		bComplete = ( nHistoryCount > 0 or ( not isNull( szItemInfo ) ) ) and true or false		
		nState = recvLoginState(bComplete)
		
		' 주의 : 종목에 대한 정보들은 시세권한이 설정 된 후에 보내야 한다.
		if nState == 0 then
			if not bComplete then
				reqItemInfo()
			else
				Form.CloseForm()
			end if
		elseif nState == 1 then
			Form.CloseForm()
		end if
		
	elseif g_tblDefine[ "TRAN_LOGOFF" ] == szTranID then
		Dim tErrMsg, szState
		
		g_tblDefine.isPost = false
		tErrMsg = {
			["0"] = "정상적으로 로그아웃 되었습니다.",
			["1"] = "시스템 작업 중으로 로그아웃 실패하였습니다.",
			["2"] = "존재하지 않는 아이디로 로그아웃 실패하였습니다."
		}
		
		szState = Trim( DATAMANAGER.GetDataValue( false, szTranID , "itemInfo" , "stat", 0 ) )
		Form.postTriggerEvent( "", g_tblDefine["recvLogoff"], szState )
		
		if "0" == szState then
			g_tblDefine.isPost = true
			' 로그아웃 시 로그인 상태 플래그 초기화
			Form.GetSharedData( g_tblDefine[ "IS_LOGIN" ], true )
			' 로그아웃 시 시세권한 초기화
			Form.GetSharedData( g_tblDefine[ "AUTH" ], true )
			
			if not g_tblDefine.isTerminate then
				' 로그아웃 시 시작화면으로 이동
				Form.SendMessageToMain( g_tblDefine[ "OPEN_START" ], "1", "")
			end if
		end if
		
		' 앱 종료 시에는 경고창이 뜨지 않도록 처리
		if not g_tblDefine.isTerminate then
			Form.ShowAlert( "알림", tErrMsg[szState] )
		end if
		
		Form.CloseForm()
		
	' 종목정보 수신 
	elseif g_tblDefine["TRAN_ITEMINFO"] == szTranID then
		Dim szItemCode
		szItemCode = DATAMANAGER.GetDataValue( false, szTranID , "itemList", "code" , 0 )
		
		reqItemDetail(szItemCode)
	
	' 종목 상세정보 수신
	elseif g_tblDefine["TRAN_ITEMDETAIL"] == szTranID then
		recvItemDetailInfo( szTranID )
		Form.CloseForm()
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert( "알림", "[" & szErrCode & "] " & szErrMsg  )
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnRequestTranTimeout(szTranID)
	Form.CloseForm()
End Sub

'============================================================================
'해외주식 종목검색 조회
'============================================================================
Sub reqItemInfo()
	Dim tData
	tData = {
		["exid"] = getInstrumnet(),
		["instrument"] = "0",
	}
	
	DATAMANAGER.ClearInputData( false, g_tblDefine["TRAN_ITEMINFO"] )
	For key, val in pairs( tData )
		DATAMANAGER.SetDataValue( false, g_tblDefine["TRAN_ITEMINFO"], "inblock", key , 0 , val )
	Next
	DATAMANAGER.RequestTranData( g_tblDefine["TRAN_ITEMINFO"] )
		
End Sub

'============================================================================
'해외주식 종목상세 조회
'============================================================================
Sub reqItemDetail(szItemValue)
	DATAMANAGER.SetDataValue( false, g_tblDefine["TRAN_ITEMDETAIL"], "inblock", "code" , 0 , szItemValue )
	DATAMANAGER.RequestTranData( g_tblDefine["TRAN_ITEMDETAIL"] )
	
End Sub

'============================================================================
'해외주식 종목상세 수신
'============================================================================
Sub recvItemDetailInfo(szTranID)
	Dim szItemCode, szItemName, szOrderState, sParams
		
	szItemCode = DATAMANAGER.GetDataValue( false, szTranID , "price" , "code" , 0 )
	szItemName = DATAMANAGER.GetDataValue( false, szTranID , "price" , "korname" , 0 )
	szOrderState = DATAMANAGER.GetDataValue( false, szTranID , "price" , "subx" , 0 )
	
	sParams = szItemCode & g_tblDefine["SPLIT"] & szItemName & g_tblDefine["SPLIT"] & szOrderState
	
	Form.SetSharedData( g_tblDefine["LINKDATA"] , sParams )
End Sub

'============================================================================
' 로그인 정보 수신
'============================================================================
Sub recvLoginState(isClose)
	Dim tErrMsg, szState, szAuth, nResult

	g_tblDefine.isPost = false
	tErrMsg = {
		["1"] = "시스템 작업중입니다.",
		["2"] = "존재하지 않는 아이디입니다.",
		["3"] = "일치하지 않는 비밀번호입니다.",
		["4"] = "비밀번호 오류횟수가 초과되었습니다.",
		["5"] = "중복접속중입니다.\n다른 단말기에 접속된 아이디를 종료하고 접속하시겠습니까?",
		["6"] = "로그인 오류.",
		["8"] = "사용자 인증 오류가 발생하였습니다.",
	}
	
	'0:로그인정상 1:시스템작업중 2:고객ID없음 3:비밀번호불일치 4:비밀번호 오류횟수 초과 5:중복접속 6:hash키없음 7:강제업데이트 8:사용자인증오류
	szState = Trim( DATAMANAGER.GetDataValue( false, g_tblDefine[ "TRAN_LOGIN" ] , "itemInfo" , "stat", 0 ) )
	szAuth = Trim( DATAMANAGER.GetDataValue( false, g_tblDefine[ "TRAN_LOGIN" ] , "itemInfo" , "auth", 0 ) )
	nResult = false
	
	Dim szGetUuid, szSetUuid
	
	szGetUuid = Trim( DATAMANAGER.GetDataValue( false, g_tblDefine[ "TRAN_LOGIN" ] , "itemInfo" , "uuid", 0 ) )
	szSetUuid = Trim( DATAMANAGER.GetDataValue( false, g_tblDefine[ "TRAN_LOGIN" ] , "query" , "uuid", 0 ) )
	
	Form.postTriggerEvent( "", g_tblDefine["recvLogin"], szState )
	
	Select Case szState
	Case "0"	
		g_tblDefine.isPost = true			
		Form.SetSharedData( g_tblDefine[ "RELOGIN" ] , "0" )
		Form.SetSharedData( g_tblDefine[ "AUTH" ] , szAuth )
		nResult = 0
		
	Case "1", "2", "3", "4", "6", "8"
		Form.ShowAlert( "알림", tErrMsg[szState] )
		nResult = 1
		
	Case "5"
		nResult = 2
		if szGetUuid == szSetUuid then
			Form.TriggerEvent( "", g_tblDefine[ "runLogin" ], "1" )	
		else
			Form.MsgBox( "알림", tErrMsg[szState], g_tblDefine["dupLogin"], 5 )
			Exit Sub
		end if
		
	Case "7"
		Form.RunSmartMeritzAct()
		nResult = 1
		
	Case Else
		Form.ShowAlert( "알림", "로그인을 할 수 없습니다." )
		nResult = 1
		
	End Select
	
'	if isClose and bResult == true then	' 2018.03.05.
'		Form.CloseForm()
'	end if
	
	return nResult
End Sub

'----------------------------------------------------------------------------
' 2017.10.16 - LSS
' 사용자 함수
'----------------------------------------------------------------------------
'============================================================================
' 기본 설정된 정보들 설정
'============================================================================
Sub initDefine()
	g_tblDefine = {
		["SPLIT"] = "★",		
		'메시지
		[ "OPEN_START" ] = "OPEN_START_SCREEN",		
		'로그인 이벤트
		[ "runLogin" ] = "RUN_INFOMAX_LOGIN",
		[ "runLogoff" ] = "RUN_INFOMAX_LOGOFF",
		[ "recvLogin" ] = "RECEIVE_INFOMAX_LOGIN",
		[ "recvLogoff" ] = "RECEIVE_INFOMAX_LOGOFF",
		' TR명
		[ "TRAN_LOGIN" ] = "gtsLogin",
		[ "TRAN_LOGOFF" ] = "gtsLogoff",
		[ "TRAN_ITEMINFO" ] = "getGtsItemInfoList",
		[ "TRAN_ITEMDETAIL" ] = "getGtsHogaDetail",
		' 연결정보
		[ "LINKDATA" ] = "&ITEM_OVERSTOCK",
		' 종목정보
		[ "PAGE_ID" ] = "item.search.pageid",
		'반환 이벤트
		[ "dupLogin" ] = "DUPLICATE_LOGIN",
		[ "refreshExtra" ] = "REFRESH_EXTRA_VIEW",
		' 연결정보
		[ "RELOGIN" ] = "RUN_INFOMAX_RELOGIN",
		[ "AUTH" ] = "&AUTH_INFOMAX",
		[ "IS_LOGIN" ] = "&IS_LOGIN_INFOMAX"
	}
	
	g_tblDefine.szType = ""
	g_tblDefine.isTerminate = false
	
	g_tblDefine.isPost = false
	g_tblDefine.szOpenScreen = ""
End Sub

'============================================================================
' 기본 정보 및 컨트롤 설정
'============================================================================
Function initDefault()
	Dim tData, isReLogin, szEventName, szRevData
	
	szRevData = Form.GetOpenLinkData()
	if isNull( szRevData ) then
		Exit Function
	end if
	
	tData = Split( szRevData, g_tblDefine["SPLIT"] )
		
	if #tData >= 1 then
		g_tblDefine.szType = tData[0]
		
		isReLogin = Form.GetSharedData( g_tblDefine[ "RELOGIN" ], false ) == "1" and true or false
		if isReLogin then
			g_tblDefine.szType = "1"
		end if
	end if
	
	if #tData >= 4 then
		g_tblDefine.szOpenScreen = tData[3]
	end if
	
	if #tData >= 5 then
		g_tblDefine.isTerminate = tData[4] == "1" and true or false
	end if
	
	szEventName = g_tblDefine[ "runLogin" ]
	if "4" == g_tblDefine.szType then
		szEventName = g_tblDefine[ "runLogoff" ]
	end if
	
	Form.triggerEvent( "", szEventName, g_tblDefine.szType )
	
End Function


'============================================================================
' 시장구분 반환
'============================================================================
Function getInstrumnet()
	Dim szPageID
	szPageID = Form.GetEnvData( g_tblDefine["PAGE_ID"] )

	Select Case szPageID
	Case "page2"
		return "CNY"
		
	Case "page3"
		return "USA"
		
	Case Else
		return "HKS"
		
	End Select
	
End Function

'============================================================================
' null 체크
'============================================================================
Function isNull(str)
	if null == str or "" == str or Len(Trim(str)) <= 0 then
		return true
	end if
	
	return false
End Function

