	<SCRIPT_INFO _len="22015" _ulen="20199" >
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_nCount
g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
Dim g_szOrder_Acc			' 계좌번호
Dim g_szOrder_AccName		' 고객명
Dim g_szOrd_ItmCode		' 종목코드
Dim g_szOrd_ItmName		' 종목명
Dim g_szOrd_OrdType		' 주문구분
Dim g_szOrd_Security		' 현금/대출
Dim g_nOrd_Qty			' 주문수량
Dim g_nOrd_Price			' 주문가격
Dim g_nOrd_OrdNo			' 원주문번호
Dim g_nOrd_ChkAll			' 잔량전부	
Dim g_nOrd_Decimal		' 가격자릿수
Dim g_nOrd_Currency		' 통화기호
Dim g_szOrd_PrcName		' 시장가/지정가

Dim g_nOrd_LoanType		' 대출구분
Dim g_szOrd_LoanDate		' 대출일자
Dim g_szOrd_LoanSrno		' 대출일련번호

Dim g_nOrd_res_Type 		' 예약주문유형
Dim g_nOrd_res_Period		' 예약주문기간	
Dim g_nOrd_res_Time		' 예약주문시간

Dim g_OsType

'============================================================================
Sub Form_OnFormInitBefore()

	g_OsType = Form.GetSharedData("&OS_TYPE", false)

	'-----------------------------------------------------------
	' 컨트롤 설정
	'-----------------------------------------------------------
	imgInfo.setMaintainingRatio("1")
	
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	'-----------------------------------------------------------
	' 공통(일반/예약주문)
	'-----------------------------------------------------------
	g_nIndex				= arrData( 0) ' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소, 10:예약매수, 11:예약매도, 12:예약취소)
	g_szOrder_Acc			= arrData( 1)	' 계좌번호
	g_szOrder_AccName		= arrData( 2)	' 고객명
	g_szOrd_ItmCode 		= arrData( 3)	' 종목코드
	g_szOrd_ItmName 		= arrData( 4)	' 종목명
	g_szOrd_OrdType  		= arrData( 5)	' 주문구분
	g_szOrd_Security 		= arrData( 6)	' 현금/대출구분 (0:현금/1:대출)
	g_nOrd_Qty   			= arrData( 7)	' 주문수량
	g_nOrd_Price 			= arrData( 8)	' 주문가격
	g_nOrd_OrdNo 			= arrData( 9)	' 원주문번호
	g_nOrd_ChkAll 		= arrData(10)	' 잔량전부
	g_nOrd_Decimal		= arrData(11)	' 가격자릿수
	g_nOrd_Currency		= arrData(12)	' 통화
	g_szOrd_PrcName		= arrData(13)	' 시장가or지정가
	
	'대출일경우
	if g_szOrd_Security == "1" then
		g_nOrd_LoanType		= arrData(14)	' 대출구분
		g_szOrd_LoanDate		= arrData(15)	' 대출일자
		g_szOrd_LoanSrno		= arrData(16)	' 대출일련번호
	end if
	
	'-----------------------------------------------------------
	' 예약주문(주문유형,주문시간 문구추가)
	'-----------------------------------------------------------
	if g_nIndex == "11" then
		
'		'대출일경우
'		if g_szOrd_Security == "1" then
	
			g_nOrd_res_Type 	= arrData(17) '예약주문유형
			g_nOrd_res_Period	= arrData(18) '예약주문기간
			g_nOrd_res_Time 	= arrData(19) '예약주문시간
		
'		'현금일경우
'		else
'			g_nOrd_res_Type 	= arrData(14) '예약주문유형
'			g_nOrd_res_Period	= arrData(15) '예약주문기간
'			g_nOrd_res_Time 	= arrData(16) '예약주문시간
'		end if
		
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()

    Set_Data(g_nIndex)
    
End Sub

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)

    If g_nOrd_ChkAll = "1" Then
		g_nOrd_Price = "잔량"
    End If
    
    '===========================================================
    ' 예약주문(주문유형,주문시간 문구추가)
    '===========================================================
    if nIndex == "11" then
		'-----------------------------------------------------------
		' 큰글씨 모드에 따른 컨트롤 위치이동
		'-----------------------------------------------------------
		szTextSize = Form.GetEnvData("common.textsize")
		if CInt(szTextSize) > 0 then
			if g_szOrd_Security == "1" then
				Label0.left = 70
				Label0.width = 135
				lblMaesu1Title.left = 195
			end if
			
			if g_OsType == "1" then
				imgInfo.left = 105
				imgInfo.top = 547
			else
				imgInfo.left = 105
				imgInfo.top = 543
			end if
		
		else
			if g_szOrd_Security == "1" then
				Label0.left = 85
				Label0.width = 120
				lblMaesu1Title.left = 195
			end if
			
			if g_OsType == "1" then
				imgInfo.top = 548
			else
				imgInfo.top = 544
			end if
		
		end if
	    
	    '===========================================================
	    ' 예약 대출
	    '===========================================================
	    if g_szOrd_Security == "1" then
		    
		    '-----------------------------------------------------------
			' 일반주문 : (현금)숨김처리 / (대출) 숨김처리
			' 예약주문 : (현금)숨김처리 / (대출) 보임처리
			'-----------------------------------------------------------
			
			imgMain.top = 175
			imgMain.height = 562
			
			Image0.top = 269
			Image0.height = 307
			
			Label0.top = 179
