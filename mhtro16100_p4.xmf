'============================================================================
Function SendOrder()
    
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문전송" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
	    
    End If
    
End Function
'============================================================================
Sub btnMaesu1Close_OnClick()
	Form.CloseForm()	
End Sub
'============================================================================
Sub btnMaesu1_OnClick()
	SendOrder()
End Sub
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub imgInfo_OnClick()
	sText = "수수료 및 세금이 제외된 금액입니다.\n체결 후 해외손익 화면에서 수수료 및 세금을 확인 할 수 있어요."
	imgInfo.openToolTip(sText, 300, 80, 0)
End Sub

