	<SCRIPT_INFO _len="2524" _ulen="2322" >
Dim g_nFontSize,g_szTitle,g_szDate,g_szURL	
Dim g_sDeviceOS, g_serverMode
Dim g_nIndex
Dim g_serverURL
'============================================================================
Sub Form_OnFormInit()
	'웹 캐시삭제
	WebView0.RemoveCache()
	
	g_serverMode = Form.GetSharedData("&SERVER_MODE", false)
	If g_serverMode == "1" Then	'개발기
		g_serverURL = "https://testhome.imeritz.com"
	else
		g_serverURL = "https://home.imeritz.com"
	end if
	
	'기본url: szBbsId, szCntNo 바꿔주기
	szDetailUrl = "/bbs/BbsRead.go?bbsGrpId=bascGrp&bbsId=szBbsId_vm_mts&bbsCnttTurnNo=szCntNo&listCnt=10&pageNum=1&searchDiv=&searchText="
	
	Dim szData, arrData

	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	

	g_szTitle		= arrData(0)
	g_szDate			= arrData(1)
	g_szCnt			= CDbl(arrData(2))
	g_szCls			= CStr(arrData(3))	'fstock:공지사항, fstock2:권리사항
	
	Label0.caption = g_szTitle
	Label1.caption = g_szDate
	
	if g_szCls = "fstock" then
		FormTab0.currenttab = 0
		LabelTitle.caption = "해외주식 공지사항"
	elseif g_szCls = "fstock2" then
		LabelTitle.caption = "해외주식 권리사항"
		FormTab0.currenttab = 1
	else
		FormTab0.currenttab = 0
		call FormTab0_OnTabChanged(0)
		exit sub
	end if
	
	szDetailUrl = Replace(szDetailUrl, "szBbsId", g_szCls)
	szDetailUrl = Replace(szDetailUrl, "szCntNo", g_szCnt)
	g_szURL = g_serverURL..szDetailUrl
	
'	Form.ShowAlert("test", g_szURL)
	WebView0.urlpath = g_szURL
	
	g_sDeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS

	'모바일 웹에서 어떤 OS인지 판단할 수 있음(javascript 먼저 set해야함)
	if g_sDeviceOS == "1" then
		WebView0.SetUserAgent("meritz_android")
	elseif g_sDeviceOS == "2" then
		WebView0.SetUseJavaScript("1")
		WebView0.SetUserAgent("meritz_ios")
	else
	end if
	
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)

	'웹 캐시삭제
	WebView0.RemoveCache()
	
	if CInt(nCurrentTab) = 0 then	'해외주식 공지사항
		LabelTitle.caption = "해외주식 공지사항"
		WebView0.urlpath = g_serverURL & "/mobile/sub/mts_fstock.html"

	else							'해외주식 권리사항
		LabelTitle.caption = "해외주식 권리사항"
		WebView0.urlpath = g_serverURL & "/mobile/sub/mts_fstock2.html"
	end if
	
End Sub

