	<SCRIPT_INFO _len="26991" _ulen="22981" >
'============================================================================
' 01. 화 면 명 : 바이오인증 서비스
' 02. 화면설명 : 바이오인인증 서비스 메인
' 03. 작    성 : 2016.11.14  LES
' 2024.01.19 : 전상일 : v0001 : obcsb_fido_002a ui_cust_cont_cls_code 추가 (별도 맵핑 x)
' 2024.03.27 : 장원혁 : v0002 : 해지오류수정
'============================================================================
' 2018.08.16 : 길병철 
'   20180911_01 KBC : 바이오인증 인증방식 추가 및 스크립트 정리
'                     티켓온 적용 (PIN/손바닥)
'                     소스수정부분이 많아서 라인별로 달지 않았다.

'Form.isTouchIDSupported() 
'생체정보 단말등록여부 : 0.미등록 1.등록

'Form.GetKftcBioDeviceEnbl()	
'생체인증 단말지원여부
'   android : 0.불가단말 1.가능단말(지문가능) 2.가능단말(지문불가)
'   iOS : 0.불가단말 1.가능단말

'============================================================================

'----------------------------------------------------------------------------
'바이오인증 flow
'----------------------------------------------------------------------------

'FIDO 1.0 등록요청
'   (Bio_401 -> Bio_402) -> obtss_fido_001a -> 앱버전체크 -> (Bio_103 -> Bio_104) -> obtss_fido_002a -> (Bio_105 -> Bio_106) -> obcsb_fido_002a

'FIDO 1.0 해지요청
'   (Bio_401 -> Bio_402) -> obtss_fido_008a -> (Bio_121 -> Bio_122) -> obtss_fido_002a -> (Bio_105 -> Bio_106) -> obcsb_fido_002a

'FIDO 2.0 등록요청
'   (Bio_401 -> Bio_402) -> obtss_fido_011a -> (Bio_2103 -> Bio_2104) -> obtss_fido_012a -> obcsb_fido_002a

'FIDO 2.0 해지요청
'   (Bio_401 -> Bio_402) -> obtss_fido_015a -> (Bio_2121 -> Bio_2122) -> obtss_fido_016a -> obcsb_fido_002a

'FIDO 2.0 인증요청
'   (Bio_401 -> Bio_402) -> obtss_fido_013a -> (Bio_2115 -> Bio_2116) -> obtss_fido_014a -> obcsb_fido_002a

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_userID			'사용자 ID
Dim g_Ostype			'단말 OS 타입
Dim g_termID			'단말 ID
Dim g_type			'서비스 타입
Dim g_Csno			'고객번호
Dim g_Acno			'계좌번호
Dim g_deviceModel		'모델명
Dim g_gubun			'등록/해지 구분값
Dim g_complete
Dim g_sBIOAthnTchnCode	'인증기술코드
Dim g_sBioEnbl		'0.미지원 1.지원(지문가능) 2.지원(지문불가)
Dim g_sBioAppVersion	'설치된 연계앱 버전

'----------------------------------------------------------------------------
Dim DEF_BIO_FINGER
'Dim DEF_BIO_FACE
Dim DEF_BIO_PIN
Dim DEF_BIO_PALM

'g_sBIOAthnTchnCode에서 사용 (인증기술코드)
DEF_BIO_FINGER		= "100"	'지문
'DEF_BIO_FACE			= "105"	'얼굴
DEF_BIO_PIN			= "116"	'PIN  
DEF_BIO_PALM			= "115"	'손바닥

'----------------------------------------------------------------------------
Dim DEF_BIO_SVCD

DEF_BIO_SVCD			= "001"	'고정

'----------------------------------------------------------------------------
Dim tbl_001a(0)
Dim tbl_002a(0)
Dim tbl_008a(0)

Dim tbl_011a(0)
Dim tbl_013a(0)
Dim tbl_015a(0)

'============================================================================
Sub Form_OnFormInit()
	g_userID = Form.GetSharedData("&USER_ID", 0 )		'고객ID 
	g_Ostype = Form.GetSharedData("&OS_TYPE", false )	'iOS("2") Android("1") 기타("9")
	g_termID = Form.getKftcBioDeviceID()				'단말ID획득
	g_deviceModel = Form.getDeviceModel()			'모델명
	g_sBioEnbl = Form.GetKftcBioDeviceEnbl()			'바이오인증 지원 여부 : 0.미지원 1.지원(지문가능) 2.지원(지문불가)
	
	'바이오인증 아이폰X대응 이미지변경
	s_OSTYPE = Form.GetSharedData("&OS_TYPE", false )	'iOS("2")Android("1")
	
	if s_OSTYPE == "2" Then
		Table0.SetCellString( 0, 0, "지문/얼굴" )
		Table0.SetCellString( 3, 1, "지문/얼굴 인증정보를 등록 할 수 있습니다.")
		Table0.SetCellString( 8, 1, "지문/얼굴 인증정보를 해지 할 수 있습니다.")
		
'PENTA13 START => 2021.01.26 애플정책적용
		Table1.SetCellString( 1, 1, "지문 : iOS 9.0 이상 (지문인식)" )
		Table1.SetCellString( 2, 1, "간편비밀번호 : iOS 9.0 이상" )
'PENTA13 END

	else
		Image1.imgpath="icon_register_01"
	end if	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName = "LOGOUT_MSG1" then
		if sRet =="ok" then
			Form.LogOut(0, 1) '로그아웃실행(0:문구없음,1문구있음)
			Form.MsgBox( "알림", "로그아웃이 완료되었습니다.", "", 6 )
		end if		
	
	'20220805_01 KBC : 로그인개선
	elseif sKeyName = "CLOSE_FORM" then
		Form.CloseForm()	
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	sLoginID = Form.GetSharedData( "&USER_ID", 0 )
	sFlag	= Form.GetOpenLinkData()				'로그인>인증센터>바이오인증을 통해서 화면 오픈시 sFlag = Y
												'공지사항을 통해서 화면 오픈시 sFlag = P
	if Trim(sLoginID) == "" then
		if sFlag <> "Y" then						' 최초 1회 로그인 필요 O + 바이오정보 등록(로그인화면)으로 열렸을 시
			if sFlag == "P" then					' 최초 1회 로그인 필요 O + 공지사항에서 이동하였을 시
			else
				Form.OpenScreen("90020" , "90110")	'20180911_01 KBC : 바이오인증 인증방식 추가
			end if
		end if
	
	else
		if sFlag <> "Y" and g_complete = "Y" then	' 최초 1회 로그인 필요 X + 바이오정보 등록(로그인화면)으로 열렸을 시 
			if sFlag == "P" then					' 최초 1회 로그인 필요 X + 공지사항에서 이동하였을 시
			else
				Form.OpenScreen("90020" , "90110")	'20180911_01 KBC : 바이오인증 인증방식 추가
			end if
		end if
	end if

	'20220805_01 KBC : 로그인개선
	if sFlag == "Y" then
		Form.SendReturnToParent("FORM_CLOSE" , "") '20220805_01 KBC : 로그인개선
	end if
	
End Sub

'============================================================================
Sub Table0_OnClick(lRow , lColumn)
	if lColumn == 0 then
		exit sub
	end if
	
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
	
	'로그인상태 체크
	if CInt(sLOGIN_TYPE) > 1 then 
		Form.MsgBox("바이오인증 안내", "바이오인증 등록/해지를 위하여 로그아웃을 진행하시겠습니까?", "LOGOUT_MSG1", 1 )
		exit sub
	end if
	
	'g_sBioEnbl (GetKftcBioDeviceEnbl)
	'   android : 0.불가단말 1.가능단말(지문가능) 2.가능단말(지문불가)
	'   iOS : 0.불가단말 1.가능단말
	
	'20220805_01 KBC : 로그인개선
	if g_sBioEnbl == "0" and g_Ostype == "1" then 'Android Only
		Form.MsgBox("바이오인증 안내", "바이오인증이 지원되지 않는 단말입니다.", "", 0 ) '안드로이드 4.4 이상가능
		exit sub
	end if

	'지문인증 등록/재등록
	if lRow == 0 or lRow == 1 or lRow == 2 or lRow == 3 or lRow == 4 then
		if g_sBioEnbl == "2"  and g_Ostype == "1" then 'Android Only
			Form.MsgBox("바이오인증 안내", "지문인증이 지원되지 않는 단말입니다.", "", 0 ) '안드로이드 6.0 이상 + 지문장치 가능
			exit sub
		end if
		
		Form.SetSharedData("BIO_NEW_REG" , "Y")	'20230125 HSZ START : 개인정보 노출자 체크 추가(등록시에만)
		g_gubun = "register_finger"
		g_sBIOAthnTchnCode = DEF_BIO_FINGER
		
	'지문인증 해지
	elseif lRow == 5 or lRow == 6 or lRow == 7 or lRow == 8 or lRow == 9 then
		Form.SetSharedData("BIO_NEW_REG" , "N")	'20230125 HSZ START : 개인정보 노출자 체크 추가(등록시에만)
		g_gubun = "cancel_finger"
		g_sBIOAthnTchnCode = DEF_BIO_FINGER
		
	'간편인증 등록/재등록
	elseif lRow == 10 or lRow == 11 or lRow == 12 or lRow == 13 or lRow == 14 then
		Form.SetSharedData("BIO_NEW_REG" , "Y")	'20230125 HSZ START : 개인정보 노출자 체크 추가(등록시에만)
		g_gubun = "register_pin"
		g_sBIOAthnTchnCode = DEF_BIO_PIN
	
	'간편인증 해지
	elseif lRow == 15 or lRow == 16 or lRow == 17 or lRow == 18 or lRow == 19 then
		Form.SetSharedData("BIO_NEW_REG" , "N")	'20230125 HSZ START : 개인정보 노출자 체크 추가(등록시에만)
		g_gubun = "cancel_pin"
		g_sBIOAthnTchnCode = DEF_BIO_PIN
		
	else
		exit sub
	end if
	
	'연계앱 설치여부 0:설치안됨 1:설치됨
	sRet = Form.getKftcBioInstalled() 

	if sRet == "1" then	
		'IRow > 10 : 손바닥, 간편번호 영역 클릭시
		'지문/얼굴정보가 단말에 등록되어있지 않아도 간편비밀번호 등록은 가능하게 처리
		
		'20220805_01 KBC : 로그인개선
		if lRow < 10 then '지문/얼굴 인증인 경우에만 체크
			sFingerEnrolled = Form.isTouchIDSupported() 
			
			'생체정보 단말등록여부 : 0.미등록 1.등록
			if sFingerEnrolled <> "1" then
				if g_Ostype == "2" then
					Form.MsgBox("바이오인증 안내", "스마트폰에 등록된 지문/얼굴정보가 없습니다. 제조사가 제공하는 설정화면을 통해서 지문/얼굴정보를 우선 등록하시기 바랍니다.", "", 0 )
				else
					Form.MsgBox("바이오인증 안내", "스마트폰에 등록된 지문정보가 없습니다. 제조사가 제공하는 설정화면을 통해서 지문을 우선 등록하시기 바랍니다.", "", 0 )
				end if
				exit sub
			end if	
		end if
		
		Form.requestKftcBio("Bio_401", "" , "90110") '단말정보 취득
	else															
		Form.setKftcBioInstalled() '연계앱 미설치 시, 설치안내 팝업
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	sParam	= Split(sRet, "★")
	
	state 	= sParam(0)	'[처리상태] ok:완료 error: 오류
	g_userID = sParam(1) 	'사용자 아이디
	g_Acno 	= sParam(2) 	'계좌번호
	
	if sKeyName == "b_vft" then
		if state == "ok" then 			
			g_type = "bio_new" 
			
			if g_sBIOAthnTchnCode == DEF_BIO_FINGER then 'or g_sBIOAthnTchnCode == DEF_BIO_FACE then		
				DATAMANAGER.SetDataValue(0, "obtss_fido_001a", "InBlock1", "ELFN_ID" 		, 0, g_userID) 			'전자금융ID
				DATAMANAGER.SetDataValue(0, "obtss_fido_001a", "InBlock1", "TERM_OS_CODE" 	, 0, g_Ostype) 			'단말운영체제 1:안드로이드 2:아이폰 9:기타
				DATAMANAGER.SetDataValue(0, "obtss_fido_001a", "InBlock1", "TERM_ID" 		, 0, g_termID)			'단말ID
				DATAMANAGER.SetDataValue(0, "obtss_fido_001a", "InBlock1", "SVCD" 			, 0, DEF_BIO_SVCD)		'서비스코드   001:고정
				DATAMANAGER.SetDataValue(0, "obtss_fido_001a", "InBlock1", "ATHN_TCHN_CODE" 	, 0, g_sBIOAthnTchnCode)	'인증기술코드 100:고정
				DATAMANAGER.RequestTranData("obtss_fido_001a")
			else
				DATAMANAGER.SetDataValue(0, "obtss_fido_011a", "InBlock1", "ELFN_ID" 		, 0, g_userID) 			'전자금융ID
				DATAMANAGER.SetDataValue(0, "obtss_fido_011a", "InBlock1", "TERM_ID" 		, 0, g_termID)			'단말ID
				DATAMANAGER.SetDataValue(0, "obtss_fido_011a", "InBlock1", "SVCD" 			, 0, DEF_BIO_SVCD)		'서비스코드   001:고정
				DATAMANAGER.SetDataValue(0, "obtss_fido_011a", "InBlock1", "ATHN_TCHN_CODE" 	, 0, g_sBIOAthnTchnCode)	'인증기술코드 100:지문, 116:PIN, 115:손바닥
				DATAMANAGER.SetDataValue(0, "obtss_fido_011a", "InBlock1", "NTAT_ISNC_CLCD" 	, 0, "0")				'0:FIDO등록 1:인증서발급
				DATAMANAGER.RequestTranData("obtss_fido_011a")			
			end if

		elseif state =="error" then		
			Form.ShowAlert("", "인증실패")
		end if

	elseif sKeyName == "b_idft" then 
		if state == "ok" then
			g_type = "bio_cancel"
			l_cert_acno = Form.GetSharedData("CERT_ACNO"   , false )	'세팅된ACNO
			l_cert_pwd = Form.GetSharedData("CERT_ACNT_PWD", false )	'세팅된PWD			
		
			if g_sBIOAthnTchnCode == DEF_BIO_FINGER then 'or g_sBIOAthnTchnCode == DEF_BIO_FACE then					
				DATAMANAGER.SetDataValue(0, "obtss_fido_008a", "InBlock1", "ELFN_ID"	 , 0 , g_userID)			'ID
				DATAMANAGER.SetDataValue(0, "obtss_fido_008a", "InBlock1", "TERM_ID"  , 0 , g_termID)			'단말ID
				DATAMANAGER.SetDataValue(0, "obtss_fido_008a", "InBlock1", "SVCD"     , 0 , DEF_BIO_SVCD)		'서비스코드 : 001 고정
				DATAMANAGER.SetDataValue(0, "obtss_fido_008a", "InBlock1", "ACNO"     , 0 , l_cert_acno)	'입력된 계좌번호 v0002
				DATAMANAGER.SetDataValue(0, "obtss_fido_008a", "InBlock1", "ACNT_PWD" , 0 , l_cert_pwd)	'입력된 계좌비밀번호 v0002
				DATAMANAGER.RequestTranData("obtss_fido_008a")
			else				
				DATAMANAGER.SetDataValue(0, "obtss_fido_015a", "InBlock1", "ELFN_ID" 		, 0, g_userID) 			'전자금융ID
				DATAMANAGER.SetDataValue(0, "obtss_fido_015a", "InBlock1", "TERM_ID" 		, 0, g_termID)			'단말ID
				DATAMANAGER.SetDataValue(0, "obtss_fido_015a", "InBlock1", "SVCD" 			, 0, DEF_BIO_SVCD)		'서비스코드   001:고정
				DATAMANAGER.SetDataValue(0, "obtss_fido_015a", "InBlock1", "ATHN_TCHN_CODE" 	, 0, g_sBIOAthnTchnCode)	'인증기술코드 100:지문, 116:PIN, 115:손바닥
				DATAMANAGER.SetDataValue(0, "obtss_fido_015a", "InBlock1", "CMPR_CANC_YN"	, 0, "N")				'강제해지여부 Y:강제해지(고객인증없이) N:고객인증후해지

				DATAMANAGER.SetDataValue(0, "obtss_fido_015a", "InBlock1", "ACNO" 	    , 0, l_cert_acno)	'입력된 계좌번호
				DATAMANAGER.SetDataValue(0, "obtss_fido_015a", "InBlock1", "ACNT_PWD"	, 0, l_cert_pwd)	'입력된 계좌비밀번호
				
				DATAMANAGER.RequestTranData("obtss_fido_015a")	
			end if
		end if
	end if 
End Sub

