'--===========================================================================
' 01. 화 면 명 : 
' 02. 화면설명 : 
' 03. 작    성 :
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sCSNO		'고객번호
Dim g_sRCNO		'실명확인번호
Dim g_sApltDate  ' 신청일자
Dim g_lApltSrno   '신청일련번호 
Dim g_lAcptDate
Dim g_lAcptSrno
Dim plain_rm
Dim g_sOnline_Code
g_sOnline_Code = "20" '10:ISA신규/20:ISA이수관/30:ISA유형전환
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' ClearData() : 이전 입력 내용 초기화
'============================================================================
Function ClearData()
	edtPreAccNum.caption = ""
	edtName.name = ""
	edtJuminNum.name = ""
	g_sApltDate = ""
	g_lApltSrno = 0
	rdoGubun.currentindex = -1
	rdoCheckType.currentindex = -1
	rdoTransType.currentindex = -1
End Function

'============================================================================
' MoveNextPage() : 다음 스텝 넘기기 전 처리
'============================================================================
Sub MoveNextPage()
	Dim sSendData
	Dim szACNO, szASNO, szPWD
	Dim sCS_ChekCode, sType_Code
	Dim szTranID
	
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
	szTranID = "obwat_ctad_068a"
	
	'ISA계좌이전의사확인구분코드
	if CInt(rdoCheckType.currentindex) == 0 then ' 전화통화
		sCS_ChekCode = "01"
	else ' 기존 금융기관 방문
		sCS_ChekCode = "02"
	end if
		
	'ISA계좌이전유형구분코드
	if CInt(rdoTransType.currentindex) == 0 then ' 신탁형->일임형
		sType_Code = "1"
	elseif CInt(rdoTransType.currentindex) == 1 then ' 일임형->일임형
		sType_Code = "4"
	elseif CInt(rdoTransType.currentindex) == 2 then ' 중개형->일임형
		sType_Code = "9"
	end if
		
	'추후 유지보수 중 항목 추가 발생할 경우에 대비, 각 화면마다 array 20개씩 잡아놓음
	sSendData = szACNO & "★"			 '계좌번호
	sSendData = sSendData & szASNO & "★" '계좌일련번호
	
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then 
		szPWD = Form.GetCtlProp("#edtPwd", "caption")  
	'MTS메모리평문 미적용상태일때
	else
		szPWD = Form.GetCtlProp("#edtPwd", "encdata")
	end if 
	
	sSendData = sSendData & szPWD & "★"
	sSendData = sSendData & g_sCSNO & "★"				'고객번호
	sSendData = sSendData & cmbBank.cbkeydata & "★"		'기존금융회사코드
	sSendData = sSendData & edtPreAccNum.caption & "★"	'기존계좌번호
	sSendData = sSendData & "" & "★"					'기존계좌일련번호(이수관_신규일 경우 공백)
	sSendData = sSendData & g_sRCNO_PIP & "★"	
	sSendData = sSendData & sCS_ChekCode & "★"			'고객확인구분
	sSendData = sSendData & sType_Code & "★"			'계좌이전유형구분
	sSendData = sSendData & edtName.caption & "★"		'고객명
	sSendData = sSendData & Left(edtJuminNum.caption, 6) & Right(edtJuminNum.caption, 7) & "★"		'
	
	Form.SetSharedData("56110_INFO_STEP_LINK", sSendData )
	
	DATAMANAGER.ClearInputData( 0, szTranID )
	
	dim sDate
	sDate = Form.GetSharedData("&HOST_DATE", false)
	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 				, 0 , szACNO 			) '계좌번호
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 				, 0 , szASNO 			) '계좌번호
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "APLT_DATE"  			, 0 , sDate 			) '신청일자
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_STAG_CLS_CODE" 	, 0 , "1"			) 'STEP
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD"  				, 0 , szPWD 			)
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ANTC_PNSN_RECV_CNTT1"	, 0 , sSendData		) '저장정보
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ETC_CNTT"  			, 0 , g_sOnline_Code 	) '온라인신청구분
		
	DATAMANAGER.RequestTranData( szTranID ) '필수정보 저장
	
End Sub

'============================================================================
' f_SetSaveUI(str) : 저장 내역 UI SET
'============================================================================
Function f_SetSaveUI(szData)
	Dim tDataList
	tDataList = Split(szData,"★")
	
	'Index : Value
	'0 : 계좌번호
	'1 : 계좌일련번호
	'2 : 비밀번호(암호화)
	'3 : 고객번호
	'4 : 기존금융회사코드
	'5 : 기존계좌번호
	'6 : 기존계좌일련번호
	'7 : 고객식별번호(암호화)
	'8 : 고객확인구분(01=전화통화, 02=기존금융기관방문)
	'9 : 계좌이전유형구분(1=신탁>일임, 4=일임>일임, 9=중개>일임)
	'10 : 이름
	'11 : 고객식별번호(마스킹)
	
	rdoGubun.currentindex = "0"
	cmbBank.cbkeydata = tDataList[4]
	edtPreAccNum.caption = tDataList[5]
	
	if tDataList[8] == "01" then
		rdoCheckType.currentindex = "0"
	else
		rdoCheckType.currentindex = "1"
	end if
	
	if tDataList[9] == "1" then
		rdoTransType.currentindex = "0"
	elseif tDataList[9] == "4" then
		rdoTransType.currentindex = "1"
	elseif tDataList[9] == "9" then
		rdoTransType.currentindex = "2"
	end if
	
End Function

'============================================================================
' CheckInputData() : 모든 정보가 입력 되었는지 확인
'============================================================================
Function CheckInputData()
	dim sAcno, sAsno, sPwd
	sAcno = Form.GetCtlProp("#acnt0", "total")
	sAsno = Form.GetCtlProp("#acnt0", "sequence")
	sPwd  = Form.GetCtlProp("#edtPwd", "caption")
	
	if sAcno == NULL or sAcno == "" then
		Form.ShowAlert("알림", "계좌번호를 확인해주세요")
		return false
	end if
	
	if sPwd == NULL or sPwd == "" then
		Form.ShowAlert("알림", "비밀번호를 확인해주세요")
		return false
	end if
	
	if CDbl(rdoGubun.currentindex) == -1 then
		Form.ShowAlert("알림", "신청 구분을 확인해주세요")
		return false
	end if
	
	if edtPreAccNum.caption == "" or edtPreAccNum.caption == NULL then
		Form.ShowAlert("알림", "기존 계좌번호를 확인해주세요")
		return false
	end if
	
	if edtName.caption == "" or edtName.caption == NULL then
		Form.ShowAlert("알림", "고객명을 확인해주세요")
		return false
	end if
	
	if edtJuminNum.caption == "" or edtJuminNum.caption == NULL then
		Form.ShowAlert("알림", "주민등록번호를 확인해주세요")
		return false
	end if
	
	if CDbl(rdoCheckType.currentindex) == -1 then
		Form.ShowAlert("알림", "고객확인 타입을 확인해주세요")
		return false
	end if
	
	if CDbl(rdoTransType.currentindex) == -1 then
		Form.ShowAlert("알림", "계좌이전 유형을 확인해주세요")
		return false
	end if
	
	return true
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()    
	'MTS메모리평문 적용유무 (0:미적용 / 1:적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "REQ_USER_INFO" then
		DATAMANAGER.RequestTranData("obcsb_acif_000r")

	elseif sEventName == "REQ_CANCEL_INFO" then
		DATAMANAGER.RequestTranData("obsap_bisa_002r")
		
	elseif sEventName == "OPEN_PREV" then
		DATAMANAGER.RequestTranData( "obwat_ctad_069r" )	
	
	elseif sEventName == "CLEAR_DATA" then
		ClearData()
	end if
	
End Sub

'============================================================================
' btnGoMakeAcct_OnClick(): 비대면 계좌개설 화면으로 이동
'============================================================================
Sub btnGoMakeAcct_OnClick()
	sloginType = Form.GetSharedData( "&LOGIN_TYPE", false )
	
	if Cint(sloginType) > 1 then
		sText = "로그아웃이 필요한 메뉴입니다. 로그아웃하시겠습니까?"
		Form.MsgBox("알림",sText, "LOGOUT_MSG" , 1 )
	else
		Form.SetSharedData("&SCREEN_AUTH" , "99")
		Form.OpenPopup("mbbdm85100", "", "")
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "LOGOUT_MSG" then
		if sRet == "ok" then
			'1parm (0.문구없음 1.문구있음)
			'2parm (0.권한상관없이 로그아웃만 함 1.화면권한에 따라 닫을 화면 로그아웃)
			Form.LogOut(0,1)
			Form.SetSharedData("&SCREEN_AUTH" , "99")
			Form.OpenPopup("mbbdm85100", "", "")
		end if
	end if
End Sub

'============================================================================
' btnSubmit_OnClick() : 모든 입력체크가 유효하면 이관신청 서비스 호출
'============================================================================
Sub btnSubmit_OnClick()
	if CheckInputData() == true then
		if CInt(rdoGubun.currentindex) == 1 then '취소 구분
			DATAMANAGER.RequestTranData( "obwat_ctad_047a" )
		else
			DATAMANAGER.RequestTranData( "obwat_ctad_041r" )
'			Call MoveNextPage()
		end if
	end if
End Sub

'****************************************************************************
'               		D A T A				M A N A G E R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 통신에 필요한 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNO, szASNO, szPassword, szRcnoRip
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
	
	szRcnoRip = Form.GetSharedData("&JUMIN_NUM", false )
	
	if plain_rm == "1" then
		szPassword = Form.GetCtlProp("#edtPwd", "caption") 'MTS 메모리평문 적용상태일때
	else
		szPassword = Form.GetCtlProp("#edtPwd", "encdata") 'MTS메모리평문 미적용상태일때
	end if
	
	if szTranID == "obwat_ctad_047a" then
		DATAMANAGER.SetEventFlag( szTranID, "D" )
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE", 0, "G") '처리구분코드: 1:수관접수
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, szACNO) '계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0, szASNO) '계좌일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD", 0, szPassword) '비밀번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISA_ISTU_CODE", 0, cmbBank.cbkeydata) 'ISA기관코드 (콤보리스트 키값 -> HTS 콤보 값과 동일)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OTCO_ACNO", 0, edtPreAccNum.caption) '타사계좌번호 (기존 계좌번호)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNM", 0, edtName.caption) '고객명
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 0, szRcnoRip) '실명확인번호PIP
		
		'취소여부 (신청구분)
'		if CDbl(rdoGubun.currentindex) == 0 then ' 신청
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CNCL_YN", 0, "N")
'		else ' 취소
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CNCL_YN", 0, "Y")
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "APLT_DATE", 0, g_sApltDate) '신청일자
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "APLT_SRNO", 0, g_lApltSrno) '신청일련번호
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACPT_DATE", 0, g_lAcptDate) '신청일련번호
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACPT_SRNO", 0, g_lAcptSrno) '신청일련번호
'		end if
		
		'ISA계좌이전의사확인구분코드
		if CDbl(rdoCheckType.currentindex) == 0 then ' 전화통화
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISA_ACNT_MOVE_INTN_CNFR_CLCD", 0, "01")
		else ' 기존 금융기관 방문
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISA_ACNT_MOVE_INTN_CNFR_CLCD", 0, "02")
		end if
		
		'ISA계좌이전유형구분코드
		if CDbl(rdoTransType.currentindex) == 0 then ' 신탁형->일임형
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISA_ACNT_PRE_TYPE_CLCD", 0, "1") 
		elseif CDbl(rdoTransType.currentindex) == 1 then ' 일임형->일임형
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISA_ACNT_PRE_TYPE_CLCD", 0, "4")
		elseif CDbl(rdoTransType.currentindex) == 2 then ' 중개형->일임형
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISA_ACNT_PRE_TYPE_CLCD", 0, "9")
		end if
		
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "CNDC_RECV_MTHD_CLCD", 0, cmbReceive.cbkeydata) '계약서수령방법구분코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "CNDC_RECV_MTHD_CLCD", 0, "" ) '20211103 아이티젠(김성수) 요건 변경 수정
	
	elseif szTranID == "obwat_move_014r" or szTranID == "obsap_bisa_002r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, szACNO) '계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0, szASNO) '계좌일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD", 0, szPassword) '비밀번호
	
	elseif szTranID == "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0, szACNO) '계좌번호

	elseif szTranID == "obwat_ctad_069r" then
		dim sDate
		sDate = Form.GetSharedData("&HOST_DATE", false)
	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"		, 0, szACNO		) '계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"		, 0, szASNO		) '계좌일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "APLT_DATE"	, 0, sDate		) '신청일자
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD"		, 0, szPassword	) '비밀번호
	
	elseif szTranID == "obwat_ctad_041r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"		, 0, szACNO		) '계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"		, 0, szASNO		) '계좌일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD"		, 0, szPassword	) '비밀번호
	end if

End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obwat_ctad_047a" then
		Form.ShowAlert("알림", "처리가 완료되었습니다.")
	End If
	
	if szTranID == "obsap_bisa_002r" then
'		If DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "TFCT_EXUS_ANCT_YN" , 0 ) <> "Y" THEN '이수관전용계좌여부
'			Form.ShowAlert( "알림", "이수전용계좌가 아닙니다." )
'			Exit Sub
'		End If
'		
'		If DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ISA_CNRC_STAT_CLCD" , 0 ) <> "03" THEN 'ISA계약상태구분코드(03:수관중)
'			Form.ShowAlert( "알림", "수관 가능 상태가 아닙니다." )
'			Exit Sub
'		End If
		
		DATAMANAGER.RequestTranData("obwat_move_014r")
		
	elseif szTranID == "obwat_move_014r" then
		cmbBank.cbkeydata 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ISA_ISTU_CODE" , 0 ) 
		edtPreAccNum.caption 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "OTCO_ACNO" , 0 ) 
		g_sApltDate 			= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "APLT_DATE" , 0 ) '신청일자
		g_lApltSrno 			= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "APLT_SRNO" , 0 ) '신청일련번호
		g_lAcptDate 			= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ACPT_DATE" , 0 ) '신청일련번호
		g_lAcptSrno 			= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ACPT_SRNO" , 0 ) '신청일련번호
		
		'ISA계좌이전의사확인구분코드
		if DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ISA_ACNT_MOVE_INTN_CNFR_CLCD" , 0 ) == "01" then ' 전화통화
			rdoCheckType.currentindex = 0
		elseif DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ISA_ACNT_MOVE_INTN_CNFR_CLCD" , 0 ) == "02" then ' 기존 금융기관 방문
			rdoCheckType.currentindex = 1
		end if
		
		'ISA계좌이전유형구분코드
		if DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ISA_ACNT_PRE_TYPE_CLCD" , 0 ) == "1" then ' 신탁형->일임형
			rdoTransType.currentindex = 0
		elseif DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ISA_ACNT_PRE_TYPE_CLCD" , 0 ) == "4" then ' 일임형->일임형
			rdoTransType.currentindex = 1
		elseif DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ISA_ACNT_PRE_TYPE_CLCD" , 0 ) == "9" then ' 중개형->일임형
			rdoTransType.currentindex = 2
		end if
		
		DATAMANAGER.RequestTranData("obcsb_acif_000r")	'고객번호 조회
	
	elseif szTranID == "obcsb_acif_000r" then
		g_sCSNO = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CSNO" , 0 ) '고객번호
		g_sRCNO_PIP = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "RCNO_PIP" , 0 )
	
	elseif szTranID == "obwat_ctad_068a" then
		Form.triggerEvent("#", "OPEN_NEXT", "1")
		
	elseif szTranID == "obwat_ctad_069r" then
		
		Dim szType, szData
		szType = Trim(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ETC_CNTT", 0 ))
		
		if szType == "20" then
			szData = Trim(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ANTC_PNSN_RECV_CNTT1", 0 ))
			
			f_SetSaveUI(szData)
		end if 
		
	elseif szTranID == "obwat_ctad_041r" then
		dim sJoinYN
		sJoinYN = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "JOIN_ABLE_YN" , 0)
		
		if sJoinYN == "Y" then
			Call MoveNextPage()
		else
			Form.ShowAlert("알림", DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "DEAL_PRHB_CNTT" , 0))	
		end if
	end if
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	'ISA계좌가 이미 있다면 진행상태 화면으로 이동
	If szTranID == "obwat_ctad_041r" then
		If sSubmsg == "계약신청 신청내역이 존재합니다." then
			Form.MsgBox( "알림", szErrMsg & " " & szSubMsg & " " &  "진행상태로 이동합니다.", "Close", 6 )
		Else
			if szErrCode == "0829" then 'v0004
				Form.MsgBox( "알림", "만65세 이상 고령자로 투자 숙려대상이므로 ISA의 온라인가입이 불가합니다.", "", 0 )
			else
				Form.MsgBox( "알림", szErrMsg & " " & szSubMsg, "", 0 )
			end if 
			
		End If
	else
		if szSubMsg <> NULL and szSubMsg <> "" then
			Form.ShowAlert( "알림", szErrMsg & "(" & szSubMsg & ")" )
		else
			Form.ShowAlert( "알림", szErrMsg )
		end if
	end if
End Sub


