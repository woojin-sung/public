'============================================================================
' Container0_chk0_OnChange()
'============================================================================
Sub Container0_chk0_OnChange(sCheckState)

	g_Chk0 = sCheckState '동의여부
	
End Sub


'============================================================================
' btnFull_OnClick()
'============================================================================
Sub btnFull_OnClick()
	Dim tmp_sbsc_amt, tmp_sbsc_marg
	tmp_sbsc_amt = 0
	tmp_sbsc_marg = 0
	
	'청약가능수량 setting
	edtQty.caption = g_lSbscAbleQty
	
	'청약가능수량 청약금액(수량*단가) setting
	tmp_sbsc_amt = g_lSbscAbleQty * g_lSbscUnpr
	tbl0.SetCellString( 6 , 1, tmp_sbsc_amt )
	
	'청약가능수량 증거금 setting
	tmp_sbsc_marg = tmp_sbsc_amt * g_dSbscMgrt / 100
	tbl0.SetCellString( 7 , 1, tmp_sbsc_marg )
	
	'수량변수 clear
	g_nAmount = 0
End Sub

'============================================================================
' ChkButton0_OnChange()
'============================================================================
Sub Container0_ChkButton0_OnChange(sCheckState)
	dim tmp_acnt_info
	tmp_acnt_info = ""

	if sCheckState = "1" then
		tbl0.SetCellString( 9 , 1, g_rfnd_acno)			'환불계좌
	else
		tmp_acnt_info =  Left(acnt0.total, 4) & "-" &
					   Right(acnt0.total, 4) & "-" &
					   acnt0.sequence & " " &
					   acnt0.accountname
		
		tbl0.SetCellString( 9 , 1, tmp_acnt_info)			'미적용 청약계좌 setting
	end if	
	
End Sub

'============================================================================
' ChkButton1_OnChange()
'============================================================================
Sub ChkButton1_OnChange(sCheckState)

	dim tmp_acnt_info
	tmp_acnt_info = ""
	g_sape_yn = Sapeyn.caption
	
	if sCheckState = "1" then
		tbl0.SetCellString( 10 , 1, g_wrhs_acno)			'입고계좌
		
		RadioGroup0.currentindex = -1
		RadioGroup0.enable = True
	else
		tmp_acnt_info =  Left(acnt0.total, 4) & "-" &
					   Right(acnt0.total, 4) & "-" &
					   acnt0.sequence & " " &
					   acnt0.accountname
		
		tbl0.SetCellString( 10 , 1, tmp_acnt_info)			'미적용 청약계좌 setting
		RadioGroup0.currentindex = 1
		RadioGroup0.enable = False
	end if
	
	
	if g_sape_yn = "Y" then '동일인
		RadioGroup0.currentindex = 1
		RadioGroup0.Enable = False
	end if
	
	
	
End Sub
'============================================================================
' Container0_btnCnrcDocu_OnClick() v0002
'============================================================================
Sub Container0_btnCnrcDocu_OnClick()
	Dim szData1
	if g_szPW == "" or g_szPW == Null then
		Form.ShowAlert( "알림", "비밀번호를 입력해주세요.")
		Exit Sub
	end if 
	szData1 = acnt0.total & "★" & g_FnprJoinSrno
	'Form.ShowAlert( "알림", szData1)
	Form.OpenFramePopup( "mbonl81010_p16" , szData1 , sPosInfo)
End Sub

