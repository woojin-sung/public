	<SCRIPT_INFO _len="28303" _ulen="25447" >
'============================================================================
' 01. 화 면 명 : ELS/DLS청약_청약신청팝업
' 02. 화면설명 : ELS/DLS청약_청약신청팝업
' 03. 작    성 : 2016. 03. 05. 유창재
' 04. 수    정 : 2020. 09. 18. 성주혁 MTS 메모리 보안 v0001
' 2022. 03. 17. 신극수 [T2201200001] 계약서류-청약 v0002
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szData
Dim g_szList
Dim g_szPW			'비밀번호
Dim g_Chk0			'투자설명서 동의여부(Chk0)
Dim g_ngoMoney		'청약금액
Dim g_nAmount			'청약주수
Dim g_szYesorNo		'청약취소여부
Dim g_szAbleMoney		'출금가능액 청약단가 단위

Dim g_dPsntDate		'현재일자
Dim g_sSbscIssuClsCode	'청약종목구분코드
Dim g_sIscd			'종목코드
Dim g_sMaul_cls_code	'투자설명서교부여부
Dim g_Download		'투자설명서 다운로드여부
Dim g_lSbscUnpr		'청약단가
Dim g_lSbscAbleQty	'청약가능수량
Dim g_lSbscMinQty		'청약최소수량
Dim g_dSbscMgrt		'증거금률

Dim g_szOSTest			'OS Type, 1:안드로이드, 2:IOS
Dim g_szOSType			'OS Type, 안드로이드 = 157, IOS = 156

Dim g_rfnd_acno, g_wrhs_acno
Dim g_sape_yn
Dim g_issu_type_code
Dim g_FnprJoinSrno '금융상품가입일련번호 v0002
Dim plain_rm			'메모리평문 적용유무

g_nAmount = 0
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Setpass() : 청약 신청 함수
'============================================================================
Function Setpass()
	
	g_nAmount = edtQty.caption
	
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock1", "CHAN_TYPE_CLS_CODE" , 0 , g_szOSType)		'채널유형구분코드(OS별 입력값 안드로이드:157, IOS:156)
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock1", "ACNO" , 0 , acnt0.total)			'계좌번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock1", "ASNO" , 0 , acnt0.sequence)		'일련번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock1", "ACNT_PWD" , 0 , g_szPW)			'비밀번호
	'DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock1", "TRNF_YN " , 0 , RadioGroup0.GetCheckIndex())'양도여부

	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock2", "PROS_CLS_CODE" , 0 , "1" )			'처리구분코드
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock2", "SBSC_DATE" , 0 ,g_szList(0))			'청약일자
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock2", "SBSC_ISSU_SRNO" , 0 , g_szList(1))	'청약종목일련번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock2", "SBSC_APLT_SRNO" , 0 , "0" )			'청약신청일련번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock2", "SBSC_STCN" , 0 , g_nAmount)				'청약주수
	'DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock2", "CNCL_YN" , 0 , g_szYesorNo)				'취소여부
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock2", "CNCL_YN" , 0 , "N")				'취소여부
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock2", "INVT_MANL_HNDV_CLS_CODE" , 0 , g_sMaul_cls_code) 	'투자설명서교부구분
	
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock1", "UI_PROS_CLS_CODE2" , 0 , ChkButton0.chkdata )	 	'환불대체계좌 약정 적용여부
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock1", "UI_PROS_CLS_CODE1" , 0 , ChkButton1.chkdata )	 	'입고대체계좌 약정 적용여부
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_021a", "InBlock1", "FNPR_JOIN_SRNO"    , 0 , g_FnprJoinSrno) 	'금융상품가입일련번호 V0002
	DATAMANAGER.RequestTranData( "obibk_pssb_021a" )
	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()

	'v0001
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용 / 1 : 적용 )
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	

	'변수초기화
	g_Download = "0" 		'투자설명서 다운로드여부
	g_sMaul_cls_code = "0"	'투자설명서교부여부
	g_lSbscUnpr = 0		'청약단가
	g_lSbscAbleQty = 0	'청약가능수량
	g_lSbscMinQty = 0		'청약최소수량
	g_dSbscMgrt = 0		'증거금률
	g_ngoMoney = 0
	
	'컨트롤초기화
	edtQty.caption = ""
	tbl0.SetCellString( 6 , 1, 0 ) 	'청약금액
	tbl0.SetCellString( 7 , 1, 0 ) 	'증거금
		
	Form.SetScreenName( "공모주 청약신청" )
	
	g_szData = Form.GetOpenLinkData()
	
	'테스트임시
	'청약일자, 청약종목일련번호
	'g_szData = ''
	'g_szData = "20161101" & "★" & "1"
	'테스트임시
	
	g_szList = Split( g_szData, "★")
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
	
	
	g_dPsntDate = Left(Form.calcDateTime( nYear, nMonth, 0, nHour, nMinute, nSecond ),8)	'현재일자
	
	g_szOSTest = Form.GetSharedData( "&OS_TYPE", false )
	
	if g_szOSTest == "1" then
		g_szOSType = 157			'안드로이드
	else
		g_szOSType = 156			'IOS
	end if
	
	DATAMANAGER.RequestTranData( "obibk_pssb_001r" )
	DATAMANAGER.RequestTranData( "obibk_psif_001r" )
		
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obibk_pssb_023r" then
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_023r", "InBlock1", "ACNO" , 0 , acnt0.total )			'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_023r", "InBlock1", "ASNO" , 0 , acnt0.sequence )			'일련번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_023r", "InBlock1", "SBSC_DATE" , 0 , g_szList(0) )		'청약일자
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_023r", "InBlock1", "SBSC_ISSU_SRNO" , 0 , g_szList(1) )	'청약종목일련번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_023r", "InBlock1", "ABLE_AMT" , 0 , tbl0.GetCellString( 1, 1) )	'가능금액(출금가능금액)
		
	elseif szTranID == "obibk_pssb_001r" then
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_001r", "InBlock1", "ACNO" , 0 , acnt0.total )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_001r", "InBlock1", "ASNO" , 0 , acnt0.sequence )	'일련번호
		
	elseif szTranID == "obibk_pssb_029r" then
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_029r", "InBlock1", "APLT_DATE" , 0 , g_dPsntDate )		'신청일자(현재날자)
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_029r", "InBlock1", "ACNO" , 0 , acnt0.total )			'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_029r", "InBlock1", "ASNO" , 0 , acnt0.sequence )			'일련번호
		DATAMANAGER.SetDataValue( 0 , "obibk_pssb_029r", "InBlock1", "SBSC_ISSU_CLS_CODE" , 0 , g_sSbscIssuClsCode )	'청약종목구분코드

	elseif szTranID == "obibk_psif_001r" then			'청약정보조회
		DATAMANAGER.SetDataValue( 0 , "obibk_psif_001r", "InBlock1", "SBSC_DATE" , 0 , g_szList(0) )		'청약일자
		DATAMANAGER.SetDataValue( 0 , "obibk_psif_001r", "InBlock1", "SBSC_ISSU_SRNO" , 0 , g_szList(1) )	'청약종목일련번호
		
	elseif szTranID == "obcsb_oimf_625r" then			'보안매체 확인을 위한 TR
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		sACNO = acnt0.total
		sACNO_PWD = g_szPW
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
	end if
	
End Sub
