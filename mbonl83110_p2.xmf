'============================================================================
' rdoQty_OnClick(nIndex) : 라디오 버튼 선택에 따른 청약주수 선택
'============================================================================
Sub rdoQty_OnClick(nIndex)
	Dim tmp_sbsc_amt, tmp_sbsc_marg
	tmp_sbsc_amt = 0
	tmp_sbsc_marg = 0
	Edit0.caption = g_lSbscAbleQty
	Select Case nIndex
		Case 0		'10주
			g_nAmount = g_nAmount + 10
			edtQty.caption = g_nAmount
			if CDbl(edtQty.caption) > CDbl(Edit0.caption) then
				Form.ShowAlert( "알림", "청약 가능수량을 초과하였습니다.")
				g_nAmount = g_nAmount - 10
				edtQty.caption = g_nAmount
			end if
'			edtQty.enable = false
		Case 1		'100주
			g_nAmount = g_nAmount + 100
			edtQty.caption = g_nAmount
			if CDbl(edtQty.caption) > CDbl(Edit0.caption) then
				Form.ShowAlert( "알림", "청약 가능수량을 초과하였습니다.")
				g_nAmount = g_nAmount - 100
				edtQty.caption = g_nAmount
			end if
'			edtQty.enable = false
		Case 2		'1000주
			g_nAmount = g_nAmount + 1000
			edtQty.caption = g_nAmount
			if CDbl(edtQty.caption) > CDbl(Edit0.caption) then
				Form.ShowAlert( "알림", "청약 가능수량을 초과하였습니다.")
				g_nAmount = g_nAmount - 1000
				edtQty.caption = g_nAmount
			end if
'			edtQty.enable = false
		Case 3		'10000주
			g_nAmount = g_nAmount + 10000
			edtQty.caption = g_nAmount
			if CDbl(edtQty.caption) > CDbl(Edit0.caption) then
				Form.ShowAlert( "알림", "청약 가능수량을 초과하였습니다.")
				g_nAmount = g_nAmount - 10000
				edtQty.caption = g_nAmount
			end if
'			edtQty.enable = false
		Case 4		'정정
			g_nAmount = 0
			edtQty.caption = ""
			edtQty.enable = true
			edtQty.SetShowKeypad( true )		
	End Select
	
	if g_nAmount > 0 then
		'청약가능수량 청약금액(수량*단가) setting
		tmp_sbsc_amt = g_nAmount * g_lSbscUnpr
		tbl0.SetCellString( 6 , 1, tmp_sbsc_amt )
		
		'청약가능수량 증거금 setting
		tmp_sbsc_marg = tmp_sbsc_amt * g_dSbscMgrt / 100
		tbl0.SetCellString( 7 , 1, tmp_sbsc_marg )
	elseif g_nAmount == 0 then
		tbl0.SetCellString( 6 , 1, 0 )
		tbl0.SetCellString( 7 , 1, 0 )
	end if

End Sub
'============================================================================
' Container0_btnOK_OnClick()
'============================================================================
Sub Container0_btnOK_OnClick()
	Dim szData
	
	if CDbl(edtQty.caption) < Cdbl(g_lSbscMinQty) then
		Form.ShowAlert( "알림", "청약수량을 확인하십시오.")
		Exit Sub
		
	elseif CDbl(edtQty.caption) > CDBL(tbl0.GetCellString( 3, 1)) then
		Form.ShowAlert( "알림", "청약한도수량을 확인하십시오.")
		Exit Sub
	
	elseif CDBL(tbl0.GetCellString( 1, 1)) < CDBL(tbl0.GetCellString( 7, 1)) then
		Form.ShowAlert( "알림", "출금가능금액을 확인하십시오.")
		Exit Sub
	end if

	if (RadioGroup0.currentindex ~="0" and  RadioGroup0.currentindex ~="1") then
		Form.ShowAlert( "알림", "양도 여부를 선택하세요.")
		Exit Sub
	end if

	'v0002
	if Container0.chkCnrcDocu.checkstate <> "1" then
		Form.ShowAlert( "알림", "계약서류 제공방법을 선택해 주세요.")
		Exit Sub
	end if 
	
	'v0002
	if TRIM(g_FnprJoinSrno) == "" then
		Form.ShowAlert( "알림", "계약서류 제공방법을 선택해 주세요.")
		Exit Sub
	end if 
	
	
	if g_sMaul_cls_code == "0" then
		Form.ShowAlert( "알림", "투자설명서 교부여부를 선택해주세요.")
		Exit Sub		
	end if 

	if g_Chk0 == "1" then		'투자성향진단 화면 호출   화면번호,계좌번호,일련번호,종목코드,비밀번호
		szData = "83110" & "★" & acnt0.total & "★" & acnt0.sequence & "★" & g_sIscd & "★" & edtPW.caption
		
		'투자설명서교부여부 확인
		if g_sMaul_cls_code == "4" and g_Download ~= "1" then
			Form.ShowAlert( "알림", "투자설명서를 다운로드 해주세요.")
			Exit Sub		
		end if
		
		if g_szPW == "" or g_szPW == Null then
			Form.ShowAlert( "알림", "비밀번호를 입력해주세요.")
			Exit Sub
		elseif edtQty.caption == "" then
			Form.ShowAlert( "알림", "청약금액을 입력해주세요.")
			Exit Sub
		else
			'테스트임시 스킵 kyc
			Form.OpenFramePopup( "mbonl81010_p1" , szData , sPosInfo)
			'Form.ShowAlert( "알림", "테스트 투자성향 임시 skip 합니다.")
			'DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )
			'테스트임시 스킵
		end if
	else
		Form.ShowAlert( "알림", "투자설명서 숙지 동의여부를 확인하여 주십시오.")
	end if
	
	
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "KYCCHK_RETURN" then
		if sRet == "Y" then
			'Setpass()			'청약신청 테스트용 havetocheck
			DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )
		end if
	elseif sKeyName == "mhetc90060_p9" or sKeyName == "mhetc90060_pa" or sKeyName == "mhetc90060_pb"  or sKeyName == "mhetc90060_motp" then
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		end if 
	elseif sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			'청약신청
			Setpass()
		end if
		
	elseif sKeyName == "mbonl83110_p3" then '투자설명서전자교부선택 0:교부, 1:거부
		'투자설명서교부여부
		if sRet == "0" then
			tbl0.SetCellString( 12 , 1, "교부함")	
			g_sMaul_cls_code = "4"	'4:온라인
		else
			tbl0.SetCellString( 12 , 1, "교부하지 않음")	
			g_sMaul_cls_code = "3"	'3:거부
		end if
	elseif sKeyName == "ok_mbonl81010_p16" then 'v0002
		if sRet == "OK" then
			Container0.chkCnrcDocu.checkstate = 1
		else 
			Container0.chkCnrcDocu.checkstate = 0
		end if 
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
	elseif sKeyName == "mhetc90190_p1" then										
		'if sRet == "ok" then									
		'end if
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'Dim rfnd_acno, wrhs_acno
	Dim tmp_sbsc_amt
	Dim msg_succ, tmp_SbscApltSrno, tmp_SbscStcn
	
	tmp_sbsc_amt = 0
	msg_succ = ""
	tmp_SbscApltSrno = 0
	tmp_SbscStcn = 0
	
	g_sape_yn = Sapeyn.caption
	if szTranID == "obibk_pssb_001r" then
		g_rfnd_acno = ""
		g_wrhs_acno = ""
		
		'환불계좌
		g_rfnd_acno = Left(DATAMANAGER.GetDataValue( 0, "obibk_pssb_001r", "OutBlock1", "RFND_ACNO" , 0), 4) & "-" &
				   Right(DATAMANAGER.GetDataValue( 0, "obibk_pssb_001r", "OutBlock1", "RFND_ACNO" , 0), 4) & "-" &
				   DATAMANAGER.GetDataValue( 0, "obibk_pssb_001r", "OutBlock1", "RFND_ASNO" , 0) & " " &
				   DATAMANAGER.GetDataValue( 0, "obibk_pssb_001r", "OutBlock1", "ACNM1" , 0)
		tbl0.SetCellString( 9 , 1, g_rfnd_acno)			'환불계좌
		
		'환불약정계좌비교
		if acnt0.total == DATAMANAGER.GetDataValue( 0, "obibk_pssb_001r", "OutBlock1", "RFND_ACNO" , 0) and
		   acnt0.sequence == DATAMANAGER.GetDataValue( 0, "obibk_pssb_001r", "OutBlock1", "RFND_ASNO" , 0) then
		   
			ChkButton0.enable = False
			ChkButton0.checkstate = "0"
			
		else
			ChkButton0.enable = True
			ChkButton0.checkstate = "1"
			
		end if
		 
		'입고계좌
		g_wrhs_acno = Left(DATAMANAGER.GetDataValue( 0, "obibk_pssb_001r", "OutBlock1", "WRHS_ACNO" , 0), 4) & "-" &
				   Right(DATAMANAGER.GetDataValue( 0, "obibk_pssb_001r", "OutBlock1", "WRHS_ACNO" , 0), 4) & "-" &
				   DATAMANAGER.GetDataValue( 0, "obibk_pssb_001r", "OutBlock1", "WRHS_ASNO" , 0) & " " &
				   DATAMANAGER.GetDataValue( 0, "obibk_pssb_001r", "OutBlock1", "ACNM" , 0)
		tbl0.SetCellString( 10 , 1, g_wrhs_acno)			'입고계좌
		
		'입고약정계좌비교
		if acnt0.total == DATAMANAGER.GetDataValue( 0, "obibk_pssb_001r", "OutBlock1", "WRHS_ACNO" , 0) and
		   acnt0.sequence == DATAMANAGER.GetDataValue( 0, "obibk_pssb_001r", "OutBlock1", "WRHS_ASNO" , 0) then
		   
			ChkButton1.enable = False
			ChkButton1.checkstate = "0"
			
			RadioGroup0.currentindex = 1
			RadioGroup0.Enable = False
		else
			ChkButton1.enable = True
			ChkButton1.checkstate = "1"
			
			if g_sape_yn = "Y" then '동일인
				RadioGroup0.currentindex = 1
				RadioGroup0.Enable = False
			end if
			
		end if
	
		DATAMANAGER.RequestTranData( "obibk_pssb_023r" )
		'DATAMANAGER.RequestTranData( "obibk_pssb_029r" )
		'DATAMANAGER.RequestTranData( "obibk_psif_001r" )
		
	elseif szTranID == "obibk_psif_001r" then
		g_sSbscIssuClsCode = DATAMANAGER.GetDataValue( 0, "obibk_psif_001r", "OutBlock1", "SBSC_ISSU_CLS_CODE" , 0 )
		g_sIscd       = DATAMANAGER.GetDataValue( 0, "obibk_psif_001r", "OutBlock1", "ISCD" , 0 )
		g_lSbscUnpr   = DATAMANAGER.GetDataValue( 0, "obibk_psif_001r", "OutBlock1", "ELW_SBSC_UNPR" , 0 )	'청약단가		
		g_lSbscMinQty = DATAMANAGER.GetDataValue( 0, "obibk_psif_001r", "OutBlock6", "SBSC_MIN_QTY" , 0 )	'청약최소수량
		g_dSbscMgrt   = DATAMANAGER.GetDataValue( 0, "obibk_psif_001r", "OutBlock4", "SBSC_MGRT" , 0 )	'청약증거금률
		
		g_issu_type_code = issutypecode.caption
		
'		if g_issu_type_code <>"02" then '주식이아닐때 양도여부 N 수정불가 
'			RadioGroup0.currentindex = 1
'			RadioGroup0.Enable = False
'		end if
		
		DATAMANAGER.RequestTranData( "obibk_pssb_029r" )
		
	elseif szTranID == "obibk_pssb_029r" then
		g_szYesorNo = DATAMANAGER.GetDataValue( 0, "obibk_pssb_029r", "OutBlock1", "CNCL_YN" , 0)			'취소여부
		
		Dim iDataCount
		iDataCount = 0
		iDataCount = DATAMANAGER.GetDataCount( 0, "obibk_pssb_029r", "OutBlock1" )
		
		if iDataCount > 0 then
			Form.MsgBox( "알림", "이미 청약처리되었습니다.", "", 6 )
		end if
	
	elseif szTranID == "obibk_pssb_021a" then
		'Form.ShowAlert( "알림", "정상처리 되었습니다.")
		tmp_SbscApltSrno   = DATAMANAGER.GetDataValue( 0, "obibk_pssb_021a", "OutBlock1", "SBSC_APLT_SRNO" , 0 )
		tmp_SbscStcn       = DATAMANAGER.GetDataValue( 0, "obibk_pssb_021a", "OutBlock1", "SBSC_STCN" , 0 )
		msg_succ = "청약신청 처리 되었습니다\n\n    청약번호: " & CDbl(tmp_SbscApltSrno) & "\n    청약수량: " & FormatNumber(tmp_SbscStcn, 0) & "주"
		
		Form.MsgBox( "청약 신청 완료",msg_succ , "", 6 )
		Form.SendReturnToParent( "mbonl83110_p2" , "Ok")
		Form.CloseForm()
		
	elseif szTranID == "obcsb_oimf_625r" then	'보안인증
		Dim sSPLM_ATHN_NCSR_YN 
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			Case "4"
				Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "")		'공인인증서_일반/스마트OTP
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	
	elseif szTranID == "obibk_pssb_023r" then
		'청약가능수량 setting
		g_lSbscAbleQty = DATAMANAGER.GetDataValue( 0, "obibk_pssb_023r", "OutBlock1", "SBSC_STCN" , 0 )
		'edtQty.caption = g_lSbscAbleQty
		'청약가능수량 증거금 setting
		'tbl0.SetCellString( 7 , 1, DATAMANAGER.GetDataValue( 0, "obibk_pssb_023r", "OutBlock1", "SBSC_MARG" , 0 ) )
		'청약가능수량 청약금액(수량*단가) setting
		'tmp_sbsc_amt = DATAMANAGER.GetDataValue( 0, "obibk_pssb_023r", "OutBlock1", "SBSC_STCN" , 0 ) * g_lSbscUnpr
		'tbl0.SetCellString( 6 , 1, tmp_sbsc_amt )
		
	elseif szTranID == "obsap_acif_999a" then 'v0002
		g_FnprJoinSrno = DATAMANAGER.GetDataValue( 0, "obsap_acif_999a", "OutBlock1", "FNPR_JOIN_SRNO" , 0 )
	end if
	
End Sub
'============================================================================
' Container0_btnNotice_OnClick()
'============================================================================
Sub Container0_btnNotice_OnClick()
	Dim szFileName, nType
	
	szFileName = "IBK"&g_szList(0)&CDbl(g_szList(1))&".pdf"
	
	nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	if nType == "0" then
		if szFileName =="IBK202007011.pdf" then
			Form.OpenPdfViewer( "https://d3elgidnfmqtxw.cloudfront.net/"& szFileName, "")	'운영계 주소
		else
			Form.OpenPdfViewer( "http://home.imeritz.com/include/ocw/"& szFileName, "")	'운영계 주소
		end if
	elseif nType == "1" then
		Form.OpenPdfViewer( "http://211.255.202.106/include/ocw/"& szFileName, "")	'테스트계주소
	end if
	
	Container0.ChkDownload.checkstate = 1
	g_Download = "1"
	'chk0.checkstate = 1
	'g_Chk0 = 1
End Sub
