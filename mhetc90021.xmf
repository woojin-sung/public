'============================================================================
'============================================================================
'20240314_01 KBC START : 클라우드공동인증서 도입
'============================================================================
'============================================================================
'============================================================================

'============================================================================
'(클라우공동인증서) 선택한 DN의 클라우드인증서 표시
Sub procSelectedCloudCert(sDN, sParam)
	Dim sCertCnt, sCalDate, nCertCnt
	Dim szItem, bFind

	nCertCnt = 0
	bFind = false
	szItem = Split(sParam,"★")

	if #szItem > 3 then
		sCertCnt	= szItem(2) 	'인증서 개수
		
		sCalDate	= Form.calcDateTime(0, 0, 30, 0, 0, 0)
		sCalDate	= Left(sCalDate, 8)
			
		ContainerCloudCert.Grid0.SetClear()
		ContainerCloudCert.Grid0.rowcount = 1
		
		if sCertCnt ~= null and sCertCnt ~= "" then
			nCertCnt = CInt(sCertCnt) 
			if nCertCnt > 0 then		
				Dim sCertInfo, sTemp, sDate
	
				for i = 0 to CInt(sCertCnt)-1
					sTemp = Split(szItem(i+3), "♥")

					if #sTemp > 7 then
						'sTemp[ 0]	클라우드여부 
						'sTemp[ 1]	캐쉬여부
						'sTemp[ 2]	PIN잠김여부	
						'sTemp[ 3]	BIO여부
						'sTemp[ 4]	이름
						'sTemp[ 5]	DN
						'sTemp[ 6]	종류(범용/개인)
						'sTemp[ 7]	만료일(YYYYMMDD)
						'sTemp[ 8]	시작일(YYYYMMDD)
						'sTemp[ 9]	클라우드인증서ID	
						'sTemp[10]	시리얼
						
						if sTemp[5] == sDN then
							bFind = true
							
							tbl_cloudcert("CLOUD_CERT_DN") 		= sTemp[5] '클라우드인증서 DN
							tbl_cloudcert("CLOUD_CERT_EXPIRED") 	= sTemp[7] '클라우드인증서 만료일
							tbl_cloudcert("CLOUD_CERT_ID") 		= sTemp[9] '클라우드인증서 ID

							ContainerCloudCert.Grid0.SetCellData("bd_name"	, 0, sTemp[4])
							ContainerCloudCert.Grid0.SetCellData("bd_cert"	, 0, sTemp[6])
							ContainerCloudCert.Grid0.SetCellData("bd_date"	, 0, sTemp[8])
							ContainerCloudCert.Grid0.SetCellData("bd_Edate"	, 0, sTemp[7])
							ContainerCloudCert.Grid0.SetCellData("bd_dn"		, 0, sTemp[1])
							ContainerCloudCert.Grid0.SetCellData("bd_index"	, 0, i)
						
							sDate = sTemp[7]
							
							if tonumber(sDate) > tonumber(sCalDate) then
								ContainerCloudCert.ImageCertOn.imgpath = "icon_sign_certi.png"
							else
								ContainerCloudCert.ImageCertOn.imgpath = "icon_sign_certi_02.png"
							end if							
						end if
					end if
				next			
			end if
		end if		
	End if
	
	
	'인증서 표시여부
	if bFind == false then		
		if nCertCnt > 0 then
			'클라우드 인증서 있으나 선택되지 않음
			ContainerCloudCert.Image0.left	= 24
			ContainerCloudCert.Image0.Top	= 50
			ContainerCloudCert.Image0.width	= 329
			ContainerCloudCert.Image0.height= 113
			
			ContainerCloudCert.lblOtherCert.visible = True
			
			ContainerCloudCert.lblCertNotFound1.caption = "등록된 클라우드 공동인증서가 있어요."
			ContainerCloudCert.lblCertNotFound2.caption = "인증서 선택 후 사용해주세요."			
			
			ContainerCloudCert.btnCloudIssue.visible = False
			
			ContainerCloudCert_CertListPopup() '클라우드 인증서 선택창 팝업
		else 
			'클라우드 인증서 아예 없음
			ContainerCloudCert.Image0.left	= 24
			ContainerCloudCert.Image0.Top	= 55
			ContainerCloudCert.Image0.width = 329
			ContainerCloudCert.Image0.height= 170

			ContainerCloudCert.lblOtherCert.visible = False

			ContainerCloudCert.lblCertNotFound1.caption = "등록된 클라우드 공동인증서가 없어요."
			ContainerCloudCert.lblCertNotFound2.caption = "인증서 발급 후 사용해주세요."
			
			ContainerCloudCert.btnCloudIssue.caption = "클라우드인증서 발급"
			ContainerCloudCert.btnCloudIssue.top = 160
			ContainerCloudCert.btnCloudIssue.visible = True

		end if

		ContainerCloudCert.ImageCertOn.visible = False
		ContainerCloudCert.lblCertNotFound1.visible = True
		ContainerCloudCert.lblCertNotFound2.visible = True
		ContainerCloudCert.Grid0.setVisibleCol(2, "0")
		
		ContainerCloudCert.btnCloudLogin.visible = False

	else
		'클라우드 인증서 있고 선택되어짐
		ContainerCloudCert.lblOtherCert.visible = False
		
		ContainerCloudCert.Image0.left	= 24
		ContainerCloudCert.Image0.Top	= 50
		ContainerCloudCert.Image0.width	= 329
		ContainerCloudCert.Image0.height= 113
		
		ContainerCloudCert.ImageCertOn.visible = True
		ContainerCloudCert.lblCertNotFound1.visible = False
		ContainerCloudCert.lblCertNotFound2.visible = False
		ContainerCloudCert.lblOtherCert.visible = True

		ContainerCloudCert.Grid0.SetCellImage(2, "1")
		
		ContainerCloudCert.btnCloudLogin.visible = True
		ContainerCloudCert.btnCloudIssue.visible = False
	end if	
End Sub		



