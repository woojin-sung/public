		'CDD재이행 주기 도래 고객에 대한 안내 팝업창 제공 - 201608 나숙희과장 요청
		'===========================================================================
		if g_bCloseForm then
			bCDDYn = DATAMANAGER.GetDataValue(0 , szTranID, "OutBlock3", "REG_YN" , 0)
			
			if bCDDYn == "N" then
				szOpenedDate = Form.GetEnvData("90020_pd_opened")
				
				if szOpenedDate == "99999999" or szOpenedDate == "" then
					'20190715 LES START : 아이폰에서 &USER_ID 정상적으로 못받아오는 현상 수정
					'Form.ShowAlert("1198", g_sID)
					Form.OpenFramePopup("mhetc90020_pd" , g_sID , sPosInfo)
					g_bCloseForm = FALSE

				elseif LEN(szOpenedDate) >= 8 and LEN(g_SSTM_Date) >= 8 then
					DTszOpenedDate	= left(szOpenedDate,4)&"-"&mid(szOpenedDate,5,2)&"-"&right(szOpenedDate,2)	'마지막팝업일자
					DTSSTM_Date		= left(g_SSTM_Date,4)&"-"&mid(g_SSTM_Date,5,2)&"-"&right(g_SSTM_Date,2)		'오늘일자

					'20180906 LES START - CDD재이행 팝업 개선
					'30일동안보지 않기 -> 6개월동안 보지않기
					If DateDiff("d",DTszOpenedDate,DTSSTM_Date) > 180 Then '6개월동안보지않기
						Form.OpenFramePopup("mhetc90020_pd" , g_sID , sPosInfo) '20230310 LES START
						g_bCloseForm = FALSE
					end if
					
				end if
			end if
		end if
		
