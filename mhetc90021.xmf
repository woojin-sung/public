'============================================================================
'20230524 SWJ : 메리츠 간편인증 등록 조회
'============================================================================
'SafeBox 정보획득
function fnGetSBInfo(sParam)
	'-----------------------------------------------------------------------
	'ATON_GETALLINFO
	'-----------------------------------------------------------------------
	sRet = Form.requestAtonAuth("ATON_GETALLINFO" , "" , "")
	sRetItem = Split(sRet, "★")
	
	sErrorCode	= sRetItem[0]
	sErrorMsg	= sRetItem[1]
	g_SBVersion  	= sRetItem[2] 'SafeBox 버전 (에러여도 값있음)
	g_SBAlias 	= sRetItem[3] '인증서일련번호(식별자)
	
	if sErrorCode == "00000" then
		
'		if sParam <> "ISSUE" then
'			'발급시 인증서 일련번호에 해당하는 고객번호를 획득
'			'g_CustNo = Form.LoadConfigData("MERITZATONAUTH", g_SBAlias) '발급 시, 고객번호를 앱에 저장 후 이값을 인증 시 사용 (인증서조회 1 transaction을 줄이고자 함)
'
'		end if
		
		return True
	elseif sErrorCode == "E4102" then
		if g_sBIOTermOS == "1" then
			szErrMsg = "스마트폰에 등록된 지문이 없습니다.\n지문 등록 후 이용해주세요."
		else
			szErrMsg = "스마트폰에 등록된 생체 정보가 없습니다.\n생체 정보 등록 후 이용해주세요."
		end if
			
		Form.Msgbox("안내", szErrMsg, "", 6)
		
		return false
		
	'간편인증 해지 시 (활성화된 키가 없습니다)
	elseif sErrorCode == "E3201" then
		return false
	else
		if sParam <> "ISSUE" then
			Form.MsgBox("알림", sErrorCode & "," & sErrorMsg, "", 0)
		end if
	
		return False
	end if
	
	return True
end function

'============================================================================
'인증유형구분코드 획득
function fnGetAuthType()
	'g_sAthnTchnCode	: 10.PIN 100.지문 200.FACEID
	'fnGetAuthType	: 10.PIN 20.BIO
	
	'바이오 사용
	if g_AtonLogin == "BIO" then
		if fnGetCrtc() == "100" then
			g_sAthnTchnCode = "100"
		else 
			g_sAthnTchnCode = "200"
		end if
		
		return DEF_ATON_BIO 
	'PIN 사용
	else
		g_sAthnTchnCode = "10"
		return DEF_ATON_PIN 
	end if
end function
'============================================================================
'BIO인증구분코드 획득
function fnGetCrtc()
	'1 : 지문, 2 : 안면 - FACEID가 안면인증 임
	sBioType = Form.getBiometryType()				'생체/지문 기기 판단(iOS만 있음) : 0.사용불가 1.TOUCH ID 2.FACE ID
	
	if sBioType == "2" then
		return DEF_ATON_FACE 
	else
		return DEF_ATON_FINGER
	end if
	
end function
'============================================================================
Sub ClearAtonInfo()
	g_sErrorCode = ""
	g_CustNo = ""
	g_AtonBioYn = ""
	g_PinErrCnt = ""
	g_AtonState = ""
	g_RenewYN  = ""
	g_AtonExpired = ""
End Sub
'============================================================================
Sub procRequestAtonTR_INQUIRYCERT()
	sTranID = "ohhts_pauth_004"
	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , "MERITZSMART")	'매체구분코드
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CERT_SEQ_NO" 				, 0 , g_SBAlias)		'인증서일련번호 (고객번호, 일련번호 중 1개는 필수)	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId)		'이용자접속기기ID
		
	DATAMANAGER.RequestTranData(sTranID)
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "ohhts_pauth_004" then
		g_sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" ,0)
		sKeyAlias	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_SEQ_NO" ,0) 			'인증서일련번호
		g_CustNo		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CUST_NO" ,0) 				'고객번호
		g_AtonBioYn	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_BIO_USE_YN" ,0) 			'생체인증사용여부
		g_PinErrCnt	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_PIN_EROR_CNT" ,0) 			'PIN 오류 횟수
		g_AtonState	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_STTS_DCD" ,0) 			'인증서 상태 구분코드( '10 발급 '50 폐기)
		g_RenewYN	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_EXPY_GDNC_YN" ,0) 	     '인증서갱신공지여부
		g_AtonExpired	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_VLTE_EXPY_YMD" ,0) 			'유효기간만료년월일
		szRegitDevice  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_USR_CCTN_MCTL_ID",0) 		'이용자 접속기기 ID
					
		'생체인증 해지 후 나오는 에러코드
		'생체인증 정보가 기기에 없을 때
		if g_sErrorCode == "E3201" or g_sErrorCode == "E4102"  then
			MoveContainerAton("fail")		'오류
			
		elseif g_sErrorCode == "000000" then
			MoveContainerAton("success")		'인증서 조회 성공
			
		else
			MoveContainerAton("fail")		'오류
			
			'메시지 박스 처리할지 확인
			'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
			sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", g_sErrorCode, "")
			
			'다른 기기에서 간편인증 발급 시 폐기
			if g_sErrorCode == "030103" then
				Form.OpenPopup("mpopup_auth","AuthError","")
			end if
		end if		
	
	
	elseif szTranID == "ohhts_pauth_021" then
		'-----------------------------------------------------------------------
		'전자서명을위한 원문(g_ElsgOnttCon)
		'   -> 전자서명데이터(sPKCS7) 
		'-----------------------------------------------------------------------
		
		sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" ,0)
		sTranNo 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_TRAN_NO" ,0) '인증서거래번호
		
		if sErrorCode <> "000000" then
			'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
			sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode, "")

			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if
		
		'-----------------------------------------------------------------------
		'ATON_SIGN
		'-----------------------------------------------------------------------		
		sRet = Form.requestAtonAuth("ATON_SIGN" , g_SBAlias & "★" & g_ElsgOnttCon , "")
		sRetItem = Split(sRet, "★")
		
		sErrorCode	= sRetItem[0]
		sErrorMsg	= sRetItem[1]
		sPKCS7		= sRetItem[2] '서명원문의 byte 형식 데이터
		
		if sErrorCode <> "00000" then
			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if	
				
		'-----------------------------------------------------------------------
		'인증유형데이터
		'-----------------------------------------------------------------------	
		sCrtcDataCon = g_Signature
	
		'-----------------------------------------------------------------------
		'전문전송
		'-----------------------------------------------------------------------		
		procRequestAtonTR_VRFY(sTranNo, g_ElsgOnttCon, sPKCS7, sCrtcDataCon)	
		
	elseif szTranID == "ohhts_pauth_013" then
		sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" ,0)
		
		if sErrorCode <> "000000" then
			
			'인증서 폐기 상태
			if sErrorCode == "030104" then 
				Form.MsgBox("안내", "이용 가능한 인증이 아닙니다.\n재등록 후 이용해주세요.", "030104", 7, "재등록","취소")
				exit sub
			'인증 기간 만료
			elseif sErrorCode == "030201" then
				Form.MsgBox("안내", "간편 인증 유효기간이 만료되었습니다.\n재등록 후 이용해주세요.", "030201", 7, "재등록","취소")
				exit sub
			'BIO 미등록 에러코드
			elseif sErrorCode == "050103" then
				Form.Msgbox("안내", "간편비밀번호를 사용중입니다.\n로그인 후 생체인증 추가 등록해주세요.", "", 6)
				exit sub
			end if
			
			'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
			sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode, "")

			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if		
	
		Request_obcpp_logn_056a()
	end if
End Sub

'============================================================================
'생체인증정보 확인 및 검증
'============================================================================
Sub procVerifyBioSignature()
	'-----------------------------------------------------------------------
	'ATON_CHECKBIOSIGNATURE
	'-----------------------------------------------------------------------
	sRet = Form.requestAtonAuth("ATON_CHECKBIOSIGNATURE" , "" , "")
	
	sRetItem = Split(sRet, "★")
	
	sErrorCode	= sRetItem[0]
	sErrorMsg	= sRetItem[1]

	if sErrorCode <> "00000" then

		'기기 내 생체 등록 정보가 변경
		if sErrorCode == "E4101" then
			
			'생체인증 미등록 시는 등록안내 메시지
			if g_AtonBioYn == "N" then
				Form.Msgbox("안내", "간편비밀번호를 사용중입니다.\n로그인 후 생체인증 추가 등록해주세요.", "", 6)
			else
				Form.OpenPopup("mpopup_auth","BioInfoChanged","")
			end if
			
			exit sub
		elseif sErrorCode == "E4102" then
			if g_sBIOTermOS == "1" then
				szErrMsg = "스마트폰에 등록된 지문이 없습니다.\n지문 등록 후 이용해주세요."
			else
				szErrMsg = "스마트폰에 등록된 생체 정보가 없습니다.\n생체 정보 등록 후 이용해주세요."
			end if
			
			Form.Msgbox("안내", szErrMsg, "", 6)
			exit sub
		elseif sErrorCode == "E4103" then
		
			'폐기 상태일 땐 재등록 안내 팝업 
			if g_AtonState == "50" then
				Form.MsgBox("안내", "이용 가능한 인증이 아닙니다.\n재등록 후 이용해주세요.", "030104", 7, "재등록","취소")
			else
				Form.Msgbox("안내", "간편비밀번호를 사용중입니다.\n로그인 후 생체인증 추가 등록해주세요.", "", 6)
			end if
			
			exit sub
		elseif sErrorCode == "E4105" then
			exit sub
		'iOS전용 (인증 실패 초과 시)
		elseif sErrorCode == "E4106" then
			Form.MsgBox("안내", "시도 횟수가 너무 많습니다.\n잠시 후 다시 시도하거나\n간편비밀번호로 인증해주세요.", "E4106", 7, "간편비밀번호 인증","확인")
			exit sub
		elseif sErrorCode == "E4108" then
			Form.MsgBox("안내", "생체정보 접근 권한을 확인해주세요.", "", 0)
			exit sub
		end if
		
		Form.MsgBox("알림", sErrorCode & "," & sErrorMsg, "", 0)
		exit sub
	end if	
	
	'바이오인증 생체인증 시, 기존 로그인화면 가림 
	ContainerLogo.left = 0
	ContainerLogo.top = 0
	ContainerLogo.visible = True
	
	'-----------------------------------------------------------------------
	'ATON_VERIFYBIOSIGNATURE
	'-----------------------------------------------------------------------
	Form.requestAtonAuth("ATON_VERIFYBIOSIGNATURE" , "" , "90020")	
End Sub

'============================================================================
Sub Form_onTriggerEventAton(sEventName, sParam)
	'바이오인증 생체인증 후, 기존 로그인화면 보임
	ContainerLogo.visible = False

	'ATON_SETBIOSIGNATURE, ATON_VERIFYBIOSIGNATURE 만 여기로만 진입
	if sEventName == "ATON_SETBIOSIGNATURE_RETURN_90020" or sEventName == "ATON_VERIFYBIOSIGNATURE_RETURN_90020" then
	
		sRet = Split(sParam, "★")
		
		sErrorCode	= sRet[0]
		sErrorMsg	= sRet[1]			
	
		'E4100	생체 데이터에 오류가 발생하였습니다.
		'E4101	생체 등록 정보가 변경되었습니다.
		'E4102	단말에 등록된 생체 정보가 없습니다.
		'E4103	생체 인증 등록 키가 존재하지 않습니다.
		'E4104	생체 인증에 실패하였습니다.
		'E4105	생체 인증을 취소하였습니다.
		'E4106	TouchID/FaceID가 잠겨있습니다.
		'E4107	단말에 등록된 패스워드가 없습니다.
		'E4108	생체 정보를 사용할 수 없습니다.
	
		if sErrorCode <> "00000" then
			'기기 내 생체 등록 정보가 변경
			if sErrorCode == "E4101" then
				
				'생체인증 미등록 시는 등록안내 메시지
				if g_AtonBioYn == "N" then
					Form.Msgbox("안내", "간편비밀번호를 사용중입니다.\n로그인 후 생체인증 추가 등록해주세요.", "", 6)
				else
					Form.OpenPopup("mpopup_auth","BioInfoChanged","")
				end if
				
				exit sub
			elseif sErrorCode == "E4102" then
				if g_sBIOTermOS == "1" then
					szErrMsg = "스마트폰에 등록된 지문이 없습니다.\n지문 등록 후 이용해주세요."
				else
					szErrMsg = "스마트폰에 등록된 생체 정보가 없습니다.\n생체 정보 등록 후 이용해주세요."
				end if
				
				Form.Msgbox("안내", szErrMsg, "", 6)
				exit sub
			elseif sErrorCode == "E4103" then
				if g_AtonState == "50" then
					Form.MsgBox("안내", "이용 가능한 인증이 아닙니다.\n재등록 후 이용해주세요.", "030104", 7, "재등록","취소")
				else
					Form.Msgbox("안내", "간편비밀번호를 사용중입니다.\n로그인 후 생체인증 추가 등록해주세요.", "", 6)
				end if
				
				exit sub
			
			elseif sErrorCode == "E4105" then
				exit sub
			'안드로이드 전용 (인증 실패 초과 시)
			'7은 현재 테스트앱 기준이고, e4106으로 앱에서 에러코드 맞춰줄 것
			'안드는 해당 이벤트에서 지문인증 실패초과 메시지 뿌려준다
			elseif sErrorCode == "E4106" or sErrorCode == "7" then
				Form.MsgBox("안내", "시도 횟수가 너무 많습니다.\n잠시 후 다시 시도하거나\n간편비밀번호로 인증해주세요.", "E4106", 7, "간편비밀번호 인증","확인")
				exit sub
			end if
			
			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if
	
		sBioSignature	= sRet[2]
	end if
	
	if sEventName == "ATON_VERIFYBIOSIGNATURE_RETURN_90020" then
		g_Signature = sBioSignature
		
		Form.setTimerEvent2("10",1,0.1)
	end if
End Sub
'============================================================================
Sub ContainerAton_btnLogin_OnClick()
	'단말등록정보 확인
	if fnGetSBInfo("") == False or g_sAtonParam == "fail" then
		Form.OpenPopup("mhetc90190_s1","mhetc90021","")
		exit sub
	end if
	
	szPreAtonLogin = Form.GetEnvData("login.input.atonathntchncode")
	
	if g_AtonLogin == "" or g_AtonLogin == null then
		'마지막 로그인이 PIN일 때
		if szPreAtonLogin == "10" then
			g_AtonLogin = "PIN"
		'마지막 로그인이 생체일 때
		else
			g_AtonLogin = "BIO"
		end if
	end if
	
	proc_AtonLogin(g_AtonLogin)
End Sub
'============================================================================
Sub proc_AtonLogin(sParam)
	sDate = Form.GetSharedData("&HOST_DATE", False)
	
	g_sSiseCheck = "0" '간편인증은 시세조회전용없음
	
	fnGetAuthType()
	
	'바이오로 로그인할 때
	if sParam == "BIO" then
		ContainerAton_ContainerALL_ImageFinger_OnClick()
		procVerifyBioSignature()
		
	'PIN으로 로그인할 때
	elseif sParam == "PIN" then
		ContainerAton_ContainerALL_ImagePIN_OnClick()
		
		'PIN 5회 오류 시
		if Cint(g_PinErrCnt) >= 5 then
			Form.OpenPopup("mpopup_auth", "PinError5", "")
			exit sub
		end if
		
		'인증서 기간 만료 상태일 때
		if Cint(g_AtonExpired) < Cint(sDate) then
			Form.MsgBox("안내", "간편 인증 유효기간이 만료되었습니다.\n재등록 후 이용해주세요.", "030201", 7, "재등록","취소")		
			exit sub
		end if
		
		Form.OpenPopup("mhetc90191", "login" & "★" & g_CustNo & "★" & g_SBAlias & "★" & g_SBVersion & "★" & g_DeviceId & "★" & DEF_ATON_PIN & "★" & g_sAthnTchnCode ,"")
	end if
End Sub
'============================================================================
'무ID인지 판단, 무ID면 edit에 세팅안함
'(무ID는 ID가 없는게 아님. 사용자가 정하는 방식이 아니라
' 계좌개설 시 자동발급되는 개념)
' 앞에 2자리 ID, 뒤에 1자리 X, 총 12자리
'============================================================================
Function DecideNoID(sID)
	sIDLen   = Len(Trim(sID))
	sIDStart = Left(Trim(sID),2)
	sIDEnd   = Right(Trim(sID),1)
	
	if sIDLen = 12 and sIDStart = "ID" and sIDEnd == "X" then
		return True 
	else
		return False
	end if
End Function
'============================================================================
Sub procRequestAtonTR_REQPRE(paramElsgOnttCon)
	g_ElsgOnttCon = paramElsgOnttCon
	
	sTranID = "ohhts_pauth_021"
	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , "MERITZSMART")	'매체구분코드
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CERT_SEQ_NO" 				, 0 , g_SBAlias)		'인증서일련번호
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_MSB_VRSN_VL" 				, 0 , g_SBVersion)	'mSB버전값 (라이브러리 버전 정보)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId)		'이용자접속기기ID
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_TRAN_ELSG_ONTT_CON" 		, 0 , paramElsgOnttCon)'거래전자서명원문내용
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CUST_NO" 					, 0 , g_CustNo)		'고객번호
	
	DATAMANAGER.RequestTranData(sTranID)		
End Sub
'============================================================================
Sub procRequestAtonAuth()

	sElsgOnttCon = g_CustNo
		
	'-----------------------------------------------------------------------
	'ATON_MAKELOGINPUBCONTENT 
	'   - KOSCOM 축약서명 사용 : ATON_MAKELOGINPUBCONTENT
	'   - 아톤 축약서명 사용   : ATON_MAKELOGINCONTENT
	'-----------------------------------------------------------------------		
	sRet = Form.requestAtonAuth("ATON_MAKELOGINPUBCONTENT" , g_SBAlias & "★" & sElsgOnttCon , "")
	sRetItem = Split(sRet, "★")
	
	if Ubound(sRetItem) < 2 then
		exit sub
	end if
	
	sErrorCode	= sRetItem[0]
	sErrorMsg	= sRetItem[1]
	sLoginContent	= sRetItem[2] '서명 원문 생성을 위한 데이터
	
	if sErrorCode <> "00000" then
		Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
		exit sub
	end if		
	
	'-----------------------------------------------------------------------
	'ATON_SIGN
	'-----------------------------------------------------------------------		
	sRet = Form.requestAtonAuth("ATON_SIGN" , g_SBAlias & "★" & sLoginContent , "")
	sRetItem = Split(sRet, "★")
		
	sErrorCode	= sRetItem[0]
	sErrorMsg	= sRetItem[1]
	sPKCS7		= sRetItem[2] '서명원문의 byte 형식 데이터
	
	if sErrorCode <> "00000" then
		Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
		exit sub
	end if		
					
	'-----------------------------------------------------------------------
	'인증유형데이터
	'-----------------------------------------------------------------------	
	sCrtcDataCon = g_Signature
		
	procRequestAtonTR_VRFYSHORTLOGIN(sElsgOnttCon, sPKCS7, sCrtcDataCon)	
End Sub
'============================================================================
Sub procRequestAtonTR_VRFYSHORTLOGIN(paramElsgOnttCon, paramElsgDataCon, paramCrtcDataCon)	
	sTranID = "ohhts_pauth_013"
	
	if fnGetAuthType() == DEF_ATON_BIO then
		szAuthType = DEF_ATON_BIO
	else
		szAuthType = DEF_ATON_PIN
	end if
	
	Form.SetSharedData("&ATON_PAU_RQST_CHNL_DCD" 		, "MERITZSMART")
	Form.SetSharedData("&ATON_PAU_CERT_SEQ_NO" 		, g_SBAlias)
	Form.SetSharedData("&ATON_PAU_MSB_VRSN_VL" 		, g_SBVersion)
	Form.SetSharedData("&ATON_PAU_USR_CCTN_MCTL_ID" 	, g_DeviceId)
	Form.SetSharedData("&ATON_PAU_LGN_ELSG_ONTT_CON" 	, paramElsgOnttCon)
	Form.SetSharedData("&ATON_PAU_LGN_ELSG_DATA_CON" 	, paramElsgDataCon)
	Form.SetSharedData("&ATON_PAU_CRTC_PTRN_DCD"		, szAuthType      )
	Form.SetSharedData("&ATON_PAU_CRTC_DATA_CON" 		, paramCrtcDataCon)
	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , "MERITZSMART")		'매체구분코드
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CERT_SEQ_NO" 				, 0 , g_SBAlias)		'인증서일련번호
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_MSB_VRSN_VL" 				, 0 , g_SBVersion)	'mSB버전값 (라이브러리 버전 정보)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId)		'이용자접속기기ID
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_LGN_ELSG_ONTT_CON" 		, 0 , paramElsgOnttCon)'로그인전자서명원문내용
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_LGN_ELSG_DATA_CON" 		, 0 , paramElsgDataCon)'로그인전자서명데이터내용
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CRTC_PTRN_DCD" 			, 0 , fnGetAuthType())	'인증유형구분코드 (10:PIN, 20:BIO, 30:Pattern)

	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CRTC_DATA_CON" 			, 0 , paramCrtcDataCon)'인증유형데이터내용 (HexString, 64Byte)

	'바이오인증성공여부(Y:인증성공, N:인증실패) 인증유형구분코드가 '20(BIO)' 인 경우에만 해당 필드가 유효함
	if fnGetAuthType() == DEF_ATON_PIN  then
		DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_BIO_INFO_MDFC_YN" 		, 0 , "N")			'바이오정보변경여부
		DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_BIO_CRTC_SUCC_YN" 		, 0 , "N")			'바이오인증성공여부
	else
		DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_BIO_INFO_MDFC_YN" 		, 0 , "N")
		DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_BIO_CRTC_SUCC_YN" 		, 0 , "Y")
	end if
	
	DATAMANAGER.RequestTranData(sTranID)
End Sub
'============================================================================
'메리츠간편인증
Sub Request_obcpp_logn_056a()
	szTranID = "obcpp_logn_056a"	
	
	strMediaType =  Trim(Form.GetSharedData("&MEDIA_CODE", 0))	
	sDeviceID = Form.GetDeviceID2()
	
	if g_sAthnTchnCode == "10" then
		szAthnTchnCode = "10"
	elseif g_sAthnTchnCode == "100" then
		szAthnTchnCode = "20"
	elseif g_sAthnTchnCode = "200" then
		szAthnTchnCode = "21"
	end if
	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CHAN_TYPE_CLS_CODE"	, 0	, strMediaType) 		'채널유형코드
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ATHN_MDIA_TYPE_CODE"	, 0	, szAthnTchnCode) 	'인증매체유형코드(원장에서만 사용) : 10.PIN 20.지문 21.FACEID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO"				, 0	, g_CustNo)	 		'고객번호
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "TERM_IDNT_KEY"		, 0	, sDeviceID)			'단말식별키
	
	DATAMANAGER.RequestTranData(szTranID)
End Sub

