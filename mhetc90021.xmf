'============================================================================
Sub ContainerBio_btnLogin_OnClick()
	'g_sBioReg
	'00 : 공동앱 설치안됨
	'01 : 등록정보없음
	'10 : 등록정보있음 (ALL, 최종지문)
	'11 : 등록정보있음 (ALL, 최종PIN)
	'12 : 등록정보있음 (ALL, 최종모름)
	'20 : 등록정보있음 (지문)
	'21 : 등록정보있음 (PIN)

	if g_sBioReg == "00" then
		'미설치 안내
		Form.setKftcBioInstalled() 'FIDO 설치 (설치안내창 앱내에서 표시)
		'공동앱 설치 결과는 Form_OnRefresh() 에서 리프레쉬 됨
		
	elseif g_sBioReg == "01" then
		Form.MsgBox("알림", "바이오인증 서비스 미등록 단말입니다.\n등록 후 이용해주세요.", "FIDO_JOIN", 7, "등록하기", "취소") '바이오인증 서비스 미등록		
	elseif g_sBioReg == "10" or g_sBioReg == "20" then
		proc_BioLogin(0) '지문인증
	elseif g_sBioReg == "11" or g_sBioReg == "21" then
		proc_BioLogin(2) 'PIN인증
	elseif g_sBioReg == "12" then
		'Form.MsgBox("알림", "지문인증 또는 간편비밀번호를 선택하세요", "", 0)		
		proc_BioLogin(0) '지문인증
	end if
	
End Sub

