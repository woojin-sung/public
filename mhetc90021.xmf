	g_sBioReg = "10"
	
	'최종지문사용
	ContainerBio.ContainerALL.ImageLineFinger.imgpath = g_sImg_Box_o '선택
	ContainerBio.ContainerALL.ImageLinePIN.imgpath = g_sImg_Box_n
