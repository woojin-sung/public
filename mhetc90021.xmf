	DATAMANAGER.SetDataValue(0, "obcpp_logn_015a", "InBlock1", "SUCS_YN" , 0 , szSucs_YN) 	'성공여부

	if g_sCertLogin == DEF_PIN then
		DATAMANAGER.SetDataValue(0, "obcpp_logn_015a", "InBlock1", "ATHN_MDIA_TYPE_CODE" , 0 , "06") 	'06.간편인증
	else
		DATAMANAGER.SetDataValue(0, "obcpp_logn_015a", "InBlock1", "ATHN_MDIA_TYPE_CODE" , 0 , "  ")
	end if
	
	DATAMANAGER.RequestTranData("obcpp_logn_015a")
	
	'부정접속 관련 대응-로그인 실패시
	if szSucs_YN <> "Y" then
		Call LoginFailSendHWInfo(g_sID)
	end if
End Sub

