				'계좌리스트 중 토스뱅크개설 관리지점이 1개라도 있으면 g_bTossBank = True
				if sMANG_BRCD == "1067" then
					g_bTossBank = True
				end if
				
			next
			'20240718 SWJ END
			
			'20230803 SWJ START : 개인/법인 구분하는 값 저장
			Form.SetSharedData("LOGIN_CUST_CLS_CODE", sCustCls)
