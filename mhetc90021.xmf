		sCustCls = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1" , "CUST_CLS_CODE" , 0)	'20230803 SWJ START : 개인/법인 구분(Array이지만 한 고객이 계좌별로 개인/법인 여부가 다를 일 없음)
		
		if bNextData == "1" or bNextData == true then
			Request_obcsb_efif_021r(true)
