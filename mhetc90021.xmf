Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "mhetc90021_p8" then
		if sParam == "register" then
			Form.OpenPopup("mhetc90190_s1" , "mhetc90021" , "")
		end if
	end if
End Sub
'============================================================================
Function CertSpinEndNOtice()
	saveDate = Form.LoadConfigData("CertSpinLoginEnd", "NoticeSpin")
	todayDate = Form.GetSharedData("&HOST_DATE",0)
	
	if saveDate <> "" then
		
		ResaveDate 	= left(saveDate,4)&"-"&mid(saveDate,5,2)&"-"&right(saveDate,2)
		RetodayDate 	= left(todayDate,4)&"-"&mid(todayDate,5,2)&"-"&right(todayDate,2)
		
		calcDate = tonumber(DateDiff("d",ResaveDate, RetodayDate))

		if calcDate > 1 then
			Form.OpenPopup("mhetc90021_p9", "" , "")
			
			return True
		end if
	else
		Form.OpenPopup("mhetc90021_p9", "" , "")
		
		return True
	end if
	
	return False
End Function


