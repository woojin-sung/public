'(클라우공동인증서) 컨테이너 숨김이면 smartformde에서 안보여서 true로 주고 script처리함
Sub ContainerVisibleInit()
	ContainerAton.visible = false
	ContainerCert.visible = false
	ContainerCloudCert.visible = false
	ContainerBio.visible = false
	ContainerID.visible = false
	ContainerSpin.visible = false
	
	ContainerBio.ContainerNotFound.visible = false
	ContainerBio.ContainerFinger.visible = false
	ContainerBio.ContainerPIN.visible = false
	ContainerBio.ContainerALL.visible = false
	
	ContainerAton.ContainerNotFound.visible = false
	ContainerAton.ContainerFinger.visible = false
	ContainerAton.ContainerPIN.visible = false
	ContainerAton.ContainerALL.visible = false
End Sub

'============================================================================
'(클라우공동인증서) 클라우드 연결
Sub ContainerCloudCert_btnCloudConn_OnClick()
	g_sDN = Form.GetEnvData("login.input.userdn")	
	Form.requestCertCommand("CLOUD_REQ_CERT_LIST", "CLOUD", "90021") '응답이벤트에서 procSelectedCloudCert(g_sDN) 실행
End Sub

'============================================================================
'(클라우공동인증서) 클라우드 인증서 발급
Sub ContainerCloudCert_btnCloudIssue_OnClick()
	MsgBox "클라우드인증서 발급으로"
End Sub

'============================================================================
Sub Form_onTriggerEventCloudCert(sCommand, sResult)
	Dim sErrorCd, sErrorMsg

	szItem = Split(sResult,"★")

	'처리코드,처리메시지 처리
	if #szItem >= 2 then
		sErrorCd		= szItem(0)
		sErrorMsg	= szItem(1)	
	
		'오류이면
		if sErrorCd <> "0" then
			Form.MsgBox(sCommand, sErrorMsg, "", 0)
			exit sub
		end if		
	end if
	
	'-------------------------------------------------------------
	'요청_응답처리
	'-------------------------------------------------------------
	if sCommand == "CLOUD_REQ_CERT_LIST_90021" then		
		procSelectedCloudCert(g_sDN, sResult)
		'ContainerCloudCert_btnLogin_OnClick() ''로그인 자동진행
		
	elseif sCommand == "CLOUD_REQ_SIGNDATA_LOGIN_90021" then	
		tbl_cloudcert("CLOUD_CERT_SERIAL")	= szItem(2) '시리얼
		tbl_cloudcert("CLOUD_CERT_RANDOM")	= szItem(3) '랜덤값
		tbl_cloudcert("CLOUD_CERT_SIGNDATA")	= szItem(4) '서명값
		
		Request_obcpp_logn_006a_cloud()
     
     elseif sCommand == "CLOUD_EVENT_ACQUIREUSERINFO" then
	     '클라우드인증서비스 연결
		ContainerCloudCert.Image0.left		= 24
		ContainerCloudCert.Image0.Top		= 55
		ContainerCloudCert.Image0.width		= 329
		ContainerCloudCert.Image0.height	= 120
	
		ContainerCloudCert.lblCertNotFound1.caption = "클라우드 인증 연결을 해주세요."
		ContainerCloudCert.lblCertNotFound1.visible = True
		ContainerCloudCert.lblCertNotFound2.visible = False
		ContainerCloudCert.ImageCertOn.visible = False
		
		ContainerCloudCert.btnCloudConn.caption = "클라우드 연결"
		ContainerCloudCert.btnCloudConn.top = 120
		ContainerCloudCert.btnCloudConn.visible = True
		
	
		'사용자인증 시작하면 됨 (이름/전화번호/생년월일 입력하는 화면)
		Form.OpenPopup("mhetc90302" , "" , "") 'Form_OnPopupReturn : CLOUD_CHECK_CONNECT 로 리턴
	end if
End Sub

'============================================================================
Sub ContainerCloudCert_ChkSignKoreaDEV_OnChange(sCheckState)
	Form.ShowAlert("알림", "앱을 재실행해야 적용됩니다.")
	Form.SetEnvData(1, "etc.signkorea.server_dev", sCheckState)
End Sub

