Sub Form_OnFormInitBefore()
	ContainerVisibleInit() '20240314_01 KBC :  클라우드공동인증서 도입

	ContainerCert.ImageCertOn.SetMaintainingRatio("1")
	ContainerCloudCert.ImageCertOn.SetMaintainingRatio("1")
	
	ContainerBio.ContainerALL.ImageFinger.SetMaintainingRatio("1")
	ContainerBio.ContainerALL.ImagePIN.SetMaintainingRatio("1")

	ContainerBio.ContainerFinger.ImageFinger.SetMaintainingRatio("1")
	ContainerBio.ContainerPIN.ImagePIN.SetMaintainingRatio("1")
	
	ContainerAton.ContainerALL.ImageFinger.SetMaintainingRatio("1")
	ContainerAton.ContainerALL.ImagePIN.SetMaintainingRatio("1")
	
	ContainerAton.ContainerFinger.ImageFinger.SetMaintainingRatio("1")
	ContainerAton.ContainerPIN.ImagePIN.SetMaintainingRatio("1")		
End Sub

'============================================================================
'20220805_01 KBC : 로그인개선
'iOS에서는 Form_OnFormInit에서 실행 시 맵에서 앱 이벤트메시지를 못받아서  바꿈
Sub Form_OnFormInit()
	g_sOpenData = Form.GetOpenLinkData()

	if g_sOpenData == "90022" or g_sOpenData == "mhetc90022" then '90022.계좌개설/로그인(최초창)
		szTab = Form.GetEnvData("login.input.savetab")
		
		'로그인 방식 미선택시에만 진입. 아니면 문제발생 (예 : 바이오인증 진행 시 로그인방식선택 팝업실행되면 실행중단 됨)
		if Trim(szTab) == "" then
			Form.openPopupAnimation("mhetc90021_p7", "" ,"","2") '다른 방식으로 로그인 팝업
		end if
	end if
	
	'20230524 SWJ START : 메리츠 간편인증 등록완료 화면에서 로그인 시킬 때
	'메리츠 간편인증 등록 완료 후 넘어옴 (mhetc90190_p2)
	if g_sOpenData == "mhetc90120_p2" then
		Form.SetEnvData(1, "login.input.savetab", DEF_TAB_ATON)
	end if
	'20230524 SWJ END
	
	g_sBIOTermOS = Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	
	'============================================================================
	' 20231013 LES START - 플로팅배너 읽음처리 초기화(임시추가로직)
	'============================================================================
	'20231012_5 : MY업무 > MY자산 플로팅배너 키값
	szFloatBannerKey = "20231012_6"
	
	'-----------------------------------------
	'안드로이드
	'-----------------------------------------
	if g_sBIOTermOS == "1" then
		
		szReadCheck = Form.GetEnvData(szFloatBannerKey)
		
		if szReadCheck == "1" then
			
			szReadCheckDate = Form.LoadConfigData("FloatBanner", szFloatBannerKey.. "_readCheckDate")
			
			if szReadCheckDate == "" then
				szToday = Form.GetSharedData("&HOST_DATE", false)
				Form.SaveConfigData("FloatBanner", szFloatBannerKey.. "_readCheckDate", szToday)
			end if
		
		end if
	
	'-----------------------------------------
	'iOS
	'-----------------------------------------
	elseif g_sBIOTermOS == "2" then
	
		szReadCheck = Form.LoadConfigData("FloatBanner", szFloatBannerKey)
		
		if szReadCheck == "1" then
			
			szReadCheckDate = Form.LoadConfigData("FloatBanner", szFloatBannerKey.."_readCheckDate")
		
			if szReadCheckDate == "" then
				szToday = Form.GetSharedData("&HOST_DATE", false)
				Form.SaveConfigData("FloatBanner", szFloatBannerKey.. "_readCheckDate", szToday)
			end if
		end if
	
	end if
	'============================================================================
	' 20231013 LES END 
	'============================================================================
	
	
	
	if g_sBIOTermOS == DEF_IOS then
		ContainerID.edtID.SetOnOffImage("alpha.png", "alpha.png")
		ContainerID.edtPass.SetOnOffImage("alpha.png", "alpha.png")
		ContainerID.edtCertPass.SetOnOffImage("alpha.png", "alpha.png")
	end if
	
	ContainerID.edtID.imagefilepth			= "alpha.png"
	ContainerID.edtPass.imagefilepth 		= "alpha.png"
	ContainerID.edtCertPass.imagefilepth 	= "alpha.png"
	ContainerID.edtPass.certname			= "아이디 비밀번호 입력"
	ContainerID.edtCertPass.certname		= "인증서 비밀번호 입력"
	
	ContainerCert.edtCertPswd.imagefilepth 	= "login_input.9.png"
	ContainerCert.Image0.imgpath 			= g_sImg_Box
	ContainerCert.edtCertPswd.certname		= "인증서 비밀번호 입력"
	
	ContainerCloudCert.Image0.imgpath 		= g_sImg_Box
	
	ContainerSpin.Image0.imgpath 			= g_sImg_Box
	ContainerBio.ImageLine.imgpath 			= g_sImg_Box
	
	ContainerAton.ImageLine.imgpath 		= g_sImg_Box		'20230524 SWJ START
	
	'20240314_01 KBC : 클라우드공동인증서 도입
	'	0.01과 같이 아주 짧은 주기의 타이머 이벤트는 
	'	onTimerEvent에서 바로 해제하더라도 여러번 타게됨
	'	문제해결을 위해서 g_bRunAfterInit을 추가하여 1번만 실행되도록 처리함
	g_bRunAfterInit = false
	Form.setTimerEvent2(9,1,0.01) 	
End Sub

'============================================================================
'20220805_01 KBC : 로그인개선
'iOS에서는 Form_OnFormInit에서 실행 시 맵에서 앱 이벤트메시지를 못받아서  바꿈
Sub Form_OnAfterInit()
	g_sBIOTermID 			= ""
	g_sPlainRm 			= ""
	g_sRcnoPlainRm		= ""
	g_sRCNO_PIP			= ""
	g_sID 				= ""
	g_sPass 				= ""
	g_sCertPass 			= ""
	g_SSTM_Date 			= "00000000"
	g_sBIOAthnTchnCode	= DEF_BIO_FINGER
	g_sCertLogin 			= DEF_CERT
	
	'20210222 SWJ START : 모바일OTP 비밀번호 재설정 화면으로 전환
	g_sLoginReq 			= Form.GetSharedData("&90060_motpS", True)
	g_sLogForce 			= Form.GetSharedData("&90060_motp", True)
	'20210222 SWJ END
	
	sLoginID = Form.GetSharedData("&USER_ID", 0)

	if Trim(sLoginID) == "" then
		Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	end if
	
	if g_sBIOTermOS == DEF_IOS then
		'20230616 SWJ START : 이미지 변경
		ContainerBio.ContainerALL.ImageFinger.imgpath 		= "icon_bio.png"
		ContainerBio.ContainerFinger.ImageFinger.imgpath	 	= "icon_bio.png"
		ContainerBio.ContainerALL.ImagePIN.imgpath 			= "icon_password.png"
		ContainerBio.ContainerPIN.ImagePIN.imgpath 			= "icon_password.png"	
		
		'ContainerBio.ContainerALL.ImageFinger.imgpath 		= "btn_login_bio_finger_face_n.png"
		'ContainerBio.ContainerFinger.ImageFinger.imgpath	 	= "btn_login_bio_finger_face_n.png"
		'ContainerBio.ContainerALL.ImagePIN.imgpath 			= "btn_login_bio_pin_n.png"
		'ContainerBio.ContainerPIN.ImagePIN.imgpath 			= "btn_login_bio_pin_n.png"		
		'20230616 SWJ END
		
	else
		'20230616 SWJ START : 이미지 변경
		ContainerBio.ContainerALL.ImageFinger.imgpath 		= "icon_bio.png"
		ContainerBio.ContainerFinger.ImageFinger.imgpath	 	= "icon_bio.png"
		ContainerBio.ContainerALL.ImagePIN.imgpath 			= "icon_password.png"
		ContainerBio.ContainerPIN.ImagePIN.imgpath 			= "icon_password.png"	
		
		'ContainerBio.ContainerALL.ImageFinger.imgpath 		= "btn_login_bio_finger_n.png"
		'ContainerBio.ContainerFinger.ImageFinger.imgpath	 	= "btn_login_bio_finger_n.png"
		'ContainerBio.ContainerALL.ImagePIN.imgpath 			= "btn_login_bio_pin_n.png"
		'ContainerBio.ContainerPIN.ImagePIN.imgpath 			= "btn_login_bio_pin_n.png"		
		'20230616 SWJ END
	end if

	sVersion			= Form.GetSharedData("&APP_VERSION", 0)
	Label1.caption	= "Ver " & sVersion

	bSaveId			= Form.GetEnvData("login.input.saveid")
	sSaveTab			= Form.GetEnvData("login.input.savetab")

	'메모리평문 적용유무
	g_sPlainRm 		= Form.GetSharedData("&PLAIN_RM", false)
	g_sRcnoPlainRm 	= Form.GetSharedData("&RCNO_PLAIN_RM", false)
	
	'ID, ID저장체크박스
	if bSaveId <> null and bSaveId <> "" then
		if bSaveId == "1" then
			Form.SetCtlProp("ContainerID.chkSaveID"		, "checkstate", bSaveId)

			sId = Form.GetEnvData("login.input.userid") 
			
			'20230714 SWJ START : 무id는 세팅안해줌
			if DecideNoID(sId) == True then
				sId = ""
			end if
			'20230714 SWJ END
			
			if sId <> null and sId <> "" then
				Form.SetCtlProp("ContainerID.edtID"		, "caption", sId)
				Form.SetCtlProp("ContainerSpin.edtID"	, "caption", sId)
				Form.SetCtlProp("ContainerBio.edtID"		, "caption", sId)
			else
				Form.SetCtlProp("ContainerID.edtID"		, "caption", "")
				Form.SetCtlProp("ContainerSpin.edtID"	, "caption", "")
				Form.SetCtlProp("ContainerBio.edtID"		, "caption", "")
			end if	
		
		elseif bSaveId == "0" then
			Form.SetCtlProp("ContainerID.chkSaveID"		, "checkstate", bSaveId)
		end if
		
		g_sSiseCheck = Form.GetEnvData("login.input.siseonly")
		Form.SetCtlProp("ContainerID.chkSise", "checkstate", g_sSiseCheck)
		
		if g_sSiseCheck == "1" then	
			ContainerID.edtCertPass.visible = false
			ContainerID.ImageLine1.visible = false
		else
			ContainerID.edtCertPass.visible = true
			ContainerID.ImageLine1.visible = true
		end if
	end if

	g_sMockDealCheck = Form.GetEnvData("login.input.mockdeal")
	
	if g_sMockDealCheck == "1" then
		ContainerID.visible = true
		lblCertCenter.visible = true
		lblMobileAcctOpen.visible = true
		lblNewCustomer.visible = true
		Label4.visible = true
		Label6.visible = true
		
		ContainerID.btnLogin.caption = "해외모의투자 로그인"
		Form.SetCtlProp("ContainerID.chkSise", "enable", "0")
		Form.SetCtlProp("ContainerID.chkSise", "visible", "0")	
		Form.SetCtlProp("ContainerID.lblIDSearch", "visible", "0")
	else
		g_sMockDealCheck = "0"
		Form.SetCtlProp("ContainerID.chkSise", "enable", "1")
	end if
	
	Form.SetCtlProp("ContainerID.chkMockDeal", "checkstate", g_sMockDealCheck)
	
	if g_sMockDealCheck == "1" or g_sSiseCheck == "1" then	
		ContainerID.edtCertPass.visible = false
		ContainerID.ImageLine1.visible = false
	else
		ContainerID.edtCertPass.visible = true
		ContainerID.ImageLine1.visible = true
	end if
	
	g_DeviceId		= Form.GetDeviceID2() 				'20230524 SWJ START(ANDROID_ID와 DEVICE_ID 통합)
	
	'g_sBioEnbl
	'   android : 0.미지원 1.지원(지문가능) 2.지원(지문불가)
	'   iOS : 0.지문미등록 1.지문등록	
	g_sBioEnbl = Form.GetKftcBioDeviceEnbl()
	
	if g_sBIOTermOS == DEF_IOS Then
		g_sBioEnbl = "1" 'iOS는 무조건 enable
	else
		'KITKAT에서 바이오인증이 정상처리 되지 않아서 임시 처리함 (결제원 확인중)
		szSdkVer = Form.GetSharedData("&SDK_VERSION", False)
		if Cint(szSdkVer) < 21 then
			g_sBioEnbl = "0"
		end if
		
		if g_sBioEnbl == "2" then '바이오인증 지원 여부 : 2.지원(지문불가)
			ContainerBio.ContainerALL.ImageFinger.enable = false
		end if
	end if
	
	if g_sBioEnbl == "0" And sSaveTab == DEF_TAB_BIO then	'바이오 미지원 시 보이지 않도록 처리함.
		sSaveTab = DEF_TAB_CERT						'바이오 미지원 단말에서 바이오선택형이라면 공동인증을 초기 화면으로 변경.
	end if
	
	if sSaveTab == "" then 
		if sId <> null and sId <> "" then
			sSaveTab = DEF_TAB_ATON 	'DEF_TAB_CERT		'20230616 SWJ START : 디폴트 로그인 방식 메리츠 간편인증으로 변경
		end if
	end if

	poc_LoginTypeSelect(sSaveTab, false) 'sSaveTab 0:간편인증, 1:인증서로그인, 2:ID로그인, 3:바이오인증, 4:모의투자 8.메리츠 간편인증

	g_bExpiredChecked = True	
	
	'------------------------------------------------------------------
	'위변조방지 스킵 대응
	szDev 		= Form.GetSharedData("&SERVER_MODE", False)
	szPrivateKey	= "vjdDoV5kQc7lNK4VARxk0TSWA4k=\n"
	
	if g_sBIOTermOS == DEF_ANDROID then
		g_sDeviceID = Form.GetSharedData("&ANDROID_ID",false)	'20211202 HWG
	else
		g_sDeviceID = Form.GetDeviceID() 
	end if
	
	if szDev == "1" then '개발기
		ContainerBio.edtID.visible = true
		ContainerSpin.edtID.visible = true
		
		szSignKorea = Form.getEnvData("etc.signkorea.server_dev")
		ContainerCloudCert.ChkSignKoreaDEV.checkstate = szSignKorea		
		ContainerCloudCert.ChkSignKoreaDEV.visible = true
	end if
	
	if szDev <> "1" and g_sBIOTermOS == DEF_ANDROID then
		szKeyValue = Form.GetSharedData("&KEY_VALUE", False)
		if trim(szPrivateKey) <> trim(szKeyValue) then
			Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
			Form.SetSharedData("&SGB" , "BBE") 
			
			Form.sendItemPrice()
			Form.sendMessage()
			Form.TerminateApp()
			exit sub
		end if
	end if
	
	'비밀번호 에디트 컨트롤 분기처리(1: 일반비밀번호 / 2: 계좌비밀번호)
	if g_sPlainRm == "1" then
		Form.SetCtlProp("ContainerID.edtPass", "password", "2")
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()

	Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")

	Edit0.caption = "end" '20190702_01 KBC : 이것을넣어야 로그인창이 빨리 닫힘 (visible false주면 다시 느림)
	
	'20220805_01 KBC START : 로그인개선
	szLoginType = Form.GetSharedData("&LOGIN_TYPE", False)
	Form.SendReturnToParent( "Login_Type", szLoginType ) '로그인여부를 리턴받고싶어하는 화면이 있어 추가 함 (개발팀 화면)
	
	'간편인증 가입을 위한 공동인증 로그인 시, 간편인증센터 자동 팝업
	if szLoginType = "2" or szLoginType = "3" then
		if g_bSpinReg == true then
			Form.SetEnvData(1, "login.input.savetab", DEF_TAB_PIN)
			Form.OpenScreen("86030", "")
			exit sub
		end if
	end if
	'20220805_01 KBC END
	
	'===========================================================================
	' 20190905 LES START 수임계좌 비밀번호 사용현황
	'===========================================================================
	outblock8_prosYn1 = DATAMANAGER.GetDataValue(0, "obcsb_efif_005r", "OutBlock8", "PROS_YN1" , 0)
	outblock8_prosYn2 = DATAMANAGER.GetDataValue(0, "obcsb_efif_005r", "OutBlock8", "PROS_YN2" , 0)
		
	if outblock8_prosYn1 = "Y" or outblock8_prosYn2 = "Y" then
		Form.OpenScreen("84032" , "") '84032.수임계좌 비밀번호 사용현황
	end if
	
	'===========================================================================
'	'20200402 SWJ START : 종금상품 종료안내 팝업 삭제
'	szProsYN = DATAMANAGER.GetDataValue(0, "obcsb_efif_005r", "OutBlock7", "PROS_YN" , 0)
'	
'	if szProsYN == "Y" then
'		bPopYN = Form.GetEnvData("CMAPOPUP")
'		if bPopYN == "" or bPopYN == "0" then
'			Form.OpenPopup("notice_p9" , "" , "")
'		end if
'	end if
'	'20200402 SWJ END
'	
'	'20200407 야간선옵 매매관련 팝업
'	saveDate = Form.LoadConfigData("NoticeSetting", "notice_p9")
'	todayDate = Form.GetSharedData("&HOST_DATE",0)
'	
'	if saveDate <> todayDate then
'		Form.OpenPopup("notice_p9" , "" , "")
'	end if
'	
'	'20200428 SWJ START: S&P 기초지수 변경에 따른 투자 주의사항 팝업
'	saveDate = Form.LoadConfigData("NoticeSetting", "notice_p9")
'	todayDate = Form.GetSharedData("&HOST_DATE",0)
'	
'	if saveDate <> todayDate then
'		Form.OpenPopup("notice_p9" , "" , "")
'	end if
'	'20200428 SWJ END
	
	'===========================================================================
	'CFD계좌 계약서 승인 내역 팝업 20210706 HSZ 
	'===========================================================================
	Form.SetSharedData( "MBBDM85134_LOGIN", g_sCertLogin)
	
	cfdact_yn   = DATAMANAGER.GetDataValue(0, "obcsb_efif_005r", "OutBlock10", "CFD_ACNT_HLDN_YN" , 0)
	cfdagrm_yn  = DATAMANAGER.GetDataValue(0, "obcsb_efif_005r", "OutBlock10", "CNFR_YN" , 0)
	isaagrm_yn  = DATAMANAGER.GetDataValue(0, "obcsb_efif_005r", "OutBlock10", "MDTP_ISA_APLT_YN" , 0)

	if cfdact_yn = "Y" and cfdagrm_yn = "N" then	
		Form.OpenPopup("mbbdm85134_p2" , "" , "")
	
	'CFD 계좌승인 팝업이 1순위, 이후 중개형ISA 이전신청 팝업 대상자면 띄우기
	else
		if isaagrm_yn = "Y" then
			Form.OpenPopup("mbbdm85134_p3","","")
		end if
	end if
	
	' 비대면 신용공여이벤트
	eventType = DATAMANAGER.GetDataValue(0, "obcsb_efif_005r", "OutBlock6", "BSWR_TYPE_CODE" , 0)
	'20230518 HSZ : 로그인 안하고 화면 닫는 경우 에러방지
	eventPopup = "1"
	if Trim(g_sID) <> "" then	
		eventPopup = Form.GetEnvData(g_sID&"BDMEVENTPOPUP_NEW4") '20220413 SWJ : 4차 이벤트 적용으로 인해 키값변경("003"이 3차->4차 대상자가 됨)
	end if
	'20230518 HSZ END
	
	'20210421 SWJ START
	'20200422 SWJ : 신용공여 2차 이벤트		
	'기존 비대면 2차 연장이벤트 대상이 -3영업일 ~ 이벤트 종료일 사이에 
	'정상적으로 이벤트 대상인 경우 팝업 게시
	if eventPopup == "" or eventPopup <> "1" then
			
		if g_sSiseCheck <> "1" and eventType == "003" then
		
			regYn = DATAMANAGER.GetDataValue(0,"obcsb_efif_005r", "OutBlock6", "REG_YN" , 0)
			
			if regYn == "Y" then
				'20190329 HWG START : 비대면 신용공여이벤트 연장
				'szDate  = DATAMANAGER.GetDataValue(0, "obcsb_efif_005r", "OutBlock6", "APLY_STA_DATE"  , 0)
				'szDate2 = DATAMANAGER.GetDataValue(0, "obcsb_efif_005r", "OutBlock6", "APLY_FIN_DATE"  , 0)
				
				'szData = szDate&"★"&szDate2
				'20190329 HWG END
				
				Form.OpenPopup("mhetc90021_credit2" , szData , "")					
			end if
		end if
	end if
	'20210421 SWJ END		
	
	'20210429 SWJ START : 이벤트 참여 화면 전환
	g_bdmevntFlag = Form.GetSharedData("BDM_CORPORATE", True)
	
	if g_bdmevntFlag == "Y" then
		if g_bCloseForm And g_bExpiredChecked then
			Form.OpenPopup("banner_p0" , "" , "")
		end if
	end if
	'20210429 SWJ END
	
	'20210222 SWJ START: 모바일OTP 비밀번호 재설정 및 등록 화면으로 전환 
	'비밀번호 재설정
	if g_sLoginReq == "LOGIN_REQ" then
		if g_bCloseForm And g_bExpiredChecked then
			Form.SetSharedData("BDM_NMETBSWRGB", "301")
			'Form.OpenPopup("mbbdm85110.xmf", "", "") 	'mbbdm85110 : 비대면 휴대폰 본인인증
			Form.OpenPopup("mbbdm86130.xmf", "", "") 	'mbbdm86130 : 비대면 휴대폰 본인인증(NEW) '20230427 수정
		end if
	end if
	
	'모바일OTP등록
	if  g_sLogForce == "LOG_FORCE" then	
		if g_bCloseForm And g_bExpiredChecked then
			Form.OpenPopup( "mbotp86100.xmf" , "" , "" )  'mbotp86100 : 모바일 OTP 발급
		end if
	end if
	'20210222 SWJ END	
	
	if g_register = "Y" then	    
		Form.OpenPopup("mhetc90190_s1" , "mhetc90021" , "")
	end if
	
	'20230619 SWJ START
	szBioRegister = Form.GetSharedData("90021_BioRegister" , false)
	sBioType = Form.getBiometryType()
	
	if szBioRegister == "LoginBioRegister" then
		'Form.OpenPopup("mhetc90190" , szBioRegister , "")
		Form.OpenPopup("mhetc90190_s5" , sBioType , "")
	end if
	'20230619 SWJ END
	
	'20230714 SWJ START : 간편인증 갱신 기간 안내 팝업 처리(갱신 기간인 경우 하루 한번만)
	sHostDate = Form.GetSharedData("&HOST_DATE", false )
	sPopupOnce = Form.LoadConfigData("LoginPopup", sHostDate)
	
	if g_RenewYN == "Y" and sPopupOnce == "" then
		ReExpiredDate = left(g_AtonExpired,4)&"-"&mid(g_AtonExpired,5,2)&"-"&right(g_AtonExpired,2)
		RetodayDate 	= left(sHostDate,4)&"-"&mid(sHostDate,5,2)&"-"&right(sHostDate,2)
		
		calcDate = tonumber(DateDiff("d",RetodayDate, ReExpiredDate))
		szEndYMD = left(g_AtonExpired, 4) & "년 " & Mid(g_AtonExpired, 5 ,2) & "월 " & Right(g_AtonExpired, 2) & "일"
		
		Form.SetSharedData("ExpiredNotice" , calcDate & "★" & szEndYMD )
		Form.SaveConfigData("LoginPopup", sHostDate, "Y")
		
		Form.OpenPopup("mpopup_auth", "ExpiredNotice" , "")
	end if
	'20230714 SWJ END
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "certskip" then
		if sRet == "ok" then
			
			'20240604 SWJ START
			'간편인증 종료 안내(테스트를 위한 추가)
			'g_bExpiredChecked 플래그를 써야 로그인 창이 일단 안닫히고
			'확인이나 닫기 버튼을 누르면서 메뉴 화면 전환이 가능하다
			if g_bCertSpinNotice and CertSpinEndNOtice() = True then
				g_bExpiredChecked = False
			end if
			'20240604 SWJ END
			
			if g_sSiseCheck == "1" then
				Form.MsgBox("알림", "고객님께서는 현재 시세조회전용으로 접속하셨습니다. \n\n주문 및 계좌조회 서비스는 불가하오니 모든 거래를 원하시면 시세조회전용 선택을 해제 후 다시 접속하시기 바랍니다.\n", "", 0)			
				
				DATAMANAGER.RequestTranData("ohhts_logn_dupt")
			else
				DATAMANAGER.RequestTranData("ohhts_logn_dupt")
			end if		
		end if
		
	elseif sKeyName == "DplcPrms" then	
		 if sRet == "ok" then
			DATAMANAGER.SetDataValue(0, "ohhts_kick_dupt", "InBlock1", "PROS_CLS" , 0 , g_sDplcPrms) 
			DATAMANAGER.RequestTranData("ohhts_kick_dupt")		 
		 end if
	
	'모의투자 중복접속 체크
	elseif sKeyName == "DplcPrms_Mock" then	
		 if sRet == "ok" then
			DATAMANAGER.SetDataValue(0, "ohhts_kick_dupt_1", "InBlock1", "PROS_CLS" , 0 , g_sDplcPrms) 
			DATAMANAGER.RequestTranData("ohhts_kick_dupt_1")		 
		 end if
	
	elseif sKeyName == "CheckSystem" then	
		Form.CloseForm()

	elseif sKeyName == "FIDO_UPDATE" then	
		if sRet == "ok" then
			Form.setKftcBioInstalled()
		end if
	
	elseif sKeyName == "FIDO_JOIN" then
		if sRet == "ok" then	
			Form.OpenFramePopup("mhetc90110", "Y", "")
		end if	
	
	elseif sKeyName == "AppCheck" then
		Form.TerminateApp()

	elseif sKeyName == "mockdeal_y" then
		if sRet == "ok" then	
			Form.SetEnvData(1, "login.input.mockdeal", "1")
			
			'20190319 HWG START : 실장/모의투자 계정정보 스위칭
			szOsType = Form.GetSharedData("&OS_TYPE", False)
			
			if szOsType == "1" then
			
				sRealID		= Form.GetEnvData("login.input.userid")
				sRealChkID 	= Form.GetEnvData("login.input.saveid")	
				sRealChkSise 	= Form.GetEnvData("login.input.siseonly")	
				
				if sRealChkID == null then
					sRealChkID = "1"
				end if
				
				if sRealChkSise == null then
					sRealChkSise = "0"
				end if
				
				sMockInfo = Form.LoadConfigData("LoginInfo_Mock", "MockInfo")
				szData = Split(sMockInfo, "|")
				
				If UBOUND(szData) < 1 then
					sMockID = ""
					sMockChkID = "1"
				else
					sMockID = szData(0)
					sMockChkID = szData(1)
				end if
				
				Form.SetEnvData(1, "login.input.userid", sMockID)
				Form.SetSharedData("&USER_ID" , sMockID)
				
				if sMockChkID == null then
					Form.SetEnvData(1, "login.input.saveid", "1")
				else
					Form.SetEnvData(1, "login.input.saveid", sMockChkID)
				end if
				
				Form.SetEnvData(1, "login.input.siseonly", "0")
				
				szTemp = sRealID & "|" & sRealChkID & "|" & sRealChkSise
				Form.SaveConfigData("LoginInfo_Real", "RealInfo", szTemp)
			
			elseif szOsType == "2" then
				Form.SetEnvData(1, "login.input.userid", "")
				Form.SetEnvData(1, "login.session.userid", "")
				Form.SetEnvData(1, "login.input.saveid", "1")
				Form.SetEnvData(1, "login.input.siseonly", "0")
				Form.SetSharedData("&USER_ID" , "")				
			end if
			'20190319 HWG END
			
			g_sMockDealCheck = "1"
			Form.restartApp()
		else
			ContainerID.chkMockDeal.checkstate = "0"
		end if
		
	elseif sKeyName == "mockdeal_n" then
		if sRet == "ok" then	
			Form.SetEnvData(1, "login.input.mockdeal", "0")
			
			'20190319 HWG START : 실장/모의투자 계정정보 스위칭
			szOsType = Form.GetSharedData("&OS_TYPE", False)
			if szOsType == "1" then
			
				sMockID = Form.GetEnvData("login.input.userid")
				sMockChkID = Form.GetEnvData("login.input.saveid")	
				
				if sMockChkID == null then
					sMockChkID = "1"
				end if
				
				sRealInfo = Form.LoadConfigData("LoginInfo_Real", "RealInfo")
				szData = Split(sRealInfo, "|")
				
				If UBOUND(szData) < 1 then
					sRealID = ""
					sRealChkID = "1"
					sRealChkSise = "0"
				else
					sRealID = szData(0)
					sRealChkID = szData(1)
					sRealChkSise = szData(2)
				end if
	
				Form.SetEnvData(1, "login.input.userid", sRealID)
				Form.SetSharedData("&USER_ID" , sRealID)
				
				if sRealChkID == null then
					Form.SetEnvData(1, "login.input.saveid", "1")
				else
					Form.SetEnvData(1, "login.input.saveid", sRealChkID)
				end if
				
				if sRealChkSise == null then
					Form.SetEnvData(1, "login.input.siseonly", "0")
				else
					Form.SetEnvData(1, "login.input.siseonly", sRealChkSise)
				end if
				
				szTemp = sMockID & "|" & sMockChkID
	
				Form.SaveConfigData("LoginInfo_Mock", "MockInfo", szTemp)
				
			elseif szOsType == "2" then
				Form.SetEnvData(1, "login.input.userid", "")
				Form.SetEnvData(1, "login.session.userid", "")
				Form.SetEnvData(1, "login.input.saveid", "1")
				Form.SetEnvData(1, "login.input.siseonly", "0")
				Form.SetSharedData("&USER_ID" , "")
			end if
			'20190319 HWG END
			
			g_sMockDealCheck = "0"
			Form.restartApp()
		else
			ContainerID.chkMockDeal.checkstate = "1"
		end if
	
	'20190319 HWG START : 모의투자 참가신청 유도
	elseif sKeyName == "mockdeal_regi" then
		if sRet == "ok" then	
			Form.SetSharedData("&SCREEN_NO" , "00013")
			Form.OpenFramePopup("mhtrd00010" , "" , 0) 'mhtrd00010.xmf : 모의투자 웹링크화면 (모의투자 참가신청/취소)
		else
			Form.MsgBox("알림", "모의투자 참가신청이 확인되지 않습니다.\n참가시청하시기 바랍니다.\n[서비스응답코드 : 1022]", "", 0)
		end if
		
	elseif sKeyName == "APP_UPDATE" then
		if sRet == "ok" then	
			szOsType = Form.GetSharedData("&OS_TYPE", false )
			if szOsType == "1" then
				Form.runStoreApp("", "market://details?id=com.imeritz.smartmeritz")
			elseif szOsType == "2" then
				Form.OpenAppStore("1104272974")
			end if
		end if
	'20190319 HWG END
	
	'20210222 SWJ START
	elseif sKeyName == "force_close" then
		if sRet == "close" then
			g_bCloseForm = false
			Form.CloseForm()
		end if
	'20210222 SWJ END
	
	'20210708 HSZ START : 모의투자 로그인 분기처리
	elseif sKeyName == "MOCKBACKPRESS" then
		if sRet == "ok" then
			Form.TerminateApp()
		end if
	'20210708 HSZ END
	
	'20220805_01 KBC : 로그인개선
	elseif sKeyName == "MdfyPswd" then
		if sRet == "no" then
			Form.OpenFramePopup("mhetc90020_pb" , sOpenData , sPosInfo) '비밀번호 재설정
		end if
		
	'20230524 SWJ START
	elseif sKeyName == "E4106" then
		if sRet == "ok" then
			g_AtonLogin = "PIN"
			ContainerAton_btnLogin_OnClick() '메리츠 간편인증 로그인하기 클릭
		else
			'Form.CloseForm()
		end if
		
	elseif sKeyName == "030104" or sKeyName == "030201" then
		if sRet == "ok" then
			Form.OpenNextPopup("mhetc90190_s1" , "mhetc90021" , "")
		end if
	
	'20240627 SWJ START
	elseif sKeyName == "SpinLoginEnd" then
		g_bSpinLoginEnd = True
		
		Form.openPopupAnimation("mhetc90021_p7", "" ,"","2") '다른 방식으로 로그인 팝업
	end if	
End Sub

'============================================================================
Sub Form_OnCertEvent(sType  , sSucces , stext)
	if sType == "RetIsCertPasswordValid" then
		if sSucces == "Success" then  '성공
			Form.SetEnvData(1,"login.input.userid",g_sID)
			Form.SetCertDNPW(g_sDN, g_sCertPass)

			'ID로그인
			if g_sCertLogin == DEF_ID then 
				Request_obcpp_logn_015a("Y")
				Request_obcpp_pcrt_166a()	
				
			'인증서로그인
			elseif g_sCertLogin == DEF_CERT then
				Request_obcpp_logn_017a("Y")
			end if

		elseif sSucces == "Failed" then '비밀번호 오류
			'ID로그인
			if g_sCertLogin == DEF_ID then
				Request_obcpp_logn_015a("N")
				
			'인증서로그인
			elseif g_sCertLogin == DEF_CERT then
				Request_obcpp_logn_017a("N")
			end if

		elseif sSucces == "Error" then ' 인증서 없음
			Form.OpenDialog("mhetc90020_perr", "", "") '인증서 없음 처리
		end if
	
	'간편인증 시 기존 로그인의 인증 비밀번호횟수 관리를 하지말자고 함 (시스템개발팀협의)
	elseif sType == "RetIsAutoCertPasswordValid" then	
		if sSucces == "Success" then  '성공
			Form.SetEnvData(1,"login.input.userid",g_sID)
			Form.SetCertDNPW(g_sDN, g_sCertPass)
			
			'20240604 SWJ START
			'간편인증 종료 안내
			g_bCertSpinNotice = True
			'20240604 SWJ END
			
			Request_obcpp_pcrt_166a()
				
		elseif sSucces == "Failed" then '비밀번호 오류
			Form.ShowAlert("알림", "인증서 비밀번호 오류입니다. 간편인증서비스 재설정해주시기 바랍니다.")
			
		elseif sSucces == "Error" then '인증서 없음
			Form.OpenDialog("mhetc90020_perr", "", "")
		end if		
	end if	
End Sub


'============================================================================
'20180730_01 NOHES : 아이폰 login 창 close를 위한 정리
'g_bAccAlarmClose(계좌알림안내확인) g_bCloseForm(efif_005r 응답확인) g_bExpiredChecked(인증서만료확인)
'위의 3가지 전역변수를 모두 만족해야만 로그인창을 닫을 수 있다.
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'mhetc90060_pe 인증서목록화면에서 리턴
	if sKeyName == "Login_Close" then
		g_sDN = Form.GetSharedData("CERT_DN", 0)
		
		Form.SetEnvData(1,"login.input.userdn",g_sDN)
		procSelectedCert(g_sDN)
	
	'인증서 없음 처리 mhetc90020_perr 등록된 인증서 없음 화면에서 리턴
	elseIf sKeyName == "pError" then
		If sRet == "Cert" then
			'KBC : CloseForm 먼저 하지 말아라. 안드로이드에서 null참조오류난다.
			Form.OpenScreen("90060" , "") '인증센터 팝업
			Form.CloseForm()
		End If
		
	'20240314_01 KBC : 클라우드공동인증서 도입 
	'	mhetc90300 인증서목록화면에서 리턴
	elseif sKeyName == "CloudLogin_Close" then
		g_sDN = Form.GetSharedData("CLOUDCERT_DN", 0)
		Form.SetEnvData(1,"login.input.userdn",g_sDN)
		Form.requestCertCommand("CLOUD_REQ_CERT_LIST", "CLOUD", "90021") '응답이벤트에서 procSelectedCloudCert(g_sDN) 실행
				
	'=======================================================================================================
	'투자성향진단 업무변경사항
	' mbonl88000_p1맵 -> 팝업리턴은 mbonl8800_p1 로 주고있다. 위 로직 오타 아니다.
	'=======================================================================================================
	'비대면신용공여이벤트(90021_p5)
	elseif sKeyName == "mbonl8800_p1" or sKeyName == "mbonl81010_p5" or sKeyName == "mhetc90021_p4" or sKeyName == "mhetc90021_p5" or sKeyName == "mhetc90021_credit2" then
		g_bCloseForm = True
		
		if g_bCloseForm And g_bExpiredChecked then
			Form.CloseForm()
		end if
		
	'20220829 SWJ START : KYC 만료안내 팝업 (진단하기 버튼 후 OpenScreen 하기 위함)
	elseif sKeyName == "mbonl81010" then
		if sRet = "Y" then
			Form.OpenScreen("81010" , "")
			Form.CloseForm()
		end if
	'20220829 SWJ END
	
	'20210601 HSZ START : 해외파생 개인정보처리 팝업 
	elseif sKeyName == "mhtrd44500_onepop" then
		g_bCloseForm = True
		
		if g_bCloseForm And g_bExpiredChecked then 
			Form.CloseForm()
		end if
	'20210601 HSZ END
	'=======================================================================================================
	'CDD재이행 주기 도래 고객에 대한 안내 팝업창 제공 - 201608 나숙희과장 요청
	'=======================================================================================================
	'CDD이행주기 안내팝업
	elseif sKeyName == "mhetc90020_pd" then
		'v001 CDD이행주기안내 팝업에서 등록 버튼을 누를 경우 CDD등록 팝업 처리
		'20180906 LES START : CDD재이행 안내팝업에서 등록버튼을 누른경우
		'20190715 LES START : 아이폰에서 &USER_ID 정상적으로 못받아오는 현상 수정
		if sRet == "REG" then
			'szData = "90020_pd" & "★" & Form.GetSharedData("&USER_ID", false )
			'Form.ShowAlert("621", g_sID)
			szData = "90020_pd" & "★" & g_sID
			Form.OpenFramePopup("mhetc90020_cddReg" , szData , "")
		
		'20180906 LES END : CDD재이행 안내팝업에서 닫기버튼을 누른경우
		Else
			Form.SetEnvData(1, "90020_pd_opened", sRet) 'sRet : 일자 (오늘하루 다시보지않기 : 당일일자, 그 외 "99999999")
			g_bCloseForm = True
			
			if g_bCloseForm And g_bExpiredChecked then
				Form.CloseForm()
			end if
		End If
	
	'=======================================================================================================
	'간편인증 이용안내
	'=======================================================================================================
	elseif sKeyName == "mhetc90070_p1" or sRet == "Y" then
		Form.CloseForm()
		
	'=======================================================================================================
	'인증서 만료안내 팝업 제공
	'=======================================================================================================		
	elseif sKeyName == "mhetc90021_p2" then
		g_bExpiredChecked = True
		
		if g_bCloseForm And g_bExpiredChecked then
			Form.CloseForm()
		end if
	
	'20240604 SWJ START
	elseif sKeyName == "mhetc90021_p9" then
		g_bExpiredChecked = True
		
		if g_bCloseForm And g_bCertSpinNotice then
			Form.CloseForm()
		end if
	'20240604 SWJ END
	
	'=======================================================================================================
	' 20180906 LES START CDD재이행 팝업 개선
	'=======================================================================================================
	ElseIf sKeyName == "mhetc90020_cddReg" Then
		
		if sRet == "REG" then
			Form.ShowAlert("알림","등록이 완료되었습니다.")
		elseif sRet == "CANCEL" then
			Form.ShowAlert("알림","등록이 취소되었습니다.")
		end if
		
		g_bCloseForm = True
	
		if g_bCloseForm And g_bExpiredChecked then
			Form.CloseForm( )
		end if

	'PENTA13 START => 2018.12.05
	'mhetc90021_p7 로그인방식 선택화면에서 리턴
	ElseIf sKeyName == "Login_Cert_Type" Then	
		'sRet 값
		'	0.간편인증 로그인
		'	1.인증서 로그인
		'	2.ID 로그인
		'	3.바이오인증 로그인
		'	4.모의투자 로그인
		'	5.계좌개설/업무
		'	6.인증센터		
		'	7.닫기
		'	8.메리츠 간편인증 로그인(아톤)
		'	9.클라우드인증 로그인
		
		'모의투자 이면
		if g_sMockDealCheck == "1" then
			'20230905 HSZ: "8" 메리츠간편인증 추가 
			'20240314_01 KBC : 클라우드공동인증서 도입
			if sRet == "0" or sRet == "1" or sRet == "2" or sRet == "3" or sRet == "8" or sRet == "9" then	
				Form.SetEnvData(1, "login.input.savetab", sRet)
				ContainerID_chkMockDeal_OnChange("0") '실장전환
			end if
			
		else
		'모의투자 아니면
			if sRet == "4" then
				'모의장전환
				Form.SetEnvData(1, "login.input.savetab", DEF_TAB_ID)
				ContainerID_chkMockDeal_OnChange("1")

			elseif sRet == "5" then
				
				'20240430 SWJ START
				'로그인 권한 화면 오픈 시
				'로그인 창 -> 계좌개설 클릭-> 이후 다시 로그인 권한 화면 오픈
				
				'이 때 iOS에서 LoginEnd 프로세스를 안타고
				'로그인 프로세스가 계속 진행되어 로그인 창이 안뜨는 버그 수정
				
				'(POPUP_ALL_CLOSE 파라미터는 (AOS는 없는 파라미터)
				'iOS 앱 메인에서 로그인 프로세스 진행 시 예외 처리 되어 있음)
				
				'계좌개설/로그인(최초창)
				'Form.OpenNextPopup("mhetc90022" , "" , "")
				if g_sBIOTermOS == "2" then
					Form.OpenScreen("90022" , "POPUP_ALL_CLOSE")
					Form.CloseForm()
				else
					Form.OpenNextPopup("mhetc90022" , "" , "")
				end if
				'20240430 SWJ END
				
			elseif sRet == "6" then
				'인증센터
				Form.SetSharedData("&SCREEN_AUTH","")
				Form.OpenPopup("mhetc90120" , "1" , "")
			
			elseif sRet == "7" then
				'닫기
				sId = Form.GetEnvData("login.input.userid") 
				if sId == null or sId == "" then
					'계좌개설/로그인(최초창)
					Form.OpenNextPopup("mhetc90022" , "" , "")
				end if
			else										
				sSaveTab = sRet
				ClearAtonInfo()				'20230718 SWJ START : 로그인 방식 변경 시 변수 클리어
				poc_LoginTypeSelect(sSaveTab, false)
			end if
		end if		

	'mhetc90060_pe 인증서목록화면에서 리턴
	ElseIf sKeyName == "Login_Cert_Select" Then 
		if sRet == "0" then
			Form.OpenFramePopup("mhetc90060", "", "") '공동인증센터
		end if
	
	'20240314_01 KBC : 클라우드공동인증서 도입
	'	mhetc90300 인증서목록화면에서 리턴
	ElseIf sKeyName == "Login_CloudCert_Select" Then 
		if sRet == "0" then
			Form.ShowAlert("알림", "클라우드 공동인증센터 팝업 - 개발필요")
		end if		
	
	'20211026 HWG START : TartgetSDK30 업데이트(공동인증서 디폴트값 선택)
	ElseIf sKeyName == "RECHECK_CERT" then 'RECHECK_CERT : mhetc90060->mhetc90120->mhetc90021
		if ContainerCert.visible == true then		
			g_sDN = Form.GetSharedData("CERT_DN", 0)
			
			'인증서 비어있는 상태에서 가져오기하면
			'가져오기 완료 후 바로 최초인증서를 표시해준다.
			if g_sDN == "" then
				Dim sCertCnt
				
				sCertCnt	= Form.GetCertListSize()
				
				if sCertCnt ~= null and sCertCnt ~= "" then
					if CInt(sCertCnt) > 0 then
						Dim sCertInfo, sTemp
			
						sCertInfo = Form.GetCertListDataAt(0)
						sTemp = Split(sCertInfo, ";")
						
						if #sTemp > 7 then
							Form.SetSharedData("CERT_DN", sTemp[1])
							g_sDN = Form.GetSharedData("CERT_DN", 0)
						end if
					end if
				end if
			end if
			
			Form.SetEnvData(1,"login.input.userdn",g_sDN)
			procSelectedCert(g_sDN)
		end if
	'20211026 HWG END
	
	'20230524 SWJ    : 메리츠 간편인증센터 추가
	'20220805_01 KBC : 로그인개선
	'중요 FORM_CLOSE : 
	'	case1) mhetc90110 바이오인증센터 	-> mhetc90021 로그인 전달
	'	case2) mhetc90120 인증센터			-> mhetc90021 로그인 전달
	'	case3) mhetc90190 메리츠 간편인증센터-> mhetc90021 로그인 전달
	ElseIf sKeyName == "FORM_CLOSE" then
		
		if g_sCertLogin == DEF_PIN then
			poc_LoginTypeSelect(DEF_TAB_PIN, false)
			
		elseif g_sCertLogin == DEF_BIO then
			'바이오공동앱 등록 후, 등록여부 리프레쉬 필요
			poc_LoginTypeSelect(DEF_TAB_BIO, false)
			
		elseif g_sCertLogin == DEF_CERT then
			poc_LoginTypeSelect(DEF_TAB_CERT, false)
			
		elseif g_sCertLogin == DEF_ID then
			poc_LoginTypeSelect(DEF_TAB_ID, false)
		
		elseif g_sCertLogin == DEF_ATON then
			poc_LoginTypeSelect(DEF_TAB_ATON, false)
		
		'20240314_01 KBC : 클라우드공동인증서 도입
		elseif g_sCertLogin == DEF_CLOUDCERT then
			poc_LoginTypeSelect(DEF_TAB_CLOUDCERT, false)			
		end if
		
	'중요 FORM_CLOSE_CERT :
	'	mhetc90120 인증센터	-> mhetc90021 로그인 전달
	ElseIf sKeyName == "FORM_CLOSE_CERT" then
		poc_LoginTypeSelect(DEF_TAB_CERT, false)
		
	'PENTA13 END
	
	'20230524 SWJ START : 간편인증 PIN인증 후 후속 처리
	elseif sKeyName == "ATON_PIN_LOGIN" then
		if sRet == "ok" then
			Request_obcpp_logn_056a()
		end if
	
	'간편인증 재등록 안내 팝업
	elseif sKeyName == "mpopup_auth" then
		'재등록
	    if sRet == "register" then
		    g_register = "Y"
		    Form.CloseForm()
		
		'생체인증 재등록
		elseif sRet == "BioInfoChanged" then
			
			'20230619 SWJ START
			'무조건 PIN으로 로그인하도록
			g_AtonLogin = "PIN"
			Form.SetSharedData("90021_BioRegister" , "LoginBioRegister")
			ContainerAton_btnLogin_OnClick() '메리츠 간편인증 로그인하기 클릭	
	    end if
	
	'ID찾기 리턴
	elseIf sKeyName == "mhetc90020_pa" then
			
		ContainerID.edtID.caption = sRet
		
	'20240314_01 KBC : 클라우드공동인증서 도입
	'	로그인, PIN성공후 리턴, 전자서명 수행
	elseif sKeyName == "CLOUDCERT_LOGIN" then
		'----------------------------------------------------------------------------------------------------------------------------
		'클라우드인증서ID★PIN, 서명원문
		'----------------------------------------------------------------------------------------------------------------------------
		sPin = sRet
		sPlain = "meritzsmart"
		
		'DN과 비밀번호를 저장
		Form.SetCertDNPW(tbl_cloudcert("CLOUD_CERT_DN"), sPin) 'DN은 기존인증서 g_sDN와 같이 사용 -> DN대신 클라우드인증서ID를 저장함

		sRslt = Form.requestCertCommand("CLOUD_REQ_SIGNDATA_LOGIN", tbl_cloudcert("CLOUD_CERT_ID") & "★" & sPin & "★" & sPlain, "90021") 
		'응답 후 Request_obcpp_logn_006a_cloud() 호출
		'----------------------------------------------------------------------------------------------------------------------------	

	'클라우드연결(고객정보) 입력 후 리턴 (From mhetc90302)
	elseif sKeyName == "CLOUD_CHECK_CONNECT" then
		if sRet == "OK" then
			ContainerCloudCert.btnCloudConn.visible = False
			
			'로그인 자동진행(클라우드인증) <= 단말인증 후 여기오면 RE_CERT_LIST응답이 앱에서는 주지만 화면에서 받지 못해 다시한번 조회날림
			Form.setTimerEvent2(12,1,0.1)
			
		end if
	end if

End Sub

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName == "KS" then '인증서로그인(비번리턴됨)
		g_sCertPass = sReturn2
		
		'인증서 특수기호 ">"종료글자 오류회피
		sCertPass = Form.GetSharedData("CERT_IMSI_PSWD", 1)
		
		if sCertPass <> null and sCertPass <> "" then
			g_sCertPass = sCertPass
		end if
		
		if g_sCertPass <> "" then
			Form.RequestCertCommand("ReqCheckIsValidPassword", g_sDN, g_sCertPass) '일반(인증서로그인)
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcpp_logn_022a" then	
		g_sCertLogin = DEF_ID
		Form.SetSharedData("&CERT_USE_TYPE" , "0") '0.공인인증서 1.간편인증-공인인증서 2.코스콤지문-공인인증서 3.결제원-FIDO인증서 4.금투협-공동인증서 5.아톤사설인증 6.클라우드인증
		
		sMsg		= DATAMANAGER.GetDataMsgText(szTranID)
		sSubMsg	= DATAMANAGER.GetDataMsgSubText(szTranID)
	
		'접속허용구분 코드
		sClscode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CONN_PRMS_CLS_CODE" ,0)
		
		'부정접속 관련 대응-로그인 실패시
		if sClscode <> "0" then
			Call LoginFailSendHWInfo(g_sID)
		end if

		Select Case  sClscode
			Case  "0" '접속허용(정상로그인)
				Form.SetEnvData(1,"login.input.userid",g_sID)
			Case  "1" '등록되지 않은 ID
				Form.ShowAlert("알림", "등록되지 않은 ID입니다. ID를 확인하시기 바랍니다.")
				exit sub
			Case  "2" '접속비밀번호 오류
				sPassErrCnt		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PWD_ERR_TMNU" ,0)
				sPassAbleErrCnt	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PWD_MSTK_ABLE_TMNU" ,0)
				
				'20220805_01 KBC : 로그인개선
				Form.MsgBox("알림", "ID비밀번호 " & CInt(sPassErrCnt) & "회 오류입니다.\n연속 " & CInt(sPassAbleErrCnt) & "회 오류 시 접속이 제한됩니다.\n\nID비밀번호를 모르시는 경우에는 재설정 후 로그인해주세요.", "MdfyPswd", 7, "확인", "ID비밀번호재설정")
				exit sub
			Case  "3" '접속비밀번호 오류 초과
				
				'20220805_01 KBC : 로그인개선
				Form.MsgBox("알림", "ID비밀번호 5회 오류입니다.\n\nID비밀번호를 5회 연속 잘못 입력하여 접속이 불가능하오니 재설정 후 로그인해주세요.", "MdfyPswd", 7, "확인", "ID비밀번호재설정")
				exit sub
			Case  "5" '비밀번호를 입력 하지 않았을경우
				Form.ShowAlert("알림","비밀번호를 입력하세요.")
				exit sub
			Case  "8" '미등록 단말
				Form.ShowAlert("알림" , "[TR] " & sMsg)
				exit sub
			'20230726 SWJ START
			Case "R" 'MTS 약정 거부
				Form.MsgBox("안내", "모바일서비스 이용거부 상태입니다.\nHTS [7439]에서 이용 신청 후 이용해주세요." , "", 0)	
				exit sub
			'20230726 SWJ END
			Case  "A"
				Form.MsgBox("알림", "시스템 점검시간 " & sSubMsg & "동안은 \n시세조회 전용으로 로그인 됩니다.\n계좌정보 조회 및 이체서비스는\n시스템 점검시간 이후 재접속하셔야만\n이용 가능합니다.", "CheckSystem", 0)
				exit sub
			Case else ' 알 수 없는 오류
				Form.ShowAlert("알림",  "[TR] " & sMsg)
				exit sub
		End Select	
		
		'비밀번호 초기화시에는 체크 않함
		sPassInit = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CONN_PWD_INIT_YN" ,0)
		
		if sPassInit == "N" then
			sWarnCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CONN_WARN_CLS_CODE" ,0)
			
			if sWarnCode == "1" then
				Form.ShowAlert("알림","접속비밀번호가 6~8자리가 아닙니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			elseif 	sWarnCode == "2" then
				Form.ShowAlert("알림","접속비밀번호가 주민등록번호와 4자리 이상이 일치합니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			elseif 	sWarnCode == "3" then
				Form.ShowAlert("알림","연속 또는 같은 영문자 혹은 숫자의 접속비밀번호입니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			elseif 	sWarnCode == "4" then
				Form.ShowAlert("알림","사용자ID와 접속비밀번호가 중복되어 사용하고 있습니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			elseif 	sWarnCode == "5" then
				Form.ShowAlert("알림","계좌번호와 접속비밀번호가 중복되어 사용하고 있습니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			elseif 	sWarnCode == "6" then
				Form.ShowAlert("알림","접속비밀번호가 고객의 전화번호와 중복되어 사용되고 있습니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			end if
		end if
		
		g_sDplcPrms	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DPLC_CONN_PRMS_YN" ,0)	'중복접속허용여부
		g_sRCNO		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RCNO" ,0)				'실명확인번호
		g_sUserName	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "USER_NAME" ,0)			'사용자명
		g_sCSNO		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CSNO" ,0)				'고객번호
		g_sDN		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DN_DATA" ,0)			'DN Data
		g_SSTM_Date	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SSTM_DATE" ,0)			'시스템일자

		if g_sRcnoPlainRm == "1" then
			g_sRCNO = "" '서비스에서 테스트중 평문을 같이 내려줘서 일부러 초기화
			
			'20231206 SWJ START : 조합실명번호PIP로 변경 
			'g_sRCNO_PIP	= DATAMANAGER.GetDataValue(0,szTranID, "OutBlock1", "RCNO_PIP" ,0)		'실명확인번호
			g_sRCNO_PIP	= DATAMANAGER.GetDataValue(0,szTranID, "OutBlock1", "ASCT_PSPR_NO_PIP" ,0)		
			'20231206 SWJ END
		end if

		sCheckState = Form.GetCtlProp("ContainerID.chkSaveID", "checkstate")
		Form.SetEnvData(1, "login.input.saveid",sCheckState)
		
		if g_sMockDealCheck == "1" then
			g_sDplcPrms = "N"
			'중복접속체크
			DATAMANAGER.RequestTranData("ohhts_logn_dupt_1")
			exit sub
		end if
		
		'인증 기관 장애 여부
		sCertSkip = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "AUTH_ATHN_ISTU_DSBL_YN" ,0)
		
		if sCertSkip == "Y"  and  g_sSiseCheck == "0" then
			Form.MsgBox("알림", "현재 인증센터 장애로 인해 전자서명을 사용하지 않고 접속합니다.", "certskip", 2)
		else
			if g_sSiseCheck == "1" then
			
				Form.MsgBox("알림", "고객님 께서는 현재 시세조회전용으로 접속하셨습니다. \n\n주문 및 계좌조회 서비스는 불가하오니 모든 거래를 원하시면 \n\n시세조회전용 선택을 해제 후 다시 접속하시기 바랍니다.\n", "", 0)			
				
				'중복접속체크
				DATAMANAGER.RequestTranData("ohhts_logn_dupt")

			else
				'인증 비밀번호 오류횟수 초과처리
				nFailCnt = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PBCR_PWD_MSTK_TMNU" ,0))
				
				if (nFailCnt >= DEF_CERT_PSWD_LIMIT_CNT) then
					Form.ShowAlert("알림", "인증서 비밀번호 \n최대 오류횟수(" & tonumber(DEF_CERT_PSWD_LIMIT_CNT) &"회) 초과로 \n접속이 제한됩니다.")
				else
					Form.RequestCertCommand("ReqCheckIsValidPassword", g_sDN, g_sCertPass) '로그인 정상 시 인증서 체크시작
				end if
			end if				
		end if
	
	elseif szTranID == "obcpp_logn_006a" or szTranID == "obcpp_logn_006a_1" then
	
		if szTranID == "obcpp_logn_006a_1" then
			'20240314_01 KBC : 클라우드공동인증서 도입
			g_sCertLogin = DEF_CLOUDCERT
			Form.SetSharedData("&CERT_USE_TYPE" , "6") '0.공인인증서 1.간편인증-공인인증서 2.코스콤지문-공인인증서 3.결제원-FIDO인증서 4.금투협-공동인증서 5.아톤사설인증 6.클라우드인증
		else
			g_sCertLogin = DEF_CERT
			Form.SetSharedData("&CERT_USE_TYPE" , "0") '0.공인인증서 1.간편인증-공인인증서 2.코스콤지문-공인인증서 3.결제원-FIDO인증서 4.금투협-공동인증서 5.아톤사설인증 6.클라우드인증
		end if
		
		sMsg = DATAMANAGER.GetDataMsgText(szTranID)

		'접속허용구분 코드
		sClscode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CONN_PRMS_CLS_CODE" ,0)
		
		Select Case  sClscode
			Case  "0" '접속허용(정상로그인)
			
			Case  "1" '등록되지 않은 ID
				Form.ShowAlert("알림", "등록되지 않은 ID입니다. ID를 확인하시기 바랍니다.")
				exit sub
			Case  "2" '접속비밀번호 오류
				sPassErrCnt = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PWD_ERR_TMNU" ,0)
				sPassAbleErrCnt = "5"
				
				Form.MsgBox("알림", "ID비밀번호 " & CInt(sPassErrCnt) & "회 오류입니다.\n연속 " & CInt(sPassAbleErrCnt) & "회 오류 시 접속이 제한됩니다.\n\nID비밀번호를 모르시는 경우에는 재설정 후 로그인해주세요.", "MdfyPswd", 7, "확인", "ID비밀번호재설정")
				exit sub
			Case  "3" '접속비밀번호 오류 초과			
				Form.MsgBox("알림", "ID비밀번호 5회 오류입니다.\n\nID비밀번호를 5회 연속 잘못 입력하여 접속이 불가능하오니 재설정 후 로그인해주세요.", "MdfyPswd", 7, "확인", "ID비밀번호재설정")
				exit sub
			Case  "5" '비밀번호를 입력 하지 않았을경우
				Form.ShowAlert("알림","비밀번호를 입력하세요.")
				exit sub
			Case  "8" '미등록 단말
				Form.ShowAlert("알림",  "[TR] " & sMsg)
				exit sub
			Case  "A" '부메세지에 시간이 들어있음	
				Form.ShowAlert("알림","시스템 점검시간 " & sMsg & "동안은 \n시세조회 전용으로 로그인 됩니다.\n계좌정보 조회 및 이체서비스는 시스템 점검시간 이후 재접속\n하셔야만 이용 가능합니다.")
				exit sub
			'20230726 SWJ START
			Case "R" 'MTS 약정 거부
				Form.MsgBox("안내", "모바일서비스 이용거부 상태입니다.\nHTS [7439]에서 이용 신청 후 이용해주세요." , "", 0)	
				exit sub
			'20230726 SWJ END
			Case else ' 알 수 없는 오류
				Form.ShowAlert("알림",  "[TR] " & sMsg)
				exit sub
		End Select	

		'비밀번호 초기화시에는 체크 않함
		sPassInit = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CONN_PWD_INIT_YN" ,0)
		 
		if sPassInit == "N" then
			sWarnCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CONN_WARN_CLS_CODE" ,0)
			
			if sWarnCode == "1" then
				Form.ShowAlert("알림","접속비밀번호가 6~8자리가 아닙니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			elseif 	sWarnCode == "2" then
				Form.ShowAlert("알림","접속비밀번호가 주민등록번호와 4자리 이상이 일치합니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			elseif 	sWarnCode == "3" then
				Form.ShowAlert("알림","연속 또는 같은 영문자 혹은 숫자의 접속비밀번호입니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			elseif 	sWarnCode == "4" then
				Form.ShowAlert("알림","사용자ID와 접속비밀번호가 중복되어 사용하고 있습니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			elseif 	sWarnCode == "5" then
				Form.ShowAlert("알림","계좌번호와 접속비밀번호가 중복되어 사용하고 있습니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			elseif 	sWarnCode == "6" then
				Form.ShowAlert("알림","접속비밀번호가 고객의 전화번호와 중복되어 사용되고 있습니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			end if
		end if
		
