'============================================================================
'20220805_01 KBC : 로그인개선
'바이오인증 등록정보 조회
Sub ProcRequsetBioRegInfo()
	if g_sID == null or g_sID == "" then
		g_sID = Form.GetEnvData("login.input.userid") 
	end if
			
	if Len(g_sID) > 0 then
		g_005r_bFinger = false
		g_005r_bPin = false
		
		DATAMANAGER.SetDataValue(0, "obcsb_fido_005r", "InBlock1", "ELFN_ID" 	 , 0 , g_sID) 
		DATAMANAGER.SetDataValue(0, "obcsb_fido_005r", "InBlock1", "TERM_OS_CODE" , 0 , g_sBIOTermOS) '1.안드로이드 2.iOS
		DATAMANAGER.SetDataValue(0, "obcsb_fido_005r", "InBlock1", "TERM_ID" 	 , 0 , g_sBIOTermID) 
		
		DATAMANAGER.RequestTranData("obcsb_fido_005r")
	else
		g_sBioReg = "01" '01 : 등록정보없음
		ProcReceiveBioRegInfo()
	end if
End Sub

'============================================================================
'20220805_01 KBC : 로그인개선
'바이오인증 등록정보 수신
Sub ProcReceiveBioRegInfo()
	ContainerBio.btnLogin.enable = true			'20230524 SWJ START : 주석 처리
	
	'g_sBioReg
	'00 : 공동앱 설치안됨
	'01 : 등록정보없음
	'10 : 등록정보있음 (ALL, 최종지문)
	'11 : 등록정보있음 (ALL, 최종PIN)
	'12 : 등록정보있음 (ALL, 최종모름)
	'20 : 등록정보있음 (지문)
	'21 : 등록정보있음 (PIN)
	
	if g_sBioReg == "00" or g_sBioReg == "01" then
		'미등록, 미설치
		ContainerBio.ContainerALL.visible = false
		ContainerBio.ContainerPIN.visible = false
		ContainerBio.ContainerFinger.visible = false			
	
		ContainerBio.ImageLine.left = 20		'20230524 SWJ START : 32 -> 24
		ContainerBio.ImageLine.top = 52			'20230524 SWJ START : 55 -> 52
		ContainerBio.ImageLine.visible = true
		
		ContainerBio.ContainerNotFound.left = 30	'20230524 SWJ START : 32 -> 20
		ContainerBio.ContainerNotFound.top = 58	'20230524 SWJ START : 57 -> 58
		ContainerBio.ContainerNotFound.visible = true
		
		ContainerBio.btnLogin.width = 280		'20230627 SWJ START
		ContainerBio.btnLogin.top = 169			'20230524 SWJ START
		ContainerBio.btnLogin.left  = 50		'20230627 SWJ START
		ContainerBio.btnLogin.caption = "바이오정보 등록 >"
		
'			if g_sBioReg ==  "01" then
'				Form.MsgBox("알림", "바이오인증 서비스 미등록 단말입니다.\n등록 후 이용해주세요.", "FIDO_JOIN", 7, "등록하기", "취소") '바이오인증 서비스 미등록
'			end if
		
	elseif g_sBioReg == "10" or g_sBioReg == "11" or g_sBioReg == "12" then
		'등록, ALL
		ContainerBio.ImageLine.visible = false
		ContainerBio.ContainerNotFound.visible = false
		ContainerBio.ContainerPIN.visible = false
	
		ContainerBio.ContainerALL.left = 20		'20230524 SWJ START (38 -> 20)
		ContainerBio.ContainerALL.top = 52		'20230524 SWJ START (57 -> 52)
		ContainerBio.ContainerALL.visible = true
		
		ContainerBio.btnLogin.width = 320		'20230627 SWJ START
		ContainerBio.btnLogin.top = 151 		'20230524 SWJ START
		ContainerBio.btnLogin.left  = 27		'20230627 SWJ START
		ContainerBio.btnLogin.caption = "로그인"

		if g_sBioReg == "10" then
			'최종지문사용
			ContainerBio.ContainerALL.ImageLineFinger.imgpath = g_sImg_Box_o '선택
			ContainerBio.ContainerALL.ImageLinePIN.imgpath = g_sImg_Box_n
		elseif g_sBioReg == "11" then 
			'최종PIN사용
			ContainerBio.ContainerALL.ImageLineFinger.imgpath = g_sImg_Box_n
			ContainerBio.ContainerALL.ImageLinePIN.imgpath = g_sImg_Box_o '선택
		elseif g_sBioReg == "12" then
			'최종모름
			ContainerBio.ContainerALL.ImageLineFinger.imgpath = g_sImg_Box_n
			ContainerBio.ContainerALL.ImageLinePIN.imgpath = g_sImg_Box_n
		end if
		
	elseif g_sBioReg == "20" then
		'등록, 지문
		ContainerBio.ContainerALL.visible = false
		ContainerBio.ContainerNotFound.visible = false
		ContainerBio.ContainerPIN.visible = false
		
		ContainerBio.ImageLine.visible = false		'20230524 SWJ START
		ContainerBio.ImageLine.left = 20
		ContainerBio.ImageLine.top = 52	
		'ContainerBio.ImageLine.visible = true	     '20230524 SWJ START : 주석 처리
		
		ContainerBio.ContainerFinger.ImageLineFinger.imgpath = g_sImg_Box_o	'20230619 SWJ START
		ContainerBio.ContainerFinger.left = 20							'20230524 SWJ START (38 -> 20)
		ContainerBio.ContainerFinger.top = 54		
		ContainerBio.ContainerFinger.visible = true
		
		ContainerBio.btnLogin.left  = 27		'20230627 SWJ START
		ContainerBio.btnLogin.width = 320		'20230627 SWJ START
		ContainerBio.btnLogin.caption = "로그인"
		ContainerBio.btnLogin.top = 151 			'20230524 SWJ START
		
	elseif g_sBioReg == "21" then
		'등록, PIN
		ContainerBio.ContainerALL.visible = false
		ContainerBio.ContainerNotFound.visible = false
		ContainerBio.ContainerFinger.visible = false
		
		ContainerBio.ImageLine.visible = false		'20230524 SWJ START
		ContainerBio.ImageLine.left = 20
		ContainerBio.ImageLine.top = 52	
		ContainerBio.ContainerPIN.ImageLinePIN.imgpath = g_sImg_Box_o	'20230619 SWJ START
		'ContainerBio.ImageLine.visible = true	     '20230524 SWJ START : 주석 처리		
		
		ContainerBio.ContainerPIN.left = 20			'20230524 SWJ START (38 -> 20)
		ContainerBio.ContainerPIN.top = 54
		ContainerBio.ContainerPIN.visible = true
		
		ContainerBio.btnLogin.left  = 27		'20230627 SWJ START
		ContainerBio.btnLogin.width = 320		'20230627 SWJ START
		ContainerBio.btnLogin.caption = "로그인"
		ContainerBio.btnLogin.top = 151 			'20230524 SWJ START
		
	end if
	
	'바이오인증
	ContainerBio.left = nInitLeft
	ContainerBio.top = nInitTop
	
	ContainerCert.visible = false
	ContainerCloudCert.visible = false
	ContainerSpin.visible = false
	ContainerID.visible = false
	ContainerBio.visible = true
	
	Form.SetEnvData(1, "login.input.savetab", DEF_TAB_BIO)
	
	LabelTitleCert.caption = "바이오인증"	
	
	ContainerBio.visible = true

	'로그인 자동진행(바이오인증)
	Form.setTimerEvent2(6,1,0.1)
End Sub


'============================================================================
Sub Form_OnRefresh()
	'바이오공동앱 설치 후, 설치여부 리프레쉬 필요
	if g_sCertLogin == DEF_BIO then
		poc_LoginTypeSelect(DEF_TAB_BIO, false)
	end if

End Sub
'============================================================================
'20230524 SWJ : 메리츠 간편인증 로그인 화면 설정
'============================================================================
Sub MoveContainerAton(sParam)
	
	'앱에는 인증서 정보가 있는데, 서버에서는 폐기되는 케이스에 대한
	'방어용 플래그 
	'(화면에서 다 막아서 일어나진 않음, 만일의 경우 갱신 처리가 중복처리되면 서버에서는 폐기함)
	g_sAtonParam = sParam
	
	if sParam == "success" then 'success : 인증서 조회 성공
		'메리츠 간편인증
		ContainerAton.left = nInitLeft
		ContainerAton.top = nInitTop
		ContainerAton.ContainerALL.visible = true
		
		ContainerCert.visible = false
		ContainerCloudCert.visible = false
		ContainerSpin.visible = false
		ContainerID.visible = false
		ContainerBio.visible = false
		ContainerAton.visible = true
		
		ContainerAton.btnLogin.width = 320				'20230627 SWJ START
		ContainerAton.btnLogin.left  = 27				'20230627 SWJ START
		ContainerAton.btnLogin.top   = 151				'20230627 SWJ START
		ContainerAton.btnLogin.caption = "로그인"
		ContainerAton.btnLogin.enable = true
		
		'생체인증 등록여부
		'로그인후 갱신안내 팝업에서 알리미 발송 처리할 때 사용함
		if g_AtonBioYn = "Y" then
			szBioType = Form.getBiometryType()
			
			if szBioType = "2" then
				'지문 + Face 등록
				sRegiTypeNum = "01$02"
			else
				'지문 등록
				sRegiTypeNum = "01$03"
			end if
		else
			sRegiTypeNum = "01"
		end if
		
		'간편비밀번호 인증방식 구분 Set
		Form.SetSharedData("MERITZAUTH_REGITYPE", sRegiTypeNum)
		
		Form.SetEnvData(1, "login.input.savetab", DEF_TAB_ATON)
		LabelTitleCert.caption = "메리츠 간편인증"
	else 
		'g_sBioReg = "00" '00 : 공동앱 설치안됨
		
		ContainerAton.visible = true
		
		'미등록, 미설치
		ContainerAton.ContainerALL.visible = false
		ContainerAton.ContainerPIN.visible = false
		ContainerAton.ContainerFinger.visible = false			

		ContainerAton.ImageLine.left = 22
		ContainerAton.ImageLine.top = 55
		ContainerAton.ImageLine.visible = true
			
		ContainerAton.ContainerNotFound.left = 38
		ContainerAton.ContainerNotFound.top = 61
		ContainerAton.ContainerNotFound.visible = true
		
		ContainerAton.btnLogin.top  = 169
		ContainerAton.btnLogin.left = 46
		ContainerAton.btnLogin.width = 284
		ContainerAton.btnLogin.caption = "메리츠 간편인증 등록 >"
		ContainerAton.btnLogin.enable = true

		'메리츠 간편인증
		ContainerAton.left = nInitLeft
		ContainerAton.top = nInitTop
			
		ContainerCert.visible = false
		ContainerCloudCert.visible = false
		ContainerSpin.visible = false
		ContainerID.visible = false
		ContainerBio.visible = false
			
		Form.SetEnvData(1, "login.input.savetab", DEF_TAB_ATON)		
		LabelTitleCert.caption = "메리츠 간편인증"
	end if

	'로그인 자동진행(바이오인증)
	Form.setTimerEvent2(7,1,0.1)
End Sub
'============================================================================
Sub ContainerAton_ContainerALL_ImageFinger_OnClick()
	g_AtonLogin = "BIO"
	
	'최종지문사용
	ContainerAton.ContainerALL.ImageLineFinger.imgpath = g_sImg_Box_o '선택
	ContainerAton.ContainerALL.ImageLinePIN.imgpath = g_sImg_Box_n

End Sub

'============================================================================
Sub ContainerAton_ContainerALL_ImagePIN_OnClick()
	g_AtonLogin = "PIN"
	
	'최종PIN사용
	ContainerAton.ContainerALL.ImageLineFinger.imgpath = g_sImg_Box_n
	ContainerAton.ContainerALL.ImageLinePIN.imgpath = g_sImg_Box_o '선택

End Sub
