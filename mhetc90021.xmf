'============================================================================
Sub procSelectedCert(sDN)
	Dim sCertCnt, sCalDate 
	Dim bFind
	
	sCertCnt	= Form.GetCertListSize()
	sCalDate	= Form.calcDateTime(0, 0, 30, 0, 0, 0)
	sCalDate	= Left(sCalDate, 8)
	bFind	= false
	
	ContainerCert.Grid0.SetClear()
	ContainerCert.Grid0.rowcount = 1
	
	if sCertCnt ~= null and sCertCnt ~= "" then
		if CInt(sCertCnt) > 0 then
			Dim sCertInfo, sTemp, sDate

			for i = 0 to CInt(sCertCnt)-1
				sCertInfo = Form.GetCertListDataAt(i)
				sTemp = Split(sCertInfo, ";")
				
				if #sTemp > 7 then
					'sTemp[0] 성명
					'sTemp[1] DN
					'sTemp[2] 종류(범용개인)
					'sTemp[3] 발급기관
					'sTemp[5] 사용가능여부(가능1)
					'sTemp[6] 만기일
					'sTemp[7] 시작일
					
					if sTemp[1] == sDN then
						bFind = true
						
						ContainerCert.Grid0.SetCellData("bd_name", 0, sTemp[0])
						ContainerCert.Grid0.SetCellData("bd_cert", 0, sTemp[2].." ("..sTemp[3]..")")
						
						sDate = sTemp[7]
						sDate = Replace(sDate, "-", "")
						sDate = Replace(sDate, ".", "")
						ContainerCert.Grid0.SetCellData("bd_date", 0, "20"..sDate)
						
						sDate = sTemp[6]
						sDate = Replace(sDate, "-", "")
						sDate = Replace(sDate, ".", "")
						ContainerCert.Grid0.SetCellData("bd_Edate", 0, "20"..sDate)
						
						ContainerCert.Grid0.SetCellData("bd_dn", 0, sTemp[1])
						ContainerCert.Grid0.SetCellData("bd_index", 0, i)
						
						if tonumber("20"..sDate) > tonumber(sCalDate) then
							ContainerCert.ImageCertOn.imgpath = "icon_sign_certi.png"			'20230524 SWJ START
							'ContainerCert.Grid0.SetCellData("bd_icon", 0, "icon_sub_11.png")
						else
							ContainerCert.ImageCertOn.imgpath = "icon_sign_certi_02.png"		'20230524 SWJ START
							'ContainerCert.Grid0.SetCellData("bd_icon", 0, "icon_sub_12.png")
						end if
					end if
				end if
			next
		end if
	end if
	
	if bFind == false then
		'인증서 없음
		ContainerCert.ImageCertOn.visible = False
		ContainerCert.lblCertNotFound1.visible = True
		ContainerCert.lblCertNotFound2.visible = True
		ContainerCert.lblOtherCert.visible = False		'20230524 SWJ START
		ContainerCert.btnCertReg.Top = 169				'20230524 SWJ START
		ContainerCert.btnCertReg.visible = True
		
		'20230524 SWJ START
		ContainerCert.btnCertReg.Caption = "공동인증서 등록 >"
		ContainerCert.Image0.left 	= 24
		ContainerCert.Image0.Top 	= 55
		ContainerCert.Image0.width 	= 329
		ContainerCert.Image0.height	= 192
		'20230524 SWJ END
		
		'ContainerCert.btnLogin.visible = False
		ContainerCert.edtCertPswd.visible = False
		ContainerCert.Grid0.setVisibleCol(2, "0")
	else
		'20230524 SWJ START
		ContainerCert.Image0.left	= 24
		ContainerCert.Image0.Top	= 50
		ContainerCert.Image0.width	= 329
		ContainerCert.Image0.height	= 113
		'20230524 SWJ END
		
		ContainerCert.ImageCertOn.visible = True
		ContainerCert.lblCertNotFound1.visible = False
		ContainerCert.lblCertNotFound2.visible = False
		ContainerCert.lblOtherCert.visible = True		'20230524 SWJ START
		ContainerCert.btnCertReg.visible = False
		'ContainerCert.btnLogin.visible = True
		ContainerCert.edtCertPswd.visible = True
		ContainerCert.Grid0.SetCellImage(2, "1")
		
		'로그인 자동진행(인증서)
		Form.setTimerEvent2(4,1,0.1)		
	end if	
End Sub		

'============================================================================
'닫기버튼
Sub ImageClose_OnClick()
	
	sLoginID = Form.GetSharedData("&USER_ID", 0)

	if Trim(sLoginID) == "" then
		Form.MsgBox("알림", "최초 1회 로그인이 필요합니다.", "", 0)			
	else
		'20210222 SWJ START 
		if g_sLoginReq == "LOGIN_REQ" or g_sLogForce == "LOG_FORCE" or g_bdmevntFlag == "Y" then

			Form.MsgBox("알림", "최초 1회 로그인이 필요합니다.", "force_close", 0)
		else
		'20210222 SWJ END
			
			g_CertCloseFlag = True	'20230718 SWJ START
			
			Form.CloseForm()
		end if
	end if
	
End Sub

'============================================================================
Sub ContainerID_edtPass_OnEditComplete()
	if (ContainerID.chkSise.checkstate == "1" or ContainerID.chkMockDeal.checkstate == "1") then
		ContainerID_btnLogin_OnClick()
		exit sub
	end if
	
	if Len(ContainerID.edtPass.caption) > 0 and Len(ContainerID.edtCertPass.caption) > 0 then
		ContainerID_btnLogin_OnClick()
		exit sub
	end if
End Sub

'============================================================================
Sub ContainerID_edtCertPass_OnEditComplete()
	if Len(ContainerID.edtPass.caption) > 0 and Len(ContainerID.edtCertPass.caption) > 0 then
		ContainerID_btnLogin_OnClick()
		exit sub
	end if
End Sub


'============================================================================
' 거래용 ID 로그인
'============================================================================
Sub ContainerID_btnLogin_OnClick()
	g_sID = Form.GetCtlProp("ContainerID.edtID", "caption")
	
	if g_sID == null or g_sID == "" then
		Form.MsgBox("알림", "사용자 ID를 입력하세요.", "", 0)
		exit sub
	end if	
	
	g_sPass = Form.GetCtlProp("ContainerID.edtPass", "caption")
	
	if g_sPass == null or g_sPass == "" then
		Form.MsgBox("알림", "사용자 ID 비밀번호를 입력하세요.", "", 0)
		exit sub
	end if
	
	g_sSiseCheck =  Form.GetCtlProp("ContainerID.chkSise", "checkstate") 
	
	if g_sSiseCheck == "0" and g_sMockDealCheck == "0" then
		g_sCertPass = Form.GetCtlProp("ContainerID.edtCertPass", "caption")
		
		if g_sCertPass == null or g_sCertPass == "" then
			Form.MsgBox("알림", "인증 비밀번호를 입력하세요.", "", 0)
			exit sub
		end if	
	end if		

	DATAMANAGER.SetDataValue(0, "obcpp_logn_022a", "InBlock1", "USER_ID"	, 0	, g_sID)							'사용자 ID
	
	'------------------------------------------------------------------------
	if g_sPlainRm == "1" then
		DATAMANAGER.SetDataValue(0, "obcpp_logn_022a", "InBlock1", "CONN_PWD", 0	, g_sPass)
	else
		DATAMANAGER.SetDataValue(0, "obcpp_logn_022a", "InBlock1", "CONN_PWD", 0	, Form.GetEncData(g_sPass))	
	end if
	'------------------------------------------------------------------------	
	DATAMANAGER.SetDataValue(0, "obcpp_logn_022a", "InBlock1", "TERM_IDNT_KEY", 0	, g_sDeviceID)				'단말식별키

	if g_sSiseCheck == "0" then
		DATAMANAGER.SetDataValue(0, "obcpp_logn_022a", "InBlock1", "QTTN_EXUS_LOGN_YN", 0, "N") 				'시세조회전용여부
	else
		DATAMANAGER.SetDataValue(0, "obcpp_logn_022a", "InBlock1", "QTTN_EXUS_LOGN_YN", 0, "Y") 
	end if
	
	DATAMANAGER.RequestTranData("obcpp_logn_022a")
End Sub

'============================================================================
'바이오인증 도입 및 로그인 화면 개편
'============================================================================
Sub MoveContainer()
	nInitLeft = 0
	nInitTop = 70
	
	LabelTitleCert.visible = true '20220805_01 KBC : 로그인개선
	
	'20240604 SWJ START
	LabelSpinEndNotice.visible = False
	'20240604 SWJ END
	
	if g_sCertLogin == DEF_PIN then
		'간편인증로그인
		ContainerSpin.left = nInitLeft
		ContainerSpin.top = nInitTop

		ContainerID.visible = false
		ContainerCert.visible = false
		ContainerCloudCert.visible = false
		ContainerSpin.visible = true
		ContainerBio.visible = false
		ContainerAton.visible = false					'20230524 SWJ START
		ContainerBio.btnLogin.width = 320				'20230627 SWJ START
		ContainerBio.btnLogin.left  = 27				'20230627 SWJ START
		
		Form.SetEnvData(1, "login.input.savetab", DEF_TAB_PIN)
		
		LabelTitleCert.caption = "간편인증"
		
		'20240604 SWJ START
		LabelSpinEndNotice.visible = True
		'20240604 SWJ END
		
	elseif g_sCertLogin == DEF_BIO then

		'20220805_01 KBC : 로그인개선

		'FIDO 앱 설치여부
		sRet = Form.GetKftcBioInstalled()
		
		if sRet == "0" then '0 : 설치안됨, 1 : 설치됨
			g_sBioReg = "00" '00 : 공동앱 설치안됨
			
			'미등록, 미설치
			ContainerBio.ContainerALL.visible = false
			ContainerBio.ContainerPIN.visible = false
			ContainerBio.ContainerFinger.visible = false			

			ContainerBio.ImageLine.left = 20				'20230524 SWJ START : 32 -> 20
			ContainerBio.ImageLine.top = 52					'20230524 SWJ START : 55 -> 52
			ContainerBio.ImageLine.visible = true
			
			ContainerBio.ContainerNotFound.left = 30			'20230524 SWJ START : 32 -> 20	
			ContainerBio.ContainerNotFound.top = 58			'20230524 SWJ START : 57 -> 58
			ContainerBio.ContainerNotFound.visible = true
			
			ContainerBio.btnLogin.top = 169					'20230524 SWJ START
			ContainerBio.btnLogin.width = 280				'20230627 SWJ START
			ContainerBio.btnLogin.left  = 50				'20230627 SWJ START
			ContainerBio.btnLogin.caption = "바이오정보 등록 >"
			ContainerBio.btnLogin.enable = true				'20230524 SWJ START : 주석 처리

			'바이오인증
			ContainerBio.left = nInitLeft
			ContainerBio.top = nInitTop
			
			ContainerCert.visible = false
			ContainerCloudCert.visible = false
			ContainerSpin.visible = false
			ContainerID.visible = false
			ContainerAton.visible = false					'20230524 SWJ START
			ContainerBio.visible = true
			
			Form.SetEnvData(1, "login.input.savetab", DEF_TAB_BIO)
			
			LabelTitleCert.caption = "바이오인증"
		else 
			'바이오인증
			ContainerBio.left = nInitLeft
			ContainerBio.top = nInitTop
			
			ContainerCert.visible = false
			ContainerCloudCert.visible = false
			ContainerSpin.visible = false
			ContainerID.visible = false
			ContainerAton.visible = false					'20230524 SWJ START
			ContainerBio.visible = true
			ContainerBio.btnLogin.width = 320				'20230627 SWJ START
			ContainerBio.btnLogin.left  = 27				'20230627 SWJ START
			
			Form.SetEnvData(1, "login.input.savetab", DEF_TAB_BIO)
			LabelTitleCert.caption = "바이오인증"
				
			Form.requestKftcBio("Bio_401", "", "10000") 
		end if
	
	'20230524 SWJ START
	elseif g_sCertLogin == DEF_ATON then
		
		'간편인증 등록여부 체크
		'기기 등록여부 체크
		if fnGetSBInfo("") == False then
			MoveContainerAton("fail")
		end if
		
		'-----------------------------------------------------------------------
		'전문전송
		'-----------------------------------------------------------------------	
		procRequestAtonTR_INQUIRYCERT()
		'-----------------------------------------------------------------------	
		
		Form.SetEnvData(1, "login.input.savetab", DEF_TAB_ATON)
		LabelTitleCert.caption = "메리츠 간편인증"
		
	'20230524 SWJ END
	elseif g_sCertLogin == DEF_CERT then
		'인증서
		ContainerCert.left = nInitLeft
		ContainerCert.top = nInitTop

		ContainerID.visible = false
		ContainerSpin.visible = false		
		ContainerCert.visible = true
		ContainerCloudCert.visible = false
		ContainerBio.visible = false
		ContainerAton.visible = false		'20230524 SWJ START
		
		g_sDN = Form.GetEnvData("login.input.userdn")
		procSelectedCert(g_sDN)
		
		Form.SetEnvData(1, "login.input.savetab", DEF_TAB_CERT)
		
		LabelTitleCert.caption = "공동인증서"
		
	'20240314_01 KBC : 클라우드공동인증서 도입		
	elseif g_sCertLogin == DEF_CLOUDCERT then
		'인증서
		ContainerCloudCert.left = nInitLeft
		ContainerCloudCert.top = nInitTop

		ContainerID.visible = false
		ContainerSpin.visible = false		
		ContainerCert.visible = false
		ContainerCloudCert.visible = true
		ContainerBio.visible = false
		ContainerAton.visible = false
		
		g_sDN = Form.GetEnvData("login.input.userdn")
		
		Form.SetEnvData(1, "login.input.savetab", DEF_TAB_CLOUDCERT)
		
		LabelTitleCert.caption = "클라우드인증서"
		
	elseif g_sCertLogin == DEF_ID then
		'ID인증 
		ContainerID.left = nInitLeft
		ContainerID.top = nInitTop
		
		ContainerCert.visible = false
		ContainerCloudCert.visible = false
		ContainerSpin.visible = false
		ContainerID.visible = true
		ContainerBio.visible = false
		ContainerAton.visible = false		'20230524 SWJ START
		
		Form.SetEnvData(1, "login.input.savetab", DEF_TAB_ID)
		
		LabelTitleCert.caption = "아이디인증"
		
		if Len(ContainerID.edtID.caption) > 0 then
			ContainerID.edtPass.SetShowKeypad(True)
		end if
	end if	
End Sub

'============================================================================
Sub ContainerID_edtID_OnEditComplete()
	'ID로그인 -> (간편인증, 바이오인증, 조회용)
	sID = Form.GetCtlProp("ContainerID.edtID", "caption")
	
	Form.SetCtlProp("ContainerSpin.edtID", "caption", sID)
	Form.SetCtlProp("ContainerBio.edtID", "caption", sID)
	
	ContainerID.edtPass.caption = ""
	ContainerID.edtCertPass.caption = ""
End Sub

'============================================================================
Sub ContainerSpin_edtID_OnEditComplete()
	'간편인증 -> (ID로그인, 바이오인증, 조회용)
	sID = Form.GetCtlProp("ContainerSpin.edtID", "caption")
	
	Form.SetCtlProp("ContainerID.edtID", "caption", sID)
	Form.SetCtlProp("ContainerBio.edtID", "caption", sID)
End Sub

'============================================================================
Sub ContainerBio_edtID_OnEditComplete()
	'바이오 로그인 -> (간편인증, 로그인인증, 조회용)
	sID = Form.GetCtlProp("ContainerBio.edtID", "caption")
	
	Form.SetCtlProp("ContainerSpin.edtID", "caption", sID)
	Form.SetCtlProp("ContainerID.edtID", "caption", sID)
End Sub

'============================================================================
'ID인증 ID 저장
Sub ContainerID_chkSaveID_OnChange(sCheckState)
	if sCheckState == "0" or sCheckState == 0 Then
		ShowAlert("알림", "ID저장 기능을 해제하셨습니다. 다음 로그인시 ID를 직접 입력하셔야합니다.")
	end if

	Form.SetEnvData(1, "login.input.saveid",sCheckState)
End Sub

'============================================================================
'로그인버튼
Sub ContainerSpin_btnLogin_OnClick()
	
	'처리순서 : 가입상태체크(*) -> 간편인증로그인 -> 기간계로그인(obcpp_spin_022a)
	g_sID = Form.GetCtlProp("ContainerSpin.edtID", "caption")
	
	if g_sID == null or g_sID == "" then
	
		'20220805_01 KBC : 로그인개선
		g_sID = Form.GetEnvData("login.input.userid") 
	
		if g_sID == null or g_sID == "" then
			Form.MsgBox("알림", "사용자 ID를 입력하세요.", "", 0)
			exit sub
		end if
		
		'20220805_01 KBC : 로그인개선
		Form.SetCtlProp("ContainerID.edtID"	, "caption", g_sID)
		Form.SetCtlProp("ContainerSpin.edtID", "caption", g_sID)
		Form.SetCtlProp("ContainerBio.edtID"	, "caption", g_sID)
	end if
	
'	'20181116_01 KBC START : 간편인증 점검안내
'	sDate = Form.GetSharedData("&HOST_DATE", False)
'	sTime = Form.GetSharedData("&HOST_TIME", False)
'
'	'중단 일시 : 2018년 11월 25일(일)01:00 ~ 07:00(7시간)
'	if Len(sDate) == 8 then
'		if sDate == "20181125" then
'			if CInt(sTime) >= 10000 and CInt(sTime) <= 70000 then
'				sNotice = "11월 25일 (일) 01:00~07:00 동안 간편인증 이용이 잠시 중단됩니다.\n\n" &
'						 "[아이디 로그인] 등 다른 인증수단을 사용하시기 바랍니다."
'				
'				Form.MsgBox("간편인증 점검안내", sNotice , "", 0)
'				exit sub
'			end if		
'		end if
'	end if
'	'20181116_01 KBC END

	g_sSiseCheck = "0" '간편인증은 시세조회전용없음
	
	'가입상태체크
	'[고객ID]`[인증서시리얼번호]
	sParam = g_sID

	if ContainerSpin.btnLogin.enable == "1" then
		
		'20240627 SWJ START
		'안드로이드에서 메시지 박스가 2번 뜨는 현상있어서
		'일단 한번만 뜨도록 하고
		'메시지 박스 닫으면 다시 플래그 바꾼다.
		'ContainerSpin.btnLogin.enable = "0"
		if g_bSpinLoginEnd then
			Form.MsgBox("알림", "공동인증서 기반의 간편인증은\n2024년 7월 4일부로 서비스가 종료되어\n사용이 불가합니다.\n다른 인증 방식을 사용해주세요.","SpinLoginEnd", 6)
			g_bSpinLoginEnd = False
		end if
		'20240627 SWJ END
		
		Form.requestOneShotPad("reqCheckJoin", sParam, "")
	end if
End Sub

'============================================================================
' 간편인증 응답용 TriggerEventSpin
'============================================================================
Sub Form_OnTriggerEventSpin(sEventName, sParam)
	Dim sRet, sErrorCode, sErrorMsg
	sRet = Split(sParam, "★")

	if sEventName == "changeLoginMethod" then
		'sParam 값 없음
		ContainerSpin.btnLogin.enable = "1"
		Form.openPopupAnimation("mhetc90021_p7", "" ,"","2") '다른 방식으로 로그인 팝업
		exit sub
	end if
	
	sErrorCode = ""
	sErrorMsg = ""
	
	if #sRet > 1 then
		sErrorCode = sRet[0]
		sErrorMsg = sRet[1]	
	else
		exit sub
	end if
	
	if sEventName == "reqCheckJoin" then
		'처리순서 : 가입상태체크 -> 간편인증로그인(*) -> 기간계로그인(obcpp_spin_022a)
		
		'간편인증로그인
		'[요청타입]`[고객ID]`[인증서시리얼번호] <- 로그인의 경우 시리얼번호 공백처리
		'요청타입 => 2.로그인 3.이체 4.비밀번호변경 5.해지

		'코드
		'	3000.정상 사용자 입니다.
		'	3001.이미 가입된 사용자 입니다.
		'	3002.가입된 이력이 확인되지 않습니다. 가입해 주시기 바랍니다.
		'	3003.설정한앱을 삭제한 이력이 있거나, 등록시 사용했던 기기와 상이합니다. 재가입이 필요합니다.
		'	3004.가입 대기중인 사용자 입니다.
		'	3005.가입이 해지된 사용자 입니다.
		'	3006.가입 된 이력이 확인되지 않습니다.
		'	3007.인증서 정보가 확인되지 않습니다. 재가입이 필요합니다.
		'	3008.5회 이상 비밀번호 오류가 발생하였습니다. 재가입이 필요합니다.
		'	3009.중복된 사용자  id 입니다.
		'	3010.미사용 처리 된 사용자 아이디
		
		ContainerSpin.btnCertLogin.Top = 169 '공동인증서로그인 버튼		'20230524 SWJ
		ContainerSpin.btnCertLogin.Caption = "공동인증서 로그인 >"		'20230524 SWJ
		
		if sErrorCode == "3000" then 'CD_NORMAL_USER
			
			'20230627 SWJ START: 로그인 시 UI 변경
			ContainerSpin.lblSPinNotFound1.visible = False
			ContainerSpin.lblSPinNotFound2.visible = False
			ContainerSpin.lblSPinNotFound3.visible = False				
			ContainerSpin.btnCertLogin.visible = False
			ContainerSpin.ImagePIN.visible = True
			ContainerSpin.LblPIN.visible = True
			ContainerSpin.Image0.visible = False
			ContainerSpin.ImageLinePIN.visible = True
			ContainerSpin.btnLogin.visible = True
			ContainerSpin.btnLogin.width = 320
			ContainerSpin.btnLogin.top = 151
			ContainerSpin.btnLogin.left  = 27

			ContainerSpin.ImageLinePIN.imgpath = g_sImg_Box_o
		
			ContainerSpin.lblSPinNotFound1.Caption = ""
			'ContainerSpin.lblSPinNotFound2.Caption = "등록된 간편번호를 입력하세요."
			ContainerSpin.lblSPinNotFound3.Caption = ""
			'20230627 SWJ END
			
			'20240627 SWJ START
			'주석처리
			'sParam = "2" & "★" & g_sID & "★" & ""
			'Form.requestOneShotPad("reqPush", sParam, "")
			'20240627 SWJ END
		
		elseif sErrorCode == "3002" or sErrorCode == "3005" or sErrorCode == "3006" then 'CD_NOT_USER
			ContainerSpin.lblSPinNotFound1.visible = True
			ContainerSpin.lblSPinNotFound2.visible = True
			ContainerSpin.lblSPinNotFound3.visible = True
			ContainerSpin.btnCertLogin.visible = True
			ContainerSpin.btnLogin.visible = False
			
			ContainerSpin.lblSPinNotFound1.Caption = "등록된 간편인증번호가 없어요."
			ContainerSpin.lblSPinNotFound2.Caption = "공동인증서 로그인 후"
			ContainerSpin.lblSPinNotFound3.Caption = "간편인증 서비스 등록이 가능합니다."
			
			'20240627 SWJ START
			'주석처리
			'ContainerSpin.btnLogin.enable = "1"
			'Request_obcpp_spin_022a("N", sErrorMsg)
			'20240627 SWJ END

		elseif sErrorCode == "3003" then 'CD_MISMATCH
			ContainerSpin.lblSPinNotFound1.visible = True
			ContainerSpin.lblSPinNotFound2.visible = True
			ContainerSpin.lblSPinNotFound3.visible = True
			ContainerSpin.btnCertLogin.visible = True
			ContainerSpin.btnLogin.visible = False
			
			ContainerSpin.lblSPinNotFound1.Caption = "등록된 간편인증 정보가 변경되었어요."
			ContainerSpin.lblSPinNotFound2.Caption = "공동인증서 로그인 후"
			ContainerSpin.lblSPinNotFound3.Caption = "간편인증 서비스 재등록이 필요합니다."
			
			'20240627 SWJ START
			'주석처리
			'ContainerSpin.btnLogin.enable = "1"
			'Request_obcpp_spin_022a("N", sErrorMsg)
			'20240627 SWJ END
			
		elseif sErrorCode == "3007" then
			ContainerSpin.lblSPinNotFound1.visible = True
			ContainerSpin.lblSPinNotFound2.visible = True
			ContainerSpin.lblSPinNotFound3.visible = True
			ContainerSpin.btnCertLogin.visible = True
			ContainerSpin.btnLogin.visible = False
			
			ContainerSpin.lblSPinNotFound1.Caption = "공동인증서 정보가 확인되지 않습니다."
			ContainerSpin.lblSPinNotFound2.Caption = "공동인증서 로그인 후"
			ContainerSpin.lblSPinNotFound3.Caption = "간편인증 서비스 재등록이 필요합니다."
			
			'20240627 SWJ START
			'주석처리
			'ContainerSpin.btnLogin.enable = "1"
			'Request_obcpp_spin_022a("N", sErrorMsg)
			'20240627 SWJ END
			
		elseif sErrorCode == "3008" then
			ContainerSpin.lblSPinNotFound1.visible = True
			ContainerSpin.lblSPinNotFound2.visible = True
			ContainerSpin.lblSPinNotFound3.visible = True
			ContainerSpin.btnCertLogin.visible = True
			ContainerSpin.btnLogin.visible = False
			
			ContainerSpin.lblSPinNotFound1.Caption = "간편 비밀번호 5회 이상 오류입니다."
			ContainerSpin.lblSPinNotFound2.Caption = "공동인증서 로그인 후"
			ContainerSpin.lblSPinNotFound3.Caption = "간편인증 서비스 재등록이 필요합니다."
			
			'20240627 SWJ START
			'주석처리
			'ContainerSpin.btnLogin.enable = "1"
			'Request_obcpp_spin_022a("N", sErrorMsg)	
			'20240627 SWJ END
			
		elseif sErrorCode == "1004" then 'CD_TIMEOUT
			ContainerSpin.lblSPinNotFound1.visible = True
			ContainerSpin.lblSPinNotFound2.visible = True
			ContainerSpin.lblSPinNotFound3.visible = True
			ContainerSpin.btnCertLogin.visible = True
			ContainerSpin.btnLogin.visible = False
			
			ContainerSpin.lblSPinNotFound1.Caption = "일시적으로 간편인증 서비스가 원활하지 않습니다."
			ContainerSpin.lblSPinNotFound2.Caption = "재시도 하시거나 [공동인증서 로그인] 등"
			ContainerSpin.lblSPinNotFound3.Caption = "다른 인증수단을 사용해주세요."		
			
			'20240627 SWJ START
			'주석처리
			'ContainerSpin.btnLogin.enable = "1"
			'Request_obcpp_spin_022a("N", sErrorMsg)
			
			'Form.MsgBox("알림", "일시적으로 간편인증 서비스가 원활하지 않습니다. 재시도하시거나 [공동인증서 로그인] 등 다른 인증수단을 사용해주세요"..sErrorCode , "", 0)
			'20240627 SWJ END
			
		else 
			Form.Toast(0, sErrorMsg, 0) '상세정보 필요하여 토스트 메시지 유지
			
			ContainerSpin.lblSPinNotFound1.visible = True
			ContainerSpin.lblSPinNotFound2.visible = True
			ContainerSpin.lblSPinNotFound3.visible = True
			ContainerSpin.btnCertLogin.visible = False
			ContainerSpin.btnLogin.visible = True
			
			ContainerSpin.lblSPinNotFound1.Caption = ""
			ContainerSpin.lblSPinNotFound2.Caption = sErrorMsg
			ContainerSpin.lblSPinNotFound3.Caption = ""	
			
			'20240627 SWJ START
			'주석처리
'			ContainerSpin.btnLogin.enable = "1"
'			Request_obcpp_spin_022a("N", sErrorMsg)
'	
'			Form.MsgBox("알림", sErrorMsg..sErrorCode , "", 0)
			'20240627 SWJ END
		end if
	
	elseif sEventName == "reqAuthPinPad" then
		'간편인증 비밀번호 맞거나 틀리거나 모두 진입
		ContainerSpin.btnLogin.enable = "1"
		
		if sErrorCode == "0000" then '성공
			'no action (reqLogin 응답이 내려옴)
		else
			if sErrorCode == "2004" or sErrorCode == "2005" then
				if #sRet > 2 then
					sPassFailCnt = sRet[2]
					
					if LEN(sPassFailCnt) > 0 then
						if CInt(sPassFailCnt) >= 5 then
							'5회오류 시 SMS전송요청
							DATAMANAGER.SetDataValue(0, "obcsb_spin_001a", "InBlock1", "INPUT_CLS"	, 0, "3")	'5회오류
							DATAMANAGER.SetDataValue(0, "obcsb_spin_001a", "InBlock1", "ELFN_ID"		, 0, g_sID)
							
							DATAMANAGER.RequestTranData("obcsb_spin_001a")
						end if
					end if					
					
					sErrorMsg = "간편인증 비밀번호 " & sPassFailCnt & "회 오류입니다.\n\n" &
					            "연속 5회 오류 시 간편인증으로 접속이 제한됩니다."
				else
					sErrorMsg = "간편인증 비밀번호 오류입니다."
				end if
			end if
			
			Request_obcpp_spin_022a("N", sErrorMsg)
			Form.MsgBox("알림", sErrorMsg , "", 0)
		end if

	elseif sEventName == "reqLogin" then
		'처리순서 : 가입상태체크 -> 간편인증로그인 -> 기간계로그인(*)
		if sErrorCode == "0000" then
			'인증서 특수기호 ">"종료글자 오류회피
			sCertPass = Form.GetSharedData("CERT_IMSI_PSWD", 1)
			sCertDn = Form.GetSharedData("CERT_IMSI_DN", 1)
			
			if sCertPass <> null and sCertPass <> "" and 
			   sCertDn   <> null and sCertDn   <> "" then
			   
				g_sCertPass = sCertPass
				g_sDN = sCertDn
				
				Form.SetCertDNPW(g_sDN, g_sCertPass)
				Request_obcpp_spin_022a("Y", "")
			
			else
				if #sRet > 3 then
					g_sCertPass = sRet[2] '간편인증서용 비밀번호
					g_sDN = sRet[3] '간편인증서용 DN값
					
					Form.SetCertDNPW(g_sDN, g_sCertPass)
					Request_obcpp_spin_022a("Y", "")
				end if
			end if
			
		elseif sErrorCode == "-1" then
			ContainerSpin.btnLogin.enable = "1"
			Request_obcpp_spin_022a("N", sErrorMsg)
			
			sErrorMsg = "간편인증서비스 신청 시 사용한 인증서는 더이상 사용하실 수 없습니다.\n\n" &
			            "유효한 인증서로 로그인(거래용 ID인증)하신 후 간편인증서비스를 재등록 해주세요."
			
			Form.MsgBox("알림", sErrorMsg , "", 0)			
		else
			ContainerSpin.btnLogin.enable = "1"
			Form.MsgBox("알림", sErrorMsg , "", 0)
		end if
		
		
	elseif sEventName == "reqPush" then
		if sErrorCode == "0000" then '성공
			'no action
		else
			Request_obcpp_spin_022a("N", sErrorMsg)
			Form.MsgBox("알림", sErrorMsg , "", 0)
		end if
		
	elseif sEventName == "pinpadNoInput" then
		'간편인증 비밀번호 입력하지 않고 그냥 닫은 경우
		ContainerSpin.btnLogin.enable = "1"
		
	'20240627 SWJ START
	'주석 처리
	'else
	'	Form.MsgBox("알림", sErrorMsg , "", 0)
	'20240627 SWJ END
	
	end if
	
	
End Sub
'============================================================================
'20230627 SWJ START : 공동인증서 기반 간편인증 UI변경
'============================================================================
Sub ContainerSpin_ImageLinePIN_OnClick()
	ContainerSpin.ImageLinePIN.imgpath = g_sImg_Box_o
End Sub
'============================================================================
Sub ContainerSpin_ImagePIN_OnClick()
	ContainerSpin_ImageLinePIN_OnClick()
End Sub
'============================================================================
' 바이오인증 응답용 TriggerEventBio
'============================================================================
Sub Form_OnTriggerEventBio(sEventName, sParam)
	Dim sRet, sErrorCode, sErrorMsg
	sRet = Split(sParam, "★")

	if #sRet > 1 then
		sErrorCode	= sRet[0]
		sErrorMsg	= sRet[1]			
	else
		exit sub
	end if
	
	if #sRet > 2 then
		sBioRet = Form.KBase64Decoding(sRet[2])
		sBioItemRet = Split(sBioRet, "★")
	end if	

	'FIDO 인증 통보
	if sEventName == "90020_Bio_116" then
	
		'--- FIDO 인증응답메시지 수신 ---
		sAAID			= sBioItemRet[0]	'AAID
		sNIDCT 			= sBioItemRet[1]	'비식별호환토큰
		sFIDOMSG 		= sBioItemRet[2]	'FIDO 인증응답메시지
		sAppVersion 		= sBioItemRet[3]	'앱버전
		sBriefSignPubKey	= sBioItemRet[4]	'공개키
		sBriefSignPrvKey	= sBioItemRet[5] 	'개인키
		'				  sBioItemRet[6]	'독자인증장치(SW)사용여부
		
		ProcSendBIO_004a(g_sID , "0000", tbl_fido1("BIO_TLMS_TRC_NO"), "0", sAAID, "S", sNIDCT, sBriefSignPubKey, sFIDOMSG)		
	
	'티켓온FIDO 인증
	elseif sEventName == "90020_Bio_2116" then
		'sBioItemRet[0] 'P7Sign Data
		'sBioItemRet[1] '축약서명공개키
		'sBioItemRet[2] '축약서명개인키
		
		'인증결과 전송
		ProcSendBIO_014a(g_sID, tbl_fido2("BIO_TLMS_TRC_NO"), "0")		
		
	'FIDO 에러코드
	elseif sEventName == "90020_Bio_1000" then
		Call LoginFailSendHWInfo(g_sID) '부정접속 관련 대응-로그인 실패시
		
		If Len(sErrorCode) > 0 Then
			
			'Android 
			'-1302 : (공동앱 처음깔고 생체인증 시도 시 발생)
			'-1205 : (공동앱 처음깔고 간편인증 시도 시 발생)
			
			'iOS
			'-1402 : (공동앱 처음깔고 생체인증 시도 시 발생)
			'-2010 : (공동앱 처음깔고 간편인증 시도 시 발생)			
			
			'20220805_01 KBC : 로그인개선
			If  sErrorCode == "-1205" or sErrorCode == "-1302" Then 
				Form.MsgBox("바이오인증 공동앱", "바이오인증 서비스 미등록 단말입니다.\n등록 후 이용해주세요.\n(" + sErrorCode + ")", "FIDO_JOIN", 7, "등록하기", "취소") '바이오인증 서비스 미등록
				exit sub				
			
			'IOS 바이오인증 재신청 요청 메시지 추가
			ElseIf  g_sBIOTermOS == DEF_IOS And sErrorCode == "-1402" Then
				Form.MsgBox("바이오인증 공동앱", "바이오인증 서비스 미등록 단말입니다.\n등록 후 이용해주세요.\n(" + sErrorCode + ")", "FIDO_JOIN", 7, "등록하기", "취소") '바이오인증 서비스 미등록
				exit sub
				
			ElseIf  g_sBIOTermOS == DEF_IOS And sErrorCode == "-2010" Then
				Form.MsgBox("바이오인증 공동앱", "바이오인증 서비스 미등록 단말입니다.\n등록 후 이용해주세요.\n(" + sErrorCode + ")", "FIDO_JOIN", 7, "등록하기", "취소") '바이오인증 서비스 미등록
				exit sub
				
			else
				if sErrorCode == "-1203" then '사용자 취소의 경우 팝업 띄우지말자
					'Form.ShowAlert("알림",sErrorCode)
					exit sub
				end if
			
				if #sBioItemRet > 2 and Len(sBioItemRet[2]) > 0 then
					Form.MsgBox("바이오인증 공동앱", sErrorMsg & "\n(" & sBioItemRet[2] & "회 오류)" , "", 0) 				
				else
					Form.MsgBox("바이오인증 공동앱", sErrorMsg & "(" + sErrorCode + ")", "", 0)
				end if
			end if
		End If
		
		'금융앱이 코드 115 전송 후, 지문인증시 사용자 취소 등에 의해서 -1203, -1290 에러를 반환받은 경우,
		'FIDO인증요청전문을 분산관리센터로 전송 시, 인증결과코드에 "5121"을 넣어서 전달해야한다.
		'   1203 : 사용자가 FIDO 인증을 취소함
		'   1290 : 취소 또는 바이오정보가 일치하지 않습니다.
		'
		'KBC : 티켓온 인증시에는 오류횟수를 연계앱에서 알아서 바이오서버와 통신하면서 처리하기때문에 금융사에서 처리할 필요가 없다
		'      1290 or 1203 에서 1203은 취소시에만 리턴되므로 제거함(독자인증장치로 전환했기때문에 가능)

		if sBioItemRet[0] == "Bio_115" And sErrorCode == "-1290" then
			ProcSendBIO_004a(g_sID , "5121", tbl_fido1("BIO_TLMS_TRC_NO"), "0", "", "S", "", "", "")			
		end if
		
	elseif sEventName == "90020_Bio_402"	Then
		'sBioItemRet[0]	'디바이스 아이디 
		'sBioItemRet[1]	'앱버전
		'sBioItemRet[2]	'인증기술목록
		'sBioItemRet[3]	'홍채이관대상유무

		g_sBIOTermID		= Form.getKftcBioDeviceID(); 'Bio_401 을 태우면 Bio_402 리턴할때 getKftcBioDeviceID()를 통해서 Device ID를 가져올 수 있다.(앱에서 처리중)
		g_sBioAppVersion	= sBioItemRet[1]
		
		if Len(Trim(g_sBIOTermID)) < 1 Then
			Call LoginFailSendHWInfo(g_sID) '부정접속 관련 대응-로그인 실패시
				
			Form.MsgBox("알림", "바이오인증 서비스 미등록 단말입니다.\n등록 후 이용해주세요.", "FIDO_JOIN", 7, "등록하기", "취소") '바이오인증 서비스 미등록
			'Form.MsgBox("알림", "바이오인증을 등록한 단말정보가 없습니다.\n바이오인증 신청 후, 사용 가능합니다.\n신청하시겠습니까?", "FIDO_JOIN", 1)
			exit sub
		end if

		ATHN_TYPE_CODE		= "S"	'인증타입 : S.자사인증 D.교차인증 C.호환인증
		ABRV_SGNT_TYPE_CODE	= "0"	'서명타입 : 0.일반서명 1.축약/자동서명
		BIO_TR_TYPE_CODE		= "0"	'거래타입 : 0.인증(로그인) 1.서명(서명)

		if g_sBIOAthnTchnCode == DEF_BIO_FINGER then
			ProcSendBio_003a(g_sID, ABRV_SGNT_TYPE_CODE, g_sBIOTermOS, g_sBIOTermID, DEF_BIO_SVCD, ATHN_TYPE_CODE, BIO_TR_TYPE_CODE)			
		else
			ProcSendBio_013a(g_sID, g_sBIOTermID, DEF_BIO_SVCD, BIO_TR_TYPE_CODE, g_sBIOAthnTchnCode)
		end if

	'20220805_01 KBC : 로그인개선	
	elseif sEventName == "10000_Bio_402"	Then
		'sBioItemRet[0]	'디바이스 아이디
		'sBioItemRet[1]	'앱버전
		'sBioItemRet[2]	'인증기술목록
		'sBioItemRet[3]	'홍채이관대상유무

		g_sBIOTermID		= Form.getKftcBioDeviceID(); 'Bio_401 을 태우면 Bio_402 리턴할때 getKftcBioDeviceID()를 통해서 Device ID를 가져올 수 있다.(앱에서 처리중)
		g_sBioAppVersion	= sBioItemRet[1]
		
		ProcRequsetBioRegInfo()

	else
		'로그인화면 > 하단 인증센터를 통해서 바이오등록화면으로 진입 시,
		'로그인화면이 밑에 깔려있어 바이오 트리거이벤트를 로그인쪽화면에서도 받아버림
		'화면번호 90020에서 보내는 트리거가 아닐시 무시하도록 처리
		szScrNo = Left(sEventName,5)
		
		if szScrNo == "90020" then
			Call LoginFailSendHWInfo(g_sID) '부정접속 관련 대응-로그인 실패시
			Form.MsgBox("알림", sErrorMsg , "", 0)
		end if	
	end if
End Sub

'============================================================================
'간편인증 - 기간계로그인(log)
Sub Request_obcpp_spin_022a(sSuccessYn, sMessage)
	if g_sID == null or g_sID == "" then
		exit sub
	end if
	
	'부정접속 관련 대응-로그인 실패시
	if sSuccessYn <> "Y" then		
		Call LoginFailSendHWInfo(g_sID)
	end if
	
	DATAMANAGER.SetDataValue(0, "obcpp_spin_022a", "InBlock1", "USER_ID"			, 0, g_sID) 		'사용자 ID
	DATAMANAGER.SetDataValue(0, "obcpp_spin_022a", "InBlock1", "TERM_IDNT_KEY"	, 0, g_sDeviceID)	'단말식별키
	DATAMANAGER.SetDataValue(0, "obcpp_spin_022a", "InBlock1", "CONN_SUCS_YN"	, 0, sSuccessYn)
	DATAMANAGER.SetDataValue(0, "obcpp_spin_022a", "InBlock1", "CONN_DTL_CNTT"	, 0, sMessage)

	DATAMANAGER.RequestTranData("obcpp_spin_022a")
End Sub

