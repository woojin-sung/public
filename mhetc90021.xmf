'인증서 로그인
Sub Request_obcpp_logn_006a()
	szTranID = "obcpp_logn_006a"	
	strMediaType =  Trim(Form.GetSharedData("&MEDIA_CODE", 0))	
	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CHAN_TYPE_CLS_CODE"	, 0	, strMediaType) 		'채널유형코드
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "DN_DATA" 			, 0	, g_sDN) 			'DN
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "AUTH_ATHN_USE_YN"		, 0	, "Y")				'인증서 사용여부
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "TERM_IDNT_KEY"		, 0	, g_sDeviceID)		'단말식별키 '20181121_02 KBC : 인증서로그인 임직원로그인 제한
	
	DATAMANAGER.RequestTranData(szTranID)
End Sub

'============================================================================
'인증서 검증 요청
Sub Request_obcpp_pcrt_166a()
	szTranID = "obcpp_pcrt_166a"
	
	DATAMANAGER.SetUserID(g_sID)	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "USER_ID" 	, 0 , g_sID)			'사용자ID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO"		, 0 , g_sRCNO) 		'실명확인번호	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "USER_NAME"	, 0 , g_sUserName)	'사용자명
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO"		, 0 , g_sCSNO) 		'고객번호
	
	if g_sRcnoPlainRm == "1" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CRPT_YN"		, 0 , "Y") 		'실명확인번호_암호화여부
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"	, 0 , g_sRCNO_PIP) '실명확인번호
	end if

	if Form.GetSharedData("&CERT_USE_TYPE" , 0) == "0" then '0.공인인증서 1.간편인증-공인인증서 2.코스콤지문-공인인증서 3.결제원-FIDO인증서 4.금투협-공동인증서 5.아톤사설인증 9.클라우드인증
	
		sRValue		= Form.GetRvalue(g_sDN , g_sCertPass)
		sSignData 	= Form.GetCertSignData(g_sDN , g_sCertPass)
		sSerialNum	= Form.GetCertSerialNumber(g_sDN)

		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_R_VAL" 				, 0 , sRValue)	'R 값	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_ELCT_SGNT_DATA_CNTT" 	, 0 , sSignData)	'전자서명데이타
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "NTAT_SRNO" 				, 0 , sSerialNum)	'인증서 일련번호	

	else	
		sRValue		= Form.GetAutoRvalue(g_sDN , g_sCertPass)
		sSignData 	= Form.GetAutoCertSignData(g_sDN , g_sCertPass)
		sSerialNum 	= Form.GetAutoCertSerialNumber(g_sDN)
		
		if sSignData == "-1" then
			sSignData 			= g_sFingerSignedData
			g_sFingerSignedData 	= ""
		end if

		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_R_VAL" 				, 0 , sRValue) 	'R 값	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_ELCT_SGNT_DATA_CNTT"	, 0 , sSignData) 	'전자서명데이타
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "NTAT_SRNO" 				, 0 , sSerialNum)	'인증서 일련번호
	end if

	'인증검증 TR
	DATAMANAGER.RequestTranData(szTranID)
End Sub

