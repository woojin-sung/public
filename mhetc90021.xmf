		'===========================================================================
		if g_bCloseForm And g_bExpiredChecked then
			Form.CloseForm()
		end if		
	
	'=======================================================================================================
	' BIO 인증 로그인
	'=======================================================================================================
	
	'-------------------------------------------------------------------------------------------------------
	'20220614_01 KBC START 바이오인증 송수신분리
	'-------------------------------------------------------------------------------------------------------
	
	'공동FIDO인증요청
	elseif szTranID == "obtss_fido_003a" or szTranID == "obtss_fido_203r" then
		Recv_Code	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_CODE" 			,0)
		Recv_Msg		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_MSG_CNTT"			,0)
		Recv_TR_Code	= DATAMANAGER.GetDataMsgCode(szTranID)
		
		'20220614_01 KBC 송수신분리 적용 시
		'6617.처리대기중입니다.
		if Recv_Code == "6617" or Recv_TR_Code == "6617" then
			if szTranID == "obtss_fido_003a" then
				g_BIOSeqNo	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OTSD_TR_UNIQ_NO", 0)
				g_BIOTrName	= szTranID
				g_BIORetry	= 0
				
				Form.setTimerEvent2(2,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회		
				
			elseif szTranID == "obtss_fido_203r" then
				g_BIORetry = g_BIORetry + 1
				Form.setTimerEvent2(2,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			end if
			
			exit sub
		end if
		
		Form.removeWaitCursor()
		
		tbl_fido1("DENY_PREV_TOKEN")	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DENY_PREV_TOKEN" 		,0)
		tbl_fido1("APP_VRSN") 			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "APP_VRSN" 			,0)
		tbl_fido1("TOKEN_CHALLENGE")	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CMPA_TOKEN_CHAL" 		,0)
		tbl_fido1("FIDO_LEN") 			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_FIDO_MSG_SIZE1" 	,0)
		tbl_fido1("FIDO_MSG") 			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_FIDO_ATHN_RQST_MSG"	,0)
		tbl_fido1("BIO_TLMS_TRC_NO")	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BIO_TLMS_TRC_NO"		,0)

		sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		'20220804 SWJ START : Trim처리, Recv_Msg 변수로 수정(변수가 아예 다른게 적혀서 null 오류 남)
		'길이정보확인
		if CLng(tbl_fido1("FIDO_LEN")) <> LEN(Trim(tbl_fido1("FIDO_MSG"))) then
			Form.MsgBox("알림", "[TR] " & Recv_Msg & "\n(" & sSubMsg & ")", "", 0)
			exit sub
		end if
		
		'FIDO 메시지 시작/종료 문자 확인
		if left(tbl_fido1("FIDO_MSG"), 1) <> "{" or right(Trim(tbl_fido1("FIDO_MSG")),1) <> "}" then
			Form.MsgBox("알림", "[TR] " & Recv_Msg & "\n(" & sSubMsg & ")", "", 0)
			exit sub
		end if
		'20220804 SWJ END		
		
		'앱버전비교
		sSvrAppVersion = tbl_fido1("APP_VRSN")
		sMinAppVersion = Left(sSvrAppVersion, 4)		'최소버전
		sNewAppVersion = Right(sSvrAppVersion, 4)	'최신버전
		
		'현재버전이 최소버전보다 낮을 경우 반드시 업데이트
		if CInt(g_sBioAppVersion) < CInt(sMinAppVersion) then
			Form.MsgBox("알림", "금융결제원 바이오인증 공동앱 업데이트를 진행합니다.", "FIDO_UPDATE", 1)
			exit sub
			
		'현재버전이 최신버전보다 낮을 경우 업데이트를 권고
		elseif CInt(g_sBioAppVersion) < CInt(sNewAppVersion) then
			Form.Toast(0, "금융결제원 바이오인증 공동앱 업데이트를 권장합니다." , 0)
		end if

		'인증요청메시지전송
		'기관코드, 서비스코드, 호환토큰 Challenge, FIDO 인증요청메시지, 축약서명 키쌍 필요여부
		sParam = "00287" & "★" & "001" & "★" & tbl_fido1("TOKEN_CHALLENGE") & "★" & tbl_fido1("FIDO_MSG") & "★" & "Y"
		Form.requestKftcBio("Bio_115", sParam, "90020") 
	
	'공동FIDO인증전송
	elseif szTranID == "obtss_fido_004a" or szTranID == "obtss_fido_204r" then
		Recv_Code	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_CODE" 		,0) '응답코드
		Recv_Msg		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_MSG_CNTT" 	,0) '응답메세지 내용
		Uniq_Code	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OTSD_TR_UNIQ_NO" 	,0) '대외거래고유번호
		Recv_TR_Code	= DATAMANAGER.GetDataMsgCode(szTranID)

		'20220614_01 KBC 송수신분리 적용 시
		'6617.처리대기중입니다.
		if Recv_Code == "6617" or Recv_TR_Code == "6617" then
			if szTranID == "obtss_fido_004a" then
				g_BIOSeqNo	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OTSD_TR_UNIQ_NO", 0)
				g_BIOTrName	= szTranID
				g_BIORetry	= 0
				
				Form.setTimerEvent2(2,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회		
				
			elseif szTranID == "obtss_fido_204r" then
				g_BIORetry = g_BIORetry + 1
				Form.setTimerEvent2(2,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			end if
			
			exit sub
		end if
		
		Form.removeWaitCursor()

		sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

		if Recv_Code <> "0000" then
			if Len(sSubMsg) > 1 Then
				Form.ShowAlert("알림", "[TR] " & Recv_Msg & "\n(" & sSubMsg & ")")
			else
				Form.ShowAlert("알림", "[TR] " &  Recv_Msg)
			end if	
			
			Call LoginFailSendHWInfo(g_sID) '부정접속 관련 대응-로그인 실패시
			exit sub
		end if

		'20220614_01 KBC 송수신분리 적용 시
		If  g_BIOAppErrCd == "5121" Then
			exit sub
		End If

		Call Request_obcpp_lbio_022a("Y", "")
		
	'티켓온 인증요청 응답
	elseif szTranID == "obtss_fido_013a" or szTranID == "obtss_fido_213r" then 
		Recv_Code	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_CODE" 		,0)
		Recv_Msg		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_MSG_CNTT"		,0)
		Recv_TR_Code	= DATAMANAGER.GetDataMsgCode(szTranID)
		
		'20220614_01 KBC 송수신분리 적용 시
		'6617.처리대기중입니다.
		if Recv_Code == "6617" or Recv_TR_Code == "6617" then
			if szTranID == "obtss_fido_013a" then
				g_BIOSeqNo 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OTSD_TR_UNIQ_NO", 0)
				g_BIOTrName	= szTranID
				g_BIORetry	= 0
				
				Form.setTimerEvent2(2,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회
				
			elseif szTranID == "obtss_fido_213r" then
				g_BIORetry = g_BIORetry + 1
				Form.setTimerEvent2(2,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			end if
			
			exit sub
		end if
		
		Form.removeWaitCursor()
		
		tbl_fido2("OTSD_TR_UNIQ_NO")	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OTSD_TR_UNIQ_NO"	,0)
		tbl_fido2("BIO_TLMS_TRC_NO")	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BIO_TLMS_TRC_NO"	,0)
		tbl_fido2("FIDO_TLMS_TRC_NO")	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDO_TLMS_TRC_NO"	,0)
		
		sParam = tbl_fido2("FIDO_TLMS_TRC_NO") & "★" & g_sBIOAthnTchnCode & "★" & "Y" 'FIDO추적번호,인증기술코드,축약서명키쌍 필요여부(Y/N)
		Form.requestKftcBio("Bio_2115", sParam, "90020")			
		
	'티켓온 인증결과 응답
	elseif szTranID == "obtss_fido_014a" or szTranID == "obtss_fido_214r" then 
		Recv_Code	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_CODE" 		,0) '응답코드
		Recv_Msg		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_MSG_CNTT" 	,0) '응답메세지 내용
		Uniq_Code	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OTSD_TR_UNIQ_NO" 	,0) '대외거래고유번호	
		Recv_TR_Code	= DATAMANAGER.GetDataMsgCode(szTranID)
		
		'20220614_01 KBC 송수신분리 적용 시
		'6617.처리대기중입니다.
		if Recv_Code == "6617" or Recv_TR_Code == "6617" then
			if szTranID == "obtss_fido_014a" then
				g_BIOSeqNo 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OTSD_TR_UNIQ_NO", 0)
				g_BIOTrName	= szTranID
				g_BIORetry	= 0
			
				Form.setTimerEvent2(2,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회
				
			elseif szTranID == "obtss_fido_214r" then
				g_BIORetry = g_BIORetry + 1
				Form.setTimerEvent2(2,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			end if
			
			exit sub
		end if
		
		Form.removeWaitCursor()
		
		Call Request_obcpp_lbio_022a("Y", "")
		
	'-------------------------------------------------------------------------------------------------------
	'20220614_01 KBC END
	'-------------------------------------------------------------------------------------------------------

	'BIO로그인	
	elseif szTranID == "obcpp_lbio_022a" then		
		g_sCertLogin = DEF_BIO
		Form.SetSharedData("&CERT_USE_TYPE", "3") '0.공인인증서 1.간편인증-공인인증서 2.코스콤지문-공인인증서 3.결제원-FIDO인증서 4.금투협-공동인증서 5.아톤사설인증 6.클라우드인증
		Form.SetSharedData("&CERT_USE_BIO_TYPE", g_sBIOAthnTchnCode)
		Form.SetEnvData(1,"login.athntchn.cd", g_sBIOAthnTchnCode) '인증기술코드 (성공했던 바이오인증 기술코드를 저장)
		
		sMsg = DATAMANAGER.GetDataMsgText(szTranID)
		sClscode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CONN_PRMS_CLS_CODE" ,0) '접속허용구분 코드
		
		'부정접속 관련 대응-로그인 실패시
		if sClscode <> "0" then
			Call LoginFailSendHWInfo(g_sID)
		end if
		
		Select Case  sClscode
			Case  "0" '접속허용(정상로그인)
				Form.SetEnvData(1,"login.input.userid",g_sID)
			Case  "1" '등록되지 않은 ID
				Form.ShowAlert("알림", "등록되지 않은 ID입니다. ID를 확인하시기 바랍니다.")
				exit sub
			Case  "8" '미등록 단말
				Form.ShowAlert("알림", "[TR] " & sMsg)
				exit sub
			Case  "A" '부메세지에 시간이 들어있음	
				Form.ShowAlert("알림", "시스템 점검시간 " & sMsg & "동안은 \n시세조회 전용으로 로그인 됩니다.\n계좌정보 조회 및 이체서비스는 시스템 점검시간 이후 재접속\n하셔야만 이용 가능합니다.")
				exit sub
			Case  "N"
				exit sub	
			'20230726 SWJ START
			Case "R" 'MTS 약정 거부
				Form.MsgBox("안내", "모바일서비스 이용거부 상태입니다.\nHTS [7439]에서 이용 신청 후 이용해주세요." , "", 0)	
				exit sub
			'20230726 SWJ END
			Case else ' 알 수 없는 오류
				Form.ShowAlert("알림", "[TR] " & sMsg)
				exit sub
		End Select	

'		sCheckState = Form.GetCtlProp("ContainerBio.chkSaveID", "checkstate")
		sCheckState = Form.GetCtlProp("ContainerID.chkSaveID", "checkstate")
		Form.SetEnvData(1, "login.input.saveid",sCheckState)
		
		g_sDplcPrms	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DPLC_CONN_PRMS_YN"	,0) '중복접속허용여부
		g_sRCNO		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RCNO" 			,0) '실명확인번호
		
		g_sUserName	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "USER_NAME"		,0) '사용자명
		g_sCSNO		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CSNO"				,0) '고객번호
		sDN			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DN_DATA"			,0) 'DN Data
		g_SSTM_Date	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SSTM_DATE"		,0) '시스템일자
		
		if g_sRcnoPlainRm == "1" then
			g_sRCNO = "" '서비스에서 테스트중 평문을 같이 내려줘서 일부러 초기화
			g_sRCNO_PIP	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RCNO_PIP" 	,0) '실명확인번호
		end if

		DATAMANAGER.RequestTranData("ohhts_logn_dupt") '중복로그인 체크
	
	'20220805_01 KBC : 로그인개선
	'바이오인증등록정보조회
	elseif szTranID == "obcsb_fido_005r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , szTranID, "OutBlock1")-1
			sTERM_OS_CODE			= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TERM_OS_CODE" 		, i) 	'단말OS '1.안드로이드 2.iOS
			sTERM_ID				= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TERM_ID" 			, i) 	'단말ID
			sATHN_TCHN_CODE		= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ATHN_TCHN_CODE" 		, i) 	'인증기술코드 100, 116
			sBIO_ATHN_STAT_CODE	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "BIO_ATHN_STAT_CODE" 	, i) 	'바이오인증상태코드 1.등록 2.재등록 3.해지
			sCHAN_TYPE_CLS_CODE	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CHAN_TYPE_CLS_CODE" 	, i)		'채널유형코드
			
			if sATHN_TCHN_CODE == DEF_BIO_FINGER and sBIO_ATHN_STAT_CODE <> "3" then
				g_005r_bFinger = true
			elseif sATHN_TCHN_CODE == DEF_BIO_PIN and sBIO_ATHN_STAT_CODE <> "3" then
				g_005r_bPin = true
			end if
		next

		if g_005r_bFinger == false or g_005r_bPin == false then
			if  DATAMANAGER.IsMoreNextData( szTranID ) == true then 
				DATAMANAGER.RequestNextData( szTranID )
				exit sub
			end if
		end if
		
'테스트
'g_005r_bFinger = false
'g_005r_bPin =  true

		if g_005r_bFinger == true and g_005r_bPin == true then
			g_sBioReg = "12"		'12 : 등록정보있음 (ALL, 최종모름)
			
			'직전 인증방식
			sBioAthntChnCode = Trim(Form.GetEnvData("login.input.bioathntchncode"))
			
			if sBioAthntChnCode == DEF_BIO_FINGER then
				g_sBioReg = "10"
			elseif sBioAthntChnCode == DEF_BIO_PIN then
				g_sBioReg = "11"
			end if						
		elseif g_005r_bFinger == true then
			g_sBioReg = "20"		'20 : 등록정보있음 (지문)			
		elseif g_005r_bPin == true then
			g_sBioReg = "21"		'21 : 등록정보있음 (PIN)
		else 
			g_sBioReg = "01"		'01 : 등록정보없음
		end if
		
		ProcReceiveBioRegInfo()
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)	
	if szTranID == "obcsb_efif_021r" then
		sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if Len(sSubMsg) > 1 Then
			Form.MsgBox("알림", "[TR] " & szErrMsg & "\n(" & sSubMsg & ")" , "", 0)
		else
			Form.MsgBox("알림", "[TR] " & szErrMsg  , "", 0)
		end if
		
	elseif szTranID = "obtrd_acnt_009r" then
		'KBC : MsgBox 뿌리지 않기 위해서 if문추가
	
	'20231219 SWJ START
	elseif szTranID = "obcsb_efif_028r" then
	'20231219 SWJ END
	
	elseif szTranID == "obcsb_efif_005r" then
		sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if Len(sSubMsg) > 1 Then
			Form.MsgBox("알림", "[TR] " & szErrMsg & "\n(" & sSubMsg & ")" , "", 0)
		else
			Form.MsgBox("알림", "[TR] " & szErrMsg  , "", 0)
		end if
		
		Form.CloseForm()
		
	elseif szTranID == "obcpp_pcrt_166a" then
		'OCSP검증 -> 폐지된 인증서 등...인증서 유효하지않음
		
		if g_sCertLogin == DEF_PIN then
			'간편인증
			ContainerSpin.btnLogin.enable = "1"
			
			szErrMsg2 = "[TR]간편인증서비스 신청 시 사용한 인증서는 더이상 사용하실 수 없습니다.\n\n" &
			            "유효한 인증서로 로그인(거래용 ID인증)하신 후 간편인증서비스를 재설정 해주시기 바랍니다.\n\n" &
				        szErrMsg
					
			Form.MsgBox("알림", szErrMsg2, "", 0)
		else
			Form.MsgBox("알림", "[TR] " &  szErrMsg  , "", 0)
		end if
		
	'-------------------------------------------------------------------------------------------------------
	'20220614_01 KBC START 바이오인증 송수신분리
	'-------------------------------------------------------------------------------------------------------
	elseif szTranID == "obtss_fido_003a" or szTranID == "obtss_fido_004a" or szTranID == "obtss_fido_013a" or szTranID == "obtss_fido_014a" then
	
		Form.removeWaitCursor() '20220614_01 KBC 바이오인증 송수신분리 (서비스에러)
		
		'부정접속 관련 대응-로그인 실패시
		'		fido_003a : 미등록단말, 횟수초과 로 인한 로그인 실패
		'		fido_004a : 인증취소 , 지문 불일치로 인한 로그인 실패
		Call LoginFailSendHWInfo(g_sID)
				
		'오레오 대응
		if g_sBIOTermOS == DEF_ANDROID then
			szSdkVer = Form.GetSharedData("&SDK_VERSION", false)
			if szTranID == "obtss_fido_004a" and szErrCode == "5891" and Cint(szSdkVer) > 25 then
				szText = "구글 최신(오레오) 운영체제에서\n바이오 인증을 사용중인 고객님께서는\n금융결제원 바이오인증정책 변경에\n의하여 바이오인증 재등록이 필요합니다.\n\n바이오인증센터에서 재등록하시기 바랍니다.\n\n사유 : 금융결제원 바이오식별정보 정책변경"
				Form.MsgBox("알림", szText , "FIDO_JOIN", 1) 
				exit sub
			end if
		end if

		sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if Len(sSubMsg) > 1 Then
			Form.MsgBox("알림", "[TR] " & szErrMsg & "\n\n" & sSubMsg, "", 0)
		else
			Form.MsgBox("알림", "[TR] " & szErrMsg  , "", 0)
		end if
			
	elseif szTranID == "obtss_fido_203r" or szTranID == "obtss_fido_204r" or szTranID == "obtss_fido_213r" or szTranID == "obtss_fido_214r" then
		
		Form.removeWaitCursor() '20220614_01 KBC 바이오인증 송수신분리 (서비스에러)
		
		'부정접속 관련 대응-로그인 실패시
		'		fido_003a : 미등록단말, 횟수초과 로 인한 로그인 실패
		'		fido_004a : 인증취소 , 지문 불일치로 인한 로그인 실패
		Call LoginFailSendHWInfo(g_sID)
		
		sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if Len(sSubMsg) > 1 Then
			Form.MsgBox("알림", "[TR] " & szErrMsg & "\n\n" & sSubMsg, "", 0)
		else
			Form.MsgBox("알림", "[TR] " & szErrMsg  , "", 0)
		end if	
	'-------------------------------------------------------------------------------------------------------
	'20220614_01 KBC END 바이오인증 송수신분리
	'-------------------------------------------------------------------------------------------------------
	
	elseif szTranID == "obcpp_logn_010a" then
		Call Request_obtrd_acnt_326r( ) '해외파생 고객별 시세신청 거래소 조회
	
	'20190319 HWG START : 모의투자 참가신청 유도
	elseif szTranID == "obcpp_logn_022a" then		
		if szErrCode == "1022" then
			szMsg = "모의투자 참가신청이 확인되지 않습니다.\n참가신청 상태를 확인하셔야 합니다.\n\n※모의투자 참가신청 페이지로 연결합니다."
			Form.MsgBox("알림", szMsg , "mockdeal_regi", 2)
		else
			sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
			if Len(sSubMsg) > 1 Then
				Form.MsgBox("알림", "[TR] " & szErrMsg & "\n(" & sSubMsg & ")" , "", 0)
			else
				Form.MsgBox("알림", "[TR] " & szErrMsg  , "", 0)
			end if
		end if
	'20190319 HWG END
	
	
	'20220805_01 KBC : 로그인개선
	'바이오인증등록정보조회
	elseif szTranID == "obcsb_fido_005r" then
		'에러 시 ALL로 처리
		'12 : 등록정보있음 (ALL, 최종모름)
		g_sBioReg = "12"
		ProcReceiveBioRegInfo()
	
	else
		sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
		if Len(sSubMsg) > 1 Then
			Form.MsgBox("알림", "[TR] " & szErrMsg & "\n(" & sSubMsg & ")" , "", 0)
		else
			Form.MsgBox("알림", "[TR] " & szErrMsg  , "", 0)
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'20220614_01 KBC START 바이오인증 송수신분리
	if szTranID == "obtss_fido_003a" or szTranID == "obtss_fido_004a" or szTranID == "obtss_fido_013a" or szTranID == "obtss_fido_014a" then
		Form.addWaitCursor()
	end if
	'20220614_01 KBC END
End Sub

'============================================================================
'바이오인증 로그인
Sub Request_obcpp_lbio_022a(sSeviceYN, sMessage)
	if g_sID == null or g_sID == "" then
		exit sub
	end if	
	
	szTranID = "obcpp_lbio_022a"	
	
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "USER_ID"		, 0 , g_sID)			'사용자 ID
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TERM_IDNT_KEY"	, 0 , g_sDeviceID)	'단말식별키
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CONN_SUCS_YN"	, 0 , sSeviceYN)		'접속성공여부
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CONN_DTL_CNTT"	, 0 , sMessage)		'접속상세내용
	
	if g_sBIOAthnTchnCode == DEF_BIO_FINGER then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ATHN_MDIA_TYPE_CODE", 0 , "07") 	'07.Bio인증 (지문)
	elseif g_sBIOAthnTchnCode == DEF_BIO_PALM then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ATHN_MDIA_TYPE_CODE", 0 , "09") 	'09.Bio인증 (장문)
	elseif g_sBIOAthnTchnCode == DEF_BIO_PIN then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ATHN_MDIA_TYPE_CODE", 0 , "10") 	'10.Bio인증 (PIN)
	end if

	DATAMANAGER.RequestTranData(szTranID)
End Sub

