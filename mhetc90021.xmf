		'===========================================================================
		DethYn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock4", "DETH_YN" , 0)
		
		if DethYn == "Y" then
			Form.MsgBox("사망자 사고등록 안내", "행정자치부의 사망자 자료 접수에 의하여 고객님 실명번호로 사망사고가 등록되어 입출금 거래 및 신규상품 가입이 불가합니다.\n\n거래 재개를 원하실 경우, 가까운 영업점을 방문하시어 상속처리 또는 본인확인 절차에 따른 처리를 하시기 바랍니다.", "", 0)
		end if
	
		g_bCloseForm = TRUE '안내팝업 close 시점 잡기 위한 bool 값.
		
		'===========================================================================
		'해외파생 개인정보처리 팝업 20210601 HSZ 
		'===========================================================================
		if g_bCloseForm then			
			aplt_yn  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock9", "APLT_YN" , 0)
			agrm_yn  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock9", "AGRM_YN" , 0)
			
			if aplt_yn = "Y" and agrm_yn = "N" then
				g_bCloseForm = FALSE
				
				n_acno = DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock9", "ACNO" , 0 )
				n_asno = DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock9", "ASNO" , 0 )
				acno_pop = n_acno & n_asno

				n_emplYN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock9", "EMPL_YN" , 0 )
				n_agrmCLCD = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock9", "AGRM_PROD_CLCD" , 0 )
				n_empno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock9", "EMPNO" , 0 )
				
				Form.SetSharedData( "MHETC90021POP_ACNO"       , acno_pop )
				Form.SetSharedData( "MHETC90021POP_EMPL_YN"    , n_emplYN )
				Form.SetSharedData( "MHETC90021POP_AGRM_CLCD"  , n_agrmCLCD )
				Form.SetSharedData( "MHETC90021POP_EMPNO"      , n_empno )
				
				Form.OpenFramePopup("mhtrd44500_onepop" , "" , 0)
			end if
		end if
		
		'===========================================================================
		'ETF자동해지대상고객 팝업 - 201607 김인택과장 요청
		'===========================================================================
		if g_bCloseForm then
		
			EtfCancCode = DATAMANAGER.GetDataValue(0 , szTranID, "OutBlock2", "ETF_ATMT_CANC_TRGT_CLS_CODE" , 0)	'ETF자동해지대상구분코드
			EtfCancDate = DATAMANAGER.GetDataValue(0 , szTranID, "OutBlock2", "ETF_CANC_SCDL_DATE" , 0)       	'ETF해지예정일자

			if Len(EtfCancDate) == 8 then
				szData = EtfCancCode & "★" & EtfCancDate 
				g_bCloseForm = FALSE
				Form.OpenPopup("mbonl88000_p1" , szData , sPosInfo)
			end if
		end if
		
		'===========================================================================
		'투자성향 만료 안내 팝업 (2년)
		'===========================================================================
		'20220829 SWJ START : 만료 14일전(하루동안 보지 않기), 만료 후(일주일 동안 보지 않기)의 구분 로직 추가
		if g_bCloseForm then 'ETF자동해지 해당없을때만 2년만기 고려 (아이폰 : 두개 팝업 실행 시 로그인 종료 시 문제되어...MTS만 이와같이 처리하기로 함)
			KYCPopChk = Trim(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "KYC_INVT_RCMD_CLS_CODE" , 0)) '투자권유구분코드 (투자성향 만료 안내 팝업 (2년))
			
			'20240718 SWJ START
			KYCGradeName = Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "KYC_INVT_INCL_GRAD_NAME", 0))
			'20240718 SWJ END
			
			If KYCPopChk <> "" Then '전문투자자만 팝업 공지를 하지 않음.
				KYCValdDate = Trim(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "KYC_VALD_PRD_MTRT_DATE", 0)) 'KYC 유효기간만료일자

				If Len(KYCValdDate) >= 8 And Len(g_SSTM_Date) >= 8 Then	
					ReKYCValdDate = left(KYCValdDate,4)&"-"&mid(KYCValdDate,5,2)&"-"&right(KYCValdDate,2)
					ReCurDate = left(g_SSTM_Date,4)&"-"&mid(g_SSTM_Date,5,2)&"-"&right(g_SSTM_Date,2)

					If DateDiff("d",ReCurDate,ReKYCValdDate) >= 0 and DateDiff("d",ReCurDate,ReKYCValdDate) <= 14 Then '만료 14일전부터 안내
						szKYCflag = 1
					elseif DateDiff("d",ReCurDate,ReKYCValdDate) < 0 then	'만료 후
						szKYCflag = 7
					End if
					
					if szKYCflag <> "" and szKYCflag <> null then
						g_bCloseForm = FALSE
						szData = KYCValdDate
					
						Form.SetSharedData("KYC_KEY" , szKYCflag)
						Form.OpenPopup("mbonl81010_p5" , szData , sPosInfo)
					end if
				End if 	
				
			'20240718 SWJ START: 토스개설 고객 한해, KYC 미진단 안내 팝업 추가
			else
				if Trim(KYCGradeName) <> "전문투자자" and g_bTossBank then
					
					todayDate = Form.GetSharedData("&HOST_DATE",0)
					saveDate = Form.LoadConfigData("NoticeSetting", "KYC_NOT_DIAGNOSED")
					     
					if saveDate <> "" then
						
						ResaveDate 	= left(saveDate,4)&"-"&mid(saveDate,5,2)&"-"&right(saveDate,2)
						RetodayDate 	= left(todayDate,4)&"-"&mid(todayDate,5,2)&"-"&right(todayDate,2)
						
						calcDate = tonumber(DateDiff("d",ResaveDate, RetodayDate))
				
						'일주일 간 보지 않기 체크되어 있으면 띄우지 않는다.
						if calcDate > 7 then
							g_bCloseForm = false
							Form.OpenPopup("mbonl81010_p55" ,"" ,"")
						end if
					else
						g_bCloseForm = false
						Form.OpenPopup("mbonl81010_p55" ,"" ,"")
					end if
					
				end if
			
			'20240718 SWJ END
			
			End if 
		end if
		'20220829 SWJ END
		
