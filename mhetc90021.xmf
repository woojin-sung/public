	elseif szTranID == "obcpp_logn_010a" then
		sNatnCD =  DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "NTNT_ISO_SHRN_CTCD" ,0)
		
		Form.SetSharedData("&NATIONAL_CD" , sNatnCD)	'국가코드
		
