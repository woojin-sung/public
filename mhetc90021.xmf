		Form.RequestCommand("DEVICE_LOG", "", "") 	'기기정보 로깅추가	
		Form.SendHWInformation("001", "")			'FDS 로깅추가 (001.로그인, 002.이체/대체, 003.인증서(재)발급, 004.주소/연락처 변경)
												'!!! FDS 로깅은 국가정보조회 이후에 있어야 한다
		
		sDay =  DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CONN_YMDH" ,0)
		
