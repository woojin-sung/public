	ContainerBio_ContainerALL_ImagePIN_OnClick()
End Sub

'============================================================================
Sub proc_BioLogin(nIndex)
	if nIndex == 0 then
		if g_sBioEnbl == "2" then '바이오인증 지원 여부 : 0.미지원 1.지원(지문가능) 2.지원(지문불가)
			Form.MsgBox("알림", "지문인증장치가 존재하지 않습니다. PIN인증을 사용하시기 바랍니다.", "", 0)
			Exit Sub		
		end if
	
		g_sBIOAthnTchnCode = DEF_BIO_FINGER
		
	elseif nIndex == 1 then
		g_sBIOAthnTchnCode = DEF_BIO_PALM
	elseif nIndex == 2 then
		g_sBIOAthnTchnCode = DEF_BIO_PIN
	end if
	
	Form.SetEnvData(1, "login.input.bioathntchncode", g_sBIOAthnTchnCode) '20220805_01 KBC : 로그인개선
	
	g_sID = Form.GetCtlProp("ContainerBio.edtID", "caption")
	
	if g_sID == null or g_sID == "" then	
		g_sID = Form.GetEnvData("login.input.userid") '20220805_01 KBC : 로그인개선

		if g_sID == null or g_sID == "" then	
			Form.MsgBox("알림", "사용자 ID를 입력하세요.", "", 0)
			Exit Sub
		end if
	end if	

	'FIDO 앱 설치여부
	sRet = Form.GetKftcBioInstalled()
	
	if sRet == "0" then '0 : 설치안됨, 1 : 설치됨
		Form.setKftcBioInstalled() 'FIDO 설치
		exit sub
	end if
	
	g_sSiseCheck = "0" '바이오인증은 시세조회전용없음
	
	'디바이스ID요청
	Form.requestKftcBio("Bio_401", "", "90020")
End Sub

'============================================================================
'공동FIDO 인증정보 생성 요청 통보
Sub ProcSendBIO_003a(ELFN_ID, ABRV_SGNT_TYPE_CODE, TERM_OS_CODE, TERM_ID, SVCD, ATHN_TYPE_CODE, BIO_TR_TYPE_CODE)
	szTranID = "obtss_fido_003a"
	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID" 			, 0, ELFN_ID)				'ID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ABRV_SGNT_TYPE_CODE"	, 0, ABRV_SGNT_TYPE_CODE)	'서명타입	: 0.일반서명, 1.축약/자동서명
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "TERM_OS_CODE" 		, 0, TERM_OS_CODE)		'단말운영체제	: 1.안드로이드, 2.아이폰, 9.기타
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "TERM_ID" 			, 0, TERM_ID)				'단말ID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" 				, 0, SVCD)				'서비스코드	: 001.고정
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ATHN_TYPE_CODE" 		, 0, ATHN_TYPE_CODE)		'인증타입	: .자사인증, D.교차인증, C.호환인증
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BIO_TR_TYPE_CODE" 	, 0, BIO_TR_TYPE_CODE)		'거래타입	: 0.인증, 1.서명
	
	DATAMANAGER.RequestTranData(szTranID)	
End Sub

'============================================================================
'공동FIDO인증전송
Sub ProcSendBIO_004a(ELFN_ID, APP_RSPN_CODE, BIO_TLMS_TRC_NO, ATHN_USAG_CLS_CODE, AAID, ATHN_TYPE_CODE, NID_CMPA_TOKEN, UI_ABRV_SGNT_OPBL_KEY, UI_FIDO_ATHN_RSPN_MSG)
	szTranID = "obtss_fido_004a"

	g_BIOAppErrCd = APP_RSPN_CODE '20220614_01 KBC 바이오인증 송수신분리

	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID" 				, 0, ELFN_ID)						'ID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "APP_RSPN_CODE" 			, 0, APP_RSPN_CODE)				'연계앱응답코드 : 0000.정상, 5219.에러
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BIO_TLMS_TRC_NO" 			, 0, BIO_TLMS_TRC_NO)				'전문추적번호
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ATHN_USAG_CLS_CODE" 		, 0, ATHN_USAG_CLS_CODE)			'인증용도구분코드 : 0.일반, 1.출금동의 증빙자료
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "AAID" 					, 0, AAID)						'AAID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ATHN_TYPE_CODE" 			, 0, ATHN_TYPE_CODE)				'인증타입 : S.자사인증, D.교차인증, C.호환인증
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "NID_CMPA_TOKEN" 			, 0, NID_CMPA_TOKEN)				'비식별호환토큰
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_FIDO_MSG_SIZE1" 		, 0, LEN(UI_ABRV_SGNT_OPBL_KEY))	'축약서명공개키길이
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_ABRV_SGNT_OPBL_KEY" 	, 0, UI_ABRV_SGNT_OPBL_KEY)			'축약서명공개키
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_FIDO_MSG_SIZE2" 		, 0, LEN(UI_FIDO_ATHN_RSPN_MSG))	'FIDO인증응답메시지길이
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_FIDO_ATHN_RSPN_MSG" 	, 0, UI_FIDO_ATHN_RSPN_MSG)			'FIDO인증응답메시지

	DATAMANAGER.RequestTranData(szTranID)
End Sub

'============================================================================
'티켓온 인증정보 생성 요청 통보
Sub ProcSendBIO_013a(ELFN_ID, TERM_ID, SVCD, BIO_TR_TYPE_CODE, ATHN_TCHN_CODE)
	szTranID = "obtss_fido_013a"
	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID" 			, 0, ELFN_ID)				'ID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "TERM_ID" 			, 0, TERM_ID)				'단말ID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" 				, 0, SVCD)				'서비스코드	: 001.고정
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BIO_TR_TYPE_CODE" 	, 0, BIO_TR_TYPE_CODE)		'거래타입	: 0.인증, 1.서명
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ATHN_TCHN_CODE" 		, 0, ATHN_TCHN_CODE)		'인증기술코드	: 100.지문, 116.PIN, 115.손바닥

	DATAMANAGER.RequestTranData(szTranID)	
End Sub

'============================================================================
'티켓온 인증전송
Sub ProcSendBIO_014a(ELFN_ID, BIO_TLMS_TRC_NO, ATHN_USAG_CLS_CODE)
	szTranID = "obtss_fido_014a"

	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1", "ELFN_ID"			, 0 , ELFN_ID) 			'전자금융ID
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1", "BIO_TLMS_TRC_NO"		, 0 , BIO_TLMS_TRC_NO)		'바이오전문추적번호
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1", "ATHN_USAG_CLS_CODE"	, 0 , ATHN_USAG_CLS_CODE)	'인증용도구분코드 : 0.일반, 1.출금동의 증빙자료

	DATAMANAGER.RequestTranData(szTranID)
End Sub

'============================================================================
Sub ContainerID_chkSise_OnChange(sCheckState)
	g_sSiseCheck = sCheckState
	Form.SetEnvData(1, "login.input.siseonly",sCheckState)
	
	if g_sSiseCheck == "1" or g_sMockDealCheck == "1" then
		ContainerID.edtCertPass.visible = false
		ContainerID.ImageLine1.visible = false
	else
		ContainerID.edtCertPass.visible = true
		ContainerID.ImageLine1.visible = true
	end if
End Sub

'============================================================================
Sub ContainerID_chkMockDeal_OnChange(sCheckState)
	if g_sBIOTermOS == DEF_IOS Then
		if sCheckState == "1" then
			Form.MsgBox("모의투자 접속", "모의투자 서비스를 이용하기 위해서 앱이 종료됩니다.\n재실행 시 모의투자로 접속됩니다.", "mockdeal_y", 2)
		else
			Form.MsgBox("메리츠SMART 접속", "메리츠SMART 서비스를 이용하기 위해서 앱이 종료됩니다.\n재실행 시 메리츠SMART로 접속됩니다.", "mockdeal_n", 2)
		end if
	else
		if sCheckState == "1" then
			Form.MsgBox("모의투자 접속", "모의투자 서비스를 이용하기 위해서는 재접속이 필요합니다.\n\n[예] 버튼을 누르면 앱이 자동으로 재시작 됩니다.", "mockdeal_y", 2)
		else
			Form.MsgBox("메리츠SMART 접속", "메리츠SMART 서비스를 이용하기 위해서는 재접속이 필요합니다.\n\n[예] 버튼을 누르면 앱이 자동으로 재시작 됩니다.", "mockdeal_n", 2)
		end if
	end if
End Sub

'============================================================================
Sub poc_LoginTypeSelect(sSaveTab, bSpinReg)
	if g_sMockDealCheck == "1" then
		if sSaveTab <> DEF_TAB_ID then
			Form.MsgBox("알림", "모의투자에서는 해당업무가 제공되지 않습니다.", "", 0)
			exit Sub
		end if
	end if
	
	'sSaveTab => 0:간편인증, 1:인증서로그인, 2:ID로그인, 3:바이오인증, 4:모의투자	

	'----------------------------------------------------
	'간편인증
	'----------------------------------------------------
	if (sSaveTab == DEF_TAB_PIN) then
		g_sCertLogin = DEF_PIN
		Call MoveContainer()

		'로그인 자동진행(간편인증)
		Form.setTimerEvent2(5,1,0.1)
		
		sID = Form.GetCtlProp("ContainerSpin.edtID", "caption")
	
		if Len(sID) == 0 then
			ContainerSpin.btnCertLogin.Top = 169 '공동인증서로그인 버튼		'20230524 SWJ START : 위치 조정
			
			ContainerSpin.lblSPinNotFound1.visible = True
			ContainerSpin.lblSPinNotFound2.visible = True
			ContainerSpin.lblSPinNotFound3.visible = True
			ContainerSpin.btnCertLogin.visible = True
			ContainerSpin.btnLogin.visible = False
			ContainerSpin.btnCertLogin.Caption = "공동인증서 로그인 >"
			
			ContainerSpin.lblSPinNotFound1.Caption = "등록된 간편인증번호가 없어요."
			ContainerSpin.lblSPinNotFound2.Caption = "공동인증서 로그인 후"
			ContainerSpin.lblSPinNotFound3.Caption = "간편인증 서비스 등록이 가능합니다."
		end if

	'----------------------------------------------------
	'인증서로그인
	'----------------------------------------------------
	elseif (sSaveTab == DEF_TAB_CERT) then
		g_sCertLogin = DEF_CERT
		
		if bSpinReg == true then
			g_bSpinReg = true
		else
			g_bSpinReg = false
		end if
'		
		Call MoveContainer()
		
	'----------------------------------------------------
	'클라우드인증서로그인
	'----------------------------------------------------
	'20240314_01 KBC : 클라우드공동인증서 도입
	elseif (sSaveTab == DEF_TAB_CLOUDCERT) then
		g_sCertLogin = DEF_CLOUDCERT
		Call MoveContainer()	
		
		'로그인 자동진행(클라우드인증)
		Form.setTimerEvent2(12,1,0.1)
		
	'----------------------------------------------------
	'ID
	'----------------------------------------------------
	elseif (sSaveTab == DEF_TAB_ID) then
		g_sCertLogin = DEF_ID
		Call MoveContainer()
		
		'로그인 자동진행(아이디)
		Form.setTimerEvent2(3,1,0.1)	
		
	'----------------------------------------------------
	'바이오인증
	'----------------------------------------------------
	elseif (sSaveTab == DEF_TAB_BIO) then
		g_sCertLogin = DEF_BIO
		Call MoveContainer()
	
	'----------------------------------------------------
	'메리츠 간편인증	20230524 SWJ 추가
	'----------------------------------------------------
	elseif (sSaveTab == DEF_TAB_ATON) then
		g_sCertLogin = DEF_ATON
		Call MoveContainer()
	else
		if g_sOpenData <> "90022" and g_sOpenData <> "mhetc90022" then '90022.계좌개설/로그인(최초창)
			sId = Form.GetEnvData("login.input.userid") 
			if sId == null or sId == "" then
				'계좌개설/로그인(최초창)
				Form.OpenNextPopup("mhetc90022" , "" , "")
			end if
		end if
	end if
End Sub

'============================================================================
'부정접속 관련 대응 화면수정 
Sub LoginFailSendHWInfo(szID)
	
	'20230731 SWJ START : 이전 UserID로 세팅
	'(iOS 앱에서 로그인 실패인 경우에도 UserID를 Set해주고 있음 : 다음 번 앱 수정 예정)
	if Form.GetSharedData("&OS_TYPE" , false) == "2" then
		Form.setTimerEvent2("9999",1,0.1)
	end if
	'20230731 SWJ END
	
	Form.SetSharedData("&NATIONAL_CD" , "no")
	Form.SendHWInformation("005", szID)	
End Sub

'============================================================================
'인증서 만료 기간 체크 로직 추가
Function CheckCertExpired(s_DN)
	sExpired = Trim(Form.getCertificateCheckExpired(s_DN)) '0:유효, 1:만료, 2:만료예정

	if sExpired == "0" Then
		return True
		
	elseif sExpired == "1" or sExpired == "2" Then
		sExDate = Form.getCertificateExpiredDate(s_DN)

		sData = sExpired & "★" & sExDate

		Form.OpenPopup("mhetc90021_p2", sData, "")
		return False
	end if	
End Function

'============================================================================
Sub ContainerCert_edtCertPswd_OnEditComplete()
	g_sCertLogin = DEF_CERT
	g_sSiseCheck = "0" '인증서로그인은 시세조회전용없음
	
	g_sCertPass = ContainerCert.edtCertPswd.caption
		
	'인증서 특수기호 ">"종료글자 오류회피
	sCertPass = Form.GetSharedData("CERT_IMSI_PSWD", 1)
	
	if sCertPass <> null and sCertPass <> "" then
		g_sCertPass = sCertPass
	end if

	'20230718 SWJ START : 비밀번호 입력하다가 닫기 버튼 누르면 앱이 죽는 현상 수정(FormClose타면서 본 이벤트를 타서)
	if g_sCertPass <> "" and g_CertCloseFlag = False then
		'타이머 이벤트로 바꿈 (flag 얻는 타이밍보다 OnEditComplete이 빨라서)
		Form.setTimerEvent2("11",1,0.1)
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.setTimerEvent2(CInt(sTimerID), 0, 0)

	'20220614_01 KBC START 바이오인증 송수신분리
	if trim(sTimerID) == "2" then
		szTranID = ""
		
		if g_BIOTrName == "obtss_fido_003a" then
			szTranID = "obtss_fido_203r"
			
		elseif g_BIOTrName == "obtss_fido_004a" then
			szTranID = "obtss_fido_204r"
			
		elseif g_BIOTrName == "obtss_fido_013a" then
			szTranID = "obtss_fido_213r"
			
		elseif g_BIOTrName == "obtss_fido_014a" then
			szTranID = "obtss_fido_214r"
		end if
	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ELFN_ID"			, 0 , g_sID)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "OTSD_TR_UNIQ_NO"	, 0 , g_BIOSeqNo)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "RPCS_TMNU"			, 0 , g_BIORetry)
		DATAMANAGER.RequestTranData(szTranID)		

	elseif trim(sTimerID) == "3" then
		'아이디인증 키패드 

		'ID입력된 경우에만 자동진행
		if Len(ContainerID.edtID.caption) > 0 then
			if Len(ContainerID.edtPass.caption) == 0 then
				ContainerID.edtPass.SetShowKeypad(True)
			elseif Len(ContainerID.edtCertPass.caption) == 0 then
				ContainerID.edtCertPass.SetShowKeypad(True)
			end if		
		end if
		
	elseif trim(sTimerID) == "4" then
		'공동인증 키패드
		ContainerCert_btnLogin_OnClick()
		
	elseif trim(sTimerID) == "5" then
		'간편인증 진행
		
		sID = Form.GetCtlProp("ContainerSpin.edtID", "caption")
		if Len(sID) > 0 then
			ContainerSpin_btnLogin_OnClick()
		end if
			
	elseif trim(sTimerID) == "6" then
		'바이오인증 진행
		if g_sBioReg <> "00" and g_sBioReg <> "01" and g_sBioReg <> "12" then
			ContainerBio_btnLogin_OnClick() '바이오인증 로그인하기 클릭
		end if		
	
	'20230524 SWJ START : 메리츠 간편인증 추가
	elseif trim(sTimerID) == "7" then
		'메리츠 간편인증 진행
		
		if fnGetSBInfo("") == True and g_sAtonParam == "success" then
			ContainerAton_btnLogin_OnClick() '메리츠 간편인증 로그인하기 클릭
		end if
		
	'20230524 SWJ END
	
	elseif trim(sTimerID) == "9" then
		'FormAfterInit
		if g_bRunAfterInit == false then
			g_bRunAfterInit = true
			Form_OnAfterInit()
		end if
	'20220614_01 KBC END
	
	'20230524 SWJ START : iOS loadconfigdata 고객번호 못가져오고 씹히는 현상 수정
	elseif trim(sTimerID) == "10" then
		procRequestAtonAuth()
	
	'20230718 SWJ
	elseif Trim(sTimerID) == "11" then
		Form.RequestCertCommand("ReqCheckIsValidPassword", g_sDN, g_sCertPass) '일반(인증서로그인)
	
	'20230731 SWJ
	elseif Trim(sTimerID) == "9999" then		
		szUserID = Form.GetSharedData("&USER_ID", false)
		DATAMANAGER.SetUserID(szUserID)		
		
	'20240314_01 KBC START : 클라우드공동인증서 도입		
	elseif Trim(sTimerID) == "12" then '클라우드인증
		Form.requestCertCommand("CLOUD_REQ_CERT_LIST", "CLOUD", "90021") '응답이벤트에서 procSelectedCloudCert(g_sDN) 실행
	'20240314_01 KBC END
		
	end if
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	'20210708 HSZ START : 모의투자 로그인 분기처리
	if g_sMockDealCheck == "1" and Form.GetSharedData("&USER_ID", false )=""  then
		Form.MsgBox("알림", "로그인 후에 메리츠 SMART 사용이 가능합니다."& Chr(13)&Chr(10) &"프로그램을 종료하시겠습니까?", "MOCKBACKPRESS", 2)
		exit sub
	end if
	'20210708 HSZ END
	
	ImageClose_OnClick()
End Sub

