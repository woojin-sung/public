'============================================================================
'(클라우공동인증서) 인증서 검증전문 요청
Sub Request_obcpp_pcrt_166a_cloud()
	szTranID = "obcpp_pcrt_166a_1"
	
	DATAMANAGER.SetUserID(g_sID)	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "USER_ID" 				, 0 , g_sID)								'사용자ID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO"					, 0 , g_sRCNO) 							'실명확인번호	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "USER_NAME"				, 0 , g_sUserName)						'사용자명
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO"					, 0 , g_sCSNO) 							'고객번호
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CRPT_YN"					, 0 , "Y") 								'실명확인번호_암호화여부
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"				, 0 , g_sRCNO_PIP) 						'실명확인번호
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_R_VAL" 				, 0 , tbl_cloudcert("CLOUD_CERT_RANDOM"))	'R 값	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_ELCT_SGNT_DATA_CNTT" 	, 0 , tbl_cloudcert("CLOUD_CERT_SIGNDATA"))	'전자서명데이타
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "NTAT_SRNO" 				, 0 , tbl_cloudcert("CLOUD_CERT_SERIAL"))	'인증서 일련번호	
	
	'인증검증 TR
	DATAMANAGER.RequestTranData(szTranID)
End Sub

'============================================================================
'(클라우공동인증서) 클라우드 인증서 만료 기간 체크 로직
Function CheckCloudCertExpired(s_DN)
	
	'인증서 만료공지 팝업mhetc90021_p2 화면은 기존 공동인증서와 클라우드인증서 동일하게 사용함
	
	if s_DN == tbl_cloudcert("CLOUD_CERT_DN") then
		szToday = Form.GetSharedData("&HOST_DATE", false )	' 현재일(시작일)
		szEndDate = tbl_cloudcert("CLOUD_CERT_EXPIRED")		' 만기일(종료일)
		
		'DiggDate : 종료일 - 시작일
		if tonumber(Form.DiffDate(szToday, szEndDate)) > 30 then
			'유효
			return True
		elseif tonumber(Form.DiffDate(szToday, szEndDate)) <= 30 then
			'만료예정 (30일이전)
			sData = "2" & "★" & expiredDt '0:유효, 1:만료, 2:만료예정
			Form.OpenPopup("mhetc90021_p2", sData, "")
			return False
			
		else 
			'만료 (30일초과)
			sData = "1" & "★" & expiredDt '0:유효, 1:만료, 2:만료예정
			Form.OpenPopup("mhetc90021_p2", sData, "")
			return False
		end if
	end if
	
	return True
End Function

