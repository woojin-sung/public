	<SCRIPT_INFO _len="4751" _ulen="4611" >
'2024.06.25. 박윤경 : v001. 예금자보호 문구 변경
'============================================================================
Dim szOSType

Dim unPressedImgPath 
Dim PressedImgPath

Dim g_szRet

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("이해여부 확인")
	
	
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	if  szOSType == "1" then'iOS("2")Android("1")
		Container.lblQ1.changeTextAttr(21, 34, 128, -1, true)
		'Container.lblQ2.changeTextAttr(9, 34, 128, -1, true)
		Container.lblQ2.changeTextAttr(9, 18, 128, -1, true)	'v001
		Container.lblQ3.changeTextAttr(9, 28, 128, -1, true)
	else
		Container.lblQ1.changeTextAttr(21, 35, 128, -1, true)
		'Container.lblQ2.changeTextAttr(9, 35, 128, -1, true)
		Container.lblQ2.changeTextAttr(9, 18, 128, -1, true)	'v001
		Container.lblQ3.changeTextAttr(9, 29, 128, -1, true)
	end if


	unPressedImgPath = "btn_line_red_n.9.png"	'"btn_line_n.9.png"
	PressedImgPath   = "btn_line_red_o.9.png"	'"btn_line_o.9.png"
		
	Dim nQNum ' 문항번호
	for i = 0 to 2	
		nQNum = (i+1)
		for j = 1 to 3
			Select case nQNum
				case 1, 2, 3
					Form.SetCtlProp("Container.ImgQ" & nQNum & "A" & j, "imgpath", unPressedImgPath)
			End Select
		next
	next
	
	
	btnOK.enable = False
	btnOK.fgcolor = "269"    
	szTheme = Form.GetEnvData("common.theme")
	
	If szTheme == "white" Then
		btnOK.btnimage = "btn_21.9"
	Else
		btnOK.btnimage = "btn_27.9"
	End If	
End Sub

'============================================================================
Sub Container_ImgQ1A1_OnClick()
	g_Question_1 = "Y"
	SetCheckAnswer("1", "1")
End Sub
'============================================================================
Sub Container_ImgQ1A2_OnClick()
	g_Question_1 = "N"
	SetCheckAnswer("1", "2")
End Sub

'============================================================================
Sub Container_ImgQ2A1_OnClick()
	g_Question_2 = "Y"
	SetCheckAnswer("2", "1")
End Sub

'============================================================================
Sub Container_ImgQ2A2_OnClick()
	g_Question_2 = "N"
	SetCheckAnswer("2", "2")
End Sub

'============================================================================
Sub Container_ImgQ3A1_OnClick()
	g_Question_3 = "Y"
	SetCheckAnswer("3", "1")
End Sub

'============================================================================
Sub Container_ImgQ3A2_OnClick()
	g_Question_3 = "N"
	SetCheckAnswer("3", "2")
End Sub

'============================================================================
Function SetCheckAnswer(szQNum, szAnswerNum)
	Dim nQNum ' 문항번호
	nQNum = CDbl(szQNum)
	
	if szAnswerNum == "1" then
		Form.SetCtlProp("Container.ImgQ" & nQNum & "A1", "imgpath", PressedImgPath)	'예
		Form.SetCtlProp("Container.LblQ" & nQNum & "A1", "fontbold", true)
		Form.SetCtlProp("Container.ImgQ" & nQNum & "A2", "imgpath", unPressedImgPath)	'아니오		
		Form.SetCtlProp("Container.LblQ" & nQNum & "A2", "fontbold", false)
		Form.SetCtlProp("Container.LblQ" & nQNum & "Retry", "visible", False)		'아니오 선택시 "다시 한번 확인해주세요." 얼럿
	
	Elseif szAnswerNum == "2" then
		Form.SetCtlProp("Container.ImgQ" & nQNum & "A1", "imgpath", unPressedImgPath)	'예
		Form.SetCtlProp("Container.LblQ" & nQNum & "A1", "fontbold", false)
		Form.SetCtlProp("Container.ImgQ" & nQNum & "A2", "imgpath", PressedImgPath)	'아니오		
		Form.SetCtlProp("Container.LblQ" & nQNum & "A2", "fontbold", true)
		Form.SetCtlProp("Container.LblQ" & nQNum & "Retry", "visible", True)			'아니오 선택시 "다시 한번 확인해주세요." 얼럿
			
	end if
	
    User_Btn_OKStep()
End Function

'============================================================================
Function User_Btn_OKStep()
	strYN = "Y"

	If g_Question_1 ~= "Y"  Then
		strYN = "N"
	End If

	If g_Question_2 ~= "Y"  Then
		strYN = "N"
	End If

	If g_Question_3 ~= "Y"  Then
		strYN = "N"
	End If


	If strYN == "Y" Then
		btnOK.enable = true
		btnOK.btnimage = "btn_20.9"
		btnOK.fgcolor = "273"
	Else
		btnOK.enable = false
	    If g_szTheme = "black" Then
			btnOK.btnimage = "btn_27.9"
	    Else 
			btnOK.btnimage = "btn_21.9"
	    End If
		btnOK.fgcolor = "269"
	End If
End Function

'============================================================================
Sub ImgBackPress_OnClick()
	g_szRet = "cancel"
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnOK_OnClick()
	g_szRet = "ok"
	Form.CloseForm()	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbonl88060_p18" , g_szRet )	
End Sub

	</SCRIPT_INFO>
</ROOT>