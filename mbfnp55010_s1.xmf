--===========================================================================
--===========================================================================

'============================================================================
Dim g_szType '1:원화RP 2:외화RP

'============================================================================

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INIT" then
		if sParam == "1" then '원화
			btn00.caption = "00"
			btnPlus1.caption = "+1만"
			btnPlus5.caption = "+5만"
			btnPlus10.caption = "+10만"
			btnPlus100.caption = "+100만"
			
		else ' 외화RP
			btn00.caption = "."
			btnPlus1.caption = "+10$"
			btnPlus5.caption = "+50$"
			btnPlus10.caption = "+100$"
			btnPlus100.caption = "+1,000$"
			
		end if
		g_szType = sParam
		
	'전액클릭시 매도가능잔고금액
	elseif sEventName == "Able_Amt" then
		edtPrice.caption = sParam
	
	elseif sEventName == "clear" then
		edtPrice.caption = ""
		Form.triggerEvent( "#", "keypad_edit", edtPrice.caption )
		
	end if
End Sub


'키패드 입력처리'
'============================================================================
' 숫자키패드 클릭시
Sub f_numClicked(sData)
'	if Len(edtPrice.caption) >= 15 then
	if Len(edtPrice.caption) == 11 then
		if InStr(edtPrice.caption, ".") == 0 then
			Exit sub
		end if
	end if

	if InStr(edtPrice.caption, ".") > 0 then
		Dim arrData
		arrData = Split(edtPrice.caption,".")
		if Len(arrData(1)) >= 2 then
			Exit sub
		end if
		
		edtPrice.caption = edtPrice.caption & sData
		
	else
		edtPrice.caption = Cdbl(edtPrice.caption & sData)
	end if
	
	
	
	'if Cdbl(edtPrice.caption) < 1 then
	'	edtPrice.caption = ""
	'end if
	
	Form.triggerEvent( "#", "keypad_edit", edtPrice.caption )
End Sub

'============================================================================
' .클릭시
Sub f_dotClicked()
'	if Len(edtPrice.caption) >= 11 then
	if Len(edtPrice.caption) > 11 then
		Exit sub
	end if
	
	if edtPrice.caption <> "" and InStr(edtPrice.caption, ".") = 0 then
		edtPrice.caption = Cdbl(edtPrice.caption) & "."
	end if
	
	Form.triggerEvent( "#", "keypad_edit", edtPrice.caption )
End Sub

'============================================================================
' delete 클릭시
Sub f_delClicked()

	if Len(edtPrice.caption) <> 0 then
		edtPrice.caption = Left(edtPrice.caption, Len(edtPrice.caption)-1)
	end if
	
	if InStr(edtPrice.caption, ".") == Len(edtPrice.caption) then
		edtPrice.caption = Left(edtPrice.caption, Len(edtPrice.caption)-1)
	end if
	
	'if Cdbl(edtPrice.caption) < 1 then
	'	edtPrice.caption = ""
	'end if
	
	Form.triggerEvent( "#", "keypad_edit", edtPrice.caption )
End Sub

'============================================================================
' +n만원 클릭시
Sub f_plusClicked(nData)
	if Len(edtPrice.caption) >= 11 then
		Exit sub
	end if
	
	edtPrice.caption = Cdbl(edtPrice.caption) + nData
	
	Form.triggerEvent( "#", "keypad_edit", edtPrice.caption )
End Sub

'============================================================================
' 전액 클릭시
Sub f_AllClicked()
	edtPrice.caption = ""
	Form.triggerEvent( "#", "keypad_all", "" )
End Sub

'============================================================================
Function f_checkRange(sData)
	Dim szAmt, bFlag
	bFlag = true
	
	'금액 클리어시 체크 안함
	if sData == "" then
		return bFlag
	end if
	
	'소수점 입력시 
	
	szAmt = edtPrice.caption
	if InStr(szAmt, ".") <> 0 then
		if Len(szAmt) >= 14 then
			bFlag = false
		end if
	else
'		if InStr(sData, ".") <> 0 then
			if InStr(sData, ".") == 0 and Len(szAmt) >= 11 then
				bFlag = false
			end if
'		end if
	end if
	
	return bFlag
End Function

--===========================================================================
'키패드 클릭'
--===========================================================================
'============================================================================
Sub btn1_OnClick()
	f_numClicked("1")
End Sub

'============================================================================
Sub btn2_OnClick()
	f_numClicked("2")
End Sub

'============================================================================
Sub btn3_OnClick()
	f_numClicked("3")
End Sub

'============================================================================
Sub btn4_OnClick()
	f_numClicked("4")
End Sub

'============================================================================
Sub btn5_OnClick()
	f_numClicked("5")
End Sub

'============================================================================
Sub btn6_OnClick()
	f_numClicked("6")
End Sub

'============================================================================
Sub btn7_OnClick()
	f_numClicked("7")
End Sub

'============================================================================
Sub btn8_OnClick()
	f_numClicked("8")
End Sub

'============================================================================
Sub btn9_OnClick()
	f_numClicked("9")
End Sub

'============================================================================
Sub btn0_OnClick()
	f_numClicked("0")
End Sub

'============================================================================
Sub btn00_OnClick()
	If g_szType == "1" then
		f_numClicked("00")
	Else
		f_dotClicked()
	End If
End Sub

'============================================================================
Sub btndel_OnClick()
	f_delClicked()
End Sub

'============================================================================
' +1만원 / 10$
Sub btnPlus1_OnClick()
	if g_szType == "1" then
		f_plusClicked(10000)
	else
		f_plusClicked(10)
	end if
End Sub

'============================================================================
' +5만원 / 50$
Sub btnPlus5_OnClick()
	if g_szType == "1" then
		f_plusClicked(50000)
	else
		f_plusClicked(50)
	end if
End Sub

'============================================================================
' +10만원 / 100$
Sub btnPlus10_OnClick()
	if g_szType == "1" then
		f_plusClicked(100000)
	else
		f_plusClicked(100)
	end if
End Sub

'============================================================================
' +100만원 / 1000$
Sub btnPlus100_OnClick()
	if g_szType == "1" then
		f_plusClicked(1000000)
	else
		f_plusClicked(1000)
	end if
End Sub

'============================================================================
' 전액 클릭시
Sub btnPlusAll_OnClick()
	f_AllClicked()
End Sub




