	<SCRIPT_INFO _len="531" _ulen="531" >

'============================================================================
Sub Form_OnFormInit()
	tblCase1.visible = false
	tblCase2.visible = false
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
'	szOpenData = "1"
	If szOpenData <> "" and szOpenData <> null Then
		If szOpenData == "1" Then
			tblCase1.visible = true
		Else
			tblCase2.visible = true
		End If
	End If
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub



