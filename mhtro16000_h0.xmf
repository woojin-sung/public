'----------------------------------------------------------------------------
' 01. 화 면 명 : 해외주식현재가 - 가로
' 02. 화면설명 : 해외주식현재가 가로화면
' 03. 작    성 : 2021.03.15
'----------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket, g_szIndexName
Dim g_szType 									' 13: 시간외, 그외는 현재가
Dim g_nfmTab
	g_nfmTab = 0
	
Dim g_sCode
Dim g_nNat
Dim g_sRealCode
Dim g_sExid
Dim g_szCode '종목코드
Dim g_rtChk

'[Form Init]
'============================================================================
Sub Form_OnFormInit()

	DATAMANAGER.RequestTranData("ohhts_open_001r") '20220523 HSZ : 가로화면 화면집계 서비스호출 추가
	g_szItemCode = Form.GetOpenLinkData()
	'szData = Form.GetSharedData( "&ITEM_OVERSTOCK", false )
	g_sCode = g_szItemCode
	g_nNat = Form.GetItemCodeInfo(g_szItemCode, "ovsnation") '국가구분코드

	Dim sTemp
	'Form.GetItemCodeInfo(sItemCode, "exchid") '0321 거래소 ID 코드
	nExid = Form.GetItemCodeInfo(g_szItemCode, "exchcode3") '거래소 구분코드
			
	sTemp = split(g_szItemCode, "@")
	g_sExid = sTemp[0] '시장구분
	g_szCode = sTemp[1] '종목코드 
	g_rtChk = Form.GetSharedData( "REALTIME_"..g_sExid, false )

	DATAMANAGER.CancelRealData("ohhts_exst_cntg")
	if Len(g_szItemCode) > 0	then
		DATAMANAGER.RequestTranData( "ohhts_6000_001r" )
	end if
	Form.triggerEvent("frmtab.page0", "INIT_CODE", g_szItemCode)
End Sub

'[[ DATAMANAGER 조회 BEFORE ]]
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	

	'Table Clear
	tblHoga.SetCellClear()
	
	if szTranID == "ohhts_6000_001r" then		
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , g_szCode )
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , g_sExid)
		DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk) '실시간구분코드
	'20220523 HSZ START : 가로화면 화면집계 서비스호출 추가
	elseif szTranID = "ohhts_open_001r" then
		szID = Form.GetSharedData("&USER_ID", false )
		szOSType = Form.GetSharedData("&OS_TYPE", false)'1.안드로이드 2.iOS
		if szOSType <> "" then
			szOSType = szOSType + 2
		end if
			
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SORT_CLS" , 0 , szOSType) 'OS_TYPE 3:MTS(안드로이드) 4:MTS(iOS)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NO" , 0 , "16011") '하드코딩(미사용 화면번호)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NAME" , 0 , "해외주식 현재가(가로)") '하드코딩
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "USER_ID" , 0 , szID) '최근 로그인 아이디
	'20220523 HSZ END
	end if
	
End Sub


'[[ DATAMANAGER 조회 Complete ]]
'============================================================================
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "ohhts_6000_001r" Then
		Dim sExid
		sExid = Transform_Exid(nExid)
		tblHoga.SetCellString("0", "0", sExid)
		if g_rtChk == "0" then
			tblHoga.SetCellString("1", "0", "실시간")
		else		
			if g_sExid = "JP" then
				tblHoga.SetCellString("1", "0", "20분지연")
			else
				tblHoga.SetCellString("1", "0", "15분지연")
			end if
		end if 
	End If
	
	DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , g_szItemCode )
	DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )
	
End Sub



'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgClose_OnClick()
	btnClose_OnClick()
End Sub

'============================================================================
Sub frmtab_OnTabChanged(nCurrentTab)
	Form.triggerEvent("frmtab." & frmtab.currenttabpageid, "INIT_CODE", g_szItemCode)
End Sub

'============================================================================
' 거래소 ID 이름으로 변환
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "HKS" then	' 104
		return "홍콩"
	elseif sValue == "HSI" then ' 529
		return "항셍 지수"
'		return "중국"
	elseif sValue == "SHS" then ' 215
		return "상해"
'		return "중국"
	elseif sValue == "SZS" then ' 214
		return "심천"
'		return "중국"
	elseif sValue == "NYS" then ' 321
		return "뉴욕"
'		return "미국"
	elseif sValue == "AMX" then ' 66
		return "아멕스"
'		return "미국"
	elseif sValue == "NAS" then ' 537
		return "나스닥"
'		return "미국"
	elseif sValue == "NAO" then ' 130
		return "미국"
	elseif sValue == "SPI" then ' 625
		return "S&P"
	elseif sValue == "DJI" then ' 310
		return "다우존스"
	elseif sValue == "TSE" then ' 106
		return "도쿄"
	elseif sValue == "OSE" then ' 107
		return "오사카"
	elseif sValue == "JSD" then ' 112
		return "자스닥"
	elseif sValue == "NII" then ' 889
		return "니케이"
	elseif sValue == "NAI" then ' 538
		return "나스닥"
	elseif sValue == "HSX" then ' 770
		return "호치민"
	elseif sValue == "HNX" then ' 771
		return "하노이"
	end if
end Function


