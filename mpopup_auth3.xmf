	<CONTROL_INFO>
		<IMAGE name="imgBack" autosize="1" imgpath="alpha128.png" ly_vert="0,0,375,647,1" />
		<IMAGE name="imgBg" imgpath="popup_bg_common.9" ly_vert="32,207,312,231,1" />
		<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="안내" halign="1" ly_vert="52,231,275,32,1" />
		<TABLE name="tblInfo" insidelinecolor="102:255255255" colcount="1" rowcount="5" outline="0000" designorder="1" ly_vert="33,275,306,110,1" >
			<COL_INFO ly_vert_width="306" />
			<ROW_INFO ly_vert_height="10,10,20,20,50" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,1" line="0,0" impidxs="" />
				<CELL cell_ly="0,2,0,2" line="0,0" caption="유효하지 않은 비밀번호입니다." impidxs="" />
				<CELL cell_ly="0,3,0,3" line="0,0" impidxs="" />
				<CELL cell_ly="0,4,0,4" line="0,0" impidxs="" />
			</CELL_INFO>
		</TABLE>
		<BUTTON name="btnQuit" caption="취소" fgcolor="004:000000000" fontsize="2" btnimage="btn_25.9" ly_vert="32,360,157,60,1" />
		<BUTTON name="btnOk" caption="확인" fontsize="2" btnimage="btn_01.9" ly_vert="32,360,312,60,1" />
		<BUTTON name="btnOk1" visible="0" fontsize="2" btnimage="btn_26.9" ly_vert="31,360,313,60,0" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1548" _ulen="1232" >
Dim g_szOpenData

'============================================================================
Sub btnOk_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
Sub Form_OnFormInit()
	btnOk.visible = true
	imgBg.height = 190
		
	g_szOpenData = Form.GetOpenLinkData()
	
	If g_szOpenData = "06" Then '4-8 자리체크
		tblInfo.SetCellString( 2, 0,"( 4 ~ 8자리 가능 )")
	ElseIf g_szOpenData = "01" Then     '연속된 4자리 숫자
		tblInfo.SetCellString( 2, 0,"(연속된 4자리 숫자)")
	ElseIf g_szOpenData = "02" Then '동일한 숫자 입력 시
		tblInfo.SetCellString( 2, 0,"(동일한 숫자)")
	ElseIf g_szOpenData = "03" Then '휴대폰번호와 4자리 이상 일치 시
		tblInfo.SetCellString( 2, 0,"(휴대폰번호와 4자리 이상 일치)")
	ElseIf g_szOpenData = "04" Then '자택번호와 4자리 이상 일치 시
		tblInfo.SetCellString( 2, 0,"(자택번호와 4자리 이상 일치)")
	ElseIf g_szOpenData = "05" Then '직장번호와 4자리 이상 일치 시
		tblInfo.SetCellString( 2, 0,"(직장번호와 4자리 이상 일치)")
	ElseIf g_szOpenData = "07" Then '실명확인번호와 4자리 이상 일치 시
		tblInfo.SetCellString( 2, 0,"(실명확인번호와 4자리 이상 일치)")
	ElseIf g_szOpenData = "08" Then '실명확인번호와 4자리 이상 일치 시
		tblInfo.SetCellString( 2, 0,"(계좌번호와 4자리 이상 일치)")
	End If
	
End Sub

'============================================================================


	</SCRIPT_INFO>
</ROOT>