'============================================================================
Sub grdList_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "obfnd_oder_004r" ) = true then
		DATAMANAGER.RequestNextData( "obfnd_oder_004r" )
	end if
End Sub

'============================================================================
Sub cldFrom_OnEditComplete()
	DATAMANAGER.RequestTranData( "obfnp_fnmt_011r" )
End Sub

'============================================================================
Sub cldTo_OnEditComplete()
	DATAMANAGER.RequestTranData( "obfnp_fnmt_011r" )
End Sub

'============================================================================
Sub cmbCurrency_OnEditComplete(iIndex)
	DATAMANAGER.RequestTranData( "obfnp_fnmt_011r" )
End Sub

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sReturn1 <> "" then
		g_szItemCode = sReturn1
		DATAMANAGER.RequestTranData( "obfnp_fnmt_011r" )
	end if
End Sub

'============================================================================
