' 2020.04.07 : 이현우 - 고유 MTS 
'===========================================================================
Dim g_szFncd
Dim g_szACNO
Dim g_szASNO
Dim g_szItemCode

g_szItemCode = ""

'============================================================================
Sub Form_OnFormInit()
	ItemCode0.code = "empty"
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "REQUEST" THEN
		if sParam <> null then
			g_szFncd = sParam
			'펀드코드 계좌조회
			DATAMANAGER.RequestTranData("obfnp_fnmt_011r")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obfnp_fnmt_011r" then		
		if Trim(g_szFncd) = "" or Len(g_szFncd) < 4 Then
			Form.ShowAlert("알림", "펀드코드를 입력하십시요.")
			Exit Sub
		end if
		DATAMANAGER.SetDataValue( false, "obfnp_fnmt_011r", "InBlock1", "FNCD"	, 0, g_szFncd )
	end if
	
	if szTranID = "obfnd_oder_004r" then		
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r", "InBlock1", "FNCD"	, 0, g_szFncd )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r", "InBlock1", "ACNO"	, 0, g_szACNO )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r", "InBlock1", "ASNO"	, 0, g_szASNO )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r", "InBlock1", "PWD"	, 0, "" )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r", "InBlock1", "MTIT_CODE", 0, "")
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r", "InBlock1", "STA_DATE" , 0, cldFrom.caption )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r", "InBlock1", "FIN_DATE" , 0, cldTo.caption )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r", "InBlock1", "CRCD"	, 0, cmbCurrency.cbkeydata )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r", "InBlock1", "FISCD"	, 0, g_szItemCode )
		
	elseif szTranID = "obfnd_oder_004r_1" then
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r_1", "InBlock1", "FNCD"	, 0, g_szFncd )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r_1", "InBlock1", "ACNO"	, 0, g_szACNO )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r_1", "InBlock1", "ASNO"	, 0, g_szASNO )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r_1", "InBlock1", "PWD"	, 0, "" )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r_1", "InBlock1", "MTIT_CODE", 0, "")
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r_1", "InBlock1", "STA_DATE" , 0, cldFrom.caption )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r_1", "InBlock1", "FIN_DATE" , 0, cldTo.caption )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r_1", "InBlock1", "CRCD"	, 0, cmbCurrency.cbkeydata )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_004r_1", "InBlock1", "FISCD"	, 0, g_szItemCode )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID = "obfnp_fnmt_011r" then	
		g_szACNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ACNO" , i) '계좌번호
		g_szASNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ASNO" , i) '계좌일련번호
		'해외파생 고유 해외손익현황4 호출
		DATAMANAGER.RequestTranData("obfnd_oder_004r")
		DATAMANAGER.RequestTranData("obfnd_oder_004r_1")
	end if
	
	if szTranID = "obfnd_oder_004r" then
		Dim nCnt, nIndex
		Dim szCLRN_PRLS_FAMT, szEXCL_VPAL_FAMT, szENTM_FFEE, szNTPL_FAMT, szCRCD
		
		nCnt = DATAMANAGER.GetDataCount( false, "obfnd_oder_004r", "OutBlock1")
		nIndex = Cint(grdList.rowcount) - nCnt
		
		' 하단 목록
		for i = 0 to nCnt - 1
			szCLRN_PRLS_FAMT 	= DATAMANAGER.GetDataValue( false, "obfnd_oder_004r", "OutBlock1", "CLRN_PRLS_FAMT" , i) '청산손익
			szEXCL_VPAL_FAMT 	= DATAMANAGER.GetDataValue( false, "obfnd_oder_004r", "OutBlock1", "EXCL_VPAL_FAMT" , i) '평가증감
			szFCM_FEE   		= DATAMANAGER.GetDataValue( false, "obfnd_oder_004r", "OutBlock1", "FCM_FEE" 		  , i) 'FCM수수료
			szNTPL_FAMT 		= DATAMANAGER.GetDataValue( false, "obfnd_oder_004r", "OutBlock1", "UI_NTPL_FAMT"   , i) '순손익
			
			if szCRCD = "KRW" or szCRCD = "JPY" then
				grdList.SetCellData("bd_cell2", nIndex+i, FormatNumber(szCLRN_PRLS_FAMT, 0))	'청산손익
				grdList.SetCellData("bd_cell3", nIndex+i, FormatNumber(szFCM_FEE, 0))		'FCM수수료
				grdList.SetCellData("bd_cell7", nIndex+i, FormatNumber(szEXCL_VPAL_FAMT, 0))	'평가증감
				grdList.SetCellData("bd_cell8", nIndex+i, FormatNumber(szNTPL_FAMT, 0))		'순손익
			else
				grdList.SetCellData("bd_cell2", nIndex+i, FormatNumber(szCLRN_PRLS_FAMT, 2))
				grdList.SetCellData("bd_cell3", nIndex+i, FormatNumber(szFCM_FEE, 2))
				grdList.SetCellData("bd_cell7", nIndex+i, FormatNumber(szEXCL_VPAL_FAMT, 2))
				grdList.SetCellData("bd_cell8", nIndex+i, FormatNumber(szNTPL_FAMT, 2))
			end if
		next
	
	' 상단 테이블
	elseif szTranID = "obfnd_oder_004r_1" then
		Dim szCLRN_PRLS_FAMT, szEXCL_VPAL_FAMT, szENTM_FFEE, szNTPL_FAMT, szCRCD
		
		szCLRN_PRLS_FAMT 	= DATAMANAGER.GetDataValue( false, "obfnd_oder_004r_1", "OutBlock2", "CLRN_PRLS_FAMT"  , 0) '청산손익
		szEXCL_VPAL_FAMT 	= DATAMANAGER.GetDataValue( false, "obfnd_oder_004r_1", "OutBlock2", "EXCL_VPAL_FAMT" 	, 0) '평가증감
		szFCM_FEE 		= DATAMANAGER.GetDataValue( false, "obfnd_oder_004r_1", "OutBlock2", "FCM_FEE" 		, 0) '수수료
		szNTPL_FAMT 		= DATAMANAGER.GetDataValue( false, "obfnd_oder_004r_1", "OutBlock2", "UI_NTPL_FAMT" 	, 0) '순손익
		
		if cmbCurrency.cbkeydata = "KRW" or cmbCurrency.cbkeydata = "JPY" then
			tblData.SetCellString(0, 1, FormatNumber(szCLRN_PRLS_FAMT, 0))
			tblData.SetCellString(0, 3, FormatNumber(szFCM_FEE, 0))
			tblData.SetCellString(1, 1, FormatNumber(szEXCL_VPAL_FAMT, 0))
			tblData.SetCellString(1, 3, FormatNumber(szNTPL_FAMT, 0))
		else
			tblData.SetCellString(0, 1, FormatNumber(szCLRN_PRLS_FAMT, 2))
			tblData.SetCellString(0, 3, FormatNumber(szFCM_FEE, 2))
			tblData.SetCellString(1, 1, FormatNumber(szEXCL_VPAL_FAMT, 2))
			tblData.SetCellString(1, 3, FormatNumber(szNTPL_FAMT, 2))
		end if
	end if
	
End Sub

