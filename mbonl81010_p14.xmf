'============================================================================
' 01.화면명 	: 투자성향진단 안내
' 02.화면설명	: 투자성향진단 안내
' 03.작성	: 2016.04.15 
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' getListItem(szInput, nIdx) : 해당하는 인덱스의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return ""
	else
		szList = split(szInput, "★")
		if szList <> "" then
			if Ubound(szList) >= nIdx then
				if szList(nIdx) <> NULL then
					return szList(nIdx)
				else
					return ""
				end if
				
			else
				return ""
			end if
		else
			return ""
		end if 
	end if 
end function


''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	Dim szData
	szData = Form.GetOpenLinkData()
	
	tblGrade.SetCellString(1, 1, getListItem(szData, 0))
	tblGrade.SetCellString(2, 1, getListItem(szData, 1))
	tblGrade.SetCellString(3, 1, getListItem(szData, 2))
End Sub

'============================================================================
' imgClose_OnClick() : 화면 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.SendReturnToParent("close_mbonl81010_p14" , "")
	Form.CloseForm()
End Sub


'============================================================================
' btnOk_OnClick() : 화면 닫기
'============================================================================
Sub btnOk_OnClick()
	Form.SendReturnToParent("close_mbonl81010_p14" , "")
	Form.CloseForm()
End Sub

