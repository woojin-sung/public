			Container0.Table4.SetCellString(0, 2, "N")
			Container0.Table6.SetCellString(0, 2, "N")
			Container0.Table10.SetCellString(0, 2, "N")
			Container0.Table12.SetCellString(0, 2, "N")
			Container0.Table14.SetCellString(0, 2, "N")
			If Container0.Table8.GetCellString(0, 2) == "N" Then
				Container0.Table8.SetCellString(0, 2, "Y")
			Else 
				Container0.Table8.SetCellString(0, 2, "N")
			End If
		Case 10

			Container0.Table0.SetCellString(0, 2, "N")
			Container0.Table2.SetCellString(0, 2, "N")
			Container0.Table4.SetCellString(0, 2, "N")
			Container0.Table6.SetCellString(0, 2, "N")
			Container0.Table8.SetCellString(0, 2, "N")
			Container0.Table12.SetCellString(0, 2, "N")
			Container0.Table14.SetCellString(0, 2, "N")
			If Container0.Table10.GetCellString(0, 2) == "N" Then
