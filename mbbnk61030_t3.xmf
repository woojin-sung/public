'============================================================================
Sub cldFromDate01_OnEditComplete()
	RequestData()
End Sub

'============================================================================
Sub cldToDate01_OnEditComplete()
	RequestData()
End Sub

'============================================================================
Sub cmbDate_OnEditComplete(iIndex)
	
	Select Case iIndex
		Case 0
			cldFromDate01.caption = cldToday.caption
			cldToDate01.caption = cldToday.caption
			
			RequestData()	
		Case 1
			cldFromDate01.caption = cldToday.caption
			cldToDate01.caption = cldToday.caption
			cldToDate01.addday = 7
			
			RequestData()
		Case 2
			cldFromDate01.caption = cldToday.caption
			cldToDate01.caption = cldToday.caption
			cldToDate01.addday = 30
		
			RequestData()
		Case 3
			cldFromDate01.caption = cldToday.caption
			cldToDate01.caption = cldToday.caption
			cldToDate01.addday = 60
		
			RequestData()
		Case 4
			cldFromDate01.caption = cldToday.caption
			cldToDate01.caption = cldToday.caption
			cldToDate01.addday = 90
		
			RequestData()
	End Select
	
End Sub
