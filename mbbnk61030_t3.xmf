'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szAccountNumber	'계좌번호
Dim g_szAccountSerialNumber	'계좌일련번호
Dim g_szAccountPassword	'계좌비밀번호
Dim g_szAccountName	'계좌명
Dim g_nGridCnt
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************



'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "AllAccount" then		'계좌전체
		Dim szList
		szList = Split(sParam, "★")
		
		
		if UBOUND(szList) < 1 then
			exit sub
		end if

		g_szAccountNumber = szList(0)
		g_szAccountSerialNumber = szList(1)
		if szList(2) <> "" then
			g_szAccountPassword = szList(2)
		else
			g_szAccountPassword = ""
		end if
		
		if szList(3) <> "" then
			g_szAccountName = szList(3)
		else
			g_szAccountName = ""
		end if
		RequestData()
	end if
	
	if sEventName == "Password"	then		'계좌비밀번호
		g_szAccountPassword = sParam
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	RequestData()
End Sub

Sub RequestData()

	g_nGridCnt = 0
	grdT201.rowcount = 0
	
	DATAMANAGER.SetDataValue(0, "obrtd_drng_014r", "InBlock1", "UI_CLS" , 0 , "%")	
			
	DATAMANAGER.SetDataValue(0, "obrtd_drng_014r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)	'계좌번호
	DATAMANAGER.SetDataValue(0, "obrtd_drng_014r", "InBlock1", "ASNO", 0 ,  g_szAccountSerialNumber)	'계좌일련번호
	DATAMANAGER.SetDataValue(0, "obrtd_drng_014r", "InBlock1", "REG_BRCD" , 0 , "%")	
	DATAMANAGER.SetDataValue(0, "obrtd_drng_014r", "InBlock1", "TACT_PROS_CLS_CODE", 0 ,  "4")	'
	DATAMANAGER.SetDataValue(0, "obrtd_drng_014r", "InBlock1", "ACNT_PWD", 0 ,  g_szAccountPassword)
	DATAMANAGER.RequestTranData("obrtd_drng_014r")
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrtd_drng_014r" then
		nCnt = DATAMANAGER.GetDataCount( 0, "obrtd_drng_014r", "OutBlock1")
		
		for i = 0 to nCnt-1
			
			sAmPm = DATAMANAGER.GetDataValue(0, "obrtd_drng_014r", "OutBlock1", "MRNN_AFTN_CLS_CODE", i )	'
			if sAmPm == "A" then
				grdT201.SetCellData( "bd_cell1", i + g_nGridCnt, "오전 10:30~11:30" )
			else
				grdT201.SetCellData( "bd_cell1", i + g_nGridCnt, "오후 04:30~05:30" )
			end if
			
			sBankCode = DATAMANAGER.GetDataValue(0, "obrtd_drng_014r", "OutBlock1", "BANK_CODE", i )	
			sBankName = Form.GetMetaData("은행코드", sBankCode )

			
			if sBankCode == "287" then
				sAcc = DATAMANAGER.GetDataValue(0, "obrtd_drng_014r", "OutBlock1", "CNFT_ACNO", i )	
				sAccNo = DATAMANAGER.GetDataValue(0, "obrtd_drng_014r", "OutBlock1", "CNFT_ASNO", i )	
				grdT201.SetCellData( "bd_cell2", i + g_nGridCnt, sBankName & "/" & sAcc &  sAccNo)
			else
				sBankAcc = DATAMANAGER.GetDataValue(0, "obrtd_drng_014r", "OutBlock1", "BANK_ACNO", i )	
				grdT201.SetCellData( "bd_cell2", i + g_nGridCnt, sBankName & "/" & sBankAcc )
			end if
			
			'sCnclYN = DATAMANAGER.GetDataValue(0, "obrtd_drng_014r", "OutBlock1", "CNCL_YN", i )	'취소여부
			sClsCode = DATAMANAGER.GetDataValue(0, "obrtd_drng_014r", "OutBlock1", "TACT_PROS_CLS_CODE", i )	'이체처리구분코드
			
			if sClsCode == "0" then
				grdT201.SetCellData( "bd_cell5", i + g_nGridCnt, "미처리" )
			elseif	sClsCode == "1" then
				grdT201.SetCellData( "bd_cell5", i + g_nGridCnt, "완료" )
			elseif	sClsCode == "2" then
				grdT201.SetCellData( "bd_cell5", i + g_nGridCnt, "처리지연" )
			elseif	sClsCode == "9" then
				grdT201.SetCellData( "bd_cell5", i + g_nGridCnt, "불능" )
			end if
		next	
		
		g_nGridCnt = g_nGridCnt + nCnt
	end if	
End Sub

'============================================================================
Sub grdT201_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obrtd_drng_014r" )	
End Sub

