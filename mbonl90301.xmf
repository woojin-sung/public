'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 채권 보유/주문 현황
' 02. 화면설명 : 채권 보유/주문 현황
'      - 보유현황 : mbonl90301_t1
'      - 주문현황 : mbonl90301_t2
' 03. 작    성 : 
'  2023.11.06  신규 작성
'     채권보유/주문 현황  	mbonl90301

'  2024.08.07 : v002 : 박윤경 : 서비스(ooopc_cuma_093r) IO 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************

Dim g_szCmbIndex
Dim g_plain_rm
Dim g_bIsFormInit
Dim g_szUSERID, g_szCsno

Dim g_szLinkData, g_szOpenData


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
sub f_FormInit()
	'	g_szOpenData = "1"
	if g_szOpenData <> "54120" then
		if (g_szOpenData <> "") and (g_szOpenData <> null) then
			tData = Split(g_szOpenData, "★")
			
			FormTab0.currenttab = CInt(tData(0))
		end if	
	end if
	
	'고객ID
	g_szUSERID = Form.GetSharedData("&USER_ID", false )
	
	'고객번호
	g_szCsno = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
'	Form.ShowAlert("", g_szCsno)
	
'	szScreenNo = Form.GetSharedData("&SCREEN_NO", True)
'	
'	select case szScreenNo
'		case "54120"		
'		case "54140"		
'	end select
	
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	
	DATAMANAGER.RequestTranData("ooopc_cuma_093r")
	
'	FormTab0.currenttab = CInt(tData(0))
end sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub ImgBackPress_OnClick()
'	Form.CloseForm("")
	Form.OpenPrevScreen()
End Sub

'============================================================================
Sub imgNotice_OnClick()
	Form.OpenPopup("mbonl90201_p4", "", "")
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgNotice.SetMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_bIsFormInit = False
	
	g_szOpenData = Form.GetOpenLinkData()	'전체, 채권, 단기사채
	
'	szScreenNo = Form.GetSharedData("&SCREEN_NO", False)
'	if szScreenNo == "54120" or szScreenNo == "54140" then
	if g_szOpenData == "54120" then
		'카카오톡 알림톡으로 진입시 iOS 에서 화면이동시 딜레이 발생이슈로 타이머로 처리함.
		Form.SetTimerEvent2(1, 1, 1)
		
	else
		f_FormInit()
		
	end if
	

End Sub

'============================================================================
Sub cmb0_OnEditComplete(iIndex)
	Dim szAccString, szIdx, szData, szPwd
	
	g_szCmbIndex = iIndex	
	
	szData = ""	
	'화면 연동시, 선택한 계좌로 세팅
	if Cint(iIndex) == 0 then
		szData = "전체"		& "|" &	'선택한 계좌번호				
				""			& "|" &	'선택한 계좌seq
				""					'비밀번호
			
	else
		szAccString = cmb0.cbkeydata
		szIdx = cmbAccount.GetIndexByAccountinfo(szAccString)
		cmbAccount.currentindex = szIdx
		
		if plain_rm == "1" then
			'MTS메모리평문 미적용상태일때
			szPwd = edtPassword.caption		
		else
			szPwd = Form.GetEncData(edtPassword.caption)	
		end if
'		Form.showalert("EditComplete1", iIndex & " : " & szAccString & " : " & szIdx)
										
		szData = cmbAccount.total		& "|" &  '선택한 계좌번호			
				cmbAccount.sequence	& "|" &  '선택한 계좌seq
				szPwd                           '비밀번호
				
	end if                                       
	
	if g_bIsFormInit then
'		Form.showalert("EditComplete2", iIndex & " : " & szData)		
		Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "AccountChange", szData)
	end if
	
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
'	Form.ShowAlert("OnTabChanged", cmb0.currentindex & " : " & g_szCmbIndex)
	if CInt(cmb0.currentindex) == 0 then
		szData = g_szLinkData & 
				"전체||"
				
	else
		szData = g_szLinkData & 
				Left(cmb0.cbkeydata, 8)		& "|" &	'6 선택한 계좌번호			
				Right(cmb0.cbkeydata, 2)		& "|" &	'7 선택한 계좌seq
				""									'8 비밀번호
	end if
	
	Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "Init", szData)
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림_" & szTranID , "90301\n" & szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림_" & szTranID , "90301\n" & szErrCode .. " : ".. szErrMsg)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCsno
	szCsno = Form.GetSharedData("&CUST_NUM", false)
	
'	Form.ShowAlert("", szCsno)
	if szTranID == "ooopc_cuma_093r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO" , 0 , szCsno)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "USE_YN" , 0 , "N")	'v002
	
	elseif szTranID == "obacb_balc_153r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO" , 0 , szCsno)
	
	'단기사채 고객별 최근거래계좌 조회
	elseif szTranID == "obsac_deal_216r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total )
		
		
	elseif szTranID == "obacb_balc_158r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE",	0, "1")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID",		0, g_szUSERID)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO",			0, g_szCsno)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",			0, cmbAccount.total)
		
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	Dim szAsnoList, szAcctotal
	Dim szAccCmb, szAccCmbTxt, szFullacc
	Dim szAccName
	Dim szData
	Dim nCnt, nGrdCnt
	Dim szAsnoList, szAcctotal
'	Dim szAccCmb, szAccCmbTxt

	if szTranID == "ooopc_cuma_093r" then
		
	
		if  DATAMANAGER.IsMoreNextData(szTranID) == True then 
			DATAMANAGER.RequestNextData(szTranID)
		else
			'단기사채 고객별 최근거래계좌 조회
'			DATAMANAGER.RequestTranData("obsac_deal_216r")
			
			'고객 계좌별 조회
			DATAMANAGER.RequestTranData("obacb_balc_158r")
			
		end if
	
	elseif szTranID == "obsac_deal_216r" then
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
'		Form.ShowAlert("nCnt", nCnt)
		
		if DATAMANAGER.IsMoreNextData(szTranID) then
			DATAMANAGER.RequestNextData(szTranID)
			
		else
			'종합계좌 데이터
			szAsnoList = ""
			for i=0 to CInt(grd1.rowcount) - 1
				szAcctotal = grd1.GetCellData("bd_cell0", i)
				szAsnoList = szAsnoList & szAcctotal	& "○" '종합계좌 리스트
			next
			
			nGrdCnt = CInt(grdAcnt.rowcount)
'			Form.ShowAlert("TranComplte6", nGrdCnt)
			
			if nGrdCnt > 0 then
				cmb0.cbadddatatext = "00".."`".."전체보유계좌"
				
				'개별계좌 데이터
				szAccCmb = ""
				szAccCmbTxt = ""
				szGrpIdx = nGrdCnt
				for i = 0 to nGrdCnt - 1
					Dim szAcno, szAsno, szPrnm, szName
					
					szAcno = grdAcnt.GetCellData("bd_acno", i)
					szAsno = grdAcnt.GetCellData("bd_asno", i)
					szPrnm = grdAcnt.GetCellData("bd_prnm", i)
					szName = grdAcnt.GetCellData("bd_name", i)
					szFullacc = szAcno..szAsno
					
					if szPrnm <> "" then
						szAccname = "["..szPrnm.."] "..left(szAcno, 4).."-"..right(szAcno, 4).."-"..szAsno.."  "..szName
					else
						szAccname = left(szAcno, 4).."-"..right(szAcno, 4).."-"..szAsno.."  "..szName
					end if
					
					cmb0.cbadddatatext = szAcno & szAsno & "`" & szAccname
					
					szAccCmb = szAccCmb & szFullacc & "○"				'개별계좌 리스트(ACNo + ASNo)
					szAccCmbTxt = szAccCmbTxt & szAccname & "○"			'개별계좌명 리스트 [상품명]계좌번호
					
					szGrpIdx = szGrpIdx & "☆" & grdAcnt.GetCellData("bd_grpno", i)
				next
				
				cmb0.currentindex = 0
			end if			
			g_bIsFormInit = True
			
			
			
			g_szLinkData = CInt(grd1.rowcount)	& "|" &	'0 종합계좌 개수
					szAsnoList				& "|" &	'1 종합계좌 리스트
					CInt(grdAcnt.rowcount)		& "|" &	'2 개별계좌개수
					szAccCmb					& "|" &  '3 개별계좌 리스트(ACNo + ASNo)
					szAccCmbTxt 				& "|" &  '4 개별계좌명 리스트([상품명]계좌번호)
					szGrpIdx					& "|"	'5 계좌개수☆개별계좌의 그룹인덱스
					
			if CInt(cmb0.currentindex) == 0 then
				szData = g_szLinkData	& 
						"전체||"		 		'6,7,8  전체계좌
						
			else
				szData = g_szLinkData & 
						Left(cmb0.cbkeydata, 8)		& "|" &	'6 선택한 계좌번호			
						Right(cmb0.cbkeydata, 2)		& "|" &	'7 선택한 계좌seq
						""									'8 비밀번호
			end if
					
			Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "Init", szData)
		end if
	'end of if szTranID == "obsac_deal_216r"
	
	elseif szTranID == "obacb_balc_158r" then
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
'		Form.ShowAlert("nCnt", nCnt)
		
		if DATAMANAGER.IsMoreNextData(szTranID) then
			DATAMANAGER.RequestNextData(szTranID)
			
		else
			'종합계좌 데이터
			szAsnoList = ""
			for i=0 to CInt(grd1.rowcount) - 1
				szAcctotal = grd1.GetCellData("bd_cell0", i)
				szAsnoList = szAsnoList & szAcctotal	& "○" '종합계좌 리스트
			next
			
			nGrdCnt = CInt(grdAcnt1.rowcount)
'			Form.ShowAlert("TranComplte6", nGrdCnt)
			
			if nGrdCnt > 0 then
				cmb0.cbadddatatext = "00".."`".."전체보유계좌"
				
				'개별계좌 데이터
				szAccCmb = ""
				szAccCmbTxt = ""
				szGrpIdx = nGrdCnt
				for i = 0 to nGrdCnt - 1
					Dim szAcno, szAsno, szPrnm, szName
					
					szAcno = grdAcnt1.GetCellData("bd_acno", i)
					szAsno = grdAcnt1.GetCellData("bd_asno", i)
					szPrnm = grdAcnt1.GetCellData("bd_prnm", i)
					szName = grdAcnt1.GetCellData("bd_name", i)
					szFullacc = szAcno..szAsno
					
					if szPrnm <> "" then
						szAccname = "["..szPrnm.."] "..left(szAcno, 4).."-"..right(szAcno, 4).."-"..szAsno.."  "..szName
					else
						szAccname = left(szAcno, 4).."-"..right(szAcno, 4).."-"..szAsno.."  "..szName
					end if
					
					cmb0.cbadddatatext = szAcno & szAsno & "`" & szAccname
					
					szAccCmb = szAccCmb & szFullacc & "○"				'개별계좌 리스트(ACNo + ASNo)
					szAccCmbTxt = szAccCmbTxt & szAccname & "○"			'개별계좌명 리스트 [상품명]계좌번호
					
					szGrpIdx = szGrpIdx & "☆" & grdAcnt1.GetCellData("bd_grpno", i)
				next
				
				cmb0.currentindex = 0
			end if			
			g_bIsFormInit = True
			
			
			
			g_szLinkData = CInt(grd1.rowcount)	& "|" &	'0 종합계좌 개수
					szAsnoList				& "|" &	'1 종합계좌 리스트
					CInt(grdAcnt1.rowcount)	& "|" &	'2 개별계좌개수
					szAccCmb					& "|" &  '3 개별계좌 리스트(ACNo + ASNo)
					szAccCmbTxt 				& "|" &  '4 개별계좌명 리스트([상품명]계좌번호)
					szGrpIdx					& "|"	'5 계좌개수☆개별계좌의 그룹인덱스
					
			if CInt(cmb0.currentindex) == 0 then
				szData = g_szLinkData	& 
						"전체||"		 		'6,7,8  전체계좌
						
			else
				szData = g_szLinkData & 
						Left(cmb0.cbkeydata, 8)		& "|" &	'6 선택한 계좌번호			
						Right(cmb0.cbkeydata, 2)		& "|" &	'7 선택한 계좌seq
						""									'8 비밀번호
			end if

'			Form.ShowAlert("", szData)
			Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "Init", szData)
		end if
	'end of if szTranID == "obacb_balc_158r"
	
	end if
End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
'	Form.ShowAlert(sEventName, sParam)
	if sEventName == "mbonl90301_t1_close" then
		Form.CloseForm()
	end if
End Sub


'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if Cint(sTimerID) == 1 then
		Form.SetTimerEvent2(1, 0, 1)
		
		f_FormInit()
	end if	
End Sub
