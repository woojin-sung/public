'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)

	g_num = lRow
	
	if g_flag = 1 then
		DATAMANAGER.RequestTranData( "ohhts_1001_016r" )		
    else
		DATAMANAGER.RequestTranData( "ohhts_1001_019r" )
	end if	
	
End Sub

'============================================================================
Sub grd0_OnScrollEnd()

	if g_NextFlagGrid1 = True then
	    if g_flag = 1 then
		    DATAMANAGER.RequestNextData( "ohhts_1001_015r" )

	    elseif g_flag = 2 then
		    DATAMANAGER.RequestNextData( "ohhts_1001_018r" )

	    end if
	end if
	
End Sub

'============================================================================
Sub grd1_OnScrollEnd()
	if g_NextFlag = True then
		if g_flag = 1 then
		    DATAMANAGER.RequestNextData( "ohhts_1001_016r" )	    

	    elseif g_flag = 2 then
		    DATAMANAGER.RequestNextData( "ohhts_1001_019r" )

	    end if
	end if
	
End Sub

'============================================================================
Sub grd0_OnHeaderClickUp(lRow, szCellID)

	If szCellID = "th_cell0" Then
		Change_Grid( 0 )
	ElseIf szCellID = "th_cell7" Then
		Change_Grid( 1 )
	End If
		
End Sub


