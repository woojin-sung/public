'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주식현재가
' 02. 화면설명 : 주식현재가 섹터탭
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket
Dim g_num, g_flag, g_NextFlagGrid1, g_NextFlag

	g_flag = 1
	g_num = 0
	g_NextFlagGrid1 =  False
	g_NextFlag = False


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
Function Change_Grid( iIndex )

	 if iIndex = 0 then
	    
		    g_flag = 1
		    g_num = 0		    
		    
		    DATAMANAGER.RequestTranData( "ohhts_1001_015r" )		    
		    
		    grd0.SetVisibleCol(  2, 0 )
		    grd0.SetVisibleCol(  3, 0 )
		    grd0.SetVisibleCol(  4, 0 )
		    grd0.SetVisibleCol(  5, 0 )
		    grd0.SetVisibleCol(  6, 1 )
		    grd0.SetVisibleCol(  7, 1 )
		    grd0.SetVisibleCol(  8, 1 )
		    grd0.SetVisibleCol(  9, 1 )
	 else
		    g_flag = 2
		    g_num = 0
		    
		    DATAMANAGER.RequestTranData( "ohhts_1001_018r" )
		    
		    grd0.SetVisibleCol(  2, 1 )
		    grd0.SetVisibleCol(  3, 1 )
		    grd0.SetVisibleCol(  4, 1 )
		    grd0.SetVisibleCol(  5, 1 )
		    grd0.SetVisibleCol(  6, 0 )
		    grd0.SetVisibleCol(  7, 0 )
		    grd0.SetVisibleCol(  8, 0 )
		    grd0.SetVisibleCol(  9, 0 )
	end if

End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************



'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	If sKey = "ITEMCODE" Then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
'			Form.triggerEvent( "#", "REQUEST_ITEMCODE", "")
			Exit Sub
		End If
	
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		If g_flag = 1 Then
		    DATAMANAGER.RequestTranData( "ohhts_1001_015r" )

		ElseIf g_flag = 2 Then
			g_flag = 2
		    DATAMANAGER.RequestTranData( "ohhts_1001_018r" )	    

		End If
	End If
	
End Sub

'============================================================================
Sub Form_OnFormInit()
'	If grd0.GetVisibleCol(6) <> "1" Then
'		g_flag = 1
'		DATAMANAGER.RequestTranData("ohhts_1001_015r")
'	Else
'		DATAMANAGER.RequestTranData("ohhts_1001_018r")
'	End If
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
'			Form.triggerEvent( "#", "REQUEST_ITEMCODE", "")
			Exit Sub
		End If
	
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

'		If grd0.GetVisibleCol(6) <> "1" Then
'			g_flag = 1
'		    DATAMANAGER.RequestTranData( "ohhts_1001_015r" )
'		Else
'		    DATAMANAGER.RequestTranData( "ohhts_1001_018r" )	    
'		End If
		
		If g_flag = 1 Then
		    DATAMANAGER.RequestTranData( "ohhts_1001_015r" )
		ElseIf g_flag = 2 Then
		    DATAMANAGER.RequestTranData( "ohhts_1001_018r" )	    
		End If
		
	 end if
	 
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "ohhts_1001_019r" then
'		20220207 HSZ START : 시세속도개선
'		DATAMANAGER.CancelRealData( "ohhts_stck_cntg" 	)
'		DATAMANAGER.CancelRealData( "ohhts_stck_cntg_1" 	)
		DATAMANAGER.CancelRealData( "ohhts_stck_incg" 	)
		DATAMANAGER.CancelRealData( "ohhts_stck_incg_1" 	)
'		20220207 HSZ END
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_019r", "InBlock1", "FID_INPUT_ISCD"				, 0, grd0.GetCellData( "bd_cell5", g_num ) )
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_019r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szItemMarket)
		
    elseif szTranID = "ohhts_1001_016r" then
'		20220207 HSZ START : 시세속도개선
'		DATAMANAGER.CancelRealData( "ohhts_stck_cntg" 	)
'		DATAMANAGER.CancelRealData( "ohhts_stck_cntg_1" 	)
		DATAMANAGER.CancelRealData( "ohhts_stck_incg" 	)
		DATAMANAGER.CancelRealData( "ohhts_stck_incg_1" 	)
'		20220207 HSZ END
		
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_016r", "InBlock1", "FID_INPUT_ISCD"				, 0, grd0.GetCellData( "bd_cell5", g_num ) )
    
	 elseif szTranID = "ohhts_1001_018r" then
		grd0.rowcount = 0
		grd1.rowcount = 0
		
		DATAMANAGER.CancelRealData( "ohhts_nmix_cntg" 	)
		DATAMANAGER.CancelRealData( "ohhts_tmst_rsfl" 	)
		
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_018r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_018r", "InBlock1", "FID_INPUT_ISCD"				, 0, g_szItemCode )

	elseif szTranID = "ohhts_1001_015r" then
		grd0.rowcount = 0
		grd1.rowcount = 0
		
		DATAMANAGER.CancelRealData( "ohhts_nmix_cntg" 	)
		DATAMANAGER.CancelRealData( "ohhts_tmst_rsfl" 	)		
		
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_015r", "InBlock1", "FID_INPUT_ISCD"				, 0, g_szItemCode )
	end if

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nCnt

	if szTranID = "ohhts_1001_018r" then
		DATAMANAGER.RequestRealData( "ohhts_tmst_rsfl" )
		g_NextFlagGrid1 = DATAMANAGER.IsMoreNextData( "ohhts_1001_018r" )
		
		nCnt = DATAMANAGER.GetDataCount( 0, "ohhts_1001_018r", "OutBlock1" )

		If nCnt > 0 Then
			DATAMANAGER.RequestTranData( "ohhts_1001_019r" )
		End If

	elseif szTranID = "ohhts_1001_015r" then
		DATAMANAGER.RequestRealData( "ohhts_nmix_cntg" )
		g_NextFlagGrid1 = DATAMANAGER.IsMoreNextData( "ohhts_1001_015r" )
		
		nCnt = DATAMANAGER.GetDataCount( 0, "ohhts_1001_015r", "OutBlock1" )
		
		If nCnt > 0 Then
			DATAMANAGER.RequestTranData( "ohhts_1001_016r" )
		End If
		
	elseif szTranID = "ohhts_1001_019r" then
		g_NextFlagGrid1 = DATAMANAGER.IsMoreNextData( "ohhts_1001_019r" )
'		DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		DATAMANAGER.RequestRealData( "ohhts_stck_incg" ) '20220207 HSZ 시세속도개선

	elseif szTranID = "ohhts_1001_016r" then
	
		g_NextFlagGrid1 = DATAMANAGER.IsMoreNextData( "ohhts_1001_016r" )
'		DATAMANAGER.RequestRealData( "ohhts_stck_cntg_1" )
		DATAMANAGER.RequestRealData( "ohhts_stck_incg_1" ) '20220207 HSZ 시세속도개선
	    
	end if

End Sub

