	<SCRIPT_INFO _len="4592" _ulen="4486" >
'----------------------------------------------------------------------------
' 01. 화 면 명 : 선옵현재가
' 02. 화면설명 : 선옵현재가 일자별 탭화면
' 03. 작    성 : 2016.04.30 LJS
'----------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szItemCode, g_szItemMarket, g_szgrdHeader1, g_szgrdHeader2

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	g_szItemCode =  Form.GetSharedData( "&ITEM_FUTOPT", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

	'20160705 NOHES START	MarketType Default : "F"로 결정
	if Len(Trim(g_szItemMarket)) == 0 Then
		g_szItemMarket = "JF"			
	end if
	'20160705 NOHES END
	
	'20171109 HAMWG START : 라인차트 추가(MTS 리뉴얼)
	ChartEx0.SetChartType("simpleline")
	ChartEx0.SetPeriodType("3")
	ChartEx0.SetPeriodTime("001")
	'20171109 HAMWG END
End Sub

'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData("ohhts_3000_008r")
	DATAMANAGER.RequestTranData("ohhts_5030_001r")	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	If sKey = "ITEMCODE" Then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		ShowAlert(g_szItemCode,g_szItemMarket)
		'20160705 NOHES START	MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "JF"			
		end if
		'20160705 NOHES END

		DATAMANAGER.RequestTranData( "ohhts_3000_008r" )
		DATAMANAGER.RequestTranData("ohhts_5030_001r")	
	end	if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	DATAMANAGER.CancelRealData( "ohhts_sfut_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_sopt_cntg" )
	if szTranID = "ohhts_3000_008r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_3000_008r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3000_008r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
	'20171011 HAMWG START : 라인차트 추가(MTS 리뉴얼)
	elseif szTranID = "ohhts_5030_001r" then
	     g_szToday = Form.GetSharedData("&HOST_DATE", 0 )
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
	
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR" , 0,"D")  'D/W/M/Y 일/주/월/년 
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DATE1" , 0,g_szToday)
	end if
	'20171011 HAMWG END
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	
	If szTranID = "ohhts_sfut_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_sfut_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	Else
		DATAMANAGER.SetDataValue( 1, "ohhts_sopt_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "ohhts_3000_008r" Then
		
		If g_szItemMarket = "JF" then
			DATAMANAGER.RequestRealData( "ohhts_sfut_cntg" )
			
		ElseIf g_szItemMarket = "JO" then
			DATAMANAGER.RequestRealData( "ohhts_sopt_cntg" )
			
		End if
	End If
	
End Sub

