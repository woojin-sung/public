	<CONTROL_INFO>
		<LABEL name="Label0" fgcolor="062:255255255" fontsize="5" caption="종목선택" bgcolor="064:181181181" transmode="0" halign="1" ly_horz="0,0,667,39,1" />
		<FORMTAB name="FormTab" resize="0001" tabcount="4" tabwidthtype="1" tabheadheight="39" ly_horz="0,39,667,316,1" >
			<PAGE name="page3" caption="미국" linkfile="ItemSearchOverStockT2_h" loadingtype="1" />
			<PAGE name="page2" caption="중국" linkfile="ItemSearchOverStockT1_h" loadingtype="1" />
			<PAGE name="page1" caption="홍콩" linkfile="ItemSearchOverStockT0_h" loadingtype="1" />
			<PAGE name="page4" caption="일본" linkfile="ItemSearchOverStockT3_h" loadingtype="1" />
		</FORMTAB>
		<IMAGE name="imgClose" imgpath="icon_main_03" ly_horz="627,5,30,30,1" />
