'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szCloud		' 관심동기화(0:미사용(로컬), 1:사용(서버))

Dim g_szCode
g_szCode = ""

Dim g_szRow
Dim g_szTitle
g_szTitle = "알림"
Dim g_szVrsnId
Dim g_szUserID

Dim g_szRecent, g_szHold
Dim g_nCheckNum
Dim g_szGubun
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Load_GWGroup :  로컬에 저장된 관심그룹 가져오기
'============================================================================
Function Load_GWGroup()
	Dim tGroup, tList
	
	grdGroup.rowcount = 0	
	szGroup = Form.LoadConfigData("GWANSIM", "GROUP")
	
	if Trim(szGroup ) <> "" then
		tGroup = Split(szGroup, "♣")
		
		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdGroup.insertrow = i
	
			grdGroup.SetCellData("bd_code",  i, tList(0))
			grdGroup.SetCellData("bd_name",  i, tList(1))
			grdGroup.SetCellData("bd_count", i, tList(2))
		Next
	end if
End Function	

'============================================================================
' Save_GWGroup :  관심그룹을 로컬에 저장
'============================================================================
Function Save_GWGroup()
	Form.SaveConfigData("GWANSIM", "GROUP", "")
	
	For i = 0 to grdGroup.rowcount-1
		szCode = grdGroup.GetCellData("bd_code",  i)
		szName = grdGroup.GetCellData("bd_name",  i)
		szCnt  = grdGroup.GetCellData("bd_count", i)
		if i == 0 then
			szGroup = szCode & "★" & szName & "★" & szCnt
		else
			szGroup = szGroup & "♣" & szCode & "★" & szName & "★" & szCnt
		end if
	Next

	Form.SaveConfigData("GWANSIM", "GROUP", szGroup)
	
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'*************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("그룹 편집")
	g_nCheckNum  = 0
	' 관심 동기화 //////////////////////////////////////////////////////////
	g_szCloud = Form.GetEnvData("common.interest_cloud")
'	g_szCloud = "0"
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	' //////////////////////////////////////////////////////////////////////
	
	g_szRecent = Form.LoadConfigData("GW_SET2", "RECENT")
	g_szHold = Form.LoadConfigData("GW_SET2", "HOLD")
	
	if g_szRecent == "" or g_szRecent == null then
		g_szRecent = "1"
	end if
	
	if g_szHold == "" or g_szHold == null then
		g_szHold = "1"
	end if

	if g_szRecent == "1" then
		Table0.SetCellString( 1, 2, "사용")
		Table0.SetCellFgColor( 1, 2, "61" )
	else 
		Table0.SetCellString( 1, 2, "미사용")
		Table0.SetCellFgColor( 1, 2, "111" )
	end if


	if g_szHold == "1" then
		Table0.SetCellString( 2, 2, "사용")
		Table0.SetCellFgColor( 2, 2, "61" )
	else 
		Table0.SetCellString( 2, 2, "미사용")
		Table0.SetCellFgColor( 2, 2, "111" )
	end if
	
	g_szUserID = Form.GetSharedData("&USER_ID", false)
	
	' 그리드 로우 위치 변경 위한 속성
	grdGroup.rowmove = "1"
	
'PENTA13 START => 2019.01.23
	Get_GWGroup()
'PENTA13 ORGSRC
'	if g_szCloud == "1" then		' Server 저장시
'		' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
'		DATAMANAGER.RequestTranData("ohhts_intr_006r")
'	else							' Local 저장시
'		' 로컬 저장된 관심그룹 가져오기	
'		Load_GWGroup()
'	end if
'PENTA13 END
	f_EditVisible("N")
	g_szGubun = ""
End Sub
'============================================================================
Sub Form_OnFormInitBefore()
	contEdit0.imgDel0.setMaintainingRatio("1")
	
End Sub

'============================================================================
' lbl`OnClick
'============================================================================
Sub lblAdd_OnClick()	
Dim szCode, szChk
	Dim nRow
	
	nRow = CInt(grdGroup.rowcount)-1

	if nRow == 199 then
		Form.ShowAlert(g_szTitle, "그룹 추가는 최대 200개 까지만\n가능합니다.")
		Exit Sub
	end if
	
	' 관심그룹 명칭 초기 설정위해.. 코드로 정한다. //////////////////////////
	if nRow < 0 then
		szCode = "000"
	else
		'20180905_01 NOHES START : 관심그룹 생성 시, 순차적으로 확인해서 코드 빠졌을 때 채워넣으면서 만든다.
		'                          그룹이 10개 이상인 경우에 szCd == szCode 처리 못해서 CStr 처리함.
		For i = 0 to 199
			if Len(i) == 1 then
			
				szCode = "00" & i
			elseif Len(i) == 2 then
				szCode = "0" & i
			else
				szCode = CStr(i)
			end if
			
			For j = 0 to nRow		
				szCd = grdGroup.GetCellData("bd_code", j)
				
				if szCd == szCode then					
					szChk = "0"
					Exit For
				else 
					szChk = "1"
				end if
			Next
			if szChk == "1" then
				Exit For
			end if	
		Next

	end if
	' ////////////////////////////////////////////////////////////////////////
	
	Form.OpenPopup("mhprc11000_pf" , "GROUP_ADD★" & szCode & "★", "")
End Sub
'============================================================================
' grdGroup_OnClickUp
'============================================================================
Sub grdGroup_OnClickUp(lRow, szCellID)

	if szCellID == "bd_mod" then
		g_szRow = lRow
		
		szCode = grdGroup.GetCellData("bd_code", lRow)
		szName = grdGroup.GetCellData("bd_name", lRow)
		
		Form.OpenPopup("mhprc11000_pf" , "GROUP_MOD★" & szCode & "★" & szName , "")
		
	elseif szCellID == "bd_check" then
		nRow = Cint(grdGroup.rowcount)

		g_nCheckNum = 0
		for i = 0 to nRow - 1
			if grdGroup.GetCellData( "bd_check", i ) == "1" then
				g_nCheckNum = g_nCheckNum + 1
			end if
		next
		
		lblChkNum.caption = "전체선택" & "(" & g_nCheckNum & ")"
		
		if g_nCheckNum == 0 then
			f_EditVisible("N")
		else
			f_EditVisible("Y")
		end if
		
		if g_nCheckNum <> nRow then
			chkAll.chksilence = "0"
		elseif g_nCheckNum == nRow then
			chkAll.chksilence = "1"
		end if
		if lRow == nRow - 1 then
			grdGroup.toprow = lRow
		end if
	elseif szCellID == "bd_name" then
		if grdGroup.GetCellData( "bd_check", lRow ) == "1" then
			grdGroup.SetCellData( "bd_check", lRow, "0" )
		else
			grdGroup.SetCellData( "bd_check", lRow, "1" )
		end if
		
		nRow = Cint(grdGroup.rowcount)

		g_nCheckNum = 0
		for i = 0 to nRow - 1
			if grdGroup.GetCellData( "bd_check", i ) == "1" then
				g_nCheckNum = g_nCheckNum + 1
			end if
		next
		
		lblChkNum.caption = "전체선택" & "(" & g_nCheckNum & ")"
		
		if g_nCheckNum == 0 then
			f_EditVisible("N")
		else
			f_EditVisible("Y")
		end if
		
		if g_nCheckNum <> nRow then
			chkAll.chksilence = "0"
		elseif g_nCheckNum == nRow then
			chkAll.chksilence = "1"
		end if
	end if	
End Sub

'============================================================================
' grdGroup_OnDropRow
'============================================================================
Sub grdGroup_OnDropRow()
	g_szCode = ""
	DATAMANAGER.RequestTranData("ohhts_intr_008r")
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sRet <> "" then
		tData = Split(sRet, "★")
		
		' 그룹 추가
		if sKeyName == "GROUP_ADD" then

			if tData(2) == "T" then
				g_szRow = 0
			elseif tData(2) == "B" then
				g_szRow = grdGroup.rowcount
			end if
			
			g_szCode = tData(0)
			grdGroup.insertrow = g_szRow
			
			grdGroup.SetCellData("bd_count", g_szRow, 0)
		end if
		
		grdGroup.SetCellData("bd_code", g_szRow, tData(0))
		grdGroup.SetCellData("bd_name", g_szRow, tData(1))
			
		if g_szCloud == "1" then		' Server 저장시
			' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
			DATAMANAGER.RequestTranData("ohhts_intr_008r")
			Save_GWGroup()
		else							' Local 저장시
			' 로컬 저장된 관심그룹 저장하기
			Save_GWGroup()
		end if

	end if
End Sub

'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	' 그룹삭제
	if sKeyName == "DELETE" then
		if sRet == "ok" then
			' 20160324 그룹삭제시 파일에 저장되어 있는 관련 종목도 삭제 시킴 //
			
			
			' ////////////////////////////////////////////////////////////////
'			grdGroup.SetDeleteRow(g_szRow)
			
			for i = grdGroup.rowcount - 1  to 0 Step -1
				if grdGroup.GetCellData( "bd_check", i ) == "1" then
					dim szCode
					szCode = grdGroup.GetCellData("bd_code", i)
					
					Form.SaveConfigData("GWANSIM", szCode, "")
					
					grdGroup.SetDeleteRow(i)
				end if
			next
			chkAll_OnChange("0")
			g_nCheckNum = 0
			
			if g_szCloud == "1" then
				DATAMANAGER.RequestTranData("ohhts_intr_008r")
				Save_GWGroup()
			else
				Save_GWGroup()
			end if			
		end if	
	end if	
End Sub



'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
		DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, g_szUserID)	' USER ID
	' ----------------------------------------------------------------------
	' 관심 수정 TR :그룹추가, 종목추가, 빈칸추가
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_008r" then
'PENTA13 START => 2019.01.25
		DATAMANAGER.ClearInputData(false, "ohhts_intr_008r")
		DATAMANAGER.ClearOutputData(false, "ohhts_intr_008r")
'PENTA13 END	
		' ////////////// 종목추가, 빈칸적용시 ////////////////
		' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_USER_ID",     0, g_szUserID)		
		' FID버전ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_VRSN_ID",     0, g_szVrsnId)	
		'DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_VRSN_ID",     0, "12")	
		' FID수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_MOD_YN",      0, "0")				
		' FID종목수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_ISSU_MOD_YN", 0, "0")				
		
		For i = 0 to grdGroup.rowcount - 1
			' FID관심종목그룹ID
'			DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_CNCN_ISSU_GRP_ID", i, grdGroup.GetCellData("bd_code", i))
			DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_CNCN_ISSU_NEW_GRP_ID", i, grdGroup.GetCellData("bd_code", i))
			' FID관심그룹명
			DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_CNCN_GRP_NAME",    i, grdGroup.GetCellData("bd_name", i))	

			' FID종목수정여부
			'if cmbGroup.cbkeydata == grdGroup.GetCellData("bd_code", i) then	
			'if g_szCode == grdGroup.GetCellData("bd_code", i) then	
			
			'	DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_ISSU_MOD_YN", i, "1")			' 수정
			'else
				DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_ISSU_MOD_YN", i, "0")			' 수정안함
			'end if
		Next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 관심 수정 TR
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_008r" then
		g_szVrsnId = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "FID_VRSN_ID" , 0 )
	
		Form.SetSharedData("VRSN_ID", g_szVrsnId) ' 20160317 편집시 ID가 메인화면과 연동안되는부분 때문에 추가
		Get_GWGroup()		'PENTA13 START => 2019.01.23
		g_szGubun = "1"
	elseif szTranID == "ohhts_intr_006r" then
		g_szVrsnId = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "FID_VRSN_ID" , 0 )
		For i = 0 to grdGroup.rowcount - 1
			grdGroup.setMaintainingRatio("bd_mod", i, "1")
			grdGroup.setMaintainingRatio("bd_move", i, "1")
		Next
		g_nCheckNum = 0
		f_EditVisible("N")
		chkAll.chksilence = "0"
		grdGroup.setCellMaxLineCount("bd_name", 2)
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	' ----------------------------------------------------------------------
	' 관심 수정 TR
	' ----------------------------------------------------------------------
'	if szTranID == "ohhts_intr_008r" then
'		Form.Toast(1, "[" & szErrCode & "]" & szErrMsg, true)
'	end if		
End Sub
'============================================================================
'PENTA13 START => 2019.01.23
Function Get_GWGroup( )
	grdGroup.rowcount = 0
	if g_szCloud == "1" then		' Server 저장시
		' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
		DATAMANAGER.RequestTranData("ohhts_intr_006r")
	else							' Local 저장시
		' 로컬 저장된 관심그룹 가져오기
		Load_GWGroup( )
	end if
End Function
'PENTA13 END
'============================================================================
Sub contEdit0_tblEdit1_OnClick(lRow , lColumn)

	Form.MsgBox( "관심 종목 삭제", g_nCheckNum & "개 관심그룹을\n삭제하시겠습니까?", "DELETE", 7, "삭제하기", "취소" )
	
End Sub
'============================================================================
Sub chkAll_OnChange(sCheckState)
	Dim nCnt
	nCnt = grdGroup.rowcount
	if nCnt <> 0 and nCnt <> "0" then
		if sCheckState == "1" then
			for i = 0 to nCnt - 1
				grdGroup.SetCellData( "bd_check", i, "1" )
			next
			
			g_nCheckNum = nCnt
			f_EditVisible("Y")
		else
			for i = 0 to nCnt - 1
				grdGroup.SetCellData( "bd_check", i, "0" )
			next
			
			g_nCheckNum = 0
			f_EditVisible("N")
		end if
	end if
End Sub

'============================================================================
Function f_EditVisible(szData)
	if szData == "Y" then
		contEdit0.visible = true
		grdGroup.height = "411"
	else
		contEdit0.visible = false
		grdGroup.height = "471"
	end if
	lblChkNum.caption = "전체선택" & "(" & g_nCheckNum & ")"
	nLength = Cint(Form.getLen(lblChkNum.caption)) - 4
	lblChkNum.changeTextAttr(4,nLength,"7",0,0)
End Function


'============================================================================
Sub Table0_OnClick(lRow , lColumn)
	
	if lColumn == 2 then
		if lRow == 1 then		'최근조회
			if Table0.GetCellString( 1, 2 ) == "사용" then
				Table0.SetCellString( 1, 2, "미사용")
				Table0.SetCellFgColor( 1, 2, "111" )
				g_szRecent = "0"
			else
				Table0.SetCellString( 1, 2, "사용")
				Table0.SetCellFgColor( 1, 2, "61" )
				g_szRecent = "1"
			end if
		elseif lRow == 2 then	'보유 
			if Table0.GetCellString( 2, 2 ) == "사용" then
				Table0.SetCellString( 2, 2, "미사용")
				Table0.SetCellFgColor( 2, 2, "111" )
				g_szHold = "0"
			else
				Table0.SetCellString( 2, 2, "사용")
				Table0.SetCellFgColor( 2, 2, "61" )
				g_szHold = "1"
			end if
		end if
		
		Form.SaveConfigData("GW_SET2", "RECENT", g_szRecent)
		Form.SaveConfigData("GW_SET2", "HOLD", g_szHold)
		g_szGubun = "2"
		'Form.SendReturnToParent("GW_SET2", "2")
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("GW_SET2", g_szGubun)
End Sub

