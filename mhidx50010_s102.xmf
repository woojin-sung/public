	end if
	
End Sub

'============================================================================
Sub LabelDebi0_OnSizeAutoFit()

	if gOsType == "1" then
		nLeft = Form.calcUnResize(LabelDebi0.left, "2")
		nWidth = Form.calcUnResize(LabelDebi0.width, "2")
	else
		nLeft = LabelDebi0.left
		nWidth = LabelDebi0.width
	end if
	
	LabelRate0.left = nLeft + nWidth + 5

End Sub

