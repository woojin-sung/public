Dim gOsType

'============================================================================
Sub Form_OnFormInitBefore()

	gOsType = Form.GetSharedData("&OS_TYPE", false )

	ImageFlag0.setMaintainingRatio("1")
	ImageFlag1.setMaintainingRatio("1")
	ImageFlag2.setMaintainingRatio("1")
	ImageFlag3.setMaintainingRatio("1")

	LabelTitle0.paddinginfo = "0,0,0,0"
	LabelTitle1.paddinginfo = "0,0,0,0"
	LabelTitle2.paddinginfo = "0,0,0,0"
	LabelTitle3.paddinginfo = "0,0,0,0"
	
	LabelData0.paddinginfo = "0,0,0,0"
	LabelData1.paddinginfo = "0,0,0,0"
	LabelData2.paddinginfo = "0,0,0,0"
	LabelData3.paddinginfo = "0,0,0,0"
	
	LabelSign0.paddinginfo = "0,0,0,0"
	LabelSign1.paddinginfo = "0,0,0,0"
	LabelSign2.paddinginfo = "0,0,0,0"
	LabelSign3.paddinginfo = "0,0,0,0"
	
	'안드로이드에서 sizeautofit사용 시 
	'오른쪽 패딩값을 0으로 주면 살짝 짤리는 현상때문에 2로 세팅
	if gOsType == "1" then
		LabelDebi0.paddinginfo = "0,0,2,0"
		LabelDebi1.paddinginfo = "0,0,2,0"
		LabelDebi2.paddinginfo = "0,0,2,0"
		LabelDebi3.paddinginfo = "0,0,2,0"
	else
		LabelDebi0.paddinginfo = "0,0,0,0"
		LabelDebi1.paddinginfo = "0,0,0,0"
		LabelDebi2.paddinginfo = "0,0,0,0"
		LabelDebi3.paddinginfo = "0,0,0,0"
	end if
	
	LabelRate0.paddinginfo = "0,0,0,0"
	LabelRate1.paddinginfo = "0,0,0,0"
	LabelRate2.paddinginfo = "0,0,0,0"
	LabelRate3.paddinginfo = "0,0,0,0"
	
	lblTime0.paddinginfo = "0,0,0,0"
	lblTime1.paddinginfo = "0,0,0,0"
	lblTime2.paddinginfo = "0,0,0,0"
	lblTime3.paddinginfo = "0,0,0,0"
	
	imgReal0.setMaintainingRatio("1")
	imgReal1.setMaintainingRatio("1")
	imgReal2.setMaintainingRatio("1")
	imgReal3.setMaintainingRatio("1")
	
	LabelDebi0.sizeAutoFit()
	LabelDebi1.sizeAutoFit()
	LabelDebi2.sizeAutoFit()
	LabelDebi3.sizeAutoFit()
	
	lblTime0.fgcolor = 333
	lblTime1.fgcolor = 333
	lblTime2.fgcolor = 333
	lblTime3.fgcolor = 333
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		
		LabelDebi0.fontsize = - Cint((szTextSize * 4))
		LabelDebi1.fontsize = - Cint((szTextSize * 4))
		LabelDebi2.fontsize = - Cint((szTextSize * 4))
		LabelDebi3.fontsize = - Cint((szTextSize * 4))
		
		LabelRate0.fontsize = - Cint((szTextSize * 4))
		LabelRate1.fontsize = - Cint((szTextSize * 4))
		LabelRate2.fontsize = - Cint((szTextSize * 4))
		LabelRate3.fontsize = - Cint((szTextSize * 4))
	
	end if	
	
	'--------------------------------------------------------------
	' OS별 컨트롤 위치조정
	'--------------------------------------------------------------
	if gOsType == "1" then
		
		LabelSign0.top = 53
		LabelSign1.top = 53
		LabelSign2.top = 151
		LabelSign3.top = 151
		
		LabelSign0.left = 28
		LabelSign1.left = 210
		LabelSign2.left = 28
		LabelSign3.left = 210
		
		LabelDebi0.left = 46
		LabelDebi1.left = 228
		LabelDebi2.left = 46
		LabelDebi3.left = 228
		
	end if

	'--------------------------------------------------------------
	' 서비스에서 내려오는 색상 속성값 미사용
	'--------------------------------------------------------------
	LabelData0.setAttributeEnable(false)
	LabelData1.setAttributeEnable(false)
	LabelData2.setAttributeEnable(false)
	LabelData3.setAttributeEnable(false)

	'--------------------------------------------------------------
	' 지수 조회 서비스 호출
	'--------------------------------------------------------------
	RequestData()
	
End Sub
'============================================================================
Function RequestData()

	DATAMANAGER.ClearInputData(0, "ohhts_1682_001r")
	
	'---------------------
	' E-Mini 나스닥100
	'---------------------
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "FN")
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , "CME@NQ")
	
	'---------------------
	' E-Mini S&P500 선물
	'---------------------
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 1 , "FN")
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" 				, 1 , "CME@ES")
	
	'---------------------
	' NYSE종합
	'---------------------
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 2 , "N")
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" 				, 2 , "NYS@NYA")
	
	'---------------------
	' US 달러 인덱스
	'---------------------
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 3 , "N")
	DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" 				, 3 , "ETC@DXY00")
	
	'---------------------
	' 서비스 호출
	'---------------------
	DATAMANAGER.RequestTranData("ohhts_1682_001r")

End Function
'============================================================================
Function RequestRealData()

	DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg", "InBlock1", "FIDR_SYMB" , 0 , "CME@NQ")
	DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg_1", "InBlock1", "FIDR_SYMB" , 1 , "CME@ES")
	
	DATAMANAGER.RequestRealData("ohhts_nfut_cntg")
	DATAMANAGER.RequestRealData("ohhts_nfut_cntg_1")

End Function
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "ohhts_1682_001r" then
		
		'---------------------
		' E-Mini 나스닥100
		'---------------------
		sData0 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRPR" 			, 0)
		sSign0 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" 	, 0)
		sDebi0 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS" 		, 0)
		sRate0 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_CTRT" 		, 0)
		sDate0 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_DATE" 			, 0)
		
		if sDate0 <> "" then
			if Len(sDate0) > 7 then
				sMonth = Mid(sDate0,5,2)
				sDay = Right(sDate0,2)
				sDate0 = sMonth & "." & sDay
			end if
		end if
		
		LabelData0.caption = sData0
		LabelSign0.caption = sSign0
		LabelDebi0.caption = sDebi0
		LabelRate0.caption = sRate0
		lblTime0.caption = sDate0 & " " & lblTime0.caption
		
		'------------------------------------------------------------
		'등락률 글자색상 설정
		'------------------------------------------------------------
		if sSign0 == "1" or sSign0 == "2" then
			LabelRate0.fgcolor = 10
		elseif sSign0 == "4" or sSign0 == "5" then
			LabelRate0.fgcolor = 11
		else
			LabelRate0.fgcolor = 12
		end if
		
		'---------------------
		' E-Mini S&P500
		'---------------------
		sData1 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRPR" 			, 1)
		sSign1 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" 	, 1)
		sDebi1 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS" 		, 1)
		sRate1 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_CTRT" 		, 1)
		sDate1  = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_DATE" 			, 1)
		
		if sDate1 <> "" then
			if Len(sDate1) > 7 then
				sMonth = Mid(sDate1,5,2)
				sDay = Right(sDate1,2)
				sDate1 = sMonth & "." & sDay
			end if
		end if
		
		LabelData1.caption = sData1
		LabelSign1.caption = sSign1
		LabelDebi1.caption = sDebi1
		LabelRate1.caption = sRate1
		lblTime1.caption = sDate1 & " " & lblTime1.caption
		
		'------------------------------------------------------------
		' 등락률 글자색상 설정
		'------------------------------------------------------------
		if sSign1 == "1" or sSign1 == "2" then
			LabelRate1.fgcolor = 10
		elseif sSign1 == "4" or sSign1 == "5" then
			LabelRate1.fgcolor = 11
		else
			LabelRate1.fgcolor = 12
		end if
		
		'---------------------
		' NYSE
		'---------------------
		sData2 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRPR" 			, 2)
		sSign2 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" 	, 2)
		sDebi2 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS" 		, 2)
		sRate2 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_CTRT" 		, 2)
		sDate2 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_DATE" 			, 2)
		
		if sDate2 <> "" then
			if Len(sDate2) > 7 then
				sMonth = Mid(sDate2,5,2)
				sDay = Right(sDate2,2)
				sDate2 = sMonth & "." & sDay
			end if
		end if
		
		LabelData2.caption = sData2
		LabelSign2.caption = sSign2
		LabelDebi2.caption = sDebi2
		LabelRate2.caption = sRate2
		lblTime2.caption = sDate2 & " " & lblTime2.caption
		
		'------------------------------------------------------------
		' 등락률 글자색상 설정
		'------------------------------------------------------------
		if sSign2 == "1" or sSign2 == "2" then
			LabelRate2.fgcolor = 10
		elseif sSign2 == "4" or sSign2 == "5" then
			LabelRate2.fgcolor = 11
		else
			LabelRate2.fgcolor = 12
		end if
		
		'---------------------
		' US달러인덱스
		'---------------------
		sData3 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRPR" 			, 3)
		sSign3 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" 	, 3)
		sDebi3 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS" 		, 3)
		sRate3 = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_PRDY_CTRT" 		, 3)
		sDate3  = DATAMANAGER.GetDataValue(0, "ohhts_1682_001r", "OutBlock1", "FID_CNCN_DATE" 			, 3)
		
		if sDate3 <> "" then
			if Len(sDate3) > 7 then
				sMonth = Mid(sDate3,5,2)
				sDay = Right(sDate3,2)
				sDate3 = sMonth & "." & sDay
			end if
		end if
		
		LabelData3.caption = sData3
		LabelSign3.caption = sSign3
		LabelDebi3.caption = sDebi3
		LabelRate3.caption = sRate3
		lblTime3.caption = sDate3 & " " & lblTime3.caption
		
		'------------------------------------------------------------
		' 등락률 글자색상 설정
		'------------------------------------------------------------
		if sSign3 == "1" or sSign3 == "2" then
			LabelRate3.fgcolor = 10
		elseif sSign3 == "4" or sSign3 == "5" then
			LabelRate3.fgcolor = 11
		else
			LabelRate3.fgcolor = 12
		end if
		
		'------------------------------------------------------------
		'실시간호출
