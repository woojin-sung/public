		<EDIT name="edtPW" halign="1" password="2" imetype="1" maxlength="8" minlength="4" hintcaption="비밀번호" ly_vert="289,9,80,39,1" />
		<FORMTAB name="fmtab0" tabcount="2" tabwidthtype="1" tabheadheight="40" autosave="1" ly_vert="0,57,375,505,1" >
