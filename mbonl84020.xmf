'============================================================================
' 01. 화 면 명 : 사고등록/해지
' 02. 화면설명 : 사고등록/해지
' 03. 작    성 : 2016. 01. 25. 유창재
' 2020.09.18 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim szData		'계좌번호 & 비밀번호
Dim g_TabType		'폼탭 상태
Dim g_plain_rm  	'v0001 메모리평문적용여부

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	edtPW.caption = ""
	szData = acnt0.total & "★" & ""
	
	g_TabType = CInt(fmtab0.currenttab)
	
	if g_TabType == 0 then
		Form.triggerEvent( "fmtab0."& fmtab0.currenttabpageid, "사고등록", szData)
	else
		Form.triggerEvent( "fmtab0."& fmtab0.currenttabpageid, "사고해지", szData)
	end if
	
End Sub
'============================================================================
' fmtab0_OnTabChanged(nCurrentTab) : 비밀번호를 입력하지 않고 탭을 바꿀때 설정
'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
	
	'v0001 메모리평문적용된 경우, 암호화된 정보로 넘어가므로 연동된 화면 체크 필요
	szData = acnt0.total & "★" & edtPW.caption
	
	g_TabType = nCurrentTab
'	if edtPW.caption == "" then		
		if g_TabType == 0 then
			Form.triggerEvent( "fmtab0."& fmtab0.currenttabpageid, "사고등록", szData)
		else
			Form.triggerEvent( "fmtab0."& fmtab0.currenttabpageid, "사고해지", szData)
		end if
'	
'	else
'		if g_TabType == 0 then
'			Form.triggerEvent( "fmtab0."& fmtab0.currenttabpageid, "사고등록", szData)
'		else
'			Form.triggerEvent( "fmtab0."& fmtab0.currenttabpageid, "사고해지", szData)
'		end if
'	end if
	
	
End Sub
'============================================================================
' edtPW_OnEditComplete()
'============================================================================
Sub edtPW_OnEditComplete()

	'v0001 메모리평문적용된 경우, 암호화된 정보로 넘어가므로 연동된 화면 체크 필요(mbonl84020_t1, mbonl84020_t2)
	szData = acnt0.total & "★" & edtPW.caption & "★" & "No"			'계좌번호 & 비밀번호
	
	if edtPW.caption == "" or edtPW.caption == Null then
		szData = acnt0.total & "★" & "" & "★" & "No"			'계좌번호 & 비밀번호
	end if
	
	if g_TabType == 0 then
		Form.triggerEvent( "fmtab0."& fmtab0.currenttabpageid, "사고등록", szData)
	else
		Form.triggerEvent( "fmtab0."& fmtab0.currenttabpageid, "사고해지", szData)
	end if
End Sub
'============================================================================
' acnt0_ChangeAccount()
'============================================================================
Sub acnt0_ChangeAccount()
	
	'메모리평문적용된 경우, 암호화된 정보로 넘어가므로 연동된 화면 체크 필요
	szData = acnt0.total & "★" & edtPW.caption			'계좌번호 & 비밀번호
	
	if edtPW.caption == "" then		
		if g_TabType == 0 then
			Form.triggerEvent( "fmtab0."& fmtab0.currenttabpageid, "사고등록", szData)
		else
			Form.triggerEvent( "fmtab0."& fmtab0.currenttabpageid, "사고해지", szData)
		end if
	
	else
		if g_TabType == 0 then
			Form.triggerEvent( "fmtab0."& fmtab0.currenttabpageid, "사고등록", szData)
		else
			Form.triggerEvent( "fmtab0."& fmtab0.currenttabpageid, "사고해지", szData)
		end if
	end if
	
	edtPW.caption = ""
End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "Clear" then
		edtPW.caption = ""
		if sParam == "One" then
			szData = acnt0.total & "★" & ""
			Form.triggerEvent( "fmtab0."& fmtab0.currenttabpageid, "사고등록", szData)
		else
			szData = acnt0.total & "★" & ""
			Form.triggerEvent( "fmtab0."& fmtab0.currenttabpageid, "사고해지", szData)
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	
	fmtab0_OnTabChanged(g_TabType)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	if szTranID == "obacp_opop_066r" then
		edtPW.caption = ""
	end if
	
End Sub

