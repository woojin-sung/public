Dim g_szEngName		'구독자 영문이름
Dim g_szEngAddress	'구독자 영문주소

Dim g_szEngOcptName		'구독자 영문직업명
Dim g_szEngCoName			'구독자 영문회사명
Dim g_szEngCoAddr			'구독자 영문회사주소
Dim g_szEngClpsName		'구독자 영문직급명
Dim g_szEngRsnsBswrName	'구독자 영문담당업무명

Dim g_szInPutClpsName
Dim g_szInPutJobName
Dim g_szKeyClpsName
Dim g_szKeyJobName
g_szKeyClpsName = {"Staff"
				,"Chief"
				,"Assistant Manager"
				,"Manager"
				,"Deputy General Manager"
				,"Department Manager"
				,"Executive"
				,"President"
				,"Chairman"
				,"Other"}
g_szKeyJobName = {"01",
				"02",
				"03",
