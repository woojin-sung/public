<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="84030" scrname="주문대리인비밀번호관리" version="2" writer="권오상" />
	<FORM_INFO name="Form" ly_vert="0,0,375,562,1" />
	<CONTROL_INFO>
		<FORMTAB name="FormTab0" tabcount="3" tabwidthtype="2" tabheadheight="36" ly_vert="0,0,380,563,1" >
			<PAGE name="page009393" caption="최초등록" linkfile="mbonl84030_t1.xmf" loadingtype="1" />
			<PAGE name="page008462" caption="변경(재설정)" linkfile="mbonl84030_t2.xmf" loadingtype="1" />
			<PAGE name="page005997" caption="수임계좌 비밀번호 사용현황" linkfile="mbonl84030_t3.xmf" loadingtype="1" />
		</FORMTAB>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="987" _ulen="909" >
'===========================================================================
'===========================================================================
Dim ScreenNO
'============================================================================
Sub Form_OnFormInit()
	ScreenNo = Form.GetSharedData("&SCREEN_NO", False)
	Select Case  ScreenNO 
		Case "84031"
			FormTab0.currenttabpageid = "page008462"
		Case "84032"
			FormTab0.currenttabpageid = "page005997"
		Case Else
			FormTab0.currenttabpageid = "page009393"
	End Select
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
    If nCurrentTab = 1 Then
        Form.setTitleCaption( "주문대리인 비밀번호 변경(재설정)" )
    ElseIf nCurrentTab = 2 Then
        Form.setTitleCaption( "수임계좌 비밀번호 사용현황" )
    Else
        Form.setTitleCaption( "주문대리인 비밀번호 최초등록" )
    End If
End Sub

	</SCRIPT_INFO>
</ROOT>