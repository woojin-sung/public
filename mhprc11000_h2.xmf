			<TRAN tranid="ohhts_frbr_cntg" trcode="ohhts_frbr_cntg" />
			<TRAN tranid="ohhts_1001_004r" trcode="ohhts_1001_004r" compress="1" encryption="1" inputcheck="1" useattr="0" />
