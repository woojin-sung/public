	<SCRIPT_INFO _len="4314" _ulen="4238" >
'----------------------------------------------------------------------------
' 01. 화 면 명 : 가로탭_시간별
' 02. 화면설명 : 주식현재가 시간별 가로탭화면
' 03. 작    성 : 2016.04.30 LJS
'----------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szItemCode, g_szItemMarket, g_szgrdHeader1, g_szgrdHeader2

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	g_szItemCode 	 =  Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
'	DATAMANAGER.RequestTranData( "ohhts_1001_004r" )
	
	'20180712 HAMWG START : K-OTC MTS 도입
	if g_szItemMarket = "T" then
		grd0.visible = False
		grd1.visible = True
	else
		grd0.visible = True
		grd1.visible = False
	end if
	'20180712 HAMWG END
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		'20180712 HAMWG START : K-OTC MTS 도입
		if g_szItemMarket = "T" then
			grd0.visible = False
			grd1.visible = True
		else
			grd0.visible = True
			grd1.visible = False
		end if
		'20180712 HAMWG END

		DATAMANAGER.RequestTranData( "ohhts_1001_004r" )		
	 end if
	 
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    if szTranID = "ohhts_1001_004r" then
	    DATAMANAGER.CancelRealData("ohhts_elw_cntg")
	    DATAMANAGER.CancelRealData("ohhts_stck_cntg")
	    DATAMANAGER.CancelRealData("ohhts_frbr_cntg")	'20180712 HAMWG : K-OTC MTS 도입	   
	    
	    DATAMANAGER.SetDataValue( 0, "ohhts_1001_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szItemMarket )
	    DATAMANAGER.SetDataValue( 0, "ohhts_1001_004r", "InBlock1", "FID_INPUT_ISCD"				, 0, g_szItemCode )
	    
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	    DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szItemCode )
	    DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg" , "InBlock1", "FIDR_SHRN_ISCD", 0, g_szItemCode )
	    DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szItemCode )	'20180712 HAMWG : K-OTC MTS 도입
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    if szTranID = "ohhts_1001_004r" then
		For i = 0 To grd0.rowcount - 1
			Dim nData
			nData = CDbl( grd0.GetCellData( "bd_cell2", i ) )
		
			If nData > 0 Then
				grd0.SetCellFgColor( "bd_cell1", i, "10")
			ElseIf nData < 0 Then
				grd0.SetCellFgColor( "bd_cell1", i, "11")
			Else
				grd0.SetCellFgColor( "bd_cell1", i, "12")
			End If	
		Next

		if g_szItemMarket = "W" then
			DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
		
		'20180712 HAMWG START : K-OTC MTS 도입
		elseif g_szItemMarket = "T" then
			DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
		'20180712 HAMWG END
		
		else
			DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		end if
    end if
End Sub

'============================================================================
Sub grd0_OnScrollEnd()
'	If grd0.rowcount <= 280 then
'		DATAMANAGER.RequestNextData( "ohhts_1001_004r" )
'	End if	
End Sub


