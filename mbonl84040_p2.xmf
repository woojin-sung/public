'============================================================================
' 01. 화 면 명 : 온라인계좌개설_약관
' 02. 작    성 : 신명준
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim	g_CtcnGb
Dim	g_CtcnCnt	'보여질약관건수
Dim	g_Ret

'G_STEP2_1_FILE 설정정보 ---------------------------------------------------
Dim g_BDM_PRCD100            '종합매매 가입여부
Dim g_BDM_PRCD118RP          'CMA(증권형) 가입여부
Dim g_BDM_PRCD100F           '종합매매(금상전용) 가입여부
Dim g_BDM_PRCD101            '선물옵션 가입여부
Dim g_BDM_PRCD135            '해외파생 가입여부
Dim g_BDM_PRCD133            'ISA 가입여부
Dim g_BDM_PRCDCFD            'CFD 가입여부
'v0002 해외 CFD / 중개형 ISA 추가
Dim	g_BDM_PRCD137			'해외 CFD
Dim	g_BDM_ISA_PROD_TYPE	'ISA type
'연금저축, 랩 추가
Dim g_BDM_PRCD131			'연금저축 가입여부
Dim g_BDM_WRAP			'랩 가입여부
'v0005 : 다드림 추가
Dim g_BDM_PRCD200			'다드림 가입여부

'============================================================================
' 							FORM 함수
'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

    imgPrev.imgpath = "icon_arrow3_l.png"    '덜두껍고 큰 꺽쇠
    imgNext.imgpath = "icon_arrow3_r.png"

    '공유정보Get
	User_SharedData_Get()

	sRevData = Form.GetOpenLinkData()
	if sRevData == "" or sRevData == null then
		Form.CloseForm()
	else 
		g_CtcnGb = sRevData
	end if

	'약관목록 순서대로 리스트 조립 -----------------------------------------
	g_CtcnCnt = 0
	
	'sRevData = A.전체 0.< 종합매매계좌 주요약관/설명서 >
	If sRevData == "A" or (sRevData == "0" or sRevData = 0) then
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P100_5")	'매매거래계좌설정약관
		g_CtcnCnt = CInt(g_CtcnCnt) + 1

		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P100_1")	'주식 위탁증거금 안내 및 위험고지
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "P100_3")	'RP 및 CMA(RP)종목대체 동의 및 통지방법 확인
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
	End If
	
	'sRevData = A.전체 1.< 예금자보호확인 >
	If sRevData == "A" Or (sRevData == "1" Or sRevData == 1) then
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "2_2")	'예금자보호확인
		g_CtcnCnt = CInt(g_CtcnCnt) + 1
	End If
	
	'sRevData = A.전체 2.< 개인(신용)정보 필수 동의서 >
	If sRevData == "A" Or (sRevData == "2" Or sRevData = 2) then
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "Mndt1")	'개인(신용)정보 필수 동의서_요약 v0001
		g_CtcnCnt = CInt(g_CtcnCnt) + 1	
		
		mkCtcn = "contCtcn.lblCtcn"..CStr(g_CtcnCnt)
		Form.SetCtlProp(mkCtcn, "caption", "Mndt2")	'개인(신용)정보 필수 동의서_상세 v0001
		g_CtcnCnt = CInt(g_CtcnCnt) + 1	
	End If
	
     '첫번째약관 보이기
	fmtab.currenttab = 0
	fmtab_OnTabChanged(0)
End Sub

'============================================================================
Sub Form_OnFormClose()
	'화면닫기전 안드로이드-백버튼 작동Y 원복
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")

	if g_Ret ~= "" or g_Ret ~= null then
		'확인 버튼으로 종료시에만 정상확인 처리
		Form.SendReturnToParent("mbonl84040_p2", g_Ret)
	end if
	
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
    g_Ret = ""
    Form.CloseForm()
End Sub

'============================================================================
' 							CONTORL 함수
'============================================================================
' TAB별 화면 호출
'============================================================================
Sub fmtab_OnTabChanged(nCurrentTab)
	If nCurrentTab < CInt(g_CtcnCnt) Then	'폼탭연결된 수가 아닌 오픈되어야 할 약관 수(g_CtcnCnt)만큼만 처리
		mkCtcn1 = "contCtcn.lblCtcn"..nCurrentTab
		mkCtcn2 =  Form.GetCtlProp(mkCtcn1, "caption")
'Form.ShowAlert("mkCtcn2", mkCtcn2)
		Form.triggerEvent("fmtab."..fmtab.currenttabpageid, mkCtcn2, "")
	else
	    '오픈되어야할 약관수 넘어가는 경우 페이징처리 불가/현재페이지에 머무르도록 설정
	    fmtab.currenttab = CInt(nCurrentTab)-1
	    'IOS인경우 빈페이만 남으므로 폼탭이벤트 탈수 있게 이벤트호출
	    fmtab_OnTabChanged(CInt(nCurrentTab)-1)
	End If
	
	'페이지설정
	nowPage = CInt(nCurrentTab)+1
	If CInt(nowPage) > CInt(g_CtcnCnt) Then
        nowPage = CInt(g_CtcnCnt)
	End If
    lblPage.caption = nowPage.."/"..g_CtcnCnt
End Sub

'============================================================================
' 좌/우 페이지처리(좌)
'============================================================================
Sub imgPrev_OnClick()
    nowTabId = fmtab.currenttab
    
    if CInt(nowTabId) > 0 then
		iIdx = fmtab.currenttab
		fmtab.currenttab = CInt(iIdx) - 1		
		fmtab_OnTabChanged(CInt(iIdx) - 1)
	end if
	
End Sub

'============================================================================
' 좌/우 페이지처리(우)
'============================================================================
Sub imgNext_OnClick()
    'nowTabId = fmtab.currenttab
    nowTabId = fmtab.currenttabpageid
    
    if CInt(nowTabId) < CInt(g_CtcnCnt) then  '폼탭연결된 수가 아닌 오픈되어야 할 약관 수(g_CtcnCnt)만큼만 처리
		iIdx = fmtab.currenttab
		fmtab.currenttab = CInt(iIdx) + 1
		fmtab_OnTabChanged(CInt(iIdx) + 1)
	end if
	
End Sub

'============================================================================
' 확인 버튼
'============================================================================
Sub bntOK_OnClick()
	g_Ret = "ok_"..g_CtcnGb
	Form.CloseForm()
End Sub

'============================================================================
' 							사용자 함수
'============================================================================
Function User_SharedData_Get()
    'G_STEP2_1_FILE 설정정보 ---------------------------------------------------
    g_BDM_PRCD100			= Form.GetSharedData("BDM_PRCD100"			, false)	'종합매매 가입여부
    g_BDM_PRCD118RP		= Form.GetSharedData("BDM_PRCD118RP"			, false)	'CMA(증권형) 가입여부
    g_BDM_PRCD100F		= Form.GetSharedData("BDM_PRCD100F"			, false)	'종합매매(금상전용) 가입여부
    g_BDM_PRCD101			= Form.GetSharedData("BDM_PRCD101"			, false)	'선물옵션 가입여부
    g_BDM_PRCD135			= Form.GetSharedData("BDM_PRCD135"			, false)	'해외파생 가입여부
    g_BDM_PRCD133			= Form.GetSharedData("BDM_PRCD133"			, false)	'ISA 가입여부
    g_BDM_PRCDCFD			= Form.GetSharedData("BDM_PRCDCFD"			, false)	'CFD 가입여부
    'v0002
    g_BDM_PRCD137			= Form.GetSharedData("BDM_PRCD137"			, false)	'해외CFD 가입여부
    g_BDM_ISA_PROD_TYPE	= Form.GetSharedData("BDM_ISA_PROD_TYPE"		, false)	'ISA type
    
    '연금저축, 랩 추가
    g_BDM_PRCD131			= Form.GetSharedData("BDM_PRCD131"			, false)	'연금저축 가입여부
    g_BDM_WRAP			= Form.GetSharedData("BDM_WRAP"				, false)	'연금저축 가입여부
    
    'v0005 : 다드림 추가
    g_BDM_PRCD200			= Form.GetSharedData("BDM_PRCD200"			, false)	'다드림 가입여부
End Function

	</SCRIPT_INFO>
</ROOT>