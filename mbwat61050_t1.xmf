	<SCRIPT_INFO _len="6036" _ulen="5844" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Wrap 소개 - 상품
' 02. 화면설명 : 
' 03. 이    력 : 2024.06.28 : 고승연 : v0001 : 예금자보호 문구 수정
'-------------------------------------------------------------------------------------------
'============================================================================
Sub Form_OnFormInit()
	f_SetClear()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "Clear" then
		f_SetClear()
		
	elseif sEventName == "Request" then
		f_SetInit()
		
		if sParam <> null and sParam <> "" then
			Dim tData
			tData = Split(sParam, "|")
			
			if tData(0) == null or tData(0) == "" or tData(1) == null or tData(1) == "" then
				Exit Sub
			end if
			
			DATAMANAGER.SetDataValue( 0, "obwat_mgmt_256r", "InBlock1", "WA_ACNO" , 0 , tData(0) )
			DATAMANAGER.SetDataValue( 0, "obwat_mgmt_256r", "InBlock1", "WA_CNRC_NO" , 0 , tData(1) )			
			DATAMANAGER.SetDataValue( 0, "obwat_mgmt_256r", "InBlock1", "IQRY_CLS_CODE" , 0 , "0" )
			
			DATAMANAGER.RequestTranData( "obwat_mgmt_256r" )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_mgmt_256r" then
		sWA_PRNM					= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "WA_PRNM" , 0 )
		sFRST_CNRC_DATE			= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "FRST_CNRC_DATE" , 0 )
		sCNRC_MTRT_DATE			= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "CNRC_MTRT_DATE" , 0 )
		sWA_INVT_AMT				= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "WA_INVT_AMT" , 0 )
		sPAYM_PRNC				= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "PAYM_PRNC" , 0 )
		sWA_VLTN_AMT				= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "WA_VLTN_AMT" , 0 )
		sIO_AMT					= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "IO_AMT" , 0 )
		sLOAN_BAL				= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "LOAN_BAL" , 0 )
		sPRLS_AMT				= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "PRLS_AMT" , 0 )
		sPLRT					= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "PLRT" , 0 )
		sWA_VLTN_PRLS_AMT			= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "WA_VLTN_PRLS_AMT" , 0 )
		sWA_SMPL_ERT				= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "WA_SMPL_ERT" , 0 )
		sACML_ERT				= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "ACML_ERT" , 0 )
		sWA_TIMS_ACML_ERT			= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "WA_TIMS_ACML_ERT" , 0 )
		sAMCL_INVT_AMT			= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "ACML_INVT_AMT" , 0 )
		sOTCM_PAY_STND_AMT_VRSS_ERT	= DATAMANAGER.GetDataValue( 0, "obwat_mgmt_256r" , "OutBlock1" , "OTCM_PAY_STND_AMT_VRSS_ERT" , 0 )
		
		cont.lblName.caption = sWA_PRNM
		
		cont.tblInfo0.SetCellString(0, 1, sFRST_CNRC_DATE)
		cont.tblInfo0.SetCellString(1, 1, sCNRC_MTRT_DATE)
		cont.tblInfo0.SetCellString(2, 1, sPAYM_PRNC)
		cont.tblInfo0.SetCellString(3, 1, tonumber(sWA_INVT_AMT) + tonumber(sIO_AMT))
		cont.tblInfo0.SetCellString(4, 1, sLOAN_BAL)
		cont.tblInfo0.SetCellString(5, 1, tonumber(sWA_VLTN_AMT) - tonumber(sLOAN_BAL))
		cont.tblInfo0.SetCellString(6, 1, sWA_VLTN_AMT)
		
		cont.tblInfo1.SetCellString(0, 1, sPRLS_AMT)
		cont.tblInfo1.SetCellString(1, 1, sPLRT)
		cont.tblInfo1.SetCellString(2, 1, sWA_VLTN_PRLS_AMT)
		cont.tblInfo1.SetCellString(3, 1, sWA_SMPL_ERT)
		cont.tblInfo1.SetCellString(4, 1, sACML_ERT)
		cont.tblInfo1.SetCellString(5, 1, sWA_TIMS_ACML_ERT)
		cont.tblInfo1.SetCellString(6, 1, sAMCL_INVT_AMT)
		cont.tblInfo1.SetCellString(7, 1, sOTCM_PAY_STND_AMT_VRSS_ERT)
	end if
End Sub

Sub f_SetInit()
	cont.lblName.visible = true
	cont.lblTitle0.visible = true
	cont.tblInfo0.visible = true
	cont.lblTitle1.visible = true
	cont.tblInfo1.visible = true
	cont.lblList.visible = true
	cont.imgToolTip0.visible = true
	cont.imgToolTip1.visible = true
	
	cont.lblName.caption = ""
	
	cont.tblInfo0.SetCellString(0, 1, "")
	cont.tblInfo0.SetCellString(1, 1, "")
	cont.tblInfo0.SetCellString(2, 1, "")
	cont.tblInfo0.SetCellString(3, 1, "")
	cont.tblInfo0.SetCellString(4, 1, "")
	cont.tblInfo0.SetCellString(5, 1, "")
	cont.tblInfo0.SetCellString(6, 1, "")
	
	cont.tblInfo1.SetCellString(0, 1, "")
	cont.tblInfo1.SetCellString(1, 1, "")
	cont.tblInfo1.SetCellString(2, 1, "")
	cont.tblInfo1.SetCellString(3, 1, "")
	cont.tblInfo1.SetCellString(4, 1, "")
	cont.tblInfo1.SetCellString(5, 1, "")
End Sub

Sub f_SetClear()
	cont.lblName.visible = false
	cont.lblTitle0.visible = false
	cont.tblInfo0.visible = false
	cont.lblTitle1.visible = false
	cont.tblInfo1.visible = false
	cont.lblList.visible = false
	cont.imgToolTip0.visible = false
	cont.imgToolTip1.visible = false
End Sub

'============================================================================
Sub cont_lblList_OnClick()
	Form.OpenScreen("71040", "")
End Sub

'============================================================================
Sub cont_imgToolTip0_OnClick()
	Dim sText
	sText = "회차 변경(계약만기로 인한 갱신)시 갱신시점의 평가금액이 새로운 투자금액이 됩니다."
	cont.imgToolTip0.openToolTip( sText, 300, 60, 2 )
End Sub

'============================================================================
Sub cont_imgToolTip1_OnClick()
	Dim sText
	sText = "운용성과는 운용개시시점부터 전일까지의 '시간가중평균수익률' 기준으로 제공됩니다."
	cont.imgToolTip1.openToolTip( sText, 300, 60, 1 )
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	cont.imgToolTip0.setMaintainingRatio("1")
	cont.imgToolTip1.setMaintainingRatio("1")
End Sub

