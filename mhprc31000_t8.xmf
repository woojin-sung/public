	<SCRIPT_INFO _len="6100" _ulen="5950" >
'----------------------------------------------------------------------------
' 01. 화 면 명 : 선옵현재가
' 02. 화면설명 : 선옵현재가 미결제약정별 탭화면
' 03. 작    성 : 2016.04.30 LJS
'----------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szItemCode, g_ItemMarket, g_szgrdHeader1, g_szgrdHeader2

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode =  Form.GetSharedData( "&ITEM_FUTOPT", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")	
	
	'20160705 NOHES START	MarketType Default : "F"로 결정
	if Len(Trim(g_szItemMarket)) = 0 Then
		g_szItemMarket = "F"			
	end if
	'20160705 NOHES END
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	grdDate.top = 191
	
	ChartEx0.SetAccrueName("미결제약정")	
	ChartEx0.SetPeriodType(0)			'0:틱, 1:분, 2:일자
	ChartEx0.setViewDataCount(-1)
	ChartEx0.SetLineColor("미결제약정;222;0;255");
	
'	rdoTimeDate_OnClick( 0 )
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	If sKey = "ITEMCODE" Then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

		'20160705 NOHES START	MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) = 0 Then
			g_szItemMarket = "F"	
		end if
		'20160705 NOHES END
		
		rdoTimeDate_OnClick( CInt( rdoTimeDate.currentindex ) )		
	end	if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	DATAMANAGER.CancelRealData( "ohhts_futs_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_optn_cntg" )
	
	If szTranID = "ohhts_3000_001r" Then
		DATAMANAGER.SetDataValue( 0, "ohhts_3000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3000_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)

	ElseIf szTranID = "ohhts_3000_008r" Then
		DATAMANAGER.SetDataValue( 0, "ohhts_3000_008r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3000_008r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
	
	ElseIf szTranID = "ohhts_3003_001r" Then
		DATAMANAGER.SetDataValue( 0, "ohhts_3003_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3003_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
		
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	
	If szTranID = "ohhts_futs_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	Else
		DATAMANAGER.SetDataValue( 1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "ohhts_3000_001r" Or "ohhts_3000_008r" Then
		
		If g_szItemMarket = "F" or g_szItemMarket = "MF" or g_szItemMarket = "XF" or g_szItemMarket = "KF" then '20180308_01 KBC : KRX300 & KSQ150상품추가	' 20240412 HSZ START: 코스닥글로벌지수 추가
			DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
		Else
			DATAMANAGER.RequestRealData( "ohhts_optn_cntg" )
			
		End if
	End If
	
End Sub

'============================================================================
Sub rdoTimeDate_OnClick(nIndex)
	If nIndex = 0 Then
		grdTime.visible = True
		grdDate.visible = False
		
		ChartEx0.SetPeriodType(0)
		
		DATAMANAGER.RequestTranData( "ohhts_3000_001r" )
		DATAMANAGER.RequestTranData( "ohhts_3003_001r" )
		
	Else
		grdTime.visible = False
		grdDate.visible = True
		
		ChartEx0.SetPeriodType(2)
		
		DATAMANAGER.RequestTranData( "ohhts_3000_008r" )
		
	End If
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
			Exit Sub
		End If
		
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		'20160705 NOHES START	MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) = 0 Then
			g_szItemMarket = "F"			
		end if
		'20160705 NOHES END
		
		rdoTimeDate_OnClick( CInt( rdoTimeDate.currentindex ) )
		
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	Dim szTime, szData
	szTime = ""
	szData = ""
	If szTranID = "ohhts_futs_cntg" then
		szTime = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_BSOP_HOUR" , 0 )
		szData = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_OTST_STPL_QTY" , 0 )
		
		ChartEx0.setInvestorRealData("미결제약정="&szTime&";"&szData)
	End If
	
	If szTranID = "ohhts_optn_cntg" then
		szTime = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_BSOP_HOUR" , 0 )
		szData = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_OTST_STPL_QTY" , 0 )		
		
		
		ChartEx0.setInvestorRealData("미결제약정="&szTime&";"&szData)
	End If
	
End Sub

	</SCRIPT_INFO>
