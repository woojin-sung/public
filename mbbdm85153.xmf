Sub Image1_OnClick()
	Form.OpenPopup("mbbdm85100_p9" , "" , "")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "mbbdm85100_p9_end" Then
		If sRet == "ok" Then
			'20210308 HWG START
			closeFlag = "2"
			Form.CloseForm()
			'20210308 HWG END
		End If	
	End If
	
End Sub 

