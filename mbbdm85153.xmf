'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 고객정보 입력-개별추가
' 02. 화면설명 : 고객정보 입력-개별추가
' 03. 작    성 : 2021.01.11 김유경
' 04. 수    정 :  
' 2021.06.09 : 정민영 : v0001 : T2102250017 : CFD차액결제시스템 구축
'            :        : obaci_acct_072r, obaci_acct_049c 변경IO 적용
' 2021.07.21 : 정민영 : v0002 : 비대면CFD개설 목표시장비교에 따른 obaci_acct_072r, obaci_acct_049c 변경IO 적용
' 2021.10.26 : 김수진 : v0003 : 비대면중개형ISA/ 해외CFD 상품추가에 따른 obaci_acct_072r, obaci_acct_049c 변경IO 적용
' 2021.01.25 : 김수진 : v0004 : 비대면국내/해외 CFD 계좌개설시_계좌 유형 선택 추가에 따른 obaci_acct_072r 변경IO 적용
' 2022.02.21 : 김수진 : v0005 : 국내/해외 CFD 계좌개설시_국가/계좌 유형 일괄개설 추가 > obaci_acct_049c,obaci_acct_072r 변경IO 적용
' 2022.04.05 : 김수진 : v0006 : 계약서류 제공방식 추가 obaci_acct_049c 변경IO 적용 
'-------------------------------------------------------------------------------------------

' 3단계 고객정보 입력값을 각 화면에서 체크 obaci_acct_049c 기본정보는 reg_stag_cls_code A
' 3단계 고객정보 입력값을 각 화면에서 체크 obaci_acct_049c 고객확인의무는 reg_stag_cls_code B

'****************************************************************************
' 			 		C O N T R O L 		I N F O
'****************************************************************************
' ContMain.Table0 : 고객정보 입력 (이름, 주민등록번호, 영문명)
'                   - 이름        : ContMain.EdtName
'                   - 주민등록번호: ContMain.EdtJumin
'                   - 영문명      : ContMain.EdtEngName
'****************************************************************************

'************************************************************************************************************
'getDataAcntopngclcd 1:종합개설 2:개별추가
'1: 종합개설(신규종합)
' 기본정보(고객정보-이름,주민번호,영문명)
' 고객확인의무(실제소유자 여부, 직업, 직종, 거래목적, 자금의원천)
'2:개별추가
' 기본정보(고객정보-이름,주민번호,영문명 / 주소지정보-주소, 상세주소, 거래내역통보, 우편물통보, 연락처 정보)
' 고객확인의무(실제소유자 여부, 직업, 직종, 거래목적, 자금의원천)
'************************************************************************************************************
Dim gRegUniqNo
Dim gPageID
DIm gRCNO
'obaci_acct_072r
Dim	g_CSNO
Dim	g_MangBrcd
Dim  g_sUserName
Dim  g_MaskRCNO

Dim closeFlag

Dim sRevData

Dim HP1
Dim HP2
Dim HP3

'3단계 입력값 체크
Dim getHopeAcno
Dim getAcntPwd
Dim getDataAcntopngclcd

Dim getDataName
Dim getDataEngname  
Dim getDataEmail     	'v0006 연락처 정보 이메일 추가   
Dim getHndvMthdCd		'v0006 계약서류 제공방식 추가
Dim getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE	'연금수익률통보처 유형코드
Dim getPRCD131

Dim g_OwhsDtad
Dim	g_CoDtad 

Dim g_BDM_CLEAR_YN
Dim g_bOnlyISA, g_bOnlyWrap
Dim g_szPnsnYn

'============================================================================
Sub Form_OnFormInit()

	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	Image1.imgpath = "icon_top_back_light"
	
	'*****************************************************
	'주의: init 했을 때 컨트롤 위치 셋팅 후 setApplyLabel
	'에디트 컨트롤 입력항목명 생성
	'*****************************************************
	ContMain.EdtName.setApplyLabel   ("이름" 	   , 0 , 268 , "left" , false)
	ContMain.EdtJumin.setApplyLabel  ("주민등록번호" , 0 , 268 , "left" , false)
	ContMain.EdtEngName.setApplyLabel("영문명"       , 0 , 268 , "left" , false)
	ContMain.edtPhone.setApplyLabel("휴대폰번호"   , 0 , 268 , "left" , true)	'v0006 연락처 정보 추가 : 휴대폰번호
	ContMain.edtEmail.setApplyLabel("이메일 주소"  , 0 , 268 , "left" , true)	'v0006 연락처 정보 추가 : 이메일
	
	'Default값 셋팅 후 비활성화 컨트롤: 컨트롤 속성에서 사용가능으로 체크한 후에 setApplyLabel 아래에서 enable = False
	ContMain.EdtName.enable  = False
	ContMain.EdtJumin.enable = False
	ContMain.edtPhone.enable = False	'v0006 휴대폰번호 비활성화 추가
	
'	sRevData = Form.GetOpenLinkData()
'	If sRevData == "StepBack" then
'		'컨트롤 모두보이기
'		ContMain.EdtName.visible    = true
'		ContMain.EdtJumin.visible   = true
'		ContMain.EdtEngName.visible = true		
'	End If 
	
	'help msg
	ContMain.EdtEngName.SetUseResultLabel(true,1)
	ContMain.edtEmail.SetUseResultLabel(true,1)		'v0006 Email help msg 추가
	ContMain.rdoProvision.SetUseResultLabel(true,2)	'v0006 계약서류 제공 help msg 추가
	ContMain.rdoPension.SetUseResultLabel(true,2)		'연금저축 help msg 추가
	
	'2021.03.16 주석처리
	'ContMain.SetScrollAutoSize()
	
	closeFlag = "0"
	
	'*****************************************************************************************
	' 데이터 셋팅
	'*****************************************************************************************
	gRegUniqNo = Form.GetSharedData("BDM_REG_UNIQ_NO", false ) '등록고유번호
	gRCNO      = Form.GetSharedData("BDM_RCNO_PIP"   , false ) '주민등록번호
	
	getHopeAcno = Form.GetSharedData( "BDM_ACNO"     , false )
	getAcntPwd  = Form.GetSharedData( "BDM_ACNT_PWD" , false )
	getDataAcntopngclcd  = Form.GetSharedData( "BDM_ACNTOPNGCLCD", false)
	
	gPageID    = "3" '화면단계 구분
	
	'v0006 STA : 휴대폰번호 셋팅
	HP1	 = Form.GetSharedData("BDM_HP1"	      , false ) '휴대폰번호
	HP2 	 = Form.GetSharedData("BDM_HP2"	      , false )
	HP3 	 = Form.GetSharedData("BDM_HP3"	      , false )
	ContMain.edtPhone.caption = HP1 & "-" & HP2  & "-" & HP3	
	'v0006 END
	
	'2021.04.15. 김유경. 이전화면 데이터 셋팅 추가
	'DATAMANAGER.RequestTranData("obaci_acct_072r")
	sRevData = Form.GetOpenLinkData()
	
	'이전 화면에서 돌아오면 컨트롤 모두보이기
	If sRevData == "StepBack" then
		
		Call GetSharedData_Setting()
		
		ContMain.Table0.visible     = true
		ContMain.EdtName.visible    = true
		ContMain.EdtJumin.visible   = true
		ContMain.EdtEngName.visible = true	
		'v0006 STA : 연락처 정보, 계약서류 제공 visible 설정
		ContMain.lblAddrInfo.visible = true	
		ContMain.edtPhone.visible 		= true	
		ContMain.edtEmail.visible 		= true	
		ContMain.lblProvision.visible 	= true	
		ContMain.rdoProvision.visible 	= true		
		'v0006 END
		
		'개설중인 계좌타입의 정보를 가져오기 위해 호출
		DATAMANAGER.RequestTranData("obaci_acct_072r_1")
		
		'입력한 정보 Setting
		ContMain.EdtName.caption    = getDataName
		ContMain.EdtJumin.caption   = Form.GetSharedData( "BDM_MaskRcno" , false)
		ContMain.EdtEngName.caption = getDataEngname
		ContMain.edtEmail.caption   = getDataEmail		'v0006 이메일주소 셋팅
		
		'v0006 STA 
		'계약서류 제공 방식 추가
		If getHndvMthdCd == "04" Then
			ContMain.rdoProvision.currentindex = "0"
		ElseIf getHndvMthdCd == "02" Then
			ContMain.rdoProvision.currentindex = "1"
		End If
		'v0007 END
		
		'연금수익률보고서 통보처 유형 추가
		If getPRCD131 == "Y" Then
			ContMain.lblPension.visible = true
			ContMain.rdoPension.visible = true
			If getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE == "99" Then
				ContMain.rdoPension.currentindex = "0"
			ElseIf getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE == "21" Then
				ContMain.rdoPension.currentindex = "1"
			ElseIf getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE == "01" Then
				ContMain.rdoPension.currentindex = "2"
			ElseIf getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE == "02" Then
				ContMain.rdoPension.currentindex = "3"
			End If
		End If
		
		
		BtnNext.visible = True 
		
	Else 
		'개설중인 계좌타입의 정보를 가져오기 위해 호출
		DATAMANAGER.RequestTranData("obaci_acct_072r_1")
		
		DATAMANAGER.RequestTranData("obaci_acct_072r")	
	End If 
	
	Form.SetTimerEvent(1, 1, 1)
	
End Sub

'============================================================================
Sub ContMain_EdtEngName_OnClick()
	'helpmsg Reset
	ContMain.EdtEngName.SetResultLabel("0", "", "", "", 1)
	'BtnNext.visible = True
End Sub

'============================================================================
Sub ContMain_EdtEngName_OnEditComplete()

	If Str_Chk(ContMain.EdtEngName.caption, "ENG_NAME") == False then		 
		'Form.MsgBox("알림", "고객영문명은 영문만 입력 가능합니다.", 0, 6)
		ContMain.EdtEngName.SetResultLabel("1", "error","고객영문명은 영문만입력 가능합니다.","ContMain")
		'ContMain.EdtEngName.caption = ""
		Exit Sub
	Else
		If LEN(TRIM(ContMain.EdtEngName.caption)) < 1 Then
			ContMain.EdtEngName.SetResultLabel("1", "error","영문명을 확인하시기 바랍니다.","ContMain")
			Exit Sub	
		End If
		
		ContMain.EdtEngName.SetResultLabel("0","complete","","ContMain")
	End If	
	
	'2022.04.05 계약서류 제공방식 선택 추가로 선택시 obaci_acct_049c 호출 
	'2021.04.05 obaci_acct_049c 입력값 체크 완료 시 다음버튼 활성화
	'BtnNext.visible = True	
	'DATAMANAGER.RequestTranData("obaci_acct_049c")
	
End Sub

'============================================================================
' 이메일 주소 입력선택 v0006
'============================================================================
Sub ContMain_edtEmail_OnClick()
	ContMain.edtEmail.SetResultLabel("0", "", "", "", 1)
	ContMain.edtEmail.SetUseResultLabel(true, 1)		'v0006 Email help msg 줄 수 설정
End Sub
'============================================================================
'이메일 주소 입력완료 v0006
'============================================================================
Sub ContMain_edtEmail_OnEditComplete()
	
	Dim szParam, szTail, szTailTemp, szTailDetail
	szParam  = ""
	szTail   = ""
	szTailTemp = ""
	szTailDetail = ""

	szParam = ContMain.edtEmail.caption
	
	If TRIM(szParam) == "" Then
		ContMain.edtEmail.SetResultLabel("1","error","이메일 주소를 입력해 주세요.","ContMain")
		Exit Sub	
	End If
	
	If LEN(TRIM(szParam)) > 0 Then 
		sTail = split(szParam, "@")
		
		If ubound(sTail) > 0 Then 
		
			'2021.05.01. 김유경. 개선사항 추가
			If Str_Chk_Email(ContMain.edtEmail.caption, "EMAIL") == False then	
				ContMain.edtEmail.SetResultLabel("1","error","이메일을 확인하세요.","ContMain")
				Exit Sub
			End If
	
			szTailTemp = sTail[1]
			szTailDetail = split(szTailTemp, ".")
			
			If szTailDetail[0] == "yahoo" or szTailDetail[0] == "hotmail" Then
				ContMain.edtEmail.SetUseResultLabel(true, 3)		'v0006 Email help msg 줄 수 설정
				ContMain.edtEmail.SetResultLabel("1", "error","야후코리아(yahoo.co.kr), 핫메일(hotmail.com)\n계정은 사용이 불가합니다.","ContMain", 3)
				ContMain.edtEmail.caption = ""				
				Exit Sub
			Else 
				ContMain.edtEmail.SetResultLabel("0","complete","","ContMain")
			End If
		End If
	End If
	
End Sub

'============================================================================
' 계약서류 제공 라디오 선택 v0006
'============================================================================
Sub ContMain_rdoProvision_OnClick(nIndex)
	If ContMain.rdoProvision.currentindex <> "-1" and ContMain.rdoProvision.currentindex <> -1 Then 
		'이메일 선택했을 경우 이메일 에디트 빈값이면 알럿 메시지 생성
		If ContMain.rdoProvision.currentindex == "1" or ContMain.rdoProvision.currentindex == 1 Then 	
			If TRIM(ContMain.edtEmail.caption) == "" Then  
				ContMain.edtEmail.SetResultLabel("0", "", "", "", 1)
				ContMain.edtEmail.SetUseResultLabel(true, 1)		'v0006 Email help msg 줄 수 설정
				Form.SetTimerEvent2(4, 1, 0.4)
			End If
		End If
		
		ContMain.rdoProvision.SetResultLabel("0","complete","","ContMain")
	End If
End Sub

'============================================================================
' 다음버튼 
'============================================================================
Sub BtnNext_OnClick()

	If LEN(TRIM(ContMain.EdtEngName.caption)) < 1 Then
		ContMain.EdtEngName.SetResultLabel("1", "error","영문명을 확인하시기 바랍니다.","ContMain",1)
		Exit Sub	
	Else
		SetSharedData()  '공유변수설정

		'v0006 다음버튼 선택시 유효성 체크 통과시 obaci_acct_049c 서비스 호출 > 다음페이지로 이동
		If f_chkDataFunction() == True Then
			DATAMANAGER.RequestTranData("obaci_acct_049c")
		End If
		'20210308 HWG START
'		closeFlag = "1"
'		Form.OpenNextPopup("mbbdm85151" , "" , "")
		'20210308 HWG END

	End If
	
End Sub

