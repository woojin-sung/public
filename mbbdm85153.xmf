Sub Form_OnFormClose()
	'화면닫기전 안드로이드-백버튼 작동Y 원복
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")	

	If closeFlag == "2" Then
		Form.OpenScreen( "41000" , "")
	End If
End Sub 

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	If sTimerID == "1" or sTimerID == 1 then
		
		'타이머중지
		Form.SetTimerEvent(sTimerID, 0, 0)
		
		If LEN(TRIM(ContMain.EdtEngName.caption)) <= 0 Then
			ContMain.EdtEngName.SetShowKeypad(true)		
		'2021.04.05 주석처리
'		Else
'			BtnNext.visible = True
		End If
		
	'v0006 STA : 계약서류 제공 이메일 선택 : 이메일 빈값일 경우
	ElseIf sTimerID == "4" or sTimerID == 4 then
		Form.SetTimerEvent2(sTimerID, 0, 0.4)
		
		If TRIM(ContMain.edtEmail.caption) = "" Then 
			ContMain.edtEmail.SetResultLabel("1","error","이메일 주소를 입력해 주세요.","ContMain")
			ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.edtEmail.top, "1")) 
		End If 
	'v0006 END
	End If

End Sub 

'===========================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obaci_acct_072r" Then
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"	 	 , 0 , gRCNO      )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE"     , 0 , "2"		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_UNIQ_NO"		 , 0 , gRegUniqNo	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_STAG_CLS_CODE" , 0 , gPageID	)
	
	Elseif szTranID = "obaci_acct_072r_1" Then
		Dim BDM_HP1, BDM_HP2, BDM_HP3
		BDM_HP1             	= Form.GetSharedData("BDM_HP1"                , false) '휴대폰번호
		BDM_HP2              	= Form.GetSharedData("BDM_HP2"                , false)
		BDM_HP3               	= Form.GetSharedData("BDM_HP3"                , false)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"	 	 , 0	  , gRCNO	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "WHOL_CPNO" 		 , 0   , BDM_HP1..BDM_HP2..BDM_HP3	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_UNIQ_NO"		 , 0   , gRegUniqNo 	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_STAG_CLS_CODE" , 0   , "2"		 	 	)	'2단계
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE"     , 0   , "2"			 	)	'단계별조회
		
	ElseIf szTranID = "obcsb_acif_809r" Then '기존고객정보조회
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 0, gRCNO)
	'2021.04.05 각 화면에서 입력값 체크하도록 수정
	ElseIf szTranId = "obaci_acct_049c" Then
		'공통-필수(InBlock1)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_UNIQ_NO" 		 , 0 , gRegUniqNo		) '등록고유번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_STAG_CLS_CODE" 	 , 0 , "A"	      	) '등록단계구분코드

		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "ACNT_OPNG_CLCD" 	 , 0 , getDataAcntopngclcd) '계좌개설구분코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "HOPE_ACNO" 		 , 0 , getHopeAcno	) '계좌번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "ACNT_PWD"   		 , 0 , getAcntPwd		) '계좌비밀번호
		
		'v0006 STA 
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CUST_ABWR_NAME" 	 , 0 , ContMain.EdtName.caption   ) '고객약어명
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CUST_ENG_NAME" 		 , 0 , ContMain.EdtEngName.caption) '고객영문명
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CLPH_ARCD" 		 , 0 , HP1	) '휴대폰지역번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CLPH_TONO" 		 , 0 , HP2	) '휴대폰국번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CPNO" 				 , 0 , HP3	) '휴대폰번호		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "EMAIL_ADDR" 		 , 0 , ContMain.EdtEmail.caption) '이메일주소
		
		If g_bOnlyISA then
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "HNDV_MTHD_CODE" 		 , 0 , ""			) '교부방식
		else
			If g_bOnlyWrap == False Or g_bOnlyISA == False Then
				If ContMain.rdoProvision.currentindex == "0" or ContMain.rdoProvision.currentindex == 0 Then
					DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "HNDV_MTHD_CODE" 		 , 0 , "04"			) '교부방식
				ElseIf ContMain.rdoProvision.currentindex == "1" or ContMain.rdoProvision.currentindex == 1 Then
				    DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "HNDV_MTHD_CODE" 		 , 0 , "02"			) '교부방식
				End If
			Else
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "HNDV_MTHD_CODE" 		 , 0 , ""			)
			End If
		End If

		'v0006 FIN
		
		'연금저축 추가
		'연금수익률보고서 통보처 유형코드
		If g_szPnsnYn == "Y" Then
			If ContMain.rdoPension.currentindex == "0" or ContMain.rdoPension.currentindex == 0 Then
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "PNSN_ERT_RPRT_INAG_TYPE_CODE" 		 , 0 , "99"  ) 
			ElseIf ContMain.rdoPension.currentindex == "1" or ContMain.rdoPension.currentindex == 1 Then
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "PNSN_ERT_RPRT_INAG_TYPE_CODE" 		 , 0 , "21"  ) 
			ElseIf ContMain.rdoPension.currentindex == "2" or ContMain.rdoPension.currentindex == 2 Then
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "PNSN_ERT_RPRT_INAG_TYPE_CODE" 		 , 0 , "01"  ) 
			ElseIf ContMain.rdoPension.currentindex == "3" or ContMain.rdoPension.currentindex == 3 Then
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "PNSN_ERT_RPRT_INAG_TYPE_CODE" 		 , 0 , "02"  ) 
			End If
		End If
	End If
End Sub
	
'===========================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	If szTranID = "obaci_acct_072r" Then

		g_sUserName	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "CUST_ABWR_NAME"  	  , 0)
		g_MaskRCNO	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "UI_RCNO"	     	  , 0)
		
		ContMain.EdtName.caption  = g_sUserName
		ContMain.EdtJumin.caption = g_MaskRCNO
		
		'기고객 유무 판단 TR 호출
		DATAMANAGER.RequestTranData("obcsb_acif_809r")
	
	ElseIf szTranID == "obaci_acct_072r_1" Then
		Dim szBDM_CLEAR_YN
		Dim szStockYn, szCmaYn, szFStockYn, szOptionYn, szOvdvYn, szIsaYn, szCfdYn, szAcfdYn, szIsaType, szPnsnYn, szWrapYn, sz365Yn
		
		szBDM_CLEAR_YN            = Form.GetSharedData("BDM_CLEAR_YN"           , False)  '이어하기여부
		
		'이어하기 없이 쭉 진행한 경우 정보를 Shared 값에서 가져옴
		If szBDM_CLEAR_YN == "Y" then
			szStockYn = Form.GetSharedData( "BDM_PRCD100", false )			'종합매매 가입여부
			szCmaYn = Form.GetSharedData( "BDM_PRCD118RP", false )          'CMA(증권형) 가입여부
			szFStockYn = Form.GetSharedData( "BDM_PRCD100F", false )        '종합매매(금상전용) 가입여부
			szOptionYn = Form.GetSharedData( "BDM_PRCD101", false )         '선물옵션 가입여부
			szOvdvYn = Form.GetSharedData( "BDM_PRCD135", false )           '해외파생 가입여부
			szIsaYn = Form.GetSharedData( "BDM_PRCD133", false )            'ISA 가입여부
			szCfdYn = Form.GetSharedData( "BDM_PRCDCFD", false )            'CFD 가입여부
			szAcfdYn = Form.GetSharedData( "BDM_PRCD137", false )			'해외 CFD 가입여부
			szIsaType = Form.GetSharedData( "BDM_ISA_PROD_TYPE", false )	'ISA 타입
			
			'연금저축, 랩 추가
			szPnsnYn = Form.GetSharedData( "BDM_PRCD131", false )			'연금저축 가입여부
			szWrapYn = Form.GetSharedData( "BDM_WRAP", false )			'랩 가입여부
			'슈퍼365 추가
			sz365Yn = Form.GetSharedData( "BDM_PRCD200", false )			'슈퍼365 가입여부
			
		'이어하기의 경우 072r에서 데이터 가져옴
		Else
			szStockYn = DATAMANAGER.GetDataValue( 0, "obaci_acct_072r_1" , "OutBlock5" , "OVTR_JOIN_APLT_YN" , 0 )			'종합매매 가입여부
			szCmaYn = DATAMANAGER.GetDataValue( 0, "obaci_acct_072r_1" , "OutBlock5" , "CMA_RP_JOIN_APLT_YN" , 0 )			'CMA(증권형) 가입여부
			szFStockYn = DATAMANAGER.GetDataValue( 0, "obaci_acct_072r_1" , "OutBlock5" , "OVTR_FNPR_JOIN_APLT_YN" , 0 )	'종합매매(금상전용) 가입여부
			szOptionYn = DATAMANAGER.GetDataValue( 0, "obaci_acct_072r_1" , "OutBlock5" , "FUTS_OPTN_ACNT_APLT_YN" , 0 )	'선물옵션 가입여부
			szOvdvYn = DATAMANAGER.GetDataValue( 0, "obaci_acct_072r_1" , "OutBlock5" , "OVDV_ACNT_APLT_YN" , 0 )			'해외파생 가입여부
			szIsaYn = DATAMANAGER.GetDataValue( 0, "obaci_acct_072r_1" , "OutBlock5" , "ISA_ACNT_APLT_YN" , 0 )			'ISA 가입여부
			szCfdYn = DATAMANAGER.GetDataValue( 0, "obaci_acct_072r_1" , "OutBlock5" , "DMST_CFD_ACNT_APLT_YN" , 0 )		'CFD 가입여부
			szAcfdYn = DATAMANAGER.GetDataValue( 0, "obaci_acct_072r_1" , "OutBlock5" , "OVRS_CFD_ACNT_APLT_YN" , 0 )		'해외 CFD 가입여부
			szIsaType = DATAMANAGER.GetDataValue( 0, "obaci_acct_072r_1" , "OutBlock5" , "ISA_PROD_TYPE_CLCD" , 0 )
			
			'연금저축, 랩 추가
			szPnsnYn = DATAMANAGER.GetDataValue( 0, "obaci_acct_072r_1" , "OutBlock5" , "PNSN_SVNG_ACNT_APLT_YN" , 0 )
			szWrapYn = DATAMANAGER.GetDataValue( 0, "obaci_acct_072r_1" , "OutBlock5" , "WRAP_ACNT_APLT_YN" , 0 )
			'슈퍼365 추가
			sz365Yn = DATAMANAGER.GetDataValue( 0, "obaci_acct_072r_1" , "OutBlock5" , "SAC_ACNT_APLT_YN" , 0 )
		End If
		
		g_szPnsnYn = szPnsnYn
		
		'일임형 ISA 하나만 추가개설 하는 경우
		If szStockYn == "N" and sz365Yn == "N" and szCmaYn == "N" and szFStockYn == "N" and szOptionYn == "N" and szOvdvYn == "N" and szCfdYn == "N" and szAcfdYn == "N" and szPnsnYn == "N" and szWrapYn == "N" and szIsaYn == "Y" Then
			If szIsaType == "2" Then
				'일임형ISA만 추가개설 할 경우 계약서류 영역 숨김 처리
				ContMain.lblProvision.visible = false
				ContMain.rdoProvision.visible = false
				
				g_bOnlyISA = true
				g_bOnlyWrap = false
			End If
			
		'랩 계좌 단독개설 케이스
		ElseIf szStockYn == "N" and sz365Yn == "N" and szCmaYn == "N" and szFStockYn == "N" and szOptionYn == "N" and szOvdvYn == "N" and szCfdYn == "N" and szAcfdYn == "N" and szPnsnYn == "N" and szWrapYn == "Y" and szIsaYn == "N" Then
			ContMain.lblProvision.visible = false
			ContMain.rdoProvision.visible = false
			
			g_bOnlyISA = false
			g_bOnlyWrap = true
			
		Else
			ContMain.lblProvision.visible = true
			ContMain.rdoProvision.visible = true
			
			g_bOnlyISA = false
			g_bOnlyWrap = false
			
			'연금수익률보고서 통보처
			If szPnsnYn == "Y" Then
				ContMain.lblPension.visible = true
				ContMain.rdoPension.visible = true
			End If
		End If
		
		
		
		
		
	ElseIf szTranID = "obcsb_acif_809r" Then
		
		bOLD 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "EXSN_CUST_YN"	, 0 ) '기존고객여부
		g_CSNO 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CSNO"		 	, 0 ) '고객번호
		s_CustEngName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "CUST_ENG_NAME"	, 0 ) '영문명
		szEmailAddr	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "EMAIL_ADDR" 		, 0 ) 'v0006 이메일 추가	
		
		g_CoDtad 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_CO_DTAD" 				, 0)
		g_OwhsDtad 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_OWHS_DTAD" 			, 0) 
		
		ContMain.EdtEngName.caption = s_CustEngName
		ContMain.edtEmail.caption = szEmailAddr	'v0006 이메일 추가
		
		'가져온 이메일이 yahoo 또는 hotmail 인지 체크
		If Cint(InStr(ContMain.edtEmail.caption, "@yahoo")) <> 0 Or Cint(InStr(ContMain.edtEmail.caption, "@hotmail")) <> 0 Then
			ContMain.EdtEmail.SetUseResultLabel(true, 3)		
			ContMain.EdtEmail.SetResultLabel("1", "error","야후코리아(yahoo.co.kr), 핫메일(hotmail.com)\n계정은 사용이 불가합니다.","ContMain", 3)	'v0007
'				ContMain.EdtEmail.caption = ""
		Else
			ContMain.EdtEmail.SetResultLabel("0", "", "", "", 1)
			ContMain.EdtEmail.SetUseResultLabel(true, 1)		
		End If
		
		If LEN(TRIM(ContMain.EdtEngName.caption)) > 0 Then
			ContMain.EdtEngName.enable = False
			'v0006 교부방식 추가
			'2021.04.05 obaci_acct_049c 입력값 체크 완료 시 다음버튼 활성화
			BtnNext.visible = True	
'			DATAMANAGER.RequestTranData("obaci_acct_049c")
		Else 
			ContMain.EdtEngName.enable = True
			BtnNext.visible = True
		End If		
	'2021.04.05 추가
	ElseIf szTranID = "obaci_acct_049c" Then
		'v0006 서비스 호출 완료 시 다음페이지로 이동
'		BtnNext.visible = True
		closeFlag = "1"
		Form.OpenNextPopup("mbbdm85151" , "" , "")
	End If
End Sub 

