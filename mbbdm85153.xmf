Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	Form.ShowAlert("알림", szErrMsg.."("..szSubErr..")" )
End Sub

'============================================================================
'SetSharedData
'============================================================================
Function SetSharedData()		
	Form.SetSharedData("BDM_MaskRcno" 		, g_MaskRCNO                	) '마스킹된 주민번호
	Form.SetSharedData("BDM_NAME"    		, ContMain.EdtName.caption    	) '이름
	Form.SetSharedData("BDM_RCNO"    		, gRCNO                       	) '주민등록번호
	Form.SetSharedData("BDM_ENGNAME" 		, ContMain.EdtEngName.caption 	) '영문명
	Form.SetSharedData("BDM_BACK_YN" 		, "N")
	Form.SetSharedData("BDM_ACNTOPNGCLCD" 	, "2"                    		) '계좌개설구분
	Form.SetSharedData("BDM_HP"           	, HP1 & HP2 & HP3        		) '휴대폰번호
	Form.SetSharedData("BDM_CLPHARCD"     	, HP1	     		    		)
	Form.SetSharedData("BDM_CLPHTONO"     	, HP2	                  	)
	Form.SetSharedData("BDM_CPNO" 	       	, HP3		             		)
	'v0006 STA : 이메일, 계약서류 제공방식 추가
	Form.SetSharedData( "BDM_EMAIL"        	, ContMain.EdtEmail.caption   	) '이메일주소
	If g_bOnlyISA then
		Form.SetSharedData( "BDM_HNDV_MTHD_CODE"	, ""              )
	Else
		If ContMain.rdoProvision.currentindex == "0" or ContMain.rdoProvision.currentindex == 0 Then
			Form.SetSharedData( "BDM_HNDV_MTHD_CODE"	, "04"              ) '계약서류 제공방식(알림톡/문자)
		ElseIf ContMain.rdoProvision.currentindex == "1" or ContMain.rdoProvision.currentindex == 1 Then
		     Form.SetSharedData( "BDM_HNDV_MTHD_CODE"	, "02"              ) '주소지정보(이메일)
		End If 
	End If
	'v0006 END
	
	'연금저축 추가
	'연금수익률보고서통보처 유형코드
	If g_szPnsnYn == "Y" Then
		If ContMain.rdoPension.currentindex == "0" or ContMain.rdoPension.currentindex == 0 Then
			Form.SetSharedData("BDM_PNSN_ERT_RPRT_INAG_TYPE_CODE" 	       	, "99"   )		'수신거부
		ElseIf ContMain.rdoPension.currentindex == "1" or ContMain.rdoPension.currentindex == 1 Then
			Form.SetSharedData("BDM_PNSN_ERT_RPRT_INAG_TYPE_CODE" 	       	, "21"   )		'이메일
		ElseIf ContMain.rdoPension.currentindex == "2" or ContMain.rdoPension.currentindex == 2 Then
			Form.SetSharedData("BDM_PNSN_ERT_RPRT_INAG_TYPE_CODE" 	       	, "01"   )		'자택
		ElseIf ContMain.rdoPension.currentindex == "3" or ContMain.rdoPension.currentindex == 3 Then
			Form.SetSharedData("BDM_PNSN_ERT_RPRT_INAG_TYPE_CODE" 	       	, "02"   )		'회사
		End If
	End If
End Function 

'============================================================================
Function Str_Chk(str, sGubn)
	dim i							'루프용 
	dim chk_n						'숫자 체크
	dim chk_c						'영문 체크
	dim chk_t						'특수 체크
    
	chk_n = 0 '숫자
	chk_c = 0 '영어
	chk_t = 0 '특수문자
    
	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))
	    '48~57 : 0~9
	    '65~90 : A~Z
	    '97~122: a~z
	    If nAscii >=48 and nAscii <=57 Then 
		    chk_n = 1 	
	    Elseif   (nAscii >=65 and nAscii <=90) or ( nAscii >=97 and nAscii <=122) Then
		    chk_c = 1 
	    Elseif   (nAscii >=33 and nAscii <=47) or ( nAscii >=58 and nAscii <=64)  or ( nAscii >=91 and nAscii <=96)  or ( nAscii >=123 and nAscii <=126) Then
		    chk_t = 1 
	    Else 
	        If nAscii <> 32 Then 'space	
			   return False
		   End If
	    End if 		    
	Next
    
	If sGubn == "ENG_NAME" then
		If chk_n == 1 Then  
			return False
		End if
		
	End if
	
	return True
End Function 

'============================================================================
' 이메일-한글체크 v0006
'============================================================================
Function Str_Chk_Email(str, sGubn)
	dim i				'루프용 
	dim chk_n, chk_c, chk_t
    
	chk_n = 0 '숫자
	chk_c = 0 '영어
	chk_t = 0 '특수문자
    
	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))
		
	    '48~57 : 0~9
	    '65~90 : A~Z
	    '97~122: a~z
		If nAscii >=48 and nAscii <=57 Then 
		    chk_n = 1 	
		Elseif   (nAscii >=65 and nAscii <=90) or ( nAscii >=97 and nAscii <=122) Then
		    chk_c = 1 
		Elseif   (nAscii >=33 and nAscii <=47) or ( nAscii >=58 and nAscii <=64)  or ( nAscii >=91 and nAscii <=96)  or ( nAscii >=123 and nAscii <=126) Then
		    chk_t = 1 
		Else 
		   If nAscii <> 32 Then 'space	
			   return False
		   End If
		End if 		    
	Next
	
	return True
End Function 

'============================================================================
' 입력 정보 체크 v0006
'============================================================================
Function f_chkDataFunction()
	'#이름 - 전단계에서 Setting 해주는 값이므로 help msg가 아니라 팝업
	If LEN(TRIM(ContMain.EdtName.caption)) < 0 Then
		Form.MsgBox("알림", "고객 정보를 정상적으로 읽지 못했습니다. 본인확인 절차로 돌아가십시오", "Exit", "2")  '2.예/아니오
		return False
	End If 

	'#주민등록번호 - 전단계에서 Setting 해주는 값이므로 help msg가 아니라 팝업
	If LEN(TRIM(ContMain.EdtEngName.caption)) < 0 Then
		Form.MsgBox("알림", "고객 정보를 정상적으로 읽지 못했습니다. 본인확인 절차로 돌아가십시오", "Exit", "2")  '2.예/아니오
		return False
	End If 
	
	'#영문명 - help msg 고객영문명을 확인하세요.
	If LEN(TRIM(ContMain.EdtEngName.caption)) < 0 Then
		ContMain.EdtEngName.SetResultLabel("1","error","고객영문명을 확인하세요.","ContMain")
		ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.EdtEngName.top, "1")) 
		return False
	Else 
		ContMain.EdtEngName.SetResultLabel("0","complete","","ContMain")
	End If
	
	'#이메일주소 - help msg 이메일주소을 확인하세요.
	If TRIM(ContMain.edtEmail.caption) == "" Then
		ContMain.edtEmail.SetResultLabel("1","error","이메일 주소를 입력해 주세요.","ContMain")
		ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.edtEmail.top, "1")) 
		return False
	Else 
		ContMain.edtEmail.SetResultLabel("0","complete","","ContMain")
	End If 	
	
	'#이메일주소 - 야후 또는 핫메일 사용불가
	If Cint(InStr(ContMain.edtEmail.caption, "@yahoo")) <> 0 Or Cint(InStr(ContMain.edtEmail.caption, "@hotmail")) <> 0 Then
		ContMain.EdtEmail.SetUseResultLabel(true, 3)		
		ContMain.EdtEmail.SetResultLabel("1", "error","야후코리아(yahoo.co.kr), 핫메일(hotmail.com)\n계정은 사용이 불가합니다.","ContMain", 3)	'v0007
		return False
	Else
		ContMain.EdtEmail.SetResultLabel("0","complete","","ContMain")
	End If
	
	'#교부방식 - help msg 계약서류 제공 방식법을 선택해주세요.
	'일임형 ISA 단독 추가개설이 아닌 경우에만 유효성 체크 
	If Not g_bOnlyISA And Not g_bOnlyWrap then
		If ContMain.rdoProvision.currentindex == "-1" or ContMain.rdoProvision.currentindex == -1 Then 
			ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.lblProvision.top, "1")) 
			ContMain.rdoProvision.SetResultLabel("1","error","계약서류 제공 방법을 선택해 주세요.","ContMain")
			return False
		Else
			ContMain.rdoProvision.SetResultLabel("0","complete","","ContMain")
		End If
	End If
	
	'#교부방식 - help msg 연금수익률보고서 통보처를 선택해주세요.
	If g_szPnsnYn == "Y" Then
		If ContMain.rdoPension.currentindex == "-1" or ContMain.rdoPension.currentindex == -1 Then 
			ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.lblPension.top, "1")) 
			ContMain.rdoPension.SetResultLabel("1","error","연금수익률보고서 통보처를 선택해 주세요.","ContMain")
			return False
		Else
			ContMain.rdoPension.SetResultLabel("0","complete","","ContMain")
		End If
	End If
	
	return True
End Function

'===========================================================================
' GetSharedData_Setting 고객정보 입력_기본정보 ( mbbdm85150/85151)
'===========================================================================
Function GetSharedData_Setting()
	getDataName          = Form.GetSharedData( "BDM_NAME"    			, false )
	getDataEngname       = Form.GetSharedData( "BDM_ENGNAME" 			, false )
	getDataEmail         = Form.GetSharedData( "BDM_EMAIL"   			, false )	'v0006 이메일 추가
	getHndvMthdCd        = Form.GetSharedData( "BDM_HNDV_MTHD_CODE"   	, false )	'v0006 계약서류 제공방식 추가
	
	'연금수익률보고서 통보처 유형코드 추가
	getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE = Form.GetSharedData( "BDM_PNSN_ERT_RPRT_INAG_TYPE_CODE"   	, false )
	getPRCD131 = Form.GetSharedData( "BDM_PRCD131"   	, false )
End Function	


'============================================================================
Sub ContMain_rdoPension_OnClick(nIndex)
	'선택한 통보지가 입력이 되어있는지 체크
	If nIndex == 1 Then		'이메일
		If TRIM(ContMain.edtEmail.caption) == "" or ContMain.edtEmail.caption == null Then  
			Form.OpenPopup("mbbdm85150_p3" , "1", "")
'			Form.ShowAlert("알림", "등록된 이메일 정보가 없습니다. 다른 통보처를 선택해주세요.")
			ContMain.rdoPension.currentindex = "-1"
			Exit Sub
		End If
	End If
	
	If nIndex == 2 Then	'자택주소
		If TRIM(g_OwhsDtad) == "" or g_OwhsDtad == null Then
			Form.OpenPopup("mbbdm85150_p3" , "2", "")
'			Form.ShowAlert("알림", "등록된 자택 정보가 없습니다. 다른 통보처를 선택해주세요.")
			ContMain.rdoPension.currentindex = "-1"
			Exit Sub
		End If 
	End If
	
	If nIndex == 3 Then	'직장주소
		If TRIM(g_CoDtad) == "" or g_CoDtad == null Then
			Form.OpenPopup("mbbdm85150_p3" , "3", "")
'			Form.ShowAlert("알림", "등록된 직장 정보가 없습니다. 다른 통보처를 선택해주세요.")
			ContMain.rdoPension.currentindex = "-1"
			Exit Sub
		End If 
	End If
	
	ContMain.rdoPension.SetResultLabel("0","complete","","ContMain")
End Sub

