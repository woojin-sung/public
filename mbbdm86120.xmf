'	End if
'	'v0004 fin
	
	'(종합계좌, CMA, 슈퍼365) 없이 (랩 계좌 또는 일임형 ISA 계좌) 선택했을시 체크
	if g_WRAPYN == "Y" or (g_ISAYN == "Y" and g_ISA_PROD_TYPE == "2") then
		if g_STOCKYN == "N" and g_CMAYN == "N" then 'and g_SAYN == "N" then
			Form.ShowAlert("안내", "출금 및 해지를 위한 별도 계좌가 필요합니다. 종합매매 또는 CMA를 같이 선택해주세요.")
			'if g_BDM_MANG_BRCD == "1065" then
			'	Form.ShowAlert("안내", "출금 및 해지를 위한 별도 계좌가 필요합니다. 슈퍼365(종합매매) 또는 CMA를 같이 선택해주세요.")
			'else
			'	Form.ShowAlert("안내", "출금 및 해지를 위한 별도 계좌가 필요합니다. 종합매매 또는 CMA를 같이 선택해주세요.")
			'end if
			exit sub
		end if
	end if
	
	User_SharedData_Set()
	
	'휴대폰인증 단계
	Form.OpenNextPopup("mbbdm86130", "", "")
End Sub
