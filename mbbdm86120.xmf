Sub Form_OnFormInitBefore()
	ContMain.ContSet.imgAcnt.setMaintainingRatio("1")
	ContMain.ContSet.imgAcnt0.setMaintainingRatio("1")
	ContMain.ContSub.Image1.setMaintainingRatio("1")
	ContMain.imgBanner.setMaintainingRatio("1")
	ContMain.imgIndi.setMaintainingRatio("1")
	Image2.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	
	'OSType 1.안드로이드 2.IOS 
	g_sz_OSType = Form.GetSharedData("&OS_TYPE", false)
	
	Form.triggerEvent("fmtabBanner.1" , "SetBanner", "super365_banner")
	Form.triggerEvent("fmtabBanner.2" , "SetBanner", "super365_banner_02")
	Form.triggerEvent("fmtabBanner.3" , "SetBanner", "super365_banner_03")
	ContMain.imgIndi.imgpath = "icon_3step1"
	
	if g_sz_OSType == "1" then
		ContMain.setScrollBarVisible("2")
		
		'안드 폼탭 자동 스크롤 생길때까지 기능 안씀
'		Form.SetTimerEvent(100, 1, 4)
		
'		ContMain.imgIndi.visible = false
'		ContMain.fmtabBanner.visible = false
'		ContMain.imgBanner.visible = true
	end if
'	else
'		ContMain.imgIndi.visible = true
'		ContMain.fmtabBanner.visible = true
'		ContMain.imgBanner.visible = false
		
		'20230526 자동스크롤 안하기로 했다고 함.
		'ContMain.fmtabBanner.SetAutoScroll(true, 3)
'	end if
	
	g_ChkDate = Form.GetSharedData("&HOST_DATE",0)	'v0011
	
	'v0014 
	g_CFD_OpenYn = "Y"
	'v0016 원복 20230901부터 CFD개설가능하도록함
'	if g_ChkDate == "20230531" then
'		g_CFD_OpenYn = "Y"
'	else
	if g_ChkDate == "20230831" then
		g_CFD_OpenYn = "N"	
	end if
		
	szTheme = Form.GetEnvData("common.theme")
	
	'g_nPrevFlag = 0 '2021-08-05 ksj 다음화면에서 넘어온경우 초기 플래그 셋팅
	
	g_bDrawSet1 = false
	g_bDrawSet2 = false
	
	ContMain.ContSub.Image0.imgpath = "btn_line_red_n.9"
	ContMain.ContSub.imgUnderA.imgpath = "btn_line_red_n.9"
	ContMain.ContSub.imgUnderB.imgpath = "btn_line_red_n.9"
