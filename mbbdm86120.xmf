'============================================================================
'DrawA 종합매매 선택시 화면 디자인
'============================================================================
Sub ContMain_ContSub_imgUnderA_OnClick()
	DrawA()
End Sub

Function DrawA()
	if g_BDM_MANG_BRCD == "1065" then
		if g_STOCKYN == "N" Then '미선택 -> 선택
			ContMain.ContSub.ImgUnderA.imgpath = "btn_line_red_o.9"
			ContMain.ContSub.chkA.chksilence = "1"
			ContMain.ContSub.LabelA.fontbold = true
			
			ContMain.ContSub.LabelA.bringFront("1")	 	
			
			g_STOCKYN = "Y"
			
			if g_BDM_MANG_BRCD == "1065" then
				ContMain.scroll_pos = 470 - 290
			else
				ContMain.scroll_pos = 370
			end if
		else 
			ContMain.ContSub.ImgUnderA.imgpath = "btn_line_red_n.9"
			ContMain.ContSub.chkA.chksilence = "0"
			ContMain.ContSub.LabelA.fontbold = false
			
			ContMain.ContSub.LabelA.bringFront("0")	 	
			
			g_STOCKYN = "N"
		end if
	else
		if g_bDrawSet1 or g_STOCKYN == "N" Then '선택 -> 미선택
			'v0013
'			if g_BDM_DREM_YN =="Y" and g_SAYN== "Y"  then
'				ShowAlert("안내","임직원 매매계좌는 1개만 보유 가능합니다.")
'				g_STOCKYN = "N"
'			else
				ContMain.ContSub.ImgUnderA.imgpath = "btn_line_red_o.9"
				ContMain.ContSub.chkA.chksilence = "1"
				ContMain.ContSub.LabelA.fontbold = true
				
				ContMain.ContSub.LabelA.bringFront("1")	 		
				
				'한번에 개설하기와는 같이 선택할 수 없기에 하는 처리
				ContMain.ContSet.imgSet1.imgpath = "bg_infobox_n.9"
				g_PNSNYN = "N"
				
				g_STOCKYN = "Y"
				
				if g_BDM_MANG_BRCD == "1065" then
					ContMain.scroll_pos = 470 - 290
				else
					ContMain.scroll_pos = 370
				end if
				
				g_bDrawSet1 = false
'			end if
		else 
			ContMain.ContSub.ImgUnderA.imgpath = "btn_line_red_n.9"
			ContMain.ContSub.chkA.chksilence = "0"
			ContMain.ContSub.LabelA.fontbold = false
			
			ContMain.ContSub.LabelA.bringFront("0")	 	
			
			g_STOCKYN = "N"
		end if
	end if
	
	Check_bnkOK()
	
End Function

