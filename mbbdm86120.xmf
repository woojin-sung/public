'============================================================================
Sub ContMain_ContSet_btnSet1_OnClick()
	DrawSet1()
End Sub

'============================================================================
'DrawSet1 한번에 선택하기(슈퍼365/중개형ISA Or 종합계좌/연금저추축) 선택시 화면 디자인
'============================================================================
Function DrawSet1()
'	if not g_bDrawSet1 then
		
		'두개만 선택해야 하므로 일단 다 초기화
		
		g_STOCKYN	="N"	 '종합매매(주식+금융상품)
		g_CMAYN		="N"	 'CMA
		g_FSTOCKYN	="N"	 '종합매매(금융상품전용)
		g_OPTNYN		="N"	 '선물옵션
		g_OVDVYN		="N"	 '해외파생
		g_ISAYN		="N"	 '일임형ISA
		g_CFDYN		="N"	 '국내 CFD 	
		'v0004 해외 CFD / 중개형 ISA 추가
		g_ACFDYN		="N"	 '해외 CFD 	
		g_ISA_PROD_TYPE	=""	 'ISA type
		'연금저축, 랩 추가
		g_PNSNYN		= "N"
		g_WRAPYN		= "N"
		g_SAYN		= "N"
		
		if g_BDM_MANG_BRCD == "1065" then
			if g_ISAYN == "Y" and g_ISA_PROD_TYPE == "2" then
				Form.ShowAlert("안내","중개형 ISA와 일임형 ISA는 동시 개설이 불가합니다.")
				exit function
			end if
			
			g_SAYN = "Y"
			g_ISAYN = "Y"
			g_ISA_PROD_TYPE = "3"
			
			'따로 한번에 개설하기와는 같이 선택할 수 없기에 하는 처리
			ContMain.ContSub.Image0.imgpath = "btn_line_red_n.9"
			ContMain.ContSub.chk0.chksilence = "0"
			ContMain.ContSub.Label0.fontbold = false
			
			ContMain.ContSub.Label0.bringFront("0")	 	
			
			ContMain.ContSub.imgUnderI.imgpath = "btn_line_red_n.9"
			ContMain.ContSub.chkI.chksilence = "0"
			ContMain.ContSub.LabelI.fontbold = false
			
			ContMain.ContSub.LabelI.bringFront("0")	 	
		else
			g_STOCKYN = "Y"
			g_PNSNYN = "Y"
			
			'따로 한번에 개설하기와는 같이 선택할 수 없기에 하는 처리
			ContMain.ContSub.ImgUnderA.imgpath = "btn_line_red_n.9"
			ContMain.ContSub.chkA.chksilence = "0"
			ContMain.ContSub.LabelA.fontbold = false
			
			ContMain.ContSub.LabelA.bringFront("0")	 	
			
			ContMain.ContSub.imgUnderK.imgpath = "btn_line_red_n.9"
			ContMain.ContSub.chkK.chksilence = "0"
			ContMain.ContSub.LabelK.fontbold = false
			
			ContMain.ContSub.LabelK.bringFront("0")	 	
		end if
		ContMain.ContSet.imgSet1.imgpath = "bg_infobox_o.9"
		g_bDrawSet1 = true
		
		Form.SetSharedData("BDM_PRCD_PACKAGE1"            , "Y")
		
		User_SharedData_Set()
	
		'휴대폰인증 단계
		Form.OpenNextPopup("mbbdm86130", "", "")
'	else
'		if g_BDM_MANG_BRCD == "1065" then
'			ContMain.ContSet.imgSet1.imgpath = "bg_infobox_n.9"
'			
'			g_SAYN = "N"
'			g_ISAYN = "N"
'			g_ISA_PROD_TYPE = ""
'		else
'			ContMain.ContSet.imgSet1.imgpath = "bg_infobox_n.9"
'			
'			g_STOCKYN = "N"
'			g_PNSNYN = ""
'		end if
'		g_bDrawSet1 = false
'	end if
'	
'	Check_bnkOK()
End Function

'============================================================================
Sub ContMain_ContSet_btnSet2_OnClick()

	'v0014 CFD신규개설중단관련 추가
	'--------------------------------------------------------------------------
	if g_CFD_OpenYn == "Y" then
		DrawSet2()
	else
		g_STOCKYN	="N"	 '종합매매(주식+금융상품)
		g_CMAYN		="N"	 'CMA
		g_FSTOCKYN	="N"	 '종합매매(금융상품전용)
		g_OPTNYN		="N"	 '선물옵션
		g_OVDVYN		="N"	 '해외파생
		g_ISAYN		="N"	 '일임형ISA
		g_CFDYN		="N"	 '국내 CFD 	
		'v0004 해외 CFD / 중개형 ISA 추가
		g_ACFDYN		="N"	 '해외 CFD 	
		g_ISA_PROD_TYPE	=""	 'ISA type
		'연금저축, 랩 추가
		g_PNSNYN		= "N"
		g_WRAPYN		= "N"
		g_SAYN		= "N"	
	
		Form.MsgBox("안내", "금융위원회 CFD 규제 보완방안에 따라 신규 규제 적용일(2023.06.01)이후 계좌개설이 제한됩니다. 양해 부탁 드립니다.", "CFD_OPEN_PAUSE", 6)
	end if
	'--------------------------------------------------------------------------
	
End Sub

