'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == 100 or sTimerID == "100" then
		if CInt(ContMain.fmtabBanner.currenttab) == 0 then
			ContMain.fmtabBanner.currenttab = "1"
			ContMain_fmtabBanner_OnTabChanged(1)
		elseif CInt(ContMain.fmtabBanner.currenttab) == 1 then
			ContMain.fmtabBanner.currenttab = "2"
			ContMain_fmtabBanner_OnTabChanged(2)
		else
			ContMain.fmtabBanner.currenttab = "0"
			ContMain_fmtabBanner_OnTabChanged(0)
		end if
	end if
End Sub

'============================================================================
Sub Image2_OnClick()
	'관리점 선택 단계로 돌아감
	Form.OpenNextPopup("mbbdm86110", "", "")
End Sub

'============================================================================
Sub ContMain_imgBanner_OnClick()
'	Form.SetSharedData("&SCREEN_AUTH", "")
	Form.OpenPopup("mbonl88031", "BDM", "")
End Sub

'============================================================================
Sub ContMain_fmtabBanner_OnTabChanged(nCurrentTab)
	if nCurrentTab == 0 then
		Form.triggerEvent("fmtabBanner." & ContMain.fmtabBanner.currenttabpageid , "SetBanner", "super365_banner")
		ContMain.imgIndi.imgpath = "icon_3step1"
	elseif nCurrentTab == 1 then
		Form.triggerEvent("fmtabBanner." & ContMain.fmtabBanner.currenttabpageid , "SetBanner", "super365_banner_02")
		Form.triggerEvent("fmtabBanner.3" , "SetBanner", "super365_banner_03")
		ContMain.imgIndi.imgpath = "icon_3step2"
	else
		Form.triggerEvent("fmtabBanner." & ContMain.fmtabBanner.currenttabpageid , "SetBanner", "super365_banner_03")
		ContMain.imgIndi.imgpath = "icon_3step3"
	end if
End Sub

