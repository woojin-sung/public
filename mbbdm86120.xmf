			ContMain.ContSub.chkG.chksilence = "0"
			ContMain.ContSub.LabelG.fontbold = false
			
			ContMain.ContSub.LabelG.bringFront("0")	 	
			
			g_CFDYN = "N"
		end if
	
		Check_bnkOK()
