Function DrawI()
	'v0008 로직변경
'	if g_BDM_ISA_ACNT_YN == "R"  or g_BDM_ISA_ACNT_YN == "B"  then
'		Form.ShowAlert("안내","기개설된 중개형 ISA 계좌가 존재하여, 추가개설이 불가합니다.")
'	'v0004 당사 ISA 상품 계약 여부 체크
'	'v0008 : ISA계좌개설구분코드(1:신규/2:이수)
'	'elseif g_BDM_ISA_ACNT_YN == "E" then
'	'	if  g_BDM_ISA_ACNT_OPNG_CLCD =  "1" then 
'	'		Form.ShowAlert("안내","일임형 ISA 계좌 보유시 중개형 ISA 신규개설이 불가합니다.")
'	'	end if	
'	else
		'v0004 일임형과 중개형 중복 선택 불가
		if g_ISA_PROD_TYPE = "2" Then
			Form.ShowAlert("안내","중개형 ISA와 일임형 ISA는 동시 개설이 불가합니다.")
			g_ISAYN = "Y"
		Else
			if (g_BDM_MANG_BRCD == "1065" and g_bDrawSet1) or g_ISAYN == "N" Then '미선택 -> 선택
'				ContMain.ContSub.imgUnderI.SetStatus("focus")
				ContMain.ContSub.imgUnderI.imgpath = "btn_line_red_o.9"
				ContMain.ContSub.chkI.chksilence = "1"
				ContMain.ContSub.LabelI.fontbold = true
				
				ContMain.ContSub.LabelI.bringFront("1")	 	
				
				if g_BDM_MANG_BRCD == "1065" and g_bDrawSet1 then
					'한번에 개설하기와는 같이 선택할 수 없기에 하는 처리
					ContMain.ContSet.imgSet1.imgpath = "bg_infobox_n.9"
					
					if g_bDrawSet1 then
						g_SAYN = "N"
					end if
					
					g_bDrawSet1 = false
				end if
				
				g_ISA_PROD_TYPE = "3"
				g_ISAYN = "Y"
				
				if g_BDM_MANG_BRCD == "1065" then
					ContMain.scroll_pos = 470 - 290
				else
					ContMain.scroll_pos = 370
				end if
			else 
'				ContMain.ContSub.imgUnderI.SetStatus("normal")
				ContMain.ContSub.imgUnderI.imgpath = "btn_line_red_n.9"
				ContMain.ContSub.chkI.chksilence = "0"
				ContMain.ContSub.LabelI.fontbold = false
				
				ContMain.ContSub.LabelI.bringFront("0")	 	
	
				g_ISA_PROD_TYPE = ""
				g_ISAYN = "N"
			end if
		end if
		
		Check_bnkOK()
'	end if
End Function

