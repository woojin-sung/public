	ContMain.ContSub.imgUnderJ.imgpath = "btn_line_red_n.9"
	ContMain.ContSub.imgUnderK.imgpath = "btn_line_red_n.9"
	
	btnOK.enable = false
	
	if szTheme = "black" then
		btnOK.btnimage	= "btn_27.9"
	else
		btnOK.btnimage	= "btn_21.9"
	end if
	
	btnOK.fgcolor		 = "269" 
	prodFlag =0		 '상품선택구분
	
	'공유변수 데이터GET JMY
	User_SharedData_Get()
	
	ContMain.ContSub.lblCnt.changeTextAttr(2, 1, 326, -2, false)
	
'	'주민등록번호 검사
'	If Len(g_BDM_RCNO_PIP) <= 0 then
'		ShowAlert "알림", "고객 정보를 정상적으로 읽지 못했습니다. 본인확인 절차로 돌아가십시오."
'		Exit Sub
'	End If
	
	'v0011
'	if g_chkYear == "2022" then
'		ContMain.ContSub.Label0.caption = "슈퍼365 (국내/해외주식 + RP자동투자)"
'	end if
	
	Dim szPackageYn1, szPackageYn2
	szPackageYn1 = Form.GetSharedData("BDM_PRCD_PACKAGE1", false)
	szPackageYn2 = Form.GetSharedData("BDM_PRCD_PACKAGE2", false)
	
	'관리점별로 
'	g_BDM_MANG_BRCD = "1065"
	if g_BDM_MANG_BRCD == "1065" then
		''디지털센터지점 선택시에만, 
		''[ContSet(한번에 개설하기) 영역 삭제 & ContSub(원하는 계좌 개설하기) : Super365 영역 확대하여 UI개선
		
'		ContMain.ContSet.lblTitle.caption = "Super365+중개형ISA"
'		'ContMain.ContSet.lblDetail.caption = "국내/해외 주식거래, RP자동투자\nISA계좌를 한번에 개설"
'		ContMain.ContSet.lblDetail.caption = "종합매매 + 예수금 RP 수익\nISA계좌를 한번에 개설"
'		ContMain.ContSet.imgAcnt.imgpath = "img_isa_money"

		ContMain.ContSet.visible = false
		
		ContMain.ContSub.top = 160
		
		ContMain.ContSub.Label2.visible = false
		ContMain.ContSub.Label5.caption = "원하는 계좌를 모두 선택하여 한번에 개설 할 수 있어요."
		ContMain.ContSub.Label5.top = 0
		
''		'슈퍼365 선택영역 위치세팅
''		ContMain.ContSub.Image0.left = 19
''		ContMain.ContSub.Image0.top = 78
