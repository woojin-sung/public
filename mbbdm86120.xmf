'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용
	Form.OpenNextPopup("mbbdm86110", "", "")
End Sub

'============================================================================
' 화면종료
'============================================================================
Sub Form_OnFormClose()
	'배너 폼탭 자동스크롤 해제
	if g_sz_OSType == "2" then
		ContMain.fmtabBanner.SetAutoScroll(false, 3)
	end if
	
	if g_Opng_File ~= "" or g_Opng_File ~= null then
		if g_Opng_File == g_BDM_FRST_MAPID then
			'진입점으로 돌아가능 경우, 공유변수 초기화
			User_SharedData_Set("Init")
		else
			User_SharedData_Set()
		end if
		
		'Form.OpenPopup(g_Opng_File, g_Send_Data , "")
	end if	
End Sub
'============================================================================
Function PrevStep()	 'JMY
	if g_Opng_File ~= "" or g_Opng_File ~= null then
		'공유변수 설정
		User_SharedData_Set("Init")
		
		Form.OpenNextPopup(g_Opng_File, g_Send_Data, "")
	end if
End Function

'============================================================================
Function NextStep()	 'JMY
	if g_Opng_File ~= "" or g_Opng_File ~= null then
		'공유변수 설정
		User_SharedData_Set()
		
		Form.OpenNextPopup(g_Opng_File, g_Send_Data, "")
	end if
End Function

