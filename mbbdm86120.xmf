'============================================================================
'DrawF 일임형ISA 선택시 화면 디자인
'============================================================================
Sub ContMain_ContSub_imgUnderF_OnClick()
	DrawF()
End Sub

Function DrawF()
	
	'v0008 중복개설 가능에 따른 체크사항 변경
'	if g_BDM_ISA_ACNT_YN == "E"  or g_BDM_ISA_ACNT_YN == "B"  then
'		Form.ShowAlert("안내","기개설된 일임형 ISA 계좌가 존재하여, 추가개설이 불가합니다.")
'	'v0004 당사 ISA 상품 계약 여부 체크
'	'v0008 체크로직 불필요
'	'elseif g_BDM_ISA_ACNT_YN =="R" then
'	'	Form.ShowAlert("안내","중개형 ISA 계좌 보유시 일임형 ISA 개설이 불가합니다.\n(ISA는 1인 1계좌만 가능)")
'	else		
		'v0004 일임형과 중개형 중복 선택 불가
		if g_ISA_PROD_TYPE == "3" Then
			Form.ShowAlert("안내","중개형 ISA와 일임형 ISA는 동시 개설이 불가합니다.")
			g_ISAYN = "Y"
		Else
			if g_ISAYN == "N" Then '미선택 -> 선택
'				ContMain.ContSub.imgUnderF.SetStatus("focus")
				ContMain.ContSub.ImgUnderF.imgpath = "btn_line_red_o.9"
				ContMain.ContSub.chkF.chksilence = "1"
				ContMain.ContSub.LabelF.fontbold = true
				
				ContMain.ContSub.LabelF.bringFront("1")	 	
				
				g_ISA_PROD_TYPE = "2"	'v0004 타입 설정
				g_ISAYN = "Y"
				
				if g_BDM_MANG_BRCD == "1065" then
					ContMain.scroll_pos = 470 - 290
				else
					ContMain.scroll_pos = 370
				end if
			else 
'				ContMain.ContSub.imgUnderF.SetStatus("normal")
				ContMain.ContSub.ImgUnderF.imgpath = "btn_line_red_n.9"
				ContMain.ContSub.chkF.chksilence = "0"
				ContMain.ContSub.LabelF.fontbold = false
				
				ContMain.ContSub.LabelF.bringFront("0")	 	 
	
				g_ISA_PROD_TYPE = ""	'v0004 타입 설정
				g_ISAYN = "N"
			end if
		end if
		
		Check_bnkOK()
'	end if
End Function


