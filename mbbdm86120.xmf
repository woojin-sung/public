'============================================================================
' 신청버튼 활성화 체크
'============================================================================
Sub Check_bnkOK()
	If g_CMAYN == "Y" or g_STOCKYN == "Y" or g_FSTOCKYN == "Y" or g_ISAYN == "Y" or g_OPTNYN == "Y" or g_OVDVYN == "Y" or g_CFDYN == "Y" or g_ACFDYN == "Y" or g_WRAPYN == "Y" or g_PNSNYN == "Y" or g_SAYN == "Y" then 
		btnOK.enable		= true
		btnOK.btnimage	= "btn_20.9"
		btnOK.fgcolor		= "273"
	else
		btnOK.enable 		= false
		if szTheme = "black" then
			btnOK.btnimage	= "btn_27.9"
		else
			btnOK.btnimage	= "btn_21.9"
		end if
		btnOK.fgcolor		= "269"
	end if
	
	f_SetCntDetail()
End Sub

'============================================================================
' 선택한 상품 수 및 상세설명 세팅
'============================================================================
Function f_SetCntDetail()
	Dim nCnt
	nCnt = 0
	ContMain.ContSub.grdText.SetClear()
	
	if g_BDM_MANG_BRCD == "1065" then
		if g_SAYN == "Y" then
			ContMain.ContSub.grdText.AddRow()
			ContMain.ContSub.grdText.SetCellData("bd_title", nCnt, "Super365")
	'			ContMain.ContSub.grdText.SetCellData("bd_text", nCnt, "디지털 전용 계좌로 RP자동투자와 주식(국내/해외), ELW, ETN, 펀드, 채권 등 종합적인 투자가 가능한 계좌입니다.")
	'			ContMain.ContSub.grdText.SetCellData("bd_text", nCnt, "국내주식뿐만 아니라 해외주식 거래를 위해 별도 서비스 신청을 하지 않아도 되며, RP자동투자, ELW, ETN, 펀드, 채권 등 종합적인 투자가 가능한 디지털 전용 계좌입니다.")
			'ContMain.ContSub.grdText.SetCellData("bd_text", nCnt, "국내 및 해외주식은 물론 ELW/ETN, 펀드, 채권 등 종합적인 투자가 가능하며 투자대기자금(예수금)은 매일 RP자동투자되어 별도 CMA 계좌가 필요없는 디지털 전용 계좌입니다.")
			ContMain.ContSub.grdText.SetCellData("bd_text", nCnt, "국내 및 해외주식은 물론 ELW/ETN, 펀드, 채권 등 종합적인 투자가 가능하며 투자대기자금(예수금)은 매일 RP 자동투자되는 디지털 전용 계좌입니다.")
