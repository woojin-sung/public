''		ContMain.ContSub.Label0.top = 78
''		ContMain.ContSub.chk0.left = 325
''		ContMain.ContSub.chk0.top = 87
		
		'슈퍼365 선택영역 위치세팅 재조정
		ContMain.ContSub.Image0.left = 19
		ContMain.ContSub.Image0.top = 40
		ContMain.ContSub.Image0.height = 76
		ContMain.ContSub.Label0.left = 40
		ContMain.ContSub.Label0.top = 45
		ContMain.ContSub.Label1.visible = true
		ContMain.ContSub.Label1.left = 40
		ContMain.ContSub.Label1.top = 70
		ContMain.ContSub.Image1.visible = true
		ContMain.ContSub.Image1.left = 230
		ContMain.ContSub.Image1.top = 38
		ContMain.ContSet.Image1.imgpath = "img_isa_money"
		ContMain.ContSub.chk0.left = 325
		ContMain.ContSub.chk0.top = 68
		
		
		'요건추가 : 디지털센터계좌는 랩 계좌 개설 숨김
		'랩 계좌 항목 숨기고 그 위치로 CMA 이동, 종합계좌는 기존 CMA 위치로 이동
		ContMain.ContSub.LabelJ.visible = false
		ContMain.ContSub.imgUnderJ.visible = false
		ContMain.ContSub.chkJ.visible = false
		
		ContMain.ContSub.imgUnderA.left = 20
		ContMain.ContSub.imgUnderA.top = 303 + 6
		ContMain.ContSub.LabelA.left = 40
		ContMain.ContSub.LabelA.top = 313 + 6
		ContMain.ContSub.chkA.left = 150
		ContMain.ContSub.chkA.top = 312 + 6
		
		ContMain.ContSub.imgUnderB.left = 20
		ContMain.ContSub.imgUnderB.top = 168 + 1
		ContMain.ContSub.LabelB.left = 40
		ContMain.ContSub.LabelB.top = 178 + 1
		ContMain.ContSub.chkB.left = 150
		ContMain.ContSub.chkB.top = 177 + 1
		
		
'		'한줄이 더 생기므로 기존의 종합매매, CMA 선택항목 및 컨트롤들 위치조정
'		ContMain.ContSub.imgUnderB.left = 20
'		ContMain.ContSub.imgUnderB.top = 303
'		ContMain.ContSub.LabelB.left = 40
'		ContMain.ContSub.LabelB.top = 313
'		ContMain.ContSub.chkB.left = 150
'		ContMain.ContSub.chkB.top = 312
		
'		ContMain.ContSub.imgUnderA.left = 193
'		ContMain.ContSub.imgUnderA.top = 303
'		ContMain.ContSub.LabelA.left = 213
'		ContMain.ContSub.LabelA.top = 313
'		ContMain.ContSub.chkA.left = 325
'		ContMain.ContSub.chkA.top = 312
		
		ContMain.ContSub.lblCnt.top = 364 + 17
		ContMain.ContSub.grdText.top = 434 + 17
	else
		ContMain.ContSet.visible = true
'		ContMain.ContSub.LabelA.caption = "종합계좌"
		
		ContMain.ContSet.lblTitle.caption = "종합매매+연금저축"
		ContMain.ContSet.lblDetail.caption = "국내/해외 주식거래와\n연금저축계좌를 한번에 개설"
		ContMain.ContSet.imgAcnt.imgpath = "img_save_pig"
		
		'영업점은 슈퍼365 배너 안보여줌
		ContMain.imgBanner.visible = false
		ContMain.fmtabBanner.visible = false
		ContMain.imgIndi.visible = false
		
		ContMain.Label10.top = 5
		ContMain.Label11.top = 32
		ContMain.ContSet.top = 70
		ContMain.ContSub.top = 370
	end if
	
	ContMain.Label11.changeTextAttr(0, 5, 4, 4, true)
	ContMain.Label11.setHighlight(332, 0, 5)
	
	ContMain.SetScrollAutoSize()
	
	sRevData = Form.GetOpenLinkData()
	'다음화면에서 넘어온 경우
	if sRevData == "StepBack" then 
		'한번에 선택하기 선택 케이스
		if szPackageYn1 == "Y" or szPackageYn2 == "Y" then
			g_STOCKYN	="N"	 '종합매매(주식+금융상품)
			g_CMAYN		="N"	 'CMA
			g_FSTOCKYN	="N"	 '종합매매(금융상품전용)
			g_OPTNYN		="N"	 '선물옵션
			g_OVDVYN		="N"	 '해외파생
			g_ISAYN		="N"	 '일임형ISA
			g_CFDYN		="N"	 '국내 CFD 	
			'v0004 해외 CFD / 중개형 ISA 추가
			g_ACFDYN		="N"	 '해외 CFD 	
			g_ISA_PROD_TYPE	=""	 'ISA type
			'연금저축, 랩 추가
			g_PNSNYN		= "N"
			g_WRAPYN		= "N"
			g_SAYN		= "N"
			
			Form.SetSharedData("BDM_PRCD_PACKAGE1"            , "")
			Form.SetSharedData("BDM_PRCD_PACKAGE2"            , "")
		end if
		
		If g_SAYN == "Y" Then
			g_SAYN = "N"
			Draw0()
		End If
		
		If g_STOCKYN == "Y" Then
			g_STOCKYN = "N" 
			DrawA()
		End If
	
		'CMAPlus/CMARp 신청여부
		If g_CMAYN == "Y" Then
			g_CMAYN = "N"
			DrawB()
		End If
	
		'종합매매-금융상품 신청여부
		If g_FSTOCKYN == "Y" Then
			g_FSTOCKYN = "N"
			DrawC()
		End If
	
		'선물옵션 신청여부 
		If g_OPTNYN == "Y" Then
			g_OPTNYN = "N"
			DrawD()
		End If
		
		'해외파생 신청여부
		If g_OVDVYN == "Y" Then
			g_OVDVYN = "N"
			DrawE()
		End If
			
		'ISA 신청여부
		'v0004 중개형 ISA 추가
		If g_ISAYN == "Y" Then
			g_ISAYN = "N"
			if g_ISA_PROD_TYPE == "2" Then
				DrawF()	'일임형 ISA
			else
				DrawI()	'중개형 ISA
			end if
			
		End If	
		
		'v0014 
		'국내 CFD 신청여부
		'g_nPrevFlag = 1 '2021-08-05 ksj 다음화면에서 넘어온경우 플래그 1로 설정
		if g_CFDYN == "Y" Then
			g_CFDYN = "N"
			DrawG()
		End if
		
		'v0014 
		'v0004 해외 CFD 
		'국내 CFD 신청여부
		if g_ACFDYN == "Y" Then
			g_ACFDYN = "N"
			DrawH()
		End if
		
		'연금저축 신청여부
		if g_PNSNYN == "Y" Then
			g_PNSNYN = "N"
			DrawK()
		End If
		
		'Wrap 신청여부
		If g_WRAPYN == "Y" Then
			g_WRAPYN = "N"
			DrawJ()
		End If
	else
	
		g_STOCKYN	="N"	 '종합매매(주식+금융상품)
		g_CMAYN		="N"	 'CMA
		g_FSTOCKYN	="N"	 '종합매매(금융상품전용)
		g_OPTNYN		="N"	 '선물옵션
		g_OVDVYN		="N"	 '해외파생
		g_ISAYN		="N"	 '일임형ISA
		g_CFDYN		="N"	 '국내 CFD 	
		'v0004 해외 CFD / 중개형 ISA 추가
		g_ACFDYN		="N"	 '해외 CFD 	
		g_ISA_PROD_TYPE	=""	 'ISA type
		'연금저축, 랩 추가
		g_PNSNYN		= "N"
		g_WRAPYN		= "N"
		g_SAYN		= "N"
	
'		DATAMANAGER.RequestTranData("obcsb_acif_809r") '비대면계좌개설  기존고객정보조회
	end if
	
	
	
End Sub

