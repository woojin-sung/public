<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrname="이체_출금계좌입력" version="2" writer="아이티젠" />
	<FORM_INFO name="GridBank" transmode="0" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<BUTTON name="BtnClose" btnimage="alpha" ly_vert="0,0,375,639,1" />
		<CONTAINER name="Container0" containerimage="popup_bg.9" scroll_pos="0,0" ly_vert="0,150,375,537,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<LABEL name="lblTitle" fontsize="4" fontstyle="01" caption="은행선택" bgcolor="064:188030030" halign="1" ly_vert="0,40,375,22,1" />
				<EDIT name="Edit0" fontsize="4" imetype="1" hintcaption="계좌번호를 입력해주세요." imagefilepth="input_03.9" ly_vert="20,152,335,74,1" />
				<LABEL name="Label0" fontsize="4" ly_vert="70,101,150,22,1" />
				<IMAGE name="Image0" autosize="1" ly_vert="20,97,30,30,1" />
				<IMAGE name="imgClose" autosize="1" imgpath="icon_close" ly_vert="331,20,24,24,1" />
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="2604" _ulen="2282" >
'============================================================================
' 01. 화 면 명 : 이체_입금기관(p3)
' 02. 화면설명 : 이체입금기관 선택팝업
' 03. 작    성 : 
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
'
'Dim g_tSecuNm()
'Dim g_tBankCd()
'Dim g_tSecuNm()
'Dim g_tSecuCd()

Dim szData

Dim g_Code
Dim g_Name
Dim g_ImageName

Dim g_close
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Form.imgpath = "alpha"
	
	szData     = Form.GetOpenLinkData() '기관명★기관코드
	stmp		  = Split(szData, "★")
	g_Name				   = stmp[0]
	g_Code				   = stmp[1]
	g_ImageName			   = stmp[2]
	
	Container0.Label0.caption = g_Name				   
	Container0.Image0.imgpath = g_ImageName
	
	Container0.Edit0.SetApplyLabel("계좌번호"   , 0 , 76 , "left",true)
	
	'TEST Code
	'Container0.Label0.caption ="교보증권"
	'g_Code = "261"
	'Container0.Image0.imgpath = "icon_bank_citi"
	
	
	
End Sub


'============================================================================
' imgClose_OnClick
'============================================================================
Sub Container0_imgClose_OnClick()
	g_close ="업무신청타기관취소"
	'Form.SendReturnToParent("업무신청타기관취소", "")   
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	g_close ="업무신청타기관취소"
'	Form.SendReturnToParent("업무신청타기관취소_cancle", "")   
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_Edit0_OnEditComplete()
	g_close ="업무신청타기관완료"
	'Form.SendReturnToParent("업무신청타기관완료_finish", szData &"★"& Container0.Edit0.caption)   '기관명★기관코드★계좌번호
	Form.CloseForm()
End Sub

Sub Form_OnFormClose()
	
	if g_close == "업무신청타기관취소" then
		Form.SendReturnToParent("업무신청타기관취소", "")   
	elseif g_close == "업무신청타기관완료" then
		Form.SendReturnToParent("업무신청타기관완료", g_Name &"★"& g_Code &"★"& Container0.Edit0.caption)   '기관명★기관코드★계좌번호
	end if
End Sub
	</SCRIPT_INFO>
</ROOT>