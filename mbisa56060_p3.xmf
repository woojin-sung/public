'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 가입신청
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.18 김은숙
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sSendData		'마지막 팝업화면으로 각 페이지의 입력 데이터 전달
Dim g_szList			'g_sSendData Split Array

'[Page1]
'g_szList(0)   : 계좌번호
'g_szList(1)   : 계좌일련번호
'g_szList(2)   : 비밀번호
'g_szList(3)   : 고객번호
'g_szList(4)   : 가입자유형 코드
'g_szList(5)   : 가입자유형 한글명
'g_szList(6)   : 연령
'g_szList(7)   : 동영상시청 날짜
'g_szList(8)   : 동영상시청 시각
'g_szList(9)   : 소득증명발급번호
'g_szList(10)  : 소득확인증명서번호
'g_szList(11)  : 자택주소
'g_szList(12)  : 회사주소
'g_szList(13)  : 연락처
'g_szList(14)  : 이메일주소
'g_szList(15)  : 서류제출방법 코드
'g_szList(16)  : 서류제출방법 한글명
'g_szList(17)  : 최소가입금액
'g_szList(18)  : buffer
'g_szList(19)  : buffer

'[Page2]
'g_szList(20)  : 투자성향 한글명
'g_szList(21)  : 상품(MP) 코드
'g_szList(22)  : 상품(MP) 한글명
'g_szList(23)  : buffer
'g_szList(24)  : buffer
'g_szList(25)  : 은행연합회 한도
'g_szList(26)  : ISA계약권유문서 클릭 시각
'g_szList(27)  : 개인종합자산관리계좌(일임형)약관 클릭 시각
'g_szList(28)  : MP설명서 클릭 시각
'g_szList(29)  : 투자성향진단 등급
'g_szList(30)  : buffer
'g_szList(31)  : buffer
'g_szList(32)  : buffer
'g_szList(33)  : buffer
'g_szList(34)  : buffer
'g_szList(35)  : buffer
'g_szList(36)  : buffer
'g_szList(37)  : buffer
'g_szList(38)  : buffer
'g_szList(39)  : buffer

'[Page3]
'g_szList(40)  : 계약금액
'g_szList(41)  : 만기처리방법 코드
'g_szList(42)  : 만기처리방법 한글명
'g_szList(43)  : 증권약정계좌 계좌번호
'g_szList(44)  : 증권약정계좌 일련번호
'g_szList(45)  : 보고서발송처 코드
'g_szList(46)  : 보고서발송처 한글명
'g_szList(47)  : 사전운용통지 코드
'g_szList(48)  : 사전운용통지 한글명
'g_szList(49)  : 계열사종목(운용/제한) 코드
'g_szList(50)  : 계열사종목(운용/제한) 한글명
'g_szList(51)  : 목표수익률
'g_szList(52)  : 손절수익률
'g_szList(53)  : 계약자확인사항 클릭 시각
'g_szList(54)  : 계약서수령방법 코드
'g_szList(55)  : 계약서수령방법 한글명
'g_szList(56)  : buffer
'g_szList(57)  : buffer
'g_szList(58)  : buffer
'g_szList(59)  : buffer


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub SetTableData()
	'의무기간
	Dim sPeriod
	
	If g_szList(4) == "66" then		'일반형
		sPeriod = "60"
	ElseIf g_szList(4) == "67" then	'청년형
		sPeriod = "36"
	ElseIf g_szList(4) == "73" then	'서민형
		sPeriod = "36"
	End If
	cont0.tbl0.SetCellString( 8, 1, sPeriod)			
	
	cont0.tbl0.SetCellString( 0, 1, g_szList(0) & g_szList(1))	'신청계좌번호
	cont0.tbl0.SetCellString( 1, 1, g_szList(5))				'가입자유형
	cont0.tbl0.SetCellString( 2, 1, g_szList(6))				'연령
	cont0.tbl0.SetCellString( 3, 1, g_szList(20))				'투자성향
	cont0.tbl0.SetCellString( 4, 1, g_szList(22))				'상품명
	cont0.tbl0.SetCellString( 6, 1, g_szList(40))				'계약금액
	cont0.tbl0.SetCellString( 9, 1, g_szList(42))				'만기처리
	cont0.tbl0.SetCellString( 10, 1, g_szList(46))			'보고서발송처
	cont0.tbl0.SetCellString( 11, 1, g_szList(55))			'계약서수령방법
	cont0.tbl0.SetCellString( 12, 1, g_szList(48))			'사전운용통지
	cont0.tbl0.SetCellString( 13, 1, g_szList(51))			'목표수익률
	cont0.tbl0.SetCellString( 14, 1, g_szList(52))			'손절수익률
	cont0.tbl0.SetCellString( 15, 1, g_szList(50))			'계열사종목
End Sub

'============================================================================
Function ValidateCheck()
	If cont0.chk0.checkstate <> "1" then
		Form.ShowAlert("알림", "가입자 필수 안내사항을 확인해주세요.")
		return False
	End If
	
	If cont0.chk1.checkstate <> "1" then
		Form.ShowAlert("알림", "가입자 서류제출 확인사항을 확인해주세요.")
		return False
	End If
	
	return True
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("가입신청")
	
	g_sSendData = Form.GetOpenLinkData()
	g_szList = Split(g_sSendData,"★")		

	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	DATAMANAGER.RequestTranData("obwat_csad_003r")	
	Call SetTableData()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "mbisa56060_p9" then
		If sRet == "ok" then
			cont0.chk1.checkstate = "1"
		Else
			cont0.chk1.checkstate = "0"
		End If
	End If
	
	If sKeyName == "mhetc90060_p5" then
		If Left(sRet,2) == "ok" then
			DATAMANAGER.RequestTranData("obwat_ctad_038a")
		End If
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "Close" then
		If sRet == "ok" then
			Form.OpenScreen("56050" , "")
		End If
	End If
End Sub

'============================================================================
'가입자안내사항
Sub cont0_chk0_OnChange(sCheckState)
	Call cont0_btnDetail0_OnClick()
End Sub

'============================================================================
'가입자안내사항_내용보기
Sub cont0_btnDetail0_OnClick()
	cont0.chk0.checkstate = "1"
	
	Dim nType
	nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	if nType == "0" then
		Form.OpenPdfViewer( "http://home.imeritz.com/include/resource/htsdown/PDF/mts_isa_1.pdf", "")	'운영계 주소
	elseif nType == "1" then
		Form.OpenPdfViewer( "http://211.255.202.106/include/resource/htsdown/PDF/mts_isa_1.pdf", "")	'테스트계주소
	end if	
End Sub

'============================================================================
'가입자 서류제출 확인사항_내용보기
Sub cont0_btnDetail1_OnClick()
	Form.OpenFramePopup( "mbisa56060_p9" , g_szList(16) , "")
End Sub

'============================================================================
'가입자 서류제출 확인사항
Sub cont0_chk1_OnChange(sCheckState)
	cont0_btnDetail1_OnClick()
End Sub

'============================================================================
Sub cont0_btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'가입신청 버튼
Sub cont0_btnOK_OnClick()
	If ValidateCheck() == False then
		Exit Sub
	End If
	
	Form.OpenFramePopup( "mhetc90060_p5" , "" , "")	'공인인증서 비밀번호 입력
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obwat_csad_003r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_PRCD" , 0 , g_szList(21))	'랩상품코드
	End If
	
	If szTranID == "obwat_ctad_038a" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , g_szList(0))		'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , g_szList(1))		'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PWD"  , 0 , g_szList(2))		'비밀번호
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "FRST_CNRC_AMT"               , 0 , g_szList(40))			'계약금액
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "JOIN_TYPE_CODE"              , 0 , g_szList(4))				'가입자구분
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "LNKD_ACNO"                   , 0 , g_szList(43))			'약정계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "LNKD_ASNO"                   , 0 , g_szList(44))			'약정계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "PIC_WAT_YN"                  , 0 , "Y")					'동영상시청여부
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "PIC_WAT_DATE"                , 0 , g_szList(7))				'동영상시청일자
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "PIC_WAT_TIME"                , 0 , g_szList(8))				'동영상시청시각
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "KEYN_HOUR"                   , 0 , g_szList(8))				'키인시간(동영상시청시각)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "WA_PRCD"                     , 0 , g_szList(21))			'상품코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ATMT_CANC_YN"                , 0 , g_szList(41))			'만기처리
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "SNML_INAG_TYPE_CODE"         , 0 , g_szList(45))			'보고서발송처
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ASET_RE_DSTR_PRIR_NTFY_CLCD" , 0 , g_szList(47))			'사전운용통지발송처
		
		If g_szList(51) == "" then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "WA_GOAL_ERT"             , 0 , "0.00")					'목표수익률	
		Else
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "WA_GOAL_ERT"             , 0 , CDbl(g_szList(51))/100)	'목표수익률
		End If
		
		If g_szList(52) == "" then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "LOSS_LIMT_RATE"          , 0 , "0.00")					'손절수익률
		Else
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "LOSS_LIMT_RATE"          , 0 , CDbl(g_szList(52))/100)	'손절수익률
		End If
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "WA_AFCO_LIST_INVT_YN"        , 0 , g_szList(49))			'계열사종목
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "DOCU_SBMS_MTHD_CLCD"         , 0 , g_szList(15))			'서류제출방법
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ELCT_DOCU_HNDV_HOUR"         , 0 , g_szList(26))			'ISA계약권유문서 교부일시
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ELCT_DOCU_HNDV_HOUR1"        , 0 , g_szList(27))			'ISA약관 교부일시
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ELCT_DOCU_HNDV_HOUR2"        , 0 , g_szList(28))			'MP설명서 교부일시
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ELCT_DOCU_HNDV_HOUR3"        , 0 , g_szList(53))			'가입자확인사항 입력일시
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "INCM_CRTC_ISNC_NO"           , 0 , g_szList(9))				'소득증명발급번호
