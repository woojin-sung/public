'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obwat_csad_003r" then
		Dim sRiskCode, sRiskText
		
		sRiskCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WA_PROD_RISK_CLCD" , 0)	
		Select Case sRiskCode
			Case "01"
				sRiskText = "초고위험"
			Case "02"
				sRiskText = "고위험"
			Case "03"
				sRiskText = "중위험"
			Case "04"
				sRiskText = "저위험"
			Case "05"
				sRiskText = "초저위험"
		End Select
		
		cont0.tbl0.SetCellString( 5, 1, sRiskText)				'위험등급		
	End If
	
	If szTranID == "obwat_ctad_038a" then
		Form.MsgBox("알림" , "ISA 가입신청이 완료되었습니다. 가입진행상태조회 화면으로 이동하시겠습니까?", "Close", "2")
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

