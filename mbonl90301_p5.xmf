	<SCRIPT_INFO _len="3026" _ulen="2686" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 장외채권 상품 목록 조회
' 02. 화면설명 : 장외채권 상품 목록 간단필터 팝업
'                

' 03. 이    력 : 
' - 2023.11.01 : 윤혁 : v0001 : 신규개발


'-------------------------------------------------------------------------------------------
'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_szLinkData, g_szList
Dim g_ACNo, g_ASNo, g_szSymbolCode

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************



'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_szLinkData = Form.GetOpenLinkData()
	
'	Form.ShowAlert("90301_p5_FormInit", g_szLinkData)

	if g_szLinkData == "" or g_szLinkData == null then
		Exit Sub
	end if 
	
	g_szList = split(g_szLinkData, "|")
	'0 매매구분코드
	'1 상품유형코드
	'2 종목코드
	'3 종목명
	'4 채권분류명
	'5 매수일자
	'6 만기일자
	'7 수량
	'8 단가
	'9 매매금액
	'10 거래일자
	'11 거래일련번호
	'12 매수수익률
	'13 수수료수익금액
	'14 제세금금액
	'15 주문처리결과구분코드
	'16 취소여부
	'17 계좌번호+이름
	
	cont1.tbl2.SetCellString(0, 1, g_szList(17))	'계좌번호
	cont1.tbl2.SetCellString(1, 1, g_szList(3))	'상품명
	
	if g_szList(1) == "12" then
		cont1.tbl2.SetCellString(2, 1, "단기사채")	'상품분류
	else
		cont1.tbl2.SetCellString(2, 1, g_szList(4))	'상품분류
	end if
	
	cont1.tbl2.SetCellString(3, 1, g_szList(7))	'수량	
	cont1.tbl2.SetCellString(4, 1, g_szList(8))	'가격
	cont1.tbl2.SetCellString(5, 1, g_szList(13))	'수수료
	cont1.tbl2.SetCellString(6, 1, g_szList(14))	'제세금		
	cont1.tbl2.SetCellString(7, 1, g_szList(9))	'결제금액
'	cont1.tbl2.SetCellString(5, 1, g_szList(12))	'매수수익률
	cont1.tbl2.SetCellString(8, 1, g_szList(5))	'매매일
	cont1.tbl2.SetCellString(9, 1, g_szList(6))	'만기일
	
End Sub

'============================================================================
Sub imgDim_OnClick()
	Form.CloseForm("")
End Sub

'============================================================================
Sub Container0_btnOK_OnClick()
	Dim szData
	
	
	Form.SendReturnToParent("SEARCH_DATE" , szData)
	Form.CloseForm()
End Sub


'============================================================================
Sub cont1_btnOK_OnClick()
	Form.CloseForm()
End Sub

