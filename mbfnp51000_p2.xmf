'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obcsb_acif_799r" then 
		dim szCust_Num	'고객번호
		szCust_Num = Form.GetSharedData("&CUST_NUM", false )
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , szCust_Num)
'
	elseif	szTranID	=	"oocwi_mall_003r"	then
		DATAMANAGER.SetDataValue(0, "oocwi_mall_003r", "InBlock1", "ISCD", 0, g_szStndCd)
	
		tab01.page004379.Container4.ChartEx3T5.SetAccrueName(" ,updown")
		tab01.page004379.Container4.ChartEx4T5.SetAccrueName(" ,updown")
		
	elseif	szTranID	=	"oocwi_gfnv_003r"	then
		DATAMANAGER.SetDataValue(0, "oocwi_gfnv_003r", "InBlock1", "UI_SALE_YN", 0, "Y")
		DATAMANAGER.SetDataValue(0, "oocwi_gfnv_003r", "InBlock1", "ISCD", 0, g_szShortCd)
		DATAMANAGER.SetDataValue(0, "oocwi_gfnv_003r", "InBlock1", "SCTY_FNCD", 0, g_szStcyFnCd)
		
	elseif	szTranID	=	"obsim_idmn_018r"	then				'종목집투기본정보조회
		DATAMANAGER.SetDataValue(0, "obsim_idmn_018r", "InBlock1", "ISCD", 0, g_szShortCd)
		
	elseif	szTranID	=	"oocwi_mall_002r"	then
		DATAMANAGER.ClearInputData(0, "oocwi_mall_002r")
		DATAMANAGER.SetDataValue(0, "oocwi_mall_002r", "InBlock1", "PROS_CLS_CODE", 0 , "2")
		
	elseif	szTranID	=	"obsim_idmn_088r"	then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD", 0, g_szShortCd)
		
'	elseif	szTranID	=	"obcsb_acif_700r"	then			'투자성향등급조회
'		g_szBswr = "01"	''펀드매매
'		g_szDiv	=	"01010"	'신규매수		'g_szDiv	=	"13005"	'추가매수
'		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "ACNO"				, 0, Account0.total)
'		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "ASNO"				, 0, Account0.sequence)
'		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "KYC_BSWR_DIV_CODE"	, 0, g_szBswr)	
'		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "BSWR_DIV_CODE"		, 0, g_szDiv)
'		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "ISCD"				, 0, g_szShortCd)	
	
	'매매처리 사전 체크
	elseif szTranID = "obsai_deal_700r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE", 		0, "2")  			'1:매도, 2:매수
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 				0, Account0.total)	'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 				0, Account0.sequence)	'계좌일련번호
		'DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RMND_SRNO", 			0, "")			'잔고일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD", 				0, g_szShortCd)		'종목코드
			
	
	end if
	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	szGradCode,	szTotalStup , szZiGradCode
	dim	szTitle
	dim	szOrgBuyInfo, szOrgSellInfo, szOrgHour
	dim	szListT201,	szListT202
	dim	nOut16Cnt,	szIn16DataName,	szIn16DataVal
	dim	nOut10Cnt,	szIn10DataName,	szIn10DataVal		'자산탭주식막대
	dim	nOut12Cnt,	szIn12DataName,	szIn12DataVal		'자산탭채권막대
	dim	bIsmore
	
	dim	szAbleYN 	 
	dim	szErrCode 
	dim	szErrMsg	 


	nOut10Cnt	=	0   
	szIn10DataName	=	""   
	szIn10DataVal		=	""
	
	nOut16Cnt	=	0   
	szIn16DataName	=	""   
	szIn16DataVal		=	""
	
	nOut12Cnt	=	0
	szIn12DataName	=	""   
	szIn12DataVal		=	""
	bIsmore			= false
	
	szTitle		=	""
	
		'---------------------------------------
		'KYC전문투자자여부
		'---------------------------------------		
		if szTranID == "obcsb_acif_799r" then
			g_KYC_SPCL_INVR_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "KYC_SPCL_INVR_YN", 0)	'KYC전문투자자여부
			
			
		'---------------------------------------
		'상단 기준가 세팅
		'---------------------------------------		
		elseif	szTranID	=	"oocwi_mall_003r"	then
		     'scroll_pos = "top"
		    'Main 상단
	    	    if	DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "SDPR_ICDC_AMT", 0) 	>	"0"	then
			    nStaOffset = lblFluctAmt.getLen(cdbl(lblPrc.Caption))
			    nStaOffset2 = lblFluctAmt.getLen(cdbl(lblFluctAmt.caption)) + 2
			    lblPrcStr.caption	=	formatnumber(lblPrc.Caption, 2) & "▲ " & cdbl(lblFluctAmt.caption)
			    lblPrcStr.changeTextAttr(nStaOffset, nStaOffset2, 290, -4, true)
		
			    lblFluctBit.caption = "▲ "
'			    lblPrc.fgcolor 	= "10"
			    lblPrcStr.fgcolor	= "10"
			    lblFluctAmt.fgcolor	= "10"
			    lblFluctBit.fgcolor	= "10"
		    elseif	DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "SDPR_ICDC_AMT", 0) 	<	"0"	then
			    nStaOffset = lblFluctAmt.getLen(cdbl(lblFluctAmt.caption)) + 3	
			    nStaOffset2 = lblFluctAmt.getLen(cdbl(lblFluctAmt.caption)) + 2
			    lblPrcStr.caption	=	formatnumber(lblPrc.Caption, 2) & "▼ " & cdbl(lblFluctAmt.caption)
			    lblPrcStr.changeTextAttr(nStaOffset, nStaOffset2, 290, -4, true)
				
			    lblFluctBit.caption = "▼ "
'			    lblPrc.fgcolor 	= "11"
			    lblPrcStr.fgcolor	= "11"
			    lblFluctAmt.fgcolor	= "11"
			    lblFluctBit.fgcolor	= "11"
		    else
			    nStaOffset = lblFluctAmt.getLen(cdbl(lblFluctAmt.caption)) + 3	
			    nStaOffset2 = lblFluctAmt.getLen(cdbl(lblFluctAmt.caption)) + 2
			    lblPrcStr.caption	=	formatnumber(lblPrc.Caption, 2) & cdbl(lblFluctAmt.caption)
			    lblPrcStr.changeTextAttr(nStaOffset, nStaOffset2, 290, -4, true)
				
'			    lblPrc.fgcolor 	= "12"
			    lblPrcStr.fgcolor	= "12"
			    lblFluctAmt.fgcolor	= "11"
			    lblFluctBit.fgcolor	= "12"
		    end if
		    
		    
		    '펀드정보
		    szGradCode = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "PROD_GRAD_CODE", 0) 	'상품등급코드
		    szZiGradCode = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "ZI_FUND_GRAD", 0) 	'상품등급코드
		    szTransGradNm = Form.GetMetaData("집합투자증권상품등급코드", szGradCode)
		    lblRiskNm.caption = szTransGradNm
		    'lblRiskNm.fgcolor = 261
'		    tab01.page002304.Container1.tblT101.SetCellString(0, 2, szTransGradNm)
		    
'		    grd01T1.SetCellFgColor("bd_grade", i, 261)
'			if szGradCode = "01" then
'				ImgBadge1.imgpath = "img_bgsquare_grade_296.png"
''				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_296.png")
'			elseif szGradCode = "02" then
'				ImgBadge1.imgpath = "img_bgsquare_grade_297.png"
''				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_297.png")
'			elseif szGradCode = "03" then
'				ImgBadge1.imgpath = "img_bgsquare_grade_298.png"
''				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_298.png")
'			elseif szGradCode = "04" then
'				ImgBadge1.imgpath = "img_bgsquare_grade_299.png"
''				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_299.png")
'			elseif szGradCode = "05" then
'				ImgBadge1.imgpath = "img_bgsquare_grade_300.png"
''				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_300.png")
'			else
'				ImgBadge1.imgpath = "img_bgsquare_grade_300.png"
''				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_300.png")
'			end if
						if szGradCode = "01" then
				ImgBadge1.imgpath = "img_bgsquare_grade_372.png"
				lblRiskNm.fgcolor = 273
			elseif szGradCode = "02" then
				ImgBadge1.imgpath = "img_bgsquare_grade_373.png"
				lblRiskNm.fgcolor = 144
			elseif szGradCode = "03" then
				ImgBadge1.imgpath = "img_bgsquare_grade_374.png"
				lblRiskNm.fgcolor = 144
			elseif szGradCode = "04" then
				ImgBadge1.imgpath = "img_bgsquare_grade_375.png"
				lblRiskNm.fgcolor = 144
			elseif szGradCode = "05" then
				ImgBadge1.imgpath = "img_bgsquare_grade_376.png"
				lblRiskNm.fgcolor = 144
			else
				ImgBadge1.imgpath = "img_bgsquare_grade_377.png"
				lblRiskNm.fgcolor = 273
			end if
		    szTypeNm = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "ZI_TYPE_NAME", 0) 	'펀드유형
		    lblTypeNm.caption = szTypeNm
			ImgBadge2.imgpath = "img_bgsquare_grade_316.png"
				
			szFundName = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "ZI_KOR_FUND_NAME", 0)	'펀드명
			lblFndName.caption = szFundName
			lblFndName.SetMaxLineCount(2)	'컨트롤 라인 제한 함수
			
		    tab01.page002304.Container1.lblSize1.caption  = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "ZI_STUP_AMT", 0)
		    tab01.page002304.Container1.lblSize2.caption  = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "SMTN_RMND_AMT", 0)
		    
		    tab01.page002304.Container1.lbl01.caption = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "ZI_MGCO_NAME", 0)
		    tab01.page002304.Container1.lbl31.caption = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "ZI_BNMR_KOR_NAME", 0)
			
			tab01.page002304.Container1.imgGrade.imgpath = "zeroin_class_" .. szZiGradCode	'평가등급(제로인)


'''			'---------------------------------------
'''			'정보탭
'''			'---------------------------------------
'''		    szOrgBuyInfo	=	DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock2", "SHNU_PRC_APLY_INFO", 0) 
'''		    szOrgSellInfo	=	DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock2", "SELN_PRC_APLY_INFO", 0) 
'''		    szOrgHour		=	DATAMANAGER.GetDataValue(0,"oocwi_mall_003r", "OutBlock2", "ZI_SHNU_SELN_STND_HOUR", 0) 
'''		    
'''		    szListT201 = split(szOrgBuyInfo, ",")
'''    		    szListT202 = split(szOrgSellInfo, ",")
'''
''''		    tab01.page001528.tblT201.SetCellString(2, 2,  szListT201(0)    )
''''   		    tab01.page001528.tblT201.SetCellString(2, 3,  szListT201(1)    )
''''		    tab01.page001528.tblT201.SetCellString(3, 2,  szListT202(0)    )
''''    	    tab01.page001528.tblT201.SetCellString(3, 3,  szListT202(1)    )
'''
'''		    tab01.page001528.Container0.lblT2StndHour.caption	=	szOrgHour
'''		  
'''		    tab01.page001528.Container0.tblT201.SetCellString(3, 2,  szListT201(0) & "/" &  szListT201(1) )
'''		    tab01.page001528.Container0.tblT201.SetCellString(4, 2,  szListT202(0) & "/" &  szListT202(1) )

			'---------------------------------------
			'수익률탭
			'---------------------------------------
			tab01.page001529.Container2.ChartExT3.SetPriceFormat("펀드^10^2")
			tab01.page001529.Container2.ChartExT3.SetPriceFormat("BM지수^10^2")
			tab01.page001529.Container2.ChartExT3.SetPriceFormat("유형^10^2")
		
		
			'---------------------------------------
			'기준가탭
			'---------------------------------------
			tab01.page009003.Container3.ChartExT4.SetPriceFormat("기준가^10^2")
			tab01.page009003.Container3.ChartExT4.SetPriceFormat("순자산^10^2")
		 
		 
			'---------------------------------------
			'자산탭 파이차트
			'---------------------------------------
			nOut16Cnt	=	DATAMANAGER.GetDataCount(0, "oocwi_mall_003r", "OutBlock16")
			
			for	i	=	0	to	nOut16Cnt	-	1
				
					szTemp1	=	DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock16", "ZI_TYPE_NAME", i)
					szTemp2 	=	DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock16", "ETRT", i)
					
					if	i	<	nOut16Cnt -1  then
						szIn16DataName	=	szIn16DataName	& 	szTemp1	& ";"
						szIn16DataVal		=	szIn16DataVal		&	szTemp2	& ";"
					else
						szIn16DataName	=	szIn16DataName	& 	szTemp1	
						szIn16DataVal		=	szIn16DataVal		&	szTemp2
					end	if
			next
			
'PENTA13 START => 2023.09.07(차트성능개선) 기준앱 버전 (안드로이드): 2.3.3, (ios): 2.5.32
			Dim sVersion, sOS_Type, szData, bNewPieChart
			sVersion = Form.GetSharedData( "&APP_VERSION", false )
			sOS_Type = Form.GetSharedData( "&OS_TYPE", false )		'1: 안드로이드, 2: ios
			
			szData = Split( sVersion, "." )
			sVersion = Cint( szData(0) & szData(1) & szData(2) )
			bNewPieChart = false
			
			if sOS_Type = "1" then			'안드로이드
				if sVersion > 233 then
					bNewPieChart = true
					
				end if
				
			elseif sOS_Type = "2" then		'ios
				if sVersion > 2532 then
					bNewPieChart = true
					
				end if
				
			end if
			
			if bNewPieChart = true then
				' ("타이틀=데이터=컬러타입(커스텀:0)=정렬=툴팁 형식=중앙 텍스트=색상값(R,G,B;R,G,B)=중앙 원 비율=구분선 굵기= 해당값 이상만 그리기=애니메이션 유무=강조유무=툴팁유무=폰트스타일(title/value)(true=bold,false=normal)=폰트크기(title/value)=색상(title/value)") 2023.07.25 한국금융IT
				tab01.page004379.Container4.ChartEx1T5.SetAccrueData(szIn16DataName & "=" & szIn16DataVal & "=0=right=V===255,124,128;248,203,173;255,242,204;226,240,217;218,227,243;212,243,250;68,114,196;143,138,255;250,212,242;255,163,165=0.55=0=0=true=false=false=false/false=10/10=34,34,34/34,34,34")
			
			else
				tab01.page004379.Container4.ChartEx1T5.SetAccrueData(szIn16DataName & "=" & szIn16DataVal & "=2=bottom")
				
			end if
'PENTA13 END
			
			'---------------------------------------
			'자산탭 막대차트(주식)
			'---------------------------------------
			nOut10Cnt	=	DATAMANAGER.GetDataCount(0, "oocwi_mall_003r", "OutBlock10")
			for	i	=	0	to	nOut10Cnt	-	1
				
				szTemp1	=	DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock10", "ZI_ISNM", i)
				szTemp2 	=	DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock10", "FUND_STCK_ASET_RLIM", i)
					
				if	i	<	nOut10Cnt -1  then
					szIn10DataName	=	szIn10DataName	& 	szTemp1	& ";"
					szIn10DataVal		=	szIn10DataVal		&	szTemp2	& ";"
				else
					szIn10DataName	=	szIn10DataName	& 	szTemp1	
					szIn10DataVal		=	szIn10DataVal		&	szTemp2
				end	if
			next
'			szIn10DataName = replace(szIn10DataName, " ", "")
'	
'			tab01.page004379.Container4.ChartEx3T5.SetAccrueData("initdata="&szIn10DataVal)
'			tab01.page004379.Container4.ChartEx3T5.SetAccrueData("titles="&szIn10DataName)
'			tab01.page004379.Container4.ChartEx3T5.SetAccrueData("자료일자="&szIn10DataName)
'			tab01.page004379.Container4.ChartEx3T5.SetAccrueData("data1="&szIn10DataVal&"=2")
'			tab01.page004379.Container4.ChartEx3T5.SetAccrueData("repaintall");
'			
