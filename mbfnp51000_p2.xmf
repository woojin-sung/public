''	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			DATAMANAGER.SetDataValue(0, "obcsb_acif_798r", "InBlock1", "ELFN_ID", 0 , g_szID)
			DATAMANAGER.RequestTranData("obcsb_acif_798r")
'			DATAMANAGER.RequestTranData("obcsb_acif_700r")
		elseif sRet == "CANCEL_mbonl81010_p20" then	'가입중단
			Form.OpenScreen("51000", "")
			Form.CloseForm()
			Exit Sub
		end if
		
	elseif sKeyName == "mbfnp51000_p8" then	
		if sRet == "ADD" then	'추가매수진행					
			Dim szSendData
			szSendData = g_szShortCd & "★" & g_szStndCd	' & "★" & g_szSaleChanTp
		
			Form.OpenPopup("mbfnp51010", szSendData, "")
		
		elseif sRet == "CANCEL" then	'가입중단
'			Form.OpenScreen("51000" , "")
			Form.CloseForm()
			Exit Sub
		
		elseif sRet <> "GO_BACK" then
			Form.CloseForm()
			
		end if
		
	'===============================================
	'********** 공통 얼럿 팝업 리턴      ***********
	'===============================================
	ElseIf sKeyName == "errMsgBox"  Then 
		if sRet = "Right" then				
			'투자성향재진단 화면 연결
			Form.OpenFramePopup("mbonl81010" , "" , "")
		elseif sRet = "Call" then
			'상담센터 연결
			Form.SendCall("15883400")
		end if	
		
	end if
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	g_szRet = "GO_BACK"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbfnp51000_p2" ,  g_szRet)
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent(sTimerID, 0, 0)
	
	if Cint(sTimerID) = 9999 then
		if	len( tab01.page002304.Container1.tblSvrfilename.GetCellString(1, 0))  > 0	then
		     tab01.page002304.Container1.lblPolicy.enable = true
		end if
		
		if	len( tab01.page002304.Container1.tblSvrfilename.GetCellString(1, 1))  > 0	then
		     tab01.page002304.Container1.lblExplain.enable = true
		end if
		
		if	len( tab01.page002304.Container1.tblSvrfilename.GetCellString(3, 0))  > 0	then
		     tab01.page002304.Container1.lblExplain2.enable = true
		end if
		
		if	len( tab01.page002304.Container1.tblSvrfilename.GetCellString(3, 1))  > 0	then
		     tab01.page002304.Container1.btnResult.enable = true
		end	if
		
		'21.09.09 JHY START (v001)
		Dim szSlcpRmrt, szMgcoRmrt, szTrcpRmrt, szFndcRmrt
		
		szSlcpRmrt = ""
		szMgcoRmrt = ""
		szTrcpRmrt = ""
		szFndcRmrt = ""
		
			'20231214_01 HWG START
'		szSlcpRmrt = FormatNumber(CDbl(DATAMANAGER.GetDataValue(0, "oocwi_gfnv_003r", "OutBlock2", "SLCP_RMRT", 0)), 4) '판매사보수율
'		szMgcoRmrt = FormatNumber(CDbl(DATAMANAGER.GetDataValue(0, "oocwi_gfnv_003r", "OutBlock2", "CNCO_RMRT", 0)), 4) '운용사보수율
'		szTrcpRmrt = FormatNumber(CDbl(DATAMANAGER.GetDataValue(0, "oocwi_gfnv_003r", "OutBlock2", "TRCP_RMRT", 0)), 4) '수탁사보수율
'		szFndcRmrt = FormatNumber(CDbl(DATAMANAGER.GetDataValue(0, "oocwi_gfnv_003r", "OutBlock2", "FNDC_RMRT", 0)), 4) '사무수탁사보수율

		szSlcpRmrt = DATAMANAGER.GetDataValue(0, "oocwi_gfnv_003r", "OutBlock2", "SLCP_RMRT", 0) '판매사보수율
		szMgcoRmrt = DATAMANAGER.GetDataValue(0, "oocwi_gfnv_003r", "OutBlock2", "CNCO_RMRT", 0) '운용사보수율
		szTrcpRmrt = DATAMANAGER.GetDataValue(0, "oocwi_gfnv_003r", "OutBlock2", "TRCP_RMRT", 0) '수탁사보수율
		szFndcRmrt = DATAMANAGER.GetDataValue(0, "oocwi_gfnv_003r", "OutBlock2", "FNDC_RMRT", 0) '사무수탁사보수율
		
		if trim(szSlcpRmrt) <> "" and szSlcpRmrt <> null then
			szSlcpRmrt = FormatNumber(CDbl(szSlcpRmrt, 4))
		end if
		
		if trim(szMgcoRmrt) <> "" and szMgcoRmrt <> null then
			szMgcoRmrt = FormatNumber(CDbl(szMgcoRmrt, 4))
		end if
		
		if trim(szTrcpRmrt) <> "" and szTrcpRmrt <> null then
			szTrcpRmrt = FormatNumber(CDbl(szTrcpRmrt, 4))
		end if
		
		if trim(szFndcRmrt) <> "" and szFndcRmrt <> null then
			szFndcRmrt = FormatNumber(CDbl(szFndcRmrt, 4))
		end if
		
		'Dim szTotalRmrt
		'szTotalRmrt = "연 " & g_szZiFert &"% (판매사보수 " & szSlcpRmrt &"%, 운용사보수 "& szMgcoRmrt &"%, 수탁사보수 " & szTrcpRmrt &"%, 사무관리사보수 "& szFndcRmrt & "%)"			
		'tab01.page002304.Container1.lblTotalRmrt.caption = szTotalRmrt
		
		g_szZiFert = FormatNumber(g_szZiFert, 4)	
		tab01.page002304.Container1.tblT102.SetCellString(1, 1, "연 " & g_szZiFert &"% ")
		g_szTooltipText = "판매 : " .. szSlcpRmrt &"%\n운용 : "& szMgcoRmrt &"%\n수탁 : " & szTrcpRmrt &"%\n사무 : " & szFndcRmrt & "%"
		'20231214_01 HWG END
		
		'21.09.09 JHY END
		
		
		szRPRC_FEE_INFO_CNTT = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock2", "RPRC_FEE_INFO_CNTT", 0) 	'제로인보수율	'총보수
		tab01.page002304.Container1.lblFeeIinfoCntt.caption = szRPRC_FEE_INFO_CNTT
		
		
		'----- 3개월수익률 폰트컬러 -----
		szZI_RLZT_ERT = tab01.page002304.Container1.tblT104.GetCellString(1, 2)
		Label8.caption = szZI_RLZT_ERT .. "%"	
		 if	szZI_RLZT_ERT	>	"0"	then
			Label8.fgcolor = "10"
		elseif	szZI_RLZT_ERT	<	"0"	then
			Label8.fgcolor = "11"
		else
			Label8.fgcolor = "12"
		end if			
		'----- 3개월수익률 폰트컬러 -----	
		
		
		DATAMANAGER.RequestTranData("obsim_idmn_018r")
	end if
End Sub

