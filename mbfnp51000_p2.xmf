				Form.OpenPopup("mbonl81010_p20" , "" , "")
			else
				
				Form.ShowAlert("알림", szErrMsg)
				
				Form.CloseForm()
				'Form.OpenScreen("51000", "")
			
			end if
			
		end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'ShowAlert(szTranID , szErrCode .. " : " .. szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	g_szAlertTitle = "알림"
	if szTranID = "obsai_deal_700r" then
	
		if	len(trim(szSubMsg))	>	0	then
			Form.ShowAlert(g_szAlertTitle, szErrMsg & "\n(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szAlertTitle, szErrMsg )
		end	if
	else
		if	len(trim(szSubMsg))	>	0	then
			Form.ShowAlert(g_szAlertTitle, szErrMsg & "\n(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szAlertTitle, szErrMsg )
		end	if
	end if
End Sub

