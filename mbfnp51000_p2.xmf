'============================================================================
' 01.화면명 		: 펀드검색
' 02.화면설명		: 펀드검색_펀드상세팝업
' 03.작성		: 2016.02.18
' 04.수정		: 2021.09.09 정효영 : 금소법 관련 요건 추가 (v001)
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szShortCd	'펀드단축코드
dim	g_szStndCd	'펀드풀코드			'펀드매매에 FULL CODE 필요
'dim	g_szFundName	'펀드명
dim	g_szBIZDATE	'영업일


'21.09.09 JHY 추가
Dim g_szStcyFnCd ' 협회펀드코드
Dim g_szZiFert ' 제로인 수수료율


'23.04.15 ADD
dim	g_szTooltipText	'총보수 툴팁내용
dim	g_szSelectedIdx	'그리드 선택된 인덱스
dim	g_szFundIntrFlag	'펀드관심등록상태
dim	g_szOSType		'OS Type
dim	g_szID
dim	g_szProsYN	'투자성향등급

dim g_KYC_SPCL_INVR_YN		'KYC전문투자자여부

dim g_szHGDTYn	'고난도상품여부
dim g_szFITYn		'적정성상품여부

dim g_szRet


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
'Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()

	ImgIntr.setMaintainingRatio("1")

	'tab01.page001529.ChartExT3.SetChartType("line")
	tab01.page004379.Container4.ChartEx1T5.SetChartType("pie")
	tab01.page004379.Container4.ChartEx3T5.SetChartType("bar")
	tab01.page004379.Container4.ChartEx4T5.SetChartType("bar")
	
	tab01.page002304.Container1.imgGrade.setMaintainingRatio("1")
	
'	tab01.page002304.Container1.Image2.setMaintainingRatio("1")
'	tab01.page002304.Container1.Image3.setMaintainingRatio("1")
'	tab01.page002304.Container1.imgCheck1.setMaintainingRatio("1")
'	tab01.page002304.Container1.imgCheck2.setMaintainingRatio("1")
End Sub

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("펀드상세")
    
	g_szOSType = Form.GetSharedData("&OS_TYPE", False)	'OSType 1.안드로이드 2.IOS
	g_szID = Form.GetSharedData("&USER_ID", false )
	
	''수익률 탭
	tab01.page001529.Container2.ChartExT3.SetAccrueName("펀드,BM지수,유형=1,1,1")	
	tab01.page001529.Container2.ChartExT3.SetPeriodType(2)			'0:틱, 1:분, 2:일자
	tab01.page001529.Container2.ChartExT3.setViewDataCount(-1)
	tab01.page001529.Container2.ChartExT3.setLineColor("펀드;255;0;0")
	tab01.page001529.Container2.ChartExT3.setLineColor("BM지수;0;0;255")
	tab01.page001529.Container2.ChartExT3.setLineColor("유형;0;255;0")

	''기준가 탭
	tab01.page009003.Container3.ChartExT4.SetAccrueName("기준가,순자산=1,1")	
	tab01.page009003.Container3.ChartExT4.SetMarketCategory("3")		'stock(0), elw(2), nightfuture(6),jisu(1),future(3),stockfuture(7),sangfumfuture(8),multi
	tab01.page009003.Container3.ChartExT4.SetPeriodType(2)			'0:틱, 1:분, 2:일자
	tab01.page009003.Container3.ChartExT4.setViewDataCount(-1)
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()

	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")
		
		g_szShortCd 			= tData[0]
		g_szStndCd 			= tData[1]
		g_szSaleChanTp 		= tData[2]
		
'		g_szShortCd 			= tData[0]
'		g_szStndCd 			= tData[1]
'		g_szFundName 			= tData[2]	'oocwi_mall_003r.outblock1.ZI_KOR_FUND_NAME
'		g_szSaleChanTp 		= tData[3]
'		g_szTransGradNm 		= tData[4]

	
	
'		lblRiskNm.caption = g_szTransGradNm

		
'		lblFndName.caption	=	g_szFundName
		g_szBIZDATE 		= Form.GetSharedData( "&BIZ_DT" , false )			'영업일
	     
		If Trim(g_szBIZDATE) = "" Then 
			g_szBIZDATE = Form.GetSharedData("&HOST_DATE", 0)
		end if	
		
		tab01.page009003.Container3.cldStartDate01.caption = g_szBIZDATE
		tab01.page009003.Container3.cldEndDate01.Caption = g_szBIZDATE
		tab01.page009003.Container3.cldStartDate01.caption = replace (DateAdd("m", -3,left( tab01.page009003.Container3.cldStartDate01.caption, 4) & "-" & mid( tab01.page009003.Container3.cldStartDate01.caption, 5,2) & "-" & mid( tab01.page009003.Container3.cldStartDate01.caption, 7,2) ), "-", "")
	   
	
		Label4.caption = "다른클래스보기 >"
	
	
		g_szFundIntrFlag = "N"	'관심펀드등록여부 초기화
		
		DATAMANAGER.RequestTranData("obsap_acif_999a") '금융상품 일련번호 GET
		DATAMANAGER.RequestTranData("obcsb_acif_799r") '고객번호로 전문투자자여부 조회
		DATAMANAGER.RequestTranData("oocwi_mall_003r")
		DATAMANAGER.RequestTranData("oocwi_mall_002r")
		DATAMANAGER.RequestTranData("obsim_idmn_088r")
		
		tab01.page002304.Container1.Container0.scroll_pos = "top"
		tab01.page002304.Container1.Container5.scroll_pos = "top"
	
	else	
		Form.ShowAlert("알림", "입력값이 없습니다.")
	end if
	
	
End Sub


'============================================================================
'ImgIntr_OnClick : 관심펀드 등록/삭제
'============================================================================
Sub ImgIntr_OnClick()
	if len(g_szShortCd)	>	0	then	
		if g_szFundIntrFlag == "Y" then	'이미 등록되었으면, 삭제
			f_InterestedFund("DEL")
		
		else	'등록되지 않았으면, 등록
			f_InterestedFund("ADD")
		end if
	end	if
End Sub

'============================================================================
Function f_InterestedFund(sFlag)
	if sFlag == "" or sFlag == null then
		Exit Function
	end if
	
	DATAMANAGER.RequestTranData("oocwi_mall_002r")	'관심 등록/삭제 하기 전 이미 등록된건지 아닌지 확인..
		
	if sFlag == "ADD" then	'관심펀드 추가
		nIntrIdx = grdIntrFund01.rowcount
			
		grdIntrFund01.AddRow()
		grdIntrFund01.SetCellData("bd_cell0", nIntrIdx  , g_szShortCd)
				
		nIntrIdx = grdIntrFund01.rowcount		'등록되기전 조회하여 데이터 들어간 갯수체크 재확인
	
		'3. 등록 TR 전송
		for	i = 0	to	nIntrIdx -1 
			DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock1", "EMPL_CNIS_TYPE_CLCD", i  , "1")	'집합투자증권 1
			DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock2", "ISCD", i, grdIntrFund01.GetCellData("bd_cell0", i))
		next
				
		DATAMANAGER.SetEventFlag("oocwi_gmyg_011a", "A")
		DATAMANAGER.RequestTranData("oocwi_gmyg_011a")
		
	elseif sFlag == "DEL" then	'관심펀드 삭제
			
		grdIntrFund01.SetDeleteRow(g_szSelectedIdx)

		nIntrIdx = grdIntrFund01.rowcount
		
		'3. 등록 TR 전송
		DATAMANAGER.ClearInputData(0, "oocwi_gmyg_011a")
		
		if nIntrIdx	=	"0"	then
			DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock1", "EMPL_CNIS_TYPE_CLCD", 0  , "1")	'집합투자증권 1
			DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock2", "ISCD", 0, "0001")
		else
			for	i = 0	to	nIntrIdx -1 
				DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock1", "EMPL_CNIS_TYPE_CLCD", i  , "1")	'집합투자증권 1
				DATAMANAGER.SetDataValue(0, "oocwi_gmyg_011a", "InBlock2", "ISCD", i, grdIntrFund01.GetCellData("bd_cell0", i))
			next
		end if
		
		DATAMANAGER.SetEventFlag("oocwi_gmyg_011a", "A")
		DATAMANAGER.RequestTranData("oocwi_gmyg_011a")
				
	end if

End Function

