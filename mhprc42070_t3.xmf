'----------------------------------------------------------------------------
' 01. 화 면 명 : 선옵현재가
' 02. 화면설명 : 선옵현재가 일자별 탭화면
' 03. 작    성 : 2016.04.30 LJS
'----------------------------------------------------------------------------
Dim g_szItemCode, g_ItemMarket, g_Mask

'============================================================================
Sub Form_OnFormInitBefore()


End Sub

'============================================================================
Sub Form_OnFormInit()

	DATAMANAGER.RequestTranData( "ohhts_3080_004r" )
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	If sKey = "ITEMCODE" Then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	
		
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "CF"			
		end if
	

		DATAMANAGER.RequestTranData( "ohhts_3080_004r" )
	end	if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	DATAMANAGER.CancelRealData( "ohhts_cfut_cntg" )
	
	
	DATAMANAGER.SetDataValue( 0, "ohhts_3080_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
	DATAMANAGER.SetDataValue( 0, "ohhts_3080_004r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	
	If szTranID = "ohhts_cfut_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_cfut_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "ohhts_3080_004r" Then
		DATAMANAGER.RequestRealData( "ohhts_cfut_cntg" )
	End If
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	If sEventName = "INIT_CODE" then
	
		tmp = Split(sParam , "★")
		
		g_szItemCode   =  tmp(0)
		g_Mask = tmp(1)
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		Set_MaskInfo(g_Mask)
		
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "CF"			
		end if
	
	
	DATAMANAGER.RequestTranData( "ohhts_3080_004r" )
	End If
End Sub

'=============================================================================
' 미국달러선물인 경우 소수점 한자리 까지만 나타내기 위해 마스킹처리를 해준다.
'=============================================================================
Sub Set_MaskInfo(szMask)

	if szMask == 1 or szMask == "1" then
		Grid0.SetCellIDMaskInfo("bd_cell1", "0,0,,,1,,1,1,0")
		Grid0.SetCellIDMaskInfo("bd_cell2", "0,0,,,1,,1,1,0")
	elseif szMask == 2 or szMask == "2" then
		Grid0.SetCellIDMaskInfo("bd_cell1", "0,0,,,1,,2,1,0")
		Grid0.SetCellIDMaskInfo("bd_cell2", "0,0,,,1,,2,1,0")
	else
		Grid0.SetCellIDMaskInfo("bd_cell1", "0,0,,,1,,0,1,0")
		Grid0.SetCellIDMaskInfo("bd_cell2", "0,0,,,1,,0,1,0")
	
	end if

End Sub
