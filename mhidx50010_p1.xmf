'============================================================================
' 01.화면명 	: 시장종합
' 02.화면설명	: 시장종합_설정팝업
' 03.작성	: 2016.01.04
'20230208 HSZ START : 시장종합 화면 개편
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_szInputFile	'읽어들일세팅파일
dim g_szKeys		'키값		
dim g_szValues		'읽어들인세팅값
dim g_szNames 		'한글로 출력할 이름

'시장종합 개편 수정
Dim g_arrSelectList, g_arrNoneSelectList
g_arrSelectList = Array( "", "", "", "", "", "" )
g_arrNoneSelectList = Array( "", "", "", "", "", "" )

g_szKeys		=	Array(	"50010_INDEX", "50010_NEWS", "50010_BANNER", "50010_MYNEWS", 
						"50010_RANKING"  , "50010_MARKET", "50010_SECTOR", "50010_INDUSTRY", "50010_REPORT", "50010_NOTICE", "50010_LINK" )	'11개
			
g_szNames = Array( "주요지수", "실시간 뉴스", "메리츠 상품 및 이벤트", "MY종목/MY뉴스"
				, "실시간 순위", "시장지표", "주목받는 섹터", "업종동향", "메리츠 리서치 리포트", "공지사항", "유튜브/카카오 채널 바로가기")		'11개
'20211005 아이티젠(김성수) END
'20230208 HSZ END
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function
'============================================================================
'f_SaveSettingData() : 설정저장 함수
'============================================================================
'20211005 아이티젠(김성수) START
'시장종합 개편 추가
Function f_SaveSettingData()
	'편집 여부 저장
	Form.SaveConfigData(g_szInputFile, "50010_CHANGE"  		, "1")
	
	dim szGridCnt
	dim szLinkData
	
	szGridCnt = cont0.grdMain00.rowcount
	szLinkData = szGridCnt 
	
	for i = 0 to  szGridCnt - 1
		dim sKeys, sValue
		sKeys = cont0.grdMain00.GetCellData("bd_cell3", i)
		sValue = cont0.grdMain00.GetCellData("bd_cell5", i)
		szLinkData = szLinkData & "★" & sKeys & "★" & sValue
		
		Form.SaveConfigData(g_szInputFile, sKeys ,sValue)
	next
'	20230208 HSZ START: 시장종합 개편
'	Form.SaveConfigData(g_szInputFile, "41000P2_LISTITEMS", szLinkData)
	Form.SaveConfigData(g_szInputFile, "50010_LISTITEMS", szLinkData)
'	20230208 HSZ END
	Form.SendReturnToParent("REFRESH_MAIN" , "")
End Function
'20211005 아이티젠(김성수) END

'============================================================================
'f_SetNoneSelectList() : 미설정 목록 데이터 SET
'============================================================================
Function f_SetNoneSelectList()
	'미설정 List SET
	Dim nFlag, nIdx
	nIdx = 0
	
	g_arrNoneSelectList = Array( "", "", "", "", "", "" )
	
	For j = 0 to UBound(g_szKeys)
		nFlag = 0
	
		for k = 0 to UBound(g_arrSelectList)
			if g_szKeys(j) == g_arrSelectList(k) then
				nFlag = 1
			end if
		next
		
		if nFlag == 0 then
			g_arrNoneSelectList(nIdx) = g_szKeys(j)
			nIdx = nIdx + 1
			
		end if
	Next
	
End Function

'============================================================================
'LoadSettings() : 파일에서 세팅값을 읽어들임
'============================================================================
Function LoadSettings()
	dim szVal
	dim nIdx
	nIdx = 0
	
'	g_szValues = Array()
	
	'20211005 아이티젠(김성수) START
	'시장종합 개편 추가
	Dim arrLoadData, szLoadData
'	20230208 HSZ START: 시장종합 개편
'	szLoadData = Form.LoadConfigData(g_szInputFile, "41000P2_LISTITEMS")
	szLoadData = Form.LoadConfigData(g_szInputFile, "50010_LISTITEMS")
'	20230208 HSZ END
	
	arrLoadData = Array()
	arrLoadData = split(Trim(szLoadData), "★")
	
	g_arrSelectList = Array( "", "", "", "", "", "" )
	
	'설정 List SET
	if UBound(arrLoadData) >= 1 then
		For i = 1 to UBound(arrLoadData) step 2
			if Trim(arrLoadData(i)) <> "" then
				g_arrSelectList(nIdx) = arrLoadData(i)
				
				nIdx = nIdx + 1
			end if
		Next
	end if
	
	'20211005 아이티젠(김성수) END
	'TEST 출력용 
'	For j = 0 to UBound(g_szKeys)
'		Form.ShowAlert("output22",g_szKeys(j) & "=" & g_szValues(j)  & ",," & j )
'	Next
	
End Function


'============================================================================
'ShowSettings() : 파일에서 세팅값을 읽어들여서 화면 세팅
'============================================================================
Function ShowSettings()
	dim nGridIdx
	dim szOutputData
	
	nGridIdx = 0 

	Dim nGrd_Header_H, nGrd_Cell_H '그리드 header, cell 높이
	nGrd_Header_H, nGrd_Cell_H = 25, 50
	
	Dim nGrdMain00_H
	nGrdMain00_H = 0
	
	Dim nFlag, nMatchIdx
	
	cont0.grdMain00.SetClear( )
	cont0.grdMain01.SetClear( )
	
	'설정 목록 UI SET
	For i = 0 to UBound(g_arrSelectList)
		if g_arrSelectList(i) <> "" then
			nFlag = 0
			
			for j = 0 to UBound(g_szKeys)
				if g_arrSelectList(i) == g_szKeys(j) then '리스트 데이터 비교
					nFlag = 1
					nMatchIdx = j
				end if 
			next
			
			if nFlag == 1 then
				cont0.grdMain00.AddRow( )
				
				cont0.grdMain00.SetCellData("bd_cell1", nGridIdx, g_szNames(nMatchIdx))
				cont0.grdMain00.SetCellData("bd_cell3", nGridIdx, g_szKeys(nMatchIdx))
				cont0.grdMain00.SetCellData("bd_cell5", nGridIdx, "1")
				cont0.grdMain00.SetCellData("bd_cell0", nGridIdx, "1")
				nGridIdx = nGridIdx + 1
			end if	
		end if
	Next
	
	cont0.grdMain00.height = CInt(cont0.grdMain00.rowcount) * nGrd_Cell_H + nGrd_Header_H + 2
	nGrdMain00_H = cont0.grdMain00.height
	
	Call f_SetNoneSelectList()
	
	'미설정 목록 UI SET
	if UBound(g_arrNoneSelectList) > 0 then
		for i = 0 to UBound(g_arrNoneSelectList)
			for j = 0 to UBound(g_szKeys)
				if g_arrNoneSelectList(i) == g_szKeys(j) then
					cont0.grdMain01.AddRow()
					
'					Form.ShowAlert(g_arrNoneSelectList(i), g_szKeys(j))
					cont0.grdMain01.SetCellData("bd_cell1", i, g_szNames(j))
					cont0.grdMain01.SetCellData("bd_cell3", i, g_szKeys(j))
					cont0.grdMain01.SetCellData("bd_cell5", i, "1")
					
				end if
			next
		next
		
	else
		cont0.grdMain01.SetClear()
		
	end if
	

	cont0.grdMain01.height 	= CInt(cont0.grdMain01.rowcount) * nGrd_Cell_H + nGrd_Header_H + 2
	cont0.grdMain01.top		= CInt(cont0.grdMain00.height)

	if CInt(cont0.grdMain01.rowcount) = 0 then
		cont0.grdMain01.visible = false
	else
		cont0.grdMain01.visible = true
	end if
	
	cont0.setScrollAutoSize()
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
'	20230208 HSZ START: 시장종합 개편
'	g_szInputFile	= "41000P2ITEMS.ini"	
	g_szInputFile	= "50010ITEMS.ini"
'	20230208 HSZ END
	Form.SetScreenName("설정") ''20211005 아이티젠(김성수) 삭제 / Framepopup에서 일반 popup으로 변경
	cont0.grdMain00.rowmove = "1"	
	call LoadSettings()
	call ShowSettings()

End Sub


'============================================================================
'btnInit00_OnClick
'============================================================================
Sub btnInit00_OnClick()
	'TODO : 클리어하고 기본 값만 세팅하는 기능 

	'전체 아이템 세팅
	Form.SaveConfigData(g_szInputFile, "50010_INDEX"		, "1")
	Form.SaveConfigData(g_szInputFile, "50010_NEWS"		, "1")
	Form.SaveConfigData(g_szInputFile, "50010_BANNER"		, "1")
	Form.SaveConfigData(g_szInputFile, "50010_MYNEWS"		, "1")
	Form.SaveConfigData(g_szInputFile, "50010_RANKING"	, "1")
	Form.SaveConfigData(g_szInputFile, "50010_MARKET"		, "1")
	Form.SaveConfigData(g_szInputFile, "50010_SECTOR" 	, "1")
	Form.SaveConfigData(g_szInputFile, "50010_INDUSTRY"  	, "1")
	Form.SaveConfigData(g_szInputFile, "50010_REPORT"  	, "1")
	Form.SaveConfigData(g_szInputFile, "50010_NOTICE"  	, "1")
	Form.SaveConfigData(g_szInputFile, "50010_LINK"  		, "1")
	'20230208 HSZ END
	
	'20211005 아이티젠(김성수) START
	'시장종합 개편 추가
	Dim szLinkData
	szLinkData = UBound(g_szKeys) - LBound(g_szKeys) + 1
	
	for i = 0 to UBound(g_szKeys)
		szLinkData = szLinkData & "★" & g_szKeys(i) & "★" & "1"
		
	next
'	20230208 HSZ START
'	Form.SaveConfigData(g_szInputFile, "41000P2_LISTITEMS", szLinkData)
	Form.SaveConfigData(g_szInputFile, "50010_LISTITEMS", szLinkData)
'	20230208 HSZ END
	
	Form.ShowAlert("알림", "설정이 초기화 되었습니다.")
	
	LoadSettings()
	ShowSettings()
	
	Form.SendReturnToParent("REFRESH_MAIN" , "")
	'20211005 아이티젠(김성수) END
End Sub


'============================================================================
'grdMain00_OnClickUp
'============================================================================
Sub cont0_grdMain00_OnClickUp(lRow, szCellID)
	dim szCnt
	dim szItemName			'선택된 ITEM의 이름 
	
	szCnt = CInt(cont0.grdMain00.rowcount)
	
	if szCellID = "bd_cell0" then					' 삭제 기능 
		if szCnt < 4 then
			cont0.grdMain00.SetCellData( "bd_cell0", lRow, 1 )
			Form.ShowAlert("알림", "최소 3개 이상 유지되어야합니다.")
		else

			cont0.grdMain00.SetDeleteRow(lRow)
			
			'20211005 아이티젠(김성수) START
			'시장종합 개편 추가
			g_arrSelectList = Array( "", "", "", "", "", "" )
			szCnt = CInt(cont0.grdMain00.rowcount)
			
			for i = 0 to szCnt
				szItemName = cont0.grdMain00.GetCellData("bd_cell3", i)
				
				if szItemName <> "" and szItemName <> null then
					g_arrSelectList(i) = szItemName
				end if
			next
			'20211005 아이티젠(김성수) END
			
			ShowSettings()
			
		end if 
	end if 
	
End Sub

'============================================================================
'grdMain01_OnClickUp
'============================================================================
'20211005 아이티젠(김성수) START
'시장종합 개편 추가
Sub cont0_grdMain01_OnClickUp(lRow, szCellID)
	dim szCnt
	dim szItemName			'선택된 ITEM의 이름 
	
'	szCnt = grdMain01.rowcount
	
	if szCellID = "bd_cell0" then
		szItemName = cont0.grdMain01.GetCellData("bd_cell3", lRow) '미설정에서 선택한 키 값
		
		szCnt = CInt(cont0.grdMain00.rowcount) '설정한 목록의 개수 = Select List 길이
		g_arrSelectList(szCnt) = szItemName '추가된 항목을 Selet List 뒤에 추가
		cont0.grdMain01.SetDeleteRow(lRow)
		
		ShowSettings()
	end if 
	
End Sub
'20211005 아이티젠(김성수) END

