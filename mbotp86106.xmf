Sub CntnIn_CmbAcnt_OnEditComplete(iIndex)
	CntnIn.EdtPwd.enable = True
	szFrAcno = Left	(CntnIn.CmbAcnt.caption, 4)
	szRrAcno = Right(CntnIn.CmbAcnt.caption, 4)
	g_tempAcc = szFrAcno & szRrAcno
	Form.SetSharedData( "BDM_NMET_ACNO", g_tempAcc )
	CntnIn.EdtPwd.SetShowKeypad(true)
End Sub

'============================================================================
Sub CntnIn_btnGude_OnClick()
	If g_Flag == 0 Then
		CntnIn.L1.top = 768
		CntnIn.SetScrollAutoSize()
		CntnIn.cntnGude.setHeightResize(281)
		CntnIn.scroll_pos = 265
		CntnIn.imgGudeO.imgpath = "icon_caret_up.png"

		g_Flag = 1
	Else
		CntnIn.cntnGude.setHeightResize(0)
		CntnIn.L1.top = 507
		Form.SetTimerEvent2(9999, 1, 0.3)
		CntnIn.imgGudeO.imgpath = "icon_caret_down.png"
		
		g_Flag = 0
	End If	
End Sub


'============================================================================
Sub Form_OnFormBackKeyPressed()
	imgGoToHome_OnClick()
End Sub

