Dim	g_szRSPN_CODE
Dim	g_RcnoPip

Dim	g_szSRNO2
Dim	g_szRSPN_CODE2
Dim	STPL_YN3
Dim	g_OTP_statcode
Dim	g_OTPUtlzYn
Dim	g_IsncCode

Dim	g_cnt
Dim	g_cnt2
Dim	g_Cnt140
Dim	g_IntoClcd '집입구분코드 NMET_ACNT:계좌개설 후처리, NMET_BSWR:업무처리, MTS:MTS
Dim	g_TlmsSrno140

Dim	g_pOTPRegYn
	g_pOTPRegYn = "N"
Dim	g_Flag
	g_Flag = 0
Dim	g_OSClcd
Dim	g_EdtTop
Dim	g_EdtScr

Dim	g_RplcYn
	g_RplcYn = "1"
	
Dim	g_RegPrhbYn
	g_RegPrhbYn = "N"
Dim	g_Theme

'============================================================================
Function funcAcnoList()
	DATAMANAGER.SetDataValue( 0, "obaci_acct_185r", "InBlock1", "RCNO"		, 0, "NMET" )
	DATAMANAGER.SetDataValue( 0, "obaci_acct_185r", "InBlock1", "RCNO_PIP"	, 0, g_RcnoPip )
	DATAMANAGER.RequestTranData( "obaci_acct_185r" )
End Function

'============================================================================
Function funcBtnSet(bit)
	'등록버튼 초기화
	BtnReg.enable		= bit
	
	If bit == False Then
		If g_Theme == "white" Then
			BtnReg.btnimage	= "btn_21.9"
		Else
			BtnReg.btnimage	= "btn_27.9"
		End If
		BtnReg.fgcolor	= 269
	Else
		BtnReg.btnimage	= "btn_20.9"
		BtnReg.fgcolor	= 0
	End If
End Function

'============================================================================
Function funcEdtAtvSet(bit)

	If bit == True Then
		CntnIn.L1.top 		= g_EdtTop
		CntnIn.scroll_pos 	= g_EdtScr
	Else
		CntnIn.L1.top 		= 507
		CntnIn.scroll_pos 	= 0
	End If
	CntnIn.SetScrollAutoSize()
End Function

'============================================================================
' 공통 함수
'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	g_TR_Count2 	= 0
	g_Flag		= 0
	g_Flag2 		= 0
	g_cnt 		= 0
	g_cnt2 		= 0
	g_Cnt140		= 0
	
	g_OSClcd	= Form.GetSharedData( "&OS_TYPE"	, false)
	g_IntoClcd	= Form.GetSharedData( "mOTP_IntoClcd", False )
	g_Theme = Form.GetEnvData("common.theme")

	If g_OSClcd = "1" Then '안드로이드
		CntnIn.setScrollBarVisible("2")
		
		g_EdtTop = 628
		g_EdtScr = 481
	Else
		g_EdtTop = 568
		g_EdtScr = 100
'		g_EdtScr = 421
	End If

	If g_IntoClcd == "MTS" Then
		g_RcnoPip	= Form.GetSharedData("&JUMIN_NUM", false ) '암호화로 내려옴.
	Else
		g_RcnoPip	= Form.GetSharedData("BDM_RCNO_PIP", false ) '암호화로 내려옴.
		szAcno	= Form.GetSharedData("BDM_NMET_ACNO", False )
	End If
	
	CntnIn.btnGude.btnimage = "alpha"

'test code
'g_IntoClcd = "NMET_BSWR"
'g_IntoClcd = "NMET_ACNT"
'g_RcnoPip = "001304FC8A4D7E156D9F62009DEA39433836"
'szAcno = "30003130"

	CntnIn.CmbAcnt.SetApplyLabel("종합계좌번호", 0, 267, "left", true, 60)
	
	CntnIn.EdtPwd.SetApplyLabel("종합계좌 비밀번호", 0, 267, "left", true)
	CntnIn.EdtPwd.SetUseResultLabel(TRUE, 0)
	
	CntnIn.Combo0.SetApplyLabel("업체구분"     , 0, 267, "left", true, 60)
	CntnIn.Edit0.SetApplyLabel("OTP 일련번호", 0, 267, "left", true)
	CntnIn.Edit0.SetUseResultLabel(TRUE, 2)

	edtOTP.caption		= ""
	edtRSPNCODE.caption	= ""
	
	edtSTTNNO.caption 	= ""
	edtSTNDDATE.caption 	= ""
	edtRSPNCODE2.caption	= ""
	edtOTP2.caption 	= ""
	
	edtSTTNNO.caption	= "001"
	
	reset_All()
	CntnIn.Combo0.enable = false
	CntnIn.Edit0.enable = false
	
	CntnIn.imgGudeO.imgpath	= "icon_caret_down.png"
	CntnIn.lblGudeBg.bgcolor	= 271
	funcBtnSet(False)
'	
	CntnIn.cntnGude.setHeightResize(0)
	
	If g_IntoClcd == "NMET_ACNT" Then

		szFrAcno = Left	(szAcno, 4)
		szRrAcno = Right(szAcno, 4)
		CntnIn.CmbAcnt.caption = szFrAcno & "-" & szRrAcno
		g_tempAcc = szAcno
		CntnIn.CmbAcnt.fgcolor = 267
		CntnIn.CmbAcnt.enable = False
		CntnIn.EdtPwd.SetShowKeypad(true)
	Else
'		계좌리스트 조회
		funcAcnoList()
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
'	g_tempAcc = CntnIn.CmbAcnt.caption
	If szTranID == "obacp_opop_066r" Then '계좌비밀번호 체크
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0, g_tempAcc )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "ACNT_PWD", 0, CntnIn.EdtPwd.caption )
	End If
	
	If szTranID == "obacp_opop_064r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"				, 0, g_tempAcc )
	End If
	
	If szTranID == "obcsb_oimf_140c" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"				, 0, g_tempAcc )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD"			, 0, CntnIn.EdtPwd.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OTP_CARD_SRNO"		, 0, CntnIn.Edit0.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OTP_SUPL_CO_CODE"	, 0, CntnIn.Combo0.cbkeydata )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OTP_ISNC_ISTU_CODE"	, 0, g_IsncCode )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO"				, 0, g_Csno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"			, 0, g_RcnoPip )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_CLCD"			, 0, g_RplcYn)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "APRV_YN" , 0 , "N")
	End If
	
	If szTranID == "obcsb_oimf_140c_1" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"				, 0, g_tempAcc )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD"			, 0, CntnIn.EdtPwd.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OTP_CARD_SRNO"		, 0, CntnIn.Edit0.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OTP_SUPL_CO_CODE"	, 0, CntnIn.Combo0.cbkeydata )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OTP_ISNC_ISTU_CODE"	, 0, g_IsncCode )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO"				, 0, g_Csno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"			, 0, g_RcnoPip )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OTP_TLMS_SRNO"		, 0, g_TlmsSrno140 )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_CLCD"			, 0, g_RplcYn)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "APRV_YN" , 0 , "Y")
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID == "obaci_acct_185r" Then
		if DATAMANAGER.IsMoreNextData( sTranID ) == True Then
			DATAMANAGER.RequestNextData( sTranID )
		Else
			
			For i = 0 To Grid1.rowcount -1
				szFrAcno = Left	(Grid1.GetCellData( "bd_cell0", i ), 4)
				szRrAcno = Right(Grid1.GetCellData( "bd_cell0", i ), 4)
				CntnIn.CmbAcnt.cbadddatatext = szFrAcno & "-" & szRrAcno
			Next
			
			CntnIn.CmbAcnt.Setstatus("focus")
			CntnIn.CmbAcnt.caption = "종합계좌를 선택해주세요"
			CntnIn.CmbAcnt.fgcolor = 270
			
			CntnIn.EdtPwd.enable = False

			DATAMANAGER.RequestTranData( "obacp_opop_064r" )
		End If
	End If
	
	If szTranID == "obacp_opop_066r" Then
'		CntnIn.EdtPwd.SetResultLabel("1", "complete", "비밀번호 일치 여부 체크 정상입니다.", "CntnIn")
		CntnIn.Combo0.caption	= ""
		CntnIn.Edit0.caption		= ""
		CntnIn.Combo0.enable 	= True
		CntnIn.Edit0.enable 		= True
		get_OTP_List()
	End If
	
	If szTranID == "obacp_opop_064r" Then
		g_Csno = DATAMANAGER.GetDataValue( 0 ,szTranID, "OutBlock1", "CSNO",0 )
	End If
	
	If szTranID == "obcsb_oimf_230r" Then
		g_szSRNO		= DATAMANAGER.GetDataValue( 0 ,szTranID, "OutBlock1", "OTP_TLMS_SRNO",0 )
		g_szRSPN_CODE	= DATAMANAGER.GetDataValue( 0 ,szTranID, "OutBlock1", "OTP_RSPN_CODE",0 )
		
		if Len(trim(g_szSRNO)) > 7 then		'전문일련번호
			edtOTP.caption = g_szSRNO
		end if
		if Len(trim(g_szRSPN_CODE)) == 4 then	'기준일자
			edtRSPNCODE.caption = g_szRSPN_CODE
		end if
		
		Call Query()
	
	ElseIf szTranID == "obcsb_oimf_230r_1" Then
		Form.SetTimerEvent(1, 0, 1) 'v0003
	
		g_Flag = 0
		
		g_IsncCode		= DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_230r_1", "OutBlock1", "OTP_ISNC_ISTU_CODE" , 0)
		ResponeCode 	= DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_230r_1", "OutBlock1", "OTP_RSPN_CODE" , 0)
		ResponeMs 		= Form.GetMetaData("OTP응답코드", ResponeCode)			
		edtRSPNCODE.caption = ResponeMs
		
'		StateCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_230r_1", "OutBlock1", "OTP_STAT_CLS_CODE" , i)
		StateCodeName = Form.GetMetaData("인증센터OTP상태코드", g_OTP_statcode) 
		
		If g_IsncCode == "02010" Then
			CntnIn.Edit0.SetResultLabel("1", "error", "당사 OTP는 신청 불가능합니다.", "CntnIn")
			CntnIn.Edit0.caption = ""
			reset_All()
			Exit Sub
		Else
			'If ResponeCode <> "0000" Then
			If	g_OTP_statcode == "020" or
				g_OTP_statcode == "030" or
				g_OTP_statcode == "031" or
				g_OTP_statcode == "032" or
				g_OTP_statcode == "040" or
				g_OTP_statcode == "050" or
				g_OTP_statcode == "060" Then
					
				Form.SetSharedData("15007s2_OTP"			, CntnIn.Edit0.caption )
				Form.SetSharedData("15007s2_OTP_CO_CODE"		, CntnIn.Combo0.cbkeydata )
				Form.SetSharedData("15007s2_ISNC_ISTU_CODE"	, DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_230r_1", "OutBlock1", "OTP_ISNC_ISTU_CODE" , 0) )
				CntnIn.Edit0.SetResultLabel("1", "complete", "등록가능한 OTP 입니다.", "CntnIn")
				funcBtnSet(True)
			Else
				CntnIn.Edit0.SetResultLabel("1", "error", "등록가능한 OTP가 아닙니다. ("& StateCodeName &")"&"("&CntnIn.Edit0.caption&")", "CntnIn")
				CntnIn.Edit0.caption = ""
				reset_All()
				Exit Sub
			End If
		End If
	ElseIf szTranID == "obcsb_oimf_160r" Then
		g_szSTTN_NO 	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "RQST_STA_STTN_NO"	, 0 )		'요청시작번호
		g_szSRNO2 		= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "OTP_TLMS_SRNO" 	, 0 )		'전문일련번호
		g_szSTND_DATE 	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "TLMS_PROS_DATE"	, 0 )		'기준일자
		g_szRSPN_CODE2 	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "OTP_RSPN_CODE" 	, 0 )		'기준일자
		
		if Len(trim(g_szSRNO2)) > 7 then		'전문일련번호
			edtOTP2.caption = g_szSRNO2
		end if
		if Len(trim(g_szSTTN_NO)) == 3 then		'시작요청위치
			edtSTTNNO.caption = g_szSTTN_NO
		end if
		if Len(trim(g_szSTND_DATE)) == 8 then	'기준일자
			edtSTNDDATE.caption = g_szSTND_DATE
		end if
		if Len(trim(g_szRSPN_CODE2)) == 4 then	'기준일자
			edtRSPNCODE2.caption = g_szRSPN_CODE2
		end if
		
		Call Query2() 
		
	ElseIf szTranID == "obcsb_oimf_160r_1" Then
		'v0009 start
		For ix = 0 To DATAMANAGER.GetDataCount( 0 , szTranID, "OutBlock1") - 1
			Grid0.AddRow( )
			Grid0.SetCellData( "bd_cell0", Grid0.rowcount-1, DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_CARD_SRNO" 	, ix) )
			Grid0.SetCellData( "bd_cell1", Grid0.rowcount-1, DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_SUPL_CO_CODE" 	, ix) )
			Grid0.SetCellData( "bd_cell2", Grid0.rowcount-1, DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_ISNC_ISTU_CODE"	, ix) )
			Grid0.SetCellData( "bd_cell3", Grid0.rowcount-1, DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_STAT_CLS_CODE"	, ix) )
			Grid0.SetCellData( "bd_cell4", Grid0.rowcount-1, DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UTLZ_REG_YN" 		, ix) )
			
			'V0011 나중으로 뺀다
			'등록기관이 타사이고 등록사용이 Y인 경우 교체등록 플래그 생성
			'If Grid0.GetCellData( "bd_cell4", ix ) == "Y" Then
			'	If Grid0.GetCellData( "bd_cell2", ix ) <> "02010" Then
			'		g_RplcYn = "5"
			'	Else
			'		g_RegPrhbYn = "Y"
			'	End If
			'End If
		Next
		if DATAMANAGER.IsMoreNextData(szTranID) == True then
			edtSTTNNO.caption = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "RQST_STA_STTN_NO", 0 )
			get_OTP_List()
		Else
		'v0009 end
			Form.SetTimerEvent(0, 0, 1) 'v0002
			'Form.MsgBox("SUCCESS", szTranID, 0,0)

			g_TR_Count2 = DATAMANAGER.GetDataCount( 0 , szTranID, "OutBlock1")
			ResponeCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "OTP_RSPN_CODE" , 0)
			ResponeMs = Form.GetMetaData("OTP응답코드", ResponeCode)			
			edtRSPNCODE2.caption = ResponeMs
			
			If ResponeCode == "3127" Then '식별자 오류 : 전 금융사에 보유중인 OTP 없는 고객
				STPL_YN3 = "EMPTY"
				Form.ShowAlert("알림", "등록가능한 OTP가 없습니다.")
			ElseIf ResponeCode == "0000" Then '정상조회
				if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UTLZ_REG_YN" , 0) == "Y" then	'등록여부
					STPL_YN3 = "N"
					Form.triggerEvent( "#", "STPL_YN3_s2", STPL_YN3 )
				else
					STPL_YN3 = "Y"
					Form.triggerEvent( "#", "STPL_YN3_s2", STPL_YN3 )
				end if
				enable_All()
			Else '정상조회/식별자오류가 아닌 다른 오류발생의 경우
				STPL_YN3 = "ELSE"
				Form.triggerEvent( "#", "STPL_YN3_s2", STPL_YN3 )
			End If
			
			g_Flag2 = 0
		End If 'v0009
	End If
	
	If szTranID == "obcsb_oimf_140c" Then
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_RSPN_CODE" , 0) <> ""then
			Form.SetTimerEvent(2, 0, 1)
		else
			g_TlmsSrno140 = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "OTP_TLMS_SRNO", 0)
			Form.SetTimerEvent(2, 1, 1)
'			DATAMANAGER.RequestTranData("obcsb_oimf_140c_1")
		end if
	End If
	
	If szTranID == "obcsb_oimf_140c_1" Then
		rspnCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OTP_RSPN_CODE" , 0)
		temp = Form.GetMetaData( "OTP응답코드" , rspnCode )
		Form.SetTimerEvent(0, 0, 1)
		'v0004 정상처리된 경우에만 등록완료표시 및 재조회/정상처리 아닌경우 처리불가 팝업메시지
		if rspnCode == "0000" or rspnCode == "3999" then
			Form.SetSharedData("BDM_OTP_SUPL_CO_CODE", CntnIn.Combo0.cbkeydata)
			
			g_pOTPRegYn = "Y" 'Form_OnFormClose에서 분기 시키기 위함
			rslt_data = "86106" & "☆" & "타기관 OTP 이용 등록" & "☆" & "Y" & "☆" & "R" & "☆" & CntnIn.Combo0.Caption & "☆" & CntnIn.Edit0.caption
			Form.OpenNextPopup( "mbotp86105_rslt.xmf" , rslt_data , "" ) ' openPopup 후 CloseForm 할 경우 openPopup된 화면이 닫힐 수 있기에 opennextpopup사용.
			'Form.CloseForm()
		else
			if temp <> "3021" then	  '3021.수신전문 조회 중 입니다.	
				rslt_data = "86106" & "☆" & "타기관 OTP 이용 등록" & "☆" & "N" & "☆" & "R" & "☆" & "처리에 실패하였습니다." & "☆" & temp
				Form.OpenPopup( "mbotp86105_rslt.xmf" , rslt_data , "" )
			end if
		end if		
	End If
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	If szTranID == "obacp_opop_066r" Then '계좌비밀번호
'		CntnIn.EdtPwd.SetResultLabel("1", "error", szErrMsg&"\n["&DATAMANAGER.GetDataMsgSubText(szTranID)&"]", "CntnIn", 2 )
		Form.OpenPopup("mbbdm85203.xmf", szErrMsg & "★" & DATAMANAGER.GetDataMsgSubText(szTranID) )
	End If
	
	if szTranID == "obcsb_oimf_230r_1" then 'v0001
		if szErrCode == "3021" then
			
			if g_cnt2 > 9 then '10번 호출 될 동안 응답을 받지 못하면 오류메세지 
				Form.SetTimerEvent(1, 0, 1) 
				Form.ShowAlert( "알림" , szErrMsg.."("..szTranID..")")
				Exit Sub
			else
				Form.SetTimerEvent(1, 1, 1) 
			end if
			g_cnt2 = g_cnt2 + 1
		else	
			Form.ShowAlert( "알림" , szErrMsg.."("..szTranID..")")
		end if
	elseif szTranID == "obcsb_oimf_160r_1" then 'v0001
		if szErrCode == "3021" then
			
			if g_cnt > 9 then '10번 호출 될 동안 응답을 받지 못하면 오류메세지 
				Form.SetTimerEvent(0, 0, 1) 
				Form.ShowAlert( "알림" , szErrMsg.."("..szTranID..")")
				Exit Sub
			else
				Form.SetTimerEvent(0, 1, 1) 
			end if 
			g_cnt = g_cnt + 1 'v0003
		else	
			Form.ShowAlert( "알림" , szErrMsg.."("..szTranID..")")
		end if
	elseif szTranID == "obcsb_oimf_160r" Then
		Form.ShowAlert( "알림" , szErrMsg.."("..szTranID..")")
	elseif szTranID == "obcsb_oimf_230r" Then
		Form.ShowAlert( "알림" , szErrMsg.."("..szTranID..")")
	end if
	
	If szTranID == "obcsb_oimf_140c_1" Then
		If szErrCode == "3021" Then
			If g_Cnt140 > 9 Then
				Form.SetTimerEvent(2, 0, 1)
				rslt_data = "86106" & "☆" & "타기관 OTP 이용 등록" & "☆" & "N" & "☆" & "R" & "☆" & "처리에 실패하였습니다." & "☆" & "응답 지연"
				Exit Sub
			Else
				Form.SetTimerEvent(2, 1, 1)
			End If
			g_Cnt140 = g_Cnt140 + 1
		End If
	End If
	
	If szTranID == "obcsb_oimf_140c" Then
		rslt_data = "86106" & "☆" & "타기관 OTP 이용 등록" & "☆" & "N" & "☆" & "R" & "☆" & szErrMsg & "☆" & DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.OpenPopup( "mbotp86105_rslt.xmf" , rslt_data , "" )
	End If
End Sub

'============================================================================
'개별 함수
'============================================================================
Function Query()
	
	DATAMANAGER.SetDataValue(0, "obcsb_oimf_230r_1", "InBlock1", "ACNO"			, 0, g_tempAcc 			)
	DATAMANAGER.SetDataValue(0, "obcsb_oimf_230r_1", "InBlock1", "ACNT_PWD"		, 0, edtPW.caption 		)
	DATAMANAGER.SetDataValue(0, "obcsb_oimf_230r_1", "InBlock1", "APRV_YN"		, 0, "" 				)	
	DATAMANAGER.SetDataValue(0, "obcsb_oimf_230r_1", "InBlock1", "OTP_SUPL_CO_CODE"	, 0, CntnIn.Combo0.cbkeydata	)
	DATAMANAGER.RequestTranData("obcsb_oimf_230r_1")
	
End Function
'============================================================================
Function get_OTP_List()
	
	g_cnt = 0 'v0002
	
	DATAMANAGER.SetDataValue( 0, "obcsb_oimf_160r", "InBlock1", "RQST_STA_STTN_NO"	, 0 , edtSTTNNO.caption )
	DATAMANAGER.SetDataValue( 0, "obcsb_oimf_160r", "InBlock1", "RCNO_PIP"		, 0 , g_RcnoPip )
	DATAMANAGER.SetDataValue( 0, "obcsb_oimf_160r", "InBlock1", "APRV_YN"		, 0 , "N" )
	DATAMANAGER.SetDataValue( 0, "obcsb_oimf_160r", "InBlock1", "CONT_CLS_CODE"	, 0 , "1" )
	DATAMANAGER.RequestTranData("obcsb_oimf_160r")
End Function
'============================================================================
Function Query2()
	
	if DATAMANAGER.IsMoreNextData("obcsb_oimf_160r_1") == True Or edtSTTNNO.caption > "001" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_160r_1", "InBlock1", "RCNO_PIP", 0 , g_RcnoPip )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_160r_1", "InBlock1", "CONT_CLS_CODE", 0 , "1" )
		DATAMANAGER.RequestNextData("obcsb_oimf_160r_1")
	else
		if edtSTTNNO.caption == "001" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_160r_1", "InBlock1", "RCNO_PIP", 0 , g_RcnoPip )
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_160r_1", "InBlock1", "CONT_CLS_CODE", 0 , "1" )
			DATAMANAGER.RequestTranData("obcsb_oimf_160r_1")
		end if
	end if	

End Function
'============================================================================
Function reset_All()
	Form.SetSharedData("15007s2_OTP", "" )
	Form.SetSharedData("15007s2_OTP_CO_CODE", "" )
	Form.SetSharedData("15007s2_ISNC_ISTU_CODE", "" )
	funcBtnSet(False)
End Function

'============================================================================

'============================================================================
Function enable_All()
	CntnIn.Combo0.enable = True
	CntnIn.Edit0.enable = true
	CntnIn.Combo0.openList()
End Function
'============================================================================
Sub Form_OnTimerEvent(sTimerID) 'v0002
	if sTimerID == 0 or sTimerID == "0" then ' obcsb_oimf_160r_1
		Query2()
		Form.SetTimerEvent(0, 0, 1)
	end if
	
	if sTimerID == 1 or sTimerID == "1" then 'v0003 obcsb_oimf_230r_1
		Query()
		Form.SetTimerEvent(1, 0, 1)
	end if
	
	If sTimerID == 2 Or sTimerID == "2" Then
		DATAMANAGER.RequestTranData("obcsb_oimf_140c_1")
		Form.SetTimerEvent(2, 0, 1)
	End If

	If sTimerID == 9999 Or sTimerID == "9999" Then
		Form.SetTimerEvent2(9999, 0, 0.3)
		CntnIn.scroll_pos = 0
		CntnIn.SetScrollAutoSize()
	End If
End Sub

