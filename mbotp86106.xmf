Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "mbbdm85200_p9_end" Then
		If sRet == "ok" Then
'			Form.OpenScreen("41000" , "")
			Form.CloseForm()
		End If
	End If
	
	If sKeyName == "rslt_ret" And sRet == "OK" Then
		Form.CloseForm()
	End If
End Sub

