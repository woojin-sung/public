'============================================================================
Sub BtnReg_OnClick()
	g_Cnt140 = 0
	DATAMANAGER.RequestTranData("obcsb_oimf_140c")
End Sub

'============================================================================
Sub CntnIn_EdtPwd_OnEditComplete()
	CntnIn.Combo0.caption	= ""
	CntnIn.Edit0.caption		= ""
	CntnIn.Combo0.enable 	= False
	CntnIn.Edit0.enable 		= False
	funcBtnSet(False)
	If CInt(CntnIn.EdtPwd.pwdlen) < 4 Or CInt(CntnIn.EdtPwd.pwdlen) > 8  Then
		Exit Sub
	End If
	DATAMANAGER.RequestTranData("obacp_opop_066r")
End Sub

'============================================================================
Sub CntnIn_Combo0_OnEditComplete(iIndex)
	funcEdtAtvSet(True)
	CntnIn.Edit0.SetShowKeypad(true)
End Sub

'============================================================================
Sub CntnIn_Edit0_OnClick()
	funcEdtAtvSet(True)
End Sub

'============================================================================
Sub CntnIn_Edit0_OnEditComplete()
	Dim tmp_OTP_CNT

	'OTP일련번호 입력 항목 원위치
	funcEdtAtvSet(False)
	
	'안내사항 위치 조정
'	CntnIn.btnGude.Top 	= 467 -40
'	CntnIn.lblGudeBg.Top	= 467 -40
'	CntnIn.imgGudeO.Top	= 467 -40
'	CntnIn.imgGude.Top	= 467 -40
'	CntnIn.cntnGude.Top	= 507 -40

	'20240402 겹치는 현상으로 Top 수정
	CntnIn.btnGude.Top 	= 467 -10
	CntnIn.lblGudeBg.Top	= 467 -10
	CntnIn.imgGudeO.Top	= 467 -10
	CntnIn.imgGude.Top	= 467 -10
	CntnIn.cntnGude.Top	= 507 -10	
	
	If g_RegPrhbYn == "Y" Then
		CntnIn.Edit0.SetResultLabel("1", "error", "메리츠OTP가 등록되어 있어 신규OTP 등록이 불가합니다.", "CntnIn")
		reset_All()
		Exit Sub
	End If
	
	If Trim(CntnIn.Edit0.caption) == "" Then
		CntnIn.Edit0.SetResultLabel("1", "error", "OTP 일련번호를 입력하세요.", "CntnIn")
		reset_All()
		Exit Sub
	Else
		tmp_OTP_CNT = 0
	
		For i = 0 To Grid0.rowcount-1
			If Trim(CntnIn.Edit0.Caption) == Grid0.GetCellData( "bd_cell0", i ) And Trim(CntnIn.Combo0.cbkeydata) == Grid0.GetCellData( "bd_cell1", i ) Then
				If Grid0.GetCellData( "bd_cell2", i ) <> "02010" And Grid0.GetCellData( "bd_cell0", i ) == "2" Then
					CntnIn.Edit0.SetResultLabel("1", "error", "한정용 OTP는 등록 불가합니다.", "CntnIn")
					funcBtnSet(False)
					Exit Sub
				Else
					tmp_OTP_CNT = tmp_OTP_CNT + 1
					g_OTP_statcode	= Grid0.GetCellData( "bd_cell3", i )
					g_OTPUtlzYn	= Grid0.GetCellData( "bd_cell4", i )
				End If
			End If
			
			'V0011 그리드 조회가 모두 된 상태에서 이용등록 상태 조회
			If Grid0.GetCellData( "bd_cell4", i ) == "Y" Then
				If Grid0.GetCellData( "bd_cell2", i ) <> "02010" Then
					g_RplcYn = "5"
				Else
					g_RegPrhbYn = "Y"
				End If
			End If
		Next
		If tmp_OTP_CNT > 0 Then
			If g_OTPUtlzYn == "Y" Then
				CntnIn.Edit0.SetResultLabel("1", "error", "이미 등록 사용중인 OTP 입니다.", "CntnIn")
				funcBtnSet(False)
				tmp_OTP_CNT = 0
			Exit Sub
			Else
				If len(CntnIn.Edit0.caption) > 0 Then
					g_cnt2 = 0 'v0003
					
					DATAMANAGER.SetDataValue(0, "obcsb_oimf_230r", "InBlock1", "ACNO"			, 0, g_tempAcc 			)
					DATAMANAGER.SetDataValue(0, "obcsb_oimf_230r", "InBlock1", "ACNT_PWD"		, 0, CntnIn.EdtPwd.caption 		)
					DATAMANAGER.SetDataValue(0, "obcsb_oimf_230r", "InBlock1", "APRV_YN"			, 0, "N" 				)
					DATAMANAGER.SetDataValue(0, "obcsb_oimf_230r", "InBlock1", "OTP_SUPL_CO_CODE"	, 0, CntnIn.Combo0.cbkeydata 	)
					DATAMANAGER.RequestTranData("obcsb_oimf_230r")
					tmp_OTP_CNT = 0
				End If
			End If
		Else
			CntnIn.Edit0.SetResultLabel("1", "error", "입력하신 OTP정보와 보유OTP정보가 일치하지 않습니다.", "CntnIn")
			funcBtnSet(False)
			tmp_OTP_CNT = 0
			Exit Sub
		End If
	End If
End Sub

