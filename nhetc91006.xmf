				<EDIT name="edtCertPass" password="1" imetype="0" hintcaption="공인인증서 비밀번호" imagefilepth="login_input.9" ly_vert="24,237,262,50,1" />
				<CHKBUTTON name="chkSaveID" fgcolor="071:107107107" fontstyle="01" chkcaption="저장" unchkcaption="저장" checkstate="1" chkbtnimage="login_check_o" unchkbtnimage="login_check_n" ly_vert="295,56,55,39,1" />
				<BUTTON name="btnLogin" caption="로그인" fontsize="1" fontstyle="01" btnimage="btn_11.9" ly_vert="32,331,312,60,1" />
