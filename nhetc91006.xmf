Sub lblDeviceID_OnClick()
	Form.OpenPopup("nhetc91006_p1" , g_sDeviceID , "")	
End Sub

'============================================================================
Sub lblCertCenter_OnClick()
	Form.OpenFramePopup("mhetc90060" , "" , "")
End Sub

'============================================================================
Sub Image5_OnClick()
	sLoginID = Form.GetSharedData("&USER_ID", 0)
	
	if Trim(sLoginID) == "" then
		Form.MsgBox("알림", "최초 1회 로그인이 필요합니다.", "", 0)			
	else
		Form.CloseForm()
	end if		
End Sub


