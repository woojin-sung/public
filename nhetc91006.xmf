		<LABEL name="lblMts" fgcolor="071:107107107" fontsize="-1" fontstyle="01" caption="메리츠SMART" halign="1" click="1" ly_vert="231,561,99,28,1" />
		<LABEL name="Label4" bgcolor="017:216216216" transmode="0" ly_vert="224,568,1,12,1" />
