	<SCRIPT_INFO _len="22420" _ulen="18716" >
'============================================================================
' 2020.02.14 : 길병철 
'              고유MTS 직원로그인 개발
'============================================================================

Dim g_sID
Dim g_sPass
Dim g_sBsnsPass
Dim g_sCertPass
Dim g_sDeviceID
Dim g_sBIOTermOS
Dim g_bExpiredChecked		'공인인증서 만료일자 안내 팝업

Dim g_sDplcPrms			'중복접속허용여부
Dim g_sRCNO
Dim g_sUserName
Dim g_sCSNO
Dim g_sDN
Dim g_SSTM_Date

'============================================================================
Sub Form_OnFormInit()
	ContainerID.edtID.imagefilepth			= "login_input.9.png"
	ContainerID.edtPass.imagefilepth 		= "login_input.9.png"
	ContainerID.edtBsnsPass.imagefilepth 	= "login_input.9.png"
	ContainerID.edtCertPass.imagefilepth 	= "login_input.9.png"
	
	g_sID 				= ""
	g_sPass 				= ""
	g_sBsnsPass 			= ""
	g_sCertPass 			= ""
	
	g_sBIOTermOS 			= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS

	sVersion				= Form.GetSharedData("&APP_VERSION", 0)
	Label1.caption		= "Ver " & sVersion
	
	bSaveId				= Form.GetEnvData("login.input.saveid")
	
	'------------------------------------------------------------------
	'ID, ID저장체크박스 
	if bSaveId <> null and bSaveId <> "" then
		if bSaveId == "1" then
			Form.SetCtlProp("ContainerID.chkSaveID"		, "checkstate", bSaveId)
			
			sId = Form.GetEnvData("login.input.userid") 

			if sId <> null and sId <> "" then
				Form.SetCtlProp("ContainerID.edtID"		, "caption", sId)
			else
				Form.SetCtlProp("ContainerID.edtID"		, "caption", "")
			end if	
		
		elseif bSaveId == "0" then
			Form.SetCtlProp("ContainerID.chkSaveID"		, "checkstate", bSaveId)
		end if
		
	end if
	
	g_bExpiredChecked = True	
	
	'------------------------------------------------------------------
	'MTS 위변조방지 스킵 대응
	szDev 		= Form.GetSharedData("&SERVER_MODE", False)
	szAppVer 	= Form.GetSharedData("&APP_VERSION_CODE", False)
	szPrivateKey	= "vjdDoV5kQc7lNK4VARxk0TSWA4k=\n"
	
	g_sDeviceID = Trim(Form.GetDeviceID())
	
	if szDev <> "1" and g_sBIOTermOS == "1" then
		szKeyValue = Form.GetSharedData("&KEY_VALUE", False)
		if trim(szPrivateKey) <> trim(szKeyValue) then
			Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
			Form.SetSharedData("&SGB" , "BBE") 
			
			Form.sendItemPrice()			'App 종료API 추가 (네이밍무관)
			Form.sendMessage()			'App 종료API 추가 (네이밍무관)
			Form.TerminateApp()
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Edit0.caption = "end" '20190702_01 KBC : 이것을넣어야 로그인창이 빨리 닫힘.임시추가 (visible false주면 다시 느림)
End Sub

'============================================================================
Sub ContainerID_btnLogin_OnClick()

	g_sID = Form.GetCtlProp("ContainerID.edtID", "caption")
	
	if g_sID == null or g_sID == "" then
		Form.MsgBox("알림", "사번을 입력하세요.", "", 0)
		exit sub
	end if	


'KBC임시
if g_sID == "semijoin" then
	ContainerID.edtPass.caption = "test1357"
	ContainerID.edtBsnsPass.caption = "1111"
	ContainerID.edtCertPass.caption = "stock 780 !!"
elseif g_sID == "5358" then
	ContainerID.edtPass.caption = "1111"
	ContainerID.edtBsnsPass.caption = "1111"
	ContainerID.edtCertPass.caption = "stock 780 !!"	
end if


	g_sPass = Form.GetCtlProp("ContainerID.edtPass", "caption")
	
	if g_sPass == null or g_sPass == "" then
		Form.MsgBox("알림", "접속비밀번호를 입력하세요.", "", 0)
		exit sub
	end if	
	
	g_sBsnsPass = Form.GetCtlProp("ContainerID.edtBsnsPass", "caption")
	
	if g_sBsnsPass == null or g_sBsnsPass == "" then
		Form.MsgBox("알림", "업무비밀번호를 입력하세요.", "", 0)
		exit sub
	end if	
	
	g_sCertPass = Form.GetCtlProp("ContainerID.edtCertPass", "caption")
	
	if g_sCertPass == null or g_sCertPass == "" then
		Form.MsgBox("알림", "공인인증 비밀번호를 입력하세요.", "", 0)
		exit sub
	end if

	DATAMANAGER.SetDataValue(0, "obcpp_logn_024a", "InBlock1", "USER_ID"			, 0	, g_sID)						'사번
	DATAMANAGER.SetDataValue(0, "obcpp_logn_024a", "InBlock1", "CONN_PWD"		, 0	, Form.GetEncData(g_sPass))		'접속비밀번호
	DATAMANAGER.SetDataValue(0, "obcpp_logn_024a", "InBlock1", "ODER_PWD"		, 0	, Form.GetEncData(g_sBsnsPass))	'업무비밀번호
	DATAMANAGER.SetDataValue(0, "obcpp_logn_024a", "InBlock1", "QTTN_EXUS_LOGN_YN", 0	, "N") 						'시세조회전용여부
	DATAMANAGER.SetDataValue(0, "obcpp_logn_024a", "InBlock1", "TERM_IDNT_KEY"	, 0	, g_sDeviceID)				'단말식별키
	
	DATAMANAGER.RequestTranData("obcpp_logn_024a") '로그인 TR	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'로그인 TR
	if szTranID == "obcpp_logn_024a" then	
		Form.SetSharedData("&CERT_USE_TYPE" , "0") '0.공인인증서(ID로그인,인증서로그인) 1.간편인증(공인인증서) 2.코스콤지문(공인인증서) 3.결제원(FIDO인증서) 4.금투협(공동인증서)
		
		sMsg		= DATAMANAGER.GetDataMsgText(szTranID)
		sSubMsg	= DATAMANAGER.GetDataMsgSubText(szTranID)
	
		'접속허용구분 코드
		sClscode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CONN_PRMS_CLS_CODE" ,0)
		
		'부정접속 관련 대응-로그인 실패시
		if sClscode <> "0" then
			Call LoginFailSendHWInfo(g_sID)
		end if

		Select Case  sClscode
			Case  "0" '접속허용(정상로그인)
				Form.SetEnvData(1,"login.input.userid",g_sID)
			Case  "1" '등록되지 않은 ID
				Form.ShowAlert("알림", "등록되지 않은 사번입니다. 사번을 확인하시기 바랍니다.")
				exit sub
			Case  "2" '접속비밀번호 오류
				sPassErrCnt		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PWD_ERR_TMNU" ,0)
				sPassAbleErrCnt	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PWD_MSTK_ABLE_TMNU" ,0)
				
				Form.ShowAlert("알림", "접속비밀번호 " & CInt(sPassErrCnt) & "회 오류입니다.\n연속 " & CInt(sPassAbleErrCnt) & "회 오류 시 접속이 제한됩니다.\n\n접속비밀번호를 모르시는 경우에는 \meritzOne에서 재발급 받을 수 있습니다.")
				exit sub
			Case  "3" '접속비밀번호 오류 초과
				Form.ShowAlert("알림", "접속비밀번호 " & CInt(sPassAbleErrCnt) & "회 초과입니다.\n\nmeritzOne에서 재발급 받으시길 바랍니다.")
				exit sub
			Case  "5" '비밀번호를 입력 하지 않았을경우
				Form.ShowAlert("알림","비밀번호를 입력하세요.")
				exit sub
			Case  "8" '미등록 단말
				Form.ShowAlert("알림" , "[TR] " & sMsg)
				exit sub
			Case  "A"
				Form.MsgBox("알림", "시스템 점검시간 " & sSubMsg & "동안은 \n시세조회 전용으로 로그인 됩니다.\n계좌정보 조회 및 이체서비스는\n시스템 점검시간 이후 재접속하셔야만\n이용 가능합니다.", "CheckSystem", 0)
				exit sub
			Case else ' 알 수 없는 오류
				Form.ShowAlert("알림",  "[TR] " & sMsg)
				exit sub
		End Select	
		
		'비밀번호 초기화시에는 체크 않함
		sPassInit = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CONN_PWD_INIT_YN" ,0)
		
		if sPassInit == "N" then
			sWarnCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CONN_WARN_CLS_CODE" ,0)
			
			if sWarnCode == "1" then
				Form.ShowAlert("알림","접속비밀번호가 6~8자리가 아닙니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			elseif 	sWarnCode == "2" then
				Form.ShowAlert("알림","접속비밀번호가 주민등록번호와 4자리 이상이 일치합니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			elseif 	sWarnCode == "3" then
				Form.ShowAlert("알림","연속 또는 같은 영문자 혹은 숫자의 접속비밀번호입니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			elseif 	sWarnCode == "4" then
				Form.ShowAlert("알림","사용자ID와 접속비밀번호가 중복되어 사용하고 있습니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			elseif 	sWarnCode == "5" then
				Form.ShowAlert("알림","계좌번호와 접속비밀번호가 중복되어 사용하고 있습니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			elseif 	sWarnCode == "6" then
				Form.ShowAlert("알림","접속비밀번호가 고객의 전화번호와 중복되어 사용되고 있습니다.\n\n타인에게 누출 될 가능성이 있사오니 접속비밀번호를 변경하시기 바랍니다 !")
			end if
		end if
		
		g_sDplcPrms	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DPLC_CONN_PRMS_YN" ,0)	'중복접속허용여부
		g_sRCNO		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RCNO" ,0)				'실명확인번호
		g_sUserName	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "USER_NAME" ,0)			'사용자명
		g_sCSNO		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CSNO" ,0)				'고객번호
		g_sDN		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DN_DATA" ,0)			'DN Data
		g_SSTM_Date	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SSTM_DATE" ,0)			'시스템일자

		sCheckState = Form.GetCtlProp("ContainerID.chkSaveID", "checkstate")
		Form.SetEnvData(1, "login.input.saveid",sCheckState)
		
		'공인인증 기관 장애 여부
		sCertSkip = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "AUTH_ATHN_ISTU_DSBL_YN" ,0)
		
		if sCertSkip == "Y"  and  g_sSiseCheck == "0" then
			Form.MsgBox("알림", "현재 공인인증센터 장애로 인해 전자서명을 사용하지 않고 접속합니다.", "certskip", 2)
		else
			'공인인증 비밀번호 오류횟수 초과처리
			nFailCnt = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PBCR_PWD_MSTK_TMNU" ,0))
			
			if (nFailCnt >= DEF_CERT_PSWD_LIMIT_CNT) then
				Form.ShowAlert("알림", "공인인증서 비밀번호 \n최대 오류횟수(" & tonumber(DEF_CERT_PSWD_LIMIT_CNT) &"회) 초과로 \n접속이 제한됩니다.")
			else
				Form.RequestCertCommand("ReqCheckIsValidPassword", g_sDN, g_sCertPass) '로그인 정상 시 인증서 체크시작
			end if
		end if
		
	elseif szTranID == "obcpp_pcrt_166a" then
		'상태구분코드
		sStatCode =  DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "STAT_CLS_CODE" ,0)

		if sStatCode == "Y" then
			Form.Toast(0, "로그인 성공" , 0)

			'=======================================
			'공인인증서 만료기일 도래 안내 팝업 제공
			'=======================================
			if CheckCertExpired(g_sDN) == False Then
				g_bExpiredChecked = False
			end if
			
			Request_obcpp_logn_010a()
		else 
			Form.ShowAlert("알림","유효하지 않은 인증서로 인하여 로그인이 취소되었습니다.")
		end if
		
	elseif szTranID == "obcpp_logn_015a" then
		'공인인증서 비밀번호 오류횟수
		sMstk =  DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PBCR_PWD_MSTK_TMNU" ,0)

		nCount = CInt(sMstk)
		
		if nCount >  0 then
			Form.ShowAlert("알림", "공인인증서 비밀번호 " & tonumber(sMstk) & "회 오류입니다.\n연속 5회 오류시 접속이 제한됩니다.")	
		end if
	
	'최종접속일
	elseif szTranID == "obcpp_logn_010a" then
		sNatnCD =  DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "NTNT_ISO_SHRN_CTCD" ,0)
		
		Form.SetSharedData("&NATIONAL_CD" , sNatnCD)	'국가코드
		
		Form.RequestCommand("NEW_EMGR_MSG", "", "")	'긴급메시지처리
		Form.RequestCommand("DEVICE_LOG", "", "") 	'기기정보 로깅추가	
		Form.SendHWInformation("001", "")			'FDS 로깅추가 (001.로그인, 002.이체/대체, 003.인증서(재)발급, 004.주소/연락처 변경)
												'!!! FDS 로깅은 국가정보조회 이후에 있어야 한다
		
		sDay =  DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CONN_YMDH" ,0)
		
		Form.Toast(0,"최종접속일 : " & sDay , 0)

		
		call Request_obtrd_acnt_326r( ) 			'해외파생 고객별 시세신청 거래소 조회
	
	elseif szTranID == "obtrd_acnt_326r" then 
		Form.CloseForm()
	end if		
		
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)


	'KBC임시 START
'	if szTranID == "obcpp_logn_024a" then	
'		Form.SetSharedData("&CERT_USE_TYPE" , "0") '0.공인인증서(ID로그인,인증서로그인) 1.간편인증(공인인증서) 2.코스콤지문(공인인증서) 3.결제원(FIDO인증서) 4.금투협(공동인증서)
'		
