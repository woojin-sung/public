				<LABEL name="Label7" visible="0" fgcolor="071:107107107" caption="공인인증서 비밀번호" ly_vert="20,227,205,19,0" />
				<EDIT name="edtBsnsPass" password="1" imetype="0" hintcaption="업무비밀번호" imagefilepth="login_input.9" ly_vert="24,173,262,50,1" />
				<LABEL name="Label8" visible="0" fgcolor="071:107107107" caption="업무비밀번호" ly_vert="20,164,205,19,0" />
			</CONTROL_INFO>
