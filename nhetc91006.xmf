'============================================================================
'해외파생 고객별 시세신청 거래소 조회
Sub Request_obtrd_acnt_326r( )
	DATAMANAGER.SetDataValue( 0 , "obtrd_acnt_326r" , "InBlock1" , "ELFN_ID" , 0 , g_sID )	
	DATAMANAGER.RequestTranData( "obtrd_acnt_326r" )
End Sub	


'============================================================================
' 부정접속 관련 대응
Sub LoginFailSendHWInfo(szID)
	Form.SetSharedData("&NATIONAL_CD" , "no")
	Form.SendHWInformation("005", szID)	
End Sub

'============================================================================
'인증서 만료 기간 체크 로직 추가
Function CheckCertExpired(s_DN)
	sExpired = Trim(Form.getCertificateCheckExpired(s_DN)) '0:유효, 1:만료, 2:만료예정

	if sExpired == "0" Then
		return True
		
	elseif sExpired == "1" or sExpired == "2" Then
		sExDate = Form.getCertificateExpiredDate(s_DN)

		sData = sExpired & "★" & sExDate

		Form.OpenPopup("mhetc90021_p2", sData, "")
		return False
	end if	
End Function

'============================================================================
Sub Form_OnCertEvent(sType  , sSucces , stext)
	if sType == "RetIsCertPasswordValid" then
		if sSucces == "Success" then  '성공
			Form.SetEnvData(1,"login.input.userid",g_sID)
			Form.SetCertDNPW(g_sDN, g_sCertPass)

			Request_obcpp_logn_015a("Y")
			Request_obcpp_pcrt_166a()
			
		elseif sSucces == "Failed" then '비밀번호 오류
			Request_obcpp_logn_015a("N")
				
		elseif sSucces == "Error" then ' 인증서 없음
			Form.OpenDialog("mhetc90020_perr", "", "") '공인인증서 없음 처리
		end if
	end if
End Sub

'============================================================================
'공인인증서 검증 요청
Sub Request_obcpp_pcrt_166a()
	szTranID = "obcpp_pcrt_166a"

	sRValue		= Form.GetRvalue(g_sDN , g_sCertPass)
	sSignData 	= Form.GetCertSignData(g_sDN , g_sCertPass)
	sSerialNum	= Form.GetCertSerialNumber(g_sDN)

	DATAMANAGER.SetUserID(g_sID)	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "USER_ID" 				, 0 , g_sID)			'사용자ID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO"					, 0 , g_sRCNO) 		'실명확인번호
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "USER_NAME"				, 0 , g_sUserName)	'사용자명
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO"					, 0 , g_sCSNO) 		'고객번호
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_R_VAL" 				, 0 , sRValue)		'R 값	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_ELCT_SGNT_DATA_CNTT" 	, 0 , sSignData)		'전자서명데이타
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "NTAT_SRNO" 				, 0 , sSerialNum)		'인증서 일련번호	

	'공인인증검증 TR
	DATAMANAGER.RequestTranData(szTranID)
End Sub

'============================================================================
' MTS 로그인 공인인증서 접속로그  TR
Sub Request_obcpp_logn_015a(szSucs_YN)
	DATAMANAGER.SetDataValue(0, "obcpp_logn_015a", "InBlock1", "USER_ID" , 0 , g_sID) 	'사용자ID
	DATAMANAGER.SetDataValue(0, "obcpp_logn_015a", "InBlock1", "SUCS_YN" , 0 , szSucs_YN) 	'성공여부
	DATAMANAGER.SetDataValue(0, "obcpp_logn_015a", "InBlock1", "ATHN_MDIA_TYPE_CODE" , 0 , "  ")
	
	DATAMANAGER.RequestTranData("obcpp_logn_015a")
	
	'부정접속 관련 대응-로그인 실패시
	if szSucs_YN <> "Y" then
		Call LoginFailSendHWInfo(g_sID)
	end if
End Sub

'============================================================================
'최종접속정보 조회   TR
Sub Request_obcpp_logn_010a()
	DATAMANAGER.SetDataValue(0, "obcpp_logn_010a", "InBlock1", "USER_ID"	, 0 , g_sID)
	DATAMANAGER.SetDataValue(0, "obcpp_logn_010a", "InBlock1", "IPAD"	, 0 , Form.GetSharedData("&IP_ADDRESS", 0))
	DATAMANAGER.RequestTranData("obcpp_logn_010a")
End Sub	

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)	
	if sKeyName == "Login_Close" then
		g_sDN = Form.GetSharedData("CERT_DN", 0)
		
		Form.SetEnvData(1,"login.input.userdn",g_sDN)
		procSelectedCert(g_sDN)
	
	'공인인증서 없음 처리
	elseIf sKeyName == "pError" then
		If sRet == "Cert" then
			'KBC : CloseForm 먼저 하지 말아라. 안드로이드에서 null참조오류난다.
			Form.OpenScreen("90060" , "")
			Form.CloseForm()
		End If
	
	'=======================================================================================================
	'공인인증서 만료안내 팝업 제공
	'=======================================================================================================		
	elseif sKeyName == "mhetc90021_p2" then
		g_bExpiredChecked = True
		
		if g_bCloseForm And g_bExpiredChecked then '20190522_04 KBC : 팝업분리
			Form.CloseForm()
		end if
	
	'ElseIf sKeyName == "Login_Cert_Select" Then
	end if
End Sub

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName == "KS" then '인증서로그인(비번리턴됨)
		g_sCertPass = sReturn2
		
		'인증서 특수기호 ">"종료글자 오류회피
		sCertPass = Form.GetSharedData("CERT_IMSI_PSWD", 1)
		
		if sCertPass <> null and sCertPass <> "" then
			g_sCertPass = sCertPass
		end if
		
		if g_sCertPass <> "" then
			Form.RequestCertCommand("ReqCheckIsValidPassword", g_sDN, g_sCertPass)
		end if
	end if
End Sub

