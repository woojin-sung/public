		<LABEL name="lblCertCenter" fgcolor="071:107107107" fontsize="-1" fontstyle="01" caption="인증관리센터" halign="1" click="1" ly_vert="45,561,89,28,1" />
		<LABEL name="Label0" visible="0" caption="'로그인 사이즈 375 X 647" ly_vert="15,8,205,19,0" />
		<LABEL name="LabelTitleCert" fontsize="10" fontstyle="01" caption="직원인증" multiline="1" ly_vert="17,29,145,64,1" />
		<EDIT name="Edit0" imetype="0" ly_vert="1010,580,1,1,1" />
		<LABEL name="lblBottomLogo0" fgcolor="071:107107107" fontsize="-2" fontstyle="01" caption="MERITZ Securities co.,LTD." halign="1" click="1" ly_vert="72,603,221,28,1" />
		<LABEL name="Label6" bgcolor="017:216216216" transmode="0" ly_vert="139,568,1,12,1" />
