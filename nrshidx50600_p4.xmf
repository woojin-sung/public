	<SCRIPT_INFO _len="14099" _ulen="12783" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주식현재가 관심종목 삭제
' 02. 화면설명 : 관심종목 삭제 팝업
' 03. 작    성 : 2023.05.25 KKM
'-------------------------------------------------------------------------------------------
'20230728 KKM grdGroup -> grdGroup0 로 변경

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCloud		' 관심동기화(0:미사용(로컬), 1:사용(서버))

Dim g_szCode, g_szAction
g_szCode = ""
g_szAction = "DEL" ' ADD: 추가, DEL: 삭제

Dim g_szRow
Dim g_szGroupID, g_szGroupName

Dim g_szUserId
g_szUserId = Form.GetSharedData("&USER_ID" , false)

'20240221 START
Dim g_nIndex
g_nIndex = -1

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' Load_GWGroup :  로컬에 저장된 관심그룹 가져오기
'============================================================================
Function Load_GWGroup()
	Dim tGroup, tList
	
	grdGroup0.rowcount = 0	
	szGroup = Form.LoadConfigData("GWANSIM", "GROUP")
	
	if Trim(szGroup ) <> "" then
		tGroup = Split(szGroup, "♣")
		
		k = 0
		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★") '그룹아이디
			grdGroup0.insertrow = i
			grdGroup0.SetCellData("bd_code",  i, tList(0))
			grdGroup0.SetCellData("bd_name",  i, tList(1))
			grdGroup0.SetCellData("bd_count", i, tList(2))
		Next
	end if
	
	'grdGroup0selectrow = 0
	'grdGroup_OnClickUp(0, "bd_name")
	
End Function	

'============================================================================
' Save_GWGroup :  관심그룹을 로컬에 저장
'============================================================================
Function Save_GWGroup()
	For i = 0 to grdGroup0.rowcount-1
		szCode = grdGroup0.GetCellData("bd_code",  i)
		szName = grdGroup0.GetCellData("bd_name",  i)
		szCnt  = grdGroup0.GetCellData("bd_count", i)
		if i == 0 then
			szGroup = szCode & "★" & szName & "★" & szCnt
		else
			szGroup = szGroup & "♣" & szCode & "★" & szName & "★" & szCnt
		end if
	Next
	
	Form.SaveConfigData("GWANSIM", "GROUP", szGroup)
End Function

'============================================================================
' Delete_GWAll : 해당 관심종목을 추가되었던 모든 관심그룹에서 삭제 
'============================================================================
Function Delete_GWAll()
	Dim szGroupID, szGroup
	Dim tGroup, tList
	Dim szSaveList, szCd, szMk, szName, szMemo

     '추가되었던 관심그룹들 
	For i = 0 to grdGroup0.rowcount-1
		szGroupID = grdGroup0.GetCellData("bd_code", i) '관심그룹id
		szGroup = Form.LoadConfigData("GWANSIM", szGroupID)
		
		grdList.rowcount = 0		
		if szGroup <> "" then
			tGroup = Split(szGroup, "♣")
			k = 0
			For j = 0 to #tGroup-1
				tList = Split(tGroup(j), "★")
				if g_szCode <> tList(0) then '해당 관심종목제외해 삭제하기
					
					grdList.insertrow = k
					if Trim(tList(0)) == "" or Trim(tList(0)) == "빈칸" or Trim(tList(0)) == "EMPTY" then
						szCd = ""						
						szMk = ""
						szName = tList(2)
						szMemo = tList(2)
						
					else
						szCd = tList(0)						
						szMk = tList(1)
						szName = Form.GetItemCodeInfo(tList(0), "name")	' 종목명은 저장 안하므로 메인에서 가져온다.
						szMemo = ""
					end if
					
					if k == 0 then
						szSaveList = szCd  & "★" & szMk & "★" & szMemo & "★" & szName
					else
						szSaveList = szSaveList & "♣" & szCd & "★" & szMk & "★" & szMemo & "★" & szName
					end if	
					
					k = k + 1
				end if
			Next
			Form.SaveConfigData("GWANSIM", szGroupID, szSaveList)	 'szGroupID그룹의 관심종목들 로컬저장		
			
			' 동기화 시는 파일 저장만.. /////////////////////////////////////////////
			if g_szCloud == "0" then
				szChange = Form.GetCtlProp("#edtChange", "caption")
					
				' 그룹편집(1)이 된 상태이면 그룹도 조회해야하기 때문에 그룹편집이 안된상태일때 종목편집(0)조건을 넣어준다.
				if szChange <> "1" then
					Form.SetCtlProp("#edtChange", "caption", "0")
				end if
				
				For j = 0 to grdGroup0.rowcount-1
					szCd = grdGroup0.GetCellData("bd_code", j)					
					if szGroupID == szCd then
						if k <> 0 then
							grdGroup0.SetCellData("bd_count", j, k-1)
						else
							grdGroup0.SetCellData("bd_count", j, 0)
						end if 
						Exit For
					end if
				Next
			end if
		end if
	Next	
	
	Save_GWGroup() ' 모든 관심그룹에서 관심종목수 로컬 재저장
	
	'20240221 START
	Form.SendReturnToParent("GWAN_DELETE_COMPLETE" , g_nIndex)
	
	Form.Toast(2, "관심종목이 삭제되었습니다.", true)	
	Form.CloseForm()	
	
End Function

'============================================================================
' Check_LocalOrServer : 로컬, 서버 구분하여 종목을 편집한다.
'============================================================================
Function Check_LocalOrServer()
	if g_szCloud == "1" then
		'200230518 KKM 모든 관심그룹에서 해당 관심종목 삭제
		DATAMANAGER.RequestTranData("ohhts_intr_103r")
	else
		Delete_GWAll()
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim szData, arrData 

	szData = Form.GetOpenLinkData()	
	if Trim(szData) = "" then
	    Exit sub
	End if
	
	'20230516 HSZ START 	: 관심종목 삭제 로직 추가 - 기존화면에서는 종목코드만 넘겨줌
	szInstr = CInt(Instr(szData, "★"))
	if szInstr > 0 then	'추가로직
		arrData = Split(szData, "★")	
		g_szCode = arrData(0)		'종목코드
		g_szAction = arrData(1)	'관심종목추가(ADD) or 삭제(DEL)
		
		'20240221 START
		'처리행
		g_nIndex = arrData(2)
		
	else					'기존로직
		BtnClose.btnimage = "alpha128"
		g_szCode = szData
		g_szAction = "DEL"
	end if
	
	'20230516 HSZ END
	
	' 관심 동기화 //////////////////////////////////////////////////////////
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	' //////////////////////////////////////////////////////////////////////
	
	' 그리드 로우 위치 변경 위한 속성
'	grdGroup0.rowmove = "1"	
	if g_szCloud == "1" then		' Server 저장시	
		'관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
		'20230728 KKM FID 버전ID 필요
		DATAMANAGER.RequestTranData("ohhts_intr_006r")	
		'종목이 속한 관심그룹명 조회 
		DATAMANAGER.RequestTranData("ohhts_intr_101r")
	else							' Local 저장시
		' 로컬 저장된 관심그룹 가져오기	
		Load_GWGroup()
	end if
	
End Sub

function GetGubunCode(szCode)
	'szGubun 세팅(OV: 해외주식, KR: 그 외)
	if CInt(Instr(szCode, "@")) > 0 then	'@ 포함된 종목코드(해외주식, 해외지수 등)
		tCode = Split(szCode, "@")
		if UBOUND(tCode) < 1 then
			Exit Function 
		End if
		szMk  = tCode[0]
		if Trim(szMk) == "" then
			Exit Function
		else
			nMkLen = Form.getLen(szMk)
			if nMkLen = 2 then
				szGubun = "OV" '해외주식(마켓구분 2자리)
			else
				szGubun = "KR"
			end if
		end if
	else
		szGubun = "KR"
	end if 
	
	return szGubun	
end function	

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
		g_szGroupID = "" 
		g_szGroupName = ""	
		grdGroup0.rowcount = 0	' 그룹그리드 초기화	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, g_szUserId)	' USER ID
'	elseif szTranID == "ohhts_intr_007r" then
'		DATAMANAGER.ClearInputData(0, "ohhts_intr_007r")
'		
'		grdList.rowcount = 0	' 종목그리드 초기화
'		
'		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_USER_ID",          0, g_szUserId)	' USER ID	
'		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_CNCN_ISSU_NEW_GRP_ID", 0, g_szGroupID)	
	elseif szTranID = "ohhts_intr_101r" then '해당 종목이 추가된 관심그룹조회
		g_szGroupID = "" 
		g_szGroupName = ""	
		grdGroup0.rowcount = 0	' 그룹그리드 초기화
		
		szOV = GetGubunCode(g_szCode)
		If szOV == "OV" Then '해외
			tCode = Split(g_szCode, "@")
			DATAMANAGER.SetDataValue( 0, "ohhts_intr_101r", "InBlock1", "FID_OVDV_ISCD", 0 , tCode(1) )	
			szMk = tCode(0)
			szMk = f_getExchCode2(szMk)	
		else
			DATAMANAGER.SetDataValue( 0, "ohhts_intr_101r", "InBlock1", "FID_OVDV_ISCD", 0 , g_szCode	)	
			szMk = Form.GetItemCodeInfo(g_szCode, "market")
			szMk = Change_EtcMarket(szMk)
		end if 
		'20230816 KKM 입력시장구분코드 추가 
		DATAMANAGER.SetDataValue(0, "ohhts_intr_101r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE"	, 0 , szMk)
	
		DATAMANAGER.SetDataValue( 0, "ohhts_intr_101r", "InBlock1", "FID_USER_ID", 0 , g_szUserId 	)
		
	elseif szTranID == "ohhts_intr_103r" then  '모든 관심그룹내에서 해당 종목 삭제
		DATAMANAGER.ClearInputData(0, "ohhts_intr_103r")		
		grdList.rowcount = 0	' 종목그리드 초기화
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_103r", "InBlock1", "FID_USER_ID" , 0 , g_szUserId )
		DATAMANAGER.SetDataValue(0, "ohhts_intr_103r", "InBlock1", "FID_VRSN_ID"	, 0 , edtvrsnID.caption)
		
		szOV = GetGubunCode(g_szCode)
		If szOV == "OV" Then '해외		
			tCode = Split(g_szCode, "@")
			DATAMANAGER.SetDataValue(0, "ohhts_intr_103r", "InBlock2", "FID_OVDV_ISCD", 0 , tCode(1) )
			szMk = tCode(0)
			szMk = f_getExchCode2(szMk)			
		else
			DATAMANAGER.SetDataValue(0, "ohhts_intr_103r", "InBlock2", "FID_OVDV_ISCD", 0 , g_szCode )		
			szMk = Form.GetItemCodeInfo(g_szCode, "market")
			szMk = Change_EtcMarket(szMk)
		end if 
		'20230728 KKM 입력시장구분코드 추가 
		DATAMANAGER.SetDataValue(0, "ohhts_intr_103r", "InBlock4", "FID_INPUT_MRKT_CLS_CODE"	, 0 , szMk)
		
		For i = 0 to grdGroup0.rowcount-1
			szGroupID = grdGroup0.GetCellData("bd_code", i) '관심그룹id		
			DATAMANAGER.SetDataValue(0, "ohhts_intr_103r", "InBlock3", "FID_CNCN_ISSU_NEW_GRP_ID", i , szGroupID )
		Next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "ohhts_intr_006r" Then  '그룹조회
		'grdGroup0.selectrow = 0		
		'grdGroup_OnClickUp(0, "bd_name")
	ElseIf szTranID = "ohhts_intr_101r" then 
		'grdGroup0.selectrow = 0		
		'grdGroup_OnClickUp(0, "bd_name")
	ElseIf szTranID = "ohhts_intr_103r" then
		'로컬에서 모든 관심그룹내에서 해당 종목 삭제
		Delete_GWAll()
	End If	
	'20230530 KKM 편집시 ID가 메인화면과 연동안되는부분 때문에 추가
	If szTranID == "ohhts_intr_006r" or szTranID == "ohhts_intr_009r" or szTranID == "ohhts_intr_103r" Then	
		Form.SetSharedData("VRSN_ID", edtvrsnID.caption) 		
	End if 	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

End Sub

