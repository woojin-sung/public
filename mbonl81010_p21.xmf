					<CELL_INFO>
						<CELL cell_ly="0,0,0,4" caption="모든
상품" impidxs="" />
						<CELL cell_ly="1,0,1,0" valign="2" halign="0" line="1,0" caption="1. 국가/ 한국은행/ 금융소비자보호법상 
    금융회사(집합투자업자 미포함)
2. 금융위가 주무기관인 공공기관/ 금감원
3. 한국수출입은행/ 한국투자공사/ 거래소/ 
   신용보증기금/ 기술보증기금
4. 금융지주회사/ 집합투자업자/ 집합
   투자기구/ 증권금융회사/ 자금중개회사
5.신협·농수협·산림조합·새마을금고·
   상호저축은행 중앙회/ 금융권협회" fontsize="-3" impidxs="" />
						<CELL cell_ly="1,1,1,1" fgcolor="011:030080200" valign="0" halign="0" line="1,0" caption="※ 농수협·산림조합·새마을금고·
   상호저축은행은 1번에 금융회사에 해당" fontsize="-3" impidxs="" />
						<CELL cell_ly="1,2,1,2" halign="0" caption="6. 외국정부/ 국제기구/ 외국 중앙은행 등 
   금융소비자보호 감독규정 제2조 
   제6항제13호 각 목에 해당하는 외국인 
   또는 이에 준하는 외국인" fontsize="-3" impidxs="" />
						<CELL cell_ly="1,3,1,3" halign="0" caption="7. 주권상장법인
8. 지방자치단체
9. 법률상 기금 관리 운용 공공기관
   (기보, 신보 제외)
10. 법률상 공제사업 영위 법인·조합·단체
11. 주권을 외국증권시장에 상장한 법인" fontsize="-3" impidxs="" />
						<CELL cell_ly="1,4,1,4" halign="0" caption="15. 단기금융회사/ 온라인투자연계금융업자
16. 대부업자/ 신용협동조합" fontsize="-3" impidxs="" />
						<CELL cell_ly="0,5,0,8" bgcolor="035:237246255" caption="투자성
상품" impidxs="" />
						<CELL cell_ly="1,5,1,5" bgcolor="035:237246255" valign="2" halign="0" line="1,0" caption="12. 법인(단체) 전문투자자(금융투자협회 지정)
13. 개인 전문투자자(금융투자회사 지정)" fontsize="-3" impidxs="" />
						<CELL cell_ly="1,6,1,6" bgcolor="035:237246255" valign="0" halign="0" caption="※ 일반 전환 시 전문투자자분류(전환 신청서 작성)" fontsize="-4" impidxs="" />
						<CELL cell_ly="1,7,1,7" bgcolor="035:237246255" halign="0" caption="14. 전자등록기관" fontsize="-3" impidxs="" />
