		<IMAGE name="imgMain" imgpath="popup_bg.9" ly_vert="0,20,375,672,1" />
		<LABEL name="lblHead0" fontsize="1" fontstyle="01" caption="· 일반금융소비자란?" multiline="1" paddinginfo="1,0,0,0" ly_vert="24,100,324,24,1" />
		<LABEL name="Label0" caption="전문금융소비자가 아닌 금융소비자를 말합니다." ly_vert="24,124,324,24,1" />
		<LABEL name="lblHead1" fontsize="1" fontstyle="01" caption="· 전문금융소비자란?" multiline="1" paddinginfo="1,0,0,0" ly_vert="24,160,324,24,1" />
		<LABEL name="Label1" caption="금융상품에 관한 전문성 또는 소유자산규모등을 고려했을 때 금융상품 계약에 따른 위험을 감수할 수 있는 능력이 있는 금융소비자를 의미하며, 국가, 지방자치단체, 금융회사, 주권상장법인 등이 이에 해당됩니다." multiline="1" ly_vert="24,184,324,95,1" />
		<LABEL name="lblHead2" fontsize="1" fontstyle="01" caption="■ 전문금융소비자 상세 유형" paddinginfo="1,0,0,0" ly_vert="28,288,204,30,1" />
		<CONTAINER name="cont0" visible="0" vscroll="1" scroll_pos="0,0" ly_vert="338,300,335,255,0" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<TABLE name="Table0" insidelinecolor="102:255255255" colcount="2" rowcount="11" designorder="1" ly_vert="0,0,335,505,1" >
