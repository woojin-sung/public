	<SCRIPT_INFO _len="2795" _ulen="2455" >
'--===========================================================================
' 01. 화 면 명 : 지정신청심사
' 02. 화면설명 : 신분증 본인확인 안내
' 03. 작    성 : 
' 04. 수    정 : 
' 2022.04.13 : v0001 : KSJ : 신분증 등록 및 진위확인 개선
'--===========================================================================

''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()	
	Dim szTheme
	szTheme = Form.GetEnvData("common.theme")

'	if szTheme == "white" then
'		imgProcess.imgpath = "icon_3stepthird_w"
'	else
'		imgProcess.imgpath = "icon_3stepthird_b"
'	end if
	
	imgProcess.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgProcess.setMaintainingRatio("1")
End Sub

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "START_CAMERA" then
		Form.runInziCamera()
		
	elseif sEventName == "request_submit_TR" then
		g_szSRNO = sParam
		
		'v0001 STA
		'20220518 KSJ 인증서확인 로직 추가 > 인증완료후 신청 서비스 호출
		Dim szCertUseType 
		'0.공인인증서(ID로그인,인증서로그인) 1.간편인증(공인인증서) 2.코스콤지문(공인인증서) 3.결제원(FIDO인증서) 4.금투협(공동인증서)
		szCertUseType = Form.GetSharedData("&CERT_USE_TYPE", false )  '로그인타입
		
		If szCertUseType == "1" Or szCertUseType == 1 Then '간편인증
		    Form.OpenFramePopup( "mhetc90060_px" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		Else
		    Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		End If
		'v0001 FIN	
		
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'20220518 KSJ 인증후 신청TR 호출
	'==[인증팝업]==
	'공동인증및바이오인증
	if sKeyName == "mhetc90060_p5" Then 
		If sRet ~= "cancel" Then
			DATAMANAGER.RequestTranData( "obcsb_acif_124a" )
		End If
	'간편인증전용
	ElseIf sKeyName == "mhetc90060_px" Then 
		If sRet == "ok" Then
			DATAMANAGER.RequestTranData( "obcsb_acif_124a" )
		End If
	End If
End Sub

	</SCRIPT_INFO>
