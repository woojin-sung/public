	<SCRIPT_INFO _len="6905" _ulen="6699" >
'============================================================================
' 01. 화 면 명 : 반대매매 내역_가로보기
' 02. 화면설명 : 반대매매 내역_가로화면
' 03. 작    성 : 2016. 02. 03. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_RadioIndex	'라디오 선택 상태
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_szData		'세로창에서 받을 데이터
Dim g_szList		'
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()

	g_szData = Form.Form.GetOpenLinkData( )

	if g_szData <> "" then
		g_szList = Split(g_szData , "★")
		
		g_RadioIndex = CInt(g_szList(0))
		rdo0.currentindex = g_RadioIndex
		cld0.caption = g_szList(1)
	end if
	
	if g_RadioIndex == 0 then 
		cld0.enable = false
		DATAMANAGER.SetDataValue( 0 , "obtrs_lqdt_126r", "InBlock1", "PROS_CLS_CODE" , 0 , "1")
	else
		cld0.enable = true
		DATAMANAGER.SetDataValue( 0 , "obtrs_lqdt_126r", "InBlock1", "PROS_CLS_CODE" , 0 , "2")
	end if
'	DATAMANAGER.SetDataValue( 0 , "obtrs_lqdt_126r", "InBlock1", "PROS_CLS_CODE" , 0 , 2)
	DATAMANAGER.SetDataValue( 0 , "obtrs_lqdt_126r", "InBlock1", "ACNO" , 0 , acnt0.total)'Left(cmb0.caption , 8))
	DATAMANAGER.SetDataValue( 0 , "obtrs_lqdt_126r", "InBlock1", "ASNO" , 0 , acnt0.sequence)'Right(cmb0.caption , 2))
	DATAMANAGER.SetDataValue( 0, "obtrs_lqdt_126r", "InBlock1", "LQDT_ODER_DATE" , 0 , cld0.caption)
	
	g_nNextCount = 0
	
	Call rdo0_OnClick(g_RadioIndex)
	
'	DATAMANAGER.RequestTranData( "obtrs_lqdt_126r" )
End Sub
'============================================================================
' rdo0_OnClick(nIndex)
'============================================================================
Sub rdo0_OnClick(nIndex)
	
	g_RadioIndex = nIndex
	g_nNextCount = 0
	
	'라디오 인덱스 값에 따른 입력값 세팅
	if g_RadioIndex == 0 then 
		cld0.enable = false
		DATAMANAGER.SetDataValue( 0 , "obtrs_lqdt_126r", "InBlock1", "PROS_CLS_CODE" , 0 , "1")
	else
		cld0.enable = true
		DATAMANAGER.SetDataValue( 0 , "obtrs_lqdt_126r", "InBlock1", "PROS_CLS_CODE" , 0 , "2")
	end if
	
	DATAMANAGER.RequestTranData( "obtrs_lqdt_126r" )

End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szData
	Dim szCredit
	
	if szTranID == "obtrs_lqdt_126r" then
		for i = 0 to grd0.rowcount - 1
			
			szData = Form.GetMetaData( "현물반대매매사유코드", DATAMANAGER.GetDataValue( 0 , "obtrs_lqdt_126r", "OutBlock2", "SPT_LQDT_REAS_CODE" , i) )
			szCredit = Form.GetMetaData( "대출상세유형코드" , DATAMANAGER.GetDataValue( 0 , "obtrs_lqdt_126r", "OutBlock2", "LOAN_DTL_TYPE_CODE" , i) )
			szUncl = Form.GetMetaData("미수구분코드" , DATAMANAGER.GetDataValue( 0 , "obtrs_lqdt_126r", "OutBlock2", "UNCL_CLS_CODE" , i) )
			
			grd0.SetCellData( "bd_cell0", g_nNextCount , szData)
			grd0.SetCellData( "bd_cell6", g_nNextCount , szCredit)
			grd0.SetCellData( "bd_cell13", g_nNextCount , szUncl)
			
			szDate = DATAMANAGER.GetDataValue( 0 , "obtrs_lqdt_126r", "OutBlock2", "UNCL_OCRN_DATE" , i)
			szLoanDate = DATAMANAGER.GetDataValue( 0 , "obtrs_lqdt_126r", "OutBlock2", "LOAN_DATE" , i)
			szMtrtDate = DATAMANAGER.GetDataValue( 0 , "obtrs_lqdt_126r", "OutBlock2", "MTRT_DATE" , i)
			
			if CInt(szDate) == 0 then
				grd0.SetCellData( "bd_cell12", g_nNextCount , "")
			end if
			
			if CInt(szLoanDate) == 0 then
				grd0.SetCellData( "bd_cell5", g_nNextCount , "")
			end if
			
			if CInt(szMtrtDate) == 0 then
				grd0.SetCellData( "bd_cell11", g_nNextCount , "")
			end if
			
			g_nNextCount = g_nNextCount + 1
		next
	end if
	
End Sub
'============================================================================
' grd0_OnScrollEnd() : NextData 조회
