'============================================================================
' cld0_OnEditComplete()
'============================================================================
Sub cld0_OnEditComplete()
	g_nNextCount = 0

	DATAMANAGER.SetDataValue( 0, "obtrs_lqdt_126r", "InBlock1", "LQDT_ODER_DATE" , 0 , cld0.caption)
	
	DATAMANAGER.RequestTranData( "obtrs_lqdt_126r" )
End Sub
'============================================================================
' btn0_OnClick()
'============================================================================
Sub btn0_OnClick()
	g_nNextCount = 0
	
	DATAMANAGER.RequestTranData( "obtrs_lqdt_126r" )
End Sub
'============================================================================
' acnt0_ChangeAccount()
'============================================================================
Sub acnt0_ChangeAccount()
	g_nNextCount = 0
	
	DATAMANAGER.SetDataValue( 0 , "obtrs_lqdt_126r", "InBlock1", "ACNO" , 0 , acnt0.total)
	DATAMANAGER.SetDataValue( 0 , "obtrs_lqdt_126r", "InBlock1", "ASNO" , 0 , acnt0.sequence)
	
	DATAMANAGER.RequestTranData( "obtrs_lqdt_126r" )
End Sub
'============================================================================
' Form_OnFormClose()
'============================================================================
Sub Form_OnFormClose()
	
	if g_szData <> "" then
		g_szData = g_RadioIndex & "★" & cld0.caption
		Form.SendReturnToParent( "mbact71030_h1" , g_szData)
	end if
End Sub
'============================================================================
' btnClose_OnClick()
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
' img0_OnClick()
'============================================================================
Sub img0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnRefresh()
	
