'============================================================================
Sub Grid0_OnHeaderClickUp(lRow, szCellID)
	if szCellID = "th_cell3" then
	   Grid0.SetVisibleCol( 3, 0 )
	   Grid0.SetVisibleCol( 4, 1 )
	elseif szCellID = "th_cell4" then
	   Grid0.SetVisibleCol( 3, 1 )
	   Grid0.SetVisibleCol( 4, 0 )
	end if   
End Sub

