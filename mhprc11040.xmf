Sub Form_OnFormInit()
	g_FoldFlag = 0 
    cont2.btnFold.btnimage = "btn_filter.9.png"
	cont1_cmbMkt0_OnEditComplete(0)
	cont1_cmbAss0_OnEditComplete(0)
	cont0.cmbCom1.caption = "레버리지/인버스 전체" 
	cont1.cmbTax.caption = "과세유형 전체"
	cont1.cmbCopy.caption = "복제방법 전체"
	cont1.cmbAss0.caption = "기초자산전체"
	cont1.cmbMkt0.caption = "시장 전체"
	DATAMANAGER.RequestTranData(g_LISTID)
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
'	Form.ShowAlert("TR onRe카운트1", cont0.cmbCom.cblistcount)
	if szTranID = g_LISTID then
	   if cont0.cmbCom.rowcount = 0 then
	      DATAMANAGER.SetDataReject( )
          
	   end if
	
	end if  
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = g_LISTID then
	   
	   for i = 0 to DATAMANAGER.GetDataCount( 0, g_LISTID , "OutBlock1" ) -1
		  
		  '20220216 SWJ START : 운용사별로 콤보 선택해도 전체 조회되는 현상
		  '4자리로 절사 처리 (투자정보 확인)
	       key = Right(DATAMANAGER.GetDataValue( 0, g_LISTID, "OutBlock1", "FID_MGRI_CO_NO", i ), 4)
		  '20220216 SWJ END
		   
		   '20220216 SWJ START : 기존 오류 발견.. 앱 백그라운드에 있다가 재조회시 콤보 재추가되는 오류 수정
		   if g_ListCnt = "" or g_ListCnt = null then
				cont0.cmbCom.cbadddatatext = key & "`" & DATAMANAGER.GetDataValue( 0, g_LISTID, "OutBlock1", "FID_MGRI_CO_KOR_NAME" , i )
		   end if
		   '20220216 SWJ END
	   Next
	
	   g_ListCnt = cont0.cmbCom.rowcount
	   
'	   Form.ShowAlert("TR카운트", DATAMANAGER.GetDataCount( 0, g_LISTID , "OutBlock1" ) & "/" & g_ListCnt)'
	   
	   cont0.cmbCom.caption = "운용사 전체"
	   cont0.cmbCom.currentindex = 0
	   DATAMANAGER.RequestTranData( g_TRID )
	   
	elseif szTranID = g_TRID then
	   for i = 0 to DATAMANAGER.GetDataCount( 0, g_TRID , "OutBlock1" ) -1
	       szCd = DATAMANAGER.GetDataValue( 0, g_TRID ,"OutBlock1"  , "FID_SHRN_ISCD" , i )
	       DATAMANAGER.SetDataValue( 1 , "ohhts_etf_nav", "InBlock1", "FIDR_SHRN_ISCD", i , szCd )
	   Next    
	   DATAMANAGER.RequestRealData( "ohhts_etf_nav" )
	   'Form.ShowAlert("리얼요청", "ohhts_etf_nav")
	end if
End Sub


'============================================================================
Sub cont2_btnSrh_OnClick()
	if cont0.cmbCom.rowcount > 0 then  ' 컨트롤 통합 0r 생략 가능??
	   DATAMANAGER.RequestTranData( g_TRID )
	end if	
End Sub



'============================================================================
Sub cont1_cmbMkt0_OnEditComplete(iIndex)
	g_mkt01 = cont1.cmbMkt0.cbkeydata
	
	Select Case iIndex 'cont1.cmbMkt0.currentindex( )'case :  시장구분
	Case 0  '전체
	    cont1.cmbMkt1.Enable = False
	    cont1.cmbMkt0.caption = "시장 전체"
    Case 1  '국내
 	    cont1.cmbMkt1.Enable = True 
	    cont1.cmbMkt1.cbinputdatatext = "00`전체\r\n01`코스피\r\n02`코스닥\r\n03`코스피+코스닥\r\n04`주식외" 
		
    Case 2  '해외
  	    cont1.cmbMkt1.Enable = True 
	    cont1.cmbMkt1.cbinputdatatext= "00`전체\r\n01`글로벌\r\n02`선진국\r\n03`신흥국\r\n04`프런티어\r\n05`아시아\r\n06`북미\r\n07`남미\r\n08`유럽" 
							    
	Case 3  '국내&해외
	    cont1.cmbMkt1.Enable = False	
	End Select
	
	cont1.cmbMkt1.currentindex = "0" '?
	cont1.cmbMkt2.Enable = False 
End Sub


'============================================================================
Sub cont1_cmbMkt1_OnEditComplete(iIndex)
	g_mkt02 = cont1.cmbMkt1.cbkeydata
	
	If cont1.cmbMkt0.currentindex( ) = "1" Then '국내
	   cont1.cmbMkt2.Enable = False	    
    ElseIf cont1.cmbMkt0.currentindex( ) = "2" Then '해외
	    
	    Select Case iIndex 'cont1.cmbMkt1.currentindex( )
	    Case 5
		     cont1.cmbMkt2.Enable = True
		     cont1.cmbMkt2.cbinputdatatext= "00`전체\r\n01`중국\r\n02`홍콩\r\n03`일본\r\n04`인도\r\n05`베트남\r\n06`호주\r\n07`대만\r\n08`인도네시아"  '20161128_01 KBC  : ETP시장분류체계변경
		Case 6    
		     cont1.cmbMkt2.Enable = True
		     cont1.cmbMkt2.cbinputdatatext= "00`전체\r\n01`미국" 
	    Case 7
		     cont1.cmbMkt2.Enable = True
		     cont1.cmbMkt2.cbinputdatatext= "00`전체\r\n01`브라질" 
	    Case 8
		     cont1.cmbMkt2.Enable = True
		     cont1.cmbMkt2.cbinputdatatext= "00`전체\r\n01`영국\r\n02`독일" 
	    Case Else
		     cont1.cmbMkt2.Enable = False	    	    
	    End Select
    ElseIf cont1.cmbMkt0.currentindex( ) = "3" Then '국내&해외
	    cont1.cmbMkt1.Enable = False
		cont1.cmbMkt2.Enable = False
	End If

	cont1.cmbMkt2.currentindex = "0"
	'cont1_cmbMkt2_OnEditComplete(0)
End Sub


'============================================================================
Sub cont1_cmbAss0_OnEditComplete(iIndex)
    'cont1.cmbAss1.clear = True
	g_Ass01 = cont1.cmbAss0.cbkeydata
	
	'20161128_01 KBC START : ETP시장분류체계변경
	Select Case iIndex 'cont1.cmbAss0.currentindex( )

	Case 0  '전체
	     cont1.cmbAss1.Enable = False
	     cont1.cmbAss0.caption = "기초자산전체"
	Case 1	'주식
	     cont1.cmbAss1.Enable = True
	     cont1.cmbAss1.cbinputdatatext= "00`전체\r\n01`시장대표\r\n02`업종섹터\r\n03`전략\r\n04`규모" 
							    
'	Case 2	'주식파생
'	     cont1.cmbAss1.Enable = True
'	     cont1.cmbAss1.cbinputdatatext= "00`전체\r\n01`주가지수\r\n02`변동성\r\n03`구조화" 

	Case 2	'채권
	     cont1.cmbAss1.Enable = True
	     cont1.cmbAss1.cbinputdatatext= "00`전체\r\n01`혼합\r\n02`국공채\r\n03`회사채" 
	Case 3	'원자재
	     cont1.cmbAss1.Enable = True
	     cont1.cmbAss1.cbinputdatatext= "00`전체\r\n01`혼합\r\n02`금속\r\n03`에너지\r\n04`농산물" 
	Case 4	'부동산
	     cont1.cmbAss1.Enable = True
	     cont1.cmbAss1.cbinputdatatext= "00`전체\r\n01`리츠" 
	Case 5 	 '통화   
	     cont1.cmbAss1.Enable = True
	     cont1.cmbAss1.cbinputdatatext= "00`전체\r\n01`미국달러\r\n02`중국위안\r\n03`일본엔\r\n04`유로" 
	Case 6	'혼합자산
	     cont1.cmbAss1.Enable = True
	     cont1.cmbAss1.cbinputdatatext= "00`전체\r\n01`주식+채권\r\n02`주식+통화" 	
	Case 7	'ELS
	     cont1.cmbAss1.Enable = True
	     cont1.cmbAss1.cbinputdatatext= "00`전체\r\n01`스프레드\r\n02`낙아웃\r\n03`어쿠르얼" 
	Case 8	'기타
		 cont1.cmbAss1.Enable = False
	End Select
	'20161128_01 KBC END
	
	cont1.cmbAss1.currentindex = "0" '?
	cont1.cmbAss2.Enable = False

	
End Sub

'============================================================================

'============================================================================
Sub cont1_cmbAss1_OnEditComplete(iIndex)
    
    g_Ass02 = cont1.cmbAss1.cbkeydata
    
    '20161128_01 KBC START : ETP시장분류체계변경
    Select Case CInt(cont1.cmbAss0.currentindex)
    Case 1	'주식
	    If cont1.cmbAss1.currentindex == "2" Then			'업종섹터
	         'cont1.cmbAss2.clear = True
		     cont1.cmbAss2.Enable = True
		     cont1.cmbAss2.cbinputdatatext= "00`전체\r\n01`건설\r\n02`중공업\r\n03`산업재\r\n04`금융\r\n05`에너지화학\r\n06`경기소비재\r\n07`생활소비재\r\n08`헬스케어\r\n09`정보기술\r\n10`철강소재\r\n11`업종테마" 
								     
		ElseIf cont1.cmbAss1.currentindex( ) = "3" Then	'전략
		     cont1.cmbAss2.Enable = True
		     cont1.cmbAss2.cbinputdatatext= "00`전체\r\n01`가치\r\n02`성장\r\n03`배당\r\n04`변동성\r\n05`구조화\r\n06`기업그룹\r\n07`전략테마\r\n08`혼합/퀀트" 
								     
		ElseIf cont1.cmbAss1.currentindex( ) = "4" Then 	'규모
			 cont1.cmbAss2.Enable = True
		     cont1.cmbAss2.cbinputdatatext= "00`전체\r\n01`대형주\r\n02`중형주\r\n03`소형주"
		Else
		     cont1.cmbAss2.Enable = False	    	    		
		End If						
	Case 2	'채권
	    If  cont1.cmbAss1.currentindex( ) = "0" Then 		'전체
		     cont1.cmbAss2.Enable = False	    	    		
	    Else
			cont1.cmbAss2.Enable = True
		    cont1.cmbAss2.cbinputdatatext= "00`전체\r\n01`단기\r\n02`중기\r\n03`장기"
		End If
	Case 3	'원자재
	    If  cont1.cmbAss1.currentindex( ) = "0" Then 		'전체
		     cont1.cmbAss2.Enable = False	    	    		
		ElseIf cont1.cmbAss1.currentindex( ) = "2" Then	'금속
		     cont1.cmbAss2.Enable = True
		     cont1.cmbAss2.cbinputdatatext= "00`전체\r\n01`혼합\r\n02`금\r\n03`은\r\n04`구리"
		ElseIf cont1.cmbAss1.currentindex( ) = "3" Then	'에너지
		     cont1.cmbAss2.Enable = True
		     cont1.cmbAss2.cbinputdatatext= "00`전체\r\n01`혼합\r\n02`원유" 
		ElseIf cont1.cmbAss1.currentindex( ) = "4" Then	'농산물
		     cont1.cmbAss2.Enable = True
		     cont1.cmbAss2.cbinputdatatext= "00`전체\r\n01`혼합\r\n02`콩\r\n03`옥수수"
		Else
		     cont1.cmbAss2.Enable = False	
		End If		
	Case Else
		     cont1.cmbAss2.Enable = False	    	    			
	End Select
	'20161128_01 KBC END
	
	cont1.cmbAss2.currentindex = "0" 
End Sub


'============================================================================
Sub cont1_cmbAss2_OnEditComplete(iIndex)
	g_Ass03 = cont1.cmbAss2.cbkeydata
	g_Ass_Div = g_Ass01&g_Ass02&g_Ass03
	DATAMANAGER.RequestTranData( g_TRID )
End Sub

'============================================================================
Sub cont1_cmbMkt2_OnEditComplete(iIndex)
	g_Mkt03 = cont1.cmbMkt2.cbkeydata
	g_Mkt_Div = g_Mkt01&g_Mkt02&g_Mkt03
	DATAMANAGER.RequestTranData( g_TRID )
End Sub



'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	If szTranID = g_TRID Then
	   DATAMANAGER.CancelRealData( "ohhts_etf_nav" )
	   'Form.ShowAlert("리얼캔슬요청", "ohhts_etf_nav")
	   DATAMANAGER.SetDataValue( 0 , g_TRID , "InBlock1" , "FID_INPUT_NMIX_MRKT_DIV" , 0 , g_Mkt_Div )
       DATAMANAGER.SetDataValue( 0 , g_TRID , "InBlock1" , "FID_INPUT_NMIX_ASET_DIV" , 0 , g_Ass_Div )   
       'DATAMANAGER.SetDataValue( 0 , g_TRID , "InBlock1", "FID_INPUT_COND_MRKT_CLS_CODE" , 0 , "0000000")
	ElseIf szTranID = g_LISTID then
	   if cont0.cmbCom.rowcount > 0 then '반복?
	      DATAMANAGER.SetDataReject( )
	   end if
	End If   
End Sub


