	<SCRIPT_INFO _len="5502" _ulen="5286" >
Dim gbLargeFont			'큰글씨 사용여부
Dim gsLargeFontsize		'큰글씨 폰트크기(1:조금크게 2:크게)

gbLargeFont = false
gsLargeFontsize = 0

Dim gOsType

'============================================================================
Sub Form_OnFormInitBefore()
	
	gOsType = Form.GetSharedData("&OS_TYPE", false)

	LabelData0.paddinginfo = "0,0,0,0"
	LabelData1.paddinginfo = "0,0,0,0"
	LabelData2.paddinginfo = "0,0,0,0"
	LabelData3.paddinginfo = "0,0,0,0"
	LabelData4.paddinginfo = "0,0,0,0"
	LabelData5.paddinginfo = "0,0,0,0"
	LabelData6.paddinginfo = "0,0,0,0"
	LabelData7.paddinginfo = "0,0,0,0"
	LabelData8.paddinginfo = "0,0,0,0"
	LabelData9.paddinginfo = "0,0,0,0"
	LabelData10.paddinginfo = "0,0,0,0"
	LabelData11.paddinginfo = "0,0,0,0"
	
	LabelData9.sizeAutoFit()
	LabelData10.sizeAutoFit()
	LabelData11.sizeAutoFit()
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		gbLargeFont = true
		gsLargeFontsize = szTextSize
	end if

	'--------------------------------------------------------------
	' 텍스트 속성 변경
	'--------------------------------------------------------------
	ChangeTextAttr("LabelData0")
	ChangeTextAttr("LabelData1")
	ChangeTextAttr("LabelData2")
	ChangeTextAttr("LabelData3")
	ChangeTextAttr("LabelData4")
	ChangeTextAttr("LabelData5")
	ChangeTextAttr("LabelData6")
	ChangeTextAttr("LabelData7")
	ChangeTextAttr("LabelData8")
	ChangeTextAttr("LabelData9")
	
End Sub
'============================================================================
Function ChangeTextAttr(sCtlName)
	
	'-------------------------------------
	' 글자크기 결정(큰글씨모드 대응)
	'-------------------------------------
	if gbLargeFont then
		
		if gOsType == "1" then
			sTargetTextSize = - Cint((gsLargeFontsize * 2))
		else
			sTargetTextSize = - Cint((gsLargeFontsize * 2))
		end if
		
		sTextSize = sTargetTextSize - 1
	else
		sTargetTextSize = -2
		sTextSize = sTargetTextSize - 1
	end if
	
	'-------------------------------------
	' 속성변경
	'-------------------------------------
	if sCtlName == "LabelData0" then
		
		LabelData0.fontsize = sTargetTextSize
		LabelData7.fontsize = sTextSize
		LabelData9.fontsize = sTextSize
		LabelData10.fontsize = sTextSize
		LabelData11.fontsize = sTextSize
		
	elseif sCtlName == "LabelData1" then
		
		LabelData1.fontsize = sTextSize
		sTargetText = "주간거래 10:00 ~ 17:30"
		sTargetLen  = Form.getLen(sTargetText)
		LabelData1.changeTextAttr(0, sTargetLen, 334, sTargetTextSize, true)
	
	elseif sCtlName == "LabelData2" then
	
		LabelData2.fontsize = sTextSize
		sTargetText = "Pre Market 18:00 ~ 23:30"
		sTargetLen  = Form.getLen(sTargetText)
		LabelData2.changeTextAttr(0, sTargetLen, 334, sTargetTextSize, true)
		
	elseif sCtlName == "LabelData3" then
	
		LabelData3.fontsize = sTextSize
		sTargetText = "정규시간 23:30 ~ 익일 06:00"
		sTargetLen  = Form.getLen(sTargetText)
		LabelData3.changeTextAttr(0, sTargetLen, 334, sTargetTextSize, true)
	
	elseif sCtlName == "LabelData4" then
	
		LabelData4.fontsize = sTextSize
		sTargetText = "After Market 06:00 ~ 07:00"
		sTargetLen  = Form.getLen(sTargetText)
		LabelData4.changeTextAttr(0, sTargetLen, 334, sTargetTextSize, true)
	
	elseif sCtlName == "LabelData5" then
		
		LabelData5.fontsize = sTextSize
		sTargetText = "09:00 ~ 22:30"
		sTargetLen  = Form.getLen(sTargetText)
		LabelData5.changeTextAttr(0, sTargetLen, 334, sTargetTextSize, true)
	
	elseif sCtlName == "LabelData6" then
		
		LabelData6.fontsize = sTextSize
		sTargetText = "09:00 ~ 22:30"
		sTargetLen  = Form.getLen(sTargetText)
		LabelData6.changeTextAttr(0, sTargetLen, 334, sTargetTextSize, true)
		
	elseif sCtlName == "LabelData7" then
	
		LabelData7.fontsize = sTextSize
		LabelData7.caption = "·거래시간은 한국시간 기준으로 제공됩니다."
	
	elseif sCtlName == "LabelData8" then
		
		LabelData8.fontsize = sTextSize
		LabelData8.caption = "·썸머타임은 3월 두번째 일요일 오전 2시 ~ 11월 첫 일요일\n  오전 2시까지 입니다."
	
	end if

End Function
'============================================================================
Sub LabelData9_OnSizeAutoFit()
	
	if gOsType == "1" then
		nLeft = Form.calcUnResize(LabelData9.left, "2")
		nWidth = Form.calcUnResize(LabelData9.width, "2")
		LabelData10.Image0.left = nLeft + nWidth + 5
	else
		nLeft = LabelData9.left
		nWidth = LabelData9.width
		LabelData10.Image0.left = nLeft + nWidth
	end if
	
	

	
End Sub
'============================================================================
Sub LabelData10_OnSizeAutoFit()
	
	if gOsType == "1" then
		nLeft = Form.calcUnResize(LabelData10.left, "2")
		nWidth = Form.calcUnResize(LabelData10.width, "2")
		LabelData11.Image0.left = nLeft + nWidth + 2
	else
		nLeft = LabelData10.left
		nWidth = LabelData10.width
		LabelData11.Image0.left = nLeft + nWidth
	end if
	
	

	
End Sub

'============================================================================
Sub LabelData10_OnClick()
	if gOsType == "1" then
		Form.openExternalBrowser("https://home.imeritz.com/mobile/content/overseas/usa.html")
	else
		Form.openInternalBrowser("https://home.imeritz.com/mobile/content/overseas/usa.html")
	end if
	
End Sub

	</SCRIPT_INFO>
