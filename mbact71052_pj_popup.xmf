	<SCRIPT_INFO _len="7393" _ulen="6809" >

Dim g_tData
Dim g_szPwd

'============================================================================
Sub Form_OnFormInitBefore()
	contSell.imgClose.setMaintainingRatio("1")
	contCancel.imgClose.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
'	'바텀시트가 겹겹이 쌓이는듯 하여 뒤에 깔린 바텀화면 닫는 용도
'	if Form.GetSharedData("&OS_TYPE", false) == "1" then
'		Form.SetTimerEvent2(1, 1, 0.1)
'	end if

	contSell.lblTitle.changeTextAttr(0, 2, 291, 2, true)
	contCancel.lblTitle.changeTextAttr(0, 2, 293, 2, true)
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	
	if szOpenData <> "" and szOpenData <> null then
		'g_tData
		'0 매수/매도 구분
		'1 계좌번호
		'2 발행어음번호
		'3 종목명
		'4 종목코드
		'5 매수금액
		'6 약정수익률
		'7 경과기간
		'8 약정기간
		'9 중도상환수익률
		'10 이자금액
		'11 제세금
		'12 평가금액
		'13 매수일자
		'14 만기일자
		'15 거래일련번호
		g_tData = Split(szOpenData, "★")
		
		if UBound(g_tData) > 0 then
'			Form.ShowAlert("11", g_tData[0])
			if g_tData[0] == "매도" then
				contSell.left = 0
				contCancel.left = 1000
				
				contSell.tblData.SetCellString(0, 1, g_tData[3])
				contSell.tblData.SetCellString(1, 1, Left(g_tData[1], 4) & "-" & Mid(g_tData[1], 5, 4) & "-" & Right(g_tData[1], 2) )
				if g_tData[4] == "NI71010" then
					contSell.tblData.SetCellString(2, 1, "수시형")
				else
					contSell.tblData.SetCellString(2, 1, "약정형")
				end if
				contSell.tblData.SetCellString(3, 1, g_tData[5])
				contSell.tblData.SetCellString(4, 1, g_tData[6])
				contSell.tblData.SetCellString(5, 1, CInt(g_tData[7]) & "일/" & CInt(g_tData[8]) & "일")
				contSell.tblData.SetCellString(6, 1, g_tData[9])
				contSell.tblData.SetCellString(7, 1, Form.GetSharedData("&HOST_DATE", false))
				contSell.tblData.SetCellString(8, 1, g_tData[10])
				contSell.tblData.SetCellString(9, 1, g_tData[11])
				
				contSell.tblData.SetCellString(12, 1, g_tData[12])
			else
				contSell.left = 1000
				contCancel.left = 0
				
				contCancel.tblData.SetCellString(0, 1, g_tData[3])
				contCancel.tblData.SetCellString(1, 1, Left(g_tData[1], 4) & "-" & Mid(g_tData[1], 5, 4) & "-" & Right(g_tData[1], 2) )
				if g_tData[4] == "NI71010" then
					contCancel.tblData.SetCellString(2, 1, "수시형")
				else
					contCancel.tblData.SetCellString(2, 1, "약정형")
				end if
				contCancel.tblData.SetCellString(3, 1, g_tData[5])
				contCancel.tblData.SetCellString(4, 1, g_tData[6])
				contCancel.tblData.SetCellString(5, 1, "매수")
				contCancel.tblData.SetCellString(6, 1, g_tData[13])
				contCancel.tblData.SetCellString(7, 1, g_tData[14])
			end if
		end if
	end if
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'계좌 비밀번호 팝업 리턴
	if sKeyName == "CORRECT_PWD" and sRet <> "" and sRet <> null then
		Dim tPwd
		tPwd = Split(sRet, "★") '"nPwdLen★sEncPwd(암호화된 비밀번호)"
		
		if UBound(tPwd) > 0 then
			g_szPwd = tPwd(0)
			
			if g_tData[0] == "매도" then
				'발행어음 매도 주문
				DATAMANAGER.RequestTranData( "obsan_deal_216a" )
			else
				'발행어음 매매 취소
				DATAMANAGER.RequestTranData( "obsan_deal_212a" )
			end if
		end if
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'매도 또는 취소 완료
	if sKeyName == "PROC_COMPLETE" then
		'자산현황 화면 재조회 이벤트
		'그동안 열렸던 팝업들도 이 이벤트를 받아 닫기 처리
		Form.PostLinkData("71052_p7", "refresh")
		
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'발행어음 매도 주문
	if szTranID == "obsan_deal_216a" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , Left(g_tData[1], 8))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , Right(g_tData[1], 2))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PWD" , 0 , g_szPwd)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" , 0 , g_tData[4])
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISNT_NO" , 0 , g_tData[2])
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "INVT_AMT" , 0 , g_tData[5])
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "TLMS_SPCI_CANC_REAS_CODE" , 0 , "0")
	
	'발행어음 매매 취소
	elseif szTranID == "obsan_deal_212a" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , Left(g_tData[1], 8))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , Right(g_tData[1], 2))
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PWD" , 0 , g_szPwd)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "TR_DATE" , 0 , g_tData[13])
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "TRAN_SRNO" , 0 , g_tData[15])
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'발행어음 매도 주문
	if szTranID == "obsan_deal_216a" then
		Form.MsgBox("안내", "발행어음 매도가 완료되었습니다.", "PROC_COMPLETE", 6)
		
	'발행어음 매매 취소	
	elseif szTranID == "obsan_deal_212a" then
		Form.MsgBox("안내", "발행어음 매수주문이 취소되었습니다.", "PROC_COMPLETE", 6)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szMsgCode, szMsgText, szSubText
	szMsgCode = DATAMANAGER.GetDataMsgCode(szTranID)
	szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
	szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szSubText <> "" and szSubText <> null then
		Form.ShowAlert("알림" .. szTranID, szMsgText & "(" & szSubText &")")
	else
		Form.ShowAlert("알림" .. szTranID, szMsgText)
	end if
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if CInt(sTimerID) == 1 then
		Form.SetTimerEvent2(1, 0, 0.1)
		
		Form.SendReturnToParent("CLOSE" , "")
	end if
End Sub

'============================================================================
Sub contSell_imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contCancel_imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contCancel_btnCancel_OnClick()
	'취소 버튼
	'계좌 비밀번호 체크
	if UBound(g_tData) > 0 then
		Form.openPopupAnimation( "pwdcheckpopup", g_tData[1] & "☆2", "", "2" )
	end if
End Sub

'============================================================================
Sub contSell_btnSell_OnClick()
	'매도 버튼
	'계좌 비밀번호 체크
	if UBound(g_tData) > 0 then
		Form.openPopupAnimation( "pwdcheckpopup", g_tData[1] & "☆2", "", "2" )
	end if
End Sub






	</SCRIPT_INFO>
