	<SCRIPT_INFO _len="3016" _ulen="2830" >
'============================================================================
' 01. 화 면 명 : 고객자산평가
' 02. 화면설명 : 고객자산평가
' 03. 작    성 : 2016. 02. 04. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_TabIndex		'탭테이블 Index
Dim szCust_Num		'고객번호
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetTrigger(nIndex) : Index 값에 따른 화면불러오기
'============================================================================
Function SetTrigger(nIndex)
	
	szCust_Num = Form.GetSharedData("&CUST_NUM", false )		'로그인 해야만 고객번호 받아옴
	
	if nIndex == 0 then
		Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "mbact71050_t1", szCust_Num )	'고객별자산
		'Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "mbact71050_t1", cmb0.caption )
	else
		Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "mbact71050_t2", szCust_Num )	'계좌별자산
		'Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "mbact71050_t2", cmb0.caption )
	end if


End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
'	Dim Test
	g_TabIndex = 0
	
	'16-04-15 YCJ 정헌일 과장님 요청사항, 타이틀 명칭 변경, 탭 명칭 변경
	Form.SetTitleCaption( "고객자산평가" )
	
	Dim szScreenNo, szTab
	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )

	If szScreenNo = "71060" Then
		fmtab0.currenttab = "1"
		g_TabIndex = 1	
	end if
'	Test = Form.GetSharedData("&ACCOUNT", false )		
'	Form.ShowAlert("ACCOUNT", Test)
	
	Call SetTrigger(g_TabIndex)
End Sub
'============================================================================
' fmtab0_OnTabChanged(nCurrentTab)
'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
	
	g_TabIndex = nCurrentTab
	
	Call SetTrigger(g_TabIndex)
	
End Sub

'============================================================================
Sub btn0_OnClick()
	if g_TabIndex == 0 then
		Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "mbact71050_t1", szCust_Num )
	else
		Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid , "mbact71050_t2", szCust_Num )
	end if
End Sub

	</SCRIPT_INFO>
