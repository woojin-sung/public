		<FORMTAB name="fmtab0" tabcount="2" tabheadheight="40" ly_vert="0,0,375,562,1" >
			<PAGE name="page002249" caption="자산별평가" linkfile="mbact71050_t1" loadingtype="1" />
			<PAGE name="page006818" caption="계좌별평가" linkfile="mbact71050_t2" loadingtype="1" />
