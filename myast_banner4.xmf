<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="99999" scrname="My자산 배너_주식대여" version="2" writer="김인섭" />
	<FORM_INFO name="Form" ly_vert="0,0,355,99,1" />
	<CONTROL_INFO>
		<CONTAINER name="Container0" ly_vert="0,0,355,109,1" scroll_ly_vert="0,0,355,109,1" >
			<CONTROL_INFO>
				<IMAGE name="Image0" imgpath="banner_icon04" ly_vert="260,29,85,66,1" />
				<LABEL name="Label0" fontstyle="01" caption="보유주식을 메리츠증권에 대여하고" ly_vert="10,4,320,32,1" />
				<LABEL name="Label2" fontsize="-1" fontstyle="10" caption="<![CDATA[대차중개 알아보기 >]]>" click="1" ly_vert="10,53,210,32,1" />
				<LABEL name="Label1" fontstyle="01" caption="대여 주식에 대한 추가 수익이 생겨요" ly_vert="10,23,320,32,1" />
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1382" _ulen="1280" >
Dim gOsType

'============================================================================
Sub Form_OnFormInitBefore()
	
	gOsType = Form.GetSharedData("&OS_TYPE", false)

	'폰사이즈에 적합하게 이미지 맞추기
	Container0.Image0.setMaintainingRatio("1")  
End Sub

'============================================================================
Sub Form_OnFormInit()

	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSizeMode = Form.GetEnvData("common.textsize")
	
	if CInt(szTextSizeMode) > 0 then
		
		if gOsType == "1" then
			Container0.Label0.fontsize = 1 - Cint((szTextSizeMode * 2))
			Container0.Label1.fontsize = 1 - Cint((szTextSizeMode * 2))
			Container0.Label2.fontsize = -1 - Cint((szTextSizeMode * 2))
		else
			Container0.Label0.fontsize = - Cint((szTextSizeMode * 2))
			Container0.Label1.fontsize = - Cint((szTextSizeMode * 2))
			Container0.Label2.fontsize = -1 - Cint((szTextSizeMode * 2))
		end if
	
	end if	
	
End Sub

'============================================================================
Sub Container0_Label2_OnClick()
     Form.SetSharedData("HOME_TAB" , "MYASSET")  '화면이동후 백버튼눌렀을때. 현재탭으로 이동
	Form.OpenScreen( "88022" , "" ) '대차중개약정 화면 오픈'
End Sub



	</SCRIPT_INFO>
</ROOT>