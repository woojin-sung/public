Dim g_tAgreeUrl 
Dim g_tAgreeState 

Dim g_szAcno
Dim g_szLoanTypeCode
Dim g_szBswrDivCode
Dim g_szContClsCode
Dim g_szAnxtAprtYn

Dim g_szRet
Dim g_nAll
g_nAll = 2
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	g_szRet = "N"
	
	g_tAgreeState = {"0", "0"}
	Dim sDev
	sDev = Form.GetSharedData("&SERVER_MODE", False )
	
	If sDev == "1" Or sDev == 1 Then
		g_tAgreeUrl = {
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/meritz_info_03.pdf", "신용거래설명서",  "urlpath", "N", ""},
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/meritz_info_02.pdf", "증권담보융자설명서", "urlpath", "N", ""}
		}
		
	Else '운영
		g_tAgreeUrl = {
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_03.pdf", "신용거래설명서",  "urlpath", "N", ""},
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_02.pdf", "증권담보융자설명서", "urlpath", "N", ""}
		}
	End If	
	
	g_szAcno 			 = Form.GetSharedData( "mbonl93503_acno" 		, true )
	g_szLoanTypeCode 		 = Form.GetSharedData( "mbonl93503_loan_type_code", true )
	g_szBswrDivCode  	 	 = Form.GetSharedData( "mbonl93503_bswr_div_code" , true )
	g_szContClsCode  	 	 = Form.GetSharedData( "mbonl93503_cont_cls_code" , true )
	
	DATAMANAGER.RequestTranData("oblon_basc_102r")
	
End Sub 

'============================================================================
Sub Container0_contScroll_imgInfo_OnClick()	
	Dim sText
	sText = "성별, 학력, 장애, 사회적 신분 등을 이유로 계약 조건에 관하여 금융소비자를 부당하게 차별하는 행위"
	Container0.contScroll.imgInfo.openToolTip( sText, 345, 60, 2 )
End Sub

'============================================================================


'============================================================================
Sub Container0_contScroll_chkAgree1_OnChange(sCheckState)
	if sCheckState == "1" then
		Container0.contScroll.chkAgree1.chksilence = "0"
		
		'타이틀, url, 웹뷰type, 동의여부, 동의텍스트, 인덱스, 현재체크상태
		Dim szAllData
		szAllData = g_tAgreeUrl[0][1].."★"..g_tAgreeUrl[0][0].."★"..g_tAgreeUrl[0][2].."★"..g_tAgreeUrl[0][3].."★"..g_tAgreeUrl[0][4].."★".."1".."★".."0"
		
	     Form.OpenPopup( "mbonl82010_p4" ,  szAllData , "" )
	else
		Dim nIndex 
		nIndex = 0
		g_tAgreeState[nIndex] = "0"
		f_AllAgreeCheck()
	end if
End Sub

'============================================================================
Sub Container0_contScroll_imgAgree1_OnClick()
	Container0.contScroll.chkAgree1.checkstate = "1"
	Container0_contScroll_chkAgree1_OnChange("1")
End Sub

'============================================================================
Sub Container0_contScroll_chkAgree2_OnChange(sCheckState)
	if sCheckState == "1" then
		Container0.contScroll.chkAgree2.chksilence = "0"

		'타이틀, url, 웹뷰type, 동의여부, 동의텍스트, 인덱스, 현재체크상태
		Dim szAllData
		szAllData = g_tAgreeUrl[1][1].."★"..g_tAgreeUrl[1][0].."★"..g_tAgreeUrl[1][2].."★"..g_tAgreeUrl[1][3].."★"..g_tAgreeUrl[1][4].."★".."2".."★".."0"
	     Form.OpenPopup( "mbonl82010_p4" ,  szAllData , "" )
	else
		Dim nIndex 
		nIndex = 1
		g_tAgreeState[nIndex] = "0"
		f_AllAgreeCheck()
	end if
End Sub

'============================================================================
Sub Container0_contScroll_imgAgree2_OnClick()
	Container0.contScroll.chkAgree2.checkstate = "1"
	Container0_contScroll_chkAgree2_OnChange("1")
End Sub
'============================================================================
Sub Container0_contScroll_chkAllAgree_OnChange(sCheckState)
	if sCheckState == "1" then
		Container0.contScroll.chkAllAgree.chksilence = "0"
		
		Dim szAllData
		for i=0 to 1
			Dim szData
			'231218 대출용도에 따라 설명서 체크되도록 수정
			if CInt(Form.GetCtlProp("Container0.contScroll.chkAgree"..i+1, "visible")) == 1 or Form.GetCtlProp("Container0.contScroll.chkAgree"..i+1, "visible") == "true" then
				if g_tAgreeState[i] == "0" then
					'타이틀, url, 웹뷰type, 동의여부, 동의텍스트, 인덱스, 현재체크상태
					szData = g_tAgreeUrl[i][1].."★"..g_tAgreeUrl[i][0].."★"..g_tAgreeUrl[i][2].."★"..g_tAgreeUrl[i][3].."★"..g_tAgreeUrl[i][4].."★"..(i+1).."★".."0"
					if szAllData == "" or szAllData == null then
						szAllData = szData
					else
						szAllData = szAllData.."☆"..szData
					end if
				end if
			end if 
		next
		
		if #szAllData > 0 then
			Form.OpenPopup( "mbonl82010_p4" ,  szAllData , "" )
		end if
	else
		for i = 0 to 1
			g_tAgreeState[i] = "0"
			Form.SetCtlProp("Container0.contScroll.chkAgree"..i+1, "chksilence", "0")
		next
		
		Container0.contScroll.btnOk.enable = "0"
		
	end if
End Sub

'============================================================================
Sub Container0_contScroll_imgAllAgree_OnClick()
	if Container0.contScroll.chkAllAgree.checkstate == "0" then
		Container0.contScroll.chkAllAgree.checkstate = "1"
		Container0_contScroll_chkAllAgree_OnChange("1")
	else
		Container0.contScroll.chkAllAgree.checkstate = "0"
		Container0_contScroll_chkAllAgree_OnChange("0")
	end if
End Sub


Function f_AllAgreeCheck()
	Dim nAll
	nAll = 0
	for i = 0 to #g_tAgreeState - 1
		Form.SetCtlProp("Container0.contScroll.chkAgree"..i+1, "chksilence", g_tAgreeState[i])
		if g_tAgreeState[i] == "1" then
			nAll = nAll + 1
		end if
	next
	
	'if nAll == 2 then
	if nAll == g_nAll then
		Container0.contScroll.chkAllAgree.chksilence = "1"
		Container0.contScroll.btnOk.enable = "1"
	else
		Container0.contScroll.chkAllAgree.chksilence = "0"
		Container0.contScroll.btnOk.enable = "0"
	end if

End Function

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl82010_p4" then
	    if trim(sRet) ~= "" and trim(sRet) ~= nil and sRet ~= "close" then
			Dim tReturnData
			Dim nCnt
			
			tReturnData = Split(sRet, "☆")			 
			nCnt = #tReturnData
			for i = 0 to nCnt - 1
				Dim nIndex      
				nIndex = tonumber(tReturnData[i]) - 1
				g_tAgreeState[nIndex] = "1"
			next
			
			f_AllAgreeCheck()
	    end if	
	end if
	
End Sub


'============================================================================
Sub Container0_contScroll_btnOk_OnClick()
	DATAMANAGER.RequestTranData("oblon_basc_104a")
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'대출 고객정보 확인서 응답 조회
	if szTranID = "oblon_basc_102r" Then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , g_szAcno)
	end If

	'대출_부적정확인서 출력내역 관리
	if szTranID = "oblon_basc_104a" Then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 			, 0 , g_szAcno )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 			, 0 , ""      )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BSWR_DIV_CODE" 	, 0 , g_szBswrDivCode  )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_TYPE_CODE" 	, 0 , g_szLoanTypeCode )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE" 	, 0 , g_szContClsCode  )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ANXT_APRT_YN" 	, 0 , g_szAnxtAprtYn   )

	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	    
	'대출 고객정보 확인서 응답 조회
	if szTranID = "oblon_basc_102r" then
		g_szAnxtAprtYn = DATAMANAGER.GetDataValue( 0, "oblon_basc_102r", "OutBlock1", "ANXT_APRT_YN", 0)
		Dim szCustClsCode
		szCustClsCode = DATAMANAGER.GetDataValue( 0, "oblon_basc_102r", "OutBlock1", "CUST_CLS_CODE", 0)
		
		Dim szData
		szData = g_szAcno & "★" & "" & "★" & "" & "★" & szCustClsCode & "★" &  "" & "★" & "Y"
		
		Form.TriggerEvent("lnkMain", "InitData", szData)
	end if 

	'대출_부적정확인서 출력내역 관리
	if szTranID = "oblon_basc_104a" then	 
	    '정상종료
	    g_szRet = "Y"
'	    Form.ShowAlert("알림", "부적정확인서 등록 완료하였습니다.")
	    Form.MsgBox("알림", "부적정확인서 등록 완료하였습니다.", "COMPLETE", 6)
'	    Form.SendReturnToParent( "mbonl93503" , "Y" )
'	    Form.CloseForm()
	end if	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'대출_부적정확인서 출력내역 관리
	if szTranID = "oblon_basc_104a" then
	    Form.ShowAlert("알림", "부적정 보고서 확인처리 실패하였습니다. 다시 시도하세요.")
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "LinkHeight" then
		if CInt(sParam) > 0 then
			Container0.lnkMain.height = CInt(sParam)
			Container0.contScroll.top = CInt(sParam)
			Container0.SetScrollAutoSize()
			
			'Container0.imgDisable1.height = Container0.lnkMain.height
			Container0.imgDisable1.height = Form.calcUnResize(Container0.lnkMain.height, "1")
		end if
		
	'231218 대출용도에 따라 설명서 체크되도록 수정
	elseif sEventName == "SetchkAgree" then
'For TEST
'sParam = "5"
'Form.ShowAlert("SetchkAgree", sParam)	
		if CInt(sParam) == 5 then
			'신용거래설명서 보이지 않기
			Container0.contScroll.chkAgree1.visible = 0
			Container0.contScroll.chkAgree1.enable = 0
			Container0.contScroll.imgAgree1.visible = 0
			'증권담보융자설명서 보이고 위치조정
			Container0.contScroll.chkAgree2.top = 193
			Container0.contScroll.imgAgree2.top = 193
			g_nAll = 1
		elseif CInt(sParam) <= 4 then
			'신용거래설명서 보이기
			'증권담보융자설명서 보이지 않기
			Container0.contScroll.chkAgree2.visible = 0
			Container0.contScroll.chkAgree2.enable = 0
			Container0.contScroll.imgAgree2.visible = 0
			g_nAll = 1
		else
			'신용거래설명서 보이기
			'증권담보융자설명서 보이기	
			g_nAll = 2
		end if 
	end if 
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	'Container0.contScroll.imgAllAgree.setMaintainingRatio("1")
	Container0.contScroll.imgAgree1.setMaintainingRatio("1")
	Container0.contScroll.imgAgree2.setMaintainingRatio("1")
