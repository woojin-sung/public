	<SCRIPT_INFO _len="23316" _ulen="20780" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 공인인증서
' 02. 화면설명 : 공인인증서_관리(비번변경/삭제선택)
' 03. 작    성 : 2016.01.13 김보라
'-------------------------------------------------------------------
'블록체인 공동인증 START
'
' "~BCHAIN_숫자" 		: 공동앱과 연계시 사용하는 API 입니다.
' "~BCHAIN_SERVER~" 	: 추후 기간계 서비스로 대체될 전문입니다.
'
'-------------------------------------------------------------------

Dim g_sGubunCode 				'보안매체 구분코드

Dim g_sKofiaDN
Dim g_sKofiaAliasList			
Dim g_Alias					'그리드에서 선택된 Alias
Dim g_curAlias				'현재단말의 Alias

g_sKofiaDN = ""
g_sKofiaAliasList = ""
g_Alias = ""
g_curAlias = ""


Dim G_BC_CONFIRM_FILE 			'공동인증 본인확인화면 (mhetc90130_s1)
Dim G_BC_AGREE_FILE 			'공동인증 약관동의화면 (mhetc90130_s2)

Dim G_BC_ADD_FILE 			'추가인증풀팝업
Dim G_BC_SECURITY_FILE 		'보안카드풀팝업
Dim G_BC_QUESTION_FILE 		'부가정보풀팝업
Dim G_BC_OTP_FILE 			'일반/스마트OTP풀팝업
Dim G_BC_OCSP_FILE			'공인인증서 검증 팝업

Dim g_sID
Dim g_sStage020
Dim g_sStage021

g_sStage020 = ""
g_sStage021 = ""
g_sID = ""


'============================================================================
Sub Form_OnFormInit()

	g_curAlias 	= Form.GetSharedData("BCHAIN_ALIAS", false )
	g_sKofiaDN 	= Form.GetSharedData("BCHAIN_DN_DATA", false )
	g_sID 		= Form.GetSharedData("CERT_ID", false )
	'Form.ShowAlert(g_curAlias & "///" & g_sID, g_sKofiaDN)
		
	G_BC_CONFIRM_FILE 		= "mhetc90130_s1"		'공동인증 본인확인화면
	G_BC_AGREE_FILE			= "mhetc90130_s2"		'공동인증 약관동의화면
	G_BC_REGLIST_FILE			= "mhetc90130_s3"		'공동인증 등록단말내역
	
	G_BC_ADD_FILE 			= "mhetc90060_p11"	'추가인증풀팝업
	G_BC_SECURITY_FILE 		= "mhetc90060_p9"		'보안카드풀팝업
	G_BC_QUESTION_FILE		= "mhetc90060_pa"		'부가정보풀팝업
	G_BC_OTP_FILE 			= "mhetc90060_pb"		'일반/스마트OTP풀팝업
	G_BC_OCSP_FILE			= "mhetc90060_p5"		'공인인증서 검증 팝업
	

	'-----------------------------------------------------
	'[공동인증서] 블록체인 인증서 조회
	'
	'DN조회 -> Alias조회 순차조회 : BCHAIN_SERVER_DNREQ -> BCHAIN_SERVER_CERTLISTREQ
	'-----------------------------------------------------
		
	if g_sID == null or g_sID == "" then
		Form.MsgBox( "알림", "사용자 ID가 올바르지 않습니다.", "", 0 )
		return
	end if
	
	
	Request_obcsb_padc_021r("S", "1", g_sKofiaDN) '공동인증 Alias List조회
	
End Sub


'============================================================================
' 비밀번호변경/갱신/해지 클릭시 발생 이벤트
'============================================================================
Sub Grid1_OnClickUp(lRow, szCellID)

	'==============================================================================================
	' 비밀번호 변경 버튼 클릭
	'==============================================================================================
	
	if szCellID == "bd_cell18" then
				
		g_Alias = Grid1.GetCellData("bd_cell2", lRow)
		Form.triggerEvent("#", "bc_change", g_Alias & "★" & g_sKofiaDN)

	'=============================================================================================
	' 갱신 버튼 클릭
	'=============================================================================================
	
'	elseif szCellID == "bd_cell9999" then 'org13
'		
'		g_Alias = Grid1.GetCellData("bd_cell2", lRow)
'		Form.triggerEvent("#", "bc_renewal", g_Alias & "★" & g_sKofiaDN)
'		
	
	'==============================================================================================
	' 해지 버튼 클릭
	'==============================================================================================
	elseif szCellID == "bd_cell4" then
				
		g_Alias = Grid1.GetCellData("bd_cell2", lRow)
		Form.MsgBox("알림", "" & g_Alias & " " & "단말을 해지 하시겠습니까?" , "unreg", 1)
		'Form.triggerEvent("#", "bc_unregister", g_Alias & "★" & g_sKofiaDN  )
		'온라인 신원확인 동의 조회 (추가인증 후 해지 처리)
		'DATAMANAGER.RequestTranData("obcsb_padc_004r")
		
	end if
	
End Sub

 
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	'인증서 해지처리 응답 트리거
	if sEventName == "bc_unregister_complete" then
	
		if sParam == "ok" then
			
			Grid1.SetClear()
			Request_obcsb_padc_021r("S", "1", g_sKofiaDN) '공동인증 Alias List조회
			Form.ShowAlert("알림", "단말해지가 완료되었습니다.")
			
		end if
	
	'비밀번호 변경 처리 응답 트리거
	elseif sEventName == "bc_change_complete" then
	
		if sParam == "ok" then
			Form.ShowAlert("알림", "비밀번호 변경 및 등록이 완료되었습니다.")
		end if
	
	'갱신 처리 응답 트리거
	elseif sEventName == "bc_renewal_complete" then
	
		if sParam == "ok" then
			Form.ShowAlert("알림", "정상적으로 갱신되었습니다.")
		end if
		
	'20171027 비밀번호 오류 횟수 초과 트리거
	elseif sEventName == "bc_suspension_complete" then
	
		Grid1.SetClear()
		Request_obcsb_padc_021r("S", "1", g_sKofiaDN) '공동인증 Alias List조회
			
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	sDeviceID = Form.GetDeviceID()
	sUserID = Form.GetSharedData("CERT_ID" , false)
	
	if sUserID == "" then
		sUserID = Form.GetSharedData("&USER_ID", false )
	end if
	
		
	'온라인 신원확인 동의 서비스 INPUT값 세팅
	if szTranID == "obcsb_padc_004r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_padc_004r", "InBlock1", "ELFN_ID" , 0 , sUserID )		'ID
		
	elseif szTranID == "obcsb_oimf_638r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID() )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000" ) '인증서신규
		
	elseif szTranID == "obcsb_oimf_625r" then
		
		DATAMANAGER.SetUserID( sUserID ) 
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
		
	
	'====================================
	' 온라인 신원확인 동의 조회
	'====================================
	if szTranID == "obcsb_padc_004r" then
		
		g_dnData =  DATAMANAGER.GetDataValue(0, "obcsb_padc_004r" , "OutBlock1" , "DN_DATA" , 0)
		
		'OCSP 검증에 필요한 고객번호 Shared
		Form.SetSharedData("BC_CSNO" , DATAMANAGER.GetDataValue(0, "obcsb_padc_004r", "OutBlock1", "CSNO" , 0))
		
		if g_dnData == null or g_dnData == "" then
		    sText = "공인인증서 정보가 존재하지 않습니다.\n".."공인인증서 정보를 확인해주세요"
			Form.MsgBox( "알림", sText, "REG_MSG", 1 )
			sSendData = "cancel"
			Form.SendReturnToParent( "bc_vft" , sSendData)
			Form.CloseForm( )
         else
			DATAMANAGER.RequestTranData( "obcsb_oimf_638r" ) '추가인증대상,단말기지정약정조회
		end if
	
	'========================================
	' 추가인증대상,단말기지정약정조회
	'========================================
	elseif szTranID == "obcsb_oimf_638r" then
	
		if DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r", "OutBlock1", "UI_SPLM_YN" , 0) == "Y" then
			Dim sText
			sText = "고객님께서는 [단말기지정]서비스 고객이므로 지정단말에서만 공인인증서 발급/재발급이 가능합니다.\n"..
					"단말기를 등록하시겠습니까?"
			Form.MsgBox( "알림", sText, "REG_MSG", 1 )
		else
		     sTemp = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r", "OutBlock1", "SPLM_ATHN_STPL_YN" , 0)
		        
			if sTemp == "Y" then	
				'추가인증 팝업 호출(SMS인증 등...)
			  	Form.OpenFramePopup( G_BC_ADD_FILE , "bc_mod" , "" )	 
			'else
			 ' 	DATAMANAGER.RequestTranData( "obcsb_oimf_625r" ) '추가인증대상조회
			end if
		end if
		
	'=============================================
	' 추가인증대상조회
	'=============================================
	elseif szTranID == "obcsb_oimf_625r" then
		
		Dim sSPLM_ATHN_NCSR_YN 
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
         SetSecurityOpen()
	 
	
	'===========================================
	' 블록체인 서비스1
	'===========================================
'	elseif szTranID == "obcsb_padc_020a" then
'		
'		ERR_NO 				= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "ERR_NO" 				,0) '에러번호
'		ERR_INFO 			= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "ERR_INFO" 			,0) '에러정보
'		RSLT_INFO  			= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "RSLT_INFO" 			,0) '결과정보
'		DN_DATA   			= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "DN_DATA" 				,0) 'DN데이터
'		UNIN_NTAT_SNTN		= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "UNIN_NTAT_SNTN" 		,0) '공동인증서문장
'		DN_BYNM				= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "DN_BYNM" 				,0) 'DN별칭
'		UNIN_NTAT_STAT_CNTT 	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "UNIN_NTAT_STAT_CNTT" 	,0) '공동인증서상태내용
'	
'		g_sKofiaDN = DN_DATA
'				
'		'DN조회응답
'		if g_sStage020 = "N1" then
'			Request_obcsb_padc_021r("S", "1", g_sKofiaDN) '공동인증 Alias List조회
'		end if
'		
	
	'=======================================
	' 블록체인 서비스2
	'=======================================
	elseif szTranID == "obcsb_padc_021r" then
		
		ERR_NO 				= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "ERR_NO" 				,0) '에러번호
		ERR_INFO 			= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "ERR_INFO" 			,0) '에러정보
		RSLT_INFO  			= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "RSLT_INFO" 			,0) '결과정보
		UNIN_NTAT_SNTN		= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "UNIN_NTAT_SNTN" 		,0) '공동인증서문장
		UNIN_NTAT_STAT_CNTT 	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "UNIN_NTAT_STAT_CNTT" 	,0) '공동인증서상태내용
		DN_DATA			 	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "DN_DATA" 				,0) 'DN데이터
		UI_ABRV_SGNT_OPBL_KEY	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "UI_ABRV_SGNT_OPBL_KEY" 	,0) '축약서명공개키
		UI_ELCT_SGNT_DATA_CNTT	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "UI_ELCT_SGNT_DATA_CNTT" ,0) '전자서명데이터
		DN_BYNM			 	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "DN_BYNM" 				,0) 'Alias
		MTRT_DATE		 	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "MTRT_DATE" 			,0) '만기일자
	
		'==================================================================
		' 정상
		'==================================================================
		if CInt(ERR_NO) == 0 then '정상
		
			nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock2")
			nRow = 0
		
			if nCnt < 1 then
				Label0.visible = true
			else
				Label0.visible = false
		
			end if
		
			'-----------------------------------------------------------------------------------------------------
			'Alias List조회응답
			if g_sStage021 = "S1" then 
			
				g_sKofiaAliasList = ""
			
				' [참고]
				' ISSUE      : 인증서가 발급된 상태(유효한 상태는 아님)
				' VALID      : 유효한 상태(발급 후 공동인증 앱에 저장이 완료된 이후)
				' SUSPENSION : 효력정지 상태(공동인증앱 인증 5회 실패 시)
				' REVOKE     : 인증서가 폐기된 상태(인증서 해지 신청 시)
			
				For i = 0 to nCnt -1
					UNIN_NTAT_SNTN		= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock2", "UNIN_NTAT_SNTN" 		,i) '공동인증서문장
					DN_BYNM				= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock2", "DN_BYNM" 				,i) 'DN별칭
					UNIN_NTAT_STAT_CNTT	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock2", "UNIN_NTAT_STAT_CNTT"	,i) '공동인증서상태
					EXPIRE_DATE			= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock2", "MTRT_DATE" 			,i)
				
					date_year = Left(EXPIRE_DATE,4)
					date_month = Mid(EXPIRE_DATE,5,2)
					date_day = Mid(EXPIRE_DATE,7,2)
				
					EXPIRE_DATE = date_year & "-" & date_month & "-" & date_day
			
					'등록 시, 인증서상태를 보고 공동앱에 Alias List 넘기자
					if UNIN_NTAT_STAT_CNTT == "VALID" or UNIN_NTAT_STAT_CNTT == "ISSUE" then
				
						if Len(g_sKofiaAliasList) == 0 then
							g_sKofiaAliasList = DN_BYNM & "▣" & UNIN_NTAT_STAT_CNTT
						else
							g_sKofiaAliasList = g_sKofiaAliasList &  "★" & DN_BYNM & "▣" & UNIN_NTAT_STAT_CNTT
						end if
				
						Grid1.AddRow()
					
						Grid1.SetCellData("bd_cell16", nRow, "등록상태")
						Grid1.SetCellData("bd_cell17", nRow, "만기일자")
						Grid1.SetCellData("bd_cell2", nRow, DN_BYNM)
					
						if UNIN_NTAT_STAT_CNTT == "VALID" then
							UNIN_NTAT_STAT_CNTT_KOR = "정상"
							Grid1.SetCellFgColor("bd_cell21", nRow, 1)
						elseif UNIN_NTAT_STAT_CNTT == "ISSUE" then
							UNIN_NTAT_STAT_CNTT_KOR = "발급"
							Grid1.SetCellFgColor("bd_cell21", nRow, 93)
						elseif UNIN_NTAT_STAT_CNTT == "SUSPENSION" then
							UNIN_NTAT_STAT_CNTT_KOR = "정지"
							Grid1.SetCellFgColor("bd_cell21", nRow, 2)
						elseif UNIN_NTAT_STAT_CNTT == "REVOKE" then
							UNIN_NTAT_STAT_CNTT_KOR = "해지"
							Grid1.SetCellFgColor("bd_cell21", nRow, 50)
						end if
					
					
						Grid1.SetCellData("bd_cell21",nRow, UNIN_NTAT_STAT_CNTT_KOR)
						Grid1.SetCellData("bd_cell19", nRow, EXPIRE_DATE)
						Grid1.SetCellData("bd_cell13", nRow, "해지")
						Grid1.SetCellData("bd_cell18", nRow, "비밀번호 변경")
						Grid1.SetCellData("bd_cell4", nRow, "단말해지")
					
						if g_curAlias <> DN_BYNM then
							Grid1.SetCellEnable("bd_cell13", nRow, false)
							Grid1.SetCellEnable("bd_cell18", nRow, false)
							Grid1.SetCellFgColor("bd_cell13", nRow, 80)
							Grid1.SetCellFgColor("bd_cell18", nRow, 80)
						end if
						
						nRow = nRow + 1
						
					end if
				Next
			end if
			
		'==============================================================================
		'
		'==============================================================================
		'elseif CInt(ERR_NO) == 0 then
			
		'==============================================================================
		' 오류
		'==============================================================================
		else '오류
				
			'RSLT_INFO : 기간계 정의 메시지
			'ERR_INFO : 금투협 블록체인 정의 메시지		
			Form.MsgBox( "알림", "[TR]" & RSLT_INFO & "(" & ERR_INFO & ")", "", 0 )
			
		end if
		
	end if
	
End Sub

'============================================================================
' 보안매체별 화면오픈
'============================================================================
Function SetSecurityOpen()
	
	'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
	
	if g_sGubunCode == "0" then '보안카드
		Form.OpenFramePopup( G_BC_SECURITY_FILE , "" , "" )	'보안카드풀팝업
		
	elseif g_sGubunCode == "1" then '부가정보
		Form.OpenFramePopup( G_BC_QUESTION_FILE , "" , "" )	'부가정보풀팝업
		
	elseif g_sGubunCode == "3" then 'OTP
		Form.OpenFramePopup( G_BC_OTP_FILE , "" , "" )		'일반/스마트OTP풀팝업
		
	elseif g_sGubunCode == "2" then '없을경우
		Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
		
	else '에러
		Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
	end if
	
End Function

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	'=========================================
	' 추가/보안매체 인증 처리결과 트리거
	'=========================================
	if sKeyName == G_BC_SECURITY_FILE or sKeyName == G_BC_QUESTION_FILE or sKeyName == G_BC_OTP_FILE then
	
		'정상적으로 처리가 되었다면
		if sRet == "ok" then
		
			'90130_p2화면에 해지요청 트리거 발생
			Form.triggerEvent("#", "bc_unregister", g_Alias & "★" & g_sKofiaDN )
		
		end if
			
	'==============================================
	' SMS인증/ARS인증 처리 결과
	'==============================================
	elseif sKeyName == G_BC_ADD_FILE then
			if sRet =="ok" then
				Form.triggerEvent("#", "bc_unregister", g_Alias & "★" & g_sKofiaDN  )
			end if
	end if
	
End Sub

