'=================================================================================================
Sub Request_obcsb_padc_021r(sPros, sStage, sOutput)
	
	'sOutput => sAlias★sDn★sResponse
	szTranID = "obcsb_padc_021r"
		
	'===================================================================
	UNIN_ATHN_PROS_CLCD 	= "" '공동인증처리구분코드
	UNIN_NTAT_SNTN		= "" '공동인증서문장
	ELFN_ID				= "" '전자금융ID
	ACNO					= "" '계좌번호
	DN_DATA				= "" 'DN데이터
	RCNO					= "" '실명확인번호
	TERM_ID				= "" '단말ID
	DN_BYNM				= "" 'DN별칭
	UI_ELCT_SGNT_DATA_CNTT	= "" 'UI전자서명내용 (ex-length : 2402 byte)
	'===================================================================
		
	'공통
	ELFN_ID				= g_sID
	UNIN_ATHN_PROS_CLCD	= sPros
	TERM_ID				= Form.GetDeviceID()
		
	g_sStage021 = sPros&sStage
	
	'---------------------------------------------------------------
	'인증서 Alist List조회
	if sPros == "S" and sStage == "1" then
		g_sKofiaAliasList	= ""
		
		'sOutput => DN
		DN_DATA			= sOutput
		
	'---------------------------------------------------------------
	else
		Form.MsgBox( "알림", "공동인증 조회서비스 입력값이 존재하지 않습니다.", "", 0 )
		exit Sub	
	end if
	
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UNIN_ATHN_PROS_CLCD"	, 0 , UNIN_ATHN_PROS_CLCD)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UNIN_NTAT_SNTN"			, 0 , UNIN_NTAT_SNTN)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ELFN_ID"				, 0 , ELFN_ID)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"					, 0 , ACNO)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "DN_DATA"				, 0 , DN_DATA)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "RCNO"					, 0 , RCNO)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TERM_ID"				, 0 , TERM_ID)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "DN_BYNM"				, 0 , DN_BYNM)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UI_ELCT_SGNT_DATA_CNTT"	, 0 , UI_ELCT_SGNT_DATA_CNTT)

	DATAMANAGER.RequestTranData( szTranID )	

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obcsb_padc_004r" then

		Form.MsgBox("알림", szErrMsg, "", 6 )
		
'	elseif szTranID == "obcsb_padc_020a" then
'	
'		if Len(sSubMsg) > 1 then
'			Form.MsgBox( "알림", "[TR]" & szErrMsg & "\n" & "(" & sSubMsg & ")", "BCHAIN", 0 )
'		else
'			Form.MsgBox( "알림", "[TR]" & szErrMsg , "BCHAIN", 0 )
'		end if
		
	end if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "unreg" then
		if sRet == "ok" then
			Form.triggerEvent("#", "bc_unregister", g_Alias & "★" & g_sKofiaDN  )
		end if
	end if
End Sub

'=============================================================================

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obcsb_padc_004r" trcode="obcsb_padc_004r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obcsb_oimf_638r" trcode="obcsb_oimf_638r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obcsb_oimf_625r" trcode="obcsb_oimf_625r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obcsb_padc_020a" trcode="obcsb_padc_020a" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obcsb_padc_021r" trcode="obcsb_padc_021r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obcsb_padc_004r" title="전자금융ID 공인인증서정보 발급" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="45" _ulen="37" >

