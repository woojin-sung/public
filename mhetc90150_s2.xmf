'============================================================================
'20240429 SWJ START
'클라우드 인증 발급_저장 방식 선택
'============================================================================

'============================================================================
Sub Container0_ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Container0.ImgBackPress.setmaintainingratio("1")
	Container0.ImgMobile.setmaintainingratio("1")
	Container0.ImgCloud.setmaintainingratio("1")
End Sub
'============================================================================
Sub Form_OnFormInit()
	Container0.ImgBtnCloud.imgpath = "bg_infobox_n.9"
	Container0.ImgBtnMobile.imgpath = "bg_infobox_o.9"
End Sub
'============================================================================
Sub Container0_ImgBtnCloud_OnClick()
	Container0.ImgBtnMobile.imgpath = "bg_infobox_n.9"
	Container0.ImgBtnCloud.imgpath = "bg_infobox_o.9"
End Sub
'============================================================================
Sub Container0_ImgBtnMobile_OnClick()
	Container0.ImgBtnCloud.imgpath = "bg_infobox_n.9"
	Container0.ImgBtnMobile.imgpath = "bg_infobox_o.9"
End Sub

'============================================================================
Sub Container0_ImgCloud_OnClick()
	Container0_ImgBtnCloud_OnClick()
End Sub

'============================================================================
Sub Container0_ImgMobile_OnClick()
	Container0_ImgBtnMobile_OnClick()
End Sub


