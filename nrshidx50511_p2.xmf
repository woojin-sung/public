'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'-----------------------------------------------
' 이미지
'-----------------------------------------------
Dim g_szCloseImg  
g_szCloseImg = "icon_close"

'-----------------------------------------------
' 컬러코드
'-----------------------------------------------
' 기본 텍스트 컬러 (검정색)
Dim g_szTxtColor_Normal 
g_szTxtColor_Normal 	= "334"

' 기본 텍스트 컬러 (회색)
Dim g_szTxtColor_Grey 
g_szTxtColor_Grey 	= "333"

' 기본 텍스트 컬러 (흰색)
Dim g_szTxtColor_White 
g_szTxtColor_White 	= "338"

' 기본 텍스트 컬러 (빨강)
Dim g_szTxtColor_Red 
g_szTxtColor_Red = "326"

'-----------------------------------------------
' 기타 전역변수
'-----------------------------------------------
Dim g_szTitle
g_szTitle = "유의사항"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************
'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	'-----------------------------------------------
	' 뒤로가기 버튼 초기화
	'-----------------------------------------------
	lblTitle.paddinginfo = "0,0,0,0"
	lblTitle.caption = g_szTitle
	
	'-----------------------------------------------
	' 유의사항 버튼 초기화
	'-----------------------------------------------
	imgClose.SetMaintainingRatio("3")
	imgClose.imgpath = g_szCloseImg
	
	'=============================================================================================
	szTextSize = Form.getEnvData("common.textsize")

	nIdx = Pannel0.AddRow()
	Pannel0.setPropCardCell("paddinginfo" ,"lblGuide",nIdx,"0,1,0,0")
	Pannel0.setPropCardCell("caption" ,"lblGuide",nIdx,"·")
	
	szText = "제공되는 시세정보는 정규장 기준으로 제공되어 조회됩니다."
	Pannel0.setPropCardCell("paddinginfo" ,"lblInfo",nIdx,"0,0,0,0")
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	Pannel0.setPropCardCell("caption" ,"lblInfo",nIdx,szText)
	'Pannel0.SetCellValue("lblInfo",nIdx,szText)
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	
	if szTextSize = "2" then
		Pannel0.SetCardWHAt(nIdx,50)
	elseif szTextSize = "-2" then
		Pannel0.SetCardWHAt(nIdx,35)
	else
		Pannel0.SetCardWHAt(nIdx,45)
	end if
	
	'=============================================================================================
	nIdx = Pannel0.AddRow()
	Pannel0.setPropCardCell("paddinginfo" ,"lblGuide",nIdx,"0,1,0,0")
	Pannel0.setPropCardCell("caption" ,"lblGuide",nIdx,"·")
	
	szText = "미국 ETF의 경우 주간거래 시세는 미적용 되며 정규장 시세(Pre Market 포함)로만 조회 됩니다."
	Pannel0.setPropCardCell("paddinginfo" ,"lblInfo",nIdx,"0,0,0,0")
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	Pannel0.setPropCardCell("caption" ,"lblInfo",nIdx,szText)
	'Pannel0.SetCellValue("lblInfo",nIdx,szText)
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	
	if szTextSize = "2" then
		Pannel0.SetCardWHAt(nIdx,75)
	elseif szTextSize = "-2" then
		Pannel0.SetCardWHAt(nIdx,35)
	else
		Pannel0.SetCardWHAt(nIdx,45)
	end if
	
	'=============================================================================================
	nIdx = Pannel0.AddRow()
	Pannel0.setPropCardCell("paddinginfo" ,"lblGuide",nIdx,"0,1,0,0")
	Pannel0.setPropCardCell("caption" ,"lblGuide",nIdx,"·")
	
	szText = "해외 ETF 시세는 '실시간 시세 신청' 기준으로(실시간 시세 또는 지연 시세) 조회됩니다."
	Pannel0.setPropCardCell("paddinginfo" ,"lblInfo",nIdx,"0,0,0,0")
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	Pannel0.setPropCardCell("caption" ,"lblInfo",nIdx,szText)
	'Pannel0.SetCellValue("lblInfo",nIdx,szText)
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	
	if szTextSize = "2" then
		Pannel0.SetCardWHAt(nIdx,75)
	elseif szTextSize = "-2" then
		Pannel0.SetCardWHAt(nIdx,35)
	else
		Pannel0.SetCardWHAt(nIdx,45)
	end if
	
	'=============================================================================================
	nIdx = Pannel0.AddRow()
	Pannel0.setPropCardCell("paddinginfo" ,"lblGuide",nIdx,"0,1,0,0")
	Pannel0.setPropCardCell("caption" ,"lblGuide",nIdx,"·")
	
	szText = "적용 환율은 당일 최초 고시환율로 적용되며 기본 통화가 아닌 다른 통화로 환산된 값은 고객님들의 편의를 위한 참고용 정보입니다."
	Pannel0.setPropCardCell("paddinginfo" ,"lblInfo",nIdx,"0,0,0,0")
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	Pannel0.setPropCardCell("caption" ,"lblInfo",nIdx,szText)
	'Pannel0.SetCellValue("lblInfo",nIdx,szText)
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	
	
	if szTextSize = "2" then
		Pannel0.SetCardWHAt(nIdx,95)
	elseif szTextSize = "-2" then
		Pannel0.SetCardWHAt(nIdx,55)
	else
		Pannel0.SetCardWHAt(nIdx,65)
	end if
	'=============================================================================================
	
	nIdx = Pannel0.AddRow()
	Pannel0.setPropCardCell("paddinginfo" ,"lblGuide",nIdx,"0,1,0,0")
	Pannel0.setPropCardCell("caption" ,"lblGuide",nIdx,"·")
	
	szText = "당일 장중 데이터는 집계한 자료를 단순 누계한 수치로 실제 매매 규모와 차이가 발생할 수 있습니다."
	Pannel0.setPropCardCell("paddinginfo" ,"lblInfo",nIdx,"0,0,0,0")
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	Pannel0.setPropCardCell("caption" ,"lblInfo",nIdx,szText)
	'Pannel0.SetCellValue("lblInfo",nIdx,szText)
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	
	if szTextSize = "2" then
		Pannel0.SetCardWHAt(nIdx,75)
	elseif szTextSize = "-2" then
		Pannel0.SetCardWHAt(nIdx,35)
	else
		Pannel0.SetCardWHAt(nIdx,45)
	end if
	
	'=============================================================================================
	
	nIdx = Pannel0.AddRow()
	Pannel0.setPropCardCell("paddinginfo" ,"lblGuide",nIdx,"0,1,0,0")
	Pannel0.setPropCardCell("caption" ,"lblGuide",nIdx,"·")
	
	szText = "본 서비스에서 제공되는 데이터에 대한 저작권은 모닝스타코리아와 메리츠증권에 있으며 복사 또는 배포할 수 없습니다."
	Pannel0.setPropCardCell("paddinginfo" ,"lblInfo",nIdx,"0,0,0,0")
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	Pannel0.setPropCardCell("caption" ,"lblInfo",nIdx,szText)
	'Pannel0.SetCellValue("lblInfo",nIdx,szText)
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	
	if szTextSize = "2" then
		Pannel0.SetCardWHAt(nIdx,95)
	elseif szTextSize = "-2" then
		Pannel0.SetCardWHAt(nIdx,55)
	else
		Pannel0.SetCardWHAt(nIdx,65)
	end if
	
	'=============================================================================================
	
	nIdx = Pannel0.AddRow()
	Pannel0.setPropCardCell("paddinginfo" ,"lblGuide",nIdx,"0,1,0,0")
	Pannel0.setPropCardCell("caption" ,"lblGuide",nIdx,"·")
	
	szText = "정보의 정확성과 신뢰성을 보장하기 위해 최선을 다하지만 이를 보장하지 않으며 손실이나 손상에대한 법적 책임이 없습니다."
	Pannel0.setPropCardCell("paddinginfo" ,"lblInfo",nIdx,"0,0,0,0")
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	Pannel0.setPropCardCell("caption" ,"lblInfo",nIdx,szText)
	'Pannel0.SetCellValue("lblInfo",nIdx,szText)
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	
	if szTextSize = "2" then
		Pannel0.SetCardWHAt(nIdx,95)
	elseif szTextSize = "-2" then
		Pannel0.SetCardWHAt(nIdx,55)
	else
		Pannel0.SetCardWHAt(nIdx,65)
	end if
	
	'=============================================================================================
	
	nIdx = Pannel0.AddRow()
	Pannel0.setPropCardCell("paddinginfo" ,"lblGuide",nIdx,"0,1,0,0")
	Pannel0.setPropCardCell("caption" ,"lblGuide",nIdx,"·")
	
	szText = "또한 제3자 데이터 제공업체에서 자료를 제공하므로 수신이 지연되거나 일부 정보가 정확하지 않을 수 있습니다."
	Pannel0.setPropCardCell("paddinginfo" ,"lblInfo",nIdx,"0,0,0,0")
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	Pannel0.setPropCardCell("caption" ,"lblInfo",nIdx,szText)
	'Pannel0.SetCellValue("lblInfo",nIdx,szText)
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	
	if szTextSize = "2" then
		Pannel0.SetCardWHAt(nIdx,95)
	elseif szTextSize = "-2" then
		Pannel0.SetCardWHAt(nIdx,55)
	else
		Pannel0.SetCardWHAt(nIdx,65)
	end if
	
	'=============================================================================================
	
	nIdx = Pannel0.AddRow()
	Pannel0.setPropCardCell("paddinginfo" ,"lblGuide",nIdx,"0,1,0,0")
	Pannel0.setPropCardCell("caption" ,"lblGuide",nIdx,"·")
	
	szText = "ETF는 예금자 보호법에 따라 보호되지 않습니다."
	Pannel0.setPropCardCell("paddinginfo" ,"lblInfo",nIdx,"0,0,0,0")
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	Pannel0.setPropCardCell("caption" ,"lblInfo",nIdx,szText)
	'Pannel0.SetCellValue("lblInfo",nIdx,szText)
	Pannel0.setPropCardCell("autofit" ,"lblInfo",nIdx,"1")
	

End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
   Init_Control()
End Sub

'===============================================
' imgInfo_OnClick
'===============================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

