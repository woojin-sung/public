	<SCRIPT_INFO _len="15486" _ulen="13206" >
Dim g_szRet
Dim g_szFundNm				'펀드명
Dim g_szCustIvicGradCntt		'고객투자성향
Dim g_szInvtProdRiskGradCntt 	'상품위험등급

Dim g_szGradeCode	'상품등급
Dim g_szInvType	'투자성향등급

Dim g_KYC_SPCL_INVR_YN	'KYC전문투자자여부

'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.setMaintainingRatio("1")
	
	Container0.ImgRiskGrade1.setMaintainingRatio("1")
	Container0.ImgRiskGrade2.setMaintainingRatio("1")
	Container0.ImgRiskGrade3.setMaintainingRatio("1")
	Container0.ImgRiskGrade4.setMaintainingRatio("1")
	Container0.ImgRiskGrade5.setMaintainingRatio("1")
	
	
	Container0.ImgInvestGrade1.setMaintainingRatio("1")
	Container0.ImgInvestGrade2.setMaintainingRatio("1")
	Container0.ImgInvestGrade3.setMaintainingRatio("1")
	Container0.ImgInvestGrade4.setMaintainingRatio("1")
	Container0.ImgInvestGrade5.setMaintainingRatio("1")
	
	
	Container0.Icon1.setMaintainingRatio("1")
	Container0.Icon2.setMaintainingRatio("1")
	
	
	
	Container1.Icon10.setMaintainingRatio("1")
	Container1.Icon20.setMaintainingRatio("1")
	Container1.imgTop.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData( )

	If szOpenData <> "" And szOpenData <> null Then
'		Form.ShowAlert("", szOpenData)
		tData = Split(szOpenData, "★")
		
		g_szAccNo		= tData[0]	'계좌번호
		g_szShortCd 		= tData[1]	'종목코드

		DATAMANAGER.RequestTranData("obcsb_acif_400r")		
	end if		
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'고객투자성향 및 상품위험등급조회
	if	szTranID	=	"obcsb_acif_400r"	then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD", 0, g_szShortCd)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
    '고객투자성향 및 상품위험등급조회
	if	szTranID	=	"obcsb_acif_400r"	then
		Dim szInvestGrd, szPrdtGrd, szSpecialYn, szAnxtAprtYn

		g_szInvType			= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "KYC_INVT_INCL_GRAD_CODE"           , 0 )	'KYC투자성향등급코드
		g_szGradeCode			= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "KYC_PROD_GRAD_CODE"           , 0 )	'KYC상품등급토드
		szInvestGrd			= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "CUST_IVIC_GRAD_CNTT"           , 0 )	'고객투자성향등급내용
		szPrdtGrd        		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "INVT_PROD_RISK_GRAD_CNTT" , 0 )	'투자상품위험등급내용
		g_KYC_SPCL_INVR_YN	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "KYC_SPCL_INVR_YN" , 0 )	'KYC전문투자자여부
		g_szAnxtAprtYn		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ANXT_APRT_YN"          , 0 )	'부적정여부

		
		g_szInvTypeNm = Form.GetMetaData("KYC투자성향등급코드", g_szInvType)
		Form.SetSharedData("BDM_APLY_KYC_GRAD", g_szInvType)	'(고객적용)투자성향등급
		
'		Form.ShowAlert("g_szInvTypeNm", g_szInvTypeNm)
		

		'---------------------------------------------------
		'전문투자자
		'---------------------------------------------------	
		if g_KYC_SPCL_INVR_YN == "Y" then	
			Container0.visible = 0
			Container1.visible = 1
						
			Container1.Label10.caption = "고객님은 전문투자자로\n등록된 상태입니다."
			
			Container1.Table2.SetCellString(1, 1, "전문투자자")
			Container1.Table2.SetCellString(2, 1, szPrdtGrd)
			
			szResult = "고객님께서는 전문투자자로 등록되어 투자성향 진단이 면제되며, "
						.. "모든 위험등급의 상품을 거래하실 수 있습니다."
			
			Container1.lblResult.caption = szResult
			
			
			'투자성향재진단 숨김
			Container1.imgRdo00.visible = 0
			Container1.Icon10.visible = 0
			Container1.Label60.visible = 0
			
			'가입중단 숨김
			btnCancel.visible = 0
			btnOK.left = 0
			btnOK.width = 375
		
		
		'---------------------------------------------------
		'정보미제공
		'---------------------------------------------------	
		elseif g_szInvTypeNm == "정보미제공" then			
			Container0.visible = 0
			Container1.visible = 1
						
			Container1.Label10.caption = "고객님의 투자성향은\n정보미제공 상태입니다."
			
			Container1.Table2.SetCellString(1, 1, g_szInvTypeNm)
			Container1.Table2.SetCellString(2, 1, szPrdtGrd)
			
			szResult = "투자자정보를 제공하지 않는 경우 관련 법령에 따라 적정성 원칙 대상상품 등의 거래가 제한될 수 있으며, "
						.. "거래하고자 하는 고객님께서는 투자성향진단 설문지를 작성하셔야 합니다.  "
			
			Container1.lblResult.caption = szResult
			
		
		
		'---------------------------------------------------
		'일반투자자
		'---------------------------------------------------	
		else
			Container0.visible = 1
			Container1.visible = 0
	
			if g_szAnxtAprtYn = "Y" then	'부적정여부
				Container0.Label1.caption = "고객님의 투자성향에\n적합하지 않은 상품입니다."
				Container0.Label1.changeTextAttr(11, 7, 10, 0, true)	
			else			
				Container0.Label1.caption = "고객님의 투자성향에\n적합한 상품입니다."
				Container0.Label1.changeTextAttr(11, 3, 335, 0, true)	
			end if
			
			'---------------------------------------------------
			'일반투자자 : 상품위험등급
			'---------------------------------------------------		
			if g_szGradeCode = "01" then				
				Container0.ImgRiskGrade1.imgpath = "invgrade_01_n.png"
				Container0.ImgRiskGrade2.imgpath = "invgrade_02_n.png"
				Container0.ImgRiskGrade3.imgpath = "invgrade_02_n.png"
				Container0.ImgRiskGrade4.imgpath = "invgrade_03_n.png"
				Container0.ImgRiskGrade5.imgpath = "invgrade_03_o.png"
				
				Container0.lblRisk01.caption = "초고위험"
				Container0.lblRisk01.changeTextAttr(0, 4, 4, -2, true)	
				
			elseif g_szGradeCode = "02" then
				Container0.ImgRiskGrade1.imgpath = "invgrade_01_n.png"
				Container0.ImgRiskGrade2.imgpath = "invgrade_02_n.png"
				Container0.ImgRiskGrade3.imgpath = "invgrade_02_n.png"
				Container0.ImgRiskGrade4.imgpath = "invgrade_03_o.png"
				Container0.ImgRiskGrade5.imgpath = "invgrade_04_g.png"
				
				Container0.lblRisk02.caption = "고위험"
				Container0.lblRisk02.changeTextAttr(0, 3, 4, -2, true)	
				
			elseif g_szGradeCode = "03" then
				Container0.ImgRiskGrade1.imgpath = "invgrade_01_n.png"
				Container0.ImgRiskGrade2.imgpath = "invgrade_02_n.png"
				Container0.ImgRiskGrade3.imgpath = "invgrade_02_o.png"
				Container0.ImgRiskGrade4.imgpath = "invgrade_04_g.png"
				Container0.ImgRiskGrade5.imgpath = "invgrade_04_g.png"
				
				Container0.lblRisk03.caption = "중위험"
				Container0.lblRisk03.changeTextAttr(0, 3, 4, -2, true)	
				
			elseif g_szGradeCode = "04" then
				Container0.ImgRiskGrade1.imgpath = "invgrade_01_n.png"
				Container0.ImgRiskGrade2.imgpath = "invgrade_02_o.png"
				Container0.ImgRiskGrade3.imgpath = "invgrade_04_g.png"
				Container0.ImgRiskGrade4.imgpath = "invgrade_04_g.png"
				Container0.ImgRiskGrade5.imgpath = "invgrade_04_g.png"
				
				Container0.lblRisk04.caption = "저위험"
				Container0.lblRisk04.changeTextAttr(0, 3, 4, -2, true)	
				
			elseif g_szGradeCode = "05" then
				Container0.ImgRiskGrade1.imgpath = "invgrade_01_o.png"
				Container0.ImgRiskGrade2.imgpath = "invgrade_04_g.png"
				Container0.ImgRiskGrade3.imgpath = "invgrade_04_g.png"
				Container0.ImgRiskGrade4.imgpath = "invgrade_04_g.png"
				Container0.ImgRiskGrade5.imgpath = "invgrade_04_g.png"
		
				Container0.lblRisk05.caption = "초저위험"
				Container0.lblRisk05.changeTextAttr(0, 4, 4, -2, true)	
				
			End if
	
	
			'---------------------------------------------------
			'일반투자자 : 고객투자성향
			'---------------------------------------------------
			g_szInvTypeNm = Form.GetMetaData("KYC투자성향등급코드", g_szInvType)
			
			if g_szInvType = "01" then	
				Container0.ImgInvestGrade1.imgpath = "invgrade_01_n.png"
				Container0.ImgInvestGrade2.imgpath = "invgrade_02_n.png"
				Container0.ImgInvestGrade3.imgpath = "invgrade_02_n.png"
				Container0.ImgInvestGrade4.imgpath = "invgrade_03_n.png"
				Container0.ImgInvestGrade5.imgpath = "invgrade_03_o.png"
				
				Container0.lblInvt01.caption = "고수익\n지향형"
				Container0.lblInvt01.changeTextAttr(0, 7, 4, -2, true)	
				
				szResult = "고객님은 투자 위험을 적극적으로 수용하면서 국내외 다양한 고수익 기회를 추구하시는 '고수익지향형' 투자 유형입니다. "
							.. "당사 상품분류 기준 상 '고수익 고위험'을 추구하는 상품을 비롯한 당사 모든 상품 가입이 가능하십니다. "
							.. "단, 해당 상품군 중 '원금 이상의 손실'이 발생할 가능성이 있는 상품도 있사오니 투자에 유의하셔야 합니다."
				
				Container0.lblResult.caption = szResult
			
			elseif g_szInvType = "02" then	
				Container0.ImgInvestGrade1.imgpath = "invgrade_01_n.png"
				Container0.ImgInvestGrade2.imgpath = "invgrade_02_n.png"
				Container0.ImgInvestGrade3.imgpath = "invgrade_02_n.png"
				Container0.ImgInvestGrade4.imgpath = "invgrade_03_o.png"
				Container0.ImgInvestGrade5.imgpath = "invgrade_04_g.png"

				Container0.lblInvt02.caption = "성장\n지향형"
				Container0.lblInvt02.changeTextAttr(0, 6, 4, -2, true)	
				
				szResult = "고객님은 투자원금의 손실을 상당부분 감수하더라도 주식형펀드, 투기등급채권등을 통해 수익을 추구하시는 ‘성장지향형＇투자 유형입니다. "
							.. "따라서 고수익 고위험 상품군을 제외한 모든 상품 가입이 가능하십니다. "
							.. "단, 해당 상품군 중 원금 전체 손실이 발생할 가능성이 있는 상품도 있사오니 투자에 유의하시기 바랍니다."
				
				Container0.lblResult.caption = szResult
			
			elseif g_szInvType = "03" then	
				Container0.ImgInvestGrade1.imgpath = "invgrade_01_n.png"
				Container0.ImgInvestGrade2.imgpath = "invgrade_02_n.png"
				Container0.ImgInvestGrade3.imgpath = "invgrade_02_o.png"
				Container0.ImgInvestGrade4.imgpath = "invgrade_04_g.png"
				Container0.ImgInvestGrade5.imgpath = "invgrade_04_g.png"
				
				Container0.lblInvt03.caption = "중립형"
				Container0.lblInvt03.changeTextAttr(0, 3, 4, -2, true)	
				
				szResult = "고객님은 투자원금의 손실을 감수하더라도 채권금리보단 높은 투자수익을 추구하시는 ‘중립형＇투자 유형입니다. "
							.. "‘중립형＇투자는 특정자산에 편중을 피하고 중위험 투자 방식의 포트폴리오 구성을 지향합니다. "
							.. "따라서 고객님께서는 채권 관련 상품과 주식상품의 혼합형 상품을 포함, 해당 유형 이하 위험등급 상품 가입이 가능하십니다."
				
				Container0.lblResult.caption = szResult
			
			elseif g_szInvType = "04" then	
				Container0.ImgInvestGrade1.imgpath = "invgrade_01_n.png"
				Container0.ImgInvestGrade2.imgpath = "invgrade_02_o.png"
				Container0.ImgInvestGrade3.imgpath = "invgrade_04_g.png"
				Container0.ImgInvestGrade4.imgpath = "invgrade_04_g.png"
				Container0.ImgInvestGrade5.imgpath = "invgrade_04_g.png"
				
				Container0.lblInvt04.caption = "안정\n지향형"
				Container0.lblInvt04.changeTextAttr(0, 6, 4, -2, true)	
				
				szResult = "고객님은 최대한 투자원금을 보전하면서 정기예금 금리보다 조금 높은 투자수익을 추구하시는 ‘안정지향형’ 투자유형입니다. "
							.. "따라서 신용등급이 높은 국공채, 회사채, 기업어음 및 채권형펀드 등 채권 관련 상품 가입이 가능하십니다. "
							.. "단, 주식 관련 상품등 위험자산의 편입에 따른 원금 손실도 발생할 수 있습니다."
				
				Container0.lblResult.caption = szResult
			
			elseif g_szInvType = "05" then	
				Container0.ImgInvestGrade1.imgpath = "invgrade_01_o.png"
				Container0.ImgInvestGrade2.imgpath = "invgrade_04_g.png"
				Container0.ImgInvestGrade3.imgpath = "invgrade_04_g.png"
				Container0.ImgInvestGrade4.imgpath = "invgrade_04_g.png"
				Container0.ImgInvestGrade5.imgpath = "invgrade_04_g.png"
				
				Container0.lblInvt05.caption = "이자\n소득형"
				Container0.lblInvt05.changeTextAttr(0, 6, 4, -2, true)	
				
				szResult = "고객님은 투자원금을 보전 하면서 정기예금 수준의 투자수익을 추구하시는 ‘이자소득형’ 투자유형입니다. "
							.. "따라서 예금신탁상품, 원금보장상품 및 기타 당사 상품 분류기준에 따른 상품가입이 가능하십니다."
				
				Container0.lblResult.caption = szResult
				
			end if
			
		end if
		
	End If
End Sub

