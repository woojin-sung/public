'============================================================================
' 화 면 명 : 관심종목_종목편집
' 화면설명 : 관심종목_관심그룹에 해당되는 종목을 편집하는 Sub화면
' 작    성 : 2015.12.04 ~ ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szRow
Dim g_szCd		' 종목 등록때 필요
g_szCd = ""

Dim g_szTitle
g_szTitle = "알림"

' 20160407 종목다중선택을 위해 필요한 변수
Dim g_tCode()
g_tCode = {}

Dim testCode

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'============================================================================
' Insert_cmbGroup :  관심그룹을 그룹콤보에 넣기
'============================================================================
Function Insert_cmbGroup()
	Dim szgrpList, szKey, szNm, szSave
	Dim nRow, nIdx, nSelect

	nRow = grdGroup.rowcount
	nIdx = -1
	nSelect = 0
	szgrpList = ""
	
	' 최종 선택(저장)된 관심그룹 키
	sEnvKey = "INTEREST_" & Form.GetSharedData( "&USER_ID", false )
	szSave = Form.GetEnvData(sEnvKey)	

	' ---- 관심종목 그룹 리스트 존재시 Start --------------------------------
	if Int(nRow) > 0 then
		For i = 0 to nRow -1
			szKey = grdGroup.GetCellData("bd_code", i)
			szNm  = grdGroup.GetCellData("bd_name", i)

			if szgrpList == "" then
				szgrpList = szKey & "`" & szNm
			else
				szgrpList = szgrpList & "\r\n" & szKey & "`" & szNm
			end if
			
			if nIdx >= 0 then
				nIdx = nIdx + 1
			else
				nIdx = 0
			end if
			
			if szSave == szKey then
				nSelect = nIdx
			end if
			
			' 폼탭 페이지 추가
			'fmTab.insertPage = 1
		Next
		
		
		'20190807 LES START
		if szgrpList == "" then
			szgrpList = "BB" & "`" & "최근조회종목"
		else
			szgrpList = szgrpList & "\r\n" & "BB" & "`" & "최근조회종목"
		end if
		'20190807 LES END
			
		
	end if
	' ---- 관심종목 그룹 리스트 존재시 End ----------------------------------
	
	' 관심그룹콤보에 리스트 init		
	cmbGroup.cbinputdatatext = szgrpList
	
	' 관심그룹콤보에서 최종 저장된 그룹 선택
	cmbGroup.currentindex = nSelect		
End Function

'============================================================================
' Change_Len
'============================================================================
Function Change_Len(szData)
	if Len(szData) == 1 then
		Change_Len = "0" & CStr(szData)
	else
		Change_Len = CStr(szData)
	end if 
End Function

'============================================================================
' Check_LocalOrServer : 로컬, 서버 구분하여 종목을 편집한다.
'============================================================================
Function Check_LocalOrServer()
'	if g_szCloud == "1" then
		DATAMANAGER.RequestTranData("ohhts_intr_039r")
'		Save_GWList()
'	else
'		Save_GWList()
'	end if
End Function

'============================================================================
' Add_Item : 종목추가 : 20160407 종목다중선택위해 변수 추가
'============================================================================
Function Add_Item(nGbn)
	Dim szMk, szCode
	grdList.insertrow = 0
	grdList.SetCellData("bd_memo", 0, "")
	
	
	if not isNull( g_szCd ) then
		tCodeList = Split( g_szCd, "@" )
		szMk   = tCodeList[0]
		szCode = tCodeList[1]
	end if
	grdList.SetCellData("bd_code", 0, szCode)
	
	grdList.SetCellData("bd_mk", 0, szMk)
	
	szName = Form.GetItemCodeInfo(g_szCd, "name")
	grdList.SetCellData("bd_name", 0, szName)
	
	g_szCd = ""
	
	if nGbn == 0 then				' 20160407
		Check_LocalOrServer()
	end if
End Function


'============================================================================
Sub Form_OnFormInit()
	' 그리드 로우 위치 변경 위한 속성
	grdList.rowmove = "1"
	' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
	DATAMANAGER.RequestTranData("ohhts_intr_036r")
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	' 종목삭제
	if sKeyName == "DELETE" then
		if sRet == "ok" then
			Form.DelRecentHistoryIMax( testCode )
			grdList.SetDeleteRow(g_szRow)
			Check_LocalOrServer()
		end if
	' 종목 추가
	elseif sKeyName == "ADD_ITEM" then
		if sRet == "ok" then	
			Add_Item(0)
		end if
	' 20160407 : 다건종목 추가
	elseif sKeyName == "ADD_ITEMS" then
		if sRet == "ok" then
			For j = 0 to #g_tCode - 1					
				g_szCd = g_tCode[j]
				Add_Item(1)
			Next
			
			Check_LocalOrServer()		
		end if
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' 빈칸 추가
	if sKeyName == "BLANK_ADD" then
		grdList.insertrow = 0
		
		' 빈칸 색상 적용 (색상은 임시색상)
		grdList.SetCellFgColor("bd_code", 0, "6")
		grdList.SetCellFgColor("bd_name", 0, "6")
		
		grdList.SetCellData("bd_mk",   0, "")
		grdList.SetCellData("bd_code", 0, "빈칸")
		grdList.SetCellData("bd_name", 0, sRet)
		grdList.SetCellData("bd_memo", 0, sRet)
		grdList.SetCellImage("bd_mod", 0, "icon_sub_04.9.png")
		
	' 빈칸 수정
	elseif sKeyName == "BLANK_MOD" then
		grdList.SetCellData("bd_code", g_szRow, "빈칸")
		grdList.SetCellData("bd_name", g_szRow, sRet)	
		grdList.SetCellData("bd_memo", g_szRow, sRet)
	end if
	
	'Form.SetCtlProp("#edtChange", "caption", "0")
	Check_LocalOrServer()
End Sub

'============================================================================
'종목추가 
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	Dim nRow
	Dim szCode, szName
	
	nRow = 0
	szCode, szName = "", ""
	g_tCode = {}
	
	if sDlgName == "SEARCH" then
		if Trim(sReturn1) <> "" then
			g_tCode = Split(sReturn1, ":")

			nRow = grdList.rowcount
	
			if #g_tCode == 1 then
				For i = 0 to nRow - 1
					szCode = Trim(grdList.GetCellData("bd_code", i))
					szMk = Trim(grdList.GetCellData("bd_mk", i))
					
					if szMk&"@"&szCode == Trim(g_tCode[0]) then
						szName = Form.GetItemCodeInfo(sReturn1, "name")
						g_szCd = g_tCode[0]
						
						Form.MsgBox(g_szTitle, szName & "은(는) 이미 등록되어 있습니다.\r\n\n중복해서 등록하시겠습니까?", "ADD_ITEM", 1)
						Exit Sub
					end if
				Next
				
				g_szCd = g_tCode[0]
				Add_Item(0)
			elseif #g_tCode > 1 then
				For j = 0 to #g_tCode - 1
					For i = 0 to nRow - 1
						szCode = Trim(grdList.GetCellData("bd_code", i))
						szMk = Trim(grdList.GetCellData("bd_mk", i))
						if szMk&"@"&szCode == Trim(g_tCode[j]) then
							g_szCd = g_tCode[j]
							
							Form.MsgBox(g_szTitle, "선택종목들 중 이미 등록되어 있는 종목이 있습니다.\r\n\n중복해서 등록하시겠습니까?", "ADD_ITEMS", 1)
							Exit Sub
						end if
					Next					
				Next
				
				' 20160411 : 확인이 다 되었으면 리스트에 담는다.
				For k = 0 to #g_tCode - 1
					g_szCd = g_tCode[k]
					Add_Item(1)
				Next				

				Check_LocalOrServer()
			end if
		end if	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_036r" then
		DATAMANAGER.SetDataValue(0, "ohhts_intr_036r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))	' USER ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_036r", "InBlock1", "FID_KIND_CODE", 0, "1")	' 통합구분 (0:국내해외통합, 1:해외주식전용)
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_037r" then
		DATAMANAGER.ClearInputData(0, "ohhts_intr_037r")
		
		grdList.rowcount = 0	' 종목그리드 초기화
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_037r", "InBlock1", "FID_USER_ID",          0, Form.GetSharedData("&USER_ID", false))	' USER ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_037r", "InBlock1", "FID_KIND_CODE",         0, "1")	' 통합구분 (0:국내해외통합, 1:해외주식전용)
		DATAMANAGER.SetDataValue(0, "ohhts_intr_037r", "InBlock1", "FID_CNCN_ISSU_GRP_ID", 0, cmbGroup.cbkeydata)								' 관심그룹ID	
	' ----------------------------------------------------------------------
	' 관심 수정 TR :그룹추가, 종목추가, 빈칸추가
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_039r" then
		DATAMANAGER.ClearInputData(0, "ohhts_intr_039r")
		DATAMANAGER.ClearOutputData(false, "ohhts_intr_039r")
		' ////////////// 종목추가, 빈칸적용시 ////////////////
		DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock1", "FID_USER_ID",     0, Form.GetSharedData("&USER_ID", false))	' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock1", "FID_KIND_CODE",     0, "1")								' 통합구분 (0:국내해외통합, 1:해외주식전용)
		DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)						' FID버전ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock1", "FID_MOD_YN",      0, "0")									' FID수정여부				
		DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock1", "FID_ISSU_MOD_YN", 0, "0")									' FID종목수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock2", "FID_CNCN_ISSU_GRP_ID", 0, sGroupKey)						' FID관심종목그룹ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock2", "FID_CNCN_GRP_NAME",    0, sGroupName)						' FID관심그룹명	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock2", "FID_ISSU_MOD_YN",      0, "1")				


		' FID관심종목그룹ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock2", "FID_CNCN_ISSU_GRP_ID", 0, cmbGroup.cbkeydata)
		' FID관심그룹명
		DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock2", "FID_CNCN_GRP_NAME",    0, cmbGroup.caption)	
		' FID종목수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock2", "FID_ISSU_MOD_YN", 0, "1")			' 수정
		
		For j = 0 to grdList.rowcount - 1
			' FID관심종목그룹			
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_CNCN_ISSU_GRP_ID",    j, cmbGroup.cbkeydata)	
			' FID관심종목
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_CNCN_ISSU_ID2",       j, Change_Len(j))			
			' FID코드구분코드
			if Trim(grdList.GetCellData("bd_mk", j)) == "" then													
				if Trim(grdList.GetCellData("bd_name", j)) == "" then
					DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_CODE_CLS_CODE", j, "2")	' 빈칸
				else
					DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_CODE_CLS_CODE", j, "3")	' 메모
				end if
			else
				DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_CODE_CLS_CODE", j, "1")		' 종목
			end if

			' FID입력시장구분코드
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_INPUT_MRKT_CLS_CODE", j, "OV")	
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_COND_MRKT_CLS_CODE", j, grdList.GetCellData("bd_mk", j) )' FID입력시장구분코드	

			' FID관심종목코드 / FID메모내용
			if Trim(grdList.GetCellData("bd_code", j)) == "빈칸" then
				DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_OVDV_ISCD", j, "EMPTY")
				DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_MEMO_CNTT", j, grdList.GetCellData("bd_name", j))	
			else
				DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_OVDV_ISCD", j, grdList.GetCellData("bd_code", j))
			end if
		Next
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_037r" then
		Dim nCnt
		Dim szCode
		
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_intr_037r", "OutBlock1")
		
		For i = 0 to nCnt-1
			szCode = Trim(DATAMANAGER.GetDataValue(0, "ohhts_intr_037r", "OutBlock1", "FID_OVDV_ISCD", i))
			
			if szCode == "EMPTY" then
				DATAMANAGER.SetDataValue(0, "ohhts_intr_037r", "OutBlock1", "FID_OVDV_ISCD", i, "빈칸")
			end if
		Next
	end if
End Sub



'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_036r" then
		' 관심그룹을 그룹콤보에 넣기
		Insert_cmbGroup()
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_037r" then
		Dim szMk, szCode, szMemo
		
		For i = 0 to grdList.rowcount - 1
			szMk   = grdList.GetCellData("bd_mk",   i)
			szCode = grdList.GetCellData("bd_code", i)
			
			if szCode == "빈칸" then
				' 빈칸 색상 적용 (색상은 임시색상)
				szMemo = grdList.GetCellData("bd_memo", i)
				grdList.SetCellData("bd_name", i, szMemo)
				
				grdList.SetCellFgColor("bd_code", i, "6")
				grdList.SetCellFgColor("bd_name", i, "6")
				grdList.SetCellImage("bd_mod", i, "icon_sub_04.9.png")
			else
				' 종목명 가져오는 함수
				szName = Form.GetItemCodeInfo(szMk&"@"&szCode, "name")
			
				grdList.SetCellData("bd_name", i, szName)
			end if
		Next
	' ----------------------------------------------------------------------
	' 관심 수정 TR
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_039r" then
		szChange = Form.GetCtlProp("#edtChange", "caption")
		Form.SetSharedData("VRSN_ID", edtvrsnID.caption) ' 20160317 편집시 ID가 메인화면과 연동안되는부분 때문에 추가
		
		' 그룹편집(1)이 된 상태이면 그룹도 조회해야하기 때문에 그룹편집이 안된상태일때 종목편집(0)조건을 넣어준다.
		if szChange <> "1" then
			Form.SetCtlProp("#edtChange", "caption", "0")
		end if
	end if
End Sub

'============================================================================
Sub cmbGroup_OnEditComplete(iIndex)
	grdList.rowcount = 0
'	Form.SetEnvData( 1, g_tblDefine["SELECT"], iIndex & g_tblDefine["SPLIT"] & cmbGroup.caption )
	Dim sEnvKey
	sEnvKey = "INTEREST_" & Form.GetSharedData( "&USER_ID", false )
	Form.SetEnvData("1", sEnvKey, cmbGroup.cbkeydata)
	
	'마지막 인덱스 => 최근조회종목일때
	cmblastIdx = cmbGroup.rowcount -1
	
	if iIndex = cmblastIdx then
		Load_RecentList()
		tblSelect.visible = False
		tblLine.visible = False
		Exit Sub
	else
		tblSelect.visible = True
		tblLine.visible = True
	end if
	
	' 관심종목 종목 조회
	DATAMANAGER.RequestTranData("ohhts_intr_037r")
End Sub

'============================================================================
' Load_RecentList :  최근조회종목 리스트
'============================================================================
Function Load_RecentList()
	Dim nHistoryCount, szItemHistory, tItemHistory, nRowCount, nCurCount, tCode, szMk, szCode
	tCode = {}
	nHistoryCount = Form.GetRecentHistoryIMaxCount()
	
	For i = nHistoryCount-1 to 0 Step -1
		szItemHistory = Form.GetRecentHistoryIMax(i)
		if( not isNull( szItemHistory ) ) then	
			tItemHistory = Split( szItemHistory, "★" )
			if Null <> tItemHistory and #tItemHistory >= 2 then
				grdList.insertrow = CInt(grdList.rowcount)
				if tItemHistory[0] <> "" then
					tCode = Split(tItemHistory[0], "@")
					szMk = tCode[0]
					szCode  = tCode[1]
				end if
				grdList.SetCellData("bd_code", grdList.rowcount-1, szCode)
				grdList.SetCellData("bd_mk",   grdList.rowcount-1, szMk)
				grdList.SetCellData("bd_memo", grdList.rowcount-1, "")
				grdList.SetCellData("bd_name", grdList.rowcount-1, tItemHistory[1])
			end if
		end if
	Next
	'20190207 LES END

	Form.SetCtlProp("##edtListCnt", "caption", grdList.rowcount)
End Function


'============================================================================
Sub tblSelect_OnClick(lRow , lColumn)	
	if Trim(cmbGroup.cbkeydata) == "" then
			'Form.ShowAlert("관심종목추가", "새 그룹으로 등록하여 주십시오.")
			Form.ShowAlert(g_szTitle, "새 그룹으로 등록하여 주십시오.")
		Exit Sub
	end if

	if CInt(grdList.rowcount) == 100 then
		if CInt(lColumn) == 0 then
			'Form.ShowAlert("관심종목추가", "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
			Form.ShowAlert(g_szTitle, "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
		else
			'Form.ShowAlert("관심빈칸추가", "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
			Form.ShowAlert(g_szTitle, "1개의 관심그룹에는 최대 100개의 종목(빈칸)만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
		end if
		
		Exit Sub
	end if
	
	if lColumn == 0 then
		' 종목검색창 열기
		Form.OpenCommonDialog("SEARCH", "20", grdList.rowcount)		' 20160407 : 종목갯수를 플랫폼에 보낸다.
	elseif lColumn == 1 then
		Form.OpenPopup("mhprc11010_p3" , "BLANK_ADD★" , "")
	end if
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCode, szName, szMk
	Dim nRow
	
	szCode = grdList.GetCellData("bd_code", lRow)
	szName = grdList.GetCellData("bd_name", lRow)
	szMk = grdList.GetCellData("bd_mk", lRow)
	
	testCode = szMk.."@"..szCode
	if szCellID == "bd_cancel" then
'		nRow = _tonumber(grdList.rowcount)
'		
'		if nRow <= 1 then
'			Form.ShowAlert(g_szTitle, "그룹내 최소 1개 이상의 종목이 등록되어 있어야 합니다.")
'		else
			g_szRow = lRow
			Form.MsgBox(g_szTitle, "현재 관심그룹에서 선택된 종목을 삭제하겠습니까?\r\n\n["& szCode & "] " & szName , "DELETE", 1)
'		end if
	elseif szCellID == "bd_mod" then
		g_szRow = lRow
		
		' 메모선택시만 빈칸팝업 생성
		if Trim(szCode) == "빈칸" then
			Form.OpenPopup("mhprc11010_p3" , "BLANK_MOD★" & szName , "")
		end if
	end if
End Sub

Function _tonumber(szData)
	return tonumber(szData) or 0
End Function

'============================================================================
' 그리드 DragNDrop 으로Row 위치 변경 시
'============================================================================
Sub grdList_OnDropRow()
	Check_LocalOrServer()
End Sub

'============================================================================
' btnPrev_OnClick : 관심그룹보기 ◁(이전)버튼
'============================================================================
Sub btnPrev_OnClick()

	if Int(cmbGroup.currentindex) == 0 then
		cmbGroup.currentindex = cmbGroup.rowcount-1
	else
		cmbGroup.currentindex = cmbGroup.currentindex - 1
	end if
End Sub

'============================================================================
' btnNext_OnClick : 관심그룹보기 ▷(다음)버튼
'============================================================================
Sub btnNext_OnClick()
	if Int(cmbGroup.currentindex) == Int(cmbGroup.rowcount-1) then
		cmbGroup.currentindex = 0
	else
		cmbGroup.currentindex = cmbGroup.currentindex + 1
	end if

	' 콤보의 currentindex변경시 OnEditComplete 이벤트가 적용됨	
End Sub


'============================================================================
' null 체크
'============================================================================
Function isNull(str)
	if null == str or "" == str or Len(Trim(str)) <= 0 then
		return true
	end if
	
	return false
End Function

