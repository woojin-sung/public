	<SCRIPT_INFO _len="6472" _ulen="5694" >
'============================================================================
' 작성 : 2021.06.18 ksj
' 2021.08.12 : 정민영 : v0001 : 투자권유 희망여부 확인서 추가(5등급 상품개설), 상품명 변경
' 2021.10.25 : 김수진 : v0002 : 중개형ISA 추가
'============================================================================

'전역변수 설정

Dim g_OsType

Dim AgrmFlag 			'동의 플래그
Dim ChckFlag 			'투자권유여부 체크 플래그
Dim sRet				' Return 값

'G_STEP2_1_FILE 설정정보 ---------------------------------------------------
Dim g_BDM_PRCD100            '종합매매 가입여부
Dim g_BDM_PRCD118RP          'CMA(증권형) 가입여부
Dim g_BDM_PRCD100F           '종합매매(금상전용) 가입여부
Dim g_BDM_PRCD101            '선물옵션 가입여부
Dim g_BDM_PRCD135            '해외파생 가입여부
Dim g_BDM_PRCD133            'ISA 가입여부
Dim g_BDM_PRCDCFD			  'CFD 가입여부
Dim g_BDM_PRCD131			  '연금저축 가입여부
Dim g_BDM_PRCD200            '슈퍼365 가입여부
'v0002 해외 CFD / 중개형 ISA 추가
Dim	g_BDM_PRCD137		'해외 CFD
Dim	g_BDM_ISA_PROD_TYPE	'ISA 타입 (중개형ISA :3/ 일임형 ISA:2)

'============================================================================
Function User_SharedData_Get()  'v0001
'	G_STEP2_2_P4_FILE 설정정보 ---------------------------------------------------
	g_BDM_PRCD100            = Form.GetSharedData("BDM_PRCD100"            , false)  '종합매매 가입여부
	g_BDM_PRCD118RP          = Form.GetSharedData("BDM_PRCD118RP"          , false)  'CMA(증권형) 가입여부
	g_BDM_PRCD100F           = Form.GetSharedData("BDM_PRCD100F"           , false)  '종합매매(금상전용) 가입여부
	g_BDM_PRCD101            = Form.GetSharedData("BDM_PRCD101"            , false)  '선물옵션 가입여부
	g_BDM_PRCD135            = Form.GetSharedData("BDM_PRCD135"            , false)  '해외파생 가입여부
	g_BDM_PRCD133            = Form.GetSharedData("BDM_PRCD133"            , false)  'ISA 가입여부
	g_BDM_PRCDCFD            = Form.GetSharedData("BDM_PRCDCFD"            , false)  'CFD 가입여부
	'v0002 sta
	g_BDM_PRCD137			  = Form.GetSharedData("BDM_PRCD137"            , false)  '해외 CFD 가입여부
	g_BDM_ISA_PROD_TYPE	  = Form.GetSharedData("BDM_ISA_PROD_TYPE"      , false)  'ISA 타입 (중개형ISA :3/ 일임형 ISA:2)
	g_BDM_PRCD131	  		  = Form.GetSharedData("BDM_PRCD131"            , false)  '연금저축 가입여부
	g_BDM_PRCD200	  		  = Form.GetSharedData("BDM_PRCD200"            , false)  '슈퍼365 가입여부
	'v0002 fin
End Function

'============================================================================
Sub Form_OnFormInit()    
    
    User_SharedData_Get()
  
    szTheme = Form.GetEnvData("common.theme")
'    BtnNext.fgcolor = "269"
'    If szTheme == "white" Then
'        BtnNext.btnimage = "btn_21.9"
'    Else
'        BtnNext.btnimage = "btn_27.9"
'    End If
    
    if Form.GetSharedData("&OS_TYPE", false) == "1" then
		ContainerBody.setScrollBarVisible("2")
	end if
    
    AgrmFlag = 0
    ChckFlag = 0
    sRet = "hopeRecInv_fail"
    
    'JMY 개설되는 건수만큼만 표시되도록 Table 높이 강제조정
    '현재 총9Row.
    '0Row 투자권유 여부, 1Row 투자자정보제공 여부 2~8Row.개설된계좌리스트
    
    '1Row의 투자자정보제공 항목 삭제. 1Row부터 개설계좌리스트
    Dim nCnt, nTop, nRHeight, nDelHeight
    nRHeight = 342 - 38
    nTop = 324		'ContMain.TableList.Top
    nCnt = 0
	
'	g_BDM_PRCD100 = "Y"
'	g_BDM_PRCD200 = "Y"
	
	'부적합상품에 대해서만 표시 JMY
    if g_BDM_PRCD100 == "Y" then		'종합매매,
		nCnt = nCnt + 1
		ContainerBody.TableList.SetCellString( nCnt , 3, "종합매매 계좌")
	end if
	if g_BDM_PRCD200 == "Y" then		'종합매매,
		nCnt = nCnt + 1
		ContainerBody.TableList.SetCellString( nCnt , 3, "Super365 계좌")
		
		nCnt = nCnt + 1
		ContainerBody.TableList.SetCellString( nCnt , 3, "해외주식거래")
	end if
	if g_BDM_PRCD118RP == "Y" then		'CMA v0001
		nCnt = nCnt + 1
		ContainerBody.TableList.SetCellString( nCnt , 3, "CMA 계좌")
	end if
'	if g_BDM_PRCDCFD == "Y" then		'CFD
'		nCnt = nCnt + 1
'		ContainerBody.TableList.SetCellString( nCnt , 3, "CFD")
'	end if
	if g_BDM_PRCD100F == "Y" then		'종합매매(금상전용)  v0001
		nCnt = nCnt + 1
		ContainerBody.TableList.SetCellString( nCnt , 3, "종합매매-금융")
	end if
	if g_BDM_PRCD101 == "Y" then		'선물옵션
		nCnt = nCnt + 1
		ContainerBody.TableList.SetCellString( nCnt , 3, "선물옵션 계좌")
	end if
	if g_BDM_PRCD135 == "Y" then		'해외파생
		nCnt = nCnt + 1
		ContainerBody.TableList.SetCellString( nCnt , 3, "해외파생 계좌")
	end if
'	if g_BDM_PRCD133 == "Y" then		'ISA
'		nCnt = nCnt + 1
'		ContainerBody.TableList.SetCellString( nCnt , 1, "ISA")
'	end if
	'v0002 sta
	if g_BDM_PRCD133 == "Y" and g_BDM_ISA_PROD_TYPE == "3" then		'중개형ISA
		nCnt = nCnt + 1
		ContainerBody.TableList.SetCellString( nCnt , 3, "중개형ISA 계좌")
	end if
	if g_BDM_PRCD131 == "Y" then
		nCnt = nCnt + 1
		ContainerBody.TableList.SetCellString( nCnt , 3, "연금저축")
	end if
	'v0002 fin
	
	nDelHeight = 38 * CInt((7-nCnt))			'38=한Row당높이
	ContainerBody.TableList.height = nRHeight - CInt(nDelHeight)
	nTop = nTop + CInt(nRHeight - CInt(nDelHeight))
	ContainerBody.Container0.top = CInt(nTop) + 15
	ContainerBody.Image0.height = nRHeight - CInt(nDelHeight) + 60
	ContainerBody.SetScrollAutoSize()   
End Sub

'============================================================================
Sub BtnNext_OnClick()
     sRet = "ok"
	Form.CloseForm()
End Sub

'============================================================================
Sub ContainerBody_ImgClose_OnClick()
	sRet = "hopeRecInv_fail"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()  '안드로이드전용
    ContainerBody_ImgClose_OnClick()
End Sub
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("MBBDM86177" , sRet)
End Sub

'============================================================================


'============================================================================
Sub BtnReCheck_OnClick()
	sRet = "re_check"
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>