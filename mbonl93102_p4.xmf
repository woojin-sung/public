	<SCRIPT_INFO _len="6441" _ulen="6227" >

Dim g_nGrdRowCount

'============================================================================
Sub Form_OnFormInit()
	Container0.ContainerBank.GridBank.SetClear()
	
	g_nGrdRowCount = 0
	
	'연금계좌이체 기관코드 조회
	DATAMANAGER.RequestTranData("obaci_acct_224r")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'연금계좌이체 기관코드 조회
	If szTranID == "obaci_acct_224r" Then
		Dim szCurrentTab
		szCurrentTab = CStr(Container0.Tab0.currenttab)
		
		If szCurrentTab == "0" Then			'증권
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PNSN_MOVE_ISTU_CLS_CODE" , 0 , "2")
		ElseIf szCurrentTab == "1" Then		'은행
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PNSN_MOVE_ISTU_CLS_CODE" , 0 , "1")
		ElseIf szCurrentTab == "2" Then		'보험
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PNSN_MOVE_ISTU_CLS_CODE" , 0 , "6")
		End If
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PNSN_ISTU_CODE" , 0 , "%")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "RTPS_ISTU_CODE" , 0 , "%")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PNSN_KIND_CLS_CODE" , 0 , "")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FNIN_NAME" , 0 , "%")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BANK_CODE" , 0 , "%")
	End If
End Sub

'============================================================================
' 데이터 수신 
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'연금계좌이체 기관코드 조회
	If szTranID == "obaci_acct_224r" Then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1")
		If DATAMANAGER.IsMoreNextData(szTranID) Then
			DATAMANAGER.RequestNextData(szTranID)
			Exit Sub
		Else
'			Form.ShowAlert("nCnt", nCnt)
			If nCnt > 0 Then
				Dim szName1, szCode1, szName2, szCode2, szClsCode1, szClsCode2, j
				j = 0
				
				For i = 0 to nCnt - 1 Step 2
					Container0.ContainerBank.GridBank.AddRow()
					
					j = i+1
					
					szName1 = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "FNIN_NAME" , i	)
					szCode1 = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "PNSN_ISTU_CODE" , i	)
					szClsCode1 = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "PNSN_MOVE_ISTU_CLS_CODE" , i	)
					
					Container0.ContainerBank.GridBank.SetCellData("bd_Bname1" 	, g_nGrdRowCount, szName1	 ) 
					Container0.ContainerBank.GridBank.SetCellData("bd_Bcode1" 	, g_nGrdRowCount, szCode1	 ) 
					Container0.ContainerBank.GridBank.SetCellData("bd_ClsCode1" 	, g_nGrdRowCount, szClsCode1	 ) 
					
					If nCnt % 2 == 0 and j + 1 == nCnt Then '짝수개 리턴, 마지막일경우
						szName2 = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "FNIN_NAME" , j	)
						szCode2 = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "PNSN_ISTU_CODE" , j	)
						szClsCode2 = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "PNSN_MOVE_ISTU_CLS_CODE" , j	)
						
						Container0.ContainerBank.GridBank.SetCellData("bd_Bname2" 	, g_nGrdRowCount, szName2	 )
						Container0.ContainerBank.GridBank.SetCellData("bd_Bcode2" 	, g_nGrdRowCount, szCode2	 )
						Container0.ContainerBank.GridBank.SetCellData("bd_ClsCode2" 	, g_nGrdRowCount, szClsCode2	 )
						Exit Sub
					
					ElseIf nCnt % 2 == 1 and j == nCnt Then '홀수개 리턴, 마지막일경우 
						Container0.ContainerBank.GridBank.SetCellData("bd_Bname2" 	,g_nGrdRowCount, ""	 )
						Container0.ContainerBank.GridBank.SetCellData("bd_Bcode2" 	,g_nGrdRowCount, ""	 )
						Container0.ContainerBank.GridBank.SetCellData("bd_ClsCode2" 	,g_nGrdRowCount, ""	 )
						Exit Sub
					End If
					
					szName2     = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1", "FNIN_NAME"				, j)
					szCode2     = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1", "PNSN_ISTU_CODE"				, j)
					szClsCode2     = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1", "PNSN_MOVE_ISTU_CLS_CODE"				, j)
					
					Container0.ContainerBank.GridBank.SetCellData("bd_Bname2" 	, g_nGrdRowCount, szName2	 )
					Container0.ContainerBank.GridBank.SetCellData("bd_Bcode2" 	, g_nGrdRowCount, szCode2	 )
					Container0.ContainerBank.GridBank.SetCellData("bd_ClsCode2" 	, g_nGrdRowCount, szClsCode2	 )
					
					
					g_nGrdRowCount = g_nGrdRowCount +1
				Next
			End If
		End If
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'연금계좌이체 기관코드 조회
	If szTranID == "obaci_acct_224r" Then
		Form.ShowAlert("안내", "금융기관 조회 오류")
	End If
End Sub

'============================================================================
' Tab0_OnTabChanged
'============================================================================
Sub Container0_Tab0_OnTabChanged(tmp)
	Container0.ContainerBank.GridBank.SetClear()
	
	g_nGrdRowCount = 0
	
	'연금계좌이체 기관코드 조회
	DATAMANAGER.RequestTranData("obaci_acct_224r")
End Sub

'============================================================================
' imgClose_OnClick
'============================================================================
Sub Container0_imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_ContainerBank_GridBank_OnClickUp(lRow, szCellID)
	Dim szName, szCode, szClsCode
	If szCellID == "bd_Bname1" Then
		szName = Container0.ContainerBank.GridBank.GetCellData("bd_Bname1", lRow)
		szCode = Container0.ContainerBank.GridBank.GetCellData("bd_Bcode1", lRow)
		szClsCode = Container0.ContainerBank.GridBank.GetCellData("bd_ClsCode1", lRow)
	ElseIf szCellID == "bd_Bname2" Then
		szName = Container0.ContainerBank.GridBank.GetCellData("bd_Bname2", lRow)
		szCode = Container0.ContainerBank.GridBank.GetCellData("bd_Bcode2", lRow)
		szClsCode = Container0.ContainerBank.GridBank.GetCellData("bd_ClsCode2", lRow)
	End If
	
	'공백
	If Trim(szName) == "" Then
		Exit Sub
	End If
	
	Form.SendReturnToParent("mbonl93102_p4" , szName & "★" & szCode & "★" & szClsCode)
	Form.CloseForm()
End Sub





