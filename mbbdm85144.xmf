	<SCRIPT_INFO _len="3981" _ulen="3793" >
'--===========================================================================
' 작성 : 2021.02.17. 장원혁
'2121.10.25 : 김수진 : v0001 : 중개형ISA 추가
'--===========================================================================

Dim nRet 


'============================================================================
Sub Form_OnFormInit()

    
	PRCD100 = Form.GetSharedData("BDM_PRCD100", False )
	PRCD101 = Form.GetSharedData("BDM_PRCD101", False )
	PRCD135 = Form.GetSharedData("BDM_PRCD135", False )
	'v0001 sta
	PRCD133 = Form.GetSharedData("BDM_PRCD133", False )
	BDM_ISA_PROD_TYPE = Form.GetSharedData("BDM_ISA_PROD_TYPE", False )
	'v0001 fin
	
    '1.취약소비자인경우 +1등급상품 가입불가 / 2.정보미제공인경우 파생상품가입불가
    Scrn_Clcd = Form.GetOpenLinkData() 
    If Scrn_Clcd == "1" Or Scrn_Clcd == 1 Then
        ImgBg.height = 272
        Container.top = 257
        Container.height = 390
	
        Container.LblScrnA1.visible = True
        Container.LblScrnA2.visible = True
        Container.LblScrnA3.visible = True
        Container.LblScrnA4.visible = True
	
        Container.LblScrnB1.visible = False
        Container.LblScrnB2.visible = False
        Container.LblScrnB3.visible = False
        Container.LblScrnB4.visible = False
        Container.LblScrnB5.visible = False	
        Container.LblScrnB6.visible = False	
        Container.LblScrnB7.visible = False		
	
    Else
    
        If PRCD101 == "Y" And PRCD135 <> "Y" Then '선물옵션만 가입을 희망할 경우
            Container.LblScrnB2.caption = "선물옵션"
            Container.LblScrnB2.left = 50
            Container.LblScrnB5.left = 128
            Container.LblScrnB6.left = 189
            Container.LblScrnB7.left = 244		    	    
        ElseIf PRCD101 <> "Y" And PRCD135 == "Y"Then '해외파생만 가입을 희망할 경우
            Container.LblScrnB2.caption = "해외파생"	   
            Container.LblScrnB2.left = 50
            Container.LblScrnB5.left = 128
            Container.LblScrnB6.left = 189
            Container.LblScrnB7.left = 244
        ElseIf PRCD101 == "Y" And PRCD135 == "Y"Then
            Container.LblScrnB2.caption = "선물옵션, 해외파생"
            Container.LblScrnB2.left = 11
            Container.LblScrnB5.left = 173
            Container.LblScrnB6.left = 234
            Container.LblScrnB7.left = 289
	    End If
    
        ImgBg.height = 294
        Container.top = 279
        Container.height = 368
        Container.left = 0
	
        Container.LblScrnB1.visible = True	
        Container.LblScrnB2.visible = True	
        Container.LblScrnB3.visible = True	
        Container.LblScrnB4.visible = True	
        Container.LblScrnB5.visible = True	
        Container.LblScrnB6.visible = True	
        Container.LblScrnB7.visible = True	
	
        Container.LblScrnA1.visible = False
        Container.LblScrnA2.visible = False
        Container.LblScrnA3.visible = False
        Container.LblScrnA4.visible = False	
	
    End If
    
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
    BtnClose_OnClick()
End Sub

'============================================================================
Sub ImgBg_OnClick()
    BtnClose_OnClick()
End Sub

'============================================================================
Sub Container_ImgClose_OnClick()
    BtnClose_OnClick()
End Sub

'============================================================================
Sub BtnClose_OnClick()
    nRet = ""
    Form.CloseForm()
End Sub

'============================================================================
Sub BtnRe_OnClick()
    nRet = "re"
    Form.CloseForm()
End Sub


'============================================================================
Sub Form_OnFormClose()
    Form.SendReturnToParent("MBBDM85144", nRet)
End Sub

	</SCRIPT_INFO>
</ROOT>