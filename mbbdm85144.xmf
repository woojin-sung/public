				<LABEL name="LblScrnA3" fontsize="2" caption="투자성향을 재진단하시겠습니까?" halign="1" ly_vert="20,232,335,20,1" />
				<LABEL name="LblScrnA1" fontsize="4" fontstyle="01" caption="고객님은 취약금융소비자입니다." halign="1" ly_vert="20,152,335,22,1" />
