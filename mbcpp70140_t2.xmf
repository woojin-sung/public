		<LABEL name="Label0" fontsize="4" caption="예약하시겠습니까?" halign="1" ly_vert="89,274,192,32,1" />
		<LABEL name="Label1" fontsize="3" fontstyle="01" halign="1" ly_vert="2,72,366,57,1" />
