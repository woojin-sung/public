	<SCRIPT_INFO _len="3925" _ulen="3905" >
--===========================================================================
--===========================================================================
Dim g_loca, g_time
Dim s_pros, s_username, s_cust, s_plac, s_rsev, s_prtr, s_inp_rsev, s_inp_stat_code, s_rsvID, s_PID, s_UID, used_s_PID

'============================================================================
Sub Form_OnFormInitBefore()
	

	temp = Form.GetSharedData("szpfID", true )
	
	s_PID	= Form.GetSharedData("Shared_PID", false )
	
	if temp <> "" then
		s_PID = temp
		Form.SetSharedData("szpfID", "")
	end if
	
	s_rsvID = Form.GetSharedData("ck_rsvID", false )
	s_pros = Form.GetSharedData("ck_pros_code", false )
	s_username = Form.GetSharedData("ck_username", false )
	s_cust = Form.GetSharedData("ck_custtel", false )
	s_plac = Form.GetSharedData("ck_plac", false )
	s_rsev = Form.GetSharedData("ck_rsevymdh", false )
	s_prtr = Form.GetSharedData("ck_prtrcntt", false )
	s_inp_rsev = Form.GetSharedData("ck_rsevcode", false )
	s_inp_stat_code = Form.GetSharedData("ck_rsevstat", false )
	s_UID = Form.GetSharedData("ck_userID", false)
	
	

	g_loca = Form.GetSharedData("check_loca", false )
	g_time = Form.GetSharedData("check_time", false )
	
	
'	Form.ShowAlert(s_inp_stat_code, "")
'	Form.ShowAlert(s_inp_rsev, "")
'	Form.ShowAlert(s_prtr, "")
'	Form.ShowAlert(s_rsev, "")
'	Form.ShowAlert(s_plac, "")
'	Form.ShowAlert(s_cust, "")
'	Form.ShowAlert(s_username, "")
'	Form.ShowAlert(s_PID, "")
'	Form.ShowAlert(s_UID, "") 
'	Form.ShowAlert(s_rsvID, "") 
'	Form.ShowAlert(s_pros, "") 
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	Label1.caption = g_time
	Label2.caption = g_loca
	
		
		
End Sub


'============================================================================


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	Form.OpenFramePopup( "mbetc99130.xmf" , "" , "" )	
End Sub

'============================================================================


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_022a", "InBlock1" , "PROS_CLS_CODE" , 0 , s_pros )
	
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_022a", "InBlock1" , "INP_ITEM_ID" , 0 , s_rsvID )
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_022a", "InBlock1" , "CUST_ID" , 0 , s_UID ) '유저ID DB에 잘들어가나 확인
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_022a", "InBlock1" , "PRTF_ID" , 0 , s_PID )
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_022a", "InBlock1", "USER_NAME", 0 , s_username)
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_022a", "InBlock1", "CUST_TELNO", 0 , s_cust)
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_022a", "InBlock1", "PLAC_CNTT", 0 , s_plac)
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_022a", "InBlock1", "RSEV_YMDH", 0 , s_rsev)
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_022a", "InBlock1", "PRTR_MATR_DTL_CNTT", 0 , s_prtr)
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_022a", "InBlock1", "INP_RSEV_CLS_CODE", 0 , s_inp_rsev)
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_022a", "InBlock1", "INP_RSEV_STAT_CODE", 0 , s_inp_stat_code)
	
	if s_UID == "" then
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_022a", "InBlock1", "INP_MEMB_CLS_CODE", 0 , "2")
	else
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_022a", "InBlock1", "INP_MEMB_CLS_CODE", 0 , "1")
	end if
	
		
End Sub

'============================================================================
Sub Button0_OnClick()
	
		DATAMANAGER.RequestTranData("obcpp_rbit_022a")
		Form.OpenFramePopup( "mbetc99130.xmf" , "" , "" )
		Form.SendReturnToParent("RESERVATION_CLOSE","1")
		Form.CloseForm()
		
	
End Sub



'============================================================================
Sub Button1_OnClick()
	Form.CloseForm()
End Sub

