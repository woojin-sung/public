'============================================================================
' 01. 화 면 명 : 중요거래단말지정서비스_지정단말조회/해지
' 02. 화면설명 : 중요거래단말지정서비스_지정단말조회/해지 탭
' 03. 작    성 : 2016.01.18 ~ 최지희
' 2020.11.19 : 정민영 : v0001 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_oimf_638r IO 변경분 반영
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szUserId	'고객아이디
Dim g_szMacAddr	'맥주소
Dim g_szRegCount
Dim g_szRegYN
Dim g_nBtnIndex

Dim g_szProsCls	'각각의 해지 2, 전체 해지 3
Dim g_onClickFlag '다중클릭 체크 v0005
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)
	if szTranID == "obcsb_oimf_638r" then	'전자금융사기예방 고객조회'
		'v0005
		if g_onClickFlag then
		else
			Container0.ChkButton0.chksilence = "0"
			Container1.ChkButton1.chksilence = "0"
			Container2.ChkButton2.chksilence = "0"
			Container3.ChkButton3.chksilence = "0"
			Container4.ChkButton4.chksilence = "0"
	
			Container0.visible = 0
			Container1.visible = 0
			Container2.visible = 0
			Container3.visible = 0
			Container4.visible = 0
		
			'Container0.containerimage = "input_01_n.9.png"
			'Container1.containerimage = "input_01_n.9.png"
			'Container2.containerimage = "input_01_n.9.png"
			'Container3.containerimage = "input_01_n.9.png"
			'Container4.containerimage = "input_01_n.9.png"
			Container0.Image3.imgpath = "input_01_n.9.png"
			Container1.Image0.imgpath = "input_01_n.9.png"
			Container2.Image1.imgpath = "input_01_n.9.png"
			Container3.Image2.imgpath = "input_01_n.9.png"
			Container4.Image4.imgpath = "input_01_n.9.png"
		
			g_szRegCount = 0
			g_szRegYN = "N"
		end if
		'16-03-08 TR Input값 변경 MAC주소 -> DeviceID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , g_szUserId)	'사용자ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY", 0 , Form.GetDeviceID())	'단말지정구분코드
'		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "MAC_ADDR" , 0 , g_szMacAddr)	'MAC 주소
		DATAMANAGER.RequestTranData("obcsb_oimf_638r")
	end if
	
	if szTranID == "obcsb_oimf_636a" then	'이용pc단말 등록(범용)
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "PROS_CLS" , 0 , g_szProsCls)	'처리구분	1:등록 2:해지 3:전체해지
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "ELFN_ID" , 0 , Trim(g_szUserId))	'전자금융ID
		
		if g_szProsCls == "3" then	'전체해지
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "TERM_NAME" , 0 , "")
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "MAC_ADDR" , 0 , Form.GetDeviceID())	'맥주소
			
		else	'각각의 해지
						
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "TERM_NAME" , 0 , GridPro1.GetCellData( "bd_cell0", g_nBtnIndex-1 ))
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "MAC_ADDR" , 0 , GridPro1.GetCellData( "bd_cell1", g_nBtnIndex-1 ))	'맥주소
		end if
		
		if GridPro1.GetCellData( "bd_cell2", g_nBtnIndex-1 ) <> "" then	'디스크 일련번호가 있다는 것은 pc에서 등록된 것
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "DISK_SERL_NO" , 0 , GridPro1.GetCellData( "bd_cell2", g_nBtnIndex-1 ))
		else
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "UI_TERM_IDNT_KEY", 0 , Form.GetDeviceID())	'단말지정구분코드
		end if 
				
		DATAMANAGER.RequestTranData("obcsb_oimf_636a")
	end if
	
End Function

'============================================================================
' SendQuery
'============================================================================
Function SendQuery()
	Form.OpenFramePopup("mhetc90060_p8" , "mobile_cancel" , "")
	'TR_Inquiry("obcsb_oimf_638r")
End Function


'============================================================================
' SendUnReg
'============================================================================
Function SendUnReg()
	Dim szTermNm
	szTermNm = GridPro1.GetCellData( "bd_cell0", g_nBtnIndex-1 )
	
	if szTermNm == "" then			'단말기별명
		Form.ShowAlert("알림", "삭제할 등록기기가 없습니다.")
		exit function
	end if
	
	Form.OpenFramePopup("mhetc90060_p8" , "mobile_cancel" , "")
	
End Function

'============================================================================
' CheckCert
'============================================================================
Function CheckCert()
	
	if g_nBtnIndex == 100 Or g_szRegCount == 1 then	'100은 전체해지 1은 최후 1개 단말 해지

		'추가인증 화면을 열고 정상 처리가 되었을 경우 쿼리 진행
'		TR_Inquiry("obcsb_oimf_636a")
		Call SendQuery()		
	else
		Call SendUnReg()
	end if
End Function

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
Sub btnInform_OnClick()--유의사항
	Form.OpenPopup("mbonl86010_p1" , "지정단말조회해지" , "")

End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'msgbox "sEventName="&sEventName&" sParam="&sParam	
	g_szProsCls = ""
	if sEventName == "cancel" then			
		btnSearch_OnClick()
	elseif sEventName == "63010" then
		btnCancel.top = "518" '"467"
	ElseIf sEventName == "63010_p0" then 'JWH
	     btnCancel.top = "518" '"467" JWH
	end if	
End Sub

'============================================================================
' btnSearch_OnClick  - 조회
'============================================================================
Sub btnSearch_OnClick()

	Container0.visible = 0
	Container1.visible = 0
	Container2.visible = 0
	Container3.visible = 0
	Container4.visible = 0
	
	g_szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID
	g_szMacAddr = Trim(Form.GetSharedData("&MAC_ADDRESS", false ))	'MAC 주소
	g_szRegCount = 0
	g_szRegYN = "N"
	g_nBtnIndex = -1
	
	TR_Inquiry("obcsb_oimf_638r")
End Sub

'============================================================================
' btnCancel_OnClick - 해지
'============================================================================
Sub btnCancel_OnClick()
	g_onClickFlag = True
	TR_Inquiry("obcsb_oimf_638r")
End Sub




'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_638r" then	'전자금융사기예방 고객조회
		'v0005
		if g_onClickFlag then
			g_onClickFlag = False
			Dim c0,c1,c2,c3,c4
			
			c0 = Container0.ChkButton0.checkstate
			c1 = Container1.ChkButton1.checkstate
			c2 = Container2.ChkButton2.checkstate
			c3 = Container3.ChkButton3.checkstate
			c4 = Container4.ChkButton4.checkstate
			
			if g_szRegCount == 0 then
				Form.MsgBox("알림", "삭제할 등록기기가 없습니다.", "", 0)
				exit sub
			else
				if g_szRegCount == 1 and c0 == "0" then
					Form.MsgBox("알림", "삭제할 등록기기가 없습니다.", "", 0)
					exit sub
				elseif g_szRegCount == 2 and c0 == "0" and c1 == "0" then
					Form.MsgBox("알림", "삭제할 등록기기가 없습니다.", "", 0)
					exit sub
				elseif g_szRegCount == 3 and c0 == "0" and c1 == "0" and c2 == "0" then
					Form.MsgBox("알림", "삭제할 등록기기가 없습니다.", "", 0)
					exit sub
				elseif g_szRegCount == 4 and c0 == "0" and c1 == "0" and c2 == "0" and c3 == "0" then
					Form.MsgBox("알림", "삭제할 등록기기가 없습니다.", "", 0)
					exit sub
				elseif g_szRegCount == 5 and c0 == "0" and c1 == "0" and c2 == "0" and c3 == "0" and c4 == "0" then
					Form.MsgBox("알림", "삭제할 등록기기가 없습니다.", "", 0)
					exit sub
				end if
			end if
		
		
			if ChkAll.checkstate == "1" then
				g_nBtnIndex = 100
				Form.OpenPopupAnimation("mbonl86011_p3" , "" , "","2")
			else
				if Container0.ChkButton0.checkstate == "1" then
					g_nBtnIndex = 1
				elseif Container1.ChkButton1.checkstate == "1" then
					g_nBtnIndex = 2
				elseif Container2.ChkButton2.checkstate == "1" then
					g_nBtnIndex = 3
				elseif Container3.ChkButton3.checkstate == "1" then
					g_nBtnIndex = 4
				elseif Container4.ChkButton4.checkstate == "1" then
					g_nBtnIndex = 5
				end if
				
				Call CheckCert()
			end if
		else
			g_szRegYN = DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "REG_YN" , 0)	'등록여부
			g_szRegCount = DATAMANAGER.GetDataCount(0,"obcsb_oimf_638r", "OutBlock2" )
			
			if g_szRegCount == 0 then
				Label1.visible = 1
				lblAll.visible = 0
				ChkAll.visible = 0
				Label0.visible = 0
			else
				Label1.visible = 0
				lblAll.visible = 1
				ChkAll.visible = 1
				Label0.visible = 1
			end if
			
			for i=0 to g_szRegCount-1
				Dim szDate,szPhoneName, szStatus, szMac
				szDate = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock2", "REG_DATE" , i))
				szPhoneName = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock2", "TERM_NAME" , i))
				szStatus = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock2", "STAT_CLS_CODE" , i))
				szMac = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock2", "MAC_ADDR" , i))
				
				if szStatus == "1" then
					szStatus = "접속중"
					if i < 5 then
						if i == 0 then
							'Container0.containerimage = "input_01_o.9.png"
							Container0.Image3.imgpath = "input_01_o.9.png"
						elseif i == 1 then 
							'Container1.containerimage = "input_01_o.9.png"
							Container1.Image0.imgpath = "input_01_o.9.png"
						elseif i == 2 then 
							'Container2.containerimage = "input_01_o.9.png"
							Container2.Image1.imgpath = "input_01_o.9.png"
						elseif i == 3 then 
							'Container3.containerimage = "input_01_o.9.png"
							Container3.Image2.imgpath = "input_01_o.9.png"
						elseif i == 4 then 
							'Container4.containerimage = "input_01_o.9.png"
							Container4.Image4.imgpath = "input_01_o.9.png"
						end if
					end if
				else
					szStatus = "등록기기"
				end if
				
				if i < 5 then
					if i == 0 then
						Container0.visible = 1
						Container0.lblDate0.caption = szDate
						Container0.lblState0.caption = szStatus
						Container0.lblName0.caption = szPhoneName
						Container0.lblMac0.caption = szMac
						
						if szStatus == "접속중" then
							Container0.lblState0.fgcolor = "6" '"0:255000000"
						else
							Container0.lblState0.fgcolor = "146" '"0:000000000"
						end if
					elseif i == 1 then 
						Container1.visible = 1
						Container1.lblDate1.caption = szDate
						Container1.lblState1.caption = szStatus
						Container1.lblName1.caption = szPhoneName
						Container1.lblMac1.caption = szMac
						if szStatus == "접속중" then
							Container1.lblState1.fgcolor = "6" '"0:255000000"
						else
							Container1.lblState1.fgcolor = "146" '"0:000000000"
						end if
					elseif i == 2 then 
						Container2.visible = 1
						Container2.lblDate2.caption = szDate
						Container2.lblState2.caption = szStatus
						Container2.lblName2.caption = szPhoneName
						Container2.lblMac2.caption = szMac
						if szStatus == "접속중" then
							Container2.lblState2.fgcolor = "6" '"0:255000000"
						else
							Container2.lblState2.fgcolor = "146" '"0:000000000"
						end if
					elseif i == 3 then 
						Container3.visible = 1
						Container3.lblDate3.caption = szDate
						Container3.lblState3.caption = szStatus
						Container3.lblName3.caption = szPhoneName
						Container3.lblMac3.caption = szMac
						if szStatus == "접속중" then
							Container3.lblState3.fgcolor = "6" '"0:255000000"
						else
							Container3.lblState3.fgcolor = "146" '"0:000000000"
						end if
					elseif i == 4 then 
						Container4.visible = 1
						Container4.lblDate4.caption = szDate
						Container4.lblState4.caption = szStatus
						Container4.lblName4.caption = szPhoneName
						Container4.lblMac4.caption = szMac
						if szStatus == "접속중" then
							Container4.lblState4.fgcolor = "6" '"0:255000000"
						else
							Container4.lblState4.fgcolor = "146" '"0:000000000"
						end if
					end if
				end if
					
			next 
			
			btnCancel.enable = 0
		end if
	end if
	
	if szTranID == "obcsb_oimf_636a" then
		
		if g_nBtnIndex <> 100 then'전체가 아니면
			if g_nBtnIndex == 1 then
				if Container1.ChkButton1.checkstate == "1" then
					g_nBtnIndex = 2
					'DATAMANAGER.RequestTranData( "obcsb_oimf_636a" )
					TR_Inquiry("obcsb_oimf_636a")
					exit sub
				end if
				
				if Container2.ChkButton2.checkstate == "1" then
					g_nBtnIndex = 3
					'DATAMANAGER.RequestTranData( "obcsb_oimf_636a" )
					TR_Inquiry("obcsb_oimf_636a")
					exit sub
				end if
				
				if Container3.ChkButton3.checkstate == "1" then
					g_nBtnIndex = 4
					'DATAMANAGER.RequestTranData( "obcsb_oimf_636a" )
					TR_Inquiry("obcsb_oimf_636a")
					exit sub
				end if
				
				if Container4.ChkButton4.checkstate == "1" then
					g_nBtnIndex = 5
					'DATAMANAGER.RequestTranData( "obcsb_oimf_636a" )
					TR_Inquiry("obcsb_oimf_636a")
					exit sub
				end if
				
			elseif g_nBtnIndex == 2 then
				if Container2.ChkButton2.checkstate == "1" then
					g_nBtnIndex = 3
					'DATAMANAGER.RequestTranData( "obcsb_oimf_636a" )
					TR_Inquiry("obcsb_oimf_636a")
					exit sub
				end if
				
				if Container3.ChkButton3.checkstate == "1" then
					g_nBtnIndex = 4
					'DATAMANAGER.RequestTranData( "obcsb_oimf_636a" )
					TR_Inquiry("obcsb_oimf_636a")
					exit sub
				end if
				
				if Container4.ChkButton4.checkstate == "1" then
					g_nBtnIndex = 5
					'DATAMANAGER.RequestTranData( "obcsb_oimf_636a" )
					TR_Inquiry("obcsb_oimf_636a")
					exit sub
				end if
			elseif g_nBtnIndex == 3 then
				if Container3.ChkButton3.checkstate == "1" then
					g_nBtnIndex = 4
					'DATAMANAGER.RequestTranData( "obcsb_oimf_636a" )
					TR_Inquiry("obcsb_oimf_636a")
					exit sub
				end if
				
				if Container4.ChkButton4.checkstate == "1" then
					g_nBtnIndex = 5
					'DATAMANAGER.RequestTranData( "obcsb_oimf_636a" )
					TR_Inquiry("obcsb_oimf_636a")
					exit sub
				end if
			elseif g_nBtnIndex == 4 then
				if Container4.ChkButton4.checkstate == "1" then
					g_nBtnIndex = 5
					'DATAMANAGER.RequestTranData( "obcsb_oimf_636a" )
					TR_Inquiry("obcsb_oimf_636a")
					exit sub
				end if
			end if
		end if
		
		if g_szProsCls == "2" then'일부
			'Form.ShowAlert( "알림", "이용기기 지정이 해지되었습니다.")
			Form.MsgBox("알림", "이용기기 지정이 해지되었습니다.", "DEL_OK", "8", "확인")
		elseif g_szProsCls == "3" then'전체
			'Form.ShowAlert( "알림", "이용기기 지정 및 약정이\n모두 해지되었습니다.")
			Form.MsgBox("알림", "이용기기 지정 및 약정이\n모두 해지되었습니다.", "DEL_ALL_OK", "8", "확인")
		end if
		
		btnSearch_OnClick()
	end if
End Sub



'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p8" then	'추가인증
		if sRet == "ok" then	'추가인증 성공
			szScrcOtpClsCode = DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0)
			if DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SPLM_ATHN_STPL_YN" , 0) == "Y" then	'추가인증약정여부
				if szScrcOtpClsCode == "0" then	'보안카드
					Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
				elseif szScrcOtpClsCode == "1" then	'부가정보
					Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
				elseif szScrcOtpClsCode == "2" then	'보안매체없음
					'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 이용단말등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
					RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
				elseif szScrcOtpClsCode == "3" then	'OTP
					Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
				elseif szScrcOtpClsCode == "4" then	'mOTP
					Form.OpenPopup( "mhetc90060_motp" , "motp_success" , sPosInfo)		'공인인증서_일반/스마트OTP
				else			'오류
					Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
				end if
			else '추가인증하지 않아도 됨
				Call TR_Inquiry("obcsb_oimf_636a")
			end if			
		end if
	end if
	
	if sKeyName == "mhetc90060_p9" then	'보안카드(보안매체1)
		if sRet == "ok" then			'성공
			'Call TR_Inquiry("obcsb_oimf_636a")
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")			
		else 					'실패
			exit sub
		end if	
	end if
	
	
	if sKeyName == "mhetc90060_pa" then	'부가정보인증
		if sRet == "ok" then			'성공
			'Call TR_Inquiry("obcsb_oimf_636a")
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else 					'실패
			exit sub
		end if
	end if
	
	
	if sKeyName == "mhetc90060_pb" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
			'Call TR_Inquiry("obcsb_oimf_636a")
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else						'실패		
			exit sub
		end if	
	end if
	
	If sKeyName == "mhetc90060_motp" Then
		If sRet == "ok" Then
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		Else
			exit sub
		End If
	End If
	
	if sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			Call TR_Inquiry("obcsb_oimf_636a")
		else						'실패
			exit sub
		end if
		
	end if
	
	if sKeyName == "OK" then	'확인 팝업
		Call CheckCert()
	end if
	
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
'	if sKeyName == "mhetc90190_p1" then										
'		'if sRet == "ok" then									
'		'end if
'	end if 	
End Sub

'============================================================================
Sub Container0_ChkButton0_OnChange(sCheckState)
	f_AllCheck()
End Sub

'============================================================================
Sub Container1_ChkButton1_OnChange(sCheckState)
	f_AllCheck()
End Sub

'============================================================================
Sub Container2_ChkButton2_OnChange(sCheckState)
	f_AllCheck()
End Sub

'============================================================================
Sub Container3_ChkButton3_OnChange(sCheckState)
	f_AllCheck()
End Sub

'============================================================================
Sub Container4_ChkButton4_OnChange(sCheckState)
	f_AllCheck()
End Sub

Sub f_AllCheck()
	Dim c0,c1,c2,c3,c4
	
	c0 = Container0.ChkButton0.checkstate
	c1 = Container1.ChkButton1.checkstate
	c2 = Container2.ChkButton2.checkstate
	c3 = Container3.ChkButton3.checkstate
	c4 = Container4.ChkButton4.checkstate
	
	if c0 == "1" or c1 == "1" or c2 == "1" or c3 == "1" or c4 == "1" then
		btnCancel.enable = 1
	else
		btnCancel.enable = 0
	end if

	if g_szRegCount > 0 then					'0
		if c0 == "0" then
			ChkAll.chksilence = "0"
			g_szProsCls = "2"
			exit sub
		end if
		
		if g_szRegCount > 1 then				'1
			if c1 == "0" then
				ChkAll.chksilence = "0"
				g_szProsCls = "2"
				exit sub
			end if
			
			if g_szRegCount > 2 then			'2
				if c2 == "0" then
					ChkAll.chksilence = "0"
					g_szProsCls = "2"
					exit sub
				end if
				
				if g_szRegCount > 3 then		'3
					if c3 == "0" then
						ChkAll.chksilence = "0"
						g_szProsCls = "2"
						exit sub
					end if
					
					if g_szRegCount > 4 then	'4
						if c4 == "0" then
							ChkAll.chksilence = "0"
							g_szProsCls = "2"
							exit sub
						end if
					end if
				end if
			end if
		end if
	end if
	
	ChkAll.chksilence = "1"
	g_szProsCls = "3"
	
	
End Sub

'============================================================================
Sub lblAll_OnClick()
	if ChkAll.checkstate == "0" then
		ChkAll.checkstate = "1"
		btnCancel.enable = 1
		ChkAll_OnChange("1")
	else
		ChkAll.checkstate = "0"
		btnCancel.enable = 0
		ChkAll_OnChange("0")
	end if
End Sub

'============================================================================
Sub ChkAll_OnChange(sCheckState)

	if g_szRegCount > 0 then
		Container0.ChkButton0.chksilence = sCheckState
		if g_szRegCount > 1 then
			Container1.ChkButton1.chksilence = sCheckState
			
			if g_szRegCount > 2 then
				Container2.ChkButton2.chksilence = sCheckState
				
				if g_szRegCount > 3 then
					Container3.ChkButton3.chksilence = sCheckState
					
					if g_szRegCount > 4 then
						Container4.ChkButton4.chksilence = sCheckState
					end if
				end if
			end if
		end if
	end if
	
	if sCheckState == "0" then
		g_szProsCls = "2"'각각의 해지 2, 전체 해지 3
	else
		g_szProsCls = "3"'각각의 해지 2, 전체 해지 3
	end if
	
End Sub

