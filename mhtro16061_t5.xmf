						<CELL cell_ly="0,43,0,43" impidxs="" />
						<CELL cell_ly="1,43,1,43" fgcolor="095:000000000" halign="0" caption="PTP로 지정된 종목이라도 QN(Qualified Notice)" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,44,0,44" impidxs="" />
						<CELL cell_ly="1,44,1,44" halign="0" caption="여부에 따라 과세가 면제될 수 있습니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,45,0,45" impidxs="" />
						<CELL cell_ly="1,45,1,45" halign="0" caption="* QN(Qualified Notice): 총 수익이 10% 이내" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,46,0,46" impidxs="" />
						<CELL cell_ly="1,46,1,46" halign="0" caption="  라는 사실을 증명" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,47,0,47" impidxs="" />
						<CELL cell_ly="1,47,1,47" halign="0" caption="* QN 지정은 92일 동안 유효하며 지정 기간" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,48,0,48" impidxs="" />
