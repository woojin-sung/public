						<CELL cell_ly="0,37,0,37" impidxs="" />
						<CELL cell_ly="1,37,1,37" impidxs="" />
						<CELL cell_ly="0,38,1,38" fgcolor="061:188030030" halign="0" caption="※ (주의)PTP(Publicly Traded Partnership)로 지정된" fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,39,0,39" impidxs="" />
						<CELL cell_ly="1,39,1,39" fgcolor="061:188030030" halign="0" caption="종목은 美 국세청 Section 1446(f)조항에 근거하여" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,40,0,40" impidxs="" />
						<CELL cell_ly="1,40,1,40" fgcolor="061:188030030" halign="0" caption="매도일 기준 2023년 1월 1일부터 매도 금액의 10%가" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,41,0,41" impidxs="" />
						<CELL cell_ly="1,41,1,41" fgcolor="061:188030030" halign="0" caption="세금으로 발생합니다. 매매에 유의바랍니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,42,0,42" impidxs="" />
