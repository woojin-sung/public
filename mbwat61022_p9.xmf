'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : WRAP 가입 투자일임보고서 선택
' 02. 화면설명 : 
' 03. 이    력 : 2024.01.23 : 고승연 : v0002 : 이메일/주소항목 전달 추가
'-------------------------------------------------------------------------------------------
dim g_szContent
dim g_szData

Sub Form_OnFormInit()
	szOpenData = Form.GetOpenLinkData()
	
	if szOpenData <> null and szOpenData <> "" then
		Dim tData, sAcnt, sPwd
		tData = Split(szOpenData, "|")
		
		sAcnt = tData(0)
		sPwd = Mid(szOpenData, Len(sAcnt) + 2, Len(szOpenData) - (Len(sAcnt) + 1))
		
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "ACNO" , 0 , sAcnt )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "PWD" , 0 , sPwd )
		
		DATAMANAGER.RequestTranData( "obcsb_acad_002r" )
	end if
	
	g_szContent = {"이메일", "직장", "자택"}
	g_szContValue = {"21", "02", "01"}
	
	lblChangeInfo.caption = "변경하기  >"
	Grid0.rowcount = CInt(UBound(g_szContent)) + 1
	for i=0 to UBound(g_szContent)
	
		Grid0.SetCellData("bd_Text", i, g_szContent(i))
		Grid0.SetCellData("bd_Value", i, g_szContValue(i))
	next
End Sub


'수령처 선택시 데이터 전달
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	' 구분명 | 구분값 | 주소데이터
	g_szData = Grid0.GetCellData("bd_Text", lRow).."|"..Grid0.GetCellData("bd_Value", lRow).."|"..Grid0.GetCellData("bd_Data", lRow)
	Form.CloseForm("")
End Sub

'============================================================================
Sub btnBGUP_OnClick()
	g_szData = ""
	Form.CloseForm("")
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("POPUP_REPORT" , g_szData)
End Sub

'============================================================================
Sub lblChangeInfo_OnClick()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
	Form.OpenFramePopup( "mbonl81000" , "" , "")
	lblChangeInfo.visible = false
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "mbonl81000" then
		Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
		
		lblChangeInfo.visible = true
		Grid0.SetCellData("bd_Data", 0, "")
		Grid0.SetCellData("bd_Data", 1, "")
		Grid0.SetCellData("bd_Data", 2, "")
		
		DATAMANAGER.RequestTranData( "obcsb_acad_002r" )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acad_002r" then
		Dim nCount
		nCount = DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock1" )
		
		if nCount > 0 then
			for i = 0 to nCount-1
				Dim sINAG_TYPE_CODE
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_TYPE_CODE" , i )
				
				if sINAG_TYPE_CODE == "21" then 'E-mail
					Dim sEmail
					sEmail = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "EMAIL_ADDR" , i )
					Grid0.SetCellData("bd_Data", 0, sEmail)
					
				elseif sINAG_TYPE_CODE == "02" then '자택
					Dim POST, DTAD
					POST = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "POST" , i )
					DTAD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "DTAD" , i )
					Grid0.SetCellData("bd_Data", 1, POST.." "..DTAD)
					
				elseif sINAG_TYPE_CODE == "01" then '직장
					Dim POST, DTAD
					POST = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "POST" , i )
					DTAD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "DTAD" , i )
					Grid0.SetCellData("bd_Data", 2, POST.." "..DTAD)
					
				end if
			next
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_acad_002r" then
		DATAMANAGER.ClearOutputData( 0, "obcsb_acad_002r" )
	end if
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	Form.CloseForm()
End Sub

