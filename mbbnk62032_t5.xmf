	<MAP_INFO scrno="62032" scrname="다른 금융기관 계좌관리_계좌등록해지" version="2" writer="아이티젠 관리자" />
	<FORM_INFO name="Form" ly_vert="0,0,375,526,1" />
	<CONTROL_INFO>
		<LABEL name="Label1" fontstyle="01" caption="계좌별명" ly_vert="13,35,72,32,1" />
		<EDIT name="edtDrngAcntAls" enable="0" imetype="0" maxlength="0" ly_vert="110,30,184,39,1" />
		<LABEL name="Label2" fgcolor="146:124124124" fontsize="-3" caption="* 계좌등록 해지 시 해당 계좌의 조회 및 거래가 불가합니다." ly_vert="12,100,354,23,1" />
		<BUTTON name="btnClose" caption="해지" btnimage="btn_01.9" ly_vert="118,386,150,44,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="3460" _ulen="3204" >
'===========================================================================
' 화 면 명: 다른 금융기관 거래내역 조회_계좌등록해지
' 화면설명: 
' 작    성: 2020.10.12. 송기영
' 수    정: 2021.01.13. 장원혁 v001 해지처리 시 계좌콤보에서 계좌 삭제
'===========================================================================
'***************************************************************************
'     G L O B A L   V A R I A B L E
'***************************************************************************
Dim g_szID         '사용자 아이디

Dim DrngAcntAls
Dim BankCode
Dim BankAcno
Dim OpnTimsNo

'===========================================================================
' Form_OnFormInit()
'===========================================================================
Sub Form_OnFormInit()
	
	g_szID = Form.GetSharedData("&USER_ID", false )
	
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim DrngAgrmYn
	
	if szTranID == "obtss_opnf_005a" then
		
		Form.MsgBox("알림", "계좌가 해지되었습니다", "", 0)	
		Form.triggerEvent("#", "mbbnk62032_t5", "") 'v001
		
	end if	
End Sub

'============================================================================
Sub Form_OnRefresh()
'	DATAMANAGER.RequestTranData("ohhts_1703_002r")
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError (szTranID , szErrCode , szErrMsg)
	Dim SubMsg
	
	SubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if SubMsg = "" then
		Form.MsgBox("알림", szErrMsg, 0)	
	else
		Form.MsgBox("알림", szErrMsg & "(" & SubMsg & ")", 0)
	end if
End Sub


'============================================================================
' Form_OnTriggerEvent(sEventName, sParam) : 트리거에서 입력받은 계좌번호를 사용하여 입력 세팅
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	Dim szList
		
	if sEventName == "mbbnk62032_t5" then
		g_szData = sParam
		szList = Split(sParam, "★")
		
		DrngAcntAls 	= szList(0)
		BankCode 	= szList(1)
		BankAcno 	= szList(2)
		OpnTimsNo	= szList(3)
		
		edtDrngAcntAls.caption = DrngAcntAls
		
	end if
End Sub


'============================================================================
Sub btnClose_OnClick()

	Form.MsgBox("알림", "등록된 계좌를 해지하시겠습니까?", "CLOSE", 2)
	
End Sub


'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)	
	if sKeyName == "CLOSE" then
		if sRet == "ok" then	'삭제 후 재조회			
			
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_005a", "InBlock1", "PROS_CLS_CODE" , 0 ,  "1" ) '1:계좌해지시  2:출금동의 해지
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_005a", "InBlock1", "ELFN_ID", 0 , g_szID)
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_005a", "InBlock1", "BANK_CODE", 0 , BankCode)
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_005a", "InBlock1", "BANK_ACNO", 0 , BankAcno)
			DATAMANAGER.SetDataValue( 0, "obtss_opnf_005a", "InBlock1", "OPN_TIMS_NO", 0 , OpnTimsNo)
			
			DATAMANAGER.RequestTranData("obtss_opnf_005a")
			
		end if
	end if
End Sub






