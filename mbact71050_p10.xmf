	<SCRIPT_INFO _len="7880" _ulen="7660" >
'v001 20220524 아이티젠 김성수 : 소수점 표기기능 추가(그리드 잔고수량 셀 마스킹 숫자>문자 변경)
'============================================================================
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nAcntCount	'계좌 개수	
Dim g_nAllCount	'전체조회시 계좌 Index
Dim g_szList
Dim g_nGrdRowCnt
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	grd0.SetClear()
	
	if sEventName == "mbact71050_p10" then			'주식/채권
	
		g_szList = Split(sParam,"○")
		
	end if
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	g_nAcntCount = g_szList(0)		'계좌개수
	
	g_nAllCount = 4 + g_nAcntCount	'마지막 계좌 
	
	g_nNextCount = 0
		
	if g_szList(1) == "Y" then
		grd0.rowcount = 0
		AllSearch()
	else
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "ACNO" , 0 , g_szList(3) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "WRAP_ACNT_YN" , 0 , "Y")
	'	DATAMANAGER.SetDataValue( 0 , "obacb_balc_029r", "InBlock1", "ACNT_PWD" , 0 , g_szList(1) )	'비밀번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "UI_UNIT_CLS" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "IQRY_CLS_CODE" , 0 , "" )	
		
		DATAMANAGER.RequestTranData( "obacb_balc_137r" )
	end if	
End Sub
'============================================================================
Function AllSearch()
	g_nAllCount = g_nAllCount - 1
	
	if g_nAllCount > 2 then
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "ACNO" , 0 , g_szList(Int(g_nAllCount)) ) '계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "UI_UNIT_CLS" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "WRAP_ACNT_YN" , 0 , "Y")

		DATAMANAGER.SetDataValue( 0 , "obacb_balc_137r", "InBlock1", "IQRY_CLS_CODE" , 0 , "" )	'
		
		DATAMANAGER.RequestTranData( "obacb_balc_137r" )

	end if

	
End Function
'============================================================================
Sub grd0_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("obacb_balc_137r") = true then
		DATAMANAGER.RequestNextData( "obacb_balc_137r" )
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	grd0.SetClear()
	g_nNextCount = 0
	Form.ShowAlert("", szErrMsg)
End Sub
'============================================================================
Sub Form_OnFormInit()
	g_nAllCount = 0
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp11, 
	    szTemp12, szTemp13, szTemp14, szTemp15, szTemp16, nTemp17, szTempcode, szTempcdnm, szTempacnt, szTempacno, szTempasno, szTempname, TempCount
	    
	if szTranID = "obacb_balc_137r" then
		for i = 0 to DATAMANAGER.GetDataCount(0, "obacb_balc_137r" , "OutBlock1") - 1
			grd0.AddRow()
			
			szTemp1  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "ACNO" , i)
			szTemp2  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "ISCD" , i)
			szTemp3  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "ISNM" , i)
			szTemp4  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "RMND_QTY" , i)
			szTemp5  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "BYNG_AMT" , i)
			szTemp6  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "VLTN_AMT" , i)
			szTemp7  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "VLTN_PRLS_AMT" , i)
			szTemp8  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "ERT" , i)
			szTemp9  = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , i)
			szTemp10 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "CRCD" , i)
			szTemp11 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "ACNT_PRNM" , i)
			szTemp12 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "MKSC_CLS_NAME" , i)
			szTemp13 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "LOAN_DATE" , i)
			szTemp14 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "MTRT_DATE" , i)
			szTemp15 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "LOAN_SRNO" , i)
			szTemp16 = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "RMND_DQTY" , i)
			nTemp17  = CDbl(szTemp4) + CDbl(szTemp16) 'v001
			TempCount = Len(szTemp11)
			
			szTempcode = szTemp9
			szTempacno = szTemp1
			szTempasno = DATAMANAGER.GetDataValue(0, "obacb_balc_137r", "OutBlock1", "ASNO" , i)
			szTempname = Mid(szTemp11,3,TempCount-2)
			
			szTempacnt = Left(szTempacno, 4) & "-" & Right(szTempacno, 4) & "-" & szTempasno
			
			if szTempcode = "01" then
				szTempcdnm = "미국"
			elseif szTempcode = "02" then
				szTempcdnm = "홍콩"
			elseif szTempcode = "03" then
				szTempcdnm = "상해"
			elseif szTempcode = "04" then
				szTempcdnm = "심천"
			end if
			
			grd0.SetCellData("bd_cell0" , g_nNextCount, szTempacnt)
			grd0.SetCellData("bd_cell1" , g_nNextCount, szTemp2)
			grd0.SetCellData("bd_cell2" , g_nNextCount, szTemp3)
'			grd0.SetCellData("bd_cell3" , g_nNextCount, szTemp4) 'v001
			grd0.SetCellData("bd_cell4" , g_nNextCount, szTemp5)
			grd0.SetCellData("bd_cell5" , g_nNextCount, szTemp6)
			grd0.SetCellData("bd_cell6" , g_nNextCount, szTemp7)
			grd0.SetCellData("bd_cell7" , g_nNextCount, szTemp8)
			grd0.SetCellData("bd_cell8" , g_nNextCount, szTempcdnm)
			grd0.SetCellData("bd_cell9" , g_nNextCount, szTemp10)
			grd0.SetCellData("bd_cell10", g_nNextCount, szTemp11)
