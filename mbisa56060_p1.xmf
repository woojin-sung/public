'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sSendData		'마지막 팝업화면으로 각 페이지의 입력 데이터 전달
Dim g_szList			'g_sSendData Split Array

'[Page1]
'g_szList(0)   : 계좌번호
'g_szList(1)   : 계좌일련번호
'g_szList(2)   : 비밀번호
'g_szList(3)   : 고객번호
'g_szList(4)   : 가입자유형 코드
'g_szList(5)   : 가입자유형 한글명
'g_szList(6)   : 연령
'g_szList(7)   : 동영상시청 날짜
'g_szList(8)   : 동영상시청 시각
'g_szList(9)   : 소득증명발급번호
'g_szList(10)  : 소득확인증명서번호
'g_szList(11)  : 자택주소
'g_szList(12)  : 회사주소
'g_szList(13)  : 연락처
'g_szList(14)  : 이메일주소
'g_szList(15)  : 서류제출방법 코드
'g_szList(16)  : 서류제출방법 한글명
'g_szList(17)  : 최소가입금액
'g_szList(18)  : buffer
'g_szList(19)  : buffer


Dim g_sClickTime0		'ISA계약권유문서 클릭 시각
Dim g_sClickTime1		'개인종합자산관리계좌(일임형)약관 클릭 시각
Dim g_sClickTime2		'MP설명서 클릭 시각

Dim g_sAmt			'은행연합회 한도

Dim g_nMPIdx			'상품(MP) 선택 라디오 인덱스
g_nMPIdx = -1
'0 : 메리츠 ISA 이자소득형A
'1 : 메리츠 ISA 안정지향형A
'2 : 메리츠 ISA 안정지향형B
'3 : 메리츠 ISA 중립형A
'4 : 메리츠 ISA 중립형B			
'5 : 메리츠 ISA 성장지향형A
'6 : 메리츠 ISA 성장지향형B
'7 : 메리츠 ISA 고수익지향형A
'8 : 메리츠 ISA 고수익지향형B

Dim g_bMPSelect		'MP선택 가능 여부(투자성향진단 완료시 True)
g_bMPSelect = False

Dim g_sInvestSendData

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'sGubn = "1" : 투자성향진단 변경시 상품선택/ISA계약필수문서 확인 초기화
'sGubn = "2" : 상품선택 변경시 ISA계약필수문서 확인 초기화
Sub ClearNextStep(sGubn)
	If sGubn == "1" then
		tbl1.SetCellString( 0, 0, "" )
		lblMPCode.caption = ""
	End If
	
	chk1.checkstate = "0"
	chk2.checkstate = "0"
	chk3.checkstate = "0"
End Sub

'============================================================================
'MP설명서 오픈
Sub OpenMPManual(sUrl)
	Dim nType
	nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	if nType == "0" then
		Form.OpenPdfViewer( "http://home.imeritz.com/include/resource/isa/" & sUrl & ".pdf", "")	'운영계 주소
	elseif nType == "1" then
		Form.OpenPdfViewer( "http://211.255.202.106/include/resource/isa/" & sUrl & ".pdf", "")	'테스트계주소
	end if	
End Sub

'============================================================================
Function ValidateCheck()
	If tbl0.GetCellString( 0 , 0 ) == "" then
		Form.ShowAlert("알림", "ISA 투자성향진단을 등록해주세요.")
		return False
	End If
	
	If tbl1.GetCellString( 0 , 0 ) == "" then
		Form.ShowAlert("알림", "상품(MP)을 선택해주세요.")
		return False
	End If
	
	If chk1.checkstate <> "1" then
		Form.ShowAlert("알림", "ISA 계약권유문서를 확인해주세요.")
		return False
	End If
	
	If chk2.checkstate <> "1" then
		Form.ShowAlert("알림", "개인종합자산관리계좌(일임형)약관을 확인해주세요.")
		return False
	End If
	
	If chk3.checkstate <> "1" then
		Form.ShowAlert("알림", "MP설명서를 확인해주세요.")
		return False
	End If
	
	return True
End Function

'============================================================================
'투자성향진단 & 상품(MP) 비교
Function CheckInvestType()

	Dim sGrade, nLimit
	
	sGrade = lblGrade.caption	'투자성향진단 등급

	If sGrade <> "" and lblMPCode.caption <> "" then
	
		Select Case sGrade
			Case "01"		'1 : 고수익지향형
				nLimit = 8
			Case "02"		'2 : 성장지향형
				nLimit = 6
			Case "03"		'3 : 중립형
				nLimit = 4
			Case "04"		'4 : 안정지향형
				nLimit = 2
			Case "05"		'5 : 이자소득형
				nLimit = 0
		End Select
		
'		g_nMPIdx : 상품(MP) 선택 라디오 인덱스
'		0 : 메리츠 ISA 이자소득형A
'		1 : 메리츠 ISA 안정지향형A
'		2 : 메리츠 ISA 안정지향형B
'		3 : 메리츠 ISA 중립형A
'		4 : 메리츠 ISA 중립형B			
'		5 : 메리츠 ISA 성장지향형A
'		6 : 메리츠 ISA 성장지향형B
'		7 : 메리츠 ISA 고수익지향형A
'		8 : 메리츠 ISA 고수익지향형B

		If nLimit < g_nMPIdx then
			Form.ShowAlert("알림", "고객등급 < 상품등급일 경우 가입이 불가합니다.")
			return False
		End If
	End If
	
	return True
End Function

'============================================================================
Sub CheckPrincipalPreserv()
	'mbonl81010_p1(고객투자성향진단_공통프로세스팝업) 화면 로직 사용
	Form.OpenPopup( "mbisa56060_pd" , "" , "")
End Sub

'============================================================================
Sub MoveNextPage()
	Dim sSendData

	'추후 유지보수 중 항목 추가 발생할 경우에 대비, 각 화면마다 array 20개씩 잡아놓음
	sSendData = g_sSendData & tbl0.GetCellString(0, 0) & "★"
	sSendData = sSendData & lblMPCode.caption & "★"
	sSendData = sSendData & tbl1.GetCellString(0, 0) & "★"
'	sSendData = sSendData & cmbPaper.cbkeydata & "★"		'서류제출방법 첫페이지로 이동
'	sSendData = sSendData & cmbPaper.caption & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & g_sAmt & "★"
	sSendData = sSendData & g_sClickTime0 & "★"
	sSendData = sSendData & g_sClickTime1 & "★"
	sSendData = sSendData & g_sClickTime2 & "★"
	sSendData = sSendData & lblGrade.caption & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	
	Form.OpenFramePopup( "mbisa56060_p2" , sSendData , sPosInfo)
End Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("가입신청")
	
	g_sSendData = Form.GetOpenLinkData()
	g_szList = Split(g_sSendData,"★")		

	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	g_sInvestSendData = g_szList(0) & "★" & g_szList(3)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	'상품(MP) 선택
	If sKeyName == "mbisa56060_p6" and sRet <> "" then
		Dim sMPText, sMPCode
		
		Call ClearNextStep("2")	'상품선택 변경시 ISA계약필수문서 확인 초기화
		
		g_nMPIdx = CDbl(sRet)
		
		Select Case sRet
			Case "0"
				sMPText = "메리츠 ISA 이자소득형A"
				sMPCode = "WA000101"
			Case "1"
				sMPText = "메리츠 ISA 안정지향형A"
				sMPCode = "WA000102"
			Case "2"
				sMPText = "메리츠 ISA 안정지향형B"
				sMPCode = "WA000103"
			Case "3"
				sMPText = "메리츠 ISA 중립형A"
				sMPCode = "WA000104"
			Case "4"
				sMPText = "메리츠 ISA 중립형B"
				sMPCode = "WA000105"
			Case "5"
				sMPText = "메리츠 ISA 성장지향형A"
				sMPCode = "WA000106"
			Case "6"
				sMPText = "메리츠 ISA 성장지향형B"
				sMPCode = "WA000107"
			Case "7"
				sMPText = "메리츠 ISA 고수익지향형A"
				sMPCode = "WA000108"
			Case "8"
				sMPText = "메리츠 ISA 고수익지향형B"
				sMPCode = "WA000109"
		End Select
		
		lblMPCode.caption = sMPCode
		tbl1.SetCellString(0, 0, sMPText)
	End If
	
	
	'투자성향진단
	If sKeyName == "mbisa56060_pb" then
		If Trim(sRet) <> "" then
			chk0.checkstate = "1"
			lblGrade.caption = Left(sRet, 2)	'등급(계약자 확인사항 팝업에서 사용)
			tbl0.SetCellString( 0, 0, Right(sRet, Len(sRet)-2 ))
			
			'투자성향진단 선택시 상품선택 가능
			g_bMPSelect = True
		Else
			chk0.checkstate = "0"
			lblGrade.caption = ""
			tbl0.SetCellString( 0, 0, "")
		End If
		
		'투자성향진단 변경시 상품선택 클리어
		tbl1.SetCellString( 0, 0, "")
		lblMPCode.caption = ""
	End If
	
	
	'투자자금 원금보존 확인
	If sKeyName == "mbisa56060_pd" then
		btnOK.enable = True
		
		DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "ACNO", 0, g_szList(0))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "ASNO", 0, g_szList(1))
		
		'예
		if sRet = "ok" then							
			'예 선택시 이자소득형/안정지향형이 아닌 경우 Alert
			If g_nMPIdx > 2 then
				Form.ShowAlert("알림", "원금보존 추구 투자자금인 경우, 이자소득형과 안정지향형만 선택 가능합니다.")
				Exit Sub
			End If
			
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "PRNC_PRSV_YN" , 0, "Y")
			DATAMANAGER.RequestTranData("obcsb_acif_792a")	'투자자금 원금보존여부 등록
		
		'아니오
		elseif sRet = "no" then						
			DATAMANAGER.SetDataValue(0, "obcsb_acif_792a", "InBlock1", "PRNC_PRSV_YN", 0, "N")
			DATAMANAGER.RequestTranData("obcsb_acif_792a")	'투자자금 원금보존여부 등록
		end if
	End If
	
	
	If sKeyName == "mbisa56060_p2" then
		If sRet == "ok" then
			Form.SendReturnToParent( "mbisa56060_p1" , "ok" )
			Form.CloseForm()
		End If
	End If
	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	'안드로이드는 num, 아이폰은 string으로 받음
	If sTimerID == 0 or sTimerID == "0" then
		Form.SetTimerEvent( 0, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_1")
	End If
	
	If sTimerID == 1 or sTimerID == "1" then
		Form.SetTimerEvent( 1, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_2")
	End If
	
	If sTimerID == 2 or sTimerID == "2" then
		Form.SetTimerEvent( 2, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_3")
	End If
	
	If sTimerID == 3 or sTimerID == "3" then
		Form.SetTimerEvent( 3, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_4")
	End If
End Sub

'============================================================================
'투자성향진단
Sub chk0_OnChange(sCheckState)
	Call btnDetail0_OnClick()
End Sub

'============================================================================
'투자성향진단
Sub btnDetail0_OnClick()
	Call ClearNextStep("1")	'투자성향진단 변경시 상품선택/ISA계약필수문서 확인 초기화
	Form.OpenFramePopup( "mbisa56060_pb" , g_szList(0) & "★" & g_szList(3), "")
End Sub

'============================================================================
Sub btnMP_OnClick()
	If g_bMPSelect == False then
		Form.ShowAlert("알림", "ISA 투자성향진단 등록 후에 선택가능합니다.")
		Exit Sub
	End If
	
	Form.OpenFramePopup( "mbisa56060_p6" , lblGrade.caption , "")
End Sub

'============================================================================
Sub imgNotice_OnClick()
	Call btnNotice_OnClick()
End Sub

'============================================================================
'상품(MP) 상담안내
Sub btnNotice_OnClick()
	Form.OpenFramePopup( "mbisa56060_p7" , g_szList(0) , "")
End Sub

'============================================================================
'ISA계약권유문서
Sub chk1_OnChange(sCheckState)
	Call btnDetail1_OnClick()
End Sub

'============================================================================
'ISA계약권유문서_내용보기
Sub btnDetail1_OnClick()
	Dim nType
	nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	if nType == "0" then
		Form.OpenPdfViewer( "http://home.imeritz.com/include/resource/isa/cncrInvtDoc_20160401.pdf", "")	'운영계 주소
	elseif nType == "1" then
		Form.OpenPdfViewer( "http://211.255.202.106/include/resource/isa/cncrInvtDoc_20160401.pdf", "")	'테스트계주소
	end if	
	
	chk1.checkstate = "1"
	g_sClickTime0 = Form.GetSharedData("&HOST_TIME", True )	'클릭시각
End Sub

'============================================================================
'개인종합자산관리계좌(일임형)약관
Sub chk2_OnChange(sCheckState)
	Call btnDetail2_OnClick()
End Sub

'============================================================================
'개인종합자산관리계좌(일임형)약관_내용보기
Sub btnDetail2_OnClick()
	Dim nType
	nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	if nType == "0" then
		Form.OpenPdfViewer( "http://home.imeritz.com/include/resource/isa/clause_20160314.pdf", "")	'운영계 주소
	elseif nType == "1" then
		Form.OpenPdfViewer( "http://211.255.202.106/include/resource/isa/clause_20160314.pdf", "")	'테스트계주소
	end if	
	
	chk2.checkstate = "1"
	g_sClickTime1 = Form.GetSharedData("&HOST_TIME", True )	'클릭시각
End Sub

'============================================================================
'MP설명서
Sub chk3_OnChange(sCheckState)
	Call btnDetail3_OnClick()
End Sub

'============================================================================
'MP설명서_내용보기
Sub btnDetail3_OnClick()
	If g_nMPIdx < 0 then
		Form.ShowAlert("알림", "상품(MP)을 선택해주세요.")
		chk3.checkstate = "0"
		Exit Sub
	End If
	
	chk3.checkstate = "1"
	g_sClickTime2 = Form.GetSharedData("&HOST_TIME", True )	'클릭시각
	
	Select Case g_nMPIdx
		Case 0
			Call OpenMPManual("itrstIncmDoc_20160401")
		Case 1
			Call OpenMPManual("sftyAimADoc_A_20160401")
		Case 2
			Call OpenMPManual("sftyAimBDoc_B_20160401")	
		Case 3
			Call OpenMPManual("nuratyTypeADoc_A_20160401")	
		Case 4
			Call OpenMPManual("nuratyTypeBDoc_B_20160401")
		Case 5
			Call OpenMPManual("grthAimADoc_A_20160401")
		Case 6
			Call OpenMPManual("grthAimBDoc_B_20160401")	
		Case 7
			Call OpenMPManual("hgtIncmAimADoc_A_20160401")
		Case 8
			Call OpenMPManual("hgtIncmAimBDoc_B_20160401")	
	End Select
End Sub

'============================================================================
'취소 버튼
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'다음 버튼
Sub btnOK_OnClick()
	btnOK.enable = False
	
	If ValidateCheck() == False then
		btnOK.enable = True
		Exit Sub
	End If
	
	'투자성향진단 & 상품(MP) 비교
	If CheckInvestType() == False then
		btnOK.enable = True
		Exit Sub
	End If
	
	DATAMANAGER.RequestTranData("obaci_acct_089r")	'은행연합회 한도금액 조회
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obaci_acct_089r" or szTranID == "obaci_acct_089r_1" or szTranID == "obaci_acct_089r_2" or szTranID == "obaci_acct_089r_3" or szTranID == "obaci_acct_089r_4" then	
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "TXCM_PRCD" , 0 , g_szList(4))	'은행연합회 상품코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , g_szList(0))			'계좌번호
	End If
	
	If szTranID == "obwat_ctad_010r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , g_szList(0))			'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , g_szList(1))			'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_PRCD" , 0 , lblMPCode.caption)	'랩어카운트상품코드	
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	'-----------------------------------------------------------------
	'은행연합회 한도금액 조회
	'-----------------------------------------------------------------
	Dim sCode, sOutput
	
	'PROS_CLS_CODE가 '1'이면 1초에 한번 총 5회 OutBlock1.LNKD_TLMS_MNNO를 INPUT으로 하여 다시 전송한다.
	'PROS_CLS_CODE가 '2'로 정상응답을 수신하면 재전송 중단
	If szTranID == "obaci_acct_089r" then
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)

		If sCode == "1" then
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_1", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 0, 1, 1 )	
			
		ElseIf sCode == "2" then	'정상
			g_sAmt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UI_SVNG_LIMT_UNSD_AMT" , 0)	'미사용한도
			'Call MoveNextPage(g_sAmt)	'다음 페이지로
			Call CheckPrincipalPreserv()	'투자자금 원금보존 확인
		End If
	End If
	
	If szTranID == "obaci_acct_089r_1" then
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
		
		If sCode == "1" then
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_2", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 1, 1, 1 )
			
		ElseIf sCode == "2" then	'정상
			g_sAmt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UI_SVNG_LIMT_UNSD_AMT" , 0)	'미사용한도
			'Call MoveNextPage(g_sAmt)	'다음 페이지로
			Call CheckPrincipalPreserv()	'투자자금 원금보존 확인
		End If
	End If
	
	If szTranID == "obaci_acct_089r_2" then
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
		
		If sCode == "1" then
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_3", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 2, 1, 1 )	
			
		ElseIf sCode == "2" then	'정상
			g_sAmt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UI_SVNG_LIMT_UNSD_AMT" , 0)	'미사용한도
			'Call MoveNextPage(g_sAmt)	'다음 페이지로
			Call CheckPrincipalPreserv()	'투자자금 원금보존 확인
		End If
	End If
	
	If szTranID == "obaci_acct_089r_3" then
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
		
		If sCode == "1" then
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_4", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 3, 1, 1 )	
			
		ElseIf sCode == "2" then	'정상
			g_sAmt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UI_SVNG_LIMT_UNSD_AMT" , 0)	'미사용한도
			'Call MoveNextPage(g_sAmt)	'다음 페이지로
			Call CheckPrincipalPreserv()	'투자자금 원금보존 확인
		End If
	End If
	
	If szTranID == "obaci_acct_089r_4" then
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
		
		If sCode == "1" then
			btnOK.enable = True
			Form.ShowAlert("알림", "은행연합회 한도조회에 실패하였습니다.")
			Exit Sub
			
		ElseIf sCode == "2" then	'정상
			g_sAmt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UI_SVNG_LIMT_UNSD_AMT" , 0)	'미사용한도
			'Call MoveNextPage(g_sAmt)	'다음 페이지로
			Call CheckPrincipalPreserv()	'투자자금 원금보존 확인
		End If
	End If
	
	'-----------------------------------------------------------------
	'투자자금 원금보존여부 등록
	'-----------------------------------------------------------------
	If szTranID == "obcsb_acif_792a" then	
		DATAMANAGER.RequestTranData("obwat_ctad_010r")	'KYC고객등급상품등급비교
	End If
	
	'-----------------------------------------------------------------
	'KYC고객등급상품등급비교
	'-----------------------------------------------------------------
	If szTranID == "obwat_ctad_010r" then	
		If DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "JOIN_ABLE_YN" , 0) <> "Y" then
			btnOK.enable = True
			Form.ShowAlert("알림", DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "DEAL_PRHB_CNTT" , 0))
			Exit Sub
		Else
			Call MoveNextPage()
		End If
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
	btnOK.enable = True
End Sub




