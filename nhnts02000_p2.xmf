	<SCRIPT_INFO _len="5611" _ulen="5035" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문 주문확인창
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


Dim g_nCount
	g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szOrd_ItmCode		' 종목코드
Dim 	g_szOrd_ItmName		' 종목명
Dim 	g_szOrd_OrdType		' 주문구분
Dim 	g_szOrd_Security		' 현금/신용
Dim 	g_nOrd_Qty			' 주문수량
Dim 	g_nOrd_Price			' 주문가격
Dim 	g_nOrd_OrdNo			' 원주문번호
Dim 	g_nOrd_ChkAll			' 잔량전부	
Dim	g_nOrd_Decimal		' 가격자릿수
'20191029 YGH 예약주문 문구추가 Start
Dim g_nOrd_res_Type 		' 예약주문유형
Dim g_nOrd_res_time		' 주문시간유형
'20191029 YGH 예약주문 문구추가 End



'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)

    If g_nOrd_ChkAll = "1" Then
		g_nOrd_Price = "잔량"
    End If
    
    
     '20191029 YGH 주문유형 , 주문시간 문구추가(예약주문인경우에만) Start
    if nIndex == "11" then
	    lblMaesu1Title.caption = "(예약)현금매도주문"
	     tblMaedo0.visible = true
		tblMaedo.visible = false
		tblMaedo0.SetCellString( 0, 1, g_szOrder_Acc 	)
		tblMaedo0.SetCellString( 0, 2, g_szOrder_AccName	)
		tblMaedo0.SetCellString( 1, 1, g_szOrd_ItmCode	)
		tblMaedo0.SetCellString( 2, 1, g_szOrd_ItmName 	)
		tblMaedo0.SetCellString( 3, 1, g_szOrd_OrdType 	)
		tblMaedo0.SetCellString( 4, 1, g_nOrd_res_Type 	)
		tblMaedo0.SetCellString( 5, 1, g_nOrd_res_time	)
		tblMaedo0.SetCellString( 6, 1, g_nOrd_Qty		)
		sMask = "0,0,,,0,,"..g_nOrd_Decimal..",1,1,2,0"
		tblMaedo0.SetCellMaskInfo( 7, 1, sMask )
		tblMaedo0.SetCellString( 7, 1, g_nOrd_Price )	
		
    else
		tblMaedo0.visible = false
		tblMaedo.visible = true
	     tblMaedo.SetCellString( 0, 1, g_szOrder_Acc 		)
		tblMaedo.SetCellString( 0, 2, g_szOrder_AccName 	)
		tblMaedo.SetCellString( 1, 1, g_szOrd_ItmCode		)
		tblMaedo.SetCellString( 2, 1, g_szOrd_ItmName 	)
		tblMaedo.SetCellString( 3, 1, g_szOrd_OrdType		)
		tblMaedo.SetCellString( 4, 1, g_nOrd_Qty			)
		sMask = "0,0,,,0,,"..g_nOrd_Decimal..",1,1,2,0"
		tblMaedo.SetCellMaskInfo( 5, 1, sMask )
		tblMaedo.SetCellString( 5, 1, g_nOrd_Price )	
    end if
	'20191029 YGH 주문유형 , 주문시간 문구추가 End
	
End Function

'============================================================================
Function SendOrder()
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문전송" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
    End If
    
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	g_nIndex				= arrData( 0) ' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소, 11:예약매수, 12:예약매도, 14:예약취소)
	g_szOrder_Acc			= arrData( 1)	' 계좌번호
	g_szOrder_AccName		= arrData( 2)	' 고객명
	g_szOrd_ItmCode 		= arrData( 3)	' 종목코드
	g_szOrd_ItmName 		= arrData( 4)	' 종목명
	g_szOrd_OrdType  		= arrData( 5)	' 주문구분
	g_szOrd_Security 		= arrData( 6)	' 현금
	g_nOrd_Qty   			= arrData( 7)	' 주문수량
	g_nOrd_Price 			= arrData( 8)	' 주문가격
	g_nOrd_OrdNo 			= arrData( 9)	' 원주문번호
	g_nOrd_ChkAll 		= arrData(10)	' 잔량전부
	g_nOrd_Decimal		= arrData(11)	' 가격자릿수
	
	'20191029 YGH 주문유형 , 주문시간 문구추가(예약주문인경우에만) Start
	if g_nIndex == "11" then
		g_nOrd_res_Type 	= arrData(12) ' 예약주문유형
		if arrData(13) == "0" then
			g_nOrd_res_time = "장개시"
		elseif arrData(13) == "1" then
			g_nOrd_res_time = "장마감 10분 전"
		elseif arrData(13) == "2" then
			g_nOrd_res_time = "장마감 30분 전"
		end if
		'g_nOrd_res_time 	= arrData(13) ' 예약주문시간유형 
	end if
	'20191029 YGH 주문유형 , 주문시간 문구추가 End
	
	
End Sub

'============================================================================
Sub Form_OnFormInit()

    Set_Data(g_nIndex)
    
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm( )	
End Sub

'============================================================================
Sub btnSell_OnClick()
	SendOrder()
End Sub

'============================================================================
Sub imgClose1_OnClick()
	Form.CloseForm( )
End Sub



	</SCRIPT_INFO>
</ROOT>