'======================================
' Form_OnFormInit
'======================================
Sub Form_OnFormInit()
	Load_OrderSet() '주문설정값 읽어오기   
	
	'20211228 SWJ START
	Position_Control()
	'Set_rdoGbnCaption( rdoGbn.currentindex )
	'20211228 SWJ END
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
	
End Sub

'======================================
' Form_OnTriggerEvent
'======================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	' ----------------------------------------------------------------------
	' 메인화면의 호가 클릭시
	' ----------------------------------------------------------------------	
	if sEventName = "12000_HOGA" then
		if sParam <> "" then
			'주문유형에 따른 주문단가
			szType = Check_OrdType()
			
			if szType = "01" or szType = "06" or szType = "81" then		'지정, 조건부, 시간외 주문
				edtPrc.caption = sParam
			end if	
		else
			edtPrc.caption = sParam
		end if
		
	' ----------------------------------------------------------------------
	' 메인화면에서 종목코드 받기
	' ----------------------------------------------------------------------
	elseif sEventName = "INIT_CODE" then
		Form.SetCtlProp("#edtOrgNo", "caption", "")	

		if g_bRtnData == false then
			'20170919 HAMWG START : 잔고팝업에서 리턴시 수량 세팅 유지
			'if g_szCd <> sParam then
				g_szCd = sParam
				
				Set_OrdType()		' 종목코드에 따라 주문유형 설정
				
				
				if g_szBalQty <> true then
					if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
						Init_InputControl()
					end if
				end if
				
				g_szBalQty = false
			'end if
			'20170919 HAMWG END
		end if
		
		'20180720 LES START
		Position_Control()
		
	' ----------------------------------------------------------------------
	' 자동가격입력
	' ----------------------------------------------------------------------		
	elseif sEventName == "AUTO_PRICE" then
		if g_bRtnData == true then
			g_bRtnData = false
		else
		
			'20170919 HAMWG START : 탭/종목 변경시 초기화 여부
			if g_szChangeInit <> "1" then		
				Return_AutoQty()
			end if
			'20170919 HAMWG END
		
			if Trim(sParam) <> "" then
				edtPrc.caption = sParam
			end if
		end if
	end if
End Sub

'======================================
' Form_OnPopupReturn
'======================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName = "주문경고" then
		if sRet = "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	
		
	' ----------------------------------------------------------------------
	' 주문확인팝업에서 리턴
	' ----------------------------------------------------------------------	
	Elseif sKeyName = "주문전송" Then
		Request_Order()

	' ----------------------------------------------------------------------
	' 수량/금액입력창에서 리턴
	' ----------------------------------------------------------------------	
	Elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
	' ----------------------------------------------------------------------
	' 가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	Elseif sKeyName == "PRC_POPUP" then		
		edtPrc.caption = sRet		
		
	' ----------------------------------------------------------------------
	' 자동가격입력
	' ----------------------------------------------------------------------		
	elseif sEventName == "AUTO_PRICE" then
		if g_bRtnData == true then
			g_bRtnData = false
		else
			Return_AutoQty()
		
			if Trim(sParam) <> "" then
				edtPrc.caption = sParam
			end if
		end if

	' ----------------------------------------------------------------------
	' 잔고팝업에서 리턴
	' ----------------------------------------------------------------------	
	Elseif sKeyName = "12000_BALANCE" then
		if sRet = "" then
			Exit Sub
		end if
		
		g_szBalQty = true		'20170919 HAMWG : 잔고팝업 리턴 플래그 세팅
		
'		Return_BalanceScreen(sParam)
		
		'  전달내용/탭위치/종목코드/수량/대출일자/대출상세/신용합산여부/대출일련번호
		' 전달내용/탭번호/종목코드/수량/대출일자/대출상세/신용합산여부/대출일련번호
		tData = Split(sRet, "★")
		
		if UBound(tData) > 0 then
			' 플랫폼에 종목코드변경 요청
			szCutCd = Mid(tData(2), 2, Len(tData(2)))
			szMk = Form.GetItemCodeInfo(szCutCd, "market")
			
			' 보유종목리스트에서 주식종목은 종목코드 맨 앞에 "A", ELW는 "J"가 붙어서 내려옴. 예외처리 ////
			Select Case szMk
				Case "J", "T", "W"
					Form.SetItemCode(szCutCd)
				Case Else
					if Left(tData(2), 1, 1) = "A" then
						Form.SetItemCode(szCutCd)
					else
						Form.SetItemCode(tData(2))
					end if
			End Select
			' ////////////////////////////////////////////////////////////////////////////////////////////			

			tData2 = Split(tData(3), "♥")		
			
			'20170713 HAMWG START : 주식 신용매도 정산금 가계산 서비스 추가 
			g_szChkCredit = tData2(3)
			g_szLoanDate  = tData2(1) 
			g_szLoanSrno  = tData2(4) 
			g_szLoanCode  = tData2(2)
			'20170713 HAMWG END
			
			If UBound(tData2) > 0 then

				edtQty.caption = tData2(0)				' 수량
			
				if Trim(tData2(3)) = "0" then
					cldSell.caption = tData2(1)			' 대출일자
				end if
				
				Select Case Trim(tData2(2))				' 대출상세
					Case "0000" 						' 보통
						rdoGbn.eventindex = 0
					Case "0103"						'자기대주		'20211227 SWJ START : 유통대주 구분자 삭제		
						Form.triggerEvent("#", "BALANCE_SELL", tData(3) )	'매수탭으로 이동
						
					Case "0101", "0102"				'신용융자
						rdoGbn.eventindex = 1
						cmbCredit.currentindex = "0"
					
					Case "0901"						'대용
						rdoGbn.eventindex = 2
						cmbCredit.currentindex = "0"
					
					Case "0201","0211"
						rdoGbn.eventindex = 1
						cmbCredit.currentindex = "1"					'20211227 SWJ START : 유통대주 삭제에 따른 인덱스 변경
					
					Case "0401"						
						rdoGbn.eventindex = 1
						cmbCredit.currentindex = "2"					'20211227 SWJ START : 유통대주 삭제에 따른 인덱스 변경
						
				End Select
				
				'20211210 HSZ START : 대용주식매도 추가
				szClcd = tData2(6)
				if szClcd == "32" or szClcd == "16" then
					rdoGbn.eventindex = 2
					cmbCredit.currentindex = "0"
				end if
				'20211210 HSZ END
				
			End If
		end if
	'20160715 NOHES START 기간예약주문 범위	
	Elseif	sKeyName = "Range" Then
		g_tRangeYN = "Y"
		tData = Split(sRet, "★")
		If UBound(tData) > 0 then
			cmbRange.currentindex = tData(0)				' 기간예약유형
			
			if tData(0) <> "0" Then
				Dim sStart, sFinish
				g_Start = tData(1)
				g_Finish = tData(2)
				
				sStart = Left(tData(1),4) &"/"& Mid(tData(1), 5, 2) &"/"& Right(tData(1), 2)		'기간 시작 날짜
				sFinish = Left(tData(2),4) &"/"& Mid(tData(2), 5, 2) &"/"& Right(tData(2), 2)		'기간 종료 날짜
				
				LblRange.caption = sStart & " ~ "& sFinish
				LblRange.visible = True
			Else
				LblRange.visible = False
			End If
		End If
	
		g_tRangeYN = "N"
	'20160715 NOHES END	
	end if
End Sub

'======================================
' DATAMANAGER_OnSendTranBefore
'======================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCd, szType, szPrc, szCLS, szCLSCd, szIqry, szLoanCd, szLoanDate, szCondCd, szADOD_TYPE
	
	' 종목코드
	szCd = Change_ItemCode()
		
	'주문유형
	szType = Check_OrdType()

	' 주문조건 구분코드
	szCondCd = Check_CondCode()
	
	'주문유형에 따른 주문단가
	Select Case szType
		Case "05", "12", "13", "61", "71"					'시장가,최유리,최우선 주문
			szPrc = "0"
		Case Else
			szPrc = edtPrc.caption
	End Select

	' 현금/신용 구분
	szCLS = rdoGbn.currentindex
	
	szLoanDate = cldSell.caption
	
    '예약주문유형코드
	If szCLS = "0" Then
	    szADOD_TYPE = "01" 	'매도
	    szLoanCd	   = "0102"
	
	ElseIf szCLS = "1" Then	' 신용
	
	'20211227 SWJ START : 신용대주 구분자 삭제 (유통대주화면은 독립화면으로)
		If cmbCredit.currentindex = "0" Then
			szADOD_TYPE = "03"	'신용융자
'		ElseIf cmbCredit.currentindex = "1" Then
'			szADOD_TYPE = "06"	'신용대주
'			szLoanDate = ""
		ElseIf cmbCredit.currentindex = "1" Then
			szADOD_TYPE = "11"	'예탁담보
		Else
			szADOD_TYPE = "12"	'소액담보
		End If
	'20211227 SWJ END
	
		szLoanCd	   = "0102"
		
	ElseIf szCLS = "2" Then		' 대용
		szADOD_TYPE = "13"
		szLoanCd	   = ""
		
	End If
	
	' ----------------------------------------------------------------------
	' 예약주문주문
	' 20160715 NOHES 기간예약주문 서비스 변경 obtrs_oder_501a -> obtrs_oder_510a
	' ----------------------------------------------------------------------	
	if szTranID = "obtrs_oder_510a" then
'	if szTranID = "obtrs_oder_501a" then
		g_szTR = szTranID
		DATAMANAGER.ClearInputData(0, "obtrs_oder_510a")
		
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "SVCD" 				, 0 , "502" 								)	'서비스구분코드
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ACNO" 				, 0 , Form.GetCtlProp("#acnt", "total")								)  	'계좌번호8
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ASNO" 				, 0 , Form.GetCtlProp("#acnt", "sequence") 							)  	'계좌번호2
		
		'20200910 SWJ START : MTS 메모리 평문제거
		'MTS메모리평문제거 적용상태일 때
		if plain_rm =="1" then
			DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ACNT_PWD"			, 0 , Form.GetCtlProp("#edtPwd", "caption") 	)	' 계좌비밀번호
		
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ACNT_PWD"			, 0 , Form.GetCtlProp("#edtPwd", "encdata") 	)	' 계좌비밀번호
		end if
		
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ISCD" 				, 0 , szCd								)	'종목코드	    		
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ADOD_TYPE_CODE"		, 0 , szADOD_TYPE							)	'예약주문 유형코드
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "DEAL_CLS_CODE"		, 0 , "1"								)	'매매구분코드 (1:매도, 2:매수, 4:취소)
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ODQT"				, 0 , edtQty.caption						)	'주문수량
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ODER_UNPR" 			, 0 , szPrc 								)	'주문가격
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ODER_CLS_CODE" 		, 0 , szType 								)  	'주문구분코드		
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "RSEV_ODER_NO" 		, 0 , "" 								)	'예약주문번호
		

		if szCLS ="1" then		' 신용			
			DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "LOAN_SRNO"		, 0 , g_szLoanSrno						)	'대출일련번호
			DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "LOAN_DATE"		, 0 , szLoanDate							)	'대출일자
		Else
			DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "LOAN_SRNO"		, 0 ,  ""								)	'대출일련번호
			DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "LOAN_DATE"		, 0 ,  ""								)	'대출일자
		End If
	
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "WARN_CNFR_YN" 		, 0 , g_szWarnFlag						) 	'경고확인구분 '20140423 KBC 착오매매 제도개선
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "CHAN_TYPE_CLS_CODE"	, 0 , ""									)	'채널유형구분		

		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ODER_RSEV_MST_DATE", 0, ""		) '취소시 필요
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ODER_RSEV_MST_NO", 0, ""			) '취소시 필요
		DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ODER_RSEV_CLS_CODE", 0, cmbRange.cbkeydata ) 
		
		If cmbRange.cbkeydata <> "1" Then
			DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ODER_STA_DATE" , 0, g_Start)
			DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ODER_FIN_DATE" , 0, g_Finish)
		Else
			DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ODER_STA_DATE" , 0, "")
			DATAMANAGER.SetDataValue( 0, "obtrs_oder_510a", "InBlock1", "ODER_FIN_DATE" , 0, "")
		End If

	' ----------------------------------------------------------------------
	' 주문가능수량 조회
	' ----------------------------------------------------------------------	
	elseif szTranID = "obtrs_comn_405r" then
		Dim szLoanSr
		
		DATAMANAGER.ClearInputData(0, "obtrs_comn_405r")
		
		szIqry = PrdCode()
		
		If g_szLoanSrno = "" Then
			szLoanSr = 1
		ElseIf g_szLoanSrno = 0 Then
			szLoanSr = 1
		Else
			szLoanSr = g_szLoanSrno
		End If
		
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "IQRY_CLS_CODE"		, 0, szIqry								)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acnt", "total")		)	' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acnt", "sequence")	)	' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "ISCD"				, 0, szCd								)	' 종목코드
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "LOAN_DATE"			, 0, szLoanDate							)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "LOAN_SRNO"			, 0, szLoanSr								)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "LOAN_DTL_TYPE_CODE"	, 0, szLoanCd								)
	end if
End Sub
				
'======================================
' DATAMANAGER_OnReceiveTranComplete
'======================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szOdrMsg
	
	' ----------------------------------------------------------------------
	' 주식주문
	' 20160715 NOHES 기간예약주문 서비스 변경 obtrs_oder_501a -> obtrs_oder_510a	
	' ----------------------------------------------------------------------	
	Select Case szTranID
		Case "obtrs_oder_510a"			'"obtrs_oder_501a"
			szWarnCd = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
			szOdrMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
			
			if szWarnCd = "1" then									' 경고
				g_szPopupData = g_szPopupData & "|" & szOdrMsg		' 경고메세지		
				Form.OpenPopup("mbtrs12020_p8", g_szPopupData , "")	' 경고팝업 오픈
			
			elseif szWarnCd = "2" then						' 보류
				g_szTR = ""
				Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
			else
				g_szTR = ""
				
				szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
				szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)

				if Trim(szOrdCd) = "5620" then			' 정상주문
					Form.Toast(0, szOrdMsg, true)
					
					if g_szAfterInit = "1" then		' 주문후 초기화
						Init_InputControl()
					end if
					
					if g_szAfterOrg = "1" then			' 주문번호 연동
						szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
						
						Form.SetCtlProp("#edtOrgNo", "caption", szOrgNo)
					else
						Form.SetCtlProp("#edtOrgNo", "caption", "")
					end if
				end if
			end If
			
	' ----------------------------------------------------------------------
	' 주문가능수량 조회
	' ----------------------------------------------------------------------	
		Case "obtrs_comn_405r"
			edtQty.caption = DATAMANAGER.GetDataValue(0, "obtrs_comn_405r", "OutBlock1", "ODER_ABLE_QTY", 0)			' 주문가능수량
	End Select
	
	g_szWarnFlag = "N"	
End Sub

'======================================
' DATAMANAGER_OnReceiveTranError
'======================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	'20160715 NOHES 기간예약주문 수정
	If szTranID = "obtrs_oder_510a" Then			
'	If szTranID = "obtrs_oder_501a" Then		
'		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if Trim(szSubMsg) <> "" then
			Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
'			Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
		else
			Form.ShowAlert(g_szTitle, szErrMsg)
'			Form.Toast(0, szErrMsg, true)
		end if
		
'		에러는 초기화 안함(20160314 : 전요셉과장)		
'		if g_szAfterInit == "1" then		' 주문후 초기화
'			Init_InputControl()
'		end if	
	else
		'20211210 HSZ START
	    If szSubMsg <> "" Then  
		    Form.ShowAlert("알림", "[TR]"&szErrMsg &"(" & szSubMsg & ")")
		Else
		    Form.ShowAlert("알림", "[TR]"&szErrMsg)
		End If
		'20211210 HSZ END
	End If
End Sub

'======================================
' cmbType_OnEditComplete
'======================================
Sub cmbType_OnEditComplete(iIndex)
	Form.SetSharedData("STOCK_SELTYPE", cmbType.cbkeydata)
	Form.triggerEvent("#", "12000_SELTYPE", "")
	Visible_Control(iIndex)
End Sub

'======================================
' btnOrdBal_OnClick : 주문관련비용 계산
'======================================
Sub btnOrdBal_OnClick()
	Dim szType, szCode, szPrice, szInner, szInrMk, szAcnt, szAcntCd
	
	'계좌번호
	szAcnt   = Form.GetCtlProp("#acnt", "total")
	szAcntCd = Form.GetCtlProp("#acnt", "sequence")
	
	if Check_InputData(2) = false then
		Exit Sub
	end if

 	'시장구분
	szInner = Form.GetItemCodeInfo(g_szCd, "innermarket")

	if szInner = "002" then		'코스닥
	    szInrMk = "02"
	elseif g_szInner = "033" then	'코넥스
		szInrMk = "21"
'	elseif '프리보드
'		szInrMk = "03"
	else
		szInrMk = "01"
	end if
	
	'주문유형에 따른 주문단가
	szType = cmbType.cbkeydata
    
	Select Case szType
		Case "11"		'장개시전시간외(전일종가)
			szPrice =  Form.GetCtlProp("#lblStd", "caption")
		Case "12"		'시간외종가(현재가)
			szPrice =  Form.GetCtlProp("#lblHyun", "caption")
		Case "01", "03", "04", "06", "07", "09", "10" 		'시장/최유리/최우선지정가
			szPrice =  Form.GetCtlProp("#lblHigh", "caption")		' 매수시(상한가), 매도시 ( 하한가 )	
		Case else
		    szPrice = edtPrc.caption
	    
			if edtPrc.caption = "0" or edtPrc.caption = "" then
				Form.ShowAlert(g_szTitle, "주문가격을 입력하세요")
				exit Sub
			end if	    
	End Select

    '종목코드
	szCode = Change_ItemCode()
	
    '20170713 HAMWG START : 주식 신용매도 시 정산금 데이터 추가
	' 현금/신용 구분
	szCLS = rdoGbn.currentindex
	
	if g_szChkCredit = null then
		g_szChkCredit = 0
	end if
	
	if szCLS == "1" then		' 신용
		if g_szChkCredit == 0 or g_szChkCredit == "0" then
			szLoanDate = cldSell.caption
		else
			szLoanDate = ""
		end if
		
		'20211227 SWJ START : 신용대주 구분자 삭제
'		if cmbCredit.currentindex == "1" then		' 신용대주
'			szLoanCd = "0103"
'			szLoanDate = ""
'			szLoanSr = 1
	
		if cmbCredit.currentindex == "1" then	' 예탁담보
			szLoanCd = "0201"
			if g_szLoanSrno = "" or g_szLoanSrno = 0 then
				szLoanSr = 0
			else
				szLoanSr = g_szLoanSrno
			end if

		elseif cmbCredit.currentindex == "2" then	' 소액담보
			szLoanCd = "0401"
			if g_szLoanSrno = "" or g_szLoanSrno = 0 then
				szLoanSr = 0
			else 
				szLoanSr = g_szLoanSrno
			end if
		else										' 신용융자
			szLoanCd = "0101"
			szLoanSr = 1
		end if
		'20211227 SWJ END
	end if

    '계좌번호|채널유형|시장구분|매매구분(1매도, 2매수)|주문수량|주문단가|종목코드
    szData = szAcnt & "★" & szAcntCd & "★" & szInrMk & "★" & "1" & "★" & edtQty.caption & "★" & szPrice & "★" & szCode
    if szCLS = "0" then
		Form.OpenPopup("mbtrs12000_pc" , szData , "")
	elseif szCLS = "1" then
		szData = szData & "★" & szCLS & "★" & szLoanCd & "★" & g_szChkCredit & "★" & szLoanDate & "★" & szLoanSr
		Form.OpenPopup("mbtrs12000_pi" , szData , "")
	end if
		
    
    '20170713 HAMWG END
End Sub

