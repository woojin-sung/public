'20160715 NOHES START 기간예약주문 추가
'============================================================================
Sub btnRange_OnClick()
	sIndex = Form.GetCtlProp("cmbRange", "currentindex")
	Form.OpenPopup("mbtrs12020_p9",sIndex, "")
End Sub


'============================================================================
Sub cmbRange_OnEditComplete(iIndex)
	If g_tRangeYN == "Y" Then
		Exit Sub
	End If
	
	if iIndex = 0 Then
		btnRange.visible = False
		LblRange.visible = False
	else
		btnRange.visible = True
		LblRange.visible = True
		Form.OpenPopup("mbtrs12020_p9", iIndex, "")
	End If
End Sub
'20160715 NOHES END

