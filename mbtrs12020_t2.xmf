End Function

'======================================
' Request_Order
' 20160715 NOHES 기간예약주문  서비스 변경
'======================================
Function Request_Order()
	If Confirm_Range = False Then
		Exit Function
	End If

	Dim szKey 
	
	g_szWarnFlag = "N"
	
	' 현금/신용 구분
	szCLS = rdoGbn.currentindex
	
	if szCLS <> "1" then
	'	DATAMANAGER.RequestTranData("obtrs_oder_501a")
		DATAMANAGER.RequestTranData("obtrs_oder_510a")
	else
		szKey = cmbCredit.cbkeydata
		
		'20190409 HWG START : 대출일련번호 세팅로직 불필요
		'if szKey = "01" or szKey = "05" or szKey = "06" then
		'	g_szLoanSrno = "1"
		'else
		'	g_szLoanSrno = ""
		'end if
		'20190409 HWG END
		
		DATAMANAGER.RequestTranData("obtrs_oder_510a")
	'	DATAMANAGER.RequestTranData("obtrs_oder_501a")
		
	end if
End Function

'======================================
' NOHES 기간 유효성 검사
'======================================
Function Confirm_Range()
	If cmbRange.cbkeydata == "1" Then	
		Confirm_Range = True
		Exit Function
	Else
		If g_Start == "" or Len(g_Start) <> 8 Then
			ShowAlert "예약주문", "기간 예약주문 시작일자가 유효하지 않습니다."
			Confirm_Range = False
			Exit Function
		End If
		
		If g_Finish == "" or Len(g_Finish) <> 8 Then
			ShowAlert "예약주문", "기간 예약주문 종료일자가 유효하지 않습니다."
			Confirm_Range = False
			Exit Function
		End If
		
		If CDbl(g_Start) > CDbl(g_Finish) Then
			ShowAlert "예약주문", "기간 예약주문 날짜범위를 재조정하십시오."
			Confirm_Range = False
			Exit Function
		End If
		
		Confirm_Range = True
	End If
End Function


'======================================
' Check_Account
'======================================
Function Check_Account(nGbn)
	Dim szAcnt, szPwd
	
	szAcnt = Form.GetCtlProp("#acnt", "caption")
'    If Len(szAcnt) < 10 Then
'	    Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
'	    return False
'	End If
	
	if nGbn <> 2 then
		szPwd = Form.GetCtlProp("#edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function

'======================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'======================================
Function Calc_Price(nGbn)
	Dim szPrc, szUnit, szHigh, szLow, szHyun
	
	szPrc  = edtPrc.caption
	szUnit = Form.GetCtlProp("#lblUnit", "caption")
	szHigh = Form.GetCtlProp("#lblHigh", "caption")	
	szLow  = Form.GetCtlProp("#lblLow", "caption")
	szHyun = Form.GetCtlProp("#lblHyun", "caption")
	
	'=======================================================================
	'20221116 HWG START : (거래소 차세대) 호가단위 개선
	'=======================================================================
	'20231122 HSZ START:  (거래소 차세대) ETF,ETN 호가단위 개선
	'=======================================================================
	' ETN
	'=======================================================================
	if g_szMk == "Q" then
		if CDbl(szPrc) < 2000 then
			szUnit = 1
		elseif CDbl(szPrc) >= 2000 then
			szUnit = 5
		end if
	'=======================================================================
	' ELW
	'=======================================================================	
	elseif  g_szMk == "W" then
		szUnit = 5
		
	'=======================================================================
	' ETN/ELW 외
	'=======================================================================
	else
		szInnerMk = Form.GetItemCodeInfo(g_szCd, "innermarket")
		
		'=======================================================================
		' ETF
		'=======================================================================
		if szInnerMk = "013" then
			if CDbl(szPrc) < 2000 then
				szUnit = 1
			elseif CDbl(szPrc) >= 2000 then
				szUnit = 5
			end if
	'20231122 HSZ END
		'=======================================================================
		' KOTC
		'=======================================================================
'		elseif szInnerMk = "025" then
'			if CDbl(szPrc) < 1000 then
'				szUnit = 1
'			elseif (CDbl(szPrc) >= 1000 and CDbl(szPrc) < 5000) then
'				szUnit = 5 
'			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 10000) then
'				szUnit = 10
'			elseif (CDbl(szPrc) >= 10000 and CDbl(szPrc) < 50000) then
'				szUnit = 50
'			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 100000) then
'				szUnit = 100
'			elseif (CDbl(szPrc) >= 100000 and CDbl(szPrc)<  500000) then
'				szUnit = 500
'			elseif CDbl(szPrc) >= 500000 then
'				szUnit = 1000
'			end if
'			
'			if nGbn == 1 then
'				if CDbl(szPrc) = 1000 then
'					szUnit = 1
'				elseif CDbl(szPrc) = 5000 then
'					szUnit = 5 
'				elseif CDbl(szPrc) = 20000 then
'					szUnit = 10
'				elseif CDbl(szPrc) = 10000 then
'					szUnit = 50
'				elseif CDbl(szPrc) = 50000 then
'					szUnit = 100
'				elseif CDbl(szPrc) = 100000 then
'					szUnit = 500
'				elseif CDbl(szPrc) = 500000 then
'					szUnit = 1000
'				end if
'			end if
		
		'=======================================================================
		' KOSPI/KOSDAQ/KONEX/신주인수권/수익증권 등
		'=======================================================================
		else
			if CDbl(szPrc) < 2000 then
				szUnit = 1
			elseif (CDbl(szPrc) >= 2000 and CDbl(szPrc) < 5000) then
				szUnit = 5 
			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 20000) then
				szUnit = 10
			elseif (CDbl(szPrc) >= 20000 and CDbl(szPrc) < 50000) then
				szUnit = 50
			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 200000) then
				szUnit = 100
			elseif (CDbl(szPrc) >= 200000 and CDbl(szPrc) < 500000) then
				szUnit = 500
			elseif CDbl(szPrc) >= 500000 then
				szUnit = 1000
			end if
			
			if nGbn == 1 then
				if CDbl(szPrc) = 2000 then
					szUnit = 1
				elseif CDbl(szPrc) = 5000 then
					szUnit = 5 
				elseif CDbl(szPrc) = 20000 then
					szUnit = 10
				elseif CDbl(szPrc) = 50000 then
					szUnit = 50
				elseif CDbl(szPrc) = 200000 then
					szUnit = 100
				elseif CDbl(szPrc) = 500000 then
					szUnit = 500
				end if
			end if
		end if
	end if
	'20221116 HWG END
	
	' 이전소스
'	'=======================================================================
'	' 20190403 LES START 호가단위 설정
'	'=======================================================================
'	if g_szMk == "J" or g_szMk == "T" then
'			
'		szInnerMk = Form.GetItemCodeInfo(g_szCd, "innermarket")
'			
'		'-------------------------------------------------------------------
'		'코스닥, 코넥스
'		'-------------------------------------------------------------------
'		if szInnerMk == "002" or szInnerMk == "033" then
'			if CDbl(szPrc) < 1000 then
'				szUnit = 1
'			elseif (CDbl(szPrc) >= 1000 and CDbl(szPrc) < 5000) then
'				szUnit = 5 
'			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 10000) then
'				szUnit = 10
'			elseif (CDbl(szPrc) >= 10000 and CDbl(szPrc) < 50000) then
'				szUnit = 50
'			elseif CDbl(szPrc) >= 50000 then
'				szUnit = 100
'			end if
'		
'		'-------------------------------------------------------------------
'		'ETF
'		'-------------------------------------------------------------------
'		elseif szInnerMk = "013" then
'			szUnit = 5
'		
'						
'		'-------------------------------------------------------------------
'		'코스피, 신주인수권, 수익증권, K-OTC
'		'-------------------------------------------------------------------
'		else
'					
'			if CDbl(szPrc) < 1000 then
'				szUnit = 1
'			elseif (CDbl(szPrc) >= 1000 and CDbl(szPrc) < 5000) then
'				szUnit = 5 
'			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 10000) then
'				szUnit = 10
'			elseif (CDbl(szPrc) >= 10000 and CDbl(szPrc) < 50000) then
'				szUnit = 50
'			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 100000) then
'				szUnit = 100
'			elseif (CDbl(szPrc) >= 100000 and CDbl(szPrc) < 500000) then
'				szUnit = 500
'			elseif CDbl(szPrc) >= 500000 then
'				szUnit = 1000
'			end if
'					
'		end if
'		
'	'-------------------------------------------------------------------
'	'ETN, ELW
'	'-------------------------------------------------------------------
'	elseif g_szMk == "Q" or g_szMk == "W" then
'		szUnit = 5
'					
'	end if
'	'20190403 LES END
	
	
	
	'=======================================================================
	' +,- 버튼 클릭시 동작 
	'=======================================================================		
	
	
	' ----------------------------------------------------------------------
	' ELW
	' ----------------------------------------------------------------------		
	if g_szMk = "W" then
		if Trim(szUnit) = "" then
			szUnit = "5"
		end if

		if Trim(szPrc) = "" then
			szPrc = szHyun
		else
			' + 버튼 클릭 /////////////////////////////
			if nGbn = 0 then							
				szPrc = CDbl(szPrc) + CDbl(szUnit)
			' - 버튼 클릭 ////////////////////////////	
			elseif nGbn = 1 then					
				if CDbl(szPrc) = 0 then		' 0상태에서 "-"선택시 현재가로 복귀
					szPrc = szHyun
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if
			end if
		end if
		
	' ----------------------------------------------------------------------
	' 그외 (코스피, 코스닥, KOTC, ETF, ETN ..)
	' ----------------------------------------------------------------------		
	else
		if Trim(szUnit) = "" then
			szUnit = "1"
		end if
		
		if Trim(szPrc) = "" then
			szPrc = szHyun
		else
			' + 버튼 클릭 /////////////////////////////
			if nGbn = 0 then
			
			'20210216 SWJ START : 신주인수권 가격 +/- 버튼 입력오류 수정(상한가, 하한가 항상 0 이어서 생긴 오류)
				if Left(g_szCd, 1) == "J" then
					szPrc = CDbl(szPrc) + CDbl(szUnit)
					
					if szPrc <= 0 then
						szPrc = szHyun
					end if
				else
				
					if CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
						szPrc = szHigh
					elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀	
						szPrc = szLow
					else
						szPrc = CDbl(szPrc) + CDbl(szUnit)
					end if
				end if
			' - 버튼 클릭 ////////////////////////////
			elseif nGbn = 1 then
			
				if Left(g_szCd, 1) == "J" then
					szPrc = CDbl(szPrc) - CDbl(szUnit)
					
					if szPrc <= 0 then
						szPrc = szHyun
					end if
				else
					if CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
						szPrc = szHigh		
					elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
						szPrc = szLow
					else
						szPrc = CDbl(szPrc) - CDbl(szUnit)
					end if
				end if
			end if
			'20210216 SWJ END
		end if
	end if
	
	edtPrc.caption = szPrc
	
End Function

'======================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'======================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption

	
	if Trim(szQty) = "" then
		szQty = 1
	else
		if Len(szQty) = 1 or Len(szQty) = 2 then
			nUnit = 1
		else
			nCnt = Len(szQty)-1
			
			For i = 0 to nCnt-1
				if i = 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CDbl(szUnit)
		end if
		
		if nGbn = 0 then
			szQty = CDbl(szQty) + nUnit
		elseif nGbn = 1 then
			if CDbl(szQty) = 0 then
				Exit Function
			else
				szQty = CDbl(szQty) - nUnit
			end if
		end if
	end if
	
	edtQty.caption = szQty
End Function

'======================================
' Init_cmbCredit
'======================================
Function Init_cmbCredit(szChk)			
	Dim szList
	
	cmbCredit.currentindex = "0"					' 0으로 변경해야 die안됨
	Form.SetCtlProp("cmbCredit", "clear", "")		' 콤보 리스트 클리어
		
	if szChk = "1" then
		szList = "05`자기융자\r\n06`유통융자\r\n03`예탁담보"
		cldSell.visible = false
	else
		szList = "01`신용융자\r\n03`예탁담보"		
		cldSell.visible = true
	end if

	cmbCredit.cbinputdatatext = szList
End Function
	
'======================================
' Set_OrderPopup
'======================================
Function Set_OrderPopup()
	Dim szAcntfull, szAcntName, szType, szCondCd, szCLS, szOrdType
	
	szAcntfull    = Form.GetCtlProp("#acnt", "caption")
	szAcntName	= Form.GetCtlProp("#acnt", "accountname")

	'주문유형
	szType = Check_OrdType()
	
	' 주문조건 구분코드
	szCondCd = Check_CondCode()
	
	'주문유형에 따른 주문단가
	Select Case szType
		Case "05", "12", "13", "61", "71"					'시장가,최유리,최우선 주문
			szPrc = "0"
		Case Else
			szPrc = edtPrc.caption
			
			' HTS에서 가격없고, 가능금액조회시 현재가를 넣어준다.
			if Trim(szPrc) ="" and szTranID ="obtrs_comn_406r" then
				szPrc = Form.GetCtlProp("#lblHyun", "caption")
			end if
	End Select
	
	szCLS = rdoGbn.currentindex

	g_szPopupData = "12"															' 예약매도
	g_szPopupData = g_szPopupData & "|" & g_szMk										' 주문종류 ( J:주식, W:ELW )
	g_szPopupData = g_szPopupData & "|" & szAcntfull									' 계좌번호
	g_szPopupData = g_szPopupData & "|" & szAcntName									' 고객명
	g_szPopupData = g_szPopupData & "|" & g_szCd										' 종목코드
	g_szPopupData = g_szPopupData & "|" & Form.GetItemCodeInfo( g_szCd, "name")			' 종목명
	g_szPopupData = g_szPopupData & "|" & cmbType.caption								' 주문구분
	g_szPopupData = g_szPopupData & "|" & szCLS										' 현금/신용
	
	If szCLS = "0" Then
		g_szPopupData = g_szPopupData & "|" & ""										' 신용구분
		g_szPopupData = g_szPopupData & "|" & ""										' 대출일자
	Else
		g_szPopupData = g_szPopupData & "|" & cmbCredit.cbkeydata						' 신용구분
		
		'20211227 SWJ START : 신용대주 삭제
'		If cmbCredit.currentindex = "1" Then
'			g_szPopupData = g_szPopupData & "|" & ""										' 대출일자
'		Else
			g_szPopupData = g_szPopupData & "|" & cldSell.caption							' 대출일자
'		End If
		'20211227 SWJ END
	End If
	
	g_szPopupData = g_szPopupData & "|" & edtQty.caption								' 주문수량
	g_szPopupData = g_szPopupData & "|" & szPrc										' 주문가격
	g_szPopupData = g_szPopupData & "|" & ""											' 원주문번호
	g_szPopupData = g_szPopupData & "|" & ""											' 잔량전부
	
End Function

'============================================================================
' PrdCode : 조회구분코드
' 주문가능수량 obtrs_comn_405r 신용-매도가능수량조회인 경우에만 사용
'============================================================================
Function PrdCode()
	Dim szCd
	Dim szPrdCode
	szCd = Form.GetCtlProp("#acnt", "itemcodetype")
	
	Select Case szCd
		Case "100", "105", "107", "112","119", "140", "200" '20211207 SWJ START : 중개형 ISA 추가	'20230112_01 HWG : SUPER365 추가
		    szPrdCode = "1"
		Case "102", "108"	'저축계좌
		    szPrdCode = "2"
	End Select
	
	'20211210 HSZ START
	szGbn = int(rdoGbn.currentindex)
	If szGbn == 1 Then
		If int(cmbCredit.currentindex) == 0 Then		'20211227 SWJ START : 신용대주 구분 삭제
			szPrdCode = "4"
		Else
		    szPrdCode = "5"
		End If
	elseIf szGbn == 2 Then '대용매도
	    szPrdCode = "3"
	End If
	
	return szPrdCode
	'20211210 HSZ END
End Function

