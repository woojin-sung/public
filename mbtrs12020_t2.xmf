'======================================
' Init_InputControl : 주문후 초기화
'======================================
Function Init_InputControl()
	edtQty.caption = ""
	edtPrc.caption = ""
End Function

'======================================
' Load_OrderSet : 환경설정값 정의
'======================================
Function Load_OrderSet()
	' 환경설정값 정의
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szBtnMkt     = Form.LoadConfigData("SET_ORDER", "BTN_MARKET")				' 시장가 주문버튼
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력
	
	g_szSelPrc     = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELPRC")		' 매도주문가격 자동입력
	g_szSelQty     = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTY")		' 매도수량 자동입력
	g_szSelQtyCnt  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTYCNT")	' 매도수량 주수(수량입력 선택시)

	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 시장가 주문버튼(기본값 : 미사용)
	if Trim(g_szBtnMkt) = "1" then
		btnMkSell.visible = true
	else
		btnMkSell.visible = false
	end if	
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170919 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170919 HAMWG END

	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	' 매도주문가격 자동입력(기본값 : 사용하지 않음)
	if Trim(g_szSelPrc) = "" then
		g_szSelPrc = "0"		
	end if
	
	' 매도수량 자동입력(기본값 : 사용하지 않음)
	if Trim(g_szSelQty) = "" then
		g_szSelQty = "0"		
	end if
	
End Function


'======================================
' Set_rdoGbnCaption : nGbn(0:현금, 1:신용, 2: 대용)
'20160715 NOHES START 기간예약 지정 컨트롤 삽입
'======================================
Function Set_rdoGbnCaption(szGbn)
	tLoan = 277
	tCash = 232

	if szGbn = "1" then
		btnSell.caption = "신용매도"
		cmbCredit.visible = true
		'cldSell.visible = true
		cmbCredit.top = 232
		cldSell.top = 232
		
		cmbRange.top = tLoan
		btnRange.top = tLoan
		LblRange.top = tLoan + 35
		
	else
		If szGbn = "0" Then
			btnSell.caption = "현금매도"
		Else
			btnSell.caption = "대용매도"
		End If
		
		cmbCredit.top = 232
		cldSell.top = 232
		cmbCredit.visible = false
		cldSell.visible = false
		
		cmbRange.top = tCash
		btnRange.top = tCash
		LblRange.top = tCash + 35	

	end if
End Function
'20160715 NOHES END

'======================================
' Visible_Control : nGbn(유형)
'======================================
Function Visible_Control(nGbn)
	' 보통, 조건부지정가, 보통(IOC), 보통(FOK), 시간외단일가
	Select case nGbn
		case 0, 2, 5, 8, 13
			edtPrc.enable = true
			btnPrc.enable = true
			btnPPlus.enable = true
			btnPMinus.enable = true	
		case else
			edtPrc.caption = ""
			edtPrc.enable = false
			btnPrc.enable = false
			btnPPlus.enable = false
			btnPMinus.enable = false
	End Select
End Function

'======================================
' Set_OrdType : 종목코드에 따라 주문유형 설정
'======================================
Function Set_OrdType()
	Dim szMk
	
	szMk = Form.GetItemCodeInfo(g_szCd, "market")
	g_szInner = Form.GetItemCodeInfo(g_szCd, "innermarket")
	
	If szMk = "W" Then
		rdoGbn.currentindex = "0"
		rdoGbn.visible = False
	
	Else		
		
		If Trim(g_szInner) ="033" Then		' 코넥스
			rdoGbn.currentindex = "0"
			rdoGbn.enable = False
		Else
			rdoGbn.enable = True
		End If
		
		rdoGbn.visible = True

	End if
	
	if g_szMk <> szMk then
		cmbType.currentindex = "0"					' 0으로 변경해야 die안됨
		Form.SetCtlProp("cmbGroup", "clear", "")		' 콤보 리스트 클리어
	
		if Trim(g_szInner) ="033" then		' 코넥스
			szList = "00`보통\r\n01`시장가"
		else
			szList = "00`보통\r\n01`시장가\r\n02`조건부지정가"
		end if
		
		g_szMk = szMk
	end if

	cmbType.cbinputdatatext = szList
End Function

'======================================
' Check_OrdType : 주문유형확인
'======================================
Function Check_OrdType()
	Dim szIdx
	szIdx = CStr(cmbType.currentindex)
	
	if g_bBtnMkClk = true Then					'시장가 주문
		return "05"	
	elseIf g_szInner = "033" then				' 코넥스 
		Select Case szIdx
			Case "0"	'지정
				return "01"
			Case "1"	'시장
				return "05"
			Case "2"	'장후
				return "71"
		End Select
	elseIf g_szMk = "W" then					' ELW인경우 -  보통
		return "01"
	else '일반주문

		Select Case szIdx
			Case "0", "5", "8"	' 지정(일반, IOC, FOK)
				return "01"
			Case "1", "6", "9"	' 시장(일반, IOC, FOK)
				return "05"
			Case "2"				' 조건부
				return "06"
			Case "3", "7", "10"	' 최유리(일반, IOC, FOK)
				return "12"
			Case "4"				' 최우선
				return "13"   
			Case "11"			' 장전
				return "61"
			Case "12"			' 장후
				return "71"
			Case "13" 
				return "81" 		' 시간외단일가
		End Select 			
    End If
End Function

'======================================
' Check_CondCode : 주문조건 구분 확인
'======================================
Function Check_CondCode()
	Dim szIdx
	
	if g_bBtnMkClk = true Then					'시장가 주문
		return "0"
	elseIf g_szInner = "033" then				' 코넥스 
		return "0"		
	elseIf g_szMk = "W" then					'ELW인경우 -  보통
		return "0"
	else '일반주문
		szIdx = cmbType.currentindex

		Select Case szIdx
			Case "5", "6", "7"	' IOC
				return "3"
			Case "8", "9", "10"	' FOK
				return "4"
			Case Else
				return "0" 	
		End Select 			
    End If
End Function

'======================================
' Change_ItemCode
'======================================
Function Change_ItemCode()
	Dim szMk
	
	szMk = Form.GetItemCodeInfo(g_szCd, "market")

	if Left(g_szCd, 1) = "J" or Left(g_szCd, 1) = "F" then
		return g_szCd
	elseif szMk = "J" or szMk = "T" then	'주식
		return "A" & g_szCd
	elseif szMk = "W" then	'ELW
		return "J" & g_szCd
	else
		return g_szCd
	end if 
End Function

'======================================
' Check_InputData
'======================================
Function Check_InputData(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Check_Account(nGbn) = false then
		return false
	end if

	if Trim(g_szCd) = "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if
	
	if Trim(edtQty.caption) = "" or Trim(edtQty.caption) = "0" then
		Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
		return false
	end if
	
	if nGbn = 0 then
		szType = Check_OrdType()
		
		if szType = "01" or szType = "06" or szType = "81" then	' 지정, 조건부, 시간외단일가
			if Trim(edtPrc.caption) = "" or Trim(edtPrc.caption) = "0" then
				Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
				return false
			end if	
		end if
	end if	
		
	if nGbn <> 2 then	
		' 주문확인창 오픈여부
		if g_szOdrPop = "1" then
			Set_OrderPopup()
			
			If rdoGbn.currentindex = "1" Then
				Form.OpenPopup( "mbtrs12020_p5" , g_szPopupData , "")
			Else
				Form.OpenPopup( "mbtrs12020_p4" , g_szPopupData , "")
			End If
		else
			Request_Order()
		end if
	end if
	
	return true
End Function

'============================================================================
' Return_AutoQty
'============================================================================
Function Return_AutoQty()
	if g_szSelQty == "1" then		' 보유잔고수량
		Request_Able()
	elseif g_szSelQty == "2" then
		edtQty.caption = g_szSelQtyCnt
	end if
End Function

