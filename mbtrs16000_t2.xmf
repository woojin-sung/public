'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Load_OrderSet() '주문설정값 읽어오기
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "12000_HOGA" then
		if sParam <> "" then
			'주문유형에 따른 주문단가
			szType = Check_OrdType()
			
			if szType == "01" or szType == "06" or szType == "81" then		'지정, 조건부, 시간외 주문
				edtPrc.caption = sParam			
				edtPrc_OnEditComplete()
			end if	
		else
			edtPrc.caption = sParam
			edtPrc_OnEditComplete()
		end if
	' ----------------------------------------------------------------------
	' 메인화면에서 종목코드 받기/ 탭 체인지
	' ----------------------------------------------------------------------		
	elseif sEventName == "INIT_CODE" or sEventName == "CHNAGE_TAB" then
		if sEventName == "INIT_CODE" then
			Form.SetCtlProp("#edtOrgNo", "caption", "")
		end if
		
		' 20160407 예외처리 추가
		if g_szCd <> sParam then
			g_szCd = sParam
		
			Set_OrdType()					' 종목코드에 따라 주문유형 설정
		end if
		
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if
		
		'20170816 LES START - 주문유형콤보세팅 여기다가???
		szType = Form.GetSharedData("B_TYPE_DAEJU", false)		' 주문구분
		cmbType.currentindex = szType					' 주문구분 콤보박스 세팅
		'20170816 LES END
				
		
	' ----------------------------------------------------------------------
	' 자동가격입력
	' ----------------------------------------------------------------------		
	elseif sEventName == "AUTO_PRICE" then
		Dim szPrc
		
		'20170919 HAMWG START : 탭/종목 변경시 초기화 여부
		if g_szChangeInit <> "1" then		
			Return_AutoQty()
		end if
		'20170919 HAMWG END
		
		szPrc = Form.GetSharedData("HYUN_RETURN", true)
		Form.SetSharedData("HYUN_RETURN", "")
		
		if Trim(szPrc) <> "" and szPrc <> null then
			edtPrc.caption = szPrc
			edtPrc_OnEditComplete()
		else
			if Trim(sParam) <> "" then
				edtPrc.caption = sParam
				edtPrc_OnEditComplete()
			end if
		end if
	elseif sEventName == "16000_BALANCE_RETURN" then
		if Trim(sParam) <> "" and sParam <> null then
			g_bBalance = true
			
			'수량/대출일
			tData = Split(sParam, "♥")
			
			if UBound(tData) > 0 then
				edtQty.caption = CInt(tData(0))' 수량
				cldCredit.caption = tData(1)
				
				edtQty_OnEditComplete()
			end if
		end if
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			
			'20201117 LES START
			g_szWarnFlag = "A"
			
			
			'20200824 LES START 제도개선
			'if gWarnCd = "3" then
			'	g_szWarnFlag = "O"
			'elseif gWarnCd = "4"then
			'	g_szWarnFlag = "A"
			'elseif gWarnCd = "5" then
			'	g_szWarnFlag = "A"
			'else
			'	g_szWarnFlag = "Y"
			'end if
			'20200824 LES END
			
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	' ----------------------------------------------------------------------
	' 수량/금액입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		edtQty_OnEditComplete()
		

		'20160829_01 LKM START
'		 btnCash.btnimage = "btn_02.9.png"
'		 btnMax.btnimage  = "btn_02.9.png"
'		 Form.SetSharedData("B_QTY_TYPE" , "2")
		'20160829_01 LKM END		
		
	' ----------------------------------------------------------------------
	' 가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then		
		edtPrc.caption = sRet		
		edtPrc_OnEditComplete()
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCd, szType, szPrc, szCLS, szCLSCd, szCondCd
	
	' 종목코드
	szCd = Change_ItemCode()
		
	'주문유형
	szType = Check_OrdType()

	' 주문조건 구분코드
	szCondCd = Check_CondCode()
	
	' 대출일련번호
	if g_szLoanSrno = "" then
		szLoanSr = 1
	elseif g_szLoanSrno = 0 then
		szLoanSr = 1
	else
		szLoanSr = g_szLoanSrno
	end if
	
	' 대출일자
	szLoanDate = cldCredit.caption
	
	
	szIqry = "4" 		' 신용융자
	szLoanCd = "0104"	' 대주
	szCLSCd = "202"	' 대주매수
	
	' ----------------------------------------------------------------------
	' 대주상환 가능수량
	' ----------------------------------------------------------------------	
	if szTranID == "obtrs_comn_405r" then
		DATAMANAGER.ClearInputData(0, szTranID)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE" 		, 0, szIqry 								)' 조회구분코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acnt", "total")		)' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acnt", "sequence")	)' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD"				, 0, szCd								)' 종목코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD"			, 0, ""									)' 계좌비밀번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_DATE"			, 0, szLoanDate							)' 대출일자
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_SRNO"			, 0, szLoanSr								)' 대출일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_DTL_TYPE_CODE"	, 0, szLoanCd								)' 대출상세유형

	' ----------------------------------------------------------------------
	' 대주상환주문
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtrs_oder_231a" then
		g_szTR = szTranID
		DATAMANAGER.ClearInputData(0, szTranID)	
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0, Form.GetCtlProp("#acnt", "total"))	' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0, Form.GetCtlProp("#acnt", "sequence"))' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD", 0, Form.GetCtlProp("#edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD", 0, Form.GetCtlProp("#edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_ODER_CLS_CODE" 	, 0, cmbCredit.cbkeydata	)	' 신용구분 02:신용대주
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD" 				, 0, szCd				)	' 종목코드 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_UNPR" 			, 0, edtPrc.caption 		)	' 주문가격
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODQT" 				, 0, edtQty.caption 		)	' 주문수량
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_DATE" 			, 0, cldCredit.caption 	)	' 대출일자
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LOAN_SRNO" 			, 0, g_szLoanSrno			)	' 대출일련번호(01/02/05/06 : 1, 그외 : "")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_CLS_CODE" 		, 0, szType 				)	' 주문구분코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_COND_CLS_CODE"	, 0, szCondCd 			)	' 주문조건구분코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_WHOL_AMT_RDMP_YN" 	, 0, "N"					)	' 전체금액상환여부(대주주문은 전액상환방식 없음)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "WARN_CNFR_YN" 		, 0, g_szWarnFlag	 		)	' 경고확인여부 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_CLS_CODE" 		, 0, szCLSCd 				)	' 서비스구분코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CHAN_TYPE_CLS_CODE" 	, 0, "" 					)	' 채널유형구분
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01"				)	' 주문발생유형코드(01:일반주문)
		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szWarnMsg, szOrdCd, szOrdMsg, szOrgNo
	
	' ----------------------------------------------------------------------
	' 대주 상환주문
	' ----------------------------------------------------------------------	
	Select Case szTranID		
		Case "obtrs_oder_231a	"	
			
			'20200824 LES START 제도개선
			'경고구분코드 (0.정상, 1.경고, 2.보류  추가: 3.투자유의 4.투자유의+경고  5.투자유의+보류)
			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	
			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
			
			gWarnCd = szWarnCd
			'20200824 LES END
			
			'20201117 LES START 제도개선
			'20200824 LES START 제도개선
			Select Case szWarnCd
				
				Case "1","3","4","6","7","9","a","c","d","f","g"
					Open_ConfirmPopup(szWarnMsg)
				Case "2","5","8","b","e","h"
					g_szTR = ""
				Case Else
					g_szTR = ""
					
					szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
					szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)

					if Trim(szOrdCd) == "0001" then			' 정상주문
						Form.Toast(0, szOrdMsg, true)
					
						if g_szAfterInit == "1" then		' 주문후 초기화
							Init_InputControl()
						end if
					
						if g_szAfterOrg == "1" then			' 주문번호 연동
							szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
							Form.SetCtlProp("#edtOrgNo", "caption", szOrgNo)
						else
							Form.SetCtlProp("#edtOrgNo", "caption", "")
						end if
					
					end if
				
			End Select
			'20201117 LES END
	' ----------------------------------------------------------------------
	' 주문가능금액 조회
	' ----------------------------------------------------------------------	
		Case "obtrs_comn_405r"
			edtQty.caption = DATAMANAGER.GetDataValue(0, "obtrs_comn_405r", "OutBlock1", "ODER_ABLE_QTY", 0)
			edtQty_OnEditComplete()
	End Select
	
	g_szWarnFlag = "N"	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtrs_comn_405r" then
		Exit Sub
	end if
	
	Dim szSubMsg
	
	if szTranID == "obtrs_oder_231a" and szErrCode == "3271" then
		szSubMsg = "\n\n※ 등록방법\n- MTS: 뱅킹/대출 > 신용/대출 > 대주 위험고지 등록\n- HTS: [7495] 대주 위험고지 등록"
		
		Form.ShowAlert(g_szTitle, szErrMsg & szSubMsg)
		
	else
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if Trim(szSubMsg) <> "" then
			Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szTitle, szErrMsg)
		end if
	end if
End Sub

'============================================================================
' btnOrdBal_OnClick : 주문관련비용 계산
'============================================================================
Sub btnOrdBal_OnClick()
	Dim szType, szCode, szPrice, szInner, szInrMk, szAcnt, szAcntCd
	
	'계좌번호
	szAcnt   = Form.GetCtlProp("#acnt", "total")
	szAcntCd = Form.GetCtlProp("#acnt", "sequence")
	
	if Check_InputData(2) == false then
		Exit Sub
	end if

 	'시장구분
	if g_szInner == "002" then		'코스닥
	    szInrMk = "02"
	elseif g_szInner == "033" then	'코넥스
		szInrMk = "21"
	elseif g_szInner == "025" then  '프리보드 '20180820 LES START
		szInrMk = "03"
	else
		szInrMk = "01"
	end if
	
	'주문유형에 따른 주문단가
	szType = cmbType.cbkeydata
    
	Select Case szType
		Case "11"										' 장개시전시간외(전일종가)
			szPrice =  Form.GetCtlProp("#lblStd", "caption")
		Case "12"										' 시간외종가(현재가)
			szPrice =  Form.GetCtlProp("#lblHyun", "caption")
		Case "01", "03", "04", "06", "07", "09", "10" 		' 시장/최유리/최우선지정가
			szPrice =  Form.GetCtlProp("#lblHigh", "caption")		' 매수시(상한가), 매도시 ( 하한가 )	
		Case else
		    szPrice = edtPrc.caption
	    
			if edtPrc.caption = "0" or edtPrc.caption = "" then
				Form.ShowAlert(g_szTitle, "주문가격을 입력하세요")
				exit Sub
			end if	    
	End Select

    '종목코드
	szCode = Change_ItemCode()
	
    '계좌번호|채널유형|시장구분|매매구분(1매도, 2매수)|주문수량|주문단가|종목코드
    szData = szAcnt & "★" & szAcntCd & "★" & szInrMk & "★" & "2" & "★" & edtQty.caption & "★" & szPrice & "★" & szCode
    
    Form.OpenPopup("mbtrs12000_pc" , szData , "")
End Sub

'============================================================================
' btnBuy_OnClick : 매수버튼 클릭
'============================================================================
Sub btnBuy_OnClick()
	g_bBtnMkClk = false
	
	Check_InputData(0)
End Sub

'============================================================================
' btnCash_OnClick : 대주잔고버튼 클릭
'============================================================================
Sub btnBalance_OnClick()
	Form.triggerEvent("#", "16000_BALANCE_OPEN", "")
End Sub

'============================================================================
' btnQPlus_OnClick : 수량 + 버튼
'============================================================================
Sub btnQPlus_OnClick()	
	Calc_Qty(0)
End Sub

'============================================================================
' btnQMinus_OnClick : 수량 - 버튼
'============================================================================
Sub btnQMinus_OnClick()
	Calc_Qty(1)
End Sub

'============================================================================
' btnPPlus_OnClick : 가격 + 버튼
'============================================================================
Sub btnPPlus_OnClick()
	Calc_Price(0)
End Sub

'============================================================================
' btnPMinus_OnClick : 가격 - 버튼
'============================================================================
Sub btnPMinus_OnClick()
	Calc_Price(1)
End Sub

'============================================================================
' btnQty_OnClick
'============================================================================
Sub btnQty_OnClick()
	Dim szPrc, szData

	if Trim(edtPrc.caption) <> "" then
		szPrc = edtPrc.caption
	else
		szPrc = Form.GetCtlProp("#lblHyun", "caption")
	end if

	' 종목코드
	szCd = Change_ItemCode()
		
	'주문유형
	szType = Check_OrdType()
	
	szData = "0★" & edtQty.caption & "★" & g_szMk & "★" & szPrc
	szData = szData & "♥" & Form.GetCtlProp("#acnt", "total")			' 계좌번호(8)
	szData = szData & "♥" & Form.GetCtlProp("#acnt", "sequence")		' 계좌일련번호(2)
	'szData = szData & "♥" & Form.GetCtlProp("#edtPwd", "encdata")		' 계좌비밀번호
	szData = szData & "♥" & ""										' 계좌비밀번호
	szData = szData & "♥" & szCd									' 종목코드
	szData = szData & "♥" & szType									' 주문구분코드
	szData = szData & "♥" & "2"									' 매매구분코드(매수)
	szData = szData & "♥" & "1"									' 조회구분코드
	
	Form.OpenPopup("mbtrs12000_p1", szData, "")
End Sub

'============================================================================
' btnPrc_OnClick
'============================================================================
Sub btnPrc_OnClick()
	Dim szUnit, szHigh, szLow
	
	szUnit = Form.GetCtlProp("#lblUnit", "caption")
	szHigh = Form.GetCtlProp("#lblHigh", "caption")	
	szLow  = Form.GetCtlProp("#lblLow", "caption")
	
	Form.OpenPopup("mbtrs12000_p2" , edtPrc.caption & "★" & g_szCd & "★" & g_szMk & "★" & szUnit & "★" & cmbType.currentindex & "★" & szHigh & "★" & szLow, "")
End Sub


'============================================================================
' cmbType_OnEditComplete
'============================================================================
Sub cmbType_OnEditComplete(iIndex)
	Form.SetSharedData("B_TYPE_DAEJU", cmbType.currentindex)
	Form.SetSharedData("STOCK_BUYTYPE", cmbType.cbkeydata)
	Form.triggerEvent("#", "12000_BUYTYPE", "")
	Visible_Control(CInt(cmbType.cbkeydata))
	
	'20190806 LES START
	if CInt(cmbType.cbkeydata) == 11 then
		Label0.visible = true
	else
		Label0.visible = false
	end if
	'20190806 LES END
	
End Sub

'============================================================================
' edtPrc_OnEditComplete
'============================================================================
Sub edtPrc_OnEditComplete()
	Form.SetSharedData("B_PRC_DAEJU", edtPrc.caption)
	Form.SetCtlProp("#lblPrc", "caption", edtPrc.caption)
End Sub

'============================================================================
' edtQty_OnEditComplete
'============================================================================
Sub edtQty_OnEditComplete()
	Form.SetSharedData("B_QTY_DAEJU", edtQty.caption)
End Sub





