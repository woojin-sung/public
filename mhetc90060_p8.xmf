'============================================================================
Sub Form_OnFormClose()	
	Form.SetSharedData( "CERT_ID" , "")
	Form.SetSharedData( "CERT_ACNO" , "")
	
	If g_sIDNextPopup == "mhetc90060_motp" Then
		Form.SendReturnToParent( "mhetc90060_motp" , g_sRetData )
	Else
		Form.SendReturnToParent( "mhetc90060_p8" , g_sRetData )
		
		'20240502 SWJ START
		'mhetc90060_p8 과 통합하는 것이므로 혹시 몰라 추가 함
		Form.SendReturnToParent( "mhetc90060_p11" , g_sRetData )
		'20240502 SWJ END
	End If
End Sub


'16-03-08 YCJ 추가
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	
	if sTimerID == "0" or sTimerID == 0 then
		Form.SetTimerEvent( 0 , 0, 2)
		g_nTryCnt = g_nTryCnt+1
		if g_nTryCnt > 20 then			'1분 30~40초 정도만 적용해놓음
'			g_nTryCnt = 0
'			ButtonARS.enable = true
			Form.OpenPopup( "mhetc90060_p10" , "" , sPosInfo)
			Exit Sub
'			Form.MsgBox( "안내", "ARS인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
		end if
			
		DATAMANAGER.RequestTranData( "obcsb_oimf_612r" ) 'ARS인증검증
		
	end if	
	
	'20240429 SWJ START
	if Cint(sTimerID) == 1 then
		Form.SetTimerEvent2(1, 0, 0.2)
		contSMS.EditSMSNum.SetShowKeypad(True)
	end if
	'20240429 SWJ END
End Sub

