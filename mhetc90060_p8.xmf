				next
			end if
		elseif g_szList(0) == "sale_loan" then	'매도담보대출
'			Dim szSAccName
'			szSAccName = Form.GetSharedData( "Sale_Name", false )
			
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "05" ) '이체
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "08" ) '매도담보대출 단건
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_611a", "InBlock1", "UI_TOTAL_CSNU" , 0 , "1")	'총건수
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TACT_AMT" , i , g_szSaleMoney ) '대출금액
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "RMT_NAME" , 0 , g_szYeName ) '계좌명
		'---------------------------------------------------
		' 간편인증 2CH 인증시						16-09-08 NOHES 추가
		'---------------------------------------------------			
		elseif g_szList(0) == "spinpad_enroll" then	'spinpad 변경
			if g_szSubtype == "JOIN" or  g_szSubtype == "AddID" then
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "07" )  '간편인증관리
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "14" ) '간편인증 등록
			elseif g_szSubtype == "Change" then
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "07" ) '간편인증관리
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "15" ) '간편인증 변경
			elseif g_szSubtype == "Cancel" then
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "07" ) '간편인증관리
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , "16" ) '간편인증 해지				
			end if
		elseif g_szList(0) == "bank_opn" then		'v006
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE" , 0 , "12" ) '이체
			
			g_szTRANSTYPE = Form.GetSharedData("BANK_TRANSTYPE", false )
			
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TR_TYPE_CODE1" , 0 , g_szTRANSTYPE ) 
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_MNRC_BANK_NAME" , 0 , grd0.GetCellData( "bd_cell1", 0) ) '입금은행코드
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "RMT_NAME" , i , grd0.GetCellData( "bd_cell2", 0 ) ) '수취인명
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TACT_AMT" , i , grd0.GetCellData( "bd_cell3", 0) ) '이체금액
			DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_611a", "InBlock1", "UI_TOTAL_CSNU" , 0 , "1")	'총건수
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "UI_RPTT_THNM" , 0 , 0 ) '반복개수
		end if
	elseif szTranID == "obcsb_oimf_612r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_612r", "InBlock1", "PROS_CLS" , 0 , "1" ) '미사용
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_612r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_612r", "InBlock1", "ACNO" , 0 , g_sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_612r", "InBlock1", "ARS_ATHN_TLMS_UNIQ_NO" , 0 , g_sARSSeqNo )
	end if
	
	'20240429 SWJ START
	if szTranID == "obcsb_acif_005r" then
		
		sRcnoPip = Form.GetSharedData("CLOUD_CERT_RCNO_PIP" , false )
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_acif_005r", "InBlock1", "PROS_CLS_CODE", 0 , "4")		
		DATAMANAGER.SetDataValue( 0 , "obcsb_acif_005r", "InBlock1", "RCNO_PIP", 0 , sRcnoPip)		
	end if
	
	if szTranID == "obcsb_oimf_609r" then
	
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_609r", "InBlock1", "PROS_CLS" ,			0 , "1" ) 			'처리구분
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_609r", "InBlock1", "ELFN_ID"  , 		0 , g_sUserID ) 			'ID
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_609r", "InBlock1", "ACNO", 				0 , g_sACNO ) 			'계좌번호 
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_609r", "InBlock1", "UI_CUST_ATHN_NO"	,	0 , Trim(contOnce.EditOnceNum.caption) )	'1회용인증번호
		
		'단말ONLY 미지정단말일 경우에만 처리구분코드를 넘긴다.
		if  g_sRevData == "new_otp" or g_sRevData = "regi_otp" then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_609r", "InBlock1", "PROS_CLS_CODE" ,		0 , "1" )
		end if
		'20170424 LES END
	end if
	'20240429 SWJ END
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_638r" then
		Dim sCLPH_ARCD, sCLPH_TONO, sCLPH_SRNO, sOWHS_ARCD, sOWHS_TONO, sOWHS_TLPH_SRNO, sWRPL_TLPH_ARCD, sWRPL_TLPH_TONO, sWRPL_TLPH_SRNO
		sCLPH_ARCD = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "CLPH_ARCD" , 0 )
		sCLPH_TONO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "CLPH_TONO" , 0 )
		sCLPH_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "CLPH_SRNO" , 0 )
		
		sOWHS_ARCD = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "OWHS_ARCD" , 0 )
		sOWHS_TONO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "OWHS_TONO" , 0 )
		sOWHS_TLPH_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "OWHS_TLPH_SRNO" , 0 )
		
		sWRPL_TLPH_ARCD = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "WRPL_TLPH_ARCD" , 0 )
		sWRPL_TLPH_TONO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "WRPL_TLPH_TONO" , 0 )
		sWRPL_TLPH_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_638r", "OutBlock1", "WRPL_TLPH_SRNO" , 0 )
		
		if sCLPH_ARCD ~= null and Trim(sCLPH_ARCD) ~= "" then
			contARS.ComboARS.cbadddatatext = sCLPH_ARCD..sCLPH_TONO..sCLPH_SRNO.."`"..sCLPH_ARCD.."-"..GetMaskNumber(sCLPH_TONO).."-"..GetMaskNumber(sCLPH_SRNO)
			contSMS.EditSMSPhone.caption = sCLPH_ARCD.."-"..GetMaskNumber(sCLPH_TONO).."-"..GetMaskNumber(sCLPH_SRNO)
		end if
		
		if sOWHS_ARCD ~= null and Trim(sOWHS_ARCD) ~= "" then
			contARS.ComboARS.cbadddatatext = sOWHS_ARCD..sOWHS_TONO..sOWHS_TLPH_SRNO.."`"..sOWHS_ARCD.."-"..GetMaskNumber(sOWHS_TONO).."-"..GetMaskNumber(sOWHS_TLPH_SRNO)
		end if
		
		if sWRPL_TLPH_ARCD ~= null and Trim(sWRPL_TLPH_ARCD) ~= "" then
			contARS.ComboARS.cbadddatatext = sWRPL_TLPH_ARCD..sWRPL_TLPH_TONO..sWRPL_TLPH_SRNO.."`"..sWRPL_TLPH_ARCD.."-"..GetMaskNumber(sWRPL_TLPH_TONO).."-"..GetMaskNumber(sWRPL_TLPH_SRNO)
		end if
	elseif szTranID == "obcsb_oimf_613a" then
		g_sSMSSeqNo = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_613a", "OutBlock1", "NICE_ISTU_TLMS_MNNO" , 0 )
	elseif szTranID == "obcsb_oimf_615r" then
		if g_sRevData == "mobile_enroll" or g_sRevData == "mobile_cancel" then
			Form.SetSharedData("MobileCertRadio" , "1")
			Form.SetSharedData("MobileCertNumber" , contSMS.EditSMSNum.caption)
		end if
		
		'20240502 SWJ START
		 '인증완료 메시지 표시
		'contSMS.EditSMSNum.SetResultLabel("1","complete","인증되었습니다.","")
		'20240502 SWJ END
		
		if g_bIsFromIDReg == True then	'은행/지점개설계좌 ID등록, 모바일OTP 화면에서 팝업시 v007
			If g_sIDNextPopup == "mhetc90060_motp" Then
				Form.OpenPopup( g_sIDNextPopup , "motp_success" , sPosInfo)
			Else
				Form.OpenFramePopup( g_sIDNextPopup , g_sSendData , sPosInfo)
			End If
		else
			g_sRetData = "ok"
			Form.CloseForm( )
		end if
		
	elseif szTranID == "obcsb_oimf_611a" then
		g_sARSSeqNo = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_611a", "OutBlock1", "ARS_ATHN_TLMS_UNIQ_NO" , 0 )
		Form.SetTimerEvent( 0 , 1, 5)			'16-03-08 YCJ 추가, 현재 사용 안되고 있음 확인 필요
	elseif szTranID == "obcsb_oimf_612r" then
		if g_sRevData == "mobile_enroll" or g_sRevData == "mobile_cancel" then
			Form.SetSharedData("MobileCertRadio" , "3")
		end if
		
		if g_bIsFromIDReg == True then	'은행/지점개설계좌 ID등록, 모바일 OTP 화면에서 팝업시 v007
			If g_sIDNextPopup == "mhetc90060_motp" Then
				Form.OpenPopup( g_sIDNextPopup , "motp_success" , sPosInfo)
			Else
				Form.OpenFramePopup( g_sIDNextPopup , g_sSendData , sPosInfo)
			End If
		else
			g_sRetData = "ok"
			Form.CloseForm( )
		end if
	end if
	
	'20240429 SWJ START
	if szTranID = "obcsb_acif_005r" then
		'고객구분코드 
		' 1 : 개인, 2: 법인
		g_sCONO = DATAMANAGER.GetDataValue( 0 , "obcsb_acif_005r", "OutBlock1", "CUST_CLS_CODE", 0 )
		
		Form.SetSharedData("CERT_CUST_CLS_CODE" , g_sCONO)
	end if 
	
	if szTranID == "obcsb_oimf_609r" then
		g_sRetData = "ok"
		Form.CloseForm( )
	end if
	'20240429 SWJ END
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obcsb_oimf_615r" then
		if szErrCode == "3021" then '수신대기중
			g_nTryCnt = g_nTryCnt+1
			if g_nTryCnt < 10 then
				DATAMANAGER.RequestTranData( "obcsb_oimf_615r" ) 'SMS인증번호검증
			else
				g_nTryCnt = 0
				
				'20240429 SWJ START
				'Form.MsgBox( "안내", "SMS인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
				contSMS.EditSMSNum.SetResultLabel("1","error", "SMS인증에 실패하였습니다." ,"")
				'20240429 SWJ END
		
			end if
		else '인증실패
			g_nTryCnt = 0

			'20240429 SWJ START
			'Form.MsgBox( "안내", "SMS인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
			contSMS.EditSMSNum.SetResultLabel("1","error", "SMS인증에 실패하였습니다." ,"")
			'20240429 SWJ END
		end if
	'16-03-08 YCJ 수정 내용
	elseif szTranID == "obcsb_oimf_611a" then
		contARS.ButtonARS.enable = true
	elseif szTranID == "obcsb_oimf_612r" then
		if szErrCode == "3021" then '수신대기중
			Form.SetTimerEvent( 0, 1, 5)
		else
			Form.OpenPopup( "mhetc90060_p10" , "" , sPosInfo)
		end if
	elseif szTranID == "obcsb_oimf_613a" then
		
		'20240429 SWJ START
		if szErrMsg <> "" then
			contSMS.EditSMSNum.SetResultLabel("1","error", szErrMsg ,"")
		end if
		'20240429 SWJ END
		
		Form.ShowAlert("알림", szErrMsg)
		
'			g_nTryCnt = g_nTryCnt+1
'			if g_nTryCnt < 8 then
'				DATAMANAGER.RequestTranData( "obcsb_oimf_612r" ) 'ARS인증검증
'			else
'				g_nTryCnt = 0
'				ButtonARS.enable = true
'				Form.SetTimerEvent(0, 0, 5)
'				Form.OpenPopup( "mhetc90060_p10" , "" , sPosInfo)
''				Form.MsgBox( "안내", "ARS인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
'			end if
'		else
'			g_nTryCnt = 0
'			ButtonARS.enable = true
'			Form.SetTimerEvent(0, 0, 5)
'			Form.OpenPopup( "mhetc90060_p10" , "" , sPosInfo)
'		end if
'	end if

'	elseif szTranID == "obcsb_oimf_611a" then		'16-03-08 YCJ 수정전 원본
'		ButtonARS.enable = true
'	elseif szTranID == "obcsb_oimf_612r" then
'		if szErrCode == "3021" then '수신대기중
'			g_nTryCnt = g_nTryCnt+1
'			if g_nTryCnt < 40 then
'				DATAMANAGER.RequestTranData( "obcsb_oimf_612r" ) 'ARS인증검증
'			else
'				g_nTryCnt = 0
'				ButtonARS.enable = true
'				Form.MsgBox( "안내", "ARS인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
'			end if
'		else
'			g_nTryCnt = 0
'			ButtonARS.enable = true
'			Form.MsgBox( "안내", "ARS인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
'		end if
	
	'1회용인증번호 
	elseif szTranID == "obcsb_oimf_609r" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
		
	end if
End Sub
 
 '============================================================================
Sub RadioGroup0_OnClick(nIndex)
	contSMS.ButtonSMS.enable = false
	contSMS.EditSMSNum.enable = false
	contARS.ComboARS.enable = false
	contARS.ButtonARS.enable = false
	EditNum.enable = false
	
	if nIndex == 0 then 'SMS인증
		contSMS.ButtonSMS.enable = true
	elseif nIndex = 1 then 'ARS인증
		contARS.ComboARS.enable = true
		contARS.ButtonARS.enable = true
	else '해외체류자인증면제/1회용인증번호
		if nIndex = 2 then
			EditNum.enable = true
		end if
		if g_sRevData == "mobile_enroll" then
			EditNum.enable = true
		end if
	end if 
End Sub

'============================================================================
Sub contSMS_ButtonSMS_OnClick()
	if contSMS.EditSMSPhone.caption == null or contSMS.EditSMSPhone.caption == "" then
		Form.MsgBox( "안내", "고객 연락처 변경 화면에서 휴대폰 번호를 입력하신 후 사용 가능합니다.", "", 6 )
	else
		g_nTryCnt = 0
		g_sSMSSeqNo = ""
		contSMS.EditSMSNum.visible = True
		contSMS.EditSMSNum.enable = True
		contSMS.LblSMSNotice.visible = True
		ButtonNext.enable = True
		
		Form.SetTimerEvent2(1, 1, 0.2)
		
		DATAMANAGER.RequestTranData( "obcsb_oimf_613a" ) ''인증번호요청조회
	end if
End Sub

'============================================================================
Sub contARS_ButtonARS_OnClick()
	if contARS.ComboARS.caption == null or contARS.ComboARS.caption == "" then
		Form.MsgBox( "안내", "고객 연락처 변경 화면에서 휴대폰 번호를 입력하신 후 사용 가능합니다.", "", 6 )
	else
		g_nTryCnt = 0
		g_sARSSeqNo = ""
		contARS.ButtonARS.enable = false
		
		DATAMANAGER.RequestTranData( "obcsb_oimf_611a" ) ''ARS요청조회
	end if
End Sub

