Sub Form_OnFormInit()
	g_bIsFromIDReg = False
	g_nTryCnt = 0
	g_sSMSSeqNo = ""
	g_sARSSeqNo = ""
	g_sRetData = "cancel"
	RadioGroup0.height = "250"
	g_sMacAddress = Form.GetSharedData("&MAC_ADDRESS", false )
	
	'2016-11-21 HWG Start - 상황별 문구 수정
	'Label2.visible = true
	'cont0.visible = false
	'cont1.visible = true
	'cont2.visible = false
	'cont3.visible = false
	'cont4.visible = false
	'cont5.visible = false
	'cont6.visible = false 'v006
	'contMOTP.visible = False
	'2016-11-21 HWG End 
	
	'20240502 SWJ START
	'초기 UI
	AddAuthenticationUI(0)
	contSMS.EditSMSNum.SetApplyLabel("인증번호" 		, 0, 267, "left", false)  'True.필수입력 / False.선택입력
	contARS.EditARSNum.SetApplyLabel("인증번호" 		, 0, 267, "left", false)  'True.필수입력 / False.선택입력
	contOnce.EditOnceNum.SetApplyLabel("인증번호" 	, 0, 267, "left", false)  'True.필수입력 / False.선택입력
	contSMS.EditSMSNum.SetUseResultLabel(True, 1)
	contARS.EditARSNum.SetUseResultLabel(True, 1)
	contOnce.EditOnceNum.SetUseResultLabel(True, 1)
	
	'ARS 인증 시 구분을 위해 필요하지만
	'FormInit에서 미리 호출
	DATAMANAGER.RequestTranData( "obcsb_acif_005r" ) '개인/법인 구분
	'20240502 SWJ END
	
	g_sSendData = Form.GetOpenLinkData()

	g_szList = Split(g_sSendData,"★")	
	g_szMoneySum = 0
	'---------------------------------------------------
	'그외 화면에서 팝업시
	'---------------------------------------------------
	if UBOUND(g_szList) < 1 then

		g_sUserID = Form.GetSharedData("CERT_ID" , false)
		
		if g_sUserID == null or g_sUserID == "" then
			g_sUserID = Form.GetSharedData("&USER_ID" , false)
		end if
		
		g_sACNO = Form.GetSharedData("CERT_ACNO" , false)
		
		G_IP_CONFIRM_FILE = "mhetc90060_pc" 
		
		'20240502 SWJ START
		CloudOrNotUI(0, "추가인증")		
		
		'1회용 인증방식 미사용(디폴트는 미사용)
		g_bOnceOrNot = AuthOnceOrNotUI(False, False)
		'20240502 SWJ END
		
		g_sRevData = Form.GetOpenLinkData( )

		'16-04-11 YCJ 공인인증서 타기관 등록시 추가 - 전요셉 과장님 요청
	'	20240502 SWJ START : "new_otp", "regi_otp" 추가 (mhetc90060_p11과 통합하면서 추가한 것)
		if g_sRevData == "new" or g_sRevData == "regi" or g_sRevData == "new_otp" or g_sRevData = "regi_otp" then
			RadioGroup0.SetRadioCaption( 2, "1회용 인증번호" )
			Label2.caption = "(영업점에서 발급받은 1회용 인증번호 6자리를 입력)"
			EditNum.visible = true
			
			'1회용 인증방식 사용
			
			'클라우드 인증 화면에서 넘어올 때
			g_sCloudScrPoint = Form.GetSharedData("CLOUD_ADD_AUTH_FLAG", true )
			
			if g_sCloudScrPoint== "new" then
				CloudOrNotUI(1, "클라우드인증서 발급/재발급")
			elseif g_sCloudScrPoint == "regi" then
				CloudOrNotUI(1, "타기관 클라우드인증서 등록")
			end if
	
			g_bOnceOrNot = AuthOnceOrNotUI(True, False)
			
			'2016-11-21 HWG Start - 상황별 문구 수정
			'Label2.visible = true
	         'cont0.visible = true
			'cont1.visible = false
			'cont2.visible = false
			'cont3.visible = false
			'cont4.visible = false
			'cont5.visible = false
			'cont6.visible = false 'v006
			'contMOTP.visible = False
			'2016-11-21 HWG End
			
			RadioGroup0.height = "319"
			
			'20170418 LES START- 미지정단말 프로세스 추가
			if g_sRevData == "new_otp" or g_sRevData =="regi_otp" then
				RadioGroup0.currentindex = 2
				RadioGroup0.enable = false
			end if
			'20170418 LES END
			
		'SMS인증/ARS인증/해외 체류자 인증면제
		elseif g_sRevData == null or g_sRevData == "" then		
			g_sRevData = "new"
		'SMS인증/ARS인증			,'16-03-08 YCJ OTP 해지일때 경우 추가
		'v0004 otp 사고해지 추가, v007 motp추가
		'v008 추가..
		elseif g_sRevData == "contact_regi" or g_sRevData == "contact_modi" or g_sRevData == "contact_del" or
			g_sRevData == "otp" or g_sRevData == "bank_monthlyD" or g_sRevData == "otp_acci" or
			g_sRevData == "svc_ins" or g_sRevData == "svc_canc" or g_sRevData == "svc_mod" then	'g_sRevData == "regi" or 
			'해외체류자인증면제 숨김
			RadioGroup0.height = "170"
			
			'2016-11-21 HWG Start - 상황별 문구 수정
			'Label2.visible = false
	         'cont0.visible = false
			'cont1.visible = false
			'cont2.visible = false
			'cont3.visible = true
			'cont4.visible = false
			'cont5.visible = false
			'cont6.visible = false 'v006
			'contMOTP.visible = False
			'2016-11-21 HWG End
		ElseIf g_sRevData == "motp" Then
			'Label2.visible = false
			'cont0.visible = false
			'cont1.visible = false
			'cont2.visible = false
			'cont3.visible = false
			'cont4.visible = false
			'cont5.visible = false
			'cont6.visible = false 'v006
			'contMOTP.visible = True
		'SMS인증/ARS인증  16-03-31 YCJ 정기이체시 안내문구 수정됨.
		elseif g_sRevData == "bank_monthly" then
			'해외체류자인증면제 숨김
			RadioGroup0.height = "213"
			
			'2016-11-21 HWG Start - 상황별 문구 수정
			'Label2.visible = false
	         'cont0.visible = false
			'cont1.visible = false
			'cont2.visible = false
			'cont3.visible = false
			'cont4.visible = true
			'cont5.visible = false			
			'cont6.visible = false 'v006
			'contMOTP.visible = False
			'2016-11-21 HWG End
			
		'SMS인증/ARS인증  16-03-31 YCJ 이용단말 추가 해지시 안내문구 수정됨.
		elseif g_sRevData == "mobile_cancel" then
			'해외체류자인증면제 숨김
			RadioGroup0.height = "170"
			
			'2016-11-21 HWG Start - 상황별 문구 수정
			'Label2.visible = false
	         'cont0.visible = false
			'cont1.visible = false
			'cont2.visible = true
			'cont3.visible = false
			'cont4.visible = false
			'cont2.height = 280
			'cont2.top = 253
			'cont5.visible = false
			'cont6.visible = false 'v006
			'contMOTP.visible = False
			'2016-11-21 HWG End
		
		'mhetc90060_p11에서 바이오인증 관련 절차 옮김
		elseif g_sRevData == "bio_new" then
			
			'20180802 LES START - 바이오인증 등록절차 변경
