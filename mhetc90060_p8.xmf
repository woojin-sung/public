'============================================================================
' 전화번호 마스킹처리함수
'============================================================================
Function GetMaskNumber(sNum)
	if sNum == null or Trim(sNum) == "" then
		return sNum
	end if
	
	if #sNum <= 2 then
		return sNum
	end if
	
	Dim sMaskNum
	sMaskNum = Left(sNum, 2)
	for i = 1 to #sNum-2 
		sMaskNum = sMaskNum.."*"
	next
	
	return sMaskNum
End Function

