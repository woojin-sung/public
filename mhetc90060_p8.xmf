'============================================================================
'1회용 인증번호 사용 여부에 따른 UI
'두번째 파라미터는 인증서 인증인지 1회용 인증번호 인지 확인한다
Function AuthOnceOrNotUI(bUse, bAuthUse)
	
	'1회용 인증번호 사용
	if bUse then
		contHeader.LblOnceAuth.visible = True
		contHeader.ImgOnceAuth.visible = True
		contHeader.ImgOversea.left = 284
		contHeader.LblOverSea.left = 284
	'1회용 인증번호 미사용
	else
		contHeader.LblOnceAuth.visible = False
		contHeader.ImgOnceAuth.visible = False
		contHeader.ImgOversea.left = 181
		contHeader.LblOverSea.left = 181
	end if
	
	if bAuthUse then
		contHeader.LblOnceAuth.caption = "인증서 인증"
		
		return false
	else
		contHeader.LblOnceAuth.caption = "1회용인증번호"
	end if
	
	return true
End Function
'============================================================================
'인증방식 클릭될 때 UI
Sub AddAuthenticationUI(nParam)
	
	contHeader.ImgSMS.imgpath = "btn_line2_n.9.png"
	contHeader.ImgARS.imgpath = "btn_line2_n.9.png"
	contHeader.ImgOnceAuth.imgpath = "btn_line2_n.9.png"
	contHeader.ImgOversea.imgpath = "btn_line2_n.9.png"
	contARS.ComboARS.imagefilepth = "btn_line2_d.9.png"
	
	ButtonNext.enable = False
	ButtonNext.caption = "다음"
	
	contSMS.visible = False
	contARS.visible = False
	contOnce.visible = False
	contOverSea.visible = False
	contCertAuth.visible = False
	
	Select Case nParam
	
	'SMS 인증
	Case 0
		contSMS.visible = True
		contHeader.ImgSMS.imgpath = "btn_line2_o.9.png"
		
	'ARS 인증
	Case 1
		contARS.visible = True
		contHeader.ImgARS.imgpath = "btn_line2_o.9.png"
		ButtonNext.caption = "ARS 인증 요청"
		ButtonNext.enable = True
		
		'법인
		if g_sCONO == "2" then
			contARS.TableInDiv.visible = False
			contARS.TableExecut.visible = True
			contARS.BtnApha.visible = False
			contARS.LblChangeNumber.visible = False
		'개인
		else
			contARS.TableInDiv.visible = True
			contARS.TableExecut.visible = False
			contARS.BtnApha.visible = True
			contARS.LblChangeNumber.visible = True
		end if
		
	'1회용 인증번호
	Case 2
		contHeader.ImgOnceAuth.imgpath = "btn_line2_o.9.png"
		
		if g_bOnceOrNot then
			contOnce.visible = True
			contCertAuth.visible = False
			contOnce.EditOnceNum.enable = True
		else
			contOnce.visible = False
			contCertAuth.visible = True
			ButtonNext.enable = True
		end if
		
	'해외 체류자
	Case 3
		contOverSea.visible = True
		ButtonNext.enable = True
		contHeader.ImgOversea.imgpath = "btn_line2_o.9.png"
		
	End Select
	
End Sub
'============================================================================
'클라우드 인증서 발급 UI일 때랑 아닐 때로 구분
'타이틀 영역만 다름
Sub CloudOrNotUI(nParam, sParam)
	
	if nParam == 1 then
		
		contHeader.top = 95
		labTitle.visible = True
		labTitle0.visible = True
		
		'labTitle.caption = "클라우드인증서 발급/재발급"
		
		if sParam <> "" then
			labTitle.caption = sParam
			'Form.SetScreenName(sParam)
		else
			labTitle.caption = "추가인증"
			'Form.SetScreenName("클라우드인증서 발급/재발급")
		end if
		
		ImgBackPress.visible = True
		ImgClose.visible = False
		
		contSMS.top = 135 + 40
		contARS.top = 135 + 40
		contOnce.top = 135 + 40
		contOverSea.top = 135 + 40
		contCertAuth.top = 135 + 40
		
		ButtonNext.top = 587
		
	else
		
		contHeader.top = 0
		labTitle.visible = False
		labTitle0.visible = False
		
		if sParam <> "" then
			'labTitle.caption = sParam
			Form.SetScreenName(sParam)
		else
			'labTitle.caption = "추가인증"
			Form.SetScreenName("추가인증")
		end if
		
		ImgBackPress.visible = False
		ImgClose.visible = True
		
		contSMS.top = 135 - 60
		contARS.top = 135 - 60
		contOnce.top = 135 - 60
		contCertAuth.top = 135 - 60
		contOverSea.top = 135 - 60
		
		ButtonNext.top = 547
	end if
	
End Sub
'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.setMaintainingRatio("1")
	ImgClose.setMaintainingRatio("1")
End Sub
'============================================================================
Sub contHeader_ImgSMS_OnClick()
	AddAuthenticationUI(0)
End Sub

'============================================================================
Sub contHeader_ImgARS_OnClick()
	AddAuthenticationUI(1)
End Sub

'============================================================================
Sub contHeader_ImgOnceAuth_OnClick()
	AddAuthenticationUI(2)
End Sub

'============================================================================
Sub contHeader_ImgOversea_OnClick()
	AddAuthenticationUI(3)
End Sub
'============================================================================
Function InputCheck(sType, sInput)

	sInput = Trim(sInput)	
	
	if sType == "EditSMSNum" then
		if sInput == "" Then
			contSMS.EditSMSNum.SetResultLabel("1","error","SMS 인증번호를 입력하세요.","")

			return False
	
		else
			contSMS.EditSMSNum.SetResultLabel("0","complete","","Container0")
	    end if	
	
	
	elseif sType == "EditDate" then
		if sInput == "" Then
			Container0.EditDate.SetResultLabel("1","error","생년월일을 입력해주시기 바랍니다.","Container0")
			
			if bShowKeypad == True and g_Back_Flag <> "Y" then
				Form.SetTimerEvent2(2, 1, 0.1) '0.1초뒤 보안키패드 활성화
			end if	
			
			return False
	
		elseif Len(sInput) ~= 8 then
			Container0.EditDate.SetResultLabel("1","error","생년월일 8자리를 입력해주세요.","Container0")
			
			if bShowKeypad == True and g_Back_Flag <> "Y" then
				Form.SetTimerEvent2(2, 1, 0.1) '0.1초뒤 보안키패드 활성화
			end if	
			
			return False
	
		else
			Container0.EditDate.SetResultLabel("0","complete","","Container0")
			
			if Container0.EditPhone.caption == "" Or Container0.EditPhone.caption == null then
				If g_Back_Flag <> "Y" Then
					Form.SetTimerEvent2(3, 1, 0.1) '0.1초뒤 보안키패드 활성화
				End If		
			end if
		end if	
		
	else
		if sInput == ""  Then
			Container0.EditPhone.SetResultLabel("1","error","휴대폰번호를 입력해주세요.","Container0")
			
			if bShowKeypad == True and g_Back_Flag <> "Y" then
				Form.SetTimerEvent2(3, 1, 0.1) '0.1초뒤 보안키패드 활성화
			end if	
			
			return False
			
		elseif Len(sInput) ~= 11 and Len(sInput) ~= 10 then
			Container0.EditPhone.SetResultLabel("1","error","정확한 휴대폰번호를 입력해주세요.","Container0")

			if bShowKeypad == True and g_Back_Flag <> "Y" then
				Form.SetTimerEvent2(3, 1, 0.1) '0.1초뒤 보안키패드 활성화
			end if	
			
			return False
		
		else
			Container0.EditPhone.SetResultLabel("0","complete","","Container0")
		end if		
	end if

	return True
End Function
'============================================================================
Sub contSMS_EditSMSNum_OnEditComplete()

	bRlst = InputCheck("EditSMSNum", contSMS.EditSMSNum.caption)
	
	if bRlst then
		DATAMANAGER.RequestTranData( "obcsb_oimf_615r" ) 'SMS인증번호검증
	end if
	
End Sub

'============================================================================
Sub ImgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contARS_LblChangeNumber_OnClick()
	Form.OpenScreen("81000" , "")
	Form.CloseForm()
End Sub

'============================================================================
Sub contARS_BtnApha_OnClick()
	contARS_LblChangeNumber_OnClick()
End Sub

'============================================================================
Sub ButtonNext_OnClick()
	
	'SMS 인증 시
	if contSMS.visible then
		if contSMS.EditSMSNum.caption == null or contSMS.EditSMSNum.caption == "" then
			Form.MsgBox( "안내", "SMS 인증번호를 입력하세요.", "", 6 )
		else
			DATAMANAGER.RequestTranData( "obcsb_oimf_615r" ) 'SMS인증번호검증
		end if
	end if
	
	'ARS 인증 시
	if contARS.visible then
		contARS_ButtonARS_OnClick()
	end if
	
	'1회용 인증번호 인증 시
	if contOnce.visible then
		if g_sRevData == "mobile_enroll" then
			if contOnce.EditOnceNum.caption == null or contOnce.EditOnceNum.caption == "" then
				Form.MsgBox( "안내", "1회용 인증번호를 입력하세요.", "", 6 )
				exit sub
			else
				if Len(contOnce.EditOnceNum.caption) < 6 then
					Form.MsgBox( "안내", "1회용 인증번호 6자리를 입력하세요.", "", 6 )
				else
					if g_sRevData == "mobile_enroll" or g_sRevData == "mobile_cancel" then
						Form.SetSharedData("MobileCertRadio" , "4")
						Form.SetSharedData("MobileCertNumber" , contOnce.EditOnceNum.caption)
					else
						DATAMANAGER.RequestTranData( "obcsb_oimf_609r" ) '1회용인증번호 검증 
					end if
					
					g_sRetData = "ok"
					Form.CloseForm( )
				end if
			end if
		end if
		
		'1회용인증번호 
		if g_bOnceOrNot then	
			if contOnce.EditOnceNum.caption == null or contOnce.EditOnceNum.caption == "" then
				Form.MsgBox( "안내", "1회용 인증번호를 입력하세요.", "", 6 )
				exit sub 
			else
				if Len(contOnce.EditOnceNum.caption) < 6 then
					Form.MsgBox( "안내", "1회용 인증번호 6자리를 입력하세요.", "", 6 )
					exit sub 
				end if
				
				DATAMANAGER.RequestTranData( "obcsb_oimf_609r" ) '1회용인증번호 검증 
			
			end if
		end if
	end if
	
	if contCertAuth.visible then
		'20180802 LES START - 바이오인증 등록절차 변경
		sSendData = g_sRevData&"★"& Form.GetSharedData("CERT_ID" , false) &"★"& Form.GetSharedData("BIO_DNDATA", false )
		Form.OpenFramePopup( G_BIO_OCSP_FILE,  sSendData, "")
		'20180802 LES END -바이오인증 등록절차 변경
	end if
	
	'해외 체류 인증 시
	if contOverSea.visible then
		Form.OpenFramePopup( G_IP_CONFIRM_FILE , "" , "" )
	end if
	
End Sub

'============================================================================
Sub contOnce_EditOnceNum_OnEditComplete()
	ButtonNext.enable = True
End Sub

