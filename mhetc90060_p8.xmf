				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "RMT_NAME" , i , grd0.GetCellData( "bd_cell2", 0 ) ) '수취인명
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_611a", "InBlock1", "TACT_AMT" , i , grd0.GetCellData( "bd_cell3", 0) ) '이체금액
