'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_036r" then
		DATAMANAGER.ClearInputData(0, "ohhts_intr_036r")
		grdGroup.rowcount = 0
		DATAMANAGER.SetDataValue(0, "ohhts_intr_036r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))	' USER ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_036r", "InBlock1", "FID_KIND_CODE", 0, "1")	' 통합구분 (0:국내해외통합, 1:해외주식전용)
	' ----------------------------------------------------------------------
	' 
	' ----------------------------------------------------------------------
'	elseif szTranID ==  then
'		DATAMANAGER.SetDataValue(0, , 0, )	
'		DATAMANAGER.SetDataValue(0, , 0, )	
	' ----------------------------------------------------------------------
	' 
	' ----------------------------------------------------------------------	
'	elseif szTranID ==  then
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_036r" then
		Save_GWGroup()		' 동기화 상태일때도 파일에는 계속저장
		' 관심그룹을 그룹콤보에 넣기
		Insert_cmbGroup()
	end if
End Sub

'============================================================================
' fmTab_OnTabChanged
'============================================================================
Sub fmTab_OnTabChanged(nCurrentTab)
	fmTab.currenttab = "1"
	
	if nCurrentTab == 2 then
		btnNext_OnClick()
	elseif nCurrentTab == 0 then
		btnPrev_OnClick()
	end if
	
'	cmbGroup.currentindex = nCurrentTab
