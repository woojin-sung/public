g_szFirst = "0"

' 0현재/1예상/2단일 토글
Dim g_szRSelect 
g_szRSelect = "0"

'- 관심_환경설정 관련 -------------------------------------------------------
Dim g_tGSelect
Dim g_tGDefault
Dim g_tKey
Dim g_tNm
Dim g_szCloud		' 관심동기화(0:미사용(로컬), 1:사용(서버))

g_tGSelect = {}
g_tDefault = {"GW_WATCHING", "GW_RECENT", "GW_HOLDING"}
g_tKey     = {"AA", "BB", "CC"}
g_tNm      = {"Wathcing종목", "최근조회 종목", "보유종목"}
' ---------------------------------------------------------------------------


