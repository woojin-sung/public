'============================================================================
' init_GWGroup :  관심그룹 재설정 (로컬/서버)
'============================================================================
Function init_GWGroup()
	if g_szCloud == "1" then		' Server 저장시
		' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
		DATAMANAGER.RequestTranData("ohhts_intr_036r")
	else
		' 로컬 저장된 관심그룹 가져오기
		Load_GWGroup()
		Insert_cmbGroup()
	end if
End Function

'============================================================================
' Insert_cmbGroup :  관심그룹을 그룹콤보에 넣기
'============================================================================
Function Insert_cmbGroup()
	Dim szgrpList, szKey, szNm, szSave
	Dim nRow, nIdx, nSelect
	
	' 콤보 리스트 클리어
	Form.SetCtlProp("cmbGroup", "clear", "")
	
	nRow = grdGroup.rowcount
	nIdx = -1
	nSelect = -1
	szgrpList = ""
	
	' 최종 선택(저장)된 관심그룹 키
	szSave = Form.GetEnvData("SELECT_GWGROUP")

' 사이드메뉴에서는 필요없는 부분
'	' ---- 관심_환경설정에서 가져온 관심그룹 추가 여부 Start ----------------
'	For i = 0 to #g_tDefault-1
'		g_tGSelect[i] = Form.GetEnvData(g_tDefault[i])
'		
'		if g_tGSelect[i] == "" or g_tGSelect[i] == null then
'			g_tGSelect[i] = "1"
'		end if
'		
'		' 해당그룹 Show시
'		if g_tGSelect[i] == "1" then
'		
'			if i == 0 then
'				szgrpList = g_tKey[i] & "`" & g_tNm[i]
'			
'				nIdx = 0
'			else
'				if szgrpList == "" then
'					szgrpList = g_tKey[i] & "`" & g_tNm[i]
'				else
'					szgrpList = szgrpList & "\r\n" & g_tKey[i] & "`" & g_tNm[i]
'				end if
'				
'				if nIdx >= 0 then
'					nIdx = nIdx + 1
'				else
'					nIdx = 0
'				end if			
'			end if
'			
'			if szSave == g_tKey[i] then
'				nSelect = nIdx
'			end if
'
'			' 선택된 그룹을 삭제하였을경우의 예외처리
'			if i == nRow -1 then
'				if nSelect < 0 then
'					nSelect = 0
'				end if
'			end if
'		end if
'	NEXT
	' ---- 관심 환경설정에서 가져온 관심그룹 추가 여부 End ------------------

	' ---- 관심종목 그룹 리스트 존재시 Start --------------------------------
	if Int(nRow) > 0 then
		For i = 0 to nRow -1
			szKey = grdGroup.GetCellData("bd_code", i)
			szNm  = grdGroup.GetCellData("bd_name", i)

			if szgrpList == "" then
				szgrpList = szKey & "`" & szNm
			else
				szgrpList = szgrpList & "\r\n" & szKey & "`" & szNm
			end if
			
			if nIdx >= 0 then
				nIdx = nIdx + 1
			else
				nIdx = 0
			end if
			
			if szSave == szKey then
				nSelect = nIdx
			end if
			
			' 선택된 그룹을 삭제하였을경우의 예외처리
			if i == nRow -1 then
				if nSelect < 0 then
					nSelect = 0
				end if
			end if
		Next
	end if
	' ---- 관심종목 그룹 리스트 존재시 End ----------------------------------

	' 관심그룹콤보에 리스트 init		
	cmbGroup.cbinputdatatext = szgrpList

	' 관심그룹콤보에서 최종 저장된 그룹 선택
	cmbGroup.currentindex = CStr(nSelect)
End Function

'============================================================================
' Load_GWGroup :  로컬에 저장된 관심그룹 가져오기
'============================================================================
Function Load_GWGroup()
	Dim tGroup, tList
	
	grdGroup.rowcount = 0
	szGroup = Form.LoadConfigData("GWANSIM", "GROUP")
	
	if szGroup <> "" then	
		tGroup = Split(szGroup, "♣")
		
		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdGroup.insertrow = i
	
			grdGroup.SetCellData("bd_code",  i, tList(0))
			grdGroup.SetCellData("bd_name",  i, tList(1))
			grdGroup.SetCellData("bd_count", i, tList(2))
		Next
	end if
End Function

'============================================================================
' Save_GWGroup :  관심그룹을 로컬에 저장
'============================================================================
Function Save_GWGroup()
	Form.SaveConfigData("GWANSIM", "GROUP", "")
	
	For i = 0 to grdGroup.rowcount-1
		szCode = grdGroup.GetCellData("bd_code",  i)
		szName = grdGroup.GetCellData("bd_name",  i)
		szCnt  = grdGroup.GetCellData("bd_count", i)
		if i == 0 then
			szGroup = szCode & "★" & szName & "★" & szCnt
		else
			szGroup = szGroup & "♣" & szCode & "★" & szName & "★" & szCnt
		end if
	Next
	
	Form.SaveConfigData("GWANSIM", "GROUP", szGroup)
End Function

'============================================================================
' Control_FmTab_Swipe : 폼탭의 좌우스크롤 제어
'============================================================================
Function Control_FmTab_Swipe()
	' 좌우 스크롤시 관심그룹 변경 설정
	if Form.GetEnvData("GW_SWIPE") == "1" then
		fmTab.usepg = "1"
	else
		fmTab.usepg = "0"
	end if
End Function


