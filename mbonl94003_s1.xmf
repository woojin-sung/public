''--===========================================================================
'' 01. 화 면 명 : 전환(분류)신청_전문투자자전환탭
'' 02. 화면설명 : 
'' 03. 작    성 : 2021.06.08 정효영
'' 04. 수    정 : 21.08.03 JHY : 타사지정신청 추가
''--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_tInfo
g_tInfo = {} ' 신청에 필요한 고객 정보들을 가지고 있는 테이블
Dim g_ProsClsCode
''****************************************************************************
''            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
''****************************************************************************
'============================================================================
' f_GetTData(sKey) : 해당 key에 해당하는 value 반환, 예외처리 통과 못할 시 빈값 반환
'============================================================================
Function f_GetTData(sKey)
	if g_tInfo == NULL then
		return ""
	else
		if g_tInfo[sKey] == NULL or g_tInfo[sKey] == "" then
			return ""
		else
			return g_tInfo[sKey]
		end if
	end if
End Function

'''****************************************************************************
'''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'''****************************************************************************

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	contOurCom.contState.tblState.visible = false
	contOurCom.ChkReReg.visible = False
	contOurCom.Table0.visible = False

	g_ProsClsCode = "1"
End Sub

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'탭 변경, 계좌, 비밀번호 입력 등 이벤트로 TR 조회 트리거 들어옴
	if sEventName == "requestTR" then
		Dim szAccount, szPassword
		
		szAccount = Form.GetCtlProp( "#Account0", "caption" )
		szPassword = Form.GetCtlProp( "#edtPassword", "caption" )
		
		edtPassword.caption = szPassword
		
		for i=0 to 6
			contOurCom.contState.tblState.SetCellString( i, 2, "" ) '테이블 내역 초기화
		next
		
		contOurCom.contState.tblState.visible = false
		contOurCom.contState.lblNoData.visible = false
		contOurCom.btnSubmit.enable = false
		
		if szAccount <> "" then
			DATAMANAGER.RequestTranData( "obcsb_acif_097r" )
			'21.08.03 JHY START
			Form.triggerEvent("lkfOthers", "changeAccount", szAccount)
			'21.08.03 JHY END
		end if
	end if
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'신청 후 필수 절차 안내 팝업 닫았을때 공인인증서 확인하고 신청 TR 호출
	if sKeyName == "close_mbonl94003_p1" then
		Dim szCertUseType 
		szCertUseType = Form.GetSharedData("&CERT_USE_TYPE", false )  'v001 로그인타입

		if szCertUseType == "1" or szCertUseType == 1 then '간편인증 v001
		    Form.OpenFramePopup( "mhetc90060_px" , "" , mhetc90060_px)		'간편인증
		else
		    Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		end if
		
	'완료 팝업 닫으면 현황 재조회
	elseif sKeyName == "close_mbonl94002_p2" then
		DATAMANAGER.RequestTranData( "obcsb_acif_097r" )
	
	' 확인 후 공인인증 처리 완료 되면 전환 신청 TR 호출
	elseif sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			DATAMANAGER.RequestTranData( "obcsb_acif_720a" )
		end if
		
     elseif sKeyName == "mhetc90060_px" Then 'v001
         if sRet == "ok" Then  
		 DATAMANAGER.RequestTranData( "obcsb_acif_720a" )
	     end if
	end if
End Sub

'============================================================================
' contOurCom_btnSubmit_OnClick() : 개인 전문투자자 전환(분류) 위험설명 팝업 오픈
'============================================================================
Sub contOurCom_btnSubmit_OnClick()

	Dim szPassword
	szPassword = Form.GetCtlProp( "#edtPassword", "caption" )
	
	if szPassword <> "" then
		Form.OpenPopup("mbonl94003_p1" , "" , "")
	else
		Form.ShowAlert("알림", "비밀번호를 입력해주세요")
	end if
End Sub

'============================================================================
' 21.08.03 JHY START
' rdoGubun_OnClick(nIndex) : 라디오 변경에 따른 화면 변경 ( 기존 구조 최대한 안바꾸기 위해, 라디오 넣고 링크폼으로 변경 )
'============================================================================
Sub rdoGubun_OnClick(nIndex)
	if tonumber(nIndex) == 0 then
		contOurCom.visible = true
		lkfOthers.visible = false
		
	elseif tonumber(nIndex) == 1 then
		contOurCom.visible = false
		lkfOthers.visible = true
		
		Dim szAccount
		szAccount = Form.GetCtlProp( "#Account0", "caption" )
		
		Form.triggerEvent("lkfOthers", "changeAccount", szAccount)
	end if
End Sub

'''****************************************************************************
'''               		D A T A				M A N A G E R               
'''****************************************************************************

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_acif_097r" then
		Dim szCustNum
		szCustNum = Form.GetSharedData("&CUST_NUM", false )
'		szCustNum = "3000353088"
		
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0, szCustNum )

	elseif szTranID == "obcsb_acif_720a" then		
		Dim szJumin, szUserName
		szJumin = Form.GetSharedData("&JUMIN_NUM", false )
		szUserName = Form.GetSharedData("&USER_NAME", false )
		
		Dim szDate, szTime
		szDate =  Replace(Now("yyyyMMdd"),"-","")
		szTime = Replace(FormatDateTime(now,4),":","") & Right(szDate,2)
		
		szDate = Left(szDate, 8) & szTime

		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0, g_ProsClsCode )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "RCNO_TYPE_CODE" , 0, "01" )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "RCNO_PIP" , 0, szJumin ) '실명확인번호
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CUST_FULL_NAME" , 0, szUserName ) '고객풀명
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PFIN_CLS_CODE" , 0, "4" ) '전문투자자구분코드
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PFIN_RGNO" , 0, f_GetTData("registerNum") ) '전문투자자등록번호
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PFIN_DSGT_DATE" , 0, f_GetTData("confirmDate") ) '전문투자자지정일자
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PFIN_VLDT_STA_DATE" , 0, f_GetTData("startDate") ) '전문투자자효력시작일자
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PFIN_VLDT_FIN_DATE" , 0, f_GetTData("finalDate") ) '전문투자자효력종료일자
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PFIN_DSGT_APLT_DATE" , 0, f_GetTData("applyDate") ) '전문투자자지정신청일자
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "GNRL_INVR_CNVR_REAS_CNTT", 0, null ) '일반투자자전환사유내용
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "TORF_CNFR_YN", 0, "Y" ) '진위확인여부
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "TORF_CNFR_EMPNO", 0, "SYSTEM" ) '진위확인직원번호
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ISTU_CLCD", 0, "F" ) '기관구분코드
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "OTCO_ISTU_CODE", 0, "010" ) '타사기관코드
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "TORF_CNFR_YMDH", 0, szDate ) '진위확인일시
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "SPCL_FNCM_TYPE_CODE" , 0, "02" ) '전문금융소비자유형
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "FNCM_GRP_CODE" , 0, "C" ) '금융소비자그룹코드 "투자성상품"
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "FNCM_GRP_DETL_CODE" , 0, "13" ) '금융소비자그룹세부코드 "개인전문투자자"
	end if
End Sub
'
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acif_097r" then		
		Dim szStaDate, szFinDate, szConfirmDate, szToday

		szStaDate = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "RSLT_REG_DATE" , 0  ) '시작일자
		szFinDate = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "FIN_DATE" , 0  ) '종료일자
		szConfirmDate		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "RSLT_REG_DATE" , 0  ) '결과등록일자
		
		szToday = Trim(Form.GetSharedData( "&HOST_DATE" , false ))

		if tonumber(szConfirmDate) <> NULL and tonumber(szFinDate) <> NULL then
			if tonumber(szConfirmDate) <= tonumber(szToday) and tonumber(szToday) <= tonumber(szFinDate) then
				contOurCom.contState.tblState.visible = true
				
'				Dim szPassword
'				szPassword = Form.GetCtlProp( "#edtPassword", "caption" )
'				
'				if szPassword <> "" then
					Dim szChannel, szProcCode, szResultCode, szClsCode, szApltDate, szExpertNum, szQlfcCode, szQlfcString
		
					szClsCode = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "PFIN_QLFC_CLCD" , 0  )
			
					szChannel 		= Form.GetMetaData("채널유형구분코드", DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "CHAN_TYPE_CLS_CODE" , 0  )) '채널유형구분코드
					szProcCode 	= Form.GetMetaData("심사진행상태코드", DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "EXAM_PRGS_STAT_CODE" , 0  )) '심사진행상태코드
					szResultCode 	= Form.GetMetaData("심사결과코드", DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "EXAM_RSLT_CODE" , 0  )) '심사결과코드
					szApltDate		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "APLT_DATE" , 0  ) '신청일자
					szExpertNum	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "PFIN_RGNO" , 0  ) '전문투자자 지정번호	
					
					szQlfcCode 	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "PFIN_QLFC_CLCD" , 0  )

					' Form.GetMetaData 썼으나, 버전처리 문제있는 것으로 보인다고 하여 화면에서 분기 처리 (06.30 권오상 차장님 요청)
					if szQlfcCode == "1" then
						szQlfcString = "소득"
						
					elseif szQlfcCode == "2" then
						szQlfcString = "전문가"
						
					elseif szQlfcCode == "3" then
						szQlfcString = "자산"
					end if
					
					contOurCom.contState.tblState.SetCellString( 0, 2, szChannel )
					contOurCom.contState.tblState.SetCellString( 1, 2, szApltDate )
					contOurCom.contState.tblState.SetCellString( 2, 2, szQlfcString )
					contOurCom.contState.tblState.SetCellString( 3, 2, szProcCode )
					contOurCom.contState.tblState.SetCellString( 4, 2, szResultCode )
					contOurCom.contState.tblState.SetCellString( 5, 2, szConfirmDate )
					contOurCom.contState.tblState.SetCellString( 7, 2, szExpertNum )
					
					Dim szFormatStart, szFormatExp '형식에 맞게 포맷팅
				
					szFormatStart = Mid(szConfirmDate, 1, 4) & "-" & Mid(szConfirmDate, 5, 2) & "-" & Mid(szConfirmDate, 7, 2)
					szFormatExp = Mid(szFinDate, 1, 4) & "-" & Mid(szFinDate, 5, 2) & "-" & Mid(szFinDate, 7, 2)
					
					contOurCom.contState.tblState.SetCellString( 6, 2, szFormatStart & "~" & szFormatExp )
					
					' 재등록 체크 박스 및 기존 유효일자 보여줄지 여부 처리
					contOurCom.CalFinDate.caption = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "FIN_DATE" , 0  ) '재등록 가능 종료일
					contOurCom.CalStaDate.caption = contOurCom.CalFinDate.caption '재등록 가능 시작일
					contOurCom.CalStaDate.addday = -90 '30일 전

					If contOurCom.CalStaDate.caption <= szToday And szToday <= contOurCom.CalFinDate.caption Then
						szStaCntt = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "STA_DATE" , 0  )
						szFinCntt = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "FIN_DATE" , 0  ) 
						
'						szStaCntt = Left(szTmpSta, 4) & "-" & Mid(szTmpSta, 5, 2) & "-" & Right(szTmpSta, 2)
'						szFinCntt = Left(szTmpFin, 4) & "-" & Mid(szTmpFin, 5, 2) & "-" & Right(szTmpFin, 2)
'						contOurCom.Container0.Table0.SetCellString( 0, 2, szStaCntt & " ~ " & szFinCntt)
						contOurCom.Table0.SetCellString( 0, 2, szStaCntt & szFinCntt)
						
						contOurCom.ChkReReg.visible = True
						contOurCom.Table0.visible = True
						
					Else
						contOurCom.ChkReReg.visible = False
						contOurCom.Table0.visible = False
					End If
					
					if szClsCode == "" then
						contOurCom.btnSubmit.enable = false
						
					else
						contOurCom.btnSubmit.enable = true
					end if
'				end if
			else
				contOurCom.contState.tblState.visible = false
				contOurCom.contState.lblNoData.visible = true
			
				contOurCom.btnSubmit.enable = false
			end if
		else
			contOurCom.contState.tblState.visible = false
			contOurCom.contState.lblNoData.visible = true
		
			contOurCom.btnSubmit.enable = false
		end if
		
		' 신청에 필요한 정보들 저장
		if g_tInfo <> NULL then
			g_tInfo["clsCode"] 			= szClsCode
			g_tInfo["registerNum"] 		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "PFIN_RGNO" , 0  )
			g_tInfo["applyDate"] 		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "APLT_DATE" , 0  ) '신청일자
			g_tInfo["confirmDate"]		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "RSLT_REG_DATE" , 0  ) '지정일자
			g_tInfo["startDate"] 		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "RSLT_REG_DATE" , 0  ) '시작일자
			g_tInfo["finalDate"] 		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "FIN_DATE" , 0  ) '종료일자
			g_tInfo["esStrDate"] 		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "STA_DATE" , 0  ) '기존효력시작일자
			g_tInfo["esFinDate"] 		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "FIN_DATE" , 0  ) '기존효력종료일자
		end if
		
	elseif szTranID == "obcsb_acif_720a" then
		Dim szSucsYN
		szSucsYN = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "SUCS_YN" , 0  )
		
		if szSucsYN == "Y" then
			Form.OpenPopup("mbonl94002_p2" , "switch_professional" , "")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	If szTranID == "obcsb_acif_720a" And szErrCode == "4974" And g_ProsClsCode == "4" Then
		Form.ShowAlert("알림", "기존 전문투자자 지정 건과 동일합니다.")
	Else
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
		
		if szTranID == "obcsb_acif_097r" then
			contOurCom.contState.tblState.visible = false
			contOurCom.contState.lblNoData.visible = true
			contOurCom.btnSubmit.enable = false
		end if
	End If
End Sub


'============================================================================


'============================================================================
Sub contOurCom_ChkReReg_OnChange(sCheckState)
	If sCheckState == "1" Then
		g_ProsClsCode = "4"
	Else
		g_ProsClsCode = "1"
	End If
End Sub

