	<SCRIPT_INFO _len="15103" _ulen="14373" >
Dim g_Keyword
g_Keyword = ""

Dim g_KeywordList
'g_KeywordList = {}


Dim g_KeywordNum
g_KeywordNum = 0

Dim g_UserID

'20170529 NOHES START : 첫 실행시 키워드뉴스 가이드 리스트
Dim g_szFirstList
g_szFirstList = Array( "메리츠증권", "계약", "체결", "영업이익" ) '20210923 HSZ : 메리츠종금증권->메리츠증권
Dim g_szFirstKey		
'20170529 NOHES END

'============================================================================
Sub Form_OnFormInit()
	
	'저장되어있는 키워드를 불러옴
	g_UserID = Form.GetSharedData("&USER_ID" , false)
	'20170529 NOHES START : 첫 키워드 실행 여부 판단
	g_szFirstKey = Form.LoadConfigData("KeywordNews", g_UserID)	
	'20170529 NOHES END
	
	DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001r", "InBlock1", "FID_USER_ID" , 0 , g_UserID)
	DATAMANAGER.RequestTranData("ohhts_kwdn_001r")
	'Label2.bgcolor = "250250250"
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "ohhts_kwdn_001r" then
	
		g_KeywordNum = DATAMANAGER.GetDataCount(0, "ohhts_kwdn_001r", "OutBlock1")
		'20210923 HSZ START : 홈화면 키워드 뉴스는 최대 4개까지만 보여주기
		if g_KeywordNum > 4 then
			g_KeywordNum = 4
		end if
		'20210923 HSZ END
		
		g_Keyword = ""
		
		if Cint(g_KeywordNum) < 1 then
			'20170529 NOHES START : 키워드뉴스 첫 실행시 기본 키워드 설정	
			g_szFirstKey = Form.LoadConfigData("KeywordNews", g_UserID)	
		
			if g_szFirstKey <> "Y" Then
				g_KeywordNum = 4
				
				for nIdx = 0 to Ubound(g_szFirstList)
					DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a_2", "InBlock1", "FID_CLS" , 			0 , "1")
					DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a_2", "InBlock1", "FID_USER_ID" , 		0 , g_UserID)
					
					if g_KeywordNum < 10 then
						DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a_2", "InBlock1", "FID_SRCH_COND_GRP" , 	0 , "0" & nIdx)
					else
						DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a_2", "InBlock1", "FID_SRCH_COND_GRP" , 	0 , nIdx)
					end if
					sRet = 	g_szFirstList(nIdx)
	
					DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a_2", "InBlock1", "FID_SRCH_COND" , 		0 , sRet)
					DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a_2", "InBlock1", "FID_CHAN_MDIA_CLCD" ,	0 , "010")
					DATAMANAGER.RequestTranData("ohhts_kwdn_001a_2")			
				Next 
			else
				Label0.visible = true
				grd01.visible = false
			end if
			'20170529 NOHES END
		else
			Label0.visible = false
			grd01.visible = true
			grd01.SetClear()
			for i = 0 to g_KeywordNum -1 
				grd01.AddRow()
				keyword = DATAMANAGER.GetDataValue(0, "ohhts_kwdn_001r", "OutBlock1", "FID_SRCH_COND" , i)
				'20210923 HSZ START 
				if keyword = "메리츠종금증권" then
					keyword = "메리츠증권"
				end if 
				'20210923 HSZ END
				grd01.SetCellData("bd_cell0", i, "#" & keyword)
				grd01.SetCellFgColor("bd_cell0", i, "274")
				
				'키워드를 배열 형태로 관리
				if i == 0 then
					g_Keyword = keyword
			
				else
					g_Keyword = g_Keyword & "★" & keyword
				
				end if
			
			next
			
			g_KeywordList = Split(g_Keyword,"★")
			
			for i = 0 to g_KeywordNum -1
				
				DATAMANAGER.SetDataValue(0, "ohhts_kwdn_002r", "InBlock1", "FID_SRCH_COND", i , g_KeywordList(i))
				'DATAMANAGER.RequestTranData("ohhts_kwdn_002r")
				
			next
			
			DATAMANAGER.RequestTranData("ohhts_kwdn_002r")
		
		end if
		
		
		
	elseif szTranID = "ohhts_kwdn_002r" then
	
				
		
		for i = 0 to g_KeywordNum -1
		
			szDate = ""
'			szTime = ""
'			szNewCorpName = ""
			szTitle = ""
		
			
			szDate 			=  DATAMANAGER.GetDataValue(0, "ohhts_kwdn_002r", "OutBlock1", "FID_DATE" , i)
'			szTime			=  DATAMANAGER.GetDataValue(0, "ohhts_kwdn_002r", "OutBlock1", "FID_HOUR" , i)
'			szNewsCorpCode 	=  DATAMANAGER.GetDataValue(0, "ohhts_kwdn_002r", "OutBlock1", "FID_NEWS_OFER_ENTP_CODE" , i)
			szTitle 	=  DATAMANAGER.GetDataValue(0, "ohhts_kwdn_002r", "OutBlock1", "FID_TITL" , i)
		   
		    
		    if szDate = "" then
			    szTitle = "최근 한달 간 뉴스가 존재하지 않습니다."
			    szDate =  Replace(Now("yyyyMMdd"),"-","")
			    szTime = Replace(FormatDateTime(now,4),":","") & Right(szDate,2) 
			    szNewCorpName="[검색결과]"
			    grd01.SetCellFgColor("bd_cell3", i, "98")
			    
			    
			end if
		  
			
			grd01.SetCellData("bd_cell1", i, szDate)
'			grd01.SetCellData("bd_cell2", i, szTime)
'			grd01.SetCellData("bd_cell4", i, szNewCorpName)
			grd01.SetCellData("bd_cell3", i, szTitle)		
			grd01.SetCellData("bd_cell5", i ,">")
			
		next
		
	elseif szTranId = "ohhts_kwdn_002r_1" then	'키워드 추가시 로딩 줄이기위해 추가된 키워드 한건만 조회하여 셋팅
	
			szDate = ""
			szTime = ""
			szNewCorpName = ""
			szTitle = ""
			
			
			szDate 			=  DATAMANAGER.GetDataValue(0, "ohhts_kwdn_002r_1", "OutBlock1", "FID_DATE" , 0)
			szTime			=  DATAMANAGER.GetDataValue(0, "ohhts_kwdn_002r_1", "OutBlock1", "FID_HOUR" , 0)
			szNewsCorpCode 	=  DATAMANAGER.GetDataValue(0, "ohhts_kwdn_002r_1", "OutBlock1", "FID_NEWS_OFER_ENTP_CODE" , 0)
			szTitle 			=  DATAMANAGER.GetDataValue(0, "ohhts_kwdn_002r_1", "OutBlock1", "FID_TITL" , 0)
			
			
		    If 		szNewsCorpCode == "n0" then szNewCorpName = "[시황속보]"
		    elseif 	szNewsCorpCode == "HK" then szNewCorpName = "[한경뉴스]"
		    elseif 	szNewsCorpCode == "EY" then szNewCorpName = "[이데일리뉴스]"
		    elseif 	szNewsCorpCode == "F0" then szNewCorpName = "[공시정보]"
		    elseif 	szNewsCorpCode == "MT" then szNewCorpName = "[머니투데이]"
		    elseif 	szNewsCorpCode == "SD" then szNewCorpName = "[이투데이]"
		    elseif 	szNewsCorpCode == "IS" then szNewCorpName = "[인포스탁]"
		    elseif 	szNewsCorpCode == "MK" then szNewCorpName = "[매경뉴스]"
		    elseif 	szNewsCorpCode == "FN" then szNewCorpName = "[파이낸셜뉴스]"
		    elseif 	szNewsCorpCode == "YN" then szNewCorpName = "[연합뉴스]"
		    elseif 	szNewsCorpCode == "NP" then szNewCorpName = "[뉴스핌]"
		    elseif 	szNewsCorpCode == "AE" then szNewCorpName = "[아시아경제]"
		    elseif 	szNewsCorpCode == "HE" then szNewCorpName = "[헤럴드경제]"
		    elseif 	szNewsCorpCode == "CD" then szNewCorpName = "[CEO스코어데일리]"
		    '20161226 LES START - 서울경제, 컨슈머타임스 추가
		    elseif 	szNewsCorpCode == "SE" then szNewCorpName = "[서울경제]"
		    elseif 	szNewsCorpCode == "CT" then szNewCorpName = "[컨슈머타임스]"
    
		    end if
			
			
			if szDate = "" then
				szTitle = "최근 한달 간 뉴스가 존재하지 않습니다."
				szDate =  Replace(Now(),"-","")
				szTime = Replace(FormatDateTime(now,4),":","") & Right(szDate,2) 
				szNewCorpName="[검색결과]"
				grd01.SetCellFgColor("bd_cell3", g_KeywordNum-1, "98")
				
			end if
			
			
			
			grd01.SetCellData("bd_cell1", g_KeywordNum-1, szDate)
'			grd01.SetCellData("bd_cell2", g_KeywordNum-1, szTime)
'			grd01.SetCellData("bd_cell4", g_KeywordNum-1, szNewCorpName)
			
			grd01.SetCellData("bd_cell3", g_KeywordNum-1, szTitle)
			grd01.SetCellData("bd_cell5", g_KeywordNum-1 ,">")
		

	elseif szTranID = "ohhts_kwdn_001a_1" then
	
			Grid_reDraw("mod","")
	elseif szTranID = "ohhts_kwdn_001a_2" then
		'20170529 NOHES START : 키워드뉴스 첫 실행 여부
		Form.SaveConfigData("KeywordNews", g_UserID, "Y")
		DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001r", "InBlock1", "FID_USER_ID" , 0 , g_UserID)
		DATAMANAGER.RequestTranData("ohhts_kwdn_001r")
		'20170529 NOHES END
	end if

	
End Sub





'============================================================================
' 추가 버튼 클릭 이벤트
'============================================================================
Sub Image0_OnClick()
	if Cint(g_KeywordNum) > 19 then
		Form.ShowAlert("알림", "키워드는 최대 20개까지만 등록가능 합니다.")
	else
		Form.OpenPopup("mhnws44050_p1",g_KeywordNum & "★" & g_Keyword,"")
	end if
End Sub

'============================================================================
' 편집 버튼 클릭 이벤트
'============================================================================
Sub Image1_OnClick()
	Form.OpenPopup("mhnws44050_p2" , g_Keyword & "●" & g_KeywordNum  ,"")
	
End Sub

'============================================================================
Sub Image2_OnClick()
	
	DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001r", "InBlock1", "FID_USER_ID" , 0 , g_UserID)
	DATAMANAGER.RequestTranData("ohhts_kwdn_001r")
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "keywordAdd" then
		
		if Cint(g_KeywordNum) < 1 then
			g_Keyword = sRet
			g_KeywordNum = g_KeywordNum +1
		elseif Cint(g_KeywordNum) >= 1 then
			g_Keyword =g_Keyword & "★" & sRet
			g_KeywordNum = g_KeywordNum + 1
		end if
		
		g_KeywordList = Split(g_Keyword, "★")
		
		
		Check_Keyword_Exist()
		Setting_Keyword(sRet)
		
		
		
		DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a", "InBlock1", "FID_CLS" , 			0 , "1")
		DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a", "InBlock1", "FID_USER_ID" , 		0 , g_UserID)
		
		if g_KeywordNum < 10 then
			DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a", "InBlock1", "FID_SRCH_COND_GRP" , 	0 , "0" & g_KeywordNum)
		else
			DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a", "InBlock1", "FID_SRCH_COND_GRP" , 	0 , g_KeywordNum)
		end if
		
		DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a", "InBlock1", "FID_SRCH_COND" , 		0 , sRet)
		DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a", "InBlock1", "FID_CHAN_MDIA_CLCD" ,	0 , "010")
		DATAMANAGER.RequestTranData("ohhts_kwdn_001a")
		
		Grid_reDraw("add",sRet)
		
		
		'Form.SaveConfigData("mhnws44050", "keyword", g_Keyword)
		'Form.SaveConfigData("mhnws44050", "keywordNum", g_KeywordNum)
		
	elseif sKeyName == "keywordDelete" then
		
		g_KeywordList(Cint(sRet)) = ""
		g_Keyword = ""
		
		for i = 0 to g_KeywordNum -1 
			if i == 0 then
				if g_KeywordList(i) == "" then
				
				else
					g_Keyword = g_KeywordList(i)
				end if
			
			else		
					
				if g_KeywordList(i) == "" then
					
				else
					if Cint(sRet) == 0 and i == 1 then'
					g_Keyword = g_KeywordList(i)'
					else'
					g_Keyword = g_Keyword & "★" & g_KeywordList(i)
					end if'
				end if
			end if
		next
		
		g_KeywordList = Split(g_Keyword, "★")
		
		g_KeywordNum = g_KeywordNum -1 		
						
		Grid_reDraw()
		
		Form.SaveConfigData("mhnws44050", "keyword", g_Keyword)
		Form.SaveConfigData("mhnws44050", "keywordNum", g_KeywordNum)
	
	elseif sKeyName == "keywordMod" then
		temp = Split(sRet,"●")
		g_Keyword = ""
		g_Keyword = temp[0]
		g_KeywordNum = Cint(temp[1])
		g_KeywordList = ""
		g_KeywordList = Split(g_Keyword, "★")
		
		DATAMANAGER.ClearInputData(0,"ohhts_kwdn_001a_1" )
		
		if g_KeywordNum == 0 then
			DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a_1", "InBlock1", "FID_CLS" , 0 , "3")
			DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a_1", "InBlock1", "FID_USER_ID" , 0 , g_UserID)
			DATAMANAGER.RequestTranData("ohhts_kwdn_001a_1")
		else
			for i = 0 to g_KeywordNum - 1
			
				DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a_1", "InBlock1", "FID_CLS" , i , "2")
				DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a_1", "InBlock1", "FID_USER_ID" , i , g_UserID)
				
				if i < 10 then
					DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a_1", "InBlock1", "FID_SRCH_COND_GRP" , i , "0"&i)
				else
					DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a_1", "InBlock1", "FID_SRCH_COND_GRP" , i , i)
				end if
				
				DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a_1", "InBlock1", "FID_SRCH_COND" , i , g_KeywordList(i))
				DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001a_1", "InBlock1", "FID_CHAN_MDIA_CLCD" , i , "010")
			next
			
			DATAMANAGER.RequestTranData("ohhts_kwdn_001a_1")
		
		end if
		
		'Form.SaveConfigData("mhnws44050", "keyword", g_Keyword)
		'Form.SaveConfigData("mhnws44050", "keywordNum", g_KeywordNum)
		
	elseif sKeyName == "mhnws44050_p3" then
		Form.triggerEvent("#", "mhnws44050_p3", Cstr(sRet))
	end if
	
	
End Sub



'=============================================================================
'키워드 등록 여부 검사
'=============================================================================
Sub Check_Keyword_Exist()

	if Cint(g_KeywordNum) >= 1 then
		Label0.visible = false
		grd01.visible = true
	else
		Label0.visible = true
		grd01.visible = false
		
	end if
	
End Sub


'=============================================================================
'키워드 새로 고침
'=============================================================================
Sub Setting_Keyword(new_Keyword)
	rIdx = grd01.rowcount
	
	grd01.insertrow = g_KeywordNum - 1 
	
	grd01.SetCellData("bd_cell0", rIdx , "#" & new_Keyword)
End Sub

'=============================================================================
' 그리드 다시 그리기
'=============================================================================
Sub Grid_reDraw(Cls,sRet)
		if g_KeywordNum == 0 then
			Label0.visible = true
			grd01.visible = false
		else
			Label0.visible = false
			grd01.visible = true
					
			if Cls == "add" then
			'grd01.AddRow()
				if g_KeywordNum == 1 then
					grd01.SetClear()
					grd01.AddRow()
				end if
				
				grd01.SetCellData("bd_cell0", g_KeywordNum-1 , "#" & sRet)
				DATAMANAGER.SetDataValue(0, "ohhts_kwdn_002r_1", "InBlock1", "FID_SRCH_COND" , 0 , sRet)
				DATAMANAGER.RequestTranData("ohhts_kwdn_002r_1")
			
			elseif Cls == "mod" then		
				grd01.SetClear()
				DATAMANAGER.SetDataValue(0, "ohhts_kwdn_001r", "InBlock1", "FID_USER_ID" , 0 , g_UserID)
				DATAMANAGER.RequestTranData("ohhts_kwdn_001r")
			end if			
		end if
End Sub

 '============================================================================
Sub Form_OnFormClose()

	Form.SetSharedData("keyword" , g_Keyword)
	Form.SetSharedData("keywordNum" , g_KeywordNum)
	
	
	Form.SaveConfigData("mhnws44050", "keyword", g_Keyword)
	Form.SaveConfigData("mhnws44050", "keywordNum", g_KeywordNum)
	'Form.LoadConfigData("keyword", g_Keyword)
	'Form.LoadConfigData("keywordNum", g_KeywordNum)
	
End Sub

'============================================================================
Sub grd01_OnClickUp(lRow, szCellID)
	Form.OpenFramePopup("mhnws44050_p3" , Mid(grd01.GetCellData("bd_cell0", lRow),2) ,"")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "refresh" then
		'20170529 NOHES START : 초기 안내 팝업 제공
		sCheck = Form.LoadConfigData("KeywordNews", "KeyPopup")
	
		if sCheck <> "1" then
			Form.OpenPopup("mhnws44050_p5","1","")
		end if
		'20170529 NOHES END
		Image2_OnClick()
	end if
		
End Sub


'============================================================================
Sub Image3_OnClick()
	Form.OpenPopup("mhnws44050_p5","1★Click","")
	
End Sub

'============================================================================
Sub LblMore_OnClick()
	Form.OpenScreen("44050","")
End Sub

