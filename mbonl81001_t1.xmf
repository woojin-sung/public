'============================================================================
' 01. 화 면 명 : 지연이체서비스_지연이체서비스신청
' 02. 화면설명 : 지연이체서비스_지연이체서비스신청 탭
' 03. 작    성 : 2016.06.22 : 김유경
'			 : 2020.09.16 : 권오상 : v001 : T2008250015 : 메모리평문 취약점 수정
'              : 2021.02.22. : 장원혁 : v002 : T2011170001 : 모바일 OTP 적용
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szList			'계좌번호와 비밀번호
Dim g_szPassWord		'비밀번호
Dim szDsgtCls			'약정여부
Dim g_szPW			'비밀번호
Dim SPLM_ATHN_STPL_YN  '추가인증여부
Dim g_sUserID
Dim	g_PlainRm 'v0
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID )
	if szTranID == "obpds_srvc_412r" then	'지연이체 서비스 약정 조회
		edtServiceStatus.caption = ""
			
		DATAMANAGER.SetDataValue(0, "obpds_srvc_412r", "InBlock1", "SVCD" , 0 , "069"		 )	'서비스코드:지연이체서비스
		DATAMANAGER.SetDataValue(0, "obpds_srvc_412r", "InBlock1", "ACNO" , 0 , g_szList(0))	'계좌번호
		DATAMANAGER.RequestTranData("obpds_srvc_412r")
	end if
	
	if szTranID == "obpds_srvc_411a" then	'지연이체 서비스 약정 등록
		if szDsgtCls == "Y" then			
			DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "PROS_CLS_CODE" , 0 , "D"		) '약정해지
		else 
			DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "PROS_CLS_CODE"	, 0 , "I"		) '약정등록
		end if
		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "SVCD" 			, 0 , "069"		) '서비스코드:지연이체서비스
		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "SVC_MANG_UNIT_CODE"	, 0 , "01"		) '고객단위:고객
		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "ACNO"			, 0 , g_szList(0)	) '계좌번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "CONT_CLS_CODE"		, 0 , "4"		) '접촉구분코드: 온라인
		DATAMANAGER.SetDataValue(0, "obpds_srvc_411a", "InBlock1", "ACNT_PWD" 		, 0 , g_szPW		) '계좌비밀번호
		DATAMANAGER.RequestTranData("obpds_srvc_411a")
	elseif szTranID == "obcsb_oimf_638r" then
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , g_sUserID)
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000")'기본 '200'  등록 '400'
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID())	'UI단말식별키
		DATAMANAGER.RequestTranData("obcsb_oimf_638r")
	end if
End Function
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v001
	g_sUserID = Form.GetSharedData("CERT_ID" , false)
	if g_sUserID == null or g_sUserID == "" then
		g_sUserID = Form.GetSharedData("&USER_ID" , false)
	end if
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName <> "서비스신청" then
		Exit Sub
	end if

	g_szList = Split(sParam, "★")
		
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
		
'	g_szPW = Form.GetEncData(g_szList(1)) 'v001
	'v001
	If g_PlainRm = "1" Then '보안모듈 적용
		g_szPW = g_szList(1) 'v001
	Else
		g_szPW = Form.GetEncData(g_szList(1)) 'v001
	End If

	
	'지연이체 서비스 약정 조회
	Call TR_Inquiry("obpds_srvc_412r")		
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obpds_srvc_412r" then	'지연이체서비스 약정 조회
		
		szDsgtCls = Trim(DATAMANAGER.GetDataValue(0, "obpds_srvc_412r", "OutBlock2", "STPL_YN" , 0)) '약정여부

		if szDsgtCls == "Y" then
			edtServiceStatus.caption = "약정"
			btnEnroll.caption = "해지"
		else
			edtServiceStatus.caption = "미약정"
			btnEnroll.caption = "등록"
		end if 
	elseif szTranID == "obpds_srvc_411a" then	'지연이체서비스 약정 등록/해지
		if szDsgtCls == "Y" then	
			Form.ShowAlert( "알림" , "해지가 완료되었습니다.")
		else 
			Form.ShowAlert( "알림" , "신청이 완료되었습니다.")
		end if
		
		'지연이체 서비스 약정 조회
		Call TR_Inquiry("obpds_srvc_412r")
	elseif szTranID == "obcsb_oimf_638r" then
		'무조건 추가인증 태움.
		'SPLM_ATHN_STPL_YN = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SPLM_ATHN_STPL_YN" , 0)) 
		
		'if DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SPLM_ATHN_STPL_YN" , 0) == "Y" then	'추가인증약정여부
				
			if DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "0" then	'보안카드
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "1" then	'부가정보
				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
			elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "2" then	'보안매체없음
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 이용단말등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "3" then	'OTP
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			elseif DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0) == "4" then	'mOTP v002
			    Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "" )
			else			'오류
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
			end if
		'else '추가인증하지 않아도 됨
			'Call SendReg()
		'end if	
	end if
End Sub 
'============================================================================
' 등록/해지
'============================================================================
Sub btnEnroll_OnClick()
	Dim TopPW	'어미 화면의 PW 체크
	TopPW = Form.GetCtlProp( "#edtPW", "caption")
	
	if g_szPW== "" or TopPW == "" then		'비밀번호 입력요구창
		Form.MsgBox("알림", "비밀번호를 입력해 주십시오.", 0, 6)
		Exit Sub
	else
		if szDsgtCls == "Y" then	
			Form.OpenFramePopup("mhetc90060_p8" , "bank_delete" , "") '해지
		else
			Form.OpenFramePopup("mhetc90060_p8" , "bank_insert" , "") '등록
		end if
		'지연이체 서비스 약정 등록/해지
		'Call TR_Inquiry("obpds_srvc_411a")			
	end if	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================s
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr

	if szTranID == "obpds_srvc_412r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_412r" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	elseif szTranID == "obpds_srvc_411a" then
			szSubErr = DATAMANAGER.GetDataMsgSubText( "obpds_srvc_411a" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		g_nSuccesCount = 0
	end if
End Sub
'============================================================================
' Form_OnPopupReturn 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p8" then	'추가인증 
	
		if sRet == "ok" then	'추가인증성공 -> 보안매체조회 및 인증
			Call TR_Inquiry("obcsb_oimf_638r")	
		else
			Form.CloseForm( )
			exit sub
		end if
	end if
	
	if sKeyName == "mhetc90060_p9" then	'보안카드(보안매체1)
		if sRet == "ok" then			'성공
			Call SendReg()		
		else 					'실패
			exit sub
		end if	
	end if
	
	
	if sKeyName == "mhetc90060_pa" then	'부가정보인증
		if sRet == "ok" then			'성공
			Call SendReg()	
		else 					'실패
			exit sub
		end if
	end if
	
	
	if sKeyName == "mhetc90060_pb" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
			Call SendReg()	
		else						'실패		
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_motp" then	'모바일OTP v002
		if sRet == "ok" then			'성공
			Call SendReg()	
		else						'실패		
			exit sub
		end if	
	end if	
	
	if sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			Call TR_Inquiry("obpds_srvc_411a")
		else						'실패
			exit sub
		end if
		
	end if
	
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
'	if sKeyName == "mhetc90190_p1" then										
'		'if sRet == "ok" then									
'		'end if
'	end if 
	
End Sub 
'============================================================================
' SendReg
'============================================================================
Function SendReg()
	Form.OpenFramePopup("mhetc90060_p5" , "" , "")
	'Call TR_Inquiry("obpds_srvc_411a")		
End Function

'============================================================================
'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
'============================================================================
Sub RegisterOTP()
	'계좌번호★주민번호(필수아님)★Y/N( 모바일OTP/타기관OTP 발급 완료 후 인증 처리 진행여부를 판단함)★Y/N(처리 완료시 화면닫기)	
	Form.OpenPopup("mhetc90190_p1", g_szList(0) &"★"& "" &"★"& "N" &"★"& "Y", "")	
End Sub
	</SCRIPT_INFO>
