'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	Dim tData
'	Form.ShowAlert("PopupReturn", sKeyName & " : " & sRet)
	
	if sKeyName == "SEARCH_DATE" then
		'조회 날짜 선택 후
		tData = Split(sRet, "|")
		
		g_szDateType = tData(0)
		g_szStartDate = tData(1)
		g_szEndDate = tData(2)
		
		contMain.lblDate.caption = Mid(g_szStartDate, 3, 2) & "." & Mid(g_szStartDate, 5, 2) & "." & Right(g_szStartDate, 2) &
								 " ~ " &
								 Mid(g_szEndDate, 3, 2) & "." & Mid(g_szEndDate, 5, 2) & "." & Right(g_szEndDate, 2)
							 
		f_sendQry()
		
	
	'===============================================
	'********** 신청내역 취소 팝업       ***********
	'===============================================
	elseif sKeyName == "mbonl88061_p2" then
		if sRet == "cancel" then
			Dim sSendData
			
'			sSendData = Container0.cmbAccount.total&Container0.cmbAccount.sequence&"☆"&"0"
			sSendData = g_szAcno&g_szAsno&"☆"&"0"
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")
		end if
	
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	elseif sKeyName == "CORRECT_PWD" then
		if sRet <> "" then
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				DATAMANAGER.RequestTranData( "obsac_deal_209a" )	'온라인 전단채 매수취소 신청
			end if
		end if
		
	elseif sKeyName == "errMsgBox" then
		'단기사채 취소주문 확인 후
		if sRet == "Mid" then
			f_sendQry()
		
		end if
		
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szTranID == "obsac_deal_209a" then
		if szErrCode == "7246" or szErrCode == "9906" then
			Form.ShowAlert( "알림" , szSubErr)
			'Exit Sub
			
		else
			if szSubErr <> null and Trim(szSubErr) <> "" then
				Form.ShowAlert( "알림" , szTranID .. "\n" .. szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
			else
				Form.ShowAlert( "알림" , szTranID .. "\n" .. szErrCode .. " : ".. szErrMsg)
			end if
		end if
	else
		if szSubErr <> null and Trim(szSubErr) <> "" then
			Form.ShowAlert( "알림" , szTranID .. "\n" .. szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
		else
			Form.ShowAlert( "알림" , szTranID .. "\n" .. szErrCode .. " : ".. szErrMsg)
		end if
		
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obsab_deal_607r" then
		Dim szTradeType, szSymbolType
		
		select case CInt(contMain.cmbSort1.cbkeydata)
			case 0	szTradeType = "%"	'전체
			case 1	szTradeType = "2"	'매수
			case 2	szTradeType = "1"	'매도
		end select
		
		select case CInt(contMain.cmbSort2.cbkeydata)
			case 0	szSymbolType = "00"	'전체
			case 1	szSymbolType = "12"	'단기사채
			case 2	szSymbolType = "09"	'채권(장외)
			case 3	szSymbolType = "99"	'채권(장내)
		end select
				
'		Form.ShowAlert("TranBefore1", contMain.cmbSort2.cbkeydata)
				
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE",	0, g_szQry_Code) '1:전체조회, 2:개별조회
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",			0, g_szACNO)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",			0, g_szASNO)
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD",		0, "")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STA_DATE",		0, g_szStartDate)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FIN_DATE",		0, g_szEndDate)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "DEAL_CLS_CODE",	0, szTradeType)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROD_TPCD",		0, szSymbolType)
		
	elseif szTranID == "obsac_deal_210r" then
		if g_bSingle then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ODER_DATE",		0, contMain.gridDataSingle.GetCellData("TR_DATE", g_szSelectedRow)) '주문일자
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OM_ODER_SRNO",	0, contMain.gridDataSingle.GetCellData("TR_SRNO", g_szSelectedRow)) '장외주문일련번호
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ODER_DATE",		0, contMain.gridData.GetCellData("TR_DATE", g_szSelectedRow)) '주문일자
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OM_ODER_SRNO",	0, contMain.gridData.GetCellData("TR_SRNO", g_szSelectedRow)) '장외주문일련번호
		end if
	
	'전자단기사채 온라인 매수취소 처리
	elseif szTranID == "obsac_deal_209a" then
		g_Order_ProsCode = "2"
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE",	0, g_Order_ProsCode)	'1:신청/2:취소
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",			0, g_AccNo )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",			0, g_AccSeq )
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD",			0, g_IsCd )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODQT",			0, g_Deal_Qty )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "DEAL_AMT",		0, g_DEAL_AMT )
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ODER_DATE",		0, g_Order_Date)	'주문 일자
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OM_ODER_SRNO",	0, g_Order_Srno)	'장외주문일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OMS_SRNO",		0, g_Oms_Srno)	'장외결제일련번호
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szData, iDataCnt, iHeight
	
	if szTranID == "obsab_deal_607r" then
		if g_bSingle then
			g_iDataCount = contMain.gridDataSingle.rowcount
		else
			g_iDataCount = contMain.gridData.rowcount
		end if
		
				
		iDataCnt = CInt(DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1" ))
		
		for i = 0 to iDataCnt - 1
			szTemp1  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DEAL_CLS_CODE",			i)	'매매구분코드
			szTemp2  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROD_TPCD",				i)   '상품유형코드
			szTemp3  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD",					i)   '종목코드
			szTemp4  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISNM",					i)   '종목명
			szTemp5  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BOND_DIV_NAME",			i)   '채권분류명
			szTemp6  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BYOV_DATE",				i)   '매수일자
			szTemp7  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MTRT_DATE",				i)   '만기일자
			szTemp8  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "QTY",						i)   '수량
			szTemp9  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UNPR",					i)   '단가
			szTemp10 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DEAL_AMT",				i)   '매매금액
			szTemp11 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TR_DATE",					i)   '거래일자
			szTemp12 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TR_SRNO",					i)   '거래일련번호
			szTemp13 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BYOV_ERT",				i)   '매수수익률
			szTemp14 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FEE_ERNN_AMT",				i)   '수수료수익금액
			szTemp15 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WTAX_AMT",				i)   '제세금금액
			szTemp16 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_PROS_RSLT_CLS_CODE",	i)   '주문처리결과구분코드  04:매수완료 03:취소완료/발행준비중
			szTemp17 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CNCL_YN",					i)   '취소여부  Y:취소완료  그외: 발행준비중
			
			szTemp18 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SHTR_BOND_REG_CLS_CODE",	i)   '단기사채등록구분코드
			szTemp19 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KOR_ISNM",				i)   '한글종목명
			szTemp20 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "GNRL_INTRT",				i)   '일반이자율
			szTemp21 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CP_TAX_LEVY_CLS_CODE",		i)   'CP세금징수구분코드
			szTemp22 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PBLC_DATE",				i)   '발행일자
			szTemp23 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OMS_SRNO",				i)   '장외결제일련번호
			szTemp24 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ACNO",					i)   '계좌번호
			szTemp25 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ASNO",					i)   '계좌일련번호
			
			
			if g_bSingle then
				contMain.gridDataSingle.AddRow()
				
				if szTemp1 == "1" then		
					'매도
					contMain.gridDataSingle.SetCellImage("bd_badge1",	g_iDataCount + i, "img_bgsquare_grade_363.png")				
					
					contMain.gridDataSingle.SetCellData("bd_badge1",	g_iDataCount + i, "매도")
					contMain.gridDataSingle.SetCellFgColor("bd_badge1", g_iDataCount + i, "345")
					
				else
					'매수
					contMain.gridDataSingle.SetCellImage("bd_badge1",	g_iDataCount + i, "img_bgsquare_grade_366.png")
					
					contMain.gridDataSingle.SetCellData("bd_badge1",	g_iDataCount + i, "매수")
					contMain.gridDataSingle.SetCellFgColor("bd_badge1",	g_iDataCount + i, "346")
					
				end if
				
				'단기사채일 경우, 취소완료이면 표시
				if szTemp2 == "12" and szTemp16 == "03" and szTemp17 = "Y" then
					contMain.gridDataSingle.SetCellImage("bd_badge1",	g_iDataCount + i, "img_bgsquare_grade_316.png")
					contMain.gridDataSingle.SetCellData("bd_badge1",	g_iDataCount + i, "취소완료")
					contMain.gridDataSingle.SetCellFgColor("bd_badge1",	g_iDataCount + i, "334")
					
					'채권분류명
					if szTemp5 <> "" then
						contMain.gridDataSingle.SetCellImage("bd_badge2", g_iDataCount + i, "img_bgsquare_grade_363.png")
						contMain.gridDataSingle.SetCellData("bd_badge2",	g_iDataCount + i, szTemp5)
					else
						if szTemp2 == "12" then
							contMain.gridDataSingle.SetCellImage("bd_badge2", g_iDataCount + i, "img_bgsquare_grade_363.png")
							contMain.gridDataSingle.SetCellData("bd_badge2",	g_iDataCount + i, "단기사채")
						end if
					end if
				else
					'만기상환 여부에 따라 표시
					'20240221 만기상환시 뱃지 3개로 표현 (예) 매수/만기상환/단기사채)
					sTODAY		= CInt(Form.GetSharedData("&HOST_DATE", false))
					if sTODAY > CInt(szTemp7) then
						contMain.gridDataSingle.SetCellImage("bd_badge2",	g_iDataCount + i, "img_bgsquare_grade_365.png")				
						contMain.gridDataSingle.SetCellData("bd_badge2", 	g_iDataCount + i, "만기상환")
						contMain.gridDataSingle.SetCellFgColor("bd_badge2", g_iDataCount + i, 334)
						
						'채권분류명
						if szTemp5 <> "" then
							contMain.gridDataSingle.SetCellImage("bd_badge3", g_iDataCount + i, "img_bgsquare_grade_363.png")
							contMain.gridDataSingle.SetCellData("bd_badge3",	g_iDataCount + i, szTemp5)
						else
							if szTemp2 == "12" then
								contMain.gridDataSingle.SetCellImage("bd_badge3", g_iDataCount + i, "img_bgsquare_grade_363.png")
								contMain.gridDataSingle.SetCellData("bd_badge3",	g_iDataCount + i, "단기사채")
							end if
						end if
					else
						'채권분류명
						if szTemp5 <> "" then
							contMain.gridDataSingle.SetCellImage("bd_badge2", g_iDataCount + i, "img_bgsquare_grade_363.png")
