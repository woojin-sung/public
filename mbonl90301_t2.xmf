	<SCRIPT_INFO _len="51451" _ulen="47923" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 장외채권 상품 주문 현황
' 02. 화면설명 : 장외채권 상품 주문 현황
'                

' 03. 이    력 : 
' - 2023.11.01 : 윤혁 : v0001 : 신규개발


'-------------------------------------------------------------------------------------------

'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_szLinkData, g_szList
Dim g_szDateType, g_szStartDate, g_szEndDate
Dim g_szACNO, g_szASNO, g_Pwd	'Query 보낼때 사용하는 계좌 정보
Dim g_szQry_Code 'Query 보낼때 사용
Dim g_szSymbolCode
Dim g_iAccountCount
Dim g_szAccountList
Dim g_iDataCount
Dim g_szSelectAcc, g_szSelectAccSeq
Dim g_szAccList

'g_bSingle : 개별계좌 요청시
Dim g_bSingle, g_bQry_deal_607r, g_iQry_deal_607r_Index

g_szStartDate = ""
g_szEndDate = ""


'-------단기사채 취소 프로세스에서 사용
Dim g_szSelectedRow
Dim g_Order_ProsCode	'처리구분 2:취소
Dim g_AccNo		'계좌번호
Dim g_AccSeq		'계좌일련번호
Dim g_IsCd		'종목코드
Dim g_Deal_Qty	'주문수량
Dim g_DEAL_AMT	'매매금액
Dim g_Order_Date	'주문일자
Dim g_Order_Srno	'장외주문일련번호
Dim g_Oms_Srno	'장외결제일련번호
Dim g_szToday

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Function f_getAccFullName(szAcNo, szAsNo)
	Dim szAcc
	Dim szResult
	
	szAcc = Left(szAcNo, 4) & "-" & Right(szAcNo, 4) & "-" & szAsNo
	
'	Form.ShowAlert("f_getAccFullName", g_szList(4) .. "\n\n" .. szAcc)
	szResult = ""
	for i = 0 to CInt(g_iAccountCount) - 1
		if InStr(g_szAccountList(i), szAcc) > 0 then
			szResult = g_szAccountList(i)
			
'			Form.ShowAlert("f_getAccFullName2", szResult)
			
'			return szResult			
			exit for
			
		end if
	next
	
	return szResult 
end function

'============================================================================
Sub f_InitCtrl()
	contMain.gridData.rowcount = 0
	contMain.gridDataSingle.rowcount = 0	
end sub

'============================================================================
'for문에서 동시에 TR 요청시 제대로 못받는 경우가 생겨서 순차적으로 요청
Sub f_SendIndexQry(iStart, iEnd, szTranID)
'	Form.ShowAlert("f_SendIndexQry1", iStart & " : " &
'								 iEnd & " : " &
'								 szTranID & " : " &
'								 g_iQry_deal_607r_Index)
								 
	if CInt(g_iQry_deal_607r_Index) > CInt(iEnd) then
'		Form.ShowAlert("f_SendIndexQry2", g_iQry_deal_607r_Index)
		
		g_bQry_deal_607r = False
		
		Exit Sub
	
	else
'		Form.ShowAlert("f_SendIndexQry3", g_iQry_deal_607r_Index)
		
		if szTranID == "obsab_deal_607r" then
			g_szACNO = Left(g_szAccList(g_iQry_deal_607r_Index), 8)
			g_szASNO = Right(g_szAccList(g_iQry_deal_607r_Index), 2)

			DATAMANAGER.RequestTranData(szTranID)
			
		end if
		
		g_iQry_deal_607r_Index = CInt(g_iQry_deal_607r_Index) + 1
	end if
	
end Sub

'============================================================================
Sub f_sendQry()
	f_InitCtrl()
	
	if g_szSelectAcc == "전체" then
		g_bSingle = False
		contMain.gridData.visible = True
		contMain.gridDataSingle.visible = False
		
'		Form.ShowAlert("f_sendQry", g_szSelectAcc & " : " & g_szList(2))
		
		g_szAccList = split(g_szList(3), "○")
				
'		g_iQry_deal_607r_Index = 0
'		g_bQry_deal_607r = True
'		f_SendIndexQry(0, CInt(g_szList(2)) - 1, "obsab_deal_607r")
		
		g_szQry_Code = 1
		g_szACNO = Left(g_szAccList(0), 8)
		g_szASNO = Right(g_szAccList(0), 2)
		DATAMANAGER.RequestTranData("obsab_deal_607r")
		
'		for i = 0 to CInt(g_szList(2)) - 1
'			g_szACNO = Left(g_szAccList(i), 8)
'			g_szASNO = Right(g_szAccList(i), 2)
'						
'			DATAMANAGER.RequestTranData("obsab_deal_607r")
'		next
		
	else
		g_bSingle = True
		contMain.gridData.visible = False
		contMain.gridDataSingle.visible = True
		
		g_szQry_Code = 2
		g_szACNO = g_szSelectAcc
		g_szASNO = g_szSelectAccSeq
		
		DATAMANAGER.RequestTranData("obsab_deal_607r")
		
	end if

end sub

