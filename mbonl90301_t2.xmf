		nSELN_EXCL_AMT = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SELN_EXCL_AMT", 0))
		
		nTotTax = nINTX + nRSTX
		
		if g_bSingle then
			'종목명, 매매구분, 액면금액(수량), 결제금액, 수익률, 세금납입방식, 신청일, 매수일(매수신청일자), 만기일
			szLinkData = ""
			szLinkData =	contMain.gridDataSingle.GetCellData("ISNM",		g_szSelectedRow)	'종목명
			
			'매매구분
			szValue = contMain.gridDataSingle.GetCellData("DEAL_CLS_CODE",	g_szSelectedRow)
			if szValue == "2" then
				szValue = "매수"
			end if
			szLinkData =	szLinkData & "★" & szValue									'매매구분
			
			szLinkData =	szLinkData & "★" & contMain.gridDataSingle.GetCellData("QTY",		g_szSelectedRow)	'액면금액(수량)
			szLinkData =	szLinkData & "★" & contMain.gridDataSingle.GetCellData("DEAL_AMT",	g_szSelectedRow)	'결제금액
			szLinkData =	szLinkData & "★" & contMain.gridDataSingle.GetCellData("BYOV_ERT",	g_szSelectedRow)	'수익률
			szLinkData =	szLinkData & "★" & "후취"			'세금납입방식, 
			szLinkData =	szLinkData & "★" & nSTAS_AMT		'과표금액
			szLinkData =	szLinkData & "★" & nTotTax			'소득세+주민세
			szLinkData =	szLinkData & "★" & nSELN_EXCL_AMT	'매도단가
			szLinkData =	szLinkData & "★" & contMain.gridDataSingle.GetCellData("BYOV_DATE",	g_szSelectedRow)	'신청일		
			
			if contMain.gridDataSingle.GetCellData("SHTR_BOND_REG_CLS_CODE",	g_szSelectedRow) == "2" then	'유통물
				szLinkData =	szLinkData & "★" & contMain.gridDataSingle.GetCellData("BYOV_DATE",	g_szSelectedRow)	'매수일(유통물: 매수신청일자)
			else
				szLinkData =	szLinkData & "★" & contMain.gridDataSingle.GetCellData("PBLC_DATE",	g_szSelectedRow)	'매수일(발행물:발행일자)
			end if
	
			szLinkData =	szLinkData & "★" & contMain.gridDataSingle.GetCellData("MTRT_DATE",	g_szSelectedRow)	'만기일
			
		else
			'종목명, 매매구분, 액면금액(수량), 결제금액, 수익률, 세금납입방식, 신청일, 매수일(매수신청일자), 만기일
			szLinkData = ""
			szLinkData =	contMain.gridData.GetCellData("ISNM",		g_szSelectedRow)	'종목명
			
			'매매구분
			szValue = contMain.gridData.GetCellData("DEAL_CLS_CODE",	g_szSelectedRow)
			if szValue == "2" then
				szValue = "매수"
			end if
			szLinkData =	szLinkData & "★" & szValue									'매매구분
			
			szLinkData =	szLinkData & "★" & contMain.gridData.GetCellData("QTY",		g_szSelectedRow)	'액면금액(수량)
			szLinkData =	szLinkData & "★" & contMain.gridData.GetCellData("DEAL_AMT",	g_szSelectedRow)	'결제금액
			szLinkData =	szLinkData & "★" & contMain.gridData.GetCellData("BYOV_ERT",	g_szSelectedRow)	'수익률
			szLinkData =	szLinkData & "★" & "후취"			'세금납입방식, 
			szLinkData =	szLinkData & "★" & nSTAS_AMT		'과표금액
			szLinkData =	szLinkData & "★" & nTotTax			'소득세+주민세
			szLinkData =	szLinkData & "★" & nSELN_EXCL_AMT	'매도단가
			szLinkData =	szLinkData & "★" & contMain.gridData.GetCellData("BYOV_DATE",	g_szSelectedRow)	'신청일		
			
			if contMain.gridData.GetCellData("SHTR_BOND_REG_CLS_CODE",	g_szSelectedRow) == "2" then	'유통물
				szLinkData =	szLinkData & "★" & contMain.gridData.GetCellData("BYOV_DATE",	g_szSelectedRow)	'매수일(유통물: 매수신청일자)
			else
				szLinkData =	szLinkData & "★" & contMain.gridData.GetCellData("PBLC_DATE",	g_szSelectedRow)	'매수일(발행물:발행일자)
			end if
	
			szLinkData =	szLinkData & "★" & contMain.gridData.GetCellData("MTRT_DATE",	g_szSelectedRow)	'만기일
		end if
		
		Form.openPopupAnimation( "mbonl88061_p1", szLinkData, "", "2")
		
	elseif szTranID == "obsac_deal_209a" then	'전자단기사채 온라인 매수취소 처리
		sOM_ODER_SRNO = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OM_ODER_SRNO" , 0)

		g_ErrTitle = "안내"
		g_ErrMsgText = "단기사채 주문이\n취소 되었습니다."
		
		szAlertData = "1".."★"..g_ErrTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."확인"'.."★".."투자성향 등록"
		
		Form.OpenPopup("mbonl88060_p8", szAlertData, "")
		
	end if
End Sub

'============================================================================
Sub contMain_gridData_OnClickUp(lRow, szCellID)
	Dim szLinkData, szValue, szType, szODER_PROS, szCNCL_YN
	
	szType = contMain.gridData.GetCellData("PROD_TPCD",	lRow)	'상품유형코드 09:장외채권, 99:장내채권, 12:단기사채.
	szODER_PROS = contMain.gridData.GetCellData("ODER_PROS_RSLT_CLS_CODE",	lRow)
	szCNCL_YN = contMain.gridData.GetCellData("CNCL_YN",	lRow)
	
	
	
	'단기사채일 경우 취소하기 클릭했을 경우
	if (szCellID == "bd_buyamt2") and (szType == "12") and 
	   (szODER_PROS == "03") and (szCNCL_YN <> "Y") then
	   
		if Trim(contMain.gridData.GetCellData("bd_buyamt2", lRow)) == "" then
			Exit Sub
			
		else
			g_szSelectedRow = lRow
			
			g_Order_ProsCode = 2										'매매구분
			g_AccNo 	= contMain.gridData.GetCellData("bd_acno",		g_szSelectedRow)	'계좌번호
			g_AccSeq = contMain.gridData.GetCellData("bd_asno",		g_szSelectedRow)  '계좌일련번호
			g_IsCd	= contMain.gridData.GetCellData("ISCD",			g_szSelectedRow)	'종목코드
			g_Deal_Qty = contMain.gridData.GetCellData("QTY",			g_szSelectedRow)	'주문수량
			g_DEAL_AMT = contMain.gridData.GetCellData("DEAL_AMT",		g_szSelectedRow)	'매매금액
			g_Order_Date = contMain.gridData.GetCellData("BYOV_DATE",	g_szSelectedRow)	'주문일자
			g_Order_Srno = contMain.gridData.GetCellData("TR_SRNO",	g_szSelectedRow)	'장외주문일련번호
			g_Oms_Srno   = contMain.gridData.GetCellData("OMS_SRNO",	g_szSelectedRow)	'장외결제일련번호
		
			szLinkData = ""
			szLinkData = g_AccNo & g_AccSeq												'계좌번호&계좌순번
			szLinkData =	szLinkData & "★" & contMain.gridData.GetCellData("ISCD",	g_szSelectedRow)	'종목코드
			szLinkData =	szLinkData & "★" & contMain.gridData.GetCellData("ISNM",	g_szSelectedRow)	'종목명
			
			szValue = ""
			if contMain.gridData.GetCellData("DEAL_CLS_CODE", lRow) == "2" then
				szValue = "매수"
			end if			
			szLinkData =	szLinkData & "★" & szValue										'매매구분
			
			szLinkData =	szLinkData & "★" & contMain.gridData.GetCellData("QTY",		g_szSelectedRow)'액면금액
			szLinkData =	szLinkData & "★" & contMain.gridData.GetCellData("DEAL_AMT",	g_szSelectedRow)'결제금액
			
			Form.openPopupAnimation( "mbonl88061_p2" , szLinkData , "", "2")
			
		end if
	
	elseif (szType == "12") then		
		if (szODER_PROS == "03") and (szCNCL_YN == "Y") then
			'단기사채인데 취소완료일 경우는 상세보기 없음.
			exit sub
			
		else	
			g_szSelectedRow = lRow
			
			DATAMANAGER.RequestTranData("obsac_deal_210r")
			
		end if
	
	else
		szLinkData = contMain.gridData.GetCellData("DEAL_CLS_CODE", lRow)					'0 매매구분코드
		szLinkData = szLinkData & "|" & szType											'1 상품유형코드
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("ISCD",		lRow)	'2 종목코드
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("ISNM",		lRow)	'3 종목명
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("BOND_DIV_NAME",lRow)	'4 채권분류명
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("BYOV_DATE",	lRow)	'5 매수일자
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("MTRT_DATE",	lRow)	'6 만기일자
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("QTY",			lRow)	'7 수량
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("UNPR",		lRow)	'8 단가
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("DEAL_AMT",	lRow)	'9 매매금액
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("TR_DATE",		lRow)	'10 거래일자
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("TR_SRNO",		lRow)	'11 거래일련번호
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("BYOV_ERT",	lRow)	'12 매수수익률
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("FEE_ERNN_AMT",	lRow)	'13 수수료수익금액
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("WTAX_AMT",	lRow)	'14 제세금금액
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("ODER_PROS_RSLT_CLS_CODE", lRow)	'15 주문처리결과구분코드
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("CNCL_YN",		lRow)	'16 취소여부
		
		szLinkData = szLinkData & "|" & contMain.gridData.GetCellData("bd_fullacc",	lRow)	'17 계좌번호+이름
		
		'채권보유 현황 상세	
	'	Form.ShowAlert("gridData_OnClickUp", szLinkData)
	'	Form.OpenPopup("mbonl90301_p5", szLinkData, "")
		Form.OpenPopupAnimation("mbonl90301_p5", szLinkData,  "",  2)
	
	end if
		
End Sub

