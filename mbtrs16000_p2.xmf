--===========================================================================
--===========================================================================
Dim g_szAcnt, g_szAcntCd, g_szTab

'============================================================================
' Request_Data()
'============================================================================
Function Request_Data()
	grdList.rowcount = 0

	DATAMANAGER.RequestTranData("obtrs_comn_360r")
	
End Function

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("대주잔고")
	g_szAcnt		= ""
	g_szAcntCd	= ""
	
	Dim szOpenData, tData
	szOpenData = Form.GetOpenLinkData()
	
	if szOpenData <> null and szOpenData <> "" then
'		Form.ShowAlert("", szOpenData)
		tData = Split(szOpenData, "★")
		
		if UBound(tData) > 0 then
			g_szAcnt   	= tData(0)
			g_szAcntCd 	= tData(1)
			g_szTab		= tData(2)
			Request_Data()
		end if
	end if
	
'	TEST 
'	grdList.AddRow( )
'	grdList.SetCellData( "bd_Name", 0, "TEST" )
'	grdList.SetCellData( "bd_Qty", 0, 1000 )
'	grdList.SetCellData( "bd_Able", 0, 1000 )
'	grdList.SetCellData( "bd_loandate", 0, "20211111" )
'	grdList.SetCellData( "bd_enddate", 0, "20211230" )
'	grdList.SetCellData( "bd_Cd", 0, "J005930" )
	
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obtrs_comn_360r" Then
		DATAMANAGER.ClearInputData(0, szTranID)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 		, 0, g_szAcnt 	)		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 		, 0, g_szAcntCd 	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FEE_INCU_YN" , 0, "1" 		)
	End If
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szLoanDate, szLoanCd, szLoanSr
	Dim errmsg
	
	errmsg = "종목마스터의 오류로 주문 및 시세 조회가 불가능합니다. 동일 증상 반복 시 확인 버튼을 눌러 주시기 바랍니다.\n\n ※기타문의사항은 고객지원센터 (1588-3400)로 문의하여 주시기 바랍니다."

	if lRow > -1 then
		szCd       = grdList.GetCellData("bd_Cd",       	lRow) '종목코드
		szQty      = grdList.GetCellData("bd_Able",     	lRow) '보유수량
		szLoanDate = grdList.GetCellData("bd_loandate",	lRow) '대출일
		szLoanCd   = grdList.GetCellData("bd_loancd",		lRow) '대출일련번호
		
		if(left(szCd,1) == "J" and len(szCd) == 9) or left(szCd,1) == "Q" or left(szCd,1) == "F" then
			szMk = Form.GetItemCodeInfo(szCd, "market")
		else
			szCutCd = Mid(szCd,2,len(szCd))
			szMk = Form.GetItemCodeInfo(szCutCd, "market")
		end if
		
		if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then
			'  전달내용/탭위치/종목코드/수량/매수매도구분코드
			szData = "잔고" & "★" & g_szTab & "★" & szCd & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & "" & "♥" & ""
			
			Form.SendReturnToParent("16000_BALANCE", szData)
			Form.CloseForm()
		else
			Form.MsgBox("알림", errmsg, "REUPDATE", 1)		
		end if
	end if
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obtrs_comn_360r" )
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REUPDATE" then
		if sRet == "ok" then
			Form.reUpdateFile("mts_master.crc")
		else
			exit sub
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Form.ShowAlert(szTranID, szErrMsg)
End Sub

