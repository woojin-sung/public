Sub cmbMarket_OnEditComplete(iIndex)
	f_SaveFilterValue()
	
	g_isEmpty_Code = true
	ItemCode0.code = "empty"
	f_SetRdoExValue()
	f_RequestTran()
	
End Sub

'============================================================================
Sub cmbEx_OnEditComplete(iIndex)
	g_isEmpty_Code = true
	ItemCode0.code = "empty"
	
	f_RequestTran()
End Sub
'
'============================================================================
Sub cldFrom_OnEditComplete()
	f_RequestTran()
	
End Sub

'============================================================================
Sub grd1_OnScrollEnd()
	f_RequestNextTran()
	
End Sub

'============================================================================
Sub btnSet_OnClick()
	Form.OpenPopup("mbtre10000_p1" , "", "")
	
End Sub

'============================================================================
Sub grd1_OnClickUp(lRow, szCellID)
	if lRow <> "" then
		dim tItemInfo, szItemInfo, szItemCode, szExSym
		dim szFullCode, szItemName
		
		tCodeInfo = {}
		
		szItemInfo	= grd1.GetCellData( "bd_code", lRow )
		tItemInfo	= split(szItemInfo, ".") '0:종목코드, 1:거래소코드
		
		'20220527 SWJ START : 종목코드에 "."이 들어간 경우 파싱 오류 수정(EX.버크셔해서웨이)
		if instr(szItemInfo,".") <> instrRev(szItemInfo,".") then
			
			sztempExid = Right(szItemInfo,len(szItemInfo) - instrRev(szItemInfo,"."))			
			sztempCode = Replace(szItemInfo,"." & sztempExid,"")
			
			szItemCode = sztempCode
			szExSym = sztempExid
		else
			szItemCode	= tItemInfo(0)
			szExSym		= tItemInfo(1)
		end if
		'20220527 SWJ END 
		
		if szExSym == "" or szExSym == null Then
			Form.ShowAlert("알림", "선택상품은 MTS에서 거래되지 않는 상품입니다.")
			Exit Sub
		end if
		
		szFullCode = szExSym & "@" & szItemCode
		szItemName = Form.GetItemCodeInfo(szFullCode, "name")
		g_szSelectFullCode = szExSym & "@" & szItemCode & "★" & szItemName & "★"

		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName == "SEARCH" then
		if sReturn1 <> "" and sReturn1 <> null then
			g_szFullCode = sReturn1
			g_isEmpty_Code = false
			
			f_RequestTran()
			
		end if
	end if
End Sub

'============================================================================
Sub edtSearch_OnEditComplete()
	g_szSearchWord = edtSearch.caption
	g_isEmpty_Code = false
		
	f_RequestTran()
End Sub

