'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 장외채권 상품 목록 조회
' 02. 화면설명 : 장외채권 상품 목록 간단필터 팝업
'                

' 03. 이    력 : 
' - 2023.11.01 : 윤혁 : v0001 : 신규개발


'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_CurGroup
Dim g_sGroup, g_sPrevGroup
Dim g_bGroup_Item

Dim g_iGroupCount
Dim g_Max_ItemCount

Dim g_SpclYn
Dim g_KycGrad
Dim g_ProsRslt
Dim g_invtYn

'각 그룹별로 선택된 값을 문자열값으로 연결해서 저장 (1|2|4|5)
g_sGroup = {}			'
g_sPrevGroup = {}		'조건값이 변경되었는지 확인하기 위해 처음 상태를 저장

'각 그룹별 필터조건 선택여부를 저장
g_bGroup_Item= {}

'필터 그룹 갯수
g_iGroupCount = 4

'그룹안에 있는 선택 조건 최대 갯수 (전체버튼은 제외)
g_Max_ItemCount = {4, 4, 4, 4}


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'배열 첨자로 접근하여 값을 수정하려고 하면면 main 에서 오류 발생해서 앱이 죽는다.
'해당 위치의 값을 삭제한 후 다시 그 위치로 insert 시켜준다.
'배열 첨자로 접근시는 0 부터 시작 g_sGroup[0]
'table.remove, insert 함수에서 사용시는 1부터 시작
Sub f_editGroupValue(iIndex, szValue)
	table.remove(g_sGroup, iIndex)
	table.insert(g_sGroup, iIndex, szValue)
end Sub

Sub f_editGroupItemValue(iGroupIndex, iIndex, szValue)
	table.remove(g_bGroup_Item[iGroupIndex - 1], iIndex)
	table.insert(g_bGroup_Item[iGroupIndex - 1], iIndex, szValue)
	
end Sub


'============================================================================
Sub cont0_BtnClear_OnClick()
	imgDim_OnClick()
End Sub


'============================================================================
Sub Form_OnFormInitBefore()
	
End Sub

'============================================================================
Sub Form_OnFormInit()	
	Dim szData	
	
	for i=0 to g_iGroupCount-1
		table.insert(g_sGroup, "00")
		table.insert(g_sPrevGroup, "00")
	next

	g_bGroup_Item = {}
	for i=0 to g_iGroupCount-1
		g_bGroup_Item[i] = {}
		for j=0 to g_Max_ItemCount[i]-1
			g_bGroup_Item[i][j] = False
		next
	next
			
	cont0.group1.visible = False
	cont0.group2.visible = False
	cont0.group3.visible = False
	cont0.group4.visible = False
	
	f_setInitCtrls(9)
	
	szData = Form.GetOpenLinkData()
	
	'1번그룹 선택조건★2번그룹 조건★3번그룹조건★4번그룹조건
'	szData = "1★1|2★99★3|4★3|4"
'	Form.ShowAlert("_p3 FormInit1", szData)
	
	'필터그룹★선택조건1★선택조건2★선택조건3★선택조건4
	if szData == "" then
		Exit Sub
	end if
	
	tData = Split(szData, "★")
	
	g_CurGroup = tData(0)
	select case g_CurGroup
		case "1"		cont0.group1.visible = True
		case "2"		cont0.group2.visible = True
		case "3"		cont0.group3.visible = True
		case "4"		cont0.group4.visible = True
	end select
	
'	Form.ShowAlert("FormInit", tData(0) & ":" & tData(1) & ":" & tData(2) & ":" & tData(3) & ":" & tData(4))
	for i=0 to 3
		g_sGroup[i] = tData(i+1)
		g_sPrevGroup[i] = tData(i+1)
	next
	
	'각 그룹마다 선택된 항목 기억
	f_setItemFlags(1)
	f_setItemFlags(2)
	f_setItemFlags(3)
	f_setItemFlags(4)
	
	
	'각 그룹마다 선택된 항목 표시
	f_setCtrls(1)
	f_setCtrls(2)
	f_setCtrls(3)
	f_setCtrls(4)
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
'	btnSearch_OnClick()
'	Form.CloseForm()
End Sub

'============================================================================
Sub imgDim_OnClick()
'	btnSearch_OnClick()
	Form.SendReturnToParent("FILTER_Q_CLOSE" , g_CurGroup)
	Form.CloseForm("")
End Sub

'============================================================================
Sub cont0_btnSearch_OnClick()
	Dim szData
	
	for i=0 to g_iGroupCount - 1
		if g_sGroup[i] == "" or g_sGroup[i] == null then
			f_editGroupValue(i+1, "99")
		end if
	next
		
	szData = g_CurGroup.."★"..g_sGroup[0].."★"..g_sGroup[1].."★"..g_sGroup[2].."★"..g_sGroup[3]
	
'	Form.ShowAlert("Search_OnClick", szData)
	
	Form.SendReturnToParent("FILTER_Q" , szData)
	Form.CloseForm()
End Sub

