'============================================================================
Sub Form_OnFormInit()
	edtChangeAmt.caption = ""
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> Null Then
		'신청금액 세팅
		edtPrevAmt.caption = szOpenData
	End If
End Sub

'============================================================================
Function f_Calc(szNum)
	'숫자 입력
	Dim nAmount, nNum
	nAmount = CInt(edtChangeAmt.caption)
	nNum = CInt(szNum)
	
	If szNum == "0" Or szNum == "00" Then
		If nAmount <= 0 Then
			Exit Function
		Else
			edtChangeAmt.caption = edtChangeAmt.caption & szNum
		End If
	Else
		If nAmount <= 0 Then
			edtChangeAmt.caption = szNum
		Else
			edtChangeAmt.caption = edtChangeAmt.caption & szNum
		End If
	End If
End Function

'============================================================================
Function f_Del()
	'숫자 삭제
	Dim nAmount
	nAmount = CInt(edtChangeAmt.caption)
	
	If nAmount <= 0 Then
		Exit Function
	Else
		edtChangeAmt.caption = Left(edtChangeAmt.caption, Len(edtChangeAmt.caption) - 1)
	End If
	
	If edtChangeAmt.caption == "" Or edtChangeAmt.caption == Null Then
		edtChangeAmt.caption = "0"
	End If
End Function

'============================================================================
Sub btn0_OnClick()
	f_Calc("0")
End Sub

'============================================================================
Sub btn00_OnClick()
	f_Calc("00")
End Sub

'============================================================================
Sub btn1_OnClick()
	f_Calc("1")
End Sub

'============================================================================
Sub btn2_OnClick()
	f_Calc("2")
End Sub

'============================================================================
Sub btn3_OnClick()
	f_Calc("3")
End Sub

'============================================================================
Sub btn4_OnClick()
	f_Calc("4")
End Sub

'============================================================================
Sub btn5_OnClick()
	f_Calc("5")
End Sub

'============================================================================
Sub btn6_OnClick()
	f_Calc("6")
End Sub

'============================================================================
Sub btn7_OnClick()
	f_Calc("7")
End Sub

'============================================================================
Sub btn8_OnClick()
	f_Calc("8")
End Sub

'============================================================================
Sub btn9_OnClick()
	f_Calc("9")
End Sub

'============================================================================
Sub btnDel_OnClick()
	f_Del()
End Sub

'============================================================================
Sub imgAlpha_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnChange_OnClick()
	If edtChangeAmt.caption == "" Or edtChangeAmt.caption == null Then
		Form.ShowAlert("안내", "감액하실 금액을 확인해 주세요.")
		Exit Sub
	End If
	
	If CInt(edtChangeAmt.caption) > CInt(edtPrevAmt.caption) Or CInt(edtChangeAmt.caption) == CInt(edtPrevAmt.caption) Then
		Form.ShowAlert("안내", "감액하실 금액을 확인해 주세요.")
		Exit Sub
	End If
	
	Form.SendReturnToParent("AMT_CHANGE" , edtChangeAmt.caption)
	Form.CloseForm()
End Sub

