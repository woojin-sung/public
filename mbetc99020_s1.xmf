'============================================================================
Sub Form_OnFormInit()

	flag = 0
	tmp=""
	gTempDate =""
	real_cnt = 0

	szData = Form.GetOpenLinkData() ' 0: 가입날짜 1:최초투자금액 2:월투자금액 3:포트폴리오 아이디
	szList = split(szData,"●")
	
	prtf_id = szList(3)
	
	
	'Form.ShowAlert("", szData)
	
	DATAMANAGER.SetDataValue(0, "obcpp_intr_722r", "InBlock2", "PRTF_ID" , 0 , prtf_id )
	DATAMANAGER.RequestTranData("obcpp_intr_722r")
	
	
	
	
	'DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "INP_CLS_CODE" , 0 , 1 )
	'DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "PRTF_ID" , 0 , "203" )
	'DATAMANAGER.RequestTranData("obcpp_intr_759r")
	
	
	'join_date="2016-07-23"
	'sub_date  =  datediff("d", join_date, date)
	'Form.ShowAlert("", sub_date)
	
	'tmp_date =  FormatDatetime("20160801",4)
    'tmp_date = datediff("d", "2016-07-23", date)
	'tmp_date = replace(date,"-","") - szList(0) 
	'Form.ShowAlert("", tmp_date)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcpp_intr_722r" then
	
	tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_722r", "OutBlock1", "ADCP_NAME" , 0)
	Table0.SetCellString(0, 1, tmp)
	
	tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_722r", "OutBlock1", "PRTF_NAME" , 0)
	Table0.SetCellString(1, 1, tmp)
	
	
	Table0.SetCellString(2, 1,szList(0)) ' 가입날짜
	
	
	tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_722r", "OutBlock1", "ANTC_ERT" , 0)
	Table0.SetCellString(3, 1, round(tmp,2)&"%")
	
	
	tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_722r", "OutBlock1", "UI_ERT_MAX_VAL" , 0)
	Table0.SetCellString(4, 1, round(tmp,2)&"%")
	
	tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_722r", "OutBlock1", "UI_ERT" , 0)
	Table0.SetCellString(5, 1, round(tmp,2)&"%")
	
	tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_722r", "OutBlock1", "UI_ERT_MIN_VAL" , 0)
	Table0.SetCellString(6, 1, round(tmp,2)&"%")
	
	
	DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "INP_CLS_CODE" , 0 , 1 )
	DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "PRTF_ID" , 0 , prtf_id)
	DATAMANAGER.RequestTranData("obcpp_intr_759r")
	
	
	elseif szTranID== "obcpp_intr_759r" then
	
	cnt = DATAMANAGER.GetDataCount(0, "obcpp_intr_759r", "OutBlock1" )
	
	'join_date="20160723"
	join_date = Table0.GetCellString(2, 1)
	'join_date =  Left(join_date,4)&"-"&Mid(join_date,5,2)&"-"&Right(join_date,2)
	
	'Form.ShowAlert("",join_date)
	
	'sub_date  =  datediff("d", join_date, date)
	
	
	
	'for i=cnt-sub_date to cnt-1
	for i = 0 to cnt - 1
	
		if cint(join_date) < Cint(DATAMANAGER.GetDataValue(0, "obcpp_intr_759r", "OutBlock1", "PROS_DATE" , i)) then
			
			real_cnt = real_cnt + 1
	
			if i == cnt-1 then
			tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_759r", "OutBlock1", "INP_INDT_VAL" , i)&"●"&tmp
			gTempDate = DATAMANAGER.GetDataValue(0, "obcpp_intr_759r", "OutBlock1", "PROS_DATE" , i)&";"&gTempDate
	
	
			else
			tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_759r", "OutBlock1", "INP_INDT_VAL" , i)&"●"&tmp
			gTempDate = DATAMANAGER.GetDataValue(0, "obcpp_intr_759r", "OutBlock1", "PROS_DATE" , i)&";"&gTempDate
			
			end if
	
	     end if
	
	next
	

	''ex_sz = "2016-07-23" '나중에 join_date로 바꿔줘야함.
	
	
	''for i = 0 to sub_date-1
	'for i = 0 to cnt -1 
	'' for i = cnt-sub_date to cnt-1 
	 'if i ==  cnt - 1 then
	 'sub_date-1 then
		 'gTempDate = gTempDate&dateadd("d",i,join_date)
	'	 gTempDate = DATAMANAGER.GetDataValue(0, "obcpp_intr_759r", "OutBlock1", "PROS_DATE" , i)&";"&gTempDate
		 
      'else
      'gTempDate = DATAMANAGER.GetDataValue(0, "obcpp_intr_759r", "OutBlock1", "PROS_DATE" , i)&";"&gTempDate
	    '  gTempDate = gTempDate&dateadd("d",i,join_date)&";"
	 
	 'end if
		 
	'next
	
	
	
	gTempDate = replace(gTempDate,"-","")
	
	
	'Form.ShowAlert("", gTempDate)
	'Form.ShowAlert("", tmp)
	
	g_List = split(tmp,"●")
	gData = ""
	tmp_frst = 1000 '최초투자금액
	n_amt = 1000 
	
	for i = 0 to real_cnt
	
		if i == 0 then			
		n_amt = 1000 + (1000 * Cdbl(g_List(i))/100)'과거수익률'
		
		else
			if n_amt < 0 and Cdbl(g_List(i)) <0 then
				n_amt = n_amt - (n_amt * Cdbl(g_List(i))/100) 
				
			else 				
				n_amt = n_amt + (n_amt * Cdbl(g_List(i))/100)
				
			end if
		
		end if
		
		
		
		gData = gData&Cstr(round(n_amt,0)-tmp_frst)&";"
	
	next
	
	'Form.ShowAlert("", gData)
	
	 ChartEx0.SetAccrueName("현황")
	ChartEx0.SetAccrueData("initdata="&gTempDate)	
	 ChartEx0.SetAccrueData("자료일자="..gTempDate)
	ChartEx0.SetAccrueData("data1="..gData.."="..gData)
	ChartEx0.SetShowCrossLine("true")
	
	ChartEx0.SetAccrueData("repaintall");
	
	
	
	
	
	
		
	end if
	
End Sub

'============================================================================
Sub Button0_OnClick()

	DATAMANAGER.SetEventFlag("obcpp_intr_757a", "I")
	DATAMANAGER.SetDataValue(0, "obcpp_intr_757a", "InBlock1", "INP_MEMB_SRNO" ,0, 1)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_757a", "InBlock1", "PRTF_ID" ,0, szList(3))
	DATAMANAGER.SetDataValue(0, "obcpp_intr_757a", "InBlock1", "INP_CLS_CODE" , 0,2)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_757a", "InBlock1", "INP_YN_CODE" , 0,0)
	
	DATAMANAGER.RequestTranData("obcpp_intr_757a")
	
	Form.Toast(0,"모의투자가 해제되었습니다." , 0.5)
	Form.CloseForm()
	
End Sub

