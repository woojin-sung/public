'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szAccountNumber	'계좌번호
Dim g_szAccountSerialNumber	'계좌일련번호
Dim g_szAccountPassword	'계좌비밀번호
Dim g_szAccount	'계좌번호+일련번호
Dim g_szAccountName	'계좌명
Dim g_szNextIndex		'연속조회시 Index
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Function TR_Inquiry(szTranID)
	if szTranID == "obtss_igrs_684r" then
		DATAMANAGER.SetDataValue(0,"obtss_igrs_684r", "InBlock1", "BSWR_CLS_CODE"  , 0 , "2")
		DATAMANAGER.SetDataValue(0, "obtss_igrs_684r", "InBlock1", "PROS_CLS" , 0 , "0")
		DATAMANAGER.SetDataValue(0, "obtss_igrs_684r", "InBlock1", "DRNG_TRGT_ACNO" , 0 , g_szAccount)
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_684r", "InBlock1", "IQRY_STA_DATE", 0 , cldFromDate01.caption)
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_684r", "InBlock1", "IQRY_FIN_DATE", 0 , cldToDate01.caption)
		DATAMANAGER.SetDataValue(0, "obtss_igrs_684r", "InBlock1", "CUST_ACNT_CLS_CODE" , 0 , "1")
		
		DATAMANAGER.RequestTranData("obtss_igrs_684r")
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	g_szNextIndex = 0
	if sEventName == "Password" then
		g_szAccountPassword = sParam
	end if
	
	if sEventName == "AllAccount" then
		Dim szList
		szList = Split(sParam, "★")
		
		if UBOUND(szList) < 1 then
			exit sub
		end if
		g_szAccount = szList(0) & szList(1)
		g_szAccountNumber = szList(0)
		g_szAccountSerialNumber = szList(1)
		if szList(2) == "" then
			g_szAccountPassword = ""
		else
			g_szAccountPassword = szList(2)
		end if
		
		g_szAccountName = szList(3)
		
		TR_Inquiry("obtss_igrs_684r")
		
	end if
	
	
	
End Sub


'============================================================================
' cldFromDate01_OnEditComplete 시작일 설정
'============================================================================
Sub cldFromDate01_OnEditComplete()
	g_szNextIndex = 0
	if cldFromDate01.caption > cldToDate01.caption then
		Form.ShowAlert("알림", "조회시작일을 다시 선택해 주세요")
		cldFromDate01.caption = cldToday.caption
		exit sub
	else
		TR_Inquiry("obtss_igrs_684r")
	end if
	
	
End Sub
'============================================================================
' cldToDate01_OnEditComplete - 종료일 설정
'============================================================================
Sub cldToDate01_OnEditComplete()
	g_szNextIndex = 0
	if cldFromDate01.caption > cldToDate01.caption or cldToDate01.caption > cldToday.caption then
		Form.ShowAlert("알림", "조회종료일을 다시 선택해 주세요")
		cldToDate01.caption = cldToday.caption
		exit sub
	else
		TR_Inquiry("obtss_igrs_684r")
	end if
End Sub


'============================================================================
' btnToday_OnClick - 당일
'============================================================================
Sub btnToday_OnClick()
	cldFromDate01.caption = cldToday.caption
	cldToDate01.caption = cldToday.caption
	
	TR_Inquiry("obtss_igrs_684r")
End Sub



