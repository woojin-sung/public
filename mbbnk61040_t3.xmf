'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obtss_igrs_684r" then
		Dim sData
		Dim sGubun
		Dim sCnt
'		sCnt = grdT301.rowcount
		sCnt = DATAMANAGER.GetDataCount( 0 , "obtss_igrs_684r", "OutBlock1")
		for i=0 to sCnt-1 
			Label0.caption = DATAMANAGER.GetDataValue(0,"obtss_igrs_684r", "OutBlock1", "MNRC_AMT" , i )
			Label1.caption = DATAMANAGER.GetDataValue(0,"obtss_igrs_684r", "OutBlock1", "FEE" , i )
			sData = Label0.dispcaption & "(" & Label1.dispcaption &")"
			sGubun = DATAMANAGER.GetDataValue(0,"obtss_igrs_684r", "OutBlock1", "UI_ITEM_CNTT4", i )&"/" & DATAMANAGER.GetDataValue(0,"obtss_igrs_684r", "OutBlock1", "UI_ITEM_CNTT2" , i )
			grdT301.SetCellData( "bd_cell9", g_szNextIndex, sData )
			grdT301.SetCellData( "bd_cell10", g_szNextIndex, sGubun )
			g_szNextIndex = g_szNextIndex + 1
		next
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_szNextIndex = 0
End Sub

