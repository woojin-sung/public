'	end if
'	
'	if g_bGlobal_Trade_State = false then
'		return "3"
'	else
'		if g_bGlobal_ETP_State == false then
'			return "2"
'		else
'			return "1"
'		end if
'	end if	
	
	return f_GetRegType()
	
'	if g_bGlobal_Trade_State = false then
'		return "1"
'	else
