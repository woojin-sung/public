		contChk1.chk3.chksilence = "1"
		contChk1.imgUIChk3.imgpath = g_szCheckImg
		contChk1.lblChkText3.fgcolor = g_szCheckFg
	else
		contChk1.chk3.chksilence = "0"
		contChk1.imgUIChk3.imgpath = g_szUnCheckImg
		contChk1.lblChkText3.fgcolor = g_szUnCheckFg
	end if
	'전체동의 체크 상태
	f_SetAllCheckState()
	'신청버튼 활성화 여부
	f_SetBtnRegEnable()
End Function

'============================================================================
Function f_SetChk4State(bValue)
	if bValue == true then
		contChk1.chk4.chksilence = "1"
		contChk1.imgUIChk4.imgpath = g_szCheckImg
		contChk1.lblChkText4.fgcolor = g_szCheckFg
	else
		contChk1.chk4.chksilence = "0"
		contChk1.imgUIChk4.imgpath = g_szUnCheckImg
		contChk1.lblChkText4.fgcolor = g_szUnCheckFg
	end if
	'전체동의 체크 상태
	f_SetAllCheckState()
	'신청버튼 활성화 여부
	f_SetBtnRegEnable()
End Function

'============================================================================
Function f_SetChk5State(bValue)
	if bValue == true then
		contChk2.chk6.chksilence = "1"
		contChk2.imgUIChk6.imgpath = g_szCheckImg
		contChk2.lblChkText6.fgcolor = g_szCheckFg
		g_bGlobal_ETP_Reg = true
	else
		contChk2.chk6.chksilence = "0"
		contChk2.imgUIChk6.imgpath = g_szUnCheckImg
		contChk2.lblChkText6.fgcolor = g_szUnCheckFg
		g_bGlobal_ETP_Reg = false
	end if
	
	'전체동의 체크 상태
	f_SetAllCheckState()
	'신청버튼 활성화 여부
	f_SetBtnRegEnable()
	
End Function

'============================================================================
'f_SetToggleUI(nFlag) : 서류제공방법 컨트롤 기능 함수
'============================================================================
Function f_SetToggleUI(nFlag)
	dim szToggleImg0, szToggleImg1, szToggleColor0, szToggleColor1
	szToggleImg0 		= "input_01_n.9.png" 	'비활성 이미지
	szToggleImg1 		= "input_01_o.9.png" 	'활성화 이미지
	szToggleColor0 	= "127" 				'비활성 컬러
	szToggleColor1 	= "67" 				'활성화 컬러
	
	if nFlag == 0 or nFlag == 1 then '알림,톡  이메일 클릭시 개인신용정보 미동의 고객이며 동의 안했다면 팝업 실행
		'개인신용정보 동의 확인 여부
		if g_bUseCreditAgree == false then
			if g_bCheckCreditAgree == false then
				'패스워드 암호화여부
				If g_PlainRm = "1" Then
					szPwd = edtPassword.caption
				Else
					 szPwd = edtPassword.encdata
				    if Trim(szPwd) == "" or Trim(szPwd) == null then
					    szPwd = edtPassword.caption
				    end if
				End If
				szLinkedData = cmbAccount.total&"★"&cmbAccount.sequence&"★"&szPwd				
				
				'Form.OpenPopupAnimation("mbonl87056_p7" , ""  ,"","2")
				Form.OpenPopupAnimation("mbonl87056_p7" , szLinkedData  ,"","2")	'v0001 
			end if
		end if
	end if
	
	if nFlag == 0 then '알림,톡
		contNoti.imgRdo0.imgpath = szToggleImg1
		contNoti.imgRdo1.imgpath = szToggleImg0
		contNoti.lblTalk.fgcolor = szToggleColor1
		contNoti.lblEmail.fgcolor = szToggleColor0
		contNoti.lblInfoText.caption = "고객정보에 등록된 휴대폰 번호로 발송되오니  휴대폰 번호를\r\n반드시 확인해 주세요."
		g_szNotiFlag = "talk"
	elseif nFlag == 1 then '이메일
		contNoti.imgRdo0.imgpath = szToggleImg0
		contNoti.imgRdo1.imgpath = szToggleImg1
		contNoti.lblTalk.fgcolor = szToggleColor0
		contNoti.lblEmail.fgcolor = szToggleColor1
		contNoti.lblInfoText.caption = "고객정보에 등록된 이메일로 발송되오니 이메일 주소를\r\n반드시 확인해 주세요."
		g_szNotiFlag = "email"
	else
		contNoti.imgRdo0.imgpath = szToggleImg0
		contNoti.imgRdo1.imgpath = szToggleImg0
		contNoti.lblTalk.fgcolor = szToggleColor0
		contNoti.lblEmail.fgcolor = szToggleColor0
		contNoti.lblInfoText.caption = ""
		contNoti.tblInfo.visible = false
		contNoti.ImageInfo0.visible = false
		contNoti.lblInfoText.visible = false
		g_szNotiFlag = ""
		Exit Function
	end if
	contNoti.tblInfo.visible = true
	contNoti.ImageInfo0.visible = true
	contNoti.lblInfoText.visible = true
End Function

'============================================================================
'f_SetToggleData(sFlag) : 서류제공방법 DATA SET
'============================================================================
Function f_SetToggleData(sFlag)
	if sFlag == "" or sFlag == null then
		Exit Function
	end if
	Dim szData
	szData = ""
	if sFlag == "talk" then '알림,톡
		szData = contNoti.tblUserInfo.GetCellString(0, 1) '폰번호
	elseif sFlag == "email" then '이메일
		szData = contNoti.tblUserInfo.GetCellString(1, 1) '이메일
	end if
	if szData <> "" and szData <> null then
		contNoti.tblInfo.SetCellString(0, 0, szData)
		contNoti.tblInfo.SetCellString(0, 1, "변경하기 〉")
	else
		contNoti.tblInfo.SetCellString(0, 0, "")
		contNoti.tblInfo.SetCellString(0, 1, "등록하기 〉")
	end if

End Function

'============================================================================
'f_RegBtnProc() : 약정 처리 진행
'리턴 값 > 0:이미 약정된 상태, 1:해외주식, 2:해외주식,ETP 약정, 3 : ETP 약정
'============================================================================
Function f_RegBtnProc()

	if f_bCheckBeforeReg() == true then
		Dim sSendData, sRegType
		sRegType = f_GetRegType()
		if sRegType = "3" then '3:ETP 약정
			sSendData = "87057_"& sRegType & "★" & cmbAccount.total & "★" & cmbAccount.sequence & "★" & edtPassword.caption & "★" & "083" 
			'sSendData = "87057★" & cmbAccount.total & "★" & cmbAccount.sequence & "★" & edtPassword.caption & "★" & "083" 
			Form.OpenPopup("mbonl81010_p1" , sSendData , "")
		elseif sRegType = "2" then '2:해외주식, ETP약정
			DATAMANAGER.RequestTranData("obcsb_acif_700r")
			sSendData = "87057_"& sRegType & "★" & cmbAccount.total & "★" & cmbAccount.sequence & "★" & edtPassword.caption & "★" & "083" 
			'sSendData = "87057★" & cmbAccount.total & "★" & cmbAccount.sequence & "★" & edtPassword.caption & "★" & "083" 
			Form.OpenPopup("mbonl81010_p1" , sSendData , "")
	     elseif sRegType = "1" then '1:해외주식
			sSendData = "87057_"& sRegType & "★" & cmbAccount.total & "★" & cmbAccount.sequence & "★" & edtPassword.caption & "★" & "082" 
			'sSendData = "87057★" & cmbAccount.total & "★" & cmbAccount.sequence & "★" & edtPassword.caption & "★" & "082" 
			Form.OpenPopup("mbonl81010_p1" , sSendData , "")
		end if
	end if 
		
End Function

'============================================================================
'f_CheckPwd() : 비밀번호 입력여부 체크
'============================================================================
Function f_CheckPwd()
'	if edtPassword.caption == "" or edtPassword.caption == null 
'		or Len(edtPassword.caption) < 4 or Len( g_nPassword ) < 4 or Form.GetCtlProp( "#edtPW", "caption") == "" then
	if g_nPassword == nil then
		return false	
	else
		if  Len( g_nPassword ) < 4 then 		
	'		Form.ShowAlert("알림", "비밀번호를 입력해 주세요.")
			return false
		else
			return true
		end if
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
Sub Form_OnFormInitBefore()
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v005
'	g_szUnCheckImg = "icon_chk_on.png"
'	g_szCheckImg = "icon_chk_off.png"	
	g_szUnCheckImg = "check_line_n.png"
	g_szCheckImg = "check_line_o.png"	
	g_szUnCheckFg = "127"
	g_szCheckFg = "4"
	g_szNotiFlag = ""
	f_InitGlobalValue()
	
	'ImgBackPress.setMaintainingRatio("1")
	imgTitle.setMaintainingRatio("1")
	'ImgMenu.setMaintainingRatio("1")
	contAllChk.imgUIAllChk.setMaintainingRatio("1")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	'-----------------------------------------------
	' 타이틀 초기화
	'-----------------------------------------------
'	Dim nWidth
	lblTitle.paddinginfo = "0,0,0,0"
	
'	nWidth = Form.GetTextWidth(lblTitle.caption, 3, false, false)
'	
'	imgTitleArrow.maintainratio = "2" 
'	imgTitleArrow.imgpath = "icon_arrow_down2"
'	imgTitleArrow.visible = true
'	imgTitleArrow.left = 47 + nWidth + 10	
	
	'-----------------------------------------------
	' 뒤로가기 버튼 초기화
	'-----------------------------------------------
	imgBack.SetMaintainingRatio("2")
	imgBack.imgpath = "icon_main_01"
	
	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)
	g_szCust_Num = Form.GetSharedData("&CUST_NUM", false )
	g_szSavePwd = Form.GetEnvData("order.save_orderpwd")' 계좌비밀번호 저장여부
	edtPassword.caption = ""
	if g_szSavePwd == "0" then
		edtPassword.caption = ""
	end if
	btnPwd.bringfront("1")
	f_InitUI()
	
	'ETP 신청일 경우 계좌번호 넘김, 그러나 계좌번호 상관없는 고객단위(ID) 
	'주문화면들과 예약주문에서도 사용
	Dim szData
	szData = Form.GetOpenLinkData()	
	if Trim(szData) <> "" then
		if Len(szData) > 10 then
			cmbAccount.caption = Left(szData, 10)
			
			arrData = Split(szData,"★")
			
			if #arrData > 1 then
				g_szJumun = arrData(1) ' R:예약주문 / J:주문
			else
				g_szJumun = "J"
			end if
			
		else
			cmbAccount.caption = szData
			g_szJumun = ""
		end if
	end if 

	'계좌 체크
	if cmbAccount.caption <> "" and cmbAccount.caption <> null then 
		DATAMANAGER.RequestTranData("obcsb_acif_000r") '계좌정보(영문명) 조회
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("KYC_REG_SRNO_1", "")
	Form.SetSharedData("KYC_REG_SRNO_2", "")
	Form.SetSharedData("KYC_REG_SRNO_3", "")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'msgbox sKeyName .. " ... " .. sRet
	If sKeyName == "mbonl87057_p2_end" Then  '결과페이지		
		if sRet == "ok" then
			Form.CloseForm()
			Form.SendReturnToParent("mbonl87057_p2_end", sRet)
			
			'재조회
			'DATAMANAGER.RequestTranData("obpds_srvc_323r") '해외주식 거래 정보 조회
		end if	
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim tData
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPassword.pwdlen = tData(1)
				edtPassword.caption = tData(0)
				
				'v005
				If g_PlainRm = "1" Then
					g_nPassword 	= edtPassword.caption
				Else
					g_nPassword 	= Form.GetEncData(edtPassword.caption)
				End If
			
				if g_bType == "1" then '영문명변경하기 이후 진행
					'g_nPassword = tData(0)
					contEngNm_btnChangeEnNm_OnClick()
				elseif g_bType == "2" then  '신청하기
					edtPassword_OnEditComplete()
				elseif g_bType == "3" then '(알림톡,문자,이메일)변경하기
					contNoti_btnChangeInfo_OnClick()				
				end if 
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
		else
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPassword.caption = ""
			else
				szCurAcc = cmbAccount.caption
				nCnt = Cint(cmbAccount.accountcount)
				For i = 0 to nCnt - 1
					szCompAcc = cmbAccount.getAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						cmbAccount.currentindex = i
						Exit For
					end if
				Next
			end if
		end if
	'==============================================
	'*********** 각 확인사항 팝업 리턴 ************
	'==============================================
	ElseIf sKeyName == "mbonl82020_p6" or sKeyName == "mbonl87056_p6" or sKeyName == "mbonl87056_p7" Then 
		if sKeyName == "mbonl82020_p6" then
			'--------------- 해외주식 거래신청 ------------------
			If sRet == "외화증권매매 거래계좌설정 약관" Then
				f_SetChk2State(true)
			ElseIf sRet == "해외주식 직접투자위험 유의사항" Then
				f_SetChk3State(true)
			ElseIf sRet == "외화증권거래 설명서" Then
				f_SetChk4State(true)
			'-------------- 해외주식 ETP 약정 ------------------
			ElseIf sRet == "해외 ETP투자위험 고지문" Then
				f_SetChk5State(true)
			Else
				g_bAllChkClickFlag = false
			End If
		'=====================================================
		'************ 개인신용정보 동의 팝업 리턴 ************
		'=====================================================
		elseif sKeyName == "mbonl87056_p7" then
			g_bCheckCreditPopup = true
			if sRet == "ok" then
				g_bCheckCreditAgree = true
				if g_bAllChkClickFlag == true then
					f_OpenChkAllPopup()
				end if
			else
				g_bCheckCreditAgree = false
				g_bAllChkClickFlag = false
			end if
		'=====================================================
		'**************** 전체 동의 팝업 리턴 ****************
		'=====================================================
		elseif sKeyName == "mbonl87056_p6" then
			'전체동의 팝업
			if sRet == "mbonl87056_p1_All" then
				f_SetChk2State(true)
				f_SetChk3State(true)
				f_SetChk4State(true)
				f_SetChk5State(true)
			elseif sRet == "cancel" then
				g_bAllChkClickFlag = false
			end if
		end if
		'신용동의체크
		f_CheckCreditPopup()
		
		'전체동의 체크 상태
		f_SetAllCheckState()
		'신청버튼 활성화 여부
		f_SetBtnRegEnable()
		
	'===============================================
	'*********** 영문명 변경 팝업 리턴  ************
	'===============================================
	ElseIf sKeyName == "NewEngName" then 
		g_engFlag = true 'v0005'v0005
		DATAMANAGER.RequestTranData("obcsb_acif_000r")
	'===============================================
	'********** 고객정보 변경 팝업 리턴  ***********
	'===============================================
	ElseIf sKeyName = "mbonl81000" Then
		btnReg.visible = true
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
		end if
	'===============================================
	'*********** 투자성향 진단 팝업 리턴  ************
	'===============================================
	ElseIf sKeyName = "KYCCHK_RETURN" Then
		g_nCnt = 1
		if sRet == "Y" then
			DATAMANAGER.RequestTranData( "obpds_srvc_183a" )
'			g_nCnt = 1
'			Form.SetSharedData("FNPR_JOIN_SRNO"&CStr(g_nCnt), "" )
'			DATAMANAGER.RequestTranData( "obsap_acif_999a" )
		end if
		
	'===============================================
	'***금융소비자유형확인  후 신청 팝업 리턴  ***
	'===============================================
	elseif sKeyName == "mbonl81010_p20_CLOSE" then

		if sRet == "NEXT_mbonl81010_p20" then
			g_FinCustomer = "Y"
			'contAllChk.btnAllChk.enable = true
			
			dim sRegType
			sRegType = f_GetRegType() 
			if sRegType = "3" then '3:ETP 약정
				sSendData = "87057_"& sRegType & "★" & cmbAccount.total & "★" & cmbAccount.sequence & "★" & edtPassword.caption & "★" & "083" 
				'sSendData = "87057★" & cmbAccount.total & "★" & cmbAccount.sequence & "★" & edtPassword.caption & "★" & "083" 
				Form.OpenPopup("mbonl81010_p1" , sSendData , "")
			elseif sRegType = "2" then '2:해외주식, ETP약정
				DATAMANAGER.RequestTranData("obcsb_acif_700r")
				sSendData = "87057_"& sRegType & "★" & cmbAccount.total & "★" & cmbAccount.sequence & "★" & edtPassword.caption & "★" & "083" 
				'sSendData = "87057★" & cmbAccount.total & "★" & cmbAccount.sequence & "★" & edtPassword.caption & "★" & "083" 
				Form.OpenPopup("mbonl81010_p1" , sSendData , "")
		     elseif sRegType = "1" then '1:해외주식
				sSendData = "87057_"& sRegType & "★" & cmbAccount.total & "★" & cmbAccount.sequence & "★" & edtPassword.caption & "★" & "082" 
				'sSendData = "87057★" & cmbAccount.total & "★" & cmbAccount.sequence & "★" & edtPassword.caption & "★" & "082" 
				Form.OpenPopup("mbonl81010_p1" , sSendData , "")
			end if
			
		elseif sRet == "CANCEL_mbonl81010_p20" then
			g_FinCustomer = "N"
			'contAllChk.btnAllChk.enable = false
			
			'가입중단시 처리미완료인경우 메뉴트리로 빠지도록 함 (2023.06.14)
			tRst = Form.GetSharedData( "81010_P20_RST" , false )
			if trim(tRst) <> "Y" then
				Form.OpenMainMenuWithIndex(0,1,0)
			end if			
		end if
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'패스워드 암호화여부
	If g_PlainRm = "1" Then
		szPwd = edtPassword.caption
	Else
		 szPwd = edtPassword.encdata
	    if Trim(szPwd) == "" or Trim(szPwd) == null then
		    szPwd = edtPassword.caption
	    end if
	End If
'	'고객번호
'	dim szCust_Num
'	szCust_Num = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
	if szTranID == "obacp_opop_064r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , g_Acno)
	'영문명 조회
	elseif szTranID == "obcsb_acif_000r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , szPwd)
	'개인(신용)정보 동의 조회
	elseif szTranID == "obaci_acct_256r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , cmbAccount.sequence)'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , szPwd)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , "A")
	'폰번호, 이메일 조회
	elseif szTranID == "obcsb_acif_140r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
	'계좌 증거금 등급 조회
	elseif szTranID == "obacp_comm_008r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , cmbAccount.sequence)'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , szPwd)
	'해외주식 거래 신청 조회
	elseif szTranID == "obpds_srvc_323r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "082"	)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , cmbAccount.sequence)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , g_szCust_Num)
	'해외주식 ETP 신청 조회
	elseif szTranID == "obpds_srvc_323r_1" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "083"	)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , g_szCust_Num)
	'가입계약서류 제공방식 조회
	elseif szTranID == "obcsb_acad_122a" then	
		dim strCustTelno, strAddr, strInagTypeCode, strInagSrno, gFnprJoinSrno
		
		if g_szNotiFlag == "talk" then
			strCustTelno = contNoti.tblUserInfo.GetCellString(0, 1)
			strInagTypeCode = contNoti.tblUserInfo.GetCellString(0, 2)
			strInagSrno = contNoti.tblUserInfo.GetCellString(0, 3)
			
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "04")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , strInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , strInagSrno)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "UI_CUST_TELNO" , 0 , strCustTelno)
		elseif g_szNotiFlag == "email" then
			strAddr = contNoti.tblUserInfo.GetCellString(1, 1)
			strInagTypeCode = contNoti.tblUserInfo.GetCellString(1, 2)
			strInagSrno = contNoti.tblUserInfo.GetCellString(1, 3)

			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "02")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , strInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , strInagSrno)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "ADDR"          , 0 , strAddr)
		End If 
		
		gFnprJoinSrno = Form.GetSharedData("FNPR_JOIN_SRNO"&CStr(g_nCnt), false )
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "FNPR_JOIN_SRNO"     , 0 , gFnprJoinSrno)
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "PROS_CLS_CODE"      , 0 , "1")
		
	'해외주식 관련 거래 약정
	elseif szTranID == "obpds_srvc_183a" then
		DATAMANAGER.ClearInputData( 0, szTranID)
		'투자성향정보
		Dim szKYC_INVT, szKYC_PROD, szKYC_DVPD, szKYC_DRVT, szPROS_YN
		szKYC_INVT = Form.GetSharedData("KYC_INVT_INCL_GRAD_CODE"	, false) '투자성향등급
		szKYC_PROD = Form.GetSharedData("KYC_PROD_GRAD_CODE"		, false) '상품등급
		szKYC_DVPD = Form.GetSharedData("KYC_DVPD_EPMD_CODE"		, false) '파생상품유의코드
		szKYC_DRVT = Form.GetSharedData("KYC_DRVT_PROS_YN"		, false) '파생처리여부
		szPROS_YN  = Form.GetSharedData("PROS_YN"		, false) '파생처리여부
		'InBlock1
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"			, 0 	, "I"				)'처리구분(I등록)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" 				, 0 	, szPwd 				)'계좌비밀번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" 					, 0 	, g_szCust_Num		)'고객번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 					, 0 	, cmbAccount.total	)'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 					, 0 	, cmbAccount.sequence	)'계좌일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" 					, 0 	, "082"				)'서비스 코드 082 : 해외주식거래신청
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_SRNO"				, 0 	, "0"	 			)'서비스 일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_MANG_UNIT_CODE"		, 0 	, "03"				)'서비스 관리 단위코드(03상품)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID"					, 0 	, Form.GetSharedData("&USER_ID",false))'HTS ID
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE" 			, 0, "4"				)'접촉 구분코드(4온라인)

		'부적합 상품 확인 일련번호
		dim szKYC_REG_SRNO, szKYC_REG_SRNO_1, szKYC_REG_SRNO_2
		szKYC_REG_SRNO = Form.GetSharedData("KYC_REG_SRNO_1", false)
		szKYC_REG_SRNO_1 = Form.GetSharedData("KYC_REG_SRNO_2", false)
		szKYC_REG_SRNO_2 = Form.GetSharedData("KYC_REG_SRNO_3", false)
		if szKYC_REG_SRNO == null then
			szKYC_REG_SRNO = ""
		end if
		if szKYC_REG_SRNO_1 == null then
			szKYC_REG_SRNO_1 = ""
		end if
		if szKYC_REG_SRNO_2 == null then
			szKYC_REG_SRNO_2 = ""
		end if
		g_date = Form.GetSharedData( "&HOST_DATE", false )	'오늘날짜
	    
		'부적합 일련번호 대입 우선순위 해외주식>ETP>소수점 순
		dim sRegType
		sRegType = f_GetRegType() 
		if sRegType == "1" then'해외주식
			'g_ISCD		=	Array("082", "", "")
			g_ISCD		=	Array("082", "")
			'해외주식
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BSWR_DIV_CODE", 0, "17190" )
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "REG_SRNO", 0, szKYC_REG_SRNO )
			
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_STCK_TR_STPL_YN", 0, "Y" )
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_ETP_TR_STPL_YN", 0, "N" )
			'DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_STCK_DCPN_TR_STPL_YN", 0, "Y" )
		elseif sRegType == "2" then'해외주식, ETP 약정
			'g_ISCD		=	Array("082", "083", "")
			g_ISCD		=	Array("082", "083")
			'해외주식
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BSWR_DIV_CODE", 0, "17190" ) '해외주식 약정
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "REG_SRNO", 0, szKYC_REG_SRNO )
			'ETP
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BSWR_DIV_CODE", 1, "17192" )'ETP약정
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "REG_SRNO", 1, szKYC_REG_SRNO_1 )
			
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_STCK_TR_STPL_YN", 0, "Y" )
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_ETP_TR_STPL_YN", 0, "Y" )
			'DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_STCK_DCPN_TR_STPL_YN", 0, "Y" )

		elseif sRegType == "3" then 'ETP 약정
			'g_ISCD		=	Array("083", "", "")
			g_ISCD		=	Array("083", "")
			'ETP
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BSWR_DIV_CODE", 0, "17192" )
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "REG_SRNO", 0, szKYC_REG_SRNO )
			
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_STCK_TR_STPL_YN", 0, "N" )
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_ETP_TR_STPL_YN", 0, "Y" )
			'DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_STCK_DCPN_TR_STPL_YN", 0, "Y" )
		end if

		'if sRegType <> "1" then
		    '투자성향 데이터
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "KYC_INVT_INCL_GRAD_CODE"	, 0, szKYC_INVT 	)'투자성향등급
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "KYC_PROD_GRAD_CODE"		, 0, szKYC_PROD 	)'상품등급
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "KYC_BSWR_DIV_CODE"		, 0, "02"		)'업무분류코드
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "KYC_DVPD_EPMD_CODE"		, 0,	szKYC_DVPD 	)'파생상품유의코드
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "KYC_DRVT_PROS_YN"			, 0,	szKYC_DRVT 	)'파생처리여부
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_YN" 			     , 0, szPROS_YN	)'접촉 구분코드(4온라인)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STND_DATE" 			     , 0, g_date		)'접촉 구분코드(4온라인)
	     'end if
		
		if g_bCheckCreditAgree == true then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CRIN_OFER_AGRM_YN", 0, "Y")'신용정보제공동의
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CRIN_OFER_AGRM_YN", 0, "N")'신용정보제공동의
		end if
		

	elseif szTranID == "obcsb_dbif_322a" then 
		dim szSVCD, szSVC_SRNO, szFnprJoinSrno,szCNRC_DOCU_KEY_VAL
		
		' 0 : 082, 해외주식,  1: 083, ETP  고정으로 들어옴
		szSVCD = ""
		szSVC_SRNO = ""
		for i = 0 to 1
			szSVCD = Form.GetSharedData("SVCD"&CStr(i+1), false )'obpds_srvc_183a 에서 받은 서비스코드
			if g_ISCD(g_nCnt-1) = szSVCD then
				szSVC_SRNO = Form.GetSharedData("SVC_SRNO"&CStr(i+1), false )'obpds_srvc_183a 에서 받은 서비스일련번호
				Exit for
			end if
		next
		
		'szSVC_SRNO = Form.GetSharedData("SVC_SRNO"&CStr(g_nCnt), false )'obpds_srvc_183a 에서 받은 서비스일련번호

		nMustCnt = CInt(f_nGetMustCnt())
		szFnprJoinSrno = Form.GetSharedData("FNPR_JOIN_SRNO"&CStr(g_nCnt), false )

		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 				 , 0 , cmbAccount.total	) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO" 	 , 0 , szFnprJoinSrno	) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "BSWR_LRDV_CODE" 	 , 0 , "017"				)	'001:계좌개설 / 017:서비스약정 
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "FNPR_JOIN_DETL_SRNO" , 0 , "00001"			)	'다건일경우 하나씩 증가
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ISCD"				 , 0 , g_ISCD(g_nCnt - 1)	)	'prcd:계좌개설 / svcd:서비스약정 
		'업종분류코드 해외주식약정 "02082", 해외ETP약정 "02083"
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BSWR_DIV_CODE" , 0 , "02"&g_ISCD(g_nCnt - 1))  
		
		szCNRC_DOCU_KEY_VAL = g_szCust_Num & "$" & g_ISCD(g_nCnt - 1) & "$" & szSVC_SRNO
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "CNRC_DOCU_KEY_VAL"	 , 0 , szCNRC_DOCU_KEY_VAL )	'고객번호$서비스코드$서비스일련번호 
		'DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "CNRC_DOCU_KEY_VAL"	 , 0 , g_Csno & "$" & "082" & "$" & g_szSvcSrno )	'고객번호$서비스코드$서비스일련번호 
	elseif szTranID == "obcsb_acif_199a" then 
		dim szFnprJoinSrno
		szFnprJoinSrno = Form.GetSharedData("FNPR_JOIN_SRNO"&CStr(g_nCnt), true )
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO" 			, 0 , szFnprJoinSrno	) 	'금융상풍일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_DETL_SRNO" 	 	, 0 , "00001"			) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_LRDV_LEVL_CODE" 	, 0 , "01"			)'	"01"투자성
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_MDDV_LEVL_CODE" 	, 0 , "02"			)	'02 서비스약정
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_SMDV_LEVL_CODE"	, 0 , "02"& g_ISCD(g_nCnt - 1)		)	'&서비스약정코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_DTL_DIV_LEVL_CODE"	, 0 , "000" 			)	'CMA전환신청인경우 "009" 그외엔 "000"
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_ISSU_DIV_LEVL_CODE", 0 , "000"			) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISCD" 	 					, 0 , g_ISCD(g_nCnt - 1))	'082 서비스약정 코드
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "KOR_ISNM" 					, 0 , ""				)	
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CSNO"						, 0 , g_szCust_Num	)	'고객번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "SVC_MANG_UNIT_CODE"	 		, 0 , "01" 			)	'서비스관리단위코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO"	 					, 0 , cmbAccount.caption )	'계좌컨트롤 8자리
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" 	 					, 0 , ""				) 	'SVC_MANG_UNIT_CODE가 03일때만 매핑
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CONT_CLS_CODE" 	 			, 0 , "4"			)	'온라인
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CHAN_TYPE_CLS_CODE" 		, 0 , ""				)	
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CAFU_TRGT_YN"				, 0 , ""				)	
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ODER_DATE"	 				, 0 , "" 			)	
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "OM_ODER_SRNO"	 			, 0 , "" 			)	
      elseif	szTranID	=	"obcsb_acif_700r"	then				'투자성향등급조회 'v0002
		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "ACNO"				, 0, cmbAccount.total)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "ASNO"				, 0, cmbAccount.sequence)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "KYC_BSWR_DIV_CODE"	, 0, "02")
		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "BSWR_DIV_CODE"		, 0, "17190")
		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "ISCD"				, 0, "")	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcsb_acif_000r" then
		'dim sCUST_CLS_CODE
		g_sCUST_CLS_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "CUST_CLS_CODE", 0)  '고객 개인/법인 구분(법인:2)
		'sCUST_CLS_CODE = "2" 'v0003
		'if sCUST_CLS_CODE == "2" then
		'	Form.MsgBox("알림", "법인고객은 온라인 신청이 불가합니다.\n영업점으로 문의해주세요", "corp", 0)
		'	Exit Sub
		'end if
		
		if contEngNm.tblEnNm.GetCellString(0, 1) == "" or contEngNm.tblEnNm.GetCellString(0, 1) == null then
			contEngNm.lblNmChgText.caption = "등록하기 〉"
		else
			contEngNm.lblNmChgText.caption = "변경하기 〉"
		end if
		'신청버튼 활성화 확인
		f_SetBtnRegEnable()
		
		DATAMANAGER.RequestTranData("obcsb_acif_140r") '폰번호, 이메일 조회
		
		'v0005
		if g_engFlag then
			'영문명에서 들어온 조회라면 323r을 태우지 않아야 함... 
			'태우게 되면 금융상품일련번호를 다시 태우게 되어 계약서류 오류가 됨
		else
			DATAMANAGER.RequestTranData("obpds_srvc_323r") '해외주식 거래 정보 조회
		end if 
		
	elseif szTranID == "obaci_acct_256r" then
		dim nOutBlock2Cnt
		nOutBlock2Cnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock2" ))
		if nOutBlock2Cnt > 0 then
			dim szBswrClcd, szBswrDtlClcd, szKindClcd, szYN, bFlag
			dim szChk0, szChk1, szChk2, szChk3, szChk4, szChk5
			
			for i=0 to nOutBlock2Cnt
				szBswrClcd = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2", "NW_AGRM_BSWR_CLCD", i)
				szBswrDtlClcd = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2", "NW_AGRM_BSWR_DETL_CLS_CODE", i)
				szKindClcd = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2", "NW_AGRM_KIND_CLCD", i)
				szYN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2", "CRIN_AGRM_YN", i)
				
				if szBswrClcd == "1" then
					if szKindClcd == "1" then
						szChk0 = szYN
					elseif szKindClcd == "2" then
						szChk1 = szYN
					end if
				elseif szBswrClcd == "2" then
					if szBswrDtlClcd == "03" then
						if szKindClcd == "1" then
							szChk2 = szYN
						elseif szKindClcd == "2" then
							szChk3 = szYN
						end if
					end if
				elseif szBswrClcd == "3" then
					if szBswrDtlClcd == "02" then
						if szKindClcd == "1" then
							szChk4 = szYN
						elseif szKindClcd == "2" then
							szChk5 = szYN
						end if
					end if
				end if
			next
			
			if szChk0 == "Y" and szChk1 == "Y" and szChk2 == "Y"
				and szChk3 == "Y" and szChk4 == "Y" and szChk5 == "Y" then
				
				g_bUseCreditAgree = true
			else
				g_bUseCreditAgree = false
			end if
			'g_bUseCreditAgree = false 'TEST
		end if
		
	elseif szTranID == "obcsb_acif_140r" then
		Dim iCnt, iCnt1
		If DATAMANAGER.IsMoreNextData(szTranID) = True Then
			DATAMANAGER.RequestNextData(szTranID)
		Else 
			'이메일 주소
			iCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2")
			For i = 0 to iCnt - 1
			    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_TYPE_CODE" , i)
			    strInagSrno2     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_SRNO"      , i)
			    strAddr          = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ADDR"           , i)
			    
			    If strInagTypeCode2 = "21" Then
					contNoti.tblUserInfo.SetCellString(1, 1, strAddr)
					contNoti.tblUserInfo.SetCellString(1, 2, strInagTypeCode2)
					contNoti.tblUserInfo.SetCellString(1, 3, strInagSrno2)
			    End If
			Next 	
			'휴대폰 번호
			iCnt1 = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock3")
			For i = 0 to iCnt1 - 1
			    strInagTypeCode3 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_TYPE_CODE" , i)
			    strInagSrno3     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_SRNO"      , i)
			    strCustTelno     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UI_CUST_TELNO"  , i)

			    If strInagTypeCode3 = "13" Then
				    contNoti.tblUserInfo.SetCellString(0, 1, strCustTelno)
				    contNoti.tblUserInfo.SetCellString(0, 2, strInagTypeCode3)
				    contNoti.tblUserInfo.SetCellString(0, 3, strInagSrno3)
			    End If
			Next
			f_SetToggleData(g_szNotiFlag)
		End If 
		
	elseif szTranID == "obpds_srvc_323r" then
		dim szAprvYN, nSvcSrno
		szAprvYN	= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "APRV_YN" , 0))
		g_nGlobalSvcSrno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SVC_SRNO" , 0)
		nSvcSrno = CDbl(g_nGlobalSvcSrno) '서비스코드
		
		g_nCnt = 1
		'해외주식 거래 신청 여부
		If szAprvYN == "Y" and nSvcSrno > 0 Then
			g_bGlobal_Trade_State = true
			g_bUseCreditAgree = true
		ElseIf szAprvYN == "N" and nSvcSrno > 0 Then
			g_bGlobal_Trade_State = true
			g_bUseCreditAgree = true
		Else
			g_bGlobal_Trade_State = false
			g_szISCD = "082"
			DATAMANAGER.RequestTranData( "obsap_acif_999a" ) ' v0004
			DATAMANAGER.RequestTranData("obaci_acct_256r") '개인(신용)정보 필수동의 조회
			'DATAMANAGER.RequestTranData( "obsap_acif_999a" )
		End If
		'g_bUseCreditAgree = false 'JSP
		
		'해외주식 ETP 거래 여부 조회		
		DATAMANAGER.RequestTranData( "obpds_srvc_323r_1" )
		
	elseif szTranID == "obpds_srvc_323r_1" then
		dim szAprvYN, nSvcSrno
		szAprvYN	= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "APRV_YN" , 0))
		g_nGlobalETPSvcSrno = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SVC_SRNO" , 0)
		nSvcSrno = CDbl(g_nGlobalETPSvcSrno)
		If szAprvYN = "Y" and nSvcSrno > 0 Then
			g_bGlobal_ETP_State = true
		ElseIf szAprvYN = "N" and nSvcSrno > 0 Then
			g_bGlobal_ETP_State = true
		Else
			g_bGlobal_ETP_State = false
			g_szISCD = "083"
			DATAMANAGER.RequestTranData( "obsap_acif_999a" )
		End If
		
		'체크 UI 변경
		f_SetUI()
		'신청버튼 활성화 확인
		f_SetBtnRegEnable()
		
	elseif szTranID == "obsap_acif_999a" then	
		dim nMustCnt, szFnprJoinSrno
		nMustCnt = CInt(f_nGetMustCnt())
		
		szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		Form.SetSharedData("FNPR_JOIN_SRNO"&CStr(g_nCnt), szFnprJoinSrno )
		Form.SetSharedData("FNPR_JOIN_SRNO", szFnprJoinSrno )
		
		g_nCnt = g_nCnt + 1
'		if g_nCnt < nMustCnt then
'			g_nCnt = g_nCnt + 1
'			Form.SetSharedData("FNPR_JOIN_SRNO"&CStr(g_nCnt), "" )
'
'			DATAMANAGER.RequestTranData( "obsap_acif_999a" )
'		else  ' 금융상품일련번호 채번 끝나면
			
'			g_nCnt = 1
			'Form.SetSharedData("FNPR_JOIN_SRNO"&CStr(g_nCnt), "" )
			'Form.SetSharedData("FNPR_JOIN_DETL_SRNO"&CStr(g_nCnt), "" )
			
'			DATAMANAGER.RequestTranData( "obcsb_acad_122a" )
'		end if
		
	elseif szTranID == "obcsb_acad_122a" then
		dim nMustCnt, szFnprJoinSrno
		
		nMustCnt = CInt(f_nGetMustCnt())
		szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		szFNPR_JOIN_DETL_SRNO = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_DETL_SRNO", 0)		'금융상품세부일련번호
		'Form.SetSharedData("FNPR_JOIN_SRNO"&CStr(g_nCnt), szFnprJoinSrno )
		Form.SetSharedData("FNPR_JOIN_DETL_SRNO"&CStr(g_nCnt), szFNPR_JOIN_DETL_SRNO )
		
		if g_nCnt < nMustCnt then
			g_nCnt = g_nCnt + 1
			'Form.SetSharedData("FNPR_JOIN_SRNO"&CStr(g_nCnt), "" )
			'Form.SetSharedData("FNPR_JOIN_DETL_SRNO"&CStr(g_nCnt), "" )
			DATAMANAGER.RequestTranData( "obcsb_acad_122a" )
		else  ' 금융상품일련번호 채번 끝나면
		     f_SetBtnRegEnable()
			'Form.ShowAlert("obpds_srvc_183a", "Send")
'			DATAMANAGER.RequestTranData( "obpds_srvc_183a" )  ' 해외주식 관련 거래약정 TR 호출
		end if
		
	'해외주식 관련 거래 약정
	elseif szTranID == "obpds_srvc_183a" then
		dim szSVCD, szSVC_SRNO
		
		for i=0 to 1  ' 0 : 082, 해외주식,  1:  083, ETP  고정으로 들어옴
			szSVCD = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "SVCD", i+1)		'서비스코드
			szSVC_SRNO = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "SVC_SRNO", i+1)		'서비스일련번호
			Form.SetSharedData("SVCD"&CStr(i+1), szSVCD )
			Form.SetSharedData("SVC_SRNO"&CStr(i+1), szSVC_SRNO )
		next
		
		Form.SetSharedData( "PROS_DATE", "" )
		Form.SetSharedData( "PROS_SRNO", "" )
'		sSendData = "87057" & "★" & g_szCust_Num & "★" &  cmbAccount.total & cmbAccount.sequence & "★" & g_szNotiFlag & "★" & "해외주식 거래신청이\n완료되었습니다."			
'		Form.OpenPopup("mbonl87057_p2" , sSendData , "")
		
'		edtPassword.caption = ""
'		f_InitUI()
		g_nCnt = 1
		DATAMANAGER.RequestTranData( "obcsb_dbif_322a" )  ' 해외주식 관련 거래약정 TR 호출		

	elseif szTranID == "obcsb_dbif_322a" then
		dim nMustCnt, szFnprJoinSrno
		nMustCnt = CInt(f_nGetMustCnt())
		if g_ISCD(g_nCnt-1) <> "082" and g_ISCD(g_nCnt-1) <> "083" then 
			DATAMANAGER.RequestTranData( "obcsb_acif_199a" )
		end if
		if g_nCnt < nMustCnt then
			g_nCnt = g_nCnt + 1
			'Form.SetSharedData("FNPR_JOIN_SRNO"&CStr(g_nCnt), "" )
			'Form.SetSharedData("FNPR_JOIN_DETL_SRNO"&CStr(g_nCnt), "" )

			DATAMANAGER.RequestTranData( "obcsb_dbif_322a" )

		else  ' 금융상품일련번호 채번 끝나면
			sSendData = "87057" & "★" & g_szCust_Num & "★" &  cmbAccount.total & cmbAccount.sequence & "★" & g_szNotiFlag & "★" & "해외주식 거래신청이\n완료되었습니다."			
			Form.OpenPopup("mbonl87057_p2" , sSendData & "★" & g_szJumun, "")
			
			'20240801
			edtPassword.caption = ""
			f_InitUI()	
			
		end if
		
		'20240801
		'edtPassword.caption = ""
		'f_InitUI()		
		
 	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	If szTranID == "obpds_srvc_323r" Then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
		Call f_InitUI()
		g_szFnprJoinSrno = ""
		Form.SetSharedData( "FNPR_JOIN_SRNO", "" ) 
	Else
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		'v008
		If g_ProsCls == "I" And CInt(szErrCode) == 6660 And Trim(szSubErr) == "개인신용정보동의 필수" Then
			'v009
			Form.ShowAlert( "알림" , "[개인(신용)정보 처리 동의]화면에서 정보동의 후 거래신청이 가능합니다.")
			'szLinkedData = g_szAcno&"★"&g_szAsno&"★"&g_nPassword
			'Form.OpenPopup("mbonl87057_p2" , szLinkedData , "")
		Else
			
			'20240802
			'obcsb_acif_700r에서 간헐적으로 채번중복 현상때문에 에러발생(이때 메시지가 정상처리라고 뜸)
			'이 메시지를 신청이 완료되었습니다로 바꿔달라그래서 수정한거같음. 채번중복 이슈 해결 시 해당 현상 없어지니 주석
			'if szTranID == "obcsb_acif_700r" and szErrMsg == "정상 처리 되었습니다"  then
			'	Form.ShowAlert( "알림" , "신청이 완료 되었습니다.")
			'	btnReg_OnClick() '신청하기 버튼 클릭
			'else
				if len(trim(szSubErr)) == 0 then
					Form.ShowAlert( "알림" , szErrMsg)
				else
					Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
				end if
			'end if
			
		End If
	End If	
End Sub

