'				else
'					sReturn = "4"
'				end if
'			else
'				sReturn = "4"
'			end if
'		else
'			if g_bGlobal_ETP_State == false then
'				if g_bGlobal_ETP_Reg == true then
'					sReturn = "2"
'				else
'					sReturn = "1"
'				end if
'			else
'				sReturn = "1"
'			end if
'		end if
'	end if	
	
'리턴 값 > 0:이미 약정된 상태, 1:ETP 약정, 2:해외주식,ETP 약정, 3 : 해외주식
'	dim sReturn
'	'해외주식 거래 약정 상태
'	if g_bGlobal_Trade_State == false then
'		'ETP 거래 약정 상태
'		if g_bGlobal_ETP_State == false then
'			'ETP 신청여부
'			if g_bGlobal_ETP_Reg == true then
'				sReturn = "2"
'			else
'				sReturn = "3"
'			end if
'		else
'			sReturn = "3"
'		end if
'	else
'		if g_bGlobal_ETP_State == false then
'			if g_bGlobal_ETP_Reg == true then
'				sReturn = "2"
'			else
'				sReturn = "1"
'			end if
'		else
'			sReturn = "0"
'		end
'	end if

'리턴 값 > 0:이미 약정된 상태, 1:해외주식, 2:해외주식,ETP 약정, 3 : ETP 약정
	dim sReturn
	'해외주식 거래 약정 상태
	if g_bGlobal_Trade_State == false then
		'ETP 거래 약정 상태
		if g_bGlobal_ETP_State == false then
			'ETP 신청여부
			'if g_bGlobal_ETP_Reg == true then
				sReturn = "2"
			'else
			'	sReturn = "1"
			'end if
		else
			sReturn = "1"
		end if
	else
		if g_bGlobal_ETP_State == false then
			'if g_bGlobal_ETP_Reg == true then
			'	sReturn = "2"
			'else
				sReturn = "3"
			'end if
		else
			sReturn = "0"
		end if
	end if
	
	return sReturn
End Function

'============================================================================
'''리턴 값 > 1 소수점약정, 2: 'ETP 약정, 소수점 or 해외주식, 소수점 약정 ,3:'해외주식, ETP 약정, 소수점 0: default

'f_nGetMustCnt() : 약정 처리해야할 카운트 
'리턴 값 > 0:이미 약정된 상태, 1:해외주식, 2:해외주식,ETP 약정, 3:ETP 약정
'============================================================================
Function f_nGetMustCnt()
		sRegType = f_GetRegType() 
'
'		if sRegType == "1" then '소수점 약정
'			return 1
'		elseif sRegType == "2" or sRegType == "4" then'ETP 약정, 소수점 or 해외주식, 소수점 약정
'			return 2
'		elseif sRegType == "3" then
'			return 3
'		else
'			return 0
'		end if
		
	if sRegType == "1" then '해외주식 약정
		return 1
	elseif sRegType == "2"  then'해외주식,ETP 약정
		return 2
	elseif sRegType == "3"  then'ETP 약정
		return 1
	else
		return 0
	end if		
End Function
'============================================================================
'''리턴 값 > 0:이미 약정된 상태, 1:소수점 약정, 2:소수점,ETP 약정, 3:해외주식,소수점,ETP약정, 4:해외주식, 소수점

