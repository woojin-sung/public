'============================================================================
' 해외(주식,ETP)거래 신청
'----------------------------------------------------------------------------
' 20240524 : 최초 생성
'============================================================================
'mbonl81010_p1(고객투자성향진단_공통프로세스팝업) 

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_bGlobal_Trade_State 		'해외주식 거래 신청 상태
dim g_bGlobal_ETP_State 		'해외 ETP 신청 상태
dim g_bGlobal_ETP_Reg	 		'해외 ETP 신청 여부
dim g_ServerMode				'서버타입
dim g_nGlobalSvcSrno			'해외주식 거래 서비스 코드
dim g_nGlobalETPSvcSrno		'해외주식 ETP 서비스 코드
'dim g_nGlobalDotSvcSrno		'해외주식 소수점 거래 서비스 코드
dim g_szRegType				'신청 처리 구분
dim g_szUnCheckImg, g_szCheckImg'체크이미지
dim g_szUnCheckFg, g_szCheckFg	'체크 폰트 컬러
dim g_szNotiFlag				'이용동의서류 제공방식 선택 상태
dim g_bAllChkClickFlag			'전체 체크 여부
dim g_bGradFlag				'위탁증거금 체크 여부
dim g_bUseCreditAgree			'개인(신용) 필수 동의 여부
dim g_bCheckCreditAgree		'개인(신용) 필수 동의 팝업에서 동의 진행한 여부
dim g_bCheckCreditPopup		'개인(신용) 필수 동의 팝업 오픈 여부
dim g_nTooltip_Top			'툴팁 팝업 TOP VALUE
Dim g_szSavePwd             	'계좌비밀번호 저장여부
dim g_nCnt					'금융상품가입일련번호 요청된 카운트
dim g_Acno
Dim	g_nPassword
dim g_ISCD
dim g_FinCustomer
dim g_date
dim g_engFlag                   '영문명 변경 진입시 Flag V0005

dim g_sCUST_CLS_CODE
dim g_szCust_Num
dim g_bType 		'작업유형(비밀번호입력 처리)   "1" : 고객영문명변경하기, "2" : 신청하기, "3" : (알림톡,문자,이메일)변경하기

dim g_szJumun
g_szJumun = ""

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'f_InitUI() : 컨트롤 위치, 체크 상태, 이미지 등 초기화
'============================================================================
Function f_InitUI()    
	g_Acno 		= Left(cmbAccount.caption, 8)
	f_SetContAllChkState(false)
	f_SetChk2State(false)
	f_SetChk3State(false)
	f_SetChk4State(false)
	f_SetChk5State(false)
	f_SetToggleUI(-1)
	lblNoData.visible = false
	edtPassword.caption = ""
	if g_szSavePwd == "0" then
		edtPassword.caption = ""
	end if
	
	'contChk0.visible = false
	contChk1.visible = false
	contChk2.visible = false
	contNoti.visible = false
	contAllChk.visible = false
	imgChkBg.visible = false
End Function

'============================================================================
'f_InitGlobalValue() : 전역변수 초기화
'============================================================================
Function f_InitGlobalValue()
'	g_bGlobal_DotTrade_State = false
	g_bGlobal_Trade_State = false
	g_bGlobal_ETP_State = false
	g_bGlobal_ETP_Reg = false
	g_bAllChkClickFlag = false
	g_bGradFlag = false
	g_bUseCreditAgree = false
	g_bCheckCreditAgree = false
	g_bCheckCreditPopup = false
	g_bBtnRegFlag = false
End Function

'============================================================================
'f_SetUI() : 상태에 따른 UI 변경
'============================================================================
Function f_SetUI()
	dim nContChk1Height, nContChk2Height, nContChk2Top, nBgImgHeight, nBgImgTop
	nContChk1Height = 100
	nContChk2Height = 60
	nContChk2Top = 305
	nBgImgHeight = 225
	nBgImgTop = 145
	
'	g_bGlobal_Trade_State = false  'for TEST	
'	g_bGlobal_ETP_State = false    'for TEST
	
	'해외주식 거래신청
	if g_bGlobal_Trade_State == true then
		contChk1.visible = false
		contChk2.top = nContChk2Top - nContChk1Height
		nBgImgHeight = nBgImgHeight - nContChk1Height
	else
		contChk1.visible = true
		contChk2.top = nContChk2Top
	end if
	
	'해외주식 ETP 약정 
	if g_bGlobal_ETP_State == true then
		contChk2.visible = false
		nBgImgHeight = nBgImgHeight - nContChk2Height
	else
		contChk2.visible = true
	end if
	
	if g_bGlobal_Trade_State == true 
		and g_bGlobal_ETP_State == true then
		
		contAllChk.visible = false
		lblNoData.visible = true
		imgChkBg.visible = false
	else
		imgChkBg.visible = true
		contAllChk.visible = true
	end if
	
	f_isShowNotiCont()
	'배경이미지와 계약서류 제공 컨테이너 UI 변경
	imgChkBg.height = nBgImgHeight
	contNoti.top = nBgImgTop + nBgImgHeight + 5
	g_nTooltip_Top = nBgImgTop + nBgImgHeight + 5
End Function

'============================================================================
'''''리턴 값 > 0:이미 약정된 상태, 1:소수점 약정, 2:소수점,ETP 약정, 3:해외주식,소수점,ETP약정, 4:해외주식, 소수점

'f_SetRegType() : 약정 처리 CASE SET 
'약정이 필요한 경우?
'리턴 값 > 0:이미 약정된 상태, 1:해외주식, 2:해외주식,ETP 약정, 3 : ETP 약정
'============================================================================
Function f_GetRegType()
'	dim sReturn
'	if g_bGlobal_DotTrade_State == true then
'		sReturn = "0"
'	else
'		'해외주식 거래 약정 상태
