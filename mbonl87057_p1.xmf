	if bValue == true then
		contChk1.chk2.chksilence = "1"
		contChk1.imgUIChk2.imgpath = g_szCheckImg
		contChk1.lblChkText2.fgcolor = g_szCheckFg
	else
		contChk1.chk2.chksilence = "0"
		contChk1.imgUIChk2.imgpath = g_szUnCheckImg
		contChk1.lblChkText2.fgcolor = g_szUnCheckFg
	end if
	'전체동의 체크 상태
	f_SetAllCheckState()
	'신청버튼 활성화 여부
	f_SetBtnRegEnable()
End Function

'============================================================================
