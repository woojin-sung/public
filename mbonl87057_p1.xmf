'			return "2"
'		else
'			return "3"
'		end if
'	end if	
'	
'	return "0"
End Function

'============================================================================
'f_bCheckBeforeReg() : 약정 처리 적합성 체크
'============================================================================
Function f_bCheckBeforeReg()

	'계좌번호 존재 유무 체크
	if cmbAccount.total == "" or cmbAccount.total == null or Len(cmbAccount.total) < 8 then
		Form.MsgBox("알림", "계좌번호를 확인해주세요.", "", 0)
		return false
	end if

	'계좌 비밀번호 체크
	if f_CheckPwd() == false then
		g_bType = "2"
		Form.openPopupAnimation("pwdcheckpopup", cmbAccount.total & cmbAccount.sequence & "☆0" ,"","2")
		Exit Function
	end if
	
	'영문명 존재 유무 체크
	if Trim(contEngNm.tblEnNm.GetCellString( 0, 1 )) == "" or Trim(contEngNm.tblEnNm.GetCellString( 0, 1 )) == null then
		Form.MsgBox("알림", "고객 영문명을 확인해 주세요.", "", 0)
		return false
	end if
	
	If g_sCUST_CLS_CODE == "2" Then 'v0001
		Form.MsgBox("알림", "법인고객은 영업점 내점으로만 약정이 가능합니다.", "", 0)
		Call f_InitUI()
		'g_szFnprJoinSrno = ""
		Form.SetSharedData( "FNPR_JOIN_SRNO", "" ) 
		Exit Function
	End If
	
	'해외주식 거래신청 동의 체크
	if g_bGlobal_Trade_State == false then
		if CInt(contChk1.chk2.checkstate) == 0 then
			Form.MsgBox("알림", "외화증권매매거래계좌설정약관을 확인해 주세요.", "", 0)
			return false
		end if
		
		if CInt(contChk1.chk3.checkstate) == 0 then
			Form.MsgBox("알림", "해외주식 직접투자위험유의사항을 확인해 주세요", "", 0)
			return false
		end if
		
		if CInt(contChk1.chk4.checkstate) == 0 then
			Form.MsgBox("알림", "외화증권 거래 설명서를 확인해 주세요.", "", 0)
			return false
		end if
	end if
	'해외주식 ETP 약정 동의 체크
	if g_bGlobal_ETP_State == false then
		if CInt(contChk2.chk6.checkstate) == 0 then
			Form.MsgBox("알림", "해외 ETP투자위험 고지문을 확인해 주세요.", "", 0)
			return false
		end if
	end if
	'이용동의서류 제공방식 선택 여부 체크
	if g_szNotiFlag == "" or g_szNotiFlag == null then
		Form.MsgBox("알림", "계약서류 제공방식을 선택해 주세요.", "", 0)
		return false
	else
		dim szData
		szData = contNoti.tblInfo.GetCellString( 0, 0 )
		
		if szData == "" or szData == null then
			if g_szNotiFlag == "talk" then
				Form.MsgBox("알림", "핸드폰 번호를 등록해 주세요.", "", 0)
			elseif g_szNotiFlag == "email" then
				Form.MsgBox("알림", "이메일 주소를 등록해 주세요.", "", 0)
			else
				Form.MsgBox("알림", "핸드폰 번호 혹은 이메일 주소를 확인해 주세요.", "", 0)
			end if
			return false
		end if
	end if

'	If g_FinCustomer <> "Y" Then
'		Form.MsgBox("알림", "전문, 일반 금융소비자를 확인 바랍니다.", "Show_mbonl81010", "1")
'		Exit Function		
'	End If
	
	return true
End Function

'============================================================================
'f_CheckCreditPopup() : 신용동의팝업 체크
'============================================================================
Function f_CheckCreditPopup()
	Dim bCheck1, bCheck2
	
	if g_bGlobal_Trade_State == false then
		if CInt(contChk1.chk2.checkstate) == 1 
			and CInt(contChk1.chk3.checkstate) == 1
			and CInt(contChk1.chk4.checkstate) == 1 then
			
			bCheck1 = true
		else
			bCheck1 = false
		end if
	else
		bCheck1 = true
	end if
	
	if bCheck1 == true then
		if g_bUseCreditAgree == false then
			if g_bCheckCreditAgree == false then
				if g_bCheckCreditPopup == false then
					'패스워드 암호화여부
					If g_PlainRm = "1" Then
						szPwd = edtPassword.caption
					Else
						szPwd = edtPassword.encdata
						if Trim(szPwd) == "" or Trim(szPwd) == null then
						    szPwd = edtPassword.caption
					     end if
					End If
					szLinkedData = cmbAccount.total&"★"&cmbAccount.sequence&"★"&szPwd	
					Form.OpenPopupAnimation("mbonl87056_p7" , szLinkedData  ,"","2")	'v0001    
				end if
			end if
		end if
	end if
End Function

'============================================================================
'f_SetAllCheckState() : 전체 동의 동작 진행
'============================================================================
Function f_SetAllCheckState()
	Dim bCheck1, bCheck2
	
	if g_bGlobal_Trade_State == false then
		if CInt(contChk1.chk2.checkstate) == 1 
			and CInt(contChk1.chk3.checkstate) == 1
			and CInt(contChk1.chk4.checkstate) == 1 then
			
			bCheck1 = true
		else
			bCheck1 = false
		end if
	else
		bCheck1 = true
	end if
	
	if g_bGlobal_ETP_State == false then
		if CInt(contChk2.chk6.checkstate) == 1 then
			bCheck2 = true
		else
			bCheck2 = false
		end if
	else
		bCheck2 = true
	end if
	
	if bCheck1 == true and bCheck2 == true then
		f_SetContAllChkState(true)
		f_isShowNotiCont()
	else
		f_SetContAllChkState(false)
		f_isShowNotiCont()
	end if
End Function

'============================================================================
'f_isShowNotiCont() : 계약서류 제공 선택 컨테이너 VISIBLE SET
'============================================================================
Function f_isShowNotiCont()
	
	if CInt(contAllChk.chkAll.checkstate) == 1 then
		contNoti.visible = true
	else
		contNoti.visible = false
	end if
	
End Function

'============================================================================
'f_SetBtnRegEnable() : 신청 처리 버튼 상태 결정
'============================================================================
Function f_SetBtnRegEnable()
	
	'영문명 존재 유무
	if contEngNm.tblEnNm.GetCellString(0, 1) == "" or contEngNm.tblEnNm.GetCellString(0, 1) == null then
		btnReg.enable = false
		Exit Function
	end if

	'체크사항 확인 여부
	if CInt(contAllChk.chkAll.checkstate) == 0 then
		btnReg.enable = false
		Exit Function
	end if

	'이용동의서류 제공방식 선택 여부
	if g_szNotiFlag == "" or g_szNotiFlag == null then
		btnReg.enable = false
		Exit Function	
	end if

	'개인신용정보 미동의 사용자가 동의를 하지 않았다면 비활성화
	if g_bUseCreditAgree == false and g_bCheckCreditAgree == false then
		btnReg.enable = false
		Exit Function		
	end if 

	'신청가능
	btnReg.enable = true
End Function

'============================================================================
'f_OpenChkAllPopup() : 전체 동의체크 별 안내팝업 호출
'============================================================================
Function f_OpenChkAllPopup()
	dim szURL, szTitle
	szURL = ""

	if f_GetPopupType() == "0" then
		szURL = ""
		szTitle = ""
		
	elseif f_GetPopupType() == "1" then '해외주식
		szURL = f_sGetURL(2) & "★" & f_sGetURL(3) & "★" & f_sGetURL(4)
		szTitle = f_sGetURLTitle(2) & "★" & f_sGetURLTitle(3) & "★" & f_sGetURLTitle(4)
		
	elseif f_GetPopupType() == "3" then ' ETP
		szURL =  f_sGetURL(5)
		szTitle = f_sGetURLTitle(5)
		
	elseif f_GetPopupType() == "2" then '해외주식, ETP
'		for i=0 to 6
		for i=2 to 5
			if i == 5 then
				szURL = szURL & f_sGetURL(i)
				szTitle = szTitle & f_sGetURLTitle(i)
			else
				if szURL == "" then
					szURL = f_sGetURL(i) & "★"
					szTitle = f_sGetURLTitle(i) & "★"
				else
					szURL = szURL & f_sGetURL(i) & "★"
					szTitle = szTitle & f_sGetURLTitle(i) & "★"
				end if
			end if
		next
	else
		szURL = ""
	end if
	
	'팝업 호출
	if szURL <> "" then
		Form.OpenPopup("mbonl87056_p6" , "mbonl87056_p1_All"&"♥"&szURL&"♥"&szTitle, "")
	end if
	
End Function

'============================================================================
'f_OpenChkPopup(iIdx) : 각 동의체크 별 안내팝업 호출
'============================================================================
Function f_OpenChkPopup(iIdx)
	if g_FinCustomer <> "N" then
		if iIdx < 6 then
			Form.SetSharedData("OPEN_URL", f_sGetURL(iIdx) )
			Form.OpenFramePopup("mbonl82020_p6" , f_sGetURLTitle(iIdx), "")
		end if
	end if
End Function

'============================================================================
'f_sGetURLTitle(iIdx) : 각 동의체크 별 타이틀 리턴
'============================================================================
Function f_sGetURLTitle(iIdx)
	Dim szTitle
	Select Case iIdx
		Case 2
			szTitle = "외화증권매매 거래계좌설정 약관"
		Case 3
			szTitle = "해외주식 직접투자위험 유의사항"
		Case 4
			szTitle = "외화증권거래 설명서"
		Case 5
			szTitle = "해외 ETP투자위험 고지문"
	End Select
	return szTitle
End Function

'============================================================================
'f_sGetURL(iIdx) : 각 동의체크 별 안내팝업 URL 리턴
'============================================================================
Function f_sGetURL(iIdx)		
	dim sURLheader, sURL
	Select Case iIdx
		Case 2
			'"외화증권매매 거래계좌설정 약관"
			If g_ServerMode == "1" Then	'개발기
				sURLheader = "http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/"
			Else
				sURLheader = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/"
			End If
			sURL = sURLheader & "meritz_yk_15.html"
		Case 3
			'"해외주식 직접투자위험 유의사항"
			If g_ServerMode == "1" Then	'개발기
				sURLheader = "http://testhome.imeritz.com/include/resource/htsdown/PDF/"
			Else
				sURLheader = "http://home.imeritz.com/include/resource/htsdown/PDF/"
			End If
			sURL = sURLheader & "htsdown_18.pdf"
		Case 4
			'"외화증권거래 설명서"
			If g_ServerMode == "1" Then	'개발기
				'sURLheader = "http://211.201.184.87/include/resource/htsdown/PDF/"
				sURLheader = "http://testhome.imeritz.com/include/resource/htsdown/PDF/"
			Else
				sURLheader = "http://home.imeritz.com/include/resource/htsdown/PDF/"
			End If
			sURL = sURLheader & "htsdown_16.pdf"
		Case 5
			'"해외 ETP투자위험 고지문"
			If g_ServerMode == "1" Then	'개발기
				'sURLheader = "http://211.255.202.106/include/resource/htsdown/PDF/"
				sURLheader = "https://testhome.imeritz.com/include/resource/htsdown/PDF/"
			Else
				sURLheader = "https://home.imeritz.com/include/resource/htsdown/PDF/"
			End If
			sURL = sURLheader & "htsdown_20.pdf"
	End Select
	
	return sURL
End Function

'============================================================================
'f_SetContAllChkState(bValue) : 전체동의 체크 상태 SET
'============================================================================
Function f_SetContAllChkState(bValue)
	if bValue == true then
		contAllChk.chkAll.chksilence = "1"
		contAllChk.imgUIAllChk.imgpath = "checkmenu_o.png"
		contAllChk.imgBtnBg.imgpath = "img_bg.9.png"
		'contAllChk.lblAllText.fgcolor = "62"
		contAllChk.lblAllText.fgcolor = "4"
		contAllChk.lblUnderLine.bgcolor = "4"
		g_bAllChkClickFlag = false
	else
		contAllChk.chkAll.chksilence = "0"
		contAllChk.imgUIAllChk.imgpath = "checkmenu_n.png"
		contAllChk.imgBtnBg.imgpath = "img_bgbox.9.png"
		contAllChk.lblAllText.fgcolor = "127"
		contAllChk.lblUnderLine.bgcolor = "127"
	end if
	
End Function

'============================================================================
