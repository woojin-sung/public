Sub btnChangeInfo0_OnClick()
	if edtPassword.caption <> "" and edtPassword.caption <> null then
		Dim sSendData, sTabIdx
		if g_szNotiFlag == "talk" then
			sTabIdx = "0"
		elseif g_szNotiFlag == "email" then
			sTabIdx = "1"
		end if
		sTabIdx = "0"
		sSendData = cmbAccount.total..";"..edtPassword.caption..";"..sTabIdx
		Form.OpenFramePopup("mbonl81000" , sSendData , "")
		'mbonl81000 폼화면 길이가 짧아 아래 신청버튼이 보여서 
		'해당 팝업 띄울 때는 버튼 숨기고 팝업 닫히면 다시 보이게 처리
		btnReg.visible = false 
	else
		Form.ShowAlert("알림", "계좌 비밀번호를 입력해 주세요.")
	end if
End Sub


