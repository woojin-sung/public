'============================================================================
' 첨부파일 이미지 업로드
'============================================================================
Sub Container0_BtnUpload_OnClick()
	
	if g_ImgCnt >= 3 then
		Form.ShowAlert("알림", "등록 가능한 파일 개수 3개를 초과하였습니다.")
		
		exit sub
	end if
	
	Form.getGalleryImage()
End Sub

'============================================================================
' 첨부파일 이미지 삭제(idx : 0)
'============================================================================
Sub Container0_ImgDel0_OnClick()
	Dim nCnt
	nCnt = 0

	for i = 1 to 2
		
		if Container0.Table0.GetCellString(i, 0) <> "" then
			nCnt = nCnt + 1
		end if

	next

	if nCnt == 0 then
		Container0.Label4.visible	= true
		Container0.ImgDel0.visible	= false
		Container0.DelBg0.visible	= false
		Container0.ImgPic0.visible	= false
'		Container0.ImgPic0.SetImageDataEnc("")
		Container0.Table0.SetCellString(0, 0, "")

	elseif nCnt <> 0 then
	
		for i = 0 to nCnt - 1
			Dim imgNm
			imgNm = Container0.Table0.GetCellString(i + 1, 0)
			
			Container0.Table0.SetCellString(i, 		0, imgNm)
			Container0.Table0.SetCellString(i + 1, 	0, "")
			
			if i == 0 then
				Container0.ImgPic0.SetImageDataEnc(imgNm)
			elseif i == 1 then
				Container0.ImgPic1.SetImageDataEnc(imgNm)
			end if
			
		next

	end if
	
	if nCnt == 1 then
		Container0.ImgDel1.visible	= false
		Container0.DelBg1.visible	= false
		Container0.ImgPic1.visible	= false
	end if
	
	if nCnt == 2 then
		Container0.ImgDel2.visible	= false
		Container0.DelBg2.visible	= false
		Container0.ImgPic2.visible	= false
	end if
			
	g_ImgCnt = g_ImgCnt - 1		
End Sub

'============================================================================
' 첨부파일 이미지 삭제(idx : 0)
'============================================================================
Sub Container0_ImgPic0_OnClick()
	Container0_ImgDel0_OnClick()
End Sub

'============================================================================
' 첨부파일 이미지 삭제(idx : 1)
'============================================================================
Sub Container0_ImgDel1_OnClick()
	Dim nCnt
	nCnt = 0

	if Container0.Table0.GetCellString(2, 0) <> "" then
		nCnt = 1
	end if

	if nCnt == 0 then
		Container0.ImgDel1.visible	= false
		Container0.DelBg1.visible	= false
		Container0.ImgPic1.visible	= false
'		Container0.ImgPic1.SetImageDataEnc("")
		Container0.Table0.SetCellString(1, 0, "")
		
	elseif nCnt <> 0 then
		Dim imgNm
		imgNm = Container0.Table0.GetCellString(2, 0)
		
		Container0.ImgDel2.visible	= false
		Container0.DelBg2.visible	= false
		Container0.ImgPic2.visible	= false
		Container0.Table0.SetCellString(1, 0, imgNm)
		Container0.Table0.SetCellString(2, 0, "")
		Container0.ImgPic1.SetImageDataEnc(imgNm)
	end if
			
	g_ImgCnt = g_ImgCnt - 1
End Sub

'============================================================================
' 첨부파일 이미지 삭제(idx : 1)
'============================================================================
Sub Container0_ImgPic1_OnClick()
	Container0_ImgDel1_OnClick()
End Sub

'============================================================================
' 첨부파일 이미지 삭제(idx : 2)
'============================================================================
Sub Container0_ImgDel2_OnClick()
	Container0.ImgDel2.visible	= false
	Container0.DelBg2.visible	= false
	Container0.ImgPic2.visible	= false
'	Container0.ImgPic2.SetImageDataEnc("")
	Container0.Table0.SetCellString(2, 0, "")
			
	g_ImgCnt = g_ImgCnt - 1
End Sub

'============================================================================
' 첨부파일 이미지 삭제(idx : 2)
'============================================================================
Sub Container0_ImgPic2_OnClick()
	Container0_ImgDel2_OnClick()
End Sub

'============================================================================
' 연락처변경 버튼
'============================================================================
Sub Container0_BtnCpno_OnClick()
	Form.OpenFramePopup("mbonl81000", "", "")
End Sub

'============================================================================
' 동의서 펼침/닫힘
'============================================================================
Sub Container0_btnMndtFold_OnClick()

	if g_bFold then
		g_bFold = false
		
		Container0.RadioGroup0.top	= 755
		Container0.Table1.top		= 520
		Container0.Table1.visible	= true
		Container0.imgArrow.imgpath = "icon_menu_fold_n"
		
		Container0.scroll_pos = 300
	else
		g_bFold = true
		
		Container0.RadioGroup0.top	= 520
		Container0.Table1.top		= 100
		Container0.Table1.visible	= false
		Container0.imgArrow.imgpath = "icon_menu_fold_o"
		
		Container0.scroll_pos = 30
	end if

	Container0.SetScrollAutoSize()
End Sub

'============================================================================
' 동의 미동의
'============================================================================
Sub Container0_RadioGroup0_OnClick(nIndex)
	
	if nIndex == 1 then
		Form.ShowAlert("알림", "미동의 시 제안을 등록할 수 없습니다.")
	end if
	
	f_EnableBtnConfirm()
End Sub

'============================================================================
' 등록 버튼
'============================================================================
Sub BtnConfirm_OnClick()

	if Container0.Edit0.caption == "" or Container0.Edit0.caption == null then
		Form.ShowAlert("알림", "제목을 입력하시기 바랍니다.")
		exit sub
		
	elseif Container0.Edit1.caption == "" or Container0.Edit1.caption == null then
		Form.ShowAlert("알림", "제안 내용을 입력하시기 바랍니다.")
		exit sub
	end if
	
	if Container0.RadioGroup0.currentindex == "1" then
		Form.ShowAlert("알림", "개인(신용) 정보 수집ㆍ이용 동의서에 동의 바랍니다.")
		exit sub
	end if
	
	BtnConfirm.enable = False
	DATAMANAGER.RequestTranData("obcpp_cbbs_002a")
End Sub

'===========================================================================
' 							사용자 함수
'============================================================================
' 등록버튼 활성화 함수
'============================================================================
Sub f_EnableBtnConfirm()

	if Container0.Edit0.caption == "" or Container0.Edit0.caption == null then
		BtnConfirm.enable = false
		exit sub
	end if

	if Container0.Edit1.caption == "" or Container0.Edit1.caption == null then
		BtnConfirm.enable = false
		exit sub
	end if

	if Container0.RadioGroup0.currentindex == "1" then
		BtnConfirm.enable = false
		exit sub
	end if

	BtnConfirm.enable = true	
End Sub

