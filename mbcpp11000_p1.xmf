'============================================================================
' 01. 화 면 명 : 제안하기_제안등록
' 02. 작    성 : 신명준
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_bFold
Dim g_ImgCnt
Dim g_PROP_REG_ID
Dim g_obcpp_cbbs_003a_Idx

'===========================================================================
' 							FORM 함수
'============================================================================
Sub Form_OnFormInit()
	g_bFold		= true
	g_ImgCnt		= 0

	Container0.btnSwitch.setApplySwitch("아니오", "예", 269, 261, 286, 289)
	Container0.btnSwitch.switchindex = "1"
	
	if Form.GetOpenLinkData() == "" or Form.GetOpenLinkData() == null or Form.GetOpenLinkData() == "(null)" then
		Container0.btnSwitch.switchindex = "0"
		Container0.LblCPNO.caption = "미등록"
		Container0.btnSwitch.enable = false
	else
		Container0.LblCPNO.caption = Form.GetOpenLinkData()
	end if
	
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		Container0.setScrollBarVisible("2")
	end if
	
	Container0.RadioGroup0.top	= 520
	Container0.Table1.top		= 100
	Container0.SetScrollAutoSize()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' 이미지 선택 또는 촬영 후 트리거이벤트로 이미지 전달
	' 정상처리 시, 공유변수 통해 이미지 데이터 가져오기 
	' # 트리거 이벤트 명  : CAPTURECOMPLETE
	' # sParam            : 1 정상 / 0 비정상
	' # 캡쳐이미지        : &RET_CAPTURE_IMAGE
	if sEventName = "CAPTURECOMPLETE" then
		Dim imgNm
		imgNm = Form.GetSharedData("&RET_CAPTURE_IMAGE", true)
		
'		if sParam = "1" then	'아이폰은 sPram 바로 데이터로 처리
			if Len(imgNm) < 102400 then	'이미지 최대사이즈				
				
				for i = 0 to 2
					
					if i == g_ImgCnt then
					
						if g_ImgCnt == 0 then
							Container0.ImgDel0.visible	= true
							Container0.DelBg0.visible	= true
							Container0.ImgPic0.visible	= true
							Container0.ImgPic0.SetImageDataEnc(imgNm)
						elseif g_ImgCnt == 1 then
							Container0.ImgDel1.visible	= true
							Container0.DelBg1.visible	= true
							Container0.ImgPic1.visible	= true
							Container0.ImgPic1.SetImageDataEnc(imgNm)
						elseif g_ImgCnt == 2 then
							Container0.ImgDel2.visible	= true
							Container0.DelBg2.visible	= true
							Container0.ImgPic2.visible	= true
							Container0.ImgPic2.SetImageDataEnc(imgNm)
						end if
						
					end if
				
				next

				'등록이미지				
				Container0.Table0.SetCellString(g_ImgCnt, 0, imgNm)

				g_ImgCnt = g_ImgCnt + 1
				
				if g_ImgCnt > 0 then
					Container0.Label4.visible = false
				else
					Container0.Label4.visible = true
				end if
				
			else
				Form.ShowAlert("알림", "등록할 수 있는 이미지 최대사이즈를 초과하였습니다.")
			end if
'		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	' 연락처 변경에 따른 전화번호 업데이트
	if sKeyName == "mbonl81000" then
		DATAMANAGER.RequestTranData("obcpp_cbbs_001r")
	end if

End Sub

'===========================================================================
' 							DATAMANAGER 함수
'===========================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obcpp_cbbs_001r" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "IQRY_CLS_CODE", 	0, "1")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "CLMN_TYPE_NAME", 	0, "")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "STA_DATE", 		0, "11110101")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "FIN_DATE", 		0, "99991231")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ELFN_ID", 		0, Form.GetSharedData("&USER_ID", false))
		
	elseif szTranID == "obcpp_cbbs_002a" then
		Dim WHOL_CPNO
		WHOL_CPNO = Replace(Container0.LblCPNO.caption, "-", "")
		
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROS_CLS_CODE", 	0, "I")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROP_REG_ID", 	0, "")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ELFN_ID", 		0, Form.GetSharedData("&USER_ID", false))
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "TITL_NAME", 		0, Trim(Container0.Edit0.caption))
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "REG_DTL_CNTT", 	0, Trim(Container0.Edit1.caption))
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "WHOL_CPNO", 		0, WHOL_CPNO)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ANSR_CNTT", 		0, "")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "RMRK", 			0, "")
		
		if CInt(Container0.btnSwitch.switchindex) == 1 Then
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "SMS_SNDN_YN", 0, "Y")
		else
			DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "SMS_SNDN_YN", 0, "N")
		end if
		
		BtnConfirm.enable = True
	
	elseif szTranID == "obcpp_cbbs_003a" then
		Dim UI_IMG_DATA
		UI_IMG_DATA = Container0.Table0.GetCellString(g_obcpp_cbbs_003a_Idx, 0)

		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROS_CLS_CODE", 	0, "I")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "PROP_REG_ID", 	0, g_PROP_REG_ID)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "REG_SRNO", 		0, 0)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ATCH_FILE_SIZE", 	0, LEN(UI_IMG_DATA))
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "UI_IMG_DATA", 	0, UI_IMG_DATA)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcpp_cbbs_001r" then
		Dim WHOL_CPNO
		WHOL_CPNO = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "WHOL_CPNO", 0)
		
		if WHOL_CPNO == "" or WHOL_CPNO == null or WHOL_CPNO == "(null)" then
			Container0.LblCPNO.caption = "미등록"
			Container0.btnSwitch.enable = false
		else
			Container0.LblCPNO.caption = WHOL_CPNO
		end if
				
	elseif szTranID == "obcpp_cbbs_002a" then
		g_PROP_REG_ID = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "PROP_REG_ID", 0)

		if g_ImgCnt == 0 then
			Form.ShowAlert("알림", "등록이 완료되었습니다.")
			Form.SendReturnToParent("mbcpp11000", "REFRESH")
			Form.CloseForm()
		else
			g_obcpp_cbbs_003a_Idx = 0
			
			DATAMANAGER.RequestTranData("obcpp_cbbs_003a")
		end if

	elseif szTranID == "obcpp_cbbs_003a" then
		g_obcpp_cbbs_003a_Idx = g_obcpp_cbbs_003a_Idx + 1

		if g_ImgCnt - 1 >= g_obcpp_cbbs_003a_Idx then
			DATAMANAGER.RequestTranData("obcpp_cbbs_003a")
		else			
			Form.ShowAlert("알림", "등록이 완료되었습니다.")
			Form.SendReturnToParent("mbcpp11000", "REFRESH")
			Form.CloseForm()
		end if

	end if
	
End Sub	

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	f_EnableBtnConfirm()
	
	if szErrCode == "4935" then
		szErrMsg = "제안 내용에 입력된 문자 중 일부 엔화나 유로 표시 같은 특수문자나 기호는 미인식으로 등록되지 않습니다."
		Form.ShowAlert( "안내" , szErrMsg)
		Exit Sub
	end if
	
	if szSubMsg <> null and szSubMsg <> "" then
		Form.ShowAlert( "안내" , szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert( "안내" , szErrMsg)
	end if
	
End Sub

