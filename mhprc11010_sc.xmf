'============================================================================
' Cancel_RealData
'============================================================================
Function Cancel_RealData()
	DATAMANAGER.CancelRealData("ohhts_smbd_aspr")
	DATAMANAGER.CancelRealData("ohhts_smbd_cntg")
	DATAMANAGER.CancelRealData("ohhts_bond_aspr")
	DATAMANAGER.CancelRealData("ohhts_bond_cntg")
	DATAMANAGER.CancelRealData("ohhts_bond_cntg_1")
	DATAMANAGER.CancelRealData("ohhts_smbd_cntg_1")
end Function

'============================================================================
' RequestData
'============================================================================
Function RequestData()
	DATAMANAGER.RequestTranData( "ohhts_7052_001r" )
	DATAMANAGER.RequestTranData( "ohhts_7052_003r" )
	DATAMANAGER.RequestTranData( "ohhts_7052_004r" )
	DATAMANAGER.RequestTranData( "ohhts_7052_005r" )
	DATAMANAGER.RequestTranData( "ohhts_7052_010r" )
end Function

