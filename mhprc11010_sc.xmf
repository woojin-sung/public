'============================================================================
' Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.setChartType("minibong")
End Sub

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	imgChart.visible = false
	'ChartEx0.visible = false
	grdTime.visible = true	
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "JMCODE" then
		Cancel_RealData()							' 무조건 리얼해제
		
		if Trim(sParam) <> "" then
			tData = Split(sParam, "★")

			g_szCd = tData(0)
			g_szMk = tData(1)
			
			RequestData()	
		end if	
	end if
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Cancel_RealData()
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)

	' ----------------------------------------------------------------------
	' 채권현재가
	' ----------------------------------------------------------------------	
	if szTranID = "ohhts_7052_001r" then		
		DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	' ----------------------------------------------------------------------
	' 채권현재가(체결)
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_7052_003r" then		
		DATAMANAGER.SetDataValue(0, "ohhts_7052_003r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_7052_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	' ----------------------------------------------------------------------
	' 채권현재가(차트)
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_7052_004r" then		
		DATAMANAGER.SetDataValue(0, "ohhts_7052_004r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_7052_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	' ----------------------------------------------------------------------
	' 채권현재가(호가)
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_7052_005r" then		
		DATAMANAGER.SetDataValue(0, "ohhts_7052_005r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_7052_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	' ----------------------------------------------------------------------
	' 소액채권 종류별 신고시장수익률
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_7052_010r" then		
		DATAMANAGER.SetDataValue(0, "ohhts_7052_010r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_7052_010r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	' ----------------------------------------------------------------------
	' 채권현재가
	' ----------------------------------------------------------------------	
    if szTranID = "ohhts_7052_001r" then
		if g_szMk = "B" then
		    DATAMANAGER.RequestRealData( "ohhts_bond_aspr" )
		    DATAMANAGER.RequestRealData( "ohhts_bond_cntg" )
		else
		    DATAMANAGER.RequestRealData( "ohhts_smbd_aspr" )
		    DATAMANAGER.RequestRealData( "ohhts_smbd_cntg" )		    
	    end if
	' ----------------------------------------------------------------------
	' 채권현재가(차트)
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_7052_004r" then
		if g_szMk = "B" then
		    DATAMANAGER.RequestRealData( "ohhts_bond_cntg_1" )
		else
		    DATAMANAGER.RequestRealData( "ohhts_smbd_cntg_1" )		    
	    end if
	End if
	
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 일반채권 호가 자동갱신
	' ----------------------------------------------------------------------	
	if szTranID = "ohhts_bond_aspr" then
	    DATAMANAGER.SetDataValue( 1, "ohhts_bond_aspr", "InBlock1", "FIDR_STND_ISCD", 0, g_szCd )
	' ----------------------------------------------------------------------
	' 일반채권 체결 자동갱신
	' ----------------------------------------------------------------------		
	elseif szTranID = "ohhts_bond_cntg" or szTranID = "ohhts_bond_cntg_1" then
	    DATAMANAGER.SetDataValue( 1, szTranID, "InBlock1", "FIDR_STND_ISCD", 0, g_szCd )
	' ----------------------------------------------------------------------
	' 소액채권 호가 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_smbd_aspr" then
	    DATAMANAGER.SetDataValue( 1, "ohhts_smbd_aspr", "InBlock1", "FIDR_STND_ISCD", 0, g_szCd )
	' ----------------------------------------------------------------------
	' 소액채권 체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_smbd_cntg" or szTranID = "ohhts_smbd_cntg_1" then
	    DATAMANAGER.SetDataValue( 1, szTranID, "InBlock1", "FIDR_STND_ISCD", 0, g_szCd )
	End if
End Sub


'============================================================================
' imgToggle_OnClick : 토글이미지 클릭
'============================================================================
Sub imgToggle_OnClick()
	grdTime_OnHeaderClickUp(0, "th_cell0")
End Sub

'============================================================================
' grdTime_OnHeaderClickUp
'============================================================================
Sub grdTime_OnHeaderClickUp(lRow, szCellID)
	grdTime.visible = false
	ChartEx0.visible = true
	imgChart.visible = true
End Sub

'============================================================================
' imgChart_OnClick
'============================================================================
Sub imgChart_OnClick()
	imgChart.visible = false
	'ChartEx0.visible = false
	grdTime.visible = true
End Sub

