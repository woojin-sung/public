	<SCRIPT_INFO _len="3381" _ulen="3119" >
'--===========================================================================
' 01. 화 면 명 : 
' 02. 화면설명 : 
' 03. 작    성 : 
' 04. 수    정 : 
'
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************

Dim g_szVCALL_TRGT_YN

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()

	tblOthers.visible = false
'szOpenData = "REG_FAIL"
	if szOpenData <> "" or szOpenData <> NULL then
		if szOpenData == "REG_SUCCESS" then	'등록완료
			Image0.imgpath = "check_red"
			
			lblTitle.caption = "개인전문투자자\n장외파생상품 거래요건 등록\n신청이 완료되었습니다."
			
			g_szVCALL_TRGT_YN = Form.GetSharedData( "mbonl94004_VCALL_TRGT_YN", false)	'영상통화여부
			if g_szVCALL_TRGT_YN = "Y" then
				Label1.caption = "당사 직원의 영상 통화 연결이"
				Label1.changeTextAttr(7, 5, 10, 0, false)
			else
				Label1.caption = "당사 직원의 유선 통화 연결이"
				Label1.changeTextAttr(7, 5, 10, 0, false)
			end if
			
		elseif szOpenData == "REG_FAIL" then	'신청불가
			Image0.imgpath = "icon_notice_3"
			
			lblTitle.caption = "개인전문투자자\n장외파생상품 거래요건 등록\n신청이 불가합니다."
			
			Label2.visible = false
			Label0.top = 290
			Label1.top = 315
			Label0.caption = "신청 가능 시간이 아닙니다."
			Label0.changeTextAttr(0, 15, 10, 0, false)
			Label1.caption = "(영업일 08:00~16:00까지 신청 가능)"
			Label1.changeTextAttr(0, 25, 10, 0, false)
		
		end if
	end if
	
End Sub

'============================================================================
' BtnOk_OnClick() : 화면 닫기
'============================================================================
Sub BtnOk_OnClick()
	Form.SendReturnToParent("close_mbonl94004_p2" , "")
	Form.CloseForm()
	Form.OpenMainMenuWithIndex("3", "3", "0")
End Sub

'============================================================================
Sub btnList_OnClick()
	Form.SendReturnToParent("close_mbonl94004_p2" , "")
	Form.CloseForm()
	Form.OpenScreen("94005" , "")
End Sub

'============================================================================
Sub Form_OnFormClose()
	'OS타입
	g_OsType = Form.GetSharedData("&OS_TYPE", false)
	if g_OsType == "1" then 'AOS
		Form.setCaptureEnblYN("Y")
	end if
End Sub


