Sub rdoType_OnClick(nIndex)
		g_NextCnt = 0
		DATAMANAGER.ClearOutputData(0, "obtro_oder_301r")
		
		DATAMANAGER.RequestTranData("obfnp_fnmt_011r")
End Sub

'============================================================================
Sub rdoType2_OnClick(nIndex)
		g_NextCnt = 0
		DATAMANAGER.ClearOutputData(0, "obtro_oder_301r")
		
		DATAMANAGER.RequestTranData("obfnp_fnmt_011r")		
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID = "obfnp_fnmt_011r" then	
		g_szACNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ACNO" , i) '계좌번호
		g_szASNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ASNO" , i) '계좌일련번호
		'해외주식 고유 주문체결내역 호출
		DATAMANAGER.RequestTranData("obtro_oder_301r")
	end if
	
	if szTranID = "obtro_oder_301r" then
		
		for i = g_NextCnt to grd0.rowcount - 1
		
			deal_cls_code   = grd0.GetCellData("bd_cell4", i)
			deal_cls_name	  = ""
			nation		  = grd0.GetCellData("bd_cell23", i)
			oder_condition  = grd0.GetCellData("bd_cell10", i)
			oder_prc		  = Cstr(grd0.GetCellData("bd_cell8", i))
			cntg_prc		  = Cstr(grd0.GetCellData("bd_cell9", i))
			rctf_cncl_cls_code = grd0.GetCellData("bd_cell14", i)
			
			iscd			= grd0.GetCellData("bd_cell3", i)
			exch			= right(iscd,2)
			
			
			if deal_cls_code = "1" then '매도
				deal_cls_name = "매도"
				grd0.SetCellFgColor("bd_cell4", i, "11")
				'grd0.SetCellData("bd_cell4", i, "매도")
			elseif deal_cls_code = "2" then 				'매수
				deal_cls_name = "매수"
				grd0.SetCellFgColor("bd_cell4", i, "10")
				'grd0.SetCellData("bd_cell4", i, "매수")
			else 
				Form.ShowAlert("TEST", "매도/매수가 아님")
			end if
			
			if rctf_cncl_cls_code = "1" then
				deal_cls_name = deal_cls_name & "정정"
			elseif rctf_cncl_cls_code = "2" then
				deal_cls_name = deal_cls_name & "취소"
			else
				deal_cls_name = deal_cls_name
			end if
			
			grd0.SetCellData("bd_cell4", i, deal_cls_name)
			
			if nation = "01" then
				grd0.SetCellData("bd_cell13", i, "미국")
			elseif nation = "02" then
				grd0.SetCellData("bd_cell13", i, "홍콩")
			elseif nation = "03" then
				grd0.SetCellData("bd_cell13", i, "중국")
			elseif nation = "04" then
				grd0.SetCellData("bd_cell13", i, "중국")
			elseif nation = "05" then
				grd0.SetCellData("bd_cell13", i, "일본")
			elseif nation = "07" then
				grd0.SetCellData("bd_cell13", i, "싱가포르")
			elseif nation = "08" then '2020.11.05 유로국가 추가
				grd0.SetCellData("bd_cell13", i, "영국")			
			elseif nation = "09" then
				grd0.SetCellData("bd_cell13", i, "영국")			
			elseif nation = "10" then
				grd0.SetCellData("bd_cell13", i, "독일")			
			elseif nation = "11" then
				grd0.SetCellData("bd_cell13", i, "핀란드")
			elseif nation = "12" then
				grd0.SetCellData("bd_cell13", i, "프랑스")			
			elseif nation = "13" then
				grd0.SetCellData("bd_cell13", i, "벨기에")			
			elseif nation = "14" then
				grd0.SetCellData("bd_cell13", i, "네덜란드")
			elseif nation = "15" then
				grd0.SetCellData("bd_cell13", i, "포르투갈")
			elseif nation = "16" then
				grd0.SetCellData("bd_cell13", i, "그리스")
			elseif nation = "17" then
				grd0.SetCellData("bd_cell13", i, "아일랜드")
			elseif nation = "18" then
				grd0.SetCellData("bd_cell13", i, "이탈리아")
			elseif nation = "19" then
				grd0.SetCellData("bd_cell13", i, "스페인")			
			elseif nation = "20" then
				grd0.SetCellData("bd_cell13", i, "오스트리아")				
			elseif nation = "21" then
				grd0.SetCellData("bd_cell13", i, "캐나다")
			elseif nation = "23" then
				grd0.SetCellData("bd_cell13", i, "인도네시아")
			elseif nation = "24" then
				grd0.SetCellData("bd_cell13", i, "베트남")
			elseif nation = "25" then
				grd0.SetCellData("bd_cell13", i, "베트남")
			elseif nation = "26" then
				grd0.SetCellData("bd_cell13", i, "스위스") 'v001
			else
				grd0.SetCellData("bd_cell13", i, "")
			end if
			
			grd0.SetCellData("bd_cell8", i , FormatNumber(oder_prc,4))
			grd0.SetCellData("bd_cell9", i , FormatNumber(cntg_prc,4))

			if oder_condition = "0" then
				grd0.SetCellData("bd_cell10", i, "정상")
			elseif oder_condition = "1" then
				grd0.SetCellData("bd_cell10", i, "거부")
			elseif oder_condition = "2" then
				grd0.SetCellData("bd_cell10", i, "자동거부")
			elseif oder_condition = "3" then
				grd0.SetCellData("bd_cell10", i, "자동취소(체결후)")
			elseif oder_condition = "4" then
				grd0.SetCellData("bd_cell10", i, "미접수")
			else
				Form.ShowAlert("TEST", "해당하는 주문조건 없음 : " & oder_condition & " , " & i)
			end if
			
		next
		
		g_NextCnt = g_NextCnt + DATAMANAGER.GetDataCount(0, "obtro_oder_301r", "OutBlock1")
		
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_NextCnt = 0
End Sub

