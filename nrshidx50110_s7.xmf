'============================================================================
Sub contMain_lblRate0_OnClick()
	if g_isClick0 = false then
		if g_isClick1 = true then
			Form.triggerEvent("#", "KEYPAD_END", g_szRate1)
		end if
		
		g_isClick0 = true
		g_isClick1 = false
		
		contMain.lblRate0.imagefilepth = g_szLblImg_Select
		contMain.lblRate1.imagefilepth = g_szLblImg_Normal
		
		Form.triggerEvent("#", "50110_S7_KEYPAD", "0`20`0`")
	else
		Form.triggerEvent("#", "KEYPAD_END", g_szRate0)
		
		g_isClick0 = false
		g_isClick1 = false

		contMain.lblRate0.imagefilepth = g_szLblImg_Normal
		contMain.lblRate1.imagefilepth = g_szLblImg_Normal
		
		Form.triggerEvent("#", "50110_S7_KEYPAD", "CLOSE")
		
		Send_ChkDataToParent()
	end if
	
End Sub

'============================================================================
Sub contMain_lblRate1_OnClick()
	if g_isClick1 = false then
		if g_isClick0 = true then
			Form.triggerEvent("#", "KEYPAD_END", g_szRate0)
		end if
		
		g_isClick1 = true
		g_isClick0 = false
		
		contMain.lblRate1.imagefilepth = g_szLblImg_Select
		contMain.lblRate0.imagefilepth = g_szLblImg_Normal

		Form.triggerEvent("#", "50110_S7_KEYPAD", "0`20`0`")'&g_szRate1)
	else
		Form.triggerEvent("#", "KEYPAD_END", g_szRate1)

		g_isClick0 = false
		g_isClick1 = false
	
		contMain.lblRate0.imagefilepth = g_szLblImg_Normal
		contMain.lblRate1.imagefilepth = g_szLblImg_Normal
		
		Form.triggerEvent("#", "50110_S7_KEYPAD", "CLOSE")
		
		Send_ChkDataToParent()
	end if
End Sub

'============================================================================
Sub contMain_btnChk_OnClick()
	if g_szChk = "1" then
		g_szChk = "0"
		contMain.imgChk.imgpath = g_szChkImg_Normal
		
		Clear_Period()
	else
		g_szChk = "1"
		contMain.imgChk.imgpath = g_szChkImg_Select
		
		All_Period()
	end if
	
	Send_ChkDataToParent()
End Sub

'============================================================================
Sub contMain_Pannel0_OnClick(nIndex, sCellID)
	if sCellID = "" then
		Exit Sub
	end if
	
	DisplaySetting_PannelBtn(nIndex, sCellID)
	
	Send_ChkDataToParent()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "50110_S7_CHECK" then
		Init_Data()
		
		g_szSharedData = Form.GetSharedData(g_szSharedKey_Period, false )
		arrTempData = Convert_StringToArr(g_szSharedData, "`")
						
		for i = 0 to #arrTempData - 1
			nStep0_Idx = Return_ArrayIndex(g_arrPeriod, arrTempData(i))
			Reload_PannelBtn(nStep0_Idx)
		next
		
		szReturn = Return_AllChkYN(g_arrPeriod_Check)

		if szReturn = "Y" then
			g_szChk = "1"
			contMain.imgChk.imgpath = g_szChkImg_Select
		else
			g_szChk = "0"
			contMain.imgChk.imgpath = g_szChkImg_Normal
		end if


		g_szSharedData = Form.GetSharedData(g_szSharedKey_Rate, false )
		arrTempData = Convert_StringToArr(g_szSharedData, "`")
		
		if #arrTempData > 1 then 
			szMinValue = replace(arrTempData(0), "%", "")
			szMaxValue = replace(arrTempData(1), "%", "")
			nMinValue = Cint(szMinValue)
			nMaxValue = Cint(szMaxValue)
			
			contMain.btnSlider.SetRangeSlider(0,  20,  nMinValue, nMaxValue, 1.0, 0)
			
			contMain.lblRate0.fgcolor = g_szTxtColor_Normal
			contMain.lblRate1.fgcolor = g_szTxtColor_Normal
		
			contMain.lblRate0.caption = arrTempData(0)
			contMain.lblRate1.caption = arrTempData(1)
		else
			contMain.btnSlider.SetRangeSlider(0,  20,  0, 20, 1.0, 0)
			contMain.btnSlider.setRangeSliderLineColor( 347,  347)
			contMain.lblRate0.fgcolor = g_szTxtColor_Grey
			contMain.lblRate1.fgcolor = g_szTxtColor_Grey
			
			contMain.lblRate0.caption = "배당률 입력"
			contMain.lblRate1.caption = "배당률 입력"
			Form.SetSharedData(g_szSharedKey_Rate, "")
		end if
	
	end if
	
	if sEventName = "KEYPAD" then
		if g_isClick0 = true then
			contMain.lblRate0.caption = sParam
			g_szRate0 = sParam
		elseif g_isClick1 = true then
			contMain.lblRate1.caption = sParam
			g_szRate1 = sParam
		end if
	end if
	
	if sEventName = "KEYPAD_END" then
		
		if g_isClick0 = true then
			if sParam = "" then
				if contMain.lblRate0.caption = "" or contMain.lblRate0.caption = "배당률 입력" or contMain.lblRate0.caption = "%" then
					g_szRate0 = ""
					contMain.btnSlider.setRangeSlider(0, 20, 0, 20, 1.0, 0)
					
					contMain.lblRate0.caption = "배당률 입력"
					if g_szRate1 <> "" then
						contMain.lblRate1.caption = g_szRate1 & "%"
					end if
					contMain.btnSlider.setRangeSliderLineColor(347, 347)
					
					contMain.lblRate0.fgcolor = g_szTxtColor_Grey
					contMain.lblRate1.fgcolor = g_szTxtColor_Grey
					
					g_isClick0 = false
			
					contMain.lblRate0.imagefilepth = g_szLblImg_Normal
					
					Form.triggerEvent("#", "50110_S7_KEYPAD", "CLOSE")
					
					Send_ChkDataToParent()
					exit Sub
				end if
			end if
			
			if sParam <> "" then
				g_szRate0 = sParam
			end if
			
			if Cint(g_szRate0) > Cint(g_szRate1) and g_szRate1 <> "" then
				g_szRate0 = ""
				contMain.btnSlider.setRangeSlider(0, 20, 0, 20, 1.0, 0)
				
				contMain.lblRate0.caption = "배당률 입력"
				if g_szRate1 <> "" then
					contMain.lblRate1.caption = g_szRate1 & "%"
				end if
				contMain.btnSlider.setRangeSliderLineColor(347, 347)
				
				contMain.lblRate0.fgcolor = g_szTxtColor_Grey
				contMain.lblRate1.fgcolor = g_szTxtColor_Grey
				
				Form.ShowAlert("알림", "배당률을 " & g_szRate1 & "% 보다 작게 입력해주세요")
				
'				contMain_lblRate0_OnClick()
				g_isClick0 = false
						
				contMain.lblRate0.imagefilepth = g_szLblImg_Normal
				
				Form.triggerEvent("#", "50110_S7_KEYPAD", "CLOSE")
				
				Send_ChkDataToParent()
				
				exit Sub
			end if
		
			
			contMain.lblRate0.caption = g_szRate0&"%"
			
			if g_szRate1 <> "" then
				contMain.btnSlider.setRangeSlider(0, 20, g_szRate0, g_szRate1, 1.0, 0)
				
				contMain.btnSlider.setRangeSliderLineColor(323,347)
				
				contMain.lblRate0.fgcolor = g_szTxtColor_Normal
				contMain.lblRate1.fgcolor = g_szTxtColor_Normal
			end if

			g_isClick0 = false
		
			contMain.lblRate0.imagefilepth = g_szLblImg_Normal
			
			Form.triggerEvent("#", "50110_S7_KEYPAD", "CLOSE")
			
			Send_ChkDataToParent()
			
		elseif g_isClick1 = true then
			
			if sParam = "" and (contMain.lblRate1.caption = ""or contMain.lblRate1.caption = "배당률 입력" or contMain.lblRate1.caption = "%")  then
				g_szRate1 = ""
				contMain.btnSlider.setRangeSlider(0, 20, 0, 20, 1.0, 0)
				contMain.lblRate1.caption = "배당률 입력"
				
				
				if g_szRate0 <> "" then
					contMain.lblRate0.caption = g_szRate0 & "%"
				end if
				contMain.btnSlider.setRangeSliderLineColor(347, 347)
				
				contMain.lblRate0.fgcolor = g_szTxtColor_Grey
				contMain.lblRate1.fgcolor = g_szTxtColor_Grey
				
				g_isClick1 = false
				
				contMain.lblRate1.imagefilepth = g_szLblImg_Normal
				
				Form.triggerEvent("#", "50110_S7_KEYPAD", "CLOSE")
				
				Send_ChkDataToParent()
				
				exit Sub
			end if
			
			if sParam <> "" then
				g_szRate1 = sParam
			end if
			
			if Cint(g_szRate1) < Cint(g_szRate0) and g_szRate0 <> "" then
				g_szRate1 = ""
				contMain.btnSlider.setRangeSlider(0, 20, 0, 20, 1.0, 0)
				
				contMain.lblRate1.caption = "배당률 입력"
				if g_szRate0 <> "" then
					contMain.lblRate0.caption = g_szRate0 & "%"
				end if
				contMain.btnSlider.setRangeSliderLineColor(347, 347)
				
				contMain.lblRate0.fgcolor = g_szTxtColor_Grey
				contMain.lblRate1.fgcolor = g_szTxtColor_Grey
				
				Form.ShowAlert("알림", "배당률을 " & g_szRate0 & "% 보다 크게 입력해주세요")
				
'				contMain_lblRate1_OnClick()
				g_isClick1 = false
				
				contMain.lblRate1.imagefilepth = g_szLblImg_Normal
				
				Form.triggerEvent("#", "50110_S7_KEYPAD", "CLOSE")
				
				Send_ChkDataToParent()
			
				exit Sub
			end if
	
			contMain.lblRate1.caption = g_szRate1&"%"
			
			if g_szRate0 <> "" then
				contMain.btnSlider.setRangeSlider(0, 20, g_szRate0, g_szRate1, 1.0, 0)
				
				contMain.btnSlider.setRangeSliderLineColor(323,347)
				
				contMain.lblRate0.fgcolor = g_szTxtColor_Normal
				contMain.lblRate1.fgcolor = g_szTxtColor_Normal
			end if
			
			g_isClick1 = false
					
			contMain.lblRate1.imagefilepth = g_szLblImg_Normal
			
			Form.triggerEvent("#", "50110_S7_KEYPAD", "CLOSE")
			
			Send_ChkDataToParent()
		end if
		
	end if
	
	if sEventName = "50110_COND_STAT" then
		if sParam = "N" then
			contMain.height = 444
		elseif sParam = "Y" then
			contMain.height = 334
		end if
		
		contMain.setScrollAutoSize()
	end if
End Sub


	</SCRIPT_INFO>
</ROOT>