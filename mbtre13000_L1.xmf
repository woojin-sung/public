	<SCRIPT_INFO _len="631" _ulen="597" >
Dim g_mrkt_code
g_mrkt_code = ""
'============================================================================
Sub Container0_Button0_OnClick()
'	Form.OpenScreen("16090" , "주문" .."★".. g_mrkt_code)
	Form.OpenScreen("16095" , "주문" .."★".. g_mrkt_code)	'20231226 HSZ: 해외CFD용 시세신청화면 추가
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "CFD_AbroadMarket" then
		g_mrkt_code = sParam
		
		Container0.Label11.caption = sParam
		Container0.Label12.caption = "("..sParam..")"
	end if
End Sub

