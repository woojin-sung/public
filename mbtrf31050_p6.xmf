	<SCRIPT_INFO _len="6175" _ulen="5577" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵 예약주문
' 02. 화면설명 : 선옵 예약주문 경고안내
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


Dim g_nCount
	g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소, 10:예약매수, 11:예약매도, 13:예약취소, 80:야간매수, 81:야간매도, 82:야간정정, 83:야간취소)
Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szOrd_ItmCode		' 종목코드
Dim 	g_szOrd_ItmName		' 종목명
Dim 	g_szOrd_OrdType		' 주문구분
Dim 	g_nOrd_Price			' 주문가격
Dim 	g_nOrd_Qty			' 주문수량
Dim 	g_nOrd_OrdNo			' 원주문번호
Dim 	g_szErrMsg			' 경고메세지


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)

	lblMsg.caption = g_szErrMsg	
	
	tbl0.SetCellString( 0, 1, g_szOrder_Acc 		)
	tbl0.SetCellString( 0, 2, g_szOrder_AccName	)
	tbl0.SetCellString( 1, 1, g_szOrd_ItmCode 	)
	tbl0.SetCellString( 2, 1, g_szOrd_ItmName	)
	tbl0.SetCellString( 3, 1, g_nOrd_Qty		)
	tbl0.SetCellString( 4, 1, g_nOrd_Price 		)

End Function

'============================================================================
Function SendOrder()
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문경고" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
    End If
    
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName, szMarketGubun

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	g_nIndex				= arrData( 0) ' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
	g_szOrder_Acc			= arrData( 1)	' 계좌번호
	g_szOrder_AccName		= arrData( 2)	' 고객명
	g_szOrd_ItmCode 		= arrData( 3)	' 종목코드
	g_szOrd_ItmName 		= arrData( 4)	' 종목명
	g_szOrd_OrdType  		= arrData( 5)	' 주문구분
	g_nOrd_Price 			= arrData( 6)	' 주문가격	
	g_nOrd_Qty   			= arrData( 7)	' 주문수량
	g_nOrd_OrdNo 			= arrData( 8)	' 원주문번호
	g_szErrMsg	 		= arrData( 9)	' 경고메세지
	
	
	'2017.12.13 주식선물의 경우 가격 > 소수점없음
	szMarketGubun = Form.GetItemCodeInfo( g_szOrd_ItmCode , "market")
	if szMarketGubun == "JF" or szMarketGubun == "JO" then
		tbl0.SetCellMaskInfo( 4, 1, "0,0,,,0,,0,1,1" )
	else
		'20220915 LES START
		'기존오류 수정, 테이블 로우 인덱스 잘못 세팅되어있었음
		'tbl0.SetCellMaskInfo( 1, 1, "0,0,,,0,,2,1,1" )
		tbl0.SetCellMaskInfo( 4, 1, "0,0,,,0,,2,1,1" )
		'20220915 LES END 
		
	end if
	
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	If g_nIndex = "0" Then
		lblTitle.caption = "선물옵션 매수주문"
		lblTitle.bgcolor = "92"
		tbl0.SetCellFgColor( 4, 0, "6" )
		tbl0.SetCellFgColor( 4, 1, "6" )
		btnOrder.btnimage = "btn_05.9"
		btnOrder.caption="매수"
		
	ElseIf g_nIndex = "1" Then
		lblTitle.caption = "선물옵션 매도주문"
		lblTitle.bgcolor = "91"
		tbl0.SetCellFgColor( 4, 0, "7" )
		tbl0.SetCellFgColor( 4, 1, "7" )
		btnOrder.btnimage = "btn_06.9"
		btnOrder.caption="매도"
	
	ElseIf g_nIndex = "2" Then
		lblTitle.caption = "선물옵션 정정주문"
		lblTitle.bgcolor = "93"
		tbl0.SetCellFgColor( 4, 0, "8" )
		tbl0.SetCellFgColor( 4, 1, "8" )
		btnOrder.btnimage = "btn_07.9"
		btnOrder.caption="정정"
		
	ElseIf g_nIndex = "10" Then
		lblTitle.caption = "선물옵션 예약 매수주문"
		lblTitle.bgcolor = "92"
		tbl0.SetCellFgColor( 4, 0, "6" )
		tbl0.SetCellFgColor( 4, 1, "6" )
		btnOrder.btnimage = "btn_05.9"
		btnOrder.caption="매수"
		
	ElseIf g_nIndex = "11" Then
		lblTitle.caption = "선물옵션 예약 매도주문"
		lblTitle.bgcolor = "91"
		tbl0.SetCellFgColor( 4, 0, "7" )
		tbl0.SetCellFgColor( 4, 1, "7" )
		btnOrder.btnimage = "btn_06.9"
		btnOrder.caption="매도"
	'20170421 HAMWG START : 야간선물옵션 주문 대응	
	ElseIf g_nIndex = "80" Then
		lblTitle.caption = "야간선물옵션 매수주문"
		lblTitle.bgcolor = "92"
		tbl0.SetCellFgColor( 4, 0, "6" )
		tbl0.SetCellFgColor( 4, 1, "6" )
		btnOrder.btnimage = "btn_05.9"
		btnOrder.caption="매수"
		
	ElseIf g_nIndex = "81" Then
		lblTitle.caption = "야간선물옵션 매도주문"
		lblTitle.bgcolor = "91"
		tbl0.SetCellFgColor( 4, 0, "7" )
		tbl0.SetCellFgColor( 4, 1, "7" )
		btnOrder.btnimage = "btn_06.9"
		btnOrder.caption="매도"
	
	ElseIf g_nIndex = "82" Then
		lblTitle.caption = "야간선물옵션 정정주문"
		lblTitle.bgcolor = "93"
		tbl0.SetCellFgColor( 4, 0, "8" )
		tbl0.SetCellFgColor( 4, 1, "8" )
		btnOrder.btnimage = "btn_07.9"
		btnOrder.caption="정정"
	'20170421 HAMWG END	
	End If	

    Set_Data(g_nIndex)
    
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm( )	
End Sub


'============================================================================
Sub btnOrder_OnClick()
	SendOrder()
End Sub


'============================================================================
Sub imgClose1_OnClick()
	Form.CloseForm( )
End Sub


	</SCRIPT_INFO>
