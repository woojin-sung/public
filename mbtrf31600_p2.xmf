	<SCRIPT_INFO _len="18344" _ulen="17334" >
'--===========================================================================
' 01. 화 면 명 : 해외 파생상품 거래내역 조회
' 02. 화면설명 : 해외 파생상품 거래내역 조회
' 03. 작    성 : 2023-12-20 YJH
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_nNextCount	'NextData 조회 시 grid Index값 설정을 위한 변수
g_nNextCount = 0

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_ClearData() : 초기화
'============================================================================
Function f_ClearData()
	Container0.Grid0.rowcount = 0
	g_nNextCount = 0
	Container0.Grid0.SetClear()

	Container0.tblIncome.SetCellString( 0 , 1, "")	'총 양도소득
	Container0.tblIncome.SetCellString( 1 , 1, "")	'총 비용
	Container0.tblIncome.SetCellString( 2 , 1, "")	'순양도소득
End Function

'============================================================================
' f_RequestTran() : RequestTranData
'============================================================================
Function f_RequestTran()
	if cmbAcct.itemcodetype = "135" then
		DATAMANAGER.RequestTranData( "obtrd_cntg_851r" ) '해외파생 파생상품 거래내역 조회
	else
		DATAMANAGER.RequestTranData( "obtrf_cntg_802r" )  '해외 파생상품 거래내역 조회
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
        Form.SetScreenName( "파생상품 거래내역 조회" )
	
	f_ClearData()
	
	szFromDate = Form.GetSharedData("mbtrf31600_cldFrom" , false)
	szToDate = Form.GetSharedData("mbtrf31600_cldTo" , false)
	
	cldFrom.caption = szFromDate
	cldTo.caption = szToDate
	
	f_RequestTran() 'RequestTranData
End Sub

'============================================================================
' cmbAcct_ChangeAccount() : 계좌변경
'============================================================================
Sub cmbAcct_ChangeAccount()
	f_ClearData()
	
	f_RequestTran() 'RequestTranData
End Sub

'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋데이터 세팅	
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'해외파생 파생상품 거래내역 조회
	If szTranID == "obtrd_cntg_851r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" 		, 0 , cmbAcct.total         )    '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" 		, 0 , cmbAcct.sequence )    '계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNT_PWD" 	, 0 , ""                          )     '계좌비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "STA_DATE" 	, 0 , cldFrom.caption      )    '시작일자
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FIN_DATE" 	, 0 , cldTo.caption         )     '종료일자
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FISCD" 		, 0 , "%"                        )     '종목코드
		
		If Container0.ChkButton0.checkstate == 1 or Container0.ChkButton0.checkstate == "1" then
	        	szValCLCD = "1" '청산거래만 보기
	        Else
	        	szValCLCD = "2" '신규거래도 포함해서 보기
	        End if
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "VAL_CLCD" 	, 0 , szValCLCD            )     '값구분코드
	Elseif szTranID == "obtrf_cntg_802r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" 		, 0 , cmbAcct.total         )    '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" 		, 0 , cmbAcct.sequence )    '계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNT_PWD" 	, 0 , ""                          )     '계좌비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "STA_DATE" 	, 0 , cldFrom.caption      )    '시작일자
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FIN_DATE" 	, 0 , cldTo.caption         )     '종료일자
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" 		, 0 , "%"                        )     '종목코드
		
		If Container0.ChkButton0.checkstate == 1 or Container0.ChkButton0.checkstate == "1" then
	        	szValCLCD = "1" '청산거래만 보기
	        Else
	        	szValCLCD = "2" '신규거래도 포함해서 보기
	        End if
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "VAL_CLCD" 	, 0 , szValCLCD            )     '값구분코드
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'해외파생 파생상품 거래내역 조회
	If szTranID == "obtrd_cntg_851r" Then
		CLRN_PRLS_AMT                = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "CLRN_PRLS_AMT"                  ) '청산손익금액
		MTRT_CLRN_PRLS_AMT      = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "MTRT_CLRN_PRLS_AMT"        ) '만기청산손익금액
		IF_TOTAL_TRNF_INCM_AMT = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "IF_TOTAL_TRNF_INCM_AMT"  ) '총양도소득금액
		TOTAL_FEE_AMT                 = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "TOTAL_FEE_AMT"                  ) '총수수료금액
		IF_LAST_TRNF_INCM_AMT   = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "IF_LAST_TRNF_INCM_AMT"     ) '최종양도소득금액
		
		Container0.tblIncome.SetCellString( 0 , 1, IF_TOTAL_TRNF_INCM_AMT)	'총 양도소득
		Container0.tblIncome.SetCellString( 1 , 1, TOTAL_FEE_AMT                )	'총 비용
		Container0.tblIncome.SetCellString( 2 , 1, IF_LAST_TRNF_INCM_AMT  )	'순양도소득

		Dim nDataCnt
		nDataCnt = tonumber(DATAMANAGER.GetDataCount( false, szTranID, "OutBlock1" ))
		
		For i = 0 to nDataCnt - 1
			Container0.Grid0.AddRow( )
				
			szOderDate                  = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "ODER_DATE" , i )
			szIscd                         = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "FISCD" , i )
			szKorIsnm                   = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "ISNM" , i )
			szFtopCntgUnpr            = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "CNTG_FPRC" , i )
			szCntgQty                    = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "CNTG_QTY" , i )
			szCntgAmt                   = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "CNTG_FAMT" , i )
			szIfProdType                = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "IF_PROD_TYPE" , i )
			szRsrpCntgQty              = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "CLRN_CNTG_QTY" , i )
			szRsrpCntgAmt             = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "CLRN_FAMT" , i )
			szRmndDealDate           = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "RMND_DEAL_DATE" , i )
			szAcbkAmt                   = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "OTST_STPL_AMT" , i )
			szDealFee                    = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "FFEE" , i )
			szByngVrssClrnPrlsAmt = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "CLRN_PRLS_FAMT" , i )
			szOderNo                     = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "ODER_NO" , i )
			szCntgNo                     = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "CNTG_NO" , i )
				
			szDealClsCode = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "DEAL_CLS_CODE" , i )
			szRmndDealClsCode = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "RMND_DEAL_CLS_CODE" , i )

			Container0.Grid0.SetCellData("bd_cell1", g_nNextCount, szOderDate)
			Container0.Grid0.SetCellData("bd_cell2", g_nNextCount, szIscd)
			Container0.Grid0.SetCellData("bd_cell3", g_nNextCount, szKorIsnm)
			Container0.Grid0.SetCellData("bd_cell5", g_nNextCount, szFtopCntgUnpr)
			Container0.Grid0.SetCellData("bd_cell6", g_nNextCount, szCntgQty)
			Container0.Grid0.SetCellData("bd_cell7", g_nNextCount, szCntgAmt)
			Container0.Grid0.SetCellData("bd_cell8", g_nNextCount, szIfProdType)
			Container0.Grid0.SetCellData("bd_cell9", g_nNextCount, szRsrpCntgQty)
			Container0.Grid0.SetCellData("bd_cell10", g_nNextCount, szRsrpCntgAmt)
			Container0.Grid0.SetCellData("bd_cell11", g_nNextCount, szRmndDealDate)
			Container0.Grid0.SetCellData("bd_cell13", g_nNextCount, szAcbkAmt)
			Container0.Grid0.SetCellData("bd_cell14", g_nNextCount, szDealFee)
			Container0.Grid0.SetCellData("bd_cell15", g_nNextCount, szByngVrssClrnPrlsAmt)
			Container0.Grid0.SetCellData("bd_cell16", g_nNextCount, szOderNo)
			Container0.Grid0.SetCellData("bd_cell17", g_nNextCount, szCntgNo)

			Select Case szDealClsCode
				Case "1"
					Container0.Grid0.SetCellData("bd_cell4", g_nNextCount, "매수")
				Case "2"
					Container0.Grid0.SetCellData("bd_cell4", g_nNextCount, "매도")
			End Select
				
			Select Case szRmndDealClsCode
				Case "1"
					Container0.Grid0.SetCellData("bd_cell12", g_nNextCount, "매수")
				Case "2"
					Container0.Grid0.SetCellData("bd_cell12", g_nNextCount, "매도")
			End Select
				
			g_nNextCount = g_nNextCount + 1
		Next
	Elseif szTranID == "obtrf_cntg_802r" Then
		CLRN_PRLS_AMT                = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "CLRN_PRLS_AMT"                  ) '청산손익금액
		MTRT_CLRN_PRLS_AMT      = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "MTRT_CLRN_PRLS_AMT"        ) '만기청산손익금액
		IF_TOTAL_TRNF_INCM_AMT = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "IF_TOTAL_TRNF_INCM_AMT"  ) '총양도소득금액
		TOTAL_FEE_AMT                 = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "TOTAL_FEE_AMT"                  ) '총수수료금액
		IF_LAST_TRNF_INCM_AMT   = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "IF_LAST_TRNF_INCM_AMT"     ) '최종양도소득금액
		
		Container0.tblIncome.SetCellString( 0 , 1, IF_TOTAL_TRNF_INCM_AMT)	'총 양도소득
		Container0.tblIncome.SetCellString( 1 , 1, TOTAL_FEE_AMT                )	'총 비용
		Container0.tblIncome.SetCellString( 2 , 1, IF_LAST_TRNF_INCM_AMT  )	'순양도소득

		Dim nDataCnt
		nDataCnt = tonumber(DATAMANAGER.GetDataCount( false, szTranID, "OutBlock1" ))
		
		For i = 0 to nDataCnt - 1
			Container0.Grid0.AddRow( )
				
			szOderDate                  = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "ODER_DATE" , i )
			szIscd                         = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "ISCD" , i )
			szKorIsnm                   = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "KOR_ISNM" , i )
			szFtopCntgUnpr            = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "FTOP_CNTG_UNPR" , i )
			szCntgQty                    = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "CNTG_QTY" , i )
			szCntgAmt                   = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "CNTG_AMT" , i )
			szIfProdType                = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "IF_PROD_TYPE" , i )
			szRsrpCntgQty              = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "RSRP_CNTG_QTY" , i )
			szRsrpCntgAmt             = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "RSRP_CNTG_AMT" , i )
			szRmndDealDate           = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "RMND_DEAL_DATE" , i )
			szAcbkAmt                   = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "ACBK_AMT" , i )
			szDealFee                    = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "DEAL_FEE" , i )
			szByngVrssClrnPrlsAmt = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "BYNG_VRSS_CLRN_PRLS_AMT" , i )
			szOderNo                     = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "ODER_NO" , i )
			szCntgNo                     = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "CNTG_NO" , i )
				
			szDealClsCode = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "DEAL_CLS_CODE" , i )
			szRmndDealClsCode = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1", "RMND_DEAL_CLS_CODE" , i )

			Container0.Grid0.SetCellData("bd_cell1", g_nNextCount, szOderDate)
			Container0.Grid0.SetCellData("bd_cell2", g_nNextCount, szIscd)
			Container0.Grid0.SetCellData("bd_cell3", g_nNextCount, szKorIsnm)
			Container0.Grid0.SetCellData("bd_cell5", g_nNextCount, szFtopCntgUnpr)
			Container0.Grid0.SetCellData("bd_cell6", g_nNextCount, szCntgQty)
			Container0.Grid0.SetCellData("bd_cell7", g_nNextCount, szCntgAmt)
			Container0.Grid0.SetCellData("bd_cell8", g_nNextCount, szIfProdType)
			Container0.Grid0.SetCellData("bd_cell9", g_nNextCount, szRsrpCntgQty)
			Container0.Grid0.SetCellData("bd_cell10", g_nNextCount, szRsrpCntgAmt)
			Container0.Grid0.SetCellData("bd_cell11", g_nNextCount, szRmndDealDate)
			Container0.Grid0.SetCellData("bd_cell13", g_nNextCount, szAcbkAmt)
			Container0.Grid0.SetCellData("bd_cell14", g_nNextCount, szDealFee)
			Container0.Grid0.SetCellData("bd_cell15", g_nNextCount, szByngVrssClrnPrlsAmt)
			Container0.Grid0.SetCellData("bd_cell16", g_nNextCount, szOderNo)
			Container0.Grid0.SetCellData("bd_cell17", g_nNextCount, szCntgNo)

			Select Case szDealClsCode
				Case "1"
					Container0.Grid0.SetCellData("bd_cell4", g_nNextCount, "매수")
				Case "2"
					Container0.Grid0.SetCellData("bd_cell4", g_nNextCount, "매도")
				Case "3"
					Container0.Grid0.SetCellData("bd_cell4", g_nNextCount, "매수청산") '선물옵션에서 사용하는 구분
				Case "4"
					Container0.Grid0.SetCellData("bd_cell4", g_nNextCount, "매도청산") '선물옵션에서 사용하는 구분
				Case "5"
					Container0.Grid0.SetCellData("bd_cell4", g_nNextCount, "권리행사") '선물옵션에서 사용하는 구분
				Case "6"
					Container0.Grid0.SetCellData("bd_cell4", g_nNextCount, "의무배정") '선물옵션에서 사용하는 구분
				Case "7"
					Container0.Grid0.SetCellData("bd_cell4", g_nNextCount, "행사포기") '선물옵션에서 사용하는 구분
				Case "8"
					Container0.Grid0.SetCellData("bd_cell4", g_nNextCount, "의무면제") '선물옵션에서 사용하는 구분
				Case "9"
					Container0.Grid0.SetCellData("bd_cell4", g_nNextCount, "기타") '선물옵션에서 사용하는 구분
			End Select
				
			Select Case szRmndDealClsCode
				Case "1"
					Container0.Grid0.SetCellData("bd_cell12", g_nNextCount, "매수")
				Case "2"
					Container0.Grid0.SetCellData("bd_cell12", g_nNextCount, "매도")
			End Select
				
			g_nNextCount = g_nNextCount + 1
		Next
	End if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 오류
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	Form.MsgBox( "알림", szErrMsg, "", 6 )
End Sub

'============================================================================
' Form_OnRefresh()
'============================================================================
Sub Form_OnRefresh()
	f_ClearData()
	
	f_RequestTran() 'RequestTranData
End Sub

'============================================================================
' btnRefresh_OnClick()
'============================================================================
Sub btnRefresh_OnClick()
	f_ClearData()
	
	f_RequestTran() 'RequestTranData
End Sub

'============================================================================
Sub cldFrom_OnEditComplete()
	f_ClearData()
	
	f_RequestTran() 'RequestTranData
End Sub

'============================================================================
Sub cldTo_OnEditComplete()
	f_ClearData()
	
	f_RequestTran() 'RequestTranData
End Sub

'============================================================================
Sub Container0_ChkButton0_OnChange(sCheckState)
	f_ClearData()
	
	f_RequestTran() 'RequestTranData
End Sub

'============================================================================
' Container0_Grid0_OnScrollEnd() : NextData 조회
'============================================================================
Sub Container0_Grid0_OnScrollEnd()
	if cmbAcct.itemcodetype = "135" then
		If DATAMANAGER.IsMoreNextData( "obtrd_cntg_851r" ) == True Then
			DATAMANAGER.RequestNextData( "obtrd_cntg_851r" ) '해외파생 파생상품 거래내역 조회
		End If
	else
		If DATAMANAGER.IsMoreNextData( "obtrf_cntg_802r" ) == True Then
			DATAMANAGER.RequestNextData( "obtrf_cntg_802r" ) '해외 파생상품 거래내역 조회
		End If
	end if
End Sub

