	<SCRIPT_INFO _len="12343" _ulen="11125" >
Dim g_szCode, g_szAction
g_szCode = ""
g_szAction = ""  'BLANK_ADD, BLANK_MOD, GROUP_ADD, GROUP_MOD, GROUP_ADD2

Dim g_szGroupID, g_szGroupName
g_szGroupID = ""

Dim g_szTitle
g_szTitle = "알림"

Dim g_szUserId
g_szUserId = Form.GetSharedData("&USER_ID" , false)	

'============================================================================
' Insert_GrdList : grdList에 종목 추가
'============================================================================
Function Insert_GrdList()

     '맨위/맨아래 위치에 추가 
	k = 0 '맨 위 추가 (T) - 기본
	if Trim(g_szCode) <> "" then
		grdList.insertrow = k
		grdList.SetCellData("bd_memo", k, "")
		grdList.SetCellData("bd_code", k, g_szCode)
		
		szMk = Form.GetItemCodeInfo(g_szCode, "market")
		grdList.SetCellData("bd_mk", k, szMk)
		
		szName = Form.GetItemCodeInfo(g_szCode, "name")
		grdList.SetCellData("bd_name", k, szName)
	end if
	
End Function

'============================================================================
' Change_EtcMarket :  해외지수(대표, 업종지수)/ 채권의 마켓구분 변경
'============================================================================
Function Change_EtcMarket(szData)
	if Trim(szData) == "UJ" then
		return "N"
	elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		return "B"
	end if	
	
	return szData
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	szData = Form.GetOpenLinkData()	
	
	if szData <> "" then
		tData = Split(szData, "★")
		g_szAction = tData(0)

		'1.관심그룹추가	
		if g_szAction == "GROUP_ADD" then 'from :: mhprc11000_pd의 그룹추가 클릭시 팝업
			btnAdd.caption = "추가하기"
			lblTitle.caption = "관심그룹 추가"
			lblMemo.caption = "추가할 관심그룹의 이름을 정해주세요."
			
			g_szGroupID = tData(1) '관심그룹코드 
			edtBlank.caption = "관심그룹" & g_szGroupID
			
			DATAMANAGER.RequestTranData("ohhts_intr_006r")
					
			
		'2.관심그룹명 수정	
		elseif g_szAction == "GROUP_MOD" then 
			btnAdd.caption = "변경하기"
			lblTitle.caption = "관심그룹 이름 변경"
			lblMemo.caption = "변경할 관심그룹의 이름을 정해주세요."
			
			rgTopButtom.visible = false
			lblRadiobg.visible = false
			btnCancel.top = 366
			btnAdd.top = 366
			imgBG.height = 190
			
			g_szGroupID = tData(1) '관심그룹코드 
			edtBlank.caption = tData(2) ' 관심그룹명
			
			' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
			DATAMANAGER.RequestTranData("ohhts_intr_006r")
			
		'3.관심그룹&관심종목 동시추가	
		elseif g_szAction == "GROUP_ADD2" then 'from :: 등록된 그룹이 없을 때
			btnAdd.caption = "추가하기"
			lblTitle.caption = "관심종목 추가"
			lblMemo.caption = "종목이 추가될 그룹을 만들어주세요."
			
			g_szCode = tData(1) '관심종목코드
			g_szGroupID = "000" '관심그룹코드
			edtBlank.caption = "관심그룹" & g_szGroupID
			
			' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
			DATAMANAGER.RequestTranData("ohhts_intr_006r")
						
		end if
	end if
	
End Sub

'============================================================================
' btnAdd_OnClick : Add버튼 클릭
'============================================================================
Sub btnAdd_OnClick()
	if g_szAction == "GROUP_ADD" or g_szAction == "GROUP_MOD" or g_szAction == "GROUP_ADD2" then
		
		if Trim(edtBlank.caption) == "" or edtBlank.caption = null then
			Form.ShowAlert(g_szTitle, "관심그룹 이름을 입력해주세요.")
			Exit Sub
		end if
		
		if g_szAction == "GROUP_ADD" or g_szAction == "GROUP_ADD2" then
			
			For i = 0 to grdGroup.rowcount - 1 
				if Trim(edtBlank.caption) == grdGroup.GetCellData("bd_name", i) then
					Form.ShowAlert(g_szTitle, "이미 동일 이름의 관심그룹이 있어요.\n이름을 다시 확인해주세요.")
					Exit Sub					
				end if
			Next
			
		elseif g_szAction == "GROUP_MOD" then
			
			For i = 0 to grdGroup.rowcount - 1 
				if Trim(edtBlank.caption) == grdGroup.GetCellData("bd_name", i) then
					Form.ShowAlert(g_szTitle, "이미 동일 이름의 관심그룹이 있어요.\n이름을 다시 확인해주세요.")
					Exit Sub					
				end if
			Next
			
		end if
		
	    if g_szAction == "GROUP_ADD2" then	'관심종목추가 & 종목추가
	    		
			if rgTopButtom.currentindex == "0" then
				g_szRow = 0			
			else
				g_szRow = grdGroup.rowcount			
			end if 			
			
			g_szGroupID = "000" 
			g_szGroupName = edtBlank.caption
			
			grdGroup.insertrow = g_szRow
			grdGroup.SetCellData("bd_count", g_szRow, 0)		'
			grdGroup.SetCellData("bd_code", g_szRow, g_szGroupID)
			grdGroup.SetCellData("bd_name", g_szRow, g_szGroupName)
	
			' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
			DATAMANAGER.RequestTranData("ohhts_intr_008r")
					
		else 
			if rgTopButtom.currentindex == "0" then
				szData = g_szGroupID & "★"& edtBlank.caption & "★T" 
			else
				szData = g_szGroupID & "★"& edtBlank.caption & "★B" 
			end if 
			
			Form.SendReturnToParent(g_szAction , szData)
			Form.CloseForm()
			
		end if 
	else
		
		Form.SendReturnToParent(g_szAction , edtBlank.caption)
		Form.CloseForm()
		
	end if
End Sub

'============================================================================
' btnCancel_OnClick : 취소버튼 클릭
'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
		'g_szGroupID = "" 
		'g_szGroupName = ""	
		grdGroup.rowcount = 0	' 그룹그리드 초기화	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, g_szUserId)	' USER ID
	
	' ----------------------------------------------------------------------
	' 관심그룹 추가
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_008r" then

		DATAMANAGER.ClearInputData(false, "ohhts_intr_008r")
		DATAMANAGER.ClearOutputData(false, "ohhts_intr_008r")
		
		' 종목추가, 빈칸적용시
		
		' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_USER_ID",     0, g_szUserId)		
		
		' FID버전ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)	
		
		' FID수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_MOD_YN",      0, "0")				
		
		' FID종목수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock1", "FID_ISSU_MOD_YN", 0, "0")				
		
		For i = 0 to grdGroup.rowcount - 1
		
			' FID관심종목그룹ID
			DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_CNCN_ISSU_NEW_GRP_ID", i, grdGroup.GetCellData("bd_code", i))
			
			' FID관심그룹명
			DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_CNCN_GRP_NAME",    i, grdGroup.GetCellData("bd_name", i))	
			
			' FID종목수정여부
			DATAMANAGER.SetDataValue(0, "ohhts_intr_008r", "InBlock2", "FID_ISSU_MOD_YN", i, "0")			' 수정안함: 0, 수정:1
		Next	
	' ----------------------------------------------------------------------
	' 관심종목 추가
	' ----------------------------------------------------------------------		
	elseif szTranID == "ohhts_intr_102r" then  
		
		DATAMANAGER.ClearInputData(0, "ohhts_intr_102r")
		
		' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock1", "FID_USER_ID",     0, g_szUserId)	' USER ID
		
		' FID버전ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)	
		
		For j = 0 to grdList.rowcount - 1
			
			' FID코드구분코드
			if Trim(grdList.GetCellData("bd_mk", j)) == "" then													
				if Trim(grdList.GetCellData("bd_name", j)) == "" then
					DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_CODE_CLS_CODE", j, "2")	' 빈칸
				else
					DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_CODE_CLS_CODE", j, "3")	' 메모
				end if
			else
				DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_CODE_CLS_CODE", j, "1")		' 종목
			end if
			
			'szGubun 세팅(OV: 해외주식, KR: 그 외)
			szCode = grdList.GetCellData("bd_code", j)
			szMk = ""
			szGubun = "" 
			if CInt(Instr(szCode, "@")) > 0 then	'@ 포함된 종목코드(해외주식, 해외지수 등)
				tCode = Split(szCode, "@")
				if UBOUND(tCode) < 1 then
					'Exit Function
				else	
					szMk  = tCode[0]
					if Trim(szMk) == "" then
						szMk = ""
					else
						nMkLen = Form.getLen(szMk)
						if nMkLen = 2 then
							szGubun = "OV" '해외주식(마켓구분 2자리)
						else
							szGubun = "KR"
						end if
					end if
				End if
			else
				szGubun = "KR"
			end if 			
			
			If szGubun == "OV" Then '해외
				
				' FID입력시장구분코드
				DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_INPUT_MRKT_CLS_CODE", j, szMk)	
				
				' FID관심종목코드
				DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_OVDV_ISCD", j, tCode(1) )	
				
				'국가구분코드
				DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_CNCN_GRP_NTNL_CLS_CODE", j, szGubun )					
		     else
				
				' FID입력시장구분코드
				szMk   = Form.GetItemCodeInfo(szCode, "market")
				szMk   = Change_EtcMarket(szMk)					
				
				DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_INPUT_MRKT_CLS_CODE", j, szMk)	
				
				' FID관심종목코드 / FID메모내용
				if Trim(grdList.GetCellData("bd_code", j)) == "빈칸" or Trim(grdList.GetCellData("bd_code", j)) == "EMPTY" then
					DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_OVDV_ISCD", j, "EMPTY")
				else
					DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_OVDV_ISCD", j, grdList.GetCellData("bd_code", j))
				end if 			
				
				'국가구분코드
				DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_CNCN_GRP_NTNL_CLS_CODE", j, szGubun )	
				
		     end if 
		Next		

		' FID관심종목그룹ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock3", "FID_CNCN_ISSU_NEW_GRP_ID", 0, g_szGroupID)
		
		' FID 구분
		if rgTopButtom.currentindex = "0" then
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock4", "FID_CLS", 0, "T")
		else
			DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock4", "FID_CLS", 0, "B")
		end if 
		
	end if 
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	'그룹추가
	If szTranID = "ohhts_intr_008r" then 
		Form.SetCtlProp("#edtChange", "caption", "1")	' 그룹변경을 알리기 위해..	
		
		grdGroup.selectrow = g_szRow
		
		'새로운 관심그룹을 등록하고 하나의 종목만 추가
		grdList.rowcount = 0
		Insert_GrdList()
		DATAMANAGER.RequestTranData("ohhts_intr_102r")
		
	'종목 추가	
	ElseIf szTranID = "ohhts_intr_102r" Then  '새로운 관심그룹에 관심종목 등록후 

	End If
	
	'편집시 ID가 메인화면과 연동안되는부분 때문에 추가
	If szTranID == "ohhts_intr_006r" or szTranID == "ohhts_intr_008r" or szTranID == "ohhts_intr_102r" Then	
		Form.SetSharedData("VRSN_ID", edtvrsnID.caption) 		
	End if 	
	
End Sub

'============================================================================
Sub edtBlank_OnEditChar(CharCode)
	nTextLen = edtBlank.getLenByte(edtBlank.caption)
		
	if Cint(nTextLen) > 40 then
		edtBlank.caption = g_exInputString
		edtBlank.SetFocus()
	else
		g_exInputString = CharCode
	end if
End Sub

