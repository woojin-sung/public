'============================================================================
' 01. 화 면 명 : CFD한도
' 02. 화면설명 : CFD한도_종목검색팝업
' 03. 작    성 : 2022.05.17 KSJ
'============================================================================
'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************


'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData( "obtrc_limt_005r" )
End Sub

'============================================================================
' grdList_OnClickUp(lRow, szCellID) : 종목선택
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szIscd, szIscdNm, szCrcd
	szIscd 	= grdList.GetCellData( "bd_Iscd", lRow ) 	'종목코드
	szIscdNm = grdList.GetCellData( "bd_IscdNm", lRow ) 	'종목명
	szCrcd 	= grdList.GetCellData( "bd_Crcd", lRow )		'통화코드
	
	Dim szSendData
	szSendData = szIscd & "★" & szIscdNm & "★" & szCrcd
	
	Form.SendReturnToParent( "mbtrc12000_p1" , szSendData )
	Form.CloseForm()
End Sub

'============================================================================
' grdList_OnScrollEnd() : Next 조회
'============================================================================
Sub grdList_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "obtrc_limt_005r" ) == true then
		DATAMANAGER.RequestNextData( "obtrc_limt_005r" )
	end if	
End Sub

'============================================================================
' btnSearch_OnClick() : 종목검색
'============================================================================
Sub btnSearch_OnClick()
	DATAMANAGER.RequestTranData( "obtrc_limt_005r" )
End Sub
'============================================================================
' edtIscdNm_OnEditComplete() : 종목명 입력
'============================================================================
Sub edtIscdNm_OnEditComplete()
	'빈값일경우 전체조회
	if edtIscdNm.caption == "" then
		DATAMANAGER.RequestTranData( "obtrc_limt_005r" )
	end if
End Sub


'============================================================================
' imgClose_OnClick : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub


'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋데이터 세팅	
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'CFD_종목별한도종목다건조회
	if szTranID == "obtrc_limt_005r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE"			, 0 , "1"	)			'처리구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "KOR_ISSU_ABWR_NAME"	, 0 , edtIscdNm.caption )	'종목명
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" 				, 0 , "" 	)			'종목번호
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 오류
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if

	Form.MsgBox( "알림", szErrMsg, "", 6 )
End Sub







