Sub contMain_lblBondMore_OnClick()
	
	'Bond365 페이지 오픈
	Form.OpenScreen("54100", "")
		
	if g_szDeviceOS == "2" then
		szPos = contMain.uniGetScroll()'contMain.scroll_pos * 0.88
		Form.SetSharedData("MERITZ365_SCROLL" , szPos)
	else
		szPos = contMain.scroll_pos
		Form.SetSharedData("MERITZ365_SCROLL" , szPos)
	end if
	
End Sub

