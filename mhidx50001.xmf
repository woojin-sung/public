'============================================================================
' 20240417 
'============================================================================
Sub contMain_OnNotifyScrolling(nIndex)
	
	if nIndex == 0 then
	
		ImageUp.visible = false
		ImageDown.visible = true
		
	elseif nIndex == 1 then
	
		ImageUp.visible = false
		ImageDown.visible = true
		
	elseif nIndex == 2 then
	
		ImageUp.visible = true
		ImageDown.visible = false
		
	end if

End Sub
'============================================================================
Function CheckCurScrollPos(nPos)

	if nPos >= gThirdAreaScrollPos then
		
		ImageUp.visible = true
		ImageDown.visible = false
		
	else
	
		ImageUp.visible = false
		ImageDown.visible = true
	
	end if

End Function
'============================================================================
Sub ImageUp_OnClick()

	if gOsType == "1" then
		contMain.uniSetScroll("0",gFirstAreaScrollPos)
	else
		contMain.scroll_pos_noAni = gFirstAreaScrollPos
	end if
	
End Sub

'============================================================================
Sub ImageDown_OnClick()

	nCurPos = Cint(contMain.uniGetScroll())

	if nCurPos < gSecondAreaScrollPos then
		
		if gOsType == "1" then
			contMain.uniSetScroll("0",gSecondAreaScrollPos)
		else
			contMain.scroll_pos_noAni = gSecondAreaScrollPos
		end if
	
	elseif nCurPos < gThirdAreaScrollPos then
	
		if gOsType == "1" then
			contMain.uniSetScroll("0",gThirdAreaScrollPos)
		else
			contMain.scroll_pos_noAni = gThirdAreaScrollPos
		end if
	
	end if
	
	
End Sub

