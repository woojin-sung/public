	<SCRIPT_INFO _len="11543" _ulen="11099" >
Dim gOsType

Dim gFirstAreaScrollPos
gFirstAreaScrollPos = 0

Dim gSecondAreaScrollPos
gSecondAreaScrollPos = 650

Dim gThirdAreaScrollPos
gThirdAreaScrollPos = 1152

'============================================================================
Sub Form_OnFormInitBefore()

	gOsType = Form.GetSharedData("&OS_TYPE", false)

	contMain.imgLight.setmaintainingRatio("1")
	contMain.imgBond.setmaintainingRatio("1")
	contMain.imgETF.setmaintainingRatio("1")
	contMain.imgIncome.setmaintainingRatio("1")
	contMain.imgIncome2.setmaintainingRatio("1")
	
	contMain.imgBond365Bg.setmaintainingRatio("1")
	contMain.imgETFBg.setmaintainingRatio("1")
	contMain.imgIncomeBg.setmaintainingRatio("1")
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	nTextSize = 1
	szTextSizeMode = Form.GetEnvData("common.textsize")
	if CInt(szTextSizeMode) > 0 then
		
		if gOsType == "1" then
			nTextSize = 1 - Cint((szTextSizeMode * 1))
		else
			nTextSize = 1 - Cint((szTextSizeMode * 2))
		end if
		
		'상단 문구영역
		contMain.Label1.fontsize = nTextSize
		contMain.Label2.fontsize = nTextSize
		contMain.Label3.fontsize = nTextSize
		
		'[Bond365], [ETF], [Income] 버튼
		contMain.lblBond365.fontsize = nTextSize - 1
		contMain.lblETF.fontsize = nTextSize - 1
		contMain.lblIncome.fontsize = nTextSize - 1
		
		'[Bond365영역]
		contMain.lblText2.fontsize = nTextSize + 7
		contMain.lblText3.fontsize = nTextSize - 3
		contMain.lblText4.fontsize = nTextSize - 3
		contMain.lblBondMore.fontsize = nTextSize - 3
		
		'[ETF영역]
		contMain.lblText7.fontsize = nTextSize + 7
		contMain.lblText8.fontsize = nTextSize - 3
		
		if gOsType == "1" then
			contMain.lblText8.left = 20
			contMain.lblText8.width = 330
		end if
		
		contMain.lblText9.fontsize = nTextSize - 3
		contMain.lblText10.fontsize = nTextSize - 3
		contMain.lblETFMore.fontsize = nTextSize - 3
		
		'[Income영역]
		contMain.lblText13.fontsize = nTextSize + 7
		contMain.lblText14.fontsize = nTextSize - 3
		contMain.lblIncomeMore.fontsize = nTextSize - 3
		
		
	end if	
	
	'--------------------------------------------------------------
	' 격이 다른 투자 상단문구영역 텍스트 설정 
	'--------------------------------------------------------------
	contMain.Label1.paddinginfo = "0,0,0,0"
	contMain.Label2.paddinginfo = "0,0,0,0"
	contMain.Label3.paddinginfo = "0,0,0,0"
	
	sTargetText1 = "빠르게"
	sTargetText2 = "쏙쏙"
	sTargetText3 = "Meritz365"
	
	sTargetLen1 = Form.getLen(sTargetText1)
	sTargetLen2 = Form.getLen(sTargetText2)
	sTargetLen3 = Form.getLen(sTargetText3)
	
	sTargetStart1 = Form.getLen("투자의 흐름을 ")
	sTargetStart2 = Form.getLen("돈이 되는 정보만 ")
	sTargetStart3 = Form.getLen("나만 받는 특별한 혜택 ")
	
	contMain.Label1.changeTextAttr(sTargetStart1, sTargetLen1, 334, nTextSize, true)
	contMain.Label2.changeTextAttr(sTargetStart2, sTargetLen2, 334, nTextSize, true)
	contMain.Label3.changeTextAttr(sTargetStart3, sTargetLen3, 334, nTextSize, true)
	
	contMain.lblText0.setHighlight(420)
	contMain.lblText5.setHighlight(421)
	contMain.lblText11.setHighlight(422)
	
	'--------------------------------------------------------------
	' 스크롤 위치 세팅
	'--------------------------------------------------------------
	g_szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
	
	'더 알아보기 이후 돌아왔을 경우 기억했던 스크롤 위치 세팅
	Dim nScrollPos
	nScrollPos = CInt(Form.GetSharedData("MERITZ365_SCROLL", true ))
	if Trim(nScrollPos) <> "" then
		if g_szDeviceOS == "2" then
			'contMain.lblScrollPos.top = nScrollPos
			'contMain.scroll_pos_noAni = contMain.lblScrollPos.top 
			
			contMain.uniSetScroll("0", nScrollPos)
			
		else
			contMain.scroll_pos = nScrollPos
		end if
	else
		contMain.scroll_pos = "top"
	end if
	
	
	'----------------------------------------------------------------------
	'20240417 [맨위로],[아래로] 버튼 동작관련 선행 작업 (컨테이너 스크롤 사용 설정) 
	'----------------------------------------------------------------------
	'버튼이미지 비율조정
	ImageUp.setMaintainingRatio("1")
	ImageDown.setMaintainingRatio("1")
	ImageUp.imgpath = "btn_up"
	ImageDown.imgpath = "btn_down"
	
	'컨테이너 스크롤링 이벤트 활성화
	contMain.SetUseScrollingEvent(true)
	
	'영역별 스크롤 위치값 세팅
	if gOsType == "1" then
		nFirstAreaScrollPosNoti 	= 0 
		nSecondAreaScrollPosNoti 	= CInt(Form.calcUnResize(contMain.lblText5.top , "1")) - 10
		nThirdAreaScrollPosNoti 	= CInt(Form.calcUnResize(contMain.lblText11.top , "1")) - 150
	else
		nFirstAreaScrollPosNoti 	= 0 
		nSecondAreaScrollPosNoti 	= contMain.lblText5.top - 10
		nThirdAreaScrollPosNoti 	= contMain.lblText11.top - 150
	end if
	
	contMain.SetNotifyScrollPos(nFirstAreaScrollPosNoti..":".. nSecondAreaScrollPosNoti .. ":" .. nThirdAreaScrollPosNoti)
	
	if nScrollPos <> "" then
		CheckCurScrollPos(nScrollPos)
	else
		CheckCurScrollPos(0)
	end if
	'----------------------------------------------------------------------
	
	
	
End Sub

