' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************

Dim g_szItemCode, g_szItemMarket
Dim g_nfmTab
Dim g_szfmTabPage
Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북

g_szfmTabPage = "page006984"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
' 설    명 : Form 호출시 최초실행
' 파람미터 : N/A
' 리 턴 값 : N/A
'============================================================================
Sub Form_OnFormInit()
	'20191008 HWG START : MTS 위변조방지 로직추가
	'------------------------------------------------------------------
	'MTS 위변조방지 스킵 대응
	szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	szDev 		= Form.GetSharedData("&SERVER_MODE", False)
	szAppVer 	= Form.GetSharedData("&APP_VERSION_CODE", False)
	szPrivateKey	= "vjdDoV5kQc7lNK4VARxk0TSWA4k=\n"
	
	if szDev <> "1" and szOsType == "1" and Cint(szAppVer) > 39 then
		szKeyValue = Form.GetSharedData("&KEY_VALUE", False)
		if trim(szPrivateKey) <> trim(szKeyValue) then
			
			'20180912_01 KBC START : 모의해킹결과조치
			if Cint(szAppVer) > 44 then
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.SetSharedData("&SGB" , "BBE") 
				
				Form.sendItemPrice()			'App 종료API 추가 (네이밍무관)
				Form.sendMessage()			'App 종료API 추가 (네이밍무관)
				Form.TerminateApp()
				
			else 
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.TerminateApp()
			end if

			'20180912_01 KBC END
			exit sub
		end if
	end if
	'20191008 HWG END
	
	Form.SetSharedData("&CODE_DUPR_USE" , "YES")	'20191022 HWG : 해외파생 중복실행 차단
	
	Dim szOpen, arrData

	szStyle	= Form.LoadConfigData("mhprc31000", "Style"	)	'현재가 스타일

	If szStyle = "0" Then
		linkfmHoga.linkfile = "mhprc31000_s1"
	ElseIf szStyle = "1" Then
		linkfmHoga.linkfile = "mhprc31000_s2"
	Else
		linkfmHoga.linkfile = "mhprc31000_s1"
	End If


'	g_nfmTab = Form.LoadConfigData( "mhprc31000", "frmTab" )	
'	fmtab0.currenttab = g_nfmTab

	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"★")
	
	if arrData(0) <> "" then
		g_szItemCode = arrData(0)
		
		' 타화면에서 호출되는 탭으로 이동
		If #arrData > 1 Then
			If arrData(1) <> "" then
				If g_szItemMarket = "JF" or g_szItemMarket = "JO" Then
					fmtab1.currenttab = arrData(1)
				Else
					fmtab0.currenttab = arrData(1)
				end If
			End If
		End If
	else
		g_szItemCode = Form.GetSharedData("&ITEM_FUTOPT", 0)		' 최근조회종목
	end if
	
	lblItemCode.caption = g_szItemCode
	
	Form.SetItemCode(g_szItemCode)							' 최초 화면진입시 종목코드 설정
	
	Form.triggerEvent("linkfmHoga", "INIT_CODE", g_szItemCode) 	' 링크화면에 종목코드 던지기
	
	If g_szItemMarket = "JF" or g_szItemMarket = "JO" Then
		Form.triggerEvent("fmtab1." & fmtab1.currenttabpageid, "INIT_CODE", g_szItemCode)	' 탭화면에 종목코드 던지기
	Else
		Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "INIT_CODE", g_szItemCode)	' 탭화면에 종목코드 던지기
	End If
	
End Sub

'============================================================================
Sub Form_OnFormClose()
'	Form.SaveConfigData("mhprc31000", "frmTab", g_nfmTab)
End Sub

'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
	g_nfmTab = nCurrentTab
	g_szfmTabPage = fmtab0.currenttabpageid
	
	Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "INIT_CODE", lblItemCode.caption )
End Sub

'============================================================================
Sub fmtab1_OnTabChanged(nCurrentTab)
	g_nfmTab = nCurrentTab
	g_szfmTabPage = fmtab1.currenttabpageid
	
	Form.triggerEvent("fmtab1." & fmtab1.currenttabpageid, "INIT_CODE", lblItemCode.caption )
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	'시장 인자(2번째 값)
'SEARCH_TYPE_INTR        = "0"
'SEARCH_TYPE_STOCK_ALL   = "1"
'SEARCH_TYPE_STOCK       = "2"
'SEARCH_TYPE_ELW         = "3"
'SEARCH_TYPE_FUOPT       = "4"
'SEARCH_TYPE_ETF         = "5"
'SEARCH_TYPE_ETN         = "6"
'SEARCH_TYPE_BOND        = "7"
'SEARCH_TYPE_OVERSEA     = "8"
'SEARCH_TYPE_JISU        = "9"
'SEARCH_TYPE_K200        = "10"
'SEARCH_TYPE_K200_MINI   = "11"
'SEARCH_TYPE_FUND        = "12"

	'20220915 HSZ START 상품선물 추가
	' 종목컨트롤
	Form.SetSearchType ("4:14:30")	' 선물옵션:주식선물옵션:상품선물
	'20220915 HSZ END
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "FORMTAB_SET" Then							' 폼탭 셋팅
		If g_szItemMarket = "JF" or g_szItemMarket = "JO" Then
			fmtab1.showconfig("탭표시 순서 변경")
		Else
			fmtab0.showconfig("탭표시 순서 변경")
		End If
		
	ElseIf sEventName = "FORMTAB_INIT" Then							' 폼탭 초기화
		If g_szItemMarket = "JF" or g_szItemMarket = "JO" Then
			fmtab1.SetDefaultHeader()
		Else
			fmtab0.SetDefaultHeader()
		End If
		
	ElseIf sEventName = "HOGA_SETUP" Then			' 폼탭 초기화
		Dim szStyle
		szStyle	= Form.LoadConfigData("mhprc31000", "Style"	)	'현재가 스타일
			
		If szStyle = "0" Then
			linkfmHoga.linkfile = "mhprc31000_s1"
		ElseIf szStyle = "1" Then
			linkfmHoga.linkfile = "mhprc31000_s2"
		Else
			linkfmHoga.linkfile = "mhprc31000_s1"
		End If
		
		If g_szItemMarket = "JF" or g_szItemMarket = "JO" Then
			If fmtab1.currenttab = "0" Or fmtab1.currenttab = 0 Then
				Form.triggerEvent("fmtab1." & fmtab1.currenttabpageid, "HOGA_SETUP", "" )
			End If
		Else
			If fmtab0.currenttab = "0" Or fmtab0.currenttab = 0 Then
				Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "HOGA_SETUP", "" )
			End If
		End If
		
		
		Form.SetItemCode(g_szItemCode)	'종목스타일 변경시 종목을 던져서 재조회

	ElseIf sEventName = "SCREEN_MENU" Then							' 연결정보(상단 ...)
		
		If sParam = "POP_UP1" Then								' 프로그램동향(투자자동향)
			Form.OpenScreen("43000" , 3)
		
		ElseIf sParam = "REG_INTR" Then								' 관심종목등록
			Form.OpenPopup("mhprc11000_pd" , g_szItemCode , "")
			
		ElseIf sParam = "SET_SCREEN" Then							' 화면설정
			Form.OpenFramePopup("mhprc31000_p1" , "" , "")
			
		ElseIf sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns" , "1", "")
		End If
		
	ElseIf sEventName = "sharedata" Then
		Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
	' 상단바 클릭 시
	'20220922 SWJ START : 상단 바 클릭 시, 종목선택창 팝업 추가
	ElseIf sEventName = "TITLE_CLICK" Then
		Form.OpenCommonDialog("SEARCH", "4:14:30", "")		' 선물옵션:주식선물옵션:상품선물
	'20220922 SWJ END
	End If
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		lblItemCode.caption = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

		If g_szItemMarket = "JF" or g_szItemMarket = "JO" Then
			Dim nScrollValue
			nScrollValue = fmtab0.getTabScrollX()
			
			fmtab0.visible = "0"
			fmtab1.visible = "1"
			fmtab1.currenttabpageid = g_szfmTabPage
			fmtab1.setTabScrollX(nScrollValue)
		Else
			Dim nScrollValue
			nScrollValue = fmtab1.getTabScrollX()
			'20220915 HSZ START 상품선물 추가
			If g_szItemMarket = "CF" or g_szItemMarket = "FF" Then		'20221110 SWJ START : 일반상품선물, 금융상품선물 분리 (거래소 차세대)
				fmtab0.deletepage = "page004695"	'프로그램
				fmtab0.deletepage = "page008812"	'미결제약정
			end if
			'20220915 HSZ END
			fmtab0.visible = "1"
			fmtab1.visible = "0"
			fmtab0.currenttabpageid = g_szfmTabPage
			fmtab0.setTabScrollX(nScrollValue)
		End If
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	If sKeyName = "FORMTAB_SET" Then		' 폼탭 셋팅
		If g_szItemMarket = "JF" or g_szItemMarket = "JO" Then
			fmtab1.showconfig("탭표시 순서 변경")
		Else
			fmtab0.showconfig("탭표시 순서 변경")
		End If
		
	ElseIf sKeyName = "FORMTAB_INIT" Then		' 폼탭 초기화
		If g_szItemMarket = "JF" or g_szItemMarket = "JO" Then
			fmtab1.SetDefaultHeader()
		Else
			fmtab0.SetDefaultHeader()
		End If
		
	ElseIf sKeyName = "HOGA_SETUP" Then			' 폼탭 초기화
		Dim szStyle
		szStyle	= Form.LoadConfigData("mhprc31000", "Style"	)	'현재가 스타일
			
		If szStyle = "0" Then
			linkfmHoga.linkfile = "mhprc31000_s1"
		ElseIf szStyle = "1" Then
			linkfmHoga.linkfile = "mhprc31000_s2"
		Else
			linkfmHoga.linkfile = "mhprc31000_s1"
		End If
		
		If g_szItemMarket = "JF" or g_szItemMarket = "JO" Then
			If fmtab1.currenttab = "0" Or fmtab1.currenttab = 0 Then
				Form.triggerEvent("fmtab1." & fmtab1.currenttabpageid, "HOGA_SETUP", "" )
			End If
		Else
			If fmtab0.currenttab = "0" Or fmtab0.currenttab = 0 Then
				Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "HOGA_SETUP", "" )
			End If
		End If
		
		
		Form.SetItemCode(g_szItemCode)	'종목스타일 변경시 종목을 던져서 재조회
		
	elseif sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else
			Form.triggerEvent("linkfmHoga", "sharedata", "")
		End If

	End If
End Sub

'============================================================================
Sub Form_OnRefresh()
	Form.triggerEvent("linkfmHoga", "INIT_CODE", g_szItemCode) 	' 링크화면에 종목코드 던지기
	
	If g_szItemMarket = "JF" or g_szItemMarket = "JO" Then
		Form.triggerEvent("fmtab1." & fmtab1.currenttabpageid, "INIT_CODE", g_szItemCode)	' 탭화면에 종목코드 던지기
	Else
		Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "INIT_CODE", g_szItemCode)	' 탭화면에 종목코드 던지기
	End If
End Sub
'============================================================================
'20220922 SWJ START : 상단 바 클릭 시, 종목선택창 팝업 추가
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	' 종목컨트롤에서 리턴
	if sDlgName == "SEARCH" then
		if Trim(sReturn1) <> "" then
			Form.SetItemCode(sReturn1)
		end if
	end if
End Sub
	</SCRIPT_INFO>
