	<SCRIPT_INFO _len="1369" _ulen="1367" >
Dim g_sSettingFlag
g_sSettingFlag = ""
'============================================================================
Sub Form_OnFormInit()
	
	acctItemType = Form.GetOpenLinkData()
	
	if acctItemType <> "" then
		Account0.itemcodetype = acctItemType
	end if
	
	
End Sub

'============================================================================
Sub btnSetting_OnClick()
	selectAccnt = Account0.caption
	
	if ChkAvrgPrice.checkstate == "1" and ChkOrderList.checkstate == "1" then
		g_sSettingFlag = "Both"
	end if
	
	Form.SendReturnToParent("OrderList_Accnt_Select" , selectAccnt & "★" & g_sSettingFlag)	'20240610 SWJ START
	Form.CloseForm()
End Sub

'============================================================================
Sub ImgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'20240610 SWJ START
'============================================================================
Sub ChkAvrgPrice_OnChange(sCheckState)
	if Cint(sCheckState) == 1 then
		'ChkOrderList.checkstate = "0"
		g_sSettingFlag = "AvgBuyPrice"
	end if
End Sub

'============================================================================
Sub ChkOrderList_OnChange(sCheckState)
	if Cint(sCheckState) == 1 then
		'ChkAvrgPrice.checkstate = "0"
		g_sSettingFlag = "OrderList"
	end if
End Sub

	</SCRIPT_INFO>
