'			DATAMANAGER.SetDataValue( false, "obtrs_cntg_538r", "InBlock1", "CRDT_EXPN_INCU_YN" , 0 , "N" )
'		end if
	'===========================================================종목별
	elseif szTranID == "obtrs_cntg_540r" then
		DATAMANAGER.SetDataValue(0 ,"obtrs_cntg_540r", "InBlock1", "ACNO" , 0 , szACNO )
		DATAMANAGER.SetDataValue(0 ,"obtrs_cntg_540r", "InBlock1", "ASNO" , 0 , szASNO )
		DATAMANAGER.SetDataValue(0 ,"obtrs_cntg_540r", "InBlock1", "IQRY_STA_DATE" , 0 , cont0.calStart.caption )
		DATAMANAGER.SetDataValue(0 ,"obtrs_cntg_540r", "InBlock1", "IQRY_FIN_DATE" , 0 , cont0.calEnd.caption )
		DATAMANAGER.SetDataValue(0 ,"obtrs_cntg_540r", "InBlock1", "ISCD" , 0 , "%" )
'		if chkGrid.checkstate == "1" then
			DATAMANAGER.SetDataValue(0 ,"obtrs_cntg_540r", "InBlock1", "CRDT_EXPN_INCU_YN" , 0 , "Y" )
'		else
'			DATAMANAGER.SetDataValue(0 ,"obtrs_cntg_540r", "InBlock1", "CRDT_EXPN_INCU_YN" , 0 , "N" )
'		end if
	elseif szTranID == "obtrs_cntg_541r" then
		DATAMANAGER.SetDataValue(0 ,"obtrs_cntg_541r", "InBlock1", "ACNO" , 0 , szACNO )
		DATAMANAGER.SetDataValue(0 ,"obtrs_cntg_541r", "InBlock1", "ASNO" , 0 , szASNO )
		DATAMANAGER.SetDataValue(0 ,"obtrs_cntg_541r", "InBlock1", "IQRY_STA_DATE" , 0 , cont0.calStart.caption )
		DATAMANAGER.SetDataValue(0 ,"obtrs_cntg_541r", "InBlock1", "IQRY_FIN_DATE" , 0 , cont0.calEnd.caption )
		DATAMANAGER.SetDataValue(0 ,"obtrs_cntg_541r", "InBlock1", "ISCD" , 0 , "%" )
