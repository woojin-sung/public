'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtrs_cntg_537r" or szTranID == "obtrs_cntg_541r" then
		'
	elseif szTranID = "obtrs_cntg_538r" or szTranID == "obtrs_cntg_540r" then
		for i = 0 to cont0.Grid0.rowcount - 1
			'일자별
			cont0.Grid0.setcellImage("bd_cell12", i, "btn_14_n.9")
			cont0.Grid0.SetCellData("bd_cell12", i, "상 세")
			cont0.Grid0.SetCellAttrColor("bd_cell12", i, "235")
			cont0.Grid0.SetCellFgColor("bd_cell12", i, "235")
			
			'종목별
			cont0.Grid0.setcellImage("bd_cell26", i, "btn_14_n.9")
			cont0.Grid0.SetCellData("bd_cell26", i, "상 세")
			cont0.Grid0.SetCellAttrColor("bd_cell26", i, "235")
			cont0.Grid0.SetCellFgColor("bd_cell26", i, "235")
		next
		
		'20240415_1 START: iOS OnScrollEnd 안타는 현상 조치
		if g_OStype = "2" then
			nDataCnt = CInt(DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1"))
			if nDataCnt > 29 then	'1회 최대데이터 30개
				cont0.Grid0. height= (CInt(cont0.Grid0.rowcount) - 1) * 60
				cont0.SetScrollAutoSize()
				exit Sub
			end if
		end if
		' 20240415_1 END
		
		cont0.Grid0.height = CInt(cont0.Grid0.rowcount) * 60 + 50 + 5'5=기기별 비율 상이로 인한 여유공간
		cont0.SetScrollAutoSize()
		
	elseif szTranID == "obcpp_bsdy_018r" then
		'1일 2월 3화 4수 5목 6금 7토
		g_nToday = CInt(DATAMANAGER.GetDataValue( false, "obcpp_bsdy_018r", "OutBlock1", "WKDY_CLS_CODE" , 0 ))
		RequestData()
	end if
End Sub

'============================================================================
Sub cont0_rdoPeriod_OnClick(nIndex)
	f_SetControl()
	if nIndex <> 4 then
		cont0.calEnd.todaymode = 1
		cont0.calStart.todaymode = 1
		if nIndex == 1 then	'1주일
			cont0.calStart.addday = -7
		elseif nIndex == 2 then	'1개월
			cont0.calStart.addday = -30
		elseif nIndex == 3 then	'6개월
			cont0.calStart.addday = -30*6
		end if
		
		RequestData()
	end if
End Sub

'============================================================================
Sub cont0_cmbDate_OnEditComplete(iIndex)
	Form.SetSharedData("JANGO_DATE_COMBO_SET" , iIndex)
	'일자별/종목별일 때 사용하는 날짜 콤보

	cont0.calEnd.todaymode = 1'콤보 적용시 end는 오늘 날짜 셋팅
	cont0.calStart.todaymode = 1
	iIndex = CInt(iIndex)
	if iIndex == 0 then
		'당일
	elseif iIndex == 1 then'금주
	'1일 2월 3화 4수 5목 6금 7토
		if g_nToday == 3 then
			cont0.calStart.addday = -1
		elseif g_nToday == 4 then
			cont0.calStart.addday = -2
		elseif g_nToday == 5 then
			cont0.calStart.addday = -3
		elseif g_nToday == 6 then
			cont0.calStart.addday = -4
		elseif g_nToday == 7 then
			cont0.calStart.addday = -5
		elseif g_nToday == 1 then
			cont0.calStart.addday = -6
		end if
	elseif iIndex == 2 then'금월
		cont0.calStart.caption = g_szTodayYearMon.."01"
	elseif iIndex == 3 then'금년
		cont0.calStart.caption = left(g_szTodayYearMon,4).."0101"
	elseif iIndex == 4 then'1개월
		cont0.calStart.addday = -30
	elseif iIndex == 5 then'3개월
		cont0.calStart.addday = -30 * 3
	elseif iIndex == 6 then'6개월
		cont0.calStart.addday = -30 * 6
	elseif iIndex == 7 then'1년
		cont0.calStart.addday = -365
	end if
	
	RequestData()
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if "RECEIVE" == sEventName or "CHANGE_ACCTNO" == sEventName then
		DATAMANAGER.RequestTranData( "obcpp_bsdy_018r" )
	elseif "LINK_HEIGHT" == sEventName then
		if sParam <> "" then
			cont0.lkf0.height = CInt(sParam)
			cont0.SetScrollAutoSize()
		end if
	end if
End Sub

'============================================================================
Sub cont0_Grid0_OnClickUp(lRow, szCellID)
	if szCellID == "bd_cell12" then'일별
		szTrDate = cont0.Grid0.GetCellData( "bd_cell0", lRow )
		Form.OpenFramePopup( "mbtrs15020_p2.xmf" , szTrDate+"!"+" "+"!".."1", "" )'1=신용비용포함 0신용비용 미포함
	elseif szCellID == "bd_cell26" then'종목별
		'순서 : 계좌번호 계좌일련번호 종목코드 시작일자 종료일자 신용비용
		szTempAcno = Form.GetCtlProp("#acnt0", "total")
		szTempAsno = Form.GetCtlProp("#acnt0", "sequence")
		szTempIscd = cont0.Grid0.GetCellData("bd_cell16", lRow)
		szTempStaDate = cont0.calStart.caption
		szTempFinDate = cont0.calEnd.caption
		szTempIncuFlag= "1"'신용비용포함
		
		szOpenData = szTempAcno & "★" & szTempAsno & "★" & szTempIscd & "★" & szTempStaDate & "★" & szTempFinDate & "★" & szTempIncuFlag
		Form.OpenFramePopup("mbtrs15020_p3.xmf" , szOpenData , "")
	end if
End Sub

'============================================================================
Sub cont0_cmb0_OnEditComplete(iIndex)
	f_SetControl()
	RequestData()
End Sub

function f_SetControl()
	Dim nCmbType,nCmbGbn,nRdo
	nCmbType = CInt(cont0.cmb0.currentindex)
	nCmbGbn = CInt(cont0.cmbDateGbn.currentindex)
	nRdo = CInt(cont0.rdoPeriod.currentindex)
	
	if nCmbType == 2 then		'일별수익률
		cont0.cmbDate.visible = false
		cont0.cmbDateGbn.visible = true
		cont0.lkf0.visible = true
		cont0.tbl0.visible = false
		cont0.lblTitle.visible = false	'20240416
		cont0.Grid0.visible = false		'20240416
		
		if nCmbGbn == 0 then	'일별
			cont0.rdoPeriod.visible = true
			cont0.FormTab0.visible = true
			cont0.calStartMon.visible = false
			cont0.calEndMon.visible = false
			cont0.lblCalMon.visible = false
			cont0.calStart.visible = true
			cont0.calEnd.visible = true
			cont0.lblCal.visible = true
			
'			if nRdo <> 4 then	'기간설정 X
'				imgBg.height = 85
'				lkf0.top = 10 + 85 + 10
'				lkf0.height = 469 - (10 + 85 + 10)
'				calStart.visible = false
'				calEnd.visible = false
'				lblCal.visible = false
'			else
'				imgBg.height = 125
'				lkf0.top = 10 + 125 + 10
'				lkf0.height = 469 - (10 + 125 + 10)
'				calStart.visible = true
'				calEnd.visible = true
'				lblCal.visible = true
'			end if
		else					'월별
			cont0.rdoPeriod.visible = false
			cont0.FormTab0.visible = false
'			imgBg.height = 90
'			lkf0.top = 10 + 90 + 10
'			lkf0.height = 469 - (10 + 90 + 10)
			cont0.calStart.visible = false
			cont0.calEnd.visible = false
			cont0.lblCal.visible = false
			
			cont0.calStartMon.visible = true
			cont0.calEndMon.visible = true
			cont0.lblCalMon.visible = true
			
		end if
		cont0.imgBg.height = 90
		cont0.lkf0.top = 10 + 90 + 10
		cont0.lkf0.height = 469 - (10 + 90 + 10)
		szHeight = cont0.lkf0.height
		Form.triggerEvent("lkf0", "SetHeight", szHeight)
	else						'일자별/종목별
		cont0.cmbDate.visible = true
		cont0.cmbDateGbn.visible = false
		cont0.rdoPeriod.visible = true
		cont0.FormTab0.visible = true
		cont0.lkf0.height = 0 '20240416
		cont0.lkf0.visible = false
		cont0.lblTitle.visible = true	'20240416
		cont0.Grid0.visible = true		'20240416
		
		cont0.tbl0.visible = true
		cont0.imgBg.height = 190
		
		cont0.calStartMon.visible = false
		cont0.calEndMon.visible = false
		cont0.lblCalMon.visible = false
		
		cont0.calStart.visible = true
		cont0.calEnd.visible = true
		cont0.lblCal.visible = true
		
'		if nRdo <> 4 then		'기간설정 X
'			tbl0.top = 95
'			imgBg.height = 190
'			lblTitle.top = 210
'			Grid0.top = 234
'			Grid0.height = 235
'
'			calStart.visible = false
'			calEnd.visible = false
'			lblCal.visible = false
'		else
'			tbl0.top = 95 + 30 + 10
'			imgBg.height = 190 + 30 + 10
'			lblTitle.top = 210 + 30 + 10
'			Grid0.top = 234 + 30 + 10
'			Grid0.height = 235 - 30 - 10
'
'			calStart.visible = true
'			calEnd.visible = true
'			lblCal.visible = true
'		end if
	end if
end function

