	<SCRIPT_INFO _len="14921" _ulen="14307" >
Dim g_nToday'오늘의 용일 저장(금주
Dim g_szTodayYearMon'이번 년+달(6자리)

Dim g_OStype		'20240415_1
'============================================================================
Sub Form_OnFormInit()
	g_OStype = Form.GetSharedData("&OS_TYPE", false )	'20240415_1

	cont0.cldToday.todaymode = 1
	g_szTodayYearMon = mid(cont0.cldToday.caption,1,6)
	cont0.calStart.todaymode = 1
	cont0.calStartMon.todaymode = 1
	cont0.calEnd.todaymode = 1
	cont0.calEndMon.todaymode = 1
	
	cont0.FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 5) '활성화/비활성화/여백
	cont0.FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상

	cont0.FormTab0.insertPage( cont0.FormTab0.tabcount, "page1", "page1", "empty", "0", "오늘")
	cont0.FormTab0.insertPage( cont0.FormTab0.tabcount, "page2", "page2", "empty", "0", "1주일")
	cont0.FormTab0.insertPage( cont0.FormTab0.tabcount, "page3", "page3", "empty", "0", "1개월")
	cont0.FormTab0.insertPage( cont0.FormTab0.tabcount, "page3", "page3", "empty", "0", "6개월")
	cont0.FormTab0.insertPage( cont0.FormTab0.tabcount, "page3", "page3", "empty", "0", "기간설정")
	cont0.FormTab0.currenttab = 0
	
	szDateComboSet = Form.GetSharedData("JANGO_DATE_COMBO_SET")
	
	if szDateComboSet == "" or szDateComboSet == null then
		Form.SetSharedData("JANGO_DATE_COMBO_SET","0")
		szDateComboSet = "0"
	end if
	
	cont0.cmbDate.currentindex = szDateComboSet
End Sub

Function RequestData()	
	cont0.Grid0.rowcount = 0
	cont0.SetScrollAutoSize()	'20240416
	
	if CInt(cont0.cmb0.currentindex) == 0 then		'일자별
		cont0.Grid0.SetVisibleCol( 0, "1" )
		cont0.Grid0.SetVisibleCol( 1, "0" )
		DATAMANAGER.RequestTranData( "obtrs_cntg_537r" )
		DATAMANAGER.RequestTranData( "obtrs_cntg_538r" )
	elseif CInt(cont0.cmb0.currentindex) == 1 then	'종목별
		cont0.Grid0.SetVisibleCol( 0, "0" )
		cont0.Grid0.SetVisibleCol( 1, "1" )
		DATAMANAGER.RequestTranData( "obtrs_cntg_540r" )
		DATAMANAGER.RequestTranData( "obtrs_cntg_541r" )
	else									'일별수익률
		szACNO = Form.GetCtlProp("#acnt0", "total")
		szASNO = Form.GetCtlProp("#acnt0", "sequence")
		
		szPeriod  =       cont0.rdoPeriod.currentindex
		szDateGbn = 		cont0.cmbDateGbn.cbkeydata        '012 TR 구분코드에 사용, 일별/월별
		szDateCap = 		cont0.cmbDateGbn.currentindex
		szCalStart = 		cont0.calStart.caption
		szCalEnd = 		cont0.calEnd.caption
		szCalStartMon = 	cont0.calStartMon.caption
		szCalEndMon = 	cont0.calEndMon.caption
		
		Form.triggerEvent("lkf0", "RequestData", szACNO.."★"..szASNO.."★"..szPeriod.."★"..szDateGbn.."★"..szDateCap.."★"..szCalStart.."★"..szCalEnd.."★"..szCalStartMon.."★"..szCalEndMon)
	end if
end Function

