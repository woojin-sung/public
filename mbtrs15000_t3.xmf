'20240415 START : Next조회 안되는 현상 조치
Sub cont0_Grid0_OnScrollEnd()
	'20240415_1 START : iOS OnScrollEnd 안타는 현상 조치
	if g_OStype = "2" then
		cont0.Grid0.height = CInt(cont0.Grid0.rowcount) * 60 + 50 + 5'5=기기별 비율 상이로 인한 여유공간
		cont0.SetScrollAutoSize()
	end if
	' 20240415_1 END

	if CInt(cont0.cmb0.currentindex) == 0 then		'일자별
		szTranID = "obtrs_cntg_538r"
	elseif CInt(cont0.cmb0.currentindex) == 1 then	'종목별
		szTranID =  "obtrs_cntg_540r" 
	end if
	szMore = DATAMANAGER.IsMoreNextData( szTranID )

	if szMore == true then
		DATAMANAGER.RequestNextData( szTranID )
	end if
	
End Sub
