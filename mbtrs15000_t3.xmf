			DATAMANAGER.SetDataValue(0 ,"obtrs_cntg_541r", "InBlock1", "CRDT_EXPN_INCU_YN" , 0 , "Y" )
'		else
'			DATAMANAGER.SetDataValue(0 ,"obtrs_cntg_541r", "InBlock1", "CRDT_EXPN_INCU_YN" , 0 , "N" )
'		end if
