	<SCRIPT_INFO _len="6084" _ulen="5734" >
'============================================================================
' 화 면 명 : 방문판매인력조회_보유자격조회(mbcpp10000_p1.xmf)
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_EMPNO
	
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	imgClose.setMaintainingRatio("1")
	Form.GetSharedData("", false)
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if Form.GetSharedData("&OS_TYPE", false) == "1" then'iOS("2")Android("1")
		Container0.setScrollBarVisible("2")
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	' 부서명^직원명^직원번호
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	
	if szOpenData <> null and szOpenData <> "" then
		szOpenDataArr	= split(szOpenData, "^")

		Container0.lblTitle.caption	= szOpenDataArr[0] & " " & szOpenDataArr[1]
		g_EMPNO 					= szOpenDataArr[2]
	end if
	
	Container0.grd01.rowcount	= 0
	lblNoData.visible			= true
	f_BtnSet(0)
	
	DATAMANAGER.RequestTranData("ooase_acma_029r")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
		
	' ----------------------------------------------------------------------
	' 직원자격증조회
	' ----------------------------------------------------------------------
	if szTranID = "ooase_acma_029r" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "DPCD", 		0, "%")
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "EMPNO", 		0, g_EMPNO)
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "QLCR_CODE", 	0, "%")
	end If

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	' ----------------------------------------------------------------------
	' 직원자격증조회
	' ----------------------------------------------------------------------
	if szTranID == "ooase_acma_029r" then
		Dim nCnt, nRowCnt, nGridCnt
		nCnt		= DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		nRowCnt	= Container0.grd01.rowcount
		
		if nCnt > 0 then
			Dim grdHeight
			
			for i = 0 to nCnt - 1
				Container0.grd01.insertrow = nRowCnt + i

				Container0.grd01.SetCellData("bd_QLCR_NAME", nRowCnt + i, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "QLCR_NAME", i))
			next

			nGridCnt	= CInt(Container0.grd01.rowcount)

			Container0.grd01.height	= 30 * nGridCnt + 5	' 30 : 한 로우 높이 / 5 : 여유값
			Container0.Container1.top 	= 40 + Container0.grd01.height + 30	' 40 : 그리드 top / 30 : 사이 공간

			Container0.SetScrollAutoSize()
			Container0.scroll_pos = 0
			
			lblNoData.visible = false
		else
			lblNoData.visible = true
		end if
		
	end if

	DATAMANAGER.ClearInputData(0, szTranID)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert(szTranID, "[" & szErrCode & "]" & szErrMsg, true)
	
	DATAMANAGER.ClearInputData(0, szTranID)
End Sub

'============================================================================
' 닫기 버튼
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' 확인 버튼
'============================================================================
Sub BtnOk_OnClick()
	Form.CloseForm()
End Sub
		
'============================================================================
' 보유자격증별  판매가능상품(펀드투자권유 자문인력)
'============================================================================
Sub Container0_Container1_Image0_OnClick()
	f_BtnSet(0)
End Sub

'============================================================================
' 보유자격증별  판매가능상품(증권투자권유 자문인력))
'============================================================================
Sub Container0_Container1_Image1_OnClick()
	f_BtnSet(1)
End Sub

'============================================================================
' 보유자격증별  판매가능상품(파생상품투자권유 자문인력)
'============================================================================
Sub Container0_Container1_Image2_OnClick()
	f_BtnSet(2)
End Sub

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' 보유자격증별  판매가능상품(버튼 세팅 함수)
'============================================================================
Function f_BtnSet(idx)
	Dim szImgNm, szLblNm, szTblNm
	
	for i = 0 to 2
		szImgNm = "Container0.Container1.Image" & i
		szLblNm = "Container0.Container1.Label" & i
		szTblNm = "Container0.Container1.Table" & i

		' 비활성화 ---
		Form.SetCtlProp(szImgNm, "imgpath",	"input_01_n.9")
		Form.SetCtlProp(szLblNm, "fgcolor", 	"127")
		Form.SetCtlProp(szTblNm, "visible", 	false)
		
		' 활성화 ---
		if i == idx then			
			Form.SetCtlProp(szImgNm, "imgpath",	"input_01_o.9")
			Form.SetCtlProp(szLblNm, "fgcolor", 	"274")
			Form.SetCtlProp(szTblNm, "visible", 	true)
		end if
		
	next

End Function

