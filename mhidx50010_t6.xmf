'============================================================================
Sub lblMore0_OnClick()									'상승업종
	Form.SetSharedData("mhidx50010_t6", fmtab0.currenttab )
	Form.SetSharedData("HOME_INDUSTRY", "0" )
	
	if CInt(fmtab0.currenttab) = 0 then
		Form.OpenScreen("42000" , "0★KGG01P★0★UP")		'코스피
	elseif CInt(fmtab0.currenttab) = 1 then
		Form.OpenScreen("42000" , "0★QGG01P★1★UP")		'코스닥
	end if
End Sub

'============================================================================
Sub lblMore1_OnClick()									'하락업종
	Form.SetSharedData("mhidx50010_t6", fmtab0.currenttab )
