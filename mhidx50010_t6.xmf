Sub PannelUp0_OnClick(nIndex, sCellID)
	szCode = PannelUp0.GetCellValue("lblCode",nIndex)
	if Trim(szCode) <> "" then
		Form.SetSharedData("mhidx50010_t6", fmtab0.currenttab )
		Form.SetSharedData("HOME_INDUSTRY", "0" )
		
		Form.OpenScreen("42000" , "2★"..szCode.."★0")	'종목구성탭>등락률상위
	end if
End Sub

