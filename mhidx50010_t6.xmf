	if CInt(fmtab0.currenttab) = 0 then
		Form.OpenScreen("42000" , "0★KGG01P★0★DOWN")	'코스피
	elseif CInt(fmtab0.currenttab) = 1 then
		Form.OpenScreen("42000" , "0★QGG01P★1★DOWN")	'코스닥
	end if
End Sub

