'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "RELOAD" then
		nCurrentTab = CInt(fmtab0.currenttab)
		call fmtab0_OnTabChanged(nCurrentTab)
	end if
		
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
End Sub

'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData("ohhts_nmix_cntg")
	DATAMANAGER.CancelRealData("ohhts_whol_mkop")
End Sub

