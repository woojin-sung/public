End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)  'JMY
	If sTimerID == "1" or sTimerID == 1 Then
		Form.ShowAlert("오류", "통신상태가 원활하지 않습니다.\n잠시 후 다시 처리해 주세요.")
		Form.SetTimerEvent("1", 0, 30)
	ElseIf sTimerID == "2" or sTimerID == 2 Then
		Form.SetTimerEvent2("2", 0, 0.8)
		ContMain.Edit0.SetShowKeypad(true)		
	 'v0011 jsi start
	ElseIf sTimerID == "3" or sTimerID == 3 Then
		Form.SetTimerEvent2(sTimerID, 0, DEF_1ST_TIME)
		
		DATAMANAGER.SetDataValue(0, "obtss_idvs_002a", "InBlock1", "RPCS_TMNU"			, 0,  g_BIORetry)
		DATAMANAGER.SetDataValue(0, "obtss_idvs_002a", "InBlock1", "OTSD_TR_UNIQ_NO"	, 0,  sOTSDTRUNIQNO)
		DATAMANAGER.RequestTranData("obtss_idvs_002a")
		
	ElseIf sTimerID == "4" or sTimerID == 4 Then
		Form.SetTimerEvent(sTimerID, 0, DEF_2ST_TIME)
		
		DATAMANAGER.SetDataValue(0, "obtss_idvs_002a", "InBlock1", "RPCS_TMNU"			, 0,  g_BIORetry)
		DATAMANAGER.SetDataValue(0, "obtss_idvs_002a", "InBlock1", "OTSD_TR_UNIQ_NO"	, 0,  sOTSDTRUNIQNO)
		DATAMANAGER.RequestTranData("obtss_idvs_002a")
		
	'v0011 jsi end		
	End If

End Sub

'============================================================================
' 테스트인증Skip
'============================================================================
Sub chkSkip_OnChange(sCheckState)
	If sCheckState == "0" Or sCheckState == 0 Then     	
		BtnNext.enable = False
	Else 
		BtnNext.enable = True
    End If
End Sub 

'============================================================================
Sub ContMain_Button0_OnClick()
	'Call Image1_OnClick()
	Form.OpenNextPopup("mbact73000_s5", "", "" )
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	Call Image1_OnClick()
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "Exit" And sRet == "ok" Then
'		Form.CloseForm()
		Form.OpenNextPopup("mbact73000", "", "")
	End If	
End Sub

