'============================================================================
Sub Form_OnFormClose()

    Form.SetSharedData("BDM_ACNT_OPNG_CLCD" , SelectFlag)
    Form.SendReturnToParent(G_STEP2_3_FILE, SelectFlag)
	
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
    If sKeyName = "ReTryPrcd" Then
        If sRet = "ok" Then  'ok.예 no.아니오
            SelectFlag = sKeyName
            Form.CloseForm()
	    End If
    End If
End Sub
'============================================================================
Sub Form_OnFormBackKeyPressed()  '안드로이드전용
	SelectFlag = ""
	Form.CloseForm()
End Sub
'MY Fin -----------------------------------------------



'단기다수개설계좌여부 조회 JMY ----------------------------------------------
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    '단기다수계좌/대포통장 명의인 조회 --------------------------------------
    If szTranID == "obaci_acct_091r" Then
        '조회전문번호 초기화
        edt091TlmsNo1.caption = ""

        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_PROS_CLS_CODE", 0, "3"            )  '3.단기다수계좌/대포통장 명의인 조회
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE"     , 0, "1"            )  '1.개인
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"          , 0, g_BDM_RCNO_PIP )  '암호화주민번호

    '단기다수계좌/대포통장 명의인 확인 -----------------------------------------
    ElseIf szTranID == "obaci_acct_091r_1" Then
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_PROS_CLS_CODE", 0, "4"                    )  '4.단기다수계좌/대포통장 명의인 확인
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE"     , 0, "1"                    )
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LNKD_TLMS_MNNO"    , 0, edt091TlmsNo1.caption  )
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"          , 0, g_BDM_RCNO_PIP         )  '암호화주민번호
    End IF
End Sub
'============================================================================
Sub Container_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    '오류메시지 설정
    strSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    If Trim(strSubMsg) ~= null And Trim(strSubMsg) ~= "" Then
        strMsg = szErrMsg.."("..Trim(strSubMsg)..")"
    Else
        strMsg = szErrMsg
    End If

    '단기다수계좌/대포통장 명의인 -------------------------------
    If szTranID == "obaci_acct_091r" Or szTranID == "obaci_acct_091r_1" Then
        Form.ShowAlert("오류", strMsg)
    End If
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    '단기다수계좌/대포통장 명의인 조회 -----------------------------------------
    If szTranID == "obaci_acct_091r" Then
        edt091TlmsNo1.caption = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "LNKD_TLMS_MNNO", 0)
        strCode               = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
        'Form.ShowAlert(szTranID, strCode)
        If strCode == "1" Or strCode ==  1 Then  '전문전송완료
            '단기다수계좌/대포통장 명의인 확인 타이머실행
            g_nCnt_091_1 = 0
            Form.SetTimerEvent(3, 1, 1)
        Else
            Form.ShowAlert("오류", "계좌개설 진행이 불가합니다.(단기다수개설자 조회 오류)")    
            Exit Sub
        End If

    '단기다수계좌/대포통장 명의인 확인 -----------------------------------------
    ElseIf szTranID == "obaci_acct_091r_1" Then
        strCode = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PROS_CLS_CODE", 0)
        'Form.ShowAlert(szTranID, strCode)
        If strCode == "2" Or strCode == 2 Then  '조회완료
            '대포통장명의인여부
            'g_BNK_NMPR_YN_YN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "UI_BNKB_NMPR_YN", 0)
            '단기다수계좌개설여부
            g_BNK_MNY_OPNG_YN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "UI_MNY_ACNT_OPNG_CHD_YN", 0)

            'v0002 
		   Form.SetSharedData("BDM_BNK_MNY_OPNG_YN" , g_BNK_MNY_OPNG_YN )	'단기다수개설여부	
		   
		   'v0002 User_Able_Chk() 종합개설의 경우에만
		   If SelectFlag == 1 Then
			   User_Able_Chk()
		   Else
			   Form.CloseForm() 
		   End If			
        Else
            '단기다수계좌/대포통장 명의인 확인 타이머실행
            Form.SetTimerEvent(3, 1, 1)
        End If
	End If
End Sub
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
    '단기다수계좌여부/대포통장명의인여부 확인 -------------------------------------------------------
    If sTimerID == 3 Or sTimerID == "3" Then
        '정보송신 타이머종료
        Form.SetTimerEvent(3, 0, 1)

        '송신유효횟수 설정
        g_nCnt_091_1 = CInt(g_nCnt_091_1) + 1

        '송신유효횟수 초과 체크
        If CInt(g_nCnt_091_1) > 7 Then
            Form.ShowAlert("오류", "은행연합회와 통신상태가 원활하지 않습니다. 잠시 후 다시 시도해 주십시오.")
            Exit Sub
        End If

        '단기다수계좌여부/대포통장명의인여부 확인
        DATAMANAGER.RequestTranData "obaci_acct_091r_1"
    End If
End Sub

'============================================================================
Sub Container_ImgChkA1_OnClick()
    Container_ImgA1_OnClick()	
End Sub

'============================================================================
Sub Container_ImgChkA2_OnClick()
    Container_ImgA2_OnClick()
End Sub

