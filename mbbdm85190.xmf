'============================================================================
Function User_Able_Chk()
    '단기다수개설자 종합
    If g_BNK_MNY_OPNG_YN == "Y" Then
        Form.ShowAlert("안내", "단기다수개설자로써 종합개설이 불가합니다.\n기존 종합계좌이용 추가계좌 개설만 가능합니다.")
        Exit Function

    '최근 30일내 종합계좌 신규개설건 존재시, 종합개설 불가
    ElseIf g_BDM_OVRL_ACNT_OPNG_YN == "Y" Then
        '단기다수체크에 맞춰 20일영업일로 변경(By박정숙Cha)
        'Form.ShowAlert("안내", "최근 30일간 종합계좌 신규개설을 하신 경우에는 기존 종합계좌이용 추가계좌 개설만 가능합니다.")
	   Form.ShowAlert("안내", "최근 20영업일간 종합계좌 신규개설을 하신 경우에는 기존 종합계좌이용 추가계좌 개설만 가능합니다.")
        Exit Function
    End If
    
    'v0001 ISA 상품포함 종합개설시, 종합매매(ISA고유의 현물&현금해지&입금용) 필수선택 체크
    If g_BDM_PRCD133 == "Y" and g_BDM_ISA_PROD_TYPE == "2" Then 
        If g_BDM_PRCD100 <> "Y" and g_BDM_PRCD118RP <> "Y" Then	'v0002 CMA계좌 보유시에도 개설 가능하도록 변경
            Form.MsgBox("안내", "일임형ISA 개설시 현물, 현금해지, 입금을 위한 별도 계좌 (종합매매 또는 CMA)를 개설해야 합니다.\n\n개설상품 선택화면으로 이동하시겠습니까?", "ReTryPrcd", 2)
            Exit Function
        End If    
    End If
    'MY Fin ----------------------------------------------------- 

    'MY Sta -----------------------------------------------------
	Form.CloseForm()	
    'MY Fin -----------------------------------------------------

End Function



'============================================================================
Sub Form_OnFormInit()
    'MY Sta ---------------------------------
    G_STEP2_3_FILE          = "mbbdm85190"  '개설방식선택
    g_BDM_REG_UNIQ_NO       = Form.GetSharedData("BDM_REG_UNIQ_NO"       , false)  '등록고유번호
    g_BDM_RCNO_PIP          = Form.GetSharedData("BDM_RCNO_PIP"          , false)  '주민등록번호
    g_BDM_USERID            = Form.GetSharedData("BDM_USERID"            , false)  'USERID
    g_BDM_NAME              = Form.GetSharedData("BDM_NAME"              , false)  '성명
    g_BDM_OVRL_ACNT_OPNG_YN = Form.GetSharedData("BDM_OVRL_ACNT_OPNG_YN" , false)  '종합개설가능여부(최근30일내종합신규개설여부)
    g_BDM_PRCD100           = Form.GetSharedData("BDM_PRCD100"           , false)  '종합매매 가입여부
    g_BDM_PRCD118RP         = Form.GetSharedData("BDM_PRCD118RP"         , false)  'CMA(증권형) 가입여부
    g_BDM_PRCD100F          = Form.GetSharedData("BDM_PRCD100F"          , false)  '종합매매(금상전용) 가입여부
    g_BDM_PRCD101           = Form.GetSharedData("BDM_PRCD101"           , false)  '선물옵션 가입여부
    g_BDM_PRCD135           = Form.GetSharedData("BDM_PRCD135"           , false)  '해외파생 가입여부
    g_BDM_PRCD133           = Form.GetSharedData("BDM_PRCD133"           , false)  'ISA 가입여부
    g_BDM_PRCDCFD           = Form.GetSharedData("BDM_PRCDCFD"           , false)  'CFD 가입여부
    'v0001
    g_BDM_PRCD137			= Form.GetSharedData("BDM_PRCD137"			, false)	'해외CFD 가입여부
    g_BDM_ISA_PROD_TYPE	= Form.GetSharedData("BDM_ISA_PROD_TYPE"		, false)	'ISA type
    'MY Fin ---------------------------------

    ImgBg.imgpath = "alpha128.png"
    PressedImgPath = "input_03_o.9.png"
    unPressedImgPath = "input_03_n.9.png"

    CheckImgPath = "check_circle_on.png"
    unCheckImgPath = "check_circle_off.png"
    
    SelectFlag = 0
    
    Container.ImgA1.imgpath = unPressedImgPath
    Container.ImgChkA1.imgpath = unCheckImgPath
    
    Container.ImgA2.imgpath = unPressedImgPath
    Container.ImgChkA2.imgpath = unCheckImgPath	

End Sub

