    SelectFlag = 2
    
    Container.ImgA1.imgpath = PressedImgPath
    Container.ImgChkA1.imgpath = CheckImgPath
    
    Container.ImgA2.imgpath = unPressedImgPath
    Container.ImgChkA2.imgpath = unCheckImgPath    

    '단기다수개설계좌고객여부 체크	v0002
    DATAMANAGER.RequestTranData( "obaci_acct_091r" )
'    'MY Sta -----------------------------------------------------
'	Form.CloseForm()	
'    'MY Fin -----------------------------------------------------
End Sub

