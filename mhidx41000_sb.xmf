			szFluctBit	=	DATAMANAGER.GetDataValue(1, 	"ohhts_futs_cntg", "OutBlock1", "FIDR_PRDY_VRSS_SIGN"	, 0)
			szFluctAmt	=	DATAMANAGER.GetDataValue(1, "ohhts_futs_cntg", "OutBlock1", "FIDR_PRDY_VRSS2"	, 0)
			szFluctRatio	=	DATAMANAGER.GetDataValue(1, "ohhts_futs_cntg", "OutBlock1", "FIDR_PRDY_CTRT", 0)
