'2016.07 지수Table 클릭시 지수현재가 링크  --> 차트/일자별 팝업 

'============================================================================
Sub tbl01_OnClick(lRow , lColumn)
	Link_jisu(0)
End Sub

'============================================================================
Sub tbl02_OnClick(lRow , lColumn)
	Link_jisu(1)
End Sub

'============================================================================
Sub tbl03_OnClick(lRow , lColumn)
	Link_jisu(2)
End Sub

'============================================================================
Sub tbl04_OnClick(lRow , lColumn)
	Link_jisu(3)
End Sub

'============================================================================
Sub tbl05_OnClick(lRow , lColumn)
	Link_jisu(4)
End Sub

'============================================================================
Sub tbl06_OnClick(lRow , lColumn)
	Link_jisu(5)
End Sub

function Link_jisu(nIdx)
'	mgidx42000	' 업종현재가		'	mgidx41020	' 예상지수
'	mgidx42040	' 해외지수
'    mhprc31000	' 선물현재가

'	nCodes = g_szRCodes(nIdx)
' 업종현재가 / 파생현재가 / 해외지수 ... 현재가 링크	
'	if		trim(nCodes) = "0001" or trim(nCodes) = "1001" or trim(nCodes) = "2029"	then
'		Form.OpenScreen("42000", "0★" & nCodes)		' strMapName = "mgidx42000"
'	elseif 	trim(nCodes) = g_szFutCode	then
'		Form.OpenScreen("31000", nCodes)			' strMapName = "mgidx31000"		
'	elseif	trim(nCodes)	= "DJI@DJI" or trim(nCodes)	= "NAS@IXIC" or trim(nCodes) = "SPI@SPX" or
'			trim(nCodes)	= "SHS@000001" or trim(nCodes) = "HSI@HSCE" or trim(nCodes)	= "NII@NI225" then
'		Form.OpenScreen("42040", "0★" & nCodes)		' strMapName = "mgidx42040"
'	end if		
'--------------------------------------------------------------------------------------------------------------		
		dim szSymbol
		dim szMarket
		dim szName
	
		szSymbol = g_szRCodes ( nIdx )		'	nCodes		
		szMarket = g_szRMarkets( nIdx )		'	szMarket = g_szMarkets( nIdx )
		szName 	= g_szRNames ( nIdx )		'	szName 	= g_szNames ( nIdx )
	
'		msgbox "nIdx:[" & nIdx & "].. szSymbol:[" & szSymbol & "], szMarket[" & szMarket & "], szName[" & szName & "]"
		
		Form.OpenFramePopup("mhidx42040_p1" , szSymbol & "★" &  szMarket & "★" & szName , sPosInfo)
end Function
