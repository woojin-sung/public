'============================================================================
' 01.화면명 	: 시장종합
' 02.화면설명	: 시장종합_지수타일
' 03.작성	: 2016.01.07
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szValues 		'설정한값 리스트				'총 15개
dim  g_szFileName		'파일명
dim  g_szMarkets		'설정값에 따른 시장명들
dim  g_szCodes		'설정값에 따른 input code
dim  g_szFutCode		'근월물
dim	g_szNames		'종목명들
dim	g_szRMarkets		'실시간등록된시장들	for 테이블들의 값을 분기해주기 위함
dim	g_szRCodes		'실시간등록된코드들	for 테이블들의 값을 분기해주기 위함
dim	g_szRNames		'실시간등록된Name들	for 테이블들의 값을 분기해주기 위함
dim	g_szKeyNames		'Config Key값

g_szMarkets		=	Array("U","U","U","F","N"
					,"N","N","N","N","N","N","N")	'20180130 HAMWG : 상해A, 심청A 지수추가
					'"EN","EN","EN","FN","FN")
g_szNames		=	Array("KOSPI", "KOSDAQ", "KOSPI200", "선물", "다우산업",
					 "나스닥종합", "S&P500", "상해종합", "상해A", "심천A", "홍콩H", "니케이225") '20180130 HAMWG : 상해A, 심청A 지수추가
					 '"원/달러", "원/위안", "원/엔", "금 선물", "WTI")

g_szKeyNames		=	Array("41000_KOSPI", "41000_KOSDAQ", "41000_KOSPI200", "41000_FUTURE",
						  "41000_DOW", "41000_NASDAQ", "41000_SP500", "41000_SHANGHAI",
						  "41000_SHANGHAIA", "41000_SHENZHENA", "41000_HONGKONG", "41000_NIKKEI") '20180130 HAMWG : 상해A, 심청A 지수추가
						  
g_szRCodes		=	Array()
g_szRMarkets		=	Array()
g_szRNames		=	Array()
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Function SettingFlag(nCodes, nIdx)
	dim	szimgName
	dim	szCtrlName
	
	szimgName	=""
	szCtrlName	=""
	'g_szCodes		=	Array("0001","1001","2029", g_szFutCode,"DJI@DJI","NAS@IXIC","SPI@SPX ","SHS@000001",
	'					"HSI@HSCE","NII@NI225", "USDKRWSMBS", "CNYKRWCOMP","JPYKRWCOMP","COM@GC","SPT@CL")
	
	'Form.ShowAlert(i, g_szCodes(i))
	if	trim(nCodes)	=	"0001"	or	trim(nCodes)	=	"1001"	or
		trim(nCodes)	=	"2029"	or	trim(nCodes)	=	g_szFutCode	then
		szimgName	=	"flag_ko"
	elseif	trim(nCodes)	=	"DJI@DJI"	or	trim(nCodes)	=	"NAS@IXIC"	or
			trim(nCodes)	=	"SPI@SPX"							then
		szimgName	=	"flag_us"
	elseif	trim(nCodes)	=	"SHS@000001"	or	trim(nCodes)	=	"HSI@HSCE"	or
			trim(nCodes)	=	"SHS@000002"	or	trim(nCodes)	=	"SZS@399107"	then	'20180130 HAMWG : 상해A, 심청A 지수추가
		szimgName	=	"flag_ch"
	elseif	trim(nCodes)	=   "NII@NI225"							then
		szimgName	=	"flag_jp"
	else
		szimgName	=	""
	end	if
		
	szCtrlName	=	"Imageflag0" & Cstr(nIdx+1)
		
	Form.SetCtlProp(szCtrlName, "imgpath", szimgName)
		
	
end	Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	g_szFileName = "41000ITEMS.ini"

	g_szValues = Array()
	
	for i = 0 	to	UBound(g_szKeyNames)
		g_szValues(i)		= Form.LoadConfigData(g_szFileName, g_szKeyNames(i))
	next
'	g_szValues(szidx) 	= Form.LoadConfigData(g_szFileName, "41000_KOSPI"		)
'	g_szValues(szidx) 	= Form.LoadConfigData(g_szFileName, "41000_KOSDAQ"	)
'	g_szValues(szidx) 	= Form.LoadConfigData(g_szFileName, "41000_KOSPI200"	)
'	g_szValues(szidx)		= Form.LoadConfigData(g_szFileName, "41000_FUTURE"	)
'	g_szValues(szidx)		= Form.LoadConfigData(g_szFileName, "41000_DOW"		)
'	g_szValues(szidx)		= Form.LoadConfigData(g_szFileName, "41000_NASDAQ"	)
'	g_szValues(szidx)		= Form.LoadConfigData(g_szFileName, "41000_SP500"		)
'	g_szValues(szidx)		= Form.LoadConfigData(g_szFileName, "41000_SHANGHAI"	)
'	g_szValues(szidx)		= Form.LoadConfigData(g_szFileName, "41000_HONGKONG"	)
'	g_szValues(szidx)		= Form.LoadConfigData(g_szFileName, "41000_NIKKEI"	)
	
'	g_szValues(10)  = Form.LoadConfigData(g_szFileName, "41000_WONDOLLAR"	)
'	g_szValues(11)	= Form.LoadConfigData(g_szFileName, "41000_WONWIAN"	)
'	g_szValues(12)	= Form.LoadConfigData(g_szFileName, "41000_WONYEN"	)
'	g_szValues(13)  = Form.LoadConfigData(g_szFileName, "41000_GOLDFUTURE"	)
'	g_szValues(14)	= Form.LoadConfigData(g_szFileName, "41000_WTI"		)
	
	DATAMANAGER.RequestTranData("ohhts_0510_001r")
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim nIdx	'데이터위치값
	dim szTblname
	
	nIdx	=	0
	
	if szTranID = "ohhts_1500_001r" then
		
			
			For i=0 To UBound(g_szValues)
				  if	g_szValues(i)	=	"1"	then
					   DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", nIdx, g_szMarkets(i))
					   DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_ISCD",nIdx, g_szCodes(i))
					   
					   if  nIdx	=	0	then
						   tbl01.SetCellString(1, 0, g_szNames(i))
					   elseif nIdx	=	1	then
						   tbl02.SetCellString(1, 0, g_szNames(i))
					   elseif nIdx	=	2	then
					   	   tbl03.SetCellString(1, 0, g_szNames(i))
					   elseif nIdx	=	3	then
					   	   tbl04.SetCellString(1, 0, g_szNames(i))
					   elseif nIdx	=	4	then
  						   tbl05.SetCellString(1, 0, g_szNames(i))
					   else
						   tbl06.SetCellString(1, 0, g_szNames(i))
					   end if 
					   
					   SettingFlag(g_szCodes(i), nIdx)
					   
					   g_szRCodes(nIdx) 	= g_szCodes(i)			'실시간위해서 각 테이블 코드값 저장
					   g_szRMarkets(nIdx) 	= g_szMarkets(i)			'실시간위해서 각 테이블 코드값 저장
					   g_szRNames(nIdx) 	= g_szNames(i)			'실시간위해서 각 테이블 코드값 저장
					   nIdx = nIdx + 1
				  end if
			Next
	end if 
	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim nDomIdx	'국내지수
	dim nOvrIdx	'해외주요지수
	dim nNfutIdx	'해외선물
	dim nExrtIdx	'환율
	dim nFutIdx	'국내선물
	
	dim bIsDom		'국내시장실시간있는지.
	dim bIsOvrs	'해외주요지수있는지.
	dim bIsNFut	'해외선물있는지
	dim bIsExrt	'환율있는지
	dim bIsFut		'선물
	
	
	DATAMANAGER.CancelRealData("ohhts_nmix_cntg")
	DATAMANAGER.CancelRealData("ohhts_ovrs_nmix")
	DATAMANAGER.CancelRealData("ohhts_nfut_cntg")
	DATAMANAGER.CancelRealData("ohhts_exrt_cntg")
	DATAMANAGER.CancelRealData("ohhts_futs_cntg")
	
	if	szTranID	=	"ohhts_0510_001r"	then
		g_szFutCode = TRIM(DATAMANAGER.GetDataValue(0, "ohhts_0510_001r", "OutBlock1", "FID_SHRN_ISCD", 0))
		
		if g_szFutCode	<>	""	then
			g_szCodes		=	Array(	"0001", "1001", "2029", g_szFutCode ,"DJI@DJI",
									"NAS@IXIC", "SPI@SPX", "SHS@000001", "SHS@000002", "SZS@399107", "HSI@HSCE", "NII@NI225", 
									"USDKRWSMBS", "CNYKRWCOMP","JPYKRWCOMP","COM@GC","SPT@CL")	'20180130 HAMWG : 상해A, 심청A 지수추가
							
			DATAMANAGER.RequestTranData("ohhts_1500_001r")
		end if
	end if 
	
	
	nDomIdx	=	0
	nOvrIdx	= 	0
	nNfutIdx	=	0
	nExrtIdx	=	0
	nFutIdx	=	0

	bIsDom  	= false
	bIsOvrs	= false
	bIsNFut	= false
	bIsExrt	= false
	bIsFut	= false
	
	if szTranID = "ohhts_1500_001r" then
		
			'1. 	시장체크해서 INPUT 세팅
			For i=0 To UBound(g_szRMarkets)
			
				  if	g_szRMarkets(i)	=	"U"	then		'국내지수일때
					DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", nDomIdx, g_szRCodes(i))
					bIsDom  =	true
					nDomIdx 	= 	nDomIdx 	+	1	
				  elseif 		g_szRMarkets(i)	=	"N"	then		'해외주요지수일때
					DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", nOvrIdx, g_szRCodes(i))
					bIsOvrs	=	true
					nOvrIdx	=	nOvrIdx	+	1	
				  elseif 		g_szRMarkets(i)	=	"FN"	then		'해외선물일때
					DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg", "InBlock1", "FIDR_SHRN_ISCD", nNfutIdx, g_szRCodes(i))
					bIsNFut	=	true
					nNfutIdx	=	nNfutIdx	+	1	
				  elseif 		g_szRMarkets(i)	=	"EN"	then		'환율일때				  
					DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", nExrtIdx, g_szRCodes(i))
					bIsExrt	=	true
					nExrtIdx	=	nExrtIdx	+	1
				  else									'선물일때
					DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", nFutIdx, g_szRCodes(i))
					bIsFut	=	true
					nFutIdx	=	nFutIdx	+	1
				  end if
				
			Next
				

			'2.	실시간요청
			if	bIsDom =		true		then		'국내지수일때
				DATAMANAGER.RequestRealData("ohhts_nmix_cntg")
			end if
			
			if	bIsOvrs	=	true		then		'해외주요지수일때
				DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")
			end if
			
			if	bIsNFut	=	true		then		'해외선물일때
				DATAMANAGER.RequestRealData("ohhts_nfut_cntg")
			end if
				
			if	bIsExrt	=	true		then		'환율일때
				DATAMANAGER.RequestRealData("ohhts_exrt_cntg")
			end if
			
			if	bIsFut	=	true		then		'선물일때
				DATAMANAGER.RequestRealData("ohhts_futs_cntg")
			end if
			
			
	end if 

End Sub



'============================================================================
'DATAMANAGER_OnReceiveRealComplete
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	dim	szPrpr, szFluctBit, szFluctAmt, szFluctRatio, szVol
	dim	szCode
	
	if	szTranID	=	"ohhts_nmix_cntg"	then		'국내지수내려올때
	
			szCode = DATAMANAGER.GetDataValue(1, "ohhts_nmix_cntg", "OutBlock1", "FIDR_BSTP_CLS_CODE", 0)
				
			szPrpr 	= DATAMANAGER.GetDataValue(1, "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRPR2", 0)
			szFluctBit	=	DATAMANAGER.GetDataValue(1, "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRDY_VRSS_SIGN", 0)
			szFluctAmt	=	DATAMANAGER.GetDataValue(1, "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRDY_VRSS2", 0)
			szFluctRatio	=	DATAMANAGER.GetDataValue(1, "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRDY_CTRT", 0)
			szVol	=	DATAMANAGER.GetDataValue(1, "ohhts_nmix_cntg", "OutBlock1", "FIDR_ACML_VOL", 0)
			
			
			Select Case szFluctBit
				Case "2" '상승
					szPrColor = "1"
				Case "3" '보합 
					szPrColor = "3"
				Case "5" '하락'
					szPrColor = "2"
			End Select 
						
					
	
			For	i=0	to	UBound(g_szRCodes)				'코드들을 검색해서
				
				if	szCode	=	g_szRCodes(i)	then		'내려온 실시간 Code와 요청한 코드값이 맞으면
													'각 값에 따라서 테이블 세팅
					if	i	=	0 	then
						tbl01.SetCellString(2, 0, szPrpr)
						tbl01.SetCellFgColor(2, 0, szPrColor)
						
						tbl01.SetCellString(3, 0, szFluctBit)
						tbl01.SetCellString(3, 1, szFluctAmt)
						tbl01.SetCellString(3, 3, szFluctRatio)
						'tbl01.SetCellString(4, 2, szVol)
					elseif	i	=	1 	then 
						
						tbl02.SetCellString(2, 0, szPrpr)
						tbl02.SetCellFgColor(2, 0, szPrColor)
						
						tbl02.SetCellString(3, 0, szFluctBit)
						tbl02.SetCellString(3, 1, szFluctAmt)
						tbl02.SetCellString(3, 3, szFluctRatio)
						'tbl02.SetCellString(4, 2, szVol)
					elseif	i	=	2	then
						
						tbl03.SetCellString(2, 0, szPrpr)
						tbl03.SetCellFgColor(2, 0, szPrColor)
						
						tbl03.SetCellString(3, 0, szFluctBit)
						tbl03.SetCellString(3, 1, szFluctAmt)
						tbl03.SetCellString(3, 3, szFluctRatio)
						'tbl03.SetCellString(4, 2, szVol)
					elseif	i	=	3	then
						
						tbl04.SetCellString(2, 0, szPrpr)
						tbl04.SetCellFgColor(2, 0, szPrColor)
						
						tbl04.SetCellString(3, 0, szFluctBit)
						tbl04.SetCellString(3, 1, szFluctAmt)
						tbl04.SetCellString(3, 3, szFluctRatio)
						'tbl04.SetCellString(4, 2, szVol)
					elseif	i	=	4	then
						
						tbl05.SetCellString(2, 0, szPrpr)
						tbl05.SetCellFgColor(2, 0, szPrColor)
						
						tbl05.SetCellString(3, 0, szFluctBit)
						tbl05.SetCellString(3, 1, szFluctAmt)
						tbl05.SetCellString(3, 3, szFluctRatio)
						'tbl05.SetCellString(4, 2, szVol)
					elseif	i	=	5	then
						
						tbl06.SetCellString(2, 0, szPrpr)
						tbl06.SetCellFgColor(2, 0, szPrColor)
						
						tbl06.SetCellString(3, 0, szFluctBit)
						tbl06.SetCellString(3, 1, szFluctAmt)
						tbl06.SetCellString(3, 3, szFluctRatio)
						
					end if
				end if
			next
			
	elseif	szTranID	=	"ohhts_ovrs_nmix"	then		'해외지수내려올때
	
			szCode	= DATAMANAGER.GetDataValue(1, "ohhts_ovrs_nmix", "OutBlock1", "FIDR_SYMB", 0)
			
