'===============================================
' Form_OnTriggerEvent
'===============================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "REFRESH_INTR_ITEM" then
		nRowCnt = Cint(contMain.Pannel0.rowcount)
		
		for i = 0 to nRowCnt-1
			szItemCd = contMain.Pannel0.getPropCardCell("caption","lblHideData0",i)
			
			isIntrItem = Form.isIntrItemList(szItemCd)
			
			contMain.Pannel0.setPropCardCell("maintainratio", "imgIntr", i, "3")
			if szIntrYN = true then
				contMain.Pannel0.setPropCardCell("imgpath","imgIntr", i, g_szIntrImg_Select)
			else
				contMain.Pannel0.setPropCardCell("imgpath","imgIntr", i, g_szIntrImg_Normal)
			end if
		next
	end if
End Sub

'===============================================
' Form_OnPopupReturn
'===============================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "50500_P1_RETURN_DATA_SCREENER" then
		Form.SetSharedData(g_szSharedKey_Filter , sRet)
		ProcFilterData(sRet)
		
		RequestTranData_REITs(g_szCategoryCd, g_szNationCd_1, g_szNationCd_2, g_szNationCd_3, g_szNationCd_4, g_szNationCd_5, g_szSearchItemCd, "N", "Y", g_szSortCd)
	
	elseif sKeyName = "mhprc11000_save" then
		arrRet = split(sRet, "★")
		
		if arrRet(2) = "DEL" then
			Form.delIntrItemList(g_szIntrItemCd)
			contMain.Pannel0.setPropCardCell("imgpath","imgIntr", g_szIntrIdx, g_szIntrImg_Normal)
		else
			Form.addIntrItemList(g_szIntrItemCd)
			RequestTranData_Intr()
			
			contMain.Pannel0.setPropCardCell("imgpath","imgIntr", g_szIntrIdx, g_szIntrImg_Select)
		end if
		
	elseif sKeyName = "DLG_SELECT" then
		lblSearch.fgcolor = g_szTxtColor_Normal

		g_szSearchItem = sRet
		arrTemp1 = split(sRet, "★")
		
		if #arrTemp1 > 1 then
			lblSearch.fgcolor = g_szTxtColor_Normal
			lblSearch.caption = arrTemp1(1)
			imgRemove.visible = true
			szItemCd = ""
			if instr(arrTemp1(0), "@") > 0 then
				arrTemp2 = split(arrTemp1(0), "@")
				
				szItemCd = arrTemp2(1).."."..arrTemp2(0)
			else
				szItemCd = "A"..arrTemp1(0)
			end if
		
			g_szSearchItemCd = szItemCd
			RequestTranData_REITs(g_szCategoryCd, g_szNationCd_1, g_szNationCd_2, g_szNationCd_3, g_szNationCd_4, g_szNationCd_5, g_szSearchItemCd, "N", "Y", g_szSortCd)
		end if
	end if
End Sub

'===============================================
' Form_OnTriggerEventSCREEN
'===============================================
Sub Form_OnTriggerEventSCREEN(sEventName,sParam)
	if g_isOpen = true then
		g_isOpen = false
		szPos = Form.GetSharedData("50800_INDEX", true)	
		
		if sEventName = "PREV" and szPos = "1" then
			g_isPrev = true
			szData = Form.GetSharedData(g_szSharedKey_Item, true)
			g_szSearchItem = szData
			arrTemp1 = split(szData, "★")
			
			if #arrTemp1 > 1 then
				lblSearch.fgcolor = g_szTxtColor_Normal
				lblSearch.caption = arrTemp1(1)
				imgRemove.visible = true
				szItemCd = ""
				if instr(arrTemp1(0), "@") > 0 then
					arrTemp2 = split(arrTemp1(0), "@")
					
					szItemCd = arrTemp2(1).."."..arrTemp2(0)
				else
					szItemCd = "A"..arrTemp1(0)
				end if
			
				g_szSearchItemCd = szItemCd
			end if
			
			szData = Form.GetSharedData(g_szSharedKey_Filter, true)
			
			ProcFilterData(szData)
			
			szData = Form.GetSharedData(g_szSharedKey_Category, true)
	
			arrData = split(szData, "`")
			
			if #arrData > 1 then
				g_szCategoryCd = "%"
				
				DisplaySetting_PannelBtn(cint(arrData(0)), arrData(1))
			end if
			
			RequestTranData_REITs(g_szCategoryCd, g_szNationCd_1, g_szNationCd_2, g_szNationCd_3, g_szNationCd_4, g_szNationCd_5, g_szSearchItemCd, "N", "Y", g_szSortCd)
		else
			g_isPrev = false
			'리츠카테고리 / 국가코드 / 종목코드 / 신규상장 여부(YN) / 상장폐지 제외 여부(YN)  / 정렬기준 
			RequestTranData_REITs(g_szCategoryCd, g_szNationCd_1, g_szNationCd_2, g_szNationCd_3, g_szNationCd_4, g_szNationCd_5, g_szSearchItemCd, "N", "Y", g_szSortCd)
		end if
	end if
End Sub

