' contMain_OnAnimationStart
'===============================================
Sub contMain_OnAnimationStart(sParam, sParam2)
	if sParam = "Up" then
		contMain.height = 347 + 308
		contMain.Pannel0.height = 304 + 308
	end if
End Sub

'===============================================
' contMain_OnAnimationComplete
'===============================================
Sub contMain_OnAnimationComplete(sParam, sParam2)
	if sParam = "Down" then
		contMain.height = 347 
		contMain.Pannel0.height = 304
		g_isExpand = false
	elseif sParam = "Up" then
		g_isExpand = true
	end if
End Sub

