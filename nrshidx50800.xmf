'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************
'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	'-----------------------------------------------
	' 타이틀 뒤로가기 버튼 초기화 
	'-----------------------------------------------
	imgBack.SetMaintainingRatio("2")
	imgBack.imgpath = g_szBackImg
	
	'-----------------------------------------------
	' 타이틀명 초기화
	'-----------------------------------------------
	lblTitle.caption = g_szTitle
	lblTitle.paddinginfo = "0,0,0,0"
	
	'-----------------------------------------------
	' 유의사항 버튼 초기화
	'-----------------------------------------------
	imgInfo.SetMaintainingRatio("3")
	imgInfo.imgpath = g_szInfoImg
	
	'-----------------------------------------------
	' 상단영역 컨트롤 초기화
	'-----------------------------------------------
	lblSubTitle.paddinginfo 	= "0,0,0,0"
	
	lblBg.bgcolor 			= g_szContBgColor
	lblBgDiv.bgcolor 			= g_szContBgColor
	
	lblSearch.imagefilepth 	= g_szBtnImg_Normal
	lblSearch.fgcolor 		= g_szTxtColor_Grey
	lblSearch.maxlinecnt 		= "1"
	
	lblSearch.paddinginfo = "40,0,40,0"
	lblSearch.caption = "종목명/종목코드/티커명을 입력해주세요"
	
	imgSearch.setMaintainingRatio("2")
	imgSearch.imgpath = g_szSearchImg
	
	imgRemove.setMaintainingRatio("3")
	imgRemove.imgpath = g_szRemoveImg
	imgRemove.visible = false
	
	lblGuide.paddinginfo = "0,0,0,0"
	lblGuide.caption = "* 기타:특수형/데이터센터/셀프스토리지 리츠"
	
	'-----------------------------------------------
	' 하단영역(종목검색) 컨트롤 초기화
	'-----------------------------------------------
	contMain.gesture = true
	contMain.bgcolor = g_szTxtColor_White
	
	contMain.Pannel0.setDataNormal("1")
	
	contMain.lblItemCnt.paddinginfo = "0,0,0,0"
	contMain.lblItemCnt.fgcolor = g_szTxtColor_Grey
	
	contMain.imgFilter.setMaintainingRatio("3")
	contMain.imgFilter.imgpath = g_szFilterImg
	
	contMain.lblFilter.paddinginfo = "0,0,0,0"
	contMain.lblFilter.fgcolor = g_szTxtColor_Normal
	contMain.lblFilter.maxlinecnt = "2^-8"
	contMain.lblFilter.caption = "필터"
	
	contMain.lblLine0.bgcolor = g_szLineColor
	
	contMain.lblEmpty.paddinginfo = "0,0,0,0"
	contMain.lblEmpty.fgcolor = g_szTxtColor_Grey
	contMain.lblEmpty.top = 200
	contMain.lblEmpty.visible = false
	
	contMain.imgEmpty.maintainratio = "1"
	contMain.imgEmpty.imgpath = g_szEmptyImg
	contMain.imgEmpty.top = 150
	contMain.imgEmpty.visible = false
End Function

'===============================================
' 카테고리 패널 초기화
'===============================================
Function Init_Category()
	nArrCnt = #g_arrCategory
	
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 

	Pannel0.rowcount = nPannelRowCnt
	
	nArrIdx = 0
	
	for i = 0 to nPannelRowCnt - 1
		
		Pannel0.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Normal)	
		
		Pannel0.SetCellValue( "lbl0", i, g_arrCategory(nArrIdx))
		Pannel0.SetPropCardCell("caption", "lbl0", i,  g_arrCategory(nArrIdx))	
		
		Init_PannelImg(i, "imgFlag0", "lbl0", g_arrCategory(nArrIdx))
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			Pannel0.SetCellVisible("lbl1",i,false)
			Pannel0.SetCellVisible("lbl2",i,false)
			Exit for
		end if
		
		
		Pannel0.SetPropCardCell("imagefilepth", "lbl1", i, g_szBtnImg_Normal)	
		Pannel0.SetCellValue( "lbl1", i, g_arrCategory(nArrIdx))
		Pannel0.SetPropCardCell("caption", "lbl1", i,  g_arrCategory(nArrIdx))	
		
		Init_PannelImg(i, "imgFlag1", "lbl1", g_arrCategory(nArrIdx))
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Pannel0.SetCellVisible("lbl2",i,false)
			Exit for
		end if
		
		
		Pannel0.SetPropCardCell("imagefilepth", "lbl2", i, g_szBtnImg_Normal)	
		Pannel0.SetCellValue( "lbl2", i, g_arrCategory(nArrIdx))
		Pannel0.SetPropCardCell("caption", "lbl2", i,  g_arrCategory(nArrIdx))	
		
		Init_PannelImg(i, "imgFlag2", "lbl2", g_arrCategory(nArrIdx))
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
End Function

'===============================================
' 카테고리별 이미지 적용
'===============================================
Function Init_PannelImg(nRowIdx, szCtlName, szBgCtlName, szData)
	Pannel0.SetPropCardCell("maintainratio", szCtlName, nRowIdx, "4")
	Pannel0.SetPropCardCell("maxlinecnt", szBgCtlName, nRowIdx, "1")

	if szData = "주거용" then
		Pannel0.SetPropCardCell("halign", szBgCtlName, nRowIdx, "0")
		Pannel0.SetPropCardCell("paddinginfo", szBgCtlName, nRowIdx, "40,0,0,0")
		Pannel0.SetPropCardCell("visible", szCtlName, nRowIdx, true)
		Pannel0.SetPropCardCell("imgpath", szCtlName, nRowIdx, "reits_lineup_icon01")
		
	elseif szData = "숙박/리조트" then
		Pannel0.SetPropCardCell("halign", szBgCtlName, nRowIdx, "0")
		Pannel0.SetPropCardCell("paddinginfo", szBgCtlName, nRowIdx, "40,0,0,0")
		Pannel0.SetPropCardCell("visible", szCtlName, nRowIdx, true)
		Pannel0.SetPropCardCell("imgpath", szCtlName, nRowIdx, "reits_lineup_icon02")
		
	elseif szData = "오피스" then
		Pannel0.SetPropCardCell("halign", szBgCtlName, nRowIdx, "0")
		Pannel0.SetPropCardCell("paddinginfo", szBgCtlName, nRowIdx, "40,0,0,0")
		Pannel0.SetPropCardCell("visible", szCtlName, nRowIdx, true)
		Pannel0.SetPropCardCell("imgpath", szCtlName, nRowIdx, "reits_lineup_icon03")
		
	elseif szData = "리테일" then
		Pannel0.SetPropCardCell("halign", szBgCtlName, nRowIdx, "0")
		Pannel0.SetPropCardCell("paddinginfo", szBgCtlName, nRowIdx, "40,0,0,0")
		Pannel0.SetPropCardCell("visible", szCtlName, nRowIdx, true)
		Pannel0.SetPropCardCell("imgpath", szCtlName, nRowIdx, "reits_lineup_icon04")
		
	elseif szData = "물류창고" then
		Pannel0.SetPropCardCell("halign", szBgCtlName, nRowIdx, "0")
		Pannel0.SetPropCardCell("paddinginfo", szBgCtlName, nRowIdx, "40,0,0,0")
		Pannel0.SetPropCardCell("visible", szCtlName, nRowIdx, true)
		Pannel0.SetPropCardCell("imgpath", szCtlName, nRowIdx, "reits_lineup_icon05")
		
	elseif szData = "모기지" then
		Pannel0.SetPropCardCell("halign", szBgCtlName, nRowIdx, "0")
		Pannel0.SetPropCardCell("paddinginfo", szBgCtlName, nRowIdx, "40,0,0,0")
		Pannel0.SetPropCardCell("visible", szCtlName, nRowIdx, true)
		Pannel0.SetPropCardCell("imgpath", szCtlName, nRowIdx, "reits_lineup_icon06")
		
	elseif szData = "헬스케어" then
		Pannel0.SetPropCardCell("halign", szBgCtlName, nRowIdx, "0")
		Pannel0.SetPropCardCell("paddinginfo", szBgCtlName, nRowIdx, "40,0,0,0")
		Pannel0.SetPropCardCell("visible", szCtlName, nRowIdx, true)
		Pannel0.SetPropCardCell("imgpath", szCtlName, nRowIdx, "reits_lineup_icon07")
		
	elseif szData = "복합형" then
		Pannel0.SetPropCardCell("halign", szBgCtlName, nRowIdx, "0")
		Pannel0.SetPropCardCell("paddinginfo", szBgCtlName, nRowIdx, "40,0,0,0")
		Pannel0.SetPropCardCell("visible", szCtlName, nRowIdx, true)
		Pannel0.SetPropCardCell("imgpath", szCtlName, nRowIdx, "reits_lineup_icon08")
		
	elseif szData = "기타" then
		Pannel0.SetPropCardCell("halign", szBgCtlName, nRowIdx, "0")
		Pannel0.SetPropCardCell("paddinginfo", szBgCtlName, nRowIdx, "40,0,0,0")
		Pannel0.SetPropCardCell("visible", szCtlName, nRowIdx, true)
		Pannel0.SetPropCardCell("imgpath", szCtlName, nRowIdx, "reits_lineup_icon09")
		
	else
		Pannel0.SetPropCardCell("halign", szBgCtlName, nRowIdx, "1")
		Pannel0.SetPropCardCell("paddinginfo", szBgCtlName, nRowIdx, "0,0,0,0")
		Pannel0.SetPropCardCell("visible", szCtlName, nRowIdx, false)
	end if

End Function

'===============================================
' 패널버튼(카테고리) 클릭 이벤트 처리
'===============================================
Function DisplaySetting_PannelBtn(nRowIdx, szCtlName)
	'기타 항목 가이드문구 처리
	lblGuide.visible = false
	
	nArrCnt = #g_arrCategory
	
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 

	Pannel0.rowcount = nPannelRowCnt
	
	nArrIdx = 0
	
	szSharedData = ""
	szCategoryCd = "%"
	
	for i = 0 to nPannelRowCnt - 1
		if i = nRowIdx and szCtlName = "lbl0" then
			szCategoryCd = g_arrCategory_Key(nArrIdx)
			
			if g_szCategoryCd = szCategoryCd then
				'-----------------------------------------------
				' 이전 카테고리 클릭 시, 선택 해제 
				'-----------------------------------------------
				szCategoryCd = "%"
				Pannel0.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Normal)	
			else
				'-----------------------------------------------
				' 카테고리 클릭 선택 
				'-----------------------------------------------
				if szCategoryCd = "09" then
					lblGuide.visible = true
				end if
				
				szSharedData = nRowIdx & "`" & szCtlName
				Pannel0.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Select)	
			end if
		else
			'-----------------------------------------------
			' 클릭하지 않은 카테고리는 비활성화 처리 
			'-----------------------------------------------
			Pannel0.SetPropCardCell("imagefilepth", "lbl0", i, g_szBtnImg_Normal)	
		end if
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Pannel0.SetCellVisible("lbl1",i,false)
			Pannel0.SetCellVisible("lbl2",i,false)
			Exit for
		end if
		
		if i = nRowIdx and szCtlName = "lbl1" then
			szCategoryCd = g_arrCategory_Key(nArrIdx)
			
			if g_szCategoryCd = szCategoryCd then
				'-----------------------------------------------
				' 이전 카테고리 클릭 시, 선택 해제 
				'-----------------------------------------------
				szCategoryCd = "%"
				Pannel0.SetPropCardCell("imagefilepth", "lbl1", i, g_szBtnImg_Normal)	
			else
				'-----------------------------------------------
				' 카테고리 클릭 선택 
				'-----------------------------------------------
				if szCategoryCd = "09" then
					lblGuide.visible = true
				end if
				
				szSharedData = nRowIdx & "`" & szCtlName
				Pannel0.SetPropCardCell("imagefilepth", "lbl1", i, g_szBtnImg_Select)	
			end if
		else
			'-----------------------------------------------
			' 클릭하지 않은 카테고리는 비활성화 처리 
			'-----------------------------------------------
			Pannel0.SetPropCardCell("imagefilepth", "lbl1", i, g_szBtnImg_Normal)	
		end if
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Pannel0.SetCellVisible("lbl2",i,false)
			Exit for
		end if
		
		if i = nRowIdx and szCtlName = "lbl2" then
			szCategoryCd = g_arrCategory_Key(nArrIdx)
			
			if g_szCategoryCd = szCategoryCd then
				'-----------------------------------------------
				' 이전 카테고리 클릭 시, 선택 해제 
				'-----------------------------------------------
				szCategoryCd = "%"
				Pannel0.SetPropCardCell("imagefilepth", "lbl2", i, g_szBtnImg_Normal)	
			else
				'-----------------------------------------------
				' 카테고리 클릭 선택 
				'-----------------------------------------------
				if szCategoryCd = "09" then
					lblGuide.visible = true
				end if
				
				szSharedData = nRowIdx & "`" & szCtlName
				Pannel0.SetPropCardCell("imagefilepth", "lbl2", i, g_szBtnImg_Select)	
			end if
		else
			'-----------------------------------------------
			' 클릭하지 않은 카테고리는 비활성화 처리 
			'-----------------------------------------------
			Pannel0.SetPropCardCell("imagefilepth", "lbl2", i, g_szBtnImg_Normal)	
		end if
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
	' 선택한 카테고리 코드
	g_szCategoryCd = szCategoryCd
	' 선택한 카테고리 컨트롤 위치(뒤로가기 용)
	g_szSelectCategory = szSharedData
	
	' 종목검색(건수) 조회
	RequestTranData_REITs(g_szCategoryCd, g_szNationCd_1, g_szNationCd_2, g_szNationCd_3, g_szNationCd_4, g_szNationCd_5, g_szSearchItemCd, "N", "Y", g_szSortCd)
End Function

'===============================================
' 리츠 종목검색(건수) 서비스 호출
'===============================================
'리츠카테고리 / 국가코드1 / 국가코드2 / 국가코드3 / 국가코드4 / 국가코드5 / 종목코드 / 신규상장 여부(YN) / 상장폐지 제외 여부(YN) / 정렬기준 
Function RequestTranData_REITs(szData0, szData1, szData2, szData3, szData4, szData5, szData6, szData7, szData8, szData9)
	contMain.Pannel0.rowcount = "0"
	
	DATAMANAGER.ClearInputData(0, "obsim_stsv_105r")
	DATAMANAGER.ClearInputData(0, "obsim_stsv_107r")
	
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "REIT_CTGR_CLCD"	, 0 , szData0)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_107r", "InBlock1", "REIT_CTGR_CLCD"	, 0 , szData0)
	
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "IQRY_COND_1_KEY_VAL"	, 0 , szData1)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "IQRY_COND_2_KEY_VAL"	, 0 , szData2)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "IQRY_COND_3_KEY_VAL"	, 0 , szData3)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "IQRY_COND_4_KEY_VAL"	, 0 , szData4)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "IQRY_COND_5_KEY_VAL"	, 0 , szData5)
	
	DATAMANAGER.SetDataValue(0, "obsim_stsv_107r", "InBlock1", "IQRY_COND_1_KEY_VAL"	, 0 , szData1)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_107r", "InBlock1", "IQRY_COND_2_KEY_VAL"	, 0 , szData2)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_107r", "InBlock1", "IQRY_COND_3_KEY_VAL"	, 0 , szData3)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_107r", "InBlock1", "IQRY_COND_4_KEY_VAL"	, 0 , szData4)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_107r", "InBlock1", "IQRY_COND_5_KEY_VAL"	, 0 , szData5)
	
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "ISCD"			, 0 , szData6)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "IQRY_COND_CODE1"	, 0 , szData7)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "SORT_CLS"		, 0 , szData9)
	
	'상장폐지 제외 여부는 기본 제외로 요건변경 되어 주석처리 
	'DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "IQRY_COND_CODE2"	, 0 , szData8)
	
	DATAMANAGER.RequestTranData("obsim_stsv_105r")
	DATAMANAGER.RequestTranData("obsim_stsv_107r")
End Function

'===============================================
' 리츠 종목검색 서비스 다음조회
'===============================================
Function RequestNextTranData_REITs()
	if DATAMANAGER.IsMoreNextData("obsim_stsv_105r") = true then
		DATAMANAGER.RequestNextData("obsim_stsv_105r")
	end if
End Function

'===============================================
' 리츠 종목검색 건수 처리
'===============================================
Function ResponseTranData_ItemCnt()
	if g_szSearchItemCd = "%" then
		nRowCnt = DATAMANAGER.GetDataCount(0, "obsim_stsv_107r", "OutBlock1")
		nTotalCnt = 0
		for i = 0 to nRowCnt-1
			nCnt = DATAMANAGER.GetDataValue(0, "obsim_stsv_107r", "OutBlock1", "REG_CSNU", i)
			nTotalCnt = nTotalCnt + Cint(nCnt)
		next
		
		contMain.lblItemCnt.caption = "검색결과 "&FormatNumber(nTotalCnt,0)&"건"
		
		if nTotalCnt = 0 then
			contMain.lblEmpty.visible = true
			contMain.imgEmpty.visible = true
		else
			contMain.lblEmpty.visible = false
			contMain.imgEmpty.visible = false
		end if
	end if
End Function

'===============================================
' 리츠 종목검색 리스트 처리
'===============================================
Function ResponseTranData_REITs()
	nDataCnt = DATAMANAGER.GetDataCount(0, "obsim_stsv_105r", "OutBlock1")
	
	if g_szSearchItemCd <> "%" then
		contMain.lblItemCnt.caption = "검색결과 "&FormatNumber(nDataCnt,0)&"건"
		
		if Cint(nDataCnt) = 0 then
			contMain.lblEmpty.visible = true
			contMain.imgEmpty.visible = true
		else
			contMain.lblEmpty.visible = false
			contMain.imgEmpty.visible = false
		end if
	end if
	
	for i = 0 to nDataCnt-1
		'종목코드
		szItem0 = DATAMANAGER.GetDataValue(0, "obsim_stsv_105r", "OutBlock1", "ISCD", i)
		'종목명(한글)
		szItem1 = DATAMANAGER.GetDataValue(0, "obsim_stsv_105r", "OutBlock1", "ISNM", i)
		'현재가격
		szItem2 = DATAMANAGER.GetDataValue(0, "obsim_stsv_105r", "OutBlock1", "PSNT_PRC", i)
		'거래수량
		szItem3 = DATAMANAGER.GetDataValue(0, "obsim_stsv_105r", "OutBlock1", "TR_QTY", i)
		'당일등락비율
		szItem4 = DATAMANAGER.GetDataValue(0, "obsim_stsv_105r", "OutBlock1", "TDAY_RSFL_RATE", i)
		
		nIdx = contMain.Pannel0.addRow()
		
		'-----------------------------------------------
		' 종목코드 및 가격소숫점 형식 변환 (기간계 > 투자정보) 
		'-----------------------------------------------
		szItem_Cd = ""
		szItem_NationCd = ""
		szItem_MrktCd = ""
		
		szPrc = ""
		
		if instr(szItem0, ".") > 0 then
			'해외 (XXXXXX.XX)
			arrTempData = split_ItemCode(szItem0)
			szItem_Cd = arrTempData(0)
			
			if arrTempData(1) = "AX" or arrTempData(1) = "NY" or arrTempData(1) = "OQ" then
				szItem_NationCd = "USA"
				szItem_MrktCd = arrTempData(1)
				szPrc = FormatNumber(szItem2,4)
			elseif arrTempData(1) = "JP" then
				szItem_NationCd = "JPN"
				szItem_MrktCd = arrTempData(1)
				szPrc = FormatNumber(szItem2,1)
			elseif arrTempData(1) = "SH" or arrTempData(1) = "SZ" then
				szItem_NationCd = "CHN"
				szItem_MrktCd = arrTempData(1)
				szPrc = FormatNumber(szItem2,3)
			elseif arrTempData(1) = "HK" then
				szItem_NationCd = "HKG"
				szItem_MrktCd = arrTempData(1)
				szPrc = FormatNumber(szItem2,3)
			end if
		else
			'국내 (AXXXXXX)
			szItem_Cd = Mid(szItem0,2,len(szItem0))

			szItem_NationCd = "KOR"
			szItem_MrktCd = "J"
			szPrc = FormatNumber(szItem2,0)
		end if
		
		'현재가 & 수익률
		szPrcRate = szPrc & " | " & FormatNumber(szItem4,2) & "%"
		
		'등락 색상
		szPrcRateAttr = "0"
		if Cdbl(szItem4) > 0 then
			szPrcRateAttr = "43"
		elseif Cdbl(szItem4) < 0 then
			szPrcRateAttr = "45"
		end if

		'거래량
		szVol = "거래량 " & FormatNumber(szItem3, 0)
		
		'국기이미지
		szImgNm = Form.getIconImg("FLAG", szItem_NationCd)
		
		'관심종목 포함여부
		szIntrCd = ""
		if szItem_NationCd = "KOR" then
			szIntrCd = szItem_Cd
		else
			szIntrCd = szItem_MrktCd&"@"&szItem_Cd
		end if

		isIntrItem = Form.isIntrItemList(szIntrCd)
		
		'인덱스 / 종목코드(시장조치) / 종목명 / 현재가(전일대비) / 국기이미지 / 레버리지인버스 배율 / 관심여부 / 보수율 / NAV / 거래량 / 종목코드 / 시장구분코드 / 종목명
		DisplaySetting_Pannel(nIdx, szItem_Cd, szItem1, szPrcRate, szPrcRateAttr, szImgNm, isIntrItem, szVol, szIntrCd, szItem_MrktCd, szItem1) 
	next
	
	'-----------------------------------------------
	' 뒤로가기 연동 처리
	'-----------------------------------------------
	szidx = Form.GetSharedData("50800_ROW_INDEX", false)
	
	if g_isPrev = true and szidx <> "" then
		nRowCnt = contMain.Pannel0.rowcount
		nIdx = Cint(szidx)
		
		if Cint(nRowCnt) < nIdx+1 then
			RequestNextTranData_REITs()
		else
			if Form.GetSharedData("&OS_TYPE", false) = "1" then
				contMain.fixTopAreaWhenScrolling(true, 47, "Up")
			end if
			
			contMain.Pannel0.toprow = nIdx
			Form.GetSharedData("50800_ROW_INDEX", true)
			g_isPrev = false
		end if
	end if
End Function

'===============================================
' 리츠 종목검색 패널 처리
'===============================================
'인덱스 / 종목코드(시장조치) / 종목명 / 현재가(전일대비) / 국기이미지 / 레버리지인버스 배율 / 관심여부 / 보수율 / NAV / 거래량 / 종목코드 / 시장구분코드 / 종목명
Function DisplaySetting_Pannel(nIdx, szItemCd, szItemNm, szPrcRate, szPrcRateAttr, szFlag, szIntrYN, szVol, szHideData0, szHideData1, szHideData2) 
	'상단 라인표시
	contMain.Pannel0.setPropCardCell("bgcolor","lblLine2", nIdx , g_szLineColor)
	
	'종목 국가 국기이미지 
	contMain.Pannel0.setPropCardCell("maintainratio", "imgFlag", nIdx, "2")
	contMain.Pannel0.setPropCardCell("imgpath","imgFlag", nIdx, szFlag)
	
	'관심종목 아이콘 (관심등록 여부 확인 후 표시 필요)
	contMain.Pannel0.setPropCardCell("maintainratio", "imgIntr", nIdx, "3")
	if szIntrYN = true then
		contMain.Pannel0.setPropCardCell("imgpath","imgIntr", nIdx, g_szIntrImg_Select)
	else
		contMain.Pannel0.setPropCardCell("imgpath","imgIntr", nIdx, g_szIntrImg_Normal)
	end if
	
	'종목명
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemName",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemName",nIdx, g_szTxtColor_Normal)
	contMain.Pannel0.setPropCardCell("maxlinecnt","lblItemName",nIdx, "1^-4")
	contMain.Pannel0.setPropCardCell("fontsize","lblItemName",nIdx, "-2")
	contMain.Pannel0.setPropCardCell("caption","lblItemName",nIdx, szItemNm)
	
	'종목코드(시장조치)
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemCode",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemCode",nIdx, g_szTxtColor_Grey)
	contMain.Pannel0.setPropCardCell("fontsize","lblItemCode",nIdx, "-2")
	contMain.Pannel0.setPropCardCell("caption","lblItemCode",nIdx, szItemCd)
	
	'현재가(전일대비)
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemPrc",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fontsize","lblItemPrc",nIdx, "-2")
	contMain.Pannel0.setPropCardCell("caption","lblItemPrc",nIdx, szPrcRate)
	
	if szPrcRateAttr = "43" then
		contMain.Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Buy)
	elseif szPrcRateAttr = "45" then
		contMain.Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Sell)
	else
		contMain.Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Grey)
	end if

	'거래량
	contMain.Pannel0.setPropCardCell("paddinginfo","lblItemData2",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","lblItemData2",nIdx, g_szTxtColor_Grey)
	contMain.Pannel0.setPropCardCell("fontsize","lblItemData2",nIdx, "-4")
	contMain.Pannel0.setPropCardCell("caption","lblItemData2",nIdx, szVol)
	
	'(숨김)종목코드
	contMain.Pannel0.setPropCardCell("caption","lblHideData0",nIdx, szHideData0)
	contMain.Pannel0.setPropCardCell("caption","lblHideData1",nIdx, szHideData1)
	contMain.Pannel0.setPropCardCell("caption","lblHideData2",nIdx, szHideData2)
	
	'화면연동 버튼
	contMain.Pannel0.setPropCardCell("paddinginfo","btnHyun",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnHyun",nIdx, g_szTxtColor_Grey)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnChart",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnChart",nIdx, g_szTxtColor_Grey)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnInfo",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnInfo",nIdx, g_szTxtColor_Grey)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnOrder0",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnOrder0",nIdx, g_szTxtColor_White)
	
	contMain.Pannel0.setPropCardCell("paddinginfo","btnOrder1",nIdx, "0,0,0,0")
	contMain.Pannel0.setPropCardCell("fgcolor","btnOrder1",nIdx, g_szTxtColor_White)
End Function

'===============================================
' 관심종목 그룹 건수 조회 서비스 호출
'===============================================
Function RequestTranData_Intr()
	DATAMANAGER.ClearInputData(0, "ohhts_intr_006r")
	DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))
	DATAMANAGER.RequestTranData("ohhts_intr_006r")
End Function

'===============================================
' 관심종목 그룹 건수 조회 처리
'===============================================
Function ResponseTranData_Intr()
	g_szIntrGrpCnt = DATAMANAGER.GetDataCount(0, "ohhts_intr_006r" , "OutBlock1")
End Function


'===============================================
' 국가명 코드 변환(기간계)
'===============================================
Function Convert_NationNmtoCd(szData)
	szNationCd = "%" 
	
	if szData = "국내" then
		szNationCd = "410"
	elseif szData = "미국" then
		szNationCd = "840"
	elseif szData = "홍콩" then
		szNationCd = "344"
	elseif szData = "일본" then
		szNationCd = "392"
	elseif szData = "중국" then
		'중국은 미사용
		szNationCd = "156"
	end if
	
	return szNationCd 
End Function

'===============================================
' 정렬코드 변환(기간계)
'===============================================
Function Convert_SortCd(szData)
	szSortCd = "4" 
	
	if szData = "상승률 높은순" then
		szSortCd = "2" 
	elseif szData = "상승률 낮은순" then
		szSortCd = "3" 
	elseif szData = "거래량 많은순" then
		szSortCd = "4" 
	end if
	
	return szSortCd 
End Function

'===============================================
' 무브팝업 처리
'===============================================
Function MovePopup(nidx, nGbn)
	szMktCd = contMain.Pannel0.getPropCardCell("caption","lblHideData1",nidx)
	szItemCd = contMain.Pannel0.getPropCardCell("caption","lblHideData0",nidx)
	szItemNm = contMain.Pannel0.getPropCardCell("caption","lblHideData2",nidx)
	
	' 뒤로가기 연동 데이터
	Form.SetSharedData("50800_INDEX", "1")
	Form.SetSharedData("50800_ROW_INDEX", nidx)

	Form.SetSharedData(g_szSharedKey_Item , g_szSearchItem)
	Form.SetSharedData(g_szSharedKey_Filter , g_szSaveFilterData)
	Form.SetSharedData(g_szSharedKey_Category , g_szSelectCategory)

	Form.manageTotalSearch("REITS_DLG_HISTORY", "set", szItemCd)
	Select Case szMktCd
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			Form.SetSharedData( "&ITEM_CODE" , szItemCd )
			Form.SetSharedData( "&ITEM_KORNAME" , szItemNm )
			Form.SetSharedData( "&ITEM_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )					
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )
			
			if nGbn == 0 then						' 현재가
				Form.OpenScreen("16000", szItemCd&"★INCOME★1")				
			elseif nGbn == 1 then					' 차트
				Form.OpenScreen("16020", "")
			elseif nGbn == 2 then				
				Form.OpenScreen("16000", szItemCd&"★INCOME★0")		
			elseif nGbn == 3 then					' 매수
				Form.OpenScreen("16060", "0")
			elseif nGbn == 4 then					' 매도
				Form.OpenScreen("16060", "1")
			end if
		Case Else
			if nGbn == 0 then							' 현재가
				Form.OpenScreen("11000", szItemCd&"★INCOME★1")
			elseif nGbn == 1 then						' 차트
				Form.OpenScreen("13000", szItemCd)
			elseif nGbn == 2 then	
				Form.OpenFramePopup("nrshidx50800_p2" , szItemCd & "|" & szMktCd & "|" &  szItemNm , sPosInfo)
			elseif nGbn == 3 then						' 매수
				Form.OpenScreen("12000", "스크리너★0" & "★" & szItemCd)
			elseif nGbn == 4 then						' 매도
				Form.OpenScreen("12000", "스크리너★1" & "★" & szItemCd)
			end if	
	End Select

End Function

'===============================================
' 배열 -> 문자열 변환
'===============================================
Function Convert_ArrToString(arrData, szSeperator)
	szResult = ""
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if i <> 0 then
			szResult = szResult & szSeperator 
		end if
		
		szResult = szResult & arrData(i) 
	next
	
	return szResult
End Function

'===============================================
' 배열 -> 문자열 변환(체크항목)
'===============================================
Function Convert_ChkArrToString(arrData, arrChkData, szSeperator)
	szResult = ""
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if arrChkData(i) = "1" then
			if szResult <> "" then
				szResult = szResult & szSeperator 
			end if
			szResult = szResult & arrData(i) 
		end if
	next
	
	return szResult
End Function

'===============================================
' 문자열 -> 배열 변환
'===============================================
Function Convert_StringToArr(szData, szSeperator)
	szArrData = ""
	
	if szData <> null and szData <> "" then
		szArrData = split(szData, szSeperator)
	end if
	
	return szArrData
End Function

'===============================================
' 배열 데이터 확인
'===============================================
Function Contains_Array(arrData, szData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		szArrData = arrData(i)
		
		if szArrData = szData then
			return true
		end if
	next 
	
	return false
End Function

'===============================================
' 해외주식 종목코드 변환(기간계)
'===============================================
Function split_ItemCode(szItemCd)
	arrTemp = {}
	if szItemCd = "" then
		Exit Function
	end if
	
	if instr(szItemCd, ".") = 0 then
		Exit Function
	end if
	
	if instr(szItemCd, ".AX") > 0 then
		Table.insert(arrTemp, replace(szItemCd, ".AX", ""))
		Table.insert(arrTemp, "AX")
		
	elseif instr(szItemCd, ".NY") > 0 then
		Table.insert(arrTemp, replace(szItemCd, ".NY", ""))
		Table.insert(arrTemp, "NY")

	elseif instr(szItemCd, ".OQ") > 0 then
		Table.insert(arrTemp, replace(szItemCd, ".OQ", ""))
		Table.insert(arrTemp, "OQ")

	elseif instr(szItemCd, ".HK") > 0 then
		Table.insert(arrTemp, replace(szItemCd, ".HK", ""))
		Table.insert(arrTemp, "HK")

	elseif instr(szItemCd, ".SZ") > 0 then
		Table.insert(arrTemp, replace(szItemCd, ".SZ", ""))
		Table.insert(arrTemp, "SZ")	

	elseif instr(szItemCd, ".SH") > 0 then
		Table.insert(arrTemp, replace(szItemCd, ".SH", ""))
		Table.insert(arrTemp, "SH")

	elseif instr(szItemCd, ".JP") > 0 then
		Table.insert(arrTemp, replace(szItemCd, ".JP", ""))
		Table.insert(arrTemp, "JP")
		
	else
		Table.insert(arrTemp, "")
		Table.insert(arrTemp, "")
		
	end if
	
	return arrTemp
End Function

'===============================================
' 필터 데이터 처리
'===============================================
Function ProcFilterData(sRet)
	arrOptionData = split(sRet, "★")
		
	g_szSaveFilterData =sRet
	
	g_szNationCd_1 = "%"
	g_szNationCd_2 = "%"
	g_szNationCd_3 = "%"
	g_szNationCd_4 = "%"
	g_szNationCd_5 = "%"
	if #arrOptionData > 0 then
		arrTempData = Convert_StringToArr(arrOptionData(0), "`")
		
		if #arrTempData > 0 then
			g_szNationCd_1 = ""
			g_szNationCd_2 = ""
			g_szNationCd_3 = ""
			g_szNationCd_4 = ""
			g_szNationCd_5 = ""
	
			for i = 0 to #arrTempData - 1
				szNationCd = Convert_NationNmtoCd(arrTempData(i))
				
				if i = 0 then
					g_szNationCd_1 = szNationCd
				elseif i = 1 then 
					g_szNationCd_2 = szNationCd
				elseif i = 2 then 
					g_szNationCd_3 = szNationCd
				elseif i = 3 then 
					g_szNationCd_4 = szNationCd
				elseif i = 4 then 
					g_szNationCd_5 = szNationCd
				end if
			next
		end if
	end if
	
	g_szSortCd = "4"
	if #arrOptionData > 1 then
		g_szSortCd = Convert_SortCd(arrOptionData(1))
	end if
	
	arrTempData = split(arrOptionData(0), "`")
	szTempData = ""
	for i = 0 to #arrTempData-1
		if i = 0 then
			szTempData = arrTempData(i)
		else
			szTempData = szTempData & "·" &arrTempData(i)
		end if
	next
	
	contMain.lblFilter.fontsize = "-2"
	contMain.lblFilter.maxlinecnt = "1^-8"
	
	szFTempData = ""
	if #arrOptionData > 1 then
		szFTempData = arrOptionData(1)
	end if
	if g_szSaveFilterData  = "전체★거래량 많은순" then
		contMain.lblFilter.caption = "필터"
				
	elseif szTempData = "" and szFTempData = "" then
		contMain.lblFilter.caption = "필터"

	elseif szTempData = "" then
		contMain.lblFilter.caption = szFTempData
		
	elseif arrOptionData(1) = "" then
		if szTempData = "전체" then
			szTempData = "필터"
		end if
	
		contMain.lblFilter.caption = szTempData		
	else
		contMain.lblFilter.maxlinecnt = "2^-8"
		contMain.lblFilter.caption = szTempData & "\n" & arrOptionData(1)
	end if
End Function

