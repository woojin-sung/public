	end if
	
	DisplaySetting_PannelBtn(nIndex, sCellID)
End Sub

'===============================================
' contMain_Pannel0_OnClick : 검색리스트 패널 클릭
'===============================================
Sub contMain_Pannel0_OnClick(nIndex, sCellID)
	if sCellID <> "imgIntr" and sCellID <> "imgCompChk" and sCellID <> "btnHyun" and sCellID <> "btnChart" and sCellID <> "btnInfo" and sCellID <> "btnOrder0" and sCellID <> "btnOrder1" then
		nCurHeight = contMain.Pannel0.GetCardWHAt(nIndex)
		
		nTopRow = Cint(contMain.Pannel0.toprow)
		nGap = Cint(nIndex) - nTopRow
		
		if g_nFoldHeight = nCurHeight then
			contMain.Pannel0.setPropCardCell("top","lblLine2", nIndex , g_nExpandHeight-1)
			contMain.Pannel0.SetCardWHAt(nIndex, g_nExpandHeight)
			
			if g_nPrev_Expand_Idx > -1 then
				if g_nPrev_Expand_Idx <> nIndex then
					contMain.Pannel0.setPropCardCell("top","lblLine2", g_nPrev_Expand_Idx , g_nFoldHeight-1)
					contMain.Pannel0.SetCardWHAt(g_nPrev_Expand_Idx, g_nFoldHeight)
				end if
			end if
			
			g_nPrev_Expand_Idx = nIndex
			
			if g_isExpand = true then
				if nGap > 5 then
					contMain.Pannel0.toprow = nTopRow + 2
				elseif nGap > 4 then
					contMain.Pannel0.toprow = nTopRow + 1
				end if
			else
				if nGap > 2 then
					contMain.Pannel0.toprow = nTopRow + 2
				elseif nGap > 1 then
					contMain.Pannel0.toprow = nTopRow + 1
				end if
			end if
		else
		
			contMain.Pannel0.setPropCardCell("top","lblLine2", nIndex , g_nFoldHeight-1)
			contMain.Pannel0.SetCardWHAt(nIndex, g_nFoldHeight)
		end if
	else
		'비교하기 미사용
'		if sCellID = "imgCompChk" and g_isCompChk = true then
'			if nIndex = g_nCompChkIdx_1 then
'				g_nCompChkIdx_1 = -1
'				g_nCompChkCnt = g_nCompChkCnt - 1
'				btnClear.visible = false
'				btnSearch.visible = false
'				contMain.Pannel0.height = 662
'				contMain.Pannel0.setPropCardCell("imgpath","imgCompChk", nIndex, g_szChkImg_Normal)
'			elseif nIndex = g_nCompChkIdx_2 then
'				g_nCompChkIdx_2 = -1
'				g_nCompChkCnt = g_nCompChkCnt - 1
'				btnClear.visible = false
'				btnSearch.visible = false
'				contMain.Pannel0.height = 662
'				contMain.Pannel0.setPropCardCell("imgpath","imgCompChk", nIndex, g_szChkImg_Normal)
'			else
'				if g_nCompChkCnt = 2 then
'					Form.ShowAlert("안내", "2개 종목만 선택 가능합니다.")
'				else
'					g_nCompChkCnt = g_nCompChkCnt + 1
'					if g_nCompChkIdx_1 = -1 then
'						g_nCompChkIdx_1 = nIndex
'					elseif g_nCompChkIdx_2 = -1 then
'						g_nCompChkIdx_2 = nIndex
'					end if
'					
'					if g_nCompChkCnt = 2 then
'						btnClear.visible = true
'						btnSearch.visible = true
'						
'						contMain.Pannel0.height = 602
'					end if
'					
'					contMain.Pannel0.setPropCardCell("imgpath","imgCompChk", nIndex, g_szChkImg_Select)
'				end if
'			end if
		if sCellID = "imgIntr" and g_isCompChk = false then
			g_szIntrItemCd = contMain.Pannel0.getPropCardCell("caption","lblHideData0",nIndex)
			g_szIntrIdx = nIndex
			
			szisIntr = Form.isIntrItemList(g_szIntrItemCd)
			
			if szisIntr = true then
				Form.OpenPopup("nrshidx50110_p4", g_szIntrItemCd& "★"& "DEL","", "")	'종목삭제
			else
				if CInt(g_szIntrGrpCnt) < 1 then
					g_szAction = "GROUP_ADD2"			
					Form.OpenPopup("nrshidx50110_p6", g_szAction & "★" & g_szIntrItemCd & "★", "")
				else
					Form.OpenPopupAnimation("nrshidx50110_p5", g_szIntrItemCd& "★"& "ADD","", "2")	'종목등록
				end if
			end if
		elseif sCellID = "btnHyun" then
			MovePopup(nIndex, 0)
		elseif sCellID = "btnChart" then
			MovePopup(nIndex, 1)
		elseif sCellID = "btnInfo" then
			MovePopup(nIndex, 2)
		elseif sCellID = "btnOrder0" then
			MovePopup(nIndex, 3)
		elseif sCellID = "btnOrder1" then
			MovePopup(nIndex, 4)	
		end if
	end if
End Sub

