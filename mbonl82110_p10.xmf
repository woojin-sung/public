				<LABEL name="lblInfo0" fontsize="-2" caption="신용거래대주는 증권금융회사로부터 차입하여 고객에게 주식을 빌려주는 유통신용거래대주임." valign="0" multiline="1" ly_vert="25,31,325,55,1" />
				<LABEL name="lblInfo1" fontsize="-2" caption="(호가가격제한) 신용거래대주 매도주문 시 직전가 이하의 호가가 금지" valign="0" multiline="1" ly_vert="25,112,325,50,1" />
				<LABEL name="lblInfo2" fontsize="-2" caption="(유통대주 이용 시 제한사항) 하나의 증권사를 선택하여 매매, 보유정보를 집중한 뒤 이용해야함. 고객잔고에 대주하고자 하는 종목의 잔고(현금주식+신용주식)가 있는 경우 동일 종목의 신규대주 주문이 불가함. 대주 잔고 보유 시 동일종목 매수가 불가함." valign="0" multiline="1" ly_vert="25,150,325,85,1" />
				<LABEL name="lblInfo3" fontsize="-2" caption="(공매도 포지션 보고·공시 제도) 주권상장법인이 발행한 주식의 종목별 발행총수에 대한 일별 순보유잔고 비율이 일정비율 이상이 되면 순보유 잔고(공매도 잔고)를 보고 또는 공시하여야 함." valign="0" multiline="1" ly_vert="25,234,325,80,1" />
				<LABEL name="lblInfo4" fontsize="-2" caption="(공매도 관련 유상증자 참여 제한) 모집 또는 매출 계획이 처음 공시된 날의 다음날부터 해당 모집 또는 매출의 공시 또는 변경공시에 따른 모집 또는 매출가액이 결정되는 날까지 공매도를 하거나 공매도 주문을 위탁한 경우에는 해당 모집 또는 매출에 따른 주식을 취득해서는 안됨." valign="0" multiline="1" ly_vert="25,304,325,100,1" />
				<LABEL name="lblInfo5" fontsize="-2" caption="(권리관련 사항) 권리락 발생시 권리대금의 추가납부(현금)가 발생하며, 권리대금 납부일에 계좌내 현금 미존재시 미수가 발생(연체료 부과)" valign="0" multiline="1" ly_vert="24,404,325,50,1" />
				<LABEL name="lblInfo6" fontsize="-2" caption="(주문관련 사항) 정규시장(시간외종가 및 시간외단일가 불가, 예약주문 불가) 주문가능하며, 지정가만 가능함." valign="0" multiline="1" ly_vert="25,457,325,40,1" />
				<LABEL name="lblInfo7" fontsize="-2" caption="SMS(또는 알림톡)로 변경내용을 요약 통보함" valign="0" multiline="1" ly_vert="25,540,325,40,1" />
				<LABEL name="lblInfo8" fontsize="-2" caption="담보부족, 반대매매, 만기예정 내역을 SMS(또는 알림톡)로 통보" valign="0" multiline="1" ly_vert="25,607,325,40,1" />
				<LABEL name="lblInfo9" fontsize="-2" caption="추가담보요구(담보부족) 시 전화(핸드폰→원장통보지
→통보지외전화 순) 및 SMS/이메일(이메일은 선택한
경우에 한함)로 통보하며, 전화/SMS/이메일 모두 통보
불가(발송실패) 시 내용증명으로 통보" valign="0" multiline="1" ly_vert="25,644,325,80,1" />
			</CONTROL_INFO>
		</CONTAINER>
		<CONTAINER name="Container1" ly_vert="0,597,375,50,1" scroll_ly_vert="0,597,375,50,1" >
			<CONTROL_INFO>
				<BUTTON name="btnOK" caption="확인" btnimage="btn_01.9" ly_vert="183,0,194,50,1" />
				<BUTTON name="btnCancel" caption="닫기" fgcolor="004:000000000" btnimage="btn_pop1.9.png" ly_vert="0,0,187,50,1" />
			</CONTROL_INFO>
		</CONTAINER>
		<LABEL name="Label1" bgcolor="075:244244244" transmode="0" ly_vert="10,150,355,5,1" />
		<LABEL name="lbSubTitle" fontsize="2" fontstyle="01" caption="이자 및 상환 방식" click="1" ly_vert="10,106,315,50,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="13643" _ulen="11473" >
Dim g_szDeviceOS
Dim g_nOpenIndex
g_nOpenIndex = -1

Dim g_tTitle, g_tSubTitle
Dim g_nIndex, g_nSubIndex


g_tTitle = {"신용거래융자약정", "신용거래대주약정", "증권담보융자약정" }
g_tSubTitle = {"이자 및 상환 방식", "담보 관련", "소비자 부담금액", "투자위험 및 불이익", "금융소비자의 권리", "기타 유의사항" }

Dim g_szTop, g_szHeight, g_szContainer
g_szTop = 165
g_szHeight = 433
g_szContainer = ""

Dim g_szRet
g_szRet	=	"Cancel"

'============================================================================
Function SetContainerVisible()
	lbSubTitle.caption = g_tSubTitle[g_nSubIndex]
	
	Dim szName
	for i = 0 to #g_tTitle - 1
		for j = 0 to #g_tSubTitle - 1
			szName = "Container" & CStr(i) & CStr(j)	
			if i == g_nIndex and j == g_nSubIndex then
				Form.SetCtlProp(szName, "left", 0)
				g_szContainer = szName
			else
				Form.SetCtlProp(szName, "left", 500)
			end if 			
		Next
	Next	
End Function 

'changeTextAttr(nStartOffset, nLen, nColorIdx, nFontSize, isBold)
