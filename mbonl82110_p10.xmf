				<LABEL name="lblInfo0" fontsize="-2" caption="매도증권(담보) 가치가 담보유지비율 하회 시 투자자 의사와 상관없는 임의처분(반대매매)에 따른 손실 위험" valign="0" multiline="1" ly_vert="25,31,325,50,1" />
				<LABEL name="lblInfo1" fontsize="-2" caption="시장상황이 예측과 다를 경우 투자원금의 상당부분 또는 투자원금 이상의 손실 가능" valign="0" multiline="1" ly_vert="25,113,325,75,1" />
				<LABEL name="lblInfo2" fontsize="-2" caption="만기 미상환 시 담보증권이 임의처분 되며, 임의처분으로 모든 주식을 처분한 이후에도 연체금액이 잔존할 경우 연체이자 납부 및 이에 따른 신용도 하락 등의 불이익이 발생할 수 있음." valign="0" multiline="1" ly_vert="25,195,325,92,1" />
			</CONTROL_INFO>
		</CONTAINER>
