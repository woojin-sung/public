'============================================================================
Sub Form_OnFormInit()
	g_szDeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	Dim tOpenData, tData1
	tOpenData = Form.GetOpenLinkData()
	if tOpenData <> "" then	
		tData1 = Split(tOpenData,"★")	
		if tData1[0] <> nil then
			g_nIndex = tonumber(tData1[0])
		end if 
		if tData1[1] <> nil then
			g_nSubIndex = tonumber(tData1[1])
		end if 
	else
		g_nIndex = -1
		g_nSubIndex = -1	
		exit Sub	
'For TEST
'g_nIndex = 1
'g_nSubIndex = 5
'msgbox g_nIndex  & " *** " & g_nSubIndex
	end if 

	SetContainerVisible()
	SetContainerContent()
	
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Container10.Top = g_szTop
	Container11.Top = g_szTop
	'Container12.Top = g_szTop
	Container13.Top = g_szTop
	Container14.Top = g_szTop
	Container15.Top = g_szTop

	Container10.Height = g_szHeight
	Container11.Height = g_szHeight
	'Container12.Height = g_szHeight
	Container13.Height = g_szHeight
	Container14.Height = g_szHeight
	Container15.Height = g_szHeight
End Sub

'============================================================================
Sub Container1_btnCancel_OnClick()
	Form.SendReturnToParent("mbonl82110_p10" , "Close☆"& g_nSubIndex)
	g_szRet	=	"Cancel"
	Form.CloseForm()	
End Sub

'============================================================================
Sub Container1_btnOK_OnClick()
	Form.SendReturnToParent("mbonl82110_p10" , "OK☆"& g_nSubIndex)
	g_szRet	=	"OK"
	Form.CloseForm()	
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

