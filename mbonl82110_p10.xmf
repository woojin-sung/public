				<LABEL name="lblInfo1" fontsize="-2" caption="<![CDATA[※ 대주주문> 대주 가능종목 화면에서 확인 가능]]>" valign="0" multiline="1" ly_vert="20,67,325,20,1" />
				<LABEL name="lblInfo0" fontsize="-2" caption="유가증권시장 및 코스닥에 상장된 종목 중 회사에서 정하는 종목" valign="0" multiline="1" ly_vert="25,31,325,35,1" />
				<LABEL name="lblInfo3" fontsize="-2" caption="신용거래대주 시 매도대금을 담보로 징구" valign="0" multiline="1" ly_vert="25,131,325,30,1" />
				<LABEL name="lblInfo4" fontsize="-2" caption="제공된 담보증권의 가치가 담보유지비율에 미달하는 경우, 담보의 추가납부를 요구하지 아니하고 고객의 계좌에 담보로 제공하지 아니한 현금 또는 회사가 지정한 증권을 추가담보로 징구. 그럼에도 불구하고 담보유지비율에 미달하는 경우 추가납부 요구" valign="0" multiline="1" ly_vert="25,154,325,80,1" />
				<LABEL name="lblInfo5" fontsize="-2" caption="담보평가는 최근일 종가로 평가" valign="0" multiline="1" ly_vert="25,238,325,20,1" />
				<LABEL name="lblInfo6" fontsize="-2" caption="신용거래대주(A, B군): 120%" valign="0" multiline="1" ly_vert="25,305,325,30,1" />
				<LABEL name="lblInfo7" fontsize="-2" caption="동일 계좌 내 융자와 함께 사용하는 경우, 계좌의 담보유지비율은 가중평균하여 계산" valign="0" multiline="1" ly_vert="25,329,325,50,1" />
				<LABEL name="lblInfo8" fontsize="-2" caption="담보유지비율 미달 및 반대매매 대상 금액 산출기준은 ‘계좌담보유지비율’로 산정" valign="0" multiline="1" ly_vert="25,369,325,50,1" />
				<LABEL name="lblInfo9" fontsize="-2" caption="계좌 담보비율이 120% 미만시 발생 익영업일 오전 동시호가에 반대매매 시행" valign="0" multiline="1" ly_vert="25,409,325,50,1" />
				<LABEL name="lblInfo10" fontsize="-2" caption="대주잔고만 보유한 경우 계좌 담보유지비율이 120%
이므로, 담보관리 및 반대매매에 더욱 유의해야 함." valign="0" multiline="1" ly_vert="25,449,325,60,1" />
			</CONTROL_INFO>
		</CONTAINER>
