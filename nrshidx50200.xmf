<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="50200" scrname="ETF투자가이드_메인" version="2" writer="함원규" />
	<FORM_INFO name="Form" ly_vert="0,0,375,702,1" />
	<CONTROL_INFO>
		<IMAGE name="imgBack" autosize="1" imgpath="icon_main_01" ly_vert="6,11,40,24,1" />
		<LABEL name="lblTitle" fontsize="4" caption="ETF 투자가이드" bgcolor="064:239059036" ly_vert="40,12,195,23,1" />
		<TAB name="tabMenu" tabheadheight="47" tabwidthtype="1" tabcount="2" ly_vert="20,47,335,47,1" >
			<PAGE name="0" caption="ETF란?" >
				<CONTROL_INFO/>
			</PAGE>
			<PAGE name="1" caption="자주하는 질문" >
				<CONTROL_INFO/>
			</PAGE>
		</TAB>
		<LINKFORM name="lkformScreen" ly_vert="0,94,375,608,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="997" _ulen="997" >

'============================================================================
Sub Form_OnFormInitBefore()
	imgBack.setMaintainingRatio("2")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData, szTab
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		szTab = szOpenData
	else
		szTab = "0"
	end if
	
	tabMenu.currenttab = szTab
	
	if CInt(tabMenu.currenttab) == 0 then
		lkformScreen.linkfile = "nrshidx50200_t1"
	else
		lkformScreen.linkfile = "nrshidx50200_t2"
	end if
End Sub

'============================================================================
Sub tabMenu_OnTabChanged(nCurrentTab)
	if nCurrentTab == 0 then
		lkformScreen.linkfile = "nrshidx50200_t1"
	else
		lkformScreen.linkfile = "nrshidx50200_t2"
	end if
End Sub

'============================================================================
Sub imgBack_OnClick()
	Form.openPrevScreen()
End Sub

	</SCRIPT_INFO>
</ROOT>