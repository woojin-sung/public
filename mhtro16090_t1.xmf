'============================================================================
' btnCash_OnClick : 현금버튼 클릭
'============================================================================
Sub btnCash_OnClick()
'	'20210329 LES START 통합증거금
	'주문가능수량 조회(현금/통합)
	
	if Trim(edtPrc.caption) == "" or Trim(edtPrc.caption) == "0" then
		Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
		Exit Sub
	end if	
		
	
	'szData = 계좌번호★계좌일련번호★계좌비번★종목코드★거래소코드★종목명★주문단가★약정여부
	szAcno = Form.GetTopCtlProp("acnt", "total")
	szAsno = Form.GetTopCtlProp("acnt", "sequence")
	
	if plain_rm =="1" then
		szPass = Form.GetTopCtlProp("edtPwd", "caption")
	else
		szPass = Form.GetTopCtlProp("edtPwd", "encdata")
	end if
	
	szCode = sCodeData[1]
	szMk = g_szMk
	szPrc = prcDecimalSet(edtPrc.caption)
	
	szData = szAcno .. "★" .. szAsno .. "★" .. szPass .. "★" .. szCode .. "★" .. szMk .. "★" .. g_szKorName .. "★" .. szPrc .."★" .. gTotalYN
	'Form.ShowAlert("szData", szData)
	
	
	Form.OpenPopup("mhtro16060_p11" , szData , "")
'	
'	'ORGNSRC
'	Request_Able()
'	'LES END
End Sub

