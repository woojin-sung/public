Sub BtnPrc4_OnClick()
	szPrc = CLng(TblAbleprc.GetCellString(0, 1))
	if szPrc = "" or szPrc = null then
		LblAlert.caption = "주문가능금액을 확인해주세요"
		Exit Sub 
	end if
	szMod = szPrc Mod 1000
	if szPrc > 1000 then
		szPrc = szPrc-szMod
	end if
	BtnPrcin.caption = ""
	g_szPopPrc = szPrc
	call LblPrcin_OnClick()
End Sub

