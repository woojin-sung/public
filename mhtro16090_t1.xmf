'============================================================================
' Request_Order
'============================================================================
Function Request_Order()
	g_szWarnFlag	= "N"	' 20181022 HWG : 해외주식 주문착오 방지
	DATAMANAGER.RequestTranData("obtro_oder_801a")
End Function

'============================================================================
' Check_Account
'============================================================================
Function Check_Account(nGbn)
	Dim szAcnt, szPwd

	szAcnt = Form.GetTopCtlProp("acnt", "caption")
	If Len(szAcnt) < 10 Then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
		return False
	End If
	
	if nGbn <> 2 then
		szPwd = Form.GetTopCtlProp("edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function

'============================================================================
' Return_AutoQty
'============================================================================
Function Return_AutoQty()
	if g_szBuyQty == "1" then			' 현금가능수량
		Request_Able()
	elseif g_szBuyQty == "2" then		' 최대가능수량 (해외주식은 미수가 없어 현금가능수량으로 조회)
		Request_Able()
	elseif g_szBuyQty == "3" then		' 수량입력
		edtQty.caption = g_szBuyQtyCnt
		edtQty_OnEditComplete()
	end if
End Function

'============================================================================
' Request_Able
'============================================================================
Function Request_Able()	
	g_szWarnFlag = "N"	' 20181022 HWG : 해외주식 주문착오 방지
'	DATAMANAGER.RequestTranData("obrtp_drab_001r")				' 주문가능금액 조회	
	call Check_AcntLst()
End Function

