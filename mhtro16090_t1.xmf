'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	GrdLine.SetCellBgColor(bd_cell0, 0, "290")
	btnBuy.fontbold = true '안드로이드
	Load_OrderSet() '주문설정값 읽어오기
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	 plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END

	'20210329 LES START 통합증거금
'	DATAMANAGER.RequestTranData("obpds_srvc_323r")

'	DATAMANAGER.RequestTranData("obrtp_drab_001r")
	call Check_AcntLst()
'	
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 현재가 호가연동
	' ----------------------------------------------------------------------		
	if sEventName == "PRICE" then
		edtPrc.caption = sParam
		edtPrc_OnEditComplete()
	' ----------------------------------------------------------------------
	' 호가테이블 클릭 호가연동
	' ----------------------------------------------------------------------	
	elseif sEventName == "HOGA" then
		edtPrc.caption = sParam
		edtPrc_OnEditComplete()
	' ----------------------------------------------------------------------
	' 메인화면 이벤트처리 (종목변경/탭변경)
	' ----------------------------------------------------------------------		
	' 20171127 HAMWG START : 해외주식 종목코드 가져오기
	elseif sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then	
		'20211012 HSZ 통합증거금
'		DATAMANAGER.RequestTranData("obpds_srvc_323r")
'		DATAMANAGER.RequestTranData("obrtp_drab_001r")
		call Check_AcntLst()
		if g_szCd <> sParam then
			g_szCd = sParam
			sCodeData = Split(sParam, "@")		
			g_szKorName = Form.GetItemCodeInfo(g_szCd, "name")	' 한글종목명
			g_szNg = Form.GetItemCodeInfo(g_szCd, "ovsnation")	' 국가구분코드
			g_szMk = Form.GetItemCodeInfo(g_szCd, "exchid")		' 거래소벤더코드
		end if

		
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if
	' ----------------------------------------------------------------------
	' 계좌변경시 초기화
	' ----------------------------------------------------------------------	
	elseif sEventName == "ChangeAcnt" then
		'20211012 HSZ 통합증거금
'		DATAMANAGER.RequestTranData("obpds_srvc_323r")
'		DATAMANAGER.RequestTranData("obrtp_drab_001r")
		call Check_AcntLst()
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if
			
	' 20171127 HAMWG END	
	' ----------------------------------------------------------------------
	' 자동가격입력
	' ----------------------------------------------------------------------		
	elseif sEventName == "AUTO_PRICE" then
		Dim szPrc
		
		'20170919 HAMWG START : 탭/종목 변경시 초기화 여부
		if g_szChangeInit <> "1" then		
			if Trim(sParam) <> "" then
				edtPrc.caption = sParam
				edtPrc_OnEditComplete()
			end if
			
			Return_AutoQty()
		else
			Init_InputControl()
		end if
		'20170919 HAMWG END
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' 20181022 HWG START : 해외주식 주문착오 방지
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	
	' 20181022 HWG END
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	' ----------------------------------------------------------------------
	' 수량/금액입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		edtQty_OnEditComplete()
		
		'20160829_01 LKM START
		 btnCash.btnimage = "btn_02.9.png"
		 btnMax.btnimage  = "btn_02.9.png"
		 Form.SetSharedData("B_QTY_TYPE" , "2")
		'20160829_01 LKM END		
	'----------------------------------------------------------------------
	' 20210329 LES START 통합증거금 - 수량조회팝업 리턴
	'----------------------------------------------------------------------
	elseif sKeyName == "16060_p8" then
		edtQty.caption = sRet
		edtQty_OnEditComplete()
	' ----------------------------------------------------------------------
	' 가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
'			szPrc = CLng(sRet)
'			szMod = szPrc Mod 1000
'			lngAblePrc = CLng(TblAbleprc.GetCellString(0, 1))
'			if CInt(szMod) > 0 then
'				szPrc = szPrc-szMod
'				LblAlert.caption = "천원이상, 천원단위로만 신청 가능합니다."
'			elseif lngAblePrc < CLng(szPrc) then
'				LblAlert.caption = "주문가능금액을 확인해주세요"
'			else
'				LblAlert.caption = ""
'			end if
'			
'			LblPrcin.caption = szPrc
			ImgPrcreset.visible = true
			g_szPopPrc = sRet
			call LblPrcin_OnClick()
		else
			ImgPrcreset.visible = false
			LblQty.caption = ""
			LblAlert.caption = ""
			BtnPrcin.caption = "매수금액을 입력해주세요"
		end if
	end if
End Sub
'============================================================================
' 해외주식시장거래구분코드
'============================================================================
Function Get_OvrsStckMrktClsCode(sTemp)
    Select Case sTemp
	    Case "NY", "AX", "OQ"
		    return "01" '미국
		Case "HK"
		    return "02" '홍콩
		Case "SH"
		    return "03" '상해
		Case "SZ"
		    return "04" '심천
		Case "JP"
		    return "05" '일본
    End Select

End Function
'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	g_szPrc = LblPrcin.caption
	if Trim(g_szPrc) == "" then
		g_szPrc = 0
	end if
	
	' ----------------------------------------------------------------------
	' 해외주식 매수주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtro_oder_801a" then
		g_szTR = szTranID
		sCodeData = Split(g_szCd, "@")
		DATAMANAGER.ClearInputData(0, "obtro_oder_801a")

		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "ACNO"				, 0, Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "ASNO"				, 0, Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "ACNT_PWD"			, 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때	
		else	
			DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "ACNT_PWD"			, 0, Form.GetTopCtlProp("edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "OVRS_STCK_SYMB_ISCD"	, 0, sCodeData[1])							' 종목코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "OVRS_EXCH_VNDR_IDNO"	, 0, g_szMk)									' 거래소코드
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "SELN_BYOV_CLCD"		, 0, "2")									' 매도/매수구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "ODER_CLS_CODE"		, 0, "01")									' 주문구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, "0")									' 주문조건구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "ALAT_RTRN_YN"		, 0, "N")									' 전액반환여부
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "ODER_AMT"			, 0, g_szPrc)									' 주문금액
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01")									' 주문발생유형코드(01:일반주문)
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag)							' 경고확인여부	' 20181022 HWG : 해외주식 주문착오 방지
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "PROS_SRNO"			, 0, "")										' 처리일련번호
	
	'----------------------------------------------------------------------
	' 소수점 주문가능 금액
	'----------------------------------------------------------------------
	elseif szTranID == "obrtp_drab_001r" then
		TblAbleprc.SetCellString(0, 1, "")
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "ACNO" , 0 , Form.GetTopCtlProp("acnt", "total") ) ' 계좌번호
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "ASNO" , 0 , Form.GetTopCtlProp("acnt", "sequence") ) ' 계좌일련번호
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "PROS_DATE" , 0 , Form.GetSharedData("&HOST_DATE", false) ) ' 처리일자
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "SMCD" , 0 , "001020" ) ' 적요코드
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "SUMR_DRNG_YN" , 0 , "" ) ' 적요출금여부
	'----------------------------------------------------------------------
	' 소수점 주문수량 조회
	'----------------------------------------------------------------------
	elseif szTranID == "obtro_oder_803r" then
		LblQty.caption = ""
		LblAlert.caption = ""
		'종목코드 (주문가능수량 조회 inblock 세팅용)
		stmpCode = sCodeData[1]&"."&sCodeData[0]
		szMediaType =  Trim(Form.GetSharedData("&MEDIA_CODE", 0))	
		DATAMANAGER.SetDataValue( 0, "obtro_oder_803r", "InBlock1", "ACNO" , 0 , Form.GetTopCtlProp("acnt", "total") ) ' 계좌번호
		DATAMANAGER.SetDataValue( 0, "obtro_oder_803r", "InBlock1", "ASNO" , 0 , Form.GetTopCtlProp("acnt", "sequence") ) ' 계좌일련번호
		DATAMANAGER.SetDataValue( 0, "obtro_oder_803r", "InBlock1", "ODER_DATE" , 0 , Form.GetSharedData("&HOST_DATE", false) ) ' 처리일자
		DATAMANAGER.SetDataValue( 0, "obtro_oder_803r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , Get_OvrsStckMrktClsCode(sCodeData[0]) ) 
		DATAMANAGER.SetDataValue( 0, "obtro_oder_803r", "InBlock1", "SELN_BYOV_CLCD" , 0 , "2" ) '주문구분코드
		DATAMANAGER.SetDataValue( 0, "obtro_oder_803r", "InBlock1", "ALAT_RTRN_YN" , 0 , "N" ) '전량여부
		DATAMANAGER.SetDataValue( 0, "obtro_oder_803r", "InBlock1", "CHAN_TYPE_CLS_CODE" , 0 , szMediaType ) 
		DATAMANAGER.SetDataValue( 0, "obtro_oder_803r", "InBlock1", "ODER_AMT" , 0 , g_szPrc ) 
		DATAMANAGER.SetDataValue( 0, "obtro_oder_803r", "InBlock1", "ISCD" , 0 , stmpCode ) 
	end if

End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szWarnMsg, szOrdCd, szOrdMsg, szOrgNo

	' ----------------------------------------------------------------------
	' 해외주식 매수주문
	' ----------------------------------------------------------------------	
	Select Case szTranID		
		Case "obtro_oder_801a"	
			' 20181022 HWG START : 해외주식 주문착오 방지
			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
			
			if szWarnCd = "1" then							' 경고
				Open_ConfirmPopup(szWarnMsg)
			elseif szWarnCd = "2" then						' 보류(해외주식 제외)
				g_szTR = ""
				'Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
			else
				g_szTR = ""
				
				szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
				szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
	
				if Trim(szOrdCd) == "0001" then			' 정상주문
'					Form.Toast(0, szOrdMsg, true)
					
					if g_szAfterInit == "1" then		' 주문후 초기화
						Init_InputControl()
					end if
					
					if g_szAfterOrg == "1" then			' 주문번호 연동
						szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
						Form.triggerEvent("#", "AfterOrd", szOrgNo)
					end if
					Form.OpenPopup("mhtro16090_p3" , g_szOrdData , "")
					Request_Able()
				end if
			end if
			' 20181022 HWG END
		Case "obtro_oder_803r"
			g_szQty		=  DATAMANAGER.GetDataValue( 0, "obtro_oder_803r", "OutBlock1", "DQTY" 	, 0 )	' 소수점수량
			LblQty.caption = g_szQty
			if g_lngAblePrc < CLng(g_szPrc) then
				LblAlert.caption = "주문가능금액을 확인해주세요"
			end if
	End Select	
	
	g_szWarnFlag = "N"	' 20181022 HWG : 해외주식 주문착오 방지
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	if szTranID = "obtro_oder_803r" then 
		LblAlert.caption = szErrMsg
	else
		szSubMsg = Trim(szSubMsg)
		if Len(szSubMsg) > 1 then
			Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szTitle, szErrMsg)
		end if
	end if
	

End Sub

'============================================================================
' btnOrdBal_OnClick : 주문관련비용 계산
'============================================================================
Sub btnOrdBal_OnClick()
	
	'계좌번호
	szAcnt   = Form.GetTopCtlProp("acnt", "total")
	szAcntCd = Form.GetTopCtlProp("acnt", "sequence")
	
	if Check_InputData(2) == false then
		Exit Sub
	end if
	
	szPrice = edtPrc.caption
	    
	if edtPrc.caption = "0" or edtPrc.caption = "" then
		Form.ShowAlert(g_szTitle, "주문가격을 입력하세요")
		exit Sub
	end if	    
	
	' 계좌번호|계좌일련번호|종목코드|거래소벤더코드|매매구분(1매도, 2매수)|주문수량|주문단가|소숫점자릿수
	szData = szAcnt & "★" & szAcntCd & "★" & g_szCd & "★" & g_szMk & "★" & "2" & "★" & edtQty.caption & "★" & szPrice & "★" & g_szDecimal
	Form.OpenPopup("mhtro16060_pa" , szData , "")
End Sub

