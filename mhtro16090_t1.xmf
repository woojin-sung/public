''============================================================================
Sub Check_AcntLst()
	Dim szAcnt

	szAcnt = Form.GetTopCtlProp("acnt", "caption")
	If Len(szAcnt) < 10 Then
	else
		DATAMANAGER.RequestTranData("obrtp_drab_001r")
	End If
	
End Sub 
