'============================================================================
' btnBack_OnClick
'============================================================================
Sub btnBack_OnClick()
	Dim nLen
	nLen = Len(edtAmt.caption)

	if nLen <> 0 then
		szAmt = Left(edtAmt.caption, nLen-1)
		edtAmt.caption = szAmt
	end if
End Sub

'============================================================================
' btnClear_OnClick
'============================================================================
Sub btnClear_OnClick()
	edtAmt.caption = ""
End Sub

'============================================================================
' btnCancel_OnClick
'============================================================================


'============================================================================
' btnConfirm_OnClick
'============================================================================
Sub btnConfirm_OnClick()
	Form.triggerEvent("#", "RETURN_QTY", edtQty.caption)
End Sub


'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue(0, "obtrs_comn_407r", "InBlock1", "ACNO",          0, g_szAcnt)
	DATAMANAGER.SetDataValue(0, "obtrs_comn_407r", "InBlock1", "ASNO",          0, g_szAcntNo)
	'DATAMANAGER.SetDataValue(0, "obtrs_comn_407r", "InBlock1", "ACNT_PWD",      0, g_szPwd)
	DATAMANAGER.SetDataValue(0, "obtrs_comn_407r", "InBlock1", "ISCD",          0, g_szCd)
	DATAMANAGER.SetDataValue(0, "obtrs_comn_407r", "InBlock1", "ODER_UNPR",     0, edtPrc.caption)
	DATAMANAGER.SetDataValue(0, "obtrs_comn_407r", "InBlock1", "ODER_CLS_CODE", 0, g_szType)
	DATAMANAGER.SetDataValue(0, "obtrs_comn_407r", "InBlock1", "DEAL_CLS_CODE", 0, g_szGbn)
	DATAMANAGER.SetDataValue(0, "obtrs_comn_407r", "InBlock1", "IQRY_CLS_CODE", 0, g_szIqry)
	DATAMANAGER.SetDataValue(0, "obtrs_comn_407r", "InBlock1", "STND_AMT",      0, edtAmt.caption)
End Sub

