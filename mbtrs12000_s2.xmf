'============================================================================
' 화 면 명 : 주식주문_금액입력창
' 화면설명 : 주식주문 금액입력시
' 작    성 : 2016.02.15 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntNo, g_szPwd, g_szCd, g_szType, g_szGbn, g_szIqry


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
' Calc_Amt : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Amt(nGbn)
	Dim szAmt, nUnit, szCalc, szUnit
	
	szAmt = edtAmt.caption

	
	if Trim(szAmt) == "" then
		szAmt = 1
	else
		if Len(szAmt) = 1 or Len(szAmt) = 2 then
			nUnit = 1
		else
			nCnt = Len(szAmt)-1
			
			For i = 0 to nCnt-1
				if i == 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CDbl(szUnit)
		end if
		
		if nGbn == 0 then
			szAmt = CDbl(szAmt) + nUnit
		elseif nGbn == 1 then
			if CDbl(szAmt) == 0 then
				Exit Function
			else
				szAmt = CDbl(szAmt) - nUnit
			end if
		end if
	end if
	
	Sum_Amt(szAmt)
End Function

'============================================================================
' Calc_Plus
'============================================================================
Function Calc_Plus(nGbn, nPlus)
	Dim szAmt
	szAmt = edtAmt.caption
	
	if nGbn == 1 then
		if Trim(szAmt) == "" then
			szAmt = 0
		end if
		
		szAmt = CDbl(szAmt) + nPlus
	else
		szAmt = szAmt & nPlus
	end if
	
	Sum_Amt(szAmt)
End Function

'============================================================================
' Calc_Zero
'============================================================================
Function Calc_Zero(szPlus)
	Dim szAmt
	szAmt = edtAmt.caption
	
	if Len(edtAmt.caption) > 0 then
		szAmt = edtAmt.caption & szPlus
		
		Sum_Amt(szAmt)
	end if
End Function

'============================================================================
' Sum_Qty
'============================================================================
Function Sum_Amt(szData)
	if Len(szData) < 16 then
		edtAmt.caption = szData
	end if
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szType
	
	szType = Trim(Form.GetCtlProp("#edtType", "caption"))
	
	if szType == "0" then
		lblPrc.caption = "매수희망가격"
		lblAmt.caption = "매수금액"
		lblQty.caption = "매수수량"
	elseif szType == "1" then
		lblPrc.caption = "매도희망가격"
		lblAmt.caption = "매도금액"
		lblQty.caption = "매도수량"
	end if
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INIT" then
		if Trim(sParam) <> "" then
			tData = Split(sParam, "♥")
			
			g_szAcnt   = tData(1)
			g_szAcntNo = tData(2)
			g_szPwd    = tData(3)		' 받지 않아도 됨
			g_szCd     = tData(4)
			g_szType   = tData(5)
			
			Select Case g_szType
				Case "05", "12", "13", "61", "71"
					edtPrc.caption = "0"
				Case Else
					edtPrc.caption = tData(0)
			End Select
			
			g_szGbn    = tData(6)
			g_szIqry   = tData(7)
		end if
	end if
End Sub

'============================================================================
' btnQPlus_OnClick : 수량 + 버튼
'============================================================================
Sub btnQPlus_OnClick()	
	Calc_Amt(0)
End Sub

'============================================================================
' btnQMinus_OnClick : 수량 - 버튼
'============================================================================
Sub btnQMinus_OnClick()
	Calc_Amt(1)
End Sub

