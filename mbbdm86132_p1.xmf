	<CONTROL_INFO>
		<IMAGE name="imgBg" autosize="1" imgpath="alpha" ly_vert="0,0,375,647,1" />
		<IMAGE name="imgMbg" imgpath="popup_bg.9" ly_vert="0,285,375,333,1" />
		<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="목표시장 비교 결과 안내" halign="1" ly_vert="52,306,275,32,1" />
		<IMAGE name="imgState" autosize="1" imgpath="icon_error" ly_vert="153,345,70,70,1" />
		<BUTTON name="btnNoNext" caption="확인하고
계속 진행하기" fontsize="2" btnimage="btn_20.9" ly_vert="187,597,188,50,1" />
		<BUTTON name="btnNoCancel" caption="중단하기" fgcolor="004:000000000" fontsize="2" btnimage="btn_27.9" ly_vert="0,597,187,50,1" />
		<LABEL name="lblState" fontstyle="01" mask="1,0,“,”,1,,0,1,1,0,0" halign="2" ly_vert="126,280,65,20,1" />
		<BUTTON name="btnNext" caption="확인" fontsize="2" btnimage="btn_20.9" ly_vert="0,597,375,50,1" />
		<LABEL name="lblText" fontsize="2" caption="해당 상품의 판매 목표시장과
″일치″ 합니다." halign="1" multiline="1" ly_vert="20,429,335,60,1" />
		<LABEL name="lblDetail" fontsize="-1" caption="판매 목표시장 불일치 고객님의 경우
″목표시장 외″ 로 투자가 가능합니다.
다만, 이 경우 투자에 더욱 신중히 
판단하시기 바랍니다." halign="1" multiline="1" ly_vert="20,488,335,75,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="3641" _ulen="3397" >
'============================================================================
' 2021-07-14 KSJ : 목표시장 불일치 안내 팝업
'============================================================================

'전역변수 설정
Dim g_szRet				' Return 값

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
'Form_OnFormInit()  
'============================================================================
Sub Form_OnFormInit()
	g_szRet = "no"
	
	Dim szOsType
	szOsType = Form.GetSharedData("&OS_TYPE", false)
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	'szOpenData = "Y"
	If szOpenData ~= null and szOpenData ~= "" Then
		'일치
		if szOpenData == "N" then
			imgState.imgpath = "icon_ok.png"
			
			lblText.caption = "해당 상품의 판매 목표시장과\n″일치″ 합니다."
			lblText.changeTextAttr(16, 4, 7, 2, true)
			
			btnNext.visible = true
			btnNoNext.visible = false
			btnNoCancel.visible = false
			
			lblDetail.visible = false
			
			'공백 없애기 위해 위치 조정
			imgMbg.top = 285 + 65
			lblTitle.top = 306 + 65
			imgState.top = 345 + 65
			lblText.top = 429 + 65
			
		'불일치 
		else
			imgState.imgpath = "icon_error.png"	
			
			lblText.caption = "해당 상품의 판매 목표시장과\n″불일치″ 합니다."
			lblText.changeTextAttr(16, 5, 6, 2, true)
			
			btnNext.visible = false
			btnNoNext.visible = true
			btnNoCancel.visible = true
			
			lblDetail.visible = true
			
			'os별로 범위 계산이 다른가?
			if szOsType == "1" then
				lblDetail.changeTextAttr(20, 8, 6, -1, false)			
				lblDetail.changeTextAttr(50, 24, 6, -1, false)
			else
				lblDetail.changeTextAttr(20, 9, 6, -1, false)			
				lblDetail.changeTextAttr(53, 24, 6, -1, false)
			end if
		end if
	End If
End Sub
'============================================================================
'Form_OnFormBackKeyPressed() : 닫기 
'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
	Form.CloseForm()
End Sub

'============================================================================
' imgBg_OnClick() : 닫기
'============================================================================
'Sub imgBg_OnClick()
'	Form.CloseForm()
'End Sub

'============================================================================
' btnNoCancel_OnClick() : 목표시장 불일치 > 중단하기
'============================================================================
Sub btnNoCancel_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
' btnNoNext_OnClick() : 목표시장 불일치 > 진행하기
'============================================================================
Sub btnNoNext_OnClick()
	g_szRet = "ok"
	Form.CloseForm()
End Sub
'============================================================================
' btnNext_OnClick() : 목표시장 일치 
'============================================================================
Sub btnNext_OnClick()
	g_szRet = "ok"
	Form.CloseForm()	
End Sub

'============================================================================
' Form_OnFormClose()
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbbdm86132_p1" , g_szRet)
End Sub



	</SCRIPT_INFO>
