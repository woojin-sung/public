	<SCRIPT_INFO _len="519" _ulen="519" >
'============================================================================
Sub Form_OnFormInit()
	sDeviceID = Form.GetOpenLinkData( )
	szData = Split(sDeviceID, "-")
	nRowIdx = 0
	
	for i = 0 to CInt(UBOUND(szData))
		sItem = Trim(szData(i))
		if Len(sItem) > 0 then
		
			Container0.Table0.SetCellString(nRowIdx, 0, sItem)
			nRowIdx = nRowIdx + 1
		
		end if
	
	next
	
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

