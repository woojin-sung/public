	<CONTROL_INFO>
		<FORMTAB name="fmtab" tabcount="2" tabwidthtype="1" tabheadheight="36" ly_vert="0,0,375,562,1" >
			<PAGE name="page0" caption="품목별" linkfile="mhtrd44200_t1" loadingtype="1" />
			<PAGE name="page1" caption="거래소별" linkfile="mhtrd44201" loadingtype="1" />
		</FORMTAB>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1320" _ulen="1294" >

'============================================================================
Sub Form_OnFormInit()
	Dim szScreenNo, szTab
	
	szScreenNo = Form.GetSharedData( "&SCREEN_NO", false )
	
	if szScreenNo = "44200" then
		szTab = "0"
	elseif szScreenNo = "44201" then
		szTab = "1"
	end if
	
	fmtab.currenttab = szTab
End Sub


'============================================================================
Sub fmtab_OnTabChanged(nCurrentTab)
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "SCREEN_MENU" Then							' 연결정보(상단 ...)
		If sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns1" , "0", "")
		End If
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else
			Form.triggerEvent("linkfmHoga", "sharedata", "")
		End If

	End If
End Sub

	</SCRIPT_INFO>
