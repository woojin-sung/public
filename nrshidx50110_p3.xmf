End Function

'===============================================
' 배열 -> 문자열 변환
'===============================================
Function Convert_ArrToString(arrData, szSeperator)
	szResult = ""
	
	if arrData = null then
		return szResult
	end if
	
	if szSeperator = null or szSeperator = "" then
		return szResult
	end if 	
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if i <> 0 then
			szResult = szResult & szSeperator 
		end if
		
		szResult = szResult & arrData(i) 
	next
	
	return szResult
End Function

'===============================================
' 배열 -> 문자열 변환(체크항목)
'===============================================
Function Convert_ChkArrToString(arrData, arrChkData, szSeperator)
	szResult = ""
	
	if arrData = null then
		return szResult
	end if
	
	if arrChkData = null then
		return szResult
	end if
	
	if szSeperator = null or szSeperator = "" then
		return szResult
	end if 	
	
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if arrChkData(i) = "1" then
			if szResult <> "" then
				szResult = szResult & szSeperator 
			end if
			szResult = szResult & arrData(i) 
		end if
	next
	
	return szResult
End Function

'===============================================
' 문자열 -> 배열 변환
'===============================================
Function Convert_StringToArr(szData, szSeperator)
	szArrData = ""
	
	if szData <> null and szData <> "" then
		szArrData = split(szData, szSeperator)
	end if
	
	return szArrData
End Function

'===============================================
' 배열 데이터 확인
'===============================================
Function Contains_Array(arrData, szData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		szArrData = arrData(i)
		
		if szArrData = szData then
			return true
		end if
	next 
	
	return false
End Function

'===============================================
' 체크배열 초기화
'===============================================
Function Clear_ChkArray(arrData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		arrData(i) = "0"	
	next 
End Function

'===============================================
' 체크배열 전체선택
'===============================================
Function All_ChkArray(arrData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		arrData(i) = "1"	
	next 
End Function

'===============================================
' 배열 인덱스 추출
'===============================================
Function Return_ArrayIndex(arrData, szData)
	nReturn = -1
	if arrData = null or arrData = "" then
		return nReturn
	end if
	
	if szData = null or szData = "" then
		return nReturn
	end if
	
	nArrCnt = #arrData
	for i = 0 to nArrCnt-1
		if arrData(i) = szData then
			nReturn = i
			exit for
		end if	
	next 
	
	return nReturn
End Function

Function Return_AllChkYN(arrData)
	if arrData = null or arrData = "" then
		return "N"
	end if
	
	nArrCnt = #arrData
	for i = 0 to nArrCnt-1
		if i = 0 then
			if arrData(0) = "1" then
				return "Y"
			end if
		else
			if arrData(i) = "0" then
				return "N"
			end if	
		end if
	next 
	
	return "Y"
End Function

'
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	
	Init_Control()

	szData = Form.GetOpenLinkData()
	
	if szData = null or trim(szData) = "" then
		exit Sub
	end if
	
	szArrData = split(szData, "★")
	
	nArrCnt = #szArrData
	
	if nArrCnt > 4 then
		g_szLinkGbn 	= szArrData(0)
		g_szGbn		= szArrData(1)
		g_szDupSel 	= szArrData(2)
		
		Dim szContData, szChkKey, szTempData, szArrTempData, szDisable
		szContData 	= szArrData(3)
		szTempData 	= szArrData(4)
		if nArrCnt > 5 then
			if szArrData(5) <> "" and szArrData(5) <> null then
				szDisable 	= szArrData(5)
				contBg.lblSubTitle.caption = szDisable
				contBg.btnOk.caption = "확인"
				contBg.btnCancel.visible = false
				contBg.btnOk.left = -1
				contBg.btnOk.width = 377
				g_isDisable = true
			end if
		end if
		
		if g_szLinkGbn = "DomesticOperator" or g_szLinkGbn = "OverseaOperator" then
			g_nSelMaxCnt = 5
		end if
		
		if g_szDupSel = "1" then
			szContData = "전체`" & szContData
		end if
		
		g_arrContent = Convert_StringToArr(szContData, "`")
		szArrTempData = Convert_StringToArr(szTempData, "`")
		
		nArrCnt = #g_arrContent
		nChkArrCnt = #szArrTempData
		g_arrContent_Check = {}
		
		for i = 0 to nArrCnt-1
			g_arrContent_Check(i) = "0"
			if nChkArrCnt = 0 and g_szDupSel = "1" then
				g_arrContent_Check(0) = "1"
			else
				for j = 0 to nChkArrCnt-1
					if g_arrContent(i) = szArrTempData(j) then
						g_arrContent_Check(i) = "1"
						g_nSelCnt = g_nSelCnt + 1
					end if
				next
			end if
		next
		
		szReturn = Return_AllChkYN(g_arrContent_Check)
		if szReturn = "Y" and g_szDupSel = "1" then
			All_Content(g_szGbn, g_szDupSel)
		end if
	end if
	
	Init_Content(g_szGbn)
	DisplaySetting_Content(g_szGbn)
End Sub

