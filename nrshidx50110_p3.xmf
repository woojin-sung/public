	end if
	DisplaySetting_PannelList(nIndex, sCellID)
End Sub

'============================================================================
Sub contBg_btnOk_OnClick()
	Form.SendReturnToParent("50110_P3_RETURN_DATA_"&g_szLinkGbn, Convert_ChkArrToString(g_arrContent, g_arrContent_Check, "`"))
	Form.CloseForm()
End Sub

'============================================================================
Sub contBg_btnCancel_OnClick()
	if g_isDisable = false then
		Clear_Content(g_szGbn)
	end if
End Sub

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

