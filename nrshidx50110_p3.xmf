Sub contBtn_Pannel0_OnClick(nIndex, sCellID)
	if sCellID = "" then
		Exit Sub
	end if
	DisplaySetting_PannelBtn(nIndex, sCellID)
End Sub

'============================================================================
Sub contList_Pannel1_OnClick(nIndex, sCellID)
	if sCellID = "" then
