		Image3.visible = true
		Image3.imgpath = "btn_line_o.9"
		Image4.visible = true

		if Cint(szAppVer) > 2547 then
			
			'-----------------------------------------------------------------------
			' 적용가능 버전
			'-----------------------------------------------------------------------
			g_bApplyVersion = true
			
			Label0.caption = "매매내역"
			g_sChartPopup = "mhcht13000_p6"
			Form.SetTimerEvent2("2", 1, 0.2)
		else
