'============================================================================
'20231016 LES START
'============================================================================
Function Change_Use_AvgBuyPrice()

	gUseAvgBuyPrice = Form.LoadConfigData("CHART_AVGBUY_PRICE".."_"..g_sUserID, "USE")

	if gUseAvgBuyPrice == "1" then
		
		gUseAvgBuyPrice = "0"
		Form.SaveConfigData("CHART_AVGBUY_PRICE".."_"..g_sUserID, "USE", "0")
		
	
	else
	
		gUseAvgBuyPrice = "1"
		Form.SaveConfigData("CHART_AVGBUY_PRICE".."_"..g_sUserID, "USE", "1")
		Image5.imgpath = "btn_switch_o"
	
	end if
	
	Apply_Use_AvgBuyPrice()

End Function
'============================================================================
'20231016 LES END
'============================================================================

'============================================================================
'20231016 LES START
'============================================================================
Function Apply_Use_AvgBuyPrice()

	'로그인 여부 체크
	Dim sLOGIN_TYPE  
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
	
	g_sUserID = Form.GetSharedData("&USER_ID", false)		'20240610 SWJ START
		
	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
	else
		Image5.imgpath = "btn_switch_n"
		ChartEx0.SetAvgBuyPrice(g_szItemCode..";".."0")
		Exit Function
	end if

	gUseAvgBuyPrice = Form.LoadConfigData("CHART_AVGBUY_PRICE".."_"..g_sUserID, "USE")	'20240610 SWJ START
	
	if gUseAvgBuyPrice == "1" then
		
		Image5.imgpath = "btn_switch_o"
		sSettingAcnt = Form.LoadConfigData("CHART_AVGBUY_PRICE".."_"..g_sUserID, "ACNT")	'20240610 SWJ START
		
		if sSettingAcnt <> "" then
		
			szAcno = Left(sSettingAcnt,8)
			szAsno = Right(sSettingAcnt,2)
			szItemCode = Change_ItemCode()
			
			DATAMANAGER.SetDataValue(0, "obtrs_comn_430r", "InBlock1", "ACNO" , 0 , szAcno)
			DATAMANAGER.SetDataValue(0, "obtrs_comn_430r", "InBlock1", "ASNO" , 0 , szAsno)
			DATAMANAGER.SetDataValue(0, "obtrs_comn_430r", "InBlock1", "ISCD" , 0 , szItemCode)
			
			DATAMANAGER.RequestTranData("obtrs_comn_430r")
		
		end if
		
	else
		
		'초기화
		Image5.imgpath = "btn_switch_n"
		ChartEx0.SetAvgBuyPrice(g_szItemCode..";".."0")
		
	end if
	
End Function
'============================================================================
'20231016 LES END
'============================================================================

'============================================================================
'20240610 SWJ START
'============================================================================
Function Change_Use_OrderList()

	gUseOrderList = Form.LoadConfigData("CHART_ORDER_LIST".."_"..g_sUserID, "USE")

	if gUseOrderList == "1" then
		
		gUseOrderList = "0"
		Form.SaveConfigData("CHART_ORDER_LIST".."_"..g_sUserID, "USE", "0")
		
	
	else
	
		gUseOrderList = "1"
		Form.SaveConfigData("CHART_ORDER_LIST".."_"..g_sUserID, "USE", "1")
		Image5.imgpath = "btn_switch_o"
	
	end if
	
	Apply_Use_OrderList()

End Function
'============================================================================
Function Apply_Use_OrderList()
	'로그인 여부 체크
	Dim sLOGIN_TYPE  
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
	
	g_sUserID = Form.GetSharedData("&USER_ID", false)
	
	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
	else
		Image5.imgpath = "btn_switch_n"
		ChartEx0.SetTradeData("")
		Exit Function
	end if

	gUseOrderList = Form.LoadConfigData("CHART_ORDER_LIST".."_"..g_sUserID, "USE")
	
	if gUseOrderList == "1" then
		
		Image5.imgpath = "btn_switch_o"
		sSettingAcnt = Form.LoadConfigData("CHART_ORDER_LIST".."_"..g_sUserID, "ACNT")
		
		if sSettingAcnt <> "" then
		
			szAcno = Left(sSettingAcnt,8)
			szAsno = Right(sSettingAcnt,2)
			szItemCode = Change_ItemCode()

			if Cint(RadioGroup0.currentindex) == 0 then
				gChartPeriod = "D"
				
			elseif Cint(RadioGroup0.currentindex) == 2 then
				
				szTempMin = split(RadioGroup0.GetRadioCaption(2), "분")
				
				if Ubound(szTempMin) > 0 then
					if szTempMin(0) == "1" then
						gChartPeriod = "1"
					elseif szTempMin(0) == "3" then
						gChartPeriod = "3"
					elseif szTempMin(0) == "5" then
						gChartPeriod = "5"
					elseif szTempMin(0) == "10" then
						gChartPeriod = "T"
					else
						exit function
					end if
				end if
			
			else
				exit function
			end if
			
			DATAMANAGER.SetDataValue(0, "obtrs_cntg_711r", "InBlock1", "IQRY_COND_CODE" , 0 , gChartPeriod)
			DATAMANAGER.SetDataValue(0, "obtrs_cntg_711r", "InBlock1", "ACNO" , 0 , szAcno)
			DATAMANAGER.SetDataValue(0, "obtrs_cntg_711r", "InBlock1", "ASNO" , 0 , szAsno)
			DATAMANAGER.SetDataValue(0, "obtrs_cntg_711r", "InBlock1", "ISCD" , 0 , szItemCode)
			DATAMANAGER.RequestTranData("obtrs_cntg_711r")
		
		end if
		
	else
		
		'초기화
		Image5.imgpath = "btn_switch_n"
		ChartEx0.SetTradeData("")
		
	end if
End Function

'============================================================================
'20231016 LES START
'============================================================================
Sub Image4_OnClick()
	
	'20240610 SWJ START : gUseAvgBuyPrice 분기 밖 다 수정
	'매매내역 추가
	sLineSetting = Form.LoadConfigData( "CHART_USE_LINE".."_"..g_sUserID,"USE")
	
	if sLineSetting == "AvgBuyPrice" then
		
		gUseAvgBuyPrice = Form.LoadConfigData("CHART_AVGBUY_PRICE".."_"..g_sUserID, "USE")
		
		if gUseAvgBuyPrice == "1" then
		
			'로그인 여부 체크
			Dim sLOGIN_TYPE  
			sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
			
			if CInt(sLOGIN_TYPE) > 1 then '로그인상태
				Change_Use_AvgBuyPrice()
			else
				Form.OpenScreen("90020" , "90022")
				Exit Sub 
			end if
		
		else
			LoginCheck_PopupSetting()
		end if
		
		
	elseif sLineSetting == "OrderList" then
		
		gUseOrderList = Form.LoadConfigData("CHART_ORDER_LIST".."_"..g_sUserID, "USE")

		if gUseOrderList == "1" then
		
			'로그인 여부 체크
			Dim sLOGIN_TYPE  
			sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
			
			if CInt(sLOGIN_TYPE) > 1 then '로그인상태
				Change_Use_OrderList()
			else
				Form.OpenScreen("90020" , "90022")
				Exit Sub 
			end if
		else
			
			LoginCheck_PopupSetting()
			
		end if
	
	'둘 다
	elseif sLineSetting == "Both" then
	
		gUseAvgBuyPrice = Form.LoadConfigData("CHART_AVGBUY_PRICE".."_"..g_sUserID, "USE")
		gUseOrderList = Form.LoadConfigData("CHART_ORDER_LIST".."_"..g_sUserID, "USE")
		
		if gUseAvgBuyPrice == "1" then
		
			'로그인 여부 체크
			Dim sLOGIN_TYPE  
			sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
			
			if CInt(sLOGIN_TYPE) > 1 then '로그인상태
				Change_Use_AvgBuyPrice()
			else
				Form.OpenScreen("90020" , "90022")
				Exit Sub 
			end if
			
		end if
		
		if gUseOrderList == "1" then
		
			'로그인 여부 체크
			Dim sLOGIN_TYPE  
			sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
			
			if CInt(sLOGIN_TYPE) > 1 then '로그인상태
				Change_Use_OrderList()
			else
				Form.OpenScreen("90020" , "90022")
				Exit Sub 
			end if
			
			exit sub
		end if

		LoginCheck_PopupSetting()
		
	else
	
		LoginCheck_PopupSetting()
			
	end if
	'20240610 SWJ END
	
End Sub
'============================================================================
'20231016 LES END
'============================================================================

'============================================================================
' 20231016 LES START
'============================================================================
Function Change_ItemCode()
	Dim szMk
	
	szMk = Form.GetItemCodeInfo(g_szItemCode, "market")

	if Left(g_szItemCode, 1) = "J" or Left(g_szItemCode, 1) = "F" then
		return g_szItemCode
	elseif szMk = "J" or szMk = "T" then	'주식
		return "A" & g_szItemCode
	elseif szMk = "W" then	'ELW
		return "J" & g_szItemCode
	else
		return g_szItemCode
	end if 
End Function

'============================================================================
' 20240610 SWJ START
'============================================================================
Function Chart_UseWhatLine()
	sLineSetting = Form.LoadConfigData( "CHART_USE_LINE".."_"..g_sUserID,"USE")
	
	g_sUserID = Form.GetSharedData("&USER_ID", false)	
	
	if sLineSetting == "AvgBuyPrice" then
		Apply_Use_AvgBuyPrice()
	elseif sLineSetting == "OrderList" then
		Apply_Use_OrderList()
		
	elseif sLineSetting == "Both" then
		Apply_Use_OrderList()
		Apply_Use_AvgBuyPrice()

	end if
	
	'화면 첫 오픈 여부 판단
	g_sInitFlag = False
End Function
'============================================================================
Function LoginCheck_PopupSetting()
	
	'로그인 여부 체크
	Dim sLOGIN_TYPE  
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
			
	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
	else
		Form.OpenScreen("90020" , "90022")
		Exit Function
	end if
	
	Form.OpenPopupAnimation( g_sChartPopup , "100,102,105,107,108,112,119,131,132,133,138,140,200" , "", "2")

End Function

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	Form.SetTimerEvent2(sTimerID, 0, 0.2)
	
	if Cint(sTimerID) == 1 then
		sLineSetting = Form.LoadConfigData( "CHART_USE_LINE".."_"..g_sUserID,"USE")
	
		if sLineSetting == "OrderList" then
			Apply_Use_OrderList()
		
		elseif sLineSetting == "Both" then
			Apply_Use_OrderList()
		
		end if
	elseif Cint(sTimerID) == 2 then
		Chart_UseWhatLine()
	end if
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtrs_cntg_711r" then
		ChartEx0.setTradeData("")
	end if
End Sub

