Sub Form_OnPopupReturn(sKeyName, sRet)
'20230421 KKM  bottom popup 으로 교체
'	if sKeyName = "Chart_Min" then
'		g_szMinType = sRet
'		RadioGroup0.SetRadioCaption( 2, g_szMinType )
'		tmpMin = split(RadioGroup0.GetRadioCaption(2),"분")
'		g_szMinType = tmpMin[0]
'		PeriodSet(g_szChrtType)
'		
'	elseif sKeyName = "Chart_Tic" then
'		g_szTicType = sRet		
'		RadioGroup0.SetRadioCaption( 3, g_szTicType)
'		tmpTic = split(RadioGroup0.GetRadioCaption(3),"틱")
'		g_szTicType = tmpTic[0]
'		PeriodSet(g_szChrtType)
'		
'	elseif sKeyName == "Chart_WEEK" then	
'		if sRet == "월" then
'			g_szChrtType = "M"
''PENTA13 START => 2019.05.08
'		elseif sRet == "년" then
'			g_szChrtType = "Y"
''PENTA13 END
'		else
'			g_szChrtType = "W"
'		end if
'		
'		RadioGroup0.SetRadioCaption( 1, sRet )
'		PeriodSet(g_szChrtType)
'
'	end if
	
	'20231016 LES START
	if sKeyName = "AvgBuyPrice_Accnt_Select" then
		Form.SaveConfigData("CHART_USE_LINE".."_"..g_sUserID, "USE", "AvgBuyPrice")	'20240619 SWJ
		Form.SaveConfigData("CHART_AVGBUY_PRICE".."_"..g_sUserID, "USE", "1")		'20240610 SWJ : 다른 ID일 때 고려
		Form.SaveConfigData("CHART_AVGBUY_PRICE".."_"..g_sUserID, "ACNT", sRet)		'20240610 SWJ : 다른 ID일 때 고려
		Apply_Use_AvgBuyPrice()
	'20231016 LES END
	
	'20240610 SWJ START
	elseif sKeyName = "OrderList_Accnt_Select" then
		
		szData = Split(sRet, "★")
		
		if Ubound(szData) > 0 then
			
			g_sUserID = Form.GetSharedData("&USER_ID", false)
			
			Form.SaveConfigData("CHART_USE_LINE".."_"..g_sUserID, "USE", szData(1))
			
			'매수평균단가
			if szData(1) == "AvgBuyPrice" then
				
				Form.SaveConfigData("CHART_AVGBUY_PRICE".."_"..g_sUserID, "USE", "1")
				Form.SaveConfigData("CHART_AVGBUY_PRICE".."_"..g_sUserID, "ACNT", szData(0))
				Apply_Use_AvgBuyPrice()
		
			'매매내역
			elseif szData(1) == "OrderList" then
				
				Form.SaveConfigData("CHART_ORDER_LIST".."_"..g_sUserID, "USE", "1")
				Form.SaveConfigData("CHART_ORDER_LIST".."_"..g_sUserID, "ACNT", szData(0))
				Apply_Use_OrderList()
			
			'둘 다
			elseif szData(1) == "Both" then
				
				Form.SaveConfigData("CHART_AVGBUY_PRICE".."_"..g_sUserID, "USE", "1")
				Form.SaveConfigData("CHART_ORDER_LIST".."_"..g_sUserID, "USE", "1")
				
				Form.SaveConfigData("CHART_AVGBUY_PRICE".."_"..g_sUserID, "ACNT", szData(0))
				Form.SaveConfigData("CHART_ORDER_LIST".."_"..g_sUserID, "ACNT", szData(0))
				
				Apply_Use_OrderList()
				Apply_Use_AvgBuyPrice()
			end if
		end if
	
	'20240610 SWJ END	
	end if
	'20231016 LES END

End Sub

'======================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'======================================
function ChartEx0_OnGetPeriodInfo()
	Dim sPeriodType
	Dim sMin, sTic
	sPeriodType = ""
	
   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	for i = 0 to 8
		sMin = Form.GetEnvData( "chart_min"..i ) '분차트
		if sMin <> "" then
			if i == 7 then
			    sPeriodType = sPeriodType&sMin&"/"
			else
				sPeriodType = sPeriodType&sMin&";"
			end if
		end if
	next
	
	for i = 0 to 8
		sTic = Form.GetEnvData( "chart_tic"..i ) '분차트
		if sTic <> "" then
			if i == 7 then
			    sPeriodType = sPeriodType&sTic&"/"
			else
			    sPeriodType = sPeriodType&sTic&";"
			end if
		end if
	next
	
	if sPeriodType <> "" then
		ChartEx0.setSyncPeriodValueToChart(sPeriodType)
	end if
end function 
'======================================
 function ChartEx0_OnChangePeriod(sPeriodType)
	 sMinArr = {}
	 sTicArr = {}
	 sDataArr = {}
 
	 g_sIsRequestChartEvent = "1"

   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	if InStr(sPeriodType, "/") > 0 then
	    sTemp = split(sPeriodType, "/")
	    sMinArr = split(sTemp[0], ";")
	    sTicArr = split(sTemp[1], ";")
	    'Form.Log("sPeriodType",sPeriodType)
    
	    for i = 0 to 7 step 1
			Form.SetEnvData( 1, "chart_min"..i, sMinArr[i] )
			Form.SetEnvData( 1, "chart_tic"..i, sTicArr[i] )
	    next
	end if
end function

'======================================
' 차트 설정 개수 변경시
'======================================
function ChartEx0_OnByNumber(Count)
	if #Count = 1 then
		Count = "000"..Count
	   
	elseif #Count = 2 then
		Count = "00"..Count
	   
	elseif #Count = 3 then
		Count = "0"..Count
	   
	end if

	g_sChartCnt = Count
	RequestData()
end function

'======================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'======================================
function PeriodSet(sPeriodType)
	if sPeriodType = "T" then
		g_sPeriod = g_szTicType
		g_sPeriodType = "0"
	   
	elseif sPeriodType = "A" then
		g_sPeriod = CInt(g_szMinType)
		g_sPeriodType = "1"
	   
	elseif sPeriodType = "D" then 
		g_sPeriodType = "2"
		g_sPeriod = "1"
	   
	elseif sPeriodType = "W" then 
		g_sPeriodType = "3"
		g_sPeriod = "1"
	   
	elseif sPeriodType = "M" then 
		g_sPeriodType = "4"
		g_sPeriod = "1"
		
	elseif sPeriodType = "Y" then 		'PENTA13 START => 2019.05.08
		g_sPeriodType = "5"
		g_sPeriod = "1"

	end if
	
	sPeriod = CInt( g_sPeriod )
	if Len(sPeriod) = 1 then
	   g_sPeriod = "00"..g_sPeriod
	   
	elseif Len(sPeriod) = 2 then
	   g_sPeriod = "0"..g_sPeriod
	   
	end if

	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)

	' 조회TR 보내기
	RequestData()	
end function
'============================================================================
'20230905 한국금융IT START : 일주월분 차트 주기 설정
function PeriodSetChart(sPeriodType)
	if sPeriodType = "T" then
		g_sPeriod = g_szTicType
		g_sPeriodType = "0"
	   
	elseif sPeriodType = "A" then
		g_sPeriod = CInt(g_szMinType)
		g_sPeriodType = "1"
	   
	elseif sPeriodType = "D" then 
		g_sPeriodType = "2"
		g_sPeriod = "1"
	   
	elseif sPeriodType = "W" then 
		g_sPeriodType = "3"
		g_sPeriod = "1"
	   
	elseif sPeriodType = "M" then 
		g_sPeriodType = "4"
		g_sPeriod = "1"
		
	elseif sPeriodType = "Y" then
		g_sPeriodType = "5"
		g_sPeriod = "1"

	end if
	
	sPeriod = CInt( g_sPeriod )
	if Len(sPeriod) = 1 then
	   g_sPeriod = "00"..g_sPeriod
	   
	elseif Len(sPeriod) = 2 then
	   g_sPeriod = "0"..g_sPeriod
	   
	end if

	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
end function
'20230905 한국금융IT END : 일주월분 차트 주기 설정
'============================================================================
function ChartEx0_OnRequestData(nIndex, sData)
	if sData = "" or sData = null then
		exit function
	end if
	
	Data = split(sData, ";")
	
   '현재가내의 차트에서는 종목코드를 변경하지 않는다.
	g_szItemCode	= Cstr(Trim(Data[0]))             '코드
	g_sPeriodType	= Cstr(Trim(Data[1]))             '일주월년분틱
	g_sPeriod	= Cstr(Trim(Data[2]))             '주기(1,5,...)
	sRefresh		= Cstr(Trim(Data[3]))
	radioIndex	= ""
	
	if sRefresh = 1 or sRefresh = "1" or sRefresh = true then
		g_sPeriodType = "2"
		g_sPeriod = "1"
		radioIndex = 0
		g_szChrtType = "D"
		
		sTic = Form.GetEnvData( "chart_tic0" )
		sMin = Form.GetEnvData( "chart_min0" )
		
		if sTic = "" then
			sTic = "1"
		end if
		
		if sMin = "" then
			sMin = "1"
		end if
		
		RadioGroup0.SetRadioCaption( 3, sTic.."틱" )
		RadioGroup0.SetRadioCaption( 2, sMin.."분" )
		
	else
		'PENTA13 START => 2023.07.04(차트성능개선)
		Select case g_sPeriodType
			case "0"
				g_szChrtType = "T"
				radioIndex = 3
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."틱" )
				
			case "1"
				g_szChrtType = "A"
				radioIndex = 2
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."분" )
				g_szMinType = g_sPeriod	'PENTA13 START => 2023.08.08(차트성능개선)
			
			case "2"
				g_szChrtType = "D"
				radioIndex = 0
			
			case "3"
				g_szChrtType = "W"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "주")
			
			case "4"
				g_szChrtType = "M"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "월")
			
			case "5"						'PENTA13 START => 2019.05.08
				g_szChrtType = "Y"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "년" )
		
		end Select
		'PENTA13 END
	end if
	
	'PENTA13 START => 2023.07.13(차트성능개선)
	if ChartEx0.GetDivideNum() == 1 then
		RadioGroup0.currentindex = radioIndex
	else
		RadioGroup0.setCurIndexSilent(radioIndex)
	end if
	
	Dim sDwmm
	sDwmm = ChartEx0.GetStateDWMM()
	if sDwmm == "0" then
		RadioGroup0.enable = 1
	end if
	'PENTA13 END
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
	
	' 종목코드 주기
	g_szItemMarket = Form.GetItemCodeInfo(g_szItemCode, "market")
	Form.SetItemCode(g_szItemCode)
	
	RequestData()	
end function
'============================================================================
'PENTA13 START => 2023.07.25(차트성능개선)
function ChartEx0_OnSelectedChart(nIndex, sData)
	if sData == "" then
		Exit function
	end if

	if nIndex < 1 then
		Exit function
	end if

	Data = split(sData, ";")
	
	g_sPeriodType   = Cstr(Trim(Data[2]))
	g_sPeriod       = Cstr(Trim(Data[3]))
     
	if g_sPeriodType == "0" or g_sPeriodType == "1" then
		if g_sPeriodType == "0" then		'틱
			g_TempIndex = 3
			g_szChrtType = "T"
			g_szTicType = g_sPeriod
			
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			
		else								'분
			g_TempIndex = 2
			g_szChrtType = "A"
			g_szMinType = g_sPeriod
			
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
			
		end if
	
	else
		g_sPeriod = "1"
		
		if g_sPeriodType == "2" then		'일
			g_TempIndex = 0
			g_szChrtType = "D"
			
		elseif g_sPeriodType == "3" then	'주
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			RadioGroup0.SetRadioCaption( g_TempIndex, "주" )
			
		elseif g_sPeriodType == "4" then	'월
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			RadioGroup0.SetRadioCaption( g_TempIndex, "월" )
			
		else								'년
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "Y"
			RadioGroup0.SetRadioCaption( g_TempIndex, "년" )

		end if
		
	end if
	
	RadioGroup0.setCurIndexSilent(g_TempIndex)
	
	Dim sDwmm
	sDwmm = ChartEx0.GetStateDWMM()
	if sDwmm == "1" then
		RadioGroup0.enable = 0
	end if

end function
'PENTA13 END
'======================================
Sub Form_OnFormInitBefore()
	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode, "market" )
	
	ChartEx0.SetLoadChart("stock")
	
	' 20190404 HWG START
	' 차트 분,틱 설정값 세팅 오류 수정
	szMin0 = Form.GetEnvData( "chart_min0" )
	szTic0 = Form.GetEnvData( "chart_tic0" )

	if szMin0 = "" or szMin0 = 0 then
		szMin0 = "1"
	end if
	
	if szTic0 = "" or szTic0 = 0 then
		szTic0 = "1"
	end if
	
	RadioGroup0.SetRadioCaption( 2, szMin0.."분" )
	RadioGroup0.SetRadioCaption( 3, szTic0.."틱" )
	' 20190404 HWG END
End Sub

'======================================
Sub ChartEx0_OnScrollEnd()
	' Chart Next Data
	 if g_szChrtType = "A" then
		  DATAMANAGER.RequestNextData("ohhts_5010_002r")
		  
	 elseif g_szChrtType = "T" then
		  DATAMANAGER.RequestNextData("ohhts_5010_003r")
		  
	 else
		  DATAMANAGER.RequestNextData("ohhts_5010_001r")
		  
	 end if
	
End Sub

'======================================
Sub Form_OnFormClose()
	Form.SetEnvData( 1,"11000_CHARTSET" 			, g_sPeriodType.."^"..g_sPeriod )
	Form.SetEnvData( 1,"11000_CHARTSETMINTICK" 	, g_szMinType.."^"..g_szTicType )

	ChartEx0.SetSaveChart("1")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If g_szItemMarket = "W" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
			
	'20180712 HAMWG START : K-OTC MTS 도입
	ElseIf g_szItemMarket = "T" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
	'20180712 HAMWG END
	
	'20220211 HSZ START : 시세속도개선 (틱일때만 ohhts_stck_cntg, 나머지 ohhts_stck_incg로 변경)
	Else
		If g_szChrtType = "T" Then
			DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szItemCode )
			DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		Else 
			DATAMANAGER.SetDataValue( 1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szItemCode )
			DATAMANAGER.RequestRealData( "ohhts_stck_incg" )
		End If
	'20220211 HSZ END
	End If
	g_flagInit = false
	
	'20231016 LES START
	if szTranID == "obtrs_comn_430r" then
	
		avgPrice = DATAMANAGER.GetDataValue(0, "obtrs_comn_430r", "OutBlock1", "AVRG_BYOV_PRC" , 0)
		ChartEx0.SetAvgBuyPrice(g_szItemCode..";"..Cdbl(avgPrice))

	end if
	'20231016 LES END
	
	'20240610 SWJ START
	
	Dim sChartSetting
	sChartSetting = ""
	
	if szTranID == "obtrs_cntg_711r" then
		
		nCount = DATAMANAGER.GetDataCount(0, "obtrs_cntg_711r" , "OutBlock1")
		
		sAcnt = Form.LoadConfigData("CHART_ORDER_LIST".."_"..g_sUserID, "ACNT")
		sAcntNumber = Left(sAcnt, 4) & "-" & Mid(sAcnt, 5, 4) & "-" & Right(sAcnt, 2)
		
		g_bOnlyOnce = True
		
		Dim arrayOrderDate, arrayOrderTime, arrayBuyPrice, arraySellPrice, arrayBuyQuantity, arraySellQuantity, arrayDealClsCode
		
		arrayOrderDate = Array()
		
		arrayOrderTime = Array()
		
		arrayBuyPrice = Array()
		
		arraySellPrice = Array()

		arrayBuyQuantity = Array()
		
		arraySellQuantity = Array()
		
		arrayDealClsCode = Array()
		
		for i = 0 to nCount - 1 
			
			'주문일자
			arrayOrderDate(i) = DATAMANAGER.GetDataValue(0, "obtrs_cntg_711r", "OutBlock1", "ODER_DATE" , i)
			
			'체결시각
			arrayOrderTime(i) = DATAMANAGER.GetDataValue(0, "obtrs_cntg_711r", "OutBlock1", "CNTG_RCMS_TIME" , i)
			
			'매수평균단가
			arrayBuyPrice(i) = DATAMANAGER.GetDataValue(0, "obtrs_cntg_711r", "OutBlock1", "BYOV_UNPR" , i)
			
			'매도평균단가
			arraySellPrice(i) = DATAMANAGER.GetDataValue(0, "obtrs_cntg_711r", "OutBlock1", "SELN_UNPR" , i)
			
			'매수평균체결합계
			arrayBuyQuantity(i) = DATAMANAGER.GetDataValue(0, "obtrs_cntg_711r", "OutBlock1", "BYOV_CNTG_SMTN" , i)
			
			'매도평균체결합계
			arraySellQuantity(i) = DATAMANAGER.GetDataValue(0, "obtrs_cntg_711r", "OutBlock1", "SELN_CNTG_SMTN" , i)
			
			'매매구분코드
			arrayDealClsCode(i) = DATAMANAGER.GetDataValue(0, "obtrs_cntg_711r", "OutBlock1", "DEAL_CLS_CODE" , i)
			
			
			if gChartPeriod == "D" then
				
				'매수 2, 매도 1
				if arrayDealClsCode(i) == "2" then
					'차트엔 매수구분 0으로 세팅
					'sSetting = "0".."^"..arrayOrderDate(i).."^"..sAcntNumber.."^"..Cdbl(arrayBuyPrice(i)).."원".."^"..Cdbl(arrayBuyQuantity(i)).."주"
					sSetting = "0".."^"..arrayOrderDate(i).."^"..sAcntNumber.."^"..Cdbl(arrayBuyPrice(i)).."^"..Cdbl(arrayBuyQuantity(i))
				else
					'sSetting = arrayDealClsCode(i).."^"..arrayOrderDate(i).."^"..sAcntNumber.."^"..Cdbl(arraySellPrice(i)).."원".."^"..Cdbl(arraySellQuantity(i)).."주"
					sSetting = arrayDealClsCode(i).."^"..arrayOrderDate(i).."^"..sAcntNumber.."^"..Cdbl(arraySellPrice(i)).."^"..Cdbl(arraySellQuantity(i))
				end if
				
			else
				
				'매수 2, 매도 1
				if arrayDealClsCode(i) == "2" then
					'차트엔 매수구분 0으로 세팅
					'sSetting = "0".."^"..arrayOrderTime(i).."^"..sAcntNumber.."^"..Cdbl(arrayBuyPrice(i)).."원".."^"..Cdbl(arrayBuyQuantity(i)).."주"
					sSetting = "0".."^"..Right(arrayOrderDate(i),4)..arrayOrderTime(i).."^"..sAcntNumber.."^"..Cdbl(arrayBuyPrice(i)).."^"..Cdbl(arrayBuyQuantity(i))
				else
					'sSetting = arrayDealClsCode(i).."^"..arrayOrderTime(i).."^"..sAcntNumber.."^"..Cdbl(arraySellPrice(i)).."원".."^"..Cdbl(arraySellQuantity(i)).."주"
					sSetting = arrayDealClsCode(i).."^"..Right(arrayOrderDate(i),4)..arrayOrderTime(i).."^"..sAcntNumber.."^"..Cdbl(arraySellPrice(i)).."^"..Cdbl(arraySellQuantity(i))
				end if
			end if
			
			if i == 0 then
				sChartSetting = sSetting
			else
				sChartSetting = sChartSetting .. ";"..sSetting
			end if
			
		next
		
		if sChartSetting <> "" then
			'Form.ShowAlert("TEST", nCount..";"..sChartSetting)
			ChartEx0.setTradeData(nCount..";"..sChartSetting)
		else
			ChartEx0.setTradeData("")
		end if
	end if
	'20240610 SWJ END
End Sub

'============================================================================
function ChartEx0_OnChangeAdjustedStock(sData)
	if g_sStockMode <> sData then
		g_sStockMode = sData
		Form.SetEnvData( 1, "chart_stockmode", g_sStockMode )
		RequestData()
	end if

end function
