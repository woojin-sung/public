'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

Dim g_szItemCode, g_szItemMarket
Dim g_szChrtType
Dim g_szToday
Dim g_szMinType
Dim g_szTicType
Dim g_flagMin
Dim g_flagTic
Dim g_flagWeek
Dim g_flagLine
Dim g_TempIndex		'PENTA13 START => 2023.08.14(차트성능개선)
Dim g_flagInit
Dim g_sStockMode

g_sStockMode = "1"	'수정주가 1: 0
g_szChrtType = "D" 	'일

'20230830 LES START
'초기 분/틱 주기 설정
g_minPeriod = {"1", "3", "5", "10",  "15", "30", "60" , "120"}
g_ticPeriod = {"1", "3", "5", "10",  "15", "30", "60" , "120"}
'20230830 LES END

'20231016 LES START
Dim g_bApplyVersion
g_bApplyVersion = false
'20231016 LES END

'20240610 SWJ START
Dim gUseOrderList
gUseOrderList = ""

Dim gChartPeriod
gChartPeriod = ""

Dim g_sInitFlag
g_sInitFlag = True

Dim gCmbIndex
gCmbIndex = ""

Dim gRadioIndex
gRadioIndex = ""

Dim g_sUserID
g_sUserID = ""

Dim g_sChartPopup
g_sChartPopup = ""
'20240610 SWJ END

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
Function SetChart()
	Dim szValue, szValueMinTick

     szValue 			= Form.GetEnvData( "11000_CHARTSET" )
     szValueMinTick 	= Form.GetEnvData( "11000_CHARTSETMINTICK" )    
     tempStock		= Form.GetEnvData( "chart_stockmode" )    
 
	if tempStock <> "" then
		g_sStockMode = tempStock
		ChartEx0.SetAdjustedStock(g_sStockMode)
	end if
	
	if szValue = "" then
		Form.SetEnvData(1, "11000_CHARTSETMINTICK", "2^001")
		g_sPeriod	= "001"
		g_sPeriodType	= "2"
	     
	else
		temp = split(szValue, "^")
		g_sPeriodType	= temp[0]
		g_sPeriod 	= temp[1]
	     
	end if
	
	if szValueMinTick <> "" then
		temp1 = split(szValueMinTick, "^")
		g_szMinType = temp1[0]
		g_szTicType = temp1[1]
		
	else
		' 20190404 HWG START
		' 차트 분,틱 설정값 세팅 오류 수정
		szMin0 = Form.GetEnvData( "chart_min0" )
		szTic0 = Form.GetEnvData( "chart_tic0" )
	
		if szMin0 <> "" and szMin0 <> 0 then
			g_szMinType = szMin0
		else
			g_szMinType = "1"
		end if
		
		if szTic0 <> "" and szTic0 <> 0 then
			g_szTicType = szTic0
		else 
			g_szTicType = "1"
		end if
		' 20190404 HWG END
	     
	end if
	
	'분틱 셋팅	
	tmpIndex = null 
	if g_sPeriodType = "0" or g_sPeriodType = "1" then
		if g_sPeriodType = "0" then
			g_TempIndex = 3
			g_szChrtType = "T"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			
		else
			g_TempIndex = 2
			g_szChrtType = "A"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
			
		end if
	
	else
		if g_sPeriodType = "2" then
			g_TempIndex = 0
			g_szChrtType = "D"
			
		elseif g_sPeriodType = "3" then
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			RadioGroup0.SetRadioCaption( g_TempIndex, "주" )
			
'PENTA13 START => 2019.05.08
		elseif g_sPeriodType = "4" then
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			RadioGroup0.SetRadioCaption( g_TempIndex, "월" )
			
		else
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "Y"
			RadioGroup0.SetRadioCaption( g_TempIndex, "년" )
			
		end if
'PENTA13 END
	end if
	 
	RadioGroup0.currentindex = g_TempIndex
	PeriodSet(sPeriodType)
End Function
'======================================
Sub Form_OnFormInit()
	g_flagInit = true
	g_flagMin = false
	g_flagTic = false
	g_flagWeek = false
	g_flagLine = false
	
	SetChart()
	
	'Form.triggerEvent("linkfmHoga", "INIT_CODE", g_szItemCode) 	' 링크화면에 종목코드 던지기
'	g_szChrtType = "D" '일
	g_szToday = Form.GetSharedData( "&HOST_DATE", 0 )
'	g_szMinType = "1분"
'	g_szTicType = "1틱"

	Form.SetRealBundle("1")		'PENTA13 START => 2023.09.12(플랫폼개선)
	
	RequestData()
	
	'20240610 SWJ START
	g_sUserID = Form.GetSharedData("&USER_ID", false)
	'20240610 SWJ END
	
	'20231016 LES START
	Check_Version()
	'20231016 LES END

End Sub

'======================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		
		'20240610 SWJ START
		'밑에 g_szItemCode == sValue 부분은
		'TriggerEvent "Init_Code"에서 종목코드 먼저 받아서
		'의미 없는 분기임 밑에 아예 안탐
		'20231016 LES START
		if g_bApplyVersion then
			
			'20240610 SWJ START
			Form.SetTimerEvent2("2", 1, 0.3)
			ChartEx0.setTradeData("")
			'20240610 SWJ END
		else
			Apply_Use_AvgBuyPrice()
		end if
		'20231016 LES END
		'20240610 SWJ END
		
		if g_szItemCode = sValue and g_flagInit = false then
			exit Sub
		end if

		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode, "market" )

		RequestData()
		
	'20231016 LES START
	elseif sKey =	"&LOGIN"	then
		'20240610 SWJ START
		'Apply_Use_AvgBuyPrice()
		'Chart_UseWhatLine()
		Form.SetTimerEvent2("2", 1, 0.2)
		ChartEx0.setTradeData("")
		'20240610 SWJ END
	'20231016 LES END

	end	if	
End Sub

'======================================
Function RequestData()
	DATAMANAGER.CancelRealData("ohhts_stck_cntg")
	DATAMANAGER.CancelRealData("ohhts_stck_incg") '20220211 HSZ 시세속도개선
	DATAMANAGER.CancelRealData("ohhts_elw_cntg")
	DATAMANAGER.CancelRealData("ohhts_frbr_cntg")	'20180712 HAMWG : K-OTC MTS 도입
	
	szStockMode = "0"
	if g_sStockMode = "0" then
		szStockMode = "1"
	end if
	
	'20240701 SWJ START
	
'		if g_bApplyVersion then	
'			
'			'20240610 SWJ START
'			Form.SetTimerEvent2("2", 1, 0.2)
'			ChartEx0.setTradeData("")
'			'20240610 SWJ END
'		else
'			Apply_Use_AvgBuyPrice()
'		end if
	'20240701 SWJ END
	
	PeriodSetChart(g_szChrtType)  '20230905 한국금융IT : 일주월분 차트 주기 설정

	if g_szChrtType = "A" then			'분차트
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
'PENTA13 START => 2023.10.06(차트성능개선)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE", 0, szStockMode)
'PENTA13 ORGSRC
		'DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"0")
'PENTA13 END
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_DATE1" ,0,g_szToday)		
		
		sMin = Split(g_szMinType, "분", -1, 1)
		sTemp = sMin[0] * 60
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" , 0, sTemp)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0,"Y")
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_VRTL_TICK_INCU_YN", 0,"N")
		
		DATAMANAGER.RequestTranData("ohhts_5010_002r")
		
	elseif g_szChrtType = "T" then		'틱차트
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_003r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_003r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
		
		sTic = Split(g_szTicType, "틱", -1, 1)
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_003r", "InBlock2", "FID_INPUT_CNT1" , 0, sTic[0])
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_003r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" , 0, "2")	
		DATAMANAGER.SetDataValue( 0,  "ohhts_5010_003r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0, "N")
		
		DATAMANAGER.RequestTranData("ohhts_5010_003r")
		
	Else
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
'PENTA13 START => 2023.10.06(차트성능개선)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE", 0, szStockMode )
'PENTA13 ORGSRC
		'DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
'PENTA13 END
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR" , 0,g_szChrtType)  'D/W/M/Y 일/주/월/년 
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DATE1" , 0,g_szToday)

		DATAMANAGER.RequestTranData("ohhts_5010_001r")	
		
	End If

end Function
