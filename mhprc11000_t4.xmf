'2. Apply_Use_AvgBuyPrice()  : 매수평균가 사용여부 확인 후 차트에 적용

'============================================================================
Function Check_Version()

	szOsType = Form.GetSharedData("&OS_TYPE", False) 
	szAppVer	= Form.GetSharedData("&APP_VERSION", False)
	szAppVer	= Replace(szAppVer, ".", "")
	
	'1.안드로이드 2.iOS
	if szOsType == "1" then
	
		'20240610 SWJ START: 이전 버전은 매수평균단가만
		
		'-----------------------------------------------------------------------
		'추세선 숨김처리
		'-----------------------------------------------------------------------
		BtnLine.visible = false 
			
		'-----------------------------------------------------------------------
		'Image5 : 매매평균가 스위치 이미지
		'-----------------------------------------------------------------------
		Image5.visible = true
		Image5.left = 197
		Image5.setMaintainingRatio("1")
			
