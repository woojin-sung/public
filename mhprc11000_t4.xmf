'======================================
Sub RadioGroup0_OnClick(nIndex)
'	if g_flagInit = true then
'		g_flagInit = false
'	else
		if nIndex = 0 then  '일
			g_flagMin = false
			g_flagTic = false
			g_flagWeek = false
			g_szChrtType = "D"
			
			PeriodSet(g_szChrtType)
			
		elseif nIndex = 1 then  '주/월/년
			g_flagMin = false
			g_flagTic = false
			
			if g_flagWeek == false   then
				sTemp = RadioGroup0.GetRadioCaption(1)
				if sTemp == "월" then
					g_szChrtType = "M"

				elseif sTemp == "년" then							'PENTA13 START => 2019.05.08
					g_szChrtType = "Y"

				else
					g_szChrtType = "W"
					
				end if
				
				g_flagWeek = true
				PeriodSet(g_szChrtType)
				
			else
				sTemp = RadioGroup0.GetRadioCaption(1)
				'Form.OpenPopup( "mhcht13000_p4.xmf", sTemp, "" )		'PENTA13 START => 2019.05.08
				'20230421 KKM  주/월/년 bottom popup START
				if sTemp = "주" then	
					Combo0.currentindex = 0
				elseif sTemp = "월" then	
					Combo0.currentindex = 1
				elseif sTemp = "년" then	
					Combo0.currentindex = 2
				end if 	
				Combo0.OpenList()	
				'20230421 KKM  END
				
			end if
			'--------------------------------------------------------
'			if g_flagWeek = true   then
'				if g_szChrtType = "W" then
'					g_szChrtType = "M"
'					g_flagWeek = false
'					RadioGroup0.SetRadioCaption( 1, "월" )
'				else
'					g_szChrtType = "W"
'				end if
'			else
'				if g_szChrtType = "M" then
'					g_szChrtType = "W"
'					g_flagWeek = true
'					RadioGroup0.SetRadioCaption( 1, "주" )
'				else
'					g_szChrtType = "M"
'				end if
'			end if	
'			PeriodSet(g_szChrtType)
			'--------------------------------------------------------
	'	elseif nIndex = 2 then  '월
	'		g_szChrtType = "M"
	'		PeriodSet(g_szChrtType)
	
		elseif nIndex = 2 then   '분
			g_flagTic = false
			g_flagWeek = false
			g_szChrtType = "A"
		
			if g_flagMin = false then
				g_flagMin = true
				tmpMin = split(RadioGroup0.GetRadioCaption(2),"분")
				g_szMinType = tmpMin[0]
				
				PeriodSet(g_szChrtType)
				
			else
				'g_flagMin = false
				
				If g_flagInit = true Then
					PeriodSet(g_szChrtType)
					
				Else
					
					'20230830 LES START
					SetPeriod_Combo("min")	
					'20230830 LES END
								
				End If
			end if
			
		elseif nIndex = 3 then   '틱
			g_flagMin = false
			g_flagWeek = false
			g_szChrtType = "T"
			
			if g_flagTic = false then
				g_flagTic = true
				tmpTic = split(RadioGroup0.GetRadioCaption(3),"틱")
				g_szTicType = tmpTic[0]
				
				PeriodSet(g_szChrtType)
				
			else
				If g_flagInit = true Then
					PeriodSet(g_szChrtType)
					
				Else
				
					'20230830 LES START
					SetPeriod_Combo("tic")	
					'20230830 LES END
						
				End If
				
			end if
		end if
	
	'20240610 SWJ START
	'처음 오픈했을 때 방지 및
	'클릭했을 때는 인덱스가 달라졌을 때만
	if g_sInitFlag = False then
		if gRadioIndex <> nIndex then
			Form.SetTimerEvent2(1, 1, 0.2)
			ChartEx0.setTradeData("")
		end if
	end if
	
	
	gRadioIndex = nIndex
	'20240610 SWJ END
End Sub
