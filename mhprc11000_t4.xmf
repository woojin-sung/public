'20230421 KKM  주/월/년 bottom popup			
Sub Combo0_OnEditComplete(iIndex)
	if iIndex = 1 then
		g_szChrtType = "M"
		sRet = "월"
		
	elseif iIndex = 2 then
		g_szChrtType = "Y"
		sRet = "년"
		
	else
		g_szChrtType = "W"
		sRet = "주"
		
	end 	if
			
	RadioGroup0.SetRadioCaption( 1, sRet )		
	PeriodSet(g_szChrtType)		
End Sub	

'============================================================================			
'20230421 KKM  분 bottom popup			
Sub Combo1_OnEditComplete(iIndex)
	
	'20230830 LES START
	tmpData = g_minPeriod[iIndex]
	tmpMin = split(tmpData,"분")
	g_szMinType = tmpMin[0]
	RadioGroup0.SetRadioCaption( 2, g_szMinType & "분" )
			
	PeriodSet(g_szChrtType)
	'20230830 LES END
	
	'20240610 SWJ START
	'콤보 인덱스가 달라졌을 때만
	'IOS 안드 모두 콤보 리스트를 오픈해도 complete 이벤트를 탐
	
	if gCmbIndex <> iIndex then 
		'Chart_UseWhatLine()
		Form.SetTimerEvent2("2", 1, 0.2)
		ChartEx0.setTradeData("")
	end if	
	
	gCmbIndex = iIndex
	'20240610 SWJ END
End Sub			

'============================================================================			
'20230421 KKM  틱 bottom popup			
Sub Combo2_OnEditComplete(iIndex)
	
	'20230830 LES START
	tmpData = g_ticPeriod[iIndex]
	tmpTic = split(tmpData,"틱")
	g_szTicType = tmpTic[0]
	RadioGroup0.SetRadioCaption( 3, g_szTicType & "틱" )
	PeriodSet(g_szChrtType)
	'20230830 LES END

End Sub

'=======================================================================================
'20230830 LES START - (분/틱) 사용자 설정 주기에 따라 콤보박스 세팅
'=======================================================================================
Function SetPeriod_Combo(sType)
	
	'=============================
	' 분차트
	'=============================
	if sType == "min" then
		
		'---------------------------------------------
		' 지역변수 초기화
		'---------------------------------------------
		Dim szMinPeriodList, nCurComboIndex
		szMinPeriodList = ""
		nCurComboIndex = 0
		
		tmpMin = split(RadioGroup0.GetRadioCaption(2),"분")
		g_szMinType = tmpMin[0]
	
		'---------------------------------------------
		' 사용자 설정 분 주기 GET
		'---------------------------------------------
		for i = 0 to 7
		
			sMin	= Form.GetEnvData( "chart_min"..i )	'분차트
			
			if sMin ~= "" then
				g_minPeriod[i] = sMin
				
				if szMinPeriodList == "" then
					szMinPeriodList = i & "`" & sMin & "분"
				else
					szMinPeriodList = szMinPeriodList & "\r\n" & i & "`" & sMin & "분"
				end if
				
			end if
			
			'현재 선택한 주기로 콤보박스 currentIndex 이동
			if g_szMinType == g_minPeriod[i] then
				nCurComboIndex = i
			end if	
			
		next
		
		'------------------------------------------------
		' 사용자 설정 분 주기가 없는 경우 디폴트 주기 GET
		'------------------------------------------------
		if szMinPeriodList == "" then
		
			for i = 0 to 7
			
				sMin = g_minPeriod[i]
				
				if szMinPeriodList == "" then
					szMinPeriodList = i & "`" & sMin & "분"
				else
					szMinPeriodList = szMinPeriodList & "\r\n" & i & "`" & sMin & "분"
				end if
			
			next
		
		end if
		
		
		'---------------------------------------------
		' 사용자 설정 분 주기 SET
		'---------------------------------------------
		Combo1.cbinputdatatext = szMinPeriodList
		Combo1.currentindex = nCurComboIndex
		Combo1.OpenList()	
	
	'=============================
	' 틱차트
	'=============================
	elseif sType == "tic" then
	
		'---------------------------------------------
		' 지역변수 초기화
		'---------------------------------------------
		Dim szTicPeriodList, nCurComboIndex
		szTicPeriodList = ""
		nCurComboIndex = 0
		
		tmpTic = split(RadioGroup0.GetRadioCaption(3),"틱")
		g_szTicType = tmpTic[0]
	
		'---------------------------------------------
		' 사용자 설정 틱 주기 GET
		'---------------------------------------------
		for i = 0 to 7		
			
			sTic	= Form.GetEnvData( "chart_tic"..i )	'틱차트
		
			if sTic ~= "" then
				g_ticPeriod[i] = sTic
				
				if szTicPeriodList == "" then
					szTicPeriodList = i & "`" & sTic & "틱"
				else
					szTicPeriodList = szTicPeriodList & "\r\n" & i & "`" & sTic & "틱"
				end if
				
			end if
			
			'현재 선택한 주기로 콤보박스 currentIndex 이동
			if g_szTicType == g_ticPeriod[i] then
				nCurComboIndex = i
			end if	
		
		Next
		
		'------------------------------------------------
		' 사용자 설정 틱 주기가 없는 경우 디폴트 주기 GET
		'------------------------------------------------
		if szTicPeriodList == "" then
		
			for i = 0 to 7
			
				sTic = g_ticPeriod[i]
				
				if szTicPeriodList == "" then
					szTicPeriodList = i & "`" & sTic & "틱"
				else
					szTicPeriodList = szTicPeriodList & "\r\n" & i & "`" & sTic & "틱"
				end if
			
			next
		
		end if
		
		'---------------------------------------------
		' 사용자 설정 틱 주기 SET
		'---------------------------------------------
		Combo2.cbinputdatatext = szTicPeriodList
		Combo2.currentindex = nCurComboIndex
		Combo2.OpenList()	

	
	end if


End Function
'=======================================================================================
'20230830 LES END
'=======================================================================================

