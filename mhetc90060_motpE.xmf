		<BUTTON name="btnQuit" caption="취소" fgcolor="004:000000000" fontsize="2" btnimage="btn_25.9" ly_vert="32,380,157,60,1" />
		<BUTTON name="btnOk" caption="재등록" fontsize="2" btnimage="btn_26.9" ly_vert="189,380,156,60,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1681" _ulen="1539" >
Dim g_OSType
g_OSType = ""

'============================================================================
Sub btnOk_OnClick()
	'로그인 여부 체크
	Dim sLOGIN_TYPE  
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )		
	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
'		If g_MotpSrno == Null Or Len(g_MotpSrno) == 0 Then
'			Form.ShowAlert("알림", "스마트폰에 발급된 OTP정보가 없습니다.")
'			Exit Sub
'		End If
		'Form.OpenNextPopup( "mbotp86125.xmf" , "" , "" )				
		Form.OpenNextPopup( "mbotp86100.xmf", "", "" )		
	else
		if g_OSType == "2" then 'iOS
			Form.OpenScreen("86100", "POPUP_ALL_CLOSE")
		else
			Form.OpenScreen("86100", "")
		end if
		
		'Form.CloseForm()		
		'iOS는 부모화면이 닫히면 자식화면도 같이 닫혀서 자식도 FormClose하면 창이 다 꺼짐
		if Form.GetSharedData("&OS_TYPE", false) == "1" then
			Form.CloseForm()
		end if		
	end if
End Sub

'============================================================================
Sub btnQuit_OnClick()
	
'	if g_szOpenData == "CommonAuthPopup" then
'		'리턴 보낼 필요 없음
'		Form.CloseForm()
'		exit sub
'	end if
'	
	Form.SendReturnToParent("mhetc90060_motpE" , "cancel")
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_OSType = Form.GetSharedData("&OS_TYPE", false)
	if g_OSType == "2" then 'iOS
		imgBack.visible = True
	else
		imgBack.visible = False
	end if

	szData = Form.GetOpenLinkData()
'szData = "20240220" 'for TEST
	tblInfo.SetCellString(1, 0, Left(szData, 4) & "." &  Mid(szData, 5, 2) & "." &  Mid(szData, 7, 8) & "까지 입니다")
	 
End Sub

	</SCRIPT_INFO>
