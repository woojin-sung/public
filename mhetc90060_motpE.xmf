		<IMAGE name="imgBack" autosize="1" imgpath="alpha128.png" ly_vert="0,0,375,647,1" />
		<IMAGE name="imgBg" imgpath="popup_bg_common.9" ly_vert="32,207,312,231,1" />
		<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="안내" halign="1" ly_vert="33,225,310,32,1" />
		<TABLE name="tblInfo" insidelinecolor="102:255255255" colcount="1" rowcount="6" outline="0000" designorder="1" ly_vert="33,267,310,95,1" >
			<COL_INFO ly_vert_width="310" />
			<ROW_INFO ly_vert_height="10,10,20,10,20,25" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,1" line="0,0" caption="모바일OTP 유효기간이" impidxs="" />
				<CELL cell_ly="0,2,0,2" line="0,0" caption="2024.03.01까지 입니다." impidxs="" />
				<CELL cell_ly="0,3,0,3" line="0,0" impidxs="" />
				<CELL cell_ly="0,4,0,4" line="0,0" caption="유효기간 이후 사용이 불가하오니" impidxs="" />
				<CELL cell_ly="0,5,0,5" line="1,0" caption="모바일OTP를 재발급 바랍니다." impidxs="" />
