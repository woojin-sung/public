'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 고객연락처변경
' 02. 화면설명 : 고객연락처변경_전화번호
' 03. 작    성 : 2016.01.25 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'===========================================================================
' 등록/변경/삭제 버튼 속성함수
'===========================================================================
Function SetControlType()
	if Table0.GetCellString( 0, 1 ) == "" then '자택전화번호
		ButtonHReg.visible = true
		ButtonHModi.visible = false
		ButtonHDel.visible = false
	else
		ButtonHReg.visible = false
		ButtonHModi.visible = true
		ButtonHDel.visible = true
	end if
	
	if Table0.GetCellString( 1, 1 ) == "" then '직장전화번호
		ButtonOReg.visible = true
		ButtonOModi.visible = false
		ButtonODel.visible = false
	else
		ButtonOReg.visible = false
		ButtonOModi.visible = true
		ButtonODel.visible = true
	end if
	
	if Table0.GetCellString( 2, 1 ) == "" then '휴대폰전화번호
		ButtonPReg.visible = true
		ButtonPModi.visible = false
		ButtonPDel.visible = false
	else
		ButtonPReg.visible = false
		ButtonPModi.visible = true
		ButtonPDel.visible = true
	end if
	
	if Table0.GetCellString( 3, 1 ) == "" then 'FAX전화번호
		ButtonFReg.visible = true
		ButtonFModi.visible = false
		ButtonFDel.visible = false
	else
		ButtonFReg.visible = false
		ButtonFModi.visible = true
		ButtonFDel.visible = true
	end if
End Function

'===========================================================================
' 전화번호 클리어
'===========================================================================
Function SetControlViewClear()
	Table0.SetCellString( 0, 1, "" )
	Table0.SetCellString( 1, 1, "" )
	Table0.SetCellString( 2, 1, "" )
	Table0.SetCellString( 3, 1, "" )
End Function

'============================================================================
' 전화번호 마스킹처리함수
'============================================================================
Function GetMaskNumber(sNum)
	if sNum == null or Trim(sNum) == "" then
		return sNum
	end if
	
	if #sNum <= 2 then
		return sNum
	end if
	
	Dim sMaskNum
	if #sNum == 3 then
		sMaskNum = Left(sNum, 1)
	else
		sMaskNum = Left(sNum, 2)
	end if
	
	sMaskNum = sMaskNum.."**"
	
	return sMaskNum
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "TabChange" then
		SetControlViewClear()
		
		Dim sHome1, sHome2, sHome3, sHome4, sOffice1, sOffice2, sOffice3, sOffice4, sPhone1, sPhone2, sPhone3, sFax1, sFax2, sFax3
		sHome1 = Form.GetSharedData("Number_Home1" , false)
		sHome2 = Form.GetSharedData("Number_Home2" , false)
		sHome3 = Form.GetSharedData("Number_Home3" , false)
		sHome4 = Form.GetSharedData("Number_Home4" , false)
		sOffice1 = Form.GetSharedData("Number_Office1" , false)
		sOffice2 = Form.GetSharedData("Number_Office2" , false)
		sOffice3 = Form.GetSharedData("Number_Office3" , false)
		sOffice4 = Form.GetSharedData("Number_Office4" , false)
		sPhone1 = Form.GetSharedData("Number_Phone1" , false)
		sPhone2 = Form.GetSharedData("Number_Phone2" , false)
		sPhone3 = Form.GetSharedData("Number_Phone3" , false)
		sFax1 = Form.GetSharedData("Number_Fax1" , false)
		sFax2 = Form.GetSharedData("Number_Fax2" , false)
		sFax3 = Form.GetSharedData("Number_Fax3" , false)
		
		if sHome1 ~= null and sHome1 ~= "" then
			if sHome4 ~= null and Trim(sHome4) ~= "" then
				Table0.SetCellString( 0, 1, sHome1.."-"..GetMaskNumber(sHome2).."-"..GetMaskNumber(sHome3).."("..GetMaskNumber(sHome4)..")" )
			else
				Table0.SetCellString( 0, 1, sHome1.."-"..GetMaskNumber(sHome2).."-"..GetMaskNumber(sHome3) )
			end if
		end if 
		
		if sOffice1 ~= null and sOffice1 ~= "" then
			if sOffice4 ~= null and Trim(sOffice4) ~= "" then
				Table0.SetCellString( 1, 1, sOffice1.."-"..GetMaskNumber(sOffice2).."-"..GetMaskNumber(sOffice3).."("..GetMaskNumber(sOffice4)..")" )
			else
				Table0.SetCellString( 1, 1, sOffice1.."-"..GetMaskNumber(sOffice2).."-"..GetMaskNumber(sOffice3) )
			end if
		end if 
		
		if sPhone1 ~= null and sPhone1 ~= "" then
			Table0.SetCellString( 2, 1, sPhone1.."-"..GetMaskNumber(sPhone2).."-"..GetMaskNumber(sPhone3) )
		end if 
		
		if sFax1 ~= null and sFax1 ~= "" then
			Table0.SetCellString( 3, 1, sFax1.."-"..GetMaskNumber(sFax2).."-"..GetMaskNumber(sFax3) )
		end if 	
		
		SetControlType()
	end if
End Sub

'============================================================================
' 자택전화번호 등록/변경/삭제
'============================================================================
Sub ButtonHReg_OnClick()
	Form.triggerEvent( "#", "Register", "page0_Home" )
End Sub
'============================================================================
Sub ButtonHModi_OnClick()
	Form.triggerEvent( "#", "Modify", "page0_Home" )
End Sub
'============================================================================
Sub ButtonHDel_OnClick()
	Form.triggerEvent( "#", "Delete", "page0_Home" )
End Sub

