	<SCRIPT_INFO _len="2240" _ulen="2104" >
'v0001 : 전상일 : 비대면 개설시 오류 팝업건 연동 추가
Dim g_szOSType

'============================================================================
'Sub Button0_OnClick()
'	Form.SendCall("15883400")
'End Sub
'
''============================================================================
'Sub Image1_OnClick()
'	Form.SendCall("15883400")
'End Sub

'20221121 HSZ START

Sub Form_OnFormInit()
	WebView0.SetUserAgent("meritz")
	
    'OSType 1.안드로이드 2.IOS
    g_szOSType = Form.GetSharedData("&OS_TYPE", False)
	g_serverMode = Form.GetSharedData("&SERVER_MODE", false)
	
	If g_serverMode == "1" Then	'테스트기
		WebView0.urlpath = "https://testhome.imeritz.com/mobile/sub/m_support.html"
	else
		WebView0.urlpath = "https://home.imeritz.com/mobile/sub/m_support.html"
	end if

End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

	if sKeyName == "call" then
		if sRet == "ok" then
			Form.SendCall("15883400")
		end if
	end if
	
End Sub

'============================================================================
Sub Imgbtn_OnClick()

	if g_szOSType == "1" then
		Form.MsgBox("알림", "1588-3400으로 전화연결 하시겠습니까?", "call", 2)
	else	'iOS는 OS에서 확인팝업 띄움
		Form.SendCall("15883400")
	end if
	
End Sub

'============================================================================
Sub Lblbtn_OnClick()

	Call Imgbtn_OnClick()
	
End Sub
'============================================================================
'20221121 HSZ END
'============================================================================

'============================================================================
Sub Form_OnFormClose()
    Form.SendReturnToParent("mbonl89020", "ok") 'v0001 : 전상일 : 비대면 개설시 오류 팝업건 연동 추가
    Form.CloseForm()
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	Form.openPrevScreen()
	'Form.CloseForm()
End Sub

'============================================================================
Sub lblBtn_OnClick()
	Form.OpenScreen("89023" , "")
End Sub

