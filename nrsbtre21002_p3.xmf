'============================================================================
' 화 면 명 : 전체권리일정화면_권리상세
' 화면설명 : 전체권리일정화면의 해외상세 팝업창
' 작    성 : 2023.09.12 KKM
'============================================================================

Dim g_szItemCd, g_szItemNm, g_szRghtCd, g_szRghtNm, g_szStatCd, g_szStndDate, g_szWrhsDate
Dim g_szFRSK, g_szFRSKDate, g_szASGM_RATE

Dim g_Left, g_Top
g_Left = 12
g_Top = 318

Dim g_bAllcation
g_bAllcation = "Y"

Function SetVisible()

	Table041.left = 512 
	Select Case g_szRghtCd	
		
		Case "01" '01	유상
			Table011.left = g_Left 
			Table011.top = g_Top
			Table011.SetCellString(0, 1, "유상")
			
		Case "02" '02 무상		
			Table021.left = g_Left 
			Table021.top = g_Top
			Table021.SetCellString(0, 1, "무상")
			
		Case "03" '03	 배당(현금, 주식, 동시배당)	
			if g_szRghtNm == "현금배당" then
				'배당옵션이 있는 경우
				if g_bAllcation == "Y" then
					Table032.left = g_Left 
					Table032.top = g_Top
					Table032.SetCellString(0, 1, g_szRghtNm)				
				else
					Table031.left = g_Left 
					Table031.top = g_Top
					Table031.SetCellString(0, 1, g_szRghtNm)				
				end if 
				
			elseif g_szRghtNm == "주식배당" then
				'배당옵션이 있는 경우
				if g_bAllcation == "Y" then
					Table034.left = g_Left 
					Table034.top = g_Top
					Table034.SetCellString(0, 1, g_szRghtNm)
				else
					Table033.left = g_Left 
					Table033.top = g_Top
					Table033.SetCellString(0, 1, g_szRghtNm)
				end if 
			end if
			
		Case "04" '04 합병
			Table041.left = g_Left 
			Table041.top = g_Top
			Table041.SetCellString(0, 1, "합병")
			
		Case "05" '05	 감자 
'			if g_szRghtNm == "유상감자" then
				Table051.left = g_Left 
				Table051.top = g_Top
				Table051.SetCellString(0, 1, g_szRghtNm)
'			elseif g_szRghtNm == "무상감자" then
'				Table053.left = g_Left 
'				Table053.top = g_Top
'				Table053.SetCellString(0, 1, g_szRghtNm)
'			end if
				
		Case "06", "07" '06 액면분할, 07 액면병합
			Table061.left = g_Left 
			Table061.top = g_Top
			Table061.SetCellString(0, 1, g_szRghtNm)
			
		Case "09" '09 코드변경
			Table091.left = g_Left 
			Table091.top = g_Top
			Table091.SetCellString(0, 1, "코드변경")
			
		Case "08" '09 회사분할
			Table081.left = g_Left 
			Table081.top = g_Top
			Table081.SetCellString(0, 1, "회사분할")
			
	End Select
end Function

'02 무상(지급) : 단수주지급일, 단수주대금(세전) 
'03 배당(현금, 주식, 동시배당)(지급) : 단수주지급일, 단수주대금(세전) 
'04 합병 : 단수주지급일, 단수주대금(세전)
'05 감자(유상감자, 무상감자)(지급) : 단수주지급일, 단수주대금(세전)
'06	액면분할(지급), 07 액면병합(지급) : 단수주지급일, 단수주대금(세전)
'08 회사분할(지급) : 단수주지급일, 단수주대금(세전)
Function SetData()
	Dim sTemp
	Dim szCRCD
	'통화코드
	szCRCD = grd1.GetCellData("bd_cell11", 0)
	if szCRCD <> "원" then
		szCRCD = " "& szCRCD
	end if 
	
	Select Case g_szRghtCd	
	
		Case "01" '01	유상
			Table011.SetCellString(1, 1, grd1.GetCellData("bd_cell26", 0) & grd1.GetCellData("bd_cell27", 0)) '청약시작일~청약마감일
			Table011.SetCellMaskInfo(2, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")
			Table011.SetCellString(2, 1, grd1.GetCellData("bd_cell28", 0)) '유상청약가격	
			
'			Table011.SetCellString(3, 1, grd1.GetCellData("bd_cell29", 0)) '증서입고일자				
'			Table011.SetCellString(4, 1, grd1.GetCellData("bd_cell30", 0)) '증서출고일자 
'			Table011.SetCellString(5, 1, grd1.GetCellData("bd_cell18", 0)) '상장일자

			'증서입고일자				
			if Trim(grd1.GetCellData("bd_cell29",  0)) == "" then
				Table011.SetCellMaskInfo(3, 1,  "1,0,,,1,,0,0,1,0,0")
				Table011.SetCellString(3, 1, "미정") 
			else
				Table011.SetCellString(3, 1, grd1.GetCellData("bd_cell29",  0)) 
			end if
			
			'증서출고일자				
			if Trim(grd1.GetCellData("bd_cell30",  0)) == "" then
				Table011.SetCellMaskInfo(4, 1,  "1,0,,,1,,0,0,1,0,0")
				Table011.SetCellString(4, 1, "미정") 
			else
				Table011.SetCellString(4, 1, grd1.GetCellData("bd_cell30",  0)) 
			end if	
			
			'상장일자	
			if Trim(grd1.GetCellData("bd_cell18",  0)) == "" then
				Table011.SetCellMaskInfo(5, 1,  "1,0,,,1,,0,0,1,0,0")
				Table011.SetCellString(5, 1, "미정") 
			else
				Table011.SetCellString(5, 1, grd1.GetCellData("bd_cell18",  0)) 
			end if	
			
		Case "02" '02 무상
			if Trim(grd1.GetCellData("bd_cell18",  0)) == "" then
				Table021.SetCellMaskInfo(1, 1,  "1,0,,,1,,0,0,1,0,0")
				Table021.SetCellString(1, 1, "미정") 
			else
				Table021.SetCellString(1, 1, grd1.GetCellData("bd_cell18", 0) ) '처리일자
			end if
			
			Table021.SetCellString(2, 1, grd1.GetCellData("bd_cell25", 0)) '현지원천세율			
			'단수주지급일
			if Trim(g_szFRSKDate) == "" then
				'안보이도록 처리
				Table021.SetCellMaskInfo(3, 1, "1,0,,,1,,0,0,1,0,0")
				Table021.SetCellString(3, 0, "")
				Table021.SetCellString(3, 1, "") 
			else
				Table021.SetCellString(3, 1, g_szFRSKDate) 
			end if 
			
		Case "03" '03	 배당(현금, 주식, 동시배당)	
			if g_szRghtNm == "현금배당" then
			
				'배당옵션이 있는 경우
				if g_bAllcation == "Y" then
					Table032.SetCellMaskInfo(1, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")				
					Table032.SetCellString(1, 1, grd1.GetCellData("bd_cell20", 0) ) '주당배당금
					'입금일				
					if Trim(grd1.GetCellData("bd_cell17",  0)) == "" then
						Table032.SetCellMaskInfo(2, 1,  "1,0,,,1,,0,0,1,0,0")
						Table032.SetCellString(2, 1, "미정") 
					else
						Table032.SetCellString(2, 1, grd1.GetCellData("bd_cell17",  0)) 
					end if				
					Table032.SetCellString(3, 1, grd1.GetCellData("bd_cell25", 0)) '현지원천세율	
					
					Table032.SetCellString(4, 1, grd1.GetCellData("bd_cell36", 0)) '배당옵션여부	
					
					'옵션기본값
					sTemp = Trim(grd1.GetCellData("bd_cell37", 0))
					if  sTemp == "1" then
						sTemp = "현금"
					elseif sTemp == "2" then
						sTemp = "주식"
					else
						sTemp = ""
					end if 					
					Table032.SetCellString(5, 1, sTemp) 	
					Table032.SetCellMaskInfo(6, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")
					Table032.SetCellString(6, 1, grd1.GetCellData("bd_cell40", 0) ) '재투자가격	
					'배당옵션기간				
					if Trim(grd1.GetCellData("bd_cell38", 0)) == "" or Trim(grd1.GetCellData("bd_cell39", 0)) == "" then
						Table032.SetCellMaskInfo(7, 1,  "1,0,,,1,,0,0,1,0,0")
						Table032.SetCellString(7, 1, "미정") 
					else
						Table032.SetCellString(7, 1, grd1.GetCellData("bd_cell38", 0) & grd1.GetCellData("bd_cell39", 0)) 
					end if						
					
'					'단수주지급일
'					if Trim(g_szFRSKDate) == "" then
'						'안보이도록 처리
'						Table032.SetCellMaskInfo(8, 1, "1,0,,,1,,0,0,1,0,0")  
'						Table032.SetCellString(8, 0, "") 
'						Table032.SetCellString(8, 1, "") 
'					else
'						Table032.SetCellString(8, 1, g_szFRSKDate) 
'					end if 
				
				else
					Table031.SetCellMaskInfo(1, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")				
					Table031.SetCellString(1, 1, grd1.GetCellData("bd_cell20", 0) ) '주당배당금
					'입금일				
					if Trim(grd1.GetCellData("bd_cell17",  0)) == "" then
						Table031.SetCellMaskInfo(2, 1,  "1,0,,,1,,0,0,1,0,0")
						Table031.SetCellString(2, 1, "미정") 
					else
						Table031.SetCellString(2, 1, grd1.GetCellData("bd_cell17",  0)) 
					end if				
					Table031.SetCellString(3, 1, grd1.GetCellData("bd_cell25", 0)) '현지원천세율				
'					'단수주지급일
'					if Trim(g_szFRSKDate) == "" then
'						'안보이도록 처리
'						Table031.SetCellMaskInfo(5, 1, "1,0,,,1,,0,0,1,0,0")  
'						Table031.SetCellString(5, 0, "") 
'						Table031.SetCellString(5, 1, "") 
'					else
'						Table031.SetCellString(5, 1, g_szFRSKDate) 
'					end if 
			
				end if 
				
			elseif g_szRghtNm == "주식배당" then
				'배당옵션이 있는 경우
				if g_bAllcation == "Y" then	
					Table034.SetCellString(1, 1, grd1.GetCellData("bd_cell21", 0) ) '주당배당률
					
					'입고일자
					if Trim(grd1.GetCellData("bd_cell18", 0)) == "" then
						Table034.SetCellMaskInfo(2, 1,  "1,0,,,1,,0,0,1,0,0")
						Table034.SetCellString(2, 1, "미정") 
					else
						Table034.SetCellString(2, 1, grd1.GetCellData("bd_cell18", 0))
					end if 
					
					Table034.SetCellString(3, 1, grd1.GetCellData("bd_cell25", 0)) '현지원천세율					
					Table034.SetCellString(4, 1, grd1.GetCellData("bd_cell36", 0)) '배당옵션여부
					
					'옵션기본값
					sTemp = Trim(grd1.GetCellData("bd_cell37", 0))
					if  sTemp == "1" then
						sTemp = "현금"
					elseif sTemp == "2" then
						sTemp = "주식"
					else
						sTemp = ""
					end if 					
					Table034.SetCellString(5, 1, sTemp) 
					Table034.SetCellMaskInfo(6, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")
					Table034.SetCellString(6, 1, grd1.GetCellData("bd_cell40", 0) ) '재투자가격	
					
					'배당옵션기간				
					if Trim(grd1.GetCellData("bd_cell38", 0)) == "" or Trim(grd1.GetCellData("bd_cell39", 0)) == "" then
						Table034.SetCellMaskInfo(7, 1,  "1,0,,,1,,0,0,1,0,0")
						Table034.SetCellString(7, 1, "미정") 
					else
						Table034.SetCellString(7, 1, grd1.GetCellData("bd_cell38", 0) & grd1.GetCellData("bd_cell39", 0)) 
					end if						
					
					'단수주지급일
					if Trim(g_szFRSKDate) == "" then
						'안보이도록 처리
						Table034.SetCellMaskInfo(8, 1, "1,0,,,1,,0,0,1,0,0")  
						Table034.SetCellString(8, 0, "") 
						Table034.SetCellString(8, 1, "") 
					else
						Table034.SetCellString(8, 1, g_szFRSKDate) 
					end if 
					'단수주가격
					if Trim(g_szFRSK) == "" then
						'안보이도록 처리
						Table034.SetCellMaskInfo(9, 1, "1,0,,,1,,0,0,1,0,0")  
						Table034.SetCellString(9, 0, "") 
						Table034.SetCellString(9, 1, "")
					else
						Table034.SetCellMaskInfo(9, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")
						Table034.SetCellString(9, 1, g_szFRSK)
					end if				
				else
	
					Table033.SetCellString(1, 1, grd1.GetCellData("bd_cell21", 0) ) '주당배당률
					
					'입고일자
					if Trim(grd1.GetCellData("bd_cell18", 0)) == "" then
						Table033.SetCellMaskInfo(2, 1,  "1,0,,,1,,0,0,1,0,0")
						Table033.SetCellString(2, 1, "미정") 
					else
						Table033.SetCellString(2, 1, grd1.GetCellData("bd_cell18", 0))
					end if 
					
					Table033.SetCellString(3, 1, grd1.GetCellData("bd_cell25", 0)) '현지원천세율	
					
					'단수주지급일
					if Trim(g_szFRSKDate) == "" then
						'안보이도록 처리
						Table033.SetCellMaskInfo(4, 1, "1,0,,,1,,0,0,1,0,0")  
						Table033.SetCellString(4, 0, "") 
						Table033.SetCellString(4, 1, "") 
					else
						Table033.SetCellString(4, 1, g_szFRSKDate) 
					end if 
					'단수주가격
					if Trim(g_szFRSK) == "" then
						'안보이도록 처리
						Table033.SetCellMaskInfo(5, 1, "1,0,,,1,,0,0,1,0,0")  
						Table033.SetCellString(5, 0, "") 
						Table033.SetCellString(5, 1, "")
					else
						Table033.SetCellMaskInfo(5, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")
						Table033.SetCellString(5, 1, g_szFRSK)
					end if
				end if 
				
			end if 
			
		Case "04" '04 합병
			Table041.SetCellString(1, 1, "[" & grd1.GetCellData("bd_cell31", 0) & "] " & grd1.GetCellData("bd_cell32", 0)) '합병전종목명
			Table041.SetCellString(2, 1, "[" & grd1.GetCellData("bd_cell33", 0) & "] " & grd1.GetCellData("bd_cell34", 0)) '합병후종목명
			Table041.SetCellString(3, 1, g_szASGM_RATE) '합병비율 
			
			if Trim(grd1.GetCellData("bd_cell18",  0)) == "" then
				Table041.SetCellMaskInfo(4, 1,  "1,0,,,1,,0,0,1,0,0")
				Table041.SetCellString(4, 1, "미정") 			
			else
				Table041.SetCellString(4, 1, grd1.GetCellData("bd_cell18", 0)) '입출고일자 		
			end if
			
			'단수주지급일
			if Trim(g_szFRSKDate) == "" then
				'안보이도록 처리
				Table041.SetCellMaskInfo(5, 1, "1,0,,,1,,0,0,1,0,0")   
				Table041.SetCellString(5, 0, "")
				Table041.SetCellString(5, 1, "")
			else
				Table041.SetCellString(5, 1, g_szFRSKDate) 
			end if 

		Case "05" '05 감자		
			Table051.SetCellString(2, 1, grd1.GetCellData("bd_cell22", 0)) '주당출고비율
			Table051.SetCellString(3, 1, grd1.GetCellData("bd_cell21", 0)) '주당입고비율
			
			if Trim(grd1.GetCellData("bd_cell18",  0)) == "" then
				Table051.SetCellMaskInfo(1, 1,  "1,0,,,1,,0,0,1,0,0")
				Table051.SetCellString(1, 1, "미정") 
			else
				Table051.SetCellString(1, 1, grd1.GetCellData("bd_cell18", 0)) '입출고일자
			end if
			
			'단수주지급일
			if Trim(g_szFRSKDate) == "" then
				'안보이도록 처리
				Table051.SetCellMaskInfo(4, 1, "1,0,,,1,,0,0,1,0,0")  
				Table051.SetCellString(4, 0, "")
				Table051.SetCellString(4, 1, "") 
			else
				Table051.SetCellString(4, 1, g_szFRSKDate) 
			end if			
			
		Case "06", "07" '06	액면분할, 07	액면병합				
			Table061.SetCellString(2, 1, grd1.GetCellData("bd_cell22", 0)) '주당출고비율
			Table061.SetCellString(3, 1, grd1.GetCellData("bd_cell21", 0)) '주당입고비율
			
			if Trim(grd1.GetCellData("bd_cell18",  0)) == "" then
				Table061.SetCellMaskInfo(1, 1,  "1,0,,,1,,0,0,1,0,0")
				Table061.SetCellString(1, 1, "미정")
			else
				Table061.SetCellString(1, 1, grd1.GetCellData("bd_cell18", 0)) '입출고일자
			end if
			
			'단수주지급일
			if Trim(g_szFRSKDate) == "" then
				'안보이도록 처리
				Table061.SetCellMaskInfo(4, 1, "1,0,,,1,,0,0,1,0,0")  
				Table061.SetCellString(4, 0, "") 
				Table061.SetCellString(4, 1, "") 
			else
				Table061.SetCellString(4, 1, g_szFRSKDate) 
			end if 
			'단수주가격
			if Trim(g_szFRSK) == "" then
				'안보이도록 처리
				Table061.SetCellMaskInfo(5, 1, "1,0,,,1,,0,0,1,0,0")  
				Table061.SetCellString(5, 0, "") 
				Table061.SetCellString(5, 1, "")
			else
				Table061.SetCellMaskInfo(5, 1, "0,0,,"& szCRCD & ",0,,-1,1,0,0,0")
				Table061.SetCellString(5, 1, g_szFRSK)
			end if			
			
		Case "09"  '09 코드변경		
			Table091.SetCellString(2, 1, "[" & grd1.GetCellData("bd_cell31", 0) & "] " & grd1.GetCellData("bd_cell32", 0)) '변경전코드
			Table091.SetCellString(3, 1, "[" & grd1.GetCellData("bd_cell33", 0) & "] " & grd1.GetCellData("bd_cell34", 0)) '변경후코드
			
			if Trim(grd1.GetCellData("bd_cell18",  0)) == "" then
				Table091.SetCellMaskInfo(1, 1,  "1,0,,,1,,0,0,1,0,0")
				Table091.SetCellString(1, 1, "미정") 
			else
				Table091.SetCellString(1, 1, grd1.GetCellData("bd_cell18", 0)) '입고일자
			end if
			
		Case "08" '08 회사분할	
			Table081.SetCellString(1, 1, "[" & grd1.GetCellData("bd_cell31", 0) & "] " & grd1.GetCellData("bd_cell32", 0))  '변경전종목
			Table081.SetCellString(2, 1, grd1.GetCellData("bd_cell21", 0)) '주당입고비율
			Table081.SetCellString(3, 1, "[" & grd1.GetCellData("bd_cell33", 0) & "] " & grd1.GetCellData("bd_cell34", 0))'변경후종목
			Table081.SetCellString(4, 1, grd1.GetCellData("bd_cell22", 0)) '주당입고비율
			
			if Trim(grd1.GetCellData("bd_cell18",  0)) == "" then
				Table081.SetCellMaskInfo(5, 1,  "1,0,,,1,,0,0,1,0,0")
				Table081.SetCellString(5, 1, "미정") 
			else
				Table081.SetCellString(5, 1, grd1.GetCellData("bd_cell18", 0)) '입고일자
			end if
			
			'단수주대금지급일
			if Trim(g_szFRSKDate) == "" then
				'안보이도록 처리
				Table081.SetCellMaskInfo(6, 1, "1,0,,,1,,0,0,1,0,0")
				Table081.SetCellString(6, 0, "")
				Table081.SetCellString(6, 1, "")
			else
				Table081.SetCellString(6, 1, g_szFRSKDate) 
			end if 

	End Select
end Function 

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim sTemp
	grd1.rowcount = 0	
	szData = Form.GetOpenLinkData()	
	if szData <> "" then
		grd1.AddRow(0)
		tData = Split(szData, "★")
		For i = 0 to grd1.colcount -1  ' 36개
			grd1.SetCellData("bd_cell"&CStr(i), 0, tData(i))
		Next				
		
		g_szItemCd = tData(7) '종목코드
		g_szItemNm = tData(8) '종목코드
		g_szRghtCd = tData(4) '권리유형코드
		g_szRghtNm = tData(5) '권리유형명
		g_szStatCd = tData(6) '상태처리코드
		g_szStndDate = tData(9) '기준일
		g_szWrhsDate = tData(20) '입고일
		lblItem.caption = "[" & g_szItemCd & "]" & g_szItemNm
		
		lblDate.caption = "기준일 "& Left(g_szStndDate, 4) &"."& Mid(g_szStndDate, 5, 2) &"."& Right(g_szStndDate, 2) 

		'단수주지급일
		g_szFRSKDate = Trim(grd1.GetCellData("bd_cell24", 0))		
		'단수주가격
		if grd1.GetCellData("bd_cell23", 0) <> nil then 
			g_szFRSK = CDbl(grd1.GetCellData("bd_cell23", 0))
			if g_szFRSK == "0" or g_szFRSK == 0 then
				g_szFRSK = ""
			'else
				'g_szFRSK = g_szFRSK & " " & grd1.GetCellData("bd_cell11", 0) '단수주가격
			end if
		else 
			g_szFRSK = ""
		end if
		
		'합병비율
		if grd1.GetCellData("bd_cell21", 0) <> nil and grd1.GetCellData("bd_cell22", 0) <> nil then
			g_szASGM_RATE = CDbl(grd1.GetCellData("bd_cell21", 0)) & " : " &  CDbl(grd1.GetCellData("bd_cell22", 0))
		else
			g_szASGM_RATE = ""
		end if
		
		'배당옵션여부
		g_bAllcation = grd1.GetCellData("bd_cell36", 0)		
		
		SetVisible()
		SetData()		
		
	else

	end if 
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnSave_OnClick()
	Form.CloseForm()	
End Sub

	</SCRIPT_INFO>
</ROOT>