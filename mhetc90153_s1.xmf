	<CONTROL_INFO>
		<CONTAINER name="Container0" ly_vert="0,0,375,647,1" scroll_ly_vert="0,0,375,647,1" >
			<CONTROL_INFO>
				<BUTTON name="Buttonok" caption="내려받기" fontsize="4" btnimage="btn_20.9" ly_vert="0,588,375,61,1" />
				<LABEL name="labTitle" fontsize="4" fontstyle="01" caption="클라우드인증서 내려받기" halign="1" ly_vert="0,0,375,60,1" />
				<LABEL name="lblSubTitle" fgcolor="321:115118124" caption="사용할 공동인증서 비밀번호를 설정해주세요." multiline="1" ly_vert="14,58,357,38,1" />
				<IMAGE name="ImgBackPress" imgpath="icon_arrow_left_on" ly_vert="17,15,24,33,1" />
				<CONTAINER name="contPwd" ly_vert="0,90,375,188,1" scroll_ly_vert="0,90,375,188,1" >
					<CONTROL_INFO>
						<EDIT name="EditPwd" fontsize="2" password="2" imetype="0" maxlength="30" minlength="10" hintcaption="사용할 비밀번호를 입력해주세요." imagefilepth="input_03.9" ly_vert="20,97,335,74,1" />
						<EDIT name="EditAcnt" fontsize="2" password="2" imetype="0" maxlength="30" minlength="10" hintcaption="사용할 비밀번호를 입력해주세요." imagefilepth="input_03.9" ly_vert="21,10,335,74,1" />
					</CONTROL_INFO>
				</CONTAINER>
			</CONTROL_INFO>
		</CONTAINER>
		<LABEL name="lblLine1" bgcolor="320:246247248" transmode="0" ly_vert="0,292,375,10,1" />
		<LABEL name="lblSubTitle0" fgcolor="334:034034034" caption="비밀번호 설정 규칙" multiline="1" ly_vert="15,308,360,38,1" />
		<LABEL name="lblSubTitle1" fgcolor="321:115118124" fontsize="-1" ly_vert="15,340,360,20,1" />
		<LABEL name="lblSubTitle2" fgcolor="321:115118124" fontsize="-1" ly_vert="15,360,360,20,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="7303" _ulen="6673" >

Dim g_Back_Flag   '뒤로가기플래그

g_Back_Flag = ""

Dim g_sCloudPwd
g_sCloudPwd = ""

Dim g_sCloudIndex
g_sCloudIndex = ""

'============================================================================
Sub Form_OnFormInitBefore()
	Container0.ImgBackPress.setMaintainingRatio("1")
	
	Form.transmode = false 'true 불투명, false 투명
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	g_MediaType   = Form.GetSharedData("&MEDIA_CODE"   , false)
	g_LoginType = Form.GetSharedData("&LOGIN_TYPE", false )
	
	Form.transmode = true 'true 불투명, false 투명
	Container0.contPwd.visible = true
	Container0.ButtonOk.enable = false

	Container0.contPwd.EditAcnt.SetApplyLabel("인증서 비밀번호" 	, 0, 267, "left", false)  'True.필수입력 / False.선택입력
	Container0.contPwd.EditPwd.SetApplyLabel("인증서 비밀번호 확인"	, 0, 267, "left", false)  'True.필수입력 / False.선택입력
	
	Container0.contPwd.EditAcnt.SetUseResultLabel(True, 1)	'True.사용가능 / False.사용불가, 라인수
	Container0.contPwd.EditPwd.SetUseResultLabel(True, 1)	'True.사용가능 / False.사용불가, 라인수
	Container0.lblSubTitle1.maxlinecnt = "-2^1"
	Container0.lblSubTitle2.maxlinecnt = "-2^1"
	
	lblSubTitle1.caption = " - 숫자,영문자(대/소문자 구분), 특수문자 포함"
	lblSubTitle2.caption = "    10자 이상~30자 이하"
	
	g_sCloudPwd = Form.GetSharedData("CLOUD_CERT_ORIGINAL_PWD", true)
	g_sCloudIndex = Form.GetSharedData("CLOUD_CERT_INDEX", true)

	Form.SetTimerEvent2(1, 1, 0.2)
End Sub
'============================================================================
Sub Container0_ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(CInt(sTimerID), 0, 0)

	if sTimerID == "1" or sTimerID == 1 then
		Container0.contPwd.EditAcnt.SetShowKeypad(True)
	elseif sTimerID == "2" or sTimerID == 2 then
		Container0.contPwd.EditPwd.SetShowKeypad(True)
	
	elseif sTimerID == "3" or sTimerID == 3 then
		'인덱스★로컬인증서비밀번호★클라우드인증PIN번호
		Form.requestCertCommand("CLOUD_REQ_CERT_DNLOAD", g_sCloudIndex & "★" & Container0.contPwd.EditPwd.caption2 & "★" & g_sCloudPwd, "90153") 	
	end if
	
End Sub

'============================================================================
'인증서 비밀번호
Sub Container0_contPwd_EditAcnt_OnEditComplete()
	bRslt = InputCheck("contPwd.EditAcnt", Container0.contPwd.EditAcnt.caption, True)
End Sub

'==============+=============================================================
'인증서 비밀번호 확인
Sub Container0_contPwd_EditPwd_OnEditComplete()

	Container0.ButtonOk.enable = True
	bRslt = InputCheck("contPwd.EditPwd", Container0.contPwd.EditPwd.caption, True)

	if bRslt then
		if Trim(Container0.contPwd.EditAcnt.caption) ~= Trim(Container0.contPwd.EditPwd.caption) then '신규 비밀번호 불일치
			Form.MsgBox( "안내", "인증서 비밀번호가 서로 일치하지 않습니다.", "", 6 )
		else
			DATAMANAGER.RequestTranData("obacp_comm_058r")
		end if
	end if
End Sub

'============================================================================
Function InputCheck(sType, sInput, bShowKeypad)
	if sType == "contPwd.EditAcnt" then
		if sInput == "" Then
			Container0.contPwd.EditAcnt.SetResultLabel("1","error","인증서 비밀번호를 입력해주세요.","Container0.contPwd")
	
			if bShowKeypad == True and g_Back_Flag <> "Y" then
				Form.SetTimerEvent2(1, 1, 0.2) '0.1초뒤 보안키패드 활성화
			end if	

			return False
		
		else
			'공백 체크
		    nLen = Container0.contPwd.EditAcnt.pwdlen
		    
		    If Cint(nLen) < 10 and Cint(nLen) > 30 Then
			    Container0.contPwd.EditAcnt.SetResultLabel("1","error","10자 이상 30자 이하로 입력해주세요.","Container0.contPwd")
		    else
				Container0.contPwd.EditAcnt.SetResultLabel("0","complete","","Container0.contPwd")
				
				if bShowKeypad == True And Container0.contPwd.EditPwd.caption == "" Or Container0.contPwd.EditPwd.caption == null then
					If g_Back_Flag <> "Y" Then
						Form.SetTimerEvent2(2, 1, 0.2) '0.1초뒤 보안키패드 활성화
					End If		
				end if
			end if
	    end if	
	
	
	elseif sType == "contPwd.EditPwd" then
		if sInput == "" Then
			Container0.contPwd.EditPwd.SetResultLabel("1","error","인증서 비밀번호를 입력해주세요.","Container0.contPwd")
			
			if bShowKeypad == True and g_Back_Flag <> "Y" then
				Form.SetTimerEvent2(2, 1, 0.2) '0.1초뒤 보안키패드 활성화
			end if	
			
			return False
	
		else
			nLen = Container0.contPwd.EditPwd.pwdlen
			
			If Cint(nLen) < 10 and Cint(nLen) > 30 Then
			   Container0.contPwd.EditPwd.SetResultLabel("1","error","10자 이상 30자 이하로 입력해주세요.","Container0.contPwd")
			else
				Container0.contPwd.EditPwd.SetResultLabel("0","complete","","Container0")
			end if
		end if	
	end if
	
	return true
End Function
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szTranID == "obacp_comm_058r" then
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			Form.MsgBox("안내", szErrMsg & "\n(" & sSubMsg & ")" , "", 0)
		end if
	
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacp_comm_058r" then
	
		'인덱스★로컬인증서비밀번호★클라우드인증PIN번호
		'Form.requestCertCommand("CLOUD_REQ_CERT_DNLOAD", g_sCloudIndex & "★" & Container0.contPwd.EditPwd.caption2 & "★" & g_sCloudPwd, "90153") 	
		
		Form.SetTimerEvent2(3, 1, 0.2)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obacp_comm_058r" then
		DATAMANAGER.SetDataValue(0, "obacp_comm_058r" , "InBlock1" , "PROS_CLS"     , 0 , "6")   				'처리구분(5: 변경 / 6: 신규)
		DATAMANAGER.SetDataValue(0, "obacp_comm_058r" , "InBlock1" , "PWD_PIP"      , 0 , Container0.contPwd.EditAcnt.caption2)    '신규비밀번호
		DATAMANAGER.SetDataValue(0, "obacp_comm_058r" , "InBlock1" , "CNFR_PWD_PIP" , 0 , Container0.contPwd.EditPwd.caption2)     '비밀번호확인
	end if
End Sub

'============================================================================
Sub Form_onTriggerEventCloudCert(sCommand, sResult)
	Dim sErrorCd, sErrorMsg

	szItem = Split(sResult,"★")

	'처리코드,처리메시지 처리
	sErrorCd		= szItem(0)
	sErrorMsg	= szItem(1)	

	'오류이면
	if sErrorCd <> "0" then
		Form.MsgBox("[에러1]" & sCommand, sErrorMsg, "", 0)
		exit sub
	end if	
	
	if sCommand = "CLOUD_REQ_CERT_DNLOAD_90153" then
		Form.OpenPopup("mhetc90150_p2" , "DownloadToLocal" , "")
	end if
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90150_p2" then
		if sRet == "DownloadToLocal" then
			Form.CloseForm()
		end if
	end if
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obacp_comm_058r" trcode="obacp_comm_058r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obacp_comm_058r" title="비밀번호 유효성 검증체크" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="485" _ulen="367" >

