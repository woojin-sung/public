	<SCRIPT_INFO _len="5047" _ulen="4637" >
'--===========================================================================
' 01. 화 면 명 : 당사/타사 대체출고결과팝업
' 02. 화면설명 : 당사/타사 대체출고결과팝업
' 03. 작    성 : 2022.05.11 김수진 
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szRet	'리턴값

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szRet = "ok"
	
	DIm szData, tList, tData
	szData = Form.GetOpenLinkData()
	tList = Split(szData, "♥")
	
	If UBOUND(tList) < 1 Then
		Exit Sub
	End If

	'상단 테이블 정보 셋팅
	tData = Split(tList[0], "★")
	DIm szType, szAltnAcntNo, szAltnAcntName, szAltnCom, szCommission, szAcntNo, szAcntName
	szType			= tData(0) '당사/타사구분값	
	szAltnAcntNo  	= tData(1) '입고계좌번호
	szAltnAcntName 	= tData(2) '입고계좌명
	szAltnCom		= tData(3) '상대기관
	szCommission		= tData(4) '수수료 합계
	szAcntNo  		= tData(5) '출고계좌번호
	szAcntName = Form.GetAccountInfo( szAcntNo , "name") '출고계좌명
	
	DIm nTnum, nYnum, nNnum, nRow	'총처리건수/성공 건수/ 불능 건수
	nTnum = tonumber(#tList - 1)
	nYnum = 0
	'그리드 아이텝 정보 셋팅
	If nTnum > 0 Then
		For i = 1 to #tList - 1 
			If Trim(tList[i]) <> "" Then
				grdList.AddRow()
				tData = {}
				tData = Split(tList[i], "★")
	
				nRow = tonumber(grdList.rowcount - 1)
				grdList.SetCellData( "bd_IscdNm"    , nRow, tData[0]  )
				grdList.SetCellData( "bd_Qty"       , nRow, tData[1]  )
				grdList.SetCellData( "bd_SuccessYN" , nRow, tData[2]  )
				
				If tData[2] == "완료" Then
					nYnum = nYnum + 1
					grdList.SetCellData( "bd_ReasonN"   , nRow, ""		)
				Else
					grdList.SetCellData( "bd_ReasonN"   , nRow, Trim(tData[3]))	
'					grdList.SetCellData( "bd_N"   , nRow, "ic_notice.png"		)
					grdList.SetCellData( "bd_N"   , nRow, "icon_warn.png"		)
				End If
				
				If tData[2] == "처리불가" Then
					grdList.SetCellFgColor("bd_SuccessYN", nRow, "6")
				End If
			End If
		Next
	End If
	nNnum = nTnum - nYnum
	
	tblInfo.SetCellString( 0, 2, szAcntNo 	) '출고계좌번호
	tblInfo.SetCellString( 0, 3, szAcntName) '출고계좌명
	tblInfo.SetCellString( 1, 1, szAltnCom 	) '상대기관
	tblInfo.SetCellString( 1, 2, szAltnAcntNo ) '입고계좌번호
	tblInfo.SetCellString( 1, 3, szAltnAcntName ) '입고계좌명
	
	tblInfo.SetCellString( 2, 0, "총 "..nTnum.."건" 		) 						'총 처리 건수
	tblInfo.SetCellString( 2, 1, "완료 "..nYnum.."건" .."/".."불능 "..nNnum.."건" ) 	'성공 건수/ 불능 건수
	
	If szType == "H" Then	'타사대체일경우
		tblInfo.SetCellString( 2, 3, szCommission 	)	'수수료
		tblInfo.SetCellMaskInfo(1, 2, "1,0,,,1,,0,1,1")
	Else
		tblInfo.SetCellString( 2, 3, "0" 			)
		tblInfo.SetCellMaskInfo(1, 2, "1,0,,,1,####-####-##,0,1,1")	'입고계좌번호
	End If
	
	Dim szRmndExstYn  '당일 매수체결잔고존재여부
	szRmndExstYn = Form.GetSharedData( "mbbnk61100_RmndExstYn", False )
	
	If szRmndExstYn == "Y" Then
		tblText.visible = true
	else
		tblText.visible = false
	End If
	
End Sub

'============================================================================
' grdList_OnClickUp(lRow, szCellID)
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	If szCellID == "bd_SuccessYN" or szCellID == "bd_N" Then
		Dim szSuccessYN
		szSuccessYN = grdList.GetCellData( "bd_SuccessYN", lRow )
		
		If szSuccessYN == "처리불가" Then
			Dim szReasonN
			szReasonN = grdList.GetCellData( "bd_ReasonN", lRow )
			Form.MsgBox("알림", szReasonN, "", "6")
		End If
	End If
End Sub


'============================================================================
' btnOk_OnClick - 취소
'============================================================================
Sub btnOk_OnClick()
	g_szRet = "ok"
	Form.CloseForm()
End Sub
'============================================================================
' btnMove_OnClick() - 등록
'============================================================================
Sub btnMove_OnClick()
	g_szRet = "move"
	Form.CloseForm()
End Sub

'============================================================================
' Form_OnFormClose() 
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbbnk61100_p5" , g_szRet)
End Sub



	</SCRIPT_INFO>
