		<IMAGE name="imgClose1" visible="0" autosize="1" imgpath="icon_close_w" ly_vert="340,200,7,7,0" />
		<LABEL name="LblClose0" visible="0" click="1" ly_vert="203,384,32,35,0" />
		<LABEL name="LblClose1" visible="0" click="1" ly_vert="328,194,32,35,0" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1438" _ulen="1434" >
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Table0.SetCellFgColor(0, 0, "200")
	Table1.SetCellFgColor(0, 0, "200")
	Table0.SetCellFgColor(1, 0, "200")
	Table1.SetCellFgColor(1, 0, "200")
	popdata = Form.GetOpenLinkData()
	if popdata = "tooltip0" then
		Image0.visible = true
		Table0.visible = true 
		imgClose0.visible = true
		LblClose0.visible = true
	elseif popdata = "tooltip1" then
		Image1.visible = true
		Table1.visible = true
		imgClose1.visible = true
		LblClose1.visible = true
	end if
End Sub 
'============================================================================
' btnClose_OnClick : 닫기
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()	
End Sub 
'============================================================================
Sub LblClose0_OnClick()
	Form.CloseForm()	
End Sub
'============================================================================
Sub LblClose1_OnClick()
	Form.CloseForm()	
End Sub
'============================================================================
Sub Form_OnFormInitBefore()
	imgClose0.SetMaintainingRatio("1")
	imgClose1.SetMaintainingRatio("1")
End Sub
''============================================================================
	</SCRIPT_INFO>
