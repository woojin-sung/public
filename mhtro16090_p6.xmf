		<IMAGE name="Image0" visible="0" autosize="1" imgpath="img_tooltip.9.png" ly_vert="21,379,218,60,0" />
		<TABLE name="Table0" visible="0" insidelinecolor="102:255255255" colcount="1" rowcount="2" outline="0000" transmode="1" designorder="1" ly_vert="25,386,180,40,0" >
			<COL_INFO ly_vert_width="180" />
			<ROW_INFO ly_vert_height="20,20" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" fgcolor="095:000000000" halign="0" line="0,0" caption="주문수량은 최근일의 종가와" fontsize="-3" autofontsize="1" impidxs="" />
				<CELL cell_ly="0,1,0,1" fgcolor="095:000000000" halign="0" line="0,0" caption="환율로 계산되어 산정됩니다." fontsize="-3" autofontsize="1" impidxs="" />
			</CELL_INFO>
		</TABLE>
		<IMAGE name="Image1" visible="0" autosize="1" imgpath="img_tooltip.9.png" ly_vert="36,189,328,60,0" />
		<TABLE name="Table1" visible="0" insidelinecolor="102:255255255" colcount="1" rowcount="2" outline="0000" transmode="1" designorder="1" ly_vert="40,196,304,40,0" >
			<COL_INFO ly_vert_width="304" />
			<ROW_INFO ly_vert_height="20,20" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" fgcolor="095:000000000" halign="0" line="0,0" caption="매도가능금액은 매도가능수량을 최근일의 종가와" fontsize="-3" autofontsize="1" impidxs="" />
				<CELL cell_ly="0,1,0,1" fgcolor="095:000000000" halign="0" line="0,0" caption="환율로 계산된 원화 환산 금액으로 제공됩니다." fontsize="-3" autofontsize="1" impidxs="" />
