		<EDIT name="edtPrc" autofontsize="1" fontsize="4" fontstyle="01" mask="0,0,, 원,0,,0,1,0,0,0" halign="2" imetype="1" maxlength="18" imagefilepth="alpha" ly_vert="102,261,169,34,1" />
		<BUTTON name="bntPrc" visible="0" btnimage="alpha" ly_vert="102,261,169,34,0" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="16347" _ulen="14863" >
Dim g_szAcnt, g_szAcntCd, g_szFullCd, g_szMk,g_szNowPrc, g_szUnit, g_szHigh, g_szLow, g_szGubun, g_szInner, g_szType, g_szPrc, g_szOrderTrType
Dim g_szCd
'============================================================================
Sub Form_OnFormInit()

	'20230713 htw start 주문가격 에디트 투명설정
	szDeviceOS = Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	
	if szDeviceOS == "2" then
		edtPrc.SetOnOffImage("alpha","alpha")
		edtPrc.imagefilepth = "alpha"
	end if
	'20230713 htw end 주문가격 에디트 투명설정

	imgBg.imgpath       = "alpha128"
	Dim szOpen
	Dim tData
	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")

	if UBound(tData) > 0 then
	'0=계좌 1=계좌 2=종목코드 3=현재가 4=종목마켓 5=호가 6=상한가 7=하한가 8=현금/신용 9=주문유형keydata 10=주문유형명 11=단가 12=주문유형currentindex 13=szPrc(환경설정에 등록한 사용자별 자동호가)
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)
		g_szFullCd = tData(2)
		
		'===20230620 htw start 매수화면에서 사용하는 Check_OrdType 함수로 413 tr 호출
		'20230710 htw start 함수로 코드 변경으로 수정
		g_szCd = fn_ItemCdToMCI(g_szFullCd)
'		g_szCd = right(g_szFullCd,6)
		'20230710 htw end 함수로 코드 변경으로 수정
		g_szInner = Form.GetItemCodeInfo(g_szCd, "innermarket")
		
		g_szNowPrc = tData(3)	'현재가
		g_szMk = tData(4)
		g_szUnit = tData(5)
		g_szHigh = tData(6)
		g_szLow = tData(7)
		g_szGubun = tData(8)'0현금1신용
		g_szType = tData(9)	'주문유형
		
		szTypeIdx = tData(12)	'주문유형idx
		g_szOrderTrType = Check_OrdType(szTypeIdx)
		
		if Trim(tData(11)) <> "" then
			g_szPrc = tData(11)
		else
			g_szPrc = tData(13)
		end if
		'===20230620 htw end 매수화면에서 사용하는 Check_OrdType 함수로 413 tr 호출
		
		if g_szGubun == "0" then
			tblAble.visible = true
			tblAbleSin.visible = false
		else
			tblAble.visible = false
			tblAbleSin.visible = true
		end if
		
		'=====================20230601 htw start 장전시간외,장후시간외 유형일 경우 단가에 숫자 입력으로 변경
		if g_szMk == "W" then
'			"00`보통(지정가)\r\n01`보통(IOC)\r\n02`보통(FOK)"
			lblPrc.caption = FormatNumber(g_szPrc,0).." 원"
			edtPrc.caption = g_szPrc
			DATAMANAGER.RequestTranData("obtrs_comn_413r")
		else
			if Trim(g_szInner) =="033" then		' 코넥스
'				"00`보통(지정가)\r\n01`시장가\r\n02`장후시간외"
				Select Case g_szType
					Case "01"	'시장가
						'매매유형 text
						g_szPrc = g_szHigh
						
						lblPrc.caption = FormatNumber(g_szPrc,0).." 원"
						edtPrc.caption = g_szPrc
						btnMinus.enable = false
						btnPlus.enable = false
						bntPrc.visible = true
						DATAMANAGER.RequestTranData("obtrs_comn_413r")
					Case "02"	'시간외종가
						DATAMANAGER.RequestTranData( "ohhts_1181_002r")'장후시간외 단가 표기용
						btnMinus.enable = false
						btnPlus.enable = false
						bntPrc.visible = true
					Case else	'보통
						lblPrc.caption = FormatNumber(g_szPrc,0).." 원"
						edtPrc.caption = g_szPrc
						DATAMANAGER.RequestTranData("obtrs_comn_413r")
				end select
			else
'				"00`보통(지정가)\r\n01`시장가\r\n02`조건부지정가\r\n03`최유리지정가\r\n04`최우선지정가\r\n05`보통(IOC)\r\n06`시장가(IOC)\r\n07`최유리(IOC)\r\n08`보통(FOK)\r\n09`시장가(FOK)\r\n10`최유리(FOK)\r\n11`장전시간외\r\n12`장후시간외\r\n13`시간외단일가"
				Select Case g_szType
					Case "01", "03", "04", "06", "07", "09", "10" 		' 시장/최유리/최우선지정가
						'매매유형 text
						g_szPrc = g_szHigh
		
						lblPrc.caption = FormatNumber(g_szPrc,0).." 원"
						edtPrc.caption = g_szPrc
						btnMinus.enable = false
						btnPlus.enable = false
						bntPrc.visible = true
						DATAMANAGER.RequestTranData("obtrs_comn_413r")
					Case "11"										' 장개시전시간외(전일종가)
						DATAMANAGER.RequestTranData( "ohhts_1001_029r")'장전시간외 단가 표기용
						
						btnMinus.enable = false
						btnPlus.enable = false
						bntPrc.visible = true
					Case "12"										' 시간외종가(현재가)
						DATAMANAGER.RequestTranData( "ohhts_1181_002r")'장후시간외 단가 표기용
						
						btnMinus.enable = false
						btnPlus.enable = false
						bntPrc.visible = true
					case else
						lblPrc.caption = FormatNumber(g_szPrc,0).." 원"
						edtPrc.caption = g_szPrc
						DATAMANAGER.RequestTranData("obtrs_comn_413r")
				End Select
			end if
		end if
		'=====================20230601 htw end 장전시간외,장후시간외 유형일 경우 단가에 숫자 입력으로 변경		
	end if
End Sub

'============================================================================
' Check_OrdType : 주문유형확인
'============================================================================
Function Check_OrdType(szTypeIdx)
	Dim szIdx
	szIdx = szTypeIdx
	
	if g_szType == "01" Then					'시장가 주문
		return "05"	
	elseIf g_szInner == "033" then				' 코넥스 
		Select Case szIdx
			Case "0"	'지정
				return "01"
			Case "1"	'시장
				return "05"
			Case "2"	'장후
				return "71"
		End Select
	elseIf g_szMk == "W" then					' ELW인경우 -  보통
		return "01"
	else '일반주문
		Select Case szIdx
			Case "0", "5", "8"	' 지정(일반, IOC, FOK)
				return "01"
			Case "1", "6", "9"	' 시장(일반, IOC, FOK)
				return "05"
			Case "2"				' 조건부
				return "06"
			Case "3", "7", "10"	' 최유리(일반, IOC, FOK)
				return "12"
			Case "4"				' 최우선
				return "13"   
			Case "11"			' 장전
				return "61"
			Case "12"			' 장후
				return "71"
			Case "13" 
				return "81" 		' 시간외단일가
		End Select 			
    End If
End Function

