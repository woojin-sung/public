	Form.CloseForm()
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'20230621 htw start 주문유형에 따른 가격 input 설정 변경
	'주문유형에 따른 주문단가
	Dim szPrc
	
	Select Case g_szOrderTrType
		Case "05", "12", "13", "61", "71"					'시장가,최유리,최우선 주문
			szPrc = "0"
		Case Else
			szPrc = g_szPrc
	End Select
	' ----------------------------------------------------------------------
	' 주문가능금액 조회
	' ----------------------------------------------------------------------	
	if szTranID = "obtrs_comn_413r" then	 
		DATAMANAGER.ClearInputData(0, "obtrs_comn_413r")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_413r", "InBlock1", "ACNO",          0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_413r", "InBlock1", "ASNO",          0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_413r", "InBlock1", "ISCD" ,         0, g_szFullCd)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_413r", "InBlock1", "ODER_UNPR",     0, szPrc)
		'20230621 htw end 주문유형에 따른 가격 input 설정 변경
		'20230620 htw start 주문유형에 따른 input 변경
'		DATAMANAGER.SetDataValue(0, "obtrs_comn_413r", "InBlock1", "ODER_CLS_CODE", 0, "01")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_413r", "InBlock1", "ODER_CLS_CODE", 0, g_szOrderTrType)
		'20230620 htw end 주문유형에 따른 input 변경
	elseif szTranID = "ohhts_1181_002r" then
		DATAMANAGER.ClearInputData(0, "ohhts_1181_002r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_1181_002r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_1181_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	elseif szTranID = "ohhts_1001_029r" then
		DATAMANAGER.ClearInputData(0, "ohhts_1001_029r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_1001_029r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_1001_029r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	end if

End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	if szTranID == "obtrs_comn_413r" then
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	end if
End Sub
'============================================================================
Sub btnMinus_OnClick()
	Calc_Price(1)
End Sub

'============================================================================
Sub btnPlus_OnClick()
	Calc_Price(0)
End Sub

'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn)
	Dim szPrc, szUnit, szHigh, szLow, szHyun
	
	szPrc  = g_szPrc
	szUnit = g_szUnit
	szHigh = g_szHigh
	szLow  = g_szLow
	szHyun = g_szNowPrc
	
	
	'=======================================================================
	'20221116 HWG START : (거래소 차세대) 호가단위 개선
	'=======================================================================
	
	'=======================================================================
	' ETN/ELW
	'=======================================================================
	if g_szMk == "Q" or g_szMk == "W" then
		szUnit = 5
		
	'=======================================================================
	' ETN/ELW 외
	'=======================================================================
	else
		szInnerMk = Form.GetItemCodeInfo(g_szCd, "innermarket")
		
		'=======================================================================
		' ETF
		'=======================================================================
		if szInnerMk = "013" then
			szUnit = 5
		
		'=======================================================================
		' KOSPI/KOSDAQ/KONEX/신주인수권/수익증권 등
		'=======================================================================
		else
			if CDbl(szPrc) < 2000 then
				szUnit = 1
			elseif (CDbl(szPrc) >= 2000 and CDbl(szPrc) < 5000) then
				szUnit = 5 
			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 20000) then
				szUnit = 10
			elseif (CDbl(szPrc) >= 20000 and CDbl(szPrc) < 50000) then
				szUnit = 50
			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 200000) then
				szUnit = 100
			elseif (CDbl(szPrc) >= 200000 and CDbl(szPrc) < 500000) then
				szUnit = 500
			elseif CDbl(szPrc) >= 500000 then
				szUnit = 1000
			end if
			
			if nGbn == 1 then
				if CDbl(szPrc) = 2000 then
					szUnit = 1
				elseif CDbl(szPrc) = 5000 then
					szUnit = 5 
				elseif CDbl(szPrc) = 20000 then
					szUnit = 10
				elseif CDbl(szPrc) = 50000 then
					szUnit = 50
				elseif CDbl(szPrc) = 200000 then
					szUnit = 100
				elseif CDbl(szPrc) = 500000 then
					szUnit = 500
				end if
			end if
		end if
	end if
	'20221116 HWG END
	
	'=======================================================================
	' +,- 버튼 클릭시 동작 
	'=======================================================================		
	
	'----------------------------------------------------------------------
	' ELW
	'----------------------------------------------------------------------
	if g_szMk = "W" then
		if Trim(szUnit) == "" then
			szUnit = "5"
		end if

		if Trim(szPrc) == "" then
			szPrc = szHyun
		else
			' + 버튼 클릭 /////////////////////////////
			if nGbn == 0 then							
				szPrc = CDbl(szPrc) + CDbl(szUnit)
			' - 버튼 클릭 ////////////////////////////	
			elseif nGbn == 1 then					
				if CDbl(szPrc) == 0 then		' 0상태에서 "-"선택시 현재가로 복귀
					szPrc = szHyun
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if
			end if
		end if
	
	
	' ----------------------------------------------------------------------
	' 그외 (코스피, 코스닥, KOTC, ETF, ETN ..)
	' ----------------------------------------------------------------------		
	else
		if Trim(szUnit) == "" then
			szUnit = "1"
		end if
		
		if Trim(szPrc) == "" then
			szPrc = szHyun
		else
			' + 버튼 클릭 /////////////////////////////
			if nGbn == 0 then							
			
			'20210216 SWJ START : 신주인수권 가격 +/- 버튼 입력오류 수정(상한가, 하한가 항상 0이어서 생긴 오류)
				if Left(g_szCd,1) == "J" then
					
					szPrc = CDbl(szPrc) + CDbl(szUnit)
					
					if szPrc <= 0 then
						szPrc = szHyun
					end if
				else
					if CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
						szPrc = szHigh
					elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀	
						szPrc = szLow
					else
						szPrc = CDbl(szPrc) + CDbl(szUnit)
					end if
				end if
				
			' - 버튼 클릭 ////////////////////////////
			elseif nGbn == 1 then
			
				if Left(g_szCd,1) == "J" then
					
					szPrc = CDbl(szPrc) - CDbl(szUnit)
					
					if szPrc <= 0 then
						szPrc = szHyun
					end if
				else
					if CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
						szPrc = szHigh		
					elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
						szPrc = szLow
					else
						szPrc = CDbl(szPrc) - CDbl(szUnit)
					end if
				end if
			'20210216 SWJ END
			end if
		end if
	end if
	g_szPrc = szPrc	
	lblPrc.caption = FormatNumber(g_szPrc,0).."원"
	edtPrc.caption = g_szPrc
	DATAMANAGER.RequestTranData("obtrs_comn_413r")
End Function
'============================================================================


'============================================================================
Sub tblAbleSin_OnClick(lRow , lColumn)
	Dim szAmt 
	szAmt = tblAbleSin.GetCellString(lRow , lColumn)
	
	if lRow == 1 and lColumn == 2 then
		Form.SendReturnToParent("mbtrs12000_pk_cash" , g_szPrc.."★"..szAmt)
		Form.CloseForm()
	elseif lRow == 3 and lColumn == 2 then
		Form.SendReturnToParent("mbtrs12000_pk_misu" , g_szPrc.."★"..szAmt)
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub tblAble_OnClick(lRow , lColumn)
	Dim szAmt
	szAmt = CInt(tblAble.GetCellString(lRow , lColumn))
	
	if lRow == 1 and lColumn == 2 then
		Form.SendReturnToParent("mbtrs12000_pk_cash" , g_szPrc.."★"..szAmt)
		Form.CloseForm()
	elseif lRow == 3 and lColumn == 2 then
		Form.SendReturnToParent("mbtrs12000_pk_misu" , g_szPrc.."★"..szAmt)
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_1181_002r" then'금일종가 표기
		g_szPrc = CInt(DATAMANAGER.GetDataValue( 0, "ohhts_1181_002r", "OutBlock1", "FID_OVTM_UNTP_OPRC" , 0 ))
		lblPrc.caption = FormatNumber(g_szPrc,0).." 원"
		edtPrc.caption = g_szPrc
		DATAMANAGER.RequestTranData("obtrs_comn_413r")
	elseif szTranID = "ohhts_1001_029r" then
		g_szPrc = CInt(DATAMANAGER.GetDataValue( 0, "ohhts_1001_029r", "OutBlock1", "FID_PRDY_CLPR" , 0 ))
		lblPrc.caption = FormatNumber(g_szPrc,0).." 원"
		edtPrc.caption = g_szPrc
		DATAMANAGER.RequestTranData("obtrs_comn_413r")
	end if
End Sub


'원장코드 > 시세종목코드
function fn_ItemCdToMCI(szCd)
	szResult = szCd
	
	'신주인수권(증서)/수익증권/ETN
	if (Left(szCd, 1) == "J" and len(szCd) == 9) or Left(szCd, 1) == "F" or left(szCd, 1) == "Q" then
		szResult = szCd
	'주식/KOTC/ELW
	else
		szResult = Trim(Mid(szCd,2,Len(szCd)))
	end if
	
	return szResult
end function

'============================================================================
Sub edtPrc_OnEditComplete()
	g_szPrc = edtPrc.caption
	DATAMANAGER.RequestTranData("obtrs_comn_413r")
End Sub

