Dim g_tData

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("종목별 상세현황")
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		'[0]: 계좌번호
		'[1]: 일련번호
		'[2]: 조회시작일자
		'[3]: 조회종료일자
		'[4]: 조회구분코드
		'[5]: 종목코드
		'[6]: 계좌상품코드
		g_tData = Split(szOpenData, "★")
		
		'해외주식 양도소득 과표 조회(종목별 상세내역)
		DATAMANAGER.RequestTranData( "obtro_stlm_440r" )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'해외주식 양도소득 과표 조회(종목별 상세내역)
	If szTranID == "obtro_stlm_440r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , g_tData[0] )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , g_tData[1] )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_STA_DATE" , 0 , g_tData[2] )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_FIN_DATE" , 0 , g_tData[3] )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "OVRS_STCK_EXCH_IDNO" , 0 , "%" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , g_tData[4] )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" , 0 , g_tData[5] )
		If g_tData[4] == "2" Or g_tData[4] == 2 Then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PRCD" , 0 , "%" )
		Else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PRCD" , 0 , g_tData[6] )
		End If
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'해외주식 양도소득 과표 조회(종목별 상세내역)
	If szTranID == "obtro_stlm_440r" Then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		If nCnt > 0 Then
			Dim nRow
			nRow = CInt(grdList.rowcount)
			
			For i = 0 To nCnt - 1
				'상단 타이틀 데이터 세팅
				If i == 0 Then
					Dim szName, szIscd
					szName = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "KOR_ISNM" , i )
					szIscd = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ISCD" , i )
					
					lblName.caption = szName
					lblCode.caption = szIscd
				End If
				
				Dim szQty
				szQty = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "DQTY" , i )
				
				Dim tTemp
				tTemp = Split(szQty, ".")
				If CLng(tTemp[1]) > 0 Then
					grdList.SetCellData("bd_qty", i, FormatNumber(szQty, 6))
				Else
					grdList.SetCellData("bd_qty", i, FormatNumber(szQty, 0))
				End If
			Next
		End If
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	If szSubMsg <> "" And szSubMsg <> null Then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	Else
		Form.ShowAlert("알림", szErrMsg)
	End If
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData( "obtro_stlm_440r" ) Then
		DATAMANAGER.RequestNextData( "obtro_stlm_440r" )
	End If
End Sub

