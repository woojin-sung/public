'============================================================================
Sub Form_OnFormInit()
'	Dim sText

	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)	'v005
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v002
	
	g_sAcc = Account0.caption
	g_sCSNO = ""
	g_sKYC_INVT_INCL_GRAD_CODE = ""
	g_sKYC_PROD_GRAD_CODE = ""
	g_sKYC_DVPD_EPMD_CODE = ""
	g_sKYC_DRVT_PROS_YN = ""
	g_sDVPD_GRAD_CODE = ""
	G_KYC_FILE = "mbonl81010_p1"
	EditPW.caption = ""
	
'	sText = "<html><body>상장지수증권 거래에 관한 위험고지<br><br>"..
'			"본 고지서는 관계법규에 따라 고객이 상장지수증권을 거래하기 전에 거래에 따른 대표적인 위험을 사전에 충분히 인지할 수 있도록 금융투자회사가 고객에게 교부하는 것입니다.<br><br>"..			
'			"※ 상장지수증권은 주식ㆍETF 등과 거래방법이 거의 유사하나, 만기가 있는 파생결합증권으로서 상품의 성격 및 위험의 종류 등에서 주식ㆍETF와는 차이가 있는 다른 상품입니다.<br><br>"..
'			"1. 증권회사가 자기신용으로 발행하는 파생결합증권이므로 발행 증권회사의 부도 등 급격한 재무적 위험상황이 발생될 경우 투자자금의 일부 또는 전부를 회수하지 못할 수 있습니다.<br>"..
'			"* 다만, 이러한 발행회사의 신용위험을 최소화하기 위해 일정수준 이상의 신용등급과 규모를 갖추고 감사의견이 적정한 회사에 대해서만 상장지수증권을 발행할 수 있도록 제한하고 있습니다.<br><br>"..
'			"2. 파생결합증권의 특성상 기초자산인 지수(기초지수라 합니다) 수익률에 따라 수익률이 결정되므로 기초지수의 하락에 따른 원금손실 위험이 있습니다.<br>"..
'			"- 상장지수증권의 상품구조 및 기초지수 구성요소에 따라 수익ㆍ손실률이 크게 달라질 수 있으며, 파생상품과  같이 레버리지 효과가 발생될 수도 있습니다.<br>"..
'			"- 이와 같이 투자위험을 동반하는 상품인 만큼, 투자자는 해당 종목의 투자설명서 등(*)을 통해 상품구조, 기초지수의 종류, 연동방법과 과거 추이 등을 정확히 이해하고 확인한 후 투자판단을 하여야 합니다.<br>"..
'			"* 투자설명서 등은 금감원(http://dart.fss.or.kr/), 거래소(http://etn.krx.co.kr/), 발행증권사 홈페이지 등에서 확인 가능합니다.<br>"..
'			"- 만일, 투자설명서등을 통해서도 이해가 되지 않는 경우에는 자세한 설명을 요구하는 등 증권회사 직원에게 적극적으로 도움을 구하시기 바랍니다.<br><br>"..
'			"3. 레버리지가 있는 상품인 경우에는 원래 가격제한폭에 해당 레버리지 배율이 적용됨에 따라 가격제한폭이 확대되는 효과가 발생됩니다.<br>"..
'			"* [예시: 가격제한폭 30% * 레버리지 2배인 경우] 30% * 2 = 60%<br>"..
'			"- 상장시장의 가격제한폭에 따라 기초지수가 가격제한폭을 초과하여 상승하더라도 가격제한폭 내로 수익이 제한 될 수 있습니다.<br>"..
'			"* 다만, 반대로 기초지수가 가격제한폭을 넘어 큰 폭으로 하락하는 경우에는 손실범위가 가격제한폭으로 제한되는 효과가 있을 수도 있습니다.<br>"..
'			"- 또한, 해외지수 등 기초지수가 가격제한폭을 초과하여 등락이 발생하거나 일시적으로 유동성 공급물량이 부족할 경우 시장가격이 지표가치*와 크게 차이가 발생할 수 있습니다.<br>"..
'			"* 제3의 기관이 공정하고 객관적으로 산출하는 상장지수증권의 평가가치를 말합니다.<br><br>"..
'			"4. 발행회사나 해당 상품이 일정 수준에 미달하는 경우<br>"..
'			"* 상장폐지가 될 수 있으며, 이 경우 발행조건의 변경(조기상환) 및 평가손실의 확정 등이 발생될 위험이 있습니다.<br>"..
'			"* 발행회사의 인가취소, 자기자본 감소, 신용등급 하락, 기초지수 산출 불가, 발행ㆍ거래규모 미달 등<br><br>"..
'			"5. 투자시점 대비 중도상환 또는 만기상환의 기초지수가 보합이거나 약간 상승한 경우에도 각종비용으로 인해 원금손실이 발생될 위험도 있습니다.<br>"..
'			"- 해외 주식 등과 같이 해외 자산에 투자하는 기초지수의 경우 세제 차이 등이 수익에 일부 영향을 미칠수도 있습니다. <br><br>"..
'			"위 사항들은 상장지수증권 거래에 수반되는 위험 등에 대해 투자자가 알아야 할 사항을 간략하게 서술한 것으로 상장지수증권과 관련된 모든 위험을 기술한 것은 아닙니다. 따라서 상세한 내용은 회사에게 확인하여야 합니다.<br>"..
'			"또한 본 고지 내용은 발행회사의 투자설명서 내용이나 국내외 관계법규 등에 우선하지 못한다는 점을 양지하시기 바랍니다."
'			&"</body></html>"
    'v0001 URL로 변경
	'WebView0.loaddata = sText
	
	If g_ServerMode == "1" Then	'운영 'v006 3-> 1(test) 0 (운영)
		WebView0.urlpath = "http://testhome.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_08.html"
	else
		WebView0.urlpath = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_08.html"
	end if
	
	sREG_SRNO = ""
	g_nYesonNo = 0
	
	'v004 STA
	chkProvision.checkstate = "0"
	g_szFnprJoinSrno = ""
	g_szSvcSrno = ""
	'v004 FIN
	
	SetRequestData()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'-----------------------------------
	' 투자성향진단
	'-----------------------------------		
	if sKeyName == "KYCCHK_RETURN" then
		if sRet == "Y" then			'700 = N,X 정상리턴
			g_sKYC_INVT_INCL_GRAD_CODE = Form.GetSharedData( "KYC_INVT_INCL_GRAD_CODE", false )
			g_sKYC_PROD_GRAD_CODE = Form.GetSharedData( "KYC_PROD_GRAD_CODE", false )
			g_sKYC_DVPD_EPMD_CODE = Form.GetSharedData( "KYC_DVPD_EPMD_CODE", false )
			g_sKYC_DRVT_PROS_YN = Form.GetSharedData( "KYC_DRVT_PROS_YN", false )
			g_sDVPD_GRAD_CODE = Form.GetSharedData( "DVPD_GRAD_CODE", false )
			
			sSTND_DATE = Form.GetSharedData("KYC_STND_DATE", false)
			sREG_SRNO = Form.GetSharedData("KYC_REG_SRNO",false)
			
			if Trim(sREG_SRNO) <> "" or Trim(sREG_SRNO) <> Null then
				g_nYesonNo = 1
			else
				g_nYesonNo = 0
			end if
			DATAMANAGER.RequestTranData( "obpds_srvc_045a" ) '거래신청
		end if
		
	'-----------------------------------
	' 서류제공방식선택팝업 (mbonl81010_p16) v004 STA
	'-----------------------------------			
	elseif sKeyName == "ok_mbonl81010_p16" then
		If Trim(sRet) == "OK" then
			chkProvision.checkstate = "1"	
		else
			chkProvision.checkstate = "0"
		end if		
	'v004 FIN
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			g_FinCustomer = "Y"
			DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
		elseif sRet == "CANCEL_mbonl81010_p20" then
'			g_FinCustomer = "N"

			'가입중단시 처리미완료인경우 메뉴트리로 빠지도록 함 (2023.06.14)
			tRst = Form.GetSharedData( "81010_P20_RST" , false )
			if trim(tRst) <> "Y" then
				Form.OpenMainMenuWithIndex(0,1,0)
			end if
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sACNT_PWD 
'	sACNT_PWD = Form.GetCtlProp( "EditPW", "caption" )
'	sACNT_PWD = Form.GetEncData(sACNT_PWD) 'v002
	'v002
	If g_PlainRm = "1" Then '보안모듈 적용
		sACNT_PWD = Form.GetCtlProp( "EditPW", "caption" ) 'v002
	Else
		'화면 최초오픈시에는 비밀번호가 Null 이므로 GetCtlprop()오류발생/GetCtlProp()와 GetEncData() 분리
		'sACNT_PWD = Form.GetEncData(Form.GetCtlProp( "EditPW", "caption" )) 'v002
		sACNT_PWD = Form.GetCtlProp( "EditPW", "caption" )
		sACNT_PWD = Form.GetEncData(sACNT_PWD)
	End If
	
	if szTranID == "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_000r", "InBlock1", "PROS_CLS_CODE" , 0 , "I" )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_000r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_000r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
	elseif szTranID == "obpds_srvc_323r" then
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_323r", "InBlock1", "CSNO" , 0 , g_sCSNO )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_323r", "InBlock1", "SVCD" , 0 , "065" )
	elseif szTranID == "obpds_srvc_045a" then
'		Dim sCSNO, sSTND_DATE, sREG_SRNO
'		sCSNO = Form.GetSharedData("KYC_CSNO", false)
'		sSTND_DATE = Form.GetSharedData("KYC_STND_DATE", false)
'		sREG_SRNO = Form.GetSharedData("KYC_REG_SRNO",false)
		
		if g_nYesonNo <> 1 then
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "STND_DATE" , 0 , sSTND_DATE )
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "REG_SRNO" , 0 , sREG_SRNO )
		
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0 , g_sKYC_INVT_INCL_GRAD_CODE )
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "KYC_PROD_GRAD_CODE" , 0 , g_sKYC_PROD_GRAD_CODE )
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "KYC_DVPD_EPMD_CODE" , 0 , g_sKYC_DVPD_EPMD_CODE )
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "KYC_DRVT_PROS_YN" , 0 , g_sKYC_DRVT_PROS_YN )
			
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "PROS_YN" , 0 , "Y" )
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , "02" )
		end if
		
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE" , 0 , "I" )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "CSNO" , 0 , g_sCSNO )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "SVCD" , 0 , "065" )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "SVC_MANG_UNIT_CODE" , 0 , "01" )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )		
	elseif szTranID == "obcsb_acif_700r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_700r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_700r", "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , "02" ) '서비스약정
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_700r", "InBlock1", "BSWR_DIV_CODE" , 0 , "17160" ) 'ETN거래신청
