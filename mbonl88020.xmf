'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acif_000r" then	
		g_sCSNO = DATAMANAGER.GetDataValue( 0, "obcsb_acif_000r", "OutBlock1", "CSNO" , 0 )
		
		DATAMANAGER.RequestTranData( "obpds_srvc_323r" ) '신청내역조회
	elseif szTranID == "obpds_srvc_323r" then
		Dim sCode
		
		sCode = DATAMANAGER.GetDataMsgCode( "obpds_srvc_323r" )
		
		if sCode == "5766" then
			Table0.SetCellString( 0, 1, "등록" )
			btnProvision.enable = false	'v004
			btnModiTel.enable = false	'v004
			ButtonOK.enable = false 'v007
			
			g_FinCustomer = "Y"
		else
			Table0.SetCellString( 0, 1, "미등록" )
			btnProvision.enable = true	'v004
			btnModiTel.enable = true	'v004			
			ButtonOK.enable = true 'v007
		end if
		
'		DATAMANAGER.RequestTranData( "obcsb_acif_700r" ) '고객투자성향조회
	elseif szTranID == "obpds_srvc_045a" then
		Dim sMsg, sSubMsg
		sMsg = DATAMANAGER.GetDataMsgText( szTranID )
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			sMsg = sMsg.." "..sSubMsg
		end if
		Form.MsgBox( "알림", sMsg, "", 6 )
		
		'v004 STA
		g_szSvcSrno = tostring(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SVC_SRNO" , 0))
		DATAMANAGER.RequestTranData( "obcsb_dbif_322a" ) 
		'v004 FIN
		
	elseif szTranID == "obcsb_acif_700r" then
		g_sKYC_INVT_INCL_GRAD_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acif_700r", "OutBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0 )
		g_sKYC_PROD_GRAD_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acif_700r", "OutBlock1", "KYC_PROD_GRAD_CODE" , 0 )
		g_sKYC_DVPD_EPMD_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acif_700r", "OutBlock1", "KYC_DVPD_EPMD_CODE" , 0 )
		g_sKYC_DRVT_PROS_YN = DATAMANAGER.GetDataValue( 0, "obcsb_acif_700r", "OutBlock1", "KYC_DRVT_PROS_YN" , 0 )
		g_sDVPD_GRAD_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acif_700r", "OutBlock1", "DVPD_GRAD_CODE" , 0 )
	elseif szTranID == "obcsb_acif_705u" then
		'v004 STA
		chkProvision.checkstate = "0"
		g_szFnprJoinSrno = ""
		g_szSvcSrno = ""
		'v004 FIN
		SetControlViewClear()
		DATAMANAGER.RequestTranData( "obpds_srvc_323r" ) '신청내역조회
		
	'v004 STA
	elseif szTranID	= "obsap_acif_999a" then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		Form.SetSharedData( "FNPR_JOIN_SRNO", g_szFnprJoinSrno )
		
		Form.SetSharedData("SPCL_CNFR_ACNO", Account0.caption )
		Form.OpenPopup("mbonl81010_p20" , "" , "")	'2023.05.22 금융소비자 팝업 추가
		
'		If g_szFnprJoinSrno <> "" Then
'			Form.OpenPopup("mbonl81010_p16" , Account0.total & "★" & g_szFnprJoinSrno, "")
'		End If
	elseif szTranID	= "obcsb_dbif_322a" then		
		DATAMANAGER.RequestTranData( "obcsb_acif_199a" )
	elseif szTranID == "obcsb_acif_199a" then 
		Dim sSUCS_YN
		sSUCS_YN = Form.GetSharedData("KYC_SUCS_YN", false)
		
		if sSUCS_YN == null or sSUCS_YN == "" or sSUCS_YN ~= "Y" then
			'v004 STA
			chkProvision.checkstate = "0"
			g_szFnprJoinSrno = ""
			g_szSvcSrno = ""
			'v004 FIN
			SetControlViewClear()
			DATAMANAGER.RequestTranData( "obpds_srvc_323r" ) '신청내역조회
		else
			DATAMANAGER.RequestTranData( "obcsb_acif_705u" ) '고위험상품가입여부처리
		end if
	'v004 Fin 		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obpds_srvc_323r" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	elseif szTranID == "obpds_srvc_045a" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	'v004 STA
	elseif szTranID == "obcsb_dbif_322a" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	'v004 FIN
	end if
End Sub

'============================================================================
' 계좌 변경
'============================================================================
Sub Account0_ChangeAccount()
	g_sAcc = Account0.caption

	EditPW.caption = ""
	'v004 STA
	chkProvision.checkstate = "0"
	g_szFnprJoinSrno = ""
	g_szSvcSrno = ""
	'v004 FIN
	SetRequestData()
End Sub

'============================================================================
' 비밀번호 입력
'============================================================================
Sub EditPW_OnEditComplete()
'	SetRequestData()

'	if g_szFnprJoinSrno <> "" and g_szFnprJoinSrno <> null then
	if trim(Table0.GetCellString(0,1)) <> "등록" then
		DATAMANAGER.RequestTranData( "obsap_acif_999a" ) 'v007 금융상품 일련번호 GET
	end if
'	else
'		DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
'	end if
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if GetPWCkeck() then
		Exit Sub
	end if
	
	if Table0.GetCellString( 0, 1 ) == "등록" then
		Form.MsgBox( "알림", "이미 등록 되었습니다.", "", 6 )
		Exit Sub
	end if
	
	'서류제공방식체크 v004 STA
	If chkProvision.checkstate == 0 or chkProvision.checkstate == "0" Then
		Form.ShowAlert( "알림" , "서류 제공방식을 선택하세요.")
		Exit Sub		
	End If
	'v004 FIN
	
	If g_FinCustomer <> "Y" Then
		Form.MsgBox("알림", "전문, 일반 금융소비자를 확인 바랍니다.", "Show_mbonl81010", "1")
		Exit Sub		
	End If
	
	Dim sSendData 
	sSendData = "88020★"..Left(g_sAcc, 8).."★"..EditPW.caption
	Form.OpenPopup(G_KYC_FILE , sSendData , "")
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("KYC_SUCS_YN", "")		
	Form.SetSharedData("KYC_CSNO", "")
	Form.SetSharedData("KYC_STND_DATE", "")
	Form.SetSharedData("KYC_REG_SRNO", "")
	Form.SetSharedData("FNPR_JOIN_SRNO", "" )
	Form.SetSharedData("mbonl81010_p16_LOAN_YN", "")
End Sub

'============================================================================
' btnModiTel_OnClick() : 연락처 변경 v004
'============================================================================
Sub btnModiTel_OnClick()
	chkProvision.checkstate = "0"
	Form.OpenFramePopup( "mbonl81000" , "" , "")	'연락처변경
End Sub

'============================================================================
' btnProvision_OnClick() : 서류제공방식선택 > obsap_acif_999a > mbonl81010_p16 호출  v004
'============================================================================
Sub btnProvision_OnClick()
	if GetPWCkeck() then
		Exit Sub
	end if
	
	If Account0.total <> "" and Account0.total <> null Then
		If g_szFnprJoinSrno <> "" Then
			Form.SetSharedData("mbonl81010_p16_LOAN_YN", "Y")	'Y로 넘기면 처리완료 팝업이 안뜸..
			Form.OpenPopup("mbonl81010_p16" , Account0.total & "★" & g_szFnprJoinSrno, "")
'		Else
'			DATAMANAGER.RequestTranData( "obsap_acif_999a" ) 'v004 금융상품 일련번호 GET
		End If
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "Show_mbonl81010" then
		if sRet == "ok" then
			Form.OpenPopup("mbonl81010_p20" , "" , "")
		end if
	end if
End Sub



