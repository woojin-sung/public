Dim g_sDVPD_GRAD_CODE '파생상품등급코드
Dim G_KYC_FILE '투자성향체크풀팝업
Dim sCSNO, sSTND_DATE, sREG_SRNO		'고객번호, 기준일자, 등록일련번호
Dim g_nYesonNo	'투자성향 체크
Dim	g_PlainRm 'v002

'v004 STA
Dim g_szFnprJoinSrno		'금융상품일련번호
DIm g_szSvcSrno			'서비스 일련번호
'v004 FIN

dim g_ServerMode			'서버타입 v005

Dim g_FinCustomer 		'금융소비자 팝업 진행상태
'****************************************************************************
