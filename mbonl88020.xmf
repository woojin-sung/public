Dim g_sAcc '계좌번호
Dim g_sCSNO '고객번호
Dim g_sKYC_INVT_INCL_GRAD_CODE 'KYC투자성향등급코드
Dim g_sKYC_PROD_GRAD_CODE 'KYC상품등급코드
