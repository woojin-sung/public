<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="90060" scrname="인증서_내보내기풀팝업" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<LABEL name="Label0" fgcolor="063:255255255" fontsize="5" caption="인증서 내보내기" bgcolor="064:188030030" transmode="0" halign="1" ly_vert="0,0,375,40,1" />
		<IMAGE name="Image0" autosize="1" imgpath="icon_main_03" ly_vert="343,8,24,24,1" />
		<LINKFORM name="LinkForm0" ly_vert="0,40,375,562,1" />
		<BUTTON name="ButtonOK" visible="0" caption="확인" fgcolor="128:188030030" btnimage="btn_pop2.9.png" ly_vert="187,602,188,45,0" />
		<BUTTON name="ButtonCancel" visible="0" caption="이전" fgcolor="004:000000000" btnimage="btn_pop1.9.png" ly_vert="0,602,187,45,0" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="4354" _ulen="4102" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 인증서
' 02. 화면설명 : 인증서_내보내기풀팝업
' 03. 작    성 : 2016.01.13 김보라
'-------------------------------------------------------------------------------------------
'20201126 SWJ START : 공인인증서 '공인' 글자 삭제
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim G_CERT_LIST_FILE '인증서목록화면
Dim G_CERT_PWCONFIRM_FILE '인증서비밀번호확인화면
Dim G_CERT_EXPORT_FILE '인증서내보내기화면
Dim g_nStepIndex '목록0, 비밀번호확인1, 내보내기2

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' 단계별 화면변경
'============================================================================
Function SetControlChange()	
	Dim sFlag, sHeight	
	sHeight = "562"
	
	if g_nStepIndex == 0 then
		sFlag = "0"
		sHeight = "607"

		LinkForm0.linkfile = G_CERT_LIST_FILE
	elseif g_nStepIndex == 1 then
		sFlag = "1"
		ButtonOK.caption = "확인"
			
		LinkForm0.linkfile = G_CERT_PWCONFIRM_FILE
	elseif g_nStepIndex == 2 then
		sFlag = "1"
		ButtonOK.caption = "내보내기"
			
		LinkForm0.linkfile = G_CERT_EXPORT_FILE
		
	else
		sFlag = "0"
		LinkForm0.linkfile = ""
	end if
	
	LinkForm0.height = sHeight
	ButtonCancel.visible = sFlag
	ButtonOK.visible = sFlag
	Form.triggerEvent( "LinkForm0", "TabChange", "export" )
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	G_CERT_LIST_FILE = "mhetc90060_s1"
	G_CERT_PWCONFIRM_FILE = "mhetc90060_s2"
	G_CERT_EXPORT_FILE = "mhetc90060_s3"
	g_nStepIndex = 0
	
	SetControlChange()	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "NextStep" then
		if g_nStepIndex < 2 then
			g_nStepIndex = g_nStepIndex+1
			
			SetControlChange()
		elseif g_nStepIndex == 2 then
			'내보내기 실행
			Dim sDN, sNum 
			sDN = Form.GetSharedData("CERT_DN" , false)
			sNum = Form.GetSharedData("CERT_EXPORT_NUM" , false)
			
			Form.RequestCertCommand( "ReqCertFileExport", sDN, sNum )
		end if
	elseif sEventName == "BeforeStep" then
		if g_nStepIndex > 0 then
			g_nStepIndex = g_nStepIndex-1
			
			SetControlChange()
		end if
	end if
End Sub

'============================================================================
Sub Form_OnCertEvent(sType, sParam1, sParam2)
	if sType == "RetCertFileExport" then
		if sParam1 == "Success" then
			Form.SendReturnToParent( "mhetc90060_p1" , "ok" )
			Form.CloseForm( )
		else
		
			'20170410 LES START - 인증번호 불일치시 에러메세지 수정
			if InStr(sParam2,"PT117") == 0 then
				Form.MsgBox( "알림", sParam2, "", 6 )
			
			else
				Form.MsgBox("알림","[PT117] 인증번호가 일치하지 않습니다.", "", 6)
			end if
			'20170410 LES END
			
		end if
	end if
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.triggerEvent( "LinkForm0", "BeforeCheck", "" )	
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if g_nStepIndex < 3 then
		Form.triggerEvent( "LinkForm0", "NextCheck", "" )	
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("CERT_DN" , "")
	Form.SetSharedData("CERT_INDEX" , "")
	Form.SetSharedData("CERT_EXPORT_NUM" , "")
End Sub

	</SCRIPT_INFO>
</ROOT>