			Case"17"
				Label17.caption = "1"
			Case "18"
				Label18.caption = "1"
			Case "19"
				Label19.caption = "1"
			Case "34"
				Label34.caption = "1"
				
			'v0002
			Case "54"
				Container1.chk54.checkstate = "1"
			Case "55"
				Container1.chk55.checkstate = "1"
			Case "56"
				Container1.chk56.checkstate = "1"
			Case "57"
				Container1.chk57.checkstate = "1"
			Case "58"
				Container1.chk58.checkstate = "1"
			Case "59"
