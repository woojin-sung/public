'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	if szTranID == "obpds_srvc_030a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.MsgBox("알림", szErrMsg.."("..szSubErr..")" , "", 0)
		btnSearch_OnClick()
	end if
End Sub

'============================================================================
' btnCancel_OnClick
'============================================================================
Sub btnCancel_OnClick()
	if g_szAccountPassword == "" or Form.GetCtlProp( "#edtPassword", "caption") == "" then
		Form.MsgBox("알림", "계좌 비밀번호를 입력하세요.", "", 0)
		exit sub
	end if
	
	Form.MsgBox("알림", "알리미 서비스를 해지하시겠습니까?\n(계좌일반도 해지되므로 체결통보만\n해지하시는 경우 체크를 해지하시고\n신청/변경을 선택하세요)", "btnCancelOK", 1)
End Sub


'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "btnCancelOK" then
		if sRet == "ok" then
			if g_szAPRV <> "" then
				g_szPros = "D"
				Call TR_Inquiry("obpds_srvc_030a")	'알리미 이메일 약정
				btnSearch_OnClick()
				InitCheckSetting()
			end if
		else
			Form.MsgBox("알림", "해지 신청이 취소되었습니다.", "", 0)
			
		end if	
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()

	btnEnroll.enable = false
	
End Sub

