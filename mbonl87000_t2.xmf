				Container1.chk64.checkstate = "1"
			Case "65"
				Container1.chk65.checkstate = "1"			
			End Select			
		next		
		btnEnroll.enable = false
	end if
	
	
	if szTranID == "obcsb_acad_002r" then	'고객연락처정보조회
		
		if Container0.GridPro0.rowcount > "0" then
			Container0.GridPro0.SetClear( )
			Container0.Grid0.SetClear( )
		end if
		
		for i=0 to DATAMANAGER.GetDataCount(0,"obcsb_acad_002r", "OutBlock3" )-1
			
			if DATAMANAGER.GetDataValue(0,"obcsb_acad_002r", "OutBlock3", "INAG_TYPE_CODE" , i) == "13" then
				Container0.GridPro0.insertrow = 0
				Container0.GridPro0.SetCellData( "bd_cell0", 0,  DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i))
				Container0.GridPro0.SetCellData( "bd_cell2", 0,  DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "TONO" , i))
				Container0.GridPro0.SetCellData( "bd_cell3", 0,  DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i))
			end if
			
			if DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i) == "" then
				if Container0.GridPro0.rowcount > "0" then
					Container0.GridPro0.SetClear( )
					Container0.Grid0.SetClear( )
				end if
			end if
			
		next
	end if
	
	if szTranID == "obpds_srvc_030a" then
		if g_szPros == "I" then 
			Form.MsgBox("알림", "체결통보서비스 신청이 완료되었습니다.", "", 0)
		elseif g_szPros == "U" then
			Form.MsgBox("알림", "체결통보서비스 변경이 완료되었습니다.", "", 0)
		else
			Form.MsgBox("알림", "체결통보서비스 해지가 완료되었습니다.", "", 0)
		end if	
		TR_Inquiry("obcsb_acif_000r")
		btnEnroll.enable = false
	end if	
End Sub


'============================================================================
' btnEnroll_OnClick
'============================================================================
Sub btnEnroll_OnClick()

	if g_szAccountPassword == "" or Form.GetCtlProp( "#edtPassword", "caption") == "" then
		Form.MsgBox("알림", "계좌 비밀번호를 입력하세요", "", 0)
		exit sub
	end if
	
	if Container0.GridPro0.rowcount < "1" then
		Form.MsgBox("알림", "등록 할 휴대폰 번호가 없습니다.", "", 0)
		exit sub
	end if
	
	Container0.Grid0.SetClear( )
	
	for i=0 to Container0.GridPro0.rowcount-1
		if Container0.GridPro0.GetCellData( "bd_cell2" , i ) <> "" then
			'16-03-30 YCJ SMS알리미와 같이 Index가 0일때 값이 안들어가던 부분 동일하게 수정
			Container0.Grid0.AddRow()
'			Container0.Grid0.insertrow = 0
			Container0.Grid0.SetCellData( "bd_cell0", i, Container0.GridPro0.GetCellData( "bd_cell0", i ) )
			Container0.Grid0.SetCellData( "bd_cell1", i, Container0.GridPro0.GetCellData( "bd_cell2", i ) )
			Container0.Grid0.SetCellData( "bd_cell2", i, Container0.GridPro0.GetCellData( "bd_cell3", i ) )
		end if	
	next
	TR_Inquiry("obpds_srvc_030a")	'선택SMS약정
End Sub


'============================================================================
'chkSmartAll_OnChange
'============================================================================
Sub Container1_chkSmartAll_OnChange(sCheckState)
	g_szCheckOne = sCheckState
	BtnEnrollEnable()
End Sub
