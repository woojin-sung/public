'============================================================================
Sub Form_OnFormInitBefore()
'20160427 LKM START - 코치마크 / 유의사항안내 팝업 
	Dim szPopup1, szPopup2 

	szPopup2 = Form.LoadConfigData( "mhprc11020", "mhprc11020_p3" )	'코치마크
	If szPopup2 <> "1" Then				
		Form.OpenPopup( "mhprc11020_p3", "" , "")
	End If

	szPopup1 =  Form.LoadConfigData( "mhprc11020", "mhprc11020_p4" ) '유의사항안내
		If szPopup1 <> "1" Then
		Form.OpenFramePopup( "mhprc11020_p4", "" , "")
	End If


'20160427 LKM END
End Sub

