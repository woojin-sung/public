'============================================================================
'btnAddItem_OnClick()
'============================================================================
Sub btnAddItem_OnClick()
	if	g_szUserID	=	NULL		then
		Form.ShowAlert("안내", "로그인하시기 바랍니다.")
	else
		Form.OpenFramePopup("mhprc11020_p1" , "0" , "31")	'종목추가 팝업 오픈
	end	if
End Sub


'============================================================================
'btnSetAlarm_OnClick()
'============================================================================
Sub btnSetAlarm_OnClick()
	if	g_szUserID	=	NULL		then
		Form.ShowAlert("안내", "로그인하시기 바랍니다.")
	else
		Form.OpenFramePopup("mhprc11020_p2", sOpenData , "31")	'알림설정 팝업 오픈
	end	if
End Sub


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szUserID	=	Form.GetSharedData("&CUST_NUM", 0 )
	

	if	g_szUserID <>	null		then	
		DATAMANAGER.RequestTranData("ohhts_watch_003")
	else	
		Form.ShowAlert("안내", "로그인하시기 바랍니다.")
	end	if
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	' ----------------------------------------------------------------------
	' Watching 종목조회
	' ----------------------------------------------------------------------
	if	szTranID	=	"ohhts_watch_003"	then
		DATAMANAGER.SetDataValue(0, "ohhts_watch_003", "InBlock1", "FID_INPUT_WRTR_ID", 0, g_szUserID)
		
	' ----------------------------------------------------------------------
	' 관심그룹 Item조회
	' ----------------------------------------------------------------------
	elseif	szTranID =  "ohhts_1020_001r" then
		grdList01.rowcount = "0"		' 종목조회그리드 초기화

		DATAMANAGER.ClearInputData(0, "ohhts_1020_001r")

		For i = 0 to grdCode.rowcount-1
	
			szMk = Trim(grdCode.GetCellData("bd_mk", i))
			szCd = Trim(grdCode.GetCellData("bd_code", i))
				
			' MTS에서 보여주는 상품의 종목만 선택
			szMk = f_ChkMarket(szMk, szCd)

			DATAMANAGER.SetDataValue(0, "ohhts_1020_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i, szMk)
			DATAMANAGER.SetDataValue(0, "ohhts_1020_001r", "InBlock1", "FID_INPUT_ISCD",               i, szCd)
		Next
		
	' ----------------------------------------------------------------------
	' 메모조회
	' ----------------------------------------------------------------------
	' 20210622 HWG START : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_ )
	elseif	szTranID =  "ohhts_memo_013r"	then
		'DATAMANAGER.SetDataValue(0, "ohhts_memo_013r", "InBlock1", "FID_USER_ID"           , 0, g_szUserID)	' FID사용자ID
		szUserID = Form.GetSharedData("&USER_ID", false)
		if szUserID = "" then
			szUserID = g_szUserID
		end if 
		DATAMANAGER.SetDataValue(0, "ohhts_memo_013r", "InBlock1", "FID_USER_ID"           , 0,  szUserID)	' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_MANG_CLS_CODE", 0, "2")		' FID메모관리구분코드(1일반메모, 2종목메모)
		DATAMANAGER.SetDataValue(0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN"     , 0, "1")	
	end if 
	' 20210622 HWG END
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	n003Cnt, szDataCnt
	dim	szCode, szMarket
	dim  nMulti
	Dim szCd, szMk, szMm
	
	' ----------------------------------------------------------------------
	' Watching 종목조회
	' ----------------------------------------------------------------------
	if	szTranID	=	"ohhts_watch_003"	then
		n003Cnt 		=	grdCode.rowcount
		szDataCnt	=	DATAMANAGER.GetDataCount(0, "ohhts_watch_003", "OutBlock1")
		
		nMulti =  ( n003Cnt / szDataCnt ) - 1
		for	i=0+(nMulti * szDataCnt) to	n003Cnt-1
			szCode 	 =	grdCode.GetCellData("bd_code", i)
			szMarket	=	Form.GetItemCodeInfo(szCode, "market")
			grdCode.SetCellData("bd_mk", i, szMarket)
		next
		
		Save_grdMk()
	
	' ----------------------------------------------------------------------
	'관심그룹 Item조회
	' ----------------------------------------------------------------------
	elseif szTranID ==  "ohhts_1020_001r" then
	
			
		' 메모셀 적용 ////////////////////////////////////////////////////////
		For i = 0 to grdCode.rowcount - 1
			szMm = grdCode.GetCellData("bd_memo", i)
			szCd = grdCode.GetCellData("bd_code", i)
			szMk = grdCode.GetCellData("bd_mk", i)
						
			if Trim(szMm) <> "" then
				grdList01.SetPropGridCell("memo", "bd_name", i, szMm)
			end if	
			
			' MTS에서 보여지지 않는 종목은 종목명에 종목코드 보여주기 ++++++
			szMk = f_ChkMarket(szMk, szCd)
			
			if Trim(szMk) == "" and Trim(szCd) <> "EMPTY" then
				grdList01.SetCellData("bd_name", i, szCd)
				grdList01.SetCellFgColor("bd_name", i, "127")	' 20160817_01 LKM 글자색_메뉴비활성글자색
			end if
			' ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++		
		Next	
		
		
		' 종목메모관리자 조회
		DATAMANAGER.RequestTranData("ohhts_memo_013r")	' 20210622 HWG : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
		
		' 실시간을 위한 작업 //////////////////////////////////////////////
		For j = 0 to grdMk.rowcount - 1
			szCd = grdMk.GetCellData("bd_code", j)
			szMk = grdMk.GetCellData("bd_mk", j)
			
			if szCd <> "" and szMk <> "" then
				tCode = Split(szCd, "★")
				
				For k = 0 to #tCode-1
					' MTS에서 보여주는 상품의 종목만 선택
					szMk = f_ChkMarket(szMk, tCode(k))
					
					if szMk <> "" then
						Set_Real_Input(szMk, k, tCode(k))
					end if
				Next
				
				Real_RequestData(szMk)
			end if
		Next
		
	' ----------------------------------------------------------------------
	' 종목메모 조회
	' ----------------------------------------------------------------------	
	' 20210622 HWG START : 종목메모 서비스변경 (ohhts_memo_003r -> ohhts_memo_013r)
	elseif szTranID == "ohhts_memo_013r" then
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_memo_013r", "OutBlock1")

		For i = 0 To nCnt-1
			szCd = DATAMANAGER.GetDataValue(0, "ohhts_memo_013r", "OutBlock1", "FID_NEW_ISSU_CODE", i)
			
			For j = 0 to grdList01.rowcount - 1
				szCd2 = grdList01.GetCellData("bd_code", j)
				
				if szCd == szCd2 then		' 종목메모 이미지 적용
					grdList01.SetCellImage("bd_name", j, "icon_txt_memo.9.png")
				end if
			Next
		Next
	' 20210622 HWG END
	end if 

End Sub


'============================================================================
'grdList01_OnClickUp
'============================================================================
Sub grdList01_OnClickUp(lRow, szCellID)
	g_szSelectedItem	=	grdList01.GetCellData("bd_code", lRow)

	listLocation =  Split(grdList01.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	sPopupType = "0"

	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "차트" & "★" & "뉴스" & "★" & "매수" & "★" & "매도")

End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim szListItems	
	
	if sKeyName = "MOVEPOP_RETURN"	then
		szListItems	=	split(sRet,"★")
		
		if	szListItems(1)	=	"0"	then			'현재가
			Form.OpenScreen("11000" , g_szSelectedItem & "★" & "0") 
		elseif	szListItems(1)	=	"1"	then		'차트
			Form.OpenScreen("11000" , g_szSelectedItem & "★" & "3")
		elseif 	szListItems(1)	=	"2"	then		'뉴스
			Form.OpenScreen("44000" , g_szSelectedItem ) 
		elseif 	szListItems(1)	=	"3"	then		'매수
			Form.OpenScreen("12000" , "기타" &  "★" & "0" &  "★"& g_szSelectedItem ) 
		elseif 	szListItems(1)	=	"4"	then		'매도
			Form.OpenScreen("12000" , "기타" &  "★" & "1" &  "★"& g_szSelectedItem ) 
		else
		end if
	elseif	sKeyName	=	"REFRESH_11020"	then
		DATAMANAGER.RequestTranData("ohhts_watch_003")
	end if 
End Sub


