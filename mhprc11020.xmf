'============================================================================
' 01.화면명 	: 메리츠Watching
' 02.화면설명	: 메리츠Watching_메인화면
' 03.작성	: 2016.02.29
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szUserID
dim	g_szSelectedItem
dim	g_szRSelect

g_szUserID		= ""
g_szSelectedItem	= ""
g_szRSelect		= "0"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	Select Case szMk
		Case "J", "Q", "F", "MF", "O", "MO", "U", "T", "W", "B", "P", "EN", "EMPTY"
			return szMk
		Case "N"			' 해외지수, 환율은 같은 시장구분으로 내려오기에 분리시켜야 한다.
			If InStr(szCd, "@") == 0 then
				return "EN"
			else
				return szMk
			end if
		Case Else
			return ""
	End Select
End Function


'============================================================================
' Save_grdMk : 실시간을 위해 중복되지 않는 시장구분을 저장해둔다.
'============================================================================
Function Save_grdMk()
	grdMk.rowcount = 0
	
	For i = 0 to grdCode.rowcount-1
		
			szMk = Trim(grdCode.GetCellData("bd_mk", i))
			szCd = Trim(grdCode.GetCellData("bd_code", i))
			
			' MTS에서 보여주는 상품의 종목만 선택
			szMk =  f_ChkMarket(szMk, szCd)
			
			if szMk <> "" then
				nRow2 = CInt(grdMk.rowcount)
		
				if nRow2 == 0 then
					grdMk.insertrow = 0
					grdMk.SetCellData("bd_mk", 0, szMk)
					grdMk.SetCellData("bd_code", 0, szCd)
				end if
		
				For j = 0 to nRow2 - 1
					szMk2 = Trim(grdMk.GetCellData("bd_mk", j))
					
					if szMk == szMk2 then		
						szCd2 = grdMk.GetCellData("bd_code", j) & "★" & szCd
						grdMk.SetCellData("bd_code", j, szCd2)
						
						Exit For
					end if
					
					if j == nRow2 - 1 then
						grdMk.insertrow = 0
						grdMk.SetCellData("bd_mk", 0, szMk)
						grdMk.SetCellData("bd_code", 0, szCd)
					end if
				Next		
			end if
	Next

	' 관심종목 데이터조회
	DATAMANAGER.RequestTranData( "ohhts_1020_001r" )
End Function


'============================================================================
' Set_Real_Input : real_input 정의 (0현재, 1예상, 2단일)
'============================================================================
Function Set_Real_Input(szMk, nIdx, szCd)
	'20230913_01 HWG START : 거래소 시세증속 대응 시세 묶음처리 기능 추가 
	'ohhts_stck_cntg -> ohhts_stck_incg 교체 
	Select Case szMk
		Case "J", "Q"				' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
			elseif g_szRSelect == "1" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
				DATAMANAGER.SetDataValue(1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식호가 자동갱신(예상가)
				DATAMANAGER.SetDataValue(1, "ohhts_antc_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)
			elseif g_szRSelect == "2" then
				DATAMANAGER.SetDataValue(1, "ohhts_ovtp_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 시간외단일체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_ovtp_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 시간외단일호가 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
			end if
			
		Case "F", "MF"		' KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신			
'				DATAMANAGER.SetDataValue(1, "ohhts_futs_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 호가 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동
			end if 
			
		Case "O", "MO"		' KOSPI지수 옵션, 미니코스피 옵션
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동				
'			elseif g_szRSelect == "1" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 체결 자동갱신			
'				DATAMANAGER.SetDataValue(1, "ohhts_optn_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 호가 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동	
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 파생 가격제한폭 확대발동
			end if 
			
		Case "U"		' 업종코드
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_nmix_antg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 예상체결 자동갱신										
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 체결 자동갱신
			end if 
		
		Case "T"		' K-OTC(프리보드)
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_frbr_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 프리보드호가 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식호가 자동갱신
'			elseif g_szRSelect == "2" then
'				DATAMANAGER.SetDataValue(1, "ohhts_ovtp_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 시간외단일체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_ovtp_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 시간외단일호가 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
			end if 
		
		Case "W"		' ELW
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW체결 자동갱신			
'				DATAMANAGER.SetDataValue(1, "ohhts_elw_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW호가 자동갱신(예상가)
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW체결 자동갱신
			end if 
			
		Case "N"	' 해외지수
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외지수/종목 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외지수/종목 체결 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외지수/종목 체결 자동갱신
			end if 
		
		Case "B"	' 소액채권, 장내채권
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_bond_cntg", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_bond_cntg", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 체결 자동갱신
'				DATAMANAGER.SetDataValue(1, "ohhts_bond_aspr", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 호가 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_bond_cntg", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 체결 자동갱신
			end if
			
		Case "EN"		' 세계환율
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 환율 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 환율 체결 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 환율 체결 자동갱신
			end if 			

	End Select
	'20230913_01 HWG END 
End Function


'============================================================================
' Real_RequestData : Real 요청 (0현재, 1예상, 2단일)
'============================================================================
Function Real_RequestData(szMk)
	'20230913_01 HWG START : 거래소 시세증속 대응 시세 묶음처리 기능 추가 
	'ohhts_stck_cntg -> ohhts_stck_incg 교체 
	Select Case szMk
		Case "J", "Q"				' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_stck_incg")		' 주식체결 자동갱신
			elseif g_szRSelect == "1" then	
'				DATAMANAGER.RequestRealData("ohhts_stck_incg")		' 주식체결 자동갱신
				DATAMANAGER.RequestRealData("ohhts_stck_aspr")		' 주식호가 자동갱신(예상가)
				DATAMANAGER.RequestRealData("ohhts_antc_cntg")
			elseif g_szRSelect == "2" then
				DATAMANAGER.RequestRealData("ohhts_ovtp_cntg")		' 시간외단일체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_ovtp_aspr")		' 시간외단일호가 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_stck_incg")		' 주식체결 자동갱신
			end if
			
		Case "F", "MF"		' KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_futs_cntg")		' 선물 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_pric_extd")		' 파생 가격제한폭 확대발동
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_futs_cntg")		' 선물 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_futs_aspr")		' 선물 호가 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_pric_extd")		' 파생 가격제한폭 확대발동
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.RequestRealData("ohhts_futs_cntg")		' 선물 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_pric_extd")		' 파생 가격제한폭 확대발동
			end if 
			
		Case "O", "MO"		' KOSPI지수 옵션, 미니코스피 옵션
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_pric_extd")		' 파생 가격제한폭 확대발동				
'			elseif g_szRSelect == "1" then	
'				DATAMANAGER.RequestRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_optn_aspr")		' 옵션 호가 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_pric_extd")		' 파생 가격제한폭 확대발
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.RequestRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_pric_extd")		' 파생 가격제한폭 확대발동
			end if 
			
		Case "U"		' 업종코드
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_nmix_cntg")		' 업종지수 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_nmix_cntg")		' 업종지수 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_nmix_antg")		' 업종지수 예상체결 자동갱신										
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.RequestRealData("ohhts_nmix_cntg")		' 업종지수 체결 자동갱신
			end if 
		
		Case "T"		' K-OTC(프리보드)
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_frbr_cntg")		' 프리보드체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_stck_incg")		' 주식체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_frbr_cntg")		' 프리보드체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_frbr_aspr")		' 프리보드호가 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_stck_incg")		' 주식체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_stck_aspr")		' 주식호가 자동갱신
'			elseif g_szRSelect == "2" then
'				DATAMANAGER.RequestRealData("ohhts_ovtp_cntg")		' 시간외단일체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_ovtp_aspr")		' 시간외단일호가 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_frbr_cntg")		' 프리보드체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_stck_incg")		' 주식체결 자동갱신
			end if 
		
		Case "W"		' ELW
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_elw_cntg")			' ELW체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_elw_cntg")			' ELW체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_elw_aspr")			' ELW호가 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.RequestRealData("ohhts_elw_cntg")			' ELW체결 자동갱신
			end if 

		Case "N"	' 해외지수
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")		' 해외지수/종목 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")		' 해외지수/종목 체결 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")		' 해외지수/종목 체결 자동갱신
			end if 
		
		Case "B"	' 소액채권, 장내채권
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_bond_cntg")		' 일반채권 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_bond_cntg")		' 일반채권 체결 자동갱신
'				DATAMANAGER.RequestRealData("ohhts_bond_aspr")		' 일반채권 호가 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.RequestRealData("ohhts_bond_cntg")		' 일반채권 체결 자동갱신
			end if
			
		Case "EN"		' 세계환율
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_exrt_cntg")		' 환율 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_exrt_cntg")		' 환율 체결 자동갱신
'			elseif g_szRSelect == "2" then	
'				DATAMANAGER.RequestRealData("ohhts_exrt_cntg")		' 환율 체결 자동갱신
			end if			
	End Select
	'20230913_01 HWG END
End Function

