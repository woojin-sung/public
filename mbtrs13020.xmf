Sub grdList_OnScrollEnd()
	Dim szTranID
	
	if g_szType == "13" then
		szTranID = "ohhts_1182_002r"
	else
		szTranID = "ohhts_1001_004r"
	end if
	
	if DATAMANAGER.IsMoreNextData(szTranID) == true then
		DATAMANAGER.RequestNextData(szTranID)
	end if
End Sub

'============================================================================
' acnt_ChangeAccount
'============================================================================
Sub acnt_ChangeAccount()
	Clear_SharedData()
	edtOrgNo.caption = ""
	edtModTab.caption = ""
	edtCnlTab.caption = ""
	lblPrc.caption = ""
	
	'20220425 HWG START : 계좌비밀번호 입력 개선
	if g_szSavePwd == "0" then
		edtPwd.caption = ""
		edtPwdIcon.imgpath = "icon_save_password_n.9"
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'20220425 HWG END
	
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", g_szCd)	' 폼탭화면에 종목코드 던지기
	
	szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
    if szMediaCode = "156" or szMediaCode = "157" then
	    DATAMANAGER.RequestTranData("obcsb_acif_077r")
    end if
    
    '20220823 SWJ START : 일반계좌인 경우 증거금율 표시
    Form.triggerEvent("linkfm", "13200_cfdmgrt", acnt.total & "@" & acnt.sequence )
    '20220823 SWJ END
End Sub

