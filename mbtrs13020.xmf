'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	contHoga.setScrollBarVisible("0")
	contDebi.setScrollBarVisible("0")
	Dim szCd, szChk
	
	btnPwd.bringfront("1")	'20220425 HWG : 계좌비밀번호 입력 개선
	
	Change_LinkForm()
	Load_OrderSet()
	'10호가창 중간위치
	contHoga.scroll_pos = "vcenter"
	contDebi.scroll_pos = "vcenter"
	
	' 종목컨트롤
	' 선택가능종목 1,2:KOSPI,1,2:KOSDAQ,5:ETF,6:ETN
	Form.SetSearchType ("22:23:24:25")
	'20180716 LES END
	
	szOpen = Form.GetOpenLinkData()
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'20200910 SWJ END
	
	'20220503 SWJ START : TIGER ETF 이벤트 팝업 처리
'	saveDate = Form.LoadConfigData("NoticeSetting", "TIGERETF_DAY")
'	saveEternal = Form.LoadConfigData("NoticeSetting", "TIGERETF_ETERNAL")
'	todayDate = Form.GetSharedData("&HOST_DATE",0)
'	
'	if saveEternal = "1" or saveEternal = 1 then
'	else
'		if saveDate <> "" then
'			ResaveDate 	= left(saveDate,4)&"-"&mid(saveDate,5,2)&"-"&right(saveDate,2)
'			RetodayDate 	= left(todayDate,4)&"-"&mid(todayDate,5,2)&"-"&right(todayDate,2)
'				
'			calcDate = tonumber(DateDiff("d",ResaveDate, RetodayDate))
'			
'			if calcDate >= 1 then
'				Form.OpenPopup("notice_p5" , "TIGERETF" , "")	
'			end if
'		else
'			Form.OpenPopup("notice_p5" , "TIGERETF" , "")
'		end if
'	end if
	'20220503 SWJ END
	
	' ----------------------------------------------------------------------
	' 다른화면에서 화면오픈시
	' ----------------------------------------------------------------------	
	if szOpen <> "" then
		'- 잔고	
		' 전달내용/탭위치/종목코드/수량/대출일자/대출상세/신용합산여부/대출일련번호
		' szData = "잔고" & "★" & szTab & "★" & szCd & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & chk1.checkstate & "♥" & szLoanSr
			
		'- 미체결	
		' 전달내용/탭위치/종목코드/주문번호/미체결수량/주문유형/주문가격/주문조건
		' szData = "미체결" & "★" & szTab & "★" & szCd & "★" & szOdrNo & "♥" & szQty & "♥" & szOdrType & "♥" & szOdrPrc & "♥" & szClsCd

		'- 현재가화면 : 20160321 현재가에서 주문화면 오픈 추가
		' 전달내용/탭위치/종목코드/전달가격
		' szData = "현재가" & "★" & szTab & "★" & szCd & "★" & szPrc

		'- 기타화면
		' 전달내용/탭위치/종목코드
		' szData = "기타" & "★" & szTab & "★" & szCd
		tData = Split(szOpen, "★")

		' 정정화면에서 기존종목과 종목비교로 인한 시간차로 인해 데이터 적용이 달라지는 부분 때문에 추가
		if g_szCd == tData(2) then
			szChk = "0"
		else
			szChk = "1" 
		end if

		' 폼탭변경(0:매수, 1:매도, 2:청산, 3:정정/취소)
		if Trim(tData(1)) == "" then
			fmTab.currenttab = "0"
		else
			fmTab.currenttab = tData(1)
		end if
		
		Check_MarketCode(tData(2))' ELW종목 여부
		Return_Change_ItemCode(tData(2))
		
		if tData(0) == "잔고" then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "13000_BALANCE_RETURN", tData(3))	
		elseif tData(0) == "미체결" then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "13000_CONTRACT_RETURN", tData(3) & "♥" & szChk & "♥" & tData(2))	
		elseif tData(0) == "현재가" then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "13000_HYUN_RETURN", tData(3))
		end if
	' ----------------------------------------------------------------------
	' 최근조회종목
	' ----------------------------------------------------------------------			
	else		
		szCd = Form.GetSharedData("&ITEM_STOCK_CFD", 0)		' 최근조회종목
		Form.SetItemCode(szCd)						' 최초 화면진입시 종목코드 설정
		
		Check_MarketCode(szCd)
		
		' 현금/신용구분 > CFD는 현금만 가능
'		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "ORDER_GBN", rdoGbn.currentindex)
		
		' ELW경우
'		if g_szMk == "W" then
'			DATAMANAGER.RequestTranData("obcsb_acif_000r")
'		end if
	end if
	
	'------------------------------------------------------------------------
	' 20170203 LES START - 마지막 그리드 유형 저장
	'------------------------------------------------------------------------
	
	if Form.GetSharedData("g_szSlt", false) == "HOGA1" then
		g_szSlt = "HOGA2"
		Call tblSelect_OnClick(0 ,1)
		
	
	elseif Form.GetSharedData("g_szSlt", false) =="HOGA2" then
		g_szSlt = "HOGA1"
		Call tblSelect_OnClick(0 ,1)
	
	elseif Form.GetSharedData("g_szSlt", false) =="HOGA" then
		g_szSlt2 = "SISE"
		Call tblSelect_OnClick(0 ,0)
	
	elseif Form.GetSharedData("g_szSlt", false) == "SISE" then
		g_szSlt2 = "HOGA"
		Call tblSelect_OnClick(0 ,0)
		
	
	end if
	
	szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
    if szMediaCode = "156" or szMediaCode = "157" then
	    DATAMANAGER.RequestTranData("obcsb_acif_077r")
    end if
    
    '20220823 SWJ START : 일반계좌인 경우 증거금율 표시
    Form.triggerEvent("linkfm", "13200_cfdmgrt", acnt.total & "@" & acnt.sequence )
    '20220823 SWJ END
End Sub

'============================================================================
' Form_OnLinkData
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	Clear_SharedData()
	
	if sKey = "ITEMCODE" then
		if g_szRtnO == "1" then	' 20160316
			g_szRtnO = ""
			
			if g_szChangeInit == "1" then
				edtOrgNo.caption = ""
			end if
		else
			edtOrgNo.caption = ""
		end if
		
		edtModTab.caption = ""
		edtCnlTab.caption = ""
		lblPrc.caption = ""
		
		Check_MarketCode(sValue)									' ELW종목 여부
		
		nTab = fmTab.currenttab
		if nTab == 0 then
			szType = Form.GetSharedData("STOCK_BUYTYPE", false)
		elseif nTab == 1 then
			szType = Form.GetSharedData("STOCK_SELTYPE", false)
		elseif nTab == 2 then
			szType = Form.GetSharedData("STOCK_MODTYPE", false)
		elseif nTab == 3 then
			szType = Form.GetSharedData("STOCK_CNLTYPE", false)
		end if	
		
		if Trim(szType) == "" or szType == null then
			szType = "0"
		end if

		if sValue <> g_szCd then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", sValue)	' 폼탭화면에 종목코드 던지기
		end if
		
		Change_HOGA_Request(sValue, szType)

'		if sValue <> g_szCd then
'			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", sValue)	' 폼탭화면에 종목코드 던지기
'		end if
	elseif sKey = "&ACR_ITEM" then
		Form.SetItemCode(sValue)

		edtOrgNo.caption = ""
		edtModTab.caption = ""
		edtCnlTab.caption = ""
		lblPrc.caption = ""
		
		Check_MarketCode(sValue)									' ELW종목 여부
		
		nTab = fmTab.currenttab
		if nTab == 0 then
			szType = Form.GetSharedData("STOCK_BUYTYPE", false)
		elseif nTab == 1 then
			szType = Form.GetSharedData("STOCK_SELTYPE", false)
		elseif nTab == 2 then
			szType = Form.GetSharedData("STOCK_MODTYPE", false)
		elseif nTab == 3 then
			szType = Form.GetSharedData("STOCK_CNLTYPE", false)
		end if	
		
		if Trim(szType) == "" or szType == null then
			szType = "0"
		end if

		if sValue <> g_szCd then
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", sValue)	' 폼탭화면에 종목코드 던지기
		end if
		
		Change_HOGA_Request(sValue, szType)

'		if sValue <> g_szCd then
'			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "INIT_CODE", sValue)	' 폼탭화면에 종목코드 던지기
'		end if
	end	if	
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Clear_SharedData()	
	Form.SetSharedData("STOCK_BUYTYPE", "")
	Form.SetSharedData("STOCK_SELTYPE", "")
	Form.SetSharedData("STOCK_MODTYPE", "")
	Form.SetSharedData("STOCK_CNLTYPE", "")	
	
	' 가로 <-> 세로 전환 공유데이터
	Form.SetSharedData("B_TYPE", "")		' 주문구분
	Form.SetSharedData("B_PRC",  "")		' 가격
	Form.SetSharedData("B_QTY",  "")		' 수량
	
	Form.SetSharedData("S_TYPE", "")		' 주문구분
	Form.SetSharedData("S_PRC",  "")		' 가격
	Form.SetSharedData("S_QTY",  "")		' 수량
	Form.SetSharedData("S_CSM",  "")		' 신용합산
	Form.SetSharedData("S_CGN",  "")		' 신용구분	
	
	Form.SetSharedData("M_TYPE", "")		' 주문구분
	Form.SetSharedData("M_PRC",  "")		' 가격
	Form.SetSharedData("M_QTY",  "")		' 수량	
	Form.SetSharedData("M_ORG",  "")		' 원주문번호
	Form.SetSharedData("M_QCK",  "")		' 잔량여부
	
	Form.SetSharedData("C_QTY",  "")		' 수량	
	Form.SetSharedData("C_ORG",  "")		' 원주문번호
	Form.SetSharedData("C_QCK",  "")		' 잔량여부	
	Form.SetSharedData("B_QTY_TYPE" , "")	' 수량유형 (0:현금 1:최대 2:수량직접입력) '20160829_01 LKM
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szType

	if sEventName == "13000_BALANCE_OPEN" then
		' 계좌번호(8), 계좌일련번호(2), 탭구분, 주문구분(0:일반주문, 1:예약주문, 2:호가주문), 신용합산구분

		Form.OpenFramePopup("mbtrs13000_pb", acnt.total & "★" & acnt.sequence & "★1★0★" & sParam, "")	
	' ----------------------------------------------------------------------
	' 정정/취소화면에서 미체결팝업 오픈 요청
	' ----------------------------------------------------------------------	
	elseif sEventName == "13000_CONTRACT_OPEN" then		
		' 계좌번호(8), 계좌일련번호(2), 탭구분, 주문구분(0:일반주문, 1:예약주문, 2:호가주문)
		Form.OpenFramePopup("mbtrs13000_pa", acnt.total & "★" & acnt.sequence & "★" & fmTab.currenttab & "★0", "")		
	' ----------------------------------------------------------------------
	' 상단 연결메뉴 선택시
	' ----------------------------------------------------------------------
	elseif sEventName == "13000_BORROW_OPEN" then		
		' 계좌번호(8), 계좌일련번호(2), 탭구분
		Form.OpenFramePopup("mbtrs13000_p2", acnt.total & "★" & acnt.sequence & "★" & fmTab.currenttab & "★0", "")		
	' ----------------------------------------------------------------------
	' 차입매도현황 오픈 요청
	' ----------------------------------------------------------------------
	
	elseif sEventName == "13000_DEPOSIT_OPEN" then		
		Form.OpenPopup("mbtrs13000_pe", acnt.total & "★" & acnt.sequence, "")
	' ----------------------------------------------------------------------
	' 예수금 팝업 오픈 요청
	' ----------------------------------------------------------------------
	
	elseif sEventName == "SCREEN_MENU" then	
		if sParam == "POPUP1" then			' 예수금
			Form.OpenPopup("mbtrs13000_pe", acnt.total & "★" & acnt.sequence, "")
			
		elseif sParam == "SET_SCREEN" then		' 주문설정
			Form.OpenScreen("90000" , "1")
		end if
	' ----------------------------------------------------------------------
	' 상단 종목부분 클릭시 종목정보/조회종목 팝업호출 : 20160318 추가
	' ----------------------------------------------------------------------			
	elseIf sEventName = "TITLE_CLICK" Then
		'20220922 SWJ START : 종목정보 없애고 종목선택 팝업 추가
		'Form.OpenPopup("mhprc11000_p1" , "" , "")
		Form.OpenCommonDialog("SEARCH", "22:23:24:25", "")
		'20220922 SWJ END
	elseIf sEventName = "13000_BALANCE" or sEventName = "13000_CONTRACT" Then'체결 탭 리턴 잔고 탭 리턴
		Dim szChk, szCutCd
		
		if sParam <> "" then
			tData = Split(sParam, "★")
			
			g_szRtnO = "1"	' 20160316
			
			' 정정화면에서 기존종목과 종목비교로 인한 시간차로 인해 데이터 적용이 달라지는 부분 때문에 추가
			
			szCutCd = Mid(tData(2), 2, Len(tData(2)))	' 20160316
			'if g_szCd == tData(2) then
			if g_szCd == szCutCd then
				szChk = "0"
			else
				szChk = "1" 
			end if
			
			szCd = tData(2)
		
			Return_Change_ItemCode(tData(2))
			'  수량/매수매도구분
			if sKeyName == "13000_CONTRACT" then
				fmTab.currenttab = "2"
				fmTab_OnTabChanged(2)
'				Form.triggerEvent("fmTab." & fmTab.currenttabpageid, sKeyName & "_RETURN", tData(3) & "♥" & szChk & "♥" & szCd )
				Form.triggerEvent("fmTab." & fmTab.currenttabpageid, sEventName & "_RETURN", tData(3) & "♥" & szChk & "♥" & szCd )
			else
				if tData(4) == "2" then '1:매도/2:매수
					fmTab.currenttab = "1"
					fmTab_OnTabChanged(1)
				else
					fmTab.currenttab = "0"
					fmTab_OnTabChanged(0)
				end if
				
				Form.triggerEvent("fmTab." & fmTab.currenttabpageid, sEventName & "_RETURN", tData(3) & "♥" & szChk)
			end if
		end if
	elseIf sEventName = "13000_CONTRACT" Then'체결 탭 리턴
		Dim szChk, szCutCd
		
		if sParam <> "" then
			tData = Split(sParam, "★")
			
			g_szRtnO = "1"	' 20160316
			
			' 정정화면에서 기존종목과 종목비교로 인한 시간차로 인해 데이터 적용이 달라지는 부분 때문에 추가
			
			szCutCd = Mid(tData(2), 2, Len(tData(2)))	' 20160316
			'if g_szCd == tData(2) then
			if g_szCd == szCutCd then
				szChk = "0"
			else
				szChk = "1" 
			end if
			
			szCd = tData(2)
		
			Return_Change_ItemCode(tData(2))
			'  수량/매수매도구분
			if fmTab.currenttab <> "3" or fmTab.currenttab <> 3 then
				fmTab.currenttab = "3"
			end if
			
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, sEventName & "_RETURN", tData(3) & "♥" & szChk & "♥" & szCd )
		
			fmTab.currenttab = "2"
			fmTab_OnTabChanged(2)
			
		end if
	elseIf sEventName = "BUY_MORE" or sEventName = "SELL_CLEAR" Then'추가매수(매수탭) 매도청산(매수탭)
		if sParam <> "" then
			tData = Split(sParam,"★")
			
			dim szChk
			szCutCd = Mid(tData[0], 2, tData[0])
			
			if g_szCd == szCutCd then
				szChk = "0"
			else
				szChk = "1" 
			end if
				
			szCd = szCutCd
		
			Return_Change_ItemCode(tData[0])
				
			fmTab.currenttab = "0"
			fmTab_OnTabChanged(0)
			
			if sEventName = "BUY_MORE" Then
				Form.triggerEvent("fmTab." & fmTab.currenttabpageid, sEventName & "_RETURN", "")
			else
				Form.triggerEvent("fmTab." & fmTab.currenttabpageid, sEventName & "_RETURN", tData[1])'청산가능수량
			end if
		end if
		
	elseIf sEventName = "SELL_MORE" or sEventName = "BUY_CLEAR" Then'추가매도(매도탭) 매수청산(매도탭)
		if sParam <> "" then
			tData = Split(sParam,"★")
			
			dim szChk
			szCutCd = Mid(tData[0], 2, tData[0])
			
			if g_szCd == szCutCd then
				szChk = "0"
			else
				szChk = "1" 
			end if
				
			szCd = szCutCd
		
			Return_Change_ItemCode(tData[0])
				
			fmTab.currenttab = "1"
			fmTab_OnTabChanged(1)
			
			if sEventName = "SELL_MORE" Then
				Form.triggerEvent("fmTab." & fmTab.currenttabpageid, sEventName & "_RETURN", "")
			else
				Form.triggerEvent("fmTab." & fmTab.currenttabpageid, sEventName & "_RETURN", tData[1])'청산가능수량
			end if
		end if
	else
'		Form.triggerEvent("linkfm", "13000_CFDTYPE", "")
				if sEventName == "12000_BUYTYPE" then
			szType = Form.GetSharedData("STOCK_BUYTYPE", false)
			Form.triggerEvent("linkfm", "12000_BUYTYPE", "")
		elseif sEventName == "12000_SELTYPE" then
			szType = Form.GetSharedData("STOCK_SELTYPE", false)
			Form.triggerEvent("linkfm", "12000_SELTYPE", "")
		elseif sEventName == "12000_MODTYPE" then
			szType = Form.GetSharedData("STOCK_MODTYPE", false)
			Form.triggerEvent("linkfm", "12000_MODTYPE", "")
		elseif sEventName == "12000_CNLTYPE" then
			szType = Form.GetSharedData("STOCK_CNLTYPE", false)
			Form.triggerEvent("linkfm", "12000_CNLTYPE", "")
		'청산추가?
		end if
	
		if Trim(szType) == "" or szType == null then
			szType = "0"
		end if
	
		Change_HOGA_Request(g_szCd, szType)
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 잔고팝업, 미체결팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "13000_BALANCE" or sKeyName == "13000_CONTRACT" then
		Dim szChk, szCutCd
		
		if sRet <> "" then
			tData = Split(sRet, "★")
			
			g_szRtnO = "1"	' 20160316
			
			' 정정화면에서 기존종목과 종목비교로 인한 시간차로 인해 데이터 적용이 달라지는 부분 때문에 추가
			
			szCutCd = Mid(tData(2), 2, Len(tData(2)))	' 20160316
			'if g_szCd == tData(2) then
			if g_szCd == szCutCd then
				szChk = "0"
			else
				szChk = "1" 
			end if
			
			szCd = tData(2)
		
			Return_Change_ItemCode(tData(2))
			'  수량/매수매도구분
			if sKeyName == "13000_CONTRACT" then
				if fmTab.currenttab <> "3" or fmTab.currenttab <> 3 then
					fmTab.currenttab = "3"
				end if
				
				Form.triggerEvent("fmTab." & fmTab.currenttabpageid, sKeyName & "_RETURN", tData(3) & "♥" & szChk & "♥" & szCd )
			else
				Form.triggerEvent("fmTab." & fmTab.currenttabpageid, sKeyName & "_RETURN", tData(3) & "♥" & szChk)
			end if
		end if
	' ----------------------------------------------------------------------
	' 차입매도현황에서 리턴
	' ----------------------------------------------------------------------		
	elseif sKeyName == "13000_BORROW" then
		if sRet <> "" then
			tData = Split(sRet, "★")
			
			szCutCd = tData(2)
			
			if g_szCd == szCutCd then
				szChk = "0"
			else
				szChk = "1" 
			end if
			
			Return_Change_ItemCode(tData(2))
			
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, sKeyName & "_RETURN", tData(3) & "♥" & szChk)
			
		end if
	' ----------------------------------------------------------------------
	' 종목정보/최근조회종목 팝업에서 리턴 : 20160318 추가
	' ----------------------------------------------------------------------		
	elseif sKeyName = "11000_p1_Close" then
		if Trim(sRet) <> "종목없음" then
			Form.SetItemCode(sRet)
		end If
	
	elseif sKeyName == "AGREECHECK" then
		if sRet == "Y" then
			Form.OpenScreen("81040" , "")
		end if 
	'20220425 HWG START : 계좌비밀번호 입력 개선
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
		else
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
				edtPwd.caption = ""
			else
				szCurAcc = acnt.caption
				nCnt = Cint(acnt.accountcount)
				For i = 0 to nCnt - 1
					szCompAcc = acnt.getAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						acnt.currentindex = i
						Exit For
					end if
				Next
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
		end if 
	'20220425 HWG END	
	end if
End Sub

'============================================================================
' Form_OnRefresh : 재조회 20160321
'============================================================================
Sub Form_OnRefresh()
	Request_Hoga()
End Sub

'============================================================================
' fmTab_OnTabChanged
'============================================================================
Sub fmTab_OnTabChanged(nCurrentTab)
	Dim szType

	Clear_SharedData()
	lblPrc.caption = ""
	
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "CHNAGE_TAB", g_szCd)	' 폼탭화면에 종목코드 던지기
	
	if CInt(nCurrentTab) < 3 then
		contDebi.visible = true
		contHoga.visible = true
		lblTime.visible = true
		tblSelect.visible = true
		imgToggle0.visible = true
		imgToggle.visible = true
	else
		contDebi.visible = false
		contHoga.visible = false
		lblTime.visible = false
		tblSelect.visible = false
		imgToggle0.visible = false
		imgToggle.visible = false
	end if
	
	'========================================================================================================
	'20170726 LES START - 주문 데이터연동 오류 수정 (nCurrentTab 비교 -> 숫자 or 문자 베이스 비교로 수정)
	'========================================================================================================
	if nCurrentTab == 0 or nCurrentTab == 1 or nCurrentTab == "0" or nCurrentTab == "1" then
		
'		if g_szMk == "W" then
'			rdoGbn.visible = false
'			btnELWWarn.visible = true
'		
'		'20180716 LES START - K-OTC상품 추가
'		elseif g_szMk == "T" then
'			rdoGbn.currentindex = 0
'			rdoGbn.visible = false
'			btnELWWarn.visible = false
'		'20180716 LES END
'					
'		else
'			'rdoGbn.enable = true
'			rdoGbn.visible = true
'			btnELWWarn.visible = false
'		end if
	
'		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "ORDER_GBN", rdoGbn.currentindex)
		
		if nCurrentTab == 0 or nCurrentTab == "0" then 
			szType = Form.GetSharedData("STOCK_BUYTYPE", false)
			Form.triggerEvent("linkfm", "12000_BUYTYPE", "")
		elseif nCurrentTab == 1 or nCurrentTab == "1" then 
			szType = Form.GetSharedData("STOCK_SELTYPE", false)
			Form.triggerEvent("linkfm", "12000_SELTYPE", "")
		end if
	else
		
		if g_szAfterOrg == "1" then			' 주문연동시
			if nCurrentTab == 2 or nCurrentTab == "2" then
				if edtModTab.caption = "" or edtModTab.caption = "0" then
					'if Trim(edtModTab.caption) <> "" then
						Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "AFTER_ORGNO", edtOrgNo.caption)		' 주문번호 연동
					'end if
				end if
				
				edtModTab.caption = "1"
			elseif nCurrentTab == 3 or nCurrentTab == "3" then
				if edtCnlTab.caption = "" or edtCnlTab.caption = "0" then
					'if Trim(edtCnlTab.caption) <> "" then				
						Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "AFTER_ORGNO", edtOrgNo.caption)		' 주문번호 연동
					'end if
				end if
				
				edtCnlTab.caption = "1"
			end if
		end if
		
'		rdoGbn.visible = false
'		btnELWWarn.visible = false
		
		if nCurrentTab == 2 or nCurrentTab == "2" then
			szType = Form.GetSharedData("STOCK_MODTYPE", false)
			Form.triggerEvent("linkfm", "12000_MODTYPE", "")
		elseif nCurrentTab == 3 or nCurrentTab == "3" then
			szType = Form.GetSharedData("STOCK_CNLTYPE", false)
			Form.triggerEvent("linkfm", "12000_CNLTYPE", "")
		end if	
	end if
	
	'========================================================================================================
	'20170726 LES END - 주문 데이터연동 오류 수정 (nCurrentTab 비교 -> 숫자 or 문자 베이스 비교로 수정)
	'========================================================================================================
	
	if Trim(szType) == "" or szType == null then
		szType = "0"
	end if
	
	Change_HOGA_Request(g_szCd, szType)
	Return_AutoPrice()
End Sub

'============================================================================
' tblSelect_OnClick
'============================================================================
Sub tblSelect_OnClick(lRow , lColumn)

	'-----------------------------------------------------------------------
	' 20170202 LES STAR - 테이블 유형 변경 
	'-----------------------------------------------------------------------

	if lColumn == 1 then
		if g_szSlt == "HOGA1" then
			g_szSlt = "HOGA2"
			Form.SetSharedData("g_szSlt" ,"HOGA2")
			contDebi.scroll_pos = contHoga.scroll_pos()
			
			contDebi.left = 0
			contDebi.visible = true
			contHoga.left = 700
		
		elseif g_szSlt == "HOGA2" then
			g_szSlt = "HOGA1"
			Form.SetSharedData("g_szSlt" ,"HOGA1")
			
			contHoga.scroll_pos = contDebi.scroll_pos()
			contDebi.left = 600
			contDebi.visible = true
			
			
			contHoga.left = 0
				
		end if
	
	elseif lColumn == 0 then
		if g_szSlt2 == "HOGA" then
			g_szSlt2 = "SISE"
			Form.SetSharedData("g_szSlt" ,"SISE")
			tblSelect.SetCellString(0, 1, "시간별")
			grdList.left = 0
			grdList.visible = true
			lblTime.left = 9
			lblTime.visible = true
			
			imgToggle.visible = false
			
		elseif g_szSlt2 =="SISE" then
			g_szSlt2 = "HOGA"
			Form.SetSharedData("g_szSlt" ,"HOGA")
			tblSelect.SetCellString(0, 1, "호가")
			grdList.left = 700
			grdList.visible = false
			lblTime.left = 701
			lblTime.visible = false
			
			imgToggle.visible = true
			
		end if
	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 현재가(시간별)
	' ----------------------------------------------------------------------	
	if szTranID = "ohhts_1001_004r" then	    
		DATAMANAGER.ClearInputData(0, szTranID)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
	' ----------------------------------------------------------------------
	' 현재가(호가&예상체결)
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_1001_005r" then	
		DATAMANAGER.ClearInputData(0, szTranID)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	' ----------------------------------------------------------------------
	' 현재가(시세&상세내역)
	' ----------------------------------------------------------------------	
	elseif szTranID = "ohhts_1001_001r" then
		DATAMANAGER.ClearInputData(0, szTranID)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
	' ----------------------------------------------------------------------
	' 시간외단일가현재가(호가)
	' ----------------------------------------------------------------------		
	elseif szTranID = "ohhts_1181_001r" then
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "13000_HOGA", "")
		
		DATAMANAGER.ClearInputData(0, szTranID)

		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
	' ----------------------------------------------------------------------
	' 시간외단일가현재가(시세)
	' ----------------------------------------------------------------------		
	elseif szTranID = "ohhts_1181_002r" then
		DATAMANAGER.ClearInputData(0, szTranID)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)		
	' ----------------------------------------------------------------------
	' 시간외단일가시세추이(시간별)
	' ----------------------------------------------------------------------		
	elseif szTranID = "ohhts_1182_002r" then
		DATAMANAGER.ClearInputData(0, "ohhts_1182_002r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_1182_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "J")
		DATAMANAGER.SetDataValue(0, "ohhts_1182_002r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_1182_002r", "InBlock1", "FID_INPUT_HOUR_CLS_CODE"     , 0, "1")
		DATAMANAGER.SetDataValue(0, "ohhts_1182_002r", "InBlock1", "FID_INPUT_PAST_DATA_INCU_YN" , 0, "N")	
		
	elseif szTranID == "obcsb_acif_077r" then	
		
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_077r", "InBlock1", "ACNO" , 0 , acnt.total )

		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obcsb_acif_077r", "InBlock1", "ACNT_PWD"		, 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때	
		else	
			DATAMANAGER.SetDataValue(0, "obcsb_acif_077r", "InBlock1", "ACNT_PWD"		, 0, Form.GetTopCtlProp("edtPwd", "encdata"))		' 계좌 비밀번호
		end if
	end if	
End Sub



'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 현재가(시세&상세내역)
	' ----------------------------------------------------------------------	
    if szTranID = "ohhts_1001_001r" then
	    lblAfterCode.caption = g_szCd
		Return_AutoPrice()
	' ----------------------------------------------------------------------
	' 현재가(시간별)
	' ----------------------------------------------------------------------	
    elseif szTranID = "ohhts_1001_004r" then
		if g_szMk = "W" then
			DATAMANAGER.RequestRealData("ohhts_elw_cntg")
			
		'20180716 LES START - K-OTC상품 추가
		elseif g_szMk = "T" then
			DATAMANAGER.RequestRealData("ohhts_frbr_cntg")
		'20180716 LES END
			
		else
			DATAMANAGER.RequestRealData("ohhts_stck_cntg")
		end if
	' ----------------------------------------------------------------------
	' 현재가(호가&예상체결)
	' ----------------------------------------------------------------------			
	elseif szTranID = "ohhts_1001_005r" then			
		DATAMANAGER.RequestTranData("ohhts_1001_004r")		' 현재가(시간별)
		DATAMANAGER.RequestTranData("ohhts_1001_001r")		' 현재가(시세&상세내역)
		
		'10호가창 중간위치
		contHoga.scroll_pos = "vcenter"
		contDebi.scroll_pos = "vcenter"
		
		if g_szMk = "W" then		
			DATAMANAGER.RequestRealData("ohhts_elw_aspr")
		
		'20180716 LES START - K-OTC상품 추가
		elseif g_szMk = "T" then
			DATAMANAGER.RequestRealData("ohhts_frbr_aspr")
		'20180716 LES END
		
		else
			DATAMANAGER.RequestRealData("ohhts_stck_aspr")
		end if
	' ----------------------------------------------------------------------
	' 시간외단일가시세추이(시간별)
	' ----------------------------------------------------------------------	
    elseif szTranID = "ohhts_1182_002r" then
	    lblAfterCode.caption = g_szCd
	    Return_AutoPrice()
	    
		if g_szMk = "W" then
			'DATAMANAGER.RequestRealData("")
		else
			
			DATAMANAGER.RequestRealData("ohhts_ovtp_cntg")
		end if
	' ----------------------------------------------------------------------
	' 시간외단일가현재가(호가)
	' ----------------------------------------------------------------------			
	elseif szTranID = "ohhts_1181_001r" then	
		DATAMANAGER.RequestTranData("ohhts_1181_002r")		' 시간외단일가(시세)
		DATAMANAGER.RequestTranData("ohhts_1182_002r")		' 시간외단일가(시간별)
		
		'10호가창 중간위치
		contHoga.scroll_pos = "vcenter"
		contDebi.scroll_pos = "vcenter"
		
		if g_szMk = "W" then		
			'DATAMANAGER.RequestRealData("")
		else
			
			DATAMANAGER.RequestRealData("ohhts_ovtp_aspr")
		end if
	
	elseif szTranID == "obcsb_acif_077r" then
		szAgrmRfusClcd = DATAMANAGER.GetDataValue(0, "obcsb_acif_077r", "OutBlock1", "AGRM_RFUS_CLCD" , 0)
		szAgrmValdYN   = DATAMANAGER.GetDataValue(0, "obcsb_acif_077r", "OutBlock1", "AGRM_VALD_YN" , 0) 
		
		if szAgrmRfusClcd ~= "2" and szAgrmValdYN == "Y" then
			'거래가능
		else
			Form.OpenPopup("mbtre13000_p10" , "", "")
		end if
		
    end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	'Form.ShowAlert(szTranID, g_szMk)
	' ----------------------------------------------------------------------
	' 주식체결 자동갱신
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_stck_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 주식호가 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_stck_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' ELW체결 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_elw_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg" , "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' ELW호가 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_elw_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_elw_aspr" , "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 시간외단일가체결 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_ovtp_cntg" then
		'20170622 LES START - 실시간 서비스 인풋값 설정 수정
		'DATAMANAGER.SetDataValue(1, "ohhts_ovtp_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
		DATAMANAGER.SetDataValue(1, "ohhts_ovtp_cntg", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 시간외단일가호가 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_ovtp_aspr" then
		'20170622 LES START - 실시간 서비스 인풋값 설정 수정
		'DATAMANAGER.SetDataValue(1, "ohhts_frbr_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)	
		DATAMANAGER.SetDataValue(1, "ohhts_ovtp_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	
	'20180716 LES START - K-OTC상품 추가
	elseif szTranID == "ohhts_frbr_aspr" then
		
		DATAMANAGER.SetDataValue(1, "ohhts_frbr_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	
	elseif szTranID == "ohhts_frbr_cntg" then
		
		DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)
	
	'20180716 LES END
	
	end if
End Sub

