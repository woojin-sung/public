' ----- 주문설정값 공통변수 End ---------------------------------------------

Dim g_szCd, g_szMk
g_szCd, g_szMk = "", ""

Dim g_szSlt
Dim g_szSlt2
g_szSlt = "HOGA1"
g_szSlt2 = "HOGA"

Dim g_szType
g_szType = ""

Dim g_szRtnO
g_szRtnO = ""

' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm =""

