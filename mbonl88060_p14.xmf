'============================================================================
' 화 면 명 : 단기사채 상품내용 및 투자대상 팝업
'============================================================================

Dim g_szReturnKey

'============================================================================
Sub Form_OnFormInit()

	'상품상세화면에서 SetShared한 값으로 조회함.
	g_KOR_ISNM = Form.GetSharedData("MBONL88060_P1_KOR_ISNM")	'종목명
	g_PBLC_DATE = Form.GetSharedData("MBONL88060_P1_PBLC_DATE")	'발행일
	g_MTRT_DATE = Form.GetSharedData("MBONL88060_P1_MTRT_DATE")	'만기일
	g_CRDT_GRAD = Form.GetSharedData("MBONL88060_P1_CRDT_GRAD")	'신용등급
	g_PROD_GRAD_CODE = Form.GetSharedData("MBONL88060_P1_PROD_GRAD_CODE")	'투자등급		
	
	'20240202 채권 국공채표시 내용 추가
	g_PROD_TYPE = Form.GetSharedData("MBONL88060_P1_PROD_TYPE")	'채권상품분류		
	
	'2줄로 처리된 종목명을 다시 한줄로
	g_KOR_ISNM = Replace(g_KOR_ISNM, "\n", "")
	
	'종목명 긴 경우, 멀티라인 2줄까지만 출력되도록..
	if Len(g_KOR_ISNM) > 40 then
		lblData1.fontsize = -2
	else
		lblData1.fontsize = 0
	end if
	
	lblData1.caption = g_KOR_ISNM
	lblData2.caption = g_PBLC_DATE 
	lblData3.caption = g_MTRT_DATE
	'20240202 채권 국공채표시 내용 추가
	if (g_CRDT_GRAD == "" or g_CRDT_GRAD == null) and (trim(g_PROD_TYPE) == "국채" or trim(g_PROD_TYPE) == "지방채") then
		lblData4.caption = "국공채"
	else
		lblData4.caption = g_CRDT_GRAD
	end if
	lblData5.caption = g_PROD_GRAD_CODE
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbonl88060_p14" , g_szReturnKey)
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	g_szReturnKey = "cancel"
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()	
	g_szReturnKey = "ok"
	Form.CloseForm()	
End Sub

	</SCRIPT_INFO>
