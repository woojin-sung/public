'============================================================================
Sub initControl()
	'-------------------------------------------------------
	'(상단) 1. 뒤로가기 버튼
	'---------------------------------`----------------------
	'ImgBackPress.setMaintainingRatio("2")
	ImgBackPress.maintainratio = "2"
	ImgBackPress.imgpath = "icon_main_01"
	
	'--------------------------------------------------------------
	'(상단) 2. 국내/해외 탭
	'--------------------------------------------------------------
	'디폴트 폰트사이즈
	nTextSize = 2		'4 -> 2
	
	'큰글씨 폰트크기(1:조금크게 2:크게)
	szTextSizeMode = Form.GetEnvData("common.textsize")
	
	if CInt(szTextSizeMode) > 0 then
		nTextSize = nTextSize - Cint(szTextSizeMode) * 2
	end if

	'--------------------------------------------------------------
	'(종목리스트, 사이드바) 3. 종목리스트 높이 및 사이트바 Top 높이
	'--------------------------------------------------------------
	g_nSearchHeight = contSearch.height
	
	if gOsType == "1" then
		g_nTableTop = Table0.top_uc

	else
		g_nTableTop = Table0.top

	end if
	'--------------------------------------------------------------
	if gOsType == "1" then
		fmtabSearch.setTabDefaultImage("tab_03_o.9","alpha.9")
		
	else
		fmtabSearch.setTabPageTextBold(0, "국내", nTextSize, True)
		fmtabSearch.setTabPageTextBold(1, "해외", nTextSize, True)
		fmtabSearch.setTabHeaderImage("tab_00_o.9", "alpha", 0)
		
	end if
	
	'-------------------------------------------------------
	'(종목입력) 4. 검색창 영역 컨트롤 설정
	'-------------------------------------------------------
	'contHeader.bgcolor = 320
	contHeader.EditSearch.SetOnOffImage("alpha", "alpha")
	contHeader.EditSearch.hintcolor = "321"
	contHeader.EditSearch.hintdcolor = "321"
	contHeader.ImageSearchBG.imgpath = "bg_infobox.9"
	'contHeader.ImageSearchBG.imgpath = "btn_line2_n.9"
	
	'-------------------------------------------------------
	'(종목입력) 4.1 안드로이드 음성검색 버튼 활성화
	'-------------------------------------------------------
	if gOsType == "1" then
		contHeader.EditSearch.width = 269
		contHeader.ImageSearchBG.width = 295
		contHeader.ImageSearchBG0.imgpath = "btn_line2_n.9"
		contHeader.ImageSearchBG0.visible = true
		
		contHeader.Imagemic.setMaintainingRatio("1")
		contHeader.Imagemic.imgpath = "icon_sub_01"
		contHeader.Imagemic.visible = true
	end if

	'--------------------------------------------------------------
	'(상품선택) 5. 국내/해외 카테고리 탭
	'--------------------------------------------------------------
	fmtabCategory1.setTabHeaderImage( "img_bgcircle_black.9", "img_bgcircle_line.9", 5 )	'활성화/비활성화/여백
	fmtabCategory1.setTabHeaderFgColor( "28", "321" ) 								'활성화/비활성화 폰트색상
	
	fmtabCategory2.setTabHeaderImage( "img_bgcircle_black.9", "img_bgcircle_line.9", 5 ) 	'활성화/비활성화/여백
	fmtabCategory2.setTabHeaderFgColor( "28", "321" )									'활성화/비활성화 폰트색상

	'탭 순서변경 버튼 설정
	imgTabOrder.maintainratio = "3"
	imgTabOrder.imgpath = "btn_tab_edit"
	'fmtabCategory1.setHorzMargin(0, 25)
	'fmtabCategory2.setHorzMargin(0, 25)

	'--------------------------------------------------------------
	'(상품필터) 6. 국내/해외 필터
	'--------------------------------------------------------------
	contFilterEtf.contEtfContent.setScrollBarVisible("0")
	contFilterEtf.contEtfContent.SetScrollAutoSize()
	
	contFilterEtn.contEtnContent.setScrollBarVisible("0")
	contFilterEtn.contEtnContent.SetScrollAutoSize()
	
	contFilterUsa.contUsaContent.setScrollBarVisible("0")
	contFilterUsa.contUsaContent.SetScrollAutoSize()
	
	contFilterChn.contChnContent.setScrollBarVisible("0")
	contFilterChn.contChnContent.SetScrollAutoSize()
	
	'--------------------------------------------------------------
	'(종목리스트) 7. 컨테이너
	'--------------------------------------------------------------
	if gOsType == "2" then		'iOS일 때는 종목선택창 뷰 순서를 지정해 줌
		contSearch.setSearchBelowCtrl("imgAlphaBot")
	end if
	
	'--------------------------------------------------------------
	'(검색초성버튼) 8. 사이트 초성버튼(테이블)
	'--------------------------------------------------------------
	Table0.setMoveVibrator(true)	'스크립트 함수 추가 필요(2)

End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	gOsType = Form.GetSharedData("&OS_TYPE", false)
	imgNotice.maintainratio = "2"
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim arrData
	
	Form.requestIntrItemList("00")		'관심종목 리스트 조회

	contSearch.setSearchMode(true)

	initControl()

	sLinkData = Form.GetOpenLinkData()
	arrData   = Split(sLinkData,"★")
	
	g_sScreenNo = Form.GetSharedData( "&SCREEN_NO", false )
	
	if #arrData > 2 then
		sTitle = arrData(0)			'종목검색 타이틀
		lblTitle.caption = sTitle
		
		g_sSearchType = arrData(1)		'종목분류
		g_sMarketType = arrData(3)
		g_sSwitchNo = arrData(4)		'국내->해외, 해외->국내 종목 선택 후 오픈할 화면번호

		makeTabCategory()				'종목 카테고리 탭 구성
		
	else
		showHideCategoryFilter(false, "")
		
	end if

End Sub

'============================================================================
