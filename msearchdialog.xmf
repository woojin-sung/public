			'lblLine2.visible = true
			
			processFilterMoveChn(false)
			
			contSearch.setSearchTypeEx(SEARCH_TYPE_CONT_NEW_GLOBAL_CHN, sEditSearch)
			
		elseif sPageId == "page55" then		'홍콩
