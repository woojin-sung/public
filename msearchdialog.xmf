Sub displaySidebar(sEditSearch)	
	if sEditSearch == "" then
		Table0.visible = true
	
	else
		Table0.visible = false
		
	end if

End Sub

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName == "SEARCH_DLG_RETURN" then
		Dim arrData, sItemCd, sItemNm, sOvrs	
		
		arrData = Split(sReturn1,"★")
		
		if #arrData > 2 then
			sItemCd = arrData(0)	'종목코드
			sItemNm = arrData(1)	'종목명
			sOvrs   = arrData(2)	'해외여부(OVRS)
		end if
		
		'Form.Log("Form_OnCommonDialogReturn", sReturn2 & "@" & sReturn1)
		
		'-------------------------------------------------------
		'종목선택(sReturn1 = 거래소@티커★종목명 // sReturn2 = SELECT)
		'-------------------------------------------------------
		if sReturn2 == "SELECT" then
			if sOvrs == "OVRS" then
				Form.SetSharedData( "&ITEM_CODE" , sItemCd )
				Form.SetSharedData( "&ITEM_KORNAME" , sItemNm  )
				Form.SetSharedData( "&ITEM_OVERSTOCK", sItemCd.."★"..sItemNm.."★".."", "" )
				'Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", sItemCd.."★"..sItemNm.."★".."", "" )
			
				if g_sMarketType <> sOvrs then		'오픈된 화면 (국내), 선택한 종목 (해외)	
					if g_sSwitchNo <> null and g_sSwitchNo <> "" then
						Form.openScreen(g_sSwitchNo, "")
	
					else
						Form.openScreen("16000", "")		'디폴트: 해외주식현재가
	
					end if
					
					Exit Sub
				end if

			else									'오픈된 화면 (해외), 선택한 종목 (국내)			
				Form.SetSharedData( "&ITEM_STOCK", sItemCd )
			
				if g_sMarketType <> sOvrs then			
					if g_sSwitchNo <> null and g_sSwitchNo <> "" then
						Form.openScreen(g_sSwitchNo, "")

					else
						Form.openScreen("11000", "")	'디폴트: 주식현재가
						
					end if
					
					Exit Sub
				end if

			end if

			'부모화면에 선택 종목정보 넘김
			Form.SendReturnToParent("DLG_SELECT", sReturn1)
			Form.CloseForm()
			
'		'----------------------------------------------------------------------------		
'		'관심종목(sReturn1 = 거래소@티커★종목명 // sReturn2 = INTR_ADD or INTR_DEL)
'		'----------------------------------------------------------------------------
'		'[팝업화면 링크데이터]
'		'종목정보★처리구분값★처리완료후 리턴받을 값
'		'arrData(0) 	= 거래소@티커
'		'sParam 		= 관심종목처리 구분값
'		'arrData(0) 	= 거래소@티커(처리완료 후 리턴받을 값)
'		'----------------------------------------------------------------------------
		elseif sReturn2 == "INTR" then

			arrData = Split(sReturn1,"★")
			sParam = "ADD"
			
			Form.OpenPopupAnimation("mhprc11000_pd", arrData(0) & "★"& sParam,"", "2")	'종목등록
		
		elseif sReturn2 == "INTR_ADD" then
			
			arrData = Split(sReturn1,"★")
			sParam = "ADD"
			
			Form.OpenPopupAnimation("mhprc11000_pd", arrData(0) & "★"& sParam,"", "2")	'종목등록

		elseif sReturn2 == "INTR_DEL" then																'종목삭제
			
			arrData = Split(sReturn1,"★")
			sParam = "DEL"
			
			Form.OpenPopup("mhprc11000_pe", arrData(0) & "★" & sParam, "", "")			'종목삭제

		elseif sReturn2 == "INTG_SCROLLBEGIN" then		'이벤트 추가 필요(1)
			contHeader.EditSearch.SetShowKeypad(false)
			
			
		elseif sReturn2 == "INTG_SCROLLNEXT" then		'이벤트 추가 필요(2)			
			if g_bReqMode = true then
				if fmtabSearch.currenttab == "0" or fmtabSearch.currenttab == 0 then		'국내
					if DATAMANAGER.IsMoreNextData("ohhts_srch_001r") == true then
						if g_bNextRequest == false then
							g_bNextRequest = true
							DATAMANAGER.RequestNextData("ohhts_srch_001r")
						end if
					end if
				else									'해외
					if DATAMANAGER.IsMoreNextData("ohhts_srch_101r") == true then
						if g_bNextRequest == false then
							g_bNextRequest = true
							DATAMANAGER.RequestNextData("ohhts_srch_101r")
						end if
					end if
				end if
			end if
			
		elseif sReturn2 == "INTG_ITEMSEXIST" then		'이벤트 추가 필요(3)
			Dim sCurrentTabID, sCurSearchText, nCalcTop
		
			sCurSearchText = contHeader.EditSearch.caption
		
			if sReturn1 == "1" then
				imgNotice.visible = false
				lbNoticeMsg.visible = false				
			
			else
				if gOsType == "1" then
					imgNotice.top = Table0.top_uc + 30					
					lbNoticeMsg.top = Form.calcUnResize(imgNotice.top, "1") + 60
			
				else			
					imgNotice.top = Table0.top + 30
					lbNoticeMsg.top = imgNotice.top + 60
				
				end if
			
				imgNotice.visible = true
				lbNoticeMsg.visible = true
				
				if fmtabSearch.currenttab == "0" or fmtabSearch.currenttab == 0 then		'국내
					sCurrentTabID = fmtabCategory1.currenttabpageid
					if sCurrentTabID == "page1" and sCurSearchText == "" then
						lbNoticeMsg.caption = "최근 조회한 종목이 없어요."
						
					else
						lbNoticeMsg.caption = "검색 결과가 없어요."
					
					end if
					
				else																'해외
					sCurrentTabID = fmtabCategory2.currenttabpageid
					if sCurrentTabID == "page11" and sCurSearchText == "" then
						lbNoticeMsg.caption = "최근 조회한 종목이 없어요."
						
					else
						lbNoticeMsg.caption = "검색 결과가 없어요."
					
					end if
					
				end if
			
			end if

		end if
		
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mhprc11000_save" then
		szInstr = CInt(Instr(sRet, "★"))
		if szInstr > 0 and Trim(sRet) <> "" then
			tList = Split(sRet, "★") 
			
			if tList(2) == "ADD" then
				if gOsType == "1" then
					Form.addIntrItemList(tList(3))
				end if
				
				contSearch.refreshIntrItem()
				
			elseif tList(2) == "DEL" then
				if gOsType == "1" then
					Form.delIntrItemList(tList(3))
				end if
				
				contSearch.refreshIntrItem()
				
			end if
		else
			exit Sub
			
		end if
	end if
	
End Sub

