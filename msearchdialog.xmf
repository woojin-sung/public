Sub initExstItemSearch()
	fmtabCategory2.insertPage( 0, "page11", "page11", "empty", "0", "최근" )
	fmtabCategory2.insertPage( 1, "page22", "page22", "empty", "0", "전체" )
	fmtabCategory2.insertPage( 2, "page33", "page33", "empty", "0", "미국" )
	fmtabCategory2.insertPage( 3, "page44", "page44", "empty", "0", "중국" )
	fmtabCategory2.insertPage( 4, "page55", "page55", "empty", "0", "홍콩" )
	fmtabCategory2.insertPage( 5, "page66", "page66", "empty", "0", "일본" )
	
End Sub
'============================================================================
Function isExstStock()
	Dim arrSearchData, bRet
	arrSearchData = Split(g_sSearchType, ":")

	bRet = false

	if #arrSearchData > 0 then
		nCount = #arrSearchData
	
		for i = 0 to #arrSearchData - 1 Step 1		
			sSearchType = arrSearchData(i)
			
			if sSearchType == SEARCH_TYPE_CONT_NEW_GLOBAL_RECENT then
				bRet = true
			
			elseif sSearchType == SEARCH_TYPE_CONT_NEW_GLOBAL_TOTAL then
				bRet = true
				
			elseif sSearchType == SEARCH_TYPE_CONT_NEW_GLOBAL_USA then
				bRet = true
				
			elseif sSearchType == SEARCH_TYPE_CONT_NEW_GLOBAL_CHN then
				bRet = true
			
			elseif sSearchType == SEARCH_TYPE_CONT_NEW_GLOBAL_HK then
				bRet = true
			
			elseif sSearchType == SEARCH_TYPE_CONT_NEW_GLOBAL_JP then
				bRet = true
			
			end if
		next		
		
	end if
	
	return bRet

End Function
'============================================================================
Sub loadElwExprMonth()		'ELW 만기월 정보 로딩
	Dim arrElwExpr, nIdx, sExprMonth, sTitleMonth

	sTmpData = Form.getElwExprMonth()	'스크립트 함수 추가 필요(1)
	arrElwExpr = Split(sTmpData, ":")

	nIdx = 0

	g_elwExprT(nIdx) = "만기월 전체"
	g_elwExprC(nIdx) = "1"
	g_elwExprV(nIdx) = "*"
	'g_elwExprD(nIdx) = "1"

	nIdx = nIdx + 1

	if #arrElwExpr > 0 then
		for i = 0 to #arrElwExpr - 1
			sExprMonth = arrElwExpr(i)
			sTitleExprMonth = left(sExprMonth, 4) & "년 " & right(sExprMonth, 2) & "월"
			g_elwExprT(nIdx) = sTitleExprMonth
			g_elwExprV(nIdx) = sExprMonth
			g_elwExprC(nIdx) = "0"
			'g_elwExprD(nIdx) = "0"
			
			nIdx = nIdx + 1
		next
	end if

End Sub
'============================================================================
Sub fmtabSearch_OnTabChanged(nCurrentTab)
	contHeader.EditSearch.caption = ""
	g_sCurPage1 = ""
	g_sCurPage2 = ""

	if nCurrentTab == 0 then		'국내
		initShowSearchDialog("0")
		
	else							'해외
		initShowSearchDialog("1")

	end if
	
	'contSearch.setSearchKeyword("")
	
End Sub
'============================================================================
Sub initShowSearchDialog(sType)
	contFilterEtf.visible = false
	contFilterEtn.visible = false
	contFilterElw.visible = false
	contFilterUsa.visible = false
	contFilterChn.visible = false
	contFilterHk.visible = false
	contFilterJp.visible = false
	
	showHideFilterPopup(false)

	if sType == "0" then			'국내
		fmtabCategory1.visible = true
		
		if gOsType == "2" then
			nRealCurTab = fmtabCategory1.getRealCurrentTab()
			if nRealCurTab > -1 then
				fmtabCategory1.currenttab = CStr(nRealCurTab)
				fmtabCategory1_OnTabChanged(nRealCurTab)
			
			else
				fmtabCategory1.currenttab = "0"
				fmtabCategory1_OnTabChanged(0)			
			
			end if
		
		else
			fmtabCategory1.currenttab = "0"
			fmtabCategory1_OnTabChanged(0)
		
		end if

		fmtabCategory2.visible = false
		'imgTabOrder.visible = false
	
	else							'해외
		fmtabCategory2.visible = true
		
		if gOsType == "2" then
			nRealCurTab = fmtabCategory2.getRealCurrentTab()
			if nRealCurTab > -1 then
				fmtabCategory2.currenttab = CStr(nRealCurTab)
				fmtabCategory2_OnTabChanged(nRealCurTab)
				
			else
				fmtabCategory2.currenttab = "0"
				fmtabCategory2_OnTabChanged(0)
			
			end if
				
		else
			fmtabCategory2.currenttab = "0"
			fmtabCategory2_OnTabChanged(0)
			
		end if

		fmtabCategory1.visible = false
		'imgTabOrder.visible = true

	end if

End Sub

'============================================================================
Sub fmtabCategory1_OnTabChanged(nCurrentTab)		'국내 상품 카테고리 선택
	if fmtabSearch.currenttab <> "0" and fmtabSearch.currenttab <> 0 then
		Exit Sub
	end if

	sPageId = fmtabCategory1.currenttabpageid
	
	if g_sCurPage1 <> sPageId then
		if sPageId == "page3" then		'ETF
			DATAMANAGER.RequestTranData("ohhts_0550_001r")	'(국내) 자산운용사
	
		elseif sPageId == "page4" then	'ETN
			DATAMANAGER.RequestTranData("ohhts_1303_200r")	'(국내) 발행사
			
		elseif sPageId == "page5" then	'ELW
			DATAMANAGER.RequestTranData("ohhts_0500_001r")	'기초자산
			DATAMANAGER.RequestTranData("ohhts_0502_001r")	'발행사
			
		end if
		
		showHideCategoryFilter(false, sPageId)
		g_sCurPage1 = sPageId

	End if
	
End Sub

'============================================================================
Sub fmtabCategory2_OnTabChanged(nCurrentTab)		'해외 상품 카테고리 선택
	if fmtabSearch.currenttab <> "1" and fmtabSearch.currenttab <> 1 then
		Exit Sub
	end if

	sPageId = fmtabCategory2.currenttabpageid
	
	if g_sCurPage2 <> sPageId then

		if sPageId == "page33" or sPageId == "page44" or sPageId == "page55" or sPageId == "page66" then
			DATAMANAGER.RequestTranData("ohhts_srch_100r")
		
		end if
	
		showHideCategoryFilter(true, sPageId)
		g_sCurPage2 = sPageId
		
	End if
	
End Sub

'============================================================================
Sub showHideCategoryFilter(bOvrs, sPageId)
	Dim sEditSearch

	initUserFilter()

	sEditSearch = contHeader.EditSearch.caption

	if bOvrs == true then
		if sPageId == "page33" then			'미국		
			initUsaFilter()

			contFilterUsa.visible = true
			contFilterChn.visible = false
			contFilterHk.visible = false
			contFilterJp.visible = false
			'contFilterUsa.contUsaContent.scroll_pos = "left"
			
			contSearch.top = 250	'275 -> 262 -> 250
			contSearch.height = g_nSearchHeight + 40
			Table0.top = g_nTableTop
			
			displaySidebar(sEditSearch)
			
			'lblLine2.visible = true
			
			processFilterMoveUsa(false)
						
			contSearch.setSearchTypeEx(SEARCH_TYPE_CONT_NEW_GLOBAL_USA, sEditSearch)
	
		elseif sPageId == "page44" then		'중국
			initChnFilter()
			
			contFilterUsa.visible = false
			contFilterChn.visible = true
			contFilterHk.visible = false
			contFilterJp.visible = false
