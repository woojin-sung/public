			contFilterElw.visible = false
			
			contSearch.top = 207
			contSearch.height = g_nSearchHeight + (contFilterEtf.height * 2)
			Table0.top = g_nTableTop - 45
			
			displaySidebar(sEditSearch)
			
			'lblLine2.visible = false

			contSearch.setSearchTypeEx(SEARCH_TYPE_CONT_NEW_TOTAL, sEditSearch)
			
		else								'최근
