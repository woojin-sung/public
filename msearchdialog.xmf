		g_filterS5 = "1"
		
	end if

	if g_filterP5 == "0" then
		Form.SetSharedData("FILTER_DATA", Convert_ArrToString(g_etnLeverT, "`"))
		Form.SetSharedData("FILTER_CHECK", Convert_ArrToString(g_etnLeverC, "`"))
		
		Form.triggerEvent("LinkForm0", "FILTER", "ETN_LEVER")
		
		setFilterHeight(4)
		
		showHideFilterPopup(true)
		g_filterP5 = "1"
	
	else
		showHideFilterPopup(false)
		g_filterP5 = "0"
	
	end if
End Sub

'============================================================================
Sub checkBeforeEtnFilter(nType)
	if nType == 1 then
		if g_filterP2 == "1" then
			recoverEtnFilter(2)			
			Exit Sub
		end if
		
		if g_filterP3 == "1" then
			recoverEtnFilter(3)
			Exit Sub
		end if
		
		if g_filterP4 == "1" then
			recoverEtnFilter(4)
			Exit Sub
		end if
		
		if g_filterP5 == "1" then
			recoverEtnFilter(5)
			Exit Sub
		end if
	
	elseif nType == 2 then
		if g_filterP1 == "1" then
			recoverEtnFilter(1)
			Exit Sub
		end if
		
		if g_filterP3 == "1" then
			recoverEtnFilter(3)
			Exit Sub
		end if
		
		if g_filterP4 == "1" then
			recoverEtnFilter(4)
			Exit Sub
		end if
		
		if g_filterP5 == "1" then
			recoverEtnFilter(5)
			Exit Sub
		end if
		
	elseif nType == 3 then
		if g_filterP1 == "1" then
			recoverEtnFilter(1)
			Exit Sub
		end if
		
		if g_filterP2 == "1" then
			recoverEtnFilter(2)
			Exit Sub
		end if
		
		if g_filterP4 == "1" then
			recoverEtnFilter(4)
			Exit Sub
		end if
		
		if g_filterP5 == "1" then
			recoverEtnFilter(5)
			Exit Sub
		end if		
	
	elseif nType == 4 then
		if g_filterP1 == "1" then
			recoverEtnFilter(1)
			Exit Sub
		end if
		
		if g_filterP2 == "1" then
			recoverEtnFilter(2)
			Exit Sub
		end if		
		
		if g_filterP3 == "1" then
			recoverEtnFilter(3)
			Exit Sub
		end if
		
		if g_filterP5 == "1" then
			recoverEtnFilter(5)
			Exit Sub
		end if
		
	elseif nType == 5 then
		if g_filterP1 == "1" then
			recoverEtnFilter(1)
			Exit Sub
		end if
		
		if g_filterP2 == "1" then
			recoverEtnFilter(2)
			Exit Sub
		end if		
		
		if g_filterP3 == "1" then
			recoverEtnFilter(3)
			Exit Sub
		end if
		
		if g_filterP4 == "1" then
			recoverEtnFilter(4)
			Exit Sub
		end if
	
	end if

End Sub

Sub recoverEtnFilter(nType)
	if nType == 1 then
		if g_filterS1 == "1" and g_etnSortC[0] == "1" then
			contFilterEtn.contEtnContent.imgFilter1.imgPath = "btn_line2_n.9"
			contFilterEtn.contEtnContent.Label1.fontbold = "0"
			contFilterEtn.contEtnContent.Label1.fgcolor = "321"
			
			g_filterS1 = "0"
			
		else
			contFilterEtn.contEtnContent.imgFilter1.imgPath = "btn_line2_o.9"
			contFilterEtn.contEtnContent.Label1.fontbold = "1"
			contFilterEtn.contEtnContent.Label1.fgcolor = "4"
			
		end if
		
		g_filterP1 = "0"
	
	elseif nType == 2 then
		if g_filterS2 == "1" and g_etnMarketC[0] == "1" then
			contFilterEtn.contEtnContent.imgFilter2.imgPath = "btn_line2_n.9"
			contFilterEtn.contEtnContent.Label2.fontbold = "0"
			contFilterEtn.contEtnContent.Label2.fgcolor = "321"
			
			g_filterS2 = "0"
			
		else
			contFilterEtn.contEtnContent.imgFilter2.imgPath = "btn_line2_o.9"
			contFilterEtn.contEtnContent.Label2.fontbold = "1"
			contFilterEtn.contEtnContent.Label2.fgcolor = "4"
			
		end if
		
		g_filterP2 = "0"
		
	elseif nType == 3 then
		if g_filterS3 == "1" and g_etnUnderC[0] == "1" then
			contFilterEtn.contEtnContent.imgFilter3.imgPath = "btn_line2_n.9"
			contFilterEtn.contEtnContent.Label3.fontbold = "0"
			contFilterEtn.contEtnContent.Label3.fgcolor = "321"
			
			g_filterS3 = "0"
			
		else
			contFilterEtn.contEtnContent.imgFilter3.imgPath = "btn_line2_o.9"
			contFilterEtn.contEtnContent.Label3.fontbold = "1"
			contFilterEtn.contEtnContent.Label3.fgcolor = "4"
			
		end if
		
		g_filterP3 = "0"

	elseif nType == 4 then
		if g_filterS4 == "1" and g_etnPubcC[0] == "1" then
			contFilterEtn.contEtnContent.imgFilter4.imgPath = "btn_line2_n.9"
			contFilterEtn.contEtnContent.Label4.fontbold = "0"
			contFilterEtn.contEtnContent.Label4.fgcolor = "321"
			
			g_filterS4 = "0"
			
		else
			contFilterEtn.contEtnContent.imgFilter4.imgPath = "btn_line2_o.9"
			contFilterEtn.contEtnContent.Label4.fontbold = "1"
			contFilterEtn.contEtnContent.Label4.fgcolor = "4"
			
		end if
		
		g_filterP4 = "0"
	
	elseif nType == 5 then
		if g_filterS5 == "1" and g_etnLeverC[0] == "1" then
			contFilterEtn.contEtnContent.imgFilter5.imgPath = "btn_line2_n.9"
			contFilterEtn.contEtnContent.Label5.fontbold = "0"
			contFilterEtn.contEtnContent.Label5.fgcolor = "321"
			
			g_filterS5 = "0"
			
		else
			contFilterEtn.contEtnContent.imgFilter5.imgPath = "btn_line2_o.9"
			contFilterEtn.contEtnContent.Label5.fontbold = "1"
			contFilterEtn.contEtnContent.Label5.fgcolor = "4"
			
		end if
		
		g_filterP5 = "0"
		
	End if

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_0550_001r" then		'ETF 운용사
		DATAMANAGER.SetDataValue(FALSE, "ohhts_0550_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE", 0, "550")
		
	elseif szTranID == "ohhts_1303_200r" then	'ETN 발행사
		DATAMANAGER.SetDataValue(FALSE, "ohhts_1303_200r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE", 0, "13031")
		DATAMANAGER.SetDataValue(FALSE, "ohhts_1303_200r", "InBlock2", "FID_INPUT_COND_SCR_DIV_CODE", 0, "13032")
		
	elseif szTranID == "ohhts_0500_001r" then	'ELW 기초자산
		DATAMANAGER.SetDataValue(FALSE, "ohhts_0500_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE", 0, "0500")	
		
	elseif szTranID == "ohhts_0502_001r" then	'ELW 발행사
		DATAMANAGER.SetDataValue(FALSE, "ohhts_0502_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE", 0, "0502")
		
	elseif szTranID == "ohhts_srch_001r" then
		Dim sKeyword, sLogValue
		
		sKeyword = contHeader.EditSearch.caption
		DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock1", "FID_INPUT_SRCH_NAME", 0, sKeyword)
		
		sPageId = fmtabCategory1.currenttabpageid
		
		'Form.Log("[PSM3EXST] ohhts_srch_001r", sKeyword & "@" & sPageId)
		
		SetDataValueEtfEtn(sPageId)
		
	elseif szTranID == "ohhts_srch_100r" then
		sPageId = fmtabCategory2.currenttabpageid

		if sPageId == "page33" then			'미국
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_100r", "InBlock1", "FIDX_INPUT_NTNL_CODE", 0, "US")
			
		elseif sPageId == "page44" then		'중국
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_100r", "InBlock1", "FIDX_INPUT_NTNL_CODE", 0, "CN")
		
		elseif sPageId == "page55" then		'홍콩
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_100r", "InBlock1", "FIDX_INPUT_NTNL_CODE", 0, "HK")
			
		elseif sPageId == "page66" then		'일본
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_100r", "InBlock1", "FIDX_INPUT_NTNL_CODE", 0, "JP")
			
		end if
		
	elseif szTranID == "ohhts_srch_101r" then
		Dim sKeyword, sLogValue
		
		sKeyword = contHeader.EditSearch.caption
		DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_101r", "InBlock1", "FID_INPUT_SRCH_NAME", 0, sKeyword)
	
		sPageId = fmtabCategory2.currenttabpageid

		SetDataValueExst(sPageId)
		
	end if
End Sub
'============================================================================
Sub SetDataValueEtfEtn(sPage)
	if sPage == "page3" then	'ETF
		DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock1", "FID_ETN_YN", 0, "")
	
		if g_etfSortI == -1 then
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE", 0, g_etfSortV(0))
	
		else		
			if g_etfSortC(g_etfSortI) == "1" then
				DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE", 0, g_etfSortV(g_etfSortI))
			end if
		end if

		if g_etfMarketI == -1 then
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock2", "FID_INPUT_NMIX_MRKT_DIV", 0, g_etfMarketV(0))
		
		else
			if g_etfMarketC(g_etfMarketI) == "1" then
				DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock2", "FID_INPUT_NMIX_MRKT_DIV", 0, g_etfMarketV(g_etfMarketI))
				
			end if
		end if
		
		if g_etfUnderI == -1 then
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock3", "FID_INPUT_NMIX_ASET_DIV", 0, g_etfUnderV(0))
		
		else
			if g_etfUnderC(g_etfUnderI) == "1" then
				DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock3", "FID_INPUT_NMIX_ASET_DIV", 0, g_etfUnderV(g_etfUnderI))

			end if
		end if

		if g_etfOprtI == -1 then
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_COND_MRKT_CLS_CODE", 0, g_etfOprtV(0))
			
		else
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_COND_MRKT_CLS_CODE", 0, g_etfOprtV(g_etfOprtI))
				
		end if

		if g_etfLeverI == -1 then
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_NMIX_ASET_DIV", 0, g_etfLeverV(0))
		
		else
			if g_etfLeverC(g_etfLeverI) == "1" then
				DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_NMIX_ASET_DIV", 0, g_etfLeverV(g_etfLeverI))
				
				if g_etfLeverV(g_etfLeverI) == "P1" then
					DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_NMIX_ASET_DIV", 1, "PA")
				
				elseif g_etfLeverV(g_etfLeverI) == "P2" then
					DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_NMIX_ASET_DIV", 1, "PB")
					
				elseif g_etfLeverV(g_etfLeverI) == "N1" then
					DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_NMIX_ASET_DIV", 1, "NA")

				elseif g_etfLeverV(g_etfLeverI) == "N2" then
					DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_NMIX_ASET_DIV", 1, "NB")
				
				end if
				
			end if
		end if
	
	elseif sPage == "page4" then	'ETN
		DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock1", "FID_ETN_YN", 0, "Y")
		
		if g_etnSortI == -1 then
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE", 0, g_etnSortV(0))
		
		else			
			if g_etnSortC(g_etnSortI) == "1" then
				DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE", 0, g_etnSortV(g_etnSortI))

			end if
		end if

		if g_etnMarketI == -1 then
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock2", "FID_INPUT_NMIX_MRKT_DIV", 0, g_etnMarketV(0))
		
		else
			if g_etnMarketC(g_etnMarketI) == "1" then
				DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock2", "FID_INPUT_NMIX_MRKT_DIV", 0, g_etnMarketV(g_etnMarketI))
				
			end if
		end if
		
		if g_etnUnderI == -1 then
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock3", "FID_INPUT_NMIX_ASET_DIV", 0, g_etnUnderV(0))
		
		else			
			if g_etnUnderC(g_etnUnderI) == "1" then
				DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock3", "FID_INPUT_NMIX_ASET_DIV", 0, g_etnUnderV(g_etnUnderI))

			end if
		end if

		if g_etnPubcI == -1 then
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_COND_MRKT_CLS_CODE", 0, "")
			
		else
			if g_etnPubcI == 0 then
				DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_COND_MRKT_CLS_CODE", 0, "")
			else
				DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_COND_MRKT_CLS_CODE", 0, g_etnPubcV(g_etnPubcI))
			end if

		end if
		
		if g_etnLeverI == -1 then
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_NMIX_ASET_DIV", 0, g_etnLeverV(0))
			
		else		
			if g_etnLeverC(g_etnLeverI) == "1" then
				DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_NMIX_ASET_DIV", 0, g_etnLeverV(g_etnLeverI))
				'Form.Log("[PSM3EXST] lever2", g_etnLeverV(g_etnLeverI))
				
				if g_etnLeverV(g_etnLeverI) == "P1" then
					DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_NMIX_ASET_DIV", 1, "PA")
				
				elseif g_etnLeverV(g_etnLeverI) == "P2" then
					DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_NMIX_ASET_DIV", 1, "PB")
					
				elseif g_etnLeverV(g_etnLeverI) == "P3" then
					DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_NMIX_ASET_DIV", 1, "PC")
					
				elseif g_etnLeverV(g_etnLeverI) == "N1" then
					DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_NMIX_ASET_DIV", 1, "NA")

				elseif g_etnLeverV(g_etnLeverI) == "N2" then
					DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_NMIX_ASET_DIV", 1, "NB")
				
				elseif g_etnLeverV(g_etnLeverI) == "N3" then
					DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_001r", "InBlock4", "FID_INPUT_NMIX_ASET_DIV", 1, "NC")
				
				end if

			end if
		
		end if
		
	end if
End Sub

