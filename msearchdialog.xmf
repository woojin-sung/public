	elseif sEventName == "FILTER_ETN_UNDER" then

		g_etnUnderC = {}
		g_etnUnderC = Convert_StringToArr(sRetData, "`")
		g_etnUnderI = CInt(sParam)
		
		if #g_etnUnderC > 0 then
			if g_etnUnderC(0) == "1" then
				contFilterEtn.contEtnContent.imgFilter3.imgPath = "btn_line2_n.9"
				contFilterEtn.contEtnContent.Label3.fontbold = "0"
				contFilterEtn.contEtnContent.Label3.fgcolor = "321"
				
				g_filterS3 = "0"
				
			else
				contFilterEtn.contEtnContent.imgFilter3.imgPath = "btn_line2_o.9"
				contFilterEtn.contEtnContent.Label3.fontbold = "1"
				contFilterEtn.contEtnContent.Label3.fgcolor = "4"
				
			end if
		end if
		
		processLoadItemEtn()
		
		showHideFilterPopup(false)
		g_filterP3 = "0"
		
	elseif sEventName == "FILTER_ETN_LEVER" then

		g_etnLeverC = {}
		g_etnLeverC = Convert_StringToArr(sRetData, "`")
		g_etnLeverI = CInt(sParam)

		if #g_etnLeverC > 0 then
