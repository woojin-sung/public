		else
			'if g_hkOprtC(g_hkOprtI) == "1" then
				DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_101r", "InBlock3", "FIDX_MGCO_CODE", 0, g_hkOprtV(g_hkOprtI))
				
			'end if
		end if
	
		if g_hkLeverI == -1 then
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_101r", "InBlock4", "FID_INPUT_LVRG", 0, g_hkLeverV(0))
	
		else
			if g_hkLeverC(g_hkLeverI) == "1" then
				DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_101r", "InBlock4", "FID_INPUT_LVRG", 0, g_hkLeverV(g_hkLeverI))
				
			end if
			
		end if
		
	elseif sPageId == "page66" then		'일본
		DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_101r", "InBlock1", "FIDX_NTNL_CODE", 0, "JP")
		
		if g_jpSortI == -1 then
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_101r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE", 0, g_jpSortV(0))
		
		else
			if g_jpSortC(g_jpSortI) == "1" then
				DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_101r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE", 0, g_jpSortV(g_jpSortI))
				
			end if
		end if
		
		DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_101r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "")
		
		if g_jpOprtI == -1 then
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_101r", "InBlock3", "FIDX_MGCO_CODE", 0, g_jpOprtV(0))
		
		else		
			'if g_jpOprtC(g_jpOprtI) == "1" then
				DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_101r", "InBlock3", "FIDX_MGCO_CODE", 0, g_jpOprtV(g_jpOprtI))
				
			'end if
		end if
	
		if g_jpLeverI == -1 then
			DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_101r", "InBlock4", "FID_INPUT_LVRG", 0, g_jpLeverV(0))
	
		else
			if g_jpLeverC(g_jpLeverI) == "1" then
				DATAMANAGER.SetDataValue(FALSE, "ohhts_srch_101r", "InBlock4", "FID_INPUT_LVRG", 0, g_jpLeverV(g_jpLeverI))
				
			end if
		end if
		
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "ohhts_0550_001r" then		'ETF 운용사
		Dim nCount, sOprtV
		nCount = DATAMANAGER.GetDataCount(0, "ohhts_0550_001r", "OutBlock1")
	
		g_etfOprtT = {}
		g_etfOprtC = {}
		g_etfOprtV = {}
		'g_etfOprtD = {}

		for i = 0 to nCount - 1
			g_etfOprtT(i) = DATAMANAGER.GetDataValue(0, "ohhts_0550_001r", "OutBlock1", "FID_MGRI_CO_KOR_NAME", i)
			sOprtV = DATAMANAGER.GetDataValue(0, "ohhts_0550_001r", "OutBlock1", "FID_MGRI_CO_NO", i)

			if i == 0 then
				g_etfOprtV(i) = "    "
			else
				g_etfOprtV(i) = right(sOprtV, 4)
			end if
			
			if i == 0 then
				g_etfOprtC(i) = "1"
				'g_etfOprtD(i) = "1"
			else
				g_etfOprtC(i) = "0"
				'g_etfOprtD(i) = "0"
			end if
			
		next
		
		if #g_etfOprtV > 0 then
			if CmbOprtEtf.rowcount > 0 then
				CmbOprtEtf.clear = true
			end if
		
			for i = 0 to #g_etfOprtV - 1
				CmbOprtEtf.cbadddatatext = g_etfOprtV(i) .. "`" .. g_etfOprtT(i)
			next
		
			CmbOprtEtf.setCurIndexSilent("0")
			'CmbOprtEtf.currentindex = "0"
		
		end if
	
	elseif szTranID == "ohhts_1303_200r" then	'ETN 발행사
		Dim nCount
		nCount = DATAMANAGER.GetDataCount(0, "ohhts_1303_200r", "OutBlock1")
	
		g_etnPubcT = {}
		g_etnPubcC = {}
		g_etnPubcV = {}
		'g_etnPubcD = {}
	
		for i = 0 to nCount - 1
			g_etnPubcT(i) = DATAMANAGER.GetDataValue(0, "ohhts_1303_200r", "OutBlock1", "FID_ELW_PBLC_CO_NAME", i)
			g_etnPubcV(i) = DATAMANAGER.GetDataValue(0, "ohhts_1303_200r", "OutBlock1", "FID_ELW_PBLC_CO_CODE", i)
			
			if i == 0 then
				g_etnPubcC(i) = "1"
				'g_etnPubcD(i) = "1"

			else
				g_etnPubcC(i) = "0"
				'g_etnPubcD(i) = "0"
			
			end if
			
		next
		
		if #g_etnPubcV > 0 then
			if CmbOprtEtn.rowcount > 0 then
				CmbOprtEtn.clear = true
			end if
			
			for i = 0 to #g_etnPubcV - 1
				CmbOprtEtn.cbadddatatext = g_etnPubcV(i) .. "`" .. g_etnPubcT(i)
			next
		
			CmbOprtEtn.setCurIndexSilent("0")
			'CmbOprtEtn.currentindex = "0"
		
		end if
	
	elseif szTranID == "ohhts_0500_001r" then	'ELW 기초자산
		Dim nCount, nIdx
		nCount = DATAMANAGER.GetDataCount(0, "ohhts_0500_001r", "OutBlock1")
	
		g_elwUnderT = {}
		g_elwUnderC = {}
		g_elwUnderV = {}
		'g_elwUnderD = {}

		nIdx = 0

		g_elwUnderT(nIdx) = "전체"
		g_elwUnderV(nIdx) = "000000"
		g_elwUnderC(nIdx) = "1"
		'g_elwUnderD(nIdx) = "1"
		
		nIdx = nIdx + 1

		for i = 0 to nCount - 1
			g_elwUnderT(nIdx) = DATAMANAGER.GetDataValue(0, "ohhts_0500_001r", "OutBlock1", "FID_UNAS_ISNM", i)
			g_elwUnderV(nIdx) = DATAMANAGER.GetDataValue(0, "ohhts_0500_001r", "OutBlock1", "FID_UNAS_SHRN_ISCD", i)

			g_elwUnderC(nIdx) = "0"
			'g_elwUnderD(nIdx) = "0"

			nIdx = nIdx + 1

		next
	
	elseif szTranID == "ohhts_0502_001r" then	'ELW 발행사
		Dim nCount
		nCount = DATAMANAGER.GetDataCount(0, "ohhts_0502_001r", "OutBlock1")
	
		g_elwPubcT = {}
		g_elwPubcC = {}
		g_elwPubcV = {}
		'g_elwPubcD = {}
	
		for i = 0 to nCount - 1
			g_elwPubcT(i) = DATAMANAGER.GetDataValue(0, "ohhts_0502_001r", "OutBlock1", "FID_ELW_PBLC_CO_NAME", i)
			g_elwPubcV(i) = DATAMANAGER.GetDataValue(0, "ohhts_0502_001r", "OutBlock1", "FID_ELW_PBLC_CO_CODE", i)
			
			if i == 0 then
				g_elwPubcC(i) = "1"
				'g_elwPubcD(i) = "1"

			else
				g_elwPubcC(i) = "0"
				'g_elwPubcD(i) = "0"
			
			end if
			
		next
	
	elseif szTranID == "ohhts_srch_100r" then	'해외 ETF 운용사
		Dim nCount
		nCount = DATAMANAGER.GetDataCount(0, "ohhts_srch_100r", "OutBlock1")
		
		sPageId = fmtabCategory2.currenttabpageid
		
		processOvrsOprtSet(sPageId, nCount)
		
	elseif szTranID == "ohhts_srch_001r" then	'국내 ETF/ETN
		'종목선택창(컨테이너)에 종목리스트 전달
		Dim sPageId, sSearchType, sItemCode, sItemList, nCount
		
		sPageId = fmtabCategory1.currenttabpageid
		
		nCount = DATAMANAGER.GetDataCount(0, "ohhts_srch_001r", "OutBlock1")
		
		for i = 0 to nCount - 1
			sItemCode = DATAMANAGER.GetDataValue(0, "ohhts_srch_001r", "OutBlock1", "FID_SHRN_ISCD", i)
			
			if sItemList == null then
				sItemList = sItemCode
			else
				sItemList = sItemList & "★" & sItemCode
			end if
		   
		next
		
		if sPageId == "page3" then		'ETF
			sSearchType = SEARCH_TYPE_CONT_NEW_ETF

		elseif sPageId == "page4" then	'ETN
			sSearchType = SEARCH_TYPE_CONT_NEW_ETN
			
		end if
		
		if sItemList <> null and sItemList <> "" then
			contSearch.setSearchRecvItems(sSearchType, sItemList, g_bNextRequest)
			
		else
			contSearch.setSearchRecvItems(sSearchType, "", g_bNextRequest)
			
		end if
		
		g_bNextRequest = false
		
	elseif szTranID == "ohhts_srch_101r" then	'해외 ETF
		'종목선택창(컨테이너)에 종목리스트 전달
		Dim sPageId, sSearchType, sItemCode, sItemList, nCount
		
		sPageId = fmtabCategory2.currenttabpageid
		
		nCount = DATAMANAGER.GetDataCount(0, "ohhts_srch_101r", "OutBlock1")
		
		for i = 0 to nCount - 1
			sTmpCode = DATAMANAGER.GetDataValue(0, "ohhts_srch_101r", "OutBlock1", "FIDX_ISCD", i)
			sTmpMrkt = DATAMANAGER.GetDataValue(0, "ohhts_srch_101r", "OutBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i)
			
			sItemCode = sTmpMrkt & "@" & sTmpCode
			
			if sItemList == null then
				sItemList = sItemCode
				
			else
				sItemList = sItemList & "★" & sItemCode
				
			end if
		
		next
		
		if sPageId == "page33" then		'미국
			sSearchType = SEARCH_TYPE_CONT_NEW_GLOBAL_USA
		
		elseif sPageId == "page44" then	'중국
			sSearchType = SEARCH_TYPE_CONT_NEW_GLOBAL_CHN
		
		elseif sPageId == "page55" then	'홍콩
			sSearchType = SEARCH_TYPE_CONT_NEW_GLOBAL_HK
			
		elseif sPageId == "page66" then	'일본
			sSearchType = SEARCH_TYPE_CONT_NEW_GLOBAL_JP

		end if
		
		if sItemList <> null and sItemList <> "" then
			contSearch.setSearchRecvItems(sSearchType, sItemList, g_bNextRequest)
			
		else
			contSearch.setSearchRecvItems(sSearchType, "", g_bNextRequest)
			
		end if
		
		g_bNextRequest = false
		
	end if
	
End Sub

Sub processOvrsOprtSet(sPageId, nCount)
	if sPageId == "page33" then
		g_usaOprtT = {}
		g_usaOprtV = {}
		g_usaOprtC = {}
		'g_usaOprtD = {}
		
		nIdx = 0
		
		g_usaOprtT(nIdx) = "운용사전체"
		g_usaOprtV(nIdx) = "        "
		g_usaOprtC(nIdx) = "1"
		'g_usaOprtD(nIdx) = "1"
		
		nIdx = nIdx + 1
		
		for i = 0 to nCount - 1
			g_usaOprtT(nIdx) = DATAMANAGER.GetDataValue(0, "ohhts_srch_100r", "OutBlock1", "FIDX_MGCO_NAME", i)
			g_usaOprtV(nIdx) = DATAMANAGER.GetDataValue(0, "ohhts_srch_100r", "OutBlock1", "FIDX_MGCO_CODE", i)
			g_usaOprtC(nIdx) = "0"
			'g_usaOprtD(nIdx) = "0"
			
			nIdx = nIdx + 1
		
		next
		
		if #g_usaOprtV > 0 then		
			if CmbOprtUsa.rowcount > 0 then
				CmbOprtUsa.clear = true
			end if
		
			for i = 0 to #g_usaOprtV - 1
				CmbOprtUsa.cbadddatatext = g_usaOprtV(i) .. "`" .. g_usaOprtT(i)
			next
		
			CmbOprtUsa.setCurIndexSilent("0")
			'CmbOprtUsa.currentindex = "0"

		end if
		
	elseif sPageId == "page44" then
		g_chnOprtT = {}
		g_chnOprtV = {}
		g_chnOprtC = {}
		'g_chnOprtD = {}
		
		nIdx = 0
		
		g_chnOprtT(nIdx) = "운용사전체"
		g_chnOprtV(nIdx) = "        "
		g_chnOprtC(nIdx) = "1"
		'g_chnOprtD(nIdx) = "1"
		
		nIdx = nIdx + 1
		
		for i = 0 to nCount - 1
			g_chnOprtT(nIdx) = DATAMANAGER.GetDataValue(0, "ohhts_srch_100r", "OutBlock1", "FIDX_MGCO_NAME", i)
			g_chnOprtV(nIdx) = DATAMANAGER.GetDataValue(0, "ohhts_srch_100r", "OutBlock1", "FIDX_MGCO_CODE", i)
			g_chnOprtC(nIdx) = "0"
			'g_chnOprtD(nIdx) = "0"
		
			nIdx = nIdx + 1
		
		next
		
		if #g_chnOprtV > 0 then
			if CmbOprtChn.rowcount > 0 then
				CmbOprtChn.clear = true
			end if
		
			for i = 0 to #g_chnOprtV - 1
				CmbOprtChn.cbadddatatext = g_chnOprtV(i) .. "`" .. g_chnOprtT(i)
			next
		
			CmbOprtChn.setCurIndexSilent("0")
			'CmbOprtChn.currentindex = "0"

		end if
	
	elseif sPageId == "page55" then
		g_hkOprtT = {}
		g_hkOprtV = {}
		g_hkOprtC = {}
		'g_hkOprtD = {}
		
		nIdx = 0
		
		g_hkOprtT(nIdx) = "운용사전체"
		g_hkOprtV(nIdx) = "        "
		g_hkOprtC(nIdx) = "1"
		'g_hkOprtD(nIdx) = "1"
		
		nIdx = nIdx + 1
		
		for i = 0 to nCount - 1
			g_hkOprtT(nIdx) = DATAMANAGER.GetDataValue(0, "ohhts_srch_100r", "OutBlock1", "FIDX_MGCO_NAME", i)
			g_hkOprtV(nIdx) = DATAMANAGER.GetDataValue(0, "ohhts_srch_100r", "OutBlock1", "FIDX_MGCO_CODE", i)
			g_hkOprtC(nIdx) = "0"
			'g_hkOprtD(nIdx) = "0"
			
			nIdx = nIdx + 1
		
		next
		
		if #g_hkOprtV > 0 then
			if CmbOprtHk.rowcount > 0 then
				CmbOprtHk.clear = true
			end if
		
			for i = 0 to #g_hkOprtV - 1
				CmbOprtHk.cbadddatatext = g_hkOprtV(i) .. "`" .. g_hkOprtT(i)
			next
		
			CmbOprtHk.setCurIndexSilent("0")
			'CmbOprtHk.currentindex = "0"

		end if
	
	elseif sPageId == "page66" then
		g_jpOprtT = {}
		g_jpOprtV = {}
		g_jpOprtC = {}
		'g_jpOprtD = {}
		
		nIdx = 0
		
		g_jpOprtT(nIdx) = "운용사전체"
		g_jpOprtV(nIdx) = "        "
		g_jpOprtC(nIdx) = "1"
		'g_jpOprtD(nIdx) = "1"
		
		nIdx = nIdx + 1
		
		for i = 0 to nCount - 1
			g_jpOprtT(nIdx) = DATAMANAGER.GetDataValue(0, "ohhts_srch_100r", "OutBlock1", "FIDX_MGCO_NAME", i)
			g_jpOprtV(nIdx) = DATAMANAGER.GetDataValue(0, "ohhts_srch_100r", "OutBlock1", "FIDX_MGCO_CODE", i)
			g_jpOprtC(nIdx) = "0"
			'g_jpOprtD(nIdx) = "0"
	
			nIdx = nIdx + 1
		
		next
		
		if #g_jpOprtV > 0 then
			if CmbOprtJp.rowcount > 0 then
				CmbOprtJp.clear = true
			end if
		
			'CmbOprtJp.clear()
			
			for i = 0 to #g_jpOprtV - 1
				CmbOprtJp.cbadddatatext = g_jpOprtV(i) .. "`" .. g_jpOprtT(i)
			next
		
			CmbOprtJp.setCurIndexSilent("0")
			'CmbOprtJp.currentindex = "0"

		end if

	end if
End Sub
