Sub checkBeforeElwFilter(nType)
	if nType == 1 then
		if g_filterP2 == "1" then
			recoverElwFilter(2)
			Exit Sub
		end if
		
		if g_filterP3 == "1" then
			recoverElwFilter(3)
			Exit Sub
		end if
		
		if g_filterP4 == "1" then
			recoverElwFilter(4)
			Exit Sub
		end if
	
	elseif nType == 2 then
		if g_filterP1 == "1" then
			recoverElwFilter(1)
			Exit Sub
		end if
		
		if g_filterP3 == "1" then
			recoverElwFilter(3)
			Exit Sub
		end if
		
		if g_filterP4 == "1" then
			recoverElwFilter(4)
			Exit Sub
		end if
		
	elseif nType == 3 then
		if g_filterP1 == "1" then
			recoverElwFilter(1)
			Exit Sub
		end if
		
		if g_filterP2 == "1" then
			recoverElwFilter(2)
			Exit Sub
		end if
		
		if g_filterP4 == "1" then
			recoverElwFilter(4)
			Exit Sub
		end if
	
	elseif nType == 4 then
		if g_filterP1 == "1" then
			recoverElwFilter(1)
			Exit Sub
		end if
		
		if g_filterP2 == "1" then
			recoverElwFilter(2)
			Exit Sub
		end if		
		
		if g_filterP3 == "1" then
			recoverElwFilter(3)
			Exit Sub
		end if
	
	end if

End Sub

