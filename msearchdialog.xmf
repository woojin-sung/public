Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "ohhts_srch_001r" then		'국내 종목검색 실패
		g_bNextRequest = false
	
	elseif szTranID == "ohhts_srch_101r" then	'해외 종목검색 실패
		g_bNextRequest = false
	
	end if
End Sub
