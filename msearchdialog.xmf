			else
				contFilterEtn.contEtnContent.imgFilter5.imgPath = "btn_line2_o.9"
				contFilterEtn.contEtnContent.Label5.fontbold = "1"
				contFilterEtn.contEtnContent.Label5.fgcolor = "4"
				
			end if
		end if
		
		processLoadItemEtn()
		
		showHideFilterPopup(false)
		g_filterP5 = "0"

	end if

End Sub

Sub processLoadItemEtn()
	Dim sParams, sValue1, sValue2, sValue3, sValue4, sValue5, sValue6, bReqData

	bReqData = false

	if g_etnSortI == -1 then
		sValue1 = "00"
		
	else
		bReqData = true
		
		if g_etnSortI == 0 then		'종목명 순
			sValue1 = "00"
		
		elseif g_etnSortI == 1 then		'거래량 높은순
			sValue1 = "01"
		
		elseif g_etnSortI == 2 then		'상승률 높은순
			sValue1 = "02"
		
		elseif g_etnSortI == 3 then		'하락률 높은순
			sValue1 = "03"
		
		end if
		
	end if
	
	if g_etnMarketI == -1 then
		sValue2 = "*"
	
	else
		if g_etnMarketI == 0 then
			sValue2 = "*"
		
		else
			sValue2 = g_etnMarketV(g_etnMarketI)
			
		end if
	
	end if

	if g_etnUnderI == -1 then
		sValue3 = "*"
	
	else
		if g_etnUnderI == 0 then
			sValue3 = "*"
		
		else
			sValue3 = g_etnUnderV(g_etnUnderI)
			
		end if
	
	end if

	if g_etnPubcI == -1 then
		sValue4 = "*"
	
	else
		if g_etnPubcI == 0 then
			sValue4 = "*"
			
		else
			sValue4 = g_etnPubcT(g_etnPubcI)
			
		end if
	end if

	if g_etnLeverI == -1 then
		sValue5 = "*"
	
	else
		if g_etnLeverI == 0 then
			sValue5 = "*"
		
		else
			sValue5 = g_etnLeverV(g_etnLeverI)

		end if

	end if

	sValue6 = "*"

	sParams = sValue1 & "★" & sValue2 & "★" & sValue3 & "★" & sValue4 & "★" & sValue5 & "★" & sValue6

	'Form.Log("[PSM3EXST] processLoadItemEtn", sParams & "@" & bReqData)

	if bReqData == true then
		g_bReqMode = true
		g_bNextRequest = false
	
		DATAMANAGER.RequestTranData("ohhts_srch_001r")

	else
		g_bReqMode = false
	
		contSearch.setSearchParams(sParams)

	end if

End Sub
