Sub imgAlphaBot_OnClick()

	if fmtabSearch.currenttab == "0" or fmtabSearch.currenttab == 0 then		'국내
		sPageId = fmtabCategory1.currenttabpageid
		
		if sPageId == "page3" then			'ETF
		
			if g_filterS1 == "1" and g_filterP1 == "1" then				'정렬선택
				contFilterEtf_contEtfContent_imgFilter1_OnClick()
				
			elseif g_filterS2 == "1" and g_filterP2 == "1" then			'시장선택
				contFilterEtf_contEtfContent_imgFilter2_OnClick()
			
			elseif g_filterS3 == "1" and g_filterP3 == "1" then			'기초자산
				contFilterEtf_contEtfContent_imgFilter3_OnClick()
			
			elseif g_filterS5 == "1" and g_filterP5 == "1" then			'레버리지
				contFilterEtf_contEtfContent_imgFilter5_OnClick()
			
			else
				showHideFilterPopup(false)

			end if
		
		elseif sPageId == "page4" then		'ETN
			if g_filterS1 == "1" and g_filterP1 == "1" then				'정렬선택
				contFilterEtn_contEtnContent_imgFilter1_OnClick()
			
			elseif g_filterS2 == "1" and g_filterP2 == "1" then			'시장선택
				contFilterEtn_contEtnContent_imgFilter2_OnClick()
			
			elseif g_filterS3 == "1" and g_filterP3 == "1" then			'기초자산
				contFilterEtn_contEtnContent_imgFilter3_OnClick()
			
			elseif g_filterS5 == "1" and g_filterP5 == "1" then			'레버리지
				contFilterEtn_contEtnContent_imgFilter5_OnClick()
			
			else
				showHideFilterPopup(false)

			end if
		
		elseif sPageId == "page5" then		'ELW
			if g_filterS1 == "1" and g_filterP1 == "1" then				'기초자산
				contFilterElw_imgFilter1_OnClick()
			
			elseif g_filterS2 == "1" and g_filterP2 == "1" then			'발행사선택
				contFilterElw_imgFilter2_OnClick()
			
			elseif g_filterS3 == "1" and g_filterP3 == "1" then			'콜/풋
				contFilterElw_imgFilter3_OnClick()
			
			elseif g_filterS4 == "1" and g_filterP4 == "1" then			'만기월선택
				contFilterElw_imgFilter4_OnClick()
			
			else
				showHideFilterPopup(false)

			end if			
		
		end if
	else									'해외
		sPageId = fmtabCategory2.currenttabpageid
		
		if sPageId == "page33" then			'미국
			if g_filterS1 == "1" and g_filterP1 == "1" then			'종목전체
				contFilterUsa_contUsaContent_imgFilter1_OnClick()
				
			elseif g_filterS2 == "1" and g_filterP2 == "1" then		'시장전체
				contFilterUsa_contUsaContent_imgFilter2_OnClick()
			
			elseif g_filterS3 == "1" and g_filterP3 == "1" then		'정렬선택
				contFilterUsa_contUsaContent_imgFilter3_OnClick()
			
			elseif g_filterS5 == "1" and g_filterP5 == "1" then		'추적배수
				contFilterUsa_contUsaContent_imgFilter5_OnClick()
			
			else
				showHideFilterPopup(false)

			end if
		
		elseif sPageId == "page44" then		'중국
			if g_filterS1 == "1" and g_filterP1 == "1" then			'종목전체
				contFilterChn_contChnContent_imgFilter1_OnClick()
				
			elseif g_filterS2 == "1" and g_filterP2 == "1" then		'시장전체
				contFilterChn_contChnContent_imgFilter2_OnClick()
			
			elseif g_filterS3 == "1" and g_filterP3 == "1" then		'정렬선택
				contFilterChn_contChnContent_imgFilter3_OnClick()
			
			elseif g_filterS5 == "1" and g_filterP5 == "1" then		'추적배수
				contFilterChn_contChnContent_imgFilter5_OnClick()
			
			else
				showHideFilterPopup(false)

			end if	
		
		elseif sPageId == "page55" then		'홍콩
			if g_filterS1 == "1" and g_filterP1 == "1" then			'종목전체
				contFilterHk_contHkContent_imgFilter1_OnClick()
				
			elseif g_filterS2 == "1" and g_filterP2 == "1" then		'정렬선택
				contFilterHk_contHkContent_imgFilter2_OnClick()
			
			elseif g_filterS4 == "1" and g_filterP4 == "1" then		'추적배수
				contFilterHk_contHkContent_imgFilter4_OnClick()			
			
			else
				showHideFilterPopup(false)

			end if
		
		elseif sPageId == "page66" then		'일본
			if g_filterS1 == "1" and g_filterP1 == "1" then			'종목전체
				contFilterJp_contJpContent_imgFilter1_OnClick()
				
			elseif g_filterS2 == "1" and g_filterP2 == "1" then		'정렬선택
				contFilterHk_contHkContent_imgFilter2_OnClick()
			
			elseif g_filterS4 == "1" and g_filterP4 == "1" then		'추적배수
				contFilterHk_contHkContent_imgFilter4_OnClick()			
			
			else
				showHideFilterPopup(false)

			end if			
		
		end if
		
	end if

End Sub

