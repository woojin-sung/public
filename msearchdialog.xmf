Sub initItemSearch()
	fmtabCategory1.insertPage( 0, "page1", "page1", "empty", "0", "최근" )
	fmtabCategory1.insertPage( 1, "page2", "page2", "empty", "0", "전체" )
	fmtabCategory1.insertPage( 2, "page3", "page3", "empty", "0", "ETF" )
	fmtabCategory1.insertPage( 3, "page4", "page4", "empty", "0", "ETN" )
	fmtabCategory1.insertPage( 4, "page5", "page5", "empty", "0", "ELW" )
	fmtabCategory1.insertPage( 5, "page6", "page6", "empty", "0", "신주인수권" )
	fmtabCategory1.insertPage( 6, "page7", "page7", "empty", "0", "코넥스" )
	fmtabCategory1.insertPage( 7, "page8", "page8", "empty", "0", "K-OTC" )
