'============================================================================
' 종목검색창 입력 완료 시
'============================================================================
Sub contHeader_EditSearch_OnEditComplete()
	'Form.Log("[PSM3EXST] contHeader_EditSearch_OnEditComplete", g_bReqMode)

	contHeader.ImageSearchBG.imgpath = "bg_infobox.9"
	contHeader.EditSearch.hintcolor = "321"
	contHeader.EditSearch.hintdcolor = "321"
	'contHeader.ImageSearchBG.imgpath = "btn_line2_n.9"
	
	if g_bReqMode = true then	
		sCurSearchText = contHeader.EditSearch.caption
		if sCurSearchText <> gSearchText then
			Form.SetTimerEvent2(1, 0, 0.5)
	
		end if
	
		'Form.SetTimerEvent2(2, 1, 0.2)
	
	end if
	
End Sub

'============================================================================
' 종목검색창 입력 중
' (입력 시 타이머 이벤트 발생, 중간에 입력 다시 들어오면 기존 타이머 취소 후 새로걸어줌)
'============================================================================
Sub contHeader_EditSearch_OnEditChar(CharCode)
	'Form.Log("[PSM3EXST] contHeader_EditSearch_OnEditChar", CharCode & "@" & g_bReqMode)
	Dim sEditSearch

	sEditSearch = contHeader.EditSearch.caption
	
	if g_bReqMode = true then
		Form.SetTimerEvent2(1, 0, 0.5)
		Form.SetTimerEvent2(1, 1, 0.5)
		
		contSearch.setSearchKeyword( sEditSearch, "", true )

	else
		Dim sCurPageId

		contSearch.setSearchKeyword( sEditSearch, "", false )
		
		if sEditSearch == "" then
			if fmtabSearch.currenttab == "0" or fmtabSearch.currenttab == 0 then		'국내
				sCurPageId = fmtabCategory1.currenttabpageid
				
				if sCurPageId == "page1" then	'최근
					Table0.visible = false
					
				else
					Table0.visible = true
				
				end if
				
			else																'해외
				sCurPageId = fmtabCategory2.currenttabpageid
				
				if sCurPageId == "page11" then	'최근
					Table0.visible = false
					
				else
					Table0.visible = true
				
				end if
			
			end if
			
		else
			Table0.visible = false
		
		end if

	end if
	
End Sub

'============================================================================
' 종목검색
' 서비스 호출 시점에 이전 검색어와 동일검색어가 입력되어있을 시, 서비스 호출하지 않음.
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if sTimerID == 1 or sTimerID == "1" then			'검색서비스 호출
		Form.SetTimerEvent2(1, 0, 0.5)
		
		sCurSearchText = contHeader.EditSearch.caption
		'Form.Log("[PSM3EXST] Form_OnTimerEvent", sCurSearchText & "@" & gSearchText)
		
		if sCurSearchText <> gSearchText then
			gSearchText = sCurSearchText
			
			processLoadItems()
		end if

'	elseif sTimerID == 2 or sTimerID == "2" then		'결과 개수에 따른 컨테이너 높이/위치 조정
'		Form.SetTimerEvent2(2, 0, 0.2)

	end if
	
End Sub

Sub processLoadItems()
	if fmtabSearch.currenttab == "0" or fmtabSearch.currenttab == 0 then		'국내
		sPageId = fmtabCategory1.currenttabpageid
		
		if sPageId == "page3" then			'ETF
			processLoadItemEtf()
			
		elseif sPageId == "page4" then
			processLoadItemEtn()
		
		end if
		
	else									'해외
		sPageId = fmtabCategory2.currenttabpageid

		if sPageId == "page33" then
			processLoadItemUsa()
		
		elseif sPageId == "page44" then
			processLoadItemChn()
			
		elseif sPageId == "page55" then
			processLoadItemHk()
		
		elseif sPageId == "page66" then
			processLoadItemJp()

		end if
	end if

End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	'---------------------------------------------------------------
	' requestIntr 함수 호출 후 조회 완료 시 발생
	'---------------------------------------------------------------
	if sEventName == "REFRESH_INTR_ITEM" then
		if gOsType == "1" then
			contSearch.refreshIntrItem()
	
		end if
	
	'----------------------------------------------------
	'음성검색 리턴값 수신
	'----------------------------------------------------
	elseif sEventName == "VOICEINPUT" then
		sVoiceText = sParam
		
		if sVoiceText <> "" then
			contHeader.EditSearch.caption = sVoiceText
			contSearch.setSearchKeyword( contHeader.EditSearch.caption, "", false )

		end if
	
	elseif sEventName == "FILTER_ETF_SORT" then
		processSelectFilterEtf(sEventName, sParam)
		
	elseif sEventName == "FILTER_ETF_MARKET" then
		processSelectFilterEtf(sEventName, sParam)
		
	elseif sEventName == "FILTER_ETF_UNDER" then
		processSelectFilterEtf(sEventName, sParam)

	elseif sEventName == "FILTER_ETF_LEVER" then
		processSelectFilterEtf(sEventName, sParam)

	elseif sEventName == "FILTER_ETN_SORT" then
		processSelectFilterEtn(sEventName, sParam)
		
	elseif sEventName == "FILTER_ETN_MARKET" then
		processSelectFilterEtn(sEventName, sParam)
		
	elseif sEventName == "FILTER_ETN_UNDER" then
		processSelectFilterEtn(sEventName, sParam)
		
	elseif sEventName == "FILTER_ETN_LEVER" then
		processSelectFilterEtn(sEventName, sParam)
		
	elseif sEventName == "FILTER_ELW_UNDER" then
		processSelectFilterElw(sEventName, sParam)
	
	elseif sEventName == "FILTER_ELW_PUBC" then
		processSelectFilterElw(sEventName, sParam)
	
	elseif sEventName == "FILTER_ELW_CALLPUT" then
		processSelectFilterElw(sEventName, sParam)
	
	elseif sEventName == "FILTER_ELW_EXPR" then
		processSelectFilterElw(sEventName, sParam)
	
	elseif sEventName == "FILTER_USA_PRODUCT" then
		processSelectFilterUsa(sEventName, sParam)

	elseif sEventName == "FILTER_USA_MARKET" then
		processSelectFilterUsa(sEventName, sParam)

	elseif sEventName == "FILTER_USA_SORT" then
		processSelectFilterUsa(sEventName, sParam)
		
	elseif sEventName == "FILTER_USA_LEVER" then
		processSelectFilterUsa(sEventName, sParam)

	elseif sEventName == "FILTER_CHN_PRODUCT" then
		processSelectFilterChn(sEventName, sParam)

	elseif sEventName == "FILTER_CHN_MARKET" then
		processSelectFilterChn(sEventName, sParam)

	elseif sEventName == "FILTER_CHN_SORT" then
		processSelectFilterChn(sEventName, sParam)
		
	elseif sEventName == "FILTER_CHN_LEVER" then
		processSelectFilterChn(sEventName, sParam)

	elseif sEventName == "FILTER_HK_PRODUCT" then
		processSelectFilterHk(sEventName, sParam)

	elseif sEventName == "FILTER_HK_SORT" then
		processSelectFilterHk(sEventName, sParam)
		
	elseif sEventName == "FILTER_HK_LEVER" then
		processSelectFilterHk(sEventName, sParam)
		
	elseif sEventName == "FILTER_JP_PRODUCT" then
		processSelectFilterJp(sEventName, sParam)

	elseif sEventName == "FILTER_JP_SORT" then
		processSelectFilterJp(sEventName, sParam)
		
	elseif sEventName == "FILTER_JP_LEVER" then
		processSelectFilterJp(sEventName, sParam)

	end if
	
End Sub

'============================================================================
Sub processSelectFilterEtf(sEventName, sParam)
	sRetData = Form.GetSharedData(sEventName, true)

	if sEventName == "FILTER_ETF_SORT" then
		
		g_etfSortC = {}
		g_etfSortC = Convert_StringToArr(sRetData, "`")
		g_etfSortI = CInt(sParam)
		
		if #g_etfSortC > 0 then
			if g_etfSortC(0) == "1" then
				contFilterEtf.contEtfContent.imgFilter1.imgPath = "btn_line2_n.9"
				contFilterEtf.contEtfContent.Label1.fontbold = "0"
				contFilterEtf.contEtfContent.Label1.fgcolor = "321"
				
				g_filterS1 = "0"
				
			else			
				contFilterEtf.contEtfContent.imgFilter1.imgPath = "btn_line2_o.9"
				contFilterEtf.contEtfContent.Label1.fontbold = "1"
				contFilterEtf.contEtfContent.Label1.fgcolor = "4"

			end if
			
		end if
		
		Table0.visible = false
		
		processLoadItemEtf()		'소팅 정보를 선택하면 조회 모드로 변경 (메인 -> 조회)
		
		showHideFilterPopup(false)
		g_filterP1 = "0"
		
	elseif sEventName == "FILTER_ETF_MARKET" then
		
		g_etfMarketC = {}
		g_etfMarketC = Convert_StringToArr(sRetData, "`")
		g_etfMarketI = CInt(sParam)
		
		if #g_etfMarketC > 0 then
			if g_etfMarketC(0) == "1" then
				contFilterEtf.contEtfContent.imgFilter2.imgPath = "btn_line2_n.9"
				contFilterEtf.contEtfContent.Label2.fontbold = "0"
				contFilterEtf.contEtfContent.Label2.fgcolor = "321"
				g_filterS2 = "0"
				
			else
				contFilterEtf.contEtfContent.imgFilter2.imgPath = "btn_line2_o.9"
				contFilterEtf.contEtfContent.Label2.fontbold = "1"
				contFilterEtf.contEtfContent.Label2.fgcolor = "4"
				
			end if
		end if
		
		processLoadItemEtf()
		
		showHideFilterPopup(false)
		g_filterP2 = "0"
		
	elseif sEventName == "FILTER_ETF_UNDER" then
		
		g_etfUnderC = {}
		g_etfUnderC = Convert_StringToArr(sRetData, "`")
		g_etfUnderI = CInt(sParam)
		
		if #g_etfUnderC > 0 then
			if g_etfUnderC(0) == "1" then
				contFilterEtf.contEtfContent.imgFilter3.imgPath = "btn_line2_n.9"
				contFilterEtf.contEtfContent.Label3.fontbold = "0"
				contFilterEtf.contEtfContent.Label3.fgcolor = "321"
				
				g_filterS3 = "0"

			else
				contFilterEtf.contEtfContent.imgFilter3.imgPath = "btn_line2_o.9"
				contFilterEtf.contEtfContent.Label3.fontbold = "1"
				contFilterEtf.contEtfContent.Label3.fgcolor = "4"
				
			end if
		end if
		
		processLoadItemEtf()

		showHideFilterPopup(false)
		g_filterP3 = "0"

	elseif sEventName == "FILTER_ETF_LEVER" then
		
		g_etfLeverC = {}
		g_etfLeverC = Convert_StringToArr(sRetData, "`")
		g_etfLeverI = CInt(sParam)
		
		if #g_etfLeverC > 0 then
			if g_etfLeverC(0) == "1" then
				contFilterEtf.contEtfContent.imgFilter5.imgPath = "btn_line2_n.9"
				contFilterEtf.contEtfContent.Label5.fontbold = "0"
				contFilterEtf.contEtfContent.Label5.fgcolor = "321"
				
				g_filterS5 = "0"
				
			else
				contFilterEtf.contEtfContent.imgFilter5.imgPath = "btn_line2_o.9"
				contFilterEtf.contEtfContent.Label5.fontbold = "1"
				contFilterEtf.contEtfContent.Label5.fgcolor = "4"
				
			end if
		end if
		
		processLoadItemEtf()
		
		showHideFilterPopup(false)
		g_filterP5 = "0"

	end if
End Sub

Sub processLoadItemEtf()
	Dim sParams, sValue1, sValue2, sValue3, sValue4, sValue5, sValue6, bReqData

	bReqData = false

	if g_etfSortI == -1 then
		sValue1 = "00"				'종목명 순
		
	else
		bReqData = true
		
		if g_etfSortI == 0 then		'종목명 순
			sValue1 = "00"
		
		elseif g_etfSortI == 1 then		'거래량 높은순
			sValue1 = "01"
		
		elseif g_etfSortI == 2 then		'상승률 높은순
			sValue1 = "02"
		
		elseif g_etfSortI == 3 then		'하락률 높은순
			sValue1 = "03"
		
		end if
		
	end if
	
	if g_etfMarketI == -1 then
		sValue2 = "*"
	
	else
		if g_etfMarketI == 0 then
			sValue2 = "*"
		
		else
			sValue2 = g_etfMarketV(g_etfMarketI)
			
		end if
	
	end if

	if g_etfUnderI == -1 then
		sValue3 = "*"
	
	else
		if g_etfUnderI == 0 then
			sValue3 = "*"
		
		else
			sValue3 = g_etfUnderV(g_etfUnderI)

		end if
	
	end if

	if g_etfOprtI == -1 then
		sValue4 = "*"
	
	else
		if g_etfOprtI == 0 then
			sValue4 = "*"
		
		else
			sValue4 = g_etfOprtT(g_etfOprtI)
			
		end if

	end if

	if g_etfLeverI == -1 then
		sValue5 = "*"
	
	else
		if g_etfLeverI == 0 then
			sValue5 = "*"
		
		else
			sValue5 = g_etfLeverV(g_etfLeverI)
			
		end if

	end if

	sValue6 = "*"

	sParams = sValue1 & "★" & sValue2 & "★" & sValue3 & "★" & sValue4 & "★" & sValue5 & "★" & sValue6

	'Form.Log("[PSM3EXST] processLoadItemEtf", sParams & "@" & bReqData)

	if bReqData == true then
		g_bReqMode = true
		g_bNextRequest = false

		DATAMANAGER.RequestTranData("ohhts_srch_001r")

	else
		g_bReqMode = false
		'Form.Log("processLoadItemEtf", sParams)
		contSearch.setSearchParams(sParams)		'스크립트 함수 추가 필요(3) -> 카테고리 파라미터 정보 넘김

	end if

End Sub
