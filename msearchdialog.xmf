Sub checkBeforeEtfFilter(nType)
	if nType == 1 then
		if g_filterP2 == "1" then
			recoverEtfFilter(2)			
			Exit Sub
		end if
		
		if g_filterP3 == "1" then
			recoverEtfFilter(3)
			Exit Sub
		end if
		
'		if g_filterP4 == "1" then
'			recoverEtfFilter(4)
'			Exit Sub
'		end if
		
		if g_filterP5 == "1" then
			recoverEtfFilter(5)
			Exit Sub
		end if
	
	elseif nType == 2 then
		if g_filterP1 == "1" then
			recoverEtfFilter(1)
			Exit Sub
		end if
		
		if g_filterP3 == "1" then
			recoverEtfFilter(3)
			Exit Sub
		end if
		
'		if g_filterP4 == "1" then
'			recoverEtfFilter(4)
'			Exit Sub
'		end if
		
		if g_filterP5 == "1" then
			recoverEtfFilter(5)
			Exit Sub
		end if
		
	elseif nType == 3 then
		if g_filterP1 == "1" then
			recoverEtfFilter(1)
			Exit Sub
		end if
		
		if g_filterP2 == "1" then
			recoverEtfFilter(2)
			Exit Sub
		end if
		
'		if g_filterP4 == "1" then
'			recoverEtfFilter(4)
'			Exit Sub
'		end if
		
		if g_filterP5 == "1" then
			recoverEtfFilter(5)
			Exit Sub
		end if		
	
	elseif nType == 4 then
		if g_filterP1 == "1" then
			recoverEtfFilter(1)
			Exit Sub
		end if
		
		if g_filterP2 == "1" then
			recoverEtfFilter(2)
			Exit Sub
		end if		
		
		if g_filterP3 == "1" then
			recoverEtfFilter(3)
			Exit Sub
		end if
		
		if g_filterP5 == "1" then
			recoverEtfFilter(5)
			Exit Sub
		end if
		
	elseif nType == 5 then
		if g_filterP1 == "1" then
			recoverEtfFilter(1)
			Exit Sub
		end if
		
		if g_filterP2 == "1" then
			recoverEtfFilter(2)
			Exit Sub
		end if		
		
		if g_filterP3 == "1" then
			recoverEtfFilter(3)
			Exit Sub
		end if
		
'		if g_filterP4 == "1" then
'			recoverEtfFilter(4)
'			Exit Sub
'		end if
	
	end if

End Sub

Sub recoverEtfFilter(nType)
	if nType == 1 then
		if g_filterS1 == "1" and g_etfSortC[0] == "1" then
			contFilterEtf.contEtfContent.imgFilter1.imgPath = "btn_line2_n.9"
			contFilterEtf.contEtfContent.Label1.fontbold = "0"
			contFilterEtf.contEtfContent.Label1.fgcolor = "321"
			
			g_filterS1 = "0"
			
		else
			contFilterEtf.contEtfContent.imgFilter1.imgPath = "btn_line2_o.9"
			contFilterEtf.contEtfContent.Label1.fontbold = "1"
			contFilterEtf.contEtfContent.Label1.fgcolor = "4"
			
		end if
		
		g_filterP1 = "0"
	
	elseif nType == 2 then
		if g_filterS2 == "1" and g_etfMarketC[0] == "1" then
			contFilterEtf.contEtfContent.imgFilter2.imgPath = "btn_line2_n.9"
			contFilterEtf.contEtfContent.Label2.fontbold = "0"
			contFilterEtf.contEtfContent.Label2.fgcolor = "321"
			
			g_filterS2 = "0"
			
		else
			contFilterEtf.contEtfContent.imgFilter2.imgPath = "btn_line2_o.9"
			contFilterEtf.contEtfContent.Label2.fontbold = "1"
			contFilterEtf.contEtfContent.Label2.fgcolor = "4"
			
		end if
		
		g_filterP2 = "0"
		
	elseif nType == 3 then
		if g_filterS3 == "1" and g_etfUnderC[0] == "1" then
			contFilterEtf.contEtfContent.imgFilter3.imgPath = "btn_line2_n.9"
			contFilterEtf.contEtfContent.Label3.fontbold = "0"
			contFilterEtf.contEtfContent.Label3.fgcolor = "321"
			
			g_filterS3 = "0"
			
		else
			contFilterEtf.contEtfContent.imgFilter3.imgPath = "btn_line2_o.9"
			contFilterEtf.contEtfContent.Label3.fontbold = "1"
			contFilterEtf.contEtfContent.Label3.fgcolor = "4"
			
		end if
		
		g_filterP3 = "0"

	elseif nType == 4 then
		if g_filterS4 == "1" and g_etfOprtC[0] == "1" then
			contFilterEtf.contEtfContent.imgFilter4.imgPath = "btn_line2_n.9"
			contFilterEtf.contEtfContent.Label4.fontbold = "0"
			contFilterEtf.contEtfContent.Label4.fgcolor = "321"
			
			g_filterS4 = "0"
			
		else
			contFilterEtf.contEtfContent.imgFilter4.imgPath = "btn_line2_o.9"
			contFilterEtf.contEtfContent.Label4.fontbold = "1"
			contFilterEtf.contEtfContent.Label4.fgcolor = "4"
			
		end if
		
		g_filterP4 = "0"
	
	elseif nType == 5 then
		if g_filterS5 == "1" and g_etfLeverC[0] == "1" then
			contFilterEtf.contEtfContent.imgFilter5.imgPath = "btn_line2_n.9"
			contFilterEtf.contEtfContent.Label5.fontbold = "0"
			contFilterEtf.contEtfContent.Label5.fgcolor = "321"
			
			g_filterS5 = "0"
			
		else
			contFilterEtf.contEtfContent.imgFilter5.imgPath = "btn_line2_o.9"
			contFilterEtf.contEtfContent.Label5.fontbold = "1"
			contFilterEtf.contEtfContent.Label5.fgcolor = "4"
			
		end if
		
		g_filterP5 = "0"
		
	End if

End Sub

