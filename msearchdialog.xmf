Sub processLoadItemElw()
	Dim sParams, sValue1, sValue2, sValue3, sValue4, sValue5, sValue6

	if g_elwUnderI == -1 then
		sValue1 = "*"
		
	else
		if g_elwUnderI == 0 then
			sValue1 = "*"
		
		else
			sValue1 = g_elwUnderV(g_elwUnderI)
			
		end if
		
	end if
	
	if g_elwPubcI == -1 then
		sValue2 = "*"
	
	else
		if g_elwPubcI == 0 then
			sValue2 = "*"
		
		else
			sValue2 = g_elwPubcV(g_elwPubcI)
	
		end if
	end if

	if g_elwCallPutI == -1 then
		sValue3 = "*"
	
	else
		if g_elwCallPutI == 0 then
			sValue3 = "*"
		
		elseif g_elwCallPutI == 1 then
			sValue3 = "C"
		
		elseif g_elwCallPutI == 2 then
			sValue3 = "P"
		
		end if
	
	end if

	if g_elwExprI == -1 then
		sValue4 = "*"
	
	else
		if g_elwExprI == 0 then
			sValue4 = "*"
	
		else
			sValue4 = g_elwExprV(g_elwExprI)
			
		end if
	
	end if

	sValue5 = "*"
	sValue6 = "*"

	sParams = sValue1 & "★" & sValue2 & "★" & sValue3 & "★" & sValue4 & "★" & sValue5 & "★" & sValue6

	contSearch.setSearchParams(sParams)

End Sub
'============================================================================
Sub processSelectFilterUsa(sEventName, sParam)
	sRetData = Form.GetSharedData(sEventName, true)

	if sEventName == "FILTER_USA_PRODUCT" then

		g_usaProductC = {}
		g_usaProductC = Convert_StringToArr(sRetData, "`")
		
		oldUsaProductI = g_usaProductI
		
		g_usaProductI = CInt(sParam)
	
		if #g_usaProductC > 0 then
			if g_usaProductC(0) == "1" then
				contFilterUsa.contUsaContent.imgFilter1.imgPath = "btn_line2_n.9"
				contFilterUsa.contUsaContent.Label1.fontbold = "0"
				contFilterUsa.contUsaContent.Label1.fgcolor = "321"
				
				g_filterS1 = "0"
				
			else
				contFilterUsa.contUsaContent.imgFilter1.imgPath = "btn_line2_o.9"
				contFilterUsa.contUsaContent.Label1.fontbold = "1"
				contFilterUsa.contUsaContent.Label1.fgcolor = "4"
				
			end if
		end if

		processLoadItemUsa()
		
		showHideFilterPopup(false)
		g_filterP1 = "0"
		
		contFilterUsa.contUsaContent.scroll_pos = "left"
		
		if oldUsaProductI == 2 and (g_usaProductI == 0 or g_usaProductI == 1) then
			initOvrsEtfFilterUsa()
		end if
		
	elseif sEventName == "FILTER_USA_MARKET" then

		g_usaMarketC = {}
		g_usaMarketC = Convert_StringToArr(sRetData, "`")
		g_usaMarketI = CInt(sParam)

		if #g_usaMarketC > 0 then
			if g_usaMarketC(0) == "1" then
				contFilterUsa.contUsaContent.imgFilter2.imgPath = "btn_line2_n.9"
				contFilterUsa.contUsaContent.Label2.fontbold = "0"
				contFilterUsa.contUsaContent.Label2.fgcolor = "321"
				
