Sub checkBeforeJpFilter(nType)
	if nType == 1 then
'		if g_filterP2 == "1" then
'			recoverJpFilter(2)			
'			Exit Sub
'		end if
		
		if g_filterP3 == "1" then
			recoverJpFilter(3)
			Exit Sub
		end if
		
		if g_filterP4 == "1" then
			recoverJpFilter(4)
			Exit Sub
		end if
	
	elseif nType == 2 then
