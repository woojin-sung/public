'			recoverJpFilter(1)
'			Exit Sub
'		end if
		
		if g_filterP3 == "1" then
			recoverJpFilter(3)
			Exit Sub
		end if
		
		if g_filterP4 == "1" then
			recoverJpFilter(4)
			Exit Sub
		end if
		
	elseif nType == 3 then
'		if g_filterP1 == "1" then
'			recoverJpFilter(1)
'			Exit Sub
'		end if
'		
'		if g_filterP2 == "1" then
'			recoverJpFilter(2)
'			Exit Sub
'		end if
		
		if g_filterP4 == "1" then
			recoverJpFilter(4)
			Exit Sub
		end if
	
	elseif nType == 4 then
'		if g_filterP1 == "1" then
'			recoverJpFilter(1)
'			Exit Sub
'		end if
'		
'		if g_filterP2 == "1" then
'			recoverJpFilter(2)
'			Exit Sub
'		end if
		
		if g_filterP3 == "1" then
			recoverJpFilter(3)
			Exit Sub
		end if
	
	elseif nType == 5 then
'		if g_filterP1 == "1" then
'			recoverJpFilter(1)
'			Exit Sub
'		end if
'		
'		if g_filterP2 == "1" then
'			recoverJpFilter(2)
'			Exit Sub
'		end if
		
		if g_filterP3 == "1" then
			recoverJpFilter(3)
			Exit Sub
		end if

		if g_filterP4 == "1" then
			recoverJpFilter(4)
			Exit Sub
		end if

	end if

End Sub

Sub recoverJpFilter(nType)
	if nType == 1 then
		if g_filterS1 == "1" and g_jpProductC[0] == "1" then
			contFilterJp.contJpContent.imgFilter1.imgPath = "btn_line2_n.9"
			contFilterJp.contJpContent.Label1.fontbold = "0"
			contFilterJp.contJpContent.Label1.fgcolor = "321"
			
			g_filterS1 = "0"
			
		else
			contFilterJp.contJpContent.imgFilter1.imgPath = "btn_line2_o.9"
			contFilterJp.contJpContent.Label1.fontbold = "1"
			contFilterJp.contJpContent.Label1.fgcolor = "4"
			
		end if
		
		g_filterP1 = "0"
		
	elseif nType == 2 then
		if g_filterS2 == "1" and g_jpSortC[0] == "1" then
			contFilterJp.contJpContent.imgFilter2.imgPath = "btn_line2_n.9"
			contFilterJp.contJpContent.Label2.fontbold = "0"
			contFilterJp.contJpContent.Label2.fgcolor = "321"
			
			g_filterS2 = "0"
			
		else
			contFilterJp.contJpContent.imgFilter2.imgPath = "btn_line2_o.9"
			contFilterJp.contJpContent.Label2.fontbold = "1"
			contFilterJp.contJpContent.Label2.fgcolor = "4"
			
		end if
		
		g_filterP2 = "0"

	elseif nType == 3 then
		if g_filterS3 == "1" and g_jpOprtC[0] == "1" then
			contFilterJp.contJpContent.imgFilter3.imgPath = "btn_line2_n.9"
			contFilterJp.contJpContent.Label3.fontbold = "0"
			contFilterJp.contJpContent.Label3.fgcolor = "321"
			
			g_filterS3 = "0"
			
		else
			contFilterJp.contJpContent.imgFilter3.imgPath = "btn_line2_o.9"
			contFilterJp.contJpContent.Label3.fontbold = "1"
			contFilterJp.contJpContent.Label3.fgcolor = "4"
			
		end if
		
		g_filterP3 = "0"
	
	elseif nType == 4 then
		if g_filterS4 == "1" and g_jpLeverC[0] == "1" then
			contFilterJp.contJpContent.imgFilter4.imgPath = "btn_line2_n.9"
			contFilterJp.contJpContent.Label4.fontbold = "0"
			contFilterJp.contJpContent.Label4.fgcolor = "321"
			
			g_filterS4 = "0"
			
		else
			contFilterJp.contJpContent.imgFilter4.imgPath = "btn_line2_o.9"
			contFilterJp.contJpContent.Label4.fontbold = "1"
			contFilterJp.contJpContent.Label4.fgcolor = "4"
			
		end if
		
		g_filterP4 = "0"
		
	End if

End Sub
'============================================================================
Sub setFilterHeight(nRow)
	if nRow <> 0 then
		Dim nDivide, nExtraMargin
	
		nDivide = 4 / nRow
				
		if nRow == 2 then
			nExtraMargin = 3
		
		else
			nExtraMargin = 0
			
		end if
				
		LinkForm0.height = (170 / nDivide) + nExtraMargin

	end if
End Sub
'============================================================================
Sub Table0_OnMove(lRow, lColumn)
	procesSearchSubKeyword(lRow)
	'Form.Log("[PSM3EXST] Table0_OnMove", lRow & "@" & lColumn)
End Sub

'============================================================================
Sub Table0_OnClick(lRow, lColumn)
	procesSearchSubKeyword(lRow)
	'Form.Log("[PSM3EXST] Table0_OnClick", lRow & "@" & lColumn)
End Sub

Sub procesSearchSubKeyword(lRow)
	Dim sSideBarText

	if lRow == 0 then		'0~9
		sSideBarText = "1"
		
	elseif lRow == 1 then	'A~Z
		sSideBarText = "A"
	
	elseif lRow == 2 then	'ㄱ
		sSideBarText = "ㄱ"
		
	elseif lRow == 3 then	'ㄴ
		sSideBarText = "ㄴ"

	elseif lRow == 4 then	'ㄷ
		sSideBarText = "ㄷ"

	elseif lRow == 5 then	'ㄹ
		sSideBarText = "ㄹ"

	elseif lRow == 6 then	'ㅁ
		sSideBarText = "ㅁ"

	elseif lRow == 7 then	'ㅂ
		sSideBarText = "ㅂ"

	elseif lRow == 8 then	'ㅅ
		sSideBarText = "ㅅ"
	
	elseif lRow == 9 then	'ㅇ
		sSideBarText = "ㅇ"
	
	elseif lRow == 10 then 'ㅈ
		sSideBarText = "ㅈ"
	
	elseif lRow == 11 then	'ㅊ
		sSideBarText = "ㅊ"
	
	elseif lRow == 12 then	'ㅋ
		sSideBarText = "ㅋ"
	
	elseif lRow == 13 then	'ㅌ
		sSideBarText = "ㅌ"
	
	elseif lRow == 14 then	'ㅍ
		sSideBarText = "ㅍ"
	
	elseif lRow == 15 then	'ㅎ
		sSideBarText = "ㅎ"

	end if

	if sSideBarText <> null and sSideBarText <> "" then
		contSearch.setSearchKeyword( contHeader.EditSearch.caption, sSideBarText, false )
	end if
	
End Sub
