		if #g_jpSortC > 0 then
			if g_jpSortC(0) == "1" then
				contFilterJp.contJpContent.imgFilter2.imgPath = "btn_line2_n.9"
				contFilterJp.contJpContent.Label2.fontbold = "0"
				contFilterJp.contJpContent.Label2.fgcolor = "321"
				
				g_filterS2 = "0"
				
			else
				contFilterJp.contJpContent.imgFilter2.imgPath = "btn_line2_o.9"
				contFilterJp.contJpContent.Label2.fontbold = "1"
				contFilterJp.contJpContent.Label2.fgcolor = "4"
				
			end if
		end if

		processLoadItemJp()

		showHideFilterPopup(false)
		g_filterP2 = "0"

	elseif sEventName == "FILTER_JP_LEVER" then
	
		g_jpLeverC = {}
		g_jpLeverC = Convert_StringToArr(sRetData, "`")
		g_jpLeverI = CInt(sParam)
	
		if #g_jpLeverC > 0 then
			if g_jpLeverC(0) == "1" then
				contFilterJp.contJpContent.imgFilter4.imgPath = "btn_line2_n.9"
				contFilterJp.contJpContent.Label4.fontbold = "0"
				contFilterJp.contJpContent.Label4.fgcolor = "321"
				
				g_filterS4 = "0"
				
			else
				contFilterJp.contJpContent.imgFilter4.imgPath = "btn_line2_o.9"
				contFilterJp.contJpContent.Label4.fontbold = "1"
				contFilterJp.contJpContent.Label4.fgcolor = "4"
				
			end if
		end if

		processLoadItemJp()

		showHideFilterPopup(false)
		g_filterP4 = "0"

	end if
End Sub

Sub processLoadItemJp()
	Dim sParams, sValue1, sValue2, sValue3, sValue4, sValue5, sValue6, bReqData

	bReqData = false

	if contFilterJp.ChkEtf.checkstate == "1" then
		bReqData = true
		processFilterMoveJp(true)

	else
		processFilterMoveJp(false)

	end if

'	if g_jpProductI == -1 then
'		sValue1 = "*"
'		
'		processFilterMoveJp(false)
'		
'	else
'		if g_jpProductI == 0 then		'종목전체
'			sValue1 = "*"
'			
'			processFilterMoveJp(false)
'		
'		elseif g_jpProductI == 1 then	'주식
'			sValue1 = "0"
'			
'			processFilterMoveJp(false)
'		
'		elseif g_jpProductI == 2 then	'ETF
'			sValue1 = "1"
'			
'			bReqData = true
'
'			processFilterMoveJp(true)
'
'		end if
'		
'	end if

	sValue1 = "*"
	sValue2 = "*"
	sValue3 = "*"
	sValue4 = "*"
	sValue5 = "*"
	sValue6 = "*"

	sParams = sValue1 & "★" & sValue2 & "★" & sValue3 & "★" & sValue4 & "★" & sValue5 & "★" & sValue6

	if bReqData == true then
		g_bReqMode = true
		g_bNextRequest = false
	
		DATAMANAGER.RequestTranData("ohhts_srch_101r")
		
	else
		g_bReqMode = false
		contSearch.setSearchParams(sParams)

	end if

End Sub

Sub processFilterMoveJp(bExtend)
	if bExtend == true then
		contFilterJp.contJpContent.width = 325
		contFilterJp.contJpContent.hscroll = "1"
		contFilterJp.contJpContent.setScrollBarVisible("0")
		contFilterJp.contJpContent.setScrollAutoSize()
		
		'contFilterJp.imgInit.left = contFilterJp.width - 30
		
		Table0.visible = false
	
	else
		contFilterJp.contJpContent.width = 0
		contFilterJp.contJpContent.hscroll = "0"
		contFilterJp.contJpContent.setScrollBarVisible("0")
		contFilterJp.contJpContent.setScrollAutoSize()
		
		'contFilterJp.imgInit.left = 90
		
		sEditSearch = contHeader.EditSearch.caption
		displaySidebar(sEditSearch)
	
	end if
End Sub

Sub initOvrsEtfFilterJp()
	'contFilterJp.contJpContent.imgFilter2.imgPath = "btn_line2_n.9"
	contFilterJp.contJpContent.imgFilter3.imgPath = "btn_line2_n.9"
	contFilterJp.contJpContent.imgFilter4.imgPath = "btn_line2_n.9"

	'contFilterJp.contJpContent.Label2.fontbold = "0"
	contFilterJp.contJpContent.Label3.fontbold = "0"
	contFilterJp.contJpContent.Label4.fontbold = "0"
	
	contFilterJp.contJpContent.Label3.fgcolor = "321"
	contFilterJp.contJpContent.Label4.fgcolor = "321"

	g_jpSortC = {}
	g_jpOprtC = {}
	g_jpLeverC = {}
	
	g_jpSortC = { "1", "0", "0", "0" }
	g_jpLeverC = { "1", "0", "0", "0", "0", "0", "0" }

	g_jpSortI = -1
	g_jpOprtI = -1
	g_jpLeverI = -1

	if #g_JpOprtT > 0 then
		for i = 0 to #g_JpOprtT - 1
			if i == 0 then
				g_JpOprtC(i) = "1"
			
			else
				g_JpOprtC(i) = "0"
			
			end if
		next
	end if
	
	CmbOprtJp.setCurIndexSilent("0")
	'CmbOprtJp.currentindex = "0"
End Sub
