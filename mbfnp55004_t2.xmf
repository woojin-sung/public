		<CONTAINER name="Container0" scroll_pos="0,0" ly_vert="0,0,375,562,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<TABLE name="Table0" insidelinecolor="102:255255255" colcount="3" rowcount="1" designorder="1" ly_vert="0,0,441,39,1" >
					<COL_INFO ly_vert_width="30,345,66" />
					<ROW_INFO ly_vert_height="39" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="065:102102102" bgcolor="090:238239240" caption="Q" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" fgcolor="065:102102102" bgcolor="090:238239240" halign="0" caption="SMART PRO의 효과는 무엇이 있나요?" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="2,0,2,0" caption="N" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table1" insidelinecolor="102:255255255" colcount="2" rowcount="1" designorder="1" ly_vert="0,40,375,140,1" >
					<COL_INFO ly_vert_width="30,345" />
					<ROW_INFO ly_vert_height="140" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" bgcolor="042:255255255" caption="A" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,0,1,0" bgcolor="042:255255255" halign="0" caption="SMART PRO는 롱/숏 종목투자를 통해 청약금액의
2배에 투자가 가능한 상품입니다. 같은 명목금액으로
기초자산에 투자된 금액이 롱/숏 방향으로 2배에 해당
하기 때문에 수익도 2배, 손실위험에도 2배 노출되어
있습니다. 예를 들어 A주식 롱/B주식 숏을 기초자산
으로 하는 ELS에 1000만원 가입하였을 때, A주식에
1000만원, B주식에 1000만원 총 2000만원에 투자한
것과 같은 효과가 발생합니다." fontsize="-2" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table2" insidelinecolor="102:255255255" colcount="3" rowcount="1" designorder="1" ly_vert="0,160,441,39,1" >
					<COL_INFO ly_vert_width="30,345,66" />
					<ROW_INFO ly_vert_height="39" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="065:102102102" bgcolor="090:238239240" caption="Q" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" fgcolor="065:102102102" bgcolor="090:238239240" halign="0" caption="SMART PRO 의 강제청산이 무엇인가요?" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="2,0,2,0" caption="N" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table3" insidelinecolor="102:255255255" colcount="2" rowcount="1" designorder="1" ly_vert="0,200,375,107,1" >
					<COL_INFO ly_vert_width="30,345" />
					<ROW_INFO ly_vert_height="107" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" bgcolor="042:255255255" caption="A" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,0,1,0" bgcolor="042:255255255" halign="0" caption="SMART PRO는 고객 원금의 2배에 투자 가능하도록
설계한 상품입니다. 당사는 상품의 위험관리를 위해
수익률이 -50%가 되면 해당 회차를 강제청산 합니다.
수익률이 각각 -30%, -40% 일 때 청산가능성을 SMS로
통보 드리니 이점을 유의하시어 투자하시기 바랍니다." fontsize="-2" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table4" insidelinecolor="102:255255255" colcount="3" rowcount="1" designorder="1" ly_vert="0,270,441,39,1" >
					<COL_INFO ly_vert_width="30,345,66" />
					<ROW_INFO ly_vert_height="39" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="065:102102102" bgcolor="090:238239240" caption="Q" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" fgcolor="065:102102102" bgcolor="090:238239240" halign="0" caption="숏(대차매도) 종목 검토란 무엇인가요?" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="2,0,2,0" caption="N" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table5" insidelinecolor="102:255255255" colcount="2" rowcount="1" designorder="1" ly_vert="0,310,375,193,1" >
					<COL_INFO ly_vert_width="30,345" />
					<ROW_INFO ly_vert_height="193" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" bgcolor="042:255255255" caption="A" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,0,1,0" bgcolor="042:255255255" halign="0" caption="고객이 숏(대차매도)을 하기 위해서는 대여자로부터
주식을 차입하여 합니다. 고객이 숏 종목(롱종목)을
선택하고 투자를 결정하여 검토 요청을 하면 당사는
해당 종목의 대차가능여부, 대차수수료 등을 업데이트
드립니다. 고객 검토신청이 영업일 3시 이전일 경우 당일
검토회신을 드리고, 이후 시간에는 익영업일 3시까지
회신 할 수 있습니다. 고객은 검토 회신이 완료되면
대차수수료를 확인하고 익업일까지 청약하실 수 있습니다.
단 주식 차입의 경우 주식시장 상황 또는 대차 여건에
따라 반환요청이 들어올 가능성이 있고, ELS/DLS가
강제 환매 될 수 있습니다." fontsize="-2" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table6" insidelinecolor="102:255255255" colcount="3" rowcount="1" designorder="1" ly_vert="0,400,441,39,1" >
					<COL_INFO ly_vert_width="30,345,66" />
					<ROW_INFO ly_vert_height="39" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="065:102102102" bgcolor="090:238239240" caption="Q" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" fgcolor="065:102102102" bgcolor="090:238239240" halign="0" caption="청약가능시간은 무엇인가요?" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="2,0,2,0" caption="N" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table7" insidelinecolor="102:255255255" colcount="2" rowcount="1" designorder="1" ly_vert="0,440,375,91,1" >
					<COL_INFO ly_vert_width="30,345" />
					<ROW_INFO ly_vert_height="91" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" bgcolor="042:255255255" caption="A" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,0,1,0" bgcolor="042:255255255" halign="0" caption="고객에게 발행가능여부를 검토회신하여 주면,
당일 3시까지 또는 익영업일 3시까지 청약 가능합니다.
이 시간까지 청약 하지 않는 회차는 자동 발행
취소됩니다." fontsize="-2" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table8" insidelinecolor="102:255255255" colcount="3" rowcount="1" designorder="1" ly_vert="0,490,441,50,1" >
					<COL_INFO ly_vert_width="30,345,66" />
					<ROW_INFO ly_vert_height="50" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="065:102102102" bgcolor="090:238239240" caption="Q" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" fgcolor="065:102102102" bgcolor="090:238239240" halign="0" caption="SMART PRO를 통해 ELS/DLS를 발행신청 하면
실제 발행까지 얼마나 소요 되나요?" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="2,0,2,0" caption="N" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table9" insidelinecolor="102:255255255" colcount="2" rowcount="1" designorder="1" ly_vert="0,540,375,152,1" >
					<COL_INFO ly_vert_width="30,345" />
					<ROW_INFO ly_vert_height="152" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" bgcolor="042:255255255" caption="A" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,0,1,0" bgcolor="042:255255255" halign="0" caption="종목(롱/숏) 검토요청은 매일 정규장 시간에 가능하며
(3시 이후 검토요청의 건은 익일 검토 확인 할 수
있습니다. 만약, 오후 8시에 검토 요청이 오면 익일
검토확인 가능합니다) 검토 확인(T) 후 고객은 T+1일까지
청약 할 수 있습니다. 청약일(T')로부터 T'+1일이 최초
기준가격 결정일로 기준가격결정일에 체결가격이 결정
됩니다. ELS/DLS의 발행일은 청약일로부터 T'+2일이
됩니다." fontsize="-2" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table10" insidelinecolor="102:255255255" colcount="3" rowcount="1" designorder="1" ly_vert="0,600,441,39,1" >
					<COL_INFO ly_vert_width="30,345,66" />
					<ROW_INFO ly_vert_height="39" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="065:102102102" bgcolor="090:238239240" caption="Q" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" fgcolor="065:102102102" bgcolor="090:238239240" halign="0" caption="SMART PRO의 만기는 몇 년인가요?" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="2,0,2,0" caption="N" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table11" insidelinecolor="102:255255255" colcount="2" rowcount="1" designorder="1" ly_vert="0,640,375,89,1" >
					<COL_INFO ly_vert_width="30,345" />
					<ROW_INFO ly_vert_height="89" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" bgcolor="042:255255255" caption="A" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,0,1,0" bgcolor="042:255255255" halign="0" caption="Smart Pro는 3년 만기가 지정된 ELS/DLS 상품입니다.
이는 ELS/DLS의 특성상 설정 되어있는 기간이며
고객은 언제든 원하는 시점에 강제청산을 할 수 있습니다.
별도의 중도상환 수수료는 없습니다." fontsize="-2" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table12" insidelinecolor="102:255255255" colcount="3" rowcount="1" designorder="1" ly_vert="0,710,441,39,1" >
					<COL_INFO ly_vert_width="30,345,66" />
					<ROW_INFO ly_vert_height="39" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="065:102102102" bgcolor="090:238239240" caption="Q" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" fgcolor="065:102102102" bgcolor="090:238239240" halign="0" caption="중도환매설정은 어떻게 하나요?" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="2,0,2,0" caption="N" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table13" insidelinecolor="102:255255255" colcount="2" rowcount="1" designorder="1" ly_vert="0,750,375,174,1" >
					<COL_INFO ly_vert_width="30,345" />
					<ROW_INFO ly_vert_height="174" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" bgcolor="042:255255255" caption="A" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,0,1,0" bgcolor="042:255255255" halign="0" caption="중도환매는 잔고조회 및 환매신청 화면에서 가능하며
방법은 다음과 같습니다 

신청시간 : 영업일 오전 9시부터 오후 3시까지
매매체결일 : 신청일(T일)의 익일(T+1일) VWAP가격으로
기준가 설정
지급일 : 매매체결일 포함 2영업일 후 (T+2일) 지급

중도환매수수료는 없으며 전액 중도환매만 가능합니다." fontsize="-2" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table14" insidelinecolor="102:255255255" colcount="3" rowcount="1" designorder="1" ly_vert="0,890,441,39,1" >
					<COL_INFO ly_vert_width="30,345,66" />
					<ROW_INFO ly_vert_height="39" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="065:102102102" bgcolor="090:238239240" caption="Q" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" fgcolor="065:102102102" bgcolor="090:238239240" halign="0" caption="설정한 롱/숏 종목을 중도에 변경 가능한가요?" fontsize="-2" fontstyle="01" impidxs="" />
						<CELL cell_ly="2,0,2,0" caption="N" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="Table15" insidelinecolor="102:255255255" colcount="2" rowcount="1" designorder="1" ly_vert="0,1500,375,93,1" >
					<COL_INFO ly_vert_width="30,345" />
					<ROW_INFO ly_vert_height="93" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" bgcolor="042:255255255" caption="A" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,0,1,0" bgcolor="042:255255255" halign="0" caption="이미 발행이 완료된 ELS/DLS는 중도에 기초자산을
변경할 수 없습니다. 별도의 환매수수료가 없는
거래이므로 중도환매 후 새로운 종목에 재투자할 수
있습니다." fontsize="-2" impidxs="" />
					</CELL_INFO>
				</TABLE>
			</CONTROL_INFO>
