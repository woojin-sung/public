	<SCRIPT_INFO _len="11477" _ulen="11189" >
Dim Max
Dim OS_CLS_CODE
Max = 15
'============================================================================
Sub Form_OnFormInit()
	i           = 0
	Height      = 0
	OS_CLS_CODE = getSharedData("&OS_TYPE", FALSE)
	
	For i = 1 To Max Step 2
	
	    Height1 = 0
		TableNm = "Container0.Table" & i
		BfTableNm = "Container0.Table" & i-1
		
		Form.SetCtlProp(BfTableNm, "top", Height)
	    Select Case i
	        Case 1
	            'Form.SetCtlProp("Container0.Table0", "top", Height)
				If OS_CLS_CODE = "1" Then
				    Height  = Height + Container0.Table0.height_uc ' 앞의 Q항목 높이 더해줌
				    Height1 = Container0.Table1.height_uc
				Else
					Height  = Height + Container0.Table0.height ' 앞의 Q항목 높이 더해줌
					Height1 = Container0.Table1.height
				End If
				
				If Container0.Table0.GetCellString(0, 2) == "Y" Then
					Form.SetCtlProp(TableNm, "visible", True)
					Form.SetCtlProp(TableNm, "top", Height)
					Height = Height + Height1
        		Else
        			Form.SetCtlProp(TableNm, "visible", False)
        		End If
        		
	        Case 3
				'Form.SetCtlProp("Container0.Table2", "top", Height)
				If OS_CLS_CODE = "1" Then
				    Height  = Height + Container0.Table2.height_uc ' 앞의 Q항목 높이 더해줌
				    Height1 = Container0.Table3.height_uc
				Else
					Height  = Height + Container0.Table2.height ' 앞의 Q항목 높이 더해줌
					Height1 = Container0.Table3.height
				End If
	            
	            If Container0.Table2.GetCellString(0, 2) == "Y" Then
        			Form.SetCtlProp(TableNm, "visible", True)
        			Form.SetCtlProp(TableNm, "top", Height)
        			Height = Height + Height1
        		Else
        			Form.SetCtlProp(TableNm, "visible", False)
        		End If
        		
	        Case 5
	            'Form.SetCtlProp("Container0.Table4", "top", Height)
			    If OS_CLS_CODE = "1" Then
				    Height  = Height + Container0.Table4.height_uc ' 앞의 Q항목 높이 더해줌
				    Height1 = Container0.Table5.height_uc
				Else
					Height  = Height + Container0.Table4.height ' 앞의 Q항목 높이 더해줌
					Height1 = Container0.Table5.height
				End If
	            
	            If Container0.Table4.GetCellString(0, 2) == "Y" Then
        			Form.SetCtlProp(TableNm, "visible", True)
        			Form.SetCtlProp(TableNm, "top", Height)
        			Height = Height + Height1
        		Else
        			Form.SetCtlProp(TableNm, "visible", False)
        		End If
        		
	        Case 7
	            'Form.SetCtlProp("Container0.Table6", "top", Height)
			    If OS_CLS_CODE = "1" Then
				    Height  = Height + Container0.Table6.height_uc ' 앞의 Q항목 높이 더해줌
				    Height1 = Container0.Table7.height_uc
				Else
					Height  = Height + Container0.Table6.height ' 앞의 Q항목 높이 더해줌
					Height1 = Container0.Table7.height
				End If
	            
	            If Container0.Table6.GetCellString(0, 2) == "Y" Then
        			Form.SetCtlProp(TableNm, "visible", True)
        			Form.SetCtlProp(TableNm, "top", Height)
        			Height = Height + Height1
        		Else
        			Form.SetCtlProp(TableNm, "visible", False)
        		End If
        		
	        Case 9
	            'Form.SetCtlProp("Container0.Table8", "top", Height)
			    If OS_CLS_CODE = "1" Then
				    Height  = Height + Container0.Table8.height_uc ' 앞의 Q항목 높이 더해줌
				    Height1 = Container0.Table9.height_uc
				Else
					Height  = Height + Container0.Table8.height ' 앞의 Q항목 높이 더해줌
					Height1 = Container0.Table9.height
				End If
	            
	            If Container0.Table8.GetCellString(0, 2) == "Y" Then
        			Form.SetCtlProp(TableNm, "visible", True)
        			Form.SetCtlProp(TableNm, "top", Height)
        			Height = Height + Height1
        		Else
        			Form.SetCtlProp(TableNm, "visible", False)
        		End If
        		
	        Case 11
	            'Form.SetCtlProp(BfTableNm, "top", Height)
				If OS_CLS_CODE = "1" Then
				    Height  = Height + Container0.Table10.height_uc ' 앞의 Q항목 높이 더해줌
				    Height1 = Container0.Table11.height_uc
				Else
					Height  = Height + Container0.Table10.height ' 앞의 Q항목 높이 더해줌
					Height1 = Container0.Table11.height
				End If
	            
			    If Container0.Table10.GetCellString(0, 2) == "Y" Then
					Form.SetCtlProp(TableNm, "visible", True)
					Form.SetCtlProp(TableNm, "top", Height)
					Height = Height + Height1
				Else
					Form.SetCtlProp(TableNm, "visible", False)
				End If
			
	        Case 13
	            'Form.SetCtlProp(BfTableNm, "top", Height)
				If OS_CLS_CODE = "1" Then
				    Height  = Height + Container0.Table12.height_uc ' 앞의 Q항목 높이 더해줌
				    Height1 = Container0.Table13.height_uc
				Else
					Height  = Height + Container0.Table12.height ' 앞의 Q항목 높이 더해줌
					Height1 = Container0.Table13.height
				End If
	            
			    If Container0.Table12.GetCellString(0, 2) == "Y" Then
					Form.SetCtlProp(TableNm, "visible", True)
					Form.SetCtlProp(TableNm, "top", Height)
					Height = Height + Height1
				Else
					Form.SetCtlProp(TableNm, "visible", False)
				End If
	        Case 15
	            'Form.SetCtlProp(BfTableNm, "top", Height)
				If OS_CLS_CODE = "1" Then
				    Height  = Height + Container0.Table14.height_uc ' 앞의 Q항목 높이 더해줌
				    Height1 = Container0.Table15.height_uc
				Else
					Height  = Height + Container0.Table14.height ' 앞의 Q항목 높이 더해줌
					Height1 = Container0.Table15.height
				End If
	            
			    If Container0.Table14.GetCellString(0, 2) == "Y" Then
					Form.SetCtlProp(TableNm, "visible", True)
					Form.SetCtlProp(TableNm, "top", Height)
					Height = Height + Height1
				Else
					Form.SetCtlProp(TableNm, "visible", False)
				End If		
	    End Select
	    		
		
	Next

End Sub

