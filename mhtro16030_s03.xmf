'===========================================================================
' 화  면  명 : 종목검색창_메인
' 화  면  ID : 
' 개      요 : 
' 작      성 : 2015.04.22 이호철
' 수      정 : 2017.10.12 이재원
'===========================================================================
Dim g_tCmbData1
Dim g_tCmbData2
Dim g_nPage
Dim g_xPos
Dim g_nIndex
Dim g_szNext
g_tCmbData1 = "상해^심천^홍콩^뉴욕^아멕스^나스닥" '미/홍/중			
g_tCmbData2 = "도쿄^호치민^하노이" ' 일/베
g_nPage = 0
g_xPos  = ""
g_nIndex = 0
g_szNext = ""
'============================================================================
Sub Form_OnFormInit()
	Dim szCombo0
	Dim szCombo1
	Dim szCombo2	
	
	szCombo0 = Form.GetEnvData("16030_S03_COMBO0")
	szCombo1 = Form.GetEnvData("16030_S03_COMBO1")
	szCombo2 = Form.GetEnvData("16030_S03_COMBO2")
	
	if szCombo0 <> nil and szCombo0 <> "" then
		Form.SetCtlProp("Combo0",  "cbkeydata", szCombo0)
		SetControlNation()
	end if
	if szCombo1 <> nil and szCombo1 <> "" then
		Form.SetCtlProp("Combo1",  "cbkeydata", szCombo1)
	end if
	if szCombo2 <> nil and szCombo2 <> "" then
		Form.SetCtlProp("Combo2",  "cbkeydata", szCombo2)
	end if
	
	'콤보 배경색 : 검정색
	Combo0.bgimagetype = "1" 
	Combo1.bgimagetype = "1"
	Combo2.bgimagetype = "1"
	
	DATAMANAGER.RequestTranData( "ohhts_6241_001r" ) 
end Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCmb0
	Dim szCmb1
	Dim szCmb2
	Dim szDelay
	
	szCmb0 = Form.GetCtlProp( "Combo0",  "cbkeydata" ) 
	szCmb1 = Form.GetCtlProp( "Combo1",  "cbkeydata" ) 
	szCmb2 = Form.GetCtlProp( "Combo2",  "cbkeydata" )
	szDelay = ""
	
	if szCmb0 == "US" then
		if RadioGroup0.currentindex == "0" then
			szMarket = ""
		elseif RadioGroup0.currentindex == "1" then
			szMarket = "NY"
		elseif RadioGroup0.currentindex == "2" then
			szMarket = "AX"
		elseif RadioGroup0.currentindex == "3" then
			szMarket = "OQ"
		end if
		szDelay = Form.GetSharedData("REALTIME_NY", 0 ) '미국은 모두 동일하므로 뉴욕으로 통일
	elseif szCmb0 == "CN" then
		if RadioGroup1.currentindex == "0" then
			szMarket = "SH"
		elseif RadioGroup1.currentindex == "1" then
			szMarket = "SZ"
		end if
		szDelay = Form.GetSharedData("REALTIME_"..szMarket, 0 )
	else
		szMarket = szCmb0
		szDelay = Form.GetSharedData("REALTIME_"..szMarket, 0 )
	end if
	
	if szTranID == "ohhts_6241_001r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "62410" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay ) '실시간:0 지연:1
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_NTNL_CODE" , 0 , szCmb0 )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , szMarket )
'		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_BSTP_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_BLNG_CLS_CODE" , 0 , szCmb2 )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_DATE1" , 0 , szCmb1 )
'		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_VOL1" , 0 , "" )
'		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_TR_PBMN" , 0 , "" )
'		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_PRC1" , 0 , "" )
	end if
end Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6241_001r" then
		Dim nCount
		nCount    	= _tonumber( DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ) )

		for i=0 to nCount-1
		
			Dim szExid, szCode
			szExid  = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FID_COND_MRKT_CLS_CODE" , i)
			szCode  = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FIDX_ISCD" , i)

			Grid0.SetCellData("bd_cell12", g_nIndex + i, szExid.."@"..szCode)
			
			DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , i , szExid.."@"..szCode )
		next
		Grid0.keyall = "1"
'		DATAMANAGER.RequestRealData("ohhts_exst_ictg")
		g_nIndex = _tonumber( Grid0.rowcount )
	end if
end Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID == "ohhts_exst_ictg" then
		Dim szRealCode, nRealPrc, nChange, nSign, nRate
		szRealCode = DATAMANAGER.GetDataValue( 1, "ohhts_exst_ictg", "OutBlock1", "FIDXR_ISCD" , 0)
		nRealVolume = CDbl(DATAMANAGER.GetDataValue( 1, "ohhts_exst_ictg", "OutBlock1", "FIDXR_ACML_VOL" , 0))

		for i=0 to g_nIndex-1
			Dim szCode, nPrc
			szCode = Grid0.GetCellData("bd_cell12", i)
			nVolume = CDbl(Grid0.GetCellData("bd_cell8", i))

			if szCode == szRealCode then
			    If nVolume = "" Or CDbl( nVolume ) = 0.0 Then
				    Grid0.SetCellData("bd_cell11", i, "")
				    Exit Sub
				End If		

				Grid0.SetCellData("bd_cell11", i, ((nRealVolume - nVolume) / nVolume) * 100)
				Exit Sub
			end if
		next
	end if
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	Dim szComboData
	szComboData = Form.GetCtlProp( "Combo0",  "cbkeydata" ) 
	Form.SetEnvData(1, "16030_S03_COMBO0", szComboData)
	
	SetControlNation()
	
	g_nPage  = 0
	g_nIndex = 0
	g_szNext = ""
	Grid0.SetClear()

	DATAMANAGER.RequestTranData( "ohhts_6241_001r" ) 
end Sub

'============================================================================
Sub Combo1_OnEditComplete(iIndex)		
	Dim szComboData
	szComboData = Form.GetCtlProp( "Combo1",  "cbkeydata" ) 
	Form.SetEnvData(1, "16030_S03_COMBO1", szComboData)
	
	g_nPage  = 0
	g_nIndex = 0
	g_szNext = ""
	Grid0.SetClear()

	DATAMANAGER.RequestTranData( "ohhts_6241_001r" ) 
end Sub

'============================================================================
Sub Combo2_OnEditComplete(iIndex)	
	Dim szComboData
	szComboData = Form.GetCtlProp( "Combo2",  "cbkeydata" ) 
	Form.SetEnvData(1, "16030_S03_COMBO2", szComboData)
	
	g_nPage  = 0
	g_nIndex = 0
	g_szNext = ""
	Grid0.SetClear()

	DATAMANAGER.RequestTranData( "ohhts_6241_001r" ) 
end Sub

'============================================================================
Sub Form_OnRefresh()
	g_nPage  = 0
	g_nIndex = 0
	g_szNext = ""
		Grid0.SetClear()

	DATAMANAGER.RequestTranData( "ohhts_6241_001r" )
end Sub

'============================================================================
Function _tonumber(data)
	return tonumber(data) or 0
end Function

'============================================================================
Sub Grid0_OnScrollEnd()
	Dim bNext
	bNext = DATAMANAGER.IsMoreNextData( "ohhts_6241_001r" )
	if bNext == "1" or bNext == true then
		DATAMANAGER.RequestNextData( "ohhts_6241_001r" )
	end if
end Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	Dim sCode
	Dim sKorname
	Dim sExid
	
	sCode 	= Grid0.GetCellData( "bd_cell7", lRow )
	sKorname	= Grid0.GetCellData( "bd_cell0", lRow )
	sExid	= Grid0.GetCellData( "bd_cell5", lRow )
	
	if sCode <> "" then

		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", sExid.."@"..sCode.."★"..sKorName.."★".."", "" )
		Form.OpenScreen("16000", "")
		
	end if
end Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

'============================================================================
Sub SetControlNation()
	RadioGroup0.setCurIndexSilent("0")
	RadioGroup1.setCurIndexSilent("0")

	if Combo0.currentindex ==  "0" then
		RadioGroup0.visible = 1
		RadioGroup1.visible = 0
	elseif Combo0.currentindex ==  "1" then
		RadioGroup0.visible = 0
		RadioGroup1.visible = 1
	else
		RadioGroup0.visible = 0
		RadioGroup1.visible = 0
	end if
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	Form_OnRefresh()
End Sub

'============================================================================
Sub RadioGroup1_OnClick(nIndex)
	Form_OnRefresh()
End Sub

