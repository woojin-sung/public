'Form.SetSharedData("RMNDNO_51010", szSrno)				'잔고		
'Form.SetSharedData("SAVETYPE_51010" , szSaveType)			'저축방법 
'Form.SetSharedData("FUNDCODE_51010", g_szShortCd)
'Form.SetSharedData("FNDNAME_51010", szFndName)
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szFullAcnt	'계좌번호
dim	g_szRet		'리턴값
dim 	g_szAlertTitle	'알림타이틀
dim	g_szSort		'전체/정상/해지
dim	g_szSrno, g_szSaveType, g_szFundCd, g_szStndCd, g_szFundName, g_szOvrlSptxCd

g_szRet	=	"0"
g_szAlertTitle	=	"알림"
g_szSort	=	"1"	'기본값 정상
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	Form.SetScreenName("잔고")
	g_szFullAcnt	= 	Form.GetOpenLinkData()
	
	if	len(g_szFullAcnt)	>	8	then
		DATAMANAGER.RequestTranData("obsai_deal_083r")
	end if
End Sub


'============================================================================
'rdoSort01_OnClick
'============================================================================
Sub rdoSort01_OnClick(nIndex)

	if	nIndex	=	0	then			'정상
		g_szSort	=	"1"
	elseif	nIndex	=	1	then		'해지
		g_szSort	=	"2"
	elseif	nIndex	=	2	then		'전체
		g_szSort	=	"0"
	end if	

	if	len(g_szFullAcnt)	>	8	then
		DATAMANAGER.RequestTranData("obsai_deal_083r")
	end if
End Sub



'============================================================================
'grd01_OnClickUp
'============================================================================
Sub grd01_OnClickUp(lRow, szCellID)

	g_szSrno			=	grd01.GetCellData("bd_cell2", lRow)
	g_szSaveType		=	grd01.GetCellData("bd_savetype", lRow)
	g_szFundCd		=	grd01.GetCellData("bd_scode", lRow)
	g_szStndCd		=	grd01.GetCellData("bd_fullcode", lRow)
	g_szFundName		=	grd01.GetCellData("bd_cell0", lRow)
	g_szOvrlSptxCd	=	grd01.GetCellData("bd_cell1", lRow)

	Form.SetSharedData("RMNDNO_51010", szSrno)				'잔고		
	Form.SetSharedData("SAVETYPE_51010" , szSaveType)			'저축방법  
	Form.SetSharedData("FUNDCODE_51010", szFundCd)			'펀드코드
	Form.SetSharedData("FNDNAME_51010", szFundName)			'펀드명
	Form.SetSharedData("OVRLSPTXCD_51010", szOvrlSptxCd)		'종합분리과세구분코드
	
	g_szRet	=	"1"	
	
	dim szSrnoChk 
	szSrnoChk = Form.GetSharedData("FNPR_JOIN_SRNO", false)	
	
	if szSrnoChk == "" or szSrnoChk == null then
		Form.SendReturnToParent("51010_RMNO", g_szSrno & "★" & g_szSaveType & "★" & g_szFundCd & "★" & g_szStndCd & "★" & g_szFundName & "★" & g_szOvrlSptxCd	)	'메인에 조회하도록 요청
		Form.CloseForm()
	else
		Form.OpenPopup("mbonl81010_p20" , "" , "")
	end if
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if	szTranID	=	"obsai_deal_083r"	then
		DATAMANAGER.SetDataValue(0, "obsai_deal_083r", "InBlock1", "ACNO", 0, left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0, "obsai_deal_083r", "InBlock1", "ASNO", 0, mid(g_szFullAcnt,9,2))
		DATAMANAGER.SetDataValue(0, "obsai_deal_083r", "InBlock1", "ACNT_STAT_CODE", 0, g_szSort)
		DATAMANAGER.SetDataValue(0, "obsai_deal_083r", "InBlock1", "RMND_RFLC_YN", 0, "0")	'무잔고포함여부  포함:0 미포함:1
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	n083Cnt, nDivCnt
	dim	szOrgWay, szTransWay

	dim  nMulti
	
	if	szTranID	=	"obsai_deal_083r"	then
		n083Cnt 	=	grd01.rowcount
		nDivCnt	=	DATAMANAGER.GetDataCount(0, "obsai_deal_083r" , "OutBlock1")
		nMulti =  ( n083Cnt / nDivCnt) - 1
		
		for	i=0+(nMulti * nDivCnt) to	n083Cnt -1
			szOrgWay 	 =	grd01.GetCellData("bd_savetype", i)
	
			szTransWay =  Form.GetMetaData("집합투자증권저축유형코드", szOrgWay)
			grd01.SetCellData("bd_savetype", i, szTransWay)
		next
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	
	if	len(trim(szSubMsg))	>	0	then
		Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert(g_szAlertTitle, szErrMsg )
	end	if
	
End Sub


'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("51010_RMNOSELECTED" , g_szRet)
End Sub


'============================================================================
'ImageClose_OnClick
'============================================================================
Sub ImageClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName =="mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20"	then	
			Form.SendReturnToParent("51010_RMNO", g_szSrno & "★" & g_szSaveType & "★" & g_szFundCd & "★" & g_szStndCd & "★" & g_szFundName & "★" & g_szOvrlSptxCd	)	'메인에 조회하도록 요청
		end if
		Form.CloseForm()
	end if
End Sub

