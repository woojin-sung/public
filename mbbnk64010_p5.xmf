	<SCRIPT_INFO _len="7451" _ulen="6637" >

'============================================================================
' 화 면 명 : 외화이체 고객정보확인
'============================================================================

Dim g_szReturnKey

Dim g_szACNO
Dim g_szASNO

Dim g_ScreenShowCase

Dim g_szCustClsCode
Dim g_szEngName
Dim g_szCnplTelNo

'============================================================================
Sub Form_OnFormInit()

    f_InitValue()

    szData = Form.GetOpenLinkData( )
	
    If szData ~= "" And szData ~= "" Then
    
        tOpenData = Split(szData, "★")
        '계좌번호★계좌순번★구문코드★고객구분코드★영문명★전화번호
        g_szACNO         = tOpenData[0]
        g_szASNO         = tOpenData[1]
        g_ScreenShowCase = tOpenData[2]
        g_szCustClsCode  = tOpenData[3]
        g_szEngName      = tOpenData[4]
        g_szCnplTelNo    = tOpenData[5]

        f_initScreen()
	
    End If
	
End Sub

'============================================================================
Sub f_InitValue()

	g_ScreenShowCase = ""
	g_szCustClsCode = ""
	g_szEngName = ""
	g_szCnplTelNo = ""

End Sub

'============================================================================
Sub f_initScreen()

    If g_ScreenShowCase = "" Then
        Exit Sub
	End If
	
    If g_ScreenShowCase = "A" Then '개인 & 영문명, 휴대폰번호 둘다 없는 경우
            
        contB.visible = False
        contA.visible = True

        contA.imgEngNm.imgpath = "btn_line_n.9"
        contA.lblEngNm.caption   = "고객영문명"		
        contA.lblChangeNm.caption = "등록하기 >"
        contA.lblChangeNm.fgcolor = "67"	

        contA.imgPhoneNo.imgpath = "btn_line_n.9"		
        contA.lblPhoneNo.caption = "휴대폰번호"
        contA.lblChangeNo.caption = "등록하기 >"
        contA.lblChangeNo.fgcolor = "67"	
	
        contA.btnReg.enable = False
        contA.btnReg.btnimage = "btn_21.9"
        contA.btnReg.fgcolor = "269"	
	
        Exit Sub
	
    End If

    If g_ScreenShowCase = "B" Then '개인 & 전화번호만 있는
    
        contB.visible = False
        contA.visible = True    
	
        contA.lblPhoneNo.caption = g_szCnplTelNo '기등록 전화번호
        contA.lblPhoneNo.fgcolor = "4"	
	
        contA.lblChangeNo.caption = "변경하기 >"  '전화번호 변경 버튼 Caption
        contA.lblChangeNo.fgcolor = "67"          '전화번호 변경 버튼 색깔(파란색)
	
        contA.imgPhoneNo.imgpath = "btn_line_n.9" '전화번호 입력 활성화
	
        contA.lblEngNm.caption = "고객영문명"   '영문명 기등록내역 빈칸
        contA.imgEngNm.imgpath = "btn_line_n.9" '영문명 입력 활성화
	
        contA.lblChangeNm.caption = "등록하기 >"
        contA.lblChangeNm.fgcolor = "67"		
	
        contA.btnReg.enable = False
        contA.btnReg.btnimage = "btn_21.9"
        contA.btnReg.fgcolor = "269"	
	
        Exit Sub
	
    End If
			
    If g_ScreenShowCase = "C" Then '개인 & 영문명만 있는 경우
			
        contB.visible = False
        contA.visible = True

        contA.lblEngNm.caption = g_szEngName
        contA.lblEngNm.fgcolor = "4"	     '비활성화색깔
        contA.lblChangeNm.visible = False '영문명 변경 버튼 안보임

        contA.imgEngNm.imgpath = "bg_infobox.9" '영문명 입력 비활성화
	
        contA.lblPhoneNo.caption = "휴대폰번호"   '전화번호 기등록내역 빈칸
        contA.imgPhoneNo.imgpath = "btn_line_n.9" '전화번호 입력 활성화
	
        contA.lblChangeNo.caption = "등록하기 >"  '전화번호 변경 버튼 Caption
        contA.lblChangeNo.fgcolor = "67"          '전화번호 변경 버튼 색깔(파란색)
	
        contA.btnReg.enable = False
        contA.btnReg.btnimage = "btn_21.9"
        contA.btnReg.fgcolor = "269"	
	
        Exit Sub
			
    End If
    
    If g_ScreenShowCase = "D" Then
    
        '법인 & 영문명, 휴대폰번호 둘다 없는 경우 이체 불가 알림
        contB.visible = True
        contB.left    = 0
        contA.visible = False
        Exit Sub
	
    End If    
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbbnk64010_p5" , g_szReturnKey)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

    If sKeyName == "mbonl81000" Then '연락처등록 팝업
    
        szNewNum = Form.GetSharedData("mbbnk64010_new_number", True)
	
        If Trim(szNewNum) <> "" Then
            g_szCnplTelNo = Trim(szNewNum)
            contA.lblPhoneNo.caption = g_szCnplTelNo '기등록 전화번호
            contA.lblPhoneNo.fgcolor = "4"	
            contA.lblChangeNo.caption = "변경하기 >"  '전화번호 변경 버튼 Caption
            contA.lblChangeNo.fgcolor = "67"          '전화번호 변경 버튼 색깔(파란색)
            contA.imgPhoneNo.imgpath = "btn_line_n.9" '전화번호 입력 활성화	    
        End If

    End If
    
    If sKeyName == "EngName" Then '영문명등록 팝업

        If Trim(sRet) <> "" Then
            g_szEngName = Trim(sRet)
            contA.lblEngNm.caption = g_szEngName
            contA.lblEngNm.fgcolor = "4"	     '비활성화색깔
            contA.lblChangeNm.visible = False '영문명 변경 버튼 안보임
            contA.imgEngNm.imgpath = "bg_infobox.9" '영문명 입력 비활성화	
        End If

    End If
    
    If Trim(g_szEngName) <> "" And Trim(g_szCnplTelNo) <> "" Then
        contA.btnReg.enable   = True
        contA.btnReg.btnimage = "btn_20.9"
        contA.btnReg.fgcolor  = "273"		
    End If

End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contA_lblChangeNm_OnClick()

	'고객영문명 등록/변경
	Form.SetSharedData("89040_ACNO", g_szACNO)
	Form.SetSharedData("89040_ASNO", g_szASNO)
	
	if contA.lblEngNm.caption = "고객영문명" then
		Form.OpenPopup("mbonl89040_p2", "", "")
	else
		Form.OpenPopup("mbonl89040_p2", contA.lblEngNm.caption, "")
	end if
	
End Sub

'============================================================================
Sub contA_lblChangeNo_OnClick()

	'고객연락처 변경
	sTabIdx = "0"
	sSendData = g_szACNO..";"..""..";"..sTabIdx
	Form.OpenFramePopup("mbonl81000" , sSendData , "")	
	
End Sub

'============================================================================
Sub contA_btnCancel_OnClick()
	g_szReturnKey = "Cancel"
	Form.CloseForm()
End Sub

'============================================================================
Sub contA_btnReg_OnClick()

	'등록하기 버튼
	if contA.lblEngNm.caption = "고객영문명" or contA.lblEngNm.caption = "" then
		Form.MsgBox( "알림", "고객영문명을 확인하십시요.", "" )
		Exit Sub
	end if
	
	if contA.lblPhoneNo.caption = "휴대폰번호" or Replace(contA.lblPhoneNo.caption,"-","") = "" then
		Form.MsgBox( "알림", "휴대폰번호를 확인하십시요.", "" )
		Exit Sub
	end if	
	
	g_szReturnKey = "OK"
	Form.CloseForm()
	
End Sub

'============================================================================
Sub contB_btnOK2_OnClick()
	g_szReturnKey = "Cancel"
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>