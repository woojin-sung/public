<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrname="외화이체_고객정보확인팝업" version="2" writer="이아영" />
	<FORM_INFO name="Form" transmode="0" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<BUTTON name="BtnClose" btnimage="alpha" ly_vert="0,0,375,647,1" />
		<CONTAINER name="contA" containerimage="alpha" scroll_pos="0,0" ly_vert="0,347,375,300,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<IMAGE name="imgHeader" imgpath="input_03_n.9" ly_vert="0,0,375,300,1" />
				<LABEL name="Label0" fontsize="3" fontstyle="01" caption="고객 정보 확인" halign="1" valign="2" ly_vert="0,0,375,43,1" />
				<LABEL name="lblInfo" fgcolor="146:124124124" fontsize="-1" caption="고객정보 등록 후 외화 이체 진행이 가능합니다.
영문명 및 휴대폰번호를 확인해주세요" halign="1" multiline="1" ly_vert="20,60,335,40,1" />
				<IMAGE name="imgEngNm" ly_vert="20,120,335,45,1" />
				<IMAGE name="imgPhoneNo" ly_vert="20,175,335,45,1" />
				<LABEL name="lblEngNm" fgcolor="146:124124124" caption="고객영문명" ly_vert="30,124,213,35,1" />
				<LABEL name="lblPhoneNo" fgcolor="146:124124124" ly_vert="30,180,200,35,1" />
				<LABEL name="lblChangeNm" fontsize="-2" halign="2" click="1" ly_vert="255,125,85,35,1" />
				<LABEL name="lblChangeNo" fontsize="-2" caption="등록하기" halign="2" click="1" ly_vert="255,180,85,35,1" />
				<BUTTON name="btnCancel" caption="취소" fgcolor="004:000000000" fontsize="2" fontstyle="01" btnimage="btn_25.9" ly_vert="-3,250,188,50,1" />
				<BUTTON name="btnReg" caption="이체 계속 진행" fontsize="2" fontstyle="01" btnimage="btn_20.9" ly_vert="185,250,191,50,1" />
			</CONTROL_INFO>
		</CONTAINER>
		<CONTAINER name="contB" visible="0" containerimage="alpha" scroll_pos="0,0" ly_vert="400,447,375,200,0" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<IMAGE name="Image0" imgpath="input_03_n.9" ly_vert="0,0,375,200,1" />
				<BUTTON name="btnOK2" caption="확인" fontsize="2" fontstyle="01" btnimage="btn_22.9" ly_vert="0,150,375,50,1" />
				<LABEL name="Label1" fontsize="3" fontstyle="01" caption="고객 정보 확인" halign="1" valign="2" ly_vert="0,0,375,43,1" />
				<LABEL name="Label2" fontsize="-1" caption="고객정보 등록 후 외화 이체 진행이 가능합니다." halign="1" multiline="1" ly_vert="20,58,335,20,1" />
				<LABEL name="Label3" fontsize="-1" caption="영업점 방문 후 영문명 및 휴대폰번호를" halign="1" multiline="1" ly_vert="20,80,335,20,1" />
				<LABEL name="Label4" fontsize="-1" caption="등록 해주세요." halign="1" multiline="1" ly_vert="20,102,335,20,1" />
			</CONTROL_INFO>
