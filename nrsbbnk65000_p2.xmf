'==============================================
' 외화 거래가능 통화 조회
'==============================================
Function Request_Tran_obtsd_fbnk_322r()
	contBg.Pannel1.rowcount = 0
	
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_322r")
	DATAMANAGER.RequestTranData("obtsd_fbnk_322r")
End Function

'==============================================
' 외화 거래가능 통화 조회 처리
'==============================================
Function Process_Tran_obtsd_fbnk_322r()

	if g_szGbn == "0" then
		nDataCnt = DATAMANAGER.GetDataCount(false, "obtsd_fbnk_322r", "OutBlock1")
		
		g_arrAbleCrcd = {}
		for i = 0 to nDataCnt-1
			szCrcd 	= DATAMANAGER.GetDataValue(false, "obtsd_fbnk_322r", "OutBlock1", "CRCD", i)
			
			isAdd = false
			if g_szCtcd <> "" then
				if g_szCtcd == szCrcd or szCrcd == "KRW" then
					isAdd = true
				end if
			else
				isAdd = true
			end if
			
			if isAdd == true then
				Table.insert(g_arrAbleCrcd, szCrcd)
			end if
		next
	elseif g_szGbn == "1" then
	
		nDataCnt = DATAMANAGER.GetDataCount(false, "obtsd_fbnk_322r", "OutBlock2")
		
		nColIdx = 0
		nIdx = 0
		for i = 0 to nDataCnt-1
			szCrcd 	= DATAMANAGER.GetDataValue(false, "obtsd_fbnk_322r", "OutBlock2", "CRCD", i)
			szCrcdNm = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_322r", "OutBlock2", "CRCD_KOR_NAME", i)
			szCrcdTotNm = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_322r", "OutBlock2", "UI_ITEM_NAME", i)
	
			szFlag = Form.getIconImg("CRCD", szCrcd)
			if szFlag = "" then
				szFlag = "flag_general"
			end if
			
			isAdd = false
	
			'해외CFD 계좌 환전통화 제한
			if g_szCtcd <> "" then
				if g_szCtcd == szCrcd then
					isAdd = true
				elseif szCrcd == "KRW" and g_szSvcd_Other == "001" then
					
					isAdd = true
				end if
			else
				'매도통화가 USD이고 시간외환전 시간
				if g_szCrcd_Sell == "USD" and g_szSvcd_Other == "002" then
					if szCrcd == "KRW" or szCrcd == "USD" then
						isAdd = true
					end if
				else
					if szCrcd == "KRW" and g_szSvcd_Other == "002" then
						isAdd = false
					else
						isAdd = true
					end if
				end if
			end if
			
			
			if isAdd == true then
				if nColIdx == 0 then
					nIdx = contBg.Pannel1.AddRow()
				end if
				
				DisplaySetting_Pannel1(nIdx, nColIdx, szCrcd, szCrcdTotNm, szFlag) 
				
				if nColIdx == 1 then
					nColIdx = 0
				else
					nColIdx = nColIdx + 1
				end if 
			end if
		next 
	end if
	
	if DATAMANAGER.IsMoreNextData("obtsd_fbnk_322r") == true then
		DATAMANAGER.RequestNextData("obtsd_fbnk_322r")
	else
		if g_szGbn == "0" then
			Request_Tran_obrtd_fcur_001r()
		elseif g_szGbn == "1" then
			szAccType = Form.GetSharedData("65000_ACC_TYPE", false )
			
			if szAccType <> "135" then
				if g_isAbleVND == true and g_szCtcd == "" then
					
					if nColIdx == 0 then
						nIdx = contBg.Pannel1.AddRow()
					end if
					
					szFlag = Form.getIconImg("CRCD", "VND")
					if szFlag = "" then
						szFlag = "flag_general"
					end if
					
					DisplaySetting_Pannel1(nIdx, nColIdx, "VND", "베트남 VND", szFlag) 
					
					if nColIdx == 1 then
						nColIdx = 0
					else
						nColIdx = nColIdx + 1
					end if
				end if
			end if
			
			nCnt = Cint(contBg.Pannel1.rowcount)
			if nCnt == 0 then
				DisplaySetting_ContBg("empty")
			else
				DisplaySetting_ContBg("1")
			end if
		end if
	end if
End Function

'==============================================
' 외화 거래가능 통화 데이터 세팅
'==============================================
'인덱스 / 컬럼인덱스 / 통화코드 / 통화코드명 / 국기이미지
Function DisplaySetting_Pannel1(nIdx, nColIdx, szCrcd, szCrcdNm, szFlag) 
	'showalert nIdx .. "|" .. nColIdx .. "|" .. szCrcd .. "|" .. szCrcdNm .. "|" .. szFlag 
	
	contBg.Pannel1.SetCellVisible("imgFlag" & nColIdx, nIdx, true)
	contBg.Pannel1.SetCellVisible("lblCrcd" & nColIdx, nIdx, true)
	contBg.Pannel1.SetCellVisible("lblCrcdNm" & nColIdx, nIdx, true)
	
	'국기이미지 
	contBg.Pannel1.setPropCardCell("maintainratio"	,"imgFlag" & nColIdx	,nIdx	,"2")
	contBg.Pannel1.setPropCardCell("imgpath"			,"imgFlag" & nColIdx	,nIdx	,szFlag)
	
	'통화코드
	contBg.Pannel1.setPropCardCell("paddinginfo"	,"lblCrcd" & nColIdx	,nIdx	,"0,0,0,0")
	contBg.Pannel1.setPropCardCell("fgcolor"		,"lblCrcd" & nColIdx	,nIdx	,g_szTxtColor_Normal)
	contBg.Pannel1.setPropCardCell("visible"		,"lblCrcd" & nColIdx	,nIdx	,false)
	contBg.Pannel1.setPropCardCell("caption"		,"lblCrcd" & nColIdx	,nIdx	,szCrcd)
	
	'통화코드명
	contBg.Pannel1.setPropCardCell("paddinginfo"	,"lblCrcdNm" & nColIdx	,nIdx	,"0,0,0,0")
	contBg.Pannel1.setPropCardCell("fgcolor"		,"lblCrcdNm" & nColIdx	,nIdx	,g_szTxtColor_Normal)
	contBg.Pannel1.setPropCardCell("maxlinecnt"	,"lblCrcdNm" & nColIdx	,nIdx	,"1")
	contBg.Pannel1.setPropCardCell("caption"		,"lblCrcdNm" & nColIdx	,nIdx	,szCrcdNm)
End Function


'==============================================
' 환전가능금액 조회
'==============================================
Function Request_Tran_obrtd_fcur_001r()
	contBg.Pannel0.rowcount = 0
	
	DATAMANAGER.ClearInputData(false, "obrtd_fcur_001r")
	
	DATAMANAGER.SetDataValue(false, "obrtd_fcur_001r", "InBlock1", "ACNO" , 0 , g_szAcno)
	DATAMANAGER.SetDataValue(false, "obrtd_fcur_001r", "InBlock1", "ASNO" , 0 , g_szAsno)
	DATAMANAGER.SetDataValue(false, "obrtd_fcur_001r", "InBlock1", "SVCD" , 0 , "001")
	DATAMANAGER.SetDataValue(false, "obrtd_fcur_001r", "InBlock1", "ACNT_PWD" , 0 , g_szPwd)
	
	DATAMANAGER.RequestTranData("obrtd_fcur_001r")
End Function

'==============================================
' 환전가능금액 조회 처리
'==============================================
Function Process_Tran_obrtd_fcur_001r()

	nDataCnt = DATAMANAGER.GetDataCount(false, "obrtd_fcur_001r", "OutBlock1")
	
	nIdx = 0
	for i = 0 to nDataCnt-1
		szCrcd 		= DATAMANAGER.GetDataValue(false, "obrtd_fcur_001r", "OutBlock1", "CRCD", i)
		szCrcdNm 	= DATAMANAGER.GetDataValue(false, "obrtd_fcur_001r", "OutBlock1", "CRCD_KOR_NAME", i)
		szAbleAmt     = DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "ATMT_INVT_VLTN_ADUP_FRCR_AMT", i ) 
		szMaxAbleAmt     = DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "UI_MAX_MNEC_ABLE_FRCR_AMT", i ) 
		if cdbl(szMaxAbleAmt) > 0 or cdbl(szAbleAmt) > 0 then
			szFlag = Form.getIconImg("CRCD", szCrcd)
			if szFlag == "" then
				szFlag = "flag_general"
			end if
			
			if szCrcd == "KRW" or szCrcd == "JPY" then
				szAbleAmt = FormatNumber(szAbleAmt, 0)
			else
				szAbleAmt = FormatNumber(szAbleAmt, 2)
			end if 
			
			isAdd = false
			
			for j = 0 to #g_arrAbleCrcd - 1 
				szArrCrcd = g_arrAbleCrcd(j)
				
				if szArrCrcd == szCrcd then
					isAdd = true
				end if
			next
			
			if szCrcd == "VND" and g_isAbleVND == true then
				isAdd = true
			end if
			
			if isAdd == true then
				nIdx = contBg.Pannel0.AddRow()
				DisplaySetting_Pannel0(nIdx, szCrcd, szCrcdNm, szAbleAmt, szFlag) 
			end if
			
'			'---------------------------------------------------------------------
'			' 보유통화 세팅 가능한 경우 
'			' - 원화 : 항상
'			' - VND 제외 외화 : 실시간 환전 가능할때
'			' - VND : 베트남 환전 가능할때
'			'---------------------------------------------------------------------
'			if szCrcd == "KRW" then
'				nIdx = contBg.Pannel0.AddRow()
'				DisplaySetting_Pannel0(nIdx, szCrcd, szCrcdNm, szAbleAmt, szFlag) 
'			elseif szCrcd == "USD" then
'				if g_szSvcd_USD == "001" then
'					nIdx = contBg.Pannel0.AddRow()
'					DisplaySetting_Pannel0(nIdx, szCrcd, szCrcdNm, szAbleAmt, szFlag) 
'				end if
'			elseif szCrcd == "VND" then
'				if g_isAbleVND == true then
'					nIdx = contBg.Pannel0.AddRow()
'					DisplaySetting_Pannel0(nIdx, szCrcd, szCrcdNm, szAbleAmt, szFlag)
'				end if
'			else
'				if g_szSvcd_Other == "001" then
'					nIdx = contBg.Pannel0.AddRow()
'					DisplaySetting_Pannel0(nIdx, szCrcd, szCrcdNm, szAbleAmt, szFlag) 
'				end if
'			end if
			
		end if
	next 
	
	if DATAMANAGER.IsMoreNextData("obtsd_fcur_001r") == true then
		DATAMANAGER.RequestNextData("obtsd_fcur_001r")
		
	else
		nCnt = Cint(contBg.Pannel0.rowcount)
		if nCnt == 0 then
			DisplaySetting_ContBg("empty")
		else
			DisplaySetting_ContBg("0")
		end if
	end if
End Function

'==============================================
' 환전가능금액 세팅
'==============================================
'인덱스 / 컬럼인덱스 / 통화코드 / 통화코드명 / 국기이미지
Function DisplaySetting_Pannel0(nIdx, szCrcd, szCrcdNm, szAmt, szFlag) 
	'showalert nIdx .. "|" .. szAmt .. "|" .. szCrcd .. "|" .. szCrcdNm .. "|" .. szFlag 
	
	contBg.Pannel0.SetCellVisible("imgFlag0", nIdx, true)
	contBg.Pannel0.SetCellVisible("lblCrcd0", nIdx, true)
	contBg.Pannel0.SetCellVisible("lblCrcdNm0", nIdx, true)
	contBg.Pannel0.SetCellVisible("lblAmt0", nIdx, true)
	
	
	'국기이미지 
	contBg.Pannel0.setPropCardCell("bgcolor"	,"lblGuideLine"	,nIdx	,g_szLineColor)
	'contBg.Pannel0.setPropCardCell("imgpath"			,"lblGuideLine"	,nIdx	,szFlag)
	
	'국기이미지 
	contBg.Pannel0.setPropCardCell("maintainratio"	,"imgFlag0"	,nIdx	,"2")
	contBg.Pannel0.setPropCardCell("imgpath"			,"imgFlag0"	,nIdx	,szFlag)
	
	'통화코드
	contBg.Pannel0.setPropCardCell("paddinginfo"	,"lblCrcd0"	,nIdx	,"0,0,0,0")
	contBg.Pannel0.setPropCardCell("fgcolor"		,"lblCrcd0"	,nIdx	,g_szTxtColor_Normal)
	contBg.Pannel0.setPropCardCell("caption"		,"lblCrcd0"	,nIdx	,szCrcd)
	
	'통화코드명
	contBg.Pannel0.setPropCardCell("paddinginfo"	,"lblCrcdNm0"	,nIdx	,"0,0,0,0")
	contBg.Pannel0.setPropCardCell("fgcolor"		,"lblCrcdNm0"	,nIdx	,g_szTxtColor_Normal)
	contBg.Pannel0.setPropCardCell("maxlinecnt"	,"lblCrcdNm0"	,nIdx	,"1")
	contBg.Pannel0.setPropCardCell("caption"		,"lblCrcdNm0"	,nIdx	,szCrcdNm)
	
	'통화코드명
	contBg.Pannel0.setPropCardCell("paddinginfo"	,"lblAmt0"	,nIdx	,"0,0,0,0")
	contBg.Pannel0.setPropCardCell("fgcolor"		,"lblAmt0"	,nIdx	,g_szTxtColor_Normal)
	contBg.Pannel0.setPropCardCell("maxlinecnt"	,"lblAmt0"	,nIdx	,"1")
	contBg.Pannel0.setPropCardCell("caption"		,"lblAmt0"	,nIdx	,szAmt)
End Function


'===============================================
' 배경 컨테이너 크기 조정
'===============================================
Function DisplaySetting_ContBg(szGbn)
	nPannelHeight = 0
	
	'보유통화
	if szGbn == "0" then
		nTotalRowCnt = Cint(contBg.Pannel0.rowcount)
		nPannelHeight = (nTotalRowCnt * 44) + ((nTotalRowCnt-1) * 10) + 20
		
		if nPannelHeight > 350 then
			nPannelHeight = 350
'		elseif nPannelHeight < 300 then
'			nPannelHeight = 300
		end if
		
		contBg.Pannel0.top = 76
		contBg.Pannel0.height = nPannelHeight
	
	'거래가능 통화
	elseif szGbn == "1" or szGbn == "2" then
		nTotalRowCnt = Cint(contBg.Pannel1.rowcount)
		nPannelHeight = (nTotalRowCnt * 44) + ((nTotalRowCnt-1) * 10) + 20
		
		if szGbn == "2" then
			if g_szCtcd == "" then
				nPannelHeight = nPannelHeight + 20
			end if
		end if
		
		if nPannelHeight > 350 then
			nPannelHeight = 350
'		elseif nPannelHeight < 300 then
'			nPannelHeight = 300
		end if
		
		contBg.Pannel1.top = 76
		contBg.Pannel1.height = nPannelHeight
		
	elseif szGbn == "empty" then
		contBg.contEmpty.visible = true
		contBg.Pannel0.visible = false
		contBg.Pannel1.visible = false
		nPannelHeight = 180
		
	end if
		
	nTotalHeight = 86 + nPannelHeight
	contBg.top = 755 - nTotalHeight
	contBg.height = nTotalHeight+5
	
	
	if szGbn == "2" then
		contBg.lblInfo.top = nTotalHeight + 5 - 60
	end if
	
	contBg.visible = true
End Function

'===============================================
' 데이터 후처리 함수
'===============================================
Function PostProcess(szCrcd)
	if szCrcd == "" or szCrcd == null then
		Exit Function
	end if
	
	Form.SendReturnToParent("SELECT_CRCD" , szCrcd)
	Form.CloseForm()
End Function

Function truncateToDecimalPlaces(nVal, nDeimalPlaces)
	nFactor = 10 ^ nDeimalPlaces
	return int(nVal*nFactor) / nFactor
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	Dim szLinkData
	szLinkData = ""
	szLinkData = Form.GetOpenLinkData()
	
	if szLinkData == "" then
		Form.CloseForm()
		Exit Sub
	end if 
	
	arrLinkData = split(szLinkData, "`")
	
	if #arrLinkData < 1 then
		Form.CloseForm()
		Exit Sub
	else
		if (arrLinkData(0) == "0" and #arrLinkData > 3) then
			g_szGbn = arrLinkData(0)
			' 계좌번호
			g_szAcno = arrLinkData(1)
			g_szAsno = arrLinkData(2)
			
			' 계좌 비밀번호
			g_szPwd = arrLinkData(3)
			
'			g_szSvcd = ""'arrLinkData(4)
			
			g_szCtcd = arrLinkData(5)

			Request_Tran_obtsd_fbnk_009r()
			Request_Tran_obtsd_fbnk_009r_1()
			Request_Tran_obtsd_fbnk_009r_2()
			
		elseif arrLinkData(0) == "1" then
			g_szGbn = arrLinkData(0)
			g_szCrcd_Sell = arrLinkData(1)
			g_szSvcd_Sell = arrLinkData(2)
			g_szCtcd = arrLinkData(3)

			Request_Tran_obtsd_fbnk_009r()
			Request_Tran_obtsd_fbnk_009r_1()
			Request_Tran_obtsd_fbnk_009r_2()
			
		elseif arrLinkData(0) == "2" then
			g_szGbn = arrLinkData(0)
			g_szCtcd = arrLinkData(1)
			
			Init_Control("2")
			
			if g_szCtcd == "" then
				contBg.Pannel1.AddRow()
				
				szFlag = Form.getIconImg("CRCD", "USD")
				if szFlag == "" then
					szFlag = "flag_general"
				end if
				DisplaySetting_Pannel1(0, 0, "USD", "미국 USD", szFlag) 
				
				szFlag = Form.getIconImg("CRCD", "JPY")
				if szFlag == "" then
					szFlag = "flag_general"
				end if
				DisplaySetting_Pannel1(0, 1, "JPY", "일본 JPY", szFlag) 
				
				contBg.Pannel1.AddRow()
				
				szFlag = Form.getIconImg("CRCD", "CNY")
				if szFlag == "" then
					szFlag = "flag_general"
				end if
				DisplaySetting_Pannel1(1, 0, "CNY", "중국 CNY", szFlag) 
				
				szFlag = Form.getIconImg("CRCD", "HKD")
				if szFlag == "" then
					szFlag = "flag_general"
				end if
				DisplaySetting_Pannel1(1, 1, "HKD", "홍콩 HKD", szFlag) 
			else
				contBg.Pannel1.AddRow()
				
				szData = ""
				if g_szCtcd == "USD" then
					szData = "미국 USD"
				elseif g_szCtcd == "JPY" then
					szData = "일본 JPY"
				elseif g_szCtcd == "CNY" then
					szData = "중국 CNY"
				elseif g_szCtcd == "HKD" then
					szData = "홍콩 HKD"
				end if
				
				szFlag = Form.getIconImg("CRCD", g_szCtcd)
				if szFlag == "" then
					szFlag = "flag_general"
				end if
				
				DisplaySetting_Pannel1(0, 0, g_szCtcd, szData, szFlag) 
			end if
			
			DisplaySetting_ContBg("2")
		else
			Form.CloseForm()
			Exit Sub
		end if
	end if 

End Sub

'===============================================
' imgBg_OnClick
'===============================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'===============================================
' DATAMANAGER_OnReceiveTranComplete
'===============================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtsd_fbnk_322r" then
		Process_Tran_obtsd_fbnk_322r()
		
	elseif szTranID == "obrtd_fcur_001r" then
		Process_Tran_obrtd_fcur_001r()
		
	elseif szTranID == "obtsd_fbnk_009r" then
		Process_Tran_obtsd_fbnk_009r()
	elseif szTranID == "obtsd_fbnk_009r_1" then
		Process_Tran_obtsd_fbnk_009r_1()
		
	elseif szTranID == "obtsd_fbnk_009r_2" then
		Process_Tran_obtsd_fbnk_009r_2()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtsd_fbnk_009r" then
		Process_Tran_obtsd_fbnk_009r()
	elseif szTranID == "obtsd_fbnk_009r_1" then
		Process_Tran_obtsd_fbnk_009r_1()
	elseif szTranID == "obtsd_fbnk_009r_2" then
		Process_Tran_obtsd_fbnk_009r_2()
	end if
End Sub

'===============================================
' contBg_Pannel1_OnClick
'===============================================
Sub contBg_Pannel1_OnClick(nIndex, sCellID)
	if sCellID == "imgFlag0" or sCellID == "lblCrcdNm0" then
		sCellID = "lblCrcd0"
	elseif sCellID == "imgFlag1" or sCellID == "lblCrcdNm1" then
		sCellID = "lblCrcd1"
	end if 
	
	if sCellID == "lblCrcd0" or sCellID == "lblCrcd1"  then
		szCrcd = contBg.Pannel1.getPropCardCell("caption", sCellID, nIndex)
		PostProcess(szCrcd)
	end if
End Sub

'===============================================
' contBg_Pannel0_OnClick
'===============================================
Sub contBg_Pannel0_OnClick(nIndex, sCellID)
	if sCellID == "imgFlag0" or sCellID == "lblCrcdNm0" or sCellID == "lblAmt0" then
		sCellID = "lblCrcd0"
	end if 
	
	if sCellID == "lblCrcd0" then
		szCrcd = contBg.Pannel0.getPropCardCell("caption", sCellID, nIndex)
		PostProcess(szCrcd)
	end if
End Sub

