'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'==============================================
' 이미지
'==============================================

'==============================================
' 컬러코드
'==============================================
' 기본 텍스트 컬러 (검정색)
Dim g_szTxtColor_Normal 
g_szTxtColor_Normal 	= "334"

' 기본 텍스트 컬러 (회색)
Dim g_szTxtColor_Grey 
g_szTxtColor_Grey 	= "333"

' 기본 텍스트 컬러 (흰색)
Dim g_szTxtColor_White 
g_szTxtColor_White 	= "338"

' 빨강
Dim g_szTxtColor_Red 
g_szTxtColor_Red = "290"

' 파랑
Dim g_szTxtColor_Blue 
g_szTxtColor_Blue = "291"

' 기본 배경색상
Dim g_szContBgColor
g_szContBgColor = "320"

' 기본 구분선 색상
Dim g_szLineColor
g_szLineColor = "256"

' 빨강
Dim g_szBadgeBgColor_Red
g_szBadgeBgColor_Red = "339"

' 파랑
Dim g_szBadgeBgColor_Blue
g_szBadgeBgColor_Blue = "340"

'==============================================
' 기타 전역변수
'==============================================
' 계좌번호
Dim g_szAcno
g_szAcno = ""

Dim g_szAsno
g_szAsno = ""

' 계좌 비밀번호
Dim g_szPwd
g_szPwd = ""

Dim g_szSvcd_Sell
g_szSvcd_Sell = ""

Dim g_szGbn
g_szGbn = ""

Dim g_szCrcd_Sell
g_szCrcd_Sell = ""

Dim g_nSvcd_Chk
g_nSvcd_Chk = 0

Dim g_szSvcd_USD
g_szSvcd_USD = ""

Dim g_szSvcd_Other
g_szSvcd_Other = ""

Dim g_isAbleVND
g_isAbleVND = false

Dim g_arrAbleCrcd
g_arrAbleCrcd = {}

DIm g_szCtcd
g_szCtcd = ""

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************

'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control(szGbn)
	
	contBg.setEnableScroll(false)
	contBg.visible = false
	
	contBg.contEmpty.lblEmpty.paddinginfo = "0,0,0,0"
	contBg.contEmpty.lblEmpty.fgcolor = g_szTxtColor_Grey
	
	contBg.contEmpty.imgEmpty.maintainratio = "1"
	contBg.contEmpty.imgEmpty.imgpath = "icon_notice_3"

	contBg.contEmpty.visible = false
	
	if szGbn = "0" then
		contBg.lblTitle.caption = "보유 통화 선택"
		
		contBg.Pannel0.visible = true
		contBg.Pannel1.visible = false
		
		Request_Tran_obtsd_fbnk_322r()
		'Request_Tran_obrtd_fcur_001r()
		
	elseif szGbn = "1" then
		contBg.lblTitle.caption = "환전 통화 선택"
		
		contBg.Pannel0.visible = false
		contBg.Pannel1.visible = true
		
		Request_Tran_obtsd_fbnk_322r()
		
	elseif szGbn = "2" then
		contBg.lblTitle.caption = "목표환율 통화 선택"
		
		contBg.Pannel0.visible = false
		contBg.Pannel1.visible = true
		
		if g_szCtcd == "" then
			contBg.lblInfo.paddinginfo = "0,0,0,0"
			contBg.lblInfo.fgcolor = g_szTxtColor_Grey
			contBg.lblInfo.caption = "ㆍ목표환율환전 신청은 USD, JPY, CNY, HKD만 가능합니다."
			
			contBg.lblInfo.visible = true
		end if
	else
		Form.CloseForm()
	end if
End Function

'==============================================
' 환전 가능 여부 확인
'==============================================

'미국 환전 가능여부 조회
Function Request_Tran_obtsd_fbnk_009r()
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_009r")
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r", "InBlock1", "IQRY_CLS_CODE", 0 , "0")
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r", "InBlock1", "ACNO", 0 , "")
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r", "InBlock1", "ASNO", 0 , "")
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r", "InBlock1", "SVCD", 0 , "")
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r", "InBlock1", "CRCD", 0 , "USD")
	DATAMANAGER.RequestTranData("obtsd_fbnk_009r")
End Function

'미국 외 환전 가능여부 조회
Function Request_Tran_obtsd_fbnk_009r_1()
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_009r_1")
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_1", "InBlock1", "IQRY_CLS_CODE", 0 , "0")
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_1", "InBlock1", "ACNO", 0 , "")
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_1", "InBlock1", "ASNO", 0 , "")
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_1", "InBlock1", "SVCD", 0 , "")
	
	' 미국 외 통화 환전가능여부 조회 필요
	' 특정 통화를 지정해 조회해야하는 문제 발생
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_1", "InBlock1", "CRCD", 0 , "HKD")
	DATAMANAGER.RequestTranData("obtsd_fbnk_009r_1")
End Function

'베트남 환전 가능여부 조회
Function Request_Tran_obtsd_fbnk_009r_2()
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_009r_2")
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_2", "InBlock1", "IQRY_CLS_CODE", 0 , "1")
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_2", "InBlock1", "ACNO", 0 , "")
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_2", "InBlock1", "ASNO", 0 , "")
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_2", "InBlock1", "SVCD", 0 , "")
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_2", "InBlock1", "CRCD", 0 , "VND")
	DATAMANAGER.RequestTranData("obtsd_fbnk_009r_2")
End Function

'==============================================
' 환전 가능 여부 처리
'==============================================

' 미국 환전 가능여부 
' 환전가능여부(001:실시간, 002:시간외, XXX:불가)
Function Process_Tran_obtsd_fbnk_009r()	
	g_nSvcd_Chk = g_nSvcd_Chk + 1
	
	szSVCD =	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "SVCD", 0)
	g_szSvcd_USD = szSVCD

	if g_nSvcd_Chk == 3 then
		g_nSvcd_Chk = 0
		
		Init_Control(g_szGbn)
	end if
End Function


' 미국 외 환전 가능여부 조회
' 환전가능여부(001:실시간, 002:시간외, XXX:불가)
Function Process_Tran_obtsd_fbnk_009r_1()	
	g_nSvcd_Chk = g_nSvcd_Chk + 1
	
	szSVCD =	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r_1", "OutBlock1", "SVCD", 0)
	g_szSvcd_Other = szSVCD

	if g_nSvcd_Chk == 3 then
		g_nSvcd_Chk = 0
		
		Init_Control(g_szGbn)
	end if
End Function


' 베트남 환전 가능여부 조회
Function Process_Tran_obtsd_fbnk_009r_2()
	g_nSvcd_Chk = g_nSvcd_Chk + 1
	
	szYN	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r_2", "OutBlock1", "TR_ABLE_YN", 0)
	
	if szYN == "Y" then
		g_isAbleVND = true
	else
		g_isAbleVND = false
	end if

	if g_nSvcd_Chk == 3 then
		g_nSvcd_Chk = 0
		
		Init_Control(g_szGbn)
	end if
End Function

