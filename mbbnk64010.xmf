	contInput_conSendInfo_lblSelectCurrency_OnClick()
End Sub

'============================================================================
Sub contInput_conRecInfo_lblSelectAcc_OnClick()
	if g_szCurrencyCode <> "" and g_szCurrencyCode <> NULL then	
		'받는계좌가 메리츠증권인 경우, 계좌선택팝업 > 내계좌 탭
		'           메리츠증권이 아닌 경우, 계좌선택팝업 > 최근외화이체 탭 으로 이동!
		if g_szBankCode = "287" then
			szData = "2" .. "★" ..  g_szCUST_CLS_CODE
		else
			szData = "0" .. "★" ..  g_szCUST_CLS_CODE
		end if
		Form.OpenPopupAnimation("mbbnk64010_p4" , szData , "" , "2")		
	else
		Form.MsgBox( "알림", "이체 할 통화를 선택해주세요", "", 6)
		Exit Sub
	end if	
End Sub

'============================================================================
Sub contInput_conRecInfo_btnSelectBank_OnClick()

	if g_szCurrencyCode <> "" and g_szCurrencyCode <> NULL then
		'USD, JPY, HKD, CMY 통화 선택시, 타은행 선택 가능.
		if g_szCurrencyCode = "USD" or g_szCurrencyCode = "JPY" or g_szCurrencyCode = "HKD" or g_szCurrencyCode ="CNY" then
			
			'외화이체은행선택 팝업 
			szData = "287★★메리츠증권★KFBCKRSE★SelectBank★" .. g_szSendAmt
			Form.OpenPopupAnimation("mbbnk64010_p3" , szData , "" , "2")
			
		else
			Form.MsgBox("알림", "["..g_szCurrencyCode.."] 타행 이체는 영업점을\n통해 이체 가능합니다.", "", 0)			
			Exit Sub
	
		end if
	else
		Form.MsgBox( "알림", "이체 할 통화를 선택해주세요", "", 6 )
		Exit Sub
	end if
	
End Sub

'============================================================================
Sub contInput_conSendInfo_btnSendAmt_OnClick()
	if g_szCurrencyCode = "" then
		Form.MsgBox( "알림", "이체 할 통화를 선택해주세요", "", 6 )
		Exit Sub
	end if
	
	Dim szPrc, szMaxPrc
	szPrc = contInput.conSendInfo.edtSendAmt.caption
	
	if tonumber(contInput.conSendInfo.lblAbleAmt.caption) <> NULL and tonumber(contInput.conSendInfo.lblAbleAmt.caption) <> NULL then
		szMaxPrc = contInput.conSendInfo.lblAbleAmt.caption		'출금가능금액
	else
		szMaxPrc = 0
	end if
	
	'보낼금액입력키패드 팝업
	Form.OpenPopupAnimation("mbbnk64010_p0", szPrc.."★"..szMaxPrc.."★"..g_szCurrencyCode, "", "2")	
End Sub

'============================================================================
Sub contInput_conRecInfo_btnRecAcno_OnClick()
	if g_szCurrencyCode = "" then
		Form.MsgBox( "알림", "이체 할 통화를 선택해주세요", "", 6 )
		Exit Sub
	end if
	
	if g_szBankCode = "" or g_szBankCode = NULL or g_szBankCode = "287" then
		'외화이체은행선택 팝업
		Form.SetSharedData("64010_BicCode", "KFBCKRSE")
		szData = "287★★메리츠증권★KFBCKRSE★EditAcno★" .. g_szSendAmt
	else
		Form.SetSharedData("64010_BicCode", g_szBicCode)
		szData = g_szBankCode .."★★" .. g_szBankName .. "★" .. g_szBicCode .. "★EditAcno★" .. g_szSendAmt
	end if
	
	Form.OpenPopupAnimation("mbbnk64010_p3" , szData , "" , "2")
End Sub

'============================================================================
Sub contInput_conRecInfo_btnOK_OnClick()
'	''1) 이체가능시간 체크
'	''2) 출금가능금액 체크
'	''3) 고객정보등록여부 체크
'	''4) 이체한도 체크
'	''5) 당사 모계좌 잔여한도 체크
'	''6) 수취조회 정상여부 체크
'	''7) 1)~6) 모두 통과되면, 이체정보 확인(contTrans) 후 이체 실행!


	'----- obrtp_tact_109r 이체가능여부 체크 -----
	g_ProsClsCode = "3"	'처리구분코드(3.이체)
	DATAMANAGER.RequestTranData("obrtp_tact_109r")
	'----- obrtp_tact_109r 이체가능여부 체크 -----
End Sub

'============================================================================
Function f_SetBtnOKEnable()
	contInput.conRecInfo.btnOK.btnimage = "btn_15.9"
	contInput.conRecInfo.btnOK.enable = false

	'보낼금액 입력
	if contInput.conSendInfo.edtSendAmt.caption = "" or contInput.conSendInfo.edtSendAmt.caption = NULL then
		Exit Function	
	end if

	'받는은행 입력
	if contInput.conRecInfo.lblBankName.caption = "" or contInput.conRecInfo.lblBankName.caption = NULL then
		Exit Function	
	end if
	
	'받는계좌번호 입력
	if contInput.conRecInfo.edtRecAcno.caption = "" or contInput.conRecInfo.edtRecAcno.caption = NULL then
		Exit Function	
	end if

	'이체가능
	contInput.conRecInfo.btnOK.enable = true	
	contInput.conRecInfo.btnOK.btnimage = "btn_01.9"
	contInput.conRecInfo.btnOK.fgcolor = "273"
	
End Function

'============================================================================
Sub contInput_conRecInfo_imgCopy_OnClick()
	
    If szOSTYpe == "1" and Cint(szSDKVer) < 26 Then '안드로이드 구버전
        Form.ClearClipboard()
    Else
        '버튼을 눌러 계좌붙여넣기 기능을 사용한 경우 붙여넣기한 데이터의 키값을 저장
        'ConfigData의 경우 앱을 삭제하지 않는 이상 계속 유지됨.    
        Form.SaveConfigData("Banking_ClipBoard", "ClipBoardKey", g_CurrKey)
    End If

	contInput.conRecInfo.imgCopy.visible = "0"
	contInput.conRecInfo.imgCopyClose.visible = "0"
	contInput.conRecInfo.btnCopyClose.visible = "0"
	contInput.conRecInfo.lblCopyComm.visible = "0"
	contInput.conRecInfo.lblCopyAcnt.visible = "0"
	g_AcntCopyPopupYN = "0"
    
	If g_szCurrencyCode = "" or g_szCurrencyCode = NULL then
		Form.MsgBox("알림", "이체 할 통화를 선택해주세요", "", 6)
		Exit Sub
	Else
		Form.SetSharedData("64010_BicCode", g_CopyBicCode)
		Form.OpenPopupAnimation("mbbnk64010_p3", g_CopyBankCode .. "★" .. Trim(g_CopyAcnt) .. "★" .. g_CopyBankName .. "★" .. g_CopyBicCode .. "★EditAcno★" .. g_szSendAmt , "","2")
	End if
	
End Sub

'============================================================================
Sub contInput_conRecInfo_btnCopyClose_OnClick()
	
    If szOSTYpe == "1" And Cint(szSDKVer) < 26 Then '안드로이드 구버전
        Form.ClearClipboard()
    Else
        '버튼을 눌러 계좌붙여넣기 기능을 사용한 경우 붙여넣기한 데이터의 키값을 저장
        'ConfigData의 경우 앱을 삭제하지 않는 이상 계속 유지됨.    
        Form.SaveConfigData("Banking_ClipBoard", "ClipBoardKey", g_CurrKey)
    End If

    contInput.conRecInfo.imgCopy.visible = "0"
    contInput.conRecInfo.imgCopyClose.visible = "0"
    contInput.conRecInfo.btnCopyClose.visible = "0"
    contInput.conRecInfo.lblCopyComm.visible = "0"
    contInput.conRecInfo.lblCopyAcnt.visible = "0"
    g_AcntCopyPopupYN = "0"
    
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	If szTranID == "obrtp_tact_109r" then
		g_szCurrencyCode = Replace(Trim(contInput.conSendInfo.lblSelectCurrency.caption),"통화선택", "")	'통화코드
''		g_szBicCode      = Form.GetSharedData("64010_BicCode")	'BIC코드
		g_szBankAcno     = Replace(contInput.conRecInfo.edtRecAcno.caption, "-", "")	'입금계좌번호
	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "PROS_CLS_CODE"           , 0 , g_ProsClsCode)	'처리구분코드 (1.가능여부조회, 2.한도조회 , 3.이체)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "ACNO"                    , 0 , g_szACNO)	'출금계좌
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "ASNO"                    , 0 , g_szASNO)	'출금계좌

		if g_szCurrencyCode <> "" and g_szCurrencyCode <> NULL and g_szCurrencyCode <> "통화선택" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "CRCD"                , 0 , g_szCurrencyCode)	'통화코드		
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "CRCD"                , 0 , "")
		end if
		
'		if g_szBicCode <> "" and g_szBicCode <> NULL then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "BIC_CODE"            , 0 , g_szBicCode     )	'BIC코드	
'		end if
		
		if g_szBankAcno <> "" and g_szBankAcno <> NULL then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "MNRC_ACNO"           , 0 , g_szBankAcno     )	'입금계좌번호	
		end if

'		if g_szSendAmt <> "" and g_szSendAmt <> NULL and cint(g_szSendAmt) <> 0 then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "FRCR_TR_AMT"         , 0 , g_szSendAmt     )	'외화거래금액
'		end if
		
	elseif szTranID == "obrtd_fcur_002a" then
		'패스워드 암호화여부
		g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE )
		If g_PlainRm = "1" Then
			g_szACNT_PWD = contInput.edtPassword.caption
		Else
			g_szACNT_PWD = contInput.edtPassword.encdata
			if Trim(g_szACNT_PWD) == "" or Trim(g_szACNT_PWD) == null then
				g_szACNT_PWD = contInput.edtPassword.caption
			end if
		End If
		
		if g_szBankCode = "287" then	'당행
			szTACT_LNKD_ISTU_CODE = "287"
			szSVCD = "201"
		else	'타행
			szTACT_LNKD_ISTU_CODE = "702"
			szSVCD = "001"
		end if
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "TACT_LNKD_ISTU_CODE"     , 0 , szTACT_LNKD_ISTU_CODE)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "ACNO"                    , 0 , g_szACNO)	'출금계좌
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "ASNO"                    , 0 , g_szASNO)	'출금계좌
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "ACNT_PWD"                , 0 , g_szACNT_PWD)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "SVCD"                    , 0 , szSVCD)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "CRCD"                    , 0 , g_szCurrencyCode)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1" , "FRCR_TR_AMT"             , 0 , g_szSendAmt)
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2" , "BANK_CODE"               , 0 , g_szBankCode)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2" , "BIC_CODE"                , 0 , g_szBicCode)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2" , "RMT_BANK_FRCR_ACNO"      , 0 , g_szBankAcno)
		'DATAMANAGER.SetDataValue(0, szTranID, "InBlock2" , "ENG_RMT_NAME"            , 0 , g_szENG_NAME)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2" , "ENG_RMT_NAME"            , 0 , Form.GetSharedData("64010_EngRmtName"))
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2" , "RMT_RSDT_CLS_CODE"       , 0 , g_szCUST_CLS_CODE)
		
    Elseif szTranID == "obcsb_oimf_638r" Then '전자금융사기예방 고객조회

        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ELFN_ID"          , 0 , g_szUserID        )'사용자ID
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID()) 'UI단말식별키
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"             , 0 , g_szACNO          )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "SVCD"             , 0 , "100"             )
	
    End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
    If szTranID == "obrtp_tact_010r" Then
	
		g_CopyAcnt     = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "MNRC_ACNO" , 0)
		g_CopyBankCode = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "BANK_CODE" , 0)
		g_CopyBankName = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "BANK_NAME" , 0)
		g_CopyBicCode  = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "BIC_CODE"  , 0)
		
		If Trim(g_CopyAcnt) <> "" Then 
	
			If Trim(g_CopyBankCode) <> "" Then
		 
				If Trim(g_CopyBankCode) == "287" Then
					contInput.conRecInfo.lblCopyAcnt.caption = g_CopyBankName .. " " .. Left(g_CopyAcnt,4) .. "-" .. Mid(g_CopyAcnt,5,4) .. "-" .. Right(g_CopyAcnt,2)
				Else
					contInput.conRecInfo.lblCopyAcnt.caption = g_CopyBankName .. " " .. g_CopyAcnt
				End If
                 
			Else
				contInput.conRecInfo.lblCopyAcnt.caption = g_CopyAcnt
			End If
			
			If Trim(g_CopyBicCode) <> "" then
				Form.SetSharedData("64010_BicCode", g_CopyBicCode)
			End If
            
			contInput.conRecInfo.imgCopy.visible = "1"
			contInput.conRecInfo.imgCopyClose.visible = "1"
			contInput.conRecInfo.btnCopyClose.visible = "1"
			contInput.conRecInfo.lblCopyComm.visible = "1"
			contInput.conRecInfo.lblCopyAcnt.visible = "1"
			g_AcntCopyPopupYN = "1"
		End If
		
    ElseIf szTranID == "obrtp_tact_109r" then

        szComCode = DATAMANAGER.GetDataMsgCode(szTranID) 
        szComMsg = DATAMANAGER.GetDataMsgText(szTranID) 'JWH 20231113
        szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID) 'JWH 20231113
    
        dim szCustInfoCase	'고객정보확인 UI 케이스 구분하기 위함.
        szCustInfoCase = ""

        szUI_FRCR_TACT_RMNN_LIMT = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "UI_FRCR_TACT_RMNN_LIMT" , 0)	'UI외화이체잔여한도
        szUI_FRCR_TACT_T1_LIMT   = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "UI_FRCR_TACT_T1_LIMT"   , 0)	'UI외화이체1회한도
        szUI_FRCR_TACT_D1_LIMT   = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "UI_FRCR_TACT_D1_LIMT"   , 0)'UI외화이체1일한도
		
        '----- 잔여한도조회 -----
        if g_ProsClsCode = "2" then		
            contInput.conSendInfo.lblSendTotalLimit.caption = szUI_FRCR_TACT_RMNN_LIMT
            contInput.conSendInfo.lblSendOneLimit.caption = szUI_FRCR_TACT_T1_LIMT
            contInput.conSendInfo.lblSendDayLimit.caption = szUI_FRCR_TACT_D1_LIMT
        end if
        '----- 잔여한도조회 -----

        szRSPN_CODE       = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "RSPN_CODE"       , 0)	'응답코드
        szRSPN_MSG_CNTT   = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "RSPN_MSG_CNTT"   , 0)	'응답메시지내용

        g_szDPLC_CLS_CODE = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "DPLC_CLS_CODE"       , 0)	'중복구분코드
        g_szSPCI_ACNT_YN  = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "SPCI_ACNT_YN"        , 0)	'자주쓰는계좌여부

        g_szCUST_CLS_CODE = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "CUST_CLS_CODE"       , 0)	'고객구분코드
        g_szENG_NAME      = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ENG_NAME"            , 0)	'영문명
        g_szCNPL_TELNO    = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "CNPL_TELNO"          , 0)	'연락처전화번호

        if Trim(Replace(g_szCNPL_TELNO, "-" ,"")) = "" or Trim(Replace(g_szCNPL_TELNO, "-", "")) = NULL then
            g_szCNPL_TELNO = ""
        end if

        If Trim(szRSPN_CODE) == "0000" Then
            'Do Nothing
        ElseIf Trim(szRSPN_CODE) == "0003" then	'이체한도 초과(0003)인 경우에만 별도 화면으로 팝업처리함.
            '잔여한도★1회한도★1일한도★통화코드
            szData = szUI_FRCR_TACT_RMNN_LIMT.."★"..szUI_FRCR_TACT_T1_LIMT.."★"..szUI_FRCR_TACT_D1_LIMT.. "★" .. g_szCurrencyCode
            Form.OpenPopupAnimation("mbbnk64010_p6" , szData , "" , "2")
            Exit Sub
        ElseIf Trim(szRSPN_CODE) == "0001" Then
            Form.MsgBox("알림", "이체불가 계좌입니다.\n(" .. szRSPN_MSG_CNTT .. ")", "", 6)
            Exit Sub
        ElseIf Trim(szRSPN_CODE) == "0002" Then
            Form.MsgBox("알림", "사고계좌 입니다.\n(" .. szRSPN_MSG_CNTT .. ")", "", 6)
            Exit Sub
        ElseIf Trim(szRSPN_CODE) == "0004" Then 'JWH 20231114
            szData = "이체 가능시간이 아닙니다.\n(" .. szRSPN_MSG_CNTT .. ")"
            Form.MsgBox("알림" , szData , "" , 6)
            Exit Sub
        ElseIf Trim(szRSPN_CODE) == "0006" then
            Form.MsgBox("알림", "["..g_szCurrencyCode.."] 타행 이체는 영업점을\n통해 이체 가능합니다.", "", 6)
            Exit Sub
        Elseif Trim(szRSPN_CODE) == "0007" then
            Form.MsgBox("알림", "은행 조회 서비스 지연중입니다.\n영업점 또는 고객지원센터로 문의 주시기\n바랍니다.", "", 6)
            Exit Sub
        ElseIf Trim(szRSPN_CODE) == "0008" then '(개인) 영문명, 휴대전화번호 없음
            szData = g_szACNO .."★".. g_szASNO .."★A★1★★"
            Form.OpenPopupAnimation("mbbnk64010_p5" , szData , "" , "2")
            Exit Sub	    
        ElseIf Trim(szRSPN_CODE) == "0009" Then '(개인) 전화번호만 있음
            szData = g_szACNO .."★".. g_szASNO .."★B★1★★" .. g_szCNPL_TELNO
            Form.OpenPopupAnimation("mbbnk64010_p5" , szData , "" , "2")
            Exit Sub
        ElseIf Trim(szRSPN_CODE) == "0010" Then '(개인) 영문명만 있음
            szData = g_szACNO .."★".. g_szASNO .."★C★1★" .. g_szENG_NAME .. "★"
            Form.OpenPopupAnimation("mbbnk64010_p5" , szData , "" , "2")
            Exit Sub
        ElseIf Trim(szRSPN_CODE) == "0011" Then '(법인) 고객정보등록필요
            szData = g_szACNO .."★".. g_szASNO .."★D★2★★"
            Form.OpenPopupAnimation("mbbnk64010_p5" , szData , "" , "2")
            Exit Sub
	    
        ElseIf Trim(szRSPN_CODE) == "0012" Then '보안카드 미발급고객 v002
	 
            szSendData = g_szACNO & "★★N★Y"
            Form.OpenPopup("mhetc90190_p1" , szSendData , "")                
            Exit Sub
	    
        ElseIf Trim(szRSPN_CODE) == "8000" Then '서비스 OutBlock의 메시지 그대로 출력 JWH 20231116
            Form.MsgBox( "알림" , Trim(szRSPN_MSG_CNTT) , "" , 6 )
            Exit Sub
	
        ElseIf Trim(szRSPN_CODE) == "9000" Then '당사계좌수취조회 오류 시에는 바텀팝업 JWH 20231114
	    
            If Trim(szComCode) == "6690" Or Trim(szComCode) = "6660" Then
                szData = szRSPN_CODE .. "★" .. szSubMsg
            Else
                szData = szRSPN_CODE .. "★" .. Trim(szComMsg) .. "\n(" .. Trim(szSubMsg) .. ")"
            End if
		
            Form.OpenPopupAnimation("mbbnk64010_p10" , szData , "" , "2")
            Exit Sub
		
        Else 'JWH 20231114 MSGBOX 팝업 처리
	    
            If Trim(szComCode) == "6690" Or Trim(szComCode) == "6660" Then
                szData = szSubMsg
            Else
                szData = Trim(szComMsg) .. "\n(" .. Trim(szSubMsg) .. ")"
            End If
		
            Form.MsgBox( "알림" , szData , "" , 6 )
            Exit Sub
		
        End if

        if g_ProsClsCode == "3" then
		
            if CDBL(g_szSendAmt) = 0 then
                Form.MsgBox( "알림", "보낼금액을 입력해주세요.", "", 6 )
                exit sub
            end if
		
            if g_szDPLC_CLS_CODE = "Y" then
                Form.MsgBox( "알림", "당일 출금계좌, 입금계좌, 이체금액 모두\n동일하게 이체된 건이 있습니다.\n추가로 이체하시겠어요?", "TransferCheck_4", 7, "예", "아니오" )
                Exit Sub
            else
                '6) 수취인조회 확인 팝업
                '출금계좌번호★출금계좌순번★입금은행코드★입금은행계좌★입금은행BIC코드★통화코드
                szData = g_szACNO .."★".. g_szASNO .."★".. g_szBankCode .."★".. g_szBankAcno .."★".. g_szBicCode .."★".. g_szCurrencyCode .. "★" .. g_szSendAmt
                Form.OpenPopupAnimation("mbbnk64010_p7" , szData , "" , "2")			    
            end if		

        end if
	
		'----- 고객정보확인 팝업 -----

        '가능여부 조회시 확인버튼 활성화 체크
        if g_ProsClsCode = "1" then
            f_SetBtnOKEnable()
        end if

    Elseif szTranID == "obcsb_oimf_638r" Then '전자금융사기예방 고객조회
		
        g_szGubunCode = Trim(DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "SCRC_OTP_CLS_CODE" , 0)) '보안매체유형

        Select Case g_szGubunCode
	
            Case "1"
                Form.MsgBox("알림" , "부가정보만 존재할경우 처리가 불가능합니다." , "" , 6)
            Case "2"	
                szSendData = g_szACNO & "★★N★Y"
                Form.OpenPopup("mhetc90190_p1" , szSendData , "") 'v002
            Case "9"
                Form.MsgBox("알림" , "기타오류가 발생했습니다." , "" , 6)
            Case "0"
                Form.OpenPopupAnimation("seccardcheckpopup" , " " , "" , "2") '공인인증서_보안카드화면
            Case "3"
                f_OTP_Tr_Auth_Msg_Create() '토큰형OTP/스마트OTP Input값 입력
                Form.OpenPopupAnimation("otpcheckpopup" , " " , "" , "2") '공인인증서_일반/스마트OTP
            Case "4"
                Form.OpenPopupAnimation("otpcheckpopup" , " " , "" , "2") '공인인증서_mOTP
		
        End Select

	Elseif szTranID == "obrtd_fcur_002a" then
	
		szTR_SRNO 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_SRNO" , 0)
		szRCPY_SRNO 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RCPY_SRNO" , 0)
		szFRCR_TFAM_PRRM	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FRCR_TFAM_PRRM" , 0)
		szFRCR_TFAM_NWRM	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FRCR_TFAM_NWRM" , 0)
		szACRCD  		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CRCD" , 0)

		
		''외화이체 이체완료 팝업
		' 당사대체인 경우는 수취인 한글명, 타사대체인 경우는 수취인 영문명으로 보여줌.(수취인조회할때 Shared 값으로 보여줌)
		'S★출금계좌★출금계좌순번★출금후잔액★수취영문명★이체금액★통화코드★수신은행코드★BIC코드★은행계좌★은행명★자주쓰는계좌여부★수수료★에러메시지
		g_szSendData = "S★" .. g_szACNO .. "★" .. g_szASNO .. "★" .. szFRCR_TFAM_NWRM  .. "★" .. g_szSendAmt .. "★" .. g_szCurrencyCode  .. "★" .. 
						g_szBankCode .. "★" .. g_szBicCode .. "★" .. g_szBankAcno .. "★" .. g_szBankName  .. "★" .. Form.GetSharedData("64010_EngRmtName").. "★" .. 
						g_szSPCI_ACNT_YN .. "★" .. g_szFee .."★이체완료"
		Form.OpenPopup("mbbnk64010_p8" , g_szSendData , "")
		Exit Sub
	
	End if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = Trim(DATAMANAGER.GetDataMsgSubText( szTranID ))
	
	If szTranID == "obrtd_fcur_002a" then		
		szErrMsg = szErrMsg .. "☆" .. szSubErr
		
		''외화이체 이체불가 팝업
		'F★출금계좌★출금계좌순번★출금후잔액★이체금액★통화코드★수신은행코드★BIC코드★은행계좌★은행명★수취영문명★자주쓰는계좌여부★수수료★에러메시지
		g_szSendData = "F★" .. g_szACNO .. "★" .. g_szASNO .. "★" .. 0  .. "★" .. g_szSendAmt .. "★" .. g_szCurrencyCode  .. "★" .. 
						g_szBankCode .. "★" .. g_szBicCode .. "★" .. g_szBankAcno .. "★" .. g_szBankName  .. "★" .. Form.GetSharedData("64010_EngRmtName") .. "★" .. 
						g_szSPCI_ACNT_YN .. "★" .. g_szFee .. "★" .. szErrMsg
		
		Form.OpenPopup("mbbnk64010_p8" , g_szSendData , "")
		Exit Sub

	ElseIf szSubErr == "" Then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
		
	Else
		Form.MsgBox( "알림", szErrMsg.."\n("..szSubErr..")", "", 6 )
		
	End If
End Sub


'============================================================================
Sub f_OTP_Tr_Auth_Msg_Create()

	szOtpTrAuthMsgCntt = "" '초기화
	
	'입금은행명#입금계좌#수취인명#금액#
	szOtpTrAuthMsgCntt = szOtpTrAuthMsgCntt .. g_szBankName .. "#" .. g_szBankAcno .. "#" .. Form.GetSharedData("64010_EngRmtName") .. "#" .. FormatNumber(g_szSendAmt, g_szDecimal).. g_szCurrencyCode .."#"

	Form.SetSharedData("OTP_TR_AUTH_MSG" , szOtpTrAuthMsgCntt)
	
End Sub

'============================================================================
Sub f_CheckBioCert() '인증 팝업 호출

    If g_szCertUserType == "1" Then '간편비번 only
        Form.OpenPopup("mhetc90060_px", "", "")
        Exit Sub
    End If

    If g_szCertUserType == "0" Or g_szCertUserType == "3" Or g_szCertUserType == "4" Or g_szCertUserType == "5" Then '바이오, 공동인증, 사설인증
    
        szBIO_TR_CODE = "1"        '바이오거래유형코드   0: 인증 1: 서명 
        szATHN_USAG_CLS_CODE = "0" '서명데이터 생성여부
		
        szTRMsg = "이체예정내역\n" & "입금기관:" & g_szBankName & "\n" & "입금계좌:" & g_szBankAcno & "\n" & "예금주명:" & g_szBankAcntNm & "\n" & "이체금액:" & FormatNumber(g_szSendAmt, g_szDecimal).. g_szCurrencyCode
	
        If g_szCertUserType = "3" Then '바이오
            szData = "BIO_trType★"& szBIO_TR_CODE  &"★"&  szTRMsg &"★"& szATHN_USAG_CLS_CODE 
        ElseIf g_szCertUserType = "4" Then '바이오
            szData = "BCHAIN_trType★"& szBIO_TR_CODE  &"★"&  szTRMsg &"★"& szATHN_USAG_CLS_CODE 
        ElseIf g_szCertUserType = "5" Then '사설인증
            szData = "ATON_trType★"& szTRMsg 	
        Else
            szData = ""
        End If
	
        Form.OpenFramePopup("mhetc90060_p5" , szData , "")
        Exit Sub
	
    End If 
    
End Sub


'============================================================================
Sub contTrans_imgCheck_OnClick()
	contTrans_lblCheck_OnClick()
End Sub

'============================================================================
Sub contTrans_lblCheck_OnClick()
	if g_TransAgreeYN = "Y" then
		g_TransAgreeYN = "N"
		
		contTrans.imgCheck.imgpath = "checkmenu_n.png"
			
		contTrans.btnTrans.btnimage = "btn_15.9"
		contTrans.btnTrans.enable = false
	else
		g_TransAgreeYN = "Y"
		
		contTrans.imgCheck.imgpath = "checkmenu_o.png"
			
		contTrans.btnTrans.enable = true
		contTrans.btnTrans.btnimage = "btn_01.9"
		contTrans.btnTrans.fgcolor = "273"

	end if
End Sub

'============================================================================
Sub contTrans_btnTrans_OnClick()
		
	' 정상이면..
	'  1) 당사 이체인 경우, 계좌비밀번호만 인증 후 이체 완료
	'  2) 타행 이체인 경우, 계좌비밀번호 확인 + 보안매체 인증 후 인증서 인증 후 이체 완료.
	szData = g_szACNO .. g_szASNO .. "☆" .. "0"
	Form.openPopupAnimation("pwdcheckpopup", szData ,"","2")
	
End Sub

'============================================================================
Sub contTrans_btnCancel_OnClick()
	'외화이체 첫 화면으로 이동
	contTrans.visible = false
	contInput.visible = true
	
	Form.OpenScreen("64010", "")
End Sub

'============================================================================
Function f_GetCurrencyImage(CurrencyCode)

	'통화코드별 이미지
	if CurrencyCode = "USD" then		'미국
		szImageName = "flag_us2.png"		
	elseif CurrencyCode = "JPY" then	'일본
		szImageName = "flag_jp2.png"
	elseif CurrencyCode = "HKD" then	'홍콩
		szImageName = "flag_hk.png"
	elseif CurrencyCode = "CNY" then	'중국
		szImageName = "flag_chn.png"
	elseif CurrencyCode = "EUR" then	'유로화
		szImageName = "flag_eu.png"
	elseif CurrencyCode = "GBP" then	'영국
		szImageName = "flag_uk.png"
	elseif CurrencyCode = "AUD" then	'호주
		szImageName = "flag_aus.png"
	elseif CurrencyCode = "SGD" then	'싱가폴
		szImageName = "flag_sgp.png"
	elseif CurrencyCode = "CAD" then	'캐나다
		szImageName = "flag_can.png"
	elseif CurrencyCode = "CHF" then	'스위스
		szImageName = "flag_swi.png"
	else
		szImageName = "flag_general.png"
	end if
	
	return szImageName
	
End Function

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("64010_BicCode", "")	
	Form.SetSharedData("64010_SpciAcntYN", "")	
	Form.SetSharedData("64010_EngName", "")		'obrtp_tact_109r에서 조회된 영문명
	Form.SetSharedData("64010_EngRmtName", "")	'수취인조회에서 최종 확인된 영문명
	Form.SetSharedData("64010_CnplTelNo", "")	
	Form.SetSharedData("64010_Fee", "")
	
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y") '안드로이드 뒤로가기 동작 활성화

End Sub

'============================================================================
Sub ImgBackPress_OnClick()

	if g_nStep == 2 then
		''이체 확인페이지에서 뒤로가기 버튼 선택시
		''외화이체 첫 화면으로 이동
		contTrans.visible = false
		contInput.visible = true
		
		Form.OpenScreen("64010", "")
	else
		Form.openPrevScreen()
		'Form.CloseForm()
	end if
End Sub

'============================================================================
Sub contInput_conSendInfo_imgToolTip_OnClick()
	szToolTipText = "타행 이체 시 USD, JPY, HKD, CNY 통화에\n한해 한도 제한이 있으며, 당사 대체 시에는\n한도 제한이 없어요."
	
	contInput.conSendInfo.imgTooltip.openToolTip(szToolTipText, 290, 90, 2)
End Sub

'============================================================================
Sub contInput_conSendInfo_btnTooTip_OnClick()
	contInput_conSendInfo_imgToolTip_OnClick()
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()

    szBackPressEnable = Form.GetSharedData("&BACK_PRESS_ENABLE", False) '뒤로가기 버튼 활성화상태 체크 (이체정보확인 단계에서 비활성화)
    If szBackPressEnable == "N" And g_nStep == 2 Then '안드로이드 뒤로가기를 눌렀으면
		''이체 확인페이지에서 뒤로가기 버튼 선택시
		''외화이체 첫 화면으로 이동
		contTrans.visible = false
		contInput.visible = true
		
		Form.OpenScreen("64010", "")
    Else
        Form.CloseForm()
    End If
    
End Sub

