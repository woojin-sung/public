Sub contInput_conSendInfo_lblSelectCurrency_OnClick()
	
	'이체가능보유통화 팝업
	szData = g_szACNO .. "★" .. g_szASNO .. "★" .. g_szCurrencyCode
	Form.OpenPopupAnimation("mbbnk64010_p2" , szData , "" , "2")
	
End Sub

