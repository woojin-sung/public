'============================================================================
' 화 면 명 : 외화이체 메인
' 20240201 v001 장원혁 : 고객구분코드 전달
' 20240320 v002 장원혁 : 보안카드 미발급고객 안내팝업호출
'============================================================================

Dim g_PlainRm
Dim g_szSeparator
Dim g_OSType

Dim g_szUserID
Dim g_szCertUserType

Dim g_szACNO
Dim g_szASNO
Dim g_szACNT_PWD

Dim g_szBankCode
Dim g_szBankName
Dim g_szBankAcno
Dim g_szBankAcntNm
Dim g_szBicCode

Dim g_szDPLC_CLS_CODE
Dim g_szSPCI_ACNT_YN

Dim g_szCUST_CLS_CODE
Dim g_szENG_NAME
Dim g_szCNPL_TELNO

Dim g_szDecimal

Dim g_szSendAmt
Dim g_szFee
Dim g_szCurrencyCode

Dim g_ExKey
Dim g_CurrKey
Dim g_ClipBoard '괴롭다
Dim g_prevClipBoard
Dim g_AcntCopyPopupYN

Dim g_CopyAcnt
Dim g_CopyBankCode
Dim g_CopyBankName
Dim g_CopyBicCode

Dim g_ProsClsCode

Dim g_nStep
Dim g_TransAgreeYN


'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.setMaintainingRatio("1")
	imgInfo.setMaintainingRatio("1")
	
	contInput.conSendInfo.imgToolTip.setMaintainingRatio("1")	
	contInput.conSendInfo.imgCurrency.setMaintainingRatio("1")
	contInput.conSendInfo.imgSelectCurrency.setMaintainingRatio("1")
	
	contInput.conRecInfo.imgLogo2.setMaintainingRatio("1")

	contTrans.imgLogo.setMaintainingRatio("1")
	contTrans.imgCheck.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()

	contInput.conRecInfo.lblSelectAcc.caption = "계좌선택 >"
	contInput.conRecInfo.lblSelectAcc.fgcolor = "67"
	
	g_OSType = Form.GetSharedData("&OS_TYPE", false )	'1.안드로이드 2.iOS
	
	contInput.conRecInfo.btnOK.btnimage = "btn_15.9"
	contInput.conRecInfo.btnOK.enable = false

	f_InitValue()
		
	'이체가능 계좌 없는 경우 오작동 방지하기 위함.
	if Trim(contInput.cmbAccount.caption) = "" or Trim(contInput.cmbAccount.caption) = NULL then
		contInput.btnAlpha.visible = true
		contInput.btnAlpha.left = 0
		Exit Sub
	end if
	
	'----- obrtp_tact_109r 이체가능여부 체크 -----
	g_ProsClsCode = "1"	'처리구분코드(1.가능여부조회)
	DATAMANAGER.RequestTranData("obrtp_tact_109r")
	'----- obrtp_tact_109r 이체가능여부 체크 -----
	
	'''통화 선택된 상태에서만 복사한 계좌 이체가능하도록 하려고 통화 선택한 다음으로 위치 이동!
	'''Form.SetTimerEvent(4444, 1, 1)
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

    g_szDecimal = 2

    If sKeyName == "mbbnk61140_fin" Then
        f_InitValue()
    End If
	
	if sKeyName == "mbbnk64010_p2" then	'//이체가능보유통화 팝업
		if sRet = "close" then
			Exit Sub
		End if
		
		'입력된 데이터 초기화..
		f_InitValue()
		
		arrBankInfo = Split(sRet, g_szSeparator)
		
		g_szCurrencyCode = arrBankInfo(0)
		g_szAbleAmt      = arrBankInfo(1)
		
		Form.SetSharedData("64010_CurrencyCode", g_szCurrencyCode)	''mbbnk64010_p3 에서 타행이체 불가 구분하기 위함.
	
		'통화코드랑 이미지 셋팅하고..
		contInput.conSendInfo.imgCurrency.visible = true
		contInput.conSendInfo.imgCurrency.imgpath = f_GetCurrencyImage(g_szCurrencyCode)
		
		contInput.conSendInfo.lblSelectCurrency.left = 60
		contInput.conSendInfo.lblSelectCurrency.caption = g_szCurrencyCode
		
		contInput.conSendInfo.imgSelectCurrency.left = 100
		

		'출금가능금액 마스킹표시.
		contInput.conSendInfo.lblAbleAmt.caption = g_szAbleAmt
		
		sMask = "0,0,,,1,,"..g_szDecimal..",1,0,0,0"
		contInput.conSendInfo.lblAbleAmt.mask = sMask
		
		if g_szCurrencyCode = "USD" or g_szCurrencyCode = "JPY" or g_szCurrencyCode = "HKD" or g_szCurrencyCode ="CNY" then
			Form.SetSharedData("64010_OutTransYN", "Y")	'타행가능통화
			
			'----- 잔여한도 표시 -----
			contInput.conSendInfo.lblAlert.visible = false
			
			contInput.conSendInfo.Label3.visible = true
			contInput.conSendInfo.Label4.visible = true
			contInput.conSendInfo.Label5.visible = true
			
			contInput.conSendInfo.lblSendTotalLimit.visible = true
			contInput.conSendInfo.lblSendOneLimit.visible = true
			contInput.conSendInfo.lblSendDayLimit.visible = true
			
			contInput.conSendInfo.lblSendLine.visible = true
			contInput.conSendInfo.lblSendLine2.visible = true
			'----- 잔여한도 표시 -----
			
			
			'----- obrtp_tact_109r 이체가능여부 체크 -----
			g_ProsClsCode = "2"	'처리구분코드(2.한도조회)
			DATAMANAGER.RequestTranData("obrtp_tact_109r")
			'----- obrtp_tact_109r 이체가능여부 체크 -----
			
		else
			Form.SetSharedData("64010_OutTransYN", "N")	'타행불가통화
			
			'----- 잔여한도 표시 -----
			contInput.conSendInfo.lblAlert.visible = true
			contInput.conSendInfo.lblAlert.caption = g_szCurrencyCode .. " 통화는 당사 본인 계좌로만\n한도 제한 없이 이체 가능해요."
			
			contInput.conSendInfo.Label3.visible = false
			contInput.conSendInfo.Label4.visible = false
			contInput.conSendInfo.Label5.visible = false
			
			contInput.conSendInfo.lblSendTotalLimit.visible = false
			contInput.conSendInfo.lblSendOneLimit.visible = false
			contInput.conSendInfo.lblSendDayLimit.visible = false
			
			contInput.conSendInfo.lblSendLine.visible = false
			contInput.conSendInfo.lblSendLine2.visible = false
			'----- 잔여한도 표시 -----
			
		end if
		
		contInput.conRecInfo.btnOK.enable = false
		Form.SetTimerEvent(4444, 1, 1)
		
	Elseif sKeyName == "mbbnk64010_p0" then	'//금액입력키패드 팝업
		g_szSendAmt = sRet
		contInput.conSendInfo.edtSendAmt.caption = g_szSendAmt
		
		sMask = "0,0,," .. " " ..g_szCurrencyCode .. ",1,,"..g_szDecimal..",1,0,0,0"
		contInput.conSendInfo.edtSendAmt.mask = sMask
				
		'----- obrtp_tact_109r 이체가능여부 체크 -----
		g_ProsClsCode = "1"	'처리구분코드(1.가능여부조회)
		DATAMANAGER.RequestTranData("obrtp_tact_109r")
		'----- obrtp_tact_109r 이체가능여부 체크 -----
	
	ElseIf sKeyName == "mbbnk64010_p3" Then	'//이체은행&계좌번호선택 팝업		
		arrBankInfo = Split(sRet, g_szSeparator)
		g_szBankCode    = arrBankInfo(0)
		g_szBankAcno    = arrBankInfo(1)
		g_szBankName    = arrBankInfo(2)
		g_szBankAcntNm  = arrBankInfo(3)
		g_szBicCode     = Form.GetSharedData("64010_BicCode")

		contInput.conRecInfo.imgLogo2.imgpath =  "bank"..g_szBankCode..".png"
		contInput.conRecInfo.lblBankName.caption = g_szBankName
		if g_szBankCode = "287" then
			contInput.conRecInfo.edtRecAcno.caption = Left(g_szBankAcno,4).."-"..Mid(g_szBankAcno,5,4).."-"..Right(g_szBankAcno,2)
		else
			contInput.conRecInfo.edtRecAcno.caption = g_szBankAcno
		end if
				
		'----- obrtp_tact_109r 이체가능여부 체크 -----
		g_ProsClsCode = "1"	'처리구분코드(1.가능여부조회)
		DATAMANAGER.RequestTranData("obrtp_tact_109r")
		'----- obrtp_tact_109r 이체가능여부 체크 -----
	
	Elseif sKeyName == "mbbnk64010_p4" then	'//계좌선택 팝업		
		arrBankInfo = Split(sRet, g_szSeparator)
		g_szBankCode = arrBankInfo(0)
		g_szBankAcno = arrBankInfo(1)
		g_szBankName = arrBankInfo(2)
		g_szBicCode  = arrBankInfo(3)

		contInput.conRecInfo.imgLogo2.imgpath =  "bank"..g_szBankCode..".png"
		contInput.conRecInfo.lblBankName.caption = g_szBankName
		if g_szBankCode = "287" then
			contInput.conRecInfo.edtRecAcno.caption = Left(g_szBankAcno,4).."-"..Mid(g_szBankAcno,5,4).."-"..Right(g_szBankAcno,2)
		else
			contInput.conRecInfo.edtRecAcno.caption = g_szBankAcno
		end if
				
		'----- obrtp_tact_109r 이체가능여부 체크 -----
		g_ProsClsCode = "1"	'처리구분코드(1.가능여부조회)
		DATAMANAGER.RequestTranData("obrtp_tact_109r")
		'----- obrtp_tact_109r 이체가능여부 체크 -----
	
	Elseif sKeyName == "mbbnk64010_p5" then	'//고객정보확인 팝업	
		if sRet = "OK" then		
		    g_ProsClsCode = "3"	'처리구분코드(1.가능여부조회)
		    DATAMANAGER.RequestTranData("obrtp_tact_109r")		    
		Else	' "Cancel"
			Exit Sub
		End If
		
	ElseIf sKeyName == "mbbnk64010_p6" Then '//이체한도 초과시 팝업
		if sRet = "N" then
			Exit Sub
		end if
	
	ElseIf sKeyName == "mbbnk64010_p7" Then '//수취인조회 팝업
		if sRet = "Y" then	'본인확인완료
			
			contInput.visible = false
			g_nStep = 2
			Form.SetSharedData("&BACK_PRESS_ENABLE" , "N") '안드로이드 뒤로가기 동작 비활성화
			
			contTrans.visible = true
			
			''이체정보 확인
			contTrans.lblTransInfo1.SetMaxLineCount(1)	'컨트롤 라인 제한 함수
			if g_OSType = "2" then
				contTrans.lblTransInfo1.SetSizeToFitTextSkip(true)
			end if
			'수취인명 긴 경우, 폰트 사이즈 줄임
			if Len(Form.GetSharedData("64010_EngRmtName")) > 20 then
				contTrans.lblTransInfo1.fontsize = 4
				contTrans.lblTransInfo1.width = 280
				contTrans.lblTransInfo1.caption = Form.GetSharedData("64010_EngRmtName")
				contTrans.lblTransInfo3.visible = true
				contTrans.lblTransInfo2.caption = FormatNumber(g_szSendAmt, g_szDecimal)
			else	
				contTrans.lblTransInfo1.caption = Form.GetSharedData("64010_EngRmtName") .. " 님에게"
				nStaOffset = contTrans.lblTransInfo1.getLen(contTrans.lblTransInfo1.caption)
				contTrans.lblTransInfo1.changeTextAttr(0, (nStaOffset-4), 4, 6, True)
			end if
			
			contTrans.lblTransInfo2.caption = FormatNumber(g_szSendAmt, g_szDecimal) .. g_szCurrencyCode .." 를 보내시겠어요?"
			nStaOffset2 = contTrans.lblTransInfo2.getLen(contTrans.lblTransInfo2.caption)' -9
			contTrans.lblTransInfo2.changeTextAttr(0, (nStaOffset2-9), 4, 6, True)
			
			contTrans.imgLogo.imgpath = "bank"..g_szBankCode..".png"
			
			If g_szBankCode == "287" Then
			    contTrans.lblBankName.caption = "메리츠증권 "..Left(g_szBankAcno,4).."-"..Mid(g_szBankAcno,5,4).."-"..Right(g_szBankAcno,2)
			    
			    '당행 이체는 거주자확인 체크 안하고 이체 가능!
			    contTrans.lblLine.visible = false			    
			    contTrans.imgCheck.visible = false
			    contTrans.lblCheck.visible = false
				
				contTrans.btnTrans.enable = true
				contTrans.btnTrans.btnimage = "btn_01.9"
				contTrans.btnTrans.fgcolor = "273"
			Else
			    contTrans.lblBankName.caption = g_szBankName.." "..g_szBankAcno
			    contTrans.lblLine.visible = true
			    contTrans.imgCheck.visible = true
			    contTrans.lblCheck.visible = true
			End If
			
			contTrans.lblAccNo.caption = Left(g_szACNO,4).."-"..Right(g_szACNO,4).."-"..g_szASNO
			g_szFee = Form.GetSharedData("64010_Fee")
			if cint(g_szFee) = 0 then
				contTrans.lblFee.caption = "무료"
			else
				contTrans.lblFee.caption = FormatNumber(g_szFee, 0)
			end if
			'contTrans.lblEngNm.caption = Form.GetSharedData("64010_EngRmtName")	'g_szENG_NAME
			contTrans.lblEngNm.caption  = g_szENG_NAME
			contTrans.lblCellNo.caption = g_szCNPL_TELNO
			
		else
			Exit Sub
		end if
		
	ElseIf sKeyName == "CORRECT_PWD" Then '//계좌비밀번호
	    if sRet <> "" then    ' 정상이면..
			Dim tData
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				contInput.edtPassword.pwdlen = tData(1)
				contInput.edtPassword.caption = tData(0)
				
'				g_szACNT_PWD = contInput.edtPassword.caption
					
				if g_szBankCode = "287" then
				    '당사 이체인 경우, 계좌비밀번호만 인증 후 이체 완료
					DATAMANAGER.RequestTranData("obrtd_fcur_002a")
			    else
				    '타행 이체인 경우, 계좌비밀번호 확인 & 보안매체 인증 후 인증서 인증 후 이체 완료.
				    DATAMANAGER.RequestTranData("obcsb_oimf_638r")
			    end if
			end if
		end if
		
    ElseIf sKeyName == "보안카드" Or sKeyName == "OTP" Then
    
		If sRet == "Success" Then
			f_CheckBioCert()
		Else
			contInput.btnBuy.enable = false
			Exit Sub
		End If

	ElseIf sKeyName == "mhetc90060_p5" Or sKeyName == "mhetc90060_px" then	'//공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" or sRet == "ok" then		'성공
			if g_szBankCode <> "287" then
				'타행 외화이체 실행
				DATAMANAGER.RequestTranData("obrtd_fcur_002a")
			end if
		else						'실패
			contInput.btnBuy.enable = false
			Exit Sub
		end if
		
	ElseIf sKeyName == "mbbnk64010_p8" Then '//이체완료 페이지
		if sRet = "63030" then
			Form.OpenScreen("63030", "")
			Form.CloseForm()
		else
			Form.OpenScreen("64010", "")
			Form.CloseForm()
		end if
	End if
		
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName = "TransferCheck_4" then
		if sRet = "ok" then	'당일 동일한 건 중복 이체시.. 수취인 조회부터 확인.
			''6) 수취인조회 확인 팝업
			'출금계좌번호★출금계좌순번★입금은행코드★입금은행계좌★입금은행BIC코드★통화코드
			szData = g_szACNO .."★".. g_szASNO .."★".. g_szBankCode .."★".. g_szBankAcno .."★".. g_szBicCode .."★".. g_szCurrencyCode .. "★" .. g_szSendAmt
			Form.OpenPopupAnimation("mbbnk64010_p7" , szData , "" , "2")	

		else 'no		'아니오
			Exit Sub
		end if		
	End If
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
    If Trim(sTimerID) == "4444" Then
       
        Form.SetTimerEvent(4444, 0, 1)
	
        If g_AcntCopyPopupYN == "0" Then
	    
			'통화 선택된 상태에서만 복사한 계좌 이체가능하도록!
		    if g_szCurrencyCode <> "" and g_szCurrencyCode <> NULL then

				If szOSTYpe == "1" and Cint(szSDKVer) < 26 then '구버전 안드로이드
			    
					If Trim(g_ClipBoard) <> "" Then
						g_ClipBoard = Form.getClipboardText()
						DATAMANAGER.SetDataValue(0, "obrtp_tact_010r" , "InBlock1" , "INPUT_CNTT" , 0 , Trim(g_ClipBoard))
						DATAMANAGER.RequestTranData("obrtp_tact_010r")	    
					End If
			    
			    Else
			    
					'LoadConfigData : 직전 계좌붙여넣기 했던 데이터의 키값
					g_ExKey = Form.LoadConfigData("Banking_ClipBoard", "ClipBoardKey")
					g_CurrKey = Form.getClipboardKey()
					
					If Cstr(g_ExKey) <> Cstr(g_CurrKey) Then
						g_ClipBoard = Form.getClipboardText()
						DATAMANAGER.SetDataValue(0, "obrtp_tact_010r" , "InBlock1" , "INPUT_CNTT" , 0 , Trim(g_ClipBoard))
						DATAMANAGER.RequestTranData("obrtp_tact_010r")
					End If
			    
			    End If
			    
			End If
	    
	    End If
		
	end if

End Sub

'============================================================================
Sub imgInfo_OnClick()
	Form.OpenPopup("mbbnk64010_p1", "", "")
End Sub

'============================================================================
Sub Form_OnRefresh()
	
    Form.SetTimerEvent(4444, 1, 1)
	
End Sub

'============================================================================
Sub f_InitValue()

	g_szSeparator = "★"
	
	g_szUserID       = Form.GetSharedData("&USER_ID"   , False) '고객아이디
	g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
	
	g_szACNO = contInput.cmbAccount.total
	g_szASNO = contInput.cmbAccount.sequence
	g_szACNT_PWD = ""
	
	g_nStep = 1
	
	g_szBankCode = "287"
	g_szBankName = "메리츠증권"
	g_szBankAcno = ""
	g_szBankAcntNm = ""
'	g_szBicCode = ""
	g_szBicCode = "KFBCKRSE" 'JWH 20231114 Null 에서 KFBCKRSE로 변경
	
	g_szSPCI_ACNT_YN = "N"
	
	g_szDecimal = 2
	g_szCurrencyCode = ""
	g_szSendAmt = 0
	g_szFee = 0
	
	g_ExKey = ""
	g_CurrKey = ""
	g_ClipBoard = ""
	g_prevClipBoard = ""
	
	g_AcntCopyPopupYN = "0"
    
    f_Init_contInput()
    
    f_Init_contTrans()
End Sub

