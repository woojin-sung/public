	contInput.conSendInfo.Label3.visible = true
	contInput.conSendInfo.Label4.visible = true
	contInput.conSendInfo.Label5.visible = true
	
	contInput.conSendInfo.lblSendTotalLimit.visible = true
	contInput.conSendInfo.lblSendOneLimit.visible = true
	contInput.conSendInfo.lblSendDayLimit.visible = true
	
	contInput.conSendInfo.lblSendLine.visible = true
	contInput.conSendInfo.lblSendLine2.visible = true
	
	contInput.conSendInfo.lblAbleAmt.caption = "0"	
	contInput.conSendInfo.lblSendTotalLimit.caption = "0"
	contInput.conSendInfo.lblSendOneLimit.caption = "0"	
	contInput.conSendInfo.lblSendDayLimit.caption = "0"
	contInput.conSendInfo.edtSendAmt.caption = ""
	
	'받는계좌 초기화
	contInput.conRecInfo.imgLogo2.imgpath =  "bank"..g_szBankCode..".png"
	contInput.conRecInfo.lblBankName.caption = g_szBankName
	contInput.conRecInfo.edtRecAcno.caption = g_szBankAcno	

'	'확인버튼 초기화
'	contInput.conRecInfo.btnOK.btnimage = "btn_15.9"
'	contInput.conRecInfo.btnOK.enable = false
	
End Sub

'============================================================================
Sub f_Init_contTrans()

	g_TransAgreeYN = "N"
	
	contTrans.lblTransInfo1.caption = ""
	contTrans.lblTransInfo2.caption = ""	
	
	contTrans.lblAccNo.caption = ""
	contTrans.lblFee.caption = ""	
	contTrans.lblEngNm.caption = ""
	contTrans.lblCellNo.caption = ""
	
