	<SCRIPT_INFO _len="9251" _ulen="8873" >
'============================================================================
' 01.화면명 	: 펀드자동이체
' 02.화면설명	: 펀드자동이체 이체신청탭
'============================================================================
' v001 : 정우희 : 2024.07.22 자동이체 적정(적합)성 원칙 적용
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szData		'
Dim g_szList		'
Dim g_szCustNum	'고객번호
Dim szData		'전달데이터
Dim g_szNextData	'Next 조회시 변수
Dim g_IRow

'============================================================================
'							FORM 함수
'============================================================================
Sub Form_OnFormInitBefore()
	grd0.SetMaintainingRatio("bd_type", 0, "1")	
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_szNextData = 0
	grd0.SetCellMaxLineCount("KOR_ISNM",2)
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	g_szNextData = 0
	grd0.SetClear()
	
	if sEventName == "mbfnp51020_t2" then
		g_szData = sParam
	end if
	
	g_szList = Split(g_szData, "★")
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
	
	DATAMANAGER.RequestTranData("obsai_deal_082r")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	' 투자숙려제도 안내 팝업 리턴
	if sKeyName = "mbfnp51020_p4" then
		if sRet = "CANCEL" then
			szData = g_szData & "★" & grd0.GetCellData("RMND_SRNO", g_IRow) & "★" & grd0.GetCellData("ISCD", g_IRow) & "★" & grd0.GetCellData("KOR_ISNM", g_IRow)
			
			Form.OpenPopup("mbfnp51020_p3", szData, sPosInfo)
		else
			Form.OpenScreen("55007", "")
			
		end if
	
	' 자동이체 신청 완료 리턴
	elseif sKeyName = "mbfnp51020_p3" then

		if sRet == "CONPLETE" then
			g_szNextData = 0
			DATAMANAGER.RequestTranData("obsai_deal_082r")
		end if
		
	end if
	
End Sub

'============================================================================
'						DATAMANAGER 함수
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obsai_deal_082r" then
		DATAMANAGER.SetDataValue(0 , "obsai_deal_082r", "InBlock1", "ACNO" , 		0, g_szList(0))	'계좌번호
		DATAMANAGER.SetDataValue(0 , "obsai_deal_082r", "InBlock1", "ASNO" , 		0, g_szList(1))	'일련번호
		DATAMANAGER.SetDataValue(0 , "obsai_deal_082r", "InBlock1", "ACNT_STAT_CODE",	0, "R" )			'계좌상태코드 R:숙려포함 v0002
		DATAMANAGER.SetDataValue(0 , "obsai_deal_082r", "InBlock1", "RMND_RFLC_YN",	0, 0 )
		DATAMANAGER.SetDataValue(0 , "obsai_deal_082r", "InBlock1", "KOR_ISNM",		0, "%" )
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim Temp
	dim szOrgWay, szTransWay

	if szTranID == "obsai_deal_082r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(0 , "obsai_deal_082r", "OutBlock1")

		if CInt(nCnt) > 0 then
			Label0.visible	= false
			Image0.visible	= false
			grd0.visible		= true
		else
			Label0.visible	= true
			Image0.visible	= true
			grd0.visible		= false
		end if
		
		for i = 0 to nCnt - 1
			TACT_AMT = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TACT_AMT", i)
			szOrgWay		= ""
			szTransWay	= ""
			szOrgWay		= DATAMANAGER.GetDataValue( 0 , "obsai_deal_082r", "OutBlock1", "IISC_SVNG_TYPE_CODE" , i)
			grd0.SetCellData("BAR1", 	g_szNextData, "|")
			grd0.SetCellData("BUTTON0",	g_szNextData, "펀드 정보")
			
			if CInt(TACT_AMT) > 0 then
				grd0.SetCellData("BUTTON1",	g_szNextData, "신청 내역")
			else
				grd0.SetCellData("BUTTON1",	g_szNextData, "자동이체 신청")
			end if

			VLTN_PRLS_AMT	= grd0.GetCellData("VLTN_PRLS_AMT",	g_szNextData)
			ERT 			= grd0.GetCellData("ERT", 			g_szNextData)
			
			if CDBL(VLTN_PRLS_AMT) > 0 then
				szPrls = "+"..FormatNumber(VLTN_PRLS_AMT, 0).."원 | +"..FormatNumber(ERT, 2).."%"
				grd0.SetCellData("PRLS", g_szNextData, szPrls)
				grd0.SetCellFgColor("PRLS",	g_szNextData, 10)
			elseif CDBL(VLTN_PRLS_AMT) < 0 then
				szPrls = FormatNumber(VLTN_PRLS_AMT, 0).."원 | "..FormatNumber(ERT, 2).."%"
				grd0.SetCellData("PRLS", g_szNextData, szPrls)
				grd0.SetCellFgColor("PRLS",	g_szNextData, 11)
			else
				szPrls = FormatNumber(VLTN_PRLS_AMT, 0).."원 | "..FormatNumber(ERT, 2).."%"
				grd0.SetCellData("PRLS", g_szNextData, szPrls)
				grd0.SetCellFgColor("PRLS",	g_szNextData, 12)
			end if
			
			grd0.SetCellFgColor("PSNT_RMND_ACNU", g_szNextData, 110)
			
			szTransWay =  Form.GetMetaData("집합투자증권저축유형코드", szOrgWay)
			grd0.SetCellData("IISC_SVNG_TYPE_CODE", 		g_szNextData,		szTransWay)
			grd0.SetCellImage("IISC_SVNG_TYPE_CODE", 	g_szNextData,		"img_bgsquare_grade_316.png")
			grd0.SetCellFgColor("IISC_SVNG_TYPE_CODE", 	g_szNextData,		321)

			g_szNextData = g_szNextData + 1
		next
		
	elseif szTranID == "oocwi_mall_002r" then
		Dim szSendData, sISCD, sZI_SCTY_FNCD, sSALE_CHAN_CLS_CODE
		sISCD				= DATAMANAGER.GetDataValue(false, "oocwi_mall_002r", "OutBlock2", "ISCD", 				0)
		sZI_SCTY_FNCD			= DATAMANAGER.GetDataValue(false, "oocwi_mall_002r", "OutBlock2", "ZI_SCTY_FNCD", 		0)
		sSALE_CHAN_CLS_CODE	= DATAMANAGER.GetDataValue(false, "oocwi_mall_002r", "OutBlock2", "SALE_CHAN_CLS_CODE",	0)

		szSendData = sISCD & "★" & sZI_SCTY_FNCD & "★" & sSALE_CHAN_CLS_CODE

		Form.OpenPopup("mbfnp51000_p2", szSendData, "")
	elseif szTranID == "oocwi_mall_002r_1" then
		Dim szSendData, sISCD, sZI_SCTY_FNCD, sSALE_CHAN_CLS_CODE
		sISCD				= DATAMANAGER.GetDataValue(false, "oocwi_mall_002r_1", "OutBlock2", "ISCD", 				0)
		sZI_SCTY_FNCD			= DATAMANAGER.GetDataValue(false, "oocwi_mall_002r_1", "OutBlock2", "ZI_SCTY_FNCD", 		0)
		sSALE_CHAN_CLS_CODE	= DATAMANAGER.GetDataValue(false, "oocwi_mall_002r_1", "OutBlock2", "SALE_CHAN_CLS_CODE",	0)
		
		szSendData = sISCD & "★" & sZI_SCTY_FNCD & "★" & sSALE_CHAN_CLS_CODE & "★" & "51020" & "★" & szData
		Form.OpenPopup("mbfnp51000_p0", szSendData, "")
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , szErrCode .. " : ".. szErrMsg)
	end if
	
End Sub

'============================================================================
'							CONTROL 함수
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	g_IRow = lRow	
	
	'계좌번호, 일련번호, 잔고일련번호, 펀드코드, 한글 종목명
	szData = g_szData & "★" & grd0.GetCellData("RMND_SRNO", lRow) & "★" & grd0.GetCellData("ISCD", lRow) & "★" & grd0.GetCellData("KOR_ISNM", lRow)

	' 펀드정보
	if szCellID == "BUTTON0" then
		Dim sISCD
		sISCD = grd0.GetCellData("ISCD", lRow)
		
		DATAMANAGER.SetDataValue(false, "oocwi_mall_002r", "InBlock1", "ISCD",		0, sISCD)
		DATAMANAGER.SetDataValue(false, "oocwi_mall_002r", "InBlock1", "SORT_CLS",	0, "E")
		
		DATAMANAGER.RequestTranData("oocwi_mall_002r")
		
	' 자동이체 신청
	elseif szCellID == "BUTTON1" then
		Dim sBtnNm
		sBtnNm = grd0.GetCellData("BUTTON1", lRow)
		
		if sBtnNm == "자동이체 신청" then
			if grd0.GetCellData("CANC_CLS_CODE", lRow) = "R" then
				Form.OpenPopup("mbfnp51020_p4", szData, sPosInfo)
			else
				'v001
				'Form.OpenPopup("mbfnp51020_p3", szData, sPosInfo)
				Dim sISCD
				sISCD = grd0.GetCellData("ISCD", lRow)
				
				DATAMANAGER.SetDataValue(false, "oocwi_mall_002r_1", "InBlock1", "ISCD",		0, sISCD)
				DATAMANAGER.SetDataValue(false, "oocwi_mall_002r_1", "InBlock1", "SORT_CLS",	0, "E")
				
				DATAMANAGER.RequestTranData("oocwi_mall_002r_1")
			end if
		
		elseif sBtnNm == "신청 내역" then
			Dim szData, KOR_ISNM, BANK_ACNO, TACT_AMT, TACT_DATE, TACT_HOPE_DAY_NAME
			
			if grd0.GetCellData("BANK_CODE", lRow) ~= "" then
				BANK_ACNO = "["..grd0.GetCellData("BANK_NAME", lRow).."] "..grd0.GetCellData("TACT_BANK_ACNO", lRow)
			else
				BANK_ACNO = "["..grd0.GetCellData("PRCD_NAME", lRow).."] "..MID(grd0.GetCellData("TACT_SCRT_ACNO", lRow),1,4).."-"..MID(grd0.GetCellData("TACT_SCRT_ACNO", lRow),5,4).."-"..grd0.GetCellData("TACT_SCRT_ASNO", lRow)
			end if
			
			KOR_ISNM 			= grd0.GetCellData("KOR_ISNM", 			lRow)
			TACT_AMT 			= grd0.GetCellData("TACT_AMT", 			lRow)
			TACT_DATE 			= MID(grd0.GetCellData("TACT_STA_DATE", 		lRow),1,6)..MID(grd0.GetCellData("TACT_FIN_DATE", lRow),1,6)
			TACT_HOPE_DAY_NAME	= grd0.GetCellData("TACT_HOPE_DAY_NAME",	lRow)
			szData				= KOR_ISNM.."@"..BANK_ACNO.."@"..TACT_AMT.."@"..TACT_DATE.."@"..TACT_HOPE_DAY_NAME

			Form.OpenPopupAnimation("mbfnp51020_p6", szData, "", "2")
		end if
		
	end if
	
End Sub

	</SCRIPT_INFO>
