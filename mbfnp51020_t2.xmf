			<TRAN tranid="obsim_idmn_018r" trcode="obsim_idmn_018r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="oocwi_mall_002r_1" trcode="oocwi_mall_002r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="oocwi_mall_002r" title="펀드검색" realdata="0" dessvr="9" >
