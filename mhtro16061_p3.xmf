						<CELL cell_ly="0,27,0,27" autofontsize="1" impidxs="" />
						<CELL cell_ly="1,27,1,27" halign="0" fontsize="-2" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,28,1,28" halign="0" caption="※ 시장가 주문시 상/하한가가 없는 미국 시장의 특성상" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
