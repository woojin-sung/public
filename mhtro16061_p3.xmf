						<CELL cell_ly="0,32,1,32" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,33,1,33" halign="0" caption="※ 현지 증권사 사정으로 알고리즘 주문 처리가 " fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
						<CELL cell_ly="0,34,0,34" autofontsize="1" impidxs="" />
						<CELL cell_ly="1,34,1,34" halign="0" caption="지연되거나 취소될 수 있으며, 알고리즘 주문은" fontsize="-2" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,35,0,35" autofontsize="1" impidxs="" />
