					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" caption="·" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" halign="0" caption="예약주문은 정규시장의 주문접수를 위한 가주문으로" fontsize="-2" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,1,0,1" fgcolor="061:239059036" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,1,1,1" halign="0" caption="계좌의 주문가능금액 및 주식잔고, 주문단위, 호가 등을" fontsize="-2" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,2,0,2" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,2,1,2" halign="0" caption="전혀 고려하지 않고 접수되는 주문입니다." fontsize="-2" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,3,0,3" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,3,1,3" halign="0" fontsize="-2" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,4,0,4" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,4,1,4" halign="0" caption="따라서 예약주문 접수를 하신 경우 정규시장 주문이" fontsize="-2" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,5,0,5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,5,1,5" halign="0" caption="정상적으로 접수가 되었는지 여부를 반드시 확인하시기" fontsize="-2" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,6,0,6" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,6,1,6" halign="0" caption="바랍니다." fontsize="-2" autofontsize="1" impidxs="" />
