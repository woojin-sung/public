						<CELL cell_ly="1,39,1,39" fgcolor="341:056101194" halign="0" caption="미 국세청 Section 1446(f)조항에 근거하여 매도일 기준" fontsize="-2" autofontsize="1" impidxs="" />
						<CELL cell_ly="0,40,0,40" fontsize="-2" autofontsize="1" impidxs="" />
						<CELL cell_ly="1,40,1,40" fgcolor="341:056101194" halign="0" caption="2023년 1월 1일부터 매도 금액의 10%가 세금으로 발생" fontsize="-2" autofontsize="1" impidxs="" />
