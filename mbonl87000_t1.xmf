'============================================================================
' BtnEnrollEnable
'============================================================================
Function BtnEnrollEnable()
	Dim szTemp
	szTemp = 0
	
	if g_szCheck03 <> "0" then
		szTemp = szTemp + 1
	end if
	if g_szCheck29 <> "0" then
		szTemp = szTemp + 1
	end if
	
	if g_szCheck04 <> "0" then
		szTemp = szTemp + 1
	end if
	if g_szCheck31 <> "0" then
		szTemp = szTemp + 1
	end if
	if g_szCheck45 <> "0" then
		szTemp = szTemp + 1
	end if
	if g_szCheck08 <> "0" then
		szTemp = szTemp + 1
	end if
	if g_szCheck09 <> "0" then
		szTemp = szTemp + 1
	end if
	if g_szCheck10 <> "0" then
		szTemp = szTemp + 1
	end if
	if g_szCheck35 <> "0" then
		szTemp = szTemp + 1
	end if
	if g_szCheck11 <> "0" then
		szTemp = szTemp + 1
	end if
	
	if g_szCheck12 <> "0" then
		szTemp = szTemp + 1
	end if
	if g_szCheck13 <> "0" then
		szTemp = szTemp + 1
	end if
	if g_szCheck15 <> "0" then
		szTemp = szTemp + 1
	end if
	if g_szCheck14 <> "0" then
		szTemp = szTemp + 1
	end if
	if g_szCheck17 <> "0" then
		szTemp = szTemp + 1
	end if
	'if g_szCheck18 <> "0" then
	'	szTemp = szTemp + 1
	'end if
	'if g_szCheck19 <> "0" then
	'	szTemp = szTemp + 1
	'end if
	'if g_szCheck34 <> "0" then
	'	szTemp = szTemp + 1
	'end if
	
	Call AllCheck()
	
	Container1.btnEnroll.enable = true
'	if szTemp <> 0 then
'		Container1.btnEnroll.enable = true		
'	else
'		Container1.btnEnroll.enable = false
'	end if
	
End Function


'============================================================================
' AllCheck
'============================================================================
Function AllCheck()
	Dim szTempTwo
	szTempTwo = 0
	
	if g_szCheck03 <> "0" then
		szTempTwo = szTempTwo + 1
	end if
	if g_szCheck29 <> "0" then
		szTempTwo = szTempTwo + 1
	end if
	
	if g_szCheck04 <> "0" then
		szTempTwo = szTempTwo + 1
	end if
	if g_szCheck31 <> "0" then
		szTempTwo = szTempTwo + 1
	end if
	if g_szCheck45 <> "0" then
		szTempTwo = szTempTwo + 1
	end if
	if g_szCheck08 <> "0" then
		szTempTwo = szTempTwo + 1
	end if
	if g_szCheck09 <> "0" then
		szTempTwo = szTempTwo + 1
	end if
	if g_szCheck10 <> "0" then
		szTempTwo = szTempTwo + 1
	end if
	if g_szCheck35 <> "0" then
		szTempTwo = szTempTwo + 1
	end if
	if g_szCheck11 <> "0" then
		szTempTwo = szTempTwo + 1
	end if
	
	if g_szCheck12 <> "0" then
		szTempTwo = szTempTwo + 1
	end if
	if g_szCheck13 <> "0" then
		szTempTwo = szTempTwo + 1
	end if
	if g_szCheck15 <> "0" then
		szTempTwo = szTempTwo + 1
	end if
	if g_szCheck14 <> "0" then
		szTempTwo = szTempTwo + 1
	end if
	if g_szCheck17 <> "0" then
		szTempTwo = szTempTwo + 1
	end if
	'if g_szCheck18 <> "0" then
	'	szTempTwo = szTempTwo + 1
	'end if
	'if g_szCheck19 <> "0" then
	'	szTempTwo = szTempTwo + 1
	'end if
	'if g_szCheck34 <> "0" then
	'	szTempTwo = szTempTwo + 1
	'end if
	
	if szTempTwo < 15 then
		Container1.chkAll.checkstate = "0"
		
	elseif szTempTwo == 15 then
		Container1.chkAll.checkstate = "1"
		Container1.chkOneAll.checkstate = "1"
		Container1.chkTwoAll.checkstate = "1"
		Container1.chkThreeAll.checkstate = "1"
	end if
	
End Function


'============================================================================
' AllCheckOne
'============================================================================
Function AllCheckOne()
	if g_szCheck03 <> "0" and g_szCheck29 <> "0" then
		Container1_chkOneAll_OnChange("1")
	else
		Container1.chkOneAll.checkstate = "0"
	end if	
End Function

'============================================================================
' AllCheckTwo
'============================================================================
Function AllCheckTwo()
	if g_szCheck04 <> "0" and g_szCheck31 <> "0" and g_szCheck45 <> "0" and g_szCheck08 <> "0" and g_szCheck09 <> "0" and g_szCheck10 <> "0" and g_szCheck35 <> "0" and g_szCheck11 <> "0" then
		Container1_chkTwoAll_OnChange("1")
	else
		Container1.chkTwoAll.checkstate = "0"
	end if
End Function


'============================================================================
' AllCheckThree
'============================================================================
Function AllCheckThree()
	if g_szCheck12 <> "0" and g_szCheck13 <> "0" and g_szCheck15 <> "0" and g_szCheck14 <> "0" and g_szCheck17 <> "0" then 'and g_szCheck18 <> "0" and g_szCheck19 <> "0" and g_szCheck34 <> "0" then
		Container1_chkThreeAll_OnChange("1")
	else
		Container1.chkThreeAll.checkstate = "0"
	end if
End Function

'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)
	if szTranID == "obcsb_acif_000r" then	'고객정보조회
		DATAMANAGER.SetDataValue(0, "obcsb_acif_000r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		if g_szAccountPassword <> "" then
			DATAMANAGER.SetDataValue(0,  "obcsb_acif_000r", "InBlock1", "ACNT_PWD", 0 , g_szAccountPassword)
		end if
		DATAMANAGER.RequestTranData("obcsb_acif_000r")
	end if
	
	if szTranID == "obpds_srvc_241r" then	'계좌단위 알리미 조회
		DATAMANAGER.SetDataValue(0, "obpds_srvc_241r", "InBlock1", "SVCD" , 0 , "009")	'SMS서비스코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_241r", "InBlock1", "SVC_MANG_UNIT_CODE", 0 , "02")	'기본값셋팅
		DATAMANAGER.SetDataValue(0, "obpds_srvc_241r", "InBlock1", "PROS_CLS" , 0 , "1")			'기본값셋팅
		DATAMANAGER.RequestTranData("obpds_srvc_241r")
	end if
	
	if szTranID == "obpds_srvc_323r" then 	'hts-mts용 서비스 내역 조회	
		if Container0.Label21.caption <> "01" then	'서비스관리단위
			DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)	'계좌번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ASNO" , 0 , "%")			'계좌일련번호
		else
			DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ACNO" , 0 , "%")		'계좌번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ASNO" , 0 , "%")		'계좌일련번호
			DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "CSNO" , 0 , Container0.Label17.caption)	'고객번호
		end if
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "SVCD" , 0 , "009")	'기본값셋팅
		DATAMANAGER.RequestTranData("obpds_srvc_323r")
	end if
	
	if szTranID == "obpds_srvc_070r" then	'약정고객정보조회tr
		DATAMANAGER.SetDataValue(0, "obpds_srvc_070r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)	'계좌번호
		DATAMANAGER.RequestTranData("obpds_srvc_070r")
	end if
	
	if szTranID == "obpds_srvc_309r" then	'알리미휴대폰정보조회
		'DATAMANAGER.ClearInputData(0, "obpds_srvc_309r")
		DATAMANAGER.SetDataValue(0, "obpds_srvc_309r", "InBlock1", "SVC_SRNO" , 0 , g_szSVCD)	'서비스일련번호
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_309r", "InBlock1", "SVCD", 0 , "009")	'서비스코드(기본값셋팅)
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_309r", "InBlock1", "CSNO", 0 , Container0.Label17.caption)	'고객번호
		DATAMANAGER.RequestTranData("obpds_srvc_309r")
	end if
	
	if szTranID == "obpds_srvc_308r" then	'알리미발송목록조회
		DATAMANAGER.ClearInputData(0, "obpds_srvc_308r")
		DATAMANAGER.SetDataValue(0, "obpds_srvc_308r", "InBlock1", "SVC_SRNO" , 0 , g_szSVCD)	'서비스일련번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_308r", "InBlock1", "CLPH_ARCD" , 0 , g_szARCD)	'휴대폰지역번호
		DATAMANAGER.SetDataValue(0,"obpds_srvc_308r", "InBlock1", "CLPH_TONO" , 0 , g_szTONO)	'휴대폰국번호
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_308r", "InBlock1", "CPNO", 0 , g_szCPNO)	'휴대폰번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_308r", "InBlock1", "SVCD" , 0 , "009")	'서비스코드(기본값셋팅)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_308r", "InBlock1", "CSNO" , 0 , Container0.Label17.caption)	'고객번호
		DATAMANAGER.RequestTranData("obpds_srvc_308r")
	end if
	
	
	if szTranID == "obcsb_acad_002r" then	'고객연락처정보조회
		DATAMANAGER.SetDataValue(0, "obcsb_acad_002r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)	'계좌번호
		DATAMANAGER.RequestTranData("obcsb_acad_002r")
	end if
	
	if szTranID == "obpds_srvc_030a" then	'선택sms약정		
		DATAMANAGER.ClearInputData(0, "obpds_srvc_030a")
		
		Dim nCnt, nTemp
		nCnt = 0
		nTemp = 0
		
		for i=0 to Container0.Grid0.rowcount	-1	
		
			if g_szCheck03 <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "03")
				nCnt = nCnt + 1
			end if
			
			if g_szCheck29 <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "29")
				nCnt = nCnt + 1
			end if
			
			if g_szCheck04 <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "04")
				nCnt = nCnt + 1
			end if
			
			if g_szCheck31 <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "31")
				nCnt = nCnt + 1
			end if
			
			if g_szCheck45 <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "45")
				nCnt = nCnt + 1
			end if
			
			if g_szCheck08 <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "08")
				nCnt = nCnt + 1
			end if
			
			if g_szCheck09 <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "09")
				nCnt = nCnt + 1
			end if
			
			if g_szCheck10 <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "10")
				nCnt = nCnt + 1
			end if
			
			if g_szCheck35 <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "35")
				nCnt = nCnt + 1
			end if
			
			if g_szCheck11 <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "11")
				nCnt = nCnt + 1
			end if
			
			if g_szCheck12 <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "12")
				nCnt = nCnt + 1
			end if
			
			if g_szCheck13 <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "13")
				nCnt = nCnt + 1
			end if
			
			if g_szCheck15 <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "15")
				nCnt = nCnt + 1
			end if
			
			if g_szCheck14 <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "14")
				nCnt = nCnt + 1
			end if
			
			if g_szCheck17 <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "17")
				nCnt = nCnt + 1
			end if
			
			'if g_szCheck18 <> "0" then
			'	DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "18")
			'	nCnt = nCnt + 1
			'end if
			
			'if g_szCheck19 <> "0" then
			'	DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "19")
			'	nCnt = nCnt + 1
			'end if
			
			'if g_szCheck34 <> "0" then
			'	DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "34")
			'	nCnt = nCnt + 1
			'end if
			
			if Container0.lbl40.caption <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "40")
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock1", "DRNG_ACNO" , 0 , lblDragAcno.caption)
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock1", "DRNG_ASNO" , 0 , lblDragAsno.caption)
				nCnt = nCnt + 1
			end if
			
			if Container0.lbl21.caption <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "21")
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock1", "DRNG_ACNO" , 0 , lblDragAcno.caption)
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock1", "DRNG_ASNO" , 0 , lblDragAsno.caption)
				nCnt = nCnt + 1
			end if
			
			if Container0.lbl20.caption <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "20")
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock1", "DRNG_ACNO" , 0 , lblDragAcno.caption)
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock1", "DRNG_ASNO" , 0 , lblDragAsno.caption)
				nCnt = nCnt + 1
			end if
			
			if Container0.lbl36.caption <> "0" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "SMS_INFR_BSWR_DETL_CLCD",nCnt, "36")
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock1", "DRNG_ACNO" , 0 , lblDragAcno.caption)
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock1", "DRNG_ASNO" , 0 , lblDragAsno.caption)
				nCnt = nCnt + 1
			end if
			
			if g_szPros = "I" then
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock1", "BSWR_PROS_CLS_CODE", 0, "" )
				for j=nTemp to nCnt-1
					DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "CLPH_ARCD", j, Container0.Grid0.GetCellData( "bd_cell0", i ))
					DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "CLPH_TONO", j, Container0.Grid0.GetCellData( "bd_cell1", i ))
					DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "CPNO", j, Container0.Grid0.GetCellData( "bd_cell2", i ))
				next
				nTemp = nCnt
			else
				DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock1", "BSWR_PROS_CLS_CODE", 0, "2" )
				for j=nTemp to nCnt-1
					DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "CLPH_ARCD", j, Container0.Grid0.GetCellData( "bd_cell0", i ))
					DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "CLPH_TONO", j, Container0.Grid0.GetCellData( "bd_cell1", i ))
					DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock2", "CPNO", j, Container0.Grid0.GetCellData( "bd_cell2", i ))
				next
				nTemp = nCnt
			end if
		next
		

		DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock1", "PROS_CLS_CODE" , 0 , g_szPros)	'처리구분코드
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_030a", "InBlock1", "SVC_SRNO", 0 , g_szSVCD)	'서비스일련번호		
		Dim szCUSTCLSCODE
		szCUSTCLSCODE = DATAMANAGER.GetDataValue(0,  "obpds_srvc_070r", "OutBlock1", "CUST_CLS_CODE", 0)	'고객구분코드
		Dim szCUSTGRADCODE
		szCUSTGRADCODE = DATAMANAGER.GetDataValue(0, "obpds_srvc_070r", "OutBlock1", "CUST_GRAD_CODE" , 0)	'고객등급코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock1", "SVCD" , 0 , "009")	'서비스코드(기본값셋팅)
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_030a", "InBlock1", "CONT_CLS_CODE", 0 , "4")	'접촉구분코드(기본값셋팅)
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_030a", "InBlock1", "CUST_CLS_CODE", 0 , szCUSTCLSCODE)	'고객구분코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock1", "CUST_GRAD_CODE" , 0 , szCUSTGRADCODE)	'고객등급코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock1", "ACNO" , 0 , g_szAccountNumber)	'계좌번호
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_030a", "InBlock1", "ACNT_PWD", 0 , g_szAccountPassword) '계좌비밀번호
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_030a", "InBlock1", "CSNO", 0 , Container0.Label17.caption)	'고객번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_030a", "InBlock1", "SVC_MANG_UNIT_CODE" , 0 , Container0.Label21.caption)	'서비스관리단위코드
		DATAMANAGER.RequestTranData("obpds_srvc_030a")
	end if
	
End Function 

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Container0_btnNote_OnClick - 유의사항
'============================================================================



'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)	
	if sEventName == "AccountData" then
		InitDataSetting()	
		BtnEnrollEnable()
		Dim szList	
		szList = Split(sParam, "★")	'계좌번호, 일련번호, 비밀번호	
		
		if Container0.GridPro0.rowcount > "0" then
			Container0.GridPro0.SetClear( )	
			Container0.Grid0.SetClear( )
		end if
		
		
		g_szAccountNumber = szList(0)
		g_szAccountSerialNumber = szList(1)
		if szList(2) == "" then
			g_szAccountPassword = ""
		else
			g_szAccountPassword = szList(2)
		end if		
		btnSearch_OnClick()
	end if	
	
	if sEventName == "PASSWORD" then		
		g_szAccountPassword = sParam		
	end if

End Sub

'============================================================================
' btnSearch_OnClick
'============================================================================
Sub btnSearch_OnClick()
	InitDataSetting()
	Container1.btnEnroll.enable = false
	TR_Inquiry("obcsb_acif_000r")	'고객정보조회
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acif_000r" then	'고객정보조회
		InitDataSetting()
		Call TR_Inquiry("obpds_srvc_241r")	'계좌단위 알리미조회
	end if
	
	if szTranID == "obpds_srvc_241r" then	'계좌단위알리미조회
		if DATAMANAGER.GetDataCount(0, "obpds_srvc_241r", "OutBlock1") <> 0 then
			Container1.lblUnit.caption = "계좌"	'서비스단위
			Container0.Label21.caption = "02"	'서비스관리단위
		else
			if Container0.LblCorp.caption == "2" then
				Container1.lblUnit.caption = "계좌"	'서비스단위
				Container0.Label21.caption = "02"	'서비스관리단위
			else
				Container1.lblUnit.caption = "고객"	'서비스단위
				Container0.Label21.caption = "01"	'서비스관리단위
			end if
			
		end if		
		Call TR_Inquiry("obpds_srvc_323r")		
	end if
	
	
	if szTranID == "obpds_srvc_323r" then	'hts-mts용 서비스 내역 조회		
		g_szSVCD = DATAMANAGER.GetDataValue(0, "obpds_srvc_323r", "OutBlock1", "SVC_SRNO" , 0)	'서비스일련번호
		g_szAPRV = DATAMANAGER.GetDataValue(0, "obpds_srvc_323r", "OutBlock1", "APRV_YN" , 0)	'승인여부
		
		if g_szAPRV == "Y" then
			Container0.Label5.caption = g_szSVCD		
			Form.MsgBox("알림", "현재 알리미 서비스 신규등록중이므로 변경하실 수 없습니다.", "", 0)
			Call TR_Inquiry("obpds_srvc_070r")	'약정고객정보조회tr
		elseif g_szAPRV = "N" then
			if g_szSVCD <> "" then
				g_szPros = "U" 
			end if
			Container0.Label5.caption = g_szSVCD
			Call TR_Inquiry("obpds_srvc_070r") '약정고객정보조회tr
		else
			'여기에서 hts는 0, mts는 00000000000로 분기처리
			if g_szSVCD == "00000000000" then			
				g_szPros = "I"
				Container0.Label5.caption = g_szSVCD
				Call TR_Inquiry("obcsb_acad_002r") '고객연락처정보조회
			end if
		end if
	end if
	
	if szTranID == "obpds_srvc_070r" then	'약정고객정보조회tr
		Call TR_Inquiry("obpds_srvc_309r")
	end if
	
	if szTranID == "obpds_srvc_309r" then	'알리미 휴대폰정보조회
		g_szARCD = DATAMANAGER.GetDataValue(0,  "obpds_srvc_309r", "OutBlock1", "CLPH_ARCD", 0)
		g_szTONO = DATAMANAGER.GetDataValue(0,  "obpds_srvc_309r", "OutBlock1", "CLPH_TONO", 0)
		g_szCPNO = DATAMANAGER.GetDataValue(0, "obpds_srvc_309r", "OutBlock1", "CPNO" , 0)
		if g_szARCD <> "" then
			Container1.lblPhone.caption = g_szARCD & "-" & g_szTONO & "-" & g_szCPNO
		else
			Container1.lblPhone.caption = ""
		end if
		lblDragAcno.caption = DATAMANAGER.GetDataValue(0, "obpds_srvc_309r", "OutBlock1", "DRNG_ACNO" , 0)
		lblDragAsno.caption = DATAMANAGER.GetDataValue(0, "obpds_srvc_309r", "OutBlock1", "DRNG_ASNO" , 0)
		Call TR_Inquiry("obpds_srvc_308r")	'알리미발송목록조회
	end if
	
	if szTranID == "obcsb_acad_002r" then	'고객연락처정보조회
		
		if Container0.GridPro0.rowcount > "0" then
			Container0.GridPro0.SetClear( )
			Container0.Grid0.SetClear( )
		end if
		
		for i=0 to DATAMANAGER.GetDataCount(0,"obcsb_acad_002r", "OutBlock3" )-1
			
			if DATAMANAGER.GetDataValue(0,"obcsb_acad_002r", "OutBlock3", "INAG_TYPE_CODE" , i) == "13" then
				Container0.GridPro0.insertrow = 0
				Container0.GridPro0.SetCellData( "bd_cell0", 0,  DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i))
				Container0.GridPro0.SetCellData( "bd_cell2", 0,  DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "TONO" , i))
				Container0.GridPro0.SetCellData( "bd_cell3", 0,  DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i))
				
			end if
			
			if Container0.GridPro0.GetCellData( "bd_cell0", 0 ) <> "" then
					Container1.lblPhone.caption = Container0.GridPro0.GetCellData( "bd_cell0", 0 ) & "-" & Container0.GridPro0.GetCellData( "bd_cell2", 0 ) & "-" & Container0.GridPro0.GetCellData( "bd_cell3", 0 )
				else
					Container1.lblPhone.caption = ""
				end if
			
			if DATAMANAGER.GetDataValue(0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i) == "" then
				if Container0.GridPro0.rowcount > "0" then
					Container0.GridPro0.SetClear( )
					Container0.Grid0.SetClear( )
				end if
			end if
			
		next
	end if
	
	if szTranID == "obpds_srvc_308r" then	'알리미발송목록조회
		InitCheckSetting()
		for i=0 to DATAMANAGER.GetDataCount(0, "obpds_srvc_308r", "OutBlock1")- 1
			Select Case DATAMANAGER.GetDataValue(0, "obpds_srvc_308r", "OutBlock1", "SMS_INFR_BSWR_DETL_CLCD" , i)
			Case "40"	'스마트폰push 체결통보(무료)
				Container0.lbl40.caption = "1"
			Case "21"	'전량체결통보
				Container0.lbl21.caption = "1"
			Case "20"	'빠른체결통보
				Container0.lbl20.caption = "1"				
			Case "36"	'오프라인주문sms체결통보
				Container0.lbl36.caption = "1"
				
				
			Case "03"
				Container1.chk03.checkstate = "1"
				g_szCheck03 = Container1.chk03.checkstate
			Case "29"
				Container1.chk29.checkstate = "1"
				g_szCheck29 = Container1.chk29.checkstate
				
			Case "04"
				Container1.chk04.checkstate = "1"
				g_szCheck04 = Container1.chk04.checkstate
			Case "31"
				Container1.chk31.checkstate = "1"
				g_szCheck31 = Container1.chk31.checkstate
			Case "45"
				Container1.chk45.checkstate = "1"
				g_szCheck45 = Container1.chk45.checkstate
			Case "08"
				Container1.chk08.checkstate = "1"
				g_szCheck08 = Container1.chk08.checkstate
			Case "09"
				Container1.chk09.checkstate = "1"
				g_szCheck09 = Container1.chk09.checkstate
			Case "10"
				Container1.chk10.checkstate = "1"
				g_szCheck10 = Container1.chk10.checkstate
			Case "35"
				Container1.chk35.checkstate = "1"
				g_szCheck35 = Container1.chk35.checkstate
			Case "11"
				Container1.chk11.checkstate = "1"
				g_szCheck11 = Container1.chk11.checkstate
				
			Case "12"
				Container1.chk12.checkstate = "1"
				g_szCheck12 = Container1.chk12.checkstate
			Case "13"
				Container1.chk13.checkstate = "1"
				g_szCheck13 = Container1.chk13.checkstate
			Case "15"
				Container1.chk15.checkstate = "1"
				g_szCheck15 = Container1.chk15.checkstate
			Case "14"
				Container1.chk14.checkstate = "1"
				g_szCheck14 = Container1.chk14.checkstate
			Case"17"
				Container1.chk17.checkstate = "1"
				g_szCheck17 = Container1.chk17.checkstate
			'Case "18"
			'	Container1.chk18.checkstate = "1"
			'	g_szCheck18 = Container1.chk18.checkstate
			'Case "19"
			'	Container1.chk19.checkstate = "1"
			'	g_szCheck19 = Container1.chk19.checkstate
			'Case "34"
			'	Container1.chk34.checkstate = "1"
			'	g_szCheck34 = Container1.chk34.checkstate
			End Select			
		next		
		
		Container1.btnEnroll.enable = false
		
	end if
	
	if szTranID == "obpds_srvc_030a" then
		if g_szPros == "I" then
			Form.MsgBox("알림", "알리미 신청이 완료되었습니다.", "", 0)
		elseif g_szPros == "U" then
			Form.MsgBox("알림", "알리미 변경이 완료되었습니다.", "", 0)
		else
			Form.MsgBox("알림", "알리미 해지가 완료되었습니다.", "", 0)
		end if	
		Call TR_Inquiry("obcsb_acif_000r")
		Container1.btnEnroll.enable = false
	end if
	
End Sub


'============================================================================
' Container1_btnEnroll_OnClick - 신청
'============================================================================
Sub Container1_btnEnroll_OnClick()
	if g_szAccountPassword == "" or Form.GetCtlProp( "#edtPassword", "caption") == "" then
		Form.MsgBox("알림", "계좌 비밀번호를 입력하세요", "", 0)
		exit sub
	end if
	
	if Container0.GridPro0.rowcount < "1" then
		Form.MsgBox("알림", "등록 할 휴대폰 번호가 없습니다.", "", 0)
		exit sub
	end if
	
	Container0.Grid0.SetClear( )
	
	for i=0 to Container0.GridPro0.rowcount-1
		if Container0.GridPro0.GetCellData( "bd_cell2" , i ) <> "" then
			'16-03-28 YCJ Index 0 일때 값이 안들어 가던 부분 수정
			Container0.Grid0.AddRow()
'			Container0.Grid0.insertrow = 0
			Container0.Grid0.SetCellData( "bd_cell0", i, Container0.GridPro0.GetCellData( "bd_cell0", i ) )
			Container0.Grid0.SetCellData( "bd_cell1", i, Container0.GridPro0.GetCellData( "bd_cell2", i ) )
			Container0.Grid0.SetCellData( "bd_cell2", i, Container0.GridPro0.GetCellData( "bd_cell3", i ) )
		end if	
	next
	Call TR_Inquiry("obpds_srvc_030a")	'선택SMS약정
End Sub


'============================================================================
' Container1_btnCancel_OnClick
'============================================================================
Sub Container1_btnCancel_OnClick()
	if g_szAccountPassword == "" or Form.GetCtlProp( "#edtPassword", "caption") == "" then
		Form.MsgBox("알림", "계좌 비밀번호를 입력하세요.", "", 0)
		exit sub
	end if
	Form.MsgBox("알림", "알리미 서비스를 해지하시겠습니까?\n(체결통보도 해지되므로 계좌일반만\n해지하시는 경우 체크를 해지하시고\n신청/변경을 선택하세요)", "btnCancelOK", 1)
End Sub


'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "btnCancelOK" then
		if sRet == "ok" then
			if g_szAPRV <> "" then
				g_szPros = "D"
				Call TR_Inquiry("obpds_srvc_030a")	'알리미 이메일 약정
				btnSearch_OnClick()
				InitCheckSetting()
			end if
		else
			Form.MsgBox("알림", "해지 신청이 취소되었습니다.", "", 0)			
		end if	
	end if
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr

	if szTranID == "obpds_srvc_030a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.MsgBox("알림", szErrMsg.."("..szSubErr..")" , "", 0)
		btnSearch_OnClick()
	end if
End Sub


