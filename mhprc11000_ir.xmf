	<SCRIPT_INFO _len="7890" _ulen="7426" >
g_szSave = ""
g_mainCategory = ""
g_subCateogory = ""

g_nCnt = ""	'20230721 HSZ
'============================================================================
Sub Form_OnFormInit()

	' 관심 동기화 //////////////////////////////////////////////////////////
	g_szSave = Form.GetEnvData("common.interest_cloud")
	
	if Trim(g_szSave) == "" then	' 초기값 : 1(동기화 사용)
		g_szSave = "1"
	end if
	' //////////////////////////////////////////////////////////////////////
	 
	 szCategory = Form.GetEnvData("common.curtouch_swing")
	 
	 if szCategory == "0" then
		 g_mainCategory = "H0"
		 g_subCateogory = ""
	 elseif szCategory == "1" then
		 g_mainCategory = "IN"
		 g_subCateogory = Form.GetEnvData("common.curtouch_swing_group")
	 elseif szCategory == "2" then
		 g_mainCategory = "W0"
	 elseif szCategory == "3" then
		 g_mainCategory = Form.GetEnvData("common.curtouch_swing_jisu")
		 g_subCateogory = Form.GetEnvData("common.curtouch_swing_jisuitem")
	 else
		 g_mainCategory = "H0"
		 g_subCateogory = ""
	 end if
	 
'	 g_mainCategory = Form.ACRGetProp( "category")
'	 g_subCateogory = Form.ACRGetProp( "subcategory" )

	 cmbGroup.enable = "0"
	 cbUp1.enable = "0"
	 cbUp2.enable = "0"
	 if g_mainCategory == "W0" then ' 왓칭 종목
		 RadioGroup0.currentindex = "2"
	 elseif g_mainCategory == "IN" then ' 관심
		 cmbGroup.enable = "1"
		 RadioGroup0.currentindex = "1"
	 elseif g_mainCategory == "H0" then ' 최근
		 RadioGroup0.currentindex = "0"
	 else
	 	 if g_mainCategory == "" then
			 RadioGroup0.currentindex = "0"		 
		 else
			 RadioGroup0.currentindex = "3"
			 cbUp1.enable = "1"
			 cbUp2.enable = "1"		 
		 end if
	 end if
	
	 
	 init_GWGroup()
	 InitCombo()
End Sub

Function init_GWGroup()
	if g_szSave == "1" then		' Server 저장시
		' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
		DATAMANAGER.RequestTranData("ohhts_intr_006r")
	else
		' 로컬 저장된 관심그룹 가져오기
		Load_GWGroup()
		Insert_cmbGroup()
	end if
End Function

Function InitCombo()
	sKeyData = cbUp1.cbkeydata
	cbUp2.cbinputdatatext = Form.GetMasterComboData( "2" , sKeyData)
	cbUp2.cbkeydata = g_subCateogory
End Function

'============================================================================
' Load_GWGroup :  로컬에 저장된 관심그룹 가져오기
'============================================================================
Function Load_GWGroup()
	Dim tGroup, tList
	
	grdGroup.rowcount = 0
	szGroup = Form.LoadConfigData("GWANSIM", "GROUP")
	
	if szGroup <> "" then	
		tGroup = Split(szGroup, "♣")
		
		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdGroup.insertrow = i
	
			grdGroup.SetCellData("bd_code",  i, tList(0))
			grdGroup.SetCellData("bd_name",  i, tList(1))
			grdGroup.SetCellData("bd_count", i, tList(2))
		Next
	end if
End Function

