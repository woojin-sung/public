' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	if szTranID == "ohhts_intr_006r" then
'		Form.ShowAlert(szErrCode , szErrMsg)
'	end if
End Sub

Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
		g_nCnt = "" '20230721
		DATAMANAGER.ClearInputData(0, "ohhts_intr_006r")
		grdGroup.rowcount = 0
		DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))	' USER ID
	' ----------------------------------------------------------------------
	' 
	' ----------------------------------------------------------------------
'	elseif szTranID ==  then
'		DATAMANAGER.SetDataValue(0, , 0, )	
'		DATAMANAGER.SetDataValue(0, , 0, )	
	' ----------------------------------------------------------------------
	' 
	' ----------------------------------------------------------------------	
'	elseif szTranID ==  then
	end if
End Sub

Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
		' 관심그룹을 그룹콤보에 넣기
		g_nCnt = CDbl(DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock1" ))
		Insert_cmbGroup()
	end if
End Sub

Function Insert_cmbGroup()
	Dim szgrpList, szKey, szNm
	Dim nRow, nIdx, nSelect
	
	' 콤보 리스트 클리어
	Form.SetCtlProp("cmbGroup", "clear", "")
	
	nRow = grdGroup.rowcount
	nIdx = -1
	nSelect = -1
	szgrpList = ""
	
	
	' ---- 관심종목 그룹 리스트 존재시 Start --------------------------------
	For i = 0 to nRow -1
		szKey = grdGroup.GetCellData("bd_code", i)
		szNm  = grdGroup.GetCellData("bd_name", i)

		if szgrpList == "" then
			szgrpList = szKey & "`" & szNm
		else
			szgrpList = szgrpList & "\r\n" & szKey & "`" & szNm
		end if
		
		if nIdx >= 0 then
			nIdx = nIdx + 1
		else
			nIdx = 0
		end if
		
		if g_subCateogory == szKey then
			nSelect = nIdx
		end if
		
		' 선택된 그룹을 삭제하였을경우의 예외처리
		if i == nRow -1 then
			if nSelect < 0 then
				nSelect = 0
			end if
		end if
	Next
	' ---- 관심종목 그룹 리스트 존재시 End ----------------------------------

	' 관심그룹콤보에 리스트 init		
	cmbGroup.cbinputdatatext = szgrpList

	' 관심그룹콤보에서 최종 저장된 그룹 선택
	cmbGroup.currentindex = CStr(nSelect)
End Function


'============================================================================
Sub ButtonOK_OnClick()
	index = RadioGroup0.currentindex
	sSelectKey = ""
	if index == "2" then
		sSelectKey = "W0" '왓칭
		Form.SetEnvData(1, "common.curtouch_swing", "2")
	elseif index == "1" then			
		sSelectKey = "IN" & "^" & cmbGroup.cbkeydata '관심 종목 선택
		Form.SetEnvData(1, "common.curtouch_swing", "1")
		Form.SetEnvData(1, "common.curtouch_swing_group", cmbGroup.cbkeydata)
	elseif index == "0" then
		sSelectKey = "H0" '히스토리 
		Form.SetEnvData(1, "common.curtouch_swing", "0")
	elseif index == "3" then
		sSelectKey = cbUp1.cbkeydata & "^" & cbUp2.cbkeydata '업종
		Form.SetEnvData(1, "common.curtouch_swing", "3")
		Form.SetEnvData(1, "common.curtouch_swing_jisu", cbUp1.cbkeydata)
		Form.SetEnvData(1, "common.curtouch_swing_jisuitem", cbUp2.cbkeydata)
	end if
	
	Form.ACRSetProp( "category" , sSelectKey )
	Form.ACRSetProp( "time" , Edit0.caption )
	Form.ACRSetProp( "show" , Edit0.caption )
	Form.CloseForm()
End Sub

'============================================================================
Sub ImageClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub cbUp1_OnEditComplete(iIndex)
	InitCombo()
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	cmbGroup.enable = "0"
	cbUp1.enable = "0"
	cbUp2.enable = "0"
	if nIndex == 0 then ' 왓칭 종목
	elseif nIndex == 1 then ' 관심
		if g_nCnt < 1 then	'20230721
			Form.ShowAlert("알림", "등록된 관심그룹이 없습니다.\n관심종목 화면에서 그룹 등록 후 사용해주세요")
			RadioGroup0.currentindex = 0
			exit Sub
		end if
		cmbGroup.enable = "1"
	elseif nIndex == 2 then ' 업종

	elseif nIndex == 3 then ' 최근
		cbUp1.enable = "1"
		cbUp2.enable = "1"		
	else
		 
	end if
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub ImgClose_OnClick()
	Form.CloseForm()	
End Sub

