--===========================================================================
--===========================================================================
Dim g_szItemCode
Dim g_szItemMarket
Dim g_szCode
Dim g_bPopupFg
'============================================================================
Sub Form_OnFormInitBefore()
'시장 인자(2번째 값)
'SEARCH_TYPE_INTR        = "0"
'SEARCH_TYPE_STOCK_ALL   = "1"
'SEARCH_TYPE_STOCK       = "2"
'SEARCH_TYPE_ELW         = "3"
'SEARCH_TYPE_FUOPT       = "4"
'SEARCH_TYPE_ETF         = "5"
'SEARCH_TYPE_ETN         = "6"
'SEARCH_TYPE_BOND        = "7"
'SEARCH_TYPE_OVERSEA     = "8"
'SEARCH_TYPE_JISU        = "9"
'SEARCH_TYPE_K200        = "10"
'SEARCH_TYPE_K200_MINI   = "11"
'SEARCH_TYPE_FUND        = "12"

	Form.SetSearchType ("1:2:3:5:6")
End Sub


'============================================================================
Sub Form_OnFormInit()
	g_bPopupFg = False
	
	Dim szData, arrData, szStyle
	
	szStyle	= Form.LoadConfigData("mhprc11000", "Style"	)	'현재가 스타일
	If szStyle = "0" Then
		linkfmHoga.linkfile = "mhprc11000_s1"
	ElseIf szStyle = "1" Then
		linkfmHoga.linkfile = "mhprc11000_s2"
	ElseIf szStyle = "2" Then
		linkfmHoga.linkfile = "mhprc11000_s3"
	Else
		linkfmHoga.linkfile = "mhprc11000_s2"
	End If
	
	g_szItemCode = Form.GetSharedData("&ITEM_STOCK", 0)		' 최근조회종목
	
	if g_szItemCode = "" then
		g_szItemCode = "008560"
	end if
	
	lbItemCode.caption = g_szItemCode
		
	g_szCd = g_szItemCode
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	Form.SetItemCode(g_szItemCode)
	Form.triggerEvent("linkfmHoga", "INIT_CODE", g_szItemCode) 	
	
						' 링크화면에 종목코드 던지기	
	g_szCd = Change_ItemCode()
	
	DATAMANAGER.SetDataValue(0, "oblon_basc_210r", "InBlock1", "ISCD" , 0 , g_szCd)
	DATAMANAGER.RequestTranData("oblon_basc_210r")
	
End Sub
'============================================================================
Function Change_ItemCode()
 Dim szMk
 
 szMk = Form.GetItemCodeInfo(g_szCd, "market") 

 if Left(g_szCd, 1) = "J" or Left(g_szCd, 1) = "F" then
  return g_szCd
 elseif szMk = "J" or szMk = "T" then '주식
  return "A" & g_szCd
 elseif szMk = "W" then 'ELW
  return "J" & g_szCd
 else
  return g_szCd
 end if 
End Function
'============================================================================
Sub Form_OnRefresh()
	Form.triggerEvent("linkfmHoga", "INIT_CODE", g_szItemCode) 						' 링크화면에 종목코드 던지기
	Form.SetItemCode(g_szItemCode)

End Sub

'============================================================================

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		lbItemCode.caption = g_szItemCode
		
		g_szCd = g_szItemCode
			
		g_szCd = Change_ItemCode()
	
		DATAMANAGER.SetDataValue(0, "oblon_basc_210r", "InBlock1", "ISCD" , 0 , g_szCd)
		DATAMANAGER.RequestTranData("oblon_basc_210r")
	elseif sKey = "&ACR_ITEM" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		Form.SetItemCode(g_szItemCode)
		lbItemCode.caption = g_szItemCode
		
	end	if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "oblon_basc_210r" then
		if DATAMANAGER.GetDataValue(0, "oblon_basc_210r", "OutBlock1", "CRDT_ODER_ABLE_YN", 0) = "Y" then
			Table1.SetCellString(0, 1, "가능")
		else
			Table1.SetCellString(0, 1, "불가능")
		end if
		
		if DATAMANAGER.GetDataValue(0, "oblon_basc_210r", "OutBlock1", "LOAN_ABLE_YN", 0) = "Y" then
			Table0.SetCellString(0, 1, "가능")
		else
			Table0.SetCellString(0, 1, "불가능")

		end if
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "TITLE_CLICK" Then
		If g_bPopupFg = false Then
'			Form.OpenFramePopup("mhprc11000_p1" , "" , "")
			Form.OpenPopup("mhprc11000_p1" , "" , "")
			g_bPopupFg = true
		End If
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "11000_p1_Close" Then
		If Trim(sRet) = "종목없음" Then
			g_bPopupFg = false
		Else
			g_bPopupFg = false
			g_szItemCode = sRet
			g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")			
			lbItemCode.caption = g_szItemCode
			Form.SetItemCode(g_szItemCode)
			
		End If
	end if
End Sub

	</SCRIPT_INFO>
