Sub contMain_cont1_imgAttach1_OnClick()
	' 신용평가서'
	if g_szSymbolData[19] == "" or g_szSymbolData[19] == null then
		Form.ShowAlert("안내", "국고채, 통안채 등 정부발행채권은 신용평가서를 제공하지 않습니다.")
	else	
		szURL = Trim(g_sUrl) & Trim(g_szSymbolData[19])
		
		Form.OpenPdfViewer(szURL, "신용평가서")
	'	Form.ShowAlert("imgAttach1", szURL)
'		Form.OpenExternalBrowser(szURL)
	end if
	
End Sub

