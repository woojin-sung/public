		'5~9
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISNM", 				0))	'5 종목명		
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BYOV_ERT", 			0))  '6 매수수익률
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PRTX_YR_AVRG_INVT_ERT",	0))	'7 세전연평균투자수익률
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RMNN_DYNU", 			0))  '8 잔존일수		
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DEAL_ABLE_QTY", 		0))  '9 매매가능수량
		
		'10~14
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD", 				0))  '10 종목코드
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SRFC_INTRT", 			0))  '11 표면이자율
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DEAL_UNPR", 			0))	'12 매매단가
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PBLC_DATE", 			0))  '13 발행일자
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MTRT_DATE", 			0))  '14 만기일자
		
		'15~19
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INT_PRVS_MTCD_NAME", 	0))	'15 이자지급방법코드명		
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FNCD", 				0))  '16 펀드코드
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INVT_ABLE_AMT", 		0))  '17 투자가능금액					
		
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ATCH_FILE_PATH_NAME",	0))	'18 첨부파일경로명  투자설명서
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ATCH_FILE_PATH_NAME",	1))  '19 첨부파일경로명  신용평가서

'		Form.ShowAlert("TranComplete0", DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ATCH_FILE_PATH_NAME",	0))
'		Form.ShowAlert("TranComplete2", g_szSymbolData[18])
				
		'상품등급 badge_1
		if g_szSymbolData[0] = "01" then
			contMain.cont0.imgBadge1.imgpath = "img_bgsquare_grade_372.png"
			contMain.cont0.lblBadge1.caption = "매우높은위험"	
			contMain.cont0.lblBadge1.fgcolor = 273
		elseif g_szSymbolData[0] = "02" then
			contMain.cont0.imgBadge1.imgpath = "img_bgsquare_grade_373.png"
			contMain.cont0.lblBadge1.caption = "높은위험"	
			contMain.cont0.lblBadge1.fgcolor = 144
		elseif g_szSymbolData[0] = "03" then
			contMain.cont0.imgBadge1.imgpath = "img_bgsquare_grade_374.png"
			contMain.cont0.lblBadge1.caption = "다소높은위험"
			contMain.cont0.lblBadge1.fgcolor = 144
		elseif g_szSymbolData[0] = "04" then
			contMain.cont0.imgBadge1.imgpath = "img_bgsquare_grade_375.png"
			contMain.cont0.lblBadge1.caption = "보통위험"
			contMain.cont0.lblBadge1.fgcolor = 144
		elseif g_szSymbolData[0] = "05" then
			contMain.cont0.imgBadge1.imgpath = "img_bgsquare_grade_376.png"
			contMain.cont0.lblBadge1.caption = "낮은위험"	
			contMain.cont0.lblBadge1.fgcolor = 144
		elseif g_szSymbolData[0] = "06" then
			contMain.cont0.imgBadge1.imgpath = "img_bgsquare_grade_377.png"
			contMain.cont0.lblBadge1.caption = "매우낮은위험"	
			contMain.cont0.lblBadge1.fgcolor = 273
		end if				
	
		'badge_2 신용등급
		contMain.cont0.imgBadge2.imgpath = "img_bgsquare_grade_316.png"
		if (g_szSymbolData[2] == "" or g_szSymbolData[2] == null) and (trim(g_szSymbolData[4]) == "국채" or trim(g_szSymbolData[4]) == "지방채") then
			contMain.cont0.lblBadge2.caption = "국공채"
		else
			contMain.cont0.lblBadge2.caption = g_szSymbolData[2]
		end if
'		contMain.cont0.lblBadge2.fgcolor = 261
		
		'badge_3 채권분류
'		contMain.cont0.imgBadge3.imgpath = "img_bgsquare_grade_366.png"
		contMain.cont0.imgBadge3.imgpath = "img_bgsquare_grade_363.png"
		contMain.cont0.lblBadge3.caption = g_szSymbolData[4]
'		contMain.cont0.lblBadge3.fgcolor = 261
		
		contMain.cont0.lblSymbolCode.caption = g_szSymbolData[10]
		contMain.cont0.lblSymbolName.caption = g_szSymbolData[5]
		
		
		'상품 금리 정보
		contMain.cont0.tblSymbolnfo.SetCellString(2, 0, FormatNumber(CDbl(g_szSymbolData[6]), 3))	'매수금리
		contMain.cont0.tblSymbolnfo.SetCellString(2, 1, FormatNumber(CDbl(g_szSymbolData[7]), 3))	'은행환산 수익률
		
		iYear = CInt(CInt(g_szSymbolData[8]) / 365)
		if iYear >= 1 then
			szValue = iYear & "년 " & (CInt(g_szSymbolData[8]) - (iYear * 365)) & "일"
		else
			szValue = CInt(g_szSymbolData[8]) & "일"
		end if 
		contMain.cont0.tblSymbolnfo.SetCellString(2, 2, szValue)						'투자기간(잔존일수)
		
		g_rmnnDynu = CInt(g_szSymbolData[8])	' v001
		
		'수익률비교   ohhts__7052_005r 서비스 사용
'		contMain.cont1.tblDiff.SetCellString(2, 1, FormatNumber(CDbl(g_szSymbolData[6]), 3))	'장내매수금리
		contMain.cont1.tblDiff.SetCellString(2, 3, FormatNumber(CDbl(g_szSymbolData[6]), 3))	'장외매수금리
		
		'상품 기본정보
		contMain.cont1.tblInfo.SetCellString(1, 1, g_szSymbolData[14])	'만기일
		contMain.cont1.tblInfo.SetCellString(2, 1, g_szSymbolData[13])	'발행일
		contMain.cont1.tblInfo.SetCellString(3, 1, g_szSymbolData[4])	'채권분류
		if (g_szSymbolData[2] == "" or g_szSymbolData[2] == null) and (trim(g_szSymbolData[4]) == "국채" or trim(g_szSymbolData[4]) == "지방채") then
			contMain.cont1.tblInfo.SetCellString(4, 1, "국공채")	'신용등급
		else
			contMain.cont1.tblInfo.SetCellString(4, 1, g_szSymbolData[2])	'신용등급
		end if 


		contMain.cont1.tblInfo.SetCellString(1, 3, g_szSymbolData[11])	'표면금리
		if (CInt(g_szSymbolData[9]) / 1000 < 1000) then
			contMain.cont1.tblInfo.SetCellString(2, 3, "SOLD OUT")
			'contMain.cont0.lblAmt.caption = "SOLD OUT"
			'contMain.cont0.lblAmt.fgcolor = 6
		else
			contMain.cont1.tblInfo.SetCellString(2, 3, FormatNumber(g_szSymbolData[9]/1000, 0) .. "(천)")
			'contMain.cont0.lblAmt.caption = FormatNumber(g_szSymbolData[9], 0) .. "원"
		end if
		'이자지급방식 : INT_PRVS_MTCD_NAME 를 스페이스로 구분하여 이자지급방식과 이자지급주기로 나눠줌
		szTmpData = g_szSymbolData[15]
		contMain.cont1.tblInfo.SetCellString(3, 3, Mid(szTmpData, InStr(szTmpData, " ")+1, Len(szTmpData)-InStr(szTmpData, " ")+1 ))	'이자지급방식
		contMain.cont1.tblInfo.SetCellString(4, 3, Left(szTmpData, InStr(szTmpData, " ")))	'이자지급주기


'		contMain.cont1.tblInfo.SetCellString(2, 2, g_szSymbolData[10])	'종목코드
'		contMain.cont1.tblInfo.SetCellString(3, 2, FormatNumber(CDbl(g_szSymbolData[11]), 2) + "%" )	'표면금리
'		contMain.cont1.tblInfo.SetCellString(2, 3, g_szSymbolData[12])	'매수단가		
'		contMain.cont1.tblInfo.SetCellString(3, 3, szValue)	'투자기간
		
		if CDbl(g_szSymbolData[12]) == 0 then
			contMain.cont1.tblDiff.SetCellString(3, 3, "매수단가없음")
		else
			contMain.cont1.tblDiff.SetCellString(3, 3, "매수단가 " .. FormatNumber(g_szSymbolData[12], 0) .. "원")
		end if
		
		DATAMANAGER.RequestTranData( "ohhts_7052_005r" )
		
	'end of if szTranID == "obsab_deal_603r"
	
	elseif szTranID == "obsab_deal_603r_1" then		
		g_szSymbolData = {}
		
		'0~4
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_PROD_GRAD_CODE",	0))  '0 KYC상품등급코드
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SEQ_NO",				0))	'1 순서번호
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CRDT_GRAD_CODE", 		0))  '2 신용등급코드
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BOND_DIV_CODE", 		0))	'3 채권분류코드
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BOND_DIV_NAME", 		0))	'4 채권분류명		
		
		'5~9
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISNM", 				0))	'5 종목명		
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BYOV_ERT", 			0))  '6 매수수익률
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PRTX_YR_AVRG_INVT_ERT",	0))	'7 세전연평균투자수익률
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RMNN_DYNU", 			0))  '8 잔존일수		
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DEAL_ABLE_QTY", 		0))  '9 매매가능수량
		
		'10~14
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD", 				0))  '10 종목코드
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SRFC_INTRT", 			0))  '11 표면이자율
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DEAL_UNPR", 			0))	'12 매매단가
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PBLC_DATE", 			0))  '13 발행일자
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MTRT_DATE", 			0))  '14 만기일자
		
		'15~19
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INT_PRVS_MTCD_NAME", 	0))	'15 이자지급방법코드명		
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FNCD", 				0))  '16 펀드코드
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INVT_ABLE_AMT", 		0))  '17 투자가능금액					
		
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ATCH_FILE_PATH_NAME",	0))	'18 첨부파일경로명  투자설명서
		table.insert(g_szSymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ATCH_FILE_PATH_NAME",	1))  '19 첨부파일경로명  신용평가서
		
		'20240220 장외매수시 수량체크
		if (CInt(g_szSymbolData[9]) / 1000) < 1000 then
			Form.ShowAlert("알림", "해당 상품은 SOLD OUT 되었습니다.")
			exit sub
		end if 
		
'		Form.ShowAlert("TranComplete3", g_szSymbolData[18])
		
		Form.SetSharedData("MBONL88060_P1_KOR_ISNM",		g_szSymbolData[5])	'종목명
		Form.SetSharedData("MBONL88060_P1_PBLC_DATE",		g_szSymbolData[13])	'발행일
		Form.SetSharedData("MBONL88060_P1_MTRT_DATE",		g_szSymbolData[14])	'만기일
		Form.SetSharedData("MBONL88060_P1_CRDT_GRAD",		g_szSymbolData[2])	'신용등급
		'20240202 mbonl88060_p14에서 국공채 표시 위해 추가
		Form.SetSharedData("MBONL88060_P1_PROD_TYPE",		g_szSymbolData[4])	'채권상품분류
		
		if g_szSymbolData[0] = "01" then
			szData = "매우높은위험"
		elseif g_szSymbolData[0] = "02" then
			szData = "높은위험"
		elseif g_szSymbolData[0] = "03" then
			szData = "다소높은위험"
		elseif g_szSymbolData[0] = "04" then
			szData = "보통위험"
		elseif g_szSymbolData[0] = "05" then
			szData = "낮은위험"
		elseif g_szSymbolData[0] = "06" then
			szData = "매우낮은위험"
		end if		
		Form.SetSharedData("MBONL88060_P1_PROD_GRAD_CODE", szData)	'투자등급
		
		'금융소비자 유형 확인 및 위험등급 확인 진행 후 매수 프로세스 진행.
		Form.OpenPopup("mbonl81010_p20" , "" , "")
		
	elseif szTranID == "ohhts_7052_005r" then
		szValue = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_NEW_SELN_ERNN_RATE1", 	0)
'		szPRPR = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_PRPR", 	0)
		szPRPR = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_FUTS_OPTN_ASKP", 	0)
	
'		Form.ShowAlert("Trancomplte1", szValue)
		if szValue == "" then
			szValue = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_NEW_ERNN_RATE", 	0)
		else			
			contMain.cont1.tblDiff.SetCellString(2, 1, FormatNumber(CInt(CDbl(szValue) * 100) / 100) .. "%")	'장내매수금리
		end if
'		Form.ShowAlert("Trancomplte2", szValue)
		
		if szValue == "" then
			contMain.cont1.tblDiff.SetCellString(2, 1, "-")	'장내매수금리
		else
			contMain.cont1.tblDiff.SetCellString(2, 1, FormatNumber(CInt(CDbl(szValue) * 100) / 100) .. "%")	'장내매수금리
		end if
'		Form.ShowAlert("Trancomplte3", szValue)
		
		if CDbl(szValue) == 0 then
'			contMain.cont1.tblDiff.SetCellString(2, 1, "호가 미제공")
			contMain.cont1.tblDiff.SetCellString(2, 1, "매도호가없음")
			contMain.cont1.tblDiff.SetCellString(3, 1, "매수단가없음")
		end if
		
		if CDbl(szPRPR) == 0 then
			contMain.cont1.tblDiff.SetCellString(3, 1, "매수단가없음")
		else
'			contMain.cont1.tblDiff.SetCellString(3, 1, "매수단가 " .. szPRPR .. "원")
			contMain.cont1.tblDiff.SetCellString(3, 1, "매수단가 " .. FormatNumber(szPRPR, 0) .. "원")
		end if
		
	'LHR 투자성향진단 추가
	elseif szTranID == "obcsb_acif_700r" then
		Dim szProsYN
		
		szProsYN	=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "PROS_YN", 0)
		g_szKYC_INVT_RCMD_CLS_CODE 	=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "KYC_INVT_RCMD_CLS_CODE", 0) '적정성상품여부 v011
		g_szAPRT_SRNM_PROD_YN		=	DATAMANAGER.GetDataValue(0, "obcsb_acif_700r", "OutBlock1", "APRT_SRNM_PROD_YN", 0) 'KYC투자권유구분코드 v011
		szHgdtYN = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "HGDT_PROD_YN", 0)	'
		Form.SetSharedData("KYC_INVT_RCMD_CLS_CODE"	, g_szKYC_INVT_RCMD_CLS_CODE) 'v011
		Form.SetSharedData("MBONL88060_PROS_YN"	, szProsYN)

		Dim szAlertData
		if szProsYN = "A" then '투자성향 등록여부
			g_ErrTitle = "투자자정보등록 안내"
			g_ErrMsgText = "고객님의 투자성향 정보가\n등록되지 않아 상품 가입이 불가합니다.\n\n투자성향 등록 후 진행해 주세요."
			szAlertData = "2".."★"..g_ErrTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."투자성향 등록"
			
			Form.OpenPopup("mbonl88060_p8", szAlertData, "")
	
		elseif szProsYN = "B" then '투자성향 만기여부
			g_ErrTitle = "투자자정보 만료 안내"
			g_ErrMsgText = "고객님의 투자성향 만기가 경과되어\n해당 상품 가입이 불가합니다.\n\n투자성향 등록 후 진행해주세요."
			szAlertData = "2".."★"..g_ErrTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."투자성향 등록"
			
			Form.OpenPopup("mbonl88060_p8", szAlertData, "")
			
		elseif szProsYN	=	"S"	then	 '취약금융 소비자 여부
			Form.MsgBox("취약금융소비자 투자보호 안내" , "고객님은 취약금융소비자입니다. 투자자보호를 위해 투자성향보다 위험등급이 한단계를 초과한 상품가입이 불가합니다.", "", "6")

		'KEK.투자성향 공통팝업 테스트_20240111
'		elseif  g_szAPRT_SRNM_PROD_YN = "Y" THEN '부적합 상품 거래 확인서
'			Form.OpenPopup("mbbdm85145", "", "")
'			Exit Sub
		'KEK.투자성향 공통팝업 테스트_20240111
		
		else
			Dim szData
			
			szData = ""
			for i = 0 to #g_szSymbolData - 1
				szData = szData & g_szSymbolData[i]  & "|"
			next
			
			szData = szData 			&
					'0 KYC상품등급코드
					'1 순서번호
					'2 신용등급코드
					'3 채권분류코드
					'4 채권분류명		
					'5 종목명		
					'6 매수수익률
					'7 은행예금환산수익률
					'8 잔존일수		
					'9 매매가능수량
					'10 종목코드
					'11 표면이자율
					'12 매매단가
					'13 발행일자
					'14 만기일자
					'15 이자지급방법코드명
					'16 펀드코드			
					'17 투자가능금액
					'18 첨부파일경로명  투자설명서
					'19 첨부파일경로명  신용평가서
					g_szAccount		& "|" &	'20 계좌번호
					g_szAccountSeq	& "|" &  '21 계좌seq
					g_szList(3)		& "|" &  '22 계좌비번
					g_szList(4)		& "|" &  '23 전문투자자여부
					g_szList(5)       	     '24 전문투자자 만료여부
			
			Form.OpenPopup("mbonl90201_s2", szData, "")
			
		end if	
		
	end if
End Sub

