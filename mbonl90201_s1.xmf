	<SCRIPT_INFO _len="33475" _ulen="29147" >

'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 장외채권 상품상세
' 02. 화면설명 : 장외채권 상품 상세 화면
' 03. 작    성 : 
'  2023.11.06  신규 작성
'     Bond Home  	mbonl90001_s2
' 2024.06.18. 박윤경 : v001. 채권 이자 지급 일자 알림 메시지 팝업 순서 변경
'-------------------------------------------------------------------------------------------

'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_szUSERID
Dim g_szLinkData, g_szList
Dim g_szSymbolCode, g_szSymbolData
g_szSymbolData = {}

Dim g_szFnprJoinSrno	'금융상품일련번호
g_szFnprJoinSrno = ""

Dim g_szAccount, g_szAccountSeq
Dim g_nMode, g_sUrl

Dim g_rmnnDynu	' 잔존일수 v001

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************





'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.setMaintainingRatio("1")
	imgInfo.setMaintainingRatio("1")
	
'	contMain.cont0.imgBadge1.setMaintainingRatio("1")
	contMain.cont0.imgBadge2.setMaintainingRatio("1")
	contMain.cont0.imgBadge3.setMaintainingRatio("1")
	
	contMain.cont1.ImageAttach1.setMaintainingRatio("1")
	contMain.cont1.ImageAttach2.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		contMain.setScrollBarVisible("2")
	end if
	
	g_szLinkData = Form.GetOpenLinkData()	
	
	if g_szLinkData == "" or g_szLinkData == null then
		Exit Sub
		
	end if 
	
'	Form.ShowAlert("90201_s1_FormInit", g_szLinkData)
	g_szList = Split(g_szLinkData, "|")	
	
	'0 종목코드
	'1 계좌번호
	'2 계좌seq
	'3 계좌비번
	'4 전문투자자여부
	'5 전문투자자 만료여부
	
	If g_szLinkData <> "" And g_szLinkData <> null Then
		g_szSymbolCode	= g_szList(0)
		g_szAccount		= g_szList(1)
		g_szAccountSeq	= g_szList(2)
	
		DATAMANAGER.RequestTranData( "obsap_acif_999a" )
		DATAMANAGER.RequestTranData( "obsab_deal_603r" )
	
	else
		g_szSymbolCode = ""
		
	end if
	
	'고객ID
	g_szUSERID = Form.GetSharedData("&USER_ID", false )
	
	g_nMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	if g_nMode == "0" then
		g_sUrl = "https://home.imeritz.com/include/resource/comm/ctcn/nfiles/"	'운영계 주소
'		g_sUrl = "http://home.imeritz.com/include/ocw/"
	elseif g_nMode == "1" then
		g_sUrl = "https://testhome.imeritz.com/include/resource/comm/ctcn/nfiles/"	'테스트계주소
'		g_sUrl = "http://testhome.imeritz.com/include/ocw/"
	end if
	
End Sub


'============================================================================
Sub imgInfo_OnClick()
	Form.OpenPopup("mbonl90201_p4", "", "")
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("MBONL88060_P1_KOR_ISNM", "")	'종목명
	Form.SetSharedData("MBONL88060_P1_PBLC_DATE", "")	'발행일
	Form.SetSharedData("MBONL88060_P1_MTRT_DATE", "")	'만기일
	Form.SetSharedData("MBONL88060_P1_CRDT_GRAD", "")	'신용등급
	Form.SetSharedData("MBONL88060_P1_PROD_GRAD_CODE", "")	'투자등급
	Form.SetSharedData("MBONL88060_P1_PROD_TYPE", "")	'채권상품분류

	Form.SendReturnToParent("mbonl90201_s1", g_szRet)
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	g_szRet = "STAY"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mbonl90201_s2" then	
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			if sRet <> "GO_BACK" then
				g_szRet = sRet
				Form.CloseForm()
			end if
		end if

	'===============================================
	'********** 공통 얼럿 팝업 리턴      ***********
	'===============================================
	ElseIf sKeyName == "errMsgBox"  Then
		if sRet = "Right" then	'투자성향 등록 화면으로 이동
			Form.OpenFramePopup("mbonl81010" , "mbonl88060" , "")
		end if	
		
	Elseif sKeyName == "mbonl81010_p20_CLOSE" then		
		'장외 매수하기 선택 후 팝업 리턴
		if sRet == "NEXT_mbonl81010_p20" then			
			'// case1) 계좌번호 + 종목코드로 obcsb_acif_400r
			'// case2) 계좌번호 + 상품등급으로 obcsb_acif_701r 
			Form.SetSharedData("FNP51000_P8_ACC_NO", g_szAccount)	'계좌번호
			Form.SetSharedData("FNP51000_P8_ISCD", g_szSymbolCode)		'종목코드
			Form.SetSharedData("FNP51000_P8_PROD", "")			'상품등급
			
			Form.OpenPopup("mbfnp51000_p8", "", "")	'투자성향 및 위험등급 확인 팝업 호출
			
'			DATAMANAGER.RequestTranData( "obsac_deal_209a" )
		elseif sRet == "CANCEL_mbonl81010_p20" then
			'do nothing!!!
		end if
		
	Elseif sKeyName == "mbfnp51000_p8" then	'고객투자성향안내팝업
		'투자성향 재진단으로 연결
		if sRet == "MOVE" then
			g_szRet = sRet
			Form.CloseForm()
		
		'다음으로 진행
		elseif sRet == "NEXT_mbfnp51000_p8" then
			'투자성향등록여부, 투자성향만기여부
			'DATAMANAGER.RequestTranData( "obcsb_acif_700r" )
			'KEK.투자성향 공통팝업 테스트_20240111
			Form.OpenPopup("mbonl81010_p1" , "90201★1★" & g_szAccount & "★" &  g_szAccountSeq & "★" &  g_szSymbolCode)
		else
		
		end if
	'KEK.투자성향 공통팝업 테스트_20240111
	Elseif	sKeyName = 	"KYCCHK_RETURN"	then
		if	sRet	=	"Y"	then	'예				
			g_szDRVT_YN			= Form.GetSharedData("KYC_DRVT_PROS_YN", 0 )	'6. '파생상품등급코드
			g_szDRVT_YN			= Form.GetSharedData("KYC_DRVT_PROS_YN", 0 )	'7. KYC 파생 처리 여부
			g_szCAFU_TRGT_YN		= Form.GetSharedData("CAFU_TRGT_YN", 0 )	'8. v006. 숙려대상여부 
			
			'g_Reg_YN = "Y"
			lblBuy2.enable = true
			
			Dim szData
			
			szData = ""
			for i = 0 to #g_szSymbolData - 1
				szData = szData & g_szSymbolData[i]  & "|"
			next
			
			szData = szData 			&
					'0 KYC상품등급코드
					'1 순서번호
					'2 신용등급코드
					'3 채권분류코드
					'4 채권분류명		
					'5 종목명		
					'6 매수수익률
					'7 은행예금환산수익률
					'8 잔존일수		
					'9 매매가능수량
					'10 종목코드
					'11 표면이자율
					'12 매매단가
					'13 발행일자
					'14 만기일자
					'15 이자지급방법코드명
					'16 펀드코드			
					'17 투자가능금액
					'18 첨부파일경로명  투자설명서
					'19 첨부파일경로명  신용평가서
					g_szAccount		& "|" &	'20 계좌번호
					g_szAccountSeq	& "|" &  '21 계좌seq
					g_szList(3)		& "|" &  '22 계좌비번
					g_szList(4)		& "|" &  '23 전문투자자여부
					g_szList(5)       	     '24 전문투자자 만료여부
			
			Form.OpenPopup("mbonl90201_s2", szData, "")
		else	'아니오
			'g_Reg_YN = "N"
'			lblBuy2.enable = false
			Exit Sub
		'KEK.투자성향 공통팝업 테스트_20240111
		
		end if	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szTranID == "obsab_deal_603r" or szTranID == "obsab_deal_603r_1" then
		if szErrCode == "1590" then
			Form.MsgBox("알림", "장외파생전용계좌는 매매가 불가합니다.", "", 0)
		elseif szErrCode == "5228" then
			Form.MsgBox("알림", "매수가능 수량이 부족합니다.\n잔여수량을 다시 확인해주세요.", "RELOAD", 0)
		'KEK STA. 주석 처리.메시지 추가
		'elseif szErrCode == "6660" then
		'	Form.MsgBox("알림", "매수 가능 시간은 15:00 까지 입니다.", "", 0)
		elseif szErrCode == "9906" then
			Form.ShowAlert( "알림" , szSubErr)			
			Exit Sub
		'KEK FIN.
		elseif szErrCode == "7100" then
			Form.MsgBox("알림", "매수가능금액이 부족합니다.", "RELOAD_1", 0)
		'KEK 6629 영업일체크 추가
		elseif szErrCode == "6229" then
			Form.ShowAlert( "알림" , "주문은 영업일만 가능합니다.")			
			Exit Sub
		else
			Form.ShowAlert( "알림" , szSubErr)			
			Exit Sub
		end if
		
	else
		if szSubErr <> null and Trim(szSubErr) <> "" then
			Form.ShowAlert( "알림" , szTranID.."\n"..szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
		else
			Form.ShowAlert( "알림" , szTranID.."\n"..szErrCode .. " : ".. szErrMsg)
		end if
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obsab_deal_603r" then
		'장외채권 상품 상세 정보		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID",	0, g_szUSERID)  	  'ID
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",		0, g_szAccount)  	  '계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",		0, g_szAccountSeq)  '계좌일련번호
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD",	0, "")  			  '비밀번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD",		0, g_szSymbolCode)  '종목코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE", 0, "A")  '조회구분코드  A:시간체크 없음 , B:시간체크 있음
				
	'end of if szTranID == "obsab_deal_603r"
	
	elseif szTranID == "obsab_deal_603r_1" then
		'장외채권 상품 상세 정보		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID",	0, g_szUSERID)  	  'ID
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",		0, g_szAccount)  	  '계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",		0, g_szAccountSeq)  '계좌일련번호
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD",	0, "")  			  '비밀번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD",		0, g_szSymbolCode)  '종목코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE", 0, "B")  '조회구분코드  A:시간체크 없음 , B:시간체크 있음
				
	'end of if szTranID == "obsab_deal_603r_1"
	
	elseif szTranID == "ohhts_7052_005r" then
		'채권 현자가 (장내수익률 표시 위해서)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "B") '시장분류코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 0 , g_szSymbolCode)  	'종목코드
	
	elseif szTranID == "obcsb_acif_700r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"				, 0 , g_szAccount)	'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"				, 0 , g_szAccountSeq)	'계좌일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "KYC_BSWR_DIV_CODE"	, 0 , "01" )	'KYC 업무 분류 코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BSWR_DIV_CODE"		, 0 , "13005" )	'업무 분류 코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD"				, 0 , g_szSymbolCode)
		
	end if  
	
End Sub

