'============================================================================
Sub lblBuy0_OnClick()
	'에상수익(가상투자하기)
	Dim szLinkData
	
	if g_szSymbolCode == "" or g_szSymbolCode == null then
		Exit sub
	
	else	
		szLinkData = g_szSymbolCode		& "★" &		'종목코드
				    Form.GetSharedData("&HOST_DATE", false)	& "★" &		'매수날짜
				    g_szSymbolData[6]				'매수수익률
			
		if Trim(g_szSymbolCode) <> "" then
			Form.OpenPopup("mhprc54000_p5", szLinkData, "")
		end if
	end if
End Sub

'============================================================================
Sub lblBuy1_OnClick()
	'장내매수하기
	Dim szLinkData, szValue
	
	' v001 sta
	tmp = g_rmnnDynu +1	
	
	if 1 <= tmp and tmp <=3 then	
		Form.ShowAlert( "알림" , "채권 이자 지급 " .. (tmp) .. "일전에는\n거래가 정지돼요.")		
		Exit sub
	elseif tmp < 1 then
		Form.ShowAlert( "알림" , "채권 이자 지급 당일에는\n거래가 정지돼요.")	
		Exit sub
	
	end if
	' v001 fin
	
	if g_szSymbolCode == "" or g_szSymbolCode == null then
		Exit sub
	
	else	
		szLinkData = "채권시세표"		& "★" &
					"0" 				& "★" &
					g_szSymbolCode	& "★"
					
		szValue = Form.GetItemCodeInfo(g_szSymbolCode, "innermarket")
		if szValue == "020" then
			szLinkData = szLinkData & "B"
			
		elseif szValue == "019" then
			szLinkData = szLinkData & "SB"
		
		elseif szValue == "" then
			Form.ShowAlert("알림", "선택상품은 MTS에서 거래되지 않는 상품입니다.")
			exit sub
			
		end if
		
'		Form.ShowAlert("lblBuy1_OnClick", szLinkData)			
'		Form.OpenPopup("mbfnp54021", szLinkData, "")
		
		'장외채권 탭으로 저장
		Form.SetSharedData("mbonl90000_TAB", 2)
		Form.OpenScreen(54020, szLinkData)
	end if
End Sub

