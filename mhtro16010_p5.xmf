	<SCRIPT_INFO _len="13973" _ulen="12877" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 해외주식 관심종목 종목추가
' 02. 화면설명 : 해외주식주식현재가 종목추가
' 03. 작    성 : 2021.05.26 YYJ
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szCode, g_szAction
g_szCode = ""
g_szAction = "ADD"

Dim g_szRow
Dim g_szGroupID, g_szGroupName

Dim g_szUserId
g_szUserId = Form.GetSharedData("&USER_ID" , false)	

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Change_Len
'============================================================================
Function Change_Len(szData)
	if Len(szData) == 1 then
		Change_Len = "0" & CStr(szData)
	else
		Change_Len = CStr(szData)
	end if 
End Function

'============================================================================
' Check_LocalOrServer
'============================================================================
Function Check_LocalOrServer()
	DATAMANAGER.RequestTranData("ohhts_intr_039r")	
	Form.Toast(0, "등록되었습니다.", true)
	Form.SendReturnToParent("mhtro16010_save" , g_szGroupID & "★" & g_szGroupName& "★" & g_szAction) '20230511 KKM 관심종목등록 알림 START	
End Function

'============================================================================
' Insert_GrdList : grdList에 종목 추가
'============================================================================
Function Insert_GrdList()

	if Trim(g_szCode) <> "" then
		grdList.insertrow = 0
		grdList.SetCellData("bd_memo", 0, "")
		Dim szMk, szCode
		szMk = ""
		if Trim(g_szCode) <> "" then
			if Instr(1, g_szCode, "@") > 0	then								
				tCode = Split(g_szCode, "@")
				szMk = tCode[0]
				szCode = tCode[1]
			end if
		end if
		
		grdList.SetCellData("bd_code", 0, szCode)		
		grdList.SetCellData("bd_mk", 0, szMk)
		
		szName = Form.GetItemCodeInfo(g_szCode, "name")
		grdList.SetCellData("bd_name", 0, szName)
	end if
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================

'============================================================================
Sub Form_OnFormInit()
	Dim szData, arrData

	szData = Form.GetOpenLinkData()
	
	if Trim(szData) = "" then
	    Exit sub
	End if	
	
	'20230516 HSZ START 	: 관심종목 삭제 로직 추가 - 기존화면에서는 종목코드만 넘겨줌
	szInstr = CInt(Instr(szData, "★"))
	if szInstr > 0 then	'추가로직
		arrData = Split(szData, "★")	
		g_szCode = arrData(0)		'종목코드
		g_szAction = arrData(1)	'관심종목추가(ADD) or 삭제(DEL)
	else					'기존로직
		BtnClose.btnimage = "alpha128"
		g_szCode = szData
		g_szAction = "ADD"
	end if
	
	if g_szAction == "DEL" then
		lblTitle.caption = "관심 삭제"
		lblMemo.caption = "종목을 삭제할 관심그룹을 선택해주세요"
		btnSave.caption = "삭제"
	end if
	'20230516 HSZ END
	
	' 그리드 로우 위치 변경 위한 속성
'	grdGroup.rowmove = "1"
'	grdGroup.scrollenable = "0" 
	
	DATAMANAGER.RequestTranData("ohhts_intr_036r")
	if g_szAction == "DEL" then
		'종목이 속한 관심그룹명 조회 
		DATAMANAGER.RequestTranData("ohhts_intr_101r")
	end if 
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_036r" then
		DATAMANAGER.SetDataValue(0, "ohhts_intr_036r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))	' USER ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_036r", "InBlock1", "FID_KIND_CODE", 0, "1")	' 통합구분 (0:국내해외통합, 1:해외주식전용)
	
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_037r" then
		grdList.rowcount = "0"
		DATAMANAGER.SetDataValue(0, "ohhts_intr_037r", "InBlock1", "FID_USER_ID",          0, Form.GetSharedData("&USER_ID", false))	' USER ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_037r", "InBlock1", "FID_KIND_CODE",         0, "1")	' 통합구분 (0:국내해외통합, 1:해외주식전용)
		DATAMANAGER.SetDataValue(0, "ohhts_intr_037r", "InBlock1", "FID_CNCN_ISSU_GRP_ID", 0, g_szGroupID)								' 관심그룹ID	
	' ----------------------------------------------------------------------
	' 관심 수정 TR : 종목추가, 빈칸추가
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_039r" then
		DATAMANAGER.ClearInputData(false, "ohhts_intr_039r")
		DATAMANAGER.ClearOutputData(false, "ohhts_intr_039r")
		
		if not isNull(g_szGroupID) then
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock1", "FID_USER_ID",     0, Form.GetSharedData("&USER_ID", false))	' FID사용자ID
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock1", "FID_KIND_CODE",     0, "1")								' 통합구분 (0:국내해외통합, 1:해외주식전용)
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)						' FID버전ID	
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock1", "FID_MOD_YN",      0, "0")									' FID수정여부				
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock1", "FID_ISSU_MOD_YN", 0, "0")									' FID종목수정여부
			
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock2", "FID_CNCN_ISSU_GRP_ID", 0, g_szGroupID)						' FID관심종목그룹ID
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock2", "FID_CNCN_GRP_NAME",    0, g_szGroupName)						' FID관심그룹명	
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock2", "FID_ISSU_MOD_YN",      0, "1")
	
			For j = 0 to grdList.rowcount - 1
				' FID관심종목그룹			
				DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_CNCN_ISSU_GRP_ID",    j, g_szGroupID)
				' FID관심종목
				DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_CNCN_ISSU_ID2",       j, Change_Len(j))
				' FID코드구분코드
				if Trim( grdList.GetCellData("bd_mk", j)) == "" then													
					if Trim(grdList.GetCellData("bd_name", j)) == "" then
						DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_CODE_CLS_CODE", j, "2")	' 빈칸
					else
						DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_CODE_CLS_CODE", j, "3")	' 메모
					end if
				else
					DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_CODE_CLS_CODE", j, "1")		' 종목
				end if
	
				' FID입력시장구분코드
				DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_INPUT_MRKT_CLS_CODE", j, "OV")	
				DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_COND_MRKT_CLS_CODE", j, grdList.GetCellData("bd_mk", j) )' FID입력시장구분코드	
	
				' FID관심종목코드 / FID메모내용
				if Trim(grdList.GetCellData("bd_code", j)) == "빈칸" or Trim(grdList.GetCellData("bd_code", j)) == "EMPTY" then
					DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_OVDV_ISCD", j, "EMPTY")
					DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_MEMO_CNTT", j, grdList.GetCellData("bd_memo", j))	
				else
					DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_OVDV_ISCD", j, grdList.GetCellData("bd_code", j))
				end if
			Next
		end if
	' ----------------------------------------------------------------------
	' 관심 수정 TR :그룹추가
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_038r" then
		DATAMANAGER.ClearInputData(false, "ohhts_intr_038r")
		DATAMANAGER.ClearOutputData(false, "ohhts_intr_038r")
		' ////////////// 종목추가, 빈칸적용시 ////////////////
		' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_038r", "InBlock1", "FID_USER_ID",     0, Form.GetSharedData("&USER_ID", false))

		' 통합구분 (0:국내해외통합, 1:해외주식전용)
		DATAMANAGER.SetDataValue(0,"ohhts_intr_038r", "InBlock1", "FID_KIND_CODE" ,     0, "1")	
		' FID버전ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_038r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)	
		' FID수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_038r", "InBlock1", "FID_MOD_YN",      0, "0")				
		' FID종목수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_038r", "InBlock1", "FID_ISSU_MOD_YN", 0, "0")					
		
		'///// 그룹이 없을경우만 등록하므로 그룹ID, 그룹명 고정
		' FID관심종목그룹ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_038r", "InBlock2", "FID_CNCN_ISSU_GRP_ID", i, "00")
		' FID관심그룹명
		DATAMANAGER.SetDataValue(0, "ohhts_intr_038r", "InBlock2", "FID_CNCN_GRP_NAME",    i, "관심종목00")	

		' FID종목수정여부
		'if cmbGroup.cbkeydata == grdGroup.GetCellData("bd_code", i) then	
		'if g_szCode == grdGroup.GetCellData("bd_code", i) then	
		
		'	DATAMANAGER.SetDataValue(0, "ohhts_intr_038r", "InBlock2", "FID_ISSU_MOD_YN", i, "1")			' 수정
		'else
			DATAMANAGER.SetDataValue(0, "ohhts_intr_038r", "InBlock2", "FID_ISSU_MOD_YN", i, "0")			' 수정안함
		'end if
	'202300510 KKM START : 관심종목 설정
	elseif szTranID = "ohhts_intr_101r" then
		g_szGroupID = "" 
		g_szGroupName = ""	
		grdGroup.rowcount = 0	' 그룹그리드 초기화
	
		DATAMANAGER.SetDataValue( 0, "ohhts_intr_101r", "InBlock1", "FID_USER_ID", 0 , g_szUserId 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_intr_101r", "InBlock1", "FID_OVDV_ISCD", 0 , g_szCode	)	
		
	elseif szTranID == "ohhts_intr_102r" then  '관심종목 삭제
		DATAMANAGER.ClearInputData(0, "ohhts_intr_102r")		
		grdList.rowcount = 0	' 종목그리드 초기화
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock1", "FID_USER_ID" , 0 , g_szUserId )
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock1", "FID_VRSN_ID"	, 0 , edtvrsnID.caption)	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock2", "FID_OVDV_ISCD", 0 , g_szCode )		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_102r", "InBlock3", "FID_CNCN_ISSU_GRP_ID", 0 , g_szGroupID )	
	'202300510 KKM END	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' 관심그룹 조회
	If szTranID = "ohhts_intr_036r" Then
		grdGroup.selectrow = 0		
		grdGroup_OnClickUp(0, "bd_name")
	' 관심 종목 조회
	ElseIf szTranID = "ohhts_intr_037r" Then
		Insert_GrdList()
	' 관심그룹추가
	ElseIf szTranID = "ohhts_intr_038r" Then
		grdGroup.rowcount = 0
		grdList.rowcount = 0
		DATAMANAGER.RequestTranData("ohhts_intr_036r")
	ElseIf szTranID = "ohhts_intr_101r" then ' 삭제
		grdGroup.selectrow = 0		
		grdGroup_OnClickUp(0, "bd_name")
	ElseIf szTranID = "ohhts_intr_102r" then
			
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

End Sub

'============================================================================
' null 체크
'============================================================================
Sub isNull(str)
	if null == str or "" == str or Len(Trim(str)) <= 0 then
		return true
	end if
	
	return false
end Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnSave_OnClick()
	Dim nRowCount
	nRowCount = CInt(grdList.rowcount)
	
	if g_szAction == "ADD" then
		if grdGroup.rowcount == 0 or grdGroup.rowcount == "0" then
			Form.MsgBox("알림", "등록된 관심그룹이 없습니다.\n 관심그룹을 새로 등록하시겠습니까?", "ADD_GROUP", 1)
		elseif nRowCount > 100 then
			Form.ShowAlert( "알림", "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
		else
			Check_LocalOrServer()
			Form.CloseForm()
		end if
	else
		Check_LocalOrServer()
		Form.CloseForm()	
	end if 
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub grdGroup_OnClickUp(lRow, szCellID)
	g_szRow = lRow
	g_szGroupID   = grdGroup.GetCellData( "bd_code", lRow )
	g_szGroupName = grdGroup.GetCellData( "bd_name", lRow )

	grdList.rowcount = 0
	
	' 관심종목 종목 조회
	DATAMANAGER.RequestTranData("ohhts_intr_037r")
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	' 그룹추가
	if sKeyName == "ADD_GROUP" then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData("ohhts_intr_038r")
		else
			Form.CloseForm()
		end If
	end if
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub
