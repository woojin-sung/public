	<SCRIPT_INFO _len="2553" _ulen="2419" >
'----------------------------------------------------------------------------
' 01. 화 면 명 : 로그인-공인인증서 만료공지 팝업
' 02. 화면설명 : 로그인-공인인증서 만료공지 팝업
' 03. 작    성 : 2017.03.10 NOHES
'----------------------------------------------------------------------------
Dim g_szType, g_szExpireDate, g_szToday, g_szCalcDate
Dim g_Savekey

'당일 기준으로 안보임 여부를 체크함.
'============================================================================
Sub Form_OnFormInitBefore()
	g_szToday = Form.GetSharedData("&HOST_DATE",0 )

	g_SaveKey = "CertExpiredPopup_" & g_szToday	
	
	sEnvData = Form.GetEnvData(g_SaveKey)

	if sEnvData == "1" Then
		Form.CloseForm()
	End if
End Sub

'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()
	
	t_Data = Split(szData, "★")
	
	if UBOUND(t_Data) < 1 then
		Exit Sub
	end if
	
	if UBOUND(t_Data) > 0 then
		g_szType = t_Data(0)
		g_szExpireDate = t_Data(1)
	end if

	'이미 만료된 경우
	if g_szType == "1" Then
		Table3.visible = True
		Table0.visible = False
		Table1.visible = False
		sValue = Left(g_szExpireDate, 4) & "/" & mid(g_szExpireDate, 5, 2) & "/" & right(g_szExpireDate, 2)
		Table3.SetCellString(1, 0, sValue)
	else
	'만료 예정의 경우
		Table0.visible = True
		Table1.visible = True
		Table3.visible = False
		for i=0 to 32
			sCalDate = Form.calcDateTime( 0, 0, i, 0, 0, 0 )
			sCalDate = Left(sCalDate, 8)
			
			if tonumber(sCalDate) == tonumber(g_szExpireDate) then
				g_szCalcDate = i
				Exit For
			end if
		Next
		Table1.SetCellString(0, 1, g_szCalcDate)
		Table0.SetCellString(0, 1, Left(g_szToday, 4) & "/" & mid(g_szToday, 5, 2) & "/" & right(g_szToday, 2))
		Table0.SetCellString(1, 1, Left(g_szExpireDate, 4) & "/" & mid(g_szExpireDate, 5, 2) & "/" & right(g_szExpireDate, 2))
		
	end if
	
End Sub

'============================================================================
Sub contNews_imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub ChkButton0_OnChange(sCheckState)
	Form.SetEnvData(1, g_Savekey, sCheckState )	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mhetc90021_p1" , "")
End Sub

	</SCRIPT_INFO>
