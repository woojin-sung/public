	<SCRIPT_INFO _len="2470" _ulen="2070" >
'***************************************************
'               전역 변수
'***************************************************
Dim g_szTitle

'***************************************************
'               공용 함수
'***************************************************
'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	call Init_Control("1")    ' Personal Function 호출시 call 붙여준다.
End Sub

'***************************************************
'               개별 함수
'***************************************************
'===============================================
' Init_Control(szCbn) 
'===============================================
Function Init_Control(szCbn) --> 리턴과 상관없이 Function으로 정의한다.
	'텍스트 설정
	lblDesc.caption = "적은 자금으로 부담없이, 부동산에 투자 가능한\n리츠의 장점을 확인해 주세요."
	lblSubDesc1.caption = "소액투자로도 투자가 가능해요.\n(직접투자 방식의 경우 투자자금이 많이 필요함)"
	lblSubDesc2.caption = "직접투자 대비 세금부담이 적어요.\n(배당금에 대해 15.4% 배당소득 과세)"
	lblSubDesc3.caption = "전문가에 의한 자산 운용이 가능해요.\n(개인이 직접 투자 시 리스크에 노출)"
	lblSubDesc5.caption = "국토교통부의 정기적인 관리감독, 리츠회사의\n준법감시인을 통한 투자자산의 관리가 가능해요."
	
	'여백제거
	lblTitle.paddinginfo = "0,0,0,0"
	lblDesc.paddinginfo = "0,0,0,0"
	lblSub1.paddinginfo = "0,0,0,0"
	lblSub2.paddinginfo = "0,0,0,0"
	lblSub3.paddinginfo = "0,0,0,0"
	lblSub4.paddinginfo = "0,0,0,0"
	lblSub5.paddinginfo = "0,0,0,0"
	lblSubDesc1.paddinginfo = "0,0,0,0"
	lblSubDesc2.paddinginfo = "0,0,0,0"
	lblSubDesc3.paddinginfo = "0,0,0,0"
	lblSubDesc4.paddinginfo = "0,0,0,0"
	lblSubDesc5.paddinginfo = "0,0,0,0"
	
	'색칠
	lblTopDivider.bgcolor = 320 '246,247,248
	lblTitle.setHighlight(332)
	lblDesc.fgcolor = "333"
	lblBg.bgcolor = "320"
	
	' 34/34/34: 334
	lblSub1.fgcolor = "334"
	lblSub2.fgcolor = "334"
	lblSub3.fgcolor = "334"
	lblSub4.fgcolor = "334"
	lblSub5.fgcolor = "334"
	
	' 115/118/124: 333
	lblSubDesc1.fgcolor = "333"
	lblSubDesc2.fgcolor = "333"
	lblSubDesc3.fgcolor = "333"
	lblSubDesc4.fgcolor = "333"
	lblSubDesc5.fgcolor = "333"
	
End Function

