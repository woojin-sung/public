	<SCRIPT_INFO _len="12917" _ulen="11855" >
'20240314_01 KBC 클라우드공동인증서 도입 (신규)
'클라우드인증서 PIN번호 입력창

Dim g_CountSave
Dim nCnt
Dim g_sCloudCertID

g_CountSave = 0
nCnt = 0
g_sCloudCertID = ""

'============================================================================
Sub Form_OnFormInit()	
	Container0.EditReal.SetApplyLabel("숫자 6자리 입력", 0 , 76 , "left" , true) '호출해야 정상작동
	
	szTmpLink = Form.GetOpenLinkData()

	szLinkData = Split(szTmpLink, "★")
	
	if Ubound(szLinkData) < 1 then
		exit sub
	end if
	
	'szLinkData(0) : "login"
	g_sCloudCertID = szLinkData(1)
	
	'비밀번호 입력키패드 Show
	Form.SetTimerEvent2(1, 1, 0.6)
	'20230524 SWJ END
End Sub


'============================================================================
'20240314_01 KBC 클라우드공동인증서 도입
Sub Form_onTriggerEventCloudCert(sCommand, sResult)
	Dim sErrorCd, sErrorMsg

	szItem = Split(sResult,"★")

	'처리코드,처리메시지 처리
	sErrorCd		= szItem(0)
	sErrorMsg	= szItem(1)	

	'오류이면
	if sErrorCd <> "0" then
		'에러
		sErrorMsg	= szItem(2)	
		Form.MsgBox("안내", sErrorMsg, "PinError", 6)			
		exit sub
	end if		

	'-------------------------------------------------------------
	'요청_응답처리
	'-------------------------------------------------------------
	if sCommand = "CLOUD_REQ_CHECK_PASSWD_90301" then		
		'PIN정상
		sPin = Container0.EditReal.caption
		
		Form.CloseForm()	
		Form.SendReturnToParent("CLOUDCERT_LOGIN" , sPin)
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		Container0.EditReal.SetShowKeypad(True)
	end if
	
End Sub

'============================================================================
'사용자에게 보여지는 패스워드 함수
'============================================================================
Function PasswordInsert()
	
	'입력완료일 시에 따로 개수 세이브해서 UI보이기
	if g_CharFlag = "N" then
		nCnt = g_CountSave
		g_CharFlag = ""
	end if
	
	Select Case nCnt
	
	Case 0
		Container0.Pwdbasic0.visible = true	
		Container0.Pwdbasic1.visible = true	
		Container0.Pwdbasic2.visible = true	
		Container0.Pwdbasic3.visible = true	
		Container0.Pwdbasic4.visible = true	
		Container0.Pwdbasic5.visible = true		
		Container0.PwdInsert0.visible = false	
		Container0.PwdInsert1.visible = false	
		Container0.PwdInsert2.visible = false	
		Container0.PwdInsert3.visible = false	
		Container0.PwdInsert4.visible = false	
		Container0.PwdInsert5.visible = false	
	Case 1
		Container0.Pwdbasic1.visible = true	
		Container0.Pwdbasic2.visible = true	
		Container0.Pwdbasic3.visible = true	
		Container0.Pwdbasic4.visible = true	
		Container0.Pwdbasic5.visible = true		
		Container0.PwdInsert0.visible = true
		Container0.Pwdbasic0.visible = false	
		Container0.PwdInsert1.visible = false	
		Container0.PwdInsert2.visible = false	
		Container0.PwdInsert3.visible = false	
		Container0.PwdInsert4.visible = false	
		Container0.PwdInsert5.visible = false	
	Case 2	
		Container0.PwdInsert0.visible = true	
		Container0.PwdInsert1.visible = true
		Container0.Pwdbasic2.visible = true	
		Container0.Pwdbasic3.visible = true	
		Container0.Pwdbasic4.visible = true	
		Container0.Pwdbasic5.visible = true
		Container0.Pwdbasic0.visible = false	
		Container0.Pwdbasic1.visible = false
		Container0.PwdInsert2.visible = false	
		Container0.PwdInsert3.visible = false	
		Container0.PwdInsert4.visible = false	
		Container0.PwdInsert5.visible = false	
	Case 3
		Container0.PwdInsert0.visible = true	
		Container0.PwdInsert1.visible = true	
		Container0.PwdInsert2.visible = true
		Container0.Pwdbasic3.visible = true	
		Container0.Pwdbasic4.visible = true	
		Container0.Pwdbasic5.visible = true		
		Container0.Pwdbasic0.visible = false	
		Container0.Pwdbasic1.visible = false	
		Container0.Pwdbasic2.visible = false	
		Container0.PwdInsert3.visible = false	
		Container0.PwdInsert4.visible = false	
		Container0.PwdInsert5.visible = false
	Case 4
		Container0.Pwdbasic4.visible = true	
		Container0.Pwdbasic5.visible = true		
		Container0.PwdInsert0.visible = true	
		Container0.PwdInsert1.visible = true	
		Container0.PwdInsert2.visible = true	
		Container0.PwdInsert3.visible = true
		Container0.Pwdbasic0.visible = false	
		Container0.Pwdbasic1.visible = false	
		Container0.Pwdbasic2.visible = false	
		Container0.Pwdbasic3.visible = false		
		Container0.PwdInsert4.visible = false	
		Container0.PwdInsert5.visible = false	
	Case 5
		Container0.Pwdbasic5.visible = true		
		Container0.PwdInsert0.visible = true	
		Container0.PwdInsert1.visible = true	
		Container0.PwdInsert2.visible = true	
		Container0.PwdInsert3.visible = true	
		Container0.PwdInsert4.visible = true
		Container0.Pwdbasic0.visible = false	
		Container0.Pwdbasic1.visible = false	
		Container0.Pwdbasic2.visible = false	
		Container0.Pwdbasic3.visible = false	
		Container0.Pwdbasic4.visible = false		
		Container0.PwdInsert5.visible = false	
	Case 6
		Container0.PwdInsert0.visible = true	
		Container0.PwdInsert1.visible = true	
		Container0.PwdInsert2.visible = true	
		Container0.PwdInsert3.visible = true	
		Container0.PwdInsert4.visible = true	
		Container0.PwdInsert5.visible = true	
		Container0.Pwdbasic0.visible = false		
		Container0.Pwdbasic1.visible = false		
		Container0.Pwdbasic2.visible = false		
		Container0.Pwdbasic3.visible = false		
		Container0.Pwdbasic4.visible = false		
		Container0.Pwdbasic5.visible = false
	Case else
		Form.ShowAlert("알림", "6자리를 입력해주세요.")
	End Select
	
	Container0.PwdFail0.visible = false
	Container0.PwdFail1.visible = false
	Container0.PwdFail2.visible = false
	Container0.PwdFail3.visible = false
	Container0.PwdFail4.visible = false
