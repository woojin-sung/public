'============================================================================
'인증 실패 UI
'============================================================================
Function PasswordFail()
		Container0.PwdFail0.visible = True
		Container0.PwdFail1.visible = True
		Container0.PwdFail2.visible = True
		Container0.PwdFail3.visible = True
		Container0.PwdFail4.visible = True
		Container0.PwdFail5.visible = True
		Container0.Pwdbasic0.visible = false		
		Container0.Pwdbasic1.visible = false		
		Container0.Pwdbasic2.visible = false		
		Container0.Pwdbasic3.visible = false		
		Container0.Pwdbasic4.visible = false		
		Container0.Pwdbasic5.visible = false
		Container0.PwdInsert0.visible = false	
		Container0.PwdInsert1.visible = false	
		Container0.PwdInsert2.visible = false	
		Container0.PwdInsert3.visible = false	
		Container0.PwdInsert4.visible = false	
		Container0.PwdInsert5.visible = false
End Function
'============================================================================
'패스워드 글자 개수 카운트
'============================================================================
Sub Container0_EditReal_OnEditChar(CharCode)
	
	Select Case CharCode
	
	Case "0"
		
		'입력값 6초과할 때 초과 카운팅 방지
		if nCnt = 6 then
			nCnt = 6
		else
			nCnt = nCnt + 1
		end if
		
		g_CountSave = nCnt
	Case "1"	
		'입력값 없을 때 마이너스 카운팅 방지
		if nCnt = 0 then
			nCnt = 0
		else
			nCnt = nCnt - 1
		end if
		
		g_CountSave = nCnt
	'취소, 입력완료일 때
	Case "2"
		nCnt = 0
	End Select

	PasswordInsert()
	
	if nCnt = 6 then		
		'입력완료 호출 API
		Container0.EditReal.runSecKeypadFinish()
	end if
	
End Sub

'============================================================================
'고객에게 보여지는 에디트 위치 클릭시 키패드 활성화(에디트 위치에 버튼 올려서)
'============================================================================
Sub Container0_Button0_OnClick()
	Container0.EditReal.SetShowKeypad(True)
	
	'인증 에디트 초기화
	nCnt = 0
	PasswordInsert()
	
End Sub

'============================================================================
Sub Container0_EditReal_OnEditComplete()
	'입력완료 시에만 타게끔(취소는 안타고)
	if g_DeviceOS == "2"  then
		g_CharFlag = "N"
		PasswordInsert()
	end if
	
	if nCnt <> 6 then
		'OS별로 비밀번호 최소글자 입력안했을 시에 시스템팝업메시지 내용이 달라서 
		'시스템팝업과 내용 맞춰주기 위한 분기처리
		if g_DeviceOS == "2"  then
			Form.MsgBox("알림", "최소 6자리 이상 입력해야 합니다.", "", 6 )
		elseif g_DeviceOS == "1" then
			Form.MsgBox("알림", "6글자 이상 입력해 주세요.", "", 6 )
		end if
		
	elseif nCnt = 6 then
		sPin = Container0.EditReal.caption
		Form.requestCertCommand("CLOUD_REQ_CHECK_PASSWD", g_sCloudCertID & "★" & sPin, "90301") '20240314_01 KBC 클라우드공동인증서 도입
		nCnt = 0
	end if
End Sub

