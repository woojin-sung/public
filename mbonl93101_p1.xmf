'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		Dim tData
		tData = Split(szOpenData, "@")
		
		tblInfo.SetCellString( 0 , 1 , tData[0] )	'변경 전
		tblInfo.SetCellString( 1 , 1 , tData[1] )	'변경 후
	end if
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.SendReturnToParent( "PROCESS_OK" , "" )
	Form.CloseForm()
End Sub

