' 
'============================================================================
Sub contBuy_btnPPlus_OnClick()
	'20160602 NOHES START 채권 틱단위
	Dim szPlus
	
	If Trim(g_szCd) == "" Then
		szPlus = "1" 
	Else
		szPlus = Form.GetItemCodeInfo(g_szCd, "bondunit")
	End If
	'20160602 NOHES END
	

	Dim szPrc
	szPrc  = contBuy.edtPrice.caption

	if Trim(szPrc) == "" then
		'현재가 조회수행
		Request_Price()
	else
		Call Calc_Price(0, szPlus)
	end if

End Sub

'============================================================================
Sub contBuy_btnPMinus_OnClick()
	'20160602 NOHES START 채권 틱단위
	Dim szMinus
	
	If Trim(g_szCd) == "" Then
		szMinus = "1"
	Else
		szMinus = Form.GetItemCodeInfo(g_szCd, "bondunit")
	End If
	'20160602 NOHES END

	Dim szPrc
	szPrc  = contBuy.edtPrice.caption

	if Trim(szPrc) == "" then
		'현재가 조회수행
		Request_Price()
	else
		Call Calc_Price(1, szMinus)
	end if
	
End Sub

'============================================================================
'contBuy_btnPrc_OnClick()
'============================================================================
Sub contBuy_btnPrc_OnClick()
	Dim szPrc, szData

	szData = "0★" & contBuy.edtPrice.caption  & "★" & g_szMk & "★" & g_szCd

	Form.OpenPopup("mbfnp54020_p8", szData, "")
    
End Sub

'============================================================================
Sub contBuy_btnQty_OnClick()
	Dim szQty, szData

    szQty = contBuy.edtQty.caption
    szData = szQty
    Form.OpenPopup("mbfnp54020_p7", szData, "")
End Sub

'============================================================================
' 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' 주문경고보류용 플래그 YGH EDIT 20191125
	if sKeyName == "주문경고" then
		if sRet == "1" then
		
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	
	' 주문경고보류용 플래그 YGH EDIT 20191125
	elseif sKeyName == "주문전송" then   
	   if sRet == "1" then
	      DATAMANAGER.RequestTranData( "obtrs_oder_301a" )
       end if
    ' ----------------------------------------------------------------------
	' 가격확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then
		contBuy.edtPrice.caption = sRet
	' ----------------------------------------------------------------------
	' 수량확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then
	   contBuy.edtQty.caption = sRet
    end if
End Sub

'============================================================================
Sub contBuy_btnMiche_OnClick()
	Form.triggerEvent("#", "54050_CONTRACT_OPEN", "")
End Sub

