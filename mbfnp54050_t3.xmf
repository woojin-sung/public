'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Load_OrderSet() '주문설정값 읽어오기
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "54020_HOGA" then		' 메인화면의 호가 클릭시
		if sParam <> "" then
			''''(주문유형)에 따른 '주문단가
			contBuy.edtPrice.caption = sParam
		end if
	elseif sEventName == "INIT_CODE" then	' 메인화면에서 종목코드 받기
		if sParam <> "" then
			tData = Split(sParam, "★")
			
			if #tData > 0 then
				
				if #tData > 2 then
					g_szMK = tData(0)
					g_szCd = tData(1)
					contBuy.edtQty.caption   = tData(2) '수량
					contBuy.edtOrgNo.caption = tData(3) '주문번호
					'tData(4) '주문유형
					contBuy.edtPrice.caption = tData(5) '가격
					'tData(6) '주문조건코드
				else
					g_szMK = tData(0)
					g_szCd = tData(1)
					
					'20170919 HAMWG START : 미체결팝업 연동시 데이터 초기화 방지
					if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
						contBuy.edtQty.caption = ""
						contBuy.edtOrgNo.caption = ""
						contBuy.edtPrice.caption = ""
					end if
					'20170919 HAMWG END
				end if
			end if
			
		end if
	
	elseif sEventName == "54050_CONTRACT_RETURN" then
	    if sParam == "" then
			Exit Sub
		end if
	    
	    tData = Split(sParam, "♥")
	    if UBOUND(tData) < 1 then
	      Exit Sub
	    End if	
	   
	    contBuy.edtQty.caption 		= tData(0)
	    contBuy.edtOrgNo.caption 	= tData(1) '주문번호
	    contBuy.edtPrice.caption 	= tData(2) '가격
		
	elseif sEventName == "AFTER_ORGNO" then		
		if g_szAfterOrg == "1" then			' 주문번호 연동
			contBuy.edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
		end if	
	end if
End Sub

