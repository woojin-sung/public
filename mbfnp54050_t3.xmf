'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)'''HTS(*)
	if szTranID == "obtrs_oder_301a" then
		
		g_szTR = szTranID
		DATAMANAGER.ClearInputData(0, "obtrs_oder_301a")

         DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "SVCD"				, 0, "303")								' 서비스코드'
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "CHAN_TYPE_CLS_CODE"	, 0, "")		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acc", "total"))		' 계좌번호(8)
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acc", "sequence"))	' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ISCD"				, 0, g_szCd)								' 종목코드
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "BOND_ODER_UNPR"		, 0, contBuy.edtPrice.caption)				' 주문단가
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ODQT"				, 0, contBuy.edtQty.caption)				' 주문수량
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ORGL_ODER_NO" 		, 0, contBuy.edtOrgNo.caption)				' 원주문번호
		
		'DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "BYOV_DATE"			, 0, szDATE)								' 매수일자
		'DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "FEE_LEVY_YN"			, 0, "0")								' 수수료 징수 여부
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag) 						' 주문경고 확인여부
		
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ACNT_PWD"		, 0, Form.GetCtlProp("#edtPwd", "caption"))	' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else	
			DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ACNT_PWD"		, 0, Form.GetCtlProp("#edtPwd", "encdata"))	' 계좌 비밀번호
		end if

	elseif szTranID == "ohhts_7052_001r" then
		
		DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	szMsg = DATAMANAGER.GetDataMsgText( szTranID )
	szMsgCode = DATAMANAGER.GetDataMsgCode( szTranID )
		
	If szTranID == "obtrs_comn_420r" then
	   contBuy.edtQty.caption = DATAMANAGER.GetDataValue( 0, "obtrs_comn_420r", "OutBlock1", "ODER_ABLE_QTY", 0)
	
	elseIf szTranID == "ohhts_7052_001r" then
		'20160602 NOHES 채권 호가 단위
		Dim szPrc
		szPrc = DATAMANAGER.GetDataValue( 0, "ohhts_7052_001r", "OutBlock1", "FID_PRPR", 0)
				
		if szPrc ~= "" then
			contBuy.edtPrice.caption = szPrc
		end if
	Else 
	
		Dim szOrdCd, szOrdMsg, szOrgNo, szWarnCd, szWarnMsg
		
		' 주문경고보류용 플래그 YGH EDIT 20191125
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
		szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
		szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)

		if szWarnCd = "1" then							' 경고
			Open_ConfirmPopup(szWarnMsg)
		elseif szWarnCd = "2" then						' 보류
			g_szTR = ""
			'Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
		else
		    if Trim(szOrdCd) == "0001" then			' 정상주문
		    Form.Toast(0, szOrdMsg, true)

		    if g_szAfterInit == "1" then		' 주문후 초기화
		       contBuy.edtOrgNo.caption = ""
		       contBuy.edtQty.caption = ""
		       contBuy.edtPrice.caption = ""
		    end if
		    
		    if g_szAfterOrg == "1" then			' 주문번호 연동
				szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
				Form.SetCtlProp("#edtOrgNo", "caption", szOrgNo)
				contBuy.edtOrgNo.caption = szOrgNo
			else
				Form.SetCtlProp("#edtOrgNo", "caption", "")
		    end if 
		
			end if
		End If 
	end if
	' 주문경고보류용 플래그 YGH EDIT 20191125
	g_szWarnFlag = "N"	
	' 주문경고보류용 플래그 YGH EDIT 20191125
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
    if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if
	
	' 주문경고보류용 플래그 YGH EDIT 20191125
	g_szWarnFlag = "N"
	' 주문경고보류용 플래그 YGH EDIT 20191125

End Sub

