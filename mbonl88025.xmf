'============================================================================
' 01. 화 면 명 : 보유주식 수익 서비스 내 수익금 확인하기 팝업
' 02. 화면설명 : 보유주식 수익 서비스 내 수익금 확인하기 팝
' 03. 작    성 : 2022.08.02 양현정
' 04. 수    정 : 
'
'============================================================================

Dim g_FeeClsCd
Dim g_PrdCd
Dim g_StaDate
Dim g_FinDate
Dim g_PsntDate
Dim gAcnt
Dim gIqryCnt	'조회건수

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
Function f_SetInit()
	'lblFee.caption = "0"	
	'Label1.caption = "0 원"
	'Label7.caption = "0"
	'Label8.caption = "0"
	
	Grid0.SetClear()	
	gIqryCnt = 0
	
	'Label1.changeTextAttr(0, 1, 290, 35, true)
	'Label1.changeTextAttr(1, 2, 290, 5, true)	
End Function

Function f_SetFlag()
	Dim tCodeName1, tCodeName2, tCodeName3
	Dim sStaDate, sFinDate
	
	if g_PrdCd == "1" then
		tCodeName1 = "최근1주일"
	elseif g_PrdCd == "2" then		
		tCodeName1 = "최근1개월"
	elseif g_PrdCd == "3" then				
		sStaDate = Left(g_StaDate,4) & "/" & Mid(g_StaDate,5,2) & "/" & Right(g_StaDate,2)
		sFinDate = Left(g_FinDate,4) & "/" & Mid(g_FinDate,5,2) & "/" & Right(g_FinDate,2)
		'tCodeName1 = g_StaDate&"~"&g_FinDate
		tCodeName1 = sStaDate&"~"&sFinDate
	else 
		tCodeName1 = ""
	end if
		
	'if g_FeeClsCd == "%" then
	'	tCodeName2 = "전체"
	'elseif g_FeeClsCd == "1" then		
	'	tCodeName2 = "대여"
	'elseif g_FeeClsCd == "2" then				
	'	tCodeName2 = "보유주식"
	'else
	'	tCodeName2 = ""
	'end if
	
	tCodeName3 = tCodeName1	'&"·"&tCodeName2
	
	lblFeeCdName.caption = tCodeName3
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
Sub Form_OnFormInitBefore()
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 
	imgTitle.SetMaintainingRatio("1")
	'Image0.SetMaintainingRatio("1")
	Image3.setMaintainingRatio("1")
	'Image1.SetMaintainingRatio("1")
	'Image2.SetMaintainingRatio("1")
	
End Sub


'============================================================================
Sub Form_OnFormInit()

	f_SetInit()

	g_FeeClsCd = "%"
	g_PrdCd = "2"
	
	'g_PsntDate = GetSharedData("&HOST_DATE", false)
	'g_PsntDate = Form.GetSharedData("&BIZ_DT", false ) '현재영업일..	
	g_PsntDate = CalPsntDate.caption
	
	'1개월전 ... 조회
	CalStaDate.caption = g_PsntDate
	'Form.MsgBox("date test","g_PsntDate=("&g_PsntDate&") CalStaDate=("&CalStaDate.caption&")", "MSGBOX_test", 0)
	
	dim tYear, tMon, tDay, tDay2, tCalcDate

	tDay  = CalStaDate.calday
	CalStaDate.addday = (-1)*CInt(tDay)	'전달 마지막날..
	
	tYear = CalStaDate.calyear
	tMon  = CalStaDate.calmonth 
	tDay2 = CalStaDate.calday
	
	if CInt(tDay) > CInt(tDay2) then
		tDay = tDay2
	end if
	
	if cInt(tMon) < 10 then
		tMon = CStr("0"&cInt(tMon))
	end if
	
	if cInt(tDay) < 10 then
		tDay = CStr("0"&cInt(tDay))
	end if
	
	'Form.MsgBox("tCalcDate test","tYear=("&tYear&") tMon=("&tMon&") tDay=("&tDay&")", "MSGBOX_test2", 0)
	tCalcDate = CStr(tYear)&CStr(tMon)&CStr(tDay)
		
	CalStaDate.caption = tCalcDate
	g_StaDate = tCalcDate 'g_PsntDate
	g_FinDate = g_PsntDate
	
	
	f_SetFlag()


	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		
		dim tData, szProdCd, szProdText
		tData = Split(szOpenData, "★")
		
		gAcnt = tData(0)
		
		cmbAccount.caption = gAcnt
		
	end if


	'계좌 체크
	if cmbAccount.caption <> "" and cmbAccount.caption <> null then 
		DATAMANAGER.RequestTranData("oblon_lndn_046r") '수익금조회
	end if
	
	Label1.fontsize = 34
	
End Sub

' 계좌변경시..
Sub cmbAccount_ChangeAccount()

	f_SetInit()

	DATAMANAGER.RequestTranData("oblon_lndn_046r") '수익금조회
End Sub

'============================================================================
' 기간 및 수수료구분 선택팝업창 띄움
'============================================================================
Sub lblFeeCdName_OnClick()
	dim sSendData
	sSendData = g_FeeClsCd&"★"&g_PrdCd&"★"&g_StaDate&"★"&g_FinDate
	
	'msgbox "main "&sSendData
	
	'Form.openPopupAnimation("mbonl88024_p12", sSendData,"","2")	
	Form.openPopupAnimation("mbonl88025_p2", sSendData,"","2")	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim szCust_Num

	'고객번호	
	szCust_Num = Form.GetSharedData("&CUST_NUM", false ) '로그인 해야만 고객번호 받아옴
	
	
	if szTranID == "oblon_lndn_046r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" 	, 0 , g_FeeClsCd)	 '% 전체조회 1:대여 2:보유주식
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"	 		, 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 	  		, 0 , cmbAccount.sequence)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STA_DATE" 		, 0 , g_StaDate)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FIN_DATE" 		, 0 , g_FinDate)	
		'DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" 		, 0 , szPwd)

	end if
	
End Sub	

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "oblon_lndn_046r" then
		dim nStaOffset, nLen, lSumFee

		lSumFee = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNDN_FEE" , 0) + DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "STCK_HLDN_SVC_FEE" , 0)
		
		'수수료 합산
		Label1.caption = ""	'초기화
		Label1.fontsize = 34
		Label1.fgcolor  = 290
		
		lblFee.caption = CLng(lSumFee)
		Label1.caption = lblFee.dispcaption&" 원"
		
		nStaOffset = Label1.getLen(Label1.caption) -2
'		Label1.caption = Label1.caption&" 원"
'		nLen = Label1.getLen(" 원")
		
		'Form.MsgBox("알림", "nStaOffset="&nStaOffset, "test", "1") 
		'Label1.changeTextAttr(0, nStaOffset, 290, 35, true)
		
		Label1.changeTextAttr(nStaOffset, 2, 290, 5, true)
		
				
		'If DATAMANAGER.IsMoreNextData(szTranID) = True Then
		'	DATAMANAGER.RequestNextData(szTranID)
		'Else 
		
			Dim iCnt	', szFeeCd
			
			iCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
			
			'msgbox "iCnt="&iCnt&" gIqryCnt="&gIqryCnt
			For i = gIqryCnt to gIqryCnt+iCnt - 1
		'	For i = 0 to Grid0.rowcount - 1
			    'szFeeCd = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_FEE_CLS" , i)
			    'msgbox Grid0.GetCellData("bd_cell5", i)
			    if Grid0.GetCellData("bd_cell5", i) = "1" then			    
				    Grid0.SetCellData("bd_cell1", i, "대여거래 수수료")
			    else
				    Grid0.SetCellData("bd_cell1", i, "보유주식수익 수수료")
			    End If
			Next 
			gIqryCnt = gIqryCnt + iCnt
			
			'DATAMANAGER.RequestTranData("obpds_srvc_168r")
		'End If 		
		
	end if
	
End Sub			

'============================================================================
'TR오류시..
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "안내" , szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "안내" , szErrMsg)
	end if
End Sub

'============================================================================
' 내 수익금 확인하기 유의사항 클릭
'============================================================================
Sub imgTitle_OnClick()
	'Form.OpenFramePopup("mbonl88024_p11", "", "")
	Form.OpenFramePopup("mbonl88025_p1", "", "")
End Sub

'============================================================================
' Back 버튼 클릭시
'============================================================================
Sub ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'if sKeyName = "mbonl88024_p12" then
	if sKeyName = "mbonl88025_p2" then
		if sRet <> "" and sRet <> null then
			Dim tData
			
			tData = Split(sRet, "★")
			
			g_FeeClsCd = tData(0)		'%:전체 1:대여거래 2:보유주식수익
			g_PrdCd    = tData(1)		'1:1주일 2:1개월 3:직접입력
			g_StaDate  = tData(2)
			g_FinDate  = tData(3)
			
			'msgbox "popup return g_FeeClsCd=" & g_FeeClsCd
			'msgbox "popup return g_PrdCd="   & g_PrdCd
			'msgbox "popup return g_StaDate=" & g_StaDate
			'msgbox "popup return g_FinDate=" & g_FinDate
			
			f_SetInit()
			f_SetFlag()
			
			DATAMANAGER.RequestTranData("oblon_lndn_046r") '수익금조회
			
		end if
	end if
End Sub
'============================================================================
Sub Form_OnFormClose()
	
End Sub

