'===========================================================================
' 화 면 명: 다른 금융기관 거래내역 조회
' 화면설명: 
' 작    성: 2020.10.12 송기영
' 수    정:
'===========================================================================
' 2021.10.08. 김효준 v001 : 오픈뱅킹_이용재동의여부 조회&등록 추가
'============================================================================
'***************************************************************************
'     G L O B A L   V A R I A B L E
'***************************************************************************
Dim g_szID         '사용자 아이디

Dim g_szBANKCODE	 '은행코드
Dim g_szBANKACNO	 '은행계좌번호
Dim g_szBANKNAME	 '은행명

Dim g_szTabC       '탭 위치
Dim g_szRGC      	 '라디오 위치
Dim LinkYn		 '다른곳에서 호출됐나 여부

Dim IqryTrcInfo
Dim TotalNum
Dim NextYn
Dim TrUniqNo

Dim g_NxetPrgsYn '다음진행여부 v001
Dim g_AgrmYn     '재동의여부   v001
Dim g_ProsAbleYn '처리가능여부 v001
'============================================================================
Sub Form_OnFormInit()

	g_szTabC = 0
	g_szRGC  = "A"
	g_szBANKCODE = ""
	g_szBANKACNO = ""
	g_szBANKNAME = ""
	IqryTrcInfo = ""
	TotalNum = 0
	NextYn = "N"
	TrUniqNo = ""
	LinkYn = "N"

	szData = Form.GetOpenLinkData()

	if szData <> "" then
		Dim szData
		szData = Form.GetOpenLinkData()
		g_szList = Split(szData, "★")
	
		g_szBANKACNO = g_szList(0)
		g_szBANKNAME = g_szList(1)
		g_szBANKCODE = g_szList(2)
		
		if UBOUND(g_szList) < 1 THEN
			EXIT SUB
		END IF
		
		LinkYn = "Y"
		
	end if
	
	cld1.caption = cldToday.caption
	cld0.caption = cldToday.caption
	
	g_szID = Form.GetSharedData("&USER_ID", false )
    
'	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "PROS_CLS_CODE" , 0 ,  "1" )
'	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "OPN_ACNT_KIND_CODE", 0 , "%" )
'	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "ELFN_ID", 0 , g_szID) 'acno랑 둘중하나만
'	DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "SNMS_YN", 0 , "N") 
'
'	DATAMANAGER.RequestTranData("obtss_opnf_008r")

	'v001
	if Form.GetSharedData("62000_AGRMYN_SKIP" , false) = "Y" THEN
		DATAMANAGER.RequestTranData("obtss_opnf_008r")
	else	
		DATAMANAGER.RequestTranData( "obtss_opnf_047r" ) '오픈뱅킹_이용재동의여부조회
	end if
End Sub

'v001
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obtss_opnf_008r" then	'오픈뱅킹_타행계좌내역조회
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "PROS_CLS_CODE"     , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "OPN_ACNT_KIND_CODE", 0 , "%" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "ELFN_ID"           , 0 , g_szID) 'acno랑 둘중하나만
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_008r", "InBlock1", "SNMS_YN"           , 0 , "N") 
	end if
	
	if szTranID == "obtss_opnf_047r" then	'오픈뱅킹_이용재동의여부조회
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_047r", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_047r", "InBlock1", "ELFN_ID"       , 0 , g_szID )
	end if
	
	if szTranID == "obtss_opnf_048a" then	'오픈뱅킹_이용재동의여부관리
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "ELFN_ID"       , 0 , g_szID )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "AGRM_YN"       , 0 , "Y")
	end if
End Sub

'============================================================================
' SetTr() : TR 입력값 세팅, 조회 요청
'============================================================================
Function SetTr()
	if NextYn = "Y" then
		IqryTrcInfo 	= DATAMANAGER.GetDataValue(0, "obtss_opnf_009r", "OutBlock1", "RGBF_IQRY_TRC_INFO", 0)
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_009r", "InBlock1", "RGBF_IQRY_TRC_INFO"	, 0 , IqryTrcInfo) '직전조회추적정보
	else
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_009r", "InBlock1", "RGBF_IQRY_TRC_INFO"	, 0 , "") '직전조회추적정보
	end if
	
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_009r", "InBlock1", "PROS_CLS_CODE" 		, 0 , "1" ) '처리구분코드(예비)
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_009r", "InBlock1", "IQRY_CLS_CODE"		, 0 , g_szRGC ) 'A:all, I:입금, O:출금
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_009r", "InBlock1", "ELFN_ID"	  		, 0 , g_szID) 'acno랑 둘중하나만
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_009r", "InBlock1", "IQRY_STA_DATE"		, 0 , cld0.caption) '시작일자
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_009r", "InBlock1", "IQRY_FIN_DATE"		, 0 , cld1.caption) '종료일자
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_009r", "InBlock1", "OPN_SORT_CLS_CODE"	, 0 , "D") '오픈뱅킹정렬구분코드
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_009r", "InBlock1", "BANK_CODE"			, 0 , g_szBANKCODE) '은행코드
	DATAMANAGER.SetDataValue( 0, "obtss_opnf_009r", "InBlock1", "BANK_ACNO"			, 0 , g_szBANKACNO) '은행계좌번호
	'DATAMANAGER.SetDataValue( 0, "obtss_opnf_009r", "InBlock1", "TIMS_NO"			, 0 , cld1.caption) '회차번호(예비)
		
	DATAMANAGER.RequestTranData( "obtss_opnf_009r" )
		
End Function



'============================================================================
' SetTr() : TR 입력값 세팅, 조회 요청
'============================================================================
Function ValueInit()
	Grid.SetClear()
	TotalNum = 0
End Function


'============================================================================
Sub AcComb_OnEditComplete (iIndex)
	'if LinkYn = "N" then
		g_szBANKCODE = DATAMANAGER.GetDataValue(0, "obtss_opnf_008r", "OutBlock1", "BANK_CODE"     , iIndex)
		g_szBANKACNO = DATAMANAGER.GetDataValue(0, "obtss_opnf_008r", "OutBlock1", "BANK_ACNO"     , iIndex)
		
		ValueInit()
		SetTr()
	'end if
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nCount
	
	If szTranID = "obtss_opnf_008r" Then 
		Dim BankAcno, BankName
		Dim CombNum
		BankAcno, BankName = "", ""
		
		nCount = DATAMANAGER.GetDataCount(0, "obtss_opnf_008r", "OutBlock1")
		
		For i = 0 to nCount-1
			BankAcno = DATAMANAGER.GetDataValue(0, "obtss_opnf_008r", "OutBlock1", "BANK_ACNO"     , i)
			BankName = DATAMANAGER.GetDataValue(0, "obtss_opnf_008r", "OutBlock1", "BANK_NAME"     , i)
		
			AcComb.cbadddatatext = BankName .. " ".. BankAcno
				
			if BankAcno = g_szBANKACNO and BankName = g_szBANKNAME then
				CombNum = i
			end if
		next
			
		if LinkYn = "N" then
			g_szBANKCODE = DATAMANAGER.GetDataValue(0, "obtss_opnf_008r", "OutBlock1", "BANK_CODE"     , 0)
			g_szBANKACNO = DATAMANAGER.GetDataValue(0, "obtss_opnf_008r", "OutBlock1", "BANK_ACNO"     , 0)
			SetTr()
		elseif LinkYn = "Y" then
			AcComb.currentindex = CombNum
			'SetTr()   <- AcComb_OnEditComplete 여기서 호출됨
		end if
	
		'SetTr()
	
	elseIf szTranID = "obtss_opnf_009r" Then 
		Dim DpdrClsNm
		Dim TrAmt
				
		nCount = DATAMANAGER.GetDataCount(0, "obtss_opnf_009r", "OutBlock2")
		
		For i = 0 to nCount-1
			TrDate	= DATAMANAGER.GetDataValue(0, "obtss_opnf_009r", "OutBlock2", "TR_DATE"			,  i)
			TrHour 	= DATAMANAGER.GetDataValue(0, "obtss_opnf_009r", "OutBlock2", "TR_HOUR"			,  i)
			BnkFctCntt = DATAMANAGER.GetDataValue(0, "obtss_opnf_009r", "OutBlock2", "BNKB_FCT_CNTT"	,  i)
			TrAftBal = DATAMANAGER.GetDataValue(0, "obtss_opnf_009r", "OutBlock2", "TR_AFT_BAL"		,  i)
			
			Grid.AddRow()
			Grid.SetCellData("bd_cell0", TotalNum, TrDate)
			Grid.SetCellData("bd_cell4", TotalNum, TrHour)
			Grid.SetCellData("bd_cell7", TotalNum, BnkFctCntt)
			Grid.SetCellData("bd_cell8", TotalNum, TrAftBal)
		
			DpdrClsNm = DATAMANAGER.GetDataValue(0, "obtss_opnf_009r", "OutBlock2", "DPDR_CLS_NAME"	,  i)
			TrAmt 	 = DATAMANAGER.GetDataValue(0, "obtss_opnf_009r", "OutBlock2", "TR_AMT"			,  i)
			
			if DpdrClsNm = "입금" then 
				Grid.SetCellData("bd_cell1", TotalNum, DpdrClsNm)
				Grid.setCellFgColor("bd_cell1", TotalNum, "10")
				
				Grid.SetCellData("bd_cell3", TotalNum, TrAmt)
				Grid.setCellFgColor("bd_cell3", TotalNum, "10")
				
			elseif DpdrClsNm = "출금" then 
				Grid.SetCellData("bd_cell1", TotalNum, DpdrClsNm)
				Grid.setCellFgColor("bd_cell1", TotalNum, "11")
				
				Grid.SetCellData("bd_cell3", TotalNum, TrAmt)
				Grid.setCellFgColor("bd_cell3", TotalNum, "11")
			else
				Grid.SetCellData("bd_cell1", TotalNum, DpdrClsNm)
				Grid.SetCellData("bd_cell3", TotalNum, TrAmt)
			end if
			
			TotalNum = TotalNum + 1
			
		next
		
		'Grid.rowcount = TotalNum

		NextYn 	= DATAMANAGER.GetDataValue(0, "obtss_opnf_009r", "OutBlock1", "NXET_PAGE_EXST_YN"	, 0)
		
		if NextYn = "Y" then
			SetTr()
		end if
	elseif szTranID == "obtss_opnf_047r" then	'v001
	    g_NxetPrgsYn  = ""
	    g_AgrmYn      = DATAMANAGER.GetDataValue( 0, "obtss_opnf_047r", "OutBlock1" , "AGRM_YN"      , 0 ) '재동의여부
	    g_ProsAbleYn  = DATAMANAGER.GetDataValue( 0, "obtss_opnf_047r", "OutBlock1" , "PROS_ABLE_YN" , 0 ) '처리가능여부

	    '처리가능여부가 Y인경우 SharedData 등록후 다른화면에서 다시호출안하게함
	    If g_ProsAbleYn = "Y" Then
	    
		    Form.SetSharedData("62000_AGRMYN_SKIP", "Y")
	    End If
	    
	    If g_AgrmYn = "Y" Then
		    Form.OpenPopup("mbbnk62000_p1" , ""  , "")
		    g_NxetPrgsYn = "N" '팝업호출시도 일단 진행불가 > Form_OnPopupReturn 다시판단
	    ElseIf g_AgrmYn = "N" Then
	        g_NxetPrgsYn = "Y"
	    ElseIf g_AgrmYn = "R" Then
	        Form.MsgBox( "알림", "5년경과시 재가입 절차가 진행됩니다.", "", 6 )
	        g_NxetPrgsYn = "N"
	    End If
	    
        '다음진행 불가시 비활성화
         If g_NxetPrgsYn = "N" Then
	 
			Form_Enable(False)
		Else
		
		    DATAMANAGER.RequestTranData( "obtss_opnf_008r" )
	    End If
	elseif szTranID == "obtss_opnf_048a" then	'v001
		DATAMANAGER.RequestTranData( "obtss_opnf_008r" )		
	End If  
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError (szTranID , szErrCode , szErrMsg)	
	Dim SubMsg, TempSubMsg
	
	SubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	TempSubMsg = replace(SubMsg, " ", "") '공백 제거 ex) 거래내역 없음  -> 거래내역없음
	
	if SubMsg = "" or szErrMsg = TempSubMsg then
		Form.MsgBox("알림", szErrMsg, 0)
	else
		Form.MsgBox("알림", szErrMsg & "(" & SubMsg & ")", 0)
	end if
	
End Sub


'============================================================================
' cld0_OnEditComplete()
'============================================================================
Sub cld0_OnEditComplete()

	if cld0.caption > cld1.caption then
		Form.ShowAlert( "알림", "조회 일자가 잘못 입력되었습니다.")
		cld0.caption = cldToday.caption
	end if
	
	ValueInit()
	SetTr()
End Sub


'============================================================================
' cld1_OnEditComplete()
'============================================================================
Sub cld1_OnEditComplete()

	if cld0.caption > cld1.caption then
		Form.ShowAlert( "알림", "조회 일자가 잘못 입력되었습니다.")
		cld1.caption = cldToday.caption
		Exit Sub
	elseif cld1.caption > cldToday.caption then
		Form.ShowAlert( "알림", "조회 일자가 잘못 입력되었습니다.")
		cld1.caption = cldToday.caption
		Exit Sub
	end if
		
	ValueInit()
	SetTr()
End Sub



'============================================================================
Sub cmb_OnEditComplete (iIndex)

	if iIndex = 0 then 
		cld1.caption = cldToday.caption
		cld0.caption = cldToday.caption
	elseif iIndex = 1 then
		cld1.caption = cldToday.caption
		cld0.caption = Left(Form.calcDateTime( nYear, nMonth, -7, nHour, nMinute, nSecond ), 8)
	elseif iIndex = 2 then
		cld1.caption = cldToday.caption
		cld0.caption = Left(Form.calcDateTime( nYear, -1, nDay, nHour, nMinute, nSecond ), 8)
	elseif iIndex = 3 then
		cld1.caption = cldToday.caption
		cld0.caption = Left(Form.calcDateTime( nYear, -3, nDay, nHour, nMinute, nSecond ), 8)
	end if
	
	ValueInit()
	SetTr()
End Sub


'============================================================================
Sub RadioGroup1_OnClick(nIndex)

	if nIndex = 0 then 
		g_szRGC = "A"
	elseif nIndex = 1 then
		g_szRGC = "I"
	elseif nIndex = 2 then
		g_szRGC = "O"
	end if

	ValueInit()
	SetTr()
End Sub


'============================================================================
Sub btnAll_OnClick()
	Form.OpenScreen("62010", "")
End Sub



'============================================================================
Sub btnAdd_OnClick()
	Form.OpenScreen("62001", "")
End Sub



'============================================================================
Sub btn_OnClick()
	ValueInit()
	SetTr()
End Sub


'v001
'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName == "mbbnk62000_p1" then
	     
		If sRet == "Y" then 'Y:재동의 N:취소
		
			Form_Enable(True)
			
			DATAMANAGER.RequestTranData( "obtss_opnf_048a" )
		Else
		     '취소시도 처리가능여부값에 따라 진행
			If g_ProsAbleYn = "Y" Then
			
				Form_Enable(True)
				
				DATAMANAGER.RequestTranData( "obtss_opnf_008r" )
			Else
			
				Form_Enable(False)
			End If
		End If
	End If
     
End Sub


'v001
'============================================================================
' Form_Enable
'============================================================================
Function Form_Enable(EnableYn)
    if EnableYn = True then
    
		AcComb.enable      = True '계좌
		cld0.enable        = True '시작일자
		cld1.enable        = True '종료일자
		cmb.enable         = True '일자구분
		RadioGroup1.enable = True '입출금구분
		btnAll.enable      = True '잔액모으기
		btnAdd.enable      = True '계좌추가
		btn.enable         = True '재조회
				
    elseif EnableYn = False then
    
		AcComb.enable      = False '계좌
		cld0.enable        = False '시작일자
		cld1.enable        = False '종료일자
		cmb.enable         = False '일자구분
		RadioGroup1.enable = False '입출금구분
		btnAll.enable      = False '잔액모으기
		btnAdd.enable      = False '계좌추가
		btn.enable         = False '재조회
    end if
End Function
