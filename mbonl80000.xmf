'============================================================================
Sub Form_OnFormInit()
'	grdList.rowcount = 5
	
	'test
'	For i = 0 to CInt(grdList.rowcount)
'		grdList.SetCellData("bd_name", i, "삼성증권  |  상장주식 등")
'		grdList.SetCellData("bd_title1", i, "적용금액")
'		grdList.SetCellData("bd_title2", i, "차기연도 이월여부")
'		grdList.SetCellData("bd_title3", i, "협회등록일자")
'		
'		grdList.SetCellData("bd_apply", i, "4000000")
'		grdList.SetCellData("bd_nextyear", i, "YES")
'		grdList.SetCellData("bd_regdate", i, "20220501")
'	Next
	
	'test no data
'	grdList.rowcount = 0
'	If CInt(grdList.rowcount) == 0 Then
'		lblNoData.visible = true
'	Else
'		lblNoData.visible = false
'	End If
	
	Dim szMode
	szMode = Form.GetSharedData("&SERVER_MODE", False )
	
	'연도콤보세팅
	Dim nNowYear
	nNowYear = CInt(Left(Form.GetSharedData("&HOST_DATE", false), 4))
	If szMode == "1" Or szMode == 1 Then		'테스트
		For i = 2021 to nNowYear+1
			cmbPeriod.cbadddatatext = i & "`" & i & "년"
		Next
	Else									'운영
		'혹시 모르니 예외처리
		If nNowYear == 2022 Then
			nNowYear = 2023
		End If
		For i = 2023 to nNowYear+1
			cmbPeriod.cbadddatatext = i & "`" & i & "년"
		Next
	End If
	cmbPeriod.cbkeydata = nNowYear
	
	g_szType = "1"
	
	'금융투자소득 기본공제 조회
	DATAMANAGER.RequestTranData( "obcsb_fiin_001r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'금융투자소득 기본공제 조회(리스트 조회)
	If szTranID == "obcsb_fiin_001r" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , "")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TXTN_APLY_YEAR" , 0 , cmbPeriod.cbkeydata)
		'"0":전체, "1":상장주식 등, "2":기타
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_APLY_CLCD" , 0 , g_szType) 
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_BSWR_CODE" , 0 , "200")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SCTY_INFO_IQRY_YN" , 0 , "S")
	
	'금융투자소득 기본공제 조회(상단 금액 조회)
	ElseIf szTranID == "obcsb_fiin_001r_1" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , "")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TXTN_APLY_YEAR" , 0 , cmbPeriod.cbkeydata)
		'"0":전체, "1":상장주식 등, "2":기타
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_APLY_CLCD" , 0 , g_szType) 
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_BSWR_CODE" , 0 , "200")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SCTY_INFO_IQRY_YN" , 0 , "L")
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'금융투자소득 기본공제 조회
	If szTranID == "obcsb_fiin_001r" Then
		Dim nCnt1, nCnt2
		nCnt1 = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		nCnt2 = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock2")
		
'		Form.ShowAlert(nCnt1, nCnt2)
		
		'상단 데이터 영역 세팅
		Dim szRegAmt, szAbleAmt
		If g_szType == "1" Then
			szRegAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STTP_AMT" , 0)
			szAbleAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STCK_ABLE_AMT" , 0)
		Else
			szRegAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ETC_AMT" , 0)
			szAbleAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ETC_ABLE_AMT" , 0)
		End If
		
'		Form.ShowAlert(szRegAmt, szAbleAmt)
		
		If CInt(tabType.currenttab) == 0 Then
			tblInfo.SetCellString(0, 1, "5천만원")
		Else
			tblInfo.SetCellString(0, 1, "250만원")
		End If
		tblInfo.SetCellString(1, 1, szRegAmt)
		tblInfo.SetCellString(2, 1, szAbleAmt)
		
		'그리드 리스트 세팅
		If CInt(nCnt2) > 0 Then
			grdList.visible = true
			lblNoData.visible = false
			
			Dim nIndex
			nIndex = CInt(grdList.rowcount)
			
			Dim szName, szType, szAmt, szNextYn, szRegDate
			grdList.rowcount = nCnt2
			For i = 0 to CInt(nCnt2) - 1 
'				szName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "" , i)
				szName = Form.GetMetaData("은행코드", DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "BANK_CODE" , i))
				If tabType.currenttab == 0 Then
					szType = "상장주식 등"
				Else
					szType = "기타"
				End If
				szAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "BSDD_REG_AMT" , i)
				If DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CROV_YN" , i) == "Y" Then
					szNextYn = "YES"
				Else
					szNextYn = "NO"
				End If
				szRegDate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "APLT_DATE" , i)
				
				
				grdList.SetCellData("bd_name", nIndex+i, szName)
				grdList.SetCellData("bd_title1", nIndex+i, "구분")
				grdList.SetCellData("bd_title2", nIndex+i, "적용금액")
				grdList.SetCellData("bd_title3", nIndex+i, "차기연도 이월여부")
				grdList.SetCellData("bd_title4", nIndex+i, "협회등록일자")
				
				If CInt(tabType.currenttab) == 0 Then
					grdList.SetCellData("bd_type", nIndex+i, "상장주식 등")
				Else
					grdList.SetCellData("bd_type", nIndex+i, "기타")
				End If
				grdList.SetCellData("bd_apply", nIndex+i, szAmt)
				grdList.SetCellData("bd_nextyear", nIndex+i, szNextYn)
				grdList.SetCellData("bd_regdate", nIndex+i, szRegDate)
				
'				Form.ShowAlert(i, szName)
			Next
			
			'SCTY_INFO_IQRY_YN = "S" 로도 OutBlock1 조회되게끔 수정되어서 아래 obcsb_fiin_001r_1 서비스를 호출할 필요 없음.
			
			'금융투자소득 기본공제 조회(상단 금액 조회)
'			DATAMANAGER.RequestTranData( "obcsb_fiin_001r_1" )
		
		Else
			grdList.visible = false
			lblNoData.visible = true
		End If
		
	'금융투자소득 기본공제 조회(상단 금액 조회)
	ElseIf szTranID == "obcsb_fiin_001r_1" Then
		'상단 데이터 영역 세팅
		Dim szRegAmt, szAbleAmt
		If g_szType == "1" Then
			szRegAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STTP_AMT" , 0)
			szAbleAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STCK_ABLE_AMT" , 0)
		Else
			szRegAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ETC_AMT" , 0)
			szAbleAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ETC_ABLE_AMT" , 0)
		End If
		
		If CInt(tabType.currenttab) == 0 Then
			tblInfo.SetCellString(0, 1, "5천만원")
		Else
			tblInfo.SetCellString(0, 1, "250만원")
		End If
		tblInfo.SetCellString(1, 1, szRegAmt)
		tblInfo.SetCellString(2, 1, szAbleAmt)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	'내역없을경우 내려오는 오류메시지 예외처리
	If InStr(szSubMsg, "투자자 없음") <> 0 Or InStr(szSubMsg, "등록된내역이") <> 0 Then
		grdList.visible = false
		lblNoData.visible = true
		Exit Sub
	End If
	
	If szSubMsg <> "" And szSubMsg <> Null Then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	Else
		Form.ShowAlert("알림", szErrMsg)
	End If
	
	grdList.visible = false
	lblNoData.visible = true
End Sub

'============================================================================
Sub tabType_OnTabChanged(nCurrentTab)
	If nCurrentTab == 0 Then
		g_szType = "1"
	Else
		g_szType = "2"
	End If
	
	grdList.SetClear()
	
	tblInfo.SetCellString(0, 1, "")
	tblInfo.SetCellString(1, 1, "")
	tblInfo.SetCellString(2, 1, "")
	
	'금융투자소득 기본공제 조회
	DATAMANAGER.RequestTranData( "obcsb_fiin_001r" )
End Sub

'============================================================================
Sub cmbPeriod_OnEditComplete(iIndex)
	grdList.SetClear()
	
	tblInfo.SetCellString(0, 1, "")
	tblInfo.SetCellString(1, 1, "")
	tblInfo.SetCellString(2, 1, "")
	
	'금융투자소득 기본공제 조회
	DATAMANAGER.RequestTranData( "obcsb_fiin_001r" )
End Sub

'============================================================================
Sub lblMoveReg_OnClick()
	'금융투자소득세 신청화면 이동
	Form.OpenScreen("80001" , "")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName == "INFO_CLICK" Then
		Form.OpenFramePopup("mbonl80000_p1" , "" , "")
	End If
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData("obcsb_fiin_001r") Then
		DATAMANAGER.RequestNextData("obcsb_fiin_001r")
	End If
End Sub

