'============================================================================
' 01. 화 면 명 : 자주쓰는은행계좌등록
' 02. 화면설명 : 자주쓰는은행계좌등록
' 03. 작    성 : 2016.02.15 ~ 최지희
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szFirstAcnt		'첫번째 계좌번호(일련번호포함)
Dim g_szAccountNumber	'계좌번호 (8)
Dim g_szUserJumin		'실명확인번호(주민번호)
Dim g_szUserNum			'고객번호
Dim g_szIRow			'선택된 행의 인덱스

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)
	DATAMANAGER.ClearInputData( 0 , szTranID)

	if szTranID == "obacp_opop_064r" then
		DATAMANAGER.SetDataValue(0, "obacp_opop_064r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)	'계좌번호8글자
		DATAMANAGER.RequestTranData("obacp_opop_064r")
	end if
	
	if szTranID == "obrtp_tact_002r" then
	    l_szJumin = Form.GetSharedData("&JUMIN_NUM", false )
		'DATAMANAGER.SetDataValue(0, "obrtp_tact_002r", "InBlock1", "RCNO" , 0 , g_szUserJumin)
		DATAMANAGER.SetDataValue(0, "obrtp_tact_002r", "InBlock1", "RCNO_PIP" , 0 , l_szJumin)
		DATAMANAGER.SetDataValue(0, "obrtp_tact_002r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		DATAMANAGER.SetDataValue(0,  "obrtp_tact_002r", "InBlock1", "ONCO_OTCO_CLS_CODE", 0 , "0")	'자사타사구분코드 0모두, 1당사, 2타사
		DATAMANAGER.RequestTranData("obrtp_tact_002r")
	end if
	
	if szTranID == "obrtp_tact_004a" then
	    l_szJumin = Form.GetSharedData("&JUMIN_NUM", false )
		'DATAMANAGER.SetDataValue(0, "obrtp_tact_004a", "InBlock1", "RCNO" , 0 , g_szUserJumin)	'실명확인번호
		DATAMANAGER.SetDataValue(0, "obrtp_tact_004a", "InBlock1", "RCNO_PIP" , 0 , l_szJumin)	'실명확인번호
		
		Dim szTempSerial, szTempBankCode, szTempAcno, szTempAccName, szTempUserName, szTempBankName
		szTempSerial = Grid0.GetCellData( "bd_cell5", g_szIRow )	'일련번호
		szTempBankCode = Grid0.GetCellData( "bd_cell9", g_szIRow )	'은행코드
		szTempAcno = Grid0.GetCellData( "bd_cell6", g_szIRow )			'
		szTempAccName = Grid0.GetCellData( "bd_cell2", g_szIRow )
		szTempUserName = Grid0.GetCellData( "bd_cell7", g_szIRow )
		
		DATAMANAGER.SetDataValue(0,  "obrtp_tact_004a", "InBlock1", "SRNO", 0 , szTempSerial)	'일련번호
		
		if szTempBankCode == "287" then
			DATAMANAGER.SetDataValue(0,  "obrtp_tact_004a", "InBlock1", "ONCO_OTCO_CLS_CODE", 0 , "1")	'자타사구분코드
		else
			DATAMANAGER.SetDataValue(0,  "obrtp_tact_004a", "InBlock1", "ONCO_OTCO_CLS_CODE", 0 , "2")	'자타사구분코드
		end if
		
		
		DATAMANAGER.SetDataValue(0,  "obrtp_tact_004a", "InBlock1", "ACNO", 0 , g_szAccountNumber)	'계좌번호
		DATAMANAGER.SetDataValue(0,  "obrtp_tact_004a", "InBlock1", "BANK_ACNM", 0 , szTempAccName)	'은행계좌명
		DATAMANAGER.SetDataValue(0, "obrtp_tact_004a", "InBlock1", "USER_NAME", 0 , szTempUserName)	'사용자명
		DATAMANAGER.SetDataValue(0, "obrtp_tact_004a", "InBlock1", "USE_ABLE_YN" , 0 , "N")	'사용가능여부		
		DATAMANAGER.RequestTranData("obrtp_tact_004a")
	end if
	
	
	if szTranID == "obrtp_tact_005a" then
		DATAMANAGER.SetDataValue(0, "obrtp_tact_005a", "InBlock1", "CSNO" , 0 , g_szUserNum)	'고객번호
		
		Dim szStarSrno, szFinSrno, szSrnoCount
		szStarSrno = DATAMANAGER.GetDataValue(0, "obrtp_tact_002r", "OutBlock1", "SRNO" , 0)
		szSrnoCount = DATAMANAGER.GetDataCount(0, "obrtp_tact_002r", "OutBlock1")-1
		
		szFinSrno = DATAMANAGER.GetDataValue(0, "obrtp_tact_002r", "OutBlock1", "SRNO" , szSrnoCount)
		
		
		DATAMANAGER.SetDataValue(0, "obrtp_tact_005a", "InBlock1", "STA_SRNO" , 0 , szStarSrno)	'시작일련번호
		DATAMANAGER.SetDataValue(0, "obrtp_tact_005a", "InBlock1", "FIN_SRNO" , 0 , szFinSrno)		'종료일련번호
		Dim szTempBCode	'은행코드여부
		
		for i=0 to Grid0.rowcount-1
			if Grid0.GetCellData( "bd_cell9", i ) == "" or Grid0.GetCellData( "bd_cell9", i ) == "287" then
				szTempBCode = "1"
			else
				szTempBCode = "2"
			end if
			
			DATAMANAGER.SetDataValue(0, "obrtp_tact_005a", "InBlock2", "ONCO_OTCO_CLS_CODE" , i , szTempBCode)	'자타사구분코드
			
			if szTempBCode <> "1" then
				DATAMANAGER.SetDataValue(0, "obrtp_tact_005a", "InBlock2", "BANK_CODE" , i , Grid0.GetCellData( "bd_cell9", i ))
				DATAMANAGER.SetDataValue(0, "obrtp_tact_005a", "InBlock2", "BANK_USE_ACNO" , i , Grid0.GetCellData( "bd_cell6", i ))
				DATAMANAGER.SetDataValue(0, "obrtp_tact_005a", "InBlock2", "BANK_ACNM" , i , Trim(Grid0.GetCellData( "bd_cell2", i )))				
			end if
			DATAMANAGER.SetDataValue(0, "obrtp_tact_005a", "InBlock2", "CNFT_ACNO" , i , Trim(Grid0.GetCellData( "bd_cell10", i )))
			DATAMANAGER.SetDataValue(0,  "obrtp_tact_005a", "InBlock2", "CNFT_ASNO", i , Trim(Grid0.GetCellData( "bd_cell11", i )))
			DATAMANAGER.SetDataValue(0, "obrtp_tact_005a", "InBlock2", "USER_NAME" , i , Grid0.GetCellData( "bd_cell7", i ))
			DATAMANAGER.SetDataValue(0,  "obrtp_tact_005a", "InBlock2", "ACNO", i , Grid0.GetCellData( "bd_cell12", i ))
			
			Dim szRowSrno
			szRowSrno = DATAMANAGER.GetDataValue(0, "obrtp_tact_002r", "OutBlock1", "SRNO" , i)
			DATAMANAGER.SetDataValue(0, "obrtp_tact_005a", "InBlock2", "SRNO" , i , szRowSrno)
		next
	
		DATAMANAGER.RequestTranData("obrtp_tact_005a")
	end if
End Function 

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	g_szIRow = ""
	'////// 이체화면에서 출금계좌번호 넘어올 경우와 기존 계좌번호를 사용할 경우 분기처리를 해야함 /////////

	Grid0.rowmove = "1"

	g_szFirstAcnt = Account0.GetAccountByIndex( 0 )
	
	Dim szSharedAccount
	g_szAccountNumber = Left(g_szFirstAcnt , 8)
	g_szUserJumin = ""
	g_szUserNum = ""
	
	btnSearch_OnClick()
	
End Sub

'주민번호,일련번호,은행명,계좌번호, 수취인계좌명, 계좌별칭, 은행코드, 사용여부
'============================================================================
' btnEnroll_OnClick - 등록하기 
'============================================================================
Sub btnEnroll_OnClick()
	
	'enroll, 주민번호,일련번호,은행명,계쫘번호, 수취인계좌명, 계좌별칭, 은행코드, 사용여부
	Dim szTempData
	szTempData = "enroll★"&g_szUserJumin&"★"&Right(g_szFirstAcnt , 2)&"★은행명★"&g_szAccountNumber&"★수취인계좌명★계좌별칭★은행코드★사용여부★"&g_szAccountNumber
'	szTempData = "enroll★주민번호★일련번호★은행명★계좌번호★수취인계좌명★계좌별칭★은행코드★사용여부★출금계좌번호"
'	szTempData = "enroll★"& szSendJumin & "★" & szSendSerial & "★" & szSendBankName & "★" & szSendAcno & "★" & szSendAccName & "★" & szSendUserName & "★" & szSendBankCode & "★" & szSendRnDel
	Form.OpenPopup("mbbnk61080_p1" , szTempData, sPosInfo)
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obacp_opop_064r" then	'종합계좌기준계좌
		if DATAMANAGER.GetDataValue(0,  "obacp_opop_064r", "OutBlock1", "RCNO", 0) <> g_szUserJumin then
			g_szUserJumin = DATAMANAGER.GetDataValue(0,  "obacp_opop_064r", "OutBlock1", "RCNO", 0)	'실명확인번호(주민번호)
		end if
		g_szUserNum = DATAMANAGER.GetDataValue(0, "obacp_opop_064r", "OutBlock1", "CSNO", 0)	'고객번호
		
		TR_Inquiry("obrtp_tact_002r")		'자주쓰는 계좌 조회		
	end if
	
	
	if szTranID == "obrtp_tact_002r" then	'자주쓰는계좌조회
		for i=0 to DATAMANAGER.GetDataCount(0, "obrtp_tact_002r", "OutBlock1")-1
			if DATAMANAGER.GetDataValue(0, "obrtp_tact_002r", "OutBlock1", "BANK_CODE" , i) == "" or DATAMANAGER.GetDataValue(0, "obrtp_tact_002r", "OutBlock1", "BANK_CODE" , i) == "287" then
				Dim szTempAccount, szTempNickName
				Grid0.SetCellData( "bd_cell1", i, "메리츠증권" )	'은행명
				Grid0.SetCellData( "bd_cell2", i, DATAMANAGER.GetDataValue(0, "obrtp_tact_002r", "OutBlock1", "CNFT_ACNM" , i) )	'상대계좌명
				szTempAccount = Grid0.GetCellData( "bd_cell10", i ) & Grid0.GetCellData( "bd_cell11", i )
				Grid0.SetCellData( "bd_cell6", i, szTempAccount)	'계좌번호				
			else
				Grid0.SetCellData( "bd_cell2", i, DATAMANAGER.GetDataValue(0, "obrtp_tact_002r", "OutBlock1", "BANK_ACNM" , i) )	
				Grid0.SetCellData( "bd_cell6", i, DATAMANAGER.GetDataValue(0, "obrtp_tact_002r", "OutBlock1", "BANK_USE_ACNO" , i))	'계좌번호
			end if
		next		
	end if
	
	 
	if szTranID == "obrtp_tact_004a" then
		Form.MsgBox("알림", "자주쓰는계좌 삭제가 완료되었습니다.", "", 0)
		btnSearch_OnClick()	'재조회
	end if
	
	
	if szTranID == "obrtp_tact_005a" then
		Form.MsgBox("알림", "자주쓰는계좌 순서가 변경되었습니다.", "", 0)
		btnSearch_OnClick()	'재조회
	end if
End Sub


'============================================================================
' btnSearch_OnClick - 조회
'============================================================================
Sub btnSearch_OnClick()
	g_szIRow = ""
	TR_Inquiry("obacp_opop_064r")	'종합계좌기준계좌
End Sub


'============================================================================
' Grid0_OnClickUp - 삭제, 수정 버튼 클릭 시 
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	
	g_szIRow = lRow
	
	if szCellID == "bd_cell0" then	'삭제 버튼 클릭
		Form.MsgBox("알림", "삭제하시겠습니까?", "deleteokcancel", 1)
	end if
	
	if szCellID == "bd_cell3" then	'수정 버튼 클릭
		'modify, 주민번호,일련번호,은행명,계좌번호, 수취인계좌명, 계좌별칭, 은행코드, 사용여부
		Dim szSendJumin, szSendSerial, szSendBankName, szSendAcno, szSendAccName, szSendUserName, szSendBankCode, szSendRnDel
		szSendJumin = g_szUserJumin
		szSendSerial = Grid0.GetCellData( "bd_cell5", g_szIRow )
		szSendBankName = Grid0.GetCellData( "bd_cell1", g_szIRow )
		szSendAcno = Grid0.GetCellData( "bd_cell6", g_szIRow )
		szSendAccName = Grid0.GetCellData( "bd_cell2", g_szIRow )
		szSendUserName = Grid0.GetCellData( "bd_cell7", g_szIRow )
		szSendBankCode = Grid0.GetCellData( "bd_cell9", g_szIRow )
		szSendRnDel = "Y"
		Dim szTempData
'		szTempData = "modify★주민번호★일련번호★은행명★계좌번호★수취인계좌명★계좌별칭★은행코드★사용여부★출금계좌번호"
		szTempData = "modify★"& szSendJumin & "★" & szSendSerial & "★" & szSendBankName & "★" & szSendAcno & "★" & szSendAccName & "★" & szSendUserName & "★" & szSendBankCode & "★" & szSendRnDel & "★" & g_szAccountNumber
		Form.OpenPopup("mbbnk61080_p1" , szTempData, sPosInfo)
	end if

End Sub

'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)	
	
	if sKeyName == "deleteokcancel" then
		if sRet == "ok" then	'삭제 obtrp_tact_004a (삭제하는 tr) 후 재조회			
				TR_Inquiry("obrtp_tact_004a")
		end if
	elseif sKeyName == "modifyok" then
		TR_Inquiry("obrtp_tact_002a")
	end if
	
End Sub


'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbbnk61080_p1" then
		if sRet == "ok" then
			btnSearch_OnClick()
		end if
	end if
End Sub


