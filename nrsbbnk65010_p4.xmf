'==============================================
' 컬러코드
'==============================================
' 기본 텍스트 컬러 (검정색)
Dim g_szTxtColor_Normal 
g_szTxtColor_Normal 	= "334"

' 기본 텍스트 컬러 (회색)
Dim g_szTxtColor_Grey 
g_szTxtColor_Grey 	= "333"

' 기본 텍스트 컬러 (흰색)
Dim g_szTxtColor_White 
g_szTxtColor_White 	= "338"

' 빨강
Dim g_szTxtColor_Red 
g_szTxtColor_Red = "290"

' 파랑
Dim g_szTxtColor_Blue 
g_szTxtColor_Blue = "291"

' 기본 배경색상
Dim g_szContBgColor
g_szContBgColor = "320"

' 기본 구분선 색상
Dim g_szLineColor
g_szLineColor = "256"

' 빨강
Dim g_szBadgeBgColor_Red
g_szBadgeBgColor_Red = "339"

' 파랑
Dim g_szBadgeBgColor_Blue
g_szBadgeBgColor_Blue = "340"

'==============================================
' 기타 전역변수
'==============================================
' 계좌번호
Dim g_szAcno
g_szAcno = ""

Dim g_szAsno
g_szAsno = ""

' 계좌 비밀번호
Dim g_szPwd
g_szPwd = ""

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************

'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	'----------------------------------------------
	contBg.setEnableScroll(false)
	
	contBg.lblTitle.paddinginfo = "0,0,0,0"
	contBg.lblTitle.fgcolor = g_szTxtColor_Normal
	
	contBg.imgNotice.maintainratio = "1"
	
	contBg.lblInfo1.paddinginfo = "0,0,0,0"
	contBg.lblInfo1.maxlinecnt = "1"
	contBg.lblInfo1.fgcolor = g_szTxtColor_Red
	contBg.lblInfo1.visible = true
	
	'----------------------------------------------
	contBg.contTop.bgcolor = g_szContBgColor
	
	contBg.contTop.lblTitleTarget.paddinginfo = "0,0,0,0"
	contBg.contTop.lblTitleTarget.maxlinecnt = "1"
	contBg.contTop.lblTitleTarget.fgcolor = g_szTxtColor_Grey
	
	contBg.contTop.lblCrcd00.paddinginfo = "0,0,0,0"
	contBg.contTop.lblCrcd00.maxlinecnt = "1"
	contBg.contTop.lblCrcd00.fgcolor = g_szTxtColor_Normal
	
	contBg.contTop.imgFlag00.maintainratio = "3"
	
	'----------------------------------------------
	contBg.contBottom.lblTitleAcc.paddinginfo = "0,0,0,0"
	contBg.contBottom.lblTitleAcc.maxlinecnt = "1"
	contBg.contBottom.lblTitleAcc.fgcolor = g_szTxtColor_Normal
	
	contBg.contBottom.lblDataAcc.paddinginfo = "0,0,0,0"
	contBg.contBottom.lblDataAcc.maxlinecnt = "1"
	contBg.contBottom.lblDataAcc.fgcolor = g_szTxtColor_Normal
	
	contBg.contBottom.lblLine0.bgcolor = g_szTxtColor_Normal
	
	contBg.contBottom.lblSubTitle00.paddinginfo = "0,0,0,0"
	contBg.contBottom.lblSubTitle00.maxlinecnt = "1"
	contBg.contBottom.lblSubTitle00.fgcolor = g_szTxtColor_Grey
	
	contBg.contBottom.imgFlag02.maintainratio = "2"
	
	contBg.contBottom.lblSubTitle01.paddinginfo = "0,0,0,0"
	contBg.contBottom.lblSubTitle01.maxlinecnt = "1"
	contBg.contBottom.lblSubTitle01.fgcolor = g_szTxtColor_Grey
	
	contBg.contBottom.imgFlag03.maintainratio = "2"
	
	contBg.contBottom.lblSubTitle02.paddinginfo = "0,0,0,0"
	contBg.contBottom.lblSubTitle02.maxlinecnt = "1"
	contBg.contBottom.lblSubTitle02.fgcolor = g_szTxtColor_Grey
	
	contBg.contBottom.lblData00.paddinginfo = "0,0,0,0"
	contBg.contBottom.lblData00.maxlinecnt = "1"
	contBg.contBottom.lblData00.fgcolor = g_szTxtColor_Normal
	
	contBg.contBottom.lblData01.paddinginfo = "0,0,0,0"
	contBg.contBottom.lblData01.maxlinecnt = "1"
	contBg.contBottom.lblData01.fgcolor = g_szTxtColor_Normal
	
	contBg.contBottom.lblData02.paddinginfo = "0,0,0,0"
	contBg.contBottom.lblData02.maxlinecnt = "1"
	contBg.contBottom.lblData02.fgcolor = g_szTxtColor_Normal
	
	contBg.contBottom.lblSubTitle10.paddinginfo = "0,0,0,0"
	contBg.contBottom.lblSubTitle10.maxlinecnt = "1"
	contBg.contBottom.lblSubTitle10.fgcolor = g_szTxtColor_Grey
	
	contBg.contBottom.lblData10.paddinginfo = "0,0,0,0"
	contBg.contBottom.lblData10.maxlinecnt = "1"
	contBg.contBottom.lblData10.fgcolor = g_szTxtColor_Normal

	contBg.contBottom.lblInfo0.paddinginfo = "0,0,0,0"
	contBg.contBottom.lblInfo0.maxlinecnt = "4"
	contBg.contBottom.lblInfo0.fgcolor = g_szTxtColor_Red
	contBg.contBottom.lblInfo0.visible =false
	
	contBg.contBottomError.bgcolor = g_szContBgColor
	contBg.contBottomError.lblTitle.paddinginfo = "0,0,0,0"
	contBg.contBottomError.lblTitle.maxlinecnt = "1"
	contBg.contBottomError.lblTitle.fgcolor = g_szTxtColor_Normal
	
	contBg.contBottomError.lblData.paddinginfo = "0,0,0,0"
'	contBg.contBottomError.lblData.maxlinecnt = "2"
	contBg.contBottomError.lblData.fgcolor = g_szTxtColor_Normal
	
	contBg.contBottomError.lblLine0.bgcolor = g_szLineColor
	
	contBg.contBottomError.visible = false
	
	contBg.btnCancel.fgcolor = g_szTxtColor_Grey
	contBg.btnOk.fgcolor = g_szTxtColor_White
End Function

'===============================================
' 배경 컨테이너 크기 조정
'===============================================
Function DisplaySetting_ContBg(szGbn)
	nPannelHeight = 0

	nTotalHeight = 56 + nPannelHeight
	contBg.top = 755 - nTotalHeight
	contBg.height = nTotalHeight+5
	
	contBg.visible = true
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()

	Dim szLinkData
	szLinkData = ""
	szLinkData = Form.GetOpenLinkData()
	
	if szLinkData == "" then
		Form.CloseForm()
		Exit Sub
	end if 
	
	Init_Control()
	
	arrLinkData = split(szLinkData, "★")
	
	if #arrLinkData < 1 then
		Form.CloseForm()
		Exit Sub
	else
		if #arrLinkData > 0 then
			if arrLinkData(0) == "Complete" then
				contBg.contBottomError.visible = false
				contBg.contBottom.visible = true
				if #arrLinkData > 4 then
					contBg.imgNotice.imgpath = "icon_confirm"
					contBg.lblTitle.caption = "목표환율환전 신청이 완료되었습니다."
					
					'성공여부★주문구분★목표통화`목표환율`환전금액★기간구분`실제기간★계좌번호정보
					
					'주문구분
					arrLinkData_1 = split(arrLinkData(1), "`")
					
					'목표통화`목표환율`환전금액
					arrLinkData_2 = split(arrLinkData(2), "`")
					
					'기간구분`실제기간
					arrLinkData_3 = split(arrLinkData(3), "`")
					
					'계좌번호정보
					arrLinkData_4 = split(arrLinkData(4), "`")
					
					szFlag1 = Form.getIconImg("CRCD", arrLinkData_2(0))
					if szFlag1 = "" then
						szFlag1 = "flag_general"
					end if
					
					szFlag2 = Form.getIconImg("CRCD", "KRW")
					if szFlag2 = "" then
						szFlag2 = "flag_general"
					end if
					
					contBg.contTop.lblCrcd00.caption = arrLinkData_2(1)
					contBg.contTop.imgFlag00.imgpath = szFlag1
					
					nTxtWidth = Form.getTextWidth(arrLinkData_2(1), 0, true, false)
					nleft = (375 - nTxtWidth) / 2 - 27
					contBg.contTop.imgFlag00.left = nleft
					
					contBg.contBottom.lblDataAcc.caption = arrLinkData_4(0)
					
					szGbn = ""
					if arrLinkData_1(0) == "1" then
						szGbn = "(원화→외화) 외화매수"
						contBg.contBottom.lblData10.caption = szGbn
						contBg.contBottom.lblData10.changeTextAttr(8,4,290,-1,true)
						
						contBg.contBottom.imgFlag02.imgpath = szFlag1
						contBg.contBottom.imgFlag03.imgpath = szFlag2
						
						contBg.contBottom.lblData00.caption = arrLinkData_2(2) & " " & arrLinkData_2(0)
						contBg.contBottom.lblData01.caption = "환전 체결 후 확정"
					
					elseif arrLinkData_1(0) == "2" then
						szGbn = "(외화→원화) 외화매도"
						contBg.contBottom.lblData10.caption = szGbn
						contBg.contBottom.lblData10.changeTextAttr(8,4,291,-1,true)
						
						contBg.contBottom.imgFlag03.imgpath = szFlag1
						contBg.contBottom.imgFlag02.imgpath = szFlag2
						
						contBg.contBottom.lblData01.caption = arrLinkData_2(2) & " " & arrLinkData_2(0)
						contBg.contBottom.lblData00.caption = "환전 체결 후 확정"
					end if	
					
					contBg.contBottom.lblData02.caption = arrLinkData_3(1)
					
					contBg.contBottom.lblInfo0.visible = true
					szData = "설정기간 내 목표환율 도달 시, 환전 처리됩니다.\n환전내역에서 처리결과를 확인해주세요."
					contBg.contBottom.lblInfo0.caption = szData
				end if
			
			elseif arrLinkData(0) == "Error" then
				contBg.contBottomError.visible = true
				contBg.contBottom.visible = false
				contBg.contBottomError.top = 325
				
				if #arrLinkData > 5 then
					contBg.imgNotice.imgpath = "icon_tact_caution"
					contBg.lblTitle.caption = "환전이 처리되지 않았습니다."
					'성공여부★주문구분★목표통화`목표환율`환전금액★기간구분`실제기간★계좌번호정보★에러코드`에러텍스트
						
					'주문구분
					arrLinkData_1 = split(arrLinkData(1), "`")
					
					'목표통화`목표환율`환전금액
					arrLinkData_2 = split(arrLinkData(2), "`")
					
					'기간구분`실제기간
					arrLinkData_3 = split(arrLinkData(3), "`")
					
					'계좌번호정보
					arrLinkData_4 = split(arrLinkData(4), "`")
					
					'에러코드`에러텍스트
					arrLinkData_5 = split(arrLinkData(5), "`")
					
					szFlag1 = Form.getIconImg("CRCD", arrLinkData_2(0))
					if szFlag1 = "" then
						szFlag1 = "flag_general"
					end if
					
					contBg.contTop.lblCrcd00.caption = arrLinkData_2(1)
					contBg.contTop.imgFlag00.imgpath = szFlag1
					
	'				
	'				contBg.contTop.lblCrcd00.caption = arrLinkData_1(0)
	'				contBg.contTop.lblSellAmt.caption = arrLinkData_1(1)
	'				
	'				szFlag1 = Form.getIconImg("CRCD", arrLinkData_1(0))
	'				if szFlag1 = "" then
	'					szFlag1 = "flag_general"
	'				end if
	'				
	'				contBg.contTop.imgFlag00.imgpath = szFlag1
	'			
	'				contBg.contTop.lblCrcd01.caption = arrLinkData_2(0)
	'				contBg.contTop.lblBuyAmt.caption = arrLinkData_2(1)
	'		
	'				
	'				szFlag2 = Form.getIconImg("CRCD", arrLinkData_2(0))
	'				if szFlag2 = "" then
	'					szFlag2 = "flag_general"
	'				end if
	'			
	'				contBg.contTop.imgFlag01.imgpath = szFlag2
	'				
					contBg.contBottomError.lblData.caption = "["&arrLinkData_5(0)&"] " & arrLinkData_5(1)
					
					contBg.btnCancel.visible = false
					contBg.btnOk.fgcolor = g_szTxtColor_White
					contBg.btnOk.left = 0
					contBg.btnOk.width = 375
				
				end if
			end if
		end if
		
	end if 

End Sub


'===============================================
' contBg_btnCancel_OnClick
'===============================================
Sub contBg_btnCancel_OnClick()
	Form.OpenScreen("65020", "1", "")
	Form.CloseForm()
End Sub

'===============================================
' contBg_btnOk_OnClick
'===============================================
Sub contBg_btnOk_OnClick()
	Form.SendReturnToParent("EXCHANGE_END" , "OK")
	Form.CloseForm()
End Sub

