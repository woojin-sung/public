Dim G_PW_CERT_FILE '공인인증서비밀번호입력풀팝업
Dim g_OpenType	 '화면 처음 오픈시 팝업 제거 위한변수
Dim G_NOTI_FILE1   '만기연장유의사항안내(예탁)풀팝업
Dim G_NOTI_FILE2   '만기연장유의사항안내(신용)풀팝업

Dim G_Morg_Rate	'담보비율(oblon_mntn_950r)
Dim g_onln_mtrt_exts_ecpt_aply_yn	'온라인한도예외적용여부
Dim g_ApltAprvButton_Flag	'만기연장승인신청가능여부 1이면 불가
'Dim g_Popup_Flag   '팝업을 한번만 띄우기 위한 플래그

'조회용 (oblon_pros_010a/oblon_pros_020a)
Dim g_iscd
Dim g_loan_date
Dim g_loan_dtl_type_code
Dim g_intrt
Dim g_loan_qty
Dim g_loan_amt
Dim g_loan_term
Dim g_loan_srno

Dim g_sPopupFlag

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'===========================================================================
' 계좌비밀번호 입력체크함수
'===========================================================================
Function GetPWCkeck()
	Dim sACNT_PWD 
	sACNT_PWD = Form.GetCtlProp( "#EditPW1", "caption" )
	
	if sACNT_PWD == null or sACNT_PWD == "" then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	end if
	
	return false
End Function	

'===========================================================================
' 속성 초기화함수
'===========================================================================
Function SetControlViewClear()
	g_nNextFlag = false
	
	Table0.SetCellString( 0, 1, "" )
	Table0.SetCellString( 1, 1, "" )
	Table0.SetCellString( 2, 1, "" )
	Table0.SetCellString( 3, 1, "" )
	
	for i = 0 to Grid0.rowcount-1
		Grid0.SetCellData( "bd_check", i, "0" )
	next
	Grid0.rowcount = "0"

End Function	

'===========================================================================
' 숫자 리턴함수
'===========================================================================
Function GetTonumber(sNum)
	Dim nDbl
	nDbl = 0
	
	if sNum == null or Trim(sNum) == "" then
		return nDbl
	end if
	
	nDbl = CDbl(sNum)
	
	return nDbl
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_sAcc = ""
	g_nNextFlag = false
	G_PW_CERT_FILE = "mhetc90060_p5"
	G_NOTI_FILE1 = "mbonl82020_p8"	'20160912 팝업추가
	G_NOTI_FILE2 = "mbonl82020_p9"	'20160912 팝업추가
	g_sPopupFlag = "Y"
	
	if Combo0.currentindex = 0 then	'예탁
		Table0.rowcount = "4"
		Table0.height = 140
		
		Table0.top = 253
		Grid0.height = 217
		Grid0.SetCellTopCaption("th_cell7", "이자율")
	else					'신용
		'Table0.SetVisibleCol(3, 0)
		Table0.rowcount = "3"
		Table0.height = 105				
		
		Table0.top = 288 '253 + 35
		Grid0.height = 217 + 35
		Grid0.SetCellTopCaption("th_cell7", "")
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "TabChange" then
		'비밀번호없이 조회되도록 요청하여 주석처리 -> 16-03-22 전요셉과장님이 비밀번호 없으면 조회 하지 않게 요청
		
'		if GetPWCkeck() then
'			Exit Sub
'		end if

'		if Form.GetCtlProp( "#EditPW1", "caption" ) == "" then
'			Exit Sub
'		end if
		
		if g_sAcc <> sParam then
			g_sPopupFlag = "Y"
		end if
		
		g_sAcc = sParam
		
		SetControlViewClear()	
		
		if RadioGroup0.currentindex = "0" then
			DATAMANAGER.RequestTranData( "oblon_mntn_950r" ) '체결반영 담보비율 조회
			'DATAMANAGER.RequestTranData( "oblon_pros_814r" ) '만기연장가능내역조회
		else
			DATAMANAGER.RequestTranData( "oblon_mntn_814r" )	'만기연장 취소가능내역 조회
		end if

	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mhetc90060_p8"then
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		end if 
	elseif sKeyName == G_PW_CERT_FILE then
		if sRet ~= "cancel" then				
			DATAMANAGER.RequestTranData( "oblon_pros_814a" ) '대출만기연장신청
		end if 	
	end if 
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sACNT_PWD 
	'sACNT_PWD = Form.GetCtlProp( "#EditPW1", "caption" )
	'MTS메모리보안
	'sACNT_PWD = Form.GetEncData(sACNT_PWD)
	Dim plain_rm
	
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then
		sACNT_PWD = Form.GetCtlProp( "#EditPW1", "caption" )
	else
		sACNT_PWD = Form.GetCtlProp( "#EditPW1", "encdata" )
	end if
	
	if szTranID == "oblon_pros_814r" then
	
		DATAMANAGER.SetDataValue( 0, "oblon_pros_814r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_814r", "InBlock1", "ASNO" , 0 , Right(g_sAcc, 2) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_814r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		
		if Combo0.currentindex = "0" then
			DATAMANAGER.SetDataValue( 0, "oblon_pros_814r", "InBlock1", "LOAN_DTL_TYPE_CODE" , 0 , "02%" )
			DATAMANAGER.SetDataValue( 0, "oblon_pros_814r", "InBlock1", "LOAN_TYPE_CODE"     , 0 , "02"  )  
		else
			DATAMANAGER.SetDataValue( 0, "oblon_pros_814r", "InBlock1", "LOAN_DTL_TYPE_CODE" , 0 , "01%" )
			DATAMANAGER.SetDataValue( 0, "oblon_pros_814r", "InBlock1", "LOAN_TYPE_CODE"     , 0 , "01"  )  
		end if
		
		if RadioGroup0.currentindex = "0" then
			DATAMANAGER.SetDataValue( 0, "oblon_pros_814r", "InBlock1", "PROS_CLS_CODE", 0 , "1" )	'1 처리
		else
			DATAMANAGER.SetDataValue( 0, "oblon_pros_814r", "InBlock1", "PROS_CLS_CODE", 0 , "2" )	'2 취소
		end if
		
	elseif szTranID == "oblon_mntn_814r" then
	
		DATAMANAGER.SetDataValue( 0, "oblon_mntn_814r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_mntn_814r", "InBlock1", "ASNO" , 0 , Right(g_sAcc, 2) )
		'DATAMANAGER.SetDataValue( 0, "oblon_mntn_814r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		
		if Combo0.currentindex = "0" then
			DATAMANAGER.SetDataValue( 0, "oblon_mntn_814r", "InBlock1", "LOAN_DTL_TYPE_CODE" , 0 , "02%" )  
		else
			DATAMANAGER.SetDataValue( 0, "oblon_mntn_814r", "InBlock1", "LOAN_DTL_TYPE_CODE" , 0 , "01%" )  
		end if
		
		DATAMANAGER.SetDataValue( 0, "oblon_mntn_814r", "InBlock1", "LOAN_RATE_CODE", 0 , "03" )	'03 만기연장
		
	elseif szTranID == "oblon_mntn_950r" then
	
		DATAMANAGER.SetDataValue( 0, "oblon_mntn_950r", "InBlock1", "ACNO"         , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_mntn_950r", "InBlock1", "ASNO"         , 0 , Right(g_sAcc, 2) )
		DATAMANAGER.SetDataValue( 0, "oblon_mntn_950r", "InBlock1", "CLPR_CLS_CODE", 0 , "2"  )  
		DATAMANAGER.SetDataValue( 0, "oblon_mntn_950r", "InBlock1", "ACNT_PWD"     , 0 , sACNT_PWD )
			
	elseif szTranID == "oblon_pros_010a" then
	
		DATAMANAGER.SetDataValue( 0, "oblon_pros_010a", "InBlock1", "MTRT_MNCN"		  , 0 , cdbl(Table0.GetCellString(1, 1)) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_010a", "InBlock1", "ISCD"         	  , 0 , g_iscd )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_010a", "InBlock1", "LOAN_DATE"		  , 0 , g_loan_date )  
		DATAMANAGER.SetDataValue( 0, "oblon_pros_010a", "InBlock1", "LOAN_DTL_TYPE_CODE", 0 , g_loan_dtl_type_code )
			
	elseif szTranID == "oblon_pros_020a" then
	
		DATAMANAGER.SetDataValue( 0, "oblon_pros_020a", "InBlock1", "LOAN_BSWR_CLS_CODE", 0 , "03" )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_020a", "InBlock1", "ACNO"         	  , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_020a", "InBlock1", "ASNO"      		  , 0 , Right(g_sAcc, 2) )		
		DATAMANAGER.SetDataValue( 0, "oblon_pros_020a", "InBlock1", "MTRT_DATE"		  , 0 , "99991231" )
		
		DATAMANAGER.SetDataValue( 0, "oblon_pros_020a", "InBlock1", "LOAN_DTL_TYPE_CODE", 0 , g_loan_dtl_type_code )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_020a", "InBlock1", "ISCD"		  	  , 0 , g_iscd )  
		DATAMANAGER.SetDataValue( 0, "oblon_pros_020a", "InBlock1", "LOAN_INTRT"	  	  , 0 , cdbl(Table0.GetCellString(1, 1)) )  
		DATAMANAGER.SetDataValue( 0, "oblon_pros_020a", "InBlock1", "LOAN_QTY"	  	  , 0 , g_loan_qty )  
		DATAMANAGER.SetDataValue( 0, "oblon_pros_020a", "InBlock1", "LOAN_AMT"	  	  , 0 , g_loan_amt )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_020a", "InBlock1", "LOAN_DATE"		  , 0 , g_loan_date )  
		DATAMANAGER.SetDataValue( 0, "oblon_pros_020a", "InBlock1", "LOAN_SRNO"		  , 0 , g_loan_srno)
			
	elseif szTranID == "oblon_pros_814a" then

		DATAMANAGER.ClearInputData( 0, szTranID )
		
		DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "LOAN_BSWR_CLS_CODE", 0 , "03" )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "ACNO"         	  , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "ASNO"      		  , 0 , Right(g_sAcc, 2) )	
		DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "ACNT_PWD"     	  , 0 , sACNT_PWD )
		
		for i = 0 to Grid0.rowcount-1
			
			if Grid0.GetCellData( "bd_check", i ) == "1" then
				Dim loancode, iscd, loandate, losnsrno, apltintrt, afmtrtdate
				loancode = Grid0.GetCellData( "bd_loancode", i )
				iscd 	= Grid0.GetCellData( "bd_iscd", i )
				loandate	= Grid0.GetCellData( "bd_loandate", i )
				loansrno = Grid0.GetCellData( "bd_loansrno", i )
				apltintrt = Grid0.GetCellData( "bd_intrt", i )
				afmtrtdate = LEFT(Table0.GetCellString(2, 1),4)&MID(Table0.GetCellString(2, 1),5,2)&RIGHT(Table0.GetCellString(2, 1),2)
				apltdate = Grid0.GetCellData( "bd_apltdate", i )
				apltsrno = Grid0.GetCellData( "bd_apltsrno", i )
				
				DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "LOAN_DTL_TYPE_CODE" 	, 0 , loancode )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "ISCD" 			   	, 0 , iscd )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "LOAN_DATE" 			, 0 , loandate )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "LOAN_SRNO" 			, 0 , loansrno )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "APLT_INTRT" 		, 0 , apltintrt )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "MOD_MTRT_DATE" 		, 0 , afmtrtdate )
				DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "CHAN_TYPE_CLS_CODE"  , 0 , "020" ) '프로그램내에서 바꿀것.
				'DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "CNCL_YN" , 0 , "N" )
				'DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "APLT_BRCD" , 0 , brcd )				
				DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "LOAN_MORG_RATE" 		, 0 , G_Morg_Rate )	
				
				if RadioGroup0.currentindex = "0" then
					'신청
					DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "PROS_CLS_CODE" 	, 0 , "1" )
					DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "PRD_DYNU" 		, 0 , cdbl(Table0.GetCellString(1, 1)) )	
				else
					'취소
					DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "PROS_CLS_CODE" 	, 0 , "3" )		
					
					DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "APLT_SRNO" 		, 0 , apltsrno )
					DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "APLT_DATE" 		, 0 , apltdate )
					DATAMANAGER.SetDataValue( 0, "oblon_pros_814a", "InBlock1", "PRD_DYNU" 		, 0 , 0 )	
				end if
				
				exit for
			end if
		next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "oblon_mntn_950r" then
		'g_nNextFlag = DATAMANAGER.IsMoreNextData( szTranID )
		G_Morg_Rate = DATAMANAGER.GetDataValue( 0, "oblon_mntn_950r", "OutBlock1", "CNTG_RFLC_MORG_RATE" , 0 ) '체결기준담보비율
		'g_sPopupFlag = "Y"
		
		DATAMANAGER.RequestTranData( "oblon_pros_814r" ) 
		
     elseif szTranID == "oblon_pros_814r" then		
         g_nNextFlag = DATAMANAGER.IsMoreNextData( szTranID )

		if g_sPopupFlag = "Y" then
			sEvntYn = DATAMANAGER.GetDataValue(0, "oblon_pros_814r", "OutBlock2", "EVNT_TRGT_YN" , 0)
			if sEvntYn = "Y" then
				sStaDate = DATAMANAGER.GetDataValue(0, "oblon_pros_814r", "OutBlock2", "EVNT_STA_DATE" , 0)
				sFinDate = DATAMANAGER.GetDataValue(0, "oblon_pros_814r", "OutBlock2", "EVNT_FIN_DATE" , 0)
				
				if DATAMANAGER.GetDataValue(0, "oblon_pros_814r", "OutBlock2", "EVNT_TYPE_CLCD" , 0) = "01" then
					Form.ShowAlert("알림", "비대면이벤트 대상 고객입니다. "&"\n"&"기간 : "&Left(sStaDate,4)&"."&Mid(sStaDate,5,2)&"."&Mid(sStaDate,7,2)&"~"&Left(sFinDate,4)&"."&Mid(sFinDate,5,2)&"."&Mid(sFinDate,7,2)&"\n\n"&"이벤트적용 종료일까지 2.99% 일괄적용되며, 종료일 이후 당사 기본이자율로 자동 변경됩니다.")
				else
					Form.ShowAlert("알림", "비대면이벤트 대상 고객입니다. "&"\n"&"기간 : "&Left(sStaDate,4)&"."&Mid(sStaDate,5,2)&"."&Mid(sStaDate,7,2)&"~"&Left(sFinDate,4)&"."&Mid(sFinDate,5,2)&"."&Mid(sFinDate,7,2)&"\n\n"&"종료일 이후 당사 기본이자율로 자동 변경됩니다.")
				end if
				
			else
				sDscsYn = DATAMANAGER.GetDataValue(0, "oblon_pros_814r", "OutBlock2", "DSCS_TR_TRGT_YN", 0)
				if sDscsYn = "Y" then
					sFinDate = DATAMANAGER.GetDataValue(0, "oblon_pros_814r", "OutBlock2", "FIN_DATE" , 0)
					if Combo0.currentindex == "1" then
						Form.ShowAlert("알림", "교섭이자율 대상 고객입니다." & "\n\n" & "기간 : " & "~ "&Left(sFinDate,4)&"."&Mid(sFinDate,5,2)&"."&Mid(sFinDate,7,2) & "\n\n" & "교섭 종료일 결제잔고까지 교섭이자율 적용, 종료일 익일 신규 매매분(결제기준)부터 기본이자율로 적용됩니다.")
					else
						Form.ShowAlert("알림", "교섭이자율 대상 고객입니다." & "\n\n" & "기간 : " & "~ "&Left(sFinDate,4)&"."&Mid(sFinDate,5,2)&"."&Mid(sFinDate,7,2) & "\n\n" & "교섭 종료일 이후 당사 기본이자율로 자동 변경되며, 대출 실행 및 만기연장 처리시 적용됩니다.")
					end if
					
				end if
			end if
		end if
		
		g_sPopupFlag = "N"
		
		g_onln_mtrt_exts_ecpt_aply_yn = DATAMANAGER.GetDataValue( 0, "oblon_pros_814r", "OutBlock2", "ONLN_MTRT_EXTS_ECPT_APLY_YN" , 0 ) '온라인만기연장예외적용여부
		Dim nCnt, nIndex
		nCnt = DATAMANAGER.GetDataCount( 0, "oblon_pros_814r", "OutBlock1" )
		if nCnt > 0 then
			Dim LOAN_DTL_TYPE_CODE, typname, LOAN_ISSU_GR_CODE, issname
			nIndex = Grid0.rowcount-nCnt
		
			for i = 0 to nCnt-1
				LOAN_DTL_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "oblon_pros_814r", "OutBlock1", "LOAN_DTL_TYPE_CODE"  , i )
				LOAN_ISSU_GR_CODE  = DATAMANAGER.GetDataValue( 0, "oblon_pros_814r", "OutBlock1", "LOAN_ISSU_TYPE_NAME" , i )
				typname = Form.GetMetaData("대출상세유형코드", LOAN_DTL_TYPE_CODE)
				issname = Form.GetMetaData( "대출종목군코드" , LOAN_ISSU_GR_CODE )
				
				Grid0.SetCellData( "bd_typename", nIndex, typname )
				
				'Form.ShowAlert(LOAN_ISSU_GR_CODE, issname)
							
				if RIGHT(LOAN_ISSU_GR_CODE, 1) == "1" then
					Grid0.SetCellData("bd_loanissunm", nIndex, "A군")
				elseif RIGHT(LOAN_ISSU_GR_CODE, 1) == "2" then
					Grid0.SetCellData("bd_loanissunm", nIndex, "B군")
				elseif RIGHT(LOAN_ISSU_GR_CODE, 1) == "3" then
					Grid0.SetCellData("bd_loanissunm", nIndex, "C군")
				elseif RIGHT(LOAN_ISSU_GR_CODE, 1) == "4" then
					Grid0.SetCellData("bd_loanissunm", nIndex, "D군")
				else
					Grid0.SetCellData("bd_loanissunm", nIndex, issname)
				end if
				
				nIndex = nIndex+1
			next
		end if
     elseif szTranID == "oblon_mntn_814r" then		
         g_nNextFlag = DATAMANAGER.IsMoreNextData( szTranID )

		Dim nCnt, nIndex
		nCnt = DATAMANAGER.GetDataCount( 0, "oblon_pros_814r", "OutBlock1" )
		if nCnt > 0 then
			Dim LOAN_DTL_TYPE_CODE, typname
			nIndex = Grid0.rowcount-nCnt
		
			for i = 0 to nCnt-1
				LOAN_DTL_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "oblon_pros_814r", "OutBlock1", "LOAN_DTL_TYPE_CODE" , i )
				typname = Form.GetMetaData("대출상세유형코드", LOAN_DTL_TYPE_CODE)
				
				Grid0.SetCellData( "bd_typename", nIndex, typname )
				
				nIndex = nIndex+1
			next
		end if	
		
	elseif szTranID == "oblon_pros_010a" then	
	
		Table0.SetCellString(2, 1, DATAMANAGER.GetDataValue( 0, "oblon_pros_010a", "OutBlock1", "MTRT_DATE" , 0 ))	'변경만기일
	 
		DATAMANAGER.RequestTranData( "oblon_pros_020a" ) 
	
	elseif szTranID == "oblon_pros_020a" then
	
		if DATAMANAGER.GetDataValue( 0, "oblon_pros_020a", "OutBlock1", "LOAN_ABLE_YN" , 0 ) = "N" then
			ButtonOK.enable = false
			Table0.SetCellString(0, 1, "불가/"&DATAMANAGER.GetDataValue( 0, "oblon_pros_020a", "OutBlock1", "RMRK" , 0 ))
		elseif DATAMANAGER.GetDataValue( 0, "oblon_pros_020a", "OutBlock1", "LOAN_ABLE_YN" , 0 ) = "Y" then
			ButtonOK.enable = true
			Table0.SetCellString(0, 1, "가능")
			
			if g_ApltAprvButton_Flag = "1" then
				ButtonOK.enable = false
				Table0.SetCellString(0, 1, "불가")
			end if
		end if
	
	elseif szTranID == "oblon_pros_814a" then
		Dim sMsg, sSubMsg
		sMsg = DATAMANAGER.GetDataMsgText( szTranID )
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			sMsg = sMsg.." "..sSubMsg
		end if
		
		Form.MsgBox( "알림", sMsg, "", 6 )
		
		ButtonOK.enable = false
		
		SetControlViewClear()	
			
		if RadioGroup0.currentindex = "0" then
			DATAMANAGER.RequestTranData( "oblon_mntn_950r" ) '체결반영 담보비율 조회
			'DATAMANAGER.RequestTranData( "oblon_pros_814r" ) '만기연장가능내역조회
		else
			DATAMANAGER.RequestTranData( "oblon_mntn_814r" )	'만기연장 취소가능내역 조회
		end if
		
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "oblon_pros_814a" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	elseif szTranID == "oblon_pros_814r" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	elseif szTranID == "oblon_mntn_814r" then	
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	
	'V002 대출일수의 계산을 위한 변수(90 180 270 ... 순으로 움직여야하는데 영업일에 따라 91, 92 이러한 경우도 있으므로 맨끝자리 제거한 후 0 붙임)
	Dim loan_term
	
	loan_term = Grid0.GetCellData("bd_aplydynu", lRow)


	g_loan_term = Mid(loan_term, 1, Len(loan_term)-1)&"0"
		
	
	if szCellID == "bd_check" then
		
		'V002 대출 불가 예외 케이스 추가 'V003
'		if (g_loan_term+90) Mod 90 <> 0 then
'			Form.ShowAlert("", "당사 만기연장 기간이 변경됨에 따라 해당 영업점으로 문의바랍니다.")
'			Grid0.SetCellData(szCellID, lRow, "0")
'			exit sub
'		end if
		
		if Grid0.GetCellData( "bd_check", lRow ) == "1" then
				
			sACNT_PWD = Form.GetCtlProp( "#EditPW1", "caption" )
			if Len(sACNT_PWD) == 0 then
				Form.MsgBox( "알림", "비밀번호를 입력하세요", "", 6 )
				Grid0.SetCellData( "bd_check", lRow,"0" )
				Exit Sub
			end if
			
			if RadioGroup0.currentindex = "0" then	'신청시
				'loan_issu_gr_code = DATAMANAGER.GetDataValue(0, "oblon_pros_814r", "OutBlock1", "LOAN_ISSU_TYPE_NAME", lRow)
				loan_issu_gr_code = Grid0.GetCellData("bd_loanissu", lRow)
				if Grid0.GetCellData( "bd_ecptyn", lRow ) = "Y" then
					Form.MsgBox( "알림", "해당 만기건은 90일에 한하여 대출집행된 건으로 만기연장이 불가합니다.", "", 6 )
					Grid0.SetCellData( "bd_check", lRow,"0" )
					Exit Sub
				elseif Left(Grid0.GetCellData( "bd_loancode", lRow ),2) = "02" then '예탁
				'V002
'					if cdbl(Grid0.GetCellData( "bd_aplydynu", lRow )) <= 100 then
'						Table0.SetCellString(1, 1, 180)
'					elseif cdbl(Grid0.GetCellData( "bd_aplydynu", lRow )) > 100 and cdbl(Grid0.GetCellData( "bd_aplydynu", lRow )) <= 200 then
'						Table0.SetCellString(1, 1, 270)
'					else
'						Table0.SetCellString(1, 1, 360)
'					end if
					
					if g_onln_mtrt_exts_ecpt_aply_yn = "Y" then
'						if cdbl(Grid0.GetCellData( "bd_aplydynu", lRow )) > 300 and cdbl(Grid0.GetCellData( "bd_aplydynu", lRow )) <= 400 then
'							Table0.SetCellString(1, 1, 450)
'						elseif cdbl(Grid0.GetCellData( "bd_aplydynu", lRow )) > 400 and cdbl(Grid0.GetCellData( "bd_aplydynu", lRow )) <= 500 then
'							Table0.SetCellString(1, 1, 540)
'						elseif cdbl(Grid0.GetCellData( "bd_aplydynu", lRow )) > 500 and cdbl(Grid0.GetCellData( "bd_aplydynu", lRow )) <= 600 then
'							Table0.SetCellString(1, 1, 630)
'						elseif cdbl(Grid0.GetCellData( "bd_aplydynu", lRow )) > 600 and cdbl(Grid0.GetCellData( "bd_aplydynu", lRow )) <= 720 then
'							Table0.SetCellString(1, 1, 720)
'						elseif cdbl(Grid0.GetCellData( "bd_aplydynu", lRow )) > 720 then
'							Form.MsgBox( "알림", "최장 만기일은 총 720일입니다.", "", 6 )
'							Grid0.SetCellData( "bd_check", lRow,"0" )
'							Exit Sub							
'						end if
						Table0.SetCellString(1, 1, Cdbl(g_loan_term)+90)
					else
						'A군이거나 B군이면 제한없음
						if RIGHT(loan_issu_gr_code, 1) <> "1" and RIGHT(loan_issu_gr_code, 1) <> "2" then
							if cdbl(Grid0.GetCellData( "bd_aplydynu", lRow )) > 360 then
								Form.MsgBox( "알림", "만기연장 신청 불가한 대출건입니다.", "", 6 )
								Grid0.SetCellData( "bd_check", lRow,"0" )
								Exit Sub
							else
								Table0.SetCellString(1, 1, Cdbl(g_loan_term)+90)
							end if
						else
							Table0.SetCellString(1, 1, Cdbl(g_loan_term)+90)
						end if
					end if
					
					g_intrt    = Grid0.GetCellData( "bd_afintrt", lRow )
					g_loan_qty = GetTonumber(Grid0.GetCellData( "bd_loanqty", lRow ))
					g_loan_amt = GetTonumber(Grid0.GetCellData( "bd_loanamt", lRow ))
			
					Table0.SetCellString(3, 1, g_intrt)	'변경이자율
					
					
				else '신용
					'V002
'					if cdbl(Grid0.GetCellData( "bd_aplydynu", lRow )) <= 100 then
'						Table0.SetCellString(1, 1, 150)
'					else
'						Form.MsgBox( "알림", "최장 만기일은 총 150일입니다.", "", 6 )
'						Grid0.SetCellData( "bd_check", lRow,"0" )
'						Exit Sub		
'					end if
					if g_onln_mtrt_exts_ecpt_aply_yn = "Y" then
						Table0.SetCellString(1, 1, Cdbl(g_loan_term)+90)
					
					else
						'A군이거나 B군이면 제한없음
						if RIGHT(loan_issu_gr_code, 1) <> "1" and RIGHT(loan_issu_gr_code, 1) <> "2" then
							if cdbl(Grid0.GetCellData( "bd_aplydynu", lRow )) > 360 then
								Form.MsgBox( "알림", "만기연장 신청 불가한 대출건입니다.", "", 6 )
								Grid0.SetCellData( "bd_check", lRow,"0" )
								Exit Sub
							else
								Table0.SetCellString(1, 1, Cdbl(g_loan_term)+90)
							end if
						else
							Table0.SetCellString(1, 1, Cdbl(g_loan_term)+90)
						end if
					end if
						
					
				end if
				
			else	'취소시
			
				Table0.SetCellString(2, 1, Grid0.GetCellData( "bd_mtrtdate", lRow ))
				ButtonOK.enable = true
				
			end if
			
			'단건 선택만 가능함
			for i = 0 to Grid0.rowcount-1
				if i <> lRow then
					Grid0.SetCellData( "bd_check", i, "0" )
					'Grid0.SetCellEnable("bd_check", i, false)
					
					Grid0.SetCellBgColor("bd_check"		, i, "38")	'셀 색상원복
					Grid0.SetCellBgColor("bd_isnm"		, i, "38")
					Grid0.SetCellBgColor("bd_loandate"	, i, "38")
					Grid0.SetCellBgColor("bd_aplydynu"	, i, "38")
					Grid0.SetCellBgColor("bd_loanamt"	, i, "38")
					Grid0.SetCellBgColor("bd_prhbreas"	, i, "38")
					Grid0.SetCellBgColor("bd_typename"	, i, "38")
					Grid0.SetCellBgColor("bd_mtrtdate"	, i, "38")
					Grid0.SetCellBgColor("bd_loanqty"	, i, "38")
					Grid0.SetCellBgColor("bd_intrt"		, i, "38")
					Grid0.SetCellBgColor("bd_loanissunm"	, i, "38")
				else
					Grid0.SetCellBgColor("bd_check"		, lRow, "44")	'셀 선택시 하이라이트색 사용
					Grid0.SetCellBgColor("bd_isnm"		, lRow, "44")
					Grid0.SetCellBgColor("bd_loandate"	, lRow, "44")
					Grid0.SetCellBgColor("bd_aplydynu"	, lRow, "44")
					Grid0.SetCellBgColor("bd_loanamt"	, lRow, "44")
					Grid0.SetCellBgColor("bd_prhbreas"	, lRow, "44")
					Grid0.SetCellBgColor("bd_typename"	, lRow, "44")			
					Grid0.SetCellBgColor("bd_mtrtdate"	, lRow, "44")
					Grid0.SetCellBgColor("bd_loanqty"	, lRow, "44")
					Grid0.SetCellBgColor("bd_intrt"		, lRow, "44")	
					Grid0.SetCellBgColor("bd_loanissunm"	, lRow, "44")
				end if	
			next
			
			if trim(Table0.GetCellString(1, 1)) <> "" then
			
				g_iscd 				= Grid0.GetCellData( "bd_iscd"    , lRow )
				g_loan_date 			= Grid0.GetCellData( "bd_loandate", lRow )
				g_loan_dtl_type_code 	= Grid0.GetCellData( "bd_loancode", lRow )
				g_loan_srno 			= Grid0.GetCellData( "bd_loansrno", lRow )
			
				DATAMANAGER.RequestTranData( "oblon_pros_010a" ) 
				
			end if	
		else
			Table0.SetCellString(0, 1, "")	'연장가능여부
			Table0.SetCellString(1, 1, "")	'연장대출일
			Table0.SetCellString(2, 1, "")	'변경만기일
			Table0.SetCellString(3, 1, "")	'변경이자율
			
			'단건 선택만 가능함
			for i = 0 to Grid0.rowcount-1
				'Grid0.SetCellData( "bd_check", i, "0" )
				Grid0.SetCellEnable("bd_check", i, true)
			next
			
			Grid0.SetCellBgColor("bd_check"		, lRow, "38")
			Grid0.SetCellBgColor("bd_isnm"		, lRow, "38")
			Grid0.SetCellBgColor("bd_loandate"	, lRow, "38")
			Grid0.SetCellBgColor("bd_aplydynu"	, lRow, "38")
			Grid0.SetCellBgColor("bd_loanamt"	, lRow, "38")
			Grid0.SetCellBgColor("bd_prhbreas"	, lRow, "38")
			Grid0.SetCellBgColor("bd_typename"	, lRow, "38")			
			Grid0.SetCellBgColor("bd_mtrtdate"	, lRow, "38")
			Grid0.SetCellBgColor("bd_loanqty"	, lRow, "38")
			Grid0.SetCellBgColor("bd_intrt"		, lRow, "38")	
			
			ButtonOK.enable = false
		end if
	end if
	
End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	if g_nNextFlag == "1" or g_nNextFlag == true then
		if RadioGroup0.currentindex = "0" then
			DATAMANAGER.RequestNextData( "oblon_pros_814r" ) '만기연장가능내역 조회
		else
			DATAMANAGER.RequestNextData( "oblon_mntn_814r" ) '만기연장취소가능내역 조회
		end if
	end if
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if GetPWCkeck() then
		Exit Sub
	end if
	
	Dim nCnt, nCheckCnt
	nCnt = GetTonumber(Grid0.rowcount)
	nCheckCnt = 0
	
	if nCnt > 0 then
		for i = 0 to nCnt-1
			if Grid0.GetCellData( "bd_check", i ) == "1" then
				nCheckCnt = nCheckCnt+1
			end if
		next
	end if
	
	if nCheckCnt == 0 then
		Form.MsgBox( "알림", "만기연장할 대출내역을 선택해주세요.", "", 6 )
		Exit Sub
	end if
	
'SMS인증 제외. 요건이 필요하면 mhetc90060_p8 이 화면에도 정의가 필요함.
