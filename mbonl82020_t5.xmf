'============================================================================
Sub Combo0_OnEditComplete(iIndex)

	'비밀번호없이 조회되도록 요청하여 주석처리 -> 16-03-22 전요셉과장님이 비밀번호 없으면 조회 하지 않게 요청
'	if GetPWCkeck() then
'		Exit Sub
'	end if
'
'	if Form.GetCtlProp( "#EditPW1", "caption" ) == "" then
'		Exit Sub
'	end if

	
	if iIndex = 0 then	'예탁
		Table0.rowcount = "4"
		Table0.height = 140
		
		Table0.top = 253
		Grid0.height = 217
		Grid0.SetCellTopCaption("th_cell7", "이자율")
	else					'신용
		'Table0.SetVisibleCol(3, 0)
		Table0.rowcount = "3"
		Table0.height = 105				
		
		Table0.top = 288 '253 + 35
		Grid0.height = 217 + 35
		Grid0.SetCellTopCaption("th_cell7", "")
	end if
	
	g_sPopupFlag = "Y"
	
	SetControlViewClear()	
		
	if RadioGroup0.currentindex = "0" then
		DATAMANAGER.RequestTranData( "oblon_mntn_950r" ) '체결반영 담보비율 조회
		'DATAMANAGER.RequestTranData( "oblon_pros_814r" ) '만기연장가능내역조회
	else
		DATAMANAGER.RequestTranData( "oblon_mntn_814r" )	'만기연장 취소가능내역 조회
	end if

End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)

	'비밀번호없이 조회되도록 요청하여 주석처리 -> 16-03-22 전요셉과장님이 비밀번호 없으면 조회 하지 않게 요청
'	if GetPWCkeck() then
'		Exit Sub
'	end if
'
'	if Form.GetCtlProp( "#EditPW1", "caption" ) == "" then
'		Exit Sub
'	end if
		
	SetControlViewClear()	
		
	if nIndex = 0 then
		ButtonOK.caption = "대출만기연장 신청"
		DATAMANAGER.RequestTranData( "oblon_mntn_950r" ) '체결반영 담보비율 조회
		'DATAMANAGER.RequestTranData( "oblon_pros_814r" ) '만기연장가능내역조회
	else
		ButtonOK.caption = "대출만기연장 취소"
		DATAMANAGER.RequestTranData( "oblon_mntn_814r" )	'만기연장 취소가능내역 조회
	end if
	
End Sub
