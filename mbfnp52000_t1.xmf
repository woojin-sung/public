'============================================================================
' InputCheck() : 가계산 조건 체크
'============================================================================
Function InputCheck()
	
'	if g_nTabIndex == 1 then
	
		if edtDay.caption == "" or edtDay.caption == Null then	
			Form.ShowAlert( "알림" , "투자기간를 입력해주세요.")
			Exit Function
		elseif edtMoney.caption = "" then
			Form.ShowAlert( "알림" , "투자금액을 입력해주세요.")
			Exit Function
		else
			btnCalcul.enable = true
		End if
	
'	else
'		Exit Function
'	End if

End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
	'최근 열었던 Tab 기억
'	g_nFlag = Form.LoadConfigData( "mbfnp52000_t1_Flag", "Flag" )
	
	edtDay.caption = "365"
	btnCalcul.enable = false
'	TableClean()
'	tab0.currenttab = g_nFlag
'	g_nTabIndex = g_nFlag
	
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
		
	g_szData = sParam
	g_nCodeIndex = 0
	
	if sEventName == "mbfnp52000" then
		If sParam = "" Or sParam = null Then
			Exit Sub
		End If
		
		g_szList = Split(g_szData , "★")
	end if
	
	if UBOUND(g_szList) < 1 then
		Exit sub
	End if
	
	g_szPW = Form.GetEncData( g_szList(2) )
	
'	nDayCount = 365
	if edtMoney.caption == "" or edtMoney.caption == Null then
		cmbDay.currentindex = 4
		edtDay.caption = "365"
		
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1")			'조회구분(1:투자일수로조회)
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "INVT_DYNU" , 0 , edtDay.caption )			'투자일수
		
		DATAMANAGER.RequestTranData( "obsan_deal_203r" )
		DATAMANAGER.RequestTranData( "obsan_deal_221r" )
		
		edtDay.enable = false
		cldDate.enable = false
		cmbDay.enable = false
	end if
	
'	DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1")			'조회구분(1:투자일수로조회)
'	DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "INVT_DYNU" , 0 , edtDay.caption )			'투자일수
'	
'	DATAMANAGER.RequestTranData( "obsan_deal_203r" )
'	DATAMANAGER.RequestTranData( "obsan_deal_221r" )
'	
'	edtDay.enable = false
'	cldDate.enable = false
'	cmbDay.enable = false
	
'	TableClean()
'	tab0_OnTabChanged( tab0.currenttab )
End Sub
'============================================================================
' cmbItem_OnEditComplete(iIndex) : 종목콤보
'============================================================================
Sub cmbItem_OnEditComplete(iIndex)

	g_nCodeIndex = iIndex
	
'	TableClean()
'	tab0_OnTabChanged( tab0.currenttab )
	
End Sub

'============================================================================
' edtMoney_OnEditComplete()	: 매수금액
'============================================================================
Sub edtMoney_OnEditComplete()
	
	if edtMoney.caption == "" then
	
	elseif CDbl(edtMoney.caption) < 1000000 then
		Form.ShowAlert( "알림", "매수금액을 확인하여 주십시오.")
		edtMoney.caption = ""
		Exit Sub
	elseif CDbl(edtMoney.caption) > CDbl(g_nOKMoney) then
		Form.ShowAlert( "알림", "매수가능 금액을 초과하였습니다.")
		edtMoney.caption = ""
		Exit Sub
	else
		cmbDay.enable = true
'		TableClean()
		InputCheck()
	end if

End Sub
'============================================================================
' btn0_OnClick() : 매수가능 버튼 클릭시
'============================================================================
Sub btn0_OnClick()
	Form.OpenPopup( "mbfnp52000_p1" , g_szData , sPosInfo)
End Sub
'============================================================================
' cmbDay_OnEditComplete(iIndex) : 투자기간 콤보
'============================================================================
Sub cmbDay_OnEditComplete(iIndex)

	if edtMoney.caption == "" or edtMoney.caption == Null then
		Exit Sub
	elseif iIndex <= 4 then
		edtDay.clearall = true
		edtDay.enable = false
		cldDate.enable = false
		
		Select Case iIndex
			Case 0
				nDayCount = 30	'1개월
			Case 1
				nDayCount = 60	'2개월
			Case 2
				nDayCount = 90	'3개월
			Case 3
				nDayCount = 180	'6개월
			Case 4
				nDayCount = 365	'1년
		End Select
		
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1")			'조회구분(1:투자일수로조회)
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "INVT_DYNU" , 0 , nDayCount )			'투자일수
		
		DATAMANAGER.RequestTranData( "obsan_deal_203r" )
		
'		TableClean()
		InputCheck()
	else
		edtDay.enable = true
		cldDate.enable = true
		edtDay.SetShowKeypad( true )
		
'		TableClean()
		InputCheck()
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nDate
	Dim nFeeBefore
	
	if szTranID == "obsan_deal_203r" then
		nDate = DATAMANAGER.GetDataValue( 0 , "obsan_deal_203r", "OutBlock1", "MTRT_DATE" , 0)
'		Form.ShowAlert("nDate", nDate)
		cldDate.caption = nDate
	elseif szTranID == "obsan_deal_213r" then
		nFeeBefore = DATAMANAGER.GetDataValue( 0 , "obsan_deal_213r", "OutBlock1", "INT_AMT" , 0) - 	'세후이자
		DATAMANAGER.GetDataValue( 0 , "obsan_deal_213r", "OutBlock1", "INTX" , 0) - 
		DATAMANAGER.GetDataValue( 0 , "obsan_deal_213r", "OutBlock1", "RSTX" , 0) - 
		DATAMANAGER.GetDataValue( 0 , "obsan_deal_213r", "OutBlock1", "SRTX" , 0)
		
		tab0.page000450.tbl2.SetCellString( 3 , 1 , nFeeBefore )
	elseif szTranID == "obsan_deal_215a" then
		Form.ShowAlert( "알림" , "매매처리가 완료되었습니다.")
	elseif szTranID == "obsan_deal_221r" then
		g_nOKMoney = DATAMANAGER.GetDataValue( 0 , "obsan_deal_221r", "OutBlock1", "DRNG_ABLE_AMT" , 0)
		
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obsan_deal_203r" then
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "ACNO" , 0 , g_szList(0) )			'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "ASNO" , 0 , g_szList(1) )			'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "ISCD" , 0 , g_szCode(g_nCodeIndex) )	'종목코드
	elseif szTranID == "obsan_deal_213r" then
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_213r", "InBlock1", "ACNO" , 0 , g_szList(0) )			'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_213r", "InBlock1", "ASNO" , 0 , g_szList(1) )			'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_213r", "InBlock1", "ISCD" , 0 , g_szCode(g_nCodeIndex) )	'종목코드
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_213r", "InBlock1", "INVT_DYNU" , 0 , edtDay.caption )		'투자일수
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_213r", "InBlock1", "INVT_AMT" , 0 , edtMoney.caption )	'매수금액(투자금액)
	elseif szTranID == "obsan_deal_221r" then
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_221r", "InBlock1", "ACNO" , 0 , g_szList(0) )			'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_221r", "InBlock1", "ASNO" , 0 , g_szList(1) )			'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_221r", "InBlock1", "PWD" , 0 , g_szPW )					'비밀번호
	end if
	
End Sub
'============================================================================
' edtDay_OnEditComplete() : 투자일자 수기 입력시
'============================================================================
Sub edtDay_OnEditComplete()
	
	if edtDay.caption == "" then
		Form.ShowAlert( "알림", "투자기간을 입력해 주세요.")
		Exit Sub
	elseif Int(edtDay.caption) < 1 then
		Form.ShowAlert( "알림", "입력기간은 1일 ~ 365일 입니다.")
		edtDay.caption = ""
		Exit Sub
	elseif Int(edtDay.caption) > 365 then
		Form.ShowAlert( "알림", "입력기간은 1일 ~ 365일 입니다.")
		edtDay.caption = ""
		Exit Sub
	elseif edtMoney.caption == "" or edtMoney.caption == Null then 
		Exit Sub
	else
		
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1")			'조회구분(1:투자일수로조회)
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "INVT_DYNU" , 0 , edtDay.caption )			'투자일수
		
		DATAMANAGER.RequestTranData( "obsan_deal_203r" )
	end if
	
'	TableClean()
	InputCheck()
	
End Sub
'============================================================================
' cldDate_OnEditComplete()
'============================================================================
Sub cldDate_OnEditComplete()
	
	
	if cldDate.caption <> "" then
		DATAMANAGER.ClearInputData( 0 , "obsan_deal_203r" )
		
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2")			'조회구분(2:만기일자로조회)
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "MTRT_DATE" , 0 , cldDate.caption )	'만기일자
		
		DATAMANAGER.RequestTranData( "obsan_deal_203r" )
	
	end if
	
End Sub
'============================================================================
' tab0_OnTabChanged(nCurrentTab)
'============================================================================

'============================================================================
' btnMaesu_OnClick()
'============================================================================
Sub btnMaesu_OnClick()
	Dim szData
	
	szData = cmbItem.caption & "★" & edtMoney.caption & "★" & edtDay.caption & "★" & cldDate.caption
	
	if g_szPW == "" or g_szPW == Null or Form.GetCtlProp("#edtPW", "caption") == "" then
		Form.ShowAlert( "알림", "비밀번호를 입력하세요")
		Exit Sub
	elseif edtMoney.caption == "" then
		Form.ShowAlert( "알림", "매수금액을 입력하세요")
		Exit Sub
	else
		Form.OpenPopup( "mbfnp52000_p2" , szData , sPosInfo)
	end if
	
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "Ok" then
		GoOrder()					
'		Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)
'	elseif sKeyName == "mhetc90060_p5" then					'공인인증후
'		if sRet ~= "cancel" then
'			'매수주문
'			Call GoOrder()
'		end if
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obsan_deal_215a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obsan_deal_215a" )
		Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")")
	elseif szTranID == "obsan_deal_203r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obsan_deal_203r" )
		Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")")
		cldDate.caption = cldToday.caption
	end if
	
End Sub

'============================================================================
Sub btnCalcul_OnClick()
	Dim szData
	
	'계좌번호, 일련번호, 종목코드Index, 투자일수, 매수금액(투자금액)
	szData = "mbfnp52000_t1" & "★" & g_szList(0) & "★" & g_szList(1) & "★" & g_nCodeIndex & "★" & edtDay.caption & "★" & edtMoney.caption
	
	Form.OpenPopup( "mbfnp52000_p7" , szData , sPosInfo)
	
End Sub

'============================================================================
Sub btnNotice_OnClick()
	Form.OpenFramePopup( "mbfnp52000_p6" , sOpenData , sPosInfo)
End Sub

