'============================================================================
' 01. 화 면 명 : 발행어음매매
' 02. 화면설명 : 발행어음매매
' 03. 작    성 : 2016. 02. 29. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szData
Dim g_szList					'Trigger에서 받아온 계좌번호, 일련번호, 비밀번호
Dim g_szPW					'비밀번호
Dim g_nCodeIndex				'종목콤보 Index
Dim g_szCode					'종목 코드
Dim nDayCount					'일수
Dim g_nTabIndex				'탭Index
Dim g_nFlag					'최근 열어본 탭 Index
DIm g_nOKMoney				'매수가능금액

g_szCode = {"NI70030" , "NI70040"}

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' GoOrder() : 매수주문
'============================================================================
Function GoOrder()
	
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_215a", "InBlock1", "ACNO" , 0 , g_szList(0) )				'계좌번호
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_215a", "InBlock1", "ASNO" , 0 , g_szList(1) )				'계좌일련번호
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_215a", "InBlock1", "PWD" , 0 , g_szPW )						'비밀번호
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_215a", "InBlock1", "ISCD" , 0 , g_szCode(g_nCodeIndex) )		'종목코드
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_215a", "InBlock1", "INVT_DYNU" , 0 , edtDay.caption )			'투자일수
	DATAMANAGER.SetDataValue( 0 ,"obsan_deal_215a", "InBlock1", "INVT_AMT" , 0 , edtMoney.caption )			'투자금액
	
	DATAMANAGER.RequestTranData( "obsan_deal_215a" )
	
End Function
