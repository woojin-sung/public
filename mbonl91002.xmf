'============================================================================
Sub Form_OnFormInitBefore()
	emp_num = Form.GetSharedData("&EMPL_NO", false ) '//////////////////SharedData 사번 받아옴  "16/9/27 윤형빈 수정"
	'emp_num = 5942
	
	DATAMANAGER.SetDataValue(0, "obcpp_cusr_026r", "InBlock1", "EMPNO", 0, emp_num)
	
	DATAMANAGER.RequestTranData("obcpp_cusr_026r")
	
	Label111.caption = emp_num
		
	cur_date = date
	Calendar1.caption = cur_date
	Edit1.enable = false	
	
	pro_date = 0
	total_num = 0
	real_num = 0
	total_pro_amt = 0
	each_pro_amt = 0
	pro_pur = ""
	pro_type = ""
	pro_content = ""
	aftr_rprn_reas = ""
	
End Sub

'============================================================================

Sub Button0_OnClick()
	if Calendar1.caption > Calendar0.caption and Edit1.caption = "" then
		Form.Toast(1, "제공일자보다 입력일자가 이후일때 사후보고사유를 입력필수.", 0)
		Edit1.enable = true
		exit sub
     elseif Calendar1.caption <= Calendar0.caption then
         Edit1.enable = false
         Edit1.caption = ""	    
	end if
	
	emp_num = Label111.caption
	emp_name = Label110.caption
	emp_part = Label112.caption
	emp_part_name = Label113.caption
	cur_date = date
	pro_date = Calendar0.caption
	total_num = Edit2.caption
	total_pro_amt = Edit3.caption
	real_num = Edit0.caption
	real_pro_amt = cdbl(total_pro_amt) / cdbl(total_num) * cdbl(real_num)
	pro_pur = Edit6.caption	
	pro_content = Edit8.caption
	pro_type = Combo0.caption
	aftr_rprn_reas = Edit1.caption
	
	if emp_num <> "" and pro_date <> "" and total_num <> "" and real_num <> "" and total_pro_amt <> "" and pro_pur <> "" and pro_type <> "" and pro_content <> "" then
		Form.SetSharedData("emp_num", emp_num      )
		Form.SetSharedData("emp_name", emp_name     )
		Form.SetSharedData("emp_part", emp_part     )
		Form.SetSharedData("emp_part_name", emp_part_name)
		Form.SetSharedData("cur_date", cur_date     )
		Form.SetSharedData("pro_date", pro_date     )
		Form.SetSharedData("total_num", total_num    )
		Form.SetSharedData("real_num", real_num   )
		Form.SetSharedData("total_pro_amt", total_pro_amt)
		Form.SetSharedData("real_pro_amt", real_pro_amt )
		Form.SetSharedData("pro_pur", pro_pur      )
		Form.SetSharedData("pro_type", pro_type     )
		Form.SetSharedData("pro_content", pro_content  )
		Form.SetSharedData("aftr_rprn_reas", aftr_rprn_reas  )
		
		Form.OpenPopup("mbonl91002_p1.xmf", "", "")
	else
		Form.Toast(1, "입력을 완료해주십시오.", 0)
	end if
	
End Sub

'============================================================================
Sub Edit0_OnEditComplete()
	if Edit3.caption <> "" and Edit2.caption <> "" then
		each_pro_amt = Cint(Edit3.caption) * Cint(Edit0.caption) / Cint(Edit2.caption)
		Label19.caption = Cint(each_pro_amt)
	
	end if
	
	if Edit2.caption == "" or Cint(Edit0.caption) > Cint(Edit2.caption) then
		Edit0.caption = ""
		Form.Toast(1, "잘못된 입력입니다.", 0)
		Label19.caption = ""
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	emp_name = DATAMANAGER.GetDataValue(0, "obcpp_cusr_026r", "OutBlock1", "FLNM", 0)
	emp_part = DATAMANAGER.GetDataValue(0, "obcpp_cusr_026r", "OutBlock1", "BLNG_DPCD", 0)	
	emp_part_name = DATAMANAGER.GetDataValue(0, "obcpp_cusr_026r", "OutBlock1", "DPNM", 0)		
	
	Label110.caption = emp_name
	Label112.caption = emp_part
	Label113.caption = emp_part_name
End Sub

'============================================================================


'============================================================================
Sub Button1_OnClick()
	Form.GetSharedData("emp_num", true      )
	Form.GetSharedData("emp_name", true     )
	Form.GetSharedData("emp_part", true     )
	Form.GetSharedData("emp_part_name", true)
	Form.GetSharedData("cur_date", true     )
	Form.GetSharedData("pro_date", true     )
	Form.GetSharedData("total_num", true    )
	Form.GetSharedData("real_num", true   )
	Form.GetSharedData("total_pro_amt", true)
	Form.GetSharedData("each_pro_amt", true )
	Form.GetSharedData("pro_pur", true      )
	Form.GetSharedData("pro_type", true     )
	Form.GetSharedData("pro_content", true  )
	Form.GetSharedData("aftr_rprn_reas", true  )
	
	Edit8.caption = ""
	Edit6.caption = ""
	Edit0.caption = ""
	Edit2.caption = ""
	Edit3.caption = ""
	Label19.caption = ""
	Label19.caption = ""
	Edit1.caption = ""
	
	
	
End Sub

'============================================================================
Sub Edit3_OnEditComplete()
	if Edit0.caption <> "" and Edit2.caption <> "" then
		each_pro_amt = Cint(Edit3.caption) * Cint(Edit0.caption) / Cint(Edit2.caption)
		Label19.caption = each_pro_amt
	end if
	
	if Edit2.caption == "" or Cint(Edit0.caption) > Cint(Edit2.caption) then
		Edit0.caption = ""
		Form.Toast(1, "잘못된 입력입니다.", 0)
		Label19.caption = ""
	end if
End Sub

'============================================================================
Sub Edit2_OnEditComplete()
	if Edit3.caption <> "" and Edit0.caption <> "" then
		each_pro_amt = Cint(Edit3.caption) * Cint(Edit0.caption) / Cint(Edit2.caption)
		Label19.caption = each_pro_amt
	end if
	
	if Edit2.caption == "" or Cint(Edit0.caption) > Cint(Edit2.caption) then
		Edit0.caption = ""
		Form.Toast(1, "잘못된 입력입니다.", 0)
		Label19.caption = ""
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()   
	
	if emp_num ="" then
		Label12.enable = True
		Label12.visible = True
		Edit8.caption = "허가된 임직원만 금품 제공 정보를 등록 할 수 있습니다."
		Form.Toast(1, "권한이 없습니다.", 0)

	else 
		Label12.enable = False	
		Label12.visible = False
			
	end if
	
	
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "All_finish" then
		Form.GetSharedData("emp_num", true      )
		Form.GetSharedData("emp_name", true     )
		Form.GetSharedData("emp_part", true     )
		Form.GetSharedData("emp_part_name", true)
		Form.GetSharedData("cur_date", true     )
		Form.GetSharedData("pro_date", true     )
		Form.GetSharedData("total_num", true    )
		Form.GetSharedData("real_num", true   )
		Form.GetSharedData("total_pro_amt", true)
		Form.GetSharedData("each_pro_amt", true )
		Form.GetSharedData("pro_pur", true      )
		Form.GetSharedData("pro_type", true     )
		Form.GetSharedData("pro_content", true  )
		
		Edit8.caption = ""
		Edit6.caption = ""
		Edit0.caption = ""
		Edit2.caption = ""
		Edit3.caption = ""
		Label19.caption = ""
		Label19.caption = ""
	end if
End Sub

'============================================================================
Sub Edit6_OnEditComplete()
     IF Calendar1.caption > Calendar0.caption THEN
	     Edit1.enable = true
	     
     END IF
	
End Sub
