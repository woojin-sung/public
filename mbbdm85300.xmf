	<CONTROL_INFO>
		<LINKFORM name="LinkForm0" ly_vert="0,60,375,587,1" />
		<IMAGE name="ImgBackPress" autosize="1" imgpath="icon_top_back_light" ly_vert="20,20,20,20,1" />
		<LABEL name="Label1" fontsize="4" fontstyle="01" caption="바이오인증 등록" halign="1" ly_vert="0,0,375,60,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="23909" _ulen="20953" >
'============================================================================
' 01. 화 면 명 : 바이오인증 서비스
' 02. 화면설명 : 바이오인인증 서비스 메인
' 03. 작    성 : 2021.02.27  HSZ
' 2024.01.19 : 전상일 : v0001 : obcsb_fido_002a ui_cust_cont_cls_code 추가 (별도 맵핑 x)
'============================================================================
'----------------------------------------------------------------------------
'바이오인증 flow
'----------------------------------------------------------------------------
'FIDO 1.0 등록요청 (지문&얼굴)
'   (Bio_401 -> Bui_402) -> obtss_fido_001a -> 앱버전체크 -> (Bio_103 -> Bio_104) -> obtss_fido_002a -> (Bio_105 -> Bio_106) -> obcsb_fido_002a

'FIDO 2.0 등록요청 (PIN)
'   (Bio_401 -> Bio_402) -> obtss_fido_011a -> (Bio_2103 -> Bio_2104) -> obtss_fido_012a -> obcsb_fido_002a

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_userID			'사용자 ID
Dim g_Ostype			'단말 OS 타입
Dim g_termID			'단말 ID
Dim g_type			'서비스 타입
Dim g_Csno			'고객번호
Dim g_Acno			'계좌번호
Dim g_deviceModel		'모델명
Dim g_gubun			'등록/해지 구분값
Dim g_complete
Dim g_sBIOAthnTchnCode	'인증기술코드
Dim g_sBioEnbl		'0.미지원 1.지원(지문가능) 2.지원(지문불가)
Dim g_sBioAppVersion	'설치된 연계앱 버전

Dim G_BIO_AGREE_FILE	'바이오인증약관동의화면
Dim g_nStepIndex
Dim g_sRevData 		'플로우 진행 구분값
Dim g_dnData

'----------------------------------------------------------------------------
Dim DEF_BIO_FINGER
'Dim DEF_BIO_FACE
Dim DEF_BIO_PIN

'g_sBIOAthnTchnCode에서 사용 (인증기술코드)
DEF_BIO_FINGER		= "100"	'지문/얼굴
DEF_BIO_PIN			= "116"	'PIN  

'----------------------------------------------------------------------------
Dim DEF_BIO_SVCD

DEF_BIO_SVCD			= "001"	'고정

'----------------------------------------------------------------------------
Dim tbl_001a(0)
Dim tbl_002a(0)
Dim tbl_008a(0)

Dim tbl_011a(0)
Dim tbl_013a(0)
Dim tbl_015a(0)

'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N") 
	g_userID = Form.GetSharedData("BDM_ELFN_ID", false)
	g_Acno 	=  Form.GetSharedData("NMET_ACNO", false)
	g_Ostype = Form.GetSharedData("&OS_TYPE", false )	'iOS("2") Android("1") 기타("9")
	g_termID = Form.getKftcBioDeviceID()				'단말FID획득
	g_deviceModel = Form.getDeviceModel()			'모델명
	g_sBioEnbl = Form.GetKftcBioDeviceEnbl()			'바이오인증 지원 여부 : 0.미지원 1.지원(지문가능) 2.지원(지문불가)
	
	'바이오인증 아이폰X대응 이미지변경
	s_OSTYPE = Form.GetSharedData("&OS_TYPE", false )	'iOS("2")Android("1")
	
	g_sGubunCode = ""
	g_nStepIndex = 0
	
	G_BIO_AGREE_FILE = "mbbdm85301"
	
	if g_sBioEnbl = "1" then
		if s_OSTYPE = "1" then
			LinkForm0.linkfile = "mbbdm85300_s1"
		elseif s_OSTYPE = "2" then
			LinkForm0.linkfile = "mbbdm85300_s2"
		end if
	elseif g_sBioEnbl = "2" then
		LinkForm0.linkfile = "mbbdm85300_s3"
	elseif g_sBioEnbl = "0" then
		if g_Ostype = "2" then
'			Form.MsgBox("바이오인증 안내", "스마트폰에 지문/얼굴정보가 등록되지 않았거나\n 바이오인증을 지원하지 않는 단말 또는 운영체제 버전입니다.", "", 0)
			szErrMsg = "스마트폰에 지문/얼굴정보가 등록되지 않았거나"
			sSubMsg = "바이오인증을 지원하지 않는 단말 또는 운영체제 버전입니다."
			Form.OpenPopup("mbbdm85303", szErrMsg & "★" & sSubMsg , "")
		else 
'			Form.MsgBox("바이오인증 안내", "바이오인증이 지원되지 않는 단말입니다.", "", 0 ) '안드로이드 4.4 이상가능
			szErrMsg = "바이오인증이 지원되지 않는 단말입니다."
			Form.OpenPopup("mbbdm85303", szErrMsg , "")
'			exit sub
		end if
	end if
	
End Sub

'============================================================================
' 단계별 화면변경
'============================================================================
Function SetControlChange()
	if g_nStepIndex = 0 then
		if g_sBioEnbl = "1" then
			if s_OSTYPE = "1" then
				LinkForm0.linkfile = "mbbdm85300_s1"
			elseif s_OSTYPE = "2" then
				LinkForm0.linkfile = "mbbdm85300_s2"
			end if
		elseif g_sBioEnbl == "2" then
			LinkForm0.linkfile = "mbbdm85300_s3"
		elseif g_sBioEnbl == "0" then
			if g_Ostype == "2" then
'				Form.MsgBox("바이오인증 안내", "스마트폰에 지문/얼굴정보가 등록되지 않았거나\n 바이오인증을 지원하지 않는 단말 또는 운영체제 버전입니다.", "", 0)
				szErrMsg = "스마트폰에 지문/얼굴정보가 등록되지 않았거나"
				sSubMsg = "바이오인증을 지원하지 않는 단말 또는 운영체제 버전입니다."
				Form.OpenPopup("mbbdm85303", szErrMsg & "★" & sSubMsg , "")
			else 
'				Form.MsgBox("바이오인증 안내", "바이오인증이 지원되지 않는 단말입니다.", "", 0 ) '안드로이드 4.4 이상가능
				szErrMsg = "바이오인증이 지원되지 않는 단말입니다."
				Form.OpenPopup("mbbdm85303", szErrMsg , "")
			end if
		end if
'		call Check_BioInstalled()
	elseif g_nStepIndex = 1 then
		LinkForm0.linkfile = G_BIO_AGREE_FILE 		'바이오인증 약관동의화면
	elseif g_nStepIndex = 2 then
'		call Check_BioInstalled()
		Form.requestKftcBio("Bio_401", "" , "90110") '단말정보 취득
	end if
End Function
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "NextStep" then
		if g_nStepIndex = 0 then
			g_nStepIndex = 1
			g_gubun = sParam
			if g_gubun = "register_finger" then
				g_sBIOAthnTchnCode = DEF_BIO_FINGER
			elseif g_gubun = "register_pin" then
				g_sBIOAthnTchnCode = DEF_BIO_PIN
			end if
			SetControlChange()
		elseif g_nStepIndex = 1 then
			g_nStepIndex = 2
			SetControlChange()
		end if
	elseif sEventName == "CloseForm" then
		Form.CloseForm()
	end if
		
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	if g_nStepIndex>0 then
		g_nStepIndex = g_nStepIndex-1
		SetControlChange()
	else
		'Form.MsgBox("바이오인증 안내", "바이오인증 등록을 중단하시겠습니까?", "", 0 ) 
		Form.OpenPopup("mbbdm85300_p1" , "" , "5")
	end if

End Sub
'============================================================================
Sub Form_OnFormBackKeyPressed()
	call ImgBackPress_OnClick()
End Sub
