				<IMAGE name="Image15" imgpath="img_bgcircle_navy.9.png" ly_vert="10,431,118,26,1" />
				<LABEL name="Label24" fgcolor="062:255255255" caption="유의사항" ly_vert="19,432,88,22,1" />
				<LABEL name="Label25" bgcolor="111:103103103" transmode="0" ly_vert="127,444,243,1,1" />
