				<TABLE name="tblStep8" insidelinecolor="102:255255255" colcount="1" rowcount="7" outline="0000" designorder="1" ly_vert="4,161,365,91,1" >
					<COL_INFO ly_vert_width="365" />
					<ROW_INFO ly_vert_height="13,13,13,13,13,13,13" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" halign="0" line="0,0" caption="· 본 Wrap 서비스는 고객님의 투자일임재산을 영업점의 운용전문가(지점운용역)" fontsize="-5" impidxs="" />
						<CELL cell_ly="0,1,0,1" halign="0" line="0,0" caption="   가 고객의 투자성향, 재무목적 등에 따라 투자판단에 대한 권한을 전부 일임" fontsize="-5" impidxs="" />
						<CELL cell_ly="0,2,0,2" halign="0" line="0,0" caption="   받아 운용 합니다." fontsize="-5" impidxs="" />
						<CELL cell_ly="0,3,0,3" halign="0" line="0,0" caption="· 파생상품 및 파생 ETF, ETN, 해외ETP 투자가 가능하고, 주식 위주의 적극적인" fontsize="-5" impidxs="" />
						<CELL cell_ly="0,4,0,4" halign="0" line="0,0" caption="   운용으로 수익을 추구합니다." fontsize="-5" impidxs="" />
						<CELL cell_ly="0,5,0,5" halign="0" line="0,0" caption="· 신용거래가 가능하며, 평가금액의 100% 범위내에서 한도를 정할 수 있습니다." fontsize="-5" impidxs="" />
						<CELL cell_ly="0,6,0,6" halign="0" line="0,0" fontsize="-5" impidxs="" />
					</CELL_INFO>
				</TABLE>
				<TABLE name="tblStep9" insidelinecolor="102:255255255" colcount="5" rowcount="5" outline="0000" designorder="1" ly_vert="0,320,374,100,1" >
					<COL_INFO ly_vert_width="53,94,57,97,73" />
					<ROW_INFO ly_vert_height="20,20,20,20,20" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" halign="0" line="0,0" caption="기본보수" fontsize="-5" impidxs="" />
						<CELL cell_ly="1,0,1,0" halign="0" line="0,0" caption="~1억 이하" fontsize="-5" impidxs="" />
						<CELL cell_ly="2,0,2,0" halign="0" line="0,0" caption=": 연 2.7%" fontsize="-5" impidxs="" />
						<CELL cell_ly="3,0,3,0" halign="0" line="0,0" caption=", 1억~5억 이하" fontsize="-5" impidxs="" />
						<CELL cell_ly="4,0,4,0" halign="0" line="0,0" caption=": 연 2.4%" fontsize="-5" impidxs="" />
						<CELL cell_ly="0,1,0,1" halign="0" line="0,0" fontsize="-5" impidxs="" />
						<CELL cell_ly="1,1,1,1" halign="0" line="0,0" caption="5억~20억 이하" fontsize="-5" impidxs="" />
						<CELL cell_ly="2,1,2,1" halign="0" line="0,0" caption=": 연 2.1%" fontsize="-5" impidxs="" />
						<CELL cell_ly="3,1,3,1" halign="0" line="0,0" caption=", 20억~50억 이하" fontsize="-5" impidxs="" />
						<CELL cell_ly="4,1,4,1" halign="0" line="0,0" caption=": 연 1.8%" fontsize="-5" impidxs="" />
						<CELL cell_ly="0,2,0,2" halign="0" line="0,0" fontsize="-5" impidxs="" />
						<CELL cell_ly="1,2,1,2" halign="0" line="0,0" caption="50억~100억 이하" fontsize="-5" impidxs="" />
						<CELL cell_ly="2,2,2,2" halign="0" line="0,0" caption=": 연 1.5%" fontsize="-5" impidxs="" />
						<CELL cell_ly="3,2,3,2" halign="0" line="0,0" caption=", 100억 초과~" fontsize="-5" impidxs="" />
						<CELL cell_ly="4,2,4,2" halign="0" line="0,0" caption=": 연 1.2%" fontsize="-5" impidxs="" />
						<CELL cell_ly="0,3,0,3" halign="0" line="0,0" caption="성과보수" fontsize="-5" impidxs="" />
						<CELL cell_ly="1,3,4,3" halign="0" line="0,0" caption="목표수익율 5~10%    : 초과분의 10%" fontsize="-5" impidxs="" />
						<CELL cell_ly="0,4,0,4" halign="0" line="0,0" fontsize="-5" impidxs="" />
						<CELL cell_ly="1,4,4,4" halign="0" line="0,0" caption="목표수익율 10% 초과 : 초과분의 20%" fontsize="-5" impidxs="" />
					</CELL_INFO>
				</TABLE>
			</CONTROL_INFO>
		</CONTAINER>
