						<CELL cell_ly="0,2,0,2" halign="0" line="0,0" caption="· 평가금액의 50% 이상을 업종 대표주로 구성하고, 10~20%를 유니버스내 알파 수" fontsize="-5" impidxs="" />
						<CELL cell_ly="0,3,0,3" halign="0" line="0,0" caption="   익을 추구하는 종목에 투자합니다." fontsize="-5" impidxs="" />
