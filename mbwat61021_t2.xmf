					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" halign="0" line="0,0" caption="· 본 Wrap 서비스는 당사와 자문계약을 맺은 이지스자산운용으로 부터 자문" fontsize="-5" impidxs="" />
						<CELL cell_ly="0,1,0,1" halign="0" line="0,0" caption="   서비스를 받아 일임 운용하는 상품입니다." fontsize="-5" impidxs="" />
						<CELL cell_ly="0,2,0,2" halign="0" line="0,0" caption="· 이지스자산운용은 포트폴리오 종목군의 추천 및 시황판단 등의 자문을 제공" fontsize="-5" impidxs="" />
						<CELL cell_ly="0,3,0,3" halign="0" line="0,0" caption="   하고 메리츠증권에서 최종 판단하여 운용하게 됩니다." fontsize="-5" impidxs="" />
