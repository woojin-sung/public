'	01. 화면명	: 다른클래스 펀드
'	02. 화면설명	: 펀드검색_다른클래스팝업
'	03. 작성		: 2017.11.13
'===========================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim szLinkedFundISCD
dim  g_szShortCd	'펀드코드
dim	g_szStndCd	'펀드풀코드			'펀드매매에 FULL CODE 필요
dim	g_szFndName	'펀드명
dim	g_szFudSaleTp	'펀드판매채널
dim splt_Sell_Fee '분리된 환매수수료
dim Sel_Fee_Print '보여지는 환매수수료
'============================================================================



'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

Sub Form_OnFormInit()
		
	Form.SetScreenName("다른클래스 펀드")
	szLinkedFundISCD = Form.GetOpenLinkData( )
	
	if szLinkedFundISCD = "" then
		Form.ShowAlert("알림", "입력값이 없습니다.")
	else
		DATAMANAGER.RequestTranData("obsim_idmn_037r")
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if	szTranID = 	"obsim_idmn_037r" then
		DATAMANAGER.SetDataValue(0, "obsim_idmn_037r" , "InBlock1" , "ISCD" , 0 , szLinkedFundISCD)
	end if
End Sub

'=============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szDataCnt
	
	if	szTranID =	"obsim_idmn_037r" then
		
		szDataCnt = DATAMANAGER.GetDataCount(0, "obsim_idmn_037r" , "OutBlock1")
		
		For i = 0  to szDataCnt - 1
			Sel_Fee_Print = ""
			
			szSell_Fee_Cnt = DATAMANAGER.GetDataValue(0, "obsim_idmn_037r" , "OutBlock1" , "QTY" , i)
			szSell_Fee = DATAMANAGER.GetDataValue(0, "obsim_idmn_037r" , "OutBlock1" , "RMRK_MATR" , i)
			
			'szpay_fee = DATAMANAGER.GetDataValue(0, "obsim_idmn_037r", "OutBlock1", "PAY_RATE", i)
			'temp = trim(cstr(szpay_fee))
			'msgbox temp & "%"
			
			
			splt_Sell_Fee =  Split(szSell_Fee,",")
			For j = 0 to szSell_Fee_Cnt - 1
				if j = szSell_Fee_Cnt - 1 then 
					Sel_Fee_Print = Sel_Fee_Print & splt_Sell_Fee[j]
				else 
					Sel_Fee_Print = Sel_Fee_Print & splt_Sell_Fee[j] & "\n"
				end if
			next
			
			Grid0.SetCellData("bd_cell2", i, Sel_Fee_Print)
			
		next
		
		
	
	end if
End Sub


'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)

	g_szShortCd = Grid0.GetCellData( "bd_cell5", lRow )
	g_szStndCd = Grid0.GetCellData( "bd_cell6", lRow )
	g_szFndName = Grid0.GetCellData( "bd_cell0", lRow )
	g_szFudSaleTp = Grid0.GetCellData( "bd_cell3", lRow )
	
	if g_szStndCd = "" or g_szStndCd = "0" then
		Form.ShowAlert("알림", "펀드상세 정보가 없습니다 - 협회표준코드")
		exit sub
	elseif g_szShortCd = "" then
		Form.ShowAlert("알림", "펀드상세 정보가 없습니다 - 펀드코드")
		exit sub
	elseif g_szFndName = "" then
		Form.ShowAlert("알림", "펀드상세 정보가 없습니다 - 펀드명")
		exit sub
	else
		Dim szSendData
		szSendData = g_szShortCd & "★" & g_szStndCd & "★" & g_szFudSaleTp
		
		Form.OpenPopup("mbfnp51000_p2" , szSendData , "")
'		Form.OpenFramePopup("mbfnp51000_p2" , g_szShortCd & "★" & g_szStndCd & "★" & g_szFndName & "★" & g_szFudSaleTp , sPosInfo)
	end if
End Sub

