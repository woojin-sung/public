	<SCRIPT_INFO _len="1416" _ulen="1350" >

Dim g_szAccNo
Dim g_szAccSrNo
Dim g_szCrCd

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	
	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")
	
		g_szAccNo = tData(0)
		g_szAccSrNo = tData(1)
		g_szCrCd = tData(2)
		
		DATAMANAGER.RequestTranData( "obacb_balc_138r" )
	
	else
		Exit Sub
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obacb_balc_138r" Then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , g_szAccNo)		'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , g_szAccSrNo)		'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" , 0 , "")			'계좌비밀번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CRCD" , 0 ,  g_szCrCd )		'통화코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , "" )					'해외주식시장거래구분코드
	End If
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

