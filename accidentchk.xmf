<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="9999" scrname="사고여부판단" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,301,366,1" />
	<CONTROL_INFO/>
	<SCRIPT_INFO _len="1213" _ulen="1175" >

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim ReturnData
	if szTranID == "obacp_opop_039r" then
		DATAMANAGER.GetDataValue( 0 , "obacp_opop_039r", "OutBlock6", "ACDN_YN" , 0)
					'사고여부가 Y = 출금고사고 , N = 정상
		ReturnData = DATAMANAGER.GetDataValue( 0 , "obacp_opop_039r", "OutBlock6", "ACDN_YN" , 0) & "★" &
			DATAMANAGER.GetDataValue( 0 , "obacp_opop_039r", "OutBlock6", "ACDN_TYPE_NAME" , 0)
				'사고유형명
				
		Form.SendReturnToParent( "ACCIDENT" , ReturnData)		
		Form.triggerEvent( "#", "ACCIDENT", ReturnData)
		Form.CloseForm()
	end if
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szData, szList
	
	if sEventName == "Chk" then
		szData = sParam

		szList = Split(szData, "★")
		
		if UBOUND(szList) < 1 then
			Exit Sub
		end if
		
		DATAMANAGER.SetDataValue( 0, "obacp_opop_039r", "InBlock1", "ACNO" , 0 , szList(0))
		DATAMANAGER.SetDataValue( 0, "obacp_opop_039r", "InBlock1", "ACNT_PWD" , 0 , szList(1))
		
		DATAMANAGER.RequestTranData( "obacp_opop_039r" )
	end if
	
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obacp_opop_039r" trcode="obacp_opop_039r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
