	<SCRIPT_INFO _len="20242" _ulen="18532" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 고객투자성향진단
' 02. 화면설명 : 투자권유희망여부확인서팝업
' 03. 작    성 : 2021.06.15	 김인택
' 04. 수    정 : 
' 2021.08.13 : 정민영 : v0001 : 5등급상품개설 투자권유불원확인서 추가
' 2021.09.10 : 김인택 : v0002 : 5등급상품개설 투자권유불원확인서 추가
' 2021.12.27 : 김수진 : v007 : K-OTC 거래신청 추가
' 2022.04.20 : 김성수 : v008 소수점 거래 추가
' 2023.02.23 : 김유경 : v009. 온라인 단기사채 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData 

dim	g_szAcno		'계좌번호
dim	g_szAsno		'계좌일련번호
dim	g_szBswr		'KYC업무분류코드(KYC_BSWR_DIV_COE)
dim	g_szDiv		'업무분류코드(BSWR_DIV_CODE)
dim	g_szISCD		'종목코드
dim	g_szAlertTitle	'알림타이틀
Dim g_szScrNo 	'호출한 화면번호

Dim g_szRetData 
Dim g_szKYC_INVT_RCMD_CLS_CODE  'KYC투자권유구분코드
Dim g_szKYC_INVT_INCL_GRAD_CODE 	'KYC투자성향등급코드
Dim g_szKYC_PROD_GRAD_CODE 		'KYC상품등급코드

Dim g_Prcd
Dim g_PrcdUnfitChk

g_szAlertTitle	=	"알림"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'============================================================================
'setItemSetting: 각 업무에 따라 입력값 세팅
'============================================================================
Function	setGlobalItems(szInput)


	g_szScrNo	=	getListItem(szInput, 0)
	g_szAcno	=	getListItem(szInput, 1)
	g_szAsno	=	getListItem(szInput, 2)
	g_szBswr	=	getListItem(szInput, 3)
	g_szDiv	=	getListItem(szInput, 4)
	g_szISCD	=	getListItem(szInput, 5)
	'v0001
	If g_szScrNo = "84010"	then
	    If Trim(g_szISCD) <> "" Then
			g_Prcd = Mid(g_szISCD,1,3)
			If Mid(g_szISCD,1,3) = "100" Or Mid(g_szISCD,1,3) = "10F" Then
				If Mid(g_szISCD,5,1) = "Y" Then 'v0002
					g_PrcdUnfitChk = "Y"   'v0002 종합매매_부적합
				End If
			End If
			g_szISCD = ""
	    End If
	End If

     g_szKYC_INVT_INCL_GRAD_CODE 	=	getListItem(szInput, 6)
	g_szKYC_PROD_GRAD_CODE 		=	getListItem(szInput, 7)
	g_szKYC_INVT_RCMD_CLS_CODE  	=   getListItem(szInput, 8)
	

End Function


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function



'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	g_sRetData = "CANCEL"
	szLinkedData = Form.GetOpenLinkData( )
	
	Form.SetScreenName("투자권유 희망여부 확인서")


	if szLinkedData = "" then
		Form.ShowAlert(g_szAlertTitle, "입력값이 없습니다.")
	else
		setGlobalItems(szLinkedData)
	end if 

	'신용계좌개설,	펀드매매,	ELS/DLS청약,   온라인계좌개설 (종합매매), 공모주청약-주식 v002
	'CME/EUREX 약정 추가 v003
	'해외주식, 해외파생ETF 약정 추가 v004
	'해외주식 소수점 약정 추가 v008
	'온라인 단기사채 추가 (88060) v009
	'해외(주식.ETP)거래 화면번호 변경 (87051 > 87057)
	if g_szScrNo == "82010" or	g_szScrNo == "51000" or g_szScrNo == "53000" or  g_szScrNo == "84010" or g_szScrNo == "83110" or g_szScrNo == "87040_t1" or g_szScrNo == "87040_t2" or g_szScrNo == "87050" or g_szScrNo == "87051" 
		or g_szScrNo == "87052_1" or g_szScrNo == "87052_2" or g_szScrNo == "87052_3" or g_szScrNo == "87052_4"  or g_szScrNo == "88060" or g_szScrNo == "87057_1" or g_szScrNo == "87057_2" or g_szScrNo == "87057_3"then 

		sName = Form.GetSharedData("&USER_NAME", false )
		
		Container0.tbl01.SetCellString( 1, 1, g_szAcno & g_szAsno)
		Container0.tbl01.SetCellString( 1, 4, sName )

		if	g_szScrNo	=	"82010"	then
			szProdName	=	"신용계좌개설"
		elseif	g_szScrNo	=	"51000"	then
			szProdName	=	"펀드매매"
		elseif	g_szScrNo	=	"53000"	then
			szProdName	=	"ELS/DLS청약"
		elseif	g_szScrNo	=	"84010"	then
		     'Form.ShowAlert("테스트", g_Prcd)
			'szProdName	=	"온라인계좌개설"   '종합매매계좌 개설 시 부적합 징구는 주식매매로 징구함 v002	
			'v0001 부적합징구용과 5등급상품개설 투자권유희망확인서 분리
			If g_PrcdUnfitChk = "Y" Then
				szProdName	= "주식 매매"   
				g_szDiv       = "13009"
			Else
				If g_Prcd = "100" Then
					szProdName	=	"종합매매 계좌"   
				ElseIf g_Prcd = "10F" Then
					szProdName	=	"종합매매(금융상품전용) 계좌"
				ElseIf g_Prcd = "118" Then
					szProdName	=	"CMA 계좌"   
				End If
			End If
		elseif   g_szScrNo	=	"83110"	then '공모주청약-주식 v002	
		     szProdName	=	"주식 매매"
		elseif   g_szScrNo	=	"87040_t1"	then 'CME 야간거래 v003	
		     szProdName	=	"CME 야간거래"
		elseif   g_szScrNo	=	"87040_t2"	then 'EUREX 야간거래 v003	
		     szProdName	=	"EUREX 야간거래"
		elseif   g_szScrNo	=	"87050"	then '해외파생ETF 약정 v004
		     szProdName	=	"해외ETP 거래"		
		elseif   g_szScrNo	=	"87051"	then '해외주식 약정 v004
		     szProdName	=	"해외주식 거래"
		     
		'2023.05.23  해외주식/ETP 거래신청----------------------------------
		elseif   g_szScrNo	=	"87057_1"	then '해외주식 약정 
		     szProdName	=	"해외주식 거래"
		     
		elseif   g_szScrNo	=	"87057_2"	then '해외주식, ETP약정
			g_szDiv = "17190"
			g_szDiv_1 = "17192"
		     szProdName	=	"해외주식 거래"
			Container0.tbl01.SetCellString( 27, 0, "상품명" )						
			Container0.tbl01.SetCellString( 27, 1, "해외주식 ETP 거래" )
			
		elseif   g_szScrNo	=	"87057_3"	then 'ETP 약정
			g_szDiv = "17192"		
		     szProdName	=	"해외주식 ETP 거래"		     
		'---------------------------------------------------------------------	
		'v008 소수점 거래 추가 START
		elseif   g_szScrNo	=	"87052_1"	then '해외주식 소수점 약정
			szProdName	=	"해외주식 소수점 거래"
		elseif   g_szScrNo	=	"87052_2"	then '해외주식 소수점, ETP 약정
			szProdName	=	"해외주식 소수점 거래"
			g_szDiv = "17192"
			g_szDiv_1 = "17213"
			Container0.tbl01.SetCellString( 27, 0, "상품명" )			
			Container0.tbl01.SetCellString( 27, 1, "해외주식 ETP 거래" )			

		elseif   g_szScrNo	=	"87052_3"	then '해외주식 거래, 해외주식 소수점, ETP 약정
			szProdName	=	"해외주식 소수점 거래"
			g_szDiv = "17190"
			g_szDiv_1 = "17192"
			g_szDiv_2 = "17213"
			
			Container0.tbl01.SetCellString( 27, 0, "상품명" )			
			Container0.tbl01.SetCellString( 28, 0, "상품명" )			
			
			Container0.tbl01.SetCellString( 27, 1, "해외주식 거래" )			
			Container0.tbl01.SetCellString( 28, 1, "해외주식 ETP 거래" )
		elseif   g_szScrNo	=	"87052_4"	then '해외주식 거래, 해외주식 소수점
			szProdName	=	"해외주식 소수점 거래"
			g_szDiv = "17190"
			g_szDiv_1 = "17213"
			
			Container0.tbl01.SetCellString( 27, 0, "상품명" )			
			Container0.tbl01.SetCellString( 27, 1, "해외주식 거래" )			
		'v008 소수점 거래 추가 END
		'v009. 온라인 단기사채
		elseif   g_szScrNo	=	"88060"	then
			szProdName	=	"단기사채 매매"
		else
			szProdName	=	" "
		end if
		
		Container0.tbl01.SetCellString( 26, 1, szProdName )			


	'ELW/ETF/ETN/ELS
	'v005 변동성ETN거래신청 약정 추가 (g_szScrNo="88021")
	'v007 K-OTC 거래신청 추가 (g_szScrNo="88050")
	elseif g_szScrNo == "88010" or	g_szScrNo == "88000" or g_szScrNo == "88020" or g_szScrNo == "53000" or g_szScrNo == "88021" or g_szScrNo == "88050" then 'ETN거래신청
		sName = Form.GetSharedData("&USER_NAME", false )
		
		Container0.tbl01.SetCellString( 1, 1, g_szAcno )
		Container0.tbl01.SetCellMaskInfo( 1, 1, "1,0,,,1,####-####,0,1,1" )
		Container0.tbl01.SetCellString( 1, 4, sName )

		if	g_szScrNo	=	"88010"	then
			szProdName	=	"ELW거래신청"
		elseif	g_szScrNo	=	"88000"	then
			szProdName	=	"파생상품ETF 거래신청"  'v006
		elseif	g_szScrNo	=	"88020"	then
			szProdName	=	"ETN거래신청"
		elseif	g_szScrNo	=	"53000"	then
			szProdName	=	"ELS/DLS청약"
		'v005 변동성ETN거래신청
		elseif	g_szScrNo	=	"88021"	then
			szProdName	=	"변동성ETN거래신청"	
		'v007 K-OTC 거래신청
		elseif	g_szScrNo	=	"88050"	then
			szProdName	=	"K-OTC 거래신청"	
		else
			szProdName	=	" "
		end if
		
		Container0.tbl01.SetCellString( 26, 1, szProdName )

	end if
End Sub


'============================================================================
'btnOK_OnClick
'============================================================================
Sub btnOK_OnClick()
	if Container0.ChkButton0.chksilence == "0"  then
		Form.MsgBox( g_szAlertTitle, "내용을 확인해 주세요.(투자권유 여부)", "", 6 )
		Exit Sub
	end if

	if Container0.ChkButton1.chksilence == "0" then
		Form.MsgBox( g_szAlertTitle, "내용을 확인해 주세요.(확인 체크)", "", 6 )
		Exit Sub
	end if
	
	DATAMANAGER.SetEventFlag( "obcsb_acif_830a", "I" )
	DATAMANAGER.RequestTranData( "obcsb_acif_830a" )
End Sub


'============================================================================
'btnCancel_OnClick
'============================================================================
Sub btnCancel_OnClick()
	g_sRetData	=	"CANCEL"
	Form.SendReturnToParent("mbonl81010_p10" , g_sRetData)

	Form.CloseForm()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_acif_830a" then
	     ' 84010 종합매매계좌개설 , 83110 주식공모주쳥약 은 부적합을 주식 매매로 처리함
		if	g_szScrNo == "84010" or g_szScrNo == "83110"	then 'v002 83110 주식공모주쳥약 화면 추가
		     DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "PROS_CLS_CODE" , 0 , "2"  ) 
		     DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0 , g_szKYC_INVT_RCMD_CLS_CODE  ) 
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0 , g_szKYC_INVT_INCL_GRAD_CODE )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "KYC_PROD_GRAD_CODE" , 0 , g_szKYC_PROD_GRAD_CODE )
			'v0001 DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , "04" ) 'v002
			'v0001 DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "BSWR_DIV_CODE" , 0 , "13009"  ) 'v002
			If g_szScrNo == "84010" Then
				'종합매매 부적합인경우,
				If g_PrcdUnfitChk = "Y" Then
					DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , "04" )
					DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "BSWR_DIV_CODE" , 0 , "13009"  )
					DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "PRCD" , 0 , "" )
				Else
					DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , "03" )
					'v0002
					If g_Prcd = "100" Then
						DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "BSWR_DIV_CODE" , 0 , "01004"  ) '종합매매개설
						DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "PRCD" , 0 , "100" )
					Elseif g_Prcd = "10F" Then
					    DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "BSWR_DIV_CODE" , 0 , "01052"  ) '금융상품전용계좌
						DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "PRCD" , 0 , "100" )
					Else
						DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "BSWR_DIV_CODE" , 0 , "01045"  )	'CMA-RP계좌개설
						DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "PRCD" , 0 , "118" )
					End If
				End If
			Else
				DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , "04" )
				DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "BSWR_DIV_CODE" , 0 , "13009"  )
				DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "PRCD" , 0 , "" )
			End If
			
			'v0001 DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "PRCD" , 0 , "" )                'v002
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "ACNO" , 0 , g_szAcno )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )		'온라인 :  4
		else
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "PROS_CLS_CODE" , 0 , "2"  ) 
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0 , g_szKYC_INVT_RCMD_CLS_CODE  )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0 , g_szKYC_INVT_INCL_GRAD_CODE )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "KYC_PROD_GRAD_CODE" , 0 , g_szKYC_PROD_GRAD_CODE )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , g_szBswr ) 
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "BSWR_DIV_CODE" , 0 , g_szDiv )
		
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "ACNO" , 0 , g_szAcno )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "ASNO" , 0 , g_szAsno )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "ISCD" , 0 , g_szISCD )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "PRCD" , 0 , "" )
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
			
		end	if
	'v008 소수점 거래 추가 START
	elseif szTranID == "obcsb_acif_840a" then
		dim nCnt
		if g_szScrNo == "87052_1" then '해외주식 소수점 약정
			nCnt = 1
		elseif g_szScrNo == "87052_2" then '해외주식 소수점 약정2
			nCnt = 2
		elseif g_szScrNo == "87052_3" then '해외주식 소수점 약정3
			nCnt = 3
		elseif g_szScrNo == "87052_4" then '해외주식 소수점 약정4
			nCnt = 2
		end if
		
		if nCnt > 1 then
			for i=0 to nCnt-1
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 			, i , "2"  						)
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_INVT_RCMD_CLS_CODE" 	, i , g_szKYC_INVT_RCMD_CLS_CODE  	)
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_INVT_INCL_GRAD_CODE" 	, i , g_szKYC_INVT_INCL_GRAD_CODE 	)
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_PROD_GRAD_CODE" 		, i , g_szKYC_PROD_GRAD_CODE 		)
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_BSWR_DIV_CODE" 		, i , g_szBswr 					) 
				if i == 0 then
					DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_DIV_CODE" , i , g_szDiv 		)
				elseif i == 1 then
					DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_DIV_CODE" , i , g_szDiv_1 	)
				elseif i == 2 then
					DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_DIV_CODE" , i , g_szDiv_2 	)
				end if
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , i , g_szAcno )
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , i , g_szAsno )
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" , i , g_szISCD )
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PRCD" , i , "" )
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE" , i, "4" )
			next
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 			, 0 , "2"  						) 
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_INVT_RCMD_CLS_CODE" 	, 0 , g_szKYC_INVT_RCMD_CLS_CODE  	)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_INVT_INCL_GRAD_CODE" 	, 0 , g_szKYC_INVT_INCL_GRAD_CODE 	)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_PROD_GRAD_CODE" 		, 0 , g_szKYC_PROD_GRAD_CODE 		)
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_BSWR_DIV_CODE" 		, 0 , g_szBswr 					) 
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_DIV_CODE" 			, 0 , g_szDiv 					)
		
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , g_szAcno )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , g_szAsno )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" , 0 , g_szISCD )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PRCD" , 0 , "" )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
		end if
	'v008 소수점 거래 추가 END
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acif_830a" then
		Dim sSUCS_YN, sCSNO, sSTND_DATE, sREG_SRNO
		sSUCS_YN = DATAMANAGER.GetDataValue( 0, "obcsb_acif_830a", "OutBlock1", "SUCS_YN" , 0 )
		sCSNO = DATAMANAGER.GetDataValue( 0, "obcsb_acif_830a", "OutBlock1", "CSNO" , 0 )
		sSTND_DATE = DATAMANAGER.GetDataValue( 0, "obcsb_acif_830a", "OutBlock1", "STND_DATE" , 0 )
		sREG_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_acif_830a", "OutBlock1", "REG_SRNO" , 0 )
		
		Form.SetSharedData("KYC_SUCS_YN", sSUCS_YN)
		Form.SetSharedData("KYC_CSNO",sCSNO)
		Form.SetSharedData("KYC_STND_DATE", sSTND_DATE)
		Form.SetSharedData("KYC_REG_SRNO",sREG_SRNO)
		
		g_sRetData = "OK"
		Form.CloseForm()
		
	'v008 소수점 거래 추가 START
	elseif szTranID == "obcsb_acif_840a" then
		dim nDataCnt
		nDataCnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
		if nDataCnt > 0 then
			Dim sSUCS_YN, sCSNO, sSTND_DATE, sREG_SRNO
			for i=0 to nDataCnt-1
				sSUCS_YN 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SUCS_YN" 	, i )
				sCSNO 		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CSNO" 		, i )
				sSTND_DATE 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "STND_DATE" 	, i )
				sREG_SRNO 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "REG_SRNO" 	, i )
				
				Form.SetSharedData("KYC_SUCS_YN_"&i+1, sSUCS_YN)
				Form.SetSharedData("KYC_CSNO_"&i+1,sCSNO)
				Form.SetSharedData("KYC_STND_DATE_"&i+1, sSTND_DATE)
				Form.SetSharedData("KYC_REG_SRNO_"&i+1,sREG_SRNO)
			next
			g_sRetData = "OK"
		end if
		
		Form.CloseForm()
	'v008 소수점 거래 추가 END
	end if
End Sub


'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	if	g_sRetData		<>	"OK"		then
		g_sRetData	=	"CANCEL"
		
		Form.SetSharedData("KYC_ACNO" , null)
		Form.SetSharedData("KYC_INVT_INCL_GRAD_CODE" , null)
		Form.SetSharedData("KYC_PROD_GRAD_CODE" , null)
		Form.SetSharedData("KYC_DVPD_EPMD_CODE" , null)
		Form.SetSharedData("KYC_DRVT_PROS_YN" , null)
		Form.SetSharedData("KYC_DVPD_GRAD_CODE" , null)
		
		Form.SendReturnToParent("mbonl81010_p10" , g_sRetData)
	else
		Form.SendReturnToParent("mbonl81010_p10" , g_sRetData)
	end if
End Sub



'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
End Sub
