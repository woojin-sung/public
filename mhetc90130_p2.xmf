		<BUTTON name="ButtonOK" caption="확인" fgcolor="128:188030030" btnimage="btn_pop2.9.png" ly_vert="187,562,188,45,1" />
		<BUTTON name="ButtonWideCancel" visible="0" caption="닫기" fgcolor="004:000000000" btnimage="btn_pop1.9.png" ly_vert="-10,562,400,45,0" />
