'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 바이오인증
' 02. 화면설명 : 바이오인증 - 신규등록
' 03. 작    성 : 2016.11.11 함원규
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim G_BC_CONFIRM_FILE 			'공동인증 본인확인화면 (mhetc90130_s1)
Dim G_BC_AGREE_FILE 			'공동인증 약관동의화면 (mhetc90130_s2)

Dim G_BC_ADD_FILE 			'추가인증풀팝업
Dim G_BC_SECURITY_FILE 		'보안카드풀팝업
Dim G_BC_QUESTION_FILE 		'부가정보풀팝업
Dim G_BC_OTP_FILE 			'일반/스마트OTP풀팝업
Dim G_BC_OCSP_FILE			'공인인증서 검증 팝업

Dim g_nStepIndex 
Dim g_sRevData 				'플로우 진행 구분값
Dim g_sGubunCode 				'보안매체구분코드



'============================================================================
'블록체인 공동인증
'============================================================================

Dim g_sStage020
Dim g_sStage021
Dim g_dnData 

Dim g_sKofiaDN
Dim g_sKofiaAlias
Dim g_sKofiaAliasList

g_sKofiaDN = ""
g_sKofiaAlias = ""
g_sKofiaAliasList		= ""

g_sStage020			= ""
g_sStage021			= ""

'============================================================================
' 단계별 화면변경
'============================================================================
Function SetControlChange()
	
	'============================================================================
	' 공동인증 등록
	'============================================================================
	if g_sRevData == "bc_new" then
	
		if g_nStepIndex == 0 then
			LinkForm0.linkfile = G_BC_CONFIRM_FILE 	'바이오인증 본인확인화면
		elseif g_nStepIndex == 1 then
			LinkForm0.linkfile = G_BC_AGREE_FILE		'바이오인증 약관동의화면		
		else
			LinkForm0.linkfile = ""
		end if
		
	
	'============================================================================
	' 공동인증 관리
	'============================================================================
	
	'단말에 인증서 미 존재시 -> 본인확인 후 -> 등록단말내역 리스트를 보여줌
	elseif g_sRevData == "bc_mod" then
	    
	    if g_nStepIndex == 0 then
		    LinkForm0.linkfile = G_BC_CONFIRM_FILE	'공동인증 관리 본인확인 화면
		    ButtonWideCancel.visible = false
		    ButtonCancel.visible = true
		    ButtonOK.visible = true
		    
'	    elseif g_nStepIndex == 1 then
	    
'		    Form.OpenFramePopup( G_BC_ADD_FILE , g_sRevData , "" )	 
'		    LinkForm0.linkfile = G_BC_ADD_FILE
'		    ButtonWideCancel.visible = false
'		    ButtonCancel.visible = true
'		    ButtonOK.visible = true
			    
	    elseif g_nStepIndex == 1 then'2 then
	    
		    '등록단말내역 화면 전환 전 현재단말의 Alias와 DN값을 얻어옴
		    Form.requestKofiaAuth("BCHAIN_103", "", "MOD")
		    	    
		    'LinkForm0.linkfile = G_BC_REGLIST_FILE	'공동인증 등록단말내역
		    ButtonWideCancel.visible = true
		    ButtonCancel.visible = false
		    ButtonOK.visible = false
	    end if
	    
	'단말에 인증서 존재시 -> 공동앱에서 인증 후(등록 메인화면에서 공동앱 호출) -> 등록단말내역 리스트 보여줌
	elseif g_sRevData == "bc_mod_complete" then
		
		LinkForm0.linkfile = G_BC_REGLIST_FILE
		ButtonWideCancel.visible = true
		ButtonCancel.visible = false
		ButtonOK.visible = false
		
	elseif g_sRevData == "bc_login" then
		
		if g_nStepIndex == 0 then
			LinkForm0.linkfile = G_BC_CONFIRM_FILE	'공동인증 관리 본인확인 화면
			ButtonWideCancel.visible = false
			ButtonCancel.visible = true
			ButtonOK.visible = true
			
		elseif g_nStepIndex == 1 then
		
			LinkForm0.linkfile = G_BC_AGREE_FILE		'바이오인증 약관동의화면
			ButtonWideCancel.visible = false
			ButtonCancel.visible = true
			ButtonOK.visible = true
		
		
		end if
	    
	end if
	
	Form.triggerEvent( "LinkForm0", "TabChange", g_sRevData ) 	'링크폼화면에 flow 구분코드 전달 (bc_new / bc_mod / bc_cancel)
	
End Function

'============================================================================
' 보안매체별 화면오픈
'============================================================================
Function SetSecurityOpen()
	
	'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
	
	if g_sGubunCode == "0" then '보안카드
		Form.OpenFramePopup( G_BC_SECURITY_FILE , "" , "" )	'보안카드풀팝업
		
	elseif g_sGubunCode == "1" then '부가정보
		Form.OpenFramePopup( G_BC_QUESTION_FILE , "" , "" )	'부가정보풀팝업
		
	elseif g_sGubunCode == "3" then 'OTP
		Form.OpenFramePopup( G_BC_OTP_FILE , "" , "" )		'일반/스마트OTP풀팝업
		
	elseif g_sGubunCode == "2" then '없을경우
		Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
		
	else '에러
		Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		
	end if
	
End Function

'============================================================================
Sub Form_OnFormInit()
	
	G_BC_CONFIRM_FILE 		= "mhetc90130_s1"		'공동인증 본인확인화면
	G_BC_AGREE_FILE			= "mhetc90130_s2"		'공동인증 약관동의화면
	G_BC_REGLIST_FILE			= "mhetc90130_s3"		'공동인증 등록단말내역
	
	G_BC_ADD_FILE 			= "mhetc90060_p11"	'추가인증풀팝업
	G_BC_SECURITY_FILE 		= "mhetc90060_p9"		'보안카드풀팝업
	G_BC_QUESTION_FILE		= "mhetc90060_pa"		'부가정보풀팝업
	G_BC_OTP_FILE 			= "mhetc90060_pb"		'일반/스마트OTP풀팝업
	G_BC_OCSP_FILE			= "mhetc90060_p5"		'공인인증서 검증 팝업
	
	g_sGubunCode = ""
	g_nStepIndex = 0
	
	g_sRevData = Form.GetOpenLinkData() '공동인증 메인화면서 flow 구분값 전달받음 (bc_new / bc_mod / bc_cancel)
	
	
	if g_sRevData == null or g_sRevData == "" then
		g_sRevData = "bc_new" '디폴트는 bc_new(등록)
	end if
	
	SetControlChange()
	
End Sub

'===========================================================================================================
' 팝업에서는 공동인증 함수에 대한 응답을 정상적으로 수신받지 못해 공동인증 함수 호출은 등록 메인화면에서 함
'============================================================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	'=======================================================================================================
	' 확인or다음 클릭 시 다음화면으로 이동
	'=======================================================================================================
	if sEventName == "NextStep" then
	
		'공동인증 등록
		if g_sRevData == "bc_new"  then
		
			if g_nStepIndex == 0 then
				
				'본인확인 완료 -> 약간동의화면으로 이동				
				g_nStepIndex = 1
				SetControlChange()
			
			elseif g_nStepIndex == 1 then
			
				'약간동의 완료 -> 추가/보안매체 인증 시작
				'온라인 신원확인 동의 조회
				DATAMANAGER.RequestTranData("obcsb_padc_004r")
					    
			end if
			
		'단말에 인증서 미 존재시 인증관리인 경우(본인확인을 거친 후 등록단말내역 화면 호출)
		elseif g_sRevData == "bc_mod" then
			
			'본인확인 완료 -> 등록단말내역 화면으로 이동
			if g_nStepIndex == 0 then
				g_nStepIndex = 1
				SetControlChange()
'			elseif g_nStepIndex == 1 then
'				g_nStepIndex = 2
'				SetControlChange()
			
			end if
			
		
		elseif g_sRevData == "bc_login" then
		
			if g_nStepIndex == 0 then
				
				'본인확인 완료 -> 약간동의화면으로 이동				
				g_nStepIndex = 1
				SetControlChange()
			end if
		
			
			
		
		
		end if
	
	'======================================================================================================
	' 이전or취소 버튼 클릭시 전단계로 돌아가거나 취소
	'======================================================================================================
	elseif sEventName == "BeforeStep" then
		
		if g_nStepIndex > 0 then
			g_nStepIndex = g_nStepIndex-1
			SetControlChange()
		end if
		
	'======================================================================================================
	' 공동인증 해지
	'======================================================================================================
	elseif sEventName == "bc_unregister" then
		
		'sParam = 해지단말DN ★ 해지단말Alias
		tmp = Split(sParam,"★") 
		
		g_sKofiaAlias = tmp(0)
		g_sKofiaDN = tmp(1)
		
		'-----------------------------------------------------
		'[공동인증서] 해지
		'-----------------------------------------------------
		'해지서비스 정상처리 후 공동앱에 인증서 삭제요청
	
		'g_sKofiaAlias 	: 해지대상 인증서Alias
		'g_sKofiaDN 		: 해지대상 인증서DN
	
		if  g_sKofiaDN == "" or g_sKofiaAlias == "" then
			Form.MsgBox( "알림", "인증센터 로그인후 가능합니다.", "", 0 )
			exit sub
		end if
	
		'20171103 LES 처리구분값 수정( C -> M)
		'인증서해지요청
		Request_obcsb_padc_020a("M", "3", g_sKofiaAlias & "★" & g_sKofiaDN)
		
		
	
	elseif sEventName == "bc_unregister_complete" then
	   
		Form.triggerEvent("LinkForm0", "bc_unregister_complete", sParam)
		
		
	'=========================================================================	
	' 비밀번호 변경
	'=========================================================================
	elseif sEventName == "bc_change" then
	
		'sParam = 해지단말DN ★ 해지단말Alias
		tmp = Split(sParam,"★") 
		
		g_sKofiaAlias = tmp(0)
		g_sKofiaDN = tmp(1)
		
		'-----------------------------------------------------
		'[공동인증서] 비밀번호변경
		'-----------------------------------------------------	
		'g_sKofiaAlias	: 변경대상 인증서Alias
		'g_sKofiaDN 		: 변경대상 인증서DN
	
		if  g_sKofiaDN == "" or g_sKofiaAlias == "" then
			Form.MsgBox( "알림", "인증센터 로그인후 가능합니다.", "", 0 )
			exit sub
		end if
	
		'비밀번호변경요청
		Form.requestKofiaAuth("BCHAIN_108", g_sKofiaAlias & "★" & g_sKofiaDN, "MOD")
		
	
	
	elseif sEventName == "bc_change_complete" then
	
		Form.triggerEvent("LinkForm0", "bc_change_complete", sParam)
	
	'=========================================================================
	' 갱신
	'=========================================================================
	
	elseif sEventName == "bc_renewal" then
	
		'sParam = 해지단말DN ★ 해지단말Alias
		tmp = Split(sParam,"★") 
		
		g_sKofiaAlias = tmp(0)
		g_sKofiaDN = tmp(1)
		
		'-----------------------------------------------------
		'[공동인증서] 갱신
		'-----------------------------------------------------		
		'g_sKofiaAlias 	: 갱신대상 인증서Alias
		'g_sKofiaDN 		: 갱신대상 인증서DN
	
		if  g_sKofiaDN == "" or g_sKofiaAlias == "" then
			Form.MsgBox( "알림", "인증센터 로그인후 가능합니다.", "", 0 )
			exit sub
		end if
	
		'인증서갱신요청
		Form.requestKofiaAuth("BCHAIN_105", g_sKofiaAlias & "★" & g_sKofiaDN, "MOD")
		
	
	elseif sEventName == "bc_renewal_complete" then
		
		Form.triggerEvent("LinkForm0", "bc_renewal_complete", sParam)
	
	
	end if
	
End Sub

'===========================================================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == G_BC_ADD_FILE then
		
		if g_sRevData == "bc_new" then
			
			if sRet == "ok" then
				DATAMANAGER.RequestTranData( "obcsb_oimf_625r" ) 
			else
				g_sGubunCode = ""
			end if
		
		elseif g_sRevData == "bc_mod" then
		
			g_nStepIndex = 2
			SetControlChange()
		
			
		
		end if
	
	'추가인증/보안매체 인증결과 수신 -> ok시 OCSP검증화면 호출
	elseif sKeyName == G_BC_SECURITY_FILE or sKeyName == G_BC_QUESTION_FILE or sKeyName == G_BC_OTP_FILE then
		'Form.ShowAlert(sRet, g_sRevData)
		if sRet == "ok" then
			if g_sRevData == "bc_new" Then
				'sSendData =g_sRevData&"★"& Form.GetSharedData("CERT_ID" , false) &"★"&g_dnData
				sSendData = sRet&"★"&Form.GetSharedData("CERT_ID" , false)'&"★"&Form.GetSharedData("CERT_ACNO" , false)
				Form.SendReturnToParent( "bc_register" , sSendData)
				Form.CloseForm( )
				'Form.OpenFramePopup( G_BC_OCSP_FILE,  sSendData, "")'공인인증서 비번확인 삭제 20170906
			end if
		end if
	
	'OCSP검증결과 수신
	'공인인증서 비번확인 삭제 20170906
	elseif sKeyName == G_BC_OCSP_FILE then
		
		if g_sRevData == "bc_new" Then
			
			sSendData = sRet&"★"&Form.GetSharedData("CERT_ID" , false)'&"★"&Form.GetSharedData("CERT_ACNO" , false)
			
			'공동인증 메인화면으로 데이터 넘김. 등록 -> bc_register / 사용자 아이디
			Form.SendReturnToParent( "bc_register" , sSendData)
			Form.CloseForm( )
			
		end if
		
		
	elseif sKeyName == G_BC_AGREE_FILE then
	
		if g_sRevData == "bc_login" then
		
			Form.SendReturnToParent( G_BC_AGREE_FILE , "ok")
		end if

	end if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REG_MSG" then
		if sRet == "ok" then
			Form.OpenScreen( "86010" , "" ) '단말등록화면이동
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sDeviceID, sACNO, sACNO_PWD, sUserID, sRCNO, sUserName
	
	sDeviceID = Form.GetDeviceID()
	sACNO = Form.GetSharedData("CERT_ACNO" , false)
	sACNO_PWD = Form.GetSharedData("CERT_ACNT_PWD" , false)
	sUserID = Form.GetSharedData("CERT_ID" , false)
	sUserName = Form.GetSharedData("CERT_USER_NAME" , false)
	sRCNO = Form.GetSharedData("CERT_RCNO" , false)
	
	if szTranID == "obcsb_oimf_625r" then	
		DATAMANAGER.SetUserID( sUserID ) '20160620 KBC 추가 : 발급(170a)와 동일하게 등록도 헤더에 값 지정해준다.
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
			
	elseif szTranID == "obcsb_oimf_638r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID() )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "000" ) '인증서신규


	elseif szTranID == "obcsb_padc_004r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_padc_004r", "InBlock1", "ELFN_ID" , 0 , sUserID )		'ID

	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_625r" then
		
		Dim sSPLM_ATHN_NCSR_YN 
		
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
         SetSecurityOpen()
		
	elseif szTranID == "obcsb_oimf_638r" then	'단말기 지정여부 팝업 오픈
		if DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r", "OutBlock1", "UI_SPLM_YN" , 0) == "Y" then
			Dim sText
			sText = "고객님께서는 [단말기지정]서비스 고객이므로 지정단말에서만 공인인증서 발급/재발급이 가능합니다.\n"..
					"단말기를 등록하시겠습니까?"
			Form.MsgBox( "알림", sText, "REG_MSG", 1 )
		else
		     sTemp = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r", "OutBlock1", "SPLM_ATHN_STPL_YN" , 0)
		        
			if sTemp == "Y" then	
				'추가인증 팝업 호출(SMS인증 등...)
			  	Form.OpenFramePopup( G_BC_ADD_FILE , g_sRevData , "" )	 
			else
			  	DATAMANAGER.RequestTranData( "obcsb_oimf_625r" ) '추가인증대상조회
			end if
		end if


	elseif szTranID == "obcsb_padc_004r" Then
		
		g_dnData =  DATAMANAGER.GetDataValue(0, "obcsb_padc_004r" , "OutBlock1" , "DN_DATA" , 0)
		
		'OCSP 검증에 필요한 고객번호 Shared
		Form.SetSharedData("BC_CSNO" , DATAMANAGER.GetDataValue(0, "obcsb_padc_004r", "OutBlock1", "CSNO" , 0))
		
		
		if g_dnData == null or g_dnData == "" then
		    sText = "공인인증서 정보가 존재하지 않습니다.\n".."공인인증서 정보를 확인해주세요"
			Form.MsgBox( "알림", sText, "REG_MSG", 1 )
			sSendData = "cancel"
			Form.SendReturnToParent( "bc_vft" , sSendData)
			Form.CloseForm( )
         else
			DATAMANAGER.RequestTranData( "obcsb_oimf_638r" ) '추가인증대상,단말기지정약정조회
		end if
		
	elseif szTranID == "obcsb_padc_020a" then
		
		
		ERR_NO 				= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "ERR_NO" 				,0) '에러번호
		ERR_INFO 			= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "ERR_INFO" 			,0) '에러정보
		RSLT_INFO  			= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "RSLT_INFO" 			,0) '결과정보
		DN_DATA   			= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "DN_DATA" 				,0) 'DN데이터
		UNIN_NTAT_SNTN		= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "UNIN_NTAT_SNTN" 		,0) '공동인증서문장
		DN_BYNM				= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "DN_BYNM" 				,0) 'DN별칭
		UNIN_NTAT_STAT_CNTT 	= DATAMANAGER.GetDataValue( 0,szTranID, "OutBlock1", "UNIN_NTAT_STAT_CNTT" 	,0) '공동인증서상태내용
		
		'=======================================================================================
		'20171103 LES START
		if CInt(ERR_NO) == 0 then '정상
		
			'인증서갱신요청응답
			if g_sStage020 = "R1" then
		
				Form.requestKofiaAuth("BCHAIN_102", DN_BYNM & "★" & UNIN_NTAT_SNTN, "MOD")
		
			'20171103 LES 처리구분값 수정( C -> M)
			'--------------------------------------------------------------------------
			'인증서상태변경요청(VALID)
			'--------------------------------------------------------------------------
			elseif g_sStage020 = "M1" then
		
				Form.triggerEvent("LinkForm0", "bc_renewal_complete", "ok")
			
			'--------------------------------------------------------------------------
			'인증서상태변경요청(SUSPENSION)
			'--------------------------------------------------------------------------
			elseif g_sStage020 = "M2" then
		
				Form.MsgBox( "알림", "공동인증서가 비밀번호 오류횟수 초과(5회)로 정지되었습니다. 재등록이 필요합니다.", "", 0 )
				Form.triggerEvent("LinkForm0", "bc_suspension_complete", "ok")
			
			'------------------------------------------------------------------------
			'인증서해지요청(REVOKE)
			'-------------------------------------------------------------------------
			elseif g_sStage020 = "M3" then
			
				'params => Alias★Dn
				Form.requestKofiaAuth("BCHAIN_104", DN_BYNM & "★" & DN_DATA, "MOD")
		
			'-------------------------------------------------------------------------
			' DN조회
			'-------------------------------------------------------------------------
			elseif g_sStage020 = "N1" then
			
				Form.SetSharedData("BCHAIN_DN_DATA" , DN_DATA)
				LinkForm0.linkfile = G_BC_REGLIST_FILE			'공동인증 등록단말내역
					
			end if
		
		'=======================================================================================
		elseif CInt(ERR_NO) == 1002 then '비밀번호 5회 초과 시
		
			if g_sStage020 = "M2" then
				Form.MsgBox( "알림", "공동인증서가 비밀번호 오류횟수 초과(5회)로 정지되었습니다. 재등록이 필요합니다.", "", 0 )
				Form.triggerEvent("LinkForm0", "bc_suspension_complete", "ok")
			end if
			
		
		'=======================================================================================
		elseif CInt(ERR_NO) == 1003 then '등록단말 해지 시
			
			if g_sStage020 = "M3" then
				'params => Alias★Dn
				Form.requestKofiaAuth("BCHAIN_104", DN_BYNM & "★" & DN_DATA, "MOD")
			end if
		
		
		'========================================================================================
		else ' 오류
		
			'RSLT_INFO : 기간계 정의 메시지
			'ERR_INFO : 금투협 블록체인 정의 메시지
			Form.MsgBox( "알림", "[TR]" & RSLT_INFO & "(" & ERR_INFO & ")", "", 0 )
			
		end if
		
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "obcsb_padc_004r" then

		Form.MsgBox("알림", szErrMsg, "", 6 )
		
	elseif szTranID == "obcsb_padc_020a" then
	
		if Len(sSubMsg) > 1 then
			Form.MsgBox( "알림", "[TR]" & szErrMsg & "\n" & "(" & sSubMsg & ")", "BCHAIN", 0 )
		else
			Form.MsgBox( "알림", "[TR]" & szErrMsg , "BCHAIN", 0 )
		end if
		
	end if
	
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	if g_nStepIndex == 0 then
		Form.CloseForm( )
	else
		Form.triggerEvent( "LinkForm0", "BeforeCheck", "" )	
	end if
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	
	if g_sRevData == "bc_new" then
		if g_nStepIndex < 2 then
			Form.triggerEvent( "LinkForm0", "NextCheck", "" )	
		end if
	
	elseif g_sRevData == "bc_mod" then
		Form.triggerEvent("LinkForm0", "NextCheck", "")
	end if
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	
	Form.SetSharedData("CERT_ID" , "")
	Form.SetSharedData("CERT_RCNO" , "")
	Form.SetSharedData("CERT_ACNO" , "")
	Form.SetSharedData("CERT_ACNT_PWD" , "")
	Form.SetSharedData("CERT_USER_NAME" , "")
	Form.SetSharedData("CERT_NEW", "")	
	Form.SetSharedData("CERT_DN" , "")
	Form.SetSharedData("CERT_INDEX" , "")
	
	Form.SetSharedData("BC_CSNO" , "")
	Form.SetSharedData("BC_CSNM" , "")
	
End Sub

'==============================================================================
' 공동인증 트리거 수신
'==============================================================================
Sub Form_OnTriggerEventKofia(sEventName, sParam)
	
	Dim sRet, sErrorCode, sErrorMsg, sResult
	
	sRet = Split(sParam, "★")
	
	sErrorCode = ""
	sErrorMsg = ""
	
	if #sRet > 2 then
		sErrorCode = sRet[0]
		sErrorMsg = sRet[1]
		sOutput = Form.KBase64Decoding(sRet[2])
	else
		'call Request_obcpp_unin_022a("N", "금투협 공동앱 " & sEventName & " 응답 오류입니다.")
		Form.MsgBox( "알림", "금투협 공동앱 " & sEventName & " 응답 오류입니다.", "", 0 )
		exit sub
	end if
	
	
	'============================================================================================
	' 정상처리
	'============================================================================================
	if sErrorCode == "0000" then
		
		'-----------------------------------------------------------------------------
		if sEventName == "MOD_BCHAIN_105" then
	
			'인증서갱신요청
			'sOutput => sAlias★sDn★sSignature(CSR:인증서발급요청문)
			Request_obcsb_padc_020a("R", "1", sOutput)
		
		'-----------------------------------------------------------------------------
		'인증서 저장 응답
		elseif sEventName == "MOD_BCHAIN_102" then
			'20171103 LES 처리구분값 수정( C -> M)
			'인증서상태변경요청(VALID)
			'sOutput => sAlias★sDn★sResponse(미사용)
			Request_obcsb_padc_020a("M", "1", sOutput) 
			
		'-----------------------------------------------------------------------------
		elseif sEventName == "MOD_BCHAIN_103" then
	
			sParam = Split(sOutput, "★")
			
			if #sParam >= 3 then
				DN_BYNM 				= sParam[0]
				DN_DATA 				= sParam[1]
				REMAIN_DATE			= sParam[2]
			end if
			'Form.ShowAlert("sParam_chain103", sParam)
			'현재단말 Alias
			g_curAlias = DN_BYNM 
			Form.SetSharedData("BCHAIN_ALIAS" , g_curAlias)
			
			Request_obcsb_padc_020a("N", "1", "")
					
		'-----------------------------------------------------------------------------
		'인증서 삭제 응답 : 해지요청 -> BCHAIN_104 -> 완료
		elseif sEventName == "MOD_BCHAIN_104" then
			
			Form.triggerEvent("LinkForm0", "bc_unregister_complete", "ok")
			
		'-----------------------------------------------------------------------------
		'인증서 비밀번호변경 응답 : BCHAIN_108 -> 완료
		elseif sEventName == "MOD_BCHAIN_108" then
			
			Form.triggerEvent("LinkForm0", "bc_change_complete", "ok")
					
		end if
		
	'===================================================================================================
	' 타 단말에서 해지시
	'===================================================================================================
	elseif sErrorCode == "2002" and sEventName == "MOD_BCHAIN_104" then
	
		'해지시 2002에러코드를 받아오지만 정상적으로 해지처리가 완료되므로 메세지 안띄우고 정상처리
		Form.triggerEvent("LinkForm0", "bc_unregister_complete", "ok")
	
	'20171031 LES START
	elseif sErrorCode == "2004" and sEventName == "MOD_BCHAIN_104" then
	
		'해지시 2004에러코드를 받아오지만 정상적으로 해지처리가 완료되므로 메세지 안띄우고 정상처리
		Form.triggerEvent("LinkForm0", "bc_unregister_complete", "ok")
	
	
	elseif sErrorCode == "2002" and sEventName == "MOD_BCHAIN_103" then
	
		'본인확인->등록단말 내역으로 넘어갈때(IOS) 인증서 not found시에는 메시지 안띄우고 정상처리
		Request_obcsb_padc_020a("N", "1", "")
	
	
	'===================================================================================================
	'비밀번호 5회오류 : 6001오류수신 -> 인증서정지요청 -> 완료
	'===================================================================================================
	elseif sErrorCode == "6001" then
		'20171103 LES 처리구분값 수정( C -> M)
		'비밀번호 5회초과일 시, 정지상태로 만드는 서비스 호출
		'인증서정지요청(SUSPENSION)
		'sOutput => sAlias★sDn★sResponse(미사용)
		Request_obcsb_padc_020a("M", "2", sOutput) 'SUSPENSION
		
	
	else
	
		if sErrorCode == "6002" then
			'사용자취소 메시지박스 처리 안함
		
		elseif sEventName == "MOD_BCHAIN_104" and sErrorCode == "2002" then
		
			'에러메시지 안보여줌 /정상처리
			Form.triggerEvent("LinkForm0", "bc_unregister_complete", "ok")
		else
			ShowAlertErrorMsg(sErrorCode)
		end if
		
	end if
	
End Sub

'============================================================================
'공동인증 관리
'============================================================================
Sub Request_obcsb_padc_020a(sPros, sStage, sOutput)
	
	
	szTranID = "obcsb_padc_020a"	
	
	UNIN_ATHN_PROS_CLCD 		= "" '공동인증처리구분코드
	UNIN_ATHN_PRGS_STAG_CODE	= "" '공동인증진행단계코드
	ELFN_ID					= "" '전자금융ID
	RCNO_PIP					= "" '실명확인번호PIP
	ACNO						= "" '계좌번호
	ACNT_PWD					= "" '계좌비밀번호
	DN_DATA					= "" 'DN데이터
	UNIN_NTAT_RQST_SNTN		= "" '공동인증서요청문장
	DN_BYNM					= "" 'DN별칭
	UNIN_NTAT_STAT_CNTT		= "" '공동인증서상태내용
	UNIN_NTAT_SNTN			= "" '공동인증서문장
	IPAD						= "" 'IP주소
	PORT_NO					= "" '포트번호
	RCNO						= "" '실명확인번호
	TERM_ID					= "" '단말ID
	
	g_sStage020 = sPros & sStage
	g_sID = Form.GetSharedData("CERT_ID",false)

	'공통
	UNIN_ATHN_PROS_CLCD		= sPros
	UNIN_ATHN_PRGS_STAG_CODE	= sStage
	ELFN_ID					= g_sID
	TERM_ID					= Form.GetDeviceID()
	
	
	'---------------------------------------------------------------
	'인증서갱신요청
	'---------------------------------------------------------------
	if sPros == "R" and sStage == "1" then
	
		'sOutput => sAlias★sDn★sSignature(CSR:인증서발급요청문)
		sParam = Split(sOutput, "★")
		
		if #sParam >= 3 then
			DN_BYNM 				= sParam[0]
			DN_DATA 				= sParam[1]
			UNIN_NTAT_RQST_SNTN 	= sParam[2]
		end if
	'20171103 LES 처리구분값 수정( C -> M)	
	'---------------------------------------------------------------
	'인증서상태변경요청
	'---------------------------------------------------------------
	elseif sPros == "M" and sStage == "1" then
			
		UNIN_ATHN_PRGS_STAG_CODE	= ""
		UNIN_NTAT_STAT_CNTT		= "VALID"	
	
		'sOutput => sAlias★sDn★sResponse(미사용)
		sParam = Split(sOutput, "★")
		
		if #sParam >= 2 then
			DN_BYNM 				= sParam[0]
			DN_DATA 				= sParam[1]
		end if
	'20171103 LES 처리구분값 수정( C -> M)
	'---------------------------------------------------------------
	'인증서정지(5회오류시)
	'---------------------------------------------------------------
	elseif sPros == "M" and sStage == "2" then
	
		UNIN_ATHN_PRGS_STAG_CODE	= ""
		UNIN_NTAT_STAT_CNTT		= "SUSPENSION"
		
		'sOutput => sAlias★sDn★sResponse(미사용)
		sParam = Split(sOutput, "★")
		
		'20171027 LES 인증서 해지시 수정 
		if #sParam >= 2 then
			DN_BYNM = sParam[0]		'g_sKofiaAlias
			DN_DATA = sParam[1]  		'g_sKofiaDN		'
		end if	
	'20171103 LES 처리구분값 수정( C -> M)
	'---------------------------------------------------------------
	'인증서해지
	'----------------------------------------------------------------
	elseif sPros == "M" and sStage == "3" then
		
		UNIN_ATHN_PRGS_STAG_CODE	= ""
		UNIN_NTAT_STAT_CNTT		= "REVOKE"
		
		'sOutput => sAlias★sDn★sResponse(미사용)
		sParam = Split(sOutput, "★")
		
		if #sParam >= 2 then
			DN_BYNM = sParam[0]
			DN_DATA = sParam[1]
		end if		
		
	'---------------------------------------------------------------
	' 현재 단말 Alias 조회
	'---------------------------------------------------------------
	elseif sPros == "N" and sStage == "1" then
		g_sKofiaDN 				= ""
	
	'--------------------------------------------------------------
	else
		Form.MsgBox( "알림", "공동인증 관리서비스 입력값이 존재하지 않습니다.", "", 0 )
		exit sub
	end if
	
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UNIN_ATHN_PROS_CLCD"		, 0 , UNIN_ATHN_PROS_CLCD)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UNIN_ATHN_PRGS_STAG_CODE"	, 0 , UNIN_ATHN_PRGS_STAG_CODE)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ELFN_ID"					, 0 , ELFN_ID)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "RCNO_PIP"					, 0 , RCNO_PIP)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"						, 0 , ACNO)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD"					, 0 , ACNT_PWD)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "DN_DATA"					, 0 , DN_DATA)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UNIN_NTAT_RQST_SNTN"		, 0 , UNIN_NTAT_RQST_SNTN)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "DN_BYNM"					, 0 , DN_BYNM)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UNIN_NTAT_STAT_CNTT"		, 0 , UNIN_NTAT_STAT_CNTT)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "UNIN_NTAT_SNTN"				, 0 , UNIN_NTAT_SNTN)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "IPAD"						, 0 , IPAD)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PORT_NO"					, 0 , PORT_NO)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "RCNO"						, 0 , RCNO)
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TERM_ID"					, 0 , TERM_ID)
	
	DATAMANAGER.RequestTranData( szTranID )
	
	
End Sub

'=============================================================================================================
'공동인증 로그인
'==============================================================================================================
Sub Request_obcpp_unin_022a(sSeviceYN, sMessage)
	if g_sID == null or g_sID == "" then
		Form.MsgBox( "알림", "사용자 ID를 입력하세요.", "", 0 )
		return
	end if	
	
	szTranID = "obcpp_unin_022a"	
	
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "USER_ID" 			, 0 , g_sID)		'사용자 ID
	
	sDeviceID = Form.GetDeviceID()
		
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TERM_IDNT_KEY"		, 0 , sDeviceID)	'단말식별키
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CONN_SUCS_YN"		, 0 , sSeviceYN)	'접속성공여부
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CONN_DTL_CNTT"		, 0 , sMessage)	'접속상세내용
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ATHN_MDIA_TYPE_CODE", 0 , "08")		'08.금투협공동인증

	DATAMANAGER.RequestTranData( szTranID )
	
End Sub


'============================================================================
Sub ButtonWideCancel_OnClick()
	Form.CloseForm()
End Sub

'=============================================================================
Sub ShowAlertErrorMsg(sErrorCode)	'연계앱 오류시 오류 메시지박스

	sErrorMsg =""

	Select Case sErrorCode
	
		Case "1001"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nKeyStore/KeyChain 접근 실패"
		Case "1002"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nKey 생성 실패"
		Case "1003"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nKey 저장 실패"
		Case "1004"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nKey 불러오기 실패"
		Case "2001"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n인증서 저장 실패"
		Case "2002"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n인증서를 찾을 수 없음"
		Case "2003"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n인증서 기한 만료"
		Case "2004"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n일치하는 인증서 없음"
		Case "2005"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n인증서 삭제 실패"
		Case "2006"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n인증서 정보 변경 실패"
		Case "3001"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nBase64 encoding 실패"
		Case "3002"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nJSON 데이터 생성 실패"
		Case "3003"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nBase64 decoding 실패"
		Case "3004"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nJSON 데이터 파싱 실패"
		Case "3101"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nParameter 부족"
		Case "4001"
		sErrorMsg = "금융투자협회 공동앱 오류\n\nInvalid Key"
		Case "4101"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n암호화 실패"
		Case "4201"
		sErrorMsg = "금융투자협회 공동앱 오류\n\n복호화 실패"
		Case "5001"
