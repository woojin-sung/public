'==============================================
' 이미지
'==============================================
Dim g_szLblImg_Normal
g_szLblImg_Normal = "btn_line2_n.9"

Dim g_szLblImg_Select
g_szLblImg_Select = "btn_line2_o.9"

Dim g_szBtnImg_Normal
g_szBtnImg_Normal = "btn_41_n.9"

Dim g_szBtnImg_Select
g_szBtnImg_Select = "btn_line2_o.9"

Dim g_szChkImg_Normal
g_szChkImg_Normal = "checkmenu_n"

Dim g_szChkImg_Select
g_szChkImg_Select = "checkmenu_o"

'==============================================
' 컬러코드
'==============================================
Dim g_szTxtColor_Normal 
g_szTxtColor_Normal = "334"

Dim g_szTxtColor_Grey 
g_szTxtColor_Grey = "333"

Dim g_szTxtColor_White 
g_szTxtColor_White = "338"

Dim g_arrPeriod
g_arrPeriod = Array("1개월", "3개월", "6개월", "1년", "3년")

Dim g_arrPeriod_Check
g_arrPeriod_Check = Array("0", "0", "0", "0", "0")

Dim g_szSharedKey
g_szSharedKey = "50110_S8_CHECK"

Dim g_szSharedKey_Period
g_szSharedKey_Period = "50110_S8_CHECK_PERIOD"

Dim g_szSharedKey_Rate
g_szSharedKey_Rate = "50110_S8_CHECK_RATE"

Dim g_szRate0, g_szRate1, g_szChk
g_szRate0 = ""
g_szRate1 = ""

Dim g_isClick0
g_isClick0 = false

Dim g_isClick1
g_isClick1 = false

Dim g_isExpand
g_isExpand = false

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************
'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	contMain.lblSubTitle0.fgcolor = g_szTxtColor_Normal
	contMain.lblSubTitle0.paddinginfo = "0,0,0,0"
	
	contMain.lblSubTitle1.fgcolor = g_szTxtColor_Grey
	contMain.lblSubTitle1.paddinginfo = "0,0,0,0"
	
	contMain.btnSlider.makeRangeSlider(true, -100.0, 100.0, -100.0, 100.0, 0.1, 1)
	contMain.btnSlider.SetRangeSliderLabelHide(true)
	contMain.btnSlider.setRangeSliderLineColor( 347,  347)
	
	contMain.lblRate0.imagefilepth = g_szLblImg_Normal
	contMain.lblRate1.imagefilepth = g_szLblImg_Normal
	
	contMain.lblRate0.fgcolor = g_szTxtColor_Grey
	contMain.lblRate1.fgcolor = g_szTxtColor_Grey
	
	contMain.lblRate0.caption = "수익률 입력"
	contMain.lblRate1.caption = "수익률 입력"
	
	contMain.lblGuideVal0.caption = "-100%"
	contMain.lblGuideVal0.paddinginfo = "0,0,0,0"
	contMain.lblGuideVal0.fgcolor = g_szTxtColor_Grey
	
	contMain.lblGuideVal1.caption = "100%"
	contMain.lblGuideVal1.paddinginfo = "0,0,0,0"
	contMain.lblGuideVal1.fgcolor = g_szTxtColor_Grey
	
	Enable_Slider(false)
End Function

'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Data()
	nArrCnt = #g_arrPeriod
	
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 
	
	contMain.Pannel0.rowcount = nPannelRowCnt
	
	nArrIdx = 0
	
	for i = 0 to nPannelRowCnt - 1
		contMain.Pannel0.SetCellValue( "lblPeriod0", i, g_arrPeriod(nArrIdx))	
		
		contMain.Pannel0.SetPropCardCell("fgcolor", "lblPeriod0", i, g_szTxtColor_Normal)
		contMain.Pannel0.SetPropCardCell("imagefilepth", "lblPeriod0", i, g_szBtnImg_Normal)
		g_arrPeriod_Check(nArrIdx) = "0" 
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.Pannel0.SetCellVisible("lblPeriod1",i,false)
			contMain.Pannel0.SetCellVisible("lblPeriod2",i,false)
			Exit for
		end if
		
		contMain.Pannel0.SetCellValue( "lblPeriod1", i, g_arrPeriod(nArrIdx))	
		contMain.Pannel0.SetPropCardCell("fgcolor", "lblPeriod1", i, g_szTxtColor_Normal)
		contMain.Pannel0.SetPropCardCell("imagefilepth", "lblPeriod1", i, g_szBtnImg_Normal)
		g_arrPeriod_Check(nArrIdx) = "0" 
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.Pannel0.SetCellVisible("lblPeriod2",i,false)
			Exit for
		end if
		
		contMain.Pannel0.SetCellValue( "lblPeriod2", i, g_arrPeriod(nArrIdx))	
		contMain.Pannel0.SetPropCardCell("fgcolor", "lblPeriod2", i, g_szTxtColor_Normal)
		contMain.Pannel0.SetPropCardCell("imagefilepth", "lblPeriod2", i, g_szBtnImg_Normal)
		g_arrPeriod_Check(nArrIdx) = "0" 
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
End Function

'===============================================
' 패널버튼 클릭 이벤트 처리
'===============================================
Function DisplaySetting_PannelBtn(nRowIdx, szCtlName)
	nCnt = nRowIdx * 3
	if szCtlName = "lblPeriod0" then
		
	elseif szCtlName = "lblPeriod1" then
		nCnt = Cint(nCnt) + 1
	elseif szCtlName = "lblPeriod2" then
		nCnt = Cint(nCnt) + 2
	end if
	
	if #g_arrPeriod_Check < nCnt+1 then
		Exit Function
	end if
	
	if g_arrPeriod_Check(nCnt) = "0" then
		Clear_Period()
		
		Enable_Slider(true)
		
		g_arrPeriod_Check(nCnt) = "1"
		contMain.Pannel0.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Select)
	else 
		Enable_Slider(false)
	
		g_arrPeriod_Check(nCnt) = "0"
		contMain.Pannel0.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Normal)
	end if
End Function

Function Reload_PannelBtn(nArrIdx)
	nIndex = 0
	
	nIndex= nArrIdx / 3
	nCtlIdx = nArrIdx % 3
	szCtlNm = ""
	
	if nCtlIdx = 0 then
		szCtlNm = "lblPeriod0"
	elseif nCtlIdx = 1 then
		szCtlNm = "lblPeriod1"
	elseif nCtlIdx = 2 then
		szCtlNm = "lblPeriod2"
	end if
	
	g_arrPeriod_Check(nArrIdx) = "1"
	contMain.Pannel0.setPropCardCell("imagefilepth", szCtlNm, nIndex, g_szBtnImg_Select)
End Function

Function Clear_Period()
	
	nArrCnt = #g_arrPeriod
	
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 
	
	nArrIdx = 0
	
	for i = 0 to nPannelRowCnt - 1
		g_arrPeriod_Check(nArrIdx) = "0"
		contMain.Pannel0.SetPropCardCell("imagefilepth", "lblPeriod0", i, g_szBtnImg_Normal)
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		g_arrPeriod_Check(nArrIdx) = "0"
		contMain.Pannel0.SetPropCardCell("imagefilepth", "lblPeriod1", i, g_szBtnImg_Normal)
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		g_arrPeriod_Check(nArrIdx) = "0"
		contMain.Pannel0.SetPropCardCell("imagefilepth", "lblPeriod2", i, g_szBtnImg_Normal)
		nArrIdx = nArrIdx + 1
		
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
End Function

Function Enable_Slider(isEnable)
	if isEnable = true then
		contMain.btnSlider.enable = true
		contMain.lblRate0.enable = true
		contMain.lblRate1.enable = true
		
		contMain.btnEmpty.visible = false
	else
		contMain.btnSlider.enable = false
		contMain.lblRate0.enable = false
		contMain.lblRate1.enable = false
		
		contMain.btnEmpty.visible = true

		g_szRate0 = ""
		g_szRate1 = ""

		g_isClick0 = false
		g_isClick1 = false
		
		contMain.btnSlider.SetRangeSlider(-100.0, 100.0, -100.0, 100.0, 0.1,1)
		
		contMain.lblRate0.fgcolor = g_szTxtColor_Grey
		contMain.lblRate1.fgcolor = g_szTxtColor_Grey
		
		contMain.lblRate0.caption = "수익률 입력"
		contMain.lblRate1.caption = "수익률 입력"
		contMain.btnSlider.setRangeSliderLineColor(347, 347)
		'Form.SetSharedData(g_szSharedKey_Rate, "")
	end if
End Function

Function Send_ChkDataToParent()
	szRateData = ""
	if contMain.lblRate0.caption <> "" and contMain.lblRate0.caption <> "수익률 입력" then
		szRateData = contMain.lblRate0.caption
		
		if contMain.lblRate1.caption <> "" and contMain.lblRate1.caption <> "수익률 입력" then
			szRateData = szRateData & "`" & contMain.lblRate1.caption
			Form.SetSharedData(g_szSharedKey_Rate, szRateData)
		else
			Form.SetSharedData(g_szSharedKey_Rate, "")
		end if
	else
		Form.SetSharedData(g_szSharedKey_Rate, "")
	end if
	
	szPeriodData = Convert_ChkArrToString(g_arrPeriod, g_arrPeriod_Check, "`")
	
	Form.SetSharedData(g_szSharedKey_Period, szPeriodData)
	
	Form.triggerEvent("#", g_szSharedKey, "")
End Function

'===============================================
' 배열 -> 문자열 변환
'===============================================
Function Convert_ArrToString(arrData, szSeperator)
	szResult = ""
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if i <> 0 then
			szResult = szResult & szSeperator 
		end if
		
		szResult = szResult & arrData(i) 
	next
	
	return szResult
End Function

'===============================================
' 배열 -> 문자열 변환
'===============================================
Function Convert_ArrToString(arrData, szSeperator)
	szResult = ""
	
	if arrData = null then
		return szResult
	end if
	
	if szSeperator = null or szSeperator = "" then
		return szResult
	end if 	
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if i <> 0 then
			szResult = szResult & szSeperator 
		end if
		
		szResult = szResult & arrData(i) 
	next
	
	return szResult
End Function

'===============================================
' 배열 -> 문자열 변환(체크항목)
'===============================================
Function Convert_ChkArrToString(arrData, arrChkData, szSeperator)
	szResult = ""
	
	if arrData = null then
		return szResult
	end if
	
	if arrChkData = null then
		return szResult
	end if
	
	if szSeperator = null or szSeperator = "" then
		return szResult
	end if 	
	
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if arrChkData(i) = "1" then
			if szResult <> "" then
				szResult = szResult & szSeperator 
			end if
			szResult = szResult & arrData(i) 
		end if
	next
	
	return szResult
End Function

'===============================================
' 문자열 -> 배열 변환
'===============================================
Function Convert_StringToArr(szData, szSeperator)
	szArrData = ""
	
	if szData <> null and szData <> "" then
		szArrData = split(szData, szSeperator)
	end if
	
	return szArrData
End Function

'===============================================
' 배열 데이터 확인
'===============================================
Function Contains_Array(arrData, szData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		szArrData = arrData(i)
		
		if szArrData = szData then
			return true
		end if
	next 
	
	return false
End Function

'===============================================
' 체크배열 초기화
'===============================================
Function Clear_ChkArray(arrData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		arrData(i) = "0"	
	next 
End Function

'===============================================
' 체크배열 전체선택
'===============================================
Function All_ChkArray(arrData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		arrData(i) = "1"	
	next 
End Function

'===============================================
' 배열 인덱스 추출
'===============================================
Function Return_ArrayIndex(arrData, szData)
	nReturn = -1
	if arrData = null or arrData = "" then
		return nReturn
	end if
	
	if szData = null or szData = "" then
		return nReturn
	end if
	
	nArrCnt = #arrData
	for i = 0 to nArrCnt-1
		if arrData(i) = szData then
			nReturn = i
			exit for
		end if	
	next 
	
	return nReturn
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	g_szSharedData0 = Form.GetSharedData(g_szSharedKey_Rate, false )
	g_szSharedData1 = Form.GetSharedData(g_szSharedKey_Period, false )
	
	Init_Control()
	Init_Data()
	
	arrTempData = Convert_StringToArr(g_szSharedData1, "`")
	
	if #arrTempData > 0 then
		Enable_Slider(true)
	end if
					
	for i = 0 to #arrTempData - 1
		nStep0_Idx = Return_ArrayIndex(g_arrPeriod, arrTempData(i))
		Reload_PannelBtn(nStep0_Idx)
	next
	
	arrTempData = Convert_StringToArr(g_szSharedData0, "`")
	
	if #arrTempData > 1 then 
		szMinValue = replace(arrTempData(0), "%", "")
		szMaxValue = replace(arrTempData(1), "%", "")
		nMinValue = Cdbl(szMinValue)
		nMaxValue = Cdbl(szMaxValue)
		
		g_szRate0 = szMinValue
		g_szRate1 = szMaxValue
		
		contMain.btnSlider.SetRangeSlider(-100,  100,  nMinValue, nMaxValue, 0.1,1)
		
		contMain.lblRate0.fgcolor = g_szTxtColor_Normal
		contMain.lblRate1.fgcolor = g_szTxtColor_Normal
	
		contMain.lblRate0.caption = arrTempData(0)
		contMain.lblRate1.caption = arrTempData(1)
	else
		contMain.btnSlider.SetRangeSlider(-100.0, 100.0, -100.0, 100.0, 0.1,1)
		
		contMain.lblRate0.fgcolor = g_szTxtColor_Grey
		contMain.lblRate1.fgcolor = g_szTxtColor_Grey
		
		contMain.lblRate0.caption = "수익률 입력"
		contMain.lblRate1.caption = "수익률 입력"
		Form.SetSharedData(g_szSharedKey_Rate, "")
	end if
	
	
	
End Sub

