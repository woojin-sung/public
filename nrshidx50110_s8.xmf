'============================================================================
Sub contMain_Pannel0_OnClick(nIndex, sCellID)
	if sCellID = "" then
		Exit Sub
	end if
	
	DisplaySetting_PannelBtn(nIndex, sCellID)
	
	Send_ChkDataToParent()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "50110_S8_CHECK" then
		Init_Data()
		
		g_szSharedData = Form.GetSharedData(g_szSharedKey_Period, false )
		arrTempData = Convert_StringToArr(g_szSharedData, "`")
		
		if #arrTempData > 0 then
			Enable_Slider(true)
		else
			Enable_Slider(false)
		end if
						
		for i = 0 to #arrTempData - 1
			nStep0_Idx = Return_ArrayIndex(g_arrPeriod, arrTempData(i))
			Reload_PannelBtn(nStep0_Idx)
		next
		
		g_szSharedData = Form.GetSharedData(g_szSharedKey_Rate, false )
		
		arrTempData = Convert_StringToArr(g_szSharedData, "`")
		
		if #arrTempData > 1 then 
			szMinValue = replace(arrTempData(0), "%", "")
			szMaxValue = replace(arrTempData(1), "%", "")
			nMinValue = Cdbl(szMinValue)
			nMaxValue = Cdbl(szMaxValue)
			
			contMain.btnSlider.SetRangeSlider(-100,  100,  nMinValue, nMaxValue, 0.1,1)
			
			contMain.lblRate0.fgcolor = g_szTxtColor_Normal
			contMain.lblRate1.fgcolor = g_szTxtColor_Normal
		
			contMain.lblRate0.caption = arrTempData(0)
			contMain.lblRate1.caption = arrTempData(1)
		else
			contMain.btnSlider.SetRangeSlider(-100,  100,  -100, 100, 0.1,1)
			contMain.btnSlider.setRangeSliderLineColor( 347,  347)
			contMain.lblRate0.fgcolor = g_szTxtColor_Grey
			contMain.lblRate1.fgcolor = g_szTxtColor_Grey
			
			contMain.lblRate0.caption = "수익률 입력"
			contMain.lblRate1.caption = "수익률 입력"
		end if
		
		
	end if
	
	if sEventName = "KEYPAD" then
		if g_isClick0 = true then
			contMain.lblRate0.caption = sParam
			g_szRate0 = sParam
			
'			if g_szRate0 = "-" then
'				g_szRate0 = ""
'			end if
		elseif g_isClick1 = true then
			contMain.lblRate1.caption = sParam
			g_szRate1 = sParam
			
'			if g_szRate1 = "-" then
'				g_szRate1 = ""
'			end if
		end if
	end if
	
	if sEventName = "KEYPAD_END" then
		
		if g_isClick0 = true then
			
			if (sParam = "" or sParam = "-") and (contMain.lblRate0.caption = "" or contMain.lblRate0.caption = "-" or contMain.lblRate0.caption = "수익률 입력" or contMain.lblRate0.caption = "%") then
				g_szRate0 = ""
				
				contMain.btnSlider.setRangeSlider(-100,  100,  -100, 100, 0.1,1)

				contMain.lblRate0.caption = "수익률 입력"
				if g_szRate1 <> "" then
					contMain.lblRate1.caption = FormatNumber(g_szRate1, 1)&"%"
				end if
				contMain.btnSlider.setRangeSliderLineColor(347, 347)
				
				contMain.lblRate0.fgcolor = g_szTxtColor_Grey
				contMain.lblRate1.fgcolor = g_szTxtColor_Grey
				
				g_isClick0 = false
					
				contMain.lblRate0.imagefilepth = g_szLblImg_Normal
				
				Form.triggerEvent("#", "50110_S8_KEYPAD", "CLOSE")
				
				contMain.lblGuide.top = 330
				contMain.setScrollAutoSize()
				
				Send_ChkDataToParent()
				exit Sub
			end if
			
			if sParam <> "" and sParam <> "-"  then
				g_szRate0 = sParam
			end if
			
			if g_szRate1 <> "" then
				if Cdbl(g_szRate0) > Cdbl(g_szRate1) then
					g_szRate0 = ""
					contMain.btnSlider.setRangeSlider(-100,  100,  -100, 100, 0.1,1)
					
					contMain.lblRate0.caption = "수익률 입력"
					if g_szRate1 <> "" then
						contMain.lblRate1.caption = FormatNumber(g_szRate1, 1)&"%"
					end if
					contMain.btnSlider.setRangeSliderLineColor(347, 347)
					
					contMain.lblRate0.fgcolor = g_szTxtColor_Grey
					contMain.lblRate1.fgcolor = g_szTxtColor_Grey
					
					Form.ShowAlert("알림", "수익률을 " & g_szRate1 & "% 보다 작게 입력해주세요")
					
'					contMain_lblRate0_OnClick()
					g_isClick0 = false
					
					contMain.lblRate0.imagefilepth = g_szLblImg_Normal
					
					Form.triggerEvent("#", "50110_S8_KEYPAD", "CLOSE")
					
					contMain.lblGuide.top = 330
					contMain.setScrollAutoSize()
					
					Send_ChkDataToParent()
					exit Sub
				end if
			end if

			contMain.lblRate0.caption = FormatNumber(g_szRate0, 1)&"%"
			
			if g_szRate1 <> "" then
				contMain.btnSlider.setRangeSlider(-100, 100, CDbl(g_szRate0), CDbl(g_szRate1), 0.1,1)
				
				contMain.btnSlider.setRangeSliderLineColor(323,347)
				
				contMain.lblRate0.fgcolor = g_szTxtColor_Normal
				contMain.lblRate1.fgcolor = g_szTxtColor_Normal
			end if
			g_isClick0 = false
				
			contMain.lblRate0.imagefilepth = g_szLblImg_Normal
			
			Form.triggerEvent("#", "50110_S8_KEYPAD", "CLOSE")
			
			contMain.lblGuide.top = 330
			contMain.setScrollAutoSize()
			
			Send_ChkDataToParent()
			
		elseif g_isClick1 = true then
			
			if (sParam = "" or sParam = "-") and (contMain.lblRate1.caption = "" or contMain.lblRate1.caption = "-" or contMain.lblRate1.caption = "수익률 입력" or contMain.lblRate1.caption = "%") then
				g_szRate1 = ""
				contMain.btnSlider.setRangeSlider(-100,  100,  -100, 100, 0.1,1)
				
				contMain.lblRate1.caption = "수익률 입력"
				if g_szRate0 <> "" then
					contMain.lblRate0.caption = FormatNumber(g_szRate0, 1)&"%"
				end if
				contMain.btnSlider.setRangeSliderLineColor(347, 347)
				
				contMain.lblRate0.fgcolor = g_szTxtColor_Grey
				contMain.lblRate1.fgcolor = g_szTxtColor_Grey
				
'				contMain_lblRate1_OnClick()
				g_isClick1 = false
				
				contMain.lblRate1.imagefilepth = g_szLblImg_Normal
				
				contMain.lblGuide.top = 330
				contMain.setScrollAutoSize()
				Form.triggerEvent("#", "50110_S8_KEYPAD", "CLOSE")
				
				Send_ChkDataToParent()
				exit Sub
			end if
			
			if sParam <> "" and sParam <> "-"  then
				g_szRate1 = sParam
			end if
			
			if g_szRate0 <> "" then	
				if Cdbl(g_szRate0) > Cdbl(g_szRate1) then
					g_szRate1 = ""
					contMain.btnSlider.setRangeSlider(-100,  100, -100, 100, 0.1,1)
					
					contMain.lblRate1.caption = "수익률 입력"
					if g_szRate0 <> "" then
						contMain.lblRate0.caption = FormatNumber(g_szRate0, 1)&"%"
					end if
					contMain.btnSlider.setRangeSliderLineColor(347, 347)
					
					contMain.lblRate0.fgcolor = g_szTxtColor_Grey
					contMain.lblRate1.fgcolor = g_szTxtColor_Grey
					
					Form.ShowAlert("알림", "수익률을 " & g_szRate0 & "% 보다 크게 입력해주세요")
					
'					contMain_lblRate1_OnClick()
					g_isClick1 = false
							
					contMain.lblRate1.imagefilepth = g_szLblImg_Normal
					
					contMain.lblGuide.top = 330
					contMain.setScrollAutoSize()
					Form.triggerEvent("#", "50110_S8_KEYPAD", "CLOSE")
					
					Send_ChkDataToParent()
				
					exit Sub
				end if
			end if
			
			
			contMain.lblRate1.caption = FormatNumber(g_szRate1, 1)&"%"
			
			if g_szRate0 <> "" then
				contMain.btnSlider.setRangeSlider(-100, 100, CDbl(g_szRate0), CDbl(g_szRate1), 0.1,1)
				
				contMain.btnSlider.setRangeSliderLineColor(323,347)
				
				contMain.lblRate0.fgcolor = g_szTxtColor_Normal
				contMain.lblRate1.fgcolor = g_szTxtColor_Normal
			end if
			
'			contMain_lblRate1_OnClick()
			g_isClick1 = false
					
			contMain.lblRate1.imagefilepth = g_szLblImg_Normal
			
			contMain.lblGuide.top = 330
			contMain.setScrollAutoSize()
			Form.triggerEvent("#", "50110_S8_KEYPAD", "CLOSE")
			
			Send_ChkDataToParent()

		end if
		
	end if
	
	if sEventName = "50110_COND_STAT" then
		if sParam = "N" then
			contMain.height = 444
			g_isExpand = false
		elseif sParam = "Y" then
			contMain.height = 334
			g_isExpand = true
		end if
		
		contMain.setScrollAutoSize()
	end if
End Sub

'============================================================================
Sub contMain_lblRate0_OnClick()
	if g_isClick0 = false then
		if g_isClick1 = true then
			Form.triggerEvent("#", "KEYPAD_END", g_szRate1)
		end if
		
		g_isClick0 = true
		g_isClick1 = false
		
		contMain.lblRate0.imagefilepth = g_szLblImg_Select
		contMain.lblRate1.imagefilepth = g_szLblImg_Normal
		
		Form.triggerEvent("#", "50110_S8_KEYPAD", "-100`100`1`")'&g_szRate0)
		
		if g_isExpand = true then
			contMain.lblGuide.top = 500
			
		else
			contMain.lblGuide.top = 600
			
		end if
		
		contMain.setScrollAutoSize()
		if Form.GetSharedData("&OS_TYPE", false) = "2" then
			contMain.scroll_pos_noAni = 140
		else
			contMain.scroll_pos = 140
		end if
	else
		Form.triggerEvent("#", "KEYPAD_END", g_szRate0)
		
		g_isClick0 = false
		g_isClick1 = false
		
		contMain.lblRate0.imagefilepth = g_szLblImg_Normal
		contMain.lblRate1.imagefilepth = g_szLblImg_Normal
		
		Form.triggerEvent("#", "50110_S8_KEYPAD", "CLOSE")
		
		contMain.lblGuide.top = 330
		contMain.setScrollAutoSize()
		
		Send_ChkDataToParent()
	end if
	
End Sub

'============================================================================
Sub contMain_lblRate1_OnClick()
	if g_isClick1 = false then
		if g_isClick0 = true then
			Form.triggerEvent("#", "KEYPAD_END", g_szRate0)
		end if
		
		g_isClick1 = true
		g_isClick0 = false
		
		contMain.lblRate1.imagefilepth = g_szLblImg_Select
		contMain.lblRate0.imagefilepth = g_szLblImg_Normal
		
		Form.triggerEvent("#", "50110_S8_KEYPAD", "-100`100`1`")'&g_szRate1)
		
		if g_isExpand = true then
			contMain.lblGuide.top = 500
		else
			contMain.lblGuide.top = 600
		end if
		
		contMain.setScrollAutoSize()
		if Form.GetSharedData("&OS_TYPE", false) = "2" then
			contMain.scroll_pos_noAni = 140
		else
			contMain.scroll_pos = 140
		end if

	else
		Form.triggerEvent("#", "KEYPAD_END", g_szRate1)
		
		g_isClick0 = false
		g_isClick1 = false
		
		contMain.lblRate0.imagefilepth = g_szLblImg_Normal
		contMain.lblRate1.imagefilepth = g_szLblImg_Normal
		
		Form.triggerEvent("#", "50110_S8_KEYPAD", "CLOSE")
		
		contMain.lblGuide.top = 330
		contMain.setScrollAutoSize()
		
		Send_ChkDataToParent()
	end if
End Sub
'============================================================================
Sub contMain_btnEmpty_OnClick()
	Form.ShowAlert("안내", "기간 선택 후 수익률을 입력해주세요")
End Sub

