'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData("ohhts_1684_001r")
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'grd00T2_OnClickUp
'============================================================================
Sub grd00T2_OnClickUp(lRow, szCellID)
	dim szSymbol
	dim szMarket
	dim szName
	
	szSymbol = grd00T2.GetCellData("bd_cell0", lRow)
	szMarket = grd00T2.GetCellData("bd_cell1", lRow)
	szName = grd00T2.GetCellData("bd_cell2", lRow)
	
	
	Form.OpenFramePopup("mhidx42040_p1" , szSymbol & "★" &  szMarket & "★" & szName , sPosInfo)

End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim szData

	if szTranID = "ohhts_1684_001r" then
	    ' 20190603 HWG START : HTS 환율데이터와 통일
	    For i = 0 to 43
			Select Case i
			Case 0			    
			    szData = "USDKRWSMBS" '원/달러
			Case 1
			    szData = "USDCNYCOMP" '중국 위안/달러
			Case 2
			    szData = "USDJPYCOMP" '일본 엔/달러 
			Case 3
			    szData = "USDHKDCOMP" '홍콩 달러/달러
			Case 4
			    szData = "USDTWDCOMP" '대만 뉴달러/달러
			Case 5
			    szData = "USDGBPCOMP" '영국 파운드/달러
			Case 6
			    szData = "USDBRLCOMP" '브라질 레알/달러
			Case 7
			    szData = "USDVNDCOMP" '베트남 동/달러
			Case 8 
			    szData = "USDEURCOMP" '유로/달러
			Case 9
			    szData = "GBPKRWCOMP" '한국 원/영국 파운드
			Case 10
			    szData = "EURKRWCOMP" '한국 원/유로
			Case 11
			    szData = "CNYKRWCOMP" '원/위안
			Case 12
			    szData = "JPYKRWCOMP" '원/엔
			Case 13
			    szData = "BRLKRWCOMP" '한국 원/브라질 레알			
			Case 14 
			    szData = "GBPUSDCOMP" '달러/영국 파운드
			Case 15
			    szData = "EURUSDCOMP" '달러/유로
			Case 16
			    szData = "USDSGDCOMP" '싱가폴 달러/달러    
			Case 17
			    szData = "USDRUBCOMP" '러시아 루블/달러
			Case 18 
			    szData = "USDQARCOMP" '카타르 리알/달러
			Case 19
			    szData = "USDOMRCOMP" '오만 리알/달러
			Case 20  
			    szData = "USDMYRCOMP" '말레이시아 링깃/달러
			Case 21 
			    szData = "USDJODCOMP" '요르단 디나르/달러
			Case 22 
			    szData = "USDKWDCOMP" '쿠웨이트 디나르/달러    
			Case 23 
			    szData = "USDAEDCOMP" '아랍에미리트 디르함/달러
			Case 24 
			    szData = "USDIDRCOMP" '인도네시아 루피아/달러    
			Case 25 
			    szData = "USDEGPCOMP" '이집트 파운드/달러
			Case 26 
			    szData = "USDILSCOMP" '이스라엘 세켈/달러    
			Case 27
			    szData = "USDARSCOMP" '아르헨티나 페소/달러    
			Case 28
			    szData = "USDCADCOMP" '캐나다 달러/달러
			Case 29
			    szData = "USDMXNCOMP" '멕시코 뉴페소/달러    
			Case 30
			    szData = "USDNZDCOMP" '뉴질랜드 달러/달러
			Case 31
			    szData = "USDAUDCOMP" '호주 달러/달러    
			Case 32
			    szData = "USDTHBCOMP" '타이 바트/달러
			Case 33
			    szData = "USDCHFCOMP" '스위스 프랑/달러    
			Case 34
			    szData = "USDSEKCOMP" '스웨덴 크로나/달러
			Case 35
			    szData = "USDNOKCOMP" '노르웨이 크로네/달러
			Case 36
			    szData = "USDSARCOMP" '사우디 리알/달러
			Case 37
			    szData = "USDDKKCOMP" '덴마크 크로네/달러    
			Case 38
			    szData = "USDINRCOMP" '인도 루피/달러
			Case 39
			    szData = "USDHUFCOMP" '헝가리 포린트/달러    
			Case 40
			    szData = "USDTRYCOMP" '터키 뉴리라/달러
			Case 41
			    szData = "USDPHPCOMP" '필리핀 페소/달러    
			Case 42
			    szData = "EURJPYCOMP" '일본 엔/유로
			Case 43
			    szData = "AUDUSDCOMP" '달러/호주 달러
			End Select
		' 20190603 HWG END
		    
		    DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i , "EN" )
		    DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_ISCD" , i , szData )

	    Next	    
	End if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	dim ncnt1684
	dim szOrgTime
		
	ncnt1684 = DATAMANAGER.GetDataCount(0, "ohhts_1684_001r" , "OutBlock1")
	
	if szTranID = "ohhts_1684_001r" then
		
		for i = 0 to ncnt1684 - 1
			szOrgTime = DATAMANAGER.GetDataValue(0, "ohhts_1684_001r", "OutBlock1", "FID_CNCN_DATE", i)
			if szOrgTime = "" or szOrgTime = null then '20220302 HSZ : 예외처리 추가
				exit Sub
			else
				DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "OutBlock1", "FID_CNCN_DATE", i , mid(szOrgTIme,3,2) &  mid(szOrgTIme,5,2)  &  mid(szOrgTIme,7,2)  )
			end if
		next	
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim ncnt1684
	dim szRealCode
	
	ncnt1684 = DATAMANAGER.GetDataCount(0, "ohhts_1684_001r" , "OutBlock1")

	if szTranID = "ohhts_1684_001r" then 
		DATAMANAGER.CancelRealData("ohhts_exrt_cntg")
	
		for i = 0 to ncnt1684 - 1
		  szRealCode = DATAMANAGER.GetDataValue(0, "ohhts_1684_001r", "OutBlock1", "FID_CNCN_ISCD", i )
		  DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", i, szRealCode) 
		  grd00T2.SetCellData("bd_cell7", i, gf_GetForeignCycle(szRealCode))
		Next	    
		
		DATAMANAGER.RequestRealData("ohhts_exrt_cntg")
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveRealData
'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	dim ncntExrt
	dim szOrgTime
		
	ncntExrt = DATAMANAGER.GetDataCount(1, "ohhts_exrt_cntg", "OutBlock1")
	if szTranID = "ohhts_exrt_cntg" then
		
