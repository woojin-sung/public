	<SCRIPT_INFO _len="1708" _ulen="1420" >
Dim gSelectYn
gSelectYn = false

'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("MeritzAuth_Security", "") '사설인증 진행 사항 초기화 (업무신청에서는 들어올 수 없음)
	Form.SetSharedData("BDM_NMETBSWRGB" , "")
End Sub

'============================================================================
Sub Form_OnFormClose()
	
	if gSelectYn = True then
		Form.OpenPopup("mbbdm86130", "" , "" ) '비대면휴대폰인증
	end if

End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Table0_OnClick(lRow , lColumn)
	Dim Num
	gSelectYn = True

	' 계좌비밀번호 재설정
	if lRow == 0 then
		Num = "002"
	' 온라인서비스 신청
	elseif lRow == 1 then
		Num = "004"
	' 온라인 이체한도 등록 및 증액
	elseif lRow == 2 then
		Num = "005"
'2024-02-20 타기관OTP 이용등록 /모바일 OTP발급 항목 삭제		
'	' 타기관OTP등록
'	elseif lRow == 3 then
'		Num = "006"
'	' 모바일OTP 발급
'	elseif lRow == 4 then
'		Num = "009"
	' 단기다수개설 출금/고 제한 해지
	elseif lRow == 3 then
		Num = "010"
	' 온라인개설계좌 실명확인
	elseif lRow == 4 then
		Num = "001"
	' 인증서 온라인 신원확인 동의
	elseif lRow == 5 then
		Num = "003"
	' 타기관 은행이체 등록
	elseif lRow == 6 then
		Num = "007"
	' 메리츠 종합계좌간 대체 등록
	elseif lRow == 7 then
		Num = "008"
	end if
	
	Form.SetSharedData("BDM_NMETBSWRGB" , Num)
	Form.CloseForm()
End Sub

