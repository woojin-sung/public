		<EDIT name="Edit0" fonttype="3" halign="2" imetype="0" ly_vert="128,120,156,39,1" />
		<LABEL name="Label1" caption="착오송금예방을 위하여 상대 입금계좌 예금주명을 입력하시기 바랍니다." multiline="1" ly_vert="25,170,259,38,1" />
		<BUTTON name="Button0" caption="취소" fgcolor="004:000000000" fontstyle="01" btnimage="btn_02.9" ly_vert="20,238,132,39,1" />
		<BUTTON name="Button1" caption="확인" fontstyle="01" btnimage="btn_01.9" ly_vert="157,238,132,39,1" />
		<EDIT name="edtName" enable="0" fonttype="3" halign="2" imetype="0" ly_vert="128,70,156,39,1" />
		<LABEL name="lblName" fgcolor="065:000000000" fontsize="-2" caption="수취인명" ly_vert="25,70,98,39,1" />
		<IMAGE name="imgTitle" imgpath="pop_header.9" ly_vert="0,0,309,55,1" />
