'============================================================================
' 화 면 명 : 이체_착오송금예방
' 화면설명 : 이체 착오송금예방 입력팝업(p2)
' 작    성 : 2016.02.05 ~ 2016.  .       Test3
'============================================================================

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szName		'수취인명
'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************



'============================================================================
Sub Button0_OnClick()
	Form.SendReturnToParent( "예금주명" , "")
	Form.CloseForm()
	
End Sub

'============================================================================
Sub Button1_OnClick()
	szName = Edit0.caption
	if Trim(szName) == "" then
		Form.ShowAlert("알림" , "예금주명을 입력하십시오")
		Exit Sub
	elseif Trim(szName) <> edtName.caption then
		Form.ShowAlert("알림" , "입력하신 예금주명과 계좌명이 상이합니다. 예금주명을 다시 입력하시거나 '예금주입력기능' 사용하기 체크 해제 후 이용하시기 바랍니다.")
'		Form.ShowAlert("알림" , "입력값이 수취인명과 다릅니다.")
		Edit0.caption = ""
		Exit Sub
	else    
		Form.SendReturnToParent( "예금주명" , "Y")
		Form.CloseForm()
	end if   
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.SendReturnToParent( "예금주명" , "")
	Form.CloseForm()
End Sub



'============================================================================
Sub Form_OnFormBackKeyPressed()
	Form.SendReturnToParent( "예금주명" , "")
End Sub


'============================================================================
Sub Form_OnFormInit()
	
	g_szName = Form.GetOpenLinkData()
	
	edtName.caption = g_szName
End Sub

	</SCRIPT_INFO>
</ROOT>