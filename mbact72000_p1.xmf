	<SCRIPT_INFO _len="3074" _ulen="2838" >
'============================================================================
' 01. 화 면 명 : 선옵 당일/익일 증거금 당일증거금
' 02. 화면설명 : 선옵 당일/익일 증거금 당일증거금 팝업
' 03. 작    성 : 2016.01.12 ~ 최지희
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAccountNumber			'계좌번호
Dim g_nAccountSerialNumber		'계좌일련번호
Dim g_szAccountPassword		'계좌비밀번호
Dim g_szData					'계좌번호★일련번호

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.SetDataValue(0, "obtrf_cntg_323r", "InBlock1", "ACNO", 0 , g_nAccountNumber)
	DATAMANAGER.SetDataValue(0, "obtrf_cntg_323r", "InBlock1", "ASNO" , 0, g_nAccountSerialNumber)
	if g_szAccountPassword <> "" then
		DATAMANAGER.SetDataValue(0,  "obtrf_cntg_323r", "InBlock1", "ACNT_PWD", 0, g_szAccountPassword)
	else
		DATAMANAGER.SetDataValue(0,  "obtrf_cntg_323r", "InBlock1", "ACNT_PWD", 0, "")
	end if
	DATAMANAGER.RequestTranData("obtrf_cntg_323r")
	
	Form.SetScreenName("당일 증거금 상세")
End Sub



'============================================================================
' Form_OnFormInitBefore()
'============================================================================
Sub Form_OnFormInitBefore()

	Dim szList
	
	g_szData = Form.GetOpenLinkData()
	
	szList = Split(g_szData, "★")	
	if UBOUND(szList) < 1 then
		exit sub
	end if
	
	g_nAccountNumber = szList(0)
	g_nAccountSerialNumber	= szList(1)
	if szList(2) <> "" then
		g_szAccountPassword = szList(2)
	else
		g_szAccountPassword = ""
	end if
	
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "obtrf_cntg_323r" then
		Dim szCode		'기본 예탁금 등급 코드
		Dim szData		'받은 기본예탁금 등급코드를 변환하여 기본 예탁금으로 변환
		szCode = DATAMANAGER.GetDataValue(0, "obtrf_cntg_323r", "OutBlock1", "BASC_DPMN_GRAD_CODE" , 0)
		szData = Form.GetMetaData("기본예탁금등급코드", szCode)
		Container0.tblTodayMarginOne.SetCellString( 1, 3, szData )
	end if
End Sub

	</SCRIPT_INFO>
