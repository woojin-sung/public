''''''''''''''''''''''''''''''''''''''''''''''-
' 01. 화 면 명 : 주식선옵현재가
' 02. 화면설명 : 주식선옵현재가 기초호가
' 03. 작    성 : 
''''''''''''''''''''''''''''''''''''''''''''''-

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket
Dim g_szFID_UNAS_SHRN_ISCD

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
Function Set_HogaTable()
	Dim szDispdiff, szJangraph, szPriceoutline, szBoldHoga, szBoldJan, szBoldRest
	Dim szColWidth, szHAlign

	szDispdiff		= Form.LoadConfigData("mhprc31000", "Dispdiff"	)	'호가등락률
	szJangraph		= Form.LoadConfigData("mhprc31000", "Jangraph"	)	'호가잔량그래프
	g_szDiplayrest	= Form.LoadConfigData("mhprc31000", "Diplayrest"	)	'호가직전수량표시
	szPriceoutline	= Form.LoadConfigData("mhprc31000", "Priceoutline")	'현재가 외곽선 표시
	szBoldHoga		= Form.LoadConfigData("mhprc31000", "BoldHoga"	)	'텍스트굵기 호가
	szBoldJan		= Form.LoadConfigData("mhprc31000", "BoldJan"		)	'텍스트굵기 호가잔량
	szBoldRest		= Form.LoadConfigData("mhprc31000", "BoldRest"	)	'텍스트굵기 직전대비
	
	'설정된 값이 없을 경우 초기값 Insert 함.
	If szDispdiff = "" Then
		szDispdiff 		= "1"
		szJangraph 		= "1"
		g_szDiplayrest 	= "0"
		szPriceoutline 	= "1"
		szBoldHoga 		= "1"
		szBoldJan 		= "0"
		szBoldRest		= "0"
		
		Form.SaveConfigData("mhprc31000", "Dispdiff"		, szDispdiff		)	'호가등락률
		Form.SaveConfigData("mhprc31000", "Jangraph"		, szJangraph		)	'호가잔량그래프
		Form.SaveConfigData("mhprc31000", "Diplayrest"	, g_szDiplayrest	)	'호가직전수량표시
		Form.SaveConfigData("mhprc31000", "Priceoutline"	, szPriceoutline	)	'현재가 외곽선 표시
		Form.SaveConfigData("mhprc31000", "Style"		, "0"			)	'현재가 스타일
		Form.SaveConfigData("mhprc31000", "BoldHoga"		, szBoldHoga		)	'텍스트굵기 호가
		Form.SaveConfigData("mhprc31000", "BoldJan"		, szBoldJan		)	'텍스트굵기 호가잔량
		Form.SaveConfigData("mhprc31000", "BoldRest"		, szBoldRest		)	'텍스트굵기 직전대비
	End If
	

	If szDispdiff = "1" Then
		'호가직전수량표시
		If g_szDiplayrest = "1" Then
			szColWidth = "45,74,90,48,73,45"
		Else
			szColWidth = "0,119,90,48,118,0"
		End If
		szHAlign = "2"
		
	ElseIf szDispdiff = "0" Then
		If g_szDiplayrest = "1" Then
			szColWidth = "45,74,138,0,73,45"
		Else
			szColWidth = "0,119,138,0,118,0"
		End If		
		szHAlign = "1"
		
	End If	
	
'	Form.ShowAlert(g_szDiplayrest, szColWidth)	
	
	'호가등락률
	hogaTbl.SetColumnWidth( szColWidth )
	
	'호가잔량그래프
	hogaTbl.hojangraph = szJangraph
	
	'현재가 외곽선 표시
	hogaTbl.priceoutline = szPriceoutline
	
	For i = 0 To 9
		'호가
		If szBoldHoga = "1" Then
			hogaTbl.setPropTable("fontstyle" , i , 2 , "01")
		Else 
			hogaTbl.setPropTable("fontstyle" , i , 2 , "00")
		End If
		
		'호가잔량
		If szBoldJan = "1" Then
			hogaTbl.setPropTable("fontstyle" , i , 1 , "01")
			hogaTbl.setPropTable("fontstyle" , i , 4 , "01")
		Else 
			hogaTbl.setPropTable("fontstyle" , i , 1 , "00")
			hogaTbl.setPropTable("fontstyle" , i , 4 , "00")
		End If
		
		'직전대비
		If szBoldRest = "1" Then
			hogaTbl.setPropTable("fontstyle" , i , 3 , "01")
		Else 
			hogaTbl.setPropTable("fontstyle" , i , 3 , "00")
		End If
		
		'호가 가로 정렬
		hogaTbl.SetCellHAlign(i, 2, szHAlign)
	Next

End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	
	g_szItemCode =  Form.GetSharedData( "&ITEM_FUTOPT", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

	'20160705 NOHES START	MarketType Default : "F"로 결정
	if Len(Trim(g_szItemMarket)) == 0 Then
		g_szItemMarket = "JF"			
	end if
	'20160705 NOHES END
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	'환경설정 Load
	Set_HogaTable()
	
	Form.SetRealBundle("1")		'20230913 jipark 부하개선
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

		'20160705 NOHES START	MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "JF"			
		end if
		'20160705 NOHES END
		
		DATAMANAGER.RequestTranData( "ohhts_3070_001r" )
	end	if

End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		DATAMANAGER.RequestTranData( "ohhts_3070_001r" )
		
	ElseIf sEventName = "HOGA_SETUP" Then
		Set_HogaTable()
		
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.CancelRealData( "ohhts_stck_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_stck_aspr" )
	
	'기초자산코드 조회
	If szTranID = "ohhts_3070_001r" Then
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
	
	'상단 정보 조회
	ElseIf szTranID = "ohhts_1001_001r" Then		
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "J" 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szFID_UNAS_SHRN_ISCD )
	
	'호가 조회
	ElseIf szTranID = "ohhts_1001_005r" Then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "J" 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_005r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szFID_UNAS_SHRN_ISCD )
	
	'체결 조회
	ElseIf szTranID = "ohhts_3071_002r" Then
		DATAMANAGER.SetDataValue( 0, "ohhts_3071_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "J" 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3071_002r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szFID_UNAS_SHRN_ISCD )
	
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'기초자산코드 조회
	If szTranID = "ohhts_3070_001r" Then
		Dim szFID_KOR_ISNM
		
		g_szFID_UNAS_SHRN_ISCD = DATAMANAGER.GetDataValue( 0, "ohhts_3070_001r", "OutBlock1", "FID_UNAS_SHRN_ISCD" , 0 )
		szFID_KOR_ISNM = DATAMANAGER.GetDataValue( 0, "ohhts_3070_001r", "OutBlock1", "FID_KOR_ISNM", 0 )
		
		arrData = Split(szFID_KOR_ISNM," ")
		if UBOUND(arrData) < 1 then
		    Exit sub
		End if	
		
		Table0.SetCellString( 0, 0, arrData(0) )
		
		DATAMANAGER.RequestTranData( "ohhts_1001_001r" )
		DATAMANAGER.RequestTranData( "ohhts_1001_005r" )
		DATAMANAGER.RequestTranData( "ohhts_3071_002r" )
	
	'상단 정보 조회
	ElseIf szTranID = "ohhts_1001_001r" Then
	
	'호가 조회
	ElseIf szTranID = "ohhts_1001_005r" Then
		Dim nTOTAL_BIDP_RSQN		' 총매수잔량
		Dim nTOTAL_ASKP_RSQN		' 총매도잔량
		
		nTOTAL_BIDP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_TOTAL_BIDP_RSQN" , 0 )
		nTOTAL_ASKP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_TOTAL_ASKP_RSQN" , 0 )
		
		hogaTbl.SetCellString( 10, 2, nTOTAL_BIDP_RSQN - nTOTAL_ASKP_RSQN )
			
		'10호가창 중간위치
		scroll_pos = "vcenter"
		
	'체결 조회
	ElseIf szTranID = "ohhts_3071_002r" Then
		DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		DATAMANAGER.RequestRealData( "ohhts_stck_aspr" )
		
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	If szTranID = "ohhts_stck_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , g_szFID_UNAS_SHRN_ISCD	)
	
	ElseIf szTranID = "ohhts_stck_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szFID_UNAS_SHRN_ISCD	)
		
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	If szTranID = "ohhts_stck_cntg" Then
		
	
	ElseIf szTranID = "ohhts_stck_aspr" Then
		Dim nTOTAL_BIDP_RSQN		' 총매수잔량
		Dim nTOTAL_ASKP_RSQN		' 총매도잔량
		Dim szACNT_CODE
		
		nTOTAL_BIDP_RSQN = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_BIDP_RSQN" , 0 )
		nTOTAL_ASKP_RSQN = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_ASKP_RSQN" , 0 )
		
		hogaTbl.SetCellString( 10, 2, nTOTAL_BIDP_RSQN - nTOTAL_ASKP_RSQN )
	
	End If
End Sub

