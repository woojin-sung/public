	<SCRIPT_INFO _len="2690" _ulen="2552" >
'============================================================================
' 01. 화 면 명 : 투자상품적정성판단보고서
' 02. 화면설명 : 투자상품적정성판단보고서 팝업
' 03. 작    성 : 
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************


Dim szData
Dim g_close
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	Btnok.fgcolor			= "273"

	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	szOpenData	= Form.GetOpenLinkData()
	g_CSNME		= Form.GetSharedData("APRT_CSNM"      , False) ' 이름
	g_CUST_GRAD	= Form.GetSharedData("APRT_CUST_GRAD" , False) ' 고객산정종합등급
	
	If Form.GetSharedData("&OS_TYPE", false) == "1" then
		Container0.setScrollBarVisible("2")
	end if
	
	Container0.Grid0.SetCellData("bd_cell03", 0, Form.getMetaData("KYC투자성향등급코드", g_CUST_GRAD))
	Container0.Grid0.SetCellData("bd_cell02", 0, g_CSNME	     	)	'고객명
	
	Container0.GridA.rowcount = 0
	Container0.GridA.height   = 52
	If szOpenData <> "" And szOpenData <> null Then
		tData = NULL
		tData = Split(szOpenData, "@")

		For ix = 0 To Ubound(tData)
			If Trim(tData[ix]) <> "" And tData[ix] <> Null Then
				Container0.GridA.rowcount	= Container0.GridA.rowcount + 1
				Container0.GridA.height		= Container0.GridA.height + 40
				szTmp = Split(tData[ix], "$")
				Container0.GridA.SetCellData("bd_cell02", ix, szTmp[0]..szTmp[1])
				Container0.GridA.SetCellData("bd_cell03", ix, szTmp[2])
				Container0.GridA.SetCellData("bd_cell04", ix, Form.getMetaData("KYC상품등급코드", szTmp[3]))
			End If
		Next
		
		Container0.Container1.top = Container0.GridA.Top + Container0.GridA.Height
		Container0.SetScrollAutoSize()
	End If
End Sub
	
'============================================================================
Sub Btnok_OnClick()
	
	Form.CloseForm()
	
End Sub

'============================================================================
Sub	Form_OnPopupReturn(sKeyName, sRet)
End	Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	Form.SendReturnToParent("mbonl81010_aprt1", "ok")   
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용
	
End Sub
	</SCRIPT_INFO>
