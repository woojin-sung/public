Function Init_Control()
	lblSubTitle.paddinginfo = "0,0,0,0"
	lblSubTitle1.paddinginfo = "0,0,0,0"
	lblSubTitle0.paddinginfo = "0,0,0,0"
	
	lblSubTitle0.fgcolor = g_szTxtColor_Grey
	lblSubTitle0.maxlinecnt = "2"
	lblSubTitle0.caption = "소액으로 부동산 투자는 하고 싶고,\n뭐부터 해야할지 모를때"
	Image0.SetMaintainingRatio("3")
	Image0.imgpath = "icon_reits"
	
	Label0.imagefilepth = g_szBtnImg_Blue
	
	Label1.bgcolor = g_szContBgColor
End Function

'리츠카테고리 / 국가코드 / 종목코드 / 신규상장 여부(YN) / 상장폐지 제외 여부(YN)  / 정렬기준 
Function RequestTranData_REITs(szData0, szData1, szData2, szData3, szData4, szData5, szData6, szData7, szData8, szData9)
	Pannel0.rowcount = "0"
	
	DATAMANAGER.ClearInputData(0, "obsim_stsv_105r")
	
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "REIT_CTGR_CLCD"	, 0 , szData0)
	
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "IQRY_COND_1_KEY_VAL"	, 0 , szData1)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "IQRY_COND_2_KEY_VAL"	, 0 , szData2)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "IQRY_COND_3_KEY_VAL"	, 0 , szData3)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "IQRY_COND_4_KEY_VAL"	, 0 , szData4)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "IQRY_COND_5_KEY_VAL"	, 0 , szData5)

	
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "ISCD"			, 0 , szData6)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "IQRY_COND_CODE1"	, 0 , szData7)
	'DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "IQRY_COND_CODE2"	, 0 , szData8)
	DATAMANAGER.SetDataValue(0, "obsim_stsv_105r", "InBlock1", "SORT_CLS"		, 0 , szData9)
	
	DATAMANAGER.RequestTranData("obsim_stsv_105r")
End Function

Function ResponseTranData_REITs()
	nDataCnt = DATAMANAGER.GetDataCount(0, "obsim_stsv_105r", "OutBlock1")
	
	for i = 0 to 4
		'종목코드
		szItem0 = DATAMANAGER.GetDataValue(0, "obsim_stsv_105r", "OutBlock1", "ISCD", i)
		'종목명(한글)
		szItem1 = DATAMANAGER.GetDataValue(0, "obsim_stsv_105r", "OutBlock1", "ISNM", i)
		'현재가격
		szItem2 = DATAMANAGER.GetDataValue(0, "obsim_stsv_105r", "OutBlock1", "PSNT_PRC", i)
		'거래수량
		szItem3 = DATAMANAGER.GetDataValue(0, "obsim_stsv_105r", "OutBlock1", "TR_QTY", i)
		'당일등락비율
		szItem4 = DATAMANAGER.GetDataValue(0, "obsim_stsv_105r", "OutBlock1", "TDAY_RSFL_RATE", i)
		
		nIdx = Pannel0.addRow()
		

		'종목코드 (변환작업 필요)
		szItem_Cd = ""
		szItem_NationCd = ""
		szItem_MrktCd = ""
		
		szPrc = ""
		
		if instr(szItem0, ".") > 0 then
			'해외
			arrTempData = split_ItemCode(szItem0)
			
			szItem_Cd = arrTempData(0)
			
			if arrTempData(1) = "AX" or arrTempData(1) = "NY" or arrTempData(1) = "OQ" then
				szItem_NationCd = "USA"
				szItem_MrktCd = arrTempData(1)
				szPrc = FormatNumber(szItem2,4)
			elseif arrTempData(1) = "JP" then
				szItem_NationCd = "JPN"
				szItem_MrktCd = arrTempData(1)
				szPrc = FormatNumber(szItem2,1)
			elseif arrTempData(1) = "SH" or arrTempData(1) = "SZ" then
				szItem_NationCd = "CHN"
				szItem_MrktCd = arrTempData(1)
				szPrc = FormatNumber(szItem2,3)
			elseif arrTempData(1) = "HK" then
				szItem_NationCd = "HKG"
				szItem_MrktCd = arrTempData(1)
				szPrc = FormatNumber(szItem2,3)
			end if
		else
			'국내 
			szItem_Cd = Mid(szItem0,2,len(szItem0))
			szItem_NationCd = "KOR"
			szItem_MrktCd = "J"
			szPrc = FormatNumber(szItem2,0)
		end if
		
		'현재가 & 수익률
		szPrcRate = szPrc & " | " & FormatNumber(szItem4,2) & "%"
		
		szPrcRateAttr = "0"
		
		if Cdbl(szItem4) > 0 then
			szPrcRateAttr = "43"
		elseif Cdbl(szItem4) < 0 then
			szPrcRateAttr = "45"
		end if

		'거래량
		szVol = "거래량 " & FormatNumber(szItem4, 0)
		
		'국기이미지
		szImgNm = Form.getIconImg("FLAG", szItem_NationCd)
	
		'관심종목 포함여부
		szIntrCd = ""
		if szItem_NationCd = "KOR" then
			szIntrCd = szItem_Cd
		else
			szIntrCd = szItem_MrktCd&"@"&szItem_Cd
		end if
		

		'인덱스 / 종목코드(시장조치) / 종목명 / 현재가(전일대비) / 국기이미지 / 레버리지인버스 배율 / 관심여부 / 보수율 / NAV / 거래량 / 종목코드
		DisplaySetting_Pannel(nIdx, szItem_Cd, szItem1, szPrcRate, szPrcRateAttr, szImgNm, "", isIntrItem, "", "", szVol, szIntrCd, szItem_MrktCd, szItem1) 
	next
End Function

'인덱스 / 종목코드(시장조치) / 종목명 / 현재가(전일대비) / 국기이미지 / 레버리지인버스 배율 / 관심여부 / 보수율 / NAV / 거래량 / 종목코드
Function DisplaySetting_Pannel(nIdx, szItemCd, szItemNm, szPrcRate, szPrcRateAttr, szFlag, szScale, szIntrYN, szData0, szData1, szData2, szHideData0, szHideData1, szHideData2) 
	'상단 라인표시
	if nIdx = 0 then
		
		Pannel0.setPropCardCell("bgcolor","lblLine2", nIdx , g_szTxtColor_White)
	else
		Pannel0.setPropCardCell("bgcolor","lblLine2", nIdx , g_szLineColor)
	end if
	
	
	'종목 국가 국기이미지 
	Pannel0.setPropCardCell("maintainratio", "imgFlag", nIdx, "2")
	Pannel0.setPropCardCell("imgpath","imgFlag", nIdx, szFlag)
	
	Pannel0.setPropCardCell("paddinginfo","lblNum",nIdx, "0,0,0,0")
	Pannel0.setPropCardCell("fgcolor","lblNum",nIdx, g_szTxtColor_Normal)
	Pannel0.setPropCardCell("maxlinecnt","lblNum",nIdx, "1^-2")
	Pannel0.setPropCardCell("caption","lblNum",nIdx, nIdx+1&".")
	
	'종목명
	Pannel0.setPropCardCell("paddinginfo","lblItemName",nIdx, "0,0,0,0")
	Pannel0.setPropCardCell("fgcolor","lblItemName",nIdx, g_szTxtColor_Normal)
	Pannel0.setPropCardCell("maxlinecnt","lblItemName",nIdx, "1^-4")
	Pannel0.setPropCardCell("caption","lblItemName",nIdx, szItemNm)
	
	'종목코드(시장조치)
	Pannel0.setPropCardCell("paddinginfo","lblItemCode",nIdx, "0,0,0,0")
	Pannel0.setPropCardCell("fgcolor","lblItemCode",nIdx, g_szTxtColor_Grey)
	Pannel0.setPropCardCell("caption","lblItemCode",nIdx, szItemCd)
	
	'현재가(전일대비)
	Pannel0.setPropCardCell("paddinginfo","lblItemPrc",nIdx, "0,0,0,0")
	Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Grey)
	Pannel0.setPropCardCell("caption","lblItemPrc",nIdx, szPrcRate)
	
'	arrTemp = split(szPrcRate, "|")
'
'	if #arrTemp > 1 then
'		nLen_Prc = Form.getLen(arrTemp(0))
'		nLen_Rate = Form.getLen(arrTemp(1))
'	
'		Pannel0.setPropCardCell("textattr","lblItemPrc",nIdx, nLen_Prc & "^1^333^-2^false^"&szPrcRate&"^2" )
'		
'		if szPrcRateAttr = "43" then
'			Pannel0.setPropCardCell("textattr","lblItemPrc",nIdx, nLen_Prc+1 & "^" & nLen_Rate & "^290^-2^true^" & szPrcRate & "^2" )
'		elseif szPrcRateAttr = "45" then
'			Pannel0.setPropCardCell("textattr","lblItemPrc",nIdx, nLen_Prc+1 & "^" & nLen_Rate & "^291^-2^true^" & szPrcRate & "^2" )
'		else
'			Pannel0.setPropCardCell("textattr","lblItemPrc",nIdx, nLen_Prc+1 & "^" & nLen_Rate & "^333^-2^true^" & szPrcRate & "^2" )
'		end if
'	else	
		if szPrcRateAttr = "43" then
			Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Buy)
		elseif szPrcRateAttr = "45" then
			Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Sell)
		else
			Pannel0.setPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Grey)
		end if
'	end if

	'(숨김)종목코드
	Pannel0.setPropCardCell("caption","lblHideData0",nIdx, szHideData0)
	Pannel0.setPropCardCell("caption","lblHideData1",nIdx, szHideData1)
	Pannel0.setPropCardCell("caption","lblHideData2",nIdx, szHideData2)

	Pannel0.setPropCardCell("paddinginfo","btnHyun",nIdx, "0,0,0,0")
	Pannel0.setPropCardCell("fgcolor","btnHyun",nIdx, g_szTxtColor_Grey)
	
	Pannel0.setPropCardCell("paddinginfo","btnChart",nIdx, "0,0,0,0")
	Pannel0.setPropCardCell("fgcolor","btnChart",nIdx, g_szTxtColor_Grey)
	
	Pannel0.setPropCardCell("paddinginfo","btnInfo",nIdx, "0,0,0,0")
	Pannel0.setPropCardCell("fgcolor","btnInfo",nIdx, g_szTxtColor_Grey)
	
	Pannel0.setPropCardCell("paddinginfo","btnOrder0",nIdx, "0,0,0,0")
	Pannel0.setPropCardCell("fgcolor","btnOrder0",nIdx, g_szTxtColor_White)
	
	Pannel0.setPropCardCell("paddinginfo","btnOrder1",nIdx, "0,0,0,0")
	Pannel0.setPropCardCell("fgcolor","btnOrder1",nIdx, g_szTxtColor_White)

	
End Function


Function MovePopup(nidx, nGbn)
	szMktCd = Pannel0.getPropCardCell("caption","lblHideData1",nidx)
	szItemCd = Pannel0.getPropCardCell("caption","lblHideData0",nidx)
	szItemNm = Pannel0.getPropCardCell("caption","lblHideData2",nidx)
	
	Form.triggerEvent("#", "50020_SCROLL_POS", "")
	'Form.SetSharedData("50020_SCROLL_POS", "S3")		
	Select Case szMktCd
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			Form.SetSharedData( "&ITEM_CODE" , szItemCd )
			Form.SetSharedData( "&ITEM_KORNAME" , szItemNm )
			Form.SetSharedData( "&ITEM_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )					
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )
			
			if nGbn == 0 then						' 현재가
				Form.OpenScreen("16000", szItemCd&"★INCOME★1")				
			elseif nGbn == 1 then					' 차트
				Form.OpenScreen("16020", "")
			elseif nGbn == 2 then				
				Form.OpenScreen("16000", szItemCd&"★INCOME★0")		
			elseif nGbn == 3 then					' 매수
				Form.OpenScreen("16060", "0")
			elseif nGbn == 4 then					' 매도
				Form.OpenScreen("16060", "1")
			end if
		Case Else
			if nGbn == 0 then							' 현재가
				Form.OpenScreen("11000", szItemCd&"★INCOME★1")
			elseif nGbn == 1 then						' 차트
				Form.OpenScreen("13000", szItemCd)
			elseif nGbn == 2 then						' 뉴스
				Form.OpenFramePopup("nrshidx50800_p2" , szItemCd & "|" & szMktCd & "|" &  szItemNm , sPosInfo)
				'Form.OpenScreen("11000", szItemCd&"★INCOME★0")
			elseif nGbn == 3 then						' 매수
				Form.OpenScreen("12000", "스크리너★0" & "★" & szItemCd)
			elseif nGbn == 4 then						' 매도
				Form.OpenScreen("12000", "스크리너★1" & "★" & szItemCd)
			end if	
	End Select

End Function

'===============================================
' 해외주식 종목코드 변환(기간계)
'===============================================
Function split_ItemCode(szItemCd)
	arrTemp = {}
	if szItemCd = "" then
		Exit Function
	end if
	
	if instr(szItemCd, ".") = 0 then
		Exit Function
	end if
	
	if instr(szItemCd, ".AX") > 0 then
		Table.insert(arrTemp, replace(szItemCd, ".AX", ""))
		Table.insert(arrTemp, "AX")
		
	elseif instr(szItemCd, ".NY") > 0 then
		Table.insert(arrTemp, replace(szItemCd, ".NY", ""))
		Table.insert(arrTemp, "NY")

	elseif instr(szItemCd, ".OQ") > 0 then
		Table.insert(arrTemp, replace(szItemCd, ".OQ", ""))
		Table.insert(arrTemp, "OQ")

	elseif instr(szItemCd, ".HK") > 0 then
		Table.insert(arrTemp, replace(szItemCd, ".HK", ""))
		Table.insert(arrTemp, "HK")

	elseif instr(szItemCd, ".SZ") > 0 then
		Table.insert(arrTemp, replace(szItemCd, ".SZ", ""))
		Table.insert(arrTemp, "SZ")	

	elseif instr(szItemCd, ".SH") > 0 then
		Table.insert(arrTemp, replace(szItemCd, ".SH", ""))
		Table.insert(arrTemp, "SH")

	elseif instr(szItemCd, ".JP") > 0 then
		Table.insert(arrTemp, replace(szItemCd, ".JP", ""))
		Table.insert(arrTemp, "JP")
		
	else
		Table.insert(arrTemp, "")
		Table.insert(arrTemp, "")
		
	end if
	
	return arrTemp
End Function

