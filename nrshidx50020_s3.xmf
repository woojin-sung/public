'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
   Init_Control()
   
   RequestTranData_REITs("%", "%", "%", "%", "%", "%", "%", "N", "Y", "2")
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obsim_stsv_105r" then
		ResponseTranData_REITs()

	end if
End Sub

'============================================================================
Sub Label0_OnClick()
	Form.OpenScreen("50800" , "")
End Sub

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	if sCellID <> "btnHyun" and sCellID <> "btnChart" and sCellID <> "btnInfo" and sCellID <> "btnOrder0" and sCellID <> "btnOrder1" then
		nCurHeight = Pannel0.GetCardWHAt(nIndex)
	
		if g_nFoldHeight = nCurHeight then
			Pannel0.SetCardWHAt(nIndex, g_nExpandHeight)
		else
			Pannel0.SetCardWHAt(nIndex, g_nFoldHeight)
		end if
		
		Pannel0.resetRowInfos()
		if g_nPrev_Expand_Idx > -1 then
			if g_nPrev_Expand_Idx <> nIndex then
				Pannel0.SetCardWHAt(g_nPrev_Expand_Idx, g_nFoldHeight)
			end if
		end if
		
		g_nPrev_Expand_Idx = nIndex
		
		if nIndex = 4 then
			Pannel0.toprow = "1"
		end if
	elseif sCellID = "btnHyun" then
		MovePopup(nIndex, 0)
	elseif sCellID = "btnChart" then
		MovePopup(nIndex, 1)
	elseif sCellID = "btnInfo" then
		MovePopup(nIndex, 2)
	elseif sCellID = "btnOrder0" then
		MovePopup(nIndex, 3)
	elseif sCellID = "btnOrder1" then
		MovePopup(nIndex, 4)	
	
	end if
End Sub

