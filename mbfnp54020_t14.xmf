'--===========================================================================
'--===========================================================================
Dim g_szGbnCode			' 매매구분코드(0:전체, 1:매도, 2:매수)
Dim g_szTradeGbnCode		' 체결구분코드(0:전체, 1:체결, 2:미체결)
g_szGbnCode = 0
g_szTradeGbnCode = 0
'============================================================================
Sub Form_OnFormInit()
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 6) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	
	FormTab0.insertPage( FormTab0.tabcount, "page1", "page1", "empty", "0", "전체")
	FormTab0.insertPage( FormTab0.tabcount, "page2", "page2", "empty", "0", "체결")
	FormTab0.insertPage( FormTab0.tabcount, "page3", "page3", "empty", "0", "미체결")
	FormTab0.currenttab = 0
	'20230710 htw start 종목명 멀티라인 설정
	Grid0.SetCellMaxLineCount("bd_cell2", 2)
	'20230710 htw end 종목명 멀티라인 설정
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INIT_CODE" then
		f_Reset()
	elseif sEventName == "ACNT_CHANGE" then
		f_Reset()
	end if
End Sub

Sub f_Reset()
	Grid0.rowcount = 0
'	g_szGbnCode = "0"		' 매매구분코드(0:전체, 1:매도, 2:매수)
'	g_szTradeGbnCode = "0"	' 체결구분코드(0:전체, 1:체결, 2:미체결)
'	FormTab0.currenttab = 0
'	Combo0.currentindex = 0
	
	f_SendTR()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtrs_cntg_660r" then

		g_nAcNo = Form.GetCtlProp("#acc", "total")
		g_nAsNo = Form.GetCtlProp("#acc", "sequence")

		DATAMANAGER.SetDataValue(0, "obtrs_cntg_660r", "InBlock1", "ACNO", 0 , g_nAcNo)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_660r", "InBlock1", "ASNO", 0 , g_nAsNo)
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_660r", "InBlock1", "CNTG_CLS_CODE", 0 , CInt(FormTab0.currenttab))	'0:전체, 1:채결, 2:미체결
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_660r", "InBlock1", "DEAL_CLS_CODE", 0 , Combo0.cbkeydata)			'0:전체, 1:매도, 2:매수
		DATAMANAGER.SetDataValue(0, "obtrs_cntg_660r", "InBlock1", "ODER_TYPE_CLS_CODE", 0 , "08") '주문유형코드구분

	End if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	If szTranID = "obtrs_cntg_660r" Then

		Dim iCnt, iDataCount, strFullNM, strTrade_Gubun, strMC_Gubun, strTrade_Gubun_nm, strMC_Gubun_nm
		Dim sCode, sName, OderRfusReasCode
		iDataCount = DATAMANAGER.GetDataCount( 0, "obtrs_cntg_660r" , "OutBlock1" )
		
		if CInt(Grid0.rowcount) == 0 then
			imgNodata.visible = true
			lblNodata.visible = true
		else
			imgNodata.visible = false
			lblNodata.visible = false
		end if
		
		For iCnt = 0 To iDataCount - 1

			OderRfusReasCode = DATAMANAGER.GetDataValue( 0, "obtrs_cntg_660r", "OutBlock1", "ODER_RFUS_REAS_CODE", iCnt ) '주문거부사유코드
			sCode            = DATAMANAGER.GetDataValue( 0, "obtrs_cntg_660r", "OutBlock1", "BOND_MKPL_CLS_CODE", iCnt ) '채권매매시장구분코드
			strTrade_Gubun   = DATAMANAGER.GetDataValue( 0, "obtrs_cntg_660r", "OutBlock1", "DEAL_CLS_CODE", iCnt )
			strMC_Gubun      = DATAMANAGER.GetDataValue( 0, "obtrs_cntg_660r", "OutBlock1", "RCTF_CNCL_CLS_CODE", iCnt )

			strTrade_Gubun_nm = fn_CodeToName( "Trade", strTrade_Gubun )
			strMC_Gubun_nm    = fn_CodeToName( "MC", strMC_Gubun )

			'Form.ShowAlert(sTitle, "-->"..strMC_Gubun.."<--")
			
			if tostring(strMC_Gubun) == "1" then
			    strFullNM = strTrade_Gubun_nm
			else
			    strFullNM = strTrade_Gubun_nm&strMC_Gubun_nm
			end if

		    '매매구분
		    Grid0.SetCellData( "bd_cell4", ( (Grid0.rowcount - iDataCount) + iCnt), strFullNM )
		    
		    '채권매매시장구분코드
		    sName = Form.GetMetaData( "채권매매시장구분코드", sCode )
		    Grid0.SetCellData( "bd_cell8", ( (Grid0.rowcount - iDataCount) + iCnt), sName )
		    
		    if Trim(OderRfusReasCode) == "0000" or Trim(OderRfusReasCode) == "" then
			    Grid0.SetCellData( "bd_cell12", ( (Grid0.rowcount - iDataCount) + iCnt), "정상" )
		    else
			    Grid0.SetCellData( "bd_cell12", ( (Grid0.rowcount - iDataCount) + iCnt), "거부" )
		    end if
		    
		    '매도
		    if strTrade_Gubun == "1" then
			    Grid0.SetCellFgColor("bd_cell4", ( (Grid0.rowcount - iDataCount) + iCnt), "11")
		    '매수
		    else
			    Grid0.SetCellFgColor("bd_cell4", ( (Grid0.rowcount - iDataCount) + iCnt), "10")
		    end if
	    next
	    
		if CInt(g_szGbnCode) == 2 and CInt(Grid0.rowcount) > 0 then
			if CInt(Grid0.rowcount) < 5 then
				Grid0.height = 45 + CInt(Grid0.rowcount) * 64
				lblAllCancel.top = 44 + 45 + CInt(Grid0.rowcount) * 64
			else
				Grid0.height = 326
				lblAllCancel.top  = 370
			end if
			lblAllCancel.visible = true
		else
			Grid0.height = 356
		end if
    End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg, szTranMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert("알림", szErrMsg)
	end if
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	lblcmb.caption = Combo0.caption
	if nCurrentTab == 1 then
		g_szTradeGbnCode = "2"	' 체결구분코드(0:전체, 1:체결, 2:미체결)
	elseif nCurrentTab == 2 then
		g_szTradeGbnCode = "1"
	else
		g_szTradeGbnCode = CStr(nCurrentTab)	' 체결구분코드(0:전체, 1:체결, 2:미체결)
	end if

	if iIndex == 0 then
		g_szTradeGbnCode = "0"
	elseif iIndex == 1 then
		g_szTradeGbnCode = "2"
	elseif iIndex == 2 then
		g_szTradeGbnCode = "1"
	end if
	
	f_SendTR()
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	g_szGbnCode = nCurrentTab			' 체결구분코드(0:전체, 1:체결, 2:미체결)
	f_SendTR()
End Sub

'============================================================================
Sub f_SendTR()
	Grid0.rowcount = 0
	lblAllCancel.visible = false
	DATAMANAGER.RequestTranData("obtrs_cntg_660r")
end sub 


'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
'	'미체결인 item인 경우 정정/취소 탭 이동 및 해당 item 종목으로 조회,해당 호가로 화면 data 셋팅
	if CInt(FormTab0.currenttab) == 2 then
		szItemCode 	= Grid0.GetCellData("bd_cell9", lRow)
		szItemMarket 	= Form.GetItemCodeInfo(szItemCode, "market")
		
		' 장내채권, 소액채권만가능
		If Trim(szItemMarket) == "MM" or Trim(szItemMarket) == "BN" then
			szOdrNo   = Grid0.GetCellData("bd_cell0", 	lRow)	'주문번호
			szQty	 = Grid0.GetCellData("bd_cell7", 	lRow)	'미체결수량
			szOdrType = Grid0.GetCellData("bd_cell4", 	lRow)	'매매구분
			szOdrPrc  = Grid0.GetCellData("bd_cell5", 	lRow) 	'주문가격
			szClsCd   = Grid0.GetCellData("bd_cell11", 	lRow)	'주문조건구분코드    ODER_COND_CLS_CODE
			szMktNm   = Grid0.GetCellData("bd_cell8", 	lRow) 	'채권매매시장구분
			if szMktNm == "일반시장" then
				szMktCd = "B"  '장내
			else
				szMktCd = "SB"  '소액
			end if
			
			szData = szItemCode & "★" & szMktCd & "★" & szQty & "★" & szOdrNo & "★" & szOdrType & "★" & szOdrPrc & "★" & szClsCd
			Form.triggerEvent("#", "SEND_MOD", szData)
		else
			Form.ShowAlert("알림", "선택상품은 MTS에서 거래되지 않는 상품입니다.")
		end if
	end if
End Sub

'============================================================================
Sub lblAllCancel_OnClick()
	'전체취소
	'주문번호
	Form.triggerEvent("#", "SEND_ALL_CANCEL", "")
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgNodata.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
End Sub

'============================================================================
Sub lblcmb_OnClick()
	Combo0.openlist()
End Sub

'============================================================================
Sub Image0_OnClick()
	Combo0.openlist()
End Sub

'============================================================================
Function fn_CodeToName(szTitle, szCode)
 Select Case szTitle
  Case "Trade"
   Select Case szCode
    Case "1" return "매도"
    Case "2" return "매수"
    Case "3" return "매수청산"
    Case "4" return "매도청산"
    Case "5" return "권리행사"
    Case "6" return "의무배정"
    Case "7" return "행사포기"
    Case "8" return "의무면제"
    Case "A" return "인수대금"
    Case "B" return "인도대금"
    Case "C" return "단주행사"
    Case "D" return "단주배정"
    Case "0" return "상계"
   end Select 
  
  Case "MC"
   Select Case szCode
    Case "1" return "정상"
    Case "2" return "정정"
    Case "3" return "취소"
   end Select
end Select
End Function


