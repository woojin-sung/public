'============================================================================
' 01. 화 면 명 : 거래내역_매매
' 02. 화면설명 : 거래내역_매매
' 03. 작    성 : 2016. 03. 02. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szList		'거래내역 화면에서 받아온 내용 저장 리스트
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam) : 트리거를 입력받아 데이터 입력
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
		
	if sEventName == "매매" then
	
		g_szList = Split(sParam,"★")
		
		if UBOUND(g_szList) < 1 then
			Exit Sub
		End if
	
'	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "ACNO" , 0 , g_szList(0))
'	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "ASNO" , 0 , g_szList(1))
'	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "FRST_TR_DATE" , 0 , g_szList(2))
'	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "LAST_TR_DATE" , 0 , g_szList(3))
'	'20230904 KKM 자동투자내역 제외 체크값 추가
'	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "CMA_ENRL_YN" , 0 , g_szList(4))
	
	end if
	
	g_nNextCount = 0
	DATAMANAGER.RequestTranData( "obrtp_tran_001r" )
	
End Sub

'============================================================================
' grd0_OnScrollEnd() : 스크롤시 추가 데이터 연결
'============================================================================
Sub grd0_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obrtp_tran_001r" )
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID) : 행 선택시 상세팝업에 쓰일 입력값 전달
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szData
	Dim szAccount
	
	'상세팝업에 필요한 데이터 전부 보냄								
'	szData = grd1.GetCellData( "bd_cell0", lRow ) & "●" & g_szList(0) & g_szList(1) & "●" & grd1.GetCellData( "bd_cell2", lRow ) & "●" & 
'	grd1.GetCellData( "bd_cell3", lRow ) & "●" & grd1.GetCellData( "bd_cell4", lRow ) & "●" & grd1.GetCellData( "bd_cell5", lRow ) & "●" & grd1.GetCellData( "bd_cell6", lRow ) & "●" & 
'	grd1.GetCellData( "bd_cell7", lRow ) & "●" & grd1.GetCellData( "bd_cell8", lRow ) & "●" & grd1.GetCellData( "bd_cell9", lRow ) & "●" & grd1.GetCellData( "bd_cell10", lRow ) & "●" & 
'	grd1.GetCellData( "bd_cell11", lRow ) & "●" & grd1.GetCellData( "bd_cell12", lRow ) & "●" & grd1.GetCellData( "bd_cell13", lRow ) & "●" &
'	grd1.GetCellData( "bd_cell14", lRow ) & "●" & grd1.GetCellData( "bd_cell15", lRow ) & "●" & grd1.GetCellData( "bd_cell16", lRow ) & "●" &
'	g_szList(1)
	
	szData = g_szList(0) & "●" & g_szList(1) & "●" & grd1.GetCellData( "bd_cell0", lRow ) & "●" & grd1.GetCellData( "bd_cell1", lRow ) 
	
	Form.OpenFramePopup( "mbact71040_p1" , szData , sPosInfo)
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 거래유형 코드값을 이용하여 거래 구분 표기
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nType
	Dim nValue					'제비용값으로 수수료, 제세금 및 각종 세금을 더한 값으로 사용
	nValue = 0
	
	if szTranID == "obrtp_tran_001r" then
		for i = 0 to (DATAMANAGER.GetDataCount( 0 , "obrtp_tran_001r", "OutBlock1" ) - 1)
			g_nNextCount = g_nNextCount + 1
			
			
			
			nType = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "TR_TYPE_CODE" , i)
			
			Select Case nType
				Case "01" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출금")
				Case "02" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출금")
				Case "03" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case "04" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case "05" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "06" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "07" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "08" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "09" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "10" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "11" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case "12" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case "13" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "14" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "15" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출금")
				Case "16" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case "17" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case "18" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case "19" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case Else grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출금")
			End Select
			
			Dim tmpStr 
			Dim numStr
			
			szIssuTypeCode = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "ISSU_TYPE_CODE" , i)
			if  szIssuTypeCode == "35" then					
				nValue = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "IF_FEE_EXCL_AMT" , i) + DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "OVSC_DEAL_FEE" , i)
				numStr = FormatNumber(nValue, 2)
			else
				nValue = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "FEE" , i) + 
						DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "DEAL_FEE" , i) + 
						DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "INTX" , i) + 
						DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "RSTX" , i) + 
						DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "SRTX" , i) + 
						DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "TRTX" , i)
				numStr = FormatNumber(nValue, 2)				
			end if
			grd0.SetCellData( "bd_cell7" , g_nNextCount - 1 , nValue )
			
		next
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obrtp_tran_001r" then
		DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "ASNO" , 0 , g_szList(1))
		DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "FRST_TR_DATE" , 0 , g_szList(2))
		DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "LAST_TR_DATE" , 0 , g_szList(3))
		'20230904 KKM 자동투자내역 제외 체크값 추가
		DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "CMA_ENRL_YN" , 0 , g_szList(4))
	end if
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	
	DATAMANAGER.RequestTranData( "obrtp_tran_001r" )
	
End Sub

