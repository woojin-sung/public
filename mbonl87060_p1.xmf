Dim g_RetFlag
Dim g_sz_OSType              'OS타입
Dim g_szTheme                '테마구분  white/black

Dim g_Status	'개인(신용)정보처리대상이 "100% 징수 (수수료 포함)" 선택한 경우 : P0
			'개인(신용)정보처리대상이 "100% 징수 (수수료 포함)" 이외 선택한 경우 : P1

'============================================================================
Sub Form_OnFormInitBefore()
	ImgClose.SetMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
    'OSType 1.안드로이드 2.IOS
     g_sz_OSType = Form.GetSharedData("&OS_TYPE", false)

    '테마구분 white/black
	g_szTheme = Form.GetEnvData("common.theme")

	'파일설정
'	User_File_Set()

    '확인버튼 비활성화
    btnOK.enable = false
    If g_szTheme = "black" Then
        btnOK.btnimage = "btn_27.9"
    Else 
        btnOK.btnimage = "btn_21.9"
    End If
    btnOK.fgcolor = "269"

'	'공유정보Get
'	User_SharedData_Get()

	lblCtcnShow.caption = "필수동의서(요약/상세) 보기 >"

	'특정단어 글자색 설정 v0001
	containMain.contain1.lbl1.fgcolor = 265	'265(주황색) #ef3b24
	containMain.contain2.lbl1.fgcolor = 265	'265(주황색) #ef3b24
	containMain.contain3.lbl1.fgcolor = 265	'265(주황색) #ef3b24
	containMain.contain4.lbl1.fgcolor = 265	'265(주황색) #ef3b24

	'이어하기용 정보 설정
	User_Conti_Data_Set()	
	
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		containMain.setScrollBarVisible("2")
	end if
	
End Sub

'============================================================================
Function User_Conti_Data_Set()
	Dim szData
	szData = Form.GetOpenLinkData()
	
	if Trim(szData) <> "" then
		tData = Split(szData, "★")
		
		g_BDM_Mndt_1_1_1_1 = tData[0]
		g_BDM_Mndt_1_1_1_2 = tData[1]
		g_BDM_Mndt_1_2_1_1 = tData[2]
		g_BDM_Mndt_1_2_1_2 = tData[3]
		g_BDM_Mndt_2_1_1_1 = tData[4]
		g_BDM_Mndt_2_1_1_2 = tData[5]
		g_BDM_Mndt_3_1_1_1 = tData[6]
		g_BDM_Mndt_3_1_1_2 = tData[7]
		
		g_Status = tData[8]	'"P0" : 공통항목만, "P1" : 전체
		
		if g_Status == "P0" then	
			containMain.contain2.visible = 0
			containMain.contain2S1.visible = 0
			containMain.contain2S11.visible = 0
			containMain.contain3.visible = 0
			containMain.contain3S1.visible = 0
			containMain.contain3S11.visible = 0
			containMain.contain4.visible = 0
			containMain.contain4S1.visible = 0
			containMain.contain4S11.visible = 0
			
			containMain.height = 1000	'스크롤 방지
		end if
		
		'기선택된 정보인 경우 화면표시 처리
		User_Chk_Image_Set("1_1_1_1", g_BDM_Mndt_1_1_1_1)   '1.1 수집이용(공통)_고유식별
		User_Chk_Image_Set("1_1_1_2", g_BDM_Mndt_1_1_1_2)		'1.1 수집이용(공통)_개인신용
		
		if g_Status == "P1" then	
			'기선택된 정보인 경우 화면표시 처리
			User_Chk_Image_Set("1_2_1_1", g_BDM_Mndt_1_2_1_1)		'1.2 수집이용(상품)_신용/미수/파생_고유식별
			User_Chk_Image_Set("1_2_1_2", g_BDM_Mndt_1_2_1_2)		'1.2 수집이용(상품)_신용/미수/파생_개인신용
			User_Chk_Image_Set("2_1_1_1", g_BDM_Mndt_2_1_1_1)		'2.1 제공(상품)_신용/미수/파생/해외파생_고유식별
			User_Chk_Image_Set("2_1_1_2", g_BDM_Mndt_2_1_1_2)		'2.1 제공(상품)_신용/미수/파생/해외파생_개인신용
			User_Chk_Image_Set("3_1_1_1", g_BDM_Mndt_3_1_1_1)		'3   조회(상품)_신용/미수/파생/해외파생_고유식별
			User_Chk_Image_Set("3_1_1_2", g_BDM_Mndt_3_1_1_2)		'3   조회(상품)_신용/미수/파생/해외파생_개인신용
		end if
		
		
		'다음버튼 활성화/비활성화
		User_Btn_OKStep()
	End if	

End Function

'============================================================================
Function User_Chk_Image_Set(trgt, chk)

	'수집이용(공통)
	If trgt = "1_1_1_1" Then '고유식별
		If chk == "Y" Then
			containMain.contain1S.img11.imgpath = "check_on.png"
		Else
			containMain.contain1S.img11.imgpath = "check_off.png"
		End If
	ElseIf trgt = "1_1_1_2" Then '개인신용
		If chk == "Y" Then
			containMain.contain1S.img12.imgpath = "check_on.png"
		Else
			containMain.contain1S.img12.imgpath = "check_off.png"
		End If	

	'수집이용(상품)_신용공여/미수
	ElseIf g_Status == "P1" and trgt = "1_2_1_1" Then '고유식별
		If chk == "Y" Then
			containMain.contain2S11.img11.imgpath = "check_on.png"
		Else
			containMain.contain2S11.img11.imgpath = "check_off.png"
		End If
	ElseIf g_Status == "P1" and trgt = "1_2_1_2" Then '개인신용
		If chk == "Y" Then
			containMain.contain2S11.img12.imgpath = "check_on.png"
		Else
			containMain.contain2S11.img12.imgpath = "check_off.png"
		End If	

	'제공(상품)_신용공여/미수/해외파생
	ElseIf g_Status == "P1" and trgt = "2_1_1_1" Then '고유식별
		If chk == "Y" Then
			containMain.contain3S11.img11.imgpath = "check_on.png"
		Else
			containMain.contain3S11.img11.imgpath = "check_off.png"
		End If
	ElseIf g_Status == "P1" and trgt = "2_1_1_2" Then '개인신용
		If chk == "Y" Then
			containMain.contain3S11.img12.imgpath = "check_on.png"
		Else
			containMain.contain3S11.img12.imgpath = "check_off.png"
		End If

	'조회(상품)_신용공여/미수/해외파생
	ElseIf g_Status == "P1" and trgt = "3_1_1_1" Then '고유식별
		If chk == "Y" Then
			containMain.contain4S11.img11.imgpath = "check_on.png"
		Else
			containMain.contain4S11.img11.imgpath = "check_off.png"
		End If
	ElseIf g_Status == "P1" and trgt = "3_1_1_2" Then '개인신용
		If chk == "Y" Then
			containMain.contain4S11.img12.imgpath = "check_on.png"
		Else
			containMain.contain4S11.img12.imgpath = "check_off.png"
		End If

	End If

End Function 

'============================================================================
Function User_Btn_OKStep()

	strYN = "Y"

	'수집이용(공통)_고유식별/개인신용
	If g_BDM_Mndt_1_1_1_1 <> "Y" Or g_BDM_Mndt_1_1_1_2 <> "Y" Then
		strYN = "N"
	End If
	
	if g_Status == "P1" then 	
		'1.2수집이용(상품)_신용공여/미수/파생상품_고유식별/개인신용
		If g_BDM_Mndt_1_2_1_1 <> "Y" Or g_BDM_Mndt_1_2_1_2 <> "Y" Then
			strYN = "N"
		End If
	
		'2.1제공(상품)_신용공여/미수/파생상품/해외파생_고유식별/개인신용
		If g_BDM_Mndt_2_1_1_1 <> "Y" Or g_BDM_Mndt_2_1_1_2 <> "Y" Then
			strYN = "N"
		End If
	
		'3  조회(상품)_신용공여/미수/파생상품/해외파생_고유식별/개인신용
		If g_BDM_Mndt_3_1_1_1 <> "Y" Or g_BDM_Mndt_3_1_1_2 <> "Y" Then
			strYN = "N"
		End If
	end if

	If strYN == "Y" Then
		btnOK.enable = true
		btnOK.btnimage = "btn_20.9"
		btnOK.fgcolor = "273"
	Else
		btnOK.enable = false
	    If g_szTheme = "black" Then
			btnOK.btnimage = "btn_27.9"
	    Else 
			btnOK.btnimage = "btn_21.9"
	    End If
		btnOK.fgcolor = "269"
	End If
	
End Function




