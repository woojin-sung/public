	    g_BDM_Mndt_3_1_1_2 = "Y"
	End If
	
	User_Chk_OK("3_1_1_2", g_BDM_Mndt_3_1_1_2)
End Sub

'============================================================================
' 동의서보기
'============================================================================
Sub lblCtcnShow_OnClick()
'	'공유정보Set
'	User_SharedData_Set("")

	Form.OpenPopup("mbbdm85131_p1", "Mndt", "")	'약관보기
End Sub

'============================================================================
Function User_Chk_OK(trgt, chk)
	'Y/N 설정
	'수집이용(공통)
	If trgt = "1_1_1_1" Then '고유식별
		g_BDM_Mndt_1_1_1_1 = chk
	ElseIf trgt = "1_1_1_2" Then '개인신용
		g_BDM_Mndt_1_1_1_2 = chk

	'수집이용(상품)_신용공여/미수
	ElseIf g_Status == "P1" and trgt = "1_2_1_1" Then '고유식별
		g_BDM_Mndt_1_2_1_1 = chk
	ElseIf g_Status == "P1" and trgt = "1_2_1_2" Then '개인신용
		g_BDM_Mndt_1_2_1_2 = chk

	'제공(상품)_신용공여/미수/해외파생
	ElseIf g_Status == "P1" and trgt = "2_1_1_1" Then '고유식별
		g_BDM_Mndt_2_1_1_1 = chk
	ElseIf g_Status == "P1" and trgt = "2_1_1_2" Then '개인신용
		g_BDM_Mndt_2_1_1_2 = chk

	'조회(상품)_신용공여/미수/해외파생
	ElseIf g_Status == "P1" and trgt = "3_1_1_1" Then '고유식별
		g_BDM_Mndt_3_1_1_1 = chk
	ElseIf g_Status == "P1" and trgt = "3_1_1_2" Then '개인신용
		g_BDM_Mndt_3_1_1_2 = chk
		
	End If
	
	'Y/N 설정에 따른 색상표시
	User_Chk_Image_Set(trgt, chk)

	'다음버튼 활성화/비활성화
	User_Btn_OKStep()
	
End Function


'============================================================================
' 확인종료
'============================================================================
Sub btnOK_OnClick()
    g_RetFlag = "ok"
    Form.CloseForm()
End Sub
'============================================================================
Sub ImgClose_OnClick()
	g_RetFlag = "close"
	Form.CloseForm()
End Sub
'============================================================================
Function NextStep()
	'현재화면 닫기
    Form.SendReturnToParent("mbonl87060_p1", g_RetFlag)
End Function
'============================================================================
Sub Form_OnFormClose()
    '현재화면 닫기
    Form.SendReturnToParent("mbonl87060_p1", g_RetFlag)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	'약관
	if sKeyName == "mbbdm85131_p1" then
		if sRet == "ok_Mndt" then
			'약관확인 종료시, 모두동의 한 것으로 체크
			g_BDM_Mndt_1_1_1_1 = "Y"
			g_BDM_Mndt_1_1_1_2 = "Y"
			User_Chk_OK("1_1_1_1", g_BDM_Mndt_1_1_1_1)	' 수집이용(공통)_고유식별
			User_Chk_OK("1_1_1_2", g_BDM_Mndt_1_1_1_2)	' 수집이용(공통)_개인신용

			if g_Status == "P1" then
				g_BDM_Mndt_1_2_1_1 = "Y"
				g_BDM_Mndt_1_2_1_2 = "Y"
				User_Chk_OK("1_2_1_1", g_BDM_Mndt_1_2_1_1)	' 수집이용(상품)_신용공여/미수/파생_고유식별
				User_Chk_OK("1_2_1_2", g_BDM_Mndt_1_2_1_2)	' 수집이용(상품)_신용공여/미수/파생_개인신용
	
				g_BDM_Mndt_2_1_1_1 = "Y"
				g_BDM_Mndt_2_1_1_2 = "Y"
				User_Chk_OK("2_1_1_1", g_BDM_Mndt_2_1_1_1)	' 제공(상품)_신용공여/미수/파생/해외파생_고유식별
				User_Chk_OK("2_1_1_2", g_BDM_Mndt_2_1_1_2)	' 제공(상품)_신용공여/미수/파생/해외파생_개인신용			
	
				g_BDM_Mndt_3_1_1_1 = "Y"
				g_BDM_Mndt_3_1_1_2 = "Y"
				User_Chk_OK("3_1_1_1", g_BDM_Mndt_3_1_1_1)	' 조회(상품)_신용공여/미수/파생/해외파생_고유식별
				User_Chk_OK("3_1_1_2", g_BDM_Mndt_3_1_1_2)	' 조회(상품)_신용공여/미수/파생/해외파생_개인신용
			else			
				g_BDM_Mndt_1_2_1_1 = "Y"
				g_BDM_Mndt_1_2_1_2 = "Y"
				g_BDM_Mndt_2_1_1_1 = "Y"
				g_BDM_Mndt_2_1_1_2 = "Y"
				g_BDM_Mndt_3_1_1_1 = "Y"
				g_BDM_Mndt_3_1_1_2 = "Y"
			end if
		end if
	end if
End Sub

