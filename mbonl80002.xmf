Dim g_szAcnt
Dim g_szPwd
Dim g_szProcTp

Dim g_szBSDD_APLY_CLCD
Dim g_szBSDD_APLT_AMT
Dim g_szCROV_YN
Dim g_szTHCO_MNNO

'============================================================================
Sub Form_OnFormInit()
	'그리드 카드뷰 설정
	grdListNow.setUseCardView(true, 15, "input_01_n.9")
	grdListPast.setUseCardView(true, 15, "input_01_n.9")
	grdListNext.setUseCardView(true, 15, "input_01_n.9")
	
	g_szAcnt = acnt0.total
	
'	'연도콤보세팅
'	Dim nNowYear
'	nNowYear = CInt(Left(Form.GetSharedData( "&HOST_DATE", false ), 4))
'	'내역 조회시에는 2022년도부터 지정
'	For i = 2022 to Left(nNowYear,4)+1
'		cmbPeriod.cbadddatatext = i & "`" & i & "년"
'	Next
	
	Dim szMode
	szMode = Form.GetSharedData("&SERVER_MODE", False )
	
	'연도콤보세팅
	Dim nNowYear
	nNowYear = CInt(Left(Form.GetSharedData("&HOST_DATE", false), 4))
	If szMode == "1" Or szMode == 1 Then		'테스트
		For i = 2021 to nNowYear+1
			cmbPeriod.cbadddatatext = i & "`" & i & "년"
		Next
	Else									'운영
		'혹시 모르니 예외처리
		If nNowYear == 2022 Then
			nNowYear = 2023
		End If
		For i = 2023 to nNowYear+1
			cmbPeriod.cbadddatatext = i & "`" & i & "년"
		Next
	End If
	cmbPeriod.cbkeydata = nNowYear
	
	'금융투자소득 기본공제 조회
	DATAMANAGER.RequestTranData( "obcsb_fiin_001r" )
	
'	'리스트 test
'	grdListNow.visible = true
'	grdListPast.visible = false
'	
'	grdListNow.rowcount = 5
'	for i = 0 to CInt(grdListNow.rowcount) - 1
'		grdListNow.SetCellData("bd_date", i, "20220907")
'		grdListNow.SetCellData("bd_name", i, "상장주식 등 금융투자소득")
'		grdListNow.SetCellData("bd_title1", i, "신청 금액")
'		grdListNow.SetCellData("bd_title2", i, "차기연도 이월여부")
'		grdListNow.SetCellData("bd_amt", i, "10000000")
'		grdListNow.SetCellData("bd_nextyear", i, "YES")
'		
'		grdListNow.SetCellData("bd_cancel", i, "취소하기")
'		
''		grdListNow.SetCellImage("bd_reduce", i, "btn_01_n.9.png")
'		grdListNow.SetCellData("bd_reduce", i, "감액하기")
'	Next
'	
'	grdListPast.rowcount = 5
'	for i = 0 to CInt(grdListNow.rowcount) - 1
'		grdListPast.SetCellData("bd_date", i, "20220907")
'		grdListPast.SetCellData("bd_name", i, "상장주식 등 금융투자소득")
'		grdListPast.SetCellData("bd_title1", i, "신청 금액")
'		grdListPast.SetCellData("bd_title2", i, "차기연도 이월여부")
'		grdListPast.SetCellData("bd_amt", i, "10000000")
'		grdListPast.SetCellData("bd_nextyear", i, "YES")
'	Next
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName == "INIT_SCREEN" And sParam <> "" And sParam <> Null Then
		g_szAcnt = sParam
		
		'연도콤보세팅
		Dim nNowYear
		nNowYear = CInt(Left(Form.GetSharedData( "&HOST_DATE", false ), 4))
		'내역 조회시에는 2022년도부터 지정
		For i = 2021 to nNowYear+1
			cmbPeriod.cbadddatatext = i & "`" & i & "년"
		Next
		
		'금융투자소득 기본공제 조회
		DATAMANAGER.RequestTranData( "obcsb_fiin_001r" )
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'계좌 비밀번호 입력 리턴
	If sKeyName == "CORRECT_PWD" And sRet <> "" And sRet <> Null Then
'		Form.ShowAlert(sKeyName, sRet)
		Dim tData
		tData = Split(sRet, "★")
		If UBOUND(tData) > 0 Then
			g_szPwd = tData[0]
			
			'금융투자소득 기본공제 관리
			DATAMANAGER.RequestTranData( "obcsb_fiin_002a" )
		End If
	
	'감액 키패드 리턴
	ElseIf sKeyName == "AMT_CHANGE" And sRet <> "" And sRet <> Null Then
		g_szProcTp = "230"
		
		'키패드에서 입력한 금액을 변수에 지정(이 변수에 넣어도 될듯?)
		g_szBSDD_APLT_AMT = sRet
		
		'계좌비밀번호 입력 후 감액 서비스 호출
		Form.openPopupAnimation("pwdcheckpopup", acnt0.total & "☆0" , "", "2")
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "NEXT_CHANGE" And sRet == "ok" Then
		g_szProcTp = "250"
		
		'계좌비밀번호 입력 후 이월정보 변경 서비스 호출
		Form.openPopupAnimation("pwdcheckpopup", acnt0.total & "☆0" , "", "2")
	
	ElseIf sKeyName == "AMT_CHANGE" And sRet == "ok" Then
		g_szProcTp = "230"
		
		'계좌비밀번호 입력 후 감액 서비스 호출
		Form.openPopupAnimation("pwdcheckpopup", acnt0.total & "☆0" , "", "2")
	
	ElseIf sKeyName == "CANCEL" And sRet == "ok" Then
		g_szProcTp = "220"
		
		'계좌비밀번호 입력 후 당일취소 서비스 호출
		Form.openPopupAnimation("pwdcheckpopup", acnt0.total & "☆0" , "", "2")
	
	'002a 진행 완료 메시지박스 리턴
	ElseIf sKeyName == "PROC_COMPLETE" Then
		g_szProcTp = ""
		g_szCROV_YN = ""
		g_szBSDD_APLY_CLCD = ""
		g_szBSDD_APLT_AMT = ""
		g_szTHCO_MNNO = ""
		
		grdListPast.SetClear()
		grdListNow.SetClear()
		grdListNext.SetClear()
		
		'금융투자소득 기본공제 조회
		DATAMANAGER.RequestTranData( "obcsb_fiin_001r" )
	
	'고객지원센터 화면이동
	ElseIf sKeyName == "MOVE_CUSTCENTER" And sRet == "no" Then
		Form.OpenScreen("89020" , "")
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'금융투자소득 기본공제 조회
	If szTranID == "obcsb_fiin_001r" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , g_szAcnt)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , "")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TXTN_APLY_YEAR" , 0 , cmbPeriod.cbkeydata)
		'"0":전체, "1":상장주식 등, "2":기타
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_APLY_CLCD" , 0 , "0") 
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_BSWR_CODE" , 0 , "200")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SCTY_INFO_IQRY_YN" , 0 , "M")
	
	'금융투자소득 기본공제 관리
	ElseIf szTranID == "obcsb_fiin_002a" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , g_szPwd)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_BSWR_CODE" , 0 , g_szProcTp)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TXTN_APLY_YEAR" , 0 , cmbPeriod.cbkeydata)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_APLY_CLCD" , 0 , g_szBSDD_APLY_CLCD)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BSDD_APLT_AMT" , 0 , g_szBSDD_APLT_AMT)
		
		'이월여부 변경건은 현재 등록된 여부값의 반대로 입력
		If g_szProcTp == "250" Then
			If g_szCROV_YN == "Y" Then
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CROV_YN" , 0 , "N")
			Else
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CROV_YN" , 0 , "Y")
			End If
			
		'그 외에는 기존의 이월여부값을 넣음
		Else
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CROV_YN" , 0 , g_szCROV_YN)
		End If
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "INFO_DEL_YN" , 0 , "N")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "THCO_MNNO" , 0 , g_szTHCO_MNNO)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'금융투자소득 기본공제 조회
	If szTranID == "obcsb_fiin_001r" Then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock2")
		
		If CInt(nCnt) > 0 Then
			lblMove.left = 10
			lblMove.top = 101
			
			Dim szType, szName, szAmt, szNextYn, szDate
			
			'과거년도 내역조회시 grdListPast, 당해년도 grdListNow, 차기년도 grdListNext에 표시
			'과거년도
			If CInt(cmbPeriod.cbkeydata) < CInt(Left(Form.GetSharedData( "&HOST_DATE", false ), 4)) Then
'				Form.ShowAlert("1", "")
				grdListPast.visible = true
				grdListNow.visible = false
				grdListNext.visible = false
				lblNoData.visible = false
				
				grdListPast.rowcount = nCnt
				
				For i = 0 to CInt(nCnt) - 1 
					szType = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "BSDD_APLY_CLCD" , i)
					If szType == "1" Then
						szName = "상장주식 등 금융투자소득"
					Else
						szName = "기타 금융투자소득"
					End If
					szAmt = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "BSDD_REG_AMT" , i)
					If DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "CROV_YN" , i) == "Y" Then
						szNextYn = "예"
					Else
						szNextYn = "아니오"
					End If
					szDate = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "APLT_DATE" , i)
					
					grdListPast.SetCellData("bd_date", i, szDate)
					grdListPast.SetCellData("bd_name", i, szName)
					grdListPast.SetCellData("bd_title1", i, "신청 금액")
					grdListPast.SetCellData("bd_title2", i, "차기연도 이월여부")
					grdListPast.SetCellData("bd_amt", i, szAmt)
					grdListPast.SetCellData("bd_nextyear", i, szNextYn)
				Next
				
			'당해연도
			ElseIf CInt(cmbPeriod.cbkeydata) == CInt(Left(Form.GetSharedData( "&HOST_DATE", false ), 4)) Then
				'Form.ShowAlert("2", "")
				grdListPast.visible = false
				grdListNow.visible = true
				grdListNext.visible = false
				lblNoData.visible = false
				
				grdListNow.rowcount = nCnt
				
				For i = 0 to CInt(nCnt) - 1 
					szType = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "BSDD_APLY_CLCD" , i)
					If szType == "1" Then
						szName = "상장주식 등 금융투자소득"
					Else
						szName = "기타 금융투자소득"
					End If
					szAmt = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "BSDD_REG_AMT" , i)
					If DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "CROV_YN" , i) == "Y" Then
						szNextYn = "예"
					Else
						szNextYn = "아니오"
					End If
					szDate = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "APLT_DATE" , i)
					
					grdListNow.SetCellData("bd_date", i, szDate)
					grdListNow.SetCellData("bd_name", i, szName)
					grdListNow.SetCellData("bd_title1", i, "신청 금액")
					grdListNow.SetCellData("bd_title2", i, "차기연도 이월여부")
					grdListNow.SetCellData("bd_amt", i, szAmt)
'					grdListNow.SetCellData("bd_nextyear", i, szNextYn)
					
					'이월여부 관련 세팅 
'					grdListNow.SetCellImage("bd_nextY", i, "input_01_n.9")
'					grdListNow.SetCellImage("bd_nextN", i, "input_01_n.9")
'					
'					grdListNow.SetCellData("bd_nextY", i, "YES")
'					grdListNow.SetCellData("bd_nextN", i, "NO")
					
					If DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "CROV_YN" , i) == "Y" Then
						grdListNow.SetCellData("bd_next", i, "img_switch_o.png")
					Else
						grdListNow.SetCellData("bd_next", i, "img_switch_n.png")
					End If
					grdListNow.SetCellData("Data1", i, DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "CROV_YN" , i))
					
					'취소하기 보임 여부
					Dim szCnclAbleYn
					szCnclAbleYn = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "CNCL_ABLE_YN" , i)
'					If CInt(szDate) == CInt(Form.GetSharedData( "&HOST_DATE", false )) Then
					If szCnclAbleYn == "Y" Then
						grdListNow.SetCellData("bd_cancel", i, "취소하기〉")
					Else
						grdListNow.SetCellData("bd_cancel", i, "")
					End If
					
					grdListNow.SetCellData("Data2", i, DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "BSDD_APLY_CLCD" , i))
					grdListNow.SetCellData("Data3", i, DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "BSDD_REG_AMT" , i))
					grdListNow.SetCellData("Data4", i, DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "CNCL_ABLE_YN" , i))
					grdListNow.SetCellData("Data5", i, DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "THCO_MNNO" , i))
					
'					grdListNow.SetCellImage("bd_reduce", i, "btn_01_n.9.png")
'					grdListNow.SetCellData("bd_reduce", i, "감액하기")
				Next
				
			'차기연도
			Else
'				Form.ShowAlert("3", "")
				grdListPast.visible = false
				grdListNow.visible = false
				grdListNext.visible = true
				lblNoData.visible = false
				
				grdListNext.rowcount = nCnt
				
				For i = 0 to CInt(nCnt) - 1 
					szType = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "BSDD_APLY_CLCD" , i)
					If szType == "1" Then
						szName = "상장주식 등 금융투자소득"
					Else
						szName = "기타 금융투자소득"
					End If
					szAmt = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "BSDD_REG_AMT" , i)
					If DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "CROV_YN" , i) == "Y" Then
						szNextYn = "예"
					Else
						szNextYn = "아니오"
					End If
					szDate = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "APLT_DATE" , i)
					
					grdListNext.SetCellData("bd_date", i, szDate)
					grdListNext.SetCellData("bd_name", i, szName)
					grdListNext.SetCellData("bd_title1", i, "신청 금액")
					grdListNext.SetCellData("bd_title2", i, "차기연도 이월여부")
					grdListNext.SetCellData("bd_amt", i, szAmt)
'					grdListNext.SetCellData("bd_nextyear", i, szNextYn)
					
					'이월여부 관련 세팅
'					grdListNext.SetCellImage("bd_nextY", i, "input_01_n.9")
'					grdListNext.SetCellImage("bd_nextN", i, "input_01_n.9")
'					
'					grdListNext.SetCellData("bd_nextY", i, "YES")
'					grdListNext.SetCellData("bd_nextN", i, "NO")
					
					If DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "CROV_YN" , i) == "Y" Then
						grdListNext.SetCellData("bd_next", i, "img_switch_o.png")
					Else
						grdListNext.SetCellData("bd_next", i, "img_switch_n.png")
					End If
					grdListNext.SetCellData("Data1", i, DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "CROV_YN" , i))
					
					'취소하기 보임여부
					Dim szCnclAbleYn
					szCnclAbleYn = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "CNCL_ABLE_YN" , i)
'					If CInt(szDate) == CInt(Form.GetSharedData( "&HOST_DATE", false )) Then
					If szCnclAbleYn == "Y" Then
						grdListNext.SetCellData("bd_cancel", i, "취소하기〉")
					Else
						grdListNext.SetCellData("bd_cancel", i, "")
					End If
					
					grdListNext.SetCellImage("bd_reduce", i, "btn_01_n.9.png")
					grdListNext.SetCellData("bd_reduce", i, "감액하기")
					
					grdListNext.SetCellData("Data2", i, DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "BSDD_APLY_CLCD" , i))
					grdListNext.SetCellData("Data3", i, DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "BSDD_REG_AMT" , i))
					grdListNext.SetCellData("Data4", i, DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "CNCL_ABLE_YN" , i))
					grdListNext.SetCellData("Data5", i, DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "THCO_MNNO" , i))
				Next
			End If
		Else
			grdListPast.visible = false
			grdListNow.visible = false
			grdListNext.visible = false
			lblNoData.visible = true
			
			lblMove.left = 116
			lblMove.top = 251
		End If
	
	'금융투자소득 기본공제 관리
	ElseIf szTranID == "obcsb_fiin_002a" Then
		Dim szMsgText, szSubText
		szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
		szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
		
'		Form.ShowAlert(szMsgText, szSubText)
		
		Dim szFiinTlmsNo
		szFiinTlmsNo = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "FIIN_TLMS_NO" , i)
		
		Dim szText
		If g_szProcTp == "250" Then
			szText = "차기연도 이월여부가 변경되었습니다."
		ElseIf g_szProcTp == "220" Then	'취소
			szText = "금융투자소득 기본공제금액 신청금액이 취소 되었습니다."
		ElseIf g_szProcTp == "230" Then '감액
			szText = "금융투자소득 기본공제금액 신청내역이 변경 되었습니다."
		End If
		Form.MsgBox("안내", szText, "PROC_COMPLETE", 6)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	'고객지원센터 연결 예외처리
	If szErrMsg == "5600" Then
		Form.MsgBox("안내", "실명정보가 불일치 합니다.\n실명정보(고객명/실명번호)를 변경해 주세요.", "MOVE_CUSTCENTER", 7, "확인", "고객지원센터 연결")
		Exit Sub
	End If
	
	If szSubMsg <> "" And szSubMsg <> Null Then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	Else
		Form.ShowAlert("알림", szErrMsg)
	End If
End Sub

'============================================================================
Sub grdListPast_OnClickUp(lRow, szCellID)
	'과거연도 그리드에선 처리할 내용 없음
End Sub

'============================================================================
Sub grdListNow_OnClickUp(lRow, szCellID)
	'당해연도는 당일 취소 및 차기연도 이월여부만 변경 가능 
	Dim szCrovYn
	szCrovYn = grdListNow.GetCellData("Data1", lRow)
	
	'002a 서비스에 태울 데이터 미리 가져옴
	g_szCROV_YN = grdListNow.GetCellData("Data1", lRow)
	g_szBSDD_APLY_CLCD = grdListNow.GetCellData("Data2", lRow)
	g_szBSDD_APLT_AMT = grdListNow.GetCellData("Data3", lRow)
	g_szTHCO_MNNO = grdListNow.GetCellData("Data5", lRow)
	
	'이월여부 변경
	If szCellID == "bd_next" Then
'	If (szCellID == "bd_nextY" And szCrovYn == "N") Or (szCellID == "bd_nextN" And szCrovYn == "Y") Then	
		Form.MsgBox("안내", "차기연도 이월여부를 변경하시겠어요?", "NEXT_CHANGE", 7, "신청", "닫기")
	
	'당일취소
	ElseIf szCellID == "bd_cancel" Then
		If grdListNow.GetCellData("Data4", lRow) == "Y" Then
			Form.MsgBox("안내", "금융투자소득 기본공제금액 신청금액을 취소 하시겠습니까?", "CANCEL", 7, "신청 취소", "닫기")
		End If
	Else
		g_szCROV_YN = ""
		g_szBSDD_APLY_CLCD = ""
		g_szBSDD_APLT_AMT = ""
		g_szTHCO_MNNO = ""
	End If
End Sub

'============================================================================
Sub grdListNext_OnClickUp(lRow, szCellID)
	'차기연도는 당일 취소, 차기연도 이월여부, 감액 전부 가능
	Dim szCrovYn
	szCrovYn = grdListNext.GetCellData("Data1", lRow)
	
	'002a 서비스에 태울 데이터 미리 가져옴
	g_szCROV_YN = grdListNext.GetCellData("Data1", lRow)
	g_szBSDD_APLY_CLCD = grdListNext.GetCellData("Data2", lRow)
	g_szBSDD_APLT_AMT = grdListNext.GetCellData("Data3", lRow)
	g_szTHCO_MNNO = grdListNext.GetCellData("Data5", lRow)
	
	'이월여부 변경
	If szCellID == "bd_next" Then
'	If (szCellID == "bd_nextY" And szCrovYn == "N") Or (szCellID == "bd_nextN" And szCrovYn == "Y") Then	
		Form.MsgBox("안내", "차기연도 이월여부를 변경하시겠어요?", "NEXT_CHANGE", 7, "신청", "닫기")
	
	'당일취소
	ElseIf szCellID == "bd_cancel" Then
		If grdListNext.GetCellData("Data4", lRow) == "Y" Then
			Form.MsgBox("안내", "금융투자소득 기본공제금액 신청금액을 취소 하시겠습니까?", "CANCEL", 7, "신청 취소", "닫기")
		End If
	'감액
	ElseIf szCellID == "bd_reduce" Then
		Dim szRegDate, szToday
		szRegDate = CInt(grdListNext.GetCellData("bd_date", lRow))
		szToday = CInt(Form.GetSharedData("&HOST_DATE", false))
		
		'이월여부가 Y인 경우 감액신청 불가 > N으로 변경 후 감액 유도 얼럿
		If g_szCROV_YN == "Y" Then
			Form.ShowAlert("안내", "차기연도 이월처리가 된 경우 감액이 불가합니다.\n\n이월여부를 NO로 변경 후 진행해 주세요.")
			
			g_szCROV_YN = ""
			g_szBSDD_APLY_CLCD = ""
			g_szBSDD_APLT_AMT = ""
			g_szTHCO_MNNO = ""
			
		'당일 등록건도 이월처리 안됨 > 취소 후 재신청 얼럿
		ElseIf szRegDate == szToday Then
			Form.ShowAlert("안내", "당일 신청분은 감액이 불가합니다. \n\n취소 신청 후 한도를 재신청 해주세요.")
			
			g_szCROV_YN = ""
			g_szBSDD_APLY_CLCD = ""
			g_szBSDD_APLT_AMT = ""
			g_szTHCO_MNNO = ""
			
		Else
			'감액 키패드 팝업 오픈
			Form.OpenPopupAnimation("mbonl80002_p1", g_szBSDD_APLT_AMT, "", "2")
		End If
	Else
		g_szCROV_YN = ""
		g_szBSDD_APLY_CLCD = ""
		g_szBSDD_APLT_AMT = ""
		g_szTHCO_MNNO = ""
	End If
End Sub

'============================================================================
Sub cmbPeriod_OnEditComplete(iIndex)
	'연도 변경하여 재조회
	grdListPast.SetClear()
	grdListNow.SetClear()
	grdListNext.SetClear()
	
	'금융투자소득 기본공제 조회
	DATAMANAGER.RequestTranData( "obcsb_fiin_001r" )
End Sub

'============================================================================
Sub lblMove_OnClick()
	'금투세 기본공제 현황으로 이동
	Form.OpenScreen("80000" , "")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName == "INFO_CLICK" Then
		Form.OpenFramePopup("mbonl80001_p1" , "" , "")
	End If
End Sub

'============================================================================
Sub acnt0_ChangeAccount()
	g_szProcTp = ""
	g_szCROV_YN = ""
	g_szBSDD_APLY_CLCD = ""
	g_szBSDD_APLT_AMT = ""
	g_szTHCO_MNNO = ""
	
	grdListPast.SetClear()
	grdListNow.SetClear()
	grdListNext.SetClear()
	
	'금융투자소득 기본공제 조회
	DATAMANAGER.RequestTranData( "obcsb_fiin_001r" )
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	grdListNow.setMaintainingRatio("bd_next", 0, "1")
	grdListNext.setMaintainingRatio("bd_next", 0, "1")
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obcsb_fiin_001r" trcode="obcsb_fiin_001r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obcsb_fiin_002a" trcode="obcsb_fiin_002a" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obcsb_fiin_001r" title="금융투자소득 기본공제 조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="306" _ulen="222" >

ACNO^계좌번호^8^0^0^0^0^0^0
ACNT_PWD^계좌비밀번호^68^0^0^0^0^0^0
TXTN_APLY_YEAR^과세적용년도^4^0^0^0^0^0^0
BSDD_APLY_CLCD^기본공제적용구분코드^1^0^0^0^0^0^0
BSDD_BSWR_CODE^기본공제업무코드^3^0^0^0^0^0^0
SCTY_INFO_IQRY_YN^협회정보조회여부^1^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="323" _ulen="249" >

