'--===========================================================================
' 01. 화 면 명 : 
' 02. 화면설명 : 
' 03. 작    성 : 
' 04. 수    정 : 
' 2022.04.28 : v0001 : KSJ : 지정심사신청 타사투자경험 등록(mbonl94002_p31) 공통사용 적용
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szMetaString
Dim g_szOpenData		'v0001
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()	
	'v0001 STA
	g_szOpenData = ""
	g_szOpenData = Trim(Form.GetOpenLinkData())
	If g_szOpenData == "mbonl94002_p31" Then
		cmbGubun.enable = true
	End If
	'v0001 FIN
	
	DATAMANAGER.RequestTranData("obcpp_code_029r")
End Sub

'============================================================================
' 회원사 선택
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	szDeptCd = Grid0.GetCellData("bd_Code", lRow)
	szDeptNm = Grid0.GetCellData("bd_CodeName", lRow)
	
	'v0001 STA 다른화면에 영향 최소화하기위해
	If g_szOpenData == "mbonl94002_p31" Then
		If cmbGubun94002.caption == cmbGubun.cbkeydata Then
			Form.SendReturnToParent("close_mbonl94003_p4", szDeptCd & "★" & szDeptNm & "★" & cmbGubun94002.cbkeydata )
		End if
	Else
		Form.SendReturnToParent("close_mbonl94003_p4", szDeptCd & "★" & szDeptNm)
	End If
	'v0001 FIN
	
	Form.CloseForm()
End Sub

'============================================================================
' 회원사명 검색
'============================================================================
Sub edtName_OnEditComplete()
	DATAMANAGER.RequestTranData("obcpp_code_002r")
End Sub

'============================================================================
' 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' v0001 구분값 선택
'============================================================================
Sub cmbGubun_OnEditComplete(iIndex)
	cmbGubun94002.currentindex = iIndex
	Grid0.SetClear()
	DATAMANAGER.RequestTranData("obcpp_code_029r")
End Sub


'****************************************************************************
'               		D A T A				M A N A G E R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcpp_code_029r" then
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "META_TERM_PHSC_NAME" , 0 ,  cmbGubun.cbkeydata )
	
	elseif szTranID == "obcpp_code_002r" then
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 ,  "1" )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "META_TERM_PHSC_NAME" , 0 ,  g_szMetaString )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CODE_VALD_VAL_KOR_NAME" , 0 ,  Trim(edtName.caption) )
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 들어왔을때
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	
	if szTranID == "obcpp_code_029r" then
		g_szMetaString = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "META_TERM_NAME" , 0)
		
		DATAMANAGER.RequestTranData("obcpp_code_002r")
		
	elseif szTranID == "obcpp_code_002r" then
'		If DATAMANAGER.IsMoreNextData( sTranID ) = True Then
'			DATAMANAGER.RequestNextData( sTranID )
'		End If
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 오류
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	if szSubMsg <> NULL or szSubMsg <> "" then
		Form.ShowAlert("알림", szErrMsg)
	
	else
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	end if
End Sub



