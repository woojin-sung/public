'============================================================================
Sub Combo0_OnEditComplete(iIndex)

     nIndex = Combo0.currentindex
     
	Select Case CInt(nIndex)
		
		Case 1
			tmp = 4
		Case 2
			tmp = 6
		Case 3
			tmp = 8
		Case 4
			tmp = 2
	End Select
	
		
	Form.SetSharedData("score3",tmp)
	
	
	if Combo0.currentindex <> "0"and Combo1.currentindex <> "0" then
		check_flag_2 = 1
		Form.SetSharedData("check_flag_2",check_flag_2)
		
	elseif Combo0.currentindex == "0" or Combo1.currentindex == "0" then
		check_flag_2 = 0
		Form.SetSharedData("check_flag_2",check_flag_2)
		
	end if
	
End Sub

'============================================================================
Sub Combo1_OnEditComplete(iIndex)

	nIndex = Combo1.currentindex
     
	Select Case CInt(nIndex)
		
		Case 1
			tmp2 = 7
		Case 2
			tmp2 = 0
		
	End Select
	
	Form.SetSharedData("score4",Cstr(tmp2))
	
	
	if Combo0.currentindex <> "0"and Combo1.currentindex <> "0" then
		check_flag_2 = 1
		Form.SetSharedData("check_flag_2",check_flag_2)
		
	elseif Combo0.currentindex == "0" or Combo1.currentindex == "0" then
		check_flag_2 = 0
		Form.SetSharedData("check_flag_2",check_flag_2)
		
	end if
	
	
	
	
	
	



	
End Sub



