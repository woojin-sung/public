--===========================================================================
--===========================================================================
Dim g_szThemeCode, g_nGrdIndex

'============================================================================
function SelectItem(szCode)
	if InStr(szCode, "6A") = 1 then
		return true
	elseif InStr(szCode, "6E") = 1 then
		return true
	elseif InStr(szCode, "NQ") = 1 then
		return true
	elseif InStr(szCode, "ES") = 1 then
		return true
	elseif InStr(szCode, "YM") = 1 then
		return true
	elseif InStr(szCode, "FDAX") = 1 then
		return true
	elseif InStr(szCode, "FESX") = 1 then
		return true
	elseif InStr(szCode, "ZN") = 1 then
		return true
	elseif InStr(szCode, "GC") = 1 then
		return true
	elseif InStr(szCode, "CL") = 1 then
		return true
	else
		return false
	end if
end function
'============================================================================
Sub Form_OnFormInit()
	g_szThemeCode = "00"
	g_nGrdIndex = 0
	Grid0.SetClear()
	
	Grid0.setSiseCtrlId("bd_cell0:bd_cell1:bd_cell2:bd_cell3")

	DATAMANAGER.CancelRealData("ohhts_ovdv_cntg")
	DATAMANAGER.RequestTranData( "ohhts_6500_003r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "ohhts_6500_003r" then
		
		if g_szThemeCode = "00" then
			g_szThemeCode = "10"
		elseif  g_szThemeCode = "10" then
			g_szThemeCode = "20"
		elseif  g_szThemeCode = "20" then
			g_szThemeCode = "30"
		elseif  g_szThemeCode = "30" then
			g_szThemeCode = "40"
		elseif  g_szThemeCode = "40" then
			g_szThemeCode = "50"
		elseif  g_szThemeCode = "50" then
			g_szThemeCode = "60"
		end if
		
		DATAMANAGER.SetDataValue( false, "ohhts_6500_003r", "InBlock1", "FID_PROD_CLCD" , 0 , g_szThemeCode )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_6500_003r" then
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_6500_003r", "OutBlock1")
		
		for i = 0 to nCnt-1
			szCode = DATAMANAGER.GetDataValue(0, "ohhts_6500_003r", "OutBlock1", "FID_OVDV_ISCD", i)
			bSelect = SelectItem(szCode)
			
			if bSelect = true then			
				Grid0.AddRow()
				szName = Form.GetItemCodeInfo(szCode, "name")
				szPrc  = DATAMANAGER.GetDataValue(0, "ohhts_6500_003r", "OutBlock1", "FID_OVDV_PRPR", i)
				szPrcAttr  = DATAMANAGER.GetDataAttr(0, "ohhts_6500_003r", "OutBlock1", "FID_OVDV_PRPR", i)
				
				szCtrt = DATAMANAGER.GetDataValue(0, "ohhts_6500_003r", "OutBlock1", "FID_PRDY_CTRT", i)
				szCtrtAttr  = DATAMANAGER.GetDataAttr(0, "ohhts_6500_003r", "OutBlock1", "FID_PRDY_CTRT", i)
				
				szSign = DATAMANAGER.GetDataValue(0,"ohhts_6500_003r", "OutBlock1", "FID_PRDY_VRSS_SIGN" , i)
				szJong= DATAMANAGER.GetDataValue(0, "ohhts_6500_003r", "OutBlock1", "FID_OVDV_PRDY_VRSS", i)
				szJongAttr  = DATAMANAGER.GetDataAttr(0, "ohhts_6500_003r", "OutBlock1", "FID_OVDV_PRDY_VRSS", i)
				
				Grid0.SetCellData("bd_cell0", g_nGrdIndex, szName)
				Grid0.SetCellData("bd_cell1", g_nGrdIndex, szPrc)
				
				'20200610 HWG START : 현재가 등락 색상표시 오류 수정
				if szSign == "2" then
					Grid0.SetCellFgColor("bd_cell1", g_nGrdIndex, 1)
				elseif szSign == "5" then
					Grid0.SetCellFgColor("bd_cell1", g_nGrdIndex, 2)
				else
					Grid0.SetCellFgColor("bd_cell1", g_nGrdIndex, 3)
				end if
				'20200610 HWG END
				
				'Grid0.SetCellAttrColor("bd_cell1", g_nGrdIndex, szPrcAttr)
				Grid0.SetCellData("bd_cell2", g_nGrdIndex, szSign&"|"&trim(szJong))
				'Grid0.SetCellAttrColor("bd_cell2", g_nGrdIndex, szJongAttr)
				Grid0.SetCellData("bd_cell3", g_nGrdIndex, szCtrt)
				'Grid0.SetCellAttrColor("bd_cell3", g_nGrdIndex, szCtrtAttr)
				Grid0.SetCellData("bd_cell4", g_nGrdIndex, szCode)
				
				g_nGrdIndex = g_nGrdIndex + 1
			end if
		next
		
		if DATAMANAGER.IsMoreNextData("ohhts_6500_003r") = true then
			
			DATAMANAGER.RequestNextData("ohhts_6500_003r")
		else
			if g_szThemeCode <> "00" then
				DATAMANAGER.RequestTranData("ohhts_6500_003r")
			    if g_szThemeCode == "60" then
				    g_szThemeCode = "00"
					DATAMANAGER.RequestRealData("ohhts_ovdv_cntg")
				end if
			end if
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if szTranID = "ohhts_ovdv_cntg" then
		Dim szCode
		for i = 0 to Grid0.rowcount - 1
			szCode = Grid0.GetCellData("bd_cell4", i)
			DATAMANAGER.SetDataValue( 1, "ohhts_ovdv_cntg", "InBlock1", "FID_OVDV_ISCD" , i ,  szCode)
		next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if Trim(szSubMsg) <> "" then
		 Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	else
		 Form.ShowAlert("알림", szErrMsg)
	end if
	
	g_szThemeCode = "00"
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID = "ohhts_ovdv_cntg" then
		szCode	= DATAMANAGER.GetDataValue(1, "ohhts_ovdv_cntg", "OutBlock1", "FID_OVDV_ISCD", 0)
		szPrpr 	= DATAMANAGER.GetDataValue(1, "ohhts_ovdv_cntg", "OutBlock1", "FID_OVDV_PRPR", 0)
		szOvdvBit	=	DATAMANAGER.GetDataValue(1, "ohhts_ovdv_cntg", "OutBlock1", "FID_PRDY_VRSS_SIGN", 0)
		szOvdvAmt	=	DATAMANAGER.GetDataValue(1, "ohhts_ovdv_cntg", "OutBlock1", "FID_OVDV_PRDY_VRSS", 0)
		szOvdvRatio	=	DATAMANAGER.GetDataValue(1, "ohhts_ovdv_cntg", "OutBlock1", "FID_PRDY_CTRT", 0)
		
		nCnt = Grid0.rowcount
		
		for i = 0 to nCnt - 1
			szCompCd = Grid0.GetCellData("bd_cell4", i)
			
			if szCode = szCompCd then
				Grid0.SetCellData("bd_cell1", i, szPrpr)
				
				'20200610 HWG START : 현재가 등락 색상표시 오류 수정
				if szOvdvBit == "2" then
					Grid0.SetCellFgColor("bd_cell1", i, 1)
				elseif szOvdvBit == "5" then
					Grid0.SetCellFgColor("bd_cell1", i, 2)
				else
					Grid0.SetCellFgColor("bd_cell1", i, 3)
				end if
				'20200610 HWG END
				
				Grid0.SetCellData("bd_cell2", i, szOvdvBit&"|"&trim(szOvdvAmt))
				Grid0.SetCellData("bd_cell3", i, szOvdvRatio)
			end if
		next
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub

