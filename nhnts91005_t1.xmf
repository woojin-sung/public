'============================================================================

'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sScreenKey 			'앱실행시첫화면
Dim g_sSideChangeKey 		'사이드종목변경버튼
Dim g_sThemeKey 			'스킨설정
Dim g_sTextSizeKey 		'글자크기
Dim g_sCurTouchKey 		'현재가터치이동
Dim g_sAutoLogoutKey 		'자동로그아웃
Dim g_sKeepLightKey 		'화면자동꺼짐방지
Dim g_sInterestCloudKey 	'관심종목동기화
Dim g_OS_Type			 	'OS타입(Android("1") iOS("2"))
Dim g_sBackgroundRunKey 	'백그라운드 앱종료 방지기능 추가

Dim G_SCREENCHOICE_FILE 	'선택화면팝업
Dim G_TICKERCHOICE_FILE 	'지수티커팝업

Dim DEF_ROW_SCREEN_KEY  	
	DEF_ROW_SCREEN_KEY = 1
Dim DEF_ROW_TEXTSIZE_KEY	
	DEF_ROW_TEXTSIZE_KEY = 2
Dim DEF_ROW_AUTOLOGOUT_KEY
	DEF_ROW_AUTOLOGOUT_KEY	= 4
Dim DEF_ROW_KEEPLIGHT_KEY
	DEF_ROW_KEEPLIGHT_KEY = 5
Dim DEF_ROW_INTRCLOUD_KEY
	DEF_ROW_INTRCLOUD_KEY = 7
Dim DEF_ROW_BACKGROUND_KEY
	DEF_ROW_BACKGROUND_KEY = 8
Dim DEF_ROW_MASTERUPDATE
	DEF_ROW_MASTERUPDATE = 9
Dim DEF_ROW_CONFINIT
	DEF_ROW_CONFINIT = 10
Dim DEF_ROW_VERSIONINFO
	DEF_ROW_VERSIONINFO = 11

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' 환경설정초기화함수
'============================================================================
Function SetInitData()
	Cont0.Table0.SetCellString( DEF_ROW_SCREEN_KEY, 		1, "해외시장종합" )	'앱실행시 첫화면
	Cont0.Table0.SetCellString( DEF_ROW_TEXTSIZE_KEY, 	1, "32" )			'글자크기
	Cont0.Table0.SetCellString( DEF_ROW_AUTOLOGOUT_KEY, 	1, "1시간" )			'자동로그아웃
	Cont0.Table0.SetCellString( DEF_ROW_KEEPLIGHT_KEY, 	1, "사용" )			'화면자동꺼짐방지
	Cont0.Table0.SetCellString( DEF_ROW_INTRCLOUD_KEY, 	1, "사용" )			'관심종목동기화
	Cont0.Table0.SetCellString( DEF_ROW_BACKGROUND_KEY, 	1, "미사용" )			'백그라운드앱실행유지
	
	SetFgColor(DEF_ROW_SCREEN_KEY, 		1)
	SetFgColor(DEF_ROW_TEXTSIZE_KEY, 	1)
	SetFgColor(DEF_ROW_AUTOLOGOUT_KEY, 	1)
	SetFgColor(DEF_ROW_KEEPLIGHT_KEY, 	1)
	SetFgColor(DEF_ROW_INTRCLOUD_KEY, 	1)
	SetFgColor(DEF_ROW_BACKGROUND_KEY, 	1)
	
	Form.SetEnvData(1, g_sScreenKey, 		"0")			'앱실행시 첫화면
	Form.SetEnvData(1, g_sTextSizeKey, 		"0")			'글자크기
	Form.SetEnvData(1, g_sAutoLogoutKey, 	"60")		'자동로그아웃
	Form.SetEnvData(1, g_sKeepLightKey, 		1)			'화면자동꺼짐방지
	Form.SetEnvData(1, g_sInterestCloudKey, 	"1")			'관심종목동기화
	
	'1.안드로이드 2.iOS
	if Form.GetSharedData("&OS_TYPE", False ) <> "2" then
		Form.SetEnvData(1, g_sBackgroundRunKey, False)	'백그라운드앱실행유지	
		Form.SendMessageToMain("BACKGROUND_RUN", "", "")	
	end if
End Function 

'============================================================================
' 환경설정값리턴함수
'============================================================================
Function GetConfigData(sKey, nRow, nCol)
	Dim sValue
	sValue = Form.GetEnvData(sKey)
	
	if sValue == null or Trim(sValue) == "" then
		if sKey == g_sThemeKey then
			sValue = "white"					'테마			: 기본값 white
		elseif sKey == g_sAutoLogoutKey then
			sValue = "60" 					'자동로그아웃		: 기본값 60
		elseif sKey == g_sInterestCloudKey then 
			sValue = "1" 						'관심종목동기화	: 기본값 1
		elseif sKey == g_sKeepLightKey then
			sValue = true 					'화면자동꺼짐방지	: 기본값 true
		else
			sValue = "0" 						'기타			: 기본값 0
		end if
	end if
	
	if sKey == g_sScreenKey then				'앱실행시 첫화면
		if sValue == "0" then
			sValue = "해외시장종합"
		elseif sValue == "1" then
			sValue = "해외파생관심"
		elseif sValue == "2" then
			sValue = "해외파생주문"
		elseif sValue == "3" then
			sValue = "해외파생차트"
		elseif sValue == "4" then
			sValue = "해외파생잔고"
		elseif sValue == "5" then
			sValue = "해외주식관심"
		elseif sValue == "6" then
			sValue = "해외주식주문"
		elseif sValue == "7" then
			sValue = "해외주식차트"
		elseif sValue == "8" then
			sValue = "야간선옵주문"
		elseif sValue == "9" then
			sValue = "야간선옵차트"
		else
			sValue = "해외시장종합"
		end if
		
	elseif sKey == g_sSideChangeKey then			'사이드종목변경버튼
		if sValue == "0" then
			sValue = "오른쪽"
		elseif sValue == "1" then
			sValue = "왼쪽"
		else
			sValue = "미사용"
		end if

		Form.SendMessageToMain("CONFIG_CHANGE", "", "")
		
	elseif sKey == g_sThemeKey then				'테마
		if sValue == "white" then
			sValue = "화이트"
		else
			sValue = "블랙"
		end if
		
	elseif sKey == g_sTextSizeKey then			'글자크기
		if sValue == "-2" then
			sValue = "28"
		elseif sValue == "-1" then
			sValue = "30"
		elseif sValue == "0" then
			sValue = "32"
		elseif sValue == "1" then
			sValue = "34"
		else
			sValue = "36"
		end if
		
	elseif sKey == g_sCurTouchKey then			'현재가 터치이동
		if sValue == "0" then
			sValue = "최근조회종목"
		elseif sValue == "1" then
			sValue = "관심종목"
		elseif sValue == "2" then
			sValue = "watching 등록종목"
		else
			sValue = "업종조회"
		end if
		
	elseif sKey == g_sAutoLogoutKey then			'자동로그아웃
		if sValue == "10" then
			sValue = "10분"
		elseif sValue == "30" then
			sValue = "30분"
		elseif sValue == "60" then
			sValue = "1시간"
		elseif sValue == "120" then
			sValue = "2시간"
		elseif sValue == "180" then
			sValue = "3시간"
		elseif sValue == "360" then
			sValue = "6시간"
		else
			sValue = "10시간" 
		end if
		
	elseif sKey == g_sKeepLightKey or sKey == g_sInterestCloudKey then	'화면자동꺼짐방지
		if sValue == true or sValue == "1" or sValue == 1 then
			sValue = "사용"
		else
			sValue = "미사용"
		end if
		
	elseif sKey == g_sBackgroundRunKey then		'백그라운드앱실행유지
		if sValue == true or sValue == "1" or sValue == 1 then
			sValue = "사용"
		else
			sValue = "미사용"
		end if
	end if
	
	Cont0.Table0.SetCellString( nRow, nCol, sValue )
	
	if sValue == "미사용" then
		Cont0.Table0.SetCellFgColor( nRow, nCol, "4" )
	else
		Cont0.Table0.SetCellFgColor( nRow, nCol, "128" )
	end if
	
	if nRow == DEF_ROW_BACKGROUND_KEY and Form.GetSharedData("&OS_TYPE", False ) == "2" then
		Cont0.Table0.SetCellFgColor( nRow, 1, "17" )
	end if
End Function 

'============================================================================
' 환경설정값세팅함수
'============================================================================
Function SetConfigData(sKey, nRow, nCol)
	Dim sValue
	sValue = Cont0.Table0.GetCellString( nRow, nCol )

	if sKey == g_sInterestCloudKey then		''관심종목동기화
		if sValue == "사용" then
			sValue = "0"
		else
			sValue = "1"
		end if
		
		Form.SetEnvData(1, sKey, sValue)
		
	elseif sKey == g_sKeepLightKey then		'화면자동꺼짐방지
		if sValue == "사용" then
			sValue = false  
		else
			sValue = true
		end if
		
		Form.SetEnvData(0, sKey, sValue)
	
	elseif sKey == g_sBackgroundRunKey then	'백그라운드앱실행유지
		if sValue == "사용" then
			sValue = false
		else
			sValue = true
		end if
		
		Form.SetEnvData(1, sKey, sValue)
		Form.SendMessageToMain("BACKGROUND_RUN", "", "")
	end if
End Function 

'============================================================================
' 글자색상함수
'============================================================================
Function SetFgColor(nRow, nCol)
	Dim sValue
	sValue = Cont0.Table0.GetCellString( nRow, nCol )
	
	if sValue == "미사용" then
		Cont0.Table0.SetCellFgColor( nRow, nCol, "4" )
	else
		Cont0.Table0.SetCellFgColor( nRow, nCol, "128" )
	end if
	
	if nRow == DEF_ROW_BACKGROUND_KEY and Form.GetSharedData("&OS_TYPE", False ) == "2" then
		Cont0.Table0.SetCellFgColor( nRow, 1, "17" )
	end if
End Function 

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	G_SCREENCHOICE_FILE 	= "nhnts91005_p3"
	G_TICKERCHOICE_FILE 	= "nhnts91005_p4"
	
	g_sScreenKey 			= "common.start_screen"
	g_sSideChangeKey 		= "common.side_modify"
	g_sThemeKey 			= "common.theme"
	g_sTextSizeKey 		= "common.textsize"
	g_sCurTouchKey 		= "common.curtouch_swing"
	g_sAutoLogoutKey 		= "common.autologout"
	g_sKeepLightKey 		= "common.keep_light"
	g_sInterestCloudKey 	= "common.interest_cloud"
	
	g_sBackgroundRunKey 	= "common.background_run"
	

	GetConfigData(g_sScreenKey, 		DEF_ROW_SCREEN_KEY, 		1)	'앱실행시 첫화면
	GetConfigData(g_sTextSizeKey, 		DEF_ROW_TEXTSIZE_KEY, 		1)	'글자크기
	GetConfigData(g_sAutoLogoutKey, 	DEF_ROW_AUTOLOGOUT_KEY, 	1)	'자동로그아웃
	GetConfigData(g_sKeepLightKey, 		DEF_ROW_KEEPLIGHT_KEY, 	1)	'화면자동꺼짐방지
	GetConfigData(g_sInterestCloudKey, 	DEF_ROW_INTRCLOUD_KEY, 	1)	'관심종목동기화
	
	if Form.GetSharedData("&OS_TYPE", False ) <> "2" then
		GetConfigData(g_sBackgroundRunKey, DEF_ROW_BACKGROUND_KEY, 1) 	'백그라운드앱실행유지
	else
		Cont0.Table0.SetCellString( DEF_ROW_BACKGROUND_KEY,  1, "미사용" )
		Cont0.Table0.SetCellFgColor( DEF_ROW_BACKGROUND_KEY, 1, "17" )
	end if
	'20180607 HAMWG END
	
	Dim sVersion
	sVersion = Form.GetSharedData("&APP_VERSION", false )
	g_OS_Type = Form.GetSharedData("&OS_TYPE", false )    '20170904_03 LKM 	

	Cont0.Table0.SetCellString( DEF_ROW_VERSIONINFO, 1, "VER "..sVersion )
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "updateiOS" then
		if sRet == "close" then
			Form.reUpdateFile("mts_master.crc")
		end if
		
	elseif sKeyName == "updateAndroid" then
		if sRet == "ok" then
			Form.reUpdateFile("mts_master.crc")
		end if
		
	elseif sKeyName == "clear" then
		if sRet == "ok" then
			SetInitData()
		end if
		
	elseif sKeyName == "UPDATE_MTS" then
		if sRet == "ok" then
			nDev = Form.GetSharedData("&SERVER_MODE", 0 )
			if nDev == "1" then
				bRtn = Form.runStoreApp("", "http://211.201.184.87/meritzmts")
			else
				bRtn = Form.runStoreApp("", "market://details?id=com.imeritz.smartmints")
			end if		
		end if
		
	elseif sKeyName == "NOTI_MTS" then
		if sRet == "ok" then
			SetConfigData(g_sBackgroundRunKey, DEF_ROW_BACKGROUND_KEY, 1)
			GetConfigData(g_sBackgroundRunKey, DEF_ROW_BACKGROUND_KEY, 1)
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == G_SCREENCHOICE_FILE or sKeyName == G_TICKERCHOICE_FILE then
		if sRet == g_sScreenKey then
			GetConfigData(g_sScreenKey, DEF_ROW_SCREEN_KEY, 1)		'앱실행시 첫화면
			
		elseif sRet == g_sTextSizeKey then	
			GetConfigData(g_sTextSizeKey, DEF_ROW_TEXTSIZE_KEY, 1)		'글자크기
			
		elseif sRet == g_sAutoLogoutKey then
			GetConfigData(g_sAutoLogoutKey, DEF_ROW_AUTOLOGOUT_KEY, 1)	'자동로그아웃
			
'		elseif sRet == g_sSideChangeKey then
'			GetConfigData(g_sSideChangeKey, 2, 1)
'		elseif sRet == g_sThemeKey then
'			GetConfigData(g_sThemeKey, 4, 1)
'		elseif sRet == g_sCurTouchKey then
'			GetConfigData(g_sCurTouchKey, 3, 1)		'현재가 터치이동
			
		end if
	end if
End Sub

'============================================================================
Sub Cont0_Table0_OnClick(lRow , lColumn)
	'색상있는 영역 클릭시에만 이벤트 처리
	if lColumn == 1 then
	
		if lRow == DEF_ROW_SCREEN_KEY then '앱실행시첫화면
			Form.OpenPopup(G_SCREENCHOICE_FILE , g_sScreenKey, "")
		
		elseif lRow == DEF_ROW_TEXTSIZE_KEY then '글자크기
			Form.OpenPopup(G_SCREENCHOICE_FILE , g_sTextSizeKey, "")
		
		elseif lRow == DEF_ROW_AUTOLOGOUT_KEY then '자동로그아웃
			Form.OpenPopup(G_SCREENCHOICE_FILE , g_sAutoLogoutKey, "")
		
		elseif lRow == DEF_ROW_KEEPLIGHT_KEY then '화면자동꺼짐방지
			SetConfigData(g_sKeepLightKey, lRow, 1)
			GetConfigData(g_sKeepLightKey, lRow, 1)
		
		elseif lRow == DEF_ROW_INTRCLOUD_KEY then '관심종목동기화
			SetConfigData(g_sInterestCloudKey, lRow, 1)
			GetConfigData(g_sInterestCloudKey, lRow, 1)
			
		elseif lRow == DEF_ROW_BACKGROUND_KEY then '백그라운드 앱종료 방지
			if Form.GetSharedData("&OS_TYPE", False ) <> "2" then
			    
			    szUseBack = Cont0.Table0.GetCellString( lRow, 1 )
			    			    
			    if szUseBack == "미사용" then
					Form.MsgBox("알림", "백그라운드 앱 실행유지 기능을 사용하시면 알림창에 'MINTs mobile' 이 항상 표시됩니다.\n\n백그라운드 앱 실행유지 기능을 사용하시겠습니까?", "NOTI_MTS", "1")
				else
					SetConfigData(g_sBackgroundRunKey, lRow, 1)
					GetConfigData(g_sBackgroundRunKey, lRow, 1)
				end if
			else
				Cont0.Table0.SetCellString( lRow, 1, "미사용" )
				Cont0.Table0.SetCellFgColor( lRow, 1, "17" )
				Form.MsgBox("알림", "아이폰(IOS 단말기)에선\n사용할 수 없는 기능입니다.", "", "0")
			end if
			
		'elseif lRow == 3 then '현재가터치이동
			'Form.OpenPopup(G_SCREENCHOICE_FILE , g_sCurTouchKey, "")
			
		end if
	end if
End Sub

