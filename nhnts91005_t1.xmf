'============================================================================
'20180607 HAMWG START : 백그라운드 앱종료 방지기능 추가
'============================================================================
Sub Cont0_Image10_OnClick()
	if Form.GetSharedData("&OS_TYPE", False ) <> "2" then
	    szUseBack = Cont0.Table0.GetCellString( DEF_ROW_BACKGROUND_KEY, 1 )
				    
	    if szUseBack == "미사용" then
			Form.MsgBox("알림", "백그라운드 앱 실행유지 기능을 사용하시면 알림창에 'MINTs mobile' 가 항상 표시됩니다.\n\n백그라운드 앱 실행유지 기능을 사용하시겠습니까?", "NOTI_MTS", "1")
		else
			SetConfigData(g_sBackgroundRunKey, DEF_ROW_BACKGROUND_KEY, 1)
			GetConfigData(g_sBackgroundRunKey, DEF_ROW_BACKGROUND_KEY, 1)
		end if
	else
		Cont0.Table0.SetCellString( DEF_ROW_BACKGROUND_KEY, 1, "미사용" )
		Cont0.Table0.SetCellFgColor( DEF_ROW_BACKGROUND_KEY, 1, "17" )
		Form.MsgBox("알림", "아이폰(IOS 단말기)에선\n사용할 수 없는 기능입니다.", "", "0")
	end if
End Sub

'============================================================================
' 종목코드 업데이트 다운로드 실행
'============================================================================
Sub Cont0_Button0_OnClick()
	Dim sOS_TYPE
	sOS_TYPE = Form.GetSharedData("&OS_TYPE", false ) 'iOS("2")Android("1")
	
	if sOS_TYPE == "1" then
		Form.MsgBox( "알림", "프로그램 재구동 시 종목코드 업데이트가 진행됩니다. 재구동하시겠습니까?", "updateAndroid", 1 )
	else	
		Form.MsgBox( "알림", "프로그램 재구동 시 종목코드 업데이트가 진행됩니다. 재구동해주십시오.", "updateiOS", 6 )
	end if
End Sub

