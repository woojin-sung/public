	<SCRIPT_INFO _len="1830" _ulen="1746" >
--===========================================================================
--===========================================================================

'============================================================================
Sub Form_OnFormInit()
	
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	ImgNoti.SetMaintainingRatio("1")
	
	Dim szData, arrData,szToday
	 
	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"☆")
	szToday = Form.GetSharedData("&HOST_DATE", false )
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	lblRPName.caption = arrData(0)
	
	tblMaesu.SetCellString( 0, 1, arrData(1) )'매입금액
	tblMaesu.SetCellString( 1, 1, arrData(2) )'약정이율
	tblMaesu.SetCellString( 2, 1, arrData(3) )'매수일
	tblMaesu.SetCellString( 3, 1, arrData(4) )'만기일
	
	tblMaedo.SetCellString( 0, 1, szToday )'매도일
	tblMaedo.SetCellString( 1, 1, arrData(5) )'적용이율
	tblMaedo.SetCellString( 3, 1, arrData(6) - arrData(7) - arrData(8) )'매도신청금액
	tblMaedo.SetCellString( 4, 1, arrData(7) )'이자
	tblMaedo.SetCellString( 5, 1, arrData(8) )'세금합계
	tblMaedo.SetCellString( 7, 1, arrData(9) )'정산금액
	
	Label4.caption = arrData(10) & arrData(11) '계좌번호
End Sub


'============================================================================
Sub btnClose_OnClick()
	Form.PostLinkData("71052_p4", "refresh")
	Form.CloseForm()
End Sub

'============================================================================
Sub ImgNoti_OnClick()
	Form.OpenPopupAnimation("mbfnp55020_p3", "" , "","2") 
End Sub


'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "RP_MAEDO_COMPLETE" , "" )
End Sub

