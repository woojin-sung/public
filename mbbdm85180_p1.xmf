	<SCRIPT_INFO _len="2289" _ulen="2221" >
'============================================================================
' 2021.10.28: 김수진 : 계좌개설 완료 추가 안내
'============================================================================
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
'Form_OnFormInit()  
'============================================================================
Sub Form_OnFormInit()
	Dim szInfoNum 
	szInfoNum = Form.GetOpenLinkData()
	Dim szIsaAcntOpngClcd			
	szIsaAcntOpngClcd	= Form.GetSharedData("BDM_ISA_ACNT_OPNG_CLCD"    , False )	
	
	If szInfoNum == "2" Then
		imgBox.height = 453
		imgBox.top = 90
		lblTitle.top = 90
		imgBgTitle.top = 105
		imgClose.top = 105
		
		ContISAType1.top = 350
		btnNext.top= 484

		If szIsaAcntOpngClcd == "2" then	'CFD + 중개형ISA(이수)
			tblInfo0.visible = true
			tblInfo1.visible = false
			ContISAType1.visible = false
		Else								'CFD + 중개형ISA(신규)
			tblInfo0.visible = false
			tblInfo1.visible = true
			ContISAType1.visible = true
		End If
	Else	
		imgBox.height = 265	'중개형ISA(신규)
		imgBox.top = 200
		lblTitle.top = 200
		imgClose.top = 215
		imgBgTitle.top = 215
		
		ContISAType1.top = 275
		btnNext.top= 405
		tblInfo0.visible = false
		tblInfo1.visible = false
		ContISAType1.visible = true
	End If 
	
	imgBg.imgpath = "alpha128.png"
End Sub

'============================================================================
' imgBg_OnClick() : 닫기
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
' imgClose_OnClick() : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
' btnNext_OnClick() : 닫기
'============================================================================
Sub btnNext_OnClick()
	Form.CloseForm()	
End Sub

	</SCRIPT_INFO>
