'============================================================================
' 01.화면명 	: 운용보고서선택 팝업
' 02.화면설명	: 펀드매매_신규매수_운용보고서선택 팝업
' 03.작성	: 2022.03.21 KSJ
' 04.수정	:		
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcno			'계좌번호
Dim g_szPwd			'비밀번호
Dim g_szSelectAddr	'선택된주소

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	tblAddr.enable = false
	
	Dim szLinkedData, tList
	szLinkedData = Form.GetOpenLinkData( )
	
	'계좌번호/비밀번호
	tList = Split(szLinkedData,"★")
	
	If UBOUND(tList) < 1 Then
		Exit Sub
	End If
		
	g_szAcno		= ""
	g_szPwd  	= ""
	g_szSelectAddr = ""	'2022.03.28
	
	If Trim(tList(0)) <> "" and Trim(tList(1)) <> "" and Trim(tList(2)) <> ""Then
		g_szAcno		= tList(0)
		g_szPwd		= tList(1)
	
		'2022.03.28
		If tonumber(tList(2)) < 4 Then
			g_szSelectAddr = tList(2)
			tblAddr.SetCellFgColor( g_szSelectAddr, 0, 265 )
		End If
		DATAMANAGER.RequestTranData( "obcsb_acad_002r" )
	End If
End Sub
'============================================================================
' imgClose_OnClick() : 운용보고서 선택 & 화면 닫기
'============================================================================
Sub tblAddr_OnClick(lRow , lColumn)
	If lRow <> 3 Then
		Dim szAddr
		szAddr = tblAddr.GetCellString( lRow, 1 )
		
		If szAddr <> null and szAddr <> "" Then
			g_szSelectAddr = lRow
			Form.CloseForm()
		End If
	Else
		g_szSelectAddr = lRow
		Form.CloseForm()
	End If
End Sub

'============================================================================
' imgClose_OnClick() : 화면 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
' Form_OnFormClose()
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbfnp51010_p14" , g_szSelectAddr)
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obcsb_acad_002r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 	, 0 , g_szAcno 	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD" 	, 0 , g_szPwd 	)	
	End If 
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obcsb_acad_002r" Then
		'주소정보
		Dim nCnt, szAddr
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock1" )
		
		If nCnt > 0 then
			for i = 0 to nCnt-1
				szINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "INAG_TYPE_CODE" , i )
				szAddr = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "ADDR" , i )
				
				'테이블에 문자열 셋팅할 경우 멀티라인이 되지 않아 라벨 컨트롤 사용
				If szINAG_TYPE_CODE == "01" then 		'자택
					tblAddr.SetCellString(0, 1, szAddr)
					lblAddrHome.caption = szAddr
				ElseIf szINAG_TYPE_CODE == "02" then 	'직장
					tblAddr.SetCellString(1, 1, szAddr)
					lblAddrOffice.caption = szAddr
				ElseIf szINAG_TYPE_CODE == "21" then 	'E-mail
					tblAddr.SetCellString(2, 1, szAddr)
					lblAddrEmail.caption = szAddr
				End If
			Next
			tblAddr.enable = true
		End If 
	End If 
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	If szTranID == "obcsb_acad_002r" Then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_acad_002r" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")	
	End If
End Sub 



