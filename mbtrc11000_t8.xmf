	<SCRIPT_INFO _len="5449" _ulen="5267" >
'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'"":전체, 1:매수, 2:매도
Dim g_nAryAmt			'매입금액
Dim g_nAryExcl		'매도월정산금액
Dim g_nAryExclPrls	'매도월정산손익
			
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub Init_TR()
	cont0.grd0.SetClear()
	
	DATAMANAGER.RequestTranData("obtrc_comm_231r")
	DATAMANAGER.RequestTranData("obtrc_comm_232r")

End Sub

'============================================================================
''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************
''============================================================================
Sub Form_OnFormInit()
	cont0.grd1.setUseCardView(true, 10, "img_bgbox_gray.9")
	cont0.grd1.SetCellData("bd_cell0", 0, "매입금액")
	cont0.grd1.SetCellData("bd_cell2", 0, "월정산금액")
	
	cont0.grd1.scrollenable = "0"
	cont0.setScrollBarVisible("0") 
	
	Init_TR()

End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "RECEIVE" or sEventName == "CHANGE_ACCTNO" then
		Init_TR()
		
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	cont0.imgCmb.setMaintainingRatio("1")
End Sub

'============================================================================
Sub cont0_lblGubun_OnClick()
	cont0.cmbGubun.OpenList()
End Sub

'============================================================================
Sub cont0_cmbGubun_OnEditComplete(iIndex)
	cont0.lblGubun.caption = cont0.cmbGubun.caption
	Init_TR()

End Sub

'============================================================================
Sub cont0_cldFrom_OnEditComplete()
	Init_TR()
End Sub

'============================================================================
Sub cont0_cldTo_OnEditComplete()
	Init_TR()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNO, szASNO, szStnd
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
	szDeal = cont0.cmbGubun.cbkeydata
	
	if szTranID = "obtrc_comm_232r" then	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "IQRY_STND_COD" , 0 , "2")		'1:월정산평가월 2:월정산결제월
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "DEAL_CLS_CODE" , 0 , szDeal)		'빈값:전체, "1":매도, "2":매수
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , szACNO)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" , 0 , szASNO)
	
	Elseif szTranID = "obtrc_comm_231r" then	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "IQRY_STND_COD" , 0 , "2")		'1:월정산평가월 2:월정산결제월
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "DEAL_CLS_CODE" , 0 , szDeal)		'빈값:전체, "1":매도, "2":매도
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , szACNO)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" , 0 , szASNO)
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obtrc_comm_232r" Then
		If DATAMANAGER.IsMoreNextData(szTranID) = True then
			DATAMANAGER.RequestNextData(szTranID)
		Else
'			
			for i = 0 to CDbl(cont0.grd0.rowcount) - 1
				szGubun = cont0.grd0.GetCellData("bd_gubun", i)
				if szGubun = "1" then	'매도
					cont0.grd0.SetCellFgColor("bd_cell2", i, "11")
				else					'매수
					cont0.grd0.SetCellFgColor("bd_cell2", i, "10")
				end if

			next
			
			if CInt(cont0.grd0.rowcount) > 0 then
				cont0.grd0.left = 10
				cont0.lblNone.caption = ""
			else
				cont0.grd0.left = 1000
				cont0.lblNone.caption = "정산내역이 없습니다."
			end if
			
		End if
		
	ElseIf szTranID = "obtrc_comm_231r" Then
		nPrls = CDbl(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CFD_VLTN_PRLS_AMT" , 0))
		if nPrls > 0 then
			cont0.LblTotal.fgcolor = "10"
			cont0.LblTotal.caption = "+"..FormatNumber(nPrls, 0).."원"
		elseif nPrls < 0 then
			cont0.LblTotal.fgcolor = "11"
			cont0.LblTotal.caption = FormatNumber(nPrls, 0).."원"
		else
			cont0.LblTotal.fgcolor = "12"
			cont0.LblTotal.caption = FormatNumber(nPrls, 0).."원"
		end if
	
	End if
		
End Sub

''============================================================================
'Sub cont0_FormTab0_OnTabChanged(nCurrentTab)
'	Init_TR()
'End Sub
'
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
End Sub
'============================================================================
Sub cont0_imgCmb_OnClick()
	cont0.cmbGubun.OpenList()
End Sub


	</SCRIPT_INFO>
