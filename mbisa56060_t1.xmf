'============================================================================
Sub SetCtrlEnable()
	cont0.chk3.enable = g_bCtrlEnable
	
	If g_bCtrlEnable == False then
		cont0.chk1.enable = g_bCtrlEnable
	End If
	
	cont0.chk2.enable = g_bCtrlEnable
	
	cont0.btnWatch.enable = g_bCtrlEnable
	cont0.btnDetail.enable = g_bCtrlEnable
	cont0.btnType.enable = g_bCtrlEnable
	cont0.btnTax0.enable = g_bCtrlEnable
	cont0.btnTax1.enable = g_bCtrlEnable
	
	'cont0.edtNum0.enable = g_bCtrlEnable
	'cont0.edtNum1.enable = g_bCtrlEnable
	'cont0.edtNum2.enable = g_bCtrlEnable
	'cont0.edtNum3.enable = g_bCtrlEnable
	cont0.edtNum4.enable = g_bCtrlEnable
	cont0.edtNum5.enable = g_bCtrlEnable
	cont0.edtNum6.enable = g_bCtrlEnable
	cont0.edtNum7.enable = g_bCtrlEnable
	
	cont0.rdoPaper.enable = g_bCtrlEnable
	cont0.btnOK.enable = g_bCtrlEnable
	
	'20210311 SWJ START : 비디오 시청완료 시 비밀번호 입력 후 체크처리
	 if g_bCtrlEnable = True then
		 g_vplayTime = Form.LoadConfigData("VideoPlaying", "TimeSave"..g_timeDate..g_UserID)
  
		  if Cint(g_vplayTime) >= 300000 then
			   cont0.chk0.checkstate = "1"
			   cont0.chk1.enable = True
		  end if
		  
		  '20210312_01 SWJ START : 이어가기 데이터 세팅
			sTemp = acnt0.total.."★"..acnt0.sequence.."★"..Form.GetCtlProp("edtPwd", "caption")
			Form.triggerEvent("#", "DECIDE_STEP", sTemp)
		  '20210312_01 SWJ END
	 end if
	 '20210311 SWJ END   
	 
End Sub

'============================================================================
Sub ClearAllData()
	g_bInqrOK = False
	g_bJoinChkOK = False
	g_sCSNO = ""
	g_sHomeAddr = ""
	g_sCoAddr = ""
	g_sTel = ""
	g_sEMail = ""
	g_sMinAmt = ""
	g_sWatchDate = ""
	g_sWatchTime = ""
	g_sType = "-1"
	
	edtPwd.caption = ""
	cont0.tbl1.SetCellString( 0, 0, "")
	cont0.tbl0.SetCellString( 0, 0, "")
	
	'cont0.btnOK.enable = True
	
	cont0.chk3.checkstate = "0"
	cont0.chk0.checkstate = "0"
	cont0.chk1.checkstate = "0"
	cont0.chk2.checkstate = "0"
	
	'cont0.edtNum0.caption = ""
	'cont0.edtNum1.caption = ""
	'cont0.edtNum2.caption = ""
	'cont0.edtNum3.caption = ""
	cont0.edtNum4.caption = ""
	cont0.edtNum5.caption = ""
	cont0.edtNum6.caption = ""
	cont0.edtNum7.caption = ""
	
	cont0.rdoPaper.currentindex = 0
	
	Form.triggerEvent("#", "CHANGE_ACCOUNT", "1")
End Sub


'============================================================================
'서민형인 경우만 소득확인증명서 입력
Sub SetDocNumEnable(bYN)

'	cont0.edtNum4.enable = bYN
'	cont0.edtNum5.enable = bYN
'	cont0.edtNum6.enable = bYN
'	cont0.edtNum7.enable = bYN
	
	If bYN = False then
		cont0.edtNum4.caption = ""
		cont0.edtNum5.caption = ""
		cont0.edtNum6.caption = ""
		cont0.edtNum7.caption = ""
	End If
	
	
End Sub

'============================================================================
'20210312 HSZ START: 서민형/처음 화면에서 가입서류 발급번호, 서류제출 방법 선택 숨기기
Sub PaperShownHide(bTF)
	if g_Ostype = "1" then		'안드로이드
		if bTF = False then
			cont0.btnOK.top = 500
			cont0.rdoPaper.currentindex = 0
		elseif bTF = True then
			cont0.btnOK.top = 900
			cont0.rdoPaper.currentindex = 0
		end if
		
	elseif g_Ostype = "2" then
		if bTF = False then
			cont0.btnOK.top = 500
			cont0.rdoPaper.currentindex = 0
			
			cont0.tblTitle3.top = 300
			cont0.lbl2.top = 300
			cont0.lblDash3.top = 300
			cont0.lblDash4.top = 300
			cont0.lblDash5.top = 300
			cont0.tblTitle6.top = 300
			cont0.btnTax1.top = 300
			cont0.btnTax0.top = 300
			cont0.imgTax0.top = 300
			cont0.imgTax1.top = 300
			cont0.tblTitle5.top = 300
			cont0.rdoPaper.top = 300
			cont0.tbl3.top = 300
		
			cont0.edtNum4.top = 300
			cont0.edtNum5.top = 300
			cont0.edtNum6.top = 300
			cont0.edtNum7.top = 300
			
		elseif bTF = True then
			cont0.btnOK.top = 900
			cont0.rdoPaper.currentindex = 0
			
			cont0.tblTitle3.top = 500
			cont0.lbl2.top = 550
			cont0.lblDash3.top = 550			
			cont0.lblDash4.top = 550
			cont0.lblDash5.top = 550
			cont0.tblTitle6.top = 597
			cont0.btnTax1.top = 626
			cont0.btnTax0.top = 654
			cont0.imgTax0.top = 654
			cont0.imgTax1.top = 626
			cont0.tblTitle5.top = 696
			cont0.rdoPaper.top = 726
			cont0.tbl3.top = 726
		
			cont0.edtNum4.top = 550
			cont0.edtNum5.top = 550
			cont0.edtNum6.top = 550
			cont0.edtNum7.top = 550
		end if
	else
		exit sub
	end if

	cont0.tblTitle3.visible = bTF
	cont0.lbl2.visible = bTF
	cont0.lblDash3.visible = bTF
	cont0.lblDash4.visible = bTF
	cont0.lblDash5.visible = bTF
	cont0.tblTitle6.visible = bTF
	cont0.btnTax1.visible = bTF
	cont0.btnTax0.visible = bTF
	cont0.imgTax0.visible = bTF
	cont0.imgTax1.visible = bTF
	cont0.tblTitle5.visible = bTF
	cont0.rdoPaper.visible = bTF
	cont0.tbl3.visible = bTF

	cont0.edtNum4.visible = bTF
	cont0.edtNum5.visible = bTF
	cont0.edtNum6.visible = bTF
	cont0.edtNum7.visible = bTF
	
	cont0.SetScrollAutoSize()
'
End Sub
'20210312 HSZ END
'============================================================================
Function ValidateCheck()
	If g_bInqrOK == False or g_bJoinChkOK == False then
		Form.ShowAlert("알림", "비밀번호를 입력하세요.")
		return False
	End If
	
	If cont0.chk3.checkstate <> "1" then
		Form.ShowAlert("알림", "가입자 확인사항에 체크해주세요.")
		return False
	End If

	If cont0.chk0.checkstate <> "1" then
		Form.ShowAlert("알림", "ISA 교육 동영상을 시청해주세요.")
		return False
	End If
	
	If cont0.chk1.checkstate <> "1" then
		Form.ShowAlert("알림", "ISA 교육 동영상 보기 항목에 체크해주세요.")
		return False
	End If

	If cont0.chk2.checkstate <> "1" then
		Form.ShowAlert("알림", "ISA가입 필수안내사항을 확인해주세요.")
		return False
	End If
	
	If cont0.tbl0.GetCellString(0,0) == "" then
		Form.ShowAlert("알림", "가입자유형을 선택해 주세요.")
		return False
	End If
	
	'v0003. ISA 조특법 개정안 적용 sta
	'가입자유형이 청년형일 경우 연령이 30세 이상이면 가입불가 - 주석처리
'	If cont0.lblTypeCode.caption == "67" then	
'		If cont0.tbl1.GetCellString(0,0) <> "" then
'			If CDbl(cont0.tbl1.GetCellString(0,0)) >= 30 then							
'				Form.ShowAlert("알림", "만 30세 이상은 청년형 가입이 불가능합니다.")
'				return False
'			End If
'		End If
'	End If

	'일반형_청년, 서민형_청년의 나이 체크
	If cont0.lblTypeCode.caption == "67" or cont0.lblTypeCode.caption == "78" then	
		If cont0.tbl1.GetCellString(0,0) <> "" then
			If CDbl(cont0.tbl1.GetCellString(0,0)) < 15  OR CDbl(cont0.tbl1.GetCellString(0,0)) >= 19  then
				Form.ShowAlert("알림", "만 15세이상, 만 19세 미만 거주자만 가입이 가능합니다.")
				return False
			End If
		End If
	End If	
	
	'일반형(66) 체크시 만 19세 인지 체크
	If cont0.lblTypeCode.caption == "66" Then 
		If cont0.tbl1.GetCellString(0,0) <> "" then
			If CDbl(cont0.tbl1.GetCellString(0,0)) < 19  then
				Form.ShowAlert("알림", "만 19세이상 거주자만 가입이 가능합니다.")
				return False
			End If
		End If
	End If
	'v0003. fin

	'v0003. 일반형은 소득금액증명원 미입력 -> 2020.12.17 요건변경. 증명원 삭제 (주석처리)
'	If cont0.lblTypeCode.caption <> "66"  Then 
'		If Len(cont0.edtNum0.caption & cont0.edtNum1.caption & cont0.edtNum2.caption & cont0.edtNum3.caption) == 0 then
'			Form.ShowAlert("알림", "소득금액증명원 번호를 입력해 주세요.")
'			return False
'		End If
'	
'		If Len(cont0.edtNum0.caption) < 4 then
'			Form.ShowAlert("알림", "소득금액증명원 번호 첫번째 칸의 자릿수는 4자리입니다.")
'			return False
'		End If
'		
'		If Len(cont0.edtNum1.caption) < 3 then
'			Form.ShowAlert("알림", "소득금액증명원 번호 두번째 칸의 자릿수는 3자리입니다.")
'			return False
'		End If
'		
'		If Len(cont0.edtNum2.caption) < 4 then
'			Form.ShowAlert("알림", "소득금액증명원 번호 세번째 칸의 자릿수는 4자리입니다.")
'			return False
'		End If
'		
'		If Len(cont0.edtNum3.caption) < 3 then
'			Form.ShowAlert("알림", "소득금액증명원 번호 네번째 칸의 자릿수는 3자리입니다.")
'			return False
'		End If
'	End If
	
	'가입유형이 서민형인 경우만 소득확인증명서 필수
	If cont0.lblTypeCode.caption == "73" or cont0.lblTypeCode.caption == "78"  then 'v0003. 78 서민형_청년 추가
		If Len(cont0.edtNum4.caption & cont0.edtNum5.caption & cont0.edtNum6.caption & cont0.edtNum7.caption) == 0 then
			Form.ShowAlert("알림", "소득확인증명서 번호를 입력해 주세요.")
			return False
		End If
		
		If Len(cont0.edtNum4.caption) < 4 then
			Form.ShowAlert("알림", "소득확인증명서 번호 첫번째 칸의 자릿수는 4자리입니다.")
			return False
		End If
		
		If Len(cont0.edtNum5.caption) < 3 then
			Form.ShowAlert("알림", "소득확인증명서 번호 두번째 칸의 자릿수는 3자리입니다.")
			return False
		End If
		
		If Len(cont0.edtNum6.caption) < 4 then
			Form.ShowAlert("알림", "소득확인증명서 번호 세번째 칸의 자릿수는 4자리입니다.")
			return False
		End If
		
		If Len(cont0.edtNum7.caption) < 3 then
			Form.ShowAlert("알림", "소득확인증명서 번호 네번째 칸의 자릿수는 3자리입니다.")
			return False
		End If
	End If
	
	return True
End Function

'============================================================================
Sub MoveNextPage()
	Dim sSendData
	
	'추후 유지보수 중 항목 추가 발생할 경우에 대비, 각 화면마다 array 20개씩 잡아놓음
	sSendData = acnt0.total & "★"
	sSendData = sSendData & acnt0.sequence & "★"
	'v0002 sta
	'sSendData = sSendData & Form.GetEncData(edtPwd.caption) & "★" 
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then 
		sSendData = sSendData & Form.GetCtlProp("edtPwd", "caption") & "★" 
	'MTS메모리평문 미적용상태일때
	else
		sSendData = sSendData & Form.GetCtlProp("edtPwd", "encdata") & "★" 
	end if 
	'v0002 fin
	sSendData = sSendData & g_sCSNO & "★"	'고객번호
	sSendData = sSendData & cont0.lblTypeCode.caption & "★"
	sSendData = sSendData & cont0.tbl0.GetCellString( 0, 0 ) & "★"
	sSendData = sSendData & cont0.tbl1.GetCellString( 0, 0 ) & "★"
	sSendData = sSendData & g_sWatchDate & "★"
	sSendData = sSendData & g_sWatchTime & "★"
	sSendData = sSendData & cont0.edtNum0.caption & cont0.edtNum1.caption & cont0.edtNum2.caption & cont0.edtNum3.caption & "★"
	'sSendData = "" & "★" 'v0003. 소득증명원 제거
	sSendData = sSendData & cont0.edtNum4.caption & cont0.edtNum5.caption & cont0.edtNum6.caption & cont0.edtNum7.caption & "★"
	sSendData = sSendData & g_sHomeAddr & "★"	'자택주소
	sSendData = sSendData & g_sCoAddr & "★"		'회사주소
	sSendData = sSendData & g_sTel & "★"		'연락처
	sSendData = sSendData & g_sEMail & "★"		'이메일주소
	
'	sSendData = sSendData & cont0.cmbPaper.cbkeydata & "★"
'	sSendData = sSendData & cont0.cmbPaper.caption & "★"

	If cont0.rdoPaper.currentindex == "0" then
		sSendData = sSendData & "00" & "★"
		sSendData = sSendData & "온라인 제출" & "★"
	ElseIf  cont0.rdoPaper.currentindex == "1" then
		sSendData = sSendData & "01" & "★"
		sSendData = sSendData & "Email" & "★"
	ElseIf  cont0.rdoPaper.currentindex == "2" then
		sSendData = sSendData & "02" & "★"
		sSendData = sSendData & "Fax" & "★"
	'20210312 HSZ START 
'	Else
'		 sSendData = sSendData & "99" & "★"
'		 sSendData = sSendData & "해당없음(일반형)" & "★"
	'20210312 HSZ END
	End If
	
	sSendData = sSendData & g_sMinAmt & "★"
	sSendData = sSendData & "★"
	sSendData = sSendData & "★"
	
	Form.SetSharedData("56060_STEP_LINK", sSendData )
	
	
	'=====================================================================================
	'20210312_01 SWJ START : ISA계좌개설 개선 (서비스사용으로 대체필요)
	'=====================================================================================
	'$$$
	sSaveExt1 = cont0.edtNum0.caption & "★" & cont0.edtNum1.caption & "★" & cont0.edtNum2.caption & "★" & cont0.edtNum3.caption
	sSaveExt2 = cont0.edtNum4.caption & "★" & cont0.edtNum5.caption & "★" & cont0.edtNum6.caption & "★" & cont0.edtNum7.caption
	Form.SetSharedData("56060_STEP_LINK_ETC" ,sSaveExt1)
	Form.SetSharedData("56060_STEP_LINK_ETC1",sSaveExt2)
	sStoreData = sSendData
	
	DATAMANAGER.RequestTranData("obwat_ctad_068a") '필수정보 저장
	'=====================================================================================
	'20210312_01 SWJ END	
	'=====================================================================================
	
	Form.triggerEvent("#", "OPEN_NEXT", "1")
End Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	'20210312 HSZ START
	g_Ostype = Form.GetSharedData("&OS_TYPE", false )	' iOS("2") Android("1") 기타("9")
	call PaperShownHide(False)

'	20210312 HSZ END
	
	'20210311 SWJ START : 비디오 시청시간 이어보기
    g_timeDate = Form.GetSharedData("&HOST_DATE", true)
    g_UserID = Form.GetSharedData("&USER_ID", false)
    
    g_vplayTime = Form.LoadConfigData("VideoPlaying", "TimeSave"..g_timeDate..g_UserID)
    
	if g_vplayTime == "" or g_vplayTime == null then
		Form.SetSharedData("ISA_VIDEO_TIME", "0" )  'v0001 최초1회
		
	elseif Cint(g_vplayTime) >= 300000 then
		g_sWatchDate = Form.GetSharedData("&HOST_DATE", True ) '필수데이터 저장
		g_sWatchTime = Form.GetSharedData("&HOST_TIME", True ) '필수데이터 저장
	else
		Form.SetSharedData("ISA_VIDEO_TIME", g_vplayTime)
	end if
	'20210311 SWJ END
	
	plain_rm = Form.GetSharedData("&PLAIN_RM", FALSE )  'v0002
	'---------------------------------------------------------
	'아이폰 오픈 지연
	Dim strMediaType, sVer
	
	strMediaType =  Form.GetSharedData("&MEDIA_CODE", false )
	sVer = Form.GetSharedData("&APP_VERSION")
	
	If strMediaType == "156" then	'아이폰이면
		If sVer <> "" then	
			If CDbl(Left(sVer, 1)) < 2 then		'버전이 1.x.x 이면(동영상 플레이 가능 버전 : 2.x.x부터)
				Form.MsgBox( "알림", "추후 서비스 지원 예정입니다. 초기화면으로 이동합니다.", "IOSIMSI", 6 )
				Exit Sub
			End If
		End If
	End If
	'---------------------------------------------------------
	
	'ISA 계좌가 존재하지 않는 경우
	If Trim(acnt0.caption) == "" then
		contOnline.visible = True
		cont0.visible = False
	'ISA 계좌가 존재하는 경우
	Else
		contOnline.visible = False
		cont0.visible = True
	End If

	Call SetCtrlEnable()	'비번 입력전 입력 불가
	
'	'for test 20200312
'		sReceiveData = "1"&"★"&"2"&"3"&"★"&"4"&"★"&"5"&"★"&"6"&"7"&"★"&"8"
'	    szList		= Split(sReceiveData,"★") '필수정보(기존유지)
'		szNum        = Ubound(szList)
'		
'		For i= 0 to 4
'			szListExt1 = szList(i)..szListExt1
'			szListExt2 = szList(i)..szListExt2 
'		Next
'		
'		Form.MsgBox(szListExt1(0),szListExt2(0))
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'ISA가입 필수안내사항 확인
	If sKeyName == "mbisa56060_p4" then
		If sRet == "ok" then
			cont0.chk2.checkstate = "1"
		Else
			cont0.chk2.checkstate = "0"
		End If
	End If
	
	'가입자유형
	If sKeyName == "mbisa56060_p5" then
		Dim sType, sTypeCode
		
		g_sType = sRet
		
		Select Case sRet
			Case "0"
				sType = "일반형"
				sTypeCode = "66"
				Call SetDocNumEnable(False)		'서민형인 경우만 소득확인증명서 입력
				Call PaperShownHide(False)

				'v0003. ISA 조특법 개정안 적용 sta
				'cont0.edtNum0.enable = False
				'cont0.edtNum1.enable = False
				'cont0.edtNum2.enable = False
				'cont0.edtNum3.enable = False
				
				cont0.edtNum0.caption = ""
				cont0.edtNum1.caption = ""
				cont0.edtNum2.caption = ""
				cont0.edtNum3.caption = ""
				
				'20210311 SWJ START : 일반형일 때만 타이틀 재설정
				cont0.tblTitle3.SetCellString( 0, 0, "가입서류 발급번호 (가입자 유형 일반형은 해당없음)")
				cont0.tblTitle5.SetCellString( 0, 0, "ISA계약 서류제출 방법 선택 (가입자 유형 일반형은 해당없음)")
				'20210311 SWJ END
				
		
			Case "1"
				sType = "일반형_청년" 
				sTypeCode = "67"
				Call SetDocNumEnable(True)	    '서민형인 경우만 소득확인증명서 입력
				Call PaperShownHide(True)
				
				'20210311 SWJ START : 일반형일 때만 타이틀 재설정
				cont0.tblTitle3.SetCellString( 0, 0, "가입서류 발급번호")
