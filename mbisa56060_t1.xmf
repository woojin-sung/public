				Exit Sub	
			End If

		Else
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_2", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
