'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	'ISA계좌가 이미 있다면 진행상태 화면으로 이동
	If szTranID == "obwat_ctad_041r" then
		If sSubmsg == "계약신청 신청내역이 존재합니다." then
			Form.MsgBox( "알림", szErrMsg & " " & sSubmsg & " " &  "진행상태로 이동합니다.", "Close", 6 )
		Else
			if szErrCode == "0829" then 'v0004
				Form.MsgBox( "알림", "만65세 이상 고령자로 투자 숙려대상이므로 ISA의 온라인가입이 불가합니다.", "", 0 )
			else
				Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
			end if 
			g_bCtrlEnable = False
			Call SetCtrlEnable()	'입력 불가
		End If
	
	'비번 체크 실패시
	ElseIf szTranID == "obacp_opop_066r" then
		Call ClearAllData()
		g_bCtrlEnable = False	
		Call SetCtrlEnable()	
		Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
		
	Else
		Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
	End If
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	'안드로이드는 num, 아이폰은 string으로 받음
	If sTimerID == 0 or sTimerID == "0" then
		Form.SetTimerEvent( 0, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_1")
	End If
	
	If sTimerID == 1 or sTimerID == "1" then
		Form.SetTimerEvent( 1, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_2")
	End If
	
	If sTimerID == 2 or sTimerID == "2" then
		Form.SetTimerEvent( 2, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_3")
	End If
	
	If sTimerID == 3 or sTimerID == "3" then
		Form.SetTimerEvent( 3, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_4")
	End If
End Sub
'============================================================================
'20210312_01 SWJ START : 이어가기 데이터 세팅 함수
'============================================================================
Function DataSetting()
		'다음화면에서 부가정보 데이터 받아서 1단계 Outblock값에 태워야함
'		Form.SetSharedData("56060_STEP_LINK_ETC" ,szListExt1)
'		Form.SetSharedData("56060_STEP_LINK_ETC1",szListExt2)
		
		szList		= Split(sReceiveData,"★") '필수정보(기존유지)
		
		'다음화면에서 부가정보 데이터 받아서 1단계 Outblock값에 태워야함
		Form.SetSharedData("56060_STEP_LINK_ETC" ,szListExt1)
		Form.SetSharedData("56060_STEP_LINK_ETC1",szListExt2)
		
		szListExt1	= Split(szListExt1  ,"★") '부가정보1
		szListExt2	= Split(szListExt2  ,"★") '부가정보2
		'범위 : szList(0) ~ szList(19)
		
		if UBOUND(szList) > 0 then
			'원래 공유 링크변수에 값 셋팅해줘야 함
			Form.SetSharedData("56060_STEP_LINK", sReceiveData )
			
			'-------------------------------------------------------------------
			'(유형1) UI 강제셋팅 (STEP1 완료 후, 재진입한것으로 아래 체크버트은 이미 TRUE가 맞음)
			'-------------------------------------------------------------------
			cont0.chk3.checkstate = "1"
			cont0.chk0.checkstate = "1"
			cont0.chk1.checkstate = "1"
			cont0.chk2.checkstate = "1"
			
			'-------------------------------------------------------------------
			'(유형2) Saved Data -> UI & Variable 셋팅
			'-------------------------------------------------------------------
			acnt0.total		= szList(0)
			acnt0.sequence	= szList(1)
			
			Form.SetCtlProp("edtPwd", "caption", szList(2))
			edtPwd_OnEditComplete()
			
			g_sCSNO 			= szList(3)
			cont0.lblTypeCode.caption = szList(4)
			cont0.tbl0.SetCellString(0, 0, szList(5))
			cont0.tbl1.SetCellString(0, 0, szList(6))
			g_sWatchDate 		= szList(7)
			g_sWatchTime 		= szList(8)
		
			if UBOUND(szListExt1) > 0 then
				cont0.edtNum0.caption = szListExt1(0)
				cont0.edtNum1.caption = szListExt1(1)
				cont0.edtNum2.caption = szListExt1(2)
				cont0.edtNum3.caption = szListExt1(3)
			End if
				
			if UBOUND(szListExt2) > 0 then
				
				if szListExt2(0) == null or szListExt2(0) =="" then
					Call PaperShownHide(False)			'일반형 이외 다른 유형은 컨테이너 사이즈 재조정 필요
				else
					Call PaperShownHide(True)
				end if
				
				cont0.edtNum4.caption = szListExt2(0)
				cont0.edtNum5.caption = szListExt2(1)
				cont0.edtNum6.caption = szListExt2(2)
				cont0.edtNum7.caption = szListExt2(3)
			end if
			
			g_sHomeAddr		= szList(11)
			g_sCoAddr		= szList(12)
			g_sTel			= szList(13)
			g_sEMail			= szList(14)
			
			if szList(15) == "00" then
				cont0.rdoPaper.currentindex = "0"
			elseif szList(15) == "01" then
				cont0.rdoPaper.currentindex = "1"
			elseif szList(15) == "02" then
				cont0.rdoPaper.currentindex = "2"
			end if
			
			g_sMinAmt = szList(17)
		End if	
End Function
