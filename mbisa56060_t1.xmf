	End If
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'동영상 시청하기 중지(완료)시
	If sEventName == "VIDEO_PLAY_EXIT" then
		If sParam <> "" then
			'TEST
			'If CDbl(sParam) >= 5000 then	'5초 이상 시청시 ok
			If CDbl(sParam) >= 300000 then	'5분 이상 시청시 ok
				cont0.chk0.checkstate = "1"
				cont0.chk1.enable = True
			Else
				Form.ShowAlert("알림", "동영상을 끝까지 시청하셔야 합니다.(최소5분)")
				Exit Sub
			End If
		End If
	
	'=====================================================================================
	'20210312_01 SWJ START : ISA계좌개설 개선
	'=====================================================================================
	elseif sEventName == "OPEN_PREV" Then
		DATAMANAGER.RequestTranData("obwat_ctad_069r")
	end if
	'=====================================================================================
	'20210312_01 SWJ END	
	'=====================================================================================		
End Sub

