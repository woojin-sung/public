				'cont0.edtNum0.enable = True
				'cont0.edtNum1.enable = True
				'cont0.edtNum2.enable = True
				'cont0.edtNum3.enable = True
				
				'cont0.edtNum0.caption = ""
				'cont0.edtNum1.caption = ""
				'cont0.edtNum2.caption = ""
				'cont0.edtNum3.caption = ""
			Case "3"
				sType = "서민형_청년" 
