	<SCRIPT_INFO _len="48309" _ulen="42421" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 가입신청
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.18 김은숙
' 2017-01-25 : 신극수 : v0001 : 안드로이드단말에서 동영상이 정상적으로 재생되지 않던 문제 해결.
' 2020-09-23 : 신극수 : v0002 : [T2007220015] MTS 비밀번호 Edit 메모리평문제거
' 2020-12-07 : 김유경 : v0003 : ISA 조특법 개정안 적용
'                               은행합회 결과값에 따라 가입가능 여부 체크 (obaci_acct_089r)
'                               동영상 링크 변경
' 2021-05-03 : 신극수 : v0004 : [T2104230020]고난도
' 2021-05-10 : 신극수 : v0005 : [T2103310007][ISA] 금융소득종합과세 대상자 특례 제한 관련 변경 세금우대설계서 반영 요청
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_bInqrOK		'True : 계약조회 완료(obwat_ctad_023r)
g_bInqrOK = False

Dim g_bJoinChkOK	'True : 온라인가입 초기필수 데이터 체크 완료(obwat_ctad_041r)
g_bJoinChkOK = False

Dim g_sCSNO		'고객번호(다음 페이지의 투자성향진단 팝업에 사용)
Dim g_sHomeAddr 	'자택주소
Dim g_sCoAddr 	'회사주소
Dim g_sTel 		'연락처
Dim g_sEMail 		'이메일주소
Dim g_sMinAmt		'최소가입금액

Dim g_sWatchDate	'동영상 시청 날짜
Dim g_sWatchTime	'동영상 시청 시각
g_sWatchDate = ""
g_sWatchTime = ""

Dim g_sType		'가입자유형 인덱스 저장(가입유형 팝업시 선택된 항목으로 표시)
g_sType = "-1"

Dim g_bCtrlEnable	'False = 비번 입력전 입력 불가 / True = 비번 입력 후 입력 가능
g_bCtrlEnable = False

Dim g_vplayTime, g_timeDate  					'20210311 SWJ : 비디오 시청시간
Dim g_Ostype				 					'20210312 HSZ : 단말 OS 타입
Dim sReceiveData, sStoreData, sSaveExt1, sSaveExt2 '20210312 SWJ : 데이터 받기
Dim szListExt1, szListExt2
sFlag = 0
dim plain_rm 'v0002
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
