'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obwat_ctad_023r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_INDV_MGRI_ASNO" , 0 , acnt0.sequence)
	End If
	
	If szTranID == "obwat_ctad_041r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , acnt0.sequence)
	End If
	
	If szTranID == "obacp_opop_066r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , acnt0.sequence)
		'v0002 sta
		'DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetEncData(edtPwd.caption))
		'MTS메모리평문 적용상태일때
		if plain_rm == "1" then 
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("edtPwd", "caption") )
		'MTS메모리평문 미적용상태일때
		else
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("edtPwd", "encdata") )
		end if 
		'v0002 fin
	End If
	
	'v0003. 은합회 결과값에 따라 가입가능 여부 체크 sta
	If szTranID == "obaci_acct_089r" or szTranID == "obaci_acct_089r_1" or szTranID == "obaci_acct_089r_2" or szTranID == "obaci_acct_089r_3" or szTranID == "obaci_acct_089r_4" then		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "TXCM_PRCD" , 0 , "84"        )	'은행연합회 상품코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO"      , 0 , acnt0.total )	'계좌번호
	End If
	'v0003. fin
	
	'20210312_01 SWJ START : ISA계좌개설 개선
	if szTranID == "obwat_ctad_069r" then
		sApplyDate = Form.GetSharedData("&HOST_DATE", false)
		
		DATAMANAGER.SetDataValue(0, "obwat_ctad_069r", "InBlock1", "ACNO", 0, acnt0.total )
		DATAMANAGER.SetDataValue(0, "obwat_ctad_069r", "InBlock1", "ASNO", 0 , acnt0.sequence)
		DATAMANAGER.SetDataValue(0, "obwat_ctad_069r", "InBlock1", "APLT_DATE" , 0 , sApplyDate)
		DATAMANAGER.SetDataValue(0, "obwat_ctad_069r", "InBlock1", "PWD" , 0 , Form.GetCtlProp("edtPwd", "caption"))
		
	end if
	
	if szTranID == "obwat_ctad_068a" then
	
		sApplyDate = Form.GetSharedData("&HOST_DATE", false)
		
		DATAMANAGER.SetDataValue(0, "obwat_ctad_068a", "InBlock1", "ACNO" , 0, acnt0.total )
		DATAMANAGER.SetDataValue(0, "obwat_ctad_068a", "InBlock1", "ASNO" , 0 , acnt0.sequence )
		DATAMANAGER.SetDataValue(0, "obwat_ctad_068a", "InBlock1", "PWD"  , 0 , Form.GetCtlProp("edtPwd", "caption") )
		DATAMANAGER.SetDataValue(0, "obwat_ctad_068a", "InBlock1", "APLT_DATE"  , 0 , sApplyDate )
		DATAMANAGER.SetDataValue(0, "obwat_ctad_068a", "InBlock1", "REG_STAG_CLS_CODE" , 0 ,  "1")
		'DATAMANAGER.SetDataValue(0, "obwat_ctad_068a", "InBlock1", "ANTC_PNSN_RECV_CNTT" , 0 , sStoreData)
		DATAMANAGER.SetDataValue(0, "obwat_ctad_068a", "InBlock1", "EXIN_TLMS_CNTT"      , 0 , sStoreData)
		DATAMANAGER.SetDataValue(0, "obwat_ctad_068a", "InBlock1", "APLT_SVC_INFO_CNTT"  , 0 , sSaveExt1)
		DATAMANAGER.SetDataValue(0, "obwat_ctad_068a", "InBlock1", "APLT_SVC_INFO_CNTT1" , 0 , sSaveExt2)
		
	end if
	'20210312_01 SWJ END
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'비번 체크 성공시
	If szTranID == "obacp_opop_066r" then
		g_bCtrlEnable = True	'비번 입력후 입력 가능
		Call SetCtrlEnable()	
		
		DATAMANAGER.RequestTranData("obwat_ctad_023r")	'랩계약조회
		DATAMANAGER.RequestTranData("obwat_ctad_041r")	'온라인가입 초기필수 데이터 체크	
	End If
	
	'랩계약조회
	If szTranID == "obwat_ctad_023r" then	
		g_bInqrOK = True
		g_sCSNO = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock4", "CSNO" , 0)			'고객번호
		g_sHomeAddr = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_ADDR" , 0)	'자택주소
		g_sCoAddr = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CO_ADDR" , 0)		'회사주소
		g_sTel = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CNPL_TELNO" , 0)		'연락처
		g_sEMail = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "EMAIL_ADDR" , 0)		'이메일주소
		g_sMinAmt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MIN_JOIN_AMT" , 0)	'최소가입금액
	End If

	If szTranID == "obwat_ctad_041r" then
		sJoinYN = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "JOIN_ABLE_YN" , 0)

		If sJoinYN == "Y" then
			g_bJoinChkOK = True
			g_bCtrlEnable = True
			Call SetCtrlEnable()
		Else
			Form.ShowAlert("알림", DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "DEAL_PRHB_CNTT" , 0))	
			g_bCtrlEnable = False
			Call SetCtrlEnable()	'입력 불가
		End If
	End If
	
	'v0003. 은합회 결과값에 따라 가입가능 여부 체크 sta
	
	'-----------------------------------------------------------------
	'은행연합회 한도금액 조회
	'-----------------------------------------------------------------
	Dim sCode, sOutput, sTxcmDplcAcntYn
	
	'PROS_CLS_CODE가 '1'이면 1초에 한번 총 5회 OutBlock1.LNKD_TLMS_MNNO를 INPUT으로 하여 다시 전송한다.
	'PROS_CLS_CODE가 '2'로 정상응답을 수신하면 재전송 중단
	
	If szTranID == "obaci_acct_089r" Then
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
		
		If sCode == "2" then	'정상
			sTxcmDplcAcntYn = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_DPLC_ACNT_YN" , 0)	'세금우대 중복 계좌 여부  
			sTxcmTrprClsCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_TRPR_CLS_CODE" , 0) '금융소득종합과세대상자여부 V0005
		
			'v0005
			if sTxcmTrprClsCode == "1" then
				Form.ShowAlert("알림", "금융소득종합과세대상자 ISA 가입 불가합니다.")
				Exit Sub
			end if 
			
			If sTxcmDplcAcntYn == "0" OR sTxcmDplcAcntYn == "3" then 
