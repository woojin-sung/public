'온라인 ISA 계좌개설
Sub contOnline_btnOnline_OnClick()	
	sloginType = Form.GetSharedData( "&LOGIN_TYPE", false )
	
	if Cint(sloginType) > 1 then
		sText = "로그아웃이 필요한 메뉴입니다. 로그아웃하시겠습니까?"
		Form.MsgBox("알림",sText, "LOGOUT_MSG" , 1 )
	else
		Form.SetSharedData("&SCREEN_AUTH" , "99")
		Form.OpenPopup("mbbdm85100", "", "")
	end if
End Sub

Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "LOGOUT_MSG" then
		if sRet == "ok" then
			'1parm (0.문구없음 1.문구있음)
			'2parm (0.권한상관없이 로그아웃만 함 1.화면권한에 따라 닫을 화면 로그아웃)
			Form.LogOut(0,1)
			Form.SetSharedData("&SCREEN_AUTH" , "99")
			Form.OpenPopup("mbbdm85100", "", "")
		end if
	end if
End Sub

'============================================================================
'비대면 계좌개설
Sub contOnline_btnApp_OnClick()
	sVer = Form.GetSharedData("&APP_VERSION")
	
	if sVer == "1.0.49" then 'Open 시 최초 버전 1.0.49
		Form.openExternalBrowser("https://play.google.com/store/apps/details?id=com.imeritz.smartmeritzact" ) 
	else
		'1.0.50이후부터 지원되는 API
		Form.RunSmartMeritzAct()
	end if
End Sub

'============================================================================
'동영상 시청하기
'기능요건
'- 동영상 시청 시 
'- 5분이상 시청 필수 
'- 동영상 종료 후 재 시청 시 이전에 종료한 시점부터 시작
'- 동영상 종료 시 화면에 이벤트 전달
'
'- 동영상 중지(완료)시 trigger event 발생
'  ● Form_OnTriggerEvent가 call
'  ● sEventName : “VIDEO_PLAY_EXIT”
'  ● sParam : 동영상 시청시간 (ms)
'- 그 외 공유변수 안내
'  ● LinkData : “ISA_VIDEO_TIME” 로 시청시간 수시로 획득가능

Sub cont0_btnWatch_OnClick()
	'strMediaType =  Form.GetSharedData("&MEDIA_CODE", false )
	'sVer = Form.GetSharedData("&APP_VERSION")
	
	'20210311 SWJ START : 비디오 시청완료 시 토스트 메시지 및 체크처리
	g_UserID = Form.GetSharedData("&USER_ID", false)
	g_vplayTime = Form.LoadConfigData("VideoPlaying", "TimeSave"..g_timeDate..g_UserID)
	
	if Cint(g_vplayTime) >= 300000 then
		cont0.chk0.checkstate = "1"
		cont0.chk1.enable = True
		
		Form.Toast(0, "동영상 시청이 완료되었습니다.", 1)
		exit sub
	end if
	'20210311 SWJ END

	Dim nType
	nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	Form.SetSharedData("LINK_VIDEO_ING_NM", "ISA_VIDEO_TIME" ) 'v0001 매번
	Form.SetSharedData("LINK_VIDEO_ENDING_MSG", "동영상 재생이 완료되었습니다." ) 'v0001
	Form.SetSharedData("LINK_VIDEO_WARN_MSG", "동영상을 끝까지 시청하셔야 합니다. (최소5분)" ) 'v0001
	
	if nType == "0" then
		'Form.runVideoForISA("http://home.imeritz.com/include/resource/htsdown/ISA1Edu.mp4")	'운영계 주소
		Form.runVideoForISA("https://home.imeritz.com/include/flash/movieplayer/MeritzMoviePlayer.mp4")  'v0003. 동영상링크변경
	elseif nType == "1" then
		'Form.runVideoForISA("http://211.201.184.87/include/resource/htsdown/ISA1Edu.mp4")	'테스트계주소
		Form.runVideoForISA("https://testhome.imeritz.com/include/flash/movieplayer/MeritzMoviePlayer.mp4")  'v0003. 동영상링크변경
	end if	

	g_sWatchDate = Form.GetSharedData("&HOST_DATE", True )
	g_sWatchTime = Form.GetSharedData("&HOST_TIME", True )
End Sub

