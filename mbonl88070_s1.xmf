'============================================================================
Sub contMain_cmbPeriod_OnEditComplete(iIndex)
	'투자기간 선택
	if iIndex == 0 then		'1개월
		g_nDayCount = 30
	elseif iIndex == 1 then	'2개월
		g_nDayCount = 60
	elseif iIndex == 2 then	'3개월
		g_nDayCount = 90
	elseif iIndex == 3 then	'6개월
		g_nDayCount = 180
	elseif iIndex == 4 then	'1년
		g_nDayCount = 365
	end if
	
	contMain.lblPeriod.caption = contMain.cmbPeriod.caption
	
	'1/2/3/6/12개월
	if iIndex <> 5 then	
		g_nDayCount = contMain.cmbPeriod.cbkeydata
		
		contMain.edtDay.caption = g_nDayCount
		
		'날짜선택 후 만기일 계산
		DATAMANAGER.RequestTranData( "obsan_deal_203r" )
	
		contMain.edtDay.enable = false
	'직접입력
	else					
		contMain.edtDay.imagefilepth = "input_01_n.9"
		contMain.edtDay.enable = true
		contMain.edtDay.caption = ""
	end if
	
	f_SetNextEnable()
End Sub


'============================================================================
Sub contMain_contCtcn_lblTalk_OnClick()
	f_SetToggleUI(0)
	f_SetToggleData(g_szNotiFlag)
	f_SetNextEnable()
End Sub

'============================================================================
Sub contMain_contCtcn_lblEmail_OnClick()
	f_SetToggleUI(1)
	f_SetToggleData(g_szNotiFlag)
	f_SetNextEnable()
End Sub

'============================================================================
Sub contMain_contCtcn_tblInfo_OnClick(lRow , lColumn)
	if lRow == 0 and lColumn == 1 then
		Dim sSendData, sTabIdx
		if g_szNotiFlag == "talk" then
			sTabIdx = "0"
		elseif g_szNotiFlag == "email" then
			sTabIdx = "1"
		end if
		sSendData = contMain.acnt.total..";"..contMain.acnt.caption..";"..sTabIdx
		Form.OpenFramePopup("mbonl81000" , sSendData , "")
	end if
End Sub

