'============================================================================
Sub contMain_edtDay_OnClick()
	contMain.lblDayMask.visible = false
End Sub

'============================================================================
Sub contMain_edtDay_OnEditComplete()	
	contMain.lblDayMask.visible = true
	
	'투자기간 최대는 365일
	if CInt(contMain.edtDay.caption) > 365 then
		Form.ShowAlert("알림", "투자일수는 365일 이하로 가능합니다.")
		contMain.edtDay.caption = ""
		btnNext.enable = false
		exit sub
	end if
	
	g_nDayCount = CInt(contMain.edtDay.caption)
	
	'날짜입력 후 만기일 계산
	DATAMANAGER.RequestTranData( "obsan_deal_203r" )
End Sub

'============================================================================
Sub contMain_imgAmtReset_OnClick()
	contMain.lblAmtGuide.visible = true
	contMain.lblAmt.visible = false
	contMain.lblAmt.caption = ""
	
	contMain.lblAmtError.visible = false
	contMain.lblAmtError.caption = ""
	
	f_SetNextEnable()
End Sub

'============================================================================
Sub imgContact_OnClick()
	'하단 전화번호 연결
	if UBound(g_tData) > 0 then
		if g_tData[10] == "1065" then
			Form.SendCall("0264546600")
		else
			Form.SendCall("0215883400")
		end if
	end if
End Sub

'============================================================================
Function f_ChangeAcnt()
	'일단은 가격과 예상수익 테이블만 초기화....
	contMain.lblAmt.caption = ""
	
	contMain.tblExpect.SetCellString(0, 1, "")
	contMain.tblExpect.SetCellString(1, 1, "")
	contMain.tblExpect.SetCellString(2, 1, "")
	contMain.tblExpect.SetCellString(3, 1, "")
	
	f_SetNextEnable()
	
	'계좌가 바뀌었으므로 매수가능금액도 재조회
	DATAMANAGER.RequestTranData( "obsan_deal_221r" )
End Function

'============================================================================
Sub contMain_acnt_ChangeAccount()
	f_ChangeAcnt()
End Sub

