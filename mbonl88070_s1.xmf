Dim g_szOSType
Dim g_tData			'이전화면에서 받아온 상품데이터
Dim g_nDayCount		'투자기간
Dim g_szPwd			'계좌 비밀번호
Dim g_szFnprJoinSrno	'금융상품가입일련번호

Dim g_szNotiFlag
Dim g_szUserInfoFlag

Dim g_szAbleAmt

'투자성향 관련 변수
Dim g_ProsYN
Dim g_KYC_INVT_RCMD_CLS_CODE
Dim g_KYC_INVT_INCL_GRAD_CODE
Dim g_KYC_PROD_GRAD_CODE
Dim g_KYC_DVPD_EPMD_CODE
Dim g_KYC_DRVT_PROS_YN
Dim g_DVPD_GRAD_CODE

Dim g_sAgree

'============================================================================
Sub Form_OnFormInitBefore()
	'화면 내 이미지 비율유지 세팅
	imgInfo.setMaintainingRatio("1")
	imgContact.setMaintainingRatio("1")
	contMain.imgBadge1.setMaintainingRatio("1")
	contMain.imgBadge2.setMaintainingRatio("1")
	contMain.imgRefresh.setMaintainingRatio("1")
	contMain.imgTooltip1.setMaintainingRatio("1")
	contMain.imgTooltip2.setMaintainingRatio("1")
	contMain.imgArrow.setMaintainingRatio("1")
	contMain.imgCal.setMaintainingRatio("1")
	contMain.imgAmtReset.setMaintainingRatio("1")
	contMain.contCtcn.imgTalk.setMaintainingRatio("1")
	contMain.contCtcn.imgEmail.setMaintainingRatio("1")
	contMain.contCtcn.imgDot.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	'안드로이드 툴팁 아이콘 배치
	if g_szOSType == "1" then
		contMain.lblAmtTitle.setNeighborCtlPos("imgTooltip1", "right", 6, "")
		contMain.lblPeriodTitle.setNeighborCtlPos("imgTooltip2", "right", 6, "")
	end if
	
'	contMain.cmbPeriod.cbtype = "1"
	
	contMain.cmbPeriod.caption = "선택"
	btnNext.enable = false
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
'	Form.ShowAlert("szOpenData", szOpenData)
	if szOpenData <> "" and szOpenData <> null then
	
		'금융상품가입일련번호
		g_szFnprJoinSrno = Form.GetSharedData("FNPR_JOIN_SRNO", false)
		
		g_tData = Split(szOpenData, "★")
		if UBound(g_tData) > 0 then
			'g_tData : 상품등급코드 / 상품유형코드 / 투자최소일수 / 투자최대일수 / 수익률 / 상품코드 / 출금가능금액 / 최소매수금액 / 약관1 / 약관2 / 관리지점코드
			
			'상품명
			Dim szName
			if g_tData[5] == "NI71010" then		'수시형
				szName = "발행어음수시형(365)"
			else							'약정형
				szName = "발행어음약정형" & "(" & CInt(g_tData[2]) & "-" & CInt(g_tData[3]) & ")"
			end if
			contMain.lblName.caption = szName
			
			'뱃지 세팅(상품등급, 상품유형)
			if g_tData[0] = "01" then
				contMain.imgBadge1.imgpath = "img_bgsquare_grade_296.png"
				contMain.lblBadge1.caption = "초고위험"
				
			elseif g_tData[0] = "02" then
				contMain.imgBadge1.imgpath = "img_bgsquare_grade_297.png"
				contMain.lblBadge1.caption = "고위험"
				
			elseif g_tData[0] = "03" then
				contMain.imgBadge1.imgpath = "img_bgsquare_grade_298.png"
				contMain.lblBadge1.caption = "중위험"
				
			elseif g_tData[0] = "04" then
				contMain.imgBadge1.imgpath = "img_bgsquare_grade_299.png"
				contMain.lblBadge1.caption = "저위험"
				
			elseif g_tData[0] = "05" then
				contMain.imgBadge1.imgpath = "img_bgsquare_grade_300.png"
				contMain.lblBadge1.caption = "초저위험"
			end if
			
			contMain.imgBadge2.imgpath = "img_bgsquare_grade_316.png"
			if g_tData[1] == "1" then
				contMain.lblBadge2.caption = "약정형"
			else
				contMain.lblBadge2.caption = "수시형"
			end if
			
			'상품 정보 테이블 세팅
			if g_tData[1] == "1" then
				contMain.tblInfo.SetCellString(3, 0, "약정형")
				contMain.tblInfo.SetCellString(3, 2, CInt(g_tData[2]) & "-" & CInt(g_tData[3]) & "일")
			else
				contMain.tblInfo.SetCellString(3, 0, "수시형")
				contMain.tblInfo.SetCellString(3, 2, "365일")
			end if
			contMain.tblInfo.SetCellString(3, 1, g_tData[4])
			
			'출금가능금액
			contMain.lblAbleAmt.caption = g_tData[6]
			g_szAbleAmt = g_tData[6]
			
			'최소매수금액 
'			contMain.lblMinAmt.caption = g_tData[7]
'			contMain.lblAmtGuide.caption = g_tData[7]

			'그 외 상품유형별 세팅
			if g_tData[1] == "1" then
				
			else
				'수시형은 날짜선택 없음
				contMain.edtDay.imagefilepth = "input_01_d.9"
				contMain.edtDay.enable = false
				contMain.edtDay.caption = "365"
				
				contMain.imgPeriodBg.imgpath = "input_01_d.9"
				contMain.btnPeriod.enable = false
				
				'발행어음 만기일 계산(수시형은 바로 만기일 계산)
				g_nDayCount = 365
				DATAMANAGER.RequestTranData("obsan_deal_203r")
			end if
			
			'관리지점코드
			if g_tData[10] == "1065" then
				tblContact.SetCellString(0, 0, "디지털금융센터 02-6454-6600")
			else
				tblContact.SetCellString(0, 0, "고객지원센터 1588-3400")
			end if
			
			'고객 연락처 조회
			DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
			
			Form.OpenPopup("mbonl81010_p1" , "88070★0★" & contMain.acnt.total & "★" &  contMain.acnt.sequence & "★" &  g_tData[5])	
'			'고객번호로 전문투자자 판단
'			DATAMANAGER.RequestTranData( "obcsb_acif_799r" )
			
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szUserID, szCustNo
	szUserID = Form.GetSharedData("&USER_ID", false)
	szCustNo = Form.GetSharedData("&CUST_NUM", false)
	
	'발행어음 상품리스트 조회(출금가능금액 재조회)
	if szTranID == "obsan_deal_221r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , contMain.acnt.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , contMain.acnt.sequence )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TRGT_CLS_CODE" , 0 , "%" )	'조회구분코드
		
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID"	  , 0 , szUserID)
	
	'발행어음 만기일 계산
	elseif szTranID == "obsan_deal_203r" then
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1")				'조회구분("1": 투자일수로 조회)
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "ACNO" , 0 , contMain.acnt.total )			'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "ASNO" , 0 , contMain.acnt.sequence )		'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "ISCD" , 0 , g_tData[5] )					'종목코드
		
		if g_tData[1] == "1" then	'약정
			DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "INVT_DYNU" , 0 , g_nDayCount )
		else						'수시
			DATAMANAGER.SetDataValue( 0 , "obsan_deal_203r", "InBlock1", "INVT_DYNU" , 0 , "365" )
		end if
	
	'발행어음 예상수익 조회
	elseif szTranID == "obsan_deal_213r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISNT_PROD_TYPE_CODE" , 0 , g_tData[1] )
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , contMain.acnt.total )
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , contMain.acnt.sequence )
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISCD" , 0 , g_tData[5] )
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "INVT_DYNU" , 0 , g_nDayCount )
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "INVT_AMT" , 0 , contMain.lblAmt.caption )
	
	'고객 연락처 조회
	elseif szTranID == "obcsb_acif_140r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , contMain.acnt.total)	
	
	'발행어음 매수 주문
	elseif szTranID == "obsan_deal_215a" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , contMain.acnt.total)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , contMain.acnt.sequence)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PWD" , 0 , g_szPwd)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" , 0 , g_tData[5])
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "INVT_DYNU" , 0 , g_nDayCount)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "INVT_AMT" , 0 , contMain.lblAmt.caption)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FNPR_JOIN_SRNO" , 0 , g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4")
	
	'가입계약서류 제공방식 관리
	elseif szTranID == "obcsb_acad_122a" then
		Dim strCustTelno, strAddr, strInagTypeCode, strInagSrno

		if g_szNotiFlag == "talk" then
			strCustTelno = tblUserInfo.GetCellString(0, 1)
			strInagTypeCode = tblUserInfo.GetCellString(0, 2)
			strInagSrno = tblUserInfo.GetCellString(0, 3)

			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "04")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , strInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , strInagSrno)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "UI_CUST_TELNO" , 0 , strCustTelno)
		elseif g_szNotiFlag == "email" then
			strAddr = tblUserInfo.GetCellString(1, 1)
			strInagTypeCode = tblUserInfo.GetCellString(1, 2)
			strInagSrno = tblUserInfo.GetCellString(1, 3)

			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "02")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , strInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , strInagSrno)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "ADDR"          , 0 , strAddr)
		End If 
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "FNPR_JOIN_SRNO"     , 0 , g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "PROS_CLS_CODE"      , 0 , "1")
	
'	'고객번호로 전문투자자 판단
'	elseif szTranID == "obcsb_acif_799r" then
'		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" , 0 , szCustNo)
'	
'	'투자자금 원금 보존 여부
'	elseif szTranID == "obcsb_acif_792a" then 
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"				, 0 , contMain.acnt.total )	'계좌번호
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"				, 0 , contMain.acnt.sequence )	'계좌일련번호		
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PRNC_PRSV_YN" 		, 0, g_sAgree)
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MOD_REAS_RMRK"		, 0, "")
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FNPR_JOIN_SRNO"		, 0, g_szFnprJoinSrno)
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FNPR_JOIN_DETL_SRNO", 0, "00001")
'	
'	elseif szTranID == "obcsb_acif_700r" then 
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"				, 0 , contMain.acnt.total )		'계좌번호
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"				, 0 , contMain.acnt.sequence )	'계좌일련번호
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "KYC_BSWR_DIV_CODE"	, 0 , "01" )	'KYC 업무 분류 코드
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_DIV_CODE"		, 0 , "13005" )	'업무 분류 코드
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD"				, 0 , g_tData[5] )	'종목코드
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'발행어음 상품리스트 조회(출금가능금액 재조회)
	if szTranID == "obsan_deal_221r" then
		Dim szDrngAbleAmt
		szDrngAbleAmt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "DRNG_ABLE_AMT" , 0)
		
		g_szAbleAmt = szDrngAbleAmt
		
		contMain.lblAbleAmt.caption = szDrngAbleAmt
	
	'발행어음 만기일 계산
	elseif szTranID == "obsan_deal_203r" then
		'만기일 세팅
		'약정형일 경우 투자기간, 이율까지 세팅 (입력 투자기간에 따라 이율이 바뀔 수 있음)
		Dim szExpDate, szFromDt, szToDt, szRate
		szExpDate = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MTRT_DATE" , 0)
		szFromDt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "INVT_PRD_STA_DYNU" , 0)
		szToDt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "INVT_PRD_FIN_DYNU" , 0)
		szRate = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "APLY_INRT" , 0)
				
		contMain.lblExpDate.caption = Left(szExpDate, 4) & "-" & Mid(szExpDate, 5, 2) & "-" & Right(szExpDate, 2)

		contMain.lblExpHint.visible = false
		contMain.lblCalMask.visible = true
		contMain.lblExpDate.bringFront("1")
		
		'약정형
		if g_tData[1] == "1" then
			contMain.tblInfo.SetCellString(3, 1, szRate)
			contMain.tblInfo.SetCellString(3, 2, CInt(szFromDt) & "-" & CInt(szToDt) & "일")
			contMain.lblName.caption = "발행어음약정형" & "(" & CInt(szFromDt) & "-" & CInt(szToDt) & ")"
		end if
		
		'수시형 상품이거나, 매수금액 + 투자기간 전부 입력되어 있으면 바로 예상수익까지 조회
		if (g_tData[1] == "2" and CInt(contMain.lblAmt.caption) > 0) or (g_tData[1] == "1" and Trim(contMain.lblExpDate.caption) <> "" and CInt(contMain.lblAmt.caption) > 0) then
			DATAMANAGER.RequestTranData("obsan_deal_213r")
		end if
		
		f_SetNextEnable()
	
	'발행어음 예상수익 조회
	elseif szTranID == "obsan_deal_213r" then
		Dim nIntAmt, nIntx, nRstx, nSrtx
		nIntAmt = CInt(DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "INT_AMT" , 0))
		nIntx = CInt(DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "INTX" , 0))
		nRstx = CInt(DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "RSTX" , 0))
		nSrtx = CInt(DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "SRTX" , 0))
		
		'예상수익 테이블에 데이터 세팅
		contMain.tblExpect.SetCellString(0, 1, CInt(contMain.lblAmt.caption) + nIntAmt)							'세전금액
'		contMain.tblExpect.SetCellString(1, 1, nIntAmt)														'예상이자
		contMain.tblExpect.SetCellString(2, 1, nIntx + nRstx + nSrtx)											'예상세금
'		contMain.tblExpect.SetCellString(3, 1, CInt(contMain.lblAmt.caption) + (nIntAmt - nIntx - nRstx - nSrtx))	'세후금액
		
		'세후금액 > 하이라이트 처리 위해 라벨 컨트롤로 분리
		contMain.lblExpect.caption = CInt(contMain.lblAmt.caption) + (nIntAmt - nIntx - nRstx - nSrtx)				'세후금액
		contMain.lblExpect.setHighlight(332)
		'예상이자 > 하이라이트 처리 위해 라벨 컨트롤로 분리
		contMain.lblFee.caption = nIntAmt				'예상이자
		contMain.lblFee.setHighlight(332)
		
	'고객 연락처 조회
	elseif szTranID == "obcsb_acif_140r" then
		Dim iCnt, iCnt1
		If DATAMANAGER.IsMoreNextData(szTranID) = True Then
			DATAMANAGER.RequestNextData(szTranID)
		Else 	
			tblUserInfo.SetCellString(0, 1, "")
			tblUserInfo.SetCellString(0, 2, "")
			tblUserInfo.SetCellString(0, 3, "")
			tblUserInfo.SetCellString(1, 1, "")
			tblUserInfo.SetCellString(1, 2, "")
			tblUserInfo.SetCellString(1, 3, "")
			
			'이메일 주소
			iCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2")
			For i = 0 to iCnt - 1
			    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_TYPE_CODE" , i)
			    strInagSrno2     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_SRNO"      , i)
			    strAddr          = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ADDR"           , i)
			    
			    If strInagTypeCode2 = "21" Then
					tblUserInfo.SetCellString(1, 1, strAddr)
					tblUserInfo.SetCellString(1, 2, strInagTypeCode2)
					tblUserInfo.SetCellString(1, 3, strInagSrno2)
			    End If
			Next 	
			'휴대폰 번호
			iCnt1 = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock3")
			For i = 0 to iCnt1 - 1
			    strInagTypeCode3 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_TYPE_CODE" , i)
			    strInagSrno3     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_SRNO"      , i)
			    strCustTelno     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UI_CUST_TELNO"  , i)

			    If strInagTypeCode3 = "13" Then
				    tblUserInfo.SetCellString(0, 1, strCustTelno)
				    tblUserInfo.SetCellString(0, 2, strInagTypeCode3)
				    tblUserInfo.SetCellString(0, 3, strInagSrno3)
			    End If
			Next
			
			f_SetToggleData(g_szNotiFlag)
		End If 
	
	'발행어음 매수 주문
	elseif szTranID == "obsan_deal_215a" then
		
		
		'가입계약서류 제공방식 관리
		DATAMANAGER.RequestTranData( "obcsb_acad_122a" )
	
	'가입계약서류 제공방식 관리
	elseif szTranID == "obcsb_acad_122a" then
		Dim szBuyDate, szExpDate
		szBuyDate = DATAMANAGER.GetDataValue( 0, "obsan_deal_215a" , "OutBlock1" , "ODER_DATE" , 0 )
		szExpDate = DATAMANAGER.GetDataValue( 0, "obsan_deal_215a" , "OutBlock1" , "MTRT_DATE" , 0 )
		
		Dim szSendData
		'상품명 / 계좌번호 / 상품유형 / 매수금액 / 투자기간 / 매수금리 / 매수일 / 만기일
		szSendData = contMain.lblName.caption & "★" & contMain.acnt.caption & "★" & g_tData[1] & "★" & contMain.lblAmt.caption & "★" & g_nDayCount & "★" & 
					g_tData[4] & "★" & szBuyDate & "★" & szExpDate
		
		'발행어음 매수 완료
		Form.OpenNextPopup("mbonl88070_p4" , szSendData , "")
	
'	'고객번호로 전문투자자 판단
'	elseif szTranID == "obcsb_acif_799r" then
'		Dim szUI_PFIN_YN
'		szUI_PFIN_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "UI_PFIN_YN", 0)	'전문투자자여부
'		
'		if szUI_PFIN_YN == "N"  then
'			'투자자금 원금보존 확인
''			Form.openPopupAnimation("mbonl88060_p3" , g_szFnprJoinSrno .. "|" .. contMain.acnt.total .. "|" .. contMain.acnt.sequence , "", "2")
'			Form.OpenPopup("mbonl81010_p1" , "88060★0★" & contMain.acnt.total & "★" &  contMain.acnt.sequence & "★" &  g_tData[5])	
'		end if
'	'투자자금 원금 보존 여부
'	elseif szTranID == "obcsb_acif_792a" then 
'		g_MesuGO = "NO"
'		DATAMANAGER.RequestTranData("obcsb_acif_700r")		'제대로 등록되면 PROS_YN : C 가 나오지 않음.
'	
'	elseif szTranID == "obcsb_acif_700r" then
