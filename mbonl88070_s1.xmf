'												g_KYC_DVPD_EPMD_CODE 	& "★" & g_KYC_DRVT_PROS_YN	& "★" & g_DVPD_GRAD_CODE
'								, sPosInfo)
'			
'			elseif g_ProsYN == "D" then '원금보존 투자자금 가입불가 상품
'				Form.MsgBox("원금보존 위험상품 안내" , "고객님은 금융투자자금 원금보존을 선택하였습니다. 해당 상품은 위험등급 4등급 이상으로 투자자보호를 위해 발행어음 가입이 제한됩니다.", "ME_CLOSE", "6")
