				<CONTAINER name="contNotice" vscroll="1" scroll_pos="0,0" ly_vert="0,774,375,568,1" scroll_ly_vert="0,0" >
					<CONTROL_INFO>
						<LABEL name="lblNoticeTitle" fontsize="2" fontstyle="01" caption="유의사항" paddinginfo="1,0,0,0" ly_vert="20,20,335,20,1" />
						<TABLE name="tblText" insidelinecolor="102:255255255" colcount="2" rowcount="28" outline="0000" designorder="1" ly_vert="20,60,335,480,1" >
							<COL_INFO ly_vert_width="7,328" />
							<ROW_INFO ly_vert_height="10,20,20,20,10,20,20,10,20,20,20,10,20,20,20,10,20,20,20,10,20,20,10,20,20,10,20,20" />
							<CELL_INFO>
								<CELL cell_ly="0,0,0,0" bgcolor="075:244244244" line="0,0" impidxs="" />
								<CELL cell_ly="1,0,1,0" bgcolor="075:244244244" line="0,0" impidxs="" />
								<CELL cell_ly="0,1,0,1" bgcolor="075:244244244" line="0,0" caption="·" fontsize="5" impidxs="" />
								<CELL cell_ly="1,1,1,1" bgcolor="075:244244244" halign="0" line="0,0" caption="투자자는 발행어음에 대하여 메리츠증권으로부터" fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,2,0,2" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,2,1,2" bgcolor="075:244244244" halign="0" line="0,0" caption="충분한 설명을 받을 권리가 있으며, 투자 전 " fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,3,0,3" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,3,1,3" bgcolor="075:244244244" halign="0" line="0,0" caption="상품설명서 및 약관을 반드시 읽어보시기 바랍니다." fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,4,0,4" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,4,1,4" bgcolor="075:244244244" halign="0" line="0,0" fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,5,0,5" fgcolor="326:228073065" bgcolor="075:244244244" line="0,0" caption="·" fontsize="5" impidxs="" />
								<CELL cell_ly="1,5,1,5" fgcolor="326:228073065" bgcolor="075:244244244" halign="0" line="0,0" caption="발행어음은 예금자보호법에 따라 예금보험공사가 보호" fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,6,0,6" fgcolor="326:228073065" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,6,1,6" fgcolor="326:228073065" bgcolor="075:244244244" halign="0" line="0,0" caption="하지 않습니다." fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,7,0,7" fgcolor="326:228073065" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,7,1,7" fgcolor="326:228073065" bgcolor="075:244244244" halign="0" line="0,0" fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,8,0,8" fgcolor="326:228073065" bgcolor="075:244244244" line="0,0" caption="·" fontsize="5" impidxs="" />
								<CELL cell_ly="1,8,1,8" fgcolor="326:228073065" bgcolor="075:244244244" halign="0" line="0,0" caption="발행어음은 자산가격의 변동, 신용등급 하락 등에" fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,9,0,9" fgcolor="326:228073065" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,9,1,9" fgcolor="326:228073065" bgcolor="075:244244244" halign="0" line="0,0" caption="따라 투자원금의 손실(0~100%)이 발생할 수 있으며," fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,10,0,10" fgcolor="326:228073065" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,10,1,10" fgcolor="326:228073065" bgcolor="075:244244244" halign="0" line="0,0" caption="그 손실은 투자자에게 귀속됩니다." fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,11,0,11" fgcolor="326:228073065" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,11,1,11" fgcolor="326:228073065" bgcolor="075:244244244" halign="0" line="0,0" fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,12,0,12" fgcolor="326:228073065" bgcolor="075:244244244" line="0,0" caption="·" fontsize="5" impidxs="" />
								<CELL cell_ly="1,12,1,12" fgcolor="326:228073065" bgcolor="075:244244244" halign="0" line="0,0" caption="발행어음 수익률은 입금 시 회사가 고시하는" fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,13,0,13" fgcolor="326:228073065" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,13,1,13" fgcolor="326:228073065" bgcolor="075:244244244" halign="0" line="0,0" caption="약정수익률이 적용되며, 당해 수익률은 시장금리" fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,14,0,14" fgcolor="326:228073065" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,14,1,14" fgcolor="326:228073065" bgcolor="075:244244244" halign="0" line="0,0" caption="상황 등에 따라 변동될 수 있습니다. " fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,15,0,15" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,15,1,15" bgcolor="075:244244244" halign="0" line="0,0" fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,16,0,16" bgcolor="075:244244244" line="0,0" caption="·" fontsize="5" impidxs="" />
								<CELL cell_ly="1,16,1,16" bgcolor="075:244244244" halign="0" line="0,0" caption="발행어음은 발행사(메리츠증권 신용등급 AA-, " fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,17,0,17" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,17,1,17" bgcolor="075:244244244" halign="0" line="0,0" caption="2023.5.19 기준, 한국신용평가)의 신용위험(부도," fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,18,0,18" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,18,1,18" bgcolor="075:244244244" halign="0" line="0,0" caption="파산 등)에 따른 원금손실이 발생할 수 있습니다." fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,19,0,19" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,19,1,19" bgcolor="075:244244244" halign="0" line="0,0" fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,20,0,20" bgcolor="075:244244244" line="0,0" caption="·" fontsize="5" impidxs="" />
								<CELL cell_ly="1,20,1,20" bgcolor="075:244244244" halign="0" line="0,0" caption="신용등급 변동사항은 한국신용평가" fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,21,0,21" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,21,1,21" bgcolor="075:244244244" halign="0" line="0,0" caption="(https://kisrating.com)를 통해 확인하실 수 있습니다." fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,22,0,22" bgcolor="075:244244244" line="0,0" fontsize="5" impidxs="" />
								<CELL cell_ly="1,22,1,22" bgcolor="075:244244244" halign="0" line="0,0" fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
								<CELL cell_ly="0,23,0,23" fgcolor="326:228073065" bgcolor="075:244244244" line="0,0" caption="·" fontsize="5" impidxs="" />
								<CELL cell_ly="1,23,1,23" fgcolor="326:228073065" bgcolor="075:244244244" halign="0" line="0,0" caption="만기일 이전 출금 요청 시 당사가 사전에 고지한" fontsize="-2" paddinginfo="3,0,0,0" impidxs="" />
