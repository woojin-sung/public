'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szMsgCode, szMsgText, szSubText
	szMsgCode = DATAMANAGER.GetDataMsgCode(szTranID)
	szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
	szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szSubText <> "" and szSubText <> null then
		Form.ShowAlert("알림" .. szTranID, szMsgText & "(" & szSubText &")")
	else
		Form.ShowAlert("알림" .. szTranID, szMsgText)
	end if
End Sub

'============================================================================
'f_SetToggleUI(nFlag) : 서류제공방법 컨트롤 기능 함수
'============================================================================
Function f_SetToggleUI(nFlag)
	Dim szToggleImg0, szToggleImg1, szToggleColor0, szToggleColor1
	
	szToggleImg0 		= "input_01_n.9.png" 	'비활성 이미지
	szToggleImg1 		= "input_01_o.9.png" 	'활성화 이미지
	szToggleColor0 	= "127" 				'비활성 컬러
	szToggleColor1 	= "67" 				'활성화 컬러

	if nFlag == 0 then '알림,톡
		contMain.contCtcn.imgTalk.SetAlpha(0)	'알림톡	'0:선택/1:미선택
		contMain.contCtcn.imgEmail.SetAlpha(1)	'이메일
		contMain.contCtcn.imgTalkBg.imgpath = szToggleImg1
		contMain.contCtcn.imgEmailBg.imgpath = szToggleImg0
		contMain.contCtcn.lblTalk.fgcolor = szToggleColor1
		contMain.contCtcn.lblEmail.fgcolor = szToggleColor0
		contMain.contCtcn.lblInfoText.caption = "고객정보에 등록된 휴대폰 번호로 발송되오니  휴대폰 번호를\r\n반드시 확인해 주세요."
		g_szNotiFlag = "talk"
	elseif nFlag == 1 then '이메일
		contMain.contCtcn.imgTalk.SetAlpha(1)
		contMain.contCtcn.imgEmail.SetAlpha(0)
		contMain.contCtcn.imgTalkBg.imgpath = szToggleImg0
		contMain.contCtcn.imgEmailBg.imgpath = szToggleImg1
		contMain.contCtcn.lblTalk.fgcolor = szToggleColor0
		contMain.contCtcn.lblEmail.fgcolor = szToggleColor1
		contMain.contCtcn.lblInfoText.caption = "고객정보에 등록된 이메일로 발송되오니 이메일 주소를\r\n반드시 확인해 주세요."
		g_szNotiFlag = "email"
	else
		contMain.contCtcn.imgTalk.SetAlpha(1)
		contMain.contCtcn.imgEmail.SetAlpha(1)
		contMain.contCtcn.imgTalkBg.imgpath = szToggleImg0
		contMain.contCtcn.imgEmailBg.imgpath = szToggleImg0
		contMain.contCtcn.lblTalk.fgcolor = szToggleColor0
		contMain.contCtcn.lblEmail.fgcolor = szToggleColor0
		contMain.contCtcn.lblInfoText.caption = ""
		contMain.contCtcn.tblInfo.visible = false
		contMain.contCtcn.imgDot.visible = false
		contMain.contCtcn.lblInfoText.visible = false
		g_szNotiFlag = ""
		Exit Function
	end if
	contMain.contCtcn.tblInfo.visible = true
	contMain.contCtcn.imgDot.visible = true
	contMain.contCtcn.lblInfoText.visible = true
	
	'계약서류 방식 영역 펼침
	contMain.contCtcn.height = 180
	contMain.contNotice.top = 769 + 88
	contMain.SetScrollAutoSize()
End Function

'============================================================================
'f_SetToggleData(sFlag) : 서류제공방법 DATA SET
'============================================================================
Function f_SetToggleData(sFlag)
	if sFlag == "" or sFlag == null then
		Exit Function
	end if
	Dim szData
	szData = ""
	if sFlag == "talk" then '알림,톡
		szData = tblUserInfo.GetCellString(0, 1) '폰번호
	elseif sFlag == "email" then '이메일
		szData = tblUserInfo.GetCellString(1, 1) '이메일
	end if
	if szData <> "" and szData <> null then
		contMain.contCtcn.tblInfo.SetCellString(0, 0, szData)
		contMain.contCtcn.tblInfo.SetCellString(0, 1, "변경하기 〉")		
		
		g_szUserInfoFlag = true
	else
		contMain.contCtcn.tblInfo.SetCellString(0, 0, "")
		contMain.contCtcn.tblInfo.SetCellString(0, 1, "등록하기 〉")
		
		g_szUserInfoFlag = false
	end if
End Function

'============================================================================
Function f_SetNextEnable()
	Dim bFlag
	bFlag = true
	if contMain.lblAmt.caption == "" or contMain.lblAmt.caption == null then
		bFlag = false
	end if	
	
	if contMain.edtDay.caption == "" or contMain.edtDay.caption == null then
		bFlag = false
	end if
	
	if not g_szUserInfoFlag then
		bFlag = false
	end if 
	
	if g_Reg_YN == "N" then
		bFlag = false
	end if
	
	btnNext.enable = bFlag
End Function

'============================================================================
Sub contMain_btnPeriod_OnClick()
	contMain.cmbPeriod.openList()
End Sub

'============================================================================
Sub contMain_imgRefresh_OnClick()
	'발행어음 상품리스트 조회(출금가능금액 재조회)
	DATAMANAGER.RequestTranData("obsan_deal_221r")
End Sub

'============================================================================
Sub contMain_btnAmt_OnClick()
	if g_szOSType == "1" then
		contMain.scroll_pos = 92
	else
		contMain.scroll_pos_noAni = 92
	end if
	
	contMain.lblAmt.caption = ""
	contMain.lblAmt.visible = false
	contMain.lblAmtGuide.visible = false
	
	'매수금액 입력 키패드
'	Form.SetSharedData("OPEN_FILE_NAME", "mbonl88070_s1" )
'	Form.openPopup("mbonl88060_p9", "", "")

	Dim szPrc, szMaxPrc
	szPrc = ""
	
	if tonumber(contMain.lblAbleAmt.caption) <> NULL and tonumber(contMain.lblAbleAmt.caption) <> NULL then
		szMaxPrc = contMain.lblAbleAmt.caption		'매수가능 합계
	else
		szMaxPrc = 0
	end if
	

	Form.openPopup("mbfnp51010_p20", szPrc.."★"..szMaxPrc, "")
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'매수금액 키패드 리턴
	if sKeyName == "PRC_POPUP" then
		if sRet == "" or sRet == null then
			contMain.lblAmtGuide.visible = true
			contMain.lblAmt.visible = false
			contMain.lblAmt.caption = ""
			
			contMain.lblAmtError.visible = false
			contMain.lblAmtError.caption = ""
			
		elseif sRet <> "" and sRet <> null and CInt(sRet) > 0 then
			'최소매수금액, 매수가능금액에 대한 유효성 체크
			contMain.lblAmt.visible = true
			contMain.lblAmt.caption = sRet
			
			if UBound(g_tData) > 0 then
				if CInt(sRet) > CInt(g_szAbleAmt) then
					contMain.lblAmt.caption = ""
					
					contMain.lblAmtError.visible = true
					contMain.lblAmtError.caption = "매수가능금액을 확인해 주세요."
					exit sub
				end if
				
				'if CInt(sRet) < CInt(g_tData[7]) then
				if CInt(sRet) < 1000000 then
					contMain.lblAmt.caption = ""
					
					contMain.lblAmtError.visible = true
					contMain.lblAmtError.caption = "매수가능금액은 1,000,000원 이상입니다."
					exit sub
				end if
				
				contMain.lblAmtError.visible = false
				
				'매수금액 및 투자기간이 전부 입력되었으면 예상수익 조회
				if (g_tData[1] == "2" and CInt(contMain.lblAmt.caption) > 0) or (g_tData[1] == "1" and Trim(contMain.lblExpDate.caption) <> "" and CInt(contMain.lblAmt.caption) > 0) then
'				if Trim(contMain.lblExpDate.caption) <> "날짜를 입력해주세요." and CInt(contMain.lblAmt.caption) > 0 then
					'발행어음 예상수익 조회
					DATAMANAGER.RequestTranData("obsan_deal_213r")
				end if
			end if
		end if
		
		f_SetNextEnable()
	
	'약관 팝업 리턴
	elseif sKeyName == "mbonl88070_p2" and sRet == "ok" then
		'이해여부 확인 팝업
		Form.OpenFramePopup("mbonl88070_p3" , "" , "")
	
	'이해여부 확인 팝업 리턴
	elseif sKeyName == "mbonl88070_p3" and sRet == "ok" then
		'계좌 비밀번호 입력 팝업
		Form.openPopupAnimation( "pwdcheckpopup", contMain.acnt.caption & "☆2", "", "2" )
	
	'계좌 비밀번호 팝업 리턴
	elseif sKeyName == "CORRECT_PWD" and sRet <> "" and sRet <> null then
		Dim tPwd
		tPwd = Split(sRet, "★") '"nPwdLen★sEncPwd(암호화된 비밀번호)"
		
		if UBOUND(tPwd) > 0 then
			g_szPwd = tPwd(0)
			
			'발행어음 매수 주문
			DATAMANAGER.RequestTranData( "obsan_deal_215a" )
		end if
	
'	'===============================================
'	'원금보존 추구자금 확인 
'	'===============================================
'	elseif sKeyName == "mbonl88060_p3_agree" then		
'
'		if sRet == "Y" then
'			'상품가입 불가
'			
'			'KEK STA. 원금보존 무조건 받고 700r 조회 했을때 메시지 팝업띄어줌.
