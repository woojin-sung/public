	Form.SetSharedData("SLCT_YN1" , "")
	Form.SetSharedData("SLCT_YN2" , "")
	Form.SetSharedData("SLCT_YN3" , "")
	
	Form.SetSharedData("RCMS_YN1" , "")
	Form.SetSharedData("RCMS_YN2" , "")
	Form.SetSharedData("RCMS_YN3" , "")
	Form.SetSharedData("RCMS_YN4" , "")
	Form.SetSharedData("DOCU_VAL" , "")
	

	Form.SendReturnToParent( "mbonl81020" , g_sRetData)

End Sub


