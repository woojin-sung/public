'============================================================================
Sub Form_OnFormInitBefore()
	Dim sScreenNo
	sScreenNo = Form.GetSharedData("&SCREEN_NO", false )

	if sScreenNo ~= "81020" and sScreenNo ~= "81021" then '개인신용정보이용동의 본화면이 아닌경우
		FormTab0.deletepage = "page1"
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()	
	g_sRetData = "cancel"
	G_NOTICE_FILE = "mbonl81020_t3"
	Form.SetSharedData( "PROS_DATE" , "")
	Form.SetSharedData( "PROS_SRNO" , "")
	
	g_szOpenScreen = Form.GetSharedData("&SCREEN_NO", false)
	if g_szOpenScreen = "81021" then
	     FormTab0.currenttab = 1
			FormTab0_OnTabChanged(1)
			
			g_sRevData = ""	
			Account1.visible = true					
			Account1_ChangeAccount()
	end if 
	
	
	'v0003 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)

	g_sRevData = Form.GetOpenLinkData()
	
	if g_sRevData  == null or g_sRevData  == "" then
	     Account1.visible = true
		g_sAcc = Account1.caption
		DATAMANAGER.RequestTranData( "obaci_acct_256r" ) '개인신용정보조회
		
    elseif Instr(g_sRevData, "81021") > 0  then
			FormTab0.currenttab = 1
			FormTab0_OnTabChanged(1)
			
			g_sRevData = ""	
			Account1.visible = true					
			Account1_ChangeAccount()
			
	else
		Dim sTemp
		sTemp = Split(g_sRevData, ";")
		
		'20230215 디지털업무솔루션 관련 
		'화면 접근시 선택동의 탭으로 이동 내용 추가
		If Trim(sTemp[0]) == "탭이동" Then
			FormTab0.currenttab = sTemp[1]
			FormTab0_OnTabChanged(CInt(sTemp[1]))
			
			'20230315
			g_sRevData = ""	
			Account1.visible = true					
			Account1_ChangeAccount()
			'20230315
		Else
			Account1.visible = false
			
			g_sKindCode = sTemp[0]
			g_sAcc = sTemp[1]
	
			Account0.caption = g_sAcc
			EditPW.visible = false
			Account0.width = 363
			Account0.enable = false
			EditPW.enable = false
			Form.triggerEvent( "FormTab0."..FormTab0.currenttabpageid, "EnableDisableYN", g_sKindCode )		
		End If
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "Request" then
		if sParam == "page0_menu" then
			DATAMANAGER.RequestTranData( "obaci_acct_256a" ) '개인신용정보등록(필수)
		elseif sParam == "page0_acct" then
			DATAMANAGER.RequestTranData( "obaci_acct_255a" ) '개인신용정보등록(계좌신용정보관리)
		elseif sParam == "page1" then
			DATAMANAGER.RequestTranData( "obaci_acct_256a_1" ) '개인신용정보등록(선택)
		end if
	
	elseif sEventName == "View" then
		if sParam ~= null and sParam ~= "" then
			Form.OpenFramePopup(G_NOTICE_FILE , sParam , "")	
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl81020_t3" then
		if sRet ~= null and sRet ~= "" then
			Form.triggerEvent( "FormTab0."..FormTab0.currenttabpageid, "View", sRet )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sACNT_PWD 
	'v0003 
	if g_plain_rm == "1" then  'MTS메모리평문 적용상태일때
	    sACNT_PWD = EditPW.caption
	else  'MTS메모리평문 미적용상태일때
	    sACNT_PWD = Form.GetEncData(EditPW.caption)
	end if	
	
	if szTranID == "obaci_acct_256r" then
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256r", "InBlock1", "ACNO" , 0 , left(g_sAcc,8) )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256r", "InBlock1", "ASNO" , 0 , mid(g_sAcc, 9, 2) )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256r", "InBlock1", "IQRY_CLS_CODE" , 0 , "A" )
	elseif szTranID == "obaci_acct_256a" then
		Dim sCOMN_YN1, sCOMN_YN2	
		sCOMN_YN1 = Form.GetSharedData("COMN_YN1" , false)
		sCOMN_YN2 = Form.GetSharedData("COMN_YN2" , false)
		
		Dim sPROD_YN1, sPROD_YN2, sPROD_YN3, sPROD_YN4, sPROD_YN5, sPROD_YN6, sPROD_YN7, sPROD_YN8, sPROD_YN9, sPROD_YN10, sPROD_YN11, sPROD_YN12, sPROD_YN13
		sPROD_YN1 = Form.GetSharedData("PROD_YN1" , false)
		sPROD_YN2 = Form.GetSharedData("PROD_YN2" , false)
		sPROD_YN3 = Form.GetSharedData("PROD_YN3" , false)
		sPROD_YN4 = Form.GetSharedData("PROD_YN4" , false)	'민감정보
		sPROD_YN5 = Form.GetSharedData("PROD_YN5" , false)	
		sPROD_YN6 = Form.GetSharedData("PROD_YN6" , false)
		sPROD_YN7 = Form.GetSharedData("PROD_YN7" , false)
		sPROD_YN8 = Form.GetSharedData("PROD_YN8" , false)
		sPROD_YN9 = Form.GetSharedData("PROD_YN9" , false)
		sPROD_YN10 = Form.GetSharedData("PROD_YN10" , false)
		sPROD_YN11 = Form.GetSharedData("PROD_YN11" , false)
		sPROD_YN12 = Form.GetSharedData("PROD_YN12" , false)
		sPROD_YN13 = Form.GetSharedData("PROD_YN13" , false) 'v0002
		
		Dim sDocuVal 
		sDocuVal = Form.GetSharedData("DOCU_VAL" , false)
		
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "SNOT_EMPNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "ACNO" , 0 , left(g_sAcc,8) )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "ASNO" , 0 , mid(g_sAcc, 9, 2) )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "AGRM_RQCL_DOCU_CLCD" , 0 , sDocuVal )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock1", "CRDT_AGRM_BSWR_KIND_CLCD" , 0 , "998" )
		
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock2", "UI_COMN_AGRM_YN1" , 0 , sCOMN_YN1 )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock2", "UI_COMN_AGRM_YN2" , 0 , sCOMN_YN2 )
		
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN1" , 0 , sPROD_YN1 )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN2" , 0 , sPROD_YN2 )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN3" , 0 , sPROD_YN3 )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN4" , 0 , sPROD_YN4 )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN5" , 0 , sPROD_YN5 )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN6" , 0 , sPROD_YN6 )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock3", "UI_COMN_AGRM_YN7" , 0 , sPROD_YN7 )
		
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock4", "UI_COMN_AGRM_YN1" , 0 , sPROD_YN8 )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock4", "UI_COMN_AGRM_YN2" , 0 , sPROD_YN9 )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock4", "UI_COMN_AGRM_YN3" , 0 , sPROD_YN10 )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock4", "UI_COMN_AGRM_YN4" , 0 , sPROD_YN11 )
		
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock5", "UI_COMN_AGRM_YN1" , 0 , sPROD_YN12 )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a", "InBlock5", "UI_COMN_AGRM_YN2" , 0 , sPROD_YN13 )
	elseif szTranID == "obaci_acct_256a_1" then

		Dim sSLCT_YN1, sSLCT_YN2, sSLCT_YN3, sRCMS_YN1, sRCMS_YN2, sRCMS_YN3, sRCMS_YN4
		sSLCT_YN1 = Form.GetSharedData("SLCT_YN1" , false)
		sSLCT_YN2 = Form.GetSharedData("SLCT_YN2" , false)
		sSLCT_YN3 = Form.GetSharedData("SLCT_YN3" , false)
	
		sRCMS_YN1 = Form.GetSharedData("RCMS_YN1" , false)
		sRCMS_YN2 = Form.GetSharedData("RCMS_YN2" , false)
		sRCMS_YN3 = Form.GetSharedData("RCMS_YN3" , false)
		sRCMS_YN4 = Form.GetSharedData("RCMS_YN4" , false)
		
		Dim sDocuVal 
		sDocuVal = Form.GetSharedData("DOCU_VAL" , false)
		
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a_1", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a_1", "InBlock1", "SNOT_EMPNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a_1", "InBlock1", "ACNO" , 0 , left(g_sAcc,8) )
		DATAMANAGER.SetDataValue( 0, "obaci_acct_256a_1", "InBlock1", "ASNO" , 0 , mid(g_sAcc, 9, 2) )
