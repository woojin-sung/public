'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obaci_acct_256r" then
		Dim sNW_AGRM_BSWR_CLCD, sUI_CLS, sNW_AGRM_KIND_CLCD, sAGRM_YN
		Dim nCnt 
		nCnt = DATAMANAGER.GetDataCount( 0, "obaci_acct_256r", "OutBlock2")
		for i = 0 to nCnt -1 
			sNW_AGRM_BSWR_CLCD = DATAMANAGER.GetDataValue( 0, "obaci_acct_256r", "OutBlock2" , "NW_AGRM_BSWR_CLCD" , i )
			sUI_CLS = DATAMANAGER.GetDataValue( 0, "obaci_acct_256r", "OutBlock2" , "NW_AGRM_BSWR_DETL_CLS_CODE" , i )
			sNW_AGRM_KIND_CLCD = DATAMANAGER.GetDataValue( 0, "obaci_acct_256r", "OutBlock2" , "NW_AGRM_KIND_CLCD" , i )
			sAGRM_YN = DATAMANAGER.GetDataValue( 0, "obaci_acct_256r", "OutBlock2" , "CRIN_AGRM_YN" , i )
			
			f_SetYN(sNW_AGRM_BSWR_CLCD, sUI_CLS, sNW_AGRM_KIND_CLCD, sAGRM_YN)
		next
		
		Dim sUI_SLCT_AGRM_YN1, sUI_SLCT_AGRM_YN2, sUI_SLCT_AGRM_YN3
		Dim sPBLT_TLPH_RCMS_YN, sPBLT_SMS_RCMS_YN, sPRML_RCMS_YN, sPBLT_EMAIL_RCMS_YN
		'선택동의
		sUI_SLCT_AGRM_YN1 = DATAMANAGER.GetDataValue( 0, "obaci_acct_256r", "OutBlock3", "UI_SLCT_AGRM_YN1" , 0 )
		sUI_SLCT_AGRM_YN2 = DATAMANAGER.GetDataValue( 0, "obaci_acct_256r", "OutBlock3", "UI_SLCT_AGRM_YN2" , 0 )
		sUI_SLCT_AGRM_YN3 = DATAMANAGER.GetDataValue( 0, "obaci_acct_256r", "OutBlock3", "UI_SLCT_AGRM_YN3" , 0 )
		
		'선택동의(연락방식)
		sPBLT_TLPH_RCMS_YN = DATAMANAGER.GetDataValue( 0, "obaci_acct_256r", "OutBlock3", "PBLT_TLPH_RCMS_YN" , 0 )
		sPBLT_SMS_RCMS_YN = DATAMANAGER.GetDataValue( 0, "obaci_acct_256r", "OutBlock3", "PBLT_SMS_RCMS_YN" , 0 )
		sPBLT_EMAIL_RCMS_YN = DATAMANAGER.GetDataValue( 0, "obaci_acct_256r", "OutBlock3", "PBLT_EMAIL_RCMS_YN" , 0 )
		sPRML_RCMS_YN = DATAMANAGER.GetDataValue( 0, "obaci_acct_256r", "OutBlock3", "PRML_RCMS_YN" , 0 )

		'선택동의
		Form.SetSharedData("SLCT_YN1" , sUI_SLCT_AGRM_YN1) '고유식별정보의처리
		Form.SetSharedData("SLCT_YN2" , sUI_SLCT_AGRM_YN2) '개인신용정보
		Form.SetSharedData("SLCT_YN3" , sUI_SLCT_AGRM_YN3) '상품서비스안내동의
		
		'선택동의(연락방식)
		'v0005
		'Form.SetSharedData("RCMS_YN1" , sPBLT_TLPH_RCMS_YN) '전화
		'Form.SetSharedData("RCMS_YN2" , sPBLT_SMS_RCMS_YN) '문자
		Form.SetSharedData("RCMS_YN1" , sPBLT_SMS_RCMS_YN) '문자
		Form.SetSharedData("RCMS_YN2" , sPBLT_TLPH_RCMS_YN) '전화
		Form.SetSharedData("RCMS_YN3" , sPBLT_EMAIL_RCMS_YN) '이메일
		Form.SetSharedData("RCMS_YN4" , sPRML_RCMS_YN) '우편
		
		
		Form.triggerEvent( "FormTab0."..FormTab0.currenttabpageid, "TabChange", FormTab0.currenttab )
	elseif szTranID == "obaci_acct_255a" then
		Dim sProsDate, sProsSRNO
		sProsDate =  DATAMANAGER.GetDataValue( 0, "obaci_acct_255a", "OutBlock1", "PROS_DATE" , 0 )
		sProsSRNO =  DATAMANAGER.GetDataValue( 0, "obaci_acct_255a", "OutBlock1", "PROS_SRNO" , 0 )
	
		'완료시 이력생성(날짜, 넘버)
		Form.SetSharedData( "PROS_DATE" , sProsDate)
		Form.SetSharedData( "PROS_SRNO" , sProsSRNO)
		
		g_sRetData = "ok"
		
		Dim sMsg, sSubMsg
		sMsg = DATAMANAGER.GetDataMsgText( szTranID )

		Form.MsgBox( "알림", sMsg, "", 6 )
		
		Form.CloseForm()
	elseif szTranID == "obaci_acct_256a" then	
		Dim sMsg, sSubMsg
		sMsg = DATAMANAGER.GetDataMsgText( szTranID )
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			sMsg = sMsg.."("..sSubMsg..")"
		end if
			
		Form.MsgBox( "알림", sMsg, "", 6 )

		'16-03-25 YCJ 필수동의변경이 성공적으로 되었을때 선택동의 화면으로 넘어가게 조치 -> 전요셉 과장님 요청
		FormTab0.currenttab = 1
		FormTab0_OnTabChanged(1)
		
		DATAMANAGER.RequestTranData( "obaci_acct_256r" ) '개인신용정보조회
	elseif szTranID == "obaci_acct_256a_1" then
		Dim sMsg, sSubMsg
		sMsg = DATAMANAGER.GetDataMsgText( szTranID )
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			sMsg = sMsg.."("..sSubMsg..")"
		end if
		
		Form.MsgBox( "알림", sMsg, "", 6 )
		
		DATAMANAGER.RequestTranData( "obaci_acct_256r" ) '개인신용정보조회
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
		Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.."("..sSubMsg..")"
	end if
	
	if szTranID == "obaci_acct_255a" or szTranID == "obaci_acct_256a" or szTranID == "obaci_acct_256a_1"  then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub

'============================================================================
' 계좌 변경
'============================================================================
Sub Account0_ChangeAccount()
	if g_sRevData == null or g_sRevData == "" then
		g_sAcc = Account1.caption
		
		EditPW.caption = ""
		
		DATAMANAGER.RequestTranData( "obaci_acct_256r" ) '개인신용정보조회
	end if 
End Sub

'============================================================================
' 계좌 변경
'============================================================================
Sub Account1_ChangeAccount()
	if g_sRevData == null or g_sRevData == "" then
		g_sAcc = Account1.caption
		
		EditPW.caption = ""
		
		DATAMANAGER.RequestTranData( "obaci_acct_256r" ) '개인신용정보조회
	end if 
End Sub

