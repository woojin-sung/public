'===========================================================================
' 처리 미처리 구분 리턴
'===========================================================================
Function f_SetHandle(sNum, sYN_1, sYN_2, sYN_3 )
	if sNum == "2" then
		if  (sYN_1 == nil or  sYN_1 == "") and (sYN_2 == nil or sYN_2 == "") then '미처리
			return "0" 
		else
			return "1"
		end if
	elseif sNum == "3" then
		if (sYN_1 == nil or sYN_1 == "") and (sYN_2 == nil or sYN_2== "") and (sYN_3 == nil or sYN_3 == "") then '미처리
			return "0" 
		else
			return "1"
		end if
	end if
End Function
'===========================================================================
' OutBlock 값 셋팅
'===========================================================================
Function f_SetYN(sNW_AGRM_BSWR_CLCD, sUI_CLS, sNW_AGRM_KIND_CLCD, sAGRM_YN)
	
	if sNW_AGRM_BSWR_CLCD ~= nil and sNW_AGRM_BSWR_CLCD ~= "" then
'		수집이용(공통)
		if sNW_AGRM_BSWR_CLCD == "1" then
			if sNW_AGRM_KIND_CLCD == "1" then		'수집이용
				LabelCOMNYN1.caption = sAGRM_YN
				Form.SetSharedData("COMN_YN1" , sAGRM_YN) 
			elseif sNW_AGRM_KIND_CLCD == "2" then	'고유식별정보의처리
				LabelCOMNYN2.caption = sAGRM_YN
				Form.SetSharedData("COMN_YN2" , sAGRM_YN) 
			end if
'		수집이용(상품별)
		elseif sNW_AGRM_BSWR_CLCD == "2" then	
			if sUI_CLS == "01" then						'신용공여/미수/파생상품
				if sNW_AGRM_KIND_CLCD == "1" then
					LabelPRODYN1.caption = sAGRM_YN
					Form.SetSharedData("PROD_YN1" , sAGRM_YN)
				elseif sNW_AGRM_KIND_CLCD == "2" then
					LabelPRODYN2.caption = sAGRM_YN
					Form.SetSharedData("PROD_YN2" , sAGRM_YN)
				end if				
			elseif sUI_CLS == "02" then						'비과세종합저축/ISA/연금저축
				if sNW_AGRM_KIND_CLCD == "1" then
					LabelPRODYN3.caption = sAGRM_YN
					Form.SetSharedData("PROD_YN3" , sAGRM_YN)
				elseif sNW_AGRM_KIND_CLCD == "2" then
					LabelPRODYN5.caption = sAGRM_YN
					Form.SetSharedData("PROD_YN5" , sAGRM_YN)
				elseif sNW_AGRM_KIND_CLCD == "3" then	'민감정보
					LabelPRODYN4.caption = sAGRM_YN
					Form.SetSharedData("PROD_YN4" , sAGRM_YN)
				end if
			elseif sUI_CLS == "03" then						'해외주식/해외파생/해외금융/EUREX
				if sNW_AGRM_KIND_CLCD == "1" then
					LabelPRODYN6.caption = sAGRM_YN
					Form.SetSharedData("PROD_YN6" , sAGRM_YN)
				elseif sNW_AGRM_KIND_CLCD == "2" then
					LabelPRODYN7.caption = sAGRM_YN
					
					Form.SetSharedData("PROD_YN7" , sAGRM_YN)
				end if
			end if
'		제공(상품별)
		elseif sNW_AGRM_BSWR_CLCD == "3" then				'신용공여/미수/파생상품/해외파생
			if sUI_CLS == "01" then
				if sNW_AGRM_KIND_CLCD == "1" then
					LabelPRODYN8.caption = sAGRM_YN
					Form.SetSharedData("PROD_YN8" , sAGRM_YN)
				elseif sNW_AGRM_KIND_CLCD == "2" then
					LabelPRODYN9.caption = sAGRM_YN
					Form.SetSharedData("PROD_YN9" , sAGRM_YN)
				end if
			elseif sUI_CLS == "02" then						'해외주식/해외파생/해외금융/EUREX
				if sNW_AGRM_KIND_CLCD == "1" then
					LabelPRODYN10.caption = sAGRM_YN
					Form.SetSharedData("PROD_YN10" , sAGRM_YN)
				elseif sNW_AGRM_KIND_CLCD == "2" then
					LabelPRODYN11.caption = sAGRM_YN
					Form.SetSharedData("PROD_YN11" , v)
				end if
			end if
'		제공(공통)
		elseif sNW_AGRM_BSWR_CLCD == "4" then				'신용공여/미수/파생상품/해외파생
			if sUI_CLS == "01" then
				if sNW_AGRM_KIND_CLCD == "1" then
					LabelPRODYN12.caption = sAGRM_YN
					Form.SetSharedData("PROD_YN12" , sAGRM_YN)
				elseif sNW_AGRM_KIND_CLCD == "2" then
					LabelPRODYN13.caption = sAGRM_YN
					Form.SetSharedData("PROD_YN13" , sAGRM_YN)
				end if
			end if 
		end if
	end if 
	
End Function	
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
