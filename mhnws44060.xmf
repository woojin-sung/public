'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)

	Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "TabChange", nCurrentTab)
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	'20240513 HSZ START: HOME화면 연동 추가
	szOpenData = Form.GetOpenLinkData()
	if Trim(szOpenData) <> "" then
		FormTab0.currenttab = CInt(szOpenData)
	end if
	'20240513 HSZ END
End Sub

