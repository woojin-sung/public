End Sub

'============================================================================
Function Cal_grade(grade)
	
				temp=""
			
			if Cint(grade)= 1  then
				temp="초저위험"
			
			elseif Cint(grade)= 2 then
				temp="초저위험+"
					
			elseif Cint(grade)= 3 then
				temp="저위험"
				
			elseif Cint(grade)= 4 then
				temp="저위험+"
				 	
			elseif Cint(grade)= 5 then
				temp="중위험"
					
			elseif Cint(grade)= 6 then
				temp="중위험+"
					
			elseif Cint(grade)= 7 then
				temp="고위험"
				 	
			elseif Cint(grade)= 8 then
				temp="고위험+"
					
			elseif Cint(grade)= 9 then
				temp="초고위험"
					
			elseif Cint(grade)=10 then
				temp="초고위험+"
			
			else  temp=grade
			
		Cal_grade= temp 	
		
			
	end if

End Function 
'==================================================
Function Cal_type(type1)
					
			temp=""
						
			if Cint(type1)= 1  then
				temp="거치식"
			
			elseif Cint(type1)= 2 then
				temp="적립식"
			
			
			else temp = type1
	
			end if

	 Cal_type =temp
			

End Function 

'=====================================================
Function Cal_region(type1)
					
			temp=""
						
			if Cint(type1)= 1  then
				temp="국내"
			
			elseif Cint(type1)= 2 then
				temp="해외"
			
			
			else temp = type1
	
			end if

	 Cal_region =temp
			

End Function 
