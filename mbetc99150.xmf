	ChartEx0.SetAccrueData("data2="&temp6&";"&temp7&";"&temp8&";"&temp9&";"&temp10&"=2")
	ChartEx0.SetAccrueData("data3=0;0;0;0;0=2")
		
	ChartEx0.setLineColor("상품1;255;0;0")
	ChartEx0.setLineColor("상품2;0;0;255")
	ChartEx0.setLineColor("기준;0;255;0")
		
	ChartEx0.SetPriceFormat("data1^10^2")
	ChartEx0.SetPriceFormat("data2^10^2")
	ChartEx0.SetPriceFormat("data3^10^2")
	
	ChartEx0.SetShowCrossLine("true")                          
	ChartEx0.SetAccrueData("repaintall");


		
		End Function 



'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim forcnt
	forcnt=0
	if sKeyName == "CompOption" then
		if sRet == "true" then
			g_intItemCnt = Form.GetEnvData( "ccomp_itemCnt")
			tmpItem =  Form.GetEnvData( "ccomp_itemList" )
			'tmpCheck = Form.GetEnvData("ccomp_itmeCheck")
			tmpPortfID = Form.GetEnvData("ccomp_PfoID")
	
			g_arrPfID = split(tmpPortfID, "^")
			'arrCheck = split(tmpCheck, "^")
			Button3.enable=false
			Button4.enable=false
			
			for i=0 to g_intItemCnt -1
				'if arrCheck[i] = "1" or arrCheck[i]=""then
					forcnt= forcnt + 1
					g_cmpPFID = g_arrPfID[i]		'체크한 것 포폴ID만 나오는 것 확인
					
			
					if forcnt == 1 then
						DATAMANAGER.SetDataValue(0, "obcpp_rbit_006r", "InBlock1" , "PRTF_ID" , 0 , g_cmpPFID )
						DATAMANAGER.RequestTranData("obcpp_rbit_006r")
						if g_cmpPFID == "" then
						
						else
							Button3.enable=true
						
						end if
						
					end if
			
					if forcnt == 2 then
						DATAMANAGER.SetDataValue(0, "obcpp_rbit_006r_1", "InBlock1" , "PRTF_ID" , 0 , g_cmpPFID )
						DATAMANAGER.RequestTranData("obcpp_rbit_006r_1")
						if g_cmpPFID == "" then
						
						else
							Button4.enable=true
						
						end if
						
						
					end if
			

				'end if
				next
		
			
		end if
	end if
	
	
End Sub

