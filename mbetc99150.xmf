	Form.SetSharedData("Shared_PID" , g_subPfID1)	' 포트폴리오ID
	Form.SetSharedData("Shared_GRADE" , g_subPfgrd1)	' 포트폴리오위험등급코드
	Form.OpenFramePopup( "mbcpp70110.xmf" , "" , "" )
End Sub

