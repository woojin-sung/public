'============================================================================
Sub ChartEx0_OnRequestData(nIndex, sData)

	Data = split(sData, ";")
	
	sCodeData = split(tostring(Trim(Data[0]))    , "@")
	sExid = sCodeData[0] '시장구분
	sCode = sCodeData[1] '종목코드 
	
	g_szItemCode      = tostring(Trim(sCode))             
	g_szItemMarket    = tostring(Trim(Data[3]))             
	nIndex = tonumber(nIndex)

	RequestData()
end Sub  



'============================================================================
Sub Form_OnFormClose()
	sData = RadioGroup0.currentindex.."^"..RadioGroup0.GetRadioCaption( RadioGroup0.currentindex)
	Form.SendReturnToParent("OrientaitonClose" , sData)
End Sub


'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub Form_OnRefresh()
	ChartEx0.setRequestCompareData("0")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	for i = 0 to 4 
		if g_arrItem[i] = "" then
			Exit Sub
		else
			tmpItem = g_arrItem[i]
		end if
		
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD", 0, tmpItem )
		DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )
	next
	
End Sub

		
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	Dim nDecimal
	nDecimal = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_DCPN_CNT" , 0))
	ChartEx0.SetDecimal(nDecimal)
	
	
	tmpItem =  Form.GetEnvData( "mhtro16021_comp_itemList" )
	arrItem = split(tmpItem , "^")
	arrCnt = CInt(#arrItem) -1 

	for i = 0 to arrCnt-1
		
		if arrItem[i] <> "" then			
			itemCode = arrItem[i]
			itemCode = split(itemCode,"@")
			if itemCode[1] == g_szItemCode then
				szValue = itemCode[0].."@"..g_szItemCode

				DATAMANAGER.SetDataValue(0, szTranID , "OutBlock1", "FIDX_ISCD" , 0 , szValue)
			end if
		end if 
	next
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'20220523 HSZ 가로화면 화면집계 서비스호출 추가
	if szTranID = "ohhts_open_001r" then
		szID = Form.GetSharedData("&USER_ID", false )
		szOSType = Form.GetSharedData("&OS_TYPE", false)'1.안드로이드 2.iOS
		if szOSType <> "" then
			szOSType = szOSType + 2
		end if
			
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SORT_CLS" , 0 , szOSType) 'OS_TYPE 3:MTS(안드로이드) 4:MTS(iOS)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NO" , 0 , "16023") '하드코딩(미사용 화면번호)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NAME" , 0 , "비교차트(가로)") '하드코딩
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "USER_ID" , 0 , szID) '최근 로그인 아이디
	end if
	'20220523 HSZ END
End Sub

