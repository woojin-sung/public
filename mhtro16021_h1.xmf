Dim g_szItemCode, g_szItemMarket
Dim g_szChrtType
Dim g_szToday
Dim g_szMinType
Dim g_nItemCnt
Dim g_arrItem 
Dim g_flagMin
Dim gCurInd
Dim g_flagInit
Dim g_rtChk

g_flagMin = false
gCurInd = 0
g_flagInit = true
g_szChrtType = "D" '일
g_arrItem = {"","","","",""}
'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.SetChartType("compare")
	ChartEx0.SetMarketCategory("7")
End Sub
'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData("ohhts_open_001r") '20220523 HSZ : 가로화면 화면집계 서비스호출 추가
	g_intItemCnt = Form.GetEnvData( "mhtro16021_comp_itemCnt" )
	tmpItem =  Form.GetEnvData( "mhtro16021_comp_itemList" )
	tmpCheck = Form.GetEnvData("mhtro16021_comp_itmeCheck")
	g_szToday = Form.GetSharedData("&HOST_DATE", 0 )
	
	tmpPeriod = Form.GetOpenLinkData( )

	if g_intItemCnt = "" then
		Exit Sub		
	end if
	if tmpPeriod = "" then
		Exit Sub
	end if

	szMin0 = Form.GetEnvData( "mhtro16021_chart_min0" )
	if szMin0 = "" or szMin0 = 0 then
		szMin0 = "1"
	end if
	
	RadioGroup0.SetRadioCaption( 3, szMin0.."분" )	
	
	if g_intItemCnt = "" then
		if g_szItemCode = "" or g_szItemCode = null then
			g_szItemCode = tmpPeriod
		end if
		
		Form.SetEnvData( 1, "mhtro16021_comp_itemCnt", "1" )
		Form.SetEnvData( 1, "mhtro16021_comp_itemList", g_szItemCode.."^" )
		Form.SetEnvData( 1, "mhtro16021_comp_itmeCheck", "".."^")
		
		'g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market") 
		
		outStrName = Form.GetItemCodeInfo( g_szItemCode , "name")
		sCodeData = split(g_szItemCode, "@")
		sExid = sCodeData[0] '시장구분
		sCode = sCodeData[1] '종목코드 
		ChartEx0.SetCurCodeName(sExid..";"..g_szItemCode..";"..outStrName)
		ChartEx0.SetCompareData("^"..g_szItemCode.."^"..outStrName.."^"..sExid)
			
	else
		g_arrItem = split(tmpItem , "^")
		arrCheck = split(tmpCheck , "^")
		arrPeriod = split(tmpPeriod , "^")
	'	ChartEx0.SetDataClear("1")
	
		for i = 0 to g_intItemCnt - 1
			if arrCheck[i] = "1" or arrCheck[i] = "" then
				
				g_szItemCode = g_arrItem[i]
				outStrName = Form.GetItemCodeInfo( g_szItemCode , "name")
				sCodeData = split(g_szItemCode, "@")
				sExid = sCodeData[0] '시장구분
				sCode = sCodeData[1] '종목코드 
				ChartEx0.SetCurCodeName(sExid..";"..g_szItemCode..";"..outStrName)
				ChartEx0.SetCompareData("^"..g_szItemCode.."^"..outStrName.."^"..sExid)
			end if
		next
		
		if arrPeriod[0] = "3" then
			RadioGroup0.SetRadioCaption( arrPeriod[0], arrPeriod[1] )
		end if
		RadioGroup0.currentindex = CInt(arrPeriod[0])
	
	end if
	ChartEx0.setRequestCompareData("1")
End Sub

'============================================================================
Function RequestData()

	DATAMANAGER.CancelRealData("ohhts_exst_cntg")
	
	szStockMode = "0"
	if g_sStockMode = "0" then
		szStockMode = "1"
	end if
	g_rtChk = Form.GetSharedData( "REALTIME_"..g_szItemMarket, false )
	
	if g_szChrtType == "A" then		'분
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 	0, "OV" )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock1", "FID_COND_MRKT_CLS_CODE", 			0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock1", "FID_INPUT_OVRS_ISCD", 			0, g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 			0, g_rtChk )
		

		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 	0, "OV" )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FID_COND_MRKT_CLS_CODE", 			0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FID_INPUT_OVRS_ISCD", 			0, g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 0, g_rtChk)
		
		sMin = Split(g_szMinType, "분", -1, 1)
		sTemp = sMin[0] * 60
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE", 0, sTemp )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FID_INPUT_DATE1" ,0,g_szToday)	
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0,"Y")
		
		DATAMANAGER.RequestTranData("ohhts_5041_005r")
	elseif g_szChrtType == "D" then	'일
	
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 	0, "OV" )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE", 			0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock1", "FID_INPUT_OVRS_ISCD", 			0, g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 	0, "OV" )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock2", "FID_COND_MRKT_CLS_CODE", 			0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock2", "FID_INPUT_OVRS_ISCD", 			0, g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE", 0, szStockMode )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock2", "FID_INPUT_DATE1" ,0, g_szToday)	
		
		DATAMANAGER.RequestTranData("ohhts_5041_001r")
	elseif g_szChrtType == "M" then	'월
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 	0, "OV" )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_003r", "InBlock1", "FID_COND_MRKT_CLS_CODE", 			0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_003r", "InBlock1", "FID_INPUT_OVRS_ISCD", 			0, g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_003r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 	0, "OV" )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_003r", "InBlock2", "FID_COND_MRKT_CLS_CODE", 			0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_003r", "InBlock2", "FID_INPUT_OVRS_ISCD", 			0, g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_003r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_003r", "InBlock2", "FID_INPUT_DATE1" ,0, g_szToday)	
		
		DATAMANAGER.RequestTranData("ohhts_5041_003r")
	elseif  g_szChrtType == "W" then'주

		DATAMANAGER.SetDataValue( 0, "ohhts_5041_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 	0, "OV" )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_002r", "InBlock1", "FID_COND_MRKT_CLS_CODE", 			0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_002r", "InBlock1", "FID_INPUT_OVRS_ISCD", 			0, g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_002r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_002r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 	0, "OV" )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_002r", "InBlock2", "FID_COND_MRKT_CLS_CODE", 			0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_002r", "InBlock2", "FID_INPUT_OVRS_ISCD", 			0, g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_002r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_002r", "InBlock2", "FID_INPUT_DATE1" ,0, g_szToday)	
		
		DATAMANAGER.RequestTranData("ohhts_5041_002r")
	End If
	
end Function

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	if nIndex == 0 then  '일
		g_szChrtType = "D"	
		PeriodSet(g_szChrtType)
	elseif nIndex == 1 then  '주
		g_flagMin = false
		g_szChrtType = "W"
		PeriodSet(g_szChrtType)
	elseif nIndex == 2 then  '월
		g_flagMin = false
		g_szChrtType = "M"
		PeriodSet(g_szChrtType)
	elseif nIndex == 3 then   '분
		g_szChrtType = "A"
		tmpMin = Split(RadioGroup0.GetRadioCaption( nIndex ), "분")
		g_szMinType = tmpMin[0]
		if g_flagMin == false then
			g_flagMin = true
			PeriodSet(g_szChrtType)
		else
			g_flagMin = false		
			Form.OpenPopup( "mhtro16020_p3.xmf" , g_szMinType , "" )
		end if
			
	end if
	
End Sub

'============================================================================

Sub BtnSave_OnClick()
	ChartEx0.SetOpenDlg("save;BtnSave")
End Sub

'============================================================================
Sub BtnIndi_OnClick()
	ChartEx0.SetOpenDlg("indicatormini;BtnIndi")
End Sub

'============================================================================
Sub BtnTool_OnClick()
	ChartEx0.SetOpenDlg("tools;BtnTool")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "Chart_Min" then
		sMin = Split(sRet,"분")
		RadioGroup0.SetRadioCaption( 3, sRet)
		g_szMinType = sMin[0]
		PeriodSet(g_szChrtType)
	elseif sKeyName == "CompOption" then
		
		g_intItemCnt = Form.GetEnvData( "mhtro16021_comp_itemCnt" )
		tmpItem =  Form.GetEnvData( "mhtro16021_comp_itemList" )
		tmpCheck = Form.GetEnvData("mhtro16021_comp_itmeCheck")
		
		if g_intItemCnt = "" then
			Exit Sub		
		end if
		g_arrItem = split(tmpItem , "^")
		arrCheck = split(tmpCheck , "^")

		ChartEx0.SetDataClear("1")
		for i = 0 to g_intItemCnt - 1
			if arrCheck[i] = "1" then
				g_szItemCode = g_arrItem[i]
				outStrName = Form.GetItemCodeInfo( g_szItemCode , "name")
				sCodeData = split(g_szItemCode, "@")
				sExid = sCodeData[0] '시장구분
				sCode = sCodeData[1] '종목코드 
				ChartEx0.SetCurCodeName(sExid..";"..g_szItemCode..";"..outStrName)
				ChartEx0.SetCompareData("^"..g_szItemCode.."^"..outStrName.."^"..sExid)
			end if

		next
		ChartEx0.setRequestCompareData("1")

	end if
End Sub
	
'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================

function ChartEx0_OnGetPeriodInfo()
	Dim sPeriodType
	sPeriodType = ""
	Dim sMin, sTic
   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	for i = 0 to 8
		sMin = Form.GetEnvData( "mhtro16021_chart_min"..i )	'분차트
		if sMin <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sMin&"/"
			else
				sPeriodType = sPeriodType&sMin&";"
			end if
		end if
	next

	if sPeriodType <> "" then
		ChartEx0.setSyncPeriodValueToChart(sPeriodType)
	end if
end function

function ChartEx0_OnChangePeriod(sPeriodType)
	sMinArr = {}
	sTicArr = {}
	sDataArr = {}
	
	g_sIsRequestChartEvent = "1"

   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
   if InStr(sPeriodType, "/") > 0 then
	   sTemp = split(sPeriodType, "/")
	   sMinArr = split(sTemp[0], ";")
	   sTicArr = split(sTemp[1], ";")
	   Form.Log("sPeriodType",sPeriodType)
	   
	   for i = 0 to 7 step 1
		Form.SetEnvData( 1, "mhtro16021_chart_min"..i, sMinArr[i] )
		
		Form.SetEnvData( 1, "mhtro16021_chart_tic"..i, sTicArr[i] )

	   next
   end if
end function


'============================================================================
' 차트 설정 개수 변경시
'============================================================================
function ChartEx0_OnByNumber(Count)

   if #Count == 1 then
	   Count = "000"..Count
   elseif #Count == 2 then
	   Count = "00"..Count
   elseif #Count == 3 then
	   Count = "0"..Count
   end if

	g_sChartCnt = Count
	
	RequestData()
end function


'============================================================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'============================================================================
function PeriodSet(sPeriodType)


'	Form.ShowAlert("", sIndex..":"..sPeriod)
	
	if sPeriodType= "A" then
	   g_sPeriod = CInt(g_szMinType)
	   g_sPeriodType = "1"
	elseif sPeriodType= "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod ="1"
	elseif sPeriodType= "W" then 
	   g_sPeriodType = "3"
	    g_sPeriod ="1"
	elseif sPeriodType= "M" then 
	   g_sPeriodType = "4"
	    g_sPeriod ="1"
	end if
   sPeriod = CInt( g_sPeriod)
   if Len( sPeriod )= 1 then
	   g_sPeriod = "00"..g_sPeriod
	elseif Len( sPeriod )= 2 then
	   g_sPeriod = "0"..g_sPeriod
	end if
   ChartEx0.SetPeriodType(g_sPeriodType)
   ChartEx0.SetPeriodTime(g_sPeriod)

'   
	' 조회TR 보내기
	ChartEx0.setRequestCompareData("0")
end function


