		<BUTTON name="Button0" caption="리스트 원문 보기" btnimage="btn_20.9" ly_vert="0,695,375,60,1" />
		<WEBVIEW name="WebView0" urlpath="about:blank" ly_vert="20,146,335,525,1" />
		<IMAGE name="imgBack" autosize="1" imgpath="icon_main_01" ly_vert="6,11,40,24,1" />
		<LABEL name="lblTitle0" fontsize="4" caption="ETF 리포트 요약" bgcolor="064:239059036" ly_vert="40,12,195,23,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="2808" _ulen="2728" >

Dim g_szFile
Dim g_szSeq

'============================================================================
Sub Form_OnFormInitBefore()
	imgBack.setMaintainingRatio("2")
End Sub

'============================================================================
Sub Form_OnFormInit()
	'웹뷰 확대기능 off
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		WebView0.fitresize = "0"
	end if 
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
'		Form.ShowAlert("", szOpenData)
		Dim tSplit
		tSplit = split(szOpenData, "★")
		if #tSplit > 0 then
			lblTitleText.caption = tSplit(0)
			lblSub.caption = tSplit(1)
			
			g_szFile = tSplit(2)
			g_szSeq = tSplit(3)
			
			'ETF 리서치 게시물 조회
			DATAMANAGER.RequestTranData( "ooopc_rprt_004r" )
		end if
	end if
End Sub

'============================================================================
Sub Button0_OnClick()
	Dim szMode, szUrl, szFileName
	
	szMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	if CInt(szMode) == 0 then
		szUrl = "https://home.imeritz.com/include/resource/research/WorkFlow"	'운영계 주소
	elseif CInt(szMode) == 1 then
		szUrl = "https://testhome.imeritz.com/include/resource/research/WorkFlow"	'테스트계주소
	end if
	
	szFileName = Trim(szUrl) & "/" & g_szFile
	
	Form.OpenPdfViewer(szFileName, "ETF 리포트")
End Sub

'============================================================================
Sub imgBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ooopc_rprt_004r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_GRP_ID" , 0 , "bascGrp")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_CNTT_TURN_NO" , 0 , g_szSeq)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_ID" , 0 , "sih02")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ooopc_rprt_004r" then
		Dim szCntt
		szCntt = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "UI_AGNT_NTC_HTML_CNTT" , i )
'		Form.ShowAlert("szCntt", szCntt)
		
		WebView0.loaddata = szCntt
	end if 
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szMsgText, szSubText
	szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
	szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
	if szSubText <> "" and szSubText <> null then
		Form.ShowAlert("알림", szMsgText & "(" & szSubText &")")
	else
		Form.ShowAlert("알림", szMsgText)
	end if
End Sub

