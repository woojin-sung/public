<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="56060" scrname="ISA설명서조회" version="2" writer="고승연" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="imgBg" imgpath="popup_bg.9" ly_vert="0,0,375,647,1" />
		<BUTTON name="btnCancel" caption="취소" fgcolor="004:000000000" btnimage="btn_pop1.9.png" ly_vert="0,595,187,50,1" />
		<BUTTON name="btnOk" fgcolor="004:000000000" btnimage="btn_pop2.9.png" ly_vert="187,595,188,50,1" />
		<LABEL name="lblTitl0" fontsize="2" fontstyle="01" halign="1" ly_vert="0,0,375,20,1" />
		<WEBVIEW name="WebView0" urlpath="about:blank" ly_vert="-2,30,379,565,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1973" _ulen="1895" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 가입 설명서 조회
' 02. 화면설명 : 
' 03. 작    성 : 2023.12.04 : 고승연 : v0001 : [T2310260012] 온라인 설명의무 가이드 적용
' 04. 수    정 : 
'-------------------------------------------------------------------------------------------
Dim g_nTimerSec
Dim g_bAgree

'============================================================================
Sub Form_OnFormInitBefore()
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	szOpenData = Form.GetOpenLinkData()
	tData = Split(szOpenData, "|")
	
	WebView0.urlpath = tData(0)
	lblTitl0.caption = tData(1)

	imgBg.top = Form.GetCtlProp("WebView0", "top") - 15
	imgBg.height = 647 - (Form.GetCtlProp("WebView0", "top") - 15)
	
	' 5초 카운트
	g_nTimerSec = 5
	btnOk.enable = false
	btnOk.caption = g_nTimerSec
	Form.SetTimerEvent(1000, 1, 1)	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)

	sTimerID = CInt(sTimerID)
	
	If sTimerID == 1000 Then
	
		If g_nTimerSec == 1 Then
		
			Form.SetTimerEvent(1000, 0, 1)
			
			btnOk.caption = "확인"
			btnOk.enable = true	
		
		Else
			g_nTimerSec = g_nTimerSec - 1
			btnOk.caption = g_nTimerSec
			
		End If
		
	End If
	
End Sub

'============================================================================
Sub btnCancel_OnClick()
	g_bAgree = false
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOk_OnClick()
	g_bAgree = true
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()

	if g_bAgree == true then
		Form.SendReturnToParent("mbisa56060_pg", "AGREE")
	else
		Form.SendReturnToParent("mbisa56060_pg", "CANCEL")
	end if
	
End Sub



	</SCRIPT_INFO>
</ROOT>