'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	Dim szList

	if g_szCode == "" then
		Exit Sub
	end if
	
	if sKeyName == "MOVEPOP_RETURN" then
		szList = Split(sRet , "★")
		
		Select Case szList(1)
			Case "0"		'현재가
				Form.OpenScreen("11000" , g_szCode & "★" & "0")
			Case "1" 	'차트
				Form.OpenScreen("13000" , g_szCode)
			Case "2" 	'관심등록
				Form.OpenPopup( "mhprc11000_pd" , g_szCode , sPosInfo)
			Case "3" 	'매수
				Form.OpenScreen("12000" , "관심종목" & "★" & "0" & "★" & g_szCode)
			Case "4" 	'매도
				Form.OpenScreen("12000" , "관심종목" & "★" & "1" & "★" & g_szCode)
		End Select
	
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	FormTab0.currenttab = 0
	FormTab0_OnTabChanged(0)
End Sub


'============================================================================
Sub InsertTab1()
	FormTab0.insertPage( 0, "page0", "page0", "empty", "0", " 조회수 ")
	FormTab0.insertPage( 1, "page1", "page1", "empty", "0", " 상승률 ")
	FormTab0.insertPage( 2, "page2", "page2", "empty", "0", " 하락률 ")	'20231214 HSZ: 하락률 추가
	FormTab0.insertPage( 3, "page3", "page3", "empty", "0", " 외국인 ")
	FormTab0.insertPage( 4, "page4", "page4", "empty", "0", "  기관  ")	
	FormTab0.insertPage( 5, "page5", "page5", "empty", "0", "거래대금")
	FormTab0.insertPage( 6, "page6", "page6", "empty", "0", " 거래량 ")
End Sub
'============================================================================
Sub InsertTab2()
	FormTab0.insertPage( 0, "page0", "page0", "empty", "0", "조회수")
	FormTab0.insertPage( 1, "page1", "page1", "empty", "0", "상승률")
	FormTab0.insertPage( 2, "page2", "page2", "empty", "0", "하락률")  '20231214 HSZ: 하락률 추가
	FormTab0.insertPage( 3, "page3", "page3", "empty", "0", "외국인")
	FormTab0.insertPage( 4, "page4", "page4", "empty", "0", "기관")	
	FormTab0.insertPage( 5, "page5", "page5", "empty", "0", "거래대금")
