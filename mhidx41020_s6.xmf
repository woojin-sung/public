'============================================================================
' 01. 화 면 명 : 메리츠TOP50
' 02. 화면설명 : 메리츠TOP50
' 03. 작    성 : 2016. 02. 15. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szCode			'종목코드
Dim g_nCount			'항목개수
g_nCount = 0 			'20210916 SWJ START
Dim g_nHour			'시간
Dim g_nMinute			'분

'시장종합 개편 추가
dim	g_szRSelect
g_szRSelect = "0"

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'20211005 아이티젠(김성수) START
'시장종합 개편 추가
'============================================================================
' Set_Real_Input : real_input 정의 (0현재, 1예상, 2단일)
'============================================================================
Function Set_Real_Input(szMk, nIdx, szCd)
	DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신

'	Select Case szMk
'		Case "J", "Q"				' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권
'			if g_szRSelect == "0" then
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
'			end if
'			
'		Case "F", "MF"		' KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드
'			if g_szRSelect == "0" then
'				DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신
'			end if 
'			
'		Case "O", "MO"		' KOSPI지수 옵션, 미니코스피 옵션
'			if g_szRSelect == "0" then
'				DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 체결 자동갱신
'			end if 
'			
'		Case "U"		' 업종코드
'			if g_szRSelect == "0" then
'				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 체결 자동갱신
'			end if 
'		
'		Case "T"		' K-OTC(프리보드)
'			if g_szRSelect == "0" then
'				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
'			end if 
'		
'		Case "W"		' ELW
'			if g_szRSelect == "0" then
'				DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW체결 자동갱신
'			end if 
'			
'		Case "N"	' 해외지수
'			if g_szRSelect == "0" then
'				DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외지수/종목 체결 자동갱신
'			end if 
'		
'		Case "B"	' 소액채권, 장내채권
'			if g_szRSelect == "0" then
'				DATAMANAGER.SetDataValue(1, "ohhts_bond_cntg", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 체결 자동갱신
'			end if
'			
'		Case "EN"		' 세계환율
'			if g_szRSelect == "0" then
'				DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 환율 체결 자동갱신
'			end if 			
'
'	End Select
End Function

'============================================================================
' Real_RequestData : Real 요청 (0현재, 1예상, 2단일)
'============================================================================
Function Real_RequestData(szMk)
	DATAMANAGER.RequestRealData("ohhts_stck_incg")		' 주식체결 자동갱신
'	Select Case szMk
'		Case "J", "Q"				' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권
'			if g_szRSelect == "0" then
'				DATAMANAGER.RequestRealData("ohhts_stck_incg")		' 주식체결 자동갱신
'			end if
'			
'		Case "F", "MF"		' KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드
'			if g_szRSelect == "0" then
'				DATAMANAGER.RequestRealData("ohhts_futs_cntg")		' 선물 체결 자동갱신
'			end if 
'			
'		Case "O", "MO"		' KOSPI지수 옵션, 미니코스피 옵션
'			if g_szRSelect == "0" then
'				DATAMANAGER.RequestRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
'			end if 
'			
'		Case "U"		' 업종코드
'			if g_szRSelect == "0" then
'				DATAMANAGER.RequestRealData("ohhts_nmix_cntg")		' 업종지수 체결 자동갱신
'			end if 
'		
'		Case "T"		' K-OTC(프리보드)
'			if g_szRSelect == "0" then
'				DATAMANAGER.RequestRealData("ohhts_frbr_cntg")		' 프리보드체결 자동갱신
'			end if 
'		
'		Case "W"		' ELW
'			if g_szRSelect == "0" then
'				DATAMANAGER.RequestRealData("ohhts_elw_cntg")			' ELW체결 자동갱신
'			end if 
'
'		Case "N"	' 해외지수
'			if g_szRSelect == "0" then
'				DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")		' 해외지수/종목 체결 자동갱신
'			end if 
'		
'		Case "B"	' 소액채권, 장내채권
'			if g_szRSelect == "0" then
'				DATAMANAGER.RequestRealData("ohhts_bond_cntg")		' 일반채권 체결 자동갱신
'			end if
'			
'		Case "EN"		' 세계환율
'			if g_szRSelect == "0" then
'				DATAMANAGER.RequestRealData("ohhts_exrt_cntg")		' 환율 체결 자동갱신
'			end if			
'	End Select
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Label0.fgcolor = 334

	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 5) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	
	sDeviceOS = Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
		
	if sDeviceOS = "2" then	'OS별 패딩차이
		InsertTab1()
	else	
		InsertTab2()
	end if
	FormTab0.currenttab = 0
	FormTab0_OnTabChanged(0)
	
	grd2.scrollenable = "0"
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "ohhts_top50_002" then
		DATAMANAGER.RequestTranData("ohhts_1020_001r")
	else
	
		for i = 0 to 4
			grd2.SetCellData( "bd_cell0" , i , i+1)
			nVrssSign = CInt(grd2.GetCellData("bd_cell4", i))
			Select Case nVrssSign
				Case 1, 2
					grd2.SetCellFgColor( "bd_cell5", i, "10")
					grd2.SetCellFgColor( "bd_cell1", i, "10")
					grd2.SetCellFgColor( "bd_cell3", i, "10")
				Case 4, 5
					grd2.SetCellFgColor( "bd_cell5", i, "11")
					grd2.SetCellFgColor( "bd_cell1", i, "11")
					grd2.SetCellFgColor( "bd_cell3", i, "11")
				Case Else
					grd2.SetCellFgColor( "bd_cell5", i, "12")
					grd2.SetCellFgColor( "bd_cell1", i, "12")
					grd2.SetCellFgColor( "bd_cell3", i, "12")
			End Select
		next

		' 실시간을 위한 작업 //////////////////////////////////////////////
		For j = 0 to 4
			Dim szCd, szMk
			szCd = grd2.GetCellData("bd_code", j)
				
			if szCd <> "" then
				szMk = Form.GetItemCodeInfo(szCd, "market")
					
				if szMk <> "" then
					Set_Real_Input(szMk, j, szCd)
				end if
			end if
		Next
		Real_RequestData(szMk)
	end if
	
	grd2.rowcount = 5
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	grd2.SetClear()
	DATAMANAGER.CancelRealData("ohhts_stck_incg")
	if szTranID == "ohhts_1020_001r" then
		g_nCount = 0
		for i = 0 to CDbl(DATAMANAGER.GetDataCount( 0 , "ohhts_top50_002", "OutBlock2")) - 1
			if DATAMANAGER.GetDataValue( 0 , "ohhts_top50_002", "OutBlock2", "FID_CNCN_ISCD" , i) <> "" then
				DATAMANAGER.SetDataValue( 0 , "ohhts_1020_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , g_nCount , grd1.GetCellData("bd_cell1", i))
				DATAMANAGER.SetDataValue( 0 , "ohhts_1020_001r", "InBlock1", "FID_INPUT_ISCD" , g_nCount , grd1.GetCellData("bd_cell0", i))
				g_nCount = g_nCount + 1
				if g_nCount = 5 then
					exit for
				end if
			end if
		next
	
	elseif szTranID == "ohhts_1751_001r" then
		g_szMarginType = "11111"
		g_szEtfEtn = "00"
		g_szExceptItem = "0000000"
		nTab = CInt(FormTab0.currenttab)
		if nTab = 1 then
			DATAMANAGER.SetDataValue( 0 , "ohhts_1751_001r", "InBlock1", "FID_INPUT_DIV_CLS_CODE" , 0 , "7" )
		elseif nTab = 2 then
			DATAMANAGER.SetDataValue( 0 , "ohhts_1751_001r", "InBlock1", "FID_INPUT_DIV_CLS_CODE" , 0 , "8" )
		end if
		
		DATAMANAGER.SetDataValue( 0, "ohhts_1751_001r", "InBlock1", "FID_INPUT_ISCD", 0, "000000" )
		DATAMANAGER.SetDataValue( 0, "ohhts_1751_001r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE", 0, "0" )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_1751_001r", "InBlock1", "FID_INPUT_TRGT_CLS_CODE", 0, g_szMarginType )
		DATAMANAGER.SetDataValue( 0, "ohhts_1751_001r", "InBlock1", "FID_INPUT_TRGT_EXLS_CLS_CODE", 0,  g_szExceptItem & "  " & g_szEtfEtn )
		DATAMANAGER.SetDataValue(  0 ,"ohhts_1751_001r", "InBlock1", "FID_INPUT_PRC1" , 0, "" )
		DATAMANAGER.SetDataValue(  0 ,"ohhts_1751_001r", "InBlock1", "FID_INPUT_PRC2" , 0, "" )
		DATAMANAGER.SetDataValue(  0 ,"ohhts_1751_001r", "InBlock1", "FID_INPUT_VOL1"  , 0, "" )
	end if
	
End Sub

