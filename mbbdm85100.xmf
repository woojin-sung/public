Dim g_szOpenType

'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.setMaintainingRatio("1")
	ImgInfo.setMaintainingRatio("1")
	
	Image0.setMaintainingRatio("1")
	Image1.setMaintainingRatio("1")
	Image2.setMaintainingRatio("1")
	
	imgArrow1.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")
	
	Label11.setHighlight(332, 0, 6)
	
	Label2.changeTextAttr(5, 3, 4, 0, true)
	Label3.changeTextAttr(0, 3, 4, 0, true)
	Label4.changeTextAttr(5, 2, 4, 0, true)
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	'szOpenData = "기타★Super365Acnt★"
	if szOpenData <> "" and szOpenData <> null then
		Dim tSplit
		tSplit = Split(szOpenData, "★")
		
		'20230904 웹으로부터 연동된 슈퍼365 개설루트
		if tSplit(1) == "Super365Acnt" then
		    g_szOpenType = "Super365Acnt"
	    end if
	    
	    if #tSplit > 2 then
			if tSplit(2) == "Super365Acnt" then
				g_szOpenType = "Super365Acnt"
			end if
		end if
		
		if g_szOpenType == "Super365Acnt" then
			Label1.caption = "Super365 계좌개설 안내"
			
			Button1.visible = false
			imgArrow1.visible = false
		end if
	end if
End Sub

