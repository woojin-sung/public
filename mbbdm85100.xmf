'============================================================================
Sub Button0_OnClick()
	User_SharedData_All_Init()
	
	'20230904 웹으로부터 연동된 슈퍼365 개설루트
	if g_szOpenType == "Super365Acnt" then
		Form.SetSharedData("BDM_MANG_BRCD" , "1065")  
		Form.SetSharedData("BDM_PRCD200"	, "Y"	)
		Form.SetSharedData("BDM_NMETBSWRGB"  , "100"   )
		Form.SetSharedData("BDM_BDM_FRST_MAPID"  , "mbbdm85100"   )
		
		'휴대폰 인증 단계
		Form.OpenNextPopup("mbbdm86130" , "Super365Acnt" , "")
		
	else
		Form.SetSharedData("BDM_NMETBSWRGB" , "100")
		Form.SetSharedData("BDM_FRST_MAPID" , "mbbdm85100")
		
		'관리점 선택 화면
		Form.OpenNextPopup("mbbdm86110" , "" , "")
	end if
End Sub

