	<SCRIPT_INFO _len="2329" _ulen="2223" >
'--===========================================================================
'--===========================================================================


Dim g_szSelectRow
'============================================================================
Sub Button1_OnClick()

	if Grid0.rowcount == 5 or g_szSelectRow == "" then
		Form.MsgBox("알림","기존 등록된 기기를 먼저 해지 후 등록 가능합니다.")
	else
		Form.SendReturnToParent( "mbonl86011_p4" , g_szSelectRow )
		Form.CloseForm( )
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	'Grid0.rowcount = 5
	g_szSelectRow = ""
	
	Form.SetTimerEvent2(1, 1, 0.05)
	
	Dim szData
	Dim szList
	szData = Form.GetOpenLinkData()
	
	szList = Split(szData, "◆")
	
	if UBOUND(szList) < 1 then
		Exit sub
	End if
	
	Dim idx
	
	for i = 1 to 5
		idx = i * 4 - 3
		Grid0.SetCellData("bd_cell0", i-1, szList[idx])'날짜
		Grid0.SetCellData("bd_cell1", i-1, szList[idx - 1])'이름
	next
	
	Button1.btnimage = "btn_21.9"
	'Button1.enable = 0
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	if szCellID == "bd_cell2" then
		g_szSelectRow = g_szSelectRow .. "◆".. lRow
		Grid0.SetDeleteRow(lRow)
		Label11.caption = Grid0.rowcount
		
		Button1.btnimage = "btn_20.9"
		'Button1.enable = 1
	end if
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용_백버튼
	Form.CloseForm()
End Sub

'============================================================================
'Sub imgExit_OnClick()	'X버튼 클릭시
'	Form.CloseForm()
'End Sub

'============================================================================
'여백클릭시 꺼지도록 함
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)

	if Cint(sTimerID) == 1 then
		Form.SetTimerEvent2(Cint(sTimerID), 0, 0.5)
		
		for i = 1 to 5
			Grid0.setMaintainingRatio("bd_cell2", i-1, "1")
			Grid0.SetCellImage("bd_cell2",i-1, "icon_remove")
		next
	end if
End Sub

