<ROOT>
	<MAP_INFO scrno="70030" scrname="투자 성향 진단_탭1" version="2" writer="이학록" />
	<FORM_INFO name="Form" ly_vert="0,0,375,562,1" />
	<CONTROL_INFO>
		<EDIT name="Edit0" fontsize="-2" mask="0,0,,,0,,0,1,1" halign="2" imetype="1" ly_vert="159,107,65,30,1" />
