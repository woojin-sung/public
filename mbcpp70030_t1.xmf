		<LABEL name="Label3" fontsize="-2" caption="동안 투자하기를 원합니다" ly_vert="151,174,234,34,1" />
		<LABEL name="Label4" fontsize="-2" caption="저의 연간 소득은" ly_vert="45,310,143,33,1" />
		<EDIT name="Edit2" fontsize="-2" mask="0,0,,만원,0,,0,1,1" halign="2" imetype="1" hintcaption="만원" ly_vert="164,311,110,30,1" />
		<LABEL name="Label5" fontsize="-2" caption="이며," ly_vert="273,310,49,34,1" />
		<LABEL name="Label6" fontsize="-2" caption="그 중" ly_vert="46,362,62,33,1" />
		<EDIT name="Edit3" fontsize="-2" mask="0,0,,%,0,,0,1,1" halign="2" imetype="1" maxlength="3" hintcaption="%" ly_vert="92,363,70,30,1" />
		<LABEL name="Label7" fontsize="-2" caption="를 투자할 수 있습니다" ly_vert="162,362,196,34,1" />
		<EDIT name="Edit1" fontsize="-2" mask="0,0,,개월,0,,0,1,1" halign="2" imetype="1" hintcaption="개월" ly_vert="72,174,85,30,1" />
		<LABEL name="Label0" fontsize="-2" caption="제 나이는" ly_vert="83,109,71,34,1" />
		<LABEL name="Label1" fontsize="-2" caption="세 입니다" ly_vert="220,107,106,34,1" />
		<LABEL name="Label8" bgcolor="001:213049051" transmode="0" ly_vert="44,259,300,1,1" />
		<LABEL name="Label9" bgcolor="001:213049051" transmode="0" ly_vert="34,69,300,1,1" />
		<LABEL name="Label10" bgcolor="001:213049051" transmode="0" ly_vert="44,439,300,1,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="4042" _ulen="3914" >
--===========================================================================
Dim age_score
Dim age_value
Dim invst_monthly_score
Dim invst_monthly_value
Dim earn_score
Dim earn_value
Dim invst_percent_score
Dim invst_percent_value

--===========================================================================



'============================================================================
Sub Edit0_OnEditComplete()
	dim age	'나이
	
	age = CInt(Edit0.caption)
	
	
	if  age > 0 then
		if  age <= 19 then
			age_score = 4
		elseif age >= 20 and age <= 40 then
			age_score = 4
		elseif age >= 41 and age <= 50 then
			age_score = 3
		elseif age >= 51 and age <= 60 then
			age_score = 2
		elseif age >= 61 and age <= 70 then
			age_score = 1
		else
			age_score = -1
		end if
	else
		Form.SetSharedData("Age_Score", "")
		
	end if
	
	age_value = age

	
	if age_value > 0 then
		Form.SetSharedData("Age_Value", age_value)
		Form.SetSharedData("Age_Score", age_score)
	else
		Form.ShowAlert("알림","나이를 입력해주십시오")
	end if
	
	
	
	
End Sub

'============================================================================

'============================================================================
Sub Edit2_OnEditComplete()
	dim earn '연소득
	
	earn = CInt(Edit2.caption)
	
	if earn >= 0 and Edit2.caption <> "" then
		if earn <= 2000 then
			earn_score = 1
		elseif earn > 2000 and earn <= 3000 then
			earn_score = 2
		elseif earn > 3000 and earn <= 5000 then
			earn_score = 4
		else
			earn_score = 6
		end if
		
	else
		Form.SetSharedData("Earn_Score", "")
	end if
	
	earn_value = earn
	

	if Edit2.caption <> "" and earn_value >= 0 then
		Form.SetSharedData("Earn_Value", earn_value)
		Form.SetSharedData("Earn_Score", earn_score)
	else
		Form.ShowAlert("알림","소득을 입력해주십시오")
	end if	
	

End Sub

'============================================================================
Sub Edit3_OnEditComplete()
	dim percent	'소득 중 투자 비율
	
	percent = CInt(Edit3.caption)
	
	if percent >= 0 and Edit3.caption <> "" then
		if percent <= 16 then
			invst_percent_score = 1
		elseif percent > 16 and percent <= 30 then
			invst_percent_score = 3
		elseif percent > 30 and percent <= 45 then
			invst_percent_score = 5
		elseif percent > 45 and percent <= 60 then
			invst_percent_score = 7
		elseif percent > 60 and percent <= 80 then
			invst_percent_score = 9
		else
			invst_percent_score = 10
		end if
	else
		Form.SetSharedData("Invst_Percent_Score", "")
	end if
	
	invst_percent_value = percent
	
	if Edit3.caption <> "" and invst_percent_value >= 0 then
		Form.SetSharedData("Invst_Percent_Value", invst_percent_value)
		Form.SetSharedData("Invst_Percent_Score", invst_percent_score)
	else
		Form.ShowAlert("알림","투자비율을 입력해주십시오")
	end if	
	

End Sub

'============================================================================


'============================================================================
Sub Form_OnFormInit()
	
End Sub

'============================================================================


'============================================================================
Sub Edit1_OnEditComplete()
	dim monthly
	
	monthly = cint(Edit1.caption)
	Form.Toast(0,monthly,0)
	
	if monthly > 0 then
		if monthly < 6  then
			invst_monthly_score = 1
		
		elseif monthly >= 6 and monthly < 12 then
			invst_monthly_score = 2
		
	
		elseif monthly >= 12 and monthly < 24 then
			invst_monthly_score = 3
		
		elseif monthly >= 24 and monthly < 36 then
			invst_monthly_score = 4
		
		elseif monthly >= 36 then
			invst_monthly_score = 5
		end if
	else
		Form.SetSharedData("Invst_Monthly_Score","")
	end if
	
	
	invst_monthly_value = monthly
	
	
	if invst_monthly_value > 0 then
		Form.SetSharedData("Invst_Monthly_Value", invst_monthly_value)
		Form.SetSharedData("Invst_Monthly_Score",invst_monthly_score)
	else
		Form.ShowAlert("알림","투자기간을 입력해주십시오")
	end if	
	
	
	
End Sub

	</SCRIPT_INFO>
