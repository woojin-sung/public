'--===========================================================================
' 01. 화 면 명 : 사모채권 거래쿼터 신청
' 02. 화면설명 : 사모채권 거래쿼터 신청
' 03. 작    성 : 2022.04.08 김수진 
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szKey	'오픈한 화면번호
Dim g_szAcno	'계좌번호
Dim g_szAsno	'계좌일련번호
Dim g_szRet	'리턴값
Dim g_nChoiceRow	'선택 Row
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_InitCtrl()
'============================================================================
Function f_InitCtrl()
	grdList.SetClear()
	edtTotalQty.caption = 0
	g_nChoiceRow = -1
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	'종목 정보 리셋
	tblItem.SetCellString(0, 1, "" )	'종목명
	tblItem.SetCellString(0, 2, "" )	'종목코드
	tblItem.SetCellString(1, 1, "" )	'잔고수량
	tblItem.SetCellString(1, 3, "" )	'매수일자
	tblItem.SetCellString(1, 4, "" )	'종합분리과세구분코드
	f_InitCtrl()
	g_szRet = "N"
	
	Dim szOpenData
	szOpenData = Form.GetopenLinkData()
	
	If Trim(szOpenData) <> "" Then
		
		Dim tData
		tData = Split(szOpenData, "★")
		
		If UBound(tData) > 0 Then		
			
			if Trim(tData(0)) == "mbbnk61100_p1" Then
				Form.SetScreenName("사모채권 거래쿼터 신청")	
				g_szKey 	= tData(0)	'오픈한 화면번호
				
				For i = 1 to #tData - 1
					If tData[i] == "" or tData[i] == null Then
						btnProcess.enable = false
						Exit Sub
					End If
				Next	
				g_szAcno	= tData(1)	'계좌번호
				g_szAsno	= tData(2)	'계좌일련번호				

				tblItem.SetCellString(0, 1, tData(4))	'종목명
				tblItem.SetCellString(0, 2, tData(3))	'종목코드
				tblItem.SetCellString(1, 1, tData(5))	'잔고수량
				tblItem.SetCellString(1, 3, tData(6))	'매수일자
				tblItem.SetCellString(1, 4, tData(7))	'종합분리과세구분코드
				
				DATAMANAGER.RequestTranData( "obrts_tkwr_041a_1" )	'사모채권 쿼터 거래단위금액 조회
			End If
		End If
	End If
End Sub

'============================================================================
' Form_OnPopupReturn() : 팝업리턴
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'--- 수량 입력 팝업 처리  ---
	If sKeyName == "QTY_POPUP" Then	'수량
		Dim nRmQty
		nRmQty = tonumber(grdList.GetCellData( "bd_RmQty", g_nChoiceRow))	'보유수량
		
		'보유수량 이상 입력 체크
		If CInt(sRet) > nRmQty Then
			Form.ShowAlert( "알림", "사용가능 쿼터수량 초과")
			Exit Sub
		End If
		
		'수량 SET
		grdList.SetCellData( "bd_Qty", g_nChoiceRow, sRet)
		
		'총 신청 수량 SET
		Dim nTotalQty, nQty, nUnit
		nTotalQty = 0
		For i = 0 to tonumber(grdList.rowcount) - 1 
			nUnit = tonumber(grdList.GetCellData("bd_UnitAmt", i))
			nQty = grdList.GetCellData("bd_Qty", i)
			If nQty == "" or nQty == null Then
				nQty = 0 
			Else
				nQty = tonumber(nQty)
			End If
			nTotalQty = nTotalQty + (nUnit * nQty)
		Next
		edtTotalQty.caption = nTotalQty
	End If 
End Sub

'============================================================================
' grdList_OnClickUp 
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	If szCellID == "bd_Qty" or szCellID == "bd_Qtyimg"  then
		g_nChoiceRow = CInt(lRow)
		Dim szData
		szData = grdList.GetCellData( "bd_Qty", lRow )
		'Form.OpenPopup("mbtrf31030_p1", szData ,"")	
		Form.OpenPopup("mbbnk61130_p1", szData ,"")	
	End If
End Sub


'============================================================================
' btnProcess_OnClick() : 출고처리
'============================================================================
Sub btnProcess_OnClick()
	'신청수량 체크
	If tonumber(edtTotalQty.caption) == 0 or Trim(edtTotalQty.caption) == "" or Trim(edtTotalQty.caption) == null then
		Form.ShowAlert("알림", "신청수량을 입력해주세요.")
		Exit Sub
	End If
	
	DATAMANAGER.RequestTranData( "obrts_tkwr_041a" )	'사모채권 쿼터 거래단위 등록
End Sub

'============================================================================
' Form_OnFormClose()'
'============================================================================
Sub Form_OnFormClose()
	'당사/타사대체출고 팝업에서 넘어오 경우
	If g_szKey == "mbbnk61100_p1" Then
		Form.SendReturnToParent( "mbbnk61130" , g_szRet )
	End If
End Sub

'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 통신에 필요한 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obrts_tkwr_041a_1" or  szTranID = "obrts_tkwr_041a" Then
		Dim szIscd, szBuyDate, szTaxCode
		szIscd = tblItem.GetCellString(0, 2)	'종목코드
		szBuyDate = tblItem.GetCellString(1, 3)	'매수일자
		szTaxCode = tblItem.GetCellString(1, 4)	'종합분리과세구분코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 				   , 0, g_szAcno  )  	'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 				   , 0, g_szAsno  )  	'계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" 				   , 0, szIscd    )  	'종목코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BYOV_DATE" 			   , 0, szBuydate )	'매수일자
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OVRL_SPTX_CLS_CODE"     , 0, szTaxCode ) 	'종합분리과세구분코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PE_BOND_RCPY_BSWR_CODE" , 0, "02"      ) 	'사모채권출납업무구분코드
		
		'사모채권 쿼터 거래단위금액 조회 
		If szTranID = "obrts_tkwr_041a_1" Then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 	, 0, "9" 		) 	'처리구분코드
		'사모채권 쿼터 거래단위 등록
		Else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 	, 0, "1" 		) 	'처리구분코드
			
			Dim nTRcount	'TR 인덱스
			nTRcount = 0
			
			Dim nUnitAmt, nRmQty, nQty
			For i = 0 to tonumber(grdList.rowcount) - 1 
				nUnitAmt = tonumber(grdList.GetCellData( "bd_UnitAmt", i ))
				nRmQty	= tonumber(grdList.GetCellData( "bd_RmQty", i ))
				nQty		= tonumber(grdList.GetCellData( "bd_Qty", i ))
				If nQty <> 0 and nQty <> null and nQty <> "" Then 
					DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "TR_UNIT_AMT" 	, nTRcount, nUnitAmt		)  	'거래단위금액
					DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "RMND_QTY" 		, nTRcount, nRmQty 		)	'잔고수량
					DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "APLT_QTY" 		, nTRcount, nQty 			) 	'신청수량
					nTRcount = nTRcount + 1
				End If
			Next
		End If	
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'사모채권 쿼터 거래단위 등록
	If szTranID = "obrts_tkwr_041a" Then
		Form.ShowAlert( "알림", "신청 완료되었습니다.")
		f_InitCtrl()

		'당사/타사대체출고 팝업에서 넘어오 경우 Form Close
		If g_szKey == "mbbnk61100_p1" Then
			g_szRet = "Y"
			Form.CloseForm()
		Else
			DATAMANAGER.RequestTranData( "obrts_tkwr_041a_1" )	'사모채권 쿼터 거래단위금액 조회
		End If
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubMsg <> NULL and szSubMsg <> "" Then
		Form.ShowAlert( "알림", szErrMsg & "(" & szSubMsg & ")" )
	Else
		Form.ShowAlert( "알림", szErrMsg )
	End If
End Sub


