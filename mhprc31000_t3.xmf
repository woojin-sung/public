'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵현재가_호가
' 02. 화면설명 : 선옵현재가 투자자탭화면
' 03. 작    성 : 2016.04.30 LJS
' 04. 참    고 : 
'-------------------------------------------------------------------------------------------

'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_szItemCode, g_ItemMarket

Dim g_szMarketCode 	'시장구분코드
Dim g_szCode			'종목코드
Dim g_nIndisun
Dim g_nForesun
Dim g_nOrganisun
Dim g_nStocksun
Dim g_nInsusun
Dim g_nDevotsun
Dim g_nBanksun
Dim g_nCorsun 		'투자자 직전값


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode =  Form.GetSharedData( "&ITEM_FUTOPT", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	'20160705 NOHES START	MarketType Default : "F"로 결정
	if Len(Trim(g_szItemMarket)) = 0 Then
		g_szItemMarket = "F"			
	end if
	'20160705 NOHES END

End Sub

'============================================================================
Sub Form_OnFormInit()

	tbl2.left = 0
	grd0.left = 0	

	cbo1_OnEditComplete( 1 )
	cbo2_OnEditComplete( 0 )	
	
	ChartEx0.SetAccrueName("개인,외국인,기관계,증권")
	ChartEx0.SetPeriodType(0)
	ChartEx0.SetInvestor("1")
	ChartEx0.setViewDataCount(200)
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	If sKey = "ITEMCODE" Then
		Dim nIdx
		nIdx = cbo1.currentindex
	
		g_szItemCode = sValue		
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	
		'20160705 NOHES START	MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) = 0 Then
			g_szItemMarket = "F"			
		end if
		'20160705 NOHES END
	
		cbo1_OnEditComplete( nIdx )
		
'	    sUNasISCD = MAINAPI.GetItemBaseCode(  FOItemCode1.Caption( )  )
'	    If sUNasISCD = "2029" Then
'		    Call Tbl_2.SetCellString( 0, 0, "KOSPI 200" )
'	    ElseIf sUNasISCD = "1203" Then
'		    Call Tbl_2.SetCellString( 0, 0, "KOSDAQ 150" )   
'	    End if
'		
	End	If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	DATAMANAGER.CancelRealData( "ohhts_invr_cntg"   )
	DATAMANAGER.CancelRealData( "ohhts_invr_cntg_1" )
	
'20190809_01 HWG START : 위클리옵션추가(미사용주석)
    If g_szMarketCode = "S11" Then
		g_szMarketCode = "K2I"
		g_szCode = "F001"
'    ElseIf g_szMarketCode = "MKI" Then 
'		g_szCode = "F005"
'	'20180308_01 KBC START : KRX300 & KSQ150상품추가
'    ElseIf g_szMarketCode = "XI3" Then 
'		g_szCode = "F007"
'    ElseIf g_szMarketCode = "KQI" Then 
'		g_szCode = "F002"
'	'20180308_01 KBC END
    End If
'20190809_01 HWG END

	If szTranID = "ohhts_3000_004r" Then
	    DATAMANAGER.SetDataValue( 0, "ohhts_3000_004r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szMarketCode 	)
	    DATAMANAGER.SetDataValue( 0, "ohhts_3000_004r", "InBlock1", "FID_INPUT_ISCD2"				, 0 , g_szCode 		)	    
	
	ElseIf szTranID = "ohhts_3000_005r" then
	    DATAMANAGER.SetDataValue( 0, "ohhts_3000_005r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szMarketCode 	)
	    DATAMANAGER.SetDataValue( 0, "ohhts_3000_005r", "InBlock1", "FID_INPUT_ISCD2"				, 0 , g_szCode 		)
	    
	ElseIf szTranID = "ohhts_3000_015r" Or szTranID = "ohhts_3000_015r_1" then
	    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_ISCD"	, 0 , g_szMarketCode 	)
	    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_ISCD2"	, 0 , g_szCode 		)

	ElseIf szTranID = "ohhts_3080_001r" then
		'20160705 NOHES START MarketType Default 수정
	    szMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	    
	    if Len(Trim(szMarket)) = 0 Then
		    szMarket = "F"
	    end if
	    
'	    DATAMANAGER.SetDataValue( 0, "ohhts_3080_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 ,  Form.GetItemCodeInfo( g_szItemCode , "market") )
  	    DATAMANAGER.SetDataValue( 0, "ohhts_3080_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 ,  szMarket )
	    '20160705 NOHES END
	    
	    DATAMANAGER.SetDataValue( 0, "ohhts_3080_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)

	End if

End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)

	If szTranID = "ohhts_invr_cntg" Then
	    DATAMANAGER.SetDataValue( 1, "ohhts_invr_cntg", "InBlock1", "FIDR_BSTP_INVR_CODE" , 0 , g_szCode&g_szMarketCode )
	
	ElseIf szTranID = "ohhts_invr_cntg_1" then
	    DATAMANAGER.SetDataValue( 1, "ohhts_invr_cntg_1", "InBlock1", "FIDR_BSTP_INVR_CODE" , 0 , g_szCode&g_szMarketCode )
	    
	End if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	Dim szTime, szHourTime
	
	If szTranID = "ohhts_invr_cntg" Then
	
	    szTime = DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_BSOP_HOUR" , 0 )
	    
	    szHourTime = Left(szTime, 4)

	    '데이터 세팅
		If cbo1.currentindex = "0" Then
			If cbo2.currentindex = "0" Then			
			    
			    '매도
			    nFIDR_PRSN_SELN_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_SELN_TR_PBMN" 		, 0 ) )
			    nFIDR_FRGN_SELN_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_SELN_TR_PBMN" 		, 0 ) )
			    nFIDR_ORGN_SELN_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_SELN_TR_PBMN" 		, 0 ) )
			    nFIDR_SCRT_SELN_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_SELN_TR_PBMN" 		, 0 ) )
			    nFIDR_INSU_SELN_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_INSU_SELN_TR_PBMN" 		, 0 ) )
			    nFIDR_IVTR_SELN_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_IVTR_SELN_TR_PBMN" 		, 0 ) )
			    nFIDR_BANK_SELN_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_BANK_SELN_TR_PBMN" 		, 0 ) )
			    nFIDR_ETC_CORP_SELN_TR_PBMN	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ETC_CORP_SELN_TR_PBMN" 	, 0 ) )
			    
			    tbl1.SetCellString( 1 , 1 , Round( nFIDR_PRSN_SELN_TR_PBMN 		/ 100, 0) )
			    tbl1.SetCellString( 2 , 1 , Round( nFIDR_FRGN_SELN_TR_PBMN		/ 100, 0) )
			    tbl1.SetCellString( 3 , 1 , Round( nFIDR_ORGN_SELN_TR_PBMN		/ 100, 0) )
			    tbl1.SetCellString( 4 , 1 , Round( nFIDR_SCRT_SELN_TR_PBMN		/ 100, 0) )
			    tbl1.SetCellString( 5 , 1 , Round( nFIDR_INSU_SELN_TR_PBMN		/ 100, 0) )
			    tbl1.SetCellString( 6 , 1 , Round( nFIDR_IVTR_SELN_TR_PBMN		/ 100, 0) )
			    tbl1.SetCellString( 7 , 1 , Round( nFIDR_BANK_SELN_TR_PBMN		/ 100, 0) )
			    tbl1.SetCellString( 8 , 1 , Round( nFIDR_ETC_CORP_SELN_TR_PBMN	/ 100, 0) )
				
			    '매수			    
			    nFIDR_PRSN_SHNU_TR_PBMN 	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_SHNU_TR_PBMN" 		, 0 ) )
			    nFIDR_FRGN_SHNU_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_SHNU_TR_PBMN" 		, 0 ) )
			    nFIDR_ORGN_SHNU_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_SHNU_TR_PBMN" 		, 0 ) )
			    nFIDR_SCRT_SHNU_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_SHNU_TR_PBMN" 		, 0 ) )
			    nFIDR_INSU_SHNU_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_INSU_SHNU_TR_PBMN" 		, 0 ) )
			    nFIDR_IVTR_SHNU_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_IVTR_SHNU_TR_PBMN"		, 0 ) )
			    nFIDR_BANK_SHNU_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_BANK_SHNU_TR_PBMN"		, 0 ) )
			    nFIDR_ETC_CORP_SHNU_TR_PBMN	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ETC_CORP_SHNU_TR_PBMN"	, 0 ) )
			    
			    tbl1.SetCellString( 1 , 2 , Round( nFIDR_PRSN_SHNU_TR_PBMN 		/ 100, 0) )
			    tbl1.SetCellString( 2 , 2 , Round( nFIDR_FRGN_SHNU_TR_PBMN 		/ 100, 0) )
			    tbl1.SetCellString( 3 , 2 , Round( nFIDR_ORGN_SHNU_TR_PBMN 		/ 100, 0) )
			    tbl1.SetCellString( 4 , 2 , Round( nFIDR_SCRT_SHNU_TR_PBMN 		/ 100, 0) )
			    tbl1.SetCellString( 5 , 2 , Round( nFIDR_INSU_SHNU_TR_PBMN 		/ 100, 0) )
			    tbl1.SetCellString( 6 , 2 , Round( nFIDR_IVTR_SHNU_TR_PBMN  	/ 100, 0) )
			    tbl1.SetCellString( 7 , 2 , Round( nFIDR_BANK_SHNU_TR_PBMN  	/ 100, 0) )
			    tbl1.SetCellString( 8 , 2 , Round( nFIDR_ETC_CORP_SHNU_TR_PBMN	/ 100, 0) )
			    
			    '순매수
			    nFIDR_PRSN_NTBY_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_NTBY_TR_PBMN" 		, 0 ) )
			    nFIDR_FRGN_NTBY_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_NTBY_TR_PBMN" 		, 0 ) )
			    nFIDR_ORGN_NTBY_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_NTBY_TR_PBMN" 		, 0 ) )
			    nFIDR_SCRT_NTBY_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_NTBY_TR_PBMN" 		, 0 ) )
			    nFIDR_INSU_NTBY_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_INSU_NTBY_TR_PBMN" 		, 0 ) )
			    nFIDR_IVTR_NTBY_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_IVTR_NTBY_TR_PBMN" 		, 0 ) )
			    nFIDR_BANK_NTBY_TR_PBMN		= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_BANK_NTBY_TR_PBMN" 		, 0 ) )
			    nFIDR_ETC_CORP_NTBY_TR_PBMN	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ETC_CORP_NTBY_TR_PBMN" 	, 0 ) )
			    
			    tbl1.SetCellString( 1 , 3 , Round( nFIDR_PRSN_NTBY_TR_PBMN		 / 100, 0) )
			    tbl1.SetCellString( 2 , 3 , Round( nFIDR_FRGN_NTBY_TR_PBMN		 / 100, 0) )
			    tbl1.SetCellString( 3 , 3 , Round( nFIDR_ORGN_NTBY_TR_PBMN		 / 100, 0) )
			    tbl1.SetCellString( 4 , 3 , Round( nFIDR_SCRT_NTBY_TR_PBMN		 / 100, 0) )
			    tbl1.SetCellString( 5 , 3 , Round( nFIDR_INSU_NTBY_TR_PBMN		 / 100, 0) )
			    tbl1.SetCellString( 6 , 3 , Round( nFIDR_IVTR_NTBY_TR_PBMN		 / 100, 0) )
			    tbl1.SetCellString( 7 , 3 , Round( nFIDR_BANK_NTBY_TR_PBMN		 / 100, 0) )
			    tbl1.SetCellString( 8 , 3 , Round( nFIDR_ETC_CORP_NTBY_TR_PBMN	 / 100, 0) )

			    '증감			    
			    nPRSN_NTBY 		= DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_NTBY_TR_PBMN"	, 0 )
			    nFRGN_NTBY 		= DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_NTBY_TR_PBMN"	, 0 )
			    nORGN_NTBY		= DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_NTBY_TR_PBMN"	, 0 )
			    nSCRT_NTBY 		= DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_NTBY_TR_PBMN"	, 0 )
			    nINSU_NTBY 		= DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_INSU_NTBY_TR_PBMN"	, 0 )
			    nIVTR_NTBY 		= DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_IVTR_NTBY_TR_PBMN"	, 0 )
			    nBANK_NTBY 		= DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_BANK_NTBY_TR_PBMN"	, 0 )
			    nETC_CORP_NTBY 	= DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ETC_CORP_NTBY_TR_PBMN"	, 0 )
			    
				nindisun 	= Round( nPRSN_NTBY	 /100, 0) - g_nIndisun 				
				nforesun 	= Round( nFRGN_NTBY	 /100, 0) - g_nForesun 
				norganisun 	= Round( nORGN_NTBY	 /100, 0) - g_nOrganisun 
				nstocksun 	= Round( nSCRT_NTBY	 /100, 0) - g_nStocksun
				ninsusun 	= Round( nINSU_NTBY	 /100, 0) - g_nInsusun 
				ndevotsun 	= Round( nIVTR_NTBY	 /100, 0) - g_nDevotsun 
				nbanksun 	= Round( nBANK_NTBY 	 /100, 0) - g_nBanksun 
				ncorsun 		= Round( nETC_CORP_NTBY /100, 0) - g_nCorsun 

			    tbl1.SetCellString( 1 , 4 , nindisun 	)
			    tbl1.SetCellString( 2 , 4 , nforesun 	)
			    tbl1.SetCellString( 3 , 4 , norganisun 	)
			    tbl1.SetCellString( 4 , 4 , nstocksun 	)
			    tbl1.SetCellString( 5 , 4 , ninsusun 	)
			    tbl1.SetCellString( 6 , 4 , ndevotsun 	)
			    tbl1.SetCellString( 7 , 4 , nbanksun 	)
			    tbl1.SetCellString( 8 , 4 , ncorsun 		)
			    			    
		    End if
	    Else
		    If cbo2.currentindex = "0" Then
			    '매도
			    tbl1.SetCellString( 1 , 1 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_SELN_VOL" 	, 0 ) )
			    tbl1.SetCellString( 2 , 1 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_SELN_VOL" 	, 0 ) )
			    tbl1.SetCellString( 3 , 1 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_SELN_VOL" 	, 0 ) )
			    tbl1.SetCellString( 4 , 1 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_SELN_VOL" 	, 0 ) )
			    tbl1.SetCellString( 5 , 1 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_INSU_SELN_VOL" 	, 0 ) )
			    tbl1.SetCellString( 6 , 1 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_IVTR_SELN_VOL" 	, 0 ) )
			    tbl1.SetCellString( 7 , 1 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_BANK_SELN_VOL" 	, 0 ) )
			    tbl1.SetCellString( 8 , 1 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ETC_CORP_SELN_VOL" 	, 0 ) )
			    
			    '매수
			    tbl1.SetCellString( 1 , 2 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_SHNU_VOL" 	, 0 ) )
			    tbl1.SetCellString( 2 , 2 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_SHNU_VOL" 	, 0 ) )
			    tbl1.SetCellString( 3 , 2 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_SHNU_VOL" 	, 0 ) )
			    tbl1.SetCellString( 4 , 2 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_SHNU_VOL" 	, 0 ) )
			    tbl1.SetCellString( 5 , 2 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_INSU_SHNU_VOL" 	, 0 ) )
			    tbl1.SetCellString( 6 , 2 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_IVTR_SHNU_VOL" 	, 0 ) )
			    tbl1.SetCellString( 7 , 2 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_BANK_SHNU_VOL" 	, 0 ) )
			    tbl1.SetCellString( 8 , 2 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ETC_CORP_SHNU_VOL" 	, 0 ) )
			    
			    '순매수
			    tbl1.SetCellString( 1 , 3 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_NTBY_VOL" 	, 0 ) )
			    tbl1.SetCellString( 2 , 3 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_NTBY_VOL" 	, 0 ) )
			    tbl1.SetCellString( 3 , 3 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_NTBY_VOL" 	, 0 ) )
			    tbl1.SetCellString( 4 , 3 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_NTBY_VOL" 	, 0 ) )
			    tbl1.SetCellString( 5 , 3 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_INSU_NTBY_VOL" 	, 0 ) )
			    tbl1.SetCellString( 6 , 3 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_IVTR_NTBY_VOL" 	, 0 ) )
			    tbl1.SetCellString( 7 , 3 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_BANK_NTBY_VOL" 	, 0 ) )
			    tbl1.SetCellString( 8 , 3 , DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ETC_CORP_NTBY_VOL" 	, 0 ) )
			    			
			    '증감
			    nPRSN_NTBY 		= CDbl(DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_NTBY_VOL"		, 0 ) )
			    nFRGN_NTBY 		= CDbl(DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_NTBY_VOL"		, 0 ) )
			    nORGN_NTBY		= CDbl(DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_NTBY_VOL"		, 0 ) )
			    nSCRT_NTBY 		= CDbl(DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_NTBY_VOL"		, 0 ) )
			    nINSU_NTBY 		= CDbl(DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_INSU_NTBY_VOL"		, 0 ) )
			    nIVTR_NTBY 		= CDbl(DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_IVTR_NTBY_VOL"		, 0 ) )
			    nBANK_NTBY 		= CDbl(DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_BANK_NTBY_VOL"		, 0 ) )
			    nETC_CORP_NTBY 	= CDbl(DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ETC_CORP_NTBY_VOL"	, 0 ) )
			    
				nindisun 	= Round( nPRSN_NTBY		, 0) - g_nIndisun 				
				nforesun 	= Round( nFRGN_NTBY		, 0) - g_nForesun 
				norganisun 	= Round( nORGN_NTBY		, 0) - g_nOrganisun 
				nstocksun 	= Round( nSCRT_NTBY		, 0) - g_nStocksun
				ninsusun 	= Round( nINSU_NTBY		, 0) - g_nInsusun 
				ndevotsun 	= Round( nIVTR_NTBY		, 0) - g_nDevotsun 
				nbanksun 	= Round( nBANK_NTBY		, 0) - g_nBanksun 
				ncorsun 		= Round( nETC_CORP_NTBY	, 0) - g_nCorsun 

			    tbl1.SetCellString( 1 , 4 , nindisun 	)
			    tbl1.SetCellString( 2 , 4 , nforesun 	)
			    tbl1.SetCellString( 3 , 4 , norganisun 	)
			    tbl1.SetCellString( 4 , 4 , nstocksun 	)
			    tbl1.SetCellString( 5 , 4 , ninsusun 	)
			    tbl1.SetCellString( 6 , 4 , ndevotsun 	)
			    tbl1.SetCellString( 7 , 4 , nbanksun 	)
			    tbl1.SetCellString( 8 , 4 , ncorsun 		)
			    
		    End if
	    End if
	    
	    If cbo1.currentindex = "0" Then
		    nindividual 	= Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_NTBY_TR_PBMN" , 0 )) / 100, 0)
		    nforeigner 	= Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_NTBY_TR_PBMN" , 0 )) / 100, 0)
		    norganization	= Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_NTBY_TR_PBMN" , 0 )) / 100, 0)
		    nstock 		= Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_NTBY_TR_PBMN" , 0 )) / 100, 0)
		Else
		    nindividual 	= Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_NTBY_VOL" , 0 )), 0)
		    nforeigner 	= Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_NTBY_VOL" , 0 )), 0)
		    norganization	= Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_NTBY_VOL" , 0 )), 0)
		    nstock 		= Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_NTBY_VOL" , 0 )), 0)
		End if
		
	    '추이 세팅
		'순매수
		grd0.insertrow = 0
		grd0.SetCellData( "bd_cell0", 0, DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_BSOP_HOUR" , 0 ) )

		If cbo1.currentindex = "0" Then
			grd0.SetCellData( "bd_cell1", 0, nindividual	)	'개인
			grd0.SetCellData( "bd_cell2", 0, nforeigner	)	'외국인
			grd0.SetCellData( "bd_cell3", 0, norganization	)	'기관
			grd0.SetCellData( "bd_cell4", 0, nstock 		)	'증권			
		    
		Else
			grd0.SetCellData( "bd_cell5", 0, nindividual	)	'개인
			grd0.SetCellData( "bd_cell6", 0, nforeigner	)	'외국인
			grd0.SetCellData( "bd_cell7", 0, norganization	)	'기관
			grd0.SetCellData( "bd_cell8", 0, nstock 		)	'증권			
		    
		End if

		If cbo1.currentindex = "0" Then
		
			'매도,매수대금
			tbl2.SetCellString( 1, 1, Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_SELN_TR_PBMN", 0 ) ) / 100), 2)
			tbl2.SetCellString( 2, 1, Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_SHNU_TR_PBMN", 0 ) ) / 100), 2)

			tbl2.SetCellString( 1, 2, Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_SELN_TR_PBMN", 0 ) ) / 100), 2)
			tbl2.SetCellString( 2, 2, Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_SHNU_TR_PBMN", 0 ) ) / 100), 2)

			tbl2.SetCellString( 1, 3, Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_SELN_TR_PBMN", 0 ) ) / 100), 2)
			tbl2.SetCellString( 2, 3, Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_SHNU_TR_PBMN", 0 ) ) / 100), 2)

			tbl2.SetCellString( 1, 4, Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_SELN_TR_PBMN", 0 ) ) / 100), 2)
			tbl2.SetCellString( 2, 4, Round( CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_SHNU_TR_PBMN", 0 ) ) / 100), 2)

			tbl2.SetCellString( 3, 1, nindividual 	)
			tbl2.SetCellString( 3, 2, nforeigner 		)
			tbl2.SetCellString( 3, 3, norganization 	)
			tbl2.SetCellString( 3, 4, nstock	 		)
			
		Else
			'매도,매수량
			tbl2.SetCellString( 1, 1, DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_SELN_VOL", 0 ) )
			tbl2.SetCellString( 2, 1, DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_SHNU_VOL", 0 ) )

			tbl2.SetCellString( 1, 2, DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_SELN_VOL", 0 ) )
			tbl2.SetCellString( 2, 2, DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_SHNU_VOL", 0 ) )

			tbl2.SetCellString( 1, 3, DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_SELN_VOL", 0 ) )
			tbl2.SetCellString( 2, 3, DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_SHNU_VOL", 0 ) )

			tbl2.SetCellString( 1, 4, DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_SELN_VOL", 0 ) )
			tbl2.SetCellString( 2, 4, DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_SHNU_VOL", 0 ) )

			tbl2.SetCellString( 3, 1, nindividual 	)
			tbl2.SetCellString( 3, 2, nforeigner 		)
			tbl2.SetCellString( 3, 3, norganization 	)
			tbl2.SetCellString( 3, 4, nstock	 		)
			
		End if	
	End if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim sMarketDiv
	sMarketDiv = Form.GetItemCodeInfo( g_szItemCode , "market")

	If szTranID = "ohhts_3080_001r" Then
	    
	    '20190809_01 HWG START : 위클리옵션추가
		g_szMarketCode = DATAMANAGER.GetDataValue( 0, "ohhts_3080_001r", "OutBlock1", "FID_PROD_CODE" , 0 )
		szOptnClsCode  = DATAMANAGER.GetDataValue( 0, "ohhts_3080_001r", "OutBlock1", "FID_OPTN_CLS_CODE" , 0 )
		
		If g_szMarketCode = "USD" And DATAMANAGER.GetDataValue( 0, "ohhts_3080_001r", "OutBlock1", "FID_OPTN_CLS_CODE" , 0 ) = "2" Then
		    g_szCode = "CC01"
		    
		ElseIf g_szMarketCode = "USD" And DATAMANAGER.GetDataValue( 0, "ohhts_3080_001r", "OutBlock1", "FID_OPTN_CLS_CODE" , 0 ) = "3" Then
		    g_szCode = "CP01"
		    
		ElseIf g_szMarketCode = "K2I" Then
		    if szOptnClsCode = "2" then
			    g_szCode = "OC01"
		    elseif szOptnClsCode = "3" then
			    g_szCode = "OP01"
		    else
			    g_szCode = "F001"
		    end if
		    
		ElseIf g_szMarketCode = "MKI" then	'미니선물
		    if szOptnClsCode = "2" then
			    g_szCode = "OC02"
		    elseif szOptnClsCode = "3" then
			    g_szCode = "OP02"
		    else
			    g_szCode = "F005"
		    end if
		    
		'20180308_01 KBC START : KRX300 & KSQ150상품추가
		ElseIf g_szMarketCode = "XI3" Then
			g_szCode = "F007"
			
		ElseIf g_szMarketCode = "KQI" Then
		    if szOptnClsCode = "2" then
			    g_szCode = "OC03"
		    elseif szOptnClsCode = "3" then
			    g_szCode = "OP03"
		    else
			    g_szCode = "F002"
		    end if
		'20180308_01 KBC END
		
	    ' 20240412 HSZ START : 코스닥글로벌지수 추가
	    elseif g_szMarketCode = "QGI" then
		    g_szCode = "F010"
	    ' 20240412 HSZ END
		
		ElseIf g_szMarketCode = "WKI" Then
		    if szOptnClsCode = "2" then
			    g_szCode = "OC04"
		    elseif szOptnClsCode = "3" then
			    g_szCode = "OP04"
		    end if
		    
		Else
		    g_szCode = "I001"
		End if
		
		If sMarketDiv = "JF" or sMarketDiv = "JO" Then
		    g_szMarketCode = "K2I"
		    g_szCode = "F001"
		End if
		'20190809_01 HWG END
			    
		If cbo2.currentindex = "1" Then
			If cbo1.currentindex = "0" Then
				ChartEx0.setDivideData(100)
				DATAMANAGER.RequestTranData( "ohhts_3000_015r_1" )
			Else
				ChartEx0.setDivideData(1)
				DATAMANAGER.RequestTranData( "ohhts_3000_015r" )
			End If
		Else
		    DATAMANAGER.RequestTranData( "ohhts_3000_004r" )
		End if
	End If
	
	If szTranID = "ohhts_3000_004r" Then
		If g_szMarketCode <> "" then
		    If cbo1.currentindex = "0" Then
			    
			    '매도금액 형번환
			    PRSN_SELN 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_PRSN_SELN_TR_PBMN"	, 0 ) )
			    FRGN_SELN 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_FRGN_SELN_TR_PBMN"	, 0 ) )
			    ORGN_SELN 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_ORGN_SELN_TR_PBMN"	, 0 ) )
			    SCRT_SELN 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_SCRT_SELN_TR_PBMN"	, 0 ) )
			    INSU_SELN 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_INSU_SELN_TR_PBMN"	, 0 ) )
			    IVTR_SELN	 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_IVTR_SELN_TR_PBMN"	, 0 ) )
			    BANK_SELN 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_BANK_SELN_TR_PBMN"	, 0 ) )
			    ETC_CORP_SELN	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_ETC_CORP_SELN_TR_PBMN", 0 ) )
				
			    
			    '매수금액 형변환
			    PRSN_SHNU 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_PRSN_SHNU_TR_PBMN"	, 0 ) )
			    FRGN_SHNU 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_FRGN_SHNU_TR_PBMN"	, 0 ) )
			    ORGN_SHNU 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_ORGN_SHNU_TR_PBMN"	, 0 ) )
			    SCRT_SHNU 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_SCRT_SHNU_TR_PBMN"	, 0 ) )
			    INSU_SHNU 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_INSU_SHNU_TR_PBMN"	, 0 ) )
			    IVTR_SHNU 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_IVTR_SHNU_TR_PBMN"	, 0 ) )
			    BANK_SHNU 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_BANK_SHNU_TR_PBMN"	, 0 ) )
			    ETC_CORP_SHNU	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_ETC_CORP_SHNU_TR_PBMN", 0 ) )
			    
			    '순매수금액 형변환
			    PRSN_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_PRSN_NTBY_TR_PBMN"	, 0 ) )
			    FRGN_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_FRGN_NTBY_TR_PBMN"	, 0 ) )
			    ORGN_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_ORGN_NTBY_TR_PBMN"	, 0 ) )
			    SCRT_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_SCRT_NTBY_TR_PBMN"	, 0 ) )
			    INSU_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_INSU_NTBY_TR_PBMN"	, 0 ) )
			    IVTR_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_IVTR_NTBY_TR_PBMN"	, 0 ) )
			    BANK_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_BANK_NTBY_TR_PBMN"	, 0 ) )
			    ETC_CORP_NTBY	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_ETC_CORP_NTBY_TR_PBMN", 0 ) )
			    
			    '증감 형변환
			    PRSN_ICDC 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_PRSN_NTBY_TR_PBMN_ICDC" , 0 ) )
			    FRGN_ICDC 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_FRGN_NTBY_TR_PBMN_ICDC" , 0 ) )
			    ORGN_ICDC 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_ORGN_NTBY_TR_PBMN_ICDC" , 0 ) )
			    SCRT_ICDC 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_SCRT_NTBY_TR_PBMN_ICDC" , 0 ) )
			    INSU_ICDC 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_INSU_NTBY_TR_PBMN_ICDC" , 0 ) )
			    IVTR_ICDC 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_IVTR_NTBY_TR_PBMN_ICDC" , 0 ) )
			    BANK_ICDC 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_BANK_NTBY_TR_PBMN_ICDC" , 0 ) )
			    ETC_CORP_ICDC	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_CORP_NTBY_TR_PBMN_ICDC" , 0 ) )
			    
			    If cbo2.currentindex = "0" Then
				    '매도금액
				    tbl1.SetCellString( 1 , 1 , Round( PRSN_SELN / 100, 0) )
				    tbl1.SetCellString( 2 , 1 , Round( FRGN_SELN / 100, 0) )
				    tbl1.SetCellString( 3 , 1 , Round( ORGN_SELN / 100, 0) )
				    tbl1.SetCellString( 4 , 1 , Round( SCRT_SELN / 100, 0) )
				    tbl1.SetCellString( 5 , 1 , Round( INSU_SELN / 100, 0) )
				    tbl1.SetCellString( 6 , 1 , Round( IVTR_SELN / 100, 0) )
				    tbl1.SetCellString( 7 , 1 , Round( BANK_SELN / 100, 0) )
				    tbl1.SetCellString( 8 , 1 , Round( ETC_CORP_SELN /100, 0) )
				    
				    '매수금액
				    tbl1.SetCellString( 1 , 2 , Round( PRSN_SHNU / 100, 0) )
				    tbl1.SetCellString( 2 , 2 , Round( FRGN_SHNU / 100, 0) )
				    tbl1.SetCellString( 3 , 2 , Round( ORGN_SHNU / 100, 0) )
				    tbl1.SetCellString( 4 , 2 , Round( SCRT_SHNU / 100, 0) )
				    tbl1.SetCellString( 5 , 2 , Round( INSU_SHNU / 100, 0) )
				    tbl1.SetCellString( 6 , 2 , Round( IVTR_SHNU / 100, 0) )
				    tbl1.SetCellString( 7 , 2 , Round( BANK_SHNU / 100, 0) )
				    tbl1.SetCellString( 8 , 2 , Round( ETC_CORP_SHNU / 100, 0) )
				    
				    '순매수
				    tbl1.SetCellString( 1 , 3 , Round( PRSN_NTBY / 100, 0) )
				    tbl1.SetCellString( 2 , 3 , Round( FRGN_NTBY / 100, 0) )
				    tbl1.SetCellString( 3 , 3 , Round( ORGN_NTBY / 100, 0) )
				    tbl1.SetCellString( 4 , 3 , Round( SCRT_NTBY / 100, 0) )
				    tbl1.SetCellString( 5 , 3 , Round( INSU_NTBY / 100, 0) )
				    tbl1.SetCellString( 6 , 3 , Round( IVTR_NTBY / 100, 0) )
				    tbl1.SetCellString( 7 , 3 , Round( BANK_NTBY / 100, 0) )
				    tbl1.SetCellString( 8 , 3 , Round( ETC_CORP_NTBY / 100, 0) )
				    
				    '증감
				    tbl1.SetCellString( 1 , 4 , PRSN_ICDC )
				    tbl1.SetCellString( 2 , 4 , FRGN_ICDC )
				    tbl1.SetCellString( 3 , 4 , ORGN_ICDC )
				    tbl1.SetCellString( 4 , 4 , SCRT_ICDC )
				    tbl1.SetCellString( 5 , 4 , INSU_ICDC )
				    tbl1.SetCellString( 6 , 4 , IVTR_ICDC )
				    tbl1.SetCellString( 7 , 4 , BANK_ICDC )
				    tbl1.SetCellString( 8 , 4 , ETC_CORP_ICDC )
				    
			    ElseIf cbo2.currentindex = "2" Then
					'매도					
					tbl2.SetCellString( 1 , 1 , Round( PRSN_SELN / 100, 0) )
					tbl2.SetCellString( 1 , 2 , Round( FRGN_SELN / 100, 0) )
					tbl2.SetCellString( 1 , 3 , Round( ORGN_SELN / 100, 0) )
					tbl2.SetCellString( 1 , 4 , Round( SCRT_SELN / 100, 0) )
					
				    '매수
					tbl2.SetCellString( 2 , 1 , Round( PRSN_SHNU / 100, 0) )
					tbl2.SetCellString( 2 , 2 , Round( FRGN_SHNU / 100, 0) )
					tbl2.SetCellString( 2 , 3 , Round( ORGN_SHNU / 100, 0) )
					tbl2.SetCellString( 2 , 4 , Round( SCRT_SHNU / 100, 0) )
					
				    '순매수
					tbl2.SetCellString( 3 , 1 , Round( PRSN_NTBY / 100, 0) )
					tbl2.SetCellString( 3 , 2 , Round( FRGN_NTBY / 100, 0) )
					tbl2.SetCellString( 3 , 3 , Round( ORGN_NTBY / 100, 0) )
					tbl2.SetCellString( 3 , 4 , Round( SCRT_NTBY / 100, 0) )	
					
			    End If
			Else
			    '매도량 형번환
			    
			    PRSN_SELN_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_PRSN_SELN_VOL" 		, 0 ) )
			    FRGN_SELN_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_FRGN_SELN_VOL" 		, 0 ) )
			    ORGN_SELN_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_ORGN_SELN_VOL" 		, 0 ) )
			    SCRT_SELN_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_SCRT_SELN_VOL" 		, 0 ) )
			    INSU_SELN_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_INSU_SELN_VOL" 		, 0 ) )
			    IVTR_SELN_VOL		= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_IVTR_SELN_VOL" 		, 0 ) )
			    BANK_SELN_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_BANK_SELN_VOL" 		, 0 ) )
			    ETC_CORP_SELN_VOL	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_ETC_CORP_SELN_VOL" 	, 0 ) )
			    
			    '매수량 형변환
			    PRSN_SHNU_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_PRSN_SHNU_VOL" 		, 0 ) )
			    FRGN_SHNU_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_FRGN_SHNU_VOL" 		, 0 ) )
			    ORGN_SHNU_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_ORGN_SHNU_VOL" 		, 0 ) )
			    SCRT_SHNU_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_SCRT_SHNU_VOL" 		, 0 ) )
			    INSU_SHNU_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_INSU_SHNU_VOL" 		, 0 ) )
			    IVTR_SHNU_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_IVTR_SHNU_VOL" 		, 0 ) )
			    BANK_SHNU_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_BANK_SHNU_VOL" 		, 0 ) )
			    ETC_CORP_SHNU_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_ETC_CORP_SHNU_VOL" 	, 0 ) )
			    
			    '순매수량 형변환
			    PRSN_NTBY_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_PRSN_NTBY_VOL" 		, 0 ) )
			    FRGN_NTBY_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_FRGN_NTBY_VOL" 		, 0 ) )
			    ORGN_NTBY_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_ORGN_NTBY_VOL" 		, 0 ) )
			    SCRT_NTBY_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_SCRT_NTBY_VOL" 		, 0 ) )
			    INSU_NTBY_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_INSU_NTBY_VOL" 		, 0 ) )
			    IVTR_NTBY_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_IVTR_NTBY_VOL" 		, 0 ) )
			    BANK_NTBY_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_BANK_NTBY_VOL" 		, 0 ) )
			    ETC_CORP_NTBY_VOL 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_ETC_CORP_NTBY_VOL" 	, 0 ) )
			    
			    '증감 형변환
			    PRSN_ICDC 		= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_PRSN_NTBY_QTY_ICDC" , 0 ) )
			    FRGN_ICDC 		= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_FRGN_NTBY_QTY_ICDC" , 0 ) )
			    ORGN_ICDC 		= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_ORGN_NTBY_QTY_ICDC" , 0 ) )
			    SCRT_ICDC 		= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_SCRT_NTBY_QTY_ICDC" , 0 ) )
			    INSU_ICDC 		= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_INSU_NTBY_QTY_ICDC" , 0 ) )
			    IVTR_ICDC 		= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_IVTR_NTBY_QTY_ICDC" , 0 ) )
			    BANK_ICDC 		= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_BANK_NTBY_QTY_ICDC" , 0 ) )
			    ETC_CORP_ICDC 	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_004r", "OutBlock1", "FID_CORP_NTBY_QTY_ICDC" , 0 ) )
			    
			    If cbo2.currentindex = "0" Then
				    
				    '매도량
				    tbl1.SetCellString( 1 , 1 , Round( PRSN_SELN_VOL , 0) )
				    tbl1.SetCellString( 2 , 1 , Round( FRGN_SELN_VOL , 0) )
				    tbl1.SetCellString( 3 , 1 , Round( ORGN_SELN_VOL , 0) )
				    tbl1.SetCellString( 4 , 1 , Round( SCRT_SELN_VOL , 0) )
				    tbl1.SetCellString( 5 , 1 , Round( INSU_SELN_VOL , 0) )
				    tbl1.SetCellString( 6 , 1 , Round( IVTR_SELN_VOL , 0) )
				    tbl1.SetCellString( 7 , 1 , Round( BANK_SELN_VOL , 0) )
				    tbl1.SetCellString( 8 , 1 , Round( ETC_CORP_SELN_VOL , 0) )
				    
				    '매수량 
				    tbl1.SetCellString( 1 , 2 , Round( PRSN_SHNU_VOL , 0) )
				    tbl1.SetCellString( 2 , 2 , Round( FRGN_SHNU_VOL , 0) )
				    tbl1.SetCellString( 3 , 2 , Round( ORGN_SHNU_VOL , 0) )
				    tbl1.SetCellString( 4 , 2 , Round( SCRT_SHNU_VOL , 0) )
				    tbl1.SetCellString( 5 , 2 , Round( INSU_SHNU_VOL , 0) )
				    tbl1.SetCellString( 6 , 2 , Round( IVTR_SHNU_VOL , 0) )
				    tbl1.SetCellString( 7 , 2 , Round( BANK_SHNU_VOL , 0) )
				    tbl1.SetCellString( 8 , 2 , Round( ETC_CORP_SHNU_VOL , 0) )
				    
				    '순매수량
				    tbl1.SetCellString( 1 , 3 , Round( PRSN_NTBY_VOL , 0) )
				    tbl1.SetCellString( 2 , 3 , Round( FRGN_NTBY_VOL , 0) )
				    tbl1.SetCellString( 3 , 3 , Round( ORGN_NTBY_VOL , 0) )
				    tbl1.SetCellString( 4 , 3 , Round( SCRT_NTBY_VOL , 0) )
				    tbl1.SetCellString( 5 , 3 , Round( INSU_NTBY_VOL , 0) )
				    tbl1.SetCellString( 6 , 3 , Round( IVTR_NTBY_VOL , 0) )
				    tbl1.SetCellString( 7 , 3 , Round( BANK_NTBY_VOL , 0) )
				    tbl1.SetCellString( 8 , 3 , Round( ETC_CORP_NTBY_VOL , 0) )
				    
				    '증감
				    tbl1.SetCellString( 1 , 4 , PRSN_ICDC )
				    tbl1.SetCellString( 2 , 4 , FRGN_ICDC )
				    tbl1.SetCellString( 3 , 4 , ORGN_ICDC )
				    tbl1.SetCellString( 4 , 4 , SCRT_ICDC )
				    tbl1.SetCellString( 5 , 4 , INSU_ICDC )
				    tbl1.SetCellString( 6 , 4 , IVTR_ICDC )
				    tbl1.SetCellString( 7 , 4 , BANK_ICDC )
				    tbl1.SetCellString( 8 , 4 , ETC_CORP_ICDC )
				    
				    
			    ElseIf cbo2.currentindex = "2" Then
				    '매도
				    tbl2.SetCellString( 1 , 1 , Round( PRSN_SELN_VOL , 0 ) )
				    tbl2.SetCellString( 1 , 2 , Round( FRGN_SELN_VOL , 0 ) )
				    tbl2.SetCellString( 1 , 3 , Round( ORGN_SELN_VOL , 0 ) )
				    tbl2.SetCellString( 1 , 4 , Round( SCRT_SELN_VOL , 0 ) )
				    '매수                                               
				    tbl2.SetCellString( 2 , 1 , Round( PRSN_SHNU_VOL , 0 ) )
				    tbl2.SetCellString( 2 , 2 , Round( FRGN_SHNU_VOL , 0 ) )
				    tbl2.SetCellString( 2 , 3 , Round( ORGN_SHNU_VOL , 0 ) )
				    tbl2.SetCellString( 2 , 4 , Round( SCRT_SHNU_VOL , 0 ) )
				    '순매수
				    tbl2.SetCellString( 3 , 1 , Round( PRSN_NTBY_VOL , 0 ) )
				    tbl2.SetCellString( 3 , 2 , Round( FRGN_NTBY_VOL , 0 ) )
				    tbl2.SetCellString( 3 , 3 , Round( ORGN_NTBY_VOL , 0 ) )
				    tbl2.SetCellString( 3 , 4 , Round( SCRT_NTBY_VOL , 0 ) )
				    
			    End If
			End If
		End If
		
		If tbl1.GetCellString( 1 , 3 ) <> "" then
		    g_nIndisun = int(tbl1.GetCellString( 1 , 3 ))
		End if		
		if tbl1.GetCellString( 2 , 3 ) <> "" then
		    g_nForesun = int(tbl1.GetCellString( 2 , 3 ))
		End if		
		if tbl1.GetCellString( 3 , 3 ) <> "" then
		    g_nOrganisun = int(tbl1.GetCellString( 3 , 3 ))
		End if		
		if tbl1.GetCellString( 4 , 3 ) <> "" then
		    g_nStocksun = int(tbl1.GetCellString( 4 , 3 ))
		End if		
		if tbl1.GetCellString( 5 , 3 ) <> "" then
		    g_nInsusun = int(tbl1.GetCellString( 5 , 3 ))
		End if
		if tbl1.GetCellString( 6 , 3 ) <> "" then
		    g_nDevotsun = int(tbl1.GetCellString( 6 , 3 ))
		End if
		if tbl1.GetCellString( 7 , 3 ) <> "" then
		    g_nBanksun = int(tbl1.GetCellString( 7 , 3 ))
		End if
		if tbl1.GetCellString( 8 , 3 ) <> "" then
		    g_nCorsun = int(tbl1.GetCellString( 8 , 3 ))
		End if

	    if cbo2.currentindex = "2" then
			DATAMANAGER.RequestTranData( "ohhts_3000_005r" )
	    End if
    End If
    
    If szTranID = "ohhts_3000_004r" Then
	    DATAMANAGER.RequestRealData( "ohhts_invr_cntg" )
	    
	ElseIf szTranID = "ohhts_3000_005r" Then
'	    For i=0 To grd0.rowcount -1
'		    Dim nFRGN_NTBY_TR_PBMN, nPRSN_NTBY_TR_PBMN, nORGN_NTBY_TR_PBMN, nSCRT_NTBY_TR_PBMN
'		    
'		    nFRGN_NTBY_TR_PBMN = grd0.GetCellData( "bd_cell1", i)
'		    nPRSN_NTBY_TR_PBMN = grd0.GetCellData( "bd_cell2", i)
'		    nORGN_NTBY_TR_PBMN = grd0.GetCellData( "bd_cell3", i)
'		    nSCRT_NTBY_TR_PBMN = grd0.GetCellData( "bd_cell4", i)
'		    
'		    grd0.SetCellData("bd_cell1", i, ROUND( nFRGN_NTBY_TR_PBMN / 100, 0) )
'		    grd0.SetCellData("bd_cell2", i, ROUND( nPRSN_NTBY_TR_PBMN / 100, 0) )
'		    grd0.SetCellData("bd_cell3", i, ROUND( nORGN_NTBY_TR_PBMN / 100, 0) )
'		    grd0.SetCellData("bd_cell4", i, ROUND( nSCRT_NTBY_TR_PBMN / 100, 0) )
'	    Next
	    
	    DATAMANAGER.RequestRealData( "ohhts_invr_cntg" )	    
	End If
	
	If szTranID = "ohhts_3000_015r" Or szTranID = "ohhts_3000_015r_1" Then
	    
	    DATAMANAGER.RequestRealData( "ohhts_invr_cntg_1" )
	    
    End If
    
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	If szTranID = "ohhts_invr_cntg" then
		If cbo1.currentindex = "0" Then
		    PRSN_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_NTBY_TR_PBMN"		, 0 ) )
		    FRGN_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_NTBY_TR_PBMN"		, 0 ) )
		    ORGN_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_NTBY_TR_PBMN"		, 0 ) )
		    SCRT_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_NTBY_TR_PBMN"		, 0 ) )
		    INSU_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_INSU_NTBY_TR_PBMN"		, 0 ) )
		    IVTR_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_IVTR_NTBY_TR_PBMN"		, 0 ) )
		    BANK_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_BANK_NTBY_TR_PBMN"		, 0 ) )
		    ETC_CORP_NTBY	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ETC_CORP_NTBY_TR_PBMN"	, 0 ) )
		    
			g_nIndisun 	= Round( PRSN_NTBY /100, 0)
			g_nForesun 	= Round( FRGN_NTBY /100, 0)
			g_nOrganisun 	= Round( ORGN_NTBY /100, 0)
			g_nStocksun 	= Round( SCRT_NTBY /100, 0)
			g_nInsusun 	= Round( INSU_NTBY /100, 0)
			g_nDevotsun 	= Round( IVTR_NTBY /100, 0)
			g_nBanksun 	= Round( BANK_NTBY /100, 0)
			g_nCorsun 	= Round( ETC_CORP_NTBY /100, 0)
	    Else
		    PRSN_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_PRSN_NTBY_VOL"		, 0 ) )
		    FRGN_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_FRGN_NTBY_VOL"		, 0 ) )
		    ORGN_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ORGN_NTBY_VOL"		, 0 ) )
		    SCRT_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_SCRT_NTBY_VOL"		, 0 ) )
		    INSU_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_INSU_NTBY_VOL"		, 0 ) )
		    IVTR_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_IVTR_NTBY_VOL"		, 0 ) )
		    BANK_NTBY 	= CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_BANK_NTBY_VOL"		, 0 ) )
		    ETC_CORP_NTBY = CDbl( DATAMANAGER.GetDataValue( 1, "ohhts_invr_cntg", "OutBlock1", "FIDR_ETC_CORP_NTBY_VOL"	, 0 ) )
		    
			g_nIndisun 	= Round( PRSN_NTBY, 0)
			g_nForesun 	= Round( FRGN_NTBY, 0)
			g_nOrganisun 	= Round( ORGN_NTBY, 0)
			g_nStocksun 	= Round( SCRT_NTBY, 0)
			g_nInsusun 	= Round( INSU_NTBY, 0)
			g_nDevotsun 	= Round( IVTR_NTBY, 0)
			g_nBanksun 	= Round( BANK_NTBY, 0)
			g_nCorsun 	= Round( ETC_CORP_NTBY, 0)
		End if
	End if
End Sub


'============================================================================
Sub cbo1_OnEditComplete(iIndex)
	
	If iIndex = 0 Then
		grd0.SetVisibleCol( 1, "1" )
		grd0.SetVisibleCol( 2, "1" )
		grd0.SetVisibleCol( 3, "1" )
		grd0.SetVisibleCol( 4, "1" )
		grd0.SetVisibleCol( 5, "0" )
		grd0.SetVisibleCol( 6, "0" )
		grd0.SetVisibleCol( 7, "0" )
		grd0.SetVisibleCol( 7, "0" )
	
	Else
		grd0.SetVisibleCol( 1, "0" )
		grd0.SetVisibleCol( 2, "0" )
		grd0.SetVisibleCol( 3, "0" )
		grd0.SetVisibleCol( 4, "0" )
		grd0.SetVisibleCol( 5, "1" )
		grd0.SetVisibleCol( 6, "1" )
		grd0.SetVisibleCol( 7, "1" )
		grd0.SetVisibleCol( 7, "1" )
	
	End If
	
	DATAMANAGER.RequestTranData( "ohhts_3080_001r" )
End Sub

'============================================================================
Sub cbo2_OnEditComplete(iIndex)

	If iIndex = 0 Then
		tbl1.visible = True
		tbl2.visible = False
		grd0.visible = False
		ChartEx0.visible = False
		
		DATAMANAGER.RequestTranData( "ohhts_3080_001r" )
	
	ElseIf iIndex = 1 Then
		tbl1.visible = False
		tbl2.visible = False
		grd0.visible = False
		ChartEx0.visible = True
		DATAMANAGER.RequestTranData( "ohhts_3080_001r" )
		
	ElseIf iIndex = 2 Then
		tbl1.visible = False
		tbl2.visible = True
		grd0.visible = True
		ChartEx0.visible = False
		
		DATAMANAGER.RequestTranData( "ohhts_3080_001r" )
	End If

	

End Sub




'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	
	If szTranID = "ohhts_3000_005r" Then
		Dim nCnt
		
		nCnt = DATAMANAGER.GetDataCount( 0, "ohhts_3000_005r", "OutBlock1" )
	
	    For i=0 To nCnt -1
		    Dim nFRGN_NTBY_TR_PBMN, nPRSN_NTBY_TR_PBMN, nORGN_NTBY_TR_PBMN, nSCRT_NTBY_TR_PBMN
		    
		    nFRGN_NTBY_TR_PBMN = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_PRSN_NTBY_TR_PBMN" , i ) ) / 100, 0)
		    nPRSN_NTBY_TR_PBMN = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_FRGN_NTBY_TR_PBMN" , i ) ) / 100, 0)
		    nORGN_NTBY_TR_PBMN = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_ORGN_NTBY_TR_PBMN" , i ) ) / 100, 0)
		    nSCRT_NTBY_TR_PBMN = ROUND( CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_SCRT_NTBY_TR_PBMN" , i ) ) / 100, 0)
		    
		    DATAMANAGER.SetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_PRSN_NTBY_TR_PBMN" , i , nFRGN_NTBY_TR_PBMN )
		    DATAMANAGER.SetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_FRGN_NTBY_TR_PBMN" , i , nPRSN_NTBY_TR_PBMN )
		    DATAMANAGER.SetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_ORGN_NTBY_TR_PBMN" , i , nORGN_NTBY_TR_PBMN )
		    DATAMANAGER.SetDataValue( 0, "ohhts_3000_005r", "OutBlock1", "FID_SCRT_NTBY_TR_PBMN" , i , nSCRT_NTBY_TR_PBMN )

	    Next
	End If
End Sub

'============================================================================
Sub ChartEx0_OnScrollEnd()

	If cbo1.currentindex = "0" Then
		DATAMANAGER.RequestNextData( "ohhts_3000_015r_1" )
	Else
		DATAMANAGER.RequestNextData( "ohhts_3000_015r" )
	End If

End Sub

