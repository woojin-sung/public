	<SCRIPT_INFO _len="8520" _ulen="8300" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주식현재가
' 02. 화면설명 : 주식현재가 단일가탭
' 03. 작    성 : 2016.04.30 LJS
'
'20230420 KKM 현재가개선 : 폰트와 색상 수정
'20230420 KKM 현재가개선 : 대비율 (-)(%) 표기
'20230913 LES START : stck_cntg -> stck_incg로 교체(주식현재가 > 단일가 > 정규시장 가격)
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket, g_szItemName
Dim g_sztog1

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket	= Form.GetItemCodeInfo( g_szItemCode , "market")
	g_szItemName	 	= Form.GetItemCodeInfo( g_szItemCode , "name")
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	tblVolat.visible = false
	tblTime.visible = false
	
	
'	DATAMANAGER.RequestTranData( "ohhts_1181_001r" )
'	DATAMANAGER.RequestTranData( "ohhts_1181_002r" )
'	DATAMANAGER.RequestTranData( "ohhts_1126_001r" )

End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket	= Form.GetItemCodeInfo( g_szItemCode , "market")
		g_szItemName	 	= Form.GetItemCodeInfo( g_szItemCode , "name")
		
		DATAMANAGER.RequestTranData( "ohhts_1181_001r" )
		DATAMANAGER.RequestTranData( "ohhts_1181_002r" )
		DATAMANAGER.RequestTranData( "ohhts_1126_001r" )
	end	if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
'			Form.triggerEvent( "#", "REQUEST_ITEMCODE", "")
			Exit Sub
		End If
	
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		g_szItemName	 	= Form.GetItemCodeInfo( g_szItemCode , "name")
  
		DATAMANAGER.RequestTranData( "ohhts_1181_001r" )
		DATAMANAGER.RequestTranData( "ohhts_1181_002r" )
		DATAMANAGER.RequestTranData( "ohhts_1126_001r" )
		
	 end if
	 
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	Dim szOrdCode

	if szTranID = "ohhts_1126_001r" then
	    DATAMANAGER.CancelRealData("ohhts_stck_stat")	    
		
	    If Left(g_szItemCode, 1) = "J" or Left(g_szItemCode, 1) = "F" Then
		    szOrdCode = g_szItemMarket & g_szItemCode
		    
	    ElseIf g_szItemMarket = "J" or g_szItemMarket = "T" Then	'주식
		    szOrdCode = "A" & g_szItemCode
		    
		    
		ElseIf g_szItemMarket = "W" Then	'ELW
		    szOrdCode = "J" & g_szItemCode
		    
		Else
		    szOrdCode = g_szItemCode
		    
		End If
		
		DATAMANAGER.SetDataValue( 0, "ohhts_1126_001r", "InBlock1", "FID_SHRN_ISCD", 0 , szOrdCode)
	
	Elseif szTranID = "ohhts_1181_001r" then
		DATAMANAGER.CancelRealData( "ohhts_ovtp_aspr" )
		DATAMANAGER.CancelRealData( "ohhts_ovtp_cntg" )
		DATAMANAGER.CancelRealData( "ohhts_stck_aspr" )
	
	
		DATAMANAGER.SetDataValue( 0, "ohhts_1181_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_1181_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode)
		
	Elseif szTranID = "ohhts_1181_002r" then
		
		'20230913 LES START : stck_cntg -> stck_incg로 교체
		'DATAMANAGER.CancelRealData( "ohhts_stck_cntg" )
		DATAMANAGER.CancelRealData( "ohhts_stck_incg" )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_1181_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_1181_002r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode)
	
	End if

End Sub
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if szTranID = "ohhts_ovtp_aspr" then
	    DATAMANAGER.SetDataValue( 1, "ohhts_ovtp_aspr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )

	Elseif szTranID = "ohhts_ovtp_cntg" then 
		DATAMANAGER.SetDataValue( 1, "ohhts_ovtp_cntg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , g_szItemCode )
	
	Elseif szTranID = "ohhts_stck_aspr" then	
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )

	Elseif szTranID = "ohhts_stck_stat" then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_stat", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	
	'20230913 LES START : stck_cntg -> stck_incg로 교체
	'Elseif szTranID = "ohhts_stck_cntg" then
	Elseif szTranID = "ohhts_stck_incg" then
		
		'DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0 , g_szItemCode )
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", 0 , g_szItemCode )

	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szAplyCode

	If szTranID = "ohhts_1181_001r" then
		'호가컨트롤 속성		
		hogaTbl.startprice = DATAMANAGER.GetDataValue( 0, "ohhts_1181_001r", "OutBlock1", "FID_OVTM_UNTP_OPRC" , 0 )
		hogaTbl.highprice	 = DATAMANAGER.GetDataValue( 0, "ohhts_1181_001r", "OutBlock1", "FID_OVTM_UNTP_HPRC" , 0 )
		hogaTbl.lowprice	 = DATAMANAGER.GetDataValue( 0, "ohhts_1181_001r", "OutBlock1", "FID_OVTM_UNTP_LPRC" , 0 )

	
		DATAMANAGER.RequestRealData( "ohhts_ovtp_aspr" )
		DATAMANAGER.RequestRealData( "ohhts_ovtp_cntg" )
		DATAMANAGER.RequestRealData( "ohhts_stck_aspr" )
	
	ElseIf szTranID = "ohhts_1181_002r" then	
		
		'20230913 LES START : stck_cntg -> stck_incg로 교체
		'DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		DATAMANAGER.RequestRealData( "ohhts_stck_incg" )
	
	ElseIf szTranID = "ohhts_1126_001r" then
	    szAplyCode = DATAMANAGER.GetDataValue( 0, "ohhts_1126_001r", "OutBlock1", "FID_APLY_CLS_CODE" , 0 )'1:발동 , 2:해제 
	   
	    If szAplyCode = "1" Then 	
		    tblVolat.Visible = True 
		    tblFour.SetCellString( 0 , 0 , "변동성완화" )
	    Else
		    tblVolat.Visible = False 
		    tblFour.SetCellString( 0 , 0 , "예 상 체 결" )
	    End if 
	    
	    DATAMANAGER.RequestRealData( "ohhts_stck_stat" )

	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	Dim szAplyCode

    If szTranID ="ohhts_stck_stat" then
		szAplyCode = DATAMANAGER.GetDataValue( 1, "ohhts_stck_stat", "OutBlock1", "FIDR_APLY_CLS_CODE", 0 )'1:발동 , 2:해제 
		
	    If szAplyCode = "1" Then 	
		    tblVolat.Visible = True 
		    tblFour.SetCellString( 0 , 0 , "변동성완화" )
	    Else
		    tblVolat.Visible = False 
		    tblFour.SetCellString( 0 , 0 , "예 상 체 결" )
	    End if
    
    End if 
    
End Sub

