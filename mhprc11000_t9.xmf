'============================================================================
Sub btnPopUp_OnClick()
	Form.OpenFramePopup( "mhprc11000_pa", g_szItemCode & "|" & g_szItemName, "")
End Sub


'============================================================================
Sub tblTime_OnClick(lRow, lCol)
	If lCol = 1 And lRow  = 0 then
		tblTime.visible = false
	End If
	
End Sub



