--===========================================================================
--===========================================================================


Dim g_cid

'============================================================================
Sub Form_OnFormInitBefore()
	
	
	g_cid = Form.GetSharedData("Shared_CID", false )
	
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_105r", "InBlock1", "OUTS_INVT_ADCP_CODE" , 0 , g_cid)
	
	DATAMANAGER.RequestTranData("obcpp_rbit_105r")
		

End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	temp1 = DATAMANAGER.GetDataValue(0,"obcpp_rbit_105r", "OutBlock1", "ADCP_NAME" , 0)	
	temp2= temp1

	
	Label2.caption = "'"&temp2&"'의 운용 철학"
	
	
	Grid0.SetCellData("bd_cell0", 0, "자문사명")
	Grid0.SetCellData("bd_cell2", 0, "설립년도")	
	Grid0.SetCellData("bd_cell4", 0, "평균 수익률")
	Grid0.SetCellData("bd_cell6", 0, "총 자산 규모")
	Grid0.SetCellData("bd_cell8", 0, "대표 전화")
	Grid0.SetCellData("bd_cell10", 0, "대표명")
	Grid0.SetCellData("bd_cell12", 0, "대표 이메일")
	


End Sub

