	<CONTROL_INFO>
		<LABEL name="lblTitle" fontsize="3" caption="환율조회" paddinginfo="1,0,0,0" click="1" ly_vert="47,0,283,47,1" />
		<FORMTAB name="fmtab01" tabcount="2" tabwidthtype="1" tabheadheight="45" ly_vert="1,53,375,702,1" >
			<PAGE name="page004044" caption="환전환율" linkfile="nrsbbnk65100_t1" />
			<PAGE name="page000701" caption="통화별환율" linkfile="nrsbbnk65100_t2" />
		</FORMTAB>
		<IMAGE name="imgTitleArrow" autosize="1" ly_vert="200,16,39,15,1" />
		<COMBO name="Combo0" visible="0" cbinputdatatext="환율조회
환전신청
목표환율환전신청
환전내역" popuptitle="메뉴를 선택해 주세요." ly_vert="505,117,111,40,0" />
