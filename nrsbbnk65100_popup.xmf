	<SCRIPT_INFO _len="2473" _ulen="2391" >
'환율조회

'============================================================================
Sub Form_OnFormInitBefore()
'	ImgBackPress.setMaintainingRatio("1")
'	imgTitleArrow.setMaintainingRatio("1")	
'	imgInfo.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()	
	szLinkCrcd = Form.GetOpenLinkData()
	Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "INFO_REFRESH", szLinkCrcd)
	'-----------------------------------------------
	' 타이틀 초기화
	'-----------------------------------------------
	Dim nWidth
	lblTitle.paddinginfo = "0,0,0,0"
	
	nWidth = Form.GetTextWidth(lblTitle.caption, 3, false, false)
	
	imgTitleArrow.maintainratio = "2" 
	imgTitleArrow.imgpath = "icon_arrow_down2"
	imgTitleArrow.visible = true
	imgTitleArrow.left = 47 + nWidth + 10	
	
	'-----------------------------------------------
	' 뒤로가기 버튼 초기화
	'-----------------------------------------------
	imgBack.SetMaintainingRatio("2")
	imgBack.imgpath = "icon_main_01"	
End Sub


'============================================================================
Sub imgBack_OnClick()
	'Form.OpenPrevScreen()	
	Form.CloseForm()
End Sub

'============================================================================
Sub imgTitle_OnClick()
	'Form.OpenFramePopup("mbonl87056_p9", "", "")	
End Sub

'============================================================================
Sub lblTitle_OnClick()
	imgTitleArrow_OnClick()
End Sub

'메뉴
'============================================================================
Sub imgTitleArrow_OnClick()
	'imgTitleArrow.imgpath = "icon_arrow_up2.png"
	Combo0.currentindex = 0
	Combo0.OpenList()	
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	if iIndex == 1 then  '환전신청
		Form.CloseForm()
		Form.OpenScreen("65000" , "") 
	elseif iIndex == 2 then '목표환율환전신청
		Form.CloseForm()
		Form.OpenScreen("65010" , "")  
	elseif iIndex == 3 then '환전내역
		Form.CloseForm()
		Form.OpenScreen("65020" , "") 
	else '환율조회
		imgTitleArrow.imgpath = "icon_arrow_down2.png"
	end if 
End Sub

'============================================================================
Sub fmtab01_OnTabChanged(nCurrentTab)
	
	Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "INFO_REFRESH", "")
End Sub


	</SCRIPT_INFO>
</ROOT>