'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_iDataCount
Dim g_sUserID


'============================================================================
Sub Form_OnFormInit()
'	FormTab0.setTabHeaderImage("bg_tab_sel.9.png" , "bg.tab_nor.9.png" , 6) '활성화/비활성화/여백
'	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 6) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상

	FormTab0.insertPage( FormTab0.tabcount, "page1", "page1", "empty", "0", "전체")
	FormTab0.insertPage( FormTab0.tabcount, "page2", "page2", "empty", "0", "MY")
'	FormTab0.currenttab = 0
	
	Dim szTab
	szTab = Form.GetEnvData("Bond365_News_Tab")
	
	if szTab == "" or szTab == null then
		szTab = "0"
		Form.SetEnvData("1", "Bond365_News_Tab", szTab)
	end if
	FormTab0.currenttab = CInt(szTab)
	
	g_sUserID = Form.GetSharedData("&USER_ID" , false)
	
	gridData.scrollenable = "0"
	
	gridData.rowcount = 0
	DATAMANAGER.RequestTranData( "ohhts_news_009r")
	
End Sub


'============================================================================
Sub lblMore_OnClick()
	Dim szLinkData
	szLinkData = ""
	
	Form.OpenPopup("mbonl90031", szLinkData, "")
End Sub

'============================================================================
Sub gridData_OnClickUp(lRow, szCellID)
	Dim szValue, szLinkData
	Dim szTitle, szDate, szTime, szNewCorpName, szNewKey, szNewsCorpCode, szCode, szName
		
	szValue = gridData.GetCellData("FID_SRNO2",	lRow )

	szTitle			= gridData.GetCellData("FID_TITL",			lRow )	' 제목			-- FID_TITL
	szDate			= Left(szValue, 8)								' 날짜   		-- FID_DATE
	szTime			= Mid(szValue, 9, 6)								' 시간    		-- FID_CNTG_HOUR
	szNewCorpName		= gridData.GetCellData("FID_KOR_ISNM",		lRow )	' 뉴스제공업체명 	-- FID_KOR_ISNM
	szNewKey			= gridData.GetCellData("FID_NEWS_KEY",		lRow )	' 뉴스키       	-- FID_NEWS_KEY
	szNewsCorpCode	= gridData.GetCellData("FID_NEWS_OFER_ENTP_CODE",	lRow )' 뉴스제공업체코드-- FID_NEWS_OFER_ENTP_CODE
	szCode			= ""
	
	szName			= Form.GetItemCodeInfo(szCode, "name")
	
	szLinkData = "mbonl90001" & "★" & 
				szTitle & "|" & 
				szDate & "|" & 
				szTime & "|" & 
				szNewCorpName & "|" & 
				szNewKey & "|" & 
				szNewsCorpCode & "|" &  
				szName 
	
	'뉴스 상세내용 보기
	Form.OpenPopup( "mbonl90031_p1" , szLinkData, "" )
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	if (nCurrentTab == 0) then
		gridData.rowcount = 0
		DATAMANAGER.RequestTranData( "ohhts_news_009r")
	else
		gridData.rowcount = 0
		DATAMANAGER.RequestTranData("ohhts_news_011r")
	end if
	
	Form.SetEnvData("1", "Bond365_News_Tab", CStr(nCurrentTab))
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szErrCode == "9900" then
		if szTranID == "ohhts_news_011r" then
			if CInt(gridData.rowcount) == 0 then
				tblNoData.visible = True
			else
				tblNoData.visible = False
			end if
		end if
		
	else
		if szSubErr <> null and Trim(szSubErr) <> "" then
			Form.ShowAlert( "알림" , "mbonl90001_s3("..szTranID..")\n" .. szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
		else
			Form.ShowAlert( "알림" , "mbonl90001_s3("..szTranID..")\n" .. szErrCode .. " : ".. szErrMsg)
		end if
	
	end if
	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szValue
	
	if szTranID == "ohhts_news_009r" then
		'20240220 전체조회코드가 아닌 개별조회로 채권으로 디폴트 조회
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_CLS_CODE",		0 , "00")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_TITL",			0 , "채권")

	elseif szTranID == "ohhts_news_011r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_USER_ID",		0 , g_sUserID)
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iDataCount, iCount
	
	if szTranID == "ohhts_news_009r" then
		g_iDataCount = gridData.rowcount
		
		iDataCount = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		
		if CInt(g_iDataCount) == 0 and CInt(iDataCount) == 0 then
			
			Exit Sub
		end if
		
		iCount = 0
		for i = 0 to iDataCount - 1
			if iCount >= 3 then
				Exit for
			end if 
			
			szTemp1  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_SRNO2",				i)
			szTemp2  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_NEWS_OFER_ENTP_CODE",	i)
			szTemp3  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_KOR_ISNM",			i)
			szTemp4  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_NEWS_KEY",			i)
			szTemp5  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_TITL",				i)
			
			gridData.AddRow()
						
			gridData.SetCellData("FID_SRNO2",				g_iDataCount + i, szTemp1)
			gridData.SetCellData("FID_NEWS_OFER_ENTP_CODE",	g_iDataCount + i, szTemp2)
			gridData.SetCellData("FID_KOR_ISNM",				g_iDataCount + i, szTemp3)
			gridData.SetCellData("FID_NEWS_KEY",				g_iDataCount + i, szTemp4)
			gridData.SetCellData("FID_TITL",				g_iDataCount + i, szTemp5)

			iCount = iCount + 1
		next
		
'		g_iDataCount = g_iDataCount + iDataCount
'		gridData.rowcount = g_iDataCount
		
'		if DATAMANAGER.IsMoreNextData(szTranID) == true then
'			Form.SetTimerEvent(1, 1, 1)
'			DATAMANAGER.RequestNextData(szTranID)						
'		end if

		tblNoData.visible = False
		
	elseif szTranID == "ohhts_news_011r" then
		g_iDataCount = gridData.rowcount
		
		iDataCount = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		
		if CInt(g_iDataCount) == 0 and CInt(iDataCount) == 0 then
			
			Exit Sub
		end if
		
		iCount = 0
		for i = 0 to iDataCount - 1
			if iCount >= 3 then
				Exit for
			end if 
			
			szTemp1  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_SRNO2",				i)
			szTemp2  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_DATE",				i)
			szTemp3  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_HOUR",				i)
			szTemp4  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_NEWS_OFER_ENTP_CODE",	i)
			szTemp5  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_KOR_ISNM",			i)
			szTemp6  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_NEWS_KEY",			i)
			szTemp7  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_TITL",				i)
			
			gridData.AddRow()
						
			gridData.SetCellData("FID_SRNO2",				g_iDataCount + i, szTemp1)
			gridData.SetCellData("FID_NEWS_OFER_ENTP_CODE",	g_iDataCount + i, szTemp4)
			gridData.SetCellData("FID_KOR_ISNM",				g_iDataCount + i, szTemp5)
			gridData.SetCellData("FID_NEWS_KEY",				g_iDataCount + i, szTemp6)
			gridData.SetCellData("FID_TITL",				g_iDataCount + i, szTemp7)
			gridData.SetCellData("FID_DATE",				g_iDataCount + i, szTemp7)
			gridData.SetCellData("FID_HOUR",				g_iDataCount + i, szTemp7)

			iCount = iCount + 1
		next
		
'		g_iDataCount = g_iDataCount + iDataCount
'		gridData.rowcount = g_iDataCount
		
'		if DATAMANAGER.IsMoreNextData(szTranID) == true then
'			Form.SetTimerEvent(1, 1, 1)
'			DATAMANAGER.RequestNextData(szTranID)						
'		end if

		tblNoData.visible = False
		
	end if
	
End Sub

