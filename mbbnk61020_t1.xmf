	<SCRIPT_INFO _len="9805" _ulen="9057" >
--===========================================================================
' 2020.10.08. 장원혁 v001 : 비밀번호 평문 제거
' 2020.10.26. 장원혁 v002 : 은행이체용 암호화 함수 사용 (비밀번호)
' 2023.01.03. 장원혁 v003 : 카카오뱅크 은행제휴계좌 개설 추가
' 2024.07.10. 임종현 v004 : 토스뱅크 은행제휴계좌 개설 추가

'(증권 잔액조회)
' - 증권비밀번호 불필요
'
'(은행 잔액조회)
' - 은행비밀번호 필요
'
' (입금)
' - 증권비밀번호 필요 & 은행비밀번호 필요 & 공동인증 필요
'
' (출금)
' -증권비밀번호 필요 & 공동인증 필요

'===========================================================================

Dim g_szAccountNumber	'계좌번호(8자리)
Dim g_szAccountSerialNumber	'계좌일련번호(2자리)
Dim g_szAccountPassword	'계좌비밀번호
Dim g_szAccountName		'계좌이름
Dim g_szPrcd
Dim g_szPrnm
Dim g_szMangBrcd
Dim g_szMangBrcdName
Dim g_nDrngAbleAmt
Dim g_szBankCode
Dim g_szBankName
Dim g_szBankAcnt

'============================================================================
Sub Form_OnFormInit()

    g_szAccountNumber       = ""
    g_szAccountSerialNumber = ""
    g_szAccountPassword     = ""
    g_szAccountName         = ""
    g_szPrcd                = ""
    g_szPrnm                = ""
    g_szMangBrcd            = ""
    g_szMangBrcdName        = ""
    g_nDrngAbleAmt          = 0
    g_szBankCode            = ""
    g_szBankName            = ""
    g_szBankAcnt            = ""
    
    edtPwd.SetAriaBank() 
    
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
    
    If sEventName == "AllAccount" Or sEventName == "Password" Then '계좌전체
    
        Dim szList
        szList = Split(sParam, "★")
		
        If UBOUND(szList) < 1 Then 
            Exit Sub
        End If
        
        g_szAccountNumber = szList(0)
        g_szAccountSerialNumber = szList(1)
	
        If szList(2) <> "" Then
            g_szAccountPassword = szList(2)
        Else
            g_szAccountPassword = ""
        End If
		
        If szList(3) <> "" Then
            g_szAccountName = szList(3)
        Else
            g_szAccountName = ""
        end if
	
        if szList(4) <> "" then
            g_szPrcd = szList(4)
        else
            g_szPrcd = ""
        end if
	
        if szList(5) <> "" then
            g_szPrnm = szList(5)
        else
            g_szPrnm = ""
        end if
	
        if szList(6) <> "" then
            g_szMangBrcd = szList(6)
        else
            g_szMangBrcd = ""
        end if
	
        if szList(7) <> "" then
            g_szMangBrcdName = szList(7)
        else
            g_szMangBrcdName = ""
        end if
	
        if szList(8) <> "" then
            g_nDrngAbleAmt = szList(8)
        else
            g_nDrngAbleAmt = 0
        end if	
	
        if szList(9) <> "" then
            g_szBankCode = szList(9)
        else
            g_szBankCode = ""
        end if
	
        if szList(10) <> "" then
            g_szBankName = szList(10)
        else
            g_szBankName = ""
        end if
	
        if szList(11) <> "" then
            g_szBankAcnt = szList(11)
        else
            g_szBankAcnt = ""
        end if
		
        edtBankName.caption = g_szBankName
        edtBankAcnt.caption = g_szBankAcnt
        lblAcnm.caption     = g_szAccountName
	
        edtPwd.caption = ""       '은행계좌비밀번호
        edtAbleAmt.caption = ""   '은행계좌잔고
	
        edtPwd.visible = True '일반비밀번호

        If Trim(g_szBankAcnt) <> "" Then
            btnMnrc.enable = True '입금버튼
        Else
            btnMnrc.enable = False '입금버튼
        End If
	
	'v004
	if g_szBankCode == "092" then
	    edtPwd.enable = False
	    Label0.visible = True
	    edtPwd.hintcaption =""
            btnIqry_OnClick()
	else
	    edtPwd.enable = True
	    edtPwd.hintcaption ="비밀번호"
	    Label0.visible = False
	end if 
	

    End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

    If szTranID == "obtsd_asec_023a" Then
    
        plain_rm = Form.GetSharedData("&PLAIN_RM" , False) 'v001
        If plain_rm == "1" Then
            sPass = edtPwd.caption 
        Else
            sPass = Form.EncryptARIA(edtPwd.caption) 
        End If
		
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PWD"       , 0 , sPass)	
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "SCRT_ACNO" , 0 , g_szAccountNumber)
	
    End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    Form.ShowAlert("알림", szErrMsg)
End Sub

'============================================================================
Sub btnIqry_OnClick()

	'v004
	if g_szBankCode == "092" then
	    DATAMANAGER.RequestTranData("obtsd_asec_023a")
	else	   

	
	    If Len(edtPwd.caption) <= 0 Then
		Form.ShowAlert( "알림", "은행계좌 비밀번호를 입력해주세요." )
		Exit Sub
	    End If
	
	    DATAMANAGER.RequestTranData("obtsd_asec_023a")
	end if 
	
End Sub

'============================================================================
' btn100_OnClick - 이체금액 100만 버튼
'============================================================================
Sub btn100_OnClick()
	Dim tempNum
	tempNum = edtOutAmt01.caption
	edtOutAmt01.caption = tempNum + 1000000
End Sub

'============================================================================
' btn50_OnClick - 이체금액 50만 버튼
'============================================================================
Sub btn50_OnClick()
	Dim tempNum
	tempNum = edtOutAmt01.caption
	edtOutAmt01.caption = tempNum + 500000
End Sub

'============================================================================
' btn10_OnClick - 이체금액 10만 버튼
'============================================================================
Sub btn10_OnClick()
	Dim tempNum
	tempNum = edtOutAmt01.caption
	edtOutAmt01.caption = tempNum + 100000
End Sub

'============================================================================
' btn5_OnClick - 이체금액 5만 버튼
'============================================================================
Sub btn5_OnClick()
	Dim tempNum
	tempNum = edtOutAmt01.caption
	edtOutAmt01.caption = tempNum + 50000
End Sub

'============================================================================
' btn1_OnClick - 이체금액 1만 버튼
'============================================================================
Sub btn1_OnClick()
	Dim tempNum
	tempNum = edtOutAmt01.caption
	edtOutAmt01.caption = tempNum + 10000
End Sub

'============================================================================
' btnAll_OnClick - 이체금액 전액버튼
'============================================================================
Sub btnAll_OnClick()
	edtOutAmt01.caption = edtAbleAmt.caption
End Sub

'============================================================================
Sub btnMod_OnClick()
	edtOutAmt01.caption = ""
End Sub

'============================================================================
Sub btnMnrc_OnClick()

    If Len(edtOutAmt01.caption) == 0 Or CDbl(edtOutAmt01.caption) == 0 then
        Form.MsgBox( "알림", "이체금액을 확인하세요.", "", 0 )
        Exit Sub
    End If
    
    if Len(edtAbleAmt.caption) == 0 Or CDbl(edtAbleAmt.caption) == 0 then
        Form.MsgBox( "알림", "이체가능금액을 확인하세요.", "", 0 )
        Exit Sub
    end if
	
    if CDbl(edtAbleAmt.caption) <  CDbl(edtOutAmt01.caption) then
        Form.MsgBox( "알림", "이체금액이 이체가능금액보다 큽니다.", "", 0 )
        Exit Sub
    end if
    
    If CDbl(edtOutAmt01.caption) > 100000000 Then
        Form.MsgBox( "알림", "이체한도가 초과되었습니다. (1회 입금한도 1억원)", "", 0 )
        Exit Sub
    End If
    
    If Len(g_szAccountPassword) == 0 Then
        Form.MsgBox( "알림", "계좌 비밀번호를 확인 하세요.", "", 0 )
        Exit Sub
    End If
    
    If Len(edtPwd.caption) == 0  and g_szBankCode <> "092" Then
        Form.MsgBox( "알림", "연계계좌 비밀번호를 확인 하세요.", "", 0 )
        Exit Sub
    End If
	
    Form.OpenPopup( "mbbnk61020_p1" , "" , "" )
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

    if sKeyName = "INFO_POPUP" then
	
        if sRet == "OK" then
		
		   sData = ""
		
            plain_rm = Form.GetSharedData("&PLAIN_RM" , False) 'v001
            If plain_rm == "1" Then 
                sData = g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & g_szAccountName & "★" & edtPwd.caption & "★" & 
                edtBankName.caption & "★" & edtBankAcnt.caption & "★"& edtOutAmt01.caption & "★"& lblAcnm.caption		    
            Else
                sData = g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & g_szAccountName & "★" & Form.EncryptARIA(edtPwd.caption) & "★" &
                edtBankName.caption & "★" & edtBankAcnt.caption & "★"& edtOutAmt01.caption & "★"& lblAcnm.caption
            End If

            Form.OpenPopup("mbbnk61020_p2" , sData , "")
        end if
		
    ElseIf sKeyName = "CORNFORM_POPUP" then
    
        if sRet == "OK" then '은행 -> 증권 입금완료
            edtOutAmt01.caption = ""
            Form.triggerEvent("#" , "CORNFORM_OK", "2")
        end if
    end if
    
End Sub


	</SCRIPT_INFO>
