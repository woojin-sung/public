	<SCRIPT_INFO _len="3838" _ulen="3730" >
--===========================================================================
Dim pid
Dim nRow
Dim count
--===========================================================================

'============================================================================
Sub Form_OnFormInit()
	
	count = 0

	DATAMANAGER.SetDataValue(0,  "obcpp_rbit_019r", "InBlock1", "PRTF_ID",  0,pid)

	DATAMANAGER.RequestTranData("obcpp_rbit_019r")
	
End Sub

'============================================================================

'============================================================================
Sub Form_OnFormInitBefore()
	pid = Form.GetSharedData("Shared_PID", false)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcpp_rbit_019r" then
		nRow = DATAMANAGER.GetDataCount(0,"obcpp_rbit_019r", "OutBlock1"  )
		
		
		for i = count to count+nRow-1
			Item_Mecro(i)
			Risk_Mecro(i)
			Nation_Mecro(i)
		Next
		count = count + nRow
	end if
			
	
End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	DATAMANAGER.RequestNextData("obcpp_rbit_019r")
End Sub

'============================================================================

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
End Sub

'============================================================================
Function Item_Mecro(lRow)
	if Grid0.GetCellData("bd_cell1", lRow) == "a" then
		Grid0.SetCellData("bd_cell1", lRow,"주식")
	elseif Grid0.GetCellData("bd_cell1", lRow) == "b" then
		Grid0.SetCellData("bd_cell1", lRow,"채권")
	elseif Grid0.GetCellData("bd_cell1", lRow) == "c" then
		Grid0.SetCellData("bd_cell1", lRow,"선물")
	elseif Grid0.GetCellData("bd_cell1", lRow) == "d" then
		Grid0.SetCellData("bd_cell1", lRow,"현금")
	elseif Grid0.GetCellData("bd_cell1", lRow) == "e" then
		Grid0.SetCellData("bd_cell1", lRow,"부동산")
	elseif Grid0.GetCellData("bd_cell1", lRow) == "f" then
		Grid0.SetCellData("bd_cell1", lRow,"예적금")
	elseif Grid0.GetCellData("bd_cell1", lRow) == "g" then
		Grid0.SetCellData("bd_cell1", lRow,"기타")
	end if
End Function

'============================================================================
Function Risk_Mecro(lRow)
	if Grid0.GetCellData("bd_cell2", lRow) == "1" then
		Grid0.SetCellData("bd_cell2", lRow,"초저위험")
	elseif Grid0.GetCellData("bd_cell2", lRow) == "2" then
		Grid0.SetCellData("bd_cell2", lRow,"초저위험+")
	elseif Grid0.GetCellData("bd_cell2", lRow) == "3" then
		Grid0.SetCellData("bd_cell2", lRow,"저위험")
	elseif Grid0.GetCellData("bd_cell2", lRow) == "4" then
		Grid0.SetCellData("bd_cell2", lRow,"저위험+")
	elseif Grid0.GetCellData("bd_cell2", lRow) == "5" then
		Grid0.SetCellData("bd_cell2", lRow,"중위험")
	elseif Grid0.GetCellData("bd_cell2", lRow) == "6" then
		Grid0.SetCellData("bd_cell2", lRow,"중위험+")
	elseif Grid0.GetCellData("bd_cell2", lRow) == "7" then
		Grid0.SetCellData("bd_cell2", lRow,"고위험")
	elseif Grid0.GetCellData("bd_cell2", lRow) == "8" then
		Grid0.SetCellData("bd_cell2", lRow,"고위험+")
	elseif Grid0.GetCellData("bd_cell2", lRow) == "9" then
		Grid0.SetCellData("bd_cell2", lRow,"초고위험")
	elseif Grid0.GetCellData("bd_cell2", lRow) == "10" then
		Grid0.SetCellData("bd_cell2", lRow,"초고위험+")

	end if
End Function

'============================================================================
Function Nation_Mecro(lRow)
	if Grid0.GetCellData("bd_cell3", lRow) == "1" then
		Grid0.SetCellData("bd_cell3", lRow,"국내")
	elseif Grid0.GetCellData("bd_cell3", lRow) == "2" then
		Grid0.SetCellData("bd_cell3", lRow,"해외")

	end if
End Function


