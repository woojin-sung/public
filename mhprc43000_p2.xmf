'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nIndex				'셀 선택 Index
Dim g_szCellID			'
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' 
'============================================================================
Sub Form_OnFormInit()

	g_szCellID = Form.GetOpenLinkData()
	
	grd0.SetCellData("bd_cell0", 0, "개인")
	grd0.SetCellData("bd_cell0", 1, "외국인")
	grd0.SetCellData("bd_cell0", 2, "기관계")
	grd0.SetCellData("bd_cell0", 3, "금융투자")
	grd0.SetCellData("bd_cell0", 4, "보험")
	grd0.SetCellData("bd_cell0", 5, "투신")
	grd0.SetCellData("bd_cell0", 6, "기타금융")
	grd0.SetCellData("bd_cell0", 7, "은행")
	grd0.SetCellData("bd_cell0", 8, "연기금")
	grd0.SetCellData("bd_cell0", 9, "사모펀드")
	grd0.SetCellData("bd_cell0", 10, "국가지방")
	grd0.SetCellData("bd_cell0", 11, "기타법인")
End Sub
'============================================================================
' btnClose_OnClick()
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
' imgClose_OnClick()
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID)
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	
	g_nIndex = lRow
	Form.CloseForm()

End Sub

'============================================================================
Sub Form_OnFormClose()
	
	Select Case g_nIndex
		Case 0
			Form.SendReturnToParent(g_szCellID , grd0.GetCellData("bd_cell0", 0))
		Case 1
			Form.SendReturnToParent(g_szCellID , grd0.GetCellData("bd_cell0", 1))
		Case 2
			Form.SendReturnToParent(g_szCellID , grd0.GetCellData("bd_cell0", 2))
		Case 3
			Form.SendReturnToParent(g_szCellID , grd0.GetCellData("bd_cell0", 3))
		Case 4
			Form.SendReturnToParent(g_szCellID , grd0.GetCellData("bd_cell0", 4))
		Case 5
			Form.SendReturnToParent(g_szCellID , grd0.GetCellData("bd_cell0", 5))
		Case 6
			Form.SendReturnToParent(g_szCellID , grd0.GetCellData("bd_cell0", 6))
		Case 7
			Form.SendReturnToParent(g_szCellID , grd0.GetCellData("bd_cell0", 7))
		Case 8
			Form.SendReturnToParent(g_szCellID , grd0.GetCellData("bd_cell0", 8))
		Case 9
			Form.SendReturnToParent(g_szCellID , grd0.GetCellData("bd_cell0", 9))
		Case 10
			Form.SendReturnToParent(g_szCellID , grd0.GetCellData("bd_cell0", 10))
		Case 11
			Form.SendReturnToParent(g_szCellID , grd0.GetCellData("bd_cell0", 11))
	End Select
End Sub

