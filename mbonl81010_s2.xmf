'============================================================================
Sub BtnNext_OnClick()
    
    If Q1Answer == 2 And Q2Answer <> 2 Then '1번답이 '예'인데 2번 답은 '예'가 아닐 경우
        Form.MsgBox("알림", "투자권유 희망 시 고객정보 제공은 필수입니다.", "", 0)
        Exit Sub    
    End If
   
    If ChckFlag == 0 Then
	    Form.MsgBox("알림", "내용에 동의해주세요.", "", 0)
	    Exit Sub
    End If 
	
	'투자권유불원 + 투자정보미제공
	If Q1Answer == 1 And Q2Answer == 1 Then
		If g_nTryCnt > 1 Then
			Form.OpenPopup("mbonl81010_p15" , "" , "")
		Else
			If g_CUST_CLS_CODE = "1" Then						'개인
				DATAMANAGER.RequestTranData("obcsb_acif_715a")
			Else												'법인
				If Set712Input() == True Then
					'21.09.13 JHY START : 2회차부터 재진단 사유 표기
					If 1 < g_nTryCnt Then
						If g_nTryCnt < 4 Then
							Form.OpenPopup("mbonl81010_p15" , "" , "")
						Else
							Form.ShowAlert("알림", "투자성향진단 등록은 1일 3회까지만 가능합니다 (등록횟수 초과)")
						End If
					Else
					    DATAMANAGER.RequestTranData("obcsb_acif_712a")
					End If          
				End If
			End if 
		End If
	Else
		If g_CUST_CLS_CODE = "1" Then						'개인
			DATAMANAGER.RequestTranData("obcsb_acif_715a")
		Else												'법인
'			DATAMANAGER.RequestTranData("obcsb_acif_712a")
			
'			'투자권유여부 : 아니오
'			If Q1Answer == "1" or Q1Answer == 1 Then
'				g_RCMD_YN = "N"
'			'투자권유여부 : 예
'			ElseIf Q1Answer == "2" or Q1Answer == 2 Then
'				g_RCMD_YN = "Y"
'			End If	
'			Form.SetSharedData("81010_RCMD_YN" , g_RCMD_YN)
'			
'			'고객정보제공여부 : 아니오
'			If Q2Answer == "1" or Q2Answer == 1 Then
'				g_INFO_OFER_YN = "N"
'			'고객정보제공여부 : 예
'			ElseIf Q2Answer == "2" or Q2Answer == 2 Then
'				g_INFO_OFER_YN = "Y"
'			End If
'			Form.SetSharedData("81010_INFO_OFER_YN" , g_INFO_OFER_YN)

			' 투자권유구분 설정
			fn_InvtRcmdSet()
			
			If g_nTryCnt < 4 Then
				'투자성향 진단 단계로 넘어감
				Form.OpenPopup("mbonl81010_s4", g_szAccNo & "★" & g_szPassword, "")
			Else
				Form.ShowAlert("알림", "투자성향진단 등록은 1일 3회까지만 가능합니다 (등록횟수 초과)")
			End If
		End if 
	End If
End Sub


'============================================================================
Sub ImgClose_OnClick()
	Form.SendReturnToParent("mbonl81010_s2" , "OK")
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
    ImgClose_OnClick()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'취약금융소비자 > 예
    If sKeyName == "MBBDM85141_P3" Then
        If sRet == "ok" Then
            Q3Answer = 2
            ContainerBody.ImgQ3A1.imgpath = unPressedImgPath
            ContainerBody.ImgQ3A2.imgpath = PressedImgPath          
            Common_Check()           
        End If
    End If
    
    '등록 완료 리턴
	If sKeyName == "MBBDM85143" then
		Form.SendReturnToParent("mbonl81010_s2" , "OK")
		Form.CloseForm()
	End If
    
    '투자성향진단 재진단 사유 입력 완료
    if sKeyName == "close_mbonl81010_p15" then
	    if sRet <> "" then

			fn_InvtRcmdSet() '투자권유구분 설정
			DATAMANAGER.ClearInputData(0, "obcsb_acif_712a")
			Set712Input("obcsb_acif_712a")
		    ' 재진단 사유는 여기서 넣어줌
		    Dim tReason
		    tReason = split(sRet, "★")
		    
		    if tReason <> "" and tReason <> NULL then
			    if tReason[0] <> NULL and tReason[0] <> "" then
				    DATAMANAGER.SetDataValue( 0, "obcsb_acif_712a", "InBlock1", "KYC_REREG_REAS_CODE" , 0 , tReason[0])
			    end if
			    
			    if tReason[1] <> NULL and tReason[1] <> "" then
				    DATAMANAGER.SetDataValue( 0, "obcsb_acif_712a", "InBlock1", "KYC_REREG_REAS" , 0 , tReason[1])
			    end if
		    end if
		    
		    DATAMANAGER.RequestTranData("obcsb_acif_712a")
		end if
	end if
	
	'성향진단 화면 리턴(진단 종료)
	If sKeyName == "mbonl81010_s3" And sRet == "ok" Then
		Form.SendReturnToParent("mbonl81010_s2" , "OK")
		Form.CloseForm()
	End If
End Sub

