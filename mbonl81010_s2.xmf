'============================================================================
Function Set712Input()
    ' 21.08.31 JHY START (v001)
    ' 추후 고칠때 문항 갯수만 바꾸면 되도록 하나씩 분기처리 되어있던 소스코드 반복문으로 변경
    Dim nQuestionCnt
    nQuestionCnt = 13
    
    '기존 복수 응답 가능했던 3번 skip했으므로 여기서도 복수응답 예외처리 제외
    for i = 0 to 13
	    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock2", "QUES_QSIT_NO", i , i+1) 
	    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock2", "ITEM_NO_VAL" , i , "")
	    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock2", "RSPN_SLCT_YN", i , "Y")
    next
    ' 21.08.31 JHY END
    
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CONT_CLS_CODE" , 0 , g_CONT_CLS_CODE)
    
    If g_QUES_YN == "Y" Then
        DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "PROS_CLS_CODE" , 0 , "2" )
    Else
        DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
    End If
    
    DATAMANAGER.SetDataValue(0,  "obcsb_acif_712a", "InBlock1", "ACNO", 0, g_szAccNo )
    
    'v006
	If g_PlainRm = "1" Then '보안모듈 적용
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_712a", "InBlock1", "ACNT_PWD" , 0 , g_szPassword)
	Else
		If	g_szScrNo	=	"87040" Then
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_712a", "InBlock1", "ACNT_PWD" , 0 , g_szPassword)
		Else
			DATAMANAGER.SetDataValue( 0, "obcsb_acif_712a", "InBlock1", "ACNT_PWD" , 0 , Form.GetEncData(g_szPassword))
		End If
	End If
   
'    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "RCNO"                   , 0 , g_RCNO) 
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "RCNO_PIP"               , 0 , g_RCNO_PIP)    
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "RCNO_TYPE_CODE"         , 0 , g_RCNO_TYPE_CODE)
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CSNO"                   , 0 , g_CSNO) 
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CUST_CLS_CODE"          , 0 , g_CUST_CLS_CODE) '개인
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CUST_FULL_NAME"         , 0 , g_CUST_FULL_NAME)
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "PXPR_RCNO_TYPE_CODE"    , 0 , g_PXPR_RCNO_TYPE_CODE)
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "PXPR_RCNO_PIP" 		, 0 	, g_PXPR_RCNO_PIP) 'V007
'    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "PXPR_RCNO"              , 0 , g_PXPR_RCNO)
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "PXPR_NAME"              , 0 , g_PXPR_NAME)
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CUST_RLTS_CODE"         , 0 , g_CUST_RLTS_CODE)
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CUST_RLTS_ETC_CNTT"     , 0 , g_CUST_RLTS_ETC_CNTT)
    
    If g_RCMD_YN == "Y" Then
        DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0 , "1") '투자권유희망
    ElseIf g_RCMD_YN <> "Y" And g_INFO_OFER_YN == "Y" Then
        DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0 , "3") '투자권유불원(정보제공)
    ElseIf g_RCMD_YN <> "Y" And g_INFO_OFER_YN <> "Y" Then 
        DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0 , "4") '투자권유불원(정보미제공)
    End If
    
    return True
    
End Function

