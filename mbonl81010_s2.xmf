Sub BtnAgrm_OnClick()
	If ChckFlag == 0 Then
		ChckFlag = 1
		ImgChck.imgpath = "check_square_on.png"
	Else
		ChckFlag = 0
		ImgChck.imgpath = "check_square_off.png"
	End If 
End Sub

'============================================================================
Function fn_InvtRcmdSet()
	'투자권유여부 : 아니오
	If Q1Answer == "1" or Q1Answer == 1 Then
		g_RCMD_YN = "N"
	'투자권유여부 : 예
	ElseIf Q1Answer == "2" or Q1Answer == 2 Then
		g_RCMD_YN = "Y"
	End If	
	Form.SetSharedData("81010_RCMD_YN" , g_RCMD_YN)
	
	'고객정보제공여부 : 아니오
	If Q2Answer == "1" or Q2Answer == 1 Then
		g_INFO_OFER_YN = "N"
	'고객정보제공여부 : 예
	ElseIf Q2Answer == "2" or Q2Answer == 2 Then
		g_INFO_OFER_YN = "Y"
	End If
	Form.SetSharedData("81010_INFO_OFER_YN" , g_INFO_OFER_YN)
End Function


