'============================================================================
Sub Form_OnFormInit()
	ContainerBody.SetScrollAutoSize()    
	
	g_OsType = Form.GetSharedData("&OS_TYPE", False)
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", False ) 'v006
	g_szScrNo =		Form.GetSharedData("&SCREEN_NO", 0 )
	
	BtnNext.enable = False
	szTheme = Form.GetEnvData("common.theme")
	BtnNext.fgcolor = "269"
	If szTheme == "white" Then
	BtnNext.btnimage = "btn_21.9"
	Else
	BtnNext.btnimage = "btn_27.9"
	End If
	
	unPressedImgPath = "input_03_n.9.png"
	PressedImgPath   = "input_03_o.9.png"
	DisableImgPath   = "input_03_g.9.png"
	
	Q1Answer = 0
	Q2Answer = 0
	Q3Answer = 0
	
	ContainerBody.ImgQ1A1.imgpath = unPressedImgPath
	ContainerBody.ImgQ1A2.imgpath = unPressedImgPath    
	
	ContainerBody.ImgQ2A1.imgpath = unPressedImgPath
	ContainerBody.ImgQ2A2.imgpath = unPressedImgPath    
	
	ContainerBody.ImgQ3A1.imgpath = unPressedImgPath
	ContainerBody.ImgQ3A2.imgpath = unPressedImgPath        
	
	ChckFlag = 0
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		Dim tData
		tData = Split(szOpenData, "★")
		g_szAccNo = tData[0]
		g_szPassword = tData[1]
		
		DATAMANAGER.RequestTranData("obcsb_acif_701r")      
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obcsb_acif_715a" Then
		DATAMANAGER.SetDataValue(0 , "obcsb_acif_715a", "InBlock1", "CNSH_CLS_CODE"  , 0 , "09"     ) '확인서구분코드
		DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a", "InBlock1", "ACNO", 0, g_szAccNo )		'계좌번호
	
		If Q3Answer == "2" or Q3Answer == 2 Then '취약금융소비자입니까? : 예
			DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a", "InBlock1", "CUST_CNFR_YN", 0 , "Y" )	'고객확인여부
		ElseIf Q3Answer == "1" or Q3Answer == 1 Then '취약금융소비자입니까? : 아니오
			DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a", "InBlock1", "CUST_CNFR_YN", 0 , "N" )	'고객확인여부
		End If	    
	
	ElseIf szTranID == "obcsb_acif_701r" Then
		DATAMANAGER.SetDataValue(0, "obcsb_acif_701r", "InBlock1", "ACNO", 0, g_szAccNo)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "obcsb_acif_701r" Then
		'고객번호
		'고객명풀네임
		'투자권유구분
		'설문여부
		'고객구분코드
		'실명확인번호
		'접촉구분코드
		'실명확인번호 유형
		'대리인 실명확인번호 유형 코드
		'대리인실명확인번호
		'대리인명 
		'고객관계코드 
		'고객관계기타내용
		
		g_CSNO 				= DATAMANAGER.GetDataValue(0,  "obcsb_acif_701r", "OutBlock1", "CSNO" , 0)
		g_CUST_FULL_NAME 		= DATAMANAGER.GetDataValue(0,  "obcsb_acif_701r", "OutBlock1", "CUST_FULL_NAME" , 0 )
		g_KYC_INVT_RCMD_CLS_CODE	= DATAMANAGER.GetDataValue(0,  "obcsb_acif_701r", "OutBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0  )
		g_QUES_YN				= DATAMANAGER.GetDataValue(0,  "obcsb_acif_701r", "OutBlock1", "QUES_YN" , 0  )
		g_CUST_CLS_CODE			= DATAMANAGER.GetDataValue(0,  "obcsb_acif_701r", "OutBlock1", "CUST_CLS_CODE"  , 0 )
		'	g_RCNO				= DATAMANAGER.GetDataValue(0,  "obcsb_acif_701r", "OutBlock1", "RCNO"  , 0 ) 'v007
		g_RCNO_PIP				= DATAMANAGER.GetDataValue(0,  "obcsb_acif_701r", "OutBlock1", "RCNO_PIP"  , 0 ) 'v007
		g_CONT_CLS_CODE			= "4"				' HTS 접촉 코드
		g_RCNO_TYPE_CODE		= DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "RCNO_TYPE_CODE", 0)
		g_PXPR_RCNO_TYPE_CODE 	= DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "PXPR_RCNO_TYPE_CODE" , 0)	
		'	g_PXPR_RCNO 			= DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "PXPR_RCNO" , 0) 'V007
		g_PXPR_RCNO_PIP			= DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "PXPR_RCNO_PIP" , 0) 'V007
		g_PXPR_NAME 			= DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "PXPR_NAME" , 0)
		g_CUST_RLTS_CODE		= DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "CUST_RLTS_CODE" , 0)
		g_CUST_RLTS_ETC_CNTT		= DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "CUST_RLTS_ETC_CNTT" , 0)
		
		'21.09.08 JHY START (v009)
		g_nTryCnt = CDbl(DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "KYC_ACMP_TMNU" , 0)) 'KYC수행횟수
		
		'법인의 경우 취약금융소비자 영역 비활성화
		If g_CUST_CLS_CODE <> "1" Then
'			ContainerBody.ImgQ3A1.imgpath = DisableImgPath
'			ContainerBody.ImgQ3A2.imgpath = DisableImgPath        
'			
			ContainerBody.ImgQ3A1.imgpath = PressedImgPath
			ContainerBody.ImgQ3A2.imgpath = unPressedImgPath
			
			ContainerBody.ImgQ3A1.enable = false
			ContainerBody.ImgQ3A2.enable = false
			
			ContainerBody.Label3.fgcolor = "27"
			ContainerBody.LblQ3A1.fgcolor = "27"
			ContainerBody.LblQ3A2.fgcolor = "27"
		End If
		
'        '기존과 동일한 경우, 기등록정보로 처리
'        If g_ProsGb == "PASS" then
'            '1.투자권유희망+정보제공 2.투자권유희망+정보미제공 3.투자권유불원+정보제공 4.투자권유불원+정보미제공
'		   szInvtRcmdGb = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "KYC_INVT_RCMD_CLS_CODE", 0)
'            if szInvtRcmdGb == "1" or szInvtRcmdGb == 1 then
'                ContainerBody_ImgQ1A2_OnClick()
'                ContainerBody_ImgQ2A2_OnClick()
'                'Q1Answer = "2"
'                'Q2Answer = "2"
'            elseif szInvtRcmdGb == "2" or szInvtRcmdGb == 2 then
'                ContainerBody_ImgQ1A1_OnClick()
'                ContainerBody_ImgQ2A2_OnClick()
'                'Q1Answer = "1"
'                'Q2Answer = "2"
'            elseif szInvtRcmdGb == "3" or szInvtRcmdGb == 3 then
'                ContainerBody_ImgQ1A2_OnClick()
'                ContainerBody_ImgQ2A1_OnClick()
'                'Q1Answer = "2"
'                'Q2Answer = "1"
'            elseif szInvtRcmdGb == "4" or szInvtRcmdGb == 4 then
'                ContainerBody_ImgQ1A1_OnClick()
'                ContainerBody_ImgQ2A1_OnClick()
'                Q1Answer = "1"
'                Q2Answer = "1"
'            else
'                Q1Answer = ""
'                Q2Answer = ""
'		   end if
'
'            szWeakYN = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "WEAK_YN", 0)
'
'            if szWeakYN == "Y" then
'                ContainerBody_ImgQ3A2_OnClick()
'                'Q3Answer = "2"
'            elseif szWeakYN == "N" then
'                ContainerBody_ImgQ3A1_OnClick()
'                'Q3Answer = "1"
'            else
'                Q3Answer = ""
'            end if
'
'            'DATAMANAGER.RequestTranData("obcsb_acif_715a" )	'확인서 이력등록	
'        End If
    End If
    
    If szTranID == "obcsb_acif_715a" Then
'		'투자권유여부 : 아니오
'		If Q1Answer == "1" or Q1Answer == 1 Then
'			g_RCMD_YN = "N"
'		'투자권유여부 : 예
'		ElseIf Q1Answer == "2" or Q1Answer == 2 Then
'			g_RCMD_YN = "Y"
'		End If	
'		Form.SetSharedData("81010_RCMD_YN" , g_RCMD_YN)
'		
'		'고객정보제공여부 : 아니오
'		If Q2Answer == "1" or Q2Answer == 1 Then
'			g_INFO_OFER_YN = "N"
'		'고객정보제공여부 : 예
'		ElseIf Q2Answer == "2" or Q2Answer == 2 Then
'			g_INFO_OFER_YN = "Y"
'		End If
'		Form.SetSharedData("81010_INFO_OFER_YN" , g_INFO_OFER_YN)
		
		' 투자권유구분 설정
		fn_InvtRcmdSet()
		
		If g_INFO_OFER_YN == "Y" Then '정보제공인 경우
			'21.09.14 JHY START
			if g_nTryCnt < 4 then
				'투자성향 진단 단계로 넘어감
				Form.OpenPopup("mbonl81010_s3", g_szAccNo & "★" & g_szPassword, "")
			else
				Form.ShowAlert("알림", "투자성향진단 등록은 1일 3회까지만 가능합니다 (등록횟수 초과)")
			end if
			'21.09.14 JHY END
		    
		Else '정보미제공인경우, 바로 등록 
			If Set712Input() == True Then
				'21.09.13 JHY START : 2회차부터 재진단 사유 표기
				If 1 < g_nTryCnt Then
					If g_nTryCnt < 4 Then
						Form.OpenPopup("mbonl81010_p15" , "" , "")
					Else
						Form.ShowAlert("알림", "투자성향진단 등록은 1일 3회까지만 가능합니다 (등록횟수 초과)")
					End If
				Else
				    DATAMANAGER.RequestTranData("obcsb_acif_712a")
				End If          
			End If
		End If
	End If
	
	
    
    If szTranID == "obcsb_acif_712a" Then
        ' 21.09.13 JHY START
		'	[KYC투자성향등급코드]
		'	00@정보미제공
		'	01@고수익지향형
		'	02@성장지향형
		'	03@중립형
		'	04@안정지향형
		'	05@이자소득형
	
		Dim szInvGradeIn, szInvGradeOut, szEntt, szTrust, szEnttName, szTrustName
		
		'만기일 추가
		Dim szKycValid, szEnttValid, szTrustValid			'일반투자성향만기일, 일임형만기일, 신탁만기일
	
		szInvGradeIn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_INVT_INCL_GRAD_CODE", 0)
		szEntt = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ENTT_IVIC_GRCD", 0)
		szTrust = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TRUST_IVIC_GRCD", 0)
		
		szKycValid = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_VALD_PRD_MTRT_DATE", 0)
		szEnttValid = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ENTT_KYC_MTRT_DATE", 0)
		szTrustValid = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TRUST_KYC_MTRT_DATE", 0)
	
		' KYC꺼에 맵핑하면 된다고 권오상 차장님 확인
		szInvGradeOut = Form.GetMetaData("KYC투자성향등급코드", szInvGradeIn)
		szEnttName = Form.GetMetaData("KYC투자성향등급코드", szEntt)
		szTrustName = Form.GetMetaData("KYC투자성향등급코드", szTrust)

		Form.OpenPopup("mbbdm85143" , szInvGradeOut & "★" & szEnttName & "★" & szTrustName & "★" & szKycValid & "★" & szEnttValid & "★" & szTrustValid, "")  '진단완료
		' 21.09.13 JHY END
    End If    
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    If Trim(szSubMsg) == "" Then
        Form.MsgBox("알림" , szErrMsg, "", 6)
    Else
        Form.MsgBox("알림" , szErrMsg & Chr(13) & Chr(10) & "(" & szSubMsg & ")" , "", 6)
    End If	
    
End Sub

'============================================================================
Sub Common_Check()
	If g_CUST_CLS_CODE == "1" Then
		If (Q1Answer == "0" or Q1Answer == 0) Or (Q2Answer == "0" or Q2Answer == 0) Or (Q3Answer == "0" or Q3Answer == 0) Then
			BtnNext.enable = False
			BtnNext.fgcolor = "269"	
			szTheme = Form.GetEnvData("common.theme")
			If szTheme == "white" Then
			    BtnNext.btnimage = "btn_21.9"
			Else
			    BtnNext.btnimage = "btn_27.9"
			End If
		Else
			BtnNext.enable = True
			BtnNext.btnimage = "btn_20.9"
			BtnNext.fgcolor = "273"
		End If
	Else
		If (Q1Answer == "0" or Q1Answer == 0) Or (Q2Answer == "0" or Q2Answer == 0) Then
			BtnNext.enable = False
			BtnNext.fgcolor = "269"	
			szTheme = Form.GetEnvData("common.theme")
			If szTheme == "white" Then
			    BtnNext.btnimage = "btn_21.9"
			Else
			    BtnNext.btnimage = "btn_27.9"
			End If
		Else
			BtnNext.enable = True
			BtnNext.btnimage = "btn_20.9"
			BtnNext.fgcolor = "273"
		End If
	End If
End Sub

