	<SCRIPT_INFO _len="10922" _ulen="9253" >
Dim g_szDeviceOS
Dim g_nOpenIndex
g_nOpenIndex = -1

Dim g_tTitle, g_tSubTitle
Dim g_nIndex, g_nSubIndex


g_tTitle = {"신용거래융자약정", "신용거래대주약정", "증권담보융자약정" }
g_tSubTitle = {"이자 및 상환 방식", "담보 관련", "소비자 부담금액", "투자위험 및 불이익", "금융소비자의 권리", "기타 유의사항" }

Dim g_szTop, g_szHeight, g_szContainer
g_szTop = 165
g_szHeight = 433
g_szContainer = ""

Dim g_szRet 
g_szRet	=   "Cancel"

'============================================================================
Function SetContainerVisible()

	lbSubTitle.caption = g_tSubTitle[g_nSubIndex]
	
	Dim szName
	for i = 0 to #g_tTitle - 1
		for j = 0 to #g_tSubTitle - 1
			szName = "Container" & CStr(i) & CStr(j)	
			if i == g_nIndex and j == g_nSubIndex then
				Form.SetCtlProp(szName, "left", 0)
				g_szContainer = szName
			else
				Form.SetCtlProp(szName, "left", 500)
			end if 			
		Next
	Next	
End Function 

'changeTextAttr(nStartOffset, nLen, nColorIdx, nFontSize, isBold)
Function SetContainerContent()
	Dim nLen, nStartOffset
	
	if g_szContainer == "Container20" then  '1. 이자 및 상환 방식
		nStartOffset = 0
		nLen = Container20.lblInfo2.getLen(Container20.lblInfo0.caption)	
		Container20.lblInfo0.changeTextAttr(nStartOffset, nLen, 10, -1, true) 		

		nStartOffset = Container20.lblInfo2.getLen("일자계산은 ")
		nLen = Container20.lblInfo2.getLen("한편넣기")
		Container20.lblInfo2.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		nStartOffset = 0
		nLen = Container20.lblInfo2.getLen("이자 미납 시 연체이자 부과")	
		Container20.lblInfo5.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		nStartOffset = 0
		nLen = Container20.lblInfo7.getLen(Container20.lblInfo7.caption)			
		Container20.lblInfo7.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
	elseif g_szContainer == "Container21" then '2. 담보 관련
		'-
		nStartOffset = 0
		nLen = Container21.lblInfo0.getLen("주식")	
		Container21.lblInfo0.changeTextAttr(nStartOffset, nLen, 11, -2, false)	
		
		'-
		nStartOffset = 0
		nLen = Container21.lblInfo1.getLen("집합투자증권")	
		Container21.lblInfo1.changeTextAttr(nStartOffset, nLen, 11, -2, false)	
		
		'-
		nStartOffset = 0
		nLen = Container21.lblInfo2.getLen("채권")	
		Container21.lblInfo2.changeTextAttr(nStartOffset, nLen, 11, -2, false)	
		
		'-
		nStartOffset = 0
		nLen = Container21.lblInfo3.getLen("ELS")	
		Container21.lblInfo3.changeTextAttr(nStartOffset, nLen, 11, -2, false)
		
		'-
		nStartOffset = 0
		nLen = Container21.lblInfo4.getLen("매도자금")	
		Container21.lblInfo4.changeTextAttr(nStartOffset, nLen, 11, -2, false)
		
		'-
		nStartOffset = 0
		nLen = Container21.lblInfo5.getLen("환매자금")	
		Container21.lblInfo5.changeTextAttr(nStartOffset, nLen, 11, -2, false)	
	
		nStartOffset = 110
		nLen = Container21.lblInfo9.getLen("담보유지비율에 미달하는 경우 추가납부 요구")	
		Container21.lblInfo9.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		nStartOffset = 6
		nLen = Container21.lblInfo10.getLen("최근일 종가")	
		Container21.lblInfo10.changeTextAttr(nStartOffset, nLen, 10, -2, false)	
		
		nStartOffset = 27
		nLen = Container21.lblInfo11.getLen("계좌의 담보유지비율은 가중평균하여 계산")	
		Container21.lblInfo11.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		nStartOffset = 30
		nLen = Container21.lblInfo12.getLen("‘계좌 담보유지비율’로 산정")	
		Container21.lblInfo12.changeTextAttr(nStartOffset, nLen, 10, -2, false)	
		
		nStartOffset = 9
		nLen = Container21.lblInfo13.getLen("120% 미만")	
		Container21.lblInfo13.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		nStartOffset = 21
		nLen = Container21.lblInfo13.getLen("익영업일")	
		Container21.lblInfo13.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		nStartOffset = 35
		nLen = Container21.lblInfo13.getLen("반대매매 시행")	
		Container21.lblInfo13.changeTextAttr(nStartOffset, nLen, 10, -2, false)			
		
		Container21.SetScrollAutoSize()
	
	elseif g_szContainer == "Container22" then '3. 소비자 부담금액	
	
		nStartOffset = 15
		nLen = Container22.lblInfo0.getLen("별도 수수료없음")	
		Container22.lblInfo0.changeTextAttr(nStartOffset, nLen, 10, -2, false)		
	
		nStartOffset = 45
		nLen = Container22.lblInfo1.getLen("투자자와 회사가 50%씩 부담")	
		Container22.lblInfo1.changeTextAttr(nStartOffset, nLen, 10, -2, false)	
		
	elseif g_szContainer == "Container23" then '4. 투자위험 및 불이익
	
		nStartOffset = 9
		nLen = Container23.lblInfo0.getLen("담보유지비율 하회 시 투자자 의사와 상관없는 임의처분(반대매매)에 따른 손실 위험")	
		Container23.lblInfo0.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		nStartOffset = 56
		nLen = Container23.lblInfo0.getLen("대출금 이상의 손실")	
		Container23.lblInfo0.changeTextAttr(nStartOffset, nLen, 10, -2, false)		
		
		nStartOffset = 0
		nLen = Container23.lblInfo1.getLen("만기 미상환 시 담보증권이 임의처분")	
		Container23.lblInfo1.changeTextAttr(nStartOffset, nLen, 10, -2, false)	
		
		nStartOffset = 42
		nLen = Container23.lblInfo1.getLen("이후에도 연체금액이 잔존할 경우 연체이자 납부 및 이에 따른 신용도 하락 등의 불이익이 발생할 수 있음.")	
		Container23.lblInfo1.changeTextAttr(nStartOffset, nLen, 10, -2, false)			
	
	elseif g_szContainer == "Container24" then '5. 금융소비자의 권리	
	
		nLen = Container24.lblInfo0.getLen("계약서류를 받은 날로부터 14일(회사와 고객간에 해당 기간보다 긴 기간으로 약정한 경우 그 기간)내에 계약에 대한 쳥약을 철회할 수 있습니다.")	
		'1.안드로이드 2.iOS
		if g_szDeviceOS == "2" then
			nStartOffset = 34
			nLen = nLen + 13
		else
			nStartOffset = 33
			nLen = nLen + 11
		end if			
		Container24.lblInfo0.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		nStartOffset = 0
		nLen = Container24.lblInfo1.getLen("다만, 담보로 제공된 증권이 법에 따라 처분된 경우에는 청약철회가 불가능합니다.")	
		Container24.lblInfo1.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		'1.안드로이드 2.iOS
		if g_szDeviceOS == "2" then
			nStartOffset = 40
		else
			nStartOffset = 39
		end if	
		nLen = Container24.lblInfo2.getLen("회사에 청약 철회의 의사표시")	
		Container24.lblInfo2.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		nStartOffset = 0
		nLen = Container24.lblInfo7.getLen("금융소비자는 위법계약 해지를 요구하기 위해서는 법 위반사실을 안 날로부터 1년 이내의 기간으로 계약체결일로부터 5년 이내에 계약해지요구서에 위반사실을 입증하는 서류를 첨부하여 계약의 해지를 요구하여야 합니다.")	
		Container24.lblInfo7.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		nStartOffset = 0
		nLen = Container24.lblInfo8.getLen("금융소비자는 분쟁조정 또는 소송의 수행 등 권리구제를 위한 목적으로 금융상품판매업자 등이 기록 및 유지·관리하는 다음의 자료에 대한 열람(사본 및 청취 포함)을 요구할 수 있습니다.")	
		Container24.lblInfo8.changeTextAttr(nStartOffset, nLen, 10, -2, false)

		nStartOffset = 0
		nLen = Container24.lblInfo10.getLen("회사는 금융소비자의 분쟁조정 신청내역 또는 소송제기 등의 목적 및 열람의 범위가 기재된 열람요구서로 열람을 요구받은 날로부터 6영업일 이내에 금융소비자가 해당 자료를 열람할 수 있게 합니다.")	
		Container24.lblInfo10.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		Container24.SetScrollAutoSize()
	
	elseif g_szContainer == "Container25" then '6. 기타유의사항
	
		nStartOffset = 10
		nLen = Container25.lblInfo0.getLen("주민등록번호 단위로 등록")	
		Container25.lblInfo0.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		nStartOffset = 52
		nLen = Container25.lblInfo0.getLen("해당 外 종합계좌에서 융자 실행하고자 하는 경우 융자가능계좌를 추가 등록")	
		Container25.lblInfo0.changeTextAttr(nStartOffset, nLen, 10, -2, false)		
		
		nStartOffset = 0
		nLen = Container25.lblInfo2.getLen("SMS(또는 알림톡)로 변경내용을 요약 통보함.")	
		Container25.lblInfo2.changeTextAttr(nStartOffset, nLen, 10, -2, false)		
	
		nStartOffset = 21
		nLen = Container25.lblInfo3.getLen("SMS(또는 알림톡)로 통보")	
		Container25.lblInfo3.changeTextAttr(nStartOffset, nLen, 10, -2, false)	
	
		nStartOffset = 0
		nLen = Container25.lblInfo4.getLen("추가담보요구(담보부족) 시 전화(핸드폰→원장통보지→통보지외전화 순) 및 SMS/이메일(이메일은 선택한 경우에 한함)로 통보하며, 전화/SMS/이메일 모두 통보불가(발송실패) 시 내용증명으로 통보")	
		'1.안드로이드 2.iOS
		if g_szDeviceOS == "2" then
			nLen = nLen + 5
		else
			nLen = nLen + 2
		end if		
		Container25.lblInfo4.changeTextAttr(nStartOffset, nLen, 10, -2, false)
		
		Container25.SetScrollAutoSize()
	
	end if 

End Function


'============================================================================
Sub Form_OnFormInit()
	g_szDeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	Dim tOpenData, tData1
	tOpenData = Form.GetOpenLinkData()
	if tOpenData <> "" then	
		tData1 = Split(tOpenData,"★")	
		if tData1[0] <> nil then
			g_nIndex = tonumber(tData1[0])
		end if 
		if tData1[1] <> nil then
			g_nSubIndex = tonumber(tData1[1])
		end if 
	else
		g_nIndex = -1
		g_nSubIndex = -1	
		exit Sub	
'For TEST
'g_nIndex = 2
'g_nSubIndex = 2
'msgbox g_nIndex  & " *** " & g_nSubIndex		
	end if 

	SetContainerVisible()
	SetContainerContent()
	
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Container20.Top = g_szTop
	Container21.Top = g_szTop
	Container22.Top = g_szTop
	Container23.Top = g_szTop
	Container24.Top = g_szTop
	Container25.Top = g_szTop

	Container20.Height = g_szHeight
	Container21.Height = g_szHeight
	Container22.Height = g_szHeight
	Container23.Height = g_szHeight
	Container24.Height = g_szHeight
	Container25.Height = g_szHeight
End Sub

'============================================================================
Sub Container1_btnCancel_OnClick()
	Form.SendReturnToParent("mbonl82100_p10" , "Close☆"& g_nSubIndex)
	g_szRet	=	"Cancel"
	Form.CloseForm()	
End Sub

'============================================================================
Sub Container1_btnOK_OnClick()
	Form.SendReturnToParent("mbonl82100_p10" , "OK☆"& g_nSubIndex)
	g_szRet	=	"OK"
	Form.CloseForm()	
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

	</SCRIPT_INFO>
</ROOT>