Sub f_CalcContExcept(nIndex)
	Dim sGubun, sPlusMinus
	
	if nIndex > 4 then '매도
		sGubun = "Sel"
		nIndex = nIndex - 5
	else '매수
		sGubun = "Buy"
	end if
	
	sPlusMinus = Form.GetCtlProp("contStep2.contSub.contExcept.cont"..sGubun.."Except"..nIndex..".btn"..sGubun.."Plus"..nIndex, "caption")
	
	if sPlusMinus == "+" then
		Form.SetCtlProp("contStep2.contSub.contExcept.cont"..sGubun.."Except"..nIndex..".btn"..sGubun.."Plus"..nIndex, "caption", "-")
		Form.SetCtlProp("contStep2.contSub.contExcept.cont"..sGubun.."Except"..nIndex+1, "visible", "1")
	elseif sPlusMinus == "-" then
		if nIndex == 4 then
			Form.SetCtlProp("contStep2.contSub.contExcept.cont"..sGubun.."Except"..nIndex..".edt"..sGubun..nIndex, "caption", "")
			Form.SetCtlProp("contStep2.contSub.contExcept.cont"..sGubun.."Except"..nIndex, "visible", "0")
			Form.SetCtlProp("contStep2.contSub.contExcept.cont"..sGubun.."Except"..(nIndex-1)..".btn"..sGubun.."Plus"..(nIndex-1), "caption", "+")
			if sGubun == "Sel" then
				g_tSelExcept(nIndex) = ""
			elseif sGubun == "Buy" then
				g_tBuyExcept(nIndex) = ""
			end if
		else
			Dim nLastIndex
			nLastIndex = 4
			
			for i = 0 to 4
				Dim sFlag
				sFlag = Form.GetCtlProp("contStep2.contSub.contExcept.cont"..sGubun.."Except"..i, "visible")
				if sFlag == "false" then
					nLastIndex = i - 1
					Exit For
				end if
			next
			
			for i = nIndex to nLastIndex
				if sGubun == "Sel" then
					if i == 4 then
						g_tSelExcept(i) = ""
					else
						g_tSelExcept(i) = g_tSelExcept(i + 1)
					end if
					
					Dim sName
					sName = Form.GetItemCodeInfo(g_tSelExcept(i), "name")
					Form.SetCtlProp("contStep2.contSub.contExcept.cont"..sGubun.."Except"..i..".edt"..sGubun..i, "caption", sName)
					
					if i == nLastIndex then
						g_tSelExcept(i) = ""
						Form.SetCtlProp("contStep2.contSub.contExcept.cont"..sGubun.."Except"..i..".edt"..sGubun..i, "caption", "")
						Form.SetCtlProp("contStep2.contSub.contExcept.cont"..sGubun.."Except"..i, "visible", "0")
					elseif i == nLastIndex-1 then
						Form.SetCtlProp("contStep2.contSub.contExcept.cont"..sGubun.."Except"..i..".btn"..sGubun.."Plus"..i, "caption", "+")
					end if
				elseif sGubun == "Buy" then
					if i == 4 then
						g_tBuyExcept(i) = ""
					else
						g_tBuyExcept(i) = g_tBuyExcept(i + 1)
					end if
					
					Dim sName
					sName = Form.GetItemCodeInfo(g_tBuyExcept(i), "name")
					Form.SetCtlProp("contStep2.contSub.contExcept.cont"..sGubun.."Except"..i..".edt"..sGubun..i, "caption", sName)
					
					if i == nLastIndex then
						g_tBuyExcept(i) = ""
						Form.SetCtlProp("contStep2.contSub.contExcept.cont"..sGubun.."Except"..i..".edt"..sGubun..i, "caption", "")
						Form.SetCtlProp("contStep2.contSub.contExcept.cont"..sGubun.."Except"..i, "visible", "0")
					elseif i == nLastIndex-1 then
						Form.SetCtlProp("contStep2.contSub.contExcept.cont"..sGubun.."Except"..i..".btn"..sGubun.."Plus"..i, "caption", "+")
					end if
				end if
			next
		end if
	end if
	
	Dim nTop
	nTop = 15
	
	for i = 0 to 4
		Dim sFlag
		sFlag = Form.GetCtlProp("contStep2.contSub.contExcept.contBuyExcept"..i, "visible")
		
		if sFlag == "true" or sFlag == "1" then
			Form.SetCtlProp("contStep2.contSub.contExcept.contBuyExcept"..i, "top", nTop)
			nTop = nTop + 30 + 5
		end if
	next
	
	Form.SetCtlProp("contStep2.contSub.contExcept.lblSelExcept", "top", nTop)
	nTop = nTop + 15
	
	for i = 0 to 4
		Dim sFlag
		sFlag = Form.GetCtlProp("contStep2.contSub.contExcept.contSelExcept"..i, "visible")
		
		if sFlag == "true" or sFlag == "1" then
			Form.SetCtlProp("contStep2.contSub.contExcept.contSelExcept"..i, "top", nTop)
			nTop = nTop + 30 + 5
		end if
	next
	
	nTop = nTop - 5
	g_nContExceptHeight = nTop
	contStep2.contSub.contExcept.height = g_nContExceptHeight
		
	f_PosContExceptUnder()
End Sub

'============================================================================
Sub btnNext_OnClick()
	if g_sProductYN == null or g_sProductYN == "" then
		Form.MsgBox("알림", "운용상품을 확인해주세요.", "", 8, "확인", "")
	else
		if contStep2.Button4.switchindex = "1" then
			if contStep2.Edit0.caption == "" or contStep2.Edit0.caption == "0" then
				Form.MsgBox("알림", "목표수익률을 입력해주세요.", "", 8, "확인", "")
				exit sub
			elseif contStep2.Edit1.caption == "" or contStep2.Edit1.caption == "0" then
				Form.MsgBox("알림", "손절수익률을 입력해주세요.", "", 8, "확인", "")
				exit sub
			end if
		end if
		
		if g_bSelect3 then
			if contStep2.contSub.chkContent0.checkstate == "0" and contStep2.contSub.chkContent1.checkstate == "0" then
				Form.MsgBox("알림", "통지서비스를 선택해 주세요.", "", 8, "확인", "")
				exit sub
			end if
		end if
		
		DATAMANAGER.RequestTranData( "obwat_onln_002a" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obwat_csad_003r" then
		DATAMANAGER.SetDataValue( 0, "obwat_csad_003r", "InBlock1", "WA_PRCD" , 0 , g_szWA_PRCD )
		DATAMANAGER.SetDataValue( 0, "obwat_csad_003r", "InBlock1", "PROS_CLS_CODE" , 0 , "2" )
		
	elseif szTranID == "obwat_onln_002a" then
		Dim sData2
		
		sData2 = g_sProductYN.."|"
		sData2 = sData2..(contStep2.Button0.switchindex = "1" and "Y" or "N").."|"
		sData2 = sData2..(contStep2.Button1.switchindex = "1" and "Y" or "N").."|"
		sData2 = sData2..(contStep2.Button1.switchindex = "1" and contStep2.Combo0.cbkeydata or "").."|"
		sData2 = sData2..(contStep2.Button2.switchindex = "1" and "Y" or "N").."|"
		sData2 = sData2..(contStep2.Button3.switchindex = "1" and "Y" or "N").."|"
		sData2 = sData2..(contStep2.Button4.switchindex = "1" and "Y" or "N").."|"
		sData2 = sData2..(contStep2.Button4.switchindex = "1" and contStep2.Edit0.caption or "").."|"
		sData2 = sData2..(contStep2.Button4.switchindex = "1" and contStep2.Edit1.caption or "").."|"
		
		if g_bSelect1 then
			for i = 0 to 4
				sData2 = sData2..f_ChangeItemCode(g_tBuyExcept(i)).."|"
			next
			
			for i = 0 to 4
				sData2 = sData2..f_ChangeItemCode(g_tSelExcept(i)).."|"
			next
		else
			sData2 = sData2.."||||||||||"
		end if
		
		if g_bSelect2 then
			sData2 = sData2..contStep2.contSub.edtNeeds.caption.."|"
		else
			sData2 = sData2.."|"
		end if
		
		if g_bSelect3 then
			sData2 = sData2..(contStep2.contSub.chkContent0.checkstate = "1" and "Y" or "N").."|"
			sData2 = sData2..(contStep2.contSub.chkContent1.checkstate = "1" and "Y" or "N")
		else
			sData2 = sData2.."|"
		end if
		
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "SVC_DTL_CNTT2" , 0 , sData2 )
		
	end if
End Sub

'============================================================================
Function f_ChangeItemCode(sItemCode)
	if sItemCode == "" then
		return sItemCode
	else
		Dim szMk
		szMk = Form.GetItemCodeInfo(sItemCode, "market")
		
		if Left(sItemCode, 1) == "J" or Left(sItemCode, 1) == "F" then
			return sItemCode
		elseif szMk == "J" or szMk == "T" then '주식
			return "A" & sItemCode
		elseif szMk == "W" then 'ELW
			return "J" & sItemCode
		else
			return sItemCode
		end if
	end if
End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_onln_001r" then
		Dim sDate, sSrno, sAcnt, sAcntSub, sCode, sData1
		
		sDate = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "NMET_APLT_DATE" , 0 )
		sSrno = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "NMET_APLT_SRNO" , 0 )
		sAcnt = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "ACNO" , 0 )
		sAcntSub = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "ASNO" , 0 )
		sCode = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "ISCD" , 0 )
		sData1 = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "SVC_DTL_CNTT1" , 0 )
		
		DATAMANAGER.SetEventFlag( "obwat_onln_002a", "U" )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "NMET_APLT_DATE" , 0 , sDate )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "NMET_APLT_SRNO" , 0 , sSrno )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "PRGS_STAT_CODE" , 0 , "02" )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "BSWR_CLCD" , 0 , "01" )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "ACNO" , 0 , sAcnt )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "ASNO" , 0 , sAcntSub )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "ISCD" , 0 , sCode )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "SVC_DTL_CNTT1" , 0 , sData1 )
		
		g_szWA_PRCD = sCode
		
		DATAMANAGER.RequestTranData( "obwat_csad_003r" )
		
	elseif szTranID == "obwat_csad_003r" then
		
		g_sMgriCode = DATAMANAGER.GetDataValue( 0, "obwat_csad_003r", "OutBlock1", "MGRI_MNBD_CLS_CODE" , 0 )
		g_zDrvtCnt = DATAMANAGER.GetDataValue( 0, "obwat_csad_003r", "OutBlock2", "WA_VLTN_AMT" , 0 )
		
		DATAMANAGER.SetDataValue( 0 , "obwat_pdad_065r", "InBlock1", "WA_PRCD" , 0 , g_szWA_PRCD)
		DATAMANAGER.RequestTranData("obwat_pdad_065r")
		
	elseif szTranID == "obwat_pdad_065r" then
		sCLRN_INDC_YN = DATAMANAGER.GetDataValue(0, "obwat_pdad_065r", "OutBlock1", "CLRN_INDC_YN" , 0)	'선물옵션매수/청산만 허용
		sOPTN_TR_ABLE_YN = DATAMANAGER.GetDataValue(0, "obwat_pdad_065r", "OutBlock1", "OPTN_TR_ABLE_YN" , 0) '모든선물옵션
		g_sWA_OTCM_PAY_YN = DATAMANAGER.GetDataValue(0, "obwat_pdad_065r", "OutBlock1", "WA_OTCM_PAY_YN" , 0) '성과보수
		g_sMGRI_MNBD_CLS_CODE = DATAMANAGER.GetDataValue(0, "obwat_pdad_065r", "OutBlock1", "MGRI_MNBD_CLS_CODE" , 0) '운용주체구분코드
		g_sLoanAbleYN = DATAMANAGER.GetDataValue(0, "obwat_pdad_065r", "OutBlock1", "LOAN_ABLE_YN" , 0) '대출가능여부
		g_sGrpCode = DATAMANAGER.GetDataValue(0, "obwat_pdad_065r", "OutBlock1", "DIV_GRP_CODE" , 0) '분류그룹코드
		g_sProdRiskClcd = DATAMANAGER.GetDataValue(0, "obwat_pdad_065r", "OutBlock1", "WA_PROD_RISK_CLCD" , 0) '상품위험등급코드
		
		Dim sLoanYN, sMgriCode
		
		if g_sMgriCode == "2" then '지점형 상품.
			g_sLoanYN = "Y"
			g_sMgriYN = "Y"
		else
			g_sLoanYN = "N"
			g_sMgriYN = "N"
		end if
		
		' 모든상품에 대해서 신용설정 불가 (이후에 변경 예정)
		g_sLoanYN = "N"
		
		if g_sLoanYN == "N" then '지점운용형 상품만 신용 사용 보이므로 N이면 안보이게함.
			Dim nTop
			nTop = 174
			contStep2.lblPrdCD15.top = nTop
			contStep2.Button2.top = nTop
			contStep2.imgToolTip0.top = nTop +5
			nTop = nTop + 28 + 5
			contStep2.lblPrdCD16.top = nTop
			contStep2.Button3.top = nTop
			contStep2.imgToolTip1.top = nTop +5
			nTop = nTop + 28 + 5
			contStep2.lblPrdCD17.top = nTop
			contStep2.Button4.top = nTop
			contStep2.imgToolTip2.top = nTop +6
			
			contStep2.Image2.height = 180 - (28 + 5)
			
			contStep2.contSub.top = 306
		end if
		
		f_SetSwitch()
		
		'1등급 상품인 경우만 투자유의 종목 설정 가능
		if g_sProdRiskClcd = "01" then
			contStep2.Button0.switchindex = 1
		else
			contStep2.Button0.switchindex = 0
			contStep2.Button0.enable = false
		end if
		
		'스위치 설정을 먼저한 후에 visible 처리해야함. (미리하면 안드로이드에서 오류)
		if g_sLoanYN == "N" then '지점운용형 상품만 신용 사용 보이므로 N이면 안보이게함.
			contStep2.lblPrdCD14.visible = false
			contStep2.Button1.visible = false
		else
			if g_sGrpCode == "A" or g_sGrpCode == "D" or g_sGrpCode == "G" then	'성장지향형 상품
				contStep2.Button1.enable = false
			else
				if g_sLoanAbleYN == "N" then	'신용불가
					contStep2.Button1.enable = false
				end if
			end if			
			
		end if
		
		'파생형인경우
		if Cint(g_zDrvtCnt) > 0 then
			g_sDrvtYN = "Y"
		else
			g_sDrvtYN = "N"
		end if
		
		'목표/손절수익율 ON 고정
		if g_sGrpCode == "D" or g_sGrpCode == "E" or g_sGrpCode == "F" then	'성과보수형 상품
			contStep2.Button4.switchindex = 1
			contStep2.Button4.enable = false
			f_ClickButton4()
		elseif g_sGrpCode == "I" and Cint(g_zDrvtCnt) > 0 then '맞춤형 / 고난도 / 파생형
			contStep2.Button4.switchindex = 1
			contStep2.Button4.enable = false
			f_ClickButton4()
		end if
		
'		if sCLRN_INDC_YN == "Y" or sOPTN_TR_ABLE_YN == "Y" or (g_sMGRI_MNBD_CLS_CODE == "2" and g_sWA_OTCM_PAY_YN == "Y") then
'			contStep2.Button4.switchindex = 1
'			contStep2.Button4.enable = false
'			f_ClickButton4()
'		end if
		
	elseif szTranID == "obwat_onln_002a" then
		Form.triggerEvent("#", "NEXT", "")
		
	end if
End Sub

Sub f_SetSwitch()
	contStep2.Button0.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	contStep2.Button1.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	contStep2.Button2.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	contStep2.Button3.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	contStep2.Button4.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	
	contStep2.Button0.switchindex = 0
	
	contStep2.Button1.switchindex = 0
	contStep2.Button2.switchindex = 0
	contStep2.Button2.enable = false
	
	contStep2.Button3.switchindex = 1
	contStep2.Button4.switchindex = 0
End Sub

'============================================================================
Sub contStep2_Edit0_OnEditComplete()
	if contStep2.Edit0.caption <> "" then
		if tonumber(contStep2.Edit0.caption) == 0 then
			Form.MsgBox("알림", "0%는 입력이 불가합니다.\n다시 입력해주세요.", "", 8, "확인", "")
			contStep2.Edit0.caption = ""
		end if
	end if
End Sub

'============================================================================
Sub contStep2_Edit1_OnEditComplete()
	if contStep2.Edit1.caption <> "" then
		if tonumber(contStep2.Edit1.caption) == 0 then
			Form.MsgBox("알림", "0%는 입력이 불가합니다.\n다시 입력해주세요.", "", 8, "확인", "")
			contStep2.Edit1.caption = ""
		end if
	end if
End Sub

'============================================================================
Sub contStep2_imgToolTip0_OnClick()
	Dim sText
	sText = "관리종목이란?\n증권거래소가 유가증권 상장 규정에 의거 상장폐지 기준에 해당되는 종목 가운데 특별히 지정한 종목으로, 관리종목은 랩 운용종목에서 제외됩니다."
	contStep2.imgToolTip0.openToolTip( sText, 320, 110, 1 )
End Sub

'============================================================================
Sub contStep2_imgToolTip1_OnClick()
	Dim sText
	sText = "고객님의 회사 및 이해관계인이 발행한 증권에 운용 허용 여부를 선택해주세요."
	contStep2.imgToolTip1.openToolTip( sText, 280, 60, 1 )
End Sub

'============================================================================
Sub contStep2_imgToolTip2_OnClick()
	Dim sText
	sText = "지정하신 수익률 도달시\nSMS로 통보해 드려요."
	contStep2.imgToolTip2.openToolTip( sText, 180, 60, 1 )
End Sub

