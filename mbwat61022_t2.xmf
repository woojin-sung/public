	<SCRIPT_INFO _len="34090" _ulen="32736" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 운용대상자산 조회
' 02. 화면설명 : 
' 03. 이    력 : 2022.10.19 : 고승연 : v0001 : 
'                2022.10.25 : 고승연 : v0002 : 운용대상자산 BS 호출시 파생여부 추가
'                2023.11.10 : 고승연 : v0003 : 상품위험등급 구분 변경, obwat_pdad_065r IO 수정
'                2024.03.26 : 고승연 : v0004 : [T2402290007] obwat_pdad_065r IO 수정
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szWA_PRCD	'랩상품코드
Dim g_sMgriYN		'운용주체
Dim g_sDrvtYN		'파생여부
Dim g_tData

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Dim g_szWA_PRCD	'랩상품코드
Dim g_sLoanYN		'대출여부
Dim g_sMgriYN		'운용주체
Dim g_sDrvtYN		'파생여부
Dim g_sMgriCode
Dim g_sGrpCode	'그룹코드
Dim g_sLoanAbleYN
Dim g_zDrvtCnt	'파생건수
Dim g_bInitSelect
Dim g_bSelect1
Dim g_bSelect2
Dim g_bSelect3
Dim g_sProductYN
Dim g_nContExceptHeight
Dim g_nIdxExcept
Dim g_tBuyExcept
Dim g_tSelExcept
Dim g_sWA_OTCM_PAY_YN
Dim g_sMGRI_MNBD_CLS_CODE

'============================================================================
Sub Form_OnFormInitBefore()
	ImageStep0.setMaintainingRatio("1")
	contStep2.imgConfirm.setMaintainingRatio("1")
	contStep2.contSub.imgCheck1.setMaintainingRatio("1")
	contStep2.contSub.imgCheck2.setMaintainingRatio("1")
	contStep2.contSub.imgCheck3.setMaintainingRatio("1")
	contStep2.contSub.contExcept.contBuyExcept0.imgBuyIcon0.setMaintainingRatio("1")
	contStep2.contSub.contExcept.contBuyExcept1.imgBuyIcon1.setMaintainingRatio("1")
	contStep2.contSub.contExcept.contBuyExcept2.imgBuyIcon2.setMaintainingRatio("1")
	contStep2.contSub.contExcept.contBuyExcept3.imgBuyIcon3.setMaintainingRatio("1")
	contStep2.contSub.contExcept.contBuyExcept4.imgBuyIcon4.setMaintainingRatio("1")
	contStep2.contSub.contExcept.contSelExcept0.imgSelIcon0.setMaintainingRatio("1")
	contStep2.contSub.contExcept.contSelExcept1.imgSelIcon1.setMaintainingRatio("1")
	contStep2.contSub.contExcept.contSelExcept2.imgSelIcon2.setMaintainingRatio("1")
	contStep2.contSub.contExcept.contSelExcept3.imgSelIcon3.setMaintainingRatio("1")
	contStep2.contSub.contExcept.contSelExcept4.imgSelIcon4.setMaintainingRatio("1")
	contStep2.imgToolTip0.setMaintainingRatio("1")
	contStep2.imgToolTip1.setMaintainingRatio("1")
	contStep2.imgToolTip2.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	contStep2.Label1.caption = contStep2.Combo0.caption
	
	' 에디트를 visible처리하면 위에있는 라벨이 밑으로가서 위치이동으로함.
	contStep2.Edit0.left = 400
	contStep2.Label2.left = 400
	contStep2.Edit1.left = 400
	contStep2.Label3.left = 400	
	
	g_bInitSelect = true
	g_bSelect1 = false
	g_bSelect2 = false
	g_bSelect3 = false
	
	g_nContExceptHeight = 95
	g_nIdxExcept = -1
	g_tBuyExcept = Array("", "", "", "", "")
	g_tSelExcept = Array("", "", "", "", "")
	
	contStep2.SetScrollAnimation(true)
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "001rData" then
		if sParam <> "" then
			Dim tData, sCsno
			sCsno = Form.GetSharedData("&CUST_NUM", false)
			tData = Split(sParam, "|")
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1" )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "NMET_APLT_DATE" , 0 , tData(0) )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "NMET_APLT_SRNO" , 0 , tData(1) )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "CSNO" , 0 , sCsno )
			DATAMANAGER.RequestTranData( "obwat_onln_001r" )
		end if
		
	end if
End Sub

'============================================================================
Sub contStep2_lblConfirm_OnClick()
	Dim sData
	sData = g_szWA_PRCD.."|"..g_sMgriYN.."|"..g_sDrvtYN
	
	if g_sProductYN <> null and g_sProductYN <> "" then
		sData = sData.."|"..g_sProductYN
	end if
	
	Form.OpenPopup("mbwat61022_p3" , sData , "")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "CONFIRM" then
		g_sProductYN = sRet
		contStep2.Image5.imgpath = "btn_15_n.9.png"
		contStep2.lblConfirm.fgcolor = "062:255255255"
		
		if g_sWA_OTCM_PAY_YN <> "Y" then
			Dim tData
			tData = Split(g_sProductYN, "|")
			
			if tData(7) == "Y" or tData(8) == "Y" then
				contStep2.Button4.enable = false
				
				if contStep2.Button4.switchindex == "0" then
					contStep2.Button4.switchindex = 1
					f_ClickButton4()
				end if
			else
				contStep2.Button4.enable = true
			end if
		end if
	end if
End Sub

' 신용사용 on/off
'============================================================================
Sub contStep2_Button1_OnClick()
	Dim nTop
	
	if contStep2.Button1.switchindex == "0" then
		contStep2.Combo0.visible = false
		contStep2.Label1.visible = false
		contStep2.Label0.visible = false
		nTop = 207
	elseif contStep2.Button1.switchindex == "1" then
		contStep2.Combo0.visible = true
		contStep2.Label1.visible = true
		contStep2.Label0.visible = true
		nTop = 240
	end if
	
	contStep2.lblPrdCD15.top = nTop
	contStep2.Button2.top = nTop
	contStep2.imgToolTip0.top = nTop
	nTop = nTop + 28 + 5
	contStep2.lblPrdCD16.top = nTop
	contStep2.Button3.top = nTop
	contStep2.imgToolTip1.top = nTop
	nTop = nTop + 28 + 5
	contStep2.lblPrdCD17.top = nTop
	contStep2.Button4.top = nTop
	contStep2.imgToolTip2.top = nTop
	nTop = nTop + 28 + 5
	contStep2.Edit0.top = nTop
	contStep2.Label2.top = nTop
	contStep2.Edit1.top = nTop
	contStep2.Label3.top = nTop
	
	if contStep2.Button4.switchindex == "0" then
		nTop = nTop + 5
	elseif contStep2.Button4.switchindex == "1" then
		nTop = nTop + (50)
	end if
	
	contStep2.Image2.height = nTop - 131
	
	contStep2.contSub.top = nTop + 28
	
	if g_bInitSelect == true then
		if 131 + contStep2.Image2.height + 28 + 133 > 502 then
			contStep2.contSub.height = 133
			contStep2.SetScrollAutoSize()
		else
			contStep2.contSub.height = 502 - contStep2.Image2.height - 159
		end if
	else
		contStep2.SetScrollAutoSize()
	end if
End Sub

' 신용 사용한도
'============================================================================
