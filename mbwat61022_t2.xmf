' 목표/손절수익률 설정 on/off
'============================================================================
Sub contStep2_Button4_OnClick()
	f_ClickButton4()
End Sub

Sub f_ClickButton4()
	Dim nBgHeight
	
	if contStep2.Button4.switchindex == "0" then
		' 에디트를 visible처리하면 위에있는 라벨이 밑으로가서 위치이동으로함.
		contStep2.Edit0.left = 400
		contStep2.Label2.left = 400
		contStep2.Edit1.left = 400
		contStep2.Label3.left = 400	
		
		if contStep2.Button1.visible = true or contStep2.Button1.visible == "1" then
			if contStep2.Button1.switchindex == "0" then
				nBgHeight = 180
			elseif contStep2.Button1.switchindex == "1" then
				nBgHeight = 180 + 28 + 5
			end if
		else
			nBgHeight = 180 - (28 + 5)
		end if
		
		contStep2.Image2.height = nBgHeight
'		
	elseif contStep2.Button4.switchindex == "1" then
		' 에디트를 visible처리하면 위에있는 라벨이 밑으로가서 위치이동으로함.
		contStep2.Edit0.left = 22
		contStep2.Label2.left = 22
		contStep2.Edit1.left = 193
		contStep2.Label3.left = 193
		
		Dim nTop
		
		if contStep2.Button1.visible = true or contStep2.Button1.visible == "1" then
			if contStep2.Button1.switchindex == "0" then
				nTop = 306
			elseif contStep2.Button1.switchindex == "1" then
				nTop = 306 + 28 + 5
			end if
		else
			nTop = 306 - (28 + 5)
		end if
		
		contStep2.Edit0.top = nTop
		contStep2.Label2.top = nTop
		contStep2.Edit1.top = nTop
		contStep2.Label3.top = nTop
		
		nBgHeight = nTop - 131 + 40 + 10
		
		contStep2.Image2.height = nBgHeight
		
	end if
	
	contStep2.contSub.top = 131 + nBgHeight + 28
	
	if g_bInitSelect == true then
		if 131 + contStep2.Image2.height + 28 + 133 > 502 then
			contStep2.contSub.height = 133
			contStep2.SetScrollAutoSize()
		else
			contStep2.contSub.height = 502 - contStep2.Image2.height - 159
		end if
	else
		contStep2.SetScrollAutoSize()
	end if
End Sub

'============================================================================
Sub contStep2_contSub_imgCheck1_OnClick()
	OnClickSub1()
End Sub

Sub contStep2_contSub_lblPrdCD19_OnClick()
	OnClickSub1()
End Sub

Sub OnClickSub1()
	g_bSelect1 = not(g_bSelect1)
	
	if g_bSelect1 == true then
		contStep2.contSub.imgCheck1.imgpath = "check_circle_on.png"
		f_SubAutoSize()
		contStep2.scroll_pos = PosContSub()
		
	else
		contStep2.contSub.imgCheck1.imgpath = "check_circle_off.png"
		
	end if
	
	f_ShowContExcept()
End Sub

Sub contStep2_contSub_imgCheck2_OnClick()
	OnClickSub2()
End Sub

Sub contStep2_contSub_lblPrdCD110_OnClick()
	OnClickSub2()
End Sub

Sub f_ShowContExcept(bShow)
	if g_bSelect1 == false then
		for i = 0 to 4
			Form.SetCtlProp("contStep2.contSub.contExcept.contBuyExcept"..i..".edtBuy"..i, "caption", "")
			Form.SetCtlProp("contStep2.contSub.contExcept.contSelExcept"..i..".edtSel"..i, "caption", "")
			
			if i > 0 then
				Form.SetCtlProp("contStep2.contSub.contExcept.contBuyExcept"..i, "visible", "0")
				Form.SetCtlProp("contStep2.contSub.contExcept.contSelExcept"..i, "visible", "0")
			end if
			
			if i < 4 then
				Form.SetCtlProp("contStep2.contSub.contExcept.contBuyExcept"..i..".btnBuyPlus"..i, "caption", "+")
				Form.SetCtlProp("contStep2.contSub.contExcept.contSelExcept"..i..".btnSelPlus"..i, "caption", "+")
			end if
		next
		
		contStep2.contSub.contExcept.lblSelExcept.top = 50
		contStep2.contSub.contExcept.contSelExcept0.top = 65
		g_nContExceptHeight = 95
		contStep2.contSub.contExcept.height = g_nContExceptHeight
	end if
	
	contStep2.contSub.contExcept.visible = g_bSelect1
	f_PosContExceptUnder()
End Sub

Sub f_PosContExceptUnder()
	Dim nTop
	nTop = 66
	
	if g_bSelect1 then
		nTop = nTop + g_nContExceptHeight + 5
	end if
	
	contStep2.contSub.imgCheck2.top = nTop
	contStep2.contSub.lblPrdCD110.top = nTop - 1
	contStep2.contSub.edtNeeds.top = nTop + 22
	
	nTop = nTop + 32
	
	if g_bSelect2 then
		nTop = nTop + 37
	end if
	
	contStep2.contSub.imgCheck3.top = nTop
	contStep2.contSub.lblPrdCD111.top = nTop - 1
	contStep2.contSub.chkContent0.top = nTop + 22
	contStep2.contSub.chkContent1.top = nTop + 47
	
	Dim nHeight
	
	if g_bSelect3 then
		nHeight = nTop + 87
	else
		nHeight = nTop + 40
	end if
	
	if nHeight > 502 then
		contStep2.contSub.height = nHeight
		contStep2.SetScrollAutoSize()
	end if
End Sub

Sub OnClickSub2()
	g_bSelect2 = not(g_bSelect2)
	Dim nTop
	nTop = 66
	
	if g_bSelect1 then
		nTop = nTop + g_nContExceptHeight
	end if
	
	nTop = nTop + 32
	
	if g_bSelect2 == true then
		contStep2.contSub.imgCheck2.imgpath = "check_circle_on.png"
		f_SubAutoSize()
		contStep2.scroll_pos = PosContSub()
		contStep2.contSub.edtNeeds.visible = true
		nTop = nTop + 37
		
	else
		contStep2.contSub.imgCheck2.imgpath = "check_circle_off.png"
		contStep2.contSub.edtNeeds.visible = false
		contStep2.contSub.edtNeeds.caption = ""
		
	end if
	
	contStep2.contSub.imgCheck3.top = nTop
	contStep2.contSub.lblPrdCD111.top = nTop - 1
	contStep2.contSub.chkContent0.top = nTop + 22
	contStep2.contSub.chkContent1.top = nTop + 47
	
	Dim nHeight
	
	if g_bSelect3 then
		nHeight = nTop + 87
	else
		nHeight = nTop + 40
	end if
	
	if nHeight > 502 then
		contStep2.contSub.height = nHeight
		contStep2.SetScrollAutoSize()
	end if
End Sub

Sub contStep2_contSub_imgCheck3_OnClick()
	OnClickSub3()
End Sub

Sub contStep2_contSub_lblPrdCD111_OnClick()
	OnClickSub3()
End Sub

Sub OnClickSub3()
	g_bSelect3 = not(g_bSelect3)
	
	if g_bSelect3 == true then
		contStep2.contSub.imgCheck3.imgpath = "check_circle_on.png"
		f_SubAutoSize()
		contStep2.scroll_pos = PosContSub()
		contStep2.contSub.chkContent0.visible = true
		contStep2.contSub.chkContent1.visible = true
		
	else
		contStep2.contSub.imgCheck3.imgpath = "check_circle_off.png"
		contStep2.contSub.chkContent0.visible = false
		contStep2.contSub.chkContent1.visible = false
		contStep2.contSub.chkContent0.checkstate = false
		contStep2.contSub.chkContent1.checkstate = false
		
	end if
	
	Dim nTop
	nTop = 61
	
	if g_bSelect1 then
		nTop = nTop + g_nContExceptHeight
	end if
	
	nTop = nTop + 32
	
	if g_bSelect2 then
		nTop = nTop + 27
	end if
	
	Dim nHeight
	
	if g_bSelect3 then
		nHeight = nTop + 87
	else
		nHeight = nTop + 40
	end if
	
	if nHeight > 502 then
		contStep2.contSub.height = nHeight
		contStep2.SetScrollAutoSize()
	end if
End Sub

Sub f_SubAutoSize()
	if g_bInitSelect == true then
		g_bInitSelect = false
		contStep2.contSub.height = 502
		contStep2.SetScrollAutoSize()
	end if
End Sub

Function PosContSub()
	Dim nPos
	
	nPos = 339
	
	if contStep2.Button1.visible == false or contStep2.Button1.visible == "0" then
		nPos = nPos - (28 + 5)
	end if
	
	if contStep2.Button1.switchindex == "1" then
		nPos = nPos + 28 + 5
	end if
	
	if contStep2.Button4.switchindex == "1" then
		nPos = nPos + 40 + 5
	end if
	
	PosContSub = nPos
End Function

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName == "SEARCH" then
		Dim bFlag
		bFlag = true
		
		if g_nIdxExcept > 4 then '매도
			if sReturn1 == "" then
				bFlag = false
			else
				for i = 0 to 4
					if g_tSelExcept(i) == sReturn1 then
						bFlag = false
						Form.MsgBox("알림", "이미 선택한 종목입니다.", "", 8, "확인", "")
						exit for
					end if
				next
			end if
			
			if bFlag then
				g_nIdxExcept = g_nIdxExcept - 5
				g_tSelExcept(g_nIdxExcept) = sReturn1
				Dim sName
				sName = Form.GetItemCodeInfo(sReturn1, "name")
				Form.SetCtlProp("contStep2.contSub.contExcept.contSelExcept"..g_nIdxExcept..".edtSel"..g_nIdxExcept, "caption", sName)
			end if
		else '매수
			if sReturn1 == "" then
				bFlag = false
			else
				for i = 0 to 4
					if g_tBuyExcept(i) == sReturn1 then
						bFlag = false
						Form.MsgBox("알림", "이미 선택한 종목입니다.", "", 8, "확인", "")
						exit for
					end if
				next
			end if
			
			if bFlag then
				g_tBuyExcept(g_nIdxExcept) = sReturn1
				Dim sName
				sName = Form.GetItemCodeInfo(sReturn1, "name")
				Form.SetCtlProp("contStep2.contSub.contExcept.contBuyExcept"..g_nIdxExcept..".edtBuy"..g_nIdxExcept, "caption", sName)
			end if
		end if
		
		g_nIdxExcept = -1
	end if
End Sub

