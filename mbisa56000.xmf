'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'조회
Sub RequestData()
	Form.triggerEvent("fmtab0." & fmtab0.currenttabpageid, "RECEIVE", "")
End Sub


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Call acnt0_ChangeAccount()
End Sub

'============================================================================
Sub Form_OnRefresh()
	Call RequestData()	'조회
End Sub

'============================================================================
Sub acnt0_ChangeAccount()
	cmbSeq.clear = 1								'계약번호 초기화
	DATAMANAGER.RequestTranData( "obwat_ctad_011r" )	'계약번호 조회
End Sub

'============================================================================
Sub cmbSeq_OnEditComplete(iIndex)
	Call RequestData()	'조회
End Sub

'============================================================================
Sub btnSearch_OnClick()
	Call RequestData()	'조회
End Sub

'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
'	Select Case nCurrentTab
'		Case 0 		
'			Form.SetTitleCaption( "가입정보" )
'		Case 1		
'			Form.SetTitleCaption( "상품정보" )
'		Case 2 
'			Form.SetTitleCaption( "전환이력" )
'		Case 3		
'			Form.SetTitleCaption( "적립식정보" )
'	End Select
	
	Call RequestData()	'조회
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obwat_ctad_011r" then
		Dim i, nCnt	

		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" )
		
		'2016-06-13 ESKIM : 계약번호 없을시 메세지 팝업 요청(노희범 차장님)
		If nCnt == 0 then
			Form.ShowAlert("알림", "ISA 계약이 존재하지 않습니다.")
		End If
		
		For i = 0 To nCnt - 1
			cmbSeq.cbadddatatext = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WA_CNRC_NO" , i )		'계약번호
		Next

		cmbSeq.SetCurSel( 0 )	
		Call RequestData()	'조회
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
    
    If sEventName == "SCREEN_MENU" Then
        If Trim(sParam) == "CAUTION_CALL" Then
            Form.OpenPopup("mbisa56000_p1.xmf" , "" , "")
        End If
    End If
    
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obwat_ctad_011r" trcode="obwat_ctad_011r" compress="1" encryption="1" inputcheck="1" useattr="0" >
				<TRBLOCK name="InBlock1" >
					<FIELD name="IQRY_CLS_CODE" idx="1" defconst="7" />
				</TRBLOCK>
			</TRAN>
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obwat_ctad_011r" title="랩계약번호조회(콤보)" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="105" _ulen="75" >

