Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData("ohhts_1682_001r")
End Sub

'============================================================================
'grd01_OnClickUp
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	dim szSymbol
	dim szMarket
	dim szName
	
	szSymbol = Grid0.GetCellData("bd_cell3", lRow)
	szMarket = Grid0.GetCellData("bd_cell7", lRow)
	szName = Grid0.GetCellData("bd_cell0", lRow)

	Form.OpenFramePopup("mhidx42040_p1" , szSymbol & "★" &  szMarket & "★" & szName , sPosInfo)
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_1682_001r"	then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0, "N")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 1, "N")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 2, "N")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 3, "N")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 4, "N")
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 5, "FN")	20220126 HSZ S&P500선물 삭제	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 5, "N")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 6, "FN")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 7, "FN")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 8, "N") 
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 0, "DJI@DJI")	'다우 산업
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 1, "NAS@IXIC")	'나스닥 종합
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 2, "SPI@SPX")	'S&P 500
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 3, "DJI@DJC")	'다우 종합
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 4, "NAS@SOX")	'필라델피아 반도체
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 5, "CME@SP")		'S&P 500 선물 20220126 HSZ S&P500선물 삭제
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 5, "NYS@NYA")	'NYSE 종합
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 6, "CME@NQ")		'E-Mini 나스닥100
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 7, "CME@ES")		'E-Mini S&P500
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD" , 8, "ETC@DXY00")	'US Dollar Index

		DATAMANAGER.CancelRealData( "ohhts_ovrs_nmix" )
		DATAMANAGER.CancelRealData( "ohhts_nfut_cntg" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_1682_001r" then
		dim ncnt1682
		dim szRealCode
		dim szOrgTime
			
		ncnt1682 = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		
		for i = 0 to ncnt1682 - 1
			szOrgTime = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_CNCN_DATE", i)
			szRealCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_CNCN_ISCD", i)
			if szOrgTime = "" or szOrgTime = null then '20220228 HSZ 예외처리 추가
				exit Sub
			else
				szOrgTime = mid(szOrgTIme,5,2) .."/".. mid(szOrgTIme,7,2)
			
				Grid0.SetCellData("bd_cell8", i, szOrgTime.."("..gf_GetForeignCycle(szRealCode)..")")
			end if
		next
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	Grid0.SetClear( )
	DATAMANAGER.RequestTranData("ohhts_1682_001r")
End Sub

'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData( "ohhts_ovrs_nmix" )
	DATAMANAGER.CancelRealData( "ohhts_nfut_cntg" )
End Sub

'============================================================================
'해외 지수/종목 주기를 리턴해준다 . ( 종가 또는 지연)
'============================================================================
Function gf_GetForeignCycle(szCode)
	Select Case szCode  
		case "DJI@DJI", "NAS@IXIC", "SPI@SPX", "DJI@DJC", "NYS@NYA", "NAS@SOX" '미국 '20190813 HWG : 미국 필라델피아 반도체 지수 심볼변경
		    return "종가"  
		    
		Case  "CME@ND", "CME@NQ", "CME@ES", "USI@RUT" '미국 "CME@SP" 20220126 HSZ S&P500선물 삭제
		    return "지연"
		    
		Case "HSI@HSCE", "SZS@399107", "SZS@399108", "HSI@HSI", "SHS@000001", "SHS@000002", "SHS@000003" '아시아
		    return "지연"  
		
		Case "NII@NI225" '아시아
		    return "지연"    
		    
		Case "ILI@TA100", "ILI@TA125", "TWS@TI01", "INI@BSE30", "IDI@JKSE", "PHI@COMP", "VNI@VIDX"  '아시아 
		    return "종가"   
		
		Case "NLI@AEX", "PAS@CAC40", "XTR@DAX30", "STX@SX5E", "RUI@RTSI" '유럽
		    return "종가"
		
		Case "TRI@ISE100"	'유럽  			
		    return "지연"
		    
		Case "BRI@BVSP", "CAI@SPTSX", "ETC@DXY00", "MXI@IPC", "NZI@NZ50"	'미주/오세아니아주 
		    return "종가" 
		    
		Case "AUI@AORD" '미주/오세아니아주
		    return "지연"   
			
		Case "USDKRWSMBS", "EURUSDCOMP", "USDJPYCOMP","EURJPYCOMP", "GBPUSDCOMP", "USDCHFCOMP", "USDCADCOMP", "AUDUSDCOMP", "USDHKDCOMP", "USDSGDCOMP","CNYKRWCOMP", "JPYKRWCOMP"  
			return "실시간" 	

		Case "USDCNYCOMP", "USDTWDCOMP", "USDGBPCOMP", "USDBRLCOMP", "USDVNDCOMP", "USDEURCOMP", "GBPKRWCOMP", "EURKRWCOMP", "USDRUBCOMP", "USDQARCOMP", "USDOMRCOMP", "USDMYRCOMP", "USDJODCOMP", "USDKWDCOMP", "USDAEDCOMP", "USDIDRCOMP", "USDEGPCOMP", "USDILSCOMP", "USDARSCOMP", "USDMXNCOMP", "USDNZDCOMP", "USDAUDCOMP", "USDTHBCOMP", "USDSEKCOMP", "USDNOKCOMP", "USDSARCOMP", "USDDKKCOMP", "USDINRCOMP", "USDHUFCOMP", "USDTRYCOMP", "USDPHPCOMP", "BRLKRWCOMP"		 
			return "실시간"
	End Select
End Function

