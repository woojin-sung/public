'	sOpenData = "|선택하신 상품의 계약이|진행되고 있습니다.|계약완료 후 진행해주세요.||진행현황 보러가기|확인"
'	sOpenData = "지점운용형 랩은|'담당 운용역과 사전 협의 후'|가입이 가능합니다.|해당 상품의 가입을 원하신다면|영업점으로 문의해 주세요|고객지원센터|확인"
'	
'	
'	sOpenData = sOpenData.."|"..sTYPE
'	
'	szOpenData = sOpenData
	
	tData = Split(szOpenData, "|")
	
	if UBound(tData) > 3 then
		for i = 0 to 4
			Table0.SetCellString(i, 1, tData(i))
			'Table0.SetCellFgColor('nRowIdx, nColIdx, sColor)
			if Left(tData(i), 1, 1) = "'" then
				Table0.SetCellFgColor(i, 1, 2)
			end if
		next
		btnCancel.caption = tData(5)
		btnOk.caption = tData(6)
		if btnCancel.caption = "" then
			btnCancel.visible = false
			btnOk.visible = false
			btnOkWide.visible = true
		end if
		btnOk.caption = tData(6)
		g_szType = tData(7)
	end if
	
'	Grid0.rowcount = CInt(UBound(g_szContent)) + 1
