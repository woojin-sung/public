Sub Form_OnFormInitBefore()
	ChartEx0.SetChartType("compare")
	ChartEx0.SetMarketCategory("0")
	
	
	' 20190404 HWG START
	' 차트 분,틱 설정값 세팅 오류 수정
	szMin0 = Form.GetEnvData( "chart_min0" )

	if szMin0 = "" or szMin0 = 0 then
		szMin0 = "1"
	end if

	RadioGroup0.SetRadioCaption( 3, szMin0.."분" )
	' 20190404 HWG END'
End Sub

'============================================================================
Sub Form_OnFormInit()
	ChartEx0.SetForeignFuture("1")
	
	g_intItemCnt = Form.GetEnvData( "GLOBAL_comp_itemCnt" )
	tmpItem =  Form.GetEnvData( "GLOBAL_comp_itemList" )
	tmpCheck = Form.GetEnvData("GLOBAL_comp_itmeCheck")
	
	if g_intItemCnt = "" then
		' 현재가 화면에서 조회한 최근 종목 불러 오기
		g_szItemCode = Form.GetSharedData("&ITEM_GLOBAL_FUTOPT", 0)		' 최근조회종목
		
		if g_szItemCode = "" or g_szItemCode = null then 
			g_szItemCode = ""  
		end if
		
		' ITGEN START => 2019.02.11 비교차트에서 저장된 종목이 없고, 최근조회종목도 없는 경우에는 아무런 동작하지 않도록 수정
		If g_szItemCode ~= "" Then
			Form.SetEnvData( 1, "GLOBAL_comp_itemCnt", "1" )
			Form.SetEnvData( 1, "GLOBAL_comp_itemList", g_szItemCode.."^" )
			Form.SetEnvData( 1, "GLOBAL_comp_itmeCheck", "".."^")
			
			g_szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname") 
			outStrName = Form.GetItemCodeInfo( g_szItemCode , "name")
			ChartEx0.SetFutComparedata(g_szItemCode.."^"..g_szItemCode.."^"..outStrName.."^"..g_szExchName)
		End If
		' ITGEN END
	else
		g_arrItem = split(tmpItem , "^")
		arrCheck = split(tmpCheck , "^")
		ChartEx0.SetDataClear("1")

		for i = 0 to g_intItemCnt - 1
			if arrCheck[i] = "1" or arrCheck[i] = "" then
				
				g_szItemCode = g_arrItem[i]
				g_arrCodeItem[i] = g_arrItem[i]
				
				if btnLink.caption = "연결" and f_FindMarket(g_szItemCode) = "F" then
'					szItemCode = Form.GetActiveMonth(g_szItemCode)
					szItemCode = Form.GetItemCodeInfo( g_szItemCode , "commodity" ) & ".1"
					g_szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname") 
					outStrName = Form.GetItemCodeInfo( g_szItemCode , "name")
					ChartEx0.SetFutComparedata(g_szItemCode.."^"..szItemCode.."^"..outStrName.."^"..g_szExchName)
				
				else 
					g_szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname") 
					outStrName = Form.GetItemCodeInfo( g_szItemCode , "name")
					ChartEx0.SetFutComparedata(g_szItemCode.."^"..g_szItemCode.."^"..outStrName.."^"..g_szExchName)
				end if
			end if
	
		next
	end if

	g_chartIndex = 0
	ChartEx0.setRequestCompareData("1")
End Sub

'============================================================================
Function f_FindMarket(szCode)
	Dim szMarketCode
	
	if cint(InStr( szCode , " " )) > 0 then '옵션
		szMarketCode = "O"
	else
		szMarketCode = "F" '선물
	end if
	
	return szMarketCode
End Function

'============================================================================
Function RequestData()
	DATAMANAGER.ClearInputData( false, "ohhts_6509_001r" )
	DATAMANAGER.ClearOutputData( false, "ohhts_6509_001r" )
'	
	if gCurInd = 0 then
		DATAMANAGER.CancelRealData( "ohhts_ovdv_cntf" )
	elseif gCurInd = 1 then
		DATAMANAGER.CancelRealData( "ohhts_ovdv_cntf_1" )
	elseif gCurInd = 2 then
		DATAMANAGER.CancelRealData( "ohhts_ovdv_cntf_2" )
	elseif gCurInd = 3 then
		DATAMANAGER.CancelRealData( "ohhts_ovdv_cntf_3" )
	elseif gCurInd = 4 then
		DATAMANAGER.CancelRealData( "ohhts_ovdv_cntf_4" )
	end if


	Dim szChrtType '주기타입
	Dim szJoogiType 'N
	
	if g_szChrtType = "0" then '틱
		szChrtType = "0"
		sTic = Split(g_szTicType, "틱", -1, 1)
		szJoogiType = sTic[0]
	elseif g_szChrtType = "1" then '분
		szChrtType = "1"
		sMin = Split(g_szMinType, "분", -1, 1)
		szJoogiType = sMin[0]
	else 'D/W/M/Y 일/주/월/년
		if g_szChrtType = "D" then
			szChrtType = "2"
		elseif g_szChrtType = "W" then
			szChrtType = "3"
		elseif g_szChrtType = "M" then
			szChrtType = "4"
		end if
		szJoogiType = "1"
	end if


	if btnLink.caption = "연결" and f_FindMarket(g_szItemCode) = "F" then
		g_szItemCode = Form.GetActiveMonth(g_szItemCode)
		szItemCode = Form.GetItemCodeInfo( g_szItemCode , "commodity" ) & ".1"
		szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname")
	else
		szItemCode = g_szItemCode
		szExchName = g_szExchName
	end if
	
	DATAMANAGER.SetDataValue( false, "ohhts_6509_001r", "InBlock1", "FID_OVDV_QTTN_EXCH_NAME" , 0 , szExchName ) '거래소명
	DATAMANAGER.SetDataValue( false, "ohhts_6509_001r", "InBlock1", "FID_OVDV_ISCD" , 0 , szItemCode ) '종목코드
'	DATAMANAGER.SetDataValue( false, "ohhts_6509_001r", "InBlock1", "FID_DATE" , 0 , Form.GetSharedData("&HOST_DATE", false ) ) '조회날짜
	DATAMANAGER.SetDataValue( false, "ohhts_6509_001r", "InBlock1", "FID_JOB_CLS_CODE" , 0 , szChrtType ) '주기타입 0:틱, 1:분, 2:일, 3:주, 4:월
	DATAMANAGER.SetDataValue( false, "ohhts_6509_001r", "InBlock1", "FID_INPUT_CNT" , 0 , "50" ) '조회개수
	DATAMANAGER.SetDataValue( false, "ohhts_6509_001r", "InBlock1", "FID_INPUT_HOUR_CLS_CODE" , 0 , szJoogiType ) 'N분, N틱 ~~ 
	DATAMANAGER.SetDataValue( false, "ohhts_6509_001r", "InBlock1", "FID_INPUT_PAST_DATA_INCU_YN" , 0 , "0" ) '당일조회여부 1:당일
	DATAMANAGER.SetDataValue( false, "ohhts_6509_001r", "InBlock1", "FID_INPUT_PRC_CLS_CODE" , 0 , "1" ) '가격구분 0:정산가, 1:종가
	
	DATAMANAGER.RequestTranData("ohhts_6509_001r")
end Function

