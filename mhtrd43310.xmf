'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID = "ohhts_6509_001r" then
		Dim disp, dec
		
		disp = Form.GetItemCodeInfo( g_szItemCode, "dispscale" )
		dec = Form.GetItemCodeInfo( g_szItemCode, "dispdecimal" )
		ChartEx0.SetScaleInfo(disp..";"..dec) '차트 스케일 세팅
	end if
	
	if szTranID = "ohhts_6509_001r" then '차트 조회
		if gCurInd = 0 then
			DATAMANAGER.RequestRealData( "ohhts_ovdv_cntf" ) '차트 실시간 조회
		elseif gCurInd = 1 then
			DATAMANAGER.RequestRealData( "ohhts_ovdv_cntf_1" ) '차트 실시간 조회
		elseif gCurInd = 2 then
			DATAMANAGER.RequestRealData( "ohhts_ovdv_cntf_2" ) '차트 실시간 조회
		elseif gCurInd = 3 then
			DATAMANAGER.RequestRealData( "ohhts_ovdv_cntf_3" ) '차트 실시간 조회
		elseif gCurInd = 4 then
			DATAMANAGER.RequestRealData( "ohhts_ovdv_cntf_4" ) '차트 실시간 조회
		end if
	end if
End Sub

'============================================================================
Sub btnLink_OnClick()
	if btnLink.caption = "개별" then
		btnLink.caption = "연결"
	elseif btnLink.caption = "연결" then
		btnLink.caption = "개별"
	end if
	
	SetContinueData()
End Sub

'============================================================================
Function SetContinueData()

	g_intItemCnt = Form.GetEnvData( "GLOBAL_comp_itemCnt" )
	tmpItem =  Form.GetEnvData( "GLOBAL_comp_itemList" )
	tmpCheck = Form.GetEnvData("GLOBAL_comp_itmeCheck")
	
	g_arrItem = split(tmpItem , "^")
	arrCheck = split(tmpCheck , "^")
	
	' ITGEN START => 2019.02.12 (저장된 종목 정보가 없는 경우 스크립트 오류 처리)
	If g_intItemCnt = "" Or g_intItemCnt = null Then
		g_intItemCnt = 0
	End If
	' ITGEN END
	
	for i = 0 to g_intItemCnt - 1
		if arrCheck[i] = "1" or arrCheck[i] = "" then
				
			g_szItemCode = g_arrItem[i]

			
			if btnLink.caption = "연결" and f_FindMarket(g_szItemCode) = "F" then
				szItemCode = Form.GetItemCodeInfo( g_szItemCode , "commodity" ) & ".1"
				g_szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname") 
				outStrName = Form.GetItemCodeInfo( g_szItemCode , "name")
				ChartEx0.SetFutComparedata(g_szItemCode.."^"..szItemCode.."^"..outStrName.."^"..g_szExchName)
			else 
				g_szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname") 
				outStrName = Form.GetItemCodeInfo( g_szItemCode , "name")
				ChartEx0.SetFutComparedata(g_szItemCode.."^"..g_szItemCode.."^"..outStrName.."^"..g_szExchName)
			end if
		end if
	next
	
	ChartEx0.setRequestCompareData("1")

End Function

