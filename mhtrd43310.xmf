'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	if nIndex == 0 then  '일
		g_szChrtType = "D"	
		PeriodSet(g_szChrtType)
	elseif nIndex == 1 then  '주
		g_flagMin = false
		g_szChrtType = "W"
		PeriodSet(g_szChrtType)
	elseif nIndex == 2 then  '월
		g_flagMin = false
		g_szChrtType = "M"
		PeriodSet(g_szChrtType)
	elseif nIndex == 3 then   '분
		g_szChrtType = "1"
		tmpMin = Split(RadioGroup0.GetRadioCaption( nIndex ), "분")
		g_szMinType = tmpMin[0]
		
		if g_flagMin =false then
			g_flagMin = true
			PeriodSet(g_szChrtType)
		else
			Form.OpenPopup( "mhcht13000_p1.xmf" , g_szMinType , "" )
		end if
			
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "Chart_Min" then
		sMin = Split(sRet,"분")
		RadioGroup0.SetRadioCaption( 3, sRet)
		g_szMinType = sMin[0]
		PeriodSet(g_szChrtType)
	elseif sKeyName == "CompOption" then
		
		g_intItemCnt = Form.GetEnvData( "GLOBAL_comp_itemCnt" )
		tmpItem =  Form.GetEnvData( "GLOBAL_comp_itemList" )
		tmpCheck = Form.GetEnvData("GLOBAL_comp_itmeCheck")
		
		if g_intItemCnt = "" then
			Exit Sub		
		end if
		
		g_arrItem = split(tmpItem , "^")
		arrCheck = split(tmpCheck , "^")

		ChartEx0.SetDataClear("1")
		
		for i = 0 to g_intItemCnt - 1
			if arrCheck[i] = "1" then
				g_szItemCode = g_arrItem[i]
				g_arrCodeItem[i] = g_arrItem[i]

				
				if btnLink.caption = "연결" and f_FindMarket(g_szItemCode) = "F" then
'					szItemCode = Form.GetActiveMonth(g_szItemCode)
					szItemCode = Form.GetItemCodeInfo( g_szItemCode , "commodity" ) & ".1"
					g_szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname") 
					outStrName = Form.GetItemCodeInfo( g_szItemCode , "name")
					ChartEx0.SetFutComparedata(g_szItemCode.."^"..szItemCode.."^"..outStrName.."^"..g_szExchName)
				else
					g_szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname") 
					outStrName = Form.GetItemCodeInfo( g_szItemCode , "name")
	'				ChartEx0.SetCurCodeName(g_szExchName..";"..g_szItemCode..";"..outStrName)
					ChartEx0.SetFutComparedata(g_szItemCode.."^"..g_szItemCode.."^"..outStrName.."^"..g_szExchName)
				end if
'			else
'				g_szItemCode = ""
'				g_szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname") 
'				outStrName = Form.GetItemCodeInfo( g_szItemCode , "name")
'				ChartEx0.SetFutComparedata(g_szItemCode.."^"..g_szItemCode.."^"..outStrName.."^"..g_szExchName)
			end if

		next
		g_chartIndex = 0
		ChartEx0.setRequestCompareData("1")
	end if
End Sub
	
'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================

function ChartEx0_OnGetPeriodInfo()
	Dim sPeriodType
	sPeriodType = ""
	Dim sMin, sTic
   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	for i = 0 to 8
		sMin = Form.GetEnvData( "chart_min"..i )	'분차트
		if sMin <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sMin&"/"
			else
				sPeriodType = sPeriodType&sMin&";"
			end if
		end if
	next
	for i = 0 to 8
		sTic = Form.GetEnvData( "chart_tic"..i )	'분차트
		if sTic <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sTic&"/"
			else
				sPeriodType = sPeriodType&sTic&";"
			end if
		end if
	next
	if sPeriodType <> "" then
		ChartEx0.setSyncPeriodValueToChart(sPeriodType)
	end if
end function


'============================================================================
function ChartEx0_OnChangePeriod(sPeriodType)
	sMinArr = {}
	sTicArr = {}
	sDataArr = {}
	
	g_sIsRequestChartEvent = "1"

   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
   if InStr(sPeriodType, "/") > 0 then
	   sTemp = split(sPeriodType, "/")
	   sMinArr = split(sTemp[0], ";")
	   sTicArr = split(sTemp[1], ";")
	   Form.Log("sPeriodType",sPeriodType)
	   
	   for i = 0 to 7 step 1
		Form.SetEnvData( 1, "chart_min"..i, sMinArr[i] )
		
		Form.SetEnvData( 1, "chart_tic"..i, sTicArr[i] )

	   next
   end if
end function

'============================================================================
function ChartEx0_OnRequestData(nIndex, sData) 
	Data = split(sData, ";")

 
	g_szItemCode	= tostring(Trim(Data[0])) 
	
	g_szExchName	= tostring(Trim(Data[3]))       
	
	if InStr(g_szItemCode , "." ) <> 0 then
		codeTemp = split(g_szItemCode, ".")
		g_szItemCode = codeTemp[0]
		g_szItemCode = Form.GetFirstMonth(g_szItemCode)
		g_szItemCode = Form.GetActiveMonth(g_szItemCode)
	end if
	
	gCurInd = CInt(nIndex)
	
	
	RequestData()
	 
'	g_chartIndex = g_chartIndex+1

end function


'============================================================================
' 차트 설정 개수 변경시
'============================================================================
function ChartEx0_OnByNumber(Count)

   if #Count == 1 then
	   Count = "000"..Count
   elseif #Count == 2 then
	   Count = "00"..Count
   elseif #Count == 3 then
	   Count = "0"..Count
   end if

	g_sChartCnt = Count
	
	RequestData()
end function


'============================================================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'============================================================================
function PeriodSet(sPeriodType)
	if sPeriodType= "0" then
	   g_sPeriod = g_szTicType
	   g_sPeriodType = "0"
	elseif sPeriodType= "1" then
	   g_sPeriod = CInt(g_szMinType)
	   g_sPeriodType = "1"
	elseif sPeriodType= "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod ="1"
	elseif sPeriodType= "W" then 
	   g_sPeriodType = "3"
	    g_sPeriod ="1"
	elseif sPeriodType= "M" then 
	   g_sPeriodType = "4"
	    g_sPeriod ="1"
	elseif sPeriodType= "A" then
		g_sPeriod = CInt(g_szMinType)
		g_sPeriodType = "1"
	end if
	
  sPeriod = CInt( g_sPeriod)
  
   if Len( sPeriod )= 1 then
	   g_sPeriod = "00"..g_sPeriod
	elseif Len( sPeriod )= 2 then
	   g_sPeriod = "0"..g_sPeriod
	end if

   ChartEx0.SetPeriodType(g_sPeriodType)

   ChartEx0.SetPeriodTime(g_sPeriod)
   
   
'   
	' 조회TR 보내기
	g_chartIndex = 0
	ChartEx0.setRequestCompareData("0")
end function


