--===========================================================================
Dim g_szAcno
Dim g_szAsno
Dim g_szSvcdYn	'통합증거금 약정여부
Dim g_szSta_Date
Dim g_szFin_Date
Dim g_NextCnt
Dim g_NextCntCommon
Dim g_isNextData
Dim g_isNextData2

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_NextCnt = 0
	g_NextCntCommon = 0
	g_isNextData = 0
	g_isNextData2 = 0
	'통화/시장명 콤보
	SetCrcdCombo ()
	'시장코드 콤보
	SetCrcdCombo_1 ()
End Sub
'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "SearchBalance" then
		tmp = Split(sParam, "||")
		g_NextCnt = 0		
		g_isNextData = 0
		g_isNextData2 = 0
		
		g_szAcno = tmp(0)
		g_szAsno = tmp(1)
		g_szSvcdYn = tmp(2)		
		
		'통합증거금 약정계좌
		if len(g_szSvcdYn) > 0 and g_szSvcdYn = "01" Then	
		    RadioGroup.visible = True
		    RadioGroup.currentindex = 1
		    RadioGroup_OnClick(1)
		    'Form.ShowAlert("알림", "통합증거금")
		'일반
		Else
			RadioGroup.visible = False
			RadioGroup.currentindex = 0
			RadioGroup_OnClick(0)
			'Form.ShowAlert("알림", "일반")
		End If
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	'해외주식 통합증거금 주문가능금액 조회
	if szTranID = "obtro_acnt_151r" then
		if g_szAcno = Nil Then
			Form.ShowAlert("알림", "계좌번호가 비어있습니다. 확인해주세요")
		elseif len(g_szAcno) < 8 then
			Form.ShowAlert("알림", "계좌번호를 확인해주세요.")
		end if 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 					 , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 					 , 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CRCD" 					 , 0 , CmbCrcd.cbkeydata)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , CmbMrkt.cbkeydata)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IF_INTG_MARG_IQRY_YN" 	 , 0 , "Y")
	end if
	
	'해외주식 일반 주문가능금액 조회
	if szTranID = "obtro_oder_104r" then
		if g_szAcno = Nil Then
			Form.ShowAlert("알림", "계좌번호가 비어있습니다. 확인해주세요")
		elseif len(g_szAcno) < 8 then
			Form.ShowAlert("알림", "계좌번호를 확인해주세요.")
		end if 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 					 , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 					 , 0 , g_szAsno)
	End If
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	'CRCD콤보
	If szTranID = "obtro_comn_401r" Then		
		if g_isNextData = 0 then		
		    CmbCrcd.clear = 1
		    For i = 0 to DATAMANAGER.GetDataCount( 0, "obtro_comn_401r", "OutBlock1" ) - 1
			    ovrs_ctcd_key = DATAMANAGER.GetDataValue(0, "obtro_comn_401r", "OutBlock1", "CRCD" , i )
			    ovrs_ctcd_var = DATAMANAGER.GetDataValue(0, "obtro_comn_401r", "OutBlock1", "OVRS_STCK_MRKT_NAME" , i )
			    ovrs_ctcd = ovrs_ctcd_key.."`"..ovrs_ctcd_var.." "..ovrs_ctcd_key
			    CmbCrcd.cbadddatatext = ovrs_ctcd
		    Next
		end if
		
		if g_isNextData = 1 then
		    For i = 0 to DATAMANAGER.GetDataCount( 0, "obtro_comn_401r", "OutBlock1" )
			    ovrs_ctcd_key = DATAMANAGER.GetDataValue(0, "obtro_comn_401r", "OutBlock1", "CRCD" , i )
			    ovrs_ctcd_var = DATAMANAGER.GetDataValue(0, "obtro_comn_401r", "OutBlock1", "OVRS_STCK_MRKT_NAME" , i )
			    ovrs_ctcd = ovrs_ctcd_key .."`".. ovrs_ctcd_var.." "..ovrs_ctcd_key
			    CmbCrcd.cbadddatatext = ovrs_ctcd
		    Next
		end if
    end if
    
    '시장코드
	If szTranID = "obtro_comn_401r_1" Then		
		if g_isNextData = 0 then		
		    CmbMrkt.clear = 1
		    For i = 0 to DATAMANAGER.GetDataCount( 0, "obtro_comn_401r_1", "OutBlock1" ) - 1
			    ovrs_ctcd_key = DATAMANAGER.GetDataValue(0, "obtro_comn_401r_1", "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , i )
			    ovrs_ctcd_var = DATAMANAGER.GetDataValue(0, "obtro_comn_401r_1", "OutBlock1", "CRCD" , i )
			    ovrs_ctcd = ovrs_ctcd_key.."`"..ovrs_ctcd_var
			    CmbMrkt.cbadddatatext = ovrs_ctcd
		    Next
		end if
		
		if g_isNextData = 1 then
		    For i = 0 to DATAMANAGER.GetDataCount( 0, "obtro_comn_401r_1", "OutBlock1" )
			    ovrs_ctcd_key = DATAMANAGER.GetDataValue(0, "obtro_comn_401r_1", "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , i )
			    ovrs_ctcd_var = DATAMANAGER.GetDataValue(0, "obtro_comn_401r_1", "OutBlock1", "CRCD" , i )
			    ovrs_ctcd = ovrs_ctcd_key .."`".. ovrs_ctcd_var
			    CmbMrkt.cbadddatatext = ovrs_ctcd
		    Next
		end if
    end if
End Sub
'============================================================================
'  DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "obtro_comn_401r" Then
		if DATAMANAGER.IsMoreNextData(szTranID) = True THEN
			g_isNextData = 1
			DATAMANAGER.RequestNextData( szTranID )
		elseif DATAMANAGER.IsMoreNextData(szTranID) = False THEN
			g_isNextData = 0
	    end if 
	    '조회시 미국USD 설정
	    CmbCrcd.SetCurSel( 0 )
	    CmbMrkt.SetCurSel( 0 )
	End If
	
	'해외주식 통합증거금 주문가능금액 조회
	if szTranID = "obtro_acnt_151r" then
		Dim totalSum
		totalSum = 0
		
		for i = g_NextCnt to grd0.rowcount - 1
			crcd   					= grd0.GetCellData("bd_crcd", i)
			frcr_amt					= Cstr(grd0.GetCellData("bd_frcr_camt", i))
			stnd_evdn_camt			= Cstr(grd0.GetCellData("bd_stnd_evdn_camt", i))
			reuse_camt				= Cstr(grd0.GetCellData("bd_reuse_camt", i))
			othr_crnc_evdn_camt		= Cstr(grd0.GetCellData("bd_othr_crnc_evdn_camt", i))
			pcur_oder_able_camt		= Cstr(grd0.GetCellData("bd_pcur_oder_able_camt", i))
			oder_crnc_oder_able_camt	= Cstr(grd0.GetCellData("bd_oder_crnc_oder_able_camt", i))
						
			grd0.SetCellData("bd_frcr_camt"					, i , FormatNumber(frcr_amt,2))
			grd0.SetCellData("bd_stnd_evdn_camt"				, i , FormatNumber(stnd_evdn_camt,2))
			grd0.SetCellData("bd_reuse_camt"				, i , FormatNumber(reuse_camt,2))
			grd0.SetCellData("bd_othr_crnc_evdn_camt"		, i , FormatNumber(othr_crnc_evdn_camt,2))
			grd0.SetCellData("bd_pcur_oder_able_camt"		, i , FormatNumber(pcur_oder_able_camt,2))
			grd0.SetCellData("bd_oder_crnc_oder_able_camt"	, i , FormatNumber(oder_crnc_oder_able_camt,2))
		next
		g_NextCnt = g_NextCnt + DATAMANAGER.GetDataCount(0, "obtro_acnt_151r", "OutBlock1")
		'하단 SUM
		totalSum = DATAMANAGER.GetDataValue(0, "obtro_acnt_151r", "OutBlock2", "ODER_ABLE_CAMT" , 0 )
		grd0.SetCellFootCaption("fh_sum", FormatNumber(totalSum,2))
	end if
	'해외주식 일반 주문가능금액 조회
	if szTranID = "obtro_oder_104r" then
		for i = g_NextCnt to grdCommon.rowcount - 1
			crcd   			= grdCommon.GetCellData("bd_crcd", i)
			frcr_amt			= Cstr(grdCommon.GetCellData("bd_frcr_amt", i))
			oder_able_camt	= Cstr(grdCommon.GetCellData("bd_camt1", i))
			oder_margin		= Cstr(grdCommon.GetCellData("bd_oder_margin", i))
			otst_seln		= Cstr(grdCommon.GetCellData("bd_otst_seln", i))
			otst_byon		= Cstr(grdCommon.GetCellData("bd_otst_byov", i))
						
			grdCommon.SetCellData("bd_frcr_amt"	, i , FormatNumber(frcr_amt,2))
			grdCommon.SetCellData("bd_camt1"		, i , FormatNumber(oder_able_camt,2))
			grdCommon.SetCellData("bd_oder_margin",i , FormatNumber(oder_margin,2))
			grdCommon.SetCellData("bd_otst_seln"	, i , FormatNumber(otst_seln,2))
			grdCommon.SetCellData("bd_otst_byov"	, i , FormatNumber(otst_byon,2))
		next
		g_NextCntCommon = g_NextCntCommon + DATAMANAGER.GetDataCount(0, "obtro_oder_104r", "OutBlock1")
	end if
	
	g_NextCntCommon = 0
	g_NextCnt = 0
End Sub
'============================================================================
' 통화/시장명 가져오기
'============================================================================
Sub SetCrcdCombo ()
	'통합증거금 대상 CRCD 조회
	DATAMANAGER.SetDataValue(0, "obtro_comn_401r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", 0, "%")
	DATAMANAGER.SetDataValue(0, "obtro_comn_401r", "InBlock1", "CRCD"					, 0, "%")
	DATAMANAGER.RequestTranData( "obtro_comn_401r" )
End Sub
'============================================================================
' 통화/시장코드 가져오기
'============================================================================
Sub SetCrcdCombo_1 ()
	'통합증거금 대상 CRCD 조회
	DATAMANAGER.SetDataValue(0, "obtro_comn_401r_1", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", 0, "%")
	DATAMANAGER.SetDataValue(0, "obtro_comn_401r_1", "InBlock1", "CRCD"					  , 0, "%")
	DATAMANAGER.RequestTranData( "obtro_comn_401r_1" )
End Sub
'============================================================================
' CmbCrcd 콤보 변경 
'============================================================================
Sub CmbCrcd_OnEditComplete(iIndex)	
	'통화콤보 변경때마다 시장콤보 같이 변경처리
    CmbMrkt.currentindex = iIndex

	'해외주식 통합증거금 주문가능금액 조회
	DATAMANAGER.RequestTranData("obtro_acnt_151r")
End Sub

'============================================================================
' 일반/통합 라디오 콤보
'============================================================================
Sub RadioGroup_OnClick(nIndex)
	'일반
	if nIndex = 0 Then
	    HideMapTotal()
	    ShowMapCommon()
		'해외주식 일반 주문가능금액 조회
		DATAMANAGER.RequestTranData("obtro_oder_104r")
	'통합증거금
	else
	    HideMapCommon()
	    ShowMapTotal()
		'해외주식 통합증거금 주문가능금액 조회
		DATAMANAGER.RequestTranData("obtro_acnt_151r")
	End If
End Sub
'============================================================================
' 일반주문가능금액 숨기기
'============================================================================
Sub HideMapCommon()
    grdCommon.visible = False
End Sub
'============================================================================
' 일반주문가능금액 보이기
'============================================================================
Sub ShowMapCommon()
    grdCommon.top = 40
    grdCommon.left =1
    grdCommon.visible = True
End Sub
'============================================================================
' 통합증거금 숨기기
'============================================================================
Sub HideMapTotal()
	LblCrcd.visible = False
	CmbCrcd.visible = False
	CmbMrkt.visible = False
	grd0.visible    = False
End sub
'============================================================================
' 통합증거금 보이기
'============================================================================
Sub ShowMapTotal()
	LblCrcd.visible = True
	CmbCrcd.visible = True
	CmbMrkt.visible = False ' 두번째 콤보는 보이면 안됨 
	grd0.visible    = True
End sub

