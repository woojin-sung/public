'============================================================================
Sub Form_OnFormInit()

	szData = Form.GetOpenLinkData()
	szDataList = Split(szData,"★")
	
	if UBound(szDataList) > 0 then
		
		szAcno = szDataList(0)
		szAsno = szDataList(1)
		szPass = szDataList(2)
		
		szCode  = szDataList(3)
		szMk    = szDataList(4)
		szName  = szDataList(5)
		szPrc   = szDataList(6)
		szTotal = szDataList(7)
		
		'종목명 세팅
		Label10.caption = szName
		
		'주문단가 세팅
		Table0.SetCellString(0, 1, szPrc)
		
		
		'수량조회 서비스호출(현금)
		DATAMANAGER.SetDataValue(0, "obtro_oder_234r", "InBlock1", "ACNO" 					, 0 , szAcno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_234r", "InBlock1", "ASNO" 					, 0 , szAsno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_234r", "InBlock1", "ACNT_PWD" 				, 0 , szPass)
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_234r", "InBlock1", "OVRS_STCK_SYMB_ISCD" 		, 0 , szCode)
		DATAMANAGER.SetDataValue(0, "obtro_oder_234r", "InBlock1", "OVRS_EXCH_VNDR_IDNO" 		, 0 , szMk)
		DATAMANAGER.SetDataValue(0, "obtro_oder_234r", "InBlock1", "OVRS_MRKT_BROK_IDNO" 		, 0 , "")
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_234r", "InBlock1", "ODER_CRNC_PRC" 			, 0 , szPrc)
		DATAMANAGER.SetDataValue(0, "obtro_oder_234r", "InBlock1", "APLY_RATE" 				, 0 , "")
		DATAMANAGER.SetDataValue(0, "obtro_oder_234r", "InBlock1", "IF_INTG_MARG_IQRY_YN" 	, 0 , "N")
		
		DATAMANAGER.RequestTranData("obtro_oder_234r")
		
		
		if szTotal then
		
			'수량조회 서비스호출(통합)
			DATAMANAGER.SetDataValue(0, "obtro_oder_234r_1", "InBlock1", "ACNO" 					, 0 , szAcno)
			DATAMANAGER.SetDataValue(0, "obtro_oder_234r_1", "InBlock1", "ASNO" 					, 0 , szAsno)
			DATAMANAGER.SetDataValue(0, "obtro_oder_234r_1", "InBlock1", "ACNT_PWD" 				, 0 , szPass)
		
			DATAMANAGER.SetDataValue(0, "obtro_oder_234r_1", "InBlock1", "OVRS_STCK_SYMB_ISCD" 		, 0 , szCode)
			DATAMANAGER.SetDataValue(0, "obtro_oder_234r_1", "InBlock1", "OVRS_EXCH_VNDR_IDNO" 		, 0 , szMk)
			DATAMANAGER.SetDataValue(0, "obtro_oder_234r_1", "InBlock1", "OVRS_MRKT_BROK_IDNO" 		, 0 , "")
		
			DATAMANAGER.SetDataValue(0, "obtro_oder_234r_1", "InBlock1", "ODER_CRNC_PRC" 			, 0 , szPrc)
			DATAMANAGER.SetDataValue(0, "obtro_oder_234r_1", "InBlock1", "APLY_RATE" 				, 0 , "")
			DATAMANAGER.SetDataValue(0, "obtro_oder_234r_1", "InBlock1", "IF_INTG_MARG_IQRY_YN" 	, 0 , "Y")
		
			DATAMANAGER.RequestTranData("obtro_oder_234r_1")
		
		else
		
			Table0.SetCellString(4, 1, "-")
		
		end if
		
	
		
	end if
	
	

	
End Sub

'============================================================================
Sub Table0_OnClick(lRow , lColumn)

	'현금
	if lRow == 2 and lColumn == 1 then
		szQty = Table0.GetCellString(lRow,lColumn )
		Form.SendReturnToParent("16060_p8" , szQty)
		Form.CloseForm()
		
	'통합
	elseif lRow == 4 and lColumn == 1 then
		
		szQty = Table0.GetCellString(lRow,lColumn )
		
		if szQty == "-" then
			Exit Sub
		end if
		
		
		Form.SendReturnToParent("16060_p8" , szQty)
		Form.CloseForm()
	end if
	
	
	
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub
