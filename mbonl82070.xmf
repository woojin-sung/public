'--===========================================================================
' 01. 화 면 명 : 대주위험고지등록
' 02. 화면설명 : 대주위험고지등록
' 03. 작    성 : 2021.11.22 김수진 
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szIqry_YN	'정보조회여부
Dim g_szPlain_rm	'메모리 평문적용 여부
Dim g_szServerMode '서버모드
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' f_ClearData() : 초기화
'============================================================================
Function f_ClearData()
	'대주거래 위험고지 등록 현황 초기화 
	g_szIqry_YN = "N"
	For i = 1 to 4
		contBody.tblStatus.SetCellString( i, 1, "" )
	Next
	
	'약관/설명서 확인 및 동의 초기화
	contBody.ChkView1.chksilence = "0"
	contBody.ChkView2.chksilence = "0"
	
	'실행버튼 비활성화 (정보조회후 활성화처리)
	BtnOK.enable = False
End Function

'===========================================================================
' f_GetPWCkeck() : 계좌비밀번호 입력체크함수
'===========================================================================
Function f_GetPWCkeck()
	Dim szACNT_PWD 
	szACNT_PWD = Form.GetCtlProp( "edtPswd", "caption" )
	
	If szACNT_PWD == null or szACNT_PWD == "" Then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	End If
	
	return false
End Function	

'============================================================================
' f_OpenUrl() : 약관 OPEN
'============================================================================
Function f_OpenUrl(szTitle, szUrl)
	If f_GetPWCkeck() Then
		contBody.ChkView1.chksilence = "0"
		contBody.ChkView2.chksilence = "0"
		Exit Function
	End if

	If szTitle <> "" and szTitle <> null and szUrl <> "" and szUrl <> null Then
		Form.SetSharedData("OPEN_URL", szURL )
		Form.OpenFramePopup("mbonl82020_p6" , szTitle , "") 	
	End If
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()    
	f_ClearData()
	edtPswd.caption = ""
	lblASNO.caption = ""
	
	'서버모드
	g_szServerMode 	= Form.GetSharedData("&SERVER_MODE", false)
	'메모리평문적용여부(0:미적용 / 1:적용)
	g_szPlain_rm 		= Form.GetSharedData("&PLAIN_RM", false)
End Sub

'============================================================================
' Form_OnRefresh()
'============================================================================
Sub Form_OnRefresh()
	f_ClearData()
	edtPswd.caption = ""	
	lblASNO.caption = ""
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "mbonl82020_p6" Then
		If sRet == "신용거래설명서" Then
			contBody.ChkView1.chksilence = "1"
		ElseIf sRet == "신용거래약관" Then
			contBody.ChkView2.chksilence = "1"
		End If
	End If
End Sub

'============================================================================
' acntList_ChangeAccount() : 다른 계좌로 변경 되었을때 초기화 
'============================================================================
Sub acntList_ChangeAccount()
	f_ClearData()
	edtPswd.caption = ""
	lblASNO.caption = ""
End Sub

'============================================================================
' edtPswd_OnEditComplete() : 비밀번호 입력완료시 초기화 및 대주위험고지등록내역 조회
'============================================================================
Sub edtPswd_OnEditComplete()
	f_ClearData()
	lblASNO.caption = ""
	
	'대주 위험고지 등록내역 조회
	DATAMANAGER.RequestTranData("oblon_basc_700r")	
End Sub


'============================================================================
' 약관/설명서 확인 및 동의
'============================================================================
'============================================================================
' contBody_ChkView1_OnChange() : 신용거래설명서
'============================================================================
Sub contBody_ChkView1_OnChange(sCheckState)
	If sCheckState == "1" Then
		contBody.ChkView1.chksilence = "0"
		Dim szURL 
		If g_szServerMode = "1" Then
			szURL = "https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_03.pdf"
		Else
			szURL = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_03.pdf"
		End If
		f_OpenUrl("신용거래설명서", szUrl)
	End If
End Sub

'============================================================================
' contBody_ChkView2_OnChange() : 신용거래약관
'============================================================================
Sub contBody_ChkView2_OnChange(sCheckState)
	If sCheckState == "1" Then
		contBody.ChkView2.chksilence = "0"
		Dim szURL 
		If g_szServerMode = "1" Then
			szURL = "https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/meritz_yk_9.pdf"
		else
			szURL = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_yk_9.pdf"
		End If
		f_OpenUrl("신용거래약관", szUrl)
	End If
End Sub

'============================================================================
' contBody_btnView1_OnClick() : 신용거래설명서
'============================================================================
Sub contBody_btnView1_OnClick()
	Dim szURL 
	If g_szServerMode = "1" Then
		szURL = "https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_03.pdf"
	Else
		szURL = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_info_03.pdf"
	End If
	f_OpenUrl("신용거래설명서", szUrl)
End Sub

'============================================================================
' contBody_btnView2_OnClick() : 신용거래약관
'============================================================================
Sub contBody_btnView2_OnClick()
	Dim szURL 
	If g_szServerMode = "1" Then
		szURL = "https://testhome.imeritz.com/include/resource/comm/ctcn/pdf/meritz_yk_9.pdf"
	else
		szURL = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_yk_9.pdf"
	End If
	f_OpenUrl("신용거래약관", szUrl)
End Sub

'============================================================================
' BtnOK_OnClick() : 대주 위험고지 등록
'============================================================================
Sub BtnOK_OnClick()

	'계좌비밀번호 입력체크함수
	If f_GetPWCkeck() Then
		Exit Sub
	End If
	
	'등록 가능여부 체크
	'선조회여부 체크
	If g_szIqry_YN <> "Y" Then
		Form.ShowAlert("알림", "대주거래 위험고지 등록현황 조회 후 등록 가능")
		Exit Sub
	End If
	
	'약정확인 체크
	If contBody.ChkView1.chksilence == "0" Then
		Form.MsgBox( "알림", "신용거래설명서에 동의하셔야 합니다.", "", 6 )	
		Exit Sub
	End If
	If contBody.ChkView2.chksilence == "0" Then
		Form.MsgBox( "알림", "신용거래약관에 동의하셔야 합니다.", "", 6 )	
		Exit Sub
	End if
	
	'대주 위험고지 등록
	DATAMANAGER.RequestTranData("oblon_basc_700a")
End Sub

'============================================================================
' contBody_btnLink_OnClick() : 사전교육/모의거래이수등록 화면으로 이동
'============================================================================
Sub contBody_btnLink_OnClick()
	Form.OpenScreen("82080", "")
End Sub
'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 통신에 필요한 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNT_PWD 
	if g_szPlain_rm == "1" then  			'MTS메모리평문 적용상태일때
	    szACNT_PWD = edtPswd.caption
	else  								'MTS메모리평문 미적용상태일때
	    szACNT_PWD = Form.GetEncData(edtPswd.caption)
	end if
	
	'대주 위험고지 등록내역 조회
	If szTranID == "oblon_basc_700r" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"          , 0 , acntList.total	)	'Left(acntList.caption, 8)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD"      , 0 , szACNT_PWD		)
	
	'대주 위험고지 등록
	ElseIf szTranID == "oblon_basc_700a" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE"      , 0 , "I" 				)	'처리구분 (I:등록, D:삭제)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CONT_CLS_CODE"      , 0 , "4"				)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"         	 	, 0 , acntList.total		)	'Left(acntList.caption, 8)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD"      		, 0 , szACNT_PWD			)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO"          		, 0 , lblASNO.caption	)	'Right(acntList.caption, 2)
	
	'계좌일련번호 조회
	ElseIf szTranID == "obacp_opop_065r" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"         	 	, 0 , acntList.total		)	'Left(acntList.caption, 8)
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'대주 위험고지 등록내역 조회
	If szTranID == "oblon_basc_700r" Then
		g_szIqry_YN = "Y"
		
		Dim szAgrmYn, szStlnStplYn
		'대주위험고지확인일 설정
		szAgrmYn	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RISK_NTIC_AGRM_YN" 	, 0)
		If szAgrmYn == "N" Then
			contBody.tblStatus.SetCellString( 2 , 1 , "-") 
		End If
		
		'신용대주약정일 설정
		szStlnStplYn	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STLN_STPL_YN" 	, 0) 
		If szStlnStplYn == "N" Then
		    contBody.tblStatus.SetCellString( 3 , 1 , "-") 
		End If
		
		BtnOK.enable = True
		
		'대주 위험고지 등록
		DATAMANAGER.RequestTranData("obacp_opop_065r")
		
	'대주 위험고지 등록
	ElseIf szTranID == "oblon_basc_700a" Then
		Form.ShowAlert("알림", "등록 완료되었습니다.")
		
		f_ClearData()
		lblASNO.caption = ""
		'대주 위험고지 등록내역 조회
		DATAMANAGER.RequestTranData("oblon_basc_700r")			

	'계좌일련번호 조회
	ElseIf szTranID == "obacp_opop_065r" Then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock1" )
		
		If nCnt > 0 Then
			Dim szACNT_STAT_CODE, szPRCD
			szACNT_STAT_CODE = ""
			szPRCD = ""
			
			For i = 0 To nCnt-1 
				szACNT_STAT_CODE 	= DATAMANAGER.GetDataValue( 0	, szTranID	, "OutBlock1", "ACNT_STAT_CODE" 	, i )
				szPRCD 			= DATAMANAGER.GetDataValue( 0	, szTranID	, "OutBlock1", "PRCD" 				, i )
				
				If szACNT_STAT_CODE == "1" and szPRCD == "100" or szPRCD == "105" or szPRCD == "106" or szPRCD == "107" or szPRCD == "117" or szPRCD == "119" then
					lblASNO.caption = DATAMANAGER.GetDataValue( 0	, szTranID	, "OutBlock1"	, "ASNO" 	, i )
					Exit For
				Else
					lblASNO.caption = DATAMANAGER.GetDataValue( 0	, szTranID	, "OutBlock1"	, "ASNO" 	, 0 )
				End If
			Next
		End If
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubMsg <> NULL and szSubMsg <> "" Then
		Form.ShowAlert( "알림", szErrMsg & "(" & szSubMsg & ")" )
	Else
		Form.ShowAlert( "알림", szErrMsg )
	End If
End Sub



