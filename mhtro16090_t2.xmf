Sub BtnPrc1_OnClick()
	szPrc = int(LblPrcin.caption)
	if szPrc <> "" and szPrc <> null then
		szPrc = int(LblPrcin.caption) + 1000
		if PrcLen_Chk(szPrc) = true then
			
		else
			szPrc = int(LblPrcin.caption)
			BtnPrcin.caption = ""
			exit Sub
		end if
	else
		szPrc = 1000
	end if
	BtnPrcin.caption = ""
'	LblPrcin.caption = szPrc
	g_szPopPrc = szPrc
	call LblPrcin_OnClick()
End Sub
