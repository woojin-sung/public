		DATAMANAGER.SetDataValue(0, "obtro_oder_804r", "InBlock1", "IQRY_CLS_CODE"		, 0, "1")
		DATAMANAGER.SetDataValue(0, "obtro_oder_804r", "InBlock1", "PROD_PSTN_CLS_CODE"	, 0, "1")
		DATAMANAGER.SetDataValue(0, "obtro_oder_804r", "InBlock1", "ELFN_ID"				, 0, g_szCustID)
	end if	
	
End Sub
				
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szWarnMsg, szOrdCd, szOrdMsg, szOrgNo
	
	' ----------------------------------------------------------------------
	' 해외주식 매도주문
	' ----------------------------------------------------------------------	
	Select Case szTranID
		Case "obtro_oder_801a"
			' 20181022 HWG START : 해외주식 주문착오 방지
			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
			
			if szWarnCd = "1" then							' 경고
				Open_ConfirmPopup(szWarnMsg)
			elseif szWarnCd = "2" then						' 보류(해외주식 제외)
				g_szTR = ""
				'Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
			else
				g_szTR = ""
				
				szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
				szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
				
				if Trim(szOrdCd) == "0001" then			' 정상주문
'					Form.Toast(0, szOrdMsg, true)
					
					if g_szAfterInit == "1" then		' 주문후 초기화
						Init_InputControl()
					end if
					Form.OpenPopup("mhtro16090_p4" , g_szOrdData , "")
					DATAMANAGER.RequestTranData("obtro_oder_804r")
				end if
			end if
			' 20181022 HWG END
		Case "obtro_oder_804r"
			szCnt = DATAMANAGER.GetDataCount( 0, "obtro_oder_804r" , "OutBlock1" ) 'VLTN_AMT1 : 매도가능잔고의 원화평가금액
			if int(szCnt) = 0 then
				TblAbleprc.SetCellString(0, 1, "0")
				TblBal.SetCellString(0, 1, "0")
			end if
		Case "obtro_oder_803r"
			szQty = DATAMANAGER.GetDataValue( 0, "obtro_oder_803r" , "OutBlock1", "DQTY", 0 ) 
			if szQty = "" or szQty = null then
				szQty = 0
			end if
			LblQty.caption = szQty
			LblAlert.caption = ""
'			g_szAlatYn = "N"
'		'20201021 LES START 해외주식 매도상환
'		Case "obtro_oder_150a"
'			
'			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
'			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
'				
'			if szWarnCd = "0" then
'				szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
'				szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
'				g_szTR = ""
'				
'				if Trim(szOrdCd) == "0001" then			' 정상주문7
'					Form.Toast(0, szOrdMsg, true)
'					
'					if g_szAfterInit == "1" then		' 주문후 초기화
'						Init_InputControl()
'					end if
'				end if
'				
'				
'			end if
'		
		'20201021 LES END
	' ----------------------------------------------------------------------
	' 해외주식 시세조회
	' ----------------------------------------------------------------------	
	' 20171204 HAMWG START : 해외주식_시세조회 데이터세팅
			
'		Case "obtro_oder_235r"
'			szAbleQty = DATAMANAGER.GetDataValue( 0, "obtro_oder_235r", "OutBlock1", "SELN_ABLE_QTY" , 0 )	' 주문가능수량
'			edtQty.caption = szAbleQty
'			edtQty_OnEditComplete()
	'20171204 HAMWG END
	End Select
	
	g_szWarnFlag = "N"	' 20181022 HWG : 해외주식 주문착오 방지
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	if szTranID = "obtro_oder_803r" then
		LblAlert.caption = szErrMsg
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
	end if
End Sub


