'============================================================================
Sub LblPrcin_OnClick()
	ImgPrcreset.visible = true
	if Trim(g_szPopPrc) <> "" then
		szPrc = CLng(g_szPopPrc)
	else
		szPrc = CLng(LblPrcin.caption)
	end if

'	szMod = szPrc Mod 1000
	g_lngAblePrc = CLng(TblAbleprc.GetCellString(0, 1))

	if g_lngAblePrc = "" or g_lngAblePrc=null then
		g_lngAblePrc=0
	end if
'	if lngAblePrc < szPrc then
'		LblAlert.caption = "주문가능금액을 확인해주세요"
''		szPrc = lngAblePrc
'	end if
	
	if g_lngAblePrc = szPrc then '전량매도인 경우
'		LblAlert.caption = ""
		g_szAlatYn = "Y"
		Label0.caption = "전량"
		LblPrcin.caption = szPrc
		DATAMANAGER.RequestTranData("obtro_oder_803r")
		exit Sub 
	else
		g_szAlatYn = "N"
		Label0.caption = "천원이상 | 천원단위"
	end if
	
'	if szPrc<1000 and lngAblePrc <> CLng(szPrc) then
'		LblAlert.caption = "1,000원 미만은, 전량 매도만 가능합니다."
'		LblPrcin.caption = szPrc
'		exit sub
'	end if
		
'	szMod = szPrc Mod 1000
'	if CLng(szMod) > 0 and szPrc > 1000 then
'		szPrc = szPrc-szMod
'		LblAlert.caption = "천원이상, 천원단위로만 신청 가능합니다."
'	elseif lngAblePrc>999 and lngAblePrc < CLng(szPrc) then
