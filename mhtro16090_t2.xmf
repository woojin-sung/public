'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력

	g_szSelQty     = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTY")		' 매도수량 자동입력
	g_szSelQtyCnt  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTYCNT")	' 매도수량 주수(수량입력 선택시)
	
	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170919 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170919 HAMWG END
	
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	' 매도수량 자동입력(기본값 : 사용하지 않음)
	if Trim(g_szSelQty) = "" then
		g_szSelQty = "0"		
	end if	
End Function


'============================================================================
' Check_InputData
'============================================================================
Function Check_InputData(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Check_Account(nGbn) == false then
		return false
	end if

	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if
	
'	if Trim(LblQty.caption) == "" or Trim(LblQty.caption) == "0" then
'		Form.ShowAlert(g_szTitle, "주문수량을 확인하십시요.")
'		return false
'	end if
	
	if nGbn == 0 then
		if Trim(LblPrcin.caption) == "" or Trim(LblPrcin.caption) == "0" then
			Form.ShowAlert(g_szTitle, "주문금액을 입력하십시요.")
			return false
		end if	
	end if
		
	if nGbn <> 2 then	
		Dim szData
		sCodeData = Split(g_szCd, "@")
		szData = "1"													' 매매구분
		szData = szData & "|" & Form.GetTopCtlProp("acnt", "caption")		' 계좌번호
		szData = szData & "|" & Form.GetTopCtlProp("acnt", "accountname")	' 계좌명
		szData = szData & "|" & sCodeData[1]								' 종목코드
		szData = szData & "|" & g_szKorName								' 종목명
		szData = szData & "|" & "지정가"								' 주문구분
		szData = szData & "|" & "0"										' 현금
		szData = szData & "|" & LblQty.caption							' 주문수량
		szData = szData & "|" & LblPrcin.caption							' 주문가격
		szData = szData & "|" & ""										' 원주문번호
		szData = szData & "|" & ""										' 전량전부
		
		g_szOrdData = szData
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup()
		else
			Request_Order()
		end if
	end if
	
	return true
End Function

