'	else
'		LblAlert.caption = ""
'	end if
	
'	g_szAlatYn = "N"
	
	LblPrcin.caption = szPrc
	LblQty.caption = ""
	if 0 < g_lngAblePrc and g_lngAblePrc<1000 and g_szAlatYn="N" then
		LblAlert.caption = "천원 미만 보유 시 전량매도만 가능합니다."
		Exit Sub
	end if
	DATAMANAGER.RequestTranData("obtro_oder_803r")
End Sub
