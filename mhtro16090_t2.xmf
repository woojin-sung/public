'============================================================================
' btnBalance_OnClick : 잔고버튼 클릭
'============================================================================
Sub btnBalance_OnClick()
	szAcnt 		= Form.GetTopCtlProp("acnt", "total")
	szAcntCd 	= Form.GetTopCtlProp("acnt", "sequence")
	
	'20200910 SWJ START
	'MTS메모리평문제거 적용상태일 때
	if plain_rm == "1" then
		szAcntPwd	= Form.GetTopCtlProp("edtPwd", "caption")
	'MTS메모리평문제거 적용상태일 때
	else
		szAcntPwd	= Form.GetTopCtlProp("edtPwd", "encdata")
	end if
	'20200910 SWJ END
	
	' 계좌번호(8), 계좌일련번호(2), 탭구분, 주문구분(0:일반주문, 1:예약주문, 2:호가주문)
	szData = szAcnt & "★" & szAcntCd & "★" & szAcntPwd & "★1★0"
'	Form.OpenFramePopup("mhtro16090_pb", szData, "")
	Form.OpenFramePopup("mhtro16060_pb", szData, "")
End Sub 


