'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	GrdLine.SetCellBgColor(bd_cell0, 0, "291")
	Label3.fgcolor = "200"
	btnSell.fontbold = true '안드로이드
	
	g_szCustID = Form.GetSharedData("&USER_ID", false )
	Load_OrderSet() '주문설정값 읽어오기
	
	'20201021 LES START 해외주식 매도상환
'	Call SetCtrlVisible()
	'20201021 LES END
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	 plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
'	DATAMANAGER.RequestTranData("obtro_oder_804r")
	
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
'			Form.ShowAlert(sEventName, szData)
	' ----------------------------------------------------------------------
	' 현재가 호가연동
	' ----------------------------------------------------------------------		
	if sEventName == "PRICE" then
		edtPrc.caption = sParam
		edtPrc_OnEditComplete()
		g_bPrcFlg = true
	elseif sEventName == "JANGO" then
		'20201021 LES START 해외주식 매도상환
		
		'매도매수구분/수량/대출일자/대출상세유형코드/대출일련번호
		szData = Split(sParam,"★")
		edtQty.caption = szData(1)
		edtQty_OnEditComplete()

	' ----------------------------------------------------------------------
	' 호가테이블 클릭 호가연동
	' ----------------------------------------------------------------------	
	elseif sEventName == "HOGA" then
		
		'20201124 LES START 해외주식 시장가 매도
		szType = Check_OrdType()
		
		if szType <> "05" then
			edtPrc.caption = sParam
			edtPrc_OnEditComplete()
		end if
		'20201124 LES END
		
	' ----------------------------------------------------------------------
	' 메인화면 이벤트처리 (종목변경/탭변경)
	' ----------------------------------------------------------------------		
	' 20171127 HAMWG START : 해외주식 종목코드 가져오기
	elseif sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then	
'		Form.ShowAlert("sEventName", sEventName)
		if g_szCd <> sParam then
			g_szCd = sParam
			sCodeData = Split(sParam, "@")		
			g_szKorName = Form.GetItemCodeInfo(g_szCd, "name")	' 한글종목명
			g_szNg = Form.GetItemCodeInfo(g_szCd, "ovsnation")	' 국가구분코드
			g_szMk = Form.GetItemCodeInfo(g_szCd, "exchid")	' 거래소벤더코드
			
		end if
		
'		DATAMANAGER.RequestTranData( "ohhts_6000_001r" )
		DATAMANAGER.RequestTranData( "obtro_oder_804r" )
		
		if g_bRtnData == false then
'			if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
				Init_InputControl()
'			end if
		else
			g_bRtnData = false
		end if
	' ----------------------------------------------------------------------
	' 계좌변경시 초기화
	' ----------------------------------------------------------------------	
	elseif sEventName == "ChangeAcnt" then
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if
		DATAMANAGER.RequestTranData( "obtro_oder_804r" )
	' 20171127 HAMWG END

	' ----------------------------------------------------------------------
	' 자동가격입력
	' ----------------------------------------------------------------------		
	elseif sEventName == "AUTO_PRICE" then
		Dim szPrc
		
		'20170919 HAMWG START : 탭/종목 변경시 초기화 여부
		if g_szChangeInit <> "1" then		
			if Trim(sParam) <> "" then
				edtPrc.caption = sParam
				edtPrc_OnEditComplete()
			end if
			
			Return_AutoQty()
		else
			Init_InputControl()
		end if
		'20170919 HAMWG END
	end if
End Sub
'============================================================================
' 해외주식시장거래구분코드
'============================================================================
Function Get_OvrsStckMrktClsCode(sTemp)
    Select Case sTemp
	    Case "NY", "AX", "OQ"
		    return "01" '미국
		Case "HK"
		    return "02" '홍콩
		Case "SH"
		    return "03" '상해
		Case "SZ"
		    return "04" '심천
		Case "JP"
		    return "05" '일본
    End Select

End Function
'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)	
	' 20181022 HWG START : 해외주식 주문착오 방지
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	
	' 20181022 HWG END
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	' ----------------------------------------------------------------------
	' 수량/금액입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		edtQty_OnEditComplete()
	' ----------------------------------------------------------------------
	' 가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then		
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
'			szPrc = CLng(sRet)
'			szMod = szPrc Mod 1000
'			lngAblePrc = CLng(TblAbleprc.GetCellString(0, 1))
'			
'			if lngAblePrc<1000 and lngAblePrc <> CLng(szPrc) then
'				LblAlert.caption = "1,000원 미만은, 전량 매도만 가능합니다."
'				LblPrcin.caption = szPrc
'				exit sub
'			end if
'			
'			if CInt(szMod) > 0 then
'				szPrc = szPrc-szMod
'				LblAlert.caption = "천원이상, 천원단위로만 신청 가능합니다."
'			elseif lngAblePrc>999 and lngAblePrc < CLng(szPrc) then
'				LblAlert.caption = "매도가능금액을 확인해주세요"
'			else
'				LblAlert.caption = ""
'			end if
'			
'			LblPrcin.caption = szPrc
			ImgPrcreset.visible = true
			g_szPopPrc = sRet
			call LblPrcin_OnClick()
		else
			ImgPrcreset.visible = false
			LblQty.caption = ""
			LblAlert.caption = ""
			BtnPrcin.caption = "매도금액을 입력해주세요"
			Label0.caption = "천원이상 | 천원단위"
			ImgPrcreset.visible = false
		end if
'		edtPrc_OnEditComplete()
	' ----------------------------------------------------------------------
	' 해외주식 잔고팝업 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "BALANCE" then
		if sRet == "" then
			Exit Sub
		end if
		g_bRtnData = true
		Return_BalanceScreen(sRet)
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	'20201124 LES START 해외주식 시장가 매도
	'주문유형(지정가/시장가)
'	szType = Check_OrdType()
	
	szPrc = LblPrcin.caption
	if Trim(szPrc) == "" then
		szPrc = 0
	end if
	
	' ----------------------------------------------------------------------
	' 해외주식 소수점 매도주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtro_oder_801a" then
		g_szTR = szTranID
		sCodeData = Split(g_szCd, "@")
		DATAMANAGER.ClearInputData(0, "obtro_oder_801a")

		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "ACNO"				, 0, Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "ASNO"				, 0, Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "ACNT_PWD"			, 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때	
		else	
			DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "ACNT_PWD"			, 0, Form.GetTopCtlProp("edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "OVRS_STCK_SYMB_ISCD"	, 0, sCodeData[1])							' 종목코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "OVRS_EXCH_VNDR_IDNO"	, 0, g_szMk)									' 거래소코드
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "SELN_BYOV_CLCD"		, 0, "1")									' 매도/매수구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_801a", "InBlock1", "ODER_CLS_CODE"		, 0, "01")									' 주문구분코드
