Sub cont_btnInvt_OnClick()
	if g_sWaPrcd <> null and g_sWaPrcd <> "" and g_sAcno <> null and g_sAcno <> "" and g_sAsno <> null and g_sAsno <> "" and g_sCnrcNo <> null and g_sCnrcNo <> "" and g_sInvtYN <> null and g_sInvtYN <> "" then
		Form.OpenPopup("mbwat61060_p1", g_sWaPrcd.."|"..g_sAcno.."|"..g_sAsno.."|"..g_sCnrcNo.."|"..g_sInvtYN, "")
	end if
End Sub

