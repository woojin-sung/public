		sDSCS_MGRI_RMRT = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "DSCS_MGRI_RMRT" , 0 ) '협의운용보수율
		sOTCM_RMRT = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "OTCM_RMRT" , 0 ) '성과보수율
		
