'		Dim tData
'		tData = Split(g_sInvtYN, "|")
		
'		' 파생형 or 성과보수형인 경우
'		if tData(8) == "Y" or tData(9) == "Y" or g_sWA_OTCM_PAY_YN == "Y" then
'			cont.btnSwitch4.switchindex = 1
'			cont.btnSwitch4.enable = false
'			f_ClickButton4()
'		end if
		
	elseif szTranID == "obwat_ctad_016r" then
