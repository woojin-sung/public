		sWA_MANG_LIST_INVT_YN = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "WA_MANG_LIST_INVT_YN" , 0 ) '관리종목 운용여부
		sWA_AFCO_LIST_INVT_YN = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "WA_AFCO_LIST_INVT_YN" , 0 ) '계열사종목 운용여부
		sWA_GOAL_ERT = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "WA_GOAL_ERT" , 0 ) '랩어카운트목표수익율
		sLOSS_LIMT_RATE = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "LOSS_LIMT_RATE" , 0 ) '손실한도율
		
