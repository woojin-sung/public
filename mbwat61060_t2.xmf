		sWA_CNRC_EXTS_YN = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "WA_CNRC_EXTS_YN" , 0 ) '랩어카운트계약연장여부
		sWA_MGRI_EMPNO = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "WA_MGRI_EMPNO" , 0 ) '랩어카운트운용직원번호
		sSNML_INAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "SNML_INAG_TYPE_CODE" , 0 ) '발송물통보처유형코드
		sWA_CUST_INVT_INCL_OPNN = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "WA_CUST_INVT_INCL_OPNN" , 0 ) '랩어카운트고객투자성향의견
		sMNST_EMPNO = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "MNST_EMPNO" , 0 ) '관리사원직원번호
		sRCMD_EMPNO = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "RCMD_EMPNO" , 0 ) '권유직원번호
