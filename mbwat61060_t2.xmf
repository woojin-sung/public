		g_sWA_OTCM_PAY_YN = DATAMANAGER.GetDataValue(0, "obwat_pdad_065r", "OutBlock1", "WA_OTCM_PAY_YN" , 0) '성과보수
		
		if sMGRI_MNBD_CLS_CODE == "2" then '지점형
			g_sInvtEnableYN = "Y"
			cont.btnSwitch1.enable = true
			cont.cmbRate.enable = true
		else
			g_sInvtEnableYN = "N"
			cont.btnSwitch1.enable = false
			cont.cmbRate.enable = false
		end if
		
		
		' 신용설정
		' 본사형 - 안보이게
		' 지점형 - 성장지향형 OFF 고정
		' 지점형 - 신용가능이면 ON/OFF
		' 지점형 - 신용불가이면 OFF
		if sLOAN_ABLE_YN <> "Y" then
			if sMGRI_MNBD_CLS_CODE == "2" then '지점형
				if g_sGrpCode = "A" or g_sGrpCode = "D" or g_sGrpCode = "G" then
					cont.btnSwitch1.enable = false
				else
					if g_sLoanAbleYN = "N" or g_sLoanAbleYN = "" then
						cont.btnSwitch1.enable = false
					end if
				end if
			else
				cont.btnSwitch1.enable = false
			end if
