		sWA_PRCD = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "WA_PRCD" , 0 ) '랩어카운트상품코드
		sCUST_INFR_YN = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "CUST_INFR_YN" , 0 ) '고객통보여부
		sFRST_CNRC_DATE = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "FRST_CNRC_DATE" , 0 ) '최초계약일자
		sCNRC_MTRT_DATE = DATAMANAGER.GetDataValue( 0, "obwat_ctad_016r", "OutBlock1", "CNRC_MTRT_DATE" , 0 ) '계약만기일자
