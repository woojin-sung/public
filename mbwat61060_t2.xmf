'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Wrap 계약정보 변경 (운용지침)
' 02. 화면설명 : 
' 03. 이    력 : 2022.10.21 : 고승연 : v0001 : 
'                2022.10.24 : 고승연 : v0002 : 계좌일련번호 추가
'                2024.03.26 : 고승연 : v0004 : [T2402290007] obwat_pdad_065r IO 수정
'                2024.07.17 : 고승연 : v0005 : [] 체결통지, 월간수익율 통지 기능 삭제
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sInvtEnableYN
Dim g_sInvtYN
Dim g_bRequest
Dim g_sWaPrcd				'랩상품코드
Dim g_sWA_OTCM_PAY_YN		'성과보수여부
Dim g_zDrvtCnt			'파생계좌건수
Dim g_sGrpCode			'분류그룹코드
Dim g_sLoanAbleYN			'대출가능여부
Dim g_sAcno
Dim g_sAsno
Dim g_sCnrcNo
Dim g_aWA_OTCM_PAY_TPCD	'성과보수유형코드

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	cont.btnSwitch0.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	cont.btnSwitch1.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	cont.btnSwitch2.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	cont.btnSwitch3.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	cont.btnSwitch4.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	'cont.btnSwitch5.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	'cont.btnSwitch6.setApplySwitch("OFF", "ON", 269, 261, 286, 289)
	
	cont.edtGoal.left = 400
	cont.lblGoal.left = 400
	cont.edtLoss.left = 400
	cont.lblLoss.left = 400
	
	f_SetClear()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "Clear" then
		f_SetClear()
		
	elseif sEventName == "Request" then
		if sParam <> null and sParam <> "" then
			g_bRequest = true
			
			Dim tData
			tData = Split(sParam, "|")
			
			f_SetInit()
			
			if tData(0) == null or tData(0) == "" or tData(1) == null or tData(1) == "" or tData(2) == null or tData(2) == "" then
				Exit Sub
			end if
			
			g_sAcno = tData(0)
			g_sAsno = tData(1)
			g_sCnrcNo = tData(2)
			
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_023r", "InBlock1", "WA_ACNO" , 0 , g_sAcno )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_023r", "InBlock1", "WA_CNRC_NO" , 0 , g_sCnrcNo )
			
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_016r", "InBlock1", "WA_ACNO" , 0 , g_sAcno )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_016r", "InBlock1", "WA_CNRC_NO" , 0 , g_sCnrcNo )
			
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "WA_ACNO" , 0 , g_sAcno )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "WA_CNRC_NO" , 0 , g_sCnrcNo )
			
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "WA_ACNO" , 0 , g_sAcno )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "WA_CNRC_NO" , 0 , g_sCnrcNo )
			
			DATAMANAGER.RequestTranData( "obwat_ctad_023r" )
		end if
		
	elseif sEventName == "PwCheck" then
		DATAMANAGER.SetEventFlag( "obwat_ctad_013a", "U" )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "PWD" , 0 , sParam )
		
		Dim sLOAN_ABLE_YN
		sLOAN_ABLE_YN = cont.btnSwitch1.switchindex = "1" and "Y" or "N"
		
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "LOAN_ABLE_YN" , 0 , sLOAN_ABLE_YN )
		
		if sLOAN_ABLE_YN == "Y" then
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "CRDT_GVNG_AMT_RATE" , 0 , cont.cmbRate.cbkeydata / 100 )
		end if
		
		' tData(0) : 거래소
		' tData(1) : 코스닥
		' tData(2) : 코넥스
		' tData(3) : ETN
		' tData(4) : K-OTC
		' tData(5) : 파생ETF
		' tData(6) : 해외주식
		' tData(7) : 해외ETP
		' tData(8) : 선물옵션매수/청산
		' tData(9) : 모든선물옵션
		' tData(10) : 채권
		' tData(11) : 펀드
		' tData(12) : MMW자동투자
		
		Dim tData
		tData = Split(g_sInvtYN, "|")
		
		for i = 0 to #tData-1
			if tData(i) == "" then
				tData(i) = "N"
			end if
		next
		
		if tData(9) == "Y" then
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "OPTN_TR_ABLE_YN" , 0 , "Y" )
		elseif tData(8) == "Y" then
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "OPTN_TR_ABLE_YN" , 0 , "N" )
		else
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "OPTN_TR_ABLE_YN" , 0 , "" )
		end if
		
		Dim sSTCK_CNTG_BRKD_SNDN_APLT_YN
		'sSTCK_CNTG_BRKD_SNDN_APLT_YN = cont.btnSwitch5.switchindex = "1" and "Y" or "N"
		
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "STCK_CNTG_BRKD_SNDN_APLT_YN" , 0 , sSTCK_CNTG_BRKD_SNDN_APLT_YN )
		
		Dim sMNTL_ERT_INFR_YN
		'sMNTL_ERT_INFR_YN = cont.btnSwitch6.switchindex = "1" and "Y" or "N"
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_013a", "InBlock1", "MNTL_ERT_INFR_YN" , 0 , sMNTL_ERT_INFR_YN )
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		DATAMANAGER.SetEventFlag( "obwat_ctad_017a", "U" )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "PWD" , 0 , sParam )
		
		Dim sWA_EPMD_LIST_INVT_YN, sWA_MANG_LIST_INVT_YN, sWA_AFCO_LIST_INVT_YN
		sWA_EPMD_LIST_INVT_YN = cont.btnSwitch0.switchindex = "1" and "Y" or "N"
		sWA_MANG_LIST_INVT_YN = cont.btnSwitch2.switchindex = "1" and "Y" or "N"
		sWA_AFCO_LIST_INVT_YN = cont.btnSwitch3.switchindex = "1" and "Y" or "N"
		
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "WA_EPMD_LIST_INVT_YN" , 0 , sWA_EPMD_LIST_INVT_YN )	'투자유의종목
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "WA_MANG_LIST_INVT_YN" , 0 , sWA_MANG_LIST_INVT_YN )	'관리종목
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "WA_AFCO_LIST_INVT_YN" , 0 , sWA_AFCO_LIST_INVT_YN )	'계열사종목
		
		if cont.btnSwitch4.switchindex == "1" then
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "WA_GOAL_ERT" , 0 , cont.edtGoal.caption )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "LOSS_LIMT_RATE" , 0 , cont.edtLoss.caption )
		else
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "WA_GOAL_ERT" , 0 , "" )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "LOSS_LIMT_RATE" , 0 , "" )
		end if
		
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "EXCH_INVT_ABLE_YN" , 0 , tData(0) )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "KOSDAQ_INVT_ABLE_YN" , 0 , tData(1) )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "KONEX_INVT_YN" , 0 , tData(2) )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "ETN_INVT_YN" , 0 , tData(3) )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "OTC_INVT_YN" , 0 , tData(4) )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "DRVT_ETF_INVT_YN" , 0 , tData(5) )
		
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "OVRS_STCK_INVT_YN" , 0 , tData(6) )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "OVRS_ETP_INVT_YN" , 0 , tData(7) )
		
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "BOND_INVT_ABLE_YN" , 0 , tData(10) )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "FUND_YN" , 0 , tData(11) )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_017a", "InBlock1", "MMW_INVT_YN" , 0 , tData(12) )
		
		'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
		
		DATAMANAGER.RequestTranData( "obwat_ctad_013a" )
		
	end if
End Sub

Sub f_SetInit()
	cont.btnInvt.visible = true
	cont.lblTitle0.visible = true
	cont.lblTitle1.visible = true
	cont.lblTitle2.visible = false	'v0005
	cont.lblText0.visible = true
	cont.lblText1.visible = true
	cont.lblText2.visible = true
	cont.lblText3.visible = true
	cont.lblText4.visible = true
	cont.lblText5.visible = false	'v0005
	cont.lblText6.visible = false	'v0005
	
	cont.btnSwitch0.switchindex = 0
	cont.btnSwitch1.switchindex = 0
	cont.btnSwitch2.switchindex = 0
	cont.btnSwitch3.switchindex = 0
	cont.btnSwitch4.switchindex = 0
	'cont.btnSwitch5.switchindex = 0	'v0005
	
	cont.btnSwitch0.visible = true
	cont.btnSwitch1.visible = true
	cont.btnSwitch2.visible = true
	cont.btnSwitch3.visible = true
	cont.btnSwitch4.visible = true
	cont.btnSwitch5.visible = false	'v0005
	cont.btnSwitch6.visible = false	'v0005
	
	cont.cmbRate.visible = false
	cont.lblRate.visible = false
	cont.lblRateText.visible = false
	cont.cmbRate.currentindex = 0
	
	cont.btnSwitch1.enable = true
	cont.cmbRate.enable = true
	
	cont.edtGoal.left = 400
	cont.lblGoal.left = 400
	cont.edtLoss.left = 400
	cont.lblLoss.left = 400
	cont.edtGoal.caption = ""
	cont.edtLoss.caption = ""
	
	cont.imgToolTip0.visible = true
	cont.imgToolTip1.visible = true
	cont.imgToolTip2.visible = true
	
	cont.Image0.visible = true
	cont.lblbtn.visible = true
	cont.btnInvt.visible = true
	cont.lblBlank.visible = true
	cont.btnTrans.visible = true
	
'	f_SetTop0(false)
End Sub

Sub f_SetClear()
	g_bRequest = false
	
	cont.btnInvt.visible = false
	cont.lblTitle0.visible = false
	cont.lblTitle1.visible = false
	'cont.lblTitle2.visible = false
	cont.lblText0.visible = false
	cont.lblText1.visible = false
	cont.lblText2.visible = false
	cont.lblText3.visible = false
	cont.lblText4.visible = false
	'cont.lblText5.visible = false
	'cont.lblText6.visible = false
	cont.btnSwitch0.visible = false
	cont.btnSwitch1.visible = false
	cont.btnSwitch2.visible = false
	cont.btnSwitch3.visible = false
	cont.btnSwitch4.visible = false
	'cont.btnSwitch5.visible = false
	'cont.btnSwitch6.visible = false
	cont.cmbRate.visible = false
	cont.lblRate.visible = false
	cont.lblRateText.visible = false
	cont.edtGoal.left = 400
	cont.lblGoal.left = 400
	cont.edtLoss.left = 400
	cont.lblLoss.left = 400
	cont.imgToolTip0.visible = false
	cont.imgToolTip1.visible = false
	cont.imgToolTip2.visible = false
	
	cont.Image0.visible = false
	cont.lblbtn.visible = false
	cont.btnInvt.visible = false
	cont.lblBlank.visible = false
	cont.btnTrans.visible = false
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_ctad_023r" then
		sWA_PRCD = DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "WA_PRCD" , 0 )
		
		DATAMANAGER.SetDataValue( 0, "obwat_pdad_065r", "InBlock1", "WA_PRCD" , 0 , sWA_PRCD )
		
		DATAMANAGER.SetDataValue( 0, "obwat_csad_003r", "InBlock1", "WA_PRCD" , 0 , sWA_PRCD )
		DATAMANAGER.SetDataValue( 0, "obwat_csad_003r", "InBlock1", "PROS_CLS_CODE" , 0 , "2" )
		DATAMANAGER.RequestTranData( "obwat_csad_003r" )
		
	elseif szTranID == "obwat_csad_003r" then
		g_zDrvtCnt = DATAMANAGER.GetDataValue( 0, "obwat_csad_003r", "OutBlock2", "WA_VLTN_AMT" , 0 )
		g_aWA_OTCM_PAY_TPCD = DATAMANAGER.GetDataValue( 0, "obwat_csad_003r", "OutBlock1", "WA_OTCM_PAY_TPCD" , 0 ) '성과보수유형코드
		
		g_sInvtEnableYN = ""
		
		sLOAN_ABLE_YN = DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "LOAN_ABLE_YN" , 0 ) '신용사용여부
		
		
		if sLOAN_ABLE_YN == "Y" then
			cont.btnSwitch1.switchindex = 1
			sCRDT_GVNG_AMT_RATE = DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "CRDT_GVNG_AMT_RATE" , 0 ) '신용공여금액비율

			cont.cmbRate.cbkeydata = tonumber(sCRDT_GVNG_AMT_RATE) * 100
			cont.cmbRate.visible = true
			cont.lblRate.visible = true
			cont.lblRateText.visible = true
			
			cont.lblRate.caption = cont.cmbRate.caption
			
			f_SetTop0(true)
		else
			f_SetTop0(false)
		end if
		
		sSTCK_CNTG_BRKD_SNDN_APLT_YN = DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "STCK_CNTG_BRKD_SNDN_APLT_YN" , 0 ) '주식체결내역 통보여부
		sMNTL_ERT_INFR_YN = DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "MNTL_ERT_INFR_YN" , 0 ) '월간수익율통보여부
		
		'if sSTCK_CNTG_BRKD_SNDN_APLT_YN == "Y" then
			'cont.btnSwitch5.switchindex = 1
		'end if
		
		'if sMNTL_ERT_INFR_YN == "Y" then
			'cont.btnSwitch6.switchindex = 1
		'end if

		DATAMANAGER.RequestTranData( "obwat_ctad_016r" )
		
		sWA_CNRC_EXTS_YN		= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "WA_CNRC_EXTS_YN" , 0 )
		sSNML_INAG_TYPE_CODE	= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "SNML_INAG_TYPE_CODE" , 0 )
		sLNKD_ACNO			= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "LNKD_ACNO" , 0 )
		sLNKD_ASNO			= DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "LNKD_ASNO" , 0 )
		
		sWA_MGRI_EMPNO = DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "WA_MGRI_EMPNO" , 0 )
		sRCMD_EMPNO = DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "RCMD_EMPNO" , 0 )
		sMNGR_EMPNO = DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "MNGR_EMPNO" , 0 )
		sASET_RE_DSTR_PRIR_NTFY_CLCD = DATAMANAGER.GetDataValue( 0, "obwat_ctad_023r", "OutBlock1", "ASET_RE_DSTR_PRIR_NTFY_CLCD" , 0 )
		
