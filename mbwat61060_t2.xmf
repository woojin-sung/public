			cont.btnSwitch3.switchindex = 1
		end if
		
		if (sWA_GOAL_ERT <> null and sWA_GOAL_ERT <> "" and Cdbl(sWA_GOAL_ERT) <> 0 ) or (sLOSS_LIMT_RATE <> null and sLOSS_LIMT_RATE <> "" and Cdbl(sLOSS_LIMT_RATE) <> 0 ) then
			cont.btnSwitch4.switchindex = 1
