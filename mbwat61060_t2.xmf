'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg

	if szTranID == "obwat_ctad_013a" then
		sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.MsgBox( "알림", "서비스신청이 불가합니다.\n" & sSubmsg, "", 0 )
	elseif szTranID == "obwat_ctad_017a" then
		sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.MsgBox( "알림", "서비스신청이 불가합니다.\n" & sSubmsg, "", 0 )
	end if
End Sub

'============================================================================
Sub cont_btnSwitch1_OnClick()
	Dim bVisible
	bVisible = false
	
	if cont.btnSwitch1.switchindex == "1" then
		bVisible = true
	else
		cont.cmbRate.cbkeydata = 100
		cont.lblRate.caption = ""
	end if
	
	cont.cmbRate.visible = bVisible
	cont.lblRate.visible = bVisible
	cont.lblRateText.visible = bVisible
	
	f_SetTop0(bVisible)
End Sub

Sub f_SetTop0(bFlag)
	Dim nTop
	nTop = 142
	
	if bFlag then
		nTop = 177
	end if
	
	cont.btnSwitch2.top = nTop + 4
	cont.imgToolTip0.top = nTop +5
	cont.lblText2.top = nTop + 4
	nTop = nTop + 33
	cont.btnSwitch3.top = nTop + 4
	cont.imgToolTip1.top = nTop +5
	cont.lblText3.top = nTop + 4
	nTop = nTop + 33
	cont.btnSwitch4.top = nTop + 4
	cont.imgToolTip2.top = nTop +4
	cont.lblText4.top = nTop + 4
	cont.edtGoal.top = nTop + 33
	cont.lblGoal.top = nTop + 34
	cont.edtLoss.top = nTop + 33
	cont.lblLoss.top = nTop + 34
	
	nTop = nTop + 48
	
	if cont.btnSwitch4.switchindex == "1" then
		nTop = nTop + 45
	end if
	
	'cont.lblTitle2.top = nTop
	nTop = nTop + 26
	'cont.btnSwitch5.top = nTop + 4
	'cont.lblText5.top = nTop + 4
	nTop = nTop + 33
	'cont.btnSwitch6.top = nTop + 4
	'cont.lblText6.top = nTop + 4
	
	cont.btnSwitch2.enable = false
End Sub

'============================================================================
Sub cont_btnSwitch4_OnClick()
	f_ClickButton4()
End Sub

'============================================================================
Sub f_ClickButton4()
	Dim bVisible
	bVisible = false
	
	if cont.btnSwitch4.switchindex == "1" then
		bVisible = true
	else
		cont.edtGoal.caption = ""
		cont.edtLoss.caption = ""
	end if
	
	if bVisible then
		cont.edtGoal.left = 22
		cont.lblGoal.left = 22
		cont.edtLoss.left = 193
		cont.lblLoss.left = 193
	else
		cont.edtGoal.left = 400
		cont.lblGoal.left = 400
		cont.edtLoss.left = 400
		cont.lblLoss.left = 400
	end if
	
	f_SetTop1(bVisible)
End Sub

Sub f_SetTop1(bFlag)
	Dim nTop
	nTop = 256
	
	if bFlag then
		nTop = nTop + 45
	end if
	
	if cont.btnSwitch1.switchindex == "1" then
		nTop = nTop + 35
	end if
	
	'cont.lblTitle2.top = nTop
	nTop = nTop + 26
	'cont.btnSwitch5.top = nTop + 4
	'cont.lblText5.top = nTop + 4
	nTop = nTop + 33
	'cont.btnSwitch6.top = nTop + 4
	'cont.lblText6.top = nTop + 4
End Sub

' 변경
'============================================================================
Sub cont_btnTrans_OnClick()
	if (g_bRequest) then
		Dim bRequestFlag
		bRequestFlag = false
		
		if g_sInvtYN == null or g_sInvtYN == "" then
			Form.MsgBox("알림", "운용상품을 확인해주세요.", "", 8, "확인", "")
		else
			if cont.btnSwitch4.switchindex == "1" then
				if cont.edtGoal.caption == "" or tonumber(cont.edtGoal.caption) == 0 then
					Form.MsgBox("알림", "목표수익률을 입력해주세요.", "", 8, "확인", "")
				elseif cont.edtLoss.caption == "" or tonumber(cont.edtLoss.caption) == 0 then
					Form.MsgBox("알림", "손절수익률을 입력해주세요.", "", 8, "확인", "")
				else
					bRequestFlag = true
				end if
			else
				bRequestFlag = true
			end if
		end if
		
		if bRequestFlag then
			sWA_ACNO = DATAMANAGER.GetDataValue( 0, "obwat_ctad_013a", "InBlock1", "WA_ACNO" , 0 )
			sWA_CNRC_NO = DATAMANAGER.GetDataValue( 0, "obwat_ctad_013a", "InBlock1", "WA_CNRC_NO" , 0 )
			
			if sWA_ACNO == null or sWA_ACNO == "" or sWA_CNRC_NO == null or sWA_CNRC_NO == "" then
				Exit Sub
			end if
			
			Form.triggerEvent("#", "PwCheck", "")
		end if
	else
		Form.MsgBox("알림", "계약번호를 선택해주세요.", "", 8, "확인", "")
	end if
End Sub

'============================================================================
Sub cont_imgToolTip0_OnClick()
	Dim sText
	sText = "관리종목이란?\n증권거래소가 유가증권 상장 규정에 의거 상장폐지 기준에 해당되는 종목 가운데 특별히 지정한 종목으로, 관리종목은 랩 운용종목에서 제외됩니다."
	cont.imgToolTip0.openToolTip( sText, 320, 110, 1 )
End Sub

'============================================================================
Sub cont_imgToolTip1_OnClick()
	Dim sText
	sText = "고객님의 회사 및 이해관계인이 발행한 증권에 운용 허용 여부를 선택해주세요."
	cont.imgToolTip1.openToolTip( sText, 280, 60, 1 )
End Sub

'============================================================================
Sub cont_imgToolTip2_OnClick()
	Dim sText
	sText = "지정하신 수익률 도달시\nSMS로 통보해 드려요."
	cont.imgToolTip2.openToolTip( sText, 180, 60, 1 )
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	cont.imgToolTip0.setMaintainingRatio("1")
	cont.imgToolTip1.setMaintainingRatio("1")
	cont.imgToolTip2.setMaintainingRatio("1")
End Sub

'============================================================================
Sub cont_cmbRate_OnEditComplete(iIndex)
	cont.lblRateText.visible = false
	cont.lblRate.visible = false
End Sub

