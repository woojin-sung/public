	<SCRIPT_INFO _len="2486" _ulen="2330" >
' 수    정  2022. 12. 12. 김인택 v002 채권대여 추가 

Dim g_tData
Dim g_szCode

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		
		'종목명, 평가금액, 평가손익, 수익률, 잔고구분, 잔고수량, 매입단가, 매수일, 만기일, 대출금, 대출일, 대출만기일
		g_tData = Split(szOpenData, "☆")
		
		lblName.caption = g_tData[0]
			
		tbl0.SetCellString(0, 2, g_tData[1])
		
		'평가손익, 수익률 마스킹 처리
		If CDbl(g_tData[2]) > 0 Then
			tbl1.SetCellString(0, 1, "+" & FormatNumber(g_tData[2], 0))
			tbl1.SetCellFgColor(0, 1, "1")
		ElseIf CDbl(g_tData[2]) < 0 Then	
			tbl1.SetCellString(0, 1, FormatNumber(g_tData[2], 0))
			tbl1.SetCellFgColor(0, 1, "2")
		Else
			tbl1.SetCellString(0, 1, FormatNumber(g_tData[2], 0))
		End If
		
		If CDbl(g_tData[3]) > 0 Then
			tbl1.SetCellString(1, 1, "+" & FormatNumber(g_tData[3], 2))
			tbl1.SetCellFgColor(1, 1, "1")
		ElseIf CDbl(g_tData[3]) < 0 Then	
			tbl1.SetCellString(1, 1, FormatNumber(g_tData[3], 2))
			tbl1.SetCellFgColor(1, 1, "2")
		Else
			tbl1.SetCellString(1, 1, FormatNumber(g_tData[3], 2))
		End If
'		tbl1.SetCellString(1, 1, g_tData[3])
		
		
		tbl3.SetCellString(0, 1, g_tData[4])
		tbl3.SetCellString(1, 1, g_tData[5])
		tbl3.SetCellString(2, 1, g_tData[6])
		
		'20230925 현재가, 기준가 추가
		if CInt(g_tData[12]) == 0 then
			tbl3.SetCellString(3, 1, "-")
		else
			'tbl3.SetCellString(3, 1, FormatNumber(g_tData[12], 2) .. "원")
			tbl3.SetCellString(3, 1, g_tData[12] .. "원")
		end if
		
		tbl3.SetCellString(4, 1, g_tData[7])
		tbl3.SetCellString(5, 1, g_tData[8])
		
		If CInt(g_tData[9]) <> 0 Then
			tbl2.SetCellString(0, 1, FormatNumber(g_tData[9], 0) & "원")
			tbl2.SetCellString(1, 1, g_tData[10])
			tbl2.SetCellString(2, 1, g_tData[11])
		Elseif g_tData[10] <> "" then 'v002
			tbl2.SetCellString(0, 1, "-")
			tbl2.SetCellString(1, 1, g_tData[10])
			tbl2.SetCellString(2, 1, "-")
		Else
			tbl2.SetCellString(0, 1, "-")
			tbl2.SetCellString(1, 1, "-")
			tbl2.SetCellString(2, 1, "-")
		End If
	End If
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
