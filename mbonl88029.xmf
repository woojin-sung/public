'============================================================================
' 슈퍼365 수익금 확인하기
'============================================================================
' 2023.03.07 v001. 슈퍼365 대여수익 관련 항목 추가 / 팝업은 주석처리
' 2023.06.22 v002. 기간조회 팝업 예상수익포함여부 값 수정
' 2023.08.07. 김유경 v003. URL 링크 접속 추가에 따른 수정
'============================================================================
Dim g_PrdCd
Dim g_StaDate
Dim g_FinDate
Dim g_PsntDate
'v001
Dim g_LndnStplYN		'리테일대차
Dim g_LndnFeeYN		'Y : 포함하여 조회, N : 미포함하여 조회, default = N
Dim g_HldnStckStplYN	'보유주식서비스

'v002
Dim g_AplyYN           'default = N

Dim g_szOpenData		'v003

'============================================================================
Sub Form_OnFormInitBefore()
	ContNoAcct.Image1.setMaintainingRatio("1")
	ContAcct.imgArrow.setMaintainingRatio("1")
	ContAcct.imgWonArrow.setMaintainingRatio("1")
	ContAcct.imgUsdArrow.setMaintainingRatio("1")
	ContAcct.imgLndnArrow.setMaintainingRatio("1")
	'위치조정
	ContAcct.lblFeeCdName.setNeighborCtlPos("imgArrow","right",5,"")
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_LndnFeeYN = "N"
	g_AplyYN = "N"
	
	f_Init()
End Sub

'============================================================================
Sub cmbAccount_ChangeAccount()
	f_Init()
End Sub

'============================================================================
Function f_Init()
	szTheme = Form.GetEnvData("common.theme")
	'v001
	BtnLndnControl(false)
	
	If szTheme == "white" Then	
		ContAcct.imgBG.visible = true
		ContNoAcct.image0.visible = true
	
		ContAcct.lblTopBg.visible = false
		ContNoAcct.lblTopBg2.visible = false
		
		ContAcct.imgWon.imgpath = "img_bgbox.9.png"
		ContAcct.imgUsd.imgpath = "img_bgbox.9.png"
	else	'black		''' mbonl88031 , mbonl87051_p2 : 색상 참고..
		ContAcct.imgBG.visible = false
		ContNoAcct.image0.visible = false
		
		ContAcct.lblTopBg.visible = true
		ContNoAcct.lblTopBg2.visible = true
		
		ContAcct.lblTopBg.bgcolor = "144"
		ContNoAcct.lblTopBg2.bgcolor = "144"
		
		ContAcct.imgWon.imgpath = "img_bg.9.png"
		ContAcct.imgUsd.imgpath = "img_bg.9.png"		
	end if
	
	if cmbAccount.itemcodetype = "200" then
		'슈퍼365 계좌 있는 경우
		ContAcct.visible = true
		ContNoAcct.visible = false
		
		f_SetInit()
		ContAcct.lblName.caption = Form.GetSharedData( "&USER_NAME", false ) .."님"

		g_PrdCd = "1"
		
		tmp_date = LEFT(ContAcct.CalPsntDate.caption,4) & "-" & RIGHT(LEFT(ContAcct.CalPsntDate.caption,6),2) & "-" & RIGHT(ContAcct.CalPsntDate.caption,2)
		tmpPrd1month = CStr(DateAdd("d",0,DateAdd("m",-1,CDate(CStr(tmp_date)))))
		tmpPrd1month = Replace(tmpPrd1month, "-", "")

		g_StaDate = tmpPrd1month
		g_FinDate = ContAcct.CalPsntDate.caption

		f_SetFlag()
		g_LndnStplYN = "N"
		g_HldnStckStplYN = "N"
		'계좌 체크
		if cmbAccount.caption <> "" and cmbAccount.caption <> null then 
			
			'v003 sta
			'DATAMANAGER.RequestTranData("obsav_bsop_322r") '수익금조회
			g_szOpenData = Form.GetOpenLinkData()
			if g_szOpenData <> "" then
				Form.SetTimerEvent2(2, 1, 1)
			Else 
				DATAMANAGER.RequestTranData("obsav_bsop_322r") '수익금조회
			End If
			'v003 fin
		end if
		
	else
'		'슈퍼365 계좌 없는 경우
		ContAcct.visible = false
		ContNoAcct.visible = true
		
		ContNoAcct.lblText2.caption = "Super365계좌 개설하러 가기 >"
		ContNoAcct.lblText2.fgcolor = "67"	'슈퍼365계좌 개설하러 가기
	end if
End Function

'============================================================================
Function f_SetInit()
	'수익금 합산
	ContAcct.lblAmt.caption = ""	'초기화
	ContAcct.lblAmt.fontsize = 27
	ContAcct.lblAmt.fgcolor  = 290
	
	ContAcct.lblWonAmt.caption = ""
	ContAcct.lblUsdAmt.caption = ""
	ContAcct.lblUsdAmt2.caption = ""	
End Function

'============================================================================
Function f_SetFlag()
	Dim tCodeName1
	Dim sStaDate, sFinDate
	
	if g_PrdCd == "1" then
		tCodeName1 = "1개월"		
		ContAcct.imgArrow.left = 215
	elseif g_PrdCd == "2" then		
		tCodeName1 = "3개월"
		ContAcct.imgArrow.left = 215
	elseif g_PrdCd == "3" then				
		sStaDate = Mid(g_StaDate,3,2) & "." & Mid(g_StaDate,5,2) & "." & Right(g_StaDate,2)
		sFinDate = Mid(g_FinDate,3,2) & "." & Mid(g_FinDate,5,2) & "." & Right(g_FinDate,2)

		tCodeName1 = sStaDate&" ~ "&sFinDate
		
		ContAcct.imgArrow.left = 285
	else 
		tCodeName1 = ""
	end if
	
	ContAcct.lblFeeCdName.caption = tCodeName1
End Function

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obsav_bsop_322r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"	 		, 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 	  		, 0 , cmbAccount.sequence)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STA_DATE" 		, 0 , g_StaDate)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FIN_DATE" 		, 0 , g_FinDate)
	'v001
'	elseif szTranID == "obpds_srvc_423r" then
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE"      , 0 , "1")
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD"               , 0 , "068")
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_MANG_UNIT_CODE" , 0 , "03")
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"               , 0 , cmbAccount.total)
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"               , 0 , cmbAccount.sequence)
	elseif szTranID == "oblon_lndn_050r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"      , 0 , g_LndnFeeYN)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STA_DATE"           , 0 , g_StaDate)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FIN_DATE"           , 0 , g_FinDate)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"               , 0 , cmbAccount.total)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"               , 0 , cmbAccount.sequence)
	end if
End Sub	

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obsav_bsop_322r" then
		dim nStaOffset
		dim nTotal, nWonAmt, nUsdAmt, nUsdExAmt
		
		nTotal = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "WNCR_AMT", 0)  '전체금액		
		nWonAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2", "WNCR_AMT", 0)  '원화RP자동투자수익		
		nUsdAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3", "FRCR_AMT", 0)  '외화RP자동투자수익
		nUsdExAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3", "WNCR_AMT", 0)  '외화RP - 원화환산금액		

		ContAcct.lblFee.caption = CLng(nTotal)
		ContAcct.lblAmt.caption = ContAcct.lblFee.dispcaption&" 원"		
		nStaOffset = ContAcct.lblAmt.getLen(ContAcct.lblAmt.caption) -2		
		
		ContAcct.lblAmt.changeTextAttr(nStaOffset, 2, 290, 5, true)
		ContAcct.lblWonAmt.caption = nWonAmt
		ContAcct.lblUsdAmt.caption = nUsdAmt
		ContAcct.lblUsdAmt2.caption = nUsdExAmt
		
		'v001
		'DATAMANAGER.RequestTranData("obpds_srvc_423r") '서비스약정내역 조회
		DATAMANAGER.RequestTranData("oblon_lndn_050r")
	'v001
'	elseif szTranID == "obpds_srvc_423r" then
'		StplStatCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "STPL_STAT_CLS_CODE", 0)
'		if Trim(StplStatCode) == "01" then
'			g_LndnStplYN = "Y"
'		else
'			g_LndnStplYN = "N"
'		end if
'		
'		DATAMANAGER.RequestTranData("oblon_lndn_050r")
	elseif szTranID == "oblon_lndn_050r" then
		tmpLen = ContAcct.lblAmt.getLen(ContAcct.lblAmt.caption) -2
		tmpStr = Left(ContAcct.lblAmt.caption, tmpLen)
		tmpAmt = CLng(Replace(tmpStr, ",", ""))
		g_LndnStplYN 	   = DATAMANAGER.GetDataValue(0, "oblon_lndn_050r", "OutBlock4", "STPL_YN" , 0)
		g_HldnStckStplYN = DATAMANAGER.GetDataValue(0, "oblon_lndn_050r", "OutBlock5", "STPL_YN" , 0)
		g_AplyYN         = DATAMANAGER.GetDataValue(0, "oblon_lndn_050r", "OutBlock4", "APLY_YN" , 0)
		
		dim nStaOffset
		dim nTotal, nLndnStckAmt, nLndnBondAmt
		
		nTotal       = CLng(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TOTAL_FEE" , 0))
		nLndnStckAmt = CLng(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "STCK_FEE"  , 0))
		nLndnBondAmt = CLng(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "BOND_FEE"  , 0))
		
		ContAcct.lblFee.caption = tmpAmt + nTotal
		ContAcct.lblAmt.caption = ContAcct.lblFee.dispcaption&" 원"
		nStaOffset = ContAcct.lblAmt.getLen(ContAcct.lblAmt.caption) -2
		
		ContAcct.lblAmt.changeTextAttr(nStaOffset, 2, 290, 5, true)
		ContAcct.lblLndnAmt.caption  = nTotal
		ContAcct.lblLndnAmt2.caption = nLndnStckAmt
		ContAcct.lblLndnAmt3.caption = nLndnBondAmt
		
		'v001
		'대차약정 & 수익있음 = 수익란 보임
		'대차약정 & 수익없음 = 수익란 보임
		'대차미약정 & 수익있음 = 수익란 보임
		'대차이먁정 & 수익없음 = 수익란 안보임
		if g_LndnStplYN == "Y" and nTotal > 0 then
			BtnLndnControl(true)
		elseif g_LndnStplYN == "Y" and nTotal <= 0 then
			BtnLndnControl(true)
		elseif g_LndnStplYN == "N" and nTotal > 0 then
			BtnLndnControl(true)
		elseif g_LndnStplYN == "N" and nTotal <= 0 then
			BtnLndnControl(false)
		else
			BtnLndnControl(false)
		end if

		' 광고기간 2024.04.06 까지 ---------------------------------------------
		Dim sDate
		sDate = Form.GetSharedData("&HOST_DATE", False)
		
		if Len(sDate) == 8 then

			if CInt(sDate) <= 20240406 then
				Dim sOpenYN
				sOpenYN = Form.LoadConfigData("NoticeSetting", "mbonl88029_p5")
		
				if sOpenYN <> "1" then
				
					' 대차중개 미약정일 경우 팝업 open
					if g_LndnStplYN == "N" and Form.GetSharedData("mbonl88029_p5", false) <> "1" then
						Form.OpenPopupAnimation("mbonl88029_p5", "", "", "2")
						Form.SetSharedData("mbonl88029_p5", "1")
					end if
					
				end if
			end if
			
		end if
		' 광고기간 2024.04.06 까지 ---------------------------------------------

	end if
	
End Sub

'============================================================================
'TR오류시..
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "안내" , szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "안내" , szErrMsg)
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'상단 유의사항 아이콘 클릭 이벤트
	if sEventName == "INFO_CLICK" Then
		Form.OpenPopup("mbonl88029_p1" , "" , "")
	End If	
End Sub

'============================================================================
' 기간 및 수수료구분 선택팝업창 띄움
'============================================================================
Sub ContAcct_lblFeeCdName_OnClick()
	'v001 항목 추가
	dim sSendData
	sSendData = g_PrdCd&"★"&g_StaDate&"★"&g_FinDate&"★"&g_AplyYN&"★"&g_LndnFeeYN
	
	Form.openPopupAnimation("mbonl88029_p2", sSendData,"","2")	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "mbonl88029_p2" then
		if sRet <> "" and sRet <> null then
			Dim tData
			tData = Split(sRet, "★")

			g_PrdCd    = tData(0)		'1:1개월 2:3개월 3:직접입력
			g_StaDate  = tData(1)
			g_FinDate  = tData(2)
			g_LndnFeeYN= tData(3)
				
			f_SetInit()
			f_SetFlag()
			
			DATAMANAGER.RequestTranData("obsav_bsop_322r") '수익금조회
		end if
	end if
End Sub

'============================================================================
Sub ContAcct_BtnWon_OnClick()
	dim sSendData
	sSendData = cmbAccount.total&"★"&cmbAccount.sequence&"★"&g_StaDate&"★"&g_FinDate&"★1"&"★"&""&"★"&ContAcct.lblFeeCdName.caption
	
	'v001
	'Form.openPopupAnimation("mbonl88029_p3", sSendData, "","2")
	'Form.openPopup("mbonl88029_p4", sSendData, "")
