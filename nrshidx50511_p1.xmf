				<IMAGE name="imgFilterCHN" autosize="1" imgpath="btn_line2_n.9" ly_vert="20,75,105,35,1" />
				<LABEL name="LabelCHN" fontsize="-2" caption="중국" halign="1" autofontsize="1" ly_vert="20,75,105,35,1" />
				<IMAGE name="imgFilterHK" autosize="1" imgpath="btn_line2_n.9" ly_vert="135,75,105,35,1" />
				<LABEL name="LabelHK" fontsize="-2" caption="홍콩" halign="1" autofontsize="1" ly_vert="135,75,105,35,1" />
				<IMAGE name="imgFilterUSA" autosize="1" imgpath="btn_line2_n.9" ly_vert="250,30,105,35,1" />
				<LABEL name="LabelUSA" fontsize="-2" caption="미국" halign="1" autofontsize="1" ly_vert="250,30,105,35,1" />
				<IMAGE name="imgFilterJP" autosize="1" imgpath="btn_line2_n.9" ly_vert="250,76,105,35,1" />
				<LABEL name="LabelJP" fontsize="-2" caption="일본" halign="1" autofontsize="1" ly_vert="250,76,105,35,1" />
			</CONTROL_INFO>
		</CONTAINER>
		<CONTAINER name="contPeriod" ly_vert="0,550,375,130,1" scroll_ly_vert="0,550,375,130,1" >
			<CONTROL_INFO>
				<LABEL name="LabelDate" fontstyle="01" caption="조회기간" paddinginfo="1,0,0,0" ly_vert="18,3,200,20,1" />
				<RADIOGROUP name="RgDateType" fontsize="-2" buttonshape="1" buttonsnumber="4" ly_vert="18,33,335,44,1" >
					<RADIO_INFO>
						<RADIO no="0" text="당일" radioimage="input_06.9.png" transfervalue="01" position="0,0,80,35" />
						<RADIO no="1" text="1개월" radioimage="input_06.9.png" transfervalue="02" position="85,0,80,35" />
						<RADIO no="2" text="3개월" radioimage="input_06.9.png" transfervalue="03" position="170,0,80,35" />
						<RADIO no="3" text="직접입력" radioimage="input_06.9.png" transfervalue="04" position="255,0,80,35" />
					</RADIO_INFO>
				</RADIOGROUP>
				<CALENDAR name="cldFromDate" fontsize="-2" dispmode="65537" eventtr="ohhts_1081_002r" ly_vert="18,84,150,35,1" />
				<CALENDAR name="cldToDate" fontsize="-2" dispmode="1398757700" eventtr="ohhts_1081_002r" ly_vert="203,84,150,35,1" />
				<LABEL name="Label8" fontsize="-2" caption="~" halign="1" ly_vert="178,81,16,44,1" />
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="16760" _ulen="14764" >
Dim optionNationTable(),optionNationCtlTable()
Dim optionPeriodIndex,optionFromDate,optionToDate
Dim optionSearchGubun

'전체/국내/미국/중국/홍콩/일본
optionNationTable = {"Y","N","N","N","N","N"} 
optionNationCtlTable = {"contNation.imgFilterAll","contNation.imgFilterKo","contNation.imgFilterUSA","contNation.imgFilterCHN","contNation.imgFilterHK","contNation.imgFilterJP"}

'============================================================================
Sub Form_OnFormInitBefore()

	'디폴트값(전체/당일날짜/당일날짜)
	optionPeriodIndex =  0
	optionFromDate	=  Left(Form.calcDateTime( nYear, nMonth, nDay, nHour, nMinute, nSecond ), 8) '20240315
	optionToDate 		=  Left(Form.calcDateTime( nYear, nMonth, nDay, nHour, nMinute, nSecond ), 8)
	
	optionSearchGubun  = 0
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	szLinkData = Form.GetOpenLinkData()
	
	if szLinkData <> "" then
	
		'국가선택값★조회기간인덱스★From일자★To일자★조회구분 인덱스(거래량/시가총액...)
		'EX) N@Y@Y@Y@Y@N★1★20240224★20240227
		
		arrData = Split(szLinkData,"★")
		
		if #arrData < 3 then
			
			SetDefaultOption()
			SelectNationOption()
			SelectPeriodOption()
			
		else
		
			arrNationSelect = Split(arrData(0),"@")
			for i = 0 to #arrNationSelect - 1 
				if arrNationSelect(i) == "Y" then
					Change_optionNationTable(i)
				end if
			next
			
			optionPeriodIndex = arrData(1)
			optionFromDate = arrData(2)
			optionToDate = arrData(3)
			optionSearchGubun = arrData(4)
			
			ChangeContType(optionSearchGubun)
			SelectNationOption()
			SelectPeriodOption()
		
		end if
	
	else
		
		'화면링크데이터가 없으면 디폴트 데이터값 설정
		SetDefaultOption()
		
		'설정된 디폴트 값으로 조회구분 세팅(국가/기간)
		SelectNationOption()
		SelectPeriodOption()
	
	end if
	

End Sub
