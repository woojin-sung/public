'============================================================================
' 조회기간(From 날짜) 직접입력 시
'============================================================================
Sub contPeriod_cldFromDate_OnEditComplete()
	
	'To일자
	sToDate = contPeriod.cldToDate.caption
	
	'To일로부터 1년전 날짜
	sMinDate = CalcDate("To","m",-12)
	
	'사용자 선택날짜
	sSelectDate = contPeriod.cldFromDate.caption
	
	'사용자가 선택한 From일자가 
	'[To일자 이후 이거나], [To일로부터 1년 전이면] 알림창
	if sSelectDate > sToDate then
		
		contPeriod.cldFromDate.caption = sToDate
		optionFromDate = sToDate
		
		Form.ShowAlert("알림", "시작일이 종료일 이후입니다.")
	
	elseif sSelectDate < sMinDate then
		contPeriod.cldFromDate.caption = sMinDate
		optionFromDate = sMinDate
		
		Form.ShowAlert("알림", "조회기간은 최대 1년만 가능합니다.")
		
	else
		optionFromDate = contPeriod.cldFromDate.caption
	end if
	
End Sub

'============================================================================
' 조회기간(To 날짜) 직접 입력 시
'============================================================================
Sub contPeriod_cldToDate_OnEditComplete()
	
	'From일자
	sFromDate = contPeriod.cldFromDate.caption
	
	'전일날짜
	sExDate = Left(Form.calcDateTime( nYear, nMonth, -1, nHour, nMinute, nSecond ), 8)

	'From일로부터 1년후 날짜
	sMaxDate = CalcDate("From","m",12)
	
	'사용자 선택날짜
	sSelectDate = contPeriod.cldToDate.caption
	
	
	'사용자가 선택한 To일자가 
	'[From일자 이전이거나],[전일날짜 이후 이거나], [From일로부터 1년 이후 이면] 알림창
	if sSelectDate < sFromDate then
		
		contPeriod.cldToDate.caption = sFromDate
		optionToDate = sFromDate
		
		Form.ShowAlert("알림", "종료일이 시작일 이전입니다.")
	
	elseif sSelectDate > sExDate then
		
		contPeriod.cldToDate.caption = sExDate
		optionToDate = sExDate
		
		Form.ShowAlert("알림", "종료일은 전일자 까지만 선택 가능합니다.")
	
	elseif sSelectDate > sMaxDate then
		
		contPeriod.cldToDate.caption = sMaxDate
		optionToDate = sMaxDate
		
		Form.ShowAlert("알림", "조회기간은 최대 1년만 가능합니다.")
		
	else
		optionToDate = contPeriod.cldToDate.caption
	end if
	
End Sub

'============================================================================
'
'============================================================================
Sub contNation_imgFilterJP_OnClick()
	Change_optionNationTable(5)
	SelectNationOption()
End Sub

'============================================================================
' 초기화 버튼 클릭이벤트
'============================================================================
Sub btnReset_OnClick()

	SetDefaultOption()
	SelectNationOption()
	SelectPeriodOption()
	
	
End Sub
'============================================================================
' 검색버튼 클릭이벤트(조회조건 설정 리턴)
'============================================================================
Sub btnOk_OnClick()

	sRsltNationOption = ""
	sRsltPeriodOption = ""
	
	
	for i = 0 to #optionNationTable -1
		if i == 0 then
			sRsltNationOption = optionNationTable[i]
		else
			sRsltNationOption = sRsltNationOption .. "@" .. optionNationTable[i]
		end if
	next
	
	'(예외처리) 조회기간 직접선택인 경우에는 캘린더에 선택된 값을 직접 가져간다.
	if optionPeriodIndex == 3 or optionPeriodIndex == "3" then
		sFromDate = contPeriod.cldFromDate.caption
		sToDate = contPeriod.cldToDate.caption
		sRsltPeriodOption = optionPeriodIndex.. "★" .. sFromDate .. "★" .. sToDate
	else
		sRsltPeriodOption = optionPeriodIndex.. "★" .. optionFromDate .. "★" .. optionToDate
	end if
	
	'국가구분★조회기간인덱스★From일★To일
	'Form.ShowAlert("FILTER_SET_COMPLETE", sRsltNationOption.."★"..sRsltPeriodOption)
	Form.SendReturnToParent("FILTER_SET_COMPLETE" , sRsltNationOption.."★"..sRsltPeriodOption)
	Form.CloseForm()
	
End Sub
'============================================================================
' 닫기버튼 클릭이벤트
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
' 조회조건(국가/기간) 디폴트값 설정
'============================================================================
Function SetDefaultOption()

	'조회국가 디폴트값 설정(전체)
	for i = 0 to #optionNationTable -1
		if i == 0 then
			optionNationTable[i] = "Y"
		else
			optionNationTable[i] = "N"
		end if	 
	next
	
	'조회기간 디폴트값 설정(당일)
	optionPeriodIndex = 0
	optionFromDate	= Left(Form.calcDateTime( nYear, nMonth, nDay, nHour, nMinute, nSecond ), 8) '20240315
	optionToDate 		= Left(Form.calcDateTime( nYear, nMonth, nDay, nHour, nMinute, nSecond ), 8)
	
	
End Function

'============================================================================
' 조회조건(국가)에 따라 선택/미선택 표시
'============================================================================
Function SelectNationOption()

	for i = 0 to #optionNationTable -1
		
		isSelect = optionNationTable[i]
		
		if isSelect == "Y" then
			Form.SetCtlProp(optionNationCtlTable[i], "imgpath", "btn_line2_o.9")
		else
			Form.SetCtlProp(optionNationCtlTable[i], "imgpath", "btn_line2_n.9")
		end if
	
	next

End Function
'============================================================================
' 조회조건(기간)에 따라 선택/미선택 표시
'============================================================================
Function SelectPeriodOption()
	
	contPeriod.RgDateType.currentindex = optionPeriodIndex
	contPeriod.cldFromDate.caption = optionFromDate
	contPeriod.cldToDate.caption = optionToDate

End Function

'============================================================================
' 조회조건(국가) 변경 처리
'============================================================================
Function Change_optionNationTable(nIndex)
	
	'---------------------------------------------
	'0:전체일경우 첫번째인덱스만 Y 나머지 다 N처리
	'그외 : 선택한 인덱스값 변경처리(Y->N, N->Y)
	'---------------------------------------------
	Select Case nIndex
		Case 0
			
			for i = 0 to #optionNationTable - 1
				
				if i == 0 then
					optionNationTable[i] = "Y"
				else
					optionNationTable[i] = "N"
				end if
				
			next
			
		Case 1,2,3,4,5
			optionNationTable[0] = "N"
			
			beforeFlag = optionNationTable[nIndex]
			
			if beforeFlag == "Y" then
				optionNationTable[nIndex] = "N"
			else
				optionNationTable[nIndex] = "Y"
			end if
			
	End Select
	
	'---------------------------------------------
	' 전체를 제외한 모든 플래그 Y여부 체크
	' 모든 플래그가 Y인 경우 전체로 자동으로 변경
	'---------------------------------------------
	isAllFlagY = True
	for i = 1 to #optionNationTable - 1
		
		isSelect = optionNationTable[i]
		
		if isSelect == "N" then
			isAllFlagY = False
		end if
		
	next
	
	'---------------------------------------------
	' 전체를 포함한 모든 플래그 N여부 체크
	' 모든 플래그가 N인 경우 전체로 자동으로 변경
	'---------------------------------------------
	isAllFalgN = True
	for i = 0 to #optionNationTable - 1
		
		isSelect = optionNationTable[i]
		
		if isSelect == "Y" then
			isAllFalgN = False
		end if
		
	next
	
	if isAllFlagY  then
		Change_optionNationTable(0)
	end if
	
	if isAllFalgN then
		Change_optionNationTable(0)
	end if
	'--------------------------------------
	'--------------------------------------
	
	
End Function

'============================================================================
' 조회조건(기간) 변경 처리
'============================================================================
Function Change_optionPeriod(nIndex)
	
	if nIndex < 0 then
		optionPeriodIndex = 0
	else
		optionPeriodIndex = nIndex
	end if
	
	

	if nIndex == 0 then '당일 '20240315
		contPeriod.cldFromDate.enable = "0"
		contPeriod.cldToDate.enable = "0"
		
		contPeriod.cldFromDate.caption = Left(Form.calcDateTime( nYear, nMonth, nDay, nHour, nMinute, nSecond ), 8)
		contPeriod.cldToDate.caption = Left(Form.calcDateTime( nYear, nMonth, nDay, nHour, nMinute, nSecond ), 8)
		
		'조회기간 선택 시에는 직접 담아줌.
		optionFromDate = contPeriod.cldFromDate.caption
		optionToDate = contPeriod.cldToDate.caption
		
		'캘린더 숨김처리
		contPeriod.cldFromDate.visible = false
		contPeriod.Label8.visible = false
		contPeriod.cldToDate.visible = false
		
	
	elseif nIndex == 1 then '1개월(전일날짜의 1개월 전) '20240315
		contPeriod.cldFromDate.enable = "0"
		contPeriod.cldToDate.enable = "0"
		
		'From:전일자 - 1개월 ~ To:전일자
		contPeriod.cldToDate.caption = Left(Form.calcDateTime( nYear, nMonth, -1, nHour, nMinute, nSecond ), 8)
		contPeriod.cldFromDate.caption = CalcDate("To","m",-1)
		
		'조회기간 선택 시에는 직접 담아줌.
		optionFromDate = contPeriod.cldFromDate.caption
		optionToDate = contPeriod.cldToDate.caption
		
		'캘린더 숨김처리
		contPeriod.cldFromDate.visible = false
		contPeriod.Label8.visible = false
		contPeriod.cldToDate.visible = false
		
	elseif nIndex == 2 then  '3개월(전일날짜의 3개월 전) '20240315
		
		contPeriod.cldFromDate.enable = "0"
		contPeriod.cldToDate.enable = "0"

		
		contPeriod.cldToDate.caption = Left(Form.calcDateTime( nYear, nMonth, -1, nHour, nMinute, nSecond ), 8)
		contPeriod.cldFromDate.caption = CalcDate("To","m",-3)
		
		'조회기간 선택 시에는 직접 담아줌.
		optionFromDate = contPeriod.cldFromDate.caption
		optionToDate = contPeriod.cldToDate.caption
		
		'캘린더 숨김처리
		contPeriod.cldFromDate.visible = false
		contPeriod.Label8.visible = false
		contPeriod.cldToDate.visible = false
		
		
	elseif nIndex == 3 then  '직접입력
		contPeriod.cldFromDate.enable = "1"
		contPeriod.cldToDate.enable = "1"
		
		'직접입력 시 디폴트 기간(전일자~전일자)
		contPeriod.cldFromDate.caption = Left(Form.calcDateTime( nYear, nMonth, -1, nHour, nMinute, nSecond ), 8)
		contPeriod.cldToDate.caption = Left(Form.calcDateTime( nYear, nMonth, -1, nHour, nMinute, nSecond ), 8)
		
		'(예외처리)조회기간 라디오버튼을 직접 선택할 경우, 캘린더 일자를 변경하고
		'전역변수에 직접 담아줘야 하지만, 직접입력 시 전역변수에 직접 담아줄 경우
		'필터설정값 조회 => 링크화면 => 다시 되돌아올 경우 마지막 필터값 설정으로 자동 세팅해줄떄 문제발생
		'위 현상때문에 직접입력 일 경우에는 캘린더의 일자만 변경 해주고, 전역변수는 변경하지 않는다.
		'따라서 OK버튼을 눌렀을때 직접입력시인 경우에는 전역변수를 리턴하지 않고, 캘린더값을 직접가져와 리턴
				
		'캘린더 보임처리
		contPeriod.cldFromDate.visible = true
		contPeriod.Label8.visible = true
		contPeriod.cldToDate.visible = true
		
	end if
	
End Function

'============================================================================
' (From일)로부터 + @일/개월 가져오기 // To일로부터 - @일/개월 가져오기
'============================================================================
Function CalcDate(sGubun,sType,nDiff)
	
	'----------------------------------
	'From일로부터 + @일/개월 가져오기
	'----------------------------------
	if sGubun == "From" then

		sYear = contPeriod.cldFromDate.calyear
		sMonth = contPeriod.cldFromDate.calmonth
		sDay = contPeriod.cldFromDate.calday
		
		sRsltDate = Replace(DateAdd (sType, nDiff,  sYear&"-"& sMonth &"-"& sDay), "-", "")
		return sRsltDate
	
	'----------------------------------
	'To일로부터 - @일/개월 가져오기
	'----------------------------------
	else
	
		sYear = contPeriod.cldToDate.calyear
		sMonth = contPeriod.cldToDate.calmonth
		sDay = contPeriod.cldToDate.calday
		
		sRsltDate = Replace(DateAdd (sType, nDiff,  sYear&"-"& sMonth &"-"& sDay), "-", "")
		return sRsltDate
	
	end if
	
	
End Function

'==============================================================================================
' 타입에 따라서 화면 구성 변경 (gContType 1:정렬기준만 보임 / 2:조회국가,정렬기준 둘다 보임)
'==============================================================================================
Function ChangeContType(sType)
	
	'(예외처리) sType => [3:시가총액] [4:배당률] [5:신규상장]인 경우 조회기간 선택이 불가하므로 숨김처리
	if sType == "3" or sType == "4" or sType == "5" then
	
		contPeriod.visible = false
		contNation.top = 420 + 130
		imgBG.height = 400 - 130
		imgBG.top = 355 + 130
		LabelTitle.top = 370 + 130
		imgClose.top = 370 + 130

	end if


End Function









