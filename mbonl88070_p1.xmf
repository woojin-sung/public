'============================================================================
Sub Form_OnFormInitBefore()
	contMain.imgClose.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
'	tblInfo.SetCellString(0, 0, "예금자비보호")
'	tblInfo.SetCellString(5, 0, "가격변동위험")
'	tblInfo.SetCellString(11, 0, "원금손실위험")
'	
	contMain.lblMidTitle0.setHighlight(332)
	contMain.lblMidTitle1.setHighlight(332)
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		Dim tData
		tData = Split(szOpenData, "★")
		'상품등급코드 / 상품유형코드 / 투자최소일수 / 투자최대일수 / 수익률 / 상품코드 / 출금가능금액
		if UBound(tData) > 0 then
			'상품유형
			if tData[1] == "1" then
				contMain.tblData.SetCellString(0, 1, "발행어음/약정형")
			else
				contMain.tblData.SetCellString(0, 1, "발행어음/수시형")
			end if
			
			'수익률
			contMain.tblData.SetCellString(1, 1, tData[4])
			
			'투자최소-최대일수
			if tData[1] == "1" then
				contMain.tblData.SetCellString(2, 1, CInt(tData[2]) & "-" & CInt(tData[3]) & "일")
			else
				contMain.tblData.SetCellString(2, 1, "365일")
			end if
			
			'위험도/위험등급
			if tData[0] == "01" then
				contMain.tblData.SetCellString(3, 1, "초고위험/1등급")
			elseif tData[0] == "02" then
				contMain.tblData.SetCellString(3, 1, "고위험/2등급")
			elseif tData[0] == "03" then
				contMain.tblData.SetCellString(3, 1, "중위험/3등급")
			elseif tData[0] == "04" then
				contMain.tblData.SetCellString(3, 1, "저위험/4등급")
			elseif tData[0] == "05" then
				contMain.tblData.SetCellString(3, 1, "초저위험/5등급")
			end if
		end if
	end if
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnNext_OnClick()
	Form.SendReturnToParent("mbonl88070_p1" , "ok")
	Form.CloseForm()
End Sub

