	<SCRIPT_INFO _len="1405" _ulen="1333" >

Dim g_tData

'============================================================================
Sub Form_OnFormInitBefore()
	imgIcon.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		'상품명 / 계좌번호 / 상품유형 / 매수금액 / 투자기간 / 매수금리 / 매수일 / 만기일
		g_tData = Split(szOpenData, "★")
		if UBound(g_tData) > 0 then
			tblData.SetCellString(1, 2, g_tData[0])
			tblData.SetCellString(2, 2, g_tData[1])
			if g_tData[2] == "1" then
				tblData.SetCellString(3, 2, "약정형")
			else
				tblData.SetCellString(3, 2, "수시형")
			end if
			tblData.SetCellString(4, 2, g_tData[3])
			tblData.SetCellString(5, 2, g_tData[4])
			tblData.SetCellString(6, 2, g_tData[5])
			tblData.SetCellString(7, 2, g_tData[6])
			tblData.SetCellString(8, 2, g_tData[7])
		end if
	end if
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnMove_OnClick()
	if UBound(g_tData) > 0 then
		Form.SetSharedData("mbact71052_popup_ACNO", g_tData[1])
		Form.OpenPopup("mbact71052_popup", "", "")
	end if
End Sub

	</SCRIPT_INFO>
