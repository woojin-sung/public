Sub Request_obcpp_logn_015a(szSucs_YN)
	szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID	
	DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "USER_ID" , 0 , szUserId ) '사용자ID
	DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "SUCS_YN" , 0 , szSucs_YN) 		'성공여부	
	DATAMANAGER.RequestTranData("obcpp_logn_015a")
End Sub

'============================================================================
Sub Form_OnFormInit()
	'출금계좌, 출금일련번호, 계좌비밀번호, 출금액, 전일수표, 당일수표, 현금출금, 
	'거래설명(내통장), 상대거래설명(상대통장), 입금계좌번호, 입금계좌명, 출금계좌명
	Form.SetScreenName("대체예정내역 확인")
	
	Dim szData
	szData = Form.GetOpenLinkData()
	g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
	g_sBioTrMsg = ""
	
	Dim szList
	szList = Split(szData, "★")
	
	if UBOUND(szList) < 1 then
		exit sub
	end if
	
	g_szAccountNumber = szList(0)
	g_szAccountSerialNumber = szList(1)
	g_szAccountPassword = szList(2)
	g_szWithAll = szList(3)
	g_szBeforeNoMoney = szList(4)
	g_szTodayNoMoney = szList(5)
	g_szTodayMoney = szList(6)
	g_szMy = szList(7)
	g_szYou = szList(8)
	g_szSendBeforeAccount = szList(9)
	
	'보안매체 skip 여부
	g_sMdiaSkipYn = ""
	g_sMdiaSkipYn = Form.GetSharedData("61050_SMDIA_SKIP" , TRUE)
	
	if Len(Trim(g_szSendBeforeAccount)) > 10 then	'3007-3881-02 이런식으로 들어올때
		Dim szTemp
		szTemp = Split(g_szSendBeforeAccount, "-")
		g_szSendAccount = szTemp(0) & szTemp(1)
		g_szSendAccoutnSerialNumber = szTemp(2)
	
	elseif Len(Trim(g_szSendBeforeAccount)) == 10 then	'3007388102 이런식으로 들어올때
		g_szSendAccount = Mid(g_szSendBeforeAccount, 1, 8)
		g_szSendAccoutnSerialNumber = Mid(g_szSendBeforeAccount, 9, 2)
		
	end if
	
	g_szSendAccountName = szList(10)
	g_szAccountName = szList(11)
	
	Table0.SetCellString( 0, 1,   g_szAccountNumber ..g_szAccountSerialNumber  )
	Table0.SetCellString( 1, 1, g_szAccountName   )
	
	Table1.SetCellString( 1, 1, g_szSendAccount..g_szSendAccoutnSerialNumber )
	Table1.SetCellString( 2, 1, g_szSendAccountName )
	
	Table1.SetCellString( 3, 1, g_szWithAll )
	
	g_sOtpTrMsg = "메리츠증권" & "#" & g_szSendAccount & g_szSendAccoutnSerialNumber & "#" & g_szSendAccountName & "#" & FormatNumber(CDbl(g_szWithAll), 0, 0, 0, -1) & "원#"
	Form.SetSharedData("OTP_TR_MSG_1" , g_sOtpTrMsg)
	
	if g_szCertUserType == "3" OR g_szCertUserType == "4" then	'3 -bio 인증 '4 - 공동인증
		g_sBioTrMsg = "이체예정내역\n" & "입금기관 : " & "메리츠증권" & "\n" & "입금계좌 : " & g_szSendAccount & g_szSendAccoutnSerialNumber & "\n" & "예금주명 : " & g_szSendAccountName & "\n" & "이체금액 : " & FormatNumber(CDbl(g_szWithAll), 0, 0, 0, -1) & "원\n" 
		Form.SetSharedData("BIO_TR_MSG_1" , g_sBioTrMsg)
	End if
	
	if g_szCertUserType == "1" then
		' 간편인증 보안매체 추가
		'==============
		TR_Inquiry("obcsb_oimf_625r")
		'==============
		'LinkForm0.linkfile = "mbbnk61010_s4"
	else
		TR_Inquiry("obcsb_oimf_625r")
	end if
	
		
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrtd_drng_004a" then	'이체출금등록되면 
		Dim szCode
		szCode = DATAMANAGER.GetDataValue(0, "obrtd_drng_004a", "OutBlock1", "DELY_TACT_YN" , 0)
'		if szCode == "Y" then
'			Form.MsgBox("알림", "지연이체 접수되었습니다.", "", 0 )
'		else 
'			Form.MsgBox("알림", "대체처리 되었습니다.", "", 0 )
'		end if
		
'		if DATAMANAGER.GetDataMsgCode( "obrtd_drng_004a" ) == "E311" then
'			Dim szText
'			szText = DATAMANAGER.GetDataMsgText("obrtd_drng_004a")
'			Form.ShowAlert( "알림", szText)
'			Form.SendReturnToParent( "Clear" , sData)
'			Form.CloseForm()
'		end if
		
		Form.OpenPopup("mbbnk61050_p3" , szCode , "")
'		Form.SendReturnToParent( "Clear" , sData)
'		Form.CloseForm()
		
	elseif szTranID == "obcpp_logn_015a" then
		'공인인증서 비밀번호 오류횟수
		sMstk =  DATAMANAGER.GetDataValue( 0,"obcpp_logn_015a", "OutBlock1", "PBCR_PWD_MSTK_TMNU" ,0)
		nCount = CInt(sMstk)
		if nCount >  0 then	
			'Form.ShowAlert("알림", "공인인증서 비밀번호 " & tonumber(sMstk) & "회 오류입니다.\n연속 7회 오류시 접속이 제한됩니다.")	
			'1. 공인인증 5회이상 초과
			if CInt(sMstk) >= DEF_CERT_PSWD_LIMIT_CNT then
				Form.MsgBox( "알림",  "인증 비밀번호 5회 오류 초과로 업무진행이 불가능 합니다.", "", 0)
			
			'2. 공인인증 오류횟수 5회 미만
			else
				Form.MsgBox( "알림",  "인증 비밀번호 " + CInt(sMstk) + "회 오류입니다. 5회 오류 초과시 업무진행이 불가능 합니다.", "", 0)
			end if	
			
             '3. 오류횟수 공유변수 저장 (공인인증 오류횟수는 공유변수로 앱 종료전까지 모든화면이 공유)
			Form.SetSharedData("CERT_PWD_ERR_CNT" , sMstk)		
		
		'-----------------------------------------------------
		' 인증서 비밀번호 일치시
		'-----------------------------------------------------
		else
			
			' 기존) 인증서 비밀번호가 5회 초과된 상태에서 인증서 비밀번호 일치시, 업무진행 가능
			' 변경) 인증서 비밀번호가 5회 초과된 상태에서 인증서 비밀번호 일치시, 업무진행 불가
			sCertErrCnt = Cint(Form.GetSharedData("CERT_PWD_ERR_CNT", false ))
			
			'4. 공유 오류횟수 > 최대 오류횟수 : 업무진행 불가 메세지
			if sCertErrCnt >= DEF_CERT_PSWD_LIMIT_CNT then
				Form.MsgBox( "알림",  "인증 비밀번호 5회 오류 초과로 업무진행이 불가능 합니다.",	""	,	0)
				g_sResult = "cancel"
				Exit Sub
			
			'5. 공유 오류횟수 < 최대 오류횟수 : 공유 오류횟수 초기화
			else
				Form.SetSharedData("CERT_PWD_ERR_CNT" , 0)
			end if
		end if		
	elseif szTranID == "obcsb_oimf_625r" then
		Dim sSPLM_ATHN_NCSR_YN
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				'Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
				LinkForm0.linkfile = "mbbnk61010_s1"
			Case "1"
'				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
				Form.ShowAlert( "알림", "부가정보만 존재할경우 처리가 불가능합니다.")
				Form.SendReturnToParent("Clear" , "sData")
				Form.CloseForm( )
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				'Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
				LinkForm0.linkfile = "mbbnk61010_s2"
			Case "4" 'v0002
				LinkForm0.linkfile = "mbbnk61010_suo" '공인인증서_mOTP	v0002			     
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
		
		
		IF g_sMdiaSkipYn	 = "Y" THEN
			'간편비번 only
			IF g_szCertUserType = "1" THEN
				LinkForm0.linkfile = "mbbnk61010_s7"
				Exit Sub
			ELSEIF g_szCertUserType = "3" THEN		'바이오 only
				LinkForm0.linkfile = "mbbnk61010_sb"
				Exit Sub
			END IF
		END IF
		
		' 간편인증 보안매체 추가
		'==================
		if g_szCertUserType == "1" then
			' 간편인증 보안매체 추가
			'==================
			'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
			Select Case g_sGubunCode
				Case "0"
					LinkForm0.linkfile = "mbbnk61010_s5" ' 간편인증_보안카드
				Case "3"
					LinkForm0.linkfile = "mbbnk61010_s6" ' 간편인증_OTP
				Case "4" 'v0002
					LinkForm0.linkfile = "mbbnk61010_sso" ' 간편인증_mOTP v0002
			End Select
			'==================
			'LinkForm0.linkfile = "mbbnk61010_s4"
		end if
		'==================
		
		if g_szCertUserType == "3" OR g_szCertUserType == "4" then
			' 간편인증 보안매체 추가
			'==================
			'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
			Select Case g_sGubunCode
				Case "0"
					LinkForm0.linkfile = "mbbnk61010_s8" ' 바이오인증_보안카드
				Case "3"
					LinkForm0.linkfile = "mbbnk61010_s9" ' 바이오인증_OTP
				Case "4" 'v0002
					LinkForm0.linkfile = "mbbnk61010_sbo" ' 바이오인증_mOTP 'v0002					
			End Select
			'==================
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr

	if szTranID == "obrtd_drng_004a" then	
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.MsgBox( "알림", szErrMsg.." ("..szSubErr..")" , "", 0 )
		Form.SendReturnToParent( "Clear" , sData)
		Form.CloseForm()
	end if
End Sub

'============================================================================
' Form_OnPopupReturn 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p8" then	'추가인증 
		if sRet == "ok" then	'추가인증성공
			TR_Inquiry("obcsb_oimf_625r")
		else
			Form.CloseForm( )
			exit sub
		end if
	end if
	
	' 간편인증 보안매체 추가
	'==================
	if sKeyName == "mhetc90060_p9" then	'보안카드(보안매체1)
		if sRet == "ok" then			'성공
			Form.OpenPopup("mhetc90060_px", "", "")	
		else 					'실패
			exit sub
		end if	
	end if	
	
	if sKeyName == "mhetc90060_pb" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
			Form.OpenPopup("mhetc90060_px", "", "")
		else						'실패		
			exit sub
		end if	
	end if
	'==================
		
	if sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			Form.SendReturnToParent( "mbbnk61010_p0" , "OK" )
			Form.CloseForm( )
		else						'실패
			exit sub
		end if
		
	end if
	
	if sKeyName == "Close" then
		if sRet == "61060" then
			Form.OpenScreen("61060", "")
		elseif sRet == "61010" then
			Form.OpenScreen("61010", "1")
		else
			Form.SendReturnToParent( "Clear" , sRet)
			Form.CloseForm()
		end if
	end if
	
	If sKeyName == "mhetc90060_px" Then
		If sRet == "ok" Then
			TR_Inquiry("obrtd_drng_004a")
			'Form.SendReturnToParent( "mbbnk61010_p0" , "ok" )
			'Form.CloseForm( )
		ElseIf sRet == "cancel" Then
			'Form.ShowAlert("알림", "간편인증 실패.")
		End If
		
	End If
	
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
'	if sKeyName == "mhetc90190_p1" then										
'		if sRet == "ok" then									
'		end if
'	end if 
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "인증서" then  'v0001 mbbnk61010_s1~9,sa,sb 공인인증서->인증서 변경
		if sParam == "Success" then
			btnOK.enable = false
			Request_obcpp_logn_015a("Y")
			TR_Inquiry("obrtd_drng_004a")
		end if
	elseif sEventName == "보안카드" then
		if sParam == "Success" then
			btnOK.enable = false
			TR_Inquiry("obrtd_drng_004a")
		end if
	elseif sEventName == "간편인증" then
		if sParam == "Success" then
			btnOK_OnClick()
		end if
	elseif sEventName == "바이오인증" then
		if sParam == "Success" then
			btnOK.enable = false
			TR_Inquiry("obrtd_drng_004a")
		end if
	elseif sEventName == "공동인증" then
		if sParam == "Success" then
			btnOK.enable = false
			TR_Inquiry("obrtd_drng_004a")
		end if
	elseif sEventName == "간편인증OTP" then
		if sParam == "Success" then
			btnOK.enable = false
			TR_Inquiry("obrtd_drng_004a")
		end if
	ElseIf sEventName == "mOTP_GenReq" Then 'v0002
	    Form.requestMOTP("MOTP_REQ_OTP_ENC", sParam , "61010p0") 'v0002		
'	elseif sEventName == "reqAuthPinPad" then
'		Dim sRet, sErrorCode, sErrorMsg, sPassFailCnt
'		sRet = Split(sParam, "★")
'		
'		if #sRet > 1 then
'			sErrorCode = sRet[0]
'			sErrorMsg = sRet[1]
'			sPassFailCnt = sRet[2]
'		end if
'		
'		if sErrorCode == "0000" then '성공
'			TR_Inquiry("obrtd_drng_004a")
'		elseif sErrorCode == "2005" then
'			Form.ShowAlert("알림", "간편인증 비밀번호 " & sPassFailCnt & "회 오류입니다.")
'		else
'			Form.ShowAlert("알림", "간편인증 실패.(" & sErrorMsg & ")")
'		end if
'	elseif sEventName == "reqPush" then
'		Dim sRet, sErrorCode, sErrorMsg
'		sRet = Split(sParam, "★")
'		
'		sErrorCode = sRet[0]
'		sErrorMsg = sRet[1]	
'		
'		if sErrorCode == "0000" then '성공
'			'Form.triggerEvent("#", "공인인증서", "Success")
'		else
'			Form.ShowAlert("알림", "간편인증 실패(" & sErrorMsg & ")")
'		end if
	end if   
End Sub

'============================================================================
' DATAMANAGER_OnRequestTranTimeout(szTranID) : TR TimeOut 발생시 함수
'============================================================================
Sub DATAMANAGER_OnRequestTranTimeout(szTranID)
	
	if szTranID == "obrtd_drng_004a" then
		Form.ShowAlert( "알림", "이체결과를 확인하시기 바랍니다.")
		Form.SendReturnToParent( "Clear" , sRet)
		Form.CloseForm()
	end if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "CERT_PSWD_FAIL_APP_TERMINATE" then
		sDeviceOS = Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
		
		if sDeviceOS = "2" then
			Form.restartApp()
		else	
			Form.TerminateApp()
		end if	
	end if
End Sub

'============================================================================
'Form.requestMOTP로 호출하면 여기로 리턴됨 v0002
'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam)
	if sEventName == "MOTP_GET_VERSION_RETURN_61010p0" then
		g_mSBValue = Split(sParam,"★")		'resultcode★resultMsg★mSBVersion
		
		if g_mSBValue[0] <> "00000" then
			Form.MsgBox( "알림", g_mSBValue(1), "close", 6 )
		Else
			Form.SetSharedData( "mOTP_MsbVrsn" , g_mSBValue[2] )
		end if
		
	elseif sEventName == "MOTP_GETINFO_RETURN_61010p0" then
		
		g_mOTPInfo  = Split(sParam,"★")    'resultcode★resultMsg★otpAlias(일련번호)
		
		if g_mOTPInfo[0] <> "00000" then
			Form.MsgBox( "알림", g_mOTPInfo(1), "close", 6 )
		else
			Form.SetSharedData( "mOTP_OTPSrno" , g_mOTPInfo(2) )
'			Form.SetSharedData( "mOTP_OTPSrno" , Right(g_mOTPInfo(2), 12) )
		end if
		
		'메인처리는 일련번호 다중처리 가능하게 되어있지만, 1개만 받는 것으로 생각
		'g_mOTPAlias = Split(g_mOTPInfo[2],"#")
			
	elseif sEventName == "MOTP_REQ_OTP_ENC_RETURN_61010p0" then

		g_mOTPData = Split(sParam,"★")
		
		if g_mOTPData[0] <> "00000" then
			Form.MsgBox( "알림", g_mOTPData(1), "close", 6 )
		else
			Form.SetSharedData( "mOTP_SrnoGen" , g_mOTPData[2] )
			Form.triggerEvent("LinkForm0", "mOTP_Gen" , "Success")
		end if
	end if
	
End Sub

