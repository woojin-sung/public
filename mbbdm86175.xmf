				</CONTAINER>
				<CONTAINER name="Container1" scroll_pos="0,0" ly_vert="0,685,376,320,1" scroll_ly_vert="0,0" >
					<CONTROL_INFO>
						<LABEL name="LblInfr1" fontstyle="01" transmode="0" ly_vert="20,24,335,207,1" />
