	<SCRIPT_INFO _len="44922" _ulen="40480" >
'--===========================================================================
' 작성 : 2021.02.17. 장원혁...
' 2021.10.25 : 김수진 : v0001 : 중개형 ISA 추가
' 2023.01.18 : 강희승 : v0002 : 연금저축추가 T2210110004
'--===========================================================================
Dim aFlag
Dim ProductCnt
Dim scrollIndex
Dim Grade
Dim RCNO_PIP

Dim MBBDM86176_YN

Dim GRADE_PRCD100
'v0002 sta
Dim GRADE_PRCD131
'v0002 fin
Dim GRADE_PRCD101
Dim GRADE_PRCD135
'v0001 sta
Dim GRADE_PRCD133
'v0001 fin
Dim GRADE_PRCD200

Dim g_BDM_PRCD100            '종합매매 가입여부
Dim g_BDM_PRCD200            '슈퍼365 가입여부
Dim g_BDM_PRCD101            '선물옵션 가입여부
Dim g_BDM_PRCD135            '해외파생 가입여부
'v0002 sta
Dim g_BDM_PRCD131            '연금저축 가입여부
'v0002 fin
'v0001 sta
Dim BDM_PRCD133			'ISA 가입여부
Dim g_BDM_ISA_PROD_TYPE	'ISA 타입 (중개형ISA :3/ 일임형 ISA:2)
'v0001 fin

Dim g_KYC_GRAD            '(고객적용)투자성향등급
Dim g_APLY_KYC_GRAD       '(종합매매)투자성향등급
Dim g_APLY_PROD_GRAD      'KYC상품등급코드
Dim g_APLY_UNFIT_YN       '부적합여부
'Dim g_APLY_DVPD_KYC_GRAD  '선물옵션투자성향등급코드
Dim g_APLY_DVPD_PROD_GRAD '선물옵션상품등급코드
Dim g_APLY_DVPD_UNFIT_YN  '선물옵션부적합여부



'============================================================================
Sub Form_OnFormInit()

	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		Container.setScrollBarVisible("2")
	end if

    scrollIndex = 1200
    ProductCnt = 0

    Container.Container1.LblInfr1.bgcolor = 272
    Container.Container1.LblInfr2.bgcolor = 271
    Container.ImgChk.imgpath = "check_square_off.png"

    Container.Container1.height = 280
    Container.Container1.ContainerAccord.height = 0
'    Container.Container1.LblDummy.top = 354
    Container.SetScrollAutoSize()
    aFlag = 0

    MBBDM86176_YN = "N"

    RCNO_PIP = Form.GetSharedData("BDM_RCNO_PIP", False )
    g_BDM_PRCD100   = Form.GetSharedData("BDM_PRCD100"            , false)  '종합매매 가입여부
    g_BDM_PRCD200   = Form.GetSharedData("BDM_PRCD200"            , false)  '슈퍼365 가입여부
    g_BDM_PRCD101   = Form.GetSharedData("BDM_PRCD101"            , false)  '선물옵션 가입여부
    g_BDM_PRCD135   = Form.GetSharedData("BDM_PRCD135"            , false)  '해외파생 가입여부
    'v0002 sta
    g_BDM_PRCD131   = Form.GetSharedData("BDM_PRCD131"            , false)  '연금저축 가입여부
    'v0002 fin
    'v0001 sta
    g_BDM_PRCD133   = Form.GetSharedData("BDM_PRCD133"            , False ) 'ISA 가입여부
    g_BDM_ISA_PROD_TYPE   = Form.GetSharedData("BDM_ISA_PROD_TYPE", False ) 'ISA 타입 (중개형ISA :3/ 일임형 ISA:2)
    'v0001 fin

    g_KYC_GRAD            = Form.GetSharedData("BDM_APLY_KYC_GRAD"  , false)  '(고객적용)투자성향등급
    g_APLY_KYC_GRAD       = Form.GetSharedData("BDM_KYC_GRAD"       , false)  '(종합매매)투자성향등급
    g_APLY_PROD_GRAD      = Form.GetSharedData("BDM_PROD_GRAD"      , false)  '상품등급
    'g_APLY_DVPD_KYC_GRAD  = Form.GetSharedData("BDM_DVPD_KYC_GRAD"  , false)  '파생상품투자성향등급
    g_APLY_DVPD_PROD_GRAD = Form.GetSharedData("BDM_DVPD_PROD_GRAD" , false)  '파생상품상품등급
    g_APLY_UNFIT_YN       = Form.GetSharedData("BDM_UNFIT_YN"       , false)  '부적합여부
    g_APLY_DVPD_UNFIT_YN  = Form.GetSharedData("BDM_DVPD_UNFIT_YN"  , false)  '파생상품부적합여부

'	g_KYC_GRAD = "01"
'	g_APLY_PROD_GRAD = "01"
'	g_APLY_DVPD_PROD_GRAD = "01"
'	g_BDM_ISA_PROD_TYPE = "3"
'	
'	g_BDM_PRCD100 = "Y"
'	g_BDM_PRCD200 = "Y"
'	g_BDM_PRCD131 = "Y"
'	g_BDM_PRCD133 = "Y"
'	g_BDM_PRCD101 = "Y"
'	g_BDM_PRCD135 = "Y"

    ScreenSet()

End Sub


'============================================================================
Sub Form_OnTimerEvent(sTimerID)

    If trim(sTimerID) == "9999" Then
        Form.SetTimerEvent2("9999", 0, 0.3)
		Container.Container1.height = 280
        Container.scroll_pos = scrollIndex + 100
        Container.SetScrollAutoSize()
    End If

End Sub

'============================================================================
Sub Container_Container1_BtnAccordion_OnClick()

    If aFlag == 0 Then
        Container.Container1.height = 450
        Container.Container1.ContainerAccord.setHeightResize(136)
'        Container.Container1.LblDummy.top = 500
'		Container.Container1.LblDummy.top = 280 + 136
        Container.SetScrollAutoSize()
        Container.scroll_pos = scrollIndex + 180
        Container.Container1.ImgArrow.imgpath = "icon_caret_up.png"
        aFlag = 1
    Else
        Container.Container1.setHeightResize(350)
'        Container.Container1.LblDummy.top = 350
'	Container.Container1.LblDummy.top = 350
        Container.Container1.ContainerAccord.setHeightResize(0)
'		Container.Container1.SetScrollAutoSize()
        Form.SetTimerEvent2("9999", 1, 0.3)
        Container.Container1.ImgArrow.imgpath = "icon_caret_down.png"
        aFlag = 0
    End If

End Sub

'============================================================================
Sub BtnClose_OnClick()
    'Form.CloseForm()
    Container_ImgClose_OnClick()
End Sub

'============================================================================
Sub Container_ImgClose_OnClick()
    'Form.SendReturnToParent("MBBDM86175", "")


    '비정상종료처리 분기
'    Form.SendReturnToParent("MBBDM86175", "unfit_fail")
'    Form.CloseForm()

	Form.MsgBox("알림", "계좌개설을 중단하시겠습니까?\n진행 중인 계좌개설은 추후 '이어가기'로 이어서 진행하실 수 있습니다.", "ABORT", 7, "예", "아니오")

End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "ABORT" and sRet == "ok" then
		'계좌개설 중단
		Form.SendReturnToParent("MBBDM86175", "abort")
	    Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()  '안드로이드전용
    Container_ImgClose_OnClick()
End Sub

'============================================================================
Sub ScreenSet()

	'상품 등급 설정 ------------------------------------
	'@yhj..상품이 다건 조회해서 넘어오므로.. 제대로 변수로 받지 못함.
	GRADE_PRCD100 = 1 '고수익지향형
	GRADE_PRCD133 = 1 '고수익지향형
	GRADE_PRCD131 = 2 '성장지향형
	GRADE_PRCD101 = 1 '고수익지향형
	GRADE_PRCD135 = 1 '고수익지향형
	GRADE_PRCD200 = 1 '고수익지향형

	'종합매매, v0001 중개형ISA 추가
'	If g_APLY_PROD_GRAD == "01" Then
'	    GRADE_PRCD100 = 1 '고수익지향형
'	    GRADE_PRCD133 = 1 '고수익지향형
'	    'v0002 sta
'	    'GRADE_PRCD131 = 1 '고수익지향형
'	    GRADE_PRCD131 = 1 '고수익지향형
'	ElseIf g_APLY_PROD_GRAD == "02" Then
'	    GRADE_PRCD100 = 2 '성장지향형
'	    GRADE_PRCD133 = 2 '성장지향형
'	    'v0002 sta
'	    GRADE_PRCD131 = 2 '성장지향형
'	ElseIf g_APLY_PROD_GRAD == "03" Then
'	    GRADE_PRCD100 = 3 '중립형
'	    GRADE_PRCD133 = 3 '중립형
'	    'v0002 sta
'	    GRADE_PRCD131 = 3 '성장지향형
'	ElseIf g_APLY_PROD_GRAD == "04" Then
'	    GRADE_PRCD100 = 4 '안정지향형
'	    GRADE_PRCD133 = 4 '안정지향형
'	    'v0002 sta
'	    GRADE_PRCD131 = 4 '성장지향형
'	ElseIf g_APLY_PROD_GRAD == "05" Then
'	    GRADE_PRCD100 = 5 '이자소득형
'	    GRADE_PRCD133 = 5 '이자소득형
'	    'v0002 sta
'	    GRADE_PRCD131 = 5 '성장지향형
'	End If

	'파생상품
'	If g_APLY_DVPD_PROD_GRAD == "01" Then
'	    GRADE_PRCD101 = 1 '고수익지향형
'	    GRADE_PRCD135 = 1 '고수익지향형
'	ElseIf g_APLY_DVPD_PROD_GRAD == "02" Then
'	    GRADE_PRCD101 = 2 '성장지향형
'	    GRADE_PRCD135 = 2 '성장지향형
'	ElseIf g_APLY_DVPD_PROD_GRAD == "03" Then
'	    GRADE_PRCD101 = 3 '중립형
'	    GRADE_PRCD135 = 3 '중립형
'	ElseIf g_APLY_DVPD_PROD_GRAD == "04" Then
'	    GRADE_PRCD101 = 4 '안정지향형
'	    GRADE_PRCD135 = 4 '안정지향형
'	ElseIf g_APLY_DVPD_PROD_GRAD == "05" Then
'	    GRADE_PRCD101 = 5 '이자소득형
'	    GRADE_PRCD135 = 5 '이자소득형
'	End If

    Container.Grid1.SetCellData("bd_cell1", 0, "투자성향 등급")
    Container.Grid1.SetCellData("bd_cell7", 0, "적합상품")

'    Container.Grid1.SetCellFgColor("bd_cell2", 0, 266)

'    If g_KYC_GRAD == "00" Or g_KYC_GRAD == "" Or g_KYC_GRAD == NULL Then
'        Container.Grid1.SetCellData("bd_cell2", 0, "정보미제공")
'        Container.Grid1.SetCellData("bd_cell9", 0, "초저위험(5등급)")
'        Grade = 0
'    ElseIf g_KYC_GRAD == "01" Then
'        'Container.LblGrade.caption = "고수익지향형"
'        Container.Grid1.SetCellData("bd_cell2", 0, "고수익지향형(1등급)")
'        Container.Grid1.SetCellData("bd_cell9", 0, "초고위험(1등급)")
'        Grade = 1
'    ElseIf g_KYC_GRAD == "02" Then
