'============================================================================
Sub BtnCont_OnClick()
	If MBBDM86176_YN == "Y" Then
		Form.OpenPopupAnimation("mbbdm86176", "", "","2")
	Else
		Form.SendReturnToParent("MBBDM86175", "ok")
		Form.CloseForm()
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

    If sKeyName == "MBBDM86176" Then
        If sRet == "ok" Then
            Form.SendReturnToParent("MBBDM86175", "ok")
            Form.CloseForm()

		'계좌개설 진행 중단
        ElseIf sRet == "abort" then
			Form.SendReturnToParent("MBBDM86175", "abort")
			Form.CloseForm()

        Else
            '비정상종료처리 분기
            Form.SendReturnToParent("MBBDM86175", "unfit_fail")
            Form.CloseForm()
        End If
    End If
End Sub

'============================================================================
Sub Container_BtnPopup_OnClick()
	Form.OpenPopup("mbbdm86175_p1.xmf" , "" , "")
End Sub

	</SCRIPT_INFO>
</ROOT>