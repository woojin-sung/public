'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_iDataCount
Dim g_nMode, g_OStype
Dim g_szUrl

'============================================================================
Sub Form_OnFormInit()
	g_nMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	if CInt(g_nMode) == "0" then
		g_szUrl = "https://home.imeritz.com/include/resource/research/WorkFlow"	'운영계 주소
	elseif CInt(g_nMode) == "1" then
		g_szUrl = "https://testhome.imeritz.com/include/resource/research/WorkFlow"	'테스트계주소
	end if
	
	
	g_OStype = Form.GetSharedData("&OS_TYPE", false)		'iOS("2") Android("1")
	
	if g_OStype == "1" then
		gridData.visible = True
		gridDataios.visible = False
		
	else
		gridData.visible = False
		gridDataios.visible = True
		
	end if
	
	
	gridData.scrollenable = "0"	
	gridData.rowcount = 0
	
	gridDataios.scrollenable = "0"	
	gridDataios.rowcount = 0
	
	DATAMANAGER.RequestTranData( "ooopc_rprt_001r")
End Sub	


'============================================================================
Sub lblTitle0_OnClick()
	Dim szLinkData
	szLinkData = ""
	
	Form.OpenPopup("mbonl90041", szLinkData, "")
End Sub

'============================================================================



'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , "mbonl90001_s4("..szTranID..")\n" .. szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , "mbonl90001_s4("..szTranID..")\n" .. szErrCode .. " : ".. szErrMsg)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szValue
	
	if szTranID == "ooopc_rprt_001r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BBS_GRP_ID",			0 , "bascGrp")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BBS_ID",				0 , "sih02")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BBS_CNTT_DIV_CODE",	0 , "18")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BBS_CNTT_WRTR_NAME",	0 , "%")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BBS_CNTT_TITL_NAME",	0 , "%")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STA_DATE",			0 , "000000")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FIN_DATE",			0 , "999999")
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iDataCount, iCount
	
	if szTranID == "ooopc_rprt_001r" then
		if g_OStype == "1" then
			g_iDataCount = gridData.rowcount
		else
			g_iDataCount = gridDataios.rowcount
		end if
		
		iDataCount = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		
		if CInt(g_iDataCount) == 0 and CInt(iDataCount) == 0 then
			
			Exit Sub
		end if
		
		iCount = 0
		for i = 0 to iDataCount - 1
			if iCount >= 3 then
				Exit Sub
			end if 
			
			szTemp1  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_GRP_ID",				i)
			szTemp2  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_ID",				i)
			szTemp3  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_CNTT_TURN_NO",		i)
			szTemp4  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_ATCH_TURN_NO",		i)
			szTemp5  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_CNTT_WRTN_YMDH",		i)
			szTemp6  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_CNTT_MOD_YMDH",		i)
			szTemp7  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_CNTT_WRTR_ID",		i)
			szTemp8  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_CNTT_WRTR_NAME",		i)
			szTemp9  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_CNTT_TITL_NAME",		i)
			szTemp10 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_CNTT_ATCH_FILE_CNT",	i)
			szTemp11 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_ATCH_ORTX_FILE_PATH_NAME",	i)
			szTemp12 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_ATCH_ORTX_FILE_NAME",	i)
			szTemp13 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_ATCH_SRVR_FILE_PATH_NAME",	i)
			szTemp14 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BBS_ATCH_SRVR_FILE_NAME",	i)
			szTemp15 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "URL_ADDR",				i)
			
			if g_OStype == "1" then
				gridData.AddRow()
				gridData.SetCellData("bd_title",		g_iDataCount + i, szTemp9)			
				gridData.SetCellData("bd_image",		g_iDataCount + i, "icon_report.png")
				gridData.SetCellData("bd_date",			g_iDataCount + i, szTemp5)
				
	'			'숨김cell
				gridData.SetCellData("BBS_GRP_ID",					g_iDataCount + i, szTemp1)
				gridData.SetCellData("BBS_ID",						g_iDataCount + i, szTemp2)
				gridData.SetCellData("BBS_CNTT_TURN_NO",				g_iDataCount + i, szTemp3)
				gridData.SetCellData("BBS_ATCH_TURN_NO",				g_iDataCount + i, szTemp4)
				gridData.SetCellData("BBS_CNTT_WRTN_YMDH",			g_iDataCount + i, szTemp5)
				gridData.SetCellData("BBS_CNTT_MOD_YMDH",			g_iDataCount + i, szTemp6)
				gridData.SetCellData("BBS_CNTT_WRTR_ID",				g_iDataCount + i, szTemp7)
				gridData.SetCellData("BBS_CNTT_WRTR_NAME",			g_iDataCount + i, szTemp8)
				gridData.SetCellData("BBS_CNTT_TITL_NAME",			g_iDataCount + i, szTemp9)
				gridData.SetCellData("BBS_CNTT_ATCH_FILE_CNT",		g_iDataCount + i, szTemp10)
				gridData.SetCellData("BBS_ATCH_ORTX_FILE_PATH_NAME",	g_iDataCount + i, szTemp11)
				gridData.SetCellData("BBS_ATCH_ORTX_FILE_NAME",		g_iDataCount + i, szTemp12)
				gridData.SetCellData("BBS_ATCH_SRVR_FILE_PATH_NAME",	g_iDataCount + i, szTemp13)
				gridData.SetCellData("BBS_ATCH_SRVR_FILE_NAME",		g_iDataCount + i, szTemp14)
				gridData.SetCellData("URL_ADDR",					g_iDataCount + i, szTemp15)
			else
				gridDataios.AddRow()
				gridDataios.SetCellData("bd_title",		g_iDataCount + i, szTemp9)			
				gridDataios.SetCellData("bd_image",		g_iDataCount + i, "icon_report.png")
				gridDataios.SetCellData("bd_date",		g_iDataCount + i, szTemp5)
				
	'			'숨김cell
				gridDataios.SetCellData("BBS_GRP_ID",					g_iDataCount + i, szTemp1)
				gridDataios.SetCellData("BBS_ID",						g_iDataCount + i, szTemp2)
				gridDataios.SetCellData("BBS_CNTT_TURN_NO",				g_iDataCount + i, szTemp3)
				gridDataios.SetCellData("BBS_ATCH_TURN_NO",				g_iDataCount + i, szTemp4)
				gridDataios.SetCellData("BBS_CNTT_WRTN_YMDH",			g_iDataCount + i, szTemp5)
				gridDataios.SetCellData("BBS_CNTT_MOD_YMDH",			g_iDataCount + i, szTemp6)
				gridDataios.SetCellData("BBS_CNTT_WRTR_ID",				g_iDataCount + i, szTemp7)
				gridDataios.SetCellData("BBS_CNTT_WRTR_NAME",			g_iDataCount + i, szTemp8)
				gridDataios.SetCellData("BBS_CNTT_TITL_NAME",			g_iDataCount + i, szTemp9)
				gridDataios.SetCellData("BBS_CNTT_ATCH_FILE_CNT",		g_iDataCount + i, szTemp10)
				gridDataios.SetCellData("BBS_ATCH_ORTX_FILE_PATH_NAME",	g_iDataCount + i, szTemp11)
				gridDataios.SetCellData("BBS_ATCH_ORTX_FILE_NAME",		g_iDataCount + i, szTemp12)
				gridDataios.SetCellData("BBS_ATCH_SRVR_FILE_PATH_NAME",	g_iDataCount + i, szTemp13)
				gridDataios.SetCellData("BBS_ATCH_SRVR_FILE_NAME",		g_iDataCount + i, szTemp14)
				gridDataios.SetCellData("URL_ADDR",					g_iDataCount + i, szTemp15)
			end if
			
			iCount = iCount + 1
		next
		
		if DATAMANAGER.IsMoreNextData(szTranID) == true then
			DATAMANAGER.RequestNextData(szTranID)
		
		else
			g_iDataCount = g_iDataCount + iDataCount
			
			if g_OStype == "1" then
				gridData.rowcount = g_iDataCount
				
				for i = 0 to gridData.rowcount - 1
					gridData.SetMaintainingRatio("bd_image", i, "1")
				next
			else
				gridDataios.rowcount = g_iDataCount
				
				for i = 0 to gridDataios.rowcount - 1
					gridDataios.SetMaintainingRatio("bd_image", i, "1")
				next
			
			end if
			
		end if
		
	end if
	
End Sub

'============================================================================
Sub gridData_OnClickUp(lRow, szCellID)
	Dim szMode, szUrl, szFileName
	
	szMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
'	if CInt(szMode) == 0 then
'		szUrl = "https://home.imeritz.com/include/resource/comm/ctcn/nfiles/"	'운영계 주소
'	elseif CInt(szMode) == 1 then
'		szUrl = "https://testhome.imeritz.com/include/resource/comm/ctcn/nfiles/"	'테스트계주소
'	end if
	if CInt(szMode) == 0 then
		szUrl = "https://home.imeritz.com/include/resource/research/WorkFlow"	'운영계 주소
	elseif CInt(szMode) == 1 then
		szUrl = "https://testhome.imeritz.com/include/resource/research/WorkFlow"	'테스트계주소
	end if
	
'	szFileName = Trim(szUrl) & gridData.GetCellData("BBS_ATCH_SRVR_FILE_PATH_NAME", lRow) & "/"
''	Form.ShowAlert("OnClickUp1", szFileName)
'	szFileName = szFileName & gridData.GetCellData("BBS_ATCH_SRVR_FILE_NAME", lRow)
'	Form.ShowAlert("OnClickUp2", szFileName)
	
	' v001
	szFileName = Trim(szUrl) & "/" & gridData.GetCellData("BBS_ATCH_ORTX_FILE_NAME", lRow)
'	szFileName = Trim(szUrl) & "/" & gridData.GetCellData("BBS_ATCH_SRVR_FILE_NAME", lRow)
	Form.OpenPdfViewer(szFileName, BBS_ATCH_ORTX_FILE_NAME)
'	Form.OpenExternalBrowser(szFileName)
End Sub

'============================================================================


'============================================================================
Sub gridDataios_OnClickUp(lRow, szCellID)
	Dim szMode, szUrl, szFileName
	
	szMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	if CInt(szMode) == 0 then
		szUrl = "https://home.imeritz.com/include/resource/research/WorkFlow"	'운영계 주소
	elseif CInt(szMode) == 1 then
		szUrl = "https://testhome.imeritz.com/include/resource/research/WorkFlow"	'테스트계주소
	end if
	
	' v001
	szFileName = Trim(szUrl) & "/" & gridDataios.GetCellData("BBS_ATCH_ORTX_FILE_NAME", lRow)
'	szFileName = Trim(szUrl) & "/" & gridDataios.GetCellData("BBS_ATCH_SRVR_FILE_NAME", lRow)
	Form.OpenPdfViewer(szFileName, BBS_ATCH_ORTX_FILE_NAME)
'	Form.OpenExternalBrowser(szFileName)
End Sub

