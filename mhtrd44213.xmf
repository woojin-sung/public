Dim g_szItemCode
Dim g_bInitFlag

g_bInitFlag = false

'============================================================================
Sub Form_OnFormInit()
	ItemCode0.code = "empty"
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "ohhts_6510_001r" then
		DATAMANAGER.SetDataValue( false, "ohhts_6510_001r", "InBlock1", "FID_OVDV_ISCD" , 0 , g_szItemCode )
		DATAMANAGER.SetDataValue( false, "ohhts_6510_001r", "InBlock1", "IQRY_STA_DATE" , 0 , cldFrom.caption )
		DATAMANAGER.SetDataValue( false, "ohhts_6510_001r", "InBlock1", "IQRY_FIN_DATE" , 0 , cldTo.caption )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

End Sub

'============================================================================
Sub cldFrom_OnEditComplete()
	if g_bInitFlag = true then
		grdList.SetClear()
		DATAMANAGER.RequestTranData( "ohhts_6510_001r" )
	end if
End Sub

'============================================================================
Sub cldTo_OnEditComplete()
	if g_bInitFlag = true then
		grdList.SetClear()
		DATAMANAGER.RequestTranData( "ohhts_6510_001r" )
	end if
End Sub 

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sReturn1 <> "" then
		g_szItemCode = sReturn1
		
		grdList.SetClear()
		DATAMANAGER.RequestTranData( "ohhts_6510_001r" )
		
		g_bInitFlag = true
	end if
End Sub

'============================================================================
Sub btnRefresh_OnClick()
	if g_bInitFlag = true then
		grdList.SetClear()
		DATAMANAGER.RequestTranData( "ohhts_6510_001r" )
	end if
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("ohhts_6510_001r") = true then
		DATAMANAGER.RequestNextData("ohhts_6510_001r")
	end if
End Sub

