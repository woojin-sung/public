'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	szOpenData = Form.GetOpenLinkData()
	arrData = Split(szOpenData,"★")
	if arrData(0) <> "" then
		if arrData(0) == "해외시황" then
			fmtab0.currenttabpageid = "page000101"
		elseif arrData(0) == "국내시황" then
			fmtab0.currenttabpageid = "page009776"
		end if
	end if
End Sub
