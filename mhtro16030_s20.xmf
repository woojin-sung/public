'===========================================================================
Dim g_tCmbData1
Dim g_tCmbData2
Dim g_nPage
Dim g_xPos
Dim g_nIndex
Dim g_nation
Dim g_stpr
Dim g_enpr
Dim g_stsi
Dim g_ensi
Dim g_stvo
Dim g_envo
Dim g_step
Dim g_enep
Dim g_stpe
Dim g_enpe
Dim g_szNext

g_nPage = 0
g_xPos  = ""
g_nIndex = 0
g_nation = ""	'국가
g_market = ""	'거래소
g_stpr = ""	'현재가
g_enpr = ""
g_stsi = ""	'시가총액
g_ensi = ""	
g_stvo = ""	'거래량(주)
g_envo = ""
g_step = ""	'EPS
g_enep = ""
g_stpe = ""	'PER
g_enpe = ""
g_szNext = ""
'============================================================================
Sub Form_OnFormInit()

	
end Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "ohhts_6000_011r" then
		Dim szDelay
		
		szDelay = ""
		if g_market <> "" then
			szDelay = Form.GetSharedData("REALTIME_"..g_market, 0 )
		elseif g_market == "" and g_nation == "US" then
			szDelay = Form.GetSharedData("REALTIME_NY", 0 ) '미국 전체 일 경우
		end if
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "60000" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay ) '실시간:0 지연:1
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_NTNL_CODE" , 0 , g_nation )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , g_market )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_PRC1" , 0 , g_stpr )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_PRC2" , 0 , g_enpr )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_AVLS1" , 0 , g_stsi )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_AVLS2" , 0 , g_ensi )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_VOL1" , 0 , g_stvo )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_VOL2" , 0 , g_envo )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_EPS1" , 0 , g_step )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_EPS2" , 0 , g_enep )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_PER1" , 0 , g_stpe )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FIDX_INPUT_PER2" , 0 , g_enpe )
		
		Dim bChk1, bChk2, bChk3, bChk4, bChk5, szCode
		bChk1, bChk2, bChk3, bChk4, bChk5, szCode = "0", "0", "0", "0", "0", ""
		if g_stpr <> "" or g_enpr <> "" then
			bChk1 = "1"
		end if
		if g_stsi <> "" or g_ensi <> "" then
			bChk2 = "1"
		end if
		if g_stvo <> "" or g_envo <> "" then
			bChk3 = "1"
		end if
		if g_step <> "" or g_enep <> "" then
			bChk4 = "1"
		end if
		if g_stpe <> "" or g_enpe <> "" then
			bChk5 = "1"
		end if
		szCode = bChk1 & bChk2 & bChk3 & bChk4 & bChk5
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_TRGT_CLS_CODE" , 0 , szCode )

	end if
end Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6000_011r" then
		Dim nCount
		nCount    	= _tonumber( DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ) )
		
		if nCount == 0 then
			Form.ShowAlert("알림", "검색된 종목이 없습니다.")
			Exit Sub
		end if
		
		for i=0 to nCount-1
		
			Dim szExid, szCode
			szExid  = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FID_COND_MRKT_CLS_CODE" , i)
			szCode  = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FIDX_ISCD" , i)

			Grid0.SetCellData("bd_cell11", g_nIndex + i, szExid.."@"..szCode)
			
			DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , i , szExid.."@"..szCode )
		next
		Grid0.keyall = "1"
'		DATAMANAGER.RequestRealData("ohhts_exst_cntg")
		g_nIndex = _tonumber( Grid0.rowcount )
	end if
end Sub

'============================================================================
Sub Form_OnRefresh()
	g_nPage  = 0
	g_nIndex = 0
	Grid0.SetClear( )
	
	DATAMANAGER.RequestTranData( "ohhts_6000_011r" )
end Sub

'============================================================================
function _tonumber(data)
	return tonumber(data) or 0
end function

'============================================================================
Sub Grid0_OnScrollEnd()
	Dim bNext
	bNext = DATAMANAGER.IsMoreNextData( "ohhts_6000_011r" )
	if bNext == "1" or bNext == true then
		DATAMANAGER.RequestNextData( "ohhts_6000_011r" )
	end if
end Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	Dim sCode
	Dim sKorname
	Dim sExid
	
	sCode 	= Grid0.GetCellData( "bd_cell7", lRow )
	sKorname	= Grid0.GetCellData( "bd_cell0", lRow )
	sExid	= Grid0.GetCellData( "bd_cell4", lRow )
	
	if sCode <> "" then

		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", sExid.."@"..sCode.."★"..sKorName.."★".."", "" )
		Form.OpenScreen("16000", "")
		
	end if
end Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "OPEN_DATA" then
		if sParam <> nil and sParam <> ""	then
			Dim sTemp
			sTemp = Split(sParam, "`")	
			g_nation = sTemp[0]	'국가
			g_market = sTemp[1]	'거래소
			g_stpr = sTemp[2]	'현재가
			g_enpr = sTemp[3]
			g_stsi = sTemp[4]	'시가총액
			g_ensi = sTemp[5]	
			g_stvo = sTemp[6]	'거래량(주)
			g_envo = sTemp[7]
			g_step = sTemp[8]	'EPS
			g_enep = sTemp[9]
			g_stpe = sTemp[10] 'PER
			g_enpe = sTemp[11]
			
		end if
		
		DATAMANAGER.RequestTranData( "ohhts_6000_011r" ) 
	elseif sEventName == "SCREEN_REFRESH" then
		Form_OnRefresh()
	end if
End Sub

