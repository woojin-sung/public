	<SCRIPT_INFO _len="29908" _ulen="27436" >
'----------------------------------------------------------------------------
' 01. 화 면 명 : 서브_종목검색창
' 02. 화면설명 : 주식현재가 종목검색창
'----------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket, g_szIndexName
Dim g_szType 									' 13: 시간외, 그외는 현재가
Dim g_szTranID

Dim g_szCurtouch								' 현재가 터치이동 ( 최근조회종목("0"),관심종목("1"),watching등록종목("2") - 초기값 "0" )
Dim g_szSwingGroup							' 관심종목일경우 관심그룹키
Dim g_szInterest_cloud							' 관심종목동기화(0:로컬, 1:서버)

Dim g_szSearchItems							' 조회종목(최근조회종목, 관심종목, Watching종목)
Dim g_nIndexItem								' 조회종목의 Index
Dim g_bMoveItem								' 화면에서 발생 여부

Dim g_szISSU_STAT_CLS_CODE						'종목상태구분코드

Dim g_szScreenNo '20210823 HSZ CFD현재가 화면 추가

Dim g_nSearchCnt '20211021 아이티젠(김성수) 현재가 개선 추가
g_nSearchCnt = -1

'202305011 KKM START : 상단 관심종목 등록/삭제 추가
Dim g_szGroupID, g_szGroupName, g_nMutilGroup, g_szAction
g_szGroupID = "" 		'관심종목 그룹ID
g_szGroupName = "" 	'관심종목 그룹명
g_nMutilGroup = 0 	'해당 종목이 등록된 관심그룹 갯수
g_szAction = "ADD"	'관심 관련 ACTION
g_nGroupCnt = 0 		'관심그룹 갯수

Dim g_szCloud			' 관심동기화(0:미사용(로컬), 1:사용(서버))

Dim g_szUserId
g_szUserId = Form.GetSharedData("&USER_ID" , false)		
'202305011 KKM END

'20230614 htw start 상단 data 주문과 동일하게 변경
Dim g_szMarketName, g_szGbnName, g_szJPer, g_szSinYn
g_szMarketName = ""
g_szGbnName = ""
g_szJPer = ""
g_szSinYn = ""
