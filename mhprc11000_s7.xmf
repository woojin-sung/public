'============================================================================
' Request_Data
'============================================================================
Function Request_Data(szType,szCd)
	Dim szTranID
	
	If g_szItemCode = "" Then
		Form.ShowAlert("알림", "조회할 종목이 없습니다.")
		Exit Function
	End If
	
	if szType <> g_szType then
		if szCd == g_szItemCode then				' 구분이 다르고, 종목코드가 같은경우
			if szType == "13" then					' 시간외단일가 선택시
				szTranID = "ohhts_1181_002r"
				g_szType = szType
			elseif g_szType == "13" then			' 기존 선택이 시간외 단일가일때
				szTranID = "ohhts_1001_001r"
				g_szType = szType
			Else
				szTranID = "ohhts_1001_001r"
				g_szType = szType
			end if
		end if
	else
		if szCd <> g_szItemCode then				' 구분이 같고, 종목코드가 다른경우
			if szType == "13" then					' 시간외단일가 선택상태일때
				szTranID = "ohhts_1181_002r"
				g_szItemCode = szCd
			else									' 시간외단일가외의 선택상태일때
				szTranID = "ohhts_1001_001r"
				g_szItemCode = szCd
			end if
		Else
			if szType == "13" then					' 시간외단일가 선택상태일때
				szTranID = "ohhts_1181_002r"
			else									' 시간외단일가외의 선택상태일때
				szTranID = "ohhts_1001_001r"
			end if

		end if
	end if
	
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	g_szIndexName  = Form.GetItemCodeInfo( g_szItemCode , "indexname")
	g_szTranID = szTranID
	
'230407 KKM 주석처리 - 기업정보 삭제	
'	If g_szItemMarket = "Q" Or g_szItemMarket = "W" Then
'		btnReport.enable = false
'	Else
'		btnReport.enable = true
'	End If
	
	DATAMANAGER.RequestTranData(g_szTranID)	
	DATAMANAGER.RequestTranData("ohhts_5010_002r"	 )	
	
	'20220607 SWJ START : 서비스 변경 (매수, 매도별 가능 계좌유형 표시)
	'20210823 HSZ START : CFD현재가 화면 추가
	if g_szScreenNo = "13100" or g_szScreenNo = "13200" then
		DATAMANAGER.RequestTranData("obtrc_comm_017r"	 )
	end if
	'20210823 HSZ END
	'20220607 SWJ END
	
	DATAMANAGER.RequestTranData("ohhts_1020_004r"	 )		'20230411 KKM 셀봉(틱) 추가
	
	'202300510 KKM START 관심종목 설정여부 확인
	if g_szCloud == "1" then		' Server 저장시
		DATAMANAGER.RequestTranData("ohhts_intr_101r")	'관심그룹 저장여부 조회
	else							' Local 저장시
		Search_InLocalGroup()							'로컬 관심그룹 내 저장여부 확인
	end if
	'202300510 KKM END 

End Function

'============================================================================
' Set_RotateItem
'============================================================================
Function Set_RotateItem()
	If g_szCurtouch = "0" Then			' 최근조회종목
		Get_History()
	ElseIf g_szCurtouch = "1" Then
	
	ElseIf g_szCurtouch = "2" Then
	
	End If	
End Function

'============================================================================
' Get_History
'============================================================================
Function Get_History()
	Dim szData, arrData, nCnt
	
	If g_szScreenNo = "13100" or g_szScreenNo = "13200" then
		szData = Form.GetRecentHistory("40")
	else
		szData = Form.GetRecentHistory( "1:3:4:5" )
	End if
	
	If Trim( szData ) = "" Then
		Exit Function
	End If
	
	g_szSearchItems = Split(szData,"`")
	
	if UBOUND(g_szSearchItems) < 1 then
	    Exit Function
	End if	
	
	For i = #g_szSearchItems - 1 To 0 Step - 1
		If g_szItemCode = Trim( g_szSearchItems(i) ) Then
			g_nIndexItem = i
			Exit For
		End If
	Next

End Function

'============================================================================
' Move_ItemCode
'============================================================================
Function Move_ItemCode( szType )
	If szType = "Right" Then
		Form.ACRSetProp( "moveitem", "1" )
	ElseIf szType = "Left" Then
		Form.ACRSetProp( "moveitem", "-1" )
	End If
	
End Function


'============================================================================
' SetMarginRate
'============================================================================
Function SetMarginRate( nMARG_RATE )
	g_szIndexName  = Form.GetItemCodeInfo( g_szItemCode , "indexname")
	
	tblInfo.SetCellFgColor( 0, 1, "18")
	
	tblInfo.SetCellString( 0, 0, g_szItemCode )
	tblInfo.SetCellString( 0, 2, g_szIndexName )

	'20210823 HSZ START : CFD현재가 화면 추가
	if g_szScreenNo = "13100" or g_szScreenNo = "13200" then
		tblInfo.SetCellString( 0, 3, "" )
		tblInfo.visible = true
		Label1.visible = false
		Label2.visible = false
		exit function 
	else
		tblInfo.visible = false
		Label1.visible = true
		Label2.visible = true
	end if
	'20210823 HSZ END
	
	Dim 	szItemCodeInfo
	szItemCodeInfo = ""
	Select Case g_szISSU_STAT_CLS_CODE
		'====
		Case "58"		
			szItemCodeInfo = "거래정지"
			tblInfo.SetCellFgColor( 0, 3, 130 )
		Case "61"
			szItemCodeInfo = "정리매매"
			tblInfo.SetCellFgColor( 0, 3, 130 )
		Case "51"	
			szItemCodeInfo = "관리종목"
			tblInfo.SetCellFgColor( 0, 3, 131 )
		Case "63"
			szItemCodeInfo = "단기과열"
			tblInfo.SetCellFgColor( 0, 3, 131 )
		Case "52"
			szItemCodeInfo = "투자위험"
			tblInfo.SetCellFgColor( 0, 3, 131 )
		Case "53"		
			szItemCodeInfo = "투자경고"
			tblInfo.SetCellFgColor( 0, 3, 131 )
		Case "65"
			szItemCodeInfo = "투자유의"
			tblInfo.SetCellFgColor( 0, 3, 131 )
		Case "54"
			szItemCodeInfo = "투자주의"
			tblInfo.SetCellFgColor( 0, 3, 131 )
		Case "64"
			szItemCodeInfo = "투자환기"
			tblInfo.SetCellFgColor( 0, 3, 131 )
'		Case "55"
'			szItemCodeInfo = "신용가능 증" + nMARG_RATE + "%"	'신용주문가능
'			tblInfo.SetCellFgColor( 0, 3, 133 )
'		Case "57"		
'			szItemCodeInfo = "증거금율 " + nMARG_RATE + "%"	'증거금율
'			tblInfo.SetCellFgColor( 0, 3, 128 )
		Case "56"
			szItemCodeInfo = "신용초과"
			tblInfo.SetCellFgColor( 0, 3,  13 )
		Case "62"
			szItemCodeInfo = "투자주의"	'ELW
			tblInfo.SetCellFgColor( 0, 3,  13 )
		Case "60"
			szItemCodeInfo = "조기종료" 'ELW
			tblInfo.SetCellFgColor( 0, 3,  13 )
	End Select
	g_szGbnName = szItemCodeInfo
	g_szJPer = "증"..nMARG_RATE
	f_SetTopCaption()
	tblInfo.SetCellString( 0, 3, szItemCodeInfo )
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
function f_SetTopCaption()
	Dim szText, nSize
	szText = ""
	szText2 = ""
	nSize = 0
	
	Dim nLen3,nLen4,nLen5
	Dim nDataStart3,nDataStart4,nDataStart5
	szText = g_szItemCode .. "  ".. g_szMarketName
	'20230614 htw start etf의 경우 업종명 안 나오므로 조건문 처리
	if g_szIndexName <> "" then
		szText = szText .. "  "..g_szIndexName
	end if
	'20230614 htw end etf의 경우 업종명 안 나오므로 조건문 처리
	if g_szJPer <> "" then
		lblLen.caption = g_szJPer
		nLen4 = lblLen.GetLen(g_szJPer)
		
		lblLen.caption = szText2
		nDataStart4 = lblLen.GetLen(szText2) + 3
		
		szText2 = g_szJPer
	end if
	
	if g_szSinYn <> "" then
		lblLen.caption = g_szSinYn
		nLen5 = lblLen.GetLen(g_szSinYn)
		
		lblLen.caption = szText2
		nDataStart5 = lblLen.GetLen(szText2) + 3
		
		szText2 = szText2 .. "   "..g_szSinYn
	end if
	
	if g_szGbnName <> "" then
		lblLen.caption = g_szGbnName
		nLen3 = lblLen.GetLen(g_szGbnName)
		
		lblLen.caption = szText2
		nDataStart3 = lblLen.GetLen(szText2) + 3
		
		szText2 = szText2 .. "   "..g_szGbnName
	end if

	Label1.caption = szText
	Label2.caption = szText2
	
	Dim szColor
	Select Case g_szGbnName
		Case "관리종목"	
			szColor = "131"
		Case "투자위험"
			szColor = "131"
		Case "투자경고"		
			szColor = "131"
		Case "투자주의"
			szColor = "131"
'		Case "신용가능"
'			szColor = "133"
		Case "신용초과"
			szColor = "13"
'		Case "증거금율"		
'			szColor = "128"
		'20230613 htw end 신용가능(55) 증거금율(57) 삭제 + 종목코드 표시 제거 + 순서변경
		Case "거래정지"		
			szColor = "130"
		Case "정리매매"
			szColor = "130"
		Case "단기과열"
			szColor = "131"
		Case "투자환기"
			szColor = "131"
		Case "투자유의"
			szColor = "131"
	End Select
	
	if Trim(g_szGbnName) <> "" then
		Label2.changeTextAttr(nDataStart3,nLen3,326,-4,0)			'HTS와 달리 전체구분명 표시하므로 색상 통일
	else
		Label2.changeTextAttr(0,lblLen.GetLen(szText2),4,-4,0)		'iOS 속성 남아있는 현상 조치
	end if
	
	if "신용불가" == g_szSinYn then
		Label2.changeTextAttr(nDataStart5,nLen5,6,-4,0)
	end if
	
end function
'============================================================================
Sub Form_OnFormInitBefore()
	g_szCurtouch		 = Form.GetEnvData( "common.curtouch_swing" 		)	' 현재가 터치이동
	g_szSwingGroup	 = Form.GetEnvData( "common.curtouch_swing_group"	)	' 관심종목일경우 관심그룹키
	g_szInterest_cloud = Form.GetEnvData( "common.interest_cloud" 		)	' 관심종목동기화(0:로컬, 1:서버)
	g_szScreenNo 		 = Form.GetSharedData( "&SCREEN_NO" , false )			' 화면번호 '20210823 HSZ
	
	If g_szCurtouch = "" Then
		g_szCurtouch = "0"
	End If
	
	If g_szSwingGroup = "" Then
		g_szSwingGroup = ""
	End If
	
'	Form.ShowAlert(g_szInterest_cloud, g_szSwingGroup)
	
	If g_szInterest_cloud = "" Then
		g_szInterest_cloud = "0"
	End If
	
	ChartEx1.SetChartType("line")
	ChartEx1.SetPeriodType("1")
	ChartEx1.SetPeriodTime("5")
	
	'20230413 KKM START
	imgMemo.SetMaintainingRatio("1")
	Form.SetInterestTitle("N")		'비활성화로 기본 세팅
	'20230413 KKM END
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_bMoveItem 	= true
	g_nIndexItem = 0
'	Set_RotateItem()

	'20210823 HSZ START : CFD현재가 화면 추가
	if g_szScreenNo = "13100" or g_szScreenNo = "13200" then
		TblCFD.visible = true
	else
		TblCFD.visible = false
	end if
	'20210823 HSZ END
	
	'관심 관련 세팅
	g_szCloud = Form.GetEnvData("common.interest_cloud")	' 관심 동기화 
	if Trim(g_szCloud) == "" then						' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if

	if g_szCloud == "1" then		' Server 저장시		
		DATAMANAGER.RequestTranData("ohhts_intr_006r")
	else							' Local 저장시
		Load_GWGroup()
	end if
	'20230419 KKM END

End Sub

'============================================================================
' Form_OnLinkData
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then		
		If g_bMoveItem = true Then
			Request_Data(g_szType, sValue)
		End If
	end	if
End Sub

'============================================================================
'	20211110 HSZ START 실시간 호출하는 TR에서만 Cancel하도록 로직 수정
Sub Clear_Tblhoga() 'Table Clear

	'20211117 아이티젠 김성수 추가 START
	Table0.SetCellString( 0, 1, "") '현재가
	Table0.SetCellString( 1, 3, "") '등락률
	Table1.SetCellString( 0, 0, "") '거래량
	Table1.SetCellString( 0, 1, "") '거래량비율
	'20211117 아이티젠 김성수 추가 END
	
	'20230616 HSZ START 종목정보 세팅 clear
	Label1.caption = " "
	Label2.caption = " "
	g_szMarketName = ""
	g_szGbnName = ""
	g_szJPer = ""
	g_szSinYn = ""
'	20230616 HSZ END
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	If szTranID = "ohhts_1001_001r" then
		Call Clear_Tblhoga()
		DATAMANAGER.CancelRealData( "ohhts_marg_rate" )
'		DATAMANAGER.CancelRealData( "ohhts_stck_cntg" )
		DATAMANAGER.CancelRealData( "ohhts_stck_incg" ) '20220208 HSZ 시세속도 개선
		DATAMANAGER.CancelRealData( "ohhts_elw_cntg"  )
		DATAMANAGER.CancelRealData( "ohhts_frbr_cntg" )
		DATAMANAGER.CancelRealData( "ohhts_ovtp_cntg" )
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket 	)
	
	ElseIf szTranID = "ohhts_1181_002r" then
		Call Clear_Tblhoga()
		DATAMANAGER.CancelRealData( "ohhts_marg_rate" )
'		DATAMANAGER.CancelRealData( "ohhts_stck_cntg" )
		DATAMANAGER.CancelRealData( "ohhts_stck_incg" ) '20220208 HSZ 시세속도 개선
		DATAMANAGER.CancelRealData( "ohhts_elw_cntg"  )
		DATAMANAGER.CancelRealData( "ohhts_frbr_cntg" )
		DATAMANAGER.CancelRealData( "ohhts_ovtp_cntg" )
'	20211110 HSZ END
		DATAMANAGER.SetDataValue( 0, "ohhts_1181_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1181_002r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
		
	ElseIf szTranID = "ohhts_5010_002r" then
		Dim szToday
		szToday = Form.GetSharedData("&HOST_DATE", 0 )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode	)

		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_ISCD" 				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" 	, 0 , "0"			)	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_DATE1" 			, 0 , szToday			)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" 		, 0 , "300"			)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" 	, 0 , "N"			)	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_002r", "InBlock2", "FID_INPUT_VRTL_TICK_INCU_YN" 	, 0 , "N"			)
	
	'20220607 SWJ START : 서비스 변경(매수, 매도별 가능한 계좌유형 표시)
	ElseIf szTranID = "obtrc_comm_017r" then
		szToday = Form.GetSharedData("&HOST_DATE", 0 )
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "STND_DATE"					, 0 , szToday			)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "ISCD" 						, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "MRKT_DIV_CLS_CODE"			, 0 , "%"			)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "STA_RATE"					, 0 , "0"			)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "FIN_RATE"					, 0 , "100"			)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "BYOV_ABLE_YN"				, 0 , "Y"			)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "SELN_ABLE_YN"				, 0 , "Y"			)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_017r", "InBlock1", "EXLS_YN"					, 0 , "N"			)
	'20220607 SWJ END
	
	ElseIf szTranID = "ohhts_1020_004r" then   '20230412 KKM 셀봉추가(틱)
		DATAMANAGER.SetDataValue( 0, "ohhts_1020_004r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1020_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket 	)	
	
	'202300510 KKM START : 관심종목 설정
	ElseIf szTranID = "ohhts_intr_101r" then
		grdGroup.rowcount = 0	' 관심종목그룹 초기화
		g_szGroupID = "" 
		g_szGroupName = ""	
		grdList.rowcount = 0	' 종목그리드 초기화
	
		DATAMANAGER.SetDataValue( 0, "ohhts_intr_101r", "InBlock1", "FID_USER_ID"				, 0 , g_szUserId 		)
		DATAMANAGER.SetDataValue( 0, "ohhts_intr_101r", "InBlock1", "FID_OVDV_ISCD"				, 0 , g_szItemCode	)
		'20230816 KKM 입력시장구분코드 추가
		DATAMANAGER.SetDataValue( 0, "ohhts_intr_101r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE"		, 0 , g_szItemMarket	)	
	ElseIf szTranID == "ohhts_intr_006r" then
		grdGroup.rowcount = 0	' 관심종목그룹 초기화
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID"					, 0 , g_szUserId 		)	
	'202300510 KKM END	
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)

	if szTranID =  "ohhts_stck_incg" then '"ohhts_stck_cntg" then 20220208 HSZ 시세속도 개선
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD"  , 0 , g_szItemCode )
		
	elseif szTranID = "ohhts_elw_cntg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD"  , 0 , g_szItemCode )

	elseif szTranID = "ohhts_frbr_cntg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD"  , 0 , g_szItemCode )
		
	elseif szTranID = "ohhts_ovtp_cntg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_ovtp_cntg", "InBlock1", "RLTM_SHRN_ISCD"  , 0 , g_szItemCode )
	
	elseif szTranID = "ohhts_marg_rate" then
		DATAMANAGER.SetDataValue( 1, "ohhts_marg_rate", "InBlock1", "FIDR_SHRN_ISCD"  , 0 , g_szItemCode )
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	If szTranID = "ohhts_1001_001r" Then
		Dim	nMARG_RATE				'증거금율
		Dim 	nPrice					'전일대비
		g_szMarketName = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_RPRS_MRKT_KOR_NAME" , 0 )
		g_szISSU_STAT_CLS_CODE 	= DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_ISSU_STAT_CLS_CODE" , 0 )
		nMARG_RATE				= CInt( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_MARG_RATE" , 0 ) )
		
		nPrice = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_PRDY_VRSS" , 0 )
		
		'20230614 htw start 상단 data 주문과 동일하게 변경
		szFID_CRDT_ABLE_YN = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_CRDT_ABLE_YN" , 0 )
		
		if szFID_CRDT_ABLE_YN == "Y" then
			g_szSinYn = "신45"
		elseif szFID_CRDT_ABLE_YN == "N" then
			g_szSinYn = "신용불가"
		end if
		'20230614 htw end 상단 data 주문과 동일하게 변경
		SetMarginRate( nMARG_RATE )
		
		if g_szItemMarket = "W" then
			DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
			
		'20180712 HAMWG START : K-OTC MTS 도입
		elseif g_szItemMarket = "T" then
			DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
		'20180712 HAMWG END
			
		else
'			DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
			DATAMANAGER.RequestRealData( "ohhts_stck_incg" ) '20220208 HSZ 시세속도 개선
		
		end if
		
		DATAMANAGER.RequestRealData( "ohhts_marg_rate" )
'		DATAMANAGER.RequestTranData("ohhts_5010_002r"	 )
	ElseIf szTranID = "ohhts_1181_002r" Then
		'20230614 htw start 상단 data 주문과 동일하게 변경
		g_szMarketName = DATAMANAGER.GetDataValue( 0, "ohhts_1181_002r", "OutBlock1", "FID_RPRS_MRKT_KOR_NAME" , 0 )
		dim szFID_CRDT_ABLE_YN			'신용가능여부
		
		'20230613 htw start 증거금율, 신용가능여부 TR data 추가
		szFID_CRDT_ABLE_YN = DATAMANAGER.GetDataValue( 0, "ohhts_1181_002r", "OutBlock1", "FID_CRDT_ABLE_YN" , 0 )
		nMARG_RATE		= CInt( DATAMANAGER.GetDataValue( 0, "ohhts_1181_002r", "OutBlock1", "FID_MARG_RATE" , 0 ) )
		SetMarginRate( nMARG_RATE )
		
		if szFID_CRDT_ABLE_YN == "Y" then
			g_szSinYn = "신45"
		elseif szFID_CRDT_ABLE_YN == "N" then
			g_szSinYn = "신용불가"
		end if
		'20230614 htw end 상단 data 주문과 동일하게 변경
		DATAMANAGER.RequestRealData( "ohhts_ovtp_cntg" )
		
	ElseIf szTranID = "ohhts_5010_002r" Then		
		DATAMANAGER.RequestTranData( g_szTranID )
	
	'20221007 SWJ START : 매수/매도가능 표시 기준 및 방식 변경(서비스에서 로직)
	'20210823 HSZ START : CFD현재가 화면 추가
	ElseIf szTranID = "obtrc_comm_017r" Then	
		cfd_buy = DATAMANAGER.GetDataValue( 0, "obtrc_comm_017r", "OutBlock1", "BYOV_ABLE_ACNT_CLCD" , 0 )
		cfd_sell = DATAMANAGER.GetDataValue( 0, "obtrc_comm_017r", "OutBlock1", "SELN_ABLE_ACNT_CLCD" , 0 )
'		cfd_mrgt = DATAMANAGER.GetDataValue( 0, "obtrc_comm_017r", "OutBlock1", "CFD_MGRT" , 0 )
'		cfd_rgrp = DATAMANAGER.GetDataValue( 0, "obtrc_comm_017r", "OutBlock1", "CFD_ISSU_RISK_GRP_CODE" , 0 )
		
		'20230109 SWJ START : 양도소득 추가
		cfd_tax  = DATAMANAGER.GetDataValue( 0, "obtrc_comm_017r", "OutBlock1", "TRNF_INCM_TXTN_CLCD" 		, 0 )
		'20230412 아이티젠(김경민) : 증거금율
		cfd_mgrt  = DATAMANAGER.GetDataValue( 0,  "obtrc_comm_017r", "OutBlock1", "CFD_MGRT"		, 0 )
		
		'비과세
		if cfd_tax = "0" then
			cfd_tax = "비과세"
		'과세 (기본값 : 1)
		else
			cfd_tax = "과세"
		end if
		'20230109 SWJ END

		TblCFD.SetCellString(0, 1, cfd_buy)
		TblCFD.SetCellString(1, 1, cfd_sell)
		TblCFD.SetCellString(0, 4, cfd_mgrt)		'20230412 아이티젠(김경민) : 증거금율
		TblCFD.SetCellString(1, 4, cfd_tax)		'20230109 SWJ START
		
	'20210823 HSZ END
	'20221007 SWJ END

	'202300510 KKM START : 관심종목 설정
	ElseIf szTranID = "ohhts_intr_101r" then		'관심그룹 저장 여부 조회
		cnt = DATAMANAGER.GetDataCount(0, "ohhts_intr_101r", "OutBlock1")		
		if cnt > 0 then
			g_nMutilGroup = cnt '해당 종목이 등록된 관심그룹 갯수
			Form.SetInterestTitle("Y")
			if cnt == 1 then 
				g_szGroupID = DATAMANAGER.GetDataValue( 0, "ohhts_intr_101r", "OutBlock1", "FID_CNCN_ISSU_GRP_ID", 0 ) 
				g_szGroupName = DATAMANAGER.GetDataValue( 0, "ohhts_intr_101r", "OutBlock1", "FID_CNCN_GRP_NAME", 0 ) 
			end if 
'Form.ShowAlert("ohhts_intr_101r ::: " & g_szGroupID & "★" & g_szGroupName)
		else
			g_nMutilGroup = 0
			Form.SetInterestTitle("N")
			g_szGroupID = ""
			g_szGroupName = ""
			grdList.rowcount = 0	' 종목그리드 초기화			
		end if		
		
	ElseIf szTranID == "ohhts_intr_006r" then  '관심그룹 조회
		g_nGroupCnt = DATAMANAGER.GetDataCount(0, "ohhts_intr_006r", "OutBlock1")
		Load_GWGroup()
		
	'202300510 KKM END	
	End If
	g_bMoveItem 	= true
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	Dim	nMARG_RATE				'증거금율

	If szTranID = "ohhts_marg_rate" Then
		nMARG_RATE = CInt( DATAMANAGER.GetDataValue( 1, "ohhts_marg_rate", "OutBlock1", "FIDR_MARG_RATE" , 0 ) )
		
		SetMarginRate( nMARG_RATE )
	End If	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szType
	
	if sEventName = "sharedata" then
		Dim szFlag
	
		sName = Form.GetItemCodeInfo(g_szItemCode, "name")
		sCurpirce = FormatNumber( tblHoga.GetCellString(0, 0),  0)
		
		If CDbl(tblHoga.GetCellString(0, 3)) > 0 Then
			szFlag	= "▲"			
		ElseIf CDbl(tblHoga.GetCellString(0, 3)) < 0 Then
			szFlag	= "▼"
		Else
			szFlag	= ""
		End If
		
		sDiff    = FormatNumber( abs(tblHoga.GetCellString(0, 3)),  0)		
		sRate     = FormatNumber( tblHoga.GetCellString(1, 2),  2)
		sQuqn	 = FormatNumber( tblHoga.GetCellString(1, 1),  0)
		szParam = sName.."\n"..sCurpirce.."원\n ("..szFlag..sDiff.." / "..sRate.."% / "..sQuqn..")"
		Form.triggerEvent("#", "sharedata", szParam)
	end if
	
	'202300510 KKM START: 관심종목 설정
	if sEventName = "CLICK_GWANSIM" then
		'20230525 KKM START : 관심그룹등록/종목등록/종목삭제(전체)
		if g_nGroupCnt == 0 then			'관심그룹추가+관심종목추가 
			Form.triggerEvent("#", "mhprc11000_pf_popup", "GROUP_ADD2")			
		else
			if g_nMutilGroup > 0 then 
				'관심종목 삭제 화면 팝업
				g_szAction = "DEL"
				Form.triggerEvent("#", "mhprc11000_pe_popup", "DEL")			
			else
				'관심종목 등록 화면 팝업
				g_szAction = "ADD"
				Form.triggerEvent("#", "mhprc11000_pd_popup", "ADD")
			end if 
		
		end if 

	elseif sEventName = "mhprc11000_save" then 		'관심등록/삭제/관심그룹과관심등록 완료 후	
		szInstr = CInt(Instr(sParam, "★"))
		if szInstr > 0 and Trim(sParam) <> "" then	'Split 전 체크방어로직 추가
			tList = Split(sParam, "★") 
			if tList(2) == "ADD" or tList(2) == "GROUP_ADD2" then 		
				Form.SetInterestTitle("Y")
				g_szGroupID = tList(0)
				g_szGroupName = tList(1)
			elseif tList(2) == "DEL" then 	
				Form.SetInterestTitle("N")
				g_szGroupID = ""
				g_szGroupName = ""		
			end if
		else
			exit Sub
 		end if
		
		'관심그룹 관련 TR RELOAD
		if g_szCloud == "1" then		' Server 저장시
			DATAMANAGER.RequestTranData("ohhts_intr_006r")
			DATAMANAGER.RequestTranData("ohhts_intr_101r")
		else							' Local 저장시
			Load_GWGroup()
			Search_InLocalGroup()
		end if

	End If
	'20230525 KKM END
	
	If sEventName = "12000_BUYTYPE" then
		szType = Form.GetSharedData("STOCK_BUYTYPE", false )
	ElseIf sEventName = "12000_SELTYPE" then
		szType = Form.GetSharedData("STOCK_SELTYPE", false )
	ElseIf sEventName = "12000_MODTYPE" then
		szType = Form.GetSharedData("STOCK_MODTYPE", false )
	ElseIf sEventName = "12000_CNLTYPE" then
		szType = Form.GetSharedData("STOCK_CNLTYPE", false )
	ElseIf sEventName = "HOGA_TYPE" then
		szType = sParam
	End If
	
	if szType <> nil and szType <> "" and #szType > 0 then		
		Request_Data(szType, g_szItemCode)
	end if

End Sub

