				<CONTAINER name="cont3" ly_vert="20,120,335,60,1" scroll_ly_vert="20,120,335,60,1" >
					<CONTROL_INFO>
						<LABEL name="lblTitle0" fontstyle="01" caption="Q." click="1" ly_vert="0,0,24,60,1" />
						<LABEL name="lblTitle" caption="채권의 매수금리란?" click="1" ly_vert="20,0,345,60,1" />
						<IMAGE name="imgArrow" autosize="1" imgpath="icon_arrow_down2" ly_vert="311,23,14,14,1" />
						<LABEL name="lblLine" bgcolor="320:246247248" transmode="0" ly_vert="0,59,335,1,1" />
						<TABLE name="Table0" insidelinecolor="090:238239240" colcount="3" rowcount="12" outline="0101" designorder="1" ly_vert="0,60,345,240,1" >
							<COL_INFO ly_vert_width="15,20,310" />
							<ROW_INFO ly_vert_height="20,20,20,20,20,20,20,20,20,20,20,20" />
							<CELL_INFO>
								<CELL cell_ly="0,0,0,0" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,0,1,0" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,0,2,0" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="0,1,0,1" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,1,1,1" bgcolor="320:246247248" halign="0" line="0,0" caption="A." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="2,1,2,1" bgcolor="320:246247248" halign="0" line="0,0" caption="매수 금리는 채권의 가격을 나타냅니다. 매수" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,2,0,2" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,2,1,2" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,2,2,2" bgcolor="320:246247248" halign="0" line="0,0" caption="금리가 표면금리(발행했을 때의 금리)보다" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,3,0,3" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,3,1,3" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,3,2,3" bgcolor="320:246247248" halign="0" line="0,0" caption="높은 경우는 채권의 가격이 낮다는 것을 의미" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,4,0,4" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,4,1,4" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,4,2,4" bgcolor="320:246247248" halign="0" line="0,0" caption="합니다. 시중금리 변동에 따라 매수 금리 또한" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,5,0,5" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,5,1,5" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,5,2,5" bgcolor="320:246247248" halign="0" line="0,0" caption="변경됩니다. 매수 금리는 채권의 현금흐름의" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,6,0,6" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,6,1,6" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,6,2,6" bgcolor="320:246247248" halign="0" line="0,0" caption="현재가치와 그 채권의 가격을 일치시켜주는" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,7,0,7" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,7,1,7" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,7,2,7" bgcolor="320:246247248" halign="0" line="0,0" caption="할인율로서 만기까지 보유 시 획득하게 되는 " fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,8,0,8" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,8,1,8" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,8,2,8" bgcolor="320:246247248" halign="0" line="0,0" caption="수익률을 의미합니다. 또한 매수 금리는 채권" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,9,0,9" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,9,1,9" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,9,2,9" bgcolor="320:246247248" halign="0" line="0,0" caption="의 가격을 나타내는 시장금리 변동, 신용등급" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,10,0,10" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,10,1,10" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,10,2,10" bgcolor="320:246247248" halign="0" line="0,0" caption="변경 등의 요인에 따라 만기 전까지 변동됩니다." fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,11,0,11" bgcolor="320:246247248" line="0,1" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,11,1,11" bgcolor="320:246247248" line="0,1" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,11,2,11" bgcolor="320:246247248" line="0,1" fontsize="-2" impidxs="" />
							</CELL_INFO>
						</TABLE>
					</CONTROL_INFO>
				</CONTAINER>
				<CONTAINER name="cont4" ly_vert="20,180,335,60,1" scroll_ly_vert="20,180,335,60,1" >
					<CONTROL_INFO>
						<LABEL name="lblTitle0" fontstyle="01" caption="Q." click="1" ly_vert="0,0,24,60,1" />
						<LABEL name="lblTitle" caption="채권의 상환 순위는 어떻게 되나요?" click="1" ly_vert="20,0,345,60,1" />
						<IMAGE name="imgArrow" autosize="1" imgpath="icon_arrow_down2" ly_vert="311,23,14,14,1" />
						<LABEL name="lblLine" bgcolor="320:246247248" transmode="0" ly_vert="0,59,335,1,1" />
						<TABLE name="Table0" insidelinecolor="090:238239240" colcount="3" rowcount="8" outline="0101" designorder="1" ly_vert="0,60,345,160,1" >
							<COL_INFO ly_vert_width="15,20,310" />
							<ROW_INFO ly_vert_height="20,20,20,20,20,20,20,20" />
							<CELL_INFO>
								<CELL cell_ly="0,0,0,0" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,0,1,0" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,0,2,0" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="0,1,0,1" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,1,1,1" bgcolor="320:246247248" halign="0" line="0,0" caption="A." fontsize="-2" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="2,1,2,1" bgcolor="320:246247248" halign="0" line="0,0" caption="채권의 상환 순위는 선순위채와 후순위채로" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,2,0,2" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,2,1,2" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,2,2,2" bgcolor="320:246247248" halign="0" line="0,0" caption="분류합니다. 채권을 발행한 기업이 파산하면" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,3,0,3" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,3,1,3" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,3,2,3" bgcolor="320:246247248" halign="0" line="0,0" caption="기업은 보유자산을 팔아 채무자에게 상환합" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,4,0,4" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,4,1,4" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,4,2,4" bgcolor="320:246247248" halign="0" line="0,0" caption="니다. 이때 선순위채권을 산 사람들에게 먼저" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,5,0,5" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,5,1,5" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,5,2,5" bgcolor="320:246247248" halign="0" line="0,0" caption="상환하며, 남아있는 자산을 후순위 투자자에" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,6,0,6" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,6,1,6" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,6,2,6" bgcolor="320:246247248" halign="0" line="0,0" caption="게 상환해 드립니다." fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,7,0,7" bgcolor="320:246247248" line="0,1" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,7,1,7" bgcolor="320:246247248" line="0,1" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,7,2,7" bgcolor="320:246247248" line="0,1" fontsize="-2" impidxs="" />
							</CELL_INFO>
						</TABLE>
					</CONTROL_INFO>
				</CONTAINER>
				<CONTAINER name="cont5" ly_vert="20,240,335,60,1" scroll_ly_vert="20,240,335,60,1" >
					<CONTROL_INFO>
						<LABEL name="lblTitle0" fontstyle="01" caption="Q." click="1" ly_vert="0,0,24,60,1" />
						<LABEL name="lblTitle" caption="채권의 수량(액면)이란?" click="1" ly_vert="20,0,345,60,1" />
