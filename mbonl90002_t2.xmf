								<CELL cell_ly="2,1,2,1" bgcolor="320:246247248" halign="0" line="0,0" caption="채권의 표면금리란 채권을 발행할 때 발행자가" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,2,0,2" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,2,1,2" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,2,2,2" bgcolor="320:246247248" halign="0" line="0,0" caption="지급 하기로 약정한 이자율로 연 이율로 표기" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,3,0,3" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,3,1,3" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,3,2,3" bgcolor="320:246247248" halign="0" line="0,0" caption="됩니다. 표면금리에 따라 고정적으로 받을 수" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,4,0,4" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,4,1,4" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,4,2,4" bgcolor="320:246247248" halign="0" line="0,0" caption="있는 이자가 결정됩니다. 표면금리 3% 채권을" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,5,0,5" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,5,1,5" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,5,2,5" bgcolor="320:246247248" halign="0" line="0,0" caption="1억 보유하는 경우, 매년 1억 x 3%인 300만원의" fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,6,0,6" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,6,1,6" bgcolor="320:246247248" halign="0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="2,6,2,6" bgcolor="320:246247248" halign="0" line="0,0" caption="이자를 받을 수 있습니다." fontsize="-2" paddinginfo="6,0,0,0" impidxs="" />
								<CELL cell_ly="0,7,0,7" bgcolor="320:246247248" halign="0" line="0,1" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,7,1,7" bgcolor="320:246247248" halign="0" line="0,1" fontsize="-2" impidxs="" />
