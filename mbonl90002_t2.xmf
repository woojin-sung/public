'============================================================================
Function f_ResetContPos()
	'모든 컨테이너 위치 초기화
	g_bExpand = false
	g_szFold = ""
	
	contMain.cont1.imgArrow.imgpath = "icon_arrow_down2"
	contMain.cont2.imgArrow.imgpath = "icon_arrow_down2"
	contMain.cont3.imgArrow.imgpath = "icon_arrow_down2"
	contMain.cont4.imgArrow.imgpath = "icon_arrow_down2"
	contMain.cont5.imgArrow.imgpath = "icon_arrow_down2"
	contMain.cont6.imgArrow.imgpath = "icon_arrow_down2"
	contMain.cont7.imgArrow.imgpath = "icon_arrow_down2"
	contMain.cont8.imgArrow.imgpath = "icon_arrow_down2"
	contMain.cont9.imgArrow.imgpath = "icon_arrow_down2"
	
'	contMain.cont1.top = 0
'	contMain.cont2.top = Form.GetCtlProp(contMain.cont1, "top") + DEFAULT_HEIGHT
'	contMain.cont3.top = Form.GetCtlProp(contMain.cont2, "top") + DEFAULT_HEIGHT
'	contMain.cont4.top = Form.GetCtlProp(contMain.cont3, "top") + DEFAULT_HEIGHT
'	contMain.cont5.top = Form.GetCtlProp(contMain.cont4, "top") + DEFAULT_HEIGHT
'	contMain.cont6.top = Form.GetCtlProp(contMain.cont5, "top") + DEFAULT_HEIGHT
'	contMain.cont7.top = Form.GetCtlProp(contMain.cont6, "top") + DEFAULT_HEIGHT
'	contMain.cont8.top = Form.GetCtlProp(contMain.cont7, "top") + DEFAULT_HEIGHT
'	contMain.cont9.top = Form.GetCtlProp(contMain.cont8, "top") + DEFAULT_HEIGHT
	
	contMain.cont1.height = DEFAULT_HEIGHT
	contMain.cont2.height = DEFAULT_HEIGHT
	contMain.cont3.height = DEFAULT_HEIGHT
	contMain.cont4.height = DEFAULT_HEIGHT
	contMain.cont5.height = DEFAULT_HEIGHT
	contMain.cont6.height = DEFAULT_HEIGHT
	contMain.cont7.height = DEFAULT_HEIGHT
	contMain.cont8.height = DEFAULT_HEIGHT
	contMain.cont9.height = DEFAULT_HEIGHT
	
	contMain.SetScrollAutoSize()
End Function 


'============================================================================
Function f_ExpandArea(szTarget)
	Dim tHeights
	
	tHeights = {180, 220, 300, 220, 220,
			   300, 160, 435}
	
'	Form.ShowAlert("f_ExpandArea1", szTarget & " : " & g_bExpand)
	
	'선택된 컨테이너 펼쳐보기 처리
	If szTarget == "1" Then
		If g_bExpand Then
			g_bExpand = false
'			Form.ShowAlert("f_ExpandArea2", g_bExpand)
			
			contMain.cont1.imgArrow.imgpath = "icon_arrow_down2"
			
			contMain.cont1.height = DEFAULT_HEIGHT
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont1.top, "1"))

		Else
			g_bExpand = true
			
'			contMain.cont1.imgArrow.imgpath = "icon_arrow_up2"
			contMain.cont1.imgArrow.imgpath = "rght_icon_arrow_up2"
			
			contMain.cont1.height = tHeights[CInt(szTarget) - 1]
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont1.top, "1"))
		End If
		
	ElseIf szTarget == "2" Then
		If g_bExpand Then
			g_bExpand = false
			
			contMain.cont2.imgArrow.imgpath = "icon_arrow_down2"
			
			contMain.cont2.height = DEFAULT_HEIGHT
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont2.top, "1"))
		Else
			g_bExpand = true
			
			contMain.cont2.imgArrow.imgpath = "rght_icon_arrow_up2"
			
			contMain.cont2.height = tHeights[CInt(szTarget) - 1]
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont2.top, "1"))
		End If
	
	ElseIf szTarget == "3" Then
		If g_bExpand Then
			g_bExpand = false
			
			contMain.cont3.imgArrow.imgpath = "icon_arrow_down2"
			
			contMain.cont3.height = DEFAULT_HEIGHT
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont3.top, "1"))
		Else
			g_bExpand = true
			
			contMain.cont3.imgArrow.imgpath = "rght_icon_arrow_up2"
			
			contMain.cont3.height = tHeights[CInt(szTarget) - 1]
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont3.top, "1"))
		End If
	elseIf szTarget == "4" Then
		If g_bExpand Then
			g_bExpand = false
			
			contMain.cont4.imgArrow.imgpath = "icon_arrow_down2"
			
			contMain.cont4.height = DEFAULT_HEIGHT
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont1.top, "1"))
		Else
			g_bExpand = true
			
			contMain.cont4.imgArrow.imgpath = "rght_icon_arrow_up2"
			
			contMain.cont4.height = tHeights[CInt(szTarget) - 1]
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont1.top, "1"))
		End If
		
	ElseIf szTarget == "5" Then
		If g_bExpand Then
			g_bExpand = false
			
			contMain.cont5.imgArrow.imgpath = "icon_arrow_down2"
			
			contMain.cont5.height = DEFAULT_HEIGHT
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont2.top, "1"))
		Else
			g_bExpand = true
			
			contMain.cont5.imgArrow.imgpath = "rght_icon_arrow_up2"
			
			contMain.cont5.height = tHeights[CInt(szTarget) - 1]
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont2.top, "1"))
		End If
	
	ElseIf szTarget == "6" Then
		If g_bExpand Then
			g_bExpand = false
			
			contMain.cont6.imgArrow.imgpath = "icon_arrow_down2"
			
			contMain.cont6.height = DEFAULT_HEIGHT
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont3.top, "1"))
		Else
			g_bExpand = true
			
			contMain.cont6.imgArrow.imgpath = "rght_icon_arrow_up2"
			
			contMain.cont6.height = tHeights[CInt(szTarget) - 1]
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont3.top, "1"))
		End If
	
	elseIf szTarget == "7" Then
		If g_bExpand Then
			g_bExpand = false
			
			contMain.cont7.imgArrow.imgpath = "icon_arrow_down2"
			
			contMain.cont7.height = DEFAULT_HEIGHT
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont1.top, "1"))
		Else
			g_bExpand = true
			
			contMain.cont7.imgArrow.imgpath = "rght_icon_arrow_up2"
			
			contMain.cont7.height = tHeights[CInt(szTarget) - 1]
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont1.top, "1"))
		End If
		
	ElseIf szTarget == "8" Then
		If g_bExpand Then
			g_bExpand = false
			
			contMain.cont8.imgArrow.imgpath = "icon_arrow_down2"
			
			contMain.cont8.height = DEFAULT_HEIGHT
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont2.top, "1"))
		Else
			g_bExpand = true
			
			contMain.cont8.imgArrow.imgpath = "rght_icon_arrow_up2"
			
			contMain.cont8.height = tHeights[CInt(szTarget) - 1]
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont2.top, "1"))
		End If
	
	ElseIf szTarget == "9" Then
		If g_bExpand Then
			g_bExpand = false
			
			contMain.cont9.imgArrow.imgpath = "icon_arrow_down2"
			
			contMain.cont9.height = DEFAULT_HEIGHT
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.cont3.top, "1"))
		Else
			g_bExpand = true
			
			contMain.cont9.imgArrow.imgpath = "rght_icon_arrow_up2"
			
			contMain.cont9.height = tHeights[CInt(szTarget) - 1]
