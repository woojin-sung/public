						<TABLE name="Table0" insidelinecolor="090:238239240" colcount="3" rowcount="6" outline="0101" designorder="1" ly_vert="0,60,335,120,1" >
							<COL_INFO ly_vert_width="15,20,300" />
							<ROW_INFO ly_vert_height="20,20,20,20,20,20" />
