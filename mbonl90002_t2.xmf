		End If
		
	End If
	
	g_szFold = szTarget
	f_ChangeContPos(szTarget)
	
End Function

'============================================================================
Function f_ChangeContPos(szTarget)
	'펼쳐지는 항목의 아래에 위치한 컨트롤들을 전부 내려줌
	Dim tTarget1, tTarget2, tTarget3, tTarget4, tTarget5, tTarget6, tTarget7, tTarget8, tTarget9
	Dim tTarget, szName
	tTarget1 = {"contMain.cont1", "contMain.cont2", "contMain.cont3", "contMain.cont4",
			   "contMain.cont5", "contMain.cont6", "contMain.cont7",
			   "contMain.cont8"}
'	tTarget2 = {"contMain.cont2", "contMain.cont3", "contMain.cont4", "contMain.cont5", 
'			   "contMain.cont6", "contMain.cont7", "contMain.cont8", 
'			   "contMain.cont9"}
'	tTarget3 = {"contMain.cont4", "contMain.cont5", "contMain.cont6", 
'			   "contMain.cont7", "contMain.cont8", "contMain.cont9"}
'	tTarget4 = {"contMain.cont5", "contMain.cont6", "contMain.cont7",
'			   "contMain.cont8", "contMain.cont9"}
'	tTarget5 = {"contMain.cont6", "contMain.cont7", "contMain.cont8", 
'			   "contMain.cont9"}
'	tTarget6 = {"contMain.cont7", "contMain.cont8", "contMain.cont9"}
'	tTarget7 = {"contMain.cont8", "contMain.cont9"}
'	tTarget8 = {"contMain.cont9"}
	
	Dim nHeight		'각 컨테이너에 적용할 높이
	
'	select case szTarget
'		case "1"		tTarget = tTarget1
'		case "2"		tTarget = tTarget2
'		case "3"		tTarget = tTarget3		
'		case "4"		tTarget = tTarget4
'		case "5"		tTarget = tTarget5
'		case "6"		tTarget = tTarget6
'		case "7"		tTarget = tTarget7
'		case "8"		tTarget = tTarget8
'		case "9"		tTarget = tTarget9
'	end select
'	
'	If szTarget == "1" Then
'		tTarget = tTarget1
'		
'		
'	End If
'	Form.ShowAlert("f_ChangeContPos", #tTarget1)
	
	For i = 0 to #tTarget1 - 2
		nHeight = Form.GetCtlProp(tTarget1[i], "top")' + CInt(g_addTop)
'		Form.ShowAlert("f_ChangeContPos1", i .. " : " .. nHeight)
		
		nHeight = CInt(nHeight) + Form.GetCtlProp(tTarget1[i], "height")
		
		if CInt(g_szFold) == i+1 then
			nHeight = nHeight + DEFAULT_MARGIN
		end if
		
'		Form.ShowAlert("f_ChangeContPos1", i .. " : " .. nHeight)
		
'			Form.ShowAlert(tTarget1[i], nHeight)
		Form.SetCtlProp(tTarget1[i+1], "top", nHeight)
	Next
	
	contMain.height = 562
	contMain.SetScrollAutoSize()
End Function

