	<SCRIPT_INFO _len="14304" _ulen="14188" >

Dim g_bExpand
Dim g_szFold
Dim g_nAddTop
Dim DEFAULT_HEIGHT, DEFAULT_MARGIN

DEFAULT_HEIGHT = 60
DEFAULT_MARGIN = 10

'============================================================================
Sub Form_OnFormInitBefore()
	contMain.cont1.imgArrow.setMaintainingRatio("1")
	contMain.cont2.imgArrow.setMaintainingRatio("1")
	contMain.cont3.imgArrow.setMaintainingRatio("1")
	contMain.cont4.imgArrow.setMaintainingRatio("1")
	contMain.cont5.imgArrow.setMaintainingRatio("1")
	contMain.cont6.imgArrow.setMaintainingRatio("1")
	contMain.cont7.imgArrow.setMaintainingRatio("1")
	contMain.cont8.imgArrow.setMaintainingRatio("1")
	contMain.cont9.imgArrow.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_bExpand = False
	g_nAddTop = 0
	
	if Form.GetSharedData("&OS_TYPE", false) == "2" then
		g_addTop = 2
	else
		g_addTop = 0
		
		contMain.setScrollBarVisible("2")
	end if
	
End Sub

'============================================================================
Sub contMain_cont1_imgArrow_OnClick()
	contMain_cont1_lblTitle_OnClick()
End Sub

'============================================================================
Sub contMain_cont1_lblTitle0_OnClick()
	contMain_cont1_lblTitle_OnClick()
End Sub

'============================================================================
Sub contMain_cont1_lblTitle_OnClick()
	If g_bExpand and g_szFold <> "1" Then
		f_ResetContPos()
		f_ExpandArea("1")
	Else
		f_ExpandArea("1")
	End If
	
End Sub

