'============================================================================
'패스워드 글자 개수 카운트
'============================================================================
Sub ContAton_EditReal_OnEditChar(CharCode)
	Select Case CharCode
	
	Case "0"
		
		'입력값 6초과할 때 초과 카운팅 방지
		if nCnt = 6 then
			nCnt = 6
		else
			nCnt = nCnt + 1
		end if
		
		g_CountSave = nCnt
	Case "1"	
		'입력값 없을 때 마이너스 카운팅 방지
		if nCnt = 0 then
			nCnt = 0
		else
			nCnt = nCnt - 1
		end if
		
		g_CountSave = nCnt
	'취소, 입력완료일 때
	Case "2"
		nCnt = 0
	End Select

	PasswordInsert()
	
	'20240717 SWJ START: 입력완료 전에 완료 처리
	if nCnt = 6 then		
		'입력완료 호출 API
		ContAton.EditReal.runSecKeypadFinish()
	end if
	'20240717 SWJ END
	
End Sub
'============================================================================
Sub ContAton_EditReal_OnEditComplete()
	'입력완료 시에만 타게끔(취소는 안타고)
	if g_sBIOTermOS == "2"  then
		g_CharFlag = "N"
		PasswordInsert()
	end if
	
	if nCnt <> 6 then
		'OS별로 비밀번호 최소글자 입력안했을 시에 시스템팝업메시지 내용이 달라서 
		'시스템팝업과 내용 맞춰주기 위한 분기처리
		if g_sBIOTermOS == "2"  then
			Form.MsgBox("알림", "최소 6자리 이상 입력해야 합니다.", "", 6 )
		elseif g_sBIOTermOS == "1" then
			Form.MsgBox("알림", "6글자 이상 입력해 주세요.", "", 6 )
		end if
		
	elseif nCnt = 6 then
		g_Signature = ContAton.EditReal.caption
		
		procRequestAtonTR_REQPRE(g_sLinkBioTranCntt)	
		
		g_nCnt = 6
	end if
	
	nCnt = 0
End Sub

'============================================================================
'고객에게 보여지는 에디트 위치 클릭시 키패드 활성화(에디트 위치에 버튼 올려서)
'============================================================================
Sub ContAton_Button0_OnClick()
	g_AuthType = DEF_ATON_PIN '10

	ContAton.EditReal.SetShowKeypad(True)
	
	'인증 에디트 초기화
	nCnt = 0
	PasswordInsert()
	
End Sub

'============================================================================
'SafeBox 정보획득
function fnGetSBInfo(sParam)
	'-----------------------------------------------------------------------
	'ATON_GETALLINFO
	'-----------------------------------------------------------------------
	sRet = Form.requestAtonAuth("ATON_GETALLINFO" , "" , "")
	sRetItem = Split(sRet, "★")
	
	sErrorCode	= sRetItem[0]
	sErrorMsg	= sRetItem[1]
	g_SBVersion  	= sRetItem[2] 'SafeBox 버전 (에러여도 값있음)
	g_SBAlias 	= sRetItem[3] '인증서일련번호(식별자)
	
	if sErrorCode == "00000" or sErrorCode == "E3201" then
		
		if sParam <> "ISSUE" then
			'발급시 인증서 일련번호에 해당하는 고객번호를 획득
			'g_CustNo = Form.LoadConfigData("MERITZATONAUTH", g_SBAlias) '발급 시, 고객번호를 앱에 저장 후 이값을 인증 시 사용 (인증서조회 1 transaction을 줄이고자 함)
			
			ContAton.EditReal.setHashSalt(g_CustNo)
			g_sLinkBioTranCntt = g_CustNo
		end if
		
		return True
	else
		if sParam <> "ISSUE" then
			Form.MsgBox("알림", sErrorCode & "," & sErrorMsg, "", 0)
		end if
	
		return False
	end if
	
	return True
end function

'============================================================================
''BIO인증구분코드 획득
function fnGetCrtc()
	'01 : 지문, 02 : 안면 - FACEID가 안면인증 임
	sBioType = Form.getBiometryType()				'생체/지문 기기 판단 : 0.사용불가 1.TOUCH ID 2.FACE ID
	
	'Face ID
	if sBioType == "2" then
		return DEF_ATON_FACE
	'iOS 지문, aos 지문
	else
		return DEF_ATON_FINGER
	end if
	
end function
