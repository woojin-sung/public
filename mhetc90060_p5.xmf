'============================================================================
' 01. 화 면 명 : 공인인증서
' 02. 화면설명 : 공인인증서_비밀번호입력풀팝업
' 03. 작    성 : 2016.01.13 김보라
'----------------------------------------------------------------------------
' 2018.08.16 : 길병철 
'   20180911_01 KBC : 바이오인증 인증방식 추가 및 스크립트 정리
'                     티켓온 적용 (PIN/손바닥)
'                     소스수정부분이 많아서 라인별로 달지 않았다.
' 2020.12.12 : 정민영 : v0002 : [T2008250015] 메모리취약점 보완
' 20201116 SWJ START 실명확인번호 암호화 (rcno_plain_rm = 0 미적용 / rcno_plain_rm = 1 적용)
' 20201126 SWJ START 공인인증서 '공인'글자 삭제
' 20230718 SWJ START 메리츠 간편인증 도입 (사설인증방식 추가)

' 이체는 서명할 데이터를 넘겨받아 서명 처리하는 방식, 그 외는 이 화면에서 고객번호 서명해서 인증하는 방식
' 기본은 사용자가 로그인한 방식 따라가고, 사설인증의 경우 타 화면에서 인증 방식을 바꿨다면 바꾼 인증 방식으로 따라감
' (예외) ID 비밀번호 재설정 화면
'  화면 권한은 비로그인 권한이고, 로그인한 방식으로 인증을 결정하는게 아니라
' 사용자가 공동인증서/바이오인증/사설인증 3개 중에 선택해서 인증할 수 있는 방식
' 업무화면에서 사용자가 각 인증서가 있는지 판단하고, 선택해서 들어옴
'============================================================================

'----------------------------------------------------------------------------
'바이오인증 flow
'----------------------------------------------------------------------------
'20220614_01 KBC 바이오인증 송수신분리 (설명추가)
'기존 003a, 004a, 013a, 014a의 응답처리를 203r, 204r, 213r, 214r 서비스조회로 분리 (서비스 부하감소 목적)

'FIDO 1.0  로그인
'   (Bio_401->Bio_402) -> obtss_fido_003a -> obtss_fido_203r -> 앱버전체크 -> (Bio_115->Bio_116) -> obtss_fido_004a -> obtss_fido_204r
'
'FIDO 2.0 로그인
'   (Bio_401->Bio_402) -> obtss_fido_013a -> obtss_fido_213 ->     ...      (Bio_2115->Bio_2116) -> obtss_fido_014a -> obtss_fido_214r

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sResult
Dim g_sID
Dim g_nLinkGubun				'1.ID 비밀번호재설정 화면에서 팝업, 2.바이오거래용 화면에서 팝업, 0.그외 화면에서 팝업
g_sResult			= ""
g_sID				= ""
g_nLinkGubun			= 0

Dim g_nCertPasswdFailCnt
Dim g_nCertManageScr
g_nCertPasswdFailCnt	= 0
g_nCertManageScr 		= 0

Dim g_sLoginType          		'0.권한없음, 1.시세조회전용, 2.인증서, 3.ID/간편/바이오
Dim g_sCertUserType 			'0.인증서, 1.간편인증(공인인증서), 2.코스콤지문(공인인증서), 3.결제원(FIDO인증서), 4.금투협(공동인증서)
g_sLoginType			= "0"
g_sCertUserType		= "0"

Dim g_sBIOTermOS				'1.안드로이드, 2.아이폰, 9.기타
Dim g_sBIOTermID				'단말ID(연계앱 제공)
Dim g_sBIOAthnTchnCode			'인증기술코드 : 100.지문, 105.얼굴, 115.손바닥, 116.PIN
Dim g_sBioAppVersion			'설치된 연계앱 버전
g_sBIOTermOS			= ""
g_sBIOTermID 			= ""
g_sBIOAthnTchnCode	= "100"
g_sBioAppVersion		= ""

Dim DEF_BIO_SVCD
Dim DEF_BIO_GIGWAN
DEF_BIO_SVCD			= "001"
DEF_BIO_GIGWAN		= "00287"

'20220614_01 KBC START 바이오인증 송수신분리
Dim tbl_fido1(0)
Dim tbl_fido2(0)

Dim g_BIOSeqNo
Dim g_BIORetry
Dim g_BIOTrName
Dim g_BIOAppErrCd

DIM DEF_1ST_TIME
DIM DEF_2ST_TIME

DEF_1ST_TIME = 0.5
DEF_2ST_TIME = 1.0
'20220614_01 KBC END

'20191004 LES START 공인인증 최대오류횟수 변경
Dim DEF_CERT_PSWD_LIMIT_CNT
DEF_CERT_PSWD_LIMIT_CNT = 5
'20191004 LES END

Dim g_plain_rm  		'v0002 메모리평문적용여부

' 20201116 SWJ START : 실명확인번호 암호화 적용구분값
Dim rcno_plain_rm
rcno_plain_rm =""

Dim g_MediaType
g_MediaType =""
Dim g_nDev

'20230524 SWJ START
Dim g_SBVersion, g_SBAlias, g_CustNo
Dim g_DeviceID, g_CustNo
Dim g_OnttConn
Dim g_CharFlag, nCnt, g_CountSave
nCnt = 0
Dim g_nCnt
g_nCnt = 0
Dim g_AtonBioYn
Dim g_Register
'CERT_USE_ATON_TYPE과 별개로 
'본 화면에서 어떤 방식으로 인증할건지 정할 때 사용
Dim g_AuthType
Dim g_sAthnTchnCode


'아톤-인증유형구분코드 		(10:PIN, 20:BIO, 30:Pattern)
Dim DEF_ATON_PIN
Dim DEF_ATON_BIO
DEF_ATON_PIN			= "10"
DEF_ATON_BIO 			= "20"


'아톤-BIO인증구분코드 			(01 : 지문, 02 : 안면)
Dim DEF_ATON_FINGER
Dim DEF_ATON_FACE

DEF_ATON_FINGER 		= "100"
DEF_ATON_FACE 		= "200"
'----------------------------------------------------------------------------
Dim g_szLinkDataList
'1개인 경우 
'	"regi", "del", "login"
'복수개인 경우
'	g_szLinkDataList(0) 			'"ChangePswd"
'	g_szLinkDataList(1) 			'사용자ID
'	g_szLinkDataList(2) 			'계좌번호
'	g_szLinkDataList(3) 			'신규비밀번호

'	g_szLinkDataList(0) 			'"BIO_trType"
'	g_szLinkDataList(1) 			'바이오거래유형코드
'	g_szLinkDataList(2) 			'거래내역내용
'	g_szLinkDataList(3) 			'인증용도구분코드 : 0.일반, 1.출금동의 증빙자료

'거래연동 검증시 저장 데이터
Dim g_sLinkBioTrCode
Dim g_sLinkBioTranCntt
Dim g_sLinkBioAthnUsagClsCode
g_sLinkBioTrCode			= "0"	'바이오거래유형코드 : 0.인증, 1.서명 
g_sLinkBioTranCntt		= ""		'거래내역내용
g_sLinkBioAthnUsagClsCode	= "0"	'인증용도구분코드 : 0.일반, 1.출금동의 증빙자료

'----------------------------------------------------------------------------
Dim DEF_BIO_FINGER
Dim DEF_BIO_PIN
Dim DEF_BIO_PALM
'Dim DEF_BIO_FACE
'g_sBIOAthnTchnCode 에서 사용 (인증기술코드)
DEF_BIO_FINGER	= "100"	'지문
'DEF_BIO_FACE		= "105"	'얼굴
DEF_BIO_PIN		= "116"	'PIN  
DEF_BIO_PALM		= "115"	'손바닥

'============================================================================
Sub Form_OnFormInit()
	ContBio.visible = False
	
	'20230524 SWJ START
	'테스트용 인증스킵 체크
    g_nDev = Form.GetSharedData("&SERVER_MODE", False )

    If g_nDev == "1" Or g_nDev == 1 Then
        chkSkip.visible = True
        chkSkip.checkstate = "0"   '자동체크 제외 "1"  '자동체크
    Else
        chkSkip.visible = False
        chkSkip.checkstate = "0"
    End If
    '20230524 SWJ END
	
	g_sResult = "cancel"
	g_sBIOTermOS = Form.GetSharedData("&OS_TYPE", false) 'iOS("2")Android("1")
	
	' 20180116 HAMWG START : 바이오인증 아이폰X대응 이미지변경
	if g_sBIOTermOS == "2" Then
		szIsIPhoneX = Form.isIphoneX() 
		if szIsIPhoneX == true then
			ContBio.Image2.imgpath ="bio_fi_bg.9"
		else
			ContBio.Image2.imgpath ="bio_bg.9"
		end if
	else
		ContBio.Image2.imgpath ="bio_bg.9"
	end if
	' 20180116 HAMWG END
	
	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
'공인인증서 비밀번호쪽은 메인에서 아리아비밀번호를 복호화처리하므로, 평문값으로 return할 필요 없다. 그냥 Caption이용
'주의! 단, 컨트롤 속성이 '일반비밀번호사용'이어야 함
'	if g_plain_rm == "1" then
'		'평문값Return 설정
'		Edit0.SetEncExcept()  
'	end if 
	
	'20201116 SWJ START : 실명확인번호 암호화
	'rcno_plain_rm = ( 0 : 미적용/ 1 : 적용)
	rcno_plain_rm = Form.GetSharedData("&RCNO_PLAIN_RM", false)
	
	g_MediaType = Form.GetSharedData("&MEDIA_CODE", false)
	'20201116 SWJ END
	
	g_nLinkGubun = 0
	
	sLinkData = Form.GetOpenLinkData()
	g_szLinkDataList = Split(sLinkData,"★")		
	
	'FIDO인증처리 추가	
	g_sLoginType		= Form.GetSharedData("&LOGIN_TYPE", false)
	g_sCertUserType	= Form.GetSharedData("&CERT_USE_TYPE" , 0) '0.공인인증서 1.간편인증(공인인증서) 2.코스콤지문(공인인증서) 3.결제원(FIDO인증서) 4.금투협(공동인증서)
	
	if g_sCertUserType == "3" then
		g_sBIOAthnTchnCode = Form.GetSharedData("&CERT_USE_BIO_TYPE" , 0) '인증기술코드 : 100.지문, 105.얼굴, 115.손바닥, 116.PIN
	end if
	
	'20230524 SWJ START : 메리츠 간편인증 도입
	Form.SetScreenName("인증서 비밀번호")						'주석처리 SWJ

	g_DeviceID = Form.GetDeviceID2()
	g_CustNo   = Form.GetSharedData("&CUST_NUM", false)
			
	ContAton.EditReal.SetApplyLabel("숫자 6자리 입력", 0 , 76 , "left" , true) '호출해야 정상작동
	g_sAthnTchnCode = Form.GetSharedData("&CERT_USE_ATON_TYPE" , 0) '인증기술코드 : 10.PIN 100.지문 200.FACEID
	
	if CInt(g_sLoginType) >= 2 then '로그인상태 (0.권한없음, 1.시세조회전용, 2.공인인증서, 3.ID/간편/바이오/사설인증)
		
		AuthTypeVisible(g_sCertUserType)
		
	else
		'ID비밀번호재설정 화면은 로그아웃 권한
		'업무화면에서 인증방식 선택 후 mhetc90060_p5 온다함
		szTmpdata = Form.GetSharedData("90060_ChangePwd", True )
		
		szChangeLink = Split(szTmpdata,"★")	
		
		if Ubound(szChangeLink) < 1 then
			szCertAuth = True
		else
			'ID비밀번호재설정 화면 진입
			if szChangeLink(0) == "ChangePwd" then
				g_nLinkGubun = 1
				g_sCertUserType = szChangeLink(1)
				g_CustNo        = szChangeLink(2)
				AuthTypeVisible(g_sCertUserType)
			else
				szCertAuth = True
			end if
		end if
		
		if szCertAuth then
			ContBio.visible = False
			ContAton.visible = False
			Image0.visible = True
			Edit0.visible = True
			Table0.visible = True
			'labTitle.caption = "공동인증"
			Edit0.certname = "인증서 비밀번호 입력"
		end if
	end if
	'20230524 SWJ END
	
	'그외 화면에서 팝업시
	if UBOUND(g_szLinkDataList) < 1 then
		g_sID = Form.GetSharedData("&USER_ID", false)
		
	'ID비밀번호 재설정 화면에서 팝업시
	else
		
		if g_sCertUserType == "3" Then
			
			if g_szLinkDataList(0) == "BIO_trType" then
				g_nLinkGubun	= 2
				g_sID		= Form.GetSharedData("&USER_ID", false)
			
				g_sLinkBioTrCode			= g_szLinkDataList(1)
				g_sLinkBioTranCntt		= g_szLinkDataList(2)
				g_sLinkBioAthnUsagClsCode	= g_szLinkDataList(3)
				
			'20181012 LES START 바이오인증 등록 시, 공인인증서 인증
			'바이오인증으로 로그인 후, 다른 바이오인증을 등록하기 위하여 로그아웃하면
			' g_sCertUserType = 3 으로 남아있어 이부분을 탐
			elseif g_szLinkDataList(0) == "bio_new" then
				g_sID 		= g_szLinkDataList(1)
				g_CertDN 	= g_szLinkDataList(2)
			'20181012 LES END
			
			else 
				g_nLinkGubun 	= 1 '접속비밀번호변경
				g_sID 		= g_szLinkDataList(1)
			end if
		'20230524 SWJ START
		elseif g_sCertUserType == "5" Then
			if g_szLinkDataList(0) == "ATON_trType" then
				g_sID		= Form.GetSharedData("&USER_ID", false)
				g_sLinkBioTranCntt = g_szLinkDataList(1)
			end if
		'20230524 SWJ END
		else
			
			'20181010 LES START 바이오인증 등록시, 공인인증서 인증
			'바이오인증 외에 로그인방법으로 로그인 후, 바이오인증 등록을 위하여 로그아웃하면
			'g_sCertUserType <> 3 이므로 이부분을 탐
			if g_szLinkDataList(0) == "bio_new" then
				g_sID 		= g_szLinkDataList(1)
				g_CertDN 	= g_szLinkDataList(2)
				
			'20181010 LES END
			
			else
				g_nLinkGubun	= 1 '접속비밀번호변경
				g_sID		= g_szLinkDataList(1)
			end if
			
		end if
	end if
	
	'20230524 SWJ START : 메리츠 사설인증 인증서 관리, 생체인증등록 시
	'무조건 간편인증 호출해야하는 경우
	if sLinkData = "meritzauth" then
		fnGetSBInfo("")
		MeritzAuth()
	end if
	'20230524 SWJ END
	
	'타기관인증서 통해서 들어올 때, 타기관 등록용 ID로 로그인
	If sLinkData == "regi" Then
		g_sID = Form.GetSharedData("CERT_ID", false)
	End If
	
	if sLinkData == "regi" or sLinkData == "del" or sLinkData == "login" Then
		'타기관인증서 등록, 인증서 삭제 화면을 통해서 오픈되는 경우
		g_nCertManageScr = 1
	end if
	
	'FIDO인증
	'g_sLoginType : 0.권한없음, 1.시세조회전용, 2.공인인증서, 3.ID/간편/바이오
	If CInt(g_sLoginType) >= 2 And g_sCertUserType == "3" Then
		if g_sBIOTermOS == "1" then
			'KBC : FormInit에서 requestKftcBio 시 오류발생(메인앱 exception)하여 긴급 처리
			'20181101 Bio_401 호출 -> AOS : Forminit쪽에서 호출 / iOS : ForminitAfter쪽에서 호출하는 중
			ButtonOK.enable = false
			Form.SetTimerEvent(401, 1, 1)
			'Form.requestKftcBio("Bio_401", "", "90060")
		else
			
		end if 
	else
		
		'인증서 정보 제공
		'저장된 인증서 DN값으로 serialnumber를 받아 선택된 인증서 정보를 찾음.
		if CInt(g_sLoginType) >= 2 then '로그인상태
			sDN = Form.GetSharedData("CERT_IMSI_DN", false)
			
			if sDN == null or sDN == "" then
				sDN = Form.GetSharedData("&USER_CERT_DN", false)
			end if
		else
			
			'20181011 LES START
			'바이오인증 등록 시, 공인인증서 인증의 경우
			'이전화면에서 링크변수로 넘어온 dn값을 이용한다.
			if g_szLinkDataList(0) == "bio_new" then
				sDN = Trim(g_CertDN)
				
			else
				sDN = Form.GetSharedData("CERT_DN", false)
			
				if sDN == null or sDN == "" then
					sDN = Form.GetSharedData("&USER_CERT_DN", false)
				end if
			end if
			'20181011 LES END
		end if
	
		sSerialNum = Form.getCertSerialNumber(sDN)
		
	
		If Form.GetCertListSize() < 1 Then
			Exit Sub
		End If
		
		For i=0 To Form.GetCertListSize()-1
			sCertInfo = Form.GetCertListDataAt(i)
			sTemp = Split(sCertInfo, ";")
				
			If Trim(sSerialNum) == Trim(Form.getCertSerialNumber( sTemp[1] )) Then
				Table0.SetCellString( 1, 1, sTemp[0] )
				Table0.SetCellString( 2, 1, sTemp[2].." ("..sTemp[3]..")"  )
				
				sDate = sTemp[7]
				sDate = Replace(sDate, "-", "")
				sDate = Replace(sDate, ".", "")
				Table0.SetCellString( 3, 1, "20"..sDate )
				
				sDate = sTemp[6]
				sDate = Replace(sDate, "-", "")
				sDate = Replace(sDate, ".", "")
				Table0.SetCellString( 4, 1, "20"..sDate )
				
				sCalDate = Form.calcDateTime( 0, 0, 30, 0, 0, 0 )
				sCalDate = Left(sCalDate, 8)
		
				if tonumber("20"..sDate) > tonumber(sCalDate) then
					Image0.imgpath = "icon_sub_11.png"
				else
					Image0.imgpath = "icon_sub_12.png"
				end if
				
				Exit Sub
			End if
		Next			
	end if
	
End Sub

'============================================================================
'인증 방식에 따른 컨트롤 보임/숨김 처리 함수
'============================================================================
Function AuthTypeVisible(szType)
	if szType == "3" Then
		ContBio.visible = True
		ContAton.visible = False
		Form.SetScreenName("바이오인증")
		ButtonOK.visible = false
		ButtonCancel.visible = false
		'labTitle.caption = "바이오인증"
		Form.SetCtlProp("Table0", "visible", "0")
		Form.SetCtlProp("Edit0", "visible", "0")
		Form.SetCtlProp("Image0", "visible", "0")
		
	'자체사설인증 (추가)
	elseif szType == "5" then
		fnGetSBInfo("")
		MeritzAuth()
	else
		ContBio.visible = False
		ContAton.visible = False
		Image0.visible = True
		Edit0.visible = True
		Table0.visible = True
		ButtonOK.visible = True
		ButtonCancel.visible = True
		'labTitle.caption = "공동인증"
		Edit0.certname = "인증서 비밀번호 입력"	
	end if

End Function
'============================================================================
'KBC : FormInit에서 requestKftcBio 시 오류발생(메인앱 exception)하여 긴급 처리
Sub Form_OnTimerEvent(sTimerID)
	'20220614_01 KBC START 바이오인증 송수신분리
	If CInt(sTimerID) == 401 then
		Form.SetTimerEvent(CInt(sTimerID), 0, 1) 'timer off
		ButtonOK.enable = true	
		Form.requestKftcBio("Bio_401", "", "90060")
	
	elseif CInt(sTimerID) == 2 then
		Form.SetTimerEvent2(2,0,0)
		szTranID = ""
		
		if g_BIOTrName == "obtss_fido_003a" then
			szTranID = "obtss_fido_203r"
			
		elseif g_BIOTrName == "obtss_fido_004a" then
			szTranID = "obtss_fido_204r"
			
		elseif g_BIOTrName == "obtss_fido_013a" then
			szTranID = "obtss_fido_213r"
			
		elseif g_BIOTrName == "obtss_fido_014a" then
			szTranID = "obtss_fido_214r"
		end if
	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ELFN_ID"			, 0 , g_sID)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "OTSD_TR_UNIQ_NO"	, 0 , g_BIOSeqNo)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "RPCS_TMNU"			, 0 , g_BIORetry)
		DATAMANAGER.RequestTranData(szTranID)		
	end if
	'20220614_01 KBC END	
	
	'20230524 SWJ START : 비밀번호 키패드 show
	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		ContAton.EditReal.SetShowKeypad(True)
	end if
	'20230524 SWJ END
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	
	'FIDO인증
	'g_sLoginType : 0.권한없음, 1.시세조회전용, 2.공인인증서, 3.ID/간편/바이오
	If CInt(g_sLoginType) >= 2 And g_sCertUserType == "3" Then
		Form.requestKftcBio("Bio_401", "", "90060")
		exit sub
	End If

	if Edit0.caption == null or Edit0.caption == "" then
		Form.MsgBox( "알림", "인증서 비밀번호를 입력하세요.", "", 6 )
		
	else 
		'공인인증서 비밀번호 유효성체크
		
		'인증서 DN체크 수정
		if CInt(g_sLoginType) >= 2 then '로그인상태
			sDN = Form.GetSharedData("CERT_IMSI_DN",  false)
			if sDN == null or sDN == "" then
				sDN = Form.GetSharedData("&USER_CERT_DN" , false)
			end if
		else
			
			'20181012 LES START 바이오인증 등록시, 공인인증서 인증
			if g_szLinkDataList(0) == "bio_new" then
				
				sDN = Trim(g_CertDN)
			else
				sDN = Form.GetSharedData("CERT_DN" , false)
				if sDN == null or sDN == "" then
					sDN = Form.GetSharedData("&USER_CERT_DN" , false)
				end if
			end if
			'20181012 LES END
			
		end if
		
		
		'==============================================================================================
		'20191004 LES START 공인인증 최대오류횟수 변경
		'==============================================================================================
		'OCSP검증 서비스만 타도 오류횟수가 초기화됨. 
		'인증서비번이 5회초과된 경우 OCSP검증 서비스 자체를 못타게 앞단에서 막음.
		
		sCertErrCnt = Cint(Form.GetSharedData("CERT_PWD_ERR_CNT", false ))
			
		if sCertErrCnt >= DEF_CERT_PSWD_LIMIT_CNT then
			'20211122 HSZ START - ID비밀번호 재설정 화면에서 팝업시 SKIP
			if g_nLinkGubun == 1 then '접속비밀번호변경
			else
				Form.MsgBox( "알림",  "인증 비밀번호 5회 오류 초과로 업무진행이 불가능 합니다.",	""	,	0)
				g_sResult = "cancel"
				Exit Sub
			end if
			'20211122 HSZ END
		end if
		'==============================================================================================
		'20191004 LES END
		'==============================================================================================
	
		Form.RequestCertCommand( "ReqCheckIsValidPassword", sDN, Edit0.caption )
	end if
End Sub

'============================================================================
Sub Form_OnCertEvent(sType, sParam1, sParam2)
	
	if sType == "RetIsCertPasswordValid" then
		if sParam1 == "Success" then				
			
			Form.SetSharedData("CERT_IMSI_PSWD", Edit0.caption) '">"빠짐 현상 대응
			g_nCertPasswdFailCnt = 0 
			
			
			'-------------------------------------------------------------------
			'타기관인증서 등록, 인증서 삭제 화면을 통해서 오픈되는 경우
			'(OCSP, 비번오류횟수 원장누적관리 안함)
			'-------------------------------------------------------------------
			if g_nCertManageScr == 1 then 
				g_sResult = "ok;"..Edit0.caption
				Form.CloseForm( )
				exit sub
			end if
		
			'-------------------------------------------------------------------
			'인증서관리업무등이 아닌 실제 금융주요업무시에만 OCSP검증을 태운다.
			'예) 인증서 삭제작업 등에서 OCSP검증을 해서는 안된다.
			'-------------------------------------------------------------------
			
			'20181011 LES START OCSP검증체크 필요/불필요 확인로직 추가
			bOcsp 		= true
			sScreenNo	= Form.GetSharedData("&SCREEN_NO" , false)
			
			'g_sLoginType : 0.권한없음, 1.시세조회전용, 2.공인인증서, 3.ID/간편/바이오
			if CInt(g_sLoginType) <= 1 or CInt(sScreenNo) >= 90000 then
			
				if g_szLinkDataList(0) <> "bio_new" then
					bOcsp = false
				end if

			end if

			if bOcsp = true then
				Request_ohhts_ocsp_001r()
			else
				
				if g_szLinkDataList(0) == "bio_new" then
					g_sResult = "ok"
				else
						
					g_sResult = "ok;"..Edit0.caption
				end if
				
				DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "SUCS_YN" , 0 , "Y")	'성공여부	
				DATAMANAGER.RequestTranData("obcpp_logn_015a")
			
			end if
			'20181011 LES END
			
		
		'DN값 없이 체크한 경우 ->공인인증서 선택 안한 경우
		elseif sParam1 == "Error" then
			ShowAlert "알림", sParam2	
			
		else
			if g_nCertManageScr == 1 then
				'타기관인증서 등록, 인증서 삭제 화면을 통해서 오픈되는 경우(화면내부에서만 오류관리)
				g_nCertPasswdFailCnt = g_nCertPasswdFailCnt + 1
				
				Form.MsgBox( "알림", sParam2 + "\n(비밀번호 " + g_nCertPasswdFailCnt + "회 오류입니다. 5회 오류 시 화면이 종료됩니다.)", "CERT_PSWD_FAIL", 0)
			else
				DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "SUCS_YN" , 0 , "N") 	'성공여부	
				DATAMANAGER.RequestTranData("obcpp_logn_015a")
			end if
		end if
	end if
End Sub

'============================================================================
'OCSP검증 추가
Sub Request_ohhts_ocsp_001r()
	'--------------------------------------------------------
	sUserID		= Form.GetSharedData("&USER_ID"		, false)	'사용자ID
	sRcNo 		= Form.GetSharedData("&JUMIN_NUM"	, false)	'실명확인번호
	sUserName 	= Form.GetSharedData("&USER_NAME"	, false)	'고객명
	sCsNo 		= Form.GetSharedData("&CUST_NUM"	, false)	'고객번호
	sDN 			= Form.GetSharedData("&USER_CERT_DN"	, false)	'DN
	sCertPass 	= Edit0.caption							'입력한 인증서 비밀번호
	
	'20181012 LES START
	'바이오인증 등록시, 공인인증서 인증일 경우 변수값을 다시 세팅해준다.
	if g_szLinkDataList(0) == "bio_new" then
		sUserID = Form.GetSharedData("CERT_ID", false)
		sRcNo = Form.GetSharedData("CERT_RCNO", false)
		sUserName = Form.GetSharedData("BIO_CSNM", false)
		sCsNo = Form.GetSharedData("BIO_CSNO", false)
		sDN = Trim(g_CertDN)
		
	end if
	'20181012 LES END

	'--------------------------------------------------------
	DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "USER_ID" 				, 0 , sUserID ) 	'사용자ID

'20201116 SWJ START : 실명확인번호 암호화 (RCNO > RCNO_PIP로 변경 / 고유MTS에는 미적용)
	if rcno_plain_rm <> "1" or g_MediaType == "158" or g_MediaType == "159" then
		DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "RCNO" 					, 0 , sRcNo) 		'실명확인번호
	else
		
		'20231211 SWJ START : 외국인 투자자 등록제도 폐지 관련, 외국인의 경우 마지막 검증단계에서 조합여권번호로 비교하므로 변경
		'(참고 : 일반 고객은 이 쉐어드변수에서 &JUMIN_NUM과 동일한 값 받는다)
		sCombRcno = Form.GetSharedData("&COMB_JUMIN_NUM", false)
		
		DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "CRPT_YN" 				, 0 , "Y"  ) 	
		DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "RCNO_PIP" 				, 0 , sCombRcno) 		'실명확인번호
		'20231211 SWJ END
	end if
'20201116 SWJ END
	
	DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "USER_NAME" 				, 0 , sUserName )	'고객명
	DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "CSNO" 					, 0 , sCsNo) 		'고객번호
	
	sRValue = Form.GetRvalue( sDN , sCertPass)
	DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "UI_R_VAL" 				, 0 , sRValue) 	'R 값	
				
	sSignData = Form.GetCertSignData( sDN , sCertPass)
	DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "UI_ELCT_SGNT_DATA_CNTT" 	, 0 , sSignData) 	'전자서명데이타
	
	sSerialNum = Form.getCertSerialNumber( sDN)
	DATAMANAGER.SetDataValue( 0, "ohhts_ocsp_001r", "InBlock1", "NTAT_SRNO" 				, 0 , sSerialNum) '인증서 일련번호
	
	DATAMANAGER.RequestTranData("ohhts_ocsp_001r")
End Sub

'============================================================================
Sub Form_OnFormClose()
	
	if g_Register = "Y" then
		Form.OpenPopup("mhetc90190_s1","mhetc90060_p5","")
	end if
	
	Form.SendReturnToParent( "mhetc90060_p5" , g_sResult )
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'메세지박스 팝업시 메세지 박스 확인 후 Form Close
	if sKeyName == "close" then
		g_sResult = "ok"
		Form.CloseForm()		'첫페이지(ID등록)로 이동
		
	'인증서비밀번호 모의해킹결과 대응
	elseif sKeyName == "CERT_PSWD_FAIL" then
		if g_nCertPasswdFailCnt >= 5 then '5회
			Form.CloseForm()
		end if
		
	'FIDO 인증검증
	elseif sKeyName == "FIDO_MBX_NEW" then		
		Form.CloseForm()	
	
	'20230524 SWJ START
	elseif sKeyName == "PinError" then
		'인증 에디트 초기화
		nCnt = 0
		PasswordInsert()
				
		'비밀번호 입력키패드 Show
		Form.SetTimerEvent2(1, 1, 0.6)
	
	elseif sKeyName == "E4106" then
		if sRet == "ok" then
		else
			Form.CloseForm()
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcpp_logn_015a" then
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "USER_ID"			, 0, g_sID ) '사용자ID
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "ATHN_MDIA_TYPE_CODE"	, 0, "  ")
		
		'KBC '''''015a올려야 하나? 차차장님한테 물어보자
		'g_sLoginType : 0.권한없음, 1.시세조회전용, 2.공인인증서, 3.ID/간편/바이오
'		if g_sCertUserType == "3" Then
'			if CInt(g_sLoginType) >= 2 then '로그인 상태일때만
'				DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "ATHN_MDIA_TYPE_CODE", 0, "07") '07.Bio인증
'			end if
'		end if
	end if

	if szTranID == "obcsb_efif_210a" then
		'헤더에 USER_ID가 비어있으면 이후 서비스에서 제대로 출력값을 주지 못함
		sUserID = Form.GetSharedData("&USER_ID" , false) '로그인 (자동접속 포함) 후 셋팅되는 값
		
		if sUserID == null or sUserID == "" then
			'기존 접속중인 ID가 없는 경우 비밀번호 재설정을 위해 입력한 ID로 헤더값 셋팅
			if g_nLinkGubun == 1  Then '접속비밀번호변경
				DATAMANAGER.setUserID(g_szLinkDataList(1))  '공통헤더 값 채움 (DATAMANAGER.getUserID는 API가 현재 없음)
			end if
		End if
			
		if g_nLinkGubun == 1 Then '접속비밀번호변경
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID"	, 0, g_szLinkDataList(1) ) '전자금융ID
			'v0002 ID비번재설정(mhetc90020_pc)에서 평문적용여부상관없이 암호화된 정보로 넘어옴(공유값 변경시 확인필수)
			'      mhetc90020_pc -> 보안매체(mhetc90060_p9/mhetc90060_pa/mhetc90060_pb) -> mhetc90060_p5
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CONN_PWD"	, 0, g_szLinkDataList(3) ) '접속 비밀번호
		end if
	end if
	
	'20220614_01 KBC START 바이오인증 송수신분리
	if szTranID == "obtss_fido_003a" or szTranID == "obtss_fido_004a" or szTranID == "obtss_fido_013a" or szTranID == "obtss_fido_014a" then
		Form.addWaitCursor()
	end if
	'20220614_01 KBC END		
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim sMstk
	
	if szTranID == "obcpp_logn_015a" then
		
		'==============================================================================================
		'20191004 LES START 공인인증 최대오류횟수 변경
		'==============================================================================================
		'공인인증서 비밀번호 오류횟수
		sMstk =  DATAMANAGER.GetDataValue(0,"obcpp_logn_015a", "OutBlock1", "PBCR_PWD_MSTK_TMNU" ,0)
		
		'-----------------------------------------------------
		' 인증서 비밀번호 오류시
		'-----------------------------------------------------		
		if  CInt(sMstk) >  0 then
		
			'1. 공인인증 5회이상 초과
			if CInt(sMstk) >= DEF_CERT_PSWD_LIMIT_CNT then
				Form.MsgBox( "알림",  "인증 비밀번호 5회 오류 초과로 업무진행이 불가능 합니다.", 	""	,	0)
				g_sResult = "cancel"
						
			'2. 공인인증 오류횟수 5회 미만
			else
				Form.MsgBox( "알림",  "인증 비밀번호 " + CInt(sMstk) + "회 오류입니다. 5회 오류 초과시 업무진행이 불가능 합니다.", "", 0)
			end if
		
			'3. 오류횟수 공유변수 저장 (공인인증 오류횟수는 공유변수로 앱 종료전까지 모든화면이 공유)
			Form.SetSharedData("CERT_PWD_ERR_CNT" , sMstk)
		
		
		'-----------------------------------------------------
		' 인증서 비밀번호 일치시
		'-----------------------------------------------------
		else
			
			' 기존) 인증서 비밀번호가 5회 초과된 상태에서 인증서 비밀번호 일치시, 업무진행 가능
			' 변경) 인증서 비밀번호가 5회 초과된 상태에서 인증서 비밀번호 일치시, 업무진행 불가
			sCertErrCnt = Cint(Form.GetSharedData("CERT_PWD_ERR_CNT", false ))
			
			'4. 공유 오류횟수 > 최대 오류횟수 : 업무진행 불가 메세지
			if sCertErrCnt >= DEF_CERT_PSWD_LIMIT_CNT then
				Form.MsgBox( "알림",  "인증 비밀번호 5회 오류 초과로 업무진행이 불가능 합니다.",	""	,	0)
				g_sResult = "cancel"
				Exit Sub
			
			'5. 공유 오류횟수 < 최대 오류횟수 : 공유 오류횟수 초기화
			else
				Form.SetSharedData("CERT_PWD_ERR_CNT" , 0)
			end if
		'==============================================================================================
		'20191004 LES END
		'==============================================================================================	
			
			'ID비밀번호 재설정 화면에서 팝업시
			if g_nLinkGubun == 1 then '접속비밀번호변경
				Form.SetSharedData("CERT_PWD_ERR_CNT" , 0) '20211122 HSZ 공유 오류횟수 초기화
				
				'20230718 SWJ START : ID비밀번호 재설정 화면에서 obcsb_efif_210a 처리한다고 함
				g_sResult = "ok"
				Form.CloseForm()
				'20230718 SWJ END
				
				'DATAMANAGER.RequestTranData("obcsb_efif_210a")
			else
				if DATAMANAGER.GetDataValue(0, szTranID , "InBlock1" , "SUCS_YN" , 0) == "Y" Then
					Form.CloseForm( )
				end if
			end if
		end if
	
	'20230711 SWJ START
	elseif szTranID == "obcpp_logn_057a" then
		szIPAD = DATAMANAGER.GetDataValue(0,"obcpp_logn_057a", "OutBlock1", "IPAD" ,0)	'UUID
		
		Form.SetEnvData(1, "login.input.atonathntchncode", g_AuthType)
		Form.SetSharedData("&CERT_USE_ATON_TYPE", g_AuthType)
		
		g_sResult = "ok"
		g_nCnt = 0
		
		Form.CloseForm()
	'20230711 SWJ END
	
	elseif szTranID == "obcsb_efif_210a" then
		Form.MsgBox( "알림", "비밀번호 재설정이 완료되었습니다.", "close", 6 )
	
	'OCSP검증 추가
	elseif szTranID == "ohhts_ocsp_001r" then
		sStatCode =  DATAMANAGER.GetDataValue(0,"ohhts_ocsp_001r", "OutBlock1", "STAT_CLS_CODE" ,0) '상태구분코드
		
		if sStatCode == "Y" then
		
			'20181016 LES START
			if g_szLinkDataList(0) == "bio_new" then
				g_sResult = "ok"
			else
				g_sResult = "ok;"..Edit0.caption
			end if
			'20181016 LES END
			
			DATAMANAGER.SetDataValue(0, "obcpp_logn_015a", "InBlock1", "SUCS_YN" , 0 , "Y") 		'성공여부	
			DATAMANAGER.RequestTranData("obcpp_logn_015a")				
		end if
	
	'=======================================================================================================
	' BIO 인증 로그인
	'=======================================================================================================
	
	'-------------------------------------------------------------------------------------------------------
	'20220614_01 KBC START 바이오인증 송수신분리
	'-------------------------------------------------------------------------------------------------------
	
	'공동FIDO인증요청
	elseif szTranID == "obtss_fido_003a" or szTranID == "obtss_fido_203r" then
		Recv_Code	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_CODE" 			,0)
		Recv_Msg		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_MSG_CNTT"			,0)
		Recv_TR_Code	= DATAMANAGER.GetDataMsgCode(szTranID)
		
		'20220614_01 KBC 송수신분리 적용 시
		'6617.처리대기중입니다.
		if Recv_Code == "6617" or Recv_TR_Code == "6617" then
			if szTranID == "obtss_fido_003a" then
				g_BIOSeqNo	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OTSD_TR_UNIQ_NO", 0)
				g_BIOTrName	= szTranID
				g_BIORetry	= 0
				
				Form.SetTimerEvent2(2,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회		
				
			elseif szTranID == "obtss_fido_203r" then
				g_BIORetry = g_BIORetry + 1
				Form.SetTimerEvent2(2,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			end if
			
			exit sub
		end if
		
		Form.removeWaitCursor()
		
		tbl_fido1("DENY_PREV_TOKEN")	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DENY_PREV_TOKEN" 		,0)
		tbl_fido1("APP_VRSN") 			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "APP_VRSN" 			,0)
		tbl_fido1("TOKEN_CHALLENGE")	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CMPA_TOKEN_CHAL" 		,0)
		tbl_fido1("FIDO_LEN") 			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_FIDO_MSG_SIZE1" 	,0)
		tbl_fido1("FIDO_MSG") 			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_FIDO_ATHN_RQST_MSG"	,0)
		tbl_fido1("BIO_TLMS_TRC_NO")	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BIO_TLMS_TRC_NO"		,0)

		sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		'길이정보확인
		if CLng(tbl_fido1("FIDO_LEN")) <> LEN(tbl_fido1("FIDO_MSG")) then
			Form.MsgBox("알림", "[TR] " & sRspnMsg & "\n(" & sSubMsg & ")", "", 0)
			exit sub
		end if
		
		'FIDO 메시지 시작/종료 문자 확인
		if left(tbl_fido1("FIDO_MSG"), 1) <> "{" or right(tbl_fido1("FIDO_MSG"),1) <> "}" then
			Form.MsgBox("알림", "[TR] " & sRspnMsg & "\n(" & sSubMsg & ")", "", 0)
			exit sub
		end if
		
		'앱버전비교
		sSvrAppVersion = tbl_fido1("APP_VRSN")
		sMinAppVersion = Left(sSvrAppVersion, 4)		'최소버전
		sNewAppVersion = Right(sSvrAppVersion, 4)	'최신버전
		
		'현재버전이 최소버전보다 낮을 경우 반드시 업데이트
		if CInt(g_sBioAppVersion) < CInt(sMinAppVersion) then
			Form.MsgBox("알림", "금융결제원 FIDO앱 업데이트를 진행합니다.", "FIDO_UPDATE", 1)
			exit sub
			
		'현재버전이 최신버전보다 낮을 경우 업데이트를 권고
		elseif CInt(g_sBioAppVersion) < CInt(sNewAppVersion) then
			Form.Toast(0, "금융결제원 FIDO 앱 업데이트를 권장합니다." , 0)
		end if

		'인증요청메시지전송
		'기관코드, 서비스코드, 호환토큰 Challenge, FIDO 인증요청메시지, 축약서명 키쌍 필요여부
		sParam = DEF_BIO_GIGWAN & "★" & DEF_BIO_SVCD & "★" & tbl_fido1("TOKEN_CHALLENGE") & "★" & tbl_fido1("FIDO_MSG") & "★" & "N"
		Form.requestKftcBio("Bio_115", sParam, "90060") '기관코드,서비스코드,호환토큰 Challenge,FIDO 인증요청메시지
		
	'공동FIDO인증전송
	elseif szTranID == "obtss_fido_004a" or szTranID == "obtss_fido_204r" then
		Recv_Code			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_CODE" 			,0) '응답코드
		Recv_Msg				= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_MSG_CNTT" 		,0) '응답메세지 내용
		Uniq_Code			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OTSD_TR_UNIQ_NO" 		,0) '대외거래고유번호
		Recv_FIDO_SIGN_DATA	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_FIDO_ELCT_SGNT_DATA" ,0)	'UIFIDO전자서명데이터
		Recv_TR_Code			= DATAMANAGER.GetDataMsgCode(szTranID)

		'20220614_01 KBC 송수신분리 적용 시
		'6617.처리대기중입니다.
		if Recv_Code == "6617" or Recv_TR_Code == "6617" then
			if szTranID == "obtss_fido_004a" then
				g_BIOSeqNo	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OTSD_TR_UNIQ_NO", 0)
				g_BIOTrName	= szTranID
				g_BIORetry	= 0
				
				Form.SetTimerEvent2(2,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회		
				
			elseif szTranID == "obtss_fido_204r" then
				g_BIORetry = g_BIORetry + 1
				Form.SetTimerEvent2(2,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			end if
			
			exit sub
		end if
		
		Form.removeWaitCursor()
		
		sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

		if Recv_Code <> "0000" then
			if Len(sSubMsg) > 1 Then
				Form.ShowAlert("알림", "[TR] " & Recv_Msg & "\n(" & sSubMsg & ")")
			else
				Form.ShowAlert("알림", "[TR] " &  Recv_Msg)
			end if	
			
			exit sub
		end if

		'20220614_01 KBC 송수신분리 적용 시
		If  g_BIOAppErrCd == "5121" Then
			exit sub
		End If
		
'		If  DATAMANAGER.GetDataValue(0, szTranID, "InBlock1", "APP_RSPN_CODE" ,0) == "5121" Then
'			exit sub
'		End If

		if g_sLinkBioAthnUsagClsCode == "1" or g_sLinkBioAthnUsagClsCode == 1 Then '인증용도구분코드 (0.일반 1.출금동의 증빙자료)
			g_sResult = "ok;;" & Recv_FIDO_SIGN_DATA
		else
			g_sResult = "ok"
		end if
		
		'KBC '''''015a올려야 하나? 차차장님한테 물어보자
		Form.CloseForm( )
'		DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "SUCS_YN" , 0 , "Y") 	'성공여부	
'		DATAMANAGER.RequestTranData("obcpp_logn_015a")
		
	'티켓온 인증요청 응답
	elseif szTranID == "obtss_fido_013a" or szTranID == "obtss_fido_213r" then 
		Recv_Code	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_CODE" 		,0)
		Recv_Msg		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_MSG_CNTT"		,0)
		Recv_TR_Code	= DATAMANAGER.GetDataMsgCode(szTranID)
		
		'20220614_01 KBC 송수신분리 적용 시
		'6617.처리대기중입니다.
		if Recv_Code == "6617" or Recv_TR_Code == "6617" then
			if szTranID == "obtss_fido_013a" then
				g_BIOSeqNo 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OTSD_TR_UNIQ_NO", 0)
				g_BIOTrName	= szTranID
				g_BIORetry	= 0
				
				Form.SetTimerEvent2(2,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회
				
			elseif szTranID == "obtss_fido_213r" then
				g_BIORetry = g_BIORetry + 1
				Form.SetTimerEvent2(2,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			end if
			
			exit sub
		end if
		
		Form.removeWaitCursor()
		
		tbl_fido2("OTSD_TR_UNIQ_NO")	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OTSD_TR_UNIQ_NO"	,0)
		tbl_fido2("BIO_TLMS_TRC_NO")	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BIO_TLMS_TRC_NO"	,0)
		tbl_fido2("FIDO_TLMS_TRC_NO")	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDO_TLMS_TRC_NO"	,0)
		
		sParam = tbl_fido2("FIDO_TLMS_TRC_NO") & "★" & g_sBIOAthnTchnCode & "★" & "N" 'FIDO추적번호,인증기술코드,축약서명키쌍 필요여부(Y/N)
		Form.requestKftcBio("Bio_2115", sParam, "90060")			
		
	'티켓온 인증결과 응답
	elseif szTranID == "obtss_fido_014a" or szTranID == "obtss_fido_214r" then 
		Recv_Code			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_CODE" 			,0) '응답코드
		Recv_Msg				= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RSPN_MSG_CNTT" 		,0) '응답메세지 내용
		Uniq_Code			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OTSD_TR_UNIQ_NO" 		,0) '대외거래고유번호	
		Recv_FIDO_SIGN_DATA 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_FIDO_ELCT_SGNT_DATA"	,0)	'UIFIDO전자서명데이터
		Recv_TR_Code	= DATAMANAGER.GetDataMsgCode(szTranID)
		
		'20220614_01 KBC 송수신분리 적용 시
		'6617.처리대기중입니다.
		if Recv_Code == "6617" or Recv_TR_Code == "6617" then
			if szTranID == "obtss_fido_014a" then
				g_BIOSeqNo 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OTSD_TR_UNIQ_NO", 0)
				g_BIOTrName	= szTranID
				g_BIORetry	= 0
			
				Form.SetTimerEvent2(2,1,DEF_1ST_TIME) '처음1회는 0.5초 후 조회
				
			elseif szTranID == "obtss_fido_214r" then
				g_BIORetry = g_BIORetry + 1
				Form.SetTimerEvent2(2,1,DEF_2ST_TIME) '2회부터는 1초 후 조회, 3회 실패 시 서비스에서 에러처리
			end if
			
			exit sub
		end if
		
		Form.removeWaitCursor()
		
		if g_sLinkBioAthnUsagClsCode == "1" or g_sLinkBioAthnUsagClsCode == 1 Then '인증용도구분코드 (0.일반 1.출금동의 증빙자료)
			g_sResult = "ok;;" & Recv_FIDO_SIGN_DATA
		else
			g_sResult = "ok"
		end if
		
		'KBC '''''015a올려야 하나? 차차장님한테 물어보자
		Form.CloseForm( )
'		DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "SUCS_YN" , 0 , "Y") 	'성공여부	
'		DATAMANAGER.RequestTranData("obcpp_logn_015a")
	end if
	'20161108 NOHES END
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	If szTranID == "ohhts_ocsp_001r" Then
		If g_sCertUserType == "1" Then
			szErrMsg2 = "간편인증서비스 신청 시 사용한 인증서는 더이상 사용하실 수 없습니다.\n\n" &
				        "유효한 인증서로 ID로그인하신 후 간편인증서비스를 재설정 해주시기 바랍니다.\n\n" &
					    "[TR]" & szErrMsg

			ShowAlert "알림", szErrMsg2 
		Else
			sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
			ShowAlert "알림", "[TR]" & szErrMsg &" " &sSubmsg
		End If
		
	'-------------------------------------------------------------------------------------------------------
	'20220614_01 KBC START 바이오인증 송수신분리
	'-------------------------------------------------------------------------------------------------------
	'FIDO 인증 에러	
	elseif szTranID == "obtss_fido_003a" or szTranID == "obtss_fido_004a" or szTranID == "obtss_fido_013a" or szTranID == "obtss_fido_014a" then
	
		Form.removeWaitCursor() '20220614_01 KBC 바이오인증 송수신분리 (서비스에러)
	
		'KBC : 결제원 에러는 모두 5891로 내려주고있어어 아래 로직은 삭제함
		'      결제원 에러메시지는 부메세지로 내려주고 있음
'		if szErrCode == "5891" then '메리츠 5891 -> 결제원 6606에러코드 (서비스 사용자 미등록 단말)
'			if g_sBIOAthnTchnCode == DEF_BIO_FINGER then
'				szErrMsg = "바이오인증(지문) 등록 필요"
'			'elseif g_sBIOAthnTchnCode == DEF_BIO_FACE then
'			'	szErrMsg = "바이오인증(얼굴) 등록 필요"
'			elseif g_sBIOAthnTchnCode == DEF_BIO_PIN then
'				szErrMsg = "바이오인증(간편번호) 등록 필요"
'			elseif g_sBIOAthnTchnCode == DEF_BIO_PALM then
'				szErrMsg = "바이오인증(손바닥) 등록 필요"
'			end if						
'		end if
		
		sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if Len(sSubMsg) > 1 Then
			Form.MsgBox("알림", "[TR] " & szErrMsg & "\n\n" & sSubMsg, "FIDO_MBX", 0)
		else
			Form.MsgBox("알림", "[TR] " & szErrMsg  , "FIDO_MBX", 0)
		end if
		
		'KBC '''''015a올려야 하나? 차차장님한테 물어보자
'		DATAMANAGER.SetDataValue( 0, "obcpp_logn_015a", "InBlock1", "SUCS_YN" , 0 , "N") 	'성공여부	
'		DATAMANAGER.RequestTranData("obcpp_logn_015a")

	elseif szTranID == "obtss_fido_203r" or szTranID == "obtss_fido_204r" or szTranID == "obtss_fido_213r" or szTranID == "obtss_fido_214r" then
		
		Form.removeWaitCursor() '20220614_01 KBC 바이오인증 송수신분리 (서비스에러)
		
		sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if Len(sSubMsg) > 1 Then
			Form.MsgBox("알림", "[TR] " & szErrMsg & "\n\n" & sSubMsg, "", 0)
		else
			Form.MsgBox("알림", "[TR] " & szErrMsg  , "", 0)
		end if
	'-------------------------------------------------------------------------------------------------------
	'20220614_01 KBC END 바이오인증 송수신분리
	'-------------------------------------------------------------------------------------------------------
		
	Else
		sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.MsgBox( "알림", "[TR]" &  szErrMsg &" "& sSubmsg , "", 0 )
	End If
End Sub

'============================================================================
' 바이오인증 응답용 TriggerEventBio
'============================================================================
Sub Form_OnTriggerEventBio(sEventName, sParam)
	
	Dim sRet, sErrorCode, sErrorMsg
	sRet = Split(sParam, "★")
	
	if #sRet > 1 then
		sErrorCode	= sRet[0]
		sErrorMsg	= sRet[1]			
	else
		exit sub
	end if
	
	if #sRet > 2 then
		sBioRet = Form.KBase64Decoding(sRet[2])
		sBioItemRet = Split(sBioRet, "★")
	end if	

	'FIDO 인증 통보
	if sEventName == "90060_Bio_116" then
		'--- FIDO 인증응답메시지 수신 ---
		sAAID			= sBioItemRet[0]	'AAID
		sNIDCT 			= sBioItemRet[1]	'비식별호환토큰
		sFIDOMSG 		= sBioItemRet[2]	'FIDO 인증응답메시지
		sAppVersion 		= sBioItemRet[3]	'앱버전
		sBriefSignPubKey	= sBioItemRet[4]	'공개키
		sBriefSignPrvKey	= sBioItemRet[5] 	'개인키
		'				  sBioItemRet[6]	'독자인증장치(SW)사용여부
		
		ProcSendBIO_004a(g_sID, "0000", tbl_fido1("BIO_TLMS_TRC_NO"), g_sLinkBioAthnUsagClsCode, sAAID, "S", sNIDCT, sBriefSignPubKey, sFIDOMSG)		
	
	'티켓온FIDO 인증
	elseif sEventName == "90060_Bio_2116" then
		'sBioItemRet[0] 'P7Sign Data
		'sBioItemRet[1] '축약서명공개키
		'sBioItemRet[2] '축약서명개인키
		
		'인증결과 전송
		ProcSendBIO_014a(g_sID, tbl_fido2("BIO_TLMS_TRC_NO"), g_sLinkBioAthnUsagClsCode)		
		
	'FIDO 에러코드
	elseif sEventName == "90060_Bio_1000" then
		If Len(sErrorCode) > 0 Then
			'IOS 바이오인증 재신청 요청 메시지 추가
			If  g_sBIOTermOS == "2" And sErrorCode == "-1402" Then '1.안드로이드 2.iOS
				Form.MsgBox("알림", "바이오인증 연계앱 정보가 일치하지 않습니다. 바이오인증을 신청하신 후, 사용 가능합니다.\n신청하시겠습니까?", "FIDO_JOIN", 1)
				exit sub
			else
				'20180911_01 KBC 
				if sErrorCode == "-1203" then '사용자 취소의 경우 팝업 띄우지말자
					exit sub
				end if
			
				if #sBioItemRet > 2 and Len(sBioItemRet[2]) > 0 then
					Form.MsgBox("알림", sErrorMsg & "\n(" & sBioItemRet[2] & "회 오류)" , "", 0) 				
				else
					Form.MsgBox("알림", sErrorMsg  , "", 0)
				end if
			end if
		End If
		
		'금융앱이 코드 115 전송 후, 지문인증시 사용자 취소 등에 의해서 -1203, -1290 에러를 반환받은 경우,
		'FIDO인증요청전문을 분산관리센터로 전송 시, 인증결과코드에 "5121"을 넣어서 전달해야한다.
		'   1203 : 사용자가 FIDO 인증을 취소함
		'   1290 : 취소 또는 바이오정보가 일치하지 않습니다.
		'
		'KBC : 티켓온 인증시에는 오류횟수를 연계앱에서 알아서 바이오서버와 통신하면서 처리하기때문에 금융사에서 처리할 필요가 없다
		'      1290 or 1203 에서 1203은 취소시에만 리턴되므로 제거함(독자인증장치로 전환했기때문에 가능)

		'if sBioItemRet[0] = "Bio_115" And (sErrorCode == "-1290" or sErrorCode == "-1203") then '20180911_01 KBC
		if sBioItemRet[0] = "Bio_115" And sErrorCode == "-1290" then
			ProcSendBIO_004a(g_sID , "5121", tbl_fido1("BIO_TLMS_TRC_NO"), "0", "", "S", "", "", "")			
		end if
		
	elseif sEventName == "90060_Bio_402"	Then
		
		'sBioItemRet[0]	'디바이스 아이디
		'sBioItemRet[1]	'앱버전
		'sBioItemRet[2]	'인증기술목록
		'sBioItemRet[3]	'홍채이관대상유무

		g_sBIOTermID		= Form.getKftcBioDeviceID(); 'Bio_401 을 태우면 Bio_402 리턴할때 getKftcBioDeviceID()를 통해서 Device ID를 가져올 수 있다.(앱에서 처리중)
		g_sBioAppVersion	= sBioItemRet[1]

		if Len(Trim(g_sBIOTermID)) < 1 Then
			Form.MsgBox("알림", "바이오인증을 등록한 단말정보가 없습니다.\n바이오인증 신청 후, 사용 가능합니다.\n신청하시겠습니까?", "FIDO_JOIN", 1)
			exit sub
		end if

		ATHN_TYPE_CODE		= "S"				'인증타입 : S.자사인증 D.교차인증 C.호환인증
		ABRV_SGNT_TYPE_CODE	= "0"				'서명타입 : 0.일반서명 1.축약/자동서명
		BIO_TR_TYPE_CODE		= g_sLinkBioTrCode	'거래타입 : 0.인증(로그인) 1.서명(서명)
		ATHN_TCHN_CODE		= g_sBIOAthnTchnCode	'인증기술코드 : 100.지문, 105.얼굴, 115.손바닥, 116.PIN

		if g_sBIOAthnTchnCode == DEF_BIO_FINGER then 'or g_sBIOAthnTchnCode == DEF_BIO_FACE then
			ProcSendBio_003a(g_sID, ABRV_SGNT_TYPE_CODE, g_sBIOTermOS, g_sBIOTermID, DEF_BIO_SVCD, ATHN_TYPE_CODE, BIO_TR_TYPE_CODE)			
		else
			ProcSendBio_013a(g_sID, g_sBIOTermID, DEF_BIO_SVCD, BIO_TR_TYPE_CODE, ATHN_TCHN_CODE)
		end if
		
	else
		Form.MsgBox("알림", sErrorMsg , "", 0)
	end if
End Sub

'============================================================================
'공동FIDO 인증정보 생성 요청 통보
Sub ProcSendBIO_003a(ELFN_ID, ABRV_SGNT_TYPE_CODE, TERM_OS_CODE, TERM_ID, SVCD, ATHN_TYPE_CODE, BIO_TR_TYPE_CODE)
	szTranID = "obtss_fido_003a"
	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID" 			, 0, ELFN_ID)				'ID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ABRV_SGNT_TYPE_CODE"	, 0, ABRV_SGNT_TYPE_CODE)	'서명타입	: 0.일반서명, 1.축약/자동서명
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "TERM_OS_CODE" 		, 0, TERM_OS_CODE)		'단말운영체제	: 1.안드로이드, 2.아이폰, 9.기타
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "TERM_ID" 			, 0, TERM_ID)				'단말ID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" 				, 0, SVCD)				'서비스코드	: 001.고정
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ATHN_TYPE_CODE" 		, 0, ATHN_TYPE_CODE)		'인증타입	: S.자사인증, D.교차인증, C.호환인증
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BIO_TR_TYPE_CODE" 	, 0, BIO_TR_TYPE_CODE)		'거래타입	: 0.인증, 1.서명
	
	'------------------------------------------------------------------------
	'거래타입 : 0.인증(로그인) 1.서명(서명)
	if BIO_TR_TYPE_CODE == "1" or BIO_TR_TYPE_CODE == 1 Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "TRAN_CNTT", 0, g_sLinkBioTranCntt) '거래내용
	end if
	'------------------------------------------------------------------------
	
	DATAMANAGER.RequestTranData(szTranID)	
End Sub

'============================================================================
'공동FIDO인증전송
Sub ProcSendBIO_004a(ELFN_ID, APP_RSPN_CODE, BIO_TLMS_TRC_NO, ATHN_USAG_CLS_CODE, AAID, ATHN_TYPE_CODE, NID_CMPA_TOKEN, UI_ABRV_SGNT_OPBL_KEY, UI_FIDO_ATHN_RSPN_MSG)
	szTranID = "obtss_fido_004a"
	
	g_BIOAppErrCd = APP_RSPN_CODE '20220614_01 KBC 바이오인증 송수신분리

	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID" 				, 0, ELFN_ID)						'ID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "APP_RSPN_CODE" 			, 0, APP_RSPN_CODE)				'연계앱응답코드 : 0000.정상, 5219.에러
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BIO_TLMS_TRC_NO" 			, 0, BIO_TLMS_TRC_NO)				'전문추적번호
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ATHN_USAG_CLS_CODE" 		, 0, ATHN_USAG_CLS_CODE)			'인증용도구분코드 : 0.일반, 1.출금동의 증빙자료
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "AAID" 					, 0, AAID)						'AAID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ATHN_TYPE_CODE" 			, 0, ATHN_TYPE_CODE)				'인증타입 : S.자사인증, D.교차인증, C.호환인증
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "NID_CMPA_TOKEN" 			, 0, NID_CMPA_TOKEN)				'비식별호환토큰
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_FIDO_MSG_SIZE1" 		, 0, LEN(UI_ABRV_SGNT_OPBL_KEY))	'축약서명공개키길이
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_ABRV_SGNT_OPBL_KEY"	, 0, UI_ABRV_SGNT_OPBL_KEY)			'축약서명공개키
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_FIDO_MSG_SIZE2" 		, 0, LEN(UI_FIDO_ATHN_RSPN_MSG))	'FIDO인증응답메시지길이
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_FIDO_ATHN_RSPN_MSG" 	, 0, UI_FIDO_ATHN_RSPN_MSG)			'FIDO인증응답메시지

	DATAMANAGER.RequestTranData(szTranID)
End Sub

'============================================================================
'티켓온 인증정보 생성 요청 통보
Sub ProcSendBIO_013a(ELFN_ID, TERM_ID, SVCD, BIO_TR_TYPE_CODE, ATHN_TCHN_CODE)
	szTranID = "obtss_fido_013a"
	
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID" 			, 0, ELFN_ID)				'ID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "TERM_ID" 			, 0, TERM_ID)				'단말ID
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" 				, 0, SVCD)				'서비스코드	: 001. 고정
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "BIO_TR_TYPE_CODE" 	, 0, BIO_TR_TYPE_CODE)		'거래타입	: 0.인증, 1.서명
	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ATHN_TCHN_CODE" 		, 0, ATHN_TCHN_CODE)		'인증기술코드	: 100.지문, 105.얼굴, 116.PIN, 115.손바닥
	
	'------------------------------------------------------------------------
	'거래타입 : 0.인증(로그인) 1.서명(서명)
	if BIO_TR_TYPE_CODE == "1" or BIO_TR_TYPE_CODE == 1 Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "TRAN_CNTT", 0, g_sLinkBioTranCntt) '거래내용
	end if	
	'------------------------------------------------------------------------

	DATAMANAGER.RequestTranData(szTranID)	
End Sub

'============================================================================
'티켓온 인증전송
Sub ProcSendBIO_014a(ELFN_ID, BIO_TLMS_TRC_NO, ATHN_USAG_CLS_CODE)
	szTranID = "obtss_fido_014a"

	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1", "ELFN_ID"			, 0 , ELFN_ID) 			'전자금융ID
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1", "BIO_TLMS_TRC_NO"		, 0 , BIO_TLMS_TRC_NO)		'바이오전문추적번호
	DATAMANAGER.SetDataValue(0, szTranID , "InBlock1", "ATHN_USAG_CLS_CODE"	, 0 , ATHN_USAG_CLS_CODE)	'인증용도구분코드 : 0.일반, 1.출금동의 증빙자료

	DATAMANAGER.RequestTranData(szTranID)
End Sub
'============================================================================
' 20181015 LES START 
' 아이폰의 경우 Form_OnFormInit에서 Form.requestKftcBio("Bio_401", "", "90060") 호출시
' 정상적으로 402로 리턴이 오지 않아 이부분에서 호출해준다.
'============================================================================
Sub Form_OnFormInitAfter()

	szOStype = Form.GetSharedData( "&OS_TYPE", false ) 'iOS("2")Android("1")
	
	if szOStype == "2" Then
		If CInt(g_sLoginType) >= 2 And g_sCertUserType == "3" Then
			Form.requestKftcBio("Bio_401", "", "90060")
		end if
	end if

End Sub

'============================================================================
Sub Form_OnFormInitBefore()

	'20181026 LES START
	'블랙테마일 경우, 상단 테이블 배경색 변경
	sTheme = Form.GetEnvData("common.theme")
	
	if sTheme == "black" then
		ContBio.Table1.SetCellBgColor(0, 0, "144")
	end if
	'20181026 LES END
	
	'20230524 SWJ START l 이미지 찌그러짐 방지
	ContAton.Pwdbasic0.setMaintainingRatio("1")
	ContAton.Pwdbasic1.setMaintainingRatio("1")
	ContAton.Pwdbasic2.setMaintainingRatio("1")
	ContAton.Pwdbasic3.setMaintainingRatio("1")
	ContAton.Pwdbasic4.setMaintainingRatio("1")
	ContAton.Pwdbasic5.setMaintainingRatio("1")
	ContAton.Pwdinsert0.setMaintainingRatio("1")
	ContAton.Pwdinsert1.setMaintainingRatio("1")
	ContAton.Pwdinsert2.setMaintainingRatio("1")
