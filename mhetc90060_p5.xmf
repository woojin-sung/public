'============================================================================
Sub procVerifyBioSignature()
	'-----------------------------------------------------------------------
	'ATON_CHECKBIOSIGNATURE
	'-----------------------------------------------------------------------
	sRet = Form.requestAtonAuth("ATON_CHECKBIOSIGNATURE" , "" , "")
	
	sRetItem = Split(sRet, "★")
	
	sErrorCode	= sRetItem[0]
	sErrorMsg	= sRetItem[1]
		
	if sErrorCode <> "00000" then
		
		'iOS전용 (인증 실패 초과 시)
		if sErrorCode == "E4106" then
			Form.MsgBox("안내", "시도 횟수가 너무 많습니다.\n잠시 후 다시 시도하거나\n간편비밀번호로 인증해주세요.", "E4106", 7, "간편비밀번호 인증","확인")
			exit sub
		elseif sErrorCode == "E4102" then
			
			if g_sBIOTermOS == "1" then
				szErrMsg = "스마트폰에 등록된 지문이 없습니다.\n지문 등록 후 이용해주세요."
			else
				szErrMsg = "스마트폰에 등록된 생체 정보가 없습니다.\n생체 정보 등록 후 이용해주세요."
			end if
			
			Form.Msgbox("안내", szErrMsg, "", 6)
			exit sub
		elseif sErrorCode == "E4103" then
			Form.Msgbox("안내", "간편비밀번호를 사용중입니다.\n로그인 후 생체인증 추가 등록해주세요.", "", 6)
			exit sub
		elseif sErrorCode == "E4105" then
			exit sub
		end if
		
		Form.MsgBox("알림", sErrorCode & "," & sErrorMsg, "", 0)
		exit sub
	end if	
	
	'-----------------------------------------------------------------------
	'ATON_VERIFYBIOSIGNATURE
	'-----------------------------------------------------------------------
	Form.requestAtonAuth("ATON_VERIFYBIOSIGNATURE" , "" , "90060p5")	
End Sub
'============================================================================
Sub procRequestAtonTR_INQUIRYCERT()
	sTranID = "ohhts_pauth_004"
	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , "MERITZSMART")	'매체구분코드
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CERT_SEQ_NO" 				, 0 , g_SBAlias)		'인증서일련번호 (고객번호, 일련번호 중 1개는 필수)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CUST_NO" 					, 0 , g_CustNo )		'인증서일련번호 (고객번호, 일련번호 중 1개는 필수)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId)		'이용자접속기기ID
		
	DATAMANAGER.RequestTranData(sTranID)
End Sub
'============================================================================
Sub procRequestAtonTR_REQPRE(paramOnttCon)
	g_OnttConn = paramOnttCon
	
	sTranID = "ohhts_pauth_021"
	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , "MERITZSMART")	'매체구분코드 (1인 1단말 정책이라, 채널코드 고정)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CERT_SEQ_NO" 				, 0 , g_SBAlias)		'인증서일련번호
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_MSB_VRSN_VL" 				, 0 , g_SBVersion)	'mSB버전값 (라이브러리 버전 정보)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceID)		'이용자접속기기ID
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_TRAN_ELSG_ONTT_CON" 		, 0 , paramOnttCon)	'거래전자서명원문내용
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CUST_NO" 					, 0 , g_CustNo)		'고객번호
	
	DATAMANAGER.RequestTranData(sTranID)		
End Sub
'============================================================================
Sub procRequestAtonTR_VRFY(paramCertTranNo, paramOnttCon, paramDataCon, paramCrtcDataCon)			
	sTranID = "ohhts_pauth_022"
	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 ,"MERITZSMART")	'매체구분코드 (1인 1단말 정책이라, 채널코드 고정)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CERT_SEQ_NO" 				, 0 , g_SBAlias)		'인증서일련번호
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_MSB_VRSN_VL" 				, 0 , g_SBVersion)	'mSB버전값 (라이브러리 버전 정보)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceID)		'이용자접속기기ID
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CERT_TRAN_NO" 				, 0 , paramCertTranNo)	'인증서거래번호
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_TRAN_ELSG_ONTT_CON" 		, 0 , paramOnttCon)	'거래전자서명원문내용
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_TRAN_ELSG_DATA_CON" 		, 0 , paramDataCon)	'거래전자서명데이터내용
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CUST_NO" 					, 0 , g_CustNo)		'고객번호
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CRTC_PTRN_DCD" 			, 0 , g_AuthType)		'인증유형구분코드(10:PIN, 20:BIO, 30:Pattern)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CRTC_DATA_CON" 			, 0 , paramCrtcDataCon)'인증유형데이터내용 (HexString, 64Byte)

	'바이오인증성공여부(Y:인증성공, N:인증실패) 인증유형구분코드가 '20(BIO)' 인 경우에만 해당 필드가 유효함
	if g_AuthType == DEF_ATON_PIN then
		DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_BIO_CRTC_SUCC_YN" 		, 0 , "N")
	else
		DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_BIO_CRTC_SUCC_YN" 		, 0 , "Y")
	end if
	
	DATAMANAGER.RequestTranData(sTranID)		
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "ohhts_pauth_021" then
		'-----------------------------------------------------------------------
		'전자서명을위한 원문(g_OnttConn)
		'   -> 전자서명데이터(sPKCS7) 
		'-----------------------------------------------------------------------
		
		sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" ,0)
		sTranNo 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_TRAN_NO" ,0) '인증서거래번호
		
		if sErrorCode <> "000000" then
			'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
			sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode, "")

			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if
		
		'-----------------------------------------------------------------------
		'ATON_SIGN
		'-----------------------------------------------------------------------		
		sRet = Form.requestAtonAuth("ATON_SIGN" , g_SBAlias & "★" & g_OnttConn , "")
		sRetItem = Split(sRet, "★")
		
		sErrorCode	= sRetItem[0]
		sErrorMsg	= sRetItem[1]
		sPKCS7		= sRetItem[2] '서명원문의 byte 형식 데이터
		
		if sErrorCode <> "00000" then
			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if	
				
		'-----------------------------------------------------------------------
		'인증유형데이터
		'-----------------------------------------------------------------------	
		sCrtcDataCon = g_Signature
	
		'-----------------------------------------------------------------------
		'전문전송
		'-----------------------------------------------------------------------		
		procRequestAtonTR_VRFY(sTranNo, g_OnttConn, sPKCS7, sCrtcDataCon)	
		
	elseif szTranID == "ohhts_pauth_022" then
		sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" ,0)
		
		if sErrorCode <> "000000" then
			'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
			sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode, "")
			
			if PwdErrorCount(sErrorCode) == true then			
				exit sub
			end if
			
			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if		
		
		strMediaType =  Trim(Form.GetSharedData("&MEDIA_CODE", 0))	
		sDeviceID = Form.GetDeviceID2()
		
		if g_AuthType == "10" then
			szAthnTchnCode = "10"	
		elseif g_AuthType == "20" then
			if fnGetCrtc() == "100" then
				szAthnTchnCode = "20"
			else
				szAthnTchnCode = "21"
			end if
		end if
		
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_057a", "InBlock1", "USER_ID" 			 , 0 ,   g_sID            )
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_057a", "InBlock1", "CSNO" 	 			 , 0 ,   g_CustNo         )
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_057a", "InBlock1", "CHAN_TYPE_CLS_CODE" 	 , 0 ,   strMediaType     )
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_057a", "InBlock1", "ATHN_MDIA_TYPE_CODE"   , 0 ,   szAthnTchnCode  )
		DATAMANAGER.SetDataValue( 0, "obcpp_logn_057a", "InBlock1", "IPAD"  				 , 0 ,    sDeviceID       )
		
		DATAMANAGER.RequestTranData("obcpp_logn_057a")
	
	elseif szTranID == "ohhts_pauth_004" then
		sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" ,0)
		g_AtonBioYn	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_BIO_USE_YN" ,0) 			'생체인증사용여부
		g_SBAlias	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_CERT_SEQ_NO" ,0) 			
		
		if sErrorCode <> "000000" then		
			'메시지 박스 처리할지 확인
			'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
			sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode, "")

			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
		end if		
		
		'지문/face 인증 실패 시 pin으로 입력 가능하도록
		if g_nCnt = 6 then
			g_AuthType = DEF_ATON_PIN

			'비밀번호 입력키패드 Show
			Form.SetTimerEvent2(1, 1, 0.6)
		end if
		
		if g_sAthnTchnCode == "10" then
			g_AuthType = DEF_ATON_PIN
			'비밀번호 입력키패드 Show
			Form.SetTimerEvent2(1, 1, 0.6)
		else
			'로그인 시 인증 타입이 BIO인 경우
			if fnGetSBInfo("") == False then 
				exit sub
			end if
				
			g_AuthType = DEF_ATON_BIO
			
			procVerifyBioSignature()
		end if
	end if 
End Sub

'============================================================================
Sub Form_onTriggerEventAton(sEventName, sParam)
	
	'ATON_SETBIOSIGNATURE, ATON_VERIFYBIOSIGNATURE 만 여기로만 진입
	if sEventName == "ATON_SETBIOSIGNATURE_RETURN_90060p5" or sEventName == "ATON_VERIFYBIOSIGNATURE_RETURN_90060p5" then
	
		sRet = Split(sParam, "★")
	
		sErrorCode	= sRet[0]
		sErrorMsg	= sRet[1]			
		
		'E4100	생체 데이터에 오류가 발생하였습니다.
		'E4101	생체 등록 정보가 변경되었습니다.
		'E4102	단말에 등록된 생체 정보가 없습니다.
		'E4103	생체 인증 등록 키가 존재하지 않습니다.
		'E4104	생체 인증에 실패하였습니다.
		'E4105	생체 인증을 취소하였습니다.
		'E4106	TouchID/FaceID가 잠겨있습니다.
		'E4107	단말에 등록된 패스워드가 없습니다.
		'E4108	생체 정보를 사용할 수 없습니다.
	
		if sErrorCode <> "00000" then
			
			if sErrorCode == "E4102" then
				if g_sBIOTermOS == "1" then
					szErrMsg = "스마트폰에 등록된 지문이 없습니다.\n지문 등록 후 이용해주세요."
				else
					szErrMsg = "스마트폰에 등록된 생체 정보가 없습니다.\n생체 정보 등록 후 이용해주세요."
				end if
				
				Form.Msgbox("안내", szErrMsg, "", 6)
				exit sub
			elseif sErrorCode == "E4103" then
				Form.Msgbox("안내", "간편비밀번호를 사용중입니다.\n로그인 후 생체인증 추가 등록해주세요.", "", 6)
			elseif sErrorCode == "E4105" then
				exit sub
			'안드로이드 전용 (인증 실패 초과 시)
			'7은 현재 테스트앱 기준이고, e4106으로 앱에서 에러코드 맞춰줄 것
			'안드는 해당 이벤트에서 지문인증 실패초과 메시지 뿌려준다
			elseif sErrorCode == "E4106" or sErrorCode == "7" then
				Form.MsgBox("안내", "시도 횟수가 너무 많습니다.\n잠시 후 다시 시도하거나\n간편비밀번호로 인증해주세요.", "E4106", 7, "간편비밀번호 인증","확인")
				exit sub
			end if
			
			'바이오->간편비밀번호인증 수행 START
			g_AuthType = DEF_ATON_PIN
				
			'비밀번호 입력키패드 Show
			Form.SetTimerEvent2(1, 1, 0.6)
			'바이오->간편비밀번호인증 수행 END
			
			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if

		sBioSignature	= sRet[2]
	end if
	
	if sEventName == "ATON_VERIFYBIOSIGNATURE_RETURN_90060p5" then
		g_Signature = sBioSignature
		procRequestAtonTR_REQPRE(g_sLinkBioTranCntt)
	end if
End Sub

'============================================================================
Sub MeritzAuth()
	ContBio.visible = False
	ContAton.visible = True
	ButtonCancel.visible = false
	ButtonOK.visible = false
	Table0.visible = False
	Edit0.visible = False
	Image0.visible = False
	ButtonAtonOk.visible = True
	chkSkip.visible = False
	
	Form.SetScreenName("메리츠 간편인증")
	'labTitle.caption = "메리츠 간편인증"
	'Edit0.certname = "인증서 비밀번호 입력"
	
	'-----------------------------------------------------------------------
	'전문전송
	'-----------------------------------------------------------------------	
	procRequestAtonTR_INQUIRYCERT()
	'-----------------------------------------------------------------------	
End Sub
'============================================================================
Sub PwdErrorCount(sErrorCode)
	Select Case sErrorCode
	
	Case "050201"
		szErrorcnt = "1"
	Case "050202"
		szErrorcnt = "2"
	Case "050203"
		szErrorcnt = "3"
	Case "050204"
		szErrorcnt = "4"
	Case "050205"
		Form.OpenPopup("mpopup_auth", "PinError5", "")
		return true
	Case "050101"
		Form.OpenPopup("mpopup_auth", "PinError5", "")
		return true
	Case Else
		szErrorcnt = ""
		return false
	End Select
	
	Form.MsgBox("안내", "간편비밀번호 "&szErrorcnt&"회 오류입니다.\n연속 5회 오류 시 접속이 제한됩니다.", "PinError", 6)
	
	return true
End Sub
'============================================================================
Sub ContAton_BtnRegi_OnClick()
	Form.OpenPopup("mpopup_auth","CommonAuthPopup","")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mpopup_auth" then
		if sRet == "register" then	'핀오류 재등록, 비밀번호 잊어버렸을 시
			g_Register = "Y"
			Form.CloseForm()
			
		elseif sRet == "cancel" then
			Form.CloseForm()
		end if
	end if
End Sub

