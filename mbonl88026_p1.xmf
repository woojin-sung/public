'============================================================================
' CDS 계약 신청
' v001 : 2023.10.23 양현정 : 매핑오류수정
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_tAgreeUrl 
dim g_tAgreeState 
dim g_szUnCheckImg, g_szCheckImg'체크이미지
dim g_szUnCheckFg, g_szCheckFg	'체크 폰트 컬러

dim g_szUserInfoFlag			'계약서류제공 개정정보유무 여부
dim g_szNotiFlag				'이용동의서류 제공방식 선택 상태
dim g_bUseCreditAgree			'개인(신용) 필수 동의 여부
dim g_bCheckCreditAgree		'개인(신용) 필수 동의 팝업에서 동의 진행한 여부
dim g_bCheckCreditPopup		'개인(신용) 필수 동의 팝업 오픈 여부
dim g_nTooltip_Top			'툴팁 팝업 TOP VALUE
Dim g_szSavePwd             	'계좌비밀번호 저장여부
dim g_nCnt					'금융상품가입일련번호 요청된 카운트
dim g_Acno
dim g_ISCD
dim g_RCNO_PIP				'실명확인번호
Dim g_szFnprJoinSrno			'금융상품일련번호
DIm g_szSvcSrno				'서비스 일련번호

dim g_CUST_CLS_CODE			'개인/법인구분코드(1:개인,2:법인)

Dim g_plain_rm  		'v0002 메모리평문적용여부

dim g_ErrMsgText				'신청불가오류메시지

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'f_InitUI() : 컨트롤 위치, 체크 상태, 이미지 등 초기화
'============================================================================
Function f_InitUI()
	g_Acno 		= Left(cmbAccount.caption, 8)
	f_SetToggleUI(-1)
	lblNoData.visible = false
	edtPassword.caption = ""
	if g_szSavePwd == "0" then
		edtPwdIcon.imgpath = "icon_save_password_n.9"
		edtPassword.caption = ""
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
End Function

'============================================================================
' 법인/개인 구분하여 약관 항목 노출
'============================================================================
Function f_SetAgree()

	f_InitUI()
	
	if g_CUST_CLS_CODE == "2" then
		' 법인인 경우, 개인 약관은 노출시키지 않음.
		contInfo.visible = false
		contMain.visible = true
		contSub.visible = false
		imgAgreeBg.visible = true
		
		imgAgreeBg.height = 220
	
	else
		' 개인인 경우, 약관 모두 노출하고, 신용정보조회도 함.
		contInfo.visible = false
		contMain.visible = true
		contSub.visible = true
		imgAgreeBg.visible = true
	
		imgAgreeBg.height = 280
	
	end if
	
	contNoti.visible = false
	
End Function

'============================================================================
'f_bCheckBeforeReg() : 계약 신청 적합성 체크
'============================================================================
Function f_bCheckBeforeReg()

	'계좌번호 존재 유무 체크
	if cmbAccount.total == "" or cmbAccount.total == null or Len(cmbAccount.total) < 8 then
		Form.MsgBox("알림", "계좌번호를 확인해주세요.", "", 0)
		return false
	end if
	'계좌 비밀번호 입력 체크
	if edtPassword.caption == "" or edtPassword.caption == null or Len(edtPassword.caption) < 4 then
		Form.MsgBox("알림", "비밀번호를 확인해주세요.", "", 0)
		return false
	end if
	'영문명 존재 유무 체크
	if Trim(contEngNm.tblEnNm.GetCellString( 0, 1 )) == "" or Trim(contEngNm.tblEnNm.GetCellString( 0, 1 )) == null then
		Form.MsgBox("알림", "고객 영문명을 확인해 주세요.", "", 0)
		return false
	end if
	
	'이용동의서류 제공방식 선택 여부 체크
	if g_szNotiFlag == "" or g_szNotiFlag == null then
		Form.MsgBox("알림", "계약서류 제공방식을 선택해 주세요.", "", 0)
		return false
	else
		dim szData
		szData = contNoti.tblInfo.GetCellString( 0, 0 )
		if szData == "" or szData == null then
			if g_szNotiFlag == "talk" then
				Form.MsgBox("알림", "핸드폰 번호를 등록해 주세요.", "", 0)
			elseif g_szNotiFlag == "email" then
				Form.MsgBox("알림", "이메일 주소를 등록해 주세요.", "", 0)
			else
				Form.MsgBox("알림", "핸드폰 번호 혹은 이메일 주소를 확인해 주세요.", "", 0)
			end if
			return false
		end if
	end if
	
	'패스워드 암호화여부
	If g_PlainRm = "1" Then
		szPwd = edtPassword.caption
	Else
		 szPwd = edtPassword.encdata
	    if Trim(szPwd) == "" or Trim(szPwd) == null then
		    szPwd = edtPassword.caption
	    end if
	End If
	
	'적합
	return true
End Function

'============================================================================
'f_SetBtnRegEnable() : 신청 처리 버튼 상태 결정
'============================================================================
Function f_SetBtnRegEnable()
	btnReg.visible = true

	'이용동의서류 제공방식 선택 여부
	if g_szNotiFlag == "" or g_szNotiFlag == null then
		btnReg.enable = false
		Exit Function	
	end if

	'개인신용정보 미동의 사용자가 동의를 하지 않았다면 비활성화
	if g_bUseCreditAgree == false and g_bCheckCreditAgree == false then
		btnReg.enable = false
		Exit Function		
	end if 

	'계약서류 통보처 정보 없는경우 비활성화
	if g_szUserInfoFlag == false then
		btnReg.enable = false
		Exit Function		
	end if 

	'신청가능
	btnReg.enable = true
End Function

'============================================================================
'f_SetToggleUI(nFlag) : 서류제공방법 컨트롤 기능 함수
'============================================================================
Function f_SetToggleUI(nFlag)
	dim szToggleImg0, szToggleImg1, szToggleColor0, szToggleColor1
	szToggleImg0 		= "input_01_n.9.png" 	'비활성 이미지
	szToggleImg1 		= "input_01_o.9.png" 	'활성화 이미지
	szToggleColor0 	= "127" 				'비활성 컬러
	szToggleColor1 	= "67" 				'활성화 컬러
	
	if nFlag == 0 then '알림,톡
		contNoti.imgRdo0.imgpath = szToggleImg1
		contNoti.imgRdo1.imgpath = szToggleImg0
		contNoti.lblTalk.fgcolor = szToggleColor1
		contNoti.lblEmail.fgcolor = szToggleColor0
		contNoti.lblInfoText.caption = "고객정보에 등록된 휴대폰 번호로 발송되오니  휴대폰 번호를\r\n반드시 확인해 주세요."
		g_szNotiFlag = "talk"
	elseif nFlag == 1 then '이메일
		contNoti.imgRdo0.imgpath = szToggleImg0
		contNoti.imgRdo1.imgpath = szToggleImg1
		contNoti.lblTalk.fgcolor = szToggleColor0
		contNoti.lblEmail.fgcolor = szToggleColor1
		contNoti.lblInfoText.caption = "고객정보에 등록된 이메일로 발송되오니 이메일 주소를\r\n반드시 확인해 주세요."
		g_szNotiFlag = "email"
	else
		contNoti.imgRdo0.imgpath = szToggleImg0
		contNoti.imgRdo1.imgpath = szToggleImg0
		contNoti.lblTalk.fgcolor = szToggleColor0
		contNoti.lblEmail.fgcolor = szToggleColor0
		contNoti.lblInfoText.caption = ""
		contNoti.tblInfo.visible = false
		contNoti.ImageInfo0.visible = false
		contNoti.lblInfoText.visible = false
		g_szNotiFlag = ""
		Exit Function
	end if
	contNoti.tblInfo.visible = true
	contNoti.ImageInfo0.visible = true
	contNoti.lblInfoText.visible = true
End Function
'============================================================================
'f_SetToggleData(sFlag) : 서류제공방법 DATA SET
'============================================================================
Function f_SetToggleData(sFlag)
	if sFlag == "" or sFlag == null then
		Exit Function
	end if
	Dim szData
	szData = ""
	if sFlag == "talk" then '알림,톡
		szData = contNoti.tblUserInfo.GetCellString(0, 1) '폰번호
	elseif sFlag == "email" then '이메일
		szData = contNoti.tblUserInfo.GetCellString(1, 1) '이메일
	end if
	if szData <> "" and szData <> null then
		contNoti.tblInfo.SetCellString(0, 0, szData)
		contNoti.tblInfo.SetCellString(0, 1, "변경하기 〉")		
		
		g_szUserInfoFlag = true
	else
		contNoti.tblInfo.SetCellString(0, 0, "")
		contNoti.tblInfo.SetCellString(0, 1, "등록하기 〉")
		
		g_szUserInfoFlag = false
	end if
End Function

'============================================================================
'f_CheckPwd() : 비밀번호 입력여부 체크
'============================================================================
Function f_CheckPwd()
	if edtPassword.caption == "" or edtPassword.caption == null 
		or Len(edtPassword.caption) < 4 then
		
		Form.ShowAlert("알림", "비밀번호를 입력해 주세요.")
		return false
	else
		return true
	end if
End Function
