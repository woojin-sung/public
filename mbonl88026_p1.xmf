'============================================================================
Sub Form_OnFormInit()
	
	g_szSavePwd = Form.GetEnvData("order.save_orderpwd")					' 계좌비밀번호 저장여부
	edtPassword.caption = ""
	if g_szSavePwd == "0" then
		edtPwdIcon.imgpath = "icon_save_password_n.9"
		edtPassword.caption = ""
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	btnPwd.bringfront("1")
	
	
	' 약관 내용
	g_szUnCheckImg = "icon_check_off.png"
	g_szCheckImg = "icon_check_on.png"
	g_szUnCheckFg = "127"
	g_szCheckFg = "4"
	
	Dim sDev
	sDev = Form.GetSharedData("&SERVER_MODE", False )
	
	If sDev == "1" Or sDev == 1 Then
		g_tAgreeUrl = {
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/meritz_cfd_account_credential.html", "계좌설정 약관(전문투자자용)",  "urlpath", "N", ""},
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/meritz_cfd_otc_derivatives_contract.html", "장외파생상품거래 기본계약서", "urlpath", "N", ""},
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_cfd_agree.pdf", "금융거래정보제공동의서",  "urlpath", "N", ""},
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/meritz_otc_derivatives_pro-investor_treatment_confirmation.html", "장외파생상품 투자를 위한 전문투자자 대우 확인서", "urlpath", "N", ""},
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/meritz_dna_protect_retail-pro-investor_confirmation.html",    "개인 전문투자자에 대한 보호제도 미적용 확인서", "urlpath", "N", ""},
		    {"http://211.201.184.87/include/resource/comm/ctcn/pdf/crinoferagrm8.pdf", "개인정보제공 및 활용동의", "urlpath", "N", ""}
		}
		
	Else '운영
		g_tAgreeUrl = {
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_cfd_account_credential.html", "계좌설정 약관(전문투자자용)",  "urlpath", "N", ""},
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_cfd_otc_derivatives_contract.html", "장외파생상품거래 기본계약서", "urlpath", "N", ""},
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_cfd_agree.pdf", "금융거래정보제공동의서",  "urlpath", "N", ""},
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_otc_derivatives_pro-investor_treatment_confirmation.html", "장외파생상품 투자를 위한 전문투자자 대우 확인서", "urlpath", "N", ""},
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf/meritz_dna_protect_retail-pro-investor_confirmation.html",    "개인 전문투자자에 대한 보호제도 미적용 확인서", "urlpath", "N", ""},
		    {"http://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm8.pdf", "개인정보제공 및 활용동의", "urlpath", "N", ""}
		}
	End If
	
	g_tAgreeState = {"0", "0", "0", "0", "0", "0"}
	

	g_szFnprJoinSrno = ""
	g_szSvcSrno = ""
	
	
	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
