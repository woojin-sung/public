'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'패스워드 암호화여부
	If g_PlainRm = "1" Then
		szPwd = edtPassword.caption
	Else
		 szPwd = edtPassword.encdata
	    if Trim(szPwd) == "" or Trim(szPwd) == null then
		    szPwd = edtPassword.caption
	    end if
	End If
	'고객번호
	dim szCust_Num
	szCust_Num = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
	
	'고객번호로 전문투자자여부 조회
	if szTranID == "obcsb_acif_799r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , szCust_Num)
		
	'전문투자자정보조회
	elseif szTranID == "obcsb_acif_721r" then
		'v001 DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO" , 0 , szCust_Num)	'실명확인번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , szCust_Num)	'고객번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP" , 0 , g_RCNO_PIP)	'실명확인번호PIP

	'CDS 계약 신청 처리불가 사유 조회
	elseif szTranID == "obpds_srvc_433a" or szTranID == "obpds_srvc_433a_1" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "5")	'약정가능여부 조회
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , szCust_Num)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "092")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , cmbAccount.sequence)'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE" , 0 , "4")
	
	'폰번호, 이메일 조회
	elseif szTranID == "obcsb_acif_140r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
			
	elseif szTranID == "obcsb_acad_122a" then			
		dim strCustTelno, strAddr, strInagTypeCode, strInagSrno, gFnprJoinSrno
		
		if g_szNotiFlag == "talk" then
			strCustTelno = contNoti.tblUserInfo.GetCellString(0, 1)
			strInagTypeCode = contNoti.tblUserInfo.GetCellString(0, 2)
			strInagSrno = contNoti.tblUserInfo.GetCellString(0, 3)
			
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "04")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , strInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , strInagSrno)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "UI_CUST_TELNO" , 0 , strCustTelno)
		elseif g_szNotiFlag == "email" then
			strAddr = contNoti.tblUserInfo.GetCellString(1, 1)
			strInagTypeCode = contNoti.tblUserInfo.GetCellString(1, 2)
			strInagSrno = contNoti.tblUserInfo.GetCellString(1, 3)

			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "02")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , strInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , strInagSrno)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "ADDR"          , 0 , strAddr)
		End If 
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "FNPR_JOIN_SRNO"     , 0 , g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "PROS_CLS_CODE"      , 0 , "1")
			
	'CDS 계약 신청 처리
	elseif szTranID == "obpds_srvc_433a_2" then 	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "1")	'1:등록
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , szCust_Num)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "092")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , cmbAccount.sequence)'계좌번호접촉구분코드
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , edtPassword.caption)	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("edtPassword", "encdata"))
		end if
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE" , 0 , "4")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_DATE" , 0 , Form.GetSharedData("255a_PROS_DATE", FALSE ))
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_SRNO" , 0 , Form.GetSharedData("255a_PROS_SRNO", FALSE ))
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CNSH_ISNC_YN" , 0 , Form.GetSharedData("832a_GOAL_MRKT_UNFIT_YN", FALSE ))
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "GOAL_MRKT_REG_SRNO" , 0 , Form.GetSharedData("832a_GOAL_MRKT_REG_SRNO", FALSE ))

	elseif szTranID == "obcsb_dbif_322a" then 
		dim szSVCD, szFnprJoinSrno, szCNRC_DOCU_KEY_VAL
	
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 				 , 0 , cmbAccount.total	) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO" 	 , 0 , g_szFnprJoinSrno	) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "BSWR_LRDV_CODE" 	 , 0 , "017"				)	'001:계좌개설 / 017:서비스약정 
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "FNPR_JOIN_DETL_SRNO" , 0 , "00001"			)	'다건일경우 하나씩 증가
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ISCD"				 , 0 , "092"				)	'092
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "BSWR_DIV_CODE"       , 0 , "02092"			)  	'02092
		
		szCNRC_DOCU_KEY_VAL = szCust_Num & "$" & "092" & "$" & CInt(g_szSvcSrno)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "CNRC_DOCU_KEY_VAL"	 , 0 , szCNRC_DOCU_KEY_VAL )	'고객번호$서비스코드$서비스일련번호 
		
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcsb_acif_799r" then
		g_CUST_CLS_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "CUST_CLS_CODE", 0)
		g_UI_PFIN_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "UI_PFIN_YN", 0)
		g_PFIN_CLS_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "PFIN_CLS_CODE", 0)
		g_RCNO_PIP = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "RCNO_PIP", 0)  '실명확인번호PIP
'g_CUST_CLS_CODE = "1"
'g_UI_PFIN_YN = "Y"	'EK
		if g_UI_PFIN_YN == "Y" then	'전문투자자
			DATAMANAGER.RequestTranData("obpds_srvc_433a") '신청불가조건 체크
			DATAMANAGER.RequestTranData("obcsb_acif_140r") '폰번호, 이메일 조회
		end if
		
	elseif szTranID == "obpds_srvc_433a" or szTranID == "obpds_srvc_433a_1" then
		dim sPROS_ABLE_YN, sDTL_CNTT
		sPROS_ABLE_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2", "PROS_ABLE_YN", 0)  '처리가능여부
		sDTL_CNTT = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2", "DTL_CNTT", 0)  '상세내용
'sPROS_ABLE_YN = "Y"	'EK.
		if szTranID == "obpds_srvc_433a" and sPROS_ABLE_YN == "Y" then
			'(당연)전문투자자여부 체크
			DATAMANAGER.RequestTranData("obcsb_acif_721r") '전문투자자정보조회
			
		elseif szTranID == "obpds_srvc_433a_1" and sPROS_ABLE_YN == "Y" then
			Dim sSendData
			sSendData = cmbAccount.caption.."☆2"	'cmbAccount.total&cmbAccount.sequence&"☆"&"0"
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")
			
		else
		
			'오류메시지 출력 팝업 띄움.
			contInfo.visible = true
			contInfo.lblErrorText.visible = true
			contInfo.btnError.visible = false
			
			contInfo.lblErrorText.caption = sDTL_CNTT
			contInfo.btnError.caption = ""
			
			Dim szAlertData
			g_ErrMsgText = sDTL_CNTT
			szAlertData = "1".."★"..g_ErrMsgText.."★".."errMsgBox".."★".."확인".."★".."확인"

			Form.OpenPopup("mbonl88026_p6", szAlertData, "")
			
		end if
		
	'전문투자자정보조회
	elseif szTranID == "obcsb_acif_721r" then
		Dim szPfinYn, szPfinCls, szSpclFncmType, szStartDate, szFinalDate, szCancelDate, szToday
		
		szPfinYn = "N"
		
		szPfinCls		= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PFIN_CLS_CODE" , 0)) '전문투자자구분코드
		szSpclFncmType	= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SPCL_FNCM_TYPE_CODE" , 0)) '전문금융소비자유형코드
		szStartDate		= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PFIN_VLDT_STA_DATE" , 0)) '효력시작일자
		szFinalDate		= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PFIN_VLDT_FIN_DATE" , 0)) '효력종료일자		
		szCancelDate		= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CANC_DATE" , 0)) '해지일자	
		 
		
		'설문지 고객유형 자동설정(2.개인전문투자자->4.당연->3.전환가능->1.일반 순으로 체크)
		Dim szCusType
		szCusType = "1"
		
		if szPfinCls == "1" and szPfinYn == "Y" then
			szCusType = "2"
		
		else
			if szPfinYn == "Y" then
				if szPfinCls == "1" then
					szCusType = "4"
				else
					szCusType = "3"
				end if
			else
				szCusType = "1"
			end if
		end if

		if g_PFIN_CLS_CODE == "1" then
		
			' 계약신청 가능한 상태(당연 전문투자자로 목표시장비교 Pass)일때 약관 보여주기
			f_SetAgree()
				
			' CDS 계약신청 중 신청계좌 변경 불가.
			cmbAccount.enable = false

		else	
		
			imgAgreeBg.visible = false	'약관 배경이미지
		
			' 신청계좌 변경 가능.
			cmbAccount.enable = true

			Form.SetSharedData("obcsb_acif_831r_HGDT_TYPE" , "05")	'고난도금융투자(장외파생상품)
			Form.SetSharedData("obcsb_acif_831r_ISCD" , "CDS")
			'Form.SetSharedData("obcsb_acif_831r_ISNM" , "CDS 계약 신청")
			Form.SetSharedData("obcsb_acif_831r_SALE_CLS_CODE" , "2")
			Form.SetSharedData("obcsb_acif_831r_INFO_CLS_CODE" , "1")
			Form.SetSharedData("obcsb_acif_831r_CUST_TYPE" , szCusType)
			
			Form.SetSharedData("FNDNAME_51010" , "CDS 계약 신청")	''mbfnp51010_12 에서 사용하는 shared..
			
			Form.SetSharedData("obcsb_acif_721r_CLS_CODE" , szPfinCls)
			Form.SetSharedData("obcsb_acif_721r_STA_DATE" , szStartDate)
			Form.SetSharedData("obcsb_acif_721r_FIN_DATE" , szFinalDate)
			
			Dim szAlertData
			g_ErrMsgText = "목표시장 비교 후\nCDS계약 신청이 가능합니다."
			szAlertData = "2".."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."목표시장 비교"
			
			Form.OpenPopup("mbonl88026_p6", szAlertData, "")
						
		end if

	elseif szTranID == "obcsb_acif_140r" then
		Dim iCnt, iCnt1
		If DATAMANAGER.IsMoreNextData(szTranID) = True Then
			DATAMANAGER.RequestNextData(szTranID)
		Else 
			'이메일 주소
			iCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2")
			For i = 0 to iCnt - 1
			    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_TYPE_CODE" , i)
			    strInagSrno2     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_SRNO"      , i)
			    strAddr          = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ADDR"           , i)
			    
			    If strInagTypeCode2 = "21" Then
					contNoti.tblUserInfo.SetCellString(1, 1, strAddr)
					contNoti.tblUserInfo.SetCellString(1, 2, strInagTypeCode2)
					contNoti.tblUserInfo.SetCellString(1, 3, strInagSrno2)
			    End If
			Next 	
			'휴대폰 번호
			iCnt1 = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock3")
			For i = 0 to iCnt1 - 1
			    strInagTypeCode3 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_TYPE_CODE" , i)
			    strInagSrno3     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_SRNO"      , i)
			    strCustTelno     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UI_CUST_TELNO"  , i)

			    If strInagTypeCode3 = "13" Then
				    contNoti.tblUserInfo.SetCellString(0, 1, strCustTelno)
				    contNoti.tblUserInfo.SetCellString(0, 2, strInagTypeCode3)
				    contNoti.tblUserInfo.SetCellString(0, 3, strInagSrno3)
			    End If
			Next
			
			f_SetToggleData(g_szNotiFlag)
		End If 
		
	elseif szTranID == "obsap_acif_999a" then	
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
			
		DATAMANAGER.RequestTranData( "obcsb_acad_122a" )	'계약서류
	
	elseif szTranID == "obcsb_acad_122a" then
		'' 여기선 뭐 할 게 없는데.. 정상이면 확인버튼 선택할꺼니깐..
		
	'CDS 계약 신청 처리
	elseif szTranID == "obpds_srvc_433a_2" then 
		g_szSvcSrno = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "SVC_SRNO", 0)  '서비스 일련번호
		
		DATAMANAGER.RequestTranData( "obcsb_dbif_322a" ) '계약서류교부처리
	
	elseif szTranID == "obcsb_dbif_322a" then
		dim sSendData	'계좌번호★신청일★신청상태
		sSendData = cmbAccount.total & cmbAccount.sequence & "★" & cldToday.caption & "★" & "승인대기"
		Form.OpenPopup("mbonl88026_p7" , sSendData , "")	
		
 	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , szErrMsg)
	end if
	
	if szTranID == "obcsb_acad_122a" or szTranID == "obcsb_dbif_322a" or szTranID == "obpds_srvc_433a_2" then
		btnReg.enable = false
	else
		btnReg.enable = true
	end if
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
Sub cmbAccount_ChangeAccount()
	f_InitUI()
	DATAMANAGER.RequestTranData("obcsb_acif_799r") '고객번호로 전문투자자여부 조회
End Sub
'============================================================================
Sub edtPassword_OnEditComplete()
	DATAMANAGER.RequestTranData( "obsap_acif_999a" )	'약정전 교부서류 일련번호 채번
End Sub

'============================================================================
Sub contNoti_lblTalk_OnClick()
	f_SetToggleUI(0)
	f_SetToggleData(g_szNotiFlag)
	f_SetBtnRegEnable()
End Sub
'============================================================================
Sub contNoti_lblEmail_OnClick()
	f_SetToggleUI(1)
	f_SetToggleData(g_szNotiFlag)
	f_SetBtnRegEnable()
End Sub
'============================================================================
Sub contNoti_btnChangeInfo_OnClick()
'	if edtPassword.caption <> "" and edtPassword.caption <> null then
		Dim sSendData, sTabIdx
		if g_szNotiFlag == "talk" then
			sTabIdx = "0"
		elseif g_szNotiFlag == "email" then
			sTabIdx = "1"
		end if
		sSendData = cmbAccount.total..";"..edtPassword.caption..";"..sTabIdx
		Form.OpenFramePopup("mbonl81000" , sSendData , "")
		'mbonl81000 폼화면 길이가 짧아 아래 신청버튼이 보여서 
		'해당 팝업 띄울 때는 버튼 숨기고 팝업 닫히면 다시 보이게 처리
		btnReg.visible = false 
'	else
'		Form.ShowAlert("알림", "계좌 비밀번호를 입력해 주세요.")
'	end if
End Sub

'============================================================================
Sub btnReg_OnClick()
	szParam = g_CUST_CLS_CODE & "★" & cmbAccount.total & "★" & cmbAccount.sequence
	Form.OpenPopup("mbonl88026_p4", szParam, "")
End Sub

'============================================================================
Sub contNoti_btnTooltip_OnClick()
	Form.OpenPopup("mbonl88026_p5", g_CUST_CLS_CODE, "")
End Sub

'============================================================================
Sub btnPwd_OnClick()
	Form.openPopupAnimation("pwdcheckpopup",cmbAccount.caption,"","2")
End Sub

'============================================================================
Sub contInfo_btnError_OnClick()
	'	목표시장 비교 팝업으로 이동	'mbonl88026_p8
	Form.OpenPopup("mbonl88026_p8", cmbAccount.total & "★" & cmbAccount.sequence, "","2") '목표시장 비교 설문 팝업
end sub

