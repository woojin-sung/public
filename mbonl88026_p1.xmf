End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPassword.pwdlen = tData(1)
				edtPassword.caption = tData(0)
				edtPassword_OnEditComplete()
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
			
			'인증서 팝업 호출..
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		end if
	'==============================================
	'*********** 공동인증서 성공여부 리턴 ************
	'==============================================
	elseif sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			DATAMANAGER.RequestTranData("obpds_srvc_433a_2") 'CDS 계약신청
			
		else						'실패
			exit sub
		end if
	'==============================================
	'*********** 각 확인사항 팝업 리턴 ************
	'==============================================
	ElseIf sKeyName == "mbonl88026_p2"  Then 
	    if trim(sRet) ~= "" and trim(sRet) ~= nil and sRet ~= "close" then
			Dim tReturnData
			Dim nCnt

			tReturnData = Split(sRet, "☆")			 
			nCnt = #tReturnData						
			for i = 0 to nCnt - 1
				Dim nIndex      
				nIndex = tonumber(tReturnData[i]) - 1
				g_tAgreeState[nIndex] = "1"
			next
			
			f_AllAgreeCheck()
	    end if
		
	'===============================================
	'********** 고객정보 변경 팝업 리턴  ***********
	'===============================================
	ElseIf sKeyName = "mbonl81000" Then
		btnReg.visible = true
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
		end if
		
	'===============================================
	'********** 공통 얼럿 팝업 리턴      ***********
	'===============================================
	ElseIf sKeyName == "errMsgBox"  Then 
		contInfo.visible = true
		contInfo.lblErrorText.visible = true
		contInfo.btnError.visible = true

		if sRet = "Left" then
		
			contInfo.lblErrorText.visible = true
			contInfo.lblErrorText.caption = g_errMsgText
			contInfo.btnError.caption = "목표시장비교"
			contInfo.btnError.visible = true
			
		elseif sRet = "Right" then
			
			contInfo.lblErrorText.caption = g_errMsgText
			contInfo.btnError.caption = "목표시장 비교"
						
			'	목표시장 비교 팝업으로 이동	'mbonl88026_p8
			Form.OpenPopup("mbonl88026_p8", cmbAccount.total & "★" & cmbAccount.sequence, "","2") '목표시장 비교 설문 팝업
			
		elseif sRet = "Mid" then
		
			contInfo.lblErrorText.visible = true
			contInfo.lblErrorText.caption = g_errMsgText
			contInfo.btnError.caption = ""
			contInfo.btnError.visible = false
			
		else	'close
		
			contInfo.lblErrorText.visible = true
			contInfo.lblErrorText.caption = g_errMsgText
			contInfo.btnError.caption = ""
			contInfo.btnError.visible = false
			
		end if	
		
	'===============================================
	'********** 목표시장 팝업 리턴      ***********
	'===============================================
	'CDS 계약 신청시 목표시장 비교 결과
	elseif sKeyName == "close_mbonl88026_p8" then
		if sRet == "ok" then	'계속 진행
			
			' 계약신청 가능한 상태
			f_SetAgree()
				
			' CDS 계약신청 중 신청계좌 변경 불가.
			cmbAccount.enable = false

		else	'중단하기
		
			imgAgreeBg.visible = false	'약관 배경이미지
						
			' 신청계좌 변경 가능.
			cmbAccount.enable = true

			'진입화면으로 이동
			Form.OpenScreen("88026" , "")
			Form.CloseForm()
			Exit Sub
			
		end if	
		
	'==============================================
	'*********** 계약신청전 확인해주세요 팝업 리턴 ************
	'==============================================
	elseif sKeyName == "mbonl88026_p4" then
		' success : 개인(신용정보조회 성공) , ok : 법인(신용정보조회 안함)
		if sRet == "success" or sRet == "ok" then	'계속 진행
			DATAMANAGER.RequestTranData("obpds_srvc_433a_1") '신청불가조건 두번째 체크			
		end if
		
	'===============================================
	'********** 신청 등록완료 팝업 리턴  ***********
	'===============================================
	ElseIf sKeyName == "mbonl88026_p7"  Then 
		if sRet == "close" then
			Form.CloseForm()
		end if
	End if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "obpds_srvc_433a_2" then
		if sRet == "close" then
			'진입화면으로 이동
			Form.OpenScreen("88026" , "")
			Form.CloseForm()
			Exit Sub
		end if
	end if
End Sub

'============================================================================
Sub contMain_chkAllAgree_OnChange(sCheckState)
	if sCheckState == "1" then
		contMain.chkAllAgree.chksilence = "0"
		
		Dim szAllData
		
		if g_CUST_CLS_CODE == "2" then
			nMaxCnt = 3
		else
			nMaxCnt = 5
		end if

		for i=0 to nMaxCnt
			Dim szData
			if g_tAgreeState[i] == "0" then
				'타이틀, url, 웹뷰type, 동의여부, 동의텍스트, 인덱스, 현재체크상태
				szData = g_tAgreeUrl[i][1].."★"..g_tAgreeUrl[i][0].."★"..g_tAgreeUrl[i][2].."★"..g_tAgreeUrl[i][3].."★"..g_tAgreeUrl[i][4].."★"..(i+1).."★".."0"
				if szAllData == "" or szAllData == null then
					szAllData = szData
				else
					szAllData = szAllData.."☆"..szData
				end if
			end if
		next
    
		if #szAllData > 0 then
			Form.OpenPopup( "mbonl88026_p2" ,  szAllData , "" )
		end if
	else
		g_tAgreeState = {"0", "0", "0", "0", "0", "0"}
		
		f_AllAgreeCheck()
		
	end if
End Sub

'============================================================================
Sub contMain_imgAllAgree_OnClick()
	if contMain.chkAllAgree.checkstate == "1" then
		contMain.chkAllAgree.checkstate = "0"
		contMain_chkAllAgree_OnChange("0")
	else
		contMain.chkAllAgree.checkstate = "1"
		contMain_chkAllAgree_OnChange("1")
	end if
End Sub

'============================================================================
Sub contMain_lblAllAgree_OnClick()
	if contMain.chkAllAgree.checkstate == "1" then
		contMain.chkAllAgree.checkstate = "0"
		contMain_chkAllAgree_OnChange("0")
	else
		contMain.chkAllAgree.checkstate = "1"
		contMain_chkAllAgree_OnChange("1")
	end if
End Sub

'============================================================================
Function f_AllAgreeCheck()
	Dim nAll
	nAll = 0
	for i = 0 to #g_tAgreeState - 1

		if i < 4  then
			Form.SetCtlProp("contMain.chkAgree"..i+1, "chksilence", g_tAgreeState[i])
		else
			Form.SetCtlProp("contSub.chkAgree"..i+1, "chksilence", g_tAgreeState[i])
		end if

		if g_tAgreeState[i] == "1" then
			if i < 4  then
				Form.SetCtlProp("contMain.imgUIChk"..i+1, "imgpath", g_szCheckImg)
				Form.SetCtlProp("contMain.lblChkText"..i+1, "fgcolor", g_szCheckFg)
			else
				Form.SetCtlProp("contSub.imgUIChk"..i+1, "imgpath", g_szCheckImg)
				Form.SetCtlProp("contSub.lblChkText"..i+1, "fgcolor", g_szCheckFg)
			end if
			nAll = nAll + 1
		else
			if i < 4  then
				Form.SetCtlProp("contMain.imgUIChk"..i+1, "imgpath", g_szUnCheckImg)
				Form.SetCtlProp("contMain.lblChkText"..i+1, "fgcolor", g_szUnCheckFg)
			else
				Form.SetCtlProp("contSub.imgUIChk"..i+1, "imgpath", g_szUnCheckImg)
				Form.SetCtlProp("contSub.lblChkText"..i+1, "fgcolor", g_szUnCheckFg)
			end if
		end if
	next

	if g_CUST_CLS_CODE == "2" then
		nMaxCnt = 3
	else
		nMaxCnt = 5
	end if

	if (nAll - 1) = nMaxCnt then
		contMain.imgAllAgree.imgpath = g_szCheckImg
		contMain.lblAllAgree.fgcolor = g_szCheckFg
	
		contMain.chkAllAgree.chksilence = "1"
		
		contNoti.visible = true
		if g_CUST_CLS_CODE == "2" then
			contNoti.top = 325
		else
			contNoti.top = 385
		end if
		
		btnReg.enable = "1"
		
	else
		contMain.imgAllAgree.imgpath = g_szUnCheckImg
		contMain.lblAllAgree.fgcolor = g_szUnCheckFg
	
		contMain.chkAllAgree.chksilence = "0"

		contNoti.visible = false
		
		btnReg.enable = "0"
		
	end if
End Function


