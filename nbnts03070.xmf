Dim g_szFncd
Dim g_szACNO
Dim g_szASNO
'============================================================================
Sub Form_OnFormInitBefore()
	edtFundCd.setFundCd()
	edtFundCd.setFundNmCtl("lblFundNm")
	g_szFncd = edtFundCd.caption
End Sub
'============================================================================
Sub Form_OnFormInit()
		
	'펀드코드 계좌조회
	if len(trim(g_szFncd)) > 0 Then
		DATAMANAGER.RequestTranData("obfnp_fnmt_011r")
	End if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obfnp_fnmt_011r" then		
		if Trim(g_szFncd) = "" or Len(g_szFncd) < 4 Then
			Form.ShowAlert("알림", "펀드코드를 입력하십시요.")
			Exit Sub
		end if
		DATAMANAGER.SetDataValue( false, "obfnp_fnmt_011r", "InBlock1", "FNCD"	, 0, g_szFncd )
	end if
	
	if szTranID == "obtrd_stlm_307r" then 
		DATAMANAGER.SetDataValue( false, "obtrd_stlm_307r", "InBlock1", "STA_DATE" , 0 , cldFrom.caption)
		DATAMANAGER.SetDataValue( false, "obtrd_stlm_307r", "InBlock1", "FIN_DATE" , 0 , cldTo.caption)
		DATAMANAGER.SetDataValue( false, "obtrd_stlm_307r", "InBlock1", "ACNO" , 0 , g_szACNO)
		DATAMANAGER.SetDataValue( false, "obtrd_stlm_307r", "InBlock1", "ASNO" , 0 , g_szASNO)
		DATAMANAGER.SetDataValue( false, "obtrd_stlm_307r", "InBlock1", "PWD"  , 0 , "")
		DATAMANAGER.SetDataValue( false, "obtrd_stlm_307r", "InBlock1", "FCM_CODE"  , 0 , "%")
		DATAMANAGER.SetDataValue( false, "obtrd_stlm_307r", "InBlock1", "MTIT_CODE" , 0 , "%")
		DATAMANAGER.SetDataValue( false, "obtrd_stlm_307r", "InBlock1", "OVDV_ACNT_CLCD", 0 , "3" ) '고유
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID = "obfnp_fnmt_011r" then	
		g_szACNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ACNO" , 0) '계좌번호
		g_szASNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ASNO" , 0) '계좌일련번호
		
		if len(trim(g_szACNO)) > 0 Then
			'해외파생 선물 최종결제 조회
			DATAMANAGER.RequestTranData("obtrd_stlm_307r")
		else
			Form.ShowAlert("알림", "펀드코드를 확인하세요.")
		End If
	end if
	
	if szTranID = "obtrd_stlm_307r" then
		Dim nCount, nIndex
		
		nCount = DATAMANAGER.GetDataCount( false, "obtrd_stlm_307r", "OutBlock1" )
		nIndex = tonumber(grdData.rowcount) - nCount
		
		if nCount > 0 then
			for i = 0 to nCount step 1
				Dim szCLRN_PRLS_FAMT, szCRCD
				
				szCLRN_PRLS_FAMT	= DATAMANAGER.GetDataValue( false, "obtrd_stlm_307r", "OutBlock1", "CLRN_PRLS_FAMT", i ) '청산손익
				szCRCD			= DATAMANAGER.GetDataValue( false, "obtrd_stlm_307r", "OutBlock1", "CRCD"		 , i ) '통화코드
				
				if szCRCD = "KRW" or szCRCD = "JPY" then
					grdData.SetCellData("ClrnUnpr", nIndex+i, FormatNumber(szCLRN_PRLS_FAMT, 0))
				else
					grdData.SetCellData("ClrnUnpr", nIndex+i, FormatNumber(szCLRN_PRLS_FAMT, 2))
				end if
				
				'매수매도 컬러
				if grdData.GetCellData("Deal", nIndex+i) = "매수" then
					grdData.SetCellFgColor("Deal", nIndex+i, "1")
				else
					grdData.SetCellFgColor("Deal", nIndex+i, "2")
				end if
			next
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Dim szSubMsg
'	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
'		
'	if Trim(szSubMsg) <> "" then
'		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
'	else
'		Form.ShowAlert("알림", szErrMsg)
'	end if
	if szTranID == "obfnp_fnmt_011r" then
		Form.SetTimerEvent(0, 0, 5)
	end if
End Sub


'============================================================================
Sub btnSearch_OnClick()
	DATAMANAGER.RequestTranData( "obfnp_fnmt_011r" )
End Sub
'============================================================================
' 연속조회
'============================================================================
Sub grdData_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("obtrd_stlm_307r") = true then
		DATAMANAGER.RequestNextData( "obtrd_stlm_307r" )
	end if
End Sub
'============================================================================
' 펀드코드 변경시 
'============================================================================
Sub edtFundCd_OnEditComplete()
	g_szFncd = edtFundCd.caption
	DATAMANAGER.RequestTranData( "obfnp_fnmt_011r" )
End Sub
'============================================================================
' 조회시작일자 변경시
'============================================================================
Sub cldFrom_OnEditComplete()
	DATAMANAGER.RequestTranData( "obfnp_fnmt_011r" )
End Sub
'============================================================================
' 조회종료 변경시
'============================================================================
Sub cldTo_OnEditComplete()
	DATAMANAGER.RequestTranData( "obfnp_fnmt_011r" )
End Sub
'============================================================================
' 돋보기
'============================================================================
Sub BtnFncd_OnClick()
	Form.OpenFramePopup("nhnts00001_p1" , "", "")
End Sub
'============================================================================
' 돋보기 리턴
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName = "FUNDINFO" then
		szFundData = Split(sRet, "★")
		
		if UBOUND(szFundData) > 0 then
			edtFundCd.caption = szFundData(0)
			edtFundCd_OnEditComplete()
		end if 
	end if
End Sub
'============================================================================
' 초기화
'============================================================================
Sub btnErase_OnClick()
	
	cldFrom.caption = Form.GetSharedData("&HOST_DATE", false )
	cldTo.caption = Form.GetSharedData("&HOST_DATE", false )
	
	DATAMANAGER.RequestTranData("obfnp_fnmt_011r")
End Sub
