	<SCRIPT_INFO _len="75291" _ulen="72955" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 탭_호가
' 02. 화면설명 : 주식현재가 호가탭화면
' 03. 작    성 : 2016.04.30 LJS
'
'
'20230420 KKM 현재가개선 : 시고저 대비율 테이블 삭제하고 시고저가와 바로 아래 표기로 tblPrice0, tblPrice4, tblPrice5 삭제
'20230420 KKM 현재가개선 : 좌하단 체결/차트 토글 이미지로 변경
'20230420 KKM 현재가개선 : 폰트와 색상 수정
'20230420 KKM 현재가개선 : 대비율 (-)(%) 표기
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket, g_szItemName, g_szInnerMarket
Dim g_szDiplayrest							'호가직전수량표시
Dim g_szLP									'20240503_01 HWG : MTS ETF 고도화 대응
Dim g_szAplyCode								'변동성 1:발동, 2:해제
	g_szAplyCode = "2"
	
Dim g_nPrice
	
Dim g_bBtnSellBuy
g_bBtnSellBuy = false

'Dim g_tblPriceStyle
'g_tblPriceStyle = "1"

Dim g_nSdpr	'20191107 HWG : 시고저등락률 계산오류 수정
g_nSdpr = 0	

'20211022 아이티젠(김성수) START
Dim g_bGrd_Chart_Toggle
g_bGrd_Chart_Toggle = "GRID"
'20211022 아이티젠(김성수) END

'20220214 HSZ : 시세속도 개선
Dim g_szGrd 
g_szGrd = "true"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
'============================================================================
Function RequestData()
	If Trim(g_szItemCode) = "" Then
		Form.ShowAlert("알림", "재조회하시기 바랍니다.")
		Exit Function
	End If

	DATAMANAGER.CancelRealData( "ohhts_elw_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_elw_aspr" )
	DATAMANAGER.CancelRealData( "ohhts_stck_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_stck_incg" ) '20220214 HSZ : 시세속도 개선
	DATAMANAGER.CancelRealData( "ohhts_stck_aspr" )
	DATAMANAGER.CancelRealData( "ohhts_stck_lppr" ) '20240503_01 HWG : MTS ETF 고도화 대응
	DATAMANAGER.CancelRealData( "ohhts_stck_mbcr" )
	DATAMANAGER.CancelRealData( "ohhts_frbr_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_frbr_aspr" )
	
	'20180511 LES START 정적VI추가
	DATAMANAGER.CancelRealData("ohhts_stck_viex")

	DATAMANAGER.RequestTranData( "ohhts_1001_001r" )
	DATAMANAGER.RequestTranData( "ohhts_1001_004r" )
	DATAMANAGER.RequestTranData( "ohhts_1001_005r" )
	
	'20180511 LES START 정적VI추가
	DATAMANAGER.RequestTranData("ohhts_viex_001r")

	'차트 조회-----------------------------------------------------------------------
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)

	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR" , 0,"D")  'D/W/M/Y 일/주/월/년 
	
	szToday = Form.GetSharedData("&HOST_DATE", 0 )
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DATE1" , 0, szToday)
	DATAMANAGER.RequestTranData("ohhts_5010_001r")	
	'-------------------------------------------------------------------------------------
end Function

'============================================================================
Function Set_HogaTable()
	Dim szDispdiff, szJangraph, szPriceoutline, szBoldHoga, szBoldJan, szBoldRest
	Dim szColWidth, szHAlign

	szDispdiff		= Form.LoadConfigData("mhprc11000", "Dispdiff"	)	'호가등락률
	szJangraph		= Form.LoadConfigData("mhprc11000", "Jangraph"	)	'호가잔량그래프
	g_szDiplayrest	= Form.LoadConfigData("mhprc11000", "Diplayrest"	)	'호가직전수량표시
	g_szLP			= Form.LoadConfigData("mhprc11000", "LP"	)			'LP잔량 '20240503_01 HWG : MTS ETF 고도화 대응
	szPriceoutline	= Form.LoadConfigData("mhprc11000", "Priceoutline")	'현재가 외곽선 표시
	szBoldHoga		= Form.LoadConfigData("mhprc11000", "BoldHoga"	)	'텍스트굵기 호가
	szBoldHoga02		= Form.LoadConfigData("mhprc11000", "BoldHoga02"	)	'텍스트굵기 호가v02 - 202306 HSZ 현재가 개선건 추가
	szBoldJan		= Form.LoadConfigData("mhprc11000", "BoldJan"		)	'텍스트굵기 호가잔량
	szBoldRest		= Form.LoadConfigData("mhprc11000", "BoldRest"	)	'텍스트굵기 직전대비
	
	'202306 HSZ START: 현재가 개선건 추가 - 호가굵기 설정으로 기본세팅
	if Trim(szBoldHoga02) = "" then
		Form.SaveConfigData("mhprc11000", "BoldHoga"		, "1"		)	'텍스트굵기 호가v01
		Form.SaveConfigData("mhprc11000", "BoldHoga02"	, "1"		)	'텍스트굵기 호가v02
		szBoldHoga = "1"
	end if
	'202306 HSZ END
	
	'설정된 값이 없을 경우 초기값 Insert 함.
	If szDispdiff = "" Then
		szDispdiff 		= "1"
		szJangraph 		= "1"
		'g_szDiplayrest 	= "0"
		g_szLP 			= "0" '20240503_01 HWG : MTS ETF 고도화 대응
		g_szDiplayrest 	= "1" '20230523 KKM 초기값 "1"로 변경
		szPriceoutline 	= "1"
		szBoldHoga 		= "1"
		szBoldJan 		= "0"
		szBoldRest		= "0"
		
		Form.SaveConfigData("mhprc11000", "Dispdiff"		, szDispdiff		)	'호가등락률
		Form.SaveConfigData("mhprc11000", "Jangraph"		, szJangraph		)	'호가잔량그래프
		Form.SaveConfigData("mhprc11000", "Diplayrest"	, g_szDiplayrest	)	'호가직전수량표시
		Form.SaveConfigData("mhprc11000", "LP"			, g_szLP	)			'LP잔량 '20240503_01 HWG : MTS ETF 고도화 대응
		Form.SaveConfigData("mhprc11000", "Priceoutline"	, szPriceoutline	)	'현재가 외곽선 표시
		Form.SaveConfigData("mhprc11000", "Style"		, "1"			)	'현재가 스타일
		Form.SaveConfigData("mhprc11000", "BoldHoga"		, szBoldHoga		)	'텍스트굵기 호가
		Form.SaveConfigData("mhprc11000", "BoldJan"		, szBoldJan		)	'텍스트굵기 호가잔량
		Form.SaveConfigData("mhprc11000", "BoldRest"		, szBoldRest		)	'텍스트굵기 직전대비
	End If
	
	
	'20240503_01 HWG START : MTS ETF 고도화 대응
	If szDispdiff = "1" Then
		'호가직전수량표시
		If g_szDiplayrest = "1" or g_szLP = "1" Then
			'szColWidth = "45,74,98,40,73,45"
			szColWidth = "44,72,93,48,72,44"
		Else
			'szColWidth = "0,119,98,40,118,0"
			szColWidth = "0,116,93,48,116,0"
		End If
		szHAlign = "2"
	ElseIf szDispdiff = "0" Then
		If g_szDiplayrest = "1" or g_szLP = "1"  Then
			'szColWidth = "45,74,138,0,73,45"
			szColWidth = "44,72,141,0,72,44"
		Else
			'szColWidth = "0,119,138,0,118,0"
			szColWidth = "0,116,141,0,116,0"
		End If		
		szHAlign = "1"
	End If	
	'20240503_01 HWG END
	
'	Form.ShowAlert(g_szDiplayrest, szColWidth)	
	
	'호가등락률
	contHoga.hogaTbl.SetColumnWidth( szColWidth )
	
	'호가잔량그래프
	contHoga.hogaTbl.hojangraph = szJangraph
	
	'20240503_01 HWG START : MTS ETF 고도화 대응
	if g_szLP = "1" then
		contHoga.hogaTbl.setUseLPChange(true)
	elseif g_szLP = "0" then
		contHoga.hogaTbl.setUseLPChange(false)
	else
		contHoga.hogaTbl.setUseLPChange(false)
	end if
	'20240503_01 HWG END
	
	'현재가 외곽선 표시
	contHoga.hogaTbl.priceoutline = szPriceoutline
	
	For i = 0 To 19
		'호가
		If szBoldHoga = "1" Then
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 2 , "01")
		Else 
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 2 , "00")
		End If
		
		'호가잔량
		If szBoldJan = "1" Then
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 1 , "01")
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 4 , "01")
		Else 
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 1 , "00")
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 4 , "00")
		End If
		
		'직전대비
		If szBoldRest = "1" Then
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 3 , "01")
		Else 
			contHoga.hogaTbl.setPropTable("fontstyle" , i , 3 , "00")
		End If
		
		'호가 가로 정렬
		contHoga.hogaTbl.SetCellHAlign(i, 2, szHAlign)
	Next

End Function

'============================================================================
Function SendOrder( szTab )
	Dim szData
	
	'20210823 HSZ START : CFD현재가 화면 추가 
	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	if szScreenNo = "13100" then	
		' 전달내용/탭위치/종목코드/가격
		szData = "현재가" & "★" & szTab & "★" & g_szItemCode & "★" & g_nPrice
		
		Form.OpenScreen( "13200" , szData )
		exit Function 
	end if
	'20210823 HSZ END

	' 전달내용/탭위치/종목코드/가격
	szData = "현재가" & "★" & szTab & "★" & g_szItemCode & "★" & g_nPrice
	
	Form.OpenScreen( "12000" , szData )

End Function

'============================================================================
Function SetBtnVisible( bValue )
	contHoga.btnSell.visible	= bValue
	contHoga.btnBuy.visible 	= bValue
	contHoga.lblLine.visible 	= bValue
	contHoga.btnAlpha.visible	= bValue

End Function

