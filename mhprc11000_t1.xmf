				contHoga.tblPrice3.SetCellFgColor(5, 1, 10) '10 : 빨간색
			else
				contHoga.tblPrice1.SetCellFgColor(5, 1, 3) ' 	0 : 검정색
				contHoga.tblPrice2.SetCellFgColor(5, 1, 3) ' 	0 : 검정색
				contHoga.tblPrice3.SetCellFgColor(5, 1, 3) ' 	0 : 검정색
			end if
			
			'시가
			if siga_debi < 0 then
'				siga_debi = siga_debi * -1
				contHoga.tblPrice1.SetCellFgColor(3, 1, 11)
			elseif siga_debi > 0 then
				contHoga.tblPrice1.SetCellFgColor(3, 1, 10)
				contHoga.tblPrice2.SetCellFgColor(3, 1, 10)
				contHoga.tblPrice3.SetCellFgColor(3, 1, 10)
			else
				contHoga.tblPrice1.SetCellFgColor(3, 1, 3) 
				contHoga.tblPrice2.SetCellFgColor(3, 1, 3) 
				contHoga.tblPrice3.SetCellFgColor(3, 1, 3) 
			end if
			
			'저가
			if juga_debi < 0 then
'				juga_debi = juga_debi * -1
				contHoga.tblPrice1.SetCellFgColor(7, 1, 11)
				contHoga.tblPrice2.SetCellFgColor(7, 1, 11)
				contHoga.tblPrice3.SetCellFgColor(7, 1, 11)
			elseif juga_debi > 0 then
				contHoga.tblPrice1.SetCellFgColor(7, 1, 10)
				contHoga.tblPrice2.SetCellFgColor(7, 1, 10)
				contHoga.tblPrice3.SetCellFgColor(7, 1, 10)
			else
				contHoga.tblPrice1.SetCellFgColor(7, 1, 3) 
				contHoga.tblPrice2.SetCellFgColor(7, 1, 3) 
				contHoga.tblPrice3.SetCellFgColor(7, 1, 3) 
			end if
			
			contHoga.tblPrice1.SetCellString(5, 1, FormatNumber(goga_debi,2))
			contHoga.tblPrice1.SetCellString(3, 1, FormatNumber(siga_debi,2))
			contHoga.tblPrice1.SetCellString(7, 1, FormatNumber(juga_debi,2))			

			contHoga.tblPrice2.SetCellString(5, 1, FormatNumber(goga_debi,2))
			contHoga.tblPrice2.SetCellString(3, 1, FormatNumber(siga_debi,2))
			contHoga.tblPrice2.SetCellString(7, 1, FormatNumber(juga_debi,2))			

			contHoga.tblPrice3.SetCellString(5, 1, FormatNumber(goga_debi,2))
			contHoga.tblPrice3.SetCellString(3, 1, FormatNumber(siga_debi,2))
			contHoga.tblPrice3.SetCellString(7, 1, FormatNumber(juga_debi,2))			
		end if
		'20191107 HWG END
		
		'==============================================================================
		'20170803 LES END
		'==============================================================================
		
		
	End If
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	If szTranID = "ohhts_1001_001r" Then
		Dim nSDPR , nOPRC, nHPRC, nLPRC
		
		nSDPR = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_SDPR" , 0 ) )	'기준가
		nOPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_OPRC" , 0 ) )	'시가
		nHPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_HPRC" , 0 ) )	'고가
		nLPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_LPRC" , 0 ) )	'저가
		
		If nSDPR < nHPRC Then
			contHoga.tblPrice1.SetCellFgColor( 1, 1, "10" )
			contHoga.tblPrice2.SetCellFgColor( 1, 1, "10" )
			contHoga.tblPrice3.SetCellFgColor( 1, 1, "10" )
			
		ElseIf nSDPR > nHPRC Then
			contHoga.tblPrice1.SetCellFgColor( 1, 1, "11" )
			contHoga.tblPrice2.SetCellFgColor( 1, 1, "11" )
			contHoga.tblPrice3.SetCellFgColor( 1, 1, "11" )
		Else
			contHoga.tblPrice1.SetCellFgColor( 1, 1, "12" )
			contHoga.tblPrice2.SetCellFgColor( 1, 1, "12" )
			contHoga.tblPrice3.SetCellFgColor( 1, 1, "12" )
		End If
		
		If nSDPR < nOPRC Then
			contHoga.tblPrice1.SetCellFgColor( 2, 1, "10" )
			contHoga.tblPrice2.SetCellFgColor( 2, 1, "10" )
			contHoga.tblPrice3.SetCellFgColor( 2, 1, "10" )
			
		ElseIf nSDPR > nOPRC Then
			contHoga.tblPrice1.SetCellFgColor( 2, 1, "11" )
			contHoga.tblPrice2.SetCellFgColor( 2, 1, "11" )
			contHoga.tblPrice3.SetCellFgColor( 2, 1, "11" )
		Else
			contHoga.tblPrice1.SetCellFgColor( 2, 1, "12" )
			contHoga.tblPrice2.SetCellFgColor( 2, 1, "12" )
			contHoga.tblPrice3.SetCellFgColor( 2, 1, "12" )
			
		End If
		
		If nSDPR < nLPRC Then
			contHoga.tblPrice1.SetCellFgColor( 3, 1, "10" )
			contHoga.tblPrice2.SetCellFgColor( 3, 1, "10" )
			contHoga.tblPrice3.SetCellFgColor( 3, 1, "10" )
			
		ElseIf nSDPR > nLPRC Then
			contHoga.tblPrice1.SetCellFgColor( 3, 1, "11" )
			contHoga.tblPrice2.SetCellFgColor( 3, 1, "11" )
			contHoga.tblPrice3.SetCellFgColor( 3, 1, "11" )
		Else
			contHoga.tblPrice1.SetCellFgColor( 3, 1, "12" )
			contHoga.tblPrice2.SetCellFgColor( 3, 1, "12" )
			contHoga.tblPrice3.SetCellFgColor( 3, 1, "12" )
		End If
		
	
	End If
End Sub

'test
'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	
	If szTranID = "ohhts_stck_aspr" then
		Dim nCLS_CODE
		
		nCLS_CODE = DATAMANAGER.GetDataValue( 1, "ohhts_stck_aspr", "OutBlock1", "FIDR_HOUR_CLS_CODE" , 0 ) '시간구분코드 0 = 장중 그외는 예상( B 장전, C 9시이후, A 장후, D 시간외 )
		
		If g_szAplyCode = "2" Then
			If nCLS_CODE = "0" Then
'20230417 KKM START : 우상단 종목정보 수정
'				if g_tblPriceStyle == "1" then
'				    contHoga.tblPrice1.visible = true
'				else
'					contHoga.tblPrice1.visible = false
'				end if
				
			    contHoga.tblPrice1.visible = true
			    'contHoga.imgToggle1.visible = true  '토글 보임
			    contHoga.tblPrice6.visible = true '20180511 LES
			    
			    contHoga.tblPrice2.visible = false
			    'contHoga.imgToggle2.visible = false
			    
			    contHoga.tblPrice3.visible = false
			    'contHoga.imgToggle3.visible = false
			    
		    else
			    contHoga.tblPrice1.visible = false
			    'contHoga.imgToggle1.visible = false '토글 숨김
			    contHoga.tblPrice6.visible = false '20180511 LES			    
			    
'			    if g_tblPriceStyle == "1" then
'				    contHoga.tblPrice2.visible = true
'				else
'					contHoga.tblPrice2.visible = false
'				end if

				contHoga.tblPrice2.visible = true
			    'contHoga.imgToggle2.visible = true
			    
			    contHoga.tblPrice3.visible = false
			    'contHoga.imgToggle3.visible = false
'20230417 KKM END			    
		    end if
		End If
	End If
	
	If szTranID = "ohhts_elw_cntg" then
		If g_szAplyCode = "2" Then	    
		    If Left( DATAMANAGER.GetDataValue( 1, "ohhts_stck_aspr", "OutBlock1", "FIDR_HOUR_CLS_CODE" , 0 ) , 1) = "0" Then
			    
'20230417 KKM START : 우상단 종목정보 수정
'			    if g_tblPriceStyle == "1" then
'				    contHoga.tblPrice1.visible = true
'				else
'					contHoga.tblPrice1.visible = false
'				end if
				
				contHoga.tblPrice1.visible = true
			    'contHoga.imgToggle1.visible = true	'토글보임
			    contHoga.tblPrice6.visible = true '20180511 LES			    
			    
			    contHoga.tblPrice2.visible = false
			    'contHoga.imgToggle2.visible = false
			    
			    contHoga.tblPrice3.visible = false
			    'contHoga.imgToggle3.visible = false			
	
		    else
			    contHoga.tblPrice1.visible = false	'토글숨김
			    'contHoga.imgToggle1.visible = false
			    contHoga.tblPrice6.visible = false '20180511 LES
			    
'			    if g_tblPriceStyle == "1" then
'				    contHoga.tblPrice2.visible = true
'				else
'					contHoga.tblPrice2.visible = false
'				end if
			    contHoga.tblPrice2.visible = true
			    'contHoga.imgToggle2.visible = true
			    
			    contHoga.tblPrice3.visible = false
			    'contHoga.imgToggle3.visible = false
	
'20230417 KKM END	
		    end if
		End If
	End If
	
    If szTranID ="ohhts_stck_stat" then
'	    Dim szAplyCode
	    g_szAplyCode = Trim( DATAMANAGER.GetDataValue( 1, "ohhts_stck_stat", "OutBlock1", "FIDR_APLY_CLS_CODE", 0 ) ) 	'1:발동 , 2:해제 
'20230417 KKM START : 우상단 종목정보 수정	   
	    If g_szAplyCode = "1" Then 
		    Dim szKindCode
		    
		    '20170804 LES START
'		    if g_tblPrcieStyle == "1" then
'			    contHoga.tblPrice3.visible = true
'			else
'			    contHoga.tblPrice3.visible = false
'			end if
			
			contHoga.tblPrice3.visible = true
			'contHoga.imgToggle3.visible = true
			    
			contHoga.tblPrice1.visible = false
			'contHoga.imgToggle1.visible = false
			contHoga.tblPrice6.visible = false '20180511 LES
		    
			contHoga.tblPrice2.visible = false
'			contHoga.imgToggle2.visible = false
		    '20170804 LES END
		    
		    szKindCode = DATAMANAGER.GetDataValue( 1, "ohhts_stck_stat", "OutBlock1", "FIDR_KIND_CODE"  , 0 ) '1:정적VI 2:동적VI 3:정적+동적VI
		    
		    if szKindCode = "1" Then 
			    contHoga.tblPrice3.SetCellString( 14, 1, "정적" )
			    
		    elseif szKindCode = "2" Then 
			    contHoga.tblPrice3.SetCellString( 14, 1, "동적" )
			    
		    elseif szKindCode = "3" Then
			    contHoga.tblPrice3.SetCellString( 14, 1, "정+동적" )		    
		    End if 
		    
	    Else
		    '20170804 LES START
		    contHoga.tblPrice1.visible = false
		    'contHoga.imgToggle1.visible = false	'토글숨김
		    contHoga.tblPrice6.visible = false '20180511 LES
		    	
'			if g_tblPriceStyle == "1" then
'				contHoga.tblPrice2.visible = true
'			else
'				contHoga.tblPrice2.visible = false
'			end if
		    contHoga.tblPrice2.visible = true
		   ' contHoga.imgToggle2.visible = true
		    
		    contHoga.tblPrice3.visible = false
'		    contHoga.imgToggle3.visible = false
		    '20170804 LES END
'20230417 KKM END			    
	    End if
    
    End if
	
End Sub

