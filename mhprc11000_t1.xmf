'============================================================================
Sub tblTime_OnClick(lRow , lColumn)
	If lColumn = 1 And lRow  = 0 then
		tblTime.visible = false
		tblMaeDoSu.visible = true
	End If
End Sub


'============================================================================
Sub tblMaeDoSu_OnClick(lRow , lColumn)
	If lColumn = 2 And lRow  = 0 then
		tblTime.visible = true
		tblMaeDoSu.visible = false
	End If
	
End Sub

'============================================================================
Sub contHoga_btnHoga_OnClick()
	'20170814 LES START
	'Form.SaveConfigData("mhprc11000", "tblPriceStyle" , g_tblPriceStyle)
	'20170814 LES END
	Form.OpenFramePopup("mhprc11000_p2" , g_szItemCode & "|" & g_szItemMarket & "|" &  g_szItemName , sPosInfo)		
	
End Sub

