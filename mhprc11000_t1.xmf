'============================================================================
Sub contHoga_imgToggle4_OnClick()
	if g_bGrd_Chart_Toggle == "GRID" then
		g_bGrd_Chart_Toggle = "CHART"
		'contHoga.imgToggle4.imgpath = "grdchart_rgt.png"
		contHoga.imgToggle4.imgpath = "icon_2navi2.png"
				'20220216 HSZ START 시세속도개선
		g_szGrd = "false"
		DATAMANAGER.CancelRealData( "ohhts_stck_cntg" ) 
		'20220216 HSZ END
	else
		g_bGrd_Chart_Toggle = "GRID"
		'contHoga.imgToggle4.imgpath = "grdchart_lft.png"
		contHoga.imgToggle4.imgpath = "icon_2navi1.png"
				'20220216 HSZ START 시세속도개선
		g_szGrd = "true"
		DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		'20220216 HSZ END
	end if
	
	f_SetGridChartToggle()
End Sub

'============================================================================
Function f_SetGridChartToggle()
	If g_bGrd_Chart_Toggle = "CHART" Then
		'20220216 HSZ START 시세속도개선
		g_szGrd = "false"
		DATAMANAGER.CancelRealData( "ohhts_stck_cntg" ) 
		'20220216 HSZ END
		contHoga.grdCNTG.visible = false
		contHoga.imggrdCnTGHeader.visible = false
		contHoga.Label0.visible = false
		contHoga.lblPower.visible = false
'		contHoga.imgLDown0.visible = false
		contHoga.ChartEx0.visible = true
		contHoga.imgchart.visible = true		
		
		'contHoga.lblToggle0.fgcolor = "18"
		'contHoga.lblToggle1.fgcolor = "62"
		
	ElseIf g_bGrd_Chart_Toggle = "GRID" Then
		'20220216 HSZ START 시세속도개선
		g_szGrd = "true"
		DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		'20220216 HSZ END
		contHoga.grdCNTG.visible = true
		contHoga.imggrdCnTGHeader.visible = true		
		contHoga.Label0.visible = true
		contHoga.lblPower.visible = true
'		contHoga.imgLDown0.visible = true
		contHoga.ChartEx0.visible = false
		contHoga.imgchart.visible = false
		
		'contHoga.lblToggle0.fgcolor = "62"
		'contHoga.lblToggle1.fgcolor = "18"
		
	End If	

End Function

'============================================================================
Sub contHoga_grdCNTG_OnClickUp(lRow, szCellID)
	'Form.OpenFramePopup("mhprc11000_p3" , g_szItemCode & "|" & g_szItemMarket & "|" & g_szItemName , sPosInfo)
'20230503 KKM START : 체결/차트 토글
	g_bGrd_Chart_Toggle = "GRID"
	contHoga_imgToggle4_OnClick()
'20230503 KKM END	
End Sub

