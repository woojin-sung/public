'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		g_szItemName   = Form.GetItemCodeInfo( g_szItemCode , "name")
		
'		If g_szItemMarket = "Q" Or g_szItemMarket = "W" Then
'			contHoga.btnReport.enable = false
'		Else
'			contHoga.btnReport.enable = true
'		End If
		
		'20180712 HAMWG START : K-OTC MTS 도입
		If g_szItemMarket = "T" Then
			'20230417 KKM START : 우상단 종목정보 수정
'		    if g_tblPriceStyle == "1" then
'			    contHoga.tblPrice1.visible = true
'			    contHoga.imgToggle1.visible = true	'토글숨김
'			    contHoga.tblPrice6.visible = true '20180511 LES START
'		    else
'			    contHoga.imgToggle1.visible = true
'			    contHoga.tblPrice6.visible = true '20180511 LES START
'		    end if

		    contHoga.tblPrice1.visible = true
		    contHoga.tblPrice6.visible = true 
			'20230417 KKM END
			
			contHoga.tblPrice2.visible = false
		End if
		'20180712 HAMWG END
		
		Set_HogaTable()	'20240503_01 HWG : MTS ETF 고도화 대응
		
		g_bBtnSellBuy = false
		SetBtnVisible( g_bBtnSellBuy )	
		
		RequestData()
		
	end	if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
	
		If sParam = null Or Trim(sParam) = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
'			Form.triggerEvent( "#", "REQUEST_ITEMCODE", "")
			Exit Sub
		End If
		
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		g_szItemName   = Form.GetItemCodeInfo( g_szItemCode , "name")

'		If g_szItemMarket = "Q" Or g_szItemMarket = "W" Then
'			contHoga.btnReport.enable = false
'		Else
'			contHoga.btnReport.enable = true
'		End If
		
		'20180712 HAMWG START : K-OTC MTS 도입
		If g_szItemMarket = "T" Then
			'20230417 KKM START : 우상단 종목정보 수정		
'		    if g_tblPriceStyle == "1" then
'			    contHoga.tblPrice1.visible = true
'			    contHoga.imgToggle1.visible = true	'토글숨김
'			    contHoga.tblPrice6.visible = true '20180511 LES START
'		    else
'			    contHoga.imgToggle1.visible = true
'			    contHoga.tblPrice6.visible = true '20180511 LES START
'		    end if
			    
		    contHoga.tblPrice1.visible = true
		    contHoga.tblPrice6.visible = true 
			'20230417 KKM END
			
			contHoga.tblPrice2.visible = false
		End if
		'20180712 HAMWG END
		
		Set_HogaTable()	'20240503_01 HWG : MTS ETF 고도화 대응
		
		g_bBtnSellBuy = false
		SetBtnVisible( g_bBtnSellBuy )	
		
		RequestData()
		
	ElseIf sEventName = "HOGA_SETUP" Then
		Set_HogaTable()

	end if
	 
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
    If szTranID = "ohhts_1001_001r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)


	'20180511 LES START 정적VI추가
	elseif szTranID = "ohhts_viex_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_viex_001r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_szItemCode)
		DATAMANAGER.SetDataValue(0, "ohhts_viex_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket)
	    
    ElseIf szTranID = "ohhts_1001_002r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_002r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)

	Elseif szTranID = "ohhts_1001_004r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_004r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
	    
	Elseif szTranID = "ohhts_1001_005r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_005r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)

	Elseif szTranID = "ohhts_3800_004r" then
	    DATAMANAGER.SetDataValue( 0, "ohhts_3800_004r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)

	Elseif szTranID = "ohhts_1126_001r" then
		Dim szOrdCode
	
	    DATAMANAGER.CancelRealData("ohhts_stck_stat")
	    
	    If Left(g_szItemCode, 1) = "J" or Left(g_szItemCode, 1) = "F" Then
		    szOrdCode = g_szItemCode		    
	    ElseIf g_szItemMarket = "J" or g_szItemMarket= "T" Then	'주식	    
		    szOrdCode = "A" + g_szItemCode		    
		ElseIf g_szItemMarket = "W" Then	'ELW
		    szOrdCode = "J" + g_szItemCode		    
		Else
		    szOrdCode = g_szItemCode		    
		End If
	    
	    DATAMANAGER.SetDataValue( 0, "ohhts_1126_001r", "InBlock1", "FID_SHRN_ISCD", 0 , szOrdCode )
	    
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	Dim szCode
	
	szCode = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_SHRN_ISCD" , 0 )
	
	If szTranID = "ohhts_stck_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_aspr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_stck_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , szCode )
	
	'20240503_01 HWG START : MTS ETF 고도화 대응
	ElseIf szTranID = "ohhts_stck_lppr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_lppr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	'20240503_01 HWG END
	
	ElseIf szTranID = "ohhts_stck_incg" Then '20220214 HSZ : 시세속도 개선
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_stck_mbcr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_mbcr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	ElseIf szTranID = "ohhts_stck_stat" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_stat", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
	ElseIf szTranID = "ohhts_elw_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_elw_aspr" , "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_elw_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg" , "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_frbr_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_frbr_aspr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_frbr_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , szCode )
	ElseIf szTranID = "ohhts_smns_rate" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_smns_rate", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
		
	'20180511 LES START 정적VI 추가
	Elseif szTranID = "ohhts_stck_viex" then
		DATAMANAGER.SetDataValue(1, "ohhts_stck_viex", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode)
	
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	
	If szTranID = "ohhts_1001_001r" Then
		'호가컨트롤 속성		
		contHoga.hogaTbl.startprice = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_OPRC" , 0 )
		contHoga.hogaTbl.highprice	 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_HPRC" , 0 )
		contHoga.hogaTbl.lowprice	 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_LPRC" , 0 )
		
'		g_szItemName = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_KOR_ISNM" , 0)

		'=================================================================================
		'20170803 LES START - 시고저 등락률 추가 + 상/하한 등락률 추가
		'=================================================================================
		sdpr = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_SDPR" , 0)
		siga = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_OPRC" , 0)
		goga = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_HPRC" , 0)
		juga = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_LPRC" , 0)
		hprc = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_MXPR" , 0)
		lprc = DATAMANAGER.GetDataValue(0, "ohhts_1001_001r", "OutBlock1", "FID_LLAM" , 0)
		
		g_nSdpr = sdpr	'20191107 HWG : 시고저등락률 계산오류 수정
		
		'20191107 HWG START : 시고저등락률 계산오류 수정
		if CInt(sdpr) > 0 then

			goga_debi = (goga / sdpr * 100 ) - 100
			siga_debi = (siga / sdpr * 100 ) - 100
			juga_debi = (juga / sdpr * 100 ) - 100
			hprc_debi = ((hprc - sdpr) / sdpr) * 100
			lprc_debi = ((lprc - sdpr) / sdpr) * 100
			
			'고가
			if goga_debi < 0 then
'				goga_debi = goga_debi * -1
				contHoga.tblPrice1.SetCellFgColor(5, 1, 11) '11 : 파란색
				contHoga.tblPrice2.SetCellFgColor(5, 1, 11)
				contHoga.tblPrice3.SetCellFgColor(5, 1, 11)
			elseif goga_debi > 0 then
				contHoga.tblPrice1.SetCellFgColor(5, 1, 10) '10 : 빨간색
				contHoga.tblPrice2.SetCellFgColor(5, 1, 10) '10 : 빨간색
				contHoga.tblPrice3.SetCellFgColor(5, 1, 10) '10 : 빨간색
			else
				contHoga.tblPrice1.SetCellFgColor(5, 1, 3) ' 	0 : 검정색
				contHoga.tblPrice2.SetCellFgColor(5, 1, 3) ' 	0 : 검정색
				contHoga.tblPrice3.SetCellFgColor(5, 1, 3) ' 	0 : 검정색
			end if
			
			'시가
			if siga_debi < 0 then
'				siga_debi = siga_debi * -1
				contHoga.tblPrice1.SetCellFgColor(3, 1, 11)
				contHoga.tblPrice2.SetCellFgColor(3, 1, 11)
				contHoga.tblPrice3.SetCellFgColor(3, 1, 11)
			elseif siga_debi > 0 then
				contHoga.tblPrice1.SetCellFgColor(3, 1, 10)
				contHoga.tblPrice2.SetCellFgColor(3, 1, 10)
				contHoga.tblPrice3.SetCellFgColor(3, 1, 10)
			else
				contHoga.tblPrice1.SetCellFgColor(3, 1, 3) 
				contHoga.tblPrice2.SetCellFgColor(3, 1, 3) 
				contHoga.tblPrice3.SetCellFgColor(3, 1, 3) 
			end if
			
			'저가
			if juga_debi < 0 then
'				juga_debi = juga_debi * -1
				contHoga.tblPrice1.SetCellFgColor(7, 1, 11)
				contHoga.tblPrice2.SetCellFgColor(7, 1, 11)
				contHoga.tblPrice3.SetCellFgColor(7, 1, 11)
			elseif juga_debi > 0 then
				contHoga.tblPrice1.SetCellFgColor(7, 1, 10)
				contHoga.tblPrice2.SetCellFgColor(7, 1, 10)
				contHoga.tblPrice3.SetCellFgColor(7, 1, 10)
			else
				contHoga.tblPrice1.SetCellFgColor(7, 1, 3) 
				contHoga.tblPrice2.SetCellFgColor(7, 1, 3) 
				contHoga.tblPrice3.SetCellFgColor(7, 1, 3) 
			end if
			
			contHoga.tblPrice1.SetCellString(5, 1, FormatNumber(goga_debi,2))
			contHoga.tblPrice1.SetCellString(3, 1, FormatNumber(siga_debi,2))
			contHoga.tblPrice1.SetCellString(7, 1, FormatNumber(juga_debi,2))
			
			contHoga.tblPrice2.SetCellString(5, 1, FormatNumber(goga_debi,2))
			contHoga.tblPrice2.SetCellString(3, 1, FormatNumber(siga_debi,2))
			contHoga.tblPrice2.SetCellString(7, 1, FormatNumber(juga_debi,2))
			
			contHoga.tblPrice3.SetCellString(5, 1, FormatNumber(goga_debi,2))
			contHoga.tblPrice3.SetCellString(3, 1, FormatNumber(siga_debi,2))
			contHoga.tblPrice3.SetCellString(7, 1, FormatNumber(juga_debi,2))			
		end if
		'==============================================================================
		'20170803 LES END
		'==============================================================================

	
	ElseIf szTranID = "ohhts_1001_004r" Then
'		
'		For i = 0 To contHoga.grdCNTG.rowcount - 1
'			Dim nData
'			nData = CDbl( contHoga.grdCNTG.GetCellData( "bd_cell2", i ) )
'			
'			If nData > 0 Then
'				contHoga.grdCNTG.SetCellFgColor( "bd_cell0", i, "10")
'			ElseIf nData < 0 Then
'				contHoga.grdCNTG.SetCellFgColor( "bd_cell0", i, "11")
'			Else
'				contHoga.grdCNTG.SetCellFgColor( "bd_cell0", i, "12")
'			End If
'		
'		Next
	
	ElseIf szTranID = "ohhts_1001_005r" Then
		Dim nTOTAL_BIDP_RSQN		' 총매수잔량
		Dim nTOTAL_ASKP_RSQN		' 총매도잔량
		
		nTOTAL_BIDP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_TOTAL_BIDP_RSQN" , 0 )
		nTOTAL_ASKP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_TOTAL_ASKP_RSQN" , 0 )
		
		tblMaeDoSu.SetCellString( 0,  2, nTOTAL_BIDP_RSQN - nTOTAL_ASKP_RSQN )

		'예상체결 Visible 여부
	    if Left( DATAMANAGER.GetDataValue( false, "ohhts_1001_005r", "OutBlock1", "FID_NW_MKOP_CLS_CODE", 0 ),1) = "0" OR 
	             DATAMANAGER.GetDataValue( false, "ohhts_1001_005r", "OutBlock1", "FID_NW_MKOP_CLS_CODE", 0 )    = "49" then
			
			'20180712 HAMWG START : K-OTC MTS 도입
		    If g_szItemMarket <> "T" Then
			'20230417 KKM START : 우상단 종목정보 수정		
'			    '20170804 LES START
'			    if g_tblPriceStyle == "1" then
'				    contHoga.tblPrice1.visible = false
'				    contHoga.imgToggle1.visible = false	'토글숨김
'				    contHoga.tblPrice6.visible = false '20180511 LES START
'			    else
'				    contHoga.imgToggle1.visible = false
'				    contHoga.tblPrice6.visible = false '20180511 LES START
'			    end if

'			    if g_tblPriceStyle == "1" then
'				    contHoga.tblPrice2.visible = true
'				    contHoga.imgToggle2.visible = true
'			    else
'				    contHoga.imgToggle2.visible = true
'			    end if
'			    '20170804 LES END

			    contHoga.tblPrice1.visible = false
			    contHoga.tblPrice6.visible = false 
			    
			    contHoga.tblPrice2.visible = true '예상체결
				'20230417 KKM END
			End If
			'20180712 HAMWG END
			
	    end if
	    
	    '20240503_01 HWG START : MTS ETF 고도화 대응
	    if g_szLP = "1" then
		    
		    nTOTAL_BIDP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_TOTAL_BIDP_RSQN" , 0 )
		    nTOTAL_ASKP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_TOTAL_ASKP_RSQN" , 0 )
		  
			tblMaeDoSu.SetCellString( 0, 0, nTOTAL_ASKP_RSQN )
			tblMaeDoSu.SetCellString( 0, 5, nTOTAL_BIDP_RSQN )
			tblMaeDoSu.setCellUsePlusMinusColor(0,0, false)
			tblMaeDoSu.setCellUsePlusMinusColor(0,5, false)
			tblMaeDoSu.SetCellFgColor(0, 0, "10")
			tblMaeDoSu.SetCellFgColor(0, 5, "11")
			
		    szDataA1 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_ASKP_RSQN1" , 0 )
		    szDataA2 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_ASKP_RSQN2" , 0 )
		    szDataA3 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_ASKP_RSQN3" , 0 )
		    szDataA4 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_005r", "OutBlock1", "FID_LP_ASKP_RSQN4" , 0 )
