Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	'20240503_01 HWG START : MTS ETF 고도화 대응
	if szTranID = "ohhts_stck_lppr" then
		if g_szLP = "1" then
			szDataA1 = DATAMANAGER.GetDataValue( 1,  "ohhts_stck_lppr", "OutBlock1", "FIDR_LP_ASKP_RSQN1"	, 0 )
			szDataA2 = DATAMANAGER.GetDataValue( 1,  "ohhts_stck_lppr", "OutBlock1", "FIDR_LP_ASKP_RSQN2"	, 0 )
