<ROOT>
	<MAP_INFO scrno="16031" scrname="지수/업종" version="2" writer="이재원" />
	<FORM_INFO name="Form" ly_vert="0,0,375,562,1" />
	<CONTROL_INFO>
		<FORMTAB name="FormTab0" tabcount="3" tabwidthtype="1" tabheadheight="40" autosave="1" ly_vert="0,0,375,562,1" >
			<PAGE name="page0" caption="주요종목" linkfile="mhtro16031_t1" />
			<PAGE name="page1" caption="업종별종목" linkfile="mhtro16031_t3" />
			<PAGE name="page2" caption="업종순위" linkfile="mhtro16031_t4" />
		</FORMTAB>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="2151" _ulen="2011" >
'--===========================================================================
'-- 화  면  명 : 종목검색창_메인
'-- 화  면  ID : 
'-- 개      요 : 
'-- 작      성 : 
'-- 수      정 : 
'--===========================================================================
'--============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form.triggerEvent("FormTab0." .. FormTab0.currenttabpageid, "SCREEN_REFRESH", "")
	end if
end Sub

'============================================================================
Sub Form_OnFormInit()
	
	
	'20240528 LES START 홈화면 연동
	szLinkData = Form.GetOpenLinkData()
	
	if szLinkData == "HOME" then
		
		sTabIndex = Form.GetSharedData("HOME_UPDOWN_OVRS", true)
		
		if sTabIndex <> "" then
			FormTab0.currenttab = sTabIndex
		end if
		
	else
		f_EventPopup()
	end if
	'20240528 LES END
	
	
End Sub

'============================================================================
' 해외주식 공지팝업
'============================================================================
function f_EventPopup()
    Dim szEndDate
    Dim szToday
    Dim szDate
    Dim nDiffDay
    
   '20200526 SWJ START : MTS 해외주식 실시간 서비스 비용 변동 안내 팝업
    szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
    if szMediaCode = "156" or szMediaCode = "157" then
	    szEndDate = "20200612"                            	' 팝업노출일
	    szToday = Form.GetSharedData("&HOST_DATE", false )    ' 현재일
	    szDate = Form.GetEnvData("EVENT_DATE_YH")            ' 일주일간 열지 않기 체크한 날짜
    
	    if tonumber(Form.DiffDate(szToday, szEndDate)) >= 0 then
			if szDate == null or szDate == "" then
			    Form.OpenPopup("popup_noti", "" , "")
			else
			    nDiffDay =  tonumber(Form.DiffDate(szDate, szToday))
			    if nDiffDay > 7 then
					Form.SetEnvData(0, "EVENT_DATE_YH", "")
					Form.OpenPopup("popup_noti", "" , "")
			    end if
			end if
	    end if
	end if
	'20200526 SWJ END

end function

	</SCRIPT_INFO>
</ROOT>