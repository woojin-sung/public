'============================================================================
' 01. 화 면 명 : HOME_주목받는 섹터
' 02. 화면설명 : 주목받는 섹터(상세) ->섹터 내 종목리스트 조회
' 03. 작    성 : 
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szTmstCode		'종목코드
Dim g_nCount			'항목개수
g_nCount = 0 			'20210916 SWJ START

Dim g_szCnttText		'부가설명
g_szCnttText = ""
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Set_Real_Input : real_input 정의 (0현재, 1예상, 2단일)
'============================================================================
Function Set_Real_Input(szMk, nIdx, szCd)
	DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
End Function

'============================================================================
' Real_RequestData : Real 요청 (0현재, 1예상, 2단일)
'============================================================================
Function Real_RequestData(szMk)
	DATAMANAGER.RequestRealData("ohhts_stck_incg")		' 주식체결 자동갱신
End Function

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()

End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.SetChartType("line")
	ChartEx1.SetChartType("line")
	ChartEx2.SetChartType("line")
	
	
	ChartEx0.SetPeriodType("1")
	ChartEx0.SetPeriodTime("5")
	
	ChartEx1.SetPeriodType("1")
	ChartEx1.SetPeriodTime("5")
	
	ChartEx2.SetPeriodType("1")
	ChartEx2.SetPeriodTime("5")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "INIT" then
		if Trim(sParam) = "" or Instr(sParam, "★") < 1 then
			exit Sub
		end if
		lblText.maxlinecnt = "2^-2"
		szData = Split(sParam, "★")
		g_szTmstCode	= szData(0)
		szVrss	 	= szData(1)
'		msgbox sParam

		lblData.caption = szVrss
		nVrss = FormatNumber(szVrss,2) * 100
		if CDbl(nVrss) > 0 then
			lblData.fgcolor = "10"
		elseif CDbl(nVrss) < 0 then
			lblData.fgcolor = "11"
		else
			lblData.fgcolor = "12"
		end if
		
		DATAMANAGER.SetDataValue( 0, "ohhts_1033_001r", "InBlock1", "FID_INPUT_ISCD", 0, g_szTmstCode )
		DATAMANAGER.RequestTranData("ohhts_1033_001r")	'테마 종목리스트 조회
		
		DATAMANAGER.SetDataValue(1, "ohhts_tmst_rsfl", "InBlock1", "FIDR_TMST_CODE", 0, g_szTmstCode)
		DATAMANAGER.RequestRealData("ohhts_tmst_rsfl")	' 테마 등락률 실시간
		
	elseif sEventName = "CLEAR" then
		Pannel0.rowcount = 0
		DATAMANAGER.CancelRealData("ohhts_stck_incg")
		DATAMANAGER.CancelRealData("ohhts_tmst_rsfl")
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	
	if szTranID == "ohhts_1033_001r" then
		nCnt = CInt(DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1"))
		if nCnt < 1 then
			exit sub
		end if
		Pannel0.rowcount = 3
		
		'부가설명 변수 저장
		g_szCnttText = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_ANXT_EXPL_CNTT" , 0)
		nCntLine = Form.getTextLineCount(g_szCnttText, -2, false, 330)
		if Cint(nCntLine) > 2 then		' 두줄 이상이면, 밑줄처리
			lblText.fontstyle = "10"
		end if
		
		for i = 0 to 2
			'순위 세팅
			Pannel0.setPropCardCell("caption","lblRank",i, i+1)	
			Pannel0.setPropCardCell("maxlinecnt","lblName",i,"2^-2")
			
			'등락률 이미지 세팅(나머지 탭)
				szCtrtData = Pannel0.GetCellValue("lblCtrt",i)
				szCtrtData = CDbl(szCtrtData * 100)
				if CDbl(szCtrtData) > 0 then
					Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1")	'동일 이미지 중복세팅 방지
					Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_red.9.png")
				elseif CDbl(szCtrtData) < 0 then
					Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1")	'동일 이미지 중복세팅 방지
					Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_blue.9.png")
				else
					Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1")	'동일 이미지 중복세팅 방지
					Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_gray.9.png")
				end if

			
			' 실시간 인블럭 세팅
			Dim szCd, szMk
			szCd =  Pannel0.GetCellValue("lblCode",i)
			
			if szCd <> "" then
				szMk = Form.GetItemCodeInfo(szCd, "market")
				if szMk <> "" then
					Set_Real_Input(szMk, i, szCd)
				end if
			end if
		next
		
		DATAMANAGER.RequestTranData("ohhts_5010_012r")
		
	elseif szTranID == "ohhts_5010_012r" then
		'실시간 호출
		Real_RequestData(szMk)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_1033_001r" then
		Pannel0.rowcount = 0
		DATAMANAGER.CancelRealData("ohhts_stck_incg")
	
	elseif szTranID == "ohhts_5010_012r" then
		DATAMANAGER.ClearInputData( false, "ohhts_5010_012r" )	
		szToday = Form.GetSharedData("&HOST_DATE", 0 )
	
		szCode0 = Pannel0.GetCellValue("lblCode",0)
		szMk0 = Form.GetItemCodeInfo( szCode0 , "market")
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , szMk0	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , szCode0	)

		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , szMk0	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock2", "FID_INPUT_ISCD" 				, 0 , szCode0	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" 	, 0 , "0"			)	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock2", "FID_INPUT_DATE1" 			, 0 , szToday			)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" 		, 0 , "300"			)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" 	, 0 , "N"			)	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock2", "FID_INPUT_VRTL_TICK_INCU_YN" 	, 0 , "N"			)
		
		szCode1 = Pannel0.GetCellValue("lblCode",1)
		szMk1 = Form.GetItemCodeInfo( szCode1 , "market")
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock3", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , szMk1	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock3", "FID_INPUT_ISCD" 				, 0 , szCode1	)

		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock4", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , szMk1	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock4", "FID_INPUT_ISCD" 				, 0 , szCode1	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock4", "FID_INPUT_MOD_STPR_CLS_CODE" 	, 0 , "0"			)	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock4", "FID_INPUT_DATE1" 			, 0 , szToday			)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock4", "FID_INPUT_HOUR_CLS_CODE" 		, 0 , "300"			)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock4", "FID_INPUT_PAST_DATA_INCU_YN" 	, 0 , "N"			)	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock4", "FID_INPUT_VRTL_TICK_INCU_YN" 	, 0 , "N"			)
		
		szCode2 = Pannel0.GetCellValue("lblCode",2)
		szMk2 = Form.GetItemCodeInfo( szCode2 , "market")
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock5", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , szMk2	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock5", "FID_INPUT_ISCD" 				, 0 , szCode2	)

		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock6", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , szMk2	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock6", "FID_INPUT_ISCD" 				, 0 , szCode2	)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock6", "FID_INPUT_MOD_STPR_CLS_CODE" 	, 0 , "0"			)	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock6", "FID_INPUT_DATE1" 			, 0 , szToday			)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock6", "FID_INPUT_HOUR_CLS_CODE" 		, 0 , "300"			)
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock6", "FID_INPUT_PAST_DATA_INCU_YN" 	, 0 , "N"			)	
		DATAMANAGER.SetDataValue( 0, "ohhts_5010_012r", "InBlock6", "FID_INPUT_VRTL_TICK_INCU_YN" 	, 0 , "N"			)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	Dim szList

	if g_szCode == "" then
		Exit Sub
	end if
	
	if sKeyName == "MOVEPOP_RETURN" then
		szList = Split(sRet , "★")
		
		Select Case szList(1)
			Case "0"		'현재가
				Form.OpenScreen("11000" , g_szCode & "★" & "0")
			Case "1" 	'차트
				Form.OpenScreen("13000" , g_szCode)
			Case "2" 	'관심등록
				Form.OpenPopup( "mhprc11000_pd" , g_szCode , sPosInfo)
			Case "3" 	'매수
				Form.OpenScreen("12000" , "관심종목" & "★" & "0" & "★" & g_szCode)
			Case "4" 	'매도
				Form.OpenScreen("12000" , "관심종목" & "★" & "1" & "★" & g_szCode)
		End Select
	
	end if
End Sub

 
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	
	if szTranID == "ohhts_stck_incg" then
		for i = 0 to 4
			'등락률 이미지 세팅
			szCtrtData = Pannel0.GetCellValue("lblCtrt",i)
			if Trim(szCtrtData) <> "" then
				szCtrtData = CDbl(szCtrtData * 100)
				if CDbl(szCtrtData) > 0 then
					Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_red.9.png")
				elseif CDbl(szCtrtData) < 0 then
					Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_blue.9.png")
				else
					Pannel0.setPropCardCell("imgpath", "imgBg", i, "img_bgbox_gray.9.png")
				end if
			end if
		next
	end if
End Sub

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)

	Dim listLocation
	Dim nYPos
	Dim height
	
	listLocation = Split(Pannel0.location, ":")
	nYPos = Int(listLocation[1])	'y위치
	height = listLocation[3]		'높이
	
	sPopupType = "0"
	g_szCode = Pannel0.GetCellValue("lblCode",nIndex)

	if Trim(g_szCode) = "" then
		Exit Sub
	end if

	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "차트" & "★" & "관심등록" & "★" & "매수" & "★" & "매도")
	
End Sub


'============================================================================
Sub lblText_OnClick()
	Form.OpenPopup("mhtro16000_p11" , lblTitle.caption & "★" & g_szCnttText , "")
End Sub

