'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 매체사용신청
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.01 김은숙
' 2020.10.28 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
' 2020.11.13 : 정민영 : v0002 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obacp_opop_008r,064r,obcsb_oimf_494a IO 변경분 반영
'-------------------------------------------------------------------------------------------

'-------------------------------------------------------------------------------------------
'v0002 실명번호 컨트롤 속성 변경(비밀번호 사용X->일반 비밀번호사용) 
'contBirth.edt0.caption
'contLicens.edt0.caption
'contForeign.edt0.caption
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_bAcntChk	'계좌 확인 여부(True인 경우에만 신청할 수 있음)
g_bAcntChk = False

Dim g_sYN0		'종합/IC 카드 기등록 여부
Dim g_sYN1		'보안카드 기등록 여부

Dim g_nReqCnt		'매체사용 신청 갯수
Dim g_nRcvCnt		'매체사용 신청 결과 갯수

Dim g_sChk0		'종합/IC카드 CheckState
Dim g_sChk1		'보안카드 CheckState	
Dim g_sChk2		'통장 CheckState

Dim g_bRcvOK0		'종합/IC카드 매체사용신청 성공
g_bRcvOK0 = False

Dim g_bRcvOK1		'보안카드 매체사용신청 성공
g_bRcvOK1 = False

Dim g_bRcvOK2		'통장 매체사용신청 성공
g_bRcvOK2 = False

Dim g_plain_rm	'v0001 MTS메모리평문적용여부

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'내국인/외국인/법인 선택에 따른 실명번호
Function GetRCNO()
	Dim sRCNO

	'v0002
	if g_plain_rm == "1" then 'MTS메모리평문적용
		if rdoGubn.currentindex == "0" then		'내국인
			sRCNO = contBirth.edt0.caption
		elseif rdoGubn.currentindex == "1" then	'외국인(재외국민)
			sRCNO = contForeign.edt0.caption
		else									'법인
			sRCNO = contLicens.edt0.caption
		end if
	else
		if rdoGubn.currentindex == "0" then		'내국인
			sRCNO = Form.GetEncData(contBirth.edt0.caption)			
		elseif rdoGubn.currentindex == "1" then	'외국인(재외국민)
			sRCNO = Form.GetEncData(contForeign.edt0.caption)
		else									'법인
			sRCNO = Form.GetEncData(contLicens.edt0.caption)
		end if
	end If
	return sRCNO
End Function


'============================================================================
'필수정보 입력 여부 확인
Function ValidatCheck()
	if rdoGubn.currentindex == "0" then		'내국인
		if Len(contBirth.edt0.caption) < 6 then
			Form.MsgBox( "알림", "생년월일을 입력해 주세요.", "", 6 )
			return False
		end if
	elseif rdoGubn.currentindex == "1" then	'외국인(재외국민)
		if contForeign.edt0.caption == "" then
			Form.MsgBox( "알림", "실명확인번호를 입력해 주세요.", "", 6 )
			return False
		end if
	else									'법인
		if contLicens.edt0.caption == "" then
			Form.MsgBox( "알림", "사업자등록번호를 입력해 주세요.", "", 6 )
			return False
		end if
	end if
	
	if Len(contBtm.edtAcnt.caption) < 8 then
		Form.MsgBox( "알림", "계좌번호를 입력해 주세요.", "", 6 )
		return False
	end if
	
	'v0001 화면단에서의 자릿수 체크는 MTS메모리평문 미적용일때만 체크
	if g_plain_rm ~= "1" and (Len(contBtm.edtPW0.caption) < 4 or Len(contBtm.edtPW0.caption) > 8) then
		Form.MsgBox( "알림", "계좌 비밀번호는 4~8자리만 가능합니다.", "", 6 )
		return False
	end if

	return True
End Function

'============================================================================
Function RequestCheck()
	if g_bAcntChk == False then
		Form.MsgBox( "알림", "계좌확인 후 신청가능합니다.", "", 6 )
		return False
	end if
	
	g_sChk0 = contBtm.chk0.checkstate
	g_sChk1 = contBtm.chk1.checkstate
	g_sChk2 = contBtm.chk2.checkstate
	
	if g_sChk0 = "1" then
		g_nReqCnt = g_nReqCnt + 1
	end if
	
	if g_sChk1 = "1" then
		g_nReqCnt = g_nReqCnt + 1
	end if
	
	if g_sChk2 = "1" then
		g_nReqCnt = g_nReqCnt + 1
	end if
	
	if g_nReqCnt == 0 then
		Form.MsgBox( "알림", "최소 하나 이상의 매체를 선택하시기 바랍니다.", "", 6 )
		return False
	end if
	
	if g_sChk2 == "1" and Trim(contBtm.edtBank.caption) == "" then
		Form.MsgBox( "알림", "통장을 선택해주세요.", "", 6 )
		return False
	end if
	
	if g_sChk0 == "1" and g_sYN0 == "Y" then
		Form.MsgBox( "알림", "이미 등록되어 있는 종합/IC 카드 입니다.", "", 6 )
		contBtm.chk0.checkstate = "0"
		return False
	end if
	
	if g_sChk1 == "1" and g_sYN1 == "Y" then
		Form.MsgBox( "알림", "이미 등록되어 있는 보안카드 입니다.", "", 6 )
		contBtm.chk1.checkstate = "0"
		return False
	end if
End Function

'============================================================================
'결과 메세지 팝업
Sub ShowResult()
	Dim sMsg
	sMsg = ""

	if g_nReqCnt > 0 and g_nReqCnt == g_nRcvCnt then		
		if g_sChk0 == "1" and g_bRcvOK0 == True then
			sMsg = sMsg & "[종합/IC카드] "
		end if
		
		if g_sChk1 == "1" and g_bRcvOK1 == True then
			sMsg = sMsg & "[보안카드] "
		end if
		
		if g_sChk2 == "1" and g_bRcvOK2 == True then
			sMsg = sMsg & "[통장] "
		end if
		
		if sMsg <> "" then
			Form.MsgBox( "알림", sMsg & "매체사용 등록이 완료되었습니다." , 0 )
		end if
	end if
End Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("매체사용 신청")

	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)

	Call rdoGubn_OnClick(0)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbisa56040_p1" then
		if sRet == "cancel" then
			contBtm.chk2.checkstate = "0"
		else
			contBtm.edtBank.caption = sRet
		end if
	end if
End Sub

'============================================================================
'내국인/외국인/법인 선택에 따른 CONTAINER SWITCH
Sub rdoGubn_OnClick(nIndex)
	contBirth.visible = False
	contForeign.visible = False
	contLicens.visible = False
	
	if nIndex == 0 then		'내국인
		contBirth.visible = True
		contBtm.top = 84
	elseif nIndex == 1 then	'외국인
		contForeign.visible = True
		contBtm.top = 100
	elseif nIndex == 2 then	'법인
		contLicens.visible = True
		contBtm.top = 84
	end if
End Sub

'============================================================================
'확인 버튼 클릭
Sub contBtm_btnOK_OnClick()
	if ValidatCheck() == False then		'필수정보 입력 여부 확인
		Exit Sub
	end if
	
	DATAMANAGER.RequestTranData("obacp_opop_008r")	'고객정보 체크
End Sub

'============================================================================
Sub contBtm_edtAcnt_OnEditChar(CharCode)
	g_bAcntChk = False
	
	if contBtm.edtBank.caption <> "" then
		contBtm.edtBank.caption = ""
	end if
	contBtm.lblName.caption = ""
End Sub

'============================================================================
'통장 체크시 팝업 후 선택
Sub contBtm_chk2_OnChange(sCheckState)
	If sCheckState == "1" then
		if g_bAcntChk == False then
			Form.MsgBox( "알림", "계좌확인 후 신청가능합니다.", "", 6 )
			contBtm.chk2.checkstate = "0"
			Exit Sub
		end if
	
		Form.OpenPopup("mbisa56040_p1" , contBtm.edtAcnt.caption , "")
	else
		contBtm.edtBank.caption = ""
	End If
End Sub

'============================================================================
'신청
Sub btnOK_OnClick()
	g_nReqCnt = 0		'매체사용 신청 갯수
	g_nRcvCnt = 0		'매체사용 신청 결과 갯수
	
	g_bRcvOK0 = False
	g_bRcvOK1 = False
	g_bRcvOK2 = False
	
	if RequestCheck() == False then	
		Exit Sub
	end if
	
	'종합/IC카드
	if contBtm.chk0.checkstate == "1" then
		DATAMANAGER.RequestTranData("obaci_mdia_003r")	'거래매체사용등록정보조회
	end if
	
	'보안카드
	if contBtm.chk1.checkstate == "1" then	
		DATAMANAGER.RequestTranData("obcsb_oimf_494a")	'보안카드 사용 등록
	end if
	
	'통장
	if contBtm.chk2.checkstate == "1" then
		DATAMANAGER.RequestTranData("obaci_mdia_003r_1")	'거래매체사용등록정보조회
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	'20170828 LES START - UESRID헤더값 세팅
	DATAMANAGER.SetUserID("meritz")
	'20170828 LES END
	
	'v0001 MTS메모리평문 적용에 따라 비밀번호 컨트롤매핑 -> 스크립트로 변경
	if szTranID = "obacp_opop_008r" or szTranID = "obcsb_oimf_494a" or szTranID = "obaci_mdia_001a" or szTranID = "obcsb_mdia_003r" or szTranID = "obaci_mdia_001a_1" or szTranID = "obaci_mdia_003r_1" then
		if g_plain_rm == "1" then  'MTS메모리평문 적용상태일때
		    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , contBtm.edtPW0.caption )
		else  'MTS메모리평문 미적용상태일때
		    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetEncData(contBtm.edtPW0.caption) )
		end if
	end if

	'고객정보체크
	if szTranID = "obacp_opop_008r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 0, GetRCNO())	'실명확인번호 v0002 RCNO->RCNO_PIP
	end if 
	
	'종합/IC카드 등록 정보 조회 / 등록
	'v0002 RCNO 미사용으로 주석처리
	'if szTranID = "obaci_mdia_003r" or szTranID = "obaci_mdia_001a" then
	'	DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO", 0, GetRCNO())	'실명확인번호
	'end if   
	
	'보안카드 등록
	if szTranID = "obcsb_oimf_494a" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 0, GetRCNO())	'실명확인번호 v0002 RCNO->RCNO_PIP
	end if 
	
	'통장 등록 정보 조회 / 등록
	if szTranID = "obaci_mdia_003r_1" or szTranID = "obaci_mdia_001a_1" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO", 0, Right(contBtm.edtBank.caption, 2))
		'v0002 RCNO 미사용으로 주석처리
		'DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 0, GetRCNO())	'실명확인번호  v0002 RCNO->RCNO_PIP
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	
	'고객정보 체크
	if szTranID == "obacp_opop_008r" then
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CSNM" , 0) <> "" then
			DATAMANAGER.RequestTranData("obacp_opop_064r")	'파출계좌등록 계좌조회
		end if
	end if
	
	'파출계좌등록 계좌조회
	if szTranID == "obacp_opop_064r" then
		DATAMANAGER.RequestTranData("obcsb_oimf_492r")		'매체사용신청보안매체발급여부 조회
	end if
	
	'매체사용신청보안매체발급여부
	if szTranID == "obcsb_oimf_492r" then
		g_sYN0 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ISNC_YN" , 0)			'종합IC카드 발급여부
		g_sYN1 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UI_SCRC_ISNC_YN" , 0)	'보안카드 발급여부
		
		g_bAcntChk = True
	end if	
	
	'거래매체사용등록정보조회(종합/IC카드)
	if szTranID == "obaci_mdia_003r" then
		Dim sOutput0, sOutput1, sOutput2, sOutput3, sOutput4
		sOutput0 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ISNC_TIMS" , 0)
		sOutput1 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MSTK_ISNC_TIMS" , 0)
		sOutput2 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TOTAL_ISNC_TIMS" , 0)
		sOutput3 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "USE_YN" , 0)
		sOutput4 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MDIA_SRNO" , 0)
		
		DATAMANAGER.SetDataValue(0, "obaci_mdia_001a", "InBlock1", "ISNC_TIMS", 0, sOutput0 )		'발급회차
		DATAMANAGER.SetDataValue(0, "obaci_mdia_001a", "InBlock1", "MSTK_ISNC_TIMS", 0, sOutput1 )	'오류발급회차
		DATAMANAGER.SetDataValue(0, "obaci_mdia_001a", "InBlock1", "TOTAL_ISNC_TIMS", 0, sOutput2 )	'총발급회차
		DATAMANAGER.SetDataValue(0, "obaci_mdia_001a", "InBlock1", "USE_YN", 0, sOutput3 )		'사용여부
		DATAMANAGER.SetDataValue(0, "obaci_mdia_001a", "InBlock1", "MDIA_SRNO", 0, sOutput4 )		'매체일련번호
		
		DATAMANAGER.RequestTranData("obaci_mdia_001a")	'거래매체 사용등록(종합/IC카드)
	end if
	
	'거래매체사용등록정보조회(통장)
	if szTranID == "obaci_mdia_003r_1" then
		Dim sOutput5, sOutput6, sOutput7, sOutput8, sOutput9
		sOutput5 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "ISNC_TIMS" , 0)
		sOutput6 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MSTK_ISNC_TIMS" , 0)
		sOutput7 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TOTAL_ISNC_TIMS" , 0)
		sOutput8 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "USE_YN" , 0)
		sOutput9 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MDIA_SRNO" , 0)
		
		DATAMANAGER.SetDataValue(0, "obaci_mdia_001a_1", "InBlock1", "ISNC_TIMS", 0, sOutput5 )		'발급회차
		DATAMANAGER.SetDataValue(0, "obaci_mdia_001a_1", "InBlock1", "MSTK_ISNC_TIMS", 0, sOutput6 )	'오류발급회차
		DATAMANAGER.SetDataValue(0, "obaci_mdia_001a_1", "InBlock1", "TOTAL_ISNC_TIMS", 0, sOutput7 )	'총발급회차
		DATAMANAGER.SetDataValue(0, "obaci_mdia_001a_1", "InBlock1", "USE_YN", 0, sOutput8 )			'사용여부
		DATAMANAGER.SetDataValue(0, "obaci_mdia_001a_1", "InBlock1", "MDIA_SRNO", 0, sOutput9 )		'매체일련번호
		
		DATAMANAGER.RequestTranData("obaci_mdia_001a_1")	'거래매체 사용등록(통장)
	end if
	
	'보안카드 등록
	if szTranID = "obcsb_oimf_494a" then
		Dim sSubMsg
		
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_YN" , 0) == "Y" then
			g_bRcvOK1 = True
		else
			sSubMsg = "[보안카드] 등록에 실패하였습니다. " & Chr(13) & DATAMANAGER.GetDataMsgSubText( szTranID )
			Form.MsgBox( "알림", sSubMsg, "", 6 )
		end if
		
		g_nRcvCnt = g_nRcvCnt + 1
		Call ShowResult()		'결과 메세지 팝업
	end if
	
	'거래매체 사용등록(종합/IC카드)
	if szTranID == "obaci_mdia_001a" then
		g_bRcvOK0 = True
		g_nRcvCnt = g_nRcvCnt + 1		
		Call ShowResult()		'결과 메세지 팝업
		
		g_sYN0 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "USE_YN" , 0)
	end if
	
	'거래매체 사용등록(통장)
	if szTranID == "obaci_mdia_001a_1" then
		g_bRcvOK2 = True
		g_nRcvCnt = g_nRcvCnt + 1
		Call ShowResult()		'결과 메세지 팝업
		
		g_sYN1 = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "USE_YN" , 0)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sGubn
	sGubn = ""
	
	if szTranID == "obaci_mdia_003r" then
		sGubn = "[종합/IC 카드] "
	end if
	
	if szTranID == "obaci_mdia_001a" then
		sGubn = "[종합/IC 카드] "
		g_nRcvCnt = g_nRcvCnt + 1
		Call ShowResult()		'결과 메세지 팝업
	end if
	
	if szTranID == "obcsb_oimf_494a" then
		sGubn = "[보안카드] "
		g_nRcvCnt = g_nRcvCnt + 1
		Call ShowResult()		'결과 메세지 팝업
	end if
	
	if szTranID == "obaci_mdia_003r_1" then
		sGubn = "[통장] "
	end if
	
	if szTranID == "obaci_mdia_001a_1" then
		sGubn = "[통장] "
		g_nRcvCnt = g_nRcvCnt + 1
		Call ShowResult()		'결과 메세지 팝업
	end if
	
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", sGubn & szErrMsg & " " & sSubmsg, "", 0 )
End Sub



