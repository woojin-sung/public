'Dim g_szStatus
'Dim g_szPeriodType
'Dim g_szFromDate
'Dim g_szToDate
'
'============================================================================
Sub Form_OnFormInit()
	'진행상태구분값★기간구분값★시작일자★종료일자
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		Dim tData
		tData = Split(szOpenData, "★")
		
		If tData[0] == "%" Then
			rdoStatus.currentindex = "0"
		ElseIf tData[0] == "1" Then
			rdoStatus.currentindex = "1"
		ElseIf tData[0] == "2" Then
			rdoStatus.currentindex = "2"
		ElseIf tData[0] == "3" Then
			rdoStatus.currentindex = "3"
		ElseIf tData[0] == "4" Then
			rdoStatus.currentindex = "4"
		ElseIf tData[0] == "5" Then
			rdoStatus.currentindex = "5"
		End If
		
		If tData[1] == "1" Then
			rdoPeriod.currentindex = "0"
			
			cldFrom.enable = false
			cldTo.enable = false
			
		ElseIf tData[1] == "2" then
			rdoPeriod.currentindex = "1"
			
			cldFrom.enable = false
			cldTo.enable = false
			
		Else
			rdoPeriod.currentindex = "2"
			
			cldFrom.enable = true
			cldTo.enable = true
			
			cldFrom.caption = tData[2]
			cldTo.caption = tData[3]
		End If
	End If
End Sub

'============================================================================
Sub imgAlpha_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnContinue_OnClick()
	Dim szReturnData
	If rdoStatus.currentindex == "0" Then
		szReturnData = "%"
	ElseIf rdoStatus.currentindex == "1" Then
		szReturnData = "1"
	ElseIf rdoStatus.currentindex == "2" Then
		szReturnData = "2"
	ElseIf rdoStatus.currentindex == "3" Then
		szReturnData = "3"
	ElseIf rdoStatus.currentindex == "4" Then
		szReturnData = "4"
	ElseIf rdoStatus.currentindex == "5" Then
		szReturnData = "5"
	End If
	
	If rdoPeriod.currentindex == "0" Then
		szReturnData = szReturnData & "★" & "1" & "★" & cldFrom.caption & "★" & cldTo.caption
	ElseIf rdoPeriod.currentindex == "1" Then
		szReturnData = szReturnData & "★" & "2" & "★" & cldFrom.caption & "★" & cldTo.caption
	Else
		szReturnData = szReturnData & "★" & "3" & "★" & cldFrom.caption & "★" & cldTo.caption
	End If
	
	Form.SendReturnToParent("COND_RETURN" , szReturnData)
	Form.CloseForm()
End Sub

'============================================================================
Sub rdoPeriod_OnClick(nIndex)
	If nIndex == 2 Then
		cldFrom.enable = true
		cldTo.enable = true
	Else
		cldFrom.enable = false
		cldTo.enable = false
	End If
End Sub

'============================================================================
Sub cldFrom_OnEditComplete()
	Dim szFromDt, szToDt
	szFromDt = CInt(cldFrom.caption)
	szToDt = CInt(cldTo.caption)
	If szFromDt > szToDt Then
		Form.ShowAlert("알림", "날짜를 다시 선택해 주세요.")
		cldFrom.caption = cldTo.caption
	End If
End Sub

'============================================================================
Sub cldTo_OnEditComplete()
	Dim szFromDt, szToDt
	szFromDt = CInt(cldFrom.caption)
	szToDt = CInt(cldTo.caption)
	If szFromDt > szToDt Then
		Form.ShowAlert("알림", "날짜를 다시 선택해 주세요.")
		cldTo.caption = cldFrom.caption
	End If
End Sub


