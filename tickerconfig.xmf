	<SCRIPT_INFO _len="6297" _ulen="5731" >

'20221117 LES START 차세대 업종코드 변경
'0001 => KGG01P , 1001 => QGG01P
g_szTopTickerKey = "KGG01P"
g_szBotTickerkey = "QGG01P"
'20221117 LES END

'============================================================================
Sub Form_OnFormInit()
	
	' 최근 월물 조회
	g_szTopTickerKey = Form.GetEnvData("alrim.ticker.top")
	if g_szTopTickerKey == "" then
		
		'20221117 LES START 차세대 업종코드 변경
		'0001 => KGG01P , 1001 => QGG01P
		g_szTopTickerKey = "KGG01P:QGG01P"
		'20221117 LES END
		
	end if
	
	g_szBotTickerkey = Form.GetEnvData("alrim.ticker.bottom")
	if g_szBotTickerkey == "" then
		g_szBotTickerkey = "DJI@DJI:NAS@IXIC"
	end if
	
	'20221117 LES START 차세대 업종코드 변경
	replace(g_szTopTickerKey, "0001" , "KGG01P")
	replace(g_szTopTickerKey, "1001" , "QGG01P")
	replace(g_szTopTickerKey, "2029" , "K2G01P")
	
	replace(g_szBotTickerkey, "0001" , "KGG01P")
	replace(g_szBotTickerkey, "1001" , "QGG01P")
	replace(g_szBotTickerkey, "2029" , "K2G01P")
	'20221117 LES END
	
	SetCheckTopKey(g_szTopTickerKey)
	
End Sub

' 리스트로 선택된 키 값을 체크 박스에 표시해준다.
Sub SetCheckTopKey(sTopKey)
	AllUnCheckBox()
	arrTopKey = Split( sTopKey, ":", 0, 0 )
	if #arrTopKey > 0 then
		For i = 0 To #arrTopKey - 1
			sKey = arrTopKey(i)
			CheckCheckBox(sKey)
		Next
	end if
end sub

' 모든 체크 박스르를 언체크로 표시한다.
Sub AllUnCheckBox()
	for i = 0 to 9
		sCtlName = "ChkButton"..i
		Form.SetCtlProp(sCtlName, "chksilence", "0")
	next
End Sub

' 키에 해당되는 체크 박스를 표시한다.
Sub CheckCheckBox(sKey)
	for i = 0 to 9
		sCtlName = "ChkButton"..i
		sChData = Form.GetCtlProp(sCtlName, "chkdata")
		if sChData == sKey then
			Form.SetCtlProp(sCtlName, "chksilence", "1")
		end if
	next
end Sub

' 선택된 체크 박스의 키 값을 리스트 형태로 구성한다.
Sub GetCheckKey()
	sKeyData = ""
	for i = 0 to 9
		sCtlName = "ChkButton"..i
		sState = Form.GetCtlProp(sCtlName, "checkstate")
		if sState == "1" then
			sChData = Form.GetCtlProp(sCtlName, "chkdata")
			if sKeyData == "" then
				sKeyData = sChData
			else
				sKeyData = sKeyData..":"..sChData
			end if
		end if
	next
	return sKeyData
end Sub


'============================================================================
Sub Button0_OnClick()

	Form.SetEnvData( 1 ,"alrim.ticker.top", g_szTopTickerKey)
	Form.SetEnvData( 1 ,"alrim.ticker.bottom", g_szBotTickerKey)
	
	Form.SendMessageToMain("TICKER_CHANGE", "", "")
	
	Form.CloseForm()	
End Sub

'============================================================================
Sub Tab0_OnTabChanged(nCurrentTab)
	if nCurrentTab == 0 or nCurrentTab == "0" then
		g_szBotTickerKey = GetCheckKey()
		SetCheckTopKey(g_szTopTickerKey)
	elseif nCurrentTab == 1 or nCurrentTab == "1" then
		g_szTopTickerKey = GetCheckKey()
		SetCheckTopKey(g_szBotTickerKey)
	end if
End Sub

'' 현재 선택된 상하단의 키 값을 가져 온다.
Sub GetSelectTickerKey()
	if Tab0.currenttab == 0 or Tab0.currenttab == "0" then
		g_szTopTickerKey = GetCheckKey()
		if g_szTopTickerKey == "" then
			return false
		end if
	elseif Tab0.currenttab == 1 or Tab0.currenttab == "1" then
		g_szBotTickerKey = GetCheckKey()
		if g_szBotTickerKey == "" then
			return false
		end if
	end if
	
	return true
end Sub

'============================================================================


'============================================================================
Sub ChkButton0_OnChange(sCheckState)
	if (GetSelectTickerKey() == false) then
		Form.MsgBox("알림", "최소 하나 이상은 선택을 하셔야 합니다.", "", 0)
		ChkButton0.checkstate = "1"
	end if
End Sub

