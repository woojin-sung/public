'============================================================================
Sub USER_Notice()
	If g_szRsevYn = "N" Then '예약청약여부
		'Label1.caption = "1. 청약기간 중에만 조회 및 청약신청(취소)이 가능합니다."..CHR(13)..CHR(13).."2. 청약가능시간"..CHR(13).."    · 청약일: 08:00~17:00"..CHR(13).."    · 청약종료일: 08:00~14:00"
		Label1.caption = "1. 청약기간 중에만 조회 및 청약신청(취소)이 가능합니다.\n\n2. 청약가능시간\n    · 청약일: 08:00~17:00\n    · 청약종료일: 08:00~14:00"
	ElseIf g_szRsevYn = "Y" then
		'Label1.caption = "1. 예약청약기간 중에만 조회 및 청약신청(취소)이 가능합니다"..CHR(13)..CHR(13).."2. 청약가능시간"..CHR(13).."    · 본청약일 5영업일전 ~ 본청약전일까지 08:00~17:00"
		Label1.caption = "1. 예약청약기간 중에만 조회 및 청약신청(취소)이 가능합니다\n\n2. 청약가능시간\n    · 본청약일 5영업일전 ~ 본청약전일까지 08:00~17:00"
	End If
End sub
'============================================================================

Sub Form_OnFormInitBefore()
End Sub

Sub Form_OnFormInit()
	g_szBIZDATE = Form.GetSharedData("&HOST_DATE", 0)
	g_szData = Form.GetOpenLinkData()
	'Form.ShowAlert("", szOpenData)
	
	'g_szList(0) :계좌번호★
	'g_szList(1) :계좌일련번호★
	'g_szList(2) :권리구분코드★
	'g_szList(3) :종목명★ 0
	
	'g_szList(4) :청약단가★ 1
	'g_szList(5) :청약가능금액★ 2
	'g_szList(6) :본배정수량★ 3
	
	'g_szList(7) :초과배정수량★ 4
	'g_szList(8) :문서명★5
	'g_szList(9) :종목코드★6
	
	'g_szList(10):권리기준일자★7
	'g_szList(11):총배정수량★8
	'g_szList(12):배정금액★ 9
	
	'g_szList(13):초과배정수량★ 10
	'g_szList(14):초과배정금액★ 11
	'g_szList(15):투자설명서★ 12
	
	'g_szList(16):총청약금액★ 16
	'g_szList(17):신청구분★
	
	'g_szList(18):청약수량★
	'g_szList(19):청약금액★
	'g_szList(20):초과청약수량★
	'g_szList(21):초과청약금액★
	
	g_szList = Split(g_szData, "★")
	
	btnOkWide.visible = true
	'btnOkWide.btnimage = "btn_blue_bg_02.9.png"
	btnOkWide.fgcolor = "16"
	
	if UBound(g_szList) > 1 then
		'Form.ShowAlert("", g_szList(17))
		g_szRsevYn = g_szList(17) '예약청약여부
		g_INVT_RFP_CRTN_YN = g_szList(15)
		call USER_Notice()
	end if
	
	
End Sub

