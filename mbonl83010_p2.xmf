Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrgt_stsb_201a" or szTranID == "obrgt_stsb_101a" then			'유상청약 처리후
		'Form.ShowAlert( "알림" , "정상처리 되었습니다." )
		'Form.CloseForm()					'청약신청이 끝나면 화면 종료
		Form.openPopupAnimation("mbonl83010_p3",g_szData, "","2")
	end if
End Sub


