					<ROW_INFO ly_vert_height="20,20,20,20,20,10,20,20,20,20,10,20,20,20,20,20,20,20,20,20,20,20,20,20,20,20,20,20,20,20,20,20" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,0,1,0" halign="0" line="0,0" caption="투자자정보확인서는 [금융소비자 보호에 관한" impidxs="" />
						<CELL cell_ly="0,1,0,1" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,1,1,1" halign="0" line="0,0" caption="법률]에 따라 고객의 투자자정보를 파악하여, " impidxs="" />
						<CELL cell_ly="0,2,0,2" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,2,1,2" halign="0" line="0,0" caption="그에 적합한 투자권유를 하기 위한 기초 자료로" impidxs="" />
						<CELL cell_ly="0,3,0,3" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,3,1,3" halign="0" line="0,0" caption="활용됩니다. 고객의 상황에 부합하거나 가장" impidxs="" />
						<CELL cell_ly="0,4,0,4" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,4,1,4" halign="0" line="0,0" caption="가까운 항목을 정확히 선택하여 주시기 바랍니다." impidxs="" />
						<CELL cell_ly="0,5,0,5" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,5,1,5" halign="0" line="0,0" impidxs="" />
						<CELL cell_ly="0,6,0,6" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,6,1,6" halign="0" line="0,0" caption="'투자일임' 또는 '비지정형 금전신탁계약'을 체결" impidxs="" />
						<CELL cell_ly="0,7,0,7" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,7,1,7" halign="0" line="0,0" caption="하고자 하는 경우 고객의 유형을 분류하고 유형" impidxs="" />
						<CELL cell_ly="0,8,0,8" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,8,1,8" halign="0" line="0,0" caption="에 적합한 방식으로 운용하기 위해 반드시 투자자" impidxs="" />
						<CELL cell_ly="0,9,0,9" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,9,1,9" halign="0" line="0,0" caption="정보확인서를 작성하셔야 합니다." impidxs="" />
						<CELL cell_ly="0,10,0,10" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,10,1,10" halign="0" line="0,0" impidxs="" />
						<CELL cell_ly="0,11,0,11" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,11,1,11" halign="0" line="0,0" caption="적정성원칙 대상 상품을 거래하고자 하는 경우" impidxs="" />
						<CELL cell_ly="0,12,0,12" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,12,1,12" halign="0" line="0,0" caption="에는 반드시 투자자정보확인서를 작성하셔야 " impidxs="" />
						<CELL cell_ly="0,13,0,13" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,13,1,13" halign="0" line="0,0" caption="합니다. [금융소비자 보호에 관한 법률 시행령]" impidxs="" />
						<CELL cell_ly="0,14,0,14" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,14,1,14" halign="0" line="0,0" caption="제12조 1항" impidxs="" />
						<CELL cell_ly="0,15,0,15" line="0,0" fontsize="5" impidxs="" />
