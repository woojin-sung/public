						<CELL cell_ly="0,16,0,16" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,16,1,16" halign="0" line="0,0" caption="투자권유를 희망하지 않거나 투자자 정보를 제공" impidxs="" />
						<CELL cell_ly="0,17,0,17" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,17,1,17" halign="0" line="0,0" caption="하지 않는 경우에는 고객의 별도 의사가 있기 전" impidxs="" />
						<CELL cell_ly="0,18,0,18" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,18,1,18" halign="0" line="0,0" caption="까지 회사가 투자권유를 할 수 없습니다." impidxs="" />
						<CELL cell_ly="0,19,0,19" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,19,1,19" halign="0" line="0,0" impidxs="" />
						<CELL cell_ly="0,20,0,20" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,20,1,20" halign="0" line="0,0" caption="투자 시 원금손실이 발생할 수 있으며, 투자손익" impidxs="" />
						<CELL cell_ly="0,21,0,21" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,21,1,21" halign="0" line="0,0" caption="에 대한 책임은 모두 고객에게 귀속됩니다." impidxs="" />
						<CELL cell_ly="0,22,0,22" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,22,1,22" halign="0" line="0,0" impidxs="" />
						<CELL cell_ly="0,23,0,23" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,23,1,23" halign="0" line="0,0" caption="투자자정보 진단은 1일 최대 3회까지만 가능" impidxs="" />
						<CELL cell_ly="0,24,0,24" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,24,1,24" halign="0" line="0,0" caption="하오니 신중히 답변해주시기 바랍니다." impidxs="" />
						<CELL cell_ly="0,25,0,25" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,25,1,25" halign="0" line="0,0" impidxs="" />
						<CELL cell_ly="0,26,0,26" line="0,0" caption="·" fontsize="5" impidxs="" />
						<CELL cell_ly="1,26,1,26" halign="0" line="0,0" caption="투자자정보확인서는 작성한 날로부터 24개월" impidxs="" />
						<CELL cell_ly="0,27,0,27" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,27,1,27" halign="0" line="0,0" caption="동안 투자자성향이 유지됩니다. " impidxs="" />
						<CELL cell_ly="0,28,0,28" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,28,1,28" halign="0" line="0,0" caption="(단, 투자일임의경우 12개월 유효하며, " impidxs="" />
						<CELL cell_ly="0,29,0,29" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,29,1,29" halign="0" line="0,0" caption="비지정형 금전신탁 계약의경우 연 1회 이상 " impidxs="" />
						<CELL cell_ly="0,30,0,30" line="0,0" impidxs="" />
						<CELL cell_ly="1,30,1,30" halign="0" line="0,0" caption="투자자정보 변경 여부를 확인해야 합니다.)" impidxs="" />
