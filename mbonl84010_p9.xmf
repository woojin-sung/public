Sub Form_OnFormInit()
	'계좌재조회
	Form.RequestCommand("RE_ACCT_LIST", "", "")
End Sub

'============================================================================
Sub ImageClose_OnClick()
	Form.SendReturnToParent( "mbonl84010_p9" , "cancel" )
	Form.CloseForm()
End Sub

'============================================================================
'CMA 발행어음 매수단위 등록
Sub btnJoin_OnClick()
