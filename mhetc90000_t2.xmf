	ChangeInitKey_UIsetting() '20230707 hsz
End Function 

'============================================================================
' 환경설정값리턴함수
'============================================================================
Function GetConfigData(sFileName, sKey, nRow, nCol)
	Dim sValue
	if sKey == g_sPwdKey then
		sValue = Form.GetEnvData(sKey)
	else
		sValue = Form.LoadConfigData(sFileName, sKey)
	end if

	if sValue == null or Trim(sValue) == "" then
		if sKey == g_sPwdKey then
			sValue = "0" '기본값 Off
'		else sKey == g_sMarketKey then
'			sValue = "0" '기본값 Off
		elseif sKey == g_sConfirmKey or sKey == g_sAfterInitKey or sKey == g_sAutoNoKey or sKey == g_sChangeInitKey then
			sValue = "1" '기본값 On
		else
			sValue = "0" '기본값 Off
		end if
	end if
	
	if sKey == g_sStockBuyQtyKey then
		if sValue == "0" then
			sValue = "미사용"
		elseif sValue == "1" then
			sValue = "현금가능수량"
		elseif sValue == "2" then
			sValue = "최대가능수량"
		else
			sValue = "수량입력"
		end if
	elseif sKey == g_sStockSelQtyKey then
		if sValue == "0" then
			sValue = "미사용"
		elseif sValue == "1" then
			sValue = "보유잔고수량"
		else
			sValue = "수량입력"
		end if
	elseif sKey == g_sFutOptBuyQtyKey then
		if sValue == "0" then
			sValue = "미사용"
		elseif sValue == "1" then
			sValue = "신규가능수량"
		elseif sValue == "2" then
			sValue = "청산가능수량"
		else
			sValue = "수량입력"
		end if
	elseif sKey == g_sFutOptSelQtyKey then
		if sValue == "0" then
			sValue = "미사용"
		elseif sValue == "1" then
			sValue = "신규가능수량"
		elseif sValue == "2" then
			sValue = "청산가능수량"
		else
			sValue = "수량입력"
		end if
	else	
	
		'20230517 KKM START 스위치 버튼으로 수정
		if sKey == g_sPwdKey then 
			Cont0.btnPwdKey.switchindex = sValue			
			Exit Function
		elseif sKey == g_sConfirmKey then
			Cont0.btnConfirmKey.switchindex = sValue
			Exit Function
		elseif sKey == g_sAfterInitKey then
			Cont0.btnAfterInitKey.switchindex = sValue
			Exit Function
		elseif sKey == g_sChangeInitKey then
			Cont0.btnChangeInitKey.switchindex = sValue
			ChangeInitKey_UIsetting()
			Exit Function
		elseif sKey == g_sAutoNoKey then
			Cont0.btnAutoNoKey.switchindex = sValue
			Exit Function
		end if		
		'20230517 KKM END

		if sValue == "1" then 'On
			sValue = "사용"
		else 'Off
			sValue = "미사용"
		end if	
	end if

	Cont0.Table0.SetCellString( nRow, nCol, sValue )
	'20230517 KKM START 스위치 버튼을 변경
	Cont0.Table0.SetCellFgColor( nRow, nCol, "12")
'	if sValue == "미사용" then
'		Cont0.Table0.SetCellFgColor( nRow, nCol, "4" )
'	else
'		Cont0.Table0.SetCellFgColor( nRow, nCol, "128" )
'	end if
	'20230517 KKM END 
	ChangeInitKey_UIsetting()
End Function 

'============================================================================
' 환경설정값리턴함수
'============================================================================
Function GetConfigData1(sFileName, sKey, sCtlName, sPropName)
	Dim sValue
	sValue = Form.LoadConfigData(sFileName, sKey)

	if sValue == null or Trim(sValue) == "" then
		sValue = "0" '기본값 사용하지않음
	end if
	
	Form.SetCtlProp( sCtlName, sPropName, sValue )
End Function 

'============================================================================
' 환경설정값세팅함수
'============================================================================
Function SetConfigData(sFileName, sKey, nRow, nCol)
	
	Dim sValue
	
	'20230517 KKM START 교체된 스위치 버튼의 값 저장 
	if sKey == g_sPwdKey then
		'Form.SetEnvData(1, sKey, sValue)
		Form.SetEnvData(1, sKey, Cont0.btnPwdKey.switchindex)
	elseif sKey == g_sConfirmKey then 	
		Form.SaveConfigData( sFileName, sKey, Cont0.btnConfirmKey.switchindex )
	elseif sKey == g_sAfterInitKey then 	
		Form.SaveConfigData( sFileName, sKey, Cont0.btnAfterInitKey.switchindex )
	elseif sKey == g_sChangeInitKey then 	
		Form.SaveConfigData( sFileName, sKey, Cont0.btnChangeInitKey.switchindex )
	elseif sKey == g_sAutoNoKey then 	
		Form.SaveConfigData( sFileName, sKey, Cont0.btnAutoNoKey.switchindex )
	else
		sValue = Cont0.Table0.GetCellString( nRow, nCol )	
		if sValue == "사용" then
			sValue = "1"
		else
			sValue = "0"
		end if	
		Form.SaveConfigData( sFileName, sKey, sValue )
	end if
	'20230517 KKM END
End Function 

'============================================================================
' 환경설정값세팅함수
'============================================================================
Function SetConfigData1(sFileName, sKey, sCtlName, sPropName)
	Dim sValue
	sValue = Form.GetCtlProp( sCtlName, sPropName )
	
	Form.SaveConfigData( sFileName, sKey, sValue )
End Function 

'============================================================================
' 글자색상함수
'============================================================================
Function SetFgColor(nRow, nCol)
	Dim sValue
	sValue = Cont0.Table0.GetCellString( nRow, nCol )
	
	'20230517 KKM START 스위치 버튼을 변경	
	Cont0.Table0.SetCellFgColor( nRow, nCol, "12" )
'	if sValue == "미사용" then
'		Cont0.Table0.SetCellFgColor( nRow, nCol, "4" )
'	else
'		Cont0.Table0.SetCellFgColor( nRow, nCol, "128" )
'	end if
	'20230517 KKM END
End Function 

