'===============================================================================
'20230707 HSZ START: 설정으로 변경 시, 주식설정란 비활성화 처리
Sub ChangeInitKey_UIsetting()
	sValue = Form.LoadConfigData(g_sFileName, g_sChangeInitKey)
	if sValue = "1" then
		Cont0.Table0.SetCellFgColor( 15, 1, 17 )
		Cont0.Table0.SetCellFgColor( 16, 1, 17 )
		Cont0.ImgEnable0.left = 0
		Cont0.ImgEnable1.left = 0
		Cont0.Combo0.enable = false
		Cont0.Combo1.enable = false
		Cont0.Combo2.enable = false
		Cont0.Image0.enable = false
		Cont0.Image1.enable = false
	else
		Cont0.Table0.SetCellFgColor( 15, 1, 12 )
		Cont0.Table0.SetCellFgColor( 16, 1, 12 )
		Cont0.ImgEnable0.left = 1000		
		Cont0.ImgEnable1.left = 1000
		Cont0.Combo0.enable = true
		Cont0.Combo1.enable = true
		Cont0.Combo2.enable = true
		Cont0.Image0.enable = true
		Cont0.Image1.enable = true
	end if
	
End Sub
'20230626 HSZ END
'============================================================================
Sub Form_OnFormInitBefore()
	Cont0.imgInfo1.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
End Sub

'============================================================================
Sub Cont0_imgInfo1_OnClick()
	Cont0.imgInfo1.openToolTip("화면 진입 시, 탭 이동 시, 종목 변경 시\n설정된 값으로 조회됩니다.\n단, 현금/신용/대출 탭 간 이동 시에는 \n미적용 되며, 이전 입력된 데이터가 유지되어 조회됩니다.", 300, 130, 0)	
End Sub

