Sub Form_OnFormInit()
'PENTA13 START => 2021.01.26	애플정책적용
	s_OSTYPE = Form.GetSharedData("&OS_TYPE", false )
	if s_OSTYPE == "2" Then
		Container0.Table0.SetCellString(10, 1, "아이폰 : AppStore에서 '바이오인증 공동앱' 설치")
