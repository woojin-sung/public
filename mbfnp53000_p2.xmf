'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szData
Dim g_szList
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	
	g_szData = Form.GetOpenLinkData()
	
	g_szList = Split( g_szData, "★")
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
	
	Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid, "mbfnp53000_p3", g_szData)
	
End Sub

'============================================================================
Sub fmtab0_OnTabChanged(nCurrentTab)
	
	Select Case nCurrentTab
		Case 0
			Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid, "mbfnp53000_p3", g_szData)
		Case 1
			Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid, "mbfnp53000_p4", g_szData)
		Case 2
			Form.triggerEvent( "fmtab0." & fmtab0.currenttabpageid, "mbfnp53000_p5", g_szData)
	End Select
	
End Sub

	</SCRIPT_INFO>
