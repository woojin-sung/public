'============================================================================
' ImgPrev_OnClick : 관심그룹보기 ◁(이전)버튼
'============================================================================
Sub ImgPrev_OnClick()

	if Int(cmbGroup.currentindex) == 0 then
		cmbGroup.currentindex = cmbGroup.rowcount-1
	else
		cmbGroup.currentindex = cmbGroup.currentindex - 1
	end if
End Sub

'============================================================================
' ImgNext_OnClick : 관심그룹보기 ▷(다음)버튼
'============================================================================
Sub ImgNext_OnClick()
	if Int(cmbGroup.currentindex) == Int(cmbGroup.rowcount-1) then
		cmbGroup.currentindex = 0
	else
		cmbGroup.currentindex = cmbGroup.currentindex + 1
	end if

	' 콤보의 currentindex변경시 OnEditComplete 이벤트가 적용됨	
End Sub

'============================================================================
'20170227 NOHES START : 관심종목 자유 추가
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "FreeAdd" Then
		arrData = Split( Trim(sParam) ,"♥")
		
		if #arrData < 1 Then
			Exit Sub
		End if
		
		
		nrow = 0
		For i=0 to #arrData-1
			arrTemp = Split(arrData(i), "|")
			
			if arrTemp(0) <> ""  And arrTemp <> "" Then
				gridAdd.insertrow = nrow
				gridAdd.SetCellData("bd_code",  nrow, arrTemp(0))
				gridAdd.SetCellData("bd_name",  nrow, arrTemp(1))
				gridAdd.SetCellFgColor("bd_name", nrow, "061")
				gridAdd.SetCellFgColor("bd_code", nrow, "061")
				
				nrow = nrow+1
			end if
		Next
	End if
End Sub
'============================================================================
'20170227 NOHES START : 단건/다건 종목 등록
'bAll [0/false:단건	1/true:다건]   ->   Add_Item(bAll) 로 함수 call
'============================================================================
Function Insert_code(nCnt, bAll)
	scode = ""
	
	if bAll == true or bAll == 1 Then	'다건 종목 등록시
		For i=0 to nCnt
			if i == nCnt then
				scode = scode & gridAdd.GetCellData("bd_code", i)
			else
				scode = scode & gridAdd.GetCellData("bd_code", i) & ":"
			end if
		Next
	else								'단건 종목 등록시
		scode = gridAdd.GetCellData("bd_code", nCnt)
	end if
	
	nRow = 0
	szCode, szName = "", ""
	g_tCode = {}

	if Trim(scode) <> "" then
		g_tCode = Split(scode, ":")

		nRow = grdList.rowcount()

		if #g_tCode == 1 then
			For i = 0 to nRow - 1
				szCode = Trim(grdList.GetCellData("bd_code", i))

				if szCode == Trim(g_tCode[0]) then
					szName = Form.GetItemCodeInfo(scode, "name")
					g_szCd = g_tCode[0]
					
					Form.MsgBox(g_szTitle, szName & "은(는) 이미 등록되어 있습니다.\r\n\n중복해서 등록하시겠습니까?", "ADD_ITEM", 1)
					Exit Function
				end if
			Next
			
			g_szCd = g_tCode[0]
			Add_Item(0)
			
		elseif #g_tCode > 1 then
			For j = 0 to #g_tCode - 1
				For i = 0 to nRow - 1
					szCode = Trim(grdList.GetCellData("bd_code", i))

					if szCode == Trim(g_tCode[j]) then
						g_szCd = g_tCode[j]
						
						Form.MsgBox(g_szTitle, "선택종목들 중 이미 등록되어 있는 종목이 있습니다.\r\n\n중복해서 등록하시겠습니까?", "ADD_ITEMS", 1)
						Exit Function
					end if
				Next					
			Next
			
			if CInt(gridAdd.rowcount) + CInt( grdList.rowcount ) > 100 Then
				nCnt = 100- CInt( grdList.rowcount ) -1
				stemp = gridAdd.GetCellData( "bd_name", nCnt )
				Form.ShowAlert(g_szTitle, "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다.\r\n(" & stemp & ") 이후 종목은 등록되지 않습니다." )						
			end if	

			' 20160411 : 확인이 다 되었으면 리스트에 담는다.
			For k = 0 to nCnt
				g_szCd = g_tCode[k]
				Add_Item(1)
			Next				
		end if
	end if	

End Function

'============================================================================
Sub gridAdd_OnClickUp(lRow, szCellID)
	if szCellID == "bd_cancel" then
		szCode = gridAdd.GetCellData("bd_code", lRow)
		szName = gridAdd.GetCellData("bd_name", lRow)
		g_szAddRow = lRow
		
		Form.MsgBox(g_szTitle, "관심그룹에 추가할 종목을 제거하시겠습니까?\r\n\n["& szCode & "] " & szName , "DELETE_ADD", 1)
	elseif szCellID == "bd_name" then
		
		if CInt(grdList.rowcount) == 100 then
			if CInt(lColumn) == 0 then
				'Form.ShowAlert("관심종목추가", "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
				Form.ShowAlert(g_szTitle, "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
			else
				'Form.ShowAlert("관심빈칸추가", "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
				Form.ShowAlert(g_szTitle, "1개의 관심그룹에는 최대 100개의 종목(빈칸)만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
			end if
			
			Exit Sub
		end if
		
		Call Insert_code( lRow, false )		'단건 종목 추가		
	end if
	
End Sub


'============================================================================
Sub tblGroup_OnClick(lRow , lColumn)
	if lColumn == "0" or lColumn == 0 Then
		Call ImgPrev_OnClick()
	elseif lColumn == "2" or lColumn == 2 Then
		Call ImgNext_OnClick()
	end if
End Sub

'============================================================================
Sub BtnSave_OnClick()
	Call Check_LocalOrServer()
End Sub

