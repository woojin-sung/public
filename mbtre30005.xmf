						<CELL cell_ly="0,3,0,3" line="0,0" impidxs="" />
						<CELL cell_ly="1,3,1,3" halign="0" line="0,0" caption="      ▶1일 헷지수수료 = 600달러 × 2% ÷ 365 = 0.03달러" fontsize="-4" impidxs="" />
						<CELL cell_ly="0,4,0,4" line="0,0" impidxs="" />
