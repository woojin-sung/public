	<SCRIPT_INFO _len="8602" _ulen="8008" >
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_szSavePwd
dim g_sPlain_rm

'============================================================================
Sub Form_OnFormInit()
	f_InitUI()
	Container0.btnPwd.bringfront("1")
End Sub

'============================================================================
Sub Container0_btnPwd_OnClick()
	Container0.ChkButton0.checkstate = "0" 
	'Container0.ChkButton0.enable = true
	'Container0.btnChange.enable = true
	'Container0.ChkButton0.enable = false
	'Container0.btnChange.enable = false
	
	if Container0.cmbAccount.caption = null or Container0.cmbAccount.caption = "" then
		Form.ShowAlert("알림", "선택할 수 있는 계좌가 없습니다.")
		Exit Sub
	end if
	
	Form.openPopupAnimation("pwdcheckpopup",Container0.cmbAccount.caption,"","2")
End Sub

'============================================================================
Sub Container0_cmbAccount_ChangeAccount()
	f_InitUI()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				Container0.edtPassword.pwdlen = tData(1)
				Container0.edtPassword.caption = tData(0)
				Container0_edtPassword_OnEditComplete()
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				'edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				'edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
		else
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				'edtPwdIcon.imgpath = "icon_save_password_n.9"
				Container0.edtPassword.caption = ""
			else
				szCurAcc = Container0.cmbAccount.caption
				nCnt = Cint(Container0.cmbAccount.accountcount)
				
				For i = 0 to nCnt - 1
					szCompAcc = Container0.cmbAccount.getAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						Container0.cmbAccount.currentindex = i
						Exit For
					end if
				Next
				
				'edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
		end if
	end if
	
'        if sKeyName == "BTN_SHORTCUT_GROUP" then
'            if sRet == "Y" then
'               Form.OpenScreen("16405" , "") '해외CFD 안심계좌 외화자동매수 신청
'           end if 
'        end if
	
End Sub

'f_InitUI() : 컨트롤 위치, 체크 상태, 이미지 등 초기화
'============================================================================
Sub f_InitUI()
	Container0.Label1.caption = ""
	Container0.ChkButton0.checkstate = "0" 
	Container0.ChkButton0.enable = true
	Container0.btnChange.enable = true
	'Container0.ChkButton0.enable = false
	'Container0.btnChange.enable = false
	
	if Container0.cmbAccount.caption <> null and Container0.cmbAccount.caption <> "" and Container0.edtPassword.caption <> null and Container0.edtPassword.caption <> "" then
		DATAMANAGER.RequestTranData("obtre_acnt_101r") '해외CFD 안심 계좌 동의 여부 조회
	end if
End Sub

Sub Container0_edtPassword_OnEditComplete()
        f_InitUI()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	g_sPlain_rm = Form.GetSharedData("&PLAIN_RM" , false) '암호화 여부
	dim szPwd
	szPwd = ""
	'패스워드 암호화여부
	If g_sPlain_rm = "1" Then
		szPwd = Container0.edtPassword.caption
	Else
		szPwd = Container0.edtPassword.encdata
	    if Trim(szPwd) == "" or Trim(szPwd) == null then
		    szPwd = Container0.edtPassword.caption
	    end if
	End If
	
	if szTranID == "obtre_acnt_101r" then  '해외CFD 안심 계좌 동의 여부 조회

		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , Container0.cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , Container0.cmbAccount.sequence)'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , szPwd)

	elseif szTranID == "obtre_acnt_102a" then ' 해외CFD 안심계좌 헷지수수료 부과 동의

		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , Container0.cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , Container0.cmbAccount.sequence)'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , szPwd)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CFD_RELF_AGRM_YN" , 0 , "Y")

	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "obtre_acnt_101r" then  '해외CFD 안심 계좌 동의 여부 조회
	
		if DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "CFD_RELF_AGRM_YN" , 0 ) = "Y" then
		    Container0.Label1.caption = "동의"
		    Container0.ChkButton0.enable = false
		    Container0.btnChange.enable = false
		elseif DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "CFD_RELF_AGRM_YN" , 0 ) = "N" then
		    Container0.Label1.caption = "미동의"
		    Container0.ChkButton0.enable = true
		    Container0.btnChange.enable = true
		    'Container0.ChkButton0.enable = Container0.cmbAccount.caption <> null and Container0.cmbAccount.caption <> "" and Container0.edtPassword.caption <> null and Container0.edtPassword.caption <> ""
		    'Container0.btnChange.enable = Container0.cmbAccount.caption <> null and Container0.cmbAccount.caption <> "" and Container0.edtPassword.caption <> null and Container0.edtPassword.caption <> ""
		else
		    Container0.Label1.caption = "불필요"
		    Container0.ChkButton0.enable = false
		    Container0.btnChange.enable = false
	        end if
		
	elseif szTranID == "obtre_acnt_102a" then ' 해외CFD 안심계좌 헷지수수료 부과 동의
	
	        Form.ShowAlert( "알림" , "해외CFD 안심계좌에서 헷지수수료 부과에\n동의하였으며, 신규 주문이 가능합니다.")
		'Form.OpenPopup("mbtre30005_p1" , "", "") '해외CFD 안심계좌 외화자동매수 신청 팝업 호출
		f_InitUI()
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Container0.Label1.caption = ""
	Container0.ChkButton0.checkstate = "0" 
	Container0.ChkButton0.enable = false
	Container0.btnChange.enable = false

	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubErr <> null or Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , szErrMsg)
	end if
End Sub

'============================================================================
Sub Container0_btnChange_OnClick()
	if Container0.edtPassword.caption = "" or Container0.edtPassword.caption == null then
		Form.MsgBox("알림", "비밀번호를 입력해주세요.", "", 0)
		Exit Sub
	end if
	
	If Container0.Label1.caption == "" Then
	        Form.ShowAlert( "알림" , "동의 여부를 먼저 조회해 주세요.")
                Exit Sub
	End If

	If Container0.ChkButton0.checkstate == "0" Then
	        Form.ShowAlert( "알림" , "동의 여부를 확인 바랍니다.")
                Exit Sub
	End If

	If Container0.Label1.caption == "동의" Then
	        Form.ShowAlert( "알림" , "이미 동의하셨습니다.")
                Exit Sub
	End If
	
	Form.MsgBox("알림", "해외CFD 안심계좌\n헷지수수료 부과에 동의하시겠습니까?", "BTN_CHANGE_GROUP", 1)
End Sub

