'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "BTN_CHANGE_GROUP" then	
		If sRet == "ok" Then
			DATAMANAGER.RequestTranData("obtre_acnt_102a") ''해외CFD 안심계좌 헷지수수료 부과 동의
		End If
	end if
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
