						<CELL cell_ly="0,23,2,23" halign="0" line="0,0" caption="[유의사항]" fontsize="-3" fontstyle="01" impidxs="" />
						<CELL cell_ly="0,24,2,24" halign="0" line="0,0" caption="* 2023. 9. 1. 이전에 개설된 해외CFD 안심계좌는 헷지수수료 부과에 " fontsize="-4" impidxs="" />
						<CELL cell_ly="0,25,2,25" halign="0" line="0,0" caption="   동의하지 않은 경우, 헷지수수료가 부과되지 않고 신규 주문이" fontsize="-4" impidxs="" />
						<CELL cell_ly="0,26,2,26" halign="0" line="0,0" caption="   제한되나, 본 동의서에 동의함으로써 신규 주문이 가능합니다." fontsize="-4" impidxs="" />
						<CELL cell_ly="0,27,2,27" halign="0" line="0,0" caption="* 헷지수수료는 기존 체결잔고의 경우 동의일부터, 동의 후 신규 거래" fontsize="-4" impidxs="" />
						<CELL cell_ly="0,28,2,28" halign="0" line="0,0" caption="   잔고의 경우 체결일 장마감 후부터 산출하며, 산출일로부터" fontsize="-4" impidxs="" />
						<CELL cell_ly="0,29,2,29" halign="0" line="0,0" caption="   2영업일 후 해당 국가 통화로 출금됩니다." fontsize="-4" impidxs="" />
						<CELL cell_ly="0,30,2,30" halign="0" line="0,0" caption="* 헷지수수료 산출 시간은 아시아 17:25, 미국 08:10 입니다. 따라서" fontsize="-4" impidxs="" />
						<CELL cell_ly="0,31,2,31" halign="0" line="0,0" caption="   해당 국가 헷지수수료 산출 시간 이전까지 해외CFD 체결잔고의" fontsize="-4" impidxs="" />
						<CELL cell_ly="0,32,2,32" halign="0" line="0,0" caption="   월정산 기준 매입금액 전체를 외화예수금으로 충족하셔야 당일" fontsize="-4" impidxs="" />
