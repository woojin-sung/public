						<CELL cell_ly="0,2,2,2" fgcolor="006:213049051" halign="0" line="0,0" caption="안심계좌로써 헷지수수료 부과에 동의하시는 경우 유의사항을" fontsize="-4" impidxs="" />
						<CELL cell_ly="0,3,2,3" fgcolor="006:213049051" halign="0" line="0,0" caption="확인하신 후에 동의절차를 진행하여 주시기 바랍니다." fontsize="-4" impidxs="" />
						<CELL cell_ly="0,4,2,4" fgcolor="006:213049051" halign="0" line="0,0" caption="아래 내용에 동의하더라도 해외CFD 체결잔고의 월정산 기준 매입" fontsize="-4" impidxs="" />
						<CELL cell_ly="0,5,2,5" fgcolor="006:213049051" halign="0" line="0,0" caption="금액 전체를 해외CFD 계좌의 국가별 통화 예수금(이하 '외화예수금'" fontsize="-4" impidxs="" />
