	<SCRIPT_INFO _len="2257" _ulen="2049" >
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'============================================================================
Sub Button0_OnClick()
	Save_Select()
	Form.triggerEvent( "#", "NextStep", "1" )
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	'접근범위 세팅
	scope = Form.GetSharedData("&MYDATA_SCOPE", false )
	if scope ="invest.account" then
		LblScope.caption = "계좌목록, 계좌정보 등"
	else
		LblScope.caption =  "계좌목록"
	end if
	
	'정기전송 여부 세팅
	scheduled = Form.GetSharedData("&MYDATA_IS_SCHEDULED", false )
	if scheduled = "true" then
		Chk1Y.checkstate = 1
	else
		Chk1N.checkstate = 1
	end if
	
	'종료시점 - 일단 1년으로
	
	
	Button0.enable = False
End Sub

'============================================================================
Function Save_Select()
	Form.SetSharedData("&MYDATA_PURPOSE"		, "본인신용정보 통합조회" )	'전송목적
	ndate = Form.GetSharedData("&HOST_DATE"  , false)
	end_date = Int(ndate)+10000 									'당일 1년후
	Form.SetSharedData("&MYDATA_END_DATE"	 , end_date )				'전송종료일자
	Form.SetSharedData("&MYDATA_HOLDING_PERIOD", "99991231" )			'전송요구기간
	Form.SetSharedData("&MYDATA_IS_CONSENT_TRANS_MEMO", " " )			'적요전송요구여부
	Form.SetSharedData("&MYDATA_IS_CONSENT_MERCHANT_NAME", " " )		'가맹점명전송요구여부
	Form.SetSharedData("&MYDATA_IS_CONSENT_TRANS_CATEGORY", " " )		'상품분류전송요구여부
'	Form.SetSharedData("&MYDATA_REQ_DATETIME", " " )					'인가코드 발급요청 일자
End Function 

'============================================================================
Sub RdoYn_OnClick(nIndex)
	if nIndex = 1 then
		RdoMonth.enable = false
		RdoMonth.currentindex = -1
	else 
		RdoMonth.enable = true
	end if
End Sub

'============================================================================
Sub ChkAgree_OnChange(sCheckState)
	if sCheckState = "1" then
		Button0.enable = True
	else
		Button0.enable = False
	end if
End Sub

