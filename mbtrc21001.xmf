'============================================================================
' 01. 화 면 명 : CFD 반대매매 내역
' 02. 화면설명 : CFD 반대매매 내역
' 03. 작    성 : 2021. 07. 19. KSJ
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szItemCode	'종목코드
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' 구분에 따른 서비스 ID 얻기
'============================================================================
Function f_GetTranID()    
	Dim szGetTranID 
    If rdoKind.currentindex == 0 or rdoKind.currentindex == "0" Then
	    szGetTranID = "obtrc_brng_112r"	' 종목별
    Else
	    szGetTranID = "obtrc_brng_113r"	' 차입상세
    End If     
    
    return szGetTranID
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Sub Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_szItemCode = ""
	ItemCode0.code = "empty"
	
	grd0.SetClear()
	grd1.SetClear()
	DATAMANAGER.RequestTranData( f_GetTranID() )
End Sub
'============================================================================
' acnt0_ChangeAccount()
'============================================================================
Sub acnt0_ChangeAccount()
	grd0.SetClear()
	grd1.SetClear()
	DATAMANAGER.RequestTranData( f_GetTranID() )
End Sub

'============================================================================
' Form_OnCommonDialogReturn()
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	grd0.SetClear()
	grd1.SetClear()
	if sReturn1 <> "" then
		g_szItemCode = sReturn1
		DATAMANAGER.RequestTranData( f_GetTranID() )
	end if
End Sub

'============================================================================
' btnAll_OnClick() : 종목전체조회
'============================================================================
Sub btnAll_OnClick()
	g_szItemCode = ""
	ItemCode0.code = "empty"

	grd0.SetClear()
	grd1.SetClear()
	DATAMANAGER.RequestTranData( f_GetTranID() )
End Sub

'============================================================================
' rdoKind_OnClick() : 잔고조회구분 변경
'============================================================================
Sub rdoKind_OnClick(nIndex)
	' 잔고조회구분 : 종목별
	If nIndex = 0 Then
	    grd0.visible = True
	    grd1.visible = False
	' 잔고조회구분 : 차입상세
	Else 
	    grd0.visible = False
	    grd1.visible = True	    
	End If
	
	'조회구분 변경시 재조회	
	grd0.SetClear()
	grd1.SetClear()
	DATAMANAGER.RequestTranData( f_GetTranID() )
End Sub

'============================================================================
' grd0_OnClickUp() : 종목조회
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szISCD 
	szISCD = grd0.GetCellData( "bd_cell0", lRow )
	
	if szISCD ~= "" and szISCD ~= null and len(szISCD) > 0 Then
		
		if mid(szISCD,1,1) == "A" Then
		    szISCD =  mid(szISCD,2,len(szISCD))
		end if
		g_szItemCode = szISCD
		ItemCode0.code = g_szItemCode
		
		grd0.SetClear()
		DATAMANAGER.RequestTranData( "obtrc_brng_112r" )
	end if
End Sub

'============================================================================
' grd0_OnScrollEnd() : NextData 조회
'============================================================================
Sub grd0_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData("obtrc_brng_112r") == True Then
		DATAMANAGER.RequestNextData( "obtrc_brng_112r" )
	End If
End Sub

'============================================================================
' grd1_OnScrollEnd() : NextData 조회
'============================================================================
Sub grd1_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData("obtrc_brng_113r") == True Then
		DATAMANAGER.RequestNextData("obtrc_brng_113r")
	End If
End Sub
'============================================================================
' btnRefresh_OnClick()
'============================================================================
Sub btnRefresh_OnClick()
	grd0.SetClear()
	grd1.SetClear()
	DATAMANAGER.RequestTranData( f_GetTranID() )
End Sub
'============================================================================
' Form_OnRefresh()
'============================================================================
Sub Form_OnRefresh()
	grd0.SetClear()
	grd1.SetClear()
	DATAMANAGER.RequestTranData( f_GetTranID() )
End Sub


'****************************************************************************
'				     	D A T A M A N A G E R
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore()
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	Dim szISCD, szMarketType
	szISCD = ""
	szMarketType = Form.GetItemCodeInfo(ItemCode0.code, "market")
	
	If g_szItemCode ~= "" and g_szItemCode ~= null and len(g_szItemCode) > 0 Then
	    if szMarketType = "J" Then
		    szISCD = "A" + ItemCode0.code	
	    else 
		    szISCD = ItemCode0.code	
	    End if
	End if
	
	If szTranID == "obtrc_brng_112r" or szTranID == "obtrc_brng_113r" Then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , 	acnt0.total)'Left(cmb0.caption , 8))		'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , 	acnt0.sequence)'Right(cmb0.caption , 2))	'계좌일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" , 0 ,	"")									'계좌비밀번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISCD" , 0 , 	szISCD)								'종목코드
	End If
End Sub


