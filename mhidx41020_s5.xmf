'============================================================================
'============================================================================
' 화 면 명 : MY종목뉴스_관심종목뉴스(mhnws44070_t2.xmf)
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'- 관심_환경설정 관련 -------------------------------------------------------
Dim g_tGSelect
Dim g_tGDefault
Dim g_tKey
Dim g_tNm

g_tGSelect = {}
g_tDefault = {"GW_WATCHING"}
g_tKey     = {"AA"}
g_tNm      = {"Watching종목"}
' ---------------------------------------------------------------------------

' 20160404 앱 최초 등록확인(그룹 없음) ->편집 활성화
Dim g_szAppFirst
g_szAppFirst = "NO"
Dim g_szGSID

Dim g_szUserID
Dim g_szCust

g_szUserID = ""
g_szCust = ""

Dim g_nCurTab		'20230824 HSZ

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	'20230414 HSZ START : 로그인 ID 비교로직 추가
	szLoginID = Form.GetSharedData("&USER_ID", false)
	Form.SetSharedData("41020_s5_LoginID" , szLoginID)
	'20230414 HSZ END
	Label2.fgcolor = 334
	
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 10) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	
	'0807 JJH deletepage -> insertpage로 수정
	'------------------------------------------------------------------------------------------
	Dim nCurTab
	nCurTab = Form.GetSharedData( "MY_NEWS", false  )
	if nCurTab == "" then
		nCurTab = 0
	end if
	
	DIm szRecentTab, szHoldTab
	
	szRecentTab = Form.LoadConfigData("GW_SET2", "RECENT")
	szHoldTab = Form.LoadConfigData("GW_SET2", "HOLD")
	'0808 설정값 없을 때 예외처리 추가
	if szRecentTab == "1" or szRecentTab == "" then
		FormTab0.insertPage( FormTab0.tabcount, "page1", "page1", "mhidx41020_s9", "0", "최근")
	end if
	if szHoldTab == "1" or szHoldTab == "" then
		FormTab0.insertPage( FormTab0.tabcount, "page2", "page2", "mhidx41020_s9", "0", "보유")
	end if
	FormTab0.insertPage( FormTab0.tabcount, "page3", "page3", "mhidx41020_s9", "0", "관심")
	
	if CInt(FormTab0.tabcount) - 1 < CInt(nCurTab) then
		nCurTab = 0
	end if
	
	'20230824 HSZ START
	g_nCurTab = nCurTab
	Form.SetTimerEvent(1, 1, 1)
	'20230824 HSZ END
	'------------------------------------------------------------------------------------------
	Call f_init()
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "refresh" then
		Call f_init()
	end if
		
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if Trim(g_szUserID) = "" then
		Exit Sub
	end if
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_USER_ID",			0, g_szUserID)

	end If

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
		If DATAMANAGER.GetDataCount(0, "ohhts_intr_006r" , "OutBlock1") < 1 Then
			imgGrp.visible = false
			lblGroupNm.visible = false
			
			if FormTab0.currenttabpageid == "page3" then
				Form.triggerEvent( "FormTab0."..FormTab0.currenttabpageid, "REQUEST_DATA", "NoGroup"  )
			end if
		End If
		
		grdGroup.setCellMaxLineCount("bd_name", 2)
			
		Call Insert_cmbGroup()		' 관심그룹을 그룹콤보에 넣기
		
		g_szAppFirst = "YES"
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Form.ShowAlert("알림", "[" & szErrCode & "]" & szErrMsg, true)
	
	DATAMANAGER.ClearInputData(0, szTranID)
End Sub

'============================================================================
' 관심그룹
'============================================================================
Sub cmbGroup_OnEditComplete(iIndex)
	lblGroupNm.caption = cmbGroup.caption
	lblGroupNm.setmaxlinecount(2)
	
	if FormTab0.currenttabpageid == "page3" then
		' 선택되어 있는 그룹의 키를 저장한다. 화면 다시 오픈시 적용
		Form.SetEnvData("1", "SELECT_GWGROUP" , cmbGroup.cbkeydata)
		
		imgGrp.visible = true
		lblGroupNm.visible = true
	end if
	
	f_SendTrigger()
	
End Sub

'============================================================================
' 그룹명 label
'============================================================================


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' 화면 초기화
'============================================================================
Function f_init()
	g_szUserID = Form.GetSharedData("&USER_ID", false)
	g_szCust = Form.GetSharedData("&CUST_NUM", false)

	'0807 JJH "ohhts_intr_006r" 서비스 시작위치 변경
	' ----------------------------------------------------------
	if FormTab0.currenttabpageid == "page3" then
		init_GWGroup()
	else
		f_SendTrigger()
	end if
	' ----------------------------------------------------------
End Function

'============================================================================
' 관심그룹 재설정 (로컬/서버)
'============================================================================
Function init_GWGroup()
	grdGroup.rowcount = 0
	DATAMANAGER.RequestTranData("ohhts_intr_006r")

End Function

'============================================================================
' 관심그룹을 그룹콤보에 넣기
'============================================================================
Function Insert_cmbGroup()
	Dim szgrpList, szKey, szNm, szSave
	Dim nRow, nIdx, nSelect

	' 콤보 리스트 클리어
	Form.SetCtlProp("cmbGroup", "clear", "")
	
	nRow 		= grdGroup.rowcount
	nIdx 		= -1
	nSelect 		= -1
	szgrpList	= ""
	
	' 최종 선택(저장)된 관심그룹 키
	szSave = Form.GetEnvData("SELECT_GWGROUP")
	if szSave == "" or szSave == null then
		szSave = "000"
	end if
	
'	' ---- 관심_환경설정에서 가져온 관심그룹 추가 여부 Start ----------------
'	For i = 0 to #g_tDefault - 1
'		g_tGSelect[i] = Form.GetEnvData(g_tDefault[i])
'		
'		if g_tGSelect[i] == "" then
'			g_tGSelect[i] = "1"
'		end if
'		
'		' 해당그룹 Show시
'		if g_tGSelect[i] == "1" then
'		
'			if i == 0 then
'				szgrpList	= g_tKey[i] & "`" & g_tNm[i]
'				nIdx			= 0
'			else
'				if szgrpList == "" then
'					szgrpList = g_tKey[i] & "`" & g_tNm[i]
'				else
'					szgrpList = szgrpList & "\r\n" & g_tKey[i] & "`" & g_tNm[i]
'				end if
'				
'				if nIdx >= 0 then
'					nIdx = nIdx + 1
'				else
'					nIdx = 0
'				end if
'				
'			end if
'			
'			if szSave == g_tKey[i] then
'				nSelect = nIdx
'			end if
'
'			' 선택된 그룹을 삭제하였을경우의 예외처리
'			if i == nRow -1 then
'			
'				if nSelect < 0 then
'					nSelect = 0
'				end if
'				
'			end if
'			
'		end if
'		
'	NEXT
'	' ---- 관심 환경설정에서 가져온 관심그룹 추가 여부 End ------------------

	' ---- 관심종목 그룹 리스트 존재시 Start --------------------------------
	if Int(nRow) > 0 then
'		g_szAppFirst = "NO"
		
		For i = 0 to nRow -1
			szKey = grdGroup.GetCellData("bd_code", i)
			szNm  = grdGroup.GetCellData("bd_name", i)

			if szgrpList == "" then
				szgrpList = szKey & "`" & szNm
			else
				szgrpList = szgrpList & "\r\n" & szKey & "`" & szNm
			end if
			
			if nIdx >= 0 then
				nIdx = nIdx + 1
			else
				nIdx = 0
			end if
			
			if szSave == szKey then
				nSelect = nIdx
			end if
			
			' 선택된 그룹을 삭제하였을경우의 예외처리
			if i == nRow -1 then
				if nSelect < 0 then
					nSelect = 0
				end if
			end if
		Next
	else
'		g_szAppFirst = "YES"
		f_SendTrigger()
	end if
	' ---- 관심종목 그룹 리스트 존재시 End ----------------------------------
	' 관심그룹콤보에 리스트 init		
	cmbGroup.cbinputdatatext = szgrpList

	' 관심그룹콤보에서 최종 저장된 그룹 선택
	If CStr(nSelect) == "-1" or szSave == "CC" or szSave == "BB" Then	'없거나 보유종목인 경우
		nSelect = 0	'MY관심종목 뉴스에서는 첫 관심그룹으로 세팅 - 2302 HSZ 업혁 박효정 과장님 요건
	End If
	
	if cmbGroup.caption <> ""  then
		cmbGroup.currentindex = CStr(nSelect)	
	end if
End Function


'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	Form.SetSharedData( "MY_NEWS" , FormTab0.currenttab)
	
	if FormTab0.currenttabpageid <> "page3" then
		imgGrp.visible = false
		lblGroupNm.visible = false
		
		'0807 JJH "ohhts_intr_006r" 서비스 시작위치 변경
		'------------------------------------------------------------------------------------------
		f_SendTrigger()
	else
		if cmbGroup.caption == "" or cmbGroup.caption == null then 
			if g_szAppFirst == "NO" then
				Call init_GWGroup()
			end if
			Exit Sub
		end if
		imgGrp.visible = true
		lblGroupNm.visible = true
	end if
	'------------------------------------------------------------------------------------------
End Sub

'============================================================================
Sub lbl0_OnClick()
	Form.triggerEvent("#", "HOME_SCROLL", "")
	
	if FormTab0.currenttabpageid == "page1" then
		Form.SetEnvData("1", "SELECT_GWGROUP" , "BB")
	elseif FormTab0.currenttabpageid == "page2" then
		Form.SetEnvData("1", "SELECT_GWGROUP" , "CC")
	elseif FormTab0.currenttabpageid == "page3" then
		Form.SetEnvData("1", "SELECT_GWGROUP" , cmbGroup.cbkeydata)
	end if
	
	if FormTab0.currenttabpageid == "page2" then
		Form.OpenScreen("44070" , "HOME★1")
	else
		Form.OpenScreen("44070" , "HOME★0")
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	Call f_init()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	imgGrp.setMaintainingRatio("1")
	Image0.setMaintainingRatio("1")
End Sub


'============================================================================
Sub imgGrp_OnClick()
	'종목편집 창에서 Env가 바뀌는 것때문에 현재 선택 그룹키 값을 저장
	Form.SetSharedData("PresentSelectKey", cmbGroup.cbkeydata)
	
	cmbGroup.openlist()
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if	sKey	=	"&LOGIN"	then				'로그인 후 보유종목/관심그룹 재조회
		if	sValue	=	"login"	then
			'20230414 HSZ START : 로그인 ID 비교로직 추가
			szBeforeID = Trim(Form.GetSharedData("41020_s5_LoginID", false ))
			szAfterID = Trim(Form.GetSharedData("&USER_ID", false))

			if szBeforeID <> szAfterID then
				Form.triggerEvent( "FormTab0.page2", "Login", szAfterID  )
				Form.triggerEvent( "FormTab0.page3", "Login", szAfterID  )
				Call f_init()
				f_SendTrigger()
				
				Form.SetSharedData("41020_s5_LoginID" , szAfterID)
			end if
			'20230414 HSZ END	
		end	if
	end	if
End Sub
'============================================================================
Function f_SendTrigger()
	if FormTab0.currenttabpageid == "page3" then
		g_szGSID = cmbGroup.cbkeydata
	elseif FormTab0.currenttabpageid == "page2" then
		g_szGSID = "CC"
	elseif FormTab0.currenttabpageid == "page1" then
		g_szGSID = "BB"
	end if
	
	Form.triggerEvent( "FormTab0."..FormTab0.currenttabpageid, "REQUEST_DATA", g_szGSID  )
end Function


'============================================================================
' 그룹명 label
'============================================================================
Sub lblGroupNm_OnClick()
	'종목편집 창에서 Env가 바뀌는 것때문에 현재 선택 그룹키 값을 저장
	Form.SetSharedData("PresentSelectKey", cmbGroup.cbkeydata)
	
	cmbGroup.openlist()
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	'20230824 HSZ START: iOS 최근조회 로드 후 해외마스터파일 못읽는 현상 조치
	Form.SetTimerEvent(1, 0, 1)
	FormTab0.currenttab = g_nCurTab
	FormTab0.callTabChanged()
	'20230824 HSZ END
End Sub

