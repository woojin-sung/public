'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : CME 야간거래 신청/해지
' 02. 화면설명 : CME 야간거래 약정을 신청 해지하는 화면
' 03. 작    성 : 2017.05.24 김동구
' 04. 수    정 : 2019.05.28 장원혁 v0001 비밀번호 입력 오류 수정
' 2020.04.13 : 정민영 : v0002 : [T2004090004] 약정파일 추가
' 2020.09.18 : 정민영 : v0003 : [T2008250015] 메모리취약점 보완
' 2021.05.22 : 정민영 : v0004 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obpds_srvc_045a IO변경분 적용
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_Srno '서비스약정일련번호
Dim g_Accept
Dim g_Csno
Dim g_szAccountNumber	'계좌번호 (8자리)
Dim g_szAccountSerialNumber '계좌일련번호(2자리)
Dim g_szAccountPassword	'계좌비밀번호
Dim g_YoN
Dim g_ServerMode  		'v0002
Dim g_plain_rm 			'v0003 메모리평문적용여부
Dim g_pwdLen				'v0003 비밀번호자릿수(Lx)


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Sub Form_OnFormInit()
    g_ServerMode = Form.GetSharedData("&SERVER_MODE", False)  'v0002
    
	'v0003 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)

    SetRequestData()
End Sub

'===========================================================================
' 조회함수
'===========================================================================
Function SetRequestData()
	SetControlViewClear()
	DATAMANAGER.RequestTranData( "obpds_srvc_070r" ) '약정고객정보 조회
End Function

Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obpds_srvc_070r" then
		g_Csno = DATAMANAGER.GetDataValue( 0, "obpds_srvc_070r", "OutBlock1", "CSNO", 0 )
		DATAMANAGER.RequestTranData( "obpds_srvc_069r"	)
	End If
	
    If szTranID = "obpds_srvc_069r" then
'	    if DATAMANAGER.GetDataValue( 0, "obpds_srvc_069r", "OutBlock1", "SVC_SRNO", 0 ) = "" then
'		    g_Srno = 1
'   	    else
'		    g_Srno = DATAMANAGER.GetDataValue( 0, "obpds_srvc_069r", "OutBlock1", "SVC_SRNO", 0 )
'	    end if
	    
	    'DATAMANAGER.RequestTranData( "obpds_srvc_068r" )
		Dim nCnt
		Dim nAcc_cnt
		nCnt = DATAMANAGER.GetDataCount( 0, "obpds_srvc_069r", "OutBlock1" )
		nAcc_cnt = 0
		
		if nCnt > 0 then
'			Dim sMoASNO, ASNO
'			sMoASNO = Right(g_sAcc, 2)
			'Form.MsgBox( "알림", g_szAccountSerialNumber, "", 6 )	
			for i = 0 to nCnt-1 
				ASNO = DATAMANAGER.GetDataValue( 0, "obpds_srvc_069r", "OutBlock1", "ASNO" , i )
				
				if g_szAccountSerialNumber == ASNO then
					g_Srno = DATAMANAGER.GetDataValue( 0, "obpds_srvc_069r", "OutBlock1", "SVC_SRNO" , i )
					tblState.SetCellString( 0, 1, "신청" )
					ChkView0.Visible     = "0"  'v0002
					ChkView0.Enabled     = "0"  'v0002
					ButtonView00.Visible = "0"  'v0002
					ButtonView00.Enabled = "0"  'v0002
					ButtonView0.Visible  = "0"  'v0002
					ButtonView0.Enabled  = "0"  'v0002
					
					btnEnroll.Visible = "0"
					btnCancel.Visible = "1"
					btnEnroll.Enabled = "0"
					btnCancel.Enabled = "1"					
					nAcc_cnt = nAcc_cnt + 1
					Exit For
				end if
			next
		end if
		
		if tblState.GetCellString( 0, 1 ) ~= "신청" or nCnt = 0 or nAcc_cnt = 0 then
			g_Srno = 1
			tblState.SetCellString( 0, 1, "미신청" )
			ChkView0.Visible     = "1"  'v0002
			ChkView0.Enabled     = "1"  'v0002
			ButtonView00.Visible = "1"  'v0002
			ButtonView00.Enabled = "1"  'v0002
			ButtonView0.Visible  = "1"  'v0002
			ButtonView0.Enabled  = "1"  'v0002
					
			btnEnroll.Visible = "1"
			btnCancel.Visible = "0"	
			btnEnroll.Enabled = "1"
			btnCancel.Enabled = "0"
		end if
		
    End if	
    
'    If szTranID = "obpds_srvc_068r" then
'        For i = 0 to DATAMANAGER.GetDataCount( 0, "obpds_srvc_068r", "OutBlock1" ) -1
'            If DATAMANAGER.GetDataValue( 0, "obpds_srvc_068r", "OutBlock1", "SVCD" , i ) = "075" then			    
'                g_Accept = DATAMANAGER.GetDataValue( 0, "obpds_srvc_068r", "OutBlock1", "STPL_YN" , i )
'			        'Form.MsgBox( "알림", g_Accept , "", 6 ) 		
'			  If g_Accept = "1" then
'			      tblState.SetCellString( 0, 1, "신청" )
'
'					btnEnroll.Visible = "0"
'					btnCancel.Visible = "1"
'					btnEnroll.Enabled = "0"
'					btnCancel.Enabled = "1"		
'
'                ElseIf g_Accept = "0" then
'                    tblState.SetCellString( 0, 1, "미신청" )
'					btnEnroll.Visible = "1"
'					btnCancel.Visible = "0"	
'					btnEnroll.Enabled = "1"
'					btnCancel.Enabled = "0"				    
'				End if		    
'            End if
'	    Next
'    End if
	
    if szTranID = "obpds_srvc_045a" then
		SetControlViewClear()    
	    If g_YoN = "D" then
		    Form.MsgBox( "알림", "CME 야간거래 신청이 해지 되었습니다." , "", 6 )
		    ChkView0.chksilence = "0"  'v0002
	    ElseIf g_YoN = "I" then
		    Form.MsgBox( "알림", "CME 야간거래 신청이 등록 되었습니다." , "", 6)
	    End if
	    DATAMANAGER.RequestTranData( "obpds_srvc_069r" )
    End if
    
End Sub

