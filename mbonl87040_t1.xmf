'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    If szTranID = "obpds_srvc_070r" then
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_070r", "InBlock1", "ACNO" , 0 , g_szAccountNumber )
    End if
    
    If szTranID = "obpds_srvc_069r" then
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_069r", "InBlock1", "ACNO" , 0 , g_szAccountNumber )    
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_069r", "InBlock1", "CSNO" , 0 , g_Csno )
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_069r", "InBlock1", "SVCD" , 0 , "075" )
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_069r", "InBlock1", "PROS_CLS_CODE" , 0 , "0" )
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_069r", "InBlock1", "STPL_STAT_CLS_CODE" , 0 , "01" )
    End if
    
    If szTranID = "obpds_srvc_045a" then
    '고객번호, 계좌번호, 일련번호, 비밀번호 매핑해줘야함.
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE" , 0 , g_YoN ) '처리구분코드
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "SVCD" , 0 , "075" ) 'HTS불원 서비스 코드	    
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "SVC_MANG_UNIT_CODE" , 0 , "02" ) '서비스 관리 단위 코드
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "ACNO" , 0 , g_szAccountNumber ) '계좌번호
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "ASNO" , 0 , g_szAccountSerialNumber )	'계좌일련번호
	
	    'v0003 메모리평문적용시 암호화된 정보로 넘어옴
	    if g_plain_rm == "1" then
		    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "ACNT_PWD" , 0 , g_szAccountPassword )	'비밀번호
		else
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "ACNT_PWD" , 0 , Form.GetEncData(g_szAccountPassword) )	'비밀번호 v0001
	    end if
	    
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "ELFN_ID" , 0 , Form.GetSharedData("&USER_ID", false ) ) 'HTS ID
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "CSNO" , 0 , g_Csno ) '고객번호
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "SVC_SRNO" , 0 , g_Srno )
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
    End if
       
    If szTranID = "obpds_srvc_068r" then
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_068r", "InBlock1", "ACNO" , 0 , g_szAccountNumber ) '계좌번호
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_068r", "InBlock1", "ASNO" , 0 , g_szAccountSerialNumber )	'계좌일련번호       
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_068r", "InBlock1", "CSNO" , 0 , g_Csno )    
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_068r", "InBlock1", "SVCNM" , 0 , "075" )
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_068r", "InBlock1", "PROS_CLS_CODE" , 0 , "0" )
    End if  	
End Sub

'============================================================================
' btnEnroll_OnClick - 신청
'============================================================================
Sub btnEnroll_OnClick()
	g_YoN = "I"

	Dim szData
	
	if g_szAccountPassword == "" or Form.GetCtlProp( "#EditPW", "caption") == "" then
		Form.MsgBox("알림", "계좌 비밀번호를 입력하세요", "", 0)
		exit sub
	else
		szData = "87040_t1" & "★" & g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & g_szAccountPassword & "★" & "075"
	     'v0003 메모리평문적용시 가장마지막에 비밀번호자릿수 넘겨줌
	     '      g_szAccountPassword값은 메모리평문 적용여부에 따라 암호화/미암호화된 정보로 넘어감
	     'v0003 CMA계좌전환신청에 따른 투자성향진단 오픈시, 비밀번호 컨트롤설정이 없으므로 자릿수 설정 주석처리함
		'if g_plain_rm == "1" then
		'	szData = Trim(szData) & "★" & g_pwdLen 
		'end if
	end if

	'v0002
	if ChkView0.chksilence == "0" then
		Form.MsgBox( "알림", "글로벌거래의 수탁에 관한 약정서에 동의하셔야 합니다.", "", 6 )	
		Exit Sub
	end if

	'고객투자성향
	Form.OpenFramePopup( "mbonl81010_p1" , szData , sPosInfo)
	
	'DATAMANAGER.RequestTranData( "obpds_srvc_045a" )'약정
End Sub


'============================================================================
' btnCancel_OnClick
'============================================================================
Sub btnCancel_OnClick()
	g_YoN = "D"
'	aa = Form.GetCtlProp( "#EditPW", "caption")
'	Form.MsgBox("알림", g_szAccountPassword, "", 6)
'	Form.MsgBox("알림aa", aa, "", 6)	
	if g_szAccountPassword == "" or Form.GetCtlProp( "#EditPW", "caption") == "" then
		Form.MsgBox("알림", "계좌 비밀번호를 입력하세요.", "", 0)
		exit sub
	end if
	
	'Form.MsgBox("알림", "CME야간거래 약정을 해지하시겠습니까?", "btnCancelOK", 1)
	
	DATAMANAGER.RequestTranData( "obpds_srvc_045a" )'약정
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr

	if szTranID == "obpds_srvc_045a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.MsgBox("알림", szErrMsg.."("..szSubErr..")" , "", 0)
		SetRequestData()
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "KYCCHK_RETURN" then			'투자성향진단 OK면 Y값내려줌
		if sRet == "Y" then
			SetTrans()
		end if
	else
	    if sRet == "글로벌거래의 수탁에 관한 약정서" then  'v0001
			ChkView0.chksilence = "1"
		end if
	end if
End Sub

Function SetTrans()
	DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE" , 0 , "I")
	DATAMANAGER.RequestTranData( "obpds_srvc_045a" )
End Function

Function SetControlViewClear()
	tblState.SetCellString( 0, 1, "" )
End Function


'============================================================================
' v0002 글로벌거래의 수탁에 관한 약정서
'============================================================================
'============================================================================
Sub ButtonView00_OnClick()
	if ButtonView0.enable == "1" then
		ButtonView0_OnClick()
	end if
End Sub
'============================================================================
Sub ButtonView0_OnClick()
	Dim tmpURLheader
	Dim sURL

    If g_ServerMode == "1" Then  '개발기
        tmpURLheader = "http://home.imeritz.com/include/resource/comm/ctcn/pdf_test/"
    Else
        tmpURLheader = "http://home.imeritz.com/include/resource/comm/ctcn/pdf/"
    End If
    sURL = tmpURLheader & "meritz_yk_44.html"
    
 	Form.SetSharedData("OPEN_URL", sURL )
	Form.OpenFramePopup("mbonl82020_p6" , "글로벌거래의 수탁에 관한 약정서" , "") 
End Sub
