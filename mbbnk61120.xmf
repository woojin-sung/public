'============================================================================
Sub Form_OnFormInit()
	'그리드 카드뷰 SET
	Grid0.setUseCardView(true, 10, "input_01_n.9.png")
	'오픈데이터 체크
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		if szOpenData == "3" then
			rdoGubun.currentindex = "0"
		elseif szOpenData == "H" then
			rdoGubun.currentindex = "1"
		end if
	end if
	'데이터조회
	if Account0.total <> "" and Account0.total <> null then
		DATAMANAGER.RequestTranData( "obrts_ccfo_018r" )
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "COMBO_POP" then '비번 입력 팝업
		if sRet <> "" and sRet <> null then
			dim tData
			tData = Split(sRet, "★")
			Form.SetCtlProp(tData(0), "currentindex", tData(1))
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obrts_ccfo_018r" then
		Dim sTR_CLS_CODE
		if CInt(rdoGubun.currentindex) == 0 then
			sTR_CLS_CODE = "003"'당사
		else
			sTR_CLS_CODE = "004"'타사
		end if
		'InBlock1
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0, Account0.total )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO", 0, Account0.sequence )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TR_CLS_CODE", 0, sTR_CLS_CODE )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_STAT_CLS_CODE", 0, Combo0.cbkeydata )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_DATE", 0, Form.GetSharedData("&HOST_DATE", false ))
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrts_ccfo_018r" then
		dim nCnt, nRowCnt
		nCnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
		nRowIdx = CInt(Grid0.rowcount) - nCnt
'		
		if nCnt > 0 then
			lblNoData.visible = false
			for i = 0 to nCnt - 1	
				'왼쪽 컬럼 명 SET
				Grid0.SetCellData("bd_cell9", nRowIdx + i, "입고계좌")
				Grid0.SetCellData("bd_cell10", nRowIdx + i, "종목명")
				Grid0.SetCellData("bd_cell11", nRowIdx + i, "수량")
				Grid0.SetCellData("bd_cell12", nRowIdx + i, "수수료")
				Grid0.SetCellData("bd_cell13", nRowIdx + i, "처리상태")
'				'입고계좌 SET
				dim szBank, szAcnt, szAcntNm
				szBank = Grid0.GetCellData( "bd_bankname", nRowIdx + i )
				szAcnt = Grid0.GetCellData( "bd_acnt", nRowIdx + i )
				szAcntNm = Grid0.GetCellData( "bd_acntnm", nRowIdx + i )
				
				if CInt(rdoGubun.currentindex) == 0 then '당사
					Grid0.SetCellData("bd_acntinfo", nRowIdx + i, szAcnt & " " & szAcntNm )
				else '타사
					Grid0.SetCellData("bd_acntinfo", nRowIdx + i, szBank & " " & szAcnt & " " & szAcntNm )
				end if
				'종목정보 SET
				dim szItemNm, szItemCd
				szItemNm = Grid0.GetCellData( "bd_itemnm", nRowIdx + i )
				szItemCd = Grid0.GetCellData( "bd_itemcd", nRowIdx + i )
				Grid0.SetCellData("bd_iteminfo", nRowIdx + i, szItemNm )
				'처리 결과 SET
				dim szResultCd, szLastCd, szResult, szLast
				szResultCd = Grid0.GetCellData( "bd_resultcd", nRowIdx + i )
				szLastCd = Grid0.GetCellData( "bd_lastcd", nRowIdx + i )
				'처리상태 SET
				if szResultCd == "1" then
					szResult = "완료"
				elseif szResultCd == "2" then
					szResult = "불능"
				elseif szResultCd == "R" then
					szResult = "수신대기중"
				elseif szResultCd == "C" then
					szResult = "취소"
				end if 
				Grid0.SetCellData("bd_result", nRowIdx + i, szResult )
				if szResultCd == "2" then '불능일 때는 빨간색
					Grid0.SetCellFgColor("bd_result", nRowIdx + i, "10")
				else
					Grid0.SetCellFgColor("bd_result", nRowIdx + i, "4")
				end if
				'최종결과 SET
				if szLastCd == "Y" then
					szLast = "완료"
				elseif szLastCd == "N" then
					szLast = "미완료"
				elseif szLastCd == "C" then
					szLast = "취소"
				end if
				'수량 단위 SET
'				dim szMk, szCutCd
'				if(left(szItemCd,1) == "J" and len(szItemCd) == 9) or left(szItemCd,1) == "Q" or left(szItemCd,1) == "F" then
'					szMk = Form.GetItemCodeInfo(szItemCd, "market")
'				else
'					if Left(szItemCd,1) == "A" then
'						szCutCd = Mid(szItemCd,2,Len(szItemCd))
'						szMk = Form.GetItemCodeInfo(szCutCd, "market")
'					else
'						szMk = Form.GetItemCodeInfo(szItemCd, "market")
'					end if
'				end if
'				
'				if szMk == "BN" or szMk == "MM" then
'					Grid0.SetCellData("bd_unit", nRowIdx + i, "천원" )
'				elseif szMk == "J" or szMk == "Q" or szMk == "W" or szMk == "T" then
'					Grid0.SetCellData("bd_unit", nRowIdx + i, "주" )
'				end if
				dim szIssuCd 
				szIssuCd = Grid0.GetCellData( "bd_issu", nRowIdx + i )
				if szIssuCd == "03" then
					Grid0.SetCellData("bd_unit", nRowIdx + i, "천원" )
				else
					Grid0.SetCellData("bd_unit", nRowIdx + i, "주" )
				end if
				
				'처리일자 세팅
				dim szDate, szTime, szDateTime
				szDate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "TR_DATE" , i)
				szTime = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "MNPL_YMDH" , i)
				szDateTime = szDate & szTime
				Grid0.SetCellData("bd_date", nRowIdx + i, szDateTime )
				
				'고정 텍스트 SET
				Grid0.SetCellData("bd_won", nRowIdx + i, "원" )
				Grid0.SetCellData("bd_more", nRowIdx + i, "자세히보기" )
			next
			'다음조회
			dim isNextData '다음 조회 데이터 유무
			isNextData = DATAMANAGER.IsMoreNextData( szTranID )
			if isNextData == true or isNextData == "1" or isNextData == 1 then
				DATAMANAGER.RequestNextData( szTranID )
			else
				'총 건수 SET
				lblTotalCnt.caption = "총 " & CInt(Grid0.rowcount) & "건"
				'개별 상태 건수 SET
				dim szResultCd, nSuc, nFail, nCancel, szStr
				nSucc   = 0 '완료 개수
				nFail   = 0 '불능 개수
				nCancel = 0 '취소 개수
				nLoading = 0 '진행중 개수
				for i=0 to CInt(Grid0.rowcount)-1
					szResultCd = Grid0.GetCellData( "bd_resultcd", i )
					'각 상태별 갯수
					if szResultCd == "1" then 
						nSucc = nSucc + 1
					elseif szResultCd == "2" then '불능
						nFail = nFail + 1
					elseif szResultCd == "C" then '취소
						nCancel = nCancel + 1
					elseif szResultCd == "R" then '진행중
						nLoading = nLoading + 1
					end if
				next
				szStr = "(완료" &  nSucc & "건/" & "진행" & nLoading & "건/불능" &  nFail & "건/취소" & nCancel & "건)"
				lblStateCnt.caption = szStr
			end if 
		else
			'총 건수 SET
			lblTotalCnt.caption = "총 0건"
			lblStateCnt.caption = ""
			lblNoData.visible = true
		end if	
	end if
End Sub

