Sub Combo0_OnEditComplete(iIndex)
	if Account0.total <> "" and Account0.total <> null then
		DATAMANAGER.RequestTranData( "obrts_ccfo_018r" )
	end if
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	if szCellID == "bd_more" then '자세히보기
		dim szAcntInfo, szItemInfo, szItemCd, szQty, szFee, szResult, szLast, szDate, szMang, szIssu
		szAcntInfo = Grid0.GetCellData( "bd_acntinfo", lRow )
		szItemInfo = Grid0.GetCellData( "bd_iteminfo", lRow )
		szItemCd = Grid0.GetCellData( "bd_itemcd", lRow )
		szQty = Grid0.GetCellData( "bd_qty", lRow )
		szFee = Grid0.GetCellData( "bd_fee", lRow )
		szResult = Grid0.GetCellData( "bd_result", lRow )
		szLast = Grid0.GetCellData( "bd_lastcd", lRow )
		szDate = Grid0.GetCellData( "bd_date", lRow )
		szMang = Grid0.GetCellData( "bd_mang", lRow )
		szIssu = Grid0.GetCellData( "bd_issu", lRow )
		dim szSendData
		
		szSendData = szAcntInfo & "★" & szItemInfo & "★" & szItemCd
					& "★" & szQty & "★" & szFee
					& "★" & szResult & "★" & szLast
					& "★" & szDate & "★" & szMang 
					& "★" & szIssu
		'0:입고계좌정보
		'1:종목정보
		'2:종목코드
		'3:수량
		'4:수수료
		'5:처리결과
		'6:최종결과코드
		'7:처리일시
		'8:관리지점명
		'9:종목유형코드
'		Form.OpenPopup("mbbnk61120_p1", szSendData, "")
		Form.OpenFramePopup("mbbnk61120_p1", szSendData, "")
	end if
End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	dim isMore
	isMore = DATAMANAGER.IsMoreNextData( "obrts_ccfo_018r" )
	if isMore == true or isMore == 1 or isMore == "1" then
		DATAMANAGER.RequestNextData( "obrts_ccfo_018r" )
	end if
End Sub

'============================================================================
Sub btnCmb_OnClick()
	dim nWidth, nTop, nLeft, nHeight, szSendData, szLocation, szComboData
	nWidth = 75
	nTop = 63
	nLeft = 294
	nHeight = 32
	
	szLocation = nWidth &"★"& nTop &"★"& nLeft &"★"& nHeight
	szComboData = "전체★완료★불능"
	
	szSendData = szLocation&"♥"&szComboData&"♥"&"Combo0"&"♥"& Combo0.currentindex
	Form.OpenPopup("mhtro16093_p3" , szSendData, "")
End Sub

