'============================================================================
Sub Cont0_ButtonOK_OnClick()
	if f_GetPWCkeck() then
		Exit Sub
	end if

	'동의서 확인 여부 체크
	if Cont0.ChkButton0.checkstate ~= "1" and Cont0.ChkButton1.checkstate ~= "1" then	'16-03-23 YCJ 필수동의서 약관 체크 정민영 대리님 요청
		Form.MsgBox( "알림", "요약동의서 또는 상세동의서 중 한가지는 조회하셔야 합니다", "", 6 )	
		Exit Sub	
	end if	
	
	'동의서 읽음 여부 리턴
	DIm sDocuValue
	if Cont0.ChkButton0.checkstate == "1" and Cont0.ChkButton1.checkstate ==	"1"then
		sDocuValue = 3
	else 
		if Cont0.ChkButton0.checkstate == "1" then
			sDocuValue = 1
		elseif Cont0.ChkButton1.checkstate == "1" then
			sDocuValue = 2
		end if
	end if
	Form.SetSharedData("DOCU_VAL" , sDocuValue)
	
	Dim sSLCT_YN1, sSLCT_YN2, sSLCT_YN3, sRCMS_YN1, sRCMS_YN2, sRCMS_YN3, sRCMS_YN4
	sSLCT_YN1 = Form.GetCtlProp( "#LabelSLCTYN1", "caption" )
	sSLCT_YN2 = Form.GetCtlProp( "#LabelSLCTYN2", "caption" )
	sSLCT_YN3 = Form.GetCtlProp( "#LabelSLCTYN3", "caption" )
	
	sRCMS_YN1 = Form.GetCtlProp( "#LabelRCMSYN1", "caption" )
	sRCMS_YN2 = Form.GetCtlProp( "#LabelRCMSYN2", "caption" )
	sRCMS_YN3 = Form.GetCtlProp( "#LabelRCMSYN3", "caption" )
	sRCMS_YN4 = Form.GetCtlProp( "#LabelRCMSYN4", "caption" )
	
	if Cont0.Rdo0.currentindex ~= f_GetYNState(sSLCT_YN1) or
		Cont0.Rdo1.currentindex ~= f_GetYNState(sSLCT_YN2) or
		Cont0.Rdo2.currentindex ~= f_GetYNState(sSLCT_YN3) or
		Cont0.chk0.chksilence ~= f_GetYNState(sRCMS_YN1) or
		Cont0.chk1.chksilence ~= f_GetYNState(sRCMS_YN2) or
		Cont0.chk2.chksilence ~= f_GetYNState(sRCMS_YN3) or
		Cont0.chk3.chksilence ~= f_GetYNState(sRCMS_YN4) then
		
		Form.SetSharedData("SLCT_YN1" , g_sSLCT_YN1) 
		Form.SetSharedData("SLCT_YN2" , g_sSLCT_YN2) 
		Form.SetSharedData("SLCT_YN3" , g_sSLCT_YN3) 
		
		Form.SetSharedData("RCMS_YN1" , g_sRCMS_YN1)
		Form.SetSharedData("RCMS_YN2" , g_sRCMS_YN2)
		Form.SetSharedData("RCMS_YN3" , g_sRCMS_YN3) 
		Form.SetSharedData("RCMS_YN4" , g_sRCMS_YN4)
		
		Form.triggerEvent( "#", "Request", "page1" )
	else
		Form.MsgBox( "알림", "변경내역이 없습니다.", "", 6 )	
	end if
End Sub

'============================================================================
' 요약동의서 확인
'============================================================================
Sub Cont0_ButtonSum_OnClick()
	Form.triggerEvent( "#", "View", "page1_common_sum" )
End Sub

'============================================================================
' 상세동의서 확인
'============================================================================
Sub Cont0_ButtonDetail_OnClick()
	Form.triggerEvent( "#", "View", "page1_common_detail" )	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName = "Slct_1_2" Then
        'sRet=close/cancel
		If sRet = "close" Then
			g_sSLCT_YN2 = "N"		
			g_sSLCT_YN3 = "N"
			
			g_sRCMS_YN1 = "N"
			g_sRCMS_YN2 = "N"
			g_sRCMS_YN3 = "N"
			g_sRCMS_YN4 = "N"
			Cont0.Rdo2.currentindex = "0"
			Form.SetCtlProp( "Cont0.ChkAll", "enable", false )
			Form.SetCtlProp( "Cont0.ChkAll", "chksilence", false )
			for i = 0 to 3
				Form.SetCtlProp( "Cont0.Chk"..i, "chksilence", false )
				Form.SetCtlProp( "Cont0.Chk"..i, "enable", false )
			next		    
		End If

	ElseIf sKeyName = "Slct_2_1" Then
        'sRet=close/cancel
		If sRet = "close" Then
			g_sSLCT_YN3 = "N"
			
			g_sRCMS_YN1 = "N"
			g_sRCMS_YN2 = "N"
			g_sRCMS_YN3 = "N"
			g_sRCMS_YN4 = "N"
			Form.SetCtlProp( "Cont0.ChkAll", "enable", false )
			Form.SetCtlProp( "Cont0.ChkAll", "chksilence", false )
			for i = 0 to 3
				Form.SetCtlProp( "Cont0.Chk"..i, "chksilence", false )
				Form.SetCtlProp( "Cont0.Chk"..i, "enable", false )
			next	
		End If
	End If	
End Sub

