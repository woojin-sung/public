	<SCRIPT_INFO _len="16327" _ulen="14210" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 개인신용정보이용동의
' 02. 화면설명 : 개인신용정보이용동의_선택동의
' 03. 작    성 : 2016.01.22 김보라
' 04. 수    정 : 2017.11.23 윤유정 : 개인신용정보제공동의서 개편(일부항목 동의>고지로 변경) v0001
'-------------------------------------------------------------------------------------------
'============================================================================
' v0001
' 개인(신용)정보동의서 개선 설명
'============================================================================
'	변경 내용 : 기존 "동의" 항목을 "고지"로 변경 & 각 항목 번호를 숫자>알파벳으로 변경(전 채널 통일)
'	대상 항목 : 1. 필수동의서(공통)
'					1) 수집,이용				>>> "Y"(화면에서 강제 셋팅_초기선택값 2->0으로 변경)
'			   2. 필수동의서(상품별)
'					1) 수집,이용 전체(1~7번)	>>> "Y"
'					2) 업무위탁				>>> "Y"
'					3) 고유식별정보의 처리		>>> "Y"
'			   3. 일괄동의여부
'					1) 업무위탁				>>> NULL(선택값 없이 서비스 호출_초기선택값 2 유지)
'					2) 제공					>>> NULL
'	기타 항목들은 현상 유지
'============================================================================
' 2021.05.21 : 김수진
' 개인(신용)정보동의서 공통 화면 처리
' 2023-01-26 : 양현정 : v0002 선택동의 문자와 전화가 바뀌어있어 수정함..
' 2023-03-15 : 양현정 : v0003 문구팝업추가요청건
'============================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'선택동의
Dim g_sSLCT_YN1 '수집이용
Dim g_sSLCT_YN2 '업무위탁
Dim g_sSLCT_YN3 '제공

'선택동의(연락방식)
Dim g_sRCMS_YN1 '전화   -> v0002 문자
Dim g_sRCMS_YN2 '문자   -> v0002 전화
Dim g_sRCMS_YN3 '이메일
Dim g_sRCMS_YN4 '우편

Dim g_sSLCT_POPUP_CHK	'v0003
Dim g_sSLCT_TabChange	'v0003

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' 동의/미동의 상태값 리턴
'============================================================================
Function f_GetYNState(sState)
	if sState == "Y" then
		return "1" 
	elseif sState == "N" then
		return "0" 
	else
		return "-1" 
	end if
End Function

'============================================================================
' 선택동의서 전체동의
'============================================================================
Function f_SetAllCheck()
	if g_sRCMS_YN1 == "Y" and g_sRCMS_YN2 == "Y" and g_sRCMS_YN3 == "Y" and g_sRCMS_YN4 == "Y" then
		Cont0.ChkAll.chksilence = "1"
	else
		Cont0.ChkAll.chksilence = "0"
	end if
End Function

'===========================================================================
' 계좌비밀번호 입력체크함수
'===========================================================================
Function f_GetPWCkeck()
	Dim sACNT_PWD 
	sACNT_PWD = Form.GetCtlProp( "#EditPW", "caption" )
	
	if sACNT_PWD == null or sACNT_PWD == "" then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	end if
	
	return false
End Function	

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "TabChange" then
		g_sSLCT_TabChange = "1"
		
		g_sSLCT_YN1 = Form.GetCtlProp( "#LabelSLCTYN1", "caption" )
		g_sSLCT_YN2 = Form.GetCtlProp( "#LabelSLCTYN2", "caption" )
		g_sSLCT_YN3 = Form.GetCtlProp( "#LabelSLCTYN3", "caption" )
		
		g_sRCMS_YN1 = Form.GetCtlProp( "#LabelRCMSYN1", "caption" )
		g_sRCMS_YN2 = Form.GetCtlProp( "#LabelRCMSYN2", "caption" )
		g_sRCMS_YN3 = Form.GetCtlProp( "#LabelRCMSYN3", "caption" )
		g_sRCMS_YN4 = Form.GetCtlProp( "#LabelRCMSYN4", "caption" )
	
		Cont0.Rdo0.currentindex = f_GetYNState(g_sSLCT_YN1)
		Cont0.Rdo1.currentindex = f_GetYNState(g_sSLCT_YN2)
		Cont0.Rdo2.currentindex = f_GetYNState(g_sSLCT_YN3)
		
		Cont0.chk0.chksilence = f_GetYNState(g_sRCMS_YN1)
		Cont0.chk1.chksilence = f_GetYNState(g_sRCMS_YN2)
		Cont0.chk2.chksilence = f_GetYNState(g_sRCMS_YN3)		
		Cont0.chk3.chksilence = f_GetYNState(g_sRCMS_YN4)
		
		f_SetAllCheck()
		
		g_sSLCT_TabChange = "0"
	elseif sEventName == "View" then
		Dim sTemp
		sTemp = Split(sParam, ";")	
		
		if sTemp[0] == "ok" then
			if sTemp[1] == "page1_common_sum" then
				Cont0.ChkButton0.checkstate = "1"
			elseif sTemp[1] == "page1_common_detail" then
				Cont0.ChkButton1.checkstate = "1"
			end if	
		else
			if sTemp[1] == "page1_common_sum" then
				Cont0.ChkButton0.checkstate = ".0"
			elseif sTemp[1] == "page1_common_detail" then
				Cont0.ChkButton1.checkstate = "0"
			end if	
		end if
	end if
End Sub



'============================================================================
' 선택동의서 전체동의체크
'============================================================================
Sub Cont0_ChkAll_OnChange(sCheckState)
	Dim sState
	
	if sCheckState == "1" then

		'v0003
		if trim(g_sSLCT_TabChange) <> "1" then
			'동의할 경우, 개인신용정보 동의 필수
			If g_sSLCT_YN2 <> "Y" Then
				Form.ShowAlert("안내", "채널 수신 동의를 위해서는\n수집·이용 동의가 필요합니다.")
				Exit Sub
			End If
	
			'동의할 경우, 상품·서비스 안내 수신동의 동의 필수
			If g_sSLCT_YN3 <> "Y" Then
				Form.ShowAlert("안내", "채널 수신 동의를 위해서는\n상품·서비스 안내 수신 동의가 필요합니다.")
				Exit Sub
			End If
		end if		

	
		sState = "1"
	
		g_sRCMS_YN1 = "Y"
		g_sRCMS_YN2 = "Y"
		g_sRCMS_YN3 = "Y"
		g_sRCMS_YN4 = "Y"
	else
		sState = "0"
		
		g_sRCMS_YN1 = "N"
		g_sRCMS_YN2 = "N"
		g_sRCMS_YN3 = "N"
		g_sRCMS_YN4 = "N"
	end if
	
	for i = 0 to 3
		Form.SetCtlProp( "Cont0.Chk"..i, "chksilence", sState )
	next
End Sub

'============================================================================
' 수집이용 관련사항
'============================================================================
Sub Cont0_Rdo0_OnClick(nIndex)
	if nIndex == 1 then
		g_sSLCT_YN1 = "Y"
	else		
		g_sSLCT_YN1 = "N"
	end if
End Sub

'============================================================================
Sub Cont0_Rdo1_OnClick(nIndex)
	if nIndex == 1 then
		g_sSLCT_YN2 = "Y"
	else
		'v0003
		if trim(g_sSLCT_TabChange) <> "1" then
			if g_sSLCT_YN3 = "Y" then
				g_sSLCT_POPUP_CHK = "1"
				Form.MsgBox("안내", "수집·이용 미동의시,\n상품·서비스 안내 수신동의 및\n동의 채널도 미동의 됩니다.\n\n미동의 하시겠습니까?", "Slct_1_2", 6)  '6.close/cancel
				Exit Sub
			else
				g_sSLCT_YN2 = "N"
			end if
		else
			g_sSLCT_YN2 = "N"
		end if
		
	end if
End Sub

'============================================================================
' 상품 서비스 안내 관련사항
'============================================================================
Sub Cont0_Rdo2_OnClick(nIndex)

	if nIndex == 1 then
		'v0003
		if trim(g_sSLCT_TabChange) <> "1" then
			'동의할 경우, 개인신용정보 동의 필수
			If g_sSLCT_YN2 <> "Y" Then
				Form.ShowAlert("안내", "상품·서비스 안내 수신 동의를 위해서는\n수집·이용 동의가 필요합니다.")
				g_sSLCT_POPUP_CHK = "1"
				Cont0.Rdo2.currentindex = "0"			
				Exit Sub		
			else
				g_sSLCT_YN3 = "Y"
				Form.SetCtlProp( "Cont0.ChkAll", "enable", true )
				for i = 0 to 3
					Form.SetCtlProp( "Cont0.Chk"..i, "enable", true )
				next		
			end if		
		else
			g_sSLCT_YN3 = "Y"
			Form.SetCtlProp( "Cont0.ChkAll", "enable", true )
			for i = 0 to 3
				Form.SetCtlProp( "Cont0.Chk"..i, "enable", true )
			next				
		end if

	else
		'v0003
		if trim(g_sSLCT_TabChange) <> "1" then
			if trim(g_sSLCT_POPUP_CHK) <> "1" and g_sSLCT_YN3 == "Y" then
				Form.MsgBox("안내", "상품·서비스 안내 미동의시,\n상품·서비스 안내 수신 동의 및\n동의 채널도 미동의 됩니다.\n\n미동의 하시겠습니까?", "Slct_2_1", 6)  '6.close/cancel			
				g_sSLCT_POPUP_CHK = "0"
				Exit Sub			
			else
				g_sSLCT_POPUP_CHK = "0"
			end if		
		else
			g_sSLCT_YN3 = "N"
			
			g_sRCMS_YN1 = "N"
			g_sRCMS_YN2 = "N"
			g_sRCMS_YN3 = "N"
			g_sRCMS_YN4 = "N"
			Form.SetCtlProp( "Cont0.ChkAll", "enable", false )
			Form.SetCtlProp( "Cont0.ChkAll", "chksilence", false )
			for i = 0 to 3
				Form.SetCtlProp( "Cont0.Chk"..i, "chksilence", false )
				Form.SetCtlProp( "Cont0.Chk"..i, "enable", false )
			next		
		end if

	end if
End Sub

'============================================================================
' 전화 ~ 우편
'============================================================================
Sub Cont0_Chk0_OnChange(sCheckState)
	if sCheckState == "1" then
		'v0003
		'동의할 경우, 개인신용정보 동의 필수
'		If g_sSLCT_YN2 <> "Y" Then			
'			Form.ShowAlert("안내", "문자 수신 동의를 위해서는\n수집·이용 동의가 필요합니다.")
'			Exit Sub
'		End If

		'동의할 경우, 상품·서비스 안내 수신동의 동의 필수
'		If g_sSLCT_YN3 <> "Y" Then
'			Form.ShowAlert("안내", "문자 수신 동의를 위해서는\n상품·서비스 안내 수신 동의가 필요합니다.")
'			Exit Sub
'		End If
		
		g_sRCMS_YN1 = "Y"
	else
		g_sRCMS_YN1 = "N"
	end if
	
	f_SetAllCheck()
End Sub
