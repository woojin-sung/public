	<SCRIPT_INFO _len="7641" _ulen="7145" >
Dim g_sImg_Box

g_sImg_Box   = "bg_infobox_n.9"

Dim g_sCloudCertID 
g_sCloudCertID = ""

Dim g_sCloudCertDN 
g_sCloudCertDN = ""

Dim g_sCloudName 
g_sCloudName = ""

Dim g_sCloudPolicy 
g_sCloudPolicy = ""

Dim g_sCloudInsti 
g_sCloudInsti = ""

Dim g_sCloudMake 
g_sCloudMake = ""

Dim g_sCloudDue 
g_sCloudDue = ""

Dim g_sCloudCertIndex
g_sCloudCertIndex = -1

Dim g_sCertPass
g_sCertPass = ""

Dim g_sLoginType
g_sLoginType = ""

Dim g_sCloudAcno
g_sCloudAcno = ""

Dim g_sID
g_sID = ""

Dim g_sScrGbn
g_sScrGbn = ""

Dim DEF_CERT_PSWD_LIMIT_CNT
DEF_CERT_PSWD_LIMIT_CNT = 5

'============================================================================
Sub Form_OnFormInitBefore()
	ContainerCert.ImageCertOn.setmaintainingratio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	ContainerCert.edtCertPswd.imagefilepth 	= "login_input.9.png"
	ContainerCert.Image0.imgpath 			= g_sImg_Box
	ContainerCert.edtCertPswd.certname		= "인증서 비밀번호 입력"
	
	g_sLoginType		= Form.GetSharedData("&LOGIN_TYPE", false)
	
	szData = Form.GetOpenLinkData()
	
	szTempData = Split(szData, "★")
	
	if Ubound(szTempData) > 0 then
	
		g_sCloudCertID = szTempData(0)
		g_sCloudCertDN = szTempData(1)

		g_sCloudName = szTempData(2)
		g_sCloudPolicy = szTempData(3)
		g_sCloudInsti = szTempData(4)
		g_sCloudMake = szTempData(5)
		g_sCloudDue = szTempData(6)
		g_sCloudCertIndex = szTempData(7)
		
		g_sScrGbn = szTempData(8)
		
		ContainerCert.Grid0.rowcount = 1
		ContainerCert.Grid0.SetCellData("bd_name", 0, g_sCloudName)
		
		'ContainerCert.Grid0.SetCellData("bd_date", 0, "발급일: " & Left(g_sCloudMake, 4) & "-" & Mid(g_sCloudMake, 3, 2) & "-" & Right(g_sCloudMake, 2) )
		ContainerCert.Grid0.SetCellData("bd_date", 0, g_sCloudMake)
		'ContainerCert.Grid0.SetCellData("bd_Edate", 0, "만료일: " & Left(g_sCloudDue, 4) & "-" & Mid(g_sCloudDue, 3, 2) & "-" & Right(g_sCloudDue, 2) )
		ContainerCert.Grid0.SetCellData("bd_Edate", 0, g_sCloudDue)
		ContainerCert.Grid0.SetCellData("bd_dn", 0,  g_sCloudCertDN)
		ContainerCert.Grid0.SetCellData("bd_index", 0,  g_sCloudCertIndex)
		
		'mhetc90060_s1 공동인증서 갱신 화면에서 넘어옴
		if g_sScrGbn == "OriginalCertUpdate" then
			ContainerCert.Grid0.SetCellData("bd_cert", 0, g_sCloudPolicy )
		else
			ContainerCert.Grid0.SetCellData("bd_cert", 0, g_sCloudPolicy .." ("..g_sCloudInsti..")" )
			
			Form.setTimerEvent2("1",1,0.3)
		end if
		
	end if
End Sub


'============================================================================
'인증서 만료 기간 체크 로직 추가
Function CheckCertExpired(s_DN)
	sExpired = Trim(Form.getCertificateCheckExpired(s_DN)) '0:유효, 1:만료, 2:만료예정

	if sExpired == "0" Then
		return True
		
	elseif sExpired == "1" or sExpired == "2" Then
		sExDate = Form.getCertificateExpiredDate(s_DN)

		sData = sExpired & "★" & sExDate

		Form.OpenPopup("mhetc90021_p2", sData, "")
		return False
	end if	
End Function
'============================================================================
'인증서 로그인
Sub ContainerCert_btnLogin_OnClick()
	ContainerCert.edtCertPswd.SetShowKeypad(True)
End Sub

'============================================================================
Sub ContainerCert_edtCertPswd_OnEditComplete()
	
	g_sCertPass = ContainerCert.edtCertPswd.caption
		
	'인증서 특수기호 ">"종료글자 오류회피
	sCertPass = Form.GetSharedData("CERT_IMSI_PSWD", 1)
	
	if sCertPass <> null and sCertPass <> "" then
		g_sCertPass = sCertPass
	end if

	if g_sCertPass <> "" then
		Form.setTimerEvent2("11",1,0.1)
	end if
End Sub


'============================================================================
Sub ImageClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	Form.setTimerEvent2(sTimerID,0,0.1)
	
	if Cint(sTimerID) == 1 then
		ContainerCert.edtCertPswd.SetShowKeypad(True)
		DATAMANAGER.RequestTranData("obcsb_efif_183r")
	end if
	
	if Cint(sTimerID) == 11 then
		if ContainerCert.edtCertPswd.caption == null or ContainerCert.edtCertPswd.caption == "" then
			Form.MsgBox( "알림", "인증서 비밀번호를 입력하세요.", "", 6 )
			
		else 
			Form.RequestCertCommand( "ReqCheckIsValidPassword", g_sCloudCertDN, ContainerCert.edtCertPswd.caption2 )
			'Form.RequestCertCommand( "ReqCheckIsValidPassword", g_sCloudCertDN, g_sCertPass   )
		end if
	end if
End Sub
'============================================================================
Sub Form_OnCertEvent(sType  , sSucces , stext)
	if sType == "RetIsCertPasswordValid" then
	
		if sSucces == "Success" then  '성공
'			Form.SetEnvData(1,"login.input.userid",g_sID)
'			Form.SetCertDNPW(g_sDN, g_sCertPass)
			
			if g_sScrGbn == "OriginalCertUpdate" then
				Form.MsgBox("안내", "코스콤 클라우드 계정 연결 후\n인증서 갱신이 가능합니다.\n\n클라우드 계정을 연결하시겠어요?", "ConnectCloud", 7, "클라우드 계정 연결하기", "취소")
			else
				Form.SendReturnToParent("mhetc90152_s1" , "")
				Form.OpenPopup("mhetc90150_s3" , "UploadToCloud" & "★" & g_sCloudCertID  & "★" & g_sCloudCertIndex  & "★" &  ContainerCert.edtCertPswd.caption2 , "")
			end if
			
		elseif sSucces == "Failed" then '비밀번호 오류
			
			Form.ShowAlert(stext)

		elseif sSucces == "Error" then ' 인증서 없음
			Form.OpenDialog("mhetc90020_perr", "", "") '인증서 없음 처리
		end if
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obcsb_efif_183r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DN_DATA"   , 0 , g_sCloudCertDN )
	end if
	
	if szTranID == "obaci_acct_239r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID"   		 , 0 , g_sID )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_STAT_CODE"   , 0 , "1"   )
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_efif_183r" then
		g_sID = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ELFN_ID" , 0)
		
		DATAMANAGER.RequestTranData("obaci_acct_239r") 
	end if
	
	if szTranID == "obaci_acct_239r" then
		'Array이지만 하나만 받아서 쓰자
		'비밀번호 정합성 체크 시 맨 위에 계좌번호로 체크해도
		' 업무적으로 문제 없다고 확인함
		g_sCloudAcno = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACNO" , 0)
		
		Form.SetSharedData( "CLOUD_CERT_ACNO" ,g_sCloudAcno)
	end if
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90150_s3" then
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "ConnectCloud" then
		if sRet == "ok" then
			'사용자인증 시작하면 됨 (이름/전화번호/생년월일 입력하는 화면)
			Form.OpenPopup("mhetc90302" , "" , "") 'Form_OnPopupReturn : CLOUD_CHECK_CONNECT 로 리턴
		else
			Form.CloseForm()
		end if
		
	elseif sKeyName == "CLOUD_CHECK_CONNECT" then
	
		Form.CloseForm()
		
		if sRet == "OK" then
			'클라우드ID, 시리얼번호
			Form.OpenPopup("mhetc90150_s3" , "RenewCloudCert" &  "★"  & g_sCloudCertID &  "★"  & g_sCloudCertSerial , "")
		else
			Form.CloseForm()
		end if
	
	
	
	end if
End Sub

	</SCRIPT_INFO>
