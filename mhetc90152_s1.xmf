			<TRAN tranid="obaci_acct_239r" trcode="obaci_acct_239r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obcsb_efif_183r" title="DN값으로 전자금융ID(등록일자순" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="43" _ulen="37" >

DN_DATA^DN데이터^256^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="45" _ulen="37" >

ELFN_ID^전자금융ID^20^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
			<TRAN name="obaci_acct_239r" title="HTS ID로 종합계좌번호 조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="94" _ulen="74" >

ELFN_ID^전자금융ID^20^0^0^0^0^0^0
ACNT_STAT_CODE^계좌상태코드^1^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" occurs="100" inout="out" _len="39" _ulen="31" >

ACNO^계좌번호^8^0^0^0^0^0^0

				</TRBLOCK>
