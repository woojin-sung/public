	<SCRIPT_INFO _len="3750" _ulen="3674" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 잔고평가
' 02. 화면설명 : 잔고평가 담보상세탭화면
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_ACNO, g_ASNO

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
Function RequestData()
	DATAMANAGER.RequestTranData( "oblon_mntn_020r" )
	DATAMANAGER.RequestTranData( "oblon_basc_805r" )
	DATAMANAGER.RequestTranData( "oblon_mntn_926r" )

End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

End Sub

'============================================================================
Sub Form_OnFormInit()
	RequestData()
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID) 	
	Dim szACNO, szASNO
	
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")

	if szTranID = "oblon_mntn_020r" then
		Dim szDate
		szDate =  Form.GetSharedData( "&HOST_DATE", 0 )
		
		DATAMANAGER.SetDataValue( 0, "oblon_mntn_020r", "InBlock1", "ACNO"		, 0, szACNO )
		DATAMANAGER.SetDataValue( 0, "oblon_mntn_020r", "InBlock1", "ASNO"		, 0, szASNO )
		DATAMANAGER.SetDataValue( 0, "oblon_mntn_020r", "InBlock1", "STND_DATE"	, 0, szDate )
		
	elseif szTranID = "oblon_basc_805r" then
		DATAMANAGER.SetDataValue( 0, "oblon_basc_805r", "InBlock1", "ACNO"		, 0, szACNO )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_805r", "InBlock1", "ASNO"		, 0, szASNO )
		
	elseif szTranID = "oblon_mntn_926r" then
		DATAMANAGER.SetDataValue( 0, "oblon_mntn_926r", "InBlock1", "ACNO" 				, 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, "oblon_mntn_926r", "InBlock1", "ASNO" 				, 0 , szASNO )
		DATAMANAGER.SetDataValue( 0, "oblon_mntn_926r", "InBlock1", "LOAN_DTL_TYPE_CODE" 	, 0 , "%" )

	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "oblon_basc_805r" Then
		Dim szData, szReturn
		szData = DATAMANAGER.GetDataValue( 0, "oblon_basc_805r", "OutBlock1", "MORG_APLY_FORM_CODE" , 0 )
		
		Select Case szData
			Case "A"	szReturn = "기본형"
			Case "B"	szReturn = "투자형"
			Case "Z"	szReturn = "기존방식"
			Case "0"	szReturn = "해당없음"
		End Select
		
		cont0.tbl0.SetCellString( 0, 1, szReturn)
	End If
	
End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "RECEIVE" then
		RequestData()
		
	ElseIf sEventName = "CHANGE_ACCTNO" Then
		RequestData()

	End If
End Sub

'============================================================================
Sub rdo0_OnClick(nIndex)
	RequestData()
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Form.ShowAlert( szErrCode , szErrMsg )
End Sub


	</SCRIPT_INFO>
