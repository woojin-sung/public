	<SCRIPT_INFO _len="2515" _ulen="2419" >
'--===========================================================================
' 01. 화 면 명 : 매수청구권리포기동의안내
' 02. 화면설명 : 매수청구권리포기동의안내
' 03. 작    성 : 2022.04.01 김수진 
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szRet	'리턴값

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szRet = "N"
	
	Dim szOpenData
	szOpenData = Form.GetopenLinkData()
	
	If Trim(szOpenData) == "" Then
		Exit Sub
	End If

	Dim tData
	tData = Split(szOpenData, "★")
	
	If UBound(tData) > 0 Then
		If tData(1) == "Y" or tData(1) == "A" Then
			DIm szExrsYN
			szExrsYN	= tData(1)
			If szExrsYN == "Y" Then
				tblY.SetCellString( 0, 1, tData(0) )
				tblY.visible = true
			Else
				tblA.SetCellString( 0, 1, tData(0) )
				tblA.visible = true
			End If
		End If
	End If
End Sub

'============================================================================
' btnY_OnClick() : 동의 출고
'============================================================================
Sub btnY_OnClick()
	g_szRet = "Y"
	Form.CloseForm()		
End Sub

'============================================================================
' btnN_OnClick() : 취소
'============================================================================
Sub btnN_OnClick()
	g_szRet = "N"
	Form.CloseForm()	
End Sub

'============================================================================
' imgClose_OnClick()
'============================================================================
Sub imgClose_OnClick()
	g_szRet = "N"
	Form.CloseForm()
End Sub
'============================================================================
' Form_OnFormClose()
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbbnk61100_p3" , g_szRet )
End Sub

