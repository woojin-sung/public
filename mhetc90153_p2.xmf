'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	
	if szTranID == "obaci_nmet_011r" then
		szProsClsCode = ""
		szRsltCode    = ""
		
		szProsClsCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "PROS_CLS_CODE" , 0)
		szRsltCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "IF_RSLT_CODE"  , 0)
		
		If szProsClsCode == "2" and TRIM(szRsltCode) <> "00" Then
			
			Container0.Label3.visible = true
			Container0.Label4.visible = true

			PasswordFail()
			
		Else '비밀번호 입력 성공시
			
			g_AuthSucess = "success"			
			
			if Container0.EditReal.caption == null or Container0.EditReal.caption == "" then
				Form.MsgBox( "알림", "클라우드인증서 비밀번호를 입력해주세요.", "", 6 )
			else	
				if g_AuthSucess = "success" then
				
					Call PasswordInsert()
					
					Container0.Label3.visible = false
					Container0.Label4.visible = false
					
					Form.SetTimerEvent2( "2", 1, 0.1)
				end if
			end if
			
			nCnt = 0
		End If

	elseif szTranID == "obcsb_efif_011r" then
		g_sAsctRcno = DATAMANAGER.GetDataValue( 0, "obcsb_efif_011r", "OutBlock1", "ASCT_PSPR_NO_PIP", 0 )
		
		'20240117 LES START
		g_sRcnoPip = DATAMANAGER.GetDataValue(0, "obcsb_efif_011r", "OutBlock1", "RCNO_PIP" , 0)
		'20240117 LES END
		
		DATAMANAGER.RequestTranData("obcpp_pcrt_170a")

	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcpp_pcrt_170a" then
		Dim sCertPW, sRefNo, sAuthCode
		
		g_sRefNo = DATAMANAGER.GetDataValue( 0, "obcpp_pcrt_170a", "OutBlock1", "NTAT_REF_NO" , 0 )
		g_sAuthCode = DATAMANAGER.GetDataValue( 0, "obcpp_pcrt_170a", "OutBlock1", "NTAT_ATHZ_NO" , 0 )
		
		g_sPinPwd = Container0.EditReal.caption2
		
		'참조번호★인가코드★클라우드인증서 PIN
		sInput = g_sRefNo & "★" & g_sAuthCode & "★" & g_sPinPwd
		
		'-----------------------------------------------------------------
		'참조번호★인가코드★클라우드인증서 PIN
		Form.requestCertCommand("CLOUD_REQ_CERT_ISSUE", sInput, "90150") 
		'-----------------------------------------------------------------

	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obaci_nmet_011r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"        , 0 , "2")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD_PIP"        	    , 0 , g_PwdpipAuth				)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CNFR_PWD_PIP"         , 0 , Container0.EditReal.Caption2)	'해시<->아리아 전환
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CLPH_TELNO"     	    , 0 , g_sCloudPhoneNum)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"             , 0 , g_sCloudRcnoPip   )
	
	'20231211 SWJ START : 외국인투자자 등록제도 폐지
	elseif szTranID == "obcsb_efif_011r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_efif_011r", "InBlock1"	, "RCNO_PIP" , 0 , g_sCloudRcnoPip )
	
	elseif szTranID == "obcsb_acad_002r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "ACNO" 				, 0 , ACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "PWD"  				, 0 , PWD )
	
	elseif szTranID == "obcpp_pcrt_170a" then
		DATAMANAGER.SetUserID( sUserID )
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "USER_ID" 			, 0 , g_sCloudID )
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "CRPT_YN"  			, 0 , "Y"   )
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "RCNO_PIP" 			, 0 , g_sAsctRcno )	
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "USER_NAME"			, 0 , g_sCloudCustName )
		'DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "CSNO" 				, 0 , CSNO )
	'	DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "EMAIL_INFO"      	, 0 , g_sEmail )
		'DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "TELNO_INFO"      	, 0 , g_sTeNo )
		DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "CRAL_TELNO_INFO" 	, 0 , g_sCloudPhoneNum )
		'DATAMANAGER.SetDataValue( 0, "obcpp_pcrt_170a", "InBlock1", "ADDR_INFO"       	, 0 , g_sAddR )
		
		'-----------------------------------------------------------------
		'(내국인/외국인 구분) g_sNFTR =>  내국인 = 1,4 / 외국인 = 2,3,9
		'(개인/법인 구분)	    sCONO   =>  개인 = 1 / 법인 = 2
		'-----------------------------------------------------------------
		'발급/재발급 시, 인증서 유형을 채워야함. 
		'00 : N/A or Legacy  / 01: 국내 개인 / 02 : 국내법인 / 03: 해외개인 / 04 : 해외법인
		'-----------------------------------------------------------------
		sCertType = "00"
		
		if g_sNFTR == "1" or g_sNFTR == "4" then
		
			'국내개인
			if sCONO == "1" then
				sCertType = "01"
			'국내법인
			elseif sCONO == "2" then
				sCertType = "02"
			end if
			
		
		elseif g_sNFTR == "2" or g_sNFTR == "3" or g_sNFTR == "9" then
		
			'해외개인
			if sCONO == "1" then
				sCertType = "03"
			'해외법인
			elseif sCONO == "2" then
				sCertType = "04"
			end if
		
		end if
		
		'20240117 LES START
		'해외개인(03)일 경우 efif_011r에서 내려받은 조합주민번호와 실명확인번호가
		'동일한 경우 조합주민번호가 정상적으로 추출되지 않은 경우임. 이런 경우 
		'해외개인일 경우라도 인증서 발급유형을 "01"로 올리도록 수정.
		'참고) 조합주민번호가 정상적으로 추출될 경우 => 실명확인번호와 조합주민번호가 다름.
		if sCertType == "03" then
			
			if g_sAsctRcno == g_sRcnoPip then
				sCertType = "01"
			end if
		
		end if
		'20240117 LES END
		
		DATAMANAGER.SetDataValue(0, "obcpp_pcrt_170a", "InBlock1", "FID_UNIN_NTAT_TYPE" , 0 , sCertType)
	end if	

End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
		
	Form.MsgBox( "안내", szErrMsg, "", 6 )

End Sub

