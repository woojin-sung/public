	Form.OpenNextPopup("mhetc90153_p1","ChangePwd" & "★" & g_sCloudCertID & "★" & g_sCloudCertDN ,"")
End Sub
'============================================================================
Sub Container0_ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_onTriggerEventCloudCert(sCommand, sResult)

	Dim sErrorCd, sErrorMsg

	szItem = Split(sResult,"★")

	'처리코드,처리메시지 처리
	sErrorCd		= szItem(0)
	sErrorMsg	= szItem(1)	

	'오류이면
	if sErrorCd <> "0" then
		Form.MsgBox("[에러1]" & sCommand, sErrorMsg, "", 0)
		exit sub
	end if		
	
	'인증서 발급
	if sCommand = "CLOUD_REQ_CERT_CHANGE_PIN_90153" then
		g_nextpage = True
		Form.CloseForm()
	end if

End Sub
'============================================================================
Sub Form_OnFormClose()
	if g_nextpage then
		Form.OpenPopup("mhetc90150_p2" , "ChangePwd" , "")
		Form.SendReturnToParent("mhetc90150_p2" , "ChangePwd" , "")
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90150_p2" then
		Form.CloseForm()
	end if
End Sub

