'============================================================================
' 2024.05.02 SWJ START
' 클라우드 인증 비밀번호 입력
'============================================================================
Dim nCnt, g_DeviceOS
nCnt = 0

Dim g_CountSave
Dim g_HomeNo '20230622 jsi 연락처 조회 자택번호
Dim g_ClphNo '20230622 jsi 연락처 조회 휴대폰번호
Dim g_WorkNo '20230622 jsi 연락처 조회 직장번호

Dim g_CharFlag
g_CharFlag = ""

Dim g_sCloudRcnoPip
g_sCloudRcnoPip = ""

Dim g_sCloudPhoneNum
g_sCloudPhoneNum = ""

Dim g_PwdpipAuth
g_PwdpipAuth = ""

Dim g_sAsctRcno
g_sAsctRcno = ""

Dim g_sRcnoPip
g_sRcnoPip = ""

Dim g_sCloudID
g_sCloudID = ""

Dim g_sCloudCustName
g_sCloudCustName = ""

Dim g_sRefNo
g_sRefNo = ""

Dim g_sAuthCode
g_sAuthCode = ""

Dim g_sPinPwd
g_sPinPwd = ""

Dim g_AuthSucess
g_AuthSucess = ""

Dim g_nextpage
g_nextpage = False

Dim g_sOriginalPwd
g_sOriginalPwd = ""
'============================================================================
Sub Form_OnFormInit()
	
	Container0.EditReal.SetApplyLabel("숫자 6자리 입력", 0 , 76 , "left" , true) '호출해야 정상작동

	g_DeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	g_ScrNum = Form.GetSharedData("&POPUP_SCREEN_NO",true) '메뉴클릭시 팝업메뉴 화면번호 전달
	
	g_sCloudRcnoPip = Form.GetSharedData("CLOUD_CERT_RCNO_PIP" , false )
	g_PwdpipAuth = Form.GetSharedData("CLOUD_CERT_PWDAuth", false)
	g_sCloudPhoneNum = Form.GetSharedData("CLOUD_CERT_PHONENUM", false)
	g_sCloudCertID = Form.GetSharedData("CLOUD_CERT_ID", false)
	
'	g_sCloudCustName = Form.GetSharedData("CLOUD_CERT_CUST_NAME", false)
	g_sOriginalPwd = Form.GetSharedData("CLOUD_CERT_ORIGINAL_PWD", false)
	
	sTempData = Form.GetOpenLinkData()
	
	szData = Split(sTempData, "★")
	
	if Cint(#szData) > 1 then
	
		'진입점
		g_sScrPoint = szData(0)
		'g_sCloudCertID = szData(1)
		g_sCloudCertDN = szData(2)
		
		Form.SetSharedData("CLOUD_CERT_ID" , g_sCloudCertID)
	else
		g_sScrPoint = sTempData
	end if 
	
	
	'비밀번호 입력키패드 Show
	Form.SetTimerEvent2(1, 1, 0.6)
End Sub
'============================================================================
'인증성공 시 에디트 파란색으로 변환
'============================================================================
Sub Container0_Buttonok_OnClick()
	
	if Container0.EditReal.caption == null or Container0.EditReal.caption == "" then
		Form.MsgBox( "알림", "클라우드인증서 비밀번호를 입력해주세요.", "", 6 )
	else	
		if g_AuthSucess = "success" then
		
			Call PasswordInsert()
			
			Container0.Label3.visible = false
			Container0.Label4.visible = false
			
			Form.SetTimerEvent2( "2", 1, 0.1)
			
			'obcsb_acad_002r -> obcpp_pcrt_170a -> 발급
			'DATAMANAGER.RequestTranData("obcsb_acad_002r")
		end if
	end if
	
	nCnt = 0
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		Container0.EditReal.SetShowKeypad(True)
		
	elseif sTimerID == "2" or sTimerID == 2 then
		Form.SetTimerEvent2(sTimerID, 0, 0.1)
		
		'클라우드인증서ID★기존PIN★신규PIN
		Form.requestCertCommand("CLOUD_REQ_CERT_CHANGE_PIN", g_sCloudCertID & "★" & g_sOriginalPwd & "★" & g_PwdpipAuth, "90153") 	
		
	elseif sTimerID == "9999" or sTimerID == 9999 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
	end if
	
End Sub
'============================================================================
'사용자에게 보여지는 패스워드 함수
'============================================================================
Function PasswordInsert()
	
	'입력완료일 시에 따로 개수 세이브해서 UI보이기
	if g_CharFlag = "N" then
		nCnt = g_CountSave
		g_CharFlag = ""
	end if
	
	Select Case nCnt
	
	Case 0
		Container0.Pwdbasic0.visible = true	
		Container0.Pwdbasic1.visible = true	
		Container0.Pwdbasic2.visible = true	
		Container0.Pwdbasic3.visible = true	
		Container0.Pwdbasic4.visible = true	
		Container0.Pwdbasic5.visible = true		
		Container0.PwdInsert0.visible = false	
		Container0.PwdInsert1.visible = false	
		Container0.PwdInsert2.visible = false	
		Container0.PwdInsert3.visible = false	
		Container0.PwdInsert4.visible = false	
		Container0.PwdInsert5.visible = false	
	Case 1
