'============================================================================
' 01. 화 면 명 : 고객자산평가_상품별잔고_펀드
' 02. 화면설명 : 고객자산평가_상품별잔고_펀드
' 03. 작    성 : 2016. 01. 19. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nAcntCount	'계좌 개수	
Dim g_nAllCount	'전체조회시 계좌 Index
Dim g_szList
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' AllSearch() : 데이터 전체조회시
'============================================================================
Function AllSearch()
	g_nAllCount = g_nAllCount - 1
	
	if g_nAllCount > 2 then
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_030r", "InBlock1", "ACNO" , 0 , g_szList(Int(g_nAllCount)) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_030r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
		
		DATAMANAGER.RequestTranData( "obacb_balc_030r" )
	end if

End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	grd0.SetClear()
	
	if sEventName == "mbact71050_p5" then			'펀드
	
		g_szList = Split(sParam,"○")
		
	end if
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	g_nAcntCount = g_szList(0)		'계좌개수
	
	g_nAllCount = 4 + g_nAcntCount	'마지막 계좌 
	
	g_nNextCount = 0
	
	if g_szList(1) == "Y" then
		grd0.rowcount = 0
		AllSearch()
	else
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_030r", "InBlock1", "ACNO" , 0 , g_szList(3) )		'계좌번호
	'	DATAMANAGER.SetDataValue( 0 , "obacb_balc_030r", "InBlock1", "ACNT_PWD" , 0 , g_g_szList(1) )	'비밀번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_030r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
		
		DATAMANAGER.RequestTranData( "obacb_balc_030r" )
	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp0, szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, TempCount
	
	'계좌번호블록에 계좌번호+계좌명으로 출력
	if szTranID == "obacb_balc_030r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obacb_balc_030r", "OutBlock2")-1
			
			grd0.AddRow()
			
			szTemp0 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "ACNO" , i) &
					DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "ASNO" , i)
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "RMND_SRNO" , i)	'잔고일련번호
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "ABRV_ISNM" , i)	'축약종목명
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "PSNT_RMND_ACNU" , i)	'체결잔고
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "BYOV_AMT" , i)	'매수금액
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "VLTN_AMT" , i)	'평가금액
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "VLTN_PRLS_AMT" , i)	'평가손익
			szTemp7 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "ERT" , i)	'수익률
			szTemp8 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "LOAN_BAL" , i)	'대출잔액
			TempCount = Len(DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "ACNT_PRNM" , i))
			szTemp9 = Mid(DATAMANAGER.GetDataValue( 0 , "obacb_balc_030r", "OutBlock2", "ACNT_PRNM" , i), 3, TempCount - 2)'상품명
			
			grd0.SetCellData("bd_cell0", g_nNextCount , szTemp0)
			grd0.SetCellData("bd_cell1", g_nNextCount , szTemp1)
			grd0.SetCellData("bd_cell2", g_nNextCount , szTemp2)
			grd0.SetCellData("bd_cell3", g_nNextCount , szTemp3)
			grd0.SetCellData("bd_cell4", g_nNextCount , szTemp4)
			grd0.SetCellData("bd_cell5", g_nNextCount , szTemp5)
			grd0.SetCellData("bd_cell6", g_nNextCount , szTemp6)
			grd0.SetCellData("bd_cell7", g_nNextCount , szTemp7)
			grd0.SetCellData("bd_cell8", g_nNextCount  , szTemp8)
			grd0.SetCellData("bd_cell9", g_nNextCount  , szTemp9)
			
			g_nNextCount = g_nNextCount + 1
		next
		
		grd0.rowcount = g_nNextCount
		
		if  DATAMANAGER.IsMoreNextData( "obacb_balc_030r" ) == True then 
				DATAMANAGER.RequestNextData( "obacb_balc_030r" )
		else
			if g_szList(1) == "Y" then	'전체조회시
				AllSearch()
			end if
		end if
	end if
	
End Sub
'============================================================================
' grd0_OnScrollEnd()
'============================================================================
Sub grd0_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obacb_balc_030r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	grd0.SetClear()
	g_nNextCount = 0
End Sub
'============================================================================
Sub Form_OnFormInit()
	g_nAllCount = 0
End Sub

