'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_iDataCount
Dim g_szSelectedItem

'============================================================================
Sub Form_OnFormInit()
'	FormTab0.setTabHeaderImage("bg_tab_sel.9.png" , "bg.tab_nor.9.png" , 6) '활성화/비활성화/여백
'	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 6) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	
	FormTab0.insertPage( FormTab0.tabcount, "page1", "page1", "empty", "0", "ETF")
	FormTab0.insertPage( FormTab0.tabcount, "page2", "page2", "empty", "0", "ETN")
	FormTab0.currenttab = 0
	
	gridData.scrollenable = "0"
	
	gridData.rowcount = 0
	DATAMANAGER.RequestTranData( "ohhts_7051_004r")
End Sub	


'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	gridData.rowcount = 0
	DATAMANAGER.RequestTranData( "ohhts_7051_004r")
End Sub

'============================================================================
Sub lblTitle0_OnClick()
	Dim szLinkData
	
	szLinkData = FormTab0.currenttab & "|||"
	
	Form.OpenPopup("mbonl90051", szLinkData, "")
End Sub

'============================================================================
Sub imgMore_OnClick()
	lblTitle0_OnClick()
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , "mbonl90001_s5("..szTranID..")\n" .. szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , "mbonl90001_s5("..szTranID..")\n" .. szErrCode .. " : ".. szErrMsg)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szValue
	
	if szTranID == "ohhts_7051_004r" then
		if CInt(FormTab0.currenttab) == 0 then
			szValue = "EF"
		else
			szValue = "EN"
		end if
	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE",		0 , "J")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE",		0 , 7051)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_MRKT_CLS_CODE",			0 , szValue)
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iDataCount, iCount, szColor
	
	if szTranID == "ohhts_7051_004r" then
		g_iDataCount = gridData.rowcount
		
		iDataCount = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		
		if CInt(g_iDataCount) == 0 and CInt(iDataCount) == 0 then
			
			Exit Sub
		end if
		
		iCount = 0
		for i = 0 to iDataCount - 1
			if iCount >= 3 then
				Exit Sub
			end if 
			
			szTemp1 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_SHRN_ISCD",	i)	'종목코드
			szTemp2 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_KOR_ISNM",	i)	'종목명
			szTemp3 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_STCK_PRPR",	i)	'현재가
			szTemp4 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_PRDY_VRSS",	i)	'전일대비
			szTemp5 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_PRDY_VRSS_SIGN", i)'대비부호  1,2:상승, 4,5: 하락, 나머지 보합
			szTemp6 = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_PRDY_CTRT",	i)	'대비율
			
			gridData.AddRow()
			
			if szTemp5  == "1" or szTemp5 == "2" then 
				szColor = "10"
			elseif szTemp5  == "4" or szTemp5 == "5" then 
				szColor = "11"
			else
				szColor = "12"
			end if

			gridData.SetCellData("bd_cell0", g_iDataCount + i, szTemp2)		'종목명
			
			gridData.SetCellFgColor("bd_cell1", g_iDataCount + i, szColor)
			gridData.SetCellFgColor("bd_cell2", g_iDataCount + i, szColor)
			gridData.SetCellFgColor("bd_cell3", g_iDataCount + i, szColor)
			gridData.SetCellFgColor("bd_cell4", g_iDataCount + i, szColor)
			
			gridData.SetCellData("bd_cell1", g_iDataCount + i, szTemp3)		'현재가
			gridData.SetCellData("bd_cell2", g_iDataCount + i, szTemp5 & "|" & szTemp4)		'전일대비값
			gridData.SetCellData("bd_cell3", g_iDataCount + i, szTemp6)		'등락율
												
			'숨김cell
			gridData.SetCellData("FID_SHRN_ISCD", g_iDataCount + i, szTemp1)
			
			iCount = iCount + 1
		next
		
		if DATAMANAGER.IsMoreNextData(szTranID) == true then
			DATAMANAGER.RequestNextData(szTranID)
		
		else
			g_iDataCount = g_iDataCount + iDataCount
'			gridData.rowcount = g_iDataCount
						
		end if
		
	end if
	
End Sub


'============================================================================
Sub gridData_OnClickUp(lRow, szCellID)
	Dim szLinkData
	
'	szLinkData = FormTab0.currenttab 						& "|" &
'			    gridData.GetCellData("FID_SHRN_ISCD", lRow) 	& "|" &
'			    gridData.GetCellData("bd_cell0", lRow)
'	
'	Form.OpenPopup("mbonl90051", szLinkData, "")
	g_szSelectedItem	= gridData.GetCellData("FID_SHRN_ISCD", lRow )

	listLocation =  Split(gridData.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	sPopupType = "0"

	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "차트" & "★" & "관심등록" & "★" & "매수" & "★" & "매도")
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim szListItems, szData
	
'	Form.ShowAlert("OnPopupReturn", sKeyName .. " : " .. sRet)
'	
'	szData = Form.GetItemCodeInfo( g_szSelectedItem , "market")
'	Form.ShowAlert("OnPopupReturn1", szData)
	
	if sKeyName == "MOVEPOP_RETURN"	then
		szListItems	=	split(sRet,"★")
		
		if	szListItems(1)	=	"0"	then			'현재가
			Form.OpenScreen("11000" , g_szSelectedItem & "★" & "0") 
		elseif	szListItems(1)	=	"1"	then		'차트
			Form.OpenScreen("11000" , g_szSelectedItem & "★" & "2") 
		elseif 	szListItems(1)	=	"2"	then		'관심등록-편집
		    'Form.OpenScreen("11010" , g_szSelectedItem & "★" & "4") 
		    Form.OpenPopup("mhprc11000_pd" , g_szSelectedItem , "")
		elseif 	szListItems(1)	=	"3"	then		'매수
			Form.OpenScreen("12000" , "기타" &  "★" & "0" &  "★"& g_szSelectedItem) 
		elseif 	szListItems(1)	=	"4"	then		'매도
			Form.OpenScreen("12000" , "기타" &  "★" & "1" &  "★"& g_szSelectedItem) 
		else
		end if
	end if
End Sub

	</SCRIPT_INFO>
