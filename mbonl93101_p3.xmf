Dim g_szAcnt
Dim g_bNextFlag
Dim g_szLnkdTlmsMnno

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("연금 가입금융기관 정보 조회")

    '2022.07.13. 장원혁 : obaci_acct_275r 연속조회가 끝나기 전에 사용자가 그리드 스크롤을 끝까지 내리면
    '연속조회된 데이터가 그리드에 세팅되지 않는 버그 발생. 같은 로직 사용하는 타사이수 화면은 동 문제 없음
    '원인 못찾아서 연속조회 끝나기 전까진 사용자가 그리드 스크롤 못 내리게 제한함
    '그리드 컨트롤을 Disable시켜도 스크롤은 계속 움직여서(메인 쪽 문제) 
    'obaci_acct_275r 연속조회 끝나기 전까지 투명한 버튼 세팅해서 그리드 터치 못하게 함
    BtnTransParent.visible = True

	'그리드 카드 배경 설정
	grdList.setUseCardView(true, 10, "input_03_n.9.png")
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	
	If szOpenData <> "" and szOpenData <> null Then
		'계좌번호★계약금액★잔여한도
		Dim tData
		tData = Split(szOpenData, "★")
		
		g_szAcnt = tData[0]
'		tblData.SetCellString(0, 1, tData[1])
'		tblData.SetCellString(1, 1, tData[2])
		
		g_bNextFlag = false
		
		'전체금융기관연금저축계좌 조회
		DATAMANAGER.RequestTranData( "obaci_acct_275r" )
	End If

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'전체금융기관연금저축계좌 조회
	If szTranID == "obaci_acct_275r" Then
		'경우에 따라 연속조회
		If g_bNextFlag Then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , Left(g_szAcnt, 8) )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "2" )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "0" )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "LNKD_TLMS_MNNO" , 0 , g_szLnkdTlmsMnno )
		'최초조회
		Else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , Left(g_szAcnt, 8) )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1" )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "0" )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "LNKD_TLMS_MNNO" , 0 , "" )
		End If
	End If
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'전체금융기관연금저축계좌 조회
	If szTranID == "obaci_acct_275r" Then
		Dim szUISplmYn		'UI추가여부
		szUISplmYn = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "UI_SPLM_YN" , 0 )
		
		Dim szUITxcmSvngJoinTtam, szUITxcmSvngLimtRmnnAmt
		
		szUITxcmSvngJoinTtam = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "UI_TXCM_SVNG_JOIN_TTAM" , 0 )
		szUITxcmSvngLimtRmnnAmt = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "UI_TXCM_SVNG_LIMT_RMNN_AMT" , 0 )
		
		tblData.SetCellString(0, 1, szUITxcmSvngJoinTtam)
		tblData.SetCellString(1, 1, szUITxcmSvngLimtRmnnAmt)

		Dim nRow, nCnt
		nRow = grdList.rowcount
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock2" )

		If nCnt > 0 Then
			Dim szOrgName, szAcnt, szAcntType, szLimit, szRegDate, szExpDate, szUnsign
			For i = 0 to nCnt - 1
				'점포명
				szOrgName = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "UI_TXCM_REG_SHOP_NAME" , i )
				'계좌번호
				szAcnt = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "UI_TXCM_ACNO" , i )
				'계좌유형
				szAcntType = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "UI_ACNT_PRNM" , i )
				'납입한도
				szLimit = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "UI_TXCM_JOIN_AMT" , i )
				'가입일
				szRegDate = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "UI_TXCM_SVNG_NEW_DATE" , i )
				'만기일
				szExpDate = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "UI_TXCM_MTRT_DATE" , i )
				'해지일
				'szUnsign = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "UI_TXCM_CANC_DATE" , i )
				
				grdList.AddRow()
				
				grdList.SetCellData("bd_cell12", nRow + i, "계좌번호")
				grdList.SetCellData("bd_cell17", nRow + i, "계좌유형")
				grdList.SetCellData("bd_cell22", nRow + i, "납입한도")
				grdList.SetCellData("bd_cell27", nRow + i, "가입일")
				grdList.SetCellData("bd_cell13", nRow + i, "만기일")
				'grdList.SetCellData("bd_cell31", nRow + i, "해지일")
		
				grdList.SetCellData("bd_title", nRow + i, szOrgName)
				grdList.SetCellData("bd_acnt", nRow + i, szAcnt)
				grdList.SetCellData("bd_type", nRow + i, szAcntType)
				grdList.SetCellData("bd_limit", nRow + i, szLimit)
				grdList.SetCellData("bd_regdate", nRow + i, szRegDate)
				grdList.SetCellData("bd_expdate", nRow + i, szExpDate)
				'If szUnsign == "" or szUnsign == null or szUnsign == "00000000" Then
					'grdList.SetCellData("bd_unregdate", nRow + i, "")
				'Else
					'grdList.SetCellData("bd_unregdate", nRow + i, szUnsign)
				'End If
			Next
		End If
		
		If szUISplmYn == "0" Then
			g_bNextFlag = false
			BtnTransParent.visible = False
		Else
			g_bNextFlag = true
			
			'연계전문번호 가져온 후 다시 조회(연속조회)
			g_szLnkdTlmsMnno = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "LNKD_TLMS_MNNO" , 0 )
			
			'전체금융기관연금저축계좌 조회(연속조회)
'			DATAMANAGER.RequestTranData( "obaci_acct_275r" )

			'타이머를 이용해 1초이상 대기 후 재조회
			Form.SetTimerEvent(1000, 1, 1.5)
		End If 
	End If
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	sTimerID = CInt(sTimerID)
	If sTimerID == 1000 Then
		Form.SetTimerEvent(1000, 0, 1.5)
		
		'전체금융기관연금저축계좌 조회(연속조회)
		DATAMANAGER.RequestTranData( "obaci_acct_275r" )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	If szTranID == "obaci_acct_275r" Then
		Form.ShowAlert( "오류", szErrMsg .. "(" .. szSubMsg .. ")" )
	End If
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obaci_acct_275r" trcode="obaci_acct_275r" compress="1" encryption="1" inputcheck="1" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obaci_acct_275r" title="전체 금융기관 연금저축계좌 조?" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="191" _ulen="143" >

ACNO^계좌번호^8^0^0^0^0^0^0
PROS_CLS_CODE^처리구분코드^1^0^0^0^0^0^0
IQRY_CLS_CODE^조회구분코드^1^0^0^0^0^0^0
LNKD_TLMS_MNNO^연계전문관리번호^13^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="479" _ulen="349" >

UI_SPLM_YN^UI추가여부^1^0^0^0^0^0^0
UI_TXCM_SVNG_RCMS_CSNU^UI세금우대저축수신건수^8^0^7^0^0^0^0
UI_TXCM_SVNG_JOIN_TOTAL_CSNU^UI세금우대저축가입총건수^4^0^7^0^0^0^0
