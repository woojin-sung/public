	<SCRIPT_INFO _len="1320" _ulen="1304" >
'============================================================================
Sub Form_OnFormInit()
	sItems = Form.GetAllChegyulItem()
	if Len(sItems) == 0 then
		Exit Sub
	end if
	listItems =  Split(sItems, "`")
	
	nCnt = #listItems
	
	for i = 0 to nCnt-1 
		sItem = listItems[i]
		listItem = Split(sItem, ":")
		Grid0.AddRow()
		Grid0.SetCellData("bd_cell0", i, listItem[0])
		sGubun = ""
		if listItem[1] == "00" then
			sGubun = "신용"
		else
			sGubun = "현금"
		end if
		if listItem[2] == "1" then
			sGubun = sGubun & "매도"
			Grid0.SetCellFgColor("bd_cell1", i, 7)
		elseif listItem[2] == "2" then
			sGubun = sGubun & "매수"
			Grid0.SetCellFgColor("bd_cell1", i, 6)
		end if
		Grid0.SetCellData("bd_cell1", i, sGubun)
		Grid0.SetCellData("bd_cell2", i, listItem[3])
		Grid0.SetCellData("bd_cell3", i, listItem[4])
		Grid0.SetCellData("bd_cell4", i, listItem[5])
	next
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	Form.SetReadChegyulItem(lRow)
	sMarket = Grid0.GetCellData("bd_cell4", lRow)
	if sMarket == "STOCK" then
		Form.OpenScreen("12040" , "")
	elseif sMarket == "FUTURE" or sMarket == "OPTION" then
		Form.OpenScreen("31080", "")
	else 
		Form.OpenScreen("54030", "")
	end if
	Form.CloseForm()
End Sub

