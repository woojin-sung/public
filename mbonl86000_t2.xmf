	<SCRIPT_INFO _len="6403" _ulen="5909" >
'============================================================================
' 01. 화 면 명 : OTP관리_보정처리
' 02. 화면설명 : OTP관리_보정처리
' 03. 작    성 : 2016. 02. 01. 유창재
' 2020.09.23 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
' 2020.11.19 : 정민영 : v0002 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_oimf_390r IO 변경분 반영
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szList			'계좌번호, 비밀번호
Dim g_szPW			'암호화 PW
Dim g_plain_rm  		'v0001 메모리평문적용여부

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
Function Setbojung()

	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_061a", "InBlock1", "APRV_YN" , 0 , "N")
	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_061a", "InBlock1", "ACNO" , 0 , g_szList(0))
	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_061a", "InBlock1", "ACNT_PWD" , 0 ,  g_szPW)
	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_061a", "InBlock1", "OTP_CARD_SRNO" , 0, tbl1.GetCellString( 1, 1))
	
	DATAMANAGER.RequestTranData("obcsb_oimf_061a")
			
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "보정처리" then
		g_szList = Split(sParam , "★")
		
		if UBOUND(g_szList) < 1 then
			Exit Sub
		End if
		
		'v0001
		if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
			g_szPW = g_szList(1)
		else  'MTS메모리평문 미적용상태일때-부모(mbonl86000)에서 미암호화된정보로 넘어오므로 암호화 필요
			g_szPW = Form.GetEncData(g_szList(1))
		end if		
	
	    DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_390r", "InBlock1", "ACNO" , 0 , g_szList(0))
	    DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_390r", "InBlock1", "ACNT_PWD" , 0 , g_szPW)
	
	    DATAMANAGER.RequestTranData("obcsb_oimf_390r")
	end if
	
	
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szStatCode, szStatName		'매크로 처리를 위한 OTP 상태 코드, 상태코드명 코드치환값
	Dim szDate, szCode		'기준일자, 전문일련번호
	Dim szMsg, szMsgCode
	
	if szTranID == "obcsb_oimf_390r" then
		
		szStatCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_390r", "OutBlock1", "OTP_STAT_CODE" , 0)
		szStatName = Form.GetMetaData( "OTP상태코드", szStatCode)
		tbl1.SetCellString( 0, 1, szStatName)
		tbl1.SetCellString( 1, 1, DATAMANAGER.GetDataValue( 0, "obcsb_oimf_390r", "OutBlock1", "OTP_CARD_SRNO" , 0) )
	
	elseif szTranID == "obcsb_oimf_061a" then
		DATAMANAGER.RequestTranData("obcsb_oimf_061a_1")
		edt2.caption = ""
		
	elseif szTranID == "obcsb_oimf_061a_1" then
		szMsgCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_061a_1", "OutBlock1", "OTP_RSPN_CODE" , 0)
		szMsg = Form.GetMetaData( "OTP응답코드", szMsgCode )
		edt4.caption = szMsg
		Dim MsgText, SubText
		MsgText = DATAMANAGER.GetDataMsgText( "obcsb_oimf_061a_1" )
		SubText = DATAMANAGER.GetDataMsgSubText("obcsb_oimf_061a_1")
		Form.ShowAlert( "알림" , MsgText&"("&SubText&")" )
		DATAMANAGER.RequestTranData("obcsb_oimf_390r")
		
	end if
	
End Sub
'============================================================================
' btn0_OnClick()
'============================================================================
Sub btn0_OnClick()
	
	if g_szPW == "" or g_szPW == Null then
		Form.ShowAlert( "알림", "비밀번호를 입력하세요")
		Exit Sub
	end if
	
	if edt2.caption =="" then
		Form.MsgBox("알림", "OTP응답값을 입력 하세요.", 0, 6)
	else
'		Setbojung()				'Test 용
		Form.OpenFramePopup("mhetc90060_p5" , "" , sPosInfo)		'공인인증 암호 입력
	end if
	
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "mhetc90060_p5" then
		if sRet ~= "cancel" then			'공인인증 암호 입력 완류후
			Call Setbojung()
		else
			Form.ShowAlert("알림", "공인인증 암호 입력 오류")
		end if
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obcsb_oimf_061a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
	elseif szTranID == "obcsb_oimf_061a_1" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obcsb_oimf_061a_1" then
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_061a_1", "InBlock1", "ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_061a_1", "InBlock1", "ACNT_PWD" , 0 ,  g_szPW)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_061a_1", "InBlock1", "OTP_CARD_SRNO" , 0 , tbl1.GetCellString( 1, 1))
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	
End Sub

