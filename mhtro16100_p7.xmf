'============================================================================
Sub Form_OnFormInitBefore()

	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	'-----------------------------------------------------------
	' 일반주문
	'-----------------------------------------------------------
	g_nIndex				= arrData( 0) ' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소, 10:예약매수, 11:예약매도, 12:예약취소)
	g_szOrder_Acc			= arrData( 1)	' 계좌번호
	g_szOrder_AccName		= arrData( 2)	' 고객명
	g_szOder_Cnt			= arrData( 3) ' 주문건수
	g_szAllCheck			= arrData( 4) ' 전체선택여부
	
'	g_szOrd_ItmCode 		= arrData( 3)	' 종목코드
'	g_szOrd_ItmName 		= arrData( 4)	' 종목명
'	g_szOrd_OrdType  		= arrData( 5)	' 주문구분
'	g_szOrd_Security 		= arrData( 6)	' 현금/대출구분 (0:현금/1:대출)
'	g_nOrd_Qty   			= arrData( 7)	' 주문수량
'	g_nOrd_Price 			= arrData( 8)	' 주문가격
'	g_nOrd_OrdNo 			= arrData( 9)	' 원주문번호
'	g_nOrd_ChkAll 		= arrData(10)	' 잔량전부
'	g_nOrd_Decimal		= arrData(11)	' 가격자릿수
'	g_nOrd_Currency		= arrData(12)	' 통화
'	g_szOrd_PrcName		= arrData(13)	' 시장가or지정가
'	
'	'대출일경우
'	if g_szOrd_Security == "1" then
'		g_nOrd_LoanType		= arrData(14)	' 대출구분
'		g_szOrd_LoanDate		= arrData(15)	' 대출일자
'		g_szOrd_LoanSrno		= arrData(16)	' 대출일련번호
'	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()

    Set_Data(g_nIndex)
    
End Sub

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)

    	'-----------------------------------------------------------
	' 계좌번호/고객명
	'-----------------------------------------------------------
	szStr1 = left(g_szOrder_Acc,4)
	szStr2 = mid(g_szOrder_Acc,5,4)
	szStr3 = right(g_szOrder_Acc,2)
	tblMaedo1.SetCellString( 0, 1, szStr1.."-".. szStr2 .."-".. szStr3.." "..g_szOrder_AccName)
	
	'-----------------------------------------------------------
	' 주문건수
	'-----------------------------------------------------------
	tblMaedo1.SetCellString( 1, 1, g_szOder_Cnt.."건")
	
	'-----------------------------------------------------------
	' 종목
	'-----------------------------------------------------------
	if g_szAllCheck == "Y" then
		tblMaedo1.SetCellString( 2, 1, "전종목")
	else
		tblMaedo1.SetCellString( 2, 1, "선택종목")
	end if
	
	'-----------------------------------------------------------
	' 수량
	'-----------------------------------------------------------
	tblMaedo1.SetCellString( 3, 1, "전량")
	
	
End Function

'============================================================================
Function SendOrder()
    
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "전체취소주문전송" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
	    
    End If
    
End Function
'============================================================================
Sub btnMaesu1Close_OnClick()
	Form.CloseForm()	
End Sub
'============================================================================
Sub btnMaesu1_OnClick()
	SendOrder()
End Sub
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()	
End Sub

