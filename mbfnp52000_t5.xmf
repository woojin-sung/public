	<SCRIPT_INFO _len="2702" _ulen="2570" >
'============================================================================
' 01. 화 면 명 : 발행어음매매_금리
' 02. 화면설명 : 발행어음매매_금리
' 03. 작    성 : 2016. 03. 02. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szData			'계좌번호 및 비밀번호
Dim g_szList
Dim g_szPW			'비밀번호
Dim g_szCode					'종목 코드

g_szCode = {"NI70030" , "NI70040"}
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	
	DATAMANAGER.SetDataValue( 0 , "obsan_bsop_214r", "InBlock1", "STND_DATE" , 0 , cld0.caption )
	DATAMANAGER.SetDataValue( 0 , "obsan_bsop_214r", "InBlock1", "ISCD" , 0 , g_szCode(0) )
	
	DATAMANAGER.RequestTranData( "obsan_bsop_214r" )
	
End Sub

'============================================================================
Sub cmbItem_OnEditComplete(iIndex)
	
	DATAMANAGER.SetDataValue( 0 , "obsan_bsop_214r", "InBlock1", "ISCD" , 0 , g_szCode(iIndex) )
	
	DATAMANAGER.RequestTranData( "obsan_bsop_214r" )
	
End Sub

'============================================================================
Sub btnNotice_OnClick()
	Form.OpenFramePopup( "mbfnp52000_p6" , sOpenData , sPosInfo)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nCount			'데이터 숫자
	Dim nStartDate		'투자기간시작일
	Dim nFinalDate		'투자기간종료일
	Dim nRate			'금리
	
	
	if szTranID == "obsan_bsop_214r" then
		nCount = DATAMANAGER.GetDataCount( 0 , "obsan_bsop_214r", "OutBlock1" ) - 1
		for i = 0 to nCount
			nStartDate = DATAMANAGER.GetDataValue( 0 , "obsan_bsop_214r", "OutBlock1", "INVT_PRD_STA_DYNU" , i)
			nFinalDate = DATAMANAGER.GetDataValue( 0 , "obsan_bsop_214r", "OutBlock1", "INVT_PRD_FIN_DYNU" , i)
			nRate = DATAMANAGER.GetDataValue( 0 , "obsan_bsop_214r", "OutBlock1", "APLY_INRT" , i)
			
			tbl0.SetCellString( i+1 , 0, nStartDate)
			tbl0.SetCellString( i+1 , 2, nFinalDate)
			tbl0.SetCellString( i+1 , 3, nRate)
		next
	end if
	
End Sub

