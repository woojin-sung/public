	<SCRIPT_INFO _len="5466" _ulen="4988" >

Dim g_tData
Dim g_szCode
Dim g_szNewData

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		'20230828 아이디 연결여부 추가
		g_szLinkedYN = Form.GetSharedData("71052_ID_LNKN_YN", false)
		
'		Form.ShowAlert("", szOpenData)
		'종목명, 평가금액, 매입금액, 평가손익, 수익률, 잔고구분, 체결잔고, 매입단가, 대출금, 대출일, 만기일, 종목코드
		g_tData = Split(szOpenData, "☆")
		
		lblName.caption = g_tData[0]
		
		tbl0.SetCellString(0, 2, g_tData[1])
		
		tbl1.SetCellString(0, 1, g_tData[2])
		If CInt(g_tData[3]) > 0 Then
			tbl1.SetCellString(1, 1, "+" & FormatNumber(g_tData[3], 0))
			tbl1.SetCellFgColor(1, 1, "1")
		ElseIf CInt(g_tData[3]) < 0 Then
			tbl1.SetCellString(1, 1, FormatNumber(g_tData[3], 0))
			tbl1.SetCellFgColor(1, 1, "2")
		Else
			tbl1.SetCellString(1, 1, FormatNumber(g_tData[3], 0))
		End If
		
		If CDbl(g_tData[4]) > 0 Then
			tbl1.SetCellString(2, 1, "+" & FormatNumber(g_tData[4], 2))
			tbl1.SetCellFgColor(2, 1, "1")
		ElseIf CDbl(g_tData[4]) < 0 Then
			tbl1.SetCellString(2, 1, FormatNumber(g_tData[4], 2))
			tbl1.SetCellFgColor(2, 1, "2")
		Else
			tbl1.SetCellString(2, 1, FormatNumber(g_tData[4], 2))
		End If
		
'		tbl1.SetCellString(2, 1, g_tData[4])
		
		tbl3.SetCellString(0, 1, g_tData[5])
		tbl3.SetCellString(1, 1, g_tData[6])
		tbl3.SetCellString(2, 1, FormatNumber(g_tData[7], 4) & " " & g_tData[12])
		tbl3.SetCellString(3, 1, FormatNumber(g_tData[13], 4) & " " & g_tData[12])
		
'		If CInt(g_tData[8]) <> 0 Then
			tbl2.SetCellString(0, 1, g_tData[8])
			tbl2.SetCellString(1, 1, g_tData[9])
			tbl2.SetCellString(2, 1, g_tData[10])
'		Else
'			tbl2.SetCellString(0, 1, "-")
'			tbl2.SetCellString(1, 1, "-")
'			tbl2.SetCellString(2, 1, "-")
'		End If
		
		g_szCode = g_tData[11]
		
		'화면오픈 시, 넘겨줄 데이터 - 거래소영문@종목코드★종목명
		szCutIscd  = Mid(g_szCode, 1, Len(g_szCode)-3)
		szTranExch = Transform_Exid2(right(g_szCode, 2))
		g_szNewData = szTranExch & "@" & szCutIscd & "★" & g_tData[0]
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'20230828 아이디 연결여부 추가
	if sKeyName == "NO_ID_LINKED" and sRet == "ok" then
		Form.OpenScreen("85000", "")
	end if
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Function Transform_Exid2(sValue)

	
	if sValue = "HK" then
		Transform_Exid2 = "HKS"
		exit Function
	elseif sValue = "SH" then
		Transform_Exid2 = "SHS"
		exit Function
	elseif sValue = "SZ" then
		Transform_Exid2 = "SZS"
		exit Function
	elseif sValue = "NY" then
		Transform_Exid2 = "NYS"
		exit Function
	elseif sValue = "AX" then
		Transform_Exid2 = "AMX"
		exit Function
	elseif sValue = "OQ" then
		Transform_Exid2 = "NAS"
		exit Function
	elseif sValue = "JP" then
		Transform_Exid2 = "TSE"
		exit Function
	else
		Transform_Exid2 = "XXX"
		exit Function
	end if
End Function

'============================================================================
Sub btnPrice_OnClick()
	Form.OpenScreen("16000" , g_szNewData)
End Sub

'============================================================================
Sub btnBuy_OnClick()
	'20230828 아이디 연결여부 추가
	if g_szLinkedYN == "N" then
		Form.MsgBox("안내", "ID에 계좌가 연결되어 있지 않습니다.\nID계좌연결 후 진행해주세요.", "NO_ID_LINKED", 7, "ID계좌연결", "취소")
		exit sub
	end if
	
	szLoanDate = ""'grd0.GetCellData("bd_cell10", lRow)
	szLoanCd   = "0000"'grd0.GetCellData("bd_cell14", lRow)
	szLoanSr   = "00000000000"'grd0.GetCellData("bd_cell15", lRow)
	
'	szNewBuyData = g_szNewData & "♥" & "0" & "♥"& g_tData[6] & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & "0" & "♥" & szLoanSr '0은 신용합산
	szNewBuyData = g_szNewData & "♥" & "0" & "♥"& "" & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & "0" & "♥" & szLoanSr '0은 신용합산
	
	'일반/소수점 주문 분기
	If Trim(g_tData[5]) == "소수점" Then
		Form.OpenScreen("16092" , szNewBuyData)
	Else
		Form.OpenScreen("16060" , szNewBuyData)
	End If
End Sub

'============================================================================
Sub btnSell_OnClick()
	'20230828 아이디 연결여부 추가
	if g_szLinkedYN == "N" then
		Form.MsgBox("안내", "ID에 계좌가 연결되어 있지 않습니다.\nID계좌연결 후 진행해주세요.", "NO_ID_LINKED", 7, "ID계좌연결", "취소")
		exit sub
	end if
	
	szLoanDate = ""'grd0.GetCellData("bd_cell10", lRow)
	szLoanCd   = "0000"'grd0.GetCellData("bd_cell14", lRow)
	szLoanSr   = "00000000000"'grd0.GetCellData("bd_cell15", lRow)
	
'	szNewSelData = g_szNewData & "♥" & "1" & "♥"& g_tData[6] & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & "0" & "♥" & szLoanSr '0은 신용합산	
	szNewSelData = g_szNewData & "♥" & "1" & "♥"& "" & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & "0" & "♥" & szLoanSr '0은 신용합산	
	
	'일반/소수점 주문 분기
	If Trim(g_tData[5]) == "소수점" Then
		Form.OpenScreen("16092" , szNewSelData)
	Else
		Form.OpenScreen("16060" , szNewSelData)
	End If
End Sub

