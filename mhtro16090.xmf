'============================================================================
Function Transform_Exid(szExid)

	if szExid = "HKS" then
		Transform_Exid = "HK"
		exit Function
	elseif szExid = "SHS" then
		Transform_Exid = "SH"
		exit Function
	elseif szExid = "SZS" then
		Transform_Exid = "SZ"
		exit Function
	elseif szExid = "NYS" then
		Transform_Exid = "NY"
		exit Function
	elseif szExid = "AMX" then
		Transform_Exid = "AX"
		exit Function
	elseif szExid = "NAS" then
		Transform_Exid = "OQ"
		exit Function
	elseif szExid = "TSE" then
		Transform_Exid = "JP"
		exit Function
	else
		Transform_Exid = szExid
	end if

End Function
'============================================================================
'20220510 LES START : 마스터파일에 있는 종목인지 체크
'g_szFst = Form.GetItemCodeInfo(g_szCd, "enablefst")
'거래가능종목 iOS : g_szFst = "1" / 안드로이드 "Y" 
'거래불가종목 iOS : g_szFst = "0" / 안드로이드 "Y"외의 값 
'============================================================================
Function CheckMasterFile(szCode)
	arrCode = Split(szCode,"@")
	szTransExidCode = Transform_Exid(arrCode(0))
	
	szTransItemCode = szTransExidCode .. "@" .. arrCode(1)

	szCheckData = Form.GetItemCodeInfo(szTransItemCode, "enablefst")
'	Form.ShowAlert("szCheckData", szCheckData)
	if szCheckData = "" or szCheckData = null then
		CheckMasterFile = false
		Exit Function
	elseif szCheckData = "Y" or CInt(szCheckData) = 1 then
		CheckMasterFile = true
		Exit Function
	end if
	
	CheckMasterFile = false
	
End Function
