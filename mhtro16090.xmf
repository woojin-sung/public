Dim g_sDecimalLen
Dim sData

'주문설정값
Dim g_szChangeInit
Dim g_szBuyPrc
Dim g_szSelPrc
Dim g_szModPrc
Dim g_szAfterOrg

' 계좌비밀번호 저장여부
Dim g_szSavePwd 
g_szSavePwd  = "0"

Dim g_szCode
g_szCode = ""
'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")		' 종목/탭 변경시 초기화
	g_szSavePwd = Form.GetEnvData("order.save_orderpwd")					' 계좌비밀번호 저장여부

	g_szBuyPrc  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYPRC")		' 주식매수주문가격 자동입력
	g_szSelPrc  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELPRC")		' 주식매도주문가격 자동입력
	g_szModPrc  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_MODPRC")		' 주식정정주문가격 자동입력
	
	g_szAfterOrg = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")			' 원주문번호 자동입력
				
	' 주식매수주문가격 자동입력(기본값 : 미사용, 11:현재가)
	if Trim(g_szBuyPrc) = "" then
		g_szBuyPrc = "0"
	end if

	' 주식매도주문가격 자동입력(기본값 : 미사용, 11:현재가)
	if Trim(g_szSelPrc) = "" then
		g_szSelPrc = "0"
	end if
	
	' 주식정정주문가격 자동입력(기본값 : 미사용, 11:현재가)
	if Trim(g_szModPrc) = "" then
		g_szModPrc = "0"
	end if
	
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	'20170919 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170919 HAMWG END	
	
	' 계좌비밀번호사용여부 초기화(기본값 : 미사용)
	if Trim(g_szSavePwd) = "" then
		g_szSavePwd = "0"
	end if	
	
	'20220425 HWG START : 계좌비밀번호 입력 개선
	if g_szSavePwd == "0" then
		edtPwdIcon.imgpath = "icon_save_password_n.9"
		edtPwd.caption = ""
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'20220425 HWG END
	
End Function

'============================================================================
Function Tonum(sValue)
	return tonumber( sValue ) or 0
end Function

'============================================================================
' 거래소 ID 시장명으로 변환
'============================================================================
Function Transform_Market(sValue)
	if sValue == "HK" then
		return "홍콩"
	elseif sValue == "CN" then
		return "중국"
	elseif sValue == "JP" then
		return "일본"
	elseif sValue == "US" then
		return "미국"
	end if
end Function

'============================================================================
'[[ 폼 초기화 ]]
'============================================================================
Sub Form_OnFormInit()
	
	'20240626 LES START - 관심종목 등록팝업 변경
	Form.requestIntrItemList("03") '00.전체 01.국내 02.해외 03.미국 04.중국 05.홍콩 06.일본 
	'20240626 LES END

	btnPwd.bringfront("1")	'20220425 HWG : 계좌비밀번호 입력 개선
	
	'f_EventPopup()	'20240710 SWJ START: 위치 변경
	Load_OrderSet()
	
	if Form.GetOpenLinkData( ) == "0" or Form.GetOpenLinkData( ) == 0	then			'매수
		FormTab0.currenttabpageid = "page0"
	elseif Form.GetOpenLinkData( ) == "1" or Form.GetOpenLinkData( ) == 1	then		'매도
		FormTab0.currenttabpageid = "page1"	
	else
		szData = Form.GetOpenLinkData()
		arrData = Split(szData, "♥")
		if arrData(0) <> "" then
			Form.setOverStockItemCode(arrData(0)) '최근조회종목에 세팅해주기 위해 사용
			
			arrCode = Split(arrData(0), "★")
			szCode = Split(arrCode(0), "@")
			szTransExidCode = Transform_Exid(szCode(0))
			g_szCode = szTransExidCode .. "@" .. szCode(1)
			if CheckMasterFile(g_szCode) then
				
			else
				Form.ShowAlert("안내", "MTS에서 거래가 불가능한 종목입니다")
				g_szCode = "OQ@AAPL"
			end if
			ItemCode0.code = g_szCode
			
			if arrData(1) == "0" then
				FormTab0.currenttabpageid = "page0"
			elseif arrData(1) == "1" then
				FormTab0.currenttabpageid = "page1"
				
				'20201021 LES START 해외주식 매도상환
				'szTranExch@szCutIscd★szItemName♥sellbuyGubun♥szQty♥szLoanDate♥szLoanCd♥0♥szLoanSr
				'Form.SetSharedData("JANGO" , arrData(2))
				'매도매수구분/수량/대출일자/대출상세유형코드/대출일련번호
				Form.SetSharedData("JANGO" , arrData(1).."★"..arrData(2).."★"..arrData(3).."★"..arrData(4).."★"..arrData(6))
				'20201021 LES END
			
			end if
		end if
	end if

	if Form.GetOpenLinkData() = "" or Form.GetOpenLinkData() = null then
'		szfsData = Form.GetSharedData("&ITEM_OVERSTOCK_FS_CODE", false)
		szfsIdx = Form.getRecentHistoryIMaxCount_FS()
		if CInt(szfsIdx) > 0 then
			szfsData = Form.getRecentHistoryIMax_FS(szfsIdx-1)
			arrfsdata = Split(szfsData, "★")                                                                                 
			g_szCode = arrfsdata(0)
			if CheckMasterFile(g_szCode) then
				
			else
				Form.ShowAlert("안내", "MTS에서 거래가 불가능한 종목입니다")
				g_szCode = ""
			end if
		end if
	end if
	if g_szCode = "" or g_szCode = null then
		g_szCode = "OQ@AAPL"  ' 애플
		szinitCode = "OQ@AAPL★애플"  ' 애플
		Form.setOverStockItemCode(szinitCode) '최근조회종목에 세팅해주기 위해 사용
	end if
	ItemCode0.code = g_szCode

	if Len(g_szCode) > 0 then
'		Form.ShowAlert("g_szCode", g_szCode)
		Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "InitCode", g_szCode )
		Form.triggerEvent( "LinkForm2", "RequestData", g_szCode)
		DATAMANAGER.RequestTranData("ohhts_6000_001r")
		DATAMANAGER.RequestTranData("ohhts_6000_002r")
	end if

	if acnt.total = "" or acnt.total = null then
		exit sub
	end if
	
	'20240710 SWJ START
	'팝업 위치 변경, 311r은 권리선반영 체크 이후에 진행
	f_EventPopup()
	'DATAMANAGER.RequestTranData("obpds_srvc_311r")
	'20240710 SWJ END
end Sub

'============================================================================
'[[ 폼탭 변경시 ]]
'============================================================================


'============================================================================
Sub Form_OnRefresh()
	set_itemcode(g_szCode)
end Sub
 
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
'	Form.ShowAlert("16090main", sEventName&sParam)
	if sEventName == "SCREEN_REFRESH" then
		set_itemcode(g_szCode)
	
	elseif sEventName == "REG_INTR" then ' 상반바 우측 관심추가 버튼 클릭 시
		Form.OpenPopup( "mhtro16010_p5" , g_szCode , "" )
		
	elseif sEventName = "SCREEN_MENU" then							' 연결정보(상단 ...)
		
		if sParam = "REG_INTR" Then								' 관심종목등록
			
			'----------------------------------------------------------------
			'20240626 LES START - 관심종목 등록팝업 변경
			'----------------------------------------------------------------
			'Form.OpenPopup( "mhtro16010_p5" , g_szCode , "" )

			if g_szCode <> "" then
				isIntrItem = Form.isIntrItemList(g_szCode )
			
				if isIntrItem = true then
					Form.OpenPopup("mhprc11000_pe", g_szCode  & "★"& "DEL","", "")
				else
					Form.OpenPopupAnimation("mhprc11000_pd", g_szCode & "★"& "ADD","", "2")	'종목등록
				end if
			end if
			'----------------------------------------------------------------
			'20240626 LES END
			'----------------------------------------------------------------

		elseif sParam = "SET_SCREEN" Then							' 화면설정
			Form.OpenScreen("90000" , "1")

		end if

	elseif (sEventName == "16090_BALANCE") then
'		Form.setOverStockItemCode(sParam)
		
	elseif (sEventName == "16060_CONTRACT") then
'		Form.setOverStockItemCode(sParam)
		
	elseif sEventName == "CHANGE_CODE" then
		'hsz
		g_szCode = sParam
		if CheckMasterFile(g_szCode) then
				
		else
			Form.ShowAlert("안내", "MTS에서 거래가 불가능한 종목입니다")
			exit sub
		end if
		szName = Form.GetItemCodeInfo(g_szCode, "name")
		Form.setOverStockItemCode(g_szCode.."★"..szName)
		ItemCode0.code = g_szCode
		if Len(g_szCode) > 0 then
			Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "InitCode", g_szCode )
			Form.triggerEvent( "LinkForm2", "RequestData", g_szCode)
			DATAMANAGER.RequestTranData("ohhts_6000_001r")
			DATAMANAGER.RequestTranData("ohhts_6000_002r")
		end if
		'hsz
	'안내사항
	elseif sEventName == "INFO_CLICK" then
		Form.OpenFramePopup( "mhtro16090_pa" , "", "")
	
	'----------------------------------------------------------------
	' 20240626 LES START 등록관심종목 조회 완료 후 호출
	'----------------------------------------------------------------
	elseif sEventName = "REFRESH_INTR_ITEM" then
		
		if g_szCode <> "" then
			
			isIntrItem = Form.isIntrItemList(g_szCode)
			
			if isIntrItem == true then
				Form.triggerEvent( "LinkForm2", "SET_INTR_YN", "Y")
			else
				Form.triggerEvent( "LinkForm2", "SET_INTR_YN", "N")
			end if
			
		end if
		
	'----------------------------------------------------------------
	' 20240626 LES END
	'----------------------------------------------------------------
	
	end if
end Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if "&ITEM_CODE" == sKey then
		edtOrgNo.caption = ""
		set_itemcode(sValue)
	end if
End Sub

'============================================================================
Sub set_itemcode(sCode)
	g_szCode = sCode
	Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeCode", g_szCode )
	Form.triggerEvent( "LinkForm2", "RequestData", g_szCode)
	
	'----------------------------------------------------------------
	'20240626 LES START - 관심종목 등록팝업 변경
	'----------------------------------------------------------------
	'Form.OpenPopup( "mhtro16010_p5" , g_szCode , "" )

	if g_szCode <> "" then
				
		isIntrItem = Form.isIntrItemList(g_szCode)
			
		if isIntrItem == true then
			Form.triggerEvent( "LinkForm2", "SET_INTR_YN", "Y")
		else
			Form.triggerEvent( "LinkForm2", "SET_INTR_YN", "N")
		end if
		
	end if
	'----------------------------------------------------------------
	'20240626 LES END
	'----------------------------------------------------------------
	
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	if Len(g_szCode) > 0 then
		if nCurrentTab = 2 then
			if g_szAfterOrg == "1" then		'주문연동시
				if edtOrgNo.caption <> "" then
					Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "AFTER_ORGNO", edtOrgNo.caption) '주문번호 연동
				end if
			end if
		end if
			
		Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeTab", g_szCode )	
	end if
End Sub

'============================================================================
' 종목검색창 호출 명령 들어올 경우
'============================================================================
Sub Form_OnOpenSearchDialog()
	Form.OpenPopup( "ItemSearchOverStock" , "" , "I" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obpds_srvc_311r" then '소수점 매매 약정 가능 여부 체크
		DATAMANAGER.SetDataValue(0, "obpds_srvc_311r", "InBlock1", "ACNO" 				, 0 	, acnt.total )
		DATAMANAGER.SetDataValue(0, "obpds_srvc_311r", "InBlock1", "ASNO"				, 0 	, acnt.sequence )
		DATAMANAGER.SetDataValue(0, "obpds_srvc_311r", "InBlock1", "SVCD"				, 0 	, "079" ) '해외주식소수점
		DATAMANAGER.SetDataValue(0, "obpds_srvc_311r", "InBlock1", "CSNO"				, 0 	, "" )
	
	'20240710 SWJ START : 주석 처리
	'20200827 LES START 애플/테슬라 액면분할 관련 고객유의사항
'	elseif szTranID == "obtro_acnt_900r" then
'	
'		szCustNum = Form.GetSharedData("&CUST_NUM", false)
'	
'		DATAMANAGER.SetDataValue(0, "obtro_acnt_900r", "InBlock1", "BSWR_CLCD" 			, 0 , "05") '20220713 SWJ START : 구글 권리 선반영
'		DATAMANAGER.SetDataValue(0, "obtro_acnt_900r", "InBlock1", "CSNO" 				, 0 , szCustNum)
'	
'	'20220719 SWJ START : GME 권리 선반영
'	elseif szTranID == "obtro_acnt_902r" then
'	
'		szCustNum = Form.GetSharedData("&CUST_NUM", false)
'	
'		DATAMANAGER.SetDataValue(0, "obtro_acnt_902r", "InBlock1", "BSWR_CLCD" 			, 0 , "09")
'		DATAMANAGER.SetDataValue(0, "obtro_acnt_902r", "InBlock1", "CSNO" 				, 0 , szCustNum)
	'20220719 SWJ END
	'20240710 SWJ END
	
	elseif szTranID == "ohhts_6000_001r" or szTranID == "ohhts_6000_002r" then

		Dim sCodeData, szDelay
	
		sCodeData = {}	' sCodeData[1] 마켓, sCodeData[2] 코드
		sCodeData = Split( g_szCode, "@" )
		
		szDelay = Form.GetSharedData("REALTIME_"..sCodeData[0], 0 )
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
 		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCodeData(1))
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sCodeData(0))
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay)	
	'20200827 LES END
'	elseif szTranID == "obrtp_drab_001r" then
'		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "ACNO" , 0 , acnt.total ) ' 계좌번호
'		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "ASNO" , 0 , acnt.sequence ) ' 계좌일련번호
'		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "PROS_DATE" , 0 , Form.GetSharedData("&HOST_DATE", false) ) ' 처리일자
'		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "SMCD" , 0 , "001020" ) ' 적요코드
'		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "SUMR_DRNG_YN" , 0 , "" ) ' 적요출금여부

	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obpds_srvc_311r" then
		stplYn = DATAMANAGER.GetDataValue(0, "obpds_srvc_311r", "OutBlock1", "STPL_YN" 		, 0) '약정여부
		ableYn = DATAMANAGER.GetDataValue(0, "obpds_srvc_311r", "OutBlock1", "ABLE_PRHB_YN" 	, 0) '가능여부
	    '약정계좌 여부 체크
	    if stplYn = "N" then
		    	Form.MsgBox("알림", "해외주식 소수점 거래신청 후 주문이 가능합니다. 신청 화면으로 이동하시겠습니까?" , "REG", 1)
			Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeAcnt", "" )
		else
			Form.TriggerEvent( "FormTab0." .. FormTab0.currenttabpageid, "ChangeAcnt", "" )
			
			'20220719 SWJ START : GME 권리 선반영
			'20220713 SWJ START ; 구글 권리 선반영
			szToday = Form.GetSharedData("&HOST_DATE", false )
			
			'if tonumber(szToday) >= 20220718 and tonumber(szToday) <= 20220721 then
				
				'구글 보유고객 중, 유의사항 동의하지 않은 고객조회
			'	DATAMANAGER.RequestTranData("obtro_acnt_900r")
			'elseif tonumber(szToday) >= 20220722 and tonumber(szToday) <= 20220728 then
				
				'GME 보유고객 중, 유의사항 동의하지 않은 고객조회
				'소수점 잔고 전용으로 서비스 새로 나옴 (구글은 일반/소수점 통합 버전 그대로 사용)
			'	DATAMANAGER.RequestTranData("obtro_acnt_902r")
			'end if
			
			if tonumber(szToday) >= 20240610 and tonumber(szToday) <= 20240614 then
				DATAMANAGER.RequestTranData("obtro_acnt_902r")
			end if
			'20220713 SWJ END
			'20220719 SWJ END
		end if
		
	'20200827 LES START 애플/테슬라 액면분할 관련 고객유의사항
	elseif szTranID == "obtro_acnt_900r" then
	
		'애플/테슬라 잔고보유 고객한테만 유의사항 팝업 띄어줌.
		agreeYn = DATAMANAGER.GetDataValue(0, "obtro_acnt_900r", "OutBlock1", "AGRM_YN" 		, 0)
		
		'20240710 SWJ START
		'jangoYn = DATAMANAGER.GetDataValue(0, "obtro_acnt_900r", "OutBlock1", "RMND_EXST_YN" 	, 0)
		jangoYn = DATAMANAGER.GetDataValue(0, "obtro_acnt_900r", "OutBlock1", "DCPN_RMND_EXST_YN" 	, 0)
		'20240710 SWJ END
		
		if jangoYn = "Y" then
			if agreeYn = "N" then
				Form.OpenPopup("mhtro16060_p9" , "" , "")
			else
				DATAMANAGER.RequestTranData("obpds_srvc_311r")	'20240710 SWJ START
			end if
			
			'20240710 SWJ START
			'로그인 후 한번 뜨면 안떠도 됨
			Form.SetSharedData("AbroadAgreement_PopupYN", "N")
			'20240710 SWJ END
		else
			DATAMANAGER.RequestTranData("obpds_srvc_311r")	'20240710 SWJ START
		end if
		
	'20200827 LES END
	
	'20220719 SWJ START
	elseif szTranID == "obtro_acnt_902r" then
	
		'애플/테슬라 잔고보유 고객한테만 유의사항 팝업 띄어줌.
		agreeYn = DATAMANAGER.GetDataValue(0, "obtro_acnt_902r", "OutBlock1", "AGRM_YN" 		, 0)
		jangoYn = DATAMANAGER.GetDataValue(0, "obtro_acnt_902r", "OutBlock1", "RMND_EXST_YN" 	, 0)
		
		if jangoYn = "Y" then
			if agreeYn = "N" then
				Form.OpenPopup("mhtro16060_p9" , "" , "")
			end if
			
		end if
	'20220719 SWJ END
	
	end if
End Sub

