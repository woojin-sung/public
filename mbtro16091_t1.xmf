	<SCRIPT_INFO _len="21242" _ulen="19148" >
'--===========================================================================
'
'--===========================================================================
Dim szCode
Dim g_szEngName			'구독자 영문이름
Dim g_szEngAddress		'구독자 영문주소
Dim g_szEngOcptName		'구독자 영문직업명 ENG_OCPT_NAME
Dim g_szEngCoName			'구독자 영문회사명 ENG_CO_NAME
Dim g_szEngCoAddr			'구독자 영문회사주소 ENG_CO_ADDR
Dim g_szEngClpsName		'구독자 영문직급명 CLPS_NAME
Dim g_szEngRsnsBswrName	'구독자 영문담당업무명 RSNS_BSWR_NAME

Dim g_szOvrsStckMrktTrClsCode
Dim g_szQttnApltClcd

Dim g_szAgree				'이용약관 동의여부
Dim g_szAgrm_yn			'비전문가 동의여부

Dim g_szCUST_CLS_CODE		'고객구분코드(2:법인)

Dim g_szFullAcnt, g_szPasswd, g_szPlainRm

g_CheckBtn3Cnt = 0  		'이용약관 카운트 횟수 - 2019.11.04

g_szEngName = ""
g_szEngAddress = ""
g_szEngOcptName = ""
g_szEngCoName = ""
g_szEngCoAddr = ""
g_szEngClpsName = ""
g_szEngRsnsBswrName = ""

g_szAgree = ""
g_szAgrm_yn = ""
g_szPlainRm = ""			'MTS메모리평문 적용여부

'211216 아이티젠 김성수 START
Dim g_bNonePw '계좌 비번 없이 조회가능 상태
g_bNonePw = true
'211216 아이티젠 김성수 END
'============================================================================
Sub Form_OnFormInit()
	g_szFullAcnt = Form.GetCtlProp("#acnt01", "caption")
	g_szPasswd	= Form.GetTopCtlProp("edtPwd01", "caption")
	
	'등록구분/신청기간 기본세팅인 등록 및 자동연장에 맞게 컨트롤 세팅
	btnSubmit.caption = "신청"
	
	cmbPeriod_OnEditComplete(0)
	
	'MTS메모리평문 적용유무 (0:미적용 / 1:적용) - 2020.09.17
	g_szPlainRm = Form.GetSharedData("&PLAIN_RM", false)
	
	if g_szFullAcnt ~= nil and g_szFullAcnt ~= "" then
		'계좌기준 고객정보 조회
		DATAMANAGER.RequestTranData("obacp_comm_005r")
	end if
End Sub

'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	g_szFullAcnt = Form.GetCtlProp("#acnt01", "caption")
	
	if sEventName		= "PWDINFO_CHG" then
		g_szPasswd	=	sParam
		
		if len(trim(g_szFullAcnt))	>	8	and	len(trim(g_szPasswd)) > 0	then 
			'해외주식 실시간 시세 조회
			DATAMANAGER.ClearInputData( 0, "obtro_acnt_201r" ) '211216 아이티젠 김성수 추가
			
			If g_szPlainRm == "1" Then
			    DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD" , 		0 , g_szPasswd)
			Else
			    DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD" , 		0 , Form.GetEncData(g_szPasswd))
			End If
			
			DATAMANAGER.RequestTranData("obtro_acnt_201r")
		end if
	
	elseif sEventName	=	"ACNTINFO_CHG" then
		g_szFullAcnt = Form.GetSharedData("&ACCOUNT", 0 )
		g_szPasswd	= Form.GetCtlProp("#edtPwd01", "caption")
		
		grdStatus.rowcount = "0"
		
		if g_szFullAcnt <> null and g_szFullAcnt <> "" then
			'계좌기준 고객정보 조회
			DATAMANAGER.RequestTranData("obacp_comm_005r")
			
			'211229 아이티젠 김성수 추가 START
			DATAMANAGER.RequestTranData("obtro_acnt_201r") '비번없이 조회가능으로 변경(전요셉 차장 요청)
			'211229 아이티젠 김성수 추가 END
			
		end if
	
	
	'20211215 아이티젠 김성수 추가 START
'	elseif sEventName	=	"PWDINFO_CHG_EXEPT" then
'		'sParam => 주문화면에서 넘겨준 마켓코드에 따라 콤보 변경
'		if sParam <> "" and sParam <> null then
'			Select case sParam
'				case "01" '미국
'					cmbExch.currentindex = "0"
'				case "02" '홍콩
'					cmbExch.currentindex = "1"
'				case "03" '상해
'					cmbExch.currentindex = "2"
'				case "04" '심천
'					cmbExch.currentindex = "3"
'				case "05" '일본
'					cmbExch.currentindex = "4"
'			End Select
'		end if
'		
'		'211216 아이티젠 김성수 추가
''		g_bNonePw = true
'		
'		if len(trim(g_szFullAcnt))	> 8 then 
'			'주문에서 넘어온 경우 비번 없이 조회 가능
'			DATAMANAGER.RequestTranData("obtro_acnt_201r")
'		end if
'	'20211215 아이티젠 김성수 추가 END
	elseif sEventName	=	"NATIONAL_CODE_INFO" then
		if sParam <> "" and sParam <> null then
			Select case sParam
				case "840" '미국
				        cmbExch.clear = true
					cmbExch.cbadddatatext = "01" & "`" & "미국"
				case "344" '홍콩
				        cmbExch.clear = true
					cmbExch.cbadddatatext = "02" & "`" & "홍콩"
				case "156" '중국
				        cmbExch.clear = true
					cmbExch.cbadddatatext = "03" & "`" & "상해"
					cmbExch.cbadddatatext = "04" & "`" & "심천"
				case "392" '일본
				        cmbExch.clear = true
					cmbExch.cbadddatatext = "05" & "`" & "일본"
			End Select
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'계좌기준 고객정보 조회
	if szTranID == "obacp_comm_005r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE" ,	0 , "1" )					'조회구분코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 			0 , Left(g_szFullAcnt,8) )		'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 			0 , MID(g_szFullAcnt, 9,2) )	'계좌일련번호
		
	elseif szTranID = "obtro_acnt_201r" then				
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 			0 , Left(g_szFullAcnt,8) 	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 			0 , MID(g_szFullAcnt, 9,2)  )							
		
		If g_szPlainRm == "1" Then
		    DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD" , 		0 , g_szPasswd)
		Else
		    DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD" , 		0 , Form.GetEncData(g_szPasswd))
		End If
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "EMPL_YN"		  , 	0 , "N"					)
		
		'211216 아이티젠 김성수 수정 START
'		if g_bNonePw == true then
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" , 	0 , "X") '계좌 비번 없이 조회
'		else
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" , 	0 , "1")
'		end if

		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" , 	0 , "X") '계좌 비번 없이 조회
		'211216 아이티젠 김성수 수정 END
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "QTTN_REG_CLCD" , 	0 , "0"					)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "QTTN_APLT_CLCD" ,	0 , cmbQttn.cbkeydata		)		'시세신청구분코드(1:전문가 2:비전문가)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	szSubErr = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert( "알림", szErrMsg.."\n("..szSubErr..")" )	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'계좌기준 고객정보 조회
	if szTranID == "obacp_comm_005r" then		
		g_szCUST_CLS_CODE = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "CUST_CLS_CODE" , 0 )	'고객구분코드(2:법인)
		
		'법인(전문가로 셋팅, 비전문가확인 비활성화)
		if g_szCUST_CLS_CODE == "2" then
			cmbQttn.cbkeydata = "1"
			chkAgrm.chksilence = "0"
			chkAgrm.unchkcaption = "전문가확인"
			chkAgrm.chkcaption = "전문가확인"
		else
			cmbQttn.cbkeydata = "2"
			chkAgrm.chksilence = "0"
			chkAgrm.chkcaption = "비전문가확인"
			chkAgrm.unchkcaption = "비전문가확인"
		end if
		
		'20230110 장시방 비번없이 전문가/비전문가 사용료 조회 START 
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201r", "InBlock1", "QTTN_APLT_CLCD" ,	0 , cmbQttn.cbkeydata		)		'시세신청구분코드(1:전문가 2:비전문가)		
		DATAMANAGER.RequestTranData("obtro_acnt_201r")
		'20230110 장시방 비번없이 전문가/비전문가 사용료 조회 END 
		
	elseif szTranID = "obtro_acnt_201r" then
		'211216 아이티젠 김성수 추가
'		g_bNonePw = false '최초 조회 후에 비번 없이 조회 못 하도록 초기화
	
		Dim nCnt, szOvrsStckMrktTrClsCode, szQttnApltClcd, szRegPrdClcd
		
		'211229 아이티젠 김성수 UI변경으로 인한 추가 START
		Dim szOVRS_QTTN_EXPN, szCRCD, szText
		'211229 아이티젠 김성수 UI변경으로 인한 추가 END
		
		nCnt = DATAMANAGER.GetDataCount( false, "obtro_acnt_201r", "OutBlock1" )
		
		for i = 0 to nCnt - 1 step 1
			szOvrsStckMrktTrClsCode = DATAMANAGER.GetDataValue( false, "obtro_acnt_201r", "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , i )
			szQttnRegClcd           = DATAMANAGER.GetDataValue( false, "obtro_acnt_201r", "OutBlock1", "QTTN_REG_CLCD" , i )			
			szRegPrdClcd            = DATAMANAGER.GetDataValue( false, "obtro_acnt_201r", "OutBlock1", "REG_PRD_CLCD" , i )
			szQttnApltClcd          = DATAMANAGER.GetDataValue( false, "obtro_acnt_201r", "OutBlock1", "QTTN_APLT_CLCD" , i )
			
			Select Case szOvrsStckMrktTrClsCode
				Case "01"
					grdStatus.SetCellData("bd_cell0", i, "미국")
				Case "02"
					grdStatus.SetCellData("bd_cell0", i, "홍콩")
				Case "03"
					grdStatus.SetCellData("bd_cell0", i, "상해")
				Case "04"
					grdStatus.SetCellData("bd_cell0", i, "심천")
				Case "05"
					grdStatus.SetCellData("bd_cell0", i, "일본")
			End Select
				
			Select Case szRegPrdClcd
				Case "1"
					grdStatus.SetCellData("bd_cell10", i, "자동연장")
				Case "2"
					grdStatus.SetCellData("bd_cell10", i, "기간선택")
				Case "3"
					grdStatus.SetCellData("bd_cell10", i, "당월")		
				Case ""
					grdStatus.SetCellData("bd_cell10", i, "")	
			End Select
			
			grdStatus.SetCellData("bd_cell6", i, "해지신청")	
			
			Select Case szQttnRegClcd
				Case "0"
					grdStatus.SetCellData("bd_cell1", i, "신청")
					grdStatus.SetCellData("bd_cell6", i, "해지신청")
					
					'20211229 아이티젠 김성수 추가
					grdStatus.SetCellFgColor( "bd_cell6", i, "4" )
					grdStatus.SetCellEnable("bd_cell6", i, true)
				Case "1"
					grdStatus.SetCellData("bd_cell1", i, "미신청")
					grdStatus.SetCellData("bd_cell6", i, "")
					 
					'20211229 아이티젠 김성수 추가
					grdStatus.SetCellFgColor( "bd_cell6", i, "100" )
					grdStatus.SetCellEnable("bd_cell6", i, false)
			End Select
			
			'211229 아이티젠 김성수 UI변경으로 인한 추가 START
			szOVRS_QTTN_EXPN		= CInt(DATAMANAGER.GetDataValue( false, "obtro_acnt_201r", "OutBlock1", "OVRS_QTTN_EXPN" , i ))
			szCRCD				= DATAMANAGER.GetDataValue( false, "obtro_acnt_201r", "OutBlock1", "CRCD" , i )
			szText				= ""
			
			if szOVRS_QTTN_EXPN <> "" and szOVRS_QTTN_EXPN <> null 
				and szCRCD <> "" and szCRCD <> null then
				
				szText = "월 " & szOVRS_QTTN_EXPN & " " & szCRCD
				
				grdStatus.SetCellData("bd_cell4", i, szText)
			end if
			
			
			'211229 아이티젠 김성수 UI변경으로 인한 추가 END
		next
		
	elseif szTranID = "obtro_acnt_201a" then
		if szCode = "Y" then
			Form.ShowAlert("알림", "등록 신청이 완료되었습니다.")
		elseif szCode = "N" then
			Form.ShowAlert("알림", "해지 신청이 완료되었습니다.")
		END IF
		
		'210607 LYI 시세조회및요청
		Form.requestOvStRealSise()
		
		DATAMANAGER.RequestTranData("obtro_acnt_201r")			
	end if
End Sub

'============================================================================
Sub grdStatus_OnClickUp(lRow, szCellID)	
	'20210714 HSZ
'	IF grdStatus.GetCellData("bd_cell6", lRow) = "해지신청" THEN
	
	IF szCellID = "bd_cell6" THEN '211229 아이티젠 김성수 수정 
		
		'211216 아이티젠 김성수 추가 START
		'비밀번호 체크
		if Form.GetTopCtlProp("edtPwd01", "caption") == nil or Form.GetTopCtlProp("edtPwd01", "caption") == "" then
			Form.ShowAlert("알림", "비밀번호를 확인해 주세요.")
			
			Exit Sub
		end if
		'211216 아이티젠 김성수 추가 END
		
		g_szOvrsStckMrktTrClsCode = grdStatus.GetCellData("bd_cell7", lRow)
		g_szQttnApltClcd          = grdStatus.GetCellData("bd_cell12", lRow)
		
		Form.OpenPopup("mbtro16090_p4" , grdStatus.GetCellData("bd_cell0", lRow) , "")
	END IF
End Sub

'============================================================================
Sub btnNotice_OnClick()
	Form.OpenFramePopup("mbtro16090_p3" , "" , "")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbtro16090_p1_RETURN" then
		g_szAgree = "Y"
		
		chkTerms.chksilence = "1"
	
	elseif sKeyName = "INFO_POPUP" then
		if sRet = "OK" then
			szCode = "N"
			
			' 비전문가 확인 상태를 Y값으로 고정
			DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "AGRM_YN" , 0 , "Y"					)
	
			DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , g_szOvrsStckMrktTrClsCode	)
			DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "QTTN_APLT_CLCD" 			 , 0 , g_szQttnApltClcd			)
			
			DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ACNO"		  , 0 , Left(g_szFullAcnt,8) 	)
			DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ASNO"		  , 0 , MID(g_szFullAcnt, 9,2)  )							
			
			If g_szPlainRm == "1" Then
			    DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "PWD" , 0 , g_szPasswd)
			Else
			    DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "PWD" , 0 , Form.GetEncData(g_szPasswd))
			End If
			
			DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "EMPL_YN"		  , 0 , "N"					)
			DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "QTTN_REG_CLCD" , 0 , "1"					)
			
			DATAMANAGER.RequestTranData("obtro_acnt_201a")					
		END IF
		
	elseif sKeyName = "INFO_RETURN" then
		if sRet <> "" then
			Dim szSplitData
			
			szSplitData = Split(sRet, "★")		
			
			g_szEngName 			= szSplitData[0]
			g_szEngAddress 		= szSplitData[1]			
			g_szEngOcptName 		= szSplitData[2]
			g_szEngCoName 		= szSplitData[3]
			g_szEngCoAddr 		= szSplitData[4]
			g_szEngClpsName 		= szSplitData[5]
			g_szEngRsnsBswrName 	= szSplitData[6]
			
			chkUserInfo.chksilence = "1"		
		end if
		
	'개인(신용)정보 동의 체크
	elseif sKeyName = "ALL_YN" then
		if sRet <> "" then
			g_szAllYn = sRet
			
			'전체동의가 Y이면, 개인신용정보동의 체크처리
			if g_szAllYn = "Y" Then
				chkAgree.chksilence = "1"
			end If
		end if

	'비전문가 확인팝업 RETURN
	elseif sKeyName == "mbtro16090_p5_RETURN" then
		g_szAgrm_yn = sRet
		
		chkAgrm.chksilence = "1"

	'전문가 확인팝업 RETURN
	elseif sKeyName == "mbtro16090_p8_RETURN" then
		g_szAgrm_yn = sRet
		
		chkAgrm.chksilence = "1"
	END if
End Sub

'============================================================================
Sub btnSubmit_OnClick()
	if f_RegistCheck() == true then
		szCode = "Y"
		
		if cmbQttn.cbkeydata == "2" then
			DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "AGRM_YN" , 0 , g_szAgrm_yn					)
		end if
		
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "QTTN_REG_CLCD" , 0 , "0"					)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "EMPL_YN"		  , 0 , "N"					)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ACNO"		  , 0 , Left(g_szFullAcnt,8) 	)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ASNO"		  , 0 , MID(g_szFullAcnt, 9,2)  )										
		
		If g_szPlainRm == "1" Then
		    DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "PWD" , 0 , g_szPasswd)
		Else
		    DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "PWD" , 0 , Form.GetEncData(g_szPasswd))
		End If
		
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , cmbExch.cbkeydata	)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "QTTN_APLT_CLCD" 			 , 0 , cmbQttn.cbkeydata	)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "REG_PRD_CLCD" 			 , 0 , cmbPeriod.cbkeydata	)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "STA_DATE" 			 	 , 0 , cldFrom.caption		)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "FIN_DATE" 			 	 , 0 , cldTo.caption		)
		
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "CUST_ENG_NAME" 			 , 0 , g_szEngName		)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ENG_ADDR" 			 	 , 0 , g_szEngAddress		)	
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ENG_OCPT_NAME" 		 	 , 0 , g_szEngOcptName		)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ENG_CO_NAME" 		 	 , 0 , g_szEngCoName		)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ENG_CO_ADDR" 		 	 , 0 , g_szEngCoAddr		)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "CLPS_NAME" 			 	 , 0 , g_szEngClpsName		)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "RSNS_BSWR_NAME"		 	 , 0 , g_szEngRsnsBswrName	)	
	
		DATAMANAGER.RequestTranData("obtro_acnt_201a")
	end if
End Sub

'============================================================================
Sub cmbPeriod_OnEditComplete(iIndex)
	if iIndex = 0 then			'자동연장
		cldFrom.enable = false
		cldFrom.caption = Form.GetSharedData("&HOST_DATE", false )
		cldTo.enable = false
		cldTo.caption = "99991201"
		
	elseif iIndex = 2 then			'당월
		cldFrom.enable = false
		cldTo.enable = false
		cldFrom.caption = Form.GetSharedData("&HOST_DATE", false )
		cldTo.caption = Form.GetSharedData("&HOST_DATE", false )
		
	else							'기간선택
		cldFrom.enable = true
		cldTo.enable = true
		cldFrom.caption = Form.GetSharedData("&HOST_DATE", false )
		cldTo.caption = Form.GetSharedData("&HOST_DATE", false )
	end if
End Sub

'============================================================================
' 등록버튼 활성화 체크
'============================================================================
Sub f_RegistCheck()
	'비밀번호 체크
	if Form.GetTopCtlProp("edtPwd01", "caption") == nil or Form.GetTopCtlProp("edtPwd01", "caption") == "" then
		Form.ShowAlert("알림", "비밀번호를 확인해 주세요.")
		return false
	end if
	
	'이용약관 체크
	if chkTerms.checkstate ~= "1" then
		Form.ShowAlert("알림", "이용약관을 확인해 주세요.")
		return false
	end if
	
	'비전문가인 경우에만 체크
	if cmbQttn.cbkeydata == "2" then
		'비전문가확인 체크
		if chkAgrm.checkstate ~= "1" then
			Form.ShowAlert("알림", "비전문가확인을 확인해 주세요.")
			return false
		end if
	else
		'전문가확인 체크
		if chkAgrm.checkstate ~= "1" then
			Form.ShowAlert("알림", "전문가확인을 확인해 주세요.")
			return false
		end if
	end if
	
	'신청자정보입력 체크
	if chkUserInfo.checkstate ~= "1" then
		Form.ShowAlert("알림", "신청자정보입력을 확인해 주세요.")
		return false
	end if
	
	'개인(신용)정보 동의 체크
	if ChkAgree.checkstate ~= "1" then
		Form.ShowAlert("알림", "개인(신용)정보 동의를 확인해 주세요.")
		return false
	end if
	
	return true
End Sub

'============================================================================
' 이용약관 체크
'============================================================================
Sub chkTerms_OnChange(sCheckState)
	if sCheckState == "1" then
		Form.OpenFramePopup("mbtro16090_p1", "" , "")
		
'		g_szAgree = "Y"
		
		chkTerms.chksilence = "0"
	end if
End Sub

'============================================================================
' 비전문가확인 체크
'============================================================================
Sub chkAgrm_OnChange(sCheckState)
	if sCheckState == "1" then
		'법인(전문가)
		if g_szCUST_CLS_CODE == "2" then
			Form.OpenFramePopup("mbtro16090_p8", "" , "")
		else
			Form.OpenFramePopup("mbtro16090_p5", "" , "")
		end if
		
		chkAgrm.chksilence = "0"
	end if
End Sub

'============================================================================
' 신청자정보입력 체크
'============================================================================
Sub chkUserInfo_OnChange(sCheckState)
	if sCheckState == "1" then
		Dim szSendData
		szSendData = g_szEngName & "★" & g_szEngAddress & "★" & g_szEngOcptName & "★" & g_szEngCoName & "★" & g_szEngCoAddr & "★" & g_szEngClpsName & "★" & g_szEngRsnsBswrName
		
		Form.OpenFramePopup("mbtro16090_p2" , szSendData , "")
		
		chkUserInfo.chksilence = "0"
	end if
End Sub

'============================================================================
' 개인(신용)정보 동의 체크
'============================================================================
Sub chkAgree_OnChange(sCheckState)
	if sCheckState == "1" then
		'내용 팝업
		Dim sURL 
		sURL = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm6.pdf"
		
		acno = Form.GetCtlProp("#acnt01", "caption")
		
		Form.SetSharedData("ACNO"  , acno )	'계좌번호
		Form.SetSharedData("EMPLYN", "N"  )	'직원여부
		Form.SetSharedData("OPEN_URL"  , sURL )	'PDF링크
		
		Form.OpenFramePopup("mbtro16090_p6" , "해외주식 개인정보처리 요약동의서" , "")
		
		chkAgree.chksilence = "0"
	end if
End Sub

