'--===========================================================================
'--===========================================================================
'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szTitle	'타이틀
Dim g_szAcno	'계좌번호

g_szTitle=""
g_szAcno=""
'============================================================================
Sub Form_OnFormInit()
	Dim szList
	Dim szTemp
	
	szTemp = Form.GetOpenLinkData()
	
	if	len(trim(szTemp))	<>	0	then
		szList = Split(szTemp, "★")
		
		g_szTitle = szList(0)
		g_szAcno = szList(1)
		
	end if
End Sub

'============================================================================
Sub btnReg_OnClick()
	
	DATAMANAGER.RequestTranData("obcsb_acad_107a")
			
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obcsb_acad_107a" then
	
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_107a" , "InBlock1" , "PROS_CLS_CODE" , 0 , "I" )	'처리구분코드
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_107a" , "InBlock1" , "CONT_CLS_CODE" , 0 , "4" )	'접촉구분코드
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_107a" , "InBlock1" , "ACNO"	 		, 0 , g_szAcno )	'계좌번호
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_107a" , "InBlock1" , "CUST_TYPE_CODE" , 0 , "01" )	'고객유형코드
		
		
	end if
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	'Form.ShowAlert("알림", "펀드 실질투자수익률 보고서 통보처 선택은 필수입니다.")
	Form.SendReturnToParent( "returnACTL_RPRT_INAG" , "FAIL")
	Form.CloseForm()
	'Exit Sub
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Form.SendReturnToParent( "returnACTL_RPRT_INAG" , "SUCC")
	Form.CloseForm()
End Sub

'============================================================================
Sub Image0_OnClick()
	'Form.CloseForm()
End Sub

