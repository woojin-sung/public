'--===========================================================================
'--===========================================================================
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim szLinkedData
	
	szLinkedData = ""
	
	szLinkedData = Form.GetOpenLinkData()
	
	Table0.SetCellString( 1, 0, getListItem(szLinkedData,8)) ' 사는통화
	Table0.SetCellString( 2, 0, getListItem(szLinkedData,4)) ' 원화통화코드
	Table0.SetCellString( 1, 1, getListItem(szLinkedData,1)) ' 원화전잔금액
	Table0.SetCellString( 1, 2, getListItem(szLinkedData,2)) ' 원화금잔금액
	Table0.SetCellString( 1, 3, getListItem(szLinkedData,3)) ' 원화실제환전금액
	
	Table0.SetCellString( 3, 0, getListItem(szLinkedData,9)) ' 파는통화
	Table0.SetCellString( 4, 0, getListItem(szLinkedData,0)) ' 원화통화코드
	Table0.SetCellString( 2, 1, getListItem(szLinkedData,5)) ' 원화전잔금액
	Table0.SetCellString( 2, 2, getListItem(szLinkedData,6)) ' 원화금잔금액
	Table0.SetCellString( 2, 3, getListItem(szLinkedData,7)) ' 원화실제환전금액
	
	
End Sub



'============================================================================
'ImageClose_OnClick
'============================================================================
Sub ImageClose_OnClick()
	Form.CloseForm()
End Sub


