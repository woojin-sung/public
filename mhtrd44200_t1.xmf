	<SCRIPT_INFO _len="3735" _ulen="3685" >
Dim g_szThemeCode
Dim g_szExchCode
Dim g_szCode
'============================================================================
Sub Form_OnFormInit()
	rdoTheme.currentindex = "0"
	
	grdList.subformname = "mhtrd44200_p1"
	grdList.subformindex = -1
	
	grdList.highlightuse = "0"
	
	grdList.setSiseCtrlId("bd_cell1:bd_cell6:bd_cell2:bd_cell3:bd_cell4")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "ohhts_6500_003r" then
		DATAMANAGER.SetDataValue( false, "ohhts_6500_003r", "InBlock1", "FID_PROD_CLCD" , 0 , g_szThemeCode )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_6500_003r" then
		Dim szName, szCode
		Dim nCnt, nIndex
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_6500_003r", "OutBlock1")
		nIndex = Cint(grdList.rowcount) - nCnt
		
		for i = 0 to nCnt - 1
			szCode = DATAMANAGER.GetDataValue(0, "ohhts_6500_003r", "OutBlock1", "FID_OVDV_ISCD" , i)
			szName = Form.GetItemCodeInfo(szCode, "name")
			
			grdList.SetCellData("bd_cell5", nIndex+i, szName)
		next
		
		DATAMANAGER.RequestRealData( "ohhts_ovdv_cntg" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if szTranID = "ohhts_ovdv_cntg" then
		for i=0 to grdList.rowcount - 1
			Dim szCode
			szCode = grdList.GetCellData("bd_cell0", i)
			DATAMANAGER.SetDataValue( 1, "ohhts_ovdv_cntg", "InBlock1", "FID_OVDV_ISCD" , i ,  szCode)
		next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	 szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
  
	 if Trim(szSubMsg) <> "" then
		 Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	 else
		 Form.ShowAlert("알림", szErrMsg)
	 end if
End Sub

'============================================================================
Sub rdoTheme_OnClick(nIndex)
	grdList.SetClear()
	
	Select Case nIndex
		Case 0 
			g_szThemeCode = "10"
		Case 1 
			g_szThemeCode = "30"
		Case 2 
			g_szThemeCode = "20"
		Case 3 
			g_szThemeCode = "50"
		Case 4 
			g_szThemeCode = "60"
		Case 5 
			g_szThemeCode = "40"
	End Select
	
	DATAMANAGER.CancelRealData( "ohhts_ovdv_cntg" )
	DATAMANAGER.ClearInputData( 1, "ohhts_ovdv_cntg" )
	DATAMANAGER.ClearOutputData( 1, "ohhts_ovdv_cntg" )
	
	DATAMANAGER.RequestTranData( "ohhts_6500_003r" )
End Sub

'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
'	Dim szCode
	szCode = grdList.GetCellData("bd_cell0", lRow)
	
	g_szCode = szCode
	
	listLocation =  Split(grdList.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	Move_Popup(szCode, nYPos, height)
End Sub

'============================================================================
' Move_Popup 
'============================================================================
Function Move_Popup(szCode, nYPos, height)
	szData = szCode & "★" & nYPos & "★" & height & "★현재가★차트★매수★매도★관심등록★"
	
	Screen_No(szData)
End Function

'============================================================================	
Function Screen_No(szScreen0)
	Form.OpenPopup("mhtrd44200_p1" , szScreen0, "")
End Function

'============================================================================
Sub grdList_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("ohhts_6500_003r") = true then
		DATAMANAGER.RequestNextData("ohhts_6500_003r")
	end if
End Sub

