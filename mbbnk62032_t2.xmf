		<EDIT name="edtDrngAcntAls2" imetype="0" hintcaption="최대 10글자 이내" senddatafield="obtss_opnf_022a.InBlock1.DRNG_ACNT_ALS" ly_vert="130,83,166,39,1" export="1,0,6" />
