	<SCRIPT_INFO _len="4892" _ulen="4516" >
'============================================================================
' 01. 화 면 명 : 선옵 가상체결증거금 조회 기존잔고
' 02. 화면설명 : 선옵 가상체결증거금 조회 기존잔고 그리드
' 03. 작    성 : 2016.01.12 ~ 최지희
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAccountNumber			'계좌번호
Dim g_nAccountSerialNumber		'일련번호
Dim g_szAccountPassword		'비밀번호
Dim j

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(g_nAccountNumber, g_nAccountSerialNumber)
	DATAMANAGER.SetDataValue(0,"obtrf_cntg_702r", "InBlock1", "ACNO", 0 , g_nAccountNumber)
	DATAMANAGER.SetDataValue(0,"obtrf_cntg_702r", "InBlock1", "ASNO", 0 , g_nAccountSerialNumber)
	DATAMANAGER.SetDataValue(0,"obtrf_cntg_702r", "InBlock1", "ACNT_PWD", 0 , g_szAccountPassword)
	DATAMANAGER.RequestTranData("obtrf_cntg_702r")
End Function

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "ExistBalance" then
		Dim szList
		szList = Split(sParam, "★")
		if UBound(szList) < 1 then
			exit sub
		end if
		
		g_nAccountNumber = szList(0)
		g_nAccountSerialNumber = szList(1)
		g_szAccountPassword = szList(2)
		j=0
		TR_Inquiry(g_nAccountNumber, g_nAccountSerialNumber)
		
	end if
End Sub

'============================================================================
' grdExistBalance_OnClickUp - 그리드 행 선택시 트리거를 이용해 가상잔고로 데이터 전송
'============================================================================
Sub grdExistBalance_OnClickUp(lRow, szCellID)

	Dim szIscd	'종목코드
	Dim szSort	'구분(매수/매도)
	Dim szAmount	'수량
	Dim szPrice	'매입가
	Dim szPosition	'포지션코드
	Dim szInterlock	'종목연동
	
	Dim szAllData		'종목코드★구분★수량★매입가★포지션코드★종목연동
	
	if lRow >= 0 then
		szIscd = grdExistBalance.GetCellData( "bd_cell0", lRow )
		szSort = grdExistBalance.GetCellData( "bd_cell1", lRow )
		szAmount = grdExistBalance.GetCellData( "bd_cell2", lRow )
		szPrice = grdExistBalance.GetCellData( "bd_cell3", lRow )
		szPosition = grdExistBalance.GetCellData( "bd_cell4", lRow )
		szInterlock = grdExistBalance.GetCellData( "bd_cell5", lRow )
		
		szAllData = szIscd & "★" & szSort & "★" & szAmount & "★" & szPrice & "★" & szPosition & "★" & szInterlock
		
		Form.triggerEvent("#", "ImagineBalance", szAllData)
	end if 

End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtrf_cntg_702r" then
		for i=0 to DATAMANAGER.GetDataCount(0, "obtrf_cntg_702r", "OutBlock2")-1
			j= j+1
			Dim szCode		'포지션 구분코드
			Dim szData		'받은 포지션 구분코드를 변환하여 구분으로 변환
			Dim szTemp		'종목코드의 1~12자리까지를 추출하기 위한 변수
			szData = ""
			szCode = DATAMANAGER.GetDataValue(0, "obtrf_cntg_702r", "OutBlock2", "PSTN_CLS_CODE" , i)
			szData = Form.GetMetaData("포지션구분코드", szCode)
			grdExistBalance.SetCellData( "bd_cell1", j-1, szData )
			szTemp = Mid(DATAMANAGER.GetDataValue(0,"obtrf_cntg_702r", "OutBlock2", "ISCD", i), 1, 12)
			grdExistBalance.SetCellData( "bd_cell5", j-1, szTemp )
			
			grdExistBalance.SetCellData( "bd_cell3", i, Round(DATAMANAGER.GetDataValue(0, "obtrf_cntg_702r", "OutBlock2", "ACBK_UNPR" , i), 2) )
		next		
	end if	
End Sub


'============================================================================
' grdExistBalance_OnScrollEnd
'============================================================================
Sub grdExistBalance_OnScrollEnd()
	DATAMANAGER.RequestNextData("obtrf_cntg_702r")
End Sub

