	<SCRIPT_INFO _len="8427" _ulen="7603" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 바이오인증
' 02. 화면설명 : 바이오인증 - 본인확인
' 03. 작    성 : 2016.11.14 함원규
'-------------------------------------------------------------------------------------------
'20200910 SWJ START 메모리평문제거 (plain_rm = 0 미적용 / plain_rm = 1 적용)
'20201116 SWJ START 실명확인번호 암호화 (rcno_plain_rm = 0 미적용 / rcno_plain_rm = 1 적용)
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim gRCNO
Dim gCUST_ABWR_NAME
' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm =""

' 20201116 SWJ START : 실명확인번호 암호화 적용구분값
Dim rcno_plain_rm
rcno_plain_rm =""

Dim g_MediaType
g_MediaType =""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Edit1.certname = "실명확인번호"

'20201116 SWJ START : 실명확인번호 암호화(예외처리 해제)
	g_MediaType   = Form.GetSharedData("&MEDIA_CODE"   , false)

	'rcno_plain_rm = ( 0 : 미적용/ 1 : 적용)
	rcno_plain_rm = Form.GetSharedData("&RCNO_PLAIN_RM", false)
	
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	if rcno_plain_rm <> "1" or g_MediaType == "158" or g_MediaType == "159" then
		'20200910 SWJ START
		'MTS메모리평문 적용유무
		if plain_rm == "1" then
			Edit1.SetEncExcept() 		'실명확인번호 : obcsb_efif_251r 서비스와 비교 시 예외처리
		end if
		'20200910 SWJ END
	end if
'20201116 SWJ END

	Table3.SetCellString(0, 0, "ID 찾기 >")
	Table3.SetCellString(0, 1, "계좌번호 찾기 >")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "TabChange" then
	    if sParam == "bio_new" then
			Table1.visible = false
			Table0.visible = true
	    elseif sParam == "bio_cancel" then
			Table1.visible = true
			Table0.visible = false
	    end if
	elseif sEventName == "NextCheck" then '다음버튼 클릭 시 트리거 
	 
		if Edit0.caption == null or Edit0.caption == "" then
			Form.MsgBox( "알림", "사용자 ID를 입력하세요.", "", 6 )
		elseif Edit1.caption == null or Edit1.caption == "" then			
			Form.MsgBox( "알림", "실명확인번호를 입력하세요.", "", 6 )
		elseif Edit2.caption == null or Edit2.caption == "" then			
			Form.MsgBox( "알림", "종합계좌번호를 입력하세요.", "", 6 )
		elseif Edit3.caption == null or Edit3.caption == "" then			
			Form.MsgBox( "알림", "계좌 비밀번호를 입력하세요.", "", 6 )
		else 
		    '본인 확인 유효성체크
			DATAMANAGER.RequestTranData( "obcsb_efif_251r" )
		end if
	elseif sEventName == "BeforeCheck" then
	
	     Form.triggerEvent( "#", "BeforeStep", "1" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_efif_251r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_efif_251r", "InBlock1", "ELFN_ID" , 0 , Edit0.caption ) '사용자 ID
	end if
	
	if szTranID == "obacp_opop_007r" then
		Dim sRCNO, sACNT_PWD
		sRCNO = gRCNO
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			sACNT_PWD = Edit3.caption
		'MTS메모리평문제거 미적용상태일 때
		else	
			sACNT_PWD = Form.GetEncData(Edit3.caption)
		end if
		'20200910 SWJ END
		
		'20201116 SWJ START : 실명확인번호 암호화(RCNO > RCNO_PIP 로 변경)
		if rcno_plain_rm <> "1" or g_MediaType == "158" or g_MediaType == "159" then '고유MTS 미적용
			DATAMANAGER.SetDataValue( 0, "obacp_opop_007r", "InBlock1", "RCNO"     , 0 , sRCNO )
		else		
			DATAMANAGER.SetDataValue( 0, "obacp_opop_007r", "InBlock1", "RCNO_PIP" , 0 , sRCNO )
		end if
		'20201116 SWJ END
		
		DATAMANAGER.SetDataValue( 0, "obacp_opop_007r", "InBlock1", "ACNO" , 0 , Edit2.caption )
		DATAMANAGER.SetDataValue( 0, "obacp_opop_007r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_efif_251r" then
		
		'20201116 SWJ START : 실명확인번호 암호화(RCNO > RCNO_PIP로 변경)
		if rcno_plain_rm <> "1" or g_MediaType == "158" or g_MediaType == "159" then '고유MTS 미적용
			gRCNO = DATAMANAGER.GetDataValue( 0, "obcsb_efif_251r", "OutBlock1", "RCNO" , 0 ) '실명확인번호
		else
			gRCNO = DATAMANAGER.GetDataValue( 0, "obcsb_efif_251r", "OutBlock1", "RCNO_PIP" , 0 ) '실명확인번호
		end if
		'20201116 SWJ END
		
		gCUST_ABWR_NAME = DATAMANAGER.GetDataValue( 0, "obcsb_efif_251r", "OutBlock1", "CUST_ABWR_NAME" , 0 ) '고객약어 명
		
		'20170828 LES START - USERID 헤더값 세팅
		DATAMANAGER.SetUserID(Edit0.caption)
		'20170828 LES END
		
		if Edit1.caption == gRCNO then
			DATAMANAGER.RequestTranData( "obacp_opop_007r" )
			Form.SetSharedData("CERT_ID" , Edit0.caption)
			Form.SetSharedData("CERT_RCNO" , Edit1.caption)
			Form.SetSharedData("CERT_USER_NAME" , sCUST_ABWR_NAME)
		
		else
			Form.MsgBox( "알림", "고객정보가 일치하지 않습니다. 입력하신 ID의 실명확인번호가 일치하지 않습니다.", "", 6 ) '20160519_01 KBC
		end if
	
	elseif szTranID == "obacp_opop_007r" then
		Dim sCSNM, sName
		sName = gCUST_ABWR_NAME
		sCSNM = DATAMANAGER.GetDataValue( 0, "obacp_opop_007r", "OutBlock1", "CSNM" , 0 )
		
		'20170103 HWG START - BIO인증시, OCSP 검증에 필요한 고객명 Shared
		Form.SetSharedData("BIO_CSNM" , sCSNM)
		'20170103 HWG END
		
		if sCSNM == null or Trim(sCSNM) == "" or (Trim(sName) ~= Trim(sCSNM)) then
			Form.MsgBox( "알림", "고객정보가 일치하지 않습니다.", "", 6 )
		else
			Dim sACNT_PWD
			
			'20200910 SWJ START
			'MTS메모리평문제거 적용상태일 때
			if plain_rm == "1" then
				sACNT_PWD = Edit3.caption
			'MTS메모리평문제거 미적용상태일 때
			else	
				sACNT_PWD = Form.GetEncData(Edit3.caption)
			end if
			'20200910 SWJ END
			
			Form.SetSharedData("CERT_ACNO" , Edit2.caption)
			Form.SetSharedData("CERT_ACNT_PWD" , sACNT_PWD)
			
			Form.triggerEvent( "#", "NextStep", "2" )	
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obcsb_efif_251r" then
		Dim sSubMsg
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			szErrMsg = szErrMsg.." "..sSubMsg
		end if
		
		Form.MsgBox( "알림", szErrMsg, "", 6 )
		
	elseif szTranID == "obacp_opop_007r" then
		Dim sSubMsg
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			szErrMsg = szErrMsg.." "..sSubMsg
		end if
		
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub


'============================================================================
Sub Table3_OnClick(lRow , lColumn)
	
	if lColumn  == 0 then
		Form.OpenPopup("mhetc90020_pa", "mhetc90020_pa_ELFN_ID", "")
	'계좌번호 찾기
	elseif lColumn  == 1 then
		Form.OpenPopup("mbonl85001", "", "")
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	' ID 찾기 완료
	if sKeyName == "mhetc90020_pa" then
		Edit0.caption = sRet
	
	' 계좌번호찾기 완료
	elseif sKeyName == "mbonl85001" then
		
		if len(sRet) > 8 then
			Dim sAcntArr
			sAcntArr = split(sRet, "-")
			
			Edit2.caption = sAcntArr(0)
		else
			Edit2.caption = sRet
		end if
		
	end if
	
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obcsb_efif_251r" trcode="obcsb_efif_251r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obacp_opop_007r" trcode="obacp_opop_007r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obcsb_efif_251r" title="고객ID로 주민번호 성명 조회(홈" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="46" _ulen="38" >

ELFN_ID^전자금융 ID^20^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="225" _ulen="173" >

RCNO^실명확인번호^13^0^0^0^0^0^0
CUST_ABWR_NAME^고객 약어 명^40^0^0^0^0^0^0
DN_DATA^DN 데이터^256^0^0^0^0^0^0
RCNO_PIP^실명확인번호PIP^68^0^0^0^0^0^0
UI_RCNO^UI실명확인번호^14^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
			<TRAN name="obacp_opop_007r" title="사업자번호와 계좌번호 Login체?" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="170" _ulen="126" >

RCNO^실명확인번호^13^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0
ACNT_PWD^계좌비밀번호^68^0^0^0^0^0^0
RCNO_PIP^실명확인번호PIP^68^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="37" _ulen="31" >

CSNM^고객명^40^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
	</DATAIO_INFO>
</ROOT>