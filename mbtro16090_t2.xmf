--===========================================================================

Dim g_szEngName		'구독자 영문이름
Dim g_szEngAddress	'구독자 영문주소
Dim g_szEngJob		'구독자 영문직업명
Dim g_szEngCompany	'구독자 영문회사명
Dim g_szEngWorkAddr	'구독자 영문회사주소

Dim g_szOvrsStckMrktTrClsCode
Dim g_szQttnApltClcd

Dim g_szAgree			'이용계약 동의여부

Dim g_szFullAcnt, g_szPasswd, g_szPlainRm

g_CheckBtn3Cnt = 0  	'이용약관 카운트 횟수 - 2019.11.04

g_szEngName = ""
g_szEngAddress = ""
g_szEngJob = ""
g_szEngCompany = ""
g_szEngWorkAddr = ""
g_szAgree = ""
g_szPlainRm = ""		'MTS메모리평문 적용여부

'============================================================================
Sub Form_OnFormInit()
	cldFrom.caption = Form.GetSharedData("&HOST_DATE", false )
	cldTo.caption = "99991231"

	g_szFullAcnt = Form.GetCtlProp("#acnt01", "caption")
	g_szPasswd	= Form.GetCtlProp("#edtPwd01", "caption")
	
	'MTS메모리평문 적용유무 (0:미적용 / 1:적용) - 2020.09.17
	g_szPlainRm = Form.GetSharedData("&PLAIN_RM", false)
End Sub

'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName		= "PWDINFO_CHG" then
		g_szPasswd	=	sParam
		
		if len(trim(g_szFullAcnt))	>	8	and	len(trim(g_szPasswd)) > 0	then			
			DATAMANAGER.RequestTranData("obtro_acnt_201r")			
		end if
	
	elseif sEventName	=	"ACNTINFO_CHG" then
		g_szFullAcnt = Form.GetSharedData("&ACCOUNT", 0 )
		g_szPasswd	= Form.GetCtlProp("#edtPwd01", "caption")
		
		grdStatus.rowcount = "0"
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtro_acnt_201r" then		
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", 0 , "%" 	)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201r", "InBlock1", "QTTN_APLT_CLCD"		  	, 0 , "%" 	)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201r", "InBlock1", "ACNO"		  			, 0 , Left(g_szFullAcnt   ,8))
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201r", "InBlock1", "ASNO"		  			, 0 , MID(g_szFullAcnt , 9,2))							
		
		If g_szPlainRm == "1" Then
		    DATAMANAGER.SetDataValue(0, "obtro_acnt_201r", "InBlock1", "PWD" 				, 0 , g_szPasswd)
		Else
		    DATAMANAGER.SetDataValue(0, "obtro_acnt_201r", "InBlock1", "PWD" 				, 0 , Form.GetEncData(g_szPasswd))
		End If	
		
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201r", "InBlock1", "REG_PRD_CLCD"		  	, 0 , "%"					)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201r", "InBlock1", "QTTN_REG_CLCD" 			, 0 , "%"					)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201r", "InBlock1", "STA_DATE" 				, 0 , cldFrom.caption			)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201r", "InBlock1", "FIN_DATE" 				, 0 , cldTo.caption			)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201r", "InBlock1", "EMPL_YN"		  			, 0 , "N"					)
		DATAMANAGER.SetDataValue(0, "obtro_acnt_201r", "InBlock1", "PROS_CLS_CODE" 			, 0 , "2"					)		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	szSubErr = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.ShowAlert( "알림", szErrMsg.."\n("..szSubErr..")")		
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtro_acnt_201r" then
		Dim nCnt, nRowIdx, szOvrsStckMrktTrClsCode, szQttnApltClcd, szRegPrdClcd,szQttnRegClcd,szChanTypeClsCode
		
		nCnt = DATAMANAGER.GetDataCount( false, "obtro_acnt_201r", "OutBlock1" )
		
		for i = 0 to nCnt - 1 step 1
			nRowIdx = grdStatus.rowcount - nCnt + i
			
			szOvrsStckMrktTrClsCode = DATAMANAGER.GetDataValue( false, "obtro_acnt_201r", "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , i )
			szQttnRegClcd           = DATAMANAGER.GetDataValue( false, "obtro_acnt_201r", "OutBlock1", "QTTN_REG_CLCD" , i )			
			szRegPrdClcd            = DATAMANAGER.GetDataValue( false, "obtro_acnt_201r", "OutBlock1", "REG_PRD_CLCD" , i )
			szQttnApltClcd          = DATAMANAGER.GetDataValue( false, "obtro_acnt_201r", "OutBlock1", "QTTN_APLT_CLCD" , i )
			szChanTypeClsCode       = DATAMANAGER.GetDataValue( false, "obtro_acnt_201r", "OutBlock1", "CHAN_TYPE_CLS_CODE" , i )
			
			Select Case szOvrsStckMrktTrClsCode
				Case "01"
					grdStatus.SetCellData("bd_cell0", nRowIdx, "미국")
				Case "02"
					grdStatus.SetCellData("bd_cell0", nRowIdx, "홍콩")
				Case "03"
					grdStatus.SetCellData("bd_cell0", nRowIdx, "상해A")
				Case "04"
					grdStatus.SetCellData("bd_cell0", nRowIdx, "심천A")
				Case "05"
					grdStatus.SetCellData("bd_cell0", nRowIdx, "일본")
			End Select
						
			Select Case szRegPrdClcd
				Case "1"
					grdStatus.SetCellData("bd_cell10", nRowIdx, "자동연장")
				Case "2"
					grdStatus.SetCellData("bd_cell10", nRowIdx, "기간선택")
				Case "3"
					grdStatus.SetCellData("bd_cell10", nRowIdx, "당월")				
			End Select
			
			Select Case szQttnRegClcd
				Case "0"
					grdStatus.SetCellData("bd_cell1", nRowIdx, "")
				Case "1"
					grdStatus.SetCellData("bd_cell1", nRowIdx, "해지")
			End Select
			
			Select Case szChanTypeClsCode
				Case "020"
					grdStatus.SetCellData("bd_cell6", nRowIdx, "HTS")
				Case "010"
					grdStatus.SetCellData("bd_cell6", nRowIdx, "창구")
				Case "156"
					grdStatus.SetCellData("bd_cell6", nRowIdx, "MTS")
				Case "157"
					grdStatus.SetCellData("bd_cell6", nRowIdx, "MTS")
			End Select 
		next
		
	elseif szTranID = "obtro_acnt_201a" then
		
	end if
End Sub

'============================================================================
Sub btnNotice_OnClick()
	Form.OpenFramePopup("mbtro16090_p3" , "" , "")	
End Sub

