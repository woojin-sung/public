	<SCRIPT_INFO _len="3764" _ulen="3546" >
'============================================================================
' 01. 화 면 명 : 고객자산평가_고객별자산
' 02. 화면설명 : 고객자산평가_고객별자산
' 03. 작    성 : 2016. 02. 04. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim nCellType			'토글 상태를 구분하기 위한 변수
Dim szTemp			'고객번호
Dim szACNO			'계좌번호
Dim szUSERID
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetInput(szData) : TR의 입력값 세팅
'============================================================================
Function SetInput(szData)

	DATAMANAGER.SetDataValue( 0 , "obacb_balc_151r", "InBlock1", "CSNO" , 0 , szData)
	DATAMANAGER.RequestTranData( "obacb_balc_151r" )
	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()		자산유형 출력값 세팅
'============================================================================
Sub Form_OnFormInit()

	szDate = right(Form.GetSharedData("&HOST_DATE" , false), 6)
	lblDate.caption = szDate
	

	szACNO = ""
	
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam) : 트리거에서 입력받은 계좌번호를 사용하여 입력 세팅
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "mbact71052_t3" then		'고객별자산
		szTemp = sParam
		Call SetInput(szTemp)	
	end if

End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) 
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacb_balc_151r" then
		nPrlsrate = DATAMANAGER.GetDataValue( 0 , "obacb_balc_151r", "OutBlock1", "PLRT" , 0)			'손익률
		nPrlsamt = DATAMANAGER.GetDataValue( 0 , "obacb_balc_151r", "OutBlock1", "VLTN_PRLS_AMT" , 0)	'평가손익
		if CDBL(nPrlsamt) > 0 then
			szPrls = "+"..FormatNumber(nPrlsamt,0).."원   |   +"..FormatNumber(nPrlsrate,2).."%"
			Table0.SetCellString(0, 1, szPrls)
			Table0.SetCellFgColor(0, 1, "10")
		elseif CDBL(nPrlsamt) < 0 then
			szPrls = FormatNumber(nPrlsamt,0).."원   |   "..FormatNumber(nPrlsrate,2).."%"
			Table0.SetCellString(0, 1, szPrls)
			Table0.SetCellFgColor(0, 1, "11")
		else
			szPrls = FormatNumber(nPrlsamt,0).."원   |   "..FormatNumber(nPrlsrate,2).."%"
			Table0.SetCellString(0, 1, szPrls)
			Table0.SetCellFgColor(0, 1, "4")
		end if
	end if
	
End Sub
'============================================================================
'Sub Form_OnRefresh()
'	Call SetInput(szTemp)	
'End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
End Sub

'============================================================================
Sub imgRefresh_OnClick()
	Form.triggerEvent("#", "Refresh", "t3")
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obacb_balc_151r" trcode="obacb_balc_151r" compress="1" encryption="1" timeout="180" inputcheck="1" useattr="0" >
				<TRBLOCK name="InBlock1" >
					<FIELD name="IQRY_CLS_CODE" idx="0" defconst="2" />
				</TRBLOCK>
			</TRAN>
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obacb_balc_151r" title="고객 자산현황 합계조회(MTS)" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="160" _ulen="124" >

IQRY_CLS_CODE^조회구분코드^1^0^0^0^0^0^0
ELFN_ID^전자금융ID^20^0^0^0^0^0^0
CSNO^고객번호^10^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="317" _ulen="251" >

VLTN_AMT^평가 금액^19^0^7^0^0^0^0
VLTN_PRLS_AMT^평가 손익 금액^19^0^7^0^0^0^0
DRNG_ABLE_AMT^출금 가능 금액^19^0^7^0^0^0^0
PLRT^손익률^23^6^7^0^0^0^0
BYNG_AMT^매입 금액^19^0^7^0^0^0^0
LOAN_AMT^대출금액^19^0^7^0^0^0^0
TFAM^예수금^19^0^7^0^0^0^0
UNAM^미수금^19^0^7^0^0^0^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
	</DATAIO_INFO>
