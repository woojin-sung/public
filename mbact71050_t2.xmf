	<SCRIPT_INFO _len="4656" _ulen="4374" >
'============================================================================
' 01. 화 면 명 : 고객자산평가_계좌별자산
' 02. 화면설명 : 고객자산평가_계좌별자산
' 03. 작    성 : 2016. 02. 04. 유창재
' 2021.07.05 : 정민영 : v0001 : obcsb_efif_005r IO재매핑
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim szACNO			'계좌번호
Dim szTemp			'트리거에서 받아온 데이터 저장 변수
Dim szUSERID
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetInput(szData) : TR의 입력값 세팅
'============================================================================
Function SetInput(szData)

	DATAMANAGER.SetDataValue( 0 , "ooopc_cuma_030r", "InBlock1", "CSNO" , 0 , szData)
	
	DATAMANAGER.RequestTranData( "ooopc_cuma_030r" )
	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam) : 트리거에서 입력받은 계좌번호를 사용하여 입력 세팅
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "mbact71050_t2" then				'계좌별자산
		
		szTemp = sParam
		Call SetInput(szTemp)
'		DATAMANAGER.SetDataValue( 0 , "obcsb_acif_000r", "InBlock1", "ACNO" , 0 , sParam)
'		szACNO = sParam
	end if
	
'	DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	
End Sub 
'============================================================================
' grd0_OnClickUp(lRow, szCellID)	행을 누를시 상세팝업 띄움
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szData
	szACNO = ""
	for i = 0 to grd0.rowcount - 1
		szACNO = szACNO & "☆" & grd0.GetCellData("bd_cell0", i)
'		grd1.GetCellData("bd_cell0", 0)
	next
	
'	szACNO = grd0.GetCellData("bd_cell0", lRow)		'출력된 계좌번호를 입력
	
	szData = "0" & "☆" & lRow & "☆" & grd0.rowcount - 1 & szACNO
	
	Form.OpenFramePopup( "mbact71050_p1" , szData , sPosInfo)
	
End Sub

'============================================================================
Sub grd0_OnScrollEnd()
	DATAMANAGER.RequestNextData("ooopc_cuma_030r")
End Sub

'============================================================================
Sub Form_OnFormInit()
	szACNO = ""
	
	
	szUSERID = Form.GetSharedData("&USER_ID", false )
		
	DATAMANAGER.SetDataValue(0,  "obcsb_efif_005r", "InBlock1", "PROS_CLS_CODE", 0 , "1")
	DATAMANAGER.SetDataValue(0,  "obcsb_efif_005r", "InBlock1", "ELFN_ID"	  , 0 , szUSERID)
	
	DATAMANAGER.RequestTranData("obcsb_efif_005r")
End Sub

'============================================================================
Sub Form_OnRefresh()
	
	szACNO = ""
	DATAMANAGER.RequestTranData( "ooopc_cuma_030r" )
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_efif_005r" then
		CUST_GRAD_CODE = CSTR(DATAMANAGER.GetDataValue(0, "obcsb_efif_005r", "OutBlock1", "CUST_GRAD_CODE", 0))
		CUST_GRAD_CODE = LEFT(CUST_GRAD_CODE,1)
		
		if TRIM(CUST_GRAD_CODE) == "1" then
		    Label0.caption = Label0.caption & " 다이아몬드"
		elseif TRIM(CUST_GRAD_CODE) = "2" then
		    Label0.caption = Label0.caption & " 플레티넘"
		elseif TRIM(CUST_GRAD_CODE) == "3" then
		    Label0.caption = Label0.caption & " 프리미엄"
		elseif TRIM(CUST_GRAD_CODE) == "4" then
		    Label0.caption = Label0.caption & " 골드"
		elseif TRIM(CUST_GRAD_CODE) == "5" then
		    Label0.caption = Label0.caption & " 실버"
		elseif TRIM(CUST_GRAD_CODE) == "6" then
		    Label0.caption = Label0.caption & " 등급없음"
		elseif TRIM(CUST_GRAD_CODE) == "9" then
		    Label0.caption = Label0.caption & " 등급없음"
		else
		    Label0.caption = Label0.caption & ""
		end if
	end if
End Sub

