'============================================================================
' 화 면 명 : 선물옵션주문_예수금팝업
' 화면설명 : 선물옵션주문에서 상단연결팝업에서 예수금 선택시 오픈
' 작    성 : 2016.02.12 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
' Init_Table
'============================================================================
Sub Init_Table()
	tblData.SetCellString(1, 0, "")
	tblData.SetCellString(1, 1, "")
	tblData.SetCellString(1, 2, "")
	tblData.SetCellString(3, 0, "")
	tblData.SetCellString(3, 1, "")
	tblData.SetCellString(3, 2, "")
End Sub


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	Dim tData

	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)

		Init_Table()
		DATAMANAGER.RequestTranData("obtrf_oder_823r")
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 현금 잔고 조회
	' ----------------------------------------------------------------------	
	if szTranID = "obtrf_oder_823r" then	 
		DATAMANAGER.ClearInputData(0, "obtrf_oder_823r")

		DATAMANAGER.SetDataValue(0, "obtrf_oder_823r", "InBlock1", "ACNO", 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtrf_oder_823r", "InBlock1", "ASNO", 0, g_szAcntCd)
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	if szTranID == "obtrf_oder_823r" then
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
'		if Trim(szSubMsg) <> "" then
'			Form.Toast(1, szErrMsg & "(" & szSubMsg & ")", true)	
'		else
'			Form.Toast(1, szErrMsg, true)
'		end if
	end if
End Sub

'============================================================================
' btnInquiry_OnClick
'============================================================================
Sub btnInquiry_OnClick()
	Init_Table()
	DATAMANAGER.RequestTranData("obtrf_oder_823r")
End Sub


'============================================================================
' imgClose_OnClick : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnClose_OnClick : 닫기
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()	
End Sub

