'============================================================================
' 01.화면명 	: 펀드정기입금이체
' 02.화면설명	: 펀드정기입금이체 이체신청내역탭
' 03.작성	: 2016. 03. 10. 유창재
'============================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szData			'
Dim g_szList			'
Dim g_szCustNum		'고객번호
Dim g_szServCode		'서비스코드
Dim g_szServNum		'서비스일련번호
Dim g_nRdoIndex		'라디오 Index값
Dim g_szTRCount		'069r TR의 Output 값 개수
Dim g_szTotalCount	'Tr
Dim g_szBankCode		'은행코드
Dim g_szBankName		'은행명
Dim g_szNextCount		'Next조회시 Index Count
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	
	g_nRdoIndex = 1
	g_szTRCount = 0
	g_szTotalCount = 0
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	grd0.SetClear()
	
	if sEventName == "mbisa56090_t2" then
		g_szData = sParam
	end if
	
	g_szList = Split(g_szData, "★")
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if

	DATAMANAGER.RequestTranData( "obpds_srvc_070r" )
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obpds_srvc_070r" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_070r", "InBlock1", "ACNO" , 0 , g_szList(0) )	'계좌번호
	elseif szTranID == "obwat_ctad_051r" then
		g_szTRCount = 0
		g_szServCode = ""
		g_szServNum = ""
	
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_051r", "InBlock1", "CSNO" , 0 , g_szCustNum )	'고객번호
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_051r", "InBlock1", "ACNO" , 0 , g_szList(0) )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obwat_ctad_051r", "InBlock1", "SVCD" , 0 , "012"       )	'서비스코드
		Select Case g_nRdoIndex
			Case 0
				DATAMANAGER.SetDataValue( 0 , "obwat_ctad_051r", "InBlock1", "ACNO" , 0 , g_szList(0) )	'계좌번호
				DATAMANAGER.SetDataValue( 0 , "obwat_ctad_051r", "InBlock1", "CSNO" , 0 , g_szCustNum )	'고객번호
				DATAMANAGER.SetDataValue( 0 , "obwat_ctad_051r", "InBlock1", "STPL_STAT_CLS_CODE" , 0 , "00" )	'약정상태구분코드
			Case 1
				DATAMANAGER.SetDataValue( 0 , "obwat_ctad_051r", "InBlock1", "CSNO" , 0 , g_szCustNum )	'고객번호
				DATAMANAGER.SetDataValue( 0 , "obwat_ctad_051r", "InBlock1", "ACNO" , 0 , g_szList(0) )	'계좌번호
				DATAMANAGER.SetDataValue( 0 , "obwat_ctad_051r", "InBlock1", "STPL_STAT_CLS_CODE" , 0 , "01" )	'약정상태구분코드
			Case 2
				DATAMANAGER.SetDataValue( 0 , "obwat_ctad_051r", "InBlock1", "CSNO" , 0 , g_szCustNum )	'고객번호
				DATAMANAGER.SetDataValue( 0 , "obwat_ctad_051r", "InBlock1", "ACNO" , 0 , g_szList(0) )	'계좌번호
				DATAMANAGER.SetDataValue( 0 , "obwat_ctad_051r", "InBlock1", "STPL_STAT_CLS_CODE" , 0 , "02" )	'약정상태구분코드
		End Select
		
	elseif szTranID == "obpds_srvc_082r" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_082r", "InBlock1", "CSNO" , 0 , g_szCustNum )	'고객번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_082r", "InBlock1", "SVCD" , 0 , grd0.GetCellData( "bd_cell3", g_szTRCount) )	'서비스코드
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_082r", "InBlock1", "SVC_SRNO" , 0 , grd0.GetCellData( "bd_cell8", g_szTRCount) )	'서비스일련번호
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim TactDay		'이체 희망일
	Dim TactAmt		'이체금액
	Dim szMeritz		'메리츠여부
	Dim totalTemp
	
	
	if szTranID == "obpds_srvc_070r" then
		g_szCustNum = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_070r", "OutBlock1", "CSNO" , 0)	'고객번호
		g_szTotalCount = 0
		g_szNextCount = 0
		
		DATAMANAGER.RequestTranData( "obwat_ctad_051r" )
	elseif szTranID == "obwat_ctad_051r" then
		totalTemp = DATAMANAGER.GetDataCount( 0 , "obwat_ctad_051r", "OutBlock1")
		g_szTotalCount = g_szTotalCount + totalTemp
		
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obwat_ctad_051r", "OutBlock1") - 1
			
			if DATAMANAGER.GetDataValue( 0 , "obwat_ctad_051r", "OutBlock1", "STPL_STAT_CLS_CODE" , i) == "01" then
				grd0.SetCellData( "bd_cell0", g_szNextCount, "정상")
				grd0.SetCellData( "bd_cell4", g_szNextCount, "해지")
				grd0.SetCellEnable( "bd_cell4", g_szNextCount, true)
				
			else
				grd0.SetCellData( "bd_cell0", g_szNextCount, "해지")
				grd0.SetCellData( "bd_cell4", g_szNextCount, "해지")
				grd0.SetCellEnable( "bd_cell4", g_szNextCount, false)
				grd0.SetCellFgColor("bd_cell4", g_szNextCount, "215.215.215")
			end if
			
			g_szNextCount = g_szNextCount + 1
		next
		
		if DATAMANAGER.IsMoreNextData( "obwat_ctad_051r" ) == true then
			DATAMANAGER.RequestNextData( "obwat_ctad_051r" )
			Exit Sub
		end if
		
		DATAMANAGER.RequestTranData( "obpds_srvc_082r" )
		g_szTRCount = g_szTRCount + 1
		
	elseif szTranID == "obpds_srvc_082r" then
		
		TactDay = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_082r", "OutBlock1", "TACT_HOPE_DAY_CODE" , 0)
		TactAmt = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_082r", "OutBlock1", "TACT_AMT" , 0)
		
		szMeritz = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_082r", "OutBlock1", "TACT_ACNT_CLS_CODE" , 0)
		
		g_szBankCode = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_082r", "OutBlock1", "BANK_CODE" , 0)
		g_szBankName = Form.GetMetaData( "은행코드" , g_szBankCode)
		
		if szMeritz == "1" then
			grd0.SetCellData( "bd_cell7", g_szTRCount-1, "메리츠증권")
		else
			grd0.SetCellData( "bd_cell7", g_szTRCount-1, g_szBankName)
		end if
		grd0.SetCellData( "bd_cell5", g_szTRCount-1, TactDay)
		grd0.SetCellData( "bd_cell6", g_szTRCount-1, TactAmt)
		if g_szTRCount < 	g_szTotalCount then
			
			DATAMANAGER.RequestTranData( "obpds_srvc_082r" )
			g_szTRCount = g_szTRCount + 1
		end if
'		g_szTRCount = g_szTRCount + 1
	end if
	
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szData
	
'	'고객번호, 서비스코드, 서비스일련번호, 펀드명 , 계좌번호, 일련번호, 비밀번호, 펀드잔고번호, 정상'해지값 , 금융기관명
'	szData = g_szCustNum & "★" & grd0.GetCellData( "bd_cell3", lRow) & "★" & grd0.GetCellData( "bd_cell8", lRow) & "★" & 
'		grd0.GetCellData( "bd_cell2", lRow) & "★" & g_szList(0) & "★" & g_szList(1) & "★" & g_szList(2) & "★" & 
'		grd0.GetCellData( "bd_cell1", lRow) & "★" & grd0.GetCellData( "bd_cell0", lRow) & "★" & grd0.GetCellData( "bd_cell7", lRow)

    szData = g_szCustNum                         & "★" &  ' 고객번호
             grd0.GetCellData( "bd_cell3", lRow) & "★" &  ' 서비스코드
             grd0.GetCellData( "bd_cell8", lRow) & "★" &  ' 서비스일련번호
             grd0.GetCellData( "bd_cell2", lRow) & "★" &  ' 펀드명
             grd0.GetCellData( "bd_acno" , lRow) & "★" &  ' 계좌번호
             grd0.GetCellData( "bd_asno" , lRow) & "★" &  ' 계좌일련번호
             g_szList(2)                         & "★" &  ' 비밀번호
             grd0.GetCellData( "bd_cell1", lRow) & "★" &  ' 펀드잔고번호
             grd0.GetCellData( "bd_cell0", lRow) & "★" &  ' 정상해지값
             grd0.GetCellData( "bd_cell7", lRow)           ' 금융기관명

	if szCellID == "bd_cell4" then
		if g_szList(2) == "" or Form.GetCtlProp( "#edtPwd01", "caption") == "" then
			Form.ShowAlert( "알림", "비밀번호를 입력해주세요")
			Exit Sub
		else
			Form.OpenPopup( "mbisa56090_p1" , szData , sPosInfo)
		end if
	else'if szCellID == "bd_cell9" then
		Form.OpenPopup( "mbisa56090_p1" , szData&"★"&"보기" , sPosInfo)
	end if
	
End Sub

'============================================================================
Sub rdo0_OnClick(nIndex)
	if len(trim(g_szData)) = 0 then
		Exit Sub
	end if
	g_nRdoIndex = nIndex
	DATAMANAGER.RequestTranData( "obpds_srvc_070r" )
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "OK" then
		DATAMANAGER.RequestTranData( "obpds_srvc_070r" )
	end if
	
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obpds_srvc_070r" trcode="obpds_srvc_070r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obpds_srvc_069r" trcode="obpds_srvc_069r" compress="1" encryption="1" inputcheck="1" useattr="0" >
				<TRBLOCK name="InBlock1" >
					<FIELD name="SVCD" idx="1" defconst="012" />
				</TRBLOCK>
			</TRAN>
			<TRAN tranid="obpds_srvc_082r" trcode="obpds_srvc_082r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obwat_ctad_051r" trcode="obwat_ctad_051r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obpds_srvc_070r" title="약정고객정보조회 TR" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="39" _ulen="31" >

ACNO^계좌번호^8^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="350" _ulen="266" >

ETC_CNTT^기타 내용^100^0^0^0^0^0^0
CSNO^고객번호^10^0^0^0^0^0^0
CSNM^고객명^40^0^0^0^0^0^0
RCNO^실명확인번호^13^0^0^0^0^0^0
