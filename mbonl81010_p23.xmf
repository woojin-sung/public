	<SCRIPT_INFO _len="9047" _ulen="8259" >
'============================================================================
' 작성 : 2021.06.18 ksj
' 2021.08.12 : 정민영 : v0001 : 투자권유 희망여부 확인서 추가(5등급 상품개설), 상품명 변경
' 2021.10.25 : 김수진 : v0002 : 중개형ISA 추가
'============================================================================

'전역변수 설정

Dim g_sRetData 

Dim g_OsType

Dim AgrmFlag 			'동의 플래그
Dim ChckFlag 			'투자권유여부 체크 플래그
Dim sRet				' Return 값

Dim g_szKYC_INVT_RCMD_CLS_CODE  'KYC투자권유구분코드


'G_STEP2_1_FILE 설정정보 ---------------------------------------------------
Dim g_BDM_PRCD100            '종합매매 가입여부
Dim g_BDM_PRCD118RP          'CMA(증권형) 가입여부
Dim g_BDM_PRCD100F           '종합매매(금상전용) 가입여부
Dim g_BDM_PRCD101            '선물옵션 가입여부
Dim g_BDM_PRCD135            '해외파생 가입여부
Dim g_BDM_PRCD133            'ISA 가입여부
Dim g_BDM_PRCDCFD			  'CFD 가입여부
Dim g_BDM_PRCD131			  '연금저축 가입여부
Dim g_BDM_PRCD200            '슈퍼365 가입여부
'v0002 해외 CFD / 중개형 ISA 추가
Dim	g_BDM_PRCD137		'해외 CFD
Dim	g_BDM_ISA_PROD_TYPE	'ISA 타입 (중개형ISA :3/ 일임형 ISA:2)

'============================================================================
Function User_SharedData_Get()  'v0001
'	G_STEP2_2_P4_FILE 설정정보 ---------------------------------------------------
	g_BDM_PRCD100            = Form.GetSharedData("BDM_PRCD100"            , false)  '종합매매 가입여부
	g_BDM_PRCD118RP          = Form.GetSharedData("BDM_PRCD118RP"          , false)  'CMA(증권형) 가입여부
	g_BDM_PRCD100F           = Form.GetSharedData("BDM_PRCD100F"           , false)  '종합매매(금상전용) 가입여부
	g_BDM_PRCD101            = Form.GetSharedData("BDM_PRCD101"            , false)  '선물옵션 가입여부
	g_BDM_PRCD135            = Form.GetSharedData("BDM_PRCD135"            , false)  '해외파생 가입여부
	g_BDM_PRCD133            = Form.GetSharedData("BDM_PRCD133"            , false)  'ISA 가입여부
	g_BDM_PRCDCFD            = Form.GetSharedData("BDM_PRCDCFD"            , false)  'CFD 가입여부
	'v0002 sta
	g_BDM_PRCD137			  = Form.GetSharedData("BDM_PRCD137"            , false)  '해외 CFD 가입여부
	g_BDM_ISA_PROD_TYPE	  = Form.GetSharedData("BDM_ISA_PROD_TYPE"      , false)  'ISA 타입 (중개형ISA :3/ 일임형 ISA:2)
	g_BDM_PRCD131	  		  = Form.GetSharedData("BDM_PRCD131"            , false)  '연금저축 가입여부
	g_BDM_PRCD200	  		  = Form.GetSharedData("BDM_PRCD200"            , false)  '슈퍼365 가입여부
	'v0002 fin
End Function

'============================================================================
Sub Form_OnFormInit()    
    
'    User_SharedData_Get()

    szTheme = Form.GetEnvData("common.theme")
    
    if Form.GetSharedData("&OS_TYPE", false) == "1" then
		ContainerBody.setScrollBarVisible("2")
	end if    
    
    AgrmFlag = 0
    ChckFlag = 0
    sRet = "hopeRecInv_fail"
    
    g_sRetData = "CANCEL"
 	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()

	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")

		g_szScrNo 	= tData[0]
		g_szAcno 	= tData[1]
		g_szAsno 	= tData[2]
		g_szBswr 	= tData[3]
		g_szDiv 		= tData[4]
		g_szISCD 	= tData[5]
		
		g_szKYC_INVT_INCL_GRAD_CODE 	= tData[6]
		g_szKYC_PROD_GRAD_CODE 		= tData[7]
		g_szKYC_INVT_RCMD_CLS_CODE 		= tData[8]
 
	    'JMY 개설되는 건수만큼만 표시되도록 Table 높이 강제조정
	    '현재 총9Row.
	    '0Row 투자권유 여부, 1Row 투자자정보제공 여부 2~8Row.개설된계좌리스트
	    
	    '1Row의 투자자정보제공 항목 삭제. 1Row부터 개설계좌리스트
	    Dim nCnt, nTop, nRHeight, nDelHeight
	    nRHeight = 342 - 38
	    nTop = 324		'ContMain.TableList.Top
	    nCnt = 0
		
	'	g_BDM_PRCD100 = "Y"
	'	g_BDM_PRCD200 = "Y"
		
		'부적합상품에 대해서만 표시 JMY
	    if g_szScrNo = "51000" then		'펀드매매
			nCnt = nCnt + 1
			ContainerBody.TableList.SetCellString( nCnt , 3, "펀드매매")
		elseif g_szScrNo = "88060" then		'단기사채
			nCnt = nCnt + 1
			ContainerBody.TableList.SetCellString( nCnt , 3, "단기사채")
		elseif g_szScrNo = "90201" then		'채권(장외)
			nCnt = nCnt + 1
			ContainerBody.TableList.SetCellString( nCnt , 3, "채권(장외)")
		end if
		'v0002 fin
		
		nDelHeight = 38 * CInt((7-nCnt))			'38=한Row당높이
		ContainerBody.TableList.height = nRHeight - CInt(nDelHeight)
		nTop = nTop + CInt(nRHeight - CInt(nDelHeight))
		ContainerBody.Container0.top = CInt(nTop) + 15
		ContainerBody.Image0.height = nRHeight - CInt(nDelHeight) + 60
		ContainerBody.SetScrollAutoSize()   
	else
		Form.ShowAlert("알림", "입력값이 없습니다.")
	end if 
End Sub

'============================================================================
Sub BtnNext_OnClick()
	if ContainerBody.ChkButton0.chksilence == "0"  then
		Form.MsgBox( "알림", "내용을 확인해 주세요.(투자권유 여부)", "", 6 )
		Exit Sub
	end if
'
'	if Container0.ChkButton1.chksilence == "0" then
'		Form.MsgBox( g_szAlertTitle, "내용을 확인해 주세요.(확인 체크)", "", 6 )
'		Exit Sub
'	end if
	
	DATAMANAGER.SetEventFlag( "obcsb_acif_830a", "I" )
	DATAMANAGER.RequestTranData( "obcsb_acif_830a" )
End Sub

'============================================================================
Sub ContainerBody_ImgClose_OnClick()
	sRet = "hopeRecInv_fail"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()  '안드로이드전용
    ContainerBody_ImgClose_OnClick()
End Sub
'============================================================================
Sub Form_OnFormClose()
	if	g_sRetData		<>	"OK"		then
		g_sRetData	=	"CANCEL"
		
		Form.SetSharedData("KYC_ACNO" , null)
		Form.SetSharedData("KYC_INVT_INCL_GRAD_CODE" , null)
		Form.SetSharedData("KYC_PROD_GRAD_CODE" , null)
		Form.SetSharedData("KYC_DVPD_EPMD_CODE" , null)
		Form.SetSharedData("KYC_DRVT_PROS_YN" , null)
		Form.SetSharedData("KYC_DVPD_GRAD_CODE" , null)
		
		Form.SendReturnToParent("mbonl81010_p23" , g_sRetData)
	else
		Form.SendReturnToParent("mbonl81010_p23" , g_sRetData)
	end if	
End Sub

'============================================================================


'============================================================================
Sub BtnReCheck_OnClick()
	g_sRetData	=	"CANCEL"
	Form.SendReturnToParent("mbonl81010_p23" , g_sRetData)

	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_acif_830a" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "PROS_CLS_CODE" , 0 , "2"  ) 
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0 , g_szKYC_INVT_RCMD_CLS_CODE  )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0 , g_szKYC_INVT_INCL_GRAD_CODE )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "KYC_PROD_GRAD_CODE" , 0 , g_szKYC_PROD_GRAD_CODE )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , g_szBswr ) 
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "BSWR_DIV_CODE" , 0 , g_szDiv )
	
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "ACNO" , 0 , g_szAcno )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "ASNO" , 0 , g_szAsno )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "ISCD" , 0 , g_szISCD )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "PRCD" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_830a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acif_830a" then
		Dim sSUCS_YN, sCSNO, sSTND_DATE, sREG_SRNO
		sSUCS_YN = DATAMANAGER.GetDataValue( 0, "obcsb_acif_830a", "OutBlock1", "SUCS_YN" , 0 )
		sCSNO = DATAMANAGER.GetDataValue( 0, "obcsb_acif_830a", "OutBlock1", "CSNO" , 0 )
		sSTND_DATE = DATAMANAGER.GetDataValue( 0, "obcsb_acif_830a", "OutBlock1", "STND_DATE" , 0 )
		sREG_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_acif_830a", "OutBlock1", "REG_SRNO" , 0 )
		
		Form.SetSharedData("KYC_SUCS_YN", sSUCS_YN)
		Form.SetSharedData("KYC_CSNO",sCSNO)
		Form.SetSharedData("KYC_STND_DATE", sSTND_DATE)
		Form.SetSharedData("KYC_REG_SRNO",sREG_SRNO)
		
		g_sRetData = "OK"
		Form.CloseForm()		
	end if
End Sub

