			<COL_INFO ly_vert_width="72,148,95" />
			<ROW_INFO ly_vert_height="25,25,25,25" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" halign="0" line="0,0" caption="계좌구분" impidxs="" />
				<CELL cell_ly="1,0,2,0" halign="2" line="0,0" impidxs="" />
				<CELL cell_ly="0,1,0,1" halign="0" line="0,0" caption="등록은행" impidxs="" />
