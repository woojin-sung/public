	<SCRIPT_INFO _len="1364" _ulen="1186" >


'============================================================================
Sub btnOk_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData( )
	
	if szData <> "" then
		tData = Split(szData, "★")
		Table0.SetCellString(0, 1, tData(0))'원화계좌 외화계좌
		szName = Form.GetMetaData("은행코드", tData(1))
'		Table0.SetCellString(1, 1, szName)'은행명
		Table0.SetCellString(1, 1, tData(6))'은행명
		ImgBank.imgpath = "bank"..tData(1)
		Table0.SetCellString(2, 1, tData(2))'계좌번호
		
		if tData(4) <> "" then
			'계좌별명 입력시, 수취인명 + 별명 표시
			Table0.SetCellString(3, 1, tData(3) .. " | " .. tData(4))
		else
			'계좌 별명 미입력시, 수취인명만 표시
			Table0.SetCellString(3, 1, tData(3))
		end if		
'		Table0.SetCellString(3, 1, tData(3))'통장명
'		Table0.SetCellString(3, 2, tData(4))'별명
		
		if tData(5) == "1" then
			Label0.caption = "타금융내계좌가 등록되었어요."
		end if
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	ImgBank.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
	Image0.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
End Sub

