'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 계좌순서_별명설정
' 02. 화면설명 : 환경설정_계좌순서_별명설정
' 03. 작    성 : 2023.12.04 성우진
'-------------------------------------------------------------------------------------------
Dim g_sRcnoPip, g_sID
Dim g_AcntNameFlag
Dim g_nSelectRow
Dim g_szChangeNickName
Dim g_sACNO, g_sASNO, g_szData
Dim g_sErrorFlag1, g_sErrorFlag2, g_sErrorFlag3
g_sErrorFlag1 = False
g_sErrorFlag2 = False
g_sErrorFlag3 = False
Dim g_GridTouchFlag
g_GridTouchFlag = False

Dim g_sSaveACno, g_sSaveASno, g_sSaveNick
g_sSaveACno = Array()
g_sSaveASno = Array()
g_sSaveNick = Array()

Dim g_nCnt
Dim g_nRowCnt
Dim g_nOverCount
g_nRowCnt = 0
g_nCnt = -1
g_nOverCount = 0
Dim g_Index
'============================================================================
Sub Form_OnFormInitBefore()
	imgTooltip.setMaintainingRatio("1")
End Sub
'============================================================================
Sub Form_OnFormInit()
	g_sRcnoPip = Form.GetSharedData("&JUMIN_NUM", false)
	g_sID	  = Form.GetSharedData("&USER_ID"  , false)
	sAcctAlias = Form.GetSharedData("&ACCT_ALIAS_TYPE", false)
	
	szCheck = Form.LoadConfigData("NoticeSetting", "mpopup_noti" & g_sID)
	
	'cont0.setScrollBarVisible("0")
	'cont0.cont1.setScrollBarVisible("0")
	
	'스크롤 끊김 현상 방지 등
    Grid0.SetUseLoadFast(True)
    Grid0.SetUseNewDragMotion(True)
    Grid0.changeDragStartOffset(True) '드래그 시작위치 조정
    Grid0.changeDragScrollSpeed(8)    '드래그 속도
	
	Grid0.rowcount = 0
	Grid0.rowmove = "2"
	
	EnableButton("0")
	'Grid0.setDragImage("edit_guide_01.png") 'icon_sub_02.9
	'Grid0.setDragImageOption(false,0)'1번 인자=T확장 F미확장/2번 인자=0(투명)~1.0(불투명)(안드로이드는 적용 안 되는 인자임)
	
	Form.SetScreenName("계좌 순서/별명 설정")
	
	'최초 1회만 안내 팝업 오픈
	if szCheck <> "1" then
		Form.OpenPopup("mpopup_noti" , "" , "")
	end if
	
	g_nRowCnt = 0
	
	'계좌 재조회
	'이 화면에 진입한다면, 타 화면 진입 시 계좌 컨트롤에 변경된 내용 적용하기 위해(HTS에서 설정한 경우)
	Form.RequestCommand("RE_ACCT_LIST", "", "")
	
	DATAMANAGER.RequestTranData("obcsb_efif_028r")
	DATAMANAGER.RequestTranData("obcsb_efif_021r")
	
End Sub
'============================================================================
Sub ChkAcntName_OnChange(sCheckState)
	if sCheckState == "1" then
		ChkNickName.chksilence = "0"
		
		'계좌명 선택 시
		g_AcntNameFlag = "1"
		
		EnableButton("1")
	else
		if ChkNickName.checkstate <> "1" and g_GridTouchFlag = False then
			EnableButton("0")
		end if
	end if
	
End Sub

'============================================================================
Sub ChkNickName_OnChange(sCheckState)
	if sCheckState == "1" then
		ChkAcntName.chksilence = "0"
		
		'별명 선택 시
		g_AcntNameFlag = "2"
		
		EnableButton("1")
	else
		if ChkAcntName.checkstate <> "1" and g_GridTouchFlag = False then
			EnableButton("0")
		end if
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_efif_021r" then
		DATAMANAGER.SetDataValue(0, "obcsb_efif_021r", "InBlock1", "IQRY_CLS_CODE"	, 0 , "2")		'1.ID 2.주민번호
		DATAMANAGER.SetDataValue(0, "obcsb_efif_021r", "InBlock1", "ELFN_ID"			, 0 , g_sID)		
		DATAMANAGER.SetDataValue(0, "obcsb_efif_021r", "InBlock1", "VLTN_ACMP_YN"	, 0 , "N") 		'평가수행여부		
		DATAMANAGER.SetDataValue(0, "obcsb_efif_021r", "InBlock1", "RCNO_PIP" 		, 0 , g_sRcnoPip) '주민번호_암호화
	
'		if DATAMANAGER.IsMoreNextData("obcsb_efif_021r") == true then
'			DATAMANAGER.RequestNextData("obcsb_efif_021r")
'		else
'			DATAMANAGER.RequestTranData("obcsb_efif_021r")
'		end if
	end if
	
	if szTranID == "obcsb_efif_028r" then
		DATAMANAGER.SetDataValue(0, "obcsb_efif_028r", "InBlock1", "IQRY_CLS_CODE" 	, 0 , "1")
		DATAMANAGER.SetDataValue(0, "obcsb_efif_028r", "InBlock1", "ELFN_ID" 		, 0 , g_sID)
	end if
	
	if szTranID == "obcsb_efif_024a" then
		DATAMANAGER.SetDataValue(0, "obcsb_efif_024a", "InBlock1", "ELFN_ID"				, 0 , g_sID		 )		
		DATAMANAGER.SetDataValue(0, "obcsb_efif_024a", "InBlock1", "ACNT_ALS_EXRS_CODE"	, 0 , g_AcntNameFlag)		
	end if
	
	if szTranID == "obcsb_efif_022a" then
		
		Dim nCnt 
		nCnt = 1
		
		DATAMANAGER.SetDataValue(0 , "obcsb_efif_022a", "InBlock1", "ELFN_ID"              , 0 , g_sID )
		
		for i = 0 to g_nRowCnt - 1			
			szAcnoPrnm = Grid0.GetCellData("bd_cell1"  , i)
			szACNO  	  = Grid0.GetCellData("bd_cell8"  , i)
			szASNO     = Grid0.GetCellData("bd_cell10" , i)
		'	szIndex    = Grid0.GetCellData("bd_cell5" , i)
			szHostDate = Form.GetSharedData("&HOST_DATE", false)
			
			DATAMANAGER.SetDataValue(0, "obcsb_efif_022a", "InBlock2", "REG_DATE" 		, i , szHostDate)
			DATAMANAGER.SetDataValue(0, "obcsb_efif_022a", "InBlock2", "REG_ACNO" 		, i , szACNO)
			DATAMANAGER.SetDataValue(0, "obcsb_efif_022a", "InBlock2", "REG_ASNO" 		, i , szASNO)
			DATAMANAGER.SetDataValue(0, "obcsb_efif_022a", "InBlock2", "IQRY_PRTY_RANK"   , i , nCnt)
			DATAMANAGER.SetDataValue(0, "obcsb_efif_022a", "InBlock2", "SCR_EXRS_YN"  	, i , "Y")
			DATAMANAGER.SetDataValue(0, "obcsb_efif_022a", "InBlock2", "SELF_ACNT_YN" 	, i , "Y")
			DATAMANAGER.SetDataValue(0, "obcsb_efif_022a", "InBlock2", "MNPL_EMPNO"   	, i , g_sID)
			
			nCnt = nCnt + 1
		next
	end if
	
	if szTranID == "obaci_acct_021u" then
			
		DATAMANAGER.SetDataValue(0, "obaci_acct_021u", "InBlock1", "ACNO"		, 0 , g_sSaveACno(g_Index))
		DATAMANAGER.SetDataValue(0, "obaci_acct_021u", "InBlock1", "ASNO"		, 0 , g_sSaveASno(g_Index))
		DATAMANAGER.SetDataValue(0, "obaci_acct_021u", "InBlock1", "PWD"		, 0 , "0"    )
		DATAMANAGER.SetDataValue(0, "obaci_acct_021u", "InBlock1", "BKKP_NAME"	, 0 , g_sSaveNick(g_Index))
	end if

End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "obcsb_efif_021r" then
		nCount = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		bNextData =  DATAMANAGER.IsMoreNextData(szTranID)
		
		if bNextData == "1" or bNextData == true then
			DATAMANAGER.RequestNextData( szTranID )
		else
			for i = 0 to nCount - 1
				
				szTempID = DATAMANAGER.GetDataValue(0, "obcsb_efif_021r", "OutBlock1", "ELFN_ID" , i)
				
				'ID가 복수개인 계좌에서는
				'접속한 ID만 보여주자
				if g_sID <> szTempID then
					g_nOverCount = g_nOverCount + 1
				end if
			next
		end if
		
		g_nRowCnt = g_nRowCnt + (nCount - g_nOverCount)
		
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcsb_efif_021r" then
		nCount = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		bNextData =  DATAMANAGER.IsMoreNextData(szTranID)
			
		if bNextData == "1" or bNextData == true then
			DATAMANAGER.RequestNextData( szTranID )
		else 
			Dim nIndex
			nIndex = 0
			
			for i = 0 to nCount - 1
				szTempID = DATAMANAGER.GetDataValue(0, "obcsb_efif_021r", "OutBlock1", "ELFN_ID" , i)
				
				'ID가 복수개인 계좌에서는
				'접속한 ID만 보여주자
				if g_sID == szTempID then				
				
					szACNO     = DATAMANAGER.GetDataValue(0 , "obcsb_efif_021r", "OutBlock1", "REG_ACNO" , i)		'종합계좌
					szASNO 	  = DATAMANAGER.GetDataValue(0 , "obcsb_efif_021r", "OutBlock1", "REG_ASNO" , i)		'계좌일련번호
					szInprName = DATAMANAGER.GetDataValue(0 , "obcsb_efif_021r", "OutBlock1", "UI_INPR_NAME" , i)	'상품명
					szCustName = DATAMANAGER.GetDataValue(0 , "obcsb_efif_021r", "OutBlock1", "CUST_ABWR_NAME" , i)	'고객명
					szNickName = DATAMANAGER.GetDataValue(0 , "obcsb_efif_021r", "OutBlock1", "INPR_BKKP_NAME" , i)	'별명
					
					Grid0.setCellMaxLineCount("bd_cell1", 1)
					
					Grid0.SetCellData("bd_cell8", nIndex, szACNO)
					Grid0.SetCellData("bd_cell10", nIndex, szASNO)
					Grid0.SetCellData("bd_cell6", nIndex, szACNO & szASNO)
					Grid0.SetCellData("bd_cell1", nIndex, szInprName)
					Grid0.SetCellData("bd_cell2", nIndex, szCustName)
					Grid0.SetCellData("bd_cell7", nIndex, szNickName)
					
					Grid0.SetCellData("bd_cell3", nIndex , "icon_group_edit.png")
					Grid0.setMaintainingRatio("bd_cell3"    , nIndex , "1")
					
					Grid0.SetCellData("bd_cell4", nIndex , "icon_list_move.png")
					Grid0.setMaintainingRatio("bd_cell4"    , nIndex , "1")
					
					nIndex = nIndex + 1
				end if
				
			next
			
		end if
		
	'	if g_nRowCnt < 7 then
			'cont0.height = cont0.Grid0.height + 55
			'cont0.cont1.top = g_nRowCnt * 60
			
			'cont0.SetScrollAutoSize()
			'cont0.cont1.SetScrollAutoSize()
	'	end if

		Grid0.rowcount = g_nRowCnt
		
		'Label0.visible = True
		'Label1.visible = True
	end if
	
	if szTranID == "obcsb_efif_028r" then
		szAcntExrsCode = DATAMANAGER.GetDataValue( 0, "obcsb_efif_028r", "OutBlock1", "ACNT_ALS_EXRS_CODE" , 0)
		
		'별명
		if szAcntExrsCode == "2" then
			ChkNickName.chksilence = "1"
			
			'별명 선택 시
			g_AcntNameFlag = "2"
		else
			ChkAcntName.chksilence = "1"
			
			'계좌명 선택 시
			g_AcntNameFlag = "1"
		end if
	end if
	
	if szTranID == "obcsb_efif_024a" then	
		Form.MsgBox("알림", "계좌 설정이 완료되었습니다.", "complete", 6)		
	end if
	
	if szTranID = "obcsb_efif_022a" then
		'계좌 재조회
		Form.RequestCommand("RE_ACCT_LIST", "", "")
	end if
	
	if szTranID = "obaci_acct_021u" then
		g_sSaveACno = Array()
		g_sSaveASno = Array()
		g_sSaveNick = Array()
		g_nCnt = -1
		g_Index = ""
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szTranID == "obcsb_efif_024a" then
		g_sErrorFlag1 = True
	end if
	
	if szTranID == "obcsb_efif_022a" then
		g_sErrorFlag2 = True
	end if
	
	if szTranID == "obaci_acct_021u" then
		g_sSaveACno = Array()
		g_sSaveASno = Array()
		g_sSaveNick = Array()
		g_nCnt = -1
		g_Index = ""
		
		g_sErrorFlag3 = True
	end if
	
	If szSubMsg <> "" And szSubMsg <> null Then
		Form.MsgBox("알림", szErrMsg .. "\n" .. szSubMsg , "", 6)
	Else
		Form.MsgBox("알림", szErrMsg , "", 6)
	End If
	
End Sub
'============================================================================
Sub BtnSet_OnClick()
	
	g_sErrorFlag1 = false
	g_sErrorFlag2 = false
	g_sErrorFlag3 = false
	
	'계좌 별명 사용
	DATAMANAGER.RequestTranData("obcsb_efif_024a")
	
	'계좌 순서 변경
	DATAMANAGER.RequestTranData("obcsb_efif_022a")
	
	if g_GridTouchFlag = True and Trim(g_sACNO) <> "" then
		
		for i = g_nCnt to 0 step -1
		
			g_Index = i
			
			'계좌 별명 변경
			DATAMANAGER.RequestTranData("obaci_acct_021u")
		next
		
	end if
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	if szCellID == "bd_cell3" then'별명 편집
		g_szChangeNickName = ""
		g_sACNO = ""
		g_sASNO = ""
		g_szData = ""
		
		g_GridTouchFlag = True
		
		g_sACNO     = Grid0.GetCellData("bd_cell8"  , lRow)
		g_sASNO     = Grid0.GetCellData("bd_cell10" , lRow)
		g_szData    = Grid0.GetCellData("bd_cell7"  , lRow)
		
		Form.OpenPopupAnimation("textkeypadpopup", "계좌별명☆"..g_szData.."☆최대 10 글자 입력 가능☆1☆20", "","2")
'		
		g_nSelectRow = CInt(lRow)
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "POPUP_TEXT" then
		'빈값으로도 별명 변경 가능하므로 조건문 수정
		if g_nSelectRow > -1 then
			g_szChangeNickName = Trim(sRet)
			
			if g_GridTouchFlag then
				if g_szData <> g_szChangeNickName then
					EnableButton("1")
					g_GridTouchFlag = True
				else
					EnableButton("0")
					g_GridTouchFlag = False
				end if
			end if
			
			'복수개를 바꿀 수도 있으므로
			g_nCnt = g_nCnt + 1

			g_sSaveACno(g_nCnt) = g_sACNO
			g_sSaveASno(g_nCnt) = g_sASNO
			g_sSaveNick(g_nCnt) = g_szChangeNickName
					
			Grid0.SetCellData("bd_cell7", g_nSelectRow, g_szChangeNickName)
		end if
	end if
End Sub
'============================================================================
Sub Grid0_OnDropRow()'순서 변경
	g_GridTouchFlag = True
	
	if g_GridTouchFlag then
		EnableButton("1")
	end if
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "complete" then
		EnableButton("0")
	end if
End Sub
'============================================================================
Sub EnableButton(sEnable)
	
	if sEnable == "1" then
		BtnSet.btnimage = "btn_20.9"
		BtnSet.enable = true
	else
		BtnSet.btnimage = "btn_15.9"
		BtnSet.enable = false
	end if
	
End Sub
'============================================================================
Sub imgTooltip_OnClick()
	szToolTipText = "설정 후 주문, 거래내역 등 화면에 즉시 적용되며,\nID해지 시 설정된 계좌 순서/별명은 초기화됩니다."
	'imgTooltip0.openToolTip(szToolTipText, 330, 70, 2)
	imgTooltip.openToolTip(szToolTipText, 330, 70, 2)
End Sub

