'============================================================================
Sub Button0_OnClick()
	if select_cnt ==2 then
	Form.OpenFramePopup("mbetc99000_s25" , select_prtf_id&"●"&select_cnt, "")
	
	elseif select_cnt == 3 then
	Form.OpenFramePopup("mbetc99000_s26" , select_prtf_id&"●"&select_cnt, "")
	
	else
	Form.Toast(0,"포트폴리오를 2개이상 선택하셔야 합니다.", 0.5)
	
	end if
End Sub

