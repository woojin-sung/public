Sub Grid0_OnClickUp(lRow, szCellID)

' tmp = Grid0.selectrow
' prtf_id = Grid0.GetCellData("bd_cell14",tmp)

' if szCellID == "bd_cell13" then 

 'Form.MsgBox("테스트", Grid0.GetCellData("bd_cell14",tmp), "", "")
 
 
' DATAMANAGER.SetEventFlag("obcpp_intr_756a", "I")
' DATAMANAGER.SetDataValue(0, "obcpp_intr_756a", "InBlock1", "PRTF_ID" , 0 , prtf_id)
' DATAMANAGER.SetDataValue(0, "obcpp_intr_756a", "InBlock1", "INP_MEMB_SRNO", 0 , 1)
 
 'DATAMANAGER.RequestTranData("obcpp_intr_756a")
 
 
 'end if
 
 
 
 
 
 tmp = Grid0.selectrow
 prtf_id = Grid0.GetCellData("bd_cell14",tmp)
 

 if szCellID == "bd_cell13" then 

 'Form.MsgBox("테스트", prtf_id, "", "")
 DATAMANAGER.SetEventFlag("obcpp_intr_756a", "I")
 DATAMANAGER.SetDataValue(0, "obcpp_intr_756a", "InBlock1", "PRTF_ID" , 0 , prtf_id)
 DATAMANAGER.SetDataValue(0, "obcpp_intr_756a", "InBlock1", "INP_MEMB_SRNO", 0 , 1)
 
 DATAMANAGER.RequestTranData("obcpp_intr_756a")
 
 Form.OpenFramePopup("mbetc99000_s19" , prtf_id , "")
 
 
 elseif szCellID == "bd_cell6" then
   
	'
	
   
  
 
	 if Grid0.GetCellData("bd_cell6", tmp) == "비교선택" then
	    if select_cnt>=3 then
	     Form.Toast(0, "비교는 최대 3개까지 가능합니다.", 0.5)
	     
	     
	    else
		 Grid0.SetCellData("bd_cell6", tmp, "선택됨")
		 select_cnt = select_cnt+1
			 if select_cnt == 1 then
				 select_prtf_id = select_prtf_id&Grid0.GetCellData("bd_cell14", tmp)
				 Form.MsgBox("테스트", select_prtf_id, "", "")
				 
			 else
				 select_prtf_id = select_prtf_id&"●"&Grid0.GetCellData("bd_cell14", tmp)
				 Form.MsgBox("테스트", select_prtf_id, "", "")
		 	 end if
	    end if
				 
		 
	 else
	 
		 		
		 Grid0.SetCellData("bd_cell6", tmp, "비교선택")
		 select_cnt = select_cnt-1
		 
		 if select_cnt == 0 then
		 select_prtf_id = replace(select_prtf_id,Grid0.GetCellData("bd_cell14", tmp),"")
		 
		 else
			
		 select_prtf_id = replace(select_prtf_id,Grid0.GetCellData("bd_cell14", tmp)&"●","")
		 select_prtf_id = replace(select_prtf_id,"●"&Grid0.GetCellData("bd_cell14", tmp),"")
		 Form.MsgBox("테스트", select_prtf_id, "", "")
		 
		 end if
		
	end if
 
 
 end if
 
 
 
 
	
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	select_p = Combo0.caption
	select_t = Combo1.currentindex
	select_s = Combo2.currentindex
	
	if select_p == "투자목적" then 
	select_p ="%%" 
	end if
	
	if select_t == "0" then 
	select_t ="%%" 
	end if
	
	if select_s == "0" then 
	select_s ="%%" 
	end if
	
	
	DATAMANAGER.SetDataValue(0, "obcpp_intr_717r", "InBlock1", "INVT_OBJT_TYPE_NAME" , 0 , select_p)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_717r", "InBlock1", "INP_RBDV_VLPN" , 0 , select_t)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_717r", "InBlock1", "INP_INVT_INCL_CLCD" , 0 , select_s)
	
	DATAMANAGER.RequestTranData("obcpp_intr_717r")
	tmp_cnt = 0
	
'	Form.MsgBox("테스트", tmp_select, "", "")
	
End Sub

