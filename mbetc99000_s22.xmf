Sub Form_OnFormInit()

	tmp_cnt = 0
	select_cnt = 0
 select_prtf_id=""
 cnt_flag = 0
	'Form.MsgBox("테스트", round(-0004.00000,2), "", "")

	Grid0.SetVisibleCol(2, 0)

	DATAMANAGER.SetDataValue(0, "obcpp_intr_717r", "InBlock1", "INVT_OBJT_TYPE_NAME" , 0 , "%%")
	DATAMANAGER.SetDataValue(0, "obcpp_intr_717r", "InBlock1", "INP_RBDV_VLPN" , 0 , "%%")
	DATAMANAGER.SetDataValue(0, "obcpp_intr_717r", "InBlock1", "INP_INVT_INCL_CLCD" , 0 , "%%")
	
	
	DATAMANAGER.RequestTranData("obcpp_intr_717r")
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	cnt = DATAMANAGER.GetDataCount(0, "obcpp_intr_717r" ,"OutBlock1") 
	
	
	for i = 0 to cnt
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_717r", "OutBlock1", "ADCP_NAME", i)
	Grid0.SetCellData("bd_cell7", tmp_cnt+i, tmp)
	'Grid0.SetCellData('sCellID, nRowIdx, sValue)
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_717r", "OutBlock1", "PRTF_NAME", i)
	Grid0.SetCellData("bd_cell8", tmp_cnt+i, tmp)
	
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_717r", "OutBlock1", "INP_INVT_INCL_CLCD", i) '위험등급'
	
	if abs(tmp) == 1 then
	tmp = "안정형"
	  
	elseif abs(tmp) == 2 then
	tmp = "안정추구형"
	
	elseif abs(tmp) ==3 then
	tmp = "중립형"
	
	elseif abs(tmp) == 4 then
	tmp = "수익추구형"
	
	elseif abs(tmp) ==5 then
	tmp = "고수익추구형"
	
	end if
	
	
	Grid0.SetCellData("bd_cell9", tmp_cnt+i, tmp)
	
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_717r", "OutBlock1", "FERT", i) '수수료
	Grid0.SetCellData("bd_cell10", tmp_cnt+i, Cint(tmp)&"%")
	
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_717r", "OutBlock1", "ANTC_ERT", i) '예상수익률
	Grid0.SetCellData("bd_cell11", tmp_cnt+i, Cint(tmp)&"%")
	
	tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_717r", "OutBlock1", "PRTF_ID", i) '포트폴리오코드
	Grid0.SetCellData("bd_cell14", tmp_cnt+i, tmp)
	
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_717r", "OutBlock1", "INP_RBDV_VLPN", i) '고객평점
	
	if round(tmp) == 1 then
	tmp = "★☆☆☆☆"
	  
	elseif round(tmp) == 2 then
	tmp = "★★☆☆☆"
	
	elseif round(tmp) ==3 then
	tmp = "★★★☆☆"
	
	elseif round(tmp) == 4 then
	tmp = "★★★★☆"
	
	elseif round(tmp) ==5 then
	tmp = "★★★★★"
	
	end if
	
	
	'Select Case CInt(tmp)
	'	Case 1
		'	tmp = "★☆☆☆☆"
			
	'	Case 2
	'		tmp = "★★☆☆☆"
	'	
	'	Case 3
	'		tmp = "★★★☆☆"
			
	'	Case 4
	'		tmp = "★★★★☆"
			
	'	Case 5
	'		tmp = "★★★★★"
			
	
	'END SELECT
	
	
	Grid0.SetCellData("bd_cell12", tmp_cnt+i, tmp)
	
	
	
	
	Grid0.SetCellData("bd_cell0", tmp_cnt+i, "자문사명")
	Grid0.SetCellData("bd_cell1", tmp_cnt+i, "포트폴리오명")
	Grid0.SetCellData("bd_cell2", tmp_cnt+i, "위험등급")
	Grid0.SetCellData("bd_cell3", tmp_cnt+i, "수수료")
	Grid0.SetCellData("bd_cell4", tmp_cnt+i, "예상수익률")
	Grid0.SetCellData("bd_cell5", tmp_cnt+i, "고객평가")
	
	
	Grid0.SetCellData("bd_cell6", tmp_cnt+i, "비교선택")
	Grid0.SetCellFgColor("bd_cell6", tmp_cnt+i, 90)
	
	Grid0.SetCellData("bd_cell13", tmp_cnt+i, "상세보기")
	Grid0.SetCellFgColor("bd_cell13", tmp_cnt+i, 90)
	
	
	
	next
	
	
	
	
	
	
End Sub


