'============================================================================
' Insert_cmbGroup :  관심그룹을 그룹콤보에 넣기
'============================================================================
Function Insert_cmbGroup()
	Dim szgrpList, szKey, szNm, szSave
	Dim nRow, nIdx, nSelect

	nRow = grdGroup.rowcount
	nIdx = -1
	nSelect = 0
	szgrpList = ""
	
	' 최종 선택(저장)된 관심그룹 키
	szSave = Form.GetEnvData("SELECT_GWGROUP")

	' ---- 관심종목 그룹 리스트 존재시 Start --------------------------------
'	if Int(nRow) > 0 then
		For i = 0 to nRow -1
			szKey = grdGroup.GetCellData("bd_code", i)
			szNm  = grdGroup.GetCellData("bd_name", i)
			
			if szgrpList == "" then
				szgrpList = szKey & "`" & szNm
			else
				szgrpList = szgrpList & "\r\n" & szKey & "`" & szNm
			end if
			
			if nIdx >= 0 then
				nIdx = nIdx + 1
			else
				nIdx = 0
			end if
			
			if szSave == szKey then
				nSelect = nIdx
			end if	
		Next
		
		
		'20190807 LES START
		if szgrpList == "" then
			szgrpList = "BB" & "`" & "최근조회종목"
		else
			szgrpList = szgrpList & "\r\n" & "BB" & "`" & "최근조회종목"
		end if
		'20190807 LES END
'	end if
	' ---- 관심종목 그룹 리스트 존재시 End ----------------------------------

	' 관심그룹콤보에 리스트 init		
	cmbGroup.cbinputdatatext = szgrpList

	' 관심그룹콤보에서 최종 저장된 그룹 선택
	cmbGroup.currentindex = nSelect		

End Function

'============================================================================
' Load_GWGroup :  로컬에 저장된 관심그룹 가져오기
'============================================================================
Function Load_GWGroup()
	Dim tGroup, tList
	
	grdGroup.rowcount = 0
	szGroup = Form.LoadConfigData("GWANSIM", "GROUP")
	
	if szGroup <> "" then
		tGroup = Split(szGroup, "♣")
		
		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdGroup.insertrow = i
	
			grdGroup.SetCellData("bd_code",  i, tList(0))
			grdGroup.SetCellData("bd_name",  i, tList(1))
			grdGroup.SetCellData("bd_count", i, tList(2))
		Next
	end if
End Function

'============================================================================
' Save_GWGroup :  관심그룹을 로컬에 저장
'============================================================================
Function Save_GWGroup()
	For i = 0 to grdGroup.rowcount-1
		szCode = grdGroup.GetCellData("bd_code",  i)
		szName = grdGroup.GetCellData("bd_name",  i)
		szCnt  = grdGroup.GetCellData("bd_count", i)
		
		if i == 0 then
			szGroup = szCode & "★" & szName & "★" & szCnt
		else
			szGroup = szGroup & "♣" & szCode & "★" & szName & "★" & szCnt
		end if
	Next
	
	Form.SaveConfigData("GWANSIM", "GROUP", szGroup)
End Function

'============================================================================
' Load_GWList :  ' 로컬 저장된 관심종목 가져오기
'============================================================================
Function Load_GWList()
	Dim tGroup, tList

	grdList.rowcount = 0
	szGroup = Form.LoadConfigData("GWANSIM", cmbGroup.cbkeydata)
	
	if szGroup <> "" then
		tGroup = Split(szGroup, "♣")
	
		For i = 0 to #tGroup-1		
			tList = Split(tGroup(i), "★")
			grdList.insertrow = i
			
			'20180905_01 NOHES : 로컬 저장된 빈칸메모 처리
			'if Trim(tList(0)) == "" then
			if Trim(tList(0)) == "" or Trim(tList(0)) == "빈칸" or Trim(tList(0)) == "EMPTY" then
				grdList.SetCellFgColor("bd_code", i, "6")
				grdList.SetCellFgColor("bd_name", i, "6")
				
				grdList.SetCellData("bd_code", i, "빈칸")
				grdList.SetCellData("bd_mk",   i, "")
				grdList.SetCellData("bd_name", i, tList(2))
				grdList.SetCellData("bd_memo", i, tList(2))
				grdList.SetCellImage("bd_mod", i, "icon_group_edit.png")
			else
				grdList.SetCellData("bd_code", i, tList(0))
				grdList.SetCellData("bd_mk",   i, tList(1))
				'szName = Form.GetItemCodeInfo(tList(0), "name")	' 종목명은 저장 안하므로 메인에서 가져온다.
				'grdList.SetCellData("bd_name", i, szName)
				grdList.SetCellData("bd_name", i, trim(tList(3)))	' 20160325 위젯위해 종목명 추가
				grdList.SetCellData("bd_memo", i, "")
			end if
		Next
	end if
End Function

'============================================================================
' Save_GWList
'============================================================================
Function Save_GWList()
	Dim szList, szCd, szMk
	
	For i = 0 to grdList.rowcount-1
		szCd = grdList.GetCellData("bd_code", i)
		szMk = grdList.GetCellData("bd_mk",   i)
		
		if Trim(szMk) == "" then
			szMk = ""
		end if
		
		' 20160325 위젯위해 종목명 추가
		if i == 0 then
			szList = szCd  & "★" & szMk & "★" & grdList.GetCellData("bd_memo", i) & "★" & grdList.GetCellData("bd_name", i)
		else
			szList = szList & "♣" & szCd & "★" & szMk & "★" & grdList.GetCellData("bd_memo", i) & "★" & grdList.GetCellData("bd_name", i)
		end if
	Next

	' 동기화 시는 파일 저장만.. /////////////////////////////////////////////
	if g_szCloud == "0" then

		For j = 0 to grdGroup.rowcount-1
			szCd = grdGroup.GetCellData("bd_code", j)
			
			if cmbGroup.cbkeydata == szCd then
				grdGroup.SetCellData("bd_count", j, grdList.rowcount)
				Exit For
			end if
		Next
	end if
	
	Save_GWGroup()
	
	Form.SaveConfigData("GWANSIM", cmbGroup.cbkeydata, szList)
End Function

'============================================================================
' Change_Len
'============================================================================
Function Change_Len(szData)
	if Len(szData) == 1 then
		Change_Len = "0" & CStr(szData)
	else
		Change_Len = CStr(szData)
	end if 
End Function

'============================================================================
' Check_LocalOrServer : 로컬, 서버 구분하여 종목을 편집한다.
'============================================================================
Function Check_LocalOrServer()

	if g_szCloud == "1" then
		DATAMANAGER.RequestTranData("ohhts_intr_009r")
		Save_GWList()
	else
		Save_GWList()
	end if
End Function

'============================================================================
' Add_Item : 종목추가 : 20160407 종목다중선택위해 변수 추가
'============================================================================
Function Add_Item(nGbn)
	grdList.insertrow = 0
	grdList.SetCellData("bd_memo", 0, "")
	grdList.SetCellData("bd_code", 0, g_szCd)

	szMk   = Form.GetItemCodeInfo(g_szCd, "market")
	szMk   = Change_EtcMarket(szMk)
	
	grdList.SetCellData("bd_mk", 0, szMk)
	
	szName = Form.GetItemCodeInfo(g_szCd, "name")
	grdList.SetCellData("bd_name", 0, trim(szName))
	
	g_szCd = ""
	
	if nGbn == 0 then				' 20160407
		Check_LocalOrServer()
	end if
End Function

'============================================================================
' Change_EtcMarket :  해외지수(대표, 업종지수)/ 채권의 마켓구분 변경
'============================================================================
Function Change_EtcMarket(szData)
	if Trim(szData) == "UJ" then
		return "N"
	elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		return "B"
	end if	
	
	return szData
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()	
	Form.SetScreenName("종목 편집")
	g_nCheckNum = 0
	' 관심 동기화 //////////////////////////////////////////////////////////
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	' //////////////////////////////////////////////////////////////////////
	
	' 그리드 로우 위치 변경 위한 속성
	grdList.rowmove = "1"
	
	' 설정에서 구분자를 받아온다.
	if g_szCloud == "1" then		' Server 저장시
		' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
		DATAMANAGER.RequestTranData("ohhts_intr_006r")
	else							' Local 저장시
		' 로컬 저장된 관심그룹 가져오기
		Load_GWGroup()
		
		' 관심그룹을 그룹콤보에 넣기
		Insert_cmbGroup()
	end if
	
	Dim szDeviceOS
	szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
	
	'20230724 JJH START : IOS 그리드 반복그림 관련 버그 수정
	if szDeviceOS == "2" then '아이폰
		grdList.SetUseScriptImageCell("1")
		
		'20231018 LES START : iOS 그리드 이미지세팅 속도개선 / 드래그동작 개선
		grdList.SetUseLoadFast(true)
		grdList.SetUseNewDragMotion(true)
		
	end if
	
	f_EditVisible("N")
'	g_szGubun = ""
End Sub
'============================================================================
Sub Form_OnFormInitBefore()
	contEdit0.imgDel.setMaintainingRatio("1")
	contEdit0.imgCopy.setMaintainingRatio("1")
	contEdit0.imgMove.setMaintainingRatio("1")
	contEdit0.imgDel0.setMaintainingRatio("1")
End Sub

'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	' 종목삭제
	if sKeyName == "DELETE" then
		if sRet == "ok" then
			if cmbGroup.cbkeydata == "BB" then	'최근조회는 서비스가아닌 메인에 저장
				for i = grdList.rowcount - 1  to 0 Step -1
					if grdList.GetCellData( "bd_check", i ) == "1" then
						dim szCode
						szCode = grdList.GetCellData("bd_code", i)
						Form.DelRecentHistory( szCode )
						grdList.SetDeleteRow(i)
					end if
				next
				f_EditVisible("N")
				Form.Toast(2, "관심종목이 삭제되었습니다.", 0)
				Exit Sub
			end if
		
			if CInt(g_nCheckNum) == CInt(grdList.rowcount) then	'모두 삭제할 때 104r사용
'				for i = grdList.rowcount - 1  to 0 Step -1		'009r 서비스는 전부제거가 안됨 원인 불명
'					if grdList.GetCellData( "bd_check", i ) == "1" then
						DATAMANAGER.RequestTranData("ohhts_intr_104r")
'					end if
'				next
			else
'				
				for i = grdList.rowcount - 1  to 0 Step -1	
					if grdList.GetCellData( "bd_check", i ) == "1" then
						dim szCode
						szCode = grdList.GetCellData("bd_code", i)
						
'						Form.DelRecentHistory( szCode )
						grdList.SetDeleteRow(i)
						
					end if
				next
				Check_LocalOrServer()
			end if
			Form.Toast(2, "관심종목이 삭제되었습니다.", 0)
		end if
	' 종목 추가
	elseif sKeyName == "ADD_ITEM" then
		if sRet == "ok" then	
			Add_Item(0)
		end if
	' 20160407 : 다건종목 추가
'	elseif sKeyName == "ADD_ITEMS" then
'		if sRet == "ok" then
'			For j = 0 to #g_tCode - 1					
'				g_szCd = g_tCode[j]
'				Add_Item(1)
'			Next
'			
'			Check_LocalOrServer()		
'		end if
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	' 빈칸 추가
	if sKeyName == "BLANK_ADD" then
		grdList.insertrow = 0
		
		' 빈칸 색상 적용 (색상은 임시색상)
		grdList.SetCellFgColor("bd_code", 0, "6")
		grdList.SetCellFgColor("bd_name", 0, "6")
		
		grdList.SetCellData("bd_mk",   0, "")
		grdList.SetCellData("bd_code", 0, "빈칸")
		grdList.SetCellImage("bd_mod", 0, "icon_group_edit.png")
		
		'20240524_01 KBC START : 해외주식 고도화 START
		tData = Split(sRet, "★")

		sMemoCaption = tData[0]
		sMemoAlign = tData[1]
		sMemoColor = tData[2]
		
		grdList.SetCellData("bd_name", 0, trim(sMemoCaption))
		grdList.SetCellData("bd_memo", 0, sMemoCaption)
		grdList.SetCellData("bd_memo_align", 0, sMemoAlign)
		grdList.SetCellData("bd_memo_color", 0, sMemoColor)
		'20240524_01 KBC END		
		
		Check_LocalOrServer()
	' 빈칸 수정
	elseif sKeyName == "BLANK_MOD" then
		'20240524_01 KBC START : 해외주식 고도화 START		
		tData = Split(sRet, "★")
		
		sMemoCaption = tData[0]
		sMemoAlign = tData[1]
		sMemoColor = tData[2]
	
		grdList.SetCellData("bd_code", g_szRow, "빈칸")
		grdList.SetCellData("bd_name", g_szRow, sMemoCaption)	
		grdList.SetCellData("bd_memo", g_szRow, sMemoCaption)
		grdList.SetCellData("bd_memo_align", g_szRow, sMemoAlign)
		grdList.SetCellData("bd_memo_color", g_szRow, sMemoColor)
		'20240524_01 KBC END
		
		Check_LocalOrServer()
	elseif sKeyName == "SAVE_DATA" then
		edtvrsnID.caption = Form.GetSharedData("VRSN_ID", false) 
		if g_szCloud == "1" then		' Server 저장시
			' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
			DATAMANAGER.RequestTranData("ohhts_intr_006r")
		else							' Local 저장시
			' 로컬 저장된 관심그룹 가져오기
			Load_GWGroup()
			
			' 관심그룹을 그룹콤보에 넣기
			Insert_cmbGroup()		
		end if
		
	elseif sKeyName == "INTR_MOVE" then
		
		edtvrsnID.caption = Form.GetSharedData("VRSN_ID", false) 
		
		
		if g_szCloud == "1" then		' Server 저장시
			' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
			DATAMANAGER.RequestTranData("ohhts_intr_006r")
		else							' Local 저장시
			' 로컬 저장된 관심그룹 가져오기
			Load_GWGroup()
			
			' 관심그룹을 그룹콤보에 넣기
			Insert_cmbGroup()		
		end if
		
		if CInt(g_nCheckNum) == CInt(grdList.rowcount) then	'모두 삭제할 때 104r사용
			DATAMANAGER.RequestTranData("ohhts_intr_104r")
		else
'				
			for i = grdList.rowcount - 1  to 0 Step -1	
				if grdList.GetCellData( "bd_check", i ) == "1" then
					dim szCode
					szCode = grdList.GetCellData("bd_code", i)
					
					grdList.SetDeleteRow(i)
					
				end if
			next
			Check_LocalOrServer()
		end if
	end if
End Sub


'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
		DATAMANAGER.ClearInputData(0, "ohhts_intr_006r")
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_006r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))	' USER ID
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		DATAMANAGER.ClearInputData(0, "ohhts_intr_007r")
		
		grdList.rowcount = 0	' 종목그리드 초기화
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_USER_ID",			0, Form.GetSharedData("&USER_ID", false))	' USER ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_CNCN_ISSU_NEW_GRP_ID",	0, cmbGroup.cbkeydata)	
'		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_CNCN_ISSU_GRP_ID", 0, cmbGroup.cbkeydata)	
		
	' ----------------------------------------------------------------------
	' 관심 수정 TR :그룹추가, 종목추가, 빈칸추가
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_009r" then
		DATAMANAGER.ClearInputData(0, "ohhts_intr_009r")
		' ////////////// 종목추가, 빈칸적용시 ////////////////
		' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock1", "FID_USER_ID",     0, Form.GetSharedData("&USER_ID", false))	' USER ID
		' FID버전ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)	
		'DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock1", "FID_VRSN_ID",     0, "12")	
		' FID수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock1", "FID_MOD_YN",      0, "0")				
		' FID종목수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock1", "FID_ISSU_MOD_YN", 0, "0")				

		' FID관심종목그룹ID
'		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock2", "FID_CNCN_ISSU_GRP_ID", 0, cmbGroup.cbkeydata)
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock2", "FID_CNCN_ISSU_NEW_GRP_ID", 0, cmbGroup.cbkeydata)
		' FID관심그룹명
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock2", "FID_CNCN_GRP_NAME",    0, cmbGroup.caption)	
		' FID종목수정여부
		DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock2", "FID_ISSU_MOD_YN", 0, "1")			' 수정
'		
'		if Cint(grdList.rowcount) == 0 then
'			DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_OVDV_ISCD", 0, "")
'		end if
''		
		For j = 0 to grdList.rowcount - 1
			' FID관심종목그룹
'			DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_ISSU_GRP_ID",    j, cmbGroup.cbkeydata)	
			DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_ISSU_NEW_GRP_ID",    j, cmbGroup.cbkeydata)	
			' FID관심종목
			DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_ISSU_ID2",       j, Change_Len(j))		
			'DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_ISSU_ID2",       j, j)		
			
			' FID코드구분코드
			if Trim(grdList.GetCellData("bd_mk", j)) == "" then													
				if Trim(grdList.GetCellData("bd_name", j)) == "" then
					DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CODE_CLS_CODE", j, "2")	' 빈칸
				else
					DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CODE_CLS_CODE", j, "3")	' 메모
				end if
			else
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CODE_CLS_CODE", j, "1")		' 종목
			end if
			
			' FID입력시장구분코드
			DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_INPUT_MRKT_CLS_CODE", j, grdList.GetCellData("bd_mk", j))	

			' FID관심종목코드 / FID메모내용
			if Trim(grdList.GetCellData("bd_code", j)) == "빈칸" then
'				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_ISCD", j, "EMPTY")
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_OVDV_ISCD", j, "EMPTY")
				
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_MEMO_CNTT", j, grdList.GetCellData("bd_name", j))	
				
				'20240524_01 KBC START : 해외주식 고도화 START
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_COL_NAME", j, grdList.GetCellData("bd_memo_color", j))	
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_SORT", j, grdList.GetCellData("bd_memo_align", j))	
				'20240524_01 KBC END
			else
				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_OVDV_ISCD", j, grdList.GetCellData("bd_code", j))
				
'				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_ISCD", j, grdList.GetCellData("bd_code", j))

				Dim szGubun 
				if grdList.GetCellData("bd_nation", j) == "OV" then
					szGubun = "OV"
				else
					szGubun = "KR"
				end if

				DATAMANAGER.SetDataValue(0, "ohhts_intr_009r", "InBlock3", "FID_CNCN_GRP_NTNL_CLS_CODE", j, szGubun)
			end if
		Next
	elseif szTranID == "ohhts_intr_104r" then
		DATAMANAGER.ClearInputData(0, "ohhts_intr_104r")
		' FID사용자ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_104r", "InBlock1", "FID_USER_ID",     0, Form.GetSharedData("&USER_ID", false))	' USER ID
		' FID버전ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_104r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)			
		' FID관심종목그룹ID
		DATAMANAGER.SetDataValue(0, "ohhts_intr_104r", "InBlock2", "FID_CNCN_ISSU_NEW_GRP_ID", 0, cmbGroup.cbkeydata)
		
		
		if g_nCheckNum == 1 then
			dim szCode
			szCode  = grdList.GetCellData("bd_code", 0)
			if szCode == "빈칸" then
				szCode = "EMPTY"
			end if
			
			DATAMANAGER.SetDataValue(0, "ohhts_intr_104r", "InBlock3", "FID_OVDV_ISCD", i, szCode)
				
			DATAMANAGER.SetDataValue(0, "ohhts_intr_104r", "InBlock3", "FID_CNCN_ISSU_ID",       i, Change_Len(0))	
		else
			for i = grdList.rowcount - 1  to 0 Step -1
				
				dim szCode
				szCode  = grdList.GetCellData("bd_code", i)
				if szCode == "빈칸" then
					szCode = "EMPTY"
				end if
				DATAMANAGER.SetDataValue(0, "ohhts_intr_104r", "InBlock3", "FID_OVDV_ISCD", i, szCode)
				
				DATAMANAGER.SetDataValue(0, "ohhts_intr_104r", "InBlock3", "FID_CNCN_ISSU_ID",       i, Change_Len(i))	
			Next
		end if
	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_007r" then
		Dim nCnt
		Dim szCode
		
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_intr_007r", "OutBlock1")
		
		For i = 0 to nCnt-1
			szCode = Trim(DATAMANAGER.GetDataValue(0, "ohhts_intr_007r", "OutBlock1", "FID_OVDV_ISCD", i))
			if szCode == "EMPTY" then
				DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "OutBlock1", "FID_OVDV_ISCD", i, "빈칸")
			end if
		Next
		
		grdList.setCellMaxLineCount("bd_name", 2)
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_006r" then
		' 관심그룹을 그룹콤보에 넣기
		Insert_cmbGroup()
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		Dim szMk, szCode, szMemo
			
		For i = 0 to grdList.rowcount - 1
			szMk   = grdList.GetCellData("bd_mk",   i)
			szCode = grdList.GetCellData("bd_code", i)
			szNation = grdList.GetCellData("bd_nation", i)
			
			if szCode == "빈칸" then
				' 빈칸 색상 적용 (색상은 임시색상)
				szMemo = grdList.GetCellData("bd_memo", i)
				grdList.SetCellData("bd_name", i, szMemo)
				
				grdList.SetCellFgColor("bd_code", i, "6")
				grdList.SetCellFgColor("bd_name", i, "6")
				grdList.SetCellImage("bd_mod", i, "icon_group_edit.png")
				
				'20240524_01 KBC START : 해외주식 고도화
'				szMmAlign = grdList.GetCellData("bd_memo_align", i)
'				szMmColor = grdList.GetCellData("bd_memo_color", i)
'								
'				grdList.SetCellBgColor("bd_name", i, szMmColor)
'				
'				if szMmAlign == "1" or szMmAlign == "C" then
'					grdList.SetCellHAlign("bd_name", "1")
'				elseif szMmAlign == "2" or szMmAlign == "R" then
'					grdList.SetCellHAlign("bd_name", "5")
'				else
'					grdList.SetCellHAlign("bd_name", "3")
'				end if
'				
'				if szMmColor == g_color_list(0) or szMmColor == g_color_list(1) or szMmColor == g_color_list(3) or
'				   szMmColor == g_color_list(4) or szMmColor == g_color_list(5) or szMmColor == g_color_list(6) or
'				   szMmColor == g_color_list(7) or szMmColor == g_color_list(10) then
'					'글자색 검정
'					grdList.SetCellFgColor("bd_name", i, "4")
'				else 
'					'글자색 흰색
'					grdList.SetCellFgColor("bd_name", i, "16")				
'				end if								
				'20240524_01 KBC END				
				
			else
'				 종목명 가져오는 함수
				if grdList.GetCellData("bd_nation", i) == "OV" then
					szName = Form.GetItemCodeInfo( szMk & "@" & szCode, "name")
				else
					szName = Form.GetItemCodeInfo(szCode, "name")
				end if
				
				grdList.SetCellData("bd_name", i, trim(szName))
			end if
			grdList.setMaintainingRatio("bd_mod", i, "1")
			grdList.setMaintainingRatio("bd_move", i, "1")
			
			grdList.SetCellImage("bd_move", i, "icon_list_move.png") '20230724 JJH START : IOS 그리드 반복그림 관련 버그 수정
		Next
		
	' ----------------------------------------------------------------------
	' 관심 수정 TR
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_009r" then
		
		' 설정에서 구분자를 받아온다.
		if g_szCloud == "1" then		' Server 저장시
			' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
			DATAMANAGER.RequestTranData("ohhts_intr_006r")
		else							' Local 저장시
			' 로컬 저장된 관심그룹 가져오기
			Load_GWGroup()
		end if
			
		chkAll.chksilence = "0"
		lblChkNum.caption = "전체선택(0)"	
		
		lblChkNum.changeTextAttr(4,3,"7",0,0)
		
		Form.SetSharedData("VRSN_ID", edtvrsnID.caption) ' 20160317 편집시 ID가 메인화면과 연동안되는부분 때문에 추가
	elseif szTranID == "ohhts_intr_104r" then
		chkAll.chksilence = "0"
		lblChkNum.caption = "전체선택(0)"
		lblChkNum.changeTextAttr(4,3,"7",0,0)
		
		' 설정에서 구분자를 받아온다.
		if g_szCloud == "1" then		' Server 저장시
			' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
			DATAMANAGER.RequestTranData("ohhts_intr_006r")
		else							' Local 저장시
			' 로컬 저장된 관심그룹 가져오기
			Load_GWGroup()
		end if
		
		Form.SetSharedData("VRSN_ID", edtvrsnID.caption)
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError : 확인용
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
End Sub

'============================================================================
' cmbGroup_OnEditComplete
'============================================================================
Sub cmbGroup_OnEditComplete(iIndex)
	grdList.rowcount = 0
	f_EditVisible("N")
'	nLength = Cint(Form.getLen(lblChkNum.caption)) - 4
'	lblChkNum.changeTextAttr(4,nLength,"7",0,0)
	
	if cmbGroup.cbkeydata == "BB" then
		contEdit0.tblEdit1.visible = true
		contEdit0.imgDel0.visible = true
		grdList.rowmove = "0"	'20230918 HSZ: 최근조회는 삭제만 가능
	else
		contEdit0.tblEdit1.visible = false
		contEdit0.imgDel0.visible = false
		grdList.rowmove = "1"	'20230918 HSZ: 최근조회는 삭제만 가능
	end if
	lblCombo.caption = cmbGroup.caption
	
	'20160906 NOHES START 선택되어 있는 그룹의 키를 저장한다.
'	Form.SetEnvData("1", "SELECT_GWGROUP" , cmbGroup.cbkeydata) 20211118 HSZ 주석처리-마지막 편집그룹을 저장할 필요 없어서
	'20160906 NOHES END
	
	
	'20190807 LES START
	'마지막 인덱스 => 최근조회종목일때
	cmblastIdx = cmbGroup.rowcount -1
	
	if iIndex = cmblastIdx then
		szRecent = Form.GetRecentHistory("99")
		Load_RecentList(szRecent)
		lblBlank.visible = False
		Exit Sub
	else
		lblBlank.visible = True
	end if
	'20190807 LES START
	
	if g_szCloud == "0" then	' 로컬
		Load_GWList()
	else						' 서버
		' 관심종목 종목 조회
		DATAMANAGER.RequestTranData("ohhts_intr_007r")	
	end if
	
	' 선택되어 있는 그룹의 키를 저장한다. 화면 다시 오픈시 적용
	Form.SetEnvData("1", "SELECT_GWGROUP" , cmbGroup.cbkeydata)
End Sub

'20190807 LES START
'============================================================================
' Load_RecentList :  최근조회종목 리스트
'============================================================================
Function Load_RecentList(szData)
	Dim tList
	Dim szMk, szName
	
	grdList.rowcount = 0

	if Trim(szData) <> "" then
		tList = Split(szData, "`")
		
		'20190207 LES START - 최근조회종목 100개로 제한(영업지원팀 전요셉차장 요청)
		'ORGNSRC
		'For i = 0 to #tList-1
		if #tList >= 100 then
			szLen = 99
		else
			szLen = #tList - 1 
		
		end if
		
		For i = 0 to szLen
			szMk = Form.GetItemCodeInfo(tList(i), "market")
			szMk = Change_EtcMarket(szMk)
			
			grdList.insertrow = i
	
			grdList.SetCellData("bd_code", i, tList(i))
			grdList.SetCellData("bd_mk",   i, szMk)
			grdList.SetCellData("bd_memo", i, "")
			grdList.SetCellData("bd_name", i, Form.GetItemCodeInfo(tList(i), "name"))	' 20160325 위젯위해 종목명 추가
			grdList.SetCellData("bd_move", i, "alpha")								' 20230918 HSZ
		Next
		'20190207 LES END
	
		Form.SetCtlProp("##edtListCnt", "caption", grdList.rowcount)

	end if
End Function
'20190807 LES END

'============================================================================
' lblBlank_OnClick()
'============================================================================
Sub lblBlank_OnClick()
	if Trim(cmbGroup.cbkeydata) == "" then
			Form.ShowAlert(g_szTitle, "새 그룹으로 등록하여 주십시오.")
		Exit Sub
	end if

	if CInt(grdList.rowcount) == 100 then

		Form.ShowAlert(g_szTitle, "관심그룹에 등록 가능한 종목 및 빈칸은\n최대 100개까지 입니다.")

		Exit Sub
	end if

	Form.OpenPopupAnimation("mhprc11010_p15", "BLANK_ADD★", "","2")	
End Sub
'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCode, szName
	Dim nRow
	
	szCode = grdList.GetCellData("bd_code", lRow)
	szName = grdList.GetCellData("bd_name", lRow)
	
	testCode = szCode
	if szCellID == "bd_check" then
		' 20160407 : 기존그룹의 종목은 최소 1개 이상 체크 예외처리 추가(요청자 : 박성민과장)
		' 20160408 : 다시 원복 요청(요청자 : 박성민과장)
		nRow = _tonumber(grdList.rowcount)

		g_nCheckNum = 0
		for i = 0 to nRow - 1
			if grdList.GetCellData( "bd_check", i ) == "1" then
				g_nCheckNum = g_nCheckNum + 1
			end if
		next
		
		if g_nCheckNum == 0 then
			f_EditVisible("N")
		else
			f_EditVisible("Y")
		end if
		
		if g_nCheckNum <> nRow then
			chkAll.chksilence = "0"
		elseif g_nCheckNum == nRow then
			chkAll.chksilence = "1"
		end if
	elseif szCellID == "bd_mod" then
		g_szRow = lRow
		
		' 메모선택시만 빈칸팝업 생성
		if Trim(szCode) == "빈칸" then
			'20240524_01 KBC START : 해외주식 고도화 START
			szAlign = grdList.GetCellData("bd_memo_align", lRow)
			szColor = grdList.GetCellData("bd_memo_color", lRow)
			
			Form.OpenPopupAnimation("mhprc11010_p15", "BLANK_MOD★" & szName & "★" & szAlign & "★" & szColor, "","2")	
			
			'Form.OpenPopupAnimation("mhprc11010_p15", "BLANK_MOD★" & szName, "","2")	
			'20240524_01 KBC END
		end if
	elseif szCellID == "bd_name" then
		if grdList.GetCellData( "bd_check", lRow ) == "1" then
			grdList.SetCellData( "bd_check", lRow, "0" )
		else
			grdList.SetCellData( "bd_check", lRow, "1" )
		end if
		
		nRow = _tonumber(grdList.rowcount)

		g_nCheckNum = 0
		for i = 0 to nRow - 1
			if grdList.GetCellData( "bd_check", i ) == "1" then
				g_nCheckNum = g_nCheckNum + 1
			end if
		next
		
		if g_nCheckNum == 0 then
			f_EditVisible("N")
		else
			f_EditVisible("Y")
		end if
		
		if g_nCheckNum <> nRow then
			chkAll.chksilence = "0"
		elseif g_nCheckNum == nRow then
			chkAll.chksilence = "1"
		end if
	end if
End Sub
'============================================================================
Function _tonumber(szData)
	return tonumber(szData) or 0
End Function
'============================================================================
' grdList_OnDropRow : 종목위치 변경시
'============================================================================
Sub grdList_OnDropRow()
'	Check_LocalOrServer()	'20230918 HSZ 위치이동
End Sub

'============================================================================
' btnPrev_OnClick : 관심그룹보기 ◁(이전)버튼
'============================================================================
Sub btnPrev_OnClick()

	if Int(cmbGroup.currentindex) == 0 then
		cmbGroup.currentindex = cmbGroup.rowcount-1
	else
		cmbGroup.currentindex = cmbGroup.currentindex - 1
	end if
End Sub

'============================================================================
' btnNext_OnClick : 관심그룹보기 ▷(다음)버튼
'============================================================================
Sub btnNext_OnClick()
	if Int(cmbGroup.currentindex) == Int(cmbGroup.rowcount-1) then
		cmbGroup.currentindex = 0
	else
		cmbGroup.currentindex = cmbGroup.currentindex + 1
	end if

	' 콤보의 currentindex변경시 OnEditComplete 이벤트가 적용됨	
End Sub



'============================================================================
Sub contEdit0_tblEdit0_OnClick(lRow , lColumn)
	if lColumn == 0 then
		Form.MsgBox( "관심 종목 삭제", g_nCheckNum & "개 종목을\n삭제하시겠습니까?", "DELETE", 7, "삭제하기", "취소" )
	elseif lColumn == 1 then
		Dim szLink, nCnt
		nCnt = 0
		szCode = ""
		szLink = ""
		
		for i = grdList.rowcount - 1  to 0 Step -1
			if grdList.GetCellData( "bd_check", i ) == "1" then
				Dim szGubun 
				Dim szMk
				if grdList.GetCellData("bd_nation", i) == "OV" then
					szGubun = "OV"
				else
					szGubun = "KR"
				end if			
				
				szCode = grdList.GetCellData("bd_code", i) 
				szMk = grdList.GetCellData("bd_mk", i)
				
				if szCode == "빈칸" then
					szMk = grdList.GetCellData("bd_name", i)
				end if
				
				if szLink == "" then	'마켓넣어서 국내인지 국외인지 구분하기위해
					szLink = szMk & "!" & szCode
				else
					szLink = szLink & ":" & szMk & "!" & szCode
				end if
			end if
		next
		
		Form.OpenPopupAnimation("mhprc11010_p11", szLink & "★COPY", "","2")	
	elseif lColumn == 2 then
		Dim szLink, nCnt
		nCnt = 0
		szCode = ""
		szLink = ""
		
		for i = grdList.rowcount - 1  to 0 Step -1
			if grdList.GetCellData( "bd_check", i ) == "1" then
				Dim szGubun 
				Dim szMk
				if grdList.GetCellData("bd_nation", i) == "OV" then
					szGubun = "OV"
				else
					szGubun = "KR"
				end if			
				
				szCode = grdList.GetCellData("bd_code", i) 
				szMk = grdList.GetCellData("bd_mk", i)
				
				if szCode == "빈칸" then
					szMk = grdList.GetCellData("bd_name", i)
				end if
				
				if szLink == "" then	'마켓넣어서 국내인지 국외인지 구분하기위해
					szLink = szMk & "!" & szCode
				else
					szLink = szLink & ":" & szMk & "!" & szCode
				end if
			end if
		next
		
		Form.OpenPopupAnimation("mhprc11010_p11", szLink & "★MOVE", "","2")	
	end if
End Sub
'============================================================================
Sub contEdit0_tblEdit1_OnClick(lRow , lColumn)

	Form.MsgBox( "관심 종목 삭제", g_nCheckNum & "개 종목을\n삭제하시겠습니까?", "DELETE", 7, "삭제하기", "취소" )

End Sub
'============================================================================
Sub chkAll_OnChange(sCheckState)
	Dim nCnt
	nCnt = grdList.rowcount
	if nCnt <> 0 and nCnt <> "0" then
		if sCheckState == "1" then
			for i = 0 to nCnt - 1
				grdList.SetCellData( "bd_check", i, "1" )
			next
			
			g_nCheckNum = nCnt
			
			f_EditVisible("Y")
		else
			for i = 0 to nCnt - 1
				grdList.SetCellData( "bd_check", i, "0" )
			next
			f_EditVisible("N")
		end if
	end if
End Sub


'============================================================================
Function f_EditVisible(szData)
	if szData == "Y" then
		contEdit0.visible = true
		grdList.height = "437"
	else
		contEdit0.visible = false
		grdList.height = "497"
		chkAll.chksilence = "0"
		g_nCheckNum = 0
	end if

	lblChkNum.caption = "전체선택" & "(" & g_nCheckNum & ")"
	nLength = Cint(Form.getLen(lblChkNum.caption)) - 4
	lblChkNum.changeTextAttr(4,nLength,"7",0,0)
End Function


'============================================================================
Sub Form_OnFormClose()
	Call Check_LocalOrServer()		'20230918 HSZ: 종목편집 후 바로 저장 안하고, 화면 닫기 전에 저장
	g_szGubun = "1"
	Form.SendReturnToParent("GW_SET2", g_szGubun)
End Sub

