' 화 면 명 : 관심종목_종목편집
' 화면설명 : 관심종목_관심그룹에 해당되는 종목을 편집하는 Sub화면
' 작    성 : 2015.12.04 ~ ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szCloud		' 관심동기화(0:미사용(로컬), 1:사용(서버))
Dim g_szRow
Dim g_szCd		' 종목 등록때 필요
g_szCd = ""

Dim g_szTitle
g_szTitle = "알림"

' 20160407 종목다중선택을 위해 필요한 변수
Dim g_tCode
g_tCode = {}

Dim testCode
Dim g_nCheckNum
Dim g_szGubun

'20240524_01 KBC START : 해외주식 고도화
'Dim g_color_list
'g_color_list = {"231230230","191191191","127127127","255124128","244177131","255217102","169209142", "143170220", "068084106", "112048160", "255255255", "000000000"}
'20240524_01 KBC END

