'============================================================================
'f_SetToggleUI(nFlag) : 항목 클릭에 따른 색깔 변동 처리
'============================================================================
Function f_SetToggleUI(nFlag)
	dim szToggleImg0, szToggleImg1, szToggleColor0, szToggleColor1, szToggleImg2
	szToggleImg0 		= "input_01_n.9.png" 	'비활성 이미지
	szToggleImg1 		= "input_01_o.9.png" 	'활성화 이미지
	szToggleImg2 		= "input_02_d.9.png" 	'비활성 이미지
	szToggleColor0 	= "127" 				'비활성 컬러
	szToggleColor1 	= "67" 				'활성화 컬러
	
	if nFlag == 0 then '계약서류제공-알림톡,문자
		if g_szNotiFlag = "talk" then
			contNoti.imgRdo0.imgpath = szToggleImg0
			contNoti.lblTalk.fgcolor = szToggleColor0
			g_szNotiFlag = ""		
		else
			contNoti.imgRdo0.imgpath = szToggleImg1
			contNoti.imgRdo1.imgpath = szToggleImg0
			contNoti.lblTalk.fgcolor = szToggleColor1
			contNoti.lblEmail.fgcolor = szToggleColor0
			g_szNotiFlag = "talk"
		end if		
	elseif nFlag == 1 then '계약서류제공-이메일
		if g_szNotiFlag = "email" then
			contNoti.imgRdo1.imgpath = szToggleImg0
			contNoti.lblEmail.fgcolor = szToggleColor0
			g_szNotiFlag = ""		
		else
			contNoti.imgRdo0.imgpath = szToggleImg0
			contNoti.imgRdo1.imgpath = szToggleImg1
			contNoti.lblTalk.fgcolor = szToggleColor0
			contNoti.lblEmail.fgcolor = szToggleColor1
			g_szNotiFlag = "email"
		end if
	elseif nFlag == 2 then '대차거래통보방법-알림톡,문자
		if g_InfrMthdFlag = "1" then
			ContInput.imgRdo1.imgpath = szToggleImg0
			ContInput.lblInfrMthdSms.fgcolor = szToggleColor0
			g_InfrMthdFlag = ""		
		else
			ContInput.imgRdo0.imgpath = szToggleImg0
			ContInput.imgRdo1.imgpath = szToggleImg1
			ContInput.lblInfrMthdSelf.fgcolor = szToggleColor0
			ContInput.lblInfrMthdSms.fgcolor = szToggleColor1	
			g_InfrMthdFlag = "1"	'SMS
		end if
	elseif nFlag == 3 then '대차거래통보방법-온라인 직접 조회
		if g_InfrMthdFlag = "2" then
			ContInput.imgRdo0.imgpath = szToggleImg0
			ContInput.lblInfrMthdSelf.fgcolor = szToggleColor0
			g_InfrMthdFlag = ""	'온라인직접조회		
		else
			ContInput.imgRdo1.imgpath = szToggleImg0
			ContInput.imgRdo0.imgpath = szToggleImg1
			ContInput.lblInfrMthdSms.fgcolor = szToggleColor0
			ContInput.lblInfrMthdSelf.fgcolor = szToggleColor1
			g_InfrMthdFlag = "2"	'온라인직접조회
		end if
	elseif nFlag == 4 then '지분율 5%이상 종목보유여부 : 보유
		if g_5IssuHldnFlag = "Y" then
			ContInput.imgRdo2.imgpath = szToggleImg0
			ContInput.lbl5issuY.fgcolor = szToggleColor0
			g_5IssuHldnFlag = ""			
		else
			ContInput.imgRdo3.imgpath = szToggleImg0
			ContInput.imgRdo2.imgpath = szToggleImg1
			ContInput.lbl5issuN.fgcolor = szToggleColor0
			ContInput.lbl5issuY.fgcolor = szToggleColor1	
			g_5IssuHldnFlag = "Y"	
		end if
	elseif nFlag == 5 then '지분율 5%이상 종목보유여부 : 미보유
		if g_5IssuHldnFlag = "N" then
			ContInput.imgRdo3.imgpath = szToggleImg0
			ContInput.lbl5issuN.fgcolor = szToggleColor0
			g_5IssuHldnFlag = ""				
		else
			ContInput.imgRdo2.imgpath = szToggleImg0
			ContInput.imgRdo3.imgpath = szToggleImg1
			ContInput.lbl5issuY.fgcolor = szToggleColor0
			ContInput.lbl5issuN.fgcolor = szToggleColor1	
			g_5IssuHldnFlag = "N"		
		end if
	elseif nFlag == 6 then '계약서류제공 관련 비활성화..(약정변경시)
		g_szNotiFlag = ""
		contNoti.visible = false
		'contNoti.imgRdo0.imgpath = szToggleImg2
		'contNoti.imgRdo1.imgpath = szToggleImg2
		'contNoti.lblTalk.fgcolor = szToggleColor0
		'contNoti.lblEmail.fgcolor = szToggleColor0	
		
		'contNoti.Label6.visible = false
		'contNoti.btnTooltip1.visible = false
		'contNoti.Image2.visible = false
		'contNoti.lblTalk.visible = false
		'contNoti.imgRdo0.visible = false
		'contNoti.lblEmail.visible = false
		'contNoti.imgRdo1.visible = false
		
		ConAddr.top = 265
		btnReg.caption = "변경하기"
	elseif nFlag == 7 then	 '전체 초기화
		g_szNotiFlag = ""			
		contNoti.imgRdo0.imgpath = szToggleImg0
		contNoti.lblTalk.fgcolor = szToggleColor0
		contNoti.imgRdo1.imgpath = szToggleImg0
		contNoti.lblEmail.fgcolor = szToggleColor0		

		g_InfrMthdFlag = ""			
		ContInput.imgRdo1.imgpath = szToggleImg0
		ContInput.lblInfrMthdSms.fgcolor = szToggleColor0
		ContInput.imgRdo0.imgpath = szToggleImg0
		ContInput.lblInfrMthdSelf.fgcolor = szToggleColor0

		g_5IssuHldnFlag = ""			
		ContInput.imgRdo2.imgpath = szToggleImg0
		ContInput.lbl5issuY.fgcolor = szToggleColor0
		ContInput.imgRdo3.imgpath = szToggleImg0
		ContInput.lbl5issuN.fgcolor = szToggleColor0			
	else
		'contNoti.imgRdo0.imgpath = szToggleImg0
		'contNoti.imgRdo1.imgpath = szToggleImg0
		'contNoti.lblTalk.fgcolor = szToggleColor0
		'contNoti.lblEmail.fgcolor = szToggleColor0		
		g_szNotiFlag = ""
		g_InfrMthdFlag = ""
		g_5IssuHldnFlag = ""
		Exit Function
	end if
End Function

'============================================================================
'f_SetToggleData(sFlag) : 서류제공방법 DATA SET
'============================================================================
Function f_SetToggleData(sFlag)
	if sFlag == "" or sFlag == null then
		Exit Function
	end if
	Dim szData
	szData = ""
	if sFlag == "talk" then '알림,톡
		szData = ConAddr.tblUserInfo.GetCellString(0, 1) '폰번호
	elseif sFlag == "email" then '이메일
		szData = ConAddr.tblUserInfo.GetCellString(1, 1) '이메일
	end if
	if szData <> "" and szData <> null then
		'contNoti.tblInfo.SetCellString(0, 0, szData)
		'contNoti.tblInfo.SetCellString(0, 1, "변경하기 〉")
		ConAddr.lblInfoMod.caption = "변경하기 >"
	else
		'contNoti.tblInfo.SetCellString(0, 0, "")
		'contNoti.tblInfo.SetCellString(0, 1, "등록하기 〉")
		ConAddr.lblInfoMod.caption = "등록하기 >"
	end if
End Function

'============================================================================
'f_SetBtnRegEnable() : 신청 처리 버튼 상태 결정
'============================================================================
Function f_SetBtnRegEnable()

	'비밀번호 입력여부
	'if f_CheckPwd() == false then
	'	Exit Function
	'end if

	'변경시...
	if gStplStatClsCode <> "01" then
		
		'이용동의서류 제공방식 선택 여부
		if g_szNotiFlag == "" or g_szNotiFlag == null then
			btnReg.enable = false
			Exit Function	
		end if			
	
		'대차거래통보방법 선택여부
		if g_InfrMthdFlag == "" or g_InfrMthdFlag == null then
			btnReg.enable = false
			Exit Function	
		end if	
		
		'지분율5%이상 종목보유여부 선택여부
		if g_5IssuHldnFlag == "" or g_5IssuHldnFlag == null then
			btnReg.enable = false
			Exit Function	
		end if			
			
	else
		'약정상태인 경우 계약서류 관련은 입력 불필요.
			
		'대차거래통보방법이나 지분율5%이상종목보유여부를 입력하여야 함.
		if (g_InfrMthdFlag == "" or g_InfrMthdFlag == null) and (g_5IssuHldnFlag == "" or g_5IssuHldnFlag == null) then
			btnReg.enable = false
			Exit Function	
		end if	
		
	end if

			
	'신청가능
	btnReg.enable = true
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
Sub Form_OnFormInitBefore()
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 
	imgTitle.SetMaintainingRatio("1")
	ContInput.Image1.SetMaintainingRatio("1")
	ContInput.Image0.SetMaintainingRatio("1")	
	contNoti.Image2.SetMaintainingRatio("1")	
End Sub


'============================================================================
Sub Form_OnFormInit()
	dim nBgImgHeight
	gBgImgTop = 105
    	nBgImgHeight = 150
    
	g_nTooltip_Top = gBgImgTop + nBgImgHeight 

	g_szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	g_ServerMode 	= Form.GetSharedData("&SERVER_MODE", false)
	g_szSavePwd 	= Form.GetEnvData("order.save_orderpwd")					' 계좌비밀번호 저장여부
	edtPassword.caption = ""
	if g_szSavePwd == "0" then
		'edtPwdIcon.imgpath = "icon_save_password_n.9"
		edtPassword.caption = ""
	'else
		'edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'btnPwd.bringfront("1")
	
	ContInput.visible = true
	contNoti.visible = true
	btnReg.enable = false
	ConAddr.lblInfoMod.caption = "변경하기 >"
	
	'초기화
	g_szNotiFlag = ""
	g_InfrMthdFlag = ""
	g_5IssuHldnFlag = ""
	g_SrvSrno = ""
	g_NewSrvSrno = ""
	gStplStatClsCode = ""
	g_FnprJoinSrno = ""	
	f_SetToggleUI(7) '초기화
	
	'계좌 체크
	if cmbAccount.caption <> "" and cmbAccount.caption <> null then 
		DATAMANAGER.RequestTranData("obcsb_acif_000r") '계좌정보(영문명) 조회
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'==============================================
	'*********** 팝업창에서 계좌비번 수신 ************
	'==============================================
	'msgbox "sKeyName="&sKeyName&" sRet="&sRet
	
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPassword.pwdlen = tData(1)
				edtPassword.caption = tData(0)
				edtPassword_OnEditComplete()
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			'if g_szSavePwd == "0" then
			'	edtPwdIcon.imgpath = "icon_save_password_n.9"
			'else
			'	edtPwdIcon.imgpath = "icon_save_password_o.9"
			'end if
		else
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				'edtPwdIcon.imgpath = "icon_save_password_n.9"
				edtPassword.caption = ""
			else
				szCurAcc = cmbAccount.caption
				nCnt = Cint(cmbAccount.accountcount)
				For i = 0 to nCnt - 1
					szCompAcc = cmbAccount.getAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						cmbAccount.currentindex = i
						Exit For
					end if
				Next
				
				'edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
		end if
	'===============================================
	'********** 고객정보 변경 팝업 리턴  ***********
	'===============================================
	ElseIf sKeyName = "mbonl81000" Then
		btnReg.visible = true
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obcsb_acif_140r" )
		end if	
	'===============================================
	'********** 약관 동의 팝업 리턴  ***********
	'===============================================		
	ElseIf sKeyName = "mbonl88024_p2" Then		
		btnReg.visible = true
		if sRet == "ok" then
			'DATAMANAGER.RequestTranData( "obsap_acif_999a" )	
			Dim sSendData
			sSendData = cmbAccount.total&cmbAccount.sequence&"☆"&"0"
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")			
		end if	
	'===============================================
	'********** 처리완료 팝업 리턴  ***********
	'===============================================		
	ElseIf sKeyName = "mbonl88024_p3" Then	
		'btnReg.enable = false
		'f_SetToggleUI(7)	'초기화
		'DATAMANAGER.RequestTranData( "obpds_srvc_169r" )	
		
		Form.CloseForm()
	end if
End Sub	

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)	
	'msgbox "sKeyName="&sKeyName&" sRet="&sRet
	if sKeyName = "MOD_END" then	'수정이 완료되었습니다.
		'Form.CloseForm()		
		btnReg.enable = false
		f_SetToggleUI(7)	'초기화		
		DATAMANAGER.RequestTranData( "obpds_srvc_169r" )	
	elseif sKeyName = "TR_ERROR" then
		Form.CloseForm()
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim szCust_Num, szPwd
	'패스워드 암호화여부
	If g_PlainRm = "1" Then
		szPwd = edtPassword.caption
	Else
		 szPwd = edtPassword.encdata
	    if Trim(szPwd) == "" or Trim(szPwd) == null then
		    szPwd = edtPassword.caption
	    end if
	End If
	'고객번호	
	szCust_Num = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴

	if szTranID == "obcsb_acif_000r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , szPwd)
	elseif szTranID == "obcsb_acif_140r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
	elseif szTranID == "obpds_srvc_169r" then 	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , cmbAccount.sequence)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , szCust_Num)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "029")
	elseif szTranID == "obpds_srvc_168a" then 
		if gStplStatClsCode = "01" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "U")	
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "I")	
		end if
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" 				, 0 , szCust_Num)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" 				, 0 	, "029")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_SRNO" 			, 0 	, g_SrvSrno)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_MANG_UNIT_CODE"	, 0 , "03")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 				, 0 , cmbAccount.total)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 				, 0 , cmbAccount.sequence)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" 			, 0 , szPwd)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE"		, 0 , "4")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "INFR_MTHD_CLCD"		, 0 , g_InfrMthdFlag)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SPF_ISSU_HLDN_YN"		, 0 , g_5IssuHldnFlag)
	
	elseif szTranID == "obcsb_acad_122a" then	
		
		dim strCustTelno, strAddr, strInagTypeCode, strInagSrno, gFnprJoinSrno
				
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PROS_CLS_CODE"      , 0 , "1")
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO"     , 0 , g_FnprJoinSrno)
		
		if g_szNotiFlag == "talk" then
			strCustTelno = ConAddr.tblUserInfo.GetCellString(0, 1)
			strInagTypeCode = ConAddr.tblUserInfo.GetCellString(0, 2)
			strInagSrno = ConAddr.tblUserInfo.GetCellString(0, 3)
			
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "HNDV_MTHD_CODE", 0 , "04")
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "INAG_TYPE_CODE", 0 , strInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "INAG_SRNO"     , 0 , strInagSrno)
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "UI_CUST_TELNO" , 0 , strCustTelno)
		elseif g_szNotiFlag == "email" then
			strAddr = ConAddr.tblUserInfo.GetCellString(1, 1)
			strInagTypeCode = ConAddr.tblUserInfo.GetCellString(1, 2)
			strInagSrno = ConAddr.tblUserInfo.GetCellString(1, 3)

			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "HNDV_MTHD_CODE", 0 , "02")
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "INAG_TYPE_CODE", 0 , strInagTypeCode)
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "INAG_SRNO"     , 0 , strInagSrno)
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ADDR"          , 0 , strAddr)
		End If 		
		
	elseif szTranID == "obcsb_dbif_322a" then 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 				 , 0 , cmbAccount.total	) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO" 	 , 0 , g_FnprJoinSrno		) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "BSWR_LRDV_CODE" 	 , 0 , "017"				)	'001:계좌개설 / 017:서비스약정 		
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "FNPR_JOIN_DETL_SRNO" , 0 , "00001"			)	'다건일경우 하나씩 증가
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ISCD"				 , 0 , "029"				)	'prcd:계좌개설 / svcd:서비스약정 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "BSWR_DIV_CODE" 		 , 0 , "02029"			)    '02||SVCD
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "CNRC_DOCU_KEY_VAL"	 , 0 , szCust_Num&"$029$"&g_NewSrvSrno )	'고객번호$서비스코드$서비스일련번호 
		
	end if
	
End Sub	

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcsb_acif_000r" then
				
		DATAMANAGER.RequestTranData("obcsb_acif_140r") '폰번호, 이메일 조회
		
		'신청버튼 활성화 확인
		'f_SetBtnRegEnable()
	
	elseif szTranID == "obpds_srvc_169r" then
		dim tInfrMthdCd, tSpfIssuYn
		
		g_SrvSrno 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SVC_SRNO" , 0)
		'gStplStatClsCode 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "STPL_STAT_CLS_CODE" , 0)
		tInfrMthdCd		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INFR_MTHD_CLCD" , 0)
		tSpfIssuYn		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SPF_ISSU_HLDN_YN" , 0)
		gApltAbleYn		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "APLT_ABLE_YN" , 0)	'신청가능여부
		
		if tInfrMthdCd = "1" then
			f_SetToggleUI(2)
		elseif tInfrMthdCd = "2" then
			f_SetToggleUI(3)
		end if
		
		if tSpfIssuYn = "Y" then
			f_SetToggleUI(4)
		elseif tSpfIssuYn = "N" then
			f_SetToggleUI(5)
		end if	
		
		'약정등록상태인 경우..
		'if gStplStatClsCode = "01" then
		if cInt(g_SrvSrno) > 0 then
			gStplStatClsCode = "01"
			'contNoti.lblTalk.enable = false
			'contNoti.lblEmail.enable = false
			f_SetToggleUI(6)
			f_SetBtnRegEnable()
		else
		    gStplStatClsCode = ""
			    
		    '미약정인 경우, 신청상태가 불가상태이면 팝업창 띄움.
		    if gApltAbleYn = "N" then
			    'btnReg.enable = false
				'Form.ShowAlert( "알림" , DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_PRHB_DTL_CNTT" , 0))				
				Form.MsgBox( "알림", DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_PRHB_DTL_CNTT" , 0), "TR_ERROR", "0")
		    end if
		end if
		
	elseif szTranID == "obpds_srvc_168a" then		
	
		g_NewSrvSrno 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SVC_SRNO" , 0)
		
		'약정변경일땐 안타고 약정등록일때만 탐
		if gStplStatClsCode <> "01" then
			DATAMANAGER.RequestTranData( "obcsb_dbif_322a" )	'계약서류최종등록
		else
			'Form.ShowAlert( "안내" , "보유주식 수익 서비스 정보가 변경되었습니다.")
			'Form.MsgBox("안내", "보유주식 수익 서비스 정보가 변경되었습니다.", "MOD_END", 0)
			
			dim sSendData
			sSendData = cmbAccount.total & cmbAccount.sequence & "★" & "U" & "★" & g_InfrMthdFlag & "★" & g_szNotiFlag & "★" & g_5IssuHldnFlag
			Form.OpenPopup("mbonl88024_p3" , sSendData , "")			
		end if
	
	elseif szTranID == "obcsb_acif_140r" then
		
		If DATAMANAGER.IsMoreNextData(szTranID) = True Then
			DATAMANAGER.RequestNextData(szTranID)
		Else 
			Dim iCnt, iCnt1
			
			'이메일 주소
			iCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2")
			For i = 0 to iCnt - 1
			    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_TYPE_CODE" , i)
			    strInagSrno2     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "INAG_SRNO"      , i)
			    strAddr          = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ADDR"           , i)
			    
			    If strInagTypeCode2 = "21" Then
					ConAddr.tblUserInfo.SetCellString(1, 1, strAddr)
					ConAddr.tblUserInfo.SetCellString(1, 2, strInagTypeCode2)
					ConAddr.tblUserInfo.SetCellString(1, 3, strInagSrno2)
			    End If
			Next 	
			'휴대폰 번호
			iCnt1 = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock3")
			For i = 0 to iCnt1 - 1
			    strInagTypeCode3 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_TYPE_CODE" , i)
			    strInagSrno3     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "INAG_SRNO"      , i)
			    strCustTelno     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "UI_CUST_TELNO"  , i)

			    If strInagTypeCode3 = "13" Then
				    ConAddr.tblUserInfo.SetCellString(0, 1, strCustTelno)
				    ConAddr.tblUserInfo.SetCellString(0, 2, strInagTypeCode3)
				    ConAddr.tblUserInfo.SetCellString(0, 3, strInagSrno3)
			    End If
			Next
			'f_SetToggleData(g_szNotiFlag)
			
			DATAMANAGER.RequestTranData("obpds_srvc_169r")
		End If 	
	elseif szTranID == "obsap_acif_999a" then	
		
		g_FnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호

		DATAMANAGER.RequestTranData( "obcsb_acad_122a" )	'계약서류
		
	elseif szTranID == "obcsb_acad_122a" then
	
		DATAMANAGER.RequestTranData( "obpds_srvc_168a" )  '약정처리 호출
	
	elseif szTranID == "obcsb_dbif_322a" then 
		
		dim sSendData
		sSendData = cmbAccount.total & cmbAccount.sequence & "★" & "I" & "★" & g_InfrMthdFlag & "★" & g_szNotiFlag & "★" & g_5IssuHldnFlag
		Form.OpenPopup("mbonl88024_p3" , sSendData , "")
		
	end if
	
End Sub			

