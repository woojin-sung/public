'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubErr <> null and Trim(szSubErr) <> "" then
		'Form.ShowAlert( "안내" , szErrMsg.."("..szSubErr..")")
		Form.MsgBox( "안내", szErrMsg.."("..szSubErr..")", "TR_ERROR", "0")
	else
		'Form.ShowAlert( "안내" , szErrMsg)		
		Form.MsgBox( "안내", szErrMsg, "TR_ERROR", "0")
	end if
	
End Sub

