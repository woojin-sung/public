Sub edtPassword_OnEditComplete()
	'f_isShowNotiCont()
	
	'약정등록상태인 경우..
	if gStplStatClsCode = "01" then
		'변경으로 처리
		DATAMANAGER.RequestTranData( "obpds_srvc_168a" )  '약정변경처리 호출
	else
		DATAMANAGER.RequestTranData( "obsap_acif_999a" )	'약정전 교부서류 일련번호 채번
	end if
	
End Sub

