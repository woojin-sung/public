'============================================================================
' 다음 버튼 클릭..
'============================================================================
Sub btnReg_OnClick()

	'약정등록상태인 경우..
	if gStplStatClsCode = "01" then
		'변경으로 처리
		'DATAMANAGER.RequestTranData( "obpds_srvc_168a" )  '약정처리 호출
		
		Dim sSendData
		sSendData = cmbAccount.total&cmbAccount.sequence&"☆"&"0"
		Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")	
		
	else
		'약관동의 팝업..
		'Form.OpenPopup("mbonl88024_p2" , "" , "")
		Form.openPopupAnimation("mbonl88024_p2","","","2")
		
		'sSendData = "87052_"&sRegType & "★" & cmbAccount.total & "★" & cmbAccount.sequence & "★" & edtPassword.caption & "★" & "079" 
		'Form.OpenPopup("mbonl81010_p1" , sSendData , "")
	end if

End Sub

