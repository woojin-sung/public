'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim szSect
	 
	
	g_szItemSect = Form.GetOpenLinkData()
	
	'g_szFileName = "41000P4_Setting.ini"
	g_szFileName = "04000ITEMS.ini"	'20200331 HWG : 고유MTS
	
	if	g_szItemSect	=	"0"	or	g_szItemSect = ""	then
		g_szCntFileName	= "nhnts04000p2_Set.ini"	'20200331 HWG : 고유MTS
		
		szSect 	=  Form.LoadConfigData(g_szCntFileName, "04000P2_TILE")	'20200331 HWG : 고유MTS
		if szSect = "1" then
			g_nLimit	=	3
		else
			g_nLimit	=	6
		end if 
		
		cont01.left = 0
		cont02.left = 400
		cont03.left = 400
		cont04.left = 400
	elseif	g_szItemSect	=	"1"	then
		cont01.left = 400
		cont02.left = 0
		cont03.left = 400
		cont04.left = 400
	elseif	g_szItemSect	=	"2"	then
		cont01.left = 400
		cont02.left = 400
		cont03.left = 0
		cont04.left = 400
	elseif	g_szItemSect	=	"3"	then
		cont01.left = 400
		cont02.left = 400
		cont03.left = 400
		cont04.left = 0
	end if
	
	Call LoadSettings()
End Sub


'============================================================================
'btnSave_OnClick
'============================================================================
Sub btnSave_OnClick()
	Call SaveSettings()
	Form.CloseForm(1)
End Sub


'============================================================================
'chkKospi_OnChange
'============================================================================
Sub cont01_chkKospi_OnChange(sCheckState)
	dim szRet
	szRet =  chkCount(g_szKeys, 0, g_nTileMaLim )
	
	if szRet = -2 and sCheckState = "1" then
		Form.ShowAlert("안내",  g_nTileMaLim & "개 이하 선택하세요")
		cont01.chkKospi.chksilence =  "0"
	end if 
End Sub


