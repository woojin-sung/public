'============================================================================
'chkCount:	체크한 값이 MIN MAX를 벗어나지 않도록 체크
'============================================================================
Function chkCount(szArray, szMin, szMax)
	dim szVal
	dim nTotalCnt
	
	nTotalCnt = 0 
	For i = 0 to UBound(szArray)
		szVal = Form.GetCtlProp(szArray(i), "checkstate")

		if szVal = "1"  then
			nTotalCnt = nTotalCnt +1 			'체크된 카운트 갯수
		end if 
	
	Next 
	
	if nTotalCnt < szMin	then
		return -1					'최소값보다작을때
	elseif	nTotalCnt >  szMax then
		return -2					'최대값보다 클때
	end if 
	
	return 0
	
End Function


