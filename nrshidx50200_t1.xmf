'============================================================================
Sub contMain_OnGestureEvent(sParam)
	if sParam == "Up" Then
		contMain.fixTopAreaWhenScrolling("1", 0, "Up")
	elseif sParam == "Down" Then
		contMain.fixTopAreaWhenScrolling("1", 132, "Down")
	end if
End Sub

'============================================================================
Function contMain_contLink_OnNotifyScrolling(nIndex)
	If nIndex == 0 Then
		contMain.rdoType.SetCurIndexSilent("0")
	ElseIf nIndex == 1 Then
		contMain.rdoType.SetCurIndexSilent("1")
	ElseIf nIndex == 2 Then
		contMain.rdoType.SetCurIndexSilent("2")
	ElseIf nIndex == 3 Then
		contMain.rdoType.SetCurIndexSilent("3")
	ElseIf nIndex == 4 Then
		contMain.rdoType.SetCurIndexSilent("4")
	Else
		contMain.rdoType.SetCurIndexSilent("5")
	End If
End Function



