	<SCRIPT_INFO _len="4975" _ulen="4869" >

Dim g_nPos1, g_nPos2, g_nPos3, g_nPos4, g_nPos5, g_nPos6
Dim gOsType

'============================================================================
Sub Form_OnFormInitBefore()
	gOsType = Form.GetSharedData("&OS_TYPE", false)
	imgGuide.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_nPos1 = 0
	g_nPos2 = 476
	g_nPos3 = 1496
	g_nPos4 = 2703
	g_nPos5 = 3583
	g_nPos6 = 4468
	
	contMain.rdoType.currentindex = 0
	
	' 컨테이너 스크롤 위치 알림 활성화
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		scrollpos1 = CInt(Form.calcUnResize(contMain.contLink.lkformS1.top, "1")) - 300
		scrollpos2 = CInt(Form.calcUnResize(contMain.contLink.lkformS2.top, "1")) - 300
		scrollpos3 = CInt(Form.calcUnResize(contMain.contLink.lkformS3.top, "1")) - 300
		scrollpos4 = CInt(Form.calcUnResize(contMain.contLink.lkformS4.top, "1")) - 300
		scrollpos5 = CInt(Form.calcUnResize(contMain.contLink.lkformS5.top, "1")) - 300
		scrollpos6 = CInt(Form.calcUnResize(contMain.contLink.lkformS6.top, "1")) - 300
	else
		scrollpos1 = contMain.contLink.lkformS1.top
		scrollpos2 = contMain.contLink.lkformS2.top
		scrollpos3 = contMain.contLink.lkformS3.top
		scrollpos4 = contMain.contLink.lkformS4.top
		scrollpos5 = contMain.contLink.lkformS5.top
		scrollpos6 = contMain.contLink.lkformS6.top
	end if
	
	contMain.contLink.SetNotifyScrollPos(scrollpos1..":"..scrollpos2..":"..scrollpos3..":"..scrollpos4..":"..scrollpos5..":"..scrollpos6)
	
	contMain.gesture = true
	
	contMain.contLink.SetUseScrollingEvent(true) '아이폰에서 contMain.contLink_OnNotifyScrolling 사용
End Sub

'============================================================================
Sub contMain_rdoType_OnClick(nIndex)
'	if nIndex == 0 then
'		contMain.lkformScreen.linkfile = "nrshidx50200_s1"
'	elseif nIndex == 1 then
'		contMain.lkformScreen.linkfile = "nrshidx50200_s2"
'	elseif nIndex == 2 then	
'		contMain.lkformScreen.linkfile = "nrshidx50200_s3"
'	elseif nIndex == 3 then
'		contMain.lkformScreen.linkfile = "nrshidx50200_s4"
'	elseif nIndex == 4 then
'		contMain.lkformScreen.linkfile = "nrshidx50200_s5"
'	elseif nIndex == 5 then
'		contMain.lkformScreen.linkfile = "nrshidx50200_s6"
'	end if
	
	if gOsType == "1" then
	
		if nIndex == 0 then
			contMain.contLink.scroll_pos = g_nPos1
		elseif nIndex == 1 then
			contMain.contLink.scroll_pos = g_nPos2
		elseif nIndex == 2 then	
			contMain.contLink.scroll_pos = g_nPos3
		elseif nIndex == 3 then
			contMain.contLink.scroll_pos = g_nPos4
		elseif nIndex == 4 then
			contMain.contLink.scroll_pos = g_nPos5
		elseif nIndex == 5 then
			contMain.contLink.scroll_pos = g_nPos6
		end if
		
	else
	
		if nIndex == 0 then
			contMain.contLink.scroll_pos_noAni = g_nPos1
		elseif nIndex == 1 then
			contMain.contLink.scroll_pos_noAni = g_nPos2
		elseif nIndex == 2 then	
			contMain.contLink.scroll_pos_noAni = g_nPos3
		elseif nIndex == 3 then
			contMain.contLink.scroll_pos_noAni = g_nPos4
		elseif nIndex == 4 then
			contMain.contLink.scroll_pos_noAni = g_nPos5
		elseif nIndex == 5 then
			contMain.contLink.scroll_pos_noAni = g_nPos6
		end if
	
	end if
End Sub

