	<SCRIPT_INFO _len="7969" _ulen="7597" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 연금저축 납입한도 변경
' 02. 화면설명 : 
' 03. 이    력 : 2023.01.09. 장원혁
'                2024.01.25 : 고승연 : v0002 : 연금저축 계좌목록 조회 수정
'-------------------------------------------------------------------------------------------

Dim g_CustName '고객명
Dim g_DeviceOS
Dim g_sCsno		'v0002
Dim g_sElfnId		'v0002

'============================================================================
Sub Form_OnFormInit()
    g_DeviceOS = Form.GetSharedData("&OS_TYPE", FALSE) '1.안드로이드 2.iOS
    g_sCsno = Form.GetSharedData("&CUST_NUM", FALSE)
    g_sElfnId = Form.GetSharedData("&USER_ID", FALSE)
    
    ContMain.SetScrollAutoSize()

    g_CustName = Form.GetSharedData( "&USER_NAME", false )
    
    Cont0.lblAgrm.caption = ""
    ContMain.ChkAgrm.checkstate = "0"

	'v0002
	DATAMANAGER.RequestTranData("obcsb_efif_028r")
	
    'DATAMANAGER.RequestTranData("obcsb_efif_021r")
    
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

    If sKeyName == "Complete" Then
        DATAMANAGER.RequestTranData("obaci_pnsn_003r")
    End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	'v0002
	IF szTranID == "obcsb_efif_028r" Then
		DATAMANAGER.RequestTranData("obcsb_efif_021r")
	ELSEIF szTranID == "obcsb_efif_021r" Then
		trCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		trAlsCode = DATAMANAGER.GetDataValue(0 , "obcsb_efif_028r" , "OutBlock1" , "ACNT_ALS_EXRS_CODE", 0)
		
		FOR i = 0 TO trCnt - 1
			trAcno = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "REG_ACNO"       , i)
			trAsno = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "REG_ASNO"       , i)
			trPrcd = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "PRCD"           , i)
			trStatCode = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ACNT_STAT_CODE" , i)
			trCustName = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "CUST_ABWR_NAME" , i)
			trBkkpName = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "INPR_BKKP_NAME" , i)
			
			'별명 표시인 경우
			IF trAlsCode == "2" AND LEN(TRIM(trBkkpName)) > 0 THEN
				trCustName = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "INPR_BKKP_NAME" , i)
			END IF
				
			'정상 연금저축 계좌인 경우
			IF trPrcd == "131" AND trStatCode == "1" THEN
				cmbAcnt.cbadddatatext = trAcno .. trAsno .. "`" .. "[연금저축] " .. LEFT(trAcno, 4) .. "-" .. RIGHT(trAcno, 4) .. "-" .. trAsno .. " " .. trCustName
			END IF
		NEXT
		
		'다음조회 데이터들이 있다면 연속해서 조회
		IF DATAMANAGER.IsMoreNextData(szTranID) THEN
			DATAMANAGER.RequestNextData(szTranID)
			EXIT SUB
		END IF
		
		'계좌조회 후 비밀번호 관련 초기화
		edtPwd.caption = ""
		
		IF TRIM(cmbAcnt.cbkeydata) <> "" THEN
			DATAMANAGER.RequestTranData("obaci_pnsn_003r")
		END IF
		
	END IF
	
    If szTranID == "obaci_pnsn_003r" Then
        szAgrmYN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "AGRM_YN" , 0)
        If szAgrmYN == "Y" Then
            Cont0.lblAgrm.caption = "동의"
            ContMain.ChkAgrm.enable = False
            ContMain.ChkAgrm.checkstate = "0"
        Else
            Cont0.lblAgrm.caption = "미동의"
            ContMain.ChkAgrm.enable = True
        End If
    End If
    
    If szTranID == "obaci_pnsn_004a" Then
        Form.MsgBox( "알림", "연금저축계좌 리츠매매\n사전동의가 완료되었습니다.\n\n리츠종목 매매가 가능합니다.", "Complete", 6 )	
    End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    szSubErr = Trim(DATAMANAGER.GetDataMsgSubText( szTranID ))

    If szSubErr == "" Then
        Form.MsgBox( "알림", szErrMsg, "", 6 )		
    Else
        Form.MsgBox( "알림", szErrMsg.."\n("..szSubErr..")", "", 6 )		
    End If
		
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	IF szTranID == "obcsb_efif_028r" THEN
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "IQRY_CLS_CODE"	, 0 , "1"								)
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ELFN_ID"		, 0 , Form.GetSharedData("&USER_ID", False)	)
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "RCNO_PIP"		, 0 , Form.GetSharedData("&JUMIN_NUM", False)	)
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CSNO"			, 0 , Form.GetSharedData("&CUST_NUM", False)	)
	END IF
    
    If szTranID == "obcsb_efif_021r" Then
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "2")
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ELFN_ID"       , 0 , Form.GetSharedData("&USER_ID", False)  )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "RCNO_PIP"      , 0 , Form.GetSharedData("&JUMIN_NUM", False))
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "VLTN_ACMP_YN"  , 0 , "N")
    End If

    If szTranID == "obaci_pnsn_003r" Then
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "IQRY_CLS_CODE"      , 0 , "1")
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "IQRY_STA_DATE"      , 0 , "")
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "IQRY_FIN_DATE"      , 0 , "")
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"               , 0 , Left(cmbAcnt.cbkeydata , 8))
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ASNO"               , 0 , Right(cmbAcnt.cbkeydata , 2))
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "AGRM_YN"            , 0 , "%")
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CHAN_TYPE_CLS_CODE" , 0 , "%")
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "INDV_MANG_BRCD"     , 0 , "%")
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNT_STAT_CODE"     , 0 , "%")    
    End If
    
    If szTranID == "obaci_pnsn_004a" Then
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "")
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"          , 0 , Left(cmbAcnt.cbkeydata , 8))
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ASNO"          , 0 , Right(cmbAcnt.cbkeydata , 2))
    End If
    
    If szTranID == "obacp_opop_066r" Then
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"     , 0 , Left(cmbAcnt.cbkeydata , 8))
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ASNO"     , 0 , Right(cmbAcnt.cbkeydata , 2))
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNT_PWD" , 0 , edtPwd.caption)
    End If
    
End Sub

'============================================================================
Sub cmbAcnt_OnEditComplete(iIndex)
    DATAMANAGER.RequestTranData("obaci_pnsn_003r")
End Sub

'============================================================================
Sub edtPwd_OnEditComplete()
    DATAMANAGER.RequestTranData("obacp_opop_066r")
End Sub

'============================================================================
Sub btnProc_OnClick()

    If Cont0.lblAgrm.caption = "동의" Then
        Form.MsgBox( "알림", "이미 처리되었습니다.", "", 6 )
        Exit Sub
    End If

    If ContMain.ChkAgrm.checkstate == "0" Or ContMain.ChkAgrm.checkstate == 0 Then
        Form.MsgBox( "알림", "동의여부를 선택하시기 바랍니다.", "", 6 )
        Exit Sub
    End If
    
    If edtPwd.caption == "" Then
        Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )
        Exit Sub
    End If

    DATAMANAGER.RequestTranData("obaci_pnsn_004a")
	
End Sub


