Sub Form_OnFormInit()
	g_szUnCheckImg = "icon_check_off.png"
	g_szCheckImg = "icon_check_on.png"
	g_szUnCheckFg = "127"
	g_szCheckFg = "4"
	
	g_szData = Form.GetOpenLinkData()
	'Form.ShowAlert("", g_szData)
	
	'g_szList(0) :계좌번호★
	'g_szList(1) :계좌일련번호★
	'g_szList(2) :권리구분코드★
	'g_szList(3) :종목명★ 0
	
	'g_szList(4) :청약단가★ 1
	'g_szList(5) :청약가능금액★ 2
	'g_szList(6) :본배정수량★ 3
	
	'g_szList(7) :초과배정수량★ 4
	'g_szList(8) :문서명★5
	'g_szList(9) :종목코드★6
	
	'g_szList(10):권리기준일자★7
	'g_szList(11):총배정수량★8
	'g_szList(12):배정금액★ 9
	
	'g_szList(13):초과배정수량★ 10
	'g_szList(14):초과배정금액★ 11
	'g_szList(15):투자설명서★ 12
	
	'g_szList(16):총청약금액★ 16
	'g_szList(17):신청구분★
	
	'g_szList(18):청약수량★
	'g_szList(19):청약금액★
	'g_szList(20):초과청약수량★
	'g_szList(21):초과청약금액★
	
	g_szList = Split(g_szData, "★")
	
	btnOkWide.visible = true
	'btnOkWide.btnimage = "btn_blue_bg_02.9.png"
	'btnOkWide.fgcolor = "16"
		
	if UBound(g_szList) > 17 then
		g_INVT_RFP_CRTN_YN = g_szList(15)
		'Form.ShowAlert( "알림" , g_INVT_RFP_CRTN_YN )
	
		if g_INVT_RFP_CRTN_YN == "Y" then '투자설명서 있을을경우 Y
		
		else '투자설명서 없을경우 X
			chk1.checkstate 	= TRUE
			chkAllAgree.checkstate 	= FALSE
			Form.SetCtlProp("imgUIChk1", "imgpath", g_szCheckImg) '투자설명서 읽음처리
			Form.SetCtlProp("lblChkText1", "fgcolor", g_szCheckFg) '투자설명서 읽음처리
			imgUIChk1.visible 	= FALSE '투자설명서 체크박스 숨김처리
			lblChkText1.visible 	= FALSE '투자설명서 텍스트 숨김처리
			Image0.visible 		= FALSE '투자설명서 이미지 숨김처리
			imgUIChk2.top 		= 407 '유상증자 참여제한 규제안내 체크박스 투자설명서 위치로 이동
			lblChkText2.top 		= 405 '유상증자 참여제한 규제안내 텍스트 투자설명서 위치로 이동
			Image2.top 			= 402 '유상증자 참여제한 규제안내 이미지 투자설명서 위치로 이동
		end if
		
		g_FileName = g_szList(8)
		
		g_szRsevYn = g_szList(17) '예약청약여부
		call USER_Notice()
	end if
	
	SetRequestData()
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 보안매체 처리하기 위한 TR 입력
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obcsb_oimf_625r" then
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		sACNO = g_szList(0)
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
	End If
	
End Sub
