'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "CORRECT_PWD" then
		g_tData = ""
		if sRet <> "" And sRet <> Null then
			g_tData = Split(sRet, "★")
			
			if UBOUND(g_tData) > 0 then
				'CALL GoSubs()
				'Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업	> test skip
				SetSecurityOpen()
			end if
		end if
	elseif sKeyName == "mhetc90060_p9" or sKeyName == "mhetc90060_pa" or sKeyName == "mhetc90060_pb"  or sKeyName == "mhetc90060_motp" then
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업	> test skip
		end if 				
	elseif sKeyName == "mhetc90060_p5" then 							'							> test skip
		if sRet ~= "cancel" then									'							> test skip
			'청약실행																		> test skip
	
			Call GoSubs()
'			Form.ShowAlert("Test", "청약실행ㄱ")
		end if
	elseif sKeyName == "mbonl83010_p5" then
		'Form.ShowAlert( "알림" , sKeyName&""&sRet )
	    if trim(sRet) ~= "" and trim(sRet) ~= nil and sRet ~= "close" then
			f_AllAgreeCheck()
		elseif trim(sRet) ~= "" and trim(sRet) ~= nil and sRet = "close" then
			g_Chk1 = 0 '초기화
			g_Chk2 = 0 '초기화
	    end if	
	    
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
	elseif sKeyName == "mhetc90190_p1" then										
		'if sRet == "ok" then									
		'end if
	end if
End Sub
'============================================================================
Function f_AllAgreeCheck()	
	if g_Chk1 = 1	then
		chk1.checkstate = 1
		Form.SetCtlProp("imgUIChk1", "imgpath", g_szCheckImg)
		Form.SetCtlProp("lblChkText1", "fgcolor", g_szCheckFg)
	else 
		chk1.checkstate = 0
		Form.SetCtlProp("imgUIChk1", "imgpath", g_szUnCheckImg)
		Form.SetCtlProp("lblChkText1", "fgcolor", g_szUnCheckFg)
	end if 
	if g_Chk2 = 1	then
		chk2.checkstate = 1
		Form.SetCtlProp("imgUIChk2", "imgpath", g_szCheckImg)
		Form.SetCtlProp("lblChkText2", "fgcolor", g_szCheckFg)
	else
		chk2.checkstate = 0
		Form.SetCtlProp("imgUIChk2", "imgpath", g_szUnCheckImg)
		Form.SetCtlProp("lblChkText2", "fgcolor", g_szUnCheckFg)
	end if 
	
	check_staus()
End Function
'============================================================================
' GoSubs() : 청약 신청처리
'============================================================================
Function GoSubs()
	if g_szRsevYn = "N" then '청약
	'	Form.ShowAlert("1", "1")
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "RGHT_TYPE_CODE" , 0 , g_szList(2) )			
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "ACNO" , 0 , g_szList(0) )
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "ASNO" , 0 , g_szList(1) )
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "ACNT_PWD" , 0 , g_tData(0) )
		
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "ISCD" , 0 , g_szList(9) )'tbl1.GetCellString( 0 , 0) )				'종목코드
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "RGHT_STND_DATE" , 0 , g_szList(10) )'tbl1.GetCellString( 1 , 0) )		'권리기준일자
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "ASGM_QTY" , 0 , g_szList(6) )'tbl1.GetCellString( 2 , 0) )			'배정수량
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "ASGM_AMT" , 0 , g_szList(12) )'tbl1.GetCellString( 3 , 0) )			'배정금액
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "SBSC_QTY" , 0 , g_szList(18) )			'청약수량
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "SBSC_AMT" , 0 , g_szList(19) )
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "EXCS_SBSC_QTY" , 0 , g_szList(20) )		'초과청약수량
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "EXCS_SBSC_AMT" , 0 , g_szList(21))		'초과청약금액
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "EXCS_ASGM_QTY" , 0 , g_szList(13) )'tbl1.GetCellString( 1 , 1) )		'초과배정수량
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "EXCS_ASGM_AMT" , 0 , g_szList(14) )'tbl1.GetCellString( 2 , 1) )		'초과배정금액
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "SSTS_CHCK_LIST_CLS_CODE" , 0 , "Y" )
		
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "JOB_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_201a", "InBlock1", "RSEV_YN" , 0 , "N" )'
		
		if g_INVT_RFP_CRTN_YN == "Y" then '투자설명서 있을을경우 Y
			DATAMANAGER.SetDataValue( 0, "obrgt_stsb_201a" , "InBlock1" , "INVT_MANL_RECV_CNFR_YN" , 0 , "Y" )		    
		else '투자설명서 없을경우 X
			DATAMANAGER.SetDataValue( 0,"obrgt_stsb_201a" , "InBlock1" , "INVT_MANL_RECV_CNFR_YN" , 0 , "X" ) '
		end if
	
	
		DATAMANAGER.RequestTranData("obrgt_stsb_201a")
	elseif g_szRsevYn = "Y" then'예약청약
	'	Form.ShowAlert("1", "1")
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "RGHT_TYPE_CODE" , 0 , g_szList(2) )			
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "ACNO" , 0 , g_szList(0) )
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "ASNO" , 0 , g_szList(1) )
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "ACNT_PWD" , 0 , g_tData(0) )
		
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "ISCD" , 0 , g_szList(9) )'tbl1.GetCellString( 0 , 0) )				'종목코드
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "RGHT_STND_DATE" , 0 , g_szList(10) )'tbl1.GetCellString( 1 , 0) )		'권리기준일자
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "ASGM_QTY" , 0 , g_szList(6) )'tbl1.GetCellString( 2 , 0) )			'배정수량
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "ASGM_AMT" , 0 , g_szList(12) )'tbl1.GetCellString( 3 , 0) )			'배정금액
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "SBSC_QTY" , 0 , g_szList(18) )			'청약수량
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "SBSC_AMT" , 0 , g_szList(19) )
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "EXCS_SBSC_QTY" , 0 , g_szList(20) )		'초과청약수량
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "EXCS_SBSC_AMT" , 0 , g_szList(21))		'초과청약금액
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "EXCS_ASGM_QTY" , 0 , g_szList(13) )'tbl1.GetCellString( 1 , 1) )		'초과배정수량
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "EXCS_ASGM_AMT" , 0 , g_szList(14) )'tbl1.GetCellString( 2 , 1) )		'초과배정금액
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "SSTS_CHCK_LIST_CLS_CODE" , 0 , "Y" )
		
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "JOB_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0 , "obrgt_stsb_101a", "InBlock1", "RSEV_YN" , 0 , "Y" )'
		
		if g_INVT_RFP_CRTN_YN == "Y" then '투자설명서 있을을경우 Y
			DATAMANAGER.SetDataValue( 0, "obrgt_stsb_101a" , "InBlock1" , "INVT_MANL_RECV_CNFR_YN" , 0 , "Y" )		    
		else '투자설명서 없을경우 X
			DATAMANAGER.SetDataValue( 0,"obrgt_stsb_101a" , "InBlock1" , "INVT_MANL_RECV_CNFR_YN" , 0 , "X" ) '
		end if
	
	
		DATAMANAGER.RequestTranData("obrgt_stsb_101a")
	end if 

End Function
'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim subMsg
	
	
	if szTranID == "obrgt_stsb_201a" then
		subMsg = DATAMANAGER.GetDataMsgSubText( "obrgt_stsb_201a" )
		'Form.MsgBox("알림", szErrMsg&"\n("&subMsg&")", 0, 6)
		Form.MsgBox("알림", subMsg, 0, 6)
	elseif szTranID == "obrgt_stsb_101a" then
		subMsg = DATAMANAGER.GetDataMsgSubText( "obrgt_stsb_101a" )
		Form.MsgBox("알림", subMsg, 0, 6)
	end if
	
End Sub

'============================================================================
Sub check_staus()
	'Form.MsgBox("알림", chk2.checkstate & chk1.checkstate, 0 , 6)
	if chk2.checkstate = "1" and chk1.checkstate = "1" then
		chkAllAgree.checkstate = 1
		btnOkWide.enable = true
		Form.SetCtlProp("imgAllAgree", "imgpath", g_szCheckImg)
		Form.SetCtlProp("lblAllAgree", "fgcolor", g_szCheckFg)
	else 
		chkAllAgree.checkstate = 0
		btnOkWide.enable = false
		Form.SetCtlProp("imgAllAgree", "imgpath", g_szUnCheckImg)
		Form.SetCtlProp("lblAllAgree", "fgcolor", g_szUnCheckFg)
	end if 
	
	'g_Chk1 = 0 '초기화
	'g_Chk2 = 0 '초기화
End Sub

'============================================================================
Sub chk1_OnChange(sCheckState)
	dim szAllData
	if chk1.checkstate == "0" then '체크상태가 0 -> 1 변경일때
		FileName = g_szList(8)'DATAMANAGER.GetDataValue( 0 , "obrgt_stsb_205r", "OutBlock1", "DOCU_NAME" , 0)
		
		if Len(Trim(FileName)) > 0 Then
			nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
			if nType == "0" then
				'Form.OpenPdfViewer( "http://home.imeritz.com/include/ocw/"& FileName, "투자설명서")	'운영계 주소
				g_tAgreeUrl = {{"http://home.imeritz.com/include/ocw/"& FileName, "투자설명서", "urlpath", "N", ""}}
			elseif nType == "1" then
				'Form.OpenPdfViewer( "http://home.imeritz.com/include/ocw/RGT20220905A220100.pdf", "투자설명서")	'운영계 주소
				'g_tAgreeUrl = {{"http://home.imeritz.com/include/ocw/RGT20220905A220100.pdf", "투자설명서", "urlpath", "N", ""}}
				g_tAgreeUrl = {{"http://home.imeritz.com/include/ocw/"& FileName, "투자설명서", "urlpath", "N", ""}}
				
			end if
			
			i = 0
			'타이틀, url, 웹뷰type, 동의여부, 동의텍스트, 인덱스, 현재체크상태
			szData = g_tAgreeUrl[i][1].."★"..g_tAgreeUrl[i][0].."★"..g_tAgreeUrl[i][2].."★"..g_tAgreeUrl[i][3].."★"..g_tAgreeUrl[i][4].."★"..(i+1).."★".."0"
			if szAllData == "" or szAllData == nil then
				szAllData = szData
			else
				szAllData = szAllData.."☆"..szData
			end if
			
			if #szAllData > 0 then
				Form.OpenPopup( "mbonl83010_p5" ,  szAllData , "" )
			end if
			
			
		else
			'파일없음
			Form.MsgBox("알림", "해당 종목은 투자설명서가 없습니다!.", 0 , 6)
			Exit Sub'v0002
		end if
		g_Chk1 = 1
	else
		g_Chk1 = 0
		f_AllAgreeCheck()
	end if 
	
End Sub
'============================================================================
Sub imgUIChk1_OnClick()
	chk1_OnChange("0")
End Sub

'============================================================================
Sub lblChkText1_OnClick()
	chk1_OnChange("0")
End Sub
'============================================================================
Sub chk2_OnChange(sCheckState)
	Dim szAllData
	if chk2.checkstate == "0" then '체크상태가 0 -> 1 변경일때
		g_tAgreeUrl = {{"https://home.imeritz.com/include/resource/comm/ctcn/pdf/paid-in-capital-increase-regulation-info.pdf", "유상증자 참여제한 규제 안내", "urlpath", "N", ""}}
		
		i = 0
		'타이틀, url, 웹뷰type, 동의여부, 동의텍스트, 인덱스, 현재체크상태
		szData = g_tAgreeUrl[i][1].."★"..g_tAgreeUrl[i][0].."★"..g_tAgreeUrl[i][2].."★"..g_tAgreeUrl[i][3].."★"..g_tAgreeUrl[i][4].."★"..(i+1).."★".."0"
		if szAllData == "" or szAllData == nil then
			szAllData = szData
		else
			szAllData = szAllData.."☆"..szData
		end if
		
		if #szAllData > 0 then
			Form.OpenPopup( "mbonl83010_p5" ,  szAllData , "" )
		end if	
		g_Chk2 = 1
		if Len(Trim(g_FileName)) = 0 Then
		g_Chk1 = 1
		end if 
	else
		g_Chk2 = 0
		f_AllAgreeCheck()
	end if 
End Sub
