'============================================================================
Sub imgAllAgree_OnClick()
	Dim szAllData
	if chkAllAgree.checkstate == "0" then '체크상태가 0 -> 1 변경일때
		if Len(Trim(g_FileName)) > 0 Then
		    FileName = g_szList(8)'DATAMANAGER.GetDataValue( 0 , "obrgt_stsb_205r", "OutBlock1", "DOCU_NAME" , 0)
			nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
			if nType == "0" then
				g_tAgreeUrl = {
					       {"http://home.imeritz.com/include/ocw/"& FileName, "투자설명서", "urlpath", "N", ""},
						   {"https://home.imeritz.com/include/resource/comm/ctcn/pdf/paid-in-capital-increase-regulation-info.pdf", "유상증자 참여제한 규제 안내", "urlpath", "N", ""},
						 }
			elseif nType == "1" then
				g_tAgreeUrl = {
					       '{"http://home.imeritz.com/include/ocw/RGT20220905A220100.pdf", "투자설명서", "urlpath", "N", ""},
					       {"http://home.imeritz.com/include/ocw/"& FileName, "투자설명서", "urlpath", "N", ""},
						   {"https://home.imeritz.com/include/resource/comm/ctcn/pdf/paid-in-capital-increase-regulation-info.pdf", "유상증자 참여제한 규제 안내", "urlpath", "N", ""},
						 }
			end if
			i = 0
			for i=0 to 1
				'타이틀, url, 웹뷰type, 동의여부, 동의텍스트, 인덱스, 현재체크상태
				szData = g_tAgreeUrl[i][1].."★"..g_tAgreeUrl[i][0].."★"..g_tAgreeUrl[i][2].."★"..g_tAgreeUrl[i][3].."★"..g_tAgreeUrl[i][4].."★"..(i+1).."★".."0"
				if szAllData == "" or szAllData == nil then
					szAllData = szData
				else
					szAllData = szAllData.."☆"..szData
				end if
			next 
		else
			g_tAgreeUrl = {{"https://home.imeritz.com/include/resource/comm/ctcn/pdf/paid-in-capital-increase-regulation-info.pdf", "유상증자 참여제한 규제 안내", "urlpath", "N", ""}}
			i = 0
			'타이틀, url, 웹뷰type, 동의여부, 동의텍스트, 인덱스, 현재체크상태
			szData = g_tAgreeUrl[i][1].."★"..g_tAgreeUrl[i][0].."★"..g_tAgreeUrl[i][2].."★"..g_tAgreeUrl[i][3].."★"..g_tAgreeUrl[i][4].."★"..(i+1).."★".."0"
			if szAllData == "" or szAllData == nil then
				szAllData = szData
			else
				szAllData = szAllData.."☆"..szData
			end if
		end if 
		
		if #szAllData > 0 then
			Form.OpenPopup( "mbonl83010_p5" ,  szAllData , "" )
		end if
	
		g_Chk1 = 1	
		g_Chk2 = 1	
	else
		g_Chk1 = 0
		g_Chk2 = 0	
		f_AllAgreeCheck()
	end if
End Sub

'============================================================================
Sub USER_Notice()
	If g_szRsevYn = "N" Then '예약청약여부
		if g_szOsType = "2" then '1.안드로이드 2.iOS
			Label1.caption = "  · 청약 기간 중에만 조회 및 청약 신청/취소가 가능합니다.\n\n  · 청약 일정에 따라 청약 신청 및 취소 시간이 상이 하오니, \n    유의하여 주시기 바랍니다. \n    - 청약일 08:00 ~ 17:00 \n    - 청약종료일 08:00 ~ 14:00"
		else
			Label1.caption = "  · 청약 기간 중에만 조회 및 청약 신청/취소가 가능합니다.\n\n  · 청약 일정에 따라 청약 신청 및 취소 시간이 상이 하오니, \n     유의하여 주시기 바랍니다.\n     - 청약일 08:00 ~ 17:00\n     - 청약종료일 08:00 ~ 14:00"
		end if 
	ElseIf g_szRsevYn = "Y" then
'		Label1.caption = "1. 예약청약기간 중에만 조회 및 청약신청(취소)이 가능합니다\n\n2. 청약가능시간\n    · 본청약일 5영업일전 ~ 본청약전일까지 08:00~17:00"
		if g_szOsType = "2" then '1.안드로이드 2.iOS
			Label1.caption = "  · 유상청약대금은 청약 시작일 8시에 출금 되오니,\n    정상 출금 여부를 꼭 확인하시기 바랍니다. \n\n  · 예약청약기간 중에만 조회 및 청약 신청/취소가\n    가능합니다. \n\n  · '출금가능금액' 범위 내에서 청약대금이 출금되며,\n    계좌 상태 및 증거금 부족 등의 사유로 미처리 될 \n    경우 청약 증거금 입금 후 청약 신청하시기 바랍니다."
		else
			Label1.caption = "  · 유상청약대금은 청약 시작일 8시에 출금 되오니,\n     정상 출금 여부를 꼭 확인하시기 바랍니다.\n\n  · 예약청약기간 중에만 조회 및 청약 신청/취소가\n     가능합니다.\n\n  · '출금가능금액' 범위 내에서 청약대금이 출금되며,\n     계좌 상태 및 증거금 부족 등의 사유로 미처리 될\n     경우 청약 증거금 입금 후 청약 신청하시기 바랍니다."
		end if 
	End If
End sub
'============================================================================
' 보안매체별 화면오픈
'============================================================================
Function SetSecurityOpen()
	'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
	Select Case g_sGubunCode
		Case "0"
			Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
		Case "1"
			Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
		Case "2"	
			'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
			RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
		Case "3"
			Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
		Case "4"
			Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "")		'공인인증서_일반/스마트OTP
		Case "9"
			Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
	End Select
End Function
