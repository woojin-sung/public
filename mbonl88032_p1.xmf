						<LABEL name="lblLine" bgcolor="102:216216216" transmode="0" ly_vert="15,49,345,1,1" />
						<LABEL name="lblBg" bgcolor="257:245245245" transmode="0" ly_vert="0,393,375,397,1" />
						<LABEL name="lblTitle" fontsize="1" fontstyle="01" caption="유의사항" click="1" ly_vert="15,10,300,32,1" />
						<IMAGE name="imgArrow" autosize="1" imgpath="icon_arrow_down" ly_vert="337,20,15,12,1" />
						<LABEL name="lblText0" fontsize="-2" caption="· 바로출금 매도담보대출 서비스 약정은 주민등록번호
 단위로 약정되며, 서비스 대상 계좌는 Super365계좌
 에서만 이용 가능합니다." valign="0" multiline="1" ly_vert="15,66,345,50,1" />
						<LABEL name="lblText1" fontsize="-2" caption="· 바로출금서비스 약정 한도는 최대 5천만원이 일괄
 적용됩니다. (단, 기존 신용 및 증권담보대출 약정
 금액이 있는 경우 총 신용/대출 잔여한도와 비교하여
 둘 중 적은 한도로 적용)" valign="0" multiline="1" ly_vert="15,126,345,65,1" />
						<LABEL name="lblText2" fontsize="-2" caption="· 약정시 수입인지대는 부과되지 않으며, 다른 신용 및
 대출 약정 시 부과되는 수입인지대 금액에도 합산되지
 않습니다." valign="0" multiline="1" ly_vert="15,201,345,50,1" />
						<LABEL name="lblText3" fontsize="-2" caption="· 바로출금 매도담보대출은 주식에 한하여 매도자금을
 담보로 융자를 받을 수 있으며, 매도 대금의 98%까지
 대출이 가능합니다." valign="0" multiline="1" ly_vert="15,261,345,50,1" />
						<LABEL name="Label4" fontsize="-1" fontstyle="01" caption="[약관·이자율 등 변경통보]" ly_vert="15,330,192,20,1" />
						<LABEL name="lblText4" fontsize="-2" caption="· SMS(또는 알림톡)로 변경내용을 요약 통보합니다." valign="0" multiline="1" ly_vert="15,361,345,20,1" />
						<LABEL name="lblText5" fontsize="-2" caption="· 투자자는 바로출금 매도담보대출에 대하여 메리츠증권
  으로부터 충분한 설명을 받을 권리가 있으며, 투자 전
  상품설명서 및 약관을 반드시 읽어보시기 바랍니다." valign="0" multiline="1" ly_vert="15,406,345,50,1" />
						<LABEL name="lblText6" fontsize="-2" caption="· 상환능력에 비해 대출금이 과도할 경우 개인신용
 평점이 하락할 수 있으며, 이로 인해 금융거래와 
 관련된 불이익이 발생할 수 있습니다." valign="0" multiline="1" ly_vert="15,715,345,50,1" />
						<LABEL name="lblText7" fontsize="-2" caption="· 바로출금 매도담보대출 이자율은 기준금리+가산금리
 를 적용하며, 약관에서 정하는 바에 따라 변경될 수 
 있으므로 당사 설명서 및 MTS/HTS에서 확인하시기 
 바랍니다. " valign="0" multiline="1" ly_vert="15,466,345,65,1" />
						<LABEL name="lblText8" fontsize="-2" caption="· 원리금 상환방법
 - 바로출금 매도담보대출금액은 중도 상환이 불가
   하며, 매도 결제일에 전부 상환만 가능합니다.

 - 원리금은 매도 결제일에 자동 상환되며, 결제대금
   에서 바로출금 매도담보대출 원리금이 최우선순
   으로 상환됩니다.

 - 상환금액은 '매도결제일까지의 이자 + 대출금'이
   상환됩니다." valign="0" multiline="1" ly_vert="15,541,345,170,1" />
					</CONTROL_INFO>
				</CONTAINER>
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="6458" _ulen="6306" >

Dim g_bExpand
Dim g_szFold
Dim g_nAddTop

'============================================================================
Sub Form_OnFormInitBefore()
	contMain.contA.imgArrow.setMaintainingRatio("1")
	contMain.contB.imgArrow.setMaintainingRatio("1")
	contMain.contC.imgArrow.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("매도담보대출 안내")
	
	if Form.GetSharedData("&OS_TYPE", false) == "2" then
		g_addTop = 2
	else
		g_addTop = 0
		
		contMain.setScrollBarVisible("2")
	end if
	
	'이자율 조회
	DATAMANAGER.RequestTranData( "oblon_basc_503r" )
	
	contMain_contA_lblTitle_OnClick()
End Sub

'============================================================================
Function f_ExpandArea(szTarget)
	'선택된 컨테이너 펼쳐보기 처리
	If szTarget == "A" Then
		If g_bExpand Then
			g_bExpand = false
			
			contMain.contA.imgArrow.imgpath = "icon_arrow_d"
			
			contMain.contA.height = 50
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.contA.top, "1"))
		Else
			g_bExpand = true
			
			contMain.contA.imgArrow.imgpath = "icon_arrow_u"
			
			contMain.contA.height = 430
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.contA.top, "1"))
		End If
		
	ElseIf szTarget == "B" Then
		If g_bExpand Then
			g_bExpand = false
			
			contMain.contB.imgArrow.imgpath = "icon_arrow_d"
			
			contMain.contB.height = 50
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.contB.top, "1"))
		Else
			g_bExpand = true
			
			contMain.contB.imgArrow.imgpath = "icon_arrow_u"
			
			contMain.contB.height = 440		''215
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.contB.top, "1"))
		End If
	
	ElseIf szTarget == "C" Then
		If g_bExpand Then
			g_bExpand = false
			
			contMain.contC.imgArrow.imgpath = "icon_arrow_d"
			
			contMain.contC.height = 50
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.contC.top, "1"))
		Else
			g_bExpand = true
			
			contMain.contC.imgArrow.imgpath = "icon_arrow_u"
			
			contMain.contC.height = 790		''475
'			contMain.scroll_pos = CInt(Form.calcUnResize(contMain.contC.top, "1"))
		End If
	End If
	
	f_ChangeContPos(szTarget)
	g_szFold = szTarget
End Function

'============================================================================
Function f_ChangeContPos(szTarget)
'	If szTarget == "H" Then
'		Exit Function
'	End If
	
	'펼쳐지는 항목의 아래에 위치한 컨트롤들을 전부 내려줌
	Dim tTargetA, tTargetB
	tTargetA = {"contMain.contB", "contMain.contC"}
	tTargetB = {"contMain.contC"}
	
	Dim nHeight		'각 컨테이너에 적용할 높이
	If szTarget == "A" Then
		If g_bExpand Then
			For i = 0 to #tTargetA - 1 
				nHeight = Form.GetCtlProp(tTargetA[i], "top") + g_addTop
				nHeight = CInt(nHeight) + 380
				Form.SetCtlProp(tTargetA[i], "top", nHeight)
			Next
		Else
			For i = 0 to #tTargetA - 1 
				nHeight = Form.GetCtlProp(tTargetA[i], "top")
				nHeight = CInt(nHeight) - 380
				Form.SetCtlProp(tTargetA[i], "top", nHeight)
			Next
		End If
	ElseIf szTarget == "B" Then
		If g_bExpand Then
			For i = 0 to #tTargetB - 1 
				nHeight = Form.GetCtlProp(tTargetB[i], "top") + g_addTop
				nHeight = CInt(nHeight) + 390
				Form.SetCtlProp(tTargetB[i], "top", nHeight)
			Next
		Else
			For i = 0 to #tTargetB - 1 
				nHeight = Form.GetCtlProp(tTargetB[i], "top")
				nHeight = CInt(nHeight) - 390
				Form.SetCtlProp(tTargetB[i], "top", nHeight)
			Next
		End If
	ElseIf szTarget == "C" Then
		
	End If
	
	contMain.SetScrollAutoSize()
End Function

'============================================================================
Function f_ResetContPos()
	'모든 컨테이너 위치 초기화
	g_bExpand = false
	
	contMain.contA.imgArrow.imgpath = "icon_arrow_d"
	contMain.contB.imgArrow.imgpath = "icon_arrow_d"
	contMain.contC.imgArrow.imgpath = "icon_arrow_d"
	
	contMain.contA.top = 0
	contMain.contB.top = 50
	contMain.contC.top = 100
	
	contMain.contA.height = 50
	contMain.contB.height = 50
	contMain.contC.height = 50
	
	contMain.SetScrollAutoSize()
End Function 

'============================================================================
Sub contMain_contA_lblTitle_OnClick()
	If g_bExpand and g_szFold <> "A" Then
		f_ResetContPos()
		f_ExpandArea("A")
	Else
		f_ExpandArea("A")
	End If
End Sub

'============================================================================
Sub contMain_contB_lblTitle_OnClick()
	If g_bExpand and g_szFold <> "B" Then
		f_ResetContPos()
		f_ExpandArea("B")
	Else
		f_ExpandArea("B")
	End If
End Sub

'============================================================================
Sub contMain_contC_lblTitle_OnClick()
	If g_bExpand and g_szFold <> "C" Then
		f_ResetContPos()
		f_ExpandArea("C")
	Else
		f_ExpandArea("C")
	End If
End Sub

'============================================================================
Sub contMain_contA_imgArrow_OnClick()
	contMain_contA_lblTitle_OnClick()
End Sub

'============================================================================
Sub contMain_contB_imgArrow_OnClick()
	contMain_contB_lblTitle_OnClick()
End Sub

'============================================================================
Sub contMain_contC_imgArrow_OnClick()
	contMain_contC_lblTitle_OnClick()
	
	contMain.SetScrollAutoSize()
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "oblon_basc_503r" then
		Dim szDate
		szDate = Form.GetSharedData("&HOST_DATE", false)
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "STND_DATE" , 0 , szDate)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "oblon_basc_503r" then
		Dim szRate, szDate
		szRate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "UI_APLY_MNRT1" , 0)
		szRate = FormatNumber(szRate, 2)
		
'		szDate = Form.GetSharedData("&HOST_DATE", false)
		szDate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "APLY_STA_DATE" , 0)
		szDate = Left(szDate, 4) & "." & Mid(szDate, 5, 2) & "." & Right(szDate, 2)
		
		contMain.contB.tblRate.SetCellString(0, 1, "연 " & szRate & "%")
		contMain.contB.tblRate.SetCellString(0, 2, szDate & " 기준")
'		contMain.contB.tblRate.SetCellString(1, 1, "(" & szDate & " 기준)" )
	end if
End Sub

