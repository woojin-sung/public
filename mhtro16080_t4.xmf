'--===========================================================================
'--===========================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

dim	g_szFullAcnt	'계좌번호 (8+2)
dim plain_rm 

'============================================================================
Sub Form_OnFormInit()
	
	g_szFullAcnt = Form.GetCtlProp("#acnt01", "caption")
	
	if len(trim(g_szFullAcnt))	> 8 then
			DATAMANAGER.RequestTranData("obtsd_fbnk_203r")
	end if
	
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if	sEventName = "ACNTINFO_CHG"	 then
		g_szFullAcnt = Form.GetCtlProp("#acnt01", "caption") 'g_szFullAcnt= Form.GetSharedData("&ACCOUNT", 0 )
				
		if len(trim(g_szFullAcnt)) > 8 then
			DATAMANAGER.RequestTranData("obtsd_fbnk_203r")
		end if
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obtsd_fbnk_203r" then
	
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_203r", "InBlock1", "APLT_CLS_CODE" , 0 , "%"					)
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_203r", "InBlock1", "CRCD"		  , 0 , "%"					)
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_203r", "InBlock1", "MNEC_CLCD"	  , 0 , "%"					)
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_203r", "InBlock1", "ACNO"		  , 0 , Left(g_szFullAcnt,8) 	)
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_203r", "InBlock1", "ASNO"		  , 0 , MID(g_szFullAcnt, 9,2)  )		
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_203r", "InBlock1", "BRNC_CLS_CODE" , 0 , "1"					)
		DATAMANAGER.SetDataValue(0, "obtsd_fbnk_203r", "InBlock1", "PROS_CLS_CODE" , 0 , "%"					)
		
	End If
End Sub




'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim n203Cnt, szDataCnt, nMulti
	dim szRQBC
	
	If szTranID = "obtsd_fbnk_203r" then
		
		n203Cnt	=	 Grid0.rowcount
		szDataCnt	=	DATAMANAGER.GetDataCount( 0, "obtsd_fbnk_203r" , "OutBlock1" )
		nMulti	=	( n203Cnt / szDataCnt ) - 1
		
		for i=0+(nMulti * szDataCnt) to n203Cnt - 1
		
			szOrgRC =  Grid0.GetCellData("bd_cell3", i)
			szOrgMC =  Grid0.GetCellData("bd_cell1", i)
			szChanC =  Grid0.GetCellData("bd_cell10", i)
			
			'1: 신청구분코드
			'if szOrgRC = "3001" then
			'	szTrsRC = "실시간"
			'elseif szOrgRC = "3101" then
			'	szTrsRC = "실시간"
			'elseif szOrgRC = "3005" then	
			'	szTrsRC = "시간외환전"
			'elseif szOrgRC = "3006" then	
			'	szTrsRC = "시간외정산"
			'end if
			
			'2: 환전구분코드
			if szOrgMC = "1" then
				szTrsMC = "외화매수"
			elseif szOrgMC = "2" then
				szTrsMC = "외화매도"
			else
				szTrsMC = ""
			end if
			
			'환전구분 색상 변환
			szMnCdColor	= getMnecCdColor(szOrgMC)
			Grid0.SetCellFgColor("bd_cell1", i, szMnCdColor)
			
			'3: 채널유형코드
			szTrsChan = Form.GetMetaData("채널유형구분코드", szChanC)
			
			'Grid0.SetCellData("bd_cell3" , i, szTrsRC  )
			Grid0.SetCellData("bd_cell1" , i, szTrsMC  )
			Grid0.SetCellData("bd_cell10", i, szTrsChan)
			
			
		next
		
	End If
End Sub

'============================================================================
'getMnecCdColor	:	 환전구분 색상을 리턴한다.
'============================================================================
Function getMnecCdColor (szOrgMnCd)
	if szOrgMnCd	 =	"1" then
		return "1"
	elseif szOrgMnCd = "2" then
		return "158"
	else
		return "56"
	end if
End Function

'============================================================================
Sub btnIqry_OnClick()
	if len(trim(g_szFullAcnt))	> 8 then
		DATAMANAGER.RequestTranData("obtsd_fbnk_203r")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox("알림" , szErrMsg & "\n(" & szSubMsg & ")" , "", 0)
	
End Sub

