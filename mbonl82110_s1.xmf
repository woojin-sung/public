Sub Form_OnLinkData(sKey, sValue)
     '20231222 투자성향 변경 후, 변경된 투자성향으로 재조회하기 위함
	if sKey == "Change_Invest_Type"  then	
		'LHR 투자성향진단 추가
		DATAMANAGER.RequestTranData("obcsb_acif_700r")	
	end if	
End Sub
