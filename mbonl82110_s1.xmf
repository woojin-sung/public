				szAlertData = "2".."★".."투자성향 만기가 경과되었습니다.\n재등록 후 진행해주세요.".."★".."투자성향".."★".."취소".."★".."등록하기"
				g_szMoveScreen = "81010"
				Form.OpenPopup("mbonl82010_p6", szAlertData, "")
			elseif szProsYN = "M" then '취약금융정보 없음
				lblErrorText.caption = "투자성향 취약금융소비자\n정보가 없습니다.\n재등록 후 진행해주세요."
				lnkSub.visible = "0"
				lblErrorText.visible = "1"
				btnError.visible = "1"
				btnError.caption = "투자성향 등록"
				szAlertData = "2".."★".."투자성향 취약금융소비자\n정보가 없습니다.\n재등록 후 진행해주세요.".."★".."투자성향".."★".."취소".."★".."등록하기"
				g_szMoveScreen = "81010"
				Form.OpenPopup("mbonl82010_p6", szAlertData, "")
			elseif szProsYN = "Y" then
'				lblErrorText.caption = "고객님의 투자성향보다\n위험도가 높은 상품입니다."
'				lnkSub.visible = "0"
'				lblErrorText.visible = "1"
'				btnError.visible = "1"
'				btnError.caption = "계속 진행"
'				szAlertData = "2".."★".."고객님의 투자성향보다\n위험도가 높은 상품입니다.".."★".."투자성향확인서".."★".."취소".."★".."계속 진행"
'				g_szContinueFlag = "2"
'				g_szMoveScreen = "81010_p1"
'				Form.OpenPopup("mbonl82010_p6", szAlertData, "")
				'Dim sSendData
				'szAct = Account0.caption
				'sSendData = "82010★" & Left(szAct, 8) & "★" & Right(szAct, 2) & "★"
				
				'Form.OpenPopup("mbonl81010_p1" , sSendData , "")
				
				g_Account0 = Left(Account0.caption, 8)			
				Form.SetSharedData("FNP51000_P8_ACC_NO", g_Account0)	'계좌번호
				Form.SetSharedData("FNP51000_P8_ISCD", "")			'종목코드
				Form.SetSharedData("FNP51000_P8_PROD", "01")			'상품등급
				
				Form.OpenPopup("mbfnp51000_p8", "", "")	'투자성향 및 위험등급 확인 팝업 호출					
			end if
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg 
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if trim(sSubMsg) ~= "" then
		sSubMsg = "("..sSubMsg..")"
		szErrMsg = szErrMsg.."\n"..sSubMsg
	end if
	
	if szTranID == "oblon_basc_810r" then
		Dim szAlertData
		'Form.ShowAlert(szTranID, szErrCode.."\n"..szErrMsg)
		if szErrCode == "4951" then			
			szAlertData = "1".."★".."임직원은 신용거래약정이\n불가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "3317" then	
			szAlertData = "1".."★".."법인계좌는 신용거래약정이\n불가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "7419" then	
			szAlertData = "1".."★".."금융상품전용계좌는\n신용거래약정이 불가능합니다.\n다른계좌를 선택해주세요.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "3311" then	
			szAlertData = "1".."★".."신용거래약정이 불가능한 계좌입니다.\n계좌상태를 확인해주세요.\n"..sSubMsg.."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "3273" then	
			szAlertData = "1".."★".."이미 약정된 계좌입니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "3323" then	
			szAlertData = "1".."★".."신용불량자는 신용거래약정이\n불가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "3279" then	
			szAlertData = "1".."★".."대출등급이 충족되지 않아\n신용거래약정이 불가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "2047" then	
			szAlertData = "2".."★".."반송계좌 보유 고객은\n신용거래약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"
		elseif szErrCode == "3281" then	
			szAlertData = "1".."★".."미수금이 있는 경우\n신용거래약정이 불가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "3283" then	
			szAlertData = "1".."★".."미성년자는 신용거래약정이\n불가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "3247" then	
			szAlertData = "2".."★".."안전카드 분실/훼손 계좌는\n신용거래약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "3249" then	
			szAlertData = "2".."★".."OTP 분실/훼손 계좌는\n신용거래약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "3251" then	
			szAlertData = "2".."★".."카드 분실 계좌는\n신용거래약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "3253" then	
			szAlertData = "2".."★".."체크카드 분실/훼손 계좌는\n신용거래약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "3255" then	
			szAlertData = "2".."★".."인감 분실/훼손 계좌는\n신용거래약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "3257" then	
			szAlertData = "2".."★".."사망 계좌는\n신용거래약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "3259" then	
			szAlertData = "2".."★".."질권계좌 보유 고객은 계좌는\n신용거래약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"	
		elseif szErrCode == "3261" then	
			szAlertData = "1".."★".."비거주외국인은\n신용거래약정이 불가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"	
		elseif szErrCode == "3263" then	
			szAlertData = "2".."★".."실명 미확인 계좌는\n신용거래약정이 불가능합니다.\n고객지원센터로 문의해주세요.".."★"..szErrCode.."★".."확인".."★".."고객지원센터"
		elseif szErrCode == "3265" then	
			szAlertData = "1".."★".."금융사기이용계좌는\n신용거래약정이 불가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "3267" then	
			szAlertData = "2".."★".."휴대폰 미등록 계좌는\n신용거래약정이 불가능합니다.\n휴대폰 정보 등록 후 이용해주세요.".."★"..szErrCode.."★".."확인".."★".."등록하기"
		elseif szErrCode == "3269" then	
			szAlertData = "1".."★".."등기임원 등록 계좌는\n신용거래약정이 불가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "3285" then	
			szAlertData = "1".."★".."통합증거금 약정 계좌는\n신용거래약정이 불가능합니다.\n다른 계좌를 선택해주세요.".."★"..szErrCode.."★".."확인".."★".."확인"		
		elseif szErrCode == "3287" then			
			szAlertData = "2".."★".."신용거래약정 후 대주거래약정이 가능합니다.".."★"..szErrCode.."★".."확인".."★".."신용약정하기"
		elseif szErrCode == "3289" then	
			szAlertData = "1".."★".."대주거래약정은 1인 1계좌만 가능합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "3291" then	
			szAlertData = "2".."★".."사전교육/모의거래 이수정보가 없습니다.\n정보 등록 후 신청해주세요.".."★"..szErrCode.."★".."확인".."★".."등록하기"
		elseif szErrCode == "3293" then	
			szAlertData = "1".."★".."대주거래약정이 불가능한 계좌입니다. 다른 계좌를 선택해주세요."..sSubMsg.."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "3295" then	
			szAlertData = "1".."★".."Wrap계좌는 대주거래약정이 불가능합니다. 다른계좌를 선택해주세요.".."★"..szErrCode.."★".."확인".."★".."확인"
		elseif szErrCode == "8995" then
			szAlertData = "2".."★".."사전교육/모의거래 이수정보\n승인상태를 확인해주세요.".."★"..szErrCode.."★".."취소".."★".."확인"
		elseif szErrCode == "3245" then
			szAlertData = "1".."★".."장외파생전용계좌는\n신청이 불가합니다.".."★"..szErrCode.."★".."확인".."★".."확인"
		end if
		
		'LHR 수정
		if trim(szErrMsg) <> "" then
			if szErrCode == "3287" then
				'Form.ShowAlert("Here", szErrCode)
				'szErrMsg    = Replace(szErrMsg, "신용거래", "대주거래", 10, 1, 1)
			else
				szErrMsg    = Replace(szErrMsg, "신용거래", "대주거래", 1, -1, 1)
			end if
		end if
		
		if trim(szAlertData) <> "" then
			if szErrCode == "3287" then
				'szAlertData = Replace(szAlertData, "신용거래", "대주거래", 10, 1, 1)
			else
				szAlertData = Replace(szAlertData, "신용거래", "대주거래", 1, -1, 1)
			end if
		end if
		
		if trim(szAlertData) == "" then
			DIm szAlertData 
			szAlertData = "1".."★"..szErrMsg.."★"..szErrCode.."★".."확인".."★".."확인"
		
			Form.OpenPopup("mbonl82010_p6", szAlertData, "")
			
			lblErrorText.caption = szErrMsg
			lblErrorText.visible = "1"
			lnkSub.visible = "0"
		else
			'DIm szAlertData 
			'szAlertData = "1".."★"..szErrMsg.."★"..szErrCode.."★".."확인".."★".."확인"			
			Form.OpenPopup("mbonl82010_p6", szAlertData, "")
			
			Dim tMsg
			tMsg = Split(szAlertData, "★")		
			lblErrorText.caption = tMsg[1]
			lblErrorText.visible = "1"
			lnkSub.visible = "0"
			
			'8995는 팝업버튼과 화면버튼이 다르므로.. 분기처리
			if szErrCode == "8995" then
				btnError.caption =  "등록정보 확인하기"
				g_szMoveScreen = szErrCode
				btnError.visible = "1"
			else
				if trim(tMsg[4]) ~= "확인" then
					btnError.caption = tMsg[4]
					g_szMoveScreen = szErrCode
					btnError.visible = "1"
				end if
			end if
		end if
	

	'2021.03.17 대출KYC추가
	elseif szTranID == "oblon_basc_103r" then
		DIm szAlertData 
		szAlertData = "1".."★"..szErrMsg.."★"..szErrCode.."★".."확인".."★".."확인"
	
		Form.OpenPopup("mbonl82010_p6", szAlertData, "")	
		
		lblErrorText.caption = szErrMsg
		lblErrorText.visible = "1"
		lnkSub.visible = "0"
	else
		DIm szAlertData 
		szAlertData = "1".."★"..szErrMsg.."★"..szErrCode.."★".."확인".."★".."확인"
	
		Form.OpenPopup("mbonl82010_p6", szAlertData, "")
	end if
End Sub


'============================================================================
Sub btnError_OnClick()
	if g_szMoveScreen == "2047" or g_szMoveScreen == "3247" or g_szMoveScreen == "3249" or g_szMoveScreen == "3251" or g_szMoveScreen == "3253" 
		   or g_szMoveScreen == "3255" or g_szMoveScreen == "3257" or g_szMoveScreen == "3259" or g_szMoveScreen == "3265" or g_szMoveScreen == "3263" then
		   
		'고객지원센터 이동
		Form.OpenScreen("89020" , "")

	elseif g_szMoveScreen == "3267" then
		
		'휴대폰정보 등록하기 이동
		'Form.OpenScreen("81000" , "")
		Form.OpenFramePopup("mbonl81000" , "" , "")
	elseif g_szMoveScreen == "3287" then
	
		'신용약정하기
		Form.OpenScreen("82010" , "")

	elseif g_szMoveScreen == "3291" or g_szMoveScreen == "8995" then
		
		'사전교육/모의거래 이수 등록
		Form.OpenScreen("82080" , "")
		
	elseif g_szMoveScreen == "93500" then
		Dim szData
		szData = setKycSharedData("mbonl93500")
		'신용공여
		Form.OpenFramePopup("mbonl93500" , szData , "") '대출 KYC 설문 메인
		
	elseif g_szMoveScreen == "mbonl93503" then
		setKycSharedData("mbonl93503")
		Form.OpenPopup("mbonl93503" , "" , "") '대출 KYC 부적합 보고서
	
	elseif g_szMoveScreen == "81010" then
		'Form.OpenScreen("81010" , "")
		Form.OpenFramePopup("mbonl81010" , "mbonl88060" , "")
	elseif g_szMoveScreen == "81010_p1" then
		Dim sSendData
		szAct = Account0.caption
		sSendData = "82010★" & Left(szAct, 8) & "★" & Right(szAct, 2) & "★"
		
		Form.OpenPopup("mbonl81010_p1" , sSendData , "")
	end if		
End Sub

