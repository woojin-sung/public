'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "Init" then	
		g_bAddAct = true
		DATAMANAGER.RequestTranData("oblon_basc_803r")
'		
	elseif sEventName  == "InitChange" then
		if trim(sParam) ~= "" then
			Dim tParam
			tParam = Split(sParam, "★")
			
			if tParam[0] == "Add" then
				g_bAddAct = true
			else	
				g_bAddAct = false
			end if
			
			Account0.caption = tParam[1]
		end if
		
	elseif sEventName == "CORRECT_PWD" then
		if nil ~= sParam and "" ~= sParam then
			EditPW.encdata = sParam
		end if
		
	elseif sEventName == "NextView" then
		if trim(sParam) ~= "" then
			Form.OpenPopup("mbonl82110_p3" , sParam , "")
			
		end if
	end if 
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "CORRECT_PWD" then
		if nil ~= sRet and "" ~= sRet then
			Dim tPwd
			tPwd = Split(sRet, "★") '"nPwdLen★sEncPwd(암호화된 비밀번호)"
			
			if UBOUND(tPwd) > 0 then
				EditPW.pwdlen = tPwd(1)
				EditPW.caption = tPwd(0)
			end if
			
			Dim szSendData
			szSendData = Account0.caption.."☆"..EditPW.caption
			Form.triggerEvent("lnkSub", "PwdComplete", szSendData)
		end if
		
	elseif sKeyName == "mbonl82110_p3" then
		Form.triggerEvent("#", "End", "")
	
	elseif sKeyName == "kyc" then
		if sRet == "Right" then
			szData = setKycSharedData("mbonl93500")
			Form.OpenFramePopup("mbonl93500" , szData , "") '대출 KYC 설문 메인
		end if 
	'LHR수정 투자성향진단 추가
	elseif sKeyName == "투자성향" then
		if sRet == "Right" then
			'Form.OpenScreen("81010" , "")
			Form.OpenFramePopup("mbonl81010" , "mbonl88060" , "")
		end if
	elseif sKeyName == "투자성향확인서" then
		if sRet == "Right" then
			Dim sSendData
			szAct = Account0.caption
			sSendData = "82010★" & Left(szAct, 8) & "★" & Right(szAct, 2) & "★"
			
			Form.OpenPopup("mbonl81010_p1" , sSendData , "")
		end if
	elseif sKeyName == "kyc_report" then
		if sRet == "Right" then
			setKycSharedData("mbonl93503")
			Form.OpenPopup("mbonl93503" , "" , "") '대출 KYC 부적합 보고서
		end if
		
	'적정성 여부 확인 MsgBox
	elseif sKeyName == "kyc_check" then	'적정성 여부 확인
		'확인
		if g_szAnxtAprt_Yn = "Y" Then	'부적정
			DATAMANAGER.RequestTranData("oblon_basc_103r")
		end if
		
	elseif sKeyName = "mbonl93500" Then
		g_szAnxtAprt_Yn = sRet	'부적정여부
		if g_szAnxtAprt_Yn = "N" then	'부적정여부 리턴: 적정			
		    Dim szAlertData
			szAlertData = "1".."★".."부적정여부 : [적정]. 계속 진행하세요".."★".."kyc_check".."★".."확인".."★".."확인"
			Form.OpenPopup("mbonl82010_p6", szAlertData, "")
		elseif g_szAnxtAprt_Yn = "Y" then	'부적정여부 리턴: 부적정
			Dim szAlertData
			szAlertData = "1".."★".."부적정여부 : [부적정]".."★".."kyc_check".."★".."확인".."★".."확인"
			Form.OpenPopup("mbonl82010_p6", szAlertData, "")
		end If
		
		DATAMANAGER.RequestTranData("oblon_basc_103r")
		
	'부적정보고서 리턴
	elseif sKeyName = "mbonl93503" Then
		'대출_고객정보 확인서 징구 여부 관련 조회로 처음부터 체크한다. 
		DATAMANAGER.RequestTranData("oblon_basc_103r")
		
	elseif sKeyName == "2047" or sKeyName == "3247" or sKeyName == "3249" or sKeyName == "3251" or sKeyName == "3253" 
		   or sKeyName == "3255" or sKeyName == "3257" or sKeyName == "3259" or sKeyName == "3265" or sKeyName == "3263" then
		   
		'고객지원센터 이동
		if sRet == "Right" then
			Form.OpenScreen("89020" , "")
		end if 
		
	elseif sKeyName == "3267" then
		
		'휴대폰정보 등록하기 이동
		if sRet == "Right" then
			'Form.OpenScreen("81000" , "")
			Form.OpenFramePopup("mbonl81000" , "" , "")
		end if 
		
	elseif sKeyName == "3287" then
	
		'신용약정하기
		if sRet == "Right" then
			Form.OpenScreen("82010" , "")
		end if 

	elseif sKeyName == "3291" or sKeyName == "8995" then
		
		'사전교육/모의거래 이수 등록
		if sRet == "Right" then
			Form.OpenScreen("82080" , "")
		end if
	'LHR 투자성KYC 추가
	elseif sKeyName == "KYCCHK_RETURN" then
		if sRet == "Y" then
			lnkSub.visible = "1"
			lblErrorText.visible = "0"
			btnError.visible = "0"
			'Form.MsgBox( "알림", "약관 및 설명서 내 최소담보유지비율(고객별/종목군별/신용거래융자유형별 적용)에 대한 내용을 충분히 숙지하여 주시기 바랍니다.", "exec", 0 )
			DATAMANAGER.RequestTranData( "obcsb_acad_002r" ) '연락처조회
		else
			lnkSub.visible = "0"
			lblErrorText.visible = "1"
			if trim(btnError.caption) <> "" then
				btnError.visible = "1"
			else
				btnError.visible = "0"
			end if
			
'			Dim szAlertData
'			
'			if g_szContinueFlag == "1" then
'				szAlertData = "2".."★".."투자자정보[미제공] 상태입니다.".."★".."투자성향확인서".."★".."취소".."★".."계속 진행"
'			elseif g_szContinueFlag == "2" then
'				szAlertData = "2".."★".."고객님의 투자성향보다\n위험도가 높은 상품입니다.".."★".."투자성향확인서".."★".."취소".."★".."계속 진행"
'			end if
'			
'			g_szMoveScreen = "81010_p1"
'			Form.OpenPopup("mbonl82010_p6", szAlertData, "")
		end if
	elseif sKeyName = "mbonl81000" then
		if sRet == "ok" then
			'DATAMANAGER.RequestTranData( "obcsb_acad_002r" ) '연락처조회
			DATAMANAGER.RequestTranData( "oblon_basc_810r" )
		end if
		
	elseif sKeyName == "mbfnp51000_p8" then	'고객투자성향안내팝업		
		if sRet == "NEXT_mbfnp51000_p8" then
			
			if ( g_szProsYN	=	"N"	or	g_szProsYN	=	"Y" ) and (g_szKYC_INVT_RCMD_CLS_CODE = "3" or g_szKYC_INVT_RCMD_CLS_CODE = "4") then			
				Dim sSendData
				szAct = Account0.caption
				sSendData = "82010★" & Left(szAct, 8) & "★" & Right(szAct, 2) & "★"				
				Form.OpenPopup("mbonl81010_p1" , sSendData , "")						
			
			elseif g_szProsYN = "N" or g_szProsYN = "X" then
				Dim sSendData
				szAct = Account0.caption
				sSendData = "82010★" & Left(szAct, 8) & "★" & Right(szAct, 2) & "★"
				lblErrorText.caption = ""
				btnError.caption = ""
				Form.OpenPopup("mbonl81010_p1" , sSendData , "")
				
			elseif g_szProsYN = "Y" then
				Dim szAlertData			
				'Account0.caption = g_Account0
				
				lblErrorText.caption = "고객님의 투자성향보다\n위험도가 높은 상품입니다."
				lnkSub.visible = "0"
				lblErrorText.visible = "1"
				btnError.visible = "1"
				btnError.caption = "계속 진행"
				szAlertData = "2".."★".."고객님의 투자성향보다\n위험도가 높은 상품입니다.".."★".."투자성향확인서".."★".."취소".."★".."계속 진행"
				g_szContinueFlag = "2"
				g_szMoveScreen = "81010_p1"
				Form.OpenPopup("mbonl82010_p6", szAlertData, "")	
			end if			
		else
			Form.triggerEvent("#", "End", "")
		end if		
	end if
End Sub


'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'2021.03.17 : 대출KYC
	if sKeyName == "kyc" then
		if sRet == "ok" then			
			szData = setKycSharedData("mbonl93500")
			Form.OpenFramePopup("mbonl93500" , szData , "") '대출 KYC 설문 메인
		End if
	'적정성 여부 확인 MsgBox
	elseif sKeyName == "kyc_check" then	'적정성 여부 확인
		'확인
		if g_szAnxtAprt_Yn = "Y" Then	'부적정
			DATAMANAGER.RequestTranData("oblon_basc_103r")
		end if
	elseif sKeyName == "kyc_report" then
		if sRet == "ok" then
			setKycSharedData("mbonl93503")
			Form.OpenPopup("mbonl93503" , "" , "") '대출 KYC 부적합 보고서
		end if
	end if
End Sub

'============================================================================
' setKycSharedData : 파일 오픈 공유데이터 설정 : 대출KYC : 2021.03.17
'============================================================================
Function setKycSharedData(fileName)
	
	'MTS 메모리평문 적용유무 (0:미적용 / 1:적용)
	szPlainRm = Form.GetSharedData("&PLAIN_RM", false)
	Dim szAct
	szAct = Account0.caption
	
	'MTS 메모리평문 적용
	if szPlainRm = "1" Then
		szPwd = Form.GetCtlProp( "EditPW", "caption" )	'비밀번호
	'MTS메모리평문 미적용
	else
		szPwd = Form.GetCtlProp( "EditPW", "encdata" )
	end if
	
	'대출 KYC MTS_메인
	if fileName = "mbonl93500" Then
		szAcno = Left(szAct, 8)        '계좌번호
		szCsnm = g_szCsnm			    	'고객명
		g_szData = szAcno & "||" & szPwd & "||" & szCsnm & "||" & g_szCustClsCd & "||" & "11" ' 01은 신용
		  
	'대출성 상품 적정성 판단 보고서(MTS)
	elseif fileName = "mbonl93503" Then	
		'보고서는 Shared Memory로 통신한다.
		szAcno = Left(szAct, 8)        '계좌번호
		szCsnm = g_szCsnm			    	'고객명
		szBswrdivcode = "16001"		'해외주식 대출약정'
		Form.SetSharedData( "mbonl93503_acno" 	  		, szAcno )
		Form.SetSharedData( "mbonl93503_acnopwd" 		, szPwd )
		Form.SetSharedData( "mbonl93503_csnm"             , szCsnm )
		Form.SetSharedData( "mbonl93503_loan_type_code"   , "11" ) '신용01
		Form.SetSharedData( "mbonl93503_bswr_div_code"    , szBswrdivcode )
		Form.SetSharedData( "mbonl93503_cont_cls_code"    , "4" )
	end if

	return g_szData
End Function

