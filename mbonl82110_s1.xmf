'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szAct	
	Dim sACNT_PWD
	Dim plain_rm
	
	szAct = Account0.caption
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then
		sACNT_PWD = EditPW.caption
	'MTS메모리평문 미적용상태일때
	else
		sACNT_PWD = Form.GetEncData(EditPW.caption)
	end if

	if szTranID == "oblon_basc_803r" then
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803r", "InBlock1", "ACNO" , 0 , Left(szAct, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803r", "InBlock1", "ASNO" , 0 , Right(szAct, 2) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803r", "InBlock1", "ACNT_PWD" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803r", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803r", "InBlock1", "CONT_CLS_CODE" , 0 , "4" ) 'v001	

	elseif szTranID == "oblon_basc_810r" then
		g_szMoveScreen = ""
	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 0 , Left( szAct, 8))
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 0 , Right(szAct, 2))
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOAN_TYPE_CODE" , 0 , "11" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" , 0 , "8" ) 'v001

	'2021.03.17 대출_고객정보 확인서 징구 여부 관련 조회
	elseif szTranID == "obcsb_acif_000r" Then '계좌 정보 조회 for 대출KYC
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_000r", "InBlock1", "PROS_CLS_CODE" , 0 , "I" 			 )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_000r", "InBlock1", "ACNO" 		   , 0 , Left( szAct, 8))
		
	elseif szTranID == "oblon_basc_103r" then		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_103r", "InBlock1", "ACNO" 		   , 0 , Left( szAct, 8)  )	'계좌번호
		DATAMANAGER.SetDataValue( 0, "oblon_basc_103r", "InBlock1", "BSWR_DIV_CODE" , 0 , "16001" )	'대출약정
		DATAMANAGER.SetDataValue( 0, "oblon_basc_103r", "InBlock1", "LOAN_TYPE_CODE", 0 , "11" )	'신용
		
	elseif szTranID == "obcsb_acad_002r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "ACNO" , 0 , Left(szAct, 8) )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "PWD" , 0 , sACNT_PWD )
		
	elseif szTranID == "obaci_acct_095r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"     , 0 , Left(szAct, 8) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )		
	elseif szTranID == "obcsb_acad_120r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acad_120r", "InBlock1", "ACNO" , Left(szAct, 8))
	elseif szTranID == "obacp_comm_007r" then
		DATAMANAGER.SetDataValue(0, "obacp_comm_007r", "InBlock1", "ACNO" , Left(szAct, 8))
		DATAMANAGER.SetDataValue(0, "obacp_comm_007r", "InBlock1", "ACNT_PWD" , sACNT_PWD)
		DATAMANAGER.SetDataValue(0, "obacp_comm_007r", "InBlock1", "IQRY_CLS_CODE" , "9")
	'LHR 수정
	elseif szTranID == "obcsb_acif_700r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "ACNO"				, 0, Left(szAct, 8))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "ASNO"				, 0, Right(szAct, 2))
		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "KYC_BSWR_DIV_CODE"	, 0, "02")
		DATAMANAGER.SetDataValue(0, "obcsb_acif_700r", "InBlock1", "BSWR_DIV_CODE"		, 0, "16001")
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	
	
	if szTranID == "oblon_basc_803r" then
		Dim szRegDate		
		Dim sUI_PROD_OPNG_YN1 
		Dim sUI_PROD_OPNG_YN2
		Dim sLoanType
		Dim szDejuDate
		Dim szUI_COND
		
		szRegDate = DATAMANAGER.GetDataValue( 0, "oblon_basc_803r", "OutBlock1", "REG_DATE", 0 ) 
		sUI_PROD_OPNG_YN1 = DATAMANAGER.GetDataValue( 0, "oblon_basc_803r", "OutBlock2", "UI_PROD_OPNG_YN1" , 0 ) 'SMS		
		sUI_PROD_OPNG_YN2 = DATAMANAGER.GetDataValue( 0, "oblon_basc_803r", "OutBlock2", "UI_PROD_OPNG_YN2" , 0 ) 'E-mail		
		sLoanType = DATAMANAGER.GetDataValue( 0, "oblon_basc_803r", "OutBlock1", "MORG_APLY_FORM_CODE" , 0 ) '신용융자/대주코드		
		szDejuDate = DATAMANAGER.GetDataValue( 0,"oblon_basc_803r", "OutBlock1", "STLN_STUP_DATE", 0 ) '대주일자
		szUI_COND = DATAMANAGER.GetDataValue( 0, "oblon_basc_803r", "OutBlock1", "UI_COND_RSLT_CLS_VAL", 0 ) '유통융자 담보활용 동의 신청 여부
		
		Dim szTrData
