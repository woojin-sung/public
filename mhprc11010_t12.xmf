'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

' 관심그룹 Key
Dim g_szGSID 
g_szGSID = ""

Dim g_szCloud		' 관심동기화(0:미사용(로컬), 1:사용(서버))

' 종목선택시 연결화면(0:연결화면, 1:현재가, 2:주문, 3:차트)
DIm g_szMove
g_szMove = "0"

' 20160126 선택팝업관련 추가사항
Dim g_szSltCd, g_szSltMk, g_szSltName, g_szSltDecimal, g_szSltGubun, g_rtSltChk'리얼타임 

Dim g_nSum, g_nCnt1, g_nCnt2, g_nCnt3, g_nCnt4, g_nHyun
g_nSum, g_nCnt1, g_nCnt2, g_nCnt3, g_nCnt4 = 0, 0, 0, 0, 0, 0
g_nHyun = 0 '스크립트 오류


Dim g_szPeriodType, g_szPeriod, g_szChrtType, g_szType
g_szPeriodType, g_szPeriod, g_szChrtType, g_szType = "2", "1", "D", "" ' 일


'20210823 HSZ CFD 화면 추가
Dim g_szScreenNo 

Dim g_nNextCount
g_nNextCount = 0

Dim g_szGubun
g_szGubun = "0"  '전체(0)/국내(1)/해외(2)

'국내(KR)/해외(OV)

Dim g_nPage
g_nPage = 1

Dim g_nTotal

g_tKey     = {"BB", "CC"}
g_tNm      = {"최근조회", "보유종목"}

			
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' init_GWList :  관심그룹의 종목 재설정 (로컬/서버)
'============================================================================
Function init_GWList()
	' 설정에서 구분자를 받아온다.
	if g_szCloud == "1" then		
		DATAMANAGER.RequestTranData("ohhts_intr_007r")
	else
		' 로컬 저장된 관심종목 가져오기
		Load_GWList()
	end if
End Function

'============================================================================
' Load_RecentList :  최근조회종목 리스트
'============================================================================
Function Load_RecentList(szData)
	
	Dim tList
	Dim szMk, szName, szCode
	Dim szGubun '01:국내, 02:해외
	
	'국내: 종목코드, 해외: 마켓@종목코드 구분자 : `
	grdCode.rowcount = 0
	if Trim(szData) <> "" then
		tList = Split(szData, "`")		
		
		'최근조회종목 100개로 제한(영업지원팀 전요셉차장 요청)
		'ORGNSRC
		'For i = 0 to #tList-1
		if #tList >= 100 then
			szLen = 99
		else
			szLen = #tList - 1 		
		end if
		
		nRowcount = 0
		For i = 0 to szLen		
			'szGubun 세팅(OV: 해외주식, KR: 그 외)
			if CInt(Instr(tList(i), "@")) > 0 then	'@ 포함된 종목코드(해외주식, 해외지수 등)
				tCode = Split(tList(i), "@")
				if UBOUND(tCode) < 1 then
					'Exit Function
				else
					szMk  = tCode[0]
					if Trim(szMk) == "" then
						Exit Function
					else
						nMkLen = Form.getLen(szMk)
						if nMkLen = 2 then
							szGubun = "OV" '해외주식(마켓구분 2자리)
						else
							szGubun = "KR"
						end if
					end if
				End if
			else
				szGubun = "KR"
			end if		

'Form.ShowAlert(i & ":: " & szGubun & " :: " & tList[i])	
			If szGubun == "OV" Then '해외
				'tCode = Split(tList(i), "@")
				szMk = tCode[0]
				szMk = f_getExchCode2(szMk)
				szCode  = tCode[1]
			else ' 국내
				szMk = Form.GetItemCodeInfo(tList(i), "market")
				szMk = Change_EtcMarket(szMk)
				szCode = tList(i)
			end if 
			
			'최근조회종목 - 상품선물 안보이게
			'상품선물 "FF"분기처리 추가
			if szMk == "CF" or szMk == "FF" then

			else
				grdCode.insertrow = nRowcount
				grdCode.SetCellData("bd_code", nRowcount, szCode)
				grdCode.SetCellData("bd_mk",   nRowcount, szMk)
				grdCode.SetCellData("bd_memo", nRowcount, "")
				grdCode.SetCellData("bd_name", nRowcount, Form.GetItemCodeInfo(tList(i), "name"))
				grdCode.SetCellData("bd_gubun", nRowcount, szGubun) 
				nRowcount = nRowcount + 1
			end if
		Next

		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
		Form.triggerEvent("##", "SET_VISIBLE", "")
		'SetNoticeMsg() '종목없음 안내메시지처리		
		Save_grdChart()		
	end if	
	SetNoticeMsg() '종목없음 안내메시지처리		
End Function

'============================================================================
' Change_EtcMarket :  해외지수(대표, 업종지수)/ 채권의 마켓구분 변경
'============================================================================
Function Change_EtcMarket(szData)
	if Trim(szData) == "UJ" then
		return "N"
	elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		return "B"
	end if	
	
	return szData
End Function

'============================================================================
' Load_GWGroup :  ' 로컬 저장된 관심종목 가져오기
'============================================================================
Function Load_GWList()
	Dim tGroup, tList
	
	grdCode.rowcount = 0
	szGroup = Form.LoadConfigData("GWANSIM", g_szGSID)

	if Trim(szGroup) <> "" then
		tGroup = Split(szGroup, "♣")

		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			'20230724 HSZ START: 관심종목 동기화 OFF로 사용 시, 인덱스 안맞는 오류 조치
			If UBOUND(tList) < 4 then
				tGroup(i) = tGroup(i).."★"
				tList = Split(tGroup(i), "★")
			end if
			'20230724 HSZ END
			
			grdCode.insertrow = i
	
			grdCode.SetCellData("bd_code", i, tList(0))
			grdCode.SetCellData("bd_mk",   i, tList(1))
			grdCode.SetCellData("bd_memo", i, tList(2))
			grdCode.SetCellData("bd_name", i, tList(3))	' 20160325 위젯위해 종목명 추가
			if tList(4) == "" or tList(4) == null  then
				'20230810 KKM START 관심종목동기화OFF
				if tList(0) == "빈칸" or tList(0) == "EMPTY" then
					grdCode.SetCellData("bd_gubun",i, "")
				else
					grdCode.SetCellData("bd_gubun",i, "KR")	'국가구분(KR/OV)
				end if 
				'20230810 KKM END 				
			else
				grdCode.SetCellData("bd_gubun",i, tList(4))	'국가구분(KR/OV)
			end if 
		Next
	
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
		'SetNoticeMsg() '종목없음 안내메시지처리
		Save_grdChart()
	end if
	SetNoticeMsg() '종목없음 안내메시지처리	'20230810 KKM 관심종목동기화OFF
End Function

'============================================================================
' Save_GWList
'============================================================================
Function Save_GWList()
	Dim szList, szCd, szMk
	
	For i = 0 to grdCode.rowcount-1
		szCd = grdCode.GetCellData("bd_code", i)
		szMk = grdCode.GetCellData("bd_mk",   i)
		
	
		
		if Trim(szMk) == "" then
			szMk = ""
		end if
		
		' 20160325 위젯위해 종목명 추가
		if i == 0 then
			szList = szCd  & "★" & szMk & "★" & grdCode.GetCellData("bd_memo", i) & "★" & grdCode.GetCellData("bd_name", i) & "★" & grdCode.GetCellData("bd_gubun", i)
		else
			szList = szList & "♣" & szCd & "★" & szMk & "★" & grdCode.GetCellData("bd_memo", i) & "★" & grdCode.GetCellData("bd_name", i) & "★" & grdCode.GetCellData("bd_gubun", i)
		end if
		
	Next

	' 동기화 시는 파일 저장만.. /////////////////////////////////////////////
	Form.SaveConfigData("GWANSIM", g_szGSID, szList)

	if g_szCloud == "0" then
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)	
		Save_grdChart()
	end if
	' ///////////////////////////////////////////////////////////////////////
End Function
'============================================================================
' Save_grdChart : 차트링크폼을 위해 다시 담아둔다.
'============================================================================
Function Save_grdChart()
	Dim nRow, nCnt
	Dim szCd, szMk
	
	nRow = grdCode.rowcount()
	g_nSum = 0
	grdChart.rowcount = 0
	
	'전체(0)/국내(1)/해외(2)
	if g_szGubun == "2" then
		For i = 0 to nRow -1
			szCd = Trim(grdCode.GetCellData("bd_code", i))
			szMk = Trim(grdCode.GetCellData("bd_mk", i))
			szGubun = Trim(grdCode.GetCellData("bd_gubun", i))		
			szName = Trim(grdCode.GetCellData("bd_name", i))	     '20240524_01 KBC : 해외주식 고도화	
			szPre = Trim(grdCode.GetCellData("bd_pre", i))	     '20240524_01 KBC : 해외주식 고도화	
			
			if szMk <> "" and szGubun == "OV" then
				grdChart.insertrow = g_nSum
				grdChart.SetCellData("bd_code", g_nSum, szCd)
				grdChart.SetCellData("bd_mk", g_nSum, szMk)
				grdChart.SetCellData("bd_gubun", g_nSum, szGubun)
				grdChart.SetCellData("bd_name", g_nSum, szName)	'20240524_01 KBC : 해외주식 고도화
				grdChart.SetCellData("bd_pre", g_nSum, szPre)		'20240524_01 KBC : 해외주식 고도화
				g_nSum = g_nSum + 1
			end if
		Next		
	elseif g_szGubun == "1" then
		For i = 0 to nRow -1
			szCd = Trim(grdCode.GetCellData("bd_code", i))
			szMk = Trim(grdCode.GetCellData("bd_mk", i))
			szGubun = Trim(grdCode.GetCellData("bd_gubun", i))		
			szName = Trim(grdCode.GetCellData("bd_name", i))	     '20240524_01 KBC : 해외주식 고도화	
			szPre = Trim(grdCode.GetCellData("bd_pre", i))	     '20240524_01 KBC : 해외주식 고도화	
			
			if szMk <> "" and szGubun == "KR" then
				grdChart.insertrow = g_nSum
				grdChart.SetCellData("bd_code", g_nSum, szCd)
				grdChart.SetCellData("bd_mk", g_nSum, szMk)
				grdChart.SetCellData("bd_gubun", g_nSum, szGubun)
				grdChart.SetCellData("bd_name", g_nSum, szName)	'20240524_01 KBC : 해외주식 고도화
				grdChart.SetCellData("bd_pre", g_nSum, szPre)		'20240524_01 KBC : 해외주식 고도화
				g_nSum = g_nSum + 1
			end if
		Next		
	else
		For i = 0 to nRow -1
			szCd = Trim(grdCode.GetCellData("bd_code", i))
			szMk = Trim(grdCode.GetCellData("bd_mk", i))
			szGubun = Trim(grdCode.GetCellData("bd_gubun", i))		
			szMemo = Trim(grdCode.GetCellData("bd_memo", i))
			szName = Trim(grdCode.GetCellData("bd_name", i))	     '20240524_01 KBC : 해외주식 고도화	
			szPre = Trim(grdCode.GetCellData("bd_pre", i))	     '20240524_01 KBC : 해외주식 고도화	
			
			'if szCd <> "" and szCd <> "빈칸" and szCd <> "0" and szCd <> "EMPTY" then		
			if szMk <> "" then
				grdChart.insertrow = g_nSum
				grdChart.SetCellData("bd_code", g_nSum, szCd)
				grdChart.SetCellData("bd_mk", g_nSum, szMk)
				grdChart.SetCellData("bd_gubun", g_nSum, szGubun)
				grdChart.SetCellData("bd_name", g_nSum, szName)	'20240524_01 KBC : 해외주식 고도화
				grdChart.SetCellData("bd_pre", g_nSum, szPre)		'20240524_01 KBC : 해외주식 고도화
				g_nSum = g_nSum + 1
'			elseif szCd == "EMPTY" then
'				grdChart.insertrow = g_nSum
'				grdChart.SetCellData("bd_code", g_nSum, szCd)
'				grdChart.SetCellData("bd_mk", g_nSum, szMk)
'				grdChart.SetCellData("bd_memo", g_nSum, szMemo)
'				g_nSum = g_nSum + 1			
			end if
		Next	
	end if 
	
	'lblTitle.caption = "1/" & g_nSum	' 20160324 디자인에서 빠짐

	if CInt(grdChart.rowcount) == 0 then
'		contChart.lblTop.visible = false
'		contChart.btnTop.visible = false

		contChart.imgPrev.enable = false
		contChart.lblPage.enable = false
		contChart.imgPrev.imgpath = "icn_prev_d"
		contChart.lblPrev.fgcolor = 146
	end if 
	if CInt(grdChart.rowcount) < 3 then
'		contChart.lblBottom.visible = false
'		contChart.btnBottom.visible = false	

		contChart.imgNext.enable = false
		contChart.lblNext.enable = false
		contChart.imgNext.imgpath = "icn_next_d"
		contChart.lblNext.fgcolor = 146
	end if 
	'contChart.setScrollAutosize()
	
	contChart.visible = true
	g_nPage = 1
	Request_FiveChart(0)
End Function

'============================================================================
' Request_FiveChart : 서브차트화면에 조회 요청
'============================================================================
Function Request_FiveChart(nCnt)
'msgbox nCnt
	Dim nCht, i
	nCht = 0
	
	contChart.imgPrev.enable    = true
	contChart.lblPrev.enable    = true
'	contChart.btnBottom.enable = true
	contChart.imgNext.enable = true
	contChart.lblNext.enable = true

	g_nHyun = nCnt
	
	For i = nCnt to nCnt+4
		szCd = Trim(grdChart.GetCellData("bd_code", i))
		szNm = Trim(grdChart.GetCellData("bd_name", i))	'20240524_01 KBC : 해외주식 고도화
		szPre = Trim(grdChart.GetCellData("bd_pre", i))	'20240524_01 KBC : 해외주식 고도화
		
		if i < g_nSum then
			szMk = Trim(grdChart.GetCellData("bd_mk", i))
			szGubun = Trim(grdChart.GetCellData("bd_gubun", i))
			Form.SetCtlProp("contChart.linkFm" & nCht, "linkfile", "mhprc11010_sf")
			if szCd  == "EMPTY" then '빈칸
'				szMemo = Trim(grdChart.GetCellData("bd_memo", i))
'				Form.triggerEvent("linkFm" & nCht, "REQEUST_CHART", "★"& szMemo)
			else
				Form.triggerEvent("linkFm" & nCht, "REQEUST_CHART", szCd & "★" & szMk & "★" & g_szPeriodType & "★" & g_szPeriod & "★" & g_szChrtType & "★" & g_szType & "★" & szGubun & "★" & szNm & "★" & szPre) '20240524_01 KBC : 해외주식 고도화
			end if 			
		else
			Form.SetCtlProp("contChart.linkFm" & nCht, "linkfile", "mhprc11010_sp")
			'Form.triggerEvent("linkFm" & nCht, "REQEUST_CHART", "★★★★★")
		end if
		
		nCht = nCht + 1
		
		if i == nCnt+4 then
			g_nCnt1 = nCnt-4
			g_nCnt2 = nCnt
			g_nCnt3 = nCnt+6		
			
			if nCnt+9 < g_nSum then
				g_nCnt4 = nCnt+10
			else
				g_nCnt4 = g_nSum
			end if			
		end if
	Next

	if nCnt == 0 then
'		contChart.lblTop.caption    = "▲  더보기 "
'		contChart.btnTop.caption    = "▲  더보기 "
		contChart.imgPrev.enable = false
		contChart.lblPage.enable = false
		contChart.imgPrev.imgpath = "icn_prev_d"
		contChart.lblPrev.fgcolor = 146
	else
'		contChart.btnTop.caption    = "▲  더보기 (" & g_nCnt1 & "/" & g_nCnt2 & ")"
'		contChart.lblTop.caption    = "▲  더보기 (" & g_nCnt1 & "/" & g_nCnt2 & ")"
		contChart.imgPrev.imgpath = "icn_prev_n"
		contChart.lblPrev.fgcolor = 147
	end if
	
	if g_nCnt3 > g_nSum then
'		contChart.btnBottom.enable = false
		
'		contChart.btnBottom.caption = "▼  더보기 "
'		contChart.lblBottom.caption = "▼  더보기 "
		contChart.imgNext.enable = false
		contChart.lblNext.enable = false
		contChart.imgNext.imgpath = "icn_next_d"
		contChart.lblNext.fgcolor = 146
	else
'		contChart.btnBottom.caption = "▼  더보기 (" & g_nCnt3 & "/" & g_nCnt4 & ")"
'		contChart.lblBottom.caption = "▼  더보기 (" & g_nCnt3 & "/" & g_nCnt4 & ")"
		contChart.imgNext.imgpath = "icn_next_n"
		contChart.lblNext.fgcolor = 147
	end if
	
	nTotal = CInt(g_nSum / 5)
	nTest = nTotal * 5
	if nTest < g_nSum then
		nTotal = nTotal+1
	end if
	
	g_nTotal = nTotal
	contChart.lblPage.caption = g_nPage.."/"..nTotal
	contChart.scroll_pos = "top"
End Function

