'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	' 관심 동기화 //////////////////////////////////////////////////////////
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	' //////////////////////////////////////////////////////////////////////
End Sub


'============================================================================
Sub Form_OnFormInitBefore()
	g_szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )			' 화면번호 20210823 HSZ CFD
	'Form.bgcolor = "051"		
	contChart.bgcolor = "028"	
	
	contChart.imgPrev.setMaintainingRatio("1")
	contChart.imgNext.setMaintainingRatio("1")
	imgNotice.setMaintainingRatio("1")	
End Sub


'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 무브팝업리턴 받아 화면 이동
	' ----------------------------------------------------------------------		
	if sKeyName == "MOVEPOP_RETURN" then
		Dim tChk
		Dim szChk
		
		if sRet == "" then
			Exit Sub
		end if
		
		tChk = Split(sRet, "★")
		
		szChk = tChk(0)
		
		if UBound(tChk) > 0 then
			Select Case szChk
				Case "J", "Q", "T", "W"		' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
					if tChk(1) == "0" then						' 현재가
						Form.OpenScreen("11000", g_szSltCd)
					elseif tChk(1) == "1" then					' 차트
						Form.OpenScreen("13000", g_szSltCd)
					elseif tChk(1) == "2" then					' 뉴스
						Form.OpenScreen("44000", g_szSltCd)
					elseif tChk(1) == "3" then					' 매수
						Form.OpenScreen("12000", "관심종목★0" & "★" & g_szSltCd)
					elseif tChk(1) == "4" then					' 매도
						Form.OpenScreen("12000", "관심종목★1" & "★" & g_szSltCd)
					end if			
				Case "F", "MF", "O", "MO", "JF", "JO", "XF", "KF", "QO", "WO"	' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	' 20240412 HSZ 코스닥글로벌지수 추가
					if tChk(1) == "0" then						' 현재가
						Form.OpenScreen("31000", g_szSltCd)		
					elseif tChk(1) == "1" then					' 차트
						Form.OpenScreen("31020", g_szSltCd)
					elseif tChk(1) == "2" then					' 선옵종합
						Form.OpenScreen("31010", g_szSltCd)
					elseif tChk(1) == "3" then					' 매수
						Form.OpenScreen("31030", "관심종목★0" & "★" & g_szSltCd)
					elseif tChk(1) == "4" then					' 매도
						Form.OpenScreen("31030", "관심종목★1" & "★" & g_szSltCd)
					end if
					
					Screen_No(szData, "31000", "31030", "31020")
				Case "U"						' 업종코드
					if tChk(1) == "0" then						' 지수상세
						Form.OpenScreen("42000", g_szSltCd)
					elseif tChk(1) == "1" then					' 차트
						Form.OpenScreen("42030", g_szSltCd)
					elseif tChk(1) == "2" then					' 지수종목
						Form.OpenScreen("42020", g_szSltCd)
					end if
				Case "N", "EN", "FN"				' 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
					if tChk(1) == "0" then						' 해외지수
						Form.OpenScreen("42040", g_szSltCd)
					elseif tChk(1) == "1" then					' 해외차트
						Form.OpenScreen("42050", g_szSltCd)
					end if
				Case "B"						' 소액채권, 장내채권
					if tChk(1) == "0" then						' 현재가
						Form.OpenScreen("54010", g_szSltCd)
					elseif tChk(1) == "1" then					' 채권시세표
						Form.OpenScreen("54000", g_szSltCd)
					elseif tChk(1) == "2" then					' 매수
						Form.OpenScreen("54020", "관심종목★0" & "★" & g_szSltCd)
					elseif tChk(1) == "3" then					' 매도
						Form.OpenScreen("54020", "관심종목★1" & "★" & g_szSltCd)
					end if
					
				'해외주식	
				Case "AX", "HK", "JP", "SZ", "SH", "NY", "OQ"
					Form.SetSharedData( "&ITEM_CODE" , g_szSltCd )
					Form.SetSharedData( "&ITEM_KORNAME" , g_szSltName )
					Form.SetSharedData( "&ITEM_OVERSTOCK", g_szSltCd.."★"..g_szSltName.."★".."", "" )					
					Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", g_szSltCd.."★"..g_szSltName.."★".."", "" )
					'szMediaCode = Form.GetSharedData("&MEDIA_CODE", false)
					if tChk(1) == "0" then						' 현재가
						Form.OpenScreen("16000", "")				
					elseif tChk(1) == "1" then					' 차트
						Form.OpenScreen("16020", "")
					elseif tChk(1) == "3" then					' 매수
						Form.OpenScreen("16060", "0")
					elseif tChk(1) == "4" then					' 매도
						Form.OpenScreen("16060", "1")
					end if
		
			End Select
		end if
	end if
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 메인화면에서 관심종목 조회를 요청 Trigger
	' ----------------------------------------------------------------------	
	if sEventName == "GW_LIST" then
		if sParam <> "" then
			tData = Split(sParam, "♥")
		
			g_szGSID = tData(0)
			edtvrsnID.caption = tData(1)
			g_szGubun = tData(2)
			
			grdCode.rowcount = 0
			
			' 종목선택시 연결화면(0:연결화면, 1:현재가, 2:주문, 3:차트)
			g_szMove = Form.GetEnvData("GW_MOVE")
			
			if Trim(g_szMove) == "" then
				g_szMove = "0"
			end if
			
			if g_szGSID == "EMPTY" then
				contChart.linkFm0.left = 606
				contChart.linkFm1.left = 606
				contChart.linkFm2.left = 606
				contChart.linkFm3.left = 606
				contChart.linkFm4.left = 606
				
				lbNoticeMsg.caption = "등록된 관심그룹이 없어요."
				imgNotice.left = 171
				lbNoticeMsg.left = 87 				
				imgNotice.visible = true
				lbNoticeMsg.visible = true 				
			else
			
				contChart.linkFm0.left = 6
				contChart.linkFm1.left = 6
				contChart.linkFm2.left = 6
				contChart.linkFm3.left = 6
				contChart.linkFm4.left = 6	
				
				lbNoticeMsg.caption = ""
				imgNotice.left = 571
				lbNoticeMsg.left = 487 				
				imgNotice.visible = false
				lbNoticeMsg.visible = false 			
			
				if g_szGSID == "BB" then		' 최근조회 종목
					'szRecent = Form.GetRecentHistory("0") '국내
					szRecent = Form.GetRecentHistory("99") '국내+해외	
					Load_RecentList(szRecent)
					contChart.Label1.Top = 927
					contChart.Label1.left = 0
					contChart.Label1.visible = false
				elseif g_szGSID == "CC" then		' 보유종목
				
					'20240524_01 KBC : 해외주식 고도화 (13101, 16110 : 모두 국내CFD,해외CFD잔고조회)
					'
					' obsim_stsv_047r : 국내보유종목	-> obsim_stsv_048r : 해외보유종목
					' obsim_stsv_072r : 국내CFD			-> obsim_stsv_073r : 해외CFD
				
					if g_szScreenNo == "13101" or g_szScreenNo == "16110" then '국내CFD/해외CFD
						g_nNextCount = 0
						DATAMANAGER.RequestTranData("obsim_stsv_072r") '국내CFD보유종목 모두 조회후 해외CFD보유종목 조회(obsim_stsv_073r)
					else '국내/해외
						g_nNextCount = 0
						DATAMANAGER.RequestTranData("obsim_stsv_047r") '국내보유종목 모두 조회후 해외보유종목 조회(obsim_stsv_048r)
					end if
					
					contChart.Label1.Top = 927
					contChart.Label1.left = 0
					contChart.Label1.visible = false
				elseif g_szGSID == "EMPTY" then
					contChart.linkFm0.left = 606
					contChart.linkFm1.left = 606
					contChart.linkFm2.left = 606
					contChart.linkFm3.left = 606
					contChart.linkFm4.left = 606
					
					lbNoticeMsg.caption = "등록된 관심그룹이 없어요."
					imgNotice.left = 171
					lbNoticeMsg.left = 87 				
					imgNotice.visible = true
					lbNoticeMsg.visible = true 					
				else
					' 관심그룹의 종목을 재설정
					init_GWList()			
					contChart.Label1.visible = true  '종목추가,편집,공유 버튼의 공간
				end if
			end if 

			contChart.SetScrollAutoSize()
		end if
	' ----------------------------------------------------------------------
	' 메인화면에서 차트설정 변경후 조회를 요청 Trigger
	' ----------------------------------------------------------------------	
	elseif sEventName == "SET_CHART" then		
		if sParam <> "" then
			tData = Split(sParam, "★")		
			
			g_szPeriodType = tData(0)
			g_szPeriod = tData(1)
			g_szChrtType = tData(2)
			g_szType = tData(3)
			Request_FiveChart(g_nHyun)
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)

	' ----------------------------------------------------------------------
	' 보유종목 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obsim_stsv_047r" or szTranID == "obsim_stsv_072r" or szTranID == "obsim_stsv_048r" or szTranID == "obsim_stsv_073r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID", 0, Form.GetSharedData("&USER_ID", false))
		
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		grdCode.rowcount = "0"
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_USER_ID",          0, Form.GetSharedData("&USER_ID", false))	' USER ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_CNCN_ISSU_NEW_GRP_ID", 0, g_szGSID)							' 관심그룹ID	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 전체 장운영 알람 자동갱신
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_whol_mkop" then
		DATAMANAGER.SetDataValue(1, "ohhts_whol_mkop", "InBlock1", "FIDR_SHRN_ISCD", 0, "*")	' 단축종목코드
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szCd, szMk, szMm
	Dim nRow
	
	' 종목의 시장구분은 조회데이터가 잘못된 값이 내려올수 있으므로 메인에서 받아와야한다.	
	' 보유종목은 NEXT 조회
	' ----------------------------------------------------------------------
	' 보유종목 조회(국내/국내CFD/해외/해외CFD)
	' ----------------------------------------------------------------------	
	 '국내 보유종목,  국내CFD 보유종목
	if szTranID == "obsim_stsv_047r" or szTranID == "obsim_stsv_072r" then  

		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
	
		if nCnt > 0 then				
			'nRow = 0
			nRow = g_nNextCount
			if g_nNextCount == 0 or szTranID == "obsim_stsv_072r" then
				grdCode.SetClear()
			end if 				
			For i = 0 to nCnt -1 
			
				szCd = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD", i)
				grdCode.insertrow = nRow
				
				'20160729 NOHES START ETN, 채권 마켓타입에 따른 처리 추가
				szMk = Form.GetItemCodeInfo(szCd, "market")
				szMk = Change_EtcMarket(szMk)
				select Case szMk
				Case "Q", "BN", "B"
				
				'20210608 SWJ START : 신주인수권 보유종목 조회 오류현상 수정
				Case "J"
					szCutCd = szCd
				'20210608 SWJ END
				
				Case Else
					szCutCd = Mid(szCd, 2, Len(szCd))
					szMk = Form.GetItemCodeInfo(szCutCd, "market")
				End Select
				'20160729 NOHES END
				
				' 보유종목리스트에서 주식종목은 종목코드 맨 앞에 "A", ELW는 "J"가 붙어서 내려옴. 예외처리 ////
				' 보유종목리스트에서 선옵종목은 종목코드 맨 앞에 "K"가 붙어서 내려옴. 예외처리 20160402
				' ETN (mk) = Q, 채권(mk) = BN
				Select Case szMk
					Case "J", "T", "W", "F", "MF", "O", "MO", "JF", "JO", "XF", "KF", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가) / ' 20240412 HSZ 코스닥글로벌지수 추가
						grdCode.SetCellData("bd_code", nRow, szCutCd)
						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCutCd, "name"))	' 20160325 위젯위해 종목명 추가
					'20160729 NOHES START ETN, 채권 마켓타입에 따른 처리 추가
					Case "Q", "BN", "B"
						grdCode.SetCellData("bd_code", nRow, szCd)
						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))
					Case "" 										'코드가 유효하지 않은 경우, 2자리 자르지 않은 전체 종목코드로 보여줌.
						grdCode.SetCellData("bd_code", nRow, szCd)
						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))						
					'20160729 NOHES END
					Case Else
						if Left(szCd, 1, 1) == "A" or Left(szCd, 1, 1) == "K" then
							grdCode.SetCellData("bd_code", nRow, szCutCd)
							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCutCd, "name"))	' 20160325 위젯위해 종목명 추가
						else
							grdCode.SetCellData("bd_code", nRow, szCd)
							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))	' 20160325 위젯위해 종목명 추가
						end if
				End Select
				' ////////////////////////////////////////////////////////////////////////////////////////////
				grdCode.SetCellData("bd_mk",   nRow, szMk)
				grdCode.SetCellData("bd_gubun",   nRow, "KR") '국내
				
				nRow = nRow + 1
			Next
'			else 				
'				 Form.MsgBox("안내", "관심그룹에 등록된 종목이 없습니다.\n종목을 등록하시겠습니까?", "ADD_ITEM", 1)
		end if
		
		if szTranID == "obsim_stsv_047r" then '국내 보유종목  NEXT
		
		     g_nNextCount = grdCode.rowcount			    
			if  DATAMANAGER.IsMoreNextData( "obsim_stsv_047r" ) == True then 
				DATAMANAGER.RequestNextData( "obsim_stsv_047r" )
			else
				DATAMANAGER.RequestTranData( "obsim_stsv_048r" )
			end if
			
		elseif szTranID == "obsim_stsv_072r" then '국내CFD 보유종목  NEXT
		
		    g_nNextCount = grdCode.rowcount
			if  DATAMANAGER.IsMoreNextData( "obsim_stsv_072r" ) == True then 
				DATAMANAGER.RequestNextData( "obsim_stsv_072r" )
			else
				DATAMANAGER.RequestTranData( "obsim_stsv_073r" )
				
'				' 메인화면에서 종목추가 가능하므로 메인화면에 종목리스트 카운트를 알린다.
'				Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
'		
'				Save_GWList()		' 동기화 상태일때도 파일에는 계속저장
'				'Save_GWList()에서 g_szCloud = "0"이면 Save_grdMk() 이미 호출함.
'				if g_szCloud <> "0" then
'					Save_grdMk()		
'				end if
			end if
		end if 

	'해외 보유종목		
	elseif szTranID == "obsim_stsv_048r" then

		nCnt = DATAMANAGER.GetDataCount(0, "obsim_stsv_048r", "OutBlock1")
		if nCnt > 0 then
			'nRow = 0
			nRow = g_nNextCount
			if g_nNextCount == 0  then
				grdCode.SetClear()
			end if 				
			
			For i = 0 to nCnt -1 
				szCd = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "ISCD", i)
				szName = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "KOR_NAME", i)
				szOnline = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "ONLN_YN", i)
				szPre = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "CLPR", i)
				
				grdCode.insertrow = nRow
				
				if Trim(szCd) <> "" then
					tCode = Split(szCd, ".")
					szCutCd = tCode[0]
					szMk = tCode[1]
					
					'20220811 SWJ START : "."이 종목코드에 들어간 종목 화면 파싱 오류
					if instr(szCd,".") <> instrRev(szCd,".") then
						szMk 	= Right(szCd,len(szCd) - instrRev(szCd,"."))			
						szCutCd  = Replace(szCd,"." & szMk,"")
					end if
					'20220811 SWJ END
				end if
				
				grdCode.SetCellData("bd_code", nRow, szCutCd )
				grdCode.SetCellData("bd_mk",   nRow, szMk)
				grdCode.SetCellData("bd_online",   nRow, szOnline)
				grdCode.SetCellData("bd_pre",   nRow, szPre)
				
				' 오프라인종목일경우 종목명은 서비스에서 받아씀
				if szOnline == "N" then
					grdCode.SetCellData("bd_name", nRow, szName)
				else
					grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szMk&"@"&szCutCd, "name"))
				end if
				grdCode.SetCellData("bd_gubun",   nRow, "OV") '해외
				
				nRow = nRow + 1
			Next
'			else
'				if grdCode.rowcount ==  0 then '해외/국내 모두 없는 경우 
'				    Form.MsgBox("안내", "관심그룹에 등록된 종목이 없습니다.\n종목을 등록하시겠습니까?", "ADD_ITEM", 1)
'				end if 				
		end if
		
		if  DATAMANAGER.IsMoreNextData( "obsim_stsv_048r" ) == True then '해외 보유종목 NEXT
			 g_nNextCount = grdCode.rowcount
			DATAMANAGER.RequestNextData( "obsim_stsv_048r" )
		else		
			' 메인화면에서 종목추가 가능하므로 메인화면에 종목리스트 카운트를 알린다.
			Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
			Form.triggerEvent("##", "SET_VISIBLE", "")

			Save_GWList()		' 동기화 상태일때도 파일에는 계속저장
			Save_grdChart()	
			SetNoticeMsg() '종목없음 안내메시지처리
		end if
				
	'해외CFD 보유종목
	elseif szTranID == "obsim_stsv_073r" then '
		nCnt = CInt(DATAMANAGER.GetDataCount(0, "obsim_stsv_073r", "OutBlock1"))
		
		if nCnt > 0 then
			'nRow = 0
			nRow = g_nNextCount
			if g_nNextCount == 0  then
				grdCode.SetClear()
			end if 				
			
			For i = 0 to nCnt -1 
				szCd = DATAMANAGER.GetDataValue(0, "obsim_stsv_073r", "OutBlock1", "ISCD", i)
				szName = DATAMANAGER.GetDataValue(0, "obsim_stsv_073r", "OutBlock1", "KOR_NAME", i)
				
				grdCode.insertrow = nRow
				
				if Trim(szCd) <> "" then
					tCode = Split(szCd, ".")
					szCutCd = tCode[0]
					szMk = tCode[1]
					
					'20220811 SWJ START : "."이 종목코드에 들어간 종목 화면 파싱 오류
					if instr(szCd,".") <> instrRev(szCd,".") then
						szMk 	= Right(szCd,len(szCd) - instrRev(szCd,"."))			
						szCutCd  = Replace(szCd,"." & szMk,"")
					end if
					'20220811 SWJ END
				end if
				
				grdCode.SetCellData("bd_code", nRow, szCutCd )
				grdCode.SetCellData("bd_mk",   nRow, szMk)
				grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szMk&"@"&szCutCd, "name"))
				grdCode.SetCellData("bd_gubun", nRow, "OV") '해외
				
				nRow = nRow + 1
			Next
		end if
		
		if  DATAMANAGER.IsMoreNextData( "obsim_stsv_073r" ) == True then '해외CFD 보유종목 NEXT
			 g_nNextCount = grdCode.rowcount
			DATAMANAGER.RequestNextData( "obsim_stsv_073r" )
		else			
			' 메인화면에서 종목추가 가능하므로 메인화면에 종목리스트 카운트를 알린다.
			Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
			Form.triggerEvent("##", "SET_VISIBLE", "")
	
			Save_GWList()		' 동기화 상태일때도 파일에는 계속저장
			Save_grdChart()	
			SetNoticeMsg() '종목없음 안내메시지처리
		end if
			
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회(국내+해외)
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		nRow = grdCode.rowcount			
		For i = 0 to nRow - 1 
			szCode = grdCode.GetCellData("bd_code", i)
			szGubun = grdCode.GetCellData("bd_gubun", i)
			szMk = grdCode.GetCellData("bd_mk", i)
		
			if szCode <> "EMPTY" then '빈칸이 아닌 경우
				if szGubun == "OV" then '해외				
					szName = Form.GetItemCodeInfo(szMk&"@"&szCode, "name")	
				elseif (szGubun == "KR") or (szGubun == "")  then '국내
					szMk = Form.GetItemCodeInfo(szCode, "market")
					szMk = Change_EtcMarket(szMk)
					szName = Form.GetItemCodeInfo(szCode, "name")
					grdCode.SetCellData("bd_gubun",   i, "KR") '국내
				end if 
			else
				szName = ""
			end if
				
			grdCode.SetCellData("bd_mk", i, szMk)
			grdCode.SetCellData("bd_name", i, szName)	
		Next			
		
		' 메인화면에서 종목추가 가능하므로 메인화면에 종목리스트 카운트를 알린다.
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)

		Save_GWList()		' 동기화 상태일때도 파일에는 계속저장
		Save_grdChart()	
		SetNoticeMsg() '종목없음 안내메시지처리
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError : 임시
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Form.ShowAlert(szTranID , szErrMsg)
End Sub

'============================================================================
' f_getExchCode2 :  3자리 일경우 2자리로 변경
'============================================================================
Function f_getExchCode2(szExchCode3)
	if szExchCode3 == "NAS" then
		return "OQ"
	elseif szExchCode3 = "AMX" then
		return "AX"
	elseif szExchCode3 = "NYS" then
		return "NY"
	elseif szExchCode3 = "SHS" then
		return "SH"
	elseif szExchCode3 = "SZS" then
		return "SZ"
	elseif szExchCode3 = "HKS" then
		return "HK"
	elseif szExchCode3 = "TSE" then
		return "JP"
	end if
	
	return szExchCode3
End Function

'============================================================================
Sub contChart_imgPrev_OnClick()
	if g_nPage > 1 then
		g_nPage = g_nPage - 1
	end if
	Request_FiveChart(g_nCnt1-1)
	'contChart.scroll_pos = "top"
End Sub

'============================================================================
Sub contChart_imgNext_OnClick()
	g_nPage = g_nPage + 1
	if g_nTotal < g_nPage then
		g_nPage = g_nTotal
	end if 
	Request_FiveChart(g_nCnt3-1)
	'contChart.scroll_pos = "top"
End Sub

'============================================================================
Sub contChart_lblNext_OnClick()
	if contChart.imgNext.enable == True then	
		call contChart_imgNext_OnClick()
	end if
End Sub

'============================================================================
Sub contChart_lblPrev_OnClick()
	if contChart.imgPrev.enable == True then
	Form.ShowAlert(contChart.imgPrev.enable, contChart.imgPrev.enable)
		call contChart_imgPrev_OnClick()
	end if
End Sub

'============================================================================
Function SetNoticeMsg()
	'종목없음 안내메시지처리
	nCnt = grdChart.rowcount
'	nCnt = grdCode.rowcount
	if CStr(nCnt) == "" or CStr(nCnt) = "00000"or CStr(nCnt) = "0" then
	
		if g_szGSID == g_tKey[0] then
			lbNoticeMsg.caption = "최근 조회 종목이 없어요."
		elseif g_szGSID == g_tKey[1] then
			lbNoticeMsg.caption = "보유한 종목이 없어요."
		else
			'if g_szGSID == "000" or g_szGSID == "00"  then
			'	lbNoticeMsg.caption = "등록된 관심그룹이 없어요."
			'else
				lbNoticeMsg.caption = "등록된 종목이 없어요."
			'end if 
		end if 
		imgNotice.left = 171
		lbNoticeMsg.left = 87 				
		imgNotice.visible = true
		lbNoticeMsg.visible = true
		
		'20230810 KKM 관심종목 동기화OFF 차트 숨기기
		if g_szCloud == "0" then
			contChart.linkFm0.left = 606
			contChart.linkFm1.left = 606
			contChart.linkFm2.left = 606
			contChart.linkFm3.left = 606
			contChart.linkFm4.left = 606
		end if 
	else
		imgNotice.left = 671
		lbNoticeMsg.left = 587 				
		imgNotice.visible = false
		lbNoticeMsg.visible = false 
		
		'20230810 KKM 관심종목 동기화OFF 차트 보이기
		if g_szCloud == "0" then
			contChart.linkFm0.left = 6
			contChart.linkFm1.left = 6
			contChart.linkFm2.left = 6
			contChart.linkFm3.left = 6
			contChart.linkFm4.left = 6
		end if 	
	end if
End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "ohhts_intr_007r" then
'msgbox szTranID & " :: " & szErrCode	 & " :: " & 	szErrMsg & " :: " & g_szGSID & " :: " & grdCode.rowcount
		if szErrCode == "9900" and g_szGSID == "EMPTY" and CStr(grdCode.rowcount) == "0" then '등록되어 있지 않는 관심그룹
			lbNoticeMsg.caption = "등록된 관심그룹이 없어요."
			imgNotice.left = 171
			lbNoticeMsg.left = 87 				
			imgNotice.visible = true
			lbNoticeMsg.visible = true 				
		end if 
	end if 
End Sub

