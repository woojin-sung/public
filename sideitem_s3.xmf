'============================================================================
' 화 면 명 : 사이드종목_Watching 종목
' 화면설명 : 사이드종목_Watching 종목
' 작    성 : 2016.02.19 ~ 2016.  .     
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

' 현재가/예상가/단일가 구분
Dim g_szRSelect
g_szRSelect = "0"

Dim g_szGubun
g_szGubun = "0"  '전체(0)/국내(1)/해외(2)

'국내(KR)/해외(OV)

'20230109 HSZ 주간거래 시세 추가
Dim g_szDaysise
g_szDaysise = "0"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Set_Real_Input : real_input 정의 (0현재, 1예상, 2단일)
'============================================================================
Function Set_Real_Input(szMk, nIdx, szCd)
'Form.showalert(szMk & " :: " & nIdx  & " :: " & szCd)
	Select Case szMk
		' [[ 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권 ]]
		Case "J", "Q"
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신 20220103 HSZ
'			elseif g_szRSelect == "1" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_stck_inas", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식호가 자동갱신(예상가) 20220103 HSZ
'			elseif g_szRSelect == "2" then
'				DATAMANAGER.SetDataValue(1, "ohhts_ovtp_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 시간외단일체결 자동갱신
			end if
		' [[ KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드, KRX300 선물/선물 스프레드 ]]
		Case "F", "MF", "XF", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300 추가)	' 20240412 HSZ: 코스닥글로벌지수 추가		
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_futs_antg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 예상체결 자동갱신
			end if 
		' [[ KOSPI지수 옵션, 미니코스피 옵션, 코스닥150 옵션, 위클리 옵션 ]]
		Case "O", "MO", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)				
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 체결 자동갱신
'			elseif g_szRSelect == "1" then	
'				DATAMANAGER.SetDataValue(1, "ohhts_optn_antg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 예상체결 자동갱신
			end if 
		' [[ 업종코드	]]
		Case "U"					
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 체결 자동갱신
			end if 
			
		'20180712 HAMWG START : K-OTC MTS 도입
		' [[ K-OTC(프리보드) ]]
		Case "T"					
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_frbr_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 프리보드호가 자동갱신
'			elseif g_szRSelect == "2" then
'				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
			end if 
		'20180712 HAMWG END
		
		' [[ ELW ]]
		Case "W"
			if g_szRSelect == "0" then 
				DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.SetDataValue(1, "ohhts_elw_aspr", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW호가 자동갱신(예상가)
			end if 
		' [[ 소액채권, 장내채권 ]]
		Case "B"					
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_bond_cntg", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 체결 자동갱신
			end if
		' [[ 해외지수(대표지수, 업종지수) ]]
		Case "N"
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외지수/종목 체결 자동갱신
			end if 
		' [[ 해외지수(CME선물, 상품선물) ]]
		Case "FN"
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외선물 체결 자동갱신
			end if
		' [[ 세계환율 ]]	
		Case "EN"
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 환율 체결 자동갱신
			end if 
		' [[ 주식선물 ]]	 2018.01.02 CJH 추가
		Case "JF"		
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_sfut_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식선물 체결 자동갱신
			end if 
		' [[ 주식옵션 ]]	 2018.01.02 CJH 추가
		Case "JO"		
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_sopt_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식옵션 체결 자동갱신
			end if
			
		'해외주식	
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"

	End Select
End Function

'============================================================================
' Request_RealData : Real 요청 (0현재, 1예상, 2단일)
'============================================================================
Function Request_RealData(szMk)
	Select Case szMk
		' [[ 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권 ]]	
		Case "J", "Q"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_stck_incg")		' 주식체결 자동갱신 20220103 HSZ
'			elseif g_szRSelect == "1" then	
'				DATAMANAGER.RequestRealData("ohhts_stck_inas")		' 주식호가 자동갱신(예상가) 20220103 HSZ
'			elseif g_szRSelect == "2" then
'				DATAMANAGER.RequestRealData("ohhts_ovtp_cntg")		' 시간외단일체결 자동갱신
			end if
		' [[ KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드, KRX300 선물/선물 스프레드 ]]
		Case "F", "MF", "XF", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300 추가)	' 20240412 HSZ START : 코스닥글로벌지수 추가
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_futs_cntg")		' 선물 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_futs_antg")		' 선물 예상체결 자동갱신
			end if 
		' [[ KOSPI지수 옵션, 미니코스피 옵션, 코스닥150 옵션, 위클리 옵션 ]]
		Case "O", "MO", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)		
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
'			elseif g_szRSelect == "1" then	
'				DATAMANAGER.RequestRealData("ohhts_optn_antg")		' 옵션 예상체결 자동갱신
			end if 
		' [[ 업종코드	]]				
		Case "U"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_nmix_cntg")		' 업종지수 체결 자동갱신
			end if
			
		'20180712 HAMWG START : K-OTC MTS 도입
		' [[ K-OTC(프리보드) ]]
		Case "T"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_frbr_cntg")		' 프리보드체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_frbr_aspr")		' 프리보드호가 자동갱신
			end if 
		'20180712 HAMWG END
		
		' [[ ELW ]]		
		Case "W"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_elw_cntg")			' ELW체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.RequestRealData("ohhts_elw_aspr")			' ELW호가 자동갱신
			end if 
		' [[ 소액채권, 장내채권 ]]
		Case "B"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_bond_cntg")		' 일반채권 체결 자동갱신
			end if
		' [[ 해외지수(대표지수, 업종지수) ]]
		Case "N"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")		' 해외지수/종목 체결 자동갱신
			end if 
		' [[ 해외지수(CME선물, 상품선물) ]]			
		Case "FN"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_nfut_cntg")		' 해외선물 체결 자동갱신
			end if
		' [[ 세계환율 ]]				
		Case "EN"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_exrt_cntg")		' 환율 체결 자동갱신
			end if	
		' [[ 주식선물	]]	2018.01.02 CJH 추가		
		Case "JF"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_sfut_cntg")		' 주식선물 체결			
			end if 
		' [[ 주식옵션	]]	2018.01.02 CJH 추가		
		Case "JO"
			if g_szRSelect == "0" then
				DATAMANAGER.RequestRealData("ohhts_sopt_cntg")		' 주식옵션 체결			
			end if 
			
		'해외주식	
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			if g_szRSelect == "0" then  
				'20230109 HSZ START : 주간거래 실시간 체크 분기처리 추가
				if g_szDaysise = "1" then	'주간거래 실시간 체크 -> 미국장은 주간거래 실시간만 받도록
					DATAMANAGER.RequestRealData("ohhts_exst_ictg")		' 해외주식 체결 자동갱신			
					DATAMANAGER.RequestRealData("ohhts_exst_cntd")		' 해외주식 체결 자동갱신
				else
					DATAMANAGER.RequestRealData("ohhts_exst_ictg")
				end if				
			end if 				
 			
	End Select
End Function

'============================================================================
' Cancel_RealData : Real 해제 (0현재, 1예상, 2단일)
'============================================================================
Function Cancel_RealData(szMk)
	Select Case szMk
		' [[ 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권 ]]
		Case "J", "Q"
			if g_szRSelect == "0" then
				DATAMANAGER.CancelRealData("ohhts_stck_incg")		' 주식체결 자동갱신 20220103 HSZ
'			elseif g_szRSelect == "1" then	
'				DATAMANAGER.CancelRealData("ohhts_stck_inas")		' 주식호가 자동갱신(예상가) 20220103 HSZ'
'			elseif g_szRSelect == "2" then
'				DATAMANAGER.CancelRealData("ohhts_ovtp_cntg")		' 시간외단일체결 자동갱신
			end if
		' [[ KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드, KRX300 선물/선물 스프레드 ]]
		Case "F", "MF", "XF", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300 추가)	' 20240412 HSZ START : 코스닥글로벌지수 추가
			if g_szRSelect == "0" then
				DATAMANAGER.CancelRealData("ohhts_futs_cntg")		' 선물 체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.CancelRealData("ohhts_futs_antg")		' 선물 예상체결 자동갱신
			end if 
		' [[ KOSPI지수 옵션, 미니코스피 옵션, 코스닥150 옵션, 위클리 옵션 ]]
		Case "O", "MO", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)	
			if g_szRSelect == "0" then
				DATAMANAGER.CancelRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
'			elseif g_szRSelect == "1" then	
'				DATAMANAGER.CancelRealData("ohhts_optn_antg")		' 옵션 예상체결 자동갱신
			end if 
		' [[ 업종코드	]]	
		Case "U"
			if g_szRSelect == "0" then
				DATAMANAGER.CancelRealData("ohhts_nmix_cntg")		' 업종지수 체결 자동갱신
			end if 
			
		'20180712 HAMWG START : K-OTC MTS 도입
		' [[ K-OTC(프리보드) ]]
		Case "T"
			if g_szRSelect == "0" then
				DATAMANAGER.CancelRealData("ohhts_frbr_cntg")		' 프리보드체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.CancelRealData("ohhts_frbr_aspr")		' 프리보드호가 자동갱신
'			elseif g_szRSelect == "2" then
'				DATAMANAGER.CancelRealData("ohhts_stck_incg")		' 주식체결 자동갱신 20220103 HSZ
			end if 
		'20180712 HAMWG END
		
		' [[ ELW ]]
		Case "W"
			if g_szRSelect == "0" then
				DATAMANAGER.CancelRealData("ohhts_elw_cntg")		' ELW체결 자동갱신
'			elseif g_szRSelect == "1" then
'				DATAMANAGER.CancelRealData("ohhts_elw_aspr")		' ELW호가 자동갱신
			end if 
		' [[ 소액채권, 장내채권 ]]
		Case "B"
			if g_szRSelect == "0" then
				DATAMANAGER.CancelRealData("ohhts_bond_cntg")		' 일반채권 체결 자동갱신
			end if 
		' [[ 해외지수(대표지수, 업종지수) ]]
		Case "N"
			if g_szRSelect == "0" then
				DATAMANAGER.CancelRealData("ohhts_ovrs_nmix")		' 해외지수/종목 체결 자동갱신
			end if 
		' [[ 해외지수(CME선물, 상품선물) ]]	
		Case "FN"
			if g_szRSelect == "0" then
				DATAMANAGER.CancelRealData("ohhts_nfut_cntg")		' 해외선물 체결 자동갱신
			end if 
		' [[ 세계환율 ]]	
		Case "EN"
			if g_szRSelect == "0" then
				DATAMANAGER.CancelRealData("ohhts_exrt_cntg")		' 환율 체결 자동갱신
			end if 			
			
		' [[ 주식선물 ]]	2018.01.02 CJH 추가
		Case "JF"
			if g_szRSelect == "0" then
				DATAMANAGER.CancelRealData("ohhts_sfut_cntg")		' 주식선물 체결 자동갱신
			end if 
		' [[ 주식옵션 ]]	2018.01.02 CJH 추가
		Case "JO"
			if g_szRSelect == "0" then
				DATAMANAGER.CancelRealData("ohhts_sopt_cntg")		' 주식옵션 체결 자동갱신
			end if 
		'해외주식	
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			if g_szRSelect == "0" then  
				DATAMANAGER.CancelRealData("ohhts_exst_ictg")		' 해외주식 체결 자동갱신			
				DATAMANAGER.CancelRealData("ohhts_exst_cntd")		' 해외주식 체결 자동갱신			
			end if 			
	End Select
End Function


'============================================================================
' Save_grdMk : 실시간을 위해 중복되지 않는 시장구분을 저장해둔다.
'============================================================================
Function Save_grdMk()
	grdMk.rowcount = 0	
	For i = 0 to grdCode.rowcount-1
	
		szMk = Trim(grdCode.GetCellData("bd_mk", i))
		szCd = Trim(grdCode.GetCellData("bd_code", i))
		szGubun = Trim(grdCode.GetCellData("bd_gubun", i))
		
		' MTS에서 보여주는 상품의 종목만 선택
		szMk =  f_ChkMarket(szMk, szCd)
		
		if szMk <> "" then
			nRow2 = CInt(grdMk.rowcount)
	
			if nRow2 == 0 then
				grdMk.insertrow = 0
				grdMk.SetCellData("bd_mk", 0, szMk)
				grdMk.SetCellData("bd_code", 0, szCd)
				grdMk.SetCellData("bd_gubun", 0, szGubun)
			end if
	
			For j = 0 to nRow2 - 1
				szMk2 = Trim(grdMk.GetCellData("bd_mk", j))
				
				if szMk == szMk2 then		
					szCd2 = grdMk.GetCellData("bd_code", j) & "★" & szCd
					grdMk.SetCellData("bd_code", j, szCd2)
					grdMk.SetCellData("bd_gubun", j, szGubun)
					
					Exit For
				end if
				
				if j == nRow2 - 1 then
					grdMk.insertrow = 0
					grdMk.SetCellData("bd_mk", 0, szMk)
					grdMk.SetCellData("bd_code", 0, szCd)
					grdMk.SetCellData("bd_gubun", 0, szGubun)
				end if
			Next		
		end if
	Next

	if CInt(grdCode.rowcount) > 0 then
		grdList0.rowcount = 0
		' 관심종목 데이터조회
		if g_szGubun = "2" then 
			'해외
			DATAMANAGER.RequestTranData( "ohhts_1030_002r" ) 
		else '전체,국내
			DATAMANAGER.RequestTranData( "ohhts_1020_004r" ) '전체라면 국내 후 해외조회)
		end if 
	end if	
End Function

'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	Select Case szMk
		Case "J", "Q", "F", "MF", "XF", "O", "MO", "QO", "U", "T", "W", "B", "P", "N", "EN", "FN", "EMPTY", "JF", "JO", "WO", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	' 20240412 HSZ START : 코스닥글로벌지수 추가
			return szMk
		'해외주식	
		Case "AX", "HK", "JP", "SZ", "SH", "NY", "OQ"
			return szMk
		Case "N"			' 해외지수, 환율은 같은 시장구분으로 내려오기에 분리시켜야 한다.
			If InStr(szCd, "@") == 0 then
				return "EN"
			else
				return szMk
			end if
		Case Else
			return ""
	End Select	
End Function

'============================================================================
' Change_Len
'============================================================================
Function Change_Len(szData)
	if Len(szData) == 1 then
		Change_Len = "0" & CStr(szData)
	else
		Change_Len = CStr(szData)
	end if 
End Function

'============================================================================
' Change_EtcMarket :  해외지수(대표, 업종지수)/ 채권의 마켓구분 변경
'============================================================================
Function Change_EtcMarket(szData)
	if Trim(szData) == "UJ" then
		return "N"
	elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		return "B"
	end if	
	
	return szData
End Function
'============================================================================
' f_GetMarketName : 종목코드에 따른 시장명 RETURN
'============================================================================
Function f_GetMarketName(szCode)
	Dim szMarket, szInnerMk
	szMarket =  Form.GetItemCodeInfo(szCode, "market")
	szMarket = Change_EtcMarket(szMarket)
	szMarket = f_ChkMarket(szMarket, szCode)
	
	
	if szMarket == "J" then
		szInnerMk = Form.GetItemCodeInfo(szCode, "innermarket")
		
		if LEFT(szCode, 1, 1) == "J" then
			return "신주인수권"
		elseif LEFT(szCode, 1, 1) == "F" then
			return "수익증권"
		end if
		
		if szInnerMk == "001" then
			return "KOSPI"
		elseif szInnerMk == "002" then
			return "KOSDAQ"
		elseif szInnerMk == "013" then
			return "ETF"
		elseif szInnerMk == "033" then
			return "KONEX"
		else
			return ""
		end if
		
		
	elseif szMarket == "Q" then
		return "ETN"
	elseif szMarket == "W" then
		return "ELW"
	elseif szMarket == "T" then
		return "K-OTC"
	elseif szMarket == "F" or szMarket == "MF" or szMarket == "XF" or 
		szMarket == "O" or szMarket == "MO" or szMarket == "QO"  or
		szMarket == "WO" or szMarket == "KF" then	' 20240412 HSZ: 코스닥글로벌지수 추가
		
		return "선물옵션"
	elseif szMarket == "U" then
		return "업종지수"
	elseif szMarket == "B" then
		return "채권"
	elseif szMarket == "N" then
		return "해외지수"
	elseif szMarket == "FN" then
		return "해외선물"
	elseif szMarket == "EN" then
		return "환율"
	elseif szMarket == "JF" or szMarket == "JO" then
		return "주식선물옵션"
	
	end if
	 
End Function

'============================================================================
' 2017.11.22 -  LSS : 종목 대비값에 따른 색상 및 대비부호 설정
'============================================================================
Function swapItemColor(nIndex, nDiff, nRate)
	if nRate == "0.00" or nRate == "0" then
		grdList0.SetCellFgColor( "bd_hyun", nIndex, 12 ) 
		grdList0.SetCellFgColor( "bd_debi", nIndex, 12 ) 
		grdList0.SetCellFgColor( "bd_rate", nIndex, 12 ) 
	else
		grdList0.SetCellFgColor( "bd_hyun", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
		grdList0.SetCellFgColor( "bd_debi", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
		grdList0.SetCellFgColor( "bd_rate", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
	end if 		
End Function

'============================================================================
' 입력값조절
'============================================================================
Sub Decimal_Setting(sValue, sDecimalLen)
	Dim sReturn
	sReturn = sValue
	if ( sValue ~= nil and sValue ~= "" ) and ( sDecimalLen ~= nil and sDecimalLen ~= "" ) then
		Dim sSign
		Dim nDecimal
		sSign = Left(sValue, 1)
		nDecimal = CDbl(sDecimalLen)
		if CDbl( sValue ) == 0 then
			if nDecimal > 0 then
				sReturn = "0."
				for i = 0 to nDecimal-1
					sReturn = sReturn.."0"
				next
			else
				sReturn = "0"
			end if			
		else
			Dim sTemp
			sTemp = {}
			sTemp = Split( sValue, "." )
			if nDecimal > 0 then
				if #sTemp >= 2 and sTemp[1] ~= nil and sTemp[1] ~= "" then
					Dim tempLen
					tempLen = Len(sTemp[1])
					if tempLen > nDecimal then
						sReturn = sTemp[0].."."..Left(sTemp[1], nDecimal)
					elseif tempLen < nDecimal then
						sReturn = sTemp[0].."."..sTemp[1]
						for i = 0 to (nDecimal-tempLen)-1
							sReturn = sReturn.."0"
						next
					end if
				else
					sReturn = sReturn.."."
					for i = 0 to (nDecimal)-1
						sReturn = sReturn.."0"
					next
				end if
			end if			
		end if
	end if
	
	if sSign == "-" or sSign == "+" then
		sReturn = sSign..sReturn
	end if
	
	return sReturn
end Sub

'============================================================================
' 2023.02.06 -  HSZ : 실시간 여부에 따른 이미지 설정
'============================================================================
Function settingRealTime(nIndex, szRealAble)
	' 실시간	
	if szRealAble == "0" then
		grdlist0.SetCellData( "bd_realicon", nIndex, "realtime_green" )
	' 실시간아님
	elseif szRealAble == "1" then
		grdlist0.SetCellData( "bd_realicon", nIndex, "realtime_grey" )
	end if
End Function

