'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' Wathcing종목 조회
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_watch_003" then
		grdCode.rowcount = "0"		
		DATAMANAGER.SetDataValue(0, "ohhts_watch_003", "InBlock1", "FID_INPUT_WRTR_ID", 0, Form.GetSharedData("&CUST_NUM", false))
	' ----------------------------------------------------------------------
	' 관심종목 데이터조회 - 국내
	' ----------------------------------------------------------------------
	elseif szTranID ==  "ohhts_1020_004r" then
		DATAMANAGER.ClearInputData( false, "ohhts_1020_004r" )
		grdList0.rowcount = "0"		' 종목조회그리드 초기화
		j = 0

		For i = 0 to grdCode.rowcount-1
			if grdCode.GetCellData("bd_gubun", i) == "KR" then '국내인 경우 
				szMk = grdCode.GetCellData("bd_mk", i)
			
				' 시장구분이 없는것은 종목데이터 조회에서 뺀다. -> HTS는 그냥 던짐..ㅋ
				' 여기서 MTS마스터에 없는 종목 빼면 싱크문제 생길수 있음. 조회 한다음에 할것!
				'if Trim(szMk) <> "" then
				'if i < 2 then
					'szMk = Trim(grdCode.GetCellData("bd_mk", i))
					szCd = Trim(grdCode.GetCellData("bd_code", i))
					
					' MTS에서 보여주는 상품의 종목만 선택
					szMk = f_ChkMarket(szMk, szCd)
					
					DATAMANAGER.SetDataValue(0, "ohhts_1020_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", j, szMk)
					DATAMANAGER.SetDataValue(0, "ohhts_1020_004r", "InBlock1", "FID_INPUT_ISCD",               j, szCd)
					j = j + 1
				'end if
			end if 
		Next
		
	' ----------------------------------------------------------------------
	' 관심종목 데이터조회 - 해외
	' ----------------------------------------------------------------------
	elseif szTranID ==  "ohhts_1030_002r" then	
		DATAMANAGER.ClearInputData( false, "ohhts_1030_002r" )
		if g_szGubun == "2" then
			' 종목조회그리드 초기화
			grdList0.rowcount = "0"		
		end if 
		
		j = 0
		For i = 0 to grdCode.rowcount-1
		    if grdCode.GetCellData("bd_gubun", i) == "OV" then '해외인 경우 
				szMk = grdCode.GetCellData("bd_mk", i)
				szCd = Trim(grdCode.GetCellData("bd_code", i))
				tCode = {}
				
				' MTS에서 보여주는 상품의 종목만 선택
				szMk = f_ChkMarket(szMk, szCd)
				
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", j , "OV" ) '해외주식			
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_INPUT_OVRS_ISCD", j , szCd ) ' 종목코드
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_COND_MRKT_CLS_CODE", j , szMk ) '종목시장
				' 시장별 실시간여부값
				szRealAble = Form.GetSharedData( "REALTIME_"&szMk, false )
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE", j, szRealAble ) '실시간여부
				j = j + 1
			end if 
		Next		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szCd, szMk, szMm
	' 종목의 시장구분은 조회데이터가 잘못된 값이 내려올수 있으므로 메인에서 받아와야한다.	''''''''''''''''''	
	' ----------------------------------------------------------------------
	' Watching
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_watch_003" then
		
		For i = 0 to grdCode.rowcount - 1 
			szCode = grdCode.GetCellData("bd_code", i)
			szOV = Instr(szCode, "@")
			If CStr(szOV) <> "0" Then '해외			
				tCode = Split(szCode, "@")
				szMk = tCode[0]
				szMk = f_getExchCode2(szMk)
				szCode  = tCode[1]
				szGubun = "OV" '해외
			else ' 국내
				szMk = Form.GetItemCodeInfo(szCode, "market")
				szMk = Change_EtcMarket(szMk)
				szGubun = "KR" '국내
			end if 
			'최근조회종목 - 상품선물 안보이게
			'상품선물 "FF"분기처리 추가
			if szMk == "CF" or szMk == "FF" then

			else
				grdCode.SetCellData("bd_code", i, szCode)
				grdCode.SetCellData("bd_mk",   i, szMk)
				grdCode.SetCellData("bd_memo", i, "")
				grdCode.SetCellData("bd_name", i, Form.GetItemCodeInfo(szCode, "name"))
				grdCode.SetCellData("bd_gubun", i, szGubun) 
			end if	
		Next
		
		SetNoticeMsg() '종목없음 안내메시지처리
		Save_grdMk()
	' ----------------------------------------------------------------------
	' 관심종목 종목데이터 조회 - 국내
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_1020_004r" then
	
		Dim tItemData, nIndex, sCellBong, szMk

		nCount = CInt( DATAMANAGER.GetDataCount(0,"ohhts_1020_004r", "OutBlock1" ) )	
		if g_szGubun == "1" then '국내
			grdlist0.rowcount = nCount
		elseif g_szGubun == "2" then '해외
		
		else '전체
			grdlist0.rowcount = grdCode.rowcount
		end if 

		nGridRow = 0 
		For i = 0 to grdCode.rowcount - 1
		
			szMm = grdCode.GetCellData("bd_memo", i)
			szCd = grdCode.GetCellData("bd_code", i)
			szMk = grdCode.GetCellData("bd_mk", i)
			korname = grdCode.GetCellData("bd_name", i)			
			szbdGubun = grdCode.GetCellData("bd_gubun", i)
			
			' MTS에서 보여지지 않는 종목은 종목명에 종목코드 보여주기 -> MTS마스터에 없는 종목 보이지 않기 ++ 
			szMk = f_ChkMarket(szMk, szCd)	
			if szbdGubun == "KR" then '국내인 경우
				For j = 0 to nCount-1				
					if g_szGubun == "1" then '국내
						nGridRow = j
					elseif g_szGubun == "2" then '해외
						'로직상 해당사항없음					
					else '전체 
						nGridRow = i					
					end if 
					
					code = DATAMANAGER.GetDataValue( false, "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ISCD" , j )  '종목코드
					if code == szCd and Trim(code) <> "" then	'20230518 HSZ : 빈값체크로직 추가
					
						szMarketNm = f_GetMarketName(szCd)
							
						sclose	= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRPR", j ) '현재가							
						diff		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRDY_VRSS" , j ) '대비
						sign		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN", j ) '대비부호
						rate		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRDY_CTRT", j ) '대비율
						
						yest		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRDY_CLPR", j ) '기준가(전일종가)
						open		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_CPRC", j ) '시가
						high		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_HPRC", j ) '고가
						low		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_LPRC", j ) '저가
						sclose	= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRPR", j ) '종가
						code		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ISCD", j ) '코드
						tvol		= DATAMANAGER.GetDataValue( false,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ACML_VOL", j ) '거래량
						
						sCellBong  = yest & "|" & open & "|" & high & "|" & low & "|" & sclose
						
						grdlist0.SetCellData( "bd_code" , nGridRow, szCd )
						grdlist0.SetCellData( "bd_name" , nGridRow, korname )							
						grdlist0.SetCellData( "bd_hyun" , nGridRow, sclose )	
						grdlist0.SetCellData( "bd_debi" , nGridRow, diff)
						grdlist0.SetCellData( "bd_market" , nGridRow, szMk )
						grdlist0.SetCellData( "bd_mk" , nGridRow, szMk )
						grdlist0.SetCellData( "bd_rate" , nGridRow, rate )							
						grdlist0.SetCellData( "bd_bong" , nGridRow, sCellBong )							
						grdlist0.SetCellData( "bd_vol" , nGridRow, tvol )
						
						grdList0.SetCellData( "bd_market", nGridRow, Trim(szMarketNm) )
						grdList0.SetCellData( "bd_uicode", nGridRow, Trim(szCd))
						
						grdlist0.SetCellData( "bd_gubun", nGridRow, szbdGubun )
						grdlist0.SetCellData( "bd_debiIcon", nGridRow, sign&"|"&diff)							
						
						swapItemColor( nGridRow, CDbl(diff), rate)
					end if 
				Next
				
			    ' MTS에서 보여지지 않는 종목은 종목명에 종목코드 보여주기 -> MTS마스터에 없는 종목 보이지 않기 ++ 
				if Trim(szMk) == "" and Trim(szCd) <> "EMPTY" then
					grdList0.SetCellData("bd_name", i, szCd)
					grdList0.SetCellFgColor("bd_name", i, "127")
				end if				
			else
				if (g_szGubun == "0") then '전체일때
					if szbdGubun <> "OV" then '국내도 해외도 아닌 관심데이터 처리
					'빈칸처리
						if Trim(szMm) <> "" then
							grdList0.SetPropGridCell("memo", "bd_code", i, szMm)
						end if
						if Trim(szCd) == "EMPTY" then							
							grdList0.SetCellData("bd_market", i, szCd)
							grdList0.SetCellFgColor("bd_market", i, "127")	' 글자색_메뉴비활성글자색
						end if 
						grdList0.SetCellData( "bd_gubun", i, szbdGubun )
					end if
				end if 
			end if
		Next		
		
'		' //////////////////////////////////////////////////////////////////
'		
		if (g_szGubun <> "1") then '전체,해외 
			DATAMANAGER.RequestTranData( "ohhts_1030_002r" ) '해외
		else 
			'최대 220 종목만 시세조회가 가능
			if Cint(grdlist0.rowcount) > 220 then
				grdlist0.rowcount = 220
			end if 
			
			grdlist0.keyall = "1"
			' 실시간을 위한 작업 //////////////////////////////////////////////
			For j = 0 to grdMk.rowcount - 1
				szCd = grdMk.GetCellData("bd_code", j)
				szMk = grdMk.GetCellData("bd_mk", j)
				
				if szCd <> "" and szMk <> "" then
					tCode = Split(szCd, "★")
					
					For k = 0 to #tCode-1
						' MTS에서 보여주는 상품의 종목만 선택
						szMk = f_ChkMarket(szMk, tCode(k))
	
						if szMk <> "" then
							Set_Real_Input(szMk, k, tCode(k))
						end if
					Next
					
					Request_RealData(szMk)
				end if
			Next
			' //////////////////////////////////////////////////////////////////			
		end if 	
		
	' ----------------------------------------------------------------------
	' 관심종목 종목데이터 조회 - 해외
	' ----------------------------------------------------------------------		
	elseif szTranID == "ohhts_1030_002r" then	'해외(주간시세)
		Dim tItemData, nIndex, sCellBong, szMk, szKormarket, szOnline, szOfflineName, szOfflinePre, szFlag
		szKormarket = ""
		DATAMANAGER.CancelRealData("ohhts_exst_ictg")
		DATAMANAGER.CancelRealData("ohhts_exst_cntd")	'20230109 HSZ 주간거래 실시간 해제
		
		nCount = CInt( DATAMANAGER.GetDataCount(0,"ohhts_1030_002r", "OutBlock1" ) )
		if g_szGubun == "1" then '국내
		
		elseif g_szGubun == "2" then '해외
			grdlist0.rowcount = nCount
		else '전체
		
		end if 
		
		Dim nRequestCount
		nRequestCount = 0
		'20230109 HSZ START : 주간거래 실시간
		Dim nRequestCount1, nRequestCount2
		nRequestCount1 = 0
		nRequestCount2 = 0
		'20230109 HSZ END

		nGridRow = 0
		For i = 0 to grdCode.rowcount - 1
			szbdGubun = grdCode.GetCellData("bd_gubun", i)
			if szbdGubun == "OV" then '해외인 경우 
			
				szMm = grdCode.GetCellData("bd_memo", i)
				szCd = grdCode.GetCellData("bd_code", i)
				szMk = grdCode.GetCellData("bd_mk", i)
				szOnline = grdCode.GetCellData("bd_online", i)
				szOffLineName = grdCode.GetCellData("bd_name", i)
				szOfflinePre = grdCode.GetCellData("bd_pre", i)
	
				For j = 0 to nCount-1
				
					if g_szGubun == "1" then '국내
						'로직상 해당사항없음
					elseif g_szGubun == "2" then '해외
						nGridRow = j
					else '전체 
						nGridRow = i					
					end if 
					
					'국기아이콘
					grdList0.SetMaintainingRatio( "bd_flag", nGridRow, "1")
					'실시간아이콘					
					grdlist0.SetMaintainingRatio( "bd_realicon", nGridRow, "1")											
					
					code = DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_ISCD" , j ) 
					nDtclose	= Cdbl(DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRPR", j ))	'20230109 HSZ
					
					if szMk == "AX" then
						szKormarket = "아멕스"
						szFlag = "icon_unitedstates.png"
					elseif szMk == "HK" then
						szKormarket = "홍콩"
						szFlag = "icon_hongkong.png"
					elseif szMk == "JP" then
						szKormarket = "도쿄"
						szFlag = "icon_japan.png"							
					elseif szMk == "SZ" then
						szKormarket = "심천"
						szFlag = "icon_china.png"							
					elseif szMk == "SH" then
						szKormarket = "상해"
						szFlag = "icon_china.png"							
					elseif szMk == "NY" then
						szKormarket = "뉴욕"
						szFlag = "icon_unitedstates.png"
					elseif szMk == "OQ" then
						szKormarket = "나스닥"
						szFlag = "icon_unitedstates.png"
					end if					
					
					if code == szCd and Trim(code) <> "" then	'20230518 HSZ : 빈값체크로직 추가
						
						'20230109 HSZ START : 주간시세 적용 분기 구문
						if g_szDaysise = "1" and nDtclose <> 0 then '주간시세 체크O & 주간시세 종목O
							symbol		= szMk
							korname		= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_KOR_ISNM" , j )					
							sDtclose		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRPR", j )
							sclose		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_PRPR", j )
							diff			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRDY_VRSS" , j )
							sign			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRDY_VRSS_SIGN" , j )
							rate			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRDY_CTRT" , j )
							tvol			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_ACML_VOL" , j )
							sdecimal		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DCPN_CNT", j )
							open			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_OPRC" , j )
							high			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_HPRC", j )
							low			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_LPRC", j )
							grdlist0.SetCellData( "bd_hyun" , nGridRow, Decimal_Setting( sDtclose , sdecimal ) )
						else
							symbol		= szMk
							korname		= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_KOR_ISNM" , j )					
							sclose		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_PRPR", j )
							diff			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_VRSS" , j )
							sign			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_VRSS_SIGN" , j )
							rate			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_CTRT" , j )
							tvol			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_ACML_VOL" , j )
							'isvalid		= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "isvalid" , j )
							sdecimal		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DCPN_CNT", j )
							'market		= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "market" , j )
							'orgcode		= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "orgcode" , j )
							'accessibility	= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "accessibility" , j )
			'				realcode		= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "realcode" , j )
							open			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_OPRC" , j )
							high			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_HPRC", j )
							low			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_LPRC", j )
							'pbid			= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "pbid" , j )
							'pask			= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "pask" , j )
							grdlist0.SetCellData( "bd_hyun" , nGridRow, Decimal_Setting( sclose , sdecimal ) )
						end if
						'20230109 HSZ END
						
						sCellBong  = "|" & open & "|" & high & "|" & low & "|" & sclose
						
						grdlist0.SetCellData( "bd_code" ,nGridRow, szMk&"@"&szCd )
						grdlist0.SetCellData( "bd_name" , nGridRow, korname )
	'					grdlist0.SetCellData( "bd_hyun" , nGridRow, Decimal_Setting( sclose , sdecimal ) )	
						grdlist0.SetCellData( "bd_debi" , nGridRow, Decimal_Setting( diff , sdecimal ) )
						grdlist0.SetCellData( "bd_codeSub" , nGridRow, szCd )
						grdlist0.SetCellData( "bd_market" , nGridRow, szKormarket )
						grdlist0.SetCellData( "bd_vol" , nGridRow, tvol )
						grdlist0.SetCellData( "bd_rate" , nGridRow, rate )
						grdlist0.SetCellData( "bd_bong" , nGridRow, sCellBong )
						grdlist0.SetCellData( "bd_decimal", nGridRow, sdecimal )
						grdlist0.SetCellData( "bd_symbol", nGridRow, symbol )
						grdlist0.SetCellData( "bd_mk", nGridRow, szMk )
						grdList0.SetCellData( "bd_uicode", nGridRow, Trim(szCd))								
						grdList0.SetCellData( "bd_flag", nGridRow, szFlag)						
						grdList0.SetMaintainingRatio( "bd_flag", nGridRow, "1")						
						grdList0.SetCellData( "bd_online" , nGridRow, szOnline )
						grdlist0.SetCellData( "bd_gubun", nGridRow, szbdGubun)
						
						swapItemColor( nGridRow, CDbl(diff))
						grdlist0.SetCellData( "bd_debiIcon", nGridRow, sign&"|"&diff)
						
						' 시장별 실시간여부값
						szRealAble = Form.GetSharedData( "REALTIME_"&szMk, false )		
						
						'20230109 HSZ START : 주간거래 실시간 체크 분기처리 추가
						if g_szDaysise = "1" then	'주간거래 실시간 체크 -> 미국장은 주간거래 실시간만 받도록
							if szMk == "AX" or szMk == "NY" or szMk == "OQ" then
								grdlist0.SetCellData( "bd_realicon", nGridRow, "realtime_green" )	'실시간 표시
								DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntd", "InBlock1", "FIDXR_ISCD" , nRequestCount1 , szMk&"@"&szCd)
								nRequestCount1 = nRequestCount1 + 1
							else
								settingRealTime(nGridRow, szRealAble)
								DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , nRequestCount2 , szMk&"@"&szCd)
								nRequestCount2 = nRequestCount2 + 1
							end if
						'20230109 HSZ END
						else
							settingRealTime(nGridRow, szRealAble)
							DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , nRequestCount , szMk&"@"&szCd)
							nRequestCount = nRequestCount + 1								
						end if							
	
					else
						' 오프라인 종목일경우 obsim_stsv_048r 에서 나온 현재가, 종목명 등을 사용
						if szOnline == "N" then
							grdlist0.SetCellData( "bd_code" , i, szMk&"@"&szCd )
							grdlist0.SetCellData( "bd_name" , i, szOffLineName )
							grdlist0.SetCellData( "bd_hyun" , i, szOfflinePre )
							grdlist0.SetCellData( "bd_codeSub" , i, szCd )
							grdlist0.SetCellData( "bd_online" , i, szOnline )
							grdList0.SetCellData( "bd_uicode", i, Trim(szCd))
						end if
					end if
				Next
				
				if Trim(szMk) == "" and Trim(szCd) <> "EMPTY" then
					grdList0.SetCellData("bd_name", i, szCd)
					grdList0.SetCellFgColor("bd_name", i, "127")
				end if						
			end if 
		Next
		grdlist0.keyall = "1"
		
		'최대 220 종목만 시세조회가 가능
		if Cint(grdlist0.rowcount) > 220 then
			grdlist0.rowcount = 220
		end if 
		
		' 실시간을 위한 작업 ////////////////////////////////////////////// 
		'전체, 해외
		For j = 0 to grdMk.rowcount - 1
			szCd = grdMk.GetCellData("bd_code", j)
			szMk = grdMk.GetCellData("bd_mk", j)

			if szCd <> "" and szMk <> "" then
				tCode = Split(szCd, "★")
				
				For k = 0 to #tCode-1
					' MTS에서 보여주는 상품의 종목만 선택
					szMk = f_ChkMarket(szMk, tCode(k))

					if szMk <> "" then
						Set_Real_Input(szMk, k, tCode(k))
					end if
				Next
				
				Request_RealData(szMk)
			end if
		Next
		
	end if
End Sub
	
'============================================================================
' grdList0_OnClickUp : 현재가 그리드 클릭
'============================================================================
Sub grdList0_OnClickUp(lRow, szCellID)
	szCd = grdList0.GetCellData("bd_code", lRow)
	
	if Trim(szCd) == "" then
		Exit Sub
	end if
	
	'아이템코드 컨트롤에 박아주기 이호철
	Form.SetCtlProp( "ItemCode0", "code", szCd )
	
	
	' 사이드메뉴에서만 사용 ////////////////////////////////////////////////
	Form.SetItemCode(szCd)	
	
	Form.triggerEvent("#", "CLOSE_FORM", "")
	' /////////////////////////////////////////////////////////////////////
End Sub

'============================================================================
Function SetNoticeMsg()
	'종목없음 안내메시지처리
'	if g_szRSelect == "1" then
'		nCnt = grdlist1.rowcount
'	elseif g_szRSelect == "2" then
'		nCnt = grdlist2.rowcount
'	else
'		nCnt = grdlist0.rowcount
'	end if
	nCnt = grdCode.rowcount
	if CStr(nCnt) == "" or CStr(nCnt) = "00000"or CStr(nCnt) = "0" then
	
		lbNoticeMsg.caption = "Waching 등록된 종목이 없어요."

		imgNotice.left = 143
		lbNoticeMsg.left =58 				
		imgNotice.visible = true
		lbNoticeMsg.visible = true 
		grdList0.visible = false
	else
		imgNotice.left = 643
		lbNoticeMsg.left = 558 				
		imgNotice.visible = false
		lbNoticeMsg.visible = false 					
