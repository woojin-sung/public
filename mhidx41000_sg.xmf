'============================================================================
'20210916 SWJ START
'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	if nCurrentTab = 0 then
		Img0.imgpath = "icon_dot_on.png"
		Img1.imgpath = "icon_dot_off.png"
		Img2.imgpath = "icon_dot_off.png"
		Img3.imgpath = "icon_dot_off.png"
		
		Form.triggerEvent("#", "PageChange", "0")
		
	elseif nCurrentTab = 1 then
		Img0.imgpath = "icon_dot_off.png"
		Img1.imgpath = "icon_dot_on.png"
		Img2.imgpath = "icon_dot_off.png"
		Img3.imgpath = "icon_dot_off.png"
		
		Form.triggerEvent("#", "PageChange", "1")
		
	elseif nCurrentTab = 2 then
		Img0.imgpath = "icon_dot_off.png"
		Img1.imgpath = "icon_dot_off.png"
		Img2.imgpath = "icon_dot_on.png"
		Img3.imgpath = "icon_dot_off.png"
		
		Form.triggerEvent("#", "PageChange", "2")
		
	elseif nCurrentTab = 3 then
		Img0.imgpath = "icon_dot_off.png"
		Img1.imgpath = "icon_dot_off.png"
		Img2.imgpath = "icon_dot_off.png"
		Img3.imgpath = "icon_dot_on.png"
		
		Form.triggerEvent("#", "PageChange", "3")
	
		
	end if
End Sub
'============================================================================
Sub Form_OnFormInit()
	FormTab0_OnTabChanged(0)
End Sub

