'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


	Dim g_szAccountNumber	'출금계좌번호
	Dim g_szAccountSerialNumber	'출금계좌일련번호
	Dim g_szBankName	'은행이름
	Dim g_szBankCode	'은행코드
	Dim g_szSendAccount	'입금계좌번호
	Dim g_szDay	'납기일
	Dim g_szMoney	'출금액
	Dim g_szJumin	'주민번호	
	Dim g_szStart	'시작월
	Dim g_szEnd	'만기월
	Dim g_szFee	'수수료
	Dim g_szAccountPassword	'비밀번호
	Dim g_szSendAccountName	'입금자이름
	Dim g_szSendAccountNick	'입금자통장에표시
	Dim g_szAccountName	'출금계좌이름
	Dim g_szAccountNick	'내통장표시
	Dim g_szPlusUI ' 추가인증여부
	Dim g_szCertUserType
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Function TR_Inquiry(szTranID)
	if szTranID == "obcsb_oimf_625r" THEN		'보안매체확인
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		sACNO = g_szAccountNumber
		sACNO_PWD = g_szAccountPassword
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
		DATAMANAGER.RequestTranData("obcsb_oimf_625r")
	end if
	
	if szTranID == "obtss_igrs_683c" then	'등록
		DATAMANAGER.SetEventFlag( "obtss_igrs_683c", "I" )
	
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "DRNG_TRGT_ACNO", 0 , g_szAccountNumber & g_szAccountSerialNumber)	'출금계좌번호
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "RCVN_EXIN_CODE", 0 , g_szBankCode)	'은행코드
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "RCVN_ACNO", 0 , g_szSendAccount)	'수취계좌번호
		'Form.ShowAlert("g_szDay", g_szDay)
		if g_szDay == "0말일" then
			g_szDay = "31"
		end if
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "TMPY_DAY", 0 , g_szDay)	'납기일
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "AMT", 0 , g_szMoney)	'금액
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "RSDS_BSMN_CORP_RGNO", 0 , g_szJumin)	'주민번호
		' 내통장표시와 받는분통장표시 오류수정
		'DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "ACHO_NAME", 0 , g_szAccountNick)	'내통장표시
		'DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "MNRC_ISTU_ACHO_NAME", 0 , g_szSendAccountNick)	'받는분통장표시
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "ACHO_NAME", 0 , g_szSendAccountNick)	'받는분통장표시
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "MNRC_ISTU_ACHO_NAME", 0 , g_szAccountNick)	'내통장표시
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "ACNO_REAL_ACHO_NAME", 0 , g_szAccountName)	'계쫘예금주
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "OTCO_ACNT_REAL_ACHO_NAME", 0 , g_szSendAccountName)	'타사예금주
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "STA_YYMM", 0 , Mid(g_szStart, 1, 6))	'시작
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "FIN_YYMM", 0 , Mid(g_szEnd, 1, 6))	'종료
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "APLT_PRD", 0 , "5")	'신청기간
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "FEE", 0 , g_szFee)	'수수료
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "PWD", 0 , g_szAccountPassword)	'비밀번호
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock1", "AGRM_RQCL_DOCU_CLCD" , 0 , Form.GetSharedData("mbbnk61040_AGRM_CLCD", True)) 'v002
	
		DATAMANAGER.RequestTranData("obtss_igrs_683c")
		
	elseif szTranID == "obpds_srvc_035a" then	'당사 등록
		' 말일등록 시 오류수정 2017.01.31 CIK
		'if g_szDay == "말일" then
		'	g_szDay = "31"
		'end if
		
		'if CInt(g_szDay) < 10 then
		'	g_szDay = "0"..g_szDay
		'end if
		
		' 말일등록 시 오류수정 2017.01.31 CIK
		'if g_szDay == "0말일" then
		'	g_szDay = "31"
		'end if
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "PROS_CLS_CODE", 0 , "I")	'처리구분코드	
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "CSNO", 0 , "")	'고객번호	
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "SVCD", 0 , "013")	'서비스 코드	
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "SVC_MANG_UNIT_CODE", 0 , "03")	'상품단위
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "ACNO", 0, g_szAccountNumber)	'계좌번호	
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "ASNO", 0 , g_szAccountSerialNumber)	'일련번호	
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "ACNT_PWD", 0 , g_szAccountPassword)	'비밀번호
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "TACT_ACNT_CLS_CODE", 0 , "1")	'이체구분코드	
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "TACT_SCRT_ACNO", 0 , Mid(g_szSendAccount,1,8))	'이체증권계좌번호	
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "TACT_SCRT_ASNO", 0 , Mid(g_szSendAccount,9.2))	'이체증권계좌일련번호
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "TACT_AMT", 0 , g_szMoney)	'이체금액
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "TACT_HOPE_DAY_CODE", 0 ,g_szDay)	'이체희망일코드
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "NXET_TIMS_ATMT_APLT_YN", 0 , "N")	'다음회차자동신청여부
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "TACT_STA_DATE", 0 , Mid(g_szStart, 1, 6)&"01")	
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "TACT_FIN_DATE", 0 , Mid(g_szEnd, 1, 6)&"31")			
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "MNRC_ACNT_BNKB_EXRS_CNTT", 0 , g_szSendAccountNick)	'받는분통장표시
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "DRNG_ACNT_BNKB_EXRS_CNTT", 0 , g_szAccountNick)	'내통장표시
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "CONT_CLS_CODE", 0 , "4")	'온라인
		
		DATAMANAGER.RequestTranData("obpds_srvc_035a")		
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' imgClose_OnClick
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
' btnCancel_OnClick - 취소
'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
' btnEnroll_OnClick - 등록
'============================================================================
Sub btnEnroll_OnClick()
	'확인정보로 등록
	'추가인증-> 보안매체-> 공인인증 순으로 처리 후 완료되었다는 메세지 띄우고 종료
	'TR_Inquiry("obtss_igrs_683c")
	
	if g_szCertUserType == "1" then
		TR_Inquiry("obcsb_oimf_625r")
		'Form.OpenPopup("mhetc90060_px", "", "")
	elseif g_szPlusUI == "Y" then
		'if CInt(g_szDay) < 10 then
		'	g_szDay = "0"..g_szDay
		'end if
		Form.SetSharedData("CERT_ACNO" , g_szAccountNumber)
		Form.SetSharedData("BANK_ACNONM" , g_szSendAccountName)
		Form.SetSharedData("BANK_AMT" , g_szMoney)
		Form.SetSharedData("BANK_CODE" , g_szBankCode)
		Form.SetSharedData("BANK_NAME" , g_szBankName)
		Form.SetSharedData("BANK_FROMYM" , Left(g_szStart,6)..g_szDay)
		Form.SetSharedData("BANK_TOYM" , Left(g_szEnd,6)..g_szDay)
		
		Form.OpenFramePopup("mhetc90060_p8" , "bank_monthly" , "")
	else	
		TR_Inquiry("obcsb_oimf_625r")
	end if
End Sub



'============================================================================
' Form_OnPopupReturn 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p8" then	'추가인증 
		if sRet == "ok" then	'추가인증성공
			TR_Inquiry("obcsb_oimf_625r")
		else
			exit sub
		end if
	end if
	
	
	if sKeyName == "mhetc90060_p9" then	'보안카드(보안매체1)
		if sRet == "ok" then			'성공
			if g_szCertUserType == "1" Then
				Form.OpenFramePopup("mhetc90060_px" , "" , "")
			else
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
			end if
			'Form.OpenFramePopup("mhetc90060_p5" , "" , "")			
		else 					'실패
			exit sub
		end if	
	end if
	
	
	if sKeyName == "mhetc90060_pa" then	'부가정보인증
		if sRet == "ok" then			'성공
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else 					'실패
			exit sub
		end if
	end if
	
	
	if sKeyName == "mhetc90060_pb" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
			if g_szCertUserType == "1" Then
				Form.OpenFramePopup("mhetc90060_px" , "" , "")
			else
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
			end if
			'Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else						'실패		
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_motp" then	'v003 mOTP
		if sRet == "ok" then			'성공
			if g_szCertUserType == "1" Then
				Form.OpenFramePopup("mhetc90060_px" , "" , "")
			else
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
			end if
			'Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else						'실패		
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			if g_szBankCode == "287" then
				TR_Inquiry("obpds_srvc_035a")
			else
				TR_Inquiry("obtss_igrs_683c")
			end if	
		else						'실패
			exit sub
		end if
		
	end if
	
	If sKeyName == "mhetc90060_px" Then
		If sRet == "ok" Then
			if g_szBankCode == "287" then
				TR_Inquiry("obpds_srvc_035a")
			else
				TR_Inquiry("obtss_igrs_683c")
			end if
		ElseIf sRet == "cancel" Then
			'Form.ShowAlert("알림", "간편인증 실패.")
		End If
	End If
	
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
'	if sKeyName == "mhetc90190_p1" then										
'		'if sRet == "ok" then									
'		'end if
'	end if 	
End Sub


'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szData, szList
	
	g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
	szData = Form.GetOpenLinkData()
	
	szList = Split(szData, "★")
	
	if UBOUND(szList) < 1 THEN
		EXIT SUB
	END IF
	
	'Form.ShowAlert("szData", szData)
	g_szAccountNumber = szList(0)	'출금계좌번호
	g_szAccountSerialNumber = szList(1)	'출금계좌일련번호
	g_szBankName = szList(2)	'은행이름
	g_szBankCode = szList(3)	'은행코드
	g_szSendAccount = szList(4)	'입금계좌번호
	g_szDay = szList(5)	'납기일
	g_szMoney = szList(6)	'출금액
	g_szJumin = szList(7)	'주민번호	
	g_szStart = szList(8)	'시작월
	g_szEnd = szList(9)	'만기월
	g_szFee = szList(10)	'수수료
	g_szAccountPassword = szList(11)	'비밀번호
	
	'Trim(cont01.edtAcnt01.caption) & "★" & Trim(cont01.edtOutAcnt01.caption) & "★" & Trim(g_szAccountName) & "★" & Trim(cont01.edtShow01.caption)
	g_szSendAccountName = szList(12)	'입금자이름(입금계좌명)
	g_szSendAccountNick = szList(13)	'입금자통장에표시(받는분통장표시)
	g_szAccountName = szList(14)	'출금계좌이름(출금계쫘명)
	g_szAccountNick = szList(15)	'내통장표시
	g_szPlusUI =  szList(16)	'추가인증
	'(타사계좌실예금주명(입금계좌명)/ 예금주명(받는분통장표시)/계좌번호실예금주명(출금계좌명)/입금기관예금주명(내통장표시))
	for i=0 to 7
		Table0.SetCellString( i, 1, "" )	'테이블 clear
	next
	
	IF g_szBankCode = "287" THEN
		Table0.SetCellString( 7, 0, "" )
		Table0.SetCellString( 7, 1, "" )
		Table0.SetCellString( 7, 2, "" )
		Table0.SetCellString( 8, 0, "" )
		Table0.SetCellString( 8, 1, "" )
		Table0.SetCellString( 8, 2, "" )
	END IF
	
	Table0.SetCellString( 0, 1, g_szDay )	'지정일
	Table0.SetCellString( 1, 1, Left(g_szStart, 4).."/"..Mid(g_szStart, 5, 2) & " ~ " & Left(g_szEnd, 4).."/"..Mid(g_szEnd, 5, 2))	'이체기간
	Table0.SetCellString( 2, 1, Left(g_szAccountNumber, 4).."-"..Mid(g_szAccountNumber, 5, 4) & "-" & g_szAccountSerialNumber)	'출금계좌
	Table0.SetCellString( 3, 1, g_szBankName & "/" & g_szSendAccount)	'입금은행/계좌
	Table0.SetCellString( 4, 1, g_szSendAccountName )	'받는분
	Table0.SetCellString( 5, 1, g_szSendAccountNick )	'받는분통장표시
	Table0.SetCellString( 6, 1, tonumber(g_szMoney) )	'이체금액(수수료)
	Table0.SetCellString( 6, 2, tonumber(g_szFee) )	'받는분통장표시
	
	' 말일로 선택한 경우 "31"로 수정하여 등록처리 2017.02.01 CIK
	if g_szDay == "말일" then
		g_szDay = "31"
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_625r" then
		Dim sSPLM_ATHN_NCSR_YN, g_sGubunCode
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
'				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
				Form.ShowAlert( "알림", "부가정보만 존재할경우 처리가 불가능합니다.")
				Form.SendReturnToParent( "Clear" , sData)
				Form.CloseForm( )
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			Case "4" 'v001 mOTP
				Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "" )
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	end if
	
	if szTranID == "obtss_igrs_683c" or  szTranID == "obpds_srvc_035a" then	'등록성공
		Form.MsgBox("알림", "자동이체가 정상적으로 등록 되었습니다.", "", 0)
		Form.SendReturnToParent( "Clear" , sData)
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtss_igrs_683c" or  szTranID == "obpds_srvc_035a" then	
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		if sSubMsg <> null and Trim(sSubMsg) <> "" then
			szErrMsg = szErrMsg & " " & sSubMsg
		end if
		Form.MsgBox("알림", szErrMsg, "", 0)
		Form.SendReturnToParent( "Clear" , sData)
		Form.CloseForm()
	end if
End Sub

'============================================================================
'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
'============================================================================
Sub RegisterOTP()
	'계좌번호★주민번호(필수아님)★Y/N( 모바일OTP/타기관OTP 발급 완료 후 인증 처리 진행여부를 판단함)★Y/N(처리 완료시 화면닫기)	
	Form.OpenPopup("mhetc90190_p1", g_szAccountNumber &"★"& "" &"★"& "N" &"★"& "Y", "")	
End Sub

