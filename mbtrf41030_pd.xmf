'============================================================================
' 화 면 명 : 선물옵션주문_주문가능팝업
' 화면설명 : 선물옵션주문에서 상단연결팝업에서 주문가능 선택시 오픈
' 작    성 : 2016.02.12 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_szCd, g_szMk
Dim g_szTitle
g_szTitle = "알림"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
' Init_Table
'============================================================================
Sub Init_Table()
	tblData.SetCellString(1, 1, "")
	tblData.SetCellString(1, 2, "")
	tblData.SetCellString(1, 3, "")
	tblData.SetCellString(2, 1, "")
	tblData.SetCellString(2, 2, "")
	tblData.SetCellString(2, 3, "")
End Sub


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	Dim tData

	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")

	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)
		g_szCd     = "K" & tData(2)
		g_szMk 	  = Form.GetItemCodeInfo(tData(2), "market_night")
	     
		if g_szMk = "EM" or g_szMk = "EO" or g_szMk = "EW" Then '20220311 HSZ 위클리옵션 추가
			cmbType.clear = true
			cmbType.cbinputdatatext = "2`보통\r\n1`시장가"
		Else
			cmbType.clear = true
			cmbType.cbinputdatatext = "2`보통"
		End If
	     
		lblPrc.caption = tData(3)
		
		if CStr(cmbType.currentindex) == "0" or CStr(cmbType.currentindex) == "2" then
			edtPrc.caption = tData(3)
		end if
		
		Init_Table()
		DATAMANAGER.RequestTranData("obtrf_cntg_810r")
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 선물옵션주문가능수량
	' ----------------------------------------------------------------------	
	if szTranID = "obtrf_cntg_810r" then	 
		DATAMANAGER.ClearInputData(0, "obtrf_cntg_810r")

		DATAMANAGER.SetDataValue(0, "obtrf_cntg_810r", "InBlock1", "ACNO",           0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_810r", "InBlock1", "ASNO",           0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_810r", "InBlock1", "ISCD",           0, g_szCd)
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_810r", "InBlock1", "ASPR_TYPE_CODE", 0, cmbType.cbkeydata)
		DATAMANAGER.SetDataValue(0, "obtrf_cntg_810r", "InBlock1", "FTOP_ODER_UNPR", 0, edtPrc.caption)
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if
End Sub

'============================================================================
' btnInquiry_OnClick
'============================================================================
Sub btnInquiry_OnClick()
	Init_Table()
	DATAMANAGER.RequestTranData("obtrf_cntg_810r")
End Sub


'============================================================================
' imgClose_OnClick : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnClose_OnClick : 닫기
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()	
End Sub


'============================================================================
Sub cmbType_OnEditComplete(iIndex)
	if iIndex == 1 or iIndex == 3 then
		edtPrc.enable = false
		edtPrc.caption = ""
	else
		edtPrc.enable = true
	end if
End Sub

