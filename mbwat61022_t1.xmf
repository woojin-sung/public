	<SCRIPT_INFO _len="24684" _ulen="23164" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Wrap 계약정보 변경
' 02. 화면설명 : 
' 03. 이    력 : 2022.10.21 : 고승연 : v0001 : 신규개발
'                2023.01.05 : 고승연 : v0002 : [T2301130023] 비밀번호 체크 수정
'                2023.11.10 : 고승연 : v0003 : 상품위험등급 구분 변경, obwat_pdad_065r IO 수정
'                2024.01.19 : 고승연 : v0004 : 최소가입금액 폰트 크기 수정
'                2024.03.26 : 고승연 : v0005 : [T2402290007] obwat_pdad_065r IO 수정
'-------------------------------------------------------------------------------------------

Dim g_szWA_PRCD, g_szMinAmt, g_nMinMncn
Dim g_sJoinSrno
Dim g_sInagTypeCode, g_sInagSrno
Dim g_bInit
Dim g_sCsno, g_sAcno, g_sAsno
Dim g_sAcnoDeposit, g_sAsnoDeposit
Dim g_bImpossible, g_sImpossibleData

Dim mbonl84040_RETRN_VAL
Dim mbonl84040_RETRN_ACNO

'============================================================================
Sub Form_OnFormInitBefore()
	ImageStep0.setMaintainingRatio("1")
'	contStep1.edtPwdBg.setMaintainingRatio("1")
	contStep1.Image110.setMaintainingRatio("1")
	contStep1.Image111.setMaintainingRatio("1")
	contStep1.Image112.setMaintainingRatio("1")
	contStep1.Image113.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "Code" then 'Step1시작
		if sParam <> "null" and sParam <> "" then
			contStep1.cmbAcnt.clear = true

			g_szWA_PRCD = sParam '상품코드
			
			g_sCsno = Form.GetSharedData("&CUST_NUM", false)
			
			DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1" )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "CSNO" , 0 , g_sCsno )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "WA_PRCD" , 0 , g_szWA_PRCD )
			DATAMANAGER.RequestTranData( "obwat_onln_004r" )
		end if
		
	elseif sEventName == "AGREE_PAY" then '보수확인
		if sParam == "0" then
			btnNext.enable = false
		elseif sParam == "1" then
			btnNext.enable = true
		end if
		
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				contStep1.edtPwd.pwdlen = tData(1)
				contStep1.edtPwd.caption = tData(0)
				
				contStep1.btnAlpha0.visible = false
				contStep1.btnAlpha1.visible = false
				contStep1.btnAlpha2.visible = false
				contStep1.btnAlpha3.visible = false
				contStep1.btnAlpha4.visible = false
				contStep1.btnAlpha5.visible = false
				
				if g_bInit then
					DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "ACNO" , 0 , g_sAcno )
					DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "ASNO" , 0 , g_sAsno )
					DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "WA_PRCD" , 0 , g_szWA_PRCD )
					DATAMANAGER.RequestTranData( "obwat_onln_003r" )
				else
					Form.OpenPopup("mbwat61022_p1" , g_sJoinSrno.."|"..g_sAcno.."|"..g_sAsno , "") '투자자금원금보전확인 동의
'					DATAMANAGER.RequestTranData( "obsap_acif_999a" )
				end if
			end if
		end if 
		
	elseif sKeyName == "AGREE" then '투자자금원금보전확인 동의
		if sRet == "N" then
			DATAMANAGER.RequestTranData( "obwat_onln_001r" )
			f_ShowPay() ' 보수확인 보임
		elseif sRet == "Y" then
			Dim sTitle, sText
			sTitle = "원금보존 위험상품 안내"
			sText = "고객님은 금융투자자금 원금보존을 선택하였습니다. Wrap상품은 위험등급 4등급이상으로 투자자보호를 위해 Wrap가입이 제한됩니다."
			Form.MsgBox(sTitle, sText, "AGREE", 8, "확인", "")
		end if
		
	elseif sKeyName == "POPUP_PAPER" then '계약서류보고서 수령처
		if sRet <> "null" and sRet <> "" then
			tData = Split(sRet, "|")
			
			if Len(Trim(tData(4))) > 0 then
				contStep1.lblPaper.visible = false
				contStep1.cmbPaper.cbkeydata = tData(1)
				g_sInagTypeCode = tData(2)
				g_sInagSrno = tData(3)
				f_ShowPay() ' 보수확인 보임
			else
				Form.ShowAlert("계약서 수령처", Trim(tData(0)) .. " 주소 등록후 선택해주세요." )
			end if
		end if
		
	elseif sKeyName == "POPUP_REPORT" then '투자일임보고서 수령처
		if sRet <> "null" and sRet <> "" then
			tData = Split(sRet, "|")
			
			if Len(Trim(tData(2))) > 0 then
				contStep1.lblReport.visible = false
				contStep1.lblReport.visible = false
				contStep1.cmbReport.cbkeydata = tData(1)
				f_ShowPay() ' 보수확인 보임
			else
				Form.ShowAlert("보고서 수령처", Trim(tData(0)) .. " 주소 등록후 선택해주세요." )
			end if
		end if
		
	elseif sKeyName == "impossible" then '계좌변경시 진행 불가
		if g_bImpossible then 'Deposit계좌에 종합매매orCMA계좌 없는 경우 상품라인업이동
			Form.OpenScreen("57020", "")
		else
			g_bImpossible = true
		end if
	
	elseif sKeyName == "WRAP_MBWAT61020_P9" then
		Form.OpenPopup("mbonl84040", contStep1.cmbAcnt.cbkeydata, "")
	
	elseif sKeyName == "mbonl84040_COMPLETE" or sKeyName == "mbonl84040_END_PROCESS" then
		mbonl84040_RETRN_VAL		= sKeyName
		mbonl84040_RETRN_ACNO		= sRet
		g_bImpossible 			= false
		contStep1.cmbAcnt.clear	= true
		
		DATAMANAGER.SetDataValue(false, "obwat_onln_004r", "InBlock1", "IQRY_CLS_CODE",	0, "1")
		DATAMANAGER.SetDataValue(false, "obwat_onln_004r", "InBlock1", "CSNO", 			0, g_sCsno)
		DATAMANAGER.SetDataValue(false, "obwat_onln_004r", "InBlock1", "WA_PRCD", 		0, g_szWA_PRCD)
		DATAMANAGER.RequestTranData("obwat_onln_004r")
	end if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "AGREE" then
		Form.triggerEvent("#", "CLOSEFORM", "")
	end if
End Sub

'============================================================================
Sub contStep1_edtMinAmt_OnEditComplete()
	if contStep1.edtMinAmt.caption == "" then
		contStep1.edtMinAmt.hintcaption = "최소"..FormatNumber( g_szMinAmt , 0 ).."원"
	elseif CInt(contStep1.edtMinAmt.caption) < CInt(g_szMinAmt) then
		Form.MsgBox("알림", "최소 가입금액을 확인해주세요.", "", 8, "확인", "")
	else
		f_ShowPay() ' 보수확인 보임
	end if
End Sub

'============================================================================
Sub contStep1_edtMinTerm_OnEditComplete()
	if contStep1.edtMinTerm.caption == "" then
		contStep1.edtMinTerm.hintcaption = g_nMinMncn.." 개월"
	elseif CInt(contStep1.edtMinTerm.caption) <> g_nMinMncn then
		Form.MsgBox("알림", g_nMinMncn.."개월(기본 계약기간)로\n입력해 주세요.", "", 8, "확인", "")
	else
		f_ShowPay() ' 보수확인 보임
	end if
End Sub

'============================================================================
Sub contStep1_cmbExtention_OnEditComplete(iIndex)
	contStep1.lblExtention.visible = false
	
	f_ShowPay() ' 보수확인 보임
End Sub

'============================================================================
Sub contStep1_btnReport_OnClick()
	if contStep1.edtPwd.caption <> "" then
		Dim sPlain_rm, sData
		sPlain_rm = Form.GetSharedData("&PLAIN_RM", false)
		sData = g_sAcno.."|"
		
		if sPlain_rm == "1" then 'MTS메모리평문 적용상태일때
			sData = sData..contStep1.edtPwd.caption
		else 'MTS메모리평문 미적용상태일때
			sData = sData..Form.GetEncData(contStep1.edtPwd.caption)
		end if
		
		Form.OpenPopupAnimation("mbwat61022_p9" , sData ,"POPUP_REPORT","2")
	else
		Form.MsgBox("알림", "계좌비밀번호를 확인해주세요.", "", 8, "확인", "")
	end if
End Sub

'============================================================================
Sub contStep1_btnPaper_OnClick()
	if contStep1.edtPwd.caption <> "" then
		Dim sPlain_rm, sData
		sPlain_rm = Form.GetSharedData("&PLAIN_RM", false)
		sData = g_sAcno.."|"
		
		if sPlain_rm == "1" then 'MTS메모리평문 적용상태일때
			sData = sData..contStep1.edtPwd.caption
		else 'MTS메모리평문 미적용상태일때
			sData = sData..Form.GetEncData(contStep1.edtPwd.caption)
		end if
		
		Form.OpenPopupAnimation("mbwat61022_p2" ,  sData ,"POPUP_PAPER","2")
	else
		Form.MsgBox("알림", "계좌비밀번호를 확인해주세요.", "", 8, "확인", "")
	end if
End Sub

'============================================================================
Sub contStep1_acntDepositAcnt_ChangeAccount()
	contStep1.lblDepositAcnt.visible = false
	
	f_ShowPay() ' 보수확인 보임
End Sub

' 보수확인 보임
'============================================================================
Sub f_ShowPay()
	if (payCheck()) then
		Form.SetSharedData("WA_PRCD" , g_szWA_PRCD)
		contStep1.lnkFormPay.visible = true
		contStep1.lnkFormPay.linkfile = "mbwat61022_t11"
		contStep1.SetScrollAutoSize()
		contStep1.scroll_pos = contStep1.lnkFormPay.top
		
		btnNext.visible = true
	end if
End Sub

' 보수확인 보임확인체크
'============================================================================
Function payCheck()
	Dim bFlag
	bFlag = false
	
	if contStep1.edtPwd.caption <> "" and contStep1.edtMinAmt.caption <> "" and
		contStep1.edtMinTerm.caption <> "" and
		(contStep1.lblExtention.visible == "0" or contStep1.lblExtention.visible == 0 or contStep1.lblExtention.visible == "false" or contStep1.lblExtention.visible == false) and
		(contStep1.lblReport.visible == "0" or contStep1.lblReport.visible == 0 or contStep1.lblReport.visible == "false" or contStep1.lblReport.visible == false) and
		(contStep1.lblPaper.visible == "0" or contStep1.lblPaper.visible == 0 or contStep1.lblPaper.visible == "false" or contStep1.lblPaper.visible == false) and
		(contStep1.lblDepositAcnt.visible == "0" or contStep1.lblDepositAcnt.visible == 0 or contStep1.lblDepositAcnt.visible == "false" or contStep1.lblDepositAcnt.visible == false) then
		bFlag = true
	end if
	
	payCheck = bFlag
End Function

' 다음
'============================================================================
Sub btnNext_OnClick()
	if g_bImpossible then
		Form.OpenPopup("mbwat61020_p9", g_sImpossibleData, "")
	elseif contStep1.edtPwd.caption == "" then
		Form.MsgBox("알림", "계좌비밀번호를 확인해주세요.", "", 8, "확인", "")
	elseif CInt(contStep1.edtMinAmt.caption) < CInt(g_szMinAmt) then
		Form.MsgBox("알림", "최소 가입금액을 확인해주세요.", "", 8, "확인", "")
	elseif CInt(contStep1.edtMinTerm.caption) <> g_nMinMncn then
		Form.MsgBox("알림", g_nMinMncn.."개월(기본 계약기간)로\n입력해 주세요.", "", 8, "확인", "")
	else
		DATAMANAGER.RequestTranData( "obcsb_acad_122a" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obwat_csad_003r" then
		DATAMANAGER.SetDataValue( 0, "obwat_csad_003r", "InBlock1", "WA_PRCD" , 0 , g_szWA_PRCD )
		DATAMANAGER.SetDataValue( 0, "obwat_csad_003r", "InBlock1", "PROS_CLS_CODE" , 0 , "2" )
		
	elseif szTranID == "obwat_onln_001r" then
		DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "ACNO" , 0 , g_sAcno )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "BSWR_CLCD" , 0 , "01" ) '랩계좌 01
	
	elseif szTranID == "obcsb_acad_122a" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_122a", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_122a", "InBlock1", "FNPR_JOIN_SRNO" , 0 , g_sJoinSrno )
		
		if contStep1.cmbPaper.cbkeydata == "05" then '문자/알림톡
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE" , 0 , "04" )
		elseif contStep1.cmbPaper.cbkeydata == "04" then '이메일
			DATAMANAGER.SetDataValue( 0, "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE" , 0 , "02" )
		end if
		
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE" , 0 , g_sInagTypeCode )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_122a", "InBlock1", "INAG_SRNO" , 0 , g_sInagSrno )
		
	elseif szTranID == "obwat_onln_002a" then
		Dim sToday
		sToday = Form.GetSharedData("&HOST_DATE", false)
		
		DATAMANAGER.SetEventFlag( "obwat_onln_002a", "I" )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "NMET_APLT_DATE" , 0 , sToday )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "PRGS_STAT_CODE" , 0 , "01" ) '1step 01
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "BSWR_CLCD" , 0 , "01" ) '랩계좌 01
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "ACNO" , 0 , g_sAcno )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "ASNO" , 0 , g_sAsno )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "ISCD" , 0 , g_szWA_PRCD )
		
		Dim sData
		sData = contStep1.edtMinAmt.caption.."|"..contStep1.edtMinTerm.caption.."|"
		sData = sData..contStep1.cmbExtention.cbkeydata.."|"
		sData = sData..contStep1.cmbReport.cbkeydata.."|"
		sData = sData..contStep1.cmbPaper.cbkeydata.."|"
		sData = sData..Left(contStep1.cmbAcntDeposit.cbkeydata, 8).."|"..Right(contStep1.cmbAcntDeposit.cbkeydata, 2).."|"
		sData = sData..g_sJoinSrno
		
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "SVC_DTL_CNTT1" , 0 , sData )
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_onln_004r" then
		Dim nCount, idx
		nCount = DATAMANAGER.GetDataCount( 0, "obwat_onln_004r", "OutBlock1" )
		idx = 0
		
		if nCount > 0 then
			for i = 0 to nCount-1
				Dim sAcnt, sAsno, sPrcd, sPrcdName
				sAcnt = DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "ACNO" , i )
				sAsno = DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "ASNO" , i )
				sPrcd = DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "PRCD" , i )
				sCsnm = DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "CSNM" , i )
				
				if sPrcd = "100" Then
					sPrcdName = "[종합매매] "
				elseif sPrcd = "118" Then
					sPrcdName = "[CMA] "
				elseif sPrcd = "119" Then
					sPrcdName = "[랩종합] "
				else
					sPrcdName = ""
				end if
				
				contStep1.cmbAcnt.cbadddatatext = sAcnt..sAsno.."`"..sPrcdName..mid(sAcnt, 1, 4).."-"..mid(sAcnt, 5, 4).."-"..sAsno.." "..sCsnm
				
				if mbonl84040_RETRN_VAL == "mbonl84040_END_PROCESS" then
				
					if mbonl84040_RETRN_ACNO == sAcnt..sAsno then
						idx = i
					end if
					
				end if
				
			next

			if mbonl84040_RETRN_VAL == "mbonl84040_END_PROCESS" then
				contStep1.cmbAcnt.currentindex	= idx
			
				DATAMANAGER.RequestTranData("obwat_csad_003r")
			else
				contStep1.acnt.caption = contStep1.cmbAcnt.cbkeydata
	
				g_sAcno = Left(contStep1.cmbAcnt.cbkeydata, 8)
				g_sAsno = Right(contStep1.cmbAcnt.cbkeydata, 2)
			
				DATAMANAGER.RequestTranData( "obwat_csad_003r" )
				
				' 입금받을 계좌 조회
				DATAMANAGER.SetDataValue(0, "obwat_onln_004r_1", "InBlock1", "IQRY_CLS_CODE",		0, "3")
				DATAMANAGER.SetDataValue(0, "obwat_onln_004r_1", "InBlock1", "CSNO",				0, g_sCsno)
				DATAMANAGER.SetDataValue(0, "obwat_onln_004r_1", "InBlock1", "ACNO",				0, g_sAcno)
				DATAMANAGER.SetDataValue(0, "obwat_onln_004r_1", "InBlock1", "WA_PRCD",			0, g_szWA_PRCD)
				DATAMANAGER.RequestTranData( "obwat_onln_004r_1" )
			end if
			
			mbonl84040_RETRN_VAL = ""
		else
			contStep1.lblAcntNodata.visible = true
		end if
		
	elseif szTranID == "obwat_onln_004r_1" then
		Dim nCount, bImpossible
		nCount = DATAMANAGER.GetDataCount( 0, "obwat_onln_004r_1", "OutBlock1" )
		bImpossible = true
		
		contStep1.cmbAcntDeposit.clear = 0
		
		if nCount > 0 then
			for i = 0 to nCount-1
				Dim sAcnt, sAsno, sPrcd, sPrcdName
				sAcnt = DATAMANAGER.GetDataValue( 0, "obwat_onln_004r_1", "OutBlock1", "ACNO" , i )
				sAsno = DATAMANAGER.GetDataValue( 0, "obwat_onln_004r_1", "OutBlock1", "ASNO" , i )
				sPrcd = DATAMANAGER.GetDataValue( 0, "obwat_onln_004r_1", "OutBlock1", "PRCD" , i )
				sCsnm = DATAMANAGER.GetDataValue( 0, "obwat_onln_004r_1", "OutBlock1", "CSNM" , i )
				
				if sPrcd = "100" Then
					sPrcdName = "[종합매매] "
					bImpossible = false
				elseif sPrcd = "118" Then
					sPrcdName = "[CMA] "
					bImpossible = false
				elseif sPrcd = "119" Then
					sPrcdName = "[랩종합] "
				else
					sPrcdName = ""
				end if
				
				contStep1.cmbAcntDeposit.cbadddatatext = sAcnt..sAsno.."`"..sPrcdName..mid(sAcnt, 1, 4).."-"..mid(sAcnt, 5, 4).."-"..sAsno.." "..sCsnm
			next
		end if
		
		if bImpossible then
			g_bImpossible = true
			Form.OpenPopup("mbwat61020_p9", "100|계약 해지 시 사용 될\n입금계좌가 필요합니다.\n계좌개설 후 진행해주세요.", "")
		end if
		
	elseif szTranID == "obwat_csad_003r" then
		Dim sName, sMinMncn
		
		sName = DATAMANAGER.GetDataValue( 0, "obwat_csad_003r", "OutBlock1", "WA_PRNM" , 0 )
		sMinMncn = DATAMANAGER.GetDataValue( 0, "obwat_csad_003r", "OutBlock1", "CNTM_MNCN" , 0 )
		g_szMinAmt = DATAMANAGER.GetDataValue( 0, "obwat_csad_003r", "OutBlock1", "MIN_JOIN_AMT" , 0 )
		
		g_nMinMncn = tonumber(sMinMncn)
		
		contStep1.Table0.SetCellString(3, 1, sName) '상품명
		contStep1.edtMinAmt.hintcaption = "최소"..FormatNumber( g_szMinAmt , 0 ).."원"
		contStep1.edtMinTerm.hintcaption = g_nMinMncn.." 개월"
		
'	elseif szTranID == "obsap_acif_999a" then
'		g_sJoinSrno = DATAMANAGER.GetDataValue( 0, "obsap_acif_999a", "OutBlock1", "FNPR_JOIN_SRNO" , 0 )
'		Form.OpenPopup("mbwat61022_p1" , g_sJoinSrno.."|"..g_sAcno.."|"..g_sAsno , "") '투자자금원금보전확인 동의
	
	elseif szTranID == "obwat_onln_003r" then
		Dim sJoinYN
		sJoinYN = DATAMANAGER.GetDataValue( 0, "obwat_onln_003r", "OutBlock1", "JOIN_ABLE_YN" , 0 )
		
		if sJoinYN == "N" then
			Dim sResultCode, sMsg
			sResultCode = DATAMANAGER.GetDataValue( 0, "obwat_onln_003r", "OutBlock1", "PROS_RSLT_CODE" , 0 )
			sMsg = DATAMANAGER.GetDataValue( 0, "obwat_onln_003r", "OutBlock1", "PROS_PRHB_DTL_CNTT" , 0 )
			g_sImpossibleData = sResultCode.."|"..sMsg
			
			Form.OpenPopup("mbwat61020_p9", g_sImpossibleData, "")
		else
			if g_bInit then
				g_bInit = false
				Form.OpenPopup("mbwat61022_p1" , g_sJoinSrno.."|"..g_sAcno.."|"..g_sAsno , "") '투자자금원금보전확인 동의
'				DATAMANAGER.RequestTranData( "obsap_acif_999a" )
			end if
		end if
		
		g_bInit = false
		
	elseif szTranID == "obcsb_acad_122a" then
		DATAMANAGER.RequestTranData( "obwat_onln_002a" )
		
	elseif szTranID == "obwat_onln_002a" then
		Dim sPlain_rm, sPwd
		sPlain_rm = Form.GetSharedData("&PLAIN_RM", false)
		
		if sPlain_rm == "1" then 'MTS메모리평문 적용상태일때
			sPwd = contStep1.edtPwd.caption
		else 'MTS메모리평문 미적용상태일때
			sPwd = Form.GetEncData(contStep1.edtPwd.caption)
		end if
		
		Form.triggerEvent("#", "PWD", sPwd)
		
		Dim sDate, sSrno
		sDate = DATAMANAGER.GetDataValue( 0, "obwat_onln_002a", "OutBlock1", "NMET_APLT_DATE" , 0 )
		sSrno = DATAMANAGER.GetDataValue( 0, "obwat_onln_002a", "OutBlock1", "NMET_APLT_SRNO" , 0 )
		Form.triggerEvent("#", "NEXT", sDate.."|"..sSrno)
		
	end if
End Sub

'============================================================================
Sub contStep1_btnPwd_OnClick()
	if g_sAcno == null or g_sAcno == "" then
		Form.MsgBox("알림", "선택할 수 있는 계좌가 없습니다.", "", 8, "확인", "")
	else
		'v0002
		Form.openPopupAnimation("pwdcheckpopup", g_sAcno & g_sAsno & "☆0" ,"","2")
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_bInit = true
	g_bImpossible = false
	g_sJoinSrno = Form.GetSharedData( "FNPR_JOIN_SRNO", false )
	
	'상품명 폰트색상 변경
	contStep1.Table0.SetCellFgColor(3, 1, 290)
	
	contStep1.btnPwd.bringfront("1") '계좌비밀번호 입력 개선
	
	contStep1.SetScrollAnimation(true)
	
	Form.SetTimerEvent2(1, 1, 0.1)
End Sub

'============================================================================
Sub contStep1_cmbAcnt_OnEditComplete(iIndex)
	g_sAcno = Left(contStep1.cmbAcnt.cbkeydata, 8)
	g_sAsno = Right(contStep1.cmbAcnt.cbkeydata, 2)
	contStep1.acnt.caption = contStep1.cmbAcnt.cbkeydata

	g_bInit = false
	g_bImpossible = false
	
	contStep1.edtPwd.caption = ""
	contStep1.edtMinAmt.caption = ""
	contStep1.edtMinTerm.caption = ""
	contStep1.cmbExtention.cbkeydata = "Y"
	contStep1.lblExtention.visible = true
	contStep1.cmbReport.cbkeydata = "21"
	contStep1.lblReport.visible = true
	contStep1.cmbPaper.cbkeydata = "05"
	contStep1.lblPaper.visible = true
	contStep1.lblDepositAcnt.visible = true
	contStep1.btnAlpha0.visible = true
	contStep1.btnAlpha1.visible = true
	contStep1.btnAlpha2.visible = true
	contStep1.btnAlpha3.visible = true
	contStep1.btnAlpha4.visible = true
	contStep1.btnAlpha5.visible = true
	
	contStep1.lnkFormPay.visible = false
	contStep1.lnkFormPay.linkfile = ""
	contStep1.SetScrollAutoSize()
	btnNext.enable = false
	btnNext.visible = false

	' 입금받을 계좌 조회
	DATAMANAGER.SetDataValue( 0, "obwat_onln_004r_1", "InBlock1", "IQRY_CLS_CODE" , 0 , "3" )
	DATAMANAGER.SetDataValue( 0, "obwat_onln_004r_1", "InBlock1", "CSNO" , 0 , g_sCsno )
	DATAMANAGER.SetDataValue( 0, "obwat_onln_004r_1", "InBlock1", "ACNO" , 0 , g_sAcno )
	DATAMANAGER.SetDataValue( 0, "obwat_onln_004r_1", "InBlock1", "WA_PRCD" , 0 , g_szWA_PRCD )
	DATAMANAGER.RequestTranData( "obwat_onln_004r_1" )
		
	DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "ACNO" , 0 , g_sAcno )
	DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "ASNO" , 0 , g_sAsno )
	DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "WA_PRCD" , 0 , g_szWA_PRCD )
	DATAMANAGER.RequestTranData( "obwat_onln_003r" )
End Sub

'============================================================================
Sub contStep1_cmbAcntDeposit_OnEditComplete(iIndex)
	g_sAcnoDeposit = Left(contStep1.cmbAcntDeposit.cbkeydata, 8)
	g_sAsnoDeposit = Right(contStep1.cmbAcntDeposit.cbkeydata, 2)
	
	contStep1.lblDepositAcnt.visible = false
	
	f_ShowPay() ' 보수확인 보임
End Sub

