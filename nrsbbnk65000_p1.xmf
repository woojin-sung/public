'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	Dim szLinkData
	szLinkData = ""
	szLinkData = Form.GetOpenLinkData()
	
	if szLinkData == "" then
		Form.CloseForm()
		Exit Sub
	end if 
	
	g_szLinkData = szLinkData
	Init_Control(szLinkData)
'	Init_Control("0")
End Sub

'===============================================
' imgBg_OnClick
'===============================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'===============================================
' contBg_btnCancel_OnClick
'===============================================
Sub contBg_btnCancel_OnClick()
	Form.CloseForm()
End Sub

'===============================================
' contBg_btnOk_OnClick
'===============================================
Sub contBg_btnOk_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("EXCHANGE_INFO_RETURN" , g_szLinkData)
End Sub

