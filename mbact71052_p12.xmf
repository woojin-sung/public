	<SCRIPT_INFO _len="17943" _ulen="16641" >
'v001 20220524 아이티젠 김성수 : 소수점 표기기능 추가(그리드 잔고수량 셀 마스킹 숫자>문자 변경)
'============================================================================
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nAcntCount	'계좌 개수	
Dim g_nAllCount	'전체조회시 계좌 Index
Dim g_szList
Dim g_szList
Dim g_sParam

dim g_szInputFile	'읽어들일세팅파일
g_szInputFile	 = "mbact71052.ini"
dim g_szKey		'키값		
g_szKey = "71052P12cmb"
Dim g_OpenFlag	'콤보인덱스 세팅 시, 서비스 중복조회 방지
g_OpenFlag = False

Dim g_nSelectRow

'============================================================================
Function VltnAmt_Request()
	dim szASET_CLS_CODE
	
	DATAMANAGER.ClearInputData(0, "obacb_balc_154r")
	szCsno = Form.GetSharedData("&CUST_NUM", false )

	if cont0.cmb0.cbkeydata == "0" then	'전체
		szASET_CLS_CODE = "40"
	elseif cont0.cmb0.cbkeydata == "1" then	'미국
		szASET_CLS_CODE = "41"
	elseif cont0.cmb0.cbkeydata == "2" then	'중국
		szASET_CLS_CODE = "42"
	elseif cont0.cmb0.cbkeydata == "3" then	'홍콩
		szASET_CLS_CODE = "43"
	elseif cont0.cmb0.cbkeydata == "4" then	'일본
		szASET_CLS_CODE = "44"
	end if
	
	'Y:전체 그외:개별
	if g_szList(1) == "Y" then
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "CSNO"		  , 0 , szCsno)
	else
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ACNO"		  , 0 , Left(g_szList(3), 8))
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASNO"		  , 0 , Right(g_szList(3), 2))
	end if

	'''2023.03.20 해외CFD인경우, ASET_CLS_CODE 변경 ('04:해외시장전체 --> 40:전체/41:미국/42:중국/43:홍콩/44:일본")
	DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASET_CLS_CODE" , 0 , szASET_CLS_CODE)
	
	DATAMANAGER.RequestTranData("obacb_balc_154r")
	
End Function
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	cont0.grd1.SetClear()
	cont0.lblNone.visible = false
	
	if sEventName == "mbact71052_p12" then			'해외CFD
		g_szList = Split(sParam,"○")
		
	end if
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	VltnAmt_Request()
	
	g_sParam = sParam
	g_nAcntCount = g_szList(0)		'계좌개수
	g_nAllCount = 3 + g_nAcntCount	'마지막 계좌 
	g_nNextCount = 0
	
	szLoadData = CInt(Form.LoadConfigData(g_szInputFile, g_szKey))
	g_OpenFlag = true

	if g_szList(1) == "Y" then
		cont0.cmb0.visible = 1
		cont0.cmb0.currentindex = 0
		cont0.Image1.visible = 1
		
		cont0.grd1.rowcount = 0
		AllSearch()
	else
		cont0.cmb0.visible = 0
		cont0.Image1.visible = 0
		
		DATAMANAGER.ClearInputData(0, "obtre_rmnd_003r")
		DATAMANAGER.SetDataValue( 0 , "obtre_rmnd_003r", "InBlock1", "ACNO" , 0 , Left(g_szList(3), 8) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obtre_rmnd_003r", "InBlock1", "ASNO" , 0 , Right(g_szList(3), 2) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obtre_rmnd_003r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
		DATAMANAGER.SetDataValue( 0 , "obtre_rmnd_003r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )	'조회구분 : 월정산기준으로만 조회
		DATAMANAGER.SetDataValue( 0 , "obtre_rmnd_003r", "InBlock1", "UI_IQRY_CLS" , 0 , "2"  )	'1:개별잔고 2:이평잔고 기준 조회
		DATAMANAGER.SetDataValue( 0 , "obtre_rmnd_003r", "InBlock1", "UI_NTNL_CLS" , 0 , "0"  )	'UI국가구분
'
		DATAMANAGER.RequestTranData( "obtre_rmnd_003r" )
	end if	
End Sub
'============================================================================
Function AllSearch()
	g_nAllCount = CInt(g_nAllCount) - 1
	if g_nAllCount > 2 then
		DATAMANAGER.ClearInputData(0, "obtre_rmnd_003r")
		
		DATAMANAGER.SetDataValue( 0 , "obtre_rmnd_003r", "InBlock1", "ACNO" , 0 , Left(g_szList(g_nAllCount), 8) ) '계좌번호
		DATAMANAGER.SetDataValue( 0 , "obtre_rmnd_003r", "InBlock1", "ASNO" , 0 , "%" )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obtre_rmnd_003r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
		DATAMANAGER.SetDataValue( 0 , "obtre_rmnd_003r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )	'조회구분 : 월정산기준으로만 조회
		DATAMANAGER.SetDataValue( 0 , "obtre_rmnd_003r", "InBlock1", "UI_IQRY_CLS" , 0 , "2"  )	'1:개별잔고 2:이평잔고 기준 조회
		DATAMANAGER.SetDataValue( 0 , "obtre_rmnd_003r", "InBlock1", "UI_NTNL_CLS" , 0 , cont0.cmb0.cbkeydata  )	'UI국가구분
'
		DATAMANAGER.RequestTranData( "obtre_rmnd_003r" )
	else
		lblVisible()
	end if
End Function
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	cont0.grd1.SetClear()
	g_nNextCount = 0
	Form.ShowAlert("알림", szErrMsg)
End Sub
'============================================================================
Sub Form_OnFormInit()
	g_nAllCount = 0
	'hsz
	szDate = right(Form.GetSharedData("&HOST_DATE" , false), 6)
	cont0.lblDate.caption = szDate
	cont0.setScrollBarVisible("0") 
'	cont0.cmb0.currentindex = "0"
	'hsz
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp11, 
	    szTemp12, szTemp13, szTemp14, szTemp15, szTemp16, nTemp17, szTempcode, szTempcdnm, szTempacnt, szTempacno, szTempasno, szTempname, TempCount
	    
	if szTranID = "obtre_rmnd_003r" then
		for i = 0 to DATAMANAGER.GetDataCount(0, "obtre_rmnd_003r" , "OutBlock1") - 1
			cont0.grd1.AddRow()
			
			szTemp0  = DATAMANAGER.GetDataValue(0, "obtre_rmnd_003r", "OutBlock1", "ACNO" , i)
			szTemp0 = Left(szTemp0, 4).."-"..Right(szTemp0, 4).."-"..DATAMANAGER.GetDataValue( 0 , "obtre_rmnd_003r", "OutBlock1", "ASNO" , i)
			szTempacnt = szTemp0.."("..DATAMANAGER.GetDataValue( 0 , "obtre_rmnd_003r", "OutBlock1", "ACNT_PRNM" , i)..")"	'계좌번호(상품명)
			szTemp1  = DATAMANAGER.GetDataValue(0, "obtre_rmnd_003r", "OutBlock1", "DEAL_CLS_CODE_NAME" , i)
			szTemp2  = DATAMANAGER.GetDataValue(0, "obtre_rmnd_003r", "OutBlock1", "ISCD" , i)
			szTemp3  = DATAMANAGER.GetDataValue(0, "obtre_rmnd_003r", "OutBlock1", "ISNM" , i)

			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obtre_rmnd_003r", "OutBlock1", "DEAL_CLS_CODE_NAME" , i)			'포지션
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obtre_rmnd_003r", "OutBlock1", "ACBK_OQTY" , i)					'잔고수량
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obtre_rmnd_003r", "OutBlock1", "CFD_ACBK_UNPR" , i)				'매수단가(외화)
			szTemp7 = DATAMANAGER.GetDataValue( 0 , "obtre_rmnd_003r", "OutBlock1", "VLTN_AMT" , i)					'평가금액(원화)
			szTemp8 = DATAMANAGER.GetDataValue( 0 , "obtre_rmnd_003r", "OutBlock1", "VLTN_PRLS_AMT" , i)				'평가손익(원화)
			szTemp9 = DATAMANAGER.GetDataValue( 0 , "obtre_rmnd_003r", "OutBlock1", "ERT" , i)						'수익률
'			szTemp92 = DATAMANAGER.GetDataValue( 0 , "obtre_rmnd_003r", "OutBlock1", "ACML_ERT" , i)					'수익률(최초증거금)
			szTemp10 = DATAMANAGER.GetDataValue( 0 , "obtre_rmnd_003r", "OutBlock1", "ACBK_AMT" , i)					'매입금액 - 상세
			szTemp11 = DATAMANAGER.GetDataValue( 0 , "obtre_rmnd_003r", "OutBlock1", "CFD_MGRT" , i)					'증거금률 - 상세
			szTemp12 = DATAMANAGER.GetDataValue( 0 , "obtre_rmnd_003r", "OutBlock1", "DEAL_CLS_CODE" , i)				'매매구분 코드
			szTemp13 = DATAMANAGER.GetDataValue( 0 , "obtre_rmnd_003r", "OutBlock1", "CRCD" , i)						'통화
			
			'20230925 현재가, 기준가 추가
			szTemp14 = DATAMANAGER.GetDataValue( 0 , "obtre_rmnd_003r", "OutBlock1", "PSNT_PRC" , i)					'현재가
			
			cont0.grd1.SetCellData("bd_cell27" , g_nNextCount, szTemp11) 	'CFD증거금률
			cont0.grd1.SetCellData("bd_cell13" , g_nNextCount, szTemp4)		'포지션
			cont0.grd1.SetCellData("bd_cell2" , g_nNextCount, "|  "..szTemp3)		'종목명
			cont0.grd1.SetCellData("bd_cell1" , g_nNextCount, szTemp6)		'매수단가(외화)
			cont0.grd1.SetCellData("bd_cell3" , g_nNextCount, szTemp5)		'잔고수량
			cont0.grd1.SetCellData("bd_cell5" , g_nNextCount, szTemp7)		'평가금액(원화)
			cont0.grd1.SetCellData("bd_cell23" , g_nNextCount, szTemp2)  	'종목코드
			cont0.grd1.SetCellData("bd_cell6", g_nNextCount, szTemp8)		'평가손익(원화)
			cont0.grd1.SetCellData("bd_cell7", g_nNextCount, szTemp9)		'수익률
			cont0.grd1.SetCellData("bd_cell12", g_nNextCount, szTemp6)		'매수단가(외화)
			cont0.grd1.SetCellData("bd_cell9", g_nNextCount, szTemp13)		'통화
			cont0.grd1.SetCellData("bd_cell21", g_nNextCount, szTemp10)		'매입금액 - 상세
			
			' 시장별 실시간여부값
			szMk = Right(szTemp2, 2)
			szRealAble = Form.GetSharedData( "REALTIME_"&szMk, false )					
			
			' 실시간
			if szRealAble == "0" then
				cont0.grd1.SetCellData( "bd_real", g_nNextCount, "realtime_red" )
			' 실시간아님
			elseif szRealAble == "1" then
				cont0.grd1.SetCellData( "bd_real", g_nNextCount, "realtime_gray" )
			end if

			if g_szList(1) == "Y" then
				cont0.grd1.SetCellData("bd_cell0" , g_nNextCount, szTempacnt) '계좌번호
			end if
			szTempacc0 = DATAMANAGER.GetDataValue(0, "obtre_rmnd_003r", "OutBlock1", "ACNO" , i)
			szTempacc1 = DATAMANAGER.GetDataValue(0, "obtre_rmnd_003r", "OutBlock1", "ASNO" , i)
			cont0.grd1.SetCellData("bd_acc", g_nNextCount, szTempacc0..szTempacc1)	'20221110 HSZ

			'매수/매도 색상 설정
			if CInt(szTemp12) = 2 then '매수
				cont0.grd1.SetCellFgColor("bd_cell13", g_nNextCount, "10")
			elseif CInt(szTemp12) = 1 then '매도
				cont0.grd1.SetCellFgColor("bd_cell13", g_nNextCount, "11")
			end if
			'평가손익금액/손익률 색상 설정
			if CDBL(szTemp9) > 0 then
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , "+"..FormatNumber(szTemp8, 0))
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , "+"..FormatNumber(szTemp9, 2))
				cont0.grd1.SetCellFgColor("bd_cell6", g_nNextCount, "10")
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "10")
			elseif CDBL(szTemp9) < 0 then
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , FormatNumber(szTemp8, 0))
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , FormatNumber(szTemp9, 2))
				cont0.grd1.SetCellFgColor("bd_cell6", g_nNextCount, "11")
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "11")
			else
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , FormatNumber(szTemp8, 0))
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , FormatNumber(szTemp9, 2))
			end if
			
			'20230925 현재가, 기준가 추가
			cont0.grd1.SetCellData("bd_cell14" , g_nNextCount, szTemp14)
			
			g_nNextCount = g_nNextCount + 1
			
		next
		
		cont0.grd1.rowcount = g_nNextCount
		
		if DATAMANAGER.IsMoreNextData( "obtre_rmnd_003r" ) == True then 
			DATAMANAGER.RequestNextData( "obtre_rmnd_003r" )
		else
			if g_szList(1) == "Y" then	'전체조회시
				AllSearch()
			else
				lblVisible()
			end if
		end if
	'---------------------------------------------------------
	'평가금액 조회
	'---------------------------------------------------------
	elseif szTranID == "obacb_balc_154r" then
		
		nPrlsamt = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "VLTN_PRLS_AMT" , i)	'평가손익
		nPrlsrate = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "PLRT" , i)			'수익률
		if CDBL(nPrlsrate) > 0 then
			szPrls = "+"..FormatNumber(nPrlsamt,0)
			cont0.LblTotal.caption = szPrls
			cont0.LblTotal.fgcolor = "10"
		elseif CDBL(nPrlsrate) < 0 then
			szPrls = FormatNumber(nPrlsamt,0)
			cont0.LblTotal.caption = szPrls
			cont0.LblTotal.fgcolor = "11"
		else
			szPrls = FormatNumber(nPrlsamt,0)
			cont0.LblTotal.caption = szPrls
			cont0.LblTotal.fgcolor = "4"
		end if
	
	'계좌번호로 ID연결여부 조회
	elseif szTranID == "obcsb_efif_264r" then
		Dim szLinkedYn
		szLinkedYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ID_LNKN_YN" , 0)
		
		Form.SetSharedData("71052_ID_LNKN_YN" , szLinkedYn)
		
		Dim szSendData
		Dim szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10
		
		szTemp1 = cont0.grd1.GetCellData("bd_cell2", g_nSelectRow)		'종목명
		szTemp2 = cont0.grd1.GetCellData("bd_cell5", g_nSelectRow)		'평가금액
		szTemp3 = cont0.grd1.GetCellData("bd_cell21", g_nSelectRow)		'매입금액
		szTemp4 = cont0.grd1.GetCellData("bd_cell6", g_nSelectRow)		'평가손익
		szTemp5 = cont0.grd1.GetCellData("bd_cell7", g_nSelectRow)		'수익률
		szTemp6 = cont0.grd1.GetCellData("bd_cell13", g_nSelectRow)		'잔고구분
		szTemp7 = cont0.grd1.GetCellData("bd_cell27", g_nSelectRow)		'증거금율
		szTemp8 = cont0.grd1.GetCellData("bd_cell3", g_nSelectRow)		'체결잔고
		szTemp9 = cont0.grd1.GetCellData("bd_cell1", g_nSelectRow)		'매입단가
		szTemp10 = cont0.grd1.GetCellData("bd_cell23", g_nSelectRow)		'종목코드
		szTemp11 = cont0.grd1.GetCellData("bd_cell9", g_nSelectRow)		'통화
		
		'20230925 현재가, 기준가 추가
		szTemp12 = cont0.grd1.GetCellData("bd_cell14", g_nSelectRow)		'현재가
		
		szSendData = szTemp1 & "☆" & szTemp2 & "☆" & szTemp3 & "☆" & szTemp4 & "☆" & szTemp5 & "☆" & szTemp6 & "☆" & szTemp7 & "☆" & szTemp8 & "☆" & szTemp9 & "☆" & szTemp10 & "☆" & szTemp11 & "☆" & szTemp12
		
	'	Form.ShowAlert("szSendData", szSendData)
		
		Form.OpenPopupAnimation("mbact71052_pd", szSendData, "", "2")
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	cont0.Imgicon.SetMaintainingRatio("1")
	cont0.Image1.SetMaintainingRatio("1")	
	cont0.imgRed.setMaintaingRatio("1")
	cont0.imgGray.setMaintaingRatio("1")
	cont0.grd1.setMaintainingRatio("bd_real", 0, "1")
End Sub

'============================================================================
Function lblVisible()
	if CInt(cont0.grd1.rowcount) = 0 then
		cont0.lblNone.visible = true
	else
		cont0.lblNone.visible = false
	end if
End Function 

'============================================================================
Sub cont0_cmb0_OnEditComplete(iIndex)
	if g_OpenFlag == True then
		g_OpenFlag = False
		exit sub
	end if
	g_szList = Split(g_sParam,"○")
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	VltnAmt_Request()
	
	g_nAcntCount = g_szList(0)		'계좌개수
	
	g_nAllCount = 3 + g_nAcntCount	'마지막 계좌 

	g_nNextCount = 0
	if g_szList(1) == "Y" then
		cont0.grd1.rowcount = 0
		cont0.grd1.SetClear()
		AllSearch()
'	else	'전체계좌 조회일때만 시장선택가능해서 해당 없음.
'		cont0.grd1.rowcount = 0
'		cont0.grd1.SetClear()
'		
