'============================================================================
Sub Form_OnFormInit()

Grid0.SetVisibleCol(3, 0)

DATAMANAGER.SetDataValue(0, "obcpp_intr_752r", "InBlock1", "INP_MEMB_SRNO" , 0 , 1)
DATAMANAGER.SetDataValue(0, "obcpp_intr_752r", "InBlock1", "DATE_FACT1" , 0 , Calendar0.caption)
DATAMANAGER.SetDataValue(0, "obcpp_intr_752r", "InBlock1", "DATE_FACT2" , 0 , Calendar1.caption)

DATAMANAGER.RequestTranData("obcpp_intr_752r")
tmp_cnt = 0
Label1.visible = 0
	
End Sub





'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)


     cnt = DATAMANAGER.GetDataCount(0, "obcpp_intr_752r" ,"OutBlock1") 
     
     if cnt == 0 then
     Label1.visible = 1
     Grid0.SetDeleteRow(0)
     end if
	
	'Form.MsgBox("테스트", cnt, "", "")
	
	for i = 0 to cnt-1
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_752r", "OutBlock1", "ADCP_NAME", i) '자문사명
	Grid0.SetCellData("bd_cell0", tmp_cnt+i, tmp)

	'Grid0.SetCellData('sCellID, nRowIdx, sValue)
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_752r", "OutBlock1", "PRTF_NAME", i) '포폴명
	Grid0.SetCellData("bd_cell3", tmp_cnt+i, tmp)
	
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_752r", "OutBlock1", "INP_INVT_INCL_CLCD", i) '위험등급'
	
	if abs(tmp) == 1 then
	tmp = "안정형"
	  
	elseif abs(tmp) == 2 then
	tmp = "안정추구형"
	
	elseif abs(tmp) ==3 then
	tmp = "중립형"
	
	elseif abs(tmp) == 4 then
	tmp = "수익추구형"
	
	elseif abs(tmp) ==5 then
	tmp = "고수익추구형"
	
	end if
	
	
	Grid0.SetCellData("bd_cell1", tmp_cnt+i, tmp)
	Grid0.SetCellFgColor("bd_cell1", tmp_cnt+i, "91")
	
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_752r", "OutBlock1", "PRTF_ID", i)
	Grid0.SetCellData("bd_cell6", tmp_cnt+i, tmp)
	
	
	Grid0.SetCellData("bd_cell4", tmp_cnt+i, "▶")
	
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_752r", "OutBlock1", "FERT", i) '수수료
	Grid0.SetCellData("bd_cell5", tmp_cnt+i, "수수료 : "&Cint(tmp)&"%")
	
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_752r", "OutBlock1", "ANTC_ERT", i) '예상수익률
	Grid0.SetCellData("bd_cell2", tmp_cnt+i, "수익률 : "&Cint(tmp)&"%")
	
	
'	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_752r", "OutBlock1", "INP_RBDV_VLPN", i) '고객평점
	
'	if abs(tmp) == 1 then
'	tmp = "★☆☆☆☆"
'	  
'	elseif abs(tmp) == 2 then
'	tmp = "★★☆☆☆"
'	
'	elseif abs(tmp) ==3 then
'	tmp = "★★★☆☆"
'	
'	elseif abs(tmp) == 4 then
'	tmp = "★★★★☆"
'	
'	elseif abs(tmp) ==5 then
'	tmp = "★★★★★"
'	
'	end if
'	
	
	
	
	
'	Grid0.SetCellData("bd_cell12", tmp_cnt+i, tmp)
'	Grid0.SetCellData("bd_cell0", tmp_cnt+i, "자문사명")
'	Grid0.SetCellData("bd_cell1", tmp_cnt+i, "포트폴리오명")
'	Grid0.SetCellData("bd_cell2", tmp_cnt+i, "위험등급")
'	Grid0.SetCellData("bd_cell3", tmp_cnt+i, "수수료")
'	Grid0.SetCellData("bd_cell4", tmp_cnt+i, "예상수익률")
'	Grid0.SetCellData("bd_cell5", tmp_cnt+i, "고객평가")
'	
'	
'	Grid0.SetCellData("bd_cell6", tmp_cnt+i, "비교선택")
'	Grid0.SetCellFgColor("bd_cell6", tmp_cnt+i, 90)
'	
'	Grid0.SetCellData("bd_cell13", tmp_cnt+i, "상세보기")
'	Grid0.SetCellFgColor("bd_cell13", tmp_cnt+i, 90)
'	
	
	'if tmp_cnt+i < cnt-1 then
 	'Grid0.AddRow()
	
'	else
'	tmp_cnt = 0
'	end if
	
	
	
	next
	
'	DATAMANAGER.RequestNextData("obcpp_intr_722r")


	
End Sub

'============================================================================
Sub Calendar0_OnEditComplete()

DATAMANAGER.SetDataValue(0, "obcpp_intr_752r", "InBlock1", "INP_MEMB_SRNO" , 0 , "1")
DATAMANAGER.SetDataValue(0, "obcpp_intr_752r", "InBlock1", "DATE_FACT1" , 0 , Calendar0.caption)
DATAMANAGER.SetDataValue(0, "obcpp_intr_752r", "InBlock1", "DATE_FACT2" , 0 , Calendar1.caption)
	DATAMANAGER.RequestTranData("obcpp_intr_752r")
End Sub

'============================================================================
Sub Calendar1_OnEditComplete()
	
	DATAMANAGER.SetDataValue(0, "obcpp_intr_752r", "InBlock1", "INP_MEMB_SRNO" , 0 , "1")
DATAMANAGER.SetDataValue(0, "obcpp_intr_752r", "InBlock1", "DATE_FACT1" , 0 , Calendar0.caption)
DATAMANAGER.SetDataValue(0, "obcpp_intr_752r", "InBlock1", "DATE_FACT2" , 0 , Calendar1.caption)
DATAMANAGER.RequestTranData("obcpp_intr_752r")
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	
 tmp = Grid0.selectrow
 prtf_id = Grid0.GetCellData("bd_cell6", tmp)
 
 if szCellID == "bd_cell4" then 

 Form.OpenFramePopup("mbetc99000_s19" , prtf_id , "")
 end if
 
End Sub

