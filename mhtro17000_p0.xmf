	<SCRIPT_INFO _len="1646" _ulen="1620" >
'============================================================================
'해외주식 세미스크린 세미메뉴
'============================================================================
Sub Form_OnFormInit()
	szLinkData = Form.GetOpenLinkData()
	
	if szLinkData == "JP" then
		TblQuick.visible = false
		TblQuickJP.visible = true
		
		imgQuick.height = 240
	else
		TblQuick.visible = true
		TblQuickJP.visible = false
		
		imgQuick.height = 280
	end if
	
End Sub
'============================================================================
Sub TblQuick_OnClick(lRow , lColumn)
	Select Case CInt(lRow)
	Case 0
		Form.OpenScreen("11010" , "")
		
	Case 1
		Form.SendReturnToParent("SCREEN_MENU" , "REG_MEMO")

	Case 2
		Form.SendReturnToParent("SCREEN_MENU" , "DISCLAIMER")
	
	Case 3
		Form.OpenScreen("16020" , "")

	Case 4
		Form.OpenScreen("87051" , "")
		
	Case 5
		Form.OpenScreen("16090" , "")
		
	Case 6
		Form.SendReturnToParent("SCREEN_MENU" , "SET_SCREEN")
		
	End Select
	
	Form.CloseForm()
End Sub

'============================================================================
Sub TblQuickJP_OnClick(lRow , lColumn)
	Select Case CInt(lRow)
	Case 0
		Form.OpenScreen("11010" , "")
		
	Case 1
