	<SCRIPT_INFO _len="2503" _ulen="2327" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 장외채권 상품 보유 현황 상세
' 02. 화면설명 : 장외채권 상품 보유 현황 상세
'                

' 03. 이    력 : 
' - 2023.11.01 : 윤혁 : v0001 : 신규개발


'-------------------------------------------------------------------------------------------

'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_szLinkData, g_szList
Dim g_ACNo, g_ASNo, g_szSymbolCode


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************



'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub imgDim_OnClick()
	Form.CloseForm("")
End Sub
	
'============================================================================
Sub contMain_btnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_szLinkData = Form.GetOpenLinkData()
	
'	Form.ShowAlert("90301_p2_FormInit", g_szLinkData)
	if g_szLinkData == "" or g_szLinkData == null then
		Exit Sub
	end if 
	
	g_szList = split(g_szLinkData, "|")
	
	contMain.lblName.maxlinecnt = "1^-1"
	
	'0 종목명
	'1 종목코드
	'2 평가금액
	'3 청약일
	'4 만기일
	'5 다음평가일
	'6 기초자산
	'7 매입금액
	'8 원금보장여부
	'9 평가손익금액
	'10 수익률
	'11 발행통화

	contMain.lblName.caption = g_szList(0)
		
	contMain.tbl0.SetCellString(0, 2, g_szList(2))
	
	contMain.tbl1.SetCellString(0, 2, g_szList(3))
	contMain.tbl1.SetCellString(1, 2, g_szList(4))
	
	contMain.tbl2.SetCellString(0, 2, g_szList(5))	
	contMain.tbl2.SetCellString(1, 2, g_szList(6))
	contMain.tbl2.SetCellString(2, 2, g_szList(7))
	contMain.tbl2.SetCellString(3, 2, g_szList(8))
	contMain.tbl2.SetCellString(4, 2, g_szList(9))
	contMain.tbl2.SetCellString(5, 2, g_szList(10))
	'contMain.tbl2.SetCellString(6, 2, g_szList(11))
	
End Sub



