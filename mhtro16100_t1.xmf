'============================================================================
Sub btnAble_OnClick()
	
	'-----------------------------------------------------------------------------------------------------------
	'계좌번호★계좌일련번호★종목코드★거래소코드(4자리)★연동가격★현재가★소수점자리수★틱타입
	'★상한가★하한가★통합증거금여부★통화★호가단위
	'-----------------------------------------------------------------------------------------------------------
	szData = Form.GetTopCtlProp("acnt", "total")
	szData = szData & "★" & Form.GetTopCtlProp("acnt", "sequence")
	
	sCodeData = Split(g_szCd, "@")
	
	if #sCodeData > 0 then
		szData = szData & "★" & sCodeData[1] 
	else
		szData = szData & "★" & "" 
	end if
	
	szData = szData & "★" & g_szMk 
	szData = szData & "★" & edtPrc.caption 
	szData = szData & "★" & g_szCurPrice 
	szData = szData & "★" & g_szDecimal 
	szData = szData & "★" & g_szTickType 
	szData = szData & "★" & g_szUpLimit 
	szData = szData & "★" & g_szDnLimit 
	
	if gTotalYN == true then
		szData = szData & "★" & "Y" 
	else
		szData = szData & "★" & "N" 
	end if
	
	szData = szData & "★" & g_szCurrency 
	szData = szData & "★" & g_szUnit 

	Form.OpenPopupAnimation("mhtro16100_p11", szData, "", "2")
	
End Sub

'============================================================================
Sub btnPreOderPricePopup_OnClick()
	
	Dim szData
	szData = ""
	
	szData = "2"												'매수(2)/매도(1)구분값
	szData = szData & "★" & Form.GetTopCtlProp("acnt", "total") 	'종합계좌(8자리)
	szData = szData & "★" & Form.GetTopCtlProp("acnt", "sequence") '계좌일련번호(2자리)
	
	sCodeData = Split(g_szCd, "@")
	
	if #sCodeData > 0 then
		szData = szData & "★" & sCodeData[1] 					'종목코드(티커)
	else
		szData = szData & "★" & "" 
	end if
	
	
	szData = szData & "★" & g_szMk 							'거래소코드(4자리)
	szData = szData & "★" & "0" 								'현금(0)/대출(1)구분
	szData = szData & "★" & edtPrc.caption  					'입력가격
	szData = szData & "★" & edtQty.caption						'입력수량
	szData = szData & "★" & g_szDecimal							'소수점자리수
	szData = szData & "★" & g_szCurrency						'통화
	szData = szData & "★" & "1"								'일반(1)/신용합산(2)
	
	Form.OpenPopupAnimation("mhtro16100_p13", szData, "", "2")
	
End Sub

'============================================================================
Sub btnOrderPrice_OnClick()
	btnPreOderPricePopup_OnClick()
End Sub
'============================================================================
Function SetAbleLabel(sType)
	
	if sType == "TOTAL" then
	
		LabelCashAbleQty.visible = false
		LabelCurrencyAbleQty.visible = true
		LabelTotalAbleQty.visible = true
		
		LabelCurrencyAbleQty.top = 154
		LabelTotalAbleQty.top = 187
		
		
	else
	
		LabelCashAbleQty.visible = true
		LabelCurrencyAbleQty.visible = false
		LabelTotalAbleQty.visible =  false
		
		LabelCashAbleQty.top = 154
	
	
	end if

End Function


