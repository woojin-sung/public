		<BUTTON name="btnBuy" caption="현금매수" fontstyle="01" btnimage="btn_30.9.png" ly_vert="170,342,195,38,1" />
		<IMAGE name="Image0" imgpath="img_bgbox_gray.9" ly_vert="170,271,195,58,1" />
		<LABEL name="Label1" fgcolor="334:034034034" fontsize="-2" fontstyle="01" caption="금액" bgcolor="143:049050052" autofontsize="1" paddinginfo="1,0,0,0" ly_vert="180,271,30,38,1" />
		<LABEL name="lblOrderPrice" fontstyle="01" halign="2" autofontsize="1" ly_vert="232,271,125,38,1" />
