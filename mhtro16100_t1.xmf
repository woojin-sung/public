Dim g_szOdrPop
Dim g_szAfterInit
Dim g_szChangeInit
Dim g_szBuyQty, g_szBuyQtyCnt 
Dim g_szAfterOrg

Dim g_szCd, g_szMk, g_szNg	' 종목코드, 거래소코드, 국가코드
g_szCd = ""
g_szMk = ""
g_szNg = ""

Dim	g_szWarnFlag			' 주문 경고 확인플래그
g_szWarnFlag	= "N"

Dim g_szTR
g_szTR = ""

Dim g_szTitle
g_szTitle = "알림"

Dim g_szOrdSize		' 매매단위
g_szOrdSize = ""

Dim g_szCurPrice		' 현재가
g_szCurPrice = ""

Dim g_szUpLimit		' 상한가
g_szUpLimit =  ""

Dim g_szDnLimit		' 하한가
g_szDnLimit =  ""

Dim g_szUnit			' 호가단위
g_szUnit =  ""

Dim g_szDecimal		' 종목가격 자릿수
g_szDecimal =  ""

Dim g_szKorName		' 한글종목명
g_szKorName =  ""

Dim g_szTickType		' 종목틱타입
g_szTickType =  ""

Dim g_szCurrency		' 통화
g_szCurrency = ""

Dim gTotalReqFirst	' 통합증거금 약정여부 최초조회 여부
gTotalReqFirst = true

Dim gTotalYN			' 통합증거금 약정여부
gTotalYN = false

Dim g_TotalReqComplete	' 통합증거금 조회완료 여부
g_TotalReqComplete = false

Dim gNoSettingQty
gNoSettingQty = false

Dim gSettingSelectPrice	' 현재가 화면에서 연동된 가격이 있는지 여부
gSettingSelectPrice = false

Dim gSettingSelectPriceForAutoPrice '20240729
gSettingSelectPriceForAutoPrice = false

Dim gAlReadyCallAutoPrice '20240729
gAlReadyCallAutoPrice = false

Dim gOsType
Dim gMaxLen
gMaxLen = 12

'============================================================================
Sub Form_OnFormInitBefore()

	'--------------------------------------------------
	' 매체구분
	'--------------------------------------------------
	gOsType = Form.GetSharedData("&OS_TYPE", false)
	
	'--------------------------------------------------
	'이미지 찌그러짐 방지 API
	'--------------------------------------------------
	imgInfo.setMaintainingRatio("1")
	
	'--------------------------------------------------
	'컨트롤 패딩값 조절
	'--------------------------------------------------
	lblOrderPrice.paddinginfo = "0,0,0,0"
	lblOrderPriceWon.paddinginfo = "0,0,0,0"
	
	LabelCashAbleQty.paddinginfo = "0,0,0,0"
	LabelCurrencyAbleQty.paddinginfo = "0,0,0,0"
	LabelTotalAbleQty.paddinginfo = "0,0,0,0"
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	'--------------------------------------------------
	'주문환경설정 값 Load
	'--------------------------------------------------
	Load_OrderSet()
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	'============================================================================
	' 종목정보 연동
	'============================================================================
	if sEventName == "SEND_ITEM_INFO" then
	
		'-----------------------------------------------------------------------
		'현재가★상한가★하한가★매매단위★통화★소수점자리수★한글종목명★틱타입
		'-----------------------------------------------------------------------
		arrItemInfo = Split(sParam, "★")
		
		g_szCurPrice 	= arrItemInfo(0)
		g_szUpLimit	= arrItemInfo(1)
		g_szDnLimit	= arrItemInfo(2)
		g_szOrdSize 	= arrItemInfo(3)
		g_szCurrency	= arrItemInfo(4)
		g_szDecimal	= arrItemInfo(5)
		g_szKorName	= arrItemInfo(6)
		g_szTickType	= arrItemInfo(7)
		g_szUnit		= GetHogaUnit(g_szMk, g_szCurPrice, 0)
	
		'-----------------------------------------------------------------------
		'가격입력창 소수점 자리수 세팅 / 통화기호 세팅
		'-----------------------------------------------------------------------
		if g_szCurrency <> "" then
			sMask = "0,0,,".. " " .. g_szCurrency .. ",0,,"..g_szDecimal..",1,1,2,0"
		else
			sMask = "0,0,,,0,,"..g_szDecimal..",1,1,2,0"
		end if
		
		edtPrc.mask = sMask
		
		'-----------------------------------------------------------------------
		'수량입력창 매매단위 세팅
		'-----------------------------------------------------------------------
		if g_szOrdSize <> "" then
			edtQty.hintcaption = FormatNumber(g_szOrdSize,0).."주 단위"
		end if
		
		'-----------------------------------------------------------------------
		'주문금액 가계산 초기세팅
		'-----------------------------------------------------------------------
		if g_szCurrency <> "" then
			lblOrderPrice.caption = "- ".. g_szCurrency
			lblOrderPriceWon.caption = "- " .. "원"
		else
			lblOrderPrice.caption = "- "
			lblOrderPriceWon.caption = "- " .. "원"
		end if
		
		'-----------------------------------------------------------------------
		'종목/탭 변경시 가격입력창/수량입력창 입력값 초기화 
		'-----------------------------------------------------------------------
		if g_szChangeInit == "1" then
			Init_InputControl()
		end if
		
		'-----------------------------------------------------------------------
		'국가별 주문가능 주문유형 설정
		'-----------------------------------------------------------------------
		SetOrderTypeList(g_szNg)
		
		'-----------------------------------------------------------------------
		'통화별 환율 조회
		'-----------------------------------------------------------------------
		RequestExChangeRate()
	
	'============================================================================
	' 호가조회 완료(가격/수량 자동입력 요청)
	'============================================================================
	elseif sEventName == "HOGA_COMPLETE" then
	
		'---------------------------------------------------------------------------------
		' [금액 자동입력]
		'---------------------------------------------------------------------------------
		' 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅 (위치변경 ChangeAcnt)
		' 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
		'---------------------------------------------------------------------------------
		'sPrice = Form.GetSharedData("PRICE", true)
		'
		'if sPrice <> "" and sPrice <> null	then
		'	edtPrc.caption = sPrice
		'	
		'else
			
			if g_szChangeInit <> "1" then
				RequestAutoPrice()
			end if
		
		'end if
		
		'---------------------------------------------------------------------------------
		' [수량 자동입력]
		'---------------------------------------------------------------------------------
		if g_szChangeInit <> "1" then
			RequestAutoQty()
		end if
		
		
	'============================================================================
	' 클릭 호가 연동
	'============================================================================
	elseif sEventName == "CLICK_HOGA" then
		
		edtPrc.caption = sParam
		Calc_OrderPrice()
		
		'--------------------
		' 주문가능수량 조회
		'--------------------
		gNoSettingQty = true
		Request_Able()
		
	'============================================================================
	' 종목코드 초기화/종목코드 변경/탭 변경
	'============================================================================
	elseif sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then
		
		'-------------------------------------------------------------------------
		'종목이 바뀐 경우
		'-------------------------------------------------------------------------
		if g_szCd <> sParam then
			
			g_szCd = sParam
			g_szNg = Form.GetItemCodeInfo(g_szCd, "ovsnation")	' 국가구분코드
			g_szMk = Form.GetItemCodeInfo(g_szCd, "exchid")		' 거래소벤더코드
			
			'환율정보 라벨 클리어(이전 데이터 남아있어 깜빡임 방지)
			LabelExchangeRate.caption = ""
			
			if sEventName == "ChangeTab" then
				
				'---------------------------------------------------------------------------------
				' [금액 자동입력]
				'---------------------------------------------------------------------------------
				' 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅(위치변경 ChangeAcnt)
				' 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
				'---------------------------------------------------------------------------------
				'sPrice = Form.GetSharedData("PRICE", true)
				'
				'if sPrice <> "" and sPrice <> null	then
				'	edtPrc.caption = sPrice
				'	
				'else
					
					if g_szChangeInit <> "1" then
						RequestAutoPrice()
					end if
				
				'end if
			
				'---------------------------------------------------------------------------------
				' [수량 자동입력] "종목/탭 변경 시 초기화" 설정 해제된 상태일때 
				' 통합증거금 약정 조회를 한번도 하지 않은 경우 통합증거금 약정 조회 후 > 수량입력
				' 톧합증거금 약정을 한번이라도 조회했던 경우는 바로 수량 자동입력
				'---------------------------------------------------------------------------------
				if gTotalReqFirst == true then
					
					RequestCombinedMargin()
				
				else
					
					if g_szChangeInit <> "1" then
						RequestAutoQty()
					end if
				
				end if
				
			end if
		
		'-------------------------------------------------------------------------
		' 종목이 안바뀐 경우
		'-------------------------------------------------------------------------
		else
		
			if sEventName == "ChangeTab" then
				
				'---------------------------------------------------------------------------------
				' [금액 자동입력]
				'---------------------------------------------------------------------------------
				' 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅(위치변경 ChangeAcnt)
				' 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
				'---------------------------------------------------------------------------------
				'sPrice = Form.GetSharedData("PRICE", true)
				'
				'if sPrice <> "" and sPrice <> null	then
				'	edtPrc.caption = sPrice
					
				'else
					
					if g_szChangeInit <> "1" then
						RequestAutoPrice()
					end if
				
				'end if
			
				'---------------------------------------------------------------------------------
				' [수량 자동입력]
				' 통합증거금 약정 조회를 한번도 하지 않은 경우 통합증거금 약정 조회 후 > 수량입력
				' 톧합증거금 약정을 한번이라도 조회했던 경우는 바로 수량 자동입력
				'---------------------------------------------------------------------------------
				if gTotalReqFirst == true then
					
					RequestCombinedMargin()
				
				else
					
					if g_szChangeInit <> "1" then
						RequestAutoQty()
					end if
				
				end if
				
			
			end if
		
			
			
		end if
		
		
	'============================================================================
	' 매수가격 자동입력
	'============================================================================
	elseif sEventName == "ReturnAutoPrice" then
		
		'--------------------------------------------------------
		' 종목/탭 변경 시 초기화가 꺼져있어도, 
		' 주문가격 자동입력이 미사용으로 되어있으면 빈값이 넘어옴.
		' 빈값으로 넘어온 경우에는 세팅해주지 않는다
		'--------------------------------------------------------
		if g_szChangeInit <> "1" and sParam <> "" and gSettingSelectPriceForAutoPrice <> true then '20240729
			edtPrc.caption = sParam
			Calc_OrderPrice()
		end if
		
		'20240729
		if sParam <> "" then
			gAlReadyCallAutoPrice = true
			gSettingSelectPriceForAutoPrice = false 
		end if
		
		'--------------------------------------------------------
		' ★ [가격 자동입력 설정 시] 종목변경 시 수량가능 재조회
		'    가격이 0이면 조회안함. => 0으로 올리면 어차피 서비스에서 0주로 주니 걍 호출함
		'--------------------------------------------------------
		if g_TotalReqComplete == true then
			'if CDbl(sParam) > 0 then
				Request_Able()
			'end if
		end if
		
	'============================================================================
	' 계좌변경(통합증거금 약정여부 조회 및 입력창 초기화)
	'============================================================================	
	elseif sEventName == "ChangeAcnt" then
	
		RequestCombinedMargin()
		
		if g_szChangeInit == "1" then
			Init_InputControl()
		end if
		
		'----------------------------------------------------------------------------------------------------------------
		' 해외주식현재가 화면에서 가격연동 데이터가 있으면 데이터 세팅
		'----------------------------------------------------------------------------------------------------------------
		' ### gSettingSelectPrice 변수설명 ###
		'----------------------------------------------------------------------------------------------------------------
		' : 현재가에서 연동된 호가가 있는 경우 [SEND_DAYMARKET_PRC] or [SEND_AFTERMARKET_PRC]에서 가격세팅 방지
		'
		'----------------------------------------------------------------------------------------------------------------
		' ### gSettingSelectPriceForAutoPrice 변수설명 ###
		'----------------------------------------------------------------------------------------------------------------
		' 정상적인 호출 순서 : [ReturnAutoPrice]호출 후 [ChangeAcnt]가 호출되면서 현재가 링크가격을 세팅
		' 간헐적으로 [ChangeAcnt] 호출 후에 [ReturnAutoPrice]가 호출되는 케이스 발생(설정한 자동가격으로 덮어씌어짐)
		' [ChangeAcnt]가 먼저 호출되어 gSettingSelectPriceForAutoPrice = true인 경우 [ReturnAutoPrice]에서 가격세팅 방지
		'
		'----------------------------------------------------------------------------------------------------------------
		' ### gAlReadyCallAutoPrice 변수 설명 ###
		' 정상적으로 [ReturnAutoPrice]호출 후 [ChangeAcnt]가 호출되면 gSettingSelectPriceForAutoPrice를 true로 변경해줄 필요가 없음.
		' 정상적으로 호출되었을때 gSettingSelectPriceForAutoPrice를 true로 변경해주면 오히려 문제가됨. 
		' ex) 다른탭으로 이동 후에 다시 돌아왔을때 설정한 자동입력 가격으로 세팅이 안됨
		' [ReturnAutoPrice]가 먼저 호출되었는지 판단하기 위해 gAlReadyCallAutoPrice 변수를 사용
		'-----------------------------------------------------------------------------------------------------------------
		sPrice = Form.GetSharedData("PRICE", true)
		
		if sPrice <> "" and sPrice <> null	then
			gSettingSelectPrice = true
			
			'20240729
			if gAlReadyCallAutoPrice <> true then
				gSettingSelectPriceForAutoPrice = true 
			end if
			
			edtPrc.caption = sPrice
			
		end if
		
	'============================================================================
	' 주간장 현재가 세팅(가격자동입력 활성화 & 현재가 세팅으로 되어있을때)
	'============================================================================
	elseif sEventName == "SEND_DAYMARKET_PRC" or sEventName == "SEND_AFTERMARKET_PRC" then
		
		if g_szChangeInit <> "1" and sParam <> "" then
			
			g_szCurPrice 	= sParam '20240627
			szAuto  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYPRC")
			
			if szAuto == "11" and gSettingSelectPrice <> true then
				edtPrc.caption = sParam
				Calc_OrderPrice()
			end if
			
		end if
		
		gSettingSelectPrice = false '20240729
	
	'============================================================================
	' 비밀번호 검증 후 주문확인창 자동 오픈
	'============================================================================
	elseif sEventName == "OPEN_CONFIRM" then
		btnBuy_OnClick()
		
	
	'============================================================================
	' 20240715 종목 미변경 시, 필요한 데이터만 재조회(통합증거금여부/매수가능수량/환율)
	'============================================================================
	elseif sEventName == "RefreshData" then
		RequestExChangeRate()
		RequestCombinedMargin()
	end if
	
End Sub

'============================================================================
Sub edtPrc_OnEditComplete()
	
End Sub

'============================================================================
Sub edtQty_OnEditComplete()
	
End Sub

'============================================================================
' (가격)자동입력값 요청
'============================================================================
Function RequestAutoPrice()

	Form.triggerEvent("#", "RequestAutoPrice", "BUY")

End Function

'============================================================================
' (수량)자동입력값 요청
'============================================================================
Function RequestAutoQty()
	
	if g_szBuyQty == "1" then			' 현금가능수량
		
		if g_TotalReqComplete == true then
			Request_Able()
		end if
		
	elseif g_szBuyQty == "2" then		' 최대가능수량 (해외주식은 미수가 없어 현금가능수량으로 조회)
		
		if g_TotalReqComplete == true then
			Request_Able()
		end if
		
	elseif g_szBuyQty == "3" then		' 수량입력
	
		edtQty.caption = g_szBuyQtyCnt
		Calc_OrderPrice()
		
	end if

	'Form.triggerEvent("#", "RequestAutoQty", "BUY")

End Function

