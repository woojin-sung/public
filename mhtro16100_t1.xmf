		<LABEL name="LabelExchangeRate" fgcolor="333:115118124" fontsize="-3" mask="0,1,환율 ,,0,,2,1,0,0,0" bgcolor="143:049050052" halign="2" autofontsize="1" paddinginfo="1,0,0,0" click="1" ly_vert="171,250,190,20,1" />
		<LABEL name="lblOrderPriceWon" fgcolor="333:115118124" fontsize="-2" fontstyle="01" halign="2" autofontsize="1" ly_vert="232,304,125,20,1" />
