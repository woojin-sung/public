'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn)

	szPrc  = ReSet_Prc(edtPrc.caption, nGbn)
	szHigh = g_szUpLimit
	szLow  = g_szDnLimit

	g_szUnit = GetHogaUnit(g_szMk, szPrc, nGbn) '20180710 HAMWG : 호가단위 설정함수 변경
	szUnit = g_szUnit
	
	if Trim(szPrc) == "" or CDbl(szPrc) == 0 then
		if g_szCurPrice == "" or CDbl(g_szCurPrice) == 0 then
			szPrc = 0
		else
			szPrc = g_szCurPrice
		end if
	else
		
		'------------------------------------------------
		' + 버튼 클릭
		'------------------------------------------------
		if nGbn == 0 then							
			if CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if 
			elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀
				if szLow <> "0" then
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if 
			else
				szPrc = CDbl(szPrc) + CDbl(szUnit)
			end if
		
		'------------------------------------------------
		' - 버튼 클릭 
		'------------------------------------------------
		elseif nGbn == 1 then						
			if CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if 		
			elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
				if szLow <> "0" then
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if 
			else
				szPrc = CDbl(szPrc) - CDbl(szUnit)
			end if
		end if
	end if
	
	if CDbl(szPrc) < 0 then
		szPrc = 0
	end if
	
	'---------------------------------------------------------
	' 입력값 자리수 체크
	'---------------------------------------------------------
	'if Len(szPrc) > gMaxLen then	
	'	Exit Function
	'end if
	
	edtPrc.caption = szPrc
	Calc_OrderPrice()
	
End Function

'============================================================================
' 가격 호가단위 맞추기 
'============================================================================
Function ReSet_Prc(szData, nGbn)	
	if nGbn == 0 then
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))

		if nResult <> 0 and nResult <> CDbl(g_szUnit) then
			return CDbl(szData) - nResult
		else
			return szData
		end if
	else
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))
	
		if nResult <> 0 then
			return CDbl(szData) + (CDbl(g_szUnit) - nResult)
		else
			return szData
		end if
	end if
End Function

'============================================================================
' btnPPlus_OnClick : 가격 + 버튼
'============================================================================
Sub btnPPlus_OnClick()
	
	Calc_Price(0)
	
	gNoSettingQty = true
	Request_Able()
	
End Sub

'============================================================================
' btnPMinus_OnClick : 가격 - 버튼
'============================================================================
Sub btnPMinus_OnClick()
	
	Calc_Price(1)
	
	gNoSettingQty = true
	Request_Able()
	
End Sub

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn,nUnit)
	
	szQty = edtQty.caption
	
	'---------------------------------------------------------
	' (기존요건) 최대입력 가능 수량 99000000
	'---------------------------------------------------------
	'if Trim(szQty) <> "" then
	'	if CDbl(szQty) >= 99000000 then
	'		if nGbn == 0 then
	'			Exit Function
	'		end if
	'	end if
	'end if
	
	'---------------------------------------------------------
	' 수량이 빈값인 경우 매매단위로 초기화
	'---------------------------------------------------------
	if Trim(szQty) == "" then
		if nGbn == 0 then
			szQty = CDbl(nUnit)
		else
			Exit Function
		end if
	
	'---------------------------------------------------------
	' 수량이 빈값이 아닌 경우
	'---------------------------------------------------------
	else
			
		'---------------------------------------------------------
		' [+]버튼 클릭
		'---------------------------------------------------------
		if nGbn == 0 then
			szQty = CDbl(szQty) + CDbl(nUnit)
			nResult = CDbl(szQty) Mod CDbl(nUnit)
			
			if nResult <> 0 then
				szQty = CDbl(szQty) - nResult
			end if
			
		'---------------------------------------------------------
		' [-]버튼 클릭
		'---------------------------------------------------------
		elseif nGbn == 1 then
			
			if CDbl(szQty) == 0 then
				Exit Function
			else		
				szQty = szQty - CDbl(nUnit)
				nResult = CDbl(szQty) Mod CDbl(nUnit)
				
				'20240726
				if Cdbl(szQty) < 0 then
					szQty = 0
				end if
				
			end if
			
		end if
		
	end if
	
	'---------------------------------------------------------
	' 입력값 자리수 체크
	'---------------------------------------------------------
	if Len(szQty) <= gMaxLen then		
		if CStr(szQty) == "0" or CStr(szQty) == "" then
			edtQty.caption = ""
		else
			edtQty.caption = szQty
		end if
	end if
	
	Calc_OrderPrice()
	
	
End Function

'============================================================================
Sub btnQPlus_OnClick()
	Calc_Qty(0,g_szOrdSize)
End Sub

'============================================================================
Sub btnQMinus_OnClick()
	Calc_Qty(1,g_szOrdSize)
End Sub

'============================================================================
' 주문금액 가계산
'============================================================================
Function Calc_OrderPrice()
	
	nPrc = Cdbl(edtPrc.caption)
	nQty = Cint(edtQty.caption)
	
	if nPrc <> "" and nPrc > 0 and nQty <> "" and nQty > 0 then
		
		nOrderPrice = nPrc * nQty
		
		if g_szDecimal <> "" then
			lblOrderPrice.caption = FormatNumber(nOrderPrice,g_szDecimal).." " .. g_szCurrency
		else
			lblOrderPrice.caption = FormatNumber(nOrderPrice,0).." " .. g_szCurrency
		end if
		
		nExChangeRate = Cdbl(LabelExchangeRate.caption)
		
		if nExChangeRate <> "" and nExChangeRate > 0 then
			nOrderPriceWon = nOrderPrice * nExChangeRate
			nOrderPriceWon = Cint(nOrderPriceWon)
			lblOrderPriceWon.caption = FormatNumber(nOrderPriceWon,0).."원"
		else
			lblOrderPriceWon.caption = "- " .. "원"
		end if
	
	else
	
		lblOrderPrice.caption = "- " .. g_szCurrency
		lblOrderPriceWon.caption = "- " .. "원"
		
	end if
	
End Function

'============================================================================
' (공통) 주문 환경설정값 적용
'============================================================================
Function Load_OrderSet()
	
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력
	
	g_szBuyQty     = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYQTY")		' 매수수량 자동입력(0:미사용, 1:현금가능수량, 2:최대가능수량(미수포함), 3:수량입력
	g_szBuyQtyCnt  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYQTYCNT")	' 매수수량 주수(수량입력 선택시)
	
	'--------------------------------------------
	' 주문확인창(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	'--------------------------------------------
	' 주문전송 후 초기화(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'--------------------------------------------
	'종목/탭 변경시 초기화 사용을 초기값으로 설정
	'종목/탭 변경시 초기화(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	

	'--------------------------------------------
	' 원주문번호 자동입력(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	'--------------------------------------------
	' 매수수량 자동입력(기본값 : 사용하지 않음)
	'--------------------------------------------
	if Trim(g_szBuyQty) = "" then
		g_szBuyQty = "0"		
	end if
	
End Function

'============================================================================
' 시장에 따른 주문유형
'============================================================================
Function SetOrderTypeList(sNation)
	
	if gOsType == "1" or gOsType == "2" then
		
		if sNation == "USA" then
			
			if gOsType == "2" then
				cmbType.SetPopupHeight(430)
			else
				cmbType.SetPopupHeight(360)
			end if
			
			sList = "00`보통(지정가)`원하는 가격을 지정하여주문\r\n" & 
	                 "31`LOO(장개시지정가)`장 개시와 동시에 시가가 지정한 가격보다 같거나 유리하면 체결 시키는 주문\r\n" & 
				   "32`LOC(장마감지정가)`장 마감과 동시에 종가가 지정한 가격보다 같거나 유리하면 체결 시키는 주문\r\n" & 
				   "35`Limit VWAP(가격제한수량분할)`과거 거래량을 분석하여 현지 브로커 자체 기준으로 가격을 제한한 장중 분할 체결하는 알고리즘 주문\r\n" & 
				   "36`Limit TWAP(가격제한시간분할)`과거 거래시간을 분석하여 현지 브로커 자체 기준으로 장중 시간별로 분할 체결하는 알고리즘 주문으로 지정한 가격과 동일하거나 유리하면 체결하는 주문\r\n"

		else 
			
			cmbType.SetPopupHeight(0)
			
			sList = "00`보통(지정가)`원하는 가격을 지정하여주문\r\n"
			
		end if

	else
		
		if sNation == "USA" then
			sList = "00`보통(지정가)\r\n31`LOO(장개시지정가)\r\n32`LOC(장마감지정가)\r\n35`Limit VWAP(가격제한수량분할)\r\n36`Limit TWAP(가격제한시간분할)"
		else 
			sList = "00`보통(지정가)\r\n"
		end if
		
	end if
	
	cmbType.currentindex = "0"	
	cmbType.clear = true
	cmbType.cbinputdatatext = sList
	
End Function

'============================================================================
' 통합증거금 약정여부 조회 서비스 호출
'============================================================================
Function RequestCombinedMargin()
	
	g_TotalReqComplete = false
	
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "PROS_CLS_CODE" 	, 0 , "1")
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "CSNO" 			, 0 , " ")
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "SVCD" 			, 0 , "081")
		
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ACNO" 			, 0 , Form.GetTopCtlProp("acnt", "total"))
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ASNO" 			, 0 , Form.GetTopCtlProp("acnt", "sequence"))
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "RMND_SRNO" 		, 0 , " ")
	
	DATAMANAGER.RequestTranData("obpds_srvc_323r")
	

End Function

'============================================================================
' 고시환율 조회 서비스 호출
'============================================================================
Function RequestExChangeRate()

	szDate = Form.GetSharedData("&HOST_DATE", false)
	DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "STND_DATE" 	, 0 , szDate )
	DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "CRCD"		, 0 , g_szCurrency )
	
	DATAMANAGER.RequestTranData("obtro_comn_025r")

End Function

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obtro_oder_101a" then
		
		g_szTR = szTranID
		szPrc = edtPrc.caption
		
		sCodeData = Split(g_szCd, "@")
		DATAMANAGER.ClearInputData(0, "obtro_oder_101a")

		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ACNO"				, 0, Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ASNO"				, 0, Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ACNT_PWD"			, 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "OVRS_STCK_SYMB_ISCD"	, 0, sCodeData[1])							' 종목코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "OVRS_EXCH_VNDR_IDNO"	, 0, g_szMk)									' 거래소코드	
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "SELN_BYOV_CLCD"		, 0, "2")									' 매도/매수구분코드
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODER_CLS_CODE"		, 0, Check_OrdType())							' 주문구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODER_COND_CLS_CODE"	, 0, Check_OrdCond())							' 주문조건구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODQT"				, 0, edtQty.caption)							' 주문수량
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "OVRS_STCK_ODER_PRC"	, 0, szPrc)									' 주문단가
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01")									' 주문발생유형코드(01:일반주문)
		DATAMANAGER.SetDataValue(0, "obtro_oder_101a", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag)	
	
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'==========================================================================
	'해외주식 매수주문 
	'==========================================================================
	if szTranID == "obtro_oder_101a" then
	
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0) '경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
	
		'--------------------------------
		' 경고
		'--------------------------------
		if szWarnCd = "1" then							
		
			Open_ConfirmPopup(szWarnMsg)
		
		'--------------------------------
		' 보류(해외주식 제외)
		'--------------------------------
		elseif szWarnCd = "2" then						'
			
			g_szTR = ""
		
		'--------------------------------
		' 해외주식 미국PTP 종목과세관련
		'--------------------------------
		elseif szWarnCd = "3" then
			
			szData = "0" & "|" & szWarnMsg	' 매매구분|메시지
			'Form.OpenPopup("mhtro16100_p15", szData , "")	'OnPopupReturn -> "PTP주문경고"
			Form.OpenPopupAnimation("mhtro16100_p15", szData, "", "2")
			
		'--------------------------------
		' 정상주문 처리
		'--------------------------------
		else
		
			g_szTR = ""
				
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
	
			'-----------------------------
			' 정상주문
			'-----------------------------
			if Trim(szOrdCd) == "0001" then			
				
				'-----------------------------
				' 주문가능수량을 재조회한다.
				'-----------------------------
				gNoSettingQty = true
				Request_Able()
				
				'-----------------------------
				' 주문후 초기화
				'-----------------------------
				if g_szAfterInit == "1" then		
					Reset_AfterOrd()
				end if
				
				'-----------------------------
				' 주문번호 연동
				'-----------------------------
				if g_szAfterOrg == "1" then			
					szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
					Form.triggerEvent("#", "AfterOrd", szOrgNo)
				end if
				
				'-----------------------------
				' 주문처리 메시지 출력
				'-----------------------------
				Form.Toast(0, szOrdMsg, true)
				
					
			end if
			
		end if
	
	
	'==========================================================================
	'통합증거금 약정조회
	'==========================================================================
	elseif szTranID == "obpds_srvc_323r" then
	
		'------------------------------------------------------------------------------------
		'SVCD 값이 0이면, 통합증거금 미약정 계좌
		'------------------------------------------------------------------------------------
		gTotalReqFirst = false
		g_TotalReqComplete = true
		
		szCnt = DATAMANAGER.GetDataValue(0, "obpds_srvc_323r" , "OutBlock1" , "SVC_SRNO" , 0)
		
		if Cint(szCnt) <> 0 then
			gTotalYN = true
		else
			gTotalYN = false
		end if
		
		'------------------------------------------------------------------------------------
		' ★ [화면 최초 진입 시] (g_TotalReqComplete == false 상태)
		'------------------------------------------------------------------------------------
		' 통합증거금 약정여부 조회 후 주문 가능수량 조회
		' 수량자동입력 설정(g_szBuyQty)이 현금가능수량(1) or 최대가능수량(2) 되어있는 경우
		' 수량조회 완료 후 세팅 해준다. 기존처럼 [RequestAutoQty]에서 해주면 통합증거금 약정여부
		' 조회전에 조회한 값으로 세팅됨.
		'------------------------------------------------------------------------------------
		Request_Able()
		
	'==========================================================================
	'통화별 환율조회
	'==========================================================================
	elseif szTranID == "obtro_comn_025r" then
	
		szAnncExrt = DATAMANAGER.GetDataValue( 0, "obtro_comn_025r", "OutBlock1", "ANNC_EXRT" , 0 )	' 고시환율
		
		'엔화일때만 환율 4자리 표기 그외에는 2자리 표기
		if g_szCurrency == "JPY" then
			LabelExchangeRateMaskData = "0,1,환율 ," .."".. ",0,,4,1,1,0,0"
		else
			LabelExchangeRateMaskData = "0,1,환율 ," .."".. ",0,,2,1,1,0,0"	
		end if
		
		LabelExchangeRate.mask = LabelExchangeRateMaskData
		LabelExchangeRate.caption = szAnncExrt
		
		'수량/가격 자동입력 설정 시
		'환율조회가 되기 전, 주문금액 가계산이 진행된 경우 
		'원화금액이 빈값으로 나올 수 있어 환율 조회 이후에 다시 한번 주문금액 계산
		Calc_OrderPrice()
		
		
	'==========================================================================
	'주문가능수량 조회 Complete
	'==========================================================================
	elseif szTranID == "obtro_oder_264r" then
	
		sOrdAbleQty 		= DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "ODER_ABLE_QTY"			 , 0)
		sOrdAbleTotalQty 	= DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "INTG_MARG_ODER_ABLE_QTY" , 0)
		
		'---------------------------------------------------------
		' 마스킹처리 & 주문가능수량 세팅
		' 통합증거금 약정 시 해당통화 라벨만 앞에 통화기호 넣어줘야되서 스크립트로 마스킹 처리
		'---------------------------------------------------------
		LabelMaskData = "0,0,"..g_szCurrency.."가능 ".. "," .. "주".. ",0,,0,1,1,2,0"
		LabelCurrencyAbleQty.mask = LabelMaskData
		
		if Trim(edtPrc.caption) == "" or Trim(edtPrc.caption) == "0" then
			LabelCashAbleQty.caption = "  "
			LabelCurrencyAbleQty.caption = "  "
			LabelTotalAbleQty.caption = "  "
		else
			LabelCashAbleQty.caption = sOrdAbleQty
			LabelCurrencyAbleQty.caption = sOrdAbleQty
			LabelTotalAbleQty.caption = sOrdAbleTotalQty
		end if
		
		'---------------------------------------------------------
		' 주문가능수량 세팅 후 라벨 보임처리
		'---------------------------------------------------------
		if gTotalYN == true then
			SetAbleLabel("TOTAL")
		else
			SetAbleLabel("NORMAL")
		end if
		
		'----------------------------------------------------------------------------------------
		' 수량 자동입력 설정이 (g_szBuyQty 1:현금가능수량, 2:최대가능수량)으로 설정되어있는 경우
		' 주문가능수량 조회 후 수량입력창에 자동 세팅
		'----------------------------------------------------------------------------------------
		' 통합증거금 약정되어있는 고객일 경우 
		' 1:현금가능수량 => [해당통화가능수량] 2:최대가능수량 => [통합가능수량] 세팅
		'----------------------------------------------------------------------------------------
		if g_szChangeInit <> "1" then
			
			'-------------------------------------------------------------
			'[InputKeyPad]에서 가격/수량 리턴 후 조회한 경우
			'[+],[-]로 가격을 변경한 경우
			'[가능수량 조회팝업]에서 수량을 선택한 경우
			'리턴받은 수량을 세팅해주기 위해 조회된 가능수량을 세팅안해줌.
			'주문금액만 재조회
			'-------------------------------------------------------------
			if gNoSettingQty == true then
			
				gNoSettingQty = false
				Calc_OrderPrice()
		
			else
				if g_szBuyQty == "1" or g_szBuyQty == "2" then
					
					if gTotalYN == true then
						
						if g_szBuyQty == "1" then
							edtQty.caption = sOrdAbleQty
						elseif g_szBuyQty == "2" then
							edtQty.caption = sOrdAbleTotalQty
						end if
						
					else
						edtQty.caption = sOrdAbleQty
					end if
					
					Calc_OrderPrice()
					
				end if
			end if
			
			
		end if
		
	end if
	
	'해외주식 주문착오 방지
	g_szWarnFlag = "N"	
	
End Sub

'============================================================================
' 서비스 오류처리
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	'------------------------------------------------------------------
	' 주문가능수량 조회/고시환율 조회 에러메시지는 스킵처리
	'------------------------------------------------------------------
	if szTranID == "obtro_oder_264r" then
		
		LabelMaskData = "0,0,"..g_szCurrency.."가능 ".. "," .. "주".. ",0,,0,1,1,2,0"
		LabelCurrencyAbleQty.mask = LabelMaskData
		
		LabelCashAbleQty.caption = "  "
		LabelCurrencyAbleQty.caption = "  "
		LabelTotalAbleQty.caption = "  "
	
		Exit Sub
		
	elseif szTranID == "obtro_comn_025r" then
		Exit Sub
	end if
	
	'---------------------------------------------------------------------
	' 주문가능금액 부족(obtro_oder101a) 에러메시지 발생 시, 환전화면 연동
	'---------------------------------------------------------------------
	if szTranID == "obtro_oder_101a" and szErrCode == "5988" then
		
		if Trim(szSubMsg) <> "" then
			Form.MsgBox("안내", szErrMsg & "\n(" & szSubMsg & ")", "ORDER_ABLE_MONEY", 7, "환전하러가기","확인")
		else
			Form.MsgBox("안내", szErrMsg, "ORDER_ABLE_MONEY", 7, "환전하러가기","확인")
		end if
		
		Exit Sub
	end if
	
	'---------------------------------------------------------------------
	' 해외주식 미약정 계좌상태에서 주문냈을때 에러메시지, 거래신청화면 연동
	'---------------------------------------------------------------------
	if szTranID == "obtro_oder_101a" and szErrCode == "6205" then
		
		Form.MsgBox("안내", "해외주식 거래신청 미등록 계좌는 약정 신청 후 거래가 가능합니다. 해당 화면으로 이동하시겠습니까?" , "REG", 7, "거래신청하기" , "취소")
		Exit Sub
	
	end if
	
	'------------------------------------------------------------------
	' 해외ETP 미약정 고객
	'------------------------------------------------------------------
	if szErrCode == "6207" then
		
		Form.MsgBox("안내", "해외ETP 거래 미신청 계좌 입니다.\n해당 화면으로 이동하시겠습니까?", "ETP_MSG", 7, "거래신청하기","취소")
		
	'------------------------------------------------------------------
	' 그외
	'------------------------------------------------------------------
	else
		if Trim(szSubMsg) <> "" then
			Form.ShowAlert(g_szTitle, szErrMsg & "\n(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szTitle, szErrMsg)
		end if
	end if
	
End Sub

'============================================================================
' 메시지박스 리턴
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

	if sKeyName == "ETP_MSG" then
		
		if sRet == "ok" then
			
			'거래신청화면 연동 / 계좌번호 같이 넘김
			szAcnt = Form.GetTopCtlProp("acnt", "caption")
			Form.OpenScreen("87051" , szAcnt)
			
		end if
	
	elseif sKeyName == "REG" then
	
		if sRet == "ok" then
		
			'거래신청화면 연동 / 계좌번호 같이 넘김
			szAcnt = Form.GetTopCtlProp("acnt", "caption")
			Form.OpenScreen("87051" , szAcnt)
			
		end if
	
	elseif sKeyName == "ORDER_ABLE_MONEY" then
	
		if sRet == "ok" then
			
			'환전화면 연동
			scrNo = Form.GetSharedData("&SCREEN_NO", false)
			szData = "매수통화" & "`" &  g_szCurrency & "`" & scrNo & "`" & "0" 
			Form.OpenScreen("65000",szData)
		
		end if
	
	end if
	
End Sub

'============================================================================
' btnBuy_OnClick : 매수버튼 클릭
'============================================================================
Sub btnBuy_OnClick()
	
	if Check_InputData("Order") == true then
		
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup("")
		else
			Request_Order()
		end if
		
	end if
	
End Sub

'============================================================================
' 주문전송 전 입력값 정합성 검증
'============================================================================
Function Check_InputData(sGubun)
	
	
	if sGubun == "Order" then
		
		'계좌번호
		szAcnt = Form.GetTopCtlProp("acnt", "caption")
		If Len(szAcnt) < 10 Then
			Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
			return False
		End If
		
		'계좌비밀번호
		szPwd = Form.GetTopCtlProp("edtPwd", "caption")
		If Trim(szPwd) = "" Then
			'Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			Form.triggerEvent("#", "ShowPasswordKeyPad", "")
			return False
		end if
		
		'종목코드
		if Trim(g_szCd) == "" then
			Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
			return false
		end if
		
		'수량
		if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
			Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
			return false
		end if
		
		'가격
		if Trim(edtPrc.caption) == "" or Trim(edtPrc.caption) == "0" then
			Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
			return false
		end if
		
		return true
		
	end if
	
End Function

'============================================================================
' 주문확인창/경고팝업 오픈
'============================================================================
Function Open_ConfirmPopup(szWarn)
	
	Dim szData, szOrdNm
	szOrdNm = Check_OrdName() 
	
	sCodeData = Split(g_szCd, "@")
	szData = "0"													' 매매구분
	szData = szData & "|" & Form.GetTopCtlProp("acnt", "caption")		' 계좌번호
	szData = szData & "|" & Form.GetTopCtlProp("acnt", "accountname")	' 계좌명
	szData = szData & "|" & sCodeData[1]								' 종목코드
	szData = szData & "|" & g_szKorName								' 종목명
	szData = szData & "|" & szOrdNm									' 주문구분
	szData = szData & "|" & "0"										' 현금
	szData = szData & "|" & edtQty.caption							' 주문수량
	szData = szData & "|" & edtPrc.caption							' 주문가격
	szData = szData & "|" & ""										' 원주문번호
	szData = szData & "|" & ""										' 전량전부
	szData = szData & "|" & g_szDecimal								' 가격자릿수
	szData = szData & "|" & g_szCurrency								' 통화기호
	
	'----------------------------------------------------
	' 경고팝업 오픈
	'----------------------------------------------------
	if Trim(szWarn) <> "" then		
		
		'경고메세지 추가	
		szData = szData & "|" & szWarn			
		Form.OpenPopupAnimation("mhtro16100_p8", szData , "", "2")
	
	'----------------------------------------------------
	' 주문확인팝업 오픈
	'----------------------------------------------------
	else							
		
		Form.OpenPopupAnimation("mhtro16100_p3", szData , "", "2")
		
	end if
	
End Function

'============================================================================
' 주문유형코드
'============================================================================
Function Check_OrdType()
	Dim szIdx
	szIdx = CStr(cmbType.currentindex)
	
	Select Case szIdx
		Case "0"
			return "01" '지정가
		Case "1"
			return "31" 'LOO
		Case "2"
			return "32" 'LOC
		Case "3"
			return "35" 'Limit VWAP
		Case "4"
			return "36" 'Limit TWAP
	End Select
	
End Function
'============================================================================
' 주문조건구분코드
'============================================================================
Function Check_OrdCond()
	
	Dim szIdx
	szIdx = Check_OrdType()
	
	Select Case szIdx
		Case "01"
			return "0" '지정가
		Case "31"      
			return "2" 'LOO
		Case "32"      
			return "7" 'LOC
		Case "35"      
			return "0" 'Limit VWAP
		Case "36"      
			return "0" 'Limit TWAP
	End Select
	
End Function

'============================================================================
' 주문유형명 가져오기
'============================================================================
Function Check_OrdName()
	
	Dim szIdx
	szIdx = Check_OrdType()
	
	Select Case szIdx
		Case "01"
			return "보통(지정가)"
		Case "05"
			return "시장가"
		Case "31"
			return "LOO(장개시지정가)" 
		Case "32"
			return "LOC(장마감지정가)" 
		Case "33"
			return "MOO(장개시시장가)" 
		Case "34"
			return "MOC(장마감시장가)" 
		Case "35"
			return "Limit VWAP(가격제한수량분할)" 
		Case "36"
			return "Limit TWAP(가격제한시간분할)" 
		Case "37"
			return "VWAP(수량분할)" 
		Case "38"
			return "TWAP(시간분할)" 
	End Select
	
End Function

'============================================================================
' 주문전송
'============================================================================
Function Request_Order()
	
	'------------------------
	' 해외주식 주문착오 방지
	'------------------------
	g_szWarnFlag	= "N"
	
	'------------------------
	' 주문서비스 호출
	'------------------------
	DATAMANAGER.RequestTranData("obtro_oder_101a")
	
End Function

'============================================================================
' 팝업창 리턴처리
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	' ----------------------------------------------------------------------
	' (사용)해외주식 주문착오 방지 (경고팝업에서 리턴)
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end if	
	
	' ----------------------------------------------------------------------
	' (사용)PTP경고팝업에서 리턴 (20221206_01 KBC START : 해외주식 미국PTP 종목과세관련)
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PTP주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end if		
	
	' ----------------------------------------------------------------------
	' (사용)주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	
	' ----------------------------------------------------------------------
	' (미사용)수량/금액입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		edtQty_OnEditComplete()
		
		 btnCash.btnimage = "btn_02.9.png"
		 btnMax.btnimage  = "btn_02.9.png"
			
	' ----------------------------------------------------------------------
	' (미사용)가격입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then		
		edtPrc.caption = sRet		
		'edtPrc_OnEditComplete()
	
	' ----------------------------------------------------------------------
	' (사용)가격/수량 입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "InputKeyPad" then
		
		arrData = Split(sRet,"★")
		edtPrc.caption = arrData(0)	
		edtQty.caption = arrData(1)	
		Calc_OrderPrice()
		
		gNoSettingQty = true
		Request_Able()
	
	' ----------------------------------------------------------------------
	' (사용) 주문가능수량 조회팝업에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "OrderAble_Popup" then
	
		arrData = Split(sRet,"★")
		edtPrc.caption = arrData(0)	
		edtQty.caption = arrData(1)	
		Calc_OrderPrice()
		
		gNoSettingQty = true
		Request_Able()
		
	'----------------------------------------------------------------------
	' (미사용) 20210329 LES START 통합증거금 - 수량조회팝업 리턴
	'----------------------------------------------------------------------
	elseif sKeyName == "16060_p8" then
		edtQty.caption = sRet
		edtQty_OnEditComplete()
	
	end if
	
End Sub

'============================================================================
' 주문가능수량 조회
'============================================================================
Function Request_Able()
	
	g_szWarnFlag = "N"							
	
	if g_szCd <> "" then
		DATAMANAGER.ClearInputData(0, "obtro_oder_264r")
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IQRY_CLS_CODE" 		, 0 , "2")
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ACNO" 				, 0 , Form.GetTopCtlProp("acnt", "total"))
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ASNO" 				, 0 , Form.GetTopCtlProp("acnt", "sequence"))
		
		sCodeData = Split(g_szCd, "@")
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_STCK_SYMB_ISCD" 	, 0 , sCodeData[1])
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_EXCH_VNDR_IDNO" 	, 0 , g_szMk)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "SELN_BYOV_CLCD" 		, 0 , "2")
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ODER_CRNC_PRC" 		, 0 , edtPrc.caption)
		
		if gTotalYN == true then
			DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IF_INTG_MARG_IQRY_YN"	, 0 , "Y")
		else
			DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IF_INTG_MARG_IQRY_YN"	, 0 , "N")
		end if
		
		DATAMANAGER.RequestTranData("obtro_oder_264r")
	end if
	
End Function

