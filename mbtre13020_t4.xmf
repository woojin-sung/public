'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szOdrNo, szOdrType, szOdrPrc, szClsCd, szDate, szData
	
	if lRow > -1 then
		szCd      	= grdList.GetCellData("bd_cell3" ,	lRow)
		szVndrCd	 	= grdList.GetCellData("bd_cell19",	lRow)
		szCdName	 	= grdList.GetCellData("bd_cell13",	lRow)
		szMicheQty	= grdList.GetCellData("bd_cell6" ,	lRow)
		szOdrNo   	= grdList.GetCellData("bd_cell1" ,	lRow)	
		szOdrPrc  	= grdList.GetCellData("bd_cell4" ,	lRow)
		szDate    	= grdList.GetCellData("bd_cell7" ,	lRow)

		' 전달내용/종목코드/주문일자/주문번호/미체결수량/주문가격
		szData = "미체결" & "★" & szCd & "★" & szVndrCd & "★" & szCdName & "★" & szDate & "★" & szOdrNo & "★" & szMicheQty & "★" & szOdrPrc 
		
'		Form.SendReturnToParent("13000_CONTRACT", szData)
		Form.triggerEvent("#","13000_CONTRACT_NEW", szData)
'		Form.CloseForm()			
	end if	
End Sub

'============================================================================
' btnInquiry_OnClick : 조회버튼
'============================================================================
Sub btnInquiry_OnClick()
	DATAMANAGER.RequestTranData("obtre_cntg_001r")
End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then
		g_szAcnt   	= Form.GetTopCtlProp("acnt", "total")		' 계좌번호(8)
		g_szAcntCd 	= Form.GetTopCtlProp("acnt", "sequence")		' 계좌일련번호(2)
		g_szAcntPwd	= Form.GetTopCtlProp("edtPwd", "caption")		' 계좌 비밀번호	
		DATAMANAGER.RequestTranData("obtre_cntg_001r")
	end if
End Sub

'============================================================================
Sub btnOrdCancel_OnClick()
	Dim szSendData
	'계좌정보|매수매도구분값|신규청산구분값
	szAcnt   = Form.GetCtlProp("#acnt", "total")
	szAcntCd = Form.GetCtlProp("#acnt", "sequence")
	Tab      = "3"
	szGbn    = "0"

	szSendData = szAcnt & "★" & szAcntCd & "★" & Tab & "★" & szGbn & "★" & Get_DEAL_CLS_CODE() & "★" & Get_NEW_CLRN_CLCD()
	
	Form.openFramePopup("mbtre13020_p0", szSendData, "")
End Sub

Function Get_DEAL_CLS_CODE()
	if rdoMedosu.currentindex == "2" or rdoMedosu.currentindex == 2 then
		return "1" '매도
	elseif rdoMedosu.currentindex == "1" or rdoMedosu.currentindex == 1 then
		return "2" '매수
	else
		return "%" '전체
	end if
	
End Function

Function Get_NEW_CLRN_CLCD()
	if rdoNEW.currentindex == "2" or rdoNEW.currentindex == 2 then
		return "2" '청산
	elseif rdoNEW.currentindex == "1" or rdoNEW.currentindex == 1 then
		return "1" '신규
	else
		return "%" '전체
	end if
	
End Function
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if "13020_CLOSE" == sKeyName then
		if sRet == "1" then'일괄취소 한 경우만 새로고침
			grdList.rowcount = 0
			DATAMANAGER.RequestTranData("obtre_cntg_001r")
		end if
	end if
End Sub

