'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	grdList.rowcount = 0
	
	' ----------------------------------------------------------------------
	' 주문체결내역 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtre_cntg_001r" then
		
		szDealClsCode = Get_DealClsCode()
		szNewClrnClcd = Get_NewClrnClcd()
		szCntgClsCode = Get_CntgClsCode()
		
		DATAMANAGER.ClearInputData(0, "obtre_cntg_001r")
		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "ACNO"			, 0 , g_szAcnt )
		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "ASNO"			, 0 , g_szAcntCd )
		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "ACNT_PWD"		, 0 , g_szAcntPwd )
		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "DEAL_CLS_CODE"	, 0 , szDealClsCode)
		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "NEW_CLRN_CLCD"	, 0 , szNewClrnClcd)
		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "CNTG_CLS_CODE"	, 0 , szCntgClsCode)
		DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "UI_SORT_CLS_VAL"	, 0 , "2" )
		
'		DATAMANAGER.ClearInputData(0, "obtre_cntg_003r")
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_003r", "InBlock1", "ACNO"			, 0 , g_szAcnt )
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_003r", "InBlock1", "ASNO"			, 0 , g_szAcntCd )
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_003r", "InBlock1", "ACNT_PWD"		, 0 , g_szAcntPwd )
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_003r", "InBlock1", "DEAL_CLS_CODE"	, 0 , szDealClsCode)
'		'DATAMANAGER.SetDataValue( 0, "obtre_cntg_001r", "InBlock1", "NEW_CLRN_CLCD"	, 0 , szNewClrnClcd)
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_003r", "InBlock1", "CNTG_CLS_CODE"	, 0 , szCntgClsCode)
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_003r", "InBlock1", "UI_SORT_CLS_VAL"	, 0 , "2" )
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_003r", "InBlock1", "IQRY_CLS_CODE"	, 0 , "2" )
'		
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_003r", "InBlock1", "IQRY_STA_DATE"	, 0 , Calendar0.caption )
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_003r", "InBlock1", "IQRY_FIN_DATE"	, 0 , Calendar0.caption)
'		
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_003r", "InBlock1", "MANG_BRCD"	, 0 , "%")
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_003r", "InBlock1", "MANG_EMPNO"	, 0 , "%")
'		DATAMANAGER.SetDataValue( 0, "obtre_cntg_003r", "InBlock1", "CTCD"	, 0 , "%")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtre_cntg_001r" then
		if CInt(grdList.rowcount) > 0 then
			grdList.height = 330 - 35
			btnOrdCancel.visible = true
		else
			grdList.height = 330
			btnOrdCancel.visible = false
		end if
		
		For iCnt = grdList.rowcount - 1 To 0 Step -1
'			szData = grdList.GetCellData( "bd_cell2", iCnt )
'			if szData == "매수" then
'				grdList.SetCellFgColor("bd_cell2", iCnt, "10")
'			elseif szData == "매도" then
'				grdList.SetCellFgColor("bd_cell2", iCnt, "11")
'			end if
'			szItem = grdList.GetCellData( "bd_Cd", iCnt)
'			szMarket = Trim(Form.GetItemCodeInfo(szItem, "market"))
			
			'매매구분
			szData = grdList.GetCellData( "bd_cell25", iCnt)
			szData2 = grdList.GetCellData( "bd_cell20", iCnt)	'정정/취소구분(1신규,2정정, 3취소)
					
			If szData2 = "2" Then								'정정
				If szData = "1" Then
					grdList.SetCellData("bd_cell2", iCnt, "매도정정")
					grdList.SetCellFgColor("bd_cell2", iCnt, "11")
				Else
					grdList.SetCellData("bd_cell2", iCnt, "매수정정")
					grdList.SetCellFgColor("bd_cell2", iCnt, "10")
				End If
				
			ElseIf szData2 = "3" Then								'취소
				If szData = "1" Then
					grdList.SetCellData("bd_cell2", iCnt, "매도취소")
					grdList.SetCellFgColor("bd_cell2", iCnt, "11")
				Else
					grdList.SetCellData("bd_cell2", iCnt, "매수취소")
					grdList.SetCellFgColor("bd_cell2", iCnt, "10")
					
				End If
				
			Else
				If szData = "1" Then
					grdList.SetCellFgColor("bd_cell2", iCnt, "11")
				Else
					grdList.SetCellFgColor("bd_cell2", iCnt, "10")
				End If
			End If
			
			'처리구분
			szData = grdList.GetCellData( "bd_cell10", iCnt)
			
			Select Case szData
				Case "0" grdList.SetCellData("bd_cell8", iCnt, "미접수")
				Case "1" grdList.SetCellData("bd_cell8", iCnt, "접수")
				Case "2" grdList.SetCellData("bd_cell8", iCnt, "확인")
				Case "3" grdList.SetCellData("bd_cell8", iCnt, "거부")
				Case "4" grdList.SetCellData("bd_cell8", iCnt, "PT효력정지")
			End Select
		next
	end if
End Sub

