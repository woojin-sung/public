'============================================================================
' 거래소코드 -> 거래소벤더코드 변환
'============================================================================
Function Transform_Name(sValue)
	if sValue == "0104" then	' 홍콩
		return "홍콩"
	elseif sValue == "0529" then ' 항셍 지수
		return "항셍"
	elseif sValue == "0215" then ' 상해
		return "상해"
	elseif sValue == "0214" then ' 심천거래소 종목
		return "심천"
	elseif sValue == "0321" then ' 뉴욕
		return "뉴욕"
	elseif sValue == "0066" then ' 아멕스
		return "아멕스"
	elseif sValue == "0537" then ' 나스닥
		return "나스닥"
	elseif sValue == "0130" then ' 미국 OTCBB
		return "미국 OTCBB"
	elseif sValue == "0625" then ' S&P 지수
		return "S&P"
	elseif sValue == "0310" then ' 다우존스 지수
		return "다우존스"
	elseif sValue == "0106" then ' 도쿄
		return "도쿄"
	elseif sValue == "0107" then ' 오사카거래소 종목
		return "오사카"
	elseif sValue == "0112" then ' 자스닥거래소 종목
		return "자스닥"
	elseif sValue == "0889" then ' 니케이 지수
		return "니케이"
	elseif sValue == "0538" then ' 미국 나스닥 지수
		return "미국 나스닥"
	elseif sValue == "XSTC" then ' 베트남 호치민
		return "호치민"
	elseif sValue == "HSTC" then ' 베트남 하노이
		return "하노이"
		
'20201218 SWJ START : 오프라인 주문 거래국가 추가		
	elseif sValue == "0627" then ' 영국GBP
         return "런던"
	elseif sValue == "XLON" then ' 영국USD
		return "런던인터내셔날"
	elseif sValue == "0762" then ' 독일
	     return "독일"
	elseif sValue == "XHEL" then ' 핀란드
		return "헬싱키"
	elseif sValue == "0787" then
		if szMarket == "12" Then '프랑스
			return "프랑스"
	     elseif szMarket == "13" Then '벨기에
			return "브뤼셀"
		elseif szMarket == "14" Then '네덜란드
			return "암스테르담"
		elseif szMarket == "15" Then '포르투갈
			return "리스본"
		end if
	elseif sValue == "ASEX" then ' 그리스
		 return "아테네"
	elseif sValue == "XDUB" then ' 아일랜드
		 return "더블린"
	elseif sValue == "XMIL" then ' 이탈리아
		 return "이탈리아"
	elseif sValue == "0216" then ' 스페인
		 return "스페인"
	elseif sValue == "XWBO" then ' 오스트리아
		 return "빈"
'20201218 SWJ END
	
	end if
end Function

'============================================================================
' Set_Unit
'============================================================================
Function Set_Unit(szData, sDecimal)
	
	sztemp = CStr(szData)
	szChk = InStr(sztemp, ".")
	sDecimal = CStr(CInt(sDecimal))
	
	if CStr(szChk) == "0" then
		if sDecimal = "1" then
			sztemp = sztemp & ".0"	
		elseif sDecimal = "2" then
			sztemp = sztemp & ".00"	
		elseif sDecimal = "3" then
			sztemp = sztemp & ".000"	
		elseif sDecimal = "4" then
			sztemp = sztemp & ".0000"	
		end if 
	else
		szCha = CInt(Len(sztemp) - szChk)
	
	
		if CStr(szCha) == "1" then 
			if sDecimal == "2" then
				sztemp = sztemp & "0"	
			elseif sDecimal == "3" then
				sztemp = sztemp & "00"	
			elseif sDecimal == "4" then
				sztemp = sztemp & "000"
			else 
				sztemp = sztemp
			end if 	
		elseif CStr(szCha) == "2" then 
			if sDecimal == "3" then
				sztemp = sztemp & "0"	
			elseif sDecimal == "4" then
				sztemp = sztemp & "00"
			else
				sztemp = sztemp
			end if	
		elseif CStr(szCha) == "3" then 
			if sDecimal == "4" then
				sztemp = sztemp & "0"
			else 
				sztemp = sztemp
			end if	
		else
			sztemp = sztemp
		end if
	end if
	
	return sztemp
End Function

'============================================================================
' 전체/매수/매도
'============================================================================
Function Get_DealClsCode()
	nIndex = rdoMedosu.currentindex
	
	Dim szDealClsCode
	
	Select Case nIndex
		Case "0"
			szDealClsCode = "%"
		Case "1"
			szDealClsCode = "2"
		Case "2"
			szDealClsCode = "1"
	End Select
	
	return szDealClsCode
End Function

'============================================================================
' 전체/청산/신규
'============================================================================
Function Get_NewClrnClcd()
	nIndex = rdoNEW.currentindex
	
	Dim szNewClrnClcd
	
	Select Case nIndex
		Case "0"
			szNewClrnClcd = "%"
		Case "1"
			szNewClrnClcd = "1"
		Case "2"
			szNewClrnClcd = "2"
	End Select
	
	return szNewClrnClcd
End Function

'============================================================================
' 전체/체결/미체결
'============================================================================
Function Get_CntgClsCode()
	nIndex = rdoCNTG.currentindex
	
	Dim szCntgClsCode
	
	Select Case nIndex
		Case "0"
			szCntgClsCode = "%"
		Case "1"
			szCntgClsCode = "1"
		Case "2"
			szCntgClsCode = "2"
	End Select
	
	return szCntgClsCode
End Function


