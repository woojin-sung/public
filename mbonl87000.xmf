'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szAccountNumber	'계좌번호 8글자
Dim g_szAccountSerialNumber	'계좌일련번호 2글자
Dim g_szAccountPassword	'계좌 비밀번호
Dim g_szAllData	'계좌 + 일련번호 + 비밀번호


Dim g_szPros, g_szSVCD, g_szAPRV
Dim g_szEmailpros, g_szEmailSVCD, g_szEmailAPRV
Dim g_szARCD, g_szTONO, g_szCPNO
Dim g_szInagTypeCode, g_szInagSrno

Dim	g_PlainRm 'v001

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'============================================================================
' cmbAccount_ChangeAccount
'============================================================================
Sub cmbAccount_ChangeAccount()
	g_szAccountNumber = cmbAccount.total
	edtPassword.caption = ""
'	g_szAccountPassword = Form.GetEncData(edtPassword.caption) 'v001
	'v001
	If g_PlainRm = "1" Then '보안모듈 적용
		g_szAccountPassword = edtPassword.caption
	Else
		g_szAccountPassword = Form.GetEncData(edtPassword.caption)
	End If
	
	fmtabNotificationService_OnTabChanged(fmtabNotificationService.currenttab)
End Sub

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v001
	
	g_szAccountNumber = cmbAccount.total
'	g_szAccountPassword = Form.GetEncData(edtPassword.caption) 'v001
	'v001
	If g_PlainRm = "1" Then '보안모듈 적용
		g_szAccountPassword = edtPassword.caption
	Else
		g_szAccountPassword = Form.GetEncData(edtPassword.caption)
	End If
	
	g_szAllData = cmbAccount.total & "★" & cmbAccount.sequence & "★" & edtPassword.caption
	Form.triggerEvent("fmtabNotificationService." & fmtabNotificationService.currenttabpageid, "AccountData", g_szAllData)
	Form.triggerEvent( "fmtabNotificationService."& fmtabNotificationService.currenttabpageid, "PASSWORD", g_szAccountPassword )
End Sub

'============================================================================
' edtPassword_OnEditComplete
'============================================================================
Sub edtPassword_OnEditComplete()
'	g_szAccountPassword = Form.GetEncData(edtPassword.caption) 'v001
	'v001
	If g_PlainRm = "1" Then '보안모듈 적용
		g_szAccountPassword = edtPassword.caption
	Else
		g_szAccountPassword = Form.GetEncData(edtPassword.caption)
	End If
	Form.triggerEvent("fmtabNotificationService." & fmtabNotificationService.currenttabpageid, "AccountData", g_szAllData)
	Form.triggerEvent( "fmtabNotificationService."& fmtabNotificationService.currenttabpageid, "PASSWORD", g_szAccountPassword )
End Sub

'============================================================================
' fmtabNotificationService_OnTabChanged
'============================================================================
Sub fmtabNotificationService_OnTabChanged(nCurrentTab)
'	g_szAccountPassword = Form.GetEncData(edtPassword.caption) 'v001
	'v001
	If g_PlainRm = "1" Then '보안모듈 적용
		g_szAccountPassword = edtPassword.caption
	Else
		g_szAccountPassword = Form.GetEncData(edtPassword.caption)
	End If
	
	g_szAllData = cmbAccount.total & "★" & cmbAccount.sequence & "★" & edtPassword.caption
	
	Form.triggerEvent("fmtabNotificationService." & fmtabNotificationService.currenttabpageid, "AccountData", g_szAllData)
	Form.triggerEvent( "fmtabNotificationService."& fmtabNotificationService.currenttabpageid, "PASSWORD", g_szAccountPassword )
End Sub




'============================================================================
' Container1_btnCancel_OnClick
'============================================================================
Sub Container1_btnCancel_OnClick()
	if g_szAccountPassword == "" then
		Form.MsgBox("알림", "계좌 비밀번호를 입력하세요.", "", 0)
		exit sub
	end if
	
	Form.MsgBox("알림", "알리미 서비스 약정을 해지하시겠습니까?", "btnCancelOK", 1)
End Sub


'============================================================================
' Container1_btnEnroll_OnClick - 신청
'============================================================================
Sub Container1_btnEnroll_OnClick()
	if g_szAccountPassword == "" then
		Form.MsgBox("알림", "계좌 비밀번호를 입력하세요", "", 0)
		exit sub
	end if
	
	if Container0.GridPro0.rowcount < "1" then
		Form.MsgBox("알림", "등록 할 휴대폰 번호가 없습니다.", "", 0)
		exit sub
	end if
	
	Container0.Grid0.SetClear( )
	
	for i=0 to Container0.GridPro0.rowcount-1
		if Container0.GridPro0.GetCellData( "bd_cell2" , i ) <> "" then
			Container0.Grid0.insertrow = 0
			Container0.Grid0.SetCellData( "bd_cell0", i, Container0.GridPro0.GetCellData( "bd_cell0", i ) )
			Container0.Grid0.SetCellData( "bd_cell1", i, Container0.GridPro0.GetCellData( "bd_cell2", i ) )
			Container0.Grid0.SetCellData( "bd_cell2", i, Container0.GridPro0.GetCellData( "bd_cell3", i ) )
		end if	
	next
	Call TR_Inquiry("obpds_srvc_030a")	'선택SMS약정
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INFO_CLICK" then
		Form.OpenFramePopup("mbonl87000_p1" , "" , "")
	end if
	
End Sub

