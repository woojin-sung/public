'============================================================================
' 화 면 명 : 권리화면_기간
' 화면설명 : 권리화면의 기간선택 팝업창
' 작    성 : 2023.09.12 KKM
'============================================================================

Dim g_szDate
g_szDate = "%"

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()
	if szData <> "" then
		cldFromDate.caption = Left(szData, 8)
		cldToDate.caption = Right(szData, 8)
		RgDateType.currentindex = 2
		cldFromDate.enable = "1"
	else		
	end if

End Sub

'============================================================================
' Form_OnFormClose 
'============================================================================
Sub Form_OnFormClose()
	'Form.SendReturnToParent("DATE_SET", cldFromDate.caption & " ~ " & cldToDate.caption)
End Sub

'============================================================================
Sub RgDateType_OnClick(nIndex)
	if nIndex == 0 then      '6개월
		cldFromDate.enable = "0"
		cldFromDate.caption = Left(Form.calcDateTime( nYear, -6, nDay, nHour, nMinute, nSecond ), 8)		
	elseif nIndex == 1 then  '1년
		cldFromDate.enable = "0"
		cldFromDate.caption = Left(Form.calcDateTime( -1, 0, nDay, nHour, nMinute, nSecond ), 8)		
	elseif nIndex == 2 then  '직접입력
		cldFromDate.enable = "1"
	end if
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnSave_OnClick()
'	if  CInt(cldFromDate.caption) > CInt(cldToDate.caption) then
'msgbox "종료날짜가 시작날짜보도 과거입니다."			
'	end if 
	'매매유형선택 알림
	Form.SendReturnToParent("DATE_SET", cldFromDate.caption & " ~ " & cldToDate.caption)
	Form.CloseForm()	
End Sub

