	<SCRIPT_INFO _len="3763" _ulen="3461" >

Dim g_tData
Dim g_szCode
Dim g_szOrderData	'20230403 SWJ START
'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
'		Form.ShowAlert("11", szOpenData)
		'0 종목명
		'1 평가금액
		'2 매입금액
		'3 평가손익
		'4 수익률
		'5 잔고구분
		'6 증거금율
		'7 체결잔고
		'8 매입단가
		'9 종목코드
		'10 통화
		g_tData = Split(szOpenData, "☆")
		
		lblName.caption = g_tData[5].." "..g_tData[0]
		If Trim(g_tData[5]) == "매수" Then
			lblName.changeTextAttr(0, 2, 6, 4, false)
			
			szTabChange = "2" 	'주문화면 청산 탭에서 set을 위한
			
			btnTrade.caption = "추가매수"
			btnTrade.btnimage = "btn_etc10.9.png"
			
		ElseIf Trim(g_tData[5]) == "매도" Then
			lblName.changeTextAttr(0, 2, 7, 4, false)
			
			szTabChange = "1" 	'주문화면 청산 탭에서 set을 위한

			btnTrade.caption = "추가매도"
			btnTrade.btnimage = "btn_etc11.9.png"
		End If
		
		tbl0.SetCellString(0, 2, g_tData[1])
		
		tbl1.SetCellString(0, 1, g_tData[2])
		tbl1.SetCellString(1, 1, g_tData[3])
		If Left(g_tData[3], 1) == "+" Then
			tbl1.SetCellFgColor(1, 1, "1")
		ElseIf Left(g_tData[3], 1) == "-" Then
			tbl1.SetCellFgColor(1, 1, "2")
		End If
		
		tbl1.SetCellString(2, 1, g_tData[4])
		If Left(g_tData[4], 1) == "+" Then
			tbl1.SetCellFgColor(2, 1, "1")
		ElseIf Left(g_tData[4], 1) == "-" Then
			tbl1.SetCellFgColor(2, 1, "2")
		End If

		tbl2.SetCellString(0, 1, g_tData[5])
		tbl2.SetCellString(1, 1, g_tData[6])
		tbl2.SetCellString(2, 1, g_tData[7])
		tbl2.SetCellString(3, 1, g_tData[8])
'		tbl2.SetCellString(3, 2, g_tData[10])
		
		g_szCode = g_tData[9]
		
		'20230407 SWJ START
		'종목코드 파싱 관련 재가공
'		If InStr(g_szCode, ".") <> 0 Then
'			Dim tTemp
'			tTemp = Split(g_szCode, ".")
'			g_szCode = tTemp[1] & "@" & tTemp[0]
'		End If
		'20230407 SWJ END
		
		g_szOrderData = g_szCode & "★" & g_tData[7] & "♥" & szTabChange & "♥" & "" & "♥" & "" & "♥" & ""
	End If
End Sub

'============================================================================
Sub btnPrice_OnClick()
	Dim szData
	
	'20230407 SWJ START: 종목코드 "." 파싱 오류 수정
	sztempExid = Right(g_szCode,len(g_szCode) - instrRev(g_szCode,"."))			
	sztempCode = Replace(g_szCode,"." & sztempExid,"")
					
	szLinkCode = sztempExid & "@" & sztempCode
	'20230407 SWJ END
	
	szData = szLinkCode & "★" & g_tData[0]
	
	Form.OpenScreen("16100" , szData )
End Sub

'============================================================================
Sub btnTrade_OnClick()
	Dim szOrderData, szTab
	If Trim(g_tData[5]) == "매수" Then
		szTab = "0"			'주문화면 탭 
	Else
		szTab = "1"
	End If
	
	'기타★탭순서★종목코드★종목명
	Form.OpenScreen("16200" , "기타" & "★" & szTab & "★" & g_szCode & "★" & g_tData[0] )
End Sub

'============================================================================
Sub btnSell_OnClick()
	Dim szOrderData, szPosType
	If Trim(g_tData[5]) == "매수" Then
		szPosType = "2"
		szChangeType = "1"
	Else
		szPosType = "1"
		szChangeType = "0"
	End If
	
	'20230403 SWJ START
	Form.OpenScreen("16200" , "잔고" & "★" & "2" & "★" & g_szOrderData )	
	g_szOrderData = ""
	'szOrderData = g_szCode & "★" & g_tData[7] & "♥" & szPosType & "♥" & "" & "♥" & "" & "♥" & ""
	'Form.OpenScreen("16200" , "계좌평가" & "★" & "2" & "★" & g_szCode & "★" & g_tData[0] & "★" & g_tData[7] & "★" & szChangeType )
	'20230403 SWJ END
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
