		<LABEL name="lblTitle" fontsize="3" caption="Bond365" bgcolor="320:255255255" click="1" ly_vert="40,6,222,30,1" />
		<LABEL name="lblStats" fontsize="-2" caption="보유/주문현황" halign="2" paddinginfo="1,0,0,0" click="1" ly_vert="260,6,97,30,1" />
		<IMAGE name="imgStats" autosize="1" imgpath="icon_receipt" ly_vert="248,11,18,18,1" />
		<FORMTAB name="fmtab0" tabcount="4" tabwidthtype="1" tabheadheight="48" ly_vert="0,40,375,562,1" >
			<PAGE name="page004548" caption="Home" linkfile="mbonl90001" loadingtype="1" />
			<PAGE name="page005122" caption="단기사채" linkfile="mbonl88060" loadingtype="1" />
			<PAGE name="page009680" caption="채권(장외)" linkfile="mbonl90201" loadingtype="1" />
