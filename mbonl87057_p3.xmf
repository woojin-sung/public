'============================================================================
Sub Combo1_OnEditComplete(iIndex)
'"1" : 해외주식+해외ETP 해지하기, "2" : 해외ETP 해지하기, "3" : 해외주식 해지하기
	if iIndex == 0 then  '해외주식 해지하기
		g_bType = "3"
		'계좌 비밀번호 팝업 호출
		Form.openPopupAnimation("pwdcheckpopup", g_szAcno & g_szAsno & "☆", "", "2")
		'Form.SetTimerEvent(1, 1, 1)
		
	elseif iIndex == 1 then  '해외ETP 해지하기
		g_bType = "2"
		'계좌 비밀번호 팝업 호출
		Form.openPopupAnimation("pwdcheckpopup", g_szAcno & g_szAsno & "☆", "", "2")
		'Form.SetTimerEvent(1, 1, 1)
	end if 
		
End Sub

'============================================================================
Sub Combo2_OnEditComplete(iIndex)
	if iIndex == 0 then '해외주식 해지하기 + 해외ETP 해지하기
		g_bType = "1"
		'계좌 비밀번호 팝업 호출
		Form.openPopupAnimation("pwdcheckpopup", g_szAcno & g_szAsno & "☆", "", "2")
		'Form.SetTimerEvent(1, 1, 1)
	elseif iIndex == 1 then  '해외ETP 해지하기
		g_bType = "2"
		'계좌 비밀번호 팝업 호출
		Form.openPopupAnimation("pwdcheckpopup", g_szAcno & g_szAsno & "☆", "", "2")
		'Form.SetTimerEvent(1, 1, 1)
	end if	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent(sTimerID, 0, 1)
	if sTimerID == "1" then
		'계좌 비밀번호 팝업 호출
		Form.openPopupAnimation("pwdcheckpopup", g_szAcno & g_szAsno & "☆", "", "2")
	end if 
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "Close_Click" then
		Form.CloseForm()
	end if 
End Sub

