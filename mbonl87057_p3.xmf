'============================================================================
' 01. 화 면 명 : 해외주식/ETP 거래 약정 신청 통합 탭
' 02. 화면설명 : 해외주식/ETP 거래 약정 신청 통합 탭
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCust_Num
Dim g_PlainRm
Dim g_szSelectSrno, g_szAcno, g_szAsno

dim g_bType 	'작업유형   "1" : 해외주식+해외ETP 해지하기, "2" : 해외ETP 해지하기, "3" : 해외주식 해지하기

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
Function f_AddGridRegCell()
	cont0.Grid0.AddRow()
	cont0.Grid0.SetCellData("bd_acntinfo", CInt(cont0.Grid0.rowcount)-1, "서비스 신청 후 거래가 가능해요.\n거래하실 계좌를 등록해 주세요.")
	cont0.Grid0.SetCellData("bd_btn", CInt(cont0.Grid0.rowcount)-1, "+")
	cont0.Grid0.SetCellFgColor( "bd_btn", CInt(cont0.Grid0.rowcount)-1, "13" )	
	cont0.Grid0.SetCellData("bd_btn2", CInt(cont0.Grid0.rowcount)-1, "+")
	cont0.Grid0.SetCellFgColor( "bd_btn2", CInt(cont0.Grid0.rowcount)-1, "13" )	
End Function

'============================================================================
Function f_SetGrdHeight()
	dim nGrd_H, nGrdCell_H
	nGrdCell_H = 95
	nGrd_H = CInt(cont0.Pannel0.rowcount) * nGrdCell_H
	cont0.Pannel0.height = nGrd_H	
End Function

'============================================================================
Function f_SetBtmContTop()
	' 항상 보이게 수정
	cont0.contBtm.visible = true
	if CInt(cont0.Grid0.rowcount) == 0 then '신청내역이 한 건도 없는 경우
		cont0.contBtm.top = 0
		cont0.lblEnd.top = CInt(cont0.contBtm.height)	
	else
		cont0.contBtm.top = CInt(cont0.Pannel0.height)
		cont0.lblEnd.top = CInt(cont0.Pannel0.height) +  CInt(cont0.contBtm.height)	
	end if 
	
End Function

'============================================================================
Sub Form_OnFormInitBefore()
	imgTitle.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()

	Dim szData
	szData = Form.GetOpenLinkData()
'szData = "1992081402"	
'szData = "3008432105"	
	'주문화면 및 예약주문에서 사용함.
	if Trim(szData) <> "" then
		Form.OpenPopup("mbonl87057_p1", szData, "")
	end if 

	'해외주식 공지팝업
	f_EventPopup()

	'암호화 버전
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE )
	cont0.Grid0.setUseCardView(true, 10, "img_bgbox.9.png")
	'고객번호
	dim szCust_Num
	szCust_Num = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
	
	dim szScreenNo
	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )  
	if szScreenNo == "87057" then '해외(주식,ETP)거래 신청
		lblTitle.caption = "해외(주식,ETP)거래 신청"
	end if 

'	'-----------------------------------------------
'	' 타이틀 초기화
'	'-----------------------------------------------
'	Dim nWidth
'	lblTitle.paddinginfo = "0,0,0,0"
'	
'	nWidth = Form.GetTextWidth(lblTitle.caption, 3, false, false)	
'	imgTitleArrow.maintainratio = "2" 
'	imgTitleArrow.imgpath = "icon_arrow_down2"
'	imgTitleArrow.visible = true
'	imgTitleArrow.left = 47 + nWidth + 10	
'	
'	'-----------------------------------------------
'	' 뒤로가기 버튼 초기화
'	'-----------------------------------------------
'	imgBack.SetMaintainingRatio("2")
'	imgBack.imgpath = "icon_main_01"
	
	if szCust_Num <> "" and szCust_Num <> null then
		g_szCust_Num = szCust_Num
		DATAMANAGER.RequestTranData( "obpds_srvc_056r" )
	end if
	
End Sub

'============================================================================
' 해외주식 공지팝업
'============================================================================
function f_EventPopup()
    Dim szEndDate
    Dim szToday
    Dim szDate
    Dim nDiffDay
    
    szEndDate = "20180731"                            ' 팝업노출일
    szToday = Form.GetSharedData("&HOST_DATE", false )    ' 현재일
    szDate = Form.GetEnvData("EVENT_DATE_YH")            ' 일주일간 열지 않기 체크한 날짜
    
    if tonumber(Form.DiffDate(szToday, szEndDate)) >= 0 then
        if szDate == null or szDate == "" then
            Form.OpenPopup("popup_noti", "" , "")
        else
            nDiffDay =  tonumber(Form.DiffDate(szDate, szToday))
            if nDiffDay > 7 then
                Form.SetEnvData("EVENT_DATE_YH", "")
                Form.OpenPopup("popup_noti", "" , "")
            end if
        end if
    end if
end function

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName ==  "mbonl87057_p2_end" then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obpds_srvc_056r" ) '재조회
		end if
		g_bType = ""	
	elseif sKeyName == "CORRECT_PWD" then
		if sRet <> "" and sRet <> null then
			Dim szTranID, tData, szPwd
			tData = Split(sRet,"★")
			if CInt(tData(1)) > 3 then
				'패스워드 암호화여부
				If g_PlainRm = "1" Then
					szPwd = tData(0)
				Else
					szPwd = Form.GetEncData(tData(0))
				End If
			else
				Exit Sub
			end if
			
			dim szCust_Num
			szCust_Num = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴

			if g_bType == "3" then '해외주식 해지하기
				szTranID = "obpds_srvc_045a"
				Dim sProsDate, sProsSrno 
				sProsDate = Form.GetSharedData( "PROS_DATE", false )
				sProsSrno = Form.GetSharedData( "PROS_SRNO", false )
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"		, 0 , "D")			'처리구분(I등록, D해지)
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" 			, 0 , szPwd)			'계좌비밀번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" 				, 0 , szCust_Num)		'고객번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 				, 0 , g_szAcno)		'계좌번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 				, 0 , g_szAsno)		'계좌일련번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" 				, 0 , "082")			'서비스 코드
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_SRNO"			, 0 , g_szSelectSrno)	'서비스 일련번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_MANG_UNIT_CODE"	, 0 , "02")			'서비스 관리 단위코드(02계좌)
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID"				, 0 , Form.GetSharedData("&USER_ID" , false))	'HTS ID
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE" 		, 0 , "4")			'접촉 구분코드(4온라인)
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_DATE", 0, sProsDate)	'처리일자
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_SRNO", 0, sProsSrno)	'처리일련번호
				
			elseif g_bType == "2" then '해외ETP 해지하기
				szTranID = "obpds_srvc_045a"
				Dim sProsDate, sProsSrno 
				sProsDate = Form.GetSharedData( "PROS_DATE", false )
				sProsSrno = Form.GetSharedData( "PROS_SRNO", false )
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"		, 0 , "D")			'처리구분(I등록, D해지)
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" 			, 0 , szPwd)			'계좌비밀번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" 				, 0 , szCust_Num)		'고객번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 				, 0 , g_szAcno)		'계좌번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 				, 0 , g_szAsno)		'계좌일련번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" 				, 0 , "083")			'서비스 코드
				'DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_SRNO"			, 0 , g_szSelectSrno)	'서비스 일련번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_SRNO"			, 0 , edtSvcrNo.caption)	'서비스 일련번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_MANG_UNIT_CODE"	, 0 , "01")			'서비스 관리 단위코드(01고객)
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID"				, 0 , Form.GetSharedData("&USER_ID" , false))	'HTS ID
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE" 		, 0 , "4")			'접촉 구분코드(4온라인)
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_DATE", 0, sProsDate)	'처리일자
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_SRNO", 0, sProsSrno)	'처리일련번호
				
			elseif g_bType == "1" then '해외주식+해외ETP 해지하기, 해외주식 해지하기 		
				szTranID = "obpds_srvc_183a"				
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"		, 0 , "D")			'처리구분(I등록, D해지)
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" 				, 0 , szCust_Num)		'고객번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" 				, 0 , "082")			'서비스 코드
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_SRNO"			, 0 , g_szSelectSrno)	'서비스 일련번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVC_MANG_UNIT_CODE"	, 0 , "03")			'서비스 관리 단위코드(03상품)
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" 				, 0 , g_szAcno)		'계좌번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 				, 0 , g_szAsno)		'계좌일련번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID"				, 0 , Form.GetSharedData("&USER_ID" , false))	'HTS ID
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" 			, 0 , szPwd)			'계좌비밀번호
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONT_CLS_CODE" 		, 0 , "4")			'접촉 구분코드(4온라인)
				'해외ETP거래약정여부
'				if g_bType == "3" then
'					DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_ETP_TR_STPL_YN" 	, 0 , "N")		
'				else
					DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_ETP_TR_STPL_YN" 	, 0 , "Y")		
					DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_ETP_SVC_SRNO", 0,  edtSvcrNo.caption)	'UIETP서비스일련번호					
'				end if 
				'해외주식거래약정여부
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_STCK_TR_STPL_YN"	, 0 , "Y")			
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STND_DATE" 			, 0 , Calendar0.caption) '기준일자
			end if 	
			
			DATAMANAGER.RequestTranData( szTranID )
			
		else
			g_szSelectSrno = ""
			g_szAcno = ""
			g_szAsno = ""
		end if
		'g_bType = ""	
	end if
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "mbonl87057_p2_end" then
		DATAMANAGER.RequestTranData( "obpds_srvc_056r" )		
	end if 	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obpds_srvc_056r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "MANG_BRCD" , 0 , "%"	)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_PRD_CLCD" , 0 , "02"	)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STA_DATE" , 0 , "00010101"	)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FIN_DATE" , 0 , Form.GetSharedData("&HOST_DATE", false ))	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "082"	) '해외주식거래			
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , g_szCust_Num)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STPL_STAT_CLS_CODE" , 0 , "01")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , "0")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , "%")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "EXLS_YN" , 0 , "N")
	elseif szTranID == "obpds_srvc_323r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 0 , "")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 0 , "")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "083"	) ''해외ETP거래			
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 0 , g_szCust_Num)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obpds_srvc_056r" then '해외주식거래신청 조회
		Dim nRowCnt
		nRowCnt = CInt(cont0.Grid0.rowcount)	
		if nRowCnt == 0 then
			cont0.Pannel0.rowcount = 0
			f_SetBtmContTop()
			cont0.SetScrollAutoSize()
			g_szSelectSrno = ""
			g_szAcno = ""
			g_szAsno = ""				
			Exit Sub
		end if 

		dim szAcntInfo, szProdCd, szProdText, szAcntInfo, szSrNo
		cont0.Pannel0.rowcount = nRowCnt	
		for i=0 to nRowCnt-1	
			cont0.Pannel0.SetCellVisible("btnCancelAll", i, 0) '해지하기  
			cont0.Pannel0.SetCellVisible("btnCancel", i, 1)  '해외주식 해지
			cont0.Pannel0.SetCellVisible("btnReq", i, 1)  	  'ETP신청"
			
			'082: 해외주식거래, 084: 해외ETP거래, 081: 통합증거금, 079: 해외소수점거래	
			'szSvCd = cont0.Grid0.GetCellData("bd_svcd", i) '서비스코드
			szTotal = cont0.Grid0.GetCellData("bd_total", i)
			szSequence = cont0.Grid0.GetCellData("bd_sequence", i)
			szProdCd = cont0.Grid0.GetCellData("bd_product", i)		
			szProdText = Form.GetMetaData("상품코드", szProdCd)
			szAcntInfo = "["&szProdText&"] "&Left(szTotal, 4)&"-"&Right(szTotal, 4)&"-"&szSequence
			cont0.Pannel0.SetCellValue("lblAccount", i, szAcntInfo)  '계좌번호
			cont0.Pannel0.SetCellValue("lblAccount0", i, szTotal&szSequence)  '계좌번호(- 뺀)
			
			szSrNo = cont0.Grid0.GetCellData( "bd_srno", i)
			cont0.Pannel0.SetCellValue("lblSrno", i, szSrNo) 			
		next			
			
		f_SetGrdHeight()
		f_SetBtmContTop()
		cont0.SetScrollAutoSize()
		g_szSelectSrno = ""
		g_szAcno = ""
		g_szAsno = ""	
		
		DATAMANAGER.RequestTranData( "obpds_srvc_323r" ) 'ETP 신청여부

	ElseIf szTranID == "obpds_srvc_323r" then '해외 ETP거래신청 조회		
		dim szAprvYN, nSvcSrno
		szAprvYN	= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "APRV_YN" , 0))
		nSvcSrno = CDbl(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SVC_SRNO" , 0))
		edtSvcrNo.caption = nSvcSrno 
'		If (szAprvYN = "Y" and nSvcSrno > 0) Then
'			f_SetGridCellDataETP() '해외ETP 버튼활성화'			
'		ElseIf szAprvYN = "N" and nSvcSrno > 0 Then
'			f_SetGridCellDataETP() '해외ETP 버튼활성화
		if (nSvcSrno > 0) and (szAprvYN = "Y" or szAprvYN = "N") then 
			Dim nRowCnt
			nRowCnt = cont0.Pannel0.rowcount			
			for i=0 to nRowCnt-1	
				cont0.Pannel0.SetCellVisible("btnCancelAll", i, 1) '해지하기  
				cont0.Pannel0.SetCellVisible("btnCancel", i, 0)    '해외주식 해지
				cont0.Pannel0.SetCellVisible("btnReq", i, 0)  	 'ETP신청"
			next			
		Else
              '비활성화   
		End If
		
	ElseIf szTranID == "obpds_srvc_183a" Then  '해외주식+해외ETP 해지하기
		Form.ShowAlert("알림", "해외(주식,ETP)거래 약정이\n해지되었습니다.")
		
		DATAMANAGER.RequestTranData( "obpds_srvc_056r" ) '재조회
		
	ElseIf szTranID == "obpds_srvc_045a" Then  '해외ETP 해지하기		
		Form.SetSharedData( "PROS_DATE", "" )
		Form.SetSharedData( "PROS_SRNO", "" )
		
		'작업유형   "1" : 해외주식+해외ETP 해지하기, "2" : 해외ETP 해지하기, "3" : 해외주식 해지하기	
		if g_bType == "3" then
			Form.ShowAlert("알림", "해외주식거래 약정이\n해지되었습니다.")
		else	
			Form.ShowAlert("알림", "해외ETP거래 약정이\n해지되었습니다.")
		end if
		
		DATAMANAGER.RequestTranData( "obpds_srvc_056r" ) '재조회
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	'해지메시지 오류메시지 확인필요 :: TODO ppt13
	if szSubMsg <> "" and szSubMsg <> null then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")" )
	else
		Form.ShowAlert("알림", szErrMsg )
	end if 
End Sub

'============================================================================
Sub cont0_Pannel0_OnClick(nIndex, sCellID)
	
	'선택된 계좌정보
	Dim szAcntInfo
	szAcntInfo = cont0.pannel0.GetCellValue( "lblAccount0", nIndex)
	g_szAcno = Left(szAcntInfo, 8)
	g_szAsno = Right(szAcntInfo, 2)	
	g_szSelectSrno = cont0.pannel0.GetCellValue( "lblSrno", nIndex)

	if sCellID == "btnCancelAll" then '해지하기 버튼
'Form.ShowAlert(g_szSelectSrno)
		if g_szSelectSrno <> "" and g_szSelectSrno <> null then	
			if CInt(cont0.Pannel0.rowcount) == 1 then
				Combo2.OpenList()
			else
				Combo1.OpenList()
			end if
		end if 
		
	elseif sCellID == "btnCancel" then '해외해지하기 버튼 183
		'if g_szSelectSrno <> "" and g_szSelectSrno <> null then
			g_bType = "3" '해외주식 해지하기
		'end if 
		Form.openPopupAnimation("pwdcheckpopup", szAcntInfo & "☆", "", "2")
		
	elseif sCellID == "btnReq" then 'ETP신청 버튼 045		
		Form.OpenPopup("mbonl87057_p1", szAcntInfo, "")
	end if	

End Sub

'============================================================================
Sub cont0_contBtm_btnAdd_OnClick()
	Dim szCONO	
	szCONO = Form.GetSharedData("&LOGIN_CUST_CLS_CODE", false) '1: 개인, 2: 법인
	if szCONO == "2" then
		Form.MsgBox("알림", "법인고객은\n온라인신청이 불가합니다.", "Close_Click", 8, "닫기")	
	else
		Form.OpenPopup("mbonl87057_p1", "", "")
	end if 
End Sub

