'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 화상상담 조회/변경
' 02. 화면설명 : 
' 03. 이    력 : 2022.10.21 : 고승연 : v0001 : 신규
'                2023.01.05 : 고승연 : v0002 : [T2301130023] 계좌일련번호 추가
'-------------------------------------------------------------------------------------------

Dim g_sCsno, g_sAcno, g_sAsno, g_sCnrcNo

'============================================================================
Sub Form_OnFormInit()
	grdData.setUseCardView(true, 15, "btn_12_n.9")
	
	g_sCsno = Form.GetSharedData("&CUST_NUM", false)
	
	DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "IQRY_CLS_CODE" , 0 , "5" )
	DATAMANAGER.SetDataValue( 0, "obwat_onln_004r", "InBlock1", "CSNO" , 0 , g_sCsno )
	DATAMANAGER.RequestTranData( "obwat_onln_004r" )
End Sub

'============================================================================
Sub cmbAcnt_OnEditComplete(iIndex)
	grdData.SetClear()
	lblNoData.visible = false
	
	g_sAcno = Left(cmbAcnt.cbkeydata, 8)
	g_sAsno = Right(cmbAcnt.cbkeydata, 2)
			
	if (g_sAcno <> nil and g_sAcno <> "") and (g_sAsno <> nil and g_sAsno <> "") then
		DATAMANAGER.RequestTranData( "obwat_ctad_086r" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obwat_ctad_086r" then
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_086r", "InBlock1", "ACNO" , 0 , g_sAcno )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_086r", "InBlock1", "ASNO" , 0 , g_sAsno )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_onln_004r" then
		Dim nCount
		nCount = DATAMANAGER.GetDataCount( 0, "obwat_onln_004r", "OutBlock1" )
		
		if nCount > 0 then
			for i = 0 to nCount-1
				Dim sAcnt, sAsno, sPrcd, sCnrcNo, sPrcdName
				sAcnt	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "ACNO" , i )
				sAsno	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "ASNO" , i )
				sPrcd	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "PRCD" , i )
				sCnrcNo	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "CNRC_NO" , i )
				sCsnm	= DATAMANAGER.GetDataValue( 0, "obwat_onln_004r", "OutBlock1", "CSNM" , i )
				
				if sPrcd = "100" Then
					sPrcdName = "[종합매매] "
				elseif sPrcd = "118" Then
					sPrcdName = "[CMA] "
				elseif sPrcd = "119" Then
					sPrcdName = "[랩종합] "
				else
					sPrcdName = ""
				end if
				
				cmbAcnt.cbadddatatext = sAcnt..sAsno.."`"..sPrcdName..mid(sAcnt, 1, 4).."-"..mid(sAcnt, 5, 4).."-"..sAsno.." "..sCsnm
			next
			
			cmbAcnt.currentindex = 0
			g_sAcno = Left(cmbAcnt.cbkeydata, 8)
			g_sAsno = Right(cmbAcnt.cbkeydata, 2)
			
		else
			lblAcntNodata.visible = true
			lblNoData.visible = true
		end if
	elseif szTranID == "obwat_ctad_086r" then
		Dim nCount, nIndex
		nCount = DATAMANAGER.GetDataCount( 0, "obwat_ctad_086r", "OutBlock1" )
		nIndex = tonumber(grdData.rowcount)
		grdData.rowcount = nIndex + nCount
		
		if nIndex + nCount == 0 then
			lblNoData.visible = true
		end if
		
		for i = 0 to nCount-1
			Dim sAcno, sAsno, sCode, sName, sDate, sStartTime, sEndTime, sSrno, sKeyDate, sKeySrno
			
			sAcno = DATAMANAGER.GetDataValue( 0, "obwat_ctad_086r", "OutBlock1", "ACNO" , i )
			sAsno = DATAMANAGER.GetDataValue( 0, "obwat_ctad_086r", "OutBlock1", "ASNO" , i )
			sCode = DATAMANAGER.GetDataValue( 0, "obwat_ctad_086r", "OutBlock1", "WA_PRCD" , i )
			sName = DATAMANAGER.GetDataValue( 0, "obwat_ctad_086r", "OutBlock1", "WA_PRNM" , i )
			sDate = DATAMANAGER.GetDataValue( 0, "obwat_ctad_086r", "OutBlock1", "RSEV_APLT_DATE" , i )
			sStartTime = DATAMANAGER.GetDataValue( 0, "obwat_ctad_086r", "OutBlock1", "RSEV_APLT_STA_HOUR" , i )
			sEndTime = DATAMANAGER.GetDataValue( 0, "obwat_ctad_086r", "OutBlock1", "RSEV_APLT_FIN_HOUR" , i )
			sSrno = DATAMANAGER.GetDataValue( 0, "obwat_ctad_086r", "OutBlock1", "RSEV_APLT_SRNO" , i )
			sKeyDate = DATAMANAGER.GetDataValue( 0, "obwat_ctad_086r", "OutBlock1", "NMET_APLT_DATE" , i )
			sKeySrno = DATAMANAGER.GetDataValue( 0, "obwat_ctad_086r", "OutBlock1", "NMET_APLT_SRNO" , i )
			
			grdData.SetCellData("name", nIndex+i, sName)
			grdData.SetCellData("date", nIndex+i, Mid(sDate, 1, 4).."년 "..Mid(sDate, 5, 2).."월 "..Mid(sDate, 7, 2).."일")
			grdData.SetCellData("time", nIndex+i, Mid(sStartTime, 1, 2)..":"..Mid(sStartTime, 3, 2).." ~ "..Mid(sEndTime, 1, 2)..":"..Mid(sEndTime, 3, 2))
			
			grdData.SetCellBgColor("line", nIndex+i, 86)
			
			grdData.SetCellData("datetext", nIndex+i, "예약일자")
			grdData.SetCellData("timetext", nIndex+i, "예약시간")
			
			grdData.SetCellImage("cancel", nIndex+i, "img_bgbox.9.png")
			grdData.SetCellData("cancel", nIndex+i, "예약 취소")
			
			grdData.SetCellImage("trans", nIndex+i, "btn_01_n.9.png")
			grdData.SetCellData("trans", nIndex+i, "예약 변경")
			
			grdData.SetCellData("acno", nIndex+i, sAcno)
			grdData.SetCellData("asno", nIndex+i, sAsno)
			grdData.SetCellData("code", nIndex+i, sCode)
			grdData.SetCellData("datedata", nIndex+i, sDate)
			grdData.SetCellData("starttime", nIndex+i, sStartTime)
			grdData.SetCellData("endtime", nIndex+i, sEndTime)
			grdData.SetCellData("srno", nIndex+i, sSrno)
			grdData.SetCellData("keydate", nIndex+i, sKeyDate)
			grdData.SetCellData("keysrno", nIndex+i, sKeySrno)
		next
		
	elseif szTranID == "obwat_ctad_087a" then
		Form.MsgBox("안내", "예약이 취소되었습니다.", "", 8, "확인", "")
		grdData.SetClear()
		
		if (g_sAcno <> nil and g_sAcno <> "") and (g_sAsno <> nil and g_sAsno <> "") then
			DATAMANAGER.RequestTranData( "obwat_ctad_086r" )
		end if
		
	end if
End Sub

'============================================================================
Sub grdData_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "obwat_ctad_086r" ) then
		DATAMANAGER.RequestNextData( "obwat_ctad_086r" )
	end if
End Sub

'============================================================================
Sub grdData_OnClickUp(lRow, szCellID)
	if szCellID == "cancel" or szCellID == "trans" then
		Dim sAcno, sAsno, sDate, sStartTime, sEndTime, sSrno, sKeyDate, sKeySrno
		
		sAcno = grdData.GetCellData("acno", lRow)
		sAsno = grdData.GetCellData("asno", lRow)
		sDate = grdData.GetCellData("datedata", lRow)
		sStartTime = grdData.GetCellData("starttime", lRow)
		sEndTime = grdData.GetCellData("endtime", lRow)
		sSrno = grdData.GetCellData("srno", lRow)
		sKeyDate = grdData.GetCellData("keydate", lRow)
		sKeySrno = grdData.GetCellData("keysrno", lRow)
		
		if szCellID == "cancel" then '예약취소
			DATAMANAGER.ClearInputData( 0, "obwat_ctad_087a" )
			
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_087a", "InBlock1", "PROS_CLS_CODE" , 0 , "D" ) '예약취소
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_087a", "InBlock1", "ACNO" , 0 , sAcno )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_087a", "InBlock1", "ASNO" , 0 , sAsno )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_087a", "InBlock1", "RSEV_APLT_STA_HOUR" , 0 , sStartTime )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_087a", "InBlock1", "RSEV_APLT_FIN_HOUR" , 0 , sEndTime )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_087a", "InBlock1", "RSEV_APLT_DATE" , 0 , sDate )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_087a", "InBlock1", "RSEV_APLT_SRNO" , 0 , sSrno )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_087a", "InBlock1", "NMET_APLT_DATE" , 0 , sKeyDate )
			DATAMANAGER.SetDataValue( 0, "obwat_ctad_087a", "InBlock1", "NMET_APLT_SRNO" , 0 , sKeySrno )
			
			Form.MsgBox("안내", "화상상담 취소 시 진행중인 Wrap 계약이 취소됩니다. 화상상담 예약을 취소 하시겠습니까?", "cancel", 7, "예약취소", "닫기")
		elseif szCellID == "trans" then '예약변경
			Dim sData
			sData = sAcno.."|"..sAsno.."|"..sDate.."|"..sStartTime.."|"..sEndTime.."|"..sSrno.."|"..sKeyDate.."|"..sKeySrno
			
			Form.OpenPopup("mbwat61040_p1", sData, "")
			
		end if
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "cancel" then
		if sRet == "ok" then
			'v0002
			Form.openPopupAnimation("pwdcheckpopup", g_sAcno & g_sAsno & "☆0" ,"","2")
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "REFRESH" then
		grdData.SetClear()
		lblNoData.visible = false
		
		if (g_sAcno <> nil and g_sAcno <> "") and (g_sAsno <> nil and g_sAsno <> "") then
			DATAMANAGER.RequestTranData( "obwat_ctad_086r" )
		end if
		
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim tData
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				DATAMANAGER.RequestTranData( "obwat_ctad_087a" )
			end if
		end if
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg

	If szTranID == "obwat_ctad_086r" Then
		If szErrCode == "5820" Then
			lblNoData.visible = true
		End If
		
	ElseIf szTranID == "obwat_ctad_087a" Then
		sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
	End If
	
End Sub


