'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	call TR_Query()
End Sub

'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'grd00T3_OnClickUp
'============================================================================
Sub grd00T3_OnClickUp(lRow, szCellID)
	dim szSymbol
	dim szMarket
	dim szName
	
	szSymbol = grd00T3.GetCellData("bd_cell0", lRow)
	szMarket = grd00T3.GetCellData("bd_cell1", lRow)
	szName = grd00T3.GetCellData("bd_cell2", lRow)
	
	Form.OpenFramePopup("mhidx42040_p2" , szSymbol & "★" &  szMarket & "★" & szName , sPosInfo)
	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	dim ncnt1683
	dim szOrgTime
		
	ncnt1683 = DATAMANAGER.GetDataCount(0, "ohhts_1683_001r" , "OutBlock1")
	
	if szTranID = "ohhts_1683_001r" then
		
		for i = 0 to ncnt1683 - 1
			szOrgTime = DATAMANAGER.GetDataValue(0, "ohhts_1683_001r", "OutBlock1", "FID_CNCN_DATE", i)
			if szOrgTime = "" or szOrgTime = null then '20220302 HSZ : 예외처리 추가
				exit Sub
			else
				DATAMANAGER.SetDataValue(0, "ohhts_1683_001r", "OutBlock1", "FID_CNCN_DATE", i , mid(szOrgTIme,3,2) &  mid(szOrgTIme,5,2)  &  mid(szOrgTIme,7,2)  )
			end if
		next	
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim ncnt1683
	dim szRealCode
	
	ncnt1683 = DATAMANAGER.GetDataCount(0, "ohhts_1683_001r" , "OutBlock1")

	if szTranID = "ohhts_1683_001r" then 
		DATAMANAGER.CancelRealData("ohhts_exrt_cntg")
		DATAMANAGER.CancelRealData("ohhts_ovrs_nmix")
		DATAMANAGER.CancelRealData("ohhts_nfut_cntg")
	
		for i = 0 to ncnt1683 - 1
		  szRealCode = DATAMANAGER.GetDataValue(0, "ohhts_1683_001r", "OutBlock1", "FID_CNCN_ISCD", i )
		  
		  DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", i, szRealCode) 
		  DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", i, szRealCode) 
		  DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg", "InBlock1", "FIDR_SYMB", i, szRealCode) 
		  grd00T3.SetCellData("bd_cell8", i, gf_GetForeignCycle(szRealCode))
		Next	    
		
		DATAMANAGER.RequestRealData("ohhts_exrt_cntg")
		DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")
		DATAMANAGER.RequestRealData("ohhts_nfut_cntg")
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveRealData
'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	dim ncntOvrs
	dim ncntNfut
	dim ncntExrt
	dim szOrgTime, szOrgTime2, szOrgTime3
		
	ncntOvrs = DATAMANAGER.GetDataCount(1, "ohhts_ovrs_nmix", "OutBlock1")
	ncntNfut = DATAMANAGER.GetDataCount(1, "ohhts_nfut_cntg", "OutBlock1")
	ncntExrt = DATAMANAGER.GetDataCount(1, "ohhts_exrt_cntg", "OutBlock1")
	
	if szTranID = "ohhts_ovrs_nmix" then
		
		for i = 0 to ncntOvrs - 1
			szOrgTime = DATAMANAGER.GetDataValue(1, "ohhts_ovrs_nmix", "OutBlock1", "FIDR_DATE", i)
			DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "OutBlock1", "FIDR_DATE", i , mid(szOrgTIme,3,2) &  mid(szOrgTIme,5,2)  &  mid(szOrgTIme,7,2)  )
		next	
	end if 

	if szTranID = "ohhts_nfut_cntg" then
		
		for i = 0 to ncntNfut - 1
			szOrgTime2 = DATAMANAGER.GetDataValue(1, "ohhts_nfut_cntg", "OutBlock1", "FIDR_DATE", i)
			DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg", "OutBlock1", "FIDR_DATE", i , mid(szOrgTime2,3,2) &  mid(szOrgTime2,5,2)  &  mid(szOrgTime2,7,2)  )
		next	
	end if 
		

	if szTranID = "ohhts_exrt_cntg" then
		
		for i = 0 to ncntExrt - 1
			szOrgTime3 = DATAMANAGER.GetDataValue(1, "ohhts_exrt_cntg", "OutBlock1", "FIDR_DATE", i)
			DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "OutBlock1", "FIDR_DATE", i , mid(szOrgTime3,3,2) &  mid(szOrgTime3,5,2)  &  mid(szOrgTime3,7,2)  )
		next	
	end if 
End Sub

