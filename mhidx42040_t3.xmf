'============================================================================
'해외 지수/종목 주기를 리턴해준다 . ( 종가 또는 지연)
'============================================================================
Function gf_GetForeignCycle(szCode)
	Select Case szCode  
		Case "DJI@DJI", "NAS@IXIC", "SPI@SPX", "DJI@DJC", "NYS@NYA", "USI@SOXX" '미국
			return "종가"  
		Case  "CME@ND", "CME@NQ", "CME@ES"		', "USI@RUT" '미국 PSM3 2016.12.30 러셀2000지수 삭제 "CME@SP" 20220124 HSZ 주석처리_S&P500선물 삭제
			return"지연(15분)"
		Case "HSI@HSCE", "SHS@000001", "SHS@000002", "SHS@000003","SZS@399107", "SZS@399108", "HSI@HSI"  '아시아
	    		return "지연(15분)"  
		Case "NII@NI225" '아시아 '20180619 HAMWG : 대만 가권지수 데이터제공 변경("TWS@TI01" 삭제)
			return "지연(20분)"    	    
		Case "ILI@TA100" '아시아
			return "종가"  
		Case "NLI@AEX", "PAS@CAC40"   	'유럽(네덜란드 AEX, 프랑스 CAC 40)
			return "종가"
		Case "TRI@ISE100"   			'유럽(터키 ISE100)
			return "지연(15분)"	    
		Case "AUI@AORD" '미주/오세아니아주 
			return "지연(20분)"   
		Case "JPYKRWCOMP","CNYKRWCOMP" '원화포함 환율   "USDKRWSMBS", 
			return "지연(5분)"   
		Case "USDKRWSMBS", "EURUSDCOMP", "USDJPYCOMP","EURJPYCOMP", "GBPUSDCOMP", "USDCHFCOMP", "USDCADCOMP", "AUDUSDCOMP", "USDHKDCOMP", "USDSGDCOMP"  '원화가 없는 이종통화환율 실시간 	
			return "실시간" 	
	End Select
End Function

'============================================================================
'TR_Query
'============================================================================
Function TR_Query()
	DATAMANAGER.SetDataValue(0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE",0 , "FN")
	DATAMANAGER.SetDataValue(0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE",1 ,"FN")
	DATAMANAGER.SetDataValue(0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE",2 , "N")
	DATAMANAGER.SetDataValue(0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE",3 ,"N" )
	DATAMANAGER.SetDataValue(0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE",4 ,"N" )
'	DATAMANAGER.SetDataValue(0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE",5 ,"N" ) '20180619 HAMWG : 대만 가권지수 데이터제공 변경
	DATAMANAGER.SetDataValue(0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE",5 ,"N" )
	DATAMANAGER.SetDataValue(0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE",6 , "EN")
	DATAMANAGER.SetDataValue(0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE",7 ,"EN")
	DATAMANAGER.SetDataValue(0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE",8 ,"EN" )
	DATAMANAGER.SetDataValue(0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE",9 ,"N" )
'  DATAMANAGER.SetDataValue(0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 11, "N")
'  DATAMANAGER.SetDataValue(0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 12, "N")
	'2013-07-01 lkm CME해외지수 종목코드 변경 "CME$ ->  CME@"
	
	DATAMANAGER.SetDataValue( 0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_ISCD", 0 ,  "CME@NQ" )
	DATAMANAGER.SetDataValue( 0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_ISCD", 1 ,  "CME@ES" )
	DATAMANAGER.SetDataValue( 0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_ISCD", 2 ,  "NII@NI225" )
	DATAMANAGER.SetDataValue( 0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_ISCD", 3 ,  "HSI@HSI" )
	DATAMANAGER.SetDataValue( 0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_ISCD", 4 ,  "HSI@HSCE" )
'	DATAMANAGER.SetDataValue( 0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_ISCD", 5 ,  "TWS@TI01" ) '20180619 HAMWG : 대만 가권지수 데이터제공 변경
	DATAMANAGER.SetDataValue( 0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_ISCD", 5 ,  "SHS@000001" )
	DATAMANAGER.SetDataValue( 0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_ISCD", 6 ,  "USDKRWSMBS" )
	DATAMANAGER.SetDataValue( 0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_ISCD", 7 ,  "USDJPYCOMP" )
	DATAMANAGER.SetDataValue( 0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_ISCD", 8 ,  "EURUSDCOMP" )
  ' Call DATAMANAGER.SetDataValue( 0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_ISCD", 10 , "SGI@STI"  ) '싱가폴 STI삭제 2013-07-25 lkm 
     DATAMANAGER.SetDataValue( 0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_ISCD", 9 , "SHS@000003"  )
  ' Call DATAMANAGER.SetDataValue( 0, "ohhts_1683_001r", "InBlock1", "FID_INPUT_ISCD", 12 , "SHS@000003"  )
    
    DATAMANAGER.RequestTranData("ohhts_1683_001r")
 
 end Function

