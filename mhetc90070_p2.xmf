	<SCRIPT_INFO _len="3570" _ulen="3476" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 간편인증 서비스
' 02. 화면설명 : 간편인증 서비스 메인
' 03. 작    성 : 2016.08.05  NOHES
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_spad_sCusNo
Dim g_sID

Dim	g_lRow
	g_lRow = -1

Dim	g_ChoiceID
Dim	g_nCount
'============================================================================
Sub Form_OnFormInit()
	Dim stemp, sRet
	stemp = Form.GetOpenLinkData()
	sRet= Split(stemp, "★")
	
	g_spad_sCusNo = sRet[0]
	g_sID = sRet[1]
	
	DATAMANAGER.SetDataValue(0, "obpds_srvc_312r" , "InBlock1" , "CSNO" , 0 , g_spad_sCusNo)
	DATAMANAGER.RequestTranData( "obpds_srvc_312r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obpds_srvc_312r" Then
		g_nCount = 0
		DATAMANAGER.SetDataValue(0, "obpds_srvc_421r" , "InBlock1" , "CSNO" , 0 , g_spad_sCusNo)
		DATAMANAGER.RequestTranData( "obpds_srvc_421r" )
		
	ElseIf szTranID == "obpds_srvc_421r" Then
		If DATAMANAGER.IsMoreNextData(szTranID) == "1" Then
			g_nCount = g_nCount+DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
			DATAMANAGER.RequestNextData(szTranID)
			Exit Sub
		Else
			g_nCount = g_nCount+DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		End If
		
		For i = 0 To Form.GetCtlProp("GrdID", "rowcount") -1
			sParam = Trim(GrdID.GetCellData("bd_cell0", i) ) 
			GrdID.SetCellData("bd_cell1", i, "미가입")
			
			For u = 0 To DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")-1
				sID = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ELFN_ID" , u)
				If sParam == Trim(sID) Then
					GrdID.SetCellData("bd_cell1", i, "가입")
					Call GrdID_OnClickUp(i, szCellID)
				End If
			Next
		Next
	End If	
End Sub

'============================================================================
Sub GrdID_OnClickUp(lRow, szCellID)
	If g_lRow >= 0 Then
		nIndex = g_lRow%2
		If nIndex = 0 Then
			GrdID.SetCellFgColor("bd_cell0",g_lRow,"4")
			GrdID.SetCellFgColor("bd_cell1",g_lRow,"4")
			
		Else
			GrdID.SetCellFgColor("bd_cell0",g_lRow,"4")
			GrdID.SetCellFgColor("bd_cell1",g_lRow,"4")
		
		End If
	End If
	
	GrdID.SetCellFgColor("bd_cell0", lRow, "10")
	GrdID.SetCellFgColor("bd_cell1",lRow,"10")
	
	if Trim(GrdID.GetCellData("bd_cell1", lRow)) == "가입" Then
		ButtonOK.caption = "재등록"
	elseif Trim(GrdID.GetCellData("bd_cell1", lRow)) == "미가입" Then
		ButtonOK.caption = "추가신청"
	else
		ButtonOK.caption = "확인"
	end if
	
	g_ChoiceID = Trim(GrdID.GetCellData("bd_cell0", lRow)) 
	g_lRow = lRow
	
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	Form.SendReturnToParent("mhetc90070_p2" ,  g_ChoiceID & "★" & ButtonOK.caption  )
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim sRet, sErrorCode, sErrorMsg
	sRet = Split(sParam, "★")
	if #sRet > 1 then
		sErrorCode = sRet[0]
		sErrorMsg = sRet[1]	
	end if

End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

