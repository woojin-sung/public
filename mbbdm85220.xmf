'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	'pwSetYn = ""
	szTheme = Form.GetEnvData("common.theme")
	
	ContMain.Combo0.SetApplyLabel("종합계좌번호"		, 0 ,268  ,"left",true,80)
	'ContMain.Account0.cbtype 		= 4 ' 3:bottomsheet 4:dropdown
	
	ContMain.Editpwd.SetApplyLabel("종합계좌 비밀번호"   , 0 , 268 , "left",true)
	
	ContMain.T1TactLimt.SetApplyLabel   ("1회 이체한도"   , 0, 268  , "left",true)
	ContMain.D1TactLimt.SetApplyLabel   ("1일 이체한도"   , 0 ,268 , "left",true)
	
	ContMain.T1TactLimt.SetUseResultLabel(True,2)
	ContMain.D1TactLimt.SetUseResultLabel(True,2)
	
	T1ResultSize = 0
	D1ResultSize = 0
	
	ContMain.Grid0.SetClear() '현재이체한도
	Form.SetCtlProp("ContMain.Grid0", "insertrow", 0)	'한줄삽입
	ContMain.Grid0.SetCellData( "bd_cell1"	, 0	, "1회 이체한도 (원)"		)
	ContMain.Grid0.SetCellData( "bd_cell7"	, 0	, "1일 이체한도 (원)"		)
	
	
	
	
	ContMain.Grid0.SetCellBgColor(0,0,"266")

	'안내사항 그리드 set===================
	ContMain.Container1.TsGrid.SetCellData( "bd_cell3"	, 0, "1회 한도(최대)"		)
	ContMain.Container1.TsGrid.SetCellData( "bd_cell7"	, 0, "10억"		)
	'ContMain.Container1.TsGrid.SetCellData( "bd_cell7"	, 0, "1억"		) 'v0002 : 전상일 : 한도변경 (1억 -> 10억 , 5억 -> 10억)
	ContMain.Container1.TsGrid.SetCellData( "bd_cell12"	, 0, "1일 한도(최대)"		)
	'ContMain.Container1.TsGrid.SetCellData( "bd_cell16"	, 0, "5억"		) ;v0002 : 전상일 : 한도변경 (1억 -> 10억 , 5억 -> 10억)
	ContMain.Container1.TsGrid.SetCellData( "bd_cell16"	, 0, "10억"		)
	'======================================
	
	strREG_UNIQ_NO = Form.GetSharedData("BDM_REG_UNIQ_NO"        , False)
	
	
	strRsno = Form.GetSharedData("BDM_RCNO_PIP", 0)
	'strRsno ="001342144A13CF8E3A32DD125D4636156EB3" 'dfdf
	'strRsno ="00138286775822AC8BC1DBDAA87754E82DDD" 
	'strRsno ="0013415C6D4283449471352731674C11120C" 
	
	g_BDM_FRST_MAPID = Form.GetSharedData("BDM_FRST_MAPID"         , false)  '최초진입화면ID
	
	
	ContMain.T1TactLimt.enable = false
	ContMain.D1TactLimt.enable = false
	
	
	ContMain.EditPwd.enable = false
	btnOK.enable 			 = false
	if szTheme = "black" then
		btnOK.btnimage	= "btn_27.9"
	else
		btnOK.btnimage	= "btn_21.9"
	end if
	btnOK.fgcolor		 = "269"	
	
	DATAMANAGER.RequestTranData("obaci_acct_185r")


	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obaci_acct_185r" then
		DATAMANAGER.SetDataValue(0, "obaci_acct_185r", "InBlock1", "RCNO" 	 , 0 , "NMET")	'주민번호(은행개설계좌조회를위한 NMET전달)
		DATAMANAGER.SetDataValue(0, "obaci_acct_185r", "InBlock1", "RCNO_PIP" , 0 , strRsno)	'주민번호
		
	elseif szTranID = "obaci_nmet_006r" then
		
		DATAMANAGER.SetDataValue(0, "obaci_nmet_006r", "InBlock1", "RCNO_PIP" , 0 , strRsno)	'주민번호
		DATAMANAGER.SetDataValue(0, "obaci_nmet_006r", "InBlock1", "ACNO" 	 , 0 , strAcno)	'계좌번호
	
	elseIf szTranID == "obacp_opop_066r" Then
		DATAMANAGER.SetDataValue(0, "obacp_opop_066r", "InBlock1", "ACNO", 0, strAcno )
		
	elseif szTranID == "obaci_nmet_005a" then
		
		'고정부
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" 				 , 0 , strAcno 	) '계좌번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" 				 , 0 , ""		) 
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "DRNG_BANK_CODE" 	 , 0 , ""    		)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BANK_ACNO" 		 , 0 , "" 		)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "THCO_MNRC_ACNO" 	 , 0 , ""   		)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "THCO_MNRC_ASNO" 	 , 0 , ""	   	)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "IDNTF_SRNO" 		 , 0 , Trim(Form.GetSharedData("BDM_IDNTF_SRNO", false) ))'신분증인증화면에서 가져옴
		'DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "IDNTF_SRNO" 		 , 0 , 9999)'신분증인증화면에서 가져옴
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "RLNM_CNFR_MTHD_CODE" , 0 , "01"       	)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "WHOL_CPNO" 		 , 0 , TEL_no		)
		'DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "WHOL_CPNO" 		 , 0 , "01056084566")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "REG_UNIQ_NO" 		 , 0 , strREG_UNIQ_NO	)
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN1" 			, 0 , ""			) '온라인개설계좌 실명 확인
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN2" 			, 0 , ""			) '비밀번호 재설정
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN3" 			, 0 , ""			) '공인인증서 재발급 동의  신청여부 
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN4" 			, 0 , ""			) '온라인서비스 신청
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN5" 			, 0 , strApltYn5	) '온라인 이체한도 등록 및 증액
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN6" 			, 0 , ""			) '타기관OTP 등록
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN7" 			, 0 , ""			) '타기관 은행이체 등록
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN8" 			, 0 , ""			) '메리츠 종합계좌간 대체 등록
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "T1_TACT_LIMT_AMT" , 0 , g_15007s1_T1  ) 
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "D1_TACT_LIMT_AMT" , 0 , g_15007s1_D1  )
		
		'otp업무 안하므로 고정 ""
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "OTP_SUPL_CO_CODE" 	, 0 , "" 		)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "OTP_CARD_SRNO" 		, 0 , ""			)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "OTP_ISNC_ISTU_CODE" , 0 , ""			)

		'대체/이체 등록 화면외 전부 ""
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock3" , "ALTN_ACNO1" , 0 , "" 				) '메리츠계좌간대체 계좌1
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock3" , "ALTN_ACNO2" , 0 , "" 				) '			   계좌2
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock3" , "ALTN_ACNO3" , 0 , "" 				) '			   계좌3
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "TACT_BANK_ACNO1"	, 0 , "" 		) '타기관 은행이체 계좌1
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "TACT_BANK_ACNO2"	, 0 , "" 		) '				계좌2
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "TACT_BANK_ACNO3"	, 0 , "" 		) '				계좌3
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "BANK_CODE1"		, 0 , "" 		) '타기관 은행이체 은행1
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "BANK_CODE2"		, 0 , "" 		) '			      은행2
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "BANK_CODE3" 	  	, 0 , "" 		) '			      은행3
		
	End if
End Sub

'============================================================================
' 데이터 수신 
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obaci_acct_185r" Then
	
		tmp = DATAMANAGER.GetDataCount( 0 , "obaci_acct_185r", "OutBlock1")	
		for i = 0 to tmp-1
			acno 	 = DATAMANAGER.GetDataValue( 0 ,"obaci_acct_185r", "OutBlock1", "ACNO",i )
			mask_acno = Combo_AccMask(acno)
			ContMain.Combo0.cbadddatatext  = mask_acno
			
			strAcno = replace(ContMain.Combo0.caption, "-" , "")
		next 
		ContMain.Combo0.caption  = "종합계좌를 선택해주세요"
		ContMain.Combo0.fgcolor = 270
		
		'DATAMANAGER.RequestTranData("obaci_nmet_006r")
	
	elseif szTranID = "obaci_nmet_006r" Then
		
		g_StatCd = DATAMANAGER.GetDataValue( 0 ,"obaci_nmet_006r", "OutBlock4", "ACNT_STAT_CODE",0 )
		g_ProsYN =  DATAMANAGER.GetDataValue( 0 ,"obaci_nmet_006r", "OutBlock4", "PROS_ABLE_YN",0 )
		
		Form.SetSharedData("ACNT_STAT_CODE", g_StatCd)
			
		'입력한 종합계좌 상태 체크
		if g_StatCd == "3" Then
			ShowAlert("오류","폐쇄된 종합계좌입니다.")
			Exit Sub
		End If
		
		'보유중인 계좌 중, 계좌상태가 정상인 종합계좌, 하위개별계좌 건수 확인
'		If g_ProsYN == "N" Then
'			ShowAlert("오류","정상 개별계좌가 없습니다.")
'			Exit Sub
'		End If
		
		'ShowAlert("확인", "계좌번호가 확인되었습니다.")
		
		
		DATAMANAGER.SetDataValue(0, "obacp_opop_064r", "InBlock1" , "ACNO" , 0 , strAcno)
		DATAMANAGER.RequestTranData "obacp_opop_064r"
	elseIf szTranID == "obacp_opop_064r" Then
		strCsno = DATAMANAGER.GetDataValue(0, "obacp_opop_064r" , "OutBlock1" , "CSNO" , 0)
		'0203
		Form.SetSharedData("CSNO" , strCsno)
		'strRcno = DATAMANAGER.GetDataValue(0, "obacp_opop_064r" , "OutBlock1" , "RCNO" , 0) v0002. 난수암호화된 rcno setting
		
		DATAMANAGER.SetDataValue(0, "obaci_nmet_007r", "InBlock1", "ACNO" , 0 , strAcno)
		DATAMANAGER.SetDataValue(0, "obaci_nmet_007r", "InBlock1", "CSNO" , 0 , strCsno)
		DATAMANAGER.RequestTranData "obaci_nmet_007r"
		
		get_STPL_YN()	
		
	ElseIf szTranID == "obaci_nmet_007r" Then
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN2", 0) == "Y" Then
			pwSetYn = 1 '신청 내역 없음
		end if
		g_strTactLimitBfr = DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN5", 0)
		g_strOTPBf		= DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN6", 0)
			
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN4", 0) == "Y" Then
			g_Chk1_007r = 1
		Else
			g_Chk1_007r = 0
		End if
	
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN5", 0) == "Y" Then
			g_Chk2_007r = 1
		Else
			g_Chk2_007r = 0
		End if
		
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN1", 0) == "Y" Then
			g_Chk4_007r = 1
		Else
			g_Chk4_007r = 0
		End if
		
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN3", 0) == "Y" Then
			g_Chk5_007r = 1
		Else
			g_Chk5_007r = 0
		End if
		
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN7", 0) == "Y" Then
			g_Chk6_007r = 1
		Else
			g_Chk6_007r = 0
		End if
		
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN8", 0) == "Y" Then
			g_Chk7_007r = 1
		Else
			g_Chk7_007r = 0
		End if
		
		
	elseIf szTranID == "obacp_opop_066r" Then	
		ContMain.T1TactLimt.SetResultLabel("0", "complete", "",  "ContMain")
		ContMain.D1TactLimt.SetResultLabel("0", "complete", "",  "ContMain")
	
		If g_Chk2_007r == 0 Then
			ShowAlert("안내","이미 신청된 업무가 존재합니다.")
			ContMain.T1TactLimt.enable = false
			ContMain.D1TactLimt.enable = false
			btnOK.enable 			 = false
			if szTheme = "black" then
				btnOK.btnimage	= "btn_27.9"
			else
				btnOK.btnimage	= "btn_21.9"
			end if
			btnOK.fgcolor		 = "269"
		else
			ContMain.T1TactLimt.enable = true
			ContMain.D1TactLimt.enable = true
		End If
		 
		 ContMain.scroll_pos =  150
		 contMain.T1TactLimt.SetShowKeypad(true)
	ElseIf szTranID == "obaci_nmet_009r" Then
		'은행이체한도등록및변경 
		STPL_YN2 = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock1" , "STPL_YN" , 0 )
		'Form.SetSharedData("STPL_YN2", STPL_YN2)
	
		strT1 = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock1" , "T1_TACT_LIMT_AMT" , 0 )
		strD1 = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock1" , "D1_TACT_LIMT_AMT" , 0 )
		Grade = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock1" , "SECU_GRAD_CLS_CODE" , 0 )
	
		ContMain.Grid0.SetCellData( "bd_cell3"		, 0	, strT1		)
		ContMain.Grid0.SetCellData( "bd_cell11"	, 0	, strD1		)
	
	
		'타기관 은행이체 등록
		STPL_YN6 = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock3" , "STPL_YN" , 0 )
		'Form.SetSharedData("STPL_YN6", STPL_YN6)
		
		'메리츠 종합계좌간 대체 등록
		STPL_YN7 = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock4" , "STPL_YN" , 0 )		
		'Form.SetSharedData("STPL_YN7", STPL_YN7)
	
		'제휴은행개설계좌 여부 확인
		strTRGT_YN = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock5" , "TRGT_YN" , 0 )
	
		ContMain.EditPwd.SetShowKeypad(true)
		
	ElseIf szTranID == "obaci_nmet_005a" Then '최종업무신청 성공
		
		tmp_aplt_date	= DATAMANAGER.GetDataValue( 0 ,"obaci_nmet_005a", "OutBlock1", "APLT_DATE"			,0 )
		tmp_aplt_time	= DATAMANAGER.GetDataValue( 0 ,"obaci_nmet_005a", "OutBlock1", "NMET_OPNG_APLT_TIME"	,0 )
		
		
		'sz_Data = strAcno & "★" & "LIMIT" & "★" & "예시(2020-12-12 17 :21)"
		sz_Data = strAcno & "★" & "LIMIT" & "★" & tmp_aplt_date & tmp_aplt_time
		
		'Form.OpenScreen("85201", sz_Data)
		
		Form.OpenPopup("mbbdm85201", sz_Data , "" ) '비대면휴대폰인증
	End If
End Sub
'============================================================================
'데이터 오류 수신
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szTranID == "obacp_opop_066r" Then
		ContMain.T1TactLimt.SetResultLabel("0", "complete", "",  "ContMain")
		ContMain.D1TactLimt.SetResultLabel("0", "complete", "",  "ContMain")
		If ContMain.Editpwd.caption == "" Then
			'Form.MsgBox( "알림", szErrMsg , "", 0 )
			PwErrorMsg  = szErrMsg
		Else
			'Form.MsgBox( "알림", szErrMsg&"\n("&DATAMANAGER.GetDataMsgSubText(szTranID)&" 또는 비대면실명확인 재설정 필요)" , "", 0 )
			PwErrorMsg  = szErrMsg&"★("&DATAMANAGER.GetDataMsgSubText(szTranID)&" 또는 비대면실명확인 재설정 필요)"
		End If 
		
		Form.OpenPopup("mbbdm85203" , PwErrorMsg , "5")
		
		ContMain.Editpwd.caption = ""
	
	ElseIf szTranID == "obaci_nmet_007r" Then
		ContMain.Editpwd.caption = ""
	
		Form.MsgBox("안내",szErrMsg,0,0)	
	
	ElseIf szTranID == "obaci_nmet_005a" Then
		if sSubmsg ="" then
			Form.OpenPopup("mbbdm85202", szErrMsg , "" )
		else
			Form.OpenPopup("mbbdm85202", szErrMsg&"("&sSubmsg&")" , "" )
		end if
	
	End if
End Sub

'============================================================================
Function get_STPL_YN()
	DATAMANAGER.SetDataValue(0, "obaci_nmet_009r", "InBlock1", "ACNO", 0, strAcno )
	DATAMANAGER.SetDataValue(0, "obaci_nmet_009r", "InBlock1", "CSNO", 0, strCsno )
	DATAMANAGER.RequestTranData("obaci_nmet_009r")
End Function

'============================================================================
Sub ContMain_EditPwd_OnEditComplete()
	
	if cint(ContMain.EditPwd.pwdlen) < 4 then
		ShowAlert("안내", "최소 4자리 이상 입력해야 합니다.")
		Exit Sub	
	end if
	
	ContMain.T1TactLimt.enable = false
	ContMain.D1TactLimt.enable = false
	
	ContMain.T1TactLimt.caption = ""
	ContMain.D1TactLimt.caption = ""
	
	btnOK.enable 			 = false
	if szTheme = "black" then
		btnOK.btnimage	= "btn_27.9"
	else
		btnOK.btnimage	= "btn_21.9"
	end if
	btnOK.fgcolor		 = "269"
	
	DATAMANAGER.RequestTranData("obacp_opop_066r")
	
End Sub

'============================================================================
' 최종업무신청
'============================================================================
Sub btnOK_OnClick()
	
	if ContMain.EditPwd.caption ="" then
		ShowAlert("안내", "비밀번호를 입력하세요.")
		Exit Sub
	End If
	
	If pwSetYn <> 1 Then
		ShowAlert("안내", "계좌비밀번호 재설정 신청내역이 존재합니다. 영업점 승인 및 재설정 완료 후 신청가능합니다.")
		btnOK.enable 			= false
		if szTheme = "black" then
			btnOK.btnimage	= "btn_27.9"
		else
			btnOK.btnimage	= "btn_21.9"
		end if
		btnOK.fgcolor		 = "269"
		Exit Sub
	End If
	
	If g_Chk2_007r == 0 Then
		ShowAlert("안내","이미 신청된 업무가 존재합니다.")
		btnOK.enable 			= false
		if szTheme = "black" then
			btnOK.btnimage	= "btn_27.9"
		else
			btnOK.btnimage	= "btn_21.9"
		end if
		btnOK.fgcolor		 = "269"
		Exit Sub
	End If

	If strTRGT_YN == "Y" Then
		ShowAlert("알림", "제휴은행에서 개설하신 계좌는 이체한도 등록 및 증액이 불가능합니다.")
		btnOK.enable 			= false
		if szTheme = "black" then
		btnOK.btnimage	= "btn_27.9"
	else
		btnOK.btnimage	= "btn_21.9"
	end if
		btnOK.fgcolor		 = "269"
		Exit Sub
	End If
	
	'=== 2. 온라인이체한도 서비스 ===
	'금액 미입력, 이체한도 초과 입력, 감액 시 오류
	'기존 약정내역이 있는 고객에 한해 1회 / 1일 선택 신청 가능
	'================================
	If g_Chk2_007r <> 0 Then 
		g_15007s1_T1 = cdbl(ContMain.T1TactLimt.caption)
		g_15007s1_D1 = cdbl(ContMain.D1TactLimt.caption)
		
		'은행이체한도가 등록안된상태에서 금액이없을때 fail
		If strSTPL_YN2 == "Y" Then	
			If g_15007s1_D1 == 0 or g_15007s1_T1 == 0 Then
				showalert("안내", "이체한도금액을 확인하세요.")
				Exit Sub
			End If
		End If
		
		If g_15007s1_T1 == cdbl(strT1) and g_15007s1_D1 == cdbl(strD1) Then	
			showalert("안내", "이체한도금액을 확인하세요.")
			Exit Sub
		End If
		 
		
		
		If g_15007s1_T1 <> 0 Then	
			If g_15007s1_D1 > 0 Then
				If g_15007s1_T1 > g_15007s1_D1 Then
					showalert("안내", "1회 이체한도 금액이 1일 이체한도 금액을 초과했습니다.")
					Exit Sub

				End If
			ElseIf g_15007s1_D1 == "" Then
				If g_15007s1_T1 > cdbl(strD1) Then
					showalert("안내", "1회 이체한도 금액이 1일 이체한도 금액을 초과했습니다.")
					Exit Sub

				End If
			End If
		End If
		
		If ContMain.T1TactLimt.caption == "" or ContMain.D1TactLimt.caption == "" Then
			showalert("안내", "이체한도금액을 확인하세요.")
			Exit Sub
		Else
			strApltYn5 ="Y"
		End If
		
	End If
	
	DATAMANAGER.RequestTranData("obaci_nmet_005a")

End Sub

'============================================================================
'1회 한도 체크
'============================================================================
Sub ContMain_T1TactLimt_OnEditComplete()

	If  len(ContMain.T1TactLimt.caption) > 0 and cdbl(ContMain.T1TactLimt.caption) < cdbl(strT1) Then
		'ShowAlert("안내", "감액은 온라인매체(HTS,홈페이지,MTS)에서 가능합니다. (입력금액:"&cdbl(ContMain.T1TactLimt.caption)&")")
		ContMain.T1TactLimt.SetResultLabel("1", "error", "감액은 온라인매체(HTS,홈페이지,MTS)\n에서 가능합니다.", "ContMain",2)
		
		ContMain.InfoPos.top = 630
		ContMain.SetScrollAutoSize()
		ContMain.scroll_pos =  180
		
		Form.SetTimerEvent2("9999", 1, 0.5)
		ContMain.T1TactLimt.caption = ""
		btnOK_Change()
		Exit Sub
	ElseIf ContMain.T1TactLimt.caption == "0" Then
		'ShowAlert("안내", "금액을 확인해주세요.")
		
		ContMain.T1TactLimt.SetResultLabel("1", "error", "이체 한도 금액을 확인하세요.", "ContMain")
		Form.SetTimerEvent2("9999", 1, 0.5)
		ContMain.T1TactLimt.caption = ""
		btnOK_Change()
		Exit Sub
	Else
		If cdbl(ContMain.T1TactLimt.caption) > 1000000000 Then 'v0001
			'ShowAlert("안내", "등록가능한도 초과입니다. (입력금액:"&cdbl(ContMain.T1TactLimt.caption)&")")
		
			ContMain.T1TactLimt.SetResultLabel("1", "error", "1회 최대한도는 10억원 입니다.", "ContMain")
			
			ContMain.InfoPos.top = 630
			ContMain.SetScrollAutoSize()
			ContMain.scroll_pos =  180
			
			Form.SetTimerEvent2("9999", 1, 0.5)
			ContMain.T1TactLimt.caption = ""
			btnOK_Change()
			Exit Sub
		End If
		
		If cdbl(ContMain.T1TactLimt.caption)> 0 and cdbl(ContMain.D1TactLimt.caption) >0 Then	
			If cdbl(ContMain.T1TactLimt.caption) > cdbl(ContMain.D1TactLimt.caption) Then
				ContMain.T1TactLimt.SetResultLabel("1", "error", "1회 이체한도 금액이 1일 이체한도\n금액을 초과했습니다.", "ContMain",2)
				
				ContMain.InfoPos.top = 630
				ContMain.SetScrollAutoSize()
				ContMain.scroll_pos =  180
				
				Form.SetTimerEvent2("9999", 1, 0.5)
				ContMain.T1TactLimt.caption = ""
				btnOK_Change()
				Exit Sub
			End If
		End If
	End if
	
	btnOK_Change()
	ContMain.scroll_pos = 270
	ContMain.D1TactLimt.SetShowKeypad(true)
End Sub


'============================================================================
'1일 한도 체크
'============================================================================
                 
Sub ContMain_D1TactLimt_OnEditComplete()
	ContMain.scroll_pos = Form.calcUnResize(ContMain.Combo0.top,"1") +80
	
	If len(ContMain.D1TactLimt.caption) > 0 and cdbl(ContMain.D1TactLimt.caption) < cdbl(strD1) Then
		'ShowAlert("안내", "감액은 온라인매체(HTS,홈페이지,MTS)에서 가능합니다. (입력금액:"&cdbl(ContMain.D1TactLimt.caption)&")")
		ContMain.D1TactLimt.SetResultLabel("1", "error", "감액은 온라인매체(HTS,홈페이지,MTS)\n에서 가능합니다.", "ContMain",2)
		
		ContMain.InfoPos.top = 630
		ContMain.SetScrollAutoSize()
		ContMain.scroll_pos =  180
		
		Form.SetTimerEvent2("9999", 1, 0.5)
		ContMain.D1TactLimt.caption = ""
		btnOK_Change()
		Exit Sub
	ElseIf ContMain.D1TactLimt.caption == "0" Then
		'ShowAlert("안내", "금액을 확인해주세요.")
		ContMain.D1TactLimt.SetResultLabel("1", "error", "이체 한도 금액을 확인하세요.", "ContMain")
		Form.SetTimerEvent2("9999", 1, 0.5)
		ContMain.D1TactLimt.caption = ""
		btnOK_Change()
		Exit Sub
	Else
		If cdbl(ContMain.D1TactLimt.caption) > 1000000000 Then
			'ShowAlert("안내", "등록가능한도 초과입니다. (입력금액:"&cdbl(ContMain.D1TactLimt.caption)&")")
			
			ContMain.D1TactLimt.SetResultLabel("1", "error", "1일 최대한도는 10억원 입니다.", "ContMain")
			
			ContMain.InfoPos.top = 630
			ContMain.SetScrollAutoSize()
			ContMain.scroll_pos =  180
			
			Form.SetTimerEvent2("9999", 1, 0.5)
			ContMain.D1TactLimt.caption = ""
			btnOK_Change()
			Exit Sub
		End If
		
		If cdbl(ContMain.T1TactLimt.caption)> 0 and cdbl(ContMain.D1TactLimt.caption) >0 Then	
			If cdbl(ContMain.T1TactLimt.caption) > cdbl(ContMain.D1TactLimt.caption) Then
				ContMain.D1TactLimt.SetResultLabel("1", "error", "1회 이체한도 금액이 1일 이체한도\n금액을 초과했습니다.", "ContMain",2)
				
				ContMain.InfoPos.top = 630
				ContMain.SetScrollAutoSize()
				ContMain.scroll_pos =  180
				
				Form.SetTimerEvent2("9999", 1, 0.5)
				ContMain.T1TactLimt.caption = ""
				btnOK_Change()
				Exit Sub
			End If
		End If
		
	End If
	
	btnOK_Change()
End Sub

'============================================================================
Function btnOK_Change()
	'If g_Chk1_007r == 1 and ContMain.ChkButton0.checkstate == "1" and ContMain.ChkButton1.checkstate == "1" Then
	
	If g_Chk2_007r == 1  Then '이체한도등록이 필요한경우
		If cdbl(ContMain.T1TactLimt.caption) > 0 AND cdbl(ContMain.D1TactLimt.caption) > 0 and trim(ContMain.D1TactLimt.caption) <>"" and trim(ContMain.T1TactLimt.caption) <>"" Then
			
			btnOK.enable 		= true
			btnOK.btnimage	= "btn_20.9"
			btnOK.fgcolor		= "273"
		elseif cdbl(ContMain.T1TactLimt.caption) == 0 or cdbl(ContMain.D1TactLimt.caption) == 0  Then
			
			btnOK.enable 		= false
			if szTheme = "black" then
				btnOK.btnimage	= "btn_27.9"
			else
				btnOK.btnimage	= "btn_21.9"
			end if
			btnOK.fgcolor		= "269"
		end if
	else
		btnOK.enable 		= false
		if szTheme = "black" then
			btnOK.btnimage	= "btn_27.9"
		else
			btnOK.btnimage	= "btn_21.9"
		end if
		btnOK.fgcolor		= "269"
	end if

End Function

'================================
'안내사항
'================================
Sub ContMain_Container1_Label1_OnClick()
	ContMain.T1TactLimt.SetResultLabel("0", "complete", "",  "ContMain")
	ContMain.D1TactLimt.SetResultLabel("0", "complete", "",  "ContMain")
	
	if bWide == false then
		bWide = true
		
		'안보이는라벨위치 아래로 조정
		ContMain.InfoPos.top = 920
		ContMain.SetScrollAutoSize()
		ContMain.Container1.Image3.imgpath = "icon_caret_up.png"
		
		ContMain.Container1.SetHeightResize(395) 
		ContMain.scroll_pos = Form.calcUnResize(ContMain.Combo0.top,"1") + 435
		
	else
		bWide = false
		
		ContMain.Container1.SetHeightResize(40 )
		ContMain.InfoPos.top = 0 
		ContMain.Container1.Image3.imgpath = "icon_caret_down.png"
		
		ContMain.scroll_pos = Form.calcUnResize(ContMain.Combo0.top,"1") +80
		
		Form.SetTimerEvent2("9999", 1, 0.5)
		'ContMain.SetScrollAutoSize()

	end if
end Sub
'================================
Sub ContMain_Container1_Image1_OnClick()
	ContMain_Container1_Label1_OnClick()
End SUb

Sub ContMain_Container1_Image3_OnClick()
	ContMain_Container1_Label1_OnClick()
End SUb

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if trim(sTimerID) == "9999" then
		Form.SetTimerEvent2("9999", 0, 0.5)
		ContMain.SetScrollAutoSize()
	end if
End Sub
'================================

Sub Container2_Image2_OnClick()
	Form.OpenPopup("mbbdm85200_p9" , "100" , "5")
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용
	Container2_Image2_OnClick()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbbdm85200_p9_end" or  sKeyName == "mbbdm85201_end" or  sKeyName == "mbbdm85202_end" then 
		if sRet =="ok" then
			Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
			if g_BDM_FRST_MAPID ="screen41000" then
				Form.OpenScreen( "41000" , "")
				Form.CloseForm()	
			else
				Form.OpenNextPopup(g_BDM_FRST_MAPID, "", "")
			end if
		end if
	End If
End Sub	


'============================================================================
Sub ContMain_Combo0_OnEditComplete(iIndex)
	ContMain.Editpwd.caption =""
	ContMain.Editpwd.enable = true
	
	ContMain.T1TactLimt.enable = false
	ContMain.D1TactLimt.enable = false
	
	ContMain.T1TactLimt.caption = ""
	ContMain.D1TactLimt.caption = ""
	
	ContMain.T1TactLimt.SetResultLabel("0", "complete", "",  "ContMain")
	ContMain.D1TactLimt.SetResultLabel("0", "complete", "",  "ContMain")
	
	strAcno = replace(ContMain.Combo0.caption, "-" , "")
	
	btnOK.enable 		 = false
	if szTheme = "black" then
		btnOK.btnimage	= "btn_27.9"
	else
		btnOK.btnimage	= "btn_21.9"
	end if
	btnOK.fgcolor		 = "269"
	
	DATAMANAGER.RequestTranData("obaci_nmet_006r")
End Sub
'============================================================================
Function Combo_AccMask(szAcc)
           Combo_AccMask = Left(szAcc, 4)&"-"&Mid(szAcc, 5, 4)
End Function

