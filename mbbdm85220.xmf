'진입점에서 설정되는 정보 ---------------------------------------
Dim g_BDM_FRST_MAPID			'최초진입점화면ID
'as-is mbact15006
Dim strRsno '주민번호
Dim strAcno '계좌번호
Dim strCsno '고객번호
Dim TEL_no  '휴대폰번호
 
Dim pwSetYn '계좌비밀번호재설정 신청여부 확인 (as-is :g_Cnt2)

'as-is mbact15007

'업무별 기 신청내역
Dim g_Chk1_007r
Dim g_Chk2_007r
Dim g_Chk3_007r
Dim g_Chk4_007r
Dim g_Chk5_007r
Dim g_Chk6_007r
Dim g_Chk7_007r

'기 신청내역 조회 (0(N):존재 1(Y):미존재)
g_Chk1_007r = 0
g_Chk2_007r = 0
g_Chk3_007r = 0
g_Chk4_007r = 0
g_Chk5_007r = 0
g_Chk6_007r = 0
g_Chk7_007r = 0

'개인정보입력 화면에서 휴대폰번호 받아옴(mbcnf15000) 
HP1 = Form.GetSharedData("BDM_HP1", False )
HP2 = Form.GetSharedData("BDM_HP2", False )
HP3 = Form.GetSharedData("BDM_HP3", False )
TEL_no = HP1 & HP2 & HP3

Dim strT1 '1회이체한도금액(기존)
Dim strD1 '1일이체한도금액(기존)
Dim strTRGT_YN '제휴은행개설계좌여부
Dim strREG_UNIQ_NO

Dim bWide
bWide = false

