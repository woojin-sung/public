				<LABEL name="LblScrnB3" fontsize="2" caption="투자성향을 재진단하시겠습니까?" halign="1" ly_vert="20,220,335,20,1" />
				<LABEL name="LblScrnB1" fontsize="4" fontstyle="01" caption="투자성향 정보미제공은" halign="1" ly_vert="20,138,335,48,1" />
				<LABEL name="LblScrnB2" fgcolor="006:213049051" fontsize="4" fontstyle="01" caption="해외파생, 선물옵션" ly_vert="11,162,192,48,1" />
