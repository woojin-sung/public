'============================================================================
Sub Form_OnTimerEvent(sTimerID)
    '단기다수계좌여부/대포통장명의인여부 확인
    If sTimerID == 3 Or sTimerID == "3" Then
        '정보송신 타이머종료
        Form.SetTimerEvent(3, 0, 1)

        '송신유효횟수 설정
        g_nCnt_091_1 = CInt(g_nCnt_091_1) + 1

        '송신유효횟수 초과 체크
        If CInt(g_nCnt_091_1) > 7 Then
            Form.ShowAlert("오류", "은행연합회와 통신상태가 원활하지 않습니다. 잠시 후 다시 시도해 주십시오.")
            Exit Sub
        End If

        '단기다수계좌여부/대포통장명의인여부 확인
        DATAMANAGER.RequestTranData "obaci_acct_091r_1"
    End If
    
    'v0002 sta 은합회 결과값에 따라 체크 
    '안드로이드는 num, 아이폰은 string으로 받음
	If sTimerID == 10 or sTimerID == "10" then
		Form.SetTimerEvent( 10, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_1")
	End If
	
	If sTimerID == 11 or sTimerID == "11" then
		Form.SetTimerEvent( 11, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_2")
	End If
	
	If sTimerID == 12 or sTimerID == "12" then
		Form.SetTimerEvent( 12, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_3")
	End If
	
	If sTimerID == 13 or sTimerID == "13" then
		Form.SetTimerEvent( 13, 0, 1 )
		DATAMANAGER.RequestTranData("obaci_acct_089r_4")
	End If
	'v0002 fin
End Sub


'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

    If sKeyName = "ReTryPrcd" Then
        If sRet = "ok" Then  'ok.예 no.아니오
             '상품선택으로 돌아가는 경우, 상품선택 정보만 남기고 모두 초기화
		    User_SharedData_Set("")
		    User_SharedData_Set("init2")
             User_SharedData_Set("init3")
             User_SharedData_Set("init4")
		    User_SharedData_Set("init5")
		    
             g_Opng_File = G_STEP2_1_FILE  '오픈할화면
             g_Send_Data = ""              '인자정보

             NextStep()
	    End If
    End If
    if sKeyName = "ReTryPrcd2" Then
	    If sRet = "no" Then  'ok.예 no.아니오
		    '상품선택으로 돌아가는 경우, 상품선택 정보만 남기고 모두 초기화
		    User_SharedData_Set("")
		    User_SharedData_Set("init2")
             User_SharedData_Set("init3")
             User_SharedData_Set("init4")
             User_SharedData_Set("init5")
	        
			
             g_Opng_File = G_STEP2_1_FILE  '오픈할화면
             g_Send_Data = ""              '인자정보 
		    NextStep()
	    ElseIf sRet = "ok" Then
		    '각 개설방식에 따라 화면 오픈 후, 현재화면 닫기(종합계좌/개별)
			if g_BDM_ACNT_OPNG_CLCD == "1" or g_BDM_ACNT_OPNG_CLCD == 1 then					
				g_Opng_File = G_STEP2_4_FILE  '오픈할화면
				g_Send_Data = ""              '인자정보    
			elseif g_BDM_ACNT_OPNG_CLCD == "2" or g_BDM_ACNT_OPNG_CLCD == 2 then
				g_Opng_File = G_STEP2_5_FILE  '오픈할화면
				g_Send_Data = ""              '인자정보    
			end if	
			'v0007 중개형 ISA일때만 개설구분값 저장 
			If g_BDM_ISA_PROD_TYPE == "3" then
				g_BDM_ISA_ACNT_OPNG_CLCD = "2" '이수개설
			End If
			NextStep()
	    End if
    End if
End Sub

