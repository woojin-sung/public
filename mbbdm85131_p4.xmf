' 다음
'============================================================================
Sub btnNext_OnClick()
	'슈퍼365 개설시 신규개설 케이스로
	If g_BDM_PRCD200 == "Y" Then
		g_BDM_ACNT_OPNG_CLCD = "1"	'종합개설
		
	    '공유정보Set
	    User_SharedData_Set("")
	
	    '단기다수개설계좌고객여부 체크
	    DATAMANAGER.RequestTranData( "obaci_acct_091r" )
    
    '그 외는 기존루트 그대로
	Else
		if g_BDM_ABLE_YN == "N" then
		    g_BDM_ACNT_OPNG_CLCD = "1"	'종합개설
		
		    '공유정보Set
		    User_SharedData_Set("")
		
		    '단기다수개설계좌고객여부 체크
		    DATAMANAGER.RequestTranData( "obaci_acct_091r" )
		else
		    '공유정보Set
		    User_SharedData_Set("")
		
		    '개설방식선택popup
		    Form.openPopupAnimation(G_STEP2_3_FILE, "", "", "2")
		end if
	End If
End Sub


'============================================================================
Function PrevStep()

'화면오픈후현재창닫아야하는경우 : Form.OpenNextPopup()  -> 별도의Form.CloaseForm() 불필요
'화면오픈만하는경우 : Form.OpenPopup()

	'Form.ShowAlert("g_Opng_File",g_Opng_File)
	if g_Opng_File ~= "" or g_Opng_File ~= null then
		'공유변수 설정
		User_SharedData_Set("")
		'약관으로 돌아가는 경우, 상품선택,약관 설정정보외 모두 초기화
		User_SharedData_Set("init3")  '개설구분
		User_SharedData_Set("init4")  '계좌정보
		User_SharedData_Set("init5")  'CFD약관
	
'		오프팝업으로 호출하기 때문에 Formclose로 변경
'JMY NextPopup오픈변경에 따라 되돌아 갈때도 NextPopup으로 처리
		Form.OpenNextPopup(g_Opng_File, g_Send_Data, "")
		
		'20230418 주석처리함.
		'Form.CloseForm()	'NextPopup후 화면이 남는경우가 있어 강제로 한번 더 종료호출
	end if
End Function
'============================================================================
Function NextStep()

'화면오픈후현재창닫아야하는경우 : Form.OpenNextPopup()  -> 별도의Form.CloaseForm() 불필요
'화면오픈만하는경우 : Form.OpenPopup()

    if g_Opng_File ~= "" or g_Opng_File ~= null then
        '공유변수 설정
        User_SharedData_Set("")
	   'v0002 sta
	   '상품선택으로 돌아가는 경우, 상품선택 정보만 남기고 모두 초기화
	   If g_Opng_File == G_STEP2_1_FILE Then
            User_SharedData_Set("init2")
            User_SharedData_Set("init3")
            User_SharedData_Set("init4")
            User_SharedData_Set("init5")
        End If
	   'v0002 fin
	   
	   '약관정보로 돌아가는 경우, 상품선택,약관정보 정보만 남기고 모두 초기화
        If g_Opng_File == G_STEP2_2_FILE Then
            User_SharedData_Set("init3")
            User_SharedData_Set("init4")
            User_SharedData_Set("init5")
        End If
	    
        Form.OpenNextPopup(g_Opng_File, g_Send_Data, "")
	
	    '20230418 closeform주석처리함.
        'Form.CloseForm()	'NextPopup후 화면이 남는경우가 있어 강제로 한번 더 종료호출
    end if
End Function


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
   
    '단기다수계좌/대포통장 명의인 조회
    If szTranID == "obaci_acct_091r" Then
        '조회전문번호 초기화
        edt091TlmsNo1.caption = ""

        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_PROS_CLS_CODE", 0, "3"            )  '3.단기다수계좌/대포통장 명의인 조회
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE"     , 0, "1"            )  '1.개인
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"          , 0, g_BDM_RCNO_PIP )  '암호화주민번호

    '단기다수계좌/대포통장 명의인 확인
    ElseIf szTranID == "obaci_acct_091r_1" Then
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_PROS_CLS_CODE", 0, "4"                    )  '4.단기다수계좌/대포통장 명의인 확인
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CUST_CLS_CODE"     , 0, "1"                    )
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LNKD_TLMS_MNNO"    , 0, edt091TlmsNo1.caption  )
        DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"          , 0, g_BDM_RCNO_PIP         )  '암호화주민번호
	
	'v0002 sta 은합회 결과값에 따라 체크 
	ElseIf szTranID == "obaci_acct_089r" or szTranID == "obaci_acct_089r_1" or szTranID == "obaci_acct_089r_2" or szTranID == "obaci_acct_089r_3" or szTranID == "obaci_acct_089r_4" then	
		if szTranID == "obaci_acct_089r" then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "BSWR_PROS_CLS_CODE" , 0 , "3"			)	'업무처리구분코드
		else
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "BSWR_PROS_CLS_CODE" , 0 , "4"			)	'업무처리구분코드
		end if
		'v0007 일임형 ISA 추가 : 금융소득종합과세대상자인지 체크
		If g_BDM_ISA_PROD_TYPE == "2" Then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PRCD" 				, 0 , "133"			)	'상품코드 : 일임형 ISA 
		ElseIf g_BDM_ISA_PROD_TYPE == "3" Then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "PRCD" 				, 0 , "140"			)	'상품코드 : 중개형 ISA '2021-12-06 kSJ
		End If
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "TXCM_PRCD" 		, 0 , "66"			)	'은행연합회상품코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "TXCM_TRPR_CLS_CODE" , 0 , "0" 			)	'세금우대대상자구분
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CUST_CLS_CODE" 		, 0 , "1" 			)	'고객구분코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "RCNO_PIP" 			, 0 , g_BDM_RCNO_PIP	)	'고객실명확인번호PIP값
	'v0002 fin
    End IF
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    '오류메시지 설정
    strSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    If Trim(strSubMsg) ~= null And Trim(strSubMsg) ~= "" Then
        strMsg = szErrMsg.."("..Trim(strSubMsg)..")"
    Else
        strMsg = szErrMsg
    End If

    '단기다수계좌/대포통장 명의인
    If szTranID == "obaci_acct_091r" Or szTranID == "obaci_acct_091r_1" Then
        Form.ShowAlert("오류", strMsg)
    End If
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)

    '단기다수계좌/대포통장 명의인 조회
    If szTranID == "obaci_acct_091r" Then
        edt091TlmsNo1.caption = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "LNKD_TLMS_MNNO", 0)
        strCode               = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
        'Form.ShowAlert(szTranID, strCode)
        If strCode == "1" Or strCode ==  1 Then  '전문전송완료
            '단기다수계좌/대포통장 명의인 확인 타이머실행
            g_nCnt_091_1 = 0
            Form.SetTimerEvent(3, 1, 1)
        Else
            Form.ShowAlert("오류", "계좌개설 진행이 불가합니다.(단기다수개설자 조회 오류)")    
            Exit Sub
        End If

    '단기다수계좌/대포통장 명의인 확인
    ElseIf szTranID == "obaci_acct_091r_1" Then
        strCode = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PROS_CLS_CODE", 0)
        'Form.ShowAlert(szTranID, strCode)
        If strCode == "2" Or strCode == 2 Then  '조회완료
            '대포통장명의인여부
            'g_BNK_NMPR_YN_YN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "UI_BNKB_NMPR_YN", 0)
            '단기다수계좌개설여부
            g_BNK_MNY_OPNG_YN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "UI_MNY_ACNT_OPNG_CHD_YN", 0)
	    
            'v0007 공유정보Set
            User_SharedData_Set("")
	    
		   User_Able_Chk()
        Else
            '단기다수계좌/대포통장 명의인 확인 타이머실행
            Form.SetTimerEvent(3, 1, 1)
        End If
	'v0002 sta 은합회 결과값에 따라 체크 
	'PROS_CLS_CODE가 '1'이면 1초에 한번 총 5회 OutBlock1.LNKD_TLMS_MNNO를 INPUT으로 하여 다시 전송한다.
	'PROS_CLS_CODE가 '2'로 정상응답을 수신하면 재전송 중단
	
	ElseIf szTranID == "obaci_acct_089r" Then
		Dim sCode, sOutput, sTxcmDplcAcntYn, sTxcmTrprClsCode		
		sCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "PROS_CLS_CODE" , 0)
			
		If sCode == "2" then	'정상
			sTxcmDplcAcntYn = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_DPLC_ACNT_YN" , 0)	'세금우대 중복 계좌 여부  
			sTxcmTrprClsCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "TXCM_TRPR_CLS_CODE" , 0) '금융소득종합과세대상자여부 V0005

			if sTxcmTrprClsCode == "1" then
				Form.ShowAlert("알림", "금융소득종합과세대상자 ISA 가입 불가합니다.")
				Exit Sub
			end if 
			
			If sTxcmDplcAcntYn == "0" OR sTxcmDplcAcntYn == "3" then 
				'v0007 중개형 ISA일때만 개설구분값 저장 
				If g_BDM_ISA_PROD_TYPE == "3" then
					g_BDM_ISA_ACNT_OPNG_CLCD = "1"
				End If
				NextStep()
			ElseIf sTxcmDplcAcntYn == "1"  then 
				Form.ShowAlert("알림", "은행연합회 중복상태(ISA 2계좌 등)로 중복해소 필요(연합회 문의)")
				Exit Sub
			ElseIf sTxcmDplcAcntYn == "2"  then 
				Form.MsgBox("알림", "고객님께서는 ISA계좌를 보유중입니다.\n\n이수전용 계좌를 개설하시겠습니까?\n(계좌개설 완료 후 로그인하여 별도로 이전or전환 신청이 필요합니다.)", "ReTryPrcd2", 2)
				Exit Sub			
			End If
			
		Else
			sOutput = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "LNKD_TLMS_MNNO" , 0)
			DATAMANAGER.SetDataValue( 0 , "obaci_acct_089r_1", "InBlock1", "LNKD_TLMS_MNNO" , 0 , sOutput)
			Form.SetTimerEvent( 10, 1, 1 )
		End If
	ElseIf szTranID == "obaci_acct_089r_1" Then
		Dim sCode, sOutput, sTxcmDplcAcntYn, sTxcmTrprClsCode		
