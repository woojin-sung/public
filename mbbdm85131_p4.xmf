'============================================================================
Function User_Conti_Data_Set()

	'기선택된 정보인 경우 화면표시 처리
	'이전 선택한 상품과 정보가 다를 수 있으므로 g_BDM_CtcnChkAll 로는 체크하지 않음

	if g_BDM_CFD_CtcnChk1 == "Y" then
    	    User_Chk_Image_Set("CFD1", "Y")
	end if
	if g_BDM_CFD_CtcnChk2 == "Y" then
		User_Chk_Image_Set("CFD2", "Y")
	end if
	if g_BDM_CFD_CtcnChk3 == "Y" then
		User_Chk_Image_Set("CFD3", "Y")
	end if
	if g_BDM_CFD_CtcnChk4 == "Y" then
		User_Chk_Image_Set("CFD4", "Y")
	end if
	'v0003 sta
	if g_BDM_CFD_CtcnChk5 == "Y" then
		User_Chk_Image_Set("CFD5", "Y")
	end if	
	'v0003 fin

	'개별체크에 따른 모두동의 체크설정
	User_Chk_All()
	
	'다음버튼 활성화/비활성화
	User_Btn_NextStep()
End Function
'============================================================================
Function User_Chk_All()

'화면에 보이는 약관이 모두 선택된 경우, 상단 모두동의 자동체크

    strYN = "Y"

    if g_BDM_CFD_CtcnChk1 <> "Y" Then
        strYN = "N"
    end if

    if g_BDM_CFD_CtcnChk2 <> "Y" Then
        strYN = "N"
    end if
	
    if g_BDM_CFD_CtcnChk3 <> "Y" Then
        strYN = "N"
    end if
    
    if g_BDM_CFD_CtcnChk4 <> "Y" Then
        strYN = "N"
    end if
    
    	'v0003 sta
    if g_BDM_CFD_CtcnChk5 <> "Y" Then
        strYN = "N"
    end if
	'v0003 fin
	
    if strYN == "Y" then
        imgCtcnChkAll.imgpath = "check_square_on.png"
    end if

End Function 
'============================================================================
Function User_Chk_Next(trgt, chk)
	'Y/N 설정
	if trgt == "A" then		
		g_BDM_CFD_CtcnChkAll	= chk			'전체
		g_BDM_CFD_CtcnChk1	= chk			'CFD1
		g_BDM_CFD_CtcnChk2	= chk			'CFD2
		g_BDM_CFD_CtcnChk3	= chk			'CFD3
		g_BDM_CFD_CtcnChk4	= chk			'CFD4
		g_BDM_CFD_CtcnChk5	= chk	'v0003 	 CFD5

	elseif trgt == "CFD1" then
		g_BDM_CFD_CtcnChk1 = chk
	elseif trgt == "CFD2" then
		g_BDM_CFD_CtcnChk2 = chk
	elseif trgt == "CFD3" then
		g_BDM_CFD_CtcnChk3 = chk
	elseif trgt == "CFD4" then
		g_BDM_CFD_CtcnChk4 = chk
	'v0003 sta
	elseif trgt == "CFD5" then
		g_BDM_CFD_CtcnChk5 = chk
	end if	
	'v0003 fin
	
	
	'Y/N 설정에 따른 색상표시
	User_Chk_Image_Set(trgt, chk)
	if trgt == "A" then
		User_Chk_Image_Set("CFD1", chk)	
		User_Chk_Image_Set("CFD2", chk)	
		User_Chk_Image_Set("CFD3", chk)	
		User_Chk_Image_Set("CFD4", chk)	
		User_Chk_Image_Set("CFD5", chk)	'v0003
	else
		'개별약관 체크해제시, 전체도 같이 해제
		if chk <> "Y" then
			g_BDM_CtcnChkAll = chk
			User_Chk_Image_Set("A", chk)
		end if
	end if
	
	'다음버튼 활성화/비활성화
	User_Btn_NextStep()
End Function
'============================================================================
Function User_Chk_Image_Set(trgt, chk)

	'A.모두동의(imgCtcnChkAll)
	if trgt == "A" then
		if chk == "Y" then
			imgCtcnChkAll.imgpath = "check_square_on.png"
		else
			imgCtcnChkAll.imgpath = "check_square_off.png"
		end if

	elseif trgt == "CFD1" then
		if chk == "Y" then
			contCtcn1.imgCtcnChk.imgpath = "check_on.png"
		else
			contCtcn1.imgCtcnChk.imgpath = "check_off.png"
		end if

	elseif trgt == "CFD2" then
		if chk == "Y" then
			contCtcn2.imgCtcnChk.imgpath = "check_on.png"
		else
			contCtcn2.imgCtcnChk.imgpath = "check_off.png"
		end if

	elseif trgt == "CFD3" then
		if chk == "Y" then
			contCtcn3.imgCtcnChk.imgpath = "check_on.png"
		else
			contCtcn3.imgCtcnChk.imgpath = "check_off.png"
		end if
		
	elseif trgt == "CFD4" then
		if chk == "Y" then
			contCtcn4.imgCtcnChk.imgpath = "check_on.png"
		else
			contCtcn4.imgCtcnChk.imgpath = "check_off.png"
		end if
		
	'v0003 sta
	elseif trgt == "CFD5" then
		if chk == "Y" then
			contCtcn5.imgCtcnChk.imgpath = "check_on.png"
		else
			contCtcn5.imgCtcnChk.imgpath = "check_off.png"
		end if	
	'v0003 fin
	end if
	
	User_Chk_All()
End Function 
'============================================================================
Function User_Btn_NextStep()

	if g_BDM_CFD_CtcnChk1 == "Y" and g_BDM_CFD_CtcnChk2 == "Y" and g_BDM_CFD_CtcnChk3 == "Y" and g_BDM_CFD_CtcnChk4 == "Y" and g_BDM_CFD_CtcnChk5 == "Y" then	'v0003 g_BDM_CFD_CtcnChk5 추가
		btnNext.enable = true
		btnNext.btnimage = "btn_20.9"
		btnNext.fgcolor = "273"
	else 
		btnNext.enable = false
		If g_szTheme = "black" Then
			btnNext.btnimage = "btn_27.9"
		Else 
			btnNext.btnimage = "btn_21.9"
		End If
		btnNext.fgcolor = "269"
	end if	
end Function
'============================================================================
Function User_Able_Chk()
    '단기다수개설자 종합
    If g_BNK_MNY_OPNG_YN == "Y" Then
        Form.ShowAlert("안내", "단기다수개설자로써 종합개설이 불가합니다.\n기존 종합계좌이용 추가계좌 개설만 가능합니다.")
        Exit Function

    '최근 30일내 종합계좌 신규개설건 존재시, 종합개설 불가
    ElseIf g_BDM_OVRL_ACNT_OPNG_YN == "Y" Then
        '단기다수체크에 맞춰 20일영업일로 변경(By박정숙Cha)
        'Form.ShowAlert("안내", "최근 30일간 종합계좌 신규개설을 하신 경우에는 기존 종합계좌이용 추가계좌 개설만 가능합니다.")
	   Form.ShowAlert("안내", "최근 20영업일간 종합계좌 신규개설을 하신 경우에는 기존 종합계좌이용 추가계좌 개설만 가능합니다.")
        Exit Function
    End If

    'ISA 상품포함 종합개설시, 종합매매(ISA고유의 현물&현금해지&입금용) 필수선택 체크
    If g_BDM_PRCD133 == "Y" and g_BDM_ISA_PROD_TYPE == "2" Then
        If g_BDM_PRCD100 <> "Y" and g_BDM_PRCD118RP <> "Y" Then	'v0007 CMA계좌 보유시에도 개설 가능하도록 변경
            Form.MsgBox("안내", "일임형ISA 개설시 현물, 현금해지, 입금을 위한 별도 계좌 (종합매매 또는 CMA)를 개설해야 합니다.\n\n개설상품 선택화면으로 이동하시겠습니까?", "ReTryPrcd", 2)
            Exit Function
        End If    
    End If
    
    '개별추가 불가인 경우, 종합개설 화면오픈후, 현재화면 닫기
    'Form.OpenPopup(G_STEP2_4_FILE, "")
    'Form.CloseForm()
    g_Opng_File = G_STEP2_4_FILE      '오픈할화면
    g_Send_Data = ""              '인자정보

    'v0007 일임형 ISA계좌도 금융소득종합과세대상자인지 체크 > obaci_acct_089r 서비스 진행
    'v0002 중개형 ISA계좌 개설시 타사보유 여부 체크
	if g_BDM_PRCD133 == "Y" then
		DATAMANAGER.RequestTranData("obaci_acct_089r")
	else
		NextStep()
	end if
End Function


'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

    'OSType 1.안드로이드 2.IOS
    g_sz_OSType = Form.GetSharedData("&OS_TYPE", false)

    '테마구분 white/black
	g_szTheme = Form.GetEnvData("common.theme")

    '다음버튼 비활성화
    btnNext.enable = false
    If g_szTheme = "black" Then
        btnNext.btnimage = "btn_27.9"
    Else 
        btnNext.btnimage = "btn_21.9"
    End If
    btnNext.fgcolor = "269"
	
    '파일정보 Set
    User_File_Set()

    '공유정보Get
    User_SharedData_Get()

	'이어하기용 정보 설정- 계좌정보 단계에서 넘어온 경우에만
    sRevData = Form.GetOpenLinkData()
    If sRevData == "StepBack" Then
	    User_Conti_Data_Set()
    End If

End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
			
	'파일정보 Set
	User_File_Set()
	
	'약관목록
	if sKeyName == G_STEP2_2_P1_FILE then
		if sRet == "ok_CFDA" then		'전체약관
			g_BDM_CFD_CtcnChkAll = "Y"
			User_Chk_Next("A", g_BDM_CFD_CtcnChkAll)
		elseif sRet == "ok_CFD1" then	'
			g_BDM_CFD_CtcnChk1 = "Y"
			User_Chk_Next("CFD1", g_BDM_CFD_CtcnChk1)
			
		elseif sRet == "ok_CFD2" then	'
			g_BDM_CFD_CtcnChk2 = "Y"
			User_Chk_Next("CFD2", g_BDM_CFD_CtcnChk2)
			
		elseif sRet == "ok_CFD3" then	'
			g_BDM_CFD_CtcnChk3 = "Y"
			User_Chk_Next("CFD3", g_BDM_CFD_CtcnChk3)
			
		elseif sRet == "ok_CFD4" then	'
			g_BDM_CFD_CtcnChk4 = "Y"
			User_Chk_Next("CFD4", g_BDM_CFD_CtcnChk4)

		'v0003 sta
		elseif sRet == "ok_CFD5" then	'
			g_BDM_CFD_CtcnChk5 = "Y"
			User_Chk_Next("CFD5", g_BDM_CFD_CtcnChk5)
		end if
		'v0003 fin
	end if
	
	'계좌개설방식선택
	if sKeyName == G_STEP2_3_FILE then
		if (sRet == "1" or sRet == 1) or (sRet == "2" or sRet == 2)  then
			g_BDM_ACNT_OPNG_CLCD = sRet		'1.종합계좌개설 2.개별추가 
			
			'v0007
			g_BNK_MNY_OPNG_YN = Form.GetSharedData("BDM_BNK_MNY_OPNG_YN"	, false)	'단기다수개설여부
			
			'공유정보Set
			User_SharedData_Set("")
	
			'각 개설방식에 따라 화면 오픈 후, 현재화면 닫기
			if sRet == "1" or sRet == 1 then				
				'Form.OpenPopup(G_STEP2_4_FILE, "")	'종합개설	
				g_Opng_File = G_STEP2_4_FILE  '오픈할화면
				g_Send_Data = ""              '인자정보    

			elseif sRet == "2" or sRet == 2 then
				'Form.OpenPopup(G_STEP2_5_FILE, "")	'개별추가
				g_Opng_File = G_STEP2_5_FILE  '오픈할화면
				g_Send_Data = ""              '인자정보    

			end if	
			
			'v0007 일임형 ISA계좌도 금융소득종합과세대상자인지 체크 > obaci_acct_089r 서비스 진행
	         'v0002 중개형 ISA계좌 개설시 타사보유 여부 체크
			if g_BDM_PRCD133 == "Y" then
				DATAMANAGER.RequestTranData("obaci_acct_089r")
			else
				NextStep()
			end if

         '상품선택으로 돌아가기
         elseif sRet == "ReTryPrcd" Then
            '상품선택으로 돌아가는 경우, 상품선택 정보만 남기고 모두 초기화
		    User_SharedData_Set("")
		    User_SharedData_Set("init2")
             User_SharedData_Set("init3")
             User_SharedData_Set("init4")
		    User_SharedData_Set("init5")
		    
             g_Opng_File = G_STEP2_1_FILE  '오픈할화면
             g_Send_Data = ""              '인자정보

             NextStep()
		end if
		
	end if
End Sub

