    g_BDM_ACFD_REG_SRNO		= Form.GetSharedData("BDM_ACFD_REG_SRNO"		, false)	'해외CFD목표시장등록일련번호	
    g_BDM_ACFD_GOAL_MRKT_UNFIT_YN	= Form.GetSharedData("BDM_ACFD_GOAL_MRKT_UNFIT_YN"	, false)	'해외CFD목표시장부적합여부	
    'v0002 fin
