<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="41000" scrname="시장종합_환율/상품/금리" version="2" writer="이은섭" />
	<FORM_INFO name="Form" ly_vert="0,0,375,170,1" />
	<CONTROL_INFO>
		<LABEL name="Label0" bgcolor="272:246246246" transmode="0" ly_vert="0,0,375,170,1" />
		<IMAGE name="Image2" autosize="1" imgpath="new_tab05_off" ly_vert="121,5,40,20,1" />
		<BUTTON name="Button0" visible="0" bgcolor="234:251251251" btnimage="btn_12.9" ly_vert="10,30,355,120,0" />
		<IMAGE name="Image1" autosize="1" imgpath="new_tab04_off" ly_vert="73,5,40,20,1" />
		<IMAGE name="Image0" autosize="1" imgpath="new_tab03_on" ly_vert="25,5,40,20,1" />
		<IMAGE name="Image3" imgpath="input_03_n.9" ly_vert="10,30,355,120,1" />
		<LINKFORM name="LinkForm0" ly_vert="20,39,335,106,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1560" _ulen="1536" >
Dim g_SelectIdx
g_SelectIdx = 0

'============================================================================
'환율버튼
'============================================================================
Sub Image0_OnClick()

	g_SelectIdx = 0
	ChangeSelectImage()
	
End Sub

'============================================================================
'상품버튼
'============================================================================
Sub Image1_OnClick()

	g_SelectIdx = 1
	ChangeSelectImage()
	
End Sub

'============================================================================
'금리버튼
'============================================================================
Sub Image2_OnClick()

	g_SelectIdx = 2
	ChangeSelectImage()
	
End Sub

'============================================================================

Sub ChangeSelectImage()

	if g_SelectIdx = 0 then
		
		Image0.imgpath = "new_tab03_on"
		Image1.imgpath = "new_tab04_off"
		Image2.imgpath = "new_tab05_off"
		LinkForm0.linkfile = "mhidx41000_s4"
	
	elseif g_SelectIdx = 1 then
		
		Image0.imgpath = "new_tab03_off"
		Image1.imgpath = "new_tab04_on"
		Image2.imgpath = "new_tab05_off"
		LinkForm0.linkfile = "mhidx41000_s5"
	
	
	elseif g_SelectIdx = 2 then
	
		Image0.imgpath = "new_tab03_off"
		Image1.imgpath = "new_tab04_off"
		Image2.imgpath = "new_tab05_on"
		LinkForm0.linkfile = "mhidx41000_s6"
	
	end if

End Sub


'============================================================================
Sub Form_OnFormInit()
	ChangeSelectImage()
End Sub

	</SCRIPT_INFO>
</ROOT>