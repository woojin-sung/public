'----------------------------------------------------------------------------
' 01. 화 면 명 : 선옵현재가
' 02. 화면설명 : 선옵현재가 기본탭화면
' 03. 작    성 : 2016.04.30 LJS
'----------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szItemCode, g_ItemMarket, g_szgrdHeader1, g_szgrdHeader2, g_StockCode
Dim g_szFID_LSTN_MEDM_HGPR, g_szFID_LSTN_MEDM_LWPR
		

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode =  Form.GetSharedData( "&ITEM_FUTOPT", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	
	'20160705 NOHES START	MarketType Default : "F"로 결정
	if Len(Trim(g_szItemMarket)) == 0 Then
		g_szItemMarket = "JF"			
	end if
	'20160705 NOHES END

End Sub

'============================================================================
Sub Form_OnFormInit()

'    sUNasISCD = MAINAPI.GetItemBaseCode(  FOItemCode1.Caption( )  )
'    If sUNasISCD = "2029" Then
'	    Call Tbl_2.SetCellString( 0, 0, "KOSPI 200" )
'	    Call Tbl_2.SetCellString( 0, 0, "KOSPI 200" )
'    ElseIf sUNasISCD = "1203" Then
'	    Call Tbl_2.SetCellString( 0, 0, "KOSDAQ 150" )   
'	    Call Tbl_2.SetCellString( 0, 0, "KOSDAQ 150" )   
'    End if

	contOpt.left = 0
	
	If g_szItemMarket = "JF" Then
		contFut.visible = True
		contOpt.visible = False
	Else
		contFut.visible = False
		contOpt.visible = True
	End If
	

'	DATAMANAGER.RequestTranData( "ohhts_3070_001r" )
'	DATAMANAGER.RequestTranData( "ohhts_3070_002r" )
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	If sKey = "ITEMCODE" Then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

		'20160705 NOHES START	MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "JF"			
		end if
		'20160705 NOHES END
	
		szBase = Form.GetItemCodeInfo( g_szItemCode , "basecode")
		
		If g_szItemMarket = "JF" Then
			contFut.visible = True
			contOpt.visible = False
		Else
			contFut.visible = False
			contOpt.visible = True
		End If
		
		DATAMANAGER.RequestTranData( "ohhts_3070_001r" )
	end	if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.CancelRealData( "ohhts_sfut_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_sopt_cntg" )
	'20230913_01 HWG START : 거래소 시세증속 대응 시세 묶음처리 기능 추가 
	'ohhts_stck_cntg -> ohhts_stck_incg 교체 
	DATAMANAGER.CancelRealData( "ohhts_stck_incg" )
	'20230913_01 HWG END
	DATAMANAGER.CancelRealData( "ohhts_nmix_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_pric_extd" )
		
	Dim szCode
	
	If szTranID = "ohhts_3070_001r" Then
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
	
	ElseIf szTranID = "ohhts_3070_002r" Then
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "J" 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_002r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_StockCode 	)
		
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_002r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "U" 	)
		
		If Form.getFutureMrktId(g_szItemCode) = "KOSDAQ" Then 'kosdaq 
			DATAMANAGER.SetDataValue( 0, "ohhts_3070_002r", "InBlock2", "FID_INPUT_ISCD" , 0 , "QGG01P" 	)		'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 1001 -> QGG01P	
		Else 
			DATAMANAGER.SetDataValue( 0, "ohhts_3070_002r", "InBlock2", "FID_INPUT_ISCD" , 0 , "KGG01P" 	)		'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 0001 -> KGG01P
		End If
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	Dim szItemCode, szCode
	szItemCode = DATAMANAGER.GetDataValue( 0, "ohhts_3070_001r", "OutBlock1", "FID_SHRN_ISCD" , 0 )
	
	If szTranID = "ohhts_sfut_cntg" Then
		If g_szItemMarket = "JF" Then
			DATAMANAGER.SetDataValue( 1, "ohhts_sfut_cntg", "InBlock1", "FIDR_SHRN_ISCD" 		, 0 , szItemCode 	)
		Else
			If g_szItemMarket = "O" Then
				szCode = Form.GetFutureCode(0, false, true)
			Else
				szCode = Form.GetFutureCode(0, true, true)
			End If
			
			DATAMANAGER.SetDataValue( 1, "ohhts_sfut_cntg", "InBlock1", "FIDR_SHRN_ISCD" 		, 0 , szCode 	)
		End If
	
	ElseIf szTranID = "ohhts_sopt_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_sopt_cntg", "InBlock1", "FIDR_SHRN_ISCD" 		, 0 , szItemCode 	)
	
	ElseIf szTranID = "ohhts_nmix_cntg" Then
		If Form.getFutureMrktId(g_szItemCode) = "KOSDAQ" Then 'kosdaq 
			DATAMANAGER.SetDataValue( 1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE"	, 0 , "QGG01P"	)	'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 1001 -> QGG01P
		Else 
			DATAMANAGER.SetDataValue( 1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE"	, 0 , "KGG01P"	)	'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 0001 -> KGG01P
		End If
	    
	ElseIf szTranID = "ohhts_pric_extd" Then
	    DATAMANAGER.SetDataValue( 1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD"		, 0 , g_StockCode	)
	    
	'20230913_01 HWG START : 거래소 시세증속 대응 시세 묶음처리 기능 추가 
	'ohhts_stck_cntg -> ohhts_stck_incg 교체 
	ElseIf szTranID = "ohhts_stck_incg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD"		, 0 , g_StockCode	)
	'20230913_01 HWG END
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "ohhts_3070_001r" Then
		Dim szFID_KOR_ISNM
		Dim szUplnStag, szLslmStag, szFID_ACML_TR_PBMN
		
		g_StockCode = DATAMANAGER.GetDataValue( 0, "ohhts_3070_001r", "OutBlock1", "FID_UNAS_SHRN_ISCD", 0 )
		szFID_KOR_ISNM = DATAMANAGER.GetDataValue( 0, "ohhts_3070_001r", "OutBlock1", "FID_KOR_ISNM", 0 )
		
		szFID_ACML_TR_PBMN = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "FID_ACML_TR_PBMN" , 0 )	'거래대금 
		
		g_szFID_LSTN_MEDM_HGPR = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "FID_LSTN_MEDM_HGPR" , 0 )	'상장중최고가
		g_szFID_LSTN_MEDM_LWPR = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "FID_LSTN_MEDM_LWPR" , 0 )	'상장중최저가 
		
		szUplnStag = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "FID_PRCLMT_EXT_UPLM_STAG" , 0 )	'상한가단계
		szLslmStag = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "FID_PRCLMT_EXT_LSLM_STAG" , 0 )	'하한가단계 
		
		DATAMANAGER.RequestTranData( "ohhts_3070_002r" )
		
		contFut.tblFut3.SetCellString( 0, 1, (szFID_ACML_TR_PBMN+5)/10 )
		
		If Right( szUplnStag, 1 ) = "1" Then
			contFut.tblFut3.SetCellString( 3, 2, "상한(1단계)" )
		ElseIf Right( szUplnStag, 1 ) = "2" Then
			contFut.tblFut3.SetCellString( 3, 2, "상한(2단계)" )
		ElseIf Right( szUplnStag, 1 ) = "3" Then
			contFut.tblFut3.SetCellString( 3, 2, "상한(3단계)" )
		Else
			contFut.tblFut3.SetCellString( 3, 2, "상한" )
		End If
		
		If Right( szLslmStag, 1 ) = "1" Then
			contFut.tblFut4.SetCellString( 0, 2, "하한(1단계)" )
		ElseIf Right( szLslmStag, 1 ) = "2" Then
			contFut.tblFut4.SetCellString( 0, 2, "하한(2단계)" )
		ElseIf Right( szLslmStag, 1 ) = "3" Then
			contFut.tblFut4.SetCellString( 0, 2, "하한(3단계)" )
		Else
			contFut.tblFut4.SetCellString( 0, 2, "하한" )
		End If
		
		arrData = Split(szFID_KOR_ISNM," ")
		
		if UBOUND(arrData) < 1 then
		    Exit sub
		End if	
		
		contFut.tblFut1.SetCellString( 0, 0, arrData(0) )
		contOpt.tblOpt1.SetCellString( 0, 0, arrData(0) )
						
	ElseIf szTranID = "ohhts_3070_002r" Then	
		Dim nPRDY_VRSS1, nPRDY_VRSS2
		nPRDY_VRSS2	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3070_002r", "OutBlock1", "FID_PRDY_VRSS2" , 0 ) )
		nPRDY_VRSS1	= CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_3070_002r", "OutBlock2", "FID_PRDY_VRSS2" , 0 ) )
			
		DATAMANAGER.RequestRealData( "ohhts_nmix_cntg" )
		DATAMANAGER.RequestRealData( "ohhts_pric_extd" )
		'20230913_01 HWG START : 거래소 시세증속 대응 시세 묶음처리 기능 추가 
		'ohhts_stck_cntg -> ohhts_stck_incg 교체
		DATAMANAGER.RequestRealData( "ohhts_stck_incg" )
		'20230913_01 HWG END
		DATAMANAGER.RequestRealData( "ohhts_sfut_cntg" )
		DATAMANAGER.RequestRealData( "ohhts_sopt_cntg" )
		
	End if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	
	If szTranID = "ohhts_3070_001r" Then	
		If g_szItemMarket = "JF" Then
			Dim nACML_TR_PBMN
			nACML_TR_PBMN = DATAMANAGER.GetDataValue( 0, "ohhts_3070_001r", "OutBlock1", "FID_ACML_TR_PBMN" , 0 )
			DATAMANAGER.SetDataValue( 0, "ohhts_3070_001r", "OutBlock1", "FID_ACML_TR_PBMN" , 0 , Round( nACML_TR_PBMN / 100000 ) )
		End If
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	If szTranID = "ohhts_sfut_cntg" Then
		If g_szItemMarket = "JF" Then
			Dim nACML_TR_PBMN
			nACML_TR_PBMN = DATAMANAGER.GetDataValue( 1, "ohhts_sfut_cntg", "OutBlock1", "FIDR_ACML_TR_PBMN" , 0 )
			DATAMANAGER.SetDataValue( 1, "ohhts_sfut_cntg", "OutBlock1", "FIDR_ACML_TR_PBMN" , 0 , Round( nACML_TR_PBMN / 100000 ) )
			
		End If
	
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	If szTranID = "ohhts_pric_extd" Then
		Dim szUplnStag, szLslmStag, szFIDR_ACML_TR_PBMN
		
		szUplnStag = DATAMANAGER.GetDataValue( 1, szTranID , "OutBlock1" , "FIDR_PRCLMT_EXT_UPLM_STAG" , 0 )		'상한가단계
		szLslmStag = DATAMANAGER.GetDataValue( 1, szTranID , "OutBlock1" , "FIDR_PRCLMT_EXT_LSLM_STAG" , 0 )		'하한가단계
		szFIDR_ACML_TR_PBMN = DATAMANAGER.GetDataValue( 1, szTranID , "OutBlock1" , "FIDR_ACML_TR_PBMN" , 0 )	'누적거래대금
		
		contFut.tblFut3.SetCellString( 0, 1, (szFIDR_ACML_TR_PBMN+5)/10 )
		
		If Right( szUplnStag, 1 ) = "1" Then
			contFut.tblFut3.SetCellString( 3, 2, "상한(1단계)" )
		ElseIf Right( szUplnStag, 1 ) = "2" Then
			contFut.tblFut3.SetCellString( 3, 2, "상한(2단계)" )
		ElseIf Right( szUplnStag, 1 ) = "3" Then
			contFut.tblFut3.SetCellString( 3, 2, "상한(3단계)" )
		Else
			contFut.tblFut3.SetCellString( 3, 2, "상한" )
		End If
		
		If Right( szLslmStag, 1 ) = "1" Then
			contFut.tblFut4.SetCellString( 0, 2, "하한(1단계)" )
		ElseIf Right( szLslmStag, 1 ) = "2" Then
			contFut.tblFut4.SetCellString( 0, 2, "하한(2단계)" )
		ElseIf Right( szLslmStag, 1 ) = "3" Then
			contFut.tblFut4.SetCellString( 0, 2, "하한(3단계)" )
		Else
			contFut.tblFut4.SetCellString( 0, 2, "하한" )
		End If
		
	End If
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
			Exit Sub
		End If
		
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

		'20160705 NOHES START	MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "JF"			
		end if
		'20160705 NOHES END

		DATAMANAGER.RequestTranData( "ohhts_3070_001r" )
	End If
End Sub

'============================================================================
Sub contFut_Button0_OnClick()
	Dim szCaption
	szCaption = contFut.tblFut4.GetCellString( 1, 2 )
	
	If szCaption = "최고" Then
		contFut.tblFut4.SetCellString( 1, 2, "최저" )
		contFut.lblRow.visible = true
	Else
		contFut.tblFut4.SetCellString( 1, 2, "최고" )
		contFut.lblRow.visible = false
	End If
End Sub

'============================================================================
Sub contOpt_Button1_OnClick()
	Dim szCaption
	szCaption = contOpt.tblOpt2.GetCellString( 8, 2 )

	If szCaption = "최고" Then
		contOpt.tblOpt2.SetCellString( 8, 2, "최저" )
		contOpt.lblRow0.visible = true
	Else
		contOpt.tblOpt2.SetCellString( 8, 2, "최고" )
		contOpt.lblRow0.visible = false
	End If
End Sub

