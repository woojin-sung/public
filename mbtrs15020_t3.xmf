'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 매매일지
' 02. 화면설명 : 매매일지 일별 매매일지탭화면
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szACNO, g_szASNO, g_szgrdHeader1, g_szgrdHeader2, g_nVLTN_AMT
Dim g_szTitle
g_szTitle = "알림"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
'============================================================================
Function RequestData()
	Dim szDate, szMonth
 
     If cboDate.currentindex = "0" Then
     
        If cldFrom.Caption > cldTo.Caption Then
		    Form.ShowAlert( g_szTitle, "시작일자가 종료일자보다 큽니다.등록일자를 확인하십시오." )
            Exit Function
        End If

        If cldFrom.Caption < "20120201" Then
            Form.ShowAlert( g_szTitle, "2012년 2월 1일 이후 조회 가능합니다." )
            Exit Function
        End If

    Else
    
        If cldMonthFrom.Caption > cldMonthTo.Caption Then
            Form.ShowAlert( g_szTitle, "시작일자가 종료일자보다 큽니다.등록일자를 확인하십시오."  )
            Exit Function
        End If

        If cldMonthFrom.Caption < "200802" Then
            Form.ShowAlert( g_szTitle, "2008년 2월 이후 조회 가능 합니다." )
            Exit Function
        End If

    End If
 
	szDate =  Form.GetSharedData( "&HOST_DATE", 0 )
	szMonth = Left(szDate, 6)
 
 
	'조회기간이 오늘자 포함이면 기간계의 당일평가금액 조회
	If cboDate.currentindex = "0" And szDate >= cldFrom.caption And szDate <= cldTo.caption then
		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "WRAP_ACNT_YN" , 0 , "N" )
		'개별계좌 평가내역
		DATAMANAGER.RequestTranData( "obacb_balc_105r" )
	
	ElseIf cboDate.currentindex = "1" And szMonth >= cldMonthFrom.Caption And szMonth <= cldMonthTo.Caption Then
		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "WRAP_ACNT_YN" , 0 , "N" )
		'개별계좌 평가내역
		DATAMANAGER.RequestTranData( "obacb_balc_105r" )
     
	Else
		DATAMANAGER.RequestTranData( "ooase_erma_012r" )
 
	End If
 
	grd0.SetClear( )
	
	DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "UI_CHCK_CLS" , 0 , "Y" )

End Function



'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szCboDate, szgrdHeader1, szgrdHeader2
	
	szcboValue 	= Form.LoadConfigData("mbtrs15020", "T3_CboDate")
	g_szgrdHeader1= Form.LoadConfigData("mbtrs15020", "T3_grdHeader1")
	g_szgrdHeader2= Form.LoadConfigData("mbtrs15020", "T3_grdHeader2")

End Sub

'============================================================================
Sub Form_OnFormInit()

	cboDate.currentindex = szcboValue

	cldFrom.addday = "-30"	
	cldMonthFrom.addday = "-365"	

	If Left(g_szgrdHeader1, 7) = "th_cell" then
		grd0_OnHeaderClickUp(0, g_szgrdHeader1)	
	End If
	
	If Left(g_szgrdHeader2, 7) = "th_cell" then
		grd0_OnHeaderClickUp(0, g_szgrdHeader2)
	End If

	cboDate_OnEditComplete( CInt(cboDate.currentindex) )

End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "RECEIVE" then
		RequestData()
		
	ElseIf sEventName = "CHANGE_ORIENTATION" Then
		Form.SetSharedData("15020_CldFrom"		, cldFrom.caption		)
		Form.SetSharedData("15020_CldTo" 		, cldTo.caption		)
		Form.SetSharedData("15020_CldMonthFrom"	, cldMonthFrom.caption	)
		Form.SetSharedData("15020_CldMonthTo" 	, cldMonthTo.caption	)
		Form.SetSharedData("15020_CboDate" 		, cboDate.currentindex	)
		Form.SetSharedData("15020_Header1" 		, g_szgrdHeader1		)
		Form.SetSharedData("15020_Header2" 		, g_szgrdHeader2		)
		
		Form.OpenPopup( "mbtrs15020_h3" , "" , "" )
	
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNO, szASNO
	
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
	
	If szTranID = "ooase_erma_012r" Then
		DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "ACNO" 			, 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "ASNO" 			, 0 , szASNO )
		
		If cboDate.currentindex = "0" then
			DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "STA_DATE"		, 0 , cldFrom.caption )
			DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "FIN_DATE"		, 0 , cldTo.caption )
		Else
			DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "STA_YYMM" 		, 0 , cldMonthFrom.caption )
			DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "FIN_YYMM" 		, 0 , cldMonthTo.caption )
		End If
		
		
	ElseIf szTranID = "obacb_balc_105r" Then
		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "ACNO"  		, 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "ASNO"  		, 0 , szASNO )
	End If

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szData

	'계좌수익률조회
	If szTranID = "obacb_balc_105r" Then
		g_nVLTN_AMT = DATAMANAGER.GetDataValue( 0, "obacb_balc_105r", "OutBlock1", "VLTN_AMT", 0 )
		
		DATAMANAGER.SetDataValue( 0, "ooase_erma_012r", "InBlock1", "TDAY_VLTN_AMT" , 0 , g_nVLTN_AMT )		
		DATAMANAGER.RequestTranData( "ooase_erma_012r" )
	End If
	
End Sub


'============================================================================
Sub cboDate_OnEditComplete(iIndex)
	If iIndex = 0 Then
		cldFrom.visible		= true
		cldTo.visible			= true
		cldMonthFrom.visible	= false
		cldMonthTo.visible	= false
	Else
		cldFrom.visible		= false
		cldTo.visible			= false
		cldMonthFrom.visible	= true
		cldMonthTo.visible	= true
		
	End If
	
	RequestData()
End Sub

'============================================================================
Sub cldFrom_OnEditComplete()
	RequestData()
End Sub

'============================================================================
Sub cldTo_OnEditComplete()
	RequestData()
End Sub


'============================================================================
Sub grd0_OnHeaderClickUp(lRow, szCellID)
	
	If szCellID = "th_cell6" Then
		grd0.SetVisibleCol(6, "0")
		grd0.SetVisibleCol(7, "1")
		grd0.SetVisibleCol(8, "0")
		g_szgrdHeader1 = szCellID
		
	ElseIf szCellID = "th_cell7" Then
		grd0.SetVisibleCol(6, "0")
		grd0.SetVisibleCol(7, "0")
		grd0.SetVisibleCol(8, "1")
		g_szgrdHeader1 = szCellID
	
	ElseIf szCellID = "th_cell8" Then
		grd0.SetVisibleCol(6, "1")
		grd0.SetVisibleCol(7, "0")
		grd0.SetVisibleCol(8, "0")
		g_szgrdHeader1 = szCellID

	End if
	
	If szCellID = "th_cell9" Then
		grd0.SetVisibleCol(9, "0")
		grd0.SetVisibleCol(10, "1")
		grd0.SetVisibleCol(11, "0")
		g_szgrdHeader2 = szCellID
	
	ElseIf szCellID = "th_cell10" Then
		grd0.SetVisibleCol(9, "0")
		grd0.SetVisibleCol(10, "0")
		grd0.SetVisibleCol(11, "1")
		g_szgrdHeader2 = szCellID
	
	ElseIf szCellID = "th_cell11" Then
		grd0.SetVisibleCol(9, "1")
		grd0.SetVisibleCol(10, "0")
		grd0.SetVisibleCol(11, "0")
		g_szgrdHeader2 = szCellID
	
	End If
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SaveConfigData("mbtrs15020", "T3_CboDate", cboDate.currentindex )
	Form.SaveConfigData("mbtrs15020", "T3_grdHeader1", g_szgrdHeader1 )
	Form.SaveConfigData("mbtrs15020", "T3_grdHeader2", g_szgrdHeader2 )
End Sub

'============================================================================
Sub btnChart_OnClick()
	Dim szData
	
	szData = Form.GetCtlProp("#acnt0", "total")
	szData = szData & "|" & Form.GetCtlProp("#acnt0", "sequence")
	
	If cboDate.currentindex = "0" then
		szData = szData & "|" & cldFrom.caption
		szData = szData & "|" & cldTo.caption
		szData = szData & "|" & ""
		szData = szData & "|" & ""
		
	Else
		szData = szData & "|" & ""
		szData = szData & "|" & ""
		szData = szData & "|" & cldMonthFrom.caption
		szData = szData & "|" & cldMonthTo.caption
		
	End If
	
	szData = szData & "|" & g_nVLTN_AMT
	szData = szData & "|" & cboDate.cbkeydata

	Form.OpenFramePopup("mbtrs15020_p1" , szData , "")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName = "mbtrs15020" Then
		Dim szForm, szTo, szMonthForm, szMonthTo, szCboDate, szACCNO, szOldACCNO
		
		szForm 		= Form.GetSharedData( "15020_CldFrom"		, true  )
		szTo			= Form.GetSharedData( "15020_CldTo"			, true  )
		szMonthForm 	= Form.GetSharedData( "15020_CldMonthFrom"	, true  )
		szMonthTo	= Form.GetSharedData( "15020_CldMonthTo"		, true  )
		szCboDate	= Form.GetSharedData( "15020_CboDate"		, true  )
		g_szgrdHeader1= Form.GetSharedData( "15020_Header1"		, true  )
		g_szgrdHeader2= Form.GetSharedData( "15020_Header2"		, true  )
		szACCNO		= Form.GetSharedData( "15020_ACCNO"			, true  )

		szOldACCNO 	= Form.GetCtlProp("#acnt0", "caption")
		
		cldFrom.caption		= szForm		
		cldTo.caption			= szTo
		cldMonthFrom.caption	= szMonthForm
		cldMonthTo.caption	= szMonthTo	
	
		cboDate.currentindex 	= szCboDate
		
		
		
		If szOldACCNO <> szACCNO Then
			Form.SetCtlProp( "#acnt0", "caption", szACCNO )
		End If
	
		If Left(g_szgrdHeader1, 7) = "th_cell" then
			grd0_OnHeaderClickUp(0, g_szgrdHeader1)	
		End If
		
		If Left(g_szgrdHeader2, 7) = "th_cell" then
			grd0_OnHeaderClickUp(0, g_szgrdHeader2)
		End If
	
		cboDate_OnEditComplete( CInt(cboDate.currentindex) )
		
	End If
	
End Sub

