'============================================================================
Sub cont0_imgHelp_OnClick()
	cont0.imgHelp.openToolTip("D+1, D+2 예수금은  추정예수금으로 \n펀드, CFD 등 일부상품의 결제분은 \n미반영 되어 조회 될 수 있습니다.", 275, 95, 0)
End Sub

'============================================================================
Sub cont0_imgIcon_OnClick()
	if g_szList(1) == "Y" then
		call cont0_tbl5_OnClick(1 , 0)
	else
		call cont0_tbl1_OnClick(1 , 0)
	end if
End Sub



'============================================================================
Sub cont0_BtnErnnMenu_OnClick()
    Form.OpenScreen("88029" , "")
End Sub

