'============================================================================
' 01. 화 면 명 : 고객자산평가_상품별잔고_D+2예수금
' 02. 화면설명 : 고객자산평가_상품별잔고_D+2예수금
' 03. 작    성 : 2016. 02. 03. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nAcntCount	'계좌 개수	
Dim g_nAllCount	'전체조회시 계좌 Index
Dim g_szList
Dim g_sParam
Dim g_nLoanBalSmtn

Dim g_tbl00
Dim g_tbl01
Dim g_tbl02
Dim g_tbl10
Dim g_tbl20
Dim g_tbl21
Dim g_tbl22
Dim g_tbl30
Dim g_tbl31
Dim g_tbl32
g_tbl00 = 0
g_tbl01 = 0
g_tbl02 = 0
g_tbl10 = 0
g_tbl20 = 0
g_tbl21 = 0
g_tbl22 = 0
g_tbl30 = 0
g_tbl31 = 0
g_tbl32 = 0

Dim g_Flag

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' AllSearch() : 데이터 전체조회시
'============================================================================
Function AllSearch()
	g_nAllCount = g_nAllCount - 1
	if g_nAllCount > 2 then
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_157r", "InBlock1", "ACNO" , 0 , g_szList(Int(g_nAllCount)) )	'계좌번호
'		DATAMANAGER.SetDataValue( 0 , "obacb_balc_157r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )			'날짜
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_157r", "InBlock1", "UI_UNIT_CLS" , 0 , "1" )					'종합계좌
		DATAMANAGER.RequestTranData( "obacb_balc_157r" )
	else
		Set_data()
	end if

End Function
'============================================================================
Function Set_data()	'전체조회 후 데이터 세팅
	cont0.tbl4.SetCellString(0, 1, g_tbl00)
	cont0.tbl4.SetCellString(1, 1, g_tbl01)
	cont0.tbl4.SetCellString(2, 1, g_tbl02)
	cont0.tbl5.SetCellString(0, 1, g_tbl10)
	cont0.tbl6.SetCellString(0, 1, g_tbl20)
	cont0.tbl6.SetCellString(1, 1, g_tbl21)
	cont0.tbl6.SetCellString(2, 1, g_tbl22)
	cont0.tbl7.SetCellString(0, 1, g_tbl30)
	cont0.tbl7.SetCellString(1, 1, g_tbl31)
	
	'CDS 증거금이 있는경우만 타이틀 및 값 넣어줌
	If CInt(g_tbl32) > 0 Then
		cont0.tbl7.SetCellString(2, 0, "단기사채 증거금")
		cont0.tbl7.SetCellString(2, 1, g_tbl32)
	End If
	
	Dim szMore
	szMore = Form.GetEnvData("mbact71052_p9_more")
	If szMore == "" Or szMore == null Then
		Form.SetEnvData(1, "mbact71052_p9_more", "0")
	Else
		If szMore == "1" Then
			g_Flag = false
		Else
			g_Flag = true
		End If
		cont0_imgIcon_OnClick()
	End If
End Function
'============================================================================
Function TblVisible(allYN)	'전체조회 후 데이터 세팅
	cont0.imgIcon.visible = true
'	g_Flag = true
	if allYN == "Y" then
		g_tbl00 = 0
		g_tbl01 = 0
		g_tbl02 = 0
		g_tbl10 = 0
		g_tbl20 = 0
		g_tbl21 = 0
		g_tbl22 = 0
		g_tbl30 = 0
		g_tbl31 = 0
		g_tbl32 = 0
		cont0.tbl4.visible = true
		cont0.tbl5.visible = true
		cont0.tbl6.visible = false
		cont0.tbl7.visible = true
		cont0.tbl0.visible = false
		cont0.tbl1.visible = false
		cont0.tbl2.visible = false
		cont0.imgOpen0.visible = false
		cont0.tbl3.visible = false
'		call cont0_tbl5_OnClick(1 , 0)
	else
		cont0.tbl0.visible = true
		cont0.tbl1.visible = true
		cont0.tbl2.visible = false
		cont0.imgOpen0.visible = false
		cont0.tbl3.visible = true
		cont0.tbl4.visible = false
		cont0.tbl5.visible = false
		cont0.tbl6.visible = false
		cont0.tbl7.visible = false
'		call cont0_tbl1_OnClick(1 , 0)
	end if
	cont0.SetScrollAutoSize()
End Function
'============================================================================
Function VltnAmt_Request()
	DATAMANAGER.ClearInputData(0, "obacb_balc_154r")
	szCsno = Form.GetSharedData("&CUST_NUM", false )
	'Y:전체 그외:개별
	if g_szList(1) == "Y" then
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "CSNO"		  , 0 , szCsno)
	else
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ACNO"		  , 0 , Left(g_szList(3), 8))
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASNO"		  , 0 , Right(g_szList(3), 2))
	end if
	
	DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASET_CLS_CODE" , 0 , "11")
	DATAMANAGER.RequestTranData("obacb_balc_154r")
	
End Function
'============================================================================
Function Asset_Request()
	'--------------------------------------------------------------
	' 전역변수 초기화
	'--------------------------------------------------------------	
	'대상계좌 개수 세팅
	g_nAcntCount = g_szList(0)		'계좌개수
	g_nAllCount = 3 + g_nAcntCount	'마지막 계좌 
	'서비스 날리기전 인덱스 초기화
	g_nNextCount = 0
	
	TblVisible(g_szList(1))
	
	'--------------------------------------------------------------
	'서비스 호출
	'--------------------------------------------------------------
	'Y:전체 그외:개별

	if g_szList(1) == "Y" then
		AllSearch()
	else
	     
		DATAMANAGER.ClearInputData(0, "obacb_balc_157r")
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_157r", "InBlock1", "ACNO" , 0 , LEFT(g_szList(3), 8) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_157r", "InBlock1", "ASNO" , 0 , RIGHT(g_szList(3), 2) )		'계좌번호
'		DATAMANAGER.SetDataValue( 0 , "obacb_balc_157r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )			'날짜
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_157r", "InBlock1", "UI_UNIT_CLS" , 0 , "2" )					'개별계좌
		DATAMANAGER.RequestTranData( "obacb_balc_157r" )
	end if

End Function

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "mbact71052_p9" then			'D+2예수금
	
	    
	    g_nLoanBalSmtn = 0
		g_szList = Split(sParam,"○")
	
		if UBOUND(g_szList) < 1 then
			Exit Sub
		End if
		'트리거 전달값 세팅
		g_Flag = false
		g_sParam = sParam
		
		If g_szList(1) == "Y" Then '전체조회 JWH 20230612
		    cont0.LblErnnMenu.visible = False
		    cont0.BtnErnnMenu.enable  = False
		Else
		    AccAcno.caption = g_szList(3)
		    
		    If AccAcno.itemcodetype == "200" Then 'JWH 20230612
		        cont0.LblErnnMenu.visible = True
			    cont0.LblErnnMenu.setHighlight(332)
		        cont0.BtnErnnMenu.enable  = True
             Else
		        cont0.LblErnnMenu.visible = False
		        cont0.BtnErnnMenu.enable  = False	     
		    End If
		End If

		'상단 카드뷰 평가금액 서비스 호출 후 자산조회
		call VltnAmt_Request()
	
	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp0, szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, TempCount
	'---------------------------------------------------------
	'평가금액 조회
	'---------------------------------------------------------
	if szTranID == "obacb_balc_154r" then
		
		call Asset_Request()
		
	'---------------------------------------------------------
	'계좌별 예수금 조회
	'---------------------------------------------------------
	'계좌번호블록에 계좌번호+계좌명으로 출력
	elseif szTranID == "obacb_balc_157r" then

	    g_nLoanBalSmtn = g_nLoanBalSmtn + DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "LOAN_BAL_SMTN" , 0)
	    cont0.LblDisplayLoanAmt.caption = FormatNumber(Cdbl(g_nLoanBalSmtn), 0, 0, 0, -1) & "원"
	    
	    If Cdbl(g_nLoanBalSmtn) > 0 Then
             cont0.LblLoanAmt.visible        = True
             cont0.LblDisplayLoanAmt.visible = True	    
	    Else
             cont0.LblLoanAmt.visible        = False
             cont0.LblDisplayLoanAmt.visible = False
         End If
	
		szTemp0 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_157r", "OutBlock1", "ACNO" , 0) &
				DATAMANAGER.GetDataValue( 0 , "obacb_balc_157r", "OutBlock1", "ASNO" , 0)
		szTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_157r", "OutBlock1", "DRNG_ABLE_AMT" , 0)	'출금가능총액
		szTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_157r", "OutBlock1", "WTMN_ABLE_CASH_AMT" , 0)	'현금출금가능액
		szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_157r", "OutBlock1", "WTMN_ABLE_ATMT_INVT_AMT" , 0)	'CMA출금가능액
		szTemp4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_157r", "OutBlock1", "TFAM" , 0)	'예수금
		szTemp5 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_157r", "OutBlock1", "CHECK_AMT" , 0)	'수표금액
		szTemp6 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_157r", "OutBlock1", "UNAM" , 0)	'미수/미납금
		szTemp7 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_157r", "OutBlock1", "UI_D1_AFT_TFAM" , 0)	'D+1 추정예수금
		szTemp8 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_157r", "OutBlock1", "UI_D2_AFT_TFAM" , 0)	'D+2 추정예수금
		TempCount = Len(DATAMANAGER.GetDataValue( 0 , "obacb_balc_157r", "OutBlock1", "ACNT_PRNM" , 0))
		szTemp9 = Mid(DATAMANAGER.GetDataValue( 0 , "obacb_balc_157r", "OutBlock1", "ACNT_PRNM" , 0), 3, TempCount - 2)'상품명
		szTemp10 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_157r", "OutBlock1", "SBSC_MARG" , 0)	'청약증거금
		szTemp11 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_157r", "OutBlock1", "UNAM" , 0)	'미수금
		szTemp12 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_157r", "OutBlock1", "OM_BOND_MARG" , 0)	'장외채권증거금
		g_tbl00 = g_tbl00 + szTemp4
		g_tbl01 = g_tbl01 + szTemp7
		g_tbl02 = g_tbl02 + szTemp8
		g_tbl10 = g_tbl10 + szTemp1
		g_tbl20 = g_tbl20 + szTemp2
		g_tbl21 = g_tbl21 + szTemp3
		g_tbl22 = g_tbl22 + szTemp5
		g_tbl30 = g_tbl30 + szTemp10
		g_tbl31 = g_tbl31 + szTemp11
		g_tbl32 = g_tbl32 + szTemp12
		
		g_nNextCount = g_nNextCount + 1
		
		if g_szList(1) == "Y" then	'전체조회시
			AllSearch()
		
		'개별계좌일시 다른 데이터들은 컨트롤속성으로 매핑, CDS 증거금은 있을때만 보여줘야하므로 스크립트 처리
		else
			if cint(szTemp12) > 0 then
				cont0.tbl3.SetCellString(2, 0, "단기사채 증거금")
				cont0.tbl3.SetCellString(2, 1, szTemp12)
			else
				cont0.tbl3.SetCellString(2, 0, "")
				cont0.tbl3.SetCellString(2, 1, "")
			end if
			
			Dim szMore
			szMore = Form.GetEnvData("mbact71052_p9_more")
			If szMore == "" Or szMore == null Then
				Form.SetEnvData(1, "mbact71052_p9_more", "0")
			Else
				If szMore == "1" Then
					g_Flag = false
				Else
					g_Flag = true
				End If
				cont0_imgIcon_OnClick()
			End If
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	g_nNextCount = 0
	Form.ShowAlert("알림", szErrMsg)
End Sub
'============================================================================
Sub Form_OnFormInit()
	g_nAllCount = 0
    g_nLoanBalSmtn = 0
	g_szDate = Form.GetSharedData("&HOST_DATE",0)
	szDate = right(g_szDate, 6)
	cont0.lblDate.caption = szDate
	cont0.setScrollBarVisible("0") 
End Sub

'============================================================================
Sub cont0_tbl1_OnClick(lRow , lColumn)
	if CInt(lRow) == 1 and CInt(lColumn) == 0 then
		if g_Flag = false then
			cont0.imgIcon.imgpath = "icon_gray_up"
			cont0.tbl1.SetCellString(1, 0, "접기")
			cont0.Label3.top = 460
			cont0.tbl3.top = 490
			g_Flag = true
			
			Form.SetEnvData(1, "mbact71052_p9_more", "1")
		else
			cont0.imgIcon.imgpath = "icon_gray_down"
			cont0.tbl1.SetCellString(1, 0, "상세")
			cont0.Label3.top = 390
			cont0.tbl3.top = 425
			g_Flag = false
			
			Form.SetEnvData(1, "mbact71052_p9_more", "0")
		end if
		cont0.tbl2.visible 	= g_Flag
		cont0.imgOpen0.visible	= g_Flag
		
		cont0.SetScrollAutoSize()
	end if
End Sub

'============================================================================
Sub cont0_tbl2_OnClick(lRow , lColumn)

	if CInt(lRow) == 1 and CInt(lColumn) == 1 or CInt(lColumn) == 2 then
		Dim szData
		szData = CInt(cont0.tbl2.GetCellString(1, 1)) & "@" & g_sParam
		
		Form.openPopupAnimation("mbact71052_p15", szData, "", "2")
	end if
	
End Sub

'============================================================================
Sub cont0_tbl6_OnClick(lRow , lColumn)

	if CInt(lRow) == 1 and CInt(lColumn) == 1 or CInt(lColumn) == 2 then
		Dim szData
		szData = CInt(cont0.tbl6.GetCellString(1, 1)) & "@" & g_sParam
		
		Form.openPopupAnimation("mbact71052_p15", szData, "", "2")
	end if
	
End Sub

'============================================================================
Sub cont0_imgOpen0_OnClick()
	Dim szData

	' 선택계좌일 경우
	if cont0.tbl2.visible == true and cont0.tbl6.visible == false or cont0.tbl2.visible == "1" and cont0.tbl6.visible == "0" then
		szData = CInt(cont0.tbl2.GetCellString(1, 1)) & "@" & g_sParam

	' 전체계좌일 경우
	elseif cont0.tbl2.visible == false and cont0.tbl6.visible == true or cont0.tbl2.visible == "0" and cont0.tbl6.visible == "1" then
		szData = CInt(cont0.tbl6.GetCellString(1, 1)) & "@" & g_sParam
	end if
	
	Form.openPopupAnimation("mbact71052_p15", szData, "", "2")
End Sub

'============================================================================
Sub cont0_tbl5_OnClick(lRow , lColumn)
	if CInt(lRow) == 1 and CInt(lColumn) == 0 then
		if g_Flag = false then
			cont0.imgIcon.imgpath = "icon_gray_up"
			cont0.tbl5.SetCellString(1, 0, "접기")
			cont0.Label3.top = 460
			cont0.tbl7.top = 490
			g_Flag = true
			
			Form.SetEnvData(1, "mbact71052_p9_more", "1")
		else
			cont0.imgIcon.imgpath = "icon_gray_down"
			cont0.tbl5.SetCellString(1, 0, "상세")
			cont0.Label3.top = 390
			cont0.tbl7.top = 425
			g_Flag = false
			
			Form.SetEnvData(1, "mbact71052_p9_more", "0")
		end if
		cont0.tbl6.visible	= g_Flag
		cont0.imgOpen0.visible	= g_Flag
		
		cont0.SetScrollAutoSize()
	end if
End Sub
'============================================================================
Sub cont0_imgOpen_OnClick()
	Form.OpenScreen("63010" , "")
End Sub

'============================================================================
Sub cont0_lblOpen_OnClick()
	Form.OpenScreen("63010" , "")
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	cont0.imgIcon.SetMaintainingRatio("1")
	cont0.imgHelp.SetMaintainingRatio("1")
End Sub

