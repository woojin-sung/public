'============================================================================
Sub ChkButton1_OnChange(sCheckState)
	'위험고지문
	Dim szFileName, nType
	'szFileName = "SMPR_RISK_NOTI" & g_szACNO & g_szASNO & g_szSmprApltSrno & ".pdf"
	szFileName = "htsdown_23.pdf"
	nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	
	If sCheckState == "1" Then

		if nType == "0" then
			'v001  위험고지문 오류수정
			Form.OpenPdfViewer( "http://home.imeritz.com/include/resource/htsdown/PDF/"& szFileName, "위험고지문")	'운영계 주소
			'Form.OpenPdfViewer( "http://home.imeritz.com/include/resource/htsdown/PDF"& szFileName, "위험고지문")	'운영계 주소
		elseif nType == "1" then
			szFileName = "htsdown_23.pdf" '테스트용임시파일
			Form.OpenPdfViewer( "http://211.255.202.106/include/resource/htsdown/PDF/"& szFileName, "위험고지문") '테스트계주소
		end if
	End If
	
	g_Chk1 = sCheckState
End Sub

