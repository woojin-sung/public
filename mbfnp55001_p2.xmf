'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szData
Dim g_szList
Dim g_szACNO			'계좌번호
Dim g_szASNO			'계좌일련번호
Dim g_szPW			'비밀번호
Dim g_szSmprApltSrno	'스마트프로신청일련번호
Dim g_szSbscAmt		'청약금액

Dim g_Chk0			'발행계약서 확인 여부
Dim g_Chk1			'위험고지문 확인 여부
Dim g_Chk2			'상품설명서 확인 여부
Dim g_Chk3			'전자메일수령동의 확인 여부


Dim g_szYesorNo		'청약취소여부

Dim g_file_cls_code	'첨부파일조회구분
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' Setpass() : 청약 신청 함수
'============================================================================
Function Setpass()
	
	
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_031a", "InBlock1", "ACNO" , 0 , g_szACNO )			'계좌번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_031a", "InBlock1", "ASNO" , 0 , g_szASNO )		'일련번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_031a", "InBlock1", "ACNT_PWD" , 0 , g_szPW)			'비밀번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_031a", "InBlock1", "SMPR_APLT_SRNO" , 0 , g_szSmprApltSrno )	'스마트프로신청일련번호
	DATAMANAGER.SetDataValue( 0 , "obibk_pssb_031a", "InBlock1", "SBSC_AMT" , 0 , g_szSbscAmt)				'청약금액
	
	DATAMANAGER.RequestTranData( "obibk_pssb_031a" )
	
End Function

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
	Form.SetScreenName( "청약신청" )
	
	g_szData = Form.GetOpenLinkData()
	
	'테스트용데이터
	'g_szData = "30083766" & "★" & "04" & "★" & "k/nCYoKCme50WotlBrRaVtbdxEMDvdmc2GW4OWgGYbg=" & "★" & "3" & "★" & "10000000"
	'g_szData = "21873290" & "★" & "11" & "★" & "8+BVkToLHrDwcxeJb5obxGa5pQ24Wn+ILz/96f+yOso=" & "★" & "1" & "★" & "10000000"
	
	g_szList = Split( g_szData, "★")
	
	
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
	
	g_Chk0 = "0"
	g_Chk1 = "0"
	g_Chk2 = "0"
	g_Chk3 = "0"
	
	g_nSbscAmt = 0
	
	g_szACNO = g_szList(0)			'계좌번호
	g_szASNO = g_szList(1)			'계좌일련번호
	g_szPW   = g_szList(2)			'계좌비밀번호
	g_szSmprApltSrno = g_szList(3)	'스마트프로신청일련번호
	g_szSbscAmt = g_szList(4)		'스마트프로 청약금액
		
	'입력값체크
	If g_szACNO == "" or g_szACNO == Null then
		Form.ShowAlert( "알림", "계좌번호 입력오류.")
		Exit Sub
	End If
	
	If g_szASNO == "" or g_szASNO == Null then
		Form.ShowAlert( "알림", "계좌일련번호 입력오류.")
		Exit Sub
	End If
	
	If g_szPW == "" or g_szPW == Null then
		Form.ShowAlert( "알림", "계좌비밀번호 입력오류.")
		Exit Sub
	End If
	
	If g_szSmprApltSrno == "" or g_szSmprApltSrno == Null or CDBL(g_szSmprApltSrno) == 0 then
		Form.ShowAlert( "알림", "스마트프로신청일련번호 입력오류.")
		Exit Sub
	End If
	
	If g_szSbscAmt == "" or g_szSbscAmt == Null or CDBL(g_szSbscAmt) == 0 then
		Form.ShowAlert( "알림", "스마트프로청약금액 입력오류.")
		Exit Sub
	End If
	
	
End Sub

'============================================================================
' btnOK_OnClick()
'============================================================================
Sub btnOK_OnClick()

	'Form.ShowAlert( "알림", "확인버튼실행.")
	
	if g_Chk0 == "0" then		
		Form.ShowAlert( "알림", "발행계약서를 확인하여 주십시오.")
		Exit Sub
	end if
	
	if g_Chk1 == "0" then		
		Form.ShowAlert( "알림", "위험고지문을 확인하여 주십시오.")
		Exit Sub
	end if
	
	if g_Chk2 == "0" then		
		Form.ShowAlert( "알림", "상품설명서를 확인하여 주십시오.")
		Exit Sub
	end if
	
	if g_Chk3 == "0" then		
		Form.ShowAlert( "알림", "전자메일수령동의를 확인하여 주십시오.")
		Exit Sub
	end if
	
	'추가인증대상조회
	DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )
	
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "mhetc90060_p9" or sKeyName == "mhetc90060_pa" or sKeyName == "mhetc90060_pb" then
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		end if 
	elseif sKeyName == "mhetc90060_p5" then 
		if sRet ~= "cancel" then
			'청약신청
			Setpass()			
		end if
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
	elseif sKeyName == "mhetc90190_p1" then										
		'if sRet == "ok" then									
		'end if		
	end if
	
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obcsb_oimf_625r" then			'보안매체 확인을 위한 TR
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		sACNO = g_szACNO
		sACNO_PWD = g_szPW
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
	end if
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nType
	
	if szTranID == "obibk_pssb_031a" then
		Form.ShowAlert( "알림", "정상처리 되었습니다.")
		'Form.SendReturnToParent( "mbfnp53000_p1" , "Ok")
		'Form.CloseForm()
		 Form.OpenScreen("55001" , "") 
		
	elseif szTranID == "obcsb_oimf_625r" then	'보안인증
		Dim sSPLM_ATHN_NCSR_YN 
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	end if
	
	'발행계약서경로조회
	if szTranID == "obsap_smpr_016r" then
		Edit0.caption = DATAMANAGER.GetDataValue( 0, "obsap_smpr_016r", "OutBlock1", "ATCH_FILE_SRVR_NAME" , 0 )
		
		nType = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
		if nType == "0" then
			'Form.OpenPdfViewer( "http://home.imeritz.com/include/ocw/"& szFileName, "발행계약서")	'운영계 주소
			Edit0.caption = Replace(Edit0.caption,"/mtznas/bizftp","http://home.imeritz.com/include")
		elseif nType == "1" then
			Edit0.caption = Replace(Edit0.caption,"/mtznas/bizftp","http://211.255.202.106/include")
			'szFileName = "testdoc_smpr_issu_agree.pdf"	'테스트용임시파일
			'Form.OpenPdfViewer( "http://211.255.202.106/include/bfn/"& szFileName, "")	'테스트계주소			
			'Form.OpenPdfViewer( "http://211.255.202.106/include/ocw/"& szFileName, "발행계약서")	'테스트계주소			
		end if
		
		Form.OpenPdfViewer( Edit0.caption, "")
		
	end if
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obibk_pssb_031a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obibk_pssb_031a" )
		if Trim(szSubErr) <> "" and Trim(szSubErr) <> Null then
			Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")")
		else
			Form.ShowAlert( "알림", szErrMsg)
		end if
		'Form.CloseForm()			'에러시 폼 종료 해달라는 요청을 받음
	end if
	
End Sub

