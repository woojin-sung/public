'============================================================================
' 화 면 명 : MY종목뉴스_관심종목뉴스(mhnws44070_t2.xmf)
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'- 관심_환경설정 관련 -------------------------------------------------------
'Dim g_tGSelect
'Dim g_tDefault
'Dim g_tKey
'Dim g_tNm
Dim g_szCloud		' 관심동기화(0:미사용(로컬), 1:사용(서버))
Dim g_szFirst
g_szFirst = "0"

'g_kwdNm		= ""
'g_tGSelect	= {}
'g_tDefault 	= {"GW_RECENT", "GW_HOLDING"}
'g_tKey     	= {"BB", "CC"}
'g_tNm      	= {"최근조회 종목", "보유종목"}
' ---------------------------------------------------------------------------

Dim g_szGSID

Dim g_nTotalKey
Dim g_nCurKey
Dim g_nIndex
g_nTotalKey = 0
g_nCurKey = 0
g_nIndex = 0

Dim g_nNextCount
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()

	'------------------------------------------------------------------
	'MTS 위변조체크로직 추가
	'------------------------------------------------------------------
	'MTS 위변조방지 스킵 대응
	szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	szDev 		= Form.GetSharedData("&SERVER_MODE", False)
	szAppVer 	= Form.GetSharedData("&APP_VERSION_CODE", False)
	szPrivateKey	= "vjdDoV5kQc7lNK4VARxk0TSWA4k=\n"
	
	if szDev <> "1" and szOsType == "1" and Cint(szAppVer) > 39 then
		szKeyValue = Form.GetSharedData("&KEY_VALUE", False)
		
		if trim(szPrivateKey) <> trim(szKeyValue) then
			
			'20180912_01 KBC START : 모의해킹결과조치
			if Cint(szAppVer) > 44 then
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.SetSharedData("&SGB" , "BBE") 
				
				Form.sendItemPrice()			'App 종료API 추가 (네이밍무관)
				Form.sendMessage()			'App 종료API 추가 (네이밍무관)
				Form.TerminateApp()
			else 
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.TerminateApp()
			end if

			'20180912_01 KBC END
			exit sub
		end if
		
	end if
	'------------------------------------------------------------------
End Sub

'============================================================================
Sub Form_OnFormInit()
	Call f_init()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "refresh" then
		Call init_GWGroup()
	elseif sEventName == "TAB_CHANGE" then
		if sParam <> "CC" and sParam <> "BB" then
			if g_szFirst == "0" then
				g_szFirst = "1" 
				Call init_GWGroup()
			end if
			
			DIm nIdx, nSelect
			
			nRow 		= grdGroup.rowcount
			nIdx 		= -1
			nSelect 		= -1
	
			if sParam <> "" then
				nRow 		= grdGroup.rowcount
				nIdx 		= -1
				
				For i = 0 to nRow -1
					szKey = grdGroup.GetCellData("bd_code", i)
	
					if nIdx >= 0 then
						nIdx = nIdx + 1
					else
						nIdx = 0
					end if
					
					if sParam == szKey then
						nSelect = nIdx
					end if
					
					' 선택된 그룹을 삭제하였을경우의 예외처리
					if i == nRow -1 then
						if nSelect < 0 then
							nSelect = 0
						end if
					end if
				Next
				
				' 관심그룹콤보에서 최종 저장된 그룹 선택
				If CStr(nSelect) == "-1" or szSave == "CC" Then	'없거나 보유종목인 경우
					nSelect = 2	'MY관심종목 뉴스에서는 첫 관심그룹으로 세팅 - 2302 HSZ 업혁 박효정 과장님 요건
				End If
				g_szGSID = sParam
				cmbGroup.currentindex = CStr(nSelect)	
			end if
			
			g_szGSID = sParam
			cmbGroup.visible = true
			lblGroupNm.visible = true
			btnPrev.visible = true
			btnNext.visible = true
			grd01.top = 60
			grd01.height = 462
		else
			g_szGSID = sParam
			cmbGroup.visible = false
			lblGroupNm.visible = false
			btnPrev.visible = false
			btnNext.visible = false
			grd01.top = 0
			'0808 JJH 512 -> 522 수정
			grd01.height = 522
			Call f_RequestGwList()
		end if
		
		
	end if
		
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	szUSER_ID = Form.GetSharedData("&USER_ID", false)

	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
'	if szTranID == "ohhts_intr_006r" then
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_USER_ID",			0, szUSER_ID)
'
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_007r" then		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_USER_ID",         	0, szUSER_ID)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_CNCN_ISSU_NEW_GRP_ID",	0, cmbGroup.cbkeydata)
		
	' ----------------------------------------------------------------------
	' Wathcing종목 조회
	' ----------------------------------------------------------------------	
'	elseif szTranID == "ohhts_watch_003" then
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_WRTR_ID", 		0, Form.GetSharedData("&CUST_NUM", false))
'
	' ----------------------------------------------------------------------
	' 보유종목 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obsim_stsv_047r" or szTranID == "obsim_stsv_048r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID", 				0, szUSER_ID)
		
	' ----------------------------------------------------------------------
	' 관심종목 데이터조회
	' ----------------------------------------------------------------------
	elseif szTranID ==  "ohhts_1020_004r" then
'		grdList0.rowcount = 0		' 종목조회그리드 초기화
		
		for i = 0 to grdCode.rowcount - 1
			szMk	= grdCode.GetCellData("bd_mk", i)
			szCd	= Trim(grdCode.GetCellData("bd_code", i))
			
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i, szMk)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD",               i, szCd)
		Next
	' ----------------------------------------------------------------------
	' 관심종목 데이터조회		
	' 해외 시세 TR
	' ----------------------------------------------------------------------
	elseif szTranID ==  "ohhts_1030_002r" then	
		DATAMANAGER.ClearInputData( false, "ohhts_1030_002r" )
		
'		j = 0
		For i = 0 to grdCode.rowcount-1
		
'		    if grdCode.GetCellData("bd_gubun", i) == "OV" then '해외인 경우 
				szMk = grdCode.GetCellData("bd_mk", i)
				szCd = Trim(grdCode.GetCellData("bd_code", i))
				tCode = {}
				
				' MTS에서 보여주는 상품의 종목만 선택
				szMk = f_ChkMarket(szMk, szCd)
				
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i , "OV" ) '해외주식			
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_INPUT_OVRS_ISCD", i , szCd ) ' 종목코드
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_COND_MRKT_CLS_CODE", i , szMk ) '종목시장
				' 시장별 실시간여부값
				szRealAble = Form.GetSharedData( "REALTIME_"&szMk, false )
				DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE", i, szRealAble ) '실시간여부
'				j = j + 1
'			end if 
'ShowAlert(szMk ,szCd)
		Next
	end If

End Sub

'============================================================================
' ohhts_kwdn_002r 호출 전처리 함수
'============================================================================
Function RequestData_ohhts_kwdn_002r()
	DATAMANAGER.ClearInputData(0, "ohhts_kwdn_002r")
	g_nIndex = 0
	
	if g_nTotalKey < 0 then
		imgNotice.visible = true
		lbNoticeMsg.visible = true
		lbNoticeMsg.caption = "등록된 관심그룹이 없어요."
	
	else
		if CInt(g_nCurKey / 20) > 0 then
			for i = 0 to 19
				szkwdNm = grdCode.GetCellData("bd_name", g_nIndex)
				DATAMANAGER.SetDataValue(0, "ohhts_kwdn_002r", "InBlock1", "FID_SRCH_COND", i, szkwdNm)
				g_nIndex = g_nIndex + 1
			next
			g_nCurKey = g_nCurKey - 20
		else
			for i = 0 to g_nCurKey-1
				szkwdNm = grdCode.GetCellData("bd_name", g_nIndex)
				DATAMANAGER.SetDataValue(0, "ohhts_kwdn_002r", "InBlock1", "FID_SRCH_COND", i, szkwdNm)
				g_nIndex = g_nIndex + 1
			next
			g_nCurKey = 0
		end if
		DATAMANAGER.RequestTranData("ohhts_kwdn_002r")
	end if
	
End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
'	if szTranID == "ohhts_intr_006r" then
'
'		Call Save_GWGroup()		' 동기화 상태일때도 파일에는 계속저장
'		Call Insert_cmbGroup()		' 관심그룹을 그룹콤보에 넣기
		
	' ----------------------------------------------------------------------
	' 보유종목리스트
	' ----------------------------------------------------------------------
	if szTranID == "obsim_stsv_047r" then
		nIdx = 0
		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		
		for i = 0 to nCnt - 1
'			szName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "KOR_NAME" , i)
			if Trim(szName) <> "" then
				grdCode.AddRow()
'				grdCode.SetCellData("bd_name", nIdx, szName)
				nIdx = nIdx + 1
			end if
		next
		
'		if g_nTotalKey > 0 then
'			RequestData_ohhts_kwdn_002r()
'		else
'			Label0.caption = "검색 가능한 보유 종목이 없습니다."
'			Label0.visible = true	
'		end if

		dim nRow
		nRow = Cint(grdCode.rowcount)
		grd01.SetClear()

		
		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
	
		if nCnt > 0 then				
			'nRow = 0
			nRow = g_nNextCount
			if g_nNextCount == 0 or szTranID == "obsim_stsv_072r" then
				grdCode.SetClear()
			end if 			
			
			For i = 0 to nCnt -1 
			
				szCd = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD", i)
				grdCode.insertrow = nRow
				
				'20160729 NOHES START ETN, 채권 마켓타입에 따른 처리 추가
				szMk = Form.GetItemCodeInfo(szCd, "market")
				select Case szMk
				Case "Q", "BN", "B"
				
				'20210608 SWJ START : 신주인수권 보유종목 조회 오류현상 수정
				Case "J"
					szCutCd = szCd
				'20210608 SWJ END
				
				Case Else
					szCutCd = Mid(szCd, 2, Len(szCd))
					szMk = Form.GetItemCodeInfo(szCutCd, "market")
				End Select
				'20160729 NOHES END
				
				' 보유종목리스트에서 주식종목은 종목코드 맨 앞에 "A", ELW는 "J"가 붙어서 내려옴. 예외처리 ////
				' 보유종목리스트에서 선옵종목은 종목코드 맨 앞에 "K"가 붙어서 내려옴. 예외처리 20160402
				' ETN (mk) = Q, 채권(mk) = BN
		
				Select Case szMk
					Case "J", "T", "W", "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	' 20240412 HSZ : 코스닥글로벌지수 추가
						grdCode.SetCellData("bd_code", nRow, szCutCd)
'						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCutCd, "name"))	' 20160325 위젯위해 종목명 추가
					'20160729 NOHES START ETN, 채권 마켓타입에 따른 처리 추가
					Case "Q", "BN", "B"
						grdCode.SetCellData("bd_code", nRow, szCd)
'						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))
					Case "" 										'코드가 유효하지 않은 경우, 2자리 자르지 않은 전체 종목코드로 보여줌.
						grdCode.SetCellData("bd_code", nRow, szCd)
'						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))						
					'20160729 NOHES END
					Case Else
						if Left(szCd, 1, 1) == "A" or Left(szCd, 1, 1) == "K" then
							grdCode.SetCellData("bd_code", nRow, szCutCd)
'							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCutCd, "name"))	' 20160325 위젯위해 종목명 추가
						else
							grdCode.SetCellData("bd_code", nRow, szCd)
'							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))	' 20160325 위젯위해 종목명 추가
						end if
				End Select
				' ////////////////////////////////////////////////////////////////////////////////////////////
				szMk = Change_EtcMarket(szMk)
				grdCode.SetCellData("bd_mk",   nRow, szMk)
				grdCode.SetCellData("bd_gubun",   nRow, "KR") '국내
				
				nRow = nRow + 1
			Next
		end if
		
		 g_nNextCount = grdCode.rowcount			    
		if  DATAMANAGER.IsMoreNextData( "obsim_stsv_047r" ) == True then 
			DATAMANAGER.RequestNextData( "obsim_stsv_047r" )
		else
			DATAMANAGER.RequestTranData( "obsim_stsv_048r" )
		end if

	'해외 보유종목		
	elseif szTranID == "obsim_stsv_048r" then
		nCnt = DATAMANAGER.GetDataCount(0, "obsim_stsv_048r", "OutBlock1")
		if nCnt > 0 then
			'nRow = 0
			nRow = g_nNextCount
			if g_nNextCount == 0  then
				grdCode.SetClear()
			end if 				
			
			For i = 0 to nCnt -1 
				szCd = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "ISCD", i)
'				szName = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "KOR_NAME", i)
				grdCode.insertrow = nRow
				
				if Trim(szCd) <> "" then
					tCode = Split(szCd, ".")
					szCutCd = tCode[0]
					szMk = tCode[1]
					
					'20220811 SWJ START : "."이 종목코드에 들어간 종목 화면 파싱 오류
					if instr(szCd,".") <> instrRev(szCd,".") then
						szMk 	= Right(szCd,len(szCd) - instrRev(szCd,"."))			
						szCutCd  = Replace(szCd,"." & szMk,"")
					end if
					'20220811 SWJ END
				end if
				
				grdCode.SetCellData("bd_code", nRow, szCutCd )
				grdCode.SetCellData("bd_mk",   nRow, szMk)
				grdCode.SetCellData("bd_gubun",   nRow, "OV") '해외
'				grdCode.SetCellData("bd_name",   nRow, szName) 
				
				nRow = nRow + 1
			Next				
		end if
		
		g_nTotalKey = CDbl(grdCode.rowcount)
		g_nCurKey = CDbl(grdCode.rowcount)
		
		if  DATAMANAGER.IsMoreNextData( "obsim_stsv_048r" ) == True then '해외 보유종목 NEXT
			 g_nNextCount = grdCode.rowcount
			DATAMANAGER.RequestNextData( "obsim_stsv_048r" )
		else		
			if CInt(grdCode.rowcount) > 0 then
				DATAMANAGER.RequestTranData("ohhts_1020_004r")		' 관심종목 데이터조회
				
			else
				imgNotice.visible = true
				lbNoticeMsg.visible = true
				lbNoticeMsg.caption = "보유한 종목이 없어요."
			end if
		end if
				
'	' ----------------------------------------------------------------------
'	' Watching종목 조회
'	' ----------------------------------------------------------------------
'	elseif szTranID == "ohhts_watch_003" then 
'		nIdx = 0
'		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
'		
'		if nCnt < 1 then
'			Label0.caption = "등록된 Watching종목이 없습니다."
'			Label0.visible = true	
'			exit Sub
'		end if
'		
'		for i = 0 to nCnt - 1
'			szName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_KOR_ISNM" , i)
'			if Trim(szName) <> "" then
'				grdList0.AddRow()
'				grdList0.SetCellData("bd_name", nIdx, szName)
'				nIdx = nIdx + 1
'			end if
'		next
'		
'		g_nTotalKey = CDbl(grdList0.rowcount)
'		g_nCurKey = CDbl(grdList0.rowcount)
'		if g_nTotalKey > 0 then
'			RequestData_ohhts_kwdn_002r()
'		else
'			Label0.caption = "검색 가능한 Watching종목이 없습니다."
'			Label0.visible = true	
'		end if
'
	' ----------------------------------------------------------------------
	' 관심종목 종목
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		nRow = grdCode.rowcount
		
		for i = 0 to nRow - 1 
			dim szCode, szMk, szName
			
			szCode 	= grdCode.GetCellData("bd_code", i)
			szMk 	= grdCode.GetCellData("bd_mk", i)
			szMk 	= Change_EtcMarket(szMk)			
'			szName	= Form.GetItemCodeInfo(szCode, "name")
			
			grdCode.SetCellData("bd_mk", 	i, szMk)
'			grdCode.SetCellData("bd_name", 	i, szName)
		next

		Form.SetCtlProp("edtListCnt", "caption", grdCode.rowcount)

		if CInt(grdCode.rowcount) > 0 then
			DATAMANAGER.RequestTranData("ohhts_1020_004r")		' 관심종목 데이터조회
			
		else
			imgNotice.visible = true
			lbNoticeMsg.visible = true
			lbNoticeMsg.caption = "등록된 종목이 없어요."
		end if


	' ----------------------------------------------------------------------
	' 관심종목 종목데이터 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_1020_004r" then
		nIdx = 0
		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		
		for i = 0 to nCnt - 1
			szCd = grdCode.GetCellData("bd_code", i)
			
			For j = 0 to grdCode.rowcount - 1	
				Dim code
				code = DATAMANAGER.GetDataValue( false, "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ISCD" , j )  '종목코드
				if code == szCd and Trim(code) <> ""  then
					szMarketNm = f_GetMarketName(code)
			
					if szMarketNm <> "" and szMarketNm <> null then
						szName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_CNCN_ISNM" , i)
						
						if Trim(szName) <> "" then
'							ShowALert(szName,szMarketNm)
							grdCode.SetCellData("bd_name", i, szName)
	'							
	'							nIdx = nIdx + 1
						end if
					end if
				end if
				
			Next
		next
		
		DATAMANAGER.RequestTranData( "ohhts_1030_002r" ) '해외
		
	elseif szTranID == "ohhts_1030_002r" then	'해외(주간시세)
		
		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		
		for i = 0 to nCnt - 1
			szCd = grdCode.GetCellData("bd_code", i)
			
			For j = 0 to grdCode.rowcount - 1	
				
				code = DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_ISCD" , j )  '종목코드
'				ShowAlert(code ,szCd)
				if code == szCd and Trim(code) <> ""  then
					szName = DATAMANAGER.GetDataValue(0, "ohhts_1030_002r", "OutBlock1", "FIDX_KOR_ISNM" , i)
				
					if Trim(szName) <> "" then
						grdCode.SetCellData("bd_name", i, szName)
						
						nIdx = nIdx + 1
					end if
				end if
			Next
		next
		
		for i = nCnt - 1 to 0 step -1
			if grdCode.GetCellData("bd_name", i) == "" or grdCode.GetCellData("bd_name", i) == null then
				grdCode.SetDeleteRow(i)
			end if
		next
		
		g_nTotalKey = CDbl(grdCode.rowcount)
		g_nCurKey = CDbl(grdCode.rowcount)
		
		if g_nTotalKey > 0 then
			RequestData_ohhts_kwdn_002r()
		else
			imgNotice.visible = true
			lbNoticeMsg.visible = true
			lbNoticeMsg.caption = "등록된 종목이 없어요."
		end if
	' ----------------------------------------------------------------------
	' 보유종목뉴스 조회
	' ----------------------------------------------------------------------
	elseif szTranID = "ohhts_kwdn_002r" then
		nCnt		= DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		nRowCnt	= CDbl(grd01.rowcount)

		if Cint(nCnt) > 0 then
		
			for i = 0 to nCnt-1
				szDate			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_DATE", 				i)
				szTitle 			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_TITL", 				i)
				szNewsCorpCode 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_NEWS_OFER_ENTP_CODE",	i)
				szNewCorpName		= ""
				szTime 			= ""

			    if 		szNewsCorpCode == "n0" then szNewCorpName = "시황속보"
			    elseif 	szNewsCorpCode == "HK" then szNewCorpName = "한경뉴스"
			    elseif 	szNewsCorpCode == "EY" then szNewCorpName = "이데일리뉴스"
			    elseif 	szNewsCorpCode == "F0" then szNewCorpName = "공시정보"
			    elseif 	szNewsCorpCode == "MT" then szNewCorpName = "머니투데이"
			    elseif 	szNewsCorpCode == "SD" then szNewCorpName = "이투데이"
			    elseif 	szNewsCorpCode == "IS" then szNewCorpName = "인포스탁"
			    elseif 	szNewsCorpCode == "MK" then szNewCorpName = "매경뉴스"
			    elseif 	szNewsCorpCode == "FN" then szNewCorpName = "파이낸셜뉴스"
			    elseif 	szNewsCorpCode == "YN" then szNewCorpName = "연합뉴스"
			    elseif 	szNewsCorpCode == "NP" then szNewCorpName = "뉴스핌"
			    elseif 	szNewsCorpCode == "AE" then szNewCorpName = "아시아경제"
			    elseif 	szNewsCorpCode == "HE" then szNewCorpName = "헤럴드경제"
			    elseif 	szNewsCorpCode == "CD" then szNewCorpName = "CEO스코어데일리"
			    elseif 	szNewsCorpCode == "SE" then szNewCorpName = "서울경제"
			    elseif 	szNewsCorpCode == "CT" then szNewCorpName = "컨슈머타임스"
			    elseif	szNewsCorpCode == "PAX" then szNewCorpName = "딜사이트"
			    '20171226 HAMWG START - 중국/홍콩, 미국 추가
			    elseif 	szNewsCorpCode == "YICHN" then szNewCorpName = "중국/홍콩"
			    elseif 	szNewsCorpCode == "YIUSA" then szNewCorpName = "미국"
			    elseif 	szNewsCorpCode == "YIIFX" then szNewCorpName = "연합인포맥스"
			    '20240626_01 KBC : 뉴스원추가
			    elseif 	szNewsCorpCode == "NSP" then szNewCorpName = "NSP통신"					    
			    end if
			    
			    if szDate = "" then
				    szTitle		= "최근 한달 간 뉴스가 존재하지 않습니다."
				    szDate		= Replace(Now("yyyyMMdd"),"-","")
				    szTime		= Replace(FormatDateTime(now,4),":","") & Right(szDate,2) 
				    szNewCorpName	="[검색결과]"
				end if
				
				grd01.AddRow()

				grd01.SetCellData("bd_cell0", nRowCnt + i, "#" & grdCode.GetCellData("bd_name", nRowCnt + i ))
				grd01.SetCellData("bd_cell2", nRowCnt + i, szNewCorpName)
				grd01.SetCellData("bd_cell3", nRowCnt + i, szDate)
				grd01.SetCellData("bd_cell6", nRowCnt + i, szTitle)
				grd01.SetCellData("bd_cell5", nRowCnt + i ,">")
				
				grd01.SetCellFgColor("bd_cell2", nRowCnt + i, "98")
				grd01.SetCellFgColor("bd_cell3", nRowCnt + i, "98")
				grd01.SetCellFgColor("bd_cell6", nRowCnt + i, "98")
			next

			imgNotice.visible = false
			lbNoticeMsg.visible = false
		
			if g_nCurKey > 0 then
				RequestData_ohhts_kwdn_002r()
			end if
'		else
'			Label0.caption = lblGroupNm.caption & " 그룹 뉴스가 없습니다."
'			Label0.visible = true
'			
			
		end if
		
	end if

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	Form.ShowAlert("알림", szErrMsg, true)

	
	DATAMANAGER.ClearInputData(0, szTranID)
	
End Sub


'============================================================================
' 관심그룹
'============================================================================
Sub cmbGroup_OnEditComplete(iIndex)
	edtListCnt.caption = ""		' 종목리스크 카운트 에디트 클리어
	lblGroupNm.caption = cmbGroup.caption
	
	if cmbGroup.cbkeydata <> ""  and cmbGroup.cbkeydata <> null then
		' 선택되어 있는 그룹의 키를 저장한다.
		Form.SetSharedData( "TEMP_CMBKEY" , cmbGroup.cbkeydata)
		Call f_RequestGwList()
	end if
End Sub
'============================================================================
' btnPrev_OnClick : 관심그룹보기 ◁(이전)버튼
'============================================================================
Sub btnPrev_OnClick()
	if cmbGroup.cbkeydata <> ""  and cmbGroup.cbkeydata <> null then
		if Int(cmbGroup.currentindex) == 0 then
			cmbGroup.currentindex = cmbGroup.rowcount-1
		else
			cmbGroup.currentindex = cmbGroup.currentindex - 1
		end if
	end if
End Sub

'============================================================================
' btnNext_OnClick : 관심그룹보기 ▷(다음)버튼
'============================================================================
Sub btnNext_OnClick()
	if cmbGroup.cbkeydata <> ""  and cmbGroup.cbkeydata <> null then
		if Int(cmbGroup.currentindex) == Int(cmbGroup.rowcount-1) then
			cmbGroup.currentindex = 0
		else
			cmbGroup.currentindex = cmbGroup.currentindex + 1
		end if
	end if
	' 콤보의 currentindex변경시 OnEditComplete 이벤트가 적용됨	
End Sub


'============================================================================
' 그리드 클릭
'============================================================================
Sub grd01_OnClickUp(lRow, szCellID)
	Form.OpenFramePopup("mhnws44050_p3", Mid(grd01.GetCellData("bd_cell0", lRow), 2),"")
End Sub

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' 화면 초기화
'============================================================================
Function f_init()
	g_nTotalKey = 0
	g_nCurKey = 0
	g_nIndex = 0
	grd01.SetClear()

	' 관심 동기화-----------------------------------------------------------
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if

End Function

'============================================================================
' 관심그룹 재설정 (로컬/서버)
'============================================================================
Function init_GWGroup()
	grdGroup.rowcount = 0

	Call Load_GWGroup()
	Call Insert_cmbGroup()

End Function


'============================================================================
' 로컬에 저장된 관심그룹 가져오기
'============================================================================
Function Load_GWGroup()
	Dim tGroup, tList, szGroup
	
	szGroup = Form.LoadConfigData("GWANSIM", "GROUP")

	if szGroup <> "" then	
		tGroup = Split(szGroup, "♣")
		
		for i = 0 to #tGroup - 1
			tList = Split(tGroup(i), "★")
			
			grdGroup.insertrow = i
	
			grdGroup.SetCellData("bd_code",  i, tList(0))
			grdGroup.SetCellData("bd_name",  i, tList(1))
			grdGroup.SetCellData("bd_count", i, tList(2))
		next
	else
		imgNotice.visible = true
		lbNoticeMsg.visible = true
		lbNoticeMsg.caption = "등록된 관심그룹이 없어요."
	end if
	
End Function

'============================================================================
' 관심그룹을 그룹콤보에 넣기
'============================================================================
Function Insert_cmbGroup()
	Dim szgrpList, szKey, szNm, szSave
	Dim nRow, nIdx, nSelect

	' 콤보 리스트 클리어
	Form.SetCtlProp("cmbGroup", "clear", "")
	
	nRow 		= grdGroup.rowcount
	nIdx 		= -1
	nSelect 		= -1
	szgrpList	= ""
	
	'다른 탭갔다가 돌아왔을 때 저장된 값을 보여줌 화면끄면 초기화
	if Form.GetSharedData( "TEMP_CMBKEY", false  ) <> "" then
		szSave = Form.GetSharedData( "TEMP_CMBKEY", false  )
	else
		' 최종 선택(저장)된 관심그룹 키
		szSave = Form.GetEnvData("SELECT_GWGROUP")
	end if
	
	' ---- 관심_환경설정에서 가져온 관심그룹 추가 여부 Start ----------------
'	For i = 0 to #g_tDefault - 1
'		g_tGSelect[i] = Form.GetEnvData(g_tDefault[i])
'		
'		if g_tGSelect[i] == "" or g_tGSelect[i] == null then
'			g_tGSelect[i] = "1"
'		end if
'		
'		' 해당그룹 Show시
'		if g_tGSelect[i] == "1" then
'		
'			if i == 0 then
'				szgrpList	
'				= g_tKey[i] & "`" & g_tNm[i]
'				nIdx			= 0
'			else
'				if szgrpList == "" then
'					szgrpList = g_tKey[i] & "`" & g_tNm[i]
'				else
'					szgrpList = szgrpList & "\r\n" & g_tKey[i] & "`" & g_tNm[i]
'				end if
'				
'				if nIdx >= 0 then
'					nIdx = nIdx + 1
'				else
'					nIdx = 0
'				end if
'				
'			end if
'			
'			if szSave == g_tKey[i] then
'				nSelect = nIdx
'			end if
'
'			' 선택된 그룹을 삭제하였을경우의 예외처리
'			if i == nRow -1 then
'			
'				if nSelect < 0 then
'					nSelect = 0
'				end if
'				
'			end if
'			
'		end if
'		
'	NEXT
	' ---- 관심 환경설정에서 가져온 관심그룹 추가 여부 End ------------------

	' ---- 관심종목 그룹 리스트 존재시 Start --------------------------------
	if Int(nRow) > 0 then
		g_szAppFirst = "NO"
		
		For i = 0 to nRow -1
			szKey = grdGroup.GetCellData("bd_code", i)
			szNm  = grdGroup.GetCellData("bd_name", i)

			if szgrpList == "" then
				szgrpList = szKey & "`" & szNm
			else
				szgrpList = szgrpList & "\r\n" & szKey & "`" & szNm
			end if
			
			if nIdx >= 0 then
				nIdx = nIdx + 1
			else
				nIdx = 0
			end if
			
			if szSave == szKey then
				nSelect = nIdx
			end if
			
			' 선택된 그룹을 삭제하였을경우의 예외처리
			if i == nRow -1 then
				if nSelect < 0 then
					nSelect = 0
				end if
			end if
		Next
	else
		g_szAppFirst = "YES"
	end if
	' ---- 관심종목 그룹 리스트 존재시 End ----------------------------------

	' 관심그룹콤보에 리스트 init		
	cmbGroup.cbinputdatatext = szgrpList

	' 관심그룹콤보에서 최종 저장된 그룹 선택
	If CStr(nSelect) == "-1" Then	'없는 경우
		lblGroupNm.caption = cmbGroup.caption
	End If

	cmbGroup.currentindex = CStr(nSelect)	
End Function

'============================================================================
' 관심종목 조회 함수
'============================================================================
Function f_RequestGwList()
	grdCode.rowcount	= 0
	grd01.rowcount 	= 0
	' 최근조회 종목
	if g_szGSID == "BB" then		
		szRecent = Form.GetRecentHistory("99")

		Call Load_RecentList(szRecent)
	
	' 보유종목
	elseif g_szGSID == "CC" then
		g_nNextCount = 0
		DATAMANAGER.RequestTranData("obsim_stsv_047r")

	else
		Call init_GWList()		' 관심그룹의 종목을 재설정
	end if
	
End Function

'============================================================================
' Load_RecentList :  최근조회종목 리스트
'============================================================================
Function Load_RecentList(szData)
	Dim tList
	Dim szMk, szCd, szName, tCode
	tCode = {}
	
	if Trim(szData) <> "" then
		tList = Split(szData, "`")
		
		'START - 최근조회종목 100개로 제한----------------------------------
		if #tList >= 100 then
			szLen = 99
		else
			szLen = #tList - 1
		end if
		
		nRowcount = 0
		for i = 0 to szLen
			if CInt(Instr(tList(i), "@")) > 0 then	'@ 포함된 종목코드(해외주식, 해외지수 등)
				tCode = Split(tList(i), "@")
				
				szCd	 = tCode[1]
				szMk  = tCode[0]
			else
				szCd   = tList(i)
				szMk   = Form.GetItemCodeInfo(szCd, "market")
				szMk   = Change_EtcMarket(szMk)	
			end if 
		
			szName = Form.GetItemCodeInfo(tList(i), "name")
			'최근조회종목 - 상품선물 안보이게 / 상품선물 "FF"분기처리 추가
			if szMk == "CF" or szMk == "FF" then
			elseif Trim(szName) = "" then	'종목명 없는거 빼기
			else
				grdCode.insertrow = nRowcount
				
				grdCode.SetCellData("bd_code", nRowcount, szCd)
				grdCode.SetCellData("bd_mk",   nRowcount, szMk)
				grdCode.SetCellData("bd_memo", nRowcount, "")
'				grdCode.SetCellData("bd_name", nRowcount, Form.GetItemCodeInfo(tList(i), "name"))
				
				nRowcount = nRowcount + 1
			end if
		
		next
		'END---------------------------------------------------------------
	
		Form.SetCtlProp("edtListCnt", "caption", grdCode.rowcount)

	end if
	if CInt(grdCode.rowcount) > 0 then
		DATAMANAGER.RequestTranData("ohhts_1020_004r")		' 관심종목 데이터조회
		
	else
		imgNotice.visible = true
		lbNoticeMsg.visible = true
		lbNoticeMsg.caption = "최근 조회 종목이 없어요."
	end if	
End Function

'============================================================================
' 관심그룹의 종목 재설정 (로컬/서버)
'============================================================================
Function init_GWList()
	
	' 서버
	if g_szCloud == "1" then		
		DATAMANAGER.RequestTranData("ohhts_intr_007r")
	
	' 로컬
	else
		Call Load_GWList()
	end if
	
End Function

'============================================================================
' 로컬 저장된 관심종목 가져오기
'============================================================================
Function Load_GWList()
	Dim tGroup, tList, szGroup
	
	szGroup = Form.LoadConfigData("GWANSIM", cmbGroup.cbkeydata)

	if Trim(szGroup) <> "" then
		tGroup = Split(szGroup, "♣")

		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdCode.insertrow = i
	
			grdCode.SetCellData("bd_code", i, tList(0))
			grdCode.SetCellData("bd_mk",   i, tList(1))
			grdCode.SetCellData("bd_memo", i, tList(2))
'			grdCode.SetCellData("bd_name", i, tList(3))
		Next
	
		Form.SetCtlProp("edtListCnt", "caption", grdCode.rowcount)
		
		if CInt(grdCode.rowcount) > 0 then
			DATAMANAGER.RequestTranData("ohhts_1020_004r")		' 관심종목 데이터조회
			
		else
			imgNotice.visible = true
			lbNoticeMsg.visible = true
			lbNoticeMsg.caption = "등록된 종목이 없어요."
		end if
	end if
	
End Function


'============================================================================
' 해외지수(대표, 업종지수)/ 채권의 마켓구분 변경
'============================================================================
Function Change_EtcMarket(szData)

	if Trim(szData) == "UJ" then
		return "N"
	elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		return "B"
	end if	
	
	return szData
End Function

'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	Select Case szMk
		Case "J", "Q", "F", "MF", "XF", "KF", "O", "MO", "QO", "U", "T", "W", "B", "P", "N", "EN", "FN", "EMPTY", "JF", "JO", "WO"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	' 20240412 HSZ : 코스닥글로벌지수 추가
			return szMk
		'해외주식	
		Case "AX", "HK", "JP", "SZ", "SH", "NY", "OQ"
			return szMk
'		Case "N"			' 해외지수, 환율은 같은 시장구분으로 내려오기에 분리시켜야 한다.
'			If InStr(szCd, "@") == 0 then
'				return "EN"
'			else
'				return szMk
'			end if
		Case Else
			return ""
	End Select
	
End Function
'============================================================================
' f_GetMarketName : 종목코드에 따른 시장명 RETURN
'============================================================================
'0802 JJH 뉴스에 코스피 코스닥 코넥스만 노출
Function f_GetMarketName(szCode)	
	Dim szMarket, szInnerMk
	szMarket =  Form.GetItemCodeInfo(szCode, "market")
	szMarket = Change_EtcMarket(szMarket)
	szMarket = f_ChkMarket(szMarket, szCode)
	
	if szMarket == "J" then
		szInnerMk = Form.GetItemCodeInfo(szCode, "innermarket")

		if szInnerMk == "001" then
			'0821 JJH 수익증권J, 신주인수권F 제거 START------------
			if Left(szCode, 1, 1) <> "J" and Left(szCode, 1, 1) <> "F" then
				return "KOSPI"
			else
				return ""
			end if
			'0821 JJH 수익증권J, 신주인수권F 제거 END------------
		elseif szInnerMk == "002" then
			return "KOSDAQ"
'		elseif szInnerMk == "013" then
'			return "ETF"
		elseif szInnerMk == "033" then
			return "KONEX"
		else
			return ""
		end if
	else
		return ""
	end if

End Function



