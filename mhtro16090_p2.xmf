	<SCRIPT_INFO _len="4317" _ulen="3951" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문 주문확인창
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


Dim g_nCount
	g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szOrd_ItmCode		' 종목코드
Dim 	g_szOrd_ItmName		' 종목명
Dim 	g_szOrd_OrdType		' 주문구분
Dim 	g_szOrd_Security		' 현금/신용
Dim 	g_nOrd_Qty			' 주문수량
Dim 	g_nOrd_Price			' 주문가격
Dim 	g_nOrd_OrdNo			' 원주문번호
Dim 	g_nOrd_ChkAll			' 잔량전부	
Dim	g_nOrd_Decimal		' 가격자릿수
'20191029 YGH 예약주문 문구추가 Start
Dim g_nOrd_res_Type 		' 예약주문유형
Dim g_nOrd_res_time		' 주문시간유형
'20191029 YGH 예약주문 문구추가 End


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)
	If g_nIndex = "0" then
		lblMaemae.caption = "매수"
		lblMaemae.fgcolor = "290"
		btnOrder.btnimage = "btn_etc10.9.png"
		btnOrder.caption = "매수"
	ElseIf g_nIndex = "1" then
		lblMaemae.caption = "매도"
		lblMaemae.fgcolor = "291"
		btnOrder.caption = "매도"
		btnOrder.btnimage = "btn_etc11.9.png"
	ElseIf g_nIndex = "3" then
		lblMaemae.caption = "취소"
		lblMaemae.fgcolor = "293"
		btnOrder.caption = "취소"
		btnOrder.btnimage = "btn_etc18.9.png"
	End if

		tblMaemae.SetCellString( 0, 1, g_szOrder_Acc	 )
		tblMaemae.SetCellString( 1, 1, g_szOrd_ItmCode&" | " & g_szOrd_ItmName )
		tblMaemae.SetCellString( 2, 1, g_nOrd_Price )
		tblMaemae.SetCellString( 3, 1, g_nOrd_Qty )

End Function

'============================================================================
Function SendOrder()
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문전송" , "1")
	    
	elseif g_nCount = 1 then
	    Form.CloseForm( )
    End If
    
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
'	Form.ShowAlert("szData", szData)
	g_nIndex				= arrData( 0) ' 매도수구분 (0:매수, 1:매도, 3:취소)
	g_szOrder_Acc			= arrData( 1)	' 계좌번호
	g_szOrder_AccName		= arrData( 2)	' 고객명
	g_szOrd_ItmCode 		= arrData( 3)	' 종목코드
	g_szOrd_ItmName 		= arrData( 4)	' 종목명
	g_szOrd_OrdType  		= arrData( 5)	' 주문구분
	g_szOrd_Security 		= arrData( 6)	' 현금
	g_nOrd_Qty   			= arrData( 7)	' 주문수량
	g_nOrd_Price 			= arrData( 8)	' 주문가격
	g_nOrd_OrdNo 			= arrData( 9)	' 원주문번호
	g_nOrd_ChkAll 		= arrData(10)	' 잔량전부
	g_nOrd_Decimal		= arrData(11)	' 가격자릿수

End Sub

'============================================================================
Sub Form_OnFormInit()

    Set_Data(g_nIndex)
    
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm( )	
End Sub

'============================================================================
Sub btnOrder_OnClick()
	SendOrder()
	Form.CloseForm( )	
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm( )
End Sub

	</SCRIPT_INFO>
</ROOT>