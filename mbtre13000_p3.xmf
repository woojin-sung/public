'============================================================================
' 화 면 명 : 해외CFD_주문_차입잔고팝업
' 화면설명 : 해외CFD_주문_차입잔고팝업
' 작    성 : 2021.12
'============================================================================

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_szGbn, g_szChk, g_szTab, g_szSelect
g_szAcnt, g_szAcntCd, g_szGbn, g_szChk, g_szTab, g_szSelect = "", "", "", "", "", ""

Dim g_szAcntPwd
g_szAcntPwd = ""

Dim sCodeList
sCodeList = ""

Dim g_szCustID
g_szCustID = ""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Request_Data() 
'============================================================================
Function Request_Data()
	grdList.rowcount = 0
	DATAMANAGER.RequestTranData("obtre_brng_003r")
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szCustID = Form.GetSharedData("&USER_ID", false )
	
	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"★")

	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	g_szAcnt 	= arrData[0]
	g_szAcntCd	= arrData[1]
	g_szAcntPwd	= arrData[2]
	
	Request_Data()
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	If szTranID = "obtre_brng_003r" Then
		DATAMANAGER.ClearInputData(0, "obtre_brng_003r")
		
		DATAMANAGER.SetDataValue(0, "obtre_brng_003r", "InBlock1", "ACNO" 			, 0, g_szAcnt)		
		DATAMANAGER.SetDataValue(0, "obtre_brng_003r", "InBlock1", "ASNO" 			, 0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obtre_brng_003r", "InBlock1", "ACNT_PWD"		, 0, g_szAcntPwd)
	End If
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szLoanDate, szLoanCd, szLoanSr, szData
	Dim errmsg
	
	errmsg = "종목마스터의 오류로 주문 및 시세 조회가 불가능합니다. 동일 증상 반복 시 확인 버튼을 눌러 주시기 바랍니다.\n\n ※기타문의사항은 고객지원센터 (1588-3400)로 문의하여 주시기 바랍니다."

	if lRow > -1 then
		szCdName		= grdList.GetCellData("bd_cell11"	,    lRow)
		szCd			= grdList.GetCellData("bd_cell1"	,    lRow)
		szQty		= grdList.GetCellData("bd_cell3"	,    lRow)
	
		szData = "잔고" & "★" & szCdName & "★" & szCd & "★" & szQty
		Form.SendReturnToParent("13000_BORROW", szData)
		
		Form.CloseForm()
		
	else
		Form.MsgBox("알림", errmsg, "REUPDATE", 1)		
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REUPDATE" then
		if sRet == "ok" then
			Form.reUpdateFile("mts_master.crc")
		else
			exit sub
		end if
	end if
End Sub

'============================================================================
Sub btnSearch_OnClick()
	Request_Data()
End Sub

'============================================================================
Sub acnt1_ChangeAccount()
	grdList.SetClear()
	grdList.rowcount = 0
	
	sCodeList = ""
	
	szFullAcnt = acnt1.caption
	g_szAcnt = Left(szFullAcnt,8)
	g_szAcntCd = Right(szFullAcnt,2)
	
	Request_Data()
End Sub





