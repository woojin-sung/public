'============================================================================
' 01.화면명 	: 펀드매매
' 02.화면설명	: 펀드매매_펀드매도확인팝업
' 03.작성	: 2016.03.02
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szFullAcnt		'계좌번호	
dim	g_szRmndNo		'잔고번호
dim	g_szRet			'팝업리턴값
dim	g_szDealFee		'선취수수료
dim	g_szAlertTitle	'알림타이틀

g_szFullAcnt	= ""
g_szRmndNo	= ""
g_szDealFee	= "0"

g_szRet	=	"cancel"
g_szAlertTitle	=	"알림"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim	szLinkedData,	szAcntName
	dim	szAcnt,	szAsno
	
	szLinkedData	=""
	szAcntName	=""
	szAcnt		=""
	szAsno		=""
	
	szLinkedData	=	Form.Form.GetOpenLinkData()
	
	if	len(trim(szLinkedData))	>	7	then
		'계좌번호, 잔고번호, 펀드명, 매도신청좌수, 잔고평가금액, 신청유형
'		Form.OpenPopup("mbfnp51010_p7" , g_szFullAcnt & "★" &  g_szRmndNo & "★" &  g_szFndname & "★" &
'									 edtSellAmt.caption  & "★" &  tbl02.GetCellString(1, 1) & "★" &  cmbSellType01.cbkeydata

		g_szFullAcnt		=	getListItem(szLinkedData,0)
		g_szRmndNo		=	getListItem(szLinkedData,1)
		
		szAcnt		=	left(g_szFullAcnt,8)
		szAsno		=	mid(g_szFullAcnt,9,2)
		szAcntName 	= 	Form.GetAccountInfo(szAcnt, "name")
		
		tbl01.SetCellString(0, 1, left(szAcnt,4) & "-" & mid(szAcnt,5,4) & "-" & szAsno & "  " & szAcntName)
		tbl01.SetCellString(1, 1, g_szRmndNo)
		'tbl01.SetCellString(2, 1, getListItem(szLinkedData,2))
		lblFndName.caption	=	getListItem(szLinkedData,2)
		tbl01.SetCellString(3, 1, getListItem(szLinkedData,3))
		IF getListItem(szLinkedData,5) = "01" THEN
		    lblSellAmt.caption	=	"원"
		ELSE
		    lblSellAmt.caption	=	"좌"
		END IF
		'tbl01.SetCellString(4, 1, getListItem(szLinkedData,4))

		DATAMANAGER.RequestTranData("obsai_deal_042r")
	end	if

End Sub

'============================================================================
'btnOK_OnClick
'============================================================================
Sub btnOK_OnClick()
	g_szRet	=	"ok"
	Form.CloseForm()
End Sub


'============================================================================
'ImageClose_OnClick
'============================================================================
Sub ImageClose_OnClick()
	g_szRet	=	"cancel"
	Form.CloseForm()
End Sub


'============================================================================
'btnCancel_OnClick
'============================================================================
Sub btnCancel_OnClick()
	g_szRet	=	"cancel"
	Form.CloseForm()
End Sub

'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if	szTranID	=	"obsai_deal_042r"	then
		DATAMANAGER.ClearInputData(0, "obsai_deal_042r")
		
		DATAMANAGER.SetDataValue(0,"obsai_deal_042r", "InBlock1", "ACNO", 0, left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0,"obsai_deal_042r", "InBlock1", "ASNO", 0, mid(g_szFullAcnt,9,2))
		DATAMANAGER.SetDataValue(0,"obsai_deal_042r", "InBlock1", "RMND_SRNO", 0, g_szRmndNo )
	
		DATAMANAGER.SetDataValue(0, "obsai_deal_042r", "InBlock1", "DEAL_CLS_CODE", 0, "1")
		DATAMANAGER.SetDataValue(0, "obsai_deal_042r", "InBlock1", "LOAN_YN", 0, "N")	
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if	szTranID	=	"obsai_deal_042r"	then
		g_szDealFee	=	DATAMANAGER.GetDataValue(0, "obsai_deal_042r", "OutBlock1", "DEAL_FEE", 0)
		'tbl01.SetCellString(5, 1, g_szDealFee)
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if	len(trim(szSubMsg))	>	0	then
		Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert(g_szAlertTitle, szErrMsg )
	end	if
End Sub



'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbfnp51010_p7" , g_szRet & "★" & g_szDealFee)
End Sub



