	<SCRIPT_INFO _len="3921" _ulen="3679" >
dim	g_szRet	'리턴값

dim g_SHTR_BOND_REG_CLS_CODE	'단기사채등록구분코드
dim g_PBLC_DATE	'발행일
dim g_PSNT_DATE	'매수일(현재일자)

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		dim tData, szProdCd, szProdText
		tData = Split(szOpenData, "★")
		szProdCd = Form.GetAccountInfo(tData(0), "productcode")
		szProdText = Form.GetMetaData("상품코드", szProdCd)
		
		
		lblTableData1.caption 		= "["&szProdText&"] "&Left(tData(0),4)&"-"&Mid(tData(0),5,4)&"-"&Right(tData(0),2)
			
		'종목명 긴 경우, 멀티라인 2줄까지만 출력되도록..
		if Len(tData(1)) > 40 then
			lblTableData2.fontsize = -4
		else
			lblTableData2.fontsize = -2
		end if
		
		lblTableData2.caption 		= tData(1)
		lblTableData3.caption 		= tData(2)
		lblTableData4.caption 		= tData(3)
		lblTableData5.caption 		= tData(4)
		lblTableData6.caption 		= tData(5)
		lblTableData7.caption 		= tData(6)
		lblTableData8.caption 		= tData(7)
		g_PBLC_DATE 				= tData(8)
		lblTableData10.caption 	= tData(9)		
		g_SHTR_BOND_REG_CLS_CODE	= tData(10)
		g_PSNT_DATE 				= tData(11)
		
		if g_SHTR_BOND_REG_CLS_CODE == "1" then	'발행물
			lblTableSub9.caption = "발행일"
			
			lblTableData9.caption = g_PBLC_DATE'tData(8)
			
		else
			'유통물인 경우, 발행일 대신 매수일(obsap_deal_003r.PSNT_DATE)로 셋팅!
			lblTableSub9.caption = "매수신청일"
			
			lblTableData9.caption = g_PSNT_DATE	'tData(11)
			
		end if
		
	end if
	
	
'	szIsNm = "메리츠증권 20230424-60"	'test
''	szIsNm = "유동화 단기사채 메타그린제칠차 20230315-92-1(E)"	'test
