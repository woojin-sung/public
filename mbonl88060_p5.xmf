'	lblTableData2.caption = szIsNm	'eplace(szIsNm, ".", "\n")
'	lblTableData3.caption = 123.56
End Sub

'============================================================================
Sub btnList_OnClick
	g_szRet = "ALL_CLOSE"
	
	'주문내역
	Form.OpenNextPopup("mbonl88061", "", "")
End Sub

'============================================================================
Sub btnOk_OnClick()
	g_szRet = "ALL_CLOSE"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl88060_p5" ,  g_szRet)
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	g_szRet = "ALL_CLOSE"
	Form.CloseForm()
End Sub

'============================================================================
Function Str_Chk(str, sGubn)
	dim i							'루프용 
	dim chk_n						'숫자 체크
	dim chk_c						'영문 체크
	dim chk_t						'특수 체크
    
	chk_n = 0 '숫자
	chk_c = 0 '영어
	chk_t = 0 '특수문자
    
	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))
		
	    '48~57 : 0~9
	    '65~90 : A~Z
	    '97~122: a~z
		If nAscii >=48 and nAscii <=57 Then 
		    chk_n = 1 	
		Elseif   (nAscii >=65 and nAscii <=90) or ( nAscii >=97 and nAscii <=122) Then
		    chk_c = 1 
		Elseif   (nAscii >=33 and nAscii <=47) or ( nAscii >=58 and nAscii <=64)  or ( nAscii >=91 and nAscii <=96)  or ( nAscii >=123 and nAscii <=126) Then
		    chk_t = 1 
		Else 
		   If nAscii <> 32 Then 'space	
			   return False
		   End If
		End if 		    
	Next
    
	If sGubn == "ENG_NAME" then
		If chk_n == 1 Then  
			return False
		End if
	End if
	
	return True
End Function 

