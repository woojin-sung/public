	<SCRIPT_INFO _len="35662" _ulen="33590" >
'20210916 SWJ START : 시장종합 내 지수화면 개편

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szValues 		'설정한값 리스트				'총 15개
dim  g_szFileName		'파일명
dim  g_szMarkets		'설정값에 따른 시장명들
dim  g_szCodes		'설정값에 따른 input code
dim  g_szFutCode		'근월물
dim	g_szNames		'종목명들
dim	g_szRMarkets		'실시간등록된시장들	for 테이블들의 값을 분기해주기 위함
dim	g_szRCodes		'실시간등록된코드들	for 테이블들의 값을 분기해주기 위함
dim	g_szRNames		'실시간등록된Name들	for 테이블들의 값을 분기해주기 위함
dim	g_szKeyNames		'Config Key값

g_szMarkets		=	Array("U","U","U","F","N"
					,"N","N","N","N","N","N","N")	'20180130 HAMWG : 상해A, 심청A 지수추가
					'"EN","EN","EN","FN","FN")
g_szNames		=	Array("코스피종합", "코스닥종합", "KOSPI200", "선물", "다우산업",
					 "나스닥종합", "S&P500", "상해종합", "상해A", "심천A", "홍콩H", "니케이225") '20180130 HAMWG : 상해A, 심청A 지수추가
					 '"원/달러", "원/위안", "원/엔", "금 선물", "WTI")

g_szKeyNames		=	Array("41000_KOSPI", "41000_KOSDAQ", "41000_KOSPI200", "41000_FUTURE",
						  "41000_DOW", "41000_NASDAQ", "41000_SP500", "41000_SHANGHAI",
						  "41000_SHANGHAIA", "41000_SHENZHENA", "41000_HONGKONG", "41000_NIKKEI") '20180130 HAMWG : 상해A, 심청A 지수추가
						  
g_szRCodes		=	Array()
g_szRMarkets		=	Array()
g_szRNames		=	Array()

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Function SettingFlag(nCodes, nIdx)
	dim	szimgName
	dim	szCtrlName
	
	szimgName	=""
	szCtrlName	=""
	
	'20221117 LES START 차세대 업종코드변경
	'0001 => KGG01P, 1001 => QGG01P, 2029 => K2G01P
	if	trim(nCodes)	=	"KGG01P"	or	trim(nCodes)	=	"QGG01P"	or
		trim(nCodes)	=	"K2G01P"	or	trim(nCodes)	=	g_szFutCode	then
		szimgName	=	"flag_ko"
	elseif	trim(nCodes)	=	"DJI@DJI"	or	trim(nCodes)	=	"NAS@IXIC"	or
			trim(nCodes)	=	"SPI@SPX"							then
		szimgName	=	"flag_us"
	elseif	trim(nCodes)	=	"SHS@000001"	or	trim(nCodes)	=	"HSI@HSCE"	or
			trim(nCodes)	=	"SHS@000002"	or	trim(nCodes)	=	"SZS@399107"	then	'20180130 HAMWG : 상해A, 심청A 지수추가
		szimgName	=	"flag_ch"
	elseif	trim(nCodes)	=   "NII@NI225"							then
		szimgName	=	"flag_jp"
	else
		szimgName	=	""
	end	if
		
	szCtrlName	=	"Imageflag0" & Cstr(nIdx+1)
		
	Form.SetCtlProp(szCtrlName, "imgpath", szimgName)
		
	
end	Function

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	g_szFileName = "41000ITEMS.ini"

	g_szValues = Array()
	
	for i = 0 	to	UBound(g_szKeyNames)
		g_szValues(i)		= Form.LoadConfigData(g_szFileName, g_szKeyNames(i))
	next

	DATAMANAGER.RequestTranData("ohhts_0510_001r")
	
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim nIdx	'데이터위치값
	dim szTblname
	
	nIdx	=	0
	
	if szTranID = "ohhts_1500_001r" then
			
			For i=0 To UBound(g_szValues)
				  if	g_szValues(i)	=	"1"	then
					 
					   DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarkets(0))
					   DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_ISCD",0, g_szCodes(0))
					    				  
					   Label1.caption = g_szNames(0)
					   
					   SettingFlag(g_szCodes(0), 0)
					   
					'   g_szRCodes(0) 		= g_szCodes(0)			'실시간위해서 각 테이블 코드값 저장
					'   g_szRMarkets(0) 	= g_szMarkets(0)			'실시간위해서 각 테이블 코드값 저장
					'   g_szRNames(0) 		= g_szNames(0)			'실시간위해서 각 테이블 코드값 저장
					   
				  end if
				  
			Next
	
	elseif szTranID = "ohhts_1500_001r_1" then
					 
			For i=0 To UBound(g_szValues)
				  if	g_szValues(i)	=	"1"	then
					 
					   DATAMANAGER.SetDataValue(0, "ohhts_1500_001r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarkets(1))
					   DATAMANAGER.SetDataValue(0, "ohhts_1500_001r_1", "InBlock1", "FID_INPUT_ISCD", 0 , g_szCodes(1))
					   
					   Label2.caption = g_szNames(1)
				   
					   SettingFlag(g_szCodes(1), 1)
					   
					'   g_szRCodes(1) 		= g_szCodes(1)			'실시간위해서 각 테이블 코드값 저장
					 '  g_szRMarkets(1) 	= g_szMarkets(1)			'실시간위해서 각 테이블 코드값 저장
					  ' g_szRNames(1) 		= g_szNames(1)			'실시간위해서 각 테이블 코드값 저장
					   
				  end if
				  
			Next
				  
	elseif szTranID = "ohhts_5020_002r" then
	
		'szSymbol = g_szRCodes ( 0 )		
		szToday = Form.GetSharedData( "&HOST_DATE", 0 )
		szBiz = Form.GetSharedData( "&BIZ_DT" , false ) '전영업일
		
		'20221117 LES START 차세대 업종코드변경
		'0001 => KGG01P, 1001 => QGG01P, 2029 => K2G01P
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r", "InBlock1", "FID_INPUT_ISCD", 0, "KGG01P"  )
		'20221117 LES END
		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U"  )
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U" )
		
		'20221117 LES START 차세대 업종코드변경
		'0001 => KGG01P, 1001 => QGG01P, 2029 => K2G01P
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r", "InBlock2", "FID_INPUT_ISCD", 0, "KGG01P" )
		'20221117 LES END
		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r", "InBlock2", "FID_INPUT_DATE1", 0,  szBiz)		'20211102 SWJ START : 영업일 조회로 변경
		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE", 0, "60" )
		
	elseif szTranID = "ohhts_5020_002r_1" then
		
		'szSymbol = g_szRCodes ( 1 )		
		szToday = Form.GetSharedData( "&HOST_DATE", 0 )
		szBiz = Form.GetSharedData( "&BIZ_DT" , false ) '전영업일
		
		'20221117 LES START 차세대 업종코드변경
		'0001 => KGG01P, 1001 => QGG01P, 2029 => K2G01P
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r_1", "InBlock1", "FID_INPUT_ISCD", 0, "QGG01P"  )
		'20221117 LES END
		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U"  )
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r_1", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U" )
		
		'20221117 LES START 차세대 업종코드변경
		'0001 => KGG01P, 1001 => QGG01P, 2029 => K2G01P
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r_1", "InBlock2", "FID_INPUT_ISCD", 0, "QGG01P" )
		'20221117 LES END
		
		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r_1", "InBlock2", "FID_INPUT_DATE1", 0,  szBiz) 		'20211102 SWJ START : 영업일 조회로 변경
		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_002r_1", "InBlock2", "FID_INPUT_HOUR_CLS_CODE", 0, "60" )	
	
	'20210916 SWJ START
	elseif szTranID = "ohhts_5020_001r" then

		szToday = Form.GetSharedData( "&HOST_DATE", 0 )
		
		'20221117 LES START 차세대 업종코드변경
		'0001 => KGG01P, 1001 => QGG01P, 2029 => K2G01P
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock1", "FID_INPUT_ISCD", 0, "KGG01P"  )
		'20221117 LES END
		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U"  )
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U"  )
		
		'20221117 LES START 차세대 업종코드변경
		'0001 => KGG01P, 1001 => QGG01P, 2029 => K2G01P
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock2", "FID_INPUT_ISCD", 0, "KGG01P" )
		'20221117 LES END
		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock2", "FID_INPUT_DATE1", 0, szToday  )
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR", 0, "D"  )
		
	elseif szTranID = "ohhts_5020_001r_1" then

		szToday = Form.GetSharedData( "&HOST_DATE", 0 )
		
		'20221117 LES START 차세대 업종코드변경
		'0001 => KGG01P, 1001 => QGG01P, 2029 => K2G01P
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r_1", "InBlock1", "FID_INPUT_ISCD", 0, "QGG01P"  )
		'20221117 LES END
		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U"  )
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r_1", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U"  )
		
		'20221117 LES START 차세대 업종코드변경
		'0001 => KGG01P, 1001 => QGG01P, 2029 => K2G01P
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r_1", "InBlock2", "FID_INPUT_ISCD", 0, "QGG01P" )
		'20221117 LES END
		
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r_1", "InBlock2", "FID_INPUT_DATE1", 0, szToday  )
		DATAMANAGER.SetDataValue(0, "ohhts_5020_001r_1", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR", 0, "D"  )	
	'20210916 SWJ END
	
	elseif szTranID = "ohhts_1682_002r" then
	
		szSymbol = g_szRCodes ( nIdx )		'	nCodes		
		szMarket = g_szRMarkets( nIdx )	'	szMarket = g_szMarkets( nIdx )
		
		DATAMANAGER.SetDataValue(0, "ohhts_1682_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, szMarket  )
		DATAMANAGER.SetDataValue(0, "ohhts_1682_002r", "InBlock1", "FID_INPUT_OVRS_ISCD", 0, szSymbol )
	
	elseif szTranID = "ohhts_1683_002r" then
	
		
		szSymbol = g_szRCodes ( 0 )	'nCodes		
		szMarket = g_szRMarkets( 0 )	'	szMarket = g_szMarkets( nIdx )
		
		
		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, szMarket  )
		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r", "InBlock1", "FID_INPUT_ISCD", 0, szSymbol )
		
	elseif szTranID = "ohhts_1683_002r_1" then
	
		szSymbol = g_szRCodes ( 1 )			'nCodes		
		szMarket = g_szRMarkets( 1 )	'	szMarket = g_szMarkets( nIdx )
		
		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, szMarket  )
		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r_1", "InBlock1", "FID_INPUT_ISCD", 0, szSymbol )
		
	elseif szTranID = "ohhts_1683_002r_2" then
	
		szSymbol = g_szRCodes ( 2 )			'nCodes		
		szMarket = g_szRMarkets( 2 )	'	szMarket = g_szMarkets( nIdx )
				
		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r_2", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, szMarket  )
		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r_2", "InBlock1", "FID_INPUT_ISCD", 0, szSymbol )
		
	elseif szTranID = "ohhts_1683_002r_3" then
	
		szSymbol = g_szRCodes ( 3 )			'nCodes		
		szMarket = g_szRMarkets( 3 )	'	szMarket = g_szMarkets( nIdx )
		'Form.ShowAlert(szMarket, szSymbol)
		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r_3", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, szMarket  )
		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r_3", "InBlock1", "FID_INPUT_ISCD", 0, szSymbol )
		
	elseif szTranID = "ohhts_1683_002r_4" then
	
		szSymbol = g_szRCodes ( 4 )		'nCodes		
		szMarket = g_szRMarkets( 4 )	'szMarket = g_szMarkets( nIdx )
		'Form.ShowAlert(szMarket, szSymbol)		
		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r_4", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, szMarket  )
		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r_4", "InBlock1", "FID_INPUT_ISCD", 0, szSymbol )
		
	elseif szTranID = "ohhts_1683_002r_5" then
	
		szSymbol = g_szRCodes ( 5 )		'nCodes		
		szMarket = g_szRMarkets( 5 )	'szMarket = g_szMarkets( nIdx )
				
		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r_5", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, szMarket  )
		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r_5", "InBlock1", "FID_INPUT_ISCD", 0, szSymbol )
		
	end if 
	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim nDomIdx	'국내지수
	dim nOvrIdx	'해외주요지수
	dim nNfutIdx	'해외선물
	dim nExrtIdx	'환율
	dim nFutIdx	'국내선물
	
	dim bIsDom	'국내시장실시간있는지.
	dim bIsOvrs	'해외주요지수있는지.
	dim bIsNFut	'해외선물있는지
	dim bIsExrt	'환율있는지
	dim bIsFut	'선물
	
	
	if	szTranID	=	"ohhts_0510_001r"	then
		
		g_szFutCode = TRIM(DATAMANAGER.GetDataValue(0, "ohhts_0510_001r", "OutBlock1", "FID_SHRN_ISCD", 0))
		
		'20221117 LES START 차세대 업종코드변경
		'0001 => KGG01P, 1001 => QGG01P, 2029 => K2G01P
		if g_szFutCode	<>	""	then
			g_szCodes		=	Array(	"KGG01P", "QGG01P", "K2G01P", g_szFutCode ,"DJI@DJI",
									"NAS@IXIC", "SPI@SPX", "SHS@000001", "SHS@000002", "SZS@399107", "HSI@HSCE", "NII@NI225", 
									"USDKRWSMBS", "CNYKRWCOMP","JPYKRWCOMP","COM@GC","SPT@CL")	'20180130 HAMWG : 상해A, 심청A 지수추가
							
			DATAMANAGER.RequestTranData("ohhts_1500_001r")
			DATAMANAGER.RequestTranData("ohhts_1500_001r_1")
		end if
	end if 
	
	
	nDomIdx	=	0
	nOvrIdx	= 	0
	nNfutIdx	=	0
	nExrtIdx	=	0
	nFutIdx	=	0

	bIsDom  	= false
	bIsOvrs	= false
	bIsNFut	= false
	bIsExrt	= false
	bIsFut	= false
	
	if szTranID = "ohhts_1500_001r" then
			
			DATAMANAGER.CancelRealData("ohhts_nmix_cntg")
			
			'20221117 LES START 차세대 업종코드변경
			'0001 => KGG01P, 1001 => QGG01P, 2029 => K2G01P
			
			'1. 	시장체크해서 INPUT 세팅
			DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", 0, "KGG01P")
			'20221117 LES END
			
				
			bIsDom  =	true
			
			'2.	실시간요청
			if	bIsDom =		true		then		'국내지수일때
				DATAMANAGER.RequestRealData("ohhts_nmix_cntg")
			end if
			
			'20210929 SWJ START : 호출 위치 변경
			'3. 차트 서비스 호출
			DATAMANAGER.RequestTranData("ohhts_5020_002r")
			'20210929 END
			
	end if
	
	'20211026 SWJ START : iOS 쪽 간헐적 색상 오류로 인해 서비스 분리해서 테이블 세팅
	if szTranID = "ohhts_1500_001r_1" then
			
			DATAMANAGER.CancelRealData("ohhts_nmix_cntg_1")
			
			'20221117 LES START 차세대 업종코드변경
			'0001 => KGG01P, 1001 => QGG01P, 2029 => K2G01P
			
			'1. 	시장체크해서 INPUT 세팅
			DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg_1", "InBlock1", "FIDR_BSTP_CLS_CODE", 0, "QGG01P")
			'20221117 LES END
			
			bIsDom  =	true
			
			'2.	실시간요청
			if	bIsDom =		true		then		'국내지수일때
				DATAMANAGER.RequestRealData("ohhts_nmix_cntg_1")
			end if
			
			'20210929 SWJ START : 호출 위치 변경
			'3. 차트 서비스 호출
			DATAMANAGER.RequestTranData("ohhts_5020_002r_1")
			'20210929 END
			
	end if
	
	
	If szTranID = "ohhts_5010_002r" Then	
		DATAMANAGER.RequestTranData( g_szTranID )
		
	End If
	
	If szTranID = "ohhts_5010_002r_1" Then		
		DATAMANAGER.RequestTranData( g_szTranID )
		
	End If
	
	'20210916 SWJ START
	'1분 차트 이용하지만 아침에 시세 리셋됐을 때
	'분 차트 정보가 없어서 차트가 안나오는 현상 (->일 차트로 조회)
'	if szTranID = "ohhts_5020_002r" then
'		sChkPrpr = DATAMANAGER.GetDataValue( 0, "ohhts_5020_002r", "OutBlock1", "FID_PRPR" , 0)
'		
'		sChkTime = Form.GetSharedData( "&HOST_TIME", 0 )
'		
'		if Cint(sChkTime) < 900 or Cint (sChkTime) > 1800 then
'			ChartEx1.SetPeriodType("2")
'			
'			DATAMANAGER.RequestTranData("ohhts_5020_001r")
'		end if
'		
''		if sChkPrpr = "" or sChkPrpr = null then
''			ChartEx1.SetPeriodType("2")
''			
''			DATAMANAGER.RequestTranData("ohhts_5020_001r")
''		end if
'	end if
'
'	
'	if szTranID = "ohhts_5020_002r" then
'		sChkPrpr = DATAMANAGER.GetDataValue( 0, "ohhts_5020_002r_1", "OutBlock1", "FID_PRPR" , 0)
'		
'		if sChkPrpr = "" or sChkPrpr = null then
'			ChartEx2.SetPeriodType("2")
'			
'			DATAMANAGER.RequestTranData("ohhts_5020_001r_1")
'		end if
'	end if
	'20210916 SWJ END
End Sub



