	<SCRIPT_INFO _len="1369" _ulen="1273" >
Dim g_Flag
'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
Sub btnList_OnClick()
	Form.OpenScreen("16093" , "")
End Sub

'============================================================================
Sub btnOK_OnClick()
	g_Flag = "ok"
	Form.CloseForm()
End Sub

'============================================================================
Sub Image2_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	If g_Flag == "ok" Then
		Form.SendReturnToParent("CANCEL_p7_end" , g_Flag)
	End If 
End Sub

'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()
	Select Case szData
		Case "NONE_CANCEL"
			Table0.SetCellString(1, 1, "취소가 불가합니다.")
		Case "PART_CANCEL"
			Table0.SetCellString(1, 1, "소수점 주문이")
			Table0.SetCellString(2, 1, "일부만 취소되었습니다.")	
			Table0.SetCellString(3, 1, "주문내역을 확인해주세요.")	
		Case "ALL_CANCEL"
			Table0.SetCellString(1, 1, "소수점 주문이")
			Table0.SetCellString(2, 1, "취소 되었습니다.")
	End Select 
End Sub

