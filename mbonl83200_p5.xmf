	<SCRIPT_INFO _len="2277" _ulen="2177" >
''-------------------------------------------------------------------------------------------
'' 01. 화 면 명 : 공개매수_배정내역
'' 02. 화면설명 : 공개매수_배정내역
'' 03. 작    성 : 2023.06.09 정지환
'' 04. 수    정 :  
''-------------------------------------------------------------------------------------------


'============================================================================
Sub Form_OnFormInitBefore()
	
End Sub
'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()
	Label4.setHighlight(332)
	
	g_szList = Split(szData, "★")
	
	if UBound(g_szList) > 1 then
		
		DATAMANAGER.RequestTranData( "obibk_tbag_002r" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obibk_tbag_002r" then 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD"		, 0 , g_szList(0) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TOB_SRNO" 	, 0 , g_szList(1) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 		, 0 , Left(g_szList(2),8))
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"		, 0 , Right(g_szList(2),2))
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obibk_tbag_002r" then 
		dim szClsCd, szTxtnYn
		
		szClsCd 		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PRVS_CLS_CODE"	, 0 )	'지급구분코드
		szTxtnYn 	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "TXTN_YN"			, 0 )	'과세 여부
		
		
		if szClsCd == "01" then
			Table0.SetCellString(2, 3, "현금")
		else 
			Table0.SetCellString(2, 3, "주식")
		end if
		
		if szTxtnYn == "Y" then
			Table0.SetCellString(3, 3, "과세")
		else 
			Table0.SetCellString(3, 3, "비과세")
		end if
		
		Label5.setHighlight(332)
	end if
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
    Form.CloseForm()
End Sub

'============================================================================
Sub lblTitle_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
