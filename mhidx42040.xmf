		<FORMTAB name="fmtab01" tabcount="4" tabwidthtype="1" tabheadheight="40" autosave="1" ly_vert="0,0,375,562,1" >
			<PAGE name="page009876" caption="주요지수" linkfile="mhidx42040_t1" loadingtype="1" />
			<PAGE name="page005982" caption="환율" linkfile="mhidx42040_t2" loadingtype="1" />
			<PAGE name="page002642" caption="해외장중지수" linkfile="mhidx42040_t3" loadingtype="1" />
			<PAGE name="page005955" caption="해외상품선물" linkfile="mhidx42040_t4" loadingtype="1" />
