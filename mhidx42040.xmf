'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	szOpenData = Form.GetOpenLinkData()
	arrData = Split(szOpenData,"★")
	if arrData(0) <> "" then
		if arrData(0) == "주요지수" then
			fmtab01.currenttabpageid = "page009876"
			if arrData(1) <> "" then
				Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "SELECT_RADIO", arrData(1))
			end if
		elseif arrData(0) == "환율" then
			fmtab01.currenttabpageid = "page005982"
		'20240509 HSZ START: HOME화면 연동추가
		elseif arrData(0) == "해외상품선물" then
			fmtab01.currenttabpageid = "page005955"
			if arrData(1) <> "" then
				Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "SELECT_RADIO", arrData(1))
			end if
		'20240509 HSZ END
		end if
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "SCREEN_MENU" Then							' 연결정보(상단 ...)
		If sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns1" , "0", "")
		End If
	End if	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else
			Form.triggerEvent("linkfmHoga", "sharedata", "")
		End If
	End if
End Sub

	</SCRIPT_INFO>
</ROOT>