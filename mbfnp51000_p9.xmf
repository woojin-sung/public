	<SCRIPT_INFO _len="2964" _ulen="2834" >
'============================================================================
' 01.화면명 	: 투자성향 확인
' 02.화면설명	: 투자성향 확인
' 03.작성	: 2022.09.19
'============================================================================
dim g_szInvType
dim g_szModDate
dim szGRAD_NAME
dim szKYC_GRAD_NAME

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'===========================================================================
' 숫자 리턴함수
'===========================================================================
Function GetTonumber(sNum)
	Dim nDbl
	nDbl = 0
	
	if sNum == null or Trim(sNum) == "" then
		return nDbl
	end if
	
	nDbl = CDbl(sNum)
	
	return nDbl
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szList
	g_szData = Form.GetOpenLinkData()
	szList = Split(g_szData, "☆")	
	
	if UBOUND(szList) < 1 then
		g_szInvType = "00"
		g_szModDate = ""	
	else 
		g_szInvType = szList(0)
		g_szModDate = szList(1)
	end if

	
	if len(trim(g_szInvType)) = 0 then
		g_szInvType = "00"
	end if 
	
	temp_prod_grad = CInt(g_szInvType) + 1 
	prod_grad = "0"..temp_prod_grad

	szGRAD_NAME	= Form.GetMetaData("집합투자증권상품등급코드"		, prod_grad)
	szKYC_GRAD_NAME = Form.GetMetaData("KYC투자성향등급코드"	, g_szInvType)


	lblTypA2.caption = GetTonumber(g_szInvType).."등급 "..szKYC_GRAD_NAME
	lblTypA0.caption = szGRAD_NAME .. " 이하"
	
	LEFT(g_szModDate,4)
	lblTypA1.caption = "(투자성향분석일 : " .. LEFT(g_szModDate,4) .."."..LEFT(RIGHT(g_szModDate,4),2)..".".. RIGHT(g_szModDate,2) .. ")" 
	Form.SetScreenName("투자성향 확인")
End Sub


'============================================================================
'btnCancel_OnClick
'============================================================================
Sub btnChange_OnClick()
	Form.OpenScreen("81010" ,"") 
	Form.CloseForm()
End Sub


'============================================================================
'btnOK_OnClick
'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("51000_KYCCONFIRM" , g_szRet)
End Sub

