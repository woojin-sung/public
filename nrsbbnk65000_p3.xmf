		'환전매도환율
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_2", "InBlock1", "MNEC_SELN_EXRT"		, 0 , g_nExRate_1)
		'환전매도스프레드
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_2", "InBlock1", "MNEC_SELN_SPEAD"		, 0 , g_szExRate_Spread1)
		
		'환전매수환율
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_2", "InBlock1", "MNEC_BYOV_EXRT"		, 0 , g_nExRate_2)
		'환전매수스프레드
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_2", "InBlock1", "MNEC_BYOV_SPEAD"		, 0 , g_szExRate_Spread2)
	end if
	
