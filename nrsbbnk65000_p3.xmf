	DATAMANAGER.RequestTranData("obtsd_fbnk_008r_2")
End Function

'외화입력(매수/매도)
Function Process_Tran_obtsd_fbnk_008r_2()
	szWonAmt = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_008r_2", "OutBlock1", "WNCR_TR_AMT", 0)
	szForSelAmt = DATAMANAGER.GetDataValue(false,"obtsd_fbnk_008r_2", "OutBlock1", "FRCR_SELN_AMT" , 0)
	szForBuyAmt = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_008r_2", "OutBlock1", "FRCR_BYOV_AMT", 0)
	
'	Form.ShowAlert("TEST2", szWonAmt .. "|" .. szForSelAmt .. "|" .. szForBuyAmt)
	
	'매도금액입력 
	if g_szGbn == "0" then
		if g_szCrcd_Sell == "KRW" then
			g_nMin_Amt = Cdbl(szWonAmt)
		else
			g_nMin_Amt = Cdbl(szForSelAmt)
		end if
		
	'매수금액입력
	elseif g_szGbn == "1" then
		if g_szCrcd_Buy == "KRW" then
			g_nMin_Amt = Cdbl(szWonAmt)
		else
			g_nMin_Amt = Cdbl(szForBuyAmt)
		end if
	end if

End Function

'==============================================
' 1회 환전한도 조회
'==============================================
'매도통화
Function Request_Tran_obrtp_comn_035r(szCrcd)
	g_nLimit = 0

	if szCrcd = "KRW" or szCrcd = "VND" then
		Exit Function
	end if
	
	if g_szCrcd_Sell == "VND" or g_szCrcd_Buy == "VND" then
		Exit Function
	end if
	
	DATAMANAGER.SetDataValue(0, "obrtp_comn_035r", "InBlock1", "BASC_CODE" , 0 , "EXCAP")
	
	if szCrcd = "USD" Or szCrcd = "CNY" Or szCrcd = "CNH" Or szCrcd = "HKD" Or szCrcd = "JPY"  Or szCrcd = "CHF" then
	    DATAMANAGER.SetDataValue(0, "obrtp_comn_035r", "InBlock1", "DTL_CODE"  , 0 , szCrcd)
	else
	    DATAMANAGER.SetDataValue(0, "obrtp_comn_035r", "InBlock1", "DTL_CODE"  , 0 , "ETC")
	end if

	DATAMANAGER.RequestTranData("obrtp_comn_035r")
End Function

Function Process_Tran_obrtp_comn_035r()
	szData = DATAMANAGER.GetDataValue(false, "obrtp_comn_035r", "OutBlock1", "DTL_ASST_CODE", 0)
	
	if szData <> "" then
		g_nLimit = Cdbl(szData)
	end if
End Function

'===============================================
' 키패드 입력 
'===============================================
Function Input_Btn(szKeyIdx)
	
	szTempText = lblTempInput.caption

	if szKeyIdx = "Back" then
		nLen = Form.getLen(szTempText)
		
		if nLen = 2 and left(szTempText, 1) = "-" then 
			szTempText = left(szTempText, nLen - 2)
		else
			szTempText = left(szTempText, nLen - 1)
			
			if right(szTempText, 1) = "." then
				nLen = Form.getLen(szTempText)
				szTempText = left(szTempText, nLen - 1)
			end if
		end if
	elseif szKeyIdx = "Clear" then
		szTempText = ""
	
	elseif szKeyIdx = "Minus" then
		if g_nMin < 0 then
			if szTempText = "" or left(szTempText, 1) <> "-" then 'and cdbl(szTempText) <> 0 then
				szTempText = "-" & szTempText
			end if
		end if
	
	elseif szKeyIdx = "Dot" then
		nLen = Form.getLen(szTempText)
		if g_nPoint > 0 then
			if Instr(szTempText, ".") = 0 then
			
				if left(szTempText, 1) <> "-" then
					if nLen > 0 then
						szTempText = szTempText & "."
					end if
				else	
					if nLen > 1 then
						szTempText = szTempText & "."
					end if
				end if
			end if
		end if
	elseif szKeyIdx = "Macro0" then
		if szTempText <> "" then
			szTempText = Cstr(Cdbl(szTempText) + Cdbl(Convert_MacroBtn(0)))
		else
			szTempText = Cstr(Convert_MacroBtn(0))
		end if
		
		
	elseif szKeyIdx = "Macro1" then
		if szTempText <> "" then
			szTempText = Cstr(Cdbl(szTempText) + Cdbl(Convert_MacroBtn(1)))
		else
			szTempText = Cstr(Convert_MacroBtn(1))
		end if
	elseif szKeyIdx = "Macro2" then
		if szTempText <> "" then
			szTempText = Cstr(Cdbl(szTempText) + Cdbl(Convert_MacroBtn(2)))
		else
			szTempText = Cstr(Convert_MacroBtn(2))
		end if
	elseif szKeyIdx = "Macro3" then
		if szTempText <> "" then
			szTempText = Cstr(Cdbl(szTempText) + Cdbl(Convert_MacroBtn(3)))
		else
			szTempText = Cstr(Convert_MacroBtn(3))
		end if
	elseif szKeyIdx = "Macro4" then
		szTempText = Cstr(Convert_MacroBtn(4))
	else
		if szKeyIdx = "0" then
			if Instr(szTempText, ".") = 0 then
				if szTempText = "" then
					szTempText = "0"
				elseif szTempText = "-" or szTempText = "-0" then
					szTempText = "-0"
				elseif cdbl(szTempText) = 0 then
					szTempText = "0"
				else
					szTempText = szTempText & szKeyIdx
				end if
			else
				arrTemp = split(szTempText, ".")
				nLen = Form.getLen(arrTemp(1))
				
				if nLen < g_nPoint then
					szTempText = szTempText & szKeyIdx
				end if
			end if
		elseif szKeyIdx = "00" then
			if Instr(szTempText, ".") = 0 then
				if szTempText = "" then
					szTempText = "0"
				elseif szTempText = "-" or szTempText = "-0" then
					szTempText = "-0"
				elseif cdbl(szTempText) = 0 then
					szTempText = "0"
				else
					szTempText = szTempText & szKeyIdx
				end if
			else
				arrTemp = split(szTempText, ".")
				nLen = Form.getLen(arrTemp(1))
				
				if nLen < g_nPoint-1 then
					szTempText = szTempText & szKeyIdx
				end if
			end if
		else
			if Instr(szTempText, ".") = 0 then
			
				if cdbl(szTempText) = 0 and szTempText <> "-" then
					szTempText = szKeyIdx
				else
					szTempText = szTempText & szKeyIdx
				end if
			else
				arrTemp = split(szTempText, ".")
				nLen = Form.getLen(arrTemp(1))
				
				if nLen < g_nPoint then
					szTempText = szTempText & szKeyIdx
				end if
			end if
		end if
	end if

	if szTempText == "" then
		lblTempInput.caption = szTempText
		contInput.imgRemove.visible = false
		contInput.lblInput.fgcolor = g_szTxtColor_Grey2
		contInput.lblInfo2.caption = ""
'		if g_szCrcd_Sell == "KRW" then 
'			contInfo.lblInfo1.caption = "예상환전금액 0원"
'		else
'			contInfo.lblInfo1.caption = "예상환전금액 0"&g_szCrcd_Sell
'		end if
		
		if g_szGbn == "2" then
			contInput.lblInput.caption = FormatNumber(g_nExRate_1,2) & "원 이하"
		elseif g_szGbn == "4" then
			contInput.lblInput.caption = FormatNumber(g_nExRate_1,2) & "원 이상"
		else
			contInput.lblInput.caption = "금액입력"
		end if
		
		
		btnOk.enable = true
		btnOk.fgcolor = g_szTxtColor_White
		btnOk.btnimage = "btn_20.9"
	else 
		contInput.imgRemove.visible = true
		contInput.lblInput.fgcolor = g_szTxtColor_Normal
		
		if g_szGbn == "3" or g_szGbn == "5" then
			if Cdbl(szTempText) > g_nMax then
				if g_szGbn == "3" or g_szGbn == "5" then
					contInput.lblInfo2.caption = "입력하신 금액이 환전 한도를 초과합니다."
				end if
				
				btnOk.fgcolor = g_szTxtColor_Grey
				btnOk.singleimage = "btn_09_n.9"
				
				btnOk.enable = false
'				Exit Function

				if Cdbl(szTempText) > 999999999999 then
					Exit Function
				end if
				
			elseif  Cdbl(szTempText) == 0 then
				btnOk.fgcolor = g_szTxtColor_Grey
				btnOk.singleimage = "btn_09_n.9"
				
				btnOk.enable = false
			else
				btnOk.enable = true
				btnOk.fgcolor = g_szTxtColor_White
				btnOk.btnimage = "btn_20.9"
				contInput.lblInfo2.caption = ""
			end if
		elseif g_szGbn == "2" or g_szGbn == "4" then
			nMaxRate = truncateToDecimalPlaces((g_nMax*1.1), 2)
			nMinRate = truncateToDecimalPlaces((g_nMax*0.9), 2)
		
			if Cdbl(szTempText) > nMaxRate then
				contInput.lblInfo2.caption = "최근환율 ±10% 이내로만 목표 설정이 가능합니다."
				
				btnOk.fgcolor = g_szTxtColor_Grey
				btnOk.singleimage = "btn_09_n.9"
				
				btnOk.enable = false
'				Exit Function

				if Cdbl(szTempText) > 999999999999 then
					Exit Function
				end if
'			elseif Cdbl(szTempText) < nMinRate then
'				Form.ShowAlert("알림", "최근환율 ±10% 이내로만\n목표 설정이 가능합니다.")
			else
				btnOk.enable = true
				btnOk.fgcolor = g_szTxtColor_White
				btnOk.btnimage = "btn_20.9"
				contInput.lblInfo2.caption = ""
			end if
			
'		elseif g_szGbn == "4" then
'			n10Per = Round((g_nMax*0.1), 2)
'			nMaxRate = g_nMax + n10Per
'			nMinRate = g_nMax - n10Per
'		
'			if Cdbl(szTempText) < g_nMax then
'				
'				contInput.lblInfo2.caption = "입력하신 목표 환율이 최근 환율보다 낮습니다."
'				
'				btnOk.fgcolor = g_szTxtColor_Grey
'				btnOk.singleimage = "btn_09_n.9"
'				
'				btnOk.enable = false
''				Exit Function
'
'			elseif Cdbl(szTempText) > 999999999999 then
'				btnOk.fgcolor = g_szTxtColor_Grey
'				btnOk.singleimage = "btn_09_n.9"
'				
'				btnOk.enable = false
'				
'				Exit Function
'				
'			elseif  Cdbl(szTempText) == 0 then
'				btnOk.fgcolor = g_szTxtColor_Grey
'				btnOk.singleimage = "btn_09_n.9"
'				
'				btnOk.enable = false
'			else
'				btnOk.enable = true
'				btnOk.fgcolor = g_szTxtColor_White
'				btnOk.btnimage = "btn_20.9"
'				contInput.lblInfo2.caption = ""
'			end if
		else
'			nResultData = Calc_Exchange(g_szGbn, Cdbl(szTempText))
			
			if Cdbl(szTempText) > g_nMax  then
				contInput.lblInfo2.caption = "환전가능금액을 확인해주세요"
				
				btnOk.fgcolor = g_szTxtColor_Grey
				btnOk.singleimage = "btn_09_n.9"
				
				btnOk.enable = false
				
				if Cdbl(szTempText) > 999999999999 then
					Exit Function
				end if
				
				'szTempText = g_nMax
				'Exit Function
				
			elseif Cdbl(szTempText) < g_nMin_Amt then
				btnOk.fgcolor = g_szTxtColor_Grey
				btnOk.singleimage = "btn_09_n.9"
				
				btnOk.enable = false
			else
				btnOk.enable = true
				btnOk.fgcolor = g_szTxtColor_White
				btnOk.btnimage = "btn_20.9"
				contInput.lblInfo2.caption = ""
			end if
			
			DisplaySetting_Exchange(nResultData)
		end if
		
		lblTempInput.caption = szTempText
		
		szBackSub = ""
		if g_szGbn == "0" then
			szBackSub = g_szCrcd_Sell
		elseif g_szGbn == "1" then
			szBackSub = g_szCrcd_Buy
		elseif g_szGbn == "2" then
			szBackSub = "원 이하"
		elseif g_szGbn == "4" then
			szBackSub = "원 이상"
		elseif g_szGbn == "3" or g_szGbn == "5" then
			szBackSub = g_szCrcd_Buy
		end if
		
		contInput.lblInput.caption = FormatNumber(szTempText, g_nPoint) & " " & szBackSub
		
'		if Instr(szTempText, ".") = 0 then
'			contInput.lblInput.caption = FormatNumber(szTempText, 0) & " " & szBackSub
'		else
'			arrTemp = split(szTempText, ".")
'			nLen = Form.getLen(arrTemp(1))
'
'			contInput.lblInput.caption = FormatNumber(arrTemp(0), 0) & "." & arrTemp(1) & " " & szBackSub
'		end if
	end if
End Function

Function DisplaySetting_Exchange(nResult)
	contInfo.lblInfo1.fgcolor = g_szTxtColor_Normal
	if g_szCrcd_Sell == "KRW" then 
		contInfo.lblInfo1.caption = "예상환전금액 " & FormatNumber(nResult, 0) & "원"
		
	elseif g_szCrcd_Buy == "KRW" then 
		if g_szCrcd_Sell == "JPY" then
			contInfo.lblInfo1.caption = "예상환전금액 " & FormatNumber(nResult, 0) & g_szCrcd_Sell
		else
			contInfo.lblInfo1.caption = "예상환전금액 " & FormatNumber(nResult, 2) & g_szCrcd_Sell
		end if
	else
		if g_szCrcd_Sell == "JPY"  then
			contInfo.lblInfo1.caption = "예상환전금액 " & FormatNumber(nResult, 0) & g_szCrcd_Sell
		else
			contInfo.lblInfo1.caption = "예상환전금액 " & FormatNumber(nResult, 2) & g_szCrcd_Sell
		end if
	end if
	
End Function

Function Calc_Exchange(szGbn, nAmt)
	nResultData = 0
	
	'매도금액 입력
	if szGbn == "0" then
		if g_szCrcd_Sell == "KRW" then 
		
			if g_nExRate_1 <> 0 then
			
				' 원화 -> 외화 
				nResult1 = round(nAmt / g_nExRate_1, 6)
				
				if g_szCrcd_Buy == "JPY" then
					nResultData = truncateToDecimalPlaces(nResult1, 0)
				else
					nResultData = truncateToDecimalPlaces(nResult1, 2)
				end if
			end if
			
		elseif g_szCrcd_Buy == "KRW" then 
		
			if g_nExRate_1 <> 0 then
			
				' 외화 -> 원화
				nResult1 = nAmt * g_nExRate_1
				nResultData = truncateToDecimalPlaces(nResult1, 0)
				
			end if
			
		else
			if g_nExRate_1 <> 0 and g_nExRate_2 <> 0 then
			
				'외화 -> 원화 -> 외화
				nResult1 = nAmt * g_nExRate_1
				nResult2 = truncateToDecimalPlaces(nResult1, 0)
				
				nResult3 = nResult2 / g_nExRate_2
				if g_szCrcd_Buy == "JPY" then
					nResultData = truncateToDecimalPlaces(nResult3, 0)
				else
					nResultData = truncateToDecimalPlaces(nResult3, 2)
				end if
			end if
		end if
		
	'매수금액 입력
	elseif szGbn == "1" then
		if g_szCrcd_Sell == "KRW" then 
		
			if g_nExRate_1 <> 0 then
			
				' 외화 -> 원화
				nResultData = int(nAmt * g_nExRate_1)
			end if
			
		elseif g_szCrcd_Buy == "KRW" then 
		
			' 원화 -> 외화 
			if g_nExRate_1 <> 0 then
			
				nResult1 = nAmt / g_nExRate_1
				
				if g_szCrcd_Buy == "JPY" then
					nResultData = truncateToDecimalPlaces(nResult1, 0)
				else
					nResultData = truncateToDecimalPlaces(nResult1, 2)
				end if
			end if
			
		else
			if g_nExRate_1 <> 0 and g_nExRate_2 <> 0 then
			
				'외화 -> 원화 -> 외화
				nResult1 = nAmt * g_nExRate_2
				nResult2 = truncateToDecimalPlaces(nResult1, 0)
				
				nResult3 = nResult2 / g_nExRate_1
				if g_szCrcd_Buy == "JPY" then
					nResultData = truncateToDecimalPlaces(nResult3, 0)
				else
					nResultData = truncateToDecimalPlaces(nResult3, 2)
				end if
				
			end if
		end if
	end if
	
	return nResultData
	
End Function


Function truncateToDecimalPlaces(nVal, nDeimalPlaces)
	nFactor = 10 ^ nDeimalPlaces
	return int(nVal*nFactor) / nFactor
End Function

Function Convert_FormatNumber(szCrcd, szAmt)
	if szCrcd == "KRW" or szCrcd == "JPY" then
		return FormatNumber(szAmt, 0) 
	else
		return FormatNumber(szAmt, 2)
	end if
End Function
