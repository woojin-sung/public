'===============================================
Sub btnOk_OnClick()
	if g_szGbn == "2" or g_szGbn == "4" then
		nMaxRate = truncateToDecimalPlaces((g_nMax*1.1), 2)
		nMinRate = truncateToDecimalPlaces((g_nMax*0.9), 2)
		
		
		if lblTempInput.caption <> "" then
			if Cdbl(lblTempInput.caption) < nMinRate then
				Form.ShowAlert("알림", "최근환율 ±10% 이내로만\n목표 설정이 가능합니다.")
				
				Exit Sub
			end if
		end if
			
		Form.SendReturnToParent("INPUT_TARGET_RATE" , lblTempInput.caption)
	else
		
		if g_szGbn == "0" or g_szGbn == "1" then
			if g_nLimit <> 0 then
				szCrcd = "" 
				if g_szGbn == "0" then
					szCrcd = g_szCrcd_Sell
				elseif g_szGbn == "1" then
					szCrcd = g_szCrcd_Buy
				end if
				

				if Cdbl(lblTempInput.caption) > g_nLimit then
					szData1 = "1회 환전 한도 " & FormatNumber(g_nLimit,0) & " " & szCrcd
					Form.ShowAlert("알림", "입력하신 금액이 환전 한도를 초과합니다.\n확인 후 다시 입력해주세요.\n\n" & szData1)
					
					Exit Sub
				end if
	
			end if
		end if
		
		Form.SendReturnToParent("INPUT_AMT" , lblTempInput.caption)
	end if
	
	Form.CloseForm()
End Sub

'===============================================
' imgRootBg_OnClick
'===============================================
Sub imgRootBg_OnClick()
	if g_szGbn == "2" or g_szGbn == "4" then
		Form.SendReturnToParent("INPUT_TARGET_RATE" , "Cancel")
	else
		Form.SendReturnToParent("INPUT_AMT" , "Cancel")
	end if
	
	Form.CloseForm()
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrtd_fcur_001r" then
		contInfo.imgRe.visible = true
		Process_Tran_obrtd_fcur_001r()
	elseif szTranID == "obtsd_fbnk_201r" then
		contInfo.imgRe.visible = true
		Process_Tran_obtsd_fbnk_201r()
		
	elseif szTranID == "obtsd_fbnk_008r" then
		Process_Tran_obtsd_fbnk_008r()
	elseif szTranID == "obtsd_fbnk_008r_1" then
		Process_Tran_obtsd_fbnk_008r_1()
	elseif szTranID == "obtsd_fbnk_008r_2" then
		Process_Tran_obtsd_fbnk_008r_2()
		
	elseif szTranID == "obrtp_comn_035r" then		
		Process_Tran_obrtp_comn_035r()
	end if
End Sub

'============================================================================
Sub contInfo_imgRe_OnClick()
	contInfo.imgRe.visible = false
	if g_szGbn == "0" or g_szGbn == "1" then
		Request_Tran_obrtd_fcur_001r()	
	elseif g_szGbn == "2" or g_szGbn == "4" then
		Request_Tran_obtsd_fbnk_201r(g_szCrcd_Buy)
	end if
End Sub

'============================================================================
Sub contInfo_imgToolTip_OnClick()
	sText = "통합증거금 사용 계좌에 한해 최대가능금액까지 환전가능하며, 해외주식 매매 시 타 통화 사용여부에 따라 최대가능금액은 달라질 수 있어요."
	
	
	contInfo.imgToolTip.openToolTip( sText, 350, 90, 2 )	
End Sub

'============================================================================
Sub Form_OnHelperOpen(sScreenNo)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	contInfo.imgRe.visible = true
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox("알림" , szErrMsg & "\n(" & szSubMsg & ")" , "", 0)	
End Sub

