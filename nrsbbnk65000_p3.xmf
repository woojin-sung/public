g_szInfoImg = "icon_notice"

' 화살표 이미지
Dim g_szArrowImg  
g_szArrowImg = "img_arrow_down_high"

' 삭제 이미지
Dim g_szRemoveImg  
g_szRemoveImg = "icon_remove"

' 새로고침 이미지
Dim g_szRefreshImg  
g_szRefreshImg = "icon_refresh_left"

Dim g_szToolTipImg
g_szToolTipImg = "icon_question"

'==============================================
' 컬러코드
'==============================================
' 기본 텍스트 컬러 (검정색)
Dim g_szTxtColor_Normal 
g_szTxtColor_Normal 	= "334"

' 기본 텍스트 컬러 (회색)
Dim g_szTxtColor_Grey 
g_szTxtColor_Grey 	= "333"

Dim g_szTxtColor_Grey2 
g_szTxtColor_Grey2 	= "431"

' 기본 텍스트 컬러 (흰색)
Dim g_szTxtColor_White 
g_szTxtColor_White 	= "338"

' 빨강
Dim g_szTxtColor_Red 
g_szTxtColor_Red = "290"

' 파랑
Dim g_szTxtColor_Blue 
g_szTxtColor_Blue = "291"

' 기본 배경색상
Dim g_szContBgColor
g_szContBgColor = "320"

' 기본 구분선 색상
Dim g_szLineColor
g_szLineColor = "256"

' 빨강
Dim g_szBadgeBgColor_Red
g_szBadgeBgColor_Red = "339"

' 파랑
Dim g_szBadgeBgColor_Blue
g_szBadgeBgColor_Blue = "340"

'==============================================
' 기타 전역변수
'==============================================
Dim g_szGbn
g_szGbn = "" 

Dim g_szTitle
g_szTitle = "금액 입력"

Dim g_szCrcd_Sell
g_szCrcd_Sell = "KRW" 

Dim g_szCrcd_Buy
g_szCrcd_Buy = "USD" 

Dim g_szCrcd_Target
g_szCrcd_Target = "USD"

Dim g_nMin, g_nMax ,g_nPoint, g_nMin_Amt
g_nPoint = 2
g_nMin = 0
g_nMax = Clng(999999999999)
g_nMin_Amt = 0

' 계좌번호
Dim g_szAcno
g_szAcno = ""

Dim g_szAsno
g_szAsno = ""

' 계좌 비밀번호
Dim g_szPwd
g_szPwd = ""

Dim g_szSvcd
g_szSvcd = ""

' 최대환전 여부
Dim g_MaxMnecYN
g_MaxMnecYN = "N"

Dim g_nExRate_1
g_nExRate_1 = 0

Dim g_nExRate_2
g_nExRate_2 = 0

Dim g_szExRate_Time1
g_szExRate_Time1 = ""

Dim g_szExRate_Time2
g_szExRate_Time2 = ""

Dim g_szExRate_Spread1
g_szExRate_Spread1 = ""

Dim g_szExRate_Spread2
g_szExRate_Spread2 = ""

Dim g_szAbleAmtTxt
g_szAbleAmtTxt = ""

Dim g_nMaxAble
g_nMaxAble = 0

Dim g_nLimit
g_nLimit = 0
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************
'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	'-----------------------------------------------
	' 타이틀 초기화
	'-----------------------------------------------
	lblTitle.caption = g_szTitle
	lblTitle.paddinginfo = "0,0,0,0"
	
	'-----------------------------------------------
	' 매크로 버튼 초기화
	'-----------------------------------------------
	contMacro.btn0.fgcolor  = g_szTxtColor_Normal
	contMacro.btn1.fgcolor  = g_szTxtColor_Normal
	contMacro.btn2.fgcolor  = g_szTxtColor_Normal
	contMacro.btn3.fgcolor  = g_szTxtColor_Normal
	contMacro.btn4.fgcolor  = g_szTxtColor_Normal
	
	contMacro.lbl0.fgcolor  = g_szTxtColor_Normal
	contMacro.lbl0.paddinginfo  = "0,0,0,0"
	contMacro.lbl0.imagefilepth = "btn_02_n.9"
	
	contMacro.lbl1.fgcolor  = g_szTxtColor_Normal
	contMacro.lbl1.paddinginfo  = "0,0,0,0"
	contMacro.lbl1.imagefilepth = "btn_02_n.9"
	
	contMacro.lbl2.fgcolor  = g_szTxtColor_Normal
	contMacro.lbl2.paddinginfo  = "0,0,0,0"
	contMacro.lbl2.imagefilepth = "btn_02_n.9"
	
	contMacro.lbl3.fgcolor  = g_szTxtColor_Normal
	contMacro.lbl3.paddinginfo  = "0,0,0,0"
	contMacro.lbl3.imagefilepth = "btn_02_n.9"
	
	contMacro.lbl4.fgcolor  = g_szTxtColor_Normal
	contMacro.lbl4.paddinginfo  = "0,0,0,0"
	contMacro.lbl4.imagefilepth = "btn_02_n.9"
	
	'-----------------------------------------------
	' 텍스트 입력 초기화
	'-----------------------------------------------
	contInput.imgRemove.SetMaintainingRatio("3")
	contInput.imgRemove.imgpath = g_szRemoveImg
	contInput.imgRemove.visible = false
	
	contInput.lblInput.paddinginfo = "0,0,0,0"
	contInput.lblInput.fgcolor = g_szTxtColor_Grey2
	contInput.lblInput.maxlinecnt = "1"
	
	if g_szGbn == "2" then
		contInput.lblInput.caption = FormatNumber(g_nExRate_1,2) & "원 이하"
	elseif g_szGbn == "4" then
		contInput.lblInput.caption = FormatNumber(g_nExRate_1,2) & "원 이상"
	else
		contInput.lblInput.caption = "금액입력"
	end if
	
	
	contInput.lblInfo2.paddinginfo = "0,0,0,0"
	contInput.lblInfo2.fgcolor = g_szTxtColor_Red
	contInput.lblInfo2.maxlinecnt = "1"
	
	'-----------------------------------------------
	' 기타정보 표시 초기화
	'-----------------------------------------------
	'contInfo.lblBg.bgcolor = g_szContBgColor
	contInfo.lblBg.imagefilepth = "roundbox_4r_gray.9"
	
	contInfo.imgRe.maintainratio = "2" 
	contInfo.imgRe.imgpath = g_szRefreshImg
	
	contInfo.lblInfo0.paddinginfo = "0,0,0,0"
	contInfo.lblInfo0.fgcolor = g_szTxtColor_Grey
	contInfo.lblInfo0.maxlinecnt = "1"
	
	contInfo.lblInfo3.paddinginfo = "0,0,0,0"
	contInfo.lblInfo3.fgcolor = g_szTxtColor_Grey
	contInfo.lblInfo3.maxlinecnt = "1"
	
	contInfo.lblGuideLine.paddinginfo = "0,0,0,0"
	contInfo.lblGuideLine.fgcolor = g_szTxtColor_Grey
	contInfo.lblGuideLine.maxlinecnt = "1"
	
	contInfo.lblInfo1.paddinginfo = "0,0,0,0"
	contInfo.lblInfo1.fgcolor = g_szTxtColor_Normal
	contInfo.lblInfo1.maxlinecnt = "1"
	
	contInfo.lblCrcd00.paddinginfo = "0,0,0,0"
	contInfo.lblCrcd00.fgcolor = g_szTxtColor_Normal

	contInfo.imgFlag00.maintainratio = "3" 
	
	contInfo.imgToolTip.maintainratio = "1"
	contInfo.imgToolTip.imgpath = g_szToolTipImg
	
	contInfo.imgToolTip.ToolTipBringFront(true)
	DisplaySetting_Cont(g_szGbn)
End Function

Function DisplaySetting_Cont(szGbn)
	'환전키패드 타입
	'0:(환전신청) 매도금액입력
	'1:(환전신청) 매수금액입력
	'2:(목표환전) 환율입력
	'3:(목표환전) 매수금액입력
	
	if szGbn == "0" then
		contInfo.visible = true
		contInput.visible = true
		contMacro.visible = true
		
		if g_szCrcd_Sell == "KRW" or g_szCrcd_Sell == "JPY"  then
			btnDot.visible = false
		end if
		
		DisplaySetting_ContInfo(szGbn)
		
		Request_Tran_obrtd_fcur_001r()
		
	elseif szGbn == "1" then
		contInfo.visible = true
		contInput.visible = true
		contMacro.visible = true
		
		if  g_szCrcd_Buy == "KRW" or g_szCrcd_Buy == "JPY" then
			btnDot.visible = false
		end if
		
		DisplaySetting_ContInfo(szGbn)
		
		Request_Tran_obrtd_fcur_001r()
	
	elseif szGbn == "2" or szGbn == "4" then
		contInfo.visible = true
		contInput.visible = true
		contMacro.visible = false
		
		lblTitle.top = 241
		contInput.top = 400
		contInfo.top = 290
		imgBg.top = 218
		
		DisplaySetting_ContInfo(szGbn)
		
		Request_Tran_obtsd_fbnk_201r(g_szCrcd_Buy)
	
	elseif szGbn == "3" or szGbn == "5" then
		contInfo.visible = true
		contInput.visible = true
		contMacro.visible = true
		
		if g_szCrcd_Sell == "KRW" or g_szCrcd_Sell == "JPY" or g_szCrcd_Buy == "KRW" or g_szCrcd_Buy == "JPY" then
			btnDot.visible = false
		end if
		
		if g_szCrcd_Buy == "USD" then
			g_nMax = 400000
			g_nMaxAble = 400000
		elseif g_szCrcd_Buy == "JPY" then
			g_nMax = 15000000
			g_nMaxAble = 15000000
		elseif g_szCrcd_Buy == "CNY" then
			g_nMax = 1000000
			g_nMaxAble = 1000000
		elseif g_szCrcd_Buy == "HKD" then
			g_nMax = 1000000
			g_nMaxAble = 1000000
		end if
		
		DisplaySetting_ContInfo(szGbn)
	else
		'구분값 추가
	end if

End Function

Function DisplaySetting_ContInfo(szGbn)
	'환전키패드 타입
	'0:(환전신청) 매도금액입력
	'1:(환전신청) 매수금액입력
	'2:(목표환전) 환율입력
	'3:(목표환전) 매수금액입력
	
	if szGbn == "0" then
		contInfo.imgFlag00.visible = true
		contInfo.lblCrcd00.visible = true
		contInfo.imgRe.visible = true
		
		contInfo.lblInfo0.visible = true
		contInfo.lblInfo1.visible = false

		Select_Crcd(g_szCrcd_Sell)
		
		nTxtWidth = Form.getTextWidth(contInfo.lblCrcd00.caption, -2, true, false)
			
		contInfo.imgFlag00.left = (375 - nTxtWidth) / 2 - 25
		contInfo.imgRe.left = (375 + nTxtWidth) / 2 + 5

	elseif szGbn == "1" then
		contInfo.imgFlag00.visible = true
		contInfo.lblCrcd00.visible = true
		contInfo.imgRe.visible = true
		
		contInfo.lblInfo0.visible = true
		contInfo.lblInfo1.visible = false

		Select_Crcd(g_szCrcd_Buy)
		
		nTxtWidth = Form.getTextWidth(contInfo.lblCrcd00.caption, -2, true, false)
			
		contInfo.imgFlag00.left = (375 - nTxtWidth) / 2 - 25
		contInfo.imgRe.left = (375 + nTxtWidth) / 2 + 5
		
'		contInfo.imgFlag00.visible = false
'		contInfo.lblCrcd00.visible = false
'		contInfo.imgRe.visible = false
'		
'		contInfo.lblInfo0.visible = true
'		contInfo.lblInfo1.visible = true
'		
'		contInfo.lblInfo0.top = 9
'		
'		if g_szCrcd_Sell == "KRW" then 
'			contInfo.lblInfo1.caption = "예상환전금액 0원"
'		else
'			contInfo.lblInfo1.caption = "예상환전금액 0"&g_szCrcd_Sell
'		end if
'		
'		Select_Crcd(g_szCrcd_Buy)
	
	elseif szGbn == "2" or szGbn == "4"  then
		contInfo.imgFlag00.visible = true
		contInfo.lblCrcd00.visible = true
		contInfo.imgRe.visible = true
		
		contInfo.lblInfo0.visible = true
		contInfo.lblInfo1.visible = false
		
		contInfo.lblInfo0.top = 9
		contInfo.lblInfo0.left = 20
		contInfo.lblInfo0.width = 335
		contInfo.lblInfo0.halign = "1"
		contInfo.lblInfo0.caption = "환전하고 싶은 목표 환율을 입력해주세요"
		
		contInfo.lblCrcd00.top = 36
		contInfo.imgFlag00.top = 36 + 6
		contInfo.imgRe.top = 36 + 7
		
		nTxtWidth = Form.getTextWidth(contInfo.lblCrcd00.caption, -2, true, false)
			
		contInfo.imgFlag00.left = (375 - nTxtWidth) / 2 - 25
		contInfo.imgRe.left = (375 + nTxtWidth) / 2 + 5
		
		Select_Crcd(g_szCrcd_Buy)

	elseif szGbn == "3" or szGbn == "5"then
		contInfo.imgFlag00.visible = true
		contInfo.lblCrcd00.visible = true
		contInfo.imgRe.visible = false
		
		contInfo.lblInfo0.visible = true
		contInfo.lblInfo1.visible = false
		
		contInfo.lblInfo0.top = 9
		contInfo.lblInfo0.left = 20
		contInfo.lblInfo0.width = 335
		contInfo.lblInfo0.halign = "1"
		contInfo.lblInfo0.caption = "목표 환율 도달 시, 환전 할 금액을 입력해주세요"
		
		contInfo.lblCrcd00.top = 36
		contInfo.imgFlag00.top = 36 + 6
		contInfo.imgRe.top = 36 + 7
		
		Select_Crcd(g_szCrcd_Buy)
		
		contInfo.lblCrcd00.left = 70
		contInfo.lblCrcd00.width = 265
		contInfo.lblCrcd00.caption = "1회 환전 한도 " & FormatNumber(g_nMax, 0) & " " & g_szCrcd_Buy
	
		nTxtWidth = Form.getTextWidth(contInfo.lblCrcd00.caption, -2, true, false)
	
		contInfo.imgFlag00.left = (375 - nTxtWidth) / 2 - 8
'		contInfo.imgRe.left = (375 + nTxtWidth) / 2 + 5
		
		
	else
		'구분값 추가
	end if
End Function

'===============================================
' 통화코드 세팅 
'===============================================
Function Select_Crcd(szCrcd)
	szFlag = Form.getIconImg("CRCD", szCrcd)
	if szFlag = "" then
		szFlag = "flag_general"
	end if
	
	contInfo.imgFlag00.imgpath = szFlag
	contInfo.lblCrcd00.caption = szCrcd
	
	szData = ""
	select case szCrcd
		case "KRW"		
			contMacro.lbl0.caption = "1만원" 
			contMacro.lbl1.caption = "5만원" 
			contMacro.lbl2.caption = "10만원"
			contMacro.lbl3.caption = "100만원" 
		case "USD"		
			contMacro.lbl0.caption = "10$" 
			contMacro.lbl1.caption = "50$" 
			contMacro.lbl2.caption = "100$"
			contMacro.lbl3.caption = "1,000$" 
		case "HKD"		
			contMacro.lbl0.caption = "10$" 
			contMacro.lbl1.caption = "50$" 
			contMacro.lbl2.caption = "100$"
			contMacro.lbl3.caption = "1,000$"
		case "JPY"	
			contMacro.lbl0.caption = "1,000￥" 
			contMacro.lbl1.caption = "5,000￥"
			contMacro.lbl2.caption = "10,000￥"
			contMacro.lbl3.caption = "100,000￥"
		case "CNY"		
			contMacro.lbl0.caption = "10￥" 
			contMacro.lbl1.caption = "50￥"
			contMacro.lbl2.caption = "100￥"
			contMacro.lbl3.caption = "1,000￥"
		case "EUR"	
			contMacro.lbl0.caption = "10€" 
			contMacro.lbl1.caption = "50€" 
			contMacro.lbl2.caption = "100€"
			contMacro.lbl3.caption = "1,000€"
		case "GBP"		
			contMacro.lbl0.caption = "10￡" 
			contMacro.lbl1.caption = "50￡" 
			contMacro.lbl2.caption = "100￡"
			contMacro.lbl3.caption = "1,000￡"
		case "AUD"		
			contMacro.lbl0.caption = "10$" 
			contMacro.lbl1.caption = "50$" 
			contMacro.lbl2.caption = "100$"
			contMacro.lbl3.caption = "1,000$" 
		case "SGD"		
			contMacro.lbl0.caption = "10$" 
			contMacro.lbl1.caption = "50$" 
			contMacro.lbl2.caption = "100$"
			contMacro.lbl3.caption = "1,000$" 
		case "CAD"		
			contMacro.lbl0.caption = "10$" 
			contMacro.lbl1.caption = "50$" 
			contMacro.lbl2.caption = "100$"
			contMacro.lbl3.caption = "1,000$" 
		case "VND"		
			contMacro.lbl0.caption = "10만동" 
			contMacro.lbl1.caption = "50만동" 
			contMacro.lbl2.caption = "100만동"
			contMacro.lbl3.caption = "1천만동" 
		case "CHF"		
			contMacro.lbl0.caption = "10Fr" 
			contMacro.lbl1.caption = "50Fr" 
			contMacro.lbl2.caption = "100Fr"
			contMacro.lbl3.caption = "1,000Fr" 
	end select
	
	contMacro.lbl4.caption = "전액" 
End Function

'===============================================
' 통화코드 세팅 
'===============================================
Function Convert_MacroBtn(nIdx)
	
	szResult = Form.GetCtlProp("contMacro.lbl"&nIdx, "caption")
	
	szCrcd = ""
	if g_szGbn == "0" then
		szCrcd = g_szCrcd_Sell
	else
		szCrcd = g_szCrcd_Buy
	end if

	if szResult <> "전액" then
		select case szCrcd
			case "KRW"		
				szResult = replace(szResult, "만원", "")
				szResult = replace(szResult, ",", "")
				szResult = Cint(szResult) * 10000
			case "USD"		
				szResult = replace(szResult, "$", "")
				szResult = replace(szResult, ",", "")
			case "HKD"		
				szResult = replace(szResult, "$", "")
				szResult = replace(szResult, ",", "")
			case "JPY"	
				szResult = replace(szResult, "￥", "")
				szResult = replace(szResult, ",", "")
			case "CNY"		
				szResult = replace(szResult, "￥", "")
				szResult = replace(szResult, ",", "")
			case "EUR"	
				szResult = replace(szResult, "€", "")
				szResult = replace(szResult, ",", "")
			case "GBP"		
				szResult = replace(szResult, "￡", "")
				szResult = replace(szResult, ",", "")
			case "AUD"		
				szResult = replace(szResult, "$", "")
				szResult = replace(szResult, ",", "")
			case "SGD"		
				szResult = replace(szResult, "$", "")
				szResult = replace(szResult, ",", "")
			case "CAD"		
				szResult = replace(szResult, "$", "")
				szResult = replace(szResult, ",", "")
			case "VND"
				if szResult == "1천만동" then
					szResult = 10000000
				else
					szResult = replace(szResult, "만동", "")
					szResult = replace(szResult, ",", "")
					szResult = Cint(szResult) * 10000
				end if
			case "CHF"		
				szResult = replace(szResult, "Fr", "")
				szResult = replace(szResult, ",", "")
		end select
	else
		szResult = g_nMaxAble
	end if
	
	return Cstr(szResult)
End Function

'==============================================
' 환전가능금액 조회
'==============================================
Function Request_Tran_obrtd_fcur_001r()
	g_szAbleAmtTxt = ""
	contInfo.imgToolTip.visible = false
	
	DATAMANAGER.ClearInputData(false, "obrtd_fcur_001r")
	
	DATAMANAGER.SetDataValue(false, "obrtd_fcur_001r", "InBlock1", "ACNO" , 0 , g_szAcno)
	DATAMANAGER.SetDataValue(false, "obrtd_fcur_001r", "InBlock1", "ASNO" , 0 , g_szAsno)
	DATAMANAGER.SetDataValue(false, "obrtd_fcur_001r", "InBlock1", "SVCD" , 0 , "001")
	DATAMANAGER.SetDataValue(false, "obrtd_fcur_001r", "InBlock1", "ACNT_PWD" , 0 , g_szPwd)
	
	DATAMANAGER.RequestTranData("obrtd_fcur_001r")
End Function

'==============================================
' 환전가능금액 조회 처리
'==============================================
Function Process_Tran_obrtd_fcur_001r()
	nDataCnt = DATAMANAGER.GetDataCount(false, "obrtd_fcur_001r", "OutBlock1")
	
	'최대환전 여부
	g_MaxMnecYN = DATAMANAGER.GetDataValue(false, "obrtd_fcur_001r" , "OutBlock3" , "MAX_MNEC_YN" , 0) 
	
	nMaxAbleAmt = 0
	nAbleAmt = 0
	for i = 0 to nDataCnt-1 
		szCrcd         = DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "CRCD", i )
		szAbleAmt    = DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "ATMT_INVT_VLTN_ADUP_FRCR_AMT", i ) 
		szMaxAbleAmt    = DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "UI_MAX_MNEC_ABLE_FRCR_AMT", i )
		
		nMaxAbleAmt	= Cdbl(szMaxAbleAmt)
		nAbleAmt = Cdbl(szAbleAmt)
		if g_szCrcd_Sell == szCrcd then	
'			if g_szGbn == "1" then
'				if g_szCrcd_Sell == "KRW" then 
'					'매수 통화가 원화인 경우
'					if g_nExRate_1 <> 0 then
'						if g_szCrcd_Buy == "JPY" then
'							nMaxAbleAmt = truncateToDecimalPlaces((nMaxAbleAmt/g_nExRate_1), 0)
'						else
'							nMaxAbleAmt = truncateToDecimalPlaces((nMaxAbleAmt/g_nExRate_1), 2)
'						end if
'					end if
'					
'				elseif g_szCrcd_Buy == "KRW" then 
'					'매도 통화가 원화인 경우
'					if g_nExRate_1 <> 0 then
'						nMaxAbleAmt = truncateToDecimalPlaces((nMaxAbleAmt*g_nExRate_1), 0)
'					end if
'				else
'					'매수/매도 통화에 원화가 없는 경우
'					if g_nExRate_1 <> 0 and g_nExRate_2 <> 0 then
'						'외화 -> 원화 환산
'				
'						nResult = truncateToDecimalPlaces((nMaxAbleAmt*g_nExRate_1), 0)
'						'원화 -> 외화 환산
'						if g_szCrcd_Buy == "JPY" then
'							nMaxAbleAmt = truncateToDecimalPlaces((nResult/g_nExRate_2), 0)
'						else
'							nMaxAbleAmt = truncateToDecimalPlaces((nResult/g_nExRate_2), 2)
'						end if
'					
'					end if
'				end if
'			end if
			
			'입력가능 12자리 체크
			
			if cdbl(szMaxAbleAmt) > 999999999999 then
				g_nMax = 999999999999
			else
				g_nMax = nMaxAbleAmt
			end if
			
			if g_szGbn == "0" then
				if szCrcd = "KRW" or szCrcd = "JPY" then
					if g_MaxMnecYN == "Y" then
'						nWidthTotal = Form.getTextWidth("환전가능 " & FormatNumber(szAbleAmt, 0) & "  |  " & "최대가능       " & FormatNumber(szMaxAbleAmt, 0), -4, false, false)
'						nWidth = Form.getTextWidth("환전가능 " & FormatNumber(szAbleAmt, 0) & "  |  " & "최대가능", -4, false, false)
'						
'						nleft = Cint((295 - nWidthTotal) / 2)
'						contInfo.imgToolTip.left = 40 + nleft + nWidth
						contInfo.imgToolTip.visible = true
						contInfo.lblInfo3.visible = true
						contInfo.lblGuideLine.visible = true
						
						contInfo.lblInfo0.caption = "환전가능 " & FormatNumber(szAbleAmt, 0) 
						contInfo.lblInfo3.caption = "최대가능 " & FormatNumber(szMaxAbleAmt, 0)
						
					else
						contInfo.lblInfo0.left = 20
						contInfo.lblInfo0.width = 335
						contInfo.lblInfo0.halign = "1"
						
						szAccType = Form.GetSharedData("65000_ACC_TYPE", false )
						if szAccType == "137" then
							contInfo.lblInfo0.caption = "최대가능 " & FormatNumber(szAbleAmt, 0) 
						else
							contInfo.lblInfo0.caption = "환전가능 " & FormatNumber(szAbleAmt, 0) 
						end if
					end if
				else
					if g_MaxMnecYN == "Y" then
'						nWidthTotal = Form.getTextWidth("환전가능 " & FormatNumber(szAbleAmt, 2) & "  |  " & "최대가능       " & FormatNumber(szMaxAbleAmt, 2), -4, false, false)
'						nWidth = Form.getTextWidth("환전가능 " & FormatNumber(szAbleAmt, 2) & "  |  " & "최대가능", -4, false, false)
'						
'						nleft = Cint((295 - nWidthTotal) / 2)
'						contInfo.imgToolTip.left = 40 + nleft + nWidth
'						contInfo.imgToolTip.visible = true
'						contInfo.lblInfo0.caption = "환전가능 " & FormatNumber(szAbleAmt, 2) & "  |  " & "최대가능       " & FormatNumber(szMaxAbleAmt, 2)

						contInfo.imgToolTip.visible = true
						contInfo.lblInfo3.visible = true
						contInfo.lblGuideLine.visible = true
						
						contInfo.lblInfo0.caption = "환전가능 " & FormatNumber(szAbleAmt, 2) 
						contInfo.lblInfo3.caption = "최대가능 " & FormatNumber(szMaxAbleAmt, 2)
					else
						contInfo.lblInfo0.left = 20
						contInfo.lblInfo0.width = 335
						contInfo.lblInfo0.halign = "1"
						
						szAccType = Form.GetSharedData("65000_ACC_TYPE", false )
						if szAccType == "137" then
							contInfo.lblInfo0.caption = "최대가능 " & FormatNumber(szAbleAmt, 2) 
						else
							contInfo.lblInfo0.caption = "환전가능 " & FormatNumber(szAbleAmt, 2) 
						end if
					end if
				end if 
			end if
			
			if g_MaxMnecYN == "Y" then
				g_nMax = nMaxAbleAmt
			else
				g_nMax = nAbleAmt
				
			end if
			
			g_nMaxAble = nAbleAmt

'			nTxtWidth = Form.getTextWidth(contInfo.lblInfo0.caption, -4, false, false)
			
			'(환전신청) 매수금액입력 시, 환전가능 금액 조회 완료 후 새로고침 버튼 위치 지정
'			if g_szGbn == "1" then
'				contInfo.imgRe.visible = true
'				contInfo.imgRe.left = (375 + nTxtWidth) / 2 + 5
'			end if
			
			Exit For
		end if
	next
	
	'매도금액입력 
	if g_szGbn == "0" then
		'최소입력가능 금액 가계산 확인
		szClsCd = ""
		szOrdGbn = ""
		szAmtGbn = ""
		szAmt = ""
		
		'일반
		if g_szCrcd_Sell == "KRW" or  g_szCrcd_Buy == "KRW" then 
			szClsCd = "1"
			'지금 입력받는 금액이 원화
			'상대통화 최소금액을 환전할때 입력할 수 있는 최소 원화 금액 구하기 
			'외화 입력 후 원화 
			if g_szCrcd_Sell == "KRW" then
				szOrdGbn = "1"
				szAmtGbn = "1"
				
				if g_szCrcd_Buy == "JPY" then
					szAmt = "1"
				else
					szAmt = "0.01"
				end if
				
			'지금 입력받는 금액이 외화
			elseif g_szCrcd_Buy == "KRW" then
				szOrdGbn = "2"
				szAmtGbn = "2"
				
				if g_szCrcd_Sell == "JPY" then
					szAmt = "1"
				else
					Exit Function
				end if
			end if
			
		'이종통화
		else
			szClsCd = "2"
			szOrdGbn = "1"
			szAmtGbn = "1"
			
			if g_szCrcd_Buy == "JPY" then
				szAmt = "1"
			else
				szAmt = "0.01"
			end if
		end if
		
		Request_Tran_obtsd_fbnk_008r_2(szClsCd, szOrdGbn, szAmtGbn, szAmt)	
			
	'매수금액입력
	elseif g_szGbn == "1" then
		'매도통화 환전가능금액 구한 후, 매수통화 기준으로 금액환산 필요하여 가계산 처리 함
		szClsCd = ""
		szOrdGbn = ""
		szAmtGbn = ""
		szAmt = nMaxAbleAmt
		
		'일반
		if g_szCrcd_Sell == "KRW" or  g_szCrcd_Buy == "KRW" then 
			szClsCd = "1"
			
			'지금 입력받는 금액이 원화
			'상대통화 최소금액을 환전할때 입력할 수 있는 최소 원화 금액 구하기 
			'외화 입력 후 원화 
			if g_szCrcd_Sell == "KRW" then
				szOrdGbn = "1"
				szAmtGbn = "2"
				
			'지금 입력받는 금액이 외화
			elseif g_szCrcd_Buy == "KRW" then
				szOrdGbn = "2"
				szAmtGbn = "1"
				
			end if
			
		'이종통화
		else
			szClsCd = "2"
			szOrdGbn = "2"
			szAmtGbn = "1"
			
		end if
			
		Request_Tran_obtsd_fbnk_008r(szClsCd, szOrdGbn, szAmtGbn, nAbleAmt)	
		
		if g_MaxMnecYN == "Y" then
			Request_Tran_obtsd_fbnk_008r_1(szClsCd, szOrdGbn, szAmtGbn, nMaxAbleAmt)	
		end if
		
		'최소입력가능 금액 가계산 확인
		szClsCd = ""
		szOrdGbn = ""
		szAmtGbn = ""
		szAmt = ""
		
		'일반
		if g_szCrcd_Sell == "KRW" or  g_szCrcd_Buy == "KRW" then 
			szClsCd = "1"
			'지금 입력받는 금액이 원화
			'상대통화 최소금액을 환전할때 입력할 수 있는 최소 원화 금액 구하기 
			'외화 입력 후 원화 
			if g_szCrcd_Buy == "KRW" then
				szOrdGbn = "2"
				szAmtGbn = "1"
				
				if g_szCrcd_Sell == "JPY" then
					szAmt = "1"
				else
					szAmt = "0.01"
				end if
				
			'지금 입력받는 금액이 외화
			elseif g_szCrcd_Sell == "KRW" then
				szOrdGbn = "1"
				szAmtGbn = "2"
				
				if g_szCrcd_Buy == "JPY" then
					szAmt = "1"
				else
					Exit Function
				end if
				
			end if
			
		'이종통화
		else
			szClsCd = "2"
			szOrdGbn = "2"
			szAmtGbn = "1"
			
			if g_szCrcd_Sell == "JPY" then
				szAmt = "1"
			else
				szAmt = "0.01"
			end if
		end if
		
		Request_Tran_obtsd_fbnk_008r_2(szClsCd, szOrdGbn, szAmtGbn, szAmt)	
			
	end if
End Function

'==============================================
' 환전가능금액 조회 처리
'==============================================
Function Process_Tran_obtsd_fbnk_201r()
	szApBy 	= DATAMANAGER.GetDataValue(false, "obtsd_fbnk_201r", "OutBlock1", "TLTR_BYRT" , 0)
	szApSl 	= DATAMANAGER.GetDataValue(false, "obtsd_fbnk_201r", "OutBlock1", "TLTR_SLRT", 0)
	szAptm 	= DATAMANAGER.GetDataValue(false, "obtsd_fbnk_201r", "OutBlock1", "EXRT_STND_TIME" , 0)
	szDcrt 	= DATAMANAGER.GetDataValue(false, "obtsd_fbnk_201r", "OutBlock1", "DCRT", 0)
	szSpread = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_201r", "OutBlock1", "SPEAD", 0)
	szBasicSpread = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_201r", "OutBlock1", "BASC_SPEAD", 0)
	
	g_szExRate_Time2 = szAptm
	
	if g_szOrderType == "Sell" then
		g_nExRate_1 =  Cdbl(szApSl) - Cdbl(szBasicSpread)
	elseif g_szOrderType == "Buy" then
		g_nExRate_1 = Cdbl(szApBy) + Cdbl(szBasicSpread)
	end if
	
	g_nMax = g_nExRate_1
	contInfo.lblCrcd00.caption = "최근환율 "& FormatNumber(g_nExRate_1,2)
	
	nTxtWidth = Form.getTextWidth(contInfo.lblCrcd00.caption, -2, true, false)
			
	contInfo.imgFlag00.left = (375 - nTxtWidth) / 2 - 25
	contInfo.imgRe.left = (375 + nTxtWidth) / 2 + 5
End Function

Function Request_Tran_obtsd_fbnk_201r(szCrcd)	
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_201r")
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_201r" , "InBlock1" , "ACNO" , 0 , g_szAcno)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_201r" , "InBlock1" , "ASNO" , 0 , g_szAsno)
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_201r" , "InBlock1" , "CRCD" , 0 , szCrcd )
	
	szSvcd = g_szSvcd
	if szSvcd <> "001" then
		szSvcd = "003"
	end if
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_201r" , "InBlock1" , "SVCD" , 0 , szSvcd)
	
	szMnecClcd = "1"
	if g_szGbn == "2" then
		szMnecClcd = "1"
	elseif g_szGbn == "4" then
		szMnecClcd = "2" 
	end if
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_201r" , "InBlock1" , "MNEC_CLCD" , 0 , szMnecClcd)
	
	DATAMANAGER.RequestTranData("obtsd_fbnk_201r")
End Function

'==============================================
' 환전금액 가계산
'==============================================
'입력 최대가능금액 조회
Function Request_Tran_obtsd_fbnk_008r(szClsCd, szOrdGbn, szAmtGbn, szAmt)	
'	g_szClsCd_008r	= szClsCd
'	g_szOrdGbn_008r	= szOrdGbn
'	g_szAmtGbn_008r	= szAmtGbn
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_008r")
	
	'조회구분코드 (1:일반, 2:이종통화)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "IQRY_CLS_CODE"		, 0 , szClsCd)
	
	'매수/매도 통화코드
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "BYOV_CRCD"			, 0 , g_szCrcd_Buy)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "SELN_CRCD"			, 0 , g_szCrcd_Sell)
	
	'기관코드(287 고정)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "TACT_LNKD_ISTU_CODE"	, 0 , "287")
	
	'거래금액구분코드(1:외화, 2:원화)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "TR_AMT_CLCD"			, 0 , szAmtGbn)
	
	'서비스코드(001:실시간 002:시간외)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "SVCD"				, 0 , g_szSvcd)
	
	'일반
	if szClsCd == "1" then
		'매수/매도 구분
		if szOrdGbn == "1" then
			if szAmtGbn == "2" then
				'원화거래금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "WNCR_TR_AMT"			, 0 , szAmt)
			elseif szAmtGbn == "1" then
				'외화매수금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "FRCR_BYOV_AMT"		, 0 , szAmt)
			end if
			
			'환전매수환율
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_BYOV_EXRT"		, 0 , g_nExRate_1)
			'환전매수스프레드
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_BYOV_SPEAD"		, 0 , g_szExRate_Spread1)
		elseif szOrdGbn == "2" then
		
			if szAmtGbn == "2" then
				'원화거래금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "WNCR_TR_AMT"			, 0 , szAmt)
			elseif szAmtGbn == "1" then
				'외화매도금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "FRCR_SELN_AMT"		, 0 , szAmt)
			end if
			
			'환전매도환율
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_SELN_EXRT"		, 0 , g_nExRate_1)
			'환전매도스프레드
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_SELN_SPEAD"		, 0 , g_szExRate_Spread1)
		end if
	
	'이종통화
	elseif szClsCd == "2" or szClsCd == "3" then
		'매수/매도 구분
		if szOrdGbn == "1" then
			'외화매수금액
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "FRCR_BYOV_AMT"		, 0 , szAmt)
		elseif szOrdGbn == "2" then
			'외화매도금액
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "FRCR_SELN_AMT"		, 0 , szAmt)
		end if
		
		'환전매도환율
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_SELN_EXRT"		, 0 , g_nExRate_1)
		'환전매도스프레드
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_SELN_SPEAD"		, 0 , g_szExRate_Spread1)
		
		'환전매수환율
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_BYOV_EXRT"		, 0 , g_nExRate_2)
		'환전매수스프레드
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_BYOV_SPEAD"		, 0 , g_szExRate_Spread2)
	end if
	
	'환율기준시각
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "EXRT_STND_TIME"		, 0 , g_szExRate_Time1)
	
	'---------------------------------------------------
	'환전구분코드(1:매수, 2:매도)
	'환전구분코드는 거래 간 원화 포함시 영향있음
	'1. 원화 -> 외화 (매수)
	'2. 외화 -> 원화 (매도)
	'3. 외화 -> 외화의 경우 이종통화 처리로 서비스 내부적으로 매수/매도 처리 알아서 처리함
	'---------------------------------------------------
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_CLCD"			, 0 , szOrdGbn)

	DATAMANAGER.RequestTranData("obtsd_fbnk_008r")
End Function

