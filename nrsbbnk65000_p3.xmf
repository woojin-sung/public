	szWonAmt = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_008r", "OutBlock1", "WNCR_TR_AMT", 0)
	szForSelAmt = DATAMANAGER.GetDataValue(false,"obtsd_fbnk_008r", "OutBlock1", "FRCR_SELN_AMT" , 0)
	szForBuyAmt = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_008r", "OutBlock1", "FRCR_BYOV_AMT", 0)
	
	'매수금액입력 시, 환전가능금액 환산한 값 사용
