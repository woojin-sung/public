'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	Dim szLinkData
	szLinkData = ""
	szLinkData = Form.GetOpenLinkData()

	szArrData = split(szLinkData, "`") 
	
	'환전키패드 타입
	'0:(환전신청) 매도금액입력
	'1:(환전신청) 매수금액입력
	'2:(목표환전) 환율입력
	'3:(목표환전) 매수금액입력
	
	if #szArrData > 0 then
		g_szGbn = szArrData(0)
		
		if g_szGbn == "0" then
			g_szTitle = "매도 금액 입력"
			'Request_Tran_obrtp_comn_035r(szArrData(1))
		elseif g_szGbn == "1" then
			g_szTitle = "매수 금액 입력"
			'Request_Tran_obrtp_comn_035r(szArrData(2))
		elseif g_szGbn == "2" then
			g_szTitle = "목표 환율 입력"
		elseif g_szGbn == "3" then
			g_szTitle = "매수 금액 입력"
		elseif g_szGbn == "4" then
			g_szTitle = "목표 환율 입력"	
		elseif g_szGbn == "5" then
			g_szTitle = "매도 금액 입력"
		end if
	else
		Exit Sub
	end if
	
	if #szArrData < 10 then
		Exit Sub
	end if
	
	'매도통화코드
	g_szCrcd_Sell	= szArrData(1)
	'매수통화코드
	g_szCrcd_Buy	= szArrData(2)
	
	if g_szGbn == "0" then
		Request_Tran_obrtp_comn_035r(szArrData(1))
	elseif g_szGbn == "1" then
		Request_Tran_obrtp_comn_035r(szArrData(2))
	end if
	
	
	'소숫점 자릿수
	g_nPoint 	= Cint(szArrData(3))
	
	g_szSvcd		= szArrData(4)
	
	'환율
	if szArrData(5) <> "" then
		arrExrt = split(szArrData(5), "★")
		g_nExRate_1 = cdbl(arrExrt(0))
		g_szExRate_Time1 = arrExrt(1)
		g_szExRate_Spread1 = arrExrt(2)
	end if
	
	'환율(이종통화 전용)
	if szArrData(6) <> "" then
		arrExrt = split(szArrData(6), "★")
		g_nExRate_2 = cdbl(arrExrt(0))
		g_szExRate_Time2 = arrExrt(1)
		g_szExRate_Spread2 = arrExrt(2)
	end if
	
	'계좌번호
	g_szAcno = szArrData(8)
	g_szAsno = szArrData(9)
	'계좌 비밀번호
	g_szPwd  = szArrData(10)
	
	Init_Control()
	
	'초기값
	if szArrData(7) <> "" then
		szAmt =replace(szArrData(7), ",", "")
		lblTempInput.caption = cdbl(szAmt)
		Input_Btn("")
	end if
End Sub

