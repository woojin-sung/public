				szAbleAmtTxt = "최대가능 " & Convert_FormatNumber(g_szCrcd_Buy, szForBuyAmt)
			else
				szAbleAmtTxt = "환전가능 " & Convert_FormatNumber(g_szCrcd_Buy, szForBuyAmt)
			end if
		end if
		
		if g_MaxMnecYN == "N" then	
			contInfo.lblInfo0.left = 20
			contInfo.lblInfo0.width = 335
			contInfo.lblInfo0.halign = "1"
		end if
		
		contInfo.lblInfo0.caption = szAbleAmtTxt
'	else
'				
'		if g_szCrcd_Buy == "KRW" then
'			g_szAbleAmtTxt = "환전가능 " & Convert_FormatNumber(g_szCrcd_Buy, szWonAmt) & g_szAbleAmtTxt
'			
'			nWidthTotal = Form.getTextWidth(g_szAbleAmtTxt, -4, false, false)
'			nWidth = Form.getTextWidth("환전가능 " & Convert_FormatNumber(g_szCrcd_Buy, szWonAmt) & "  |  " & "최대가능", -4, false, false)
'			
'			nleft = Cint((295 - nWidthTotal) / 2)
'			contInfo.imgToolTip.left = 40 + nleft + nWidth
'			contInfo.imgToolTip.visible = true
'		
'		else
'			g_szAbleAmtTxt = "환전가능 " & Convert_FormatNumber(g_szCrcd_Buy, szForBuyAmt) & g_szAbleAmtTxt
'			
'			nWidthTotal = Form.getTextWidth(g_szAbleAmtTxt, -4, false, false)
'			nWidth = Form.getTextWidth("환전가능 " & Convert_FormatNumber(g_szCrcd_Buy, szForBuyAmt) & "  |  " & "최대가능", -4, false, false)
'			
'			nleft = Cint((295 - nWidthTotal) / 2)
'			contInfo.imgToolTip.left = 40 + nleft + nWidth
'			contInfo.imgToolTip.visible = true
'		end if
'		contInfo.imgToolTip.visible = true
'		contInfo.lblInfo0.caption = g_szAbleAmtTxt
'	end if
	
	if g_MaxMnecYN == "N" then
		if g_szCrcd_Buy == "KRW" then
			g_nMax = cdbl(szWonAmt)
		else
			g_nMax = cdbl(szForBuyAmt)
		end if
	end if

	
End Function

Function Request_Tran_obtsd_fbnk_008r_1(szClsCd, szOrdGbn, szAmtGbn, szAmt)	
'	g_szClsCd_008r	= szClsCd
'	g_szOrdGbn_008r	= szOrdGbn
'	g_szAmtGbn_008r	= szAmtGbn
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_008r_1")
	
	'조회구분코드 (1:일반, 2:이종통화)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "IQRY_CLS_CODE"		, 0 , szClsCd)
	
	'매수/매도 통화코드
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "BYOV_CRCD"			, 0 , g_szCrcd_Buy)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "SELN_CRCD"			, 0 , g_szCrcd_Sell)
	
	'기관코드(287 고정)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "TACT_LNKD_ISTU_CODE"	, 0 , "287")
	
	'거래금액구분코드(1:외화, 2:원화)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "TR_AMT_CLCD"			, 0 , szAmtGbn)
	
	'서비스코드(001:실시간 002:시간외)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "SVCD"				, 0 , g_szSvcd)
	
	'일반
	if szClsCd == "1" then
		'매수/매도 구분
		if szOrdGbn == "1" then
			if szAmtGbn == "2" then
				'원화거래금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "WNCR_TR_AMT"			, 0 , szAmt)
			elseif szAmtGbn == "1" then
				'외화매수금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "FRCR_BYOV_AMT"		, 0 , szAmt)
			end if
			
			'환전매수환율
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "MNEC_BYOV_EXRT"		, 0 , g_nExRate_1)
			'환전매수스프레드
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "MNEC_BYOV_SPEAD"		, 0 , g_szExRate_Spread1)
		elseif szOrdGbn == "2" then
		
			if szAmtGbn == "2" then
				'원화거래금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "WNCR_TR_AMT"			, 0 , szAmt)
			elseif szAmtGbn == "1" then
				'외화매도금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "FRCR_SELN_AMT"		, 0 , szAmt)
			end if
			
			'환전매도환율
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "MNEC_SELN_EXRT"		, 0 , g_nExRate_1)
			'환전매도스프레드
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "MNEC_SELN_SPEAD"		, 0 , g_szExRate_Spread1)
		end if
	
	'이종통화
	elseif szClsCd == "2" or szClsCd == "3" then
		'매수/매도 구분
		if szOrdGbn == "1" then
			'외화매수금액
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "FRCR_BYOV_AMT"		, 0 , szAmt)
		elseif szOrdGbn == "2" then
			'외화매도금액
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "FRCR_SELN_AMT"		, 0 , szAmt)
		end if
		
		'환전매도환율
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "MNEC_SELN_EXRT"		, 0 , g_nExRate_1)
		'환전매도스프레드
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "MNEC_SELN_SPEAD"		, 0 , g_szExRate_Spread1)
		
		'환전매수환율
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "MNEC_BYOV_EXRT"		, 0 , g_nExRate_2)
		'환전매수스프레드
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "MNEC_BYOV_SPEAD"		, 0 , g_szExRate_Spread2)
	end if
	
	'환율기준시각
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "EXRT_STND_TIME"		, 0 , g_szExRate_Time1)
	
	'---------------------------------------------------
	'환전구분코드(1:매수, 2:매도)
	'환전구분코드는 거래 간 원화 포함시 영향있음
	'1. 원화 -> 외화 (매수)
	'2. 외화 -> 원화 (매도)
	'3. 외화 -> 외화의 경우 이종통화 처리로 서비스 내부적으로 매수/매도 처리 알아서 처리함
	'---------------------------------------------------
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_1", "InBlock1", "MNEC_CLCD"			, 0 , szOrdGbn)

	DATAMANAGER.RequestTranData("obtsd_fbnk_008r_1")
End Function

