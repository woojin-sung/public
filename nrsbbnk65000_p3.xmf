			'환전매수환율
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_2", "InBlock1", "MNEC_BYOV_EXRT"		, 0 , g_nExRate_1)
			'환전매수스프레드
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_2", "InBlock1", "MNEC_BYOV_SPEAD"		, 0 , g_szExRate_Spread1)
		elseif szOrdGbn == "2" then
			if szAmtGbn == "2" then
				'원화거래금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_2", "InBlock1", "WNCR_TR_AMT"		, 0 , szAmt)
			elseif szAmtGbn == "1" then
				'외화매도금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_2", "InBlock1", "FRCR_SELN_AMT"		, 0 , szAmt)
			end if
			
			'환전매도환율
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_2", "InBlock1", "MNEC_SELN_EXRT"		, 0 , g_nExRate_1)
			'환전매도스프레드
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_2", "InBlock1", "MNEC_SELN_SPEAD"		, 0 , g_szExRate_Spread1)
		end if
	
	'이종통화
	elseif szClsCd == "2" or szClsCd == "3" then
		'매수/매도 구분
		if szOrdGbn == "1" then
			'외화매수금액
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_2", "InBlock1", "FRCR_BYOV_AMT"		, 0 , szAmt)
