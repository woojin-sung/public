	if szClsCd == "1" then
		'매수/매도 구분
		if szOrdGbn == "1" then
			if szAmtGbn == "2" then
				'원화거래금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r_2", "InBlock1", "WNCR_TR_AMT"			, 0 , szAmt)
