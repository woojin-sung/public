	<SCRIPT_INFO _len="4811" _ulen="4697" >
Dim gImageBG()
gImageBG = {"ImageBg0","ImageBg1"}

'============================================================================
Sub Form_OnFormInitBefore()

	LabelTitle0.paddinginfo = "0,0,0,0"
	LabelTitle1.paddinginfo = "0,0,0,0"
	
	LabelData0.paddinginfo = "0,0,0,0"
	LabelData1.paddinginfo = "0,0,0,0"
	
	LabelSign0.paddinginfo = "0,0,0,0"
	LabelSign1.paddinginfo = "0,0,0,0"
	
	LabelDebi0.paddinginfo = "0,0,0,0"
	LabelDebi1.paddinginfo = "0,0,0,0"
	
	LabelRate0.paddinginfo = "0,0,0,0"
	LabelRate1.paddinginfo = "0,0,0,0"
	
	lblTime0.paddinginfo = "0,0,0,0"
	lblTime1.paddinginfo = "0,0,0,0"
	
	imgReal0.setMaintainingRatio("1")
	imgReal1.setMaintainingRatio("1")
	
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	RequestData()
	RequestChartData()
	
End Sub
'============================================================================
Function RequestData()

	DATAMANAGER.ClearInputData(0, "ohhts_1500_001r")
	
	'---------------------
	' 유로스톡스
	'---------------------
	DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "N")
	DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , "STX@SX5E")
	
	'---------------------
	' 러시아
	'---------------------
	DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 1 , "N")
	DATAMANAGER.SetDataValue(0, "ohhts_1500_001r", "InBlock1", "FID_INPUT_ISCD" 				, 1 , "RUI@RTSI")
	
	'---------------------
	' 서비스 호출
	'---------------------
	DATAMANAGER.RequestTranData("ohhts_1500_001r")

End Function
'============================================================================
Function RequestChartData()

	

End Function
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "ohhts_1500_001r" then
		
		'---------------------
		' 유로스톡스
		'---------------------
		sData0 = DATAMANAGER.GetDataValue(0, "ohhts_1500_001r", "OutBlock1", "FID_CNCN_PRPR" , 0)
		sSign0 = DATAMANAGER.GetDataValue(0, "ohhts_1500_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" , 0)
		sDebi0 = DATAMANAGER.GetDataValue(0, "ohhts_1500_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS" , 0)
		sRate0 = DATAMANAGER.GetDataValue(0, "ohhts_1500_001r", "OutBlock1", "FID_CNCN_PRDY_CTRT" , 0)
		
		LabelData0.caption = sData0
		LabelSign0.caption = sSign0
		LabelDebi0.caption = sDebi0
		LabelRate0.caption = sRate0
		
		'------------------------------------------------------------
		'현재가 글자색상 설정
		'------------------------------------------------------------
		if sSign0 == "1" or sSign0 == "2" then
			LabelData0.fgcolor = 10
		elseif sSign0 == "4" or sSign0 == "5" then
			LabelData0.fgcolor = 11
		else
			LabelData0.fgcolor = 12
		end if
		
		'---------------------
		' 러시아
		'---------------------
		sData1 = DATAMANAGER.GetDataValue(0, "ohhts_1500_001r", "OutBlock1", "FID_CNCN_PRPR" , 1)
		sSign1 = DATAMANAGER.GetDataValue(0, "ohhts_1500_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN" , 1)
		sDebi1 = DATAMANAGER.GetDataValue(0, "ohhts_1500_001r", "OutBlock1", "FID_CNCN_PRDY_VRSS" , 1)
		sRate1 = DATAMANAGER.GetDataValue(0, "ohhts_1500_001r", "OutBlock1", "FID_CNCN_PRDY_CTRT" , 1)
		
		LabelData1.caption = sData1
		LabelSign1.caption = sSign1
		LabelDebi1.caption = sDebi1
		LabelRate1.caption = sRate1
		
		'------------------------------------------------------------
		'현재가 글자색상 설정
		'------------------------------------------------------------
		if sSign1 == "1" or sSign1 == "2" then
			LabelData1.fgcolor = 10
		elseif sSign1 == "4" or sSign1 == "5" then
			LabelData1.fgcolor = 11
		else
			LabelData1.fgcolor = 12
		end if
		
	
	end if
	
End Sub

'============================================================================
Sub ImageBg0_OnClick()
	ClickButton(4,false)
End Sub
'============================================================================
Sub ImageBg1_OnClick()
	ClickButton(5,false)
End Sub
'============================================================================
Function ClickButton(nIndx,bSlient)

	'배경이미지 변경
	for i = 0 to #gImageBG - 1
		
		if i == nIndx - 4 then
			Form.SetCtlProp(gImageBG[i], "imgpath", "btn_line2_o.9")
			
		else
			Form.SetCtlProp(gImageBG[i], "imgpath", "btn_line2_n.9")
		end if
		
	next
	
	'선택지수 부모화면에 전달
	if bSlient <> true then
		Form.triggerEvent("#", "SELECT_JISU", "EURO@"..nIndx)
	end if

End Function

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "SELECT_INDEX" then
		ClickButton(Cint(sParam),true)
	end if
	
End Sub

