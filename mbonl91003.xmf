'			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "BNFT_OFER_TYPE", 		0 , Grid0.GetCellData("bd_cell22", i))
'			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "BNFT_OFER_CNTT", 		0 , Grid0.GetCellData("bd_cell13", i))
'			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "BNFT_OFER_AMT",  		0 , Grid0.GetCellData("bd_cell14", i))
