	<SCRIPT_INFO _len="21507" _ulen="20957" >
'============================================================================
' 01.화면명 	: 청탁금지 제공누적금액 현황
' 02.화면설명	: 청탁금지 제공누적금액 현황 화면
' 03.작성	: 2016.09.26
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_szId		'사용자 ID
dim g_szEmpl_no	'직원번호
dim nRow			'반복
dim nClick		'전체 선택 FLAG
dim g_szType		'
dim g_szYN		'
dim nRound		'요청할 개수
dim nReq			'요청완료 개수
dim nTempCnt		'임시값

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	
	g_szId = Form.GetSharedData("&USER_ID", false)
	g_szEmpl_no = Form.GetSharedData("&EMPL_NO", false )
	'Form.ShowAlert(g_szEmpl_no)
	'g_szEmpl_no = "5942"
	
	
	nClick = 0		'초기화
	nRow = 0
	nRound = 0
	nReq = 0
	nTempCnt = 0
	
End Sub



'============================================================================
Sub Button0_OnClick()
'검색 일자 Check
	if Calendar0.caption > Calendar1.caption then	
		Form.ShowAlert("알림", "시작일자가 종료일자보다 큽니다")
		exit sub
	end if
	
	Grid0.SetClear()
	
	nRow = 0
	
'데이터 조회
	DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "BNFT_OFER_INPUT_BRCD", 0 , "%")
	DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "TR_CNRP_NAME", 0 , "%")
	DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "ACNO", 0 , "%")
	DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "TR_CNRP_TELNO", 0 , "%")
	DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "IQRY_CLS_CODE", 0 , "%")
	DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "STA_DATE", 0 , Calendar0.caption)
	DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "FIN_DATE", 0 , Calendar1.caption)
	DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "LIMT_SS_ALSN_YN", 0 , "%")
	DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "APRV_YN", 0 , "%")
	DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "CMPC_APRV_YN", 0 , "%")
	DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "INPUT_EMPNO", 0 , g_szEmpl_no)
	DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "WRPL_NAME", 0 , "%")
	
	
	DATAMANAGER.RequestTranData("obcmp_momt_471r")
	
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcmp_momt_471r" then
		nCnt = DATAMANAGER.GetDataCount(0, "obcmp_momt_471r", "OutBlock1")
		
		for i = nRow to nRow+nCnt-1
		
		'승인번호가 없으면 체크박스 활성화 있으면 비활성화
			if Grid0.GetCellData("bd_cell20", i) <> "" then
				Grid0.SetCellEnable("bd_cell0", i, 0)
			end if
		'제공유형 매크로
			if Grid0.GetCellData("bd_cell22", i) == "01" then
				Grid0.SetCellData("bd_cell12", i, "식사")
			elseif Grid0.GetCellData("bd_cell22", i) == "02" then
				Grid0.SetCellData("bd_cell12", i, "선물")
			elseif Grid0.GetCellData("bd_cell22", i) == "03" then
				Grid0.SetCellData("bd_cell12", i, "경조사")
			elseif Grid0.GetCellData("bd_cell22", i) == "04" then
				Grid0.SetCellData("bd_cell12", i, "기타")
		     elseif Grid0.GetCellData("bd_cell22", i) == "05" then
				Grid0.SetCellData("bd_cell12", i, "선물(농축산물)")
		     elseif Grid0.GetCellData("bd_cell22", i) == "06" then
				Grid0.SetCellData("bd_cell12", i, "경조사(화환,조화)")
			end if
			
			
		'한도초과여부 매크로
			if Grid0.GetCellData("bd_cell21", i) == "0" then
				Grid0.SetCellData("bd_cell16", i, "정상")
			elseif Grid0.GetCellData("bd_cell21", i) == "1" then
				Grid0.SetCellData("bd_cell16", i, "1회한도초과")
			elseif Grid0.GetCellData("bd_cell21", i) == "2" then
				Grid0.SetCellData("bd_cell16", i, "연간한도초과")
			elseif Grid0.GetCellData("bd_cell21", i) == "3" then
				Grid0.SetCellData("bd_cell16", i, "동시초과")
			end if
			
	
				
			nRow = nRow+1
		next
		
	elseif szTranID == "obcmp_momt_472a" then
	
		if nTempCnt >= 0 then
			
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "PROS_CLS_CODE", 			0 , "U"							)
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "BNFT_OFER_DATE", 		0 ,   Grid1.GetCellData("bd_cell0", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "BNFT_OFER_MNNO", 		0 ,   Grid1.GetCellData("bd_cell1", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "TR_CNOF_BNFT_OFER_SRNO",  0 ,	  Grid1.GetCellData("bd_cell2", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "APRV_APLT_NO", 			0 ,   Grid1.GetCellData("bd_cell3", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "APRV_YN", 				0 ,   Grid1.GetCellData("bd_cell4", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "TR_CNRP_NAME", 			0 ,   Grid1.GetCellData("bd_cell5", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "BNFT_OFER_OBJT_CNTT",	0 ,   Grid1.GetCellData("bd_cell6", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "BNFT_OFER_TYPE", 		0 ,   Grid1.GetCellData("bd_cell7", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "BNFT_OFER_CNTT", 		0 ,   Grid1.GetCellData("bd_cell8", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "BNFT_OFER_AMT",  		0 ,   Grid1.GetCellData("bd_cell9", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "LIMT_EXCS_REAS", 		0 ,   Grid1.GetCellData("bd_cell10", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "RMRK", 					0 ,   Grid1.GetCellData("bd_cell11", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "TLMS_TR_CODE_CNTT1", 	0 ,   Grid1.GetCellData("bd_cell12", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "TLMS_TR_CODE_CNTT2", 	0 ,   Grid1.GetCellData("bd_cell13", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "PRD_DPLC_YN", 			0 ,   Grid1.GetCellData("bd_cell14", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "LIMT_SS_ALSN_YN", 		0 ,   Grid1.GetCellData("bd_cell15", nTempCnt-1))
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "INPUT_EMPNO", 			0 , g_szEmpl_no)

			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "AFTR_RPRN_REAS", 		0 ,   Grid1.GetCellData("bd_cell17", nTempCnt-1))
			IF Grid1.GetCellData("bd_cell16", nTempCnt-1) > Grid1.GetCellData("bd_cell0", nTempCnt-1) THEN
				DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "AFTR_RPRN_YN", 		     0 ,   "Y")
			ELSE
				DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "AFTR_RPRN_YN", 		     0 ,   "N")
			END IF			
			
			
			nTempCnt = nTempCnt-1
	
			DATAMANAGER.RequestTranData("obcmp_momt_472a")
		else
			
			Grid0.SetClear()
			nRow = 0
			nReq = 0
			nRound = 0
			nTempCnt = 0
			
			Form.Toast(0, "모든 요청이 완료되었습니다", 0.2)
			
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "BNFT_OFER_INPUT_BRCD", 0 , "%")
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "TR_CNRP_NAME", 0 , "%")
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "ACNO", 0 , "%")
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "TR_CNRP_TELNO", 0 , "%")
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "IQRY_CLS_CODE", 0 , "%")
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "STA_DATE", 0 , Calendar0.caption)
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "FIN_DATE", 0 , Calendar1.caption)
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "LIMT_SS_ALSN_YN", 0 , "%")
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "APRV_YN", 0 , "%")
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_471r", "InBlock1", "CMPC_APRV_YN", 0 , "%")
