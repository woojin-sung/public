'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcmp_momt_472a" then
		DATAMANAGER.SetEventFlag("obcmp_momt_472a", "A")
		
		
	end if
End Sub
'============================================================================
Sub Grid0_OnHeaderClickUp(lRow, szCellID)	'전체 선택
	if szCellID == "th_cell0" then
		if nClick == 0 then
			Grid0.SetCellData("th_cell0", 0, "1")
			nClick = 1
			for i = 0 to Grid0.rowcount
				if Grid0.GetCellEnable("bd_cell0", i) == "1" then
					Grid0.SetCellData("bd_cell0", i, "1")
				end if
			next
		elseif nClick == 1 then
			Grid0.SetCellData("th_cell0", 0, "0")
			nClick = 0
			for i = 0 to Grid0.rowcount
				if Grid0.GetCellEnable("bd_cell0", i) == "1" then
					Grid0.SetCellData("bd_cell0", i, "0")
				end if
			next
		end if
		
	end if
End Sub

