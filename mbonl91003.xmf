'============================================================================
Sub Button1_OnClick()

	
	
	nCnt = Grid0.rowcount
	nReq = 0
	nRound = 0
	
	'직원여부 체크
	if g_szEmpl_no == null then
		Form.ShowAlert("알림", "임직원이 아닙니다")
		exit sub
	end if
	
	for i = 0 to nCnt-1
		if Grid0.GetCellData("bd_cell0", i) == "1" then
			if Grid0.GetCellData("bd_cell20", i) <> "" then
				Form.Toast(0, "이미 승인처리 되었습니다",0.5)
				exit sub
			end if
		end if
	next
	
	DATAMANAGER.ClearInputData(0, "obcmp_momt_472a")
	
	'요청 전 건수 확인
	for i = 0 to nCnt-1
		if Grid0.GetCellData("bd_cell0", i) == "1" then
			nRound = nRound+1
			
'			if nRound > 2 then
'				Form.ShowAlert("경고", "한번에 최대 2건까지 가능합니다")
'				exit sub
'			end if
		end if
	next
	
	Form.Toast(0, "요청건수:"&nRound, 0.2)
	
	for i = 0 to nCnt-1
		if Grid0.GetCellData("bd_cell0", i) == "1" then
			Grid1.SetCellData("bd_cell0", nTempCnt, Grid0.GetCellData("bd_cell1", i) )
			Grid1.SetCellData("bd_cell1", nTempCnt, Grid0.GetCellData("bd_cell2", i) )
			Grid1.SetCellData("bd_cell2", nTempCnt, Grid0.GetCellData("bd_cell3", i) )
			Grid1.SetCellData("bd_cell3", nTempCnt, Grid0.GetCellData("bd_cell20", i))
			Grid1.SetCellData("bd_cell4", nTempCnt, Grid0.GetCellData("bd_cell0", i) )
			Grid1.SetCellData("bd_cell5", nTempCnt, Grid0.GetCellData("bd_cell9", i) )
			Grid1.SetCellData("bd_cell6", nTempCnt, Grid0.GetCellData("bd_cell11", i))
			Grid1.SetCellData("bd_cell7", nTempCnt, Grid0.GetCellData("bd_cell22", i))
			Grid1.SetCellData("bd_cell8", nTempCnt, Grid0.GetCellData("bd_cell13", i))
			Grid1.SetCellData("bd_cell9", nTempCnt, Grid0.GetCellData("bd_cell14", i))
			Grid1.SetCellData("bd_cell10", nTempCnt,Grid0.GetCellData("bd_cell17", i))
			Grid1.SetCellData("bd_cell11", nTempCnt,Grid0.GetCellData("bd_cell16", i))
			Grid1.SetCellData("bd_cell12", nTempCnt,Grid0.GetCellData("bd_cell23", i))
			Grid1.SetCellData("bd_cell13", nTempCnt,Grid0.GetCellData("bd_cell24", i))
			Grid1.SetCellData("bd_cell14", nTempCnt,Grid0.GetCellData("bd_cell25", i))
			Grid1.SetCellData("bd_cell15", nTempCnt,Grid0.GetCellData("bd_cell21", i))
			
			Grid1.SetCellData("bd_cell16", nTempCnt,Grid0.GetCellData("bd_cell4", i))
			Grid1.SetCellData("bd_cell17", nTempCnt,Grid0.GetCellData("bd_cell26", i))
			'Form.ShowAlert(Grid1.GetCellData("bd_cell0", nTempCnt))
			
			Grid1.AddRow()
			nTempCnt = nTempCnt+1
		end if
	next
	
	if nTempCnt <> 0 then
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "PROS_CLS_CODE", 			0 , "U"							)
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "BNFT_OFER_DATE", 		0 ,   Grid1.GetCellData("bd_cell0", nTempCnt-1))
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "BNFT_OFER_MNNO", 		0 ,   Grid1.GetCellData("bd_cell1", nTempCnt-1))
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "TR_CNOF_BNFT_OFER_SRNO",  0 ,	  Grid1.GetCellData("bd_cell2", nTempCnt-1))
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "APRV_APLT_NO", 			0 ,   Grid1.GetCellData("bd_cell3", nTempCnt-1))
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "APRV_YN", 				0 ,   Grid1.GetCellData("bd_cell4", nTempCnt-1))
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "TR_CNRP_NAME", 			0 ,   Grid1.GetCellData("bd_cell5", nTempCnt-1))
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "BNFT_OFER_OBJT_CNTT",	0 ,   Grid1.GetCellData("bd_cell6", nTempCnt-1))
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "BNFT_OFER_TYPE", 		0 ,   Grid1.GetCellData("bd_cell7", nTempCnt-1))
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "BNFT_OFER_CNTT", 		0 ,   Grid1.GetCellData("bd_cell8", nTempCnt-1))
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "BNFT_OFER_AMT",  		0 ,   Grid1.GetCellData("bd_cell9", nTempCnt-1))
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "LIMT_EXCS_REAS", 		0 ,   Grid1.GetCellData("bd_cell10", nTempCnt-1))
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "RMRK", 					0 ,   Grid1.GetCellData("bd_cell11", nTempCnt-1))
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "TLMS_TR_CODE_CNTT1", 	0 ,   Grid1.GetCellData("bd_cell12", nTempCnt-1))
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "TLMS_TR_CODE_CNTT2", 	0 ,   Grid1.GetCellData("bd_cell13", nTempCnt-1))
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "PRD_DPLC_YN", 			0 ,   Grid1.GetCellData("bd_cell14", nTempCnt-1))
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "LIMT_SS_ALSN_YN", 		0 ,   Grid1.GetCellData("bd_cell15", nTempCnt-1))
	
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "INPUT_EMPNO", 			0 , g_szEmpl_no)
		
		DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "AFTR_RPRN_REAS", 		0 ,   Grid1.GetCellData("bd_cell17", nTempCnt-1))
				
		IF Grid1.GetCellData("bd_cell16", nTempCnt-1) > Grid1.GetCellData("bd_cell0", nTempCnt-1) THEN
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "AFTR_RPRN_YN", 		     0 ,   "Y")
		ELSE
			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "AFTR_RPRN_YN", 		     0 ,   "N")
		END IF			
		
		nTempCnt = nTempCnt-1

		DATAMANAGER.RequestTranData("obcmp_momt_472a")
	
	end if

	
'	for i = 0 to nCnt-1
'		if Grid0.GetCellData("bd_cell0", i) == "1" then
'			
'			DATAMANAGER.SetDataValue(0,  "obcmp_momt_472a", "InBlock1", "PROS_CLS_CODE", 			0 , "U"							)
