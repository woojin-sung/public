'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData("ohhts_1682_001r")
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'grd00T4_OnClickUp
'============================================================================
Sub grd00T4_OnClickUp(lRow, szCellID)
	dim szSymbol
	dim szMarket
	dim szName
	
	szSymbol = grd00T4.GetCellData("bd_cell0", lRow)
	szMarket = grd00T4.GetCellData("bd_cell1", lRow)
	szName = grd00T4.GetCellData("bd_cell2", lRow)
	
	Form.OpenFramePopup("mhidx42040_p1" , szSymbol & "★" &  szMarket & "★" & szName , sPosInfo)

End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	 dim szIdx
	 dim szData
	 dim szSpData
	 
	 DATAMANAGER.ClearInputData(0, "ohhts_1682_001r")
	 grd00T4.SetClear()
	 szData		=	""
	 szSpData	=	""
	 
	 if szTranID = "ohhts_1682_001r" then
	 
	    DATAMANAGER.CancelRealData("ohhts_nfut_cntg")
	    szIdx = rdo00T4.currentindex
	    
	    Select Case szIdx
	    Case "0"
		    '귀금속비
		    szData = "COM@GC:COM@SI:NYM@PL:NYM@PA"		    
		    szSpData = Split(szData, ":")
	    Case "1"
		    '비철금속
		    szData = "LME@CDA:COM@HG:LME@ADY:LME@NAA:LME@ZDY:LME@ZDA:LME@NDY:LME@NDA:LME@SDY:LME@SDA:LME@PDY:LME@PDA"		    
		    szSpData = Split(szData, ":")	
	    Case "2"
		    '곡물
			szData = "CBT$ZC:CBT$ZW:CBT$ZS:CBT$ZM:CBT$ZL:CBT$ZO:NYB@KC:NYB@CC:NYB@SB:NYB@CT"
		    szSpData = Split(szData, ":")	
	    Case "3"
		    '원유		    
		    szData = "SPT@CL:NYM@CL:SPT@DU:SPT@EB:IPE@EB"
		    szSpData = Split(szData, ":")
	    End Select
	    
	    
		For i = 0 to #szSpData -1 
		    DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i , "FN" )
		    DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" , i , szSpData(i) )
		Next
	
    End if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	ncnt1682, szDataCnt
	dim	szCode
	dim  nMulti


	if	szTranID	=	"ohhts_1682_001r"	then
		ncnt1682 	=	grd00T4.rowcount
		szDataCnt	=	DATAMANAGER.GetDataCount(0, "ohhts_1682_001r", "OutBlock1")
		
		nMulti =  ( ncnt1682 / szDataCnt ) - 1
		for	i=0+(nMulti * szDataCnt) to 	ncnt1682-1
			szCode 	 =	grd00T4.GetCellData("bd_cell0", i)
	
			if	len(trim(szCode))	>	0	then
				grd00T4.SetCellData("bd_cell10", i, "종가")
			else	
				grd00T4.SetCellData("bd_cell10", i, " ")
			end	if
		next
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'20240509 HSZ START: HOME화면 연동추가
	if sEventName == "SELECT_RADIO" then
		if Trim(sParam) <> "" then
			rdo00T4.currentindex = CInt(sParam)
		end if
	end if
	'20240509 HSZ END
End Sub

