'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 가입신청
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.18 김은숙
'-------------------------------------------------------------------------------------------


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_bInitOk1, g_bInitOk2, g_bInitOk3
g_bInitOk1 = False
g_bInitOk2 = False
g_bInitOk3 = False
Dim g_sACN0, g_sASNO, g_sPWD  '20210312_01 SWJ START
Dim g_setData, nCnt
nCnt = 0
Dim sFinalStep
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Sub SetTitle(sParam)
	Dim sTitle 
	sTitle = ""
	
	Select Case sParam
		Case "0"
			sTitle = "동영상 시청 및 가입유형 선택"
			
			'20210312_01 SWJ START : 스텝별 이미지 설정
			Image0.imgpath = "title_4step_cut_01_on.png"
			'20210312_01 SWJ END
		Case "1"
			sTitle = "투자성향 진단 및 상품(MP) 선택"
			
			'20210312_01 SWJ START : 스텝별 이미지 설정
			Image0.imgpath = "title_4step_cut_02_on.png"
			'20210312_01 SWJ END
		Case "2"
			sTitle = "계약정보 등록"
			
			'20210312_01 SWJ START : 스텝별 이미지 설정
			Image0.imgpath = "title_4step_cut_03_on.png"
			'20210312_01 SWJ END
		Case "3"
			sTitle = "고객 확인 및 안내"
			
			'20210312_01 SWJ START : 스텝별 이미지 설정
			Image0.imgpath = "title_4step_cut_04_on.png"
			'20210312_01 SWJ END
	End Select
	
	tblTitle.SetCellString( 1, 0, sTitle)
End Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData("obsap_acif_999a")		' 금융상품일련번호 채번	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	dim	szList
	dim  szLinkData

	'다음 버튼
	if sEventName == "OPEN_NEXT" then
		fmtab01.currenttab = sParam
		Call SetTitle(sParam)
		
		'노희범 차장님 요청
		'1. 이전 버튼 클릭시 기존 입력 내용 유지하기 위해 폼탭속성의 "Hide시 Unload" 체크 해제
		
		'2. 다음 버튼 클릭시 스크립트로 화면 클리어
		'   다음 버튼 클릭시 기존 입력내용 유지 요청 -> 주석처리
		'Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "CLEAR_DATA", sParam)
		
		'3. 입력데이터 재로드
		'   다음 버튼 클릭시 SetSharedData한 후, 다음 화면 Form_OnFormInit에서 GetSharedData 하는데,
		'   폼 변환시 Unload를 하지 않으므로, 
		'   이전 화면으로 돌아가 데이터 변경 후 다음 버튼 클릭시, Form_OnFormInit을 타지 않음 
		'   -> Trigger로 GetSharedData 재호출
		If (sParam == "1" and g_bInitOk1 == True) or (sParam == "2" and g_bInitOk2 == True) or (sParam == "3" and g_bInitOk3 == True) then
			Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "RELOAD_DATA", "")
		End If
		
		'각 페이지가 한번씩 로드되면 FormInit 완료, 이후부터는 Trigger로 DataShare
		If sParam == "1" then
			g_bInitOk1 = True
		Elseif sParam == "2" then
			g_bInitOk2 = True
		Elseif sParam == "3" then
			g_bInitOk3 = True
		End If
	end if 
	
	'이전 버튼
	if sEventName == "OPEN_PREV" then
	
		fmtab01.currenttab = sParam
		Call SetTitle(sParam)
		
		If sParam == "1" then
			Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "INIT_MPCHANGE", "")
		End If
		
		'20210312_01 HSZ START : 이어가기 수정 
		g_bInitOk1 = True
		g_bInitOk2 = True
'		g_bInitOk3 = True
		'20210312_01 HSZ END
		
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "OPEN_PREV", "") '20210312_01 SWJ : ISA계좌개설 개선
		
	end if 
	
	'20210312_01 SWJ START : ISA 서비스 신청 스텝 결정
	if sEventName == "DECIDE_STEP" then
		g_setData = Split(sParam,"★")

		if Ubound(g_setData) > 0 then
			'다른 단계에서는 필수값인 계좌번호, 일련번호, 비밀번호 값이 없어서 setshared로 공유
			Form.SetSharedData("ISA_ACNO_SEND",g_setData(0))
			Form.SetSharedData("ISA_ASNO_SEND",g_setData(1))
			Form.SetSharedData("ISA_PWD_SEND",g_setData(2))
			
			DATAMANAGER.RequestTranData("obwat_ctad_069r")
		end if
	end if
	'20210312_01 SWJ END
	
	'STEP1 동영상 시청하기 중지(완료)시
	If sEventName == "VIDEO_PLAY_EXIT" then
		
		'20210311 SWJ START : 비디오 시청시간 저장 후 이어보기 긴급수정
		g_timeDate = Form.GetSharedData("&HOST_DATE", true)
		g_videoTime = Form.GetSharedData("ISA_VIDEO_TIME", false)
		g_UserID = Form.GetSharedData("&USER_ID", false)
		
		Form.SaveConfigData("VideoPlaying", "TimeSave"..g_timeDate..g_UserID, g_videoTime)
		'20210311 SWJ END
		
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "VIDEO_PLAY_EXIT", sParam)
		
	end If	
	
	'STEP1 계좌번호 변경시 각 페이지 Data Clear
	If sEventName == "CHANGE_ACCOUNT" then
		Form.triggerEvent("fmtab01.page1", "CLEAR_DATA", sParam)
		Form.triggerEvent("fmtab01.page2", "CLEAR_DATA", sParam)
		Form.triggerEvent("fmtab01.page3", "CLEAR_DATA", sParam)
	end If
	
		
	'투자성향으로 이동
	if sEventName == "MOVE_81010" then
		Form.OpenScreen("81010", "")
		Form.CloseForm()
	end if
End Sub

'============================================================================
'20210312_01 SWJ START : ISA 서비스 신청 개선
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	sApplyDate = Form.GetSharedData("&HOST_DATE", false)
	
	if szTranID == "obwat_ctad_069r" then
		DATAMANAGER.SetDataValue(0, "obwat_ctad_069r", "InBlock1", "ACNO", 0       , g_setData(0))
		DATAMANAGER.SetDataValue(0, "obwat_ctad_069r", "InBlock1", "ASNO", 0 	  , g_setData(1))
		DATAMANAGER.SetDataValue(0, "obwat_ctad_069r", "InBlock1", "PWD" , 0 	  , g_setData(2))
		DATAMANAGER.SetDataValue(0, "obwat_ctad_069r", "InBlock1", "APLT_DATE" , 0 , sApplyDate )
		
'		Call DecideStep() '20220304 아이티젠 김성수 삭제
	end if	
		
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_ctad_069r" then
		'20220304 아이티젠 김성수 이수관, 유형전환 구분추가로 인한 수정 START
		Dim sType
		sType = Trim(DATAMANAGER.GetDataValue(0, "obwat_ctad_069r", "OutBlock1", "ETC_CNTT", 0))
	
		if sType <> "20" and sType <> "30" then '10:ISA신규 20:ISA이수관 30:ISA유형전환
			sFinalStep = DATAMANAGER.GetDataValue(0, "obwat_ctad_069r", "OutBlock1", "REG_STAG_CLS_CODE", 0)
			
			Call DecideStep()
		end if
		'20220304 아이티젠 김성수 수정 END
	'23.05.22 금융상품일련번호 채번 추가
	elseif	szTranID	=	"obsap_acif_999a"	then
		dim szFnprJoinSrno
		szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		
		Form.SetSharedData("FNPR_JOIN_SRNO", szFnprJoinSrno)	
		Form.OpenPopup("mbonl81010_p20" , "" , "")	'2023.05.22 금융소비자 팝업 추가
	end if
End Sub
'============================================================================
Function DecideStep()

	if sFinalStep == "" or sFinalStep == null then
		exit function
	end if

	'이전 가입신청내역 있음 알리고 이어할지 물어보는 로직 추가해야 함
	'이어서 하지않으면 저장내역 서비스로 가져올 필요없음
	
	nCnt = nCnt + 1 '함수 한번만 타도록 수정(56060_t1에서 movenextpage함수를 여러번 타서 그럼)
	
	if nCnt = 1 then
		Form.OpenPopup("mbisa56060_tp",sFinalStep, "")
		'Form.MsgBox("안내", sFinalStep & "단계 완료후 이어하시겠습니까?", "OK_OR_NOT", 1)
	end if
End Function

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "Step_Return" then
		
		'팝업에서 리턴해주는 값에 따라 폼탭 화면 정해진다.
		fmtab01.currenttab = sRet
		
		'스텝 이미지와 타이틀도 재설정 한다.
		SetTitle(sRet)
		
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "OPEN_PREV", "")
		
	elseif sKeyName == "Step_Return_Cancel" then
		exit sub
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			
		elseif sRet == "CANCEL_mbonl81010_p20" then
			Form.OpenMainMenuWithIndex(1,4,0)
		end if
	end if
End Sub
'============================================================================
'20210312_01 SWJ END
'============================================================================
'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("FNPR_JOIN_SRNO", "")	
End Sub


