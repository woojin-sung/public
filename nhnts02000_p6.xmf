'============================================================================
' 거래소코드 -> 거래소벤더코드 변환
'============================================================================
Function Transform_Name(sValue)
	if sValue == "0104" then	' 홍콩
		return "홍콩"
	elseif sValue == "0529" then ' 항셍 지수
		return "항셍"
	elseif sValue == "0215" then ' 상해
		return "상해"
	elseif sValue == "0214" then ' 심천거래소 종목
		return "심천"
	elseif sValue == "0321" then ' 뉴욕
		return "뉴욕"
	elseif sValue == "0066" then ' 아멕스
		return "아멕스"
	elseif sValue == "0537" then ' 나스닥
		return "나스닥"
	elseif sValue == "0130" then ' 미국 OTCBB
		return "미국 OTCBB"
	elseif sValue == "0625" then ' S&P 지수
		return "S&P"
	elseif sValue == "0310" then ' 다우존스 지수
		return "다우존스"
	elseif sValue == "0106" then ' 도쿄
		return "도쿄"
	elseif sValue == "0107" then ' 오사카거래소 종목
		return "오사카"
	elseif sValue == "0112" then ' 자스닥거래소 종목
		return "자스닥"
	elseif sValue == "0889" then ' 니케이 지수
		return "니케이"
	elseif sValue == "0538" then ' 미국 나스닥 지수
		return "미국 나스닥"
	elseif sValue == "0770" then ' 베트남 호치민
		return "호치민"
	elseif sValue == "0771" then ' 베트남 하노이
		return "하노이"
	end if
end Function

'============================================================================
' Set_Unit
'============================================================================
Function Set_Unit(szData, sDecimal)
	
	sztemp = CStr(szData)
	szChk = InStr(sztemp, ".")
	sDecimal = CStr(CInt(sDecimal))
	
	if CStr(szChk) == "0" then
		if sDecimal = "1" then
			sztemp = sztemp & ".0"	
		elseif sDecimal = "2" then
			sztemp = sztemp & ".00"	
		elseif sDecimal = "3" then
			sztemp = sztemp & ".000"	
		elseif sDecimal = "4" then
			sztemp = sztemp & ".0000"	
		end if 
	else
		szCha = CInt(Len(sztemp) - szChk)
	
	
		if CStr(szCha) == "1" then 
			if sDecimal == "2" then
				sztemp = sztemp & "0"	
			elseif sDecimal == "3" then
				sztemp = sztemp & "00"	
			elseif sDecimal == "4" then
				sztemp = sztemp & "000"
			else 
				sztemp = sztemp
			end if 	
		elseif CStr(szCha) == "2" then 
			if sDecimal == "3" then
				sztemp = sztemp & "0"	
			elseif sDecimal == "4" then
				sztemp = sztemp & "00"
			else
				sztemp = sztemp
			end if	
		elseif CStr(szCha) == "3" then 
			if sDecimal == "4" then
				sztemp = sztemp & "0"
			else 
				sztemp = sztemp
			end if	
		else
			sztemp = sztemp
		end if
	end if
	
	return sztemp
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	Dim tData
	
	Form.SetScreenName("해외주식미체결")	

	szOpen = Form.GetOpenLinkData()

	if Trim(szOpen) == "" then
		Exit Sub
	end if
	
	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		'20200331 HWG START : 고유MTS
		g_szFundCd   	= tData(0)
		g_szFundPwd	= tData(1)
		
		DATAMANAGER.RequestTranData("obfnp_fnmt_011r")
		'20200331 HWG END
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'Dim szDate
	'szDate = Form.GetSharedData("&BIZ_DT", false)
	
	grdList.rowcount = 0
	
	' ----------------------------------------------------------------------
	' 주문체결내역 조회
	' ----------------------------------------------------------------------	
	'20200331 HWG START : 고유MTS
	if szTranID == "obtro_oder_301r" then
		DATAMANAGER.ClearInputData(0, "obtro_oder_301r")
		DATAMANAGER.SetDataValue( 0, "obtro_oder_301r", "InBlock1", "ACNO"			, 0 , g_szAcnt)
		DATAMANAGER.SetDataValue( 0, "obtro_oder_301r", "InBlock1", "ASNO"			, 0 , g_szAcntCd)
		DATAMANAGER.SetDataValue( 0, "obtro_oder_301r", "InBlock1", "ACNT_PWD"		, 0 , g_szAcntPwd)
		DATAMANAGER.SetDataValue( 0, "obtro_oder_301r", "InBlock1", "CNTG_CLS_CODE"	, 0 , "2")			' 체결구분코드(0:전체, 1:체결, 2:미체결)
		DATAMANAGER.SetDataValue( 0, "obtro_oder_301r", "InBlock1", "SELN_BYOV_CLCD"	, 0 , "0")			' 매매구분코드(0:전체, 1:매수, 2:매도)
		DATAMANAGER.SetDataValue( 0, "obtro_oder_301r", "InBlock1", "IQRY_CLS_CODE"	, 0 , "4" )
		DATAMANAGER.SetDataValue( 0, "obtro_oder_301r", "InBlock1", "PROS_CLS"		, 0 , "2" )

		DATAMANAGER.SetDataValue( 0, "obtro_oder_301r", "InBlock1", "DATA_CLS"		, 0 , "0" )
	elseif szTranID == "obfnp_fnmt_011r" then
		DATAMANAGER.SetDataValue( 0, "obfnp_fnmt_011r", "InBlock1", "FNCD"			, 0 , g_szFundCd )
	end if
	'20200331 HWG END
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iCnt, szData, szData2
	Dim szItem, szMarket

	' ----------------------------------------------------------------------
	' 해외주식 미체결내역 조회
	' ----------------------------------------------------------------------	
	'20200331 HWG START : 고유MTS
	if szTranID == "obtro_oder_301r" then	
	'20200331 HWG END
		For iCnt = grdList.rowcount - 1 To 0 Step -1
			szType 	= grdList.GetCellData("bd_cell9" , iCnt)
			szVndrCd	= grdList.GetCellData("bd_cell19", iCnt)
			szStatCd = grdList.GetCellData("bd_cell10" , iCnt)
			szRCType = grdList.GetCellData("bd_cell20" , iCnt)
			
			' 매매구분
			if szType == "1" then
				grdList.SetCellFgColor( "bd_cell2", iCnt, "2" )
				if szRCType == "1" then
					grdList.SetCellData("bd_cell2", iCnt, "매도정정")
				elseif szRCType == "2" then
					grdList.SetCellData("bd_cell2", iCnt, "매도취소")
				else
					grdList.SetCellData("bd_cell2", iCnt, "매도")
				end if
				
			elseif szType == "2" then
				grdList.SetCellFgColor( "bd_cell2", iCnt, "1" )
				if szRCType == "1" then
					grdList.SetCellData("bd_cell2", iCnt, "매수정정")
				elseif szRCType == "2" then
					grdList.SetCellData("bd_cell2", iCnt, "매수취소")
				else
					grdList.SetCellData("bd_cell2", iCnt, "매수")
				end if
				
			end if
			
			' 주문상태
			if szStatCd == "0" then
				grdList.SetCellData("bd_cell8", iCnt, "정상")
			elseif szStatCd == "1" then
				grdList.SetCellData("bd_cell8", iCnt, "거부")
			elseif szStatCd == "2" then
				grdList.SetCellData("bd_cell8", iCnt, "자동거부")
			elseif szStatCd == "3" then
				grdList.SetCellData("bd_cell8", iCnt, "자동취소")
			elseif szStatCd == "4" then
				grdList.SetCellData("bd_cell8", iCnt, "미접수")
			end if
			
			'20201218 SWJ START : 시장 컬럼에 거래소명에서 시장명으로 데이터 수정	
			' 시장
			'szVndrName = Transform_Name(szVndrCd)
			'grdList.SetCellData("bd_cell12", iCnt, szVndrName)
			szMarket = grdList.GetCellData("bd_cell12" , iCnt)
			
			if szMarket = "01" then
				grdList.SetCellData("bd_cell12", iCnt, "미국")
				
			elseif szMarket = "02" then
				grdList.SetCellData("bd_cell12", iCnt, "홍콩")
				
			elseif szMarket = "03" then
				grdList.SetCellData("bd_cell12", iCnt, "상해")
				
			elseif szMarket = "04" then
				grdList.SetCellData("bd_cell12", iCnt, "심천")
				
			elseif szMarket = "05" then 
				grdList.SetCellData("bd_cell12", iCnt, "일본")
			
			elseif szMarket = "06" then
				grdList.SetCellData("bd_cell12", iCnt, "호주")
		
			elseif szMarket = "07" then
				grdList.SetCellData("bd_cell12", iCnt, "싱가폴")
				
			elseif szMarket = "08" then
				grdList.SetCellData("bd_cell12", iCnt, "영국")
			
			elseif szMarket = "09" then
				grdList.SetCellData("bd_cell12", iCnt, "영국")
			
			elseif szMarket = "10" then
				grdList.SetCellData("bd_cell12", iCnt, "독일")
			
			elseif szMarket = "11" then
				grdList.SetCellData("bd_cell12", iCnt, "핀란드")

			elseif szMarket = "12" then
				grdList.SetCellData("bd_cell12", iCnt, "프랑스")
			
			elseif szMarket = "13" then
				grdList.SetCellData("bd_cell12", iCnt, "벨기에")
			
			elseif szMarket = "14" then
				grdList.SetCellData("bd_cell12", iCnt, "네덜란드")
			
			elseif szMarket = "15" then
				grdList.SetCellData("bd_cell12", iCnt, "포르투갈")
			
			elseif szMarket = "16" then
				grdList.SetCellData("bd_cell12", iCnt, "그리스")
			
			elseif szMarket = "17" then
				grdList.SetCellData("bd_cell12", iCnt, "아일랜드")
				
			elseif szMarket = "18" then
				grdList.SetCellData("bd_cell12", iCnt, "이탈리아")
			
			elseif szMarket = "19" then
				grdList.SetCellData("bd_cell12", iCnt, "스페인")
			
			elseif szMarket = "20" then
				grdList.SetCellData("bd_cell12", iCnt, "오스트리아")
				
			elseif szMarket = "21" then
				grdList.SetCellData("bd_cell12", iCnt, "캐나다")
				
			elseif szMarket = "23" then
				grdList.SetCellData("bd_cell12", iCnt, "인도네시아")
				
			elseif szMarket = "24" then
				if szVndrCd == "XSTC" then
					grdList.SetCellData("bd_cell12", iCnt, "호치민")  '본래 시장명은 베트남이나, 베트남만 거래소명으로
				elseif szVndrCd == "HSTC" then
					grdList.SetCellData("bd_cell12", iCnt, "하노이")  '본래 시장명은 베트남이나, 베트남만 거래소명으로
				end if
			'20240321 HWG START : 스위스 거래소 오프라인 주문 대응
			elseif szMarket = "26" then
				grdList.SetCellData("bd_cell12", iCnt, "스위스")
			'20240321 HWG END
			end if 
		'20201218 SWJ END	
			
			' 주문가, 체결가
'			szDecimal = grdList.GetCellData("bd_cell11" , iCnt)
'			szVltnPrlsCamt = grdList.GetCellData("bd_cell4", iCnt)
'			szVltnPrlsCamt2 = Set_Unit(CDbl(szVltnPrlsCamt), szDecimal)
'			grdList.SetCellData("bd_cell4", iCnt, szVltnPrlsCamt2)
'		
'			szPsntPrc = grdList.GetCellData("bd_cell5", iCnt)
'			szPsntPrc2 = Set_Unit(CDbl(szPsntPrc), szDecimal)
'			grdList.SetCellData("bd_cell5", iCnt, szPsntPrc2)
		Next
	elseif szTranID == "obfnp_fnmt_011r" then
		g_szAcnt 	= DATAMANAGER.GetDataValue(0, "obfnp_fnmt_011r", "OutBlock1", "ACNO" , 0)
		g_szAcntCd 	= DATAMANAGER.GetDataValue(0, "obfnp_fnmt_011r", "OutBlock1", "ASNO" , 0)
		g_szAcntPwd 	= DATAMANAGER.GetDataValue(0, "obfnp_fnmt_011r", "OutBlock1", "PWD" , 0)
		
		DATAMANAGER.RequestTranData("obtro_oder_301r")
	end if
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szOdrNo, szOdrType, szOdrPrc, szClsCd, szDate, szData
	
	if lRow > -1 then
		szCd      	= grdList.GetCellData("bd_cell3" ,	lRow)
		szVndrCd	 	= grdList.GetCellData("bd_cell19",	lRow)
		szCdName	 	= grdList.GetCellData("bd_cell13",	lRow)
		szMicheQty	= grdList.GetCellData("bd_cell6" ,	lRow)
		szOdrNo   	= grdList.GetCellData("bd_cell1" ,	lRow)	
		szOdrPrc  	= grdList.GetCellData("bd_cell4" ,	lRow)
		szDate    	= grdList.GetCellData("bd_cell7" ,	lRow)
		
		'20201218 SWJ START : 오프라인종목 주문창으로 데이터 안넘어가도록 추가
		szOnline = grdList.GetCellData("bd_cell21", lRow)
		
		if szOnline == "N" then
			Form.ShowAlert("알림", "선택상품은 MTS에서 거래되지 않는 상품입니다.")
			Exit Sub
		end if
		'20201218 SWJ END

		' 전달내용/종목코드/주문일자/주문번호/미체결수량/주문가격
		szData = "미체결" & "★" & szCd & "★" & szVndrCd & "★" & szCdName & "★" & szDate & "★" & szOdrNo & "★" & szMicheQty & "★" & szOdrPrc 
		
		Form.SendReturnToParent("02000_CONTRACT", szData)	'20200331 HWG : 고유MTS
		Form.CloseForm()			
	end if	
End Sub

