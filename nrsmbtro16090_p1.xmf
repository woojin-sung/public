'============================================================================
'f_SetRegType() : 약정 처리 CASE SET 
'리턴 값 > 0:이미 약정된 상태, 1:소수점 약정, 2:소수점,ETP 약정, 3:해외주식,소수점,ETP약정, 4:해외주식, 소수점
'============================================================================
Function f_GetPopupType()
	if g_bGlobal_DotTrade_State == true then
		return "0"
	end if
	
	if g_bGlobal_Trade_State = false then
		return "3"
	else
		if g_bGlobal_ETP_State == false then
			return "2"
		else
			return "1"
		end if
	end if
	
	return "0"
End Function

