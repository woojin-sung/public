'============================================================================
'f_OpenChkPopup(iIdx) : 각 동의체크 별 안내팝업 호출
'============================================================================
Function f_OpenChkPopup(iIdx)
	'if g_FinCustomer <> "N" then
		if iIdx < 4 then
			'Form.SetSharedData("OPEN_URL", f_sGetURL(iIdx) )
			'Form.OpenFramePopup("nrsmbtro16090_p8", iIdx&"♥"& f_sGetURL(iIdx) &"♥"& f_sGetURLTitle(iIdx), "")
			Form.SetSharedData("16090_CUST_CLS_CODE" , g_szCUST_CLS_CODE)
			Form.OpenPopup("nrsmbtro16090_p8", iIdx&"♥"&f_sGetURLTitle(iIdx), "")
		elseif iIdx == 4 then
			Form.OpenPopup("nrsmbtro16090_p9", "", "") '개인정보처리요약동의창
		end if
	'end if
End Function

'============================================================================
'f_sGetURLTitle(iIdx) : 각 동의체크 별 타이틀 리턴
'============================================================================
Function f_sGetURLTitle(iIdx)
	Dim szTitle
	Select Case iIdx	
		Case 1
			szTitle = "해외주식 실시간시세정보 이용약관"	
		Case 2
			szTitle = "해외주식 시세신청 비전문가 확인"
		Case 3
			szTitle = "해외주식 개인(신용)정보 동의서(필수)"
	End Select
	return szTitle
End Function
