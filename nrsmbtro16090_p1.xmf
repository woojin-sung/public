'============================================================================
'f_SetBtnRegEnable() : 확인 처리 버튼 상태 결정
'============================================================================
Function f_SetBtnRegEnable()

	'전체체크여부
	if g_bAllChkClickFlag == "" or g_bAllChkClickFlag == null or CInt(chkAll.checkstate) == 0 then
		btnOK.enable = false
'msgbox 1
		Exit Function	
	end if	
	
	'해외주식 실시간시세정보 이용약관
	if g_bChk1ClickFlag == "" or g_bChk1ClickFlag == null or CInt(chk1.checkstate) == 0 then
		btnOK.enable = false
msgbox 2
		Exit Function	
	end if
	
	'해외주식 시세신청 비전문가 확인
	if g_bChk2ClickFlag == "" or g_bChk2ClickFlag == null or CInt(chk2.checkstate) == 0 then
		btnOK.enable = false
'msgbox 3
		Exit Function	
	end if
	
	'해외주식 개인(신용)정보 동의서(필수)
	if g_bChk3ClickFlag == "" or g_bChk3ClickFlag == null or CInt(chk3.checkstate) == 0 then
		btnOK.enable = false
'msgbox 4
		Exit Function	
	end if	
	
	'신청가능
	btnOK.enable = true
End Function

'============================================================================
Function f_SetAllCheckState()
'	dim nCheck, nChkCnt
'	nChkCnt = 0
'	if CInt(grid0.rowcount) > 0 then
'		for i=0 to CInt(grid0.rowcount)-1
'			nCheck = CInt(grid0.GetCellData( "bd_check", i ))
'			if nCheck == 1 then
'				nChkCnt = nChkCnt + 1
'			end if
'		next
'		if g_nAbleCnt == nChkCnt then
'			chkAll.chksilence = "1"
'		else
'			chkAll.chksilence = "0"
'		end if
'	end if
	
	if chk1.chksilence == "0" OR chk2.chksilence == "0" OR chk3.chksilence == "0" then
		g_bAllChkClickFlag = false
		chkAll.chksilence = "0"
	else
		g_bAllChkClickFlag = true
		chkAll.chksilence = "1"
	end if 
	f_SetContAllChkState(g_bAllChkClickFlag)
End Function

'============================================================================
'f_SetContAllChkState(bValue) : 전체동의 체크 상태 SET
'============================================================================
Function f_SetContAllChkState(bValue)
	if bValue == true then
		chkAll.chksilence = "1"
		imgUIAllChk.imgpath = "icon_chk_off.png"
		btnAllChk.fgcolor = "4"
		lblUnderLine.bgcolor = "4"
		g_bAllChkClickFlag = false
	else
		chkAll.chksilence = "0"
		imgUIAllChk.imgpath = "icon_chk_on.png"
		btnAllChk.fgcolor = "127"
		lblUnderLine.bgcolor = "127"
	end if	
End Function

'============================================================================
Function f_SetChk1State(bValue)
	if bValue == true then
		chk1.chksilence = "1"
		imgUIChk1.imgpath = g_szCheckImg
		lblChkText1.fgcolor = g_szCheckFg
	else
		chk1.chksilence = "0"
		imgUIChk1.imgpath = g_szUnCheckImg
		lblChkText1.fgcolor = g_szUnCheckFg
	end if
	
	g_bChk1ClickFlag = bValue
	
	'전체동의 체크 상태
	f_SetAllCheckState()
	'확인버튼 활성화 여부
	f_SetBtnRegEnable()
End Function

'============================================================================
Function f_SetChk2State(bValue)
	if bValue == true then
		chk2.chksilence = "1"
		imgUIChk2.imgpath = g_szCheckImg
		lblChkText2.fgcolor = g_szCheckFg
	else
		chk2.chksilence = "0"
		imgUIChk2.imgpath = g_szUnCheckImg
		lblChkText2.fgcolor = g_szUnCheckFg
	end if
	
	g_bChk2ClickFlag = bValue
	
	'전체동의 체크 상태
	f_SetAllCheckState()
	'확인버튼 활성화 여부
	f_SetBtnRegEnable()
End Function

'============================================================================
Function f_SetChk3State(bValue)
	if bValue == true then
		chk3.chksilence = "1"
		imgUIChk3.imgpath = g_szCheckImg
		lblChkText3.fgcolor = g_szCheckFg
	else
		chk3.chksilence = "0"
		imgUIChk3.imgpath = g_szUnCheckImg
		lblChkText3.fgcolor = g_szUnCheckFg
	end if
	
	g_bChk3ClickFlag = bValue

	'전체동의 체크 상태
	f_SetAllCheckState()
	'확인버튼 활성화 여부
	f_SetBtnRegEnable()
End Function

'============================================================================
Sub Form_OnFormInitBefore()
	g_szUnCheckImg = "icon_chk_on.png"
	g_szCheckImg = "icon_chk_off.png"
	g_szUnCheckFg = "127"
	g_szCheckFg = "4"
	g_szNotiFlag = ""	
End Sub

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()	
	if szData <> "" then
		g_szCUST_CLS_CODE = szData		
'		cldFromDate.caption = Left(szData, 8)
'		cldToDate.caption = Right(szData, 8)
'		RgDateType.currentindex = 2
'		cldFromDate.enable = "1"
	else	
		g_szCUST_CLS_CODE = ""
	end if	
	Form.SetSharedData("16090_CUST_CLS_CODE" , g_szCUST_CLS_CODE)
	
	g_ServerMode = Form.GetSharedData("&SERVER_MODE", false)
End Sub

'============================================================================
' Form_OnFormClose 
'============================================================================
Sub Form_OnFormClose()
	'Form.SendReturnToParent("DATE_SET", cldFromDate.caption & " ~ " & cldToDate.caption)
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnOK_OnClick()
'	if  CInt(cldFromDate.caption) > CInt(cldToDate.caption) then
'msgbox "종료날짜가 시작날짜보도 과거입니다."			
'	end if 
	'매매유형선택 알림
	'Form.SendReturnToParent("DATE_SET", cldFromDate.caption & " ~ " & cldToDate.caption)
	Form.SendReturnToParent("mbtro16090_p1_RETURN", "OK")
	Form.CloseForm()	
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "nrsmbtro16090_p8" then
'msgbox sRet 
		if sRet == "All" then
			'f_SetContAllChkState(true)	
			f_SetChk1State(true)
			f_SetChk2State(true)
			f_SetChk3State(true)
		else
			if sRet == "1" then
				f_SetChk1State(true)
			elseif sRet == "2" then
				f_SetChk2State(true)
			elseif sRet == "3" then
				f_SetChk3State(true)
			else
				'g_bAllChkClickFlag = false
				
				'g_bChk1ClickFlag		'해외주식 실시간시세정보 이용약관
				'g_bChk2ClickFlag		'해외주식 시세신청 비전문가 확인
				'g_bChk3ClickFlag		'해외주식 개인(신용)정보 동의서(필수)				
			end if 
		end if 
		
		'전체동의 체크 상태
		f_SetAllCheckState()
		'확인버튼 활성화 여부
		f_SetBtnRegEnable()		
	elseif sKeyName == "nrsmbtro16090_p9" then
		if sRet == "OK" then
			f_OpenChkPopup(3)
		end if 
	end if 
End Sub

'============================================================================
'모두 확인하고, 동의 합니다.
'============================================================================
Sub btnAllChk_OnClick()
	if CInt(chkAll.checkstate) == 1 then
		g_bAllChkClickFlag = false
		f_SetContAllChkState(false)
		f_SetChk1State(false)
		f_SetChk2State(false)
		f_SetChk3State(false)
	else
		g_bAllChkClickFlag = true
		f_OpenChkAllPopup()
	end if
	
	'확인버튼 활성화 여부
	f_SetBtnRegEnable()	
End Sub

'해외주식 실시간시세정보 이용약관
'============================================================================
Sub imgChk1_OnClick()
	if CInt(chk1.checkstate) == 1 then
		f_SetChk1State(false)
		f_SetContAllChkState(false)
		'contNoti.visible = false
		btnOK.enable	= False
	else
		f_OpenChkPopup(1)
	end if	
End Sub

'============================================================================
Sub lblChkText1_OnClick()
	imgChk1_OnClick()
End Sub

'============================================================================
Sub imgUIChk1_OnClick()
	imgChk1_OnClick()
End Sub


