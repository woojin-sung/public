<ROOT>
	<MAP_INFO scrno="15000" scrname="잔고 유의사항" version="2" writer="홍수지" />
	<FORM_INFO name="Form" ly_vert="0,0,375,607,1" />
	<CONTROL_INFO>
		<TABLE name="Table0" insidelinecolor="102:255255255" colcount="2" rowcount="35" outline="0000" designorder="1" ly_vert="0,10,375,558,1" >
			<COL_INFO ly_vert_width="15,360" />
			<ROW_INFO ly_vert_height="25,17,17,17,17,17,17,17,8,17,17,17,17,17,17,17,17,17,17,8,17,17,8,17,17,8,17,17,8,17,17,17,17,17,17" />
			<CELL_INFO>
				<CELL cell_ly="0,0,1,0" valign="0" halign="0" line="0,0" caption="잔고화면은 다음과 같이 계산되어 표시됩니다." autofontsize="1" paddinginfo="0,2,0,0" impidxs="" />
				<CELL cell_ly="0,1,0,1" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,1,1,1" halign="0" line="0,0" caption="주식 평가금액 : 주식잔고의 평가금액 합" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,2,0,2" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,2,1,2" halign="0" line="0,0" caption="주식순평가 : (주식 평가금액 - 대출금액 합)" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,3,0,3" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,3,1,3" halign="0" line="0,0" caption="순자산금액 : (주식 평가금액 - 대출금액 합) + 'D+2'예수금" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,4,0,4" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,4,1,4" halign="0" line="0,0" caption="평가손익(현재가에 팔았을 때 발생하는 예상실현손익을 의미)" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,5,0,5" line="0,0" impidxs="" />
				<CELL cell_ly="1,5,1,5" halign="0" line="0,0" caption="1)비용미포함 : 평가금액 - 매입금액" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,6,0,6" line="0,0" impidxs="" />
				<CELL cell_ly="1,6,1,6" halign="0" line="0,0" caption="2)비용포함 : 평가금액 - 매입금액 - 수수료 - 제세금 - 이자" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,7,0,7" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,7,1,7" halign="0" line="0,0" caption="당일손익 : 당일실현 손익 + 전일대비 잔고평가손익" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,8,0,8" line="0,0" impidxs="" />
				<CELL cell_ly="1,8,1,8" halign="0" line="0,0" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,9,0,9" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,9,1,9" halign="0" line="0,0" caption="매입금액 : 매수 시 발생한 매수가격(수수료 제외) × 보유잔고 수량" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,10,0,10" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,10,1,10" halign="0" line="0,0" caption="평가금액 : 현재가 × 보유잔고 수량" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,11,0,11" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,11,1,11" halign="0" line="0,0" caption="수수료 : 매수수수료 + 매도수수료" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,12,0,12" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,12,1,12" halign="0" line="0,0" caption="매수수수료 : 매수시점에 실제 납부된 매수수수료" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,13,0,13" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,13,1,13" halign="0" line="0,0" caption="매도수수료 : 현재가로 전량 매도시 납부될 매도수수료 추정" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,14,0,14" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,14,1,14" halign="0" line="0,0" caption="제세금 : 현재가로 전량매도시 납부될 제세금 추정" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,15,0,15" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,15,1,15" halign="0" line="0,0" caption="이자 : 매도시점에 추가 발생하는 신용이자비용" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,16,0,16" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,16,1,16" halign="0" line="0,0" caption="BEP단가(손익 분기점 가격)" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,17,0,17" line="0,0" impidxs="" />
				<CELL cell_ly="1,17,1,17" halign="0" line="0,0" caption="1)비용미포함 : 매입금액 ÷ 잔고수량" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,18,0,18" line="0,0" impidxs="" />
				<CELL cell_ly="1,18,1,18" halign="0" line="0,0" caption="2)비용포함 : (매입금액 + 수수료 + 제세금 + 이자) ÷ 잔고 수량" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,19,0,19" line="0,0" impidxs="" />
				<CELL cell_ly="1,19,1,19" halign="0" line="0,0" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,20,0,20" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,20,1,20" halign="0" line="0,0" caption="비용포함 평가손익은 비용을 추정하여 계산한 값이기에," fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,21,0,21" line="0,0" impidxs="" />
				<CELL cell_ly="1,21,1,21" halign="0" line="0,0" caption="실제 결제일의 수수료 금액과 차이가 발생할 수 있습니다." fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,22,0,22" line="0,0" impidxs="" />
				<CELL cell_ly="1,22,1,22" halign="0" line="0,0" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,23,0,23" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,23,1,23" halign="0" line="0,0" caption="계좌에 종목이 100개 이하인 경우에만 실시간 잔고 조회가" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,24,0,24" line="0,0" impidxs="" />
				<CELL cell_ly="1,24,1,24" halign="0" line="0,0" caption="제공되며, 순자산평가금액은 실시간 잔고가 제공되지 않습니다." fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,25,0,25" line="0,0" impidxs="" />
				<CELL cell_ly="1,25,1,25" halign="0" line="0,0" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,26,0,26" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,26,1,26" halign="0" line="0,0" caption="실시간 가격변동에 따라 평가금액에 미세한 차이가 발생할" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,27,0,27" line="0,0" impidxs="" />
				<CELL cell_ly="1,27,1,27" halign="0" line="0,0" caption="수 있습니다." fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,28,0,28" line="0,0" impidxs="" />
				<CELL cell_ly="1,28,1,28" halign="0" line="0,0" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,29,0,29" line="0,0" caption="·" impidxs="" />
				<CELL cell_ly="1,29,1,29" halign="0" line="0,0" caption="계좌 예탁금 중 증권매수에 사용되지 않고, 고객 계좌에" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,30,0,30" line="0,0" impidxs="" />
				<CELL cell_ly="1,30,1,30" halign="0" line="0,0" caption="현금으로 남아있는 금액은 예금자 보호법에 따라" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,31,0,31" line="0,0" impidxs="" />
				<CELL cell_ly="1,31,1,31" halign="0" line="0,0" caption="예금보험 공사가 보호하되, 보호한도는 본 금융회사에 있는" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,32,0,32" line="0,0" impidxs="" />
				<CELL cell_ly="1,32,1,32" halign="0" line="0,0" caption="귀하의 모든 예금자보호 대상 금융상품의 원금과 소정의" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,33,0,33" line="0,0" impidxs="" />
				<CELL cell_ly="1,33,1,33" halign="0" line="0,0" caption="이자를 합하여 1인당 최고 5천만원이며, 5천만원을 초과하는" fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
				<CELL cell_ly="0,34,0,34" line="0,0" impidxs="" />
				<CELL cell_ly="1,34,1,34" halign="0" line="0,0" caption="나머지 금액은 보호하지 않습니다." fontsize="-2" autofontsize="1" paddinginfo="1,0,0,0" impidxs="" />
			</CELL_INFO>
		</TABLE>
	</CONTROL_INFO>
