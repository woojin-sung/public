Sub SetTabImage()
	fmtab1.setTabHeaderImage("tab_03_o.9","tab_03_n.9", 0.5)
	fmtab2.setTabHeaderImage("tab_03_o.9","tab_03_n.9", 0.5)
	fmtab3.setTabHeaderImage("tab_03_o.9","tab_03_n.9", 0.5)
	fmtab4.setTabHeaderImage("tab_03_o.9","tab_03_n.9", 0.5)
	fmtab5.setTabHeaderImage("tab_03_o.9","tab_03_n.9", 0.5)
	fmtab6.setTabHeaderImage("tab_03_o.9","tab_03_n.9", 0.5)
	fmtab7.setTabHeaderImage("tab_03_o.9","tab_03_n.9", 0.5)
	fmtab8.setTabHeaderImage("tab_03_o.9","tab_03_n.9", 0.5)
End Sub

'============================================================================
'20230203 HSZ END
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obacb_balc_150r" then
		if g_szCmbIndex == 0 then
			Dim szCustID
			szCustID = Form.GetSharedData("&USER_ID", false)
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "1" )	'"1": 전체계좌단위(ID로 조회)
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ELFN_ID" , 0 , szCustID )
		else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "3" )	'"1": 개별계좌단위
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , Left(cmb0.cbkeydata, 8) )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , Right(cmb0.cbkeydata, 2) )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacb_balc_150r" then
		g_szStockYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "DMST_STCK_RMND_HLDN_YN" , 0)
		g_szOvrsYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OVRS_STCK_RMND_HLDN_YN" , 0)
		g_szCFDYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "DMST_CFD_RMND_HLDN_YN" , 0)
		g_szOvrsCFDYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACFD_RMND_HLDN_YN" , 0)
		g_szDrvtYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "DMST_DRVT_RMND_HLDN_YN" , 0)
		g_szFundYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FND_RMND_HLDN_YN" , 0) 
		g_szBondYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "DMST_BOND_RMND_HLDN_YN" , 0)
		g_szEtcYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ETC_RMND_HLDN_YN" , 0)
		g_szOmDrvtYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OM_DRVT_RMND_HLDN_YN" , 0)
		g_szWonYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "WNCR_TFAM_HLDN_YN" , 0)
		g_szFrcrYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FRCR_TFAM_HLDN_YN" , 0)
		
		if g_szExistYn == "Y" then
			SetTabList(g_szTabgrp)
		else
			Dim szGrp
			szGrp = g_szTabgrp
			if g_szList(2) = "t1" and g_initFlag = "0" then 		'상품별 잔고탭에서 진입 시에만
				Form.SetCtlProp("fmtab" & CStr(szGrp), "currenttabpageid", g_nTabIndex)
				Call SetTrigger(g_nTabIndex)
				
			else
				
				if Trim(g_nTabKey) = "" then 'v02
					Form.SetCtlProp("fmtab" & CStr(szGrp), "currenttab", 0)
					Call SetTrigger(0)
				else
					'20231006 이전앱으로 반영예정이라 ios 예외처리
					Form.SetCtlProp("fmtab" & CStr(szGrp), "currenttabpageid", CInt(g_nTabKey))
					
					if g_szOsType == "2" and g_szAppVer <> "" and CInt(g_szAppVer) < 2534 then
						test = Form.GetCtlProp("fmtab" & CStr(szGrp), "currenttab")
						
						if Cint(test) < 0 then
							Form.SetCtlProp("fmtab" & CStr(szGrp), "currenttab", 0)
							g_nTabKey = Form.GetCtlProp("fmtab" & CStr(szGrp), "currenttabpageid")
							g_nTabIndex = 0
						end if
					end if
					
					Call SetTrigger(g_nTabIndex)
				end if
			end if
			
			Form.SetCtlProp("fmtab" & CStr(szGrp), "left", 0)
			
			if g_szOsType == "1" or (g_szOsType == "2" and g_szAppVer <> "" and CInt(g_szAppVer) >= 2534) then
				Select Case CInt(szGrp)
				Case 1
					fmtab1.SetUseAnimation("1")
				Case 2
					fmtab2.SetUseAnimation("1")
				Case 3
					fmtab3.SetUseAnimation("1")
				Case 4
					fmtab4.SetUseAnimation("1")
				Case 5
					fmtab5.SetUseAnimation("1")
				Case 6
					fmtab6.SetUseAnimation("1")
				Case 8	
					fmtab8.SetUseAnimation("1")
				Case Else	
					fmtab7.SetUseAnimation("1")
				End Select
			end if
		end if
		
		g_initFlag = "1"
	end if
End Sub



'============================================================================
Sub Form_OnFormInitBefore()
	imgRefresh.setMaintainingRatio("1")
	imgSetting.setMaintainingRatio("1")
	imgNodata.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbact71052_p1_setting" then
		g_szExistYn = Form.LoadConfigData("mbact71052_p1", "SHOW_EXIST_ONLY_YN")
		
		imgNodata.visible = false
		lblNodata.visible = false
		
		TabClear()
		TabUISetting(g_szTabgrp)
	end if
End Sub

'============================================================================
Sub imgSetting_OnClick()
	Form.OpenPopupAnimation("mbact71052_p1_setting", "", "", "2")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	If szSubMsg <> "" And szSubMsg <> null Then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	Else
		Form.ShowAlert("알림", szErrMsg)
	End If
End Sub

