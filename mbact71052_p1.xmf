'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetTrigger(nIndex) : TabIndex에 따른 트리거 이벤트
'============================================================================
Function SetTrigger(nIndex)
	Dim szData
	if g_szCmbIndex <> 0 then
		szCurAcnt = cmb0.cbkeydata
		szData = "1" & "○" & " " & "○" & cld0.caption & "○" & szCurAcnt	'계좌개수, 전체여부,날짜,선택계좌번호
	else
		szData = g_szList(1) & "○" & "Y" & "○" & cld0.caption & g_szList(4)	'계좌개수, 전체여부,날짜,계좌번호들
	end if
	
'	20230203 HSZ START: 개별계좌 속성에 따라 폼탭 구성
'	nIndex = Cint(fmtab0.currenttabpageid)										'기존 소스 주석처리
	nIndex = CInt(Form.GetCtlProp("fmtab" & CStr(g_szTabgrp), "currenttabpageid"))	
	szTriggerTab = "fmtab"..CStr(g_szTabgrp).."."..nIndex							
	Select Case nIndex
		Case 0
			Form.triggerEvent( szTriggerTab, "mbact71052_p3", szData )		'국내주식
		Case 1
			Form.triggerEvent( szTriggerTab, "mbact71052_p10", szData )		'해외주식
		Case 2
			Form.triggerEvent( szTriggerTab, "mbact71052_p11", szData )		'국내CFD
		Case 3
			Form.triggerEvent( szTriggerTab, "mbact71052_p12", szData )		'해외CFD
		Case 4
			Form.triggerEvent( szTriggerTab, "mbact71052_p8", szData )		'국내파생
		Case 5
			'Form.triggerEvent( szTriggerTab, "mbact71052_p5", szData )		'펀드
			Form.triggerEvent( szTriggerTab, "mbact71052_p6", szData )		'ELS/DLS
		Case 6
			'Form.triggerEvent( szTriggerTab, "mbact71052_p13", szData )	'채권
			Form.triggerEvent( szTriggerTab, "mbact71052_p5", szData )		'펀드
		Case 7
			'Form.triggerEvent( szTriggerTab, "mbact71052_p4", szData )		'CMA/슈퍼365
			Form.triggerEvent( szTriggerTab, "mbact71052_p13", szData )		'채권
		Case 8
			'Form.triggerEvent( szTriggerTab, "mbact71052_p6", szData )		'장외파생
			Form.triggerEvent( szTriggerTab, "mbact71052_p7", szData )		'단기사채/기타
		Case 9
			Form.triggerEvent( szTriggerTab, "mbact71052_p9", szData )		'원화예수금
		Case Else
			Form.triggerEvent( szTriggerTab, "mbact71052_p14", szData )		'외화예수금
		'Case Else
		'	Form.triggerEvent( szTriggerTab, "mbact71052_p7", szData )		'단기사채/기타
	End Select
'	20230203 HSZ END

End Function

'============================================================================
Function SetTabList(szGrp)
	'obacb_balc_150r에서 가져온 데이터를 사용해 보유중이지 않은 상품탭 제거
	if szGrp == "1" then
		for i = 0 to #g_szTabArray1 - 1
			DeleteTab(szGrp, g_szTabArray1(i))
		next
	elseif szGrp == "2" then
		for i = 0 to #g_szTabArray2 - 1
			DeleteTab(szGrp, g_szTabArray2(i))
		next
	elseif szGrp == "3" then
		for i = 0 to #g_szTabArray3 - 1
			DeleteTab(szGrp, g_szTabArray3(i))
		next
	elseif szGrp == "4" then
		for i = 0 to #g_szTabArray4 - 1
			DeleteTab(szGrp, g_szTabArray4(i))
		next
	elseif szGrp == "5" then
		for i = 0 to #g_szTabArray5 - 1
			DeleteTab(szGrp, g_szTabArray5(i))
		next
	elseif szGrp == "6" then
		for i = 0 to #g_szTabArray6 - 1
			DeleteTab(szGrp, g_szTabArray6(i))
		next
	elseif szGrp == "7" then
		for i = 0 to #g_szTabArray7 - 1
			DeleteTab(szGrp, g_szTabArray7(i))
		next
	elseif szGrp == "8" then
		for i = 0 to #g_szTabArray8 - 1
			DeleteTab(szGrp, g_szTabArray8(i))
		next
	end if
	
	'탭 세팅 다 한 후 트리거 이벤트 보냄
	if g_szList(2) = "t1" and g_initFlag = "0" then 		'상품별 잔고탭에서 진입 시에만
		Form.SetCtlProp("fmtab" & CStr(szGrp), "currenttabpageid", g_nTabIndex)
		Call SetTrigger(g_nTabIndex)
		
	else
	
		if Trim(g_nTabKey) = "" then 'v02
			Form.SetCtlProp("fmtab" & CStr(szGrp), "currenttab", 0)
			Call SetTrigger(0)
		else
			'20231006 이전앱으로 반영예정이라 ios 예외처리
			Form.SetCtlProp("fmtab" & CStr(szGrp), "currenttabpageid", CInt(g_nTabKey))
			
			if g_szOsType == "2" and g_szAppVer <> "" and CInt(g_szAppVer) < 2534 then
				test = Form.GetCtlProp("fmtab" & CStr(szGrp), "currenttab")
				
				if Cint(test) < 0 then
					Form.SetCtlProp("fmtab" & CStr(szGrp), "currenttab", 0)
					g_nTabKey = Form.GetCtlProp("fmtab" & CStr(szGrp), "currenttabpageid")
					g_nTabIndex = 0
				end if
			end if
			
			Call SetTrigger(g_nTabIndex)
		end if
	end if
	
	Form.SetCtlProp("fmtab" & CStr(szGrp), "left", 0)
	
	Dim nTabCount
	nTabCount = CInt(Form.GetCtlProp("fmtab" & CStr(szGrp), "tabcount"))
'	Form.ShowAlert(szGrp, nTabCount)
	if nTabCount == 0 then
		TabClear()
		
		imgNodata.visible = true
		lblNodata.visible = true
	else
		imgNodata.visible = false
		lblNodata.visible = false
	end if
	
	if g_szOsType == "1" or (g_szOsType == "2" and g_szAppVer <> "" and CInt(g_szAppVer) >= 2534) then
		Select Case CInt(szGrp)
		Case 1
			fmtab1.SetUseAnimation("1")
		Case 2
			fmtab2.SetUseAnimation("1")
		Case 3
			fmtab3.SetUseAnimation("1")
		Case 4
			fmtab4.SetUseAnimation("1")
		Case 5
			fmtab5.SetUseAnimation("1")
		Case 6
			fmtab6.SetUseAnimation("1")
		Case 8	
			fmtab8.SetUseAnimation("1")
		Case Else	
			fmtab7.SetUseAnimation("1")
		End Select
	end if
	
	g_initFlag = "1"
End Function

'============================================================================
'상품 보유여부를 체크하여 탭을 삭제할지 판단
'============================================================================
Function DeleteTab(szGrp, szTabID)
	if CInt(szTabID) == 0 then
		if g_szStockYn <> "Y" then
			Form.SetCtlProp("fmtab" & szGrp, "deletepage", szTabID)
		end if
	elseif CInt(szTabID) == 1 then
		if g_szOvrsYn <> "Y" then
			Form.SetCtlProp("fmtab" & szGrp, "deletepage", szTabID)
		end if
	elseif CInt(szTabID) == 2 then
		if g_szCFDYn <> "Y" then
			Form.SetCtlProp("fmtab" & szGrp, "deletepage", szTabID)
		end if
	elseif CInt(szTabID) == 3 then
		if g_szOvrsCFDYn <> "Y" then
			Form.SetCtlProp("fmtab" & szGrp, "deletepage", szTabID)
		end if
	elseif CInt(szTabID) == 4 then
		if g_szDrvtYn <> "Y" then
			Form.SetCtlProp("fmtab" & szGrp, "deletepage", szTabID)
		end if
	elseif CInt(szTabID) == 5 then
		if g_szOmDrvtYn <> "Y" then
			Form.SetCtlProp("fmtab" & szGrp, "deletepage", szTabID)
		end if
	elseif CInt(szTabID) == 6 then
		if g_szFundYn <> "Y" then
			Form.SetCtlProp("fmtab" & szGrp, "deletepage", szTabID)
		end if
	elseif CInt(szTabID) == 7 then
		if g_szBondYn <> "Y" then
			Form.SetCtlProp("fmtab" & szGrp, "deletepage", szTabID)
		end if
	elseif CInt(szTabID) == 8 then
		if g_szEtcYn <> "Y" then
			Form.SetCtlProp("fmtab" & szGrp, "deletepage", szTabID)
		end if
	elseif CInt(szTabID) == 9 then
		if g_szWonYn <> "Y" then
			Form.SetCtlProp("fmtab" & szGrp, "deletepage", szTabID)
		end if
	elseif CInt(szTabID) == 10 then
		if g_szFrcrYn <> "Y" then
			Form.SetCtlProp("fmtab" & szGrp, "deletepage", szTabID)
		end if
	end if
	
End Function

'============================================================================
'보유상품만 보기 설정이 아닐경우 모든 탭을 다시 살리는 함수
'============================================================================
Function RestoreTab(szGrp)
	if szGrp == "1" then
		fmtab1.deleteAllPage()
		for i = 0 to #g_szTabArray1 - 1
			fmtab1.insertPage(fmtab1.tabcount, g_szTabArray1(i), g_szTabArray1(i), g_szTabFile1(i), "1", g_szTabName1(i))
		next
	elseif szGrp == "2" then
		fmtab2.deleteAllPage()
		for i = 0 to #g_szTabArray2 - 1
			fmtab2.insertPage(fmtab2.tabcount, g_szTabArray2(i), g_szTabArray2(i), g_szTabFile2(i), "1", g_szTabName2(i))
		next
	elseif szGrp == "3" then
		fmtab3.deleteAllPage()
		for i = 0 to #g_szTabArray3 - 1
			fmtab3.insertPage(fmtab3.tabcount, g_szTabArray3(i), g_szTabArray3(i), g_szTabFile3(i), "1", g_szTabName3(i))
		next
	elseif szGrp == "4" then
		fmtab4.deleteAllPage()
		for i = 0 to #g_szTabArray4 - 1
			fmtab4.insertPage(fmtab4.tabcount, g_szTabArray4(i), g_szTabArray4(i), g_szTabFile4(i), "1", g_szTabName4(i))
		next
	elseif szGrp == "5" then
		fmtab5.deleteAllPage()
		for i = 0 to #g_szTabArray5 - 1
			fmtab5.insertPage(fmtab5.tabcount, g_szTabArray5(i), g_szTabArray5(i), g_szTabFile5(i), "1", g_szTabName5(i))
		next
	elseif szGrp == "6" then
		fmtab6.deleteAllPage()
		for i = 0 to #g_szTabArray6 - 1
			fmtab6.insertPage(fmtab6.tabcount, g_szTabArray6(i), g_szTabArray6(i), g_szTabFile6(i), "1", g_szTabName6(i))
		next
	elseif szGrp == "7" then
		fmtab7.deleteAllPage()
		for i = 0 to #g_szTabArray7 - 1
			fmtab7.insertPage(fmtab7.tabcount, g_szTabArray7(i), g_szTabArray7(i), g_szTabFile7(i), "1", g_szTabName7(i))
		next
	elseif szGrp == "8" then
		fmtab8.deleteAllPage()
		for i = 0 to #g_szTabArray8 - 1
			fmtab8.insertPage(fmtab8.tabcount, g_szTabArray8(i), g_szTabArray8(i), g_szTabFile8(i), "1", g_szTabName8(i))
		next
	end if
	
	if g_szOsType == "1" or (g_szOsType == "2" and g_szAppVer <> "" and CInt(g_szAppVer) >= 2534) then
		Select Case CInt(szGrp)
			Case 1
				fmtab1.SetUseAnimation("1")
			Case 2
				fmtab2.SetUseAnimation("1")
			Case 3
				fmtab3.SetUseAnimation("1")
			Case 4
				fmtab4.SetUseAnimation("1")
			Case 5
				fmtab5.SetUseAnimation("1")
			Case 6
				fmtab6.SetUseAnimation("1")
			Case 8	
				fmtab8.SetUseAnimation("1")
			Case Else	
				fmtab7.SetUseAnimation("1")
		End Select
	end if
End Function 


'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()	
	'20230203 HSZ START : 개별계좌 속성에 따라 폼탭 구성
	szIdxData = Form.GetSharedData("71052_Index", false )
	g_aryTabGrp = Split(szIdxData, "☆")
	if UBOUND(g_aryTabGrp) < 1 then
		Exit Sub
	End if	
	g_initFlag = "0"
	'20230203 HSZ END
	
	g_szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iO
	g_szAppVer	= Form.GetSharedData("&APP_VERSION", False)
	g_szAppVer	= Replace(g_szAppVer, ".", "")
	
	if g_szOsType == "2" then
		imgClose.SetHistoryBtnImage()
		Label0.SetTitleLabelPos()
	end if
	
	g_szExistYn = Form.LoadConfigData("mbact71052_p1", "SHOW_EXIST_ONLY_YN")
	if g_szExistYn == "" or g_szExistYn == null then
		g_szExistYn = "Y"
		
		Form.SaveConfigData("mbact71052_p1", "SHOW_EXIST_ONLY_YN", g_szExistYn)
	end if
	
	Dim szData

	g_szCmbAcnt = ""
	accList = ""

	szData = Form.GetOpenLinkData()
	
	g_szList = Split(szData, "☆")
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if		
	
'	'상단 콤보에 계좌 세팅
	g_accCount = CInt(g_szList(5))	
	accArray = Split(g_szList(6), "○")
	accArrayTxt = Split(g_szList(7), "○")
	for i=0 to g_accCount
		szKey = accArray(i)
		szTxt = accArrayTxt(i)
		accList = accList & "○" & left(accArray(i), 4).."-"..Mid(accArray(i),5, 4) 
		if szKey <> "" then
			cmb0.cbadddatatext = szKey.."`"..szTxt
		end if
	next
	
	
	if g_szList(2) = "t1" then 			'상품별 잔고탭
	
		cmb0.currentindex = 0			'20230203 HSZ
	
		g_nTabIndex = CInt(g_szList(0))
		if g_nTabIndex > 2 then
			if g_nTabIndex == 11 then	'신용/대출 눌러서 진입한 경우 - 20230203 HSZ 인덱스변경
				g_nTabIndex = 0
			else
				g_nTabIndex = Cint(g_nTabIndex)'+ 1
			end if
		end if
		
'		20230203 HSZ START : 개별계좌 속성에 따라 폼탭 구성
'		기존 소스 주석처리
'		fmtab0.currenttab = CInt(nTabIndex)
'		
'		if g_szList(3) = "전체" then
'			cmb0.currentindex = 0
'		else	
'			for j = 1 to g_accCount
'				if CStr(Left(accArray(j), 4).."-"..Mid(accArray(j),5, 4)) == g_szList(3) then
'					cmb0.currentindex = j
'					exit Sub
'				end if
'			next
'		end if

		g_szTabgrp = "7"
		TabUISetting(g_szTabgrp)
'		g_initFlag = "1"
'		20230203 HSZ END
		
	elseif g_szList(2) = "t2" then '개별계좌별 잔고탭

'		'20221110 HSZ START: 1차 추가개선 건 -> 20230203 HSZ 기존 소스 주석처리
''		nTabIndex = 0
'		nTabIndex = g_szList(0)
'		fmtab0.currenttabpageid = nTabIndex
'		'20221110 HSZ END

		for k = 1 to CInt(cmb0.rowcount)-1
			cmb0.currentindex = k
			szAccNum = cmb0.cbkeydata
			if szAccNum = g_szList(3) then
'				20230203 HSZ START : 개별계좌 속성에 따라 폼탭 구성
				cmb0.currentindex = k
				g_szTabgrp = g_aryTabGrp(k)		'20230116
				TabUISetting(g_szTabgrp)		'20230116
'				g_initFlag = "1"
'				20230203 HSZ END
				exit Sub
			end if
		next
	end if
	
End Sub

