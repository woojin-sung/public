'============================================================================
' fmtab1_OnTabChanged(nCurrentTab)
'============================================================================
Sub fmtab1_OnTabChanged(nCurrentTab)
	g_nTabIndex = nCurrentTab
	fmtab1.currenttab = nCurrentTab
	Call SetTrigger(g_nTabIndex)
	if g_szOsType == "1" or (g_szOsType == "2" and g_szAppVer <> "" and CInt(g_szAppVer) >= 2534) then
		fmtab1.SetUseAnimation("1")
	end if
End Sub
