	<SCRIPT_INFO _len="6124" _ulen="5622" >
--===========================================================================
--===========================================================================
Dim g_sAcc
Dim g_sAccSrNo
Dim g_sCode
Dim g_sLoadCode
Dim g_sLoadDate
Dim g_sLoadSrno
Dim g_sLoadQty 
Dim g_sLoadAmt 
Dim g_sAbleAmt
Dim g_sAbleQty
Dim g_sCodeName
Dim g_sApltQty
Dim g_sApltAmt 
Dim g_sLoadInt
Dim g_sLoadOvfe
Dim g_nCal

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("상환금액설정")
	
	g_nCal = 0	
	szData = Form.GetOpenLinkData()
	szList = Split(szData, "^")

	' 20163030 상환가능금액/수량 구분하여 적용
	if UBOUND(szList) > 1 then
		g_sAcc 		= szList[0]		' 계좌번호
		g_sAccSrNo 	= szList[1]		' 계좌일련번호(2)
		g_sCode   	= szList[2]		' 종목코드
		g_sLoadCode 	= szList[3]		' 대출코드
		g_sLoadDate 	= szList[4]		' 대출일자
		g_sLoadSrno 	= szList[5]		' 대출일련번호	
		g_sLoadQty	= szList[6]		' 대출잔량	
		g_sLoadAmt	= szList[7]		' 대출잔액	
		g_sAbleAmt	= szList[8]		' 상환가능금액
		g_sAbleQty	= szList[9]		' 상환가능수량
		g_sCodeName	= szList[10]		' 종목명 
		
		Table0.SetCellString( 0, 1, g_sCodeName )
		Table0.SetCellString( 1, 1, g_sLoadAmt )
		Table0.SetCellString( 2, 1, g_sLoadQty )
		
		RadioGroup0_OnClick(0)
		'Table0.SetCellString( 3, 1, g_sLoadAble )
	End if

End Sub


'============================================================================
Sub imgClose_OnClick()
	Form.SendReturnToParent("LOANSET_CANCLE", sData)
	Form.CloseForm( )
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.SendReturnToParent("LOANSET_CANCLE", sData)
	Form.CloseForm( )
End Sub

'============================================================================
Sub btnCal_OnClick()
	if Len(edtMoneyQty.caption) <= 0 then
		if RadioGroup0.currentindex == "0" then'금액
			Form.ShowAlert( "알림", "입력한 금액이 없습니다." )
			Exit Sub
		else
			Form.ShowAlert( "알림", "입력한 수량이 없습니다."  )
			Exit Sub
		end if
	else
				
		if RadioGroup0.currentindex == "0" then'금액
			if CDbl(g_sLoadAmt) < CDbl(edtMoneyQty.caption) then
				Form.ShowAlert( "알림", "입력한 금액이 대출 잔액보다 큽니다." )
				Exit Sub
			end if	
			
			if CDbl(g_sAbleAmt) < CDbl(edtMoneyQty.caption) then
				Form.ShowAlert( "알림", "상환가능 금액을 초과하였습니다." )
				Exit Sub
			end if	
		else 
			if CDbl(g_sLoadQty) < CDbl(edtMoneyQty.caption) then
				Form.ShowAlert( "알림", "입력한 수량이  대출 잔량보다 큽니다."  )
				Exit Sub
			end if
			
			if CDbl(g_sAbleQty) < CDbl(edtMoneyQty.caption) then
				Form.ShowAlert( "알림", "상환가능 수량을 초과하였습니다." )
				Exit Sub
			end if
		end if			
	end if
	
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851c", "InBlock1", "ACNO" , 0 , g_sAcc) '계좌번호
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851c", "InBlock1", "ASNO" , 0 , g_sAccSrNo)
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851c", "InBlock1", "ISCD" , 0 , g_sCode)'종목코드
	
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851c", "InBlock1", "LOAN_DTL_TYPE_CODE" , 0 , g_sLoadCode) '대출코드
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851c", "InBlock1", "LOAN_DATE" , 0 , g_sLoadDate)	'대출일자
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851c", "InBlock1", "LOAN_SRNO" , 0 , g_sLoadSrno)'대출일련번호
	
	if RadioGroup0.currentindex == "0" then'금액
		DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851c", "InBlock1", "APLT_QTY" , 0 , "")'신청수량
		DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851c", "InBlock1", "APLT_AMT" , 0 , edtMoneyQty.caption)'신청금액
	else
		DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851c", "InBlock1", "APLT_QTY" , 0 , edtMoneyQty.caption)'신청수량
		DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851c", "InBlock1", "APLT_AMT" , 0 , "")'신청금액	
	end if
	
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851c", "InBlock1", "PROS_CLS" , 0 , "2")'
	
	DATAMANAGER.RequestTranData( "oblon_rdmp_851c" )
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "oblon_rdmp_851c" then
		g_sApltQty = DATAMANAGER.GetDataValue( 0, "oblon_rdmp_851c", "OutBlock1", "APLT_QTY" , 0 )
		g_sApltAmt = DATAMANAGER.GetDataValue( 0, "oblon_rdmp_851c", "OutBlock1", "APLT_AMT" , 0 )
		g_sLoadInt = DATAMANAGER.GetDataValue( 0, "oblon_rdmp_851c", "OutBlock1", "LOAN_INT" , 0 )
		g_sLoadOvfe = DATAMANAGER.GetDataValue( 0,"oblon_rdmp_851c", "OutBlock1", "LOAN_OVFE" , 0 )
		
		sTotal = CDbl(g_sApltAmt) + CDbl(g_sLoadInt)  + CDbl(g_sLoadOvfe)
		
		Table1.SetCellString( 4, 1, sTotal )
		g_nCal = 1
	end if
End Sub

'============================================================================
Sub btnSave_OnClick()
	if g_nCal == 0 then
		Form.ShowAlert( "알림", "상환금액 계산을 하지 않았습니다."  )
		Exit Sub
	end if
	sData = g_sApltQty & "^" & g_sApltAmt & "^" & g_sLoadInt & "^" & g_sLoadOvfe
	Form.SendReturnToParent("LOANSET", sData)
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "oblon_rdmp_851c" then
		Form.Toast( 0, szErrMsg, 0 )
	end if
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	g_nCal = 0
	edtMoneyQty.caption = ""
	Table1.SetCellString( 0, 1, "" )
	Table1.SetCellString( 1, 1, "" )
	Table1.SetCellString( 2, 1, "" )
	Table1.SetCellString( 3, 1, "" )
	Table1.SetCellString( 4, 1, "" )
	
	' 20163030 상환가능금액/수량 구분하여 적용
	if nIndex == 0 then
		lblGigun.caption = "금액"
		Table0.SetCellString( 3, 0, "상환가능금액" )
		Table0.SetCellString( 3, 1, g_sAbleAmt)
	else
		lblGigun.caption = "수량"
		Table0.SetCellString( 3, 0, "상환가능수량" )
		Table0.SetCellString( 3, 1, g_sAbleQty )
	end if
End Sub

	</SCRIPT_INFO>
