	<SCRIPT_INFO _len="4944" _ulen="4836" >
Dim g_sTitle_CellID 
g_sTitle_CellID = "bd_cell0"

Dim g_sDateInfo_CellID 
g_sDateInfo_CellID = "bd_cell1"

Dim g_sMkCode_CellID 
g_sMkCode_CellID = "bd_cell5"

Dim g_sPushLinkType_CellID 
g_sPushLinkType_CellID = "bd_cell3"

Dim g_sPushLink_CellID 
g_sPushLink_CellID = "bd_cell9"

Dim g_sBtnName_CellID 
g_sBtnName_CellID = "bd_cell12"

Dim g_sBtnLinkType_CellID 
g_sBtnLinkType_CellID = "bd_cell15"

Dim g_sBtnLink_CellID 
g_sBtnLink_CellID = "bd_cell18"

Dim g_sContents_CellID 
g_sContents_CellID = "bd_cell11"
'============================================================================
Sub Form_OnFormInit()
	Label0.setNeighborCtlPos("Image0", "left", 5)
	
	SetGridData()
	
	Grid0.SetCellMaxLineCount("bd_cell0", 2)
End Sub

Sub SetGridData()
	
	Grid0.rowcount = "0"

	szPushData = Form.GetPushMarketingMessage("ALL")
	if szPushData	= NULL	or	 Len(szPushData) == 0 then
		Exit Sub
	end if
	
	listPush =  Split(szPushData, "`SEPARATOR`")
	
	nCnt = #listPush

	for i = 0 to nCnt-1 
		sPush = listPush[i]
		if Trim(sPush) == "" then
			Exit Sub
		end if	

		pushItem = Split(sPush, "^SEPARATOR^")
				
		szMessageSeq = ""
		szMessageType = ""
		szItemCode = ""
		szMessageTime = ""
		szMessageData = ""		
		
		ndata = #pushItem
		
		szMessageSeq = pushItem[0]
		if #pushItem >= 2 then
			szMessageType = pushItem[1]
			if #pushItem >= 3 then
				szItemCode = pushItem[2]
				if #pushItem >= 4 then
					szMessageTime = pushItem[3]
					if #pushItem >= 5 then
						szMessageData = pushItem[4]
					end if
				end if
			end if
		end if
		
		Grid0.AddRow()
		
		
		if #pushItem >= 6 then
			Grid0.SetCellData(g_sContents_CellID, i, pushItem[5])
		end if
		
		if #pushItem >= 7 then
			Grid0.SetCellData(g_sPushLinkType_CellID, i, pushItem[6])
		end if
		
		if #pushItem >= 8 then
			Grid0.SetCellData(g_sPushLink_CellID, i, pushItem[7])
		end if
		
		if #pushItem >= 9 then
			Grid0.SetCellData(g_sBtnName_CellID, i, pushItem[8])
		end if
			
		if #pushItem >= 10 then
			Grid0.SetCellData(g_sBtnLinkType_CellID, i, pushItem[9])
		end if
		
		if #pushItem >= 11 then
			Grid0.SetCellData(g_sBtnLink_CellID, i, pushItem[10])
		end if
		
		Grid0.SetCellData(g_sMkCode_CellID, i, szItemCode)
		
		Grid0.SetCellData(g_sTitle_CellID, i, szMessageData)

		szYear 	= Left(szMessageTime, 4)
		szMonth 	= Mid(szMessageTime, 5, 2)
		szDate 	= Mid(szMessageTime, 7, 2)
		szHour 	= Mid(szMessageTime, 9, 2)
		szMinute = Mid(szMessageTime, 11, 2)
		szSecond = Mid(szMessageTime, 13, 2)
		
		Grid0.SetCellData(g_sDateInfo_CellID, i, szMessageTime)
		Grid0.SetCellData("bd_cell7", i, "상세보기 >")
	next
	
	Grid0.toprow = "0"
	
End Sub
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	sPushLinkType = Grid0.GetCellData(g_sPushLinkType_CellID, lRow)
	
	if sPushLinkType == "0" then
		sPushLink = Grid0.GetCellData(g_sPushLink_CellID, lRow)
		
		openLinkData = ""
		if sPushLink = "88062" then
			openLinkData = "88062"
		end if
		
		if sPushLink <> null and sPushLink <> "" then
			Form.OpenScreen(sPushLink , openLinkData)
		end if
	
	elseif sPushLinkType == "1" then
		sPushLink = Grid0.GetCellData(g_sPushLink_CellID, lRow)
		if sPushLink <> null and sPushLink <> "" then
			Form.openExternalBrowser(sPushLink)
		end if
	
	elseif sPushLinkType == "2" then
		sTitle 		= Grid0.GetCellData(g_sTitle_CellID, lRow)
		sDateInfo	= Grid0.GetCellData(g_sDateInfo_CellID, lRow)
		sContents	= Grid0.GetCellData(g_sContents_CellID, lRow)
		sMkCode 		= Grid0.GetCellData(g_sMkCode_CellID, lRow)
		sBtnName		= Grid0.GetCellData(g_sBtnName_CellID, lRow)
		sBtnLinkType 	= Grid0.GetCellData(g_sBtnLinkType_CellID, lRow)
		sBtnLink		= Grid0.GetCellData(g_sBtnLink_CellID, lRow)
		
		if sMkCode = null or sMkCode = "" then
			exit sub
		end if
		
		if sContents = null then
			sContents = ""
		end if 
		
		if sBtnName = null then
			sBtnName = ""
		end if
		
		if sBtnLinkType = null then
			sBtnLinkType = ""
		end if
		
		if sBtnLink = null then
			sBtnLink = ""
		end if
		
		Form.OpenPopup("usernotice_p5" , sTitle & "^SEPARATOR^" &  sDateInfo & "^SEPARATOR^" &  sContents & "^SEPARATOR^" & sMkCode & "^SEPARATOR^" & sBtnName & "^SEPARATOR^" & sBtnLinkType & "^SEPARATOR^" & sBtnLink, "")
		
	end if
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "RECEIVE_PUSH" then
		SetGridData()
	end if	
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Button0_OnClick()
	sText = "메리츠증권은 영리목적 광고성 정보의 앱푸시 전송 시 정보통신망법상 의무를 준수하고 있습니다.\n문의사항 고객지원센터 1588-3400"
	Image0.openToolTip(sText,310,110,2)
End Sub

