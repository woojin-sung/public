'============================================================================
Sub Form_OnFormInit()
	cont0.grd0.SetCellData("bd_cell0", 0, "잔고평가금액") '(v002) 표시 항목 변경
	cont0.grd0.SetCellData("bd_cell2", 0, "평가손익")       '(v002) 표시 항목 변경
	cont0.grd0.SetCellData("bd_cell4", 0, "수익률")          '(v002) 표시 항목 변경
	cont0.grd0.SetCellData("bd_cell6", 0, "매입금액")       '(v002) 표시 항목 변경
	cont0.grd0.SetCellData("bd_cell9", 0, "기간손익")       '(v002) 표시 항목 변경
	'cont0.grd0.SetCellData("bd_cell0", 0, "원화/외화 예수금 합")   '(v002) 표시 항목 변경
	'cont0.grd0.SetCellData("bd_cell2", 0, "-  원화예수금")            '(v002) 표시 항목 변경
	'cont0.grd0.SetCellData("bd_cell4", 0, "-  외화예수금")            '(v002) 표시 항목 변경
	'cont0.grd0.SetCellData("bd_cell5", 0, "당일손익(￦)")             '(v002) 표시 항목 변경
	'cont0.grd0.SetCellData("bd_cell6", 0, "누적손익(￦)          >") '(v002) 표시 항목 변경
	
	cont0.grd0.setUseCardView(true, 10, "img_bgbox_gray.9")
	cont0.btn0.SetApplySwitch(" ", " ", 269, 261, 286, 67) '(v003) 비용포함여부 저장 방식 변경
	
	cont0.FormTab1.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 3) '활성화/비활성화/여백
	cont0.FormTab1.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	
	cont0.FormTab1.insertPage( cont0.FormTab1.tabcount, "page1", "page1", "empty", "0", "원화")
	cont0.FormTab1.insertPage( cont0.FormTab1.tabcount, "page2", "page2", "empty", "0", "외화")
	
	cont0.FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 10) '활성화/비활성화/여백
	cont0.FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	
	cont0.FormTab0.insertPage( cont0.FormTab0.tabcount, "page1", "page1", "empty", "0", "최초매입기준")
	cont0.FormTab0.insertPage( cont0.FormTab0.tabcount, "page2", "page2", "empty", "0", "월정산기준")
	
	'cont0.FormTab0.currenttab = 0
	
	szTab   = Trim(Form.LoadConfigData( "mbtre11000_t1", "search" ))	'최초매입/월정산기준
	szRdo   = Trim(Form.LoadConfigData( "mbtre11000_t1", "crcd" ))	'원화/외화
	szCost  = Trim(Form.LoadConfigData( "mbtre11000_t1", "cost" ))	'비용포함여부
		
	if szTab = "" then
		cont0.FormTab0.currenttab = 0
	else
		cont0.FormTab0.currenttab = CInt(szTab)
	end if
		
	if szRdo = "" then
		cont0.FormTab1.currenttab = 0
	else
		cont0.FormTab1.currenttab = CInt(szRdo)
	end if
	
	'(v003) 비용포함여부 저장 방식 변경
	if szCost = "" then
		cont0.btn0.switchindex = 0
	else
		cont0.btn0.switchindex = CInt(szCost)
	end if
	
	'(v003) 주석 처리
	'if szCost = "" or szCost = "0" then
	'	g_btnCost = false
	'else
	'	g_btnCost = true
	'end if
	
	cont0.grd0.scrollenable = "0"
	cont0.setScrollBarVisible("0") 
	
	'안드로이드 폴드 디스플레이 가로가 넓어 
	'이미지 위치 벌어지는 현상 개선
	cont0.lblExRate.setNeighborCtlPos("lblExRate1", "left", 45, "")
	'cont0.lblOpen0.setNeighborCtlPos("Image1", "right", 5, "")
End Sub

'============================================================================
Function lblVisible()
	if CInt(cont0.grd1.rowcount) = 0 then
		cont0.grd1.left = 1000
		cont0.lblNone.visible = true
	else
		cont0.grd1.left = 10
		cont0.lblNone.visible = false
	end if
End Function

'============================================================================
'CFD 잔고 그리드 OnClickUp 시 OpenPopupAnimation
'============================================================================
Sub cont0_grd1_OnClickUp(lRow, szCellID)
	Dim szSendData
	Dim szData1, szData2, szData3, szData4, szData5, szData6, szData7, szData8, szData9, szData10
	
	szData1  = "|  "..cont0.grd1.GetCellData("bd_cell1", lRow)		'종목명
	szData2  = cont0.grd1.GetCellData("bd_cell5", lRow)			'평가금액
	szData3  = cont0.grd1.GetCellData("bd_cell17", lRow)			'매입금액
	szData4  = cont0.grd1.GetCellData("bd_cell6", lRow)			'평가손익
	szData5  = cont0.grd1.GetCellData("bd_cell7", lRow)			'수익률
	szData6  = cont0.grd1.GetCellData("bd_cell2", lRow)			'잔고구분
	szData7  = cont0.grd1.GetCellData("bd_cell9", lRow)			'증거금율
	szData8  = cont0.grd1.GetCellData("bd_cell3", lRow)			'체결잔고
	szData9  = cont0.grd1.GetCellData("bd_cell10", lRow)			'매입단가
	szData10 = cont0.grd1.GetCellData("bd_cell11", lRow)			'종목코드
	
	szSendData = szData1 & "☆" & szData2 & "☆" & szData3 & "☆" & szData4 & "☆" & szData5 & "☆" & szData6 & "☆" & szData7 & "☆" & szData8 & "☆" & szData9 & "☆" & szData10
	
'	Form.ShowAlert("szSendData", szSendData)
	
	'20230405 SWJ START : Null 체크 추가
	if g_szAcc == "" or g_szAcc == null then
		exit sub
	end if
	'20230405 SWJ END
	
	Form.OpenPopupAnimation("mbtre11000_p3", szSendData, "", "2")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	szCsno = Form.GetSharedData("&CUST_NUM", false )
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
	szStnd = CInt(cont0.FormTab0.currenttab) + 1			'1:월정산평가월 2:월정산결제월
	szDate = Form.GetSharedData("&HOST_DATE", False )
	szBtn = cont0.btn0.switchindex '(v003) 비용포함여부 저장 방식 변경
	
	'외화
	if cont0.FormTab1.currenttab == 1 or cont0.FormTab1.currenttab == "1" then
		szFrcrYN = "Y"
	else
		szFrcrYN = "N"
	end if
	
'	if szTranID = "obacb_balc_154r" then
'		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ACNO"		  , 0 , szACNO	)
'		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASNO"		  , 0 , szASNO	)
'		
'		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASET_CLS_CODE" , 0 , "03")
'
'	else
'		DATAMANAGER.SetDataValue( 0 , "obtrc_rmnd_004r", "InBlock1", "ACNO" , 0 , szACNO	)           '계좌번호
'		DATAMANAGER.SetDataValue( 0 , "obtrc_rmnd_004r", "InBlock1", "ASNO" , 0 , szASNO	)           '계좌번호
'		DATAMANAGER.SetDataValue( 0 , "obtrc_rmnd_004r", "InBlock1", "STND_DATE" , 0 , szDate )         '날짜
'		DATAMANAGER.SetDataValue( 0 , "obtrc_rmnd_004r", "InBlock1", "IQRY_CLS_CODE" , 0 , szStnd )  '조회구분
'	end if

	if szTranID = "obtre_comm_201r" then		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 		    , 0 , szACNO	  )  '계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" 		    , 0 , szASNO	  )  '계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FRCR_YN"            , 0 , szFrcrYN   )  '외화여부
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , szStnd	  )  '(v002) 최초매입/월정산 (1/2)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "UI_IQRY_CLS"       , 0 , szBtn  )  '(v002) 비용미포함/비용포함 (0/1), (v003) 비용포함여부 저장 방식 변경
		'DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "UI_IQRY_CLS"       , 0 , g_btnCost  )  '(v002) 비용미포함/비용포함 (0/1), (v003) 주석 처리
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "DYTM_TR_CLPR_APLY_YN" , 0 , g_szDytmYN )  '(v002) 주간거래시세적용여부 (Y/N)
	elseif szTranID = "obtre_comm_202r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO"                 , 0 , szACNO    )  '계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO"                 , 0 , szASNO    )  '계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , szStnd	   )  '최초매입/월정산 (1/2)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "UI_IQRY_CLS"       , 0 , szBtn  )  '비용미포함/비용포함 (0/1), (v003) 비용포함여부 저장 방식 변경
		'DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "UI_IQRY_CLS"       , 0 , g_btnCost  )  '비용미포함/비용포함 (0/1), (v003) 주석 처리
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FRCR_YN"            , 0 , szFrcrYN   )  '외화여부
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "DYTM_TR_CLPR_APLY_YN" , 0 , g_szDytmYN )  '(v002) 주간거래시세적용여부 (Y/N)
	elseif szTranID == "obtre_comm_004r" then '(v002) 해외CFD 계좌 상태 조회
