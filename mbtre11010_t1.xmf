'============================================================================
Sub cont0_FormTab0_OnTabChanged(nCurrentTab)
	Form.SaveConfigData("mbtre11000_t1", "search", cont0.FormTab0.currenttab) '조회기준 값 저장, (v001) 위치 변경

	VltnAmt_Request()	
End Sub

'============================================================================
Sub cont0_FormTab1_OnTabChanged(nCurrentTab)
	Form.SaveConfigData("mbtre11000_t1", "crcd"  , cont0.FormTab1.currenttab) '원화/외화 저장, (v001) 위치 변경

	VltnAmt_Request()	
End Sub

'============================================================================
Sub cont0_btn0_OnClick()		
	'(v003) 주석 처리
	''비용 포함일 때 
	''Data request 후 플래그 바꿔주기
	'if g_btnCost then
	'	g_btnCost = false
	''비용 미포함일 때 
	'else
	'	g_btnCost = true
	'end if	
	
	Form.SaveConfigData("mbtre11000_t1", "cost"  , cont0.btn0.switchindex) '비용포함여부 저장, (v003) 비용포함여부 저장 방식 변경
	'Form.SaveConfigData("mbtre11000_t1", "cost"  , g_btnCost) '비용포함여부 저장, (v003) 주석 처리
	
	VltnAmt_Request()	
End Sub

'============================================================================
'(v002) ChkButton0_OnChange()
'============================================================================
Sub cont0_ChkButton0_OnChange(sCheckState)
	'(v002) 해외CFD 주간 거래 대상인 경우, 주간거래여부 선택에 따라 값 변경
	if g_szDytmTrgtYN == "Y" then
	        if sCheckState == 1 or sCheckState == "1" then
	                g_szDytmYN = "Y"
	        else
	                g_szDytmYN = "N"
	        end if
	else
	        g_szDytmYN = "N"
	end if

	VltnAmt_Request()
End Sub

'============================================================================
'기간별 수익률 팝업 화면
'============================================================================
Sub cont0_grd0_OnClickUp(lRow, szCellID)
	if szCellID = "bd_cell9" then	'누적손익 팝업, (v002) 기간손익 버튼 클릭 시 기간별수익률 팝업
                Dim szData
	        Dim AcntTotAmt  '계좌평가금액
		
		szACNO = Form.GetCtlProp("#acnt0", "total")
		szASNO = Form.GetCtlProp("#acnt0", "sequence")
				
		'계좌평가금액 구하기(원화기준)

		'case:외화
		if cont0.FormTab1.currenttab == 1 or cont0.FormTab1.currenttab == "1" then
		        AcntTotAmt = CDbl( lblAmt.caption ) * STND_EXRT          ' 계좌평가금액 = 외화 * 환율
		'case:원화
		else
		        AcntTotAmt = CDbl( lblAmt.caption )                               ' 계좌평가금액
		end if		
		
		szData = szACNO & "|" & szASNO & "|" & CDbl( AcntTotAmt )  ' 계좌평가금액
				
		'기간별수익률 팝업 화면
		Form.OpenFramePopup( "mbtrs15000_p1" , szData , "")
	'elseif  szCellID = "" then    '(v002) 잔고평가금액 클릭 시 계좌평가금액 상세 팝업, 주석 처리
	'        Dim szSendData
	'        Dim szinfo0, szinfo1, szinfo2, szinfo3, szinfo4, szinfo5
	'
	'        szinfo0 = grd2.GetCellData("bd_cell0", 0)
	'        szinfo1 = grd2.GetCellData("bd_cell1", 0)
	'        szinfo2 = grd2.GetCellData("bd_cell2", 0)
	'        szinfo3 = grd2.GetCellData("bd_cell3", 0)
	'        szinfo4 = grd2.GetCellData("bd_cell4", 0) & "@" & g_PopColor
	'        szinfo5 = grd2.GetCellData("bd_cell5", 0) & "@" & g_PopColor2
	'
	'        szSendData = szinfo0 & "☆" & szinfo1 & "☆" & szinfo2 & "☆" & szinfo3  & "☆" & szinfo4  & "☆" & szinfo5 & "☆" & g_decimal
	'
	'        '20230405 SWJ START : Null 체크 추가
	'        if g_szAcc == "" or g_szAcc == null then
	'	        szSendData = ""
	'        end if
	'        '20230405 SWJ END
	'
	'        Form.OpenPopupAnimation("mbtre11000_p2", szSendData, "", "2")
	end if
End Sub

'============================================================================
'f_SetExMask : 환율 라벨 소수점 자리수 SET
'============================================================================
Function f_SetGrdMask()
	Dim szType
	szType = Trim(Form.GetCtlProp("#lblAcntNation", "caption"))
	
	cont0.lblExRate.caption = ""
	
	if szType == "392" then '일본은 소수점 4자리 표시
		cont0.lblExRate.mask = "0,0,,,0,,4,1,0,0,0"
	else
		cont0.lblExRate.mask = "0,0,,,0,,2,1,0,0,0"
	end if
End Function

'============================================================================
'(v002) 해외CFD 계좌 상태 조회
'============================================================================
Function f_RequestAcntStateTR()
	DATAMANAGER.RequestTranData( "obtre_comm_004r" )
End Function

