'============================================================================
'VltnAmt_Request() 와 Balance_Request() 분리한 이유
'Balance_Request() 는 계좌바뀌었을 때만 사용할 것
'(처음 화면 오픈 시 동 서비스를 여러번 태우게 되어서)
'============================================================================
Function VltnAmt_Request()		'잔고 조회

	'20230405 SWJ START : Null 체크 추가
	if g_szAcc == "" or g_szAcc == null then
		exit Function
	end if
	'20230405 SWJ END
	
	cont0.grd1.rowcount = 0
	cont0.grd1.SetClear()
	g_nNextCount = 0
	
	DATAMANAGER.RequestTranData( "obtre_comm_201r" )
	
	'(v002) 주석 처리
	'외화 조회 시에만 누적손익 원화 값이 추가로 필요하므로 이때만 2번 조회
	'if cont0.FormTab1.currenttab = "1" or cont0.FormTab1.currenttab = 1 then
	'	DATAMANAGER.RequestTranData( "obtre_comm_201r_1" )
	'end if
End Function

'============================================================================
Function Balance_Request()		'잔고 조회
	
	'20230405 SWJ START : Null 체크 추가
	if g_szAcc == "" or g_szAcc == null then
		exit Function
	end if
	'20230405 SWJ END
	
	cont0.grd1.rowcount = 0
	cont0.grd1.SetClear()
	g_nNextCount = 0

        f_RequestAcntStateTR()  '(v002) 해외CFD 계좌 상태 조회

	'DATAMANAGER.RequestTranData( "obtre_comm_201r" )  '(v002) 위치 이동
	
	'(v002) 주석 처리
	'외화 조회 시에만 누적손익 원화 값이 추가로 필요하므로 이때만 2번 조회
	'if cont0.FormTab1.currenttab = "1" or cont0.FormTab1.currenttab = 1 then
	'	DATAMANAGER.RequestTranData( "obtre_comm_201r_1" )
	'end if
		
End Function
