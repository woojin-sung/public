'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "CHANGE_ACCTNO" then
		'Init_TR()
	elseif sEventName == "CHANGE_ACCTINFO" then
		g_AcctInfo = sParam
		
		g_szAcc = Form.GetCtlProp("#acnt0", "total")	'20230405 SWJ START
		
		f_SetGrdMask()
		
		Balance_Request()
		
		'DATAMANAGER.RequestTranData("obtre_comm_201r")
	elseif sEventName == "RECEIVE" then
		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp0, szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp11, TempCount
	
	if szTranID == "obtre_comm_201r" then
		
		g_CRCD                      = DATAMANAGER.GetDataValue( 0 , "obtre_comm_201r", "OutBlock1", "CRCD" , 0)                          '통화코드
		ACNT_VLTN_AMT        = DATAMANAGER.GetDataValue( 0 , "obtre_comm_201r", "OutBlock1", "ACNT_VLTN_AMT" , 0)        '계좌평가금액
		TFAM		          = DATAMANAGER.GetDataValue( 0 , "obtre_comm_201r", "OutBlock1", "CFD_TFAM", 0)                   '예수금
		FRCR_TFAM                = DATAMANAGER.GetDataValue( 0 , "obtre_comm_201r", "OutBlock1", "CFD_FRCR_TFAM", 0)          '외화예수금
		CFD_TFAM                  = DATAMANAGER.GetDataValue( 0 , "obtre_comm_201r", "OutBlock1", "CFD_WNCR_TFAM", 0)         '원화예수금
		CFD_OTST_AMT          = DATAMANAGER.GetDataValue( 0 , "obtre_comm_201r", "OutBlock1", "CFD_OTST_AMT", 0)           '결제예정금액
		UNAM                         = DATAMANAGER.GetDataValue( 0 , "obtre_comm_201r", "OutBlock1", "UNAM", 0)                          '미수금
		CFD_VLTN_PRLS_AMT = DATAMANAGER.GetDataValue( 0 , "obtre_comm_201r", "OutBlock1", "CFD_VLTN_PRLS_AMT", 0)  '평가손익
		CFD_NTPL_AMT          = DATAMANAGER.GetDataValue( 0 , "obtre_comm_201r", "OutBlock1", "CFD_NTPL_AMT", 0)           '최초매입기준 평가손익
		RMND_VLTN_AMT       = DATAMANAGER.GetDataValue( 0 , "obtre_comm_201r", "OutBlock1", "RMND_VLTN_AMT" , 0)        '(v002) 잔고평가금액
		CFD_ACBK_AMT          = DATAMANAGER.GetDataValue( 0 , "obtre_comm_201r", "OutBlock1", "CFD_ACBK_AMT", 0)           '(v002) 매입금액
		ERT                            = DATAMANAGER.GetDataValue( 0 , "obtre_comm_201r", "OutBlock1", "ERT", 0)                             '(v002) 수익률
		
		STND_EXRT                = DATAMANAGER.GetDataValue( 0 , "obtre_comm_201r", "OutBlock1", "STND_EXRT", 0)                 '기준환율
		
		g_CRCD = " " & g_CRCD
		
		'원화
		if cont0.FormTab1.currenttab = "0" or  cont0.FormTab1.currenttab = 0 then		
			g_decimal = 0
			g_szCurr = "원"
		'외화
		else
			g_decimal = 2
			g_szCurr = g_CRCD
		end if
		
		sMask = "1,0,,,0,,"..g_decimal..",1,1,2,0"	
		'cont0.LblTotal.mask = sMask '(v002) 주석 처리
		
		cont0.grd0.SetCellIDMaskInfo("bd_cell1", sMask)
		cont0.grd0.SetCellIDMaskInfo("bd_cell3", "1,0,,,0,,2,1,1,2,0")
		cont0.grd0.SetCellIDMaskInfo("bd_cell7", "1,0,,,0,,0,1,1,2,0")
		'cont0.grd0.SetCellIDMaskInfo("bd_cell9", "1,0,,,0,,2,1,1,2,0")  '(v002) 주석 처리
		
		cont0.grd0.SetCellData("bd_cell1", 0, FormatNumber(RMND_VLTN_AMT, g_decimal) & g_szCurr)         '(v002) 잔고평가금액
		cont0.grd0.SetCellData("bd_cell3", 0, FormatNumber(CFD_VLTN_PRLS_AMT, g_decimal) & g_szCurr)  '(v002) 평가손익
		cont0.grd0.SetCellData("bd_cell5", 0, FormatNumber(ERT, 2) & "%")                                                  '(v002) 수익률
		cont0.grd0.SetCellData("bd_cell7", 0, FormatNumber(CFD_ACBK_AMT, g_decimal) & g_szCurr)           '(v002) 매입금액
		
		'(v002) 평가손익 손익 현황에 따른 색깔 처리
		if CDbl(CFD_VLTN_PRLS_AMT) > 0 then
			cont0.grd0.SetCellData("bd_cell3", 0 , FormatNumber(CFD_VLTN_PRLS_AMT, g_decimal) & g_szCurr)
			g_PopColor = "10"
			cont0.grd0.SetCellFgColor("bd_cell3", 0, g_PopColor)
		elseif CDbl(CFD_VLTN_PRLS_AMT) < 0 then
			cont0.grd0.SetCellData("bd_cell3", 0 , FormatNumber(CFD_VLTN_PRLS_AMT, g_decimal)& g_szCurr)
			g_PopColor = "11"
			cont0.grd0.SetCellFgColor("bd_cell3", 0, g_PopColor)
		else
			cont0.grd0.SetCellData("bd_cell3", 0 , FormatNumber(CFD_VLTN_PRLS_AMT, g_decimal)& g_szCurr)
			g_PopColor = "12"
			cont0.grd0.SetCellFgColor("bd_cell3", 0, g_PopColor)
		end if	
		
		'(v002) 수익률 손익 현황에 따른 색깔 처리
		if CDbl(ERT) > 0 then
			cont0.grd0.SetCellData("bd_cell5", 0 , FormatNumber(ERT, 2) & "%")
			g_PopColor = "10"
			cont0.grd0.SetCellFgColor("bd_cell5", 0, g_PopColor)
		elseif CDbl(ERT) < 0 then
			cont0.grd0.SetCellData("bd_cell5", 0 , FormatNumber(ERT, 2) & "%")
			g_PopColor = "11"
			cont0.grd0.SetCellFgColor("bd_cell5", 0, g_PopColor)
		else
			cont0.grd0.SetCellData("bd_cell5", 0 , FormatNumber(ERT, 2) & "%")
			g_PopColor = "12"
			cont0.grd0.SetCellFgColor("bd_cell5", 0, g_PopColor)
		end if	
		
		'cont0.grd0.SetCellData("bd_cell1", 0, FormatNumber(TFAM, g_decimal) & g_szCurr) '(v002) 주석 처리
		'cont0.grd0.SetCellData("bd_cell3", 0, FormatNumber(CFD_TFAM, 0) & "원")              '(v002) 주석 처리
		'cont0.grd0.SetCellData("bd_cell7", 0, FormatNumber(FRCR_TFAM, 2) & g_CRCD)     '(v002) 주석 처리
		'cont0.grd0.SetCellData("bd_cell9", 0, "실적파트 서비스" & "원")
		
		grd2.SetCellIDMaskInfo("bd_cell0", sMask)
		grd2.SetCellIDMaskInfo("bd_cell1", sMask)
		grd2.SetCellIDMaskInfo("bd_cell2", sMask)
		grd2.SetCellIDMaskInfo("bd_cell3", sMask)
		grd2.SetCellIDMaskInfo("bd_cell4", sMask)
		grd2.SetCellIDMaskInfo("bd_cell5", sMask)
		
		'if Cdbl(ACNT_VLTN_AMT) > 0 then                '(v002) 주석 처리
			'cont0.LblTotal.mask =  "1,0,,,0,,2,1,1,2,0"  '(v002) 주석 처리
'			cont0.LblTotal.fgcolor = "1"
			'cont0.LblTotal.caption = FormatNumber(ACNT_VLTN_AMT, g_decimal) & g_szCurr '(v002) 주석 처리
		'elseif Cdbl(ACNT_VLTN_AMT) < 0 then                                                                       '(v002) 주석 처리
'			cont0.LblTotal.fgcolor = "2"
			'cont0.LblTotal.caption = FormatNumber(ACNT_VLTN_AMT, g_decimal) & g_szCurr '(v002) 주석 처리
		'else                                                                                                                         '(v002) 주석 처리
'			cont0.LblTotal.fgcolor = "3"
			'cont0.LblTotal.caption = FormatNumber(ACNT_VLTN_AMT, g_decimal) & g_szCurr '(v002) 주석 처리
		'end if                                                                                                                       '(v002) 주석 처리
		
		if CDbl(CFD_VLTN_PRLS_AMT) > 0 then
			grd2.SetCellData("bd_cell4", 0 , FormatNumber(CFD_VLTN_PRLS_AMT, g_decimal) & g_szCurr)
			g_PopColor = "10"
			grd2.SetCellFgColor("bd_cell4", 0, g_PopColor)
		elseif CDbl(CFD_VLTN_PRLS_AMT) < 0 then
			grd2.SetCellData("bd_cell4", 0 , FormatNumber(CFD_VLTN_PRLS_AMT, g_decimal)& g_szCurr)
			g_PopColor = "11"
			grd2.SetCellFgColor("bd_cell4", 0, g_PopColor)
		else
			grd2.SetCellData("bd_cell4", 0 , FormatNumber(CFD_VLTN_PRLS_AMT, g_decimal)& g_szCurr)
			g_PopColor = "12"
			grd2.SetCellFgColor("bd_cell4", 0, g_PopColor)  '(v002) 색깔 처리
		end if	
		
		if CDbl(CFD_NTPL_AMT) > 0 then
			grd2.SetCellData("bd_cell5", 0 , FormatNumber(CFD_NTPL_AMT, g_decimal) & g_szCurr)
			g_PopColor2 = "10"
			grd2.SetCellFgColor("bd_cell5", 0, g_PopColor2)
		elseif CDbl(CFD_NTPL_AMT) < 0 then
			grd2.SetCellData("bd_cell5", 0 , FormatNumber(CFD_NTPL_AMT, g_decimal)& g_szCurr)
			g_PopColor2 = "11"
			grd2.SetCellFgColor("bd_cell5", 0, g_PopColor2)
		else
			grd2.SetCellData("bd_cell5", 0 , FormatNumber(CFD_NTPL_AMT, g_decimal)& g_szCurr)
			g_PopColor2 = "12"
			grd2.SetCellFgColor("bd_cell5", 0, g_PopColor2)
		end if	
		
		grd2.SetCellData("bd_cell0", 0, FormatNumber(ACNT_VLTN_AMT, g_decimal) & g_szCurr)
		grd2.SetCellData("bd_cell1", 0, FormatNumber(TFAM, g_decimal) & g_szCurr)
		grd2.SetCellData("bd_cell2", 0, FormatNumber(CFD_OTST_AMT, g_decimal)& g_szCurr)
		grd2.SetCellData("bd_cell3", 0, FormatNumber(UNAM, g_decimal)& g_szCurr )
		
		'CFD 잔고 조회
		DATAMANAGER.RequestTranData( "obtre_comm_202r" )
		
		'(v002) 주석 처리
		'원화일 때만 여기서 조회
		'if cont0.FormTab1.currenttab = "0" or cont0.FormTab1.currenttab = 0 then
		'	g_ACNT_VLTN_AMT = ACNT_VLTN_AMT
		'	'누적손익 조회
		'	DATAMANAGER.RequestTranData( "ooase_seex_084r" )
		'end if
	
	'(v002) 주석 처리
	'누적손익 금액은 무조건 원화로 조회해야 함
	'elseif szTranID == "obtre_comm_201r_1" then
	'	g_ACNT_VLTN_AMT    = DATAMANAGER.GetDataValue( 0 , "obtre_comm_201r_1", "OutBlock1", "ACNT_VLTN_AMT" , 0)		'계좌평가금액
	'	
	'	'누적손익 조회
	'	DATAMANAGER.RequestTranData( "ooase_seex_084r" )
		
	elseif szTranID == "obtre_comm_202r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obtre_comm_202r", "OutBlock1")-1
			cont0.grd1.AddRow()
			
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "ISNM" , i)                              '종목명
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "DEAL_CLS_CODE_NAME" , i)  '포지션
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "ACBK_QTY" , i)                      '잔고수량
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "CFD_ACBK_UNPR" , i)            '장부단가
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "CFD_ACBK_AMT" , i)              '장부금액
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "CFD_VLTN_AMT" , i)              '평가금액
			szTemp7 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "CFD_VLTN_PRLS_AMT" , i)     '평가손익
			szTemp8 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "ERT" , i)                                '수익률
			szTemp9 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "CFD_MGRT" , i)                      '증거금률 - 상세
			szTemp10 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "CFD_EXPN" , i)                     'CFD비용
			szTemp11 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "DEAL_CLS_CODE" , i)            '매매구분 코드
			szTemp12 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "ISCD" , i)                              '종목코드
			szTemp14 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "PSNT_PRC" , i)                     '(v002) 현재가격
			szTemp15 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "RLTM_PRDY_VRSS_PRC" , i)  '(v002) 실시간전일대비가격
			szTemp16 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "RATE" , i)                             '(v002) 등락비율
			
			sMask = "1,0,,,0,,"..g_decimal..",1,1,2,0"

			'cont0.grd1.SetCellData("bd_acc", g_nNextCount , DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "ACNO" , i)..DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock1", "ASNO" , i))	'20221110 HSZ 
			cont0.grd1.SetCellData("bd_cell1", g_nNextCount , szTemp1)
			cont0.grd1.SetCellData("bd_cell2", g_nNextCount , szTemp2)
			cont0.grd1.SetCellData("bd_cell3", g_nNextCount , szTemp3)
			cont0.grd1.SetCellData("bd_cell11", g_nNextCount , szTemp12)
			'cont0.grd1.SetCellData("bd_cell4", g_nNextCount , szTemp6 & g_CRCD)
			
			cont0.grd1.SetCellIDMaskInfo("bd_cell5", sMask)
			cont0.grd1.SetCellIDMaskInfo("bd_cell17", sMask)
			cont0.grd1.SetCellIDMaskInfo("bd_cell6", sMask)
			cont0.grd1.SetCellIDMaskInfo("bd_cell10", "1,0,,,0,4,1,1,2,0")
			
			cont0.grd1.SetCellData("bd_cell5", g_nNextCount , FormatNumber(szTemp6, g_decimal) & g_szCurr)
			cont0.grd1.SetCellData("bd_cell17", g_nNextCount, FormatNumber(szTemp5, g_decimal) & g_szCurr)	'매입금액
			
			'안심계좌일 땐 무조건 100%
			if g_AcctInfo == "B" then
				cont0.grd1.SetCellData("bd_cell9", g_nNextCount , "100")
			'일반게좌일 때
			else
				cont0.grd1.SetCellData("bd_cell9", g_nNextCount , szTemp9)
			end if
			
			cont0.grd1.SetCellData("bd_cell10", g_nNextCount , FormatNumber(szTemp4, 4) & g_CRCD)
			
			if CDbl(szTemp8) > 0 then
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , "+"..FormatNumber(szTemp7, g_decimal) & g_szCurr)
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , "+"..FormatNumber(szTemp8, 2))
				cont0.grd1.SetCellFgColor("bd_cell6", g_nNextCount, "10")
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "10")
			elseif CDbl(szTemp8) < 0 then
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , FormatNumber(szTemp7, g_decimal)& g_szCurr)
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , FormatNumber(szTemp8, 2))
				cont0.grd1.SetCellFgColor("bd_cell6", g_nNextCount, "11")
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "11")
			else
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , FormatNumber(szTemp7, g_decimal)& g_szCurr)
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , FormatNumber(szTemp8, 2))
				cont0.grd1.SetCellFgColor("bd_cell6", g_nNextCount, "12")  '(v002) 색깔 처리
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "12")  '(v002) 색깔 처리
			end if	
			
			'(v002) 현재가격(외화), 실시간전일대비가격(외화), 등락비율 처리
			if CDbl(szTemp15) > 0 then
				cont0.grd1.SetCellData("bd_cell_pp", g_nNextCount , FormatNumber(szTemp14, 2) & g_CRCD & "  ▲"..FormatNumber(szTemp15, 2) & "  " & FormatNumber(szTemp16, 2) & "%")
				cont0.grd1.SetCellFgColor("bd_cell_pp", g_nNextCount, "10")
			elseif CDbl(szTemp15) < 0 then
				cont0.grd1.SetCellData("bd_cell_pp", g_nNextCount , FormatNumber(szTemp14, 2) & g_CRCD & "  ▼"..FormatNumber(abs(szTemp15), 2) & "  " & FormatNumber(szTemp16, 2) & "%")
				cont0.grd1.SetCellFgColor("bd_cell_pp", g_nNextCount, "11")
			else
				cont0.grd1.SetCellData("bd_cell_pp", g_nNextCount , FormatNumber(szTemp14, 2) & g_CRCD & "  " & FormatNumber(szTemp15, 2) & "  " & FormatNumber(szTemp16, 2) & "%")
				cont0.grd1.SetCellFgColor("bd_cell_pp", g_nNextCount, "12")
			end if	
			
			if CInt(szTemp11) = 2 then '매수
				cont0.grd1.SetCellFgColor("bd_cell2", g_nNextCount, "326")
				cont0.grd1.SetCellBgColor("bd_cell2", g_nNextCount, "339")
			elseif CInt(szTemp11) = 1 then '매도
				cont0.grd1.SetCellFgColor("bd_cell2", g_nNextCount, "341")
				cont0.grd1.SetCellBgColor("bd_cell2", g_nNextCount, "340")
			end if
			
			'g_CountSum = g_CountSum + Cdbl(szTemp7)
			
			g_nNextCount = g_nNextCount + 1
		next
		
		'cont0.grd1.SetCellIDMaskInfo("fh_cell6", sMask)
		'cont0.grd1.SetCellFootCaption("fh_cell6", FormatNumber(g_CountSum, g_decimal) ) '& g_szCurr)
		'cont0.grd1.SetCellFootAlign('sCellID, sAlign)
		
		if  DATAMANAGER.IsMoreNextData( "obtre_comm_202r" ) == True then 
			DATAMANAGER.RequestNextData( "obtre_comm_202r" )
		else
			lblVisible()
			
			szTemp13 = DATAMANAGER.GetDataValue( 0 , "obtre_comm_202r", "OutBlock2", "CFD_VLTN_PRLS_AMT" , 0)  '평가손익합
			
			'원화
			if  cont0.FormTab1.currenttab = "0" or cont0.FormTab1.currenttab = 0 then
				if cdbl(szTemp13) > 0 then
					sMask = "0,0,＋,"..Trim(g_szCurr)..",0,,0,1,1,2,0"
				elseif cdbl(szTemp13) < 0 then
					sMask = "0,0,-,"..Trim(g_szCurr)..",0,,0,1,0,2,0"
				else
					sMask = "0,0,,"..Trim(g_szCurr)..",0,,0,1,0,2,0"
				end if
			'외화
			else
				if cdbl(szTemp13) > 0 then
					sMask = "0,0,＋,".." "..Trim(g_szCurr)..",0,,2,1,1,2,0"	
				elseif cdbl(szTemp13) < 0 then
					sMask = "0,0,-,".." "..Trim(g_szCurr)..",0,,2,1,0,2,0"	
				else
					sMask = "0,0,,".." "..Trim(g_szCurr)..",0,,2,1,0,2,0"
				end if
			end if
			
			cont0.tbl0.SetCellMaskInfo(1, 2, sMask)
			cont0.tbl0.SetCellString(1, 2, szTemp13)
			
			cont0.grd1.rowcount = g_nNextCount		
		
			g_nNextCount = 0
			
			'g_CountSum = 0
		end if
	elseif szTranID == "obtre_comm_004r" then '(v002) 해외CFD 계좌 상태 조회
	        Dim szNationalCode
	        szNationalCode   = DATAMANAGER.GetDataValue(0, "obtre_comm_004r", "OutBlock1" , "CTCD", 0)
		szMargGradCode = DATAMANAGER.GetDataValue(0, "obtre_comm_004r", "OutBlock1" , "CFD_MARG_GRAD_CODE", 0)
		
		'(v002) 해외CFD 주간 거래 대상은 미국 안심 계좌
		if szNationalCode == "840" and szMargGradCode == "B" then '미국 + 안심 계좌
		        cont0.ChkButton0.visible = true
			g_szDytmTrgtYN = "Y"
		else
		        cont0.ChkButton0.visible = false
			g_szDytmTrgtYN = "N"
		end if
		
		'(v002) 해외CFD 주간 거래 대상인 경우, 주간거래여부 선택에 따라 값 변경
	        if g_szDytmTrgtYN == "Y" then
	                if cont0.ChkButton0.checkstate == 1 or cont0.ChkButton0.checkstate == "1" then
	        	        g_szDytmYN = "Y"
	                else
	        	        g_szDytmYN = "N"
	                end if
	        else
	                g_szDytmYN = "N"
	        end if
		
		DATAMANAGER.RequestTranData( "obtre_comm_201r" )  '(v002) 위치 이동
	
	'(v002) 주석 처리
	'elseif szTranID == "ooase_seex_084r" then
		''당일
		'UI_PRLS_AMT  = DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_PRLS_AMT" , 0 )
		
		''누적
		'UI_PRLS_AMT5 = DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_PRLS_AMT5" , 0 )
		
		'(v002) 주석 처리
		'if Cdbl(UI_PRLS_AMT) > 0 then
		'	cont0.grd0.SetCellData("bd_cell8", 0, Formatnumber(UI_PRLS_AMT, 0).."원")
		'	cont0.grd0.SetCellFgColor("bd_cell8", 0, "10")
		'elseif Cdbl(UI_PRLS_AMT) < 0 then
		'	cont0.grd0.SetCellData("bd_cell8", 0, Formatnumber(UI_PRLS_AMT, 0).."원")
		'	cont0.grd0.SetCellFgColor("bd_cell8", 0, "11")
		'else
		'	cont0.grd0.SetCellData("bd_cell8", 0, Formatnumber(UI_PRLS_AMT, 0).."원")
		'	cont0.grd0.SetCellFgColor("bd_cell8", 0, "12")
		'end if
		
		'(v002) 주석 처리
		'if Cdbl(UI_PRLS_AMT5) > 0 then
		'	cont0.grd0.SetCellData("bd_cell9", 0, Formatnumber(UI_PRLS_AMT5, 0).."원")
		'	cont0.grd0.SetCellFgColor("bd_cell9", 0, "10")
		'elseif Cdbl(UI_PRLS_AMT5) < 0 then
		'	cont0.grd0.SetCellData("bd_cell9", 0, Formatnumber(UI_PRLS_AMT5, 0).."원")
		'	cont0.grd0.SetCellFgColor("bd_cell9", 0, "11")
		'else
		'	cont0.grd0.SetCellData("bd_cell9", 0, Formatnumber(UI_PRLS_AMT5, 0).."원")
		'	cont0.grd0.SetCellFgColor("bd_cell9", 0, "12")
		'end if

	end if	
End Sub

