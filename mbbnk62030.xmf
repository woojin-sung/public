<ROOT>
	<MAP_INFO scrno="62030" scrname="다른 금융기관 계좌 조회" version="2" writer="아이티젠 관리자" />
	<FORM_INFO name="Form" ly_vert="0,0,375,543,1" />
	<CONTROL_INFO>
		<FORMTAB name="FormTab" tabcount="4" tabwidthtype="1" tabheadheight="40" autosave="1" ly_vert="0,0,375,500,1" >
			<PAGE name="page1" caption="입출금" linkfile="mbbnk62030_t1" loadingtype="1" />
			<PAGE name="page2" caption="종합계좌" linkfile="mbbnk62030_t1" loadingtype="1" />
			<PAGE name="page3" caption="예적금" linkfile="mbbnk62030_t1" loadingtype="1" />
			<PAGE name="page4" caption="수익증권" linkfile="mbbnk62030_t1" loadingtype="1" />
		</FORMTAB>
		<BUTTON name="btnAll" caption="잔액모으기" fgcolor="004:000000000" btnimage="btn_02.9" ly_vert="19,505,144,34,1" />
		<BUTTON name="btnAdd" caption="계좌추가" fgcolor="004:000000000" btnimage="btn_02.9" ly_vert="204,505,144,34,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="6083" _ulen="5625" >
'===========================================================================
' 화 면 명: 다른 금융기관 계좌 조회
' 화면설명: 
' 작    성: 2020.10.12 송기영
' 수    정:
'===========================================================================
' 2021.10.08. 김효준 v001 : 오픈뱅킹_이용재동의여부 조회&등록 추가
'============================================================================
'***************************************************************************
'     G L O B A L   V A R I A B L E
'***************************************************************************

Dim g_szUserID   '사용자ID     v001
Dim g_NxetPrgsYn '다음진행여부 v001
Dim g_AgrmYn     '재동의여부   v001
Dim g_ProsAbleYn '처리가능여부 v001
'===========================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	'nCurrentTab = FormTab.currenttab
	'Form.triggerEvent("FormTab." & FormTab.currenttabpageid, "mbbnk62030_t1",  nCurrentTab)
    
    
	'v001
	g_szUserID = Form.GetSharedData( "&USER_ID" , false )	'사용자ID
	
	if Form.GetSharedData("62000_AGRMYN_SKIP" , false) = "Y" THEN
	    g_ProsAbleYn = "Y"
	    Form_Init()
	else	
		DATAMANAGER.RequestTranData( "obtss_opnf_047r" ) '오픈뱅킹_이용재동의여부조회
	end if
	
End Sub


'v001
'============================================================================
Sub Form_Init()
    If g_ProsAbleYn = "Y" Then
        Form.SetSharedData("62030_SETRMNDAMT" , "Y")
    Else
        Form.SetSharedData("62030_SETRMNDAMT" , "N")
    End If
	nCurrentTab = FormTab.currenttab
	Form.triggerEvent("FormTab." & FormTab.currenttabpageid, "mbbnk62030_t1",  nCurrentTab)
End Sub


'============================================================================
Sub FormTab_OnTabChanged(nCurrentTab)
    If g_ProsAbleYn = "Y" Then
        Form.SetSharedData("62030_SETRMNDAMT" , "Y")
    Else
        Form.SetSharedData("62030_SETRMNDAMT" , "N")
    End If
	Form.triggerEvent("FormTab." & FormTab.currenttabpageid, "mbbnk62030_t1",  nCurrentTab)
End Sub



'============================================================================
Sub btnAll_OnClick()
	Form.OpenScreen("62010", "")
End Sub



'============================================================================
Sub btnAdd_OnClick()
	Form.OpenScreen("62001", "")
End Sub


'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'v001
	if szTranID == "obtss_opnf_047r" then	'오픈뱅킹_이용재동의여부조회
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_047r", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_047r", "InBlock1", "ELFN_ID"       , 0 , g_szUserID )
	end if
	
     'v001
	if szTranID == "obtss_opnf_048a" then	'오픈뱅킹_이용재동의여부관리
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "ELFN_ID"       , 0 , g_szUserID )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "AGRM_YN"       , 0 , "Y")
	end if
End Sub


'v001
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtss_opnf_047r" then
	    g_NxetPrgsYn  = ""
	    g_AgrmYn      = DATAMANAGER.GetDataValue( 0, "obtss_opnf_047r", "OutBlock1" , "AGRM_YN"      , 0 ) '재동의여부
	    g_ProsAbleYn  = DATAMANAGER.GetDataValue( 0, "obtss_opnf_047r", "OutBlock1" , "PROS_ABLE_YN" , 0 ) '처리가능여부
	    
	    '처리가능여부가 Y인경우 SharedData 등록후 다른화면에서 다시호출안하게함
	    If g_ProsAbleYn = "Y" Then
	    
		    Form.SetSharedData("62000_AGRMYN_SKIP", "Y")
	    End If

	    If g_AgrmYn = "Y" Then
		    Form.OpenPopup("mbbnk62000_p1" , ""  , "")
		    g_NxetPrgsYn = "N" '팝업호출시도 일단 진행불가 > Form_OnPopupReturn 다시판단
	    ElseIf g_AgrmYn = "N" Then
	        g_NxetPrgsYn = "Y"
	    ElseIf g_AgrmYn = "R" Then
	        Form.MsgBox( "알림", "5년경과시 재가입 절차가 진행됩니다.", "", 6 )
	        g_NxetPrgsYn = "N"
	    End If
	    
        '다음진행 불가시 비활성화
         If g_NxetPrgsYn = "N" Then
			Form_Enable(False)
		Else
		
		    Form_Init()
	    End If
	elseif szTranID == "obtss_opnf_048a" then
	
		Form_Init()
	end if
	
End Sub


'v001
'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName == "mbbnk62000_p1" then
	     
		If sRet == "Y" then 'Y:재동의 N:취소
		     g_ProsAbleYn = "Y"
 			Form_Enable(True)
			Form_Init()
			
			DATAMANAGER.RequestTranData( "obtss_opnf_048a" )
		Else
		     '취소시도 처리가능여부값에 따라 진행
			If g_ProsAbleYn = "Y" Then
				Form_Enable(True)
				Form_Init()
			Else
			     
				Form_Enable(False)
				Form_Init()
			End If
		End If
	End If
     
End Sub


'v001
'============================================================================
' Form_Enable
'============================================================================
Function Form_Enable(EnableYn)
    if EnableYn = True then
    
		'FormTab.enable  = True '탭
		btnAll.enable   = True '잔액모으기
		btnAdd.enable   = True '계좌추가
				
    elseif EnableYn = False then
    
		'FormTab.enable  = False '탭
		btnAll.enable   = False '잔액모으기
		btnAdd.enable   = False '계좌추가
    end if
End Function

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obtss_opnf_047r" trcode="obtss_opnf_047r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obtss_opnf_048a" trcode="obtss_opnf_048a" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obtss_opnf_047r" title="오픈뱅킹_이용재동의여부조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="126" _ulen="98" >

