	<SCRIPT_INFO _len="550" _ulen="550" >
Dim g_Flag

'============================================================================
Sub Form_OnFormInit()
	
	BodyLabel0.fgcolor = 268 '#444444
	
	Image0.imgpath     = "alpha128.png"
	Button1.btnimage   = "btn_22.9"
End Sub
'============================================================================
Sub Button1_OnClick()
	g_Flag = "ok"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbbdm85181_p1_end" , g_Flag)
End Sub

