<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="50200" scrname="ETF투자가이드_ETF란_안내" version="2" writer="함원규" />
	<FORM_INFO name="Form" ly_vert="0,0,375,476,1" />
	<CONTROL_INFO>
		<CONTAINER name="contMain" ly_vert="0,0,375,476,1" scroll_ly_vert="0,0,375,476,1" >
			<CONTROL_INFO>
				<LABEL name="lblText" fgcolor="334:034034034" fontsize="2" fontstyle="01" caption="ETF란 무엇일까요?" paddinginfo="1,0,0,0" ly_vert="20,30,157,25,1" />
				<LABEL name="Label0" fgcolor="321:115118124" fontsize="-2" caption="ETF(Exchange Traded Fund)는 특정지수 및 특정자산을 추종하는 인덱스 펀드를 거래소에 상장시켜 주식처럼 거래 할 수 있도록 만든 펀드입니다." valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,72,335,60,1" />
				<IMAGE name="Image0" autosize="1" imgpath="etf_img01" ly_vert="20,152,335,133,1" />
				<LABEL name="Label1" fgcolor="321:115118124" fontsize="-2" caption="ETF는 추종하는 지수의 구성종목들로 펀드를 구성하기 때문에 ETF를 매수하면 지수 구성종목 전체를 매수하는 것과 동일한 효과를 추구할 수 있습니다. 따라서 ETF는 여러 종목에 분산 투자하는 펀드의 장점과 거래소에 상장되어 거래되는 주식의 장점을 함께 가지고 있습니다." valign="0" multiline="1" paddinginfo="1,0,0,0" ly_vert="20,307,335,120,1" />
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="339" _ulen="303" >


