Sub Cont0_Button1_OnClick()   '투자성향진단
	Dim szData 
	
    If EditPW.caption == Null Or EditPW.caption == "" Then
        Form.MsgBox( "알림" , "비밀번호를 입력해주세요." , "" , 6 )	
        Cont0.ChkButton1.checkstate = 0
        Exit Sub
    End If

	'v0001 메모리평문적용시 가장마지막에 비밀번호자릿수 넘겨줌
	'      PASSWORD값은 메모리평문 적용여부에 따라 암호화/미암호화된 정보로 넘어감
    'Form.OpenPopup( "mbonl81010_p1" , "84010★1★ ★" & ACNO & "★" & PASSWORD )    
     
     szData = "84010★1★ ★" & ACNO & "★" & PASSWORD     
     'v0001 CMA계좌전환신청에 따른 투자성향진단 오픈시, 비밀번호 컨트롤설정이 없으므로 자릿수 설정 주석처리함
	'if g_plain_rm == "1" then
	'	szData = Trim(szData) & "★" & g_pwdLen
	'end if
	Form.OpenPopup( "mbonl81010_p1" , szData ) 
    
End Sub

