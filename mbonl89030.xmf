'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : CMA 계좌 전환
' 02. 화면설명 : CMA 계좌 전환
' 03. 작    성 : 2019.05.07 장원혁
' 2020.09.18 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
' 2022.04.11 : 김수진 : v0002 : 계약서류 교부처리, obpds_srvc_028a 변경 IO 재매핑, obsap_acif_999a obcsb_dbif_322a IO 추가
' 2023.10.24 : 전상일 : v0003 : 계약서류 발송 수정.. 
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim BUTTON0_POS_TOP
Dim BUTTON1_POS_TOP
Dim BUTTON2_POS_TOP
Dim BUTTON3_POS_TOP
Dim BUTTON4_POS_TOP

Dim CHK0_POS_TOP
Dim CHK1_POS_TOP
Dim CHK2_POS_TOP
Dim CHK3_POS_TOP

'v0002 STA
Dim CHKP_POS_TOP
Dim BTNP_POS_TOP
Dim BTNM_POS_TOP 
'v0002 FIN

Dim OFFSET

Dim USER_ID
Dim RCNO
Dim ACNO
Dim ASNO
Dim CSNO
Dim PASSWORD

Dim CMA_CLS_CODE
Dim CURR_PRCD_TYPE

Dim RMND_TFAM
Dim RMND_CMA_BAL
Dim RMND_ISNT_NWRM

Dim g_plain_rm  	'v0001 메모리평문적용여부
Dim g_pwdLen		'v0001 비밀번호자릿수(Lx)

Dim g_szFnprJoinSrno		'v0002 금융상품일련번호
Dim g_szSvcSrno			'v0002서비스일련번호

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================

Sub Form_OnFormInit()    
    
    BUTTON0_POS_TOP = 480	'v0002 
    BUTTON1_POS_TOP = 308
    BUTTON2_POS_TOP = 343
    BUTTON3_POS_TOP = 378
    BUTTON4_POS_TOP = 233
    
    CHK0_POS_TOP = 311
    CHK1_POS_TOP = 347
    CHK2_POS_TOP = 382
    CHK3_POS_TOP = 237
    
    'v0002 STA
	CHKP_POS_TOP = 430
	BTNP_POS_TOP = 428
	BTNM_POS_TOP = 428
    'v0002 FIN
    
    OFFSET = 30
    
    USER_ID = Form.GetSharedData( "&USER_ID" , False )
    RCNO = Form.GetSharedData("&JUMIN_NUM", False )
    Form.SetSharedData("SPCL_CNFR_ACNO", Account0.caption )
    
	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)

    Clear_Data()    
	
	'v0003 호출 위치 변경
	'DATAMANAGER.RequestTranData( "obsap_acif_999a" ) '금융상품 일련번호 GET
End Sub

'============================================================================
Sub Cont0_Button0_OnClick()

    If GetPWCheck() Then
	    		
        If Cont0.ChkButton0.checkstate = "1" And Cont0.ChkButton1.checkstate = "1" And Cont0.ChkButton2.checkstate = "1" And Cont0.RadioGroup0.currentindex = "0" And Cont0.chkProvision.checkstate == "1" And Cont0.ChkButton3.checkstate = "1" Then 'v0002
    
            DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "PROS_CLS_CODE"          , 0 , "U"      )	
            DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "CSNO"                   , 0 , CSNO     )	
            DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "SVCD"                   , 0 , "020"    )
            DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "SVC_SRNO"               , 0 , ""       )	        
            DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "ACNO"                   , 0 , ACNO     )	
            'v0001
            if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
                DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "ACNT_PWD"           , 0 , PASSWORD )
            else  'MTS메모리평문 미적용상태일때
                DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "ACNT_PWD"           , 0 , Form.GetEncData(PASSWORD) )
            end if            
            DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "ASNO"                   , 0 , ASNO     )
            DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "SVC_MANG_UNIT_CODE"     , 0 , ""       )
            DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "PROD_MANL_HNDV_YN"      , 0 , "Y"      )
            DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "MRBN_MANL_HNDV_YN"      , 0 , ""       )
            DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "CMA_CNVR_TYPE_CLS_CODE" , 0 , "01"     )
            DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "CONT_CLS_CODE"          , 0 , "1"      )	
            DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "SNOT_EMPNO"             , 0 , ""       )
            DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "MMW_MANL_HNDV_YN"       , 0 , ""       )
            DATAMANAGER.SetDataValue( 0 , "obpds_srvc_028a" , "InBlock1" , "ISSU_DETL_DVCD"         , 0 , ""       )
            DATAMANAGER.RequestTranData("obpds_srvc_028a")

        ElseIf Cont0.RadioGroup0.currentindex = "1" Then	    
	    
            Form.MsgBox( "알림" , "전환 가능한 CMA 계좌유형이 아닙니다." , "" , 6 )	

        ElseIf Cont0.ChkButton0.checkstate = "0" Then
    
            Form.MsgBox( "알림" , "투자성향진단을 수행하여 주시기 바랍니다." , "" , 6 )
	
        ElseIf Cont0.ChkButton1.checkstate = "0" Then
    
            Form.MsgBox( "알림" , "CMA 자산관리계좌약관을 확인하여 주시기 바랍니다." , "" , 6 )
	
        ElseIf Cont0.ChkButton2.checkstate = "0" Then
    
            Form.MsgBox( "알림" , "상품설명을 확인하여 주시기 바랍니다." , "" , 6 )
	    
	    '서류제공방식체크 v0002 STA
        ElseIf Cont0.chkProvision.checkstate == "0" Then
            Form.MsgBox( "알림" , "서류 제공방식을 선택하세요." , "" , 6 )	
        'v0002 FIN
		ElseIf Cont0.ChkButton3.checkstate = "0" then
			Form.MsgBox("알림", "전문, 일반 금융소비자를 확인 바랍니다.", "Show_mbonl81010", "1")	
        End If
	
    End If
    
End Sub

'============================================================================
Function GetPWCheck()

    'v0001 실제업무처리단계에서 비밀번호 입력 한번 더 체크
    PASSWORD = EditPW.caption
    
    If PASSWORD == Null Or PASSWORD == "" Then
        Form.MsgBox( "알림" , "비밀번호를 입력십시오." , "" , 6 )
        Return False
    End If
	
    Return True
	
End Function	

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

    If szTranID = "obpds_srvc_334r" Then
         
        ISSU_DETL_DVCD = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_334r" , "OutBlock1" , "ISSU_DETL_DVCD" , 0 )       
	
        If Account0.itemcodetype = "123" Then       '비과세종합저축계좌(The CMA Plus)
	
            If ISSU_DETL_DVCD = "06" Then
                CURR_PRCD_TYPE = "비과세종합저축계좌(RP형 CMA)"
                CMA_CLS_CODE = "1"		
                Cont0.RadioGroup0.currentindex = 1		
            Else	    
                CURR_PRCD_TYPE = "비과세종합저축계좌(The CMA Plus)"
                CMA_CLS_CODE = "2"
                Cont0.RadioGroup0.currentindex = 0
            End If	    
	    
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "ACNO"          , 0 , ACNO )
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "ASNO"          , 0 , ASNO )
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "IQRY_CLS_CODE" , 0 , CMA_CLS_CODE ) 
            DATAMANAGER.RequestTranData("obsan_deal_234r")
	    
            Exit Sub	    
	
        ElseIf Account0.itemcodetype = "126" Then   '세금우대형(The CMA Plus)
	
            If ISSU_DETL_DVCD = "06" Then
                CURR_PRCD_TYPE = "세금우대형(RP형 CMA)"
                CMA_CLS_CODE = "1"		
                Cont0.RadioGroup0.currentindex = 1		
            Else	    
                CURR_PRCD_TYPE = "세금우대형(The CMA Plus)"
                CMA_CLS_CODE = "2"
                Cont0.RadioGroup0.currentindex = 0
            End If	    	
	    
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "ACNO"          , 0 , ACNO )
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "ASNO"          , 0 , ASNO )
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "IQRY_CLS_CODE" , 0 , CMA_CLS_CODE ) 
            DATAMANAGER.RequestTranData("obsan_deal_234r")    
	    
            Exit Sub
  
        End If	
	
        If ISSU_DETL_DVCD = "01" Then
	
            Cont0.RadioGroup0.currentindex = 0
	
            CURR_PRCD_TYPE = "The CMA 급여계좌"
            CMA_CLS_CODE = "2"	    
	    
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "ACNO"          , 0 , ACNO )
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "ASNO"          , 0 , ASNO )
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "IQRY_CLS_CODE" , 0 , CMA_CLS_CODE ) '발행어음 
            DATAMANAGER.RequestTranData("obsan_deal_234r")
	    
        ElseIf ISSU_DETL_DVCD = "02" Then
	
            Cont0.RadioGroup0.currentindex = 0
	
            CURR_PRCD_TYPE = "The CMA Plus"
            CMA_CLS_CODE = "2"	    
	    
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "ACNO"          , 0 , ACNO )
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "ASNO"          , 0 , ASNO )
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "IQRY_CLS_CODE" , 0 , CMA_CLS_CODE ) '발행어음 
            DATAMANAGER.RequestTranData("obsan_deal_234r")
	    
        ElseIf ISSU_DETL_DVCD = "06" Then
	
            CURR_PRCD_TYPE = "RP형 CMA"
            CMA_CLS_CODE = "1"	    
	    
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "ACNO"          , 0 , ACNO )
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "ASNO"          , 0 , ASNO )
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "IQRY_CLS_CODE" , 0 , CMA_CLS_CODE ) 'RP형
            DATAMANAGER.RequestTranData("obsan_deal_234r")	    
	    
        ElseIf ISSU_DETL_DVCD = "08" Then
	
            Cont0.RadioGroup0.currentindex = 0	
	
            CURR_PRCD_TYPE = "MMW형 CMA"
            CMA_CLS_CODE = "3"	    
	    
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "ACNO"          , 0 , ACNO         )
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "ASNO"          , 0 , ASNO         )
            DATAMANAGER.SetDataValue( 0 , "obsan_deal_234r" , "InBlock1" , "IQRY_CLS_CODE" , 0 , CMA_CLS_CODE ) 'MMW형
            DATAMANAGER.RequestTranData("obsan_deal_234r")	    	    
	    
        End If
	
    End If
	
    If szTranID = "obsan_deal_234r" Then
	
        RMND_TFAM      = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "TFAM"      , 0 )
        RMND_CMA_BAL   = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "CMA_BAL"   , 0 )	
        RMND_ISNT_NWRM = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "ISNT_NWRM" , 0 )		
	
        Table_Init( CMA_CLS_CODE , CURR_PRCD_TYPE , RMND_TFAM , RMND_CMA_BAL , RMND_ISNT_NWRM )
    
    End If
    
    If szTranID = "obacp_opop_064r" Then
    
        CSNO = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "CSNO" , 0 )
	
        DATAMANAGER.SetDataValue( 0 , "obcsb_acif_700r" , "InBlock1" , "ACNO" , 0 , ACNO )
        DATAMANAGER.SetDataValue( 0 , "obcsb_acif_700r" , "InBlock1" , "ASNO" , 0 , ASNO )	
        DATAMANAGER.SetDataValue( 0 , "obcsb_acif_700r" , "InBlock1" , "KYC_BSWR_DIV_CODE" , 0 , "02" )		  
        DATAMANAGER.SetDataValue( 0 , "obcsb_acif_700r" , "InBlock1" , "BSWR_DIV_CODE" , 0 , "17052" )	
        DATAMANAGER.RequestTranData("obcsb_acif_700r")	
    
    End If 
    
    If szTranID = "obcsb_acif_700r" Then
    
        Cont0.Button0.enable = True
        Cont0.Button1.enable = True
        Cont0.Button2.enable = True
        Cont0.Button3.enable = True
        Cont0.Button4.enable = True
        'v0002 STA
        Cont0.btnProvision.enable = True
        Cont0.btnModiTel.enable = True
        'v0002 FIN	
	
        Dim szProsYN 
	
        szProsYN = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "PROS_YN" , 0 )

        if szProsYN = "N" Or szProsYN = "X" Then '투자성향등급조회결과가 정상일 경우
            Cont0.ChkButton0.checkstate = 1
        Else	    
            Cont0.ChkButton0.checkstate = 0	 
        End If	
    
    End If
    
    'v0002 STA
    If szTranID = "obpds_srvc_028a" Then
		Dim PROS_YN
		PROS_YN = DATAMANAGER.GetDataValue( 0 , szTranID , "OutBlock1" , "PROS_YN" , 0 )
	    
		If PROS_YN = "Y" Then
		    Form.MsgBox( "알림" , "CMA 계좌유형 전환이 완료되었습니다." , "" , 6 )
		Else
		    Form.MsgBox( "알림" , "CMA 계좌유형 전환에 실패하였습니다." , "" , 6 )
		End If
			
		g_szSvcSrno = tostring(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SVC_SRNO" , 0))
		'g_szSvcSrno의 앞에 불필요한 0 제거처리
		g_szSvcSrno = tonumber(g_szSvcSrno)
		g_szSvcSrno = tostring(g_szSvcSrno)
		
		DATAMANAGER.RequestTranData("obcsb_dbif_322a")
    End If
	
    If szTranID = "obsap_acif_999a" Then
         g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		Form.SetSharedData( "FNPR_JOIN_SRNO", g_szFnprJoinSrno )
		
		Form.OpenPopup("mbonl81010_p20" , "" , "")	'2023.05.22 금융소비자 팝업 추가 'v0003 위치변경
		
'        If g_szFnprJoinSrno <> "" Then
'            Form.OpenPopup("mbonl81010_p16" , Account0.total & "★" & g_szFnprJoinSrno, "")
'        End If    
    End If
    
    If szTranID = "obcsb_dbif_322a" Then		
	    DATAMANAGER.RequestTranData( "obcsb_acif_199a" )
'        Clear_Data()
	End If
	
	if szTranID == "obcsb_acif_199a" then 
		Clear_Data()
	end if
	
	'v0002 Fin	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	If szTranID = "obpds_srvc_334r" Then	
        Form.MsgBox( "계좌유형 조회 오류" , szErrMsg , "" , 6 )
	End If

    If szTranID = "obpds_srvc_334r" Then
        Form.MsgBox( "잔고 조회 오류" , szErrMsg , "" , 6 )
    End If
    
    If szTranID = "obpds_srvc_028a" Then
        Dim strMsg
        strMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
        Form.MsgBox( "CMA 계좌 전환 오류" , szErrMsg & Chr(13) & Chr(10) & strMsg , "" , 6)
    End If    
    
    If szTranID = "obcsb_acif_700r" Then
        Form.MsgBox( "투자성향등급 조회 오류" , szErrMsg , "" , 6 )    
    End If        
	
	'v0002 STA
    If szTranID = "obsap_acif_999a" Then
        Form.MsgBox( "금융상품일련번호 조회 오류" , szErrMsg , "" , 6 )    
    End If  
    
    If szTranID = "obcsb_dbif_322a" Then
        Form.MsgBox( "계약서류 교부처리 오류" , szErrMsg , "" , 6 )    
    End If 
    'v0002 FIN
End Sub

'============================================================================
Sub Account0_ChangeAccount()
    Clear_Data()
    'v0003
    g_szFnprJoinSrno = "" 
    Form.SetSharedData("SPCL_CNFR_ACNO", Account0.caption )
End Sub

'============================================================================
Sub EditPW_OnEditComplete()    

    ACNO = Left ( Account0.caption , 8 )
    ASNO = Right( Account0.caption , 2 )

    'v0001 메모리평문적용여부에 따라 암호화/비암호화된 정보로 적용되므로 사용주의
    PASSWORD = EditPW.caption
    g_pwdLen = EditPW.pwdlen
    
    'v0003
    DATAMANAGER.RequestTranData( "obsap_acif_999a" ) '금융상품 일련번호 GET
    
	DATAMANAGER.SetDataValue( 0 , "obacp_opop_064r" , "InBlock1" , "ACNO" , 0 , ACNO )
	DATAMANAGER.RequestTranData("obacp_opop_064r")
    
	DATAMANAGER.SetDataValue( 0 , "obpds_srvc_334r" , "InBlock1" , "ACNO" , 0 , ACNO )
	DATAMANAGER.SetDataValue( 0 , "obpds_srvc_334r" , "InBlock1" , "ASNO" , 0 , ASNO )
	DATAMANAGER.RequestTranData("obpds_srvc_334r")    
End Sub

'============================================================================
Sub Clear_Data()

    Cont0.Table0.visible = True
    Cont0.Table1.visible = False
    
    Cont0.Table0.SetCellString( 1 , 0 , "" )	    	
    Cont0.Table0.SetCellString( 4 , 2 , "" )
    Cont0.Table0.SetCellString( 5 , 2 , "" )
    Cont0.Table0.SetCellString( 6 , 2 , "" )    

    Cont0.Table1.SetCellString( 1 , 0 , "" )	    			
    Cont0.Table1.SetCellString( 5 , 0 , "" )
    Cont0.Table1.SetCellString( 4 , 2 , "" )
    Cont0.Table1.SetCellString( 5 , 2 , "" )	
    
    Cont0.ChkButton0.top = CHK0_POS_TOP
    Cont0.ChkButton1.top = CHK1_POS_TOP
    Cont0.ChkButton2.top = CHK2_POS_TOP
    Cont0.ChkButton3.top = CHK3_POS_TOP
	
    Cont0.Button0.top = BUTTON0_POS_TOP
    Cont0.Button1.top = BUTTON1_POS_TOP
    Cont0.Button2.top = BUTTON2_POS_TOP
    Cont0.Button3.top = BUTTON3_POS_TOP	  
    Cont0.Button4.top = BUTTON4_POS_TOP	 
    
    Cont0.Label1.top = CHK0_POS_TOP
    Cont0.Label2.top = CHK1_POS_TOP
    Cont0.Label3.top = CHK2_POS_TOP
    Cont0.Label4.top = CHK3_POS_TOP
    
    'v0002 STA
	Cont0.chkProvision.top = CHKP_POS_TOP
	Cont0.btnProvision.top = BTNP_POS_TOP 
	Cont0.btnModiTel.top = BTNM_POS_TOP 
    'v0002 FIN    

    CMA_CLS_CODE = ""
    CURR_PRCD_TYPE = ""
    
    ACNO = ""
    ASNO = ""
    CSNO = ""
    PASSWORD = ""
    
    Cont0.RadioGroup0.currentindex = 1
    
    Cont0.ChkButton0.enable = False
    Cont0.ChkButton1.enable = False
    Cont0.ChkButton2.enable = False
    
    Cont0.ChkButton0.checkstate = 0
    Cont0.ChkButton1.checkstate = 0
    Cont0.ChkButton2.checkstate = 0
    
    Cont0.Button0.enable = False
    Cont0.Button1.enable = False
    Cont0.Button2.enable = False
    Cont0.Button3.enable = False
    Cont0.Button4.enable = False
    
    
    RMND_TFAM = 0
    RMND_CMA_BAL = 0
    RMND_ISNT_NWRM = 0    
    
    'v0002 STA
'	g_szFnprJoinSrno = "" 
	g_szSvcSrno = ""
	Cont0.chkProvision.enable = False
	Cont0.chkProvision.checkstate = 0
	Cont0.btnProvision.enable = False
	Cont0.btnModiTel.enable = False
	Cont0.ChkButton3.checkstate = 0
    'v0002 FIN    
End sub

'============================================================================
Sub Table_Init(cma_cls_code , prcdType , tfam , cma_bal , isnt_nwrm)

    If cma_cls_code = "1" Then     'CMA RP 잔고
    
        Cont0.Table0.visible = False
        Cont0.Table1.visible = True
	
        Cont0.Table1.SetCellString( 1 , 0 , prcdType      )	    		
        Cont0.Table1.SetCellString( 5 , 0 , "CMA RP 잔고" )
        Cont0.Table1.SetCellString( 4 , 2 , tfam          )
        Cont0.Table1.SetCellString( 5 , 2 , cma_bal       )
	
        Cont0.ChkButton0.top = CHK0_POS_TOP - OFFSET
        Cont0.ChkButton1.top = CHK1_POS_TOP - OFFSET
        Cont0.ChkButton2.top = CHK2_POS_TOP - OFFSET
        Cont0.ChkButton3.top = CHK3_POS_TOP - OFFSET
		
        Cont0.Label1.top = CHK0_POS_TOP - OFFSET
        Cont0.Label2.top = CHK1_POS_TOP - OFFSET
        Cont0.Label3.top = CHK2_POS_TOP - OFFSET
        Cont0.Label4.top = CHK3_POS_TOP - OFFSET
	
        Cont0.Button0.top = BUTTON0_POS_TOP - OFFSET
        Cont0.Button1.top = BUTTON1_POS_TOP - OFFSET
        Cont0.Button2.top = BUTTON2_POS_TOP - OFFSET
        Cont0.Button3.top = BUTTON3_POS_TOP - OFFSET
        Cont0.Button4.top = BUTTON4_POS_TOP - OFFSET
	
        'v0002 STA
        Cont0.chkProvision.top = CHKP_POS_TOP - OFFSET
        Cont0.btnProvision.top = BTNP_POS_TOP - OFFSET
        Cont0.btnModiTel.top = BTNM_POS_TOP - OFFSET
        'v0002 FIN    
    ElseIf cma_cls_code = "2" Then         '발행어음 잔고
    
        Cont0.Table0.visible = True
        Cont0.Table1.visible = False
	
        Cont0.Table0.SetCellString( 1 , 0 , prcdType  )	    	
        Cont0.Table0.SetCellString( 4 , 2 , tfam      )
        Cont0.Table0.SetCellString( 5 , 2 , cma_bal   )
        Cont0.Table0.SetCellString( 6 , 2 , isnt_nwrm )
	
        Cont0.ChkButton0.top = CHK0_POS_TOP
        Cont0.ChkButton1.top = CHK1_POS_TOP
        Cont0.ChkButton2.top = CHK2_POS_TOP
		Cont0.ChkButton3.top = CHK3_POS_TOP
	
        Cont0.Label1.top = CHK0_POS_TOP
        Cont0.Label2.top = CHK1_POS_TOP
        Cont0.Label3.top = CHK2_POS_TOP
		Cont0.Label4.top = CHK3_POS_TOP
	
        Cont0.Button0.top = BUTTON0_POS_TOP
        Cont0.Button1.top = BUTTON1_POS_TOP
        Cont0.Button2.top = BUTTON2_POS_TOP
        Cont0.Button3.top = BUTTON3_POS_TOP
		Cont0.Button4.top = BUTTON4_POS_TOP
	
        'v0002 STA
        Cont0.chkProvision.top = CHKP_POS_TOP
        Cont0.btnProvision.top = BTNP_POS_TOP 
        Cont0.btnModiTel.top = BTNM_POS_TOP 
        'v0002 FIN    
	
    ElseIf cma_cls_code = "3" Then     'MMW 잔고
    
        Cont0.Table0.visible = False
        Cont0.Table1.visible = True
	
        Cont0.Table1.SetCellString( 1 , 0 , prcdType  )
        Cont0.Table1.SetCellString( 5 , 0 , "MMW 잔고")
        Cont0.Table1.SetCellString( 4 , 2 , tfam      )
        Cont0.Table1.SetCellString( 5 , 2 , cma_bal   )
	
        Cont0.ChkButton0.top = CHK0_POS_TOP - OFFSET
        Cont0.ChkButton1.top = CHK1_POS_TOP - OFFSET
        Cont0.ChkButton2.top = CHK2_POS_TOP - OFFSET
		Cont0.ChkButton3.top = CHK3_POS_TOP - OFFSET
	
        Cont0.Label1.top = CHK0_POS_TOP - OFFSET
        Cont0.Label2.top = CHK1_POS_TOP - OFFSET
        Cont0.Label3.top = CHK2_POS_TOP - OFFSET	
		Cont0.Label4.top = CHK3_POS_TOP - OFFSET
	
        Cont0.Button0.top = BUTTON0_POS_TOP - OFFSET
        Cont0.Button1.top = BUTTON1_POS_TOP - OFFSET
        Cont0.Button2.top = BUTTON2_POS_TOP - OFFSET
        Cont0.Button3.top = BUTTON3_POS_TOP - OFFSET	
		Cont0.Button4.top = BUTTON4_POS_TOP - OFFSET
		
        'v0002 STA
        Cont0.chkProvision.top = CHKP_POS_TOP - OFFSET
        Cont0.btnProvision.top = BTNP_POS_TOP - OFFSET
        Cont0.btnModiTel.top = BTNM_POS_TOP - OFFSET
        'v0002 FIN    	
    End If

End Sub

