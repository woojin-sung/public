'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "obsab_deal_601r" then
'		Form.ShowAlert("90001_s2", sParam)
		
		g_szLinkData = sParam
		g_szList = Split(g_szLinkData , "|")
		
'		g_szQryType & "|" &				'0 조회구분  1, 2
'		g_HLDY_YN & "|" &					'1 휴일여부
'		g_DEAL_ABLE_YN & "|" &				'2 거래가능 여부
'		g_COMN_PFIN_YN & "|" &				'3 전문투자자여부
'		g _PFIN_VLDT_EXPR_YN & "|" &		'4 전문투자자효력경과여부
'		g_KYC_INVT_INCL_GRAD_CODE & "|" &	'5 KYC투자성향등급코드
'		g_KYC_INVT_INCL_GRAD_NAME & "|" &	'6 KYC투자성향등급명
'		g_IVIC_VLDT_EXPR_YN & "|" &			'7 투자성향효력경과여부
'		g_KYC_INVT_RCMD_CLS_CODE & "|" &	'8 KYC투자권유구분코드
'		cmbAccount.total & "|" &			'9 계좌번호
'		cmbAccount.sequence				'10 계좌seq
									     '11 조회건수
		
		
		g_szQryType               = g_szList(0)
		g_HLDY_YN                 = g_szList(1)
		g_DEAL_ABLE_YN 	  	   = g_szList(2)
	 	
		g_COMN_PFIN_YN      	   = g_szList(3)
		g_PFIN_VLDT_EXPR_YN 	   = g_szList(4)
		
		g_KYC_INVT_INCL_GRAD_CODE = g_szList(5)
		g_KYC_INVT_INCL_GRAD_NAME = g_szList(6)
		g_IVIC_VLDT_EXPR_YN       = g_szList(7)
		g_KYC_INVT_RCMD_CLS_CODE  = g_szList(8)
		g_szAccount			   = g_szList(9)
		g_szAccountSeq		   = g_szList(10)
		g_IQRY_CSNU			   = g_szList(11)
		g_CUST_CLS_CODE		   = g_szList(12)	'고객구분코드(2:법인)
		
'		Form.ShowAlert("90001_s2", g_KYC_INVT_INCL_GRAD_CODE)
		
		gridData.rowcount = 0
		DATAMANAGER.RequestTranData( "obsab_deal_602r" )
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	'고객ID
	g_szUSERID = Form.GetSharedData("&USER_ID", false )
	
	'고객번호
	g_szCsno = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴

	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	g_COMN_PFIN_YN = "N"
	
	gridData.scrollenable = "0"
	
'	g_szLinkData = "1|N|Y|N|N|05|이자수익형|N|1"
'	g_szList = Split(g_szLinkData , "|")
'	
'	g_szQryType               = g_szList(0)
'	g_HLDY_YN                 = g_szList(1)
'	g_DEAL_ABLE_YN 	  	   = g_szList(2)
'	
'	g_COMN_PFIN_YN      	   = g_szList(3)
'	g_PFIN_VLDT_EXPR_YN 	   = g_szList(4)
'	
'	g_KYC_INVT_INCL_GRAD_CODE = g_szList(5)
'	g_KYC_INVT_INCL_GRAD_NAME = g_szList(6)
'	g_IVIC_VLDT_EXPR_YN       = g_szList(7)
'	g_KYC_INVT_RCMD_CLS_CODE  = g_szList(8)
'	
'	DATAMANAGER.RequestTranData( "obsab_deal_602r" )
	
End Sub

'============================================================================
Sub gridData_OnClickUp(lRow, szCellID)
	Dim szData
	
	if g_CUST_CLS_CODE == "2" then
		Form.ShowAlert("알림", "법인은 신청이 불가합니다.")
		Exit Sub
	end if	
	
'	g_szSymbolType = gridData.GetCellData("PROD_TPCD", lRow)  '09:채권 , 12:단기사채
	g_szSymbolType = gridData.GetCellData("INVT_TRGT_TYPE_CODE", lRow)   '13:장외채권, 46:단기사채(발행), 20:단기사채(유통)
	
	
	g_szSymbolCode = gridData.GetCellData("ISCD", lRow)
	
'	if g_szSymbolType == "09" then      '장내 채권일 경우
'		innermarket = Form.GetItemCodeInfo(g_szSymbolCode, "innermarket")
'		Select Case innermarket
'			Case "020" szItemGroup = "B"   '장내채권
'			Case "019" szItemGroup = "SB"  '소액채권
'		end Select
'		
'		'장내채권 현재가 화면으로 이동
'		Form.OpenScreen("54010", "채권시세표★0★" & g_szSymbolCode & "★" & szItemGroup)
'	
'	elseif g_szSymbolType == "99" then '장외채권일 경우
'		szData = g_szSymbolCode	& "|" &		'종목코드
'				g_szAccount		& "|" &      '계좌번호
'			     g_szAccountSeq	& "|" &      '계좌seq
'			     g_szAccountPwd	& "|" &      '계좌비번
'			     g_COMN_PFIN_YN	& "|" &      '전문투자자여부
'			     g_PFIN_VLDT_EXPR_YN           '전문투자자 만료여부
'			     
'		Form.OpenPopup("mbonl90201_s1", szData , "")
'		
'	elseif g_szSymbolType == "12" then '단기사채일 경우
'	
'		'단기사채 상세정보 요청후, 단기사채 종목 상세화면으로 이동
'		DATAMANAGER.RequestTranData( "obsab_deal_609r" )
'		
'	end if 
	
	if g_szSymbolType == "13" then '장외채권일 경우
		szData = g_szSymbolCode	& "|" &		'종목코드
				g_szAccount		& "|" &      '계좌번호
			     g_szAccountSeq	& "|" &      '계좌seq
			     g_szAccountPwd	& "|" &      '계좌비번
			     g_COMN_PFIN_YN	& "|" &      '전문투자자여부
			     g_PFIN_VLDT_EXPR_YN           '전문투자자 만료여부
			     
		Form.OpenPopup("mbonl90201_s1", szData , "")
		
	elseif (g_szSymbolType == "46") or (g_szSymbolType == "20") then '단기사채일 경우
	
		'단기사채 상세정보 요청후, 단기사채 종목 상세화면으로 이동
'		DATAMANAGER.ClearInputData(0, "obsab_deal_609r")
		DATAMANAGER.RequestTranData( "obsab_deal_609r" )
		
	end if 
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , szTranID .. "\n" .. szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , szTranID .. "\n" .. szErrCode .. " : ".. szErrMsg)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szUserID
	
	if szTranID == "obsab_deal_602r" then
'		Form.ShowAlert("90001_s2", g_KYC_INVT_INCL_GRAD_CODE)
		
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE", 		0 , g_szQryType)  '9:투자성향 조회 1:전체조회, 2:내성향맞춤
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE", 		0 , "1")  '무조건 전체조회되게 수정
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID", 			0 , g_szUSERID)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "KYC_INVT_INCL_GRAD_CODE", 	0 , g_KYC_INVT_INCL_GRAD_CODE)
		
	'end of if szTranID == "obsab_deal_602r"
	
	
	elseif szTranID == "obsab_deal_609r" then
		'고객ID
		szUserID = Form.GetSharedData("&USER_ID", false )
	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID",	0, szUserID)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",		0, "")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",		0, "")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD",	0, "")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD",		0, g_szSymbolCode)
	
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iDataCnt
	Dim szDate, szValue
	
	if szTranID == "obsab_deal_602r" then
		szTemp1 	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "STND_DATE" , 0)
		lblStdDate.caption = "(" & 
						   Left(szTemp1, 4) & "." & Mid(szTemp1, 5, 2) & "." & Right(szTemp1, 2) &
						   "기준, 연 세전)"
		
		g_iDataCount = gridData.rowcount
				
		iDataCnt = CInt(DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2" ))
		for i = 0 to iDataCnt - 1		
			szTemp2 	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "PROD_TPCD", 			i)
			szTemp3 	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "ISCD", 				i)
			szTemp4 	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "ISNM", 				i)
			szTemp5 	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "BYOV_ERT", 			i)
			szTemp7 	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "INVT_TRGT_TYPE_CODE",	i)
			

			gridData.AddRow()			
			gridData.SetCellData("bd_num", 		g_iDataCount, g_iDataCount+1)
			
'			select case szTemp2
'				case "09" 	szValue = "채권(장내)"
'				case "99"	szValue = "채권(장외)"
'				case "12"	szValue = "단기사채"
'			end select
			select case szTemp7
				case "13" 	szValue = "채권(장외)"
				case "46"	szValue = "단기사채(발행물)"
				case "20"	szValue = "단기사채(유통물)"
			end select
			gridData.SetCellData("bd_type", 	g_iDataCount, szValue)
			
			gridData.SetCellData("bd_title", 	g_iDataCount, szTemp4)
			gridData.SetCellData("bd_return", 	g_iDataCount, FormatNumber(szTemp5, 3))
			
			
			gridData.SetCellData("STND_DATE", 	g_iDataCount, szTemp1)
			gridData.SetCellData("PROD_TPCD", 	g_iDataCount, szTemp2)
			gridData.SetCellData("ISCD", 		g_iDataCount, szTemp3)			
			gridData.SetCellData("BYOV_ERT", 	g_iDataCount, szTemp5)
			gridData.SetCellData("INVT_TRGT_TYPE_CODE", 	g_iDataCount, szTemp7)

			g_iDataCount = g_iDataCount + 1
		next
		
		if DATAMANAGER.IsMoreNextData(szTranID) == true then
			DATAMANAGER.RequestNextData(szTranID)
			
		else
			gridData.rowcount = g_iDataCount
			
			if gridData.rowcount == 0 then
				gridData.height = 0
			end if
			
'			gridData.height = (65 * g_iDataCount)
'			gridData.SetScrollAutoSize()
			
		end if
		
	'end of if szTranID == "obsab_deal_602r"
	
	elseif szTranID == "obsab_deal_609r" then 
		g_SymbolData = {}		
		
'		Form.ShowAlert("1TranComplete_" & szTranID, )
		
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD",					0))	'0 종목코드
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KOR_ISNM",				0))	'1 한글종목명
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_PROD_GRAD_CODE",		0))	'2 KYC상품등급코드
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CRDT_GRAD",				0))	'3 신용등급
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PBLC_DATE",				0))	'4 발행일자
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MTRT_DATE",				0))	'5 만기일자
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ESBD_STND_DYNU_CLCD",		0))	'6 전자단기사채기준일수구분코드
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "GNRL_INTRT",				0))	'7 일반이자율
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RMNN_WNCR_AMT",			0))	'8 잔여원화금액
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TOTAL_ODER_LIMT_AMT",		0))	'9 총주문한도금액
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TOTAL_BYOV_APLT_AMT",		0))	'10 총매수신청금액
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INVT_TRGT_TYPE_CODE",		0))	'11 투자대상유형코드
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RCRT_STA_DATE",			0))	'12 모집시작일자
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RCRT_FIN_DATE",			0))	'13 모집종료일자
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FNCD",					0))	'14 펀드코드
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SHTR_BOND_REG_CLS_CODE",	0))	'15 단기사채등록구분코드
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CREN_CO_NAME",			0))	'16 신용보강회사명
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INVT_DYNU",				0))	'17 투자일수
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PSNT_DATE",				0))	'18 현재일자
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "INVT_ABLE_AMT",			0))	'19 투자가능금액
		
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "ATCH_FILE_PATH_NAME",		0))	'20 첨부파일경로명 투자설명서
		
		table.insert(g_SymbolData, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "ATCH_FILE_PATH_NAME",		1))	'21 첨부파일경로명 신용평가서
		
		if (g_szSymbolType == "46") or (g_szSymbolType == "20") then  '단기사채일 경우
			szData = ""
			
			szParam0 	= g_szAccount				'계좌번호
			szParam1 	= g_szAccountSeq			'계좌순번
			szParam2 	= g_SymbolData[0]			'종목코드
			szParam3 	= g_SymbolData[1]			'종목한글명
			'종목명 : 스페이스로 구분하여 줄바꿈해줌.. 스페이스 없으면 자동 줄바꿈..
			if InStr(szParam3, " ") <> 0 Then
				szParam3 = Left(szParam3, InStr(szParam3, " ")) .. "\n" .. Mid(szParam3, InStr(szParam3, " ")+1, Len(szParam3)-InStr(szParam3, " ")+1 )
			end if
			szParam4 	= g_SymbolData[13]		'모집종료일자
			szParam5 	= ""						'모집마감시간 (사용안함)
			szParam6 	= g_SymbolData[17]		'투자일수
			szParam7 	= g_SymbolData[7]			'일반이자율
			szParam8 	= g_SymbolData[5]			'만기일자
			
			'상품등급코드
			if g_SymbolData[2] = "01" then
				szParam9 = "매우높은위험"
				
			elseif g_SymbolData[2] = "02" then
				szParam9 = "높은위험"
				
			elseif g_SymbolData[2] = "03" then
				szParam9 = "다소높은위험"
				
			elseif g_SymbolData[2] = "04" then
				szParam9 = "보통위험"
				
			elseif g_SymbolData[2] = "05" then
				szParam9 = "낮은위험"
				
			elseif g_SymbolData[2] = "06" then
				szParam9 = "매우낮은위험"
				
			end if
			
			szParam10 	= g_SymbolData[3]			'신용등급코드
			szParam11 	= g_SymbolData[8]			'잔여원화금액
			szParam12 	= g_SymbolData[9]			'총주문한도금액
			szParam13 	= g_SymbolData[4]			'발행일자
			szParam14 	= g_SymbolData[11]		'투자대상유형코드
			szParam15 	= g_SymbolData[20]		'홈페이지첨부파일경로명(MTS사용)  HMPG_ATCH_FILE_PATH_NAME	투자설명서
			szParam16 	= g_SymbolData[21]		'홈페이지평가파일경로명(MTS사용)  HMPG_ATCH_FILE_PATH_NAME1 신용평가서
			szParam17 	= g_SymbolData[19]		'투자가능금액   INVT_ABLE_AMT
						      
			szParam18	= "%"					'투자대상유형코드
			szParam19	= "1"					'조회구분코드
			szParam20	= g_szQryType				'대상구분코드
									
			szParam21 	= g_SymbolData[12]		'모집시작일자
			szParam22 	= ""  					'모집시작시간 (사용안함)
									
			szParam23 	= g_SymbolData[15]		'단기사채등록구분코드(1:발행물/2:유통물
			szParam24 	= g_SymbolData[16]		'신용보강회사명(타행물인 경우에만)
			szParam25 	= g_SymbolData[18]		'현재일자(타행물인 경우 매수일)   PSNT_DATE
									
			szData = szParam0 & "★" & szParam1 & "★" & szParam2 & "★" & szParam3 & "★" & szParam4 & "★" &
					szParam5 & "★" & szParam6 & "★" & szParam7 & "★" & szParam8 & "★" & szParam9 & "★" & 
					szParam10 & "★" &szParam11 & "★" & szParam12 & "★" & szParam13 & "★" & szParam14 & "★" & 
					szParam15 & "★" & szParam16 & "★" & szParam17 & "★" & szParam18 & "★" & szParam19 & "★" & 
					szParam20 & "★" & szParam21 & "★" & szParam22 & "★" & szParam23 & "★" & szParam24 & "★" & szParam25
		
'			Form.ShowAlert("2TranComplete_" & szTranID, szData)
			Form.OpenPopup("mbonl88060_p1" , szData , "")
		
		end if 
		
	end if
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl90201_s1" then
		'투자성향 미등록인 경우 투자성향 재진단 연결
		if sRet == "MOVE" then
			'투자성향재진단 화면 연결
			Form.OpenScreen("81010", "")
			Form.CloseForm()
			
		end if
		
	elseif sKeyName == "mbonl88060_p1" then	
		'투자성향 미등록인 경우 투자성향 재진단 연결
		if sRet == "MOVE" then
			'투자성향재진단 화면 연결
			Form.OpenScreen("81010", "")
			Form.CloseForm()
		end if
		
	end if
End Sub

