<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="90190" scrname="간편인증 유의사항 팝업" version="2" writer="성우진" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<IMAGE name="ImgClose" autosize="1" imgpath="icon_close" ly_vert="340,20,22,22,1" />
		<LABEL name="labTitle" fgcolor="334:034034034" fontsize="4" fontstyle="01" caption="메리츠 간편인증 안내" halign="1" ly_vert="0,0,375,60,1" />
		<TABLE name="Table0" insidelinecolor="102:255255255" colcount="3" rowcount="3" outline="0000" designorder="1" ly_vert="10,97,357,60,1" >
			<COL_INFO ly_vert_width="66,66,225" />
			<ROW_INFO ly_vert_height="20,20,20" />
			<CELL_INFO>
				<CELL cell_ly="0,0,2,0" fgcolor="334:034034034" halign="0" line="0,0" caption="간편비밀번호 6자리 또는 스마트폰에 등록된 생체정보" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,1,2,1" fgcolor="334:034034034" halign="0" line="0,0" caption="(지문, Face ID)를 이용하여 메리츠증권의 금융거래를" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,2,2,2" fgcolor="334:034034034" halign="0" line="0,0" caption="이용할 수 있는 인증 서비스입니다." fontsize="-1" impidxs="" />
			</CELL_INFO>
		</TABLE>
		<TABLE name="Table1" insidelinecolor="102:255255255" colcount="3" rowcount="20" outline="0000" designorder="1" ly_vert="13,211,364,400,1" >
			<COL_INFO ly_vert_width="66,66,232" />
			<ROW_INFO ly_vert_height="20,20,20,20,20,20,20,20,20,20,20,20,20,20,20,20,20,20,20,20" />
			<CELL_INFO>
				<CELL cell_ly="0,0,2,0" fgcolor="334:034034034" halign="0" line="0,0" caption="· 개인 고객만 발급 가능합니다.(미성년자, 법인 불가)" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,1,2,1" fgcolor="334:034034034" halign="0" line="0,0" caption="· 고객 1인당 1기기만 발급 및 이용 가능합니다." fontsize="-1" impidxs="" />
				<CELL cell_ly="0,2,2,2" fgcolor="334:034034034" halign="0" line="0,0" caption="   (다른 기기에서 등록할 경우, 기존에 등록한 기기는" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,3,2,3" fgcolor="334:034034034" halign="0" line="0,0" caption="   이용이 해지됩니다.)" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,4,2,4" fgcolor="334:034034034" halign="0" line="0,0" caption="· 생체정보를 이용한 인증이 불가능한 스마트폰에서는" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,5,2,5" fgcolor="334:034034034" halign="0" line="0,0" caption="   비밀번호 6자리를 활용한 인증만 가능합니다." fontsize="-1" impidxs="" />
				<CELL cell_ly="0,6,2,6" fgcolor="334:034034034" halign="0" line="0,0" caption="· 등록한 간편인증의 유효기간은 등록 후 3년이며," fontsize="-1" impidxs="" />
				<CELL cell_ly="0,7,2,7" fgcolor="334:034034034" halign="0" line="0,0" caption="   만료일 30일전부터 갱신 가능합니다." fontsize="-1" impidxs="" />
				<CELL cell_ly="0,8,2,8" fgcolor="334:034034034" halign="0" line="0,0" caption="· 생체 인증에 이용된 정보에 대해 당사는 이용자의" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,9,2,9" fgcolor="334:034034034" halign="0" line="0,0" caption="   생체정보를 저장하지 않습니다." fontsize="-1" impidxs="" />
				<CELL cell_ly="0,10,2,10" fgcolor="334:034034034" halign="0" line="0,0" caption="· 스마트폰에 등록된 모든 생체 정보는 고객 본인의" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,11,2,11" fgcolor="334:034034034" halign="0" line="0,0" caption="   것이어야 하며, 타인의 정보가 스마트폰에 등록되어" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,12,2,12" fgcolor="334:034034034" halign="0" line="0,0" caption="   발생한 문제에 대해서는 당사가 책임지지 않습니다." fontsize="-1" impidxs="" />
				<CELL cell_ly="0,13,2,13" fgcolor="334:034034034" halign="0" line="0,0" caption="· 타인의 이용이 의심되었을 경우, 즉시 간편 인증" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,14,2,14" fgcolor="334:034034034" halign="0" line="0,0" caption="   서비스를 해지 처리 하시기 바랍니다." fontsize="-1" impidxs="" />
				<CELL cell_ly="0,15,2,15" fgcolor="334:034034034" halign="0" line="0,0" caption="· 네트워크 장애, 천재지변 등 인증 서비스의 장애가" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,16,2,16" fgcolor="334:034034034" halign="0" line="0,0" caption="   발생할 경우, 공동인증서 또는 금융결제원 바이오" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,17,2,17" fgcolor="334:034034034" halign="0" line="0,0" caption="   인증을 이용한 인증을 진행하셔야 합니다." fontsize="-1" impidxs="" />
				<CELL cell_ly="0,18,0,18" fgcolor="334:034034034" halign="0" line="0,0" fontsize="-1" impidxs="" />
				<CELL cell_ly="1,18,1,18" fgcolor="334:034034034" halign="0" line="0,0" fontsize="-1" impidxs="" />
				<CELL cell_ly="2,18,2,18" fgcolor="334:034034034" halign="0" line="0,0" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,19,0,19" fgcolor="334:034034034" halign="0" line="0,0" fontsize="-1" impidxs="" />
				<CELL cell_ly="1,19,1,19" fgcolor="334:034034034" halign="0" line="0,0" fontsize="-1" impidxs="" />
				<CELL cell_ly="2,19,2,19" fgcolor="334:034034034" halign="0" line="0,0" fontsize="-1" impidxs="" />
			</CELL_INFO>
		</TABLE>
		<LABEL name="Label0" fgcolor="334:034034034" fontsize="1" fontstyle="01" caption="메리츠 간편인증이란?" ly_vert="10,68,349,24,1" />
		<LABEL name="Label1" fgcolor="334:034034034" fontsize="1" fontstyle="01" caption="이용안내" ly_vert="10,184,349,24,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="444" _ulen="444" >
--===========================================================================
--===========================================================================
'============================================================================
Sub Form_OnFormInitBefore()
	ImgClose.setMaintainingRatio("1")
End Sub

'============================================================================
Sub ImgClose_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>