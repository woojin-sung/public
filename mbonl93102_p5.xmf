				<CELL cell_ly="0,1,0,1" fgcolor="096:102102102" halign="0" line="0,0" caption="이전의사 확인 가능일" fontsize="-1" impidxs="" />
				<CELL cell_ly="1,1,1,1" halign="2" line="0,0" mask="1,0,~,,1,####.##.##,0,1,1,0,0" impidxs="" />
