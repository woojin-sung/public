			<COL_INFO ly_vert_width="110,205" />
			<ROW_INFO ly_vert_height="39,39" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" fgcolor="096:102102102" halign="0" line="0,0" caption="이전하는 계좌" fontsize="-1" impidxs="" />
