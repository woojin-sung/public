완료되었습니다. " halign="1" valign="0" multiline="1" ly_vert="0,158,375,60,1" />
		<IMAGE name="Image1" imgpath="img_bgbox.9" ly_vert="20,242,335,178,1" />
		<TABLE name="tblInfo" insidelinecolor="102:255255255" colcount="2" rowcount="2" outline="0000" transmode="1" designorder="1" ly_vert="30,331,315,78,1" >
			<COL_INFO ly_vert_width="155,160" />
			<ROW_INFO ly_vert_height="39,39" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" fgcolor="096:102102102" halign="0" line="0,0" caption="연금이전 신청일" fontsize="-1" impidxs="" />
