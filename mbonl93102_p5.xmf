	<SCRIPT_INFO _len="1345" _ulen="1199" >


'============================================================================
Sub Form_OnFormInit()
	Dim szToday, szNextBizDay
	szToday = Form.GetSharedData( "&HOST_DATE", false )
	szNextBizDay = Form.GetSharedData( "&BIZ_NXT_DT", false )
	
	tblInfo.SetCellString(0, 1, szToday)			'연금이전 신청일
	tblInfo.SetCellString(1, 1, szNextBizDay)	'이전의사 확인 가능일
	
	Dim szMaskDate
	szMaskDate = Left(szNextBizDay, 4) & "." & Mid(szNextBizDay, 5, 2) & "." & Right(szNextBizDay, 2)
	lblText.caption = szMaskDate & "까지 이전의사 미확인 시\n계약이전이 취소됩니다."
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		Dim tData
		tData = Split(szOpenData, "★")
		'0:받는계좌번호, 1:보내는기관명, 2:보내는계좌번호
		If UBound(tData) > 0 Then
			'이전하는 계좌
			tblInfo2.SetCellString(0, 1, tData[1] & " " & tData[2])
			
			'이전받는 계좌
			Dim szMaskAcnt
			szMaskAcnt = Left(tData[0], 4) & "-" & Mid(tData[0], 5, 4) & "-" & Right(tData[0], 2)
			tblInfo2.SetCellString(1, 1, "메리츠증권 " & szMaskAcnt)
		End If
	End If
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.SendReturnToParent( "mbonl93102_p5" , "" )
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>