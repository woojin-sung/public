'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()	
	Contbody.lblB1.fgcolor = 265
	
	Contbody.lblC1.fgcolor = 265
	Contbody.lblC2.fgcolor = 265
	
	Contbody.lblD1.fgcolor = 265
	Contbody.lblD2.fgcolor = 265
	Contbody.lblD5.fgcolor = 265
	Contbody.lblD6.fgcolor = 265	
	
	Contbody.lblE1.fgcolor = 265
	Contbody.lblE3.fgcolor = 265
	Contbody.lblE6.fgcolor = 265
	Contbody.lblE8.fgcolor = 265
	
	Contbody.lblF1.fgcolor = 265
	Contbody.lblF2.fgcolor = 265
End Sub


'============================================================================
' imgClose_OnClick
'============================================================================
Sub Contbody_imgClose_OnClick()
	Form.SendReturnToParent("상품선택취소", "")   
	Form.CloseForm()	
End Sub


'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용
	Contbody_imgClose_OnClick()
End Sub
'============================================================================
Sub BtnCancel_OnClick()
	
	Form.SendReturnToParent("상품선택취소", "")   
	Form.CloseForm()
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	Form.SendReturnToParent("상품선택완료", "") 
	Form.CloseForm()
End Sub



