				<IMAGE name="imgTopTitle" imgpath="Wrap_top.png" ly_vert="15,60,345,120,1" />
				<LABEL name="lblTopInfo" fgcolor="062:255255255" caption="운용전문가의 도움을 받아 다양한 금융투자상품을
한계좌로 운용할 수 있는 종합 자산 관리 계좌입니다." halign="1" multiline="1" ly_vert="20,190,335,40,1" />
				<IMAGE name="imgTitle0" autosize="1" imgpath="wrap_title01.png" ly_vert="15,260,220,25,1" />
				<IMAGE name="imgInfo0" autosize="1" imgpath="wrap_about.png" ly_vert="25,294,325,110,1" />
				<LABEL name="lblInfo0" caption="고객과 메리츠증권이 투자일임계약을 체결하고, 고객의 일임자산을 고객의 투자목적과 성향 등을 고려하여 전문적이고 체계화된 방법으로 운영하고, 지속적으로 관리해주는 일임 자산관리서비스입니다." multiline="1" ly_vert="10,413,355,84,1" />
				<IMAGE name="imgTitle1" autosize="1" imgpath="wrap_title02.png" ly_vert="15,505,120,24,1" />
				<IMAGE name="imgBg" autosize="1" ly_vert="10,533,355,426,1" />
				<IMAGE name="imgSubIcon0" autosize="1" imgpath="wrap_info_icon01.png" ly_vert="20,543,40,40,1" />
				<IMAGE name="imgSubTitleBg0" enable="0" autosize="1" ly_vert="70,548,108,30,1" />
				<LABEL name="lblSubTitle0" fontstyle="01" caption="맞춤식 운용" ly_vert="60,549,110,30,1" />
				<LABEL name="lblSubText0" caption="고객별 Needs에 따라 1대1 맞춤식 운용과 자산배분이 가능합니다." valign="0" multiline="1" ly_vert="60,583,300,54,1" />
				<IMAGE name="imgSubIcon1" autosize="1" imgpath="wrap_info_icon02.png" ly_vert="20,624,40,40,1" />
				<IMAGE name="imgSubTitleBg1" autosize="1" ly_vert="70,629,140,30,1" />
				<LABEL name="lblSubTitle1" fontstyle="01" caption="투명한 운용 관리" ly_vert="60,630,127,30,1" />
				<LABEL name="lblSubText1" caption="고객은 자산운용내역 실시간 조회가 가능하고, 자산관리자와 언제든지 의사소통이 가능합니다." valign="0" multiline="1" ly_vert="60,664,300,66,1" />
				<IMAGE name="imgSubIcon2" autosize="1" imgpath="wrap_info_icon03.png" ly_vert="20,728,40,40,1" />
				<IMAGE name="imgSubTitleBg2" autosize="1" ly_vert="70,733,108,30,1" />
				<LABEL name="lblSubTitle2" fontstyle="01" caption="유연한 운용" ly_vert="60,734,127,30,1" />
				<LABEL name="lblSubText2" caption="시장변화 또는 고객의 니즈 변화에 민첩한 대응이 가능합니다.
Wrap수수료만 징수하여 자산교체에 따른 추가 비용이 없습니다." valign="0" multiline="1" ly_vert="60,768,300,84,1" />
				<IMAGE name="imgSubIcon3" autosize="1" imgpath="wrap_info_icon04.png" ly_vert="20,850,40,40,1" />
				<IMAGE name="imgSubTitleBg3" autosize="1" ly_vert="70,855,136,30,1" />
				<LABEL name="lblSubTitle3" fontstyle="01" caption="철저한 사후관리" ly_vert="60,856,127,30,1" />
				<LABEL name="lblSubText3" caption="목표수익률, 손실하한선을 관리하고 기준수익률 도달 시 통지하는 등 리스크 관리 기능을 수행합니다." valign="0" multiline="1" ly_vert="60,890,300,66,1" />
				<IMAGE name="imgTitle2" autosize="1" imgpath="wrap_title03.png" ly_vert="15,989,190,20,1" />
				<IMAGE name="imgInfo" autosize="1" imgpath="wrap_process_img.png" ly_vert="10,1032,355,260,1" />
				<LABEL name="Label0" fontsize="-5" halign="2" ly_vert="0,0,375,20,1" />
				<CONTAINER name="contCheck" scroll_pos="0,0" ly_vert="0,1300,375,32,1" scroll_ly_vert="0,0" >
					<CONTROL_INFO>
						<LABEL name="lblInfo" fontsize="-1" caption="투자 유의사항" ly_vert="25,2,290,30,1" />
						<IMAGE name="Image1" autosize="1" imgpath="ic_notice2" ly_vert="2,6,20,20,1" />
						<LABEL name="lblLine1" bgcolor="081:229229229" transmode="0" ly_vert="0,0,375,1,1" />
						<LABEL name="lblLine2" bgcolor="081:229229229" transmode="0" ly_vert="0,32,375,1,1" />
						<BUTTON name="btnFold" btnimage="btn_filter.9.png" ly_vert="340,0,32,32,1" />
						<TABLE name="Table2" insidelinecolor="102:255255255" colcount="2" rowcount="12" outline="0000" designorder="1" ly_vert="10,33,360,515,1" >
							<COL_INFO ly_vert_width="5,355" />
							<ROW_INFO ly_vert_height="10,55,30,55,70,55,40,40,55,55,40,10" />
							<CELL_INFO>
								<CELL cell_ly="0,0,0,0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,0,1,0" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="0,1,0,1" valign="0" line="0,0" caption="·" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,1,1,1" valign="0" halign="0" line="0,0" caption="랩어카운트는 자산가격 변동, 환율 변동 등에 따라 투자원금
의 손실(0~100%)이 발생할 수 있으며, 그 손실은 투자자에
게 귀속됩니다." fontsize="-2" impidxs="" />
								<CELL cell_ly="0,2,0,2" valign="0" line="0,0" caption="·" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,2,1,2" valign="0" halign="0" line="0,0" caption="랩어카운트는 예금자보호법에 따라 보호되지 않습니다." fontsize="-2" impidxs="" />
								<CELL cell_ly="0,3,0,3" valign="0" line="0,0" caption="·" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,3,1,3" valign="0" halign="0" line="0,0" caption="투자자는 랩어카운트에 대하여 메리츠증권으로부터 충분한
설명을 받을 권리가 있으며, 투자 전 상품설명서 및 약관을
반드시 읽어보시기 바랍니다." fontsize="-2" impidxs="" />
								<CELL cell_ly="0,4,0,4" valign="0" line="0,0" caption="·" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,4,1,4" valign="0" halign="0" line="0,0" caption="고객은 본 일임계약에 따른 자산의 운용에 대하여 일임 계약
에서 정하는 범주내에서 합리적인 제한을 두거나 계약의
해지 등을 요구할 수 있으며, 당사는 특별한 사유가 없는 한
투자자의 합리적인 요구에 대하여 응합니다." fontsize="-2" impidxs="" />
								<CELL cell_ly="0,5,0,5" valign="0" line="0,0" caption="·" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,5,1,5" valign="0" halign="0" line="0,0" caption="랩어카운트의 수수료는 각 계약의 내용 및 협의 등에 따라
다르게 결정될 수 있으니 계약 전 수수료에 관한 사항을 명
확히 확인 하시기 바랍니다." fontsize="-2" impidxs="" />
								<CELL cell_ly="0,6,0,6" valign="0" line="0,0" caption="·" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,6,1,6" valign="0" halign="0" line="0,0" caption="성과보수를 수취하는 경우 성과보수가 없는 경우보다 공격
적 재산운용이 이루어질 수 있습니다." fontsize="-2" impidxs="" />
								<CELL cell_ly="0,7,0,7" valign="0" line="0,0" caption="·" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,7,1,7" valign="0" halign="0" line="0,0" caption="과거의 운용실적이 미래의 수익을 보장하는 것은 아니며,
가입시점에 따라 계좌별 운용 수익률이 달라질 수 있습니다." fontsize="-2" impidxs="" />
								<CELL cell_ly="0,8,0,8" valign="0" line="0,0" caption="·" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,8,1,8" valign="0" halign="0" line="0,0" caption="랩어카운트는 운용 특성상 소수종목에 투자하기 때문에
수익률의 변동성이 집합투자기구에 비해 더 커질 수 있습
니다." fontsize="-2" impidxs="" />
								<CELL cell_ly="0,9,0,9" valign="0" line="0,0" caption="·" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,9,1,9" valign="0" halign="0" line="0,0" caption="환율 변동에 따라 투자자산 가치가 변동될 수 있으며, 투자
대상국의 시장, 정치 및 경제상황 등에 따른 위험으로 자산
가치의 손실이 발생할 수 있습니다." fontsize="-2" impidxs="" />
								<CELL cell_ly="0,10,0,10" valign="0" line="0,0" caption="·" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,10,1,10" valign="0" halign="0" line="0,0" caption="과세 기준 및 과세 방법은 향후 세법 개정 등에 따라 변동될
수 있습니다." fontsize="-2" impidxs="" />
								<CELL cell_ly="0,11,0,11" line="0,0" fontsize="-2" impidxs="" />
								<CELL cell_ly="1,11,1,11" line="0,0" fontsize="-2" impidxs="" />
