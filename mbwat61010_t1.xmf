'                2024.06.28 : 고승연 : v0005 : 예금자보호 문구 수정
'-------------------------------------------------------------------------------------------

'============================================================================
Sub Form_OnFormInitBefore()
	contInfo.imgTopTitle.setMaintainingRatio("1")
	contInfo.imgInfo0.setMaintainingRatio("1")
	contInfo.imgTitle0.setMaintainingRatio("1")
	contInfo.imgTitle1.setMaintainingRatio("1")
	contInfo.imgSubIcon0.setMaintainingRatio("1")
	contInfo.imgSubIcon1.setMaintainingRatio("1")
	contInfo.imgSubIcon2.setMaintainingRatio("1")
	contInfo.imgSubIcon3.setMaintainingRatio("1")
	contInfo.imgTitle2.setMaintainingRatio("1")
	contInfo.imgInfo.setMaintainingRatio("1")
	contInfo.contCheck.Image1.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	contInfo.SetScrollAutoSize()
	contInfo.contCheck.SetScrollAnimation(true)
End Sub

'============================================================================
Sub contInfo_contCheck_btnFold_OnClick()
	Dim szimgFile

	if bFoldState then
		szimgFile = "btn_filter.9.png"
	else
		szimgFile = "btn_filter2.9.png"
	end if
	
	bFoldState = not bFoldState
	contInfo.contCheck.btnFold.btnimage = szimgFile
	f_ShowInfo(bFoldState)
End Sub

'============================================================================
Function f_ShowInfo(bState)
	if bState then
		contInfo.contCheck.height = 565
		contInfo.SetScrollAutoSize()
		contInfo.scroll_pos = 1300
	else
		contInfo.contCheck.height = 32
		contInfo.SetScrollAutoSize()
		contInfo.scroll_pos = 870
	end if
End Function 

