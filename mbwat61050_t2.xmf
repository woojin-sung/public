--===========================================================================
--===========================================================================

'============================================================================
Sub Form_OnFormInit()
	grdData.visible = false
	grdData.SetClear()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "Clear" then
		grdData.visible = false
		grdData.SetClear()
		
	elseif sEventName == "Request" then
		grdData.visible = true
		grdData.SetClear()
		
		if sParam <> null and sParam <> "" then
			Dim tData
			tData = Split(sParam, "|")
			
			if tData(0) == null or tData(0) == "" or tData(1) == null or tData(1) == "" then
				Exit Sub
			end if
			
			DATAMANAGER.SetDataValue( 0, "obwat_mgmt_256r", "InBlock1", "WA_ACNO" , 0 , tData(0) )
			DATAMANAGER.SetDataValue( 0, "obwat_mgmt_256r", "InBlock1", "WA_CNRC_NO" , 0 , tData(1) )
			DATAMANAGER.SetDataValue( 0, "obwat_mgmt_256r", "InBlock1", "IQRY_CLS_CODE" , 0 , "0" )
			
			DATAMANAGER.RequestTranData( "obwat_mgmt_256r" )
		end if
	end if
End Sub

'============================================================================
'코드 치환
Sub SetGridData(szTranID)
	'--------------------------------------
	'구분
	'--------------------------------------
	Dim i, sCode, sText
	
	For i = 0 to grdData.rowcount-1
		sCode = grdData.GetCellData( "bd_cell0" , i )
		
		Select Case sCode
			Case "01"
				sText = "주식"
			Case "02"
				sText = "채권"
			Case "03"
				sText = "집합투자증권"
			Case "04"
				sText = "RP"
			Case "05"
				sText = "선물옵션"
			Case "06"
				sText = "발행어음"
			Case "09"
				sText = "해외주식"
			Case "00"
				sText = "예수금"
			Case "99"
				sText = "외화예수금"
		End Select
		
		grdData.SetCellData( "bd_cell0", i, sText)
	Next
End Sub

'============================================================================
'합계 계산(FootHeader에서 합계 기능 지원하지 않아 스크립트로 계산)
Sub CalSum()
	If grdData.rowcount == 0 then
		Exit Sub
	End If
	
	Dim i, nAmt, nTotalAmt
	
	grdData.AddRow( )
	grdData.SetCellData( "bd_cell0", grdData.rowcount-1, "합계" )
	
	'평가금액
	nTotalAmt = 0
	For i = 0 to grdData.rowcount-2
		nAmt = CDbl(grdData.GetCellData( "bd_cell1" , i )) 
		nTotalAmt = nTotalAmt + nAmt
	Next
	
	grdData.SetCellData( "bd_cell1", grdData.rowcount-1, nTotalAmt )
	
	'대출잔액
	nTotalAmt = 0
	For i = 0 to grdData.rowcount-2
		nAmt = CDbl(grdData.GetCellData( "bd_cell2" , i )) 
		nTotalAmt = nTotalAmt + nAmt
	Next
	
	grdData.SetCellData( "bd_cell2", grdData.rowcount-1, nTotalAmt )
	
	'매입금액
	nTotalAmt = 0
	For i = 0 to grdData.rowcount-2
		nAmt = CDbl(grdData.GetCellData( "bd_cell3" , i )) 
		nTotalAmt = nTotalAmt + nAmt
	Next
	
	grdData.SetCellData( "bd_cell3", grdData.rowcount-1, nTotalAmt )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obwat_mgmt_256r" Then
		Call SetGridData(szTranID)		'코드 치환
		Call CalSum()					'합계계산
	End If
End Sub

