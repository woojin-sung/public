'============================================================================
' 01.화면명 	: 해외지수
' 02.화면설명	: 해외지수_세부사항팝업
' 03.작성	: 2016.01.05
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_szSymbol
dim g_szMarket
dim g_szName

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
'Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	'chartEx.SetChartType	="line"

End Sub
'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim szListItems
	dim szLinkData
	
	szLinkData = Form.GetOpenLinkData()
	
	

	'chartEx.SetAccrueName("가격=1")	
	chartEx.SetPeriodType(0)			'0:틱, 1:분, 2:일자
	chartEx.setViewDataCount(-1)
	chartEx.setDeleteIndicaBlock("거래량")
	
	if len(szLinkData)  >	0	then
		szListItems = split(szLinkData, "★")
		g_szSymbol = szListItems(0)
		g_szMarket = szListItems(1)
		g_szName =  szListItems(2)
		
		Form.SetScreenName(g_szName)
		
		if	trim(g_szMarket)	=	"EN"		then			'환율
			grdEN.left	=	0
			grd01.left	=	400
		

			DATAMANAGER.RequestTranData("ohhts_1683_004r")		'그리드
			DATAMANAGER.RequestTranData("ohhts_1683_005r")		'차트
		else										'그외
			grdEN.left	=	400
			grd01.left	=	0
	
			DATAMANAGER.RequestTranData("ohhts_1683_002r")		'그리드
			DATAMANAGER.RequestTranData("ohhts_1683_002r_1")		'차트
		end	if
				
	end if 

End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.CancelRealData("ohhts_ovrs_nmix")
	DATAMANAGER.CancelRealData("ohhts_nfut_cntg")
	DATAMANAGER.CancelRealData("ohhts_exrt_cntg")


	if	szTranID	=	"ohhts_1683_002r"	then
		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarket  )
		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r", "InBlock1", "FID_INPUT_ISCD", 0, g_szSymbol )
		
		if	g_szMarket	=	"FN"		then
			DATAMANAGER.RequestRealData("ohhts_nfut_cntg")
		else
			DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")
		end	if
		
	elseif	szTranID	=	"ohhts_1683_002r_1"	then
		ChartEx.setDecimal("2")	' 소수점 2자리

		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarket  )
		DATAMANAGER.SetDataValue(0, "ohhts_1683_002r_1", "InBlock1", "FID_INPUT_ISCD", 0, g_szSymbol )
		
	elseif	szTranID	=	"ohhts_1683_004r"	then
		DATAMANAGER.SetDataValue(0, "ohhts_1683_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarket  )
		DATAMANAGER.SetDataValue(0, "ohhts_1683_004r", "InBlock1", "FID_INPUT_ISCD", 0, g_szSymbol )
		
	elseif	szTranID	=	"ohhts_1683_005r"	then
		ChartEx.setDecimal("2")	' 소수점 2자리

		DATAMANAGER.SetDataValue(0, "ohhts_1683_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarket  )
		DATAMANAGER.SetDataValue(0, "ohhts_1683_005r", "InBlock1", "FID_INPUT_ISCD", 0, g_szSymbol )
	
	end if 
End Sub


