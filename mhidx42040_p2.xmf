'============================================================================
'chartEx_OnScrollEnd
'============================================================================
Sub chartEx_OnScrollEnd()
	if	trim(g_szMarket)	=	"EN"		then			'환율
		DATAMANAGER.RequestTranData("ohhts_1683_005r")		'차트	
	else
		DATAMANAGER.RequestTranData("ohhts_1683_002r_1")		'차트
	end	if
End Sub



