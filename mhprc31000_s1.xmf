'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
 
		'20160705 NOHES START	MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) = 0 Then
			g_szItemMarket = "F"			
		end if
		'20160705 NOHES END

		if g_szItemMarket = "JF" or g_szItemMarket = "JO" Then
			DATAMANAGER.RequestTranData( "ohhts_3070_001r" )
		else
			DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
		end if
		
	 end if
	 
	if sEventName = "sharedata" then
		Dim szFlag
	
		sName = Form.GetItemCodeInfo(g_szItemCode, "name")
		sCurpirce = FormatNumber( tblHoga.GetCellString(0, 1),  2)
		
		If CDbl(tblHoga.GetCellString(0, 5)) > 0 Then
			szFlag	= "▲"			
		ElseIf CDbl(tblHoga.GetCellString(0, 5)) < 0 Then
			szFlag	= "▼"
		Else
			szFlag	= ""
		End If
		
		sDiff    = FormatNumber( abs(tblHoga.GetCellString(0, 5)),  2)		
		sRate     = FormatNumber( tblHoga.GetCellString(0, 6),  2)
		sQuqn	 = FormatNumber( tblHoga.GetCellString(1, 5),  0)
		szParam = sName.."\n"..sCurpirce.."\n ("..szFlag..sDiff.." / "..sRate.."% / "..sQuqn..")"
		Form.triggerEvent("#", "sharedata", szParam)
	end if

End Sub

'============================================================================
Sub btnItemLeft_OnClick()
	Move_ItemCode( "Left" )
End Sub

'============================================================================
Sub btnItemRight_OnClick()
	Move_ItemCode( "Right" )
End Sub
'============================================================================
Sub Form_OnRefresh()
	if g_szItemMarket = "JF" or g_szItemMarket = "JO" Then
		DATAMANAGER.RequestTranData( "ohhts_3070_001r" )
	else
		DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
	end if	
End Sub


