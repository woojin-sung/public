'----------------------------------------------------------------------------
' 01. 화 면 명 : 서브_종목검색창
' 02. 화면설명 : 주식현재가 종목검색창
' 03. 작    성 : 2016.04.30 LJS
'----------------------------------------------------------------------------
' 20240412 HSZ : 코스닥글로벌지수 추가 (KF)
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket

Dim g_szCurtouch								' 현재가 터치이동 ( 최근조회종목("0"),관심종목("1"),watching등록종목("2") - 초기값 "0" )
Dim g_szSwingGroup							' 관심종목일경우 관심그룹키
Dim g_szInterest_cloud							' 관심종목동기화(0:로컬, 1:서버)

Dim g_szSearchItems							' 조회종목(최근조회종목, 관심종목, Watching종목)
Dim g_nIndexItem								' 조회종목의 Index
Dim g_bMoveItem								' 화면에서 발생 여부


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Set_RotateItem
'============================================================================
Function Set_RotateItem()
	If g_szCurtouch = "0" Then			' 최근조회종목
		Get_History()
	ElseIf g_szCurtouch = "1" Then
	
	ElseIf g_szCurtouch = "2" Then
	
	End If
	
End Function

'============================================================================
' Get_History
'============================================================================
Function Get_History()
	Dim szData, arrData, nCnt

	szData = Form.GetRecentHistory( "2" )
	
	If Trim( szData ) = "" Then
		Exit Function
	End If
	
	g_szSearchItems = Split(szData,"`")
	
	if UBOUND(g_szSearchItems) < 1 then
	    Exit Function
	End if	
	
	For i = #g_szSearchItems - 1 To 0 Step - 1
		If g_szItemCode = Trim( g_szSearchItems(i) ) Then
			g_nIndexItem = i
			Exit For
		End If
	Next

End Function

'============================================================================
' Move_ItemCode
'============================================================================
Function Move_ItemCode( szType )
	
	If szType = "Right" Then
		If g_nIndexItem = #g_szSearchItems - 1 Then
			g_nIndexItem = 0
		Else
			g_nIndexItem = g_nIndexItem + 1
		End If
	
	ElseIf szType = "Left" Then
		If g_nIndexItem = 0 Then
			g_nIndexItem = #g_szSearchItems-1
		Else
			g_nIndexItem = g_nIndexItem - 1			
		End If
		
	End If
	
	g_bMoveItem = false
	
	g_szItemCode 	 = g_szSearchItems( g_nIndexItem )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

	'20160705 NOHES START	MarketType Default : "F"로 결정
	if Len(Trim(g_szItemMarket)) = 0 Then
		g_szItemMarket = "F"			
	end if
	'20160705 NOHES END


	Form.SetItemCode(0)
	
	if g_szItemMarket = "JF" or g_szItemMarket = "JO" Then
		DATAMANAGER.RequestTranData( "ohhts_3070_001r" )
	else
		DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
	end if
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Function SetHogaTblFgColor( nPrice )

	If nPrice  > 0 then 
		tblHoga.SetCellFgColor( 0, 1, "10" )
	ElseIf nPrice < 0 then 
		tblHoga.SetCellFgColor( 0, 1, "11" )
	Else
		tblHoga.SetCellFgColor( 0, 1, "12" )
	End If

End Function


'============================================================================
Sub Form_OnFormInitBefore()
	g_szCurtouch		 = Form.GetEnvData( "common.curtouch_swing" 		)	' 현재가 터치이동
	g_szSwingGroup	 = Form.GetEnvData( "common.curtouch_swing_group"	)	' 관심종목일경우 관심그룹키
	g_szInterest_cloud = Form.GetEnvData( "common.interest_cloud" 		)	' 관심종목동기화(0:로컬, 1:서버)
	
	If g_szCurtouch = "" Then
		g_szCurtouch = "0"
	End If
	
	If g_szSwingGroup = "" Then
		g_szSwingGroup = ""
	End If
	
	If g_szInterest_cloud = "" Then
		g_szInterest_cloud = "0"
	End If
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_bMoveItem 	= true
	g_nIndexItem = 0
	Set_RotateItem()
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	'Form.ShowAlert(sKey, sValue)
	If sKey = "ITEMCODE" Then
		g_continue_Code = ""
		if sValue = "continue" then
			g_szItemCode = "101000"
			g_szItemMarket = "F"
		
		'-------------------------------------------------------------------
		'20170208 LES START - 미니 KOSPI 연결선물 추가
		'-------------------------------------------------------------------
		elseif sValue = "continue_mini" then
			g_szItemCode = "105000"
			g_szItemMarket = "MF"
			
		'20180308_01 KBC START : KRX300 & KSQ150상품추가
		elseif sValue = "continue_108000" then
			g_szItemCode = "108000"
			g_szItemMarket = "XF"

		elseif sValue = "continue_106000" then
			g_szItemCode = "106000"
			g_szItemMarket = "F"
		'20180308_01 KBC END
		
		' 20240412 HSZ START : 코스닥글로벌지수 추가
		elseif sValue = "continue_1AG000" then
			g_szItemcode = "1AG000"
			g_szItemMarket = "KF"
		' 20240412 HSZ END
		
		elseif Left(Trim(sValue),9) = "continue_" then
			g_continue_Code = sValue
			g_szItemMarket = "JF"
			g_szItemCode = Right(Trim(sValue),Len(Trim(sValue)) - 9)
		'-------------------------------------------------------------------
		'20160208 LES END
		'-------------------------------------------------------------------
			
		else
			if g_bMoveItem = true Then
				g_szItemCode = sValue
				g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
				
				'20160705 NOHES START	MarketType Default : "F"로 결정
				if Len(Trim(g_szItemMarket)) = 0 Then
					g_szItemMarket = "F"			
				end if
				'20160705 NOHES END
			
				Set_RotateItem()
			end if
		End If
		
		if g_szItemMarket = "JF" or g_szItemMarket = "JO" Then
			DATAMANAGER.RequestTranData( "ohhts_3070_001r" )
		else
			DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
		end if
		
	end	if
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	

	DATAMANAGER.CancelRealData( "ohhts_nmix_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_futs_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_optn_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_sfut_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_sopt_cntg" )
	
	'20220915 LES START 상품선물 추가
	DATAMANAGER.CancelRealData( "ohhts_cfut_cntg" )
	'20220915 LES END

	if szTranID = "ohhts_3050_001r" then		
		tblHoga.SetCellMaskInfo( 0, 1, "0,0,,,0,,2,1,1" )
		tblHoga.SetCellMaskInfo( 0, 5, "0,0,,,0,,2,1,1" )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"  , 0 , g_szItemMarket )
	
	elseif szTranID = "ohhts_3070_001r" then
		tblHoga.SetCellString( 1, 7, "" )				' 전일대비거래량비율 없음.
		tblHoga.SetCellMaskInfo( 0, 1, "0,0,,,0,,0,1,0" )
		tblHoga.SetCellMaskInfo( 0, 5, "0,0,,,0,,0,1,0" )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_3070_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"  , 0 , g_szItemMarket )
	
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)

	If szTranID = "ohhts_nmix_cntg" then
		DATAMANAGER.SetDataValue( 1,  "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE" , 0 , "K2G01P" )		'20221111 SWJ START : 거래소 차세대 업종코드 하드코딩 ( 2029 -> K2G01P )
		
	ElseIf szTranID = "ohhts_futs_cntg" then
	
		'20170427 LES START - 연결선물일 경우 최근월물로 실시간 올림
		if g_szItemCode = "101000" then
			szCode = Form.GetFutureCode(0, false, true)
			DATAMANAGER.SetDataValue( 1,  "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" 	, 0 , szCode )
		
		elseif g_szItemCode = "105000" then
			szCode = Form.GetFutureCode(0, true, true)
			DATAMANAGER.SetDataValue( 1,  "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" 	, 0 , szCode )
		
		'20180308_01 KBC START : KRX300 & KSQ150상품추가
		elseif g_szItemCode = "108000" then
			szCode = Form.GetFutureCodeNew(0, 2, true) '0.코스피200 1.미니코스피 2.KRX300 3.KSQ150
			DATAMANAGER.SetDataValue( 1,  "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" 	, 0 , szCode )
			
		elseif g_szItemCode = "106000" then
			szCode = Form.GetFutureCodeNew(0, 3, true) '0.코스피200 1.미니코스피 2.KRX300 3.KSQ150
			DATAMANAGER.SetDataValue( 1,  "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" 	, 0 , szCode )			
		'20180308_01 KBC END
		
		' 20240412 HSZ START : 코스닥글로벌지수 추가
		elseif g_szItemCode = "1AG000" then
			szCode = Form.GetFutureCodeNew(0, 4, true)
			DATAMANAGER.SetDataValue( 1,  "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" 	, 0 , szCode )	
		' 20240412 HSZ END

		else
			DATAMANAGER.SetDataValue( 1,  "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" 	, 0 , g_szItemCode )
		end if
		
	ElseIf szTranID = "ohhts_optn_cntg" then
		DATAMANAGER.SetDataValue( 1,  "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD"  	, 0 , g_szItemCode )
	
	ElseIf szTranID = "ohhts_sfut_cntg" then
'		if Left(Trim(g_continue_Code),9) = "continue_" then
'			szCode = Form.GetFutureCode(0, false, true)
			
'		Form.ShowAlert( "", g_szItemCode )
		DATAMANAGER.SetDataValue( 1,  "ohhts_sfut_cntg", "InBlock1", "FIDR_SHRN_ISCD" 	, 0 , g_szItemCode )
'		else
'			
'			DATAMANAGER.SetDataValue( 1,  "ohhts_sfut_cntg", "InBlock1", "FIDR_SHRN_ISCD" 	, 0 , g_szItemCode )
'		end if
	ElseIf szTranID = "ohhts_sopt_cntg" then
		DATAMANAGER.SetDataValue( 1,  "ohhts_sopt_cntg", "InBlock1", "FIDR_SHRN_ISCD" 	, 0 , g_szItemCode )
		
	'20220915 LES START 상품선물 추가
	elseif szTranID = "ohhts_cfut_cntg" then
		DATAMANAGER.SetDataValue( 1,  "ohhts_cfut_cntg", "InBlock1", "FIDR_SHRN_ISCD" 	, 0 , g_szItemCode )
	'20220915 LES END
		
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim 	szItemCodeInfo
	Dim 	nPrice					'전일대비
	
	
	'------------------------------------------------------------------------------
	'20170213 LES START
	'------------------------------------------------------------------------------
	if szTranID = "ohhts_3050_001r" then
			
		if g_szItemCode = "101000" then
			szlscd = "101000"

		elseif g_szItemCode ="105000" then
			szlscd = "105000"
			
		'20180308_01 KBC START : KRX300 & KSQ150상품추가
		elseif g_szItemCode ="108000" then
			szlscd = "108000"
			
		elseif g_szItemCode ="106000" then
			szlscd = "106000"			
		'20180308_01 KBC END
			
		' 20240412 HSZ START : 코스닥글로벌지수 추가
		elseif g_szItemCode = "1AG000" then
			szlscd = "1AG000"
		' 20240412 HSZ END
		
		else
			szlscd = DATAMANAGER.GetDataValue(0, "ohhts_3050_001r", "OutBlock1", "FID_SHRN_ISCD" , 0)
		end if
'		Form.ShowAlert( "", szlscd )
		
		tblHoga.SetCellString(1, 1, szlscd)

		'---------------------------------------------------------------------------------
		'20170213 LES END
		'----------------------------------------------------------------------------------
		
		nPrice = DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_PRDY_VRSS2" , 0 )
		' SetHogaTblFgColor( CDbl( nPrice ) )	
		
		If g_szItemMarket = "F" or  g_szItemMarket = "MF" or  g_szItemMarket = "XF" or  g_szItemMarket = "KF" then '20180308_01 KBC : KRX300 & KSQ150상품추가	' 20240412 HSZ START: 코스닥글로벌지수 추가
		    DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
		    
		'20220915 LES START 상품선물 추가
		elseif g_szItemMarket = "CF" or g_szItemMarket = "FF" then		'20221111 SWJ START : 거래소 차세대 상품코드 분리 (CF -> CF,FF)
			DATAMANAGER.RequestRealData( "ohhts_cfut_cntg" )
		'20220915 LES END
		    
		ElseIf g_szItemMarket = "O" or g_szItemMarket = "MO" or g_szItemMarket = "QO" or g_szItemMarket = "WO" then '20180308_01 KBC : KRX300 & KSQ150상품추가 ' 20190809_01 HWG : 위클리옵션추가
		    DATAMANAGER.RequestRealData( "ohhts_optn_cntg" )
		    
		End If
		
		DATAMANAGER.RequestRealData( "ohhts_nmix_cntg" )
		
		g_bMoveItem 	= true
	
	elseif szTranID = "ohhts_3070_001r" then
		
		if  Left(Trim(g_continue_Code),9) = "continue_" then
			szlscd = Right(Trim(g_continue_Code),Len(Trim(g_continue_Code)) - 9)
			g_szItemCode = DATAMANAGER.GetDataValue(0, "ohhts_3070_001r", "OutBlock1", "FID_SHRN_ISCD" , 0)
		else
			szlscd = DATAMANAGER.GetDataValue(0, "ohhts_3070_001r", "OutBlock1", "FID_SHRN_ISCD" , 0)
		end if
		
		tblHoga.SetCellString(1, 1, szlscd)
		
		If g_szItemMarket = "JF" then
		    DATAMANAGER.RequestRealData( "ohhts_sfut_cntg" )
		    
		ElseIf g_szItemMarket = "JO" then
		    DATAMANAGER.RequestRealData( "ohhts_sopt_cntg" )
		    
		End If
		
		g_bMoveItem 	= true
		
	end if
End Sub


