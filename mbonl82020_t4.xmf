'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 담보대출신청
' 02. 화면설명 : 담보대출신청_매도담보대출신청
' 03. 작    성 : 2016.02.01 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sAcc '계좌번호
Dim G_CALCU_FILE '대출이자가계산풀팝업
Dim G_NNPR_CORP_YN '비영리법인여부

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'===========================================================================
' 계좌비밀번호 입력체크함수
'===========================================================================
Function GetPWCkeck()
	Dim sACNT_PWD 
	sACNT_PWD = Form.GetCtlProp( "#EditPW2", "caption" )
	
	if sACNT_PWD == null or sACNT_PWD == "" then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	end if
	
	return false
End Function	

'===========================================================================
' 속성 초기화함수
'===========================================================================
Function SetControlViewClear()
	Table0.SetCellString( 0, 1, "" )
	Table0.SetCellString( 0, 3, "" )
	Table0.SetCellString( 3, 1, "" )
	Table0.SetCellString( 3, 2, "" )
	Table0.SetCellString( 3, 3, "" )
	Table0.SetCellString( 4, 1, "" )
	Table0.SetCellString( 4, 2, "" )
	Table0.SetCellString( 4, 3, "" )
	Table0.SetCellString( 5, 1, "" )
	Table0.SetCellString( 5, 2, "" )
	Table0.SetCellString( 5, 3, "" )
	Table0.SetCellString( 7, 4, "" )

	EditInput1.caption = ""
	EditInput2.caption = ""
End Function	

'===========================================================================
' 숫자 리턴함수
'===========================================================================
Function GetTonumber(sNum)
	Dim nDbl
	nDbl = 0
	
	if sNum == null or Trim(sNum) == "" then
		return nDbl
	end if
	
	nDbl = CDbl(sNum)
	
	return nDbl
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_sAcc = ""
	G_CALCU_FILE = "mbonl82020_p4"
	
	G_NNPR_CORP_YN = "N"
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "TabChange" then
		'비밀번호없이 조회되도록 요청하여 주석처리
'		if GetPWCkeck() then
'			Exit Sub
'		end if
		
		g_sAcc = sParam
		
		SetControlViewClear()	 
		DATAMANAGER.RequestTranData( "oblon_pros_811r" ) '대출가능금액조회
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sACNT_PWD 
	'sACNT_PWD = Form.GetCtlProp( "#EditPW2", "caption" )
	'MTS메모리보안
	'sACNT_PWD = Form.GetEncData(sACNT_PWD)
	Dim plain_rm
	
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then
		sACNT_PWD = Form.GetCtlProp( "#EditPW2", "caption" )
	else
		sACNT_PWD = Form.GetCtlProp( "#EditPW2", "encdata" )
	end if
	
	if szTranID == "oblon_pros_811r" then
		DATAMANAGER.SetDataValue( 0, "oblon_pros_811r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_811r", "InBlock1", "ASNO" , 0 , Right(g_sAcc, 2) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_811r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
	elseif szTranID == "oblon_pros_811a" then
		DATAMANAGER.SetDataValue( 0, "oblon_pros_811a", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_811a", "InBlock1", "ASNO" , 0 , Right(g_sAcc, 2) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_811a", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_811a", "InBlock1", "LOAN_AMT" , 0 , EditInput1.caption )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_811a", "InBlock1", "PRDY_NEW_LOAN_AMT" , 0 , EditInput2.caption )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "oblon_pros_811a" then
		Dim sMsg, sSubMsg
		sMsg = DATAMANAGER.GetDataMsgText( szTranID )
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			sMsg = sMsg.." "..sSubMsg
		end if
		
		Form.MsgBox( "알림", sMsg, "", 6 )
		
		SetControlViewClear()	 
		DATAMANAGER.RequestTranData( "oblon_pros_811r" ) '대출가능금액조회
	elseif szTranID == "oblon_pros_811r" then
		G_NNPR_CORP_YN = DATAMANAGER.GetDataValue(0, "oblon_pros_811r", "OutBlock1", "UI_NNPR_CORP_YN", 0)
		
		if G_NNPR_CORP_YN == "Y" then
			Form.MsgBox( "알림","비영리법인의 경우 해당 영업점으로 신청 바랍니다.", 6 )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	Form.MsgBox( "알림", szErrMsg, "", 6 )	
'	if szTranID == "oblon_pros_811a" then
'		Form.MsgBox( "알림", szErrMsg, "", 6 )	
'	end if
End Sub

'============================================================================
Sub ButtonInfo_OnClick()
	if GetPWCkeck() then
		Exit Sub
	end if
	
	Dim sSendData
	sSendData = g_sAcc..";"..Form.GetCtlProp( "#EditPW2", "caption" )
	Form.OpenFramePopup(G_CALCU_FILE , sSendData , "")
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if GetPWCkeck() then
		Exit Sub
	end if
	
	if GetTonumber(EditInput1.caption) == 0 and GetTonumber(EditInput2.caption) == 0 then
		Form.MsgBox( "알림", "대출신청금액을 확인해주세요.", "", 6 )
		Exit Sub
	end if
	
	if GetTonumber(EditInput1.caption) > GetTonumber(Table0.GetCellString( 5, 1 )) then
		Form.MsgBox( "알림", "대출신청가능금액을 확인해주세요.", "", 6 )
		Exit Sub
	end if
	
	if GetTonumber(EditInput2.caption) > GetTonumber(Table0.GetCellString( 5, 2 )) then
		Form.MsgBox( "알림", "대출신청가능금액을 확인해주세요.", "", 6 )
		Exit Sub
	end if
	
	if G_NNPR_CORP_YN == "Y" then
		Form.MsgBox( "알림","비영리법인의 경우 해당 영업점으로 신청 바랍니다.", 6 )
		Exit Sub
	end if
	
	'16-03-24 YCJ 전요셉과장님이 추가인증 추가 요청
	Form.SetSharedData( "CERT_ACNO" , Left(g_sAcc , 8) )
		
	Dim szData, szSaleSum, szName
	szSaleSum = CDbl(EditInput1.caption) + CDbl(EditInput2.caption)
	szName = Form.GetCtlProp( "#Account2", "accountname")
	'화면구분값, 대출금액합
	szData = "sale_loan" & "★" & szSaleSum & "★" & szName
	Form.OpenFramePopup( "mhetc90060_p8" , szData , sPosInfo)		'16-03-24 YCJ 전요셉과장님이 추가인증 요청
	
'	DATAMANAGER.RequestTranData( "oblon_pros_811a" ) '대출신청
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "mhetc90060_p8" then
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		end if 
	elseif sKeyName == "mhetc90060_p5" then
		if sRet ~= "cancel" then				
			DATAMANAGER.RequestTranData( "oblon_pros_811a" ) '대출신청
		end if 
	end if
	
End Sub

	</SCRIPT_INFO>
