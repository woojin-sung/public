'============================================================================
' 01. 화 면 명 : 
' 02. 화면설명 : 
' 03. 작    성 : 

'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
'============================================================================
Dim g_AryTitle, g_AryDate, g_AryUrl, g_AryszCls
Dim g_szTitle, g_szUrl, g_szDate, g_szCls
Dim g_Init
g_szTitle = ""
g_szUrl = ""
g_szDate = ""
g_szCls = ""

'============================================================================
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "ohhts_note_003r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_CLS" , 0 , "99" )	'00(공지사항),01(증거금변경)만 조회
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_CLS_CODE" , 0 , "02" )
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	Label1.fgcolor = 334
	
	DATAMANAGER.RequestTranData("ohhts_note_003r")
	g_Init = "0"

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_note_003r" then
		nDataCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		for i = 0 to 2
			szCls = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_CLS" , i)
			szTitle = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_TITL" , i)
			szDate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_REG_DATE" , i)
			szUrl = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_EXTS_URL_ADDR" , i)

			g_szTitle = g_szTitle..szTitle.."|"
			g_szDate	 = g_szDate..szDate.."|"
			g_szUrl = g_szUrl..szUrl.."|"
			g_szCls = g_szCls..szCls.."|"
		next
		g_AryTitle = Split(g_szTitle,"|")
		g_AryDate = Split(g_szDate,"|")
		g_AryUrl = Split(g_szUrl,"|")
		g_AryCls = Split(g_szCls,"|")
		if g_Init = "0" then
			FormTab0.currenttab = 0
			Form.TriggerEvent( "FormTab0."..FormTab0.currenttabpageid, "HOME_NOTICE", g_AryTitle(0).."|"..g_AryDate(0).."|"..g_AryUrl(0).."|"..g_AryCls(0).."|")
			g_Init = "1"
		end if
	end if
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	if nCurrentTab = 0 then
		Image7.imgpath = "icon_3step1"

	elseif nCurrentTab = 1 then
		Image7.imgpath = "icon_3step2"

	else
		Image7.imgpath = "icon_3step3"

	end if
	szTriggerData = g_AryTitle(nCurrentTab).."|"..g_AryDate(nCurrentTab).."|"..g_AryUrl(nCurrentTab).."|"..g_AryCls(nCurrentTab).."|"
	Form.TriggerEvent( "FormTab0."..FormTab0.currenttabpageid, "HOME_NOTICE", szTriggerData)
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.SetMaintainingRatio("1")
	Image7.SetMaintainingRatio("1")
	Image1.SetMaintainingRatio("1")
End Sub

'============================================================================
Sub lbl0_OnClick()
	Form.triggerEvent("#", "HOME_SCROLL", "")
	Form.OpenScreen("90100" , "")
End Sub

'============================================================================
Sub Form_OnRefresh()
	DATAMANAGER.RequestTranData("ohhts_note_003r")
	g_Init = "0"
End Sub

	</SCRIPT_INFO>
