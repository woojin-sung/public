	<SCRIPT_INFO _len="7819" _ulen="7075" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 공인인증서
' 02. 화면설명 : 공인인증서_부가정보
' 03. 작    성 : 2016.01.13 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sUserID 

'-----------------------------------------------------------------------
Dim g_nLinkGubn		'1:지점개설계좌ID등록 화면에서 팝업, 2:ID비밀번호재설정 화면에서 팝업, 0:그외 화면에서 팝업
Dim g_sSendData		'마지막 팝업화면으로 각 페이지의 입력 데이터 전달
Dim g_szList			'g_sSendData Split Array

'ID비밀번호재설정 화면에서 팝업(g_nLinkGubn = 2)
'g_szList(0) : "ChangePswd"
'g_szList(1) : 사용자ID
'g_szList(2) : 계좌번호
'g_szList(3) : 신규비밀번호

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_sRetData = "cancel"
	Form.SetScreenName( "보안매체 인증" )
	Combo1.cbkeydata = "2"	
		
	g_sSendData = Form.GetOpenLinkData()
	g_szList = Split(g_sSendData,"★")	
	
	'그외 화면에서 팝업시
	if UBOUND(g_szList) < 1 then
		g_sUserID = Form.GetSharedData("CERT_ID" , false)
		if g_sUserID == null or g_sUserID == "" then
			g_sUserID = Form.GetSharedData("&USER_ID" , false)
		end if
	
		if g_sUserID ~= null and g_sUserID ~= "" then
			DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
		end if
			
	else
		'ID비밀번호 재설정 화면에서 팝업시
		if g_szList(0) == "ChangePswd" then
			g_nLinkGubn = 2
			g_sUserID = g_szList(1)
			DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회			
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p5" then
		if sRet == "ok" then
			g_sRetData = "ok"
			Form.CloseForm( )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "1" ) '전자금융ID
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
	elseif szTranID == "obcsb_aaif_000r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_aaif_000r", "InBlock1", "INPUT_CLS" , 0 , "2" ) '전자금융ID
		DATAMANAGER.SetDataValue( 0, "obcsb_aaif_000r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_aaif_000r", "InBlock1", "ADIF_CNFR_QSTN_CNTT1" , 0 , Combo0.cbkeydata )
		DATAMANAGER.SetDataValue( 0, "obcsb_aaif_000r", "InBlock1", "ADIF_CNFR_ANSR_CNTT1" , 0 , EditInput1.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_aaif_000r", "InBlock1", "ADIF_CNFR_QSTN_CNTT2" , 0 , Combo1.cbkeydata )
		DATAMANAGER.SetDataValue( 0, "obcsb_aaif_000r", "InBlock1", "ADIF_CNFR_ANSR_CNTT2" , 0 , EditInput2.caption )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		Dim sRSLT_CLS, sSCRC_STAT_CODE, sADIF_CNFR_QSTN_CNTT1, sADIF_CNFR_QSTN_CNTT2
		
		'결과구분 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "RSLT_CLS" , 0 )
		'상태코드 0:정상, 1:매체사고, 2:비번오류횟수초과, 6:사용등록안됨
		sSCRC_STAT_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "SCRC_STAT_CODE" , 0 )
		sADIF_CNFR_QSTN_CNTT1 = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "ADIF_CNFR_QSTN_CNTT1" , 0 )
		sADIF_CNFR_QSTN_CNTT2 = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "ADIF_CNFR_QSTN_CNTT2" , 0 )
	
		if sRSLT_CLS == "1" then '부가정보
			if sSCRC_STAT_CODE == "0" then '정상
				ButtonOK.enable = true
				
				'16-04-04 YCJ 콤보 선택 함수 변경
				Combo0.currentindex = CInt(sADIF_CNFR_QSTN_CNTT1) - 1
				Combo1.currentindex = CInt(sADIF_CNFR_QSTN_CNTT2) - 1
'				Combo0.cbkeydata = CInt(sADIF_CNFR_QSTN_CNTT1)
'				Combo1.cbkeydata = CInt(sADIF_CNFR_QSTN_CNTT2)				
			elseif sSCRC_STAT_CODE == "1" then '매체사고	
				Form.MsgBox( "알림", "매체사고 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "2" then '비번오류횟수초과	
				Form.MsgBox( "알림", "비밀번호 오류초과 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "6" then '사용등록안됨	
				Form.MsgBox( "알림", "사용등록이 안되었습니다.", "", 6 )
			else '그외
				Form.MsgBox( "알림", "미지정 상태입니다.", "", 6 )
			end if
		end if
	elseif szTranID == "obcsb_aaif_000r" then
		Dim sPROS_RSLT_CODE, sADIF_MSTK_TMNU
		
		'결과구분 0:정상 그외에러
		sPROS_RSLT_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_aaif_000r", "OutBlock1", "PROS_RSLT_CODE" , 0 )
		'부가정보오류횟수
		sADIF_MSTK_TMNU = DATAMANAGER.GetDataValue( 0, "obcsb_aaif_000r", "OutBlock1", "ADIF_MSTK_TMNU" , 0 )
		
		if sPROS_RSLT_CODE == "0" then '정상
			if CInt(sADIF_MSTK_TMNU) > 5 then '에러
				Form.MsgBox( "알림", "부가정보 입력 오류 횟수 초과입니다.", "", 6 )
			else
				'ID비밀번호재설정 화면에서 팝업시
				if g_nLinkGubn == 2 then	
					Form.OpenFramePopup( "mhetc90060_p5" , g_sSendData , sPosInfo)	'공인인증서 인증 화면 팝업
				else
					g_sRetData = "ok"
					Form.CloseForm( )
				end if
			end if 
		else
			Dim sMsg, sSubMsg 
			sMsg = DATAMANAGER.GetDataMsgText( szTranID )
			sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
			Form.MsgBox( "알림", sMsg.." "..sSubMsg, "", 6 )
		end if
	end if
End Sub
 
'============================================================================
Sub ButtonOK_OnClick()
	if (EditInput1.caption == null or EditInput1.caption == "" ) or
		(EditInput2.caption == null or EditInput2.caption == "" ) then
		Form.MsgBox( "알림", "부가정보 답변을 입력해주세요.", "", 6 )
	else
		DATAMANAGER.RequestTranData( "obcsb_aaif_000r" ) '부가정보확인
	end if
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub Form_OnFormClose()	
	Form.SendReturnToParent( "mhetc90060_pa" , g_sRetData )
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szErrMsg ~= "" or szErrMsg ~= Null then
		szErrMsg = szErrMsg.."("..szSubErr..")"
	end if
	
	if szTranID == "obcsb_aaif_000r" then
		Form.ShowAlert( "알림", szErrMsg)
	end if
	
End Sub
'============================================================================
Sub ButtonPhone_OnClick()
	Form.SendReturnToParent("mhetc90060_ph","")
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
