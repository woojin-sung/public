	<SCRIPT_INFO _len="4889" _ulen="4403" >
Dim gbLargeFont			'큰글씨 사용여부
Dim gsLargeFontsize		'큰글씨 폰트크기(1:조금크게 2:크게)

gbLargeFont = false
gsLargeFontsize = 0

Dim gOsType

'============================================================================
Sub Form_OnFormInitBefore()

	gOsType = Form.GetSharedData("&OS_TYPE", false)

	LabelData0.paddinginfo = "0,0,0,0"
	LabelData1.paddinginfo = "0,0,0,0"
	LabelData2.paddinginfo = "0,0,0,0"
	LabelData3.paddinginfo = "0,0,0,0"
	LabelData4.paddinginfo = "0,0,0,0"
	LabelData5.paddinginfo = "0,0,0,0"
	LabelData6.paddinginfo = "0,0,0,0"
	LabelData7.paddinginfo = "0,0,0,0"
	LabelData8.paddinginfo = "0,0,0,0"
	LabelData9.paddinginfo = "0,0,0,0"
	LabelData10.paddinginfo = "0,0,0,0"
	LabelData11.paddinginfo = "0,0,0,0"
	LabelData12.paddinginfo = "0,0,0,0"
	
	LabelData0.transmode = "1"
	LabelData1.transmode = "1"
	LabelData2.transmode = "1"
	LabelData3.transmode = "1"
	LabelData4.transmode = "1"
	LabelData5.transmode = "1"
	LabelData6.transmode = "1"
	LabelData7.transmode = "1"
	LabelData8.transmode = "1"
	LabelData9.transmode = "1"
	LabelData10.transmode = "1"
	LabelData11.transmode = "1"
	LabelData12.transmode = "1"
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if CInt(szTextSize) > 0 then
		gbLargeFont = true
		gsLargeFontsize = szTextSize
	end if

	'--------------------------------------------------------------
	' 텍스트 속성 변경
	'--------------------------------------------------------------
	ChangeTextAttr("LabelData0")
	ChangeTextAttr("LabelData1")
	ChangeTextAttr("LabelData2")
	ChangeTextAttr("LabelData3")
	ChangeTextAttr("LabelData4")
	ChangeTextAttr("LabelData5")
	ChangeTextAttr("LabelData6")
	ChangeTextAttr("LabelData7")
	ChangeTextAttr("LabelData8")
	ChangeTextAttr("LabelData9")
	ChangeTextAttr("LabelData10")
	ChangeTextAttr("LabelData11")
	ChangeTextAttr("LabelData12")
	
	'--------------------------------------------------------------
	' 텍스트 입력
	'--------------------------------------------------------------
	LabelData0.caption = "오전장 10:30 ~ 13:00\n오후장 14:00 ~ 17:00"
	LabelData1.caption = "장전 동시호가\n(Opening Call Auction)"
	LabelData2.caption = "10:00~10:15 : 주문 접수, 정정, 취소(전일 종가 ±15% 이내)"
	LabelData3.caption = "10:15~10:20 : 주문 가능 / 정정, 취소 불가 (15분까지 접수된 최고 매도호가 ~ 최저 매수호가 사이 주문가능)"
	LabelData4.caption = "10:20~10:22 : 주문 매칭, 무작위 종료(매칭까지 주문가능, 정정 / 취소 불가)"
	LabelData5.caption = "10:22~10:30 : 주문불가"
	LabelData6.caption = "오전장 10:30 ~ 13:00\n점심휴장 13:00~14:00\n오후장 14:00 ~ 17:00"
	LabelData7.caption = "장마감 동시호가\n(Closing Auction Session)"
	LabelData8.caption = "17:00~17:01 : 종가산정(CAS가격 기준 산정)"
	LabelData9.caption = "17:01~17:06 : 주문 접수, 정정 취소(17:00 종가 ±5% 이내)"
	LabelData10.caption = "17:06~17:08 : 주문가능 / 정정, 취소 불가(17:06까지 접수된 최고 매도호가 ~ 최저 매수호가 사이 주문가능)"
	LabelData11.caption = "17:08~17:10 : 주문매칭, 무작위 장 종료(종료 전 주문 접수 가능)"
	LabelData12.caption = "18:00 ~ 익일 08:30"
	
	
End Sub
'============================================================================
Function ChangeTextAttr(sCtlName)
	
	'-------------------------------------
	' 글자크기 결정(큰글씨모드 대응)
	'-------------------------------------
	if gbLargeFont then
		
		if gOsType == "1" then
			sTargetTextSize = - Cint((gsLargeFontsize * 2))
		else
			sTargetTextSize = - Cint((gsLargeFontsize * 2))
		end if
		
		sTextSize = sTargetTextSize - 1
	else
		sTargetTextSize = -2
		sTextSize = sTargetTextSize - 1
	end if
	
	'-------------------------------------
	' 글자 크기변경
	'-------------------------------------
	Form.SetCtlProp(sCtlName, "fontsize", sTextSize)
	
