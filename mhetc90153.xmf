'============================================================================
Function CloudFunction(lRow)
	
	Select Case lRow
	
	'인증비밀번호 변경
	Case	 0,1,2
		
		Form.OpenPopup("mhetc90150_s3" , "ChangePwd" &  "★"  & g_sCloudCertID &  "★"  & g_sCloudCertDN, "")	
		
	'인증서 내려받기 
	Case 3,4,5
		Form.OpenPopup("mhetc90150_s3" , "DownloadToLocal" &  "★"  & g_sCloudCertID &  "★"  & g_nCloudIndex , "")
		
	'인증내역 조회
	Case 6,7,8
		Form.OpenPopup("mhetc90153_s2" , g_sCloudCertID  , "")
		
	'인증서 삭제
	Case 9,10,11
		
		Form.MsgBox("안내", "인증서를 클라우드에서 삭제하시겠어요?", "RemoveCloudCert", 7, "삭제", "취소")
		
	'인증서 갱신
	Case 12,13,14
		
		Form.MsgBox("안내", "클라우드인증서를 갱신하시겠어요?", "RenewCloudCert", 7, "갱신", "취소")
		
	End Select
	
End Function
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "RemoveCloudCert" then
		if sRet == "ok" then
			Form.OpenPopup("mhetc90150_s3" , "RemoveCloudCert" &  "★"  & g_sCloudCertID , "")
		end if
	elseif sKeyName == "RenewCloudCert" then
		if sRet == "ok" then
			'클라우드ID, 시리얼번호
			Form.OpenPopup("mhetc90150_s3" , "RenewCloudCert" &  "★"  & g_sCloudCertID &  "★"  & g_sCloudCertSerial , "")
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "CloudCertListReload" then
		Form.SetTimerEvent2(1,1,0.1)
		Form.SetTimerEvent2(3,1,0.1)
	end if
End Sub

'============================================================================
Sub Container0_contPinError_BtnUnLock_OnClick()
	Form.requestCertCommand("CLOUD_REQ_PIN_UNLOCK", g_sCloudCertID , "90153") 	
End Sub

