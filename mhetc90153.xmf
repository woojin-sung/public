'============================================================================
'20240418 SWJ START
'클라우드 인증 관리
'============================================================================
Dim g_Back_Flag   '뒤로가기플래그

g_Back_Flag = ""

'클라우드 연결 여부
Dim g_bNeedConnect
g_bNeedConnect = false

Dim g_bCloudCert
g_bCloudCert = false

Dim g_nCloudIndex
g_nCloudIndex = -1

Dim g_sCloudCertID
g_sCloudCertID = ""

Dim g_sCloudCertSerial
g_sCloudCertSerial = ""

Dim g_sCloudCertDN
g_sCloudCertDN = ""

'============================================================================
Sub Form_OnFormInitBefore()
	Container0.ImgBackPress.setMaintainingRatio("1")
	Container0.ImgInfo.setMaintainingRatio("1")
	Container0.contYesCert.ImgCert.setMaintainingRatio("1")
	
	Form.transmode = false 'true 불투명, false 투명
	
	szDev = Form.GetSharedData("&SERVER_MODE", False)
	
	if szDev == "1" then
		Container0.Button0.visible = true
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	Form.transmode = true 'true 불투명, false 투명
	Container0.visible = true

	Form.SetTimerEvent2(1,1,0.1)
	Form.SetTimerEvent2(3,1,0.1)
	
End Sub

'
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'클라우드연결(고객정보) 입력 -> 기기인증 후 리턴 (From mhetc90303)
		'InProgress 진행중
		'Complete 완료
		'Canceled 취소
		'AuthCodeDoesNotMatch 인증번호 불일치
		'Timeout 타임아웃
		'AuthCodeInvalidated 인증코드 전송횟수 초과

	if sKeyName == "CLOUDCERT_DEVICE_AUTH" then
		' sRet
		' 	- InProgress 진행중
		' 	- Complete 완료
		' 	- Canceled 취소
		' 	- AuthCodeDoesNotMatch 인증번호 불일치
		' 	- Timeout 타임아웃
		' 	- AuthCodeInvalidated 인증코드 전송횟수 초과		
		
		if sRet == "Complete" then
			'PIN 5회 잠김 해제
			Form.OpenPopup("mhetc90150_p2" , "PinUnlock" , "")
			
		elseif sRet == "Canceled" then
			Form.MsgBox("알림", "클라우드연결을 위한 단말인증이 취소되었습니다.", "", 0)
			
		elseif sRet == "AuthCodeDoesNotMatch" then
			Form.MsgBox("알림", "클라우드연결을 위해 입력한 인증번호가 맞지않습니다.", "", 0)
			
		elseif sRet == "Timeout" then
			Form.MsgBox("알림", "클라우드연결을 위한 인증유효시간이 지났습니다.", "", 0)				

		elseif sRet == "AuthCodeInvalidated" then
			Form.MsgBox("알림", "클라우드연결을 위한 인증코드 전송횟수가 초과되었습니다. .", "", 0)				
		end if		
		
		'Form.CloseForm()
		'Form.SendReturnToParent("CLOUD_CHECK_CONNECT", "NO")
	end if
	
	if sKeyName == "mhetc90152_p1" then
		if sRet <> "" then
			g_nCloudIndex = sRet
			Form.SetTimerEvent2(4,1,0.1)
		end if
	end if
	
	if sKeyName == "mhetc90150_s3" then
		Form.CloseForm()
	end if
	
	'PIN 잠김해제 
	if sKeyName == "mhetc90150_p2" then
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(CInt(sTimerID), 0, 0.1)

	if sTimerID == "1" or sTimerID == 1 then
		Form.requestCertCommand("CLOUD_REQ_CERT_LIST", "CLOUD", "90153")
	
	'등록된 클라우드 인증서가 없는 경우
	elseif sTimerID == "2" or sTimerID == 2 then
		if g_bCloudCert == false then
			Container0.contNoCert.visible = True
			Container0.contYesCert.visible = False
			Container0.contTbl.visible = False
		end if
	
	elseif sTimerID == "3" or sTimerID == 3 then
		Form.requestCertCommand("CLOUD_REQ_CERT_UPDATE", "", "90153")
	
	elseif sTimerID == "4" or sTimerID == 4 then
		Form.requestCertCommand("CLOUD_REQ_CERT_LIST", "CLOUD", "901532")
	end if
End Sub

'============================================================================
Sub Form_onTriggerEventCloudCert(sCommand, sResult)
	Dim sErrorCd, sErrorMsg

	szItem = Split(sResult,"★")
				
	'처리코드,처리메시지 처리
	sErrorCd		= szItem(0)
	sErrorMsg	= szItem(1)	

	'오류이면
	if sErrorCd <> "0" then
		Form.MsgBox("안내" & sCommand, sErrorMsg, "", 0)
		exit sub
	end if		
	
	if sCommand == "CLOUD_REQ_CERT_LIST_901532" then
		'응답문 처리
		if #szItem >= 3 then
			
			nCnt	= szItem(2) 	'인증서 개수

			if Cint(nCnt) > 0 then
				
				for i = 0 to nCnt - 1
					g_bCloudCert = True
					
					szCertList = Split(szItem(i+3), "♥")
					
					if i = Cint(g_nCloudIndex) then
					
						Container0.contYesCert.Label1.caption = szCertList(4)
						Container0.contYesCert.Label0.caption = szCertList(6)
						Container0.contYesCert.Label2.maxlinecnt = "1^-1"
						
						sCertExpiredDate = Left(szCertList(7), 4) & "/" & Mid(szCertList(7), 5, 2) & "/" & Right(szCertList(7), 2) & " 만료"
						Container0.contYesCert.Label2.caption = szCertList(11) & " | " & sCertExpiredDate
						
						g_sCloudCertID = szCertList(9)
						g_sCloudCertSerial = szCertList(10)
						g_sCloudCertDN = szCertList(5)
						
						sCalDate	= Form.calcDateTime(0, 0, 30, 0, 0, 0)
						sCalDate	= Left(sCalDate, 8)
						
						sCurrentDate	= Form.calcDateTime(0, 0, 0, 0, 0, 0)
						sCurrentDate	= Left(sCalDate, 8)
						
						'갱신 시점 X
						if tonumber(szCertList(7)) > tonumber(sCalDate) then
							Container0.contTbl.TblSelect.visible = True
							Container0.contTbl.TblSelectIncludeUpdate.visible = False
							Container0.contTbl.Image4.visible = False
							Container0.contYesCert.ImgCert.imgpath = "icon_cloud.png"
							
						'갱신 시점 O
						else
							Container0.contTbl.TblSelect.visible = False
							Container0.contTbl.TblSelectIncludeUpdate.visible = True
							Container0.contTbl.Image4.visible = True
							
							'현재 날짜가 만료일 지난 경우
							if tonumber(szCertList(7)) < tonumber(sCurrentDate) then
								Container0.contYesCert.ImgCert.imgpath = "icon_cloud_er.png"
							end if
						end if
						
						'PIN 5회 잠김 여부
						if szCertList(2) = "true" then
							Container0.contTbl.visible = False
							Container0.contYesCert.ImgCert.imgpath = "icon_cloud_er.png"
							Container0.contPinError.visible = True
						end if
					end if
				next
			end if
			
		end if
	end if
	
	if sCommand == "CLOUD_REQ_CERT_LIST_90153" then
	
		'응답문 처리
		if #szItem >= 3 then
			
			nCnt	= szItem(2) 	'인증서 개수
			
			if Cint(nCnt) > 0 then
				
				g_bCloudCert = True
				
				Container0.contNoCert.visible = False
				Container0.contYesCert.visible = True
				Container0.contTbl.visible = True
				
				for i = 0 to nCnt - 1
					
					szCertList = Split(szItem(i+3), "♥")
					
					if i = 0 then
						Container0.contYesCert.Label1.caption = szCertList(4)
						Container0.contYesCert.Label0.caption = szCertList(6)
						Container0.contYesCert.Label2.maxlinecnt = "1^-1"
						
						sCertExpiredDate = Left(szCertList(7), 4) & "/" & Mid(szCertList(7), 5, 2) & "/" & Right(szCertList(7), 2) & " 만료"
						Container0.contYesCert.Label2.caption = szCertList(11) & " | " & sCertExpiredDate
						
						g_sCloudCertID = szCertList(9)
						g_sCloudCertSerial = szCertList(10)
						g_sCloudCertDN = szCertList(5)
						
						sCalDate	= Form.calcDateTime(0, 0, 30, 0, 0, 0)
						sCalDate	= Left(sCalDate, 8)
						
						sCurrentDate	= Form.calcDateTime(0, 0, 0, 0, 0, 0)
						sCurrentDate	= Left(sCalDate, 8)
						
						'갱신 시점 X
						if tonumber(szCertList(7)) > tonumber(sCalDate) then
							Container0.contTbl.TblSelect.visible = True
							Container0.contTbl.TblSelectIncludeUpdate.visible = False
							Container0.contTbl.Image4.visible = False
							Container0.contYesCert.ImgCert.imgpath = "icon_cloud.png"
							
						'갱신 시점 O
						else
							Container0.contTbl.TblSelect.visible = False
							Container0.contTbl.TblSelectIncludeUpdate.visible = True
							Container0.contTbl.Image4.visible = True
							
							'현재 날짜가 만료일 지난 경우
							if tonumber(szCertList(7)) < tonumber(sCurrentDate) then
								Container0.contYesCert.ImgCert.imgpath = "icon_cloud_er.png"
							end if
						end if
						
						'PIN 5회 잠김 여부
						if szCertList(2) = "true" then
							Container0.contTbl.visible = False
							Container0.contYesCert.ImgCert.imgpath = "icon_cloud_er.png"
							Container0.contPinError.visible = True
						end if
						
						g_nCloudIndex = i
					end if
				next
			else
				'인증서 1개였다가 삭제하면 0개로 리턴이 오긴 함
				Form.SetTimerEvent2(2, 1, 0.2)
			end if
		end if
	else
		
		Form.SetTimerEvent2(2, 1, 0.2)
		
		if sCommand == "CLOUD_EVENT_ACQUIREUSERINFO" then
			g_bNeedConnect = True
			
		elseif sCommand == "CLOUD_REQ_CERT_UPDATE_90153" then
		
			Container0.contTbl.TblSelectIncludeUpdate.visible = True
			Container0.contTbl.Image4.visible = True
		
		elseif sCommand == "CLOUD_EVENT_PHONE_PROOF" then
			
			Form.openPopupAnimation("mhetc90303", sInput ,"","2") '클라우드 기기인증
			
		end if
		
	end if
End Sub
'============================================================================
Sub Container0_ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_contNoCert_Label0_OnClick()
	Container0_contNoCert_Button0_OnClick()
End Sub
'============================================================================
Sub Container0_contNoCert_Button0_OnClick()
	'클라우드 연결 필요
	if g_bNeedConnect then
		'클라우드 연결화면 진입시점 판단 용도
		Form.SetSharedData("CLOUD_CONNECT_IS_FROM" , "new")
			
		Form.OpenNextPopup("mhetc90302" , "" , "")	
	else
		Form.OpenNextPopup("mhetc90150_s1", "new", "")
	end if
End Sub
'============================================================================
Sub Container0_contYesCert_BtnContYes_OnClick()
	Form.OpenPopup("mhetc90152_p1" , "클라우드인증서 관리" , "")
End Sub

'============================================================================
Sub Container0_contTbl_TblSelect_OnClick(lRow , lColumn)
	CloudFunction(lRow)
End Sub

'============================================================================
Sub Container0_contTbl_TblSelectIncludeUpdate_OnClick(lRow , lColumn)
	CloudFunction(lRow)
End Sub
'============================================================================
Sub Container0_contTbl_Image0_OnClick()
	CloudFunction(0)
End Sub
'============================================================================
Sub Container0_contTbl_Image1_OnClick()
	CloudFunction(3)
End Sub
'============================================================================
Sub Container0_contTbl_Image2_OnClick()
	CloudFunction(6)
End Sub
'============================================================================
Sub Container0_contTbl_Image3_OnClick()
	CloudFunction(9)
End Sub
