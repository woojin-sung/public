Sub Container0_ImageRefresh_OnClick()
	Set_RequestData()
End Sub

'============================================================================
 '20240219 SWJ START
 '============================================================================
Sub Container0_ImageArrowR_OnClick()
      szData = Account0.caption
      
	if trim(Container0.lblAcct.Caption) == "전체계좌" then
		Form.SaveConfigData("mbact71052", "cur_tabcode", "0") 
	else
		Form.SaveConfigData("mbact71052", "cur_tabcode", "1") 
	end if 
	
	Form.SetSharedData("50030_Acnt", szData)
	
	 Form.OpenScreen("71052" , "" )
End Sub

'============================================================================
Sub Container0_LblTotal_OnClick()
	Container0_ImageArrowR_OnClick()
End Sub

'============================================================================
Sub Container0_LblTotal_OnSizeAutoFit()
	SetPeriodLabelSize("total")
End Sub

'============================================================================
Sub Container0_lblAcct_OnSizeAutoFit()
	'안드로이드일때만 416,417라인 호출
	if Form.GetSharedData("&OS_TYPE", false) == "1" then
		Container0.lblAcct.multiline = true
		Container0.lblAcct.maxlinecnt = "1^0"
		Container0.lblAcct.top = 14
	end if

	if Trim(Container0.lblAcct.caption) == "전체계좌" then
		Container0.lblAcct.fontstyle = "00"
	else
		Container0.lblAcct.fontstyle = "10"				    
	end if
	
	SetPeriodLabelSize("acct")
End Sub

'============================================================================
Function SetPeriodLabelSize(szCtrl)
	if szCtrl == "total" then
		nLeft = Form.calcUnResize(Container0.LblTotal.left, "2")
		nWidth = Form.calcUnResize(Container0.LblTotal.width, "2")
		Container0.ImageArrowR.left = nLeft + nWidth + 6
		Container0.btnMoveAlpha.left = nLeft + nWidth
		
		'금액이 세팅 된 후 화살표 보여주기
		Container0.LblTotal.visible = true
		Container0.ImageArrowR.visible = true
		Container0.btnMoveAlpha.visible = true
		Container0.lblLoading.visible = false
		
	else
		nLeft = Form.calcUnResize(Container0.lblAcct.left, "2")
		nWidth = Form.calcUnResize(Container0.lblAcct.width, "2")
		Container0.ImageArrowDn.left = nLeft + nWidth
	end if
End Function

'============================================================================
Sub Container0_btnMoveAlpha_OnClick()
	Container0_ImageArrowR_OnClick()
End Sub


