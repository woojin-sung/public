'============================================================================
' tblHoga_OnClick
'============================================================================
Sub tblHoga_OnClick(lRow , lColumn)
	if lRow == 0 and lColumn == 2 then
		Form.triggerEvent("#", "REQUEST_ITEMCD", "")
	end if
End Sub

