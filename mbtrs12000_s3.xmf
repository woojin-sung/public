'============================================================================
' SetHogaTblFgColor
'============================================================================
Function SetHogaTblFgColor( nPrice )
	If nPrice  > 0 then 
		tblHoga.SetCellFgColor( 0, 4, 10 )
	ElseIf nPrice < 0 then 
		tblHoga.SetCellFgColor( 0, 4, 11 )
	Else
		tblHoga.SetCellFgColor( 0, 4, 12 )
	End If
End Function

