	Container.ImgQ9A2.imgpath = unPressedImgPath
	Container.ImgQ9A3.imgpath = unPressedImgPath
	Container.ImgQ9A4.imgpath = unPressedImgPath
	
	Common_Check()

End Sub

'============================================================================
Sub Common_Check()

    If Q1Answer <> 0 And Q2Answer <> 0 And Q4Answer <> 0 And Q5Answer <> 0 And Q6Answer <> 0 And Q7Answer <> 0 And Q8Answer <> 0 And Q9Answer <> 0 Then
        If Q3Answer_1 <> 0 Or Q3Answer_2 <> 0 Or Q3Answer_3 <> 0 Or Q3Answer_4 <> 0 Or Q3Answer_5 <> 0 Then
            BtnCnfr.enable = True
        Else
            BtnCnfr.enable = False
        End If
    Else 
        BtnCnfr.enable = False
    End If
     
End Sub


'============================================================================
