'============================================================================
Sub Form_OnFormInit()

    unPressedImgPath = "x.png"
    PressedImgPath   = "transkey_image_button.png"
    
    unCheckImgPath = "x.png"
    CheckImgPath   = "transkey_image_button.png"

    Q1Answer = 0
    Q2Answer = 0
    
    Q3Answer_1 = 0
    Q3Answer_2 = 0
    Q3Answer_3 = 0
    Q3Answer_4 = 0
    Q3Answer_5 = 0
    
    Q4Answer = 0
    Q5Answer = 0
    Q6Answer = 0
    Q7Answer = 0
    Q8Answer = 0
