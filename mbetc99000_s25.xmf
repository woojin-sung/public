'============================================================================
Sub Form_OnFormInit()

    call_cnt = 0
    call_cnt2 = 0
    
    Table2.SetCellFgColor(0, 0, "92")
	Table3.SetCellFgColor(0, 0, "89")
	Table4.SetCellFgColor(0, 0, "89")
	Table5.SetCellFgColor(0, 0, "89")
   
    
	szData = Form.GetOpenLinkData()
	szList = split(szData, "●")
	
	'Form.ShowAlert("",szData )
	
	DATAMANAGER.SetDataValue(0, "obcpp_intr_722r", "InBlock2", "PRTF_ID" , 0 , szList(0))
	DATAMANAGER.RequestTranData("obcpp_intr_722r")
	
	DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "INP_CLS_CODE" ,0, 1)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "PRTF_ID" , 0,szList(0))
	DATAMANAGER.RequestTranData("obcpp_intr_759r")
	
	DATAMANAGER.SetDataValue(0, "obcpp_intr_764r", "InBlock1", "INP_CLS_CODE" , 0,1)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_764r", "InBlock1", "PRTF_ID" ,0, szList(1))
	DATAMANAGER.RequestTranData("obcpp_intr_764r")
	
	'DATAMANAGER.SetDataValue('bReal, sTranID , sBlockName , sFieldName , nIndex , szValue)
	
	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

if szTranID == "obcpp_intr_722r" then

 if call_cnt == 0 then

	 tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_722r", "OutBlock1", "ADCP_NAME" , 0)
	 Table0.SetCellString(1, 1, tmp)
 
	 tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_722r", "OutBlock1", "PRTF_NAME" , 0)
	 Table0.SetCellString(2, 1, tmp)
 
	 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "INP_INVT_INCL_CLCD" , 0)
 
	 if abs(tmp) == 1 then
		tmp = "안정형"
	  
		elseif abs(tmp) == 2 then
		tmp = "안정추구형"
	
		elseif abs(tmp) ==3 then
		tmp = "중립형"
	
		elseif abs(tmp) == 4 then
		tmp = "수익추구형"
	
		elseif abs(tmp) ==5 then
		tmp = "고수익추구형"
	
	end if


	 Table0.SetCellString(3, 1, tmp)
 
 
	 tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_722r", "OutBlock1", "ANTC_ERT" , 0)
	 Table0.SetCellString(4, 1, round(tmp,2)&"%")
 
	 tmp = round(DATAMANAGER.GetDataValue(0, "obcpp_intr_722r", "OutBlock1", "INP_RBDV_VLPN" , 0),0)
 
		 if abs(tmp) == 1 then
		 tmp = "★☆☆☆☆"
	  
		 elseif abs(tmp) == 2 then
		 tmp = "★★☆☆☆"
	
		 elseif abs(tmp) ==3 then
		 tmp = "★★★☆☆"
	
		 elseif abs(tmp) == 4 then
		 tmp = "★★★★☆"
	
		 elseif abs(tmp) ==5 then
		 tmp = "★★★★★"
	
		 end if
 
	 Table0.SetCellString(5, 1, tmp)
 
	 call_cnt = call_cnt+1
 
	 DATAMANAGER.SetDataValue(0, "obcpp_intr_722r", "InBlock2", "PRTF_ID" , 0 , szList(1))
	 DATAMANAGER.RequestTranData("obcpp_intr_722r")
 
 else '두번째 포트폴리오 call
 
	  tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_722r", "OutBlock1", "ADCP_NAME" , 0)
	 Table1.SetCellString(1, 1, tmp)
 
	 tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_722r", "OutBlock1", "PRTF_NAME" , 0)
	 Table1.SetCellString(2, 1, tmp)
 
	 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "INP_INVT_INCL_CLCD" , 0)
 
		 if abs(tmp) == 1 then
		 tmp = "안정형"
	  
		 elseif abs(tmp) == 2 then
		 tmp = "안정추구형"
	
		 elseif abs(tmp) ==3 then
		 tmp = "중립형"
	
		 elseif abs(tmp) == 4 then
		 tmp = "수익추구형"
	
		 elseif abs(tmp) ==5 then
		 tmp = "고수익추구형"
	
		 end if


	 Table1.SetCellString(3, 1, tmp)
 
	 tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_722r", "OutBlock1", "ANTC_ERT" , 0)
	 Table1.SetCellString(4, 1,round(tmp,2)&"%")
 
	 tmp = round(DATAMANAGER.GetDataValue(0, "obcpp_intr_722r", "OutBlock1", "INP_RBDV_VLPN" , 0),0)
 
		 if abs(tmp) == 1 then
		 tmp = "★☆☆☆☆"
	  
		 elseif abs(tmp) == 2 then
		 tmp = "★★☆☆☆"
	
		 elseif abs(tmp) ==3 then
		 tmp = "★★★☆☆"
	
		 elseif abs(tmp) == 4 then
		 tmp = "★★★★☆"
	
		 elseif abs(tmp) ==5 then
		 tmp = "★★★★★"
	
		 end if
 
	 Table1.SetCellString(5, 1, tmp)
 
  end if '722r 끝
 
 elseif szTranID == "obcpp_intr_759r" then
 
	 
 
 
 
 
 end if
	
End Sub

