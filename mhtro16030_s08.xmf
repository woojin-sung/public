'===========================================================================
' 화  면  명 : 종목검색창_메인
' 화  면  ID : 
' 개      요 : 
' 작      성 : 2015.04.22 이호철
' 수      정 : 2017.10.12 이재원
'===========================================================================
Dim g_tCmbData1
Dim g_tCmbData2
Dim g_nPage
Dim g_xPos
Dim g_nIndex
Dim g_szNext
Dim g_szDelaySH
Dim g_szDelaySZ
Dim g_szDelayHK
g_tCmbData1 = "상해^심천^홍콩^뉴욕^아멕스^나스닥" '미/홍/중			
g_tCmbData2 = "도쿄^호치민^하노이" ' 일/베
g_nPage = 0
g_xPos  = ""
g_nIndex = 0
g_szNext = ""
g_szDelaySH = ""
g_szDelaySZ = ""
g_szDelayHK = ""

'============================================================================
Sub Form_OnFormInit()

	g_szDelaySH = Form.GetSharedData("REALTIME_SH", 0 )
	g_szDelaySZ = Form.GetSharedData("REALTIME_SZ", 0 )
	g_szDelayHK = Form.GetSharedData("REALTIME_HK", 0 )
	
	Dim szCombo0
	Dim szCombo1
	
	szCombo0 = Form.GetEnvData("16030_S08_COMBO0")
	szCombo1 = Form.GetEnvData("16030_S08_COMBO1")
	
	if szCombo0 <> nil and szCombo0 <> "" then
		Form.SetCtlProp("Combo0",  "cbkeydata", szCombo0)
	end if
	if szCombo1 <> nil and szCombo1 <> "" then
		Form.SetCtlProp("Combo1",  "cbkeydata", szCombo1)
	end if
	
	'화면모드 확인
	'콤보 배경색 : 검정색
	Combo0.bgimagetype = "1" 
	Combo1.bgimagetype = "1"
	
	Dim szCmb0
	szCmb0 = Form.GetCtlProp( "Combo0",  "cbkeydata" )
	if szCmb0 == "A"then
		DATAMANAGER.RequestTranData( "ohhts_6246_001r" ) 
	else
		DATAMANAGER.RequestTranData( "ohhts_6246_002r" ) 
	end if
	
end Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCmb0
	Dim szCmb1
	
	szCmb0 = Form.GetCtlProp( "Combo0",  "cbkeydata" ) 
	szCmb1 = Form.GetCtlProp( "Combo1",  "cbkeydata" )
	if szTranID == "ohhts_6246_001r" or szTranID == "ohhts_6246_002r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_OPTN" , 0 , "0" ) '0:전체 1:심천 2:상해
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE" , 0 , szCmb1 ) '0:DESC 1:ASC
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_TRGT_CLS_CODE" , 0 , g_szDelaySH..g_szDelaySZ..g_szDelayHK ) '상해홍콩심천
	end if
end Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6246_001r" or szTranID == "ohhts_6246_002r" then

		'Combo상태
		Dim szCmb0
		szCmb0 = Form.GetCtlProp( "Combo0",  "cbkeydata" )
		if szCmb0 == "A"then
			Grid0.SetCellTopCaption("th_cell2", "A+H괴리(CNY)" )
		else
			Grid0.SetCellTopCaption("th_cell2", "H+A괴리(HKD)" )
		end if
		
		Dim nCount
		nCount	= _tonumber( DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock2" ) )
		
		for i=0 to nCount-1
		
			Dim szExid, szCode
			
			szExid  = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2", "FID_COND_MRKT_CLS_CODE" , i)
			szCode  = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2", "FIDX_ISCD" , i)

			Grid0.SetCellData("bd_cell0", g_nIndex + i, g_nIndex +i+1)
			Grid0.SetCellData("bd_cell4", g_nIndex + i, szExid.."@"..szCode)
			
			DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , i , szExid.."@"..szCode )
		next
		Grid0.keyall = "1"
'		DATAMANAGER.RequestRealData("ohhts_exst_ictg")
		g_nIndex = _tonumber( Grid0.rowcount )
	end if
	
end Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID == "ohhts_exst_ictg" then
		Dim szRealCode, szExData
		szRealCode = DATAMANAGER.GetDataValue( 1, "ohhts_exst_ictg", "OutBlock1", "FIDXR_ISCD" , 0)
		szExData = Label0.caption
		for i=0 to g_nIndex-1
			Dim szCode
			szCode = Grid0.GetCellData("bd_cell4", i)
			
			if szCode == szRealCode then
				
				nCurPrcA = CDbl(Grid0.GetCellData("bd_cell5", i))
				nCurPrcH = CDbl(Grid0.GetCellData("bd_cell6", i))
				nUnchPrc = nCurPrcH * CDbl(szExData)
				
			    If szExData = "" Or CDbl( szExData ) = 0.0 Then
				    Exit Sub
				End If		

				Grid0.SetCellData("bd_cell2", i, nCurPrcA - nUnchPrc )
				Grid0.SetCellData("bd_cell3", i, (nCurPrcA - nUnchPrc) / nUnchPrc * 100 )
				Exit Sub
			end if
		next
	end if
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	Dim szComboData
	szComboData = Form.GetCtlProp( "Combo0",  "cbkeydata" ) 
	Form.SetEnvData(1, "16030_S08_COMBO0", szComboData)
	
	g_nPage  = 0
	g_nIndex = 0
	g_szNext	= ""
	Grid0.SetClear( )
	
	Dim szCmb0
	szCmb0 = Form.GetCtlProp( "Combo0",  "cbkeydata" )
	if szCmb0 == "A"then
		DATAMANAGER.RequestTranData( "ohhts_6246_001r" ) 
	else
		DATAMANAGER.RequestTranData( "ohhts_6246_002r" ) 
	end if
end Sub

'============================================================================
Sub Combo1_OnEditComplete(iIndex)	
	Dim szComboData
	szComboData = Form.GetCtlProp( "Combo1",  "cbkeydata" ) 
	Form.SetEnvData(1, "16030_S08_COMBO1", szComboData)
	
	g_nPage  = 0
	g_nIndex = 0
	g_szNext	= ""
	Grid0.SetClear( )
	
	Dim szCmb0
	szCmb0 = Form.GetCtlProp( "Combo0",  "cbkeydata" )
	if szCmb0 == "A"then
		DATAMANAGER.RequestTranData( "ohhts_6246_001r" ) 
	else
		DATAMANAGER.RequestTranData( "ohhts_6246_002r" ) 
	end if
end Sub

'============================================================================
Sub Form_OnRefresh()
	g_nPage  = 0
	g_nIndex = 0
	g_szNext	= ""
	Grid0.SetClear( )
	
	Dim szCmb0
	szCmb0 = Form.GetCtlProp( "Combo0",  "cbkeydata" )
	if szCmb0 == "A"then
		DATAMANAGER.RequestTranData( "ohhts_6246_001r" ) 
	else
		DATAMANAGER.RequestTranData( "ohhts_6246_002r" ) 
	end if
end Sub

'============================================================================
Function _tonumber(data)
	return tonumber(data) or 0
end Function

'============================================================================
Sub Grid0_OnScrollEnd()
	Dim szCmb0, bNext, szTranID
	szCmb0 = Form.GetCtlProp( "Combo0",  "cbkeydata" )
	if szCmb0 == "A"then
		szTranID = "ohhts_6246_001r"
	else
		szTranID = "ohhts_6246_002r"
	end if
	
	Dim bNext
	bNext = DATAMANAGER.IsMoreNextData( szTranID )
	if bNext == "1" or bNext == true then
		DATAMANAGER.RequestNextData( szTranID )
	end if
end Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	Dim sCode
	Dim sKorname
	Dim sExid
	
	sCode 	= Grid0.GetCellData( "bd_cell4", lRow )
	sKorname	= Grid0.GetCellData( "bd_cell1", lRow )
	
	if sCode <> "" then

		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", sCode.."★"..sKorName.."★".."", "" )
		Form.OpenScreen("16000", "")
		
	end if
end Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

