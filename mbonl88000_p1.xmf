' btnOk_OnClick() : 확인버튼 누를시 공인인증서 화면 열수 있게 값 지정
'============================================================================
Sub btnOk_OnClick()
	'Form.SendReturnToParent( "Ok" , sData )
	'Form.CloseForm()
	Form.OpenFramePopup( "mbonl88000_p2" , "" , sPosInfo) 
	
End Sub
'============================================================================
' btnCancel_OnClick()
'============================================================================
Sub btnCancel_OnClick()
     Form.SendReturnToParent("mbonl8800_p1" , "Y")
	 Form.CloseForm()
End Sub

