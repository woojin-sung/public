	<SCRIPT_INFO _len="3638" _ulen="3394" >
'============================================================================
' 01. 화 면 명 : 발행어음매매_매수확인창
' 02. 화면설명 : 발행어음매매_매수확인창
' 03. 작    성 : 2016. 03. 02. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szData
Dim g_szList
Dim g_nState			'종료시 버튼 선택 여부
Dim EtfCancCode
Dim EtfCancDate
Dim EtfCancDateNm
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
	g_szData = Form.GetOpenLinkData()
	
	g_szList = Split( g_szData, "★" )
	
	if UBOUND(g_szList) < 1 then
		Exit sub
	End if

     EtfCancCode = g_szList(0)
     EtfCancDate = g_szList(1)
    
    '00	해당없음  
    '01	부적정    
    '02	KYC만기   
    '03	정보미제공
    '04	KYC미등록 
    if EtfCancCode = "01" then '01	부적정  
        tbl0.Visible = True
	    tbl1.Visible = False
	   tbl2.Visible = False
    elseif EtfCancCode = "02" OR EtfCancCode = "04" then '02:KYC만기 04:KYC미등록      
        tbl0.Visible = False
	    tbl1.Visible = True
	   tbl2.Visible = False
    elseif EtfCancCode = "03" then '03	정보미제공
       tbl0.Visible = False
	    tbl1.Visible = False
	   tbl2.Visible = True
    end if
    
    IF Len(EtfCancDate) >= 8 Then
	    EtfCancDateNm = left(EtfCancDate,4)&"년 "&mid(EtfCancDate,5,2)&"월 "&right(EtfCancDate,2)&"일"
	    EtfCancDateNm = left(EtfCancDate,4)&"년 "&mid(EtfCancDate,5,2)&"월 "&right(EtfCancDate,2)&"일"
	    EtfCancDateNm = left(EtfCancDate,4)&"년 "&mid(EtfCancDate,5,2)&"월 "&right(EtfCancDate,2)&"일"
	End if
	
	tbl0.SetCellString( 3 , 0, EtfCancDateNm)			'해지예정일자
	tbl1.SetCellString( 3 , 0, EtfCancDateNm)			'해지예정일자
	tbl2.SetCellString( 3 , 0, EtfCancDateNm)			'해지예정일자
	
End Sub
'============================================================================
' btnClose_OnClick()
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub
'============================================================================
' imgClose_OnClick()
