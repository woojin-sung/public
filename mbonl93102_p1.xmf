'============================================================================
Sub Form_OnFormInit()
	'그리드 카드 배경 설정
	grdList.setUseCardView(true, 10, "input_03_n.9.png")
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	
	
	'test
	grdList.rowcount = 5
	for i = 0 to grdList.rowcount - 1
		grdList.SetCellData("bd_cell12", i, "계좌유형")
		grdList.SetCellData("bd_cell17", i, "가입일")
		grdList.SetCellData("bd_cell22", i, "한도금액")
		
		grdList.SetCellData("bd_title", i, "삼성증권 온라인영업지원팀\n711401855810")
		grdList.SetCellData("bd_type", i, "연금저축")
		grdList.SetCellData("bd_regdate", i, "20210705")
		grdList.SetCellData("bd_limit", i, "2000000")
	next
End Sub

