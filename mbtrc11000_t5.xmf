'============================================================================
'(v003) 기간별 수익률 팝업 화면
'============================================================================
Sub cont0_grd0_OnClickUp(lRow, szCellID)
	Dim szData
	Dim AcntTotAmt  '계좌평가금액
	
	if szCellID = "bd_cell9" then	'기간손익 버튼 클릭 시 기간별 수익률 팝업
		szACNO = Form.GetCtlProp("#acnt0", "total")
		szASNO = Form.GetCtlProp("#acnt0", "sequence")
		
		AcntTotAmt = CDbl( lblAmt.caption )  '계좌평가금액
		
		szData = szACNO & "|" & szASNO & "|" & CDbl( AcntTotAmt )
		
		Form.OpenFramePopup( "mbtrs15000_p1" , szData , "")
	end if
End Sub

