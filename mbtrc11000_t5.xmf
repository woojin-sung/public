'		exit Function
'	end if
'
'	cont0.grd1.rowcount = 0
'	cont0.grd1.SetClear()
'	g_nNextCount = 0
'	
'	'DATAMANAGER.RequestTranData( "obtrc_comm_202r" ) '(v003) 위치 이동
'End Function

'============================================================================

'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "RECEIVE" or sEventName == "CHANGE_ACCTNO" then
	    VltnAmt_Request()
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp0, szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp11, TempCount
	
	if szTranID == "obtrc_comm_201r" then  '(v003) 잔고평가금액, 평가손익, 수익률, 매입금액 추가(최초매입금액 기준, 월정산 기준, 비용 포함 선택 시 연동)
		CFD_VLTN_PRLS_AMT = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_201r", "OutBlock1", "CFD_VLTN_PRLS_AMT", 0)  '(v003) 평가손익
		RMND_VLTN_AMT     = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_201r", "OutBlock1", "RMND_VLTN_AMT"    , 0)  '(v003) 잔고평가금액
		CFD_ACBK_AMT      = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_201r", "OutBlock1", "CFD_ACBK_AMT"     , 0)  '(v003) 매입금액
		ERT               = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_201r", "OutBlock1", "ERT"              , 0)  '(v003) 수익률
		
		sMask = "1,0,,,0,,"..g_decimal..",1,1,2,0"	
		
		cont0.grd0.SetCellIDMaskInfo("bd_cell1", sMask)
		cont0.grd0.SetCellIDMaskInfo("bd_cell3", "1,0,,,0,,2,1,1,2,0")
		cont0.grd0.SetCellIDMaskInfo("bd_cell7", "1,0,,,0,,0,1,1,2,0")
		
		g_szCurr = "원"
		
		cont0.grd0.SetCellData("bd_cell1", 0, FormatNumber(RMND_VLTN_AMT, g_decimal) & g_szCurr)      '(v003) 잔고평가금액
		cont0.grd0.SetCellData("bd_cell3", 0, FormatNumber(CFD_VLTN_PRLS_AMT, g_decimal) & g_szCurr)  '(v003) 평가손익
		cont0.grd0.SetCellData("bd_cell5", 0, FormatNumber(ERT, 2) & "%")                             '(v003) 수익률
		cont0.grd0.SetCellData("bd_cell7", 0, FormatNumber(CFD_ACBK_AMT, g_decimal) & g_szCurr)       '(v003) 매입금액
		
		'(v003) 평가손익 손익 현황에 따른 색깔 처리
		if CDbl(CFD_VLTN_PRLS_AMT) > 0 then
			cont0.grd0.SetCellData("bd_cell3", 0 , FormatNumber(CFD_VLTN_PRLS_AMT, g_decimal) & g_szCurr)
			g_PopColor = "10"
			cont0.grd0.SetCellFgColor("bd_cell3", 0, g_PopColor)
		elseif CDbl(CFD_VLTN_PRLS_AMT) < 0 then
			cont0.grd0.SetCellData("bd_cell3", 0 , FormatNumber(CFD_VLTN_PRLS_AMT, g_decimal)& g_szCurr)
			g_PopColor = "11"
			cont0.grd0.SetCellFgColor("bd_cell3", 0, g_PopColor)
		else
			cont0.grd0.SetCellData("bd_cell3", 0 , FormatNumber(CFD_VLTN_PRLS_AMT, g_decimal)& g_szCurr)
			g_PopColor = "12"
			cont0.grd0.SetCellFgColor("bd_cell3", 0, g_PopColor)
		end if	
		
		'(v003) 수익률 손익 현황에 따른 색깔 처리
		if CDbl(ERT) > 0 then
			cont0.grd0.SetCellData("bd_cell5", 0 , FormatNumber(ERT, 2) & "%")
			g_PopColor = "10"
			cont0.grd0.SetCellFgColor("bd_cell5", 0, g_PopColor)
		elseif CDbl(ERT) < 0 then
			cont0.grd0.SetCellData("bd_cell5", 0 , FormatNumber(ERT, 2) & "%")
			g_PopColor = "11"
			cont0.grd0.SetCellFgColor("bd_cell5", 0, g_PopColor)
		else
			cont0.grd0.SetCellData("bd_cell5", 0 , FormatNumber(ERT, 2) & "%")
			g_PopColor = "12"
			cont0.grd0.SetCellFgColor("bd_cell5", 0, g_PopColor)
		end if
		
		'잔고 조회
		DATAMANAGER.RequestTranData( "obtrc_comm_202r" )  '(v003) 위치 이동
		
	elseif szTranID == "obtrc_comm_202r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obtrc_comm_202r", "OutBlock1")-1
			cont0.grd1.AddRow()
			
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_202r", "OutBlock1", "ISNM" , i)						'종목명
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_202r", "OutBlock1", "DEAL_CLS_CODE_NAME" , i)			'포지션
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_202r", "OutBlock1", "ACBK_QTY" , i)					'잔고수량
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_202r", "OutBlock1", "CFD_ACBK_UNPR" , i)				'매수단가
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_202r", "OutBlock1", "CFD_VLTN_AMT" , i)					'평가금액
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_202r", "OutBlock1", "CFD_VLTN_PRLS_AMT" , i)			'평가손익
			szTemp7 = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_202r", "OutBlock1", "ERT" , i)						'수익률
			szTemp8 = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_202r", "OutBlock1", "CFD_ACBK_AMT" , i)					'매입금액 - 상세
			szTemp9 = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_202r", "OutBlock1", "CFD_MGRT" , i)					'증거금률 - 상세
			szTemp10 = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_202r", "OutBlock1", "DEAL_CLS_CODE" , i)				'매매구분 코드
			szTemp11 = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_202r", "OutBlock1", "ISCD" , i)						'종목코드
			szTemp12 = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_202r", "OutBlock1", "PSNT_PRC" , i)                     '(v002) 현재가격
			szTemp13 = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_202r", "OutBlock1", "RLTM_PRDY_VRSS_PRC" , i)           '(v002) 실시간전일대비가격
			szTemp14 = DATAMANAGER.GetDataValue( 0 , "obtrc_comm_202r", "OutBlock1", "RATE" , i)                         '(v002) 등락비율
			
			cont0.grd1.SetCellData("bd_cell1", g_nNextCount , szTemp1)
			cont0.grd1.SetCellData("bd_cell2", g_nNextCount , szTemp2)
			cont0.grd1.SetCellData("bd_cell3", g_nNextCount , szTemp3)
			cont0.grd1.SetCellData("bd_cell4", g_nNextCount , szTemp4)
			cont0.grd1.SetCellData("bd_cell5", g_nNextCount , szTemp5)
'			cont0.grd1.SetCellData("bd_cell6", g_nNextCount , szTemp6)
'			cont0.grd1.SetCellData("bd_cell7", g_nNextCount , szTemp7)
			cont0.grd1.SetCellData("bd_cell8", g_nNextCount  , szTemp8)
			cont0.grd1.SetCellData("bd_cell9", g_nNextCount  , szTemp9)
			cont0.grd1.SetCellData("bd_cell10", g_nNextCount  , szTemp10)
			cont0.grd1.SetCellData("bd_cell11", g_nNextCount  , szTemp11)

			if CDbl(szTemp7) > 0 then
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , "+"..FormatNumber(szTemp6, 0))
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , "+"..FormatNumber(szTemp7, 2))
				cont0.grd1.SetCellFgColor("bd_cell6", g_nNextCount, "10")
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "10")
			elseif CDbl(szTemp7) < 0 then
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , FormatNumber(szTemp6, 0))
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , FormatNumber(szTemp7, 2))
				cont0.grd1.SetCellFgColor("bd_cell6", g_nNextCount, "11")
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "11")
			else
				cont0.grd1.SetCellData("bd_cell6", g_nNextCount , FormatNumber(szTemp6, 0))
				cont0.grd1.SetCellData("bd_cell7", g_nNextCount  , FormatNumber(szTemp7, 2))
				cont0.grd1.SetCellFgColor("bd_cell6", g_nNextCount, "12")  '(v002) 색깔 처리
				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "12")  '(v002) 색깔 처리
			end if	
			
			'(v002) 현재가격(원화), 실시간전일대비가격(원화), 등락비율 처리
			if CDbl(szTemp13) > 0 then
				cont0.grd1.SetCellData("bd_cell_pp", g_nNextCount , FormatNumber(szTemp12, 0) & "  ▲"..FormatNumber(szTemp13, 0) & "  " & FormatNumber(szTemp14, 2) & "%")
				cont0.grd1.SetCellFgColor("bd_cell_pp", g_nNextCount, "10")
			elseif CDbl(szTemp13) < 0 then
				cont0.grd1.SetCellData("bd_cell_pp", g_nNextCount , FormatNumber(szTemp12, 0) & "  ▼"..FormatNumber(abs(szTemp13), 0) & "  " & FormatNumber(szTemp14, 2) & "%")
				cont0.grd1.SetCellFgColor("bd_cell_pp", g_nNextCount, "11")
			else
				cont0.grd1.SetCellData("bd_cell_pp", g_nNextCount , FormatNumber(szTemp12, 0) & "  " & FormatNumber(szTemp13, 0) & "  " & FormatNumber(szTemp14, 2) & "%")
				cont0.grd1.SetCellFgColor("bd_cell_pp", g_nNextCount, "12")
			end if
			
			if CInt(szTemp10) = 2 then '매수
				cont0.grd1.SetCellFgColor("bd_cell2", g_nNextCount, "326")
				cont0.grd1.SetCellBgColor("bd_cell2", g_nNextCount, "339")
			elseif CInt(szTemp10) = 1 then '매도
				cont0.grd1.SetCellFgColor("bd_cell2", g_nNextCount, "341")
				cont0.grd1.SetCellBgColor("bd_cell2", g_nNextCount, "340")
			end if
			
			g_nNextCount = g_nNextCount + 1
		next
		
		cont0.grd1.rowcount = g_nNextCount
		
		if  DATAMANAGER.IsMoreNextData( "obtrc_comm_202r" ) == True then 
			DATAMANAGER.RequestNextData( "obtrc_comm_202r" )
		else
			nPrlsAmt = DATAMANAGER.GetDataValue(0 , "obtrc_comm_202r", "OutBlock2", "CFD_VLTN_PRLS_AMT" , 0)
			if CDbl(nPrlsAmt) > 0 then
				cont0.Label0.caption = "+"..FormatNumber(nPrlsAmt, 0)
				cont0.Label0.fgcolor = "10"
			elseif CDbl(nPrlsAmt) < 0 then
				cont0.Label0.caption = FormatNumber(nPrlsAmt, 0)
				cont0.Label0.fgcolor = "11"
			else
				cont0.Label0.caption = FormatNumber(nPrlsAmt, 0)
				cont0.Label0.fgcolor = "12"
			end if
			
			lblVisible()
		end if
	
	'---------------------------------------------------------
	'누적손익 조회 - 1, '(v003) 주석 처리
	'---------------------------------------------------------
'	elseif szTranID == "obacb_balc_105r" then
'		g_nVLTN_AMT = DATAMANAGER.GetDataValue( 0, "obacb_balc_105r", "OutBlock1", "VLTN_AMT", 0 )
'		DATAMANAGER.RequestTranData( "ooase_seex_084r" )	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	cont0.grd1.SetClear()
	g_nNextCount = 0
	Form.ShowAlert("알림", szErrMsg)
End Sub

'============================================================================
Sub Form_OnFormInit()
	cont0.grd0.SetCellData("bd_cell0", 0, "잔고평가금액") '(v003) 표시 항목 변경
	cont0.grd0.SetCellData("bd_cell2", 0, "평가손익")       '(v003) 표시 항목 변경
	cont0.grd0.SetCellData("bd_cell4", 0, "수익률")          '(v003) 표시 항목 변경
	cont0.grd0.SetCellData("bd_cell6", 0, "매입금액")       '(v003) 표시 항목 변경
	cont0.grd0.SetCellData("bd_cell9", 0, "기간손익")       '(v003) 표시 항목 변경
	
	'cont0.grd0.SetCellData("bd_cell0", 0, "당일손익") '(v003) 주석 처리
	'cont0.grd0.SetCellData("bd_cell2", 0, "누적손익 >") '(v003) 주석 처리
	
	cont0.grd0.setUseCardView(true, 10, "img_bgbox_gray.9")
	cont0.btn0.SetApplySwitch(" ", " ", 269, 261, 286, 67)
	
	cont0.FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 10) '활성화/비활성화/여백
	cont0.FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	
	cont0.FormTab0.insertPage( cont0.FormTab0.tabcount, "page1", "page1", "empty", "0", "최초매입기준")
	cont0.FormTab0.insertPage( cont0.FormTab0.tabcount, "page2", "page2", "empty", "0", "월정산기준")

	szTab = Trim(Form.LoadConfigData( "mbtrc11000_t5", "search" ))	'조회기준
	if szTab = "" then
		cont0.FormTab0.currenttab = 0
	else
		cont0.FormTab0.currenttab = CInt(szTab)
	end if
	
	szCost = Trim(Form.LoadConfigData( "mbtrc11000_t5", "cost" ))	'비용포함 여부
	if szCost = "" then
		cont0.btn0.switchindex = 0
	else
		cont0.btn0.switchindex = CInt(szCost)
	end if
	
	cont0.grd0.scrollenable = "0"
	cont0.setScrollBarVisible("0") 
End Sub

'============================================================================
Function lblVisible()
	if CInt(cont0.grd1.rowcount) = 0 then
		cont0.grd1.left = 1000
		cont0.lblNone.visible = true
	else
		cont0.grd1.left = 10
		cont0.lblNone.visible = false
	end if
End Function 

'============================================================================
Sub cont0_grd1_OnClickUp(lRow, szCellID)
	Dim szSendData
	Dim szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10
	
	szTemp1 = "|  "..cont0.grd1.GetCellData("bd_cell1", lRow)		'종목명
	szTemp2 = cont0.grd1.GetCellData("bd_cell5", lRow)			'평가금액
	szTemp3 = cont0.grd1.GetCellData("bd_cell8", lRow)			'매입금액
	szTemp4 = cont0.grd1.GetCellData("bd_cell6", lRow)			'평가손익
	szTemp5 = cont0.grd1.GetCellData("bd_cell7", lRow)			'수익률
	szTemp6 = cont0.grd1.GetCellData("bd_cell2", lRow)			'잔고구분
	szTemp7 = cont0.grd1.GetCellData("bd_cell9", lRow)			'증거금율
	szTemp8 = cont0.grd1.GetCellData("bd_cell3", lRow)			'체결잔고
	szTemp9 = cont0.grd1.GetCellData("bd_cell4", lRow)			'매입단가
	szTemp10 = cont0.grd1.GetCellData("bd_cell11", lRow)			'종목코드
	
	szSendData = szTemp1 & "☆" & szTemp2 & "☆" & szTemp3 & "☆" & szTemp4 & "☆" & szTemp5 & "☆" & szTemp6 & "☆" & szTemp7 & "☆" & szTemp8 & "☆" & szTemp9 & "☆" & szTemp10
	
'	Form.ShowAlert("szSendData", szSendData)
	
	Form.OpenPopupAnimation("mbtrc11000_p3", szSendData, "", "2")
End Sub

'(v003) 주석 처리
'============================================================================
'Sub Form_OnFormInitBefore()
'	cont0.Image1.SetMaintainingRatio("1")
'End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
	szStnd = CInt(cont0.FormTab0.currenttab) + 1		'1:최초매입   2:월정산
	szBtn = cont0.btn0.switchindex

	if Trim(szACNO) = "" then
		exit Sub
	end if

	if szTranID = "obtrc_comm_201r" then
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_201r", "InBlock1", "ACNO"		  , 0 , szACNO  )
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_201r", "InBlock1", "ASNO"		  , 0 , szASNO  )
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_201r", "InBlock1", "UI_IQRY_CLS"  , 0 , szBtn   )  '조회구분 - 0:비용미포함 1:비용포함
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_201r", "InBlock1", "IQRY_CLS_CODE", 0 , szStnd  )  '조회구분 - 1:최초매입   2:월정산

	elseif szTranID = "obtrc_comm_202r" then
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_202r", "InBlock1", "ACNO"          , 0 , szACNO )  '계좌번호
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_202r", "InBlock1", "ASNO"          , 0 , szASNO )  '계좌번호
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_202r", "InBlock1", "UI_IQRY_CLS"   , 0 , szBtn  )  '조회구분 - 0:비용미포함 1:비용포함
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_202r", "InBlock1", "IQRY_CLS_CODE" , 0 , szStnd )  '조회구분 - 1:최초매입   2:월정산

	'(v003) 주석 처리
'	elseif szTranID = "obacb_balc_105r" then
'		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "ACNO"          , 0 , szACNO )
'		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "ASNO"          , 0 , szASNO )
'		
'	ElseIf szTranID = "ooase_seex_084r" Then
'		DATAMANAGER.SetDataValue( 0, "ooase_seex_084r", "InBlock1", "ACNO"          , 0 , szACNO      )
'		DATAMANAGER.SetDataValue( 0, "ooase_seex_084r", "InBlock1", "ASNO"          , 0 , szASNO      )
'		DATAMANAGER.SetDataValue( 0, "ooase_seex_084r", "InBlock1", "UI_VLTN_AMT"   , 0 , g_nVLTN_AMT )

	end if
End Sub

'============================================================================
Sub cont0_FormTab0_OnTabChanged(nCurrentTab)
	Form.SaveConfigData("mbtrc11000_t5", "search", cont0.FormTab0.currenttab)	'조회기준 값 저장, (v001) 위치 이동

	VltnAmt_Request()  '(v003) 변경
	'Balance_Request() 
End Sub

'============================================================================
Sub cont0_btn0_OnClick()
	Form.SaveConfigData("mbtrc11000_t5", "cost", cont0.btn0.switchindex)			'비용여부 값 저장, (v001) 위치 이동

	VltnAmt_Request()  '(v003) 변경
	'Balance_Request() 
End Sub

