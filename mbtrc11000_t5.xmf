						</CELLINFO>
					</TOPHEADER>
					<BODY rowcount="1" impblkcnt="1" >
						<ROWINFO ly_vert_height="25" />
						<CELLINFO>
							<CELL name="bd_cell5" cell_ly="0,0,0,0" import="0,1,6" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
						</CELLINFO>
					</BODY>
				</COLUMN>
				<COLUMN colcount="1" >
					<SUBCOLINFO ly_vert_width="70" ly_vert_visible="0" />
					<TOPHEADER rowcount="1" >
						<ROWINFO ly_vert_height="25" />
						<CELLINFO>
							<CELL name="th_cell6" cell_ly="0,0,0,0" />
						</CELLINFO>
					</TOPHEADER>
					<BODY rowcount="1" impblkcnt="1" >
						<ROWINFO ly_vert_height="25" />
						<CELLINFO>
							<CELL name="bd_cell6" cell_ly="0,0,0,0" import="0,1,7" >
								<STATECOMP_INFO desttype="1" />
							</CELL>
						</CELLINFO>
					</BODY>
				</COLUMN>
			</COLINFO>
			<UPDATETR_INFO/>
			<UPDATEBC_INFO keycellid="bd_cell0" rangecellid="bd_cell0" hlcolorcellid="bd_cell0" />
		</GRID>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="18800" _ulen="17480" >

'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nAcntCount	'계좌 개수	
'Dim g_nAllCount	'전체조회시 계좌 Index, '(v003) 주석 처리
'Dim g_szList		'(v003) 주석 처리
'Dim g_sParam		'(v003) 주석 처리
'Dim g_nVLTN_AMT	'계좌평가금액, '(v003) 주석 처리

'Dim g_szDate		'(v003) 주석 처리

Dim g_OpenFlag	'콤보인덱스 세팅 시, 서비스 중복조회 방지
g_OpenFlag = False

Dim g_PopColor    '(v003) 색깔 처리 추가

Dim g_decimal     '(v003) 소수점 자릿수 추가
g_decimal = 0

Dim g_szCurr      '(v003) 통화코드 추가

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************

'============================================================================
Function VltnAmt_Request()		'계좌평가금액, 잔고 조회
	szACNO = Form.GetCtlProp("#acnt0", "total")
	if Trim(szACNO) = "" then
		exit Function
	end if
	
	DATAMANAGER.RequestTranData("obtrc_comm_201r")
	'DATAMANAGER.RequestTranData("obacb_balc_105r")  '누적손익 조회-1, '(v003) 주석 처리
	
	cont0.grd1.rowcount = 0
	cont0.grd1.SetClear()
	g_nNextCount = 0
	
	'DATAMANAGER.RequestTranData( "obtrc_comm_202r" )  '(v003) 위치 이동
End Function

'(v003) 주석 처리
