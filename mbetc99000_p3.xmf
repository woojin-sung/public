<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="99000" scrname="부자지수 측정결과" version="2" writer="이은섭" />
	<FORM_INFO name="Form" ly_vert="0,0,310,240,1" />
	<CONTROL_INFO>
		<LABEL name="Label0" fgcolor="007:030080200" fontsize="-1" fontstyle="01" halign="1" ly_vert="20,100,280,32,1" />
		<LABEL name="Label1" fontsize="-1" halign="1" ly_vert="20,140,276,32,1" />
		<LABEL name="Label2" fontsize="-1" halign="1" ly_vert="20,60,277,32,1" />
		<IMAGE name="Image1" imgpath="pop_header.9" ly_vert="0,0,310,50,1" />
		<IMAGE name="Image0" imgpath="ic_pop_close.png" ly_vert="270,10,30,30,1" />
		<LABEL name="Label6" fgcolor="006:213049051" fontsize="-1" fontstyle="01" caption="부자지수 측정결과" halign="1" ly_vert="20,12,270,32,1" />
		<BUTTON name="btnCancel" caption="취소" fgcolor="004:000000000" fontstyle="01" btnimage="btn_02.9" ly_vert="15,190,135,39,1" />
		<BUTTON name="btnok" caption="MRI 시작" fontstyle="01" btnimage="btn_05.9" ly_vert="160,190,137,39,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1680" _ulen="1420" >

'============================================================================
Sub Form_OnFormInit()

	
	szData = Form.GetOpenLinkData()
	'Form.ShowAlert("", szData)
	szList = split(szData,"●")
	
	asset = cint(szList(0)) * 10000
	income = cint(szList(1)) *10000
	age = cint(szList(2))
	
	result = (asset * 10) / (age * income)
	
	'result = 0.5
	if result <= 0.5 then
	Label0.caption = "현재로선 부자가 될 가능성이 낮습니다."
	Label1.caption = "MRI를 통해 당신의 부자지수를 높여 보세요."
	Label2.caption = "당신의 부자지수는 약 "&round(result,2)&" 입니다."
	
	elseif result>0.5 and result <1 then
	Label0.caption = "부자되기 위해 더 노력이 필요합니다."
	Label1.caption = "MRI를 통해 당신의 부자지수를 높여 보세요."
	Label2.caption = "당신의 부자지수는 약 "&round(result,2)&" 입니다."
	
	elseif result>=1 then
	Label0.caption = "현재 부자가 될 가능성이 높습니다."
	Label1.caption = "MRI를 통해 당신의 부자지수를 높여 보세요."
	Label2.caption = "당신의 부자지수는 약 "&round(result,2)&" 입니다."
	
	end if
	
	
End Sub

'============================================================================


'============================================================================
Sub btnok_OnClick()
	Form.OpenFramePopup("mbetc99000_s9" , "" , "")
Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>