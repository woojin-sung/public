'주문 환경
Dim g_szOdrPop

' 가격, 수량 설정
Dim g_szAfterInit
Dim g_szChangeInit

' 주문후 
Dim g_szAfterOrg

' ----- 주문설정값 공통변수 End ---------------------------------------------

Dim g_szCd, g_szMk
