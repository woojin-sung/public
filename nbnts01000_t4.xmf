'============================================================================
' Init_AfterOrder : 주문후 초기화
'============================================================================
Function	Init_InputControl()
	
	if g_bCntrtRtn == false then
		g_szQty = ""
		edtQty.caption = ""
		edtOrgNo.caption = ""
	end if
End Function

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화	
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력

	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170511 HAMWG START : 기본값 사용으로 변경
	' 종목/탭 변경시 초기화(기본값 : 미사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"		
	end if
	'20170511 HAMWG END 
	
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if	
End Function

'============================================================================
' Check_InputData
'============================================================================
Function Check_InputData(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Check_FundCd(nGbn) == false then	'20200331 HWG : 고유MTS
		return false
	end if

	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if

	if Trim(edtOrgNo.caption) == "" then
		Form.ShowAlert(g_szTitle, "원주문번호를 입력하십시요.")
		return false
	end if
	
	if chkAll.checkstate == "0" then		' 일부잔량 선택시
		if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
			Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
			return false
		end if
	end if
	
	if nGbn <> 2 then	
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup()
		else
			Request_Order(0)
		end if
	end if
	
	return true
End Function

'============================================================================
' Open_ConfirmPopup
'============================================================================
Function Open_ConfirmPopup(szWarn)
	Dim szData
	
	szData = "83"											' 매매구분
'	szData = szData & "|" & g_szMk								' 시장구분
	'20200331 HWG START : 고유MTS
	szData = szData & "|" & Form.GetCtlProp("#edtFundCd", "caption")	' 계좌번호
	szData = szData & "|" & Form.GetCtlProp("#lblFundNm", "caption")	' 계좌명
	'20200331 HWG END
	szData = szData & "|" & g_szCd								' 종목코드
	szData = szData & "|" & Form.GetItemCodeInfo(g_szCd, "name_night")		' 종목명
	szData = szData & "|" & ""									' 주문구분
	szData = szData & "|" & ""									' 주문가격	
	szData = szData & "|" & edtQty.caption						' 주문수량
	szData = szData & "|" & edtOrgNo.caption						' 원주문번호
	szData = szData & "|" & chkAll.checkstate						' 전량전부
	
	'20200331 HWG START : 고유MTS
	if Trim(szWarn) <> "" then
		szData = szData & "|" & szWarn					' 경고메세지
		
		Form.OpenPopup("nbnts01000_p7", szData , "")		' 경고팝업 오픈
	else
		Form.OpenPopup("nbnts01000_p4", szData , "")		' 주문확인팝업 오픈 '20200331 HWG : 고유MTS
	end if
	'20200331 HWG END
End Function

'============================================================================
' Request_Order
'============================================================================
Function Request_Order(nGbn)

	'20200331 HWG START : 고유MTS
	if nGbn == 1 then
		g_szWarnFlag = "Y"
	else
		g_szWarnFlag = "N"
	end if
	
	DATAMANAGER.RequestTranData("obtrf_oder_802c")
	'20200331 HWG END
	
End Function

