'============================================================================
' Check_FundCode	'20200331 HWG START : 고유MTS
'============================================================================
Function Check_FundCd(nGbn)
	Dim szFundCd, szPwd
	
	'메인화면 계좌번호
	szFundCd = Form.GetCtlProp("#edtFundCd", "caption") 
	
	If Len(szFundCd) < 4 Then
		Form.ShowAlert(g_szTitle, "펀드코드를 확인후 다시 입력하십시오.")
		return False
	End If
	
	if nGbn <> 2 then
		'메인화면 비밀번호
		szPwd = Form.GetCtlProp("#edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function
'20200331 HWG END

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption

	if Trim(szQty) == "" then
		szQty = 1
	else
		if Len(szQty) = 1 or Len(szQty) = 2 then
			nUnit = 1
		else
			nCnt = Len(szQty)-1
			
			For i = 0 to nCnt-1
				if i == 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CInt(szUnit)
		end if
		
		if nGbn == 0 then
			szQty = CInt(szQty) + nUnit
		elseif nGbn == 1 then
			if CInt(szQty) == 0 then
				Exit Function
			else
				szQty = CInt(szQty) - nUnit
			end if
		end if
	end if
	
	edtQty.caption = szQty
End Function

'============================================================================
' Return_ContractScreen : 미체결팝업에서 리턴된 값 적용
'============================================================================
Function Return_ContractScreen(szRet)
	tData = Split(szRet, "♥")		
	if UBound(tData) > 0 then
		' 메인화면에서 종목변경에 따른 구분자를 넣어준것
		if tData(5) == "1" then
			g_bCntrtRtn = true
		else
			g_bCntrtRtn = false
		end if

		if g_szAfterOrg == "1" then			' 주문번호 연동
			Form.SetCtlProp("#edtOrgNo", "caption", tData(0))
		end if
		
		edtOrgNo.caption = tData(0)						' 주문번호	
		g_szQty = ""
		
		'20170721 HAMWG START : 미체결 연동시 체크박
'		' 수량
		edtQty.caption = ""
	     g_szQty = tData(1)
'		if chkAll.checkstate == "1" then
'			edtQty.caption = ""						
'			g_szQty = tData(1)
'		else
'			edtQty.caption = tData(1)
'			g_szQty = tData(1)
'		end if
		'20170721 HAMWG END
		
		edtType.caption  = tData(2)		' 호가유형코드
		
		if Trim(tData(4)) == "" then
			edtClsCd.caption = "0"
		else
			edtClsCd.caption = tData(4)		' 주문구분코드
		end if
	end if
End Function


