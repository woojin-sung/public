'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Load_OrderSet() '주문설정값 읽어오기 
	chkAll_OnChange("1")
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 메인화면에서 종목코드 받기
	' ----------------------------------------------------------------------
	if sEventName == "INIT_CODE" then		' 메인화면에서 종목코드 받기
		if g_szCd == sParam then
			if g_szChangeInit == "1" then
				Form.SetCtlProp("#edtOrgNo", "caption", "")
			else
				edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
			end if
			
			g_bCntrtRtn = false
'			
'			if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
'				Init_InputControl()
'			end if
		else	
			if g_bCntrtRtn == false then
				Form.SetCtlProp("#edtOrgNo", "caption", "")
				edtOrgNo.caption = ""
			else
				if g_szChangeInit == "1" then
					Form.SetCtlProp("#edtOrgNo", "caption", "")
				else
					Form.SetCtlProp("#edtOrgNo", "caption", edtOrgNo.caption)
				end if
			end if
			
			g_szCd = sParam
			g_szMk = Form.GetItemCodeInfo(g_szCd, "market_night")
			
			if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
				Init_InputControl()
			end if
		end if
	' ----------------------------------------------------------------------
	' 메인화면에서 탭 체인지
	' ----------------------------------------------------------------------
	elseif sEventName == "CHANGE_TAB" then	
		'20170724 HAMWG START : 미체결 팝업 수량 연동 시 주문번호 변경되도 수량은 그대로 남아있는 현상 수정
		if edtOrgNo.caption <> null or edtOrgNo.caption <> "" then
			if edtOrgNo.caption <> Form.GetCtlProp("#edtOrgNo", "caption") then
				g_szQty = " "
				edtQty.caption = " "
			end if
		end if
		'20170724 HAMWG END
		edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
		g_szCd = sParam
		g_szMk = Form.GetItemCodeInfo(g_szCd, "market_night")
		
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			g_szQty = ""
			edtQty.caption = ""
			Init_InputControl()
		end if
			
	' ----------------------------------------------------------------------
	' 주문번호 연동
	' ----------------------------------------------------------------------			
	elseif sEventName == "AFTER_ORGNO" then		
		if g_szAfterOrg == "1" then			' 주문번호 연동
			edtOrgNo.caption = Form.GetCtlProp("#edtOrgNo", "caption")
		end if
	' ----------------------------------------------------------------------
	' 미체결팝업에서 리턴된 값 적용하기
	' ----------------------------------------------------------------------		
	elseif sEventName == "01000_CONTRACT_RETURN" then	'20200331 HWG : 고유MTS
		if sParam == "" then
			Exit Sub
		end if
	
		Return_ContractScreen(sParam)
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			Request_Order(1)	
		else
		    g_szWarnCd = "0"
		end if	
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order(0)	
		end if	
	' ----------------------------------------------------------------------
	' 수량입력창에서 리턴
	' ----------------------------------------------------------------------	
'	elseif sKeyName == "QTY_POPUP" then		
'		edtQty.caption = sRet
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szAll, szQty
	
	' 잔량전부 여부
	if chkAll.checkstate == "1" then
		szAll = "Y"
		szQty = g_szQty
	else
		szAll = "N"
		szQty = edtQty.caption
	end if
	
	'20200331 HWG START : 고유MTS
	' ----------------------------------------------------------------------
	' 선물옵션위탁주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtrf_oder_802c" then
		DATAMANAGER.ClearInputData(0, "obtrf_oder_802c")
		
		DATAMANAGER.SetDataValue(0, "obtrf_oder_802c", "InBlock1", "SVC_CLS_CODE"		, 0, "104")								' 서비스구분코드
		DATAMANAGER.SetDataValue(0, "obtrf_oder_802c", "InBlock1", "FNCD"				, 0, Form.GetCtlProp("#edtFundCd", "caption"))	' 펀드코드
		DATAMANAGER.SetDataValue(0, "obtrf_oder_802c", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "encdata"))		' 비밀번호
		DATAMANAGER.SetDataValue(0, "obtrf_oder_802c", "InBlock1", "ISCD"				, 0, "K" & g_szCd)						' 종목코드
		DATAMANAGER.SetDataValue(0, "obtrf_oder_802c", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag)						' 경고확인여부
		DATAMANAGER.SetDataValue(0, "obtrf_oder_802c", "InBlock1", "ORGL_ODER_NO"		, 0, edtOrgNo.caption)						' 원주문번호
		DATAMANAGER.SetDataValue(0, "obtrf_oder_802c", "InBlock1", "WHOL_RCTF_CNCL_YN"	, 0, szAll)								' 전체 정정 취소여부								' 전체 취소 취소여부
	end if
	'20200331 HWG END
	
End Sub
				
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szOdrMsg
	
	'20200331 HWG START : 고유MTS
	' ----------------------------------------------------------------------
	' 선물옵션위탁주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtrf_oder_802c" then
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_MSG_CNTT", 0)
		
'		if szWarnCd = "0" or szWarnCd = "" then
'			g_szTR = ""
'			
'			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
'			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
'
'			if Trim(szOrdCd) == "0001" then
'				if g_szAfterInit == "1" then		' 주문후 초기화
'					Init_InputControl()
'				end if
'				
'				Form.Toast(0, szOrdMsg, true)
'			end if
'		end if
		
		if szWarnCd = "1" then							' 경고
			Open_ConfirmPopup(szWarnMsg)
		elseif szWarnCd = "2" then						' 보류
			g_szTR = ""
			'Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
		else
			g_szTR = ""
			
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)

			if Trim(szOrdCd) == "0001" then
				if g_szAfterInit == "1" then		' 주문후 초기화
					Init_InputControl()
				end if
				
				Form.Toast(0, szOrdMsg, true)
			end if
		end If
	end if
	'20200331 HWG END
	
	g_szWarnFlag = "N"	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, "[TR]" & szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, "[TR]" & szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if
	
	' ----------------------------------------------------------------------
	' 선물옵션위탁주문(주문에러는 초기화 안함 : 20160314 전요셉과장)
	' ----------------------------------------------------------------------	
'	if szTranID == "obtrf_oder_101c" then	
