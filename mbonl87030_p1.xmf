' 03. 작    성 : 2016.01.18 ~ 최지희
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nCmbIndex	'콤보 선택
Dim g_szTitle			'타이틀
Dim g_szBrcd			'관리지점
Dim	g_szScrNo		'화면번호
g_szScrNo=""
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************


'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)
	if szTranID ==  "obcpp_cusr_027r" then
		if g_nCmbIndex = 0 then	'직원명			
			DATAMANAGER.SetDataValue(0,"obcpp_cusr_027r", "InBlock1", "FLNM" , 0 , edtNameNumber.caption)		'성명
			DATAMANAGER.SetDataValue(0, "obcpp_cusr_027r", "InBlock1", "EMPNO", 0 , "%")		'직원번호
		elseif g_nCmbIndex = 1 then	'직원번호
			DATAMANAGER.SetDataValue(0,"obcpp_cusr_027r", "InBlock1", "FLNM" , 0 , "%")		'성명
			DATAMANAGER.SetDataValue(0, "obcpp_cusr_027r", "InBlock1", "EMPNO", 0 , edtNameNumber.caption)		'직원번호
		end if

'		if g_szTitle == "관리자 검색" then
			DATAMANAGER.SetDataValue(0,"obcpp_cusr_027r", "InBlock1", "BLNG_DPCD"  , 0 , g_szBrcd)	'소속부서코드
'		elseif g_szTitle == "권유자 검색" then
'			DATAMANAGER.SetDataValue(0,"obcpp_cusr_027r", "InBlock1", "BLNG_DPCD"  , 0 , "%")	'소속부서코드
'		end if
		
		DATAMANAGER.RequestTranData("obcpp_cusr_027r")
	elseif szTranID ==  "obcpp_cusr_027r_1" then
		if g_nCmbIndex = 0 then	'직원명			
			DATAMANAGER.SetDataValue(0,"obcpp_cusr_027r_1", "InBlock1", "FLNM" , 0 , edtNameNumber.caption)		'성명
			DATAMANAGER.SetDataValue(0, "obcpp_cusr_027r_1", "InBlock1", "EMPNO", 0 , "%")		'직원번호
		elseif g_nCmbIndex = 1 then	'직원번호
			DATAMANAGER.SetDataValue(0,"obcpp_cusr_027r_1", "InBlock1", "FLNM" , 0 , "%")		'성명
			DATAMANAGER.SetDataValue(0, "obcpp_cusr_027r_1", "InBlock1", "EMPNO", 0 , edtNameNumber.caption)		'직원번호
		end if

'		if g_szTitle == "관리자 검색" then
'			DATAMANAGER.SetDataValue(0,"obcpp_cusr_027r_1", "InBlock1", "BLNG_DPCD"  , 0 , g_szBrcd)	'소속부서코드
'		elseif g_szTitle == "권유자 검색" then
			DATAMANAGER.SetDataValue(0,"obcpp_cusr_027r_1", "InBlock1", "BLNG_DPCD"  , 0 , "%")	'소속부서코드
'		end if
		
		DATAMANAGER.RequestTranData("obcpp_cusr_027r_1")
	end if
End Function

'============================================================================
' Set_NumMasking : 20160415 함수추가
'============================================================================
Function Set_NumMasking(szData)					
	if szData == null then		
		return ""
	else
		if Len(szData) <= 1 then				
			return szData			
		else				
			return Left(szData, Len(szData)-1 ) & "*"			
		end if		
	end if
End Function	

'============================================================================
' Set_StrMasking : 20160415 함수추가
'============================================================================
Function Set_StrMasking(szData)					
	if szData == null then		
		return ""
	else
		if Len(szData) < 6 then	
			return szData
		elseif Len(szData) == 6 then	
			return Left(szData, 3) .. "*"
		elseif Len(szData) > 6 then	
			return Left(szData, 3) .."*"..Mid(szData, 7)
		end if	
	end if
End Function	


'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' imgClose_OnClick
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szList
	Dim szTemp
	

	szTemp = Form.GetOpenLinkData()
	szList = Split(szTemp, "★")
	
	g_szTitle = szList(0)
	g_szBrcd = szList(1)
	lblTitle.caption = g_szTitle
	g_nCmbIndex = 0 
	
	' 20160415 그리드 분기 및 초기 전체조회 삭제
	if g_szTitle = "권유자 검색" then
		lblTitle.caption	=	"권유자 검색"
		Table0.SetCellString(0, 0, "상품 가입에 권유 또는 상품에 대한 내용을")
		Table0.SetCellString(1, 0, "설명드린 당사 직원을 등록해 주세요.")
		
		grdEmployee.visible = false
		grdEmployee1.visible = true
		
		'TR_Inquiry("obcpp_cusr_027r_1")
	elseif g_szTitle == "관리자 검색" then
		grdEmployee.visible = true
		grdEmployee1.visible = false
		
		'TR_Inquiry("obcpp_cusr_027r")
	end	if
End Sub


'============================================================================
' btnCancel_OnClick - 취소 버튼
'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
' cmbEmployee_OnEditComplete
'============================================================================
Sub cmbEmployee_OnEditComplete(iIndex)	
	edtNameNumber.caption = ""
	g_nCmbIndex = iIndex
End Sub

'============================================================================
' grdEmployee_OnClickUp
'============================================================================
Sub grdEmployee_OnClickUp(lRow, szCellID)

	Dim szNumber	'직원번호
	Dim szName	'직원명
	Dim szIndustry	'회사명
	Dim szTempData	'관리자(or권유자)★직원번호★직원명★회사명
	
	szNumber = grdEmployee.GetCellData( "bd_cell0", lRow )
	szName = grdEmployee.GetCellData( "bd_cell1", lRow )
	szIndustry = grdEmployee.GetCellData( "bd_cell2", lRow )
	
	szNum = grdEmployee.GetCellData( "bd_cell3", lRow )
	szNm  = grdEmployee.GetCellData( "bd_cell4", lRow )
	
	szTempData = "관리자★" & szNumber & "★" & szName & "★" & szIndustry & "★" & szNum & "★" & szNm
	
	Form.SendReturnToParent( "returnEmployee" , szTempData)
	Form.CloseForm()
	
End Sub

'============================================================================
' grdEmployee_OnScrollEnd
'============================================================================
Sub grdEmployee_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("obcpp_cusr_027r") == true then
		DATAMANAGER.RequestNextData("obcpp_cusr_027r")
	end if
End Sub

'============================================================================
' grdEmployee1_OnClickUp
'============================================================================
Sub grdEmployee1_OnClickUp(lRow, szCellID)

	Dim szNumber	'직원번호
	Dim szName	'직원명
	Dim szIndustry	'회사명
	Dim szTempData	'관리자(or권유자)★직원번호★직원명★회사명
	
	szNumber = grdEmployee1.GetCellData( "bd_cell0", lRow )
	szName = grdEmployee1.GetCellData( "bd_cell1", lRow )
	szIndustry = grdEmployee1.GetCellData( "bd_cell2", lRow )
	
	szNum = grdEmployee1.GetCellData( "bd_cell3", lRow )
	szNm  = grdEmployee1.GetCellData( "bd_cell4", lRow )
	
	szTempData = "권유자★" & szNumber & "★" & szName & "★" & szIndustry & "★" & szNum & "★" & szNm
	
	Form.SendReturnToParent( "returnEmployee" , szTempData)
	Form.CloseForm()
End Sub

'============================================================================
' grdEmployee1_OnScrollEnd
'============================================================================
Sub grdEmployee1_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("obcpp_cusr_027r_1") == true then
		DATAMANAGER.RequestNextData("obcpp_cusr_027r_1")
	end if
End Sub

'============================================================================
' btnSearch_OnClick
'============================================================================
Sub btnSearch_OnClick()
'	if edtNameNumber.caption == "" then
'		Form.MsgBox("알림", "직원명 또는 직원번호를 입력하세요", "", 0)
'		exit sub
'	end if
	
	if CStr(cmbEmployee.currentindex) == "1" then
		if Len(edtNameNumber.caption) < 2 then
			Form.MsgBox("알림", "직원번호를 2자이상 입력하세요", "", 0)
			Exit Sub
		end if
	elseif CStr(cmbEmployee.currentindex) == "0" then
		if Len(edtNameNumber.caption) < 6 then
			Form.MsgBox("알림", "직원명을 2자이상 입력하세요", "", 0)
			Exit Sub
		end if
	end if
	
	if g_szTitle == "관리자 검색" then
		TR_Inquiry("obcpp_cusr_027r")
	elseif g_szTitle == "권유자 검색" then
		TR_Inquiry("obcpp_cusr_027r_1")
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obcpp_cusr_027r" or szTranID == "obcpp_cusr_027r_1" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
	end if	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete	:160328 KMC	펀드매매시에 메시지추가
' 20160415 : * 추가
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcpp_cusr_027r" then				
		nRow = grdEmployee.rowcount			
					
		For i = 0 to nRow-1			
			szNum = grdEmployee.GetCellData("bd_cell0", i)		
			szRtn = Set_NumMasking(szNum)		
			grdEmployee.SetCellData("bd_cell3", i, szRtn)		
					
			szName = grdEmployee.GetCellData("bd_cell1", i)		
			szName = Replace(szName, "**", "나")		
			szRtn = Set_StrMasking(szName)		
							
			grdEmployee.SetCellData("bd_cell4", i, szRtn)	
		Next			
					
		if DATAMANAGER.GetDataMsgCode( "obcpp_cusr_027r" ) == "5820" then			
			Form.ShowAlert("알림", "해당 직원은 계좌 관리점 소속이 아니거나 해당 직원 정보가 존재하지 않습니다.")	
		end if			
	elseif szTranID == "obcpp_cusr_027r_1" then				
		nRow = grdEmployee1.rowcount			
					
		For i = 0 to nRow-1			
			szNum = grdEmployee1.GetCellData("bd_cell0", i)		
			szRtn = Set_NumMasking(szNum)		
			grdEmployee1.SetCellData("bd_cell3", i, szRtn)		
					
			szName = grdEmployee1.GetCellData("bd_cell1", i)		
			szName = Replace(szName, "**", "나")		
			szRtn = Set_StrMasking(szName)	
					
			grdEmployee1.SetCellData("bd_cell4", i, szRtn)	
		Next			
					
		if DATAMANAGER.GetDataMsgCode( "obcpp_cusr_027r_1" ) == "5820" then			
			Form.ShowAlert("알림", "해당 직원 정보가 존재하지 않습니다.")	
		end if			
	end if				
End Sub

