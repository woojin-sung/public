	</CONTROL_INFO>
	<SCRIPT_INFO _len="898" _ulen="894" >
'--===========================================================================
'--===========================================================================

'============================================================================
Sub Button0_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub Button1_OnClick()
	Form.SendReturnToParent( "CANCEL" , "ok" ) 'JWH 추가
	Form.CloseForm( )
End Sub

'============================================================================
Sub BtnClose_OnClick()
    Form.CloseForm( )	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

    If sKey == "&LOGIN_AUTH" Then
        
        If sValue == "0" Or sValue == "1" Then
            Form.CloseForm()
        End If
    
    End If

End Sub

