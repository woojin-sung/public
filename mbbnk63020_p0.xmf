	<CONTROL_INFO>
		<IMAGE name="Image0" imgpath="popup_bg.9" ly_vert="0,500,375,210,1" />
		<BUTTON name="Button0" caption="닫기" fgcolor="095:000000000" bgcolor="229:255255255" fontsize="2" fontstyle="01" btnimage="btn_27.9" ly_vert="0,597,187,50,1" />
		<BUTTON name="Button1" caption="취소하기" fontsize="2" fontstyle="01" btnimage="btn_20.9" ly_vert="187,597,188,50,1" />
		<LABEL name="Label2" caption="지연이체 접수 취소 시, 이체가 처리되지 않습니다." halign="1" valign="0" multiline="1" ly_vert="20,527,335,20,1" />
		<LABEL name="Label3" caption="취소하시겠습니까?" halign="1" valign="0" multiline="1" ly_vert="20,549,335,20,1" />
