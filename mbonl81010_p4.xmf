				<CELL cell_ly="0,3,0,3" halign="0" line="0,0" caption="투자시 원금 손실이 발생할 수 있으며, 투자" impidxs="" />
				<CELL cell_ly="0,4,0,4" halign="0" line="0,0" caption="손익에 대한 책임은 모두 고객에게 귀속됩니" impidxs="" />
