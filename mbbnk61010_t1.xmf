			sMdiaSkipYN = "N"
		Else
			sMdiaSkipYn = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r_1", "OutBlock3", "SECU_MDIA_EXLS_YN" , 0)
		End If
		'v003 fin
	    
	    If Ubound(arrData) > 0 then
'	       Form.ShowAlert("multigrid", szData)
	       szCom = arrData(7)
	       if szCom == "287" then
			  DATAMANAGER.SetDataValue( 0,"obrtd_drng_004a", "InBlock1", "ACNO" , 0, Left(arrData(0),8))
		      DATAMANAGER.SetDataValue( 0,"obrtd_drng_004a", "InBlock1", "ASNO" , 0, Right(arrData(0),2) )
