Dim szOneTempList2 'v007
		
'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************
'============================================================================
' Final_Chk() : 이체건수가 1건이고, 입금 내역을 세팅한 상태에서 이체 실행 눌렀을때 초기화
'============================================================================
Function OneClear() 
	Form.SetCtlProp( "#edtPwd", "caption", "")
	cont0.contAmt.edtAble.caption      = ""
	cont0.contAmt.edtAmt.caption       = ""
	cont0.contTran.edtAcnt.caption     = ""
	cont0.contTran.edtReceiver.caption = ""
	cont0.contTran.edtMytip.caption    = ""
	cont0.contTran.edtRcvTip.caption   = ""
	Edit0.caption = 0
	Edit1.caption = 0
	Edit2.caption = 0
	g_szTramt     = 0
	g_szTactamt   = 0
	g_tact_amt    = 0
End Function
'============================================================================
' FrdSspc_Chk() : 사기의심 체크 - v005  FrdSspc_Chk 완료시 Final_Chk 호출
'============================================================================
Function FrdSspc_Chk()

     szDataTrTxpl = cont0.contTran.edtRcvTip.caption	'받는분표시

	DATAMANAGER.SetDataValue( 0, "obrtp_comn_025r", "InBlock1", "ACNO"   , 0 , Left(g_szAccount, 8))
	DATAMANAGER.SetDataValue( 0, "obrtp_comn_025r", "InBlock1", "ASNO"   , 0 , Right(g_szAccount, 2) )
	DATAMANAGER.SetDataValue( 0, "obrtp_comn_025r", "InBlock1", "TR_EXPL", 0 , szDataTrTxpl )
	DATAMANAGER.SetDataValue( 0, "obrtp_comn_025r", "InBlock1", "RMRK"   , 0 , "" )
	DATAMANAGER.RequestTranData( "obrtp_comn_025r")

End Function
'============================================================================
' Final_Chk() : 이체추가, 즉시이체 전 수취인 조회
'============================================================================
Function Final_Chk()
'USE_YN_CHK() '종료체크 v008
	szData = g_szAccountPassword'비번        
	szData2 = cont0.contTran.edtBank.caption  '입금은행
	szData3 = cont0.contTran.edtAcnt.caption	'입금계좌번호	   			    
	'szData3 = cont0.contTran.edtReceiver.caption	'받는분			
	szData4 = cont0.contAmt.edtAmt.caption	'이체금액
	'수수료
	szData5 = cont0.contTran.edtMytip.caption	'내통장표시			
	szData6 = cont0.contTran.edtRcvTip.caption	'받는분표시
	'szData7 = GridPro1.GetCellString( i , 0 , 11 )	'결과(처리완료구)
	'szData8 = GridPro1.GetCellString( i , 0 , 8 )	'은행코드
	'szData9 = GridPro1.GetCellString( i , 0 , 12 )	'대외거래고유번호
	'♥출금계좌'입금은행'입금계좌번호'이체금액'내통장표시'받는분표시♥
	g_szData    = g_szAccount &"♥"& szData2 &"♥"& szData3 &"♥"& szData4 &"♥"& szData5 &"♥"& szData6
	g_szOneData = g_szAccount &"♥"& szData2 &"♥"& szData3 &"♥"& szData4 &"♥"& szData5 &"♥"& szData6
'	Form.ShowAlert(g_szTitle, g_szData)	
	   
	if Trim(szData3) = "" then
		Form.ShowAlert(g_szTitle, "입금계좌번호를 입력하십시요.")
		Exit Function
	end if
	   
	if Trim(szData1) = Trim(szData3) then
		Form.ShowAlert(g_szTitle,"출금계좌번호와 입금계좌번호가 같습니다.")
		g_nAddflag = 0
		Exit Function
	end if

	if g_szCom == "287" then
		if Len(Trim(szData3)) <> 10 then
			Form.ShowAlert(g_szTitle, "당행 입금계좌번호를 잘못 입력하였습니다.")
			Exit Function
		end if
		DATAMANAGER.SetDataValue( 0, "obrtd_drng_025r_1", "InBlock1", "PWD", 0, szData )
		DATAMANAGER.SetDataValue( 0, "obrtd_drng_025r_1", "InBlock1", "ACNO", 0 , Left(g_szAccount, 8))
		DATAMANAGER.SetDataValue( 0, "obrtd_drng_025r_1", "InBlock1", "ASNO", 0 , Right(g_szAccount, 2) )
		DATAMANAGER.SetDataValue( 0, "obrtd_drng_025r_1", "InBlock1", "CNFT_ACNO", 0 , Left(szData3, 8))
		DATAMANAGER.SetDataValue( 0, "obrtd_drng_025r_1", "InBlock1", "CNFT_ASNO", 0 , Right(szData3, 2) )
		DATAMANAGER.SetDataValue( 0, "obrtd_drng_025r_1", "InBlock1", "USE_YN", 0 , "Y")
		DATAMANAGER.RequestTranData( "obrtd_drng_025r_1" )
	
	else
	    g_tact_amt = CDbl(szData4) 
	    
'	    if g_szProType == 1 then   '이체추가 클릭시 jhi
'		   '2018.06.26 정헌일. 이체한도 체크로직추가
'		   if CDbl(szData4)  >  CDbl(Edit2.caption) then
'               Form.ShowAlert("알림", "1회 이체한도 초과입니다..")
'		   end if
'		
'		   g_szTramt = CDbl(g_szTramt) + CDbl(szData4)
'		   
'		   'Form.ShowAlert("알림", g_szTramt)  'jhi
'		
'		    '2018.06.26 정헌일. 이체한도 체크로직추가
'		    if (CDbl(g_szTramt) + CDbl(Edit0.caption)) > CDbl(Edit1.caption) then
'		       Form.ShowAlert("알림", "1일 이체한도 초과입니다..")
'		    end if
'		end if
			
		g_rcvn_iqry_tmnu = 0 '수취조회횟수 v006
         DATAMANAGER.SetDataValue( 0, "obtss_elbs_121r_1", "InBlock1", "ACNT_PROD_CLS_CODE", 0 ,Right(g_szAccount, 2))'상품코드 ->계좌일련
		DATAMANAGER.SetDataValue( 0, "obtss_elbs_121r_1", "InBlock1", "PWD", 0, szData )
		DATAMANAGER.SetDataValue( 0, "obtss_elbs_121r_1", "InBlock1", "DRNG_ACNO" ,0 , Left(g_szAccount, 8) )
		DATAMANAGER.SetDataValue( 0, "obtss_elbs_121r_1", "InBlock1", "MNRC_BANK_CODE", 0, g_szCom)
		DATAMANAGER.SetDataValue( 0, "obtss_elbs_121r_1", "InBlock1", "JOB_TRNO", 0, "031" ) '작업단말번호
		DATAMANAGER.SetDataValue( 0, "obtss_elbs_121r_1", "InBlock1", "MNRC_ACNO", 0 , szData3)
		DATAMANAGER.SetDataValue( 0, "obtss_elbs_121r_1", "InBlock1", "TR_AMT", 0 , szData4)
		DATAMANAGER.RequestTranData( "obtss_elbs_121r_1" )
	'	      
	end if

End Function	   
'============================================================================
' Return_to_Pro(nIndex) : 착오송금 예방 사용시 착오송금후 실행 Process
'============================================================================
Function Return_to_Pro(nIndex)
	
	if nIndex == 1 then	'이체추가
		temp = Check_Account() 
		if temp =  False then
			exit Function
		end if 
'		cont0_contTran_btnName_OnClick()
		temp1 = Check_Edit()
			if temp1 =  False then
				exit Function
			end if 
		g_nAddflag = 1	 
'		temp2 = Load_Data()
		
		'Final_Chk() v005 사기의심체크이후 실행
		FrdSspc_Chk()
		
'		if temp2 =  False then
'			g_nAddflag = 0
'			exit Function
'			    
'		else
'			g_nTrcnt = g_nTrcnt +1
'				
'			cont0.contQuery.btnProc.caption = "이체실행"
'		    'Open_Linkform()    
'	    
'		end if
	elseif nIndex == 2 then	'즉시이체
		temp = Check_Account() 
		if temp =  False then
			exit Function
		end if 
	    
		nCnt = cont0.contQuery.Grid0.rowcount	
		if Cint(nCnt) <= 0 then
			temp1 = Check_Edit()
		    if temp1 =  False then
				exit Function
			end if 
			
			
			'Final_Chk() v005 사기의심체크이후 실행
			FrdSspc_Chk()
	'		temp2 = Load_Data()
'			if temp2 =  False then
'				exit Function
'			end if  		
		end if
		
		if CInt(cont0.contQuery.Grid0.rowcount) > 0 then
		
			g_nAddflag = 0
	
		    if g_szTRPass == "Y" then  'TR후 호출가----if g_szDsgtUI = "Y"??
			   Form.OpenPopup("mbbnk61010_p9" , "" , "") '단말기지정필요--------
			   Exit Function
			end if   
	
			If g_szFee == "" or g_szFee == null then'g_szFee
				g_szFee = "0"
			End If  
		    
			if g_szCom == "" or g_szCom == null then
				Form.ShowAlert( "알림", "입금 은행을 확인 하십시오" )
			end if
		    
			DATAMANAGER.RequestTranData( "obcsb_oimf_638r_1" )
			
			szPwd = g_szAccountPassword
			szAcc = g_szAccount
		end if
		
		
'		g_nAddflag = 0
'	  
'	    if g_szTRPass == "Y" then  'TR후 호출가----if g_szDsgtUI = "Y"??
'		   Form.OpenPopup("mbbnk61010_p9" , "" , "") '단말기지정필요--------
'		   Exit Function
'		end if   
'
'		If g_szFee == "" or g_szFee == null then'g_szFee
'			g_szFee = "0"
'		End If  
'	    
'		if g_szCom == "" or g_szCom == null then
'			Form.ShowAlert( "알림", "입금 은행을 확인 하시요" )
'		end if
'	    
'		DATAMANAGER.RequestTranData( "obcsb_oimf_638r_1" )
'		
'		szPwd = g_szAccountPassword
'		szAcc = g_szAccount
	end if
	
End Function
'============================================================================
' Check_Account
'============================================================================
Function Check_Account()

	If Len(g_szAccount) < 10 Then
	    Form.ShowAlert(g_szTitle, "계좌번호를 확인하십시오!")
	    return False
	End If
	
	If Trim(g_szAccountPassword) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인하십시오!")
			return False
	end If

	
	return True
End Function
