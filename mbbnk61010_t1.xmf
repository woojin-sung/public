Function Form_Reset()
	Form.SetCtlProp( "#edtPwd", "caption", "")
	cont0.contAmt.edtAble.caption      = ""
	cont0.contAmt.edtAmt.caption       = ""
	cont0.contTran.edtAcnt.caption     = ""
	cont0.contTran.edtReceiver.caption = ""
	cont0.contTran.edtMytip.caption    = ""
	cont0.contTran.edtRcvTip.caption   = ""
	cont0.contTran.edtBank.caption     = "메리츠증권"
	g_szCom                            = "287"
	g_nTrcnt                           = 0
	cont0.contQuery.Grid0.SetClear()
'	cont0.contQuery.Grid0.rowcount = 0
	cont0.contQuery.tblAdd.SetCellString( 0, 1, "" )
	cont0.contQuery.tblAdd.SetCellString( 0, 3, "" )'
	cont0.contQuery.Grid0.height       = 8
	cont0.contQuery.Table0.top         = 100
	cont0.contQuery.height             = 180
	cont0.contQuery.SetScrollAutoSize()
	cont0.height                       = 476
	cont0.SetScrollAutoSize()
	
	g_nTrRcvCnt = 0
	g_szTRError = 0
	g_nCntDelay = 0
	
	Form.removeWaitCursor()
End Function

Function Edit_Reset()
	cont0.contAmt.edtAmt.caption       = ""
	cont0.contTran.edtAcnt.caption     = ""
	cont0.contTran.edtReceiver.caption = ""
	cont0.contTran.edtMytip.caption    = ""
	cont0.contTran.edtRcvTip.caption   = ""
	cont0.contTran.edtBank.caption     = "메리츠증권"
	g_szCom                            = "287"
	cont0_contAmt_btnIqry_OnClick()
	'g_nAddflag = 0
End Function   


