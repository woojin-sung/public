Sub cont0_contAmt_edtAmt_OnEditComplete()
	Dim szTempMoney1, szTempMoney2
	szTempMoney1 = cont0.contAmt.edtAble.caption
	szTempMoney2 = cont0.contAmt.edtAmt.caption
	if CDbl(szTempMoney1) < CDbl(szTempMoney2) then
		Form.ShowAlert("알림", "이체금액이 출금가능금액을 초과했습니다.")
		cont0.contAmt.edtAmt.caption = ""
		exit sub
	end if	
End Sub

