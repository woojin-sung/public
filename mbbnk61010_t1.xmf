'		g_szDsgtUI = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r_1", "OutBlock1", "TERM_DSGT_STPL_YN" , 0)) '단말지정팝업여부	
		g_szPlusUI = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r_1", "OutBlock1", "SPLM_ATHN_NCSR_YN", 0 ))'추가인증팝업여부
		g_szTRPass = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r_1", "OutBlock1", "UI_SPLM_YN" , 0)
		
		szPwd = g_szAccountPassword
		szAcc = g_szAccount
		
		sMdiaSkipYn = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r_1", "OutBlock3", "SECU_MDIA_EXLS_YN" , 0)
		Form.SetSharedData("61010_SMDIA_SKIP", sMdiaSkipYn )
		
		if CInt(g_nTrcnt) > 1 or CInt(cont0.contQuery.Grid0.rowcount) > 1 then' 다건이체
			Dim sAmt 
			Dim sFee 
			Dim szMultiData
			Dim szTactamt
			
			szMultiData = ""
			nCnt = cont0.contQuery.Grid0.rowcount
			for i = 0  to CInt(nCnt)-1
				  szData     = cont0.contQuery.Grid0.GetCellData( "bd_cell8", i )
				  szReceiver = cont0.contQuery.Grid0.GetCellData( "bd_cell11",  i )
				  
				  if i == 0 then
					  szMultiData = szData &"♥"& szReceiver
				  else
					  szMultiData = szMultiData & "@"  & szData &"♥"& szReceiver
				  end if
			      
			      arrData = Split(szData, "♥")''출금계좌'입금은행'입금계좌번호'이체금액'내통장표시'받는분표시 'Fee 'g_szCom 'g_szBrcd
											'g_szData = g_szData  &"♥"& g_szFee  &"♥"& g_szCom &"♥"& g_szBrcd										
			      sAmt = CDbl(sAmt) + CDbl(arrData(3))
			      sFee = CDbl(sFee) + CDbl(arrData(6))	
			      
      		      if cont0.contQuery.Grid0.GetCellData( "bd_cell17",  i ) ~= "287" then
			         '2018.06.26 정헌일. 이체한도 체크로직추가
			         if CDbl(arrData(3))  >  CDbl(Edit2.caption) then				    
				        Form.ShowAlert("알림", "1회 이체한도 초과입니다..")
				     end if
				     
				     szTactamt = CDbl(szTactamt) + CDbl(arrData(3))
				 end if
			next
	
			'2018.06.26 정헌일. 이체한도 체크로직추가
			if (CDbl(szTactamt) + CDbl(Edit0.caption)) > CDbl(Edit1.caption) then
			   Form.ShowAlert("알림", "1일 이체한도 초과입니다..")
			end if		
			
              'jhi. T1811160033 금융사기 예방을 위한 문진제도 강화 대응
              '팝업에서 예를 선택하면 OnPopupReturn 이벤트 Call 됨.
              g_szCnt    = 0
              g_szTotCnt = cont0.contQuery.Grid0.rowcount
	      
              gsz_sAmt            = sAmt
              gsz_sFee            = sFee
              gsz_szMultiData     = szMultiData
		     

			'v003 sta : 입금계좌가 당사 동일명의 계좌인지 확인
			DATAMANAGER.RequestTranData("obrtp_comn_019r")
			'v003 fin
			
		elseif CInt(g_nTrcnt) == 1 or CInt(cont0.contQuery.Grid0.rowcount) == 1 then
			g_szEdtName = cont0.contQuery.Grid0.GetCellData( "bd_cell11", 0 )
			g_szCom = cont0.contQuery.Grid0.GetCellData( "bd_cell17", 0 )	
			
			if g_szCom ~= "287" then
			   '2018.06.26 정헌일. 이체한도 체크로직추가
		        if CDbl(cont0.contQuery.Grid0.GetCellData( "bd_cell12", 0 )	)  >  CDbl(Edit2.caption) then  ' 이체금액 > 1회이체한도
			       Form.ShowAlert("알림", "1회 이체한도 초과입니다..")
			    end if

		        if ( CDbl(cont0.contQuery.Grid0.GetCellData( "bd_cell12", 0 )	) + CDbl(Edit0.caption))  >  CDbl(Edit1.caption) then  ' 이체금액 + 누적이체금액 > 1회이체한도
			      Form.ShowAlert("알림", "1일 이체한도 초과입니다..")
			    end if
			end if
			
			'v003 sta : 입금계좌가 당사 동일명의 계좌인지 확인
			DATAMANAGER.RequestTranData("obrtp_comn_019r")
			'v003 fin
			
		else '단건이체	
		     if g_szCom ~= "287" then   '메리츠가 아닌 이체거래		     
		      ' Form.ShowAlert("알림", cont0.contAmt.edtAmt.caption)
   		        '2018.06.26 정헌일. 이체한도 체크로직추가
		        if CDbl(cont0.contAmt.edtAmt.caption)  >  CDbl(Edit2.caption) then  ' 이체금액 > 1회이체한도
			       Form.ShowAlert("알림", "1회 이체한도 초과입니다..")
			    end if
			
		        if (CDbl(cont0.contAmt.edtAmt.caption) + CDbl(Edit0.caption))  >  CDbl(Edit1.caption) then  ' 이체금액 + 누적이체금액 > 1회이체한도
			      Form.ShowAlert("알림", "1일 이체한도 초과입니다..")
			    end if
			end if
			
			'START--------------------------------
			'v001 이체금액 재조립
			szTempList = Split(g_szData, "♥")
			    
			if UBOUND(szTempList) < 1 THEN
				exit sub
			END IF
			
						
			'이체금액 == 출금가능금액
			if CDbl(szTempList(3)) == CDbl(cont0.contAmt.edtAble.caption) and CDbl(g_szFee) > 0 then
			
			    if CDbl(szTempList(3)) - CDbl(g_szFee) <= 0 then
	                 Form.ShowAlert( "알림", "출금가능금액이 부족합니다."+ Chr(10) + "(타기관 이체출금의 경우 수수료 포함)" + Chr(10) + "이체예정내역을 확인하여 주시기 바랍니다.")
	                 EXIT sub
	             end if
	     
			     g_szDataTemp = ""
				g_szDataTemp = szTempList(0) &"♥"& szTempList(1) &"♥"& szTempList(2)
				g_szDataTemp = g_szDataTemp &"♥"& CDbl(szTempList(3)) - CDbl(g_szFee)
				g_szDataTemp = g_szDataTemp &"♥"& szTempList(4) &"♥"& szTempList(5)
				g_szData = ""
				g_szData = g_szDataTemp
				
				szOneTempList = Split(g_szOneData, "♥")
    
				if UBOUND(szOneTempList) < 1 THEN
					EXIT sub
				END IF
				
				g_szOneDataTemp = ""
				g_szOneDataTemp = szOneTempList(0) &"♥"& szOneTempList(1) &"♥"& szOneTempList(2)
				g_szOneDataTemp = g_szOneDataTemp &"♥"& CDbl(szOneTempList(3)) - CDbl(g_szFee)
				g_szOneDataTemp = g_szOneDataTemp &"♥"& szOneTempList(4) &"♥"& szOneTempList(5)
				g_szOneData = ""
				g_szOneData = g_szOneDataTemp
				
				Form.ShowAlert("알림", "수수료 징수 대상입니다." + Chr(10) +  "수수료를 제외한 금액을 이체합니다.")
			'이체금액 + 수수료 > 출금가능금액
			elseif CDbl(szTempList(3)) + CDbl(g_szFee) > CDbl(cont0.contAmt.edtAble.caption) then
'			    g_szDataTemp = szTempList(0) &"♥"& szTempList(1) &"♥"& szTempList(2)
'				g_szDataTemp = g_szDataTemp &"♥"& CDbl(cont0.contAmt.edtAble.caption) - CDbl(g_szFee)
'				g_szDataTemp = g_szDataTemp &"♥"& szTempList(4) &"♥"& szTempList(5)
'				g_szData = ""
'				g_szData = g_szDataTemp
				
				if CDbl(g_szFee) > 0 then
                      Form.ShowAlert( "알림", "출금가능금액이 부족합니다." + Chr(10) + "(타기관 이체출금의 경우 수수료 포함)" + Chr(10) + "이체금액을 확인하여 주시기 바랍니다.")
		         else
			        Form.ShowAlert( "알림", "출금가능금액이 부족합니다." + Chr(10) + "이체금액을 확인하여 주시기 바랍니다.")
			     end if
			     
		         Exit sub
			end if
			'----------------------------------END
				 
			g_szEdtName = cont0.contTran.edtReceiver.caption
			
			'v003 sta : 입금계좌가 당사 동일명의 계좌인지 확인
			DATAMANAGER.RequestTranData("obrtp_comn_019r")
			'v003 fin
		end if
	'v004 사가의심체크호출후 -> Final_Chk
	elseif szTranID == "obrtp_comn_025r" then
		ProsAbleYn = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PROS_ABLE_YN" , 0)
		if ProsAbleYn == "Y" Then
			Final_Chk()
		end if
	
	'v003 sta : 문진프로세스 처리 로직 obrtp_comn_019r complete 시점으로 변경
	elseif szTranID == "obrtp_comn_019r" then	
		'v003 sta : 동일인 여부 받아와 동일인일경우 금융사기문진, 보안매체, 전자서명 생략 및 간편이체한도 미적용 
		g_szSapeYN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SAPE_YN" , 0)		'동일인 여부(Y/N)
		Form.SetSharedData("61010_SAPE_YN", g_szSapeYN )
		
		If g_szSapeYN == "Y" Then
			if CInt(g_nTrcnt) > 1 or CInt(cont0.contQuery.Grid0.rowcount) > 1 then' 다건이체 
				g_nTrIndex2 = g_nTrIndex2 + 1
				if g_nTrIndex2 ==  CInt(cont0.contQuery.Grid0.rowcount) Then
					g_nTrIndex2 = 0
					sAmt        = gsz_sAmt
					sFee        = gsz_sFee 
					szMultiData = gsz_szMultiData
					Form.OpenFramePopup( "mbbnk61010_pb", cont0.contQuery.Grid0.rowcount &"♥"& sAmt  &"♥"&  sFee &"♥"& Left(szAcc,8) &"♥"& szPwd &"♥"&  g_szPlusUI &"★"& szMultiData ,"")
				Else
					DATAMANAGER.RequestTranData( "obrtp_comn_019r" )					
				End if
	 
             elseif CInt(g_nTrcnt) == 1 or CInt(cont0.contQuery.Grid0.rowcount) == 1 then
                Form.OpenFramePopup( "mbbnk61010_p0", g_szOneData &"♥"& g_szFee  &"♥"&  g_szPlusUI  &"♥"& cont0.contQuery.Grid0.rowcount &"♥"& g_szEdtName &"♥"& szPwd &"♥"& g_szCom, "")
                'Form_Reset()
                OneClear() 
                DATAMANAGER.RequestTranData( "obrtp_drab_001r" )
             else 
                '단건 즉시이체시
                 Form.OpenFramePopup( "mbbnk61010_p0", g_szData &"♥"& g_szFee  &"♥"&  g_szPlusUI  &"♥"& cont0.contQuery.Grid0.rowcount &"♥"& g_szEdtName &"♥"& szPwd &"♥"& g_szCom, "")
		    end if
		Else
			'jhi 문진프로세스	     
			Dim szFiledate2, szPopup2
			szFiledate2 = Form.LoadConfigData( "mbbnk61010_pe", "mbbnk61010_curdate" )
			szPopup2    = Form.LoadConfigData( "mbbnk61010_pe", "mbbnk61010_popup" )
			
			If szFiledate2 <> Form.GetSharedData("&HOST_DATE" , false)  Then
				g_nTrIndex2 = 0
				Form.OpenPopup("mbbnk61010_pe" , ""  , "")	
			Else
				If popup2 = "Y" Then
					g_nTrIndex2 = 0
					Form.OpenPopup("mbbnk61010_pe" , ""  , "")	
				Else
					if CInt(g_nTrcnt) > 1 or CInt(cont0.contQuery.Grid0.rowcount) > 1 then' 다건이체 
						g_nTrIndex2 = 0
						sAmt        = gsz_sAmt
						sFee        = gsz_sFee 
						szMultiData = gsz_szMultiData
						Form.OpenFramePopup( "mbbnk61010_pb", cont0.contQuery.Grid0.rowcount &"♥"& sAmt  &"♥"&  sFee &"♥"& Left(szAcc,8) &"♥"& szPwd &"♥"&  g_szPlusUI &"★"& szMultiData ,"")
					elseif CInt(g_nTrcnt) == 1 or CInt(cont0.contQuery.Grid0.rowcount) == 1 then
						'1계좌 추가만 하고 이체 시행할때
						Form.OpenFramePopup( "mbbnk61010_p0", g_szOneData &"♥"& g_szFee  &"♥"&  g_szPlusUI  &"♥"& cont0.contQuery.Grid0.rowcount &"♥"& g_szEdtName &"♥"& szPwd &"♥"& g_szCom, "")
						OneClear() 
						DATAMANAGER.RequestTranData( "obrtp_drab_001r" )
					else
						'단건 즉시이체
						Form.OpenFramePopup( "mbbnk61010_p0", g_szData &"♥"& g_szFee  &"♥"&  g_szPlusUI  &"♥"& cont0.contQuery.Grid0.rowcount &"♥"& g_szEdtName &"♥"& szPwd &"♥"& g_szCom, "")
					End if
				End if
			End if
	
			'jhi. OnPopupReturn 으로 이동처리 
			'16-04-04 g_nTrcnt => grdRowCount 로 변경
			'Form.OpenFramePopup( "mbbnk61010_pb", cont0.contQuery.Grid0.rowcount &"♥"& sAmt  &"♥"&  sFee &"♥"& Left(szAcc,8) &"♥"& szPwd &"♥"&  g_szPlusUI &"★"& szMultiData ,"") 
			
			'jhi. OnPopupReturn 으로 이동처리 
			'Form.OpenFramePopup( "mbbnk61010_p0", g_szOneData &"♥"& g_szFee  &"♥"&  g_szPlusUI  &"♥"& cont0.contQuery.Grid0.rowcount &"♥"& g_szEdtName &"♥"& szPwd &"♥"& g_szCom, "")
			'Form_Reset()
			'OneClear() 
			'DATAMANAGER.RequestTranData( "obrtp_drab_001r" )
			
			'jhi. OnPopupReturn 으로 이동처리
			'Form.OpenFramePopup( "mbbnk61010_p0", g_szData &"♥"& g_szFee  &"♥"&  g_szPlusUI  &"♥"& cont0.contQuery.Grid0.rowcount &"♥"& g_szEdtName &"♥"& szPwd &"♥"& g_szCom, "")
		End If
	'v003 fin
	end if  
End Sub

'============================================================================
Sub cont0_contTran_chkProc_OnChange(sCheckState)
	
	g_szChkType = sCheckState
	
	if sCheckState = "1" then
		g_szChkType = 1
'	   Form.OpenPopup("mbbnk61010_p2" , "" , "")
	else 
'	   cont0.contTran.edtReceiver.caption = ""
		g_szChkType = 0
	end if   

End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "예금주명" then
		If sRet <> "Y" then
'	      cont0.contTran.edtReceiver.caption = Trim(sRet)
	      'cont0_contTran_btnName_OnClick()
		Else 
			Return_to_Pro(g_szProType)
'	      cont0_contTran_chkProc_OnChange("0")
		End If  
	ElseIf sKeyName == "61010_OFTEN" or sKeyName == "mbbnk61040_p5" then '자주쓰는계좌/최근이체계좌
		If sRet <> "" then
			tData = Split(sRet, "★")
			cont0.contTran.edtReceiver.caption = tData(3)
			cont0.contTran.edtAcnt.caption = Replace(tData(2),"-","")
			cont0.contTran.edtBank.caption = tData(4)
			g_szCom = tData(1)
	      'cont0_contTran_btnName_OnClick()
	      
		End If	
	ElseIf sKeyName == "이체기관" then
		If sRet <> "" then
			tData1 = Split(sRet, "★")
			cont0.contTran.edtBank.caption = tData1(1)
			g_szCom = tData1(0)
			'cont0_contTran_btnName_OnClick()
		End If 
	ElseIf sKeyName == "QUICK" then
		If sRet <> "" then
			tData2 = Split(sRet, "|")
			if Form.GetCtlProp("#accTran", "caption") <> tData2(1) then
				Form.SetCtlProp("#accTran", "caption", tData2(1)) 
			end if
			cont0.contTran.edtReceiver.caption = tData2(4)
			cont0.contTran.edtBank.caption = tData2(3)
			g_szCom = tData2(2)
			cont0.contAmt.edtAmt.caption = tData2(5)
			cont0.contTran.edtAcnt.caption = tData2(6)
			cont0.contTran.edtMytip.caption = tData2(7)
			cont0.contTran.edtRcvTip.caption = tData2(8)
'			Form.ShowAlert( "알림", "빠른이체로 등록 완료되었습니다.")
			'cont0_contTran_btnName_OnClick()
		End If	   

	ElseIf sKeyName == "61010_pa" then
	
	    g_szAccountPassword = ""
	
		If sRet <> "" then
'	      Form.showAlert( sKeyName, sRet)
			If sRet == "1" or sRet == "2" then
				Form.triggerEvent("#", "61010_COMP", "이체완료" &"★"& sRet &"★"& g_szData)
				cont0.contTran.chkProc.chksilence = "0"
				g_szChkType = 0
				cont0.contQuery.Grid0.SetClear()
		  'elseif sRet == "REG"
'				Form_Reset()
			Else 
				Form_Reset()
				g_nCntDelay = 0
				DATAMANAGER.RequestTranData( "obrtp_drab_001r" )
			End If
		End If 
		
	ElseIf sKeyName == "mbbnk61010_p0" then	''''공인인증 성공
		If sRet == "ok" then
			if g_nTrcnt == 0  or cont0.contQuery.Grid0.rowcount == 0 then
				QR_Tran() 
			elseif g_nTrcnt > 0  or cont0.contQuery.Grid0.rowcount > 0 then
				g_nTrRcvCnt = 0
				g_nCntDelay = 0
	            g_szMultiData = ""
			    g_szData = ""
	            g_nTrIndex = 0 '반복수
				QR_MultiTran()
			end if
		else
			Form_Reset()
			g_nCntDelay = 0
			DATAMANAGER.RequestTranData( "obrtp_drab_001r" )
		end if
	elseif sKeyName == "mbbnk61010_p9" then	'지정단말 등록시
		if sRet == "Yes" then
			If g_szFee == "" or g_szFee == null then'g_szFee
			g_szFee = "0"
			End If  
		    
			if g_szCom == "" or g_szCom == null then
				Form.ShowAlert( "알림", "입금 은행을 확인 하십시오" )
			end if
		    
			DATAMANAGER.RequestTranData( "obcsb_oimf_638r_1" )
			
			szPwd = g_szAccountPassword
			szAcc = g_szAccount
		end if	
	elseif sKeyName == "Error" then
		Form_Reset()
		g_nCntDelay = 0
		DATAMANAGER.RequestTranData( "obrtp_drab_001r" )
	'jhi T1811160033
     elseif sKeyName == "mbbnk61010_pe" then
         If sRet == "Y" then
             If CInt(g_nTrcnt) > 1 or CInt(cont0.contQuery.Grid0.rowcount) > 1 then' 다건이체
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "DRNG_ACNO"     , 0,  g_szAccountNumber      ) 
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "DRNG_ASNO"     , 0,  g_szAccountSerialNumber)
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "CNFT_BANK_CODE", 0,  cont0.contQuery.Grid0.GetCellData( "bd_cell17", g_szCnt )            )
                IF Trim(cont0.contQuery.Grid0.GetCellData( "bd_cell17", g_szCnt ) ) == "287" THEN
                   DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "MNRC_ACNO"  , 0,  Left (cont0.contQuery.Grid0.GetCellData( "bd_cell10", g_szCnt ), 8)  )
                   DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "MNRC_ASNO"  , 0,  Right(cont0.contQuery.Grid0.GetCellData( "bd_cell10", g_szCnt ), 2)  )
                else
                   DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "MNRC_ACNO"  , 0,  cont0.contQuery.Grid0.GetCellData( "bd_cell10", g_szCnt )            )
                   DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "MNRC_ASNO"  , 0,  ""                    )
                end if
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "RMT_NAME"      , 0,  cont0.contQuery.Grid0.GetCellData( "bd_cell11", g_szCnt ) )
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "CRCD"          , 0,  "KRW"                 )
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "CHECK_AMT"     , 0,  0                     )
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "FRCR_TR_AMT"   , 0,  cont0.contQuery.Grid0.GetCellData( "bd_cell12", g_szCnt ) )
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "PRTR_DTL_CNTT" , 0,  "MTS다건이체"         )
                DATAMANAGER.RequestTranData("obtss_comm_502a")
             Else
                ' 단건처리일경우
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "DRNG_ACNO"     , 0, Left(g_szAccount , 8)) 
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "DRNG_ASNO"     , 0, Right(g_szAccount, 2))
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "CNFT_BANK_CODE", 0, g_szCom              )
                IF Trim(g_szCom) == "287" THEN
                   DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "MNRC_ACNO"  , 0, Left(szData3     , 8))
                   DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "MNRC_ASNO"  , 0, Right(szData3    , 2))
		       else
                   DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "MNRC_ACNO"  , 0, szData3              )
                   DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "MNRC_ASNO"  , 0, ""                   )
                end if
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "RMT_NAME"      , 0, g_szEdtName          )
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "CRCD"          , 0, "KRW"                )
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "CHECK_AMT"     , 0, 0                    )
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "FRCR_TR_AMT"   , 0, szData4              )
                DATAMANAGER.SetDataValue( 0, "obtss_comm_502a", "InBlock1", "PRTR_DTL_CNTT" , 0, "MTS단건이체"        )
                DATAMANAGER.RequestTranData("obtss_comm_502a")
	     
	           '데이터클리어
		       Form_Reset()
                OneClear() 		
   		   
                Form.OpenPopup("mbbnk61010_pd" , ""  , "")
             End If
         Else
             if CInt(g_nTrcnt) > 1 or CInt(cont0.contQuery.Grid0.rowcount) > 1 then' 다건이체 
                sAmt        = gsz_sAmt
                sFee        = gsz_sFee 
		       szMultiData = gsz_szMultiData
                '16-04-04 g_nTrcnt => grdRowCount 로 변경
                Form.OpenFramePopup( "mbbnk61010_pb", cont0.contQuery.Grid0.rowcount &"♥"& sAmt  &"♥"&  sFee &"♥"& Left(szAcc,8) &"♥"& szPwd &"♥"&  g_szPlusUI &"★"& szMultiData ,"")	    
             elseif CInt(g_nTrcnt) == 1 or CInt(cont0.contQuery.Grid0.rowcount) == 1 then
                Form.OpenFramePopup( "mbbnk61010_p0", g_szOneData &"♥"& g_szFee  &"♥"&  g_szPlusUI  &"♥"& cont0.contQuery.Grid0.rowcount &"♥"& g_szEdtName &"♥"& szPwd &"♥"& g_szCom, "")
                'Form_Reset()
                OneClear() 
                DATAMANAGER.RequestTranData( "obrtp_drab_001r" )
             else 
                '단건 즉시이체시
                 Form.OpenFramePopup( "mbbnk61010_p0", g_szData &"♥"& g_szFee  &"♥"&  g_szPlusUI  &"♥"& cont0.contQuery.Grid0.rowcount &"♥"& g_szEdtName &"♥"& szPwd &"♥"& g_szCom, "")
		    end if
		End If  
	End If	    
End Sub

'============================================================================
Sub Form_OnFormInit()
USE_YN_CHK() '종료체크 v008
	g_szBrcd = ""
    if cont0.contTran.edtBank.caption = "메리츠증권" then
       g_szCom = "287"
    end if        
	g_nTrcnt      = 0
	g_nCntDelay   = 0
	g_nTrRcvCnt   = 0
	g_nAddflag    = 0
	
	g_szChkType   = 0
	g_szProType   = 0
	
	g_szMultiData = ""
	g_szData      = ""
	g_nTrIndex    = 0
	g_szTRError   = 0
	g_szTramt     = 0
	g_szTactamt   = 0
			
	g_nTrIndex2	= 0	'v003
	g_szSapeYN	= ""	'v003 
	
	'스크롤 방지
	cont0.contQuery.Grid0.scrollenable = 0
	
	g_szUserID = Form.GetSharedData("&USER_ID" , false)
	Form.SetSharedData( "CERT_ID" , g_szUserID )
	
	' login type get
	g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
	
	g_szEdtName = ""
	DATAMANAGER.RequestTranData("obcsb_oimf_638r")
	
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	
End Sub

'============================================================================
Sub cont0_contAmt_btnIqry_OnClick()
	szAcnt = Form.GetCtlProp("#accTran", "caption")
    If Len(szAcnt) < 10 Then
	    Form.ShowAlert(g_szTitle, "계좌번호를 확인하십시오.")
	    exit sub 
	End If
	
	DATAMANAGER.RequestTranData( "obrtp_drab_001r" )
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obrtp_drab_001r" then

		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "ACNO", 0, g_szAccountNumber )
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "ASNO", 0, g_szAccountSerialNumber )
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "SUMR_DRNG_YN", 0 ,  "2" )'''적요출금여부Form.GetSharedData("#BCP_BIZ_DT", False)
	Elseif szTranID == "obcsb_oimf_638r" then	'전자금융사기예방 고객조회'
		szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID	
		cont0.contQuery.Table0.Setclear()
       
		'16-03-08  Input값 수정 MAC주소 -> DeviceID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , szUserId)	'사용자ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID())	'UI단말식별키
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "100")'이체	'기본 '200'  등록 '400'
		if g_szEdtName <> "" then
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "200")'이체	'기본 '200'  등록 '400'
			if CInt(g_nTrcnt) > 1 or CInt(cont0.contQuery.Grid0.rowcount) > 1 then
				nCnt = cont0.contQuery.Grid0.rowcount
				for i=0 to CInt(nCnt)-1 
					szData = cont0.contQuery.Grid0.GetCellData( "bd_cell8", i )
					arrData = Split(szData, "♥")''출금계좌'입금은행'입금계좌번호'이체금액'내통장표시'받는분표시 'Fee 'g_szCom 'g_szBrcd
				
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "DRNG_ACNO"     , i, g_szAccountNumber )
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "DRNG_ASNO"     , i, g_szAccountSerialNumber )
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_BANK_CODE", i , arrData(7))
					if cont0.contQuery.Grid0.GetCellData( "bd_cell17", i) == "287" then'g_szCom = "287" then
                          DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "TACT_CLS_CODE" , i ,"01")'대체출금
                          DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ACNO"     , i, Left(arrData(2), 8))
                          DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ASNO"     , i, Right(arrData(2), 2))
                       else
                          DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "TACT_CLS_CODE" , i ,"03")'이체출금
                          DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ACNO"     , i arrData(2))
                          DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ASNO"     , i, "")
                       end if
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "TACT_AMT" , i, cont0.contAmt.edtAmt.caption)
				next 
			else 
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "DRNG_ACNO" , 0, g_szAccountNumber )
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "DRNG_ASNO", 0, g_szAccountSerialNumber )
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_BANK_CODE", 0 , g_szCom)
				if g_szCom == "287" then'g_szCom = "287" then
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "TACT_CLS_CODE", 0 ,"01")'대체출금
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ACNO", 0, Left(cont0.contTran.edtAcnt.caption, 8))
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ASNO", 0, Right(cont0.contTran.edtAcnt.caption, 2))
				else
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "TACT_CLS_CODE", 0 ,"03")'이체출금
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ACNO", 0, cont0.contTran.edtAcnt.caption)
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ASNO", 0, "")
				end if
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "TACT_AMT" , 0, cont0.contAmt.edtAmt.caption)
			end if   
		end if	
	Elseif szTranID == "obcsb_oimf_638r_1" then	'전자금융사기예방 고객조회'
		szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID	
       
		'16-03-08  Input값 수정 MAC주소 -> DeviceID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r_1", "InBlock1", "ELFN_ID" , 0 , szUserId)	'사용자ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r_1", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID())	'UI단말식별키
		'if g_szEdtName <> "" then
		
		IF g_szCertUserType = "1" THEN
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r_1", "InBlock1", "SVCD" , 0 , "201")	'201 SPIN 로그인 이체
		ELSEIF g_szCertUserType = "3" THEN
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r_1", "InBlock1", "SVCD" , 0 , "203")	'203 바이오 로그인 이체
		ELSE
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r_1", "InBlock1", "SVCD" , 0 , "200")'이체	'기본 '200'  등록 '400'
		END IF
		
		
		
		if CInt(g_nTrcnt) > 1 or CInt(cont0.contQuery.Grid0.rowcount) > 1 then
			nCnt = cont0.contQuery.Grid0.rowcount
			for i=0 to CInt(nCnt)-1 
				szData = cont0.contQuery.Grid0.GetCellData( "bd_cell8", i )
				arrData = Split(szData, "♥")''출금계좌'입금은행'입금계좌번호'이체금액'내통장표시'받는분표시 'Fee 'g_szCom 'g_szBrcd
			
				DATAMANAGER.SetDataValue(0,  "obcsb_oimf_638r_1", "InBlock2", "DRNG_ACNO" , i, g_szAccountNumber )
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "DRNG_ASNO", i, g_szAccountSerialNumber )
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_BANK_CODE", i , arrData(7))
				if cont0.contQuery.Grid0.GetCellData( "bd_cell17", i) == "287" then'g_szCom = "287" then
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "TACT_CLS_CODE", i ,"01")'대체출금
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ACNO", i, Left(arrData(2), 8))
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ASNO", i, Right(arrData(2), 2))
				else
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "TACT_CLS_CODE", i ,"03")'이체출금
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ACNO", i, arrData(2))
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ASNO", i, "")
				end if
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "TACT_AMT" , i, cont0.contQuery.Grid0.GetCellData( "bd_cell12", i) )
			next
		elseif CInt(g_nTrcnt) == 1 or CInt(cont0.contQuery.Grid0.rowcount) == 1 then
			nCnt = cont0.contQuery.Grid0.rowcount
			for i=0 to CInt(nCnt)-1 
				szData = cont0.contQuery.Grid0.GetCellData( "bd_cell8", i )
				arrData = Split(szData, "♥")''출금계좌'입금은행'입금계좌번호'이체금액'내통장표시'받는분표시 'Fee 'g_szCom 'g_szBrcd
			
				DATAMANAGER.SetDataValue(0,  "obcsb_oimf_638r_1", "InBlock2", "DRNG_ACNO" , i, g_szAccountNumber )
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "DRNG_ASNO", i, g_szAccountSerialNumber )
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_BANK_CODE", i , cont0.contQuery.Grid0.GetCellData( "bd_cell17", i))
				if cont0.contQuery.Grid0.GetCellData( "bd_cell17", i) == "287" then'g_szCom = "287" then
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "TACT_CLS_CODE", i ,"01")'대체출금
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ACNO", i, Left(arrData(2), 8))
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ASNO", i, Right(arrData(2), 2))
				else
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "TACT_CLS_CODE", i ,"03")'이체출금
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ACNO", i, arrData(2))
					DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ASNO", i, "")
				end if
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "TACT_AMT" , i, cont0.contQuery.Grid0.GetCellData( "bd_cell12", i) )
			next
		else 
			DATAMANAGER.SetDataValue(0,  "obcsb_oimf_638r_1", "InBlock2", "DRNG_ACNO" , 0, g_szAccountNumber )
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "DRNG_ASNO", 0, g_szAccountSerialNumber )
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_BANK_CODE", 0 , g_szCom)
			if g_szCom == "287" then'g_szCom = "287" then
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "TACT_CLS_CODE", 0 ,"01")'대체출금
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ACNO", 0, Left(cont0.contTran.edtAcnt.caption, 8))
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ASNO", 0, Right(cont0.contTran.edtAcnt.caption, 2))
			else
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "TACT_CLS_CODE", 0 ,"03")'이체출금
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ACNO", 0, cont0.contTran.edtAcnt.caption)
				DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "MNRC_ASNO", 0, "")
			end if
	    
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r_1", "InBlock2", "TACT_AMT" , 0, cont0.contAmt.edtAmt.caption)
		end if   
	    'end if	 	   
	'v003 sta : 당사 동일명의 계좌 여부 리턴 서비스
	ElseIf szTranID == "obrtp_comn_019r" Then	

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 		, 0, g_szAccountNumber						)		'계좌번호(From)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 		, 0, g_szAccountSerialNumber				)		'계좌일련번호(From)
		
		if CInt(g_nTrcnt) > 1 or CInt(cont0.contQuery.Grid0.rowcount) > 1 then' 다건이체 
			szData = cont0.contQuery.Grid0.GetCellData( "bd_cell8", g_nTrIndex2 )
			arrData = Split(szData, "♥")''출금계좌'입금은행'입금계좌번호'이체금액'내통장표시'받는분표시 'Fee 'g_szCom 'g_szBrcd
			'							g_szData = g_szData  &"♥"& g_szFee  &"♥"& g_szCom &"♥"& g_szBrcd
		Else
			arrData = Split(g_szData, "♥")''출금계좌'입금은행'입금계좌번호'이체금액'내통장표시'받는분표시
		End If
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFT_ACNO" 	, 0, Left(arrData(2),8)					)		'계좌번호(To)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFT_ASNO" 	, 0, Right(arrData(2),2)					)		'계좌일련번호(To)
	'v003 fin

	ElseIf szTranID == "obtss_elbs_121r" or szTranID == "obtss_elbs_121r_1" or szTranID == "obtss_elbs_131u" then
		Form.addWaitCursor()
		
	End If   
End Sub

'============================================================================
Sub cont0_contAmt_btnAll_OnClick()
	'START--------------------------------
	'v001
	'cont0.contAmt.edtAmt.caption = cont0.contAmt.edtAble.caption	
	if  CDbl(cont0.contAmt.edtAble.caption) > CDbl(cont0.contQuery.tblAdd.GetCellString( 0, 3)) then
	    cont0.contAmt.edtAmt.caption = CDbl(cont0.contAmt.edtAble.caption) - CDbl(cont0.contQuery.tblAdd.GetCellString( 0, 3))
	else	         
	    if CDbl(g_szFee) > 0 then
		    Form.ShowAlert( "알림", "출금가능금액이 부족합니다." + Chr(10) + "(타기관 이체출금의 경우 수수료 포함)" + Chr(10) + "이체예정내역을 확인하여 주시기 바랍니다.")
		else
			Form.ShowAlert( "알림", "출금가능금액이 부족합니다." + Chr(10) + "이체금액을 확인하여 주시기 바랍니다.")
		end if
	end if
	'----------------------------------END
	
End Sub

