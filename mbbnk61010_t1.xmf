Dim g_szPlusUI '추가인증필요여부
Dim g_szFee
Dim g_szBrcd
g_szTitle = "알림"
Dim g_nCntDelay
Dim g_szEdtName
Dim g_nTrIndex
Dim g_szAccountNumber	'계좌번호(8자리)
Dim g_szAccountSerialNumber	'계좌일련번호(2자리)
Dim g_szAccountPassword	'계좌비밀번호
Dim g_szAccount		'계좌번호+일련번호
Dim g_szAccountName
Dim g_szMultiData 
Dim g_nAddFlag
'-------------------------------------------------
Dim g_szChkType	'착오송금예방 Chk 여부		0:미체크 , 1:체크
Dim g_szProType	'이체추가, 즉시이체 여부
Dim g_szTRPass 	'단말지정 구분시 필요한 변수
Dim g_szTRError	'출금오류 회수
Dim g_szOneData	'1계좌 추가만 하고 이체 시행할때
Dim g_szUserID	'ID

Dim g_szCertUserType	'0:일반인증서 1 : 간편로그인 3:바이오 
Dim g_szTramt
Dim g_szTactamt
Dim g_szCnt           '문진프로세스 로그등록건수
Dim g_szTotCnt        '문진프로세스 이체추가 총건수
Dim gsz_sAmt
Dim gsz_sFee
Dim gsz_szMultiData

Dim g_tact_amt

Dim g_szDataTemp    'v001
Dim g_szOneDataTemp 'v001
Dim plain_rm 

Dim g_nTrIndex2		'v003 obrtp_comn_019r TR 인덱스
Dim g_szSapeYN		'v003 동일인 계좌여부
Dim g_rcvn_iqry_tmnu   '수취조회횟수 v006
Dim g_tact_rpcs_tmnu   '이체조회횟수 v006

Dim g_LNKD_BANK_CLS_CODE
Dim g_TR_DATE
Dim g_OTSD_TR_UNIQ_NO
Dim g_TACT_LNKD_ISTU_CODE
Dim g_TACT_STND_TR_CODE
