Sub cont0_contTran_btnName_OnClick()
'USE_YN_CHK() '종료체크 v008
'	temp = Check_Account() 
'    if temp =  False then
'	      exit sub
'    end if 
'	g_nAddflag = 0
'	temp2 = Load_Data()

     'v006
	if Trim(cont0.contTran.edtAcnt.caption) = "" then
		Form.ShowAlert(g_szTitle, "입금계좌번호를 입력하십시요.")
		Exit Sub
	end if
	   
	
	if g_szCom == "287" then	'메리츠당행조회
		if Len(cont0.contTran.edtAcnt.caption) <> 10 then
			Form.ShowAlert(g_szTitle, "당행 입금계좌번호를 잘못 입력하였습니다.")
			Exit Sub
		end if
		szData1 = Form.GetCtlProp("#accTran", "caption") 
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "ACNO"     , 0 , g_szAccountNumber)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "ASNO"     , 0 , g_szAccountSerialNumber)	'계좌일련번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "USE_YN"   , 0 , "N")	'사용여부
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ACNO", 0 , Mid(cont0.contTran.edtAcnt.caption, 1, 8))	'상대계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ASNO", 0 , Mid(cont0.contTran.edtAcnt.caption, 9, 2))	'상대일련번호
		DATAMANAGER.RequestTranData("obrtd_drng_025r")
	else
	
	     g_rcvn_iqry_tmnu = 0 '수취조회횟수 v006
		DATAMANAGER.SetDataValue(0, "obtss_elbs_121r", "InBlock1", "MNRC_BANK_CODE" , 0 , g_szCom)	'입금은해코드
		DATAMANAGER.SetDataValue(0, "obtss_elbs_121r", "InBlock1", "JOB_TRNO"       , 0 , "031")								'작업단말번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_121r", "InBlock1", "MNRC_ACNO"      , 0 , Trim(cont0.contTran.edtAcnt.caption))	'입금계좌번호
		if cont0.contAmt.edtAmt.caption == "" or cont0.contAmt.edtAmt.caption == Null then
              DATAMANAGER.SetDataValue(0, "obtss_elbs_121r", "InBlock1", "TR_AMT"     , 0 , "1")			'거래금액
		else
              DATAMANAGER.SetDataValue(0, "obtss_elbs_121r", "InBlock1", "TR_AMT" , 0 , cont0.contAmt.edtAmt.caption)			'거래금액
		end if
		DATAMANAGER.SetDataValue(0, "obtss_elbs_121r", "InBlock1", "DRNG_ACNO"          , 0 ,g_szAccountNumber)	     	'계좌번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_121r", "InBlock1", "ACNT_PROD_CLS_CODE" , 0 ,g_szAccountSerialNumber)		'계좌일련번호
		
		DATAMANAGER.SetDataValue(0, "obtss_elbs_121r", "InBlock1", "PWD"                , 0 , g_szAccountPassword)		'비밀번호
		DATAMANAGER.RequestTranData("obtss_elbs_121r")

	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	g_szMultiData = "" '초기화
	
	'v006 obtss_elbs_131u 유지 , obtss_elbs_231r 추가
	if szTranID == "obrtd_drng_004a" or szTranID == "obtss_elbs_131u" or szTranID == "obtss_elbs_231r" then
		if szTranID == "obtss_elbs_131u" or szTranID == "obtss_elbs_231r" then
		     Form.SetTimerEvent(9999, 1, 1) 'remove
	     end if
	
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		'16-04-05 오류 팝업 삭제
'		Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
'		Form_Reset()
'		DATAMANAGER.RequestTranData( "obrtp_drab_001r" )
		g_szTRError = g_szTRError + 1
		
		 if CInt(g_nTrcnt) > 0 and CInt(g_nTrcnt) == CInt(g_nTrRcvCnt) + CInt(g_szTRError) then
		    Form.SetSharedData("61010_DELAY" , g_nCntDelay & "/" & g_nTrcnt & "/" & g_szTRError)
		    if CInt(g_nTrRcvCnt) + CInt(g_szTRError) == 1  then
			    if szTranID == "obrtd_drng_004a" then   
					if DATAMANAGER.GetDataValue( 0,"obrtd_drng_004a", "OutBlock1", "DELY_TACT_YN", 0 ) == "Y" Then
						szMsg = "지연이체 접수되었습니다."
					elseif DATAMANAGER.GetDataMsgCode( "obrtd_drng_004a" ) == "5620" then
						szMsg = "정상처리되었습니다."
					else
						szMsg = DATAMANAGER.GetDataMsgText( "obrtd_drng_004a" )
						szMsg = szMsg.."("..DATAMANAGER.GetDataMsgSubText( "obrtd_drng_004a" )..")"

					end if
			    
				elseif szTranID == "obtss_elbs_131u" then
					szMsg = DATAMANAGER.GetDataMsgText( "obtss_elbs_131u" )
					szMsg = szMsg.."("..DATAMANAGER.GetDataMsgSubText( "obtss_elbs_131u" )..")"
				'v006 obtss_elbs_231r 추가
				elseif szTranID == "obtss_elbs_231r" then
					szMsg = DATAMANAGER.GetDataMsgText( "obtss_elbs_231r" )
					szMsg = szMsg.."("..DATAMANAGER.GetDataMsgSubText( "obtss_elbs_231r" )..")"
				end if 
				if CInt(cont0.contQuery.Grid0.rowcount) == 1 then
					Form.OpenPopup("mbbnk61010_pa", g_szOneData &"♥"& g_szEdtName &"♥"& g_szCom &"♥"& szMsg, "") '''단건이체완료창(8)
				else
					Form.OpenPopup("mbbnk61010_pa", g_szData &"♥"& g_szEdtName &"♥"& g_szCom &"♥"& szMsg, "") '''단건이체완료창(8)
				end if
		    else
				
		       nRow = g_nTrIndex   'to nCnt-1
			   szData = cont0.contQuery.Grid0.GetCellData( "bd_cell8",  nRow )
			   szReceiver =  cont0.contQuery.Grid0.GetCellData( "bd_cell11",  nRow )
			   if szTranID == "obrtd_drng_004a" then   
					szMsg = DATAMANAGER.GetDataMsgText( "obrtd_drng_004a" )
					szMsg = szMsg.."("..DATAMANAGER.GetDataMsgSubText( "obrtd_drng_004a" )..")"
			   elseif szTranID = "obtss_elbs_131u" then
					szMsg = DATAMANAGER.GetDataMsgText( "obtss_elbs_131u" )
					szMsg = szMsg.."("..DATAMANAGER.GetDataMsgSubText( "obtss_elbs_131u" )..")"
			   'v006 obtss_elbs_231r 추가
			   elseif szTranID = "obtss_elbs_231r" then
					szMsg = DATAMANAGER.GetDataMsgText( "obtss_elbs_231r" )
					szMsg = szMsg.."("..DATAMANAGER.GetDataMsgSubText( "obtss_elbs_231r" )..")"
			   end if 
			   g_szMultiData = g_szMultiData & szData &"♥"& szReceiver &"♥"& szMsg &"|" 
		           
		       Form.OpenPopup("mbbnk61010_pa", g_szMultiData , "") '''다건이체완료창 (11)
			   
		    end if
		    
		    g_nCntDelay = 0
		    g_nTrcnt    = 0
		    g_nTrRcvCnt = 0
		    g_szTRError = 0
		else 
		    'nCnt = cont0.contQuery.Grid0.rowcount
		           
             nRow       = g_nTrIndex   'to nCnt-1
		    szData     = cont0.contQuery.Grid0.GetCellData( "bd_cell8",  nRow )
		    szReceiver =  cont0.contQuery.Grid0.GetCellData( "bd_cell11",  nRow )
             if szTranID == "obrtd_drng_004a" then   
                szMsg = DATAMANAGER.GetDataMsgText( "obrtd_drng_004a" )
                szMsg = szMsg.."("..DATAMANAGER.GetDataMsgSubText( "obrtd_drng_004a" )..")" 
             elseif szTranID == "obtss_elbs_131u" then
                szMsg = DATAMANAGER.GetDataMsgText( "obtss_elbs_131u" )
                szMsg = szMsg.."("..DATAMANAGER.GetDataMsgSubText( "obtss_elbs_131u" )..")"
		   'v006 obtss_elbs_231r 추가
             elseif szTranID == "obtss_elbs_231r" then
                szMsg = DATAMANAGER.GetDataMsgText( "obtss_elbs_231r" )
                szMsg = szMsg.."("..DATAMANAGER.GetDataMsgSubText( "obtss_elbs_231r" )..")"
             end if 
             g_szMultiData = g_szMultiData & szData &"♥"& szReceiver &"♥"& szMsg &"|"
'				   Form.ShowAlert( g_nTrIndex, g_szMultiData)
             g_nTrIndex = g_nTrIndex + 1
             Call QR_MultiTran()
		end if    
		
		
'		If CInt(g_nTrcnt) > 1 then
'		   g_nTrRcvCnt = g_nTrRcvCnt + 1
'		   g_nTrIndex = g_nTrIndex + 1
'		   call QR_MultiTran()
'		End  If  
	elseif szTranID == "obcsb_oimf_638r" then
	    Form.ShowAlert( "알림", "전자금융사기예방 고객정보조회가 실패했습니다." )
	elseif szTranID == "obcsb_oimf_638r_1" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		if szErrCode = "9150" then
			Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
		end if
	    'Form.ShowAlert( "알림", "전자금융사기예방 고객정보조회가 실패했습니다." )
	elseif szTranID == "obrtp_comn_025r" then
		if szErrCode == "5841" then 'v008

		    osType = Form.GetSharedData("&OS_TYPE", false)
             appVer = Form.GetSharedData("&APP_VERSION", false )
             appVer = replace(appVer,".","")
	     
		    if osType == "1" then
		        if Cint(appVer) < 226 then
			        Form.OpenPopup( "mbbnk61010_pz" , "" , "")
                      return
                 ElseIf Cint(appVer) == 226 Then
                     Form.ShowAlert( "알림", "이체 업무가 새롭게 변경되었습니다.".."\n\n".."고객님의 안전한 서비스를 위해 앱을 재실행해주세요." )
                     return
		        end if
			    
		    elseif osType == "2" then
		        if Cint(appVer) < 2521 then
			        Form.OpenPopup( "mbbnk61010_pz" , "" , "")
                      return
                 ElseIf Cint(appVer) == 2521 Then
                     Form.ShowAlert( "알림", "이체 업무가 새롭게 변경되었습니다.".."\n\n".."고객님의 안전한 서비스를 위해 앱을 재실행해주세요." )
                     return
		        end if
		    end if

		else
			szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
			Form.ShowAlert( "알림", szErrMsg.."\n".."("..szSubErr..")" )
		end if
	 
	elseif szTranID == "obrtd_drng_025r" or szTranID == "obrtd_drng_025r_1" then
         szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
         Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
         cont0.contTran.edtReceiver.caption = ""
'	    If  g_nTrcnt > 0  then
'	      g_nTrcnt = g_nTrcnt -1
'	    End If	 
	'v006 obtss_elbs_221r , obtss_elbs_221r_1 추가
			
	elseif szTranID == "obtss_elbs_121r" or szTranID == "obtss_elbs_121r_1" or szTranID == "obtss_elbs_221r" or szTranID == "obtss_elbs_221r_1" then
		Form.SetTimerEvent(9999, 1, 1) 'remove
			
         szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
         Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
         cont0.contTran.edtReceiver.caption = ""
	end if
	
'Form.Toast( 0, szErrCode & szErrMsg, bLongTime )
End Sub




'============================================================================
Sub cont0_contTran_btnRecent_OnClick()
	Form.SetSharedData("61010_p5", 0 )
	Form.OpenPopup("mbbnk61010_p5" , g_szAccount, "")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "Password" then
		g_szAccountPassword = sParam
		cont0_contAmt_btnIqry_OnClick()
	elseif sEventName == "AllAccount" then
		g_szEdtName = ""
		DATAMANAGER.ClearInputData( 0, "obcsb_oimf_638r")
		Dim szList
		szList = Split(sParam, "★")

		if UBOUND(szList) < 1 then
			exit sub
		end if
		g_szAccount             = szList(0) & szList(1)
		g_szAccountNumber       = szList(0)
		g_szAccountSerialNumber = szList(1)
		if szList(2) == "" then
			g_szAccountPassword = ""
		else
			g_szAccountPassword = szList(2)
		end if
		'Form.ShowAlert("빠른이체", g_szAccount)
		g_szAccountName = szList(3)
        Form_Reset()
		g_nCntDelay = 0
	    cont0_contAmt_btnIqry_OnClick() 
	    DATAMANAGER.RequestTranData("obcsb_oimf_638r")
	end if	
	   
End Sub

'============================================================================
Sub cont0_contTran_btnAppoint_OnClick()
	Form.SetSharedData("61010_p5", 1 )
	Form.OpenPopup("mbbnk61010_p5" , g_szAccount, "")
End Sub

'============================================================================
Sub cont0_contQuery_Grid0_OnClickUp(lRow, szCellID)
	if szCellID == "bd_cell16" then
	     '20180719 jhi 취소시 금액 차감.
	     if cont0.contQuery.Grid0.GetCellData( "bd_cell17",  lRow ) ~= "287" then		  
		    g_szTramt = CDbl(g_szTramt) - CDbl(cont0.contQuery.Grid0.GetCellData( "bd_cell12",  lRow ))
		    'Form.ShowAlert("알림1", g_szTramt)  'jhi
		 end if
		 
		cont0.contQuery.Grid0.SetDeleteRow(lRow)
		
		if CInt(cont0.contQuery.Grid0.rowcount) > 0 then 
		     'Form.ShowAlert("알림", "11111")  'jhi
			g_nTrcnt = CInt(cont0.contQuery.Grid0.rowcount)
			'Form.ShowAlert("row", cont0.contQuery.Grid0.rowcount)
			Dim sAmt 
			Dim sFee 
			nCnt = cont0.contQuery.Grid0.rowcount
			for i = 0  to CInt(nCnt)-1
				szData = cont0.contQuery.Grid0.GetCellData( "bd_cell12", i)
'				cont0.contQuery.Grid0.SetCellData( "bd_cell0", i, "이체예정내역"& CInt(nCnt)+1)			 

			     'START--------------------------------
				'v001
                   'sAmt = CDbl(sAmt) + CDbl(szData)
		   
		          szDataFee = cont0.contQuery.Grid0.GetCellData( "bd_cell13", i)
		          sAmt = CDbl(sAmt) + CDbl(szData) + CDbl(szDataFee)
				'----------------------------------END
				
			next		
			cont0.contQuery.tblAdd.SetCellString( 0, 1, g_nTrcnt )
			cont0.contQuery.tblAdd.SetCellString( 0, 3, sAmt)'
			cont0.contQuery.Table0.top = 230*CInt(nCnt) + 100
			cont0.contQuery.Grid0.height = cont0.contQuery.Grid0.height - 230
			cont0.contQuery.height = 180 + cont0.contQuery.Grid0.height
	        'cont0.contQuery.height = CInt(cont0.contQuery.height) + 98

         elseif CInt(cont0.contQuery.Grid0.rowcount) == 0 then
		    'Form.ShowAlert("알림", "2222222")  'jhi
			g_nTrcnt = 0
			cont0.contQuery.tblAdd.SetCellString( 0, 1, "" )
			cont0.contQuery.tblAdd.SetCellString( 0, 3, "" )'
			cont0.contQuery.btnProc.caption = "즉시이체"
			cont0.contQuery.Grid0.height = 8
			cont0.contQuery.Table0.top   = 100
			cont0.scroll_pos             = 0
			cont0.contQuery.height       = 180
			cont0.height                 = 476
			
		     '20180719 jhi 취소시 금액 차감.
		     if cont0.contQuery.Grid0.GetCellData( "bd_cell17",  i ) ~= "287" then		  
		        g_szTramt = CDbl(g_szTramt) - CDbl(szData4)
		     end if
 		 
		     'Form.ShowAlert("알림", g_szTramt)  'jhi
		end if	
		
		
		'cont0.contQuery.height = cont0.contQuery.Grid0.height + 230
		
		cont0.contQuery.SetScrollAutoSize()
		cont0.SetScrollAutoSize()

	end if
End Sub

