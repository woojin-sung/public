'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obrtd_drng_025r" then
		szName = DATAMANAGER.GetDataValue (0, "obrtd_drng_025r", "OutBlock1", "RMT_NAME", 0 )
       'Form.ShowAlert(g_szTitle, szName&":"& cont0.contTran.edtReceiver.caption )
'	  If con t0.contTran.chkProc.checkstate == "1" and Trim(szName) <> cont0.contTran.edtReceiver.caption then 
	      'Form.ShowAlert(szName, cont0.contTran.edtReceiver.caption)
	      
'	         Form.ShowAlert(g_szTitle, "입력하신 예금주명과 수취인명이 상이합니다. 다시 입력하시거나, 예금주명 입력기능 사용하기를 해제 후 다시 이체바랍니다.")
'	         cont0.contTran.edtReceiver.caption = ""
'		     Exit Sub   
'	      
'	      
'	   Else 
		cont0.contTran.edtReceiver.caption = szName
		g_szEdtName = szName	      
		g_szFee = "0"
		if CInt(g_nAddFlag) == 1 then
			Open_Linkform(szName)
		end if   
'	   End If
     elseif szTranID == "obrtp_drab_001r" then	'2018.06.26 출금가능조회 완료후 이체누적금액조회
        DATAMANAGER.SetDataValue( 0, "obrtp_comn_017r", "InBlock1", "ACNO", 0, g_szAccountNumber )
        DATAMANAGER.SetDataValue( 0, "obrtp_comn_017r", "InBlock1", "RCPY_DATE", 0, Form.GetSharedData("&BIZ_DT" , false) )
	    DATAMANAGER.SetDataValue( 0, "obrtp_comn_017r", "InBlock1", "ODER_CHAN_TYPE_CLS_CODE", 0, "020" )
        DATAMANAGER.RequestTranData( "obrtp_comn_017r" )
	
     elseif szTranID == "obrtp_comn_017r" then
        Edit0.caption = CDbl( DATAMANAGER.GetDataValue (0, "obrtp_comn_017r", "OutBlock1", "TR_AMT", 0 )) 
	
	   DATAMANAGER.SetDataValue( 0, "obrtp_comn_018r", "InBlock1", "ACNO", 0, g_szAccountNumber )
        DATAMANAGER.SetDataValue( 0, "obrtp_comn_018r", "InBlock1", "TACT_CLS_CODE", 0, "03" )
	   DATAMANAGER.SetDataValue( 0, "obrtp_comn_018r", "InBlock1", "ODER_CHAN_TYPE_CLS_CODE", 0, "020" )
        DATAMANAGER.RequestTranData( "obrtp_comn_018r" )
     elseif szTranID == "obrtp_comn_018r" then
        Edit1.caption = CDbl( DATAMANAGER.GetDataValue (0, "obrtp_comn_018r", "OutBlock1", "D1_TACT_LIMT_AMT", 0 )) 
        Edit2.caption = CDbl( DATAMANAGER.GetDataValue (0, "obrtp_comn_018r", "OutBlock1", "T1_TACT_LIMT_AMT", 0 )) 
	elseif szTranID == "obrtd_drng_025r_1" then	'이체추가, 이체전 chk, Compelete 일때만 다음 실행
		
'		szName = DATAMANAGER.GetDataValue (0, "obrtd_drng_025r_1", "OutBlock1", "RMT_NAME", 0 )
'		cont0.contTran.edtReceiver.caption = szName
'		g_szEdtName = szName	      
'		g_szFee = "0"
'		
'		if CInt(g_nAddFlag) == 1 then
'			Open_Linkform(szName)
'		end if  
		
		
		
		if g_szProType == 1 then ' jhi : 이체추가 클릭시
			g_nTrcnt = g_nTrcnt +1
			cont0.contQuery.btnProc.caption = "이체실행"
		elseif g_szProType == 2 then ' jhi : 처리버튼 클릭시
			g_nAddflag = 0

		    if g_szTRPass == "Y" then  'TR후 호출가----if g_szDsgtUI = "Y"??
			   Form.OpenPopup("mbbnk61010_p9" , "" , "") '단말기지정필요--------
			   Exit Sub
			end if   
	
			If g_szFee == "" or g_szFee == null then'g_szFee
				g_szFee = "0"
			End If  
		    
			if g_szCom == "" or g_szCom == null then
				Form.ShowAlert( "알림", "입금 은행을 확인 하십시오" )
			end if
		    
			DATAMANAGER.RequestTranData( "obcsb_oimf_638r_1" )
			
			szPwd = g_szAccountPassword
			szAcc = g_szAccount
		end if
			
		szName = DATAMANAGER.GetDataValue (0, "obrtd_drng_025r_1", "OutBlock1", "RMT_NAME", 0 )
		cont0.contTran.edtReceiver.caption = szName
		g_szEdtName = szName	      
		g_szFee     = "0"
		
		if CInt(g_nAddFlag) == 1 then
			Open_Linkform(szName)
		end if   
 'v006 sta ==================================================
    elseif szTranID = "obtss_elbs_131u" then
    
		g_LNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0, "obtss_elbs_131u", "OutBlock2", "LNKD_BANK_CLS_CODE" , 0 )
         g_TR_DATE             = DATAMANAGER.GetDataValue(0, "obtss_elbs_131u", "OutBlock2", "TR_DATE"            , 0 )
		g_OTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0, "obtss_elbs_131u", "OutBlock2", "OTSD_TR_UNIQ_NO"    , 0 )
		g_TACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0, "obtss_elbs_131u", "OutBlock2", "TACT_LNKD_ISTU_CODE", 0 )
		g_TACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0, "obtss_elbs_131u", "OutBlock2", "TACT_STND_TR_CODE"  , 0 )
		g_LNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0, "obtss_elbs_131u", "OutBlock2", "LNKD_TLMS_MNNO"     , 0 )
		
		g_TRAN_ID = szTranID
		Form.SetTimerEvent2(2,1,0.5) '처음은 0.5초 후 조회
		
		exit sub
		
 'v006 end ==================================================
	'v006 obtss_elbs_131u ->  obtss_elbs_231r
	elseif szTranID =="obrtd_drng_004a" or szTranID == "obtss_elbs_231r" then
	
	
		if szTranID == "obtss_elbs_231r" and DATAMANAGER.GetDataMsgCode( szTranID ) == "6617" then  '처리 대기중입니다.
			g_LNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0, "obtss_elbs_131u", "OutBlock2", "LNKD_BANK_CLS_CODE" , 0 )
			g_TR_DATE             = DATAMANAGER.GetDataValue(0, "obtss_elbs_131u", "OutBlock2", "TR_DATE"            , 0 )
			g_OTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0, "obtss_elbs_131u", "OutBlock2", "OTSD_TR_UNIQ_NO"    , 0 )
			g_TACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0, "obtss_elbs_131u", "OutBlock2", "TACT_LNKD_ISTU_CODE", 0 )
			g_TACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0, "obtss_elbs_131u", "OutBlock2", "TACT_STND_TR_CODE"  , 0 )
			g_LNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0, "obtss_elbs_131u", "OutBlock2", "LNKD_TLMS_MNNO"     , 0 )
								    
			g_tact_rpcs_tmnu = g_tact_rpcs_tmnu + 1 '이체조회횟수 증가
			
			if g_tact_rpcs_tmnu < 5 then '5초 MAX
				SLEEP_SEC = g_tact_rpcs_tmnu
			else
				SLEEP_SEC = 5
			end if
		    
			g_TRAN_ID = szTranID
			Form.SetTimerEvent2(2,1,SLEEP_SEC)
			
			exit sub
		
		else
			
		
			if szTranID =="obrtd_drng_004a" then'g_szCom == "287" then
				if DATAMANAGER.GetDataValue( 0,"obrtd_drng_004a", "OutBlock1", "DELY_TACT_YN", 0 ) == "Y" Then
					g_nCntDelay = g_nCntDelay +1
				end if 
			else
				Form.SetTimerEvent(9999, 1, 1) 'remove
			
				If DATAMANAGER.GetDataValue( 0,"obtss_elbs_231r", "OutBlock1", "DELY_TACT_YN", 0 ) == "Y" Then
					g_nCntDelay = g_nCntDelay +1
				end if
			end if
			
		    g_nTrRcvCnt = g_nTrRcvCnt + 1
	'	    Form.ShowAlert( g_nCntDelay, g_nTrRcvCnt&":"&g_nTrcnt)''''프로세스 chk
			
		    if CInt(g_nTrcnt) > 0 and CInt(g_nTrcnt) == CInt(g_nTrRcvCnt) + CInt(g_szTRError) then
			    Form.SetSharedData("61010_DELAY" , g_nCntDelay & "/" & g_nTrcnt & "/" & g_szTRError)
			    
			    if CInt(g_nTrcnt) == 1 and CInt(g_nTrRcvCnt) == 1 then
					if szTranID == "obrtd_drng_004a" then   
						if DATAMANAGER.GetDataValue( 0,"obrtd_drng_004a", "OutBlock1", "DELY_TACT_YN", 0 ) == "Y" Then
							szMsg = "지연이체 접수되었습니다."
						elseif DATAMANAGER.GetDataMsgCode( "obrtd_drng_004a" ) == "5620" then
							szMsg = "정상처리되었습니다."
						else
							szMsg = DATAMANAGER.GetDataMsgSubText( "obrtd_drng_004a" )
						end if
					elseif szTranID == "obtss_elbs_231r" then 'v006 obtss_elbs_131u ->  obtss_elbs_231r
						szMsg = DATAMANAGER.GetDataValue( 0, "obtss_elbs_231r", "OutBlock1", "RSPN_MSG_CNTT", 0 )
