'============================================================================
' DATAMANAGER_OnRequestTranTimeout(szTranID) : Time 오류 발생시
'============================================================================
Sub DATAMANAGER_OnRequestTranTimeout(szTranID)
	'v006 obtss_elbs_131u ->  obtss_elbs_231r
	if szTranID =="obrtd_drng_004a" or szTranID == "obtss_elbs_231r" then
		Form.ShowAlert("알림", "이체결과를 확인해주시기 바랍니다.")
		
		Form_Reset()
		
		DATAMANAGER.RequestTranData( "obrtp_drab_001r" )
	end if
	
End Sub


'============================================================================
' Form_OnTimerEvent
'============================================================================
Sub Form_OnTimerEvent(sTimerID)

     '수취조회
	if trim(sTimerID) == "1" then
		Form.SetTimerEvent2(1,0,0)
		
		szTranID = ""
		
		if g_TRAN_ID == "obtss_elbs_121r" then
			szTranID = "obtss_elbs_221r"
			
		elseif g_TRAN_ID == "obtss_elbs_121r_1" then
			szTranID = "obtss_elbs_221r_1"
		else
		    szTranID = g_TRAN_ID
			
		end if
		
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "LNKD_BANK_CLS_CODE" , 0, g_LNKD_BANK_CLS_CODE  )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TR_DATE"            , 0, g_TR_DATE             )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "OTSD_TR_UNIQ_NO"    , 0, g_OTSD_TR_UNIQ_NO     )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TACT_LNKD_ISTU_CODE", 0, g_TACT_LNKD_ISTU_CODE )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TACT_STND_TR_CODE"  , 0, g_TACT_STND_TR_CODE   )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "LNKD_TLMS_MNNO"     , 0, g_LNKD_TLMS_MNNO      )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "RPCS_TMNU"          , 0, g_rcvn_iqry_tmnu      )
		
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "DRNG_ACNO"          , 0, g_szAccountNumber      ) '계좌번호
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "ACNT_PROD_CLS_CODE" , 0, g_szAccountSerialNumber) '계좌일련번호
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "PWD"                , 0, g_szAccountPassword    ) '비밀번호
		
		DATAMANAGER.RequestTranData(szTranID)

	elseif trim(sTimerID) == "2" then '이체
		Form.SetTimerEvent2(2,0,0)
		
		szTranID = ""
				
		if g_TRAN_ID == "obtss_elbs_131u" or g_TRAN_ID == "obtss_elbs_231r" then
			szTranID = "obtss_elbs_231r"
		end if
		
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "LNKD_BANK_CLS_CODE" , 0, g_LNKD_BANK_CLS_CODE  )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TR_DATE"            , 0, g_TR_DATE             )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "OTSD_TR_UNIQ_NO"    , 0, g_OTSD_TR_UNIQ_NO     )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TACT_LNKD_ISTU_CODE", 0, g_TACT_LNKD_ISTU_CODE )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TACT_STND_TR_CODE"  , 0, g_TACT_STND_TR_CODE   )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "LNKD_TLMS_MNNO"     , 0, g_LNKD_TLMS_MNNO      )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "RPCS_TMNU"          , 0, g_tact_rpcs_tmnu      )
		
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "DRNG_ACNO"          , 0, g_szAccountNumber      ) '계좌번호
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "ACNT_PROD_CLS_CODE" , 0, g_szAccountSerialNumber) '계좌일련번호
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "PWD"                , 0, g_szAccountPassword    ) '비밀번호
		
		DATAMANAGER.RequestTranData(szTranID)

	elseif trim(sTimerID) == "9999" then 'remove
	     
		Form.removeWaitCursor()
		Form.SetTimerEvent(9999,0,1)
	end if
End Sub

