          end if
	      DATAMANAGER.SetDataValue( 0, "obrtd_drng_025r", "InBlock1", "PWD", 0, szData )
	      DATAMANAGER.SetDataValue( 0, "obrtd_drng_025r", "InBlock1", "ACNO", 0 , Left(g_szAccount, 8))
          DATAMANAGER.SetDataValue( 0, "obrtd_drng_025r", "InBlock1", "ASNO", 0 , Right(g_szAccount, 2) )
          DATAMANAGER.SetDataValue( 0, "obrtd_drng_025r", "InBlock1", "CNFT_ACNO", 0 , Left(szData3, 8))
          DATAMANAGER.SetDataValue( 0, "obrtd_drng_025r", "InBlock1", "CNFT_ASNO", 0 , Right(szData3, 2) )
	      DATAMANAGER.SetDataValue( 0, "obrtd_drng_025r", "InBlock1", "USE_YN", 0 , "Y")
	      DATAMANAGER.RequestTranData( "obrtd_drng_025r" )
''	      return True
	   else
	      g_rcvn_iqry_tmnu = 0 '수취조회횟수 v006
	      DATAMANAGER.SetDataValue( 0, "obtss_elbs_121r", "InBlock1", "ACNT_PROD_CLS_CODE", 0 ,Right(g_szAccount, 2))'상품코드 ->계좌일련
	      DATAMANAGER.SetDataValue( 0, "obtss_elbs_121r", "InBlock1", "PWD", 0, szData )
	      DATAMANAGER.SetDataValue( 0, "obtss_elbs_121r", "InBlock1", "DRNG_ACNO" ,0 , Left(g_szAccount, 8) )
	      DATAMANAGER.SetDataValue( 0, "obtss_elbs_121r", "InBlock1", "MNRC_BANK_CODE", 0, g_szCom)
	      DATAMANAGER.SetDataValue( 0, "obtss_elbs_121r", "InBlock1", "JOB_TRNO", 0, "031" ) '작업단말번호
	      DATAMANAGER.SetDataValue( 0, "obtss_elbs_121r", "InBlock1", "MNRC_ACNO", 0 , szData3)
	      DATAMANAGER.SetDataValue( 0, "obtss_elbs_121r", "InBlock1", "TR_AMT", 0 , szData4)
	      DATAMANAGER.RequestTranData( "obtss_elbs_121r" )
'	      
	   end if
	   return True
end Function	   
'============================================================================
' Check_Edit
'============================================================================		
Function Check_Edit()
							'비밀번호
'	strEdt1 = Edit1.Caption( )								'내통장표시
	g_szEdtPrice = cont0.contAmt.edtAmt.caption						'이체금액
	strEdt4 = cont0.contTran.edtBank.caption								'입금은행
'	strCom  = Combo2.GetCellString( Combo2.GetCurSel( ), 0 )'입금은행코드	
'	nCnt =GridPro1.GetTotalRowCount( )                     '이체건수!
	
	if Trim(g_szEdtPrice) == "" or Trim(g_szEdtPrice) == "0" then
		Form.ShowAlert(g_szTitle, "이체금액을 입력하십시요.")
		return false
	end if
	
	if cont0.contTran.chkProc.checkstate = True then
	   if Trim(cont0.contTran.edtReceiver.caption) == "" then
		  Form.ShowAlert(g_szTitle, "'착오송금예방'기능을 사용하려면 반드시 수취인 입력과정을 거쳐야 합니다")
		  return false
	   end if
	end if	
	
	return True
End Function	   
'============================================================================
' Open_Linkform----
'============================================================================
Function Open_Linkform(szName)
	Dim szAddData
	
	If g_szFee == "" or g_szFee == null then'g_szFee
	   g_szFee = "0"
	End If
	szAddData = "♥" & szName			' 받는분
	szAddData = szAddData & "♥" & g_szFee									'''' 수수료
	szAddData = szAddData & "♥" & g_nTrcnt'일련번호''''									
	
'	cont0.contQuery.tblAdd.SetCellString( 0, 1, g_nTrcnt )
	
    'START--------------------------------
    'v001 이체금액 재조립
    szTempList = Split(g_szData, "♥")
	    
	if UBOUND(szTempList) < 1 THEN
		EXIT Function
	END IF
	
	szTempSum = CDbl(cont0.contQuery.tblAdd.GetCellString( 0, 3)) + CDbl(szTempList(3))
		    
    if szTempSum == CDbl(cont0.contAmt.edtAble.caption) and CDbl(g_szFee) > 0 then

         if CDbl(szTempList(3)) - CDbl(g_szFee) <= 0 then
	         Form.ShowAlert( "알림", "출금가능금액이 부족합니다." + Chr(10) + "(타기관 이체출금의 경우 수수료 포함)" + Chr(10) + "이체예정내역을 확인하여 주시기 바랍니다.")
		    g_nTrcnt = g_nTrcnt - 1
	         EXIT Function
	     end if

		g_szDataTemp = ""
		g_szDataTemp = szTempList(0) &"♥"& szTempList(1) &"♥"& szTempList(2)
		g_szDataTemp = g_szDataTemp &"♥"& CDbl(szTempList(3)) - CDbl(g_szFee)
		g_szDataTemp = g_szDataTemp &"♥"& szTempList(4) &"♥"& szTempList(5)
		g_szData = ""
		g_szData = g_szDataTemp
		
		
		szOneTempList = Split(g_szOneData, "♥")
	    
		if UBOUND(szOneTempList) < 1 THEN
			EXIT Function
		END IF
		
		g_szOneDataTemp = ""
		g_szOneDataTemp = szOneTempList(0) &"♥"& szOneTempList(1) &"♥"& szOneTempList(2)
		g_szOneDataTemp = g_szOneDataTemp &"♥"& CDbl(szOneTempList(3)) - CDbl(g_szFee)
		g_szOneDataTemp = g_szOneDataTemp &"♥"& szOneTempList(4) &"♥"& szOneTempList(5)
		g_szOneData = ""
		g_szOneData = g_szOneDataTemp
		
		Form.ShowAlert("알림", "수수료 징수 대상입니다." + Chr(10) +  "수수료를 제외한 금액을 이체합니다.")		
	end if
    '----------------------------------END
	
	'♥출금계좌'입금은행'입금계좌번호'이체금액'내통장표시'받는분표시♥
	 '  g_szData = szData1 &"♥"& szData2 &"♥"& szData3 &"♥"&szData4&"♥"&szData5&"♥"&szData6
	g_szData = g_szData  &"♥"&  g_szFee  &"♥"& g_szCom &"♥"& g_szBrcd
    
	szList = Split(g_szData, "♥")
	if UBOUND(szList) < 1 THEN
		EXIT Function
	END IF	

	sTotal = CDbl(cont0.contQuery.tblAdd.GetCellString( 0, 3)) + CDbl(szList(3)) + g_szFee
	cont0.contQuery.tblAdd.SetCellString( 0, 3, sTotal )'

	nCnt = cont0.contQuery.Grid0.rowcount
	
'	cont0.contQuery.Grid0.AddRow( )
	cont0.contQuery.Grid0.insertrow = 0
	cont0.contQuery.Grid0.SetCellData( "bd_cell8", 0, g_szData )
	
	cont0.contQuery.Grid0.SetCellData( "bd_cell0", 0, "이체예정내역" )'& CInt(nCnt)+1)
	cont0.contQuery.Grid0.SetCellData( "bd_cell16", 0, "이체취소")
	
	cont0.contQuery.Grid0.SetCellData( "bd_cell1", 0, "입금은행")
	cont0.contQuery.Grid0.SetCellData( "bd_cell9", 0, szList(1))
	
	cont0.contQuery.Grid0.SetCellData( "bd_cell2", 0, "입금계좌")
	cont0.contQuery.Grid0.SetCellData( "bd_cell10", 0, szList(2))
	
	cont0.contQuery.Grid0.SetCellData( "bd_cell3", 0, "받는분")	
	cont0.contQuery.Grid0.SetCellData( "bd_cell11", 0, szName)
	
	cont0.contQuery.Grid0.SetCellData( "bd_cell4", 0, "이체금액")	
	cont0.contQuery.Grid0.SetCellData( "bd_cell12", 0, szList(3))
	
	cont0.contQuery.Grid0.SetCellData( "bd_cell5", 0, "수수료")	
	cont0.contQuery.Grid0.SetCellData( "bd_cell13", 0, g_szFee)
	
	cont0.contQuery.Grid0.SetCellData( "bd_cell6", 0, "내통장 표시")	
	cont0.contQuery.Grid0.SetCellData( "bd_cell14", 0, szList(4))
	
	cont0.contQuery.Grid0.SetCellData( "bd_cell7", 0, "받는분 표시")	
	cont0.contQuery.Grid0.SetCellData( "bd_cell15", 0, szList(5))
	
	cont0.contQuery.Grid0.SetCellData( "bd_cell17", 0, g_szCom )
	
	cont0.contQuery.tblAdd.SetCellString( 0, 1, cont0.contQuery.Grid0.rowcount )
	
	
	cont0.contQuery.Grid0.height = 230 * CInt(cont0.contQuery.Grid0.rowcount )
	cont0.contQuery.height = 180 + cont0.contQuery.Grid0.height
	'cont0.contQuery.height = cont0.contQuery.Grid0.height - 89*nCnt
	'cont0.contQuery.height = CInt(cont0.contQuery.height) + (29 * 8 )
	cont0.contQuery.Table0.top = 100 + 230*(CInt(nCnt)+1) '- 89*nCnt
	cont0.contQuery.SetScrollAutoSize()
	cont0.SetScrollAutoSize()
	g_nAddflag = 0
	cont0.contTran.chkProc.chksilence = "0"
	g_szChkType = 0
	Edit_Reset()
End Function
'============================================================================
' Cal_Btn(nAdd)
'============================================================================
Function Cal_Btn(nAdd)	
   Dim nAmt
   if Trim(cont0.contAmt.edtAmt.caption) == "" then
      nAmt = 0
   else 
      nAmt = CDbl(cont0.contAmt.edtAmt.caption)
   end if
   cont0.contAmt.edtAmt.caption = nAmt + nAdd
   cont0_contAmt_edtAmt_OnEditComplete()
End Function   
'============================================================================
' QR_Tran()'''
'============================================================================		
Function QR_Tran()
	DATAMANAGER.ClearOutputData( 0 , "obrtd_drng_004a" )
	DATAMANAGER.ClearOutputData( 0 , "obtss_elbs_131u" )
	g_nTrRcvCnt = 0
	g_nCntDelay = 0
	g_nTrCnt = 0
      szPwd = g_szAccountPassword'비번      
'      g_ACNO = Form.GetCtlProp("#accTran", "total")
'      g_ASNO = Form.GetCtlProp("#accTran", "sequence")
'      Form.ShowAlert("빠른이체", g_szData)
      arrData = Split(g_szData, "♥")''출금계좌'입금은행'입금계좌번호'이체금액'내통장표시'받는분표시
      
	'v003 sta : 간편이체한도 미적용 
	If g_szSapeYN == "Y" Then
		sMdiaSkipYN = "N"
	Else
		sMdiaSkipYn = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r_1", "OutBlock3", "SECU_MDIA_EXLS_YN" , 0)
	End If
	'v003 fin
	
      if g_szCom == "287" then
          DATAMANAGER.SetDataValue( 0,"obrtd_drng_004a", "InBlock1", "ACNO" , 0, Left(arrData(0),8))
	      DATAMANAGER.SetDataValue( 0,"obrtd_drng_004a", "InBlock1", "ASNO" , 0, Right(arrData(0),2) )
	      DATAMANAGER.SetDataValue( 0,"obrtd_drng_004a", "InBlock1", "ACNT_PWD", 0, szPwd )
          DATAMANAGER.SetDataValue( 0,"obrtd_drng_004a", "InBlock1", "AMDR" , 0, arrData(3) )
	      DATAMANAGER.SetDataValue( 0, "obrtd_drng_004a", "InBlock1", "CASH_DRNG_AMT", 0, arrData(3) )
	      DATAMANAGER.SetDataValue( 0,"obrtd_drng_004a", "InBlock1", "RSEV_YN" , 0, "N" )
	      DATAMANAGER.SetDataValue( 0,  "obrtd_drng_004a", "InBlock1", "RCPY_DATE", 0, Form.GetSharedData("&BIZ_DT" , false) )
	      DATAMANAGER.SetDataValue( 0,"obrtd_drng_004a", "InBlock1", "SMCD" , 0,  "003020")
	      DATAMANAGER.SetDataValue( 0,"obrtd_drng_004a", "InBlock1", "TACT_CLS_CODE" , 0, "01" )
	      DATAMANAGER.SetDataValue( 0,"obrtd_drng_004a", "InBlock1", "TRMD_CLS_CODE" , 0, "17" ) 'v004 11 -> 17
	      DATAMANAGER.SetDataValue( 0,"obrtd_drng_004a", "InBlock1", "TACT_ACNO" , 0, Left(arrData(2),8))
	      DATAMANAGER.SetDataValue( 0,"obrtd_drng_004a", "InBlock1", "TACT_ASNO" , 0, Right(arrData(2),2) )
	      DATAMANAGER.SetDataValue( 0, "obrtd_drng_004a", "InBlock1", "TR_EXPL", 0, arrData(4))
	      DATAMANAGER.SetDataValue( 0,"obrtd_drng_004a", "InBlock1", "CNFT_TR_EXPL" , 0, arrData(5) )
	      DATAMANAGER.SetDataValue( 0,"obrtd_drng_004a", "InBlock1", "BNKB_GRP_NO" , 0, g_szCertUserType & sMdiaSkipYn )	
	      
	      DATAMANAGER.RequestTranData( "obrtd_drng_004a" )
	  else 
	      g_tact_rpcs_tmnu = 0 '이체조회횟수 v006
	      DATAMANAGER.SetDataValue( 0,"obtss_elbs_131u", "InBlock1", "MNRC_BANK_CODE" , 0,  g_szCom)
	      DATAMANAGER.SetDataValue( 0,"obtss_elbs_131u", "InBlock1", "JOB_TRNO" , 0, "031" )'단말
	      DATAMANAGER.SetDataValue( 0,"obtss_elbs_131u", "InBlock1", "MNRC_ACNO" , 0, arrData(2) )
	      DATAMANAGER.SetDataValue( 0, "obtss_elbs_131u", "InBlock1", "TR_AMT", 0,  arrData(3))
	      DATAMANAGER.SetDataValue( 0,"obtss_elbs_131u", "InBlock1", "DRNG_ACNO" , 0, Left(arrData(0),8))
	      DATAMANAGER.SetDataValue( 0,"obtss_elbs_131u", "InBlock1", "ACNT_PROD_CLS_CODE",0,Right(arrData(0),2))
	      DATAMANAGER.SetDataValue( 0,"obtss_elbs_131u", "InBlock1", "PWD", 0 , szPwd )
	      DATAMANAGER.SetDataValue( 0, "obtss_elbs_131u", "InBlock1", "RMT_NAME", 0, cont0.contTran.edtReceiver.caption )
	      DATAMANAGER.SetDataValue( 0,"obtss_elbs_131u", "InBlock1", "FEE" , 0, g_szFee )
	      DATAMANAGER.SetDataValue( 0, "obtss_elbs_131u", "InBlock1", "STDL_CNFT_BRCD", 0, g_szBrcd )'지점코드
	      DATAMANAGER.SetDataValue( 0, "obtss_elbs_131u", "InBlock1", "DRNG_ACNT_BNKB_EXRS_CNTT", 0, arrData(4) )
	      DATAMANAGER.SetDataValue( 0,"obtss_elbs_131u", "InBlock1", "PMPP_INFO_CNTT" , 0, arrData(5) )	
	      DATAMANAGER.SetDataValue( 0,"obtss_elbs_131u", "InBlock1", "RMRK" , 0, g_szCertUserType & sMdiaSkipYn )	
	      
	      DATAMANAGER.RequestTranData( "obtss_elbs_131u" )
	  end if 
	g_nTrcnt = 1  
End Function	   


Function QR_MultiTran()
	DATAMANAGER.ClearOutputData( 0 , "obrtd_drng_004a" )
	DATAMANAGER.ClearOutputData( 0 , "obtss_elbs_131u" )
	
    szPwd = g_szAccountPassword'비번      
	nCnt = cont0.contQuery.Grid0.rowcount
	g_nTrCnt = CInt(nCnt)
	n004aIndex = 0
	n131uIndex = 0
	'for i = 0  to nCnt-1

		szData = cont0.contQuery.Grid0.GetCellData( "bd_cell8", g_nTrIndex )
	    arrData = Split(szData, "♥")''출금계좌'입금은행'입금계좌번호'이체금액'내통장표시'받는분표시 'Fee 'g_szCom 'g_szBrcd
