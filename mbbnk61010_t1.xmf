Sub cont0_contTran_btnOften_OnClick()
    If Len(g_szAccount) < 10 Then
	    Form.ShowAlert(g_szTitle, "계좌번호를 확인하십시오!")
	    exit sub 
	End If
'	Form.OpenCommonDialog("mbbnk60810.xmf", sParam1, sParam2) 
    Form.OpenPopup("mbbnk61010_p4" , g_szAccount  , "")
    
End Sub

