'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	Select Case szMk
		Case "J", "Q", "F", "MF", "XF", "O", "MO", "QO", "U", "T", "W", "B", "P", "N", "EN", "FN", "EMPTY", "JF", "JO", "WO"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	
			return szMk
		'해외주식	
		Case "AX", "HK", "JP", "SZ", "SH", "NY", "OQ"
			return szMk
		Case "N"			' 해외지수, 환율은 같은 시장구분으로 내려오기에 분리시켜야 한다.
			If InStr(szCd, "@") == 0 then
				return "EN"
			else
				return szMk
			end if
		Case Else
			return ""
	End Select	
End Function

'============================================================================
' f_GetMarketName : 종목코드에 따른 시장명 RETURN
'============================================================================
Function f_GetMarketName(szCode)'0802 JJH 뉴스에 코스피 코스닥 코넥스만 노출
	Dim szMarket, szInnerMk
	szMarket =  Form.GetItemCodeInfo(szCode, "market")
	szMarket = Change_EtcMarket(szMarket)
	szMarket = f_ChkMarket(szMarket, szCode)
	
	if szMarket == "J" then
		szInnerMk = Form.GetItemCodeInfo(szCode, "innermarket")

		if szInnerMk == "001" then
			'0818 JJH 수익증권J, 신주인수권F 제거 START------------
			if Left(szCode, 1, 1) <> "J" and Left(szCode, 1, 1) <> "F" then
				return "KOSPI"
			else
				return ""
			end if
			'0818 JJH 수익증권J, 신주인수권F 제거 END------------
		elseif szInnerMk == "002" then
			return "KOSDAQ"
'		elseif szInnerMk == "013" then
'			return "ETF"
		elseif szInnerMk == "033" then
			return "KONEX"
		else
			return ""
		end if
	else
		return ""
	end if

End Function

'============================================================================
' 관심그룹
'============================================================================
Sub cmbGroup_OnEditComplete(iIndex)
	lblGroupNm.caption = cmbGroup.caption
	lblGroupNm.setmaxlinecount(2)
	g_szGSID = cmbGroup.cbkeydata
	
	if FormTab0.currenttabpageid == "page3" then
		' 선택되어 있는 그룹의 키를 저장한다. 화면 다시 오픈시 적용
		Form.SetEnvData("1", "SELECT_GWGROUP" , cmbGroup.cbkeydata)
		
		init_GWList()
	end if
	
End Sub

'============================================================================
Sub lblGroupNm_OnClick()
	'종목편집 창에서 Env가 바뀌는 것때문에 현재 선택 그룹키 값을 저장
	Form.SetSharedData("PresentSelectKey", cmbGroup.cbkeydata)
	
	cmbGroup.openlist()
End Sub

'============================================================================	
Function f_SendTrigger()
	grdCode.rowcount	= 0
	grdMk.rowcount	= 0
	grdList0.rowcount	= 0
	grd01.rowcount 	= 0
		
	call f_SettingUI()

	szTabKey = FormTab0.currenttabpageid
	if szTabKey = "page2" then	'보유
		DATAMANAGER.RequestTranData("obsim_stsv_047r")
	elseif szTabKey = "page1" then		'최근조회
		szRecent = Form.GetRecentHistory("99")		
		Call Load_RecentList(szRecent)
	else
		init_GWList()

	end if
End Function

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	grdCode.rowcount	= 0
	grdMk.rowcount	= 0
	grdList0.rowcount	= 0
	grd01.rowcount 	= 0
	call f_SettingUI()
	
	if FormTab0.currenttabpageid <> "page3" then
		imgGrp.visible = false
		lblGroupNm.visible = false
		
		f_SendTrigger()
	else
		if cmbGroup.caption == "" or cmbGroup.caption == null then 
			if g_szAppFirst == "NO" then
				Call init_GWGroup()
			else
				imgGrp.visible = false
				lblGroupNm.visible = false
				imgNotice.visible = true
				lbNoticeMsg.visible = true
				lbNoticeMsg.caption = "등록된 관심그룹이 없어요."
			end if
			Exit Sub
		'------------------------------------------------------------------------------------------
		else
			imgGrp.visible = true
			lblGroupNm.visible = true
			
			init_GWList()
		end if
	end if
	'------------------------------------------------------------------------------------------
	
	if FormTab0.currenttabpageid == "page1" then
		Form.SetEnvData("1", "SELECT_GWGROUP" , "BB")
	elseif FormTab0.currenttabpageid == "page2" then
		Form.SetEnvData("1", "SELECT_GWGROUP" , "CC")
	end if
End Sub


