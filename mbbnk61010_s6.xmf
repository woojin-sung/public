Sub SetSmartUI(bState)
	
	if bState == "Y" THEN		
		ImageHelp01.enable = TRUE
		ImageHelp01.visible = TRUE
		Container0.top = 5
		Container1.enable = TRUE
		'Container1.visible = TRUE
		Image0.visible = TRUE
		BtnApp.visible = TRUE
		BtnRetry.visible = TRUE
	else
		ImageHelp01.enable = FALSE
		ImageHelp01.visible = FALSE
		Container1.enable = FALSE
		'Container1.visible = FALSE
		Image0.visible = FALSE
		BtnApp.visible = FALSE
		g_sAthnType = "1"
		Container0.top = 40		
		BtnRetry.visible = FALSE
	END IF
	
	Container0.visible = TRUE
End Sub
