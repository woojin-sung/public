'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 공인인증서_이체
' 02. 화면설명 : 공인인증서_일반/스마트OTP
' 03. 작    성 : 2016.03.14 
' 04. 수    정 : 2018.04.02 윤유정 : TZ OTP 도입에 따른 화면 문구수정 v0001
'			   2019.12.18 김유경 : TZ OTP 서비스 종료에 따른 화면 문구수정 ( 스마트/TZ OTP -> 스마트 OTP )
'			: 2020.09.16 : 권오상 : v003 : T2008250015 : 메모리평문 취약점 수정
' 2020.11.13 : 정민영 : v004 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_oimf_520r,522a,523a,ohhts_ocsp_001r IO 변경분 반영
'            : 정민영 : v005 : [T2011240020] 공인인증서 명칭 변경('공인'단어 삭제)
' 2021.05.27 : 정민영 : v006 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obcsb_efif_060a IO변경분 적용
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sUserID, g_nOTPCnt, g_sSmartYN '사용자ID, OTP인증처리횟수, SmartOTP여부값
Dim g_nOTPPreCnt		'OTP 사전정보전송 cnt
Dim	g_PlainRm 'v003

'-------------------------------------------------------
'90020 은행/지점 개설계좌 ID등록 화면에서 팝업시 사용
'-------------------------------------------------------
Dim g_sSendData		'마지막 팝업화면으로 각 페이지의 입력 데이터 전달
Dim g_szList			'g_sSendData Split Array
Dim g_bIsFromIDReg	'True : 은행/지점개설계좌ID 화면에서 팝업, False : 그외 화면에서 팝업

'g_szList(0) : "지점"
'g_szList(1) : 필수정보입력_고객구분(내국인/외국인/법인)
'g_szList(2) : 필수정보입력_고객식별번호
'g_szList(3) : 필수정보입력_계좌번호
'g_szList(4) : 필수정보입력_계좌비밀번호
'g_szList(5) : 필수정보입력_사용자ID
'g_szList(6) : 필수정보입력_ID비밀번호
'-------------------------------------------------------
Dim szText
Dim g_sAthnType
Dim g_sTrData
Dim g_sTranCrpt
Dim g_sSmrtOtpYn
Dim g_szChk

'20190905 LES START 공인인증 최대오류횟수 변경
Dim DEF_CERT_PSWD_LIMIT_CNT
DEF_CERT_PSWD_LIMIT_CNT = 5
'20190905 LES END
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim szData
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v003

	'v003
	If g_PlainRm = "1" Then '보안모듈 적용
		Container0.EditInput1.SetEncExcept()
	End If

	'Edit0.certname = "공인인증서 비밀번호 입력"	
	Container0.EditInput1.certname = "OTP번호 입력"
	Container1.EditPin.certname = "PIN번호 입력"
	g_sSmartYN = "N"
	g_nOTPCnt = 0
	g_nOTPPreCnt = 0
	g_sRetData = "cancel"
	g_sAthnType = "2"		'거래연동인증
	g_szChk = "1"
	
	g_sTrData = Form.GetSharedData("OTP_TR_MSG_1", false )

	LabelSRNO.caption = ""
	LabelDATE.caption = ""
	
	Container0.enable = TRUE
	Container0.EditInput1.enable = TRUE
	Container1.visible = FALSE
	
'	'-------------------------------------------------------
'	'90020 은행/지점 개설계좌 ID등록 화면에서 팝업시
'	'-------------------------------------------------------
	g_bIsFromIDReg = False
	szData = Form.GetOpenLinkData()
	
	if szData == "" or szData == Null then
		g_sSendData = ""
	else
		g_sSendData = szData
	end if
	
	if Trim(g_sSendData) <> "" or Trim(g_sSendData) <> Null then
		g_szList = Split(g_sSendData,"★")		
'		
'		g_bIsFromIDReg = True
'		Form.SetScreenName( "지점개설계좌ID등록" )
'	else
'		g_sUserID = Form.GetSharedData("CERT_ID" , false)
'		if g_sUserID == null or g_sUserID == "" then
'			g_sUserID = Form.GetSharedData("&USER_ID" , false)
'		end if
'	
'		Form.SetScreenName( "보안매체 인증" )
'	
'		if g_sUserID ~= null and g_sUserID ~= "" then
'			DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
'		end if
	end if
	
	'그외 화면에서 팝업한 경우
	if #g_szList < 2 then	'16-04-15 YCJ if UBOUND(g_szList) < 1 then 였던 부분 수정
		g_sUserID = Form.GetSharedData("CERT_ID" , false)
		if g_sUserID == null or g_sUserID == "" then
			g_sUserID = Form.GetSharedData("&USER_ID" , false)
		end if
	
		Form.SetScreenName( "보안매체 인증" )
	
		if g_sUserID ~= null and g_sUserID ~= "" then
			DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
		end if
		
	'은행/지점개설계좌ID 화면에서 팝업한 경우
	else
		g_bIsFromIDReg = True
		Form.SetScreenName( "지점개설계좌ID등록" )
	End if
	'-------------------------------------------------------
	
	
	'Form.MsgBox( g_sTrData)
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_oimf_520r" then
'		if g_bIsFromIDReg == True then		'은행/지점개설계좌ID 화면에서 팝업한 경우
'			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "2" ) '계좌번호
'			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ACNO" , 0 , g_szList(3) )
'		else
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "1" ) '전자금융ID
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
'		end if
	elseif szTranID == "obcsb_oimf_522a" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "INPUT_CLS" , 0 , "2" ) '전자금융ID
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "OTP_RSPN_VAL" , 0 , Container0.EditInput1.caption )
		if g_nOTPCnt == 0 then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "TRNM_RSLT_YN" , 0 , "N" )
		else
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "TRNM_RSLT_YN" , 0 , "Y" )
		end if
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "OTP_TLMS_SRNO" , 0 , LabelSRNO.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "STND_DATE" , 0 , LabelDATE.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "ATHN_BSWR_CLCD" , 0 , g_sAthnType )	'거래연동인증
		
		'sTranCrpt = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "TRAN_CRPT" , 0 ) 
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_522a", "InBlock1", "TRAN_CRPT" , 0 , g_sTranCrpt )	'거래연동인증
		
	elseif szTranID == "obcsb_oimf_523a" then
		if g_nOTPPreCnt == 0 then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "TRNM_RSLT_YN" , 0 , "N" )
		else
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "TRNM_RSLT_YN" , 0 , "Y" )
		end if
	'Form.MsgBox( "알림", g_sTrData, "", 6 )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "INPUT_CLS" , 0 , "2" )'전자금융ID
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		'DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "TRNM_RSLT_YN" , 0 , g_sSmartYN )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "OTP_TLMS_SRNO" , 0 , LabelSRNO.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "STND_DATE" , 0 , LabelDATE.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "ATHN_BSWR_CLCD" , 0 , g_sAthnType )	'거래연동인증
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_523a", "InBlock1", "TR_DTL_CNTT" , 0 , g_sTrData )	'거래연동인증
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		Dim sRSLT_CLS, sSCRC_STAT_CODE
		
		'결과구분 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "RSLT_CLS" , 0 )
		'상태코드 0:정상, 1:매체사고, 2:비번오류횟수초과, 6:사용등록안됨
		sSCRC_STAT_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "SCRC_STAT_CODE" , 0 )
		g_sSmrtOtpYn = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "UI_SMRT_OTP_YN" , 0 )
		SetSmartUI(g_sSmrtOtpYn)		' obcsb_oimf_523a 호출함.
		g_sSmartYN = g_sSmrtOtpYn
		
		if sRSLT_CLS == "3" then 'OTP
			if sSCRC_STAT_CODE == "0" then '정상
				DATAMANAGER.RequestTranData( "obcsb_oimf_523a" )
'				ButtonOK.enable = true
				'DATAMANAGER.RequestTranData( "obcsb_oimf_523a" ) '일반/스마트OTP여부조회 --> 위로 이동
			elseif sSCRC_STAT_CODE == "1" then '매체사고	
				Form.MsgBox( "알림", "매체사고 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "2" then '비번오류횟수초과	
				Form.MsgBox( "알림", "비밀번호 오류초과 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "6" then '사용등록안됨	
				Form.MsgBox( "알림", "사용등록이 안되었습니다.", "", 6 )
			else '그외
				Form.MsgBox( "알림", "미지정 상태입니다.", "", 6 )
			end if
		end if
		
		

		
	elseif szTranID == "obcsb_oimf_523a" then
		Dim sUI_SMRT_OTP_YN, sPROS_YN, sOTP_TLMS_SRNO, sSTND_DATE, sPIN_NO
		
		'N:스마트OTP아님 Y:스마트OTP
		sUI_SMRT_OTP_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "UI_SMRT_OTP_YN" , 0 )
		'N:전문미수신/전문수신완료
		sPROS_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "PROS_YN" , 0 ) 
		sOTP_TLMS_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "OTP_TLMS_SRNO" , 0 ) 
		sSTND_DATE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "STND_DATE" , 0 ) 
		sPIN_NO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "PIN_NO" , 0 ) 
		
		if g_nOTPPreCnt == 0 then
			g_sTranCrpt = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_523a", "OutBlock1", "TRAN_CRPT" , 0 ) 
		end if
		
		if Len(Trim(sOTP_TLMS_SRNO)) > 7 then '전문일련번호
			LabelSRNO.caption = sOTP_TLMS_SRNO
		end if
	
		if Len(Trim(sSTND_DATE)) == 8 then '기준일자
			LabelDATE.caption = sSTND_DATE
		end if
		
		if sUI_SMRT_OTP_YN <> "Y" then
			exit sub
		end if 
		
		if g_nOTPPreCnt == 0 then
			g_nOTPPreCnt = g_nOTPPreCnt+1
			DATAMANAGER.RequestTranData( "obcsb_oimf_523a" ) 'OTP사전정보전송
			Exit Sub
		end if
		
		Dim sCode 
		sCode = DATAMANAGER.GetDataMsgCode( szTranID ) 
		if sCode == "3021" then 'OTP 코드 체크(3021)
			g_nOTPPreCnt = g_nOTPPreCnt+1
			if g_nOTPPreCnt < 9 then
				DATAMANAGER.RequestTranData( "obcsb_oimf_523a" ) 'OTP정보확인
			else
				g_nOTPPreCnt = 0
				Form.MsgBox( "알림", "OTP 전문 수신오류입니다.", "", 6 )
				Exit Sub
			end if
		elseif sCode == "0000" then
			Container1.EditPin.caption = sPIN_NO
		else
			sMsg = DATAMANAGER.GetDataMsgText( szTranID )
			sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
			Form.MsgBox( "알림", sMsg.." "..sSubMsg, "", 6 )
		end if

	elseif szTranID == "obcsb_oimf_522a" then
		Dim sOTP_TLMS_SRNO, sSTND_DATE, sOTP_RSPN_CODE, sRSLT_CLS, sOTP_PWD_MSTK_TMNU
		
		sOTP_TLMS_SRNO = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_522a", "OutBlock1", "OTP_TLMS_SRNO" , 0 )
		sSTND_DATE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_522a", "OutBlock1", "STND_DATE" , 0 )
		'0000:정상 나머지:오류
		sOTP_RSPN_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_522a", "OutBlock1", "OTP_RSPN_CODE" , 0 )
		'결과구분 0:정상 그외에러
		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_522a", "OutBlock1", "RSLT_CLS" , 0 )
		'OTP오류횟수
		sOTP_PWD_MSTK_TMNU = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_522a", "OutBlock1", "OTP_PWD_MSTK_TMNU" , 0 )
				
		if Len(Trim(sOTP_TLMS_SRNO)) > 7 then '전문일련번호
			LabelSRNO.caption = sOTP_TLMS_SRNO
		end if
	
		if Len(Trim(sSTND_DATE)) == 8 then '기준일자
			LabelDATE.caption = sSTND_DATE
		end if
	
		if g_nOTPCnt == 0 then
			g_nOTPCnt = g_nOTPCnt+1
			DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
			Exit Sub
		end if
		
		Dim sCode 
		sCode = DATAMANAGER.GetDataMsgCode( szTranID ) 
		if sCode == "3021" then 'OTP 코드 체크(3021)
			g_nOTPCnt = g_nOTPCnt+1
			if g_nOTPCnt < 9 then
				DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
			else
				g_nOTPCnt = 0
				Form.MsgBox( "알림", "OTP 전문 수신오류입니다.", "", 6 )
				Exit Sub
			end if
		end if
	
		if sOTP_RSPN_CODE == "0000" then 'OTP응답코드
			if sRSLT_CLS == "0" then '정상
				if CInt(sOTP_PWD_MSTK_TMNU) > 5 then '에러	
					Form.MsgBox( "알림", "OTP 입력 오류 횟수 초과입니다.", "", 6 )
				else
					if g_bIsFromIDReg == True then		'은행/지점개설계좌ID 화면에서 팝업한 경우
						DATAMANAGER.RequestTranData("obcsb_efif_060a")	'ID 등록요청
					else
'						if Edit0.caption == null or Edit0.caption == "" then
'							Form.MsgBox("알림", "공인인증서 비밀번호를 입력하세요", "", 6)
'						else
							g_sRetData = "ok"  'otp성공후 공인인증
							
							Form.triggerEvent("#", "인증서", "Success")	
							
'							Dim sDN
'							sDN = Form.GetSharedData("&USER_CERT_DN" , false)	
'							Form.RequestCertCommand( "ReqCheckIsValidPassword", sDN, Edit0.caption )

'						end if
					end if
				end if
			else
				Dim sMsg, sSubMsg 
				sMsg = DATAMANAGER.GetDataMsgText( szTranID )
				sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
				Form.MsgBox( "알림", sMsg.." "..sSubMsg, "", 6 )
			end if
		'20160601 최일규 추가 : OTP unsync 재조회시 SKIP
		elseif sOTP_RSPN_CODE == "4000" then
		     Exit Sub
		'16-03-11 YCJ 추가
		else
			sMsg = DATAMANAGER.GetDataMsgText( szTranID )
			sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
			Form.MsgBox( "알림", sMsg.." "..sSubMsg, "", 6 )

		end if
	elseif szTranID == "obcpp_logn_015a" then
		'공인인증서 비밀번호 오류횟수
		sMstk =  DATAMANAGER.GetDataValue( 0,"obcpp_logn_015a", "OutBlock1", "PBCR_PWD_MSTK_TMNU" ,0)

		nCount = CInt(sMstk)
		if nCount >  0 then	
			'Form.ShowAlert("알림", "공인인증서 비밀번호 " & tonumber(sMstk) & "회 오류입니다.\n연속 7회 오류시 접속이 제한됩니다.")	
			'1. 공인인증 5회이상 초과
			if CInt(sMstk) >= DEF_CERT_PSWD_LIMIT_CNT then
				Form.MsgBox( "알림",  "인증 비밀번호 5회 오류 초과로 앱이 종료됩니다.", "CERT_PSWD_FAIL_APP_TERMINATE", 0)
				Exit Sub
			
			'2. 공인인증 오류횟수 5회 미만
			else
				Form.MsgBox( "알림",  "인증 비밀번호 " + CInt(sMstk) + "회 오류입니다. 5회 오류 초과시 업무진행이 불가능 합니다.", "", 0)
			end if
			
			'3. 오류횟수 공유변수 저장 (공인인증 오류횟수는 공유변수로 앱 종료전까지 모든화면이 공유)
			Form.SetSharedData("CERT_PWD_ERR_CNT" , sMstk)
		
		
		'-----------------------------------------------------
		' 인증서 비밀번호 일치시
		'-----------------------------------------------------
		else
			
			' 기존) 인증서 비밀번호가 5회 초과된 상태에서 인증서 비밀번호 일치시, 업무진행 가능
			' 변경) 인증서 비밀번호가 5회 초과된 상태에서 인증서 비밀번호 일치시, 업무진행 불가
			sCertErrCnt = Cint(Form.GetSharedData("CERT_PWD_ERR_CNT", false ))
			
			'4. 공유 오류횟수 > 최대 오류횟수 : 업무진행 불가 메세지
			if sCertErrCnt >= DEF_CERT_PSWD_LIMIT_CNT then
				Form.MsgBox( "알림",  "인증 비밀번호 5회 오류 초과로 업무진행이 불가능 합니다.",	""	,	0)
				Exit Sub
			
			'5. 공유 오류횟수 < 최대 오류횟수 : 공유 오류횟수 초기화
			else
				Form.SetSharedData("CERT_PWD_ERR_CNT" , 0)
			end if
		    
		end if
	
	'20160517 OCSP검증 추가
	elseif szTranID == "ohhts_ocsp_001r" then
		sStatCode =  DATAMANAGER.GetDataValue( 0,"ohhts_ocsp_001r", "OutBlock1", "STAT_CLS_CODE" ,0) '상태구분코드

		if sStatCode == "Y" then
			szText = "Success"
			ButtonOK_OnClick()
'			Form.triggerEvent("#", "공인인증서", sParam1)
		end if
	'20160517 END	
	
	end if
	
	'ID 등록요청
	if szTranID == "obcsb_efif_060a" then	
		Dim sSucsYN
		sSucsYN = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "SUCS_YN" , 0)
		if sSucsYN == "Y" then
			Form.MsgBox( "알림", "ID등록이 정상처리 되었습니다.", "close", 6 )
		elseif sSucsYN == "N" then
			Form.MsgBox( "알림", "ID등록이 실패하였습니다. 해당 영업점 또는 고객지원센터(1588-3400)로 문의 바랍니다.", "", 6 )
		end if
		
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obcsb_oimf_523a" then
		Dim sSubMsg
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			szErrMsg = szErrMsg.." "..sSubMsg
		end if
		
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	elseif szTranID == "obcsb_oimf_522a" then
		if szErrCode ~= "3021" and szErrCode ~= "9221" then
			Form.MsgBox( "알림", "OTP 입력 에러입니다. 다시 입력하십시오.", "", 6 )
		elseif szErrCode == "3021" then
			g_nOTPCnt = g_nOTPCnt+1
			if g_nOTPCnt < 9 then
				DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
			else
				g_nOTPCnt = 0
				Form.MsgBox( "알림", "OTP 전문 수신오류입니다.", "", 6 )
			end if 
		else
			Form.ShowAlert( "알림", szErrMsg)
		end if
	end if
End Sub
 
