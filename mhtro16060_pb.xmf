' 20200511 LES END
'============================================================================

'============================================================================
' 20201021 LES START 해외주식 매도상환
'============================================================================

Sub SetItemGubun()
	dim nOwnQty, nMadoQty, szDotType, szLoanType 'v001
	for i = 0 to grdList.rowcount -1 
		szLoanType = grdList.GetCellData("bd_cell27", i)
		szDotType = grdList.GetCellData("bd_cell29", i)
		'v001 START
		nOwnQty = CDbl(grdList.GetCellData("bd_cell31", i)) '잔고수량
		nMadoQty = CDbl(grdList.GetCellData("bd_cell32", i)) '매도가능수량
		
		if szDotType == "2" then
			grdList.SetCellData("bd_cell25", i, "소수점")
			nOwnQty = FormatNumber(nOwnQty, 6)
			nMadoQty = FormatNumber(nMadoQty, 6)
		else
			if szLoanType = "0251" then
				grdList.SetCellData("bd_cell25", i, "담보융자")
			else
				grdList.SetCellData("bd_cell25", i, "일반")
			end if
			
			nOwnQty = FormatNumber(nOwnQty, 0)
			nMadoQty = FormatNumber(nMadoQty, 0)
		end if
		
		grdList.SetCellData("bd_cell2", i, nOwnQty)
		grdList.SetCellData("bd_cell12", i, nMadoQty)
		'v001 END
	next
	

End sub

