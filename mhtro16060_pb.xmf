End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szLoanDate, szLoanCd, szLoanSr, szData
	Dim errmsg
	
	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	
	if szScreenNo == "16075" then
	
		'20200519 LES START 오프라인종목 예외처리
		szOnline 	= grdList.GetCellData("bd_cell19"	,	lRow)
		if szOnline == "N" then
    		     Form.ShowAlert("알림", "MTS에서 거래가 불가한 종목입니다.\n(영업점 또는 해외주식 데스크 문의)") 'v002
			Exit Sub
		end if
		'LES END
		
		
		'20211216 LES START 오프라인종목 예외처리 추가
		szFullcode = grdList.GetCellData("bd_cell20", lRow)
		szMarketCode = right(szFullcode,2)
		
		if szMarketCode == "OT" then
			Form.ShowAlert("알림", "MTS에서 거래가 불가한 종목입니다.\n(영업점 또는 해외주식 데스크 문의)") 'v002
			Exit Sub
		end if
		'20211216 LES END
		
		
		listLocation =  Split(grdList.location,":")
		nYPos = Int(listLocation[1])
		height = listLocation[3]
		
		'v001 START
		g_szSelectType = grdList.GetCellData("bd_cell29", lRow) 'v001
		nMadoQty = CDbl(grdList.GetCellData("bd_cell32", lRow)) '매도가능수량
		if g_szSelectType == "1" then
			nMadoQty = CInt(nMadoQty)
		elseif g_szSelectType == "2" then
			nMadoQty = FormatNumber(nMadoQty, 6)
		end if
		'v001 END
		
		szTranExch = grdList.GetCellData("bd_cell21" , lRow)
		szCutIscd  = grdList.GetCellData("bd_cell1"  , lRow)
		szItemName = grdList.GetCellData("bd_cell11" , lRow)
'		szQty 	  = grdList.GetCellData("bd_cell12" , lRow)
		szQty 	  = nMadoQty 'v001
		sPopupType = "2"
		
		'20201021 LES START 해외주식 매도상환
		szLoanDate = grdList.GetCellData("bd_cell23", lRow)
		szLoanCd   = grdList.GetCellData("bd_cell27", lRow)
		szLoanSr   = grdList.GetCellData("bd_cell28", lRow)
		'20201021 LES END
				
		
		
		if len(szCutIscd) < 0 or len(szTranExch) < 0 then
			msgbox "필수 데이터 값이 존재하지 않습니다." & "@" & szCutIscd & "@" & szTranExch
		end if
		
		
		g_szNewData 		= szTranExch & "@" & szCutIscd & "★" & szItemName
		g_szNewBuyData 	= szTranExch & "@" & szCutIscd & "★" & szItemName & "♥" & "0" & "♥"& szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & "0" & "♥" & szLoanSr '0은 신용합산
		g_szNewSelData 	= szTranExch & "@" & szCutIscd & "★" & szItemName & "♥" & "1" & "♥"& szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & "0" & "♥" & szLoanSr '0은 신용합산
		
		Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매수" & "★" & "매도" & "★" & "" & "★" & "")
				
		'Form.ShowAlert("g_szNewData", g_szNewData)
		'Form.ShowAlert("g_szNewBuyData", g_szNewBuyData)
		'Form.ShowAlert("g_szNewSelData", g_szNewSelData)
		
	else
		errmsg = "종목마스터의 오류로 주문 및 시세 조회가 불가능합니다. 동일 증상 반복 시 확인 버튼을 눌러 주시기 바랍니다.\n\n ※기타문의사항은 고객지원센터 (1588-3400)로 문의하여 주시기 바랍니다."

		if lRow > -1 then
			szCdName		= grdList.GetCellData("bd_cell11"	,    lRow)
			szCd			= grdList.GetCellData("bd_cell1"	,    lRow)
			szVndrCd		= grdList.GetCellData("bd_cell17"	,    lRow)
			szQty		= grdList.GetCellData("bd_cell12"	,    lRow)
		
			'20201021 LES START 해외주식 매도상환
			szLoanDate 	= grdList.GetCellData("bd_cell23", lRow)
			szLoanCd   	= grdList.GetCellData("bd_cell27", lRow)
			szLoanSr   	= grdList.GetCellData("bd_cell28", lRow)
			'20201021 LES END
			
			
			'20200519 LES START 오프라인종목 예외처리
			szOnline 	= grdList.GetCellData("bd_cell19"	,	lRow)
			if szOnline == "N" then
				Form.ShowAlert("알림", "MTS에서 거래가 불가한 종목입니다.\n(영업점 또는 해외주식 데스크 문의)") 'v002
				Exit Sub
			end if
			'LES END
			
			'20211216 LES START 오프라인종목 예외처리 추가
			szFullcode = grdList.GetCellData("bd_cell20", lRow)
			szMarketCode = right(szFullcode,2)
		
			if szMarketCode == "OT" then
				Form.ShowAlert("알림", "MTS에서 거래가 불가한 종목입니다.\n(영업점 또는 해외주식 데스크 문의)") 'v002
				Exit Sub
			end if
			'20211216 LES END
			
			
		
		
			szData = "잔고" & "★" & szCdName & "★" & szCd & "★" & szVndrCd & "★" & szQty & "★" & szLoanDate & "★" & szLoanCd & "★" & szLoanSr
			if szScreenNo == "16092" then 'v001
				Form.SendReturnToParent("BALANCE", szData)
			else
				Form.SendReturnToParent("16060_BALANCE", szData)
			end if
			Form.CloseForm()
			
		else
			Form.MsgBox("알림", errmsg, "REUPDATE", 1)		
		end if
	end if

End Sub

