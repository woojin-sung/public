Sub acnt1_ChangeAccount()

	if szScreenNo == "16075" then
		
		grdList.SetClear()
		grdList.rowcount = 0
		
		'20200629 LES START
		sCodeList = ""
		
		szFullAcnt = acnt1.caption
		g_szAcnt = Left(szFullAcnt,8)
		g_szAcntCd = Right(szFullAcnt,2)
		
		Request_Data()
		
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "MOVEPOP_RETURN" then
		Dim szListItems, szScreenNo
		szListItems	=	split(sRet,"★")
		
		'v001 START
		if g_szSelectType == "1" then
			szScreenNo = "16060"
		elseif g_szSelectType == "2" then
			szScreenNo = "16092"
		end if
		'v001 END
		
		if	szListItems(1)	=	"0"	then			'현재가
			Form.OpenScreen("16000" , g_szNewData)
		elseif szListItems(1)	=	"1"	then
'			Form.OpenScreen("16060" , g_szNewBuyData)
			Form.OpenScreen(szScreenNo , g_szNewBuyData) 'v001
		elseif szListItems(1)	=	"2"	then
'			Form.OpenScreen("16060" , g_szNewSelData)
			Form.OpenScreen(szScreenNo , g_szNewSelData) 'v001
		end if
	end if
End Sub

