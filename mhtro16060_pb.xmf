' 화 면 명 : 주식주문_잔고팝업
' 화면설명 : 주식주문 매도에서 잔고버튼 클릭시 오픈
' 작    성 : 2016.01.26 ~ 2016. 02. 05      ssang
' 수    정 : 2023.02.28 장시방 grdList 사이즈변경
' 2024.03.20 : 장시방 : v002 : 알림문구 수정
'============================================================================
'v001 20220523: 아이티젠 김성수 : 소수점 종목 추가
'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_szGbn, g_szChk, g_szTab, g_szSelect
g_szAcnt, g_szAcntCd, g_szGbn, g_szChk, g_szTab, g_szSelect = "", "", "", "", "", ""

Dim g_szAcntPwd
g_szAcntPwd = ""

'20200511 LES START
Dim sCodeList
sCodeList = ""

Dim g_tItemList

Dim g_szNewData
Dim g_szNewBuyData
Dim g_szNewSelData

'20200511 LES END

Dim g_szCustID
g_szCustID = ""

Dim g_szType, g_szSelectType'v001
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' Set_Unit
'============================================================================
Function Set_Unit(szData, sDecimal)
	
	sztemp = CStr(szData)
	szChk = InStr(sztemp, ".")
	sDecimal = CStr(CInt(sDecimal))
	
	if CStr(szChk) == "0" then
		if sDecimal = "1" then
			sztemp = sztemp & ".0"	
		elseif sDecimal = "2" then
			sztemp = sztemp & ".00"	
		elseif sDecimal = "3" then
			sztemp = sztemp & ".000"	
		elseif sDecimal = "4" then
			sztemp = sztemp & ".0000"	
		end if 
	else
		szCha = CInt(Len(sztemp) - szChk)

		if szCha > CInt(sDecimal) then
			sztemp = Round(sztemp, CInt(sDecimal))
		end if
		
		szCha = CInt(Len(sztemp) - szChk)
		
		if CStr(szCha) == "1" then 
			if sDecimal == "2" then
				sztemp = sztemp & "0"	
			elseif sDecimal == "3" then
				sztemp = sztemp & "00"	
			elseif sDecimal == "4" then
				sztemp = sztemp & "000"
			else 
				sztemp = sztemp
			end if 	
		elseif CStr(szCha) == "2" then 
			if sDecimal == "3" then
				sztemp = sztemp & "0"	
			elseif sDecimal == "4" then
				sztemp = sztemp & "00"
			else
				sztemp = sztemp
			end if	
		elseif CStr(szCha) == "3" then 
			if sDecimal == "4" then
				sztemp = sztemp & "0"
			else 
				sztemp = sztemp
			end if	
		else
			sztemp = sztemp
		end if
	end if
	
	return sztemp
End Function
'============================================================================
' SetGridData
'============================================================================
Function SetGridData()

	sCodeList = ""
	g_tItemList = {}
	
	For iCnt = grdList.rowcount - 1 To 0 Step -1
		szType 	= grdList.GetCellData("bd_cell7" , iCnt)
		szVndr 	= grdList.GetCellData("bd_cell17" , iCnt)
		
		' 시장구분
		if szType == "01" then
			grdList.SetCellData("bd_cell16", iCnt, "미국")
		elseif szType == "02" then
			grdList.SetCellData("bd_cell16", iCnt, "홍콩")
		elseif szType == "03" then
			'grdList.SetCellData("bd_cell16", iCnt, "상해")
			grdList.SetCellData("bd_cell16", iCnt, "중국")
		elseif szType == "04" then
			'grdList.SetCellData("bd_cell16", iCnt, "심천")
			grdList.SetCellData("bd_cell16", iCnt, "중국")
			
		'20200511 LES START
		elseif szType == "05" then
			grdList.SetCellData("bd_cell16", iCnt, "일본")
			
		elseif szType == "06" then
			grdList.SetCellData("bd_cell16", iCnt, "호주")
		elseif szType == "07" then
			grdList.SetCellData("bd_cell16", iCnt, "싱가포르")
		elseif szType == "19" then
			grdList.SetCellData("bd_cell16", iCnt, "스페인")
		elseif szType == "21" then
			grdList.SetCellData("bd_cell16", iCnt, "캐나다")
		elseif szType == "23" then
			grdList.SetCellData("bd_cell16", iCnt, "인도네시아")
		elseif szType == "24" then
			grdList.SetCellData("bd_cell16", iCnt, "베트남")
		'20200511 LES END
		
		end if
		
		szVndrStr = Transform_Exid(szVndr)
		grdList.SetCellData("bd_cell6", iCnt, szVndrStr)
		
		
		
		
		'20200511 LES START 
		'링크폼(연합인포제공 : 16060_p8) 화면에 종목코드 던져서 해당종목 현재가 얻어오기
				
		szVndrcode = grdList.GetCellData("bd_cell17", iCnt)
		szVndrID = Transform_codeToid(szVndrcode)
		szCode = grdList.GetCellData("bd_cell1", iCnt)
		
		szData = szVndrID & "@" & szCode
		
		grdList.SetCellData("bd_cell21", iCnt, szVndrID)
	
		Dim tItemData
		tItemData = {}
		tItemData.code = szData
		table.insert( g_tItemList, tItemData )
		
		sCodeList = sCodeList & szData
		
		
				
		if iCnt ~= 0 then
			sCodeList = sCodeList & "`"
		end if
		'20200511 LES END

	Next
	

	
	'20200511 LES START
	'Form.ShowAlert("sCodeList_잔고팝업", sCodeList)
'	Form.triggerEvent("linkform", "CodeList", sCodeList)
	'20200511 LES END
	
	
End Function

'============================================================================
' Request_Data() 105r Call
'============================================================================
Function Request_Data()
	grdList.rowcount = 0
	DATAMANAGER.RequestTranData("obtro_oder_105r")
End Function

'============================================================================
' Request_Data() 108r Call
'============================================================================
Function Request_Data_108r()
	DATAMANAGER.RequestTranData("obtro_oder_108r")
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szCustID = Form.GetSharedData("&USER_ID", false )

	Dim szChkVal
	
	Form.SetScreenName("해외주식잔고")

	szChkVal = Form.LoadConfigData( "mhtro16060", "balance" )		'수수료비용반영

	If szChkVal <> "" Then
		chk1.checkstate = szChkVal
	End If
	
	
	'20200504 LES START
	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	if szScreenNo == "16075" then
		
		'20200629 LES START
		grdList.height = 486	'509
		acnt1.enable  = true
		
		szFullAcnt = acnt1.caption
		g_szAcnt = Left(szFullAcnt,8)
		g_szAcntCd = Right(szFullAcnt,2)
		g_szType = "0"'v001
		Request_Data()
	elseif szScreenNo == "16092" then
		Form.SetScreenName("해외소수점잔고")
		g_szType = "2"'v001
		grdList.SetVisibleCol(6, 0) '대출일자/만기일자 열 숨김처리
		szOpen = Form.GetOpenLinkData()
	
		if Trim(szOpen) == "" then
			Exit Sub
		end if

		tData = Split(szOpen, "★")
	
		if UBound(tData) > 0 then
			g_szAcnt   	= tData(0)
			g_szAcntCd 	= tData(1)
			g_szAcntPwd	= tData(2)
			
			Request_Data()
		end if
	else
		g_szType = "1"'v001
		szOpen = Form.GetOpenLinkData()
	
		if Trim(szOpen) == "" then
			Exit Sub
		end if

		tData = Split(szOpen, "★")
	
		if UBound(tData) > 0 then
			g_szAcnt   	= tData(0)
			g_szAcntCd 	= tData(1)
			g_szAcntPwd	= tData(2)
			
			Request_Data()
		end if
	
	
	end if
	'20200504 LES END
	'20220704 ITGEN START
	'매도화면에서 팝업창으로 실행시 하단문구 표시
	if szScreenNo = "16060" or szScreenNo = "16092" then
		grdList.height = 478	'494
		tblInfo.visible = true
	end if
	'20220704 ITGEN END
	
	grdList.setSortCellID("th_cell14","bd_cell10")
	grdList.setSortCellID("th_cell31","bd_cell11")
	grdList.setSortCellID("th_cell0" ,"bd_cell1" )
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	If szTranID = "obtro_oder_105r" Then
		DATAMANAGER.ClearInputData(0, "obtro_oder_105r")
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_105r", "InBlock1", "ACNO" 				, 0, g_szAcnt)		
		DATAMANAGER.SetDataValue(0, "obtro_oder_105r", "InBlock1", "ASNO" 				, 0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obtro_oder_105r", "InBlock1", "ACNT_PWD"			, 0, g_szAcntPwd)
		DATAMANAGER.SetDataValue(0, "obtro_oder_105r", "InBlock1", "IQRY_CLS_CODE"		, 0, "1")
		DATAMANAGER.SetDataValue(0, "obtro_oder_105r", "InBlock1", "PROD_PSTN_CLS_CODE"	, 0, "1")
		DATAMANAGER.SetDataValue(0, "obtro_oder_105r", "InBlock1", "ELFN_ID"				, 0, g_szCustID)
		DATAMANAGER.SetDataValue(0, "obtro_oder_105r", "InBlock1", "RMND_CLCD"			, 0, g_szType) 'v001
		
		'20221213_01 KBC START 해외주식주간거래
		if ChkDaySise.checkstate = "0" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_105r", "InBlock1", "DYTM_TR_CLPR_APLY_YN"	, 0, "N")
		else
			DATAMANAGER.SetDataValue(0, "obtro_oder_105r", "InBlock1", "DYTM_TR_CLPR_APLY_YN"	, 0, "Y")
		end if
		'20221213_01 KBC END
	
	'20200604 LES START 
	elseif szTranID = "obtro_oder_108r" then
		
		'20201222 LES START
		DATAMANAGER.ClearInputData(0, "obtro_oder_108r")
		'LES END
		
		For i = 0 to grdList.rowcount -1
			
			szCode 	= grdList.GetCellData("bd_cell20" , i)
			szPrice 	= grdList.GetCellData("bd_cell5" , i)
			szQty 	= grdList.GetCellData("bd_cell2" , i)
			szCamt 	= grdList.GetCellData("bd_cell14", i)
			szCls 	= grdList.GetCellData("bd_cell7" , i)
			
			DATAMANAGER.SetDataValue(0, "obtro_oder_108r", "InBlock1", "ACNO" 						, i , g_szAcnt)
			DATAMANAGER.SetDataValue(0, "obtro_oder_108r", "InBlock1", "ASNO" 						, i , g_szAcntCd)
			DATAMANAGER.SetDataValue(0, "obtro_oder_108r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" 	, i , szCls)
			DATAMANAGER.SetDataValue(0, "obtro_oder_108r", "InBlock1", "ISCD" 						, i , szCode)
			DATAMANAGER.SetDataValue(0, "obtro_oder_108r", "InBlock1", "UNPR" 						, i , szPrice)
			DATAMANAGER.SetDataValue(0, "obtro_oder_108r", "InBlock1", "HLDN_QTY" 					, i , szQty)
			DATAMANAGER.SetDataValue(0, "obtro_oder_108r", "InBlock1", "BYOV_CAMT" 					, i , szCamt)
			
			szData = g_szAcnt & "★" & g_szAcntCd & "★" & szCls& "★" & szCode & "★" & szPrice & "★" & szQty & "★" & szCamt
		
			'Form.ShowAlert("szData", szData)
		
		Next


	
	End If
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obtro_oder_105r" Then
		
		
		
'20201209 SWJ START : 해외주식 주문잔고 그리드 오류 수정
		if DATAMANAGER.IsMoreNextData("obtro_oder_105r") == true then
		   DATAMANAGER.RequestNextData( "obtro_oder_105r" )
		else
		   
			'연합인포 데이터..
			SetGridData()
		
			'20201021 LES START 해외주식 매도상환
			SetItemGubun()
			
		   	for i = 0 to grdList.rowcount -1
				nDiff = CDbl(grdList.GetCellData("bd_cell10", i))
				swapItemColor(i, nDiff)
			next
		   
		   'Call Request_Data_108r()
		end if
	
	elseif szTranID = "obtro_oder_108r" then
		szCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
  
		for i = 0 to szCnt -1
		   szData1 = DATAMANAGER.GetDataValue(0, "obtro_oder_108r", "OutBlock1", "VLTN_PRLS_CAMT" , i)
		   szData2 = DATAMANAGER.GetDataValue(0, "obtro_oder_108r", "OutBlock1", "FRCR_VLTN_AMT" , i)
		   szData3 = DATAMANAGER.GetDataValue(0, "obtro_oder_108r", "OutBlock1", "ONLN_YN" , i)
		   szData4 = DATAMANAGER.GetDataValue(0, "obtro_oder_108r", "OutBlock1", "VLTN_ERT" , i)
		   
		   grdList.SetCellData("bd_cell3", i, szData1)
		   grdList.SetCellData("bd_cell4", i, szData2)
		   grdList.SetCellData("bd_cell19", i, szData3)
		   grdList.SetCellData("bd_cell13", i, szData4)
		next
'20201209 SWJ END

'		szCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
'		Form.ShowAlert("szCnt", szCnt)
'		for i = 0 to szCnt -1
'			szData = DATAMANAGER.GetDataValue(0, "obtro_oder_108r", "OutBlock1", "VLTN_PRLS_CAMT" , i)
'			Form.ShowAlert("평가손익", szData)
'		next
	
	End If
	
End Sub

