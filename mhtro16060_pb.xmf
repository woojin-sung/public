'============================================================================
'20200519 LES START
'거래소벤더식별번호(OVRS_EXCH_VNDR_IDNO) -> 거래소ID
'============================================================================
Function Transform_codeToid(sValue)

	if sValue == "0104" then	  ' 홍콩
		return "HKS"
	elseif sValue == "0529" then ' 항셍 지수
		return "HSI"
	elseif sValue == "0215" then ' 상해
		return "SHS"
	elseif sValue == "0214" then ' 심천거래소 종목
		return "SZS"
	elseif sValue == "0321" then ' 뉴욕
		return "NY"
	elseif sValue == "0066" then ' 아멕스
		return "AX"
	elseif sValue == "0537" then ' 나스닥
		return "OQ"
	elseif sValue == "0130" then ' 미국 OTCBB
		return "NAO"
	elseif sValue == "0625" then ' S&P 지수
		return "SPI"
	elseif sValue == "0310" then ' 다우존스 지수
		return "DJI"
	elseif sValue == "0106" then ' 도쿄
		return "TSE"
	elseif sValue == "0107" then ' 오사카거래소 종목
		return "OSE"
	elseif sValue == "0112" then ' 자스닥거래소 종목
		return "JSD"
	elseif sValue == "0889" then ' 니케이 지수
		return "NII"
	elseif sValue == "0538" then ' 미국 나스닥 지수
		return "NAI"
	elseif sValue == "0770" then ' 베트남 호치민
		return "HSX"
	elseif sValue == "0771" then ' 베트남 하노이
		return "HNX"
	else
		return ""			
	end if

End Function

'============================================================================
' 거래소코드 -> 거래소벤더코드 변환
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "0104" then	' 홍콩
		return "홍콩"
	elseif sValue == "HS0529I" then ' 항셍 지수
		return "항셍"
	elseif sValue == "0215" then ' 상해
		'return "상해"
		return "후강통"
	elseif sValue == "0214" then ' 심천거래소 종목
		'return "심천"
		return "선강통"
	elseif sValue == "0321" then ' 뉴욕
		return "뉴욕"
	elseif sValue == "0066" then ' 아멕스
		return "아멕스"
	elseif sValue == "0537" then ' 나스닥
		return "나스닥"
	elseif sValue == "0130" then ' 미국 OTCBB
		return "미국 OTCBB"
	elseif sValue == "0625" then ' S&P 지수
		return "S&P"
	elseif sValue == "0310" then ' 다우존스 지수
		return "다우존스"
	elseif sValue == "0106" then ' 도쿄
		return "도쿄"
	elseif sValue == "0107" then ' 오사카거래소 종목
		return "오사카"
	elseif sValue == "0112" then ' 자스닥거래소 종목
		return "자스닥"
	elseif sValue == "0889" then ' 니케이 지수
		return "니케이"
	elseif sValue == "0538" then ' 미국 나스닥 지수
		return "미국 나스닥"
	elseif sValue == "0770" then ' 베트남 호치민
		return "호치민"
	elseif sValue == "0771" then ' 베트남 하노이
		return "하노이"
	end if
end Function


'============================================================================
' 20200511 LES START 
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "CodeData" then
		Dim tData
		Dim tTempData
		tData = Split(sParam, "`")
		
		'연합쪽에서 제공해주는 링크폼(서비스)는 인블럭에 올린 순서대로
		'아웃블럭을 내려주지않아서.. For문을 돌면서 올린 순서대로 그리드에 셋팅한다..
		for i = #tData -1 to 0 Step -1
			tTempData = Split(tData(i), "◆")
			code = tTempData(1)
			
			For index, val in ipairs( g_tItemList )
				nindex = grdList.rowcount - index
				if Null <> code and code == val.code then
				
					grdList.SetCellData("bd_cell5", nindex, tTempData(2))		'현재가
					grdList.SetCellData("bd_cell10", nindex, tTempData(3))		'전일대비
					
					swapItemColor(nindex, CDbl(tTempData(3)))
										
					
				end if
				
			Next
		
		next
		
		'20200616 LES START 
		'연합쪽에서 받아온 현재가를 넘겨 기간계 서비스에서(oder_108r)
		'평가손익/수익률/평가금액을 계산하여 받아온다
'		Call Request_Data_108r()
		'LES END
		
	'20220704 ITGEN START
	' 유의팝업 추가	
	elseif sEventName = "SCREEN_MENU" then
		if sParam = "Show_NotiPopup" then
			Form.OpenPopup("mhtro16060_p13" , "" , "")
		end if
	'20220704 ITGEN END
	end if
	
End Sub
'============================================================================
' 20200511 LES START 
'============================================================================
Function swapItemColor(nIndex, nDiff)
	
	grdlist.SetCellFgColor( "bd_cell10"	, nIndex	, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
	grdlist.SetCellFgColor( "bd_cell5"	, nIndex	, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
	
	grdlist.SetCellData( "bd_cell0", nIndex, nDiff > 0 and "2" or ( nDiff < 0 and "5" or "0" ) )
	
End Function

