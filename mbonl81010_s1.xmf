				<CELL cell_ly="0,5,1,5" halign="0" line="0,0" caption=" · 본 투자성향진단서에 의한 투자성향 진단은 고객님의 투자" fontsize="-2" impidxs="" />
				<CELL cell_ly="0,6,1,6" halign="0" line="0,0" caption="     목적, 재산/소득 상황, 투자성향 파악을 통해 고객님께 " fontsize="-2" impidxs="" />
				<CELL cell_ly="0,7,1,7" halign="0" line="0,0" caption="     적합한 투자권유를 하기위한 절차입니다." fontsize="-2" impidxs="" />
				<CELL cell_ly="0,8,1,8" halign="0" line="0,0" caption=" · ELS/DLS등 파생결합증권의 청약을 위해서 아래의 설문을 " fontsize="-2" impidxs="" />
				<CELL cell_ly="0,9,1,9" halign="0" line="0,0" caption="     작성하여야합니다. " fontsize="-2" impidxs="" />
