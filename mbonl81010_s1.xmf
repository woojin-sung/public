				<TABLE name="Table0" insidelinecolor="102:255255255" colcount="2" rowcount="8" outline="0000" transmode="1" designorder="1" ly_vert="1,16,374,172,1" >
					<COL_INFO ly_vert_width="21,353" />
					<ROW_INFO ly_vert_height="22,22,22,22,20,22,20,22" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" line="0,0" impidxs="" />
						<CELL cell_ly="1,0,1,0" halign="0" line="0,0" caption="투자권유를 희망하지 않거나 투자자정보를 제공하지 않는" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,1,0,1" line="0,0" impidxs="" />
						<CELL cell_ly="1,1,1,1" halign="0" line="0,0" caption="경우 고객의 별도의사가 있기 전까지 회사가 투자권유를" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,2,0,2" line="0,0" impidxs="" />
						<CELL cell_ly="1,2,1,2" halign="0" line="0,0" caption="할 수 없습니다. 투자시 원금 손실이 발생할 수 있으며," fontsize="-2" impidxs="" />
						<CELL cell_ly="0,3,0,3" line="0,0" impidxs="" />
						<CELL cell_ly="1,3,1,3" halign="0" line="0,0" caption="투자손익에 대한 책임은 모두 고객에게 귀속됩니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,4,0,4" line="0,0" impidxs="" />
						<CELL cell_ly="1,4,1,4" line="0,0" impidxs="" />
						<CELL cell_ly="0,5,0,5" line="0,0" impidxs="" />
						<CELL cell_ly="1,5,1,5" halign="0" line="0,0" caption="※ 일임(비지정형)신탁계약 및 파생상품등 거래희망시에는 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,6,0,6" line="0,0" impidxs="" />
						<CELL cell_ly="1,6,1,6" halign="0" line="0,0" caption="    투자자정보를 제공하셔야 합니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,7,0,7" line="0,0" impidxs="" />
						<CELL cell_ly="1,7,1,7" halign="0" line="0,0" fontsize="-2" impidxs="" />
					</CELL_INFO>
