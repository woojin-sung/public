				<CELL cell_ly="1,3,1,3" line="0,0" impidxs="" />
				<CELL cell_ly="0,4,0,4" fgcolor="065:102102102" halign="0" line="0,0" caption="당일진단 회차" fontsize="-2" fontstyle="01" impidxs="" />
