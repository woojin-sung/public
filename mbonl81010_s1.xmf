'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim szLinkedData
	dim szAcctList
	dim nLen
	
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v006

	gKYCDtDiFlag = 0
	nLen	=	0
'	g_szPassword = "1357"		'임시세팅
'	g_szAccNo = "30062638"		'임시세팅

	Form.SetScreenName("설문항목화면")
	szLinkedData = Form.GetOpenLinkData( )
	g_szScrNo	=		Form.GetSharedData("&SCREEN_NO", 0 )

	if	szLinkedData	<>	NULL	then
		nLen	=	Len(szLinkedData) 
	end	if
	
	if nLen <  4   then
		'Form.ShowAlert("안내", "연결된 계좌정보가 없습니다.")		'테스트용
		cont01.visible = false
		btnReg01.visible = false
		cont02.visible = false
	else
		cont01.visible = true
		btnReg01.visible = true
		cont02.visible = false
		
		szAcctList	=	Split(szLinkedData, "★")
		g_szAccNo	= szAcctList (0)
		g_szPassword	= szAcctList (1)
		
		DATAMANAGER.RequestTranData("obcsb_acif_701r")
	end if 
End Sub

'============================================================================
'ImageHelp01_OnClick
'============================================================================
Sub ImageHelp01_OnClick()
	Form.ShowAlert(g_szAlertTitle, "기존 투자성향 등급이 있는 경우에는 당일 투자성향 진단을 새로 등록하여도 상품 가입 시 기존과 당일 중 낮은 등급을 적용합니다. 기존 등급이 있는 경우에는 금일 등록한 투자성향 등급은 익일부터 적용됩니다.")
End Sub

'============================================================================
'ImageHelp02_OnClick
'============================================================================
Sub ImageHelp02_OnClick()
	Form.ShowAlert(g_szAlertTitle, "취약금융소비자는 65세 이상, 은퇴자, 주부등 금융투자상품 투자 경험이 없거나 부족한 투자자인 경우에 해당됩니다. 취약금융소비자인 경우 고객등급보다 1등급 초과 상품가입이 불가 합니다.")
End Sub


'============================================================================
'cmbInvest01_OnEditComplete
'============================================================================
Sub cmbInvest01_OnEditComplete(iIndex)
	if iIndex = 2 then				'투자권유불원(정보미제공)
		cont01.visible = false
		btnReg01.visible = false
		cont02.visible = true
		btnConfirm01.visible = true
		
	else
		cont01.visible = true
		btnReg01.visible = true
		cont02.visible = false
		btnConfirm01.visible = false
	end if 
End Sub

'============================================================================
'cont02_chkInvest01_OnChange
'============================================================================
Sub cont02_chkInvest01_OnChange(sCheckState)
	if sCheckState = "1" then
		btnConfirm01.enable = true
	else
		btnConfirm01.enable = false
	end if 
End Sub


'============================================================================
'btnConfirm01_OnClick
'============================================================================
Sub btnConfirm01_OnClick()
	if rdoWeak01.currentindex = "-1" then   'v003
		Form.ShowAlert(g_szAlertTitle, "취약금융소비자 여부(Y/N)을 선택하여 주십시오.")
		Exit Sub
	else 
		if cmbInvest01.cbkeydata = "4"  then						'정보미제공
			if g_nTryCnt > 1 then
				Form.OpenPopup("mbonl81010_p15" , "" , "")
			else
				If g_CUST_CLS_CODE = "1" Then						'개인
					DATAMANAGER.RequestTranData("obcsb_acif_715a_1")	'취약금융소비자
				Else
				     DATAMANAGER.RequestTranData("obcsb_acif_712a")		'투자성향 응답 
				End if 
			End If
		end if 
	end if 
	
	'cont01.visible = true
	'btnReg01.visible = true
	'cont02.visible = false
	'btnConfirm01.visible = true
	
End Sub


'============================================================================
'cont01_btnReg01_OnClick
'============================================================================
Sub cont01_btnReg01_OnClick()

	if rdoWeak01.currentindex = "-1" then
		Form.ShowAlert(g_szAlertTitle, "취약금융소비자 여부(Y/N)을 선택하여 주십시오.")
	end if 
End Sub


'============================================================================
'cmbInfoChg01_OnEditComplete
'============================================================================
Sub cmbInfoChg01_OnEditComplete(iIndex)
	if iIndex = 0 then				'신규/정보변경
		if g_QUES_YN = "Y" then		'설문여부
			g_PROS_CLS_CODE = "2"	'처리구분코드
		else
			g_PROS_CLS_CODE = "1"
		end if 
		
		ChgEnableItems("1")
		cmbInvest01.enable	= 	true
		rdoWeak01.enable	= 	true
		
		'21.07.19 JHY START
		btnInvAdvice.enable	= 	true
		'21.07.19 JHY END
	else							'기존 정보 사용
		if g_QUES_YN = "Y" then		'설문여부
			if DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock2", "QUES_QSIT_NO", 0) = "" then
				Form.ShowAlert(g_szAlertTitle, "기존의 정보를 가져오는데 실패 했습니다")
				cmbInvest01.currentindex = "0"
			else
				call SetAnswer()
			end if 
			
			g_PROS_CLS_CODE = "2"	'처리구분코드
		else	
			Form.ShowAlert(g_szAlertTitle, "신규 응답자 입니다. '신규/정보변경'을 선택해주시길바랍니다.")
			cmbInvest01.currentindex = "0"
			g_PROS_CLS_CODE = "1"
		end if 
	
		ChgEnableItems("0")
		cmbInvest01.enable	=	false
		rdoWeak01.enable	=	false
		
		'21.07.19 JHY START
		btnInvAdvice.enable	= 	false
		'21.07.19 JHY END
	end if 
End Sub


'============================================================================
'btnReg01_OnClick: 등록을 눌렀을때
'============================================================================
Sub btnReg01_OnClick()
	If cmbInvest01.currentindex == "1" Then
		Form.OpenPopup("mbonl81010_p4" , "" , "")
	Else
	    Call Register()
     End If
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if 	szTranID = "obcsb_acif_701r"	then	'KYC고객정보조회
		DATAMANAGER.SetDataValue(0, "obcsb_acif_701r", "InBlock1", "ACNO", 0, g_szAccNo)
	elseif szTranID	= "obcsb_acif_711r"	then	'투자설문조회
'		g_CUST_CLS_CODE = "2"
		DATAMANAGER.SetDataValue(0, "obcsb_acif_711r", "InBlock1", "CUST_CLS_CODE", 0, g_CUST_CLS_CODE)
	elseif szTranID = "obcsb_acif_712a" then	'투자성향질문등록
		if g_QUES_YN = "Y"  then 
		     DATAMANAGER.SetDataValue(0,  "obcsb_acif_712a", "InBlock1", "PROS_CLS_CODE", 0, "2" )
		else
		     DATAMANAGER.SetDataValue(0,  "obcsb_acif_712a", "InBlock1", "PROS_CLS_CODE", 0, "1" )
		end if
	 
		DATAMANAGER.SetDataValue(0,  "obcsb_acif_712a", "InBlock1", "ACNO", 0, g_szAccNo )
		      	      
'		if	g_szScrNo	=	"87040"	then
'			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , g_szPassword)
'		else
'			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetEncData(g_szPassword))
'		end if

		'v006
		If g_PlainRm = "1" Then '보안모듈 적용
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , g_szPassword)
		Else
			if	g_szScrNo	=	"87040" then
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , g_szPassword)
			else
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetEncData(g_szPassword))
			end if
		End If
	
	Elseif szTranID = "obcsb_acif_715a" Then	'고령자보호 (개인고객대상)
	     DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a", "InBlock1", "CNSH_CLS_CODE", 0 , "07" )	'확인서구분코드
	     DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a", "InBlock1", "CUST_CNFR_YN", 0 , "Y" )		'고객확인여부
	     DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a", "InBlock1", "ACNO", 0, g_szAccNo )		'계좌번호
	
	Elseif szTranID = "obcsb_acif_715a_1" Then	'취약금융소비자 (개인고객대상)
	     DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a_1", "InBlock1", "CNSH_CLS_CODE", 0 , "09" )		'확인서구분코드
	     DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a_1", "InBlock1", "CUST_CNFR_YN", 0 , rdoWeak01.GetRadioCaption(rdoWeak01.currentindex) )	'고객확인여부
	     DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a_1", "InBlock1", "ACNO", 0, g_szAccNo )		'계좌번호
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim szGradIn
	
	
	if szTranID = "obcsb_acif_701r" then
	
		call setInvestType()		'등급명 변경
		call setWith701()
		call chkUpdateTime701()
		call chkInvestWeak()
		DATAMANAGER.RequestTranData("obcsb_acif_711r")
	end if 
'
	if szTranID = "obcsb_acif_711r"	then

		If g_QUES_YN = "Y" And gKYCDtDiFlag = 0 then '설문내역있고, 유효 만기 일자가 지나지 않아야함.
			cmbInfoChg01.currentindex  = "1"
		Else
			cmbInfoChg01.currentindex  = "0"
		End if
'		
		if cmbInvest01.currentindex = "2" then			'정보미제공시 
		    cont01.visible = false
		    cont02.visible = true
		    btnReg01.visible = false
		    btnConfirm01.visible = true
		    g_Grade = "00"
		else
		    cont01.visible = true
		    btnReg01.visible = true
		    cont02.visible = false
    		    btnConfirm01.visible = false

	     end if

	    SetSurveyUI(szTranID)
	end if
	
	if szTranID = "obcsb_acif_712a"	then	'투자성향설문응답
	    g_Grade = DATAMANAGER.GetDataValue(0, "obcsb_acif_712a", "OutBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0)
    	    call setApplInvestType()		'등급명 변경
	    
	    DATAMANAGER.RequestTranData("obcsb_acif_701r")
	end if
	
	if szTranID = "obcsb_acif_715a_1" then	'취약금융소비자  
	    DATAMANAGER.RequestTranData("obcsb_acif_712a" )	'응답처리
	end if 
	
	if szTranID = "obcsb_acif_715a" then		'고령자투자성향
	    DATAMANAGER.RequestTranData("obcsb_acif_715a_1" )	'취약금융소비자 SVC Call 
	end if 
End Sub


'============================================================================
'Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
					
	if sKeyName = "INVESTYN" then						'고령자투자보호에 동의여부
		if sRet = "ok" then							'예
			'고령자 대상으로 동의한 경우 
			 DATAMANAGER.RequestTranData( "obcsb_acif_715a" )	'고령자투자보호 SVC
		else 									'아니오
			 Form.ShowAlert( g_szAlertTitle , "고령자투자보호에 동의하지 않으셨습니다" )
		      DATAMANAGER.RequestTranData( "obcsb_acif_715a_1" )	'취약금융소비자 SVC
		end if 
	elseif	sKeyName = "APPTYPE_COMPLETED" then			'투자성향설문등록완료
		if	sRet	=	"close"	then
			if	g_szScrNo	<>	"81010"	then			'투자성향질문일때는 닫아버리면 popup처리가안됨.
				
				'20230420 tab으로 들어가있는 화면이 없어 트리거호출 불필요				
				'mbonl81010에 trigger를 주고 81010에서 FormClose (iOS에서 안 닫히는 문제)
				'Form.triggerEvent("#", "closeForm", "")
				Form.CloseForm()
				
			end	if
		end	if
	else
	end if 
	
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName == "mbonl81010_p4" Then
		If sRet == "OK" Then
			call Register()
		else
			Exit Sub
  		End If
		
	'21.07.19 JHY START : 투자권유구분 팝업에서 선택한 내용으로 세팅 (금소법 관련 수정사항 : 권오상차장님 요청)
	elseif sKeyName == "close_mbonl81010_p13" then
		if tonumber(sRet) <> NULL then
			cmbInvest01.currentindex = sRet
		end if
	'21.07.19 JHY END
	
	'21.09.08 JHY START (v009)
	'투자성향진단 결과 팝업
	elseif sKeyName == "close_mbonl81010_p14" then
		if	g_szScrNo	<>	"81010"	then			'투자성향질문일때는 닫아버리면 popup처리가안됨.
		
			'20230420 tab으로 들어가있는 화면이 없어 트리거호출 불필요	
			'mbonl81010에 trigger를 주고 81010에서 FormClose (iOS에서 안 닫히는 문제)
			'Form.triggerEvent("#", "closeForm", "")
			Form.CloseForm()
		end	if
		
	'투자성향진단 재진단 사유 입력 완료
	elseif sKeyName == "close_mbonl81010_p15" then
		if sRet <> "" then
			DATAMANAGER.ClearInputData(0, "obcsb_acif_712a")
			Set712Input("obcsb_acif_712a")
			
			' 재진단 사유는 여기서 넣어줌
			Dim tReason
			tReason = split(sRet, "★")
		
			if tReason <> "" and tReason <> NULL then
				if tReason[0] <> NULL and tReason[0] <> "" then
					DATAMANAGER.SetDataValue( 0, "obcsb_acif_712a", "InBlock1", "KYC_REREG_REAS_CODE" , 0 , tReason[0])
				end if
		
				if tReason[1] <> NULL and tReason[1] <> "" then
					DATAMANAGER.SetDataValue( 0, "obcsb_acif_712a", "InBlock1", "KYC_REREG_REAS" , 0 , tReason[1])
				end if
			end if 
			
			'-----------------------------
			'개인고객
			'-----------------------------
			If g_CUST_CLS_CODE = "1" Then
				DATAMANAGER.RequestTranData("obcsb_acif_715a_1" )	'취약금융소비자 SVC
			
			'-----------------------------
			'법인고객
			'-----------------------------
			Else
				DATAMANAGER.RequestTranData( "obcsb_acif_712a" )	'투자성향응답 SVC
			End If
		end if
	'21.09.08 JHY END
    End If
End Sub


'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
'	'21.09.07 JHY START (v009)
'	'ISA 가입 신청에서 필요한 내용 shared 값으로 저장,
'	'이미 sendReturnToParent 하는게 있어서 다른 화면 영향 없도록 shared 값으로 필요값 저장하도록 (v009)
'	if g_szRet == "1" then
'		Dim szGrade
'		szGrade = tbl01.GetCellString(0, 1)
'		
'		Form.SetSharedData("mbonl81010_s1_grade" , g_Grade)
'		Form.SetSharedData("mbonl81010_s1_grade_korean" , szGrade)
'	end if
'	'21.09.07 JHY END
	
	Form.SendReturnToParent("TYPECHK_OK", g_szRet)				
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	'21.09.09 JHY START (v009)
	'서브 메세지 없을때 분기 처리 추가
	if szSubMsg == "" or Len(szSubMsg) <= 0 then
		Form.ShowAlert(g_szAlertTitle, szErrMsg)
	else
		Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
	end if
	'21.09.09 JHY END
End Sub


'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if	sEventName	=	"SETTING_ACNTNO"	then
		g_szAccNo	=	sParam
		
		DATAMANAGER.RequestTranData("obcsb_acif_701r")
	elseif	sEventName		=	"SETTING_PASSWD"	then
		g_szPassword	=	sParam
	end if
End Sub

