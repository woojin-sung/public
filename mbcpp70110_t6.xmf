--===========================================================================
--===========================================================================

Dim g_pid
Dim g_stock,g_bond,g_futures,g_currency,g_realestimate,g_deposit,g_etc


'============================================================================
Sub Form_OnFormInitBefore()
	
	g_pid=Form.GetSharedData("Shared_PID", false )

	ChartEx0.SetChartType("pie")
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_004r", "InBlock1", "PRTF_ID", 0 , g_pid)
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_019r", "InBlock1", "PRTF_ID" , 0 , g_pid)	
	
			
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID = "obcpp_rbit_004r" then
	
		g_stock = DATAMANAGER.GetDataValue(0,"obcpp_rbit_004r", "OutBlock1", "STCK_RLIM" , 0)
		g_bond = DATAMANAGER.GetDataValue(0,"obcpp_rbit_004r", "OutBlock1", "BOND_RLIM" , 0)
		g_futures = DATAMANAGER.GetDataValue(0,"obcpp_rbit_004r", "OutBlock1", "FUTS_VOL_RLIM" , 0)
		g_currency = DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "CASH_RLIM", 0)
		g_realestimate = DATAMANAGER.GetDataValue(0,"obcpp_rbit_004r", "OutBlock1", "INP_RLES_RLIM" , 0)
		g_deposit = DATAMANAGER.GetDataValue(0,"obcpp_rbit_004r", "OutBlock1", "INP_IMSI_RLIM" , 0)
		g_etc = DATAMANAGER.GetDataValue(0,"obcpp_rbit_004r", "OutBlock1", "ETC_RLIM" , 0)
		ChartEx0.SetAccrueData("주식;채권;선물;통화;부동산;예금;기타="&g_stock&";"&g_bond&";"&g_futures&";"&g_currency&";"&g_realestimate&";"&g_deposit&";"&g_etc&"=2=top")
	
	end if 

	if szTranID = "obcpp_rbit_019r" then
	
		for i = 0 to Grid0.rowcount-1
		
			temp1 = Grid0.GetCellData("bd_cell1", i)
			Grid0.SetCellData("bd_cell1", i, Change_to_Category(temp1))
		

			temp2 = Grid0.GetCellData("bd_cell2", i)
			Grid0.SetCellData("bd_cell2", i, Cal_grade(temp2))


			temp3 = Grid0.GetCellData("bd_cell3", i)
			Grid0.SetCellData("bd_cell3", i, Change_to_nation(temp3))	
				
			
			
			
			next
		end if 
		
	
	
End Sub

'============================================================================
Function Change_to_Category(code)

	name =""
	if code = "a" then
			name = "주식"
	
	elseif code = "b" then
			name = "채권"
	
	elseif code = "c" then
			name = "선물"
	
	elseif code = "d" then
			name = "통화"
	
	elseif code = "e" then
			name = "부동산"
	
	elseif code = "f" then
			name = "예금"
	
	elseif code = "g" then
		name = "기타"
	
	else
		name = code

	end if

	Change_to_Category = name	

End Function
'============================================================================

Function Change_to_nation(code)

	name =""
	if code = "1" then
			name = "국내"
	
	elseif code = "2" then
			name = "해외"
	
	else
			name = code
	
	end if

	Change_to_nation = name	

End Function

'============================================================================

	Function Cal_grade(grade)
					
			temp=""
			
			if Cint(grade)= 1  then
				temp="초저위험"
			
			elseif Cint(grade)= 2 then
				temp="초저위험+"
					
			elseif Cint(grade)= 3 then
				temp="저위험"
				
			elseif Cint(grade)= 4 then
				temp="저위험+"
				 	
			elseif Cint(grade)= 5 then
				temp="중위험"
					
			elseif Cint(grade)= 6 then
				temp="중위험+"
					
			elseif Cint(grade)= 7 then
				temp="고위험"
				 	
			elseif Cint(grade)= 8 then
				temp="고위험+"
					
			elseif Cint(grade)= 9 then
				temp="초고위험"
					
			elseif Cint(grade)=10 then
				temp="초고위험+"
			
			else  temp=grade
			
		Cal_grade= temp 	
		
			
	end if

End Function 

'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData("obcpp_rbit_004r")
	DATAMANAGER.RequestTranData("obcpp_rbit_019r")

End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	DATAMANAGER.RequestNextData("obcpp_rbit_019r")
	
End Sub

