'============================================================================
Sub Form_OnFormInit()
	Dim szData
	szData = Form.GetOpenLinkData()
	
	If Trim(szData) <> "" Then
		'20240806 HSZ START: 알림톡 링크 추가
		if Instr(szData, "기타★") > 0 then
			szAryData = Split(szData, "★")
			szData = szAryData(2)
		end if
		'20240806 HSZ END
		
		FormTab0.currenttab = szData
	End If
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendMessageToMain("CONFIG_CHANGE", "", "")
End Sub

'============================================================================
Sub Form_OnTriggerEventArs(sEventName, sParam)
			
	if sEventName = "CALLGATE_ARS" then
		if sParam = "0" then
			if FormTab0.currenttab = 0 or FormTab0.currenttab = "0" then
				Form.triggerEvent("FormTab0." & FormTab0.currenttabpageid, "CALLGATE_RETURN", "0")
			end if
			'PENTA13 START => 2019.12.09	GetEnvData 받아서 허용인지 아닌지 여부 받아서 다시 셋팅
			'GetConfigData(g_sViewARSKey, 13, 1)			
		end if
	end if
End Sub

