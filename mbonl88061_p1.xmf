	<SCRIPT_INFO _len="1260" _ulen="1230" >
'============================================================================
' 단기사채 신청내역 상세
'============================================================================

Dim g_tData
Dim g_szCode
Dim g_szData

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()	
	
	If szOpenData <> "" And szOpenData <> null Then
		g_tData = Split(szOpenData, "★")
		
		lblName.caption = g_tData[0]
		
		tbl0.SetCellString(0, 1, g_tData[1])
		tbl0.SetCellString(1, 1, g_tData[2])
		tbl0.SetCellString(2, 1, g_tData[3])
		tbl0.SetCellString(3, 1, g_tData[4])
		tbl0.SetCellString(4, 1, g_tData[5])

		' 20230306 요건 추가!
		tbl0.SetCellString(5, 1, g_tData[6])
		tbl0.SetCellString(6, 1, g_tData[7])
		tbl0.SetCellString(7, 1, g_tData[8])

		tbl0.SetCellString(8, 1, g_tData[9])
		tbl0.SetCellString(9, 1, g_tData[10])
		tbl0.SetCellString(10, 1, g_tData[11])
	End If
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnOK_OnClick()
	Form.CloseForm()
End Sub

