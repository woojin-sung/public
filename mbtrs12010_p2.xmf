'============================================================================
' btnBack_OnClick
'============================================================================
Sub btnBack_OnClick()
	Dim nLen
	nLen = Len(edtQty.caption)

	if nLen <> 0 then
		szQty = Left(edtQty.caption, nLen-1)
		edtQty.caption = szQty
	end if
	
	g_szReceive = ""
End Sub

'============================================================================
' btnClear_OnClick
'============================================================================
Sub btnClear_OnClick()
	edtQty.caption = ""
End Sub

'============================================================================
' btnConfirm_OnClick
'============================================================================
Sub btnConfirm_OnClick()
	SaveHogaOrderQty()	'PENTA13 START => 2024.04.15(호가주문수량저장)
	
	Form.SendReturnToParent("QTY_POPUP", edtQty.caption & "★" & Button0.switchindex)
	Form.CloseForm()
End Sub

