' 20160317 수량 Max : 8 (전요셉과장)

'============================================================================
' 화 면 명 : 주식주문_수량입력창
' 화면설명 : 주식주문 수량입력시
' 작    성 : 2016.02.15 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szAcntTotal, g_szAcntSequn, g_szAcntCdTy
Dim g_szCd, g_szMk, g_szPrc, g_szReceive

Dim g_szMax
g_szMax = "0"

'PENTA13 START => 2024.04.15(호가주문수량저장)
Dim g_switchIdx
g_switchIdx = "0"

Dim g_szGbn
g_szGbn = "0"

Dim g_bSwitchInit
g_bSwitchInit = false
'PENTA13 END
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, szCalc, szUnit, szCut, szData, szChk
	Dim nUnit, nLen, nResult
	
	g_szReceive = ""
	szQty = edtQty.caption

 ' 20160317 예외처리 추가 //////////////////////////////////////////////
	if Trim(szQty) <> "" then
		if CDbl(szQty) >= 99000000 then
			if nGbn == 0 then
				Exit Function
			end if
		end if
	end if
	' //////////////////////////////////////////////////////////////////////
	
	if g_szMk == "W" then
		if Trim(szQty) == "" then
			szQty = 10
		else			
			nUnit = 10
			
			nLen = Len(nUnit)
			
			if nGbn == 0 then
				szQty = CDbl(szQty) + nUnit
				nResult = CDbl(szQty) Mod 10
				
				if nResult <> 0 then
					szQty = CDbl(szQty) - nResult
				end if
			else			
				if CDbl(szQty) == 0 then
					Exit Function
				else
					szQty = szQty - nUnit
					nResult = CDbl(szQty) Mod 10
					
					if nResult <> 0 then
						nResult = 10 - nResult
						szQty = CDbl(szQty) + nResult
					end if
				end if
			end if
		end if
	else
		if Trim(szQty) == "" then
			szQty = 1
		else
			if Len(szQty) = 1 or Len(szQty) = 2 then
				nUnit = 1
			else
				nCnt = Len(szQty)-1
				
				For i = 0 to nCnt-1
					if i == 0 then
						szUnit = "1"
					else
						szUnit = szUnit & "0"
					end if
				Next
				
				nUnit = CDbl(szUnit)
			end if
			
			if nGbn == 0 then
				szQty = CDbl(szQty) + nUnit
				nResult = CDbl(szQty) Mod nUnit
				
				if nResult <> 0 then
					szQty = CDbl(szQty) - nResult
				end if
			elseif nGbn == 1 then
				if CDbl(szQty) == 0 then
					Exit Function
				else		' 20160317 추가사항 적용
					szQty = szQty - nUnit
					nResult = CDbl(szQty) Mod nUnit

					if nResult <> 0 then
						nResult = nUnit - nResult
						szQty = CDbl(szQty) + nResult
					elseif nResult == 0 then
						if Len(nUnit) > 1 then
							szQty = szQty + nUnit
							szCut = Mid(szQty, 1, 1)
							
							if szCut == "1" then
								szChk = Mid(szQty, 2, Len(szQty))

								For i = 0 to Len(szChk)-1
									szData = Mid(szChk, i+1, 1)

									if szData <> "0" then
										szQty = szQty - nUnit
										Exit For
									end if
									
									if i == Len(szChk)-1 then
										nUnit = Left(nUnit, Len(nUnit)-1)
										szQty = szQty - nUnit
									end if
								Next
							else
								szQty = szQty - nUnit
							end if
						end if
					end if
				end if
			end if
		end if
	end if
	
	Sum_Qty(szQty)
End Function

'============================================================================
' Calc_Plus
'============================================================================
Function Calc_Plus(nGbn, nPlus)
	Dim szQty
	
	if g_szReceive == "1" then
		g_szReceive = ""
		edtQty.caption = nPlus
	else
		szQty = edtQty.caption
		
		if nGbn == 1 then
			if Trim(szQty) == "" then
				szQty = 0
			end if
			
			szQty = CDbl(szQty) + nPlus
		else
			szQty = szQty & nPlus
		end if
		
		Sum_Qty(szQty)
	end if
End Function

'============================================================================
' Calc_Zero
'============================================================================
Function Calc_Zero(szPlus)
	Dim szQty
	
	if g_szReceive == "1" then
		g_szReceive = ""
		edtQty.caption = ""
	else	
		szQty = edtQty.caption
		
		if Len(edtQty.caption) > 0 then
			szQty = edtQty.caption & szPlus
			
			Sum_Qty(szQty)
		end if
	end if
End Function

'============================================================================
' Sum_Qty
'============================================================================
Function Sum_Qty(szData)
	'if Len(szData) < 16 then
	if Len(szData) < 9 then		' Max 8(20160317 전요셉과장)
		edtQty.caption = szData
	end if
End Function	

'============================================================================
' Request_Able
'============================================================================
Function Request_Able(nGbn)
	if nGbn == 3 then
		DATAMANAGER.RequestTranData("obtrs_comn_405r")				' 주문가능금액 조회
	else
		if nGbn == 1 then			' 현금가능수량
			g_szMax = "0"
		elseif nGbn == 2 then		' 최대가능수량
			g_szMax = "1"
		end if	
			
		DATAMANAGER.RequestTranData("obtrs_comn_406r")				' 주문가능금액 조회	
	end if
End Function

'============================================================================
' PrdCode : 조회구분코드
' 주문가능수량 obtrs_comn_405r 신용-매도가능수량조회인 경우에만 사용
'============================================================================
Function PrdCode()
	Select Case g_szAcntCdTy
		Case "100", "105", "107", "112","119", "140", "200" '20211207 SWJ START : 중개형ISA 추가	'20230112_01 HWG : SUPER365 추가
		    return "1"
		Case "102", "108"	'저축계좌
		    return "2"
	End Select
End Function

'============================================================================
' Change_ItemCode
'============================================================================
Function Change_ItemCode()
	if Left(g_szCd, 1) = "J" or Left(g_szCd, 1) = "F" then
		return g_szCd
	elseif g_szMk = "J" or g_szMk = "T" then	'주식
		return "A" & g_szCd
	elseif g_szMk = "W" then	'ELW
		return "J" & g_szCd
	else
		return g_szCd
	end if 
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	
	szOpen = Form.GetOpenLinkData()
	
	if szOpen <> "" then
		tData = Split(szOpen, "★")
		
		g_szReceive = "1"
		g_szAcntTotal  = tData(0)
		g_szAcntSequn  = tData(1)
		g_szAcntCdTy   = tData(2)
		g_szCd         = tData(3)
		g_szMk         = tData(4)
		g_szPrc        = tData(5)
		edtQty.caption = tData(6)
		g_szGbn        = tData(7)	'PENTA13 START => 2024.04.15(호가주문수량저장)

	end if
	
'PENTA13 START => 2024.04.15(호가주문수량저장)
	if g_szCd <> null and g_szCd <> "" then
		Button0.visible = true
		Button0.setApplySwitch("OFF", "ON", "294", "200", "270", "249")

		Dim sEnvKey, sItemQty, sSaveItemCode, sSaveQty
		Dim bLoadQty, bFileWrite
		
		bLoadQty = false
		bFileWrite = false
		
		sEnvKey = "hogaord.save_itemqty"
		sItemQty = Form.GetEnvData(sEnvKey)

		if sItemQty <> null and sItemQty <> "" then
			bFileWrite = true
			tData = Split(sItemQty, "★")
			
			if UBOUND(tData) > 0 then
				sSaveItemCode = tData(0)
				sSaveQty      = tData(1)
				sSaveQtyFlag  = tData(2)

				if sSaveItemCode <> null and sSaveItemCode <> "" then
					if g_szCd == sSaveItemCode then
						if sSaveQty <> null and sSaveQty <> "" then
							if CDbl(sSaveQty) >= 0 and sSaveQtyFlag == "1" then
								bLoadQty = true
								
							end if
							
						end if
					end if
				end if
			end if
		end if

		if bFileWrite == true then
			if bLoadQty == true then
				g_bSwitchInit = true

				Button0.switchindex = "1"
				edtQty.caption = sSaveQty

			else
				Button0.switchindex = "0"

			end if

		else
			Button0.switchindex = "0"

		end if

	else
		Button0.visible = false

	end if
'PENTA13 END
End Sub

