'============================================================================
'PENTA13 START => 2024.04.15(호가주문수량저장)
Sub SaveHogaOrderQty()
	if g_szCd == null or g_szCd == "" then
		exit Sub
	end if

	Dim sEnvKey, sValue, sQty, sItemQty
	sEnvKey = "hogaord.save_itemqty"
	sQty = edtQty.caption

	strSwitchIndex = Button0.switchindex

	if strSwitchIndex == "1" then
		if sQty == null or sQty == "" or CDbl(sQty) == 0 then
			sValue = g_szCd & "★" & "0" & "★" & strSwitchIndex

		else
			sValue = g_szCd & "★" & edtQty.caption & "★" & strSwitchIndex

		end if

		Form.SetEnvData(1, sEnvKey, sValue)

	elseif strSwitchIndex == "0" then
		sItemQty = Form.GetEnvData(sEnvKey)

		if sItemQty <> null and sItemQty <> "" then
			sValue = g_szCd & "★" & "0" & "★" & "0"
			Form.SetEnvData(1, sEnvKey, sValue)

		end if
		
	end if
End Sub

'============================================================================
Sub Button0_OnClick()
	if g_bSwitchInit == false then
		strSwitchIndex = Button0.switchindex
	
		if strSwitchIndex == "1" then
			Form.OpenPopup("mbtrs12010_p4", "", "")
		end if
	else
		g_bSwitchInit = false
		
	end if
End Sub
'PENTA13 END

