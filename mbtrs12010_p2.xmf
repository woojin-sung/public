' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szPrCd 

	DATAMANAGER.ClearInputData(0, szTranID)
	
	' 종목코드
	'szCd = Change_ItemCode()

	' ----------------------------------------------------------------------
	' 주문가능금액 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtrs_comn_406r" then
		DATAMANAGER.SetDataValue(0, "obtrs_comn_406r", "InBlock1", "ACNO"				, 0, g_szAcntTotal)		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_406r", "InBlock1", "ASNO"				, 0, g_szAcntSequn)		' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_406r", "InBlock1", "ISCD"				, 0, g_szCd)				' 종목코드
		DATAMANAGER.SetDataValue(0, "obtrs_comn_406r", "InBlock1", "ODER_UNPR"			, 0, g_szPrc)				' 주문가격
		DATAMANAGER.SetDataValue(0, "obtrs_comn_406r", "InBlock1", "ODER_CLS_CODE"		, 0, "01")				' 주문유형
		
'PENTA13 START => 2024.04.15(호가주문수량저장)
		if g_szGbn == "0" then
			DATAMANAGER.SetDataValue(0, "obtrs_comn_406r", "InBlock1", "CRDT_ODER_CLS_CODE", 0, "10")				' 현금(10)
		else
			DATAMANAGER.SetDataValue(0, "obtrs_comn_406r", "InBlock1", "CRDT_ODER_CLS_CODE", 0, "21")				' 신용(21)
		end if
'PENTA13 END
		
		DATAMANAGER.SetDataValue(0, "obtrs_comn_406r", "InBlock1", "ACNT_PWD"			, 0,  "")				' 계좌비밀번호
		DATAMANAGER.SetDataValue(0, "obtrs_comn_406r", "InBlock1", "BABD_YN"				, 0, "N")				' 소액채권 여부
		DATAMANAGER.SetDataValue(0, "obtrs_comn_406r", "InBlock1", "MAX_MIN_CLCD"		, 0, g_szMax)				' 현금(0)/최대(1) 가능수량 구분 ' 20190502 HWG : 현금최대가능수량 구분값 추가
	' ----------------------------------------------------------------------
	' 주문가능수량 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtrs_comn_405r" then
		szPrCd = PrdCode()
		
	    	DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "IQRY_CLS_CODE" 		, 0, szPrCd )				' 조회구분코드
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "ACNO"				, 0, g_szAcntTotal)		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "ASNO"				, 0, g_szAcntSequn)		' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "ISCD"				, 0, g_szCd)				' 종목코드
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "LOAN_DATE"			, 0, "")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "LOAN_SRNO"			, 0, "1")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_405r", "InBlock1", "LOAN_DTL_TYPE_CODE"	, 0, "0101")		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 주문가능금액 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obtrs_comn_406r" then
		g_szReceive = "1"
		
		if g_szMax == "0" then			' 현금
			edtQty.caption = DATAMANAGER.GetDataValue(0, "obtrs_comn_406r", "OutBlock1", "ODER_ABLE_QTY", 0)
		elseif g_szMax == "1" then		' 최대
			edtQty.caption = DATAMANAGER.GetDataValue(0, "obtrs_comn_406r", "OutBlock1", "UNCL_OCRN_ODER_ABLE_QTY", 0)
		end if
	' ----------------------------------------------------------------------
	' 주문가능수량 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtrs_comn_405r" then
		g_szReceive = "1"
		edtQty.caption = DATAMANAGER.GetDataValue(0, "obtrs_comn_405r", "OutBlock1", "ODER_ABLE_QTY", 0)			' 주문가능수량	
	end if
End Sub

