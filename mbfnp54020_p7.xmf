'============================================================================
' 화 면 명 : 선물옵션주문_수량입력창
' 화면설명 : 선물옵션주문 수량입력시
' 작    성 : 2016.02.15 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

Dim g_sIsFirst

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption

	
	if Trim(szQty) == "" then
		szQty = 1
	else
		if Len(szQty) = 1 or Len(szQty) = 2 then
			nUnit = 1
		else
			nCnt = Len(szQty)-1
			
			For i = 0 to nCnt-1
				if i == 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CDbl(szUnit)
		end if
		
		if nGbn == 0 then
			szQty = CDbl(szQty) + nUnit
			nResult = CDbl(szQty) Mod nUnit
			
			if nResult <> 0 then
				szQty = CDbl(szQty) - nResult
			end if
		elseif nGbn == 1 then
			if CDbl(szQty) == 0 then
				Exit Function
			else
				szQty = szQty - nUnit
				nResult = CDbl(szQty) Mod nUnit
				
				if nResult <> 0 then
					nResult = nUnit - nResult
					szQty = CDbl(szQty) + nResult
				end if
			end if
		end if
	end if
	
	Sum_Qty(szQty)
End Function

'============================================================================
' Calc_Plus
'============================================================================
Function Calc_Plus(nGbn, nPlus)
	Dim szQty
	szQty = edtQty.caption
	
	if nGbn == 1 then
		if Trim(szQty) == "" then
			szQty = 0
		end if
		
		szQty = CDbl(szQty) + nPlus
	else
		
		'처음 숫자는 초기화
		if g_sIsFirst == true then
			g_sIsFirst = false
			szQty = nPlus
		else
			szQty = szQty & nPlus
		end if
		
	end if
	
	Sum_Qty(szQty)
End Function

'============================================================================
' Calc_Zero
'============================================================================
Function Calc_Zero(szPlus)
	Dim szQty
	szQty = edtQty.caption
	
	if Len(edtQty.caption) > 0 then
		szQty = edtQty.caption & szPlus
		
		Sum_Qty(szQty)
	end if
End Function

'============================================================================
' Sum_Qty
'============================================================================
Function Sum_Qty(szData)
	if Len(szData) < 16 then
		edtQty.caption = szData
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	
	Form.SetScreenName("수량입력")
	szOpen = Form.GetOpenLinkData()

	if Trim(szOpen) == "" then
		edtqty.caption = ""
	else
		edtqty.caption = szOpen
	end if
	
	g_sIsFirst = true
	
End Sub


'============================================================================
' btnQPlus_OnClick : 수량 + 버튼
'============================================================================
Sub btnQPlus_OnClick()	
	Calc_Qty(0)
End Sub

'============================================================================
' btnQMinus_OnClick : 수량 - 버튼
'============================================================================
Sub btnQMinus_OnClick()
	Calc_Qty(1)
End Sub

