'============================================================================
' 화 면 명 : 해외CFD_주문_예수금팝업
' 화면설명 : 해외CFD_주문_예수금팝업
' 작    성 : 2021.12
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_szAcntPwd, g_szMkGb

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	Dim tData

	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt    = tData(0)
		g_szAcntCd  = tData(1)
		g_szAcntPwd = tData(2)
		g_szMkGb	   = tData(3)

'		if g_szMkGb == "3" then
'			
'			sMask = "0,0,,,0,,4,1,1,2,0"
'			
'			tbl2.SetCellMaskInfo(1, 0, sMask)
'			tbl2.SetCellMaskInfo(3, 0, sMask)
'			tbl2.SetCellMaskInfo(5, 0, sMask)
'			tbl2.SetCellMaskInfo(7, 0, sMask)
'			tbl2.SetCellMaskInfo(9, 0, sMask)
'		end if
		
		'20220524 SWJ START : rmnd_002r, marg_001r 서비스 추가 (항목 변경에 따른)
		DATAMANAGER.RequestTranData("obtre_rmnd_002r")
		DATAMANAGER.RequestTranData("obtre_oder_003r")
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 예수금 조회
	' ----------------------------------------------------------------------	
	if szTranID = "obtre_rmnd_002r" then	 
		
		DATAMANAGER.SetDataValue(0, "obtre_rmnd_002r", "InBlock1", "ACNO", 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtre_rmnd_002r", "InBlock1", "ASNO", 0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obtre_rmnd_002r", "InBlock1", "ACNT_PWD", 0 , g_szAcntPwd)
		DATAMANAGER.SetDataValue(0, "obtre_rmnd_002r", "InBlock1", "STND_DATE", 0 , Form.GetSharedData("&HOST_DATE", false ))
		DATAMANAGER.SetDataValue(0, "obtre_rmnd_002r", "InBlock1", "IQRY_CLS_CODE", 0 , "1")
	
	ElseIf szTranID == "obtre_marg_001r" Then
		DATAMANAGER.SetDataValue(0, "obtre_marg_001r", "InBlock1", "ACNO", 0 , g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtre_marg_001r", "InBlock1", "ASNO", 0 , g_szAcntCd)
		
	ElseIf szTranID == "obtre_oder_003r" Then
		DATAMANAGER.SetDataValue(0, "obtre_oder_003r", "InBlock1", "ACNO", 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtre_oder_003r", "InBlock1", "ASNO", 0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obtre_oder_003r", "InBlock1", "ACNT_PWD", 0 , g_szAcntPwd)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtre_oder_003r" then	 
		
		szNation = DATAMANAGER.GetDataValue(0, "obtre_oder_003r", "OutBlock1", "CTCD" , 0)

		if szNation == "392" then
			sMask = "0,0,,,0,,4,1,1,2,0"
			Label5.mask = sMask
		end if
	
	'20220523 SWJ START : 예수금 항목 변경, 마진콜 여유금액 추가
	elseif szTranID == "obtre_rmnd_002r" then
		DATAMANAGER.RequestTranData("obtre_marg_001r")
		
	ElseIf szTranID == "obtre_marg_001r" then
		szRiskRate = GetRiskRate()
		
		Label6.caption = szRiskRate
		
		'마진콜여유금액 
		Dim nAcntVltnAmt, nMntnMarg, nAmt '계좌평가금액, 유지증거금
		nAcntVltnAmt = tonumber(tbl0.GetCellString(2, 1))
		nMntnMarg = tonumber(tbl1.GetCellString(2, 1))
		
		nAmt = nAcntVltnAmt - nMntnMarg	'마진콜여유금액
		If nAmt < 0 Then
			nAmt = 0
		End If
		tbl1.SetCellString(2, 2, nAmt)
	end if
	'20220523 SWJ END
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
'	if Trim(szSubMsg) <> "" then
'		Form.Toast(1, szErrMsg & "(" & szSubMsg & ")", true)	
'	else
'		Form.Toast(1, szErrMsg, true)
'	end if
End Sub

'============================================================================
' imgClose_OnClick : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnClose_OnClick : 닫기
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
'계좌증거금율에 따른 위험도 구하기
'============================================================================
Function GetRiskRate()
	Dim szRiskRate
	
	'20220623 SWJ START : 그냥 2자리 절사 처리로 변경
	'계좌증거금율 		
	acnt_mgrt = Fix(Cdbl(tbl2.GetCellString(2, 3))*100) * 0.0001
	
	Label6.fgcolor = "4"
	
    '증거금율 0일때 또는 계좌증거금율 100% 이상일때 -> 위험도 "0%"
    If acnt_mgrt = 0 or acnt_mgrt > 1 Then
	    szRiskRate = 0
	    return szRiskRate
	End If
	
	'위험도(%) 계산
    risk_rt = (1 - acnt_mgrt ) * 100
    
    ' 0 보다 작을때 위험도 "0 %" 표기
    If risk_rt < 0 Then
	    szRiskRate = 0	    
	' 100 보다 클때 위험도 "100 %" 표기
	ElseIf risk_rt >= 100 Then
	    szRiskRate = 100
	Else
	    szRiskRate = Cdbl(risk_rt)
	End If
	
    ' 40보다 클때  위험도 붉은색 처리
    If risk_rt > 40 Then ' V002 60%->40%
	    Label6.fgcolor = "1"
	End If
	
	return szRiskRate
End Function



