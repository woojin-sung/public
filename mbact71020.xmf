'============================================================================
' 01. 화 면 명 : 미수금조회
' 02. 화면설명 : 미수금조회
' 03. 작    성 : 2016.4.30 하원만
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAcNo		    '계좌번호 8자리
Dim g_nAsNo	         '계좌 일련번호 2자리

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
Function TR_Inquiry(g_nAcNo, g_nAsNo)

	DATAMANAGER.SetDataValue( 0, "obrtp_uncl_007r", "InBlock1", "ACNO", 0, g_nAcNo )	
	DATAMANAGER.SetDataValue( 0, "obrtp_uncl_007r", "InBlock1", "ASNO", 0, g_nAsNo )
	DATAMANAGER.RequestTranData("obrtp_uncl_007r")

End Function

'============================================================================
Sub Form_OnFormInit()

	g_nAcNo = cmbAcnt.total    'Left( cmbAcnt.caption, 8)
	g_nAsNo = cmbAcnt.sequence 'Right( cmbAcnt.caption, 2)

	'폼 초기화
	Call Output_Data_Clear()
	'최초 조회 수행
	Call TR_Inquiry(g_nAcNo, g_nAsNo)

End Sub

'============================================================================
Sub btnSearch_OnClick()

	g_nAcNo = cmbAcnt.total    'Left( cmbAcnt.caption, 8)
	g_nAsNo = cmbAcnt.sequence 'Right( cmbAcnt.caption, 2)

	call TR_Inquiry(g_nAcNo, g_nAsNo)

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obrtp_uncl_007r" then

		Dim iCnt, iDataCount, sCode, sCodeName
		iDataCount = DATAMANAGER.GetDataCount( 0, "obrtp_uncl_007r", "OutBlock1" )

		For iCnt = 0 To iDataCount - 1

			sCode = DATAMANAGER.GetDataValue( 0, "obrtp_uncl_007r", "OutBlock1", "UNCL_TYPE_CODE", iCnt )
			sCodeName = Form.GetMetaData( "미수유형코드", sCode )
			grdList.SetCellData( "bd_cell0", ( (grdList.rowcount - iDataCount) + iCnt), sCodeName )

		Next
		
		Dim nCashUnAm, nintNtpdAmt, nEtcLndnAmt, nEtcUnam
		nCashUnAm   = DATAMANAGER.GetDataValue( 0, "obrtp_uncl_007r", "OutBlock2", "CASH_UNAM", 0 )  '현금미수
		nintNtpdAmt = DATAMANAGER.GetDataValue( 0, "obrtp_uncl_007r", "OutBlock2", "LOAN_INT_NTPD_AMT", 0 )  '대출이자미납금
		nEtcLndnAmt = DATAMANAGER.GetDataValue( 0, "obrtp_uncl_007r", "OutBlock2", "ETC_LNDN_AMT", 0 )  '기타대여금
		nEtcUnam    = DATAMANAGER.GetDataValue( 0, "obrtp_uncl_007r", "OutBlock2", "ETC_UNAM", 0 )  '기타미수금

		tblSub.SetCellString(0, 1,  (nCashUnAm + nintNtpdAmt + nEtcLndnAmt + nEtcUnam) )
		
	end if

End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	
	DATAMANAGER.RequestNextData( "obrtp_uncl_007r" )
	
End Sub

'============================================================================
'출력 Data 초기화
Sub Output_Data_Clear()
    '그리드 초기화
	grdList.ClearAllData( )
	grdList.DeleteAllRow( )
	
	tblSub.SetCellString(0, 1, "") '현금미수금
	tblSub.SetCellString(0, 3, "") '변재소요금액
	tblSub.SetCellString(1, 1, "") '연체료합계
	tblSub.SetCellString(1, 3, "") '미수동결지정
End Sub

'============================================================================
Sub cmbUnclTypeCode_OnEditComplete(iIndex)
	
	Call Output_Data_Clear()
	Call TR_Inquiry(g_nAcNo, g_nAsNo)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	'Form.ShowAlert(sTitle, szErrMsg)

End Sub

'============================================================================
Sub Form_OnRefresh()
	
	btnSearch_OnClick()
	
End Sub

'============================================================================
Sub cmbAcnt_ChangeAccount()
	
	btnSearch_OnClick()
	
End Sub

