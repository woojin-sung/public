	<SCRIPT_INFO _len="2498" _ulen="2128" >


'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("펀드비교")
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		Dim tTemp, tData
		'비교펀드1, 2를 나누는 구분자 ☆
		tTemp = Split(szOpenData, "☆")
		If UBound(tTemp) > 0 Then
			'펀드 구성요소를 나누는 구분자 ★
			'첫번째 비교펀드 세팅
			tData = Split(tTemp[0], "★")
			If UBound(tData) > 0 Then
				For i = 0 To UBound(tData) - 1
					'테이블 멀티라인이 직접입력이 아니면 안되서 2줄 이상으로 나오는 항목들은 Label로 처리
					If i <= 10 Then
						If i == 0 Then
							contMain.lblName1.caption = tData[i]		'펀드명
						ElseIf i == 2 Then
							contMain.lblType1.caption = tData[i]		'펀드유형
						ElseIf i == 8 Then
							contMain.lblFee1.caption = REPLACE(tData[i], ",", "\n")		'환매수수료
						Else
							contMain.tblData.SetCellString(i, 1, tData[i])	'그 외 테이블에 세팅
						End If
					Else
						contMain.tblData.SetCellString(i, 2, tData[i])
					End If
					
					'가입방법 세팅
					If i == 9 Then
						If tData[i] == "1" Then
							contMain.tblData.SetCellString(i, 1, "오프라인")
						ElseIf tData[i] == "2" Then
							contMain.tblData.SetCellString(i, 1, "온라인")
						End If
					End If
				Next
				tData = ""
			End If
			
			'두번째 비교펀드 세팅
			tData = Split(tTemp[1], "★")
			If UBound(tData) > 0 Then
				For i = 0 To UBound(tData) - 1
					'테이블 멀티라인이 직접입력이 아니면 안되서 2줄 이상으로 나오는 항목들은 Label로 처리
					If i <= 10 Then
						If i == 0 Then
							contMain.lblName2.caption = tData[i]		'펀드명
						ElseIf i == 2 Then
							contMain.lblType2.caption = tData[i]		'펀드유형
						ElseIf i == 8 Then
							contMain.lblFee2.caption = REPLACE(tData[i], ",", "\n")		'환매수수료
						Else
							contMain.tblData.SetCellString(i, 3, tData[i])	'그 외 테이블에 세팅
						End If
					Else
						contMain.tblData.SetCellString(i, 4, tData[i])
					End If
					
					'가입방법 세팅
					If i == 9 Then
						If tData[i] == "1" Then
							contMain.tblData.SetCellString(i, 3, "오프라인")
						ElseIf tData[i] == "2" Then
							contMain.tblData.SetCellString(i, 3, "온라인")
						End If
					End If
				Next
				tData = ""
			End If
		End If
	End If
End Sub

	</SCRIPT_INFO>
