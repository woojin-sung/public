        lblMove.visible = "0"
        lblMyAcntLine.visible = "1"
        lblTotal.visible = "0"
	
	End If
End Sub

'============================================================================
Function f_CheckNotice()
     
    saveDate = Form.LoadConfigData("NoticeSetting", "notice_simpletrans")
    todayDate = Form.GetSharedData("&HOST_DATE", false )
	
    If saveDate <> "" Then
    
        ResaveDate  = Left(saveDate,4) &"-"&Mid(saveDate,5,2) &"-"&Right(saveDate,2)
        RetodayDate = Left(todayDate,4)&"-"&Mid(todayDate,5,2)&"-"&Right(todayDate,2)
		
        calcDate = tonumber(DateDiff("d", ResaveDate, RetodayDate))

        If calcDate <= 7 Then
            Return True
        Else
            Return False
        End If
    End If
    
    Return False
    
End Function

