Sub f_SetRecieveText()

    imgLogo.imgpath = "bank"..g_szBankCode..".png"
    edtRecAcno.caption = g_szBankAcno
    lblBankName.caption = g_szBankName
    lblRecName.caption = g_szBankAcntNm
    
End Sub

