'============================================================================
Sub grdRecent_OnClickUp(lRow, szCellID) '최근계좌 그리드 선택
    
    Form.SetSharedData("MNRC_ACNT_SLCT_CLS" , "2") 'JWH 20240124 2.최근계좌 선택
    
    If szCellID == "bd_del_aos" Or szCellID == "bd_del_ios" Or szCellID == "bd_del1" Or szCellID == "bd_del2" Then
        g_recentIndex = Cint(lRow)
        DATAMANAGER.RequestTranData("obrtp_tran_011a")
        Exit Sub
    End If
    
    szBankCode = grdRecent.GetCellData("bd_code", lRow)
    szBankAcno = grdRecent.GetCellData("bd_acno", lRow)
    szBankName = grdRecent.GetCellData("bd_bankname", lRow)
	
    szData = szBankCode..g_szSeparator..szBankAcno..g_szSeparator..szBankName
	
    f_SetTransInfoItem(szData, g_nTranIndex)
    f_RequestAcntVerify(szData)

End Sub

'============================================================================
Sub grdRecent_OnDeleteRow(lRow) '최근외화이체 삭제
    g_recentIndex = Cint(lRow)
    DATAMANAGER.RequestTranData("obrtp_tran_011a")
End Sub

'============================================================================ 
Sub grdOften_OnClickUp(lRow, szCellID) ' 자주 쓰는계좌 그리드 선택	

    Form.SetSharedData("MNRC_ACNT_SLCT_CLS" , "3") 'JWH 20240124 3.자주쓰는계좌 선택

    g_oftenIndex = CInt(lRow)

    If szCellID == "bd_edit" Or szCellID == "bd_edit1" Then '별명 수정
        g_curAlias = "OFTEN"
        szAlias = grdOften.GetCellData("bd_alias", lRow)
        Form.OpenPopupAnimation("textkeypadpopup", "계좌별명☆"..szAlias.."☆최대 10글자 입력 가능☆1☆20" , "","2")
        Exit Sub
    End If
    
    szBankCode = grdOften.GetCellData("bd_code"     , lRow)
    szBankAcno = grdOften.GetCellData("bd_acno"     , lRow)
    szBankName = grdOften.GetCellData("bd_bankname" , lRow)
		
    szData = szBankCode..g_szSeparator..szBankAcno..g_szSeparator..szBankName
		
    f_SetTransInfoItem(szData, g_nTranIndex)
    f_RequestAcntVerify(szData)
    
End Sub

