    If CInt(grdOften.rowcount) > 1 Then
		DATAMANAGER.RequestTranData("obrtp_tact_005a") 
    End If
End Sub

'============================================================================
Sub grdOften_OnDeleteRow(lRow)
    g_oftenIndex = Cint(lRow)
    DATAMANAGER.RequestTranData("obrtp_tact_101a_2") '삭제
End Sub

'============================================================================
Sub grdMyAcnt_OnClickUp(lRow, szCellID) '내 계좌 그리드 선택

    Form.SetSharedData("MNRC_ACNT_SLCT_CLS" , "4") 'JWH 20240124 4.내계좌 선택
    
    g_nMyIndex = CInt(lRow)

    'If CInt(rdoMyAcnt.currentindex) == 1 And (szCellID == "bd_edit" Or szCellID == "bd_edit1") Then '내계좌 > 타금융 별명 수정
    If (szCellID == "bd_edit" Or szCellID == "bd_edit1") Then '내계좌 > 타금융 별명 수정
        g_curAlias = "MY"
        szAlias = grdMyAcnt.GetCellData("bd_alias", lRow)
        Form.OpenPopupAnimation("textkeypadpopup", "계좌별명☆"..szAlias.."☆최대 10글자 입력 가능☆1☆20" , "","2")
        Exit Sub
    End If
	
    If CInt(rdoMyAcnt.currentindex) == 0 Then '메리츠증권
        szBankCode = "287"
        szBankAcno = grdMyAcnt.GetCellData("bd_acno" , lRow)..grdMyAcnt.GetCellData("bd_asno" , lRow)
        szBankName = "메리츠증권"
    Else
        szBankCode = grdMyAcnt.GetCellData("bd_code"     , lRow)
        szBankAcno = grdMyAcnt.GetCellData("bd_acno"     , lRow)
        szBankName = grdMyAcnt.GetCellData("bd_bankname" , lRow)
    End If
	    
    szData = szBankCode..g_szSeparator..szBankAcno..g_szSeparator..szBankName
		
    f_SetTransInfoItem(szData, g_nTranIndex)
    f_RequestAcntVerify(szData)
    
End Sub

