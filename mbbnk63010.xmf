'============================================================================
Sub Form_OnLinkData(sKey, sValue)

    If sKey == "mbbnk63010_Account_Change" Then
    
        nIndex = acntList.GetIndexByAccountInfo(sValue)
        acntList.currentindex = nIndex
	
    ElseIf sKey == "&LOGIN_AUTH" Then
        
        If sValue == "0" Or sValue == "1" Then
            Form.TriggerEvent("#", "Close_Parent", "") ' 20251101 KSJ 간편모드 개발 화면닫기
        End If
	
    ElseIf sKey == "mbbnk63010setDrngAcnt" Then

        nIndex = acntList.GetIndexByAccountInfo(sValue)
        acntList.currentindex = nIndex	
    
    End If
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)    
    If sKeyName == "ACNT_NO_CLOSE" Then
        If sRet == "close" Or sRet == "cancel" Then
            Form.TriggerEvent("#", "Close_Parent", "") ' 20251101 KSJ 간편모드 개발 화면닫기
        End If    
    End If	
    
End Sub

