'===========================================================================
' 작성 : 2022.08
' 수정 : 장원혁 2023.10.05 v001 IOS 클립보드 내 "\" 문자 삭제 추가
'        신지환 2024.01.22 v002 자주쓰는계좌 등록 안 된 경우 바로가기 버튼 추가 (개인&법인) / 타금융 내계좌 등록 안된 경우 바로가기 버튼 추가 (개인)
' 	    성우진 2024.11.08 유량 제어 솔루션 도입
'               FormInit에서 Begin, mbbnk63010_s2(얼마를 보내세요?) 화면 띄울 때 End 처리
'               mbbnk63010_s2 화면을 띄우지 않은 채 화면을 닫으면 End 처리
'               유량 제어 솔루션이 20~30초 이후 유량 제어 클리어 됨을 고려하여
'               Begin End 처리 함
'===========================================================================

Dim g_szSeparator
Dim g_szCustNo '고객번호
Dim g_szUserID '고객아이디
Dim g_szUserNm '고객명
Dim g_szTRPass '이용기기지정필요여부(Y일 때 팝업 필요)
Dim g_OSType
Dim g_SDKVer
Dim g_Appver 'v001

Dim g_szBankCode
Dim g_szBankName
Dim g_szBankAcno
Dim g_szBankAcntNm

Dim g_szLNKD_BANK_CLS_CODE 
Dim g_szTR_DATE            
Dim g_szOTSD_TR_UNIQ_NO    
Dim g_szTACT_LNKD_ISTU_CODE
Dim g_szTACT_STND_TR_CODE  
Dim g_szLNKD_TLMS_MNNO     
Dim g_szRcvn_iqry_tmnu     

Dim g_recentIndex
Dim g_oftenIndex
Dim g_nMyIndex

Dim g_nTranIndex
Dim g_szTransInfo1
Dim g_szTransInfo2
Dim g_szTransInfo3
Dim g_szTransInfo4
Dim g_szTransInfo5

Dim g_curAlias
Dim g_szAlias
Dim g_szCertUserType

Dim g_AllResetCnt '화면리셋 여러번 되지 않게 방지

Dim g_ExKey
Dim g_CurrKey
Dim g_ClipBoard
Dim g_AcntCopyPopupYN

Dim g_CopyAcnt
Dim g_CopyBankCode
Dim g_CopyBankName

Dim g_szCUST_CLS_CODE 'JWH 20240201

'20241108 SWJ START => 유량제어 액션아이디
Dim g_sActionID
g_sActionID = "BNK_TACT"

'END가 찍혔는지 확인하는 플래그
'END가 이미 찍혔으면 "END" 함수를 또 호출하지 않는다.
Dim g_bFlowFlag
g_bFlowFlag = False

Dim g_szData
g_szData = ""
'20241108 SWJ END

'20250902 YSH START
Dim g_sPrevScreen
g_sPrevScreen = ""
'20250902 YSH END

'============================================================================
Sub Form_OnFormInitBefore()
    grdRecent.setMaintainingRatio( "bd_logo" , 0, "1")
    grdRecent.rowmove = "3"	'좌 드래그
    grdRecent.setDragImage("edit_guide_02.png")
    grdOften.setDragImageOption(False , 0)
    
    grdOften.setMaintainingRatio( "bd_logo" , 0, "1")
    grdOften.setMaintainingRatio( "bd_edit" , 0, "1")
    grdOften.setMaintainingRatio( "bd_edit1" , 0, "1")
    
    grdOften.SetUseLoadFast(True)        '이미지세팅 속도 개선
    grdOften.SetUseNewDragMotion(True)   '드래그 끊김방지
    grdOften.changeDragStartOffset(True) '드래그 시작위치 조정
    grdOften.changeDragScrollSpeed(8)    '드래그 속도
    
    grdOften.rowmove = "2"	'2.상하 + 좌 드래그 | 3.좌드래그
    grdOften.setDragImage("edit_guide_01.png")
    grdOften.setDragImageOption(True , 0)
    
    grdMyAcnt.setMaintainingRatio( "bd_logo" , 0, "1")
    grdMyAcnt.setMaintainingRatio( "bd_edit" , 0, "1")
    
    imgLogo.setMaintainingRatio("1")
    imgBack.setMaintainingRatio("1")
    imgInfo.setMaintainingRatio("1")
    contDirectTrans.imgBgAcpt.setMaintainingRatio("1")
    
End Sub
'====================================================================================================================
'20241108 SWJ START
'유량제어 대기 완료 처리
'====================================================================================================================
Sub Form_onTriggerEventNetfunnel(sEventName, sParam)
	
	if sEventName == "BEGIN" then
		
		'-------------------------------------------------------------------
		'[대기 중지하기]가 아닐 시 FormInit에 있던 동작처리 이어서 진행
		'(FormInit 동작 일부 옮겨옴, UI 관련 세팅 있는 부분은 FormInit에 남김)
		'-------------------------------------------------------------------
		if sParam <> "isStop" then
		    
		    DATAMANAGER.RequestTranData("obrtp_tran_032r")
		    DATAMANAGER.RequestTranData("obrtp_tact_102r")
		    DATAMANAGER.RequestTranData("obacp_comm_062r")
			
		    DATAMANAGER.RequestTranData("obcsb_oimf_638r")
			
		    tabAcnt_OnTabChanged(0)	'최근이체탭으로.. 그래야 최근이체 삭제도 하고.. 셋팅도
		    
		    szData = Form.GetOpenLinkData()
			
		    If szData <> "" And szData <> Null Then
			    
			If Len(Trim(szData)) == 10 Then
			    nIndex = acntList.GetIndexByAccountInfo(Trim(szData))
			    acntList.currentindex = nIndex    
			'20250902 YSH START
			Elseif InStr(szData, "nrsbonl83310_p30") > 0 Then
				g_sPrevScreen = "nrsbonl83310_p30"
			'20250902 YSH END
			End If
			
		    End If
			
		    Form.SetTimerEvent(4444, 1, 1)	
		
		else
		
			Form.TriggerEvent("#", "Close_Parent", "") ' 20251101 KSJ 간편모드 개발 화면닫기
		end if
	
	elseif sEventName == "END" then
		
		if g_bFlowFlag then
			Form.OpenPopup("mbbnk63010_s2", g_szData , "")
		end if
		
	end if
	
End Sub
'====================================================================================================================
'20241108 SWJ END
'====================================================================================================================
Sub Form_OnFormInit()
	
	'20241108 SWJ START => 유량제어 액션아이디
	': 유량제어 서버 테스트/운영 구분 없음. ActionID 최대 20개만 생성 가능.
	': 운영쪽이랑 동일한 액션아이디 사용 시 불필요하게 대기창 뜰 수 있음. 테스트는 테스트용 액션아이디로 적용
	sServerMode = Form.GetSharedData("&SERVER_MODE", false)
	
	If sServerMode == "1" Then	'개발기
		g_sActionID = "act_2"
	end if
	
	': 대기 필요없을 시 or 대기 완료 시  Success   (대기 필요 시 메인에서 대기창 뜸 )
	Form.requestNetfunnel("BEGIN", g_sActionID, 0)
	'20241108 SWJ END
	
	Form.removeWaitCursor()
    
	contDirectTrans.top = "60"
	contDirectTrans.imgBgAcpt.top = "0"
		    
	If Trim(acntList.total) == "" Then
		Form.MsgBox( "알림", "출금계좌가 없습니다.", "ACNT_NO_CLOSE", 0 )
		Exit Sub
	End If
		    
	szCertID = Form.GetSharedData("&USER_ID", False )
	Form.SetSharedData("CERT_ID" , szCertID )
		    
	g_OSType = Form.GetSharedData("&OS_TYPE", False )
	g_SDKVer = Form.GetSharedData("&SDK_VERSION", False)
		    
	szAppVer = Form.GetSharedData("&APP_VERSION", False) 'v001
	szData = Split(szAppVer, ".")                        'v001
	szAppVer = szData(0) & szData(1) & szData(2)         'v001
		    
	If Trim(szAppVer) == "" Then
		szAppVer = 0 'v001
	End If
		    
	g_Appver = Cdbl(szAppVer) 'v001
		    
	If g_OSType == "1" Then '안드로이드
		grdOften.SetVisibleCol(4, "0")
		grdRecent.SetVisibleCol(6, "0")
	Else
		grdOften.SetVisibleCol(3, "0")
		grdRecent.SetVisibleCol(5, "0")
	End If    
		
	g_AllResetCnt = 0
		
	g_szCustNo = Form.GetSharedData("&CUST_NUM"  , False ) '고객번호
	g_szUserID = Form.GetSharedData("&USER_ID"   , False) '고객아이디
	g_szUserNm = Form.GetSharedData("&USER_NAME" , False) '고객명
	g_szCertUserType = ""
			
	f_InitValue()
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

    If sEventName == "INFO_CLICK" Then
        Form.OpenPopup("mbbnk63010_p11" , "" , "")
    End If
	
    If sEventName == "AccountChange" Then
        acntList.caption = sParam
    End If
    
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
    Form.removeWaitCursor()

    If sKeyName == "mbbnk63010_p3" Then
    
		arrBankInfo = Split(sRet, g_szSeparator)
		g_szBankCode = arrBankInfo(0)
		g_szBankAcno = arrBankInfo(1)
		g_szBankName = arrBankInfo(2)
		g_szBankAcntNm = arrBankInfo(3)
			
		f_SetTransInfoItem(sRet, g_nTranIndex)
		
		szData = g_nTranIndex.."♥"..
		g_szTransInfo1.."♥"..
		g_szTransInfo2.."♥"..
		g_szTransInfo3.."♥"..
		g_szTransInfo4.."♥"..
		g_szTransInfo5
				
		g_AllResetCnt = 0
        
	    '20241108 SWJ START
        '유량제어 서비스 및 화면 호출 완료 시, 요청해놨던거 해지 처리 필요
		g_bFlowFlag  = True
		
		Form.requestNetfunnel("END", g_sActionID, 0)
		
		g_szData = szData
		
		'Form.OpenPopup("mbbnk63010_s2", szData , "")
	    '20241108 SWJ END

    ElseIf sKeyName == "mbbnk63010_s2" Then
        If sRet == "AllReset" Then

            If g_AllResetCnt > 0 Then
                Exit Sub
            End If
		    
            tabAcnt.currenttab = 0
            grdRecent.visible = "1"
            grdOften.visible = "0"
            grdMyAcnt.visible = "0"
            rdoMyAcnt.visible = "0"
            lblMyAcntLine.visible = "0"
            lblGuide1.visible = "0" 'v002
		   lblGuide2.visible = "0"
		   lblMove.visible = "0"
            lblTotal.visible = "1"
            lblTotal.caption = grdRecent.rowcount.."개의 최근 이체 내역이 있어요."
		    
            Form.removeWaitCursor()
		    
            g_AllResetCnt = g_AllResetCnt + 1
		
            Form.GetSharedData("63010_ACNT_INFO" , true)
            f_InitValue()
            DATAMANAGER.RequestTranData( "obrtp_tran_032r" )
            DATAMANAGER.RequestTranData( "obrtp_tact_002r" )
            DATAMANAGER.RequestTranData( "obcsb_oimf_638r" )
	    
            grdMyAcnt.SetClear()
	   
            If CInt(rdoMyAcnt.currentindex) == 0 Then '메리츠증권
                DATAMANAGER.RequestTranData("obacp_comm_062r")
            Else
                DATAMANAGER.RequestTranData("obacp_comm_063r")
            End If
			
            contDirectTrans.visible = "0"
            contDirectTrans.lblCnt.caption = ""
			
            f_SetRecieveText()
            f_SetRecieveScreen("0", "")
			
        ElseIf sRet == "AllClose" Then
            Form.TriggerEvent("#", "Close_Parent", "") ' 20251101 KSJ 간편모드 개발 화면닫기
        End If
	
    ElseIf sKeyName == "mbbnk63010_s2_AddTrans" Then
        If sRet <> "" And sRet <> Null Then
            arrTransInfo = Split(sRet, "♥")
            g_nTranIndex = CInt(arrTransInfo(0))
            g_szTransInfo1 = arrTransInfo(1)
            g_szTransInfo2 = arrTransInfo(2)
            g_szTransInfo3 = arrTransInfo(3)
            g_szTransInfo4 = arrTransInfo(4)
            g_szTransInfo5 = arrTransInfo(5)

            contDirectTrans.visible = "1"
            If g_nTranIndex == 1 Then
                contDirectTrans.imgBgAcpt.imgpath = "icon_tact_acpt_1.png"
            ElseIf g_nTranIndex == 2 Then
                contDirectTrans.imgBgAcpt.imgpath = "icon_tact_acpt_2.png"
            ElseIf g_nTranIndex == 3 Then
                contDirectTrans.imgBgAcpt.imgpath = "icon_tact_acpt_3.png"
            ElseIf g_nTranIndex == 4 Then
                contDirectTrans.imgBgAcpt.imgpath = "icon_tact_acpt_4.png"
            End If

            Form.SetSharedData("&BACK_PRESS_ENABLE" , "N") '안드로이드 뒤로가기 동작 비활성화
			
            g_nTranIndex = g_nTranIndex + 1
            g_szBankCode = "287"
            g_szBankName = "메리츠증권"
            g_szBankAcno = ""
            g_szBankAcntNm = ""
			
        End If
	
    ElseIf sKeyName == "POPUP_TEXT" Then
    
        g_szAlias = sRet

        If g_curAlias = "OFTEN" Then
            DATAMANAGER.RequestTranData("obrtp_tact_101a")
        ElseIf g_curAlias = "MY" Then
		If CInt(rdoMyAcnt.currentindex) == 0 Then '메리츠증권
			DATAMANAGER.RequestTranData("obaci_acct_021u")
		Else
			DATAMANAGER.RequestTranData("obrtp_tact_101a_3") '타금융내계좌 별명 변경
		End If
        End If
		
    ElseIf sKeyName == "SIMPLE_SUCCESS" Then
	
        If sRet == "N" Then '간편이체 약정을 맺지 못하고 p2 팝업을 닫음
            Form.TriggerEvent("#", "Close_Parent", "") ' 20251101 KSJ 간편모드 개발 화면닫기
        End If
	    
    ElseIf sKeyName == "TERM_REG_SUCC" Then '단말지정팝업에서 돌아온 경우
	
        If sRet == "N" Then '단말지정하지 못하고 p0 팝업을 닫음
            Form.TriggerEvent("#", "Close_Parent", "") ' 20251101 KSJ 간편모드 개발 화면닫기
        End If
	
    ElseIf sKeyName == "mbbnk63010_s2_STPL_FAIL" Then '이체_전체팝업에서 출금계좌를 변경했을 때 입금 계좌와 약정이 되어 있지 않은 경우
        If sRet <> NULL Then
            szAcno = sRet
            DATAMANAGER.RequestTranData("obacp_comm_063r") '타금융내계좌 재호출
        End If

    ElseIf sKeyName == "mbbnk61140_fin" Then
    
        DATAMANAGER.RequestTranData("obrtp_tran_032r")
        DATAMANAGER.RequestTranData("obrtp_tact_102r")
	
        grdMyAcnt.SetClear()
        If rdoMyAcnt.currentindex == "0" Or CInt(rdoMyAcnt.currentindex) == 0 Then '메리츠증권
            DATAMANAGER.RequestTranData("obacp_comm_062r")
        Else
            DATAMANAGER.RequestTranData("obacp_comm_063r")
        End If	
    
    End If
	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
     
    If Trim(sTimerID) == "1" Then '수취조회
    
        Form.SetTimerEvent2(1,0,0)
        DATAMANAGER.RequestTranData( "obtss_elbs_221r" )
		
    ElseIf Trim(sTimerID) == "9999" Then 'remove
    
        Form.removeWaitCursor()
        Form.SetTimerEvent(9999,0,1)
		
    ElseIf Trim(sTimerID) == "4444" Then
       
        Form.SetTimerEvent(4444, 0, 1)
	
        If g_AcntCopyPopupYN == "0" Then
	
            If g_OSTYpe == "1" Then '안드로이드
		
                'LoadConfigData : 직전 계좌붙여넣기 했던 데이터의 키값
                g_ExKey = Form.LoadConfigData("Banking_ClipBoard", "ClipBoardKey")
                g_CurrKey = Form.getClipboardKey()
	
                If Cstr(g_ExKey) <> Cstr(g_CurrKey) Then
                    g_ClipBoard = Form.getClipboardText()
                    DATAMANAGER.SetDataValue(0, "obrtp_tact_010r" , "InBlock1" , "INPUT_CNTT" , 0 , Trim(g_ClipBoard))
                    DATAMANAGER.RequestTranData("obrtp_tact_010r")
                End If	       
	    
            ElseIf g_OSTYpe == "2" Then 'IOS
	    
                'LoadConfigData : 직전 계좌붙여넣기 했던 데이터의 키값
                g_ExKey = Form.LoadConfigData("Banking_ClipBoard", "ClipBoardKey")
                g_CurrKey = Form.getClipboardKey()
	
                If Cstr(g_ExKey) <> Cstr(g_CurrKey) Then
		
                    If Cdbl(g_Appver) >= 2534 Then 
                        '2023.10.12 이후 이 함수만 남겨놓고 Else문은 지울것 (어차피앱 강제업데이트할 예정임. 2023.10.05 JWH)
                        g_ClipBoard = Form.getClipboardTextWithOutWonSign() 'v001
                    Else
                        g_ClipBoard = Form.getClipboardText()
                    End If		
                    
                    DATAMANAGER.SetDataValue(0, "obrtp_tact_010r" , "InBlock1" , "INPUT_CNTT" , 0 , Trim(g_ClipBoard))
                    DATAMANAGER.RequestTranData("obrtp_tact_010r")
		    
                End If	    
	    
            End If

	    End If
		
	End If

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

    szACNO = acntList.total
    szASNO = acntList.sequence

    If szTranID == "obcsb_oimf_638r" Then '전자금융사기예방 고객조회
    
        szUserId = Trim(Form.GetSharedData("&USER_ID", False ))	'사용자ID	
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ELFN_ID"          , 0 , szUserId          ) '사용자ID
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID()) 'UI단말식별키
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "SVCD"             , 0 , "100"             ) '이체: 기본 '200' 등록 '400'

    ElseIf szTranID == "obrtp_tran_032r" Then '최근이체계좌 조회
    
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"          , 0 , szACNO)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ASNO"          , 0 , szASNO)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TACT_PROS_YN"  , 0 , ""    ) 
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "%"   )
	
    ElseIf szTranID == "obrtp_tran_011a" Then '최근이체계좌 삭제
    
        szBankAcno = grdRecent.GetCellData("bd_acno" , g_recentIndex)
        szBankCode = grdRecent.GetCellData("bd_code" , g_recentIndex)

        DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CRNC_CLS_CODE" , 0 , "1"       )
        DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"          , 0 , szACNO    )
        DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BANK_CODE"     , 0 , szBankCode)
        DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "MNRC_ACNO"     , 0 , szBankAcno)

    ElseIf szTranID == "obrtp_tact_102r" Then '자주쓰는계좌 조회
	
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BSWR_CLCD"     , 0 , "01"  ) '업무구분코드	'01 자주 02 약정 03 오뱅
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CRNC_CLS_CODE" , 0 , "1"   ) '통화구분코드	'1:원화, 2:외화
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ACNO"          , 0 , szACNO) '계좌번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ASNO"          , 0 , szASNO) '계좌순번
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CSNO"          , 0 , ""    ) '고객번호

    ElseIf szTranID == "obrtp_tact_101a" Then '자주쓰는계좌 별명 처리
		
        nSRNO   = grdOften.GetCellData("bd_srno"  , g_oftenIndex)
        szAlias = grdOften.GetCellData("bd_alias" , g_oftenIndex)
	
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "PROS_CLS_CODE" , 0 , "3"       )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CSNO"          , 0 , g_szCustNo)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BSWR_CLCD"     , 0 , "01"      ) '업무구분코드	'01 자주 02 약정
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CRNC_CLS_CODE" , 0 , "1"       ) '통화구분코드	'1:원화, 2:외화
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "IQRY_SRNO"     , 0 , nSRNO     )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "USER_NAME"     , 0 , g_szAlias ) '수정한 별명
	
    ElseIf szTranID == "obrtp_tact_101a_2" Then '자주쓰는계좌 삭제
    
        szCnftAcno = grdOften.GetCellData("bd_cnftacno" , g_oftenIndex)
        szCnftAsno = grdOften.GetCellData("bd_cnftasno" , g_oftenIndex)
        szBankCode = grdOften.GetCellData("bd_code"     , g_oftenIndex)
        szBankAcno = grdOften.GetCellData("bd_acno"     , g_oftenIndex)
        szBicCode  = grdOften.GetCellData("bd_biccode"  , g_oftenIndex)
	
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "PROS_CLS_CODE" , 0 , "5"       ) '5.삭제
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CSNO"          , 0 , g_szCustNo)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BSWR_CLCD"     , 0 , "01"      ) '01.자주
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CRNC_CLS_CODE" , 0 , "1"       ) '1.원화
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "IQRY_SRNO"     , 0 , 0         )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BANK_CODE"     , 0 , szBankCode)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BIC_CODE"      , 0 , szBicCode )
	
        If Trim(szBankCode) == "287" Then
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ONCO_OTCO_CLS_CODE" , 0 , "1"       )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CNFT_ACNO"          , 0 , szCnftAcno)
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CNFT_ASNO"          , 0 , szCnftAsno)
        Else
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ONCO_OTCO_CLS_CODE" , 0 , "2"       )
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BANK_USE_ACNO"      , 0 , szBankAcno)
        End If 
	
    ElseIf szTranID == "obrtp_tact_101a_3" Then '타금융 내계좌 별명 처리
		
		szBankCode = grdMyAcnt.GetCellData("bd_code"  , g_nMyIndex)
		szAcNo     = grdMyAcnt.GetCellData("bd_acno"  , g_nMyIndex)
		szAlias    = grdMyAcnt.GetCellData("bd_alias" , g_nMyIndex)
	
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PROS_CLS_CODE"      , 0 , "3"       ) '3.별명변경
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CSNO"               , 0 , g_szCustNo) '고객번호
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "BSWR_CLCD"          , 0 , "02"      ) '02.약정
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CRNC_CLS_CODE"      , 0 , "1"       ) '1.원화
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "IQRY_SRNO"          , 0 , 0         ) '조회일련번호
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ONCO_OTCO_CLS_CODE" , 0 , "2"       ) '2.타행
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"               , 0 , szACNO    )
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "BANK_CODE"          , 0 , szBankCode) '은행코드			
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "BANK_USE_ACNO"      , 0 , szAcNo    )
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "USER_NAME"          , 0 , g_szAlias )
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CRCD"               , 0 , "KRW"     )
		
     ElseIf szTranID == "obaci_acct_021u" Then '타금융 내계좌 별명 처리
		
		szAcNo     = grdMyAcnt.GetCellData("bd_acno"  , g_nMyIndex)
		szAsNo     = grdMyAcnt.GetCellData("bd_asno"  , g_nMyIndex)
		szAlias    = grdMyAcnt.GetCellData("bd_alias" , g_nMyIndex)
	
		DATAMANAGER.SetDataValue(0 , "obaci_acct_021u", "InBlock1", "ACNO"     , 0 , szAcNo     ) '3.별명변경
		DATAMANAGER.SetDataValue(0 , "obaci_acct_021u", "InBlock1", "ASNO"             , 0 , szAsNo) '고객번호
		DATAMANAGER.SetDataValue(0 , "obaci_acct_021u", "InBlock1", "BKKP_NAME"       , 0 , g_szAlias )
	
	
    Elseif szTranID == "obrtp_tact_005a" then	'자주쓰는계좌 순서 변경
	
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CSNO"               , 0 , g_szCustNo )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "BSWR_CLCD"          , 0 , "01"       ) '업무구분코드	'01 자주 02 약정
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "CRNC_CLS_CODE"      , 0 , "1"        ) '통화구분코드	'1:원화, 2:외화

        For i = 0 to CInt(grdOften.rowcount) - 1
	
            szAcno     = grdOften.GetCellData("bd_acno"     , i)
            szBankAcnm = grdOften.GetCellData("bd_bankacnm" , i)
            szCnftAcno = grdOften.GetCellData("bd_cnftacno" , i)
            szCnftAsno = grdOften.GetCellData("bd_cnftasno" , i)
            szBankCode = grdOften.GetCellData("bd_code"     , i)
            szBicCode  = grdOften.GetCellData("bd_biccode"  , i)
            szUserName = grdOften.GetCellData("bd_alias"    , i)
            nRowSrno   = grdOften.GetCellData("bd_srno"     , i)
	    
	                    
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "ACNO"      , i , szAcno    )
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BANK_CODE" , i , szBankCode)
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BIC_CODE"  , i , szBicCode )
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "USER_NAME" , i , szUserName)		    
            DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "SRNO"      , i , nRowSrno  )
		
            If Trim(szBankCode) = "287" Then
                DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "ONCO_OTCO_CLS_CODE" , i , "1"       )
                DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "CNFT_ACNO"          , i , szCnftAcno)
                DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "CNFT_ASNO"          , i , szCnftAsno)		

            Else
                DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "ONCO_OTCO_CLS_CODE" , i , "2"       )
                DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BANK_USE_ACNO"      , i , szAcno    )
                DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "BANK_ACNM"          , i , szBankAcnm)			
            End If
	
        Next

    ElseIf szTranID == "obacp_comm_062r" Then '내계좌 조회
    
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ELFN_ID"            , 0 , g_szUserID)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "WNCR_FRCR_CLS_CODE" , 0 , "1"       )

    ElseIf szTranID == "obacp_comm_063r" Then '약정계좌 조회
    
        DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ELFN_ID"            , 0 , g_szUserID)
        DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "WNCR_FRCR_CLS_CODE" , 0 , "1"       ) '2:외화
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ACNO"               , 0 , szACNO    ) '계좌번호
	
    ElseIf szTranID == "obtss_elbs_121r" Then '타행이체 수취조회 전문발송 ( 당행도 가능 )
    
        szTransInfo = f_GetTransInfoItem(g_nTranIndex)
        arrTransInfo = Split(szTransInfo, g_szSeparator)
		
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "MNRC_BANK_CODE"     , 0 , arrTransInfo(0)) '입금은행코드
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "JOB_TRNO"           , 0 , "031"          ) '작업단말번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "MNRC_ACNO"          , 0 , arrTransInfo(1)) '입금계좌번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "TR_AMT"             , 0 , "1"            ) '거래금액
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "DRNG_ACNO"          , 0 , szACNO         ) '출금계좌번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "ACNT_PROD_CLS_CODE" , 0 , szASNO         ) '계좌상품구분코드
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "PWD"                , 0 , ""             ) '비밀번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1", "RMRK"               , 0 , "N"            ) '비고 (N:비밀번호 스킵)

        Form.addWaitCursor()

    ElseIf szTranID == "obtss_elbs_221r" Then '타행이체 수취조회 응답수신 (타행만 호출)
    
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "LNKD_BANK_CLS_CODE"  , 0 , g_szLNKD_BANK_CLS_CODE )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TR_DATE"             , 0 , g_szTR_DATE            )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "OTSD_TR_UNIQ_NO"     , 0 , g_szOTSD_TR_UNIQ_NO    )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TACT_LNKD_ISTU_CODE" , 0 , g_szTACT_LNKD_ISTU_CODE)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "TACT_STND_TR_CODE"   , 0 , g_szTACT_STND_TR_CODE  )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "LNKD_TLMS_MNNO"      , 0 , g_szLNKD_TLMS_MNNO     )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "RPCS_TMNU"           , 0 , g_szRcvn_iqry_tmnu     )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "DRNG_ACNO"           , 0 , szACNO                 ) '계좌번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "ACNT_PROD_CLS_CODE"  , 0 , szASNO                 ) '계좌일련번호
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "PWD"                 , 0 , ""                     ) '비밀번호

    ElseIf szTranID == "obpds_srvc_185a" Then '간편이체 동의 조회
    
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "4"       ) '4:조회 1:처리
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "CSNO"          , 0 , g_szCustNo)
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "SVCD"          , 0 , "058"     )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "SVC_SRNO"      , 0 , ""        )
    
    ElseIf szTranID == "ohhts_open_001r" Then
    
        If g_OSType == "1" Then '안드로이드
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "FID_SORT_CLS" , 0, "3")
        Else '아이폰
            DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "FID_SORT_CLS" , 0, "4")
        End If
		
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "FID_SCR_NO"   , 0 , "63010"   )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "FID_SCR_NAME" , 0 , "이체"    )
        DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "USER_ID"      , 0 , g_szUserID)
		
    End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

    If szTranID == "obcsb_oimf_638r" Then '전자금융사기예방 고객조회
    
        g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
        g_szTRPass = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r", "OutBlock1", "UI_SPLM_YN" , 0)
        g_szRegYn = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "REG_YN" , 0)) '등록단말여부
		
        '지정단말Only 약정상태인데 미등록단말로 접속한경우
        '무조건 간편이체약정까지 맺고 이체화면으로 돌아오거나 이체화면을 끄게 되므로, 185a를 콜해서 간편이체여부 확인할 필요가 없음
        If g_szTRPass == "Y" And ( g_szCertUserType == "0" or g_szCertUserType == "6" ) Then 	'20241101 SWJ START: 클라우드 인증 반영
            Form.OpenPopupAnimation("mbbnk63010_p0", "" , "","2")
            return
        End If
		
        DATAMANAGER.RequestTranData("obpds_srvc_185a")

    ElseIf szTranID == "obrtp_tran_032r" Then '최근이체계좌 조회
    
        nCnt = grdRecent.rowcount
        For i = 0 To nCnt - 1
	
            szBankName = grdRecent.GetCellData("bd_bankname" , i)
            szAcno     = grdRecent.GetCellData("bd_acno"     , i)
            szRmtName  = grdRecent.GetCellData("bd_rmtname"  , i)
            szBankCode = grdRecent.GetCellData("bd_code"     , i)
	    
            grdRecent.SetCellData("bd_bank" , i , szBankName.." "..szAcno   )
            grdRecent.SetCellData("bd_name" , i , szRmtName                 )
            grdRecent.SetCellData("bd_logo" , i , "bank"..szBankCode..".png")
			
            grdRecent.setMaintainingRatio("bd_logo"    , i , "1") 
            grdRecent.setMaintainingRatio("bd_del_aos" , i , "1")
            grdRecent.setMaintainingRatio("bd_del_ios" , i , "1")
	    
        Next

        If Cdbl(tabAcnt.currenttab) == 0 Or tabAcnt.currenttab == "0" Then
            lblTotal.caption = grdRecent.rowcount.."개의 최근 이체 내역이 있어요."
        End If

    ElseIf szTranID == "obrtp_tact_102r" Then '자주쓰는계좌 조회
    
        If DATAMANAGER.IsMoreNextData(szTranID) == True Then
            DATAMANAGER.RequestNextData(szTranID)
            Exit Sub
        End If
    
        nCnt = grdOften.rowcount
	
        If CInt(nCnt) > 100 Then
            grdOften.rowmove = "3" '2.상하 + 좌 드래그 | 3.좌드래그
            grdOften.setDragImage("edit_guide_02.png")
            grdOften.setDragImageOption(False,0)	    
        Else
            grdOften.rowmove = "2" '2.상하 + 좌 드래그 | 3.좌드래그
            grdOften.setDragImage("edit_guide_01.png")
            grdOften.setDragImageOption(True,0)
        End If
	
        For i = 0 To nCnt - 1
	
            szBankName = grdOften.GetCellData("bd_bankname" , i)
            szAcno     = grdOften.GetCellData("bd_acno"     , i)
            szBankAcnm = grdOften.GetCellData("bd_bankacnm" , i)
            szCnftAcnm = grdOften.GetCellData("bd_cnftacnm" , i)
            szCnftAcno = grdOften.GetCellData("bd_cnftacno" , i)
            szCnftAsno = grdOften.GetCellData("bd_cnftasno" , i)
            szBankCode = grdOften.GetCellData("bd_code"     , i)
            szBicCode  = grdOften.GetCellData("bd_biccode"  , i)

            If szBankCode == "" Or szBankCode == "287" Then
                grdOften.SetCellData("bd_bank" , i , szBankName .. " " .. szCnftAcno..szCnftAsno)
                grdOften.SetCellData("bd_name" , i , szCnftAcnm)
                grdOften.SetCellData("bd_acno" , i , szCnftAcno..szCnftAsno)
		   Else
                grdOften.SetCellData("bd_bank" , i , szBankName .. " " .. szAcno)
                grdOften.SetCellData("bd_name" , i , szBankAcnm)
		   End If
		
            grdOften.setMaintainingRatio( "bd_logo" , i , "1")
            grdOften.SetCellData("bd_logo" , i , "bank"..szBankCode..".png")
			
        Next

        If Cdbl(tabAcnt.currenttab) == 1 Or tabAcnt.currenttab == "1"  Then
            lblTotal.caption = grdOften.rowcount.."개의 자주 쓰는 계좌가 있어요."

            If Cdbl(grdOften.rowcount) == 0 Then 'v002
                lblGuide1.visible = "1"                
                lblGuide2.visible = "1"
                lblMove.visible = "1" 
                lblGuide1.caption = "자주쓰는계좌를 미리 등록한 후 간편하게"
                lblGuide2.caption = "이용할 수 있어요."
                lblMove.caption = "계좌 등록 하러가기 >"
            Else
                lblGuide1.visible = "0"                
                lblGuide2.visible = "0"
                lblMove.visible = "0" 	    
            End If
        End If

        
			
    ElseIf szTranID == "obacp_comm_062r" Then '내계좌 조회
    
        lblGuide1.visible = "0"
        lblGuide2.visible = "0"
        lblMove.visible = "0"     
    
        If DATAMANAGER.IsMoreNextData(szTranID) == True Then
            DATAMANAGER.RequestNextData(szTranID)
            Exit Sub
        End If
    
        nCnt = grdMyAcnt.rowcount
        For i = 0 To nCnt - 1
	
            szBankName = grdMyAcnt.GetCellData("bd_bankname" , i)
            szAcno     = grdMyAcnt.GetCellData("bd_acno"     , i)
            szAsno     = grdMyAcnt.GetCellData("bd_asno"     , i)
            szPrnm     = grdMyAcnt.GetCellData("bd_prnm"     , i)

            grdMyAcnt.setMaintainingRatio( "bd_logo" , i , "1")
	    
            grdMyAcnt.SetCellData( "bd_name" , i , szPrnm                                           )
            grdMyAcnt.SetCellData( "bd_logo" , i , "bank287.png"                                    )
            grdMyAcnt.SetCellData( "bd_bank" , i , Left(szAcno,4).."-"..Right(szAcno,4).."-"..szAsno)

             grdMyAcnt.SetCellData("bd_edit"  , i , "icon_pencil.png")
        Next

    ElseIf szTranID == "obacp_comm_063r" Then '약정계좌 조회
    
        If DATAMANAGER.IsMoreNextData(szTranID) == True Then
            DATAMANAGER.RequestNextData(szTranID)
            Exit Sub
        End If    
    
        nCnt = grdMyAcnt.rowcount
        For i = 0 To nCnt - 1
	
            szBankName = grdMyAcnt.GetCellData("bd_bankname" , i)
            szAcno     = grdMyAcnt.GetCellData("bd_acno"     , i)
            szBankCode = grdMyAcnt.GetCellData("bd_code"     , i)
	    
            grdMyAcnt.setMaintainingRatio("bd_logo" , i , "1")
	    
            grdMyAcnt.SetCellData("bd_name" , i , g_szUserNm                )
            grdMyAcnt.SetCellData("bd_logo" , i , "bank"..szBankCode..".png")
            grdMyAcnt.SetCellData("bd_bank" , i , szBankName.." "..szAcno   )

            grdMyAcnt.SetCellData("bd_edit"  , i , "icon_pencil.png")
        Next
	
		'v002
        '타금융내계좌 데이터 없음
        'JWH 20240201 고객구분코드 추가
        If g_szCUST_CLS_CODE == "1" And (Cdbl(tabAcnt.currenttab) == 2 Or tabAcnt.currenttab == "2") And (Cdbl(rdoMyAcnt.currentindex) == 1 Or rdoMyAcnt.currentindex == "1") And Cdbl(grdMyAcnt.rowcount) == 0 Then 
            lblGuide1.visible = "1"
            lblGuide2.visible = "1"
            lblMove.visible = "1" 
            lblGuide1.caption = "본인명의 계좌 약정 등록 후 간편하게"
            lblGuide2.caption = "이용할 수 있어요."
            lblMove.caption = "계좌 등록 하러가기 >"
        Else
            lblGuide1.visible = "0"
            lblGuide2.visible = "0"
            lblMove.visible = "0" 
        End If

    ElseIf szTranID == "obtss_elbs_121r" Then '타행이체 수취조회 전문발송
    
        If DATAMANAGER.GetDataMsgCode(szTranID) == "6617" Then  '처리 대기중입니다.
	
            g_szLNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "LNKD_BANK_CLS_CODE" , 0)
            g_szTR_DATE             = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "TR_DATE"            , 0)
            g_szOTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "OTSD_TR_UNIQ_NO"    , 0)
            g_szTACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "TACT_LNKD_ISTU_CODE", 0)
            g_szTACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "TACT_STND_TR_CODE"  , 0)
            g_szLNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "LNKD_TLMS_MNNO"     , 0)

            Form.SetTimerEvent2(1,1,0.5) '처음은 0.5초 후 조회
            Exit Sub
	    
        Else
	
            szTransInfo = f_GetTransInfoItem(g_nTranIndex)
            arrTransInfo = Split(szTransInfo, g_szSeparator)
			
            If arrTransInfo(0) == "287" Then
	    
                g_szLNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "LNKD_BANK_CLS_CODE"  , 0)
                g_szTR_DATE             = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "TR_DATE"             , 0)
                g_szOTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "OTSD_TR_UNIQ_NO"     , 0)
                g_szTACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "TACT_LNKD_ISTU_CODE" , 0)
                g_szTACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "TACT_STND_TR_CODE"   , 0)
                g_szLNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "LNKD_TLMS_MNNO"      , 0)
				
                g_szBankCode   = arrTransInfo(0)
                g_szBankAcno   = arrTransInfo(1)
                g_szBankName   = arrTransInfo(2)
                g_szBankAcntNm = DATAMANAGER.GetDataValue (0 , szTranID , "OutBlock1" , "ACNM" , 0)
				
                szTransInfo = f_GetTransInfoItem(g_nTranIndex)
                szData = g_szBankCode..g_szSeparator..g_szBankAcno..g_szSeparator..g_szBankName..g_szSeparator..g_szBankAcntNm .. g_szSeparator .. "0" .. g_szSeparator .. "0"

                f_SetTransInfoItem(szData, g_nTranIndex)
			
                szData = g_nTranIndex  .."♥"..
                         g_szTransInfo1.."♥"..
                         g_szTransInfo2.."♥"..
                         g_szTransInfo3.."♥"..
                         g_szTransInfo4.."♥"..
                         g_szTransInfo5
					
                g_AllResetCnt = 0
		
			  '20241108 SWJ START
			  '유량제어 서비스 및 화면 호출 완료 시, 요청해놨던거 해지 처리 필요
			  g_bFlowFlag  = True
			  
		       Form.requestNetfunnel("END", g_sActionID, 0)
		       
		       g_szData = szData
		       
		       'Form.OpenPopup("mbbnk63010_s2", szData , "")
			  '20241108 SWJ END
				
            End If
            Form.SetTimerEvent(9999, 1, 1) 'remove
	    
        End If

    ElseIf szTranID == "obtss_elbs_221r" Then '타행이체 수취조회 응답수신	
    
        If DATAMANAGER.GetDataMsgCode( szTranID ) == "6617" Then  '처리 대기중입니다.
	
            g_szLNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "LNKD_BANK_CLS_CODE"  , 0)
            g_szTR_DATE             = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "TR_DATE"             , 0)
            g_szOTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "OTSD_TR_UNIQ_NO"     , 0)
            g_szTACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "TACT_LNKD_ISTU_CODE" , 0)
            g_szTACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "TACT_STND_TR_CODE"   , 0)
            g_szLNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock2" , "LNKD_TLMS_MNNO"      , 0)
		    
            g_szRcvn_iqry_tmnu = g_szRcvn_iqry_tmnu + 1 '수취조회횟수 증가
			
            If g_szRcvn_iqry_tmnu < 5 Then '5초 MAX
                SLEEP_SEC = g_szRcvn_iqry_tmnu
            Else
                SLEEP_SEC = 5
            End If
		    
            g_TRAN_ID = szTranID
            Form.SetTimerEvent2(1,1,SLEEP_SEC)
			
            Exit Sub
	    
        Else
			
            Form.SetTimerEvent(9999, 1, 1) 'remove
	
            szTransInfo = f_GetTransInfoItem(g_nTranIndex)
            arrTransInfo = Split(szTransInfo, g_szSeparator)
            g_szBankCode = arrTransInfo(0)
            g_szBankAcno = arrTransInfo(1)
            g_szBankName = arrTransInfo(2)
            g_szBankAcntNm = DATAMANAGER.GetDataValue (0, "obtss_elbs_221r", "OutBlock1", "ACNM", 0 )
            szBankName = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "TACT_BANK_NAME", 0)
	    
            If szBankName <> "" Then
                g_szBankName = szBankName
            End If
			
            szMsgCode = DATAMANAGER.GetDataMsgCode( szTranID )
			
            g_szFee = DATAMANAGER.GetDataValue( 0, "obtss_elbs_221r", "OutBlock1", "FEE" , 0 )
			
            szTransInfo = f_GetTransInfoItem(g_nTranIndex)
            szData = g_szBankCode..g_szSeparator..g_szBankAcno..g_szSeparator..g_szBankName..g_szSeparator..g_szBankAcntNm .. g_szSeparator .. "0" .. g_szSeparator .. g_szFee
			
            f_SetTransInfoItem(szData, g_nTranIndex)
			
            szData = g_nTranIndex  .."♥"..
                     g_szTransInfo1.."♥"..
                     g_szTransInfo2.."♥"..
                     g_szTransInfo3.."♥"..
                     g_szTransInfo4.."♥"..
                     g_szTransInfo5
				
            g_AllResetCnt = 0
	    
		   '20241108 SWJ START
		   '유량제어 서비스 및 화면 호출 완료 시, 요청해놨던거 해지 처리 필요
		    g_bFlowFlag  = True
		   
			Form.requestNetfunnel("END", g_sActionID, 0)
			
			g_szData = szData
			'Form.OpenPopup("mbbnk63010_s2", szData , "")
			
		   '20241108 SWJ END
		    
			
        End If

    ElseIf szTranID == "obpds_srvc_185a" Then '간편이체 동의 조회
    
        szSTPL_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "STPL_YN" , 0)
        g_szCUST_CLS_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "CUST_CLS_CODE" , 0) 'JWH 20240201 전역변수로변경
        Form.SetSharedData("MBBNK63010_CUST_CLS_CODE" , g_szCUST_CLS_CODE) 'JWH 20240201 전역변수로변경

        If g_szCUST_CLS_CODE <> "2" Then '법인은 패스 (JWH 20240201 전역변수로변경)
			
            If g_szRegYn == "N" And (g_szCertUserType == "0" or g_szCertUserType == "6") Then '미지정기기이면서 공인인증인 경우	'20241101 SWJ START: 클라우드 인증 반영
			
                If f_CheckNotice() == False Then '정해진 기간 동안 한 번만 띄운다.
                    Form.OpenPopupAnimation("mbbnk63010_p1" , "" , "" , "2")
                End If
			
            ElseIf szSTPL_YN == "N" And g_szRegYn == "Y" And (g_szCertUserType == "0"  or g_szCertUserType == "6") Then '지정기기이면서 공인인증인 경우	'20241101 SWJ START: 클라우드 인증 반영
	    
                Form.OpenPopupAnimation("mbbnk63010_p2" , "" , "","2")

            ElseIf szSTPL_YN == "N" And ( g_szCertUserType <> "0" and g_szCertUserType <> "6" ) Then ' 미약정 상태 이면서 공인인증 아닌 경우	'20241101 SWJ START: 클라우드 인증 반영
	    
                Form.OpenPopupAnimation("mbbnk63010_p2", "" , "","2")
		
            End If
	    
        End If

    ElseIf szTranID == "obrtp_tact_010r" Then
	
        g_CopyAcnt     = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "MNRC_ACNO" , 0)
        g_CopyBankCode = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "BANK_CODE" , 0)
        g_CopyBankName = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "BANK_NAME" , 0)

        If Trim(g_CopyAcnt) <> "" Then 
	
            If Trim(g_CopyBankCode) <> "" Then
		 
                If Trim(g_CopyBankCode) == "287" Then
                    lblCopyAcnt.caption = g_CopyBankName .. " " .. Left(g_CopyAcnt,4) .. "-" .. Mid(g_CopyAcnt,5,4) .. "-" .. Right(g_CopyAcnt,2)
                Else
                    lblCopyAcnt.caption = g_CopyBankName .. " " .. g_CopyAcnt
                End If
                 
            Else
                lblCopyAcnt.caption = g_CopyAcnt
            End If
            
            imgCopy.visible = "1"
            imgCopyClose.visible = "1"
            btnCopyClose.visible = "1"
            lblCopyComm.visible = "1"
            lblCopyAcnt.visible = "1"
            g_AcntCopyPopupYN = "1"
        End If

    ElseIf szTranID == "obrtp_tran_011a" Then  
        Form.Toast(0, "최근 이체 계좌에서 삭제되었습니다.", 0)
        grdRecent.SetDeleteRow(g_recentIndex)
        lblTotal.caption = grdRecent.rowcount.."개의 최근 이체 내역이 있어요."	
	
    ElseIf szTranID == "obrtp_tact_101a" Then '자주쓰는계좌 별명변경
        grdOften.SetCellData("bd_alias" , g_oftenIndex , g_szAlias) 
		
    ElseIf szTranID == "obrtp_tact_101a_2" Then '자주쓰는계좌 삭제
        Form.Toast(0, "자주쓰는 계좌가 삭제되었습니다.", 0)
        grdOften.SetDeleteRow(g_oftenIndex)
        lblTotal.caption = grdOften.rowcount.."개의 자주 쓰는 계좌가 있어요."	
	
        If Cdbl(grdOften.rowcount) == 0 Then 'v002
            lblGuide1.visible = "1"                
            lblGuide2.visible = "1"
            lblMove.visible = "1" 
            lblGuide1.caption = "자주쓰는계좌를 미리 등록한 후 간편하게"
            lblGuide2.caption = "이용할 수 있어요."
            lblMove.caption = "계좌 등록 하러가기 >"
        Else
            lblGuide1.visible = "0"                
            lblGuide2.visible = "0"
            lblMove.visible = "0" 	    
        End If
	
    ElseIf szTranID == "obrtp_tact_101a_3" Then '타금융 내계좌 별명 처리
        grdMyAcnt.SetCellData("bd_alias" , g_nMyIndex , g_szAlias)
	
    ElseIf szTranID == "obaci_acct_021u" Then '타금융 내계좌 별명 처리
        grdMyAcnt.SetCellData("bd_alias" , g_nMyIndex , g_szAlias)
	
    End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    szSubErr = Trim(DATAMANAGER.GetDataMsgSubText( szTranID ))

    If szSubErr <> "" And szSubErr <> Null Then
        szErrMsg = szErrMsg .. "\n(" .. szSubErr .. ")"
    End If
	
    If szTranID == "obtss_elbs_121r" Or szTranID == "obtss_elbs_221r" Then
        Form.SetTimerEvent(9999, 1, 1) 'remove
        Form.MsgBox( "알림", szErrMsg, "", 6 )
    End If
	     
    If szTranID == "obrtp_tact_005a" Or szTranID == "obrtp_tact_101a" Or szTranID == "obrtp_tact_101a_2" Then
        Form.Toast(0, szSubErr , 0)
        DATAMANAGER.RequestTranData("obrtp_tact_102r") '자주쓰는계좌 순서변경 등 처리오류 시 리스트 재조회
    End If
    
    If szTranID == "obrtp_tran_011a" Then '최근이체계좌 삭제
        Form.Toast(0, szSubErr , 0)
        DATAMANAGER.RequestTranData("obrtp_tran_032r") '재조회
    End If
    
    If szTranID == "obrtp_tact_101a_3" Then '타금융내계좌 별명변경
        Form.Toast(0, szSubErr , 0)
        'DATAMANAGER.RequestTranData("obacp_comm_063r") '타금융내계좌 재조회
	
	  If CInt(rdoMyAcnt.currentindex) == 0 Then '메리츠증권
		DATAMANAGER.RequestTranData("obacp_comm_062r")
	    Else
		DATAMANAGER.RequestTranData("obacp_comm_063r")
	    End If
    End If
    
If szTranID == "obaci_acct_021u" Then '타금융내계좌 별명변경
        Form.Toast(0, szSubErr , 0)
        'DATAMANAGER.RequestTranData("obacp_comm_063r") '타금융내계좌 재조회
	
	  If CInt(rdoMyAcnt.currentindex) == 0 Then '메리츠증권
		DATAMANAGER.RequestTranData("obacp_comm_062r")
	    Else
		DATAMANAGER.RequestTranData("obacp_comm_063r")
	    End If
    End If
	 
End Sub

'============================================================================
Sub tabAcnt_OnTabChanged(nCurrentTab)
    If nCurrentTab == 0 Then
    
        grdRecent.visible = "1"
        grdOften.visible = "0"
        grdMyAcnt.visible = "0"
        rdoMyAcnt.visible = "0"
        lblMyAcntLine.visible = "0"
        lblGuide1.visible = "0" 'v002
        lblGuide2.visible = "0"
        lblMove.visible = "0"
        lblTotal.visible = "1"
        lblTotal.caption = grdRecent.rowcount.."개의 최근 이체 내역이 있어요."
	
    Elseif nCurrentTab == 1 Then
    
        grdRecent.visible = "0"
        grdOften.visible = "1"
        grdMyAcnt.visible = "0"
        rdoMyAcnt.visible = "0"
        lblMyAcntLine.visible = "0"
        lblGuide1.visible = "0" 'v002
        lblGuide2.visible = "0"
        lblMove.visible = "0"
        lblTotal.visible = "1"
        lblTotal.caption = grdOften.rowcount.."개의 자주 쓰는 계좌가 있어요."
        
        DATAMANAGER.RequestTranData("obrtp_tact_102r")
	
    ElseIf nCurrentTab == 2 Then
        grdRecent.visible = "0"
        grdOften.visible = "0"
        grdMyAcnt.visible = "1"
        rdoMyAcnt.visible = "1"
        rdoMyAcnt.currentindex = "0"
