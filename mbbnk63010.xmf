Sub Form_OnFormClose()

    Form.GetSharedData("63010_ACNT_INFO" , True)
    Form.GetSharedData("MBBNK63010_CUST_CLS_CODE", True)
    Form.GetSharedData("MNRC_ACNT_SLCT_CLS", True) 'JWH 20240124 메모리 클리어
    Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y") '안드로이드 뒤로가기 동작 활성화
    
    
    '20241108 SWJ START
    if g_bFlowFlag = False then
		Form.requestNetfunnel("END", g_sActionID, 0)
    end if
    '20241108 SWJ END
    
    '20250902 YSH START
    if g_sPrevScreen <> "" then
	    Form.PostLinkData("REFRESH_SCREEN", g_sPrevScreen)
    end if
    '20250902 YSH START
    
End Sub

