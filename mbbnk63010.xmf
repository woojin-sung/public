Sub f_InitValue()

    g_recentIndex = 0
    g_oftenIndex  = 0
    g_nMyIndex    = 0

    g_szBankCode = "287"
    g_szBankName = "메리츠증권"
    g_szBankAcno = ""
    g_szBankAcntNm = ""
	
    g_nTranIndex = 1
    g_szTransInfo1 = ""
    g_szTransInfo2 = ""
    g_szTransInfo3 = ""
    g_szTransInfo4 = ""
    g_szTransInfo5 = ""
    g_szSeparator = "★"
	
    g_ExKey = ""
    g_CurrKey = ""
    g_ClipBoard = ""
    
    imgCopy.visible = "0"
    imgCopyClose.visible = "0"
    btnCopyClose.visible = "0"
    lblCopyComm.visible = "0"
    lblCopyAcnt.visible = "0"
    g_AcntCopyPopupYN = "0"
    
    grdRecent.SetClear()
    grdOften.SetClear()
    grdMyAcnt.SetClear()

End Sub

'============================================================================
Sub f_RequestAcntVerify(szData)

    szTransInfo = f_GetTransInfoItem(g_nTranIndex)
    arrTransInfo = Split(szTransInfo, g_szSeparator)

    szBankCode = arrTransInfo(0)
    szBankAcno = arrTransInfo(1)
	
    g_szRcvn_iqry_tmnu = 0
    DATAMANAGER.RequestTranData("obtss_elbs_121r") '타행이체 수취조회 전문발송
    
End Sub

'============================================================================
Sub f_SetTransInfoItem(szData, nIndex)

    If nIndex == 1 Then
        g_szTransInfo1 = szData
    ElseIf nIndex == 2 Then
        g_szTransInfo2 = szData
    ElseIf nIndex == 3 Then
        g_szTransInfo3 = szData
    ElseIf nIndex == 4 Then
        g_szTransInfo4 = szData
    ElseIf nIndex == 5 Then
        g_szTransInfo5 = szData
    End If
    
End Sub

'============================================================================
Function f_GetTransInfoItem(nIndex)

    If nIndex == 1 Then
        Return g_szTransInfo1
    ElseIf nIndex == 2 Then
        Return g_szTransInfo2
    ElseIf nIndex == 3 Then
        Return g_szTransInfo3
    ElseIf nIndex == 4 Then
        Return g_szTransInfo4
    ElseIf nIndex == 5 Then
        Return g_szTransInfo5
    End If
    
End Function

'============================================================================
Sub f_SetRecieveScreen(szVisible, szMsgCode)

    If szMsgCode <> "4941" Then
        lblRecName.visible = szVisible
        lblRecText.visible = szVisible
    End If
    lblWhite.visible = szVisible
    btnConfirm.visible = szVisible
    
End Sub

