	<CONTROL_INFO>
		<FORMTAB name="FormTab0" tabcount="2" tabwidthtype="1" tabheadheight="36" ly_vert="0,0,375,562,1" >
			<PAGE name="page002171" caption="해외주식 거래신청" linkfile="mbonl87051.xmf" />
			<PAGE name="page000061" caption="해외ETP 거래신청" linkfile="mbonl87050.xmf" />
