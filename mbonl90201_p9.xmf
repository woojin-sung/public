'============================================================================
' btnBack_OnClick
'============================================================================
Sub btnBack_OnClick()
	Dim nLen
	nLen = Len(edtPrc.caption)

	if nLen <> 0 then
		szPrc = Left(edtPrc.caption, nLen-1)
		edtPrc.caption = szPrc
	else
		'EK ADD
		edtInit.visible = true
	end if
	
	g_szReceive = ""
End Sub

'============================================================================
' btnClear_OnClick
'============================================================================
Sub btnClear_OnClick()
	edtPrc.caption = ""
	
	'EK ADD
	edtInit.visible = true
End Sub

'============================================================================
' btnConfirm_OnClick
'============================================================================
Sub btnConfirm_OnClick()
	szPrc = edtPrc.caption
	if szPrc == "" then
		szPrc = "0"
	end if
	
'	if Trim(szPrc) <> "" then
'		szPrc = edtPrc.caption
'		szMod = szPrc Mod 1000
'		szPrc = szPrc-szMod
		Form.SendReturnToParent("PRC_POPUP", szPrc)
'	end if
	Form.CloseForm()
End Sub

