' 20160317 가격 Max : 7 (전요셉과장)

'============================================================================
' 화 면 명 : 주식주문_가격입력창
' 화면설명 : 주식주문 가격입력시
' 작    성 : 2016.02.15 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCd, g_szMk, g_szUnit, g_szType, g_szReceive, g_szopenPrc
g_szCd, g_szMk, g_szUnit, g_szType, g_szReceive = "", "", "", "", ""

Dim g_szMode   '0:금액, 1:수량

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn)
	Dim szPrc, szUnit, szHigh, szLow, szHyun, nResult
	
	g_szReceive = ""
	szPrc  = edtPrc.caption
'	szUnit = g_szUnit
'	szHigh = edtHigh.caption
'	szLow  = edtLow.caption
'	szHyun = tblData.GetCellString(1, 0)

	 ' 20160317 예외처리 추가 //////////////////////////////////////////////
	if Trim(szPrc) <> "" then
		if CDbl(szPrc) >= 9900000 then
			if nGbn == 0 then
				Exit Function
			end if
		end if
	end if
	' //////////////////////////////////////////////////////////////////////
	

	
	Sum_Prc(szPrc)
End Function

'============================================================================
' Calc_Plus
'============================================================================
Function Calc_Plus(nPlus)
	Dim szPrc
	
	edtInit.visible = false

	if g_szReceive == "1" then
		g_szReceive = ""
		edtPrc.caption = nPlus
	else
		szPrc = edtPrc.caption
		
	'	if Trim(szPrc) == "" then
	'		szPrc = 0
	'	end if	
		szPrc = szPrc & nPlus
		Sum_Prc(szPrc)
	end if
End Function

'============================================================================
' Calc_Zero
'============================================================================
Function Calc_Zero(szPlus)
	Dim szPrc
	
	edtInit.visible = false
'	Form.ShowAlert("Calc_Zero", g_szReceive)
	
	if g_szReceive == "1" then
		g_szReceive = ""
		edtPrc.caption = ""
	else
		szPrc = edtPrc.caption	
		
		if Len(edtPrc.caption) > 0 then
			szPrc = edtPrc.caption & szPlus
			
			Sum_Prc(szPrc)
		end if
	end if
End Function

'============================================================================
' Sum_Prc
'============================================================================
Function Sum_Prc(szData)
	'if Len(szData) < 16 then
	if Len(szData) < 12 then		' Max 11
		edtPrc.caption = szData
		
	end if
End Function	
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen

	Form.SetScreenName("가격입력기")
	szOpen = Form.GetOpenLinkData()

	'상세화면에서 키패드 오픈한 경우
	edtPrc.halign = 2	'오른쪽 정렬
	edtPrc.left = 62
	edtPrc.width = 317-52
	edtPrc.top = 323
	
	edtInit.halign = 1
	edtInit.left = 100
	edtInit.width = 242
	edtInit.top = 323
	
	if Trim(szOpen) <> "" then
		szData = split(szOpen, "|")
	
		tData = int(szData(0))
'		Form.ShowAlert("", tData)
		
		if tData > 0 then			
			g_szopenPrc = tData
	'		g_szReceive = "1"
			edtPrc.caption = tData
	'		g_szCd   = tData(1)
	'		g_szMk   = tData(2)
	'		g_szUnit = tData(3)
	'		g_szType = tData(4)
	'		edtHigh.caption = tData(5)
	'		edtLow.caption  = tData(6)
		end if 
		
		g_szMode = szData(1)
		if g_szMode = "0" then
			lblTitle.caption = "금액 입력"
			edtInit.caption = "금액을 입력해주세요."
		else
			lblTitle.caption = "수량 입력"
			edtInit.caption = "수량을 입력해주세요."
		end if
		edtInit.visible = true
		
	else
		g_szReceive = "1"
		tData = 0
		
		'EK ADD
		edtInit.visible = true
	end if
	
End Sub

