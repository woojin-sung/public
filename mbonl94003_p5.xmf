''
''--===========================================================================
''****************************************************************************
''               G  L  O  B  A  L       V  A  R  I  A  B  L  E
''****************************************************************************
'
''============================================================================
'' OCR 데이터 및 특징점 추출데이터 (메인에서 취득)
''============================================================================
Dim g_szImg ' 촬영한 사진 데이터
Dim g_szImgSize ' 촬영한 사진 데이터 사이즈

Dim g_szChoice
Dim g_isImgComplete ' 사진 선택했는지 여부

g_isImgComplete = false
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' 이미지 선택 또는 촬영 후 트리거이벤트로 이미지 전달
	' 정상처리 시, 공유변수 통해 이미지 데이터 가져오기 
	' # 트리거 이벤트 명  : CAPTURECOMPLETE
	' # sParam            : 1 정상 / 0 비정상
	' # 캡쳐이미지        : &RET_CAPTURE_IMAGE
	if sEventName = "CAPTURECOMPLETE" then
'		if sParam = "1" then
			g_szImg = Form.GetSharedData("&RET_CAPTURE_IMAGE", true )
			imgPicture.SetImageDataEnc(g_szImg)
			
			if Len(g_szImg) < 102400 then	'이미지 최대사이즈 
				g_szImgSize = Len(g_szImg)
			else
				Form.ShowAlert("알림", "등록할 수 있는 이미지 최대사이즈를 초과하였습니다.")
			end if	
			
			g_isImgComplete = true

			btnLeft.caption = "재시도"
			btnRight.caption = "등록"
'		end if
	end if 
End Sub

'============================================================================
' btnBack_OnClick() : 화면 닫기
'============================================================================
Sub btnBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnLeft_OnClick() : 카메라 여는것으로 추후 수정 필요
'============================================================================
Sub btnLeft_OnClick()	
	'재시도인 경우
	if g_isImgComplete == true then
		if g_szChoice == "camera" then
			' 카메라 앱으로 촬영 후 이미지 가져오기
			Form.runOsCamera()
		elseif g_szChoice == "gallery" then
			' 갤러리 앱 으로 이미지 가져오기
			Form.getGalleryImage()	
		end if
	else
		g_szChoice = "camera"
		g_isImgComplete = false
	
		Form.runOsCamera()
	end if
	
'	btnSubmit.visible = true
End Sub

'============================================================================
' btnRight_OnClick() : 갤러리 여는것으로 추후 수정 필요
'============================================================================
Sub btnRight_OnClick()
	if g_isImgComplete == true then
		if g_szImg == NULL or g_szImg == "" then
			Form.ShowAlert("알림", "이미지 등록에 오류가 발생하였습니다. 다시 시도 부탁드립니다.")
		else
			Form.SendReturnToParent("mbonl94003_p5" , g_szImg & "★" & g_szImgSize)
			Form.CloseForm()
		end if
	else
		g_isImgComplete = false
		g_szChoice = "gallery"
		
		Form.getGalleryImage()	
	end if
End Sub

