'==============================================
' 컬러코드
'==============================================
' 기본 텍스트 컬러 (검정색)
Dim g_szTxtColor_Normal 
g_szTxtColor_Normal 	= "334"

' 기본 텍스트 컬러 (회색)
Dim g_szTxtColor_Grey 
g_szTxtColor_Grey 	= "333"

' 기본 텍스트 컬러 (흰색)
Dim g_szTxtColor_White 
g_szTxtColor_White 	= "338"

' 빨강
Dim g_szTxtColor_Red 
g_szTxtColor_Red = "290"

' 파랑
Dim g_szTxtColor_Blue 
g_szTxtColor_Blue = "291"

' 기본 배경색상
Dim g_szContBgColor
g_szContBgColor = "320"

' 기본 구분선 색상
' 진한색
Dim g_szLineColor
g_szLineColor = "347"
' 중간색
Dim g_szLineColor2
g_szLineColor2 = "256"
' 연한색
Dim g_szLineColor3
g_szLineColor3 = "320"

' 빨강
Dim g_szBadgeBgColor_Red
g_szBadgeBgColor_Red = "339"

' 파랑
Dim g_szBadgeBgColor_Blue
g_szBadgeBgColor_Blue = "340"

Dim g_ImgArrow_Down
g_ImgArrow_Down = "icon_arrow_d"

Dim g_ImgArrow_Up
g_ImgArrow_Up = "icon_arrow_u"

dim	g_szFullAcnt	'계좌번호 (8+2)
dim g_szPwd
g_szPwd = ""
Dim g_nNextIdx
Dim g_nGridIndex

Dim g_szDateType
Dim g_szStartDate
Dim g_szEndDate

Dim g_szGubun
Dim g_szStatus
Dim g_szCrcd

Dim g_szSort
g_szSort = "0"

Dim g_nIdx_Click
g_nIdx_Click = -1

'============================================================================
Sub Form_OnFormInitBefore()
	imgNoData.SetMaintainingRatio("1")
	imgFilter0.SetMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()	
	if Form.GetSharedData("&OS_TYPE", false) == "2" then
		lblFilter.autofontsize = "1" 
		lblFilter.setKeepMaxLine(true)
	end if
	lblFilter.maxlinecnt = "2"
	g_szFullAcnt = Form.GetCtlProp("#acnt01", "caption")
	
	g_szToday = Form.GetSharedData("&HOST_DATE", false)
	g_szStartDate = g_szToday
	g_szEndDate = g_szToday
	g_szDateType = 0
	
	lblDate.caption = Mid(g_szStartDate, 3, 2) & "." & Mid(g_szStartDate, 5, 2) & "." & Right(g_szStartDate, 2) &
					 " ~ " &
					 Mid(g_szEndDate, 3, 2) & "." & Mid(g_szEndDate, 5, 2) & "." & Right(g_szEndDate, 2)
	
	g_szGubun = "%"
	g_szStatus = "%"
	g_szCrcd = "%"
	g_szSort = "0"
	
	f_SetFilterName()
	f_SetFilterName2()
	
	if len(trim(g_szFullAcnt))	> 8 then
		f_InitValue()
		
		Request_Tran_obtsd_fbnk_232r()
	end if
End Sub

'============================================================================
Sub f_InitValue()
	g_nNextIdx = 0
	g_nGridIndex = 0 
	Pannel0.rowcount = 0

	imgNoData.visible = false
	lblNoData.visible = false	
End Sub

'==============================================
' 환전신청
'==============================================
Function Request_Tran_obtsd_fbnk_232r()	
	Pannel0.rowcount = 0
	
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_232r")
	
	'계좌번호
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_232r" , "InBlock1" , "ACNO" 			, 0 , left(g_szFullAcnt,8))
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_232r" , "InBlock1" , "ASNO" 			, 0 , right(g_szFullAcnt,2))
	
	'기간(From ~ To)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_232r", "InBlock1", "IQRY_STA_DATE"	, 0 , g_szStartDate)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_232r", "InBlock1", "IQRY_FIN_DATE" 	, 0 , g_szEndDate)
	
	'통화코드
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_232r", "InBlock1", "CRCD"			, 0 , g_szCrcd)
	
	'매수/매도 구분(전체:%, 매수:1, 매도:2)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_232r", "InBlock1", 	"IQRY_CLS_CODE"	, 0 , g_szStatus)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_232r", "InBlock1", "MNEC_CLCD"	, 0 , g_szGubun)
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_232r", "InBlock1", "SORT_CLCD"	, 0 , g_szSort)
	
	DATAMANAGER.RequestTranData("obtsd_fbnk_232r")
End Function

'==============================================
' 환전신청 처리
'==============================================
Function Process_Tran_obtsd_fbnk_232r()
	nCnt	= CDBL(DATAMANAGER.GetDataCount(0, "obtsd_fbnk_232r" , "OutBlock1"))
	
	If nCnt = 0 then
		imgNoData.visible = true
		lblNoData.visible = true
		
		if Pannel0.rowcount == "0" then
			Exit Function
		end if
	Else
		imgNoData.visible = false
		lblNoData.visible = false
	End if


	For i = 0 To nCnt - 1
'		'접수일자
		szData0       = DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "ACPT_DATE", i)	
'		'신청구분
		szData1		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "ACPT_SRNO", i)

		'신청일자
		szData2		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "APLT_YMDH", i)
		
'		'신청구분코드
'		szData3		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "APLT_CLS_CODE", i)
'		'우대적용구분
		szData4		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "PRFT_APLY_CLS_VAL", i)

		'환전구분코드
		szData5		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "MNEC_CLCD", i)
		'통화코드
		szData6		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "CRCD", i)
		
'		'환율문자
		szData7		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "UI_EXRT_LETT", i)

		'금액문자
		szData8		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "UI_AMT_LETT" , i)
		'시작일자
		szData9		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "STA_DATE", i)
		'종료일자
		szData10		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "FIN_DATE", i)
		'처리상태 구분코드
		szData11		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "PROS_STAT_CLS_CODE", i)
		
		'취소여부
		szData12		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "CNCL_YN", i)
		'취소일시
		szData13		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "CNCL_YMDH", i)
		'처리일자
		szData14		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "PROS_DATE", i)
		'처리여부
		szData15		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "PROS_YN", i)
		'만기여부
		szData16		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "MTRT_YN", i)
		'처리일시
		szData17		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "PROS_YMDH", i)
		'거래환율
		szData18		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "TR_EXRT", i)
		'표시통화코드1
		szData19		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "EXRS_CRCD1", i)
		'금액문자1
		szData20		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "UI_AMT_LETT1", i)
		'표시통화코드2
		szData21		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "EXRS_CRCD2", i)
		'금액문자2
		szData22		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "UI_AMT_LETT2", i)
		'결과구분명
		szData23		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "UI_RSLT_CLS_NAME", i)
		'채널유형구분명
		szData24		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "CHAN_TYPE_CLS_NAME", i)
		
		'채널유형구분명
		szData25		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_232r", "OutBlock1", "STND_EXRT", i)
	
		nIdx = Pannel0.AddRow()
		
		Pannel0.setPropCardCell("maintainratio", "imgArrow", nIdx, "2")
		Pannel0.setPropCardCell("imgpath", "imgArrow", nIdx, "icon_arrow")
		
		' 환전구분코드
		szMnecClcdName = ""
		
		szTargetExrt = ""
		if szData5 = "1" then
			szMnecClcdName = "외화매수"
			szTargetExrt = FormatNumber(szData7, 2) & " 이하"
		elseif szData5 = "2" then
			szMnecClcdName = "외화매도"
			szTargetExrt = FormatNumber(szData7, 2) & " 이상"
		else
			szMnecClcdName = ""
			szTargetExrt = "-"
		end if
		
		' 처리여부
		szProsStat = ""
		szTargetExrt_Total = ""
		if szData11 = "1" then
			szProsStat = "미처리"
			szTargetExrt_Total = "목표환율 " & szTargetExrt
		elseif szData11 = "2" then
			szProsStat = "처리완료"
			szTargetExrt_Total = "적용환율 " & FormatNumber(szData18, 2)
		elseif szData11 = "3" then
			szProsStat = "처리전"
			szTargetExrt_Total = "목표환율 " & szTargetExrt
		elseif szData11 = "5" then
			szProsStat = "취소완료"
			szTargetExrt_Total = "목표환율 " & szTargetExrt
		else
			szProsStat = "미확인"
			szTargetExrt_Total = "목표환율 " & szTargetExrt
		end if
		
		' 기간
		szPeriod = ""
		if szData11 = "2" then
			szPeriod = "체결  " & left(szData17, 10) 'mid(szData17, 3, 2) & "." & mid(szData17, 5, 2) & "." & right(szData17, 2)
		else
			szPeriod = "기간  " & mid(szData9, 3, 2) & "." & mid(szData9, 5, 2) & "." & right(szData9, 2) & " ~ " &   mid(szData10, 3, 2) & "." & mid(szData10, 5, 2) & "." & right(szData10, 2)
		end if
		
		' 신청금액
		szAmt = ""
		if szData6 == "JPY" then
			szAmt = FormatNumber(szData8,0) .. " " .. szData6
		else
			szAmt = FormatNumber(szData8,2) .. " " .. szData6
		end if
		
		
		
		'신청일자
		Pannel0.setPropCardCell("paddinginfo", "lblTrDate", nIdx, "0,0,0,0")
		Pannel0.setPropCardCell("fgcolor", "lblTrDate", nIdx, g_szTxtColor_Grey)
		Pannel0.setPropCardCell("caption", "lblTrDate", nIdx, szData0)
		
		'환전구분 | 처리여부
		Pannel0.setPropCardCell("paddinginfo", "lblGubun", nIdx, "0,0,0,0")
		Pannel0.setPropCardCell("fgcolor", "lblGubun", nIdx, g_szTxtColor_Normal)
		Pannel0.setPropCardCell("caption", "lblGubun", nIdx, szMnecClcdName .. " | ")
		
		Pannel0.setPropCardCell("paddinginfo", "lblGubun0", nIdx, "0,0,0,0")
		if szProsStat == "처리완료" then
			Pannel0.setPropCardCell("fgcolor", "lblGubun0", nIdx, g_szTxtColor_Normal)
		else
			Pannel0.setPropCardCell("fgcolor", "lblGubun0", nIdx, g_szTxtColor_Grey)
		end if

		Pannel0.setPropCardCell("caption", "lblGubun0", nIdx, szProsStat)
		
		nWidth = Form.getTextWidth(szMnecClcdName .. " | ", "-1", true, false)
		
		Pannel0.setPropCardCell("left", "lblGubun0", nIdx, 10+nWidth)

		
		'기간
		Pannel0.setPropCardCell("paddinginfo", "lblPeriod", nIdx, "0,0,0,0")
		Pannel0.setPropCardCell("fgcolor", "lblPeriod", nIdx, g_szTxtColor_Grey)
		Pannel0.setPropCardCell("caption", "lblPeriod", nIdx, szPeriod)
		
		'신청가격
		'매수매도구분 / 처리여부
		szMnCdColor	= getMnecCdColor(szData5, szData11)			
		Pannel0.setPropCardCell("paddinginfo", "lblFrAmt", nIdx, "0,0,0,0")
		Pannel0.setPropCardCell("fgcolor","lblFrAmt" , nIdx ,szMnCdColor)
		Pannel0.setPropCardCell("caption", "lblFrAmt", nIdx, szAmt)
		
		'목표환율
		Pannel0.setPropCardCell("paddinginfo", "lblExRate", nIdx, "0,0,0,0")
		if szData11 == "2" or szData11 == "3" then
			Pannel0.setPropCardCell("fgcolor", "lblExRate", nIdx, g_szTxtColor_Normal)
		else
			Pannel0.setPropCardCell("fgcolor", "lblExRate", nIdx, g_szTxtColor_Grey)
		end if
		
		Pannel0.setPropCardCell("caption", "lblExRate", nIdx, szTargetExrt_Total)
		
		'취소구분
		Pannel0.setPropCardCell("paddinginfo", "lblSubTask", nIdx, "0,0,0,0")
