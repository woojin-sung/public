			Pannel0.setPropCardCell("left", "lblSubTask", nIdx, "500")
			Pannel0.setPropCardCell("left", "lblSubTask0", nIdx, "220")
			Pannel0.setPropCardCell("caption", "lblSubTask0", nIdx, "기간종료")
			
		elseif szData11 = "2" then
			szKrwAmt = "-"
			
			if szData5 == "1" then
				if szData20 <> "" then
					szKrwAmt = szData20.." "..szData19
				end if
			elseif szData5 == "2" then
				if szData22 <> "" then
					szKrwAmt = szData22.." "..szData21
				end if
			end if 
			
			Pannel0.setPropCardCell("left", "lblSubTask", nIdx, "500")
			Pannel0.setPropCardCell("left", "lblSubTask0", nIdx, "220")
			Pannel0.setPropCardCell("caption", "lblSubTask0", nIdx, szKrwAmt)
		else
			Pannel0.setPropCardCell("caption", "lblSubTask", nIdx, "")
			Pannel0.setPropCardCell("caption", "lblSubTask0", nIdx, "")
			
			Pannel0.setPropCardCell("left", "lblSubTask", nIdx, "500")
			Pannel0.setPropCardCell("left", "lblSubTask0", nIdx, "500")
		end if
		
