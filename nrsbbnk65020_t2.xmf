		Pannel0.setPropCardCell("caption", "lblHide6", nIdx, szTargetExrt)
		Pannel0.setPropCardCell("caption", "lblHide18", nIdx, szData7)
		Pannel0.setPropCardCell("caption", "lblHide7", nIdx, szAmt)
		Pannel0.setPropCardCell("caption", "lblHide19", nIdx, szData8)
		Pannel0.setPropCardCell("caption", "lblHide8", nIdx, mid(szData9, 3, 2) & "." & mid(szData9, 5, 2) & "." & right(szData9, 2) & " ~ " &   mid(szData10, 3, 2) & "." & mid(szData10, 5, 2) & "." & right(szData10, 2))
		Pannel0.setPropCardCell("caption", "lblHide9", nIdx, szProsStat)
		
		szCancDate = ""
		if szData13 == "" then
			szCancDate = "-"
		else
			szCancDate = szData13'left(szData13, 4) & "-" & mid(szData13, 5, 2) & "-" & right(szData13, 2)
		end if
		Pannel0.setPropCardCell("caption", "lblHide10", nIdx, szCancDate)
		
		szTouchExrt = ""
		if szData25 == "" or Cdbl(szData25) == 0 then
			szTouchExrt = "-"
		else
			szTouchExrt = FormatNumber(szData25, 2)
		end if
		
		Pannel0.setPropCardCell("caption", "lblHide11", nIdx, szTouchExrt)
		
		szProcDate = ""
		if szData17 == "" then
			szProcDate = "-"
		else
			szProcDate = szData17 'left(szData17, 4) & "-" & mid(szData17, 5, 2) & "-" & right(szData17, 2)
		end if
	
		Pannel0.setPropCardCell("caption", "lblHide12", nIdx, szProcDate)
		
		szOrdExrt = ""
		
		if szData18 == "" or Cdbl(szData18) == 0 then
			szOrdExrt = "-"
		else
			szOrdExrt = FormatNumber(szData18, 2)
		end if
		Pannel0.setPropCardCell("caption", "lblHide13", nIdx, szOrdExrt)
		
		szSellAmt = ""
		if szData20 == "" then
			szSellAmt = "-"
		else
			szData20 = replace(szData20, ",", "")
			
			if Cdbl(szData20) == 0 then
				szSellAmt = "-"
			else
				if szData19 == "KRW" or szData19 == "JPY" then
					szSellAmt = FormatNumber(szData20, 0).." "..szData19
				else
					szSellAmt = FormatNumber(szData20, 2).." "..szData19
				end if
			end if
		end if
		Pannel0.setPropCardCell("caption", "lblHide14", nIdx, szSellAmt)
		
		szBuyAmt = ""
		if szData22 == "" then
			szBuyAmt = "-"
		else
			szData22 = replace(szData22, ",", "")
			
			if Cdbl(szData22) == 0 then
				szBuyAmt = "-"
			else
			
				if szData21 == "KRW" or szData21 == "JPY" then
					szBuyAmt = FormatNumber(szData22, 0).." "..szData21
				else
					szBuyAmt = FormatNumber(szData22, 2).." "..szData21
				end if
			end if
		end if
		Pannel0.setPropCardCell("caption", "lblHide15", nIdx, szBuyAmt)
		
		if szData23 == "" then
			szData23 = "-"
		end if
		Pannel0.setPropCardCell("caption", "lblHide16", nIdx, szData23)
		
		Pannel0.setPropCardCell("caption", "lblHide17", nIdx, szData24)		
		
		
	Next
	
		
End Function

'==============================================
' 환전신청
'==============================================
Function Request_Tran_obtsd_fbnk_231a()	
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_231a")
	
	' 신청구분 : 1(신청), 9(취소)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a", "InBlock1", "PROS_CLS_CODE"	, 0 , "9")
	
	' 계좌번호 정보
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a" , "InBlock1" , "ACNO" 			, 0 , left(g_szFullAcnt,8))
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a" , "InBlock1" , "ASNO" 			, 0 , right(g_szFullAcnt,2))

	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a" , "InBlock1" , "ACNT_PWD" 		, 0 , g_szPwd)
	
	szData0 = Pannel0.getPropCardCell("caption", "lblHide20", g_nIdx_Click)	'환전구분
	szData1 = Pannel0.getPropCardCell("caption", "lblHide19", g_nIdx_Click)	'거래금액
	szData2 = Pannel0.getPropCardCell("caption", "lblHide18", g_nIdx_Click)	'목표환율
	szData3 = Pannel0.getPropCardCell("caption", "lblHide5", g_nIdx_Click)	'통화코드
	szData4 = Pannel0.getPropCardCell("caption", "lblHide0", g_nIdx_Click)
	szData5 = Pannel0.getPropCardCell("caption", "lblHide1", g_nIdx_Click)
	
		
	' 환전구분 코드 : 1(매수), 2(매도)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a", "InBlock1", "MNEC_CLCD"		, 0 , szData0)
	
	' 외화금액
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a" , "InBlock1" , "FRCR_AMT" 		, 0 , szData1)

	' 통화코드
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a", "InBlock1", "CRCD"			, 0 , szData3)
	
	' 목표환율
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a", "InBlock1", "GOAL_EXRT"		, 0 , szData2)
	
	szData0 = Pannel0.getPropCardCell("caption", "lblHide0", g_nIdx_Click)
	szData1 = Pannel0.getPropCardCell("caption", "lblHide1", g_nIdx_Click)

	'취소주문
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a", "InBlock1", "ACPT_DATE"		, 0 , szData4)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_231a", "InBlock1", "ACPT_SRNO"		, 0 , szData5)

	DATAMANAGER.RequestTranData("obtsd_fbnk_231a")
End Function

