'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "ACNTINFO_CHG"	 then
		g_szFullAcnt = Form.GetCtlProp("#acnt01", "caption") 'g_szFullAcnt= Form.GetSharedData("&ACCOUNT", 0 )
				
		if len(trim(g_szFullAcnt)) > 8 then
			f_InitValue()
			
			Request_Tran_obtsd_fbnk_232r()	
		end if
	elseif sEventName = "CORRECT_PWD" then
		g_szPwd = sParam
		Request_Tran_obtsd_fbnk_231a()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obtsd_fbnk_232r" then
		Process_Tran_obtsd_fbnk_232r()
	elseif szTranID = "obtsd_fbnk_231a" then
		Form.ShowAlert("알림", "목표환율환전 신청이\n취소되었습니다.")
		
		Request_Tran_obtsd_fbnk_232r()
    End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox("알림" , szErrMsg & "\n(" & szSubMsg & ")" , "", 0)	
End Sub

'============================================================================
Function getMnecCdColor (szOrdGbn, szStat)
	
	'처리전(신청취소 가능) / 처리완료
	if szStat == "3" or szStat == "2" then
		'외화매수
		if szOrdGbn == "1" then
			return g_szTxtColor_Red
		'외화매도
		elseif szOrdGbn == "2" then
			return g_szTxtColor_Blue
		end if
	'취소완료
	elseif szStat == "5" then
		return g_szTxtColor_Normal
	'미처리/미확인
	else
		return g_szTxtColor_Grey
	end if
	
End Function

