'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "PERIOD_SET" then
		'조회 날짜 선택 후
		tData = Split(sRet, "@")
		
		g_szDateType = tData(0)
		g_szStartDate = tData(1)
		g_szEndDate = tData(2)
		
		lblDate.caption = Mid(g_szStartDate, 3, 2) & "." & Mid(g_szStartDate, 5, 2) & "." & Right(g_szStartDate, 2) &
							 " ~ " &
						 Mid(g_szEndDate, 3, 2) & "." & Mid(g_szEndDate, 5, 2) & "." & Right(g_szEndDate, 2)
		
		if len(trim(g_szFullAcnt))	> 8 then
			f_InitValue()
			Request_Tran_obtsd_fbnk_232r()
		
		end if
		
	elseif sKeyName = "nrsbbnk65020_p3" then
		'신청구분◆환전현황◆통화구분
		tData = Split(sRet, "◆")
		
		g_szGubun = tData(0)
		g_szStatus = tData(1)
		g_szCrcd = tData(2)	

		f_SetFilterName()
		f_SetFilterName2()
		

		if len(trim(g_szFullAcnt))	> 8 then
			f_InitValue()
			
			Request_Tran_obtsd_fbnk_232r()
			
			
		end if
	end if
End Sub

'============================================================================
Sub f_SetFilterName()
	dim szCode, szCode2, szCode3
	
	Select Case g_szGubun
		Case "%"
			szCode = "전체"
		Case "1"
			szCode = "외화매수"
		Case "2"
			szCode = "외화매도"
	End Select
	
	Select Case g_szStatus
		Case "%"
			szCode2 = "전체현황"
		Case "3"
			szCode2 = "처리전"
		Case "2"
			szCode2 = "처리완료"
		Case "5"
			szCode2 = "취소"
		Case "1"
			szCode2 = "미처리"
	End Select
	
	Select Case g_szCrcd
		Case "%"
			szCode3 = "전체통화"
		Case "USD"
			szCode3 = "미국"
		Case "JPY"
			szCode3 = "일본"
		Case "CNY"
			szCode3 = "중국"
		Case "HKD"
			szCode3 = "홍콩"
	End Select

	if g_szGubun == "%" and g_szStatus == "%" and g_szCrcd == "%" then
		lblFilter.caption = "전체"
	else
		lblFilter.caption = szCode .. "\n" .. szCode2 .. "·" .. szCode3	
	end if
End Sub


'============================================================================
Sub f_SetFilterName2()
	dim szCode
	
	Select Case g_szSort
		Case "0"
			szCode = "최근일순"
			imgFilter0.imgpath = g_ImgArrow_Down
		Case "1"
			szCode = "거래일순"
			imgFilter0.imgpath = g_ImgArrow_Down
	End Select
	
	lblFilter0.caption = szCode 
	
End Sub

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	if sCellID == "lblFrAmt" or sCellID == "imgArrow"  then
'		szApltSrNo = Pannel0.GetCellValue( "lblPeriod", nIndex)	'신청일련번호
'		if szApltSrNo <> "" and szApltSrNo <> null then

		szLinkData = ""
		
		for i = 0 to 17
			szData = Pannel0.getPropCardCell("caption", "lblHide"&i, nIndex)
			
			if i = 0 then
				szLinkData = szData
			else
				szLinkData = szLinkData &"`"& szData
			end if
		next
	
		Form.OpenPopup("nrsbbnk65020_p4" , szLinkData)	
'		end if
	elseif sCellID == "lblSubTask" then
		
		szText = Pannel0.getPropCardCell("caption",sCellID,nIndex)
		
		if szText == "신청취소" then
			g_nIdx_Click = nIndex
			Form.MsgBox("알림", "목표환율환전 신청을\n취소하시겠습니까?", "CANCEL_ORDER", 7, "취소하기", "닫기")
		end if
	end if
End Sub

'============================================================================
Sub Pannel0_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("obtsd_fbnk_232r") then
		DATAMANAGER.RequestNextData("obtsd_fbnk_232r")
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "CANCEL_ORDER" then
		if sRet == "ok" then
			Form.triggerEvent("#", "CHECK_PWD", "")
		end if
	end if
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	if Cint(iIndex) == 0 then
		g_szSort = "0"
	elseif Cint(iIndex) == 1 then
		g_szSort = "1"
	end if
	
	f_SetFilterName2()

	if len(trim(g_szFullAcnt))	> 8 then
		f_InitValue()
		
		Request_Tran_obtsd_fbnk_232r()
	end if
End Sub

