		if szData11 = "3" then
			Pannel0.setPropCardCell("left", "lblSubTask0", nIdx, "500")
			Pannel0.setPropCardCell("left", "lblSubTask", nIdx, "250")
			Pannel0.setPropCardCell("caption", "lblSubTask", nIdx, "신청취소")
