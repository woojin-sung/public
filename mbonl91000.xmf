'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_Institution_name
dim nRow

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert(szErrCode, szErrMsg)
End Sub
'============================================================================
'여기부터가 검색부분

'============================================================================
Sub Grid0_OnScrollEnd()
	DATAMANAGER.RequestNextData("obcmp_momt_473r")
End Sub

'============================================================================
Sub Button2_OnClick()
	temp = Form.GetSharedData("&EMPL_NO", false )
	
	if temp == null then
		Form.ShowAlert("오류", "접근이 불가능합니다")
		exit sub
	end if

	Form.OpenPopup("mbonl91000_p1.xmf" , "" , 0)
End Sub

'============================================================================
Sub Edit1_OnEditComplete()
	g_Institution_name = "%"&Edit1.caption&"%"
	
	if g_Institution_name == "" then
		g_Institution_name = "%"
	end if
End Sub



'============================================================================
Sub Form_OnFormInit()
	g_Institution_name = "%"
	nRow = 0	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
if szTranID == "obcmp_momt_473r" then
		temp_count = DATAMANAGER.GetDataCount(0, "obcmp_momt_473r", "OutBlock1")
	
		for i = 0 to temp_count-1
			if DATAMANAGER.GetDataValue(0, "obcmp_momt_473r", "OutBlock1", "RQST_TRGT_CLS_CODE" , i) == "1"
				then Grid0.SetCellData("bd_cell0", nRow, "행정기관")
			elseif DATAMANAGER.GetDataValue(0, "obcmp_momt_473r", "OutBlock1", "RQST_TRGT_CLS_CODE" , i) == "2"
				then Grid0.SetCellData("bd_cell0", nRow, "공직유관단체")
			elseif DATAMANAGER.GetDataValue(0, "obcmp_momt_473r", "OutBlock1", "RQST_TRGT_CLS_CODE" , i) == "3"
				then Grid0.SetCellData("bd_cell0", nRow, "공공기관")
			elseif DATAMANAGER.GetDataValue(0, "obcmp_momt_473r", "OutBlock1", "RQST_TRGT_CLS_CODE" , i) == "4"
				then Grid0.SetCellData("bd_cell0", nRow, "교육기관")
			elseif DATAMANAGER.GetDataValue(0, "obcmp_momt_473r", "OutBlock1", "RQST_TRGT_CLS_CODE" , i) == "5"
				then Grid0.SetCellData("bd_cell0", nRow, "언론사")
			elseif DATAMANAGER.GetDataValue(0, "obcmp_momt_473r", "OutBlock1", "RQST_TRGT_CLS_CODE" , i) == "6"
				then Grid0.SetCellData("bd_cell0", nRow, "기타기관")
			else
				Grid0.SetCellData("bd_cell0", nRow, "기타기관")
			end if
			
			
			nRow = nRow+1
		next
	end if	
End Sub

'============================================================================
Sub Button0_OnClick()
	nRow = 0
	
	DATAMANAGER.SetDataValue(0, "obcmp_momt_473r", "InBlock1", "RQST_TRGT_INNM", 0 , g_Institution_name)
	
	DATAMANAGER.RequestTranData("obcmp_momt_473r")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "INST_NAME" then
		Edit1.caption = sRet
		g_Institution_name = sRet
		
		nRow = 0
		DATAMANAGER.SetDataValue(0, "obcmp_momt_473r", "InBlock1", "RQST_TRGT_INNM", 0 , g_Institution_name)
	
		DATAMANAGER.RequestTranData("obcmp_momt_473r")
	end if
End Sub

