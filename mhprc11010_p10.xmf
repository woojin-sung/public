	<SCRIPT_INFO _len="6015" _ulen="5393" >
'============================================================================
' 화 면 명 : 관심종목_환경설정
' 화면설명 : 관심종목의 설정팝업
' 작    성 : 2016.01.15     ssang
'20230522 KKM START Bottom 팝업으로 변경, Watching 종목/최근조회 종목/보유종목 삭제
'============================================================================
'
' -- 종목 사용시 연결 화면	: GW_MOVE --
' 연결버튼 표시			: 0
' 현재가 화면으로 이동		: 1
' 주문 화면으로 이동		: 2
' 차트 화면으로 이동		: 3

' -- 기타 --
' 좌.우 스크롤시 관심그룹 변경	: GW_SWIPE
' 시세 변동 표시				: GW_RORDER

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
' 설정테이블
'Dim g_tSetTable()
'g_tSetTable = {}

' 항목 사용여부
Dim g_szClick
g_szClick = ""

Dim g_bFrist
g_bFirst = false

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Init_Control : 설정 초기화(0: 화면오픈, 1:초기화버튽클릭)
'============================================================================
Function Init_Control(nIdx)
	if nIdx == 1 then							' 초기화 버튼 클릭시
		RgStyle.currentindex = 0 '종목선택 연결화면(종목상세)
		RgBorder.currentindex = 0 '시세 변동 표시(사용)	
		RgSwipe.currentindex = 0 '좌.우 스크롤시 관심그룹 변경(사용)
		RgPosition.currentindex = 0 '20230731 KKM 종목추가 위치(맨위)	
	else										' Form_init
		if Form.GetEnvData("GW_MOVE") == "1" then
			RgStyle.currentindex = 1
		elseif Form.GetEnvData("GW_MOVE") == "2" then
			RgStyle.currentindex = 2
		elseif Form.GetEnvData("GW_MOVE") == "3" then
			RgStyle.currentindex = 3
		else
			RgStyle.currentindex = 0			
		end if
		
		if Form.GetEnvData("GW_SWIPE") == "" then	' 20160325 초기화 사용으로 변경
			RgSwipe.currentindex = 0
		else
			if Form.GetEnvData("GW_SWIPE") == "1" then
				RgSwipe.currentindex = 0
			else
				RgSwipe.currentindex = 1
			end if
		end if
		
		if Form.GetEnvData("GW_RORDER")	== "" then
			RgBorder.currentindex = 0
		else
			if Form.GetEnvData("GW_RORDER")	== "1" then
				RgBorder.currentindex = 0
			else

				RgBorder.currentindex = 1
			end if
		end if
		
		'20230731 KKM 종목추가 위치
		if Form.GetEnvData("GW_POSITION")	== "" then
			RgPosition.currentindex = 0
		else
			if Form.GetEnvData("GW_POSITION")	== "B" then '맨아래
				RgPosition.currentindex = 1
			else '맨위
				RgPosition.currentindex = 0
			end if
		end if		
	end if
End Function

Function Save_Control()
	Form.SetEnvData("1", "GW_MOVE", RgStyle.currentindex)  '종목선택 연결화면

	if RgSwipe.currentindex == "1" then	
		Form.SetEnvData("1", "GW_SWIPE", 0)		' 좌.우 스크롤시 관심그룹 변경
	else
		Form.SetEnvData("1", "GW_SWIPE", 1)		' 좌.우 스크롤시 관심그룹 변경
	end if	
	
	if RgBorder.currentindex == "1" then
		Form.SetEnvData("1", "GW_RORDER", 0)		' 시세 변동 표시	
	else
		Form.SetEnvData("1", "GW_RORDER", 1)		' 시세 변동 표시	
	end if	
	
	'20230731 KKM 종목추가 위치
	if RgPosition.currentindex == "1" then
		Form.SetEnvData("1", "GW_POSITION", "B")		' 맨아래
	else
		Form.SetEnvData("1", "GW_POSITION", "T")		' 맨위
	end if	
	
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szDefault

	Form.SetScreenName("환경설정")
	Init_Control(0)
End Sub

'============================================================================
' Form_OnFormClose 
'============================================================================
Sub Form_OnFormClose()
	' 관심종목화면에 셋팅 적용 알림
	'Form.SendReturnToParent("GW_SET", g_szClick)
End Sub

'============================================================================
' btnInit_OnClick : 초기화버튼 클릭
'============================================================================
Sub btnInit_OnClick()
	Init_Control(1)
End Sub

'============================================================================
Sub RgStyle_OnClick(nIndex)
	g_szClick = "CLICK"
End Sub

'============================================================================
Sub RgSwipe_OnClick(nIndex)
	g_szClick = "CLICK"
End Sub

'20230731 KKM 종목추가 위치 
'============================================================================
Sub RgPosition_OnClick(nIndex)
	g_szClick = "CLICK"	
End Sub

'============================================================================
Sub RgBorder_OnClick(nIndex)
	g_szClick = "CLICK"
End Sub
'
'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnSave_OnClick()
	'저장
	Save_Control() 
	' 관심종목화면에 셋팅 적용 알림
	Form.SendReturnToParent("GW_SET", g_szClick)
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnCancel_OnClick()
	'저장하지 않고 닫기
	Form.CloseForm()	
End Sub


	</SCRIPT_INFO>
</ROOT>