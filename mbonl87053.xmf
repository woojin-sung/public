'============================================================================
' 01. 화 면 명 : 금결원 계좌정보통합관리서비스 조회제한
' 02. 화면설명 : 금결원 계좌정보통합관리서비스 조회제한
' 03. 작    성 : 2019.09.03.최일규
' 04. 수    정 : 
' 2020.09.18 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
' 2021.05.22 : 정민영 : v0002 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obpds_srvc_045a IO변경분 적용
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szCustNum			'고객번호
Dim g_szPW				'비밀번호
Dim g_szAprvYn             '승인여부
Dim g_szProsCls            '처리구분(I.등록, D.해지)

Dim g_SUCS_YN				'처리결과
Dim g_INCL_Code			'KYC 투자성향등급코드
Dim g_PROD_Code			'KYC 상품등급코드
Dim g_DVPD_Code			'KYC 파생상품유의코드
Dim g_DRVT_YN				'KYC 파생 처리 여부
Dim g_STND_Date			'기준일자
Dim g_REG_Srno			'등록일련번호
Dim g_plain_rm  			'v0001 메모리평문적용여부
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' 
'============================================================================
Function SetTrans()
	
	DATAMANAGER.RequestTranData( "obpds_srvc_045a" )
	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' 
'============================================================================
Sub Form_OnFormInit()
	Dim szText
	
	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)

	edtPW.caption = ""
	szText = "<html><body><ol style='padding:15px;'><li>금융결제원이 운영하는 계좌정보통합관리서비스<br><br>"&
			"(www.payinfo.or.kr) 및 타기관 오픈뱅킹 이용 시<br><br>"&
			"계좌조회를 제한하는 서비스 입니다.<br></li>"&
			"<br><br>"&
			"<li>등록 시에도 당사 온라인채널에서의 업무는 변경되지<br><br>"&
			"않습니다.</li></ol>"
			&"</body></html>"
	web0.loaddata = szText
	
'	g_szCustNum = Form.GetSharedData( "&CUST_NUM" , false )
	
	g_SUCS_YN = Form.GetSharedData( "KYC_SUCS_YN" , false )
	g_STND_Date = Form.GetSharedData( "KYC_STND_DATE", false )
	g_REG_Srno = Form.GetSharedData( "KYC_REG_SRNO", false )
	' 현재는 703r TR에서 받아옴
	g_INCL_Code = Form.GetSharedData( "KYC_INVT_INCL_GRAD_CODE", false )
	g_PROD_Code = Form.GetSharedData( "KYC_PROD_GRAD_CODE", false )
	g_DVPD_Code = Form.GetSharedData( "KYC_DVPD_EPMD_CODE", false )
	g_DRVT_YN = Form.GetSharedData( "KYC_DRVT_PROS_YN", false )
	
	DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	
End Sub
'============================================================================
' 
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obpds_srvc_323r" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_323r", "InBlock1", "ACNO" , 0 , Left(acnt0.caption, 8) )
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_323r", "InBlock1", "ASNO" , 0 , mid(acnt0.caption,9,2) )
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_323r", "InBlock1", "SVCD" , 0 , "088"      )
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_323r", "InBlock1", "CSNO" , 0 , g_szCustNum)
	elseif szTranID == "obpds_srvc_045a" then			'088 금결원 계좌정보통합관리서비스 조회제한
	    if btnOK.caption == "등록" then
			g_szProsCls = "I"
		else
			g_szProsCls = "D"
		end if
		
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "ACNO" , 0 , Left(acnt0.caption, 8))
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "ASNO" , 0 , mid(acnt0.caption,9,2) )
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "ACNT_PWD" , 0 , g_szPW)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "CSNO" , 0 , g_szCustNum)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE" , 0 , g_szProsCls)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "SVCD" , 0 , "088")		'088 금결원 계좌정보통합관리서비스 조회제한
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "SVC_MANG_UNIT_CODE" , 0 , "03")
		
		'if g_SUCS_YN == "Y" then
		'DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "STND_DATE" , 0 , g_STND_Date)
		'DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "REG_SRNO" , 0 , g_REG_Srno)
		'DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "PROS_YN" , 0 , "Y")
		'DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0 , g_INCL_Code )
		'DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_PROD_GRAD_CODE" , 0 , g_PROD_Code)
		'DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , "02")
		'DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_DVPD_EPMD_CODE" , 0 , g_DVPD_Code)
		'DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_DRVT_PROS_YN" , 0 , g_DRVT_YN)
		'end if
	elseif szTranID == "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue( 0 , "obcsb_acif_000r", "InBlock1", "ACNO" , 0 , acnt0.total)
	end if
	
End Sub
'============================================================================
' 
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szMsgCode	
	
	
	if szTranID == "obpds_srvc_323r" then
		szMsgCode = DATAMANAGER.GetDataMsgCode( "obpds_srvc_323r" )
		g_szAprvYn = DATAMANAGER.GetDataValue( 0, "obpds_srvc_323r", "OutBlock1", "APRV_YN" , 0)
		if g_szAprvYn = "N" then
			tbl0.SetCellString( 0 , 1 , "등록" )
			btnOK.enable = true
			btnOK.caption = "해지"
		else
			tbl0.SetCellString( 0 , 1 , "미등록" )
			btnOK.enable = true
			btnOK.caption = "등록"
		end if
	elseif szTranID == "obcsb_acif_000r" then
		g_szCustNum = DATAMANAGER.GetDataValue( 0, "obcsb_acif_000r", "OutBlock1", "CSNO" , 0)
		
		tbl0.SetCellString( 0 , 1 , "" )
		DATAMANAGER.RequestTranData( "obpds_srvc_323r" )
		
	elseif szTranID == "obpds_srvc_045a" then
		Form.ShowAlert( "알림", "처리가 완료되었습니다.")
		DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
		edtPW.caption = ""
	end if
	
End Sub
'============================================================================
' 
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obpds_srvc_323r" then
		tbl0.SetCellString( 0 , 1 , "조회오류" )
	elseif szTranID == "obpds_srvc_045a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	end if
	
End Sub
'============================================================================
' 
'============================================================================
Sub btnOK_OnClick()
	Dim szData
	
	if edtPW.caption == "" then
		Form.ShowAlert( "알림" , "비밀번호를 입력하세요.")
		Exit Sub
	else
		SetTrans()
	end if

End Sub
'============================================================================
' 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "KYCCHK_RETURN" then			'투자성향진단 OK면 Y값내려줌
		if sRet == "Y" then
			SetTrans()
		end if
	end if
	
End Sub
'============================================================================
' 
'============================================================================
Sub edtPW_OnEditComplete()

	'v0001
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
		g_szPW = edtPW.caption
	else  'MTS메모리평문 미적용상태일때
		g_szPW = Form.GetEncData( edtPW.caption )
	end if
	
	DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	
End Sub
'============================================================================
' 
'============================================================================
Sub acnt0_ChangeAccount()

	DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	edtPW.caption = ""
	g_szPW = ""
	
End Sub

