--===========================================================================
Dim invest_grade_score
Dim invest_grade_code
Dim init_capital
Dim monthly_capital
Dim invest_term
Dim goal_amt
Dim uid
Dim get_uid

--===========================================================================

'============================================================================
Sub Button0_OnClick()
	
	if Edit0.caption <> "" and Edit1.caption <> "" and Edit2.caption <> "" and Edit3.caption <> "" then
	
	
		if get_uid <> uid then
		
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "CUST_ID", 0 , uid)               
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "USE_YN", 0 , "y")            
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "TOTAL_CSNU", 0 , invest_grade_score)        
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_INCL_GRAD_CODE", 0 , invest_grade_code)
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "FRST_CNRC_AMT", 0 , init_capital)     
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "SPLM_INVT_AMT", 0 , monthly_capital)     
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "AGE", 0 , Form.GetSharedData("Age_Value",false))               
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "ANTC_INVT_PRD", 0 , invest_term)     
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_DVPD_INVT_EXPC", 0 , Form.GetSharedData("Exp_Value",false))
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_INVT_KNLD", 0 , Form.GetSharedData("Know_Value",false))     
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "GOAL_AMT" ,0 , goal_amt)          
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_SCHL_REVN_YN", 0 , Form.GetSharedData("Regular_Earn_Value",false))
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "PROS_CLS_CODE", 0 , "i")
		
		
		
		else
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "CUST_ID", 0 , uid)               
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "USE_YN", 0 , "y")            
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "TOTAL_CSNU", 0 , invest_grade_score)        
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_INCL_GRAD_CODE", 0 , invest_grade_code)
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "FRST_CNRC_AMT", 0 , init_capital)     
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "SPLM_INVT_AMT", 0 , monthly_capital)     
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "AGE", 0 , Form.GetSharedData("Age_Value",false))               
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "ANTC_INVT_PRD", 0 , invest_term)     
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_DVPD_INVT_EXPC", 0 , Form.GetSharedData("Exp_Value",false))
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_INVT_KNLD", 0 , Form.GetSharedData("Know_Value",false))     
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "GOAL_AMT" ,0 , goal_amt)          
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "INP_SCHL_REVN_YN", 0 , Form.GetSharedData("Regular_Earn_Value",false))
			DATAMANAGER.SetDataValue(0, "obcpp_rbit_919a", "InBlock1", "PROS_CLS_CODE", 0 , "u")
			
		
		
		end if
	
		if invest_term > 0 and goal_amt > 0 and monthly_capital >= 0 and init_capital >= 0 then
	
			DATAMANAGER.RequestTranData("obcpp_rbit_919a")

			Form.OpenFramePopup("mbcpp70110.xmf","","")
			
			Form.CloseForm()
			Form.SendReturnToParent("PURPOSE_CLOSE","1")
		else
			if invest_term <= 0 then
				Form.ShowAlert("알림","투자 개월이 0이하로 설정되었습니다")
			elseif goal_amt <= 0 then
				Form.ShowAlert("알림","목표 금액이 0이하로 설정되었습니다")
			elseif monthly_capital < 0 then
				Form.ShowAlert("알림","월별 투자 금액이 너무 적습니다")
			elseif monthly_capital < 0 then
				Form.ShowAlert("알림","초기 투자 금액이 너무 적습니다")
			else
				Form.ShowAlert("")
			end if
		end if
	else
		Form.ShowAlert("알림","입력되지않은 값이 있습니다")
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	temp = Form.GetSharedData("&USER_NAME", false)
	
	Label10.caption = temp & "님은"
	
	invest_grade_score = (Cint(Form.GetOpenLinkData()) - 4)/67*100
	
	if invest_grade_score < 0 then
		invest_grade_score = 0
	end if
	
	Form.SetSharedData("User_Grade_Score", invest_grade_score)
	Invest_Grade(invest_grade_score)
	
	DATAMANAGER.SetDataValue(0, "obcpp_rbit_202r" , "InBlock1" , "INP_RISK_GRAD_SCOR" , 0 , invest_grade_score)
	DATAMANAGER.RequestTranData("obcpp_rbit_202r")                                                    

	
	
End Sub


Function Invest_Grade(invest_grade_score)

	if invest_grade_score <= 10 then
		Label4.caption = "이자소득형"
		Label4.fgcolor = "206"
		invest_grade_code = "1"
	elseif invest_grade_score > 10 and invest_grade_score <= 20 then
		Label4.caption = "안전투자선호형"
		Label4.fgcolor = "91"
		invest_grade_code = "2"
	elseif invest_grade_score > 20 and invest_grade_score <= 30 then
		Label4.caption = "채권선호형"
		Label4.fgcolor = "220"
		invest_grade_code = "3"
	elseif invest_grade_score > 30 and invest_grade_score <= 40 then
		Label4.caption = "혼합투자형"
		Label4.fgcolor = "84"
		invest_grade_code = "4"
	elseif invest_grade_score > 40 and invest_grade_score <= 50 then
		Label4.caption = "고수익채권형"
		Label4.fgcolor = "8"
		invest_grade_code = "5"
	elseif invest_grade_score > 50 and invest_grade_score <= 60 then
		Label4.caption = "주식펀드선호형"
		Label4.fgcolor = "203"
		invest_grade_code = "6"
	elseif invest_grade_score > 60 and invest_grade_score <= 70 then
		Label4.caption = "성장추구형"
		Label4.fgcolor = "207"
		invest_grade_code = "7"
	elseif invest_grade_score > 70 and invest_grade_score <= 80 then
		Label4.caption = "주식선호형"
		Label4.fgcolor = "101"
		invest_grade_code = "8"
	elseif invest_grade_score > 80 and invest_grade_score <= 90 then
		Label4.caption = "공격투자형"
		Label4.fgcolor = "59"
		invest_grade_code = "9"
		
	else
		Label4.caption = "파생상품선호형"
		Label4.fgcolor = "92"
		invest_grade_code = "10"
		
	end if
	
	Form.SetSharedData("User_Grade_Code", invest_grade_code)

End Function

'============================================================================
Sub Edit0_OnEditComplete()
	invest_term = (Cint(Edit0.caption) - Cint(Form.GetSharedData("Age_Value")))*12
	Form.SetSharedData("Invest_Term", (Cint(Edit0.caption) - Cint(Form.GetSharedData("Age_Value")))*12)
End Sub

'============================================================================
Sub Edit1_OnEditComplete()
	init_capital = Cint(Edit1.caption)
	Form.SetSharedData("Init_Capital", Edit1.caption)

End Sub

'============================================================================
Sub Edit2_OnEditComplete()
	monthly_capital = Cint(Edit2.caption)
	Form.SetSharedData("Monthly_Capital", Edit2.caption)
End Sub



'============================================================================
Sub Edit3_OnEditComplete()
	goal_amt = Cint(Edit3.caption)
	Form.SetSharedData("Goal_Amt", Edit3.caption)
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	uid = Form.GetSharedData("&USER_ID", uid)
	DATAMANAGER.SetDataValue(0,"obcpp_rbit_919r", "InBlock1", "CUST_ID" , 0 , uid)
	DATAMANAGER.RequestTranData("obcpp_rbit_919r")
		
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)                                                                                                               
	if szTranID = "obcpp_rbit_919r" then                                                               
		get_uid = DATAMANAGER.GetDataValue(0,"obcpp_rbit_919r", "OutBlock1", "CUST_ID" ,0)                
		Form.SetSharedData("DB_User_Id",get_uid)                                                          
	elseif szTranID = "obcpp_rbit_202r" then                                                            
		g_p_id = DATAMANAGER.GetDataValue(0, "obcpp_rbit_202r" , "OutBlock1" , "PRTF_ID", 0)              
		g_p_grade = DATAMANAGER.GetDataValue(0, "obcpp_rbit_202r" , "OutBlock1" , "INP_RISK_GRAD_CODE", 0)
		g_p_name = DATAMANAGER.GetDataValue(0, "obcpp_rbit_202r" , "OutBlock1" , "PRTF_NAME", 0)
		
		Form.SetSharedData("Shared_PNAME" , g_p_name)
	                                                                                                    
		Form.SetSharedData("Shared_PID",g_p_id)                                                           
		Form.SetSharedData("Shared_GRADE",g_p_grade)                                                      
	end if                                                                                                                                                                                            
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	

	

	
	
End Sub

