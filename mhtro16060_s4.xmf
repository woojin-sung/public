'20200910 SWJ START 메모리평문제거 (plain_rm = 0 미적용 / plain_rm = 1 적용)

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

' ----- 주문설정값 공통변수 Start -------------------------------------------
'주문 환경
Dim g_szOdrPop

' 가격, 수량 설정
Dim g_szAfterInit
Dim g_szChangeInit

' 주문후 
Dim g_szAfterOrg

' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm = ""

' ----- 주문설정값 공통변수 End ---------------------------------------------
Dim g_szCd, g_szNg, g_szMk
g_szCd = "" 
g_szNg = ""
g_szMk = ""

' 20181022 HWG START : 해외주식 주문착오 방지
Dim	g_szWarnFlag				' 주문 경고 확인플래그
g_szWarnFlag	= "N"
' 20181022 HWG END

Dim g_szTR

Dim g_szTitle
g_szTitle = "알림"

Dim g_szQty
g_szQty = ""

Dim g_bCntrtRtn		' 미체결리턴
g_bCntrtRtn = false

' 20171204 HAMWG START : 해외주식_공유변수 선언
Dim g_szOrdSize		' 매매단위
g_szOrdSize = ""

Dim g_szLast			' 현재가
g_szLast = ""

Dim g_szUpLimit		' 상한가
g_szUpLimit	=  ""

Dim g_szDnLimit		' 하한가
g_szDnLimit	=  ""

Dim g_szUnit			' 호가단위
g_szUnit		=  ""

Dim g_szDecimal		' 종목가격 자릿수
g_szDecimal	=  ""

Dim g_szKorName		' 한글종목명
g_szKorName	=  ""

Dim g_szTickType		' 종목틱타입
g_szTickType	=  ""
' 20171204 HAMWG END

'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************

'============================================================================
' Init_AfterOrder : 주문후 초기화
'============================================================================
Function	Init_InputControl()
	edtOrgNo.caption = ""
	edtOrgNo_OnEditComplete()
	
	g_szQty = ""	
	edtQty.caption = ""
	edtQty_OnEditComplete()	
End Function

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력
	
	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170725 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170725 HAMWG END
	
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if	
End Function

'============================================================================
' Check_InputData
'============================================================================
Function Check_InputData(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Check_Account(nGbn) == false then
		return false
	end if

	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if

	if Trim(edtOrgNo.caption) == "" then
		Form.ShowAlert(g_szTitle, "원주문번호를 입력하십시요.")
		return false
	end if
	
	if chkAll.checkstate == "0" then		' 일부잔량 선택시
		if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
			Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
			return false
		end if
	end if
		
	if nGbn <> 2 then	
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup()
		else
			Request_Order()
		end if
	end if
	
	return true
End Function

'============================================================================
' Open_ConfirmPopup
'============================================================================
Function Open_ConfirmPopup(szWarn)
	Dim szData
	sCodeData = Split(g_szCd, "@")	
	szData = "3"													' 매매구분
	szData = szData & "|" & Form.GetTopCtlProp("acnt", "caption")		' 계좌번호
	szData = szData & "|" & Form.GetTopCtlProp("acnt", "accountname")	' 계좌명
	szData = szData & "|" & sCodeData[1]								' 종목코드
	szData = szData & "|" & g_szKorName								' 종목명
	szData = szData & "|" & "지정가"								' 주문구분
	szData = szData & "|" & "0"										' 현금
	szData = szData & "|" & edtQty.caption							' 주문수량
	szData = szData & "|" & edtOrgNo.caption							' 원주문번호
	szData = szData & "|" & chkAll.checkstate						' 전량전부
	
	' 20181022 HWG START : 해외주식 주문착오 방지
	if Trim(szWarn) <> "" then		' 경고팝업 오픈
		szData = szData & "|" & szWarn		' 경고메세지		
		Form.OpenPopup("mhtro16060_p7", szData , "")		
	else							' 주문확인팝업 오픈
		Form.OpenPopup("mhtro16060_p6", szData , "") 
	end if
	' 20181022 HWG END
End Function

'============================================================================
' Request_Order
'============================================================================
Function Request_Order()
	g_szWarnFlag	= "N"	' 20181022 HWG : 해외주식 주문착오 방지
	DATAMANAGER.RequestTranData("obtro_oder_102a")
End Function

'============================================================================
' Check_Account
'============================================================================
Function Check_Account(nGbn)
	Dim szAcnt, szPwd
	
	szAcnt = Form.GetTopCtlProp("acnt", "caption")
	
	If Len(szAcnt) < 10 Then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
		return False
	end If
	
	if nGbn <> 2 then
		szPwd = Form.GetTopCtlProp("edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function

'============================================================================
' Return_ContractScreen : 미체결팝업에서 리턴된 값 적용
'============================================================================
Function Return_ContractScreen(szRet)
	tData = Split(szRet, "★")
	
	if UBound(tData) > 0 then
		szMkCd = Transform_Exid(tData(2))
		Form.triggerEvent("#", "16060_CONTRACT", szMkCd & "@" & tData(1) & "★" & tData(3))
		
		' 주문번호
		edtOrgNo.caption = tData(5)						
		edtOrgNo_OnEditComplete()
		
		' 주문일자
		g_szOrdDate = tData(4)

		' 수량
		g_szQty = ""
		edtQty.caption = tData(6)	
		edtQty_OnEditComplete()
		g_szQty = tData(6)
	end if
End Function

'============================================================================
' 거래소코드 <- 거래소 벤더코드
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "0104" then	' 홍콩
		return "HK"
	elseif sValue == "0215" then ' 상해
		return "SH"
	elseif sValue == "0214" then ' 심천거래소 종목
		return "SZ"
	elseif sValue == "0321" then ' 뉴욕
		return "NY"
	elseif sValue == "0066" then ' 아멕스
		return "AX"
	elseif sValue == "0537" then ' 나스닥
		return "OQ"
	elseif sValue == "0106" then ' 도쿄
		return "JP"
	end if
end Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Load_OrderSet() '주문설정값 읽어오기   
	chkAll_OnChange("1")
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	 plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
	
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 메인화면 이벤트 처리 (종목변경, 탭변경)
	' ----------------------------------------------------------------------		
	' 20171127 HAMWG START : 해외주식 종목코드 가져오기
	if sEventName == "16060_InitCode" or sEventName == "16060_ChangeCode" or sEventName == "16060_ChangeTab" then	
		if g_szCd <> sParam or g_szCd == "" then
			g_szCd = sParam
			sCodeData = Split(sParam, "@")		
			g_szNg = Form.GetItemCodeInfo(g_szCd, "ovsnation")	' 국가구분코드
			g_szMk = Form.GetItemCodeInfo(g_szCd, "exchid")	' 거래소벤더코드
		end if
		
		DATAMANAGER.RequestTranData( "ohhts_6000_001r" )
		
		if g_bCntrtRtn == false then
			if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
				Init_InputControl()
			end if
		else
			g_bCntrtRtn = false
		end if	
	' ----------------------------------------------------------------------
	' 계좌변경시 초기화
	' ----------------------------------------------------------------------	
	elseif sEventName == "16060_ChangeAcnt" then
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if
	' 20171127 HAMWG END	

	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' 20181022 HWG START : 해외주식 주문착오 방지
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	
	' 20181022 HWG END
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
	' ----------------------------------------------------------------------
	' 수량입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		g_szQty = sRet		
		edtQty_OnEditComplete()
	' ----------------------------------------------------------------------
	' 해외주식 미체결팝업 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "16060_CONTRACT" then
		if sRet == "" then
			Exit Sub
		end if
		
		g_bCntrtRtn = true
		Return_ContractScreen(sRet)	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	' ----------------------------------------------------------------------
	' 해외주식 취소주문
	' ----------------------------------------------------------------------	
	if szTranID == "obtro_oder_102a" then
		g_szTR = szTranID
		DATAMANAGER.ClearInputData(0, "obtro_oder_102a")

		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ACNO"					, 0, Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ASNO"					, 0, Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ACNT_PWD"				, 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else	
			DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ACNT_PWD"				, 0, Form.GetTopCtlProp("edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_DATE"				, 0, g_szOrdDate)								' 주문일자
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ORGL_ODER_NO"			, 0, edtOrgNo.caption)							' 원주문번호
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "PRTN_WHOL_TPCD"			, 0, "2")									' 전량체크
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODQT"					, 0, g_szQty)									' 주문수량
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_RCTF_CNCL_CLS_CODE"	, 0, "2")									' 주문정정취소구분
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_CLS_CODE"			, 0, "01")									' 주문구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_COND_CLS_CODE"		, 0, "0")									' 주문조건구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "ODER_OCRN_TYPE_CODE"		, 0, "01")									' 주문발생유형코드(01:일반주문)	
			
		DATAMANAGER.SetDataValue(0, "obtro_oder_102a", "InBlock1", "WARN_CNFR_YN"			, 0, g_szWarnFlag)							' 경고확인여부	' 20181022 HWG : 해외주식 주문착오 방지
	' ----------------------------------------------------------------------
	' 해외주식 시세조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_6000_001r" then
		Dim sCodeData, szDelay
	
		sCodeData = {}	' sCodeData[1] 마켓, sCodeData[2] 코드
		sCodeData = Split( g_szCd, "@" )
		
		szDelay = Form.GetSharedData("REALTIME_"..sCodeData[0], 0 )
	
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" ) ' 해외주식 OV
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCodeData[1] ) ' 종목코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sCodeData[0] ) ' 거래소코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay ) ' 실시간구분 0 : 실시간 (Default), 1:지연
	
	'20171204 HAMWG START : 해외주식_시세조회 서비스 세팅
	elseif szTranID == "getGtsHogaDetail" then
		DATAMANAGER.SetDataValue( 0, "getGtsHogaDetail", "inblock", "code" , 0 , g_szCd )
		
	' ----------------------------------------------------------------------
	' 고시환율 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtro_comn_025r" then
		szDate = Form.GetSharedData("&HOST_DATE", false)
		DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "STND_DATE" 	, 0 , szDate )
		DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "CRCD"		, 0 , g_szCur )

	end if
	'20171204 HAMWG END
End Sub
				
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szOdrMsg

	' ----------------------------------------------------------------------
	' 해외주식 취소주문
	' ----------------------------------------------------------------------	
	Select Case szTranID		
		Case "obtro_oder_102a"	
			' 20181022 HWG START : 해외주식 주문착오 방지
			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
			
			if szWarnCd = "1" then							' 경고
				Open_ConfirmPopup(szWarnMsg)
			elseif szWarnCd = "2" then						' 보류(해외주식 제외)
				g_szTR = ""
				'Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
			else
				g_szTR = ""
				
				szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
				szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
				
				if Trim(szOrdCd) == "0001" then			' 정상주문
					Form.Toast(0, szOrdMsg, true)
					
					if g_szAfterInit == "1" then		' 주문후 초기화
						Init_InputControl()
					end if
				end if
			end if
			' 20181022 HWG END

	' ----------------------------------------------------------------------
	' 해외주식 시세조회
	' ----------------------------------------------------------------------	
	' 20171204 HAMWG START : 해외주식_시세조회 데이터세팅
		Case "ohhts_6000_001r"

			g_szLast		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_PRPR" 	, 0 )	' 현재가
			g_szUpLimit	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_MXPR" 	, 0 )))	' 상한가
			g_szDnLimit	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_LLAM" 	, 0 )))	' 하한가
			g_szUnit		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_SHNU_ASPR_UNIT" 	, 0 )	' 호가단위
			g_szOrdSize 	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_SHNU_ODER_QTY_UNIT" , 0 )	' 매매단위
			g_szCur		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_CRNC_CODE" 	, 0 )	' 통화
			g_szDecimal 	=  tostring(_tonumber(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_DCPN_CNT" 	, 0 )))	' 가격소수점
			g_szKorName	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_KOR_ISNM" 	, 0 )	' 한글종목명
			g_szTickType	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_TICK_CLS" 	, 0 )	' 종목 틱타입
'			g_szKofx		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r", "OutBlock1", "FIDX_PRPR" 		, 0 )	' 환율
			
			sMask = "0,0,,,0,,"..g_szDecimal..",1,1,2,0"
			Table0.SetCellMaskInfo(2, 1, sMask)
			
			Table0.SetCellString(2, 0, g_szCur)
			Table0.SetCellString(0, 1, g_szOrdSize)
			
			DATAMANAGER.RequestTranData("obtro_comn_025r")
		Case "obtro_comn_025r"
			szAnncExrt = DATAMANAGER.GetDataValue( 0, "obtro_comn_025r", "OutBlock1", "ANNC_EXRT" , 0 )	' 고시환율
			Table0.SetCellString(1, 1, Cdbl(szAnncExrt))
			
		Case "obtro_oder_234r"
			szAbleQty = DATAMANAGER.GetDataValue( 0, "obtro_oder_234r", "OutBlock1", "ODER_ABLE_QTY" , 0 )	' 현금가능수량
			edtQty.caption = szAbleQty
	'20171204 HAMWG END
	End Select
	
	g_szWarnFlag = "N"	' 20181022 HWG : 해외주식 주문착오 방지
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if	
End Sub

