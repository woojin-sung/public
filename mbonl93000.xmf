	<SCRIPT_INFO _len="16268" _ulen="15320" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 공모부동산 분리과세 종목신청
' 02. 화면설명 : 공모부동산 분리과세 종목신청
' 03. 작    성 : 2020.04.22 장원혁
' 04. 수	   정 : 2020.09.15 조승행 비밀번호 메모리 평문 노출 취약점 조치 v001 
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'전역 변수 선언
Dim ACNO
Dim ASNO
Dim PASSWORD
Dim CURR_ROW

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()

    RefreshAll()
    
    Tab0.currenttab = 0
    Tab0_OnTabChanged(0)
	
End Sub

'============================================================================
Sub EditPW_OnEditComplete()

    ACNO = Left ( Account0.caption , 8 )
    ASNO = Right( Account0.caption , 2 )
    PASSWORD = EditPW.caption
    
    RefreshAll()
    
End Sub

'============================================================================
Sub Account0_ChangeAccount()

    ACNO = ""
    ASNO = ""
    PASSWORD = ""

    BtnInfr.enable = False
   
    RefreshAll()
    
    Tab0.currenttab = 0
    Tab0_OnTabChanged(0)
    	
End Sub

'============================================================================
Sub Tab0_OnTabChanged(nCurrentTab)

    RefreshAll()
    
    If nCurrentTab = 0 Then
    
        GridAplt.visible = True
        BtnAplt.visible = True
	
        GridCanc.visible = False
        BtnCanc.visible = False
        
    Else
    
        GridAplt.visible = False
        BtnAplt.visible = False
	
        GridCanc.visible = True
        BtnCanc.visible = True
	
    End If
    
End Sub


'============================================================================
Sub BtnRefresh_OnClick()

    RefreshAll()
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

    If szTranID = "obrtp_sptx_003r" Then
	
        If DATAMANAGER.IsMoreNextData(szTranID) = True Then
            DATAMANAGER.RequestNextData(szTranID)
        Else
	
            BtnRefresh.enable = True
            BtnInfr.enable = True
	    
            For i = 0 To GridAplt.rowcount - 1
	    
                If GridAplt.GetCellData("bd_cell9" , i) <> "펀드" And CDBL(GridAplt.GetCellData("bd_cell8" , i)) > 0 Then
                    GridAplt.SetCellBgColor("bd_cell3" , i , "29")
                End If
		
            Next
    
            For i = 0 To GridCanc.rowcount - 1
	    
                If GridCanc.GetCellData("bd_cell9" , i) <> "펀드" And CDBL(GridCanc.GetCellData("bd_cell8" , i)) > 0 Then
                    GridCanc.SetCellBgColor("bd_cell3" , i , "137")
                End If
		
		
            Next
	    
        End If

    End If
    
    If szTranID = "obrtp_sptx_004a" Then
    
        Form.MsgBox("", "처리가 완료되었습니다.", "", 0)
	
        RefreshAll()
	
    End If
    
    DATAMANAGER.ClearInputData(0 , szTranID)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    If szTranID = "obrtp_sptx_003r" Then
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        Form.MsgBox("종목지정내역 조회 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
        BtnRefresh.enable = False
    End If
    
    If szTranID = "obrtp_sptx_004a" Then
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        Form.MsgBox("신청처리 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
    End If
    
    DATAMANAGER.ClearInputData(0 , szTranID)
    
End Sub

'============================================================================
Sub GridAplt_OnClickUp(lRow, szCellID) 

    If szCellID = "bd_cell0" Then
    
        If GridAplt.GetCellData("bd_cell9" , lRow) = "펀드" Then
	
            Form.MsgBox("" , "펀드는 선택 불가합니다." , "" , 0)
            GridAplt.SetCellData("bd_cell0" , lRow , "0")
            Exit Sub
	    
        ElseIf CDBL(GridAplt.GetCellData("bd_cell8" , lRow)) <= 0 Then
	
            Form.MsgBox("" , "지정가능수량이 없습니다." , "" , 0)
            GridAplt.SetCellData("bd_cell0" , lRow , "0")
            Exit Sub
	    
        End If
    
    End If

    If szCellID = "bd_cell3" Then
    
        If GridAplt.GetCellData("bd_cell9" , lRow) = "펀드" Then
	
            Form.MsgBox("" , "펀드는 선택 불가합니다." , "" , 0)
            Exit Sub
	    
        ElseIf CDBL(GridAplt.GetCellData("bd_cell8" , lRow)) <= 0 Then
	
            Form.MsgBox("" , "지정가능수량이 없습니다." , "" , 0)
            Exit Sub
        
        ElseIf GridAplt.GetCellData("bd_cell9" , lRow) = "상장수익증권" Then
	
            Form.MsgBox("" , "상장수익증권은 전량지정만 가능합니다." , "" , 0)
            Exit Sub
	    
        Else
	
            CURR_ROW = lRow
            Form.OpenPopup("mbonl93000_p1" , GridAplt.GetCellData(szCellID, lRow) & "$" & GridAplt.GetCellData("bd_cell8", lRow), "")
	    
        End If
	
    End If

    
End Sub

'============================================================================
Sub GridCanc_OnClickUp(lRow, szCellID) 

    If szCellID = "bd_cell0" Then

        If GridCanc.GetCellData("bd_cell9" , lRow) = "펀드" Then
	
            Form.MsgBox("" , "펀드는 선택 불가합니다." , "" , 0)
            GridCanc.SetCellData("bd_cell0" , lRow , "0")
            Exit Sub
	    
        ElseIf CDBL(GridCanc.GetCellData("bd_cell8" , lRow)) <= 0 Then
	
            Form.MsgBox("" , "해지가능수량이 없습니다." , "" , 0)
            GridCanc.SetCellData("bd_cell0" , lRow , "0")
            Exit Sub
	    
        End If
    
    End If

    If szCellID = "bd_cell3" Then
    
        If GridCanc.GetCellData("bd_cell9" , lRow) = "펀드" Then
	
            Form.MsgBox("" , "펀드는 선택 불가합니다." , "" , 0)
            Exit Sub
	    
        ElseIf CDBL(GridCanc.GetCellData("bd_cell8" , lRow)) <= 0 Then
	
            Form.MsgBox("" , "해지가능수량이 없습니다." , "" , 0)
            Exit Sub
        
        ElseIf GridCanc.GetCellData("bd_cell9" , lRow) = "상장수익증권" Then
	
            Form.MsgBox("" , "상장수익증권은 전량해지만 가능합니다." , "" , 0)
            Exit Sub
	    
        Else
	
            CURR_ROW = lRow
            Form.OpenPopup("mbonl93000_p1" , GridCanc.GetCellData(szCellID, lRow) & "$" & GridCanc.GetCellData("bd_cell8", lRow), "")
	    
        End If
	
    End If
    
End Sub

'============================================================================
Sub BtnInfr_OnClick()

    Form.OpenPopup("mbonl93010_p1" , "" , "")
    
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
    If sKeyName = "APLT_AMT" Then
    
        If Tab0.currenttab = 0 Or Tab0.currenttab = "0" Then
	
            GridAplt.SetCellData("bd_cell3" , CURR_ROW , sRet)
            GridAplt.SetCellFgColor("bd_cell3" , CURR_ROW , "6")
	
            INVST_AMT	= CDBL(GridAplt.GetCellData("bd_cell3" , CURR_ROW)) * CDBL(GridAplt.GetCellData("bd_cell4" , CURR_ROW))
            GridAplt.SetCellData("bd_cell5" , CURR_ROW , INVST_AMT)
            GridAplt.SetCellFgColor("bd_cell5" , CURR_ROW , "6")
	    
        ElseIf Tab0.currenttab = 1 Or Tab0.currenttab = "1" Then	
	
            GridCanc.SetCellData("bd_cell3" , CURR_ROW , sRet)
            GridCanc.SetCellFgColor("bd_cell3" , CURR_ROW , "6")
	
            INVST_AMT	= CDBL(GridCanc.GetCellData("bd_cell3" , CURR_ROW)) * CDBL(GridCanc.GetCellData("bd_cell4" , CURR_ROW))
	    
            GridCanc.SetCellData("bd_cell5" , CURR_ROW , INVST_AMT)
            GridCanc.SetCellFgColor("bd_cell5" , CURR_ROW , "6")
	    
        End If    
	
	End If
	
    If sKeyName = "OKClick" And sRet = "1" Then
    
        ChkNotice.checkstate = "1"
        ChkNotice_OnChange("1")
        
    End If
    
End Sub

'============================================================================
Sub ChkNotice_OnChange(sCheckState)
    If ChkNotice.checkstate = "0" Then
        BtnAplt.enable = False
        BtnCanc.enable = False
    Else
        BtnAplt.enable = True
        BtnCanc.enable = True
    End If
End Sub

'============================================================================
Sub BtnAplt_OnClick()

	If ChkNotice.checkstate = "0" Then
	    Form.MsgBox("", "유의사항을 확인해주세요.", "", 0)
	    Exit Sub
	End If
	
    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_004a" , "InBlock1" , "CONT_CLS_CODE" , 0 , "4" )
    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_004a" , "InBlock1" , "ACNO"          , 0 , ACNO )
    DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_004a" , "InBlock1" , "ASNO"          , 0 , ASNO )
    
    'v001
    'MTS메모리평문 적용유무
    'plain_rm = ( 0 : 미적용 / 1: 적용)
     plain_rm = Form.GetSharedData("&PLAIN_RM", false )
    'MTS메모리평문 적용상태일 때
    if plain_rm == "1" then
		 DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_004a" , "InBlock1" , "PWD"  , 0 , PASSWORD )
    'MTS메모리평문 미적용상태 일 때 
	else
		 DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_004a" , "InBlock1" , "PWD"  , 0 , Form.GetEncData(PASSWORD) )
	end if
    
    prosIndex = 0
    
    For i = 0 To GridAplt.rowcount - 1
    
        If GridAplt.GetCellData("bd_cell0", i) = "1" Then
	    
            If prosIndex > 30 Then
                Form.MsgBox("", "한 번에 최대 30개 처리 가능합니다.", "", 0)
                Exit Sub	 
            End If

            If GridAplt.GetCellData("bd_cell3", i) <> "" And GridAplt.GetCellData("bd_cell4", i) Then
                SPTX_DSGT_AMT = GridAplt.GetCellData("bd_cell3", i) * GridAplt.GetCellData("bd_cell4", i)
            Else		
                SPTX_DSGT_AMT = 0
            End If	    

            DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_004a" , "InBlock2" , "SPTX_RCPY_BSWR_CODE" , prosIndex , "01" )
            DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_004a" , "InBlock2" , "CNCL_YN"             , prosIndex , "N"  )
            DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_004a" , "InBlock2" , "BYOV_DATE"           , prosIndex , GridAplt.GetCellData("bd_cell1", i) )
            DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_004a" , "InBlock2" , "ISCD"                , prosIndex , GridAplt.GetCellData("bd_cell6", i) )
            DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_004a" , "InBlock2" , "TR_QTY"              , prosIndex , GridAplt.GetCellData("bd_cell3", i) ) '신청수량(신청가능수량입력)
            DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_004a" , "InBlock2" , "SPTX_DSGT_AMT"       , prosIndex , SPTX_DSGT_AMT ) '신청수량 * 단가
            DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_004a" , "InBlock2" , "BYNG_UNPR"           , prosIndex , GridAplt.GetCellData("bd_cell4", i) ) '단가 
            DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_004a" , "InBlock2" , "RMND_SRNO"           , prosIndex , GridAplt.GetCellData("bd_cell7", i) ) '잔고일련번호
	    
            prosIndex = prosIndex + 1
	    
        End If	    
	
    Next
    
    If prosIndex = 0 Then 
        Form.MsgBox("" , "체크박스 선택 후 진행하여 주십시오." , "" , "")
        Exit Sub
    Else
        DATAMANAGER.RequestTranData( "obrtp_sptx_004a" )
    End If
	
End Sub

'============================================================================
