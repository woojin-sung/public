    Else
        DATAMANAGER.RequestTranData( "obrtp_sptx_004a" )
    End If
	
End Sub

'============================================================================
Sub RefreshAll()

    EditUsableLimt.caption = ""
    GridAplt.rowcount = 0
    GridCanc.rowcount = 0
    ChkNotice.checkstate = "0"
    ChkNotice_OnChange("0")
    
    BtnRefresh.enable = False

    If LEN(TRIM(ACNO)) > 0 And LEN(TRIM(ASNO)) > 0 And LEN(TRIM(PASSWORD)) > 0 Then
    
        DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_003r" , "InBlock1" , "ACNO" , 0 , ACNO )
        DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_003r" , "InBlock1" , "ASNO" , 0 , ASNO )
		
	   'v001
	   'MTS메모리평문 적용유무
	   'plain_rm = ( 0 : 미적용 / 1: 적용)
	    plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	   'MTS메모리평문 적용상태일 때
	    if plain_rm == "1" then
		   DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_003r" , "InBlock1" , "PWD"  , 0 , PASSWORD )
	    'MTS메모리평문 미적용상태 일 때
		else
	        DATAMANAGER.SetDataValue( 0 , "obrtp_sptx_003r" , "InBlock1" , "PWD"  , 0 , Form.GetEncData(PASSWORD) )
		end if
    
        DATAMANAGER.RequestTranData( "obrtp_sptx_003r" )    
	
    End If

End Sub

