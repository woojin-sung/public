		<BUTTON name="BtnRefresh" enable="0" fgcolor="004:000000000" btnimage="btn_refresh.9" ly_vert="307,105,32,31,1" />
		<BUTTON name="BtnInfr" enable="0" caption="유의사항보기" fontstyle="01" btnimage="btn_06.9" ly_vert="70,507,115,35,1" />
		<LABEL name="Label8" fontsize="-5" caption="3. 3년 이내 매도(해지 등) 시 분리과세를 적용받은 경우 원래 해당 배당소득" ly_vert="1,340,352,32,1" />
		<LABEL name="Label9" fontsize="-5" caption="발생분에 대한 신고서를 수정신고함에 따라 종합과세대상이 될 수 있습니다." ly_vert="13,350,381,32,1" />
