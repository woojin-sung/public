'============================================================================
Sub Form_OnFormInit()
	g_isEmpty_Code = true
	ItemCode0.code="empty"
	ItemCode0.caption = ""
	g_GridCnt = 0
	
	grd0.setSortCellID("th_cell1","bd_cell5")
	grd0.setSortCellID("th_cell19","bd_cell20")
	grd0.setSortCellID("th_cell20","bd_cell21")
	
	DATAMANAGER.RequestTranData("obrgt_oscm_772r")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szInputCode

	if g_isEmpty_Code == false then
		szInputCode = g_szSearchWord
	else
		szInputCode = "%"
	end if

	g_szAcno = left(acnt1.caption,8)
	g_szAsno = right(acnt1.caption,2)
	
	g_szCmb2 = Combo2.cbkeydata

	DATAMANAGER.SetDataValue( 0, "obrgt_oscm_553r", "InBlock1", "ACNO" , 0 , g_szAcno )
	DATAMANAGER.SetDataValue( 0, "obrgt_oscm_553r", "InBlock1", "ASNO" , 0 , g_szAsno )
	DATAMANAGER.SetDataValue( 0, "obrgt_oscm_553r", "InBlock1", "OVRS_STCK_RGHT_CLS_CODE" , 0 , g_szCmb2 )
	DATAMANAGER.SetDataValue( 0, "obrgt_oscm_553r", "InBlock1", "KOR_ISNM" , 0 , szInputCode )
	DATAMANAGER.SetDataValue( 0, "obrgt_oscm_553r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , "00" )
	DATAMANAGER.SetDataValue( 0, "obrgt_oscm_553r", "InBlock1", "IQRY_CLS_CODE" , 0 , "0" )
	DATAMANAGER.SetDataValue( 0, "obrgt_oscm_553r", "InBlock1", "STA_DATE" , 0 , cldFromDate.caption )
	DATAMANAGER.SetDataValue( 0, "obrgt_oscm_553r", "InBlock1", "FIN_DATE" , 0 , cldToDate.caption )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrgt_oscm_553r" then
		nCnt = DATAMANAGER.GetDataCount(0, "obrgt_oscm_553r", "OutBlock1")
		for i = 0 to nCnt-1
			szMarketCd = DATAMANAGER.GetDataValue(0, "obrgt_oscm_553r", "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , i)		
			if szMarketCd == "01" then
				grd0.SetCellData( "bd_cell10", g_nIndex + i, "미국")
			elseif szMarketCd == "02" then
				grd0.SetCellData( "bd_cell10", g_nIndex + i, "홍콩")
			elseif szMarketCd == "03" then
				grd0.SetCellData( "bd_cell10", g_nIndex + i, "상해")
			elseif szMarketCd == "04" then
				grd0.SetCellData( "bd_cell10", g_nIndex + i, "심천")
			elseif szMarketCd == "05" then
				grd0.SetCellData( "bd_cell10", g_nIndex + i, "일본")
			end if
			
			if     szMarketCd == "01" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "미국")
