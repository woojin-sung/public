'============================================================================
Sub ItemCode0_OnEditComplete(sCode)
	name = Form.GetItemCodeInfo(sCode, "name")	
	g_szSearchWord = name
	g_isEmpty_Code = false

	requestData()
End Sub

'============================================================================
Sub Combo2_OnEditComplete(iIndex)
	requestData()
End Sub

'============================================================================
Function requestData()
	grd0.SetClear()
	g_nIndex = 0
	DATAMANAGER.RequestTranData( "obrgt_oscm_553r" )
end Function


'============================================================================
Sub acnt1_ChangeAccount()
	requestData()
End Sub

'============================================================================
Function _tonumber(data)
	return tonumber(data) or 0
end Function

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName == "SEARCH" then
		if sReturn1 <> "" and sReturn1 <> null then
			g_szFullCode = sReturn1
			g_isEmpty_Code = false
			
			name = Form.GetItemCodeInfo(g_szFullCode, "name")	
			g_szSearchWord = name
			requestData()
		end if
	end if
End Sub

'============================================================================
Sub grd0_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obrgt_oscm_553r" )
End Sub

'============================================================================
Sub grd0_OnHeaderClickUp(lRow, szCellID)
	Dim sText
	
	if szCellID == "th_cell1" then
		if g_nBuffer2 == 0 then
			g_nBuffer2 = 1
			sText = "기준일자"
		else
			if g_nNameSort2 == 0 then
				g_nNameSort2 = 1
'				sText = "기준일자▼"		'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
				sText = "기준일자"
			elseif g_nNameSort2 == 1 then
				g_nNameSort2 = 2
'				sText = "기준일자▲"			'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
				sText = "기준일자"
			elseif g_nNameSort2 == 2 then
				g_nNameSort2 = 0
				sText = "기준일자"
			end if
		end if
		
		grd0.SetCellTopCaption( szCellID, sText )
		grd0.SetCellTopCaption( "th_cell19", "입금일자" )
		grd0.SetCellTopCaption( "th_cell20", "입출고일자" )
	end if
	
	if szCellID == "th_cell19" then
		if g_nBuffer1 == 0 then
			g_nBuffer1 = 1
			sText = "입금일자"
		else
			if g_nNameSort1 == 0 then
				g_nNameSort1 = 1
'				sText = "입금일자▼"		'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
				sText = "입금일자"
			elseif g_nNameSort1 == 1 then
				g_nNameSort1 = 2
'				sText = "입금일자▲"		'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
				sText = "입금일자"
			elseif g_nNameSort1 == 2 then
				g_nNameSort1 = 0
				sText = "입금일자"
			end if
		end if
		grd0.SetCellTopCaption( szCellID, sText )
		grd0.SetCellTopCaption( "th_cell1", "기준일자" )
		grd0.SetCellTopCaption( "th_cell20", "입출고일자" )
	end if
	
	if szCellID == "th_cell20" then
		if g_nBuffer2 == 0 then
			g_nBuffer2 = 1
			sText = "입출고일자"
		else
			if g_nNameSort2 == 0 then
				g_nNameSort2 = 1
'				sText = "입출고일자▼"			'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
				sText = "입출고일자"
			elseif g_nNameSort2 == 1 then
				g_nNameSort2 = 2
'				sText = "입출고일자▲"			'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
				sText = "입출고일자"
			elseif g_nNameSort2 == 2 then
				g_nNameSort2 = 0
				sText = "입출고일자"
			end if
		end if
		grd0.SetCellTopCaption( szCellID, sText )
		grd0.SetCellTopCaption( "th_cell1", "기준일자" )
		grd0.SetCellTopCaption( "th_cell19", "입금일자" )
	end if
End Sub

