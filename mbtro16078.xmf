			elseif szMarketCd == "07" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "싱가폴")
			elseif szMarketCd == "10" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "독일")
			elseif szMarketCd == "11" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "핀란드")
			elseif szMarketCd == "12" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "프랑스")
			elseif szMarketCd == "13" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "벨기에")
			elseif szMarketCd == "14" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "네덜란드")
			elseif szMarketCd == "15" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "포르투갈")
			elseif szMarketCd == "16" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "그리스")
			elseif szMarketCd == "17" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "아일랜드")
			elseif szMarketCd == "18" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "이탈리아")
			elseif szMarketCd == "19" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "스페인")
			elseif szMarketCd == "20" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "오스트리아")
			elseif szMarketCd == "21" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "캐나다")
			elseif szMarketCd == "23" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "인도네시아")
			elseif szMarketCd == "24" then grd0.SetCellData( "bd_cell10", g_nIndex + i, "베트남")
			end if
			
			szRghtCd = DATAMANAGER.GetDataValue(0, "obrgt_oscm_553r", "OutBlock1", "OVRS_STCK_RGHT_CLS_CODE" , i)	
			if szRghtCd == "01" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "유상")
