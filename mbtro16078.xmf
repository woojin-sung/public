			elseif szRghtCd == "09" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "코드변경")
			elseif szRghtCd == "10" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "주총")
			elseif szRghtCd == "11" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "매수청구")
			elseif szRghtCd == "20" then
				grd0.SetCellData( "bd_cell0", g_nIndex + i, "공개매수")
			end if
		next
		
		bNext = DATAMANAGER.IsMoreNextData( "obrgt_oscm_553r" )
		
		g_nIndex = _tonumber( grd0.rowcount )
	end if
End Sub

