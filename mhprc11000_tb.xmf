'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 주식현재가
' 02. 화면설명 : 주식현재가 투자의견탭
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()

	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	
End Sub

'============================================================================
Sub Form_OnFormInit()

'	DATAMANAGER.RequestTranData( "ohhts_1652_001r" )

End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
'			Form.triggerEvent( "#", "REQUEST_ITEMCODE", "")
			Exit Sub
		End If	
	
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
  
		DATAMANAGER.RequestTranData( "ohhts_1652_001r" )
		
	 end if
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		DATAMANAGER.RequestTranData( "ohhts_1652_001r" )
	end	if
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szDate
	
	szDate = Form.GetSharedData("&HOST_DATE", false )

	if szTranID = "ohhts_1652_001r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1652_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_1652_001r", "InBlock1", "FID_INPUT_ISCD"				, 0, g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_1652_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_1652_001r", "InBlock2", "FID_INPUT_ISCD"				, 0, g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_1652_001r", "InBlock2", "FID_INPUT_DATE2"				, 0, szDate )
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)

	DATAMANAGER.SetDataValue( 0, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD" , 0, g_szItemCode )
	DATAMANAGER.SetDataValue( 0, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD"  , 0, g_szItemCode )
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szURL, szFileName, szTitle
	
	szURL 		= "http://home.imeritz.com/HKCPDF" 
	szFileName 	= grd0.GetCellData( "bd_cell4", lRow )
	szTitle		= grd0.GetCellData( "bd_cell5", lRow )
	
	if Trim(szFilename) <> "" then	
'		Form.OpenPdfViewer( szURL + szFileName, sTitle )
		Form.OpenPdfViewer( szURL + szFileName, "투자의견" )
	end if
End Sub





