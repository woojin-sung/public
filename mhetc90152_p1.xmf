g_sPannelClickFlag = False

Dim g_sArrCloudID
g_sArrCloudID = Array()

Dim g_sArrCloudDN
g_sArrCloudDN = Array()
'============================================================================
Sub Form_OnFormInitBefore()
	Container0.ImgBackPress.setMaintainingRatio("1")
	Container0.ImgInfo.setMaintainingRatio("1")
	
	Form.transmode = false 'true 불투명, false 투명
	
	szDev = Form.GetSharedData("&SERVER_MODE", False)
	
	if szDev == "1" then
		Container0.Button0.visible = true
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	Form.transmode = true 'true 불투명, false 투명
	Container0.visible = true
	
	g_szData = Form.GetOpenLinkData()
	
	if g_szData <> "" then
		Container0.labTitle.caption = g_szData
	end if
	
	Pannel0.rowcount = 0
	Form.SetTimerEvent2(1,1,0.1)
End Sub

'
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'클라우드연결(고객정보) 입력 -> 기기인증 후 리턴 (From mhetc90303)
		'InProgress 진행중
		'Complete 완료
		'Canceled 취소
		'AuthCodeDoesNotMatch 인증번호 불일치
		'Timeout 타임아웃
		'AuthCodeInvalidated 인증코드 전송횟수 초과

	if sKeyName == "CLOUDCERT_DEVICE_AUTH" then
		' sRet
		' 	- InProgress 진행중
		' 	- Complete 완료
		' 	- Canceled 취소
		' 	- AuthCodeDoesNotMatch 인증번호 불일치
		' 	- Timeout 타임아웃
		' 	- AuthCodeInvalidated 인증코드 전송횟수 초과		
		
		if sRet == "Complete" then
			Form.CloseForm()
			Form.SendReturnToParent("CLOUD_CHECK_CONNECT", "OK")	
		
		elseif sRet == "Canceled" then
			Form.MsgBox("알림", "클라우드연결을 위한 단말인증이 취소되었습니다.", "", 0)
			
		elseif sRet == "AuthCodeDoesNotMatch" then
			Form.MsgBox("알림", "클라우드연결을 위해 입력한 인증번호가 맞지않습니다.", "", 0)
			
		elseif sRet == "Timeout" then
			Form.MsgBox("알림", "클라우드연결을 위한 인증유효시간이 지났습니다.", "", 0)				

		elseif sRet == "AuthCodeInvalidated" then
			Form.MsgBox("알림", "클라우드연결을 위한 인증코드 전송횟수가 초과되었습니다. .", "", 0)				
		end if		
		
		Form.CloseForm()
		Form.SendReturnToParent("CLOUD_CHECK_CONNECT", "NO")
	end if
End Sub

