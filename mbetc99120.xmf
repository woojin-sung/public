	<SCRIPT_INFO _len="7724" _ulen="7416" >
'--===========================================================================
'Global variable
'--===========================================================================
dim nRow
dim count
dim tmp
dim f_MOD_YMDH	'표현을 위한 조작일자 YYYY-MM-DD
dim tr_MOD_YMDH	'삭제를 위한 조작일자 YYYY-MM-DD HH:mm:SS
dim f_M3_ERT
dim f_M6_ERT
dim f_fee
dim login
dim g_u_id

dim g_prtfID, g_custID, g_fptname, g_svptname, g_M3_ERT, g_p_grade
'--===========================================================================

Sub Form_OnFormInitBefore()
	g_u_id = Form.GetSharedData("&USER_ID", false )
	
	'Container0.Grid0.SetClear( )
	
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "PRTF_NAME" , 0 , "" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "IQRY_STA_DATE" , 0 , "" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "IQRY_FIN_DATE" , 0 , "" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "IQRY_CLS_CODE" , 0 , "3" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "CUST_ID" , 0 , g_u_id )
	

End Sub
'============================================================================
Sub Form_OnFormInit()
	
	DATAMANAGER.RequestTranData("obcpp_rbit_020r")
	
End Sub
'--===========================================================================
Sub Container0_Grid0_OnClickUp(lRow, szCellID)
	
	if lRow < nRow then
	
	g_prtfID	=	Container0.Grid0.GetCellData("bd_cell7", lRow)
	g_custID	=	Container0.Grid0.GetCellData("bd_cell6", lRow)
	g_fptname =	Container0.Grid0.GetCellData("bd_cell1", lRow)
	g_svptname =	Container0.Grid0.GetCellData("bd_cell2", lRow)
	g_M3_ERT =	Container0.Grid0.GetCellData("bd_cell3", lRow)
	tr_MOD_YMDH = Container0.Grid0.GetCellData("bd_cell5", lRow)
	g_p_grade=	Container0.Grid0.GetCellData("bd_cell11", lRow)
	

	listLocation = Split(Container0.Grid0.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	sPopupType = "2"
		
	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" & "J" & "★" & "상품 상세보기" & "★" & "관심상품 삭제" & "★" & "목록" & "★" & " " & "★" & " " )
	
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	dim szListItems		'미니팝업아이템

	if sKeyName = "MOVEPOP_RETURN" then     '미니팝업처리
		szListItems	=	split(sRet,"★")
		
		if szListItems(1)	=	"0" then 	'관심상품 상세보기
			'포폴ID, 포폴 등급코드
			Form.SetSharedData("Shared_PID" , g_prtfID)	' 포트폴리오ID
			Form.SetSharedData("Shared_GRADE" , g_p_grade)	' 포트폴리오위험등급코드
			
			Form.OpenFramePopup("mbcpp70110.xmf" , "" , "")
			
			
		elseif szListItems(1)	=	"1" then ' 관심상품 삭제
		
			Form.SetSharedData( "szfavID" , g_prtfID )
			Form.SetSharedData( "szfavmodYMDH" , tr_MOD_YMDH )
			Form.SetSharedData( "szfavcustID" , g_custID )
			Form.SetSharedData( "szfaptName" , g_fptname )
			Form.SetSharedData( "szfa3ERT" , g_M3_ERT )
			Form.SetSharedData( "szfasvptname" , g_svptname)
			
			
			Form.OpenPopup("mbcpp70120_p1.xmf" , "" , "")
							
		end if
		
	end if
	
	if sKeyName = "cancel" then
	
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "PRTF_NAME" , 0 , "" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "IQRY_STA_DATE" , 0 , "" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "IQRY_FIN_DATE" , 0 , "" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "IQRY_CLS_CODE" , 0 , "3" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "CUST_ID" , 0 , g_u_id )
	
	
	DATAMANAGER.RequestTranData("obcpp_rbit_020r")
		
	end if

End Sub

'============================================================================
Sub Button0_OnClick()

	'Container0.Grid0.SetClear( )

	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "PRTF_NAME" , 0 , "%"&Edit0.caption&"%" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "IQRY_STA_DATE" , 0 , "" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "IQRY_FIN_DATE" , 0 , "" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "IQRY_CLS_CODE" , 0 , "1" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "CUST_ID" , 0 , g_u_id )
	
		
	DATAMANAGER.RequestTranData("obcpp_rbit_020r")
	
End Sub

'============================================================================
Sub Button1_OnClick()

	'Container0.Grid0.SetClear( )
		
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "PRTF_NAME" , 0 , "" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "IQRY_STA_DATE" , 0 , cld0.caption )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "IQRY_FIN_DATE" , 0 , cld1.caption+1 )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "IQRY_CLS_CODE" , 0 , "2" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "CUST_ID" , 0 , g_u_id )
	
		
	DATAMANAGER.RequestTranData("obcpp_rbit_020r")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	
	
	
	count = DATAMANAGER.GetDataCount( 0, "obcpp_rbit_020r" , "OutBlock1" )
	
	nRow = 0
	
	for i=0 to count-1
	
	Container0.Grid0.AddRow()
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "CUST_ID" ,i) ' 고객ID
	Container0.Grid0.SetCellData("bd_cell6",nRow, tmp )		
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "MOD_YMDH" ,i) ' 수정일시
	f_MOD_YMDH = left(tmp, 10)
	Container0.Grid0.SetCellData("bd_cell0",nRow, f_MOD_YMDH )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "MOD_YMDH" ,i) ' 삭제용 수정일시
	Container0.Grid0.SetCellData("bd_cell5",nRow, tmp )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "PRTF_ID" ,i) ' 포트폴리오ID
	Container0.Grid0.SetCellData("bd_cell7",nRow, tmp )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "PRTF_NAME" ,i) ' 사용자가 저장한 포트폴리오 명
	Container0.Grid0.SetCellData("bd_cell2",nRow, tmp )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "USE_YN" ,i) ' 사용여부
	Container0.Grid0.SetCellData("bd_cell8",nRow, tmp )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "M3_ERT" ,i) ' 3개월 수익률
	f_M3_ERT = mid(tmp, 16, 3)
	Container0.Grid0.SetCellData("bd_cell3",nRow, f_M3_ERT )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "M6_ERT" ,i) ' 6개월 수익률
	f_M6_ERT = mid(tmp, 16, 3)
	Container0.Grid0.SetCellData("bd_cell4",nRow, f_M6_ERT )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "FEE" ,i) ' 수수료
	
		if mid(tmp,18,1) == "0" then
	
			f_fee = right(tmp,1)
	
		else
			f_fee = right(tmp,2)
		
		end if
	
	Container0.Grid0.SetCellData("bd_cell9",nRow, f_fee & "%" )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "CSNM" ,i) ' 상품명
	Container0.Grid0.SetCellData("bd_cell1",nRow, tmp )
	
	tmp=DATAMANAGER.GetDataValue(0, "obcpp_rbit_020r", "OutBlock1", "INP_RISK_GRAD_CODE" ,i) '포트폴리오위험등급코드
	Container0.Grid0.SetCellData("bd_cell11",nRow, tmp )
	
	nRow = nRow+1
	
	next
End Sub

'============================================================================
Sub Container0_Grid0_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obcpp_rbit_020r" )
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranId == "obcpp_rbit_020r" then
		Container0.Grid0.SetClear()
	end if
