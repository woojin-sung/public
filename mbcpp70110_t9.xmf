		</CHARTEX>
		<LABEL name="Label3" fgcolor="006:213049051" fontsize="-2" fontstyle="01" mask="0,0,,%,0,,2,1,1" halign="1" ly_vert="210,175,100,25,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="4027" _ulen="3945" >
--===========================================================================
--===========================================================================

Dim g_pid



'============================================================================
Sub Form_OnFormInitBefore()


		g_pid = Form.GetSharedData("Shared_PID",false ) 

	
		DATAMANAGER.SetDataValue(0, "obcpp_rbit_004r", "InBlock1", "PRTF_ID", 0 , g_pid)
		
		DATAMANAGER.RequestTranData("obcpp_rbit_004r")
		
			
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	ChartEx0.SetAccrueName("수익률")                                                  
                                                                                                     
	'ChartEx0.SetAccrueData("period=5=YYMMDD")                                                           
	ChartEx0.SetPeriodType(2)	                                                              
                                                                                                
	ChartEx0.SetAccrueData("initdata=20150301;20150601;20150901;20160101;20160301")                                    
	ChartEx0.SetAccrueData("changetitle=".."수익률".."=;")           
                             
                         
	ChartEx0.SetChartType("line")
	ChartEx0.setLineColor("수익률;255;0;0")
	  	
'------------------------------------------------------------------------------------------	
	ChartEx1.SetAccrueName("샤프지수,표준편차")                                                  
                                                                                               
	ChartEx0.SetPeriodType(2)	                                                           
	                                                                                      
	ChartEx1.SetAccrueData("initdata=20150301;20150601;20150901;20160101;20160301") 
	ChartEx1.SetAccrueData("changetitle=".."샤프지수"..";".."표준편차".."=;")           
    
	                         
	 
	 ChartEx1.setLineColor("샤프지수;100;255;50")
	 ChartEx1.setLineColor("표준편차;0;0;255")
	 
	
	
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "obcpp_rbit_004r" then
	ChartEx0.SetPriceFormat("data1^10^2")	
	temp0= DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "M1_ERT" , 0)
	temp1= DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "M3_ERT" , 0)
	temp2= DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "M6_ERT" , 0)
	temp3= DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "M12_ERT" , 0)
	temp4= DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "M36_ERT" , 0)
	

	ChartEx0.SetAccrueData("자료일자=150301;150601;150901;160101;160301")       
	ChartEx0.SetAccrueData("data1="&temp0&";"&temp1&";"&temp2&";"&temp3&";"&temp4&"=2")
		
	ChartEx0.SetAccrueData("repaintall");	 
	
	
	Label3.caption= (temp1+temp2+temp3+temp4)/4
	ChartEx1.SetPriceFormat("data1^10^2")
	ChartEx1.SetPriceFormat("data2^10^2")
	
	
	temp5= DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "M1_LSRT" , 0)
	temp6= DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "M3_LSRT" , 0)
	temp7= DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "M6_LSRT" , 0)
	temp8= DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "M12_LSRT" , 0)
	temp9= DATAMANAGER.GetDataValue(0, "obcpp_rbit_004r", "OutBlock1", "INP_M36_LSRT" , 0)
	
	
	temp1 = temp1/temp5
	temp2 = temp2/temp6
	temp3 = temp3/temp7
	temp4 = temp4/temp8
	temp5 = temp4/temp9

	ChartEx1.SetAccrueData("자료일자=150301;150601;150901;160101;160301")       
	ChartEx1.SetAccrueData("data1="&temp5&";"&temp6&";"&temp7&";"&temp8&";"&temp9&"=2")
	ChartEx1.SetAccrueData("data2="&temp0&";"&temp1&";"&temp2&";"&temp3&";"&temp4&"=2")
	
	
	ChartEx1.SetAccrueData("repaintall");	


	end if
	
End Sub

