		szIndex = contScroll.btnOnOff.switchindex
		if szIndex == "1" or szIndex == 1 then
			DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "AGRM_YN" , 0 , "Y" )
		else
			DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "AGRM_YN" , 0 , "N" )
		end if


	elseif szTranID == "obcsb_acif_705u" then
		Dim sCSNO, sSTND_DATE, sREG_SRNO
		sCSNO = Form.GetSharedData("KYC_CSNO", false)
		sSTND_DATE = Form.GetSharedData("KYC_STND_DATE", false)
