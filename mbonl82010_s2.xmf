	'연락처번경으로 메뉴이동
	'LHR 수정
	'Form.OpenScreen("81000", "")
	Form.OpenFramePopup("mbonl81000" , "" , "")
End Sub

'============================================================================
Sub contScroll_btnOnOff_OnClick()
	if g_bSwitchInit == true then
		g_bSwitchInit = false
	else
		Dim szIndex
		szIndex = contScroll.btnOnOff.switchindex
		
		if szIndex == "1" or szIndex == true or szIndex == 1 or szIndex == "true"  then
			'LHR 수정
			'Form.OpenPopup("mbonl82010_p1" , "" , "")	
			Form.OpenPopupAnimation("mbonl82010_p1" , "" , "", "2")	
		end if
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	Dim sACNT_PWD
	Dim plain_rm
	
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then
		sACNT_PWD = g_szActPwd
	'MTS메모리평문 미적용상태일때
	else
		sACNT_PWD = Form.GetEncData(g_szActPwd)
	end if
	
'	Form.ShowAlert("sACNT_PWD", sACNT_PWD)
	
	if szTranID == "obcsb_acad_122a" then
		If g_szButtonRadio2 == "1" Then  '알림톡/문자
			Dim szNumber
			szNumber = contScroll.tblInfo.GetCellString( 0, 1)
			szNumber = Replace(szNumber, "-" , "")			
		
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "04")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , "13")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , g_szPhoneSRNO)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "UI_CUST_TELNO" , 0 , szNumber)
		Else                                                                       '이메일
			Dim szEmail
			szEmail = contScroll.tblInfo.GetCellString( 1, 1)
			
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "HNDV_MTHD_CODE", 0 , "02")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_TYPE_CODE", 0 , "21")
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "INAG_SRNO"     , 0 , g_szEmailSRNO)
			DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "ADDR"          , 0 , szEmail)
		End If 
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "FNPR_JOIN_SRNO"     , 0 , g_szFnprJoinSrno)
		DATAMANAGER.SetDataValue( 0 , "obcsb_acad_122a", "InBlock1", "PROS_CLS_CODE"      , 0 , "1")
	
	
	elseif szTranID == "oblon_basc_803a" then
		DATAMANAGER.ClearInputData( 0, szTranID )
'		Form.ShowAlert("sACNT_PWD", sACNT_PWD)
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "ACNO" , 0 , Left( g_szAccount, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "ASNO" , 0 , Right( g_szAccount, 2) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		DATAMANAGER.SetDataValue(0,"oblon_basc_803a", "InBlock1", "CRDT_AGRM_BSWR_KIND_CLCD", 0, "013")
		DATAMANAGER.SetDataValue(0,"oblon_basc_803a", "InBlock1", "PROS_DATE", 0, g_szProsDate) '개인신용정보동의 서비스 컴플리서 받은 처리일자
		DATAMANAGER.SetDataValue(0,"oblon_basc_803a", "InBlock1", "PROS_SRNO", 0, g_szProsSrno) '개인신용정보동의 서비스 컴플리서 받은 처리일련번호
		DATAMANAGER.SetDataValue(0,"oblon_basc_803a", "InBlock1", "FNPR_JOIN_SRNO", 0, g_szFnprJoinSrno ) 'V001
		
		if g_bState == false then '등록
			DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "CRDT_STPL_YN" , 0 , "Y" )
			g_szProsClsCode = "1"
			
			if g_szDejuDate == "" or g_szDejuDate == "N" then
				DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "STLN_STPL_YN" , 0 , "N" )
			else
				DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "STLN_STPL_YN" , 0 , "Y" )
			end if
			
		else '변경
			DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "PROS_CLS_CODE" , 0 , "2" )
			DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "CRDT_STPL_YN" , 0 , "Y" )
			g_szProsClsCode = "2"
			
			if g_szDejuDate == "" or g_szDejuDate == "N" then
				DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "STLN_STPL_YN" , 0 , "N" )
			else
				DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "STLN_STPL_YN" , 0 , "Y" )
			end if
		end if
		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" ) 'v001		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "UI_PROD_OPNG_YN1" , 0 , "Y" ) 'SMS 필수이므로 강제 Y
		
		if g_szButtonEmail == "1" then
			DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "UI_PROD_OPNG_YN2" , 0 , "Y" )
		else
			DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock1", "UI_PROD_OPNG_YN2" , 0 , "N" )
		end if
		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "ACNO" , 0 , Left( g_szAccount, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "ASNO" , 0 , Right( g_szAccount, 2) )
		
		if g_szButtonRadio1 == "1" then
			DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "MORG_APLY_FORM_CODE" , 0 , "A" )
		elseif g_szButtonRadio1 == "2" then
			DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "MORG_APLY_FORM_CODE" , 0 , "B" )
		else
			DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "MORG_APLY_FORM_CODE" , 0 , "0" )
		end if
		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "LOAN_CORE_MANL_CNFR_YN" , 0 , "Y" ) '신용거래유형 중 신용거래융자체크
		DATAMANAGER.SetDataValue( 0, "oblon_basc_803a", "InBlock2", "STLN_TR_CNFR_YN" , 0 , "" )
