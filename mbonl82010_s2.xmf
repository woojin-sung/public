Dim g_szButtonRadio1
Dim g_szButtonEmail
Dim g_szButtonRadio2


Dim g_bState 'true 변경하고자함 false 등록하고자 함

Dim g_szFnprJoinSrno
Dim g_szRegDate
Dim g_szDejuDate

Dim g_szAccount
Dim g_szActPwd

Dim g_szEmailSRNO
Dim g_szPhoneSRNO

Dim g_szProsDate
Dim g_szProsSRNO

Dim g_bSwitchInit

'LHR 수정
Dim g_szProsClsCode
Dim g_szStplYN
'============================================================================
Sub Form_OnFormInit()
	g_szButtonEmail = "0"
	contScroll.btnOnOff.SetApplySwitch( "OFF", "ON", "269", "261", "286", "289") 
	'LHR 수정
	contScroll.lblQ21.fgcolor = "67"
	Form.SetCtlProp( "contScroll.btnMove", "fgcolor", "67")
	g_szFnprJoinSrno = Form.GetSharedData( "FNPR_JOIN_SRNO", false )
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
'	Form.ShowAlert(sEventName, sParam)
	if sEventName == "InitData" then
		
		if trim(sParam) ~= "" then
			Dim tActParam
			tActParam = Split(sParam, "☆")
			g_szAccount = tActParam[0]
			g_szActPwd  = tActParam[1]
			
			Dim tData
			tData = Split(tActParam[2], "★")	
			
			'기본형, 투자형
			if trim(tData[0]) ~= "" then
				if trim(tData[0])  == "A" then '융자기본형
					f_SetButtonCheck("imgQ11")
				elseif trim(tData[0])  == "B" then '융자투자형
					f_SetButtonCheck("imgQ12")
				else
					
				end if
			end if
			
			
'			'SMS
'			if trim(tData[1]) == "Y" then
'				'SMS는 필수인데...
'			end if
			
			
			'Email
			if trim(tData[2]) == "Y" then
				'f_SetButtonCheck("imgQ22")
				szCtlName = "imgQ22"
				Form.SetCtlProp( "contScroll."..szCtlName, "imgpath", "input_01_o.9" )
	'			contScroll.imgQ22.imgpath = "input_03_o.9"
				'LHR 수정
				Form.SetCtlProp( "contScroll.lbl"..MID(szCtlName,4,3), "fgcolor", "67")
	
				g_szButtonEmail = "1"
				'LHR 수정
				contScroll.lblQ22.enable = "0"
			end if
			
			
			'등록일
			g_szRegDate = trim(tData[3])
			
			if trim(tData[3]) == "" or trim(tData[3]) == "N" then				
				g_bState = false
				g_szStplYN = "N"
			else
				g_bState = true
				g_szStplYN = "Y"
			end if
			
			
			'대주거래등록일
			g_szDejuDate = trim(tData[4])
			
			'유통융자 담보활용 동의 신청 여부
			if trim(tData[5]) == "Y" then
				g_bSwitchInit = true
				contScroll.btnOnOff.switchindex = "1"				
			else
				g_bSwitchInit = false
				contScroll.btnOnOff.switchindex = "0"				
			end if
			
		end if
	
	elseif sEventName == "SetEmailInfo" then
		if trim(sParam) ~= "" then
			Dim tData 
			tData = Split(sParam, "★")
			contScroll.tblInfo.SetCellString(1,1,tData[0])
			g_szEmailSRNO = tData[1]
		end if
		
	elseif sEventName == "SetPhoneInfo" then
		if trim(sParam) ~= "" then
			Dim tData 
			tData = Split(sParam, "★")
			contScroll.tblInfo.SetCellString(0,1,tData[0])
			g_szPhoneSRNO = tData[1]
		end if
		
	elseif sEventName == "ActChange" then
		if trim(sParam) ~= "" then
			Dim tActParam
			tActParam = Split(sParam, "☆")
			g_szAccount = tActParam[0]
			g_szActPwd  = tActParam[1]
		end if 
	
	elseif sEventName == "PwdComplete" then
		if trim(sParam) ~= "" then
			Dim tActParam
			tActParam = Split(sParam, "☆")
			g_szAccount = tActParam[0]
			g_szActPwd  = tActParam[1]
		end if 
		
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbonl82010_p1" then
		'유통융자 담보활용 동의 팝업 클로즈로 서비스 803에 붙어있음
	
'231207 - 온라이가이드 추가	 START
	elseif sKeyName == "mbonl82010_p2" then
		'동의
		if sRet ~= "Close" then
			Form.OpenFramePopup("mbonl82010_p9" , "", "") '주요내용 확인		
		end if 
	
	'elseif sKeyName == "mbonl82010_p2" then
	elseif sKeyName == "mbonl82010_p9" then 
'231207 - 온라이가이드 추가	 END 		
		'동의
		if sRet ~= "Close" then
			'LHR 수정
			'DATAMANAGER.RequestTranData("obaci_acct_255a")
			'g_szProsDate =  DATAMANAGER.GetDataValue( 0, "obaci_acct_255a", "OutBlock1", "PROS_DATE" , 0 )
			'g_szProsSRNO =  DATAMANAGER.GetDataValue( 0, "obaci_acct_255a", "OutBlock1", "PROS_SRNO" , 0 )
			g_szProsDate = Form.GetSharedData("255a_PROS_DATE", true)
			g_szProsSRNO = Form.GetSharedData("255a_PROS_SRNO", true)
			'LHR수정 비밀번호 무조건 입력받게
			g_szActPwd = ""
			if trim(g_szActPwd) == "" then
				Dim sValue
				sValue = g_szAccount.."☆2"
				Form.openPopupAnimation("pwdcheckpopup", sValue ,"","2")
			else
	'			Form.OpenFramePopup("mhetc90060_p5" , "" , "") '공인인증비밀번호검증
	
'				DATAMANAGER.RequestTranData("obsap_acif_999a")
				DATAMANAGER.RequestTranData( "obcsb_acad_122a" ) '약정등록
			end if
		end if
		
	elseif sKeyName == "CORRECT_PWD" then
		if nil ~= sRet and "" ~= sRet then
			Dim tPwd
			tPwd = Split(sRet, "★") '"nPwdLen★sEncPwd(암호화된 비밀번호)"
			Form.triggerEvent("#", "CORRECT_PWD", tPwd[0])
			g_szActPwd = tPwd[0]
			
'			Form.OpenFramePopup("mhetc90060_p5" , "" , "") '공인인증비밀번호검증

'			DATAMANAGER.RequestTranData("obsap_acif_999a")
			DATAMANAGER.RequestTranData( "obcsb_acad_122a" ) '약정등록
		end if
		
	elseif sKeyName == "mhetc90060_p5" then		
		if sRet ~= "cancel" then
			'LHR 수정
			'DATAMANAGER.RequestTranData("obsap_acif_999a")
			DATAMANAGER.SetEventFlag( "oblon_basc_803a", "A" )
			DATAMANAGER.RequestTranData( "oblon_basc_803a" ) '약정등록	
		end if 
	elseif sKeyName = "mbonl81000" then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obcsb_acad_002r" ) '연락처조회
		end if
	end if
End Sub
'
'===========================================================================
Function f_SetButtonCheck(szCtlName)	
	if szCtlName == "imgQ11" or szCtlName == "imgQ12" then
		Dim tBtnName1
		tBtnName1 = {"imgQ11", "imgQ12"}
		for i = 0 to 1
			if szCtlName == tBtnName1[i] then
				Form.SetCtlProp( "contScroll."..szCtlName, "imgpath", "input_01_o.9")
				'LHR 수정
				Form.SetCtlProp( "contScroll.lbl"..MID(szCtlName,4,3), "fgcolor", "67")
				g_szButtonRadio1 = Right( szCtlName, 1 )
				
			else
				Form.SetCtlProp( "contScroll."..tBtnName1[i], "imgpath", "input_01_n.9")
				'LHR 수정
				Form.SetCtlProp( "contScroll.lbl"..MID(tBtnName1[i],4,3), "fgcolor", "127")
				
			end if
		next
'	
	elseif szCtlName == "imgQ31" or szCtlName == "imgQ32" then
		Dim tBtnName1
		tBtnName1 = {"imgQ31", "imgQ32"}
		for i = 0 to 1
			if szCtlName == tBtnName1[i] then
				Form.SetCtlProp( "contScroll."..szCtlName, "imgpath", "input_01_o.9")
				'LHR 수정
				Form.SetCtlProp( "contScroll.lbl"..MID(szCtlName,4,3), "fgcolor", "67")
				g_szButtonRadio2 = Right( szCtlName, 1 )
				
			else
				Form.SetCtlProp( "contScroll."..tBtnName1[i], "imgpath", "input_01_n.9")
				'LHR 수정
				Form.SetCtlProp( "contScroll.lbl"..MID(tBtnName1[i],4,3), "fgcolor", "127")
				
			end if
		next
'		
	else
		Dim szBtnBg
'		szBtnBg = Form.GetCtlProp( "contScroll."..szCtlName, "imgpath" )
		if g_szButtonEmail == "0" then
			Form.SetCtlProp( "contScroll."..szCtlName, "imgpath", "input_01_o.9" )
'			contScroll.imgQ22.imgpath = "input_03_o.9"
			'LHR 수정
			Form.SetCtlProp( "contScroll.lbl"..MID(szCtlName,4,3), "fgcolor", "67")

			g_szButtonEmail = "1"
		else
			Form.SetCtlProp( "contScroll."..szCtlName, "imgpath", "input_01_n.9" )
'			contScroll.imgQ22.imgpath = "input_01_n.9"
			'LHR 수정
			Form.SetCtlProp( "contScroll.lbl"..MID(szCtlName,4,3), "fgcolor", "127")
			g_szButtonEmail = "0"
		end if
	end if
	
End Function

