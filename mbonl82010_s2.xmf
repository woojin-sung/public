Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSub
	szSub = DATAMANAGER.GetDataMsgSubText( szTranID)
	if szTranID == "obcsb_acif_705u" then
		Dim szData
		'LHR 수정
		szData = g_szAccount.."★"..g_szButtonRadio1.."★"..g_szButtonEmail.."★"..g_szButtonRadio2.."★"..contScroll.btnOnOff.switchindex.."★"..g_szProsClsCode
		Form.triggerEvent("#", "NextView", szData)
	else
		if trim(szSub) <> "" then
			szErrMsg = szErrMsg.."\n"..szSub
		end if
		Form.ShowAlert("알림", szErrMsg)
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	contScroll.imgTip1.setMaintainingRatio("2")
	contScroll.imgTip2.setMaintainingRatio("2")	
End Sub

