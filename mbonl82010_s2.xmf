'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	Form.ShowAlert("DATAMANAGER_OnReceiveTranComplete", szTranID)
	if szTranID == "obcsb_acad_122a" then
		'LHR 수정
		'DATAMANAGER.SetEventFlag( "oblon_basc_803a", "A" )
		'DATAMANAGER.RequestTranData( "oblon_basc_803a" ) '약정등록	
		
		Form.OpenFramePopup("mhetc90060_p5" , "" , "") '공인인증비밀번호검증
	elseif szTranID == "oblon_basc_803a" then
		Dim sMsg, sSubMsg
		sMsg = DATAMANAGER.GetDataMsgText( szTranID )
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			sMsg = sMsg.." "..sSubMsg
		end if
		
		'LHR 수정
		'Form.MsgBox( "알림", sMsg, "", 6 )
		
		Dim sSUCS_YN
		sSUCS_YN = Form.GetSharedData("KYC_SUCS_YN", false)
		
		if sSUCS_YN == null or sSUCS_YN == "" or sSUCS_YN ~= "Y" then
			'완료화면 노출
			Dim szData
			'LHR 수정
			szData = g_szAccount.."★"..g_szButtonRadio1.."★"..g_szButtonEmail.."★"..g_szButtonRadio2.."★"..contScroll.btnOnOff.switchindex.."★"..g_szProsClsCode
			Form.triggerEvent("#", "NextView", szData)
		else
			DATAMANAGER.RequestTranData( "obcsb_acif_705u" ) '고위험상품가입여부처리
		end if
		
	elseif szTranID == "obcsb_acif_705u" then
		Dim szData
		'LHR 수정
		szData = g_szAccount.."★"..g_szButtonRadio1.."★"..g_szButtonEmail.."★"..g_szButtonRadio2.."★"..contScroll.btnOnOff.switchindex.."★"..g_szProsClsCode
		Form.triggerEvent("#", "NextView", szData)
	
	' 개인신용정보동의
	elseif szTranID == "obaci_acct_255a" then
		g_szProsDate =  DATAMANAGER.GetDataValue( 0, "obaci_acct_255a", "OutBlock1", "PROS_DATE" , 0 )
		g_szProsSRNO =  DATAMANAGER.GetDataValue( 0, "obaci_acct_255a", "OutBlock1", "PROS_SRNO" , 0 )
		'LHR수정 비밀번호 무조건 입력받게
		g_szActPwd = ""
		if trim(g_szActPwd) == "" then
			Dim sValue
			sValue = g_szAccount.."☆2"
			Form.openPopupAnimation("pwdcheckpopup", sValue ,"","2")
		else
'			Form.OpenFramePopup("mhetc90060_p5" , "" , "") '공인인증비밀번호검증

'			DATAMANAGER.RequestTranData("obsap_acif_999a")
			DATAMANAGER.RequestTranData( "obcsb_acad_122a" ) '약정등록
		end if
	'LHR 수정 고객연락처
	elseif szTranID == "obcsb_acad_002r" then
		'연락처 초기화
		contScroll.tblInfo.SetCellString(0, 1, "")
		contScroll.tblInfo.SetCellString(1, 1, "")
		
		Dim nCnt 
		Dim szCustClsCode
		
		nCnt = tonumber(DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock1" )	)
		if nCnt > 0 then
			for i = 0 to nCnt-1
				Dim sINAG_TYPE_CODE
				Dim sEMAIL_ADDR
				Dim szSRNO
				
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_TYPE_CODE" , i )	
				if sINAG_TYPE_CODE == "21" then 'E-mail
					sEMAIL_ADDR = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "EMAIL_ADDR" , i )	
					szSRNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_SRNO" , i )	
					
					contScroll.tblInfo.SetCellString(1, 1, sEMAIL_ADDR)
					g_szEmailSRNO = szSRNO
					Exit for '첫번째껄 세팅후 out
				end if
			next
		end if
		
		szCustClsCode = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock5", "CUST_CLS_CODE" , 0 )
		If szCustClsCode = "2" Then '법인
			'DATAMANAGER.RequestTranData( "obaci_acct_095r" ) '법인연락처조회	     
			'DATAMANAGER.RequestTranData( "obacp_comm_007r" ) '법인연락처조회	     
			DATAMANAGER.RequestTranData( "obcsb_acad_120r" ) '법인연락처조회	     
		else
			Dim nCnt
			nCnt = tonumber(DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock3" )	)	
			if nCnt > 0 then
				for i = 0 to nCnt-1
					Dim  sINAG_TYPE_CODE
					Dim szSRNO
					
					sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_TYPE_CODE" , i )	
					
					if sINAG_TYPE_CODE == "13" then '휴대폰번호
						Dim sARCD
						Dim sTONO
						Dim sTELNO
						
						sARCD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
						sTONO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
						sTELNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
						szSRNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_SRNO" , i )	

						contScroll.tblInfo.SetCellString(0, 1, sARCD.."-"..sTONO.."-"..sTELNO)
						g_szPhoneSRNO = szSRNO
						Exit for '첫번째껄 세팅후 out - 박정숙과장이 seq=1인걸 세팅해달라 함.
					end if
				next
			end if
		end if
'	elseif szTranID == "obaci_acct_095r" then
'		Dim nCnt 
'		nCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock2" )		)
'		if nCnt > 0 then
'			for i = 0 to nCnt-1
'				Dim sINAG_TYPE_CODE
'				Dim szSRNO
'				
'				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "INAG_TYPE_CODE" , i )
'				
'				if sINAG_TYPE_CODE == "13" then '휴대폰번호
'					Dim sCustTelNo
'					sCustTelNo = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "UI_CUST_TELNO" , i )	
'					szSRNO = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "INAG_SRNO" , i )	
'					
'					contScroll.tblInfo.SetCellString(0, 1, sARCD.."-"..sTONO.."-"..sTELNO)
'					Exit for '박정숙과장요청. #22007 법인계좌 통보처 관리에 등록된 휴대폰 번호
'				end if
'			next
'		end if
	elseif szTranID == "obcsb_acad_120r" then
		Dim sCustTelNo
		Dim szSRNO
		
		tmpArcd = DATAMANAGER.GetDataValue(0, "obcsb_acad_120r", "OutBlock1", "CLPH_ARCD", 0)
		tmpTono = DATAMANAGER.GetDataValue(0, "obcsb_acad_120r", "OutBlock1", "CLPH_TONO", 0)
		tmpTelno = DATAMANAGER.GetDataValue(0, "obcsb_acad_120r", "OutBlock1", "CLPH_TELNO", 0)
		szSRNO = DATAMANAGER.GetDataValue(0, "obcsb_acad_120r", "OutBlock1", "UI_CLPH_CNPL_SRNO", 0)
		
		contScroll.tblInfo.SetCellString(0, 1, tmpArcd.."-"..tmpTono.."-"..tmpTelno)
		g_szPhoneSRNO = szSRNO
'	elseif szTranID == "obacp_comm_007r" then
'		Dim sCustTelNo
'		Dim szSrno
'		
'		szSrno = ""
'		sCustTelNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock3", "WHOL_CPNO", 0)
'		
'		contScroll.tblInfo.SetCellString(0, 1, sCustTelNo)
	end if 
End Sub


