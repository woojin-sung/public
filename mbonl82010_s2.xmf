Sub contScroll_btnNext_OnClick()
'	if g_szActPwd == nil or g_szActPwd == "" then
'		Form.MsgBox("안내", "계좌비밀번호를 입력해 주세요.", "", 6)
'		return
	
	if trim(g_szButtonRadio1) == "" then
		Form.MsgBox("안내", "신용거래유형을 선택해 주세요.", "", 6)
		return
	else
		if trim(g_szButtonRadio2) == "" then
			Form.MsgBox("안내", "계약서류 통보방법을 선택해 주세요.", "", 6)
			return
		else
			Dim szIndex
			szIndex = contScroll.btnOnOff.switchindex
'			if szIndex == "0" or szIndex == false or szIndex == 0 or szIndex == "false"  then
'			
'			else
			Form.OpenPopup("mbonl82010_p2" , g_szAccount.."★"..g_szStplYN, "")
'			end if
		end if
	end if
	
End Sub


