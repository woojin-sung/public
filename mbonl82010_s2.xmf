Sub contScroll_imgTip1_OnClick()
	Dim sText
	sText = "- 기본형 : 신용 매수 시, 보증금을 현금으로 징수\n"..
			"- 투자형 : 신용 매수 시, 보증금을 현금 & 대용으로 징수"
	'LHR 수정
	'contScroll.imgTip1.openToolTip( sText, 345, 50, 1 )
	contScroll.imgTip1.openToolTip( sText, 353, 60, 2 )
End Sub

'============================================================================
Sub contScroll_imgTip2_OnClick()
	Dim sText
	sText = "담보활용 동의 선택 시, 한국증권금융에서 대여활용을 할 수 있으며, 이에 따른 담보활용 대여수수료가 지급됩니다."
	'LHR 수정
	'contScroll.imgTip2.openToolTip( sText, 345, 60, 1 )
	contScroll.imgTip2.openToolTip( sText, 350, 75, 1 )
End Sub

