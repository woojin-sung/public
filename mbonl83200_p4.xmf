	<SCRIPT_INFO _len="1743" _ulen="1651" >
''-------------------------------------------------------------------------------------------
'' 01. 화 면 명 : 공개매수_신청완료
'' 02. 화면설명 : 공개매수_신청완료
'' 03. 작    성 : 2023.06.09 정지환
'' 04. 수    정 :  
''-------------------------------------------------------------------------------------------
Dim g_szRsevYn
Dim g_szSbsc_qty
dim g_szExcsSbsc_qty
Dim closeFlag

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.SetMaintainingRatio("1")
End Sub
'============================================================================
Sub Form_OnFormInit()
	BtnNext.fgcolor = 269
	
	g_szData = Form.GetOpenLinkData()

	g_szList = Split(g_szData, "★")
		
	if UBound(g_szList) > 1 then
		
		call set_data()
	end if
End Sub


'============================================================================
Sub set_data()
	dim szToday
	szToday = Form.GetSharedData("&HOST_DATE" , false)
	
	Table0.SetCellString(1, 3, left(g_szList(0),4).."-"..mid(g_szList(0), 5, 4).."-"..right(g_szList(0),2)) '신청계좌
	Table0.SetCellString(2, 3, g_szList(1)) '대상주식
	Table0.SetCellString(3, 3, g_szList(2)) '신청수량
	Table0.SetCellString(4, 3, g_szList(3)) '결제일
	
End Sub
'============================================================================
Sub BtnNext_OnClick()
	closeFlag = 2
	Form.CloseForm()		
End Sub
'
''============================================================================
Sub BtnNext0_OnClick()
	closeFlag = ""
	Form.CloseForm()
End Sub
'
'
''============================================================================
Sub Form_OnFormClose()
	Form.OpenScreen( "83200" , closeFlag)
End Sub 

