	<SCRIPT_INFO _len="2763" _ulen="2687" >

'============================================================================
' 화 면 명 : 단기사채 투자자유의사항 팝업
'============================================================================

Dim g_szReturnKey

Dim szOSType
Dim g_szSymbolCode

'============================================================================
Sub Form_OnFormInit()
	szOSType = Form.GetSharedData("&OS_TYPE", false)

	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  szOSType == "1" then'iOS("2")Android("1")
		Container0.setScrollBarVisible("2")
		Container1.setScrollBarVisible("2")
	end if
	
	szOpenData = Form.GetOpenLinkData()
	
	Container0.visible = false
	Container1.visible = true
	
'	Form.ShowAlert("", szOpenData)
	
	if szOpenData <> "" then
		g_szSymbolCode = szOpenData
		
		DATAMANAGER.RequestTranData("obfnb_anno_122r")
		
	end if	
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbonl90201_p16" , g_szReturnKey)
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	g_szReturnKey = "cancel"
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	g_szReturnKey = "ok"
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , szTranID .. "\n"..szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , szTranID .. "\n"..szErrCode .. " : ".. szErrMsg)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obfnb_anno_122r" then 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STND_DATE",	0,	Form.GetSharedData("&HOST_DATE", false))	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISCD",		0,	g_szSymbolCode)	
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obfnb_anno_122r" then
		szValue = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CNST_CO_YN" , 0)
		
		if szValue = "Y" then
			Container0.visible = True
			Container1.visible = False
		else
			Container0.visible = False
			Container1.visible = True
		end if
	
	end if
	
End Sub

	</SCRIPT_INFO>
