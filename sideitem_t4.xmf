'===========================================================================
'***************************************************************************
'     G L O B A L   V A R I A B L E
'***************************************************************************
Dim g_szSelectedItem	'그리드 선택된 아이템
Dim g_szJumin           '사용자 주민번호 
Dim g_szID         '사용자 아이디
Dim g_nTva              '평가금액 총합
Dim g_nTaa              '출금가능금액 총합
Dim g_sSelRow
Dim g_nType
'===========================================================================

'============================================================================
' RequestData : 20160330 미로그인시 Refresh이벤트로 인해 오류현상발생으로 함수화
'============================================================================
Function RequestData()
	Dim sLOGIN_TYPE 
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )

	if CInt(sLOGIN_TYPE) > 1 then '로그인 상태
'   	 	g_szJumin = Form.GetSharedData("&JUMIN_NUM", false )
		g_szID = Form.GetSharedData("&USER_ID", false )
		g_nType = 0
		Table0.SetCellString( 0, 0, "출금가능" )
		DATAMANAGER.RequestTranData("obcsb_efif_021r")
		
	else
		'Form.ShowAlert( "알림", "로그인이 필요한 화면입니다.")
		Form.MsgBox( "알림", "로그인이 필요한 화면입니다.\n로그인 하시겠습니까?", "NEED_LOGIN", 2 )
		
	end if
End Function

'***************************************************************************
'     C O M M O N   F U N C T I O N
'***************************************************************************
'===========================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	RequestData()	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )'주민번호(2)->아이디(1)로 구분설정
'	DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "RCNO" , 0 ,  g_szJumin )
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "VLTN_ACMP_YN", 0 , "Y" )'평가수행여부 설정
	DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "ELFN_ID", 0 , g_szID)
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    nCnt = DATAMANAGER.GetDataCount( 0, "obcsb_efif_021r" , "OutBlock1" )
   
   g_nTva = 0
   g_nTaa = 0
	if szTranID == "obcsb_efif_021r" then
	    If nCnt > 0 then
	       For i = 0 To nCnt
		       szAcno = DATAMANAGER.DATAMANAGER.GetDataValue( 0 , "obcsb_efif_021r", "OutBlock1", "REG_ACNO" , i )
		       szAsno = DATAMANAGER.DATAMANAGER.GetDataValue( 0 , "obcsb_efif_021r", "OutBlock1", "REG_ASNO" , i )
		       vAmt = DATAMANAGER.DATAMANAGER.GetDataValue( 0 , "obcsb_efif_021r", "OutBlock1", "VLTN_AMT", i)
		       aAmt = DATAMANAGER.DATAMANAGER.GetDataValue( 0 , "obcsb_efif_021r", "OutBlock1", "DRNG_ABLE_AMT", i )
		       'DATAMANAGER.SetDataValue( 0 , "obcsb_efif_021r", "OutBlock1", "REG_ACNO" , 0 , szAcno& szAsno )
		       
		       g_nTva = g_nTva + CDbl (vAmt)
		       g_nTaa = g_nTaa + CDbl (aAmt)
		      
		      grdAcc.Getcont0.grdAcc.SetCellData( "bd_cell0" , i , szAcno & szAsno )
		       
		   Next
		   
		   'Table0.SetCellString( 0, 1, g_nTva )
		   if g_nType == 0 then
			   Table0.SetCellString(0, 1, g_nTaa )
		   else
			   Table0.SetCellString(0, 1, g_nTva )
		   end if
		End If   
	End If	
End Sub


