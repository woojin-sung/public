'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim szListItems
	
	if sKeyName = "MOVEPOP_RETURN"	then
		szListItems	=	split(sRet,"★")
		
		if	szListItems(1)	=	"0"	then			'이체
			Form.OpenScreen("61010" , g_szSelectedItem & "★" & "0") 
		elseif	szListItems(1)	=	"1"	then		'입출금
		    szPrcd =  grdAcc.GetCellData( "bd_cell4", g_sSelRow )
		    szBkop =  grdAcc.GetCellData( "bd_cell6", g_sSelRow )

		    if szPrcd == "101" then
		       if szBkop == "N" then
		          Form.OpenScreen("61060" , g_szSelectedItem & "★" & "0")
			   else 
			      Form.OpenScreen("61020" , g_szSelectedItem & "★" & "2") '은행입출금
			   end if
			elseif szPrcd == "105" or szPrcd == "106" or szPrcd == "107" or szPrcd == "108" then
			   Form.OpenScreen("61020" , g_szSelectedItem & "★" & "2") 
			else   
			   Form.OpenScreen("61060" , g_szSelectedItem & "★" & "0")
			end if   
		end if	
	end if	
End Sub

'============================================================================
Sub grdAcc_OnHeaderClickUp(lRow, szCellID)
	if szCellID == "th_cell1" then
		grdAcc.SetVisibleCol( 1, 0 )
		grdAcc.SetVisibleCol( 2, 1 )
	elseif szCellID == "th_cell2" then
		grdAcc.SetVisibleCol( 1, 1 )
		grdAcc.SetVisibleCol( 2, 0 )	
	end if		
End Sub

'============================================================================
Sub Table0_OnClick(lRow , lColumn)
	if lColumn == 0 then
		if g_nType == 0 then
			Table0.SetCellString( 0, 0, "평가금액" )
			Table0.SetCellString(0, 1, g_nTva )
			g_nType = 1
		else
			Table0.SetCellString( 0, 0, "출금가능" )
			Table0.SetCellString(0, 1, g_nTaa )
			g_nType = 0
		end if
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if (sKeyName == "NEED_LOGIN") then
		if (sRet == "ok") then	
			Form.OpenPopup( "mhetc90021" , "2" , "" )
		end if 
	end if 
End Sub

'============================================================================
Sub grdAcc_OnClickUp(lRow, szCellID)
	'sAcc = grdAcc.GetCellData("bd_cell0", lRow )
	'Account0.caption = sAcc
	
	Form.triggerEvent( "#", "CLOSE_FORM", szParam)
End Sub

'============================================================================
Sub Form_OnRefresh()
	RequestData()	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	sSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	Form.ShowAlert( "알림", szErrMsg & "" & sSubErr)
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "&LOGIN" then
		RequestData()	
	end if
End Sub

