'============================================================================
Sub Form_OnFormInit()
	Dim szData
	
	szData = Form.GetOpenLinkData()
	
	Form.SetScreenName("입출금내역")
	
	szList = Split(szData, "★")
	
	if UBOUND(szList) < 1 then
		Exit sub
	End if

	for i = 0 to 10
		tbl0.SetCellString( i , 1, Trim(szList(i)))
	next

'	SetTr()
	
End Sub

