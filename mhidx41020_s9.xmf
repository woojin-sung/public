' 화 면 명 : MY종목뉴스_관심종목뉴스(mhnws44070_t2.xmf)
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'- 관심_환경설정 관련 -------------------------------------------------------
Dim g_szGSID

Dim g_szUserID
Dim g_szCust

g_szUserID = ""
g_szCust = ""
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
Sub Form_OnFormInit()
	grd01.scrollenable = "0"
	Call f_init()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "Login" then
		g_szUserID = sParam
	elseif sEventName == "REQUEST_DATA" then
		if sParam <> "" and sParam <> null then	
			grdCode.rowcount	= 0
			grdMk.rowcount	= 0
			grdList0.rowcount	= 0
			grd01.rowcount 	= 0
			
			call f_SettingUI()
		
			g_szGSID = sParam
			if g_szGSID = "CC" then	'보유
				DATAMANAGER.RequestTranData("obsim_stsv_047r")
			elseif g_szGSID = "BB" then		'최근조회
				szRecent = Form.GetRecentHistory("99")
				
				Call Load_RecentList(szRecent)
'			elseif g_szGSID == "AA" then	'watching
'				DATAMANAGER.RequestTranData("ohhts_watch_003")
			elseif g_szGSID == "NoGroup" then
				imgNotice.visible = true
				lbNoticeMsg.visible = true
				lbNoticeMsg.caption = "등록된 관심그룹이 없어요."
			else
				DATAMANAGER.RequestTranData("ohhts_intr_007r")

			end if
			
		end if
	end if
		
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
'	if Trim(g_szUserID) = "" then
'		Exit Sub
'	end if
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_007r" then	
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_USER_ID",         	0, g_szUserID)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_CNCN_ISSU_NEW_GRP_ID",	0, g_szGSID)
'	' ----------------------------------------------------------------------
'	' Wathcing종목 조회
'	' ----------------------------------------------------------------------	
'	elseif szTranID == "ohhts_watch_003" then
'		grdList0.SetClear()	' 종목조회그리드 초기화
'		
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_WRTR_ID", 		0, g_szCust)
'
	' ----------------------------------------------------------------------
	' 보유종목 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obsim_stsv_047r" or szTranID == "obsim_stsv_048r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID", 				0, g_szUserID)
		
	elseif szTranID ==  "ohhts_kwdn_002r" then
		DATAMANAGER.ClearInputData(0, "ohhts_kwdn_002r")
		
		nTotalKey = CInt(grdList0.rowcount)
		if nTotalKey > 4 then
			grdList0.rowcount = 4
			nTotalKey = 4
		end if
		
		if nTotalKey < 0 then
			
		else
			for i = 0 to nTotalKey-1
				szkwdNm = grdList0.GetCellData("bd_name", i)
				
				Form.SetCtlProp("lblKeyWord"..CStr(i), "caption", "#" & szkwdNm)
				DATAMANAGER.SetDataValue(0, "ohhts_kwdn_002r", "InBlock1", "FID_SRCH_COND", i, szkwdNm)
			next
			
		end if
		lblKeyWord0.setHighlight(332)
		lblKeyWord1.setHighlight(332)
		lblKeyWord2.setHighlight(332)
		lblKeyWord3.setHighlight(332)
	end If

End Sub
'============================================================================
' 실시간을 위해 중복되지 않는 시장구분을 저장해둔다.
'============================================================================
Function Save_grdMk()
	grdMk.rowcount = 0

	for i = 0 to grdCode.rowcount - 1
		szMk = Trim(grdCode.GetCellData("bd_mk", 	i))
		szCd = Trim(grdCode.GetCellData("bd_code", 	i))
		
		if szMk <> "" then
			nRow2 = CInt(grdMk.rowcount)
	
			if nRow2 == 0 then
				grdMk.insertrow = 0
				grdMk.SetCellData("bd_mk", 		0, szMk)
				grdMk.SetCellData("bd_code", 	0, szCd)
			end if
	
			for j = 0 to nRow2 - 1
				szMk2 = Trim(grdMk.GetCellData("bd_mk", j))
				
				if szMk == szMk2 then		
					szCd2 = grdMk.GetCellData("bd_code", j) & "★" & szCd
					grdMk.SetCellData("bd_code", j, szCd2)
					
					exit For
				end if
				
				if j == nRow2 - 1 then
					grdMk.insertrow = 0
					grdMk.SetCellData("bd_mk", 		0, szMk)
					grdMk.SetCellData("bd_code", 	0, szCd)
				end if
				
			next
			
		end if
		
	next
	
	nTotalKey = CDbl(grdList0.rowcount)
	
	if nTotalKey > 0 then
		DATAMANAGER.RequestTranData("ohhts_kwdn_002r")
	else
		grd01.height = 0
		
		imgNotice.visible = true
		lbNoticeMsg.visible = true
		lbNoticeMsg.caption = "등록된 종목이 없어요."
	end if
End Function

'============================================================================
' 라벨 컨트롤
'============================================================================
Function f_SettingUI()
	lblMove.visible = false
	imgMove.visible = false
	imgNotice.visible = false
	lbNoticeMsg.visible = false
	
	nTop = grd01.top + 1
	lblKeyWord0.top = nTop
	lblKeyWord1.top = nTop + 66
	lblKeyWord2.top = nTop + 66*2
	lblKeyWord3.top = nTop + 66*3

	lblKeyWord0.removeHighlight()
	lblKeyWord1.removeHighlight()
	lblKeyWord2.removeHighlight()
	lblKeyWord3.removeHighlight()

	lblKeyWord0.caption = ""
	lblKeyWord1.caption = ""
	lblKeyWord2.caption = ""
	lblKeyWord3.caption = ""
	

End Function

'============================================================================
' Load_RecentList :  최근조회종목 리스트
'============================================================================
Function Load_RecentList(szData)
	Dim tList
	Dim szMk, szName, szCode
	
	if Trim(szData) <> "" then
		tList = Split(szData, "`")
		
		'START - 최근조회종목 100개로 제한----------------------------------
		if #tList >= 100 then
			szLen = 99
		else
			szLen = #tList - 1
		end if
		
		nRowcount = 0
		
		for i = 0 to szLen
			szCode 	= tList(i)
			szMk 	= Form.GetItemCodeInfo(tList(i), "market")
			szMk 	= Change_EtcMarket(szMk)
		'JJH 국가구분 추가
		'----------------------------------------------------------------------------------------------------
			Dim  nMkLen, tCode
				
			if CInt(Instr(szCode, "@")) > 0 then	'@ 포함된 종목코드(해외주식, 해외지수 등)
				tCode = Split(szCode, "@")
''				if UBOUND(tCode) < 1 then
''					Exit Sub
'				End if
				szMk  = tCode[0]
				
				if Trim(szMk) <> "" then
					nMkLen = Form.getLen(szMk)
					if nMkLen == 2 then
						szGubun = "OV" '해외주식(마켓구분 2자리)
					else
						szGubun = "KR"
					end if
				end if
			else
				szGubun = "KR"
			end if 
			
			szName 	= Form.GetItemCodeInfo(tList(i), "name")
		'----------------------------------------------------------------------------------------------------
			if Trim(szCode) <> "EMPTY" and Trim(szMk) <> "" and Trim(szName) <> ""  then
				'최근조회종목 - 상품선물 안보이게
				'상품선물 "FF"분기처리 추가
				if szMk == "CF" or szMk == "FF" then

				else
					grdCode.insertrow = nRowcount
					
					grdCode.SetCellData("bd_code", nRowcount, szCode)
					grdCode.SetCellData("bd_mk",   nRowcount, szMk)
					grdCode.SetCellData("bd_memo", nRowcount, "")
					grdCode.SetCellData("bd_name", nRowcount, szName)
					
					'0802 JJH 뉴스에 코스피 코스닥 코넥스만 노출
					'--------------------------------------------------------
					szMarketNm = f_GetMarketName(szCode)	
					if (szMarketNm <> "" and szMarketNm <> null) or szGubun == "OV"  then
					'--------------------------------------------------------
						grdList0.AddRow()
						grdList0.SetCellData("bd_name", nRowcount, szName)
						
						nRowcount = nRowcount + 1
					end if
					
					if CDbl(nRowcount) == 4 then
						exit For
					end if
				end if
				
			end if
		
		next
		
		
		'END---------------------------------------------------------------
	
		Form.SetCtlProp("edtListCnt", "caption", grdCode.rowcount)

		Call Save_grdMk()	
	else
		
		imgNotice.visible = true
		lbNoticeMsg.visible = true
		lbNoticeMsg.caption = "최근 조회 종목이 없어요."
	end if
	
End Function


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)

	' ----------------------------------------------------------------------
	' 보유종목리스트
	' ----------------------------------------------------------------------
	if szTranID == "obsim_stsv_047r" then
		Dim szName, szCode, szMarketNm, szMk, szCutCd
		g_nNextCount = 0
		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
	
		for i = 0 to nCnt - 1
			
			szName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "KOR_NAME" , i)
			
			'0802 JJH 뉴스에 코스피 코스닥 코넥스만 노출
			'--------------------------------------------------------
			szCode = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "ISCD" , i)
			szMk = Form.GetItemCodeInfo(szCode, "market")
			szMk = Change_EtcMarket(szMk)	
			
			select Case szMk
				Case "Q", "BN", "B"
				
				'20210608 SWJ START : 신주인수권 보유종목 조회 오류현상 수정
				Case "J"
					szCutCd = szCode
				'20210608 SWJ END
				
				Case Else
					szCutCd = Mid(szCode, 2, Len(szCode))
					szMk = Form.GetItemCodeInfo(szCutCd, "market")
			End Select
			
			if Trim(szName) <> "" then
				szMarketNm = f_GetMarketName(szCutCd)
				
				if szMarketNm <> "" and szMarketNm <> null then
			'--------------------------------------------------------
					grdList0.AddRow()
					grdList0.SetCellData("bd_name", g_nNextCount, szName)
					g_nNextCount = g_nNextCount + 1
				end if
			end if
		next
		
	'해외 보유종목		
	elseif szTranID == "obsim_stsv_048r" then
		
		nCnt = DATAMANAGER.GetDataCount(0, "obsim_stsv_048r", "OutBlock1")

		if nCnt > 0 then
			for i = 0 to nCnt - 1
				szName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "KOR_NAME" , i)
				if Trim(szName) <> "" then
					grdList0.AddRow()
					grdList0.SetCellData("bd_name", g_nNextCount, szName)
					g_nNextCount = g_nNextCount + 1
					
				end if
			next
		end if
		
		nTotalKey = CDbl(grdList0.rowcount)
		if nTotalKey > 0 then
			Save_grdMk()		
		else
			grd01.height = 0 
			
			imgNotice.visible = true
			lbNoticeMsg.visible = true
			lbNoticeMsg.caption = "보유한 종목이 없어요."
		end if

'	' ----------------------------------------------------------------------
'	' Watching종목 조회
'	' ----------------------------------------------------------------------
'	elseif szTranID == "ohhts_watch_003" then 
'		nIdx = 0
'		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
'		
'		if nCnt < 1 then
'			Label0.caption = "등록된 종목이 없습니다."
'			grd01.height = 0
'			Label0.visible = true	
'			exit Sub
'		end if
'		
'		for i = 0 to nCnt - 1
'			szName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_KOR_ISNM" , i)
'			if Trim(szName) <> "" then
'				grdList0.AddRow()
'				grdList0.SetCellData("bd_name", nIdx, szName)
'				nIdx = nIdx + 1
'			end if
'		next
'		
'		nTotalKey = CDbl(grdList0.rowcount)
'		if nTotalKey > 0 then
'			DATAMANAGER.RequestTranData("ohhts_kwdn_002r")
'		else
'			Label0.caption = "검색 가능한 Watching종목이 없습니다."
'			grd01.height = 0
'			Label0.visible = true	
'		end if
	' ----------------------------------------------------------------------
	' 관심종목 종목
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		Dim szCode, szMk, szName, szMarketNm, szNation, nRow
		'0804 JJH grdCode에 스크립트로 데이터 삽입
		'----------------------------------------------------------------------------------------------------
		nRow = Cint(DATAMANAGER.GetDataCount( 0, "ohhts_intr_007r", "OutBlock1"))
		grdCode.rowcount = nRow
		nIdx = 0
		
		for i = 0 to  nRow - 1 
			szMk = DATAMANAGER.GetDataValue( 0, "ohhts_intr_007r", "OutBlock1", "FID_INPUT_MRKT_CLS_CODE" , i )
			szCode = DATAMANAGER.GetDataValue( 0, "ohhts_intr_007r", "OutBlock1", "FID_OVDV_ISCD" , i )
			szMemo = DATAMANAGER.GetDataValue( 0, "ohhts_intr_007r", "OutBlock1", "FID_MEMO_CNTT" , i )
			szNation = DATAMANAGER.GetDataValue( 0, "ohhts_intr_007r", "OutBlock1", "FID_CNCN_GRP_NTNL_CLS_CODE" , i )
		'----------------------------------------------------------------------------------------------------
			szMk 	= Change_EtcMarket(szMk)			
			'0818 JJH 해외와 국내 중복되는 종목코드로인한 이슈 해결 START ----------------------------
			'0822 JJH 이전 버전의 007r 서비스는 국가구분코드가 없어서 최신 007r 이전에 등록된 종목은 이름을 받을 수 없는 오류 수정
			if szNation == "OV" then
				szName = Form.GetItemCodeInfo(szMk & "@" & szCode, "name")
			else
				szName	= Form.GetItemCodeInfo(szCode, "name")
			end if
			'0818 JJH 해외와 국내 중복되는 종목코드로인한 이슈 해결 END ----------------------------
			if Trim(szName) == "" then
				szName	= Form.GetItemCodeInfo(szCode, "name")
				szName = Form.GetItemCodeInfo(szMk & "@" & szCode, "name")
			end if
			
			grdCode.SetCellData("bd_code", i, szCode)
			grdCode.SetCellData("bd_mk", 	i, szMk)
			grdCode.SetCellData("bd_name", 	i, szName)
			
			'0802 JJH 뉴스에 코스피 코스닥 코넥스만 노출
			'--------------------------------------------------------
			szMarketNm = f_GetMarketName(szCode)
			if szMarketNm <> "" or Form.GetItemCodeInfo(szMk & "@" & szCode, "market") == "OV"then
'			'--------------------------------------------------------
				if Trim(szCode) <> "EMPTY" and Trim(szName) <> "" then
					grdList0.AddRow()
					grdList0.SetCellData("bd_name", nIdx, szName)
					nIdx = nIdx + 1
				end if
			end if
		next

		Form.SetCtlProp("edtListCnt", "caption", grdCode.rowcount)

		Call Save_grdMk()

	' ----------------------------------------------------------------------
	' 보유종목뉴스 조회
	' ----------------------------------------------------------------------
	elseif szTranID = "ohhts_kwdn_002r" then
		nCnt		= DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		nRowCnt	= CDbl(grd01.rowcount)

		if Cint(nCnt) > 0 then
		
			for i = 0 to nCnt-1
				szDate			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_DATE", 				i)
				szTitle 			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_TITL", 				i)
				szNewsCorpCode 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_NEWS_OFER_ENTP_CODE",	i)
				szNewCorpName		= ""
				szTime 			= ""
			    
			    if szDate = "" then
				    szTitle		= "최근 한달 간 뉴스가 존재하지 않습니다."
				    szDate		= Replace(Now("yyyyMMdd"),"-","")
				    szTime		= Replace(FormatDateTime(now,4),":","") & Right(szDate,2) 
				    szNewCorpName	="[검색결과]"
				end if
				
				grd01.AddRow()
				grd01.SetCellData("bd_cell0", nRowCnt + i ,szTitle)
				grd01.SetCellData("bd_keyword", nRowCnt + i ,grdList0.GetCellData("bd_name", nRowCnt + i ))
				
			next
			imgNotice.visible = false
			lbNoticeMsg.visible = false
		else
			grd01.height= 0
			imgNotice.visible = true
			lbNoticeMsg.visible = true
			lbNoticeMsg.caption = "보유한 종목이 없어요."
		end if
		'202302 HSZ 시장종합 스크롤 안먹는 현상 조치
		nRowCnt = grd01.rowcount
		grd01.height = 66 * nRowCnt
	end if
	if szTranID == "obsim_stsv_047r" then '국내 보유종목  NEXT
		
	     g_nNextCount = grdList0.rowcount			    
		if  DATAMANAGER.IsMoreNextData( "obsim_stsv_047r" ) == True then 
			DATAMANAGER.RequestNextData( "obsim_stsv_047r" )
		else
			DATAMANAGER.RequestTranData( "obsim_stsv_048r" )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Form.ShowAlert("알림", "[" & szErrCode & "]" & szErrMsg, true)
	
	DATAMANAGER.ClearInputData(0, szTranID)
End Sub


