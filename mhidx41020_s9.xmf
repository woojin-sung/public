'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' 화면 초기화
'============================================================================
Function f_init()
	
	if Trim(g_szUserID) = "" then
		exit Function
	end if
	g_szCust = Form.GetSharedData("&CUST_NUM", false)

End Function


'============================================================================
' 해외지수(대표, 업종지수)/ 채권의 마켓구분 변경
'============================================================================
Function Change_EtcMarket(szData)

	if Trim(szData) == "UJ" then
		return "N"
	elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		return "B"
	end if	
	
	return szData
End Function

'============================================================================
Sub Form_OnRefresh()
	Call f_init()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	g_szUserID = Form.GetSharedData("&USER_ID", false)
	imgMove.setMaintainingRatio("1")
End Sub

