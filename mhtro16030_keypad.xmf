'============================================================================
function SetPlusMinus(sGubun1)
	Dim nPrc
	Dim sMarket
	Dim sTtyp
	Dim nUnit
	Dim nInput
	
	nPrc = _tonumber(EditInput.caption) 
	sMarket = LabelMarket.caption
	sTtyp = LabelTtyp.caption
	nUnit = GetHogaUnit(sMarket, sTtyp, nPrc, sGubun1)
	nInput = 0
	
	if sGubun1 == "P" then
		nInput = nPrc + nUnit
	else
		if nPrc > 0 then
			Dim nQty
			nQty = nPrc - nUnit
	
			if nQty >= 0 then
				nInput = nQty 
			else
				nInput = 0
			end if
		end if
	end if

	EditInput.caption = SetDecimalPrc(nInput)
end function

'============================================================================
function SetModifyNum(sData)
	if EditInput.caption == nil or EditInput.caption == "" or tonumber(EditInput.caption) == 0 then
		Dim sDot
		sDot = Instr(1, EditInput.caption, "%.")
		
		if sDot == nil or sDot == "" then
			if sData == "0" or sData == "00" or sData == "000" then
				EditInput.caption = "0"
			else
				EditInput.caption = sData
			end if
		else
			EditInput.caption = EditInput.caption..sData
		end if
	else	
		EditInput.caption = EditInput.caption..sData
	end if
end function

'============================================================================
function _tonumber(sData)
	if sData == nil or sData == "" then
		return 0
	end if
	
	return tonumber(sData)
end function


'============================================================================
function SetDecimalPrc(nPrc)
	if CDbl(nPrc) <= 0 then
		nPrc = "0."
	end if
	
	Dim sPrcTemp
	sPrcTemp = Split( nPrc, "." )
	Dim m
	m = 0
	if sPrcTemp[2] == nil or sPrcTemp[2] == "" then
		nPrc = sPrcTemp[1].."."
	else
		m = #sPrcTemp[2]
	end if
	for k = m to g_sDecimal-1
		nPrc = nPrc.."0"
	next
	
	return nPrc
end function



'============================================================================
function GetHogaUnit(sMarket, sttyp, sPrc, sGubun2)
	Dim unit 
	unit = 1.0
	Dim price
	price = tonumber(sPrc)	
	Dim ttype
	ttype = 0
	if sttyp == nil or sttyp == "" then
		ttype = "0"
	else
		ttype = CInt(sttyp)
	end if
	
	' ttype 1:TOPIX100 제외, 3:TOPIX 100
	
	if sMarket == "SHS" then ' 상해
		unit = 0.01
	elseif sMarket == "SZS" then ' 심천
		unit = 0.01
	elseif sMarket == "TSE" then ' 도쿄		
		if ttype == 3 then
			' 일본(TOPIX 100)
			' 1,000 이하 					0.1
			' 1,000 초과 	3,000 이하 		0.5
			' 3,000 초과 	5,000 이하		1
			' 5,000 초과 	10,000 이하 		1
			' 10,000 초과 	30,000 이하		5
			' 30,000 초과 	50,000 이하 		10
			' 50,000 초과 	100,000 이하		10
			' 100,000 초과 	300,000 이하 		50
			' 300,000 초과 	500,000 이하		100
			' 500,000 초과 	1,000,000 이하 	100
			' 1,000,000 초과 3,000,000 이하	500
			' 3,000,000 초과 5,000,000 이하	1,000
			' 5,000,000 초과 10,000,000 이하	1,000
			' 10,000,000 초과 30,000,000 이하	5,000
			' 30,000,000 초과 50,000,000 이하	10,000
			' 50,000,000 이상		 		10,000
			if sGubun2 == "P" then
				if 1000 > price then			unit = 0.1
				elseif 3000 > price then		unit = 0.5
				elseif 5000 > price then		unit = 1
				elseif 10000 > price then		unit = 1
				elseif 30000 > price then		unit = 5
				elseif 50000 > price then		unit = 10
				elseif 100000 > price then		unit = 10
				elseif 300000 > price then		unit = 50
				elseif 500000 > price then		unit = 100
				elseif 1000000 > price then		unit = 100
				elseif 3000000 > price then		unit = 500
				elseif 5000000 > price then		unit = 1000
				elseif 10000000 > price then	unit = 1000
				elseif 30000000 > price then	unit = 5000
				elseif 50000000 > price then	unit = 10000				
				else							unit = 10000
				end if
			else
				if 1000 >= price then			unit = 0.1
				elseif 3000 >= price then		unit = 0.5
				elseif 5000 >= price then		unit = 1
				elseif 10000 >= price then		unit = 1
				elseif 30000 >= price then		unit = 5
				elseif 50000 >= price then		unit = 10
				elseif 100000 >= price then		unit = 10
				elseif 300000 >= price then		unit = 50
				elseif 500000 >= price then		unit = 100
				elseif 1000000 >= price then	unit = 100
				elseif 3000000 >= price then	unit = 500
				elseif 5000000 >= price then	unit = 1000
				elseif 10000000 >= price then	unit = 1000
				elseif 30000000 >= price then	unit = 5000
				elseif 50000000 >= price then	unit = 10000				
				else							unit = 10000
				end if
			end if
		else
			' 일본(TOPIX 100 제외)
			' 3,000 이하 					1			
			' 3,000 초과 	5,000 이하		5
			' 5,000 초과 	30,000 이하		10
			' 30,000 초과 	50,000 이하 		50
			' 50,000 초과 	300,000 이하 		100
			' 300,000 초과 	500,000 이하		500
			' 500,000 초과 	3,000,000 이하	1,000
			' 3,000,000 초과 5,000,000 이하	5,000
			' 5,000,000 초과 30,000,000 이하	10,000			
			' 30,000,000 초과50,000,000 이하	50,000
			' 50,000,000 이상		 		100,000

			if sGubun2 == "P" then
				if 3000 > price then			unit = 1
				elseif 5000 > price then		unit = 5
				elseif 30000 > price then		unit = 10
				elseif 50000 > price then		unit = 50
				elseif 300000 > price then		unit = 100
				elseif 500000 > price then		unit = 500
				elseif 3000000 > price then		unit = 1000
				elseif 5000000 > price then		unit = 5000				
				elseif 30000000 > price then	unit = 1000
				elseif 50000000 > price then	unit = 50000				
				else							unit = 100000
				end if
			else
				if 3000 >= price then			unit = 1
				elseif 5000 >= price then		unit = 5
				elseif 30000 >= price then		unit = 10
				elseif 50000 >= price then		unit = 50
				elseif 300000 >= price then		unit = 100
				elseif 500000 >= price then		unit = 500
				elseif 3000000 >= price then	unit = 1000
				elseif 5000000 >= price then	unit = 5000				
				elseif 30000000 >= price then	unit = 1000
				elseif 50000000 >= price then	unit = 50000				
				else							unit = 100000
				end if
			end if
		end if
	elseif sMarket == "OSE" or sMarket == "JSD" or sMarket == "NII" then ' 오사카, 자스닥, 니케이		
		' 3,000 이하 					1			
		' 3,000 초과 	5,000 이하		5
		' 5,000 초과 	30,000 이하		10
		' 30,000 초과 	50,000 이하 		50
		' 50,000 초과 	300,000 이하 		100
		' 300,000 초과 	500,000 이하		500
		' 500,000 초과 	3,000,000 이하	1,000
		' 3,000,000 초과 5,000,000 이하	5,000
		' 5,000,000 초과 30,000,000 이하	10,000			
		' 30,000,000 초과50,000,000 이하	50,000
		' 50,000,000 이상		 		100,000

		if sGubun2 == "P" then
			if 3000 > price then			unit = 1
			elseif 5000 > price then		unit = 5
			elseif 30000 > price then		unit = 10
			elseif 50000 > price then		unit = 50
			elseif 300000 > price then		unit = 100
			elseif 500000 > price then		unit = 500
			elseif 3000000 > price then		unit = 1000
			elseif 5000000 > price then		unit = 5000				
			elseif 30000000 > price then	unit = 1000
			elseif 50000000 > price then	unit = 50000				
			else							unit = 100000
			end if
		else
			if 3000 >= price then			unit = 1
			elseif 5000 >= price then		unit = 5
			elseif 30000 >= price then		unit = 10
			elseif 50000 >= price then		unit = 50
			elseif 300000 >= price then		unit = 100
			elseif 500000 >= price then		unit = 500
			elseif 3000000 >= price then	unit = 1000
			elseif 5000000 >= price then	unit = 5000				
			elseif 30000000 >= price then	unit = 1000
			elseif 50000000 >= price then	unit = 50000				
			else							unit = 100000
			end if
		end if
		
	elseif sMarket == "NYS" or sMarket == "NYG" or sMarket == "NAS" or sMarket == "NAI" or sMarket == "AMX" or sMarket == "NAO" or sMarket == "SPI" or sMarket == "DJI" or sMarket == "USA" then 
		' 뉴욕, NYSE Global Index, 나스닥, 나스닥 지수, 아멕스, NQ-OTC, S&P, 다우존스, 미국전체
		' 1 이하 	0.0001			
		' 1 초과	0.01
		
		if ttype == 1 then				unit = 0.01
		elseif ttype == 2 then				unit = 0.05
		elseif ttype == 3 then				unit = 0.05
		elseif ttype == 4 then				unit = 0.05
		else								unit = 0.01
		end if
'		if sGubun2 == "P" then
'			if 1 > price then			unit = 0.0001
'			else						unit = 0.01
'			end
'		else
'			if 1 >= price then			unit = 0.0001
'			else						unit = 0.01
'			end
'		end
		
	elseif sMarket == "HKS" or sMarket == "HKW" or sMarket == "HSI" then ' 홍콩/홍콩ELW,항생
		if ttype == 3 then
			unit = 0.05
		else
			' 0.25 이하	 				0.001			
			' 0.25 초과 		0.5 이하		0.005
			' 0.5 초과 		10 이하		0.01
			' 10 초과 		20 이하 		0.02
			' 20 초과 		100 이하 	0.05
			' 100 초과 		200 이하		0.1
			' 200 초과 		500 이하		0.2
			' 500 초과 		1,000 이하	0.5
			' 1,000 초과 	2,000 이하	1			
			' 2,000 초과		5,000 이하	2
			' 5,000 이상		 			5
	
			if sGubun2 == "P" then
				if 0.25 > price then		unit = 0.001
				elseif 0.5 > price then	unit = 0.005
				elseif 10.0 > price then		unit = 0.01
				elseif 20.0 > price then		unit = 0.02
				elseif 100.0 > price then	unit = 0.05
				elseif 200.0 > price then	unit = 0.1
				elseif 500.0 > price then	unit = 0.2
				elseif 1000.0 > price then	unit = 0.5				
				elseif 2000.0 > price then	unit = 1
				elseif 5000.0 > price then	unit = 2				
				else						unit = 5
				end if
			else
				if 0.25 >= price then		unit = 0.001
				elseif 0.5 >= price then	unit = 0.005
				elseif 10 >= price then		unit = 0.01
				elseif 20 >= price then		unit = 0.02
				elseif 100 >= price then	unit = 0.05
				elseif 200 >= price then	unit = 0.1
				elseif 500 >= price then	unit = 0.2
				elseif 1000 >= price then	unit = 0.5				
				elseif 2000 >= price then	unit = 1
				elseif 5000 >= price then	unit = 2				
				else						unit = 5
				end if
			end if
		end if
	end if

	return unit
end function





