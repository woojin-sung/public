'===========================================================================
' 화  면  명 : 가격키패드
' 화  면  ID : 
' 개      요 : 
' 작      성 : 2017.10.12
' 수      정 : 이재원
'===========================================================================
Dim g_sDecimal 
g_sDecimal = "0"

'============================================================================
Sub Form_OnFormInit()
	Dim sRevData
	sRevData = Form.GetOpenLinkData( )
	
	if sRevData <> nil and sRevData <> "" then
		Dim sTemp 
		sTemp = Split( sRevData, "^" )
		
		Dim nNum 
		nNum = _tonumber(sTemp[1])
		Dim sMarket 
		sMarket = sTemp[4]
		Dim sTtyp 
		sTtyp = sTemp[5]
				
		g_sDecimal 		= _tonumber(sTemp[3])
		if g_sDecimal == 0 then
			BtnDot.enable = false
		end if
		EditInput.caption = sTemp[1]
		LabelUnit.caption = sTemp[2]
		LabelMarket.caption = sTemp[4]
		LabelTtyp.caption = sTemp[5]
		
	end if
end Sub

'============================================================================
Sub ImgClose_OnClick()
	Form.CloseForm( )
end Sub

'============================================================================
Sub BtnOK_OnClick()
	Form.SendReturnToParent( "가격키패드" , EditInput.caption )
	
	Form.CloseForm( )
end Sub

'============================================================================
Sub BtnE_OnClick()
	EditInput.caption = "0"
end Sub

'============================================================================
Sub BtnC_OnClick()
	EditInput.caption = "0"
end Sub

'============================================================================
Sub BtnBack_OnClick()
	Dim sNum
	sNum = EditInput.caption 

	if sNum == nil or sNum == "" or tonumber(sNum) == 0 then
		EditInput.caption = "0" 
	else
		if Len(sNum) == 1 then
			EditInput.caption = "0" 
		else
			EditInput.caption = Left( sNum, Len(sNum)-1) 
		end if
	end if
end Sub

'============================================================================
Sub ImgBack_OnClick()
	Dim sNum
	sNum = EditInput.caption 

	if sNum == nil or sNum == "" or tonumber(sNum) == 0 then
		EditInput.caption = "0" 
	else
		if Len(sNum) == 1 then
			EditInput.caption = "0" 
		else
			EditInput.caption = Left( sNum, Len(sNum)-1) 
		end if
	end if
end Sub

'============================================================================
Sub BtnDot_OnClick()
	Dim sDot
	sDot = Instr(1, EditInput.caption, "%.")
	
	if sDot == nil or sDot == "" then
		if EditInput.caption == nil or EditInput.caption == "" then
			EditInput.caption = "0"
		end if
		
		EditInput.caption = EditInput.caption.."."
	end if
end Sub

'============================================================================
