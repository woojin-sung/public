	<SCRIPT_INFO _len="61571" _ulen="56811" >
'--===========================================================================
'통합검색
'순차적으로 검색함.  메뉴 > 국내주식 > 해외주식 > 최근 검색어
'--===========================================================================
Dim g_szDeviceOS

Dim szStock, szGlobal, szBond, szMenu, szRecent
DIm IdxStock,	IdxGlobal, ldxBond, IdxMenu, IdxRecent ' 현재페이지 
DIm IdxTotalStock, IdxTotalGlobal, IdxTotalBond, IdxTotalMenu, IdxTotalRecent ' 전체페이지
DIm totalCnt_Stock, totalCnt_Global, totalCnt_Menu, totalCnt_Bond, totalCnt_Recent  '총갯수

Dim Const STOCK_INDEX 		= 1
Dim Const GLOBAL_INDEX 	= 2
Dim Const BOND_INDEX 		= 3
Dim Const MENU_INDEX		= 4
Dim Const RECENT_INDEX		= 5

Dim Const INIT_TITLE_TOP	= 10		'메뉴, 국내주식, 해외주식, 채권 TOP
Dim Const INIT_TIME_TOP	= 10 	'시간 TOP
Dim Const INIT_GRID_TOP	= 47		'검색결과 그리드 TOP
Dim Const INIT_GRIDHEIGHT 	= 145	'검색결과 그리드 HEIGHT
Dim Const INIT_GRIDROW		= 48		'검색결과 그리드 ROW Height
Dim Const INIT_OPEN_TOP	= 200	'더보기/닫기 TOP
Dim Const INIT_IMAGE_TOP	= 212	'더보기/닫기 이미지 TOP

'각 타이틀 TOP
Dim g_nTitleTop1, g_nTitleTop2, g_nTitleTop3 
g_nTitleTop0 = 10
g_nTitleTop1 = 240
g_nTitleTop2 = 470
g_nTitleTop3 = 700

'각 그리드 TOP
Dim g_nGridTop1, g_nGridTop2, g_nGridTop3 
g_nGridTop0 = 47
g_nGridTop1 = 277
g_nGridTop2 = 507
g_nGridTop3 = 737

'각 더보기/닫기 TOP
Dim g_nOpenTop1, g_nOpenTop2, g_nOpenTop3 
g_nOpenTop0 = 200
g_nOpenTop1 = 430
g_nOpenTop2 = 660
g_nOpenTop3 = 890

'각 그리드의 Height
Dim g_nGridHeight0, g_nGridHeight1, g_nGridHeight2, g_nGridHeight3 
g_nGridHeight0 = INIT_GRIDHEIGHT
g_nGridHeight1 = INIT_GRIDHEIGHT
g_nGridHeight2 = INIT_GRIDHEIGHT
g_nGridHeight3 = INIT_GRIDHEIGHT

'20230824 KKM 현재 페이지에 따른 그리드 Height 조정 
'각 그리드 스크롤이 생기지 않도록 조정하는 Hight 페이지수가 4,7,10,13,..... 일때 
Dim g_nPlusGridHeight0, g_nPlusGridHeight1, g_nPlusGridHeight2, g_nPlusGridHeight3
g_nPlusGridHeight0 = 1 '메뉴
g_nPlusGridHeight1 = 1 '국내주식
g_nPlusGridHeight2 = 1	'해외주식
g_nPlusGridHeight3 = 1	'채권

Dim g_szCode			'종목코드
Dim g_nCount			'항목개수
g_nCount = 0 			'20210916 SWJ START

'각 표기되는 조회갯수
Dim g_QueryCount0, g_QueryCount1, g_QueryCount2, g_QueryCount3, g_QueryCount
g_QueryCount = 1 '실시간 순위
g_QueryCount0 = 3 '메뉴
g_QueryCount1 = 3 '국내주식
g_QueryCount2 = 3 '해외주식
g_QueryCount3 = 3 '채권


'============================================================================
' 초기화 함수
Function initObject()
	szStock	= ""
	szGlobal	= ""
	szBond	= ""
	szMenu	= ""
	szRecent	= ""

	IdxStock = 0	
	IdxGlobal = 0 
	IdxBond = 0 
	IdxMenu = 0 
	IdxRecent = 0
	
	IdxTotalStock = 0	
	IdxTotalGlobal = 0 
	IdxTotalBond = 0 
	IdxTotalMenu = 0 
	IdxTotalRecent = 0	

	totalCnt_Recent = 0
	totalCnt_Stock = 0
	totalCnt_Global = 0
	totalCnt_Bond = 0
	totalCnt_Menu = 0

	contHistory.grdHistory.SetClear()	
	contItem.grd0.SetClear()
	contItem.grd1.SetClear()
	contItem.grd2.SetClear()
	contItem.grd3.SetClear()
	
	contHistory.grdHistory.rowcount = 0
	contItem.grd0.rowcount = 0
	contItem.grd1.rowcount = 0
	contItem.grd2.rowcount = 0
	contItem.grd3.rowcount = 0
	
	lblCntMenu.caption = ""
	lblCntStock.caption = ""
	lblCntGlobal.caption = ""
	lblCntBond.caption = ""
	
	g_QueryCount = 1 '실시간 순위
	g_QueryCount0 = 3 '메뉴
	g_QueryCount1 = 3 '국내주식
	g_QueryCount2 = 3 '해외주식
	g_QueryCount3 = 3 '채권
	
	'20230824 KKM 현재 페이지에 따른 그리드 Height 조정 
	g_nPlusGridHeight0 = 1 '메뉴
	g_nPlusGridHeight1 = 1 '국내주식
	g_nPlusGridHeight2 = 1	'해외주식
	g_nPlusGridHeight3 = 1	'채권
	
	contItem.Label0.visible = 0	
	contItem.height = 547
	contHistory.height = 547
	contItem.scroll_pos = 0
	contHistory.scroll_pos = 0	
	
End Function

'검색결과 위치 초기설정
Function initObjectPosition(nType)

	if Cint(nType) == STOCK_INDEX then
		'메뉴결과(X)
		if totalCnt_Menu == 0 then
			'없는 경우
			contItem.lbl0.visible = 0
			g_nTitleTop1 = INIT_TITLE_TOP
		'메뉴결과(O)
		else		
			contItem.lbl0.visible = 1
			'더보기버튼 (X)
			if totalCnt_Menu < 4 then
				g_nTitleTop1 = INIT_GRID_TOP + (INIT_GRIDROW*totalCnt_Menu) + 40				
			'더보기버튼 (O)
			else
				g_nTitleTop1 = INIT_OPEN_TOP + 30 + 30	
			end if
		end if		
		contItem.lblTitle1.Top = g_nTitleTop1 
		contItem.lblTime1.Top = g_nTitleTop1
		
		g_nGridTop1 = g_nTitleTop1 + 37
		contItem.grd1.Top = g_nGridTop1

		'국내주식검색결과 4개이상일 경우 
		if totalCnt_Stock > 3 then
			contItem.grd1.height = INIT_GRIDHEIGHT + 1
			g_nOpenTop1 = g_nGridTop1 + INIT_GRIDHEIGHT + 8 
			
			contItem.lblOpen1.Top = g_nOpenTop1 
			contItem.ImgOpen1.Top = g_nOpenTop1 + 12
			'contItem.lbl1.Top = g_nOpenTop1 + 30   '구분자 1
			contItem.lbl1.Top = g_nOpenTop1 + 35   '구분자 1
			
			contItem.lblOpen1.caption = "더보기"
			contItem.ImgOpen1.imgpath = "icon_arrow_d.png"		
		else
			contItem.grd1.height = (INIT_GRIDROW * totalCnt_Stock) + 1
			contItem.lbl1.Top = g_nGridTop1 + contItem.grd1.height + 20 '구분자 1
		end if 
		
		g_nGridHeight1 = contItem.grd1.height
		
		'contItem.scroll_pos = g_nTitleTop1		
		
	elseif Cint(nType) == GLOBAL_INDEX  then

		'국내결과(O)
		if (totalCnt_Stock > 0) then
			contItem.lbl1.visible = 1	
			'더보기버튼(X)
			if totalCnt_Stock < 4 then
				g_nTitleTop2 = g_nGridTop1 + (INIT_GRIDROW*totalCnt_Stock) + 40
			'더보기버튼(O)
			else
				'g_nTitleTop2 = g_nOpenTop1 + 30 + 25
				g_nTitleTop2 = g_nOpenTop1 + 30 + 30
			end if
			
		'국내결과(X)
		else
			'contItem.lbl1.left = 500		
			contItem.lbl1.visible = 0		
			'국내결과(X), 메뉴결과(O)
			if (totalCnt_Menu > 0) then
				contItem.lbl0.visible = 1					
				'더보기버튼(X)
				if totalCnt_Menu < 4 then
					g_nTitleTop2 = INIT_GRID_TOP + (INIT_GRIDROW*totalCnt_Menu) + 40
				'더보기버튼(O)
				else
					g_nTitleTop2 = INIT_OPEN_TOP + 30 + 30
				end if
			'국내결과(X), 메뉴결과(X)
			else
				contItem.lbl0.visible = 0
				g_nTitleTop2 = INIT_TITLE_TOP
			end if 
		end if
		contItem.lblTitle2.Top = g_nTitleTop2
		contItem.lblTime2.Top = g_nTitleTop2
		
		g_nGridTop2 = g_nTitleTop2 + 37		
		contItem.grd2.Top = g_nGridTop2
		
		'해외주식검색결과 4개이상일 경우 
		if totalCnt_Global > 3 then
			contItem.grd2.height = INIT_GRIDHEIGHT + 1
			g_nOpenTop2 = g_nGridTop2 + INIT_GRIDHEIGHT + 8 
			
			contItem.lblOpen2.Top = g_nOpenTop2 
			contItem.ImgOpen2.Top = g_nOpenTop2  + 12
			contItem.lbl2.Top = g_nOpenTop2 + 35   '구분자 2
			
			contItem.lblOpen2.caption = "더보기"
			contItem.ImgOpen2.imgpath = "icon_arrow_d.png"		
		else
			contItem.grd2.height = (INIT_GRIDROW * totalCnt_Global) + 1
			contItem.lbl2.Top = g_nGridTop2 + contItem.grd2.height + 20 '구분자2
		end if 
		
		g_nGridHeight2 = contItem.grd2.height		
		
		'contItem.scroll_pos = g_nTitleTop2	
		
	elseif Cint(nType) == BOND_INDEX   then
	
		'해외주식결과(O)
		if totalCnt_Global > 0 then
			'contItem.lbl2.left = 0					
			contItem.lbl2.visible = 0				
		
			'더보기버튼(X)
			if totalCnt_Global < 4 then			
				g_nTitleTop3 = g_nGridTop2 + (INIT_GRIDROW*totalCnt_Global) + 40				
			'더보기버튼(O)
			else
				g_nTitleTop3 = g_nOpenTop2 + 30 + 30
			end if			
		
		'해외주식결과(X)
		else
			'국내주식결과(O)
			if totalCnt_Stock > 0 then			
				'더보기버튼(X)
				if totalCnt_Stock < 4 then
					g_nTitleTop3 = g_nGridTop1 + (INIT_GRIDROW*totalCnt_Stock) + 40
				'더보기버튼(O)
				else
					g_nTitleTop3 = g_nOpenTop1 + 30 + 30
				end if	
				
			'국내주식결과(X)
			else
				'메뉴결과(O)
				if totalCnt_Menu >  0	then
					'더보기버튼(X)
					if totalCnt_Menu < 4 then
						g_nTitleTop3 = INIT_GRID_TOP +  (INIT_GRIDROW*totalCnt_Menu) + 40
					'더보기버튼(O)
					else
						'_nTitleTop3 = INIT_OPEN_TOP + 30 + 25
						g_nTitleTop3 = INIT_OPEN_TOP + 30 + 30
					end if				
			
				'메뉴결과(X)
				else
					g_nTitleTop3 = INIT_TITLE_TOP
				end if 
			end if 		
		end if
		contItem.lblTitle3.Top = g_nTitleTop3
		contItem.lblTime3.Top = g_nTitleTop3
		
		g_nGridTop3 = g_nTitleTop3 + 37	
		contItem.grd3.Top = g_nGridTop3
		
		'채권검색결과 4개이상일 경우 
		if totalCnt_Bond > 3 then
			contItem.grd3.height = INIT_GRIDHEIGHT + 1
			g_nOpenTop3 = g_nGridTop3 + INIT_GRIDHEIGHT + 8 
			
			contItem.lblOpen3.Top = g_nOpenTop3 
			contItem.ImgOpen3.Top = g_nOpenTop3  + 12
			
			contItem.lblOpen3.caption = "더보기"
			contItem.ImgOpen3.imgpath = "icon_arrow_d.png"		
		else
			contItem.grd3.height = (INIT_GRIDROW * totalCnt_Bond) + 1
		end if 		
		
		g_nGridHeight3 = contItem.grd3.height		
		
		'contItem.scroll_pos = g_nTitleTop3	
		
	elseif Cint(nType) == MENU_INDEX  then '메뉴 
	
		contItem.lblTitle0.Top = INIT_TITLE_TOP
		contItem.lblTime0.Top = INIT_TITLE_TOP
		contItem.grd0.Top = INIT_GRID_TOP
		
		'메뉴검색결과 4개이상일 경우 
		if totalCnt_Menu > 3 then
			contItem.grd0.height = INIT_GRIDHEIGHT +1
			contItem.lblOpen0.Top = INIT_OPEN_TOP
			contItem.ImgOpen0.Top = INIT_IMAGE_TOP
			contItem.lbl0.Top = INIT_OPEN_TOP + 35   '구분자 0
			
			contItem.lblOpen0.caption = "더보기"
			contItem.ImgOpen0.imgpath = "icon_arrow_d.png"		
		else
			contItem.grd0.height = (INIT_GRIDROW * totalCnt_Menu) + 1
			contItem.lbl0.Top = INIT_GRID_TOP + contItem.grd0.height + 20 '구분자 0
		end if 
		
		g_nGridHeight0 = contItem.grd0.height		
		
		'contItem.scroll_pos = INIT_TITLE_TOP 
		
	elseif Cint(nType) == RECENT_INDEX  then
		contHistory.lblTop.Top = 130
		contHistory.lblTitleHistory.Top = 150
		contHistory.lblDel.Top = 150	
		contHistory.grdHistory.height = (INIT_GRIDROW * totalCnt_Recent) * 1
		contHistory.top = 100	
		contHistory.grdHistory.Top = 187
		contHistory.SetScrollAutoSize()	
		Exit Function		
	end if 	
	
	contItem.top = 100
	if totalCnt_Bond > 0 then
		contItem.Label0.visible = 1
		contItem.Label0.top = g_nOpenTop3 + 30
	elseif totalCnt_Global > 0 then
		contItem.Label0.visible = 1
		contItem.Label0.top = g_nOpenTop2 + 30
		contItem.lbl2.visible = 0
	elseif totalCnt_Stock > 0 then
		contItem.Label0.visible = 1
		contItem.Label0.top = g_nOpenTop1 + 30
		contItem.lbl1.visible = 0
		contItem.lbl2.visible = 0
	elseif totalCnt_Menu > 0 then 
		contItem.Label0.visible = 1
		contItem.Label0.top = g_nOpenTop0 + 30
		contItem.lbl0.visible = 0
		contItem.lbl1.visible = 0
		contItem.lbl2.visible = 0
	end if 
	contItem.SetScrollAutoSize()
	
End Function

'검색결과 위치 재설정
Function SetObjectPosition(nType)

	if Cint(nType) == STOCK_INDEX then
	
		if totalCnt_Stock == 0 then
			Exit Function
		end if 	
		
		if totalCnt_Menu == 0 then '메뉴결과(X)
			g_nTitleTop1 = INIT_TITLE_TOP
		else	
			'메뉴위치확인
			'더보기버튼 (X)
			if totalCnt_Menu < 4 then
				g_nTitleTop1 = g_nGridTop0 + g_nGridHeight0 + 25	
			'더보기버튼 (O)
			else
				g_nTitleTop1 = g_nGridTop0 + g_nGridHeight0 + 30 + 20 + 15
			end if
		end if 
		
		contItem.lblTitle1.Top = g_nTitleTop1
		contItem.lblTime1.Top = g_nTitleTop1
		
		g_nGridTop1 = g_nTitleTop1 + 37
		contItem.grd1.Top = g_nGridTop1

		'국내주식검색결과 3개이상일 경우 
		if totalCnt_Stock > 3 then
			g_nOpenTop1 = g_nGridTop1 + g_nGridHeight1 + 8 			
			contItem.lblOpen1.Top = g_nOpenTop1 
			contItem.ImgOpen1.Top = g_nOpenTop1 + 12	
			contItem.lbl1.Top = g_nOpenTop1  + 35
		else
			contItem.lbl1.Top = g_nGridTop1 + contItem.grd1.Height + 20
		end if 
		
		'contItem.scroll_pos = g_nTitleTop1	
		
		'해외주식
		'채권
		
	elseif Cint(nType) == GLOBAL_INDEX  then
	
		if totalCnt_Global == 0 then
			Exit Function
		end if 	
		
		'20230830 KKM 검색가 없을 경우 위치 재조정
		if totalCnt_Stock == 0 then '국내주식결과(X)
			
			if totalCnt_Menu == 0 then '메뉴결과(X)
				g_nTitleTop2 = INIT_TITLE_TOP
			else
				'메뉴위치확인
				'더보기버튼 (X)
				if totalCnt_Menu < 4 then
					g_nTitleTop2 = g_nGridTop0 + g_nGridHeight0 + 25	
				'더보기버튼 (O)
				else
					g_nTitleTop2 = g_nGridTop0 + g_nGridHeight0 + 30 + 20 + 15
				end if
			end if 
		else
			'국내주식위치확인
			'더보기버튼(X)
			if totalCnt_Stock < 4 then
				g_nTitleTop2 = g_nGridTop1 + g_nGridHeight1 + 25
			'더보기버튼(O)
			else
				g_nTitleTop2 = g_nGridTop1 + g_nGridHeight1 + 30 + 20 + 15
			end if
		end if
		'20230830 KKM END		
			
		contItem.lblTitle2.Top = g_nTitleTop2
		contItem.lblTime2.Top = g_nTitleTop2
		
		g_nGridTop2 = g_nTitleTop2 + 37		
		contItem.grd2.Top = g_nGridTop2
		
		'해외주식검색결과 4개이상일 경우 
		if totalCnt_Global > 3 then
			g_nOpenTop2 = g_nGridTop2 + g_nGridHeight2 + 8 			
			contItem.lblOpen2.Top = g_nOpenTop2 
			contItem.ImgOpen2.Top = g_nOpenTop2  + 12
			contItem.lbl2.Top = g_nOpenTop2  + 35
		else
			contItem.lbl2.Top = g_nGridTop2 + contItem.grd2.Height + 20
		end if 
		
		'contItem.scroll_pos = g_nTitleTop2	
		
		'채권
		
	elseif Cint(nType) == BOND_INDEX   then
	
		if totalCnt_Bond == 0 then
			Exit Function
		end if 
		
		'20230830 KKM 검색가 없을 경우 위치 재조정
		if totalCnt_Global == 0 then ''해외주식결과(X)
		
			if totalCnt_Stock == 0 then '국내주식결과(X)
			
				if totalCnt_Menu == 0 then '메뉴결과(X)
					g_nTitleTop3 = INIT_TITLE_TOP
				else
					'메뉴위치확인
					'더보기버튼 (X)
					if totalCnt_Menu < 4 then
						g_nTitleTop3 = g_nGridTop0 + g_nGridHeight0 + 25	
					'더보기버튼 (O)
					else
						g_nTitleTop3 = g_nGridTop0 + g_nGridHeight0 + 30 + 20 + 15
					end if
				end if 
			else			
				'국내주식위치확인
				'더보기버튼(X)
				if totalCnt_Stock < 4 then
					g_nTitleTop3 = g_nGridTop1 + g_nGridHeight1 + 25
				'더보기버튼(O)
				else
					g_nTitleTop3 = g_nGridTop1 + g_nGridHeight1 + 30 + 20 + 15
				end if
			end if 
		else
			'해외주식위치확인
			'더보기버튼(X)
			if totalCnt_Global < 4 then			
				g_nTitleTop3 = g_nGridTop2 + g_nGridHeight2 + 25				
			'더보기버튼(O)
			else
				g_nTitleTop3 = g_nGridTop2 + g_nGridHeight2 + 30 + 20 + 15
			end if			
		end if			
		'20230830 KKM END
 		
		contItem.lblTitle3.Top = g_nTitleTop3
		contItem.lblTime3.Top = g_nTitleTop3
		
		g_nGridTop3 = g_nTitleTop3 + 37	
		contItem.grd3.Top = g_nGridTop3
		
		'채권검색결과 4개이상일 경우 
		if totalCnt_Bond > 3 then
			g_nOpenTop3 = g_nGridTop3 + g_nGridHeight3 + 8 
			contItem.lblOpen3.Top = g_nOpenTop3 
			contItem.ImgOpen3.Top = g_nOpenTop3  + 12
		end if 
		
		'contItem.scroll_pos = g_nTitleTop3	
		
	elseif Cint(nType) == MENU_INDEX  then '메뉴
	
		if totalCnt_Menu == 0 then
			Exit Function
		end if 	
	
		contItem.lblTitle0.Top = INIT_TITLE_TOP
		contItem.lblTime0.Top = INIT_TITLE_TOP
		contItem.grd0.Top = INIT_GRID_TOP
		
		'메뉴검색결과 4개이상일 경우 
		if totalCnt_Menu > 3 then
			contItem.grd0.height = INIT_GRIDHEIGHT
			contItem.lblOpen0.Top = INIT_OPEN_TOP
			contItem.ImgOpen0.Top = INIT_IMAGE_TOP
			contItem.lbl0.Top = 235
		else
			contItem.lbl0.Top = INIT_GRID_TOP + contItem.grd0.Height + 20			
		end if
		'contItem.scroll_pos = INIT_TITLE_TOP 
		
		'국내주식
		'해외주식
		'채권
		
	elseif Cint(nType) == RECENT_INDEX  then
		contHistory.grdHistory.height = (INIT_GRIDROW * totalCnt_Menu) * 1
		contHistory.top = 100	
		if contHistory.lblOpenTop.caption == "닫기" then
			contHistory.grdHistory.Top = 182
		else
			contHistory.grdHistory.Top = 170
		end if 
		contHistory.SetScrollAutoSize()	
		Exit Function		
	end if 
	
	contItem.top = 100	
	contItem.SetScrollAutoSize()
End Function

'============================================================================
Sub Form_OnFormInit()
	
	'20230818 START 
	contItem.setExceptInvisibleCtl(true)
	contHistory.setExceptInvisibleCtl(true)
	'20230818 END

	icnSearch.setMaintainingRatio("1")
	contItem.lblOpen0.setMaintainingRatio("1")
	contItem.ImgOpen1.setMaintainingRatio("1")
	contItem.ImgOpen2.setMaintainingRatio("1")
	contItem.ImgOpen3.setMaintainingRatio("1")

	szOSType	= Form.GetSharedData("&OS_TYPE", false)'1.안드로이드 2.iOS
	'2022.04.20 IOS 에디트 이미지 이슈 > 영향 최소화로 IOS일 경우에만 적용
	If szOSType == "2" Then
		
		'20230818 START 
		Edit0.SetOnOffImage("alpha.png","alpha.png")	'select/normal 이미지 설정
		Edit0.imagefilepth = "alpha.png"						'최초 이미지 설정
		'20230818 END 
		
	End If
	
	'에디트 통합검색 모드 설정
	Edit0.UseTotalSearchResult(true)
	
	'초기화
	initObject() 	
	'최근 검색어 세팅
'	contHistory.visible = 1
'	contItem.visible = 0	
	Form.SetTotalSearchResult(RECENT_INDEX,"")
	'실시간순위
	DATAMANAGER.SetDataValue( 0 , "ohhts_top50_002", "InBlock1", "FID_INPUT_MDIA_CLS_CODE" , 0 , Form.getDeviveID() )		
	DATAMANAGER.RequestTranData("ohhts_top50_002")	
	
	'OS별 위치 수정
	g_szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
	if g_szDeviceOS == "2" then 			'아이폰
		 contItem.grd0.scrollenable = "0"   
		 contItem.grd1.scrollenable = "0"   
		 contItem.grd2.scrollenable = "0"   
		 contItem.grd3.scrollenable = "0"   	
	else
		'20230829 KKM 안드로이드만 스크롤보임 후 숨김처리
		contItem.setScrollBarVisible("2") 
		contHistory.setScrollBarVisible("2") 
	end if	

End Sub

