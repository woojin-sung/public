'해외 더보기/닫기
Sub contItem_lblOpen2_OnClick()
'	'시세재조회
'	if CInt(contItem.grd2.rowcount) > 0 then
'		DATAMANAGER.RequestTranData( "ohhts_1030_002r" )
'	end if

	contItem.grd2.rowcount = 0	
'	totalCnt_Global 
	if contItem.lblOpen2.caption == "닫기" then	
		initObjectPosition(GLOBAL_INDEX)
		IdxGlobal = 1
		'contItem.scroll_pos = g_nTitleTop2
		
		g_QueryCount2 = 3			
	else
		IdxGlobal = IdxGlobal + 1	
		'20230824 KKM 현재 페이지에 따른 그리드 Height 조정 
		g_nPlusGridHeight2 = (CInt(IdxGlobal / 3) + 2)
		'20230824 KKM END 
		
		if (IdxGlobal < IdxTotalGlobal) then
			contItem.lblOpen2.caption = "더보기"
			contItem.ImgOpen2.imgpath = "icon_arrow_d.png"			
			'contItem.grd2.height = (INIT_GRIDROW*3)*IdxGlobal + 1
			contItem.grd2.height = (INIT_GRIDROW*3)*IdxGlobal + g_nPlusGridHeight2 '20230824 KKM 현재 페이지에 따른 그리드 Height 조정
			
			g_QueryCount2 = (3*IdxGlobal)				
		else
			contItem.lblOpen2.caption = "닫기"
			contItem.ImgOpen2.imgpath = "icon_arrow_u.png"
			'contItem.grd2.height = INIT_GRIDROW * totalCnt_Global + 1
			contItem.grd2.height = INIT_GRIDROW * totalCnt_Global + g_nPlusGridHeight2 '20230824 KKM 현재 페이지에 따른 그리드 Height 조정
			
			g_QueryCount2 = totalCnt_Global					
		end if
 		
		contItem.lblOpen2.Top = contItem.grd2.Top + contItem.grd2.height + 8
		contItem.ImgOpen2.Top = contItem.grd2.Top + contItem.grd2.height + 20
		'contItem.lbl2.Top = contItem.grd2.Top + contItem.grd2.height + 38
		contItem.lbl2.Top = contItem.grd2.Top + contItem.grd2.height + 43
		
		g_nOpenTop2 = contItem.grd2.Top + contItem.grd2.height + 20		
		g_nGridHeight2 = contItem.grd2.height		
		
		contItem.top = 100	
		contItem.grd2.top = g_nTitleTop2 + 37	
		contItem.SetScrollAutoSize()		
	end if 

	setGridData(GLOBAL_INDEX, szGlobal) '재조회	
	'SetObjectPosition(BOND_INDEX) '채권위치 재설정
	
	'20230824 KKM 마지막 더보기버튼 아래 여백처리 
'	if totalCnt_Bond > 0 then
'		contItem.Label0.top = contItem.grd3.Top + contItem.grd3.height + 8 + 30
	if totalCnt_Global > 0 then
		contItem.Label0.top = contItem.grd2.Top + contItem.grd2.height + 8 + 30
	elseif totalCnt_Stock > 0 then
		contItem.Label0.top = contItem.grd1.Top + contItem.grd1.height + 8 + 30
	elseif totalCnt_Menu > 0 then 
		contItem.Label0.top = contItem.grd0.Top + contItem.grd0.height + 8 + 30
	end if 	
	
 	contItem.top = 100
	contItem.SetScrollAutoSize()	
	'20230824 KKM END 	
	
	lblCntGlobal.caption =  IdxGlobal & " :: " & IdxTotalGlobal
End Sub

