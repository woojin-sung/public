Sub contHistory_lblOpenTop_OnClick()
	'시세재조회
	if CInt(contHistory.grdTop.rowcount) > 0 then
		'실시간순위
		DATAMANAGER.SetDataValue( 0 , "ohhts_top50_002", "InBlock1", "FID_INPUT_MDIA_CLS_CODE" , 0 , Form.getDeviveID() )	
		g_QueryCount = 5
		DATAMANAGER.RequestTranData("ohhts_top50_002")
		
		'DATAMANAGER.RequestTranData("ohhts_1020_001r")
	end if 

	if contHistory.lblOpenTop.caption == "닫기" then
		contHistory.grdTop.height = 41
		contHistory.lblOpenTop.Top = 95
		contHistory.ImgOpenTop.Top = 107
		'contHistory.lblTop.Top = 125
		contHistory.lblTop.Top = 130
		
		contHistory.lblTitleHistory.Top = 150
		contHistory.lblDel.Top = 150
		contHistory.grdHistory.Top = 187		
		contHistory.lblOpenTop.caption = "더보기"
		contHistory.ImgOpenTop.imgpath = "icon_arrow_d.png"
	else
		contHistory.grdTop.height = 202
		contHistory.lblOpenTop.Top = 255
		contHistory.ImgOpenTop.Top = 267
		'contHistory.lblTop.Top = 285
		contHistory.lblTop.Top = 290
		
		contHistory.lblTitleHistory.Top = 310
		contHistory.lblDel.Top = 310
		contHistory.grdHistory.Top = 347	
	
		contHistory.lblOpenTop.caption = "닫기"
		contHistory.ImgOpenTop.imgpath = "icon_arrow_u.png"
		
	end if 	
	
	contHistory.top = 100	
	contHistory.SetScrollAutoSize()		
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	Dim szList

	if g_szCode == "" then
		Exit Sub
	end if
	
	if sKeyName == "MOVEPOP_RETURN" then
		szList = Split(sRet , "★")
		
		Select Case szList(1)
			Case "0"		'현재가
				Form.OpenScreen("11000" , g_szCode & "★" & "0")
			Case "1" 	'차트
				Form.OpenScreen("13000" , g_szCode)
			Case "2" 	'관심등록
				Form.OpenPopup( "mhprc11000_pd" , g_szCode , sPosInfo)
			Case "3" 	'매수
				Form.OpenScreen("12000" , "관심종목" & "★" & "0" & "★" & g_szCode)
			Case "4" 	'매도
				Form.OpenScreen("12000" , "관심종목" & "★" & "1" & "★" & g_szCode)
		End Select
	
	end if
End Sub

'============================================================================
Sub contHistory_grdTop_OnClickUp(lRow, szCellID)
	Dim listLocation
	Dim nYPos
	Dim height

	listLocation = Split(contHistory.grdTop.location, ":")
	nYPos = Int(listLocation[1])	'y위치
	height = listLocation[3]		'높이
	
	sPopupType = "0"

'	g_szCode = DATAMANAGER.GetDataValue( 0 , "ohhts_top50_002", "OutBlock2", "FID_CNCN_ISCD" , lRow)
	g_szCode = contHistory.grdTop.GetCellData("bd_code", lRow)

	if Trim(g_szCode) = "" then
		Exit Sub
	end if

	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "차트" & "★" & "관심등록" & "★" & "매수" & "★" & "매도")
	
End Sub

