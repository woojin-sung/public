'============================================================================
Sub Edit0_OnClick()
	initObject() '초기화
	
	if Edit0.caption == "" then
	
		contHistory.visible = 1
		contItem.visible = 0	
	
		contHistory.grdTop.height = 41
		contHistory.lblOpenTop.Top = 95
		contHistory.ImgOpenTop.Top = 107
		
		contHistory.lblTitleHistory.Top = 135
		contHistory.lblDel.Top = 135
		contHistory.grdHistory.Top = 172
		
		contHistory.lblOpenTop.caption = "더보기"
		contHistory.ImgOpenTop.imgpath = "icon_arrow_d.png"
		
		contHistory.SetScrollAutoSize()			
		
		'최근 검색어
		Form.SetTotalSearchResult(RECENT_INDEX,"")	
		
		'실시간순위
		DATAMANAGER.SetDataValue( 0 , "ohhts_top50_002", "InBlock1", "FID_INPUT_MDIA_CLS_CODE" , 0 , Form.getDeviveID() )	
		g_QueryCount = 1		
		DATAMANAGER.RequestTranData("ohhts_top50_002")
	else 
		Form.SetTotalSearchResult(MENU_INDEX,Edit0.caption) ' 타입 = 4 : 메뉴
	end if 

End Sub

'============================================================================
' 그리드 데이터 세팅
'============================================================================
Function setGridData(nType, szData)
	if Cint(nType) == STOCK_INDEX then
		arrData = split(szData, "^")
		
		dataCnt = #arrData		
		for i=0 to dataCnt - 1
			contItem.grd1.AddRow()
			tmpData1 = Split(arrData(i),"★")
			
			szmk = Change_EtcMarket(Form.GetItemCodeInfo(tmpData1(0), "market"))
			contItem.grd1.SetCellData("bd_mk", i, szmk)
			
			contItem.grd1.SetCellData("bd_market", i, f_GetMarketNameKR(tmpData1(0)))
			contItem.grd1.SetCellFgColor("bd_market", i, "146")
			contItem.grd1.SetCellData("bd_code", i, tmpData1(0))
			contItem.grd1.SetCellFgColor("bd_code", i, "146")
			contItem.grd1.SetCellData("bd_name", i, tmpData1(1))
			'IdxStock = IdxStock + 1
			
			if g_QueryCount1 == i+1 then
				exit for
			end if
		next
		
		'시세조회 
		if CInt(contItem.grd1.rowcount) > 0 then
			DATAMANAGER.RequestTranData( "ohhts_1020_004r" )
		end if
		
		'그리드 특정단어 색상 변경
		'사용여부(true/false), 셀아이디, 특정단어, 색상		
		contItem.grd1.ChangeMatchTextColor(true,"bd_name",Edit0.caption,327) 
		
	elseif Cint(nType) == GLOBAL_INDEX then
		arrData = split(szData, "^")
		
		dataCnt = #arrData		
		for i=0 to dataCnt - 1
			contItem.grd2.AddRow()
			tmpData2 = Split(arrData(i),"★") 'arrData(i) => OQ@AAPL★애플
			
			arrCode = Split(tmpData2(0),"@") ' tmpData2(0) => OQ@AAPL
			contItem.grd2.SetCellData("bd_mk", i, arrCode(0))
			contItem.grd2.SetCellData("bd_market", i, f_GetMarketNameOV(arrCode(0)))
			contItem.grd2.SetCellFgColor("bd_market", i, "146")
			contItem.grd2.SetCellData("bd_code", i, arrCode(1))
			contItem.grd2.SetCellFgColor("bd_code", i, "146")
			contItem.grd2.SetCellData("bd_name", i, tmpData2(1))
			'IdxGlobal = IdxGlobal + 1
			
			if g_QueryCount2 == i+1 then
				exit for
			end if
		next
		
		'시세조회
		if CInt(contItem.grd2.rowcount) > 0 then
			DATAMANAGER.RequestTranData( "ohhts_1030_002r" )
		end if
		
		'그리드 특정단어 색상 변경
		'사용여부(true/false), 셀아이디, 특정단어, 색상				
		contItem.grd2.ChangeMatchTextColor(true,"bd_name",Edit0.caption,327)		
		
	elseif Cint(nType) == BOND_INDEX then
		arrData = split(szData, "^")
		
		dataCnt = #arrData	
		for i=0 to dataCnt - 1
			contItem.grd3.AddRow()
			tmpData3 = Split(arrData(i),"★")
			
			szmk = Change_EtcMarket(Form.GetItemCodeInfo(tmpData3(0), "market"))
			contItem.grd3.SetCellData("bd_mk", i, szmk)
			
			contItem.grd3.SetCellData("bd_market", i, f_GetMarketNameKR(tmpData3(0)))
			contItem.grd3.SetCellFgColor("bd_market", i, "146")
			contItem.grd3.SetCellData("bd_code", i, tmpData3(0))
			contItem.grd3.SetCellFgColor("bd_code", i, "146")
			contItem.grd3.SetCellData("bd_name", i, tmpData3(1))			
			
			'ldxBond = ldxBond + 1
			
			if g_QueryCount3 == i+1 then
				exit for
			end if			
		next	
		
		'시세조회
		if CInt(contItem.grd3.rowcount) > 0 then
			'DATAMANAGER.RequestTranData( "ohhts_7052_001r" )
			DATAMANAGER.RequestTranData( "ohhts_1020_004r_1" )
		end if 
		
		'그리드 특정단어 색상 변경
		'사용여부(true/false), 셀아이디, 특정단어, 색상				
		contItem.grd3.ChangeMatchTextColor(true,"bd_name",Edit0.caption,327)	
		
	elseif Cint(nType) == MENU_INDEX then
		arrData = split(szData, "^")
		
		dataCnt = #arrData		
		for i=0 to dataCnt - 1
			contItem.grd0.addRow()
			tmpData4 = Split(arrData(i),"★")			
			
			contItem.grd0.SetCellData("bd_no", i, tmpData4(0)) '화면번호
			sTemp = ""
			if tmpData4(1)  <> "" then	 ' 대메뉴		
				sTemp = tmpData4(1)				
			end if 
			if tmpData4(2)  <> "" then   '중메뉴
				sTemp = sTemp & " > " & tmpData4(2)				
			end if
			contItem.grd0.SetCellData("bd_menu", i, sTemp) '메뉴
			contItem.grd0.SetCellFgColor("bd_menu", i, "146")
			
			if tmpData4(3)  <> "" then
				contItem.grd0.SetCellData("bd_name", i, tmpData4(3)) '소메뉴
			end if 
			
			if g_QueryCount0 == i+1 then
				exit for
			end if		

		next
				
		'그리드 특정단어 색상 변경
		'사용여부(true/false), 셀아이디, 특정단어, 색상				
		contItem.grd0.ChangeMatchTextColor(true,"bd_name",Edit0.caption,327)	 			
		
	elseif Cint(nType) == RECENT_INDEX then
		arrData = split(szData, "^")
		
		dataCnt = #arrData		
		for i=0 to dataCnt - 1
			contHistory.grdHistory.addRow()
			contHistory.grdHistory.setCellData("bd_cell0", i, arrData(i))
		next
	end if

End Function

''===============================================================================================
'OnTotalSearchResult : Edit0_OnEditComplete()에서 SetTotalSearchResult 호출 후 처리 완료 시 발생
'타입,결과값 개수 리턴 (ex. 국내주식 검색결과 10건 => 1,10
'============================================================================
Sub Form_OnTotalSearchResult(nType, nCount)
	szType = nType'szData(0) '타입
'Form.ShowAlert("nTYPE :: " & nType)	

	'===============================================================
	'국내주식 - Grid1
	'===============================================================
	'if szType == 1 then
	if Cint(szType) = STOCK_INDEX then
	
		contHistory.visible = 0			
		contItem.visible = 1
		contItem.grd1.rowcount = 0
		
		'검색결과값 가져오기 (타입,시작인덱스,마지막 인덱스)
		'---------------------------------------------------
		'결과값
		'국내주식 : 종목코드★종목명^종목코드★종목명...
		'해외주식 : 거래소코드@종목코드★종목명^거래소코드@종목코드★종목명...
		'채권 	 : 종목코드★종목명^종목코드★종목명...
		'메뉴 	 : 화면번호★대메뉴명★중메뉴명★소메뉴명^화면번호★대메뉴명★중메뉴명★소메뉴명
		'최근검색 : 검색어★검색날짜^검색어★검색날짜....
		'---------------------------------------------------
		'20230825 KKM 최대 21개까지 제한
		if nCount > 21 then
			nCount = 21
		end if 		
		totalCnt_Stock = nCount
		szStock =  Form.GetTotalSearchResult(Cint(szType), 0, nCount-1) 
'msgbox "totalCnt_Stock :: " & totalCnt_Stock & "  szStock :: " &  szStock  		
		if szStock == "" then
			contItem.lblTitle1.visible = 0
			contItem.lblTime1.visible = 0
			contItem.grd1.visible = 0
			contItem.lblOpen1.visible = 0
			contItem.ImgOpen1.visible = 0
			'Exit sub
		else
			contItem.lblTitle1.visible = 1
			contItem.lblTime1.visible = 1
			contItem.grd1.visible = 1		
			contItem.lblTime1.caption = "오늘 " & FormatDateTime(now,4) & " 기준"			
			
			IdxStock = 1		
			if totalCnt_Stock < 4 then '더보기 버튼 보이지 않게 수정
				contItem.ImgOpen1.visible = 0
				contItem.lblOpen1.visible = 0
			else
				contItem.ImgOpen1.visible = 1
				contItem.lblOpen1.visible = 1
				
				IdxTotalStock = CInt(totalCnt_Stock / 3)
				nTest = IdxTotalStock * 3
				if nTest < totalCnt_Stock then
					IdxTotalStock = IdxTotalStock+1
				end if
				
				'국내주식페이지
				lblCntStock.caption =  IdxTotalStock			
			end if 
			
			'조회결과설정 - 국내주식
			setGridData(STOCK_INDEX, szStock)			
			'초기위치설정 - 국내주식
			initObjectPosition(STOCK_INDEX) 
		end if	
		
		Form.SetTotalSearchResult(2,Edit0.caption) ' 타입 = 2 : 해외주식		

	'===============================================================
	'해외주식 - Grid2	
	'===============================================================
	elseif Cint(szType) = GLOBAL_INDEX then	
		contHistory.visible = 0
		contItem.visible = 1		
		contItem.grd2.rowcount = 0
		
		'20230825 KKM 최대 21개까지 제한
		if nCount > 21 then
			nCount = 21
		end if 		
		totalCnt_Global = nCount
		szGlobal =  Form.GetTotalSearchResult(Cint(szType), 0, nCount-1) 	
'msgbox "totalCnt_Global :: " & totalCnt_Global & "  szGlobal :: " &  szGlobal  
		if szGlobal == "" then
			contItem.lblTitle2.visible = 0
			contItem.lblTime2.visible = 0
			contItem.grd2.visible = 0
			contItem.lblOpen2.visible = 0
			contItem.ImgOpen2.visible = 0
			'Exit sub
		else
			contItem.lblTitle2.visible = 1
			contItem.lblTime2.visible = 1
			contItem.grd2.visible = 1			
			contItem.lblTime2.caption = "오늘 " & FormatDateTime(now,4) & " 기준"
			
			IdxGlobal = 1					
			if totalCnt_Global < 4 then '더보기 버튼 보이지 않게 수정 
				contItem.ImgOpen2.visible = 0
				contItem.lblOpen2.visible = 0
			else
				contItem.ImgOpen2.visible = 1
				contItem.lblOpen2.visible = 1
				
				IdxTotalGlobal = CInt(totalCnt_Global / 3)
				nTest = IdxTotalGlobal * 3
				if nTest < totalCnt_Global then
					IdxTotalGlobal = IdxTotalGlobal+1
				end if
				
				'해외주식 페이지
				lblCntGlobal.caption =  IdxTotalGlobal			
			end if
			
			'조회결과 설정 - 해외주식
			setGridData(GLOBAL_INDEX, szGlobal)
			'초기위치설정 - 해외주식
			initObjectPosition(GLOBAL_INDEX) 
		end if
		
		'20230818 KKM 채권삭제 
		'Form.SetTotalSearchResult(RECENT_INDEX, Edit0.caption) ' 타입 = 3 : 채권
		
		Form.SetTotalSearchResult(RECENT_INDEX, Edit0.caption) ' 타입 = 5 : 최근 검색어		
	
	'===============================================================
	'채권 - Grid3
	'===============================================================
	elseif Cint(szType) = BOND_INDEX then
		contHistory.visible = 0
		contItem.visible = 1
		contItem.grd3.rowcount = 0
		
		'20230825 KKM 최대 21개까지 제한
		if nCount > 21 then
			nCount = 21
		end if 		
		totalCnt_Bond = nCount
		szBond =  Form.GetTotalSearchResult(Cint(szType), 0, nCount-1)
'msgbox "totalCnt_Bond :: " & totalCnt_Bond & " szBond :: " & szBond  		
		if szBond == "" then		
			contItem.lblTitle3.visible = 0
			contItem.lblTime3.visible = 0
			contItem.grd3.visible = 0			
			contItem.lblOpen3.visible = 0			
			contItem.ImgOpen3.visible = 0			
			'Exit sub
		else
			contItem.lblTitle3.visible = 1
			contItem.lblTime3.visible = 1
			contItem.grd3.visible = 1		
			contItem.lblTime3.caption = "오늘 " & FormatDateTime(now,4) & " 기준"
			
			ldxBond = 1		
			if totalCnt_Bond < 4 then '더보기 버튼 보이지 않게 수정 
				contItem.ImgOpen3.visible = 0
				contItem.lblOpen3.visible = 0
			else
				contItem.ImgOpen3.visible = 1
				contItem.lblOpen3.visible = 1
				
				IdxTotalBond = CInt(totalCnt_Bond / 3)
				nTest = IdxTotalBond * 3
				if nTest < totalCnt_Bond then
					IdxTotalBond = IdxTotalBond+1
				end if
				
				'채권페이지
				lblCntBond.caption =  IdxTotalBond			
			end if 	
		
			'조회결과설정 - 채권
			setGridData(BOND_INDEX, szBond)
			'초기위치설정 - 채권 
			initObjectPosition(BOND_INDEX) 
		end if
		
		Form.SetTotalSearchResult(RECENT_INDEX, Edit0.caption) ' 타입 = 5 : 최근 검색어		
	
	'===============================================================
	'메뉴 - Grid0
	'===============================================================
	elseif Cint(szType) = MENU_INDEX then
		contHistory.visible = 0
		contItem.visible = 1	
		contItem.grd0.rowcount = 0
		lblCntMenu.caption = nCount		

		'20230825 KKM 최대 21개까지 제한
		if nCount > 21 then
			nCount = 21
		end if 		
		totalCnt_Menu = nCount
		szMenu =  Form.GetTotalSearchResult(Cint(szType), 0, nCount-1) 	
'msgbox "totalCnt_Menu :: " & totalCnt_Menu & " szMenu :: " & szMenu
		if szMenu == "" then		
			contItem.lblTitle0.visible = 0
			contItem.grd0.visible = 0
			contItem.lblOpen0.visible = 0			
			contItem.ImgOpen0.visible = 0				
			'Exit sub
		else
			contItem.lblTitle0.visible = 1
			contItem.grd0.visible = 1	
			
			IdxMenu = 1		
			if totalCnt_Menu < 4 then '더보기 버튼 보이지 않게 수정 
				contItem.ImgOpen0.visible = 0
				contItem.lblOpen0.visible = 0
			else
				contItem.ImgOpen0.visible = 1
				contItem.lblOpen0.visible = 1
				
				IdxTotalMenu = CInt(totalCnt_Menu / 3)
				nTest = IdxTotalMenu * 3
				if nTest < totalCnt_Menu then
					IdxTotalMenu = IdxTotalMenu+1
				end if
				
				'메뉴페이지 
				lblCntMenu.caption =  IdxTotalMenu			
			end if			
			
			'조회결과설정 메뉴
			setGridData(MENU_INDEX, szMenu)			
			'초기위치설정 - 메뉴 
			initObjectPosition(MENU_INDEX) 		
		end if
		
		Form.SetTotalSearchResult(1,Edit0.caption) ' 타입 = 1 : 국내주식
	
	'===============================================================
	'최근검색어
	'===============================================================
	elseif Cint(szType) = RECENT_INDEX then
'		contHistory.visible = 1
'		contItem.visible = 0
		
		contHistory.grdHistory.rowcount = 0
		totalCnt_Recent = nCount
		szRecent = Form.GetTotalSearchResult(Cint(szType),0,nCount-1)		 		
		if szRecent == "" then
			Exit sub
		end if
		
		arrData5 = Split(szRecent,"^")
		for i = 0 to Cint(totalCnt_Recent) - 1
			
			contHistory.grdHistory.AddRow()
			tmpData5 = Split(arrData5(i),"★")
			
			contHistory.grdHistory.SetCellData("bd_cell0", i, tmpData5(0)) '검색어
			contHistory.grdHistory.SetCellData("bd_date", i, tmpData5(1)) '날짜
		next
		
		initObjectPosition(RECENT_INDEX) '20230901 KKM 최근검색어 위치설정	
	end if	 
	
End Sub

'============================================================================
' Change_EtcMarket :  해외지수(대표, 업종지수)/ 채권의 마켓구분 변경
'============================================================================
Function Change_EtcMarket(szData)
	if Trim(szData) == "UJ" then
		return "N"
	elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		return "B"
	end if	
	
	return szData
End Function

'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	Select Case szMk
		Case "J", "Q", "F", "MF", "XF", "O", "MO", "QO", "U", "T", "W", "B", "P", "N", "EN", "FN", "EMPTY", "JF", "JO", "WO", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	' 20240412 HSZ : 코스닥글로벌지수 추가	
			return szMk
		'해외주식	
		Case "AX", "HK", "JP", "SZ", "SH", "NY", "OQ"
			return szMk
'		Case "N"			' 해외지수, 환율은 같은 시장구분으로 내려오기에 분리시켜야 한다.
'			If InStr(szCd, "@") == 0 then
'				return "EN"
'			else
'				return szMk
'			end if
		Case Else
			return ""
	End Select
	
End Function

'============================================================================
' GetMarketName :  해외마켓명
'============================================================================
Function f_GetMarketNameOV(szMK)
	if Trim(szMK) == "OQ" then
		return "나스닥"
	elseif Trim(szMK) == "AX" then
		return "아멕스"
	elseif Trim(szMK) == "NY" then
		return "뉴욕"
	elseif Trim(szMK) == "SH" then
		return "상해"
	elseif Trim(szMK) == "SZ" then
		return "심천"
	elseif Trim(szMK) == "HK" then
		return "홍콩"
	elseif Trim(szMK) == "JP" then
		return "일본"
	end if	
	
	return szMK
End Function

'============================================================================
' f_GetMarketName : 종목코드에 따른 시장명 RETURN
'============================================================================
Function f_GetMarketNameKR(szCode)
	Dim szMarket, szInnerMk
	szMarket =  Form.GetItemCodeInfo(szCode, "market")
	szMarket = Change_EtcMarket(szMarket)
	szMarket = f_ChkMarket(szMarket, szCode)
	
	
	if szMarket == "J" then
		szInnerMk = Form.GetItemCodeInfo(szCode, "innermarket")
		
		if LEFT(szCode, 1, 1) == "J" then
			return "신주인수권"
		elseif LEFT(szCode, 1, 1) == "F" then
			return "수익증권"
		end if
		
		if szInnerMk == "001" then
			return "KOSPI"
		elseif szInnerMk == "002" then
			return "KOSDAQ"
		elseif szInnerMk == "013" then
			return "ETF"
		elseif szInnerMk == "033" then
			return "KONEX"
		else
			return ""
		end if		
		
	elseif szMarket == "Q" then
		return "ETN"
	elseif szMarket == "W" then
		return "ELW"
	elseif szMarket == "T" then
		return "K-OTC"
	elseif szMarket == "F" or szMarket == "MF" or szMarket == "XF" or 
		szMarket == "O" or szMarket == "MO" or szMarket == "QO"  or
		szMarket == "WO" or szMarket == "KF" then					' 20240412 HSZ : 코스닥글로벌지수 추가
		
		return "선물옵션"
	elseif szMarket == "U" then
		return "업종지수"
	elseif szMarket == "B" then
		return "채권"
	elseif szMarket == "N" then
		return "해외지수"
	elseif szMarket == "FN" then
		return "해외선물"
	elseif szMarket == "EN" then
		return "환율"
	elseif szMarket == "JF" or szMarket == "JO" then
		return "주식선물옵션"
	
	end if
	 
End Function

'============================================================================
Sub contHistory_grdHistory_OnClickUp(lRow, szCellID)
	'검색어 히스토리 그리드 검색어 클릭 시 바로 검색
	if szCellID == "bd_cell0" then
		searchKey = contHistory.grdHistory.GetCellData("bd_cell0", lRow)		
		Edit0.caption = searchKey		
		Edit0_OnClick()	
		
	'검색어 히스토리 삭제 버튼 클릭 시
	elseif szCellID == "bd_delete" then
		removeKey = contHistory.grdHistory.GetCellData("bd_cell0", lRow)
		Form.DeleteTotalSearchHistoryItem(removeKey)
		
		tmpData5 = Form.GetTotalSearchResult(RECENT_INDEX, 0, contHistory.grdHistory.rowcount -1)		
		if tmpData5 == "" or tmpData5 == nil then 
			Exit Sub
		end if 
		
		contHistory.grdHistory.rowcount = 0
		arrData5 = Split(tmpData5,"^")
		nDataCnt5 = #arrData5	
		for i = 0 to Cint(nDataCnt5) - 1
			contHistory.grdHistory.AddRow()
			tmpData5 = Split(arrData5(i),"★")
			contHistory.grdHistory.SetCellData("bd_cell0", i, tmpData5(0)) '검색어
			contHistory.grdHistory.SetCellData("bd_date", i, tmpData5(1)) '날짜			
		next
	end if	
End Sub

'============================================================================
Sub contHistory_lblDel_OnClick()
	Form.DeleteAllTotalSearchHistory()
		
	contHistory.grdHistory.rowcount = 0
	tmpData5 = Form.GetTotalSearchResult(RECENT_INDEX,0,0)
	
	arrData5 = Split(tmpData5,"^")
	nDataCnt5 = #arrData5
		
	'사실 밑에껀 없어도됨. 전체삭제 후에는 nDataCnt5 = 0으로 내려옴
	if nDataCnt5 > 1 then
	
		for i = 0 to Cint(nDataCnt5) - 1
			
			contHistory.grdHistory.AddRow()
			tmpData5 = Split(arrData5(i),"★")
			
			contHistory.grdHistory.SetCellData("bd_cell0", i, tmpData5(0)) '검색어
			contHistory.grdHistory.SetCellData("bd_date", i, tmpData5(1)) '날짜
		next
	
	end if
End Sub

