'현재가이동
Function Move_Popup(szMk, szCd, sKorname)

		Select Case szMk
			Case "J", "Q", "T", "W"		' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
				szScreen1 = "11000"
				'szScreen1 = "13100"   'CFD현재가
				
			Case "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO", "KF"	' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	' 20240412 HSZ : 코스닥글로벌지수 추가
				szScreen1 = "31000"
				
			Case "U"						' 업종코드
				szScreen1 = "42000"
				
			Case "N", "EN", "FN"			' 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
				szScreen1 = "42040"
				
			Case "B"						' 소액채권, 장내채권
				szScreen1 = "54010"
				
			'해외주식 현재가	
			Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
				szOVCode = szMk & "@" & szCd
				Form.SetSharedData( "&ITEM_CODE" , szOVCode )
				Form.SetSharedData( "&ITEM_KORNAME" , sKorname  )
				Form.SetSharedData( "&ITEM_OVERSTOCK", szOVCode.."★"..sKorname.."★".."", "" )			
				Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szOVCode.."★"..sKorname.."★".."", "" )
				Form.OpenScreen("16000", "")				
				Exit Function 
		End Select
		
		
		'국내주식  현재가 이동 
		szMk = Form.GetItemCodeInfo(szMk, "market")  '해외일 경우 체크필요
		szMk = Change_EtcMarket(szMk)
		
		if szMk == "U" then
			Form.OpenScreen(szScreen1, "2" & "★" & szCd )
		elseif szMk == "B" then
			Form.OpenScreen(szScreen1, "관심종목"  & "★" & szCd & "★" & "0")
		else
			Form.OpenScreen(szScreen1, szCd)
		end if		

End Function

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'국내시세 조회
	if szTranID ==  "ohhts_1020_004r" then
		DATAMANAGER.ClearInputData( false, szTranID)
		
		contItem.lblTime1.caption = "오늘 " & FormatDateTime(now,4) & " 기준"		
		For i = 0 to contItem.grd1.rowcount-1
			szMk = contItem.grd1.GetCellData("bd_mk", i)
			szCd = contItem.grd1.GetCellData("bd_code", i)
			
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i, szMk)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD",               i, szCd)			
		Next
	'해외시세조회	
	elseif szTranID ==  "ohhts_1030_002r" then
		DATAMANAGER.ClearInputData( false, szTranID)
		
		contItem.lblTime2.caption = "오늘 " & FormatDateTime(now,4) & " 기준"		
		For i = 0 to contItem.grd2.rowcount-1
			szMk = contItem.grd2.GetCellData("bd_mk", i)
			szCd = contItem.grd2.GetCellData("bd_code", i)
			
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i, "OV") '해외주식	
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_COND_MRKT_CLS_CODE", i, szMk)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_OVRS_ISCD",    i, szCd)			
			' 시장별 실시간여부값
			'szRealAble = Form.GetSharedData( "REALTIME_"&szMk, false )
			szRealAble = "0"
			DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE", j, szRealAble ) '실시간여부
		Next
		
	'채권시세 조회
	'elseif szTranID ==  "ohhts_7052_001r" then
	elseif szTranID ==  "ohhts_1020_004r_1" then	
		DATAMANAGER.ClearInputData( false, szTranID )
		
		contItem.lblTime3.caption = "오늘 " & FormatDateTime(now,4) & " 기준"
		For i = 0 to contItem.grd3.rowcount-1
			szMk = contItem.grd3.GetCellData("bd_mk", i)
			szCd = contItem.grd3.GetCellData("bd_code", i)
			
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i, szMk)
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_ISCD",               i, szCd)			
		Next	
	'실시간순위 국내종목 시세조회	
	elseif szTranID == "ohhts_1020_001r" then
	
		contHistory.grdTop.SetClear()
		'DATAMANAGER.CancelRealData("ohhts_stck_incg")	
		g_nCount = 0
		for i = 0 to CDbl(DATAMANAGER.GetDataCount( 0 , "ohhts_top50_002", "OutBlock2")) - 1		
			if DATAMANAGER.GetDataValue( 0 , "ohhts_top50_002", "OutBlock2", "FID_CNCN_ISCD" , i) <> "" then
			
				DATAMANAGER.SetDataValue( 0 , "ohhts_1020_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , g_nCount , contHistory.grdTopCode.GetCellData("bd_cell1", i))
				DATAMANAGER.SetDataValue( 0 , "ohhts_1020_001r", "InBlock1", "FID_INPUT_ISCD" , g_nCount , contHistory.grdTopCode.GetCellData("bd_cell0", i))
				g_nCount = g_nCount + 1				
			
'				if DATAMANAGER.GetDataValue( 0 , "ohhts_top50_002", "OutBlock2", "FID_SCR_NO" , i) <> "00000000" then	'20160510 LKM (00000000: 기존 99999999: 신규)
'					contHistory.grdTop.SetCellData( "bd_cell7", i, "신규")
'				end if

				if g_nCount == g_QueryCount then
					exit for
				end if
			end if
		next	
	end if 
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_top50_002" then
		
		contHistory.lblTimeTop.caption = "오늘 " & FormatDateTime(now,4) & " 기준"
		
		'실시간순위 시세조회
		DATAMANAGER.RequestTranData("ohhts_1020_001r")
		
	elseif szTranID == "ohhts_1020_001r" then
	
		'for i = 0 to 4
		for i = 0 to g_QueryCount -1
			contHistory.grdTop.SetCellData( "bd_cell0" , i , i+1)
			nVrssSign = CInt(contHistory.grdTop.GetCellData("bd_cell4", i))
			Select Case nVrssSign
				Case 1, 2
					contHistory.grdTop.SetCellFgColor( "bd_cell5", i, "10")
					contHistory.grdTop.SetCellFgColor( "bd_cell1", i, "10")
					contHistory.grdTop.SetCellFgColor( "bd_cell3", i, "10")
				Case 4, 5
					contHistory.grdTop.SetCellFgColor( "bd_cell5", i, "11")
					contHistory.grdTop.SetCellFgColor( "bd_cell1", i, "11")
					contHistory.grdTop.SetCellFgColor( "bd_cell3", i, "11")
				Case Else
					contHistory.grdTop.SetCellFgColor( "bd_cell5", i, "12")
					contHistory.grdTop.SetCellFgColor( "bd_cell1", i, "12")
					contHistory.grdTop.SetCellFgColor( "bd_cell3", i, "12")
			End Select
		next
'
'		' 실시간을 위한 작업 //////////////////////////////////////////////
'		'For j = 0 to g_QueryCount -1
'		For j = 0 to 4
'			Dim szCd, szMk
'			szCd = contHistory.grdTop.GetCellData("bd_code", j)
'				
'			if szCd <> "" then
'				szMk = Form.GetItemCodeInfo(szCd, "market")
'					
'				if szMk <> "" then
'					Set_Real_Input(szMk, j, szCd)
'				end if
'			end if
'		Next
'		Real_RequestData(szMk)
	end if
	
'	contHistory.grdTop.rowcount = 5
	contHistory.grdTop.rowcount = g_QueryCount
	contHistory.grdTopCode.rowcount = 5	
End Sub

