Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	'for i = 0 to 4
	for i = 0 to g_QueryCount -1
		contHistory.grdTop.SetCellData( "bd_cell0" , i , i+1)
		nVrssSign = CInt(contHistory.grdTop.GetCellData("bd_cell4", i))
		Select Case nVrssSign
			Case 1, 2
				contHistory.grdTop.SetCellFgColor( "bd_cell5", i, "10")
				contHistory.grdTop.SetCellFgColor( "bd_cell1", i, "10")
				contHistory.grdTop.SetCellFgColor( "bd_cell3", i, "10")
			Case 4, 5
				contHistory.grdTop.SetCellFgColor( "bd_cell5", i, "11")
				contHistory.grdTop.SetCellFgColor( "bd_cell1", i, "11")
				contHistory.grdTop.SetCellFgColor( "bd_cell3", i, "11")
			Case Else
				contHistory.grdTop.SetCellFgColor( "bd_cell5", i, "12")
				contHistory.grdTop.SetCellFgColor( "bd_cell1", i, "12")
				contHistory.grdTop.SetCellFgColor( "bd_cell3", i, "12")
		End Select
	next
End Sub


'============================================================================
'메뉴 더보기/닫기
Sub contItem_lblOpen0_OnClick()
'	totalCnt_Menu
	contItem.grd0.rowcount = 0
	if contItem.lblOpen0.caption == "닫기" then	
		initObjectPosition(MENU_INDEX)
		IdxMenu = 1
		g_nOpenTop0 = 200
		g_nGridHeight0 = 145
		'contItem.scroll_pos = g_nTitleTop0
		
		g_QueryCount0 = 3
	else
		'더보기 
		IdxMenu = IdxMenu + 1	
		'20230824 KKM 현재 페이지에 따른 그리드 Height 조정 
		g_nPlusGridHeight0 = (CInt(IdxMenu / 3) + 2)
		'20230824 KKM END
		
		if (IdxMenu < IdxTotalMenu) then
			contItem.lblOpen0.caption = "더보기"
			contItem.ImgOpen0.imgpath = "icon_arrow_d.png"			
			'contItem.grd0.height = (INIT_GRIDROW*3)*IdxMenu + 1	
			contItem.grd0.height = (INIT_GRIDROW*3)*IdxMenu + g_nPlusGridHeight0	 '20230824 KKM 현재 페이지에 따른 그리드 Height 조정
			
			g_QueryCount0 = (3*IdxMenu)		
		else
			contItem.lblOpen0.caption = "닫기"
			contItem.ImgOpen0.imgpath = "icon_arrow_u.png"			
			'contItem.grd0.height = INIT_GRIDROW * totalCnt_Menu + 1			
			contItem.grd0.height = INIT_GRIDROW * totalCnt_Menu + g_nPlusGridHeight0	'20230824 KKM 현재 페이지에 따른 그리드 Height 조정		
			
			g_QueryCount0 = totalCnt_Menu
		end if
		
		contItem.lblOpen0.Top = contItem.grd0.Top + contItem.grd0.height + 8
		contItem.ImgOpen0.Top = contItem.grd0.Top + contItem.grd0.height + 20
		'contItem.lbl0.Top = contItem.grd0.Top + contItem.grd0.height + 38
		contItem.lbl0.Top = contItem.grd0.Top + contItem.grd0.height + 43
		
		g_nOpenTop0 = contItem.grd0.Top + contItem.grd0.height + 20
		g_nGridHeight0 = contItem.grd0.height
		
		contItem.top = 100	
		contItem.grd0.top = INIT_GRID_TOP
		contItem.SetScrollAutoSize()
	end if 
	
	setGridData(MENU_INDEX, szMenu) '재조회
	SetObjectPosition(STOCK_INDEX) '국내주식위치 재설정
	SetObjectPosition(GLOBAL_INDEX) '해외주식위치 재설정
	'SetObjectPosition(BOND_INDEX) '채권위치 재설정
	
	'20230824 KKM 마지막 더보기버튼 아래 여백처리
'	if totalCnt_Bond > 0 then
'		contItem.Label0.top = contItem.grd3.Top + contItem.grd3.height + 8 + 30
	if totalCnt_Global > 0 then
		contItem.Label0.top = contItem.grd2.Top + contItem.grd2.height + 8 + 30
	elseif totalCnt_Stock > 0 then
		contItem.Label0.top = contItem.grd1.Top + contItem.grd1.height + 8 + 30
	elseif totalCnt_Menu > 0 then 
		contItem.Label0.top = contItem.grd0.Top + contItem.grd0.height + 8 + 30
	end if
 	contItem.top = 100
	contItem.SetScrollAutoSize()	
	'20230824 KKM END
	
	lblCntMenu.caption =  IdxMenu & " :: " & IdxTotalMenu
End Sub

'============================================================================
'주식 더보기/닫기
Sub contItem_lblOpen1_OnClick()
'	'시세재조회 
'	if CInt(contItem.grd1.rowcount) > 0 then
'		DATAMANAGER.RequestTranData( "ohhts_1020_004r" )
'	end if	
	contItem.grd1.rowcount = 0
	
'	totalCnt_Stock 
	if contItem.lblOpen1.caption == "닫기" then	
		initObjectPosition(STOCK_INDEX)
		IdxStock = 1
		'contItem.scroll_pos = g_nTitleTop1	
		
		g_QueryCount1 = 3		
	else	
		'더보기	
		IdxStock = IdxStock + 1
		'20230824 KKM 현재 페이지에 따른 그리드 Height 조정 
		g_nPlusGridHeight1 = (CInt(IdxStock / 3) + 2)
 		'20230824 KKM END  
		
		if (IdxStock < IdxTotalStock) then
			contItem.lblOpen1.caption = "더보기"
			contItem.ImgOpen1.imgpath = "icon_arrow_d.png"
			contItem.grd1.height = (INIT_GRIDROW*3)*IdxStock + g_nPlusGridHeight1 '20230824 KKM 현재 페이지에 따른 그리드 Height 조정
			
			g_QueryCount1 = 3*IdxStock				
		else
			contItem.lblOpen1.caption = "닫기"
			contItem.ImgOpen1.imgpath = "icon_arrow_u.png"
			contItem.grd1.height = INIT_GRIDROW * totalCnt_Stock + g_nPlusGridHeight1 '20230824 KKM 현재 페이지에 따른 그리드 Height 조정
			
			g_QueryCount1 = totalCnt_Stock			
		end if 
		
		contItem.lblOpen1.Top = contItem.grd1.Top + contItem.grd1.height + 8
		contItem.ImgOpen1.Top = contItem.grd1.Top + contItem.grd1.height + 20
		'contItem.lbl1.Top = contItem.grd1.Top + contItem.grd1.height + 38		
		contItem.lbl1.Top = contItem.grd1.Top + contItem.grd1.height + 43		
		
		g_nOpenTop1 = contItem.grd1.Top + contItem.grd1.height + 20		
		g_nGridHeight1 = contItem.grd1.height	
		
		contItem.top = 100	
		contItem.grd1.top = g_nTitleTop1 + 37 
		contItem.SetScrollAutoSize()
	end if
	
	setGridData(STOCK_INDEX, szStock) '재조회	
	SetObjectPosition(GLOBAL_INDEX) '해외주식위치 재설정	
	'SetObjectPosition(BOND_INDEX) '채권위치 재설정
	
	'20230824 KKM 마지막 더보기버튼 아래 여백처리
'	if totalCnt_Bond > 0 then
'		contItem.Label0.top = contItem.grd3.Top + contItem.grd3.height + 8 + 30
	if totalCnt_Global > 0 then
		contItem.Label0.top = contItem.grd2.Top + contItem.grd2.height + 8 + 30
	elseif totalCnt_Stock > 0 then
		contItem.Label0.top = contItem.grd1.Top + contItem.grd1.height + 8 + 30
	elseif totalCnt_Menu > 0 then 
		contItem.Label0.top = contItem.grd0.Top + contItem.grd0.height + 8 + 30
	end if 	
 	contItem.top = 100
	contItem.SetScrollAutoSize()	
	'20230824 KKM END 	
	
	lblCntStock.caption =  IdxStock & " :: " & IdxTotalStock
End Sub

