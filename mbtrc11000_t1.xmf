Sub grd0_OnScrollEnd()
	'20220512 KSJ obtrc_rmnd_001r > obtrc_rmnd_003r 변경
	Dim isMore
'	isMore = DATAMANAGER.IsMoreNextData( "obtrc_rmnd_001r" )
	isMore = DATAMANAGER.IsMoreNextData( "obtrc_rmnd_003r" )
	
	if isMore == true or isMore == 1 or isMore == "1" then
'		DATAMANAGER.RequestNextData( "obtrc_rmnd_001r" )
		DATAMANAGER.RequestNextData( "obtrc_rmnd_003r" )
	end if
	
End Sub

