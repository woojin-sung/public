Sub Form_OnFormClose()
	Form.SaveConfigData("mbtrs13000", "balance1"	, rdo0.currentindex )	'신용합산
	Form.SaveConfigData("mbtrs13000", "fold"		, g_szFold		) 	'펼침버튼

End Sub

