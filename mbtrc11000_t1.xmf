--===========================================================================
'아이티젠 김성수 20220106 변경내용
'>> 기존 "ooase_seex_084r", "InBlock1", "UI_VLTN_AMT" 값을
'"obtrc_rmnd_001r", "OutBlock2", "ACNT_VLTN_AMT" 값으로 인풋을 넣어 조회했으나
'대용기능 추가로 인하여 "obacb_balc_105r" 서비스 신규추가 후에
'"ooase_seex_084r", "InBlock1", "UI_VLTN_AMT" 값을
'"obacb_balc_105r", "OutBlock1", "VLTN_AMT" 값으로 변경
'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_szACNO, g_szASNO, g_szItemCode, g_szData
Dim g_bFalg, g_szFold

Dim g_index

Dim g_RghtFlag
Dim g_Toggle1
Dim g_Toggle2
Dim g_Buffer
Dim g_switch
Dim g_VltnFlag '0 계좌평가금액 1 잔고평가금액

g_bFalg = True
g_szFold = "0"

Dim g_nVLTN_AMT '20220106 아이티젠 김성수 추가
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Function Account_Check()
	Dim szACNO, szASNO
	
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
	
	If szACNO = "" OR szASNO = "" Then
		Form.ShowAlert("알림", "계좌정보가 없습니다.")
		Return False
	End If

	Return true
End Function

'============================================================================
Function SetGridData()
'	Dim i, nRate, szData, szReturnValue
'	Dim nVLTN_PRLS_AMT	' 평가손익
'	Dim nBYNG_AMT			' 매입금액	
'	Dim nEXPN_AMT			' 비용금액
'	Dim nTOT_VLTN_PRLS_AMT	' 평가손익합계
'	Dim nTOT_BYNG_AMT		' 매입금액합계
'	
'	nVLTN_PRLS_AMT 	 = 0
'	nBYNG_AMT 		 = 0
'	nTOT_VLTN_PRLS_AMT = 0
'	nTOT_BYNG_AMT		 = 0
	g_Toggle1 = 0
	g_Toggle2 = 0
'
	SetGridHeader(g_Toggle1, g_Toggle2)
'	
'	For i = 0 To grd0.rowcount -1
'		nVLTN_PRLS_AMT	= CDbl( grd0.GetCellData( "bd_cell5", i ) )
'	
'		nBYNG_AMT 	  	= CDbl( grd0.GetCellData( "bd_cell8", i ) )
'		nPSNT_PRC		= grd0.GetCellData( "bd_cell4", i )
'		
'		nTOT_VLTN_PRLS_AMT= nTOT_VLTN_PRLS_AMT + nVLTN_PRLS_AMT
'		nTOT_BYNG_AMT		= nTOT_BYNG_AMT + nBYNG_AMT
'	Next	
'	
'	'20210628 마지막 종목의 매입금액이 0인 경우 수익률이 0으로 나오는 경우가 있어서 총매입금액으로 변경
''	if nBYNG_AMT == 0 then
'	if nTOT_BYNG_AMT == 0 then
'		nRate = 0
'	else
'		nRate = Round((nTOT_VLTN_PRLS_AMT / nTOT_BYNG_AMT) * 100, 2)	
'	end if
'	
'	tbl0.SetCellString( 2, 2, nTOT_VLTN_PRLS_AMT	)	'미실현손익
'	tbl0.SetCellString( 2, 1, nRate   			)	'손익률


	
	For i = 0 To grd0.rowcount -1
		'매매구분
		szData = grd0.GetCellData( "bd_TypeCd", i)
		
		If szData = "1" Then
			grd0.SetCellFgColor("bd_Type", i, "11")
		Else
			grd0.SetCellFgColor("bd_Type", i, "10")
		End If
	Next	
End Function

'============================================================================
Function RequestData()
	grd0.rowcount = 0
	
	'20220512 KSJ obtrc_rmnd_003r 추가
	'상단테이블 월정산기준 기존 obtrc_rmnd_001r 사용 그리드 obtrc_rmnd_003r 변경
	DATAMANAGER.RequestTranData( "obtrc_rmnd_001r" )	
	DATAMANAGER.RequestTranData( "obtrc_rmnd_003r" )
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim szChkVal1, szChkVal2, szFold
	
	szChkVal1 = Form.LoadConfigData( "mbtrs13000", "balance1"	)		'신용합산
	szFold	 = Form.LoadConfigData( "mbtrs13000", "fold"		)		'펼침버튼
	
	If szChkVal1 <> "" Then
		rdo0.currentindex = CInt(szChkVal1)
	End If
	
	g_VltnFlag = "0"
	
	If szFold <> "" Then
		If szFold = "1" Then
			g_szFold = "0"
		Else
			g_szFold = "1"
		End If
	End If
	
	btnFold_OnClick()
	btnSearch_OnClick()
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szData
	
	szData = rdo0.currentindex
	
	If sEventName = "CHANGE_ORIENTATION" Then
		Form.OpenPopup( "mbtrs15000_h0" , szData , "" )
		Return False
	ElseIf sEventName = "RECEIVE" Then
		btnSearch_OnClick()
		
	ElseIf sEventName = "CHANGE_ACCTNO" Then
		btnSearch_OnClick()
		
	End If

End Sub

'============================================================================
Sub rdo0_OnClick(nIndex)
	RequestData()
End Sub

'============================================================================
Sub btnSearch_OnClick()
	g_switch  = 0
	g_Buffer  = 0
	
	'20220512 KSJ obtrc_rmnd_001r > obtrc_rmnd_003r 변경
	DATAMANAGER.RequestTranData( "obtrc_rmnd_001r" )
	DATAMANAGER.RequestTranData( "obtrc_rmnd_003r" )
	
	'20220106 아이티젠 김성수 추가 START
	DATAMANAGER.RequestTranData( "obacb_balc_105r" )
	'20220106 아이티젠 김성수 추가 END
End Sub

'============================================================================
Sub btnRate_OnClick()
	Dim szData

	If tbl0.GetCellString(3, 0) = "" Or tbl0.GetCellString(3, 0) = "0" Or tbl0.GetCellString(3, 0) = 0 Then
		Form.ShowAlert("알림", "조회를 먼저 하셔야 합니다.")
		Exit Sub
	End If

	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
	
	szData = szACNO & "|" & szASNO & "|" & CDbl( tbl0.GetCellString(1, 2) )

	Form.OpenFramePopup( "mbtrs15000_p1" , szData , "")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNO, szASNO
	
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
	
	If szTranID = "obtrc_rmnd_001r" Then	
		DATAMANAGER.SetDataValue( 0, "obtrc_rmnd_001r", "InBlock1", "ACNO", 0 , szACNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrc_rmnd_001r", "InBlock1", "ASNO", 0 , szASNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrc_rmnd_001r", "InBlock1", "STND_DATE", 0 , Form.GetSharedData( "&HOST_DATE", False) )
		DATAMANAGER.SetDataValue( 0, "obtrc_rmnd_001r", "InBlock1", "IQRY_CLS_CODE", 0 , "1" ) '1:월정산 기준 / 2 : 전일대비 기준
	
	'20220512 KSJ 하단 그리드 obtrc_rmnd_003r로 변경
	ElseIf szTranID = "obtrc_rmnd_003r" Then
		Dim IQRY_CLS_CODE
		
		If rdo0.currentindex = "0" or rdo0.currentindex = 0 then
			IQRY_CLS_CODE = "1" '최초매입가 기준
		Else
			IQRY_CLS_CODE = "2" '월정산 기준
		End If
		
		DATAMANAGER.SetDataValue( 0, "obtrc_rmnd_003r", "InBlock1", "ACNO", 0 , szACNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrc_rmnd_003r", "InBlock1", "ASNO", 0 , szASNO 		)
		DATAMANAGER.SetDataValue( 0, "obtrc_rmnd_003r", "InBlock1", "STND_DATE", 0 , Form.GetSharedData( "&HOST_DATE", False) )
		DATAMANAGER.SetDataValue( 0, "obtrc_rmnd_003r", "InBlock1", "IQRY_CLS_CODE", 0 , IQRY_CLS_CODE )
		DATAMANAGER.SetDataValue( 0, "obtrc_rmnd_003r", "InBlock1", "DEAL_CLS_CODE", 0 , "%" )
	ElseIf szTranID = "ooase_seex_084r" Then
		DATAMANAGER.SetDataValue( 0, "ooase_seex_084r", "InBlock1", "ACNO" 			, 0 , szACNO 		)
		DATAMANAGER.SetDataValue( 0, "ooase_seex_084r", "InBlock1", "ASNO" 			, 0 , szASNO 		)
'		DATAMANAGER.SetDataValue( 0, "ooase_seex_084r", "InBlock1", "UI_VLTN_AMT" 	, 0 , tbl0.GetCellString( 1, 1 ) )
		DATAMANAGER.SetDataValue( 0, "ooase_seex_084r", "InBlock1", "UI_VLTN_AMT" 	, 0 , g_nVLTN_AMT )
	
	ElseIf szTranID = "obacb_balc_105r" Then
		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "ACNO", 0 , szACNO 		)
		DATAMANAGER.SetDataValue( 0, "obacb_balc_105r", "InBlock1", "ASNO", 0 , szASNO 		)
		
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "ooase_seex_084r" Then
	
		'당일
		tbl0.SetCellString( 3, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_PRLS_AMT", 0 ) )
		
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN", 0 ) = "Y" THEN 
			tbl0.SetCellMaskInfo( 3, 1, "1,0,,,0,,0,1,1,0,0" )
			tbl0.SetCellString( 3, 1, "-" )
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN", 0 ) = "A" THEN 
			tbl0.SetCellMaskInfo( 3, 1, "1,0,,,0,,0,1,1,0,0" )
			tbl0.SetCellString( 3, 1, "N/A" )
		ELSE 
			tbl0.SetCellMaskInfo( 3, 1, "0,0,,%,0,,2,1,1,0,0" )
			tbl0.SetCellString( 3, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "PLRT", 0 ) )
		End If
	
		'누적
		tbl0.SetCellString( 4, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_PRLS_AMT5" 		, 0 ) )
		
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN4", 0 ) = "Y" THEN 
			tbl0.SetCellMaskInfo( 4, 1, "1,0,,,0,,0,1,1,0,0" )
			tbl0.SetCellString( 4, 1, "-" )
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN4", 0 ) = "A" THEN 
			tbl0.SetCellMaskInfo( 4, 1, "1,0,,,0,,0,1,1,0,0" )
			tbl0.SetCellString( 4, 1, "N/A" )
		ELSE 
			tbl0.SetCellMaskInfo( 4, 1, "0,0,,%,0,,2,1,1,0,0" )
			tbl0.SetCellString( 4, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "M6_PLRT", 0 ) )
		End If	
		
	ElseIf szTranID = "obtrc_rmnd_001r" Then
		g_bFalg = False
		
		MKSC_VLTN_AMT	= DATAMANAGER.GetDataValue(0, "obtrc_rmnd_001r", "OutBlock2", "CFD_VLTN_AMT" , 0)
		VLTN_AMT		= DATAMANAGER.GetDataValue(0, "obtrc_rmnd_001r", "OutBlock2", "ACNT_VLTN_AMT"	, 0)
		
		if g_VltnFlag == "0" then
			tbl0.SetCellString(1, 1, VLTN_AMT)
			tbl1.SetCellString(0, 2, MKSC_VLTN_AMT)
		else
			tbl0.SetCellString(1, 1, MKSC_VLTN_AMT)
			tbl1.SetCellString(0, 2, VLTN_AMT)
		end if
		
	'20220512 KSJ obtrc_rmnd_003r 추가
	ElseIf szTranID = "obtrc_rmnd_003r" Then
		'20220106 아이티젠 김성수 삭제
'		DATAMANAGER.RequestTranData( "ooase_seex_084r" )	
		SetGridData()
		
		g_switch  = 1
	
	'20220106 아이티젠 김성수 추가 START
	ElseIf szTranID = "obacb_balc_105r" Then
		g_nVLTN_AMT = DATAMANAGER.GetDataValue( 0, "obacb_balc_105r", "OutBlock1", "VLTN_AMT", 0 )
		
		DATAMANAGER.RequestTranData( "ooase_seex_084r" )	
	'20220106 아이티젠 김성수 추가 END
	End If
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "MOVEPOP_RETURN"	then
		Dim szListItems
		szListItems	=	split(sRet,"★")
		
'		if	szListItems(2) = "2" then
			if	szListItems(1) = "0" then			'현재가
				Form.OpenScreen("13100" , g_szItemCode & "★" & "0") 
			elseif 	szListItems(1)	=	"1"	then		'차트
				Form.OpenScreen("13100" , g_szItemCode & "★" & "3")
			elseif 	szListItems(1)	=	"2"	then		'청산
				Form.OpenScreen("13200" , "잔고" & "★" & "2" & "★" & g_szData ) 
			end if
			
'		end if
		
		g_szData = ""
		
	end if 
	
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szItemCode, szQty, sPopupType, sMasudoType
	Dim szCutCd, szMk
	Dim errmsg
	
	errmsg = "종목마스터의 오류로 주문 및 시세 조회가 불가능합니다. 동일 증상 반복 시 확인 버튼을 눌러 주시기 바랍니다.\n\n ※기타문의사항은 고객지원센터 (1588-3400)로 문의하여 주시기 바랍니다."
	
	g_szItemCode	=	grd0.GetCellData("bd_cell10", lRow)
	
	listLocation =  Split(grd0.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	szItemCode = g_szItemCode
	szQty      = grd0.GetCellData("bd_cell3" , lRow)
	sPopupType = "2"
	sMasudoType = grd0.GetCellData("bd_TypeCd" , lRow)
	
	' 20160310 주문불가한 종목 예외처리
	' 20170502 상장수익증권 예외처리 'F'
	' case: 신주인수권/증권 (9자리)
	if (left(szItemCode,1) ="J" and len(szItemCode) == 9) or left(szItemCode,1) ="Q" or left(szItemCode,1) = "F" Then
		szMk = Form.GetItemCodeInfo(szItemCode, "market")
	' else: 기타
	else
		' 20160310 주문불가한 종목 예외처리
		szCutCd = Mid(szItemCode, 2, Len(szItemCode))
		szMk = Form.GetItemCodeInfo(szCutCd, "market")
	end if 
	
	If Trim(szMk) = "J" or Trim(szMk) = "Q" or Trim(szMk) = "W" or Trim(szMk) = "T" then
		g_szData = szItemCode & "★" & szQty & "♥" & sMasudoType & "♥" & "" & "♥" & "" & "♥" & ""
		if sPopupType = "2" then
			Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "차트" & "★" & "청산" & "★" & "" & "★" & "")
		end if
	Else
	
		Form.MsgBox("알림", errmsg, "REUPDATE", 1)		
	End if
End Sub

