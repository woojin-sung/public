	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szMsgCode	
	
	if szTranID == "obpds_srvc_323r" then
		szMsgCode = DATAMANAGER.GetDataMsgCode( "obpds_srvc_323r" )
		if szMsgCode = "5766" then
			'v0001
			'tbl0.SetCellString( 0 , 1 , "등록" )
			btnOK.enable = false
			btnProvision.enable = false 'v007
			btnModiTel.enable = false 'v007
			
			g_FinCustomer = "Y"
		else
			'v0001
			'tbl0.SetCellString( 0 , 1 , "미등록" )
			btnOK.enable = true
			btnProvision.enable = true 'v007
			btnModiTel.enable = true 'v007
			
'			05.22 일련번호채결 과정 변경
'			g_FinCustomer = "N"			
		end if
	elseif szTranID == "obcsb_acif_000r" then
		g_szCustNum = DATAMANAGER.GetDataValue( 0, "obcsb_acif_000r", "OutBlock1", "CSNO" , 0)
		
		tbl0.SetCellString( 0 , 1 , "" )
		DATAMANAGER.RequestTranData( "obpds_srvc_323r" )
		DATAMANAGER.RequestTranData( "obpds_srvc_353r" ) 'v0001
	elseif szTranID == "obpds_srvc_045a" then
		Form.ShowAlert( "알림", "처리가 완료되었습니다.")
		
		'v007 STA
		g_szSvcSrno = tostring(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SVC_SRNO" , 0))
		DATAMANAGER.RequestTranData( "obcsb_dbif_322a" ) 
		'v007 FIN
	'v0001 sta
	elseif szTranID == "obpds_srvc_353r" then
		Stpl_Stat_Cls_Code = DATAMANAGER.GetDataValue(0, "obpds_srvc_353r", "OutBlock1", "STPL_STAT_CLS_CODE" , 0 )
		if Stpl_Stat_Cls_Code = "01" Then
			tbl0.SetCellString( 0 , 1 , "등록" )
		elseif Stpl_Stat_Cls_Code = "11" Then
			tbl0.SetCellString( 0 , 1 , "자동해지대상" )
		elseif Stpl_Stat_Cls_Code = "12" Then
			tbl0.SetCellString( 0 , 1 , "자동해지" )
		elseif Stpl_Stat_Cls_Code = "02" Then
			tbl0.SetCellString( 0 , 1 , "미등록" )
		else
			tbl0.SetCellString( 0 , 1 , "미등록" )
		end if
	'v0001 fin
	
	'v007 STA
	elseif szTranID	= "obsap_acif_999a" then
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		Form.SetSharedData( "FNPR_JOIN_SRNO", g_szFnprJoinSrno )
		
		Form.SetSharedData("SPCL_CNFR_ACNO", acnt0.caption )
		Form.OpenPopup("mbonl81010_p20" , "" , "")	'2023.05.22 금융소비자 팝업 추가
		
'		If g_szFnprJoinSrno <> "" Then
'			Form.OpenPopup("mbonl81010_p16" , acnt0.total & "★" & g_szFnprJoinSrno, "")
'		End If
		
	elseif szTranID	= "obcsb_dbif_322a" then	
		
		DATAMANAGER.RequestTranData( "obcsb_acif_199a" )	
		
'		f_InitData()
'		DATAMANAGER.RequestTranData( "obcsb_acif_000r" )	
	'v007 Fin 
	elseif szTranID == "obcsb_acif_199a" then 
		f_InitData()
		DATAMANAGER.RequestTranData( "obcsb_acif_000r" )	
	end if
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obpds_srvc_323r" then
		tbl0.SetCellString( 0 , 1 , "조회오류" )
	'v007 obcsb_dbif_322a 추가
	elseif szTranID == "obpds_srvc_045a" or szTranID == "obpds_srvc_353r" or szTranID == "obcsb_dbif_322a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	end if
	
End Sub


'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "Show_mbonl81010" then
		if sRet == "ok" then
			Form.OpenPopup("mbonl81010_p20" , "" , "")
		end if
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData( "FNPR_JOIN_SRNO", "" )
	Form.SetSharedData("mbonl81010_p16_LOAN_YN", "")
End Sub


