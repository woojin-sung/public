'============================================================================
' 01. 화 면 명 : 파생상품ETF거래신청
' 02. 화면설명 : 파생상품ETF거래신청
' 03. 작    성 : 2016.03.03.유창재
' 04. 수    정 : 2016.07.15 김유경 : etf거래 업무 변경에 따른 수정 v0001
'              : 2018.01.22 윤유정 : 해외파생ETF 약정 개발에 따른 81010_p1 sharedData Setting 변경 v0002
'		      : 2019.06.26 김유경 : IO 추가에 따른 매핑 (obpds_srvc_353r)v0003
'			: 2020.09.16 : 권오상 : v004 : T2008250015 : 메모리평문 취약점 수정
' 2021.05.24 : 정민영 : v005 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obpds_srvc_045a IO변경분 적용
' 2021.06.23 : 정민영 : v006 : T2106160014 : 고난도 후속 업무처리
' 2022.04.11 : 김수진 : v007 : 계약서류 교부처리, obsap_acif_999a obcsb_dbif_322a IO 추가
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szCustNum			'고객번호
Dim g_szPW				'비밀번호
Dim g_PlainRm 			'v004 평문적용여부

Dim g_SUCS_YN				'처리결과
Dim g_INCL_Code			'KYC 투자성향등급코드
Dim g_PROD_Code			'KYC 상품등급코드
Dim g_DVPD_Code			'KYC 파생상품유의코드
Dim g_DRVT_YN				'KYC 파생 처리 여부
Dim g_STND_Date			'기준일자
Dim g_REG_Srno			'등록일련번호

'v007 STA
Dim g_szFnprJoinSrno		'금융상품일련번호
DIm g_szSvcSrno			'서비스 일련번호
'v007 FIN

Dim g_FinCustomer 		'금융소비자 팝업 진행상태
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetTrans() : obpds_srvc_045a InBlock1 SET
'============================================================================
Function SetTrans()
	if tbl0.GetCellString( 0, 1) <> "승인완료" then
'		g_szApproveCode = "I"
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE" , 0 , "I")
		DATAMANAGER.RequestTranData( "obpds_srvc_045a" )
	end if
End Function
'============================================================================
' f_InitData() : 초기화 v007
'============================================================================
Function f_InitData()
	g_szCustNum = ""
	tbl0.SetCellString( 0 , 1 , "" )
	
	chkProvision.checkstate = "0"
	g_szFnprJoinSrno = ""
	g_szSvcSrno = ""
End Function


'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' 
'============================================================================
Sub Form_OnFormInit()
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v004
	edtPW.caption = ""
	g_szPW = ""	'v007
	f_InitData()	'v007'
	
	Dim szText
	szText = "<html><body>파생상품 ETF 투자위험 고지문<br><br>"&
			"● 파생상품ETF의 투자위험등급과 적합한 투자자유형을 확인하시고, 귀하의 투자경력이나 투자성향에 적합한 상품인지 신중하게 검토한 뒤 투자결정을 하시기 바랍니다.<br><br>"&
			"● 파생상품ETF의 경우 파생상품의 가치를 결정하는 기초변수 등이 예상과 다른 변화를 보일 때에는 당초 예상과 달리 큰 손실을 입거나 원금전체의 손실을 입을 수 있습니다.<br><br>"&
			"● 레버리지ETF는 기초지수의 일간변동률의 양의 배수로 연동되도록 설계되어 있기 때문에 2일 이상의 기간에는 일별수익률의 복리화 효과의 결과로 기초지수의 양의 배수 수익률과 레버리지 ETF의 누적수익률간 불일치가 발생합니다. 또한, 시간이 경과함에 따라 투자신탁에 영향을 주는 다양한 요인에 의해 누적수익률이 기초지수 누적수익률의 양의 배수를 추적하지 못할 수 있습니다.<br>"&
			" 심지어는 일시적으로 또는 지속적으로 누적수익률간의 음의 상관관계가 나타날 수도 있습니다.<br><br>"&
			"● 인버스ETF는 기초지수 일간변동률의 음의 배수로 연동되도록 설계되어 있기 때문에 2일 이상의 기간에는 일별수익률의 복리화 효과로 기초지수의 음의 배수 수익률과 인버스 ETF의 누적수익률간 불일치가 발생합니다. 또한, 시간이 경과함에 따라 투자신탁에 영향을 주는 다양한 요인에 의해 누적수익률이 기초지수 누적수익률의 음의 배수를 추적하지 못할 수 있습니다."
			&"</body></html>"
	web0.loaddata = szText
	
'	g_szCustNum = Form.GetSharedData( "&CUST_NUM" , false )
	
	g_SUCS_YN = Form.GetSharedData( "KYC_SUCS_YN" , false )
	g_STND_Date = Form.GetSharedData( "KYC_STND_DATE", false )
	g_REG_Srno = Form.GetSharedData( "KYC_REG_SRNO", false )
	' 현재는 703r TR에서 받아옴
	g_INCL_Code = Form.GetSharedData( "KYC_INVT_INCL_GRAD_CODE", false )
	g_PROD_Code = Form.GetSharedData( "KYC_PROD_GRAD_CODE", false )
	g_DVPD_Code = Form.GetSharedData( "KYC_DVPD_EPMD_CODE", false )
	g_DRVT_YN = Form.GetSharedData( "KYC_DRVT_PROS_YN", false )
	
	DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'-----------------------------------
	' 투자성향진단
	'-----------------------------------		
	if sKeyName == "KYCCHK_RETURN" then			'투자성향진단 OK면 Y값내려줌
		if sRet == "Y" then
			SetTrans()
		end if
		
	'-----------------------------------
	' 서류제공방식선택팝업 (mbonl81010_p16) v007 STA
	'-----------------------------------			
	elseif sKeyName == "ok_mbonl81010_p16" then
		If Trim(sRet) == "OK" then
			chkProvision.checkstate = "1"	
		else
			chkProvision.checkstate = "0"
		end if		
	'v007 FIN
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			g_FinCustomer = "Y"
			DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
		elseif sRet == "CANCEL_mbonl81010_p20" then
'			g_FinCustomer = "N"
			
			'가입중단시 처리미완료인경우 메뉴트리로 빠지도록 함 (2023.06.14)
			tRst = Form.GetSharedData( "81010_P20_RST" , false )
			if trim(tRst) <> "Y" then
				Form.OpenMainMenuWithIndex(0,1,0)
			end if
		end if
	end if
	
End Sub
'============================================================================
' acnt0_ChangeAccount() : 계좌변경
'============================================================================
Sub acnt0_ChangeAccount()

	f_InitData() 'v007
	DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
	edtPW.caption = ""
	g_szPW = ""
	
End Sub

'============================================================================
' edtPW_OnEditComplete() : 비밀번호 입력완료
'============================================================================
Sub edtPW_OnEditComplete()

	'v002
	If g_PlainRm = "1" Then '보안모듈 적용
		g_szPW = edtPW.caption 'v002
	Else
		g_szPW = Form.GetEncData( edtPW.caption ) 'v002
	End If
	
'	if g_szFnprJoinSrno <> "" and g_szFnprJoinSrno <> null then
	'등록할때만 조회함.
	if (trim(tbl0.GetCellString(0,1)) == "자동해지" or trim(tbl0.GetCellString(0,1)) == "미등록") then
		DATAMANAGER.RequestTranData( "obsap_acif_999a" ) 'v007 금융상품 일련번호 GET
	end if
'	else
'		DATAMANAGER.RequestTranData( "obcsb_acif_000r" )
'	end if
	
End Sub


'============================================================================
' btnModiTel_OnClick() : 연락처 변경 v007
'============================================================================
Sub btnModiTel_OnClick()
	chkProvision.checkstate = "0"
	Form.OpenFramePopup( "mbonl81000" , "" , "")	'연락처변경
End Sub

'============================================================================
' btnProvision_OnClick() : 서류제공방식선택 > obsap_acif_999a > mbonl81010_p16 호출 v007
'============================================================================
Sub btnProvision_OnClick()
	'비민번호체크
	if edtPW.caption == "" then
		Form.ShowAlert( "알림" , "비밀번호를 입력하세요.")
		Exit Sub
	End If 
	
	If acnt0.total <> "" and acnt0.total <> null Then
		If g_szFnprJoinSrno <> "" Then
			Form.SetSharedData("mbonl81010_p16_LOAN_YN", "Y")	'Y로 넘기면 처리완료 팝업이 안뜸..
			Form.OpenPopup("mbonl81010_p16" , acnt0.total & "★" & g_szFnprJoinSrno, "")
		End If
	End If
End Sub


'============================================================================
' btnOK_OnClick() : 거래신청
'============================================================================
Sub btnOK_OnClick()
	'비민번호체크
	if edtPW.caption == "" then
		Form.ShowAlert( "알림" , "비밀번호를 입력하세요.")
		Exit Sub
	End If 
	
	'서류제공방식체크 v007 STA
	If chkProvision.checkstate == 0 or chkProvision.checkstate == "0" Then
		Form.ShowAlert( "알림" , "서류 제공방식을 선택하세요.")
		Exit Sub		
	End If
	'v007 FIN

	If g_FinCustomer <> "Y" Then
		Form.MsgBox("알림", "전문, 일반 금융소비자를 확인 바랍니다.", "Show_mbonl81010", "1")
		Exit Sub		
	End If
	
	Dim szData
	'szData = "88000" & "★" & acnt0.total & "★" & edtPW.caption
	szData = "88000" & "★" & acnt0.total & "★" & edtPW.caption & "★" & "054" 'v0002

	Form.OpenFramePopup( "mbonl81010_p1" , szData , sPosInfo)
End Sub


'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 통신에 필요한 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obpds_srvc_323r" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_323r", "InBlock1", "CSNO" , 0 , g_szCustNum)
	elseif szTranID == "obpds_srvc_045a" then			'ETF약정
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "ACNT_PWD" , 0 , g_szPW)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "CSNO" , 0 , g_szCustNum)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "SVCD" , 0 , "054")		'054 ETF, 021 ELW
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "SVC_MANG_UNIT_CODE" , 0 , "01")
		
'v006 Sta 무조건 부적합처리는 자동해지보완 로직이므로 약정에서는 제외
'		if g_SUCS_YN == "Y" then
'		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "STND_DATE" , 0 , g_STND_Date)
'		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "REG_SRNO" , 0 , g_REG_Srno)
'		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "PROS_YN" , 0 , "Y")
'		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0 , g_INCL_Code )
'		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_PROD_GRAD_CODE" , 0 , g_PROD_Code)
'		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_BSWR_DIV_CODE" , 0 , "02")
'		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_DVPD_EPMD_CODE" , 0 , g_DVPD_Code)
'		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_045a", "InBlock1", "KYC_DRVT_PROS_YN" , 0 , g_DRVT_YN)
'		end if
'v006 Fin		
	elseif szTranID == "obcsb_acif_000r" then
		DATAMANAGER.SetDataValue( 0 , "obcsb_acif_000r", "InBlock1", "ACNO" , 0 , acnt0.total)
	'v0001
	elseif szTranID == "obpds_srvc_353r" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_353r", "InBlock1", "CSNO" , 0 , g_szCustNum)
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_353r", "InBlock1", "SVCD" , 0 , "054" 	   ) 'v0003 IO 추가에 따른 매핑
		
	'v007 STA
	elseif szTranID == "obcsb_dbif_322a" then 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 				 , 0 , acnt0.total		) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO" 	 , 0 , g_szFnprJoinSrno	) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "BSWR_LRDV_CODE" 	 , 0 , "017"				)	'001:계좌개설 / 017:서비스약정 
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "FNPR_JOIN_DETL_SRNO" , 0 , "00001"			)	'다건일경우 하나씩 증가
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ISCD"				 , 0 , "054"				)	'prcd:계좌개설 / svcd:서비스약정 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "CNRC_DOCU_KEY_VAL"	 , 0 , g_szCustNum & "$" & "054" & "$" & g_szSvcSrno )	'고객번호$서비스코드$서비스일련번호 
	'v007 FIN
	elseif szTranID == "obcsb_acif_199a" then 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO" 			, 0 , g_szFnprJoinSrno	) 	'금융상풍일련번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_DETL_SRNO" 	 	, 0 , "00001"			) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_LRDV_LEVL_CODE" 	, 0 , "01"			)'	"01"투자성
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_MDDV_LEVL_CODE" 	, 0 , "02"			)	'02 서비스약정
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_SMDV_LEVL_CODE"	, 0 , "02"& "054"		)	'&서비스약정코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_DTL_DIV_LEVL_CODE"	, 0 , "000" 			)	'CMA전환신청인경우 "009" 그외엔 "000"
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_ISSU_DIV_LEVL_CODE", 0 , "000"			) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISCD" 	 					, 0 , "054"			)	'054 서비스약정 코드
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "KOR_ISNM" 					, 0 , ""				)	
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CSNO"						, 0 , g_szCustNum		)	'고객번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "SVC_MANG_UNIT_CODE"	 		, 0 , "01" 			)	'서비스관리단위코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO"	 					, 0 , acnt0.caption 	)	'계좌컨트롤 8자리
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" 	 					, 0 , ""				) 	'SVC_MANG_UNIT_CODE가 03일때만 매핑
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CONT_CLS_CODE" 	 			, 0 , "4"			)	'온라인
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CHAN_TYPE_CLS_CODE" 		, 0 , ""				)	
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CAFU_TRGT_YN"				, 0 , ""				)	
