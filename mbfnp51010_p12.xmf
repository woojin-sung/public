'전역변수 설정
Dim g_szRet				' Return 값
Dim g_szACNO '계좌번호
Dim g_szASNO '계좌일련번호
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			'21.07.28 JHY START : 예외처리 추가
			'v006
			if Ubound(szList) >= nIdx then
				if szList(nIdx) <> NULL then
					return szList(nIdx)
				else
					return
				end if
				
			else
				return
			end if
			'21.07.28 JHY END
		else
			return
		end if 
	end if 
	
end function


'============================================================================
'f_SetSurvey(): 설문 셋팅
'============================================================================
Function f_SetSurvey(szTranID)
	Dim nDataCnt		'DATACOUNT
	Dim szQuestion	'문항내용
	Dim nQNum		'질문항
	Dim nItemNo		'아이템번호
	
	nDataCnt = tonumber(DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1"))
	
	Dim szOsType
	szOsType = Form.GetSharedData("&OS_TYPE", false)
	
	For i = 0 to nDataCnt - 1 
		nQNum = tonumber(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "QUES_QSIT_NO", i))
		nItemNo = tonumber(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ITEM_NO_VAL", i))
		szQuestion = Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "GOAL_MRKT_QUES_QSIT_CNTT" , i))
		
		if nItemNo == 0 then
			Form.SetCtlProp("ContBody.Cont0.LabelQ" & tostring(nQNum), "caption", nQNum & ". " &szQuestion)
		else
			Dim tLabelID
			tLabelID = Array("a", "b", "c","d", "e")
			
			Select Case nQNum
'				Case 1
'					ContBody.Cont0.RadioQrg1.SetRadioCaption(nItemNo-1, szQuestion)
				Case 1, 2, 3 , 4
					Form.SetCtlProp("ContBody.Cont0.lbl"& tostring(nQNum) & tLabelID(nItemNo-1), "caption", szQuestion)
				Case 5
					ContBody.Cont0.RadioQrg5.SetRadioCaption(nItemNo-1, szQuestion)
				Case 6 
					ContBody.Cont0.RadioQrg6.SetRadioCaption(nItemNo-1, szQuestion)
			End Select
		end if
	Next
End Function
'============================================================================
'f_RegistSurvey(): 설문답변 등록
'============================================================================
Function f_RegistSurvey(szTranID)	
	Dim nBtnNum		'라디오 버든 수
	Dim nCurIdx		'선택된 인덱스
	Dim szQContent	'설문문항내용(lbl)
	Dim szRdoYN		'선택여부

	Dim nDataIdx
	nDataIdx = 0
	
	For i = 1 to 6
		Dim tRdoNumber
		tRdoNumber = Array("4", "4", "3", "5", "5", "2")
		nBtnNum = tonumber(tRdoNumber(i-1))
		For j = 0 to nBtnNum
			
			'설문문항내용 가져오기
			if j == 0 then
				szQContent = Form.GetCtlProp( "ContBody.Cont0.LabelQ" & i, "caption")
			else
				Select Case nQNum
					Case 1
						szQContent = ContBody.Cont0.RadioQrg1.GetRadioCaption( j - 1 )
					Case 2, 3 , 4
						Dim tLabelID
						tLabelID = Array("a", "b", "c","d", "e")	
						szQContent = Form.GetCtlProp( "ContBody.Cont0.lbl" & tostring(i) & tostring(tLabelID(j-1)), "caption")
					Case 5
						szQContent = ContBody.Cont0.RadioQrg5.GetRadioCaption( j - 1 )
					Case 6 
						szQContent = ContBody.Cont0.RadioQrg6.GetRadioCaption( j - 1 )
				End Select
			end if
			
			'선택여부 가져오기
			nCurIdx = tonumber(Form.GetCtlProp( "ContBody.Cont0.RadioQrg" & i, "currentindex" ))
			
			if nCurIdx + 1 == j then
				szRdoYN = "Y"
			else
				szRdoYN = "N"
			end if

			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "QUES_QSIT_NO" , nDataIdx , i )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "ITEM_NO_VAL" , nDataIdx , j )
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "RSPN_SLCT_YN" , nDataIdx, szRdoYN )
			nDataIdx = nDataIdx + 1
		Next
	Next
End Function
'============================================================================
'f_ChkAnswer: 설문응답 체크
'============================================================================
Function f_ChkAnswer()
	For i = 1 to 6
		Dim szCurIdx
		szCurIdx = tostring(Form.GetCtlProp( "ContBody.Cont0.RadioQrg" & i, "currentindex" ))
		if szCurIdx == "-1" then
			Form.ShowAlert( "알림" , i & "번 문항에 답을 하지 않았습니다." )
			return False
		end if
	Next
	
	return True
End Function
'============================================================================
'f_SetPFIN: 고객유형 체크
'============================================================================
Function f_SetPFIN(szPRSN_PFIN_CODE)
	if szPRSN_PFIN_CODE == "1" then
		ContBody.Cont0.RadioQrg1.currentindex = 1
	end if
End Function
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
'Form_OnFormInit()  
'============================================================================
Sub Form_OnFormInit()    
	g_szRet = "CANCEL"
	ContBody.Cont0.SetScrollAutoSize()
	
	Dim szData
	szData = Form.GetOpenLinkData()
	
	g_szACNO = getListItem(szData, 0)	
	g_szASNO = getListItem(szData, 1)	
	
	Dim szCusType
	szCusType = CInt(Form.GetSharedData( "obcsb_acif_831r_CUST_TYPE", true ))
	ContBody.Cont0.RadioQrg1.currentindex = szCusType-1
	
	DATAMANAGER.RequestTranData( "obcsb_acif_831r" )
End Sub
'============================================================================
'Form_OnPopupReturn()
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "close_mbfnp51010_p13" then
		if sRet == "OK" then
			g_szRet = "OK"
		else
			g_szRet = "CANCEL"
		end if
		
		Form.CloseForm()
	end if
End Sub
'============================================================================
'Form_OnFormClose()
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("close_mbfnp51010_p12" , g_szRet)
End Sub
'============================================================================
'닫기 Form_OnFormBackKeyPressed()  
'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
	Form.CloseForm()
End Sub

'============================================================================
' ImgBg_OnClick() : 화면 닫기
'============================================================================
Sub ImgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' ContBody_ImgClose_OnClick() : 화면 닫기
'============================================================================
Sub ContBody_ImgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' BtnCancel_OnClick() : 화면 닫기
'============================================================================
Sub BtnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' ButtonOK_OnClick() : 목표시장 비교 선택
'============================================================================
Sub ButtonOK_OnClick()
	if f_ChkAnswer() == true then
		DATAMANAGER.RequestTranData( "obcsb_acif_832a" )
	end if
End Sub

'****************************************************************************
'           				D A T A M A N A G E R        	
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore()
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szHgdtType, szIscd, szIsnm, szSaleCls, szInfoCls
	
	szHgdtType		= Form.GetSharedData("obcsb_acif_831r_HGDT_TYPE", false)
	szIscd			= Form.GetSharedData("obcsb_acif_831r_ISCD", false)
	szIsnm			= Form.GetSharedData("obcsb_acif_831r_ISNM", false)
	szSaleCls		= Form.GetSharedData("obcsb_acif_831r_SALE_CLS_CODE", false)
		szInfoCls		= Form.GetSharedData("obcsb_acif_831r_INFO_CLS_CODE", false)
	
	if szTranID == "obcsb_acif_831r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "HGDT_PROD_TYPE_CODE" , 0 , szHgdtType )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" , 0 , szIscd )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "GOAL_MRKT_SALE_CLS_CODE" , 0 , szSaleCls )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "GOAL_MRKT_INFO_CLS_CODE" , 0 , szInfoCls )
	
	elseif szTranID == "obcsb_acif_832a" then
		Dim szToday, szIsnm
			
		szToday 		= Trim(Form.GetSharedData( "&HOST_DATE" , false ))
		szIsnm 		= Trim(Form.GetSharedData( "FNDNAME_51010" , false ))
		
		'기본정보(OutBlock1) 추가 설정 ----------------------------------------------------		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4" ) '접촉구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_DATE" , 0 , szToday ) '처리일자
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , g_szACNO ) '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 ,  g_szASNO) '계좌일련번호
		
		if tonumber(ContBody.Cont0.RadioQrg1.currentindex) <> 1 then  '전문투자자가 아닌 일반
			Dim szClsCode, szStaDate, szFinDate
			
			szClsCode = Form.GetSharedData("obcsb_acif_721r_CLS_CODE" , true)
			szStaDate = Form.GetSharedData("obcsb_acif_721r_STA_DATE" , true)
			szFinDate = Form.GetSharedData("obcsb_acif_721r_FIN_DATE" , true)
			
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PFIN_CLS_CODE" , 0 , szClsCode ) '전문투자자구분코드 
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PFIN_VLDT_STA_DATE" , 0 , szStaDate ) '전문투자자효력시작일자
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PFIN_VLDT_FID_DATE" , 0 , szFinDate ) '전문투자자효력종료일자
		end if
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "HGDT_PROD_TYPE_CODE" , 0 , szHgdtType ) '고난도상품유형코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" , 0 , szIscd )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISNM" , 0 , szIsnm )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "GOAL_MRKT_SALE_CLS_CODE" , 0 , szSaleCls )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "GOAL_MRKT_INFO_CLS_CODE" , 0 , szInfoCls )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "UI_SPLM_YN" , 0 , "L" ) 'L.(연속일경우)마지막/처음이자마지막
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "GOAL_MRKT_REG_SRNO" , 0 , "0" ) '목표시장등록일련번호
		
		f_RegistSurvey(szTranID)
	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete()
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acif_831r" then
		Dim szISCD, szItem
		szISCD = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ISCD", 0 )
		szItem = Form.GetMetaData( "상품코드", szISCD )

		ContBody.lblItem.caption = "고난도 집합투자증권"
		
		f_SetSurvey(szTranID)
		
	elseif szTranID == "obcsb_acif_832a" then
		Dim szUnfitYN
		szUnfitYN = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "GOAL_MRKT_UNFIT_YN", 0 ) '목표시장부적합여부
		
		Form.OpenPopup("mbfnp51010_p13" , szUnfitYN , "")
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError()
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubMsg == NULL or szSubMsg == "" then
		Form.ShowAlert( "알림", szErrMsg )
	else
		Form.ShowAlert( "알림", szErrMsg.. "("..szSubMsg..")" )
	end if
End Sub


