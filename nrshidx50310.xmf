<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="50310" scrname="ETF매거진_본문팝업" version="2" writer="함원규" />
	<FORM_INFO name="Form" ly_vert="0,0,375,755,1" />
	<CONTROL_INFO>
		<WEBVIEW name="WebView0" urlpath="about:blank" ly_vert="0,47,375,708,1" />
		<IMAGE name="imgBack" autosize="1" imgpath="icon_main_01" ly_vert="6,11,40,24,1" />
		<LABEL name="lblTitle0" fontsize="4" caption="ETF 매거진" bgcolor="064:239059036" ly_vert="40,12,195,23,1" />
		<IMAGE name="imgShare" autosize="1" imgpath="icon_sharenew" ly_vert="335,13,20,20,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="4793" _ulen="4619" >

Dim g_szUrl

'============================================================================
Sub Form_OnFormInitBefore()
	imgBack.setMaintainingRatio("2")
	imgShare.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	WebView0.RemoveCache()
	
	szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
	if szDeviceOS == "1" then
		WebView0.SetUserAgent("meritz_android")
		'웹뷰 확대기능 off
		WebView0.fitresize = "0"
	elseif szDeviceOS == "2" then
		WebView0.SetUseJavaScript("1")
		WebView0.SetUserAgent("meritz_ios")
	end if
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		g_szUrl = szOpenData
		WebView0.urlpath = szOpenData
	end if
End Sub

'============================================================================
Sub imgBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "WebViewReturn" and sParam <> "" and sParam <> null then
		Dim tData
		tData = split(sParam, "★")
		if tData(0) == "ETF" then
			'tData(1)1:ETF스크리너 화면이동, 3:공유하기, 4:뒤로가기, 2:종목연동(해외 또는 국내)
			if tData(1) == "1" then
				'화면이동시 Url 저장
				Form.SetSharedData("50300_SELECT_URL", g_szUrl)
				
				Form.OpenScreen("50100", "")
				
			elseif tData(1) == "2" then
				Dim tTemp
				tTemp = split(tData(3), "@")
				if #tTemp > 1 then
					Dim szItemCd, szItemNm, szMktCd
					
					szItemCd = tTemp(1)
					szMktCd = tTemp(0)
					szItemNm = Form.getItemCodeInfo(tData(3), "name")
					
					'화면이동시 Url 저장
					Form.SetSharedData("50300_SELECT_URL", g_szUrl)
					
					Select Case szMktCd
						Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
							Form.SetSharedData( "&ITEM_CODE" , szMktCd .. "@" .. szItemCd )
							Form.SetSharedData( "&ITEM_KORNAME" , szItemNm )
							Form.SetSharedData( "&ITEM_OVERSTOCK", szMktCd .. "@" .. szItemCd.."★"..szItemNm.."★".."", "" )					
							Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szMktCd .. "@" .. szItemCd.."★"..szItemNm.."★".."", "" )
							
							'해외 현재가
							etfYN = Form.GetItemCodeInfo(szMktCd.."@"..szItemCd, "etfyn")
							if etfYN == "Y" then
								Form.OpenScreen("16000" , szMktCd.."@"..szItemCd.."★".."ETF".."★".."0")
							else
								Form.OpenScreen("16000" , "")
							end if
						
						Case Else
							
							'국내 현재가
							etfYN = Form.GetItemCodeInfo(szItemCd, "etfyn")
							if etfYN == "Y" then
								Form.OpenScreen("11000", szItemCd.."★".."ETF".."★".."0")
							else
								Form.OpenScreen("11000", szItemCd)
							end if	
							
					End Select
				else
					
					'화면이동시 Url 저장
					Form.SetSharedData("50300_SELECT_URL", g_szUrl)
					
					etfYN = Form.GetItemCodeInfo(tData(3), "etfyn")
					if etfYN == "Y" then
						Form.OpenScreen("11000", tData(3).."★".."ETF".."★".."0")
					else
						Form.OpenScreen("11000", tData(3))
					end if
					
				end if
				
			elseif tData(1) == "3" then
				Dim szUrl
				szUrl = tData(3)
				if szUrl <> "" and szUrl <> null then
					Form.shareSNS(szURL)
				end if
				
			elseif tData(1) == "4" then
				if tData(2) == "ClosePopup" then
					Form.CloseForm()
				end if
			end if
		end if 
	end if
End Sub

'============================================================================
' Change_ItemCode
'============================================================================
Function Change_ItemCode(szCode)
	Dim szMk
	szMk = Form.GetItemCodeInfo(szCode, "market")

	if Left(szCode, 1) = "J" or Left(szCode, 1) = "F" then
		return szCode
	elseif szMk = "J" or szMk = "T" then	'주식
		return "A" & szCode
	elseif szMk = "W" then	'ELW
		return "J" & szCode
	else
		return szCode
	end if 
End Function

'============================================================================
' 해외주식 거래소 가공함수
'============================================================================
Function Transform_Exid2(sValue)
	if sValue = "HK" then
		Transform_Exid2 = "HKS"
	elseif sValue = "SH" then
		Transform_Exid2 = "SHS"
	elseif sValue = "SZ" then
		Transform_Exid2 = "SZS"
	elseif sValue = "NY" then
		Transform_Exid2 = "NYS"
	elseif sValue = "AX" then
		Transform_Exid2 = "AMX"
	elseif sValue = "OQ" then
		Transform_Exid2 = "NAS"
	elseif sValue = "JP" then
		Transform_Exid2 = "TSE"
	else
		Transform_Exid2 = sValue
	end if
	
	return Transform_Exid2
End Function

'============================================================================
Sub imgShare_OnClick()
	Form.shareSNS(g_szURL)
End Sub

