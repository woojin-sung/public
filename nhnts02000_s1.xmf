'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = edtQty.caption
	
	szUnit = Cdbl(Table0.GetCellString(0, 1))

	
	if Trim(szQty) == "" then
		szQty = szUnit
	else
		if nGbn == 0 then
			szQty = CDbl(szQty) + szUnit
		elseif nGbn == 1 then
			if CDbl(szQty) == 0 then
				Exit Function
			else
				szQty = CDbl(szQty) - szUnit
				if szQty < 0 then
					szQty = 0
				end if
			end if
		end if
	end if
	
	edtQty.caption = szQty
	edtQty_OnEditComplete()
End Function
