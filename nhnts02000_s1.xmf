'20200310 LES START 홍콩 ETF종목 호가단위 변경 : type = 5 (ETF종목) 추가

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

' ----- 주문설정값 공통변수 Start -------------------------------------------
'주문 환경
Dim g_szOdrPop

' 가격, 수량 설정
Dim g_szAfterInit
Dim g_szChangeInit
Dim g_szBuyQty, g_szBuyQtyCnt '20210610 SWJ START

' 주문후 
Dim g_szAfterOrg

' ----- 주문설정값 공통변수 End ---------------------------------------------

Dim g_szCd, g_szMk, g_szNg	' 종목코드, 거래소코드, 국가코드
g_szCd = ""
g_szMk = ""
g_szNg = ""

' 20201019 SWJ START : 해외주식 고유 주문착오 방지
Dim	g_szWarnFlag				' 주문 경고 확인플래그
g_szWarnFlag	= "N"
' 20201019 SWJ END

Dim g_szTR

Dim g_szTitle
g_szTitle = "알림"

' 20171204 HAMWG START : 해외주식_공유변수 선언
Dim g_szOrdSize		' 매매단위
g_szOrdSize = ""

Dim g_szLast			' 현재가
g_szLast = ""

Dim g_szUpLimit		' 상한가
g_szUpLimit	=  ""

Dim g_szDnLimit		' 하한가
g_szDnLimit	=  ""

Dim g_szUnit			' 호가단위
g_szUnit		=  ""

Dim g_szDecimal		' 종목가격 자릿수
g_szDecimal	=  ""

Dim g_szKorName		' 한글종목명
g_szKorName	=  ""

Dim g_szTickType		' 종목틱타입
g_szTickType	=  ""
' 20171204 HAMWG END

Dim g_szBuyPrc	'20200331 HWG : 고유MTS

'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************

'============================================================================
' Init_AfterOrder : 주문후 초기화
'============================================================================
Function	Init_InputControl()
	edtQty.caption = ""
	edtQty_OnEditComplete()
	
	edtPrc.caption = ""
	edtPrc_OnEditComplete()
End Function

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력
	
	'20210610 SWJ START : 해외주식 시세 자체구축 프로젝트
	g_szBuyQty     = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYQTY")		' 매수수량 자동입력(0:미사용, 1:현금가능수량, 2:최대가능수량(미수포함), 3:수량입력
	g_szBuyQtyCnt  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYQTYCNT")	' 매수수량 주수(수량입력 선택시)
	'20210610 SWJ END
	
	'20200331 HWG START : 고유MTS
	g_szBuyPrc  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYPRC")		' 주식매수주문가격 자동입력
	
	' 주식매수주문가격 자동입력(기본값 : 미사용, 11:현재가)
	if Trim(g_szBuyPrc) = "" then
		g_szBuyPrc = "0"
	end if
	'20200331 HWG END
	
	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170919 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170919 HAMWG END

	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	'20210610 SWJ START
	' 매수수량 자동입력(기본값 : 사용하지 않음)
	if Trim(g_szBuyQty) = "" then
		g_szBuyQty = "0"		
	end if
	'20210610 SWJ END
End Function

'============================================================================
' Check_InputData
'============================================================================
Function Check_InputData(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Check_FundCd(nGbn) == false then	'20200331 HWG : 고유MTS
		return false
	end if

	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if
	
	if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
		Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
		return false
	end if
	
	if nGbn == 0 then
		if Trim(edtPrc.caption) == "" or Trim(edtPrc.caption) == "0" then
			Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
			return false
		end if	
	end if	
		
	if nGbn <> 2 then	
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup()
		else
			Request_Order()
		end if
	end if
	
	return true
End Function

'============================================================================
' Open_ConfirmPopup
'============================================================================
Function Open_ConfirmPopup(szWarn)
	Dim szData
	sCodeData = Split(g_szCd, "@")
	szData = "0"													' 매매구분
	'20200331 HWG START : 고유MTS
	szData = szData & "|" & Form.GetTopCtlProp("edtFundCd", "caption")	' 펀드코드
	szData = szData & "|" & Form.GetTopCtlProp("lblFundNm", "caption")	' 펀드명
	'20200331 HWG END
	szData = szData & "|" & sCodeData[1]								' 종목코드
	szData = szData & "|" & g_szKorName								' 종목명
	szData = szData & "|" & "지정가"								' 주문구분
	szData = szData & "|" & "0"										' 현금
	szData = szData & "|" & edtQty.caption							' 주문수량
	szData = szData & "|" & edtPrc.caption							' 주문가격
	szData = szData & "|" & ""										' 원주문번호
	szData = szData & "|" & ""										' 전량전부
	szData = szData & "|" & g_szDecimal								' 가격자릿수
	
	' 20201019 SWJ START : 해외주식 고유 주문착오 방지
	if Trim(szWarn) <> "" then		' 경고팝업 오픈
		szData = szData & "|" & szWarn		' 경고메세지		
		Form.OpenPopup("mhtro16060_p7", szData , "")		
	else							' 주문확인팝업 오픈
		Form.OpenPopup("nhnts02000_p1", szData , "") 	'20200331 HWG : 고유MTS
	end if
	' 20201019 SWJ END

End Function

'============================================================================
' Request_Order
'============================================================================
Function Request_Order()
	g_szWarnFlag	= "N"	' 20201019 SWJ : 해외주식 고유 주문착오 방지
	DATAMANAGER.RequestTranData("obtro_oder_501a")	'20200331 HWG : 고유MTS
End Function

