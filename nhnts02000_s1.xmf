'20200331 HWG START : 고유MTS
'============================================================================
' Check_FundCode	
'============================================================================
Function Check_FundCd(nGbn)
	Dim szFundCd, szPwd
	
	'메인화면 계좌번호
	szFundCd = Form.GetTopCtlProp("edtFundCd", "caption") 
	
	If Len(szFundCd) < 4 Then
		Form.ShowAlert(g_szTitle, "펀드코드를 확인후 다시 입력하십시오.")
		return False
	End If
	
	if nGbn <> 2 then
		'메인화면 비밀번호
		szPwd = Form.GetTopCtlProp("edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function
'20200331 HWG END

'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn)
	
	szPrc  = ReSet_Prc(edtPrc.caption, nGbn)
	szHigh = g_szUpLimit	
	szLow  = g_szDnLimit

	GetHogaUnit(g_szMk, szPrc, nGbn) '20180710 HAMWG : 호가단위 설정함수 변경
	szUnit = g_szUnit
	
	
	if Trim(szPrc) == "" or CDbl(szPrc) == 0 then
		if g_szLast == "" or CDbl(g_szLast) == 0 then
			szPrc = 0
		else
			szPrc = g_szLast
		end if
	else
		' + 버튼 클릭 /////////////////////////////
		if nGbn == 0 then							
			if CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then				'20210610 SWJ START : 빈값에서 0으로 변경
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if 
			elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀
				if szLow <> "0" then				'20210610 SWJ START : 빈값에서 0으로 변경
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if 
			else
				szPrc = CDbl(szPrc) + CDbl(szUnit)
			end if
			
		' - 버튼 클릭 ////////////////////////////
		elseif nGbn == 1 then						
			if CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then				'20210610 SWJ START : 빈값에서 0으로 변경
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if 		
			elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
				if szLow <> "0" then				'20210610 SWJ START : 빈값에서 0으로 변경
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if 
			else
				szPrc = CDbl(szPrc) - CDbl(szUnit)
			end if
		end if
	end if
	
	if CDbl(szPrc) < 0 then
		szPrc = 0
	end if
	
	edtPrc.caption = szPrc
	edtPrc_OnEditComplete()
End Function

'20180710 HAMWG START : 호가단위 설정함수 변경
'============================================================================
' 거래소 호가단위 설정
'============================================================================
Function GetHogaUnit(szMk, szPrc, nGbn) 
	szOrdPrc = CDbl(szPrc)
	
	if szOrdPrc == "" then
		if g_szLast = "" or CDbl(g_szLast) == 0 then
			szOrdPrc = 0		
		else
			szOrdPrc = CDbl(g_szLast)
		end if	
	end if
	
	szUnit = "1.000"
	
	'20200310 LES START 홍콩 ETF종목 호가단위 변경
	szTtype = Cint(g_szTickType)
	
	if szTtype == 0 or szTtype == "" then
		szTtype = "0"
	end if
	
	if szMk == "0215" then '상해
		szUnit = "0.010"
		
	elseif szMk == "0214" then '심천
		szUnit = "0.010"
		
	elseif szMk == "0321" or szMk == "0537" or szMk == "0066" then '뉴욕, 나스닥, 아멕스
		if szTtype == 1 then
			szUnit = "0.010"
			
		elseif szTtype == 2 then
			szUnit = "0.050"
			
		elseif szTtype == 3 then
			szUnit = "0.050"
			
		elseif szTtype == 4 then
			szUnit = "0.050"
			
		else
			szUnit = "0.010"
			
		end if
		
	elseif szMk == "0104" then '홍콩
		
		if szTtype == 3 then
			szUnit = "0.050"
			
		'20200310 LES START 홍콩 ETF종목 호가단위 변경
		'type = 5 (ETF종목) 추가
		elseif szTtype == 5 then
			
			if nGbn == 0 then
				if szOrdPrc < 1.00 then
					szUnit = "0.001"
				elseif szOrdPrc < 5.00 then
					szUnit = "0.002"
				elseif szOrdPrc < 10.00 then
					szUnit = "0.005"
				elseif szOrdPrc < 20.00 then
					szUnit = "0.010"
				elseif szOrdPrc < 100.00 then
					szUnit = "0.020"
				elseif szOrdPrc < 200.00 then
					szUnit = "0.050"
				elseif szOrdPrc < 500.00 then
					szUnit = "0.100"
				elseif szOrdPrc < 1000.00 then
					szUnit = "0.200"
				elseif szOrdPrc < 2000.00 then
					szUnit = "0.500"
				else
					szUnit = "1.000"
				end if
			
			else
				if szOrdPrc <= 1.00 then
					szUnit = "0.001"
				elseif szOrdPrc <= 5.00 then
					szUnit = "0.002"
				elseif szOrdPrc <= 10.00 then
					szUnit = "0.005"
				elseif szOrdPrc <= 20.00 then
					szUnit = "0.010"
				elseif szOrdPrc <= 100.00 then
					szUnit = "0.020"
				elseif szOrdPrc <= 200.00 then
					szUnit = "0.050"
				elseif szOrdPrc <= 500.00 then
					szUnit = "0.100"
				elseif szOrdPrc <= 1000.00 then
					szUnit = "0.200"
				elseif szOrdPrc <= 2000.00 then
					szUnit = "0.500"
				else
					szUnit = "1.000"
				end if
			
			end if
		
		'20200310 LES END
		
		else
			if nGbn == 0 then
				if szOrdPrc < 0.25 then
					szUnit = "0.001"
		
				elseif szOrdPrc < 0.50 then
					szUnit = "0.005"
		
				elseif szOrdPrc < 10.00 then
					szUnit = "0.010"
		
				elseif szOrdPrc < 20.00 then	
					szUnit = "0.020"
		
				elseif szOrdPrc < 100.00 then
