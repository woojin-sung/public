	<SCRIPT_INFO _len="3985" _ulen="3589" >
''-------------------------------------------------------------------------------------------
'' 01. 화 면 명 : ELS/DLS 자가진단 문제풀이
'' 02. 화면설명 : 
'' 03. 작    성 : 2017.03.22 신재영
''-------------------------------------------------------------------------------------------
'
Dim g_sRetData 
' 계좌번호★계좌일련번호★종목코드★파생경험여부★자가진단표수행여부
Dim	g_szAcno		   	'계좌번호
Dim	g_szAsno		   	'계좌일련번호
Dim	g_szIscd		   	'종목코드
Dim	g_szDrvtExpcYn	'파생경험여부
Dim g_szSfdiProsYn	'자가진단표수행여부
Dim g_szJoinAbleYn
'============================================================================
Sub Form_OnFormInit()
	g_sRetData = "CANCEL"

	Dim szLinkedData
	
	Form.SetScreenName( "ELS/DLS 청약신청 자가진단표 해설전문 확인" )		
	szLinkedData = Form.GetOpenLinkData( )
	
	g_szAcno			= getListItem(szLinkedData,0)
	g_szAsno			= getListItem(szLinkedData,1)
	g_szIscd			= getListItem(szLinkedData,2)
	g_szDrvtExpcYn	= getListItem(szLinkedData,3)
	g_szSfdiProsYn	= getListItem(szLinkedData,4)
	
	if g_szSfdiProsYn == "Y" then
		g_szSfdiProsYn = "Y"
	else
		g_szSfdiProsYn = "N"
	end if

End Sub	


'============================================================================
Sub Button0_OnClick()

	g_szExnTlmsCnfrYn = "Y"
	
	DATAMANAGER.RequestTranData("obcsb_acif_760a") ' 자가진단시행이력 등록
	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if	szTranID	=	"obcsb_acif_760a"	then 'v003 자가진단수행내역 등록
		DATAMANAGER.SetDataValue(0, "obcsb_acif_760a", "InBlock1", "ACNO"						, 0, g_szAcno			) '계좌번호
		DATAMANAGER.SetDataValue(0, "obcsb_acif_760a", "InBlock1", "ASNO"						, 0, g_szAcno			) '계좌일련번호
		DATAMANAGER.SetDataValue(0, "obcsb_acif_760a", "InBlock1", "ISSU_TYPE_CODE"				, 0, "08"			) '종목유형코드
		DATAMANAGER.SetDataValue(0, "obcsb_acif_760a", "InBlock1", "ISCD"						, 0, g_szIscd			) '종목코드
		DATAMANAGER.SetDataValue(0, "obcsb_acif_760a", "InBlock1", "DRVT_CMBN_SCRT_INVT_EXPC_YN"	, 0, g_szDrvtExpcYn	) '파생결합증권투자경험여부
		DATAMANAGER.SetDataValue(0, "obcsb_acif_760a", "InBlock1", "SFDI_ACMP_YN"				, 0, g_szSfdiProsYn	) '자가진단수행여부
		DATAMANAGER.SetDataValue(0, "obcsb_acif_760a", "InBlock1", "EXN_TLMS_CNFR_YN"				, 0, g_szExnTlmsCnfrYn	) '해설전문확인여부	
	end	if
	
End Sub

'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList

	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 

end function

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if	szTranID	=	"obcsb_acif_760a"	then 'v003 자가진단수행내역 등록
		g_szJoinAbleYn = DATAMANAGER.GetDataValue(0, "obcsb_acif_760a" , "OutBlock1" , "JOIN_ABLE_YN" , 0)
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if	szTranID	=	"obcsb_acif_760a"	then 'v003 자가진단수행내역 등록
		msgbox szErrMsg
	end if	
End Sub


'============================================================================
Sub Form_OnFormClose()
	if trim(g_szJoinAbleYn) == "Y" then
		g_sRetData = "OK"
	elseif trim(g_szJoinAbleYn) == "N" then
		g_sRetData = "CANCEL"
	end if

	if	g_sRetData		<>	"OK"		then
		g_sRetData	=	"CANCEL"
		
		Form.SendReturnToParent("mbonl81010_p7" , g_sRetData)
	else
		Form.SendReturnToParent("mbonl81010_p7" , g_sRetData)
	end if
End Sub

	</SCRIPT_INFO>
