Sub contFilter_btnSearch_OnClick()
	Dim szData
	
	for i=0 to g_iGroupCount - 1
		if g_sGroup[i] == "" or g_sGroup[i] == null then
			f_editGroupValue(i+1, "99")
		end if
	next
		
	szData = g_CurGroup.."★"..g_sGroup[0].."★"..g_sGroup[1].."★"..g_sGroup[2].."★"..g_sGroup[3]
	
	contfilter.visible = False
	imgDim0.visible = False
	imgDim1.visible = False
	
'	Form.ShowAlert("contFilter_btnSearch_OnClick", szData)
	Form_OnPopupReturn("FILTER_Q" , szData)	
End Sub

