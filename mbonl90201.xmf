'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "QUICK_LINK" then
		'Home 화면에서 맞춤형Bond365 선택했을 경우
		g_szFilter1 = sParam
		
		f_getFilterCondition()		
		f_setFilterCtrl()
		
		if f_setState() then
			cont1.contMain.gridData.rowcount = 0
			DATAMANAGER.RequestTranData( "obsab_deal_604r")
		end if		
		
	end if
	
End Sub

