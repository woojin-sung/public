'============================================================================
'조건 그룹마다 선택되어 있는 상태를 배열에 설정해준다.
'iGroup : 조건그룹 1부터 시작
Sub f_setItemFlags(iGroup)
	Dim iIndex, iCount
	
	iGroupIndex = iGroup - 1	
	
	if (g_sGroup[iGroupIndex] <> "00") or (g_sGroup[iGroupIndex] <> "99") then
		szData = Split(g_sGroup[iGroupIndex], "|")
		
		iCount = #szData
		
		for i = 0 to iCount - 1
			iIndex = CInt(szData(i))
			
			f_editGroupItemValue(iGroup, iIndex, True)
'			g_bGroup_Item[iGroupIndex][iIndex - 1] = True
		next
									  
'		Form.ShowAlert("f_setItemFlags2", iGroup & "★" & iGroupIndex & "★" &
'									  g_sGroup[iGroupIndex] & "★" & 
'									  g_bGroup_Item[iGroupIndex][0] & " : " &
'									  g_bGroup_Item[iGroupIndex][1] & " : " &
'									  g_bGroup_Item[iGroupIndex][2] & " : " &
'									  g_bGroup_Item[iGroupIndex][3])
	end if	

end Sub

'============================================================================
'버튼들의 상태를 초기화 시킨다.
'iGroup : 필터 그룹 하나만 초기화   9: 전체 초기화
Sub f_setInitCtrls(iGroup)
	Dim iGroupIndex, iIndex
	
'	'초기화
	if CInt(iGroup) == 9 then
		for i=0 to g_iGroupCount - 1
				g_cntGroup[i] = 0 'v0005
				
			for j=0 to g_Max_ItemCount[i]
				Form.SetCtlProp("contFilter.group" & CStr(i+1) & ".Label" & CStr(j), "fgcolor", "146")
				Form.SetCtlProp("contFilter.group" & CStr(i+1) & ".Label" & CStr(j), "fontstyle", "00")
'				Form.SetCtlProp("contFilter.group" & CStr(i+1) & ".Image" & CStr(j), "imgpath", "input_03_n.9.png")
				Form.SetCtlProp("contFilter.group" & CStr(i+1) & ".Image" & CStr(j), "imgpath", "btn_line2_n.9.png")
			next
		next
		
	else
		iGroupIndex = CInt(iGroup) - 1
		g_cntGroup[iGroupIndex] = 0 'v0005
		for i=0 to g_Max_ItemCount[iGroupIndex]
			Form.SetCtlProp("contFilter.group" & CStr(iGroup) & ".Label" & CStr(i), "fgcolor", "146")
			Form.SetCtlProp("contFilter.group" & CStr(iGroup) & ".Label" & CStr(i), "fontstyle", "00")
'			Form.SetCtlProp("contFilter.group" & CStr(iGroup) & ".Image" & CStr(i), "imgpath", "input_03_n.9.png")
			Form.SetCtlProp("contFilter.group" & CStr(iGroup) & ".Image" & CStr(i), "imgpath", "btn_line2_n.9.png")
		next
		
	end if
	
end Sub

'============================================================================
'조건 그룹별로 설정된 값으로 버튼상태를 바꾸어준다.
'배열에 저장된 값으로 버튼값  설정
Sub f_setCtrls(iGroup)
	Dim iGroupIndex
	
	if CInt(iGroup) == 9 then
		
		for i=0 to g_iGroupCount - 1
			Form.SetCtlProp("contFilter.group" & CStr(i+1) & ".Label0", "fgcolor", "334")
			Form.SetCtlProp("contFilter.group" & CStr(i+1) & ".Label0", "fontstyle", "01")
'			Form.SetCtlProp("contFilter.group" & CStr(i+1) & ".Image0", "imgpath", "input_03_o.9.png")
			Form.SetCtlProp("contFilter.group" & CStr(i+1) & ".Image0", "imgpath", "btn_line2_o.9.png")
			
		
			for j=0 to g_Max_ItemCount[i] - 1
				Form.SetCtlProp("contFilter.group" & CStr(i+1) & ".Label" & CStr(j+1), "fgcolor", "146")
				Form.SetCtlProp("contFilter.group" & CStr(i+1) & ".Label" & CStr(j+1), "fontstyle", "00")
'				Form.SetCtlProp("contFilter.group" & CStr(i+1) & ".Image" & CStr(j+1), "imgpath", "input_03_n.9.png")
				Form.SetCtlProp("contFilter.group" & CStr(i+1) & ".Image" & CStr(j+1), "imgpath", "btn_line2_n.9.png")
			next
		next
		
	else			
		iGroupIndex = CInt(iGroup) - 1
		
		if g_sGroup[iGroupIndex] == "00" then
			Form.SetCtlProp("contFilter.group" & CStr(iGroup) & ".Label0", "fgcolor", "334")
			Form.SetCtlProp("contFilter.group" & CStr(iGroup) & ".Label0", "fontstyle", "01")
'			Form.SetCtlProp("contFilter.group" & CStr(iGroup) & ".Image0", "imgpath", "input_03_o.9.png")
			Form.SetCtlProp("contFilter.group" & CStr(iGroup) & ".Image0", "imgpath", "btn_line2_o.9.png")
			
		else		'선택항목 표시
'			Form.ShowAlert("f_setCtrls1", g_bGroup_Item[iGroupIndex][0] & " : " &
'										  g_bGroup_Item[iGroupIndex][1] & " : " &
'										  g_bGroup_Item[iGroupIndex][2] & " : " &
'										  g_bGroup_Item[iGroupIndex][3])
			for i=0 to g_Max_ItemCount[iGroupIndex] - 1
				if g_bGroup_Item[iGroupIndex][i] then
					Form.SetCtlProp("contFilter.group" & CStr(iGroup) & ".Label" & CStr(i+1), "fgcolor", "334")
					Form.SetCtlProp("contFilter.group" & CStr(iGroup) & ".Label" & CStr(i+1), "fontstyle", "01")
'					Form.SetCtlProp("contFilter.group" & CStr(iGroup) & ".Image" & CStr(i+1), "imgpath", "input_03_o.9.png")
					Form.SetCtlProp("contFilter.group" & CStr(iGroup) & ".Image" & CStr(i+1), "imgpath", "btn_line2_o.9.png")
				end if
			next
					
		end if
	end if

end Sub

'============================================================================
Sub f_groupTogle(szGroup, szItem)
'	Form.ShowAlert("groupTogle1", szGroup & ":" & szItem)
	'상세검색 선택값 저장
	
	Dim iGroupIndex, iIndex, iValue
	
	iGroupIndex = CInt(szGroup) - 1	
	g_sGroup[iGroupIndex] = ""
	
	
	if szItem == "00" then   '전체를 선택했을 경우
'		Form.ShowAlert("groupTogle1", szGroup & ":" & iGroupIndex & ":" & szItem)
		if CInt(szGroup) == 9 then
			for i=0 to g_iGroupCount - 1 
				for j=0 to g_Max_ItemCount[i] - 1
					g_bGroup_Item[i][j] = False
				next
				
				g_sGroup[i] = szItem
			next
			
		else
			for i=0 to g_Max_ItemCount[iGroupIndex] - 1
				g_bGroup_Item[iGroupIndex][i] = False
			next
	'		
			g_sGroup[iGroupIndex] = szItem
		end if
		
	else
		'선택한 조건이 선택되어 있는지 값을 가지고 온다.
		iIndex = CInt(szItem) - 1
'			Form.ShowAlert("groupTogle1", iIndex & " : " & g_bGroup1_Item[iIndex] )

'		Form.ShowAlert("groupTogle1", iGroupIndex & ":" & iIndex  & ":" & g_bGroup_Item[iGroupIndex][iIndex])
		g_bGroup_Item[iGroupIndex][iIndex] = not g_bGroup_Item[iGroupIndex][iIndex]
'		Form.ShowAlert("groupTogle4", g_bGroup_Item[iGroupIndex][iIndex])
					
		for i = 0 to g_Max_ItemCount[iGroupIndex] - 1
'			Form.ShowAlert("groupTogle5", i & ":" & g_bGroup_Item[iGroupIndex][i])
			
'			Form.ShowAlert("f_groupTogle2", index .. " : " .. value .. " : " .. g_sGroup[iGroupIndex])
			
			if g_bGroup_Item[iGroupIndex][i] == True then
				if g_sGroup[iGroupIndex] == "" then
					g_sGroup[iGroupIndex] = (i+1)
				else
					g_sGroup[iGroupIndex] = g_sGroup[iGroupIndex] + "|" + (i+1)
				end if
				
				g_cntGroup[iGroupIndex] = g_cntGroup[iGroupIndex] + 1	'v0005
			
			end if
		next
		
		'아무것도 선택 안된 경우는 전체 선택으로 해줌.
		if g_sGroup[iGroupIndex] == "" then
			g_sGroup[iGroupIndex] = "00"
		elseif g_cntGroup[iGroupIndex] == g_Max_ItemCount[iGroupIndex] then' v0005
			g_sGroup[iGroupIndex] = "00"
			f_resetGroupFilter(iGroupIndex)	' v0005
		end if
	end if	
	
	f_setInitCtrls( CInt(szGroup) )
	f_setCtrls( CInt(szGroup) )
	
'	szData = g_CurGroup.."★"..g_sGroup[0].."★"..g_sGroup[1].."★"..g_sGroup[2].."★"..g_sGroup[3]'	
'	Form.ShowAlert("f_groupTogle5", szData)
End Sub



