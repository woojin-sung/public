Sub cont1_contMain_gridData_OnClickUp(lRow, szCellID)
	Dim szTemp1, szData, szQty
	
	if g_CUST_CLS_CODE == "2" then	'2: 법인/1:개인
		Form.MsgBox("알림", "법인은 신청이 불가합니다.", "auth_check", 6)		
		Exit Sub
	end if
	
'	'20240220 수량 SOLD OUT 일시 예외처리 추가
'	szQty = cont1.contMain.gridData.GetCellData("bd_qty", lRow)
'	if trim(szQty) == "SOLD OUT" then
'		Form.ShowAlert("알림", "해당 상품은 SOLD OUT 되었습니다.")
'		exit sub
'	end if
	
	szTemp1 = cont1.contMain.gridData.GetCellData("ISCD",	lRow)
	
'	Form.ShowAlert("gridData_OnClickUp", lRow .. " : " .. szTemp1)
	
	szData = szTemp1				& "|" &		'종목코드
			cmbAccount.total		& "|" &		'계좌번호
			cmbAccount.sequence	& "|" &		'계좌seq
			""					& "|" &		'계좌비번
			g_COMN_PFIN_YN		& "|" &		'전문투자자여부
			g_PFIN_VLDT_EXPR_YN				'전문투자자 만료여부
	
'	Form.ShowAlert("gridData_OnClickUp", lRow .. " : " .. szData)
	
	'장외채권 상세화면 연결
	Form.OpenPopup("mbonl90201_s1", szData , "")
End Sub

'============================================================================
Sub cont1_contCheck_imgFold_OnClick()
	Dim szimgFile

	if g_bFoldState then
		szimgFile = "icon_gray_down.png"
	else
		szimgFile = "icon_gray_up.png"
	end if
	
	g_bFoldState = not g_bFoldState
	cont1.contCheck.imgFold.imgpath = szimgFile
	
	f_ShowInfo(g_bFoldState)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'	Form.ShowAlert("PopupReturn", sKeyName & " : " & sRet)
	
	Dim szData
	
	if sKeyName == "mbonl88060_p11" then
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			g_szQryType = 1
			
			cont1.contMain.gridData.rowcount = 0
			DATAMANAGER.RequestTranData( "obsab_deal_604r" )
		end if
	
	elseif sKeyName == "mbonl90201_s1" then
		'투자성향 미등록인 경우 투자성향 재진단 연결
		if sRet == "MOVE" then
			'투자성향재진단 화면 연결
			Form.OpenScreen("81010", "")
			Form.CloseForm()
		'상세에서 백버튼시 스크롤 유지
		elseif sRet == "STAY" then
			exit sub
		else
			cont1.contMain.gridData.rowcount = 0
			DATAMANAGER.RequestTranData( "obsab_deal_604r" )
		end if
		
	elseif sKeyName == "close" then
		Form.CloseForm()
		
	elseif sKeyName == "MBBDM85143" then
	
	elseif sKeyName == "errMsgBox"  Then 
		if sRet = "Left" then	
			cont0.ChkMine.chksilence = "0"
			cont0.imgMine.imgpath = "checkmenu_n.png"
		
			g_szQryType = "1"	'내성향맞춤해제시			
			cont1.contMain.gridData.rowcount = 0
			DATAMANAGER.RequestTranData( "obsab_deal_604r" )
			
		else'if sRet = "Right" then				
			'투자성향재진단 화면 연결
			Form.OpenScreen("81010", "")
			
		end if
	
	
	' 정렬 방법 선택시
	elseif sKeyName == "SORT_CONDITION" then
		select case  sRet
			case "0"		g_szSortCondition = "11"
			case "1"		g_szSortCondition = "21"		
			case "2"		g_szSortCondition = "31"
			case "3"		g_szSortCondition = "32"
			case "4"		g_szSortCondition = "41"
			case "5"		g_szSortCondition = "42"
		end select
		
		select case  sRet
			case "0"		szData = "수익률 높은 순"
			case "1"		szData = "표면금리 낮은 순"
			case "2"		szData = "투자기간 짧은 순"
			case "3"		szData = "투자기간 긴 순"
			case "4"		szData = "가능 수량 많은 순"
			case "5"		szData = "신용등급 높은 순"
		end select
		cont0.lblSort.caption = szData
		
		if f_setState() then
			cont1.contMain.gridData.rowcount = 0
			DATAMANAGER.RequestTranData( "obsab_deal_604r")
		end if
'		Form.ShowAlert("Popup1", g_szSortCondition)
		
	elseif sKeyName == "FILTER" then
		'조건 설정 했을 경우
		szData = Split(sRet, "★")
		
		g_szFilter1 = szData(0)
		g_szFilter2 = szData(1)
		g_szFilter3 = szData(2)
		g_szFilter4 = szData(3)
		
		f_getFilterCondition()
		f_setFilterCtrl()
				
'		Form.ShowAlert("Return FILTER", g_szFilter1 & ":" & 
'							  g_szFilter2 & ":" & 
'							  g_szFilter3 & ":" & 
'							  g_szFilter4)
							  
		if f_setState() then
			cont1.contMain.gridData.rowcount = 0
			DATAMANAGER.RequestTranData( "obsab_deal_604r")
		end if
							  
	elseif sKeyName == "FILTER_Q" then
		szData = Split(sRet, "★")
		
'		Form.ShowAlert("Return FILTER_Q1", szData(0) & ":" & 
'									  szData(1) & ":" & 
'									  szData(2) & ":" & 
'									  szData(3) & ":" & 
'									  szData(4))
		
		g_szFilter1 = szData(1)
		g_szFilter2 = szData(2)
		g_szFilter3 = szData(3)
		g_szFilter4 = szData(4)
		
'		select case CInt(szData(0))
'			case 1		cont0.ImgFilter1.imgpath = "img_bgcircle_line.9.png" '"filter.sel.9.png"
'			case 2		cont0.ImgFilter2.imgpath = "img_bgcircle_line.9.png"
'			case 3		cont0.ImgFilter3.imgpath = "img_bgcircle_line.9.png"
'			case 4		cont0.ImgFilter4.imgpath = "img_bgcircle_line.9.png"
'		end select		
				
'		Form.ShowAlert("Return FILTER_Q2", g_szFilter1 & ":" & 
'							  g_szFilter2 & ":" & 
'							  g_szFilter3 & ":" & 
'							  g_szFilter4)
							  
		f_getFilterCondition()		
		
		f_setFilterCtrl()
				
		if f_setState() then
			cont1.contMain.gridData.rowcount = 0
			DATAMANAGER.RequestTranData( "obsab_deal_604r")
		end if
	
	elseif sKeyName == "FILTER_Q_CLOSE" then
		f_getFilterCondition()		
		
		f_setFilterCtrl()
				
'		if f_setState() then
'			cont1.contMain.gridData.rowcount = 0
'			DATAMANAGER.RequestTranData( "obsab_deal_604r")
'		end if	
		
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Form.ShowAlert("TranError", szTranID)
	
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , szErrCode .. " : ".. szErrMsg)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
'	Form.ShowAlert("TranBefore", szTranID)
	
	if szTranID = "ohhts_open_001r" then
		szOSType = Form.GetSharedData("&OS_TYPE", false)'1.안드로이드 2.iOS
		if szOSType <> "" then
			szOSType = szOSType + 2
		end if
			
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SORT_CLS" , 0 , szOSType) 'OS_TYPE 3:MTS(안드로이드) 4:MTS(iOS)
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NO"   , 0 , "54130") 	 '메뉴에 등록된 화면번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NAME" , 0 , "채권(장외)") '하드코딩
				
		'v002.fin
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "USER_ID" , 0 , g_szUSERID) '최근 로그인 아이디
	
	elseif szTranID == "obsab_deal_601r" then		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0 , "9")  '9:투자성향 조회
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID" , 0 , g_szUSERID)
		
	'end of if szTranID == "obsab_deal_601r"
	
	elseif szTranID == "obsab_deal_604r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE",	0, g_szQryType)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID",		0, g_szUSERID)
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",			0 , cmbAccount.total)
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO",			0 , cmbAccount.sequence)
		
		'v0002 메모리평문적용여부(0:미적용 / 1:적용)
'		g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
'		if g_plain_rm == "1" then
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , edtPassword.caption)
'		else
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("edtPassword", "encdata"))
'		end if
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "KYC_INVT_INCL_GRAD_CODE" , 0 , g_KYC_INVT_INCL_GRAD_CODE)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ISNM" , 0 , cont0.edtSearch01.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_COND_CODE1" , 0 , g_szSortCondition)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_COND_CODE2" , 0 , g_szFilterCondition[0])
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_COND_CODE3" , 0 , g_szFilterCondition[1])
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_COND_CODE4" , 0 , g_szFilterCondition[2])
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_COND_CODE5" , 0 , g_szFilterCondition[3])

	end if  
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	Form.ShowAlert("TranComplete", szTranID)
	Dim iDataCount
	Dim szValue
	Dim iYear, iDay
	
	if szTranID == "obsab_deal_601r" then
		g_HLDY_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "HLDY_YN" , 0)
		g_DEAL_ABLE_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "DEAL_ABLE_YN" , 0)
		
		g_CUST_CLS_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CUST_CLS_CODE" , 0)
		
		g_COMN_PFIN_YN      = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "COMN_PFIN_YN" , 0)
		g_PFIN_VLDT_EXPR_YN = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "PFIN_VLDT_EXPR_YN" , 0)
		
		g_KYC_INVT_INCL_GRAD_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "KYC_INVT_INCL_GRAD_CODE" , 0)
		g_KYC_INVT_INCL_GRAD_NAME = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "KYC_INVT_INCL_GRAD_NAME" , 0)
		g_IVIC_VLDT_EXPR_YN       = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "IVIC_VLDT_EXPR_YN" , 0)
		g_KYC_INVT_RCMD_CLS_CODE  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "KYC_INVT_RCMD_CLS_CODE" , 0)
					
'			Form.ShowAlert("TranComplete", g_HLDY_YN & " : " &
'									    g_DEAL_ABLE_YN & " : " &
'									    g_COMN_PFIN_YN & " : " &
'									    g_PFIN_VLDT_EXPR_YN & " : " &
'									    g_KYC_INVT_INCL_GRAD_CODE & " : " &
'									    g_KYC_INVT_INCL_GRAD_NAME & " : " &
'									    g_IVIC_VLDT_EXPR_YN & " : " &
'									    g_KYC_INVT_RCMD_CLS_CODE)			
'		
		if g_CUST_CLS_CODE == "2" then	'2: 법인/1:개인
			Form.MsgBox("알림", "법인은 신청이 불가합니다.", "auth_check", 6)		
			Exit Sub
		end if

		if f_setState() then
			cont1.contMain.gridData.rowcount = 0
			DATAMANAGER.RequestTranData( "obsab_deal_604r")
		end if
	
	'end of if szTranID == "obsab_deal_601r"
	
	elseif szTranID == "obsab_deal_604r" then
	
		g_iDataCount = cont1.contMain.gridData.rowcount
		
		g_IQRY_CSNU = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "IQRY_CSNU", 0)	'조회 건수
		
		iDataCount = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")		
'		Form.ShowAlert("TranComplete1", g_iDataCount & ":" & iDataCount)
		
		if CInt(g_iDataCount) == 0 and CInt(iDataCount) == 0 then
'			Form.ShowAlert("TranComplete", g_iDataCount & ":" & iDataCount & ":" & CInt(g_IQRY_CSNU))
			
			cont1.contMain.visible = False			
			cont1.contNoData.visible = True
			
			cont1.contNoData.tblInvestCheck.visible = False			
'			cont1.contNoData.lblInvestCheck.visible = True			
'			cont1.contNoData.lblInvestCheck.caption = "투자성향분석하기 >"
							
			cont1.contNoData.lblReset.visible = True			
							
				
			if CInt(g_IQRY_CSNU) == 0 then
'				Form.ShowAlert("TranComplete2", g_iDataCount & ":" & iDataCount & ":" & CInt(g_IQRY_CSNU))	
				cont1.contNoData.lblReset.caption = "좋은 상품을 준비중이에요.\n조금만 기다려주세요."
				cont1.contNoData.imgReset.visible = False				
				
			'v0005 sta
			elseif g_szFilter1 == "1" and (g_szFilter2 <> "00" and g_szFilter2 <> "99") then
				cont1.contNoData.lblReset.caption = "조회 결과가 없어요.\n조건을 다시 설정해주세요.\n\n(국채의 경우 신용등급이 없어서\n결과값이 없을 수 있어요.)"
				cont1.contNoData.imgReset.top = 200
				cont1.contNoData.imgReset.visible = True					
			'v0005 fin
			
			else
'				Form.ShowAlert("TranComplete3", g_iDataCount & ":" & iDataCount & ":" & CInt(g_IQRY_CSNU))
				cont1.contNoData.lblReset.caption = "조회 결과가 없어요.\n조건을 다시 설정해주세요."
				cont1.contNoData.imgReset.top = 160	'v0005
				cont1.contNoData.imgReset.visible = True
			
			end if
			
			cont1.contNoData.imgBreakTime.visible = False
			cont1.contNoData.tblBreakTime.visible = False
			cont1.contNoData.tblHoliday.visible = False
			
			cont1.height = 384
			cont1.SetScrollAutoSize()

			cont1.contCheck.visible = False
'			cont1.Label999BG.visible = False
'			cont1.Label999.visible = False
		
			Exit Sub
		end if
		
		for i = 0 to iDataCount - 1
			szTemp1  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "USIQ_EXER_PRC", 		i)	'조회용행사가격
			szTemp2  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD", 				i)	'종목코드
			szTemp3  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_PROD_GRAD_CODE", 	i)	'KYC상품등급코드
			szTemp4  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CRDT_GRAD_CODE", 		i)	'신용등급코드
			szTemp5  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BOND_DIV_NAME", 		i)	'채권분류명
			szTemp6  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISNM", 				i)	'종목명
			szTemp7  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BYOV_ERT", 			i)	'매수수익률
			szTemp8  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RMNN_DYNU", 			i)	'잔존일수
			szTemp9  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DEAL_ABLE_QTY", 		i)	'매매가능수량
			szTemp10 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BOND_DIV_CODE", 		i)	'채권분류코드
			szTemp11 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FNCD", 				i)	'펀드코드
			szTemp12 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SEQ_NO", 				i)	'순서번호
			szTemp13 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DEAL_UNPR", 			i)	'매매단가
			szTemp14 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SRFC_INTRT", 			i)	'표면이자율
			
'			szTemp15 = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TR_ABLE_YN", 			i)	'거래가능여부 v0003
				
			cont1.contMain.gridData.AddRow()
			
			'badge_1
			if szTemp3 = "01" then
				cont1.contMain.gridData.SetCellImage("badge_1", g_iDataCount + i, "img_bgsquare_grade_372.png")
				cont1.contMain.gridData.SetCellData("badge_1", g_iDataCount + i, "매우높은위험")
				cont1.contMain.gridData.SetCellFgColor("badge_1", g_iDataCount + i, 273)
			elseif szTemp3 = "02" then
				cont1.contMain.gridData.SetCellImage("badge_1", g_iDataCount + i, "img_bgsquare_grade_373.png")
				cont1.contMain.gridData.SetCellData("badge_1", g_iDataCount + i, "높은위험")
				cont1.contMain.gridData.SetCellFgColor("badge_1", g_iDataCount + i, 144)
			elseif szTemp3 = "03" then
				cont1.contMain.gridData.SetCellImage("badge_1", g_iDataCount + i, "img_bgsquare_grade_374.png")
				cont1.contMain.gridData.SetCellData("badge_1", g_iDataCount + i, "다소높은위험")
				cont1.contMain.gridData.SetCellFgColor("badge_1", g_iDataCount + i, 144)
			elseif szTemp3 = "04" then
				cont1.contMain.gridData.SetCellImage("badge_1", g_iDataCount + i, "img_bgsquare_grade_375.png")
				cont1.contMain.gridData.SetCellData("badge_1", g_iDataCount + i, "보통위험")
				cont1.contMain.gridData.SetCellFgColor("badge_1", g_iDataCount + i, 144)
			elseif szTemp3 = "05" then
				cont1.contMain.gridData.SetCellImage("badge_1", g_iDataCount + i, "img_bgsquare_grade_376.png")
				cont1.contMain.gridData.SetCellData("badge_1", g_iDataCount + i, "낮은위험")
				cont1.contMain.gridData.SetCellFgColor("badge_1", g_iDataCount + i, 144)
			elseif szTemp3 = "06" then
				cont1.contMain.gridData.SetCellImage("badge_1", g_iDataCount + i, "img_bgsquare_grade_377.png")
				cont1.contMain.gridData.SetCellData("badge_1", g_iDataCount + i, "매우낮은위험")
				cont1.contMain.gridData.SetCellFgColor("badge_1", g_iDataCount + i, 273)
			end if
			
			'badge_2
			'20240202 신용등급 없고 상품이 국채 또는 공채인경우 추가 처리
			cont1.contMain.gridData.SetCellImage("badge_2", g_iDataCount + i, "img_bgsquare_grade_316.png")
			if (szTemp4 == "" or szTemp4 == null) and (trim(szTemp5) == "국채" or trim(szTemp5) == "지방채") then
				cont1.contMain.gridData.SetCellData("badge_2", g_iDataCount + i, "국공채")
			else
				cont1.contMain.gridData.SetCellData("badge_2", g_iDataCount + i, szTemp4)
'			cont1.contMain.gridData.SetCellFgColor("badge_2", g_iDataCount + i, 261)	
			end if
					
			'badge_3
'			cont1.contMain.gridData.SetCellImage("badge_3", g_iDataCount + i, "img_bgsquare_grade_366.png")
			cont1.contMain.gridData.SetCellImage("badge_3", g_iDataCount + i, "img_bgsquare_grade_363.png")
			cont1.contMain.gridData.SetCellData("badge_3", g_iDataCount + i, szTemp5)
'			cont1.contMain.gridData.SetCellFgColor("badge_3", g_iDataCount + i, 261)
			
			'고정text
			cont1.contMain.gridData.SetCellData("bd_text1", g_iDataCount + i, "매수금리(연 세전)")
						
			' 종목명
'			cont1.contMain.gridData.SetCellData("bd_name", g_iDataCount + i, Replace(szTemp6, " ", "\n"))
			cont1.contMain.gridData.SetCellData("bd_name", g_iDataCount + i, szTemp6)
			
			'수익률
			cont1.contMain.gridData.SetCellData("bd_rate", g_iDataCount + i, FormatNumber(CDbl(szTemp7), 3))
			
			cont1.contMain.gridData.SetCellData("bd_text2", g_iDataCount + i, "투자기간")
			
			iYear = CInt(CInt(szTemp8) / 365)
			if iYear >= 1 then
				szValue = iYear & "년 " & (CInt(szTemp8) - (iYear * 365)) & "일"
			else
				szValue = CInt(szTemp8) & "일"
			end if 
			
			cont1.contMain.gridData.SetCellData("bd_date", g_iDataCount + i, szValue)
			
			cont1.contMain.gridData.SetCellData("bd_text3", g_iDataCount + i, "가능수량(천)")
			
			'20240220 SOLD OUT 조건 추가
			if (CInt(szTemp9) / 1000) < 1000 then
				cont1.contMain.gridData.SetCellData("bd_qty", g_iDataCount + i, "SOLD OUT")
				cont1.contMain.gridData.SetCellFgColor("bd_qty", g_iDataCount + i, 6)
			else
				cont1.contMain.gridData.SetCellData("bd_qty", g_iDataCount + i, FormatNumber(CInt(szTemp9) / 1000, 0 ))
			end if
						
			
			'2024.04.15 항목(표면금리, 매수단가) 추가
			cont1.contMain.gridData.SetCellData("bd_cell3", g_iDataCount + i, "표면금리")
			cont1.contMain.gridData.SetCellData("bd_cell6", g_iDataCount + i, szTemp14)
			
			cont1.contMain.gridData.SetCellData("bd_cell22", g_iDataCount + i, "매수단가")
			cont1.contMain.gridData.SetCellData("bd_cell26", g_iDataCount + i, Cint(szTemp13))
						
			
			'// OS별로 구분선 보이는 Cell Width가 다름..(bd_cell75, bd_cell23, bd_cell53)
			'// blank 컬럼 추가.. IOS에서 구분선과 가능수량 사이 간격이 너무 붙어서 추가했음...
			if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
'				cont1.contMain.gridData.SetVisibleCol(6, "1")
'				cont1.contMain.gridData.SetVisibleCol(7, "1")
'				cont1.contMain.gridData.SetVisibleCol(8, "0")

				cont1.contMain.gridData.SetCellData("bd_bar1", i, "|")
				cont1.contMain.gridData.SetCellData("bd_bar2", i, "")
			else
'				cont1.contMain.gridData.SetVisibleCol(6, "0")
'				cont1.contMain.gridData.SetVisibleCol(7, "0")
'				cont1.contMain.gridData.SetVisibleCol(8, "1")
				
				cont1.contMain.gridData.SetCellData("bd_bar1", i, "")
				cont1.contMain.gridData.SetCellData("bd_bar2", i, "|")
			end if
			
			'숨김cell
			cont1.contMain.gridData.SetCellData("USIQ_EXER_PRC",		g_iDataCount + i, szTemp1)
			cont1.contMain.gridData.SetCellData("ISCD",				g_iDataCount + i, szTemp2)
			cont1.contMain.gridData.SetCellData("KYC_PROD_GRAD_CODE",	g_iDataCount + i, szTemp3)
			cont1.contMain.gridData.SetCellData("CRDT_GRAD_CODE",		g_iDataCount + i, szTemp4)
			cont1.contMain.gridData.SetCellData("BOND_DIV_CODE",		g_iDataCount + i, szTemp5)
			cont1.contMain.gridData.SetCellData("ISNM",				g_iDataCount + i, szTemp6)
			cont1.contMain.gridData.SetCellData("BYOV_ERT",			g_iDataCount + i, szTemp7)
			cont1.contMain.gridData.SetCellData("RMNN_DYNU",			g_iDataCount + i, szTemp8)
			cont1.contMain.gridData.SetCellData("DEAL_ABLE_QTY",		g_iDataCount + i, szTemp9)
			cont1.contMain.gridData.SetCellData("BOND_DIV_CODE",		g_iDataCount + i, szTemp10)
			cont1.contMain.gridData.SetCellData("FNCD",				g_iDataCount + i, szTemp11)
			cont1.contMain.gridData.SetCellData("SEQ_NO",				g_iDataCount + i, szTemp12)
			cont1.contMain.gridData.SetCellData("DEAL_UNPR",			g_iDataCount + i, szTemp13)
			cont1.contMain.gridData.SetCellData("SRFC_INTRT",			g_iDataCount + i, szTemp14)
'			cont1.contMain.gridData.SetCellData("TR_ABLE_YN",			g_iDataCount + i, szTemp15)	'v0003
						
		next
		
'		if DATAMANAGER.IsMoreNextData(szTranID) == true then
'			DATAMANAGER.RequestNextData(szTranID)
'		
'		else
			cont1.contMain.visible = True
			cont1.contMain.gridData.visible = True
			cont1.contMain.imgBg0.visible = True
			
			cont1.contNoData.visible = False
			
			g_iDataCount = g_iDataCount + iDataCount
			
'			cont1.contMain.gridData.OnSortingByScript("TR_ABLE_YN", 0 , 1)	'v0003
			
			cont1.contMain.gridData.rowcount = g_iDataCount
'			cont1.contMain.gridData.height = (g_BlockHeight * g_iDataCount) + 15 + 10 + 20
'			cont1.contMain.imgBg0.height = (g_BlockHeight * g_iDataCount) + 15 + 10 + 10 + 20
			cont1.contMain.SetScrollAutoSize()
			
'			Form.ShowAlert("TranComplete2", cont1.contMain.visible & " : " & cont1.contNoData.visible)
'			Form.ShowAlert("TranComplete3", cont1.contMain.gridData.rowcount & " : " & g_iDataCount)
		
			'상품목록 있는 경우에만 심의필 노출
			if CInt(g_iDataCount) > 0 then
				cont1.contCheck.visible = True
'				cont1.Label999BG.visible = True
'				cont1.Label999.visible = True
			else
				cont1.contMain.imgBg0.height = 359
				
				cont1.contCheck.visible = False
'				cont1.Label999BG.visible = False
'				cont1.Label999.visible = False
			
			end if
'		end if
	
	'end of if szTranID == "obsab_deal_604r"
	
	end if
	
End Sub


