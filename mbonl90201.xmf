'	end if	
	
	'휴일이나 장마감 후에도 채권내용 보여주도록 수정
	cont1.contMain.visible = True		
	cont1.contNoData.visible = False
	
	result = True
	
	return result
end function	

'============================================================================
'빠른 필터 선택 했을 경우 화면에 필터 선택 표시
Sub f_setDisplayQFilter(iGroup)
	contfilter.visible = True
	imgDim0.visible = True
	imgDim1.visible = True
	
	contFilter.group1.visible = False
	contFilter.group2.visible = False
	contFilter.group3.visible = False
	contFilter.group4.visible = False
	
	select case CInt(iGroup)
		case 1	contFilter.group1.visible = True
		case 2	contFilter.group2.visible = True
		case 3	contFilter.group3.visible = True
		case 4	contFilter.group4.visible = True	
	end select
	
	g_sGroup = {}
	g_sPrevGroup = {}
	
	for i=0 to g_iGroupCount-1
		table.insert(g_sGroup, "00")
		table.insert(g_sPrevGroup, "00")
	next

	g_bGroup_Item = {}
	for i=0 to g_iGroupCount-1
		g_bGroup_Item[i] = {}
		for j=0 to g_Max_ItemCount[i]-1
			g_bGroup_Item[i][j] = False
		next
	next
	
	f_setInitCtrls(9)
	
	szData = g_szFilter1 & "★" & g_szFilter2 & "★" & g_szFilter3 & "★" & g_szFilter4
	
'	Form.ShowAlert("f_setDisplayQFilter", szData)
	
	tData = Split(szData, "★")
	for i=0 to g_iGroupCount-1
		g_sGroup[i] = tData(i)
		g_sPrevGroup[i] = tData(i)
	next
	
	'각 그룹마다 선택된 항목 기억
	f_setItemFlags(1)
	f_setItemFlags(2)
	f_setItemFlags(3)
	f_setItemFlags(4)
	
	
	'각 그룹마다 선택된 항목 표시
	f_setCtrls(1)
	f_setCtrls(2)
	f_setCtrls(3)
	f_setCtrls(4)

end sub

'============================================================================
'현재 적용된 필터값을 배열로 가져옴.
Sub f_getFilterCondition()
'	Form.ShowAlert("f_getFilterCondition", "f_getFilterCondition")
	Dim szDataList, iSum
	
	g_szFilterCondition = {}
	
	'채권구분 필터
	if (g_szFilter1 == "00") or (g_szFilter1 == "99") then
		table.insert(g_szFilterCondition, g_szFilter1)
	else			
		szDataList = Split(g_szFilter1, "|")
		
		iSum = 0
		for i = 0 to UBound(szDataList)
			select case szDataList(i)
				case "1"		iSum = iSum + 1
				case "2"		iSum = iSum + 2
				case "3"		iSum = iSum + 4
				case "4"		iSum = iSum + 8
			end select
		next
		
		if iSum >= 10 then
			table.insert(g_szFilterCondition, CStr(iSum))
		else
			table.insert(g_szFilterCondition, "0"..CStr(iSum))
		end if
		
	end if
	
	'신용등급 필터
	if (g_szFilter2 == "00") or (g_szFilter2 == "99") then
		table.insert(g_szFilterCondition, g_szFilter2)
	else
		szDataList = Split(g_szFilter2, "|")
		
		iSum = 0
		for i = 0 to UBound(szDataList)
			select case szDataList(i)
				case "1"		iSum = iSum + 1
				case "2"		iSum = iSum + 2
				case "3"		iSum = iSum + 4
				case "4"		iSum = iSum + 8
			end select
		next
		
		if iSum >= 10 then
			table.insert(g_szFilterCondition, CStr(iSum))
		else
			table.insert(g_szFilterCondition, "0"..CStr(iSum))
		end if
	end if
	
	'잔존만기 필터
	if (g_szFilter3 == "00") or (g_szFilter3 == "99") then
		table.insert(g_szFilterCondition, g_szFilter3)
	else
		szDataList = Split(g_szFilter3, "|")
		
		iSum = 0
		for i = 0 to UBound(szDataList)
			select case szDataList(i)
				case "1"		iSum = iSum + 1
				case "2"		iSum = iSum + 2
				case "3"		iSum = iSum + 4
				case "4"		iSum = iSum + 8
			end select
		next
		
		if iSum >= 10 then
			table.insert(g_szFilterCondition, CStr(iSum))
		else
			table.insert(g_szFilterCondition, "0"..CStr(iSum))
		end if
	end if
	
	'표면금리 필터
	if (g_szFilter4 == "00") or (g_szFilter4 == "99") then
		table.insert(g_szFilterCondition, g_szFilter4)
	else
		szDataList = Split(g_szFilter4, "|")
		
		iSum = 0
		for i = 0 to UBound(szDataList)
			select case szDataList(i)
				case "1"		iSum = iSum + 1
				case "2"		iSum = iSum + 2
				case "3"		iSum = iSum + 4
				case "4"		iSum = iSum + 8
			end select
		next
		
		if iSum >= 10 then
			table.insert(g_szFilterCondition, CStr(iSum))
		else
			table.insert(g_szFilterCondition, "0"..CStr(iSum))
		end if
	end if
	
'	Form.ShowAlert("f_getFilterCondition", g_szFilterCondition[0] & " : " &
'									  g_szFilterCondition[1] & " : " &
'									  g_szFilterCondition[2] & " : " &
'									  g_szFilterCondition[3])
end sub


