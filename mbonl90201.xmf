'============================================================================
Sub Form_OnFormInit()
	g_szScreenNo = Form.GetSharedData("&SCREEN_NO", False)	'54130
	
	g_COMN_PFIN_YN = "N"
	g_bFoldState = False
	
	g_szFilter1 = "00"
	g_szFilter2 = "00"
	g_szFilter3 = "00"
	g_szFilter4 = "00"
	
	g_szFilterCondition = {"00", "00", "00", "00"}
		
	cont0.ImgFilter1.imgpath = ""  'filter.sel.9.png
	cont0.ImgFilter2.imgpath = ""  
	cont0.ImgFilter3.imgpath = ""  
	cont0.ImgFilter4.imgpath = ""  
	
	g_iTotalCnt = 0
	
'	cont1.contMain.gridData.setUseCardView(true, 3, "bg_listbox.9.png")
	cont1.contMain.gridData.setUseCardView(true, 10, "popup_bg_common.9.png")
	
'	cont1.contMain.gridData.setUseCardView(true, 15, "btn_12_n.9")
	
	'초기화..
	cont1.contMain.visible = True
	cont1.contMain.gridData.visible = False
	cont1.contNoData.visible = False
	
	cont1.contNoData.imgBreakTime.visible = False
	cont1.contNoData.tblHoliday.visible = False
	cont1.contNoData.tblBreakTime.visible = False
	cont1.contNoData.tblInvestCheck.visible = False
'	cont1.contNoData.lblInvestCheck.visible = False
	cont1.contNoData.lblReset.visible = False
	cont1.contNoData.imgReset.visible = False
	
		
'	cont1.contCheck.visible = False
'	cont1.Label999BG.visible = False
'	cont1.Label999.visible = False
		
	g_szUSERID = Form.GetSharedData("&USER_ID", false )
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		cont1.contMain.setScrollBarVisible("2")
		cont1.contNoData.setScrollBarVisible("2")
		cont1.setScrollBarVisible("2")
	end if
	
	
	Dim szData	
	
	g_iGroupCount = 4
	g_Max_ItemCount = {4, 4, 4, 4}
	
	for i=0 to g_iGroupCount-1
		table.insert(g_sGroup, "00")
		table.insert(g_sPrevGroup, "00")
	next

	g_bGroup_Item = {}
	for i=0 to g_iGroupCount-1
		g_bGroup_Item[i] = {}
		for j=0 to g_Max_ItemCount[i]-1
			g_bGroup_Item[i][j] = False
'			g_bGroup_Item[i][j] = "0"
		next
	next
	
'	Form.ShowAlert("OnFormInit1", 4 & "★" & g_sGroup[3] & "★" & 
'									  g_bGroup_Item[3][0] & " : " &
'									  g_bGroup_Item[3][1] & " : " &
'									  g_bGroup_Item[3][2] & " : " &
'									  g_bGroup_Item[3][3])
									  
	contFilter.group1.visible = False
	contFilter.group2.visible = False
	contFilter.group3.visible = False
	contFilter.group4.visible = False
	
	f_setInitCtrls(9)

	
	'각 그룹마다 선택된 항목 기억
	f_setItemFlags(1)
	f_setItemFlags(2)
	f_setItemFlags(3)
	f_setItemFlags(4)
	
	
	'각 그룹마다 선택된 항목 표시
	f_setCtrls(1)
	f_setCtrls(2)
	f_setCtrls(3)
	f_setCtrls(4)	
	
	
	
	
	g_szQryType = 2
	g_iDataCount = 0
	cont1.contMain.gridData.rowcount = 0
	
	cont0.edtSearch01.SetOnOffImage("alpha", "alpha")
	
	' 투자성향 정보 요청
	DATAMANAGER.RequestTranData("obsab_deal_601r")
	
	DATAMANAGER.RequestTranData("ohhts_open_001r")	'20230308 SWJ: 화면 오픈 횟수 집계
End Sub


