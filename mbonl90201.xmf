	<SCRIPT_INFO _len="59726" _ulen="55656" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 장외채권 상품 목록 조회
' 02. 화면설명 : 장외채권 상품 목록 조회
'                기본적인 조건은 단기사채 화면의 로직을 기본으로 개발함.

' 03. 이    력 : 
' - 2023.11.01 : 윤혁 : v0001 : 신규개발
' - 2024.03.07 : 박윤경 : v0003 : SOLD OUT인 경우 최상단 정렬
' - 2024.06.19 : 박윤경 : v0005 : 필터 전체 선택 개선

'-------------------------------------------------------------------------------------------


'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************

Dim g_LinkData

Dim g_plain_rm  		'v0002 메모리평문적용여부
Dim g_szQryType		'조회 구분 1:전체조회, 2:투자성향맞는 종목만 조회, 9:투자성향조회

Dim g_szUSERID    	'고객 ID
Dim g_szCsno 			'v0004 고객번호
Dim g_CUST_CLS_CODE	'고객구분코드(2:법인)

Dim g_HLDY_YN            '휴일여부
Dim g_DEAL_ABLE_YN       '매매가능 여부
Dim g_IQRY_CSNU		  '조회건수
Dim g_CUST_CLS_CODE	  '고객구분코드(2:법인)
Dim g_COMN_PFIN_YN	  '전문투자자 여부
Dim g_PFIN_VLDT_EXPR_YN  '전문투자자 만료 여부

Dim g_KYC_INVT_INCL_GRAD_CODE   'KYC투자성향등급코드
Dim g_KYC_INVT_INCL_GRAD_NAME   'KYC투자성향등급명
Dim g_IVIC_VLDT_EXPR_YN         '투자성향효력경과여부
Dim g_KYC_INVT_RCMD_CLS_CODE    'KYC투자권유구분코드


Dim g_iTotalCnt
Dim g_iDataCount
Dim g_szSortCondition
Dim g_szFilter1, g_szFilter2, g_szFilter3, g_szFilter4
Dim g_szFilterCondition
Dim g_ErrMsgText
Dim g_BlockHeight
Dim g_bFoldState

g_szSortCondition = "11"
g_FilterCondition = {"00", "00", "00", "00"}
g_BlockHeight = 122


Dim g_sGroup, g_sPrevGroup
Dim g_bGroup_Item

Dim g_iGroupCount
Dim g_Max_ItemCount

Dim g_cntGroup	'v0005

'각 그룹별로 선택된 값을 문자열값으로 연결해서 저장 (1|2|4|5)
g_sGroup = {}			'
g_sPrevGroup = {}		'조건값이 변경되었는지 확인하기 위해 처음 상태를 저장

'각 그룹별 필터조건 선택여부를 저장
g_bGroup_Item= {}

'필터 그룹 갯수
g_iGroupCount = 4

'그룹안에 있는 선택 조건 최대 갯수 (전체버튼은 제외)
g_Max_ItemCount = {4, 4, 4, 4}

g_cntGroup = {}	'v0005

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'배열 첨자로 접근하여 값을 수정하려고 하면면 main 에서 오류 발생해서 앱이 죽는다.
'해당 위치의 값을 삭제한 후 다시 그 위치로 insert 시켜준다.	
'배열 첨자로 접근시는 0 부터 시작 g_sGroup[0]
'table.remove, insert 함수에서 사용시는 1부터 시작
Sub f_editGroupValue(iIndex, szValue)
	table.remove(g_sGroup, iIndex)
	table.insert(g_sGroup, iIndex, szValue)
end Sub

'============================================================================
Sub f_editGroupItemValue(iGroupIndex, iIndex, szValue)
	table.remove(g_bGroup_Item[iGroupIndex - 1], iIndex)
	table.insert(g_bGroup_Item[iGroupIndex - 1], iIndex, szValue)	
end Sub


'============================================================================
'투자성향 체크에 따른 동작
Sub f_SetCheckState(bValue)
	if bValue == true then
		cont0.ChkMine.chksilence = "1"
		cont0.imgMine.imgpath = "checkmenu_o.png"
			
		if g_COMN_PFIN_YN == "Y" then
			'전문투자자일 경우는 전체조회
			g_szQryType = 1
		else
			g_szQryType = 2
		end if
		
		cont1.contMain.gridData.rowcount = 0
		DATAMANAGER.RequestTranData( "obsab_deal_604r" )
		
	else
		cont0.ChkMine.chksilence = "0"
		cont0.imgMine.imgpath = "checkmenu_n.png"
		
		'전문투자자인 경우 체크해지하더라도 팝업 미생성
		if g_COMN_PFIN_YN == "Y" then
			g_szQryType = 1		'내성향맞춤해제시
			
			cont1.contMain.gridData.rowcount = 0
			DATAMANAGER.RequestTranData( "obsab_deal_604r" )
			
		else			
			if g_KYC_INVT_RCMD_CLS_CODE == "3" or g_KYC_INVT_RCMD_CLS_CODE == "4" then
				'미희망(불원)&미제공 or 미희망(불원)&제공 인 경우, 체크해지하면 팝업 생성 후 전체상품조회
				Form.openPopupAnimation("mbonl88060_p11", "", "", "2")
			else
				' 내성향맞춤 체크해제시, 안내 팜업 확인 후 전체등급의 상품 조회 가능.
				Form.openPopupAnimation("mbonl88060_p11", "", "", "2")
			end if
		end if
		
	end if
	
End Sub

'============================================================================
'투자성향 및 매매가능 시간에 따른 메세지 표시
function f_setState()
	result = False
	
	if g_COMN_PFIN_YN = "Y" then
		cont0.lblMine.caption = "전문투자자"
		cont0.lblMine.fgcolor = "330"			
		
		'전문투자자일 경우는 전체조회
		g_szQryType = 1
		
	elseif g_KYC_INVT_INCL_GRAD_CODE = "" then
		'투자자정보 없는 고객은 내성향맞춤 상관없이 무조건 전체상품조회
		cont0.lblMine.caption = "미등록"
		cont0.lblMine.fgcolor = "146"

		Dim szAlertData, szTitle
		
		szTitle = "투자자정보 미등록 안내"
		g_ErrMsgText = "투자성향에 맞는 상품 가입을 위해\n투자자정보 등록이 필요합니다."
		szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."전체조회".."★".."투자성향 등록"
		
		Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
		
	elseif g_IVIC_VLDT_EXPR_YN == "Y" then
		'투자자정보 없는 고객은 내성향맞춤 상관없이 무조건 전체상품조회
		cont0.lblMine.caption = "미등록"	'유효기간만료
		cont0.lblMine.fgcolor = "146"
			
		Dim szAlertData, szTitle
		
		szTitle = "투자자정보 만료 안내"
		g_ErrMsgText = "투자자정보 유효기간이 경과되었습니다.\n투자성향에 맞는 상품 가입을 위해\n투자자정보 등록이 필요합니다."
		szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."전체조회".."★".."투자성향 등록"
		
		Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
		
	elseif g_KYC_INVT_RCMD_CLS_CODE = "2" or g_KYC_INVT_RCMD_CLS_CODE ="4" then
		'투자자정보 없는 고객은 내성향맞춤 상관없이 무조건 전체상품조회
		cont0.lblMine.caption = "정보미제공"
		cont0.lblMine.fgcolor = "321"
		
		Dim szAlertData, szTitle
		
		szTitle = "투자자정보 미제공 안내"
		g_ErrMsgText = "투자성향에 맞는 상품 가입을 위해\n투자자정보 제공이 필요합니다."
		szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."전체조회".."★".."투자성향 등록"
		
		Form.OpenPopup("mbfnp51000_p15", szAlertData, "")
		
		
	else	
		'v0001 sta 투자성향에 맞는 펀드 우선 검색
		if g_KYC_INVT_INCL_GRAD_CODE = "01" then
			cont0.lblMine.caption = "고수익지향형"
			cont0.lblMine.fgcolor = "326"
		
		elseif g_KYC_INVT_INCL_GRAD_CODE = "02" then
			cont0.lblMine.caption = "성장지향형"
			cont0.lblMine.fgcolor = "321"
			
		elseif g_KYC_INVT_INCL_GRAD_CODE = "03" then
			cont0.lblMine.caption = "중립형"
			cont0.lblMine.fgcolor = "328"
			
		elseif g_KYC_INVT_INCL_GRAD_CODE = "04" then
			cont0.lblMine.caption = "안정지향형"
			cont0.lblMine.fgcolor = "328"
			
		elseif g_KYC_INVT_INCL_GRAD_CODE = "05" then	
			cont0.lblMine.caption = "이자소득형"
			cont0.lblMine.fgcolor = "329"
		'v0001 fin
				
		end if
	
	end if
	
'	' 주말 및 공휴일
'	if g_HLDY_YN == "Y" then
'		cont1.contMain.visible = False
'		cont1.contNoData.visible = True
'		
'		cont1.contNoData.imgBreakTime.visible = True
'		cont1.contNoData.tblHoliday.visible = True
'		cont1.contNoData.tblBreakTime.visible = False
'				
'		cont1.contNoData.tblInvestCheck.visible = False
''		cont1.contNoData.lblInvestCheck.visible = False
'		cont1.contNoData.lblReset.visible = False
'		cont1.contNoData.imgReset.visible = False
'	
'	' 장시작전이나 장마감 이후
'	elseif g_DEAL_ABLE_YN == "N" then				
'		cont1.contMain.visible = False
'		cont1.contNoData.visible = True
'		
'		cont1.contNoData.imgBreakTime.visible = True
'		cont1.contNoData.tblHoliday.visible = False
