'============================================================================
Sub cont0_btnSort_OnClick()
	Dim szData
	
	szData = ""
'	Form.ShowAlert("btnSort_OnClick", g_COMN_PFIN_YN & " : " &
'								  g_IVIC_VLDT_EXPR_YN & " : " &
'								  g_KYC_INVT_INCL_GRAD_CODE & " : " &
'								  g_KYC_INVT_RCMD_CLS_CODE
'								  )
	if g_COMN_PFIN_YN == "N" then
		if g_KYC_INVT_INCL_GRAD_CODE = "" or g_KYC_INVT_INCL_GRAD_CODE = Null then
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \n정렬 기준 변경이 불가합니다.")
			
		elseif g_IVIC_VLDT_EXPR_YN == "Y" then
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \n정렬 기준 변경이 불가합니다.")
			
		elseif g_KYC_INVT_RCMD_CLS_CODE = "2" or g_KYC_INVT_RCMD_CLS_CODE ="4" then
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \n정렬 기준 변경이 불가합니다.")
			
		elseif g_KYC_INVT_RCMD_CLS_CODE = "3" then	'투자권유 미희망 + 정보제공 일때 추가
			Form.ShowAlert("알림", "투자성향 미등록 / 불원 고객은 \n정렬 기준 변경이 불가합니다.")
			
		else
			'정렬 선택 팝업
'			Form.OpenPopup("mbonl90201_p1", g_szSortCondition, "")
			Form.OpenPopupAnimation("mbonl90201_p1", g_szSortCondition,  "",  2)
		end if
	else
		'정렬 선택 팝업
'		Form.OpenPopup("mbonl90201_p1", szData, "")
		Form.OpenPopupAnimation("mbonl90201_p1", g_szSortCondition,  "",  2)
		
	end if
	
End Sub


