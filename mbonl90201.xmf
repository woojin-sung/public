						<IMAGE name="imgFold" autosize="1" imgpath="icon_gray_down" ly_vert="338,0,25,25,1" />
						<TABLE name="Table1" insidelinecolor="102:255255255" colcount="2" rowcount="36" outline="0000" transmode="1" designorder="1" ly_vert="20,23,335,490,1" >
							<COL_INFO ly_vert_width="10,325" />
							<ROW_INFO ly_vert_height="10,15,10,15,15,15,10,15,15,15,10,15,15,10,15,15,10,15,15,15,15,15,10,15,15,15,10,15,15,10,15,15,10,15,15,15" />
							<CELL_INFO>
								<CELL cell_ly="0,0,0,0" line="0,0" impidxs="" />
								<CELL cell_ly="1,0,1,0" line="0,0" impidxs="" />
								<CELL cell_ly="0,1,0,1" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,1,1,1" halign="0" line="0,0" caption="장외채권 주문 가능시간 : 평일 오전 9시 ~ 오후 5시" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,2,0,2" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,2,1,2" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,3,0,3" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,3,1,3" halign="0" line="0,0" caption="투자자는 금융투자상품(채권)에 대하여 메리츠증권으로부터" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,4,0,4" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,4,1,4" halign="0" line="0,0" caption="충분한 설명을 받을 권리가 있으며, 투자 전 상품설명서 및" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,5,0,5" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,5,1,5" halign="0" line="0,0" caption="약관을 반드시 읽어보시기 바랍니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,6,0,6" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,6,1,6" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,7,0,7" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,7,1,7" halign="0" line="0,0" caption="금융투자상품(채권)은 자산가격 변동, 신용등급 하락 등에" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,8,0,8" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,8,1,8" halign="0" line="0,0" caption="따라 투자원금의 손실(0~100%)이 발생할 수 있으며, 그 손" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,9,0,9" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,9,1,9" halign="0" line="0,0" caption="실은 투자자에게 귀속됩니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,10,0,10" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,10,1,10" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,11,0,11" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,11,1,11" halign="0" line="0,0" caption="금융투자상품(채권)은 예금자보호법에 따라 보호되지" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,12,0,12" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,12,1,12" halign="0" line="0,0" caption="않습니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,13,0,13" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,13,1,13" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,14,0,14" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,14,1,14" halign="0" line="0,0" caption="본 안내는 청약의 권유를 목적으로 하지 않으며, 청약의 " fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,15,0,15" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,15,1,15" halign="0" line="0,0" caption="권유는 (예비, 간이) 투자설명서에 따릅니다." fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,16,0,16" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,16,1,16" halign="0" line="0,0" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,17,0,17" halign="0" line="0,0" caption="·" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,17,1,17" halign="0" line="0,0" caption="채권은 발행사의 신용등급(각 채권별 상이하므로 상품 상세" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="0,18,0,18" halign="0" line="0,0" fontsize="-5" paddinginfo="1,0,0,0" impidxs="" />
								<CELL cell_ly="1,18,1,18" halign="0" line="0,0" caption="화면 등을 참고)의 하락, 신용상태 변동 등에 따라 원금손실" fontsize="-3" paddinginfo="1,0,0,0" impidxs="" />
