'============================================================================
' 01.화면명 		: 펀드매매
' 02.화면설명		: 펀드매매_결제정보팝업
' 03.작성		: 2016.02.23
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szAlertTitle	'알림타이틀
g_szAlertTitle	=	"알림"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim	szFundCode, szFundName
	dim	szLinkedData
	
	szLinkedData	=	Form.GetOpenLinkData()
	
	if len(trim(szLinkedData))	> 2	then
		szFundCode	=	getListItem(szLinkedData, 0)
		szFundName	=	getListItem(szLinkedData, 1)
		
		
		'tbl01.SetCellString(0, 1, szFundCode )
		'tbl01.SetCellString(1, 0, szFundName)
		lblFndName.caption	=	szFundName
	
		tbl02.SetCellString(0, 0, left(cld01.caption,4) & "/" & mid(cld01.caption, 5,2) & "/" & mid(cld01.caption, 7,2) &  "  현재 결제일 정보")
	
		DATAMANAGER.SetDataValue(0, "obsim_idmn_028r", "InBlock1", "ISCD", 0, szFundCode)
		DATAMANAGER.RequestTranData("obsim_idmn_028r")
		
	end if

End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if	len(trim(szSubMsg))	>	0	then
		Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert(g_szAlertTitle, szErrMsg )
	end	if
	
End Sub


'============================================================================
'ImageClose_OnClick
'============================================================================
Sub ImageClose_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
'btnOK_OnClick
'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub



