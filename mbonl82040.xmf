'============================================================================
' 01.화면명 	: 대출현금상환
' 02.화면설명	: 대출현금상환
' 03.작성	: 2016.04.21
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_nSelRow
Dim g_szNextIdx	'그리드 Next조회 대비 RowIndex값

g_nSelRow	=0
g_szNextIdx	=0


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'RequestData()
'============================================================================
Sub RequestData()

	Grid0.rowcount = 0
	
	Table0.SetCellString( 1, 1, "" )
	Table0.SetCellString( 2, 1, "" )
	Table0.SetCellString( 3, 1, "" )	
	sAcc = acnt01.caption
	
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851r", "InBlock1", "ACNO" , 0 , Left(sAcc, 8) )
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851r", "InBlock1", "ASNO" , 0 , Right(sAcc, 2) )
	'MTS메모리보안
	'szPW = Form.GetEncData(edtPwd01.caption)
	'szPW = edtPwd01.caption
	Dim plain_rm
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then
		szPW = edtPwd01.caption
	else
		szPW = Form.GetEncData(edtPwd01.caption)
	end if
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851r", "InBlock1", "ACNT_PWD" , 0 , szPW)
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851r", "InBlock1", "ISCD" , 0 , "%")
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851r", "InBlock1", "PROS_CLS" , 0 , "1")
	DATAMANAGER.RequestTranData( "oblon_rdmp_851r" )
		
End Sub


'============================================================================
'TR_Inquiry()
'============================================================================
Sub TR_Inquiry()

	DATAMANAGER.ClearInputData( 0, "oblon_rdmp_851a" )
	
	nCnt = CInt(Grid0.rowcount)
	nIndex = 0;
	for i = 0 to nCnt -1
		sCheck = Grid0.GetCellData( "bd_cell0", i )
		if sCheck == "1" then
			DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851a", "InBlock1", "ISCD" , nIndex , Grid0.GetCellData( "bd_cell10", i ))'종목코드
			DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851a", "InBlock1", "LOAN_DTL_TYPE_CODE" , nIndex , Grid0.GetCellData( "bd_cell1", i ))'대출코드
			DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851a", "InBlock1", "LOAN_DATE" , nIndex , Grid0.GetCellData( "bd_cell3", i ))'대출일자
			DATAMANAGER.SetDataValue( 0,"oblon_rdmp_851a", "InBlock1", "LOAN_SRNO" , nIndex , Grid0.GetCellData( "bd_cell11", i ))'대출일련번호
			DATAMANAGER.SetDataValue( 0,"oblon_rdmp_851a", "InBlock1", "RDMP_QTY" , nIndex , Grid0.GetCellData( "bd_cell6", i ))'상환수량
			DATAMANAGER.SetDataValue( 0,"oblon_rdmp_851a", "InBlock1", "RDMP_AMT" , nIndex , Grid0.GetCellData( "bd_cell7", i ))'상환금액
			DATAMANAGER.SetDataValue( 0,"oblon_rdmp_851a", "InBlock1", "RMND_SRNO" , nIndex , Grid0.GetCellData( "bd_cell12", i ))'잔고일련번		
			nIndex = nIndex + 1
		end if
	next	
	'MTS메모리보안
	'szPW = Form.GetEncData(edtPwd01.caption)
	'szPW = edtPwd01.caption
	Dim plain_rm
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then
		szPW = edtPwd01.caption
	else
		szPW = Form.GetEncData(edtPwd01.caption)
	end if
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851a", "InBlock2", "ACNT_PWD" , 0 , szPW) '비밀번호
	sAcc = acnt01.caption
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851a", "InBlock2", "ACNO" , 0 , Left(sAcc, 8) )
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851a", "InBlock2", "ASNO" , 0 , Right(sAcc, 2) )
	DATAMANAGER.SetDataValue( 0, "oblon_rdmp_851a", "InBlock2", "PROS_CLS_CODE" , 0 , "1")

	DATAMANAGER.RequestTranData( "oblon_rdmp_851a" )

End Sub

'============================================================================
'CalTotal()
'============================================================================
Sub CalTotal()
	nCnt = CInt(Grid0.rowcount)
	
	sQty = ""
	sAmt = ""
	sLoanInt = ""
	sLoadOvfe =""
	
	for i = 0 to nCnt -1
		sCheck = Grid0.GetCellData( "bd_cell0", i )
		if sCheck == "1" then
			sQty = sQty + CInt(Grid0.GetCellData( "bd_cell6", i)) '상환신청수량		
			sAmt = sAmt + CInt(Grid0.GetCellData( "bd_cell7", i))'상횐신청금액
			sLoanInt = sLoanInt + CInt(Grid0.GetCellData( "bd_cell8", i))'대출이자
			sLoadOvfe = sLoadOvfe + CInt(Grid0.GetCellData( "bd_cell9", i))'연체료
		end if
	next
	
	Table0.SetCellString( 1, 1, sLoanInt )
	Table0.SetCellString( 2, 1, sLoadOvfe )
	Table0.SetCellString( 3, 1, sAmt )
End Sub


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_szNextIdx	=0
	edtPwd01.caption = ""
	RequestData()
End Sub

'============================================================================
'acnt01_ChangeAccount
'============================================================================
Sub acnt01_ChangeAccount()
	g_szNextIdx	=0
	edtPwd01.caption = ""
	RequestData()
End Sub


'============================================================================
'edtPwd01_OnEditComplete()
'============================================================================
Sub edtPwd01_OnEditComplete()
	g_szNextIdx	=0
	RequestData()
End Sub


'============================================================================
' btnSave_OnClick()
'============================================================================
Sub btnSave_OnClick()

	sTotal = Table0.GetCellString( 0, 1)'상환가능예수금
	sLoanInt = Table0.GetCellString( 1, 1)'대출이자
	sLoadOvfe = Table0.GetCellString( 2, 1)'연체료
	sAmt = Table0.GetCellString( 3, 1)'상환신청금액
	
	if CDbl(sTotal) < CDbl(sAmt) + CDbl(sLoanInt) + CDbl(sLoadOvfe) then
		Form.ShowAlert( "알림", "상환가능예수금이 부족합니다." )
		Exit Sub
	end if
	
	nAblecnt = 0
	for i = 0 to nCnt -1
		sCheck = Grid0.GetCellData( "bd_cell0", i )
		if sCheck == "1" then
			nAblecnt = nAblecnt + 1
		end if
	next
	
	if nAblecnt > 0 then
		Form.OpenFramePopup("mhetc90060_p5" , "" , "")
	end if	
	'TR_Inquiry()
End Sub


'============================================================================
'Grid0_OnClickUp(lRow, szCellID)
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	if szCellID == "bd_cell0" then
		sCheck = Grid0.GetCellData( "bd_cell0", lRow )
		
		if sCheck == "1" then
			Dim szData
			szData = ""
			
			if Len(edtPwd01.caption) == 0 then
				Form.ShowAlert( "알림", "비밀번호를 확인 하세요." )
				Grid0.SetCellData( "bd_cell0", lRow ,"0")
				Exit Sub
			end if
		
			g_nSelRow = lRow
			
			' 20130330 상환가능금액/수량을 잘못 판단으로 적용되어 있는 부분 수정
			szData = acnt01.total										' 계좌번호(8)
			szData = szData & "^" & acnt01.sequence						' 계좌일련번호(2)
			szData = szData & "^" & Grid0.GetCellData("bd_cell10", lRow)	' 종목코드
			szData = szData & "^" & Grid0.GetCellData("bd_cell1",  lRow)	' 대출코드
			szData = szData & "^" & Grid0.GetCellData("bd_cell3",  lRow)	' 대출일자
			szData = szData & "^" & Grid0.GetCellData("bd_cell11", lRow)	' 대출일련번호
			szData = szData & "^" & Grid0.GetCellData("bd_cell4",  lRow)	' 대출잔량
			szData = szData & "^" & Grid0.GetCellData("bd_cell5",  lRow)	' 대출잔액
			szData = szData & "^" & Grid0.GetCellData("bd_Amt",    lRow)	' 상환가능금액
			szData = szData & "^" & Grid0.GetCellData("bd_Qty",    lRow)	' 상환가능수량
			szData = szData & "^" & Grid0.GetCellData("bd_cell2",  lRow)	' 종목명
			
			'Form.OpenPopup( "mbonl82040_p1.xmf" , szData , "" )	
			Form.OpenFramePopup( "mbonl82040_p1.xmf" , szData , "" )	
			
'			sAcc = acnt01.caption							'계좌번혼
'			sCode = Grid0.GetCellData( "bd_cell10", lRow )	'종목코드
'			sLoadCode = Grid0.GetCellData( "bd_cell1", lRow )	'대출코드
'			sLoadDate = Grid0.GetCellData( "bd_cell3", lRow )	'대출일자
'			sLoadSrno = Grid0.GetCellData( "bd_cell11", lRow )'대출일련번호
'			sLoadQty = Grid0.GetCellData( "bd_cell4", lRow )'대출잔량
'			sLoadAmt = Grid0.GetCellData( "bd_cell5", lRow )'대출잔액
'			sLoadAble= Table0.GetCellString( 0, 1)'상환가능
'			sCodeName = Grid0.GetCellData( "bd_cell2", lRow )	'종목명
'			sOpenData = Left(sAcc, 8) & "^" &  Right(sAcc, 2) & "^" & sCode & "^" & sLoadCode & "^" & sLoadDate & "^" & sLoadSrno & "^" & sLoadQty & "^" & sLoadAmt & "^" &  sLoadAble & "^" & sCodeName
'			
'			Form.OpenPopup( "mbonl82040_p1.xmf" , sOpenData , "" )	
		else
			Grid0.SetCellData( "bd_cell6", lRow, "" )'상환신청수량		
			Grid0.SetCellData( "bd_cell7", lRow,"")'상횐신청금액
			Grid0.SetCellData( "bd_cell8", lRow, "")'대출이자
			Grid0.SetCellData( "bd_cell9", lRow, "" )'연체료
			CalTotal()
		end if
	end if	
End Sub


'============================================================================
'Grid0_OnScrollEnd
'============================================================================
Sub Grid0_OnScrollEnd()
	DATAMANAGER.RequestNextData( "oblon_rdmp_851r")
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	dim	szOrgCode, szTransCode	'대출유형코드
	
	szOrgCode	=""
	szTransCode	=""

	if szTranID == "oblon_rdmp_851a" then
		szMsg = DATAMANAGER.GetDataMsgText("oblon_rdmp_851a")
		Form.ShowAlert("알림", szMsg)
		
		RequestData()
	elseif szTranID == "oblon_rdmp_851r" then	
		nCnt = CInt(Grid0.rowcount)
		for i = 0 to nCnt -1
			sCheck = Grid0.GetCellData( "bd_cell0", i , "0")
		next
	
		'대출유형코드 한글변환 
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "oblon_rdmp_851r", "OutBlock1") - 1
			szOrgCode		=	""
			szTransCode		=	""
		
			szOrgCode = DATAMANAGER.GetDataValue( 0 , "oblon_rdmp_851r", "OutBlock1", "LOAN_DTL_TYPE_CODE" , i)
			szTransCode =  Form.GetMetaData("대출상세유형코드", szOrgCode)
			
			Grid0.SetCellData( "bd_type", g_szNextIdx , szTransCode)
		
			g_szNextIdx = g_szNextIdx + 1
		next
	end if
	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "oblon_rdmp_851a" or szTranID == "oblon_rdmp_851r" then
		szSubErrMsg = DATAMANAGER.GetDataMsgSubText( szTranID)
		Form.MsgBox( "알림", szErrMsg & " " & szSubErrMsg, "", 0 )
	end if
End Sub
	
	
'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "LOANSET" then
		szData =sRet
		szList = Split(szData, "^")
	
		if UBOUND(szList) > 1 then
		
			Grid0.SetCellData( "bd_cell6", g_nSelRow, szList[0] )'상환신청수량		
			Grid0.SetCellData( "bd_cell7", g_nSelRow, szList[1] )'상횐신청금액
			Grid0.SetCellData( "bd_cell8", g_nSelRow, szList[2] )'대출이자
			Grid0.SetCellData( "bd_cell9", g_nSelRow, szList[3] )'연체료
		
		end if
		CalTotal()
	elseif sKeyName == "LOANSET_CANCLE" then
		Grid0.SetCellData( "bd_cell0", g_nSelRow, "0" )'	
	
	elseif sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			TR_Inquiry()
		else						'실패
			exit sub
		end if
	end if
End Sub



