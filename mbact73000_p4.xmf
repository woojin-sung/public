		<LABEL name="lblTitle" fontsize="4" fontstyle="01" caption="간편비밀번호(PIN) 등록이
완료되었습니다." halign="1" multiline="1" ly_vert="0,173,375,50,1" />
		<BUTTON name="btnLogin" caption="로그인하기" bgcolor2="062:255255255" fontsize="2" fontstyle="01" btnimage="btn_20.9" ly_vert="0,597,375,50,1" />
		<TABLE name="tblBioAble" insidelinecolor="102:255255255" colcount="1" rowcount="4" outline="0000" designorder="1" ly_vert="0,258,375,80,1" >
			<COL_INFO ly_vert_width="375" />
			<ROW_INFO ly_vert_height="20,20,20,20" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" fgcolor="146:124124124" line="0,0" caption="생체인증(지문/FaceID)을" impidxs="" />
				<CELL cell_ly="0,1,0,1" fgcolor="146:124124124" line="0,0" caption="추가로 등록할 수 있습니다." impidxs="" />
				<CELL cell_ly="0,2,0,2" fgcolor="146:124124124" line="0,0" impidxs="" />
				<CELL cell_ly="0,3,0,3" fgcolor="146:124124124" line="0,0" impidxs="" />
			</CELL_INFO>
		</TABLE>
		<BUTTON name="btnLater" caption="다음에 하기" fgcolor="095:000000000" fontsize="3" fontstyle="01" btnimage="btn_27.9.png" ly_vert="0,596,188,51,1" />
		<BUTTON name="btnBioReg" caption="추가 등록하기" fontsize="3" fontstyle="01" btnimage="btn_20.9" ly_vert="188,596,187,51,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="14460" _ulen="12846" >

Dim g_szUserID
Dim g_szAcno

'Fido 관련
Dim DEF_BIO_FINGER
Dim DEF_BIO_PIN

'g_sBIOAthnTchnCode에서 사용 (인증기술코드)
DEF_BIO_FINGER		= "100"	'지문/얼굴
DEF_BIO_PIN			= "116"	'PIN 

Dim g_szOsType
Dim g_szTermID
Dim g_szDeviceModel
Dim g_szBioEnable

Dim tbl_001a(0)
Dim tbl_002a(0)
Dim tbl_008a(0)

Dim tbl_011a(0)
Dim tbl_013a(0)
Dim tbl_015a(0)

'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	
	Form.SetSharedData("&SCREEN_AUTH" , "99") '비대면화면 권한부여
	
	g_szUserID = Form.GetSharedData("KAKAO_USERID", false)
	g_szAcno = Form.GetSharedData("BDM_KAKAO_ACNO"          , false )
	
	g_szOsType = Form.GetSharedData("&OS_TYPE", false )	'iOS("2") Android("1") 기타("9")
	g_szTermID = Form.getKftcBioDeviceID()				'단말FID획득
	g_szDeviceModel = Form.getDeviceModel()				'모델명
	g_szBioEnable = Form.GetKftcBioDeviceEnbl()			'바이오인증 지원 여부 : 0.미지원 1.지원(지문가능) 2.지원(지문불가)
	
'	g_szBioEnable = "0"
	
	If g_szBioEnable == "0" Or g_szBioEnable == "2" Then
		tblBioAble.visible = false
		
		btnLogin.visible = true
		btnLater.visible = false
		btnBioReg.visible = false
	Else
		tblBioAble.visible = true
		
		btnLogin.visible = false
		btnLater.visible = true
		btnBioReg.visible = true
	End If
End Sub

'============================================================================
Sub Form_onTriggerEventBio(sEventName, sParam)
	Dim sRet, sErrorCode, sErrorMsg
	sRet = Split(sParam, "★")
	
	if #sRet > 1 then
		sErrorCode	= sRet[0]
		sErrorMsg 	= sRet[1]	
	else
		exit sub
	end if
	
	if #sRet > 2 then
		sBioRet = Form.KBase64Decoding(sRet[2])
		sBioItemRet = Split(sBioRet, "★")
	end if	

	'FIDO 1.0 등록응답
	if sEventName == "90110_Bio_104" then 

		'--- FIDO등록응답메시지 수신 ---
		sRespond	= sBioItemRet[0]	'FIDO 등록응답 메시지
		sOtpk	= sBioItemRet[1]	'일회용 공개키
		sVersion	= sBioItemRet[2]	'앱버전	
		
		'FIDO 등록 요청 메시지전송
		sTlmsTrcNo = tbl_001a("BIO_TLMS_TRC_NO") '전문추적번호
		 
		DATAMANAGER.SetDataValue(0, "obtss_fido_002a", "InBlock1", "ELFN_ID",                 0 ,	g_szUserID) 		'전자금융 ID
		DATAMANAGER.SetDataValue(0, "obtss_fido_002a", "InBlock1", "APP_RSPN_CODE",           0 ,	"0000")			'연계앱응답코드
		DATAMANAGER.SetDataValue(0, "obtss_fido_002a", "InBlock1", "BIO_TLMS_TRC_NO",         0 , 	sTlmsTrcNo) 		'전문추적번호
		DATAMANAGER.SetDataValue(0, "obtss_fido_002a", "InBlock1", "UI_FIDO_MSG_SIZE1" ,      0 , 	Len(sRespond)) 	'FIDO 메시지사이즈1(등록응답메시지 길이)
		DATAMANAGER.SetDataValue(0, "obtss_fido_002a", "InBlock1", "UI_FIDO_REG_RSPN_MSG",    0 , 	sRespond) 		'FIDO 등록응답 메시지
		DATAMANAGER.SetDataValue(0, "obtss_fido_002a", "InBlock1", "UI_FIDO_MSG_SIZE2",       0 , 	Len(sOtpk))		'FIDO 메시지사이즈2(일회용공개키 길이)
		DATAMANAGER.SetDataValue(0, "obtss_fido_002a", "InBlock1", "ONTM_OPBL_KEY_1024_MSG" , 0 , 	sOtpk)			'일회용 공개키 1024메시지
		DATAMANAGER.RequestTranData("obtss_fido_002a")			
		'FIDO 1.0 비식별호환번호 저장결과
	
	elseif sEventName == "90110_Bio_106" then
		if sBioRet == "Success" then
			DATAMANAGER.SetDataValue(0 ,"obcsb_fido_002a", "InBlock1", "PROS_CLS_CODE",  	0, "I")				'처리구분코드 I:등록 D:해지
'			if Form.isIphoneX() == true then
'				DATAMANAGER.SetDataValue(0, "obcsb_fido_002a", "InBlock1", "ATHN_TCHN_CODE", 	0, DEF_BIO_FACE)
'			else
				DATAMANAGER.SetDataValue(0, "obcsb_fido_002a", "InBlock1", "ATHN_TCHN_CODE", 	0, DEF_BIO_FINGER)
'			end if
			DATAMANAGER.SetDataValue(0, "obcsb_fido_002a", "InBlock1", "TERM_ID", 		0, g_szTermID)			'단말ID
			DATAMANAGER.SetDataValue(0, "obcsb_fido_002a", "InBlock1", "TERM_OS_CODE" , 	0, g_szOsType)			'단말운영체제
			DATAMANAGER.SetDataValue(0, "obcsb_fido_002a", "InBlock1", "ELFN_ID", 		0, g_szUserID)			'전자금융ID
			DATAMANAGER.SetDataValue(0, "obcsb_fido_002a", "InBlock1", "ACNO",	 		0, g_szAcno)			'계좌번호
			DATAMANAGER.SetDataValue(0, "obcsb_fido_002a", "InBlock1", "TERM_MODL_NO",	0, g_szDeviceModel)		'모델명
			DATAMANAGER.RequestTranData("obcsb_fido_002a")
		else
			'실패
		end if

	'FIDO 2.0 등록응답
	elseif sEventName == "90110_Bio_2104" then
		'sBioItemRet[0] 'certification 삼성패스 등록 시 반환
		'sBioItemRet[1] '앱버전
		
		'등록결과 전송
		DATAMANAGER.SetDataValue(0, "obtss_fido_012a", "InBlock1", "ELFN_ID" ,        0 , g_szUserID) 					'전자금융ID
		DATAMANAGER.SetDataValue(0, "obtss_fido_012a", "InBlock1", "BIO_TLMS_TRC_NO" ,0 , tbl_011a("BIO_TLMS_TRC_NO"))	'바이오전문추적번호
		DATAMANAGER.RequestTranData("obtss_fido_012a")		
			
	
	'FIDO 1.0 디바이스ID 획득
	elseif sEventName == "90110_Bio_402" then
		'sBioItemRet[0]	'디바이스 아이디
		'sBioItemRet[1]	'앱버전
		'sBioItemRet[2]	'인증기술목록
		'sBioItemRet[3]	'홍채이관대상유무
		
		g_szTermID = Form.getKftcBioDeviceID() 'Bio_402 이후에 값을 가져올 수 있다
		g_sBioAppVersion = sBioItemRet[1]
		sAuthTechList = sBioItemRet[2]
		
		while LEN(sAuthTechList) >= 3
			sAuthTechCode = LEFT(sAuthTechList,3)
			sAuthTechList = RIGHT(sAuthTechList, LEN(sAuthTechList)-3)
	
			if sAuthTechCode == DEF_BIO_FINGER then 'or sAuthTechCode == DEF_BIO_FACE then
			
			elseif sAuthTechCode == DEF_BIO_PIN then
			
			end if
		wend
			if g_sBIOAthnTchnCode == DEF_BIO_FINGER then 'or g_sBIOAthnTchnCode == DEF_BIO_FACE then		
				DATAMANAGER.SetDataValue(0, "obtss_fido_001a", "InBlock1", "ELFN_ID" 		, 0, g_szUserID) 			'전자금융ID
				DATAMANAGER.SetDataValue(0, "obtss_fido_001a", "InBlock1", "TERM_OS_CODE" 	, 0, g_szOsType) 			'단말운영체제 1:안드로이드 2:아이폰 9:기타
				DATAMANAGER.SetDataValue(0, "obtss_fido_001a", "InBlock1", "TERM_ID" 		, 0, g_szTermID)			'단말ID
				DATAMANAGER.SetDataValue(0, "obtss_fido_001a", "InBlock1", "SVCD" 			, 0, "001")		'서비스코드   001:고정
				DATAMANAGER.SetDataValue(0, "obtss_fido_001a", "InBlock1", "ATHN_TCHN_CODE" 	, 0, g_sBIOAthnTchnCode)		'인증기술코드 100:고정
				DATAMANAGER.RequestTranData("obtss_fido_001a")
			else
				DATAMANAGER.SetDataValue(0, "obtss_fido_011a", "InBlock1", "ELFN_ID" 		, 0, g_szUserID) 			'전자금융ID
				DATAMANAGER.SetDataValue(0, "obtss_fido_011a", "InBlock1", "TERM_ID" 		, 0, g_szTermID)			'단말ID
				DATAMANAGER.SetDataValue(0, "obtss_fido_011a", "InBlock1", "SVCD" 			, 0, "001")		'서비스코드   001:고정
				DATAMANAGER.SetDataValue(0, "obtss_fido_011a", "InBlock1", "ATHN_TCHN_CODE" 	, 0, g_sBIOAthnTchnCode)	'인증기술코드 100:지문, 116:PIN, 115:손바닥
				DATAMANAGER.SetDataValue(0, "obtss_fido_011a", "InBlock1", "NTAT_ISNC_CLCD" 	, 0, "0")				'0:FIDO등록 1:인증서발급
				DATAMANAGER.RequestTranData("obtss_fido_011a")	
			end if
			
			
	elseif sEventName == "90110_Bio_1000" then '연계앱 오류 메시지
		If Len(sErrorCode) > 0 Then
'			Form.MsgBox( "알림",  sErrorMsg  , "", 0 )
			Form.OpenPopup("mbbdm85303", sErrorMsg, "")
		End If
		
	end if
End Sub

'============================================================================
Sub btnLater_OnClick()
	'Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
	'Form.SetSharedData("&SCREEN_AUTH"      , "" )  	'v0001 비대면화면 권한 프리
	Form.OpenNextPopup("mhetc90021", "", "")
End Sub

'============================================================================
Sub btnLogin_OnClick()
	'Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
	'Form.SetSharedData("&SCREEN_AUTH"      , "" )  	'v0001 비대면화면 권한 프리
	Form.OpenNextPopup("mhetc90021", "", "")
End Sub

'============================================================================
Sub btnBioReg_OnClick()
	Dim szBioAppYn
	szBioAppYn = Form.getKftcBioInstalled()
'	Form.ShowAlert("", szBioAppYn)
	If szBioAppYn == "1" Then
		'FIDO 1.0 등록요청 (지문&얼굴)
		'(Bio_401 -> Bio_402) -> obtss_fido_001a -> 앱버전체크 -> (Bio_103 -> Bio_104) -> obtss_fido_002a -> (Bio_105 -> Bio_106) -> obcsb_fido_002a
		g_sBIOAthnTchnCode = "100"
		Form.requestKftcBio("Bio_401", "" , "90110") '단말정보 취득
	Else
		Form.setKftcBioInstalled()
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'FIDO 1.0 등록요청 수신
	if szTranID == "obtss_fido_001a" then 
		tbl_001a("APP_VRSN") 			=  DATAMANAGER.GetDataValue( 0, "obtss_fido_001a", "OutBlock1", "APP_VRSN"			,0)	'최신 연계앱 버전
		tbl_001a("FIDO_MSG")			=  DATAMANAGER.GetDataValue( 0, "obtss_fido_001a", "OutBlock1", "UI_FIDO_REG_RQST_MSG"	,0)	'FIDO 등록요청 메시지
		tbl_001a("BIO_TLMS_TRC_NO")		=  DATAMANAGER.GetDataValue( 0, "obtss_fido_001a", "OutBlock1", "BIO_TLMS_TRC_NO"		,0)	'전문추적번호
		tbl_001a("FIDO_LEN")			=  DATAMANAGER.GetDataValue( 0, "obtss_fido_001a", "OutBlock1", "UI_FIDO_MSG_SIZE1"	,0)
		
		sSubMsg = DATAMANAGER.GetDataMsgSubText("obtss_fido_001a")
		
		'길이정보확인
		if CLng(tbl_001a("FIDO_LEN")) <> LEN(tbl_001a("FIDO_MSG")) then
			Form.MsgBox( "알림", "[TR]" & "FIDO 메시지 길이정보 이상" & "\n" & "("& sSubMsg & ")", "", 0 )
			exit sub
		end if
		
		'앱버전비교
		sSvrAppVersion = tbl_001a("APP_VRSN")
		sMinAppVersion = Left(sSvrAppVersion, 4)		'최소버전
		sNewAppVersion = Right(sSvrAppVersion, 4)	'최신버전
		
		'현재버전이 최소버전보다 낮을 경우 반드시 업데이트
		if CInt(g_sBioAppVersion) < CInt(sMinAppVersion) then
			Form.MsgBox("알림", "금융결제원 FIDO앱 업데이트를 진행합니다.", "FIDO_UPDATE", 1)
			exit sub
			
		'현재버전이 최신버전보다 낮을 경우 업데이트를 권고
		elseif CInt(g_sBioAppVersion) < CInt(sNewAppVersion) then
			Form.Toast(0, "금융결제원 FIDO 앱 업데이트를 권장합니다." , 0)
		end if	
		
		'FIDO 등록 요청 메시지전송
		sParam = tbl_001a("FIDO_MSG")
		Form.requestKftcBio("Bio_103",sParam,"90110") 'FIDO등록요청메시지&TLSCertificate	
	
	'FIDO 1.0 등록결과 수신
	elseif szTranID == "obtss_fido_002a" then
		tbl_002a("FIDO_LEN")	= DATAMANAGER.GetDataValue( 0, "obtss_fido_002a", "OutBlock1", "UI_FIDO_MSG_SIZE1"	,0)	'비식별호환번호 사이즈					
		tbl_002a("FIDO_MSG")	= DATAMANAGER.GetDataValue( 0, "obtss_fido_002a", "OutBlock1", "FIDO_1024_MSG"		,0)	'비식별호환번호
		
		sSubMsg = DATAMANAGER.GetDataMsgSubText("obtss_fido_002a")		
		
		'길이정보확인
		if CLng(tbl_002a("FIDO_LEN")) <> LEN(tbl_002a("FIDO_MSG")) then
			Form.MsgBox( "알림", "[TR]" & "FIDO 메시지 길이정보 이상" &"\n"& "(" & sSubMsg & ")", "", 0 )
			exit sub
		end if
			 
		sParam = tbl_002a("FIDO_MSG")&"★"&"Y"		'sparam에 호환 가능 여부 추가해서 전송 해야함
		Form.requestKftcBio("Bio_105",sParam,"90110")	'비식별호환번호(암호화) & 호환가능 여부 전송
	
	'FIDO 2.0 등록요청 수신
	elseIf szTranID == "obtss_fido_011a" then
		OTSD_TR_UNIQ_NO			= DATAMANAGER.GetDataValue( 0, "obtss_fido_011a", "OutBlock1", "OTSD_TR_UNIQ_NO"	,0)
		tbl_011a("BIO_TLMS_TRC_NO")	= DATAMANAGER.GetDataValue( 0, "obtss_fido_011a", "OutBlock1", "BIO_TLMS_TRC_NO"	,0)
		FIDO_TLMS_TRC_NO			= DATAMANAGER.GetDataValue( 0, "obtss_fido_011a", "OutBlock1", "FIDO_TLMS_TRC_NO"	,0)
		
		sParam = FIDO_TLMS_TRC_NO & "★" & "00287" & "★" & g_sBIOAthnTchnCode 'FIDO추적번호,기관코드,인증기술코드
		Form.requestKftcBio("Bio_2103", sParam, "90110")	
	
	'FIDO 2.0 등록결과 수신
	ElseIf szTranID == "obtss_fido_012a" then
		DATAMANAGER.SetDataValue(0 ,"obcsb_fido_002a", "InBlock1", "PROS_CLS_CODE",  	0, "I")				'처리구분코드 I:등록 D:해지
		DATAMANAGER.SetDataValue(0, "obcsb_fido_002a", "InBlock1", "ATHN_TCHN_CODE", 	0, g_sBIOAthnTchnCode)	'인증기술코드
		DATAMANAGER.SetDataValue(0, "obcsb_fido_002a", "InBlock1", "TERM_ID", 		0, g_szTermID)			'단말ID
		DATAMANAGER.SetDataValue(0, "obcsb_fido_002a", "InBlock1", "TERM_OS_CODE" , 	0, g_szOsType)			'단말운영체제
		DATAMANAGER.SetDataValue(0, "obcsb_fido_002a", "InBlock1", "ELFN_ID", 		0, g_szUserID)			'전자금융ID
		DATAMANAGER.SetDataValue(0, "obcsb_fido_002a", "InBlock1", "ACNO",	 		0, g_szAcno)			'계좌번호
		DATAMANAGER.SetDataValue(0, "obcsb_fido_002a", "InBlock1", "TERM_MODL_NO",	0, g_szDeviceModel)		'모델명
		DATAMANAGER.RequestTranData("obcsb_fido_002a")
	
	ElseIf szTranID == "obcsb_fido_002a" then
		
		Form.MsgBox("알림", "바이오인증 정보가 정상적으로 등록되었습니다.", "SUCC_OK", 0)

	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	sSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if Len(sSubMsg) > 1 then
		'Form.MsgBox( "알림", "[TR]" & szErrMsg & "\n" & sSubMsg, "", 0 )
		Form.OpenPopup("mbbdm85303", "[TR]" & szErrMsg & "★" & sSubMsg , "")
	else
		'Form.MsgBox( "알림", "[TR]" & szErrMsg , "", 0 )
		Form.OpenPopup("mbbdm85303", "[TR]" & szErrMsg, "")
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")
	
	'20230203 HSZ START
	Form.SetEnvData(1, "login.input.savetab", "3")	'로그인 화면 이동시, 바로 바이오인증으로 이동
	Form.SetSharedData("&SCREEN_AUTH"      , "" )  	'v0001 비대면화면 권한 프리
	Form.SetSharedData("BDM_BIOREG" , "Y")			'mhetc90022 화면 닫기 FLAG
	'20230203 HSZ END
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "SUCC_OK" Then
		'안드로이드 뒤로가기 비활성화		'
		'Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
		'Form.SetSharedData("&SCREEN_AUTH"      , "" )  	'v0001 비대면화면 권한 프리
		
		Form.SetEnvData(1,"login.athntchn.cd", g_sBIOAthnTchnCode) '인증기술코드 (등록한 바이오인증 기술코드를 최종으로 저장)
		
		Form.SetEnvData(1, "login.input.bioathntchncode", g_sBIOAthnTchnCode)
		Form.SetEnvData(1, "login.input.userid", g_szUserID)
		Form.SetEnvData(1, "login.input.saveid", "1")
		
		'등록 성공과 동시에 로그인 창 오픈
		Form.OpenNextPopup("mhetc90021", "", "")
	end if	
End Sub


