		<IMAGE name="Image0" autosize="1" imgpath="alpha" ly_vert="0,0,375,647,1" />
		<IMAGE name="Image2" imgpath="btn_02_n.9" ly_vert="34,114,342,533,1" />
		<FORMTAB name="FormTab0" tabcount="3" tabwidthtype="2" tabheadheight="40" ly_vert="35,116,340,530,1" >
