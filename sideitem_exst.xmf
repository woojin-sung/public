'============================================================================
Sub Form_OnFormInitBefore()
	sSide = Form.GetOpenLinkData()
	'20230630 HSZ START: 왼쪽 이미지 수정
	'16-04-20 YCJ 좌측일때 빨간 배경색이 보이는 부분 
	if sSide = "left" then
		FormTab0.left = "0"
		Image2.left = "0"
		Image1.left = "342"
		Image1.imgpath = "btn_side_l_o.png"
	end if
	'20230630 HSZ END
End Sub

'============================================================================
Sub Form_OnFormInit()
	nTab = Form.GetSharedData("SIDEITEM_EXST_TAB", 0 )
	FormTab0.currenttab = nTab
End Sub

'============================================================================

'============================================================================
Sub Image1_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	Form.SetSharedData("SIDEITEM_EXST_TAB" , nCurrentTab)
End Sub


Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "CLOSE_FORM" then
		Form.CloseForm()
	end if
End Sub
	</SCRIPT_INFO>
