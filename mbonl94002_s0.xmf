	<SCRIPT_INFO _len="1179" _ulen="1139" >
'--===========================================================================
' 01. 화 면 명 : 지정심사안내
' 02. 화면설명 : 
' 03. 작    성 : 2021.06.08 정효영
' 04. 수    정 : 
'
'--===========================================================================

''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim szTheme
	szTheme = Form.GetEnvData("common.theme")

	if szTheme == "white" then
		Container0.imgStep5.imgpath = "icon_5step_w"
	else
		Container0.imgStep5.imgpath = "icon_5step_b"
	end if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Container0.imgStep1.setMaintainingRatio("1")
	Container0.imgStep2.setMaintainingRatio("1")
	Container0.imgStep3.setMaintainingRatio("1")
	Container0.imgStep4.setMaintainingRatio("1")
	Container0.imgStep5.setMaintainingRatio("1")
End Sub


	</SCRIPT_INFO>
