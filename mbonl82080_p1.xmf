	<SCRIPT_INFO _len="1216" _ulen="1202" >


'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
Sub Form_OnFormInitBefore()
	imgIcon.setMaintainingRatio("1")

End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	Dim tData
	
	szOpenData = trim(Form.GetOpenLinkData( ))
	if szOpenData ~= "" then
		tData = Split(szOpenData, "★" )
		
		lblData1.caption = f_SetAccountMask(tData[0]	)	
		lblData2.caption = tData[1]
		lblData3.caption = tData[2]
		lblData4.caption = "승인대기"
		lblData4.fgcolor = "291"
		
	end if
End Sub


'============================================================================
Function f_SetAccountMask(szAccount)
	Dim szReturnData 
	if trim(szAccount) ~= "" then
		'LHR 수정
		if #szAccount == 10 then
			szReturnData = Left(szAccount,4)&"-"&Mid(szAccount,5,4)&"-"&Right(szAccount,2)		
		elseif #szAccount == 8 then
			szReturnData = Left(szAccount,4)&"-"&Right(szAccount,4)
		else
			szReturnData = szAccount
		end if
	end if
	
	return szReturnData
	
End Function

