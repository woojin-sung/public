<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="16000" scrname="해외주식현재가_호가_매수매도" version="2" writer="itgen" />
	<FORM_INFO name="Form" transmode="0" ly_vert="0,0,375,39,1" />
	<CONTROL_INFO>
		<BUTTON name="BtnSell" fgcolor="004:000000000" bgcolor="042:238238238" btnimage="bullet_fx_sell" ly_vert="0,0,117,39,1" />
		<BUTTON name="BtnBuy" fgcolor="004:000000000" bgcolor="042:238238238" btnimage="bullet_fx_buy" ly_vert="255,0,120,39,1" />
		<BUTTON name="BtnClose" btnimage="alpha" ly_vert="117,0,138,39,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1316" _ulen="1246" >
'===========================================================================
' 화  면  명 : 해외주식현재가_호가_매수매도
' 화  면  ID : 
' 개      요 : 
' 작      성 : 2017.10.10 이재원
' 수      정 : 
'===========================================================================

Dim g_sCurrent
Dim g_sCode
g_sCurrent = ""
g_sCode = ""

'============================================================================
Sub Form_OnFormInit()
	g_sCode		 = Form.GetSharedData( "&ITEM_CODE", 0  )
	g_sCurrent	 = Form.GetSharedData( "1100_CURRENT_PRICE", 0  )
end Sub

'============================================================================
' 매도 버튼
'============================================================================
Sub BtnSell_OnClick()
	Form.OpenScreen( "1300" , "1" .."`".. g_sCurrent .."`".. g_sCode )
	Form.CloseForm( )
end Sub

'============================================================================
' 매수 버튼
'============================================================================
Sub BtnBuy_OnClick()
	Form.OpenScreen( "1300" , "0" .."`".. g_sCurrent .."`".. g_sCode )
	Form.CloseForm( )
end Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm( )
end Sub

	</SCRIPT_INFO>
</ROOT>