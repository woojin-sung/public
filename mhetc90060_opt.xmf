'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 공인인증서
' 02. 화면설명 : 공인인증서_인증방법
' 03. 작    성 : 2020.10.28 성우진
' 2021.05.27 : 정민영 : v001 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obcsb_efif_060a IO변경분 적용
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim sEmail, sArCd, sToNo, sTelNo, sArCd3, sToNo3, sTelNo3, sArCd2, sToNo2, sTelNo2
Dim sTempEmail
Dim temp
Dim nChkCnt		'체크박스 개수 카운트
	nChkCnt = 0
Dim nFlag		'인증 성공 플래그
	nFlag   = 0
Dim g_sUserID
'-----------------------------------------------------------------------

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' 전화번호 마스킹처리함수
'============================================================================
Function GetMaskNumber(sNum)
	if sNum == null or Trim(sNum) == "" then
		return sNum
	end if
	
	if #sNum <= 2 then
		return sNum
	end if
	
	Dim sMaskNum
	if #sNum == 3 then
		sMaskNum = Left(sNum, 1)
	else
		sMaskNum = Left(sNum, 2)
	end if
	
	sMaskNum = sMaskNum.."**"
	
	return sMaskNum
End Function

'============================================================================
' 정보 확인 체크함수 (팝업메시지 총 한번 띄우기 위해 분리)
'============================================================================
Function InfoCheck()
	
	if ChkButton0.checkstate == "1" then
		g_sUserID = Form.GetSharedData("CERT_ID" , false)
					
		if EditID.caption = g_sUserID then
			nFlag = nFlag + 1
		elseif EditID.caption = "" then
			Form.MsgBox( "안내", "ID 정보를 미입력하셨습니다.", "", 6 )
			nFlag = 0
			Exit Function
		else
			Form.MsgBox( "안내", "ID 정보가 일치하지 않습니다.", "", 6 )
			nFlag = 0
			Exit Function
		end if
	end if
	
	
	if ChkButton1.checkstate == "1" then
		if Edit2.caption = sTelNo then
			nFlag = nFlag + 1
		elseif Edit2.caption =="" then
			Form.MsgBox( "안내", "자택 전화번호 정보를 미입력하셨습니다.", "", 6 )
			nFlag = 0
			Exit Function
		else
			Form.MsgBox( "안내", "자택 전화번호 정보가 일치하지 않습니다.", "", 6 )
			nFlag = 0
			Exit Function
		end if
	end if
	
	if ChkButton2.checkstate == "1" then
		if Edit8.caption = sTelNo3 then
			nFlag = nFlag + 1
		elseif Edit8.caption = "" then
			Form.MsgBox( "안내", "직장 전화번호 정보를 미입력하셨습니다.", "", 6 )
			nFlag = 0
			Exit Function
		else
			Form.MsgBox( "안내", "직장 전화번호 정보가 일치하지 않습니다.", "", 6 )
			nFlag = 0
			Exit Function
		end if
	end if
	
	if ChkButton3.checkstate == "1" then
		if Edit5.caption = sTelNo2 then
			nFlag = nFlag + 1
		elseif Edit5.caption = "" then
			Form.MsgBox( "안내", "휴대폰 전화번호 정보를 미입력하셨습니다.", "", 6 )
			nFlag = 0
			Exit Function
		else
			Form.MsgBox( "안내", "휴대폰 전화번호 정보가 일치하지 않습니다.", "", 6 )
			nFlag = 0
			Exit Function
		end if
	end if
	
	if ChkButton4.checkstate == "1" then
		if EditEmail.caption = sTempEmail[0] then
			nFlag = nFlag + 1
		elseif EditEmail.caption = "" then
			Form.MsgBox( "안내", "E-mail 정보를 미입력하셨습니다.", "", 6 )
			nFlag = 0
			Exit Function
		else 
			Form.MsgBox( "안내", "E-mail 정보가 일치하지 않습니다.", "", 6 )
			nFlag = 0
			Exit Function
		end if
	end if
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================

'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData( "obcsb_acad_002r" ) '고객정보조회
	
	g_sUserID = Form.GetSharedData("CERT_ID" , false)
	
	if g_sUserID == "" then
		LabelID.visible = True
		EditID.visible = False
		ChkButton0.enable = False
	else
		LabelID.visible = False
		EditID.visible = True
		ChkButton0.enable = True
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	sACNO = Form.GetSharedData("CERT_ACNO" , false)
	sACNO_PWD = Form.GetSharedData("CERT_ACNT_PWD" , false)
	
	if szTranID == "obcsb_acad_002r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "PWD"  , 0 , sACNO_PWD )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	nCnt = DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock1" )
		
		if nCnt > 0 then
			for i = 0 to nCnt-1
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_TYPE_CODE" , i )
				
				if sINAG_TYPE_CODE == "21" then 'E-mail
					sEmail = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "EMAIL_ADDR" , i )
						if sEmail == null or Trim(sEmail) == "" then
							EditEmail.visible = false
							LabelEmail.visible = True
							ChkButton4.enable = false
							LabelEmailInsert.visible = False
						else
							LabelEmail.visible = False
							EditEmail.visible = True
							ChkButton4.enable = True
							sTempEmail = Split(sEmail, "@")
							temp = "@"..sTempEmail[1]
							LabelEmailInsert.caption = temp
						end if
				end if
			next
		end if

	nCnt = DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock3" )
		
		if nCnt > 0 then
			for i = 0 to nCnt-1
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_TYPE_CODE" , i )
				
				if sINAG_TYPE_CODE == "11" then '자택전화번호
					
					sArCd  = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
					sToNo  = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
					sTelNo = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
					
					if sArCd == null or Trim(sArCd) == "" or sToNo == null or Trim(sToNo) == ""then
						Edit0.visible = false
						Edit1.visible = false
						Edit2.visible = false
						LabelHome.visible = True
						ChkButton1.enable = false
					else
						Edit0.caption = sArCd
						Edit1.caption = GetMaskNumber(sToNo)
						Edit0.enable = false
						Edit1.enable = false
						Edit0.visible = True
						Edit1.visible = True
						Edit2.visible = True
						ChkButton1.enable = True
						LabelHome.visible = False
					end if
					
				elseif sINAG_TYPE_CODE == "12" then '직장번호
					
					sArCd3  = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
					sToNo3  = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
					sTelNo3 = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
					
					if sArCd3 == null or Trim(sArCd3) == "" or sToNo3 == null or Trim(sToNo3) == ""then
						Edit6.visible = false
						Edit7.visible = false
						Edit8.visible = false
						LabelCompany.visible = True
						ChkButton2.enable = false
					else
						Edit6.caption = sArCd3
						Edit7.caption = GetMaskNumber(sToNo3)
						Edit6.enable = false
						Edit7.enable = false
						Edit6.visible = True
						Edit7.visible = True
						Edit8.visible = True
						ChkButton2.enable = True
						LabelCompany.visible = False
					end if
					
				elseif sINAG_TYPE_CODE == "13" then '휴대폰번호
					
					sArCd2  = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
					sToNo2  = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
					sTelNo2 = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
					
					if sArCd2 == null or Trim(sArCd2) == "" or sToNo2 == null or Trim(sToNo2) == ""then
						Edit3.visible = false
						Edit4.visible = false
						Edit5.visible = false
						LabelPhone.visible = True
						ChkButton3.enable = false
					else
						Edit3.caption = sArCd2
						Edit4.caption = GetMaskNumber(sToNo2)
						Edit3.enable = false
						Edit4.enable = false
						Edit3.visible = True
						Edit4.visible = True
						Edit5.visible = True
						ChkButton3.enable = True
						LabelPhone.visible = false
						
					end if
				end if
			next
		end if
		
End Sub

'============================================================================
Sub ChkButton0_OnChange(sCheckState)
	if sCheckState == "0" then
		
		nChkCnt = nChkCnt-1
		
		EditID.enable = False
		EditID.clearall = True
	else
		
		EditID.enable = True
		
		if g_sUserID <> "" then
			nChkCnt = nChkCnt+1
		end if
		
		if nChkCnt > 2 then
			ChkButton0.chksilence = "0"
			EditID.enable = False
			Form.MsgBox( "안내", "본인확인 정보는 2개까지 선택 가능합니다.", "", 6 )
			nChkCnt = 2
		end if
	end if
End Sub

'============================================================================
Sub ChkButton1_OnChange(sCheckState)
	if sCheckState == "0" then
	
		nChkCnt = nChkCnt-1
		
		Edit0.enable = False
		Edit1.enable = False
		Edit2.enable = False
		Edit2.clearall = True
	else
		
		Edit2.enable = True
		
		if sArCd <> null or Trim(sArCd) <> "" or sToNo <> null or Trim(sToNo) <> ""then
			nChkCnt = nChkCnt+1
		end if
		
		if nChkCnt > 2 then
			Form.MsgBox( "안내", "본인확인 정보는 2개까지 선택 가능합니다.", "", 6 )
			ChkButton1.chksilence = "0"
			Edit2.enable = False
			nChkCnt = 2	
		end if
	end if
End Sub

'============================================================================
Sub ChkButton2_OnChange(sCheckState)
	if sCheckState == "0" then
		
		nChkCnt = nChkCnt-1

		Edit6.enable = False
		Edit7.enable = False
		Edit8.enable = False
		Edit8.clearall = True
	
	else
		Edit8.enable = True
		
		if sArCd3 <> null or Trim(sArCd3) <> "" or sToNo3 <> null or Trim(sToNo3) <> ""then
			nChkCnt = nChkCnt+1	
		end if
		
		if nChkCnt > 2 then
			Form.MsgBox( "안내", "본인확인 정보는 2개까지 선택 가능합니다.", "", 6 )
			ChkButton2.chksilence = "0"
			Edit8.enable = False
			nChkCnt = 2
		end if
	end if
End Sub

'============================================================================
Sub ChkButton3_OnChange(sCheckState)
	if sCheckState == "0" then
		
		nChkCnt = nChkCnt-1
		
		Edit3.enable = False
		Edit4.enable = False
		Edit5.enable = False
		Edit5.clearall = True
	else
		
		Edit5.enable = True
		
		if sArCd2 <> null or Trim(sArCd2) <> "" or sToNo2 <> null or Trim(sToNo2) <> ""then
			nChkCnt = nChkCnt+1
		end if
		
		if nChkCnt > 2 then
			Form.MsgBox( "안내", "본인확인 정보는 2개까지 선택 가능합니다.", "", 6 )
			ChkButton3.chksilence = "0"
			Edit5.enable = False
			nChkCnt = 2
		end if
	end if
End Sub

'============================================================================
Sub ChkButton4_OnChange(sCheckState)
	if sCheckState == "0" then
		
		nChkCnt = nChkCnt-1
	
		EditEmail.enable = False
		EditEmail.clearall = True
	else
		EditEmail.enable = True
		
		if sEmail <> null or Trim(sEmail) <> "" then
			nChkCnt = nChkCnt+1
		end if
		
		if nChkCnt > 2 then
			Form.MsgBox( "안내", "본인확인 정보는 2개까지 선택 가능합니다.", "", 6 )
			ChkButton4.chksilence = "0"
			EditEmail.enable = False
			nChkCnt = 2
		end if
	end if
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	
	if nChkCnt = 2 then	
		
		InfoCheck()
		
		if nFlag = 2 then
			'다음 단계로 이동
			g_sRetData = "ok"
			Form.CloseForm()
			Form.SendReturnToParent("mhetc90060_opt_success" , g_sRetData )
		else
			nFlag = 0
		end if
		
	elseif nChkCnt = 1 then
		Form.MsgBox( "안내", "본인확인 정보를 1개 체크하셨습니다.", "", 6 )
	elseif nChkCnt = 0 then
		Form.MsgBox( "안내", "본인확인 정보를 0개 체크하셨습니다.", "", 6 )
	end if
	
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm()
End Sub

