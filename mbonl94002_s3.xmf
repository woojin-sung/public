'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCustNum
	szCustNum = Form.GetSharedData("&CUST_NUM", false )

	if szTranID == "obcsb_acif_091r" then
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "P"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0 , szCustNum  )
	
	'v0001 STA
	elseif szTranID == "obcsb_acif_115r" then
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" 	 , 0 , szCustNum    )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "APLT_DATE"	 , 0 , g_szAplyDate )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "APLT_SRNO"	 , 0 , g_szAplyNum  )	
	'v0001 FIN
	
	elseif szTranID == "obcsb_acif_093a" then
		Dim szHometax
		szHometax = Trim(Container0.Tab0.page1.edtHometax1.caption) & Trim(Container0.Tab0.page1.edtHometax2.caption) &  Trim(Container0.Tab0.page1.edtHometax3.caption) &  Trim(Container0.Tab0.page1.edtHometax4.caption)
	
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0 , szCustNum  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "APLT_DATE" , 0 , g_szAplyDate  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "APLT_SRNO" , 0 , g_szAplyNum  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "INVT_EXPC_ATCH_YN" , 0 , "Y"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "INCM_SLCT_YN" , 0 , "Y"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "SPCL_SLCT_YN" , 0 , "N"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "NTAS_SLCT_YN" , 0 , "N"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CRIN_AGRM_YN" , 0 , "Y"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "RECDNG_RSLT_CLCD" , 0 , "U"  ) '06.16 권오상 차장님 요청으로 추가
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "IDNTF_SRNO" , 0 , g_szSRNO  ) '06.21 권오상 차장님 요청으로 추가
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ACNO" , 0 , left(Container0.acnt0.caption,8)  ) '20220512 추가요청
	
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock2" , "INCM_SLCT_YN" , 0 , "Y"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock2" , "INCM_SFCN_YN" , 0 , "Y"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock2" , "INCM_AMT" , 0 , Container0.Tab0.page1.edtAmount.caption )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock2" , "SELF_INCM_AMT" , 0 , Container0.Tab0.page1.edtAmount.caption)
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock2" , "MATE_INCM_AMT" , 0 , "0"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock2" , "MATE_ADUP_YN" , 0 , "N"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock2" , "INCM_ATCH_YN" , 0 , ""  )	'2022.04.28 빈값으로 보내도록 변경 지점에서 확인후 Y로 처리 
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock2" , "HMTX_ISNC_NO" , 0 , szHometax  )
'		DATAMANAGER.SetDataValue( false, szTranID , "InBlock2" , "HMTX_ISNC_CLCD" , 0 , tonumber(Container0.Tab0.page1.rdoGubun.currentindex) + 1 ) '0 : 해당없음 / 1 : 종합소득세 신고자용 / 2 : 연말정산 사업소득자용 / 3 : 근로소득자용
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 들어왔을때
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acif_091r" then
		f_SetData(szTranID)
		DATAMANAGER.RequestTranData( "obcsb_acif_115r" )	'v0001 전문투자자 서류등록내역
	
	'v0001 STA
	elseif szTranID == "obcsb_acif_115r" then
		g_szCnshIsncYN = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "CNSH_ISNC_YN" , 0  ) 	'1년이상거래계좌 관련서류등록여부	
		g_szRmndCertIsncYN = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "RMND_CERT_ISNC_YN" , 0  )	'투자경럼 서류등록여부
		
		if Container0.tblExpConfirm.GetCellString(1, 0) <> "충족" Or Container0.tblExpConfirm.GetCellString(1, 2) <> "충족" Then
			Dim bRgst
			bRgst = true
			if g_szCnshIsncYN <> "Y" and g_szRmndCertIsncYN <> "Y" then
				bRgst = false
			end if
			if (Container0.tblExpConfirm.GetCellString(1, 0) == "" or Container0.tblExpConfirm.GetCellString(1, 0) == "미충족") and g_szCnshIsncYN <> "Y" then
				bRgst = false
			end if
			if (Container0.tblExpConfirm.GetCellString(1, 2) == "" or Container0.tblExpConfirm.GetCellString(1, 2) == "미충족") and g_szRmndCertIsncYN <> "Y" then
				bRgst = false
			end if
		
			Container0.chkRgstExp.visible = bRgst
		Else
			'20220519 1.투자경험 요건 확인 2. 소득 요건 확인(홈택스) 사이 간격조정
			Container0.lblLine.top = 227
			Container0.imgQ1.top = 242
			Container0.lblIncomeTitle.top = 243
			Container0.Tab0.top = 268
		end if
	
'		f_ChangeBtnState()
	'v0001 FIN
	
	elseif szTranID == "obcsb_acif_093a" then
		Dim szMsgCode, szMsg
		szMsgCode = DATAMANAGER.GetDataMsgCode( szTranID )
		szMsg = DATAMANAGER.GetDataMsgText( szTranID )
		szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		' 정상처리되었을때는 완료 팝업
		if szMsgCode == "0000" then
			Form.OpenPopup("mbonl94002_p2" , "" , "")
		else
			Form.ShowAlert("알림", szMsg & "(" & szSubMsg & ")")
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 오류
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	if szTranID == "obcsb_acif_091r" then
		Dim szErrorMsg
		szErrorMsg = szErrMsg & "(" & szSubMsg & ")\n업무신청을 중단하시겠습니까?"
		
		Form.OpenPopup("mbonl94002_p3" , szErrorMsg , "")
	
	else
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	end if
End Sub

