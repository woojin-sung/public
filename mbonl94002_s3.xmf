'--===========================================================================
' 01. 화 면 명 : 지정심사신청
' 02. 화면설명 : 자격요건확인
' 03. 작    성 : 
' 04. 수    정 : 
' 2022.04.14 : v0001 : KSJ : 신분증 등록 및 진위확인 개선
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAplyDate, g_szAplyNum, g_szPrgsCode
Dim g_szSRNO '신분증 진위 확인 후, 받은 일련번호

Dim g_OSType

' 21.07.02 JHY : 컴플리트랑 같이 스크롤포스 조절되서 안먹도록 하기 위해 현재 포커싱 에디트와 이전 포커싱 에디트 비교하여 왓다갓다 하지 않도록 수정
Dim g_szCurKeyPad 
Dim g_szPreKeyPad

'v0001 STA
Dim g_szCnshIsncYN		'1년이상거래계좌 관련서류등록여부	
Dim g_szRmndCertIsncYN		'투자경럼 서류등록여부
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_ChangeBtnState() : 입력 조건 확인 후, 버튼 활성/비활성
'============================================================================
Function f_ChangeBtnState()
	Dim isAble
	
	isAble = true

	'v0001 STA
	if (Container0.edtPswd.caption == "" or Container0.edtPswd.caption == null) then
		isAble = false
	end if
	
	'타사 투자경험 등록한 경우 투자경험 요건 확인 체크 PASS
	if (Container0.tblExpConfirm.GetCellString(1, 0) == "" or Container0.tblExpConfirm.GetCellString(1, 0) == "미충족") and g_szCnshIsncYN <> "Y" then
		isAble = false
	end if
	if (Container0.tblExpConfirm.GetCellString(1, 2) == "" or Container0.tblExpConfirm.GetCellString(1, 2) == "미충족") and g_szRmndCertIsncYN <> "Y" then
		isAble = false
	end if

	if Container0.Tab0.page1.tblIncome.GetCellString(3, 2) == "" or Container0.Tab0.page1.tblIncome.GetCellString(3, 2) == "미충족" then
		isAble = false
	end if
	
	if Container0.acnt0.caption == "" and  Container0.acnt0.caption == null then
		isAble = false
	end if
	'v0001 FIN

	' 22.05.13 KSJ : 소득구분 삭제(현업요청)
	' 21.06.18 JHY : 소득구분, 홈택스 발급번호, 연소득 금액 모두 필수 입력 체크 (06.18 권오상 차장님 확인)
'	if tonumber(Container0.Tab0.page1.rdoGubun.currentindex) == -1 then
'		isAble = false
'	end if

	if Container0.Tab0.page1.edtHometax1.caption == "" or Len(Container0.Tab0.page1.edtHometax1.caption) < 4 then
		isAble = false
	elseif Container0.Tab0.page1.edtHometax2.caption == "" or Len(Container0.Tab0.page1.edtHometax2.caption) < 3 then
		isAble = false
	elseif Container0.Tab0.page1.edtHometax3.caption == "" or Len(Container0.Tab0.page1.edtHometax3.caption) < 4 then
		isAble = false
	elseif Container0.Tab0.page1.edtHometax4.caption == "" or Len(Container0.Tab0.page1.edtHometax4.caption) < 3 then
		isAble = false
	end if
	
	if g_szPrgsCode <> "" and g_szPrgsCode <> null then
		if g_szPrgsCode == "0" then
			if isAble == true then
				Form.triggerEvent("#", "BTN_NEXT_ENABLE_STATE", true)
			
			else
				Form.triggerEvent("#", "BTN_NEXT_ENABLE_STATE", false)
			end if
	
		else
			Form.triggerEvent("#", "BTN_NEXT_ENABLE_STATE", false)
			
	'		Container0.Tab0.page1.rdoGubun.enable = false
			Container0.Tab0.page1.edtHometax1.enable = false
			Container0.Tab0.page1.edtHometax2.enable = false
			Container0.Tab0.page1.edtHometax3.enable = false
			Container0.Tab0.page1.edtHometax4.enable = false
			
			Container0.Tab0.page1.edtAmount.enable = false
		end if
	end if
End Function

'============================================================================
' f_SetData(szTranID) : 데이터 확인 후, 버튼 활성/비활성 처리
'============================================================================
Function f_SetData(szTranID)
	Dim szAccYear, szAvgAmount, szIncomeAmt, szHometax, szHometaxGubun
	
	g_szAplyDate  = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "APLT_DATE" , 0  ) '신청일자
	g_szAplyNum  = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "APLT_SRNO" , 0  ) '신청일련번호
	g_szPrgsCode  = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "EXAM_PRGS_STAT_CODE" , 0  ) '심사진행상태코드
	
	szAccYear = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "INVT_EXPC_PRD_YEAR" , 0  )
	szAvgAmount = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock2" , "INVT_EXPC_AVRG_AMT" , 0  )
	
	szIncomeAmt = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock3" , "SELF_INCM_AMT" , 0  )
	szHometax = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock3" , "HMTX_ISNC_NO" , 0  )
	
	'2022.05.13 : 소득구분 삭제 (현업요청)
'	szHometaxGubun = DATAMANAGER.GetDataValue( false, szTranID , "OutBlock3" , "HMTX_ISNC_CLCD" , 0  )

	'소득구분
	'0 : 해당없음 / 1 : 종합소득세 신고자용 / 2 : 연말정산 사업소득자용 / 3 : 근로소득자용
'	if tonumber(szHometaxGubun) <> NULL then
'		if 0 <= tonumber(szHometaxGubun) and tonumber(szHometaxGubun) <= 3 then
'			Container0.Tab0.page1.rdoGubun.currentindex = tonumber(szHometaxGubun) - 1
'		end if
'	end if

	'v0001 STA
	' 금융거래 계좌 1년이상 보유 여부
	if tonumber(szAccYear) <> NULL then
		if tonumber(szAccYear) >= 1 then
			Container0.tblExpConfirm.SetCellString(1, 0, "충족")
			Container0.tblExpConfirm.SetCellFgColor(1, 0, "11")
		else
			Container0.tblExpConfirm.SetCellString(1, 0, "미충족")
			Container0.tblExpConfirm.SetCellFgColor(1, 0, "10")
		end if
		
	else
		Container0.tblExpConfirm.SetCellString(1, 0, "미충족")
		Container0.tblExpConfirm.SetCellFgColor(1, 0, "10")
	end if
	
	' 투자 경험
	Container0.tblExpConfirm.SetCellString(2, 2, szAvgAmount)
	
	if tonumber(szAvgAmount) <> NULL then
		if tonumber(szAvgAmount) >= 50000000 then
			Container0.tblExpConfirm.SetCellString(1, 2, "충족")
			Container0.tblExpConfirm.SetCellFgColor(1, 2, "11")
		else
			Container0.tblExpConfirm.SetCellString(1, 2, "미충족")
			Container0.tblExpConfirm.SetCellFgColor(1, 2, "10")
		end if
		
	else
		Container0.tblExpConfirm.SetCellString(1, 2, "미충족")
		Container0.tblExpConfirm.SetCellFgColor(1, 2, "10")
	end if

	'2022.05.13 STA 모두 충족인경우 타사경험 등록 visible > false
	if tonumber(szAvgAmount) >= 50000000 and tonumber(szAccYear) >= 1 then
		'버튼으로 이미지 표현이 안되 이미지 및 라벨로 처리
'		Container0.btnExpRgst.visible = false
		Container0.lblExpRgst.visible = false
		Container0.imgExpRgst.visible = false
		
		Container0.chkRgstExp.visible = false
	Else
		'버튼으로 이미지 표현이 안되 이미지 및 라벨로 처리
'		Container0.btnExpRgst.visible = true
		Container0.lblExpRgst.visible = true
		Container0.imgExpRgst.visible = true
	end if
	'2022.05.13 FIN

	' 소득 요건(홈택스)
	if szHometax <> "" then
		Container0.Tab0.page1.edtHometax1.caption = Mid(szHometax, 1, 4)
		Container0.Tab0.page1.edtHometax2.caption = Mid(szHometax, 5, 3)
		Container0.Tab0.page1.edtHometax3.caption = Mid(szHometax, 8, 4)
		Container0.Tab0.page1.edtHometax4.caption = Mid(szHometax, 12, 3)
	end if
	
	
	'v0001 20220518 해당값 안내려옴 확인 (노민아 과장님)
'	Container0.Tab0.page1.edtAmount.caption = szIncomeAmt
'	if tonumber(szIncomeAmt) <> NULL then
'		if tonumber(szIncomeAmt) >= 100000000 then
'			Container0.Tab0.page1.tblIncome.SetCellString(3, 2, "충족")
'			Container0.Tab0.page1.tblIncome.SetCellFgColor(3, 2, "11")
'			Container0.Tab0.page1.tblIncome.SetCellFgColor(4, 0, "62")
'		else
'			Container0.Tab0.page1.tblIncome.SetCellString(3, 2, "미충족")
'			Container0.Tab0.page1.tblIncome.SetCellFgColor(3, 2, "10")
'			Container0.Tab0.page1.tblIncome.SetCellFgColor(4, 0, "10")
'		end if
'	else
'		Container0.Tab0.page1.tblIncome.SetCellString(3, 2, "")
'		Container0.Tab0.page1.tblIncome.SetCellFgColor(4, 0, "62")
'	end if
	'v0001 FIN
	f_ChangeBtnState()
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()			
	Dim szTheme
	szTheme = Form.GetEnvData("common.theme")

'	if szTheme == "white" then
'		Container0.imgProcess.imgpath = "icon_3stepthird_w"
'	else
'		Container0.imgProcess.imgpath = "icon_3stepthird_b"
'	end if
	
	g_OSType	= Form.GetSharedData("&OS_TYPE", false)
	
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	
	'v0001 STA 2022.04.20 IOS 에디트 이미지 이슈 > 영향 최소화로 IOS일 경우에만 적용
	Dim szOSType
	szOsType = Form.GetSharedData( "&OS_TYPE", False )'1.안드로이드 2.iOS
	If szOsType == "2" Then
		'select/normal 이미지 설정
		Container0.Tab0.page1.edtHometax1.SetOnOffImage("input_03_o.9.png","input_03_n.9.png")	
		Container0.Tab0.page1.edtHometax2.SetOnOffImage("input_03_o.9.png","input_03_n.9.png")
		Container0.Tab0.page1.edtHometax3.SetOnOffImage("input_03_o.9.png","input_03_n.9.png")
		Container0.Tab0.page1.edtHometax4.SetOnOffImage("input_03_o.9.png","input_03_n.9.png")
		Container0.Tab0.page1.edtAmount.SetOnOffImage("input_03_o.9.png","input_03_n.9.png")
		'최초 이미지 설정
		Container0.Tab0.page1.edtHometax1.imagefilepth = "input_03_n.9.png"
		Container0.Tab0.page1.edtHometax2.imagefilepth = "input_03_n.9.png"
		Container0.Tab0.page1.edtHometax3.imagefilepth = "input_03_n.9.png"
		Container0.Tab0.page1.edtHometax4.imagefilepth = "input_03_n.9.png"
		Container0.Tab0.page1.edtAmount.imagefilepth = "input_03_n.9.png"
	End If

	'20220512 KSJ 추가
'	Dim szBrcd
'	szBrcd = Form.GetAccountInfo( Container0.acnt0.caption, "branchcode")
'	Container0.lblbrNm.caption = " "..Form.GetMetaData( "부서코드", szBrcd )
	'v0001 FIN
End Sub

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "request_submit_TR" then
		g_szSRNO = sParam
		
		'v0001 STA
		'20220518 KSJ 인증서확인 로직 추가 > 인증완료후 신청 서비스 호출
		Dim szCertUseType 
		'0.공인인증서(ID로그인,인증서로그인) 1.간편인증(공인인증서) 2.코스콤지문(공인인증서) 3.결제원(FIDO인증서) 4.금투협(공동인증서)
		szCertUseType = Form.GetSharedData("&CERT_USE_TYPE", false )  '로그인타입
		
		If szCertUseType == "1" Or szCertUseType == 1 Then '간편인증
		    Form.OpenFramePopup( "mhetc90060_px" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		Else
		    Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업
		End If
		'v0001 FIN
	
	elseif sEventName == "change_step3" then
		g_szSRNO = "" '초기화
		'v0001 STA
		g_szCnshIsncYN = "" '
		g_szRmndCertIsncYN = "" '
		'v0001 FIN	
		
		'계좌비밀번호가 저장되어 있다면 조회
		Dim szPwd
		szPwd = Container0.edtPswd.caption
		If szPwd <> "" and szPwd <> null then
			'20220523 LJH 센터 표기를 계좌비밀번호 입력 시점으로 변경
			Dim szBrcd
			szBrcd = Form.GetAccountInfo( Container0.acnt0.caption, "branchcode")
			Container0.lblbrNm.caption = Form.GetMetaData( "부서코드", szBrcd )
		
			DATAMANAGER.RequestTranData( "obcsb_acif_091r" )
		End If
	end if
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "close_mbonl94002_p2" then
		Form.triggerEvent("#", "COMPLETE_SUBMIT", "")
	
	'v0001 STA
	elseif sKeyName == "close_mbonl94002_p31" Then
		DATAMANAGER.RequestTranData( "obcsb_acif_115r" )	'전문투자자 서류등록내역	

	'20220518 KSJ 인증후 신청TR 호출
	'==[인증팝업]==
	'공동인증및바이오인증
	Elseif sKeyName == "mhetc90060_p5" Then 
		If sRet ~= "cancel" Then
			DATAMANAGER.RequestTranData( "obcsb_acif_093a" )
		End If
	'간편인증전용
	ElseIf sKeyName == "mhetc90060_px" Then 
		If sRet == "ok" Then
			DATAMANAGER.RequestTranData( "obcsb_acif_093a" )
		End If
	End If
	'v0001 Fin
End Sub

'============================================================================
' Container0_Tab0_page1_edtAmount_OnEditComplete()
'============================================================================
Sub Container0_Tab0_page1_edtAmount_OnEditComplete()
	'v0001 STA
	if Container0.Tab0.page1.edtAmount.caption <> "" then
		if tonumber(Container0.Tab0.page1.edtAmount.caption) >= 100000000 then
			Container0.Tab0.page1.tblIncome.SetCellString(3, 2, "충족") 
			Container0.Tab0.page1.tblIncome.SetCellFgColor(3, 2, "11")
			Container0.Tab0.page1.tblIncome.SetCellFgColor(4, 0, "62")
		else
			Container0.Tab0.page1.tblIncome.SetCellString(3, 2, "미충족")
			Container0.Tab0.page1.tblIncome.SetCellFgColor(3, 2, "10")
			Container0.Tab0.page1.tblIncome.SetCellFgColor(4, 0, "10")
		end if
	end if
	'v0001 FIN
	
	f_ChangeBtnState()
	
	g_szPreKeyPad = "edtAmount"

	if g_OSType <> "1" and g_szPreKeyPad == g_szCurKeyPad then
		Container0.lblScrollPos.top = 0
		Container0.SetScrollAutoSize()
		Container0.scroll_pos = 0
	end if
End Sub

