	<SCRIPT_INFO _len="1170" _ulen="1086" >
'***************************************************
'               전역 변수
'***************************************************
Dim g_szTitle

'***************************************************
'               공용 함수
'***************************************************
'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	call Init_Control("1")    ' Personal Function 호출시 call 붙여준다.
End Sub

'***************************************************
'               개별 함수
'***************************************************
'===============================================
' Init_Control(szCbn) 
'===============================================
Function Init_Control(szCbn) --> 리턴과 상관없이 Function으로 정의한다.
	lblTopDivider.bgcolor = 320
	
	imgBell.singleimage = "tax365_icon_alarm.png"
	imgBell.setMaintainingRatio("1")
	
	'글자 여백 삭제
	lblTitle.paddinginfo = "0,0,0,0"
	
	'종 이미지
	imgBell.setMaintainingRatio("1")
	imgBell.imgpath = "tax365_icon_alarm.png"
End Function


	</SCRIPT_INFO>
