				<LABEL name="LblQ13A4" caption="원금기준 ±100% 범위" valign="0" multiline="1" ly_vert="40,3139,315,32,1" />
				<LABEL name="LblQ13A5" caption="원금 초과이익(또는 초과손실) 범위" valign="0" multiline="1" ly_vert="40,3174,315,32,1" />
				<BUTTON name="BtnQ13A1" btnimage="alpha" ly_vert="14,3030,346,36,1" />
