						<CELL cell_ly="0,0,0,0" fgcolor="065:102102102" valign="0" halign="0" line="0,0" caption="당일진단 회차 :" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" valign="0" halign="0" line="0,0" fontstyle="01" impidxs="" />
