				<LABEL name="Label3" bgcolor="000:246247248" transmode="0" ly_vert="0,616,375,10,1" />
				<LABEL name="Label4" bgcolor="000:246247248" transmode="0" ly_vert="0,891,375,10,1" />
				<LABEL name="Label5" bgcolor="000:246247248" transmode="0" ly_vert="0,1143,375,10,1" />
				<LABEL name="Label6" bgcolor="000:246247248" transmode="0" ly_vert="0,1398,375,10,1" />
				<LABEL name="Label7" bgcolor="000:246247248" transmode="0" ly_vert="0,1652,375,10,1" />
				<LABEL name="Label8" bgcolor="000:246247248" transmode="0" ly_vert="0,2017,375,10,1" />
				<LABEL name="Label9" bgcolor="000:246247248" transmode="0" ly_vert="0,2219,375,10,1" />
				<LABEL name="Label10" bgcolor="000:246247248" transmode="0" ly_vert="0,2440,375,10,1" />
				<LABEL name="Label11" bgcolor="000:246247248" transmode="0" ly_vert="0,2728,375,10,1" />
				<LABEL name="Label12" bgcolor="000:246247248" transmode="0" ly_vert="0,2960,375,10,1" />
				<LABEL name="Label13" bgcolor="000:246247248" transmode="0" ly_vert="0,3218,375,10,1" />
