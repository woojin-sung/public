'============================================================================
Sub Common_Check()
    '21.09.01 JHY START: 기존 UnCheck 이미지로 초기화하는 부분 소스코드 줄임
    Dim nQCnt, nAnswerCnt, nQNum ' 문항, 문항당 답변 수, 문항번호
    
    if g_tQuestion <> NULL then
	    nQCnt = Ubound(g_tQuestion)
	    
	    for i = 0 to CDbl(nQCnt)
		    if g_tQuestion [i] == NULL then
			    BtnCnfr.enable = False
			    BtnCnfr.fgcolor = "269"
			    szTheme = Form.GetEnvData("common.theme")
			    If szTheme == "white" Then
				    BtnCnfr.btnimage = "btn_21.9"
			    Else
				    BtnCnfr.btnimage = "btn_27.9"
			    End If
			    
			    return false
		    else
			    if i == 7 then ' 8번 문항 (복수 응답 가능) (테이블은 0부터 인덱스 시작)
				    Dim nChkCnt
				    nChkCnt = 0
				    
				    for j = 1 to 5
					    Dim szChkState
					    szChkState = Form.GetCtlProp("Container.ChkQ" & (i+1) & "A" & j, "checkstate")
					    
					    if CDbl(szChkState) == 1 then
						    nChkCnt = nChkCnt + 1
					    end if
				    next
 
				    ' 체크박스가 하나도 선택되지 않았으면 문항 대답 안한것
				    if nChkCnt == 0 then
					    BtnCnfr.enable = False
					    BtnCnfr.fgcolor = "269"
					    szTheme = Form.GetEnvData("common.theme")
					    If szTheme == "white" Then
						    BtnCnfr.btnimage = "btn_21.9"
					    Else
						    BtnCnfr.btnimage = "btn_27.9"
					    End If
					    
					    return false
				    end if
			    
			    else			    
				    if g_tQuestion[i] == "" or CDbl(g_tQuestion [i]) == 0 then
					    BtnCnfr.enable = False
					    BtnCnfr.fgcolor = "269"
					    szTheme = Form.GetEnvData("common.theme")
					    If szTheme == "white" Then
						    BtnCnfr.btnimage = "btn_21.9"
					    Else
						    BtnCnfr.btnimage = "btn_27.9"
					    End If
					    
					    return false
				    end if
			    end if
		    end if
	    next
    end if
    '21.09.01 JHY END
    
    BtnCnfr.enable = True
    BtnCnfr.btnimage = "btn_20.9"
    BtnCnfr.fgcolor = "273"
    
    return true
End Sub

'============================================================================
Function Set_Reg_Data()
    Dim nDataCnt
    nDataCnt = CDbl(DATAMANAGER.GetDataCount(0, "obcsb_acif_701r", "OutBlock2")) -1

	Dim nQNum, nTIdx, szAnswerNum, szRspnYN

	For  i = 0 to nDataCnt
		nQNum			= CDbl(DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock2", "QUES_QSIT_NO", i))
		szAnswerNum		= DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock2", "ITEM_NO_VAL" , i)
		szRspnYN			= DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock2", "RSPN_SLCT_YN" , i)  '1.Y
		if nQNum > 0 then
			if CDbl(szRspnYN) == 1 then
				nTIdx = nQNum - 1
			
				if g_tQuestion <> NULL then
					if g_tQuestion[nTIdx] <> NULL then						
						SetCheckAnswer(nQNum, szAnswerNum) '이미지 체크
					end if
				end if
			end if
		end if
	next
End Function

'============================================================================
Function Set712Input()
	' PASS 일 경우, 인블럭에 미리 담아두는데, 고객이 체크 갯수를 바꾸면 이전에 저장된 인블럭과 새로 입력된게 맞물릴수 있어서 인풋값 초기화
    DATAMANAGER.ClearInputData( 0,"obcsb_acif_712a" )
    
    '기존과 동일한 경우, 기등록된 정보로 설정
    If g_ProsGb == "PASS" Then
	    '기등록된 정보 Set
	    Set_Reg_Data()
    end if
    
    '21.09.01 JHY START: 기존 하나하나 분기타던 부분 테이블에 저장함으로 소스코드 간소화
    Dim nQCnt, szAnswer ' 문항 수, 답변번호
    Dim nIndex ' 인풋값 배열 인덱스
    
    nIndex = 0
    
    nQCnt = Ubound(g_tQuestion)
 
    for i = 0 to CDbl(nQCnt)
	    if i == 7 then ' 8번 문항 (복수 응답 가능) (테이블은 0부터 인덱스 시작)
		    for j = 1 to 5
			    Dim szChkState
			    szChkState = Form.GetCtlProp("Container.ChkQ" & (i+1) & "A" & j, "checkstate")
			    
			    ' 체크가 되어있는 응답 항목들 인블럭에 추가
			    if CDbl(szChkState) == 1 then
				    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock2", "QUES_QSIT_NO", nIndex , i+1) 
				    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock2", "ITEM_NO_VAL" , nIndex , j)
				    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock2", "RSPN_SLCT_YN", nIndex , "Y")
				    
				    nIndex = nIndex + 1

			    end if
		    next
	    else ' 복수 응답 불가 문항들
		    if g_tQuestion[i] == NULL then
			    szAnswer = ""
		    else
			    szAnswer = g_tQuestion[i]
		    end if

		    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock2", "QUES_QSIT_NO", nIndex , i+1) 
		    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock2", "ITEM_NO_VAL" , nIndex , szAnswer)
		    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock2", "RSPN_SLCT_YN", nIndex , "Y")

		    nIndex = nIndex + 1
	    end if
    next
    '21.09.01 JHY END    

    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CONT_CLS_CODE" , 0 , "6")
    
    If g_GRADE_CUST == "00" Or g_GRADE_CUST == "" Or g_GRADE_CUST == NULL Then '기존 투자성향진단내역이 없으면
	    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
    Else'기존 투자성향진단내역이 있으면
	    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "PROS_CLS_CODE" , 0 , "2" )
    End If
    
    'v0001 투자권유불원여부 정보관리를 위해 RCNO에 처리점정보 매핑
    '처리점: 종합개설시 개설하려는 관리점/개별추가시 선택한 종합계좌의 관리점
    
    'v0003 비밀번호를 넘겨야 하므로 비대면으로 처리하도록 함
'    if g_BDM_YN == "N" then
'	    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "ACNO"                   , 0 , g_ACNO)
'	    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "RCNO_PIP"               , 0 , g_RCNO_PIP)    
'    else
	    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "RCNO"                   , 0 , "NMET"..g_BDM_MANG_BRCD) '비대면 
	    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "RCNO_PIP"               , 0 , g_RCNO_PIP)    
	    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "RCNO_TYPE_CODE"         , 0 , "01")
'    end if
    
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CSNO"                   , 0 , g_CSNO) 
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CUST_CLS_CODE"          , 0 , "1") '개인
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CUST_FULL_NAME"         , 0 , g_CUST_FULL_NAME)
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "PXPR_RCNO_TYPE_CODE"    , 0 , g_PXPR_RCNO_TYPE_CODE)
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "PXPR_RCNO"              , 0 , g_PXPR_RCNO)
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "PXPR_NAME"              , 0 , g_PXPR_NAME)
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CUST_RLTS_CODE"         , 0 , g_CUST_RLTS_CODE)
    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "CUST_RLTS_ETC_CNTT"     , 0 , g_CUST_RLTS_ETC_CNTT)
    
    If g_RCMD_YN == "Y" Then
	    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0 , "1") '투자권유희망
    ElseIf g_RCMD_YN <> "Y" And g_INFO_OFER_YN == "Y" Then
	    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0 , "3") '투자권유불원(정보제공)
    ElseIf g_RCMD_YN <> "Y" And g_INFO_OFER_YN <> "Y" Then 
	    DATAMANAGER.SetDataValue(0,"obcsb_acif_712a", "InBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0 , "4") '투자권유불원(정보미제공)
    End If
    
    g_ProsGb = ""
    return True
    
End Function

'============================================================================
Sub BtnCnfr_OnClick()
    If Set712Input() == True Then    
        '21.09.13 JHY START : 2회차부터 재진단 사유 표기
		if 3 < g_nTryCnt then
			Form.ShowAlert(g_szAlertTitle, "투자성향진단 등록은 1일 3회까지만 가능합니다 (등록횟수 초과)")
		else
			if 1 < g_nTryCnt then
				Form.OpenPopup("mbonl81010_p15" , "" , "")
			else
				BtnCnfr.enable = false
				If Form.GetEnvData("common.theme") = "black" Then
					BtnCnfr.btnimage = "btn_27.9"
				Else 
					BtnCnfr.btnimage = "btn_21.9"
				End If
				BtnCnfr.fgcolor = "269"	
				
			    DATAMANAGER.RequestTranData("obcsb_acif_712a")
		    end if
	    end if
	    '21.09.13 JHY END
	End If
End Sub
 
'============================================================================
Sub Image2_OnClick()
    Form.SendReturnToParent("MBBDM86172", "")  '그냥종료
    Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
    Image2_OnClick()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
    '등록 완료 화면 리턴
    If sKeyName == "MBBDM86173" then
		'v0003
		If g_arrUnfiCnt > 0 Then
			Form.SetSharedData("APRT_CSNM"		, g_CUST_FULL_NAME)
			Form.SetSharedData("APRT_CUST_GRAD"	, g_CsKYCGrad)
			Form.OpenPopup("mbonl81010_unfit1", g_arrUnfiData, "")
		Else
			Form.SendReturnToParent("MBBDM86172", sRet)
			Form.CloseForm()
		End If
    End If
    
    'V0003
    If sKeyName = "mbonl81010_unfit1" Then
		If g_arrAnxtCnt > 0 Then
			Form.SetSharedData("APRT_CSNM"		, g_CUST_FULL_NAME)
			Form.SetSharedData("APRT_CUST_GRAD"	, g_CsKYCGrad)
			Form.OpenPopup("mbonl81010_aprt1", g_arrAnxtData, "")
		Else
			Form.SendReturnToParent("MBBDM86172", sRet)
			Form.CloseForm()
		End If
    End If
    
    'V0003
    If sKeyName = "mbonl81010_aprt1" Then
		Form.SendReturnToParent("MBBDM86172", sRet)
		Form.CloseForm()
    End If
    
    '투자성향진단 재진단 사유 입력 완료
    if sKeyName == "close_mbonl81010_p15" then
	    if sRet <> "" then
		    DATAMANAGER.ClearInputData(0, "obcsb_acif_712a")
		    Set712Input("obcsb_acif_712a")
		    
		    ' 재진단 사유는 여기서 넣어줌
		    Dim tReason
		    tReason = split(sRet, "★")
		    
		    if tReason <> "" and tReason <> NULL then
			    if tReason[0] <> NULL and tReason[0] <> "" then
				    DATAMANAGER.SetDataValue( 0, "obcsb_acif_712a", "InBlock1", "KYC_REREG_REAS_CODE" , 0 , tReason[0])
			    end if
			    
			    if tReason[1] <> NULL and tReason[1] <> "" then
				    DATAMANAGER.SetDataValue( 0, "obcsb_acif_712a", "InBlock1", "KYC_REREG_REAS" , 0 , tReason[1])
			    end if
		    end if
		    
		    DATAMANAGER.RequestTranData("obcsb_acif_712a")
		else
			BtnCnfr.enable = true
	
			BtnCnfr.btnimage = "btn_20.9"
			BtnCnfr.fgcolor = "273"			
		end if
	end if
End Sub

'============================================================================
' 21.09.01 JHY 추가
' SetCheckAnswer(szQNum, szAnswerNum) : 선택한 문항 테이블에 저장하는 함수
' ( 체크 이미지 변경 및 해당 문항으로 포커스 이동 및 사용자가 선택한 답변 테이블에 저장 )
'============================================================================
Function SetCheckAnswer(szQNum, szAnswerNum)
	Dim nQNum, nTIdx ' 문항번호, 테이블 인덱스
	nQNum = CDbl(szQNum)
	nTIdx = nQNum - 1
	
	nAnswerCnt = g_tAnswerCnt[nTIdx]
	
	' 사용자가 바꾼 답변 저장
	if g_tQuestion <> NULL then
		if g_tQuestion[nTIdx] <> NULL then						
			g_tQuestion[nTIdx] = szAnswerNum
		end if
	end if
	
	
	Select case nQNum
	    ' 버튼형 답변
	    case 1, 2, 5, 6, 7, 9, 10
		    for j = 1 to CDbl(nAnswerCnt)
			    if j == CDbl(szAnswerNum) then
				    Form.SetCtlProp("Container.ImgQ" & nQNum & "A" & j, "imgpath", PressedImgPath)
			    else
				    Form.SetCtlProp("Container.ImgQ" & nQNum & "A" & j, "imgpath", unPressedImgPath)
			    end if
		    next
	    
		    
	    case 3, 4, 11, 12, 13, 14
		    for j = 1 to CDbl(nAnswerCnt)
			    if j == CDbl(szAnswerNum) then
				    Form.SetCtlProp("Container.ImgQ" & nQNum & "A" & j, "imgpath", CheckImgPath)
			    else
				    Form.SetCtlProp("Container.ImgQ" & nQNum & "A" & j, "imgpath", unCheckImgPath)
			    end if
		    
		    next
		    
	    Case 8 ' 복수 응답 가능 문항
		    for j = 1 to CDbl(nAnswerCnt)
			    if j == CDbl(szAnswerNum) then
				    Dim szChkState
				    szChkState = Form.GetCtlProp("Container.ChkQ" & nQNum & "A" & j, "checkstate")
				    
				    '체크 상태일때는 해제
				    if CDbl(szChkState) == 1 then
					    Form.SetCtlProp("Container.ChkQ" & nQNum & "A" & j, "checkstate", "0")
					    Form.SetCtlProp("Container.ImgQ" & nQNum & "A" & j, "imgpath", unCheckImgPath)
				    else
					    Form.SetCtlProp("Container.ChkQ" & nQNum & "A" & j, "checkstate", "1")
					    Form.SetCtlProp("Container.ImgQ" & nQNum & "A" & j, "imgpath", CheckImgPath)
				    end if
			    end if
		    next
    End Select
    
    Dim tQuestionTop '선택 문항 top으로 옮겨주도록 클릭했을때 이동할 top을 가지고 있는 테이블
    tQuestionTop =  Array("0", "239", "439", "654", "925", "1181", "1434", "1690", "2056", "2256", "2477", "2765", "2960", "2960")
    
    If g_ProsGb <> "PASS" Then
	    if tQuestionTop <> NULL then
		    Dim nScrollPos
		    nScrollPos = CDbl(tQuestionTop[nTIdx])
	    
		    Container.scroll_pos = nScrollPos
	    end if
	End If
	
	Common_Check()
End Function

