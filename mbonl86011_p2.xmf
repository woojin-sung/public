'============================================================================
Sub Button1_OnClick()
	Form.SendReturnToParent( "OK" , "" )
	Form.CloseForm( )
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	Dim szData
	Dim szList
	szData = Form.GetOpenLinkData()
	
	szList = Split(szData, "★")
	
	if UBOUND(szList) < 1 then
		Exit sub
	End if
	
	Table0.SetCellString( 0, 1, szList(0))
	Table0.SetCellString( 1, 1, szList(1))
End Sub

