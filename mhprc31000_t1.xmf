'============================================================================
Sub hogaTbl_OnClick(lRow, lCol)

	If lRow = 10 Then
		Exit Sub
	End If

	If lCol = 2 Then		
		If g_bBtnSellBuy = false Then
			Dim nPrice
			nPrice = CDbl( hogaTbl.GetCellString(lRow, lCol) )
			nzInnerMarket = Cint( Form.GetItemCodeInfo(g_szItemCode, "innermarket"))
			
			' 스프레드의 경우 마이너스(-)도 주문 가능/ 2018.01.03 추가
			If nzInnerMarket = 4 or nPrice > 0 Then			
				Dim nTop
				nTop = lRow * 42
				
				g_nPrice = nPrice
				Form.SetSharedData("FUTHYUN_RETURN" , g_nPrice)
		
				btnSell.top = nTop
				btnBuy.top  = nTop
				lblLine.top  = nTop
				
				g_bBtnSellBuy = true
				SetBtnVisible( g_bBtnSellBuy )				
			End If
		Else
			g_bBtnSellBuy = false
			SetBtnVisible( g_bBtnSellBuy )
		End If
	End If
	
End Sub

'============================================================================
Sub btnBuy_OnClick()
	SendOrder( "0" )
	
	g_bBtnSellBuy = false
	SetBtnVisible( g_bBtnSellBuy )
End Sub

'============================================================================
Sub btnSell_OnClick()
	SendOrder( "1" )
	g_bBtnSellBuy = false
	SetBtnVisible( g_bBtnSellBuy )	
End Sub

'============================================================================
Sub lblLine_OnClick()
	g_bBtnSellBuy = false
	SetBtnVisible( g_bBtnSellBuy )	
End Sub

'============================================================================
Sub btnAlpha_OnClick()
	g_bBtnSellBuy = false
	SetBtnVisible( g_bBtnSellBuy )	
End Sub

