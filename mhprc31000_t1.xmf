'============================================================================
Function RequestData()

	Change_Mini_Table()
	Set_RightUp()
	
	DATAMANAGER.RequestTranData( "ohhts_3050_001r" )
	DATAMANAGER.RequestTranData( "ohhts_3050_004r" )
	DATAMANAGER.RequestTranData( "ohhts_3050_002r" )	'20230130 SWJ START : 체결 그리드 추가
	DATAMANAGER.RequestTranData( "ohhts_3080_001r" )	'202209 HSZ 상품선물 추가

	'차트
	DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)

	DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
	szToday = Form.GetSharedData("&HOST_DATE", 0 )
	DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DATE1" , 0,szToday)
	DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR" , 0,"D")  'D/W/M/Y 일/주/월/년 

	DATAMANAGER.RequestTranData("ohhts_5030_001r")	

end Function


Function Set_HogaTable()
	Dim szDispdiff, szJangraph, szPriceoutline, szBoldHoga, szBoldJan, szBoldRest
	Dim szColWidth, szHAlign

	szDispdiff		= Form.LoadConfigData("mhprc31000", "Dispdiff"	)	'호가등락률
	szJangraph		= Form.LoadConfigData("mhprc31000", "Jangraph"	)	'호가잔량그래프
	g_szDiplayrest	= Form.LoadConfigData("mhprc31000", "Diplayrest"	)	'호가직전수량표시
	szPriceoutline	= Form.LoadConfigData("mhprc31000", "Priceoutline")	'현재가 외곽선 표시
	szBoldHoga		= Form.LoadConfigData("mhprc31000", "BoldHoga"	)	'텍스트굵기 호가
	szBoldJan		= Form.LoadConfigData("mhprc31000", "BoldJan"		)	'텍스트굵기 호가잔량
	szBoldRest		= Form.LoadConfigData("mhprc31000", "BoldRest"	)	'텍스트굵기 직전대비
	
	'설정된 값이 없을 경우 초기값 Insert 함.
	If szDispdiff = "" Then
		szDispdiff 		= "1"
		szJangraph 		= "1"
		g_szDiplayrest 	= "0"
		szPriceoutline 	= "1"
		szBoldHoga 		= "1"
		szBoldJan 		= "0"
		szBoldRest		= "0"
		
		Form.SaveConfigData("mhprc31000", "Dispdiff"		, szDispdiff		)	'호가등락률
		Form.SaveConfigData("mhprc31000", "Jangraph"		, szJangraph		)	'호가잔량그래프
		Form.SaveConfigData("mhprc31000", "Diplayrest"	, g_szDiplayrest	)	'호가직전수량표시
		Form.SaveConfigData("mhprc31000", "Priceoutline"	, szPriceoutline	)	'현재가 외곽선 표시
		Form.SaveConfigData("mhprc31000", "Style"		, "0"			)	'현재가 스타일
		Form.SaveConfigData("mhprc31000", "BoldHoga"		, szBoldHoga		)	'텍스트굵기 호가
		Form.SaveConfigData("mhprc31000", "BoldJan"		, szBoldJan		)	'텍스트굵기 호가잔량
		Form.SaveConfigData("mhprc31000", "BoldRest"		, szBoldRest		)	'텍스트굵기 직전대비
	End If
	

	If szDispdiff = "1" Then
		'호가직전수량표시
		If g_szDiplayrest = "1" Then
			szColWidth = "45,74,90,48,73,45"
		Else
			szColWidth = "0,119,90,48,118,0"
		End If
		szHAlign = "2"
		
	ElseIf szDispdiff = "0" Then
		If g_szDiplayrest = "1" Then
			szColWidth = "45,74,138,0,73,45"
		Else
			szColWidth = "0,119,138,0,118,0"
		End If		
		szHAlign = "1"
		
	End If	
	
'	Form.ShowAlert(g_szDiplayrest, szColWidth)	
	
	'호가등락률
	hogaTbl.SetColumnWidth( szColWidth )
	
	'호가잔량그래프
	hogaTbl.hojangraph = szJangraph
	
	'현재가 외곽선 표시
	hogaTbl.priceoutline = szPriceoutline
	
	For i = 0 To 9
		'호가
		If szBoldHoga = "1" Then
			hogaTbl.setPropTable("fontstyle" , i , 2 , "01")
		Else 
			hogaTbl.setPropTable("fontstyle" , i , 2 , "00")
		End If
		
		'호가잔량
		If szBoldJan = "1" Then
			hogaTbl.setPropTable("fontstyle" , i , 1 , "01")
			hogaTbl.setPropTable("fontstyle" , i , 4 , "01")
		Else 
			hogaTbl.setPropTable("fontstyle" , i , 1 , "00")
			hogaTbl.setPropTable("fontstyle" , i , 4 , "00")
		End If
		
		'직전대비
		If szBoldRest = "1" Then
			hogaTbl.setPropTable("fontstyle" , i , 3 , "01")
		Else 
			hogaTbl.setPropTable("fontstyle" , i , 3 , "00")
		End If
		
		'호가 가로 정렬
		hogaTbl.SetCellHAlign(i, 2, szHAlign)
	Next

End Function

'============================================================================
Function SendOrder( szTab )
	Dim szData

	' 전달내용/탭위치/종목코드/가격
	szData = "현재가" & "★" & szTab & "★" & g_szItemCode & "★" & g_nPrice
	
	Form.OpenScreen( "31030" , szData )

End Function

'============================================================================
Function SetBtnVisible( bValue )
	btnSell.visible	= bValue
	btnBuy.visible 	= bValue
	lblLine.visible 	= bValue
	btnAlpha.visible	= bValue
	
End Function

