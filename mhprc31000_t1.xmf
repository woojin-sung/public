	<SCRIPT_INFO _len="27176" _ulen="25904" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵현재가_호가
' 02. 화면설명 : 선옵현재가 호가탭화면
' 03. 작    성 : 2016.04.30 LJS
' 04. 참    고 : ohhts_3050_003r : 차트용 
'-------------------------------------------------------------------------------------------
' 20240412 HSZ START : 코스닥글로벌지수 추가 (KF)
'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_szItemCode, g_szItemMarket

'파생 실시간 가격 제한
'0: 실시간 상하한 적용, 1: 실시간 상하한 미적용 종목, 2: 실시간 상하한 미적용 시간, 3: 실시간 상하한 KRX 적용 해제 시
Dim g_realLimit
Dim g_Rup

g_realLimit = 0
g_Rup = 1

Dim g_nPrice
	
Dim g_bBtnSellBuy
g_bBtnSellBuy = false

'20230130 SWJ START
Dim g_CheGridGbn
g_CheGridGbn = "1"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Function Change_Mini_Table()

    If g_szItemMarket = "F" Or g_szItemMarket = "MF" Or g_szItemMarket = "XF" Or g_szItemMarket = "KF" Then '20180308_01 KBC : KRX300 & KSQ150상품추가		' 20240412 HSZ START : 코스닥글로벌지수 추가
	    tblRLimitF.visible = true
	    tblRLimitO.visible = false
    
	Else
	    tblRLimitF.visible = false
	    tblRLimitO.visible = true
	    
	End if
	
    If g_realLimit = 0 Then
	    tblLT1.visible = true
	    tblLT2.visible = false
	    tblLT3.visible = false
	    tblLT4.visible = false
		
    ElseIf g_realLimit = 1 Then
	    tblLT1.visible = false
	    tblLT2.visible = true
	    tblLT3.visible = false
	    tblLT4.visible = false

    ElseIf g_realLimit = 2 Then
	    tblLT1.visible = false
	    tblLT2.visible = false
	    tblLT3.visible = true
	    tblLT4.visible = false

    ElseIf g_realLimit = 3 Then
	    tblLT1.visible = false
	    tblLT2.visible = false
	    tblLT3.visible = false
	    tblLT4.visible = true

    End If
	
End Function

'============================================================================
Function Change_RightUp()
	'20170823 NOHES START : visible 셋팅 전 처리방식으로 변경
    If g_Rup = 3 Then		'차트 추가시 3으로 처리
	    g_Rup = 1
	Else
	    g_Rup = g_Rup + 1
	End If
	'20170823 NOHES END
    Set_RightUp()
    

End Function

'============================================================================
Function Set_RightUp()
	
    if g_szItemMarket = "F" or g_szItemMarket = "MF" or g_szItemMarket = "XF" Or g_szItemMarket = "KF" then '20150626 NES 미니선물 추가 '20180308_01 KBC : KRX300 & KSQ150상품추가	' 20240412 HSZ START : 코스닥글로벌지수 추가
	    if g_Rup = 1 then
			tblFutRT1.visible = true
			tblFutRT2.visible = false
			ChartEx0.visible = false
			tblOptRT1.visible = false
			tblOptRT2.visible = false
		    tblCfuRT1.visible = false
		elseif g_Rup = 2 then
		    tblFutRT1.visible = false
		    tblFutRT2.visible = true
		    ChartEx0.visible = false
			tblOptRT1.visible = false
			tblOptRT2.visible = false
			tblCfuRT1.visible = false
		    
		elseif g_Rup = 3 then
		    tblFutRT1.visible = false
		    tblFutRT2.visible = false
		    ChartEx0.visible = true
			tblOptRT1.visible = false
			tblOptRT2.visible = false
			tblCfuRT1.visible = false
		end if
	elseif g_szItemMarket = "CF" or g_szItemMarket = "FF" then '20220915 HSZ 상품선옵 추가	'20221111 SWJ START : 거래소 차세대 (CF -> CF, FF 분리)
		tblCfuRT1.visible = true
		tblFutRT1.visible = false
		tblFutRT2.visible = false
		ChartEx0.visible = false
		tblOptRT1.visible = false
		tblOptRT2.visible = false
	else
		if g_Rup = 1 then
		    tblOptRT1.visible = true
		    tblOptRT2.visible = false
		    ChartEx0.visible = false
		    tblFutRT1.visible = false
		    tblFutRT2.visible = false
			tblCfuRT1.visible = false
		    
		elseif g_Rup = 2 then
		    tblOptRT1.visible = false
		    tblOptRT2.visible = true
		    ChartEx0.visible = false
		    tblFutRT1.visible = false
		    tblFutRT2.visible = false
			tblCfuRT1.visible = false
		    
		elseif g_Rup = 3 then
			tblOptRT1.visible = false
		    tblOptRT2.visible = false
 		    ChartEx0.visible = true
		    tblFutRT1.visible = false
		    tblFutRT2.visible = false
			tblCfuRT1.visible = false
		end if
    end if
   	if g_szItemMarket = "CF" or g_szItemMarket = "FF" then '20220915 HSZ 상품선옵 추가	'20221111 SWJ START : 거래소 차세대 (CF -> CF, FF 분리)
		imgRUp.visible = false
	else
		imgRUp.visible = true
	end if
End Function
'============================================================================
'20230130 SWJ START : 체결 그리드 추가
'============================================================================
Function Change_CheGrid()
	if g_CheGridGbn = "1" then
		grdCNTG.visible = g_CheGridGbn
		g_CheGridGbn = "0"
		
		DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
		DATAMANAGER.RequestRealData( "ohhts_optn_cntg" )
	else
		grdCNTG.visible = g_CheGridGbn
		g_CheGridGbn = "1"
		
		DATAMANAGER.CancelRealData( "ohhts_futs_cntg" )
		DATAMANAGER.CancelRealData( "ohhts_optn_cntg" )
	end if
End Function
