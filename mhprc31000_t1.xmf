'============================================================================
Sub Form_OnFormInitBefore()
	
	g_szItemCode =  Form.GetSharedData( "&ITEM_FUTOPT", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

	'20160705 NOHES START	MarketType Default : "F"로 결정
	if Len(Trim(g_szItemMarket)) = 0 Then
		g_szItemMarket = "F"			
	end if
	'20160705 NOHES END

	ChartEx0.setChartType("minibong")
End Sub

'============================================================================
Sub Form_OnFormInit()

	FormInit()		'컨트롤 Init
	
	SetBtnVisible( g_bBtnSellBuy )
	
	'환경설정 Load
	Set_HogaTable()
	
'	RequestData()	
End Sub


'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

		'20160705 NOHES START	MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) = 0 Then
			g_szItemMarket = "F"			
		end if
		'20160705 NOHES END
	
		g_bBtnSellBuy = false
		SetBtnVisible( g_bBtnSellBuy )	
		
		RequestData()
	end	if

End Sub



'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
			Exit Sub
		End If
		
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		'20160705 NOHES START	MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) = 0 Then
			g_szItemMarket = "F"			
		end if
		'20160705 NOHES END
		
		g_bBtnSellBuy = false
		SetBtnVisible( g_bBtnSellBuy )	
		
		RequestData()
		
	ElseIf sEventName = "HOGA_SETUP" Then
		Set_HogaTable()
	End If

End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
    If szTranID = "ohhts_3050_001r" then
	    DATAMANAGER.CancelRealData( "ohhts_pric_extd" )
	    DATAMANAGER.CancelRealData( "ohhts_pric_rstc" )
	    
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
	
	'20230130 SWJ START
	ElseIf szTranID = "ohhts_3050_002r" then
		
		'DATAMANAGER.CancelRealData( "ohhts_futs_cntg" )
		'DATAMANAGER.CancelRealData( "ohhts_optn_cntg" )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_002r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
	
	'20230130 SWJ END
	
	ElseIf szTranID = "ohhts_3000_022r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_3000_022r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3000_022r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode 	)
		
	ElseIf szTranID = "ohhts_3050_004r" then
		
		DATAMANAGER.CancelRealData( "ohhts_optn_antg" )
		DATAMANAGER.CancelRealData( "ohhts_futs_antg" )
		
		DATAMANAGER.CancelRealData( "ohhts_futs_aspr" )
		DATAMANAGER.CancelRealData( "ohhts_futs_cntg" )
		DATAMANAGER.CancelRealData( "ohhts_optn_aspr" )
		DATAMANAGER.CancelRealData( "ohhts_optn_cntg" )
		
'		20220915 HSZ START : 상품선물 추가
		DATAMANAGER.CancelRealData( "ohhts_cfut_antg" )
		DATAMANAGER.CancelRealData( "ohhts_cfut_aspr" )
		DATAMANAGER.CancelRealData( "ohhts_cfut_cntg" )
'		20220915 HSZ END
	     
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_004r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
	    
	ElseIf szTranID = "ohhts_3080_001r" then	'20220915 HSZ : 상품선물 추가
		 
		DATAMANAGER.SetDataValue( 0, "ohhts_3080_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode	)
		DATAMANAGER.SetDataValue( 0, "ohhts_3080_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket	)
	    
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	Dim szCode
	
	szCode = DATAMANAGER.GetDataValue( 0, "ohhts_3050_004r", "OutBlock1", "FID_SHRN_ISCD" , 0 )
	
	If szTranID = "ohhts_futs_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_futs_aspr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	
	ElseIf szTranID = "ohhts_futs_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	
	ElseIf szTranID = "ohhts_optn_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_optn_aspr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	
	ElseIf szTranID = "ohhts_optn_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	
	ElseIf szTranID = "ohhts_pric_extd" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_pric_extd", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	
	ElseIf szTranID = "ohhts_pric_rstc" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_pric_rstc", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )

	ElseIf szTranID = "ohhts_futs_antg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_futs_antg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )

	ElseIf szTranID = "ohhts_optn_antg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_optn_antg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	
	'20220915 HSZ START 상품선물 추가
	ElseIf szTranID = "ohhts_cfut_antg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_cfut_antg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	
	ElseIf szTranID = "ohhts_cfut_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_cfut_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	
	ElseIf szTranID = "ohhts_cfut_aspr" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_cfut_aspr", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
	'20220915 HSZ END
	
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "ohhts_3050_001r" Then
		Dim nSDPR , nOPRC, nHPRC, nLPRC
		Dim szRstcYn
		
		nSDPR = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_SDPR2" , 0 ) )	'기준가
		nOPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_OPRC2" , 0 ) )	'시가
		nHPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_HPRC2" , 0 ) )	'고가
		nLPRC = CDbl ( DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_LPRC2" , 0 ) )	'저가
		szRstcYn = DATAMANAGER.GetDataValue( 0, "ohhts_3050_001r", "OutBlock1", "FID_RLTM_PRC_RSTC_YN", 0 )	'실시간가격제한여부
	
		'호가컨트롤 속성		
'		hogaTbl.startprice = nOPRC
'		hogaTbl.highprice	 = nHPRC
'		hogaTbl.lowprice	 = nLPRC
		
	    If szRstcYn <> "" Then
		    g_realLimit = CInt(szRstcYn)
		    Change_Mini_Table()
	    End If
		
		If g_szItemMarket = "F" or g_szItemMarket = "MF" or g_szItemMarket = "XF" Or g_szItemMarket = "KF" then '20150626 NES 미니선물 추가 '20180308_01 KBC : KRX300 & KSQ150상품추가	' 20240412 HSZ START : 코스닥글로벌지수 추가
			
			'시가
			If nSDPR < nOPRC Then
				tblFutRT2.SetCellFgColor( 0, 1, "10" )				
			ElseIf nSDPR > nOPRC Then
				tblFutRT2.SetCellFgColor( 0, 1, "11" )
			Else
				tblFutRT2.SetCellFgColor( 0, 1, "12" )				
			End If			

			'고가
			If nSDPR < nHPRC Then
				tblFutRT2.SetCellFgColor( 1, 1, "10" )				
			ElseIf nSDPR > nHPRC Then
				tblFutRT2.SetCellFgColor( 1, 1, "11" )
			Else
				tblFutRT2.SetCellFgColor( 1, 1, "12" )				
			End If
			
			'저가
			If nSDPR < nLPRC Then
				tblFutRT2.SetCellFgColor( 2, 1, "10" )				
			ElseIf nSDPR > nLPRC Then
				tblFutRT2.SetCellFgColor( 2, 1, "11" )
			Else
				tblFutRT2.SetCellFgColor( 2, 1, "12" )
			End If
		Else
			'시가
			If nSDPR < nOPRC Then
				tblOptRT1.SetCellFgColor( 0, 1, "10" )				
			ElseIf nSDPR > nOPRC Then
				tblOptRT1.SetCellFgColor( 0, 1, "11" )
			Else
				tblOptRT1.SetCellFgColor( 0, 1, "12" )				
			End If			

			'고가
			If nSDPR < nHPRC Then
				tblOptRT1.SetCellFgColor( 1, 1, "10" )				
			ElseIf nSDPR > nHPRC Then
				tblOptRT1.SetCellFgColor( 1, 1, "11" )
			Else
				tblOptRT1.SetCellFgColor( 1, 1, "12" )				
			End If
			
			'저가
			If nSDPR < nLPRC Then
				tblOptRT1.SetCellFgColor( 2, 1, "10" )				
			ElseIf nSDPR > nLPRC Then
				tblOptRT1.SetCellFgColor( 2, 1, "11" )
			Else
				tblOptRT1.SetCellFgColor( 2, 1, "12" )
			End If		
		End If
		
	    DATAMANAGER.RequestRealData( "ohhts_pric_rstc" )
	    DATAMANAGER.RequestRealData( "ohhts_pric_extd" )	'실시간 상하한가 표시
	End If
	
	'20230130 SWJ START
	'IF szTranID = "ohhts_3050_002r" then
		'DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
		'DATAMANAGER.RequestRealData( "ohhts_optn_cntg" )
	'end if
	'20230130 SWJ END
	
	If szTranID = "ohhts_3050_004r" Then
		Dim nTOTAL_BIDP_RSQN		' 총매수잔량
		Dim nTOTAL_ASKP_RSQN		' 총매도잔량
		
		nTOTAL_BIDP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_3050_004r", "OutBlock1", "FID_TOTAL_BIDP_RSQN" , 0 )
		nTOTAL_ASKP_RSQN = DATAMANAGER.GetDataValue( 0, "ohhts_3050_004r", "OutBlock1", "FID_TOTAL_ASKP_RSQN" , 0 )
		
		hogaTbl.SetCellString( 10, 2, nTOTAL_BIDP_RSQN - nTOTAL_ASKP_RSQN )
	
		if g_szItemMarket = "F" or g_szItemMarket = "MF" or g_szItemMarket = "XF" Or g_szItemMarket = "KF" then '20180308_01 KBC : KRX300 & KSQ150상품추가	' 20240412 HSZ START : 코스닥글로벌지수 추가
			DATAMANAGER.RequestRealData( "ohhts_futs_aspr" )
			DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
			DATAMANAGER.RequestRealData( "ohhts_futs_antg" )
'		20220915 HSZ START : 상품선물 추가
		elseif g_szItemMarket = "CF" or g_szItemMarket = "FF" then		'20221111 SWJ START : 거래소 차세대 (CF -> CF, FF 분리)
			DATAMANAGER.RequestRealData( "ohhts_cfut_aspr" )
			DATAMANAGER.RequestRealData( "ohhts_cfut_cntg" )
			DATAMANAGER.RequestRealData( "ohhts_cfut_antg" )
'		20220915 HSZ END
		else
		    DATAMANAGER.RequestRealData( "ohhts_optn_aspr" )
		    DATAMANAGER.RequestRealData( "ohhts_optn_cntg" )
		    DATAMANAGER.RequestRealData( "ohhts_optn_antg" )
		    
		end if
		
		DATAMANAGER.RequestTranData( "ohhts_3000_022r" )
		
		'10호가창 중간위치
		scroll_pos = "vcenter"

	End If
	
    If szTranID = "ohhts_3000_022r" then
	    Dim szACNT_CODE
	    szACNT_CODE = DATAMANAGER.GetDataValue( 0, "ohhts_3000_022r", "OutBlock1", "FID_ANTC_CLS_CODE" , 0 )
	    
	    If szACNT_CODE <> "" then
		    If szACNT_CODE <> "0" then
			    tblExpectation.visible = True
			    
			    '20230127 SWJ START : 예상체결 테이블이 보여야 함 (tblLT1 테이블이 겹쳐보임)
			     tblLT1.visible = false
			    '20230127 SWJ END
			     
			    	tblLT2.visible = false
				tblLT3.visible = false
				tblLT4.visible = false	
				tblRLimitF.visible = false
				tblRLimitO.visible = false
    
		    Else
			    tblExpectation.visible = false
			    
			    Change_Mini_Table()
		    End if
	    End if
	End if
	
End Sub



'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName = "mhprc31000_p4" then	
		scroll_pos = "vcenter"		'10호가창 중간위치
	End If	
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)

	If szTranID = "ohhts_futs_aspr" Or szTranID = "ohhts_optn_aspr" Or szTranID = "ohhts_cfut_aspr" Then	'20220915 HSZ : 상품선물 추가(cfut)

		Dim nTOTAL_BIDP_RSQN		' 총매수잔량
		Dim nTOTAL_ASKP_RSQN		' 총매도잔량
		Dim szACNT_CODE
		
		nTOTAL_BIDP_RSQN = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_BIDP_RSQN" , 0 )
		nTOTAL_ASKP_RSQN = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_TOTAL_ASKP_RSQN" , 0 )
		
		szACNT_CODE = DATAMANAGER.GetDataValue( 1, "ohhts_3000_022r", "OutBlock1", "FID_ANTC_CLS_CODE" , 0 )
		
		hogaTbl.SetCellString( 10, 2, nTOTAL_BIDP_RSQN - nTOTAL_ASKP_RSQN )
		
		If szACNT_CODE <> "" then
		    If szACNT_CODE <> "0" then
			    tblExpectation.visible = True
			    
			    '20230127 SWJ START : 예상체결 테이블이 보여야 함 (tblLT1 테이블이 겹쳐보임)
			    tblLT1.visible = false
			    '20230127 SWJ END
			    
			    	tblLT2.visible = false
				tblLT3.visible = false
				tblLT4.visible = false	
				tblRLimitO.visible = false
				tblRLimitF.visible = false
    
		    Else
			    tblExpectation.visible = false
			    
			    Change_Mini_Table()
		    End if
	    End if
	    
	ElseIf szTranID = "ohhts_pric_rstc" then
		Dim szRstcYN
	    szRstcYN = DATAMANAGER.GetDataValue( 1, "ohhts_pric_rstc", "OutBlock1", "FIDR_RLTM_PRC_RSTC_YN" , 0 )
	    
	    If szRstcYN <> "" Then
		    g_realLimit = CInt( szRstcYN )
		    Change_Mini_Table()
	    End If
	End If
End Sub

