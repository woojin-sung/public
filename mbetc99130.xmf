'--===========================================================================
'Global variable
'--===========================================================================
dim nRow
dim count
dim tmp
dim ckmatch
dim cldToday
dim compToday

dim g_szrsvID '예약구분ID
dim g_szpfID '포트폴리오ID
dim g_szrsvYMDH '예약일시
dim g_szrsvPlace '예약장소
dim g_szptName '포트폴리오 이름
dim g_szrsvCode ' 상담형태
dim g_szrsvstatCode	'예약상태코드
dim g_description ' 특이사항

dim g_u_id
dim g_u_name

dim f_szrsvYMDH '변형된 예약일시

'============================================================================
Sub Form_OnFormInitBefore()
	
	g_u_id = Form.GetSharedData("&USER_ID", false )
	g_u_name = Form.GetSharedData("&USER_NAME", false )
	cldToday = Form.GetSharedData("&HOST_DATE", false)
	
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_023r" , "InBlock1" , "IQRY_STA_DATE" , 0 , "00010101" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_023r" , "InBlock1" , "IQRY_FIN_DATE" , 0 , "99991231" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_023r" , "InBlock1" , "CUST_ID" , 0 , g_u_id )
	
	
	
End Sub
'============================================================================
Sub Form_OnFormInit()
	nRow =	0
	Label1.caption = g_u_name & "님의 예약정보"
	DATAMANAGER.RequestTranData("obcpp_rbit_023r")
	
End Sub



'============================================================================
Sub Container0_Grid0_OnClickUp(lRow, szCellID)
	
	
	
	g_szrsvID	=	Container0.Grid0.GetCellData("bd_cell0", lRow)
	g_szrsvYMDH	=	Container0.Grid0.GetCellData("bd_cell1", lRow)
	compToday = left(g_szrsvYMDH,4)&mid(g_szrsvYMDH,6,2)&mid(g_szrsvYMDH,9,2)
	g_szpfID		=	Container0.Grid0.GetCellData("bd_cell2", lRow)
	g_szptName	=	Container0.Grid0.GetCellData("bd_cell3", lRow)
	g_szrsvPlace	=	Container0.Grid0.GetCellData("bd_cell5", lRow)
	g_szrsvCode	=	Container0.Grid0.GetCellData("bd_cell8", lRow)
	g_szrsvstatCode=	Container0.Grid0.GetCellData("bd_cell4", lRow)
	g_description =   Container0.Grid0.GetCellData("bd_cell6", lRow)
	
		
	listLocation = Split(Container0.Grid0.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	sPopupType = "2"
		
	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" & "J" & "★" & "예약수정" & "★" & "예약취소" & "★" & "목록" & "★" & " " & "★" & " " )
	
	
	
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	dim szListItems		'미니팝업아이템

	if sKeyName = "MOVEPOP_RETURN" then     '미니팝업처리
		szListItems	=	split(sRet,"★")
		
		if szListItems(1)	=	"0" then 	'예약수정
			if g_szrsvstatCode == "완료" then
				Form.ShowAlert("알림", "완료된 예약은 수정할 수 없습니다.")
				Exit sub
			end if
			
																		'상담방법에 따라 if 1,2로 나눠서 지점상담, ODS폼을 따로 띄움
			if g_szrsvCode = "지점상담" then								' 지점상담
				Form.SetSharedData( "aCode" , "U")
				Form.SetSharedData( "szrsvID" , g_szrsvID )
				Form.SetSharedData( "SharedUserName" , g_u_name )
				Form.SetSharedData("szpfID" , g_szpfID)
				
				' 전화번호, 상담일시, 상담시간, 특이사항을 가져와야함 : 상담장소를 아래와 같이 가져오는것 확인
				Form.SetSharedData( "szrsvPlace" , g_szrsvPlace )
				Form.SetSharedData( "szrsvDRP" , g_description )
				
								
				Form.OpenFramePopup("mbcpp70140.xmf" , "" , "")
			
			elseif g_szrsvCode = "찾아가는 서비스" then							' ODS
				Form.SetSharedData( "aCode" , "U")
				Form.SetSharedData( "szrsvID" , g_szrsvID )
				Form.SetSharedData( "SharedUserName" , g_u_name )
				Form.SetSharedData("szpfID" , g_szpfID)
				'이름, 전화번호, 상담일시, 상담시간, 특이사항을 가져와야함 : 상담장소를 아래와 같이 가져오는것 확인
				Form.SetSharedData( "szrsvPlace" , g_szrsvPlace )
				Form.SetSharedData( "szrsvDRP" , g_description )
			
				Form.OpenFramePopup("mbcpp70150.xmf" , "" , "")
			
			end if
			
					
		elseif szListItems(1)	=	"1" then ' 예약취소
			if compToday <= cldToday then
				Form.ShowAlert("알림", "해당 예약은 취소 할 수 없습니다. 고객지원센터로 연락주세요.")
				Exit sub
			elseif g_szrsvstatCode == "완료" then
				Form.ShowAlert("알림", "완료된 예약은 취소할 수 없습니다.")
				Exit sub
			
			end if
			
			Form.SetSharedData( "szrsvID" , g_szrsvID )
			Form.SetSharedData( "szrsvYMDH" , g_szrsvYMDH )
			Form.SetSharedData( "szptName" , g_szptName )
			Form.SetSharedData( "szrsvPlace" , g_szrsvPlace )
			
			Form.OpenPopup("mbcpp70160_p1.xmf" , "" , "")
			
			
					
		end if
		
	end if
	
	if sKeyName = "cancel" then
		Form_OnFormInitBefore()
		Form_OnFormInit()
	end if
		
End Sub



'============================================================================
Sub Button0_OnClick()

	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_023r" , "InBlock1" , "IQRY_STA_DATE" , 0 , cld0.caption )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_023r" , "InBlock1" , "IQRY_FIN_DATE" , 0 , cld1.caption+1 )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_023r" , "InBlock1" , "CUST_ID" , 0 , g_u_id )
	
	
	DATAMANAGER.RequestTranData("obcpp_rbit_023r")
	
	
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	count = DATAMANAGER.GetDataCount( 0, "obcpp_rbit_023r", "OutBlock1" )
	
	nRow = 0
	
	for i=0 to count-1
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_023r" ,"OutBlock1", "INP_ITEM_ID" ,i) ' 예약정보ID
	Container0.Grid0.SetCellData("bd_cell0",nRow, tmp )
		
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_023r" ,"OutBlock1", "RSEV_YMDH" ,i) ' 예약일시
	f_szrsvYMDH = left(tmp, 13)
	Container0.Grid0.SetCellData("bd_cell1",nRow, f_szrsvYMDH&"시")
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_023r" ,"OutBlock1", "PRTF_ID" ,i) ' 포트폴리오ID
	Container0.Grid0.SetCellData("bd_cell2",nRow, tmp )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_023r" ,"OutBlock1", "INP_RSEV_CLS_CODE" ,i) ' 상담형태
	Container0.Grid0.SetCellData("bd_cell8",nRow, Cal_rsvtype(tmp) )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_023r" ,"OutBlock1", "PRTF_NAME" ,i) ' 포트폴리오 명
	Container0.Grid0.SetCellData("bd_cell3",nRow, tmp )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_023r" ,"OutBlock1", "PLAC_CNTT" ,i) ' 상담장소
	Container0.Grid0.SetCellData("bd_cell5",nRow, tmp )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_023r" ,"OutBlock1", "INP_RSEV_STAT_CODE" ,i) ' 예약상태코드
	if tmp == "1" then
		ckmatch = "매칭 중"
		Container0.Grid0.SetCellBgColor( "bd_cell4", i, "10" )
		Container0.Grid0.SetCellFgColor( "bd_cell4", i, "0" )
	elseif tmp == "2" then
		ckmatch = "예약확정"
		Container0.Grid0.SetCellBgColor( "bd_cell4", i, "11" )
		Container0.Grid0.SetCellFgColor( "bd_cell4", i, "0" )
	elseif tmp == "3" then
		ckmatch = "완료"
		Container0.Grid0.SetCellBgColor( "bd_cell4", i, "12" )
		Container0.Grid0.SetCellFgColor( "bd_cell4", i, "0" )
	else 
		ckmatch = "오류"
	
	end if
	Container0.Grid0.SetCellData("bd_cell4",nRow, ckmatch )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_023r" ,"OutBlock1", "PRTR_MATR_DTL_CNTT" ,i) ' 특이사항
	Container0.Grid0.SetCellData("bd_cell6",nRow, tmp )
	
	
	
	nRow = nRow+1
	
	next
	
End Sub


'============================================================================
Sub Container0_Grid0_OnScrollEnd()

	DATAMANAGER.RequestNextData( "obcpp_rbit_023r" )
	
End Sub

'============================================================================
Function Cal_rsvtype(type1)
					
			temp=""
						
			if Cint(type1)= 1  then
				temp="지점상담"
			
			elseif Cint(type1)= 2 then
				temp="찾아가는 서비스"
			
			
			else temp = type1
	
			end if

	 Cal_rsvtype =temp
			

End Function 
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
End Sub

