'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_bInitOk1, g_bInitOk2, g_bInitOk3
g_bInitOk1 = False
g_bInitOk2 = False
g_bInitOk3 = False
g_bInitOk4 = False

Dim g_sACN0, g_sASNO, g_sPWD  '20210312_01 SWJ START
Dim g_setData, nCnt
nCnt = 0
Dim sFinalStep

Dim g_sOnline_Code
g_sOnline_Code = "20" '10:ISA신규/20:ISA이수관/30:ISA유형전환

Dim g_sScrnNum
g_sScrnNum = "56110"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' Account_Check() : 계좌입력정보 확인
'============================================================================
Function Account_Check()
	If acnt0.caption == "" Then
		Form.ShowAlert("알림", "계좌번호는 필수값입니다.")
		Return False
	End If

	If Len(edtPwd.caption) < 4 Then
		Form.ShowAlert("알림", "비밀번호는 필수값입니다.")
		Return False
	End If
	
	Return true
End Function

'============================================================================
' SetTitle() : 단계 타이트 SET
'============================================================================
Sub SetTitle(sParam)
	Dim sTitle 
	sTitle = ""
	
	Select Case sParam
		Case "0"
			sTitle = "타사에서 가져오기"
			Image0.imgpath = "title_5step_1.png"
		Case "1"
			sTitle = "동영상 시청 및 이전유의사항 확인"	'v0002
			
			'20210312_01 SWJ START : 스텝별 이미지 설정
			Image0.imgpath = "title_5step_2.png"
			'20210312_01 SWJ END
		Case "2"
			sTitle = "투자성향 진단 및 상품(MP) 선택"
			
			'20210312_01 SWJ START : 스텝별 이미지 설정
			Image0.imgpath = "title_5step_3.png"
			'20210312_01 SWJ END
		Case "3"
			sTitle = "계약정보 등록"
			
			'20210312_01 SWJ START : 스텝별 이미지 설정
			Image0.imgpath = "title_5step_4.png"
			'20210312_01 SWJ END
		Case "4"
			sTitle = "고객 확인 및 안내"
			
			'20210312_01 SWJ START : 스텝별 이미지 설정
			Image0.imgpath = "title_5step_5.png"
			'20210312_01 SWJ END
	End Select
	
	tblTitle.SetCellString( 1, 0, sTitle)
End Sub
'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData("obsap_acif_999a")		' 금융상품일련번호 채번	
End Sub
'============================================================================
' f_SetAcntCtrlUI(str) : 단계별 계좌 컨트롤 UI SET
'============================================================================
Function f_SetAcntCtrlUI(sIdx)
'	if sIdx == "0" or sIdx == "1" then
	if sIdx == "0" then
		acnt0.visible = true
		edtPwd.visible = true
		
'		if sIdx == "0" then
			acnt0.enable = true
			edtPwd.enable = true
'		else
'			acnt0.enable = false
'			edtPwd.enable = false
'		end if 
		
	else
		acnt0.visible = false
		edtPwd.visible = false
	
		acnt0.enable = false
		edtPwd.enable = false
	end if
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	dim	szList
	dim  szLinkData

	'다음 버튼
	if sEventName == "OPEN_NEXT" then
		fmtab01.currenttab = sParam
		Call SetTitle(sParam)
		
		f_SetAcntCtrlUI(sParam)
		'노희범 차장님 요청
		'1. 이전 버튼 클릭시 기존 입력 내용 유지하기 위해 폼탭속성의 "Hide시 Unload" 체크 해제
		
		'2. 다음 버튼 클릭시 스크립트로 화면 클리어
		'   다음 버튼 클릭시 기존 입력내용 유지 요청 -> 주석처리
		'Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "CLEAR_DATA", sParam)
		
		'3. 입력데이터 재로드
		'   다음 버튼 클릭시 SetSharedData한 후, 다음 화면 Form_OnFormInit에서 GetSharedData 하는데,
		'   폼 변환시 Unload를 하지 않으므로, 
		'   이전 화면으로 돌아가 데이터 변경 후 다음 버튼 클릭시, Form_OnFormInit을 타지 않음 
		'   -> Trigger로 GetSharedData 재호출
		
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "SET_ONLINE_CODE", g_sOnline_Code)
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "SET_SHARED_KEY", g_sScrnNum )
		
		If (sParam == "1" and g_bInitOk1 == True) or (sParam == "2" and g_bInitOk2 == True) or (sParam == "3" and g_bInitOk3 == True) then
			Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "RELOAD_DATA", "")
		End If
		
		'각 페이지가 한번씩 로드되면 FormInit 완료, 이후부터는 Trigger로 DataShare
		If sParam == "1" then
			g_bInitOk1 = True
		Elseif sParam == "2" then
			g_bInitOk2 = True
		Elseif sParam == "3" then
			g_bInitOk3 = True
		Elseif sParam == "4" then
			g_bInitOk4 = True
		End If
	end if 
	
	'이전 버튼
	if sEventName == "OPEN_PREV" then
	
		fmtab01.currenttab = sParam
		Call SetTitle(sParam)
		
		f_SetAcntCtrlUI(sParam)
		
		If sParam == "2" then
			Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "INIT_MPCHANGE", "")
		End If
		
		'20210312_01 HSZ START : 이어가기 수정 
		g_bInitOk1 = True
		g_bInitOk2 = True
'		g_bInitOk3 = True
		'20210312_01 HSZ END
		
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "SET_ONLINE_CODE", g_sOnline_Code)
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "SET_SHARED_KEY", g_sScrnNum )
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "OPEN_PREV", "") '20210312_01 SWJ : ISA계좌개설 개선
		
	end if 
	
	'20210312_01 SWJ START : ISA 서비스 신청 스텝 결정
'	if sEventName == "DECIDE_STEP" then
'		DATAMANAGER.RequestTranData("obwat_ctad_069r")
'		
'	end if
	'20210312_01 SWJ END
	
	'STEP1 동영상 시청하기 중지(완료)시
	If sEventName == "VIDEO_PLAY_EXIT" then
		
		'20210311 SWJ START : 비디오 시청시간 저장 후 이어보기 긴급수정
		g_timeDate = Form.GetSharedData("&HOST_DATE", true)
		g_videoTime = Form.GetSharedData("ISA_VIDEO_TIME", false)
		g_UserID = Form.GetSharedData("&USER_ID", false)
		
		Form.SaveConfigData("VideoPlaying", "TimeSave"..g_timeDate..g_UserID, g_videoTime)
		'20210311 SWJ END
		
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "VIDEO_PLAY_EXIT", sParam)
		
	end If	
	
	'STEP1 계좌번호 변경시 각 페이지 Data Clear
	If sEventName == "CHANGE_ACCOUNT" then
		Form.triggerEvent("fmtab01.page1", "CLEAR_DATA", sParam)
		Form.triggerEvent("fmtab01.page2", "CLEAR_DATA", sParam)
		Form.triggerEvent("fmtab01.page3", "CLEAR_DATA", sParam)
		Form.triggerEvent("fmtab01.page4", "CLEAR_DATA", sParam)
	end If
	
	'투자성향으로 이동
	if sEventName == "MOVE_81010" then
		Form.OpenScreen("81010", "")
		Form.CloseForm()
	end if
	
End Sub

'============================================================================
'20210312_01 SWJ START : ISA 서비스 신청 개선
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim plain_rm, szStr, sDate
	
	'MTS메모리평문 적용유무 (0:미적용 / 1:적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	
	if plain_rm == "1" then
		szStr = edtPwd.caption 'MTS 메모리평문 적용상태일때
	else
		szStr = edtPwd.encdata	'MTS메모리평문 미적용상태일때
	end if
	
	sDate = Form.GetSharedData("&HOST_DATE", false)
	
	if szTranID == "obwat_ctad_069r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"		, 0 , acnt0.total		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"		, 0 , acnt0.sequence	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD" 		, 0 , szStr			)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "APLT_DATE" 	, 0 , sDate 			)
	
	elseif szTranID == "obacp_opop_066r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"		, 0, acnt0.total 		) '계좌번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"		, 0, acnt0.sequence 	) '계좌일련번호
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD"	, 0, szStr 			)
	
	elseif szTranID == "obwat_move_014r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"		, 0 , acnt0.total		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO"		, 0 , acnt0.sequence	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD" 		, 0 , szStr			)
				
	end if		

		
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_ctad_069r" then
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "REQ_USER_INFO", "")
		
		dim sType
		sType = DATAMANAGER.GetDataValue(0, "obwat_ctad_069r", "OutBlock1", "ETC_CNTT", 0)
		
		sFinalStep = DATAMANAGER.GetDataValue(0, "obwat_ctad_069r", "OutBlock1", "REG_STAG_CLS_CODE", 0)
		
		if sType == g_sOnline_Code then 
			Call DecideStep()
		end if
		
	elseif szTranID == "obacp_opop_066r" then
'		DATAMANAGER.RequestTranData("obwat_ctad_069r")
		DATAMANAGER.RequestTranData("obwat_move_014r")
		
	elseif szTranID == "obwat_move_014r" then
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "REQ_USER_INFO", "")
		
		dim sType, sApplyData, sApplyNo
		
		sApplyData = Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "APLT_DATE", 0))
		sApplyNo   = Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "APLT_SRNO", 0))
		
		if (sApplyData <> null and sApplyData <> "")
			and (sApplyNo <> null and sApplyNo <> "") then
			
			Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "REQ_CANCEL_INFO", "")
		else
			DATAMANAGER.RequestTranData("obwat_ctad_069r")
		end if
	'23.05.22 금융상품일련번호 채번 추가
	elseif	szTranID	=	"obsap_acif_999a"	then
		dim szFnprJoinSrno
		szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		
		Form.SetSharedData("FNPR_JOIN_SRNO", szFnprJoinSrno)	
		Form.OpenPopup("mbonl81010_p20" , "" , "")	'2023.05.22 금융소비자 팝업 추가
	end if
End Sub
'============================================================================
Function DecideStep()

	if sFinalStep == "" or sFinalStep == null then
		
		exit function
	end if

	'이전 가입신청내역 있음 알리고 이어할지 물어보는 로직 추가해야 함
	'이어서 하지않으면 저장내역 서비스로 가져올 필요없음
	
	nCnt = nCnt + 1 '함수 한번만 타도록 수정(56060_t1에서 movenextpage함수를 여러번 타서 그럼)
	
	if nCnt = 1 then
		Form.OpenPopup("mbisa56060_tp",sFinalStep, "")
	end if
	
End Function

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "Step_Return" then
		'팝업에서 리턴해주는 값에 따라 폼탭 화면 정해진다.
		fmtab01.currenttab = sRet
		f_SetAcntCtrlUI(sRet)
		'스텝 이미지와 타이틀도 재설정 한다.
		SetTitle(sRet)
		
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "SET_ONLINE_CODE", g_sOnline_Code )
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "SET_SHARED_KEY", g_sScrnNum )
		Form.triggerEvent("fmtab01." & fmtab01.currenttabpageid, "OPEN_PREV", "")
		
	elseif sKeyName == "Step_Return_Cancel" then
		exit sub
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			
		elseif sRet == "CANCEL_mbonl81010_p20" then
			Form.OpenMainMenuWithIndex(1,4,0)
		end if
	end if
End Sub
'============================================================================
'20210312_01 SWJ END
