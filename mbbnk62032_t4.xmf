'===========================================================================
' 화 면 명: 다른 금융기관 거래내역 조회_출금이체동의
' 화면설명: 
' 작    성: 2020.10.12 송기영
' 수    정:
'===========================================================================
' 2021.10.08. 김효준 v001 : 오픈뱅킹_이용재동의여부 조회&등록 추가
' 2020.08.10         v002 : 단말접속기기정보부 추가
'============================================================================
'***************************************************************************
'     G L O B A L   V A R I A B L E
'***************************************************************************
Dim g_szID         '사용자 아이디

Dim DrngAcntAls
Dim DrngAgrmYn
Dim BankCode
Dim BankAcno
Dim OpnTimsNo
Dim EmailAddr
 
Dim g_NxetPrgsYn '다음진행여부 v001
Dim g_AgrmYn     '재동의여부   v001
Dim g_ProsAbleYn '처리가능여부 v001
Dim g_recv_data  '수신데이터   v001
'===========================================================================
' Form_OnFormInit()
'===========================================================================
Sub Form_OnFormInit()

     g_szID = Form.GetSharedData("&USER_ID", false )
     
	'v001
	if Form.GetSharedData("62000_AGRMYN_SKIP" , false) = "Y" THEN
	    '정상진행
	else	
		DATAMANAGER.RequestTranData( "obtss_opnf_047r" ) '오픈뱅킹_이용재동의여부조회
	end if
End Sub


'v001
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
		
	if szTranID == "obtss_opnf_047r" then	'오픈뱅킹_이용재동의여부조회
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_047r", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_047r", "InBlock1", "ELFN_ID"       , 0 , g_szID )
	end if
	
	if szTranID == "obtss_opnf_048a" then	'오픈뱅킹_이용재동의여부관리
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "PROS_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "ELFN_ID"       , 0 , g_szID )
		DATAMANAGER.SetDataValue( 0, "obtss_opnf_048a", "InBlock1", "AGRM_YN"       , 0 , "Y")
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nCount
	
	if szTranID == "obtss_opnf_005a" then
		
		nCount = DATAMANAGER.GetDataCount(0, "obtss_opnf_005a", "OutBlock1")
		
		if nCount > 0 then
			Form.MsgBox("알림", "출금이체 미동의되었습니다", "", 0)	
			edtDrngAgrmYn.caption  = "미동의"
			btnAgr.caption = "동의"
			DrngAgrmYn = "N"
			Form.triggerEvent("#", "mbbnk62032_t4", "N")
		end if	
		
	elseif szTranID == "obtss_opnf_004a" then
		
		nCount = DATAMANAGER.GetDataCount(0, "obtss_opnf_004a", "OutBlock1")
		
		if nCount > 0 then
			Form.MsgBox("알림", "출금이체 동의되었습니다", "", 0)	
			edtDrngAgrmYn.caption  = "동의"
			btnAgr.caption = "동의 취소"
			DrngAgrmYn = "Y"
			Form.triggerEvent("#", "mbbnk62032_t4", "Y")
		end if	

	elseif szTranID == "obtss_opnf_047r" then 'v001
	    g_NxetPrgsYn  = ""
	    g_AgrmYn      = DATAMANAGER.GetDataValue( 0, "obtss_opnf_047r", "OutBlock1" , "AGRM_YN"      , 0 ) '재동의여부
	    g_ProsAbleYn  = DATAMANAGER.GetDataValue( 0, "obtss_opnf_047r", "OutBlock1" , "PROS_ABLE_YN" , 0 ) '처리가능여부
	    
	    '처리가능여부가 Y인경우 SharedData 등록후 다른화면에서 다시호출안하게함
	    If g_ProsAbleYn = "Y" Then
	    
		    Form.SetSharedData("62000_AGRMYN_SKIP", "Y")
	    End If

	    If g_AgrmYn = "Y" Then
		    Form.OpenPopup("mbbnk62000_p1" , ""  , "")
		    g_NxetPrgsYn = "N" '팝업호출시도 일단 진행불가 > Form_OnPopupReturn 다시판단
	    ElseIf g_AgrmYn = "N" Then
	        g_NxetPrgsYn = "Y"
	    ElseIf g_AgrmYn = "R" Then
	        Form.MsgBox( "알림", "5년경과시 재가입 절차가 진행됩니다.", "", 6 )
	        g_NxetPrgsYn = "N"
	    End If
	    
        '다음진행 불가시 비활성화
         If g_NxetPrgsYn = "N" Then
			
			btnAgr.enable         = False '편집			
		Else
		    '정상진행
	    End If
	elseif szTranID == "obtss_opnf_048a" then 'v001
		'정상진행
	end if
End Sub


'============================================================================
' Form_OnTriggerEvent(sEventName, sParam) : 트리거에서 입력받은 계좌번호를 사용하여 입력 세팅
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
		
	Dim szList
		
	if sEventName == "mbbnk62032_t4" then
		g_szData = sParam
		szList = Split(sParam, "★")
		
		DrngAcntAls 	= szList(0)
		DrngAgrmYn	= szList(1)
		BankCode		= szList(2)
		BankAcno		= szList(3)
		OpnTimsNo	= szList(4)
		EmailAddr	= szList(5)

		edtDrngAcntAls.caption = DrngAcntAls
		
		if DrngAgrmYn == "Y" then
			edtDrngAgrmYn.caption  = "동의"
			btnAgr.caption = "동의 취소"
		elseif DrngAgrmYn == "N" then
			edtDrngAgrmYn.caption  = "미동의"
			btnAgr.caption = "동의"
		else 
			edtDrngAgrmYn.caption  = ""
			btnAgr.caption = "동의"
		end if
		
	end if
	
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranError (szTranID , szErrCode , szErrMsg)
	Dim SubMsg
	
	SubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if SubMsg = "" then
		Form.MsgBox("알림", szErrMsg, 0)	
	else
		Form.MsgBox("알림", szErrMsg & "(" & SubMsg & ")", 0)
	end if
	
End Sub


'============================================================================
Sub btnAgr_OnClick()
	Form.MsgBox("알림", btnAgr.caption + "하시겠습니까?", "AGREE", 2)
End Sub




'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

	'v002 sta =============================================
	Dim l_MediaCode
			
	Dim l_TermUserClsCode
	Dim l_IpAddress
	Dim l_TermId
	Dim l_OsVersion
	
	l_MediaCode = Form.GetSharedData("&MEDIA_CODE", false )
	l_IpAddress = Form.GetSharedData("&IP_ADDRESS", false )
	l_OsVersion = Form.GetSharedData("&OS_VERSION", false )
					
	if l_MediaCode = "156" then 'iOS
		l_TermUserClsCode = "IO"
		l_TermId = Form.GetDeviceID()
		
	elseif l_MediaCode = "157" then '안드로이드
		l_TermUserClsCode = "AD"
		l_TermId = Form.GetAndroidID()
		
	else
		l_TermUserClsCode = ""
		l_TermId = ""
	end if
	'v002 fin =============================================
	
	if sKeyName == "AGREE" then
		if sRet == "ok" then	'삭제 후 재조회		
		
			if DrngAgrmYn = "Y" then
				
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_005a", "InBlock1", "PROS_CLS_CODE" , 0 ,  "2" ) '1:계좌해지시  2:출금동의 해지
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_005a", "InBlock1", "ELFN_ID", 0 , g_szID)
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_005a", "InBlock1", "BANK_CODE", 0 , BankCode )
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_005a", "InBlock1", "BANK_ACNO", 0 , BankAcno )
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_005a", "InBlock1", "OPN_TIMS_NO", 0 , OpnTimsNo )
				
				DATAMANAGER.RequestTranData("obtss_opnf_005a")
				
			elseif DrngAgrmYn = "N" then
				
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "PROS_CLS_CODE" , 0 ,  "2" ) '1:계좌해지시  2:출금동의 해지
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "ELFN_ID", 0 , g_szID)
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "BANK_CODE", 0 , BankCode )
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "BANK_ACNO", 0 , BankAcno )
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "OPN_TIMS_NO", 0 , OpnTimsNo )
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "DRNG_AGRM_YN", 0 , "Y" )
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "INFO_OFER_AGRM_YN", 0 , "Y")
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "EMAIL_ADDR", 0 , EmailAddr)
				
						
				'v002 sta =============================================
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock2", "TERM_USER_CLS_CODE" , 0, l_TermUserClsCode	) '단말사용자구분코드
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock2", "REG_TERM_IPAD"      , 0, l_IpAddress     	) '등록단말IP주소
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock2", "TERM_MAC_ADDR"      , 0, ""    			) '단말MAC주소
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock2", "TERM_ID"            , 0, l_TermId			) '단말ID
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock2", "TERM_OS"            , 0, l_OsVersion		) '단말운영체제
				'v002 fin =============================================
				
				DATAMANAGER.RequestTranData("obtss_opnf_004a")
			
			else  '출금이체동의 NULL 인경우 등록으로 처리
			
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "PROS_CLS_CODE" , 0 ,  "2" ) '1:계좌해지시  2:출금동의 해지
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "ELFN_ID", 0 , g_szID)
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "BANK_CODE", 0 , BankCode )
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "BANK_ACNO", 0 , BankAcno )
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "OPN_TIMS_NO", 0 , OpnTimsNo )
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "DRNG_AGRM_YN", 0 , "Y" )
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "INFO_OFER_AGRM_YN", 0 , "Y")
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock1", "EMAIL_ADDR", 0 , EmailAddr)
				
				'v002 sta =============================================				
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock2", "TERM_USER_CLS_CODE" , 0, l_TermUserClsCode	) '단말사용자구분코드
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock2", "REG_TERM_IPAD"      , 0, l_IpAddress     	) '등록단말IP주소
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock2", "TERM_MAC_ADDR"      , 0, ""    			) '단말MAC주소
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock2", "TERM_ID"            , 0, l_TermId			) '단말ID
				DATAMANAGER.SetDataValue( 0, "obtss_opnf_004a", "InBlock2", "TERM_OS"            , 0, l_OsVersion		) '단말운영체제
				'v002 fin =============================================

				DATAMANAGER.RequestTranData("obtss_opnf_004a")
			
			end if
		end if
		
	end if
End Sub


'v001
'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	If sKeyName == "mbbnk62000_p1" then
	     
		If sRet == "Y" then 'Y:재동의 N:취소
		
			btnAgr.enable         = True '편집
			
			DATAMANAGER.RequestTranData( "obtss_opnf_048a" )
		Else
		     '취소시도 처리가능여부값에 따라 진행
			If g_ProsAbleYn = "Y" Then
				
				btnAgr.enable         = True '편집		
			Else
			
				btnAgr.enable         = False '편집
			End If
		End If
	End If
     
End Sub

