	<SCRIPT_INFO _len="6231" _ulen="5783" >
'--===========================================================================
' 01. 화 면 명 : 국내 파생상품 양도소득 조회
' 02. 화면설명 : 국내 파생상품 양도소득 조회
' 03. 작    성 : 2023-12-20 YJH
' 04. 수    정 : 
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_ClearData() : 초기화
'============================================================================
Function f_ClearData()
	Container0.tblIncome.SetCellString( 0 , 1, "")	'청산손익금액
	Container0.tblIncome.SetCellString( 1 , 1, "")	'만기손익금액
	Container0.tblIncome.SetCellString( 2 , 1, "")	'총 양도소득
	Container0.tblIncome.SetCellString( 3 , 1, "")	'총 비용
	Container0.tblIncome.SetCellString( 4 , 1, "")	'순양도소득
	
	Container0.LabelIncome.setHighlight(332)
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	f_ClearData()
	
	cldFrom.caption = cldFrom.calyear & "0101"
	
	DATAMANAGER.RequestTranData( "obtrf_cntg_501r" ) '국내 파생상품 양도소득 조회
End Sub

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	f_ClearData()
	
	if sEventName == "changeTab" then
		DATAMANAGER.RequestTranData( "obtrf_cntg_501r" ) '국내 파생상품 양도소득 조회
	end if	
End Sub

'============================================================================
' cmbAcct_ChangeAccount() : 계좌변경
'============================================================================
Sub cmbAcct_ChangeAccount()
	f_ClearData()
	
	DATAMANAGER.RequestTranData( "obtrf_cntg_501r" ) '국내 파생상품 양도소득 조회
End Sub

'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋데이터 세팅	
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'국내 파생상품 양도소득 조회
	If szTranID == "obtrf_cntg_501r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" 		, 0 , cmbAcct.total         )    '계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" 		, 0 , cmbAcct.sequence )    '계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNT_PWD" 	, 0 , ""                          )     '계좌비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "STA_DATE" 	, 0 , cldFrom.caption      )    '시작일자
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FIN_DATE" 	, 0 , cldTo.caption         )     '종료일자
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 오류
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	Form.MsgBox( "알림", szErrMsg, "", 6 )
End Sub

'============================================================================
' Form_OnRefresh()
'============================================================================
Sub Form_OnRefresh()
	f_ClearData()
	
	DATAMANAGER.RequestTranData( "obtrf_cntg_501r" ) '국내 파생상품 양도소득 조회
End Sub

