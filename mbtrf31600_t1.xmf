'============================================================================
'국내 파생상품 거래내역 조회 팝업
'============================================================================
Sub btnTranInfo_OnClick()
	Form.SetSharedData("mbtrf31600_cldFrom" , cldFrom.caption)
	Form.SetSharedData("mbtrf31600_cldTo" , cldTo.caption)
	
	Form.OpenFramePopup("mbtrf31600_p1" , "", "")
End Sub

'============================================================================
Sub cldFrom_OnEditComplete()
	f_ClearData()
	
	DATAMANAGER.RequestTranData( "obtrf_cntg_501r" ) '국내 파생상품 양도소득 조회
