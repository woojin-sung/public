'============================================================================
Sub Form_OnFormInit()

	'ButtonC.bgcolor = 0
	'ButtonO.bgcolor = 265
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y") 
	ButtonC.fgcolor = 269
	Image2.imgpath = "alpha128.png"
End Sub
'============================================================================


'============================================================================
Sub ButtonO_OnClick()
'	홈(시장종합)으로 이동
	Form.SendReturnToParent("CloseForm", "1" )
	Form.OpenScreen("41000", "")
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y") 
	Form.CloseForm()
End Sub

'============================================================================
Sub ButtonC_OnClick()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N") 
	Form.CloseForm()
End Sub


'============================================================================
Sub Image0_OnClick()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N") 
	Form.CloseForm()
End Sub

