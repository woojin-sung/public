'============================================================================
' 화 면 명 : 외화이체 계좌별명설정 안내팝업
'============================================================================

'============================================================================
Sub Form_OnFormInit()

End Sub

'============================================================================
Sub btnAdd_OnClick()
	Form.SendReturnToParent("mbbnk64010_p9" , "")
	Form.CloseForm()
End Sub

'============================================================================
Sub btnAlias_OnClick()
	Form.OpenPopupAnimation("textkeypadpopup", "계좌별명☆☆최대 10글자 입력 가능☆1☆20" , "","2")
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "POPUP_TEXT" then
		Form.SendReturnToParent("mbbnk64010_p9" , sRet)
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)

    If sKey == "&LOGIN_AUTH" Then
        
        If sValue == "0" Or sValue == "1" Then
            Form.CloseForm()
        End If
    
    End If

End Sub

