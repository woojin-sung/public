'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szScrNo 	'호출한 화면번호

Dim g_szRetData 
Dim g_szKYC_INVT_INCL_GRAD_CODE 	'KYC투자성향등급코드
Dim g_szKYC_PROD_GRAD_CODE 		'KYC상품등급코드
Dim g_szKYC_DVPD_EPMD_CODE 		'KYC파생상품유의코드
Dim g_szKYC_DRVT_PROS_YN 			'KYC파생처리여부
Dim g_szDVPD_GRAD_CODE 			'파생상품등급코드
Dim	g_szAlertTitle			'알림타이틀
Dim g_szRet

g_szRet	=	"CANCEL"
g_szAlertTitle	=	"알림"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'setItemSetting: 각 업무에 따라 입력값 세팅
'============================================================================
Function	setGlobalItems(szInput)
	g_szScrNo	=	getListItem(szInput, 0)
	
	g_szKYC_INVT_INCL_GRAD_CODE 	=	getListItem(szInput, 1)
	g_szKYC_PROD_GRAD_CODE 		=	getListItem(szInput, 2)
	g_szKYC_DVPD_EPMD_CODE 		=	getListItem(szInput, 3)
	g_szKYC_DRVT_PROS_YN 		=	getListItem(szInput, 4)
	g_szDVPD_GRAD_CODE 			=	getListItem(szInput, 5)

End Function


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function


'===========================================================================
' 숫자 리턴함수
'===========================================================================
Function GetTonumber(sNum)
	Dim nDbl
	nDbl = 0
	
	if sNum == null or Trim(sNum) == "" then
		return nDbl
	end if
	
	nDbl = CDbl(sNum)
	
	return nDbl
End Function


