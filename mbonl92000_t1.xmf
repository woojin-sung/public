'============================================================================
Dim g_szPwd
Dim g_szAcno
Dim g_szAsno
Dim g_szSTPLYN
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "TRANCALL" then
		grd0.SetClear()
		tmp = Split(sParam, "||")
		
		g_szAcno = tmp(0)
		g_szAsno = tmp(1)
		g_szPwd = Form.GetCtlProp("#EditPW", "caption")

		DATAMANAGER.RequestTranData("oblon_lndn_019r")
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	Dim AcntPwd
	'MTS메모리보안
	Dim plain_rm
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
		'MTS메모리평문 적용상태일때
	if plain_rm == "1" then
		AcntPwd  = g_szPwd
	else
		AcntPwd  = Form.GetEncData(g_szPwd)
	end if
	'AcntPwd = Form.GetEncData(g_szPwd)
	
	if szTranID = "oblon_lndn_019r" then
		'DATAMANAGER.SetDataValue(0, "oblon_lndn_019r", "InBlock1", "MRKT_CLS_CODE", 0 , "%")
		'DATAMANAGER.SetDataValue(0, "oblon_lndn_019r", "InBlock1", "ISCD"		 , 0 , "%")
		'DATAMANAGER.SetDataValue(0, "oblon_lndn_019r", "InBlock1", "LNDN_RMND_QTY", 0 , 0)
		'DATAMANAGER.SetDataValue(0, "oblon_lndn_019r", "InBlock1", "CRDT_STPL_YN" , 0 , "%")
		'DATAMANAGER.SetDataValue(0, "oblon_lndn_019r", "InBlock1", "PROS_ABLE_YN" , 0 , "Y")
		DATAMANAGER.SetDataValue(0, "oblon_lndn_019r", "InBlock1", "ACNO", 0 	 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "oblon_lndn_019r", "InBlock1", "ASNO", 0 	 , g_szAsno)
		DATAMANAGER.SetDataValue(0, "oblon_lndn_019r", "InBlock1", "ACNT_PWD", 0  , AcntPwd)
		DATAMANAGER.SetDataValue(0, "oblon_lndn_019r", "InBlock1", "ISCD", 0  , "")
	elseif szTranID = "oblon_lndn_018a" then
		DATAMANAGER.SetEventFlag(szTranID, "A")
		datacnt = 0
		for i = 0 to grd0.rowcount - 1
			if grd0.GetCellData("bd_cell0", i) = "1" then
				if Cint(grd0.GetCellData("bd_cell4", i)) > 0 then 
					Form.ShowAlert("알림", "대여수량이 존재하는 종목이 존재합니다. (" & grd0.GetCellData("bd_cell1", i) & ")")
					exit sub
				end if

				datacnt = datacnt + 1
			end if
			
			if datacnt > 30 then
				Form.ShowAlert("알림", "최대 30건까지처리 가능합니다.")
				exit sub
			end if
		next
		
		if datacnt = 0 then
			Form.ShowAlert("알림", "처리할 대상이 없습니다..")
			exit sub
		end if
		
		datacnt = 0
		
		for i = 0 to grd0.rowcount - 1
			if grd0.GetCellData("bd_cell0", i) = "1" then
				DATAMANAGER.SetDataValue(0, "oblon_lndn_018a", "InBlock1", "ISCD" , datacnt , grd0.GetCellData("bd_cell1", i))

				
				datacnt = datacnt + 1
			end if
		next
		
		DATAMANAGER.SetDataValue(0, "oblon_lndn_018a", "InBlock2", "ACNO", 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "oblon_lndn_018a", "InBlock2", "ASNO", 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0, "oblon_lndn_018a", "InBlock2", "ACNT_PWD", 0 , AcntPwd)
		DATAMANAGER.SetDataValue(0, "oblon_lndn_018a", "InBlock2", "PROS_CLS_CODE", 0 , "0")
	end if
End Sub



'============================================================================
Sub Button0_OnClick()	
	g_szPwd = Form.GetCtlProp("#EditPW", "caption")
	

	if GetPWCheck() then
		exit Sub
	end if
	DATAMANAGER.RequestTranData("oblon_lndn_018a")
End Sub

'============================================================================
Function GetPWCheck()
	if g_szPwd == null or g_szPwd == "" then
		Form.MsgBox("알림", "비밀번호를 입력해주세요", "", 6)
		return true
	end if
	
	return false
End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "oblon_lndn_018a" then
		grd0.SetClear()
		DATAMANAGER.RequestTranData("oblon_lndn_019r")
	elseif szTranID = "oblon_lndn_019r" then
		g_szSTPLYN = DATAMANAGER.GetDataValue(0, "oblon_lndn_019r", "OutBlock2" , "STPL_YN" , 0)
		Form.triggerEvent("#", "LNDN_STPL_YN", g_szSTPLYN)
	end if	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", DATAMANAGER.GetDataMsgSubText(szTranID))
End Sub

