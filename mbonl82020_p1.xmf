	<CONTROL_INFO>
		<LABEL name="LabelBG" bgcolor="038:255255255" transmode="0" ly_vert="0,0,375,607,1" />
		<BUTTON name="btnOK" caption="확인" fgcolor="006:213049051" btnimage="btn_pop2.9" ly_vert="0,561,375,45,1" />
		<CONTAINER name="Container0" vscroll="1" scroll_pos="0,0" ly_vert="0,20,375,530,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<LABEL name="Label0" fontsize="-1" valign="0" multiline="1" ly_vert="0,0,375,760,1" />
