	<SCRIPT_INFO _len="3829" _ulen="2753" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 담보대출신청
' 02. 화면설명 : 담보대출신청_약정등록안내
' 03. 작    성 : 2016.02.01 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData 

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("융자약정안내")
	g_sRetData = "cancel"
	
	Container0.Label0.caption =
					"·업무처리 가능시간 : 평일 08:00 ~ 17:00\n"&
					"    (지점 업무 마감 후에는 처리불가)\n\n"&
					"·개인정보제공/이용/조회 동의 및 증권담보융자\n"&
	                  "    약관, 증권담보융자 설명서의 내용을 확인하시고\n"&
			         "    동의하셔야 약정 등록이 가능합니다.\n\n"&
					"·인지세법에 따라 약정 금액에 해당하는 수입인지대를\n"& 
					"    부과합니다. 해지 및 약정금액 감액 시 환급은 불가능\n"&
					"    하며, 약정금액 증액시에는 그 차액에 해당하는 수입\n"&
					"    인지대를 추가로 부과합니다.\n"&
					"    (수입인지대는 고객과 회사가 50%씩 부담합니다.)\n"&
					"    - 5천만원 이하 : 없음\n"&
					"    - 1억원 이하 : 7만원\n"&
					"    - 10억원 이하 : 15만원\n"&
					"    - 10억원 초과 : 35만원\n\n"&
					"·융자이율은 고객별로 상이할 수 있습니다.\n\n"&
					"·계좌담보유지비율 미달 시 회사는 추가담보를 요구\n"& 
					"    할 수 있습니다. 기일 내 담보 미충족 시 반대매매를\n"&  
					"    통해 임의상환 되오니, 담보관리에 유념하여 주시기\n"&  
					"    바랍니다.\n\n"&
					"·약관·이자율 등 변경정보 : SMS(또는 알림톡)로\n"& 
					"    변경내용을 요약통보합니다.\n\n"&
					"·담보관련통보 <신용거래 및 증권담보융자 공통 적용 사항>\n"& 
					"  1. 담보부족, 반대매매, 만기예정 내역을 SMS(또는 알림톡)\n"&
					"       로 통보합니다.\n"&
					"  2. 추가담보요구(담보부족) 시 전화(휴대폰→원장통보지\n"&
					"       →통보지외전화 순) 및 SMS/이메일(이메일은 선택한\n"&
					"       경우에 한함)로 통보하며, 전화/SMS/이메일 모두\n"&
					"       통보불가(발송실패) 시 내용증명으로 통보합니다.\n\n"&
					"·증권담보융자에 대한 자세한 내용은 약관 및\n"& 
					"    설명서를 확인하시기 바랍니다.\n\n"&
					"·융자약정등록 후 융자 가능계좌등록까지 진행하셔야\n"& 
					"    융자신청이 가능합니다."
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl82020_p1" , g_sRetData)
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.SendReturnToParent("mbonl82020_p1" , g_sRetData)
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>