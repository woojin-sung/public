	<SCRIPT_INFO _len="6696" _ulen="6382" >
Dim 	g_RcnoPIP
Dim 	g_MsboVrsn
Dim 	g_OSClcd
Dim 	g_OSVrsn
Dim 	g_CustTermName
Dim 	g_CustTermID
Dim 	g_MotpSrno
Dim 	g_TitleNm
	g_TitleNm = "모비일OTP 다운로드"
	
'20230803 SWJ START
Dim g_sSecurity
Dim g_sMotpRcnoPip
Dim g_sMeritzAuth
g_sSecurity = ""
g_sMotpRcnoPip = ""
g_sMeritzAuth = ""
'20230803 SWJ END
'============================================================================
Function funcCtrSetting()
	cntnInput.EdtOtpPwd.SetApplyLabel("모바일 OTP 비밀번호", 0, 268, "left", true)
	cntnInput.EdtOtpPwd.SetUseResultLabel(TRUE)
	BtnDnld.btnimage = "btn_20.9"
	
	For ix = 0 To 10
		For jx = 0 To 3
			cntnInput.Table0.SetCellBgColor(ix, jx, 272)
		Next
	Next

End Function

'============================================================================
Function funcTermInfo()
	Form.SetTimerEvent2( 0, 1, 0.3 ) 'MSBOX 정보 호출
	g_CustTermID	=	Form.GetDeviceID()
	g_OSClcd		=	Form.GetSharedData("&OS_TYPE", false)
	g_OSVrsn		=	Form.GetSharedData("&OS_VERSION", false)
	g_CustTermName	=	Form.GetDeviceModel()
End Function

'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam)
	Dim tmpList
'Form.ShowAlert(sEventName, sParam)
	tmpList = Split(sParam, "★")
	If sEventName == "MOTP_GET_VERSION_RETURN_86102" Then ' M SafeBox 버전 정보 가져오기
		If tmpList[0] == "00000" Then
			g_MsboVrsn = tmpList[2]
		Else
			Form.ShowAlert("알림", "MSB 버전 추출 오류\n"..tmpList[1])
		End If
	End If
	If sEventName == "MOTP_ISSUE_RETURN_86102" Then 'M SafeBox에 MOTP정보 심기
		If tmpList[0] == "00000" Then
			
			'20230803 SWJ START
			if g_sMeritzAuth <> "" then
				Form.SetSharedData("MeritzAuth_Security" 	, g_sMeritzAuth)
			end if
			
			if g_sMotpRcnoPip <> "" then
				Form.SetSharedData("Motp_RcnoPip" 			, g_sMotpRcnoPip)
			end if
			
			if g_sSecurity <> "" then
				Form.SetSharedData("CommonNoSecurity" 		, g_sSecurity)
			end if
			'20230803 SWJ END
			
			rslt_data = "86102" & "☆" & g_TitleNm & "☆" & "Y" & "☆" & "D" & "☆" & "모바일OTP(메리츠)" & "☆" & g_MotpSrno
		Else
			rslt_data = "86102" & "☆" & g_TitleNm & "☆" & "N" & "☆" & "D" & "☆" & "오류" & "☆" & tmpList[1]
		End If
		Form.OpenPopup( "mbotp86105_rslt.xmf", rslt_data, "" )
'		Form.CloseForm()
	End If
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_RcnoPip = Form.GetSharedData("&JUMIN_NUM", false ) '암호화로 내려옴.
	
	'20230803 SWJ START
	'true로 바꿈
	g_sMeritzAuth = Form.GetSharedData( "MeritzAuth_Security", true ) ' 간편인증 진입여부 판단
	g_sMotpRcnoPip = Form.GetSharedData("Motp_RcnoPip"  , true )
	g_sSecurity  = Form.GetSharedData("CommonNoSecurity"  , true )
	'20230803 SWJ END
	
	'20230803 SWJ START
	'간편인증 외 타 업무화면에서 보안매체 없음 팝업 사용 시
	if Len(Trim(g_RcnoPIP)) == 0 and g_sSecurity == "Y" then
		g_RcnoPIP = g_sMotpRcnoPip
	else
		if Len(Trim(g_RcnoPIP)) == 0 and g_sMeritzAuth == "MOTP" then
			g_RcnoPIP	= Form.GetSharedData( "Meritz_OTP_RCNOPIP", FALSE )
		end if
	end if
	'20230803 SWJ END
	
	funcCtrSetting()
	funcTermInfo()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obcsb_oimf_170a" Then 'OTP등록 처리'
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"    	, 0, "I" )  '발급
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "RCNO_PIP"			, 0, g_RcnoPIP )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "MSBO_VRSN"			, 0, g_MsboVrsn )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "OS_CLCD"			, 0, g_OSClcd )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "OS_VRSN"			, 0, g_OSVrsn )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "CUST_TERM_NAME"		, 0, g_CustTermName )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "CUST_TERM_ID"		, 0, g_CustTermID )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "MOTP_ATHN_DATA_CNTT"	, 0, cntnInput.EdtOtpPwd.caption )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "MOTP_DNLD_YN"		, 0, "Y" )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obcsb_oimf_170a" Then
		otpKey1	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MOTP_NO_1_KEY"	, 0)  '모바일OTP번호1키
		otpKey2	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MOTP_NO_2_KEY"	, 0)  '모바일OTP번호2키
		g_MotpSrno	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MSBO_MOTP_SRNO"	, 0)  'MOBILESAFEBOX모바일OTP일련번호
		szData = g_MotpSrno & "★" & otpKey1 & "★" & otpKey2
		Form.requestMOTP("MOTP_ISSUE" , szData , "86102")
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	If szTranID == "obcsb_oimf_170a" Then
		If szErrCode == "2430" Then
			Form.ShowAlert("알림", szErrMsg&"\n["&DATAMANAGER.GetDataMsgSubText(szTranID)&"]" )
'			cntnInput.EdtOtpPwd.SetResultLabel("1", "error", szErrMsg&"["&DATAMANAGER.GetDataMsgSubText(szTranID)&"]", "cntnInput")
		Else
			If szErrCode == "2424" Then
				rslt_data = "86102" & "☆" & g_TitleNm & "☆" & "N" &  "☆" & "I" &  "☆" & "PIN 잠김 상태" &  "☆" & "(PIN 5회 오류로 재발급이 필요합니다.)"
			Else
				rslt_data = "86102" & "☆" & g_TitleNm & "☆" & "N" &  "☆" & "R" &  "☆" & szErrMsg &  "☆" & "("&DATAMANAGER.GetDataMsgSubText(szTranID)&")"
			End If
			Form.OpenPopup( "mbotp86105_rslt.xmf" , rslt_data , "" )
'			Form.CloseForm()
		End If
	End If
End Sub

'============================================================================
Sub BtnDnld_OnClick()

	DATAMANAGER.RequestTranData( "obcsb_oimf_170a" )
End Sub


'============================================================================
Sub cntnInput_Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
'	Form.OpenScreen("87003" , "")
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	If sTimerID ==  0 Or sTimerID == "0" Then
		Form.requestMOTP("MOTP_GET_VERSION" , "" , "86102")
		Form.SetTimerEvent2( 0, 0,  0.3 )
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "rslt_ret" and sRet == "OK" then
		Form.CloseForm()
	end if
End Sub

	</SCRIPT_INFO>
