'============================================================================
function SetDataforReq()	
	g_szOKType = edtStatClsCode.caption
	
	'해외주식거래신청X, SUPER365 계좌개설X
	if g_szOKType <> "0" then
		 '해외CFD이면 
		if g_szScreenNo == "16091" then
			'1:SUPER365 계좌개설X --> 6:해외CDF계좌개설X
			if g_szOKType == "1" then 
				g_szOKType = "6"
			'2:해외주식거래신청X --> 7: 해외CFD주식거래신청X
			elseif g_szOKType == "2" then 
				g_szOKType = "7"
			end if 
		end if 
		Form.OpenFramePopup("nrsmbtro16090_p7" , g_szOKType, "")
	else		
		'해외주식거래신청O, SUPER365 계좌개설O
		Container1.left = 0
		'imgTitle2.left = 506
		imgTip.left  = 514
		lblTitle2.left  = 550
		Pannel0.left = 500
		'Form.bgcolor = "255255255"		
		
		cmbExch.cbkeydata = Pannel0.GetCellValue("lblExch", g_nSelectRow)			
		g_szOvrsStckMrktTrClsCode  = Pannel0.GetCellValue("lblExch", g_nSelectRow)	
		g_szQttnApltClcd  = Pannel0.GetCellValue("lblQttnApltClcd", g_nSelectRow)						
		
		Container1.Table0.SetCellString(1, 1, Pannel0.GetCellValue("lblName", g_nSelectRow))
		Dim sTemp
		if grdStatus.GetCellData("bd_exmpyn", g_nSelectRow) == "Y" then '무료여부
			sTemp = "무료"
		else
			sTemp = "월 " & CDbl(grdStatus.GetCellData("bd_qttnexpn", g_nSelectRow)) & " " & grdStatus.GetCellData("bd_crcd", g_nSelectRow) '해외시세비용
		end if 
		Container1.Table0.SetCellString(1, 2, sTemp) '통화코드
		
		if (Container1.acnt.caption) <> "" then
			'외화 특정통화 잔액 조회
			DATAMANAGER.SetDataValue(0,"obrtd_fcur_008r", "InBlock1", "ACNO" , 	 0 , Left(Container1.acnt.caption ,8) )		'계좌번호
			DATAMANAGER.SetDataValue(0, "obrtd_fcur_008r", "InBlock1", "ASNO" , 	 0 , MID(Container1.acnt.caption , 10,2) )	'계좌일련번호
			DATAMANAGER.SetDataValue(0, "obrtd_fcur_008r" , "InBlock1" , "CRCD" , 0 , grdStatus.GetCellData("bd_crcd", g_nSelectRow)  )
			DATAMANAGER.RequestTranData("obrtd_fcur_008r") 
		else
			Container1.Label15.visible = true
			Container1.Label17.visible = true
			Container1.btnNext.enable = false '다음			
		end if 
	end if
end function

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	g_nSelectRow = nIndex
	
	if sCellID == "btnReq" then '신청	
		if g_szScreenNo == "16091" then '해외CFD
			cmbExch.cbkeydata = Pannel0.GetCellValue("lblExch", nIndex)	
			DATAMANAGER.RequestTranData("obtro_acnt_209r")
		else
			SetDataforReq() '신청		
		end if 
		
	elseif sCellID == "btnCancel" then '해지
		'16091: CFD 실시간 시세신청한 고객이 해외주식 실시간 시세 신청 화면에서 해지하는 경우 
		'16090: 해외주식 실시간 시세신청한 고객이 해외CFD 실시간 시세 신청 화면에서 해지하는 경우 	
		if g_szScreenNo == "16091" then '해외CFD 
			if Pannel0.GetCellValue("lblPrcd", nIndex) == "137" then '해외CFD
				g_szMoveScreen =  ""
			else
				g_szMoveScreen =  "16090"
			end if 	
		else
			if Pannel0.GetCellValue("lblPrcd", nIndex) == "137" then '해외CFD
				g_szMoveScreen =  "16091"
			else
				g_szMoveScreen =  ""
			end if 
		end if 
		
		cmbExch.cbkeydata = Pannel0.GetCellValue("lblExch", nIndex)			
		g_szOvrsStckMrktTrClsCode  = Pannel0.GetCellValue("lblExch", nIndex)			
		g_szQttnApltClcd  = Pannel0.GetCellValue("lblQttnApltClcd", nIndex)			
		g_szAcntNo = Replace(Pannel0.GetCellValue("lblAccount", nIndex), "-", "") '결제계좌 
		'해지
		g_szOKType = "3"		
		Form.OpenFramePopup("nrsmbtro16090_p7" , g_szOKType, "")

	elseif sCellID == "btnEdit" then '고객정보 변경
		'고객정보만 수정
		g_szOlnyCustEdit = "Y"
		Form.OpenPopup("nrsmbtro16090_p2" , "", "")
		
	elseif sCellID == "imgQuestion" then '미국주식 실시간 시세 무료지원 안내
		Form.OpenFramePopup("nrsmbtro16090_p12" , "", "")
	end if 
End Sub

'============================================================================
Sub Container1_RgStyle_OnClick(nIndex)
	if nIndex == 2 then '기간선택
		Container1.lbInfoMsg.visible = false
		Container1.cldFromDate.visible = true
		Container1.Label10.visible = true
		Container1.cldToDate.visible = true
	elseif nIndex == 1 then '당월
		Container1.cldFromDate.visible = false
		Container1.Label10.visible = false
		Container1.cldToDate.visible = false		
		Container1.lbInfoMsg.caption = "N월 말일까지 실시간 시세를 조회할 수 있어요."
		Container1.lbInfoMsg.visible = true
	else '자동연장
		Container1.cldFromDate.visible = false
		Container1.Label10.visible = false
		Container1.cldToDate.visible = false		
		Container1.lbInfoMsg.caption = "이용 기간은 1개월 단위로 자동연장 됩니다."
		Container1.lbInfoMsg.visible = true
	end if 
	
	'미국 & 당월또는 기간선택
	if Container1.Table0.GetCellString(1, 1) == "미국" and (nIndex == 2 or nIndex == 1) and (g_szRgStyleNoClick <> true) then
		g_szOKType = "9"		
		Form.OpenFramePopup("nrsmbtro16090_p7" , g_szOKType, "")	
	end if 
	
	g_szRgStyleNoClick = false
	
End Sub

