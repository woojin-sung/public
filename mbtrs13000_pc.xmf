'============================================================================
' 화 면 명 : 주식주문_정산금팝업
' 화면설명 : 주식주문 정상금팝업
' 작    성 : 2016.01.28 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_tData
Dim g_MediaType
'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************

'============================================================================
' RequestData_CFD
'============================================================================
Function RequestData_CFD()
	tblData.SetCellString(0, 1, "")
	tblData.SetCellString(1, 1, "")
	tblData.SetCellString(2, 1, "")
	
	Dim NewTyep
	
	if g_tData(7) == "1" then
		NewTyep = "2" '청산
	else
		NewTyep = "1" '신규
	end if
	
	g_MediaType = Form.GetSharedData("&MEDIA_CODE", false) '20211006 HSZ : 수수료매체그룹코드 수정
	
	'Form.GetSharedData("CFD_AcnoType", false)'일반/안심계좌여부
'	Form.SetSharedData("CFD_IlbanAnsim" , szAcnoAB)
	DATAMANAGER.ClearInputData(0, "obtrc_cntg_004r")
	DATAMANAGER.SetDataValue(0,	"obtrc_cntg_004r", "InBlock1", "ACNO"             , 0, g_tData(0))	' 계좌번호
	DATAMANAGER.SetDataValue(0,	"obtrc_cntg_004r", "InBlock1", "ASNO"             , 0, g_tData(1))	' 계좌일련번호
	DATAMANAGER.SetDataValue(0,	"obtrc_cntg_004r", "InBlock1", "FEE_MDIA_GRP_CODE", 0, g_MediaType)	' 수수료매체그룹코드 
	DATAMANAGER.SetDataValue(0,	"obtrc_cntg_004r", "InBlock1", "MKPL_CLS_CODE"    , 0, g_tData(2))	' 매매시장구분코드
	DATAMANAGER.SetDataValue(0,	"obtrc_cntg_004r", "InBlock1", "DEAL_CLS_CODE"    , 0, g_tData(3))	' 매매구분코드
	DATAMANAGER.SetDataValue(0,	"obtrc_cntg_004r", "InBlock1", "ODQT"             , 0, g_tData(4))	' 주문수량
	DATAMANAGER.SetDataValue(0,	"obtrc_cntg_004r", "InBlock1", "ODER_UNPR"   		, 0, g_tData(5))	' 주문단가
	DATAMANAGER.SetDataValue(0,	"obtrc_cntg_004r", "InBlock1", "ISCD"             , 0, g_tData(6))	' 종목코드
	DATAMANAGER.SetDataValue(0,	"obtrc_cntg_004r", "InBlock1", "NEW_CLRN_CLCD"    , 0, NewTyep )	' 신규청산구분
	
	DATAMANAGER.RequestTranData("obtrc_cntg_004r")
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim tData
	Dim szData
	
	szAcntType = Form.GetSharedData("CFD_AcnoType", false)'일반/안심계좌여부
	
	szData = Form.GetOpenLinkData()
	'0계좌번호|1채널유형|2시장구분|3매매구분(1매도, 2매수)|4주문수량|5주문단가|6종목코드|7신규청산구분
	tData = Split(szData, "★")
	
	if UBound(tData) > 0 then
		g_tData = tData
		
		if tData(7) == "1" then '청산
			tblData1.visible = true
			Form.height = 221
		else '신규
			if szAcntType == "a" or szAcntType == "A" then
				'일반계좌
				'20230925 htw start 일반(A)+신규매도일 때 = CFD이자 삭제
				if tData(3) == "1" then
					tblData2.visible = true
					Form.height = 221
				else
					tblData0.visible = true
				end if
				'20230925 htw end 일반(A)+신규매도일 때 = CFD이자 삭제
			else
				tblData.visible = true
				Form.height = 221
			end if
		end if
		
		RequestData_CFD()
	end if
End Sub


'============================================================================
' imgClose_OnClick : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' btnClose_OnClick : 닫기
'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
' btnClose2_OnClick : 닫기
'============================================================================
Sub btnClose2_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
' btnReceive_OnClick : 조회
'============================================================================
Sub btnReceive_OnClick()
	RequestData_CFD()	
End Sub


