	<SCRIPT_INFO _len="8673" _ulen="8105" >
'============================================================================
' 01. 화 면 명 : OTP관리_이력조회
' 02. 화면설명 : OTP관리_이력조회
' 03. 작    성 : 2016. 02. 03. 유창재
' 04. 수    정 : 2017.12.26  윤유정 : OTP 공급회사 추가 016, 401 v0001
'              : 2018.07.03  윤유정 : 016 코나씨>코나아이 사명변경 v0002
'              : 2018.08.21  윤유정 : OTP 공급회사 추가 019 엠파이브 v0003
' 2020.11.19 : 정민영 : v0004 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obacp_opop_064r IO 변경분 반영
'============================================================================
'obcsb_oimf_180r TR 관련해서 들어오는 값을 보고 복사해서 사용하는지 판단해야함 -> 02.01 데이터가 없어서 추후 수정
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szData			'계좌번호
Dim g_szPW			'암호화한 PW
Dim g_CmbIndex		'OTP벤더 Index값
Dim g_nNextCount		'NextData 조회시 grid Index값 설정을 위한 변수

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SearchTR() : OTP 기기별이력조회 Test함수
'============================================================================
Function SearchTR()
	'입력조건 초기화
	edtMsgStart.caption = "001"			'요청시작위치
	edtMsgDate.caption = ""			'전문처리일자
	edtMsgCode.caption = ""			'전문일련번호
	
	if Len(Trim(edt2.caption)) < 8 then
		Form.MsgBox("알림", "OTP일련번호 확인하세요.", 0, 6)
		
		Exit Function
	end if
	
'	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_180r", "InBlock1", "ACNO" , 0 , g_szData)
'	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_180r", "InBlock1", "APRV_YN" , 0 , "N")
'	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_180r", "InBlock1", "OTP_SUPL_CO_CODE" , 0 , g_CmbIndex)
	
'	g_szPW = Form.GetSharedData("&ACCOUNT_PWD", False )
	
	DATAMANAGER.RequestTranData("obcsb_oimf_180r")
	
	NextTR()
	
End Function
'============================================================================
' NextTR() : Next 데이터 조회용 함수
'============================================================================
Function NextTR()
	
	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_180r_1", "InBlock1", "APRV_YN" , 0 , " ")
	
	if Len( Trim( edt0.caption ) ) < 1 then					'전문응답코드가 없을때
		if DATAMANAGER.IsMoreNextData( "obcsb_oimf_180r_1" ) = True then
			DATAMANAGER.RequestNextData( "obcsb_oimf_180r_1" )
		else
			if edtMsgStart.caption = "001" then
				DATAMANAGER.RequestTranData( "obcsb_oimf_180r_1" )
			end if
		end if
	else
		Exit Function
	end if
	
End Function


'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' btnNotice_OnClick() : 유의사항 팝업
'============================================================================
Sub btnNotice_OnClick()
	Form.OpenPopup("mbonl86000_p1" , "이력조회" , sPosInfo)
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam) : 조회버튼 누를시마다 조회
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "이력조회" then
		g_szData = sParam
	end if
	
	edt0.clearall = true
	edt1.clearall = true
'	edt0.caption = ""
'	edt1.caption = ""
	
	DATAMANAGER.SetDataValue( 0 , "obacp_opop_064r", "InBlock1", "ACNO" , 0 , g_szData)
	
	DATAMANAGER.RequestTranData("obacp_opop_064r")
End Sub
'============================================================================
' 
'============================================================================
Sub Form_OnFormInit()

	edtMsgStart.caption = "001"
	g_CmbIndex = "001"
	
	g_nNextCount = 0
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szCSNO		'고객번호
	Dim MsgSerial, MsgStart, MsgDate		'전문일련번호, 요청시작위치, 전문처리일자
	Dim ResCode			'치환에 사용할 OTP 응답코드
	
	if szTranID == "obacp_opop_064r" then
		
		szCSNO = DATAMANAGER.GetDataValue( 0 , "obacp_opop_064r", "OutBlock1", "CSNO" , 0)
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_120r", "InBlock1", "CSNO" , 0 , szCSNO )
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_120r", "InBlock1", "ACNO" , 0 , g_szData)
		
		DATAMANAGER.RequestTranData("obcsb_oimf_120r")
		
	elseif szTranID == "obcsb_oimf_120r" then
		edt2.caption = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_120r", "OutBlock1", "OTP_CARD_SRNO" , 0)
		
		SearchTR()
	elseif szTranID == "obcsb_oimf_180r" then			'조회성
		
		ResCode = DATAMANAGER.GetDataValue( 0 ,"obcsb_oimf_180r", "OutBlock2", "OTP_RSPN_CODE", 0)
		edt1.caption = Form.GetMetaData("OTP응답코드", ResCode)
		
		MsgStart = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_180r", "OutBlock2", "RQST_STA_STTN_NO" , 0)
		MsgDate = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_180r", "OutBlock2", "TLMS_PROS_DATE" , 0)
		MsgSerial = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_180r", "OutBlock2", "OTP_TLMS_SRNO" , 0)
		
		if Len(trim(MsgStart)) == 3 then
			edtMsgStart.caption = MsgStart
		end if
		if Len(trim(MsgDate)) == 8 then
			edtMsgDate.caption = MsgDate
		end if
		if Len(trim(MsgSerial)) == 8 then
			edtMsgCode.caption = MsgSerial
		end if
		
		NextTR()
	elseif szTranID == "obcsb_oimf_180r_1" then				'데이터사용
	
		ResCode = DATAMANAGER.GetDataValue( 0 ,"obcsb_oimf_180r_1", "OutBlock2", "OTP_RSPN_CODE", 0)
		edt1.caption = Form.GetMetaData("OTP응답코드", ResCode)
		
		MsgStart = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_180r_1", "OutBlock2", "RQST_STA_STTN_NO" , 0)
		MsgDate = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_180r_1", "OutBlock2", "TLMS_PROS_DATE" , 0)
		MsgSerial = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_180r_1", "OutBlock2", "OTP_TLMS_SRNO" , 0)
		
		if Len(trim(MsgStart)) == 3 then
			edtMsgStart.caption = MsgStart
		end if
		if Len(trim(MsgDate)) == 8 then
			edtMsgDate.caption = MsgDate
		end if
		if Len(trim(MsgSerial)) == 8 then
			edtMsgCode.caption = MsgSerial
		end if

'			if edtMsgStart.caption == "001" then
'				DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_180r", "InBlock1", "APRV_YN" , 0 , "")
'				DATAMANAGER.RequestTranData( "obcsb_oimf_180r" )
'			end if
'		end if
	end if
	
End Sub
'============================================================================
' cmb0_OnEditComplete(iIndex)
'============================================================================
Sub cmb0_OnEditComplete(iIndex)
	
	g_CmbIndex = cmb0.cbkeydata		
	
	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_180r", "InBlock1", "OTP_SUPL_CO_CODE" , 0 , g_CmbIndex)
	
End Sub

'============================================================================
' grd0_OnScrollEnd()
'============================================================================
Sub grd0_OnScrollEnd()
	
	if DATAMANAGER.IsMoreNextData( "obcsb_oimf_180r_1" ) = True then
	
		edt0.clearall = true
		edt1.clearall = true
		edtMsgCode.clearall = True
		
		DATAMANAGER.RequestTranData( "obcsb_oimf_180r")

	end if
	
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obcsb_oimf_180r" then
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_180r", "InBlock1", "ACNO" , 0 , g_szData)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_180r", "InBlock1", "APRV_YN" , 0 , "N")
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_180r", "InBlock1", "OTP_SUPL_CO_CODE" , 0 , g_CmbIndex)
	elseif szTranID == "obcsb_oimf_180r_1" then
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_180r_1", "InBlock1", "ACNO" , 0 , g_szData)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_180r_1", "InBlock1", "OTP_SUPL_CO_CODE" , 0 , g_CmbIndex)
	end if
	
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obcsb_oimf_180r" trcode="obcsb_oimf_180r" compress="1" encryption="1" inputcheck="1" useattr="0" />
