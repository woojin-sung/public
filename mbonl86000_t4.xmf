			</TRAN>
			<TRAN tranid="obacp_opop_064r" trcode="obacp_opop_064r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obcsb_oimf_180r_1" trcode="obcsb_oimf_180r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obcsb_oimf_180r" title="OTP기기별이력조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="439" _ulen="335" >

ACNO^계좌번호^8^0^0^0^0^0^0
