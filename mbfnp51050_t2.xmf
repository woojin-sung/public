	<SCRIPT_INFO _len="7897" _ulen="7449" >
Dim g_szAcno
Dim g_szAsno

Dim g_szACTL_ERT_RPRT_INAG_TYPE_CODE '실질수익률보고서통보처유형코드

Dim unPressedImgPath 
Dim PressedImgPath

'============================================================================
Sub Form_OnFormInit()

	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	unPressedImgPath = "btn_line_n.9.png"
	PressedImgPath   = "btn_line_o.9.png"

	lblChangeAddr.caption = "연락처변경 바로가기 >"
	lblChangeAddr.fgcolor = "67"
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	If sEventName == "INIT_SCREEN" And sParam <> "" And sParam <> null Then

		g_szAcno = Left(sParam, 8)
		g_szAsno = Right(sParam, 2)
		
		DATAMANAGER.RequestTranData("obcsb_acad_106r")
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	if sKeyName = "CORRECT_PWD" then

		if sRet <> "" then
			Dim szAcnt
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
'			if g_szSavePwd == "0" then
'				contInput.edtPwdIcon.imgpath = "icon_save_password_n.9"
'			else
'				contInput.edtPwdIcon.imgpath = "icon_save_password_o.9"
'			end if
			
			tData = Split(sRet, "★")
	
			if UBOUND(tData) > 0 then
				Form.SetCtlProp("#edtPassword", "pwdlen", tData(1))
				Form.SetCtlProp("#edtPassword", "caption", tData(0))
				
				DATAMANAGER.RequestTranData("obcsb_acad_107a")
			end if			
		end if
	End If	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName = "RELOAD" then	
		'통보처 재조회
		DATAMANAGER.RequestTranData("obcsb_acad_106r")
	end if
End Sub

'============================================================================
Sub lblChangeAddr_OnClick()
	Dim sSendData, sTabIdx
	sSendData = ""
'	if g_szNotiFlag == "talk" then
'		sTabIdx = "0"
'	elseif g_szNotiFlag == "email" then
		sTabIdx = "1"
'	end if
'	sSendData = contInput.cmbAccount.total..";"..contInput.edtPassword.caption..";"..sTabIdx
	Form.OpenFramePopup("mbonl81000" , sSendData , "")
End Sub

'============================================================================
Sub ImgQ1A1_OnClick()
	SetCheckAnswer("1", "1")
End Sub

'============================================================================
Sub ImgQ1A2_OnClick()
	SetCheckAnswer("1", "2")
End Sub

'============================================================================
Sub ImgQ1A3_OnClick()
	SetCheckAnswer("1", "3")
End Sub

'============================================================================
Sub ImgQ1A4_OnClick()
	SetCheckAnswer("1", "4")
End Sub

'============================================================================
Sub ImgQ1A5_OnClick()
	SetCheckAnswer("1", "5")
End Sub

'============================================================================
Sub btnOK_OnClick()
	Dim sSendData
	sSendData = g_szAcno & g_szAsno & "☆" & "0"
	'비밀번호 팝업 띄움..	
	Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")	
End Sub

'============================================================================
Function SetCheckAnswer(szQNum, szAnswerNum)
	Dim nQNum, nTIdx ' 문항번호, 테이블 인덱스
	nQNum = CDbl(szQNum)
	nTIdx = nQNum - 1

	nAnswerCnt = 5

	if szAnswerNum == "1" then
		g_szACTL_ERT_RPRT_INAG_TYPE_CODE = "51"	'온라인(직접)조회 = 수신거부
	elseif szAnswerNum == "2" then
		g_szACTL_ERT_RPRT_INAG_TYPE_CODE = "31"	'알림톡(SMS)
	elseif szAnswerNum == "3" then
		g_szACTL_ERT_RPRT_INAG_TYPE_CODE = "21"	'이메일
	elseif szAnswerNum == "4" then
		g_szACTL_ERT_RPRT_INAG_TYPE_CODE = "01"	'자택
	elseif szAnswerNum == "5" then
		g_szACTL_ERT_RPRT_INAG_TYPE_CODE = "02"	'직장
	end if
	
'	ShowAlert("u", g_szACTL_ERT_RPRT_INAG_TYPE_CODE)
	
	Select case nQNum
	    ' 버튼형 답변
	    case 1
		    for j = 1 to CDbl(nAnswerCnt)
			    if j == CDbl(szAnswerNum) then
				    Form.SetCtlProp("ImgQ" & nQNum & "A" & j, "imgpath", PressedImgPath)
			    else
				    Form.SetCtlProp("ImgQ" & nQNum & "A" & j, "imgpath", unPressedImgPath)
			    end if
		    next
    End Select
End Function

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obcsb_acad_106r" then	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , g_szAcno)	'계좌번호
	
	elseif szTranID = "obcsb_acad_107a" then	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "U" )	'처리구분코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4" )	'접촉구분코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"	 		, 0 , g_szAcno )	'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACTL_ERT_RPRT_INAG_TYPE_CODE" , 0 , g_szACTL_ERT_RPRT_INAG_TYPE_CODE )	'실질수익률보고서통보처유형코드		
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("#edtPassword", "caption"))	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("#edtPassword", "encdata"))			
		end if
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CSNO"	 				, 0 , g_szAcno )	'고객번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CUST_TYPE_CODE"			, 0 , g_szAcno )	'고객유형코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "MGRI_RPRT_INAG_SRNO"	, 0 , g_szAcno )	'운용보고서통보처일련번호
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obcsb_acad_106r" then	
		szACTL_ERT_RPRT_INAG_TYPE_CODE = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "ACTL_ERT_RPRT_INAG_TYPE_CODE", 0)	'실질수익률보고서통보처유형코드

		'버튼 초기화
	    for j = 1 to 5
		    Form.SetCtlProp("ImgQ1A" & j, "imgpath", unPressedImgPath)
	    next
'ShowAlert("q", szACTL_ERT_RPRT_INAG_TYPE_CODE)
		If szACTL_ERT_RPRT_INAG_TYPE_CODE == "51" then 	'수신거부
			ImgQ1A1.imgpath = PressedImgPath
			
		ElseIf szACTL_ERT_RPRT_INAG_TYPE_CODE == "31" then 	'알림톡
			ImgQ1A2.imgpath = PressedImgPath
			
		ElseIf szACTL_ERT_RPRT_INAG_TYPE_CODE == "21" then 	'E-mail
			ImgQ1A3.imgpath = PressedImgPath
			
		elseIf szACTL_ERT_RPRT_INAG_TYPE_CODE == "01" then 		'자택
			ImgQ1A4.imgpath = PressedImgPath
			
		ElseIf szACTL_ERT_RPRT_INAG_TYPE_CODE == "02" then 	'직장
			ImgQ1A5.imgpath = PressedImgPath
		else 	
			ImgQ1A1.imgpath = unPressedImgPath
			ImgQ1A2.imgpath = unPressedImgPath
			ImgQ1A3.imgpath = unPressedImgPath
			ImgQ1A4.imgpath = unPressedImgPath
			ImgQ1A5.imgpath = unPressedImgPath
		End If
		
	elseif szTranID = "obcsb_acad_107a" then	
		Form.MsgBox("안내", "통보처 변경이 완료되었습니다.", "RELOAD", 0)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szTranID = "obcsb_acad_106r" then
		ImgQ1A1.imgpath = unPressedImgPath
		ImgQ1A2.imgpath = unPressedImgPath
		ImgQ1A3.imgpath = unPressedImgPath
		ImgQ1A4.imgpath = unPressedImgPath
		ImgQ1A5.imgpath = unPressedImgPath
	end if 
	
	'Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	'Form.ShowAlert("알림", szSubMsg)
	'DATAMANAGER.RequestTranData("obcsb_acad_106r")	'통보처 재조회
End Sub

