Dim g_nFontSize,g_szTitle,g_szDate,g_szURL	
Dim g_sDeviceOS, g_serverMode
Dim g_nIndex
'============================================================================
Sub Form_OnFormInit()
	'웹 캐시삭제
	WebView0.RemoveCache()
	
'	'20221026 SWJ START : 테스트계 운영계 나눔
	g_serverMode = Form.GetSharedData("&SERVER_MODE", false)
'	'20221026 SWJ END
	
	Dim szData, arrData

	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	

	g_szTitle		= arrData(0)
	g_szDate			= arrData(1)
	g_szURL			= arrData(2)
	g_szCls			= CStr(arrData(3))	'00:공지사항, 01:증거금변경
	
	Label0.caption = g_szTitle
	Label1.caption = g_szDate
	if g_szCls = "00" then
		FormTab0.currenttab = 0
		LabelTitle.caption = "공지사항"
		g_szURL = Replace(g_szURL, "help13nv", "help13v")
	else
		LabelTitle.caption = "증거금 변경"
		FormTab0.currenttab = 1
		g_szURL = Replace(g_szURL, "guarantee", "guaranteevn_vm_mts")
	end if
	
'	Form.ShowAlert("test", g_szURL)
	WebView0.urlpath = g_szURL
	
	g_sDeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS

	'모바일 웹에서 어떤 OS인지 판단할 수 있음(javascript 먼저 set해야함)
	if g_sDeviceOS == "1" then
		WebView0.SetUserAgent("meritz_android")
	elseif g_sDeviceOS == "2" then
		WebView0.SetUseJavaScript("1")
		WebView0.SetUserAgent("meritz_ios")
	else
	end if
	
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "WebViewReturn" then
		sData = Split(sParam,"@")
		
		'1: 맵파일 바로 호출, 2: 웹, 3: 맵파일 호출 전 파라미터 받는 경우
		if Ubound(sData) > 0 then
			if sData(0) == "1" then
				if sData(1) == "88031" then
					'Form.OpenScreen(sData(1) , "")
					Form.OpenNextPopup("mbonl88031","","")
				end if
			end if
		elseif sData(0) == "2" then
'			If g_serverMode == "1" Then	'개발기
'				szWebUrl = Replace(sData(1),"home.imeritz.com","testhome.imeritz.com")
'			else
				szWebUrl = sData(1)
'			end if
			Form.OpenExternalBrowser(szWebUrl)
		end if
		
	end if
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)

	'웹 캐시삭제
	WebView0.RemoveCache()
	
	if CInt(nCurrentTab) = 0 then
		LabelTitle.caption = "공지사항"
'	If g_serverMode == "1" Then	'개발기
'		WebView0.urlpath = "https://testhome.imeritz.com/mobile/sub/mts_notice.html"
'	else
		WebView0.urlpath = "https://home.imeritz.com/mobile/sub/mts_notice.html"
'	end if
	else
		LabelTitle.caption = "증거금변경"
'	If serverMode == "1" Then	'개발기
'		WebView0.urlpath = "https://testhome.imeritz.com/mobile/sub/mts_guaranteevn.html"
'	else
		WebView0.urlpath = "https://home.imeritz.com/mobile/sub/mts_guaranteevn.html"
'	end if
	end if
	
End Sub

