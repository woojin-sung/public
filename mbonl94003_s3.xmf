	<SCRIPT_INFO _len="5126" _ulen="4774" >
'--===========================================================================
' 01. 화 면 명 : 전환(분류)신청_타사지정고객신청안내
' 02. 화면설명 : 
' 03. 작    성 : 2021.08.02 정효영
' 04. 수    정 : 
'
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAccount

g_szAccount = ""
''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "changeAccount" then
		g_szAccount = sParam
	end if
End Sub

'============================================================================
' Form_OnMsgBoxClose(sKeyName, sRet)
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	' 이미지 업로드 가능한 신규 앱 업데이트 하도록 마켓으로 이동
	if sKeyName = "ELSE_APPVER" and sRet = "ok" then
		Form.openExternalBrowser("https://play.google.com/store/apps/details?id=com.imeritz.smartmeritz" ) 
	elseif sKeyName = "iOS_APPVER" and sRet = "ok" then
		WebView0.urlpath = "http://itunes.apple.com/app/id1104272974?mt=8"
	end if
End Sub


'============================================================================
' Container0_btnNext_OnClick()
'============================================================================
Sub Container0_btnNext_OnClick()
	Dim szOsType, appVer

	szOsType = Form.GetSharedData( "&OS_TYPE", False)
	appVer = Form.GetSharedData("&APP_VERSION", false )
	appVer = replace(appVer,".","")
	
	'iOS
	if szOsType = "2" then
		if Cint(appVer) < 255 then 'iOS 앱버전 2.5.5
			Form.MsgBox("알림", "메리츠SMART 업데이트가 필요합니다.\n\n업데이트 하시겠습니까?", "iOS_APPVER", 2)
			return
		end if
		
'	'안드로이드
	else
		if Cint(appVer) < 208 then '안드로이드 앱버전 2.0.8
			Form.MsgBox("알림", "메리츠SMART 업데이트가 필요합니다.\n\n업데이트 하시겠습니까?", "ELSE_APPVER", 2)
			return
		end if
	end if
	
	Dim szPassword

	szPassword = Form.GetCtlProp( "#edtPassword", "caption" )
		
	if szPassword == NULL or szPassword == "" then
		Form.ShowAlert("알림", "비밀번호를 확인하세요")
	else
		DATAMANAGER.RequestTranData( "obcsb_acif_111a" )
	end if
End Sub

'''****************************************************************************
'''               		D A T A				M A N A G E R               
'''****************************************************************************

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCustNum
	szCustNum = Form.GetSharedData("&CUST_NUM", false )
	
	if szTranID == "obcsb_acif_111a" then		
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0, "S" ) '처리구분코드
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ACNO" , 0, g_szAccount ) '계좌번호
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0, szCustNum ) '고객번호		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	
	if szTranID == "obcsb_acif_111a" then		
		Dim szMsg, szSubMsg, szMsgCode
		
		szMsg		= DATAMANAGER.GetDataMsgText( szTranID )
		szSubMsg		= DATAMANAGER.GetDataMsgSubText( szTranID )
		szMsgCode	= DATAMANAGER.GetDataMsgCode( szTranID )
		
		if szMsgCode == "0000" then
			Form.OpenPopup("mbonl94003_p3" , g_szAccount , "")
		else
			if szSubMsg == NULL or szSubMsg == "" then
				Form.ShowAlert( "알림" , szMsg )
			else
				Form.ShowAlert( "알림" , szMsg & "(" & szSubMsg & ")" )
			end if
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 에러
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	if szSubMsg == "" then
		Form.ShowAlert("알림", szErrMsg)
	else
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	end if
End Sub
	</SCRIPT_INFO>
