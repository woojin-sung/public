	<SCRIPT_INFO _len="5968" _ulen="5860" >

Dim g_szAccountNumber	'계좌번호

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_szAccountNumber = Form.GetOpenLinkData()	
	if Trim(g_szAccountNumber) <> "" then
		DATAMANAGER.SetDataValue(0, "obpds_srvc_070r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_120r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_072r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		DATAMANAGER.SetDataValue(0, "obrtp_comn_017r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		DATAMANAGER.SetDataValue(0, "obrtp_comn_018r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)
		
		DATAMANAGER.RequestTranData("obpds_srvc_070r")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "obpds_srvc_070r" then
		Dim szCsno
		szCsno = DATAMANAGER.GetDataValue(0, "obpds_srvc_070r", "OutBlock1", "CSNO" , 0)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_072r", "InBlock1", "CSNO" , 0 , szCsno)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "CSNO" , 0 , szCsno)
		DATAMANAGER.RequestTranData("obpds_srvc_120r")	
	elseif szTranID == "obpds_srvc_120r" then
		Dim szSec
		szSec = DATAMANAGER.GetDataValue(0,  "obpds_srvc_120r", "OutBlock1", "SECU_GRAD_CLS_CODE", 0)
		
		If szSec == "01" Then
		    Table2.SetCellString(0 , 1 , "1등급[OTP]")
		ElseIf szSec == "02" Then
		    Table2.SetCellString(0 , 1 , "2등급[보안카드]")
		ElseIf szSec == "03" Then
		    Table2.SetCellString(0 , 1 , "3등급[보안카드]")
		ElseIf szSec == "04" Then
		    Table2.SetCellString(0 , 1 , "1등급[모바일OTP]")
		End If
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_123r", "InBlock1", "SECU_GRAD_CLS_CODE" , 0 , szSec)
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_123r", "InBlock1", "SVCD", 0 , "019")
		DATAMANAGER.RequestTranData("obpds_srvc_123r")	
	elseif szTranID == "obpds_srvc_123r" then
		DATAMANAGER.SetDataValue(0, "obpds_srvc_069r", "InBlock1", "SVCD" , 0 , "019")
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_069r", "InBlock1", "PROS_CLS_CODE", 0 , "U")
		DATAMANAGER.RequestTranData("obpds_srvc_069r")	
	elseif szTranID == "obpds_srvc_069r" then
		Dim szSvc
		szSvc = DATAMANAGER.GetDataValue(0, "obpds_srvc_069r", "OutBlock1", "SVC_SRNO" , 0)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_072r", "InBlock1", "SVC_SRNO" , 0 , szSvc)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_072r", "InBlock1", "SVCD" , 0 , "019")
		DATAMANAGER.RequestTranData("obpds_srvc_072r")	
	elseif szTranID == "obpds_srvc_072r" then
		Dim nCnt, nOneLim, nDayLim, n2OneLim, n2DayLim
		nCnt = DATAMANAGER.GetDataCount(0, "obpds_srvc_123r", "OutBlock1")
		
		if nCnt > 0 then
			nOneLim = 0
			nDayLim = 0
			for i=0 to nCnt-1
				Dim szCode
				szCode = DATAMANAGER.GetDataValue(0,"obpds_srvc_123r", "OutBlock1", "ODER_CHAN_TYPE_CLS_CODE"  , i)
				if szCode = "020" then
					nOneLim = CDbl(DATAMANAGER.GetDataValue(0,  "obpds_srvc_123r", "OutBlock1", "T1_TACT_LIMT_AMT", i))
					nDayLim = CDbl(DATAMANAGER.GetDataValue(0,  "obpds_srvc_123r", "OutBlock1", "D1_TACT_LIMT_AMT", i))
				end if
			next			
		end if

		n2OneLim = CDbl(DATAMANAGER.GetDataValue(0, "obpds_srvc_072r", "OutBlock1", "T1_TACT_LIMT_AMT" , 0))
		n2DayLim = CDbl(DATAMANAGER.GetDataValue(0,  "obpds_srvc_072r", "OutBlock1", "D1_TACT_LIMT_AMT", 0))
		
		if nOneLim == n2OneLim then
			'1회이체한도
			Table0.SetCellString( 0, 1, nOneLim )
		else
			if nOneLim > n2OneLim then
				Table0.SetCellString( 0, 1, n2OneLim )
			elseif nOneLim < n2OneLim then
				Table0.SetCellString( 0, 1, nOneLim  )

			end if
		
		end if
		
		
		if nDayLim == n2DayLim then
			'1일이체한도
			Table0.SetCellString( 1, 1, nDayLim  )
		else
			if nDayLim > n2DayLim then
				Table0.SetCellString( 1, 1, n2DayLim )
			elseif nDayLim < n2DayLim then
				Table0.SetCellString( 1, 1, nDayLim  )
			end if		
		end if
		
		'이체한도약정 해지 시 0원으로 SET
		if DATAMANAGER.GetDataValue(0, "obpds_srvc_069r", "OutBlock1", "STPL_STAT_CLS_CODE" , 0) <> "01" then
			Table0.SetCellString( 0, 1, 0 )
			Table0.SetCellString( 1, 1, 0 )
		end if
		
		'보안등급 1등급인 경우 
		if DATAMANAGER.GetDataValue(0,  "obpds_srvc_120r", "OutBlock1", "SECU_GRAD_CLS_CODE", 0) = "01" then
			Table0.SetCellString( 0, 1, n2OneLim )
			Table0.SetCellString( 1, 1, n2DayLim )
		end if	     
	 
	     DATAMANAGER.SetDataValue( 0, "obrtp_comn_017r", "InBlock1", "ACNO", 0, g_szAccountNumber )
	     DATAMANAGER.SetDataValue( 0, "obrtp_comn_017r", "InBlock1", "RCPY_DATE", 0, Form.GetSharedData("&BIZ_DT" , false) )
 	     DATAMANAGER.SetDataValue( 0, "obrtp_comn_017r", "InBlock1", "ODER_CHAN_TYPE_CLS_CODE", 0, "020" )
		DATAMANAGER.RequestTranData( "obrtp_comn_017r" )
	elseif szTranID == "obrtp_comn_017r" then
		Edit0.caption = CDbl( DATAMANAGER.GetDataValue (0, "obrtp_comn_017r", "OutBlock1", "TR_AMT", 0 )) 
		
	     DATAMANAGER.SetDataValue( 0, "obrtp_comn_018r", "InBlock1", "ACNO", 0, g_szAccountNumber )
          DATAMANAGER.SetDataValue( 0, "obrtp_comn_018r", "InBlock1", "TACT_CLS_CODE", 0, "03" )
	     DATAMANAGER.SetDataValue( 0, "obrtp_comn_018r", "InBlock1", "ODER_CHAN_TYPE_CLS_CODE", 0, "020" )
          DATAMANAGER.RequestTranData( "obrtp_comn_018r" )	
	     
     elseif szTranID == "obrtp_comn_018r" then
          Edit1.caption = CDbl( DATAMANAGER.GetDataValue (0, "obrtp_comn_018r", "OutBlock1", "D1_TACT_LIMT_AMT", 0 )) 
	  
	     dim nRmnn_amt
	     nRmnn_amt =  CDbl(Edit1.Caption) -  CDbl(Edit0.Caption) 
	     Table0.SetCellString( 2, 1, nRmnn_amt  )
	end if
	
	
End Sub

'============================================================================


