Sub Form_OnFormInitBefore()
	'20180308_01 KBC : KRX300 & KSQ150상품추가 (설정저장이 안되서 다시 추가 함) (보류)
	'                  차트 수정 후 테스트해보고 운영반영
	'20180621 HAMWG : MTS 강제배포 진행
	if g_szItemMarket = "JF" or g_szItemMarket = "JO" then
		ChartEx1.SetLoadChart("future")
	else
		ChartEx0.SetLoadChart("future")
	end if
	
	' 20190404 HWG START
	' 차트 분,틱 설정값 세팅 오류 수정
	szMin0 = Form.GetEnvData( "chart_min0" )
	szTic0 = Form.GetEnvData( "chart_tic0" )

	if szMin0 = "" or szMin0 = 0 then
		szMin0 = "1"
	end if
	
	if szTic0 = "" or szTic0 = 0 then
		szTic0 = "1"
	end if
	
	RadioGroup0.SetRadioCaption( 2, szMin0.."분" )
	RadioGroup0.SetRadioCaption( 3, szTic0.."틱" )
	' 20190404 HWG END

End Sub

