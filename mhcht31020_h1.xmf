'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName = "SEARCH" then
		'20170123 HWG START - 종목검색 시, 종목 선택한 경우에만 진행
		if sReturn1 <> "" or sRturn1 <> null then
			g_szItemCode = sReturn1
			g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
			
			'------------------------------------------------
			'20170208 LES START - 연결선물일 경우 임의로 셋팅
			'------------------------------------------------
			g_continue_Code = ""
			g_continue_itemcode = ""
			
			if sReturn1 = "continue" then			'코스피200 연결선물
				g_szItemCode = "101000"
				g_szItemMarket = "F"
				
			elseif sReturn1 = "continue_mini" then	'미니코스피 연결선물
				g_szItemCode = "105000"
				g_szItemMarket = "MF"
				
			'20180308_01 KBC START : KRX300 & KSQ150상품추가
			elseif sReturn1 = "continue_108000" then 'KRX300 연결선물
				g_szItemCode = "108000"
				g_szItemMarket = "XF"

			elseif sReturn1 = "continue_106000" then 'KSQ150 연결선물
				g_szItemCode = "106000"
				g_szItemMarket = "F"
			'20180308_01 KBC END
			
			' 20240412 HSZ START : 코스닥글로벌지수 추가
			elseif sReturn1 = "continue_1AG000" then
				g_szItemCode = "1AG000"
				g_szItemMarket = "KF"
			' 20240412 HSZ END
				
			elseif Left(Trim(sReturn1),9) = "continue_" then
				g_continue_Code = sReturn1
				g_szItemMarket = "JF"
				g_continue_itemcode = Right(Trim(sReturn1),Len(Trim(sReturn1)) - 9)
				
			end if
			'------------------------------------------------
			'20170208 LES END
			'------------------------------------------------
			
			DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
			DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
			
			DATAMANAGER.RequestTranData("ohhts_1001_001r")
		
			RequestData()
		end if
		'20170123 HWG END
	end	if	
End Sub
'20170119 HWG END

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'20220523 HSZ 가로화면 화면집계 서비스호출 추가
	if szTranID = "ohhts_open_001r" then
		szID = Form.GetSharedData("&USER_ID", false )
		szOSType = Form.GetSharedData("&OS_TYPE", false)'1.안드로이드 2.iOS
		if szOSType <> "" then
			szOSType = szOSType + 2
		end if
			
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SORT_CLS" , 0 , szOSType) 'OS_TYPE 3:MTS(안드로이드) 4:MTS(iOS)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NO" , 0 , "31021") '하드코딩(미사용 화면번호)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FID_SCR_NAME" , 0 , "선옵차트(가로)") '하드코딩
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "USER_ID" , 0 , szID) '최근 로그인 아이디
	end if
	'20220523 HSZ END
End Sub

