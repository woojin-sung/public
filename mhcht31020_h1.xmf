'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	if nIndex = 0 then  '일
		g_flagMin = false
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "D"
		
		PeriodSet(g_szChrtType)
		
	elseif nIndex = 1 then  '주/월
		g_flagMin = false
		g_flagTic = false
		
		if g_flagWeek = false   then
			sTemp = RadioGroup0.GetRadioCaption(1)
			if sTemp = "월" then
				g_szChrtType = "M"
			else
				g_szChrtType = "W"
			end if
			
			g_flagWeek = true
			PeriodSet(g_szChrtType)
			
		else
			sTemp = RadioGroup0.GetRadioCaption(1)
			Form.OpenPopup( "mhcht13000_h4.xmf" , sTemp , "" )
			
		end if		
'		if g_flagWeek = true   then
'			if g_szChrtType = "W" then
'				g_szChrtType = "M"
'				g_flagWeek = false
'				RadioGroup0.SetRadioCaption( 1, "월" )
'			else
'				g_szChrtType = "W"
'			end if
'		else
'			if g_szChrtType = "M" then
'				g_szChrtType = "W"
'				g_flagWeek = true
'				RadioGroup0.SetRadioCaption( 1, "주" )
'			else
'				g_szChrtType = "M"
'			end if
'		end if	
'		PeriodSet(g_szChrtType)
'	elseif nIndex = 2 then  '월
'		g_szChrtType = "M"
'		PeriodSet(g_szChrtType)

	elseif nIndex = 2 then   '분
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "A"	'PENTA13 START => 2023.08.08(차트성능개선)
		'g_szChrtType = "1"
		
		if g_flagMin = false then
			g_flagMin = true
			tmpMin = split(RadioGroup0.GetRadioCaption(2), "분")
			g_szMinType = tmpMin[0]
			PeriodSet(g_szChrtType)
			
		else
			'g_flagMin = false
			Form.OpenPopup( "mhcht13000_h2.xmf" , g_szMinType , "" )
			
		end if
		
	elseif nIndex = 3 then   '틱
		g_flagMin = false
		g_flagWeek = false
		g_szChrtType = "T"	''PENTA13 START => 2023.08.08(차트성능개선)
		'g_szChrtType = "0"
		
		if g_flagTic = false then
			g_flagTic = true
			tmpTic = split(RadioGroup0.GetRadioCaption(3),"틱")
			g_szTicType = tmpTic[0]
			PeriodSet(g_szChrtType)
			
		else
			Form.OpenPopup( "mhcht13000_h3.xmf" , g_szTicType , "" )
			'g_flagTic = false

		end if
	end if	
End Sub
'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================



'============================================================================
' 차트 설정 개수 변경시
'============================================================================
function ChartEx0_OnByNumber(Count)
	if #Count = 1 then
		Count = "000"..Count
	elseif #Count = 2 then
		Count = "00"..Count
	elseif #Count = 3 then
		Count = "0"..Count
	end if

	g_sChartCnt = Count
	RequestData()	
end function
'============================================================================
function ChartEx1_OnByNumber(Count)
	if #Count = 1 then
		Count = "000"..Count
	elseif #Count = 2 then
		Count = "00"..Count
	elseif #Count = 3 then
		Count = "0"..Count
	end if

	g_sChartCnt = Count
	RequestData()	
end function

'============================================================================
' 분,틱 설정파일 저장
'============================================================================
function Save_ini()
	dim sMin, sTic, sflag
	
	for i = 0 to 6 
		Form.SetEnvData( 1, "chart_mflag"..i, g_chartMinFlagArr[i] )
		Form.SetEnvData( 1, "chart_min"..i, g_chartMinArr[i] )
		
		Form.SetEnvData( 1, "chart_tflag"..i, g_chartTicFlagArr[i] )
		Form.SetEnvData( 1, "chart_tic"..i, g_chartTicArr[i] )
	next

'	Form.SetEnvData( 1, "chart_Count", g_sChartCnt )			' 데이터갯수...필요 없음 삭제 해도 됩니다.

end function
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "Chart_Min" then
		g_szMinType = sRet
		RadioGroup0.SetRadioCaption( 2, g_szMinType )
		tmpMin = split(RadioGroup0.GetRadioCaption( 2),"분")
		g_szMinType = tmpMin[0]
		
		PeriodSet(g_szChrtType)
		
	elseif sKeyName = "Chart_Tic" then
		g_szTicType = sRet		
		RadioGroup0.SetRadioCaption( 3, g_szTicType)
		tmpTic = split(RadioGroup0.GetRadioCaption( 3),"틱")
		g_szTicType = tmpTic[0]
		
		PeriodSet(g_szChrtType)
		
	elseif sKeyName = "Chart_WEEK" then	
		if sRet = "월" then
			g_szChrtType = "M"
		else
			g_szChrtType = "W"
		end if
		
		RadioGroup0.SetRadioCaption( 1, sRet)
		
		PeriodSet(g_szChrtType)			
	
	end if
End Sub

'============================================================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'============================================================================
function PeriodSet(sPeriodType)
	if sPeriodType = "T" then		'PENTA13 START => 2023.08.08(차트성능개선)
	'if sPeriodType = "0" then
	   g_sPeriod = g_szTicType
	   g_sPeriodType = "0"
	
	elseif sPeriodType = "A" then	'PENTA13 START => 2023.08.08(차트성능개선)
	'elseif sPeriodType = "1" then
	   g_sPeriod = g_szMinType
	   g_sPeriodType = "1"
	   
	elseif sPeriodType = "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod = "1"
	   
	elseif sPeriodType = "W" then 
	   g_sPeriodType = "3"
	   g_sPeriod = "1"
	    
	elseif sPeriodType = "M" then 
	   g_sPeriodType = "4"
	   g_sPeriod = "1"
	end if

	sPeriod = CInt( g_sPeriod )
	if Len( sPeriod )= 1 then
		g_sPeriod = "00"..g_sPeriod
	elseif Len( sPeriod )= 2 then
		g_sPeriod = "0"..g_sPeriod
	end if

	if g_szItemMarket = "JF" or g_szItemMarket = "JO" then
		ChartEx1.SetPeriodType(g_sPeriodType)
		ChartEx1.SetPeriodTime(g_sPeriod)
		
	else
	   ChartEx0.SetPeriodType(g_sPeriodType)
	   ChartEx0.SetPeriodTime(g_sPeriod)

	end if

	' 조회TR 보내기
	RequestData()		
end function
'============================================================================
'20230905 한국금융IT START : 일주월분 차트 주기 설정
function PeriodSetChart(sPeriodType)
	if sPeriodType = "T" then
	'if sPeriodType = "0" then
	   g_sPeriod = g_szTicType
	   g_sPeriodType = "0"
	
	elseif sPeriodType = "A" then
	'elseif sPeriodType = "1" then
	   g_sPeriod = g_szMinType
	   g_sPeriodType = "1"
	   
	elseif sPeriodType = "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod = "1"
	   
	elseif sPeriodType = "W" then 
	   g_sPeriodType = "3"
	   g_sPeriod = "1"
	    
	elseif sPeriodType = "M" then 
	   g_sPeriodType = "4"
	   g_sPeriod = "1"
	end if

	sPeriod = CInt( g_sPeriod )
	if Len( sPeriod )= 1 then
		g_sPeriod = "00"..g_sPeriod
	elseif Len( sPeriod )= 2 then
		g_sPeriod = "0"..g_sPeriod
	end if

	if g_szItemMarket = "JF" or g_szItemMarket = "JO" then
		ChartEx1.SetPeriodType(g_sPeriodType)
		ChartEx1.SetPeriodTime(g_sPeriod)
		
	else
		ChartEx0.SetPeriodType(g_sPeriodType)
		ChartEx0.SetPeriodTime(g_sPeriod)

	end if
end function
'20230905 한국금융IT END : 일주월분 차트 주기 설정
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'-------------------------------------------------------------------------------------
	'20170213 LES START - 연결선물
	'-------------------------------------------------------------------------------------
	if szTranID = "ohhts_3050_001r" then	
		if g_szItemCode = "101000" then			'3050_001r 서비스에서 outBlock으로 연결선물(101000,105000)
			szIsnm = "연결선물"					'단축종목코드, 한글종목명를 안내려줘 화면단에서 연결선물일 경우에만 임의로 셋팅
			szIscd = "101000"						'이외의 경우에는 서비스에서 내려주는 단축종목코드, 한글종목명을 사용

		elseif g_szItemCode ="105000" then
			szIsnm = "연결선물"
			szIscd = "105000"
			
		'20180308_01 KBC START : KRX300 & KSQ150상품추가
		elseif g_szItemCode ="108000" then
			szIsnm = "연결선물"
			szIscd = "108000"
			
		elseif g_szItemCode ="106000" then
			szIsnm = "연결선물"
			szIscd = "106000"			
		'20180308_01 KBC END
		
		' 20240412 HSZ START : 코스닥글로벌지수 추가
		elseif g_szItemCode ="1AG000" then
			szIsnm = "연결선물"
			szIscd = "1AG000"	
		' 20240412 HSZ END
			
		elseif Left(Trim(g_continue_Code),9) = "continue_" then
			szIsnm = "연결선물"
			szIscd = g_continue_itemcode
			
'			g_continue_itemcode = Right(Trim(sReturn1),Len(Trim(sReturn1)) - 9)
		else
			szIsnm = DATAMANAGER.GetDataValue(0, "ohhts_3050_001r", "OutBlock1", "FID_KOR_ISNM", 0)
			szIscd = DATAMANAGER.GetDataValue(0, "ohhts_3050_001r", "OutBlock1", "FID_SHRN_ISCD", 0)
			
		end if
		
		tblHoga.SetCellString(0, 0, szIsnm)
		tblHoga.SetCellString(1, 0, szIscd)
		
	end if
	'-------------------------------------------------------------------------------------
	'20170213 LES END - 연결선물
	'-------------------------------------------------------------------------------------

	'20170427 LES START - 연결선물일 경우 실시간은 최근월물로 올림   
	If g_szItemMarket = "F" Or g_szItemMarket = "MF" Or g_szItemMarket = "XF" Or g_szItemMarket = "KF" Then '20180308_01 KBC : KRX300 & KSQ150상품추가	' 20240412 HSZ START: 코스닥글로벌지수 추가
		if g_szItemCode = "101000" then
			szCode = Form.GetFutureCode(0, false, true)
			DATAMANAGER.SetDataValue( 1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
			DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
			
		elseif g_szItemCode = "105000" then
			szCode = Form.GetFutureCode(0, true, true)
			DATAMANAGER.SetDataValue( 1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
			DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
			
		'20180308_01 KBC START : KRX300 & KSQ150상품추가
		elseif g_szItemCode = "108000" then
			szCode = Form.GetFutureCodeNew(0, 2, true) '0.코스피200 1.미니코스피 2.KRX300 3.KSQ150
			DATAMANAGER.SetDataValue( 1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
			DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
			
		elseif g_szItemCode = "106000" then
			szCode = Form.GetFutureCodeNew(0, 3, true) '0.코스피200 1.미니코스피 2.KRX300 3.KSQ150
			DATAMANAGER.SetDataValue( 1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
			DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
		'20180308_01 KBC END	
		
'		 20240412 HSZ START : 코스닥글로벌지수 추가
		elseif g_szItemCode = "1AG000" then
			szCode = Form.GetFutureCodeNew(0, 4, true)
			DATAMANAGER.SetDataValue( 1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , szCode )
			DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
		'20240415 HSZ END
		
		else
			DATAMANAGER.SetDataValue( 1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
			DATAMANAGER.RequestRealData( "ohhts_futs_cntg" )
			
		end if
	
	elseif g_szItemMarket = "JF" then
		if Left(Trim(g_continue_Code),9) = "continue_" then
			g_szItemCode = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FID_SHRN_ISCD" , 0 )
			
			DATAMANAGER.SetDataValue( 1, "ohhts_sfut_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
			DATAMANAGER.RequestRealData( "ohhts_sfut_cntg" )
			
		else
			DATAMANAGER.SetDataValue( 1, "ohhts_sfut_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
			DATAMANAGER.RequestRealData( "ohhts_sfut_cntg" )
			
		end if
		
	elseif g_szItemMarket = "JO" then
		DATAMANAGER.SetDataValue( 1, "ohhts_sopt_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_sopt_cntg" )
	
	'20221117 LES START (CF:금 FF:국채/미달러/엔/유로)
	elseif g_szItemMarket = "CF" or g_szItemMarket = "FF" then	'20220915 HSZ 상품선물 추가
		DATAMANAGER.SetDataValue( 1, "ohhts_cfut_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_cfut_cntg" )
	
	Else
		DATAMANAGER.SetDataValue( 1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_optn_cntg" )
		
	End If
	
End Sub
'============================================================================
function ChartEx0_OnRequestData(nIndex, sData)
	if sData = "" or sData = null then
		exit function
	end if
	
	Data = split(sData, ";")
	
   '현재가내의 차트에서는 종목코드를 변경하지 않는다.
	g_szItemCode	= Cstr(Trim(Data[0]))             '코드
	g_sPeriodType	= Cstr(Trim(Data[1]))             '일주월년분틱
	g_sPeriod	= Cstr(Trim(Data[2]))             '주기(1,5,...)
	sRefresh		= Cstr(Trim(Data[3]))
	radioIndex	= ""
	
	if sRefresh = 1 or sRefresh = "1" or sRefresh = true then  
		g_sPeriodType = "2"
		g_sPeriod = "1"
		radioIndex = 0
		g_szChrtType = "D"
		
		sTic = Form.GetEnvData( "chart_tic0" )
		sMin = Form.GetEnvData( "chart_min0" )
		
		if sTic = "" then
			sTic = "1"
		end if
		
		if sMin = "" then
			sMin = "1"
		end if
		
		RadioGroup0.SetRadioCaption( 3, sTic.."틱" )
		RadioGroup0.SetRadioCaption( 2, sMin.."분" )
	
	else
		'PENTA13 START => 2023.07.04(차트성능개선)
		Select case g_sPeriodType
			case "0"
				g_szChrtType = "T"
				radioIndex = 3
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."틱")
				
			case "1"
				g_szChrtType = "A"
				radioIndex = 2
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."분")
				g_szMinType = g_sPeriod	'PENTA13 START => 2023.08.08(차트성능개선)
			
			case "2"
				g_szChrtType = "D"
				radioIndex = 0
			
			case "3"
				g_szChrtType = "W"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "주")
			
			case "4"
				g_szChrtType = "M"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "월")
		
		end Select
		'PENTA13 END
	end if
	
	'PENTA13 START => 2023.07.13(차트성능개선)
	if ChartEx0.GetDivideNum() == 1 then
		RadioGroup0.currentindex = radioIndex
	else
		RadioGroup0.setCurIndexSilent(radioIndex)
	end if
	
	Dim sDwmm
	sDwmm = ChartEx0.GetStateDWMM()
	if sDwmm == "0" then
		RadioGroup0.enable = 1
	end if
	'PENTA13 END
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx1.SetPeriodType(g_sPeriodType)
	
	ChartEx0.SetPeriodTime(g_sPeriod)
	ChartEx1.SetPeriodTime(g_sPeriod)
	
	' 종목코드 주기
	g_szItemMarket = Form.GetItemCodeInfo(g_szItemCode, "market")
	Form.SetItemCode(g_szItemCode)	
	RequestData()	
end function
'============================================================================
function ChartEx1_OnRequestData(nIndex, sData)
	if sData = "" or sData = null then
		exit function
	end if
	
	Data = split(sData, ";")
	
   '현재가내의 차트에서는 종목코드를 변경하지 않는다.
	g_szItemCode	= Cstr(Trim(Data[0]))             '코드
	g_sPeriodType	= Cstr(Trim(Data[1]))             '일주월년분틱
	g_sPeriod	= Cstr(Trim(Data[2]))             '주기(1,5,...)
	sRefresh		= Cstr(Trim(Data[3]))
	radioIndex	= ""
	
	if sRefresh = 1 or sRefresh = "1" or sRefresh = true then 
		g_sPeriodType = "2"
		g_sPeriod = "1"
		radioIndex = 0
		g_szChrtType = "D"
		
		sTic = Form.GetEnvData( "chart_tic0" )
		sMin = Form.GetEnvData( "chart_min0" )
		
		if sTic = "" then
			sTic = "1"
		end if
		
		if sMin = "" then
			sMin = "1"
		end if
		
		RadioGroup0.SetRadioCaption( 3, sTic.."틱" )
		RadioGroup0.SetRadioCaption( 2, sMin.."분" )
		
	else
		'PENTA13 START => 2023.07.04(차트성능개선)
		Select case g_sPeriodType
			case "0"
				g_szChrtType = "T"
				radioIndex = 3
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."틱")
				
			case "1"
				g_szChrtType = "A"
				radioIndex = 2
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."분")
				g_szMinType = g_sPeriod	'PENTA13 START => 2023.08.08(차트성능개선)
			
			case "2"
				g_szChrtType = "D"
				radioIndex = 0
			
			case "3"
				g_szChrtType = "W"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "주")
			
			case "4"
				g_szChrtType = "M"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "월")
		
		end Select
		'PENTA13 END
	end if

	'PENTA13 START => 2023.07.13(차트성능개선)
	if ChartEx1.GetDivideNum() == 1 then
		RadioGroup0.currentindex = radioIndex
	else
		RadioGroup0.setCurIndexSilent(radioIndex)
	end if
	
	Dim sDwmm
	sDwmm = ChartEx1.GetStateDWMM()
	if sDwmm == "0" then
		RadioGroup0.enable = 1
	end if
	'PENTA13 END
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx1.SetPeriodType(g_sPeriodType)
	
	ChartEx0.SetPeriodTime(g_sPeriod)
	ChartEx1.SetPeriodTime(g_sPeriod)
	
	' 종목코드 주기
	g_szItemMarket = Form.GetItemCodeInfo(g_szItemCode, "market")
	Form.SetItemCode(g_szItemCode)
	RequestData()	
end function
'============================================================================
'PENTA13 START => 2023.07.25(차트성능개선)
function ChartEx0_OnSelectedChart(nIndex, sData)
	if sData == "" then
		Exit function
	end if

	if nIndex < 1 then
		Exit function
	end if

	Data = split(sData, ";")
	
	g_sPeriodType   = Cstr(Trim(Data[2]))
	g_sPeriod       = Cstr(Trim(Data[3]))
     
	if g_sPeriodType == "0" or g_sPeriodType == "1" then
		if g_sPeriodType == "0" then		'틱
			g_TempIndex = 3
			g_szChrtType = "T"
			g_szTicType = g_sPeriod
			
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			
		else								'분
			g_TempIndex = 2
			g_szChrtType = "A"
			g_szMinType = g_sPeriod
			
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
			
		end if
	
	else
		g_sPeriod = "1"
		
		if g_sPeriodType == "2" then		'일
			g_TempIndex = 0
			'g_szChrtType = "D"
			
		elseif g_sPeriodType == "3" then	'주
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			RadioGroup0.SetRadioCaption( g_TempIndex, "주" )
			
		else								'월
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			RadioGroup0.SetRadioCaption( g_TempIndex, "월" )
		
		end if
		
	end if
	
	RadioGroup0.setCurIndexSilent(g_TempIndex)
	
	Dim sDwmm
	sDwmm = ChartEx0.GetStateDWMM()
	if sDwmm == "1" then
		RadioGroup0.enable = 0
	end if

end function
'============================================================================
