''''''''''''''''''''''''''''''''''''''''''''''-
' 01. 화 면 명 : 선옵현재가
' 02. 화면설명 : 선옵현재가 차트탭
' 03. 작    성 : 
''''''''''''''''''''''''''''''''''''''''''''''-
' 20240412 HSZ 코스닥글로벌지수 추가 (KF)
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
Dim g_szItemCode, g_szItemMarket
Dim g_szChrtType
Dim g_szToday
Dim g_szMinType
Dim g_szTicType
Dim g_flagMin
Dim g_flagTic
Dim g_flagWeek
Dim g_flagLine
Dim g_continue_Code
Dim g_continue_itemcode

'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData("ohhts_open_001r") '20220523 HSZ : 가로화면 화면집계 서비스호출 추가
	'20170202 HWG START - IOS 경우, 가로 종목검색 제공하지 않음
	sBIOTermOS = Form.GetSharedData("&OS_TYPE", false ) 'iOS("2")Android("1")
	
	'if sBIOTermOS = "2" then
	'	imgSearch.visible = false
	'end if
	'20170202 HWG END
	
	Dim szOpen, g_szCd, arrData

	szData = Form.GetOpenLinkData()
	
	'------------------------------------------------------------------------
	'20170208 LES START - 연결선물 추가
	'------------------------------------------------------------------------
	if szData = "101000" then				'코스피200 연결선물
		g_szItemCode = szData			
		g_szItemMarket = "F"
	
	elseif szData = "105000" then			'미니코스피 연결선물
		g_szItemCode = szData
		g_szItemMarket = "MF"
	
	'20180308_01 KBC START : KRX300 & KSQ150상품추가
	elseif szData = "108000" then			'KRX300 연결선물
		g_szItemCode = szData
		g_szItemMarket = "XF"
		
	elseif szData = "106000" then			'KSQ150 연결선물
		g_szItemCode = szData
		g_szItemMarket = "F"		
	'20180308_01 KBC END

	' 20240412 HSZ START: 코스닥글로벌지수 추가
	elseif szData = "1AG000" then
		g_szItemCode = szData
		g_szItemMarket = "KF"		
	' 20240412 HSZ END

	elseif Left(Trim(szData),9) = "continue_" then
		g_continue_Code = szData
		g_szItemMarket = "JF"
		g_continue_itemcode = Right(Trim(szData),Len(Trim(szData)) - 9)
	
	else
		arrData = Split(szData,"★")
	
		if arrData(0) <> "" then
			g_szItemCode = arrData(0)
			' 타화면에서 호출되는 탭으로 이동
			If #arrData > 1 Then
				If arrData(1) <> "" then
					fmtab0.currenttab = arrData(1)
				End If
			End If
		
		else
			g_szItemCode = Form.GetSharedData("&ITEM_FUTOPT", 0)			' 최근조회종목
			g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		end if
		
	end if
	
	'------------------------------------------------------------------------
	'20170208 LES END - 연결선물 추가
	'------------------------------------------------------------------------

	g_flagMin = false
	g_flagTic = false
	g_flagWeek = true
	g_szChrtType = "D" '일
	g_szToday = Form.GetSharedData("&HOST_DATE", 0 )
'	g_szMinType = "1분"
'	g_szTicType = "1틱"
	g_flagLine = false
	
	PeriodSet(g_szChrtType)
'	RequestData()
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		if g_szItemCode = sValue and g_flagInit = false then
			exit Sub
		end if
		
		If g_szItemMarket = "F" Or g_szItemMarket = "MF" Or g_szItemMarket = "XF" Or g_szItemMarket = "KF" Then '20180308_01 KBC : KRX300 & KSQ150상품추가	' 20240412 HSZ START: 코스닥글로벌지수 추가
			DATAMANAGER.CancelRealData( "ohhts_futs_cntg" )
		
		'20221117 LES START (CF:금 FF:국채/미달러/엔/유로)
		ElseIf g_szItemMarket = "CF" or g_szItemMarket = "FF" Then '20220915 HSZ 상품선물 추가
			DATAMANAGER.CancelRealData( "ohhts_cfut_cntg" )
			
		Else
			DATAMANAGER.CancelRealData( "ohhts_optn_cntg" )
			
		End If
		
		'----------------------------------------------------------------------
		'20170214 LES START - 연결선물
		'----------------------------------------------------------------------
		
		g_continue_Code = ""
		if sValue = "continue" then			'코스피200 연결선물
			g_szItemCode = "101000"
			g_szItemMarket = "F"
			
		elseif sValue = "continue_mini" then	'미니코스피 연결선물
			g_szItemCode = "105000"
			g_szItemMarket = "MF"
			
		'20180308_01 KBC START : KRX300 & KSQ150상품추가
		elseif sValue = "continue_108000" then	'KRX300 연결선물
			g_szItemCode = "108000"
			g_szItemMarket = "XF"
			
		elseif sValue = "continue_106000" then	'KSQ150 연결선물
			g_szItemCode = "106000"
			g_szItemMarket = "F"			
		'20180308_01 KBC END
		
		' 20240412 HSZ START : 코스닥글로벌지수 추가
		elseif sValue = "continue_1AG000" then
			g_szItemcode = "1AG000"
			g_szItemMarket = "KF"
		' 20240412 HSZ END
			
		elseif Left(Trim(sValue),9) = "continue_" then
			g_continue_Code = sValue
			g_szItemMarket = "JF"
			g_continue_itemcode = Right(Trim(sValue),Len(Trim(sValue)) - 9)

		'----------------------------------------------------------------------
		'20170214 LES END
		'-----------------------------------------------------------------------
		
		else
			g_szItemCode = sValue
			g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
			g_szItemName   = Form.GetItemCodeInfo( g_szItemCode , "name")
		end if
		
		RequestData()
		
	end	if	
End Sub
'============================================================================
Function RequestData()
	DATAMANAGER.CancelRealData("ohhts_futs_cntg")
	DATAMANAGER.CancelRealData("ohhts_optn_cntg")
	DATAMANAGER.CancelRealData("ohhts_sfut_cntg")
	DATAMANAGER.CancelRealData("ohhts_sopt_cntg")
	DATAMANAGER.CancelRealData("ohhts_cfut_cntg")		'20220915 HSZ 상품선물 추가
	
	if g_szItemMarket = "JF" or g_szItemMarket = "JO" then
		ChartEx0.visible = false
		ChartEx1.visible = true
		
	else
		ChartEx0.visible = true
		ChartEx1.visible = false

	end if
	
	'PeriodSetChart(g_szChrtType)  '20230905 한국금융IT : 일주월분 차트 주기 설정
	
	if g_szChrtType = "T" then ' 틱		'PENTA13 START => 2023.08.08(차트성능개선)
	'if g_szChrtType = "0" then ' 틱
		if Left(Trim(g_continue_Code),9) = "continue_" then '주식연결선물 일 경우 
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock1", "FID_INPUT_ISCD" , 0,g_continue_itemcode)
		
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_ISCD" , 0,g_continue_itemcode)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_DATE1" , 0,g_szToday)
				
			sTic = Split(g_szTicType, "틱", -1, 1)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_CNT1" , 0,sTic[0])  'n틱
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" , 0,"2") 
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0, "Y") 
			
		else 
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
		
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_DATE1" , 0,g_szToday)
				
			sTic = Split(g_szTicType, "틱", -1, 1)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_CNT1" , 0,sTic[0])  'n틱
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" , 0,"2") 
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0, "Y") 
		end if

		DATAMANAGER.RequestTranData("ohhts_5030_004r")		

	elseif g_szChrtType = "A" then ' 분	'PENTA13 START => 2023.08.08(차트성능개선)
	'elseif g_szChrtType = "1" then ' 분
		if Left(Trim(g_continue_Code),9) = "continue_" then '주식연결선물 일 경우 
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock1", "FID_INPUT_ISCD" , 0,g_continue_itemcode)
		
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_ISCD" , 0,g_continue_itemcode)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_DATE1" , 0,g_szToday)
			
			sMin = Split(g_szMinType, "분", -1, 1)
			sTemp = sMin[0] * 60
	
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" , 0, sTemp)  'n분
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0,"Y")  '
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_VRTL_TICK_INCU_YN" , 0,"N")
			
		else	
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
		
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_DATE1" , 0,g_szToday)
			
			sMin = Split(g_szMinType, "분", -1, 1)
			sTemp = sMin[0] * 60
	
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" , 0, sTemp)  'n분
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0,"Y")  '
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_VRTL_TICK_INCU_YN" , 0,"N")
			
		end if

		DATAMANAGER.RequestTranData("ohhts_5030_003r")		

	else
		if Left(Trim(g_continue_Code),9) = "continue_" then '주식연결선물 일 경우 
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_ISCD" , 0,g_continue_itemcode)
		
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_ISCD" , 0,g_continue_itemcode)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR" , 0,g_szChrtType)  'D/W/M/Y 일/주/월/년 
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DATE1" , 0,g_szToday)
			
		else
'MsgBox g_szItemCode & 	g_szItemMarket	& g_szChrtType
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
		
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR" , 0,g_szChrtType)  'D/W/M/Y 일/주/월/년 
			DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DATE1" , 0,g_szToday)
		end if
		
		DATAMANAGER.RequestTranData("ohhts_5030_001r")
	
	end if
	
	if Left(Trim(g_continue_Code),9) = "continue_" then
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD" , 0,g_continue_itemcode)
		DATAMANAGER.RequestTranData("ohhts_3050_001r")
	else
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
		DATAMANAGER.RequestTranData("ohhts_3050_001r")	
	end if 
end Function
