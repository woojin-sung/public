Sub Form_OnFormClose()
	ChartEx0.SetSaveChart("1")
	
	if Left(Trim(g_continue_Code),9) = "continue_" then
		Form.SendReturnToParent("OrientaitonClose" , g_continue_Code )
	else
		Form.SendReturnToParent("OrientaitonClose" , g_szItemCode )
	end if 

End Sub

