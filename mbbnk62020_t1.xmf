	<SCRIPT_INFO _len="8792" _ulen="8076" >
'============================================================================
' 01.화면명 	: 오픈뱅킹 다른금융기관 계좌 이체_계좌조회
' 02.화면설명	: 오픈뱅킹 다른금융기관 계좌 이체_계좌조회
' 03.작성	: 2020.10.15
' 04.수정     : 2021.05.20 장원혁 v001 : 내계좌목록에 위임계좌가 뜨지 않도록 수정
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szUserJumin		'실명확인번호(주민번호)
Dim g_szUserNum			'고객번호
Dim g_szIRow			'선택된 행의 인덱스
Dim g_szUserID		'ID
'============================================================================
Sub Form_OnFormInit()
	g_szUserNum = Form.GetSharedData("&CUST_NUM", false )		'로그인 해야만 고객번호 받아옴
	g_szUserID = Form.GetSharedData("&USER_ID" , false)
	
	Tab0.currenttab = 0
	Tab0_OnTabChanged(0) ' 내계좌(메리츠)
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_efif_021r" then '내계좌(메리츠)
'		DATAMANAGER.SetDataValue(0, "obacp_comm_062r", "InBlock1", "CSNO" , 0 , g_szUserNum		)
'		DATAMANAGER.SetDataValue(0, "obacp_comm_062r", "InBlock1", "ACNT_STAT_CODE", 0 , "1"	)'계좌상태코드 1 : 정상
'		DATAMANAGER.RequestTranData("obacp_comm_062r")

		sLoginType = Form.GetSharedData("&LOGIN_TYPE", false )
		sJumin	  = Form.GetSharedData("&JUMIN_NUM", false )
	
		if sLoginType == "2" then
			DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "IQRY_CLS_CODE" , 0 , "2" )'주민번호(2)->아이디(1)로 구분설정
		else 
			DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1" )'주민번호(2)->아이디(1)로 구분설정
		end if
	
		DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "RCNO" , 0 ,  sJumin )'TODO RCNO-PIP으로 교체해야함
		DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "VLTN_ACMP_YN", 0 , "N" )'평가수행여부 설정
		DATAMANAGER.SetDataValue( 0, "obcsb_efif_021r", "InBlock1", "ELFN_ID", 0 , g_szUserID)

	elseif szTranID == "obtss_opnf_025r" then '최근거래계좌(오픈뱅킹)
	    DATAMANAGER.SetDataValue(0, "obtss_opnf_025r", "InBlock1", "ELFN_ID" , 0 , g_szUserID )
	    
	elseif szTranID == "obrtp_tact_102r" then '자주쓰는계좌
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1", "BSWR_CLCD"     , 0 , "01")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1", "CRNC_CLS_CODE" , 0 , "1" )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1", "ACNO"          , 0 , "" )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1", "ASNO"          , 0 , "" )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1", "CSNO"          , 0 , "" )
	end if
	
End Sub

'============================================================================
Sub Tab0_OnTabChanged(nCurrentTab)
	If nCurrentTab = 0 then
	   DATAMANAGER.RequestTranData("obcsb_efif_021r") '내계좌(메리츠)
	ElseIf nCurrentTab = 1 then
	   DATAMANAGER.RequestTranData("obtss_opnf_025r") '최근거래계좌(오픈뱅킹)
	ElseIf nCurrentTab = 2 then   
	   DATAMANAGER.RequestTranData("obrtp_tact_102r") '자주쓰는계좌
	End If   
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_efif_021r" then	'내계좌(메리츠)
	  nIndex = 0 'v001
	  Tab0.page008784.Grid0.rowcount = 0 'v001
	  nCnt = DATAMANAGER.GetDataCount(0, "obcsb_efif_021r", "OutBlock1")
	  if nCnt >0 then
		 for i=0 to nCnt-1
              SELF_ACNT_YN = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "SELF_ACNT_YN" , i) 'v001
              If SELF_ACNT_YN == "Y" Then 'v001
	      
	             Tab0.page008784.Grid0.rowcount = Tab0.page008784.Grid0.rowcount + 1 'v001
		         
                  CUST_ABWR_NAME = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "CUST_ABWR_NAME" , i) 'v001
                  REG_ACNO       = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "REG_ACNO"       , i) 'v001
                  REG_ASNO       = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "REG_ASNO"       , i) 'v001
		  
			    Tab0.page008784.Grid0.SetCellData( "bd_cell0", nIndex , "메리츠증권")	'내계좌
			    Tab0.page008784.Grid0.SetCellData( "bd_cell2", nIndex , CUST_ABWR_NAME)   'v001
			    Tab0.page008784.Grid0.SetCellData( "bd_cell6", nIndex , REG_ACNO)         'v001
			    Tab0.page008784.Grid0.SetCellData( "bd_cell7", nIndex , REG_ASNO)	        'v001
			    Tab0.page008784.Grid0.SetCellData( "bd_cell4", nIndex , "287")		'은행코드 : 메리츠증권 287
			    szTempAccount = Tab0.page008784.Grid0.GetCellData( "bd_cell6", nIndex ) & Tab0.page008784.Grid0.GetCellData( "bd_cell7", nIndex ) 'acno & asno
			    Tab0.page008784.Grid0.SetCellData( "bd_cell1", nIndex , szTempAccount )	'계좌번호	      
			    nIndex = nIndex + 1 'v001
              End If
		  next
	  end if
'	elseif szTranID == "obtss_opnf_025r" then	'최근거래계좌(오픈뱅킹)


	elseif szTranID == "obrtp_tact_102r" then	'자주쓰는계좌
		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		
		for i=0 to nCnt-1
			if DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BANK_CODE" , i) == "" or DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BANK_CODE" , i) == "287" then
				Dim szTempAccount', szTempNickName
				Tab0.page001761.Grid0.SetCellData( "bd_cell2", i, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CNFT_ACNM" , i) )	'상대계좌명
				szTempAccount = Tab0.page001761.Grid0.GetCellData( "bd_cell6", i ) & Tab0.page001761.Grid0.GetCellData( "bd_cell7", i )
				Tab0.page001761.Grid0.SetCellData( "bd_cell1", i, szTempAccount)	'계좌번호				
			else
				Tab0.page001761.Grid0.SetCellData( "bd_cell2", i, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BANK_ACNM" , i) )	
				Tab0.page001761.Grid0.SetCellData( "bd_cell1", i, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BANK_USE_ACNO" , i))	'계좌번호
			end if	
		 next
		
		
	end if
End Sub

'============================================================================
Sub Tab0_page001761_Grid0_OnClickUp(lRow, szCellID) '자주쓰는계좌
	Dim szCd, szAccNo , szAccNm , szBank , szData	
	if lRow > -1 then
	  szCd        = Tab0.page001761.Grid0.GetCellData( "bd_cell4",       lRow)
	  szAccNo     = Tab0.page001761.Grid0.GetCellData("bd_cell1" , 	     lRow)
	  szAccNm     = Tab0.page001761.Grid0.GetCellData("bd_cell2" ,       lRow)	
	  szBank      = Tab0.page001761.Grid0.GetCellData("bd_cell0" ,       lRow)	
	  
	  '  전달내용/은행코드/계좌번호/수취인/은행명 / 내계좌여부
	  szData = "자주계좌" & "★" & szCd & "★" & szAccNo & "★" & szAccNm & "★" & szBank & "★" & "N"
        
	  Form.SendReturnToParent("62020_OFTEN", szData)''''''
	  Form.CloseForm()
	end if  
End Sub

'============================================================================
Sub Tab0_page008784_Grid0_OnClickUp(lRow, szCellID) '내계좌(메리츠)
	Dim szCd, szAccNo , szAccNm , szBank , szData	
	if lRow > -1 then
		szCd        = Tab0.page008784.Grid0.GetCellData( "bd_cell4",       lRow)
		szAccNo     = Tab0.page008784.Grid0.GetCellData("bd_cell1" , 	     lRow)
		szAccNm     = Tab0.page008784.Grid0.GetCellData("bd_cell2" ,       lRow)	
		szBank      = Tab0.page008784.Grid0.GetCellData("bd_cell0" ,       lRow)	
	  
		'  전달내용/은행코드/계좌번호/수취인/은행명
