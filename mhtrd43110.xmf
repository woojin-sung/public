' 화 면 명 : 관심종목
' 작    성 : 
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szFirst
g_szFirst = "0"

Dim g_szTitle
g_szTitle = "알림"

'- 관심_환경설정 관련 -------------------------------------------------------
Dim g_tGSelect
Dim g_tGDefault
Dim g_tKey
Dim g_tNm
Dim g_szCloud		' 관심동기화(0:미사용(로컬), 1:사용(서버))

g_tGSelect = {}
g_tDefault = {"GLOBAL_INTR_RECENT", "GLOBAL_INTR_HOLDING"}
g_tKey     = {"BB", "CC"}
g_tNm      = {"최근조회 종목", "보유종목"}

'20200525 SWJ START : 고유 MTS 보유종목 콤보 삭제
Dim g_tKey2
Dim g_tNm2
g_tKey2 	  = {"BB"}
g_tNm2     = {"최근조회 종목"}
'20200525 SWJ END
' ---------------------------------------------------------------------------



'****************************************************************************
'                          F O R M        E V E N T                          
'****************************************************************************
'============================================================================
Sub Form_OnFormClose( )
	' 20160401 관심 타매체 실시간 연동 ------------
	DATAMANAGER.CancelRealData("ohhts_intr_real")	
End Sub

'============================================================================
Sub Form_OnFormInitBefore( )
	'코치마크 	
	Dim szPopup
	szPopup = Form.LoadConfigData( "mhtrd43110", "mhtrd43110_p0" )

'20240425 KKM 가이드팝업 삭제
'	If szPopup <> "1" Then
'		Form.OpenPopup( "mhtrd43110_p0", "" , "")
'	End If
End Sub

'============================================================================
Sub Form_OnFormInit( )
	fmTab.currenttab = "1"
	edtGWAdd.caption = "0"
	
'	Change_Style("SET_BLANK")

	' 관심 동기화
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	
	' 폼탭의 좌우스크롤 제어
	Control_FmTab_Swipe( )
	
	init_GWGroup( )
	
	DATAMANAGER.RequestRealData("ohhts_intr_real")
End Sub

'============================================================================
' Form_OnCommonDialogReturn : 종목검색창에서 선택된 종목 가져오기
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName == "SEARCH" then
		if Trim(sReturn1)  <> "" then
			edtGWAdd.caption = "1"	' 20160401 관심 타매체 실시간 연동(1:MTS에서 관심등록)
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GLOBAL_INTR_LIST_ADD", sReturn1 & "★" & cmbGroup.caption)
		end if
	end if	
End Sub

'============================================================================
'관심그룹 추가 등록
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "GLOBAL_INTR_GROUP_ADD" and sRet == "ok" Then
		Form.OpenFramePopup("mhtrd43110_p2" , "GLOBAL_INTR_GROUP_ADD", "")
	End if
End Sub

'============================================================================
' Form_OnLinkData : 20160404 로그인시 신호 받고 해당 ID로 관심요청
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "&LOGIN" then
		if sValue == "login" then
			init_GWGroup( )
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' 환경설정 팝업 리턴 ---------------------------------------------------
	if sKeyName == "GLOBAL_INTR_SET" then
		if Trim(sRet) <> "" then
			' 폼탭의 좌우스크롤 제어
			Control_FmTab_Swipe( )
			
			' 그룹콤보 초기화
			Insert_cmbGroup( )
		end if
	' 편집 팝업 리턴	 -----------------------------------------------------
	elseif sKeyName == "GLOBAL_INTR_MODIFY" then
		 ' 20160317 편집시 ID가 메인화면과 연동안되는부분 때문에 추가 //////
		Dim szvrsnID
		
		szvrsnID = Form.GetSharedData("GLOBAL_INTR_VRSN_ID", true)
		
		if Trim(szvrsnID) <> "" then
			edtvrsnID.caption = szvrsnID
		end if
		' //////////////////////////////////////////////////////////////////
		
		if sRet == "0" then		' 종목편집
			edtListCnt.caption = ""		' 종목리스크 카운트 에디트 클리어
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GLOBAL_INTR_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption)
		else						' 그룹편집
			init_GWGroup( )
		end if
	elseif sKeyName = "snsshare" then			' SNS 리턴 : 20160324 SNS연동 추가(화면연동)
		if sRet == "2" then
			Dim szScreenNo, szFileName
			
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"

			Form.SaveScreenShot( szFileName )  
			Form.SendSNSLinkage(sRet, "", "", szFileName)
		end if
	
	elseif sKeyName = "mhprc11010_p7_select" then '그룹팝업에서 리턴
		cmbGroup.currentindex = sRet
		
	elseif sKeyName = "mhprc11010_p7_edit" then '그룹팝업에서 리턴
		Form.OpenFramePopup( "mhtrd43110_p2" , "GLOBAL_INTR_GROUP_ADD" , "" ) '편집 팝업 오픈
		
	end if
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_MENU" then		
		if sParam == "SET_STYLE1" then
			Form.SetEnvData("1", "GLOBAL_INTR_STYLE", sParam)
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GLOBAL_INTR_STYLE", sParam)
			Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GLOBAL_INTR_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption)
			
'			Change_Style(sParam)
		elseif sParam == "SET_SCREEN" then
			Form.OpenFramePopup("mhtrd43110_p1" , "환경설정", "")
		elseIf sParam = "SHA_SNS" Then			' SNS 리턴 : 20160324 SNS연동 추가(화면연동)
			Form.OpenDialog("sharesns1" , "0", "")
		end if
	end if
End Sub

'============================================================================
' Form_OnRefresh : 관심을 첫화면으로 했을때 종목 재조회
'============================================================================
Sub Form_OnRefresh( )
	'init_GWGroup( )
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GLOBAL_INTR_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption)
End Sub



'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
' init_GWGroup :  관심그룹 재설정 (로컬/서버)
'============================================================================
Function init_GWGroup( )
	if g_szCloud == "1" then		' Server 저장시
		' 관심그룹조회 : 조회수 관심그룹 그룹콤보에 넣는다.
		DATAMANAGER.RequestTranData("ohhts_intr_026r")
	else
		' 로컬 저장된 관심그룹 가져오기
		Load_GWGroup( )
		Insert_cmbGroup( )
	end if
End Function

'============================================================================
' Insert_cmbGroup :  관심그룹을 그룹콤보에 넣기
'============================================================================
Function Insert_cmbGroup( )
	Dim szgrpList, szKey, szNm, szSave
	Dim nRow, nIdx, nSelect
	
	' 콤보 리스트 클리어
	Form.SetCtlProp("cmbGroup", "clear", "")
	
	nRow = grdGroup.rowcount
	nIdx = -1
	nSelect = -1
	szgrpList = ""
	
	' 최종 선택(저장)된 관심그룹 키
	szSave = Form.GetEnvData("GLOBAL_INTR_GROUP_SELECT")
	
	' ---- 관심_환경설정에서 가져온 관심그룹 추가 여부 Start ----------------
	
'20200525 SWJ START : 고유MTS 보유종목 콤보 삭제
	szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
	
	If szMediaCode = "156" or szMediaCode = "157" or szMediaCode = "412" or szMediaCode = "413" Then '20210804 SWJ START : 모의투자 채널코드 추가
		For i = 0 to #g_tDefault-1
			g_tGSelect[i] = Form.GetEnvData(g_tDefault[i])
		
			if g_tGSelect[i] == "" or g_tGSelect[i] == null then
				g_tGSelect[i] = "1"
			end if
		
			' 해당그룹 Show시
			if g_tGSelect[i] == "1" then
		
				if i == 0 then
					szgrpList = g_tKey[i] & "`" & g_tNm[i]
			
					nIdx = 0
				else
					if szgrpList == "" then
						szgrpList = g_tKey[i] & "`" & g_tNm[i]
					else
						szgrpList = szgrpList & "\r\n" & g_tKey[i] & "`" & g_tNm[i]
					end if
				
					if nIdx >= 0 then
						nIdx = nIdx + 1
					else
						nIdx = 0
					end if			
				end if
			
				if szSave == g_tKey[i] then
					nSelect = nIdx
				end if

				' 선택된 그룹을 삭제하였을경우의 예외처리
				if i == nRow -1 then
					if nSelect < 0 then
						nSelect = 0
					end if
				end if
			end if
		NEXT
	
	ElseIf szMediaCode = "158" or szMediaCode = "159" Then
		'20211202 HSZ START : 관심종목 리뉴얼
		cmbGroup.visible = true
		btnPrev.visible = true
		btnNext.visible = true
		btnOpenGroup.visible = false
		lblGroupNm.visible = false
		'20211202 HSZ END
		For i = 0 to #g_tDefault-2
		g_tGSelect[i] = Form.GetEnvData(g_tDefault[i])
		
			if g_tGSelect[i] == "" or g_tGSelect[i] == null then
			g_tGSelect[i] = "1"
			end if
		
			' 해당그룹 Show시
			if g_tGSelect[i] == "1" then
		
				if i == 0 then
				szgrpList = g_tKey2[i] & "`" & g_tNm2[i]
			
				nIdx = 0
				else
					if szgrpList == "" then
					szgrpList = g_tKey2[i] & "`" & g_tNm2[i]
					else
					szgrpList = szgrpList & "\r\n" & g_tKey2[i] & "`" & g_tNm2[i]
					end if
				
					if nIdx >= 0 then
						nIdx = nIdx + 1
					else
						nIdx = 0
					end if			
				end if
			
				if szSave == g_tKey2[i] then
					nSelect = nIdx
				end if

				' 선택된 그룹을 삭제하였을경우의 예외처리
				if i == nRow -1 then
					if nSelect < 0 then
						nSelect = 0
					end if
				end if
			end if
		NEXT
	End If
	
	' ---- 관심 환경설정에서 가져온 관심그룹 추가 여부 End ------------------

	' ---- 관심종목 그룹 리스트 존재시 Start --------------------------------
	If szMediaCode = "156" or szMediaCode = "157" or szMediaCode = "412" or szMediaCode = "413" Then '20210804 SWJ START : 모의투자 채널코드 추가
		if Int(nRow) > 0 then
		
			For i = 0 to nRow -1
				szKey = grdGroup.GetCellData("bd_code", i)
				szNm  = grdGroup.GetCellData("bd_name", i)

				if szgrpList == "" then
					szgrpList = szKey & "`" & szNm
				else
					szgrpList = szgrpList & "\r\n" & szKey & "`" & szNm
				end if
			
				if nIdx >= 0 then
					nIdx = nIdx + 1
				else
					nIdx = 0
				end if
			
				if szSave == szKey then
					nSelect = nIdx
				end if
			
				' 선택된 그룹을 삭제하였을경우의 예외처리
				if i == nRow -1 then
					if nSelect < 0 then
						nSelect = 0
					end if
				end if
			Next
		end if
	end if
	
		If szMediaCode = "158" or szMediaCode = "159" Then	
		if Int(nRow) > 0 then
		
			For i = 0 to nRow -1
				szKey2 = grdGroup.GetCellData("bd_code", i)
				szNm2  = grdGroup.GetCellData("bd_name", i)

				if szgrpList == "" then
					szgrpList = szKey2 & "`" & szNm2
				else
					szgrpList = szgrpList & "\r\n" & szKey2 & "`" & szNm2
				end if
			
				if nIdx >= 0 then
					nIdx = nIdx + 1
				else
					nIdx = 0
				end if
			
				if szSave == szKey2 then
					nSelect = nIdx
				end if
			
				' 선택된 그룹을 삭제하였을경우의 예외처리
				if i == nRow -1 then
					if nSelect < 0 then
						nSelect = 0
					end if
				end if
			Next
		end if
	end if
'20200525 SWJ END	
	' ---- 관심종목 그룹 리스트 존재시 End ----------------------------------

	' 관심그룹콤보에 리스트 init		
	cmbGroup.cbinputdatatext = szgrpList

	' 관심그룹콤보에서 최종 저장된 그룹 선택
	'20160804 NOHES START 초기값 셋팅
	If CStr(nSelect) == "-1" Then
		nSelect = 0 
	End If
	'20160804 NOHES END
	cmbGroup.currentindex = CStr(nSelect)	
End Function

'============================================================================
' Load_GWGroup :  로컬에 저장된 관심그룹 가져오기
'============================================================================
Function Load_GWGroup( )
	Dim tGroup, tList
	
	grdGroup.rowcount = 0
	szGroup = Form.LoadConfigData("GLOBAL_INTR", "GROUP")
	
	if szGroup <> "" then	
		tGroup = Split(szGroup, "♣")
		
		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdGroup.insertrow = i
	
			grdGroup.SetCellData("bd_code",  i, tList(0))
			grdGroup.SetCellData("bd_name",  i, tList(1))
			grdGroup.SetCellData("bd_count", i, tList(2))
		Next
	end if
End Function

'============================================================================
' Save_GWGroup :  관심그룹을 로컬에 저장
'============================================================================
Function Save_GWGroup( )
	Form.SaveConfigData("GLOBAL_INTR", "GROUP", "")
	
	For i = 0 to grdGroup.rowcount-1
		szCode = grdGroup.GetCellData("bd_code",  i)
		szName = grdGroup.GetCellData("bd_name",  i)
		szCnt  = grdGroup.GetCellData("bd_count", i)
		if i == 0 then
			szGroup = szCode & "★" & szName & "★" & szCnt
		else
			szGroup = szGroup & "♣" & szCode & "★" & szName & "★" & szCnt
		end if
	Next
	
	Form.SaveConfigData("GLOBAL_INTR", "GROUP", szGroup)
End Function

'============================================================================
' Control_FmTab_Swipe : 폼탭의 좌우스크롤 제어
'============================================================================
Function Control_FmTab_Swipe( )
	' 좌우 스크롤시 관심그룹 변경 설정
	' 20160325 최초설정은 좌우스트롤 가능하도록 변경 -> 요청사항
	if Form.GetEnvData("GLOBAL_INTR_SWIPE") == "0" then
		fmTab.usepg = "0"
	else
		fmTab.usepg = "1"
	end if
End Function

'============================================================================
' Change_Style : 오른쪽 상단 편집과 차트 버튼부분
'============================================================================
Function Change_Style(szStyle)
	if szStyle == "SET_STYLE1" then
		tblSelect.visible = true
		tblLine.visible   = true
	else
		tblSelect.visible = false
		tblLine.visible   = false
	end if
End Function


'****************************************************************************
'            C  O  N  T  R  O  L  L        F  U  N  C  T  I  O  N            
'****************************************************************************
'============================================================================
Sub tblSelect_OnClick(nRow , nCol)
	'최근조회, 보유종목 예외처리	
	szKey = cmbGroup.cbkeydata
	
	'최근조회, 보유종목 추가버튼만 예외처리
	If ( szKey == "BB" or szKey == "CC" ) And ( nCol == 1 ) Then
		Exit Sub
	End If
	
	' 편집
	If nCol == 0 then
		' ITGEN START => 2019.01.10(해외파생)
		Form.SetEnvData("1", "GLOBAL_INTR_GROUP_SELECT" , cmbGroup.cbkeydata)
		' ITGEN END
		Form.OpenFramePopup( "mhtrd43110_p2" , "" , "" )
		
	' 추가
	ElseIf nCol == 1 Then
		If CInt( edtListCnt.rowcount ) >= 100 Then
			Dim szMsg
			szMsg = "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. " &
			        "추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오."
			Form.ShowAlert( g_szTitle , szMsg )
		End If
		
		'해외선물옵션 종목검색창 열기
		Form.OpenCommonDialog( "SEARCH" , "18" , edtListCnt.caption )
	End If
End Sub



'****************************************************************************
'  T  R  A  N     D  A  T  A  M  A  N  A  G  E  R
'****************************************************************************
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_026r" then
		DATAMANAGER.ClearInputData(0, "ohhts_intr_026r")
		grdGroup.rowcount = 0
		DATAMANAGER.SetDataValue(0, "ohhts_intr_026r", "InBlock1", "FID_USER_ID", 0, Form.GetSharedData("&USER_ID", false))	' USER ID	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	If szTranID == "ohhts_intr_026r" Then
		' 관심그룹 없는 경우 새로등록창 안내
		If g_szFirst == "0" And DATAMANAGER.GetDataCount(0, "ohhts_intr_026r" , "OutBlock1") < 1 Then
			Form.MsgBox("안내", "등록된 관심그룹이 없습니다.\n관심그룹을 새로 등록하시겠습니까?", "GLOBAL_INTR_GROUP_ADD", 1)
		End If
		
		' 동기화 상태일때도 파일에는 계속저장
		Save_GWGroup( )
		' 관심그룹을 그룹콤보에 넣기
		Insert_cmbGroup( )
	End If
End Sub



'****************************************************************************
'  R  E  A  L     D  A  T  A  M  A  N  A  G  E  R
'****************************************************************************
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심 타매체 실시간 연동
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_real" then
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_USER_ID", 0, Form.GetSharedData("&USER_ID", false))	' USER ID
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	' ----------------------------------------------------------------------
	' 관심 타매체 실시간 연동
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_real" then
		Dim szID, szReturn
		szID, szReturn = "", ""
		
		if g_szCloud == "1" then		' Server 저장시
			szID = Form.GetSharedData("&USER_ID", false)	' USER ID
			szReturn = DATAMANAGER.GetDataValue(1, szTranID, "OutBlock1", "FIDR_USER_ID", 0)
			
			if Trim(szID) == Trim(szReturn) then
				if Trim(edtGWAdd.caption) == "1" then
					edtGWAdd.caption = "0"
					Exit Sub
				else
					edtGWAdd.caption = "0"
					init_GWGroup( )
				end if
			end if
		end if
	end if	
End Sub



'****************************************************************************
'  C  O  N  T  R  O  L  L
'****************************************************************************
'============================================================================
Sub fmTab_OnTabChanged(nCurrentTab)
	fmTab.currenttab = "1"		' 20160406 :  속도이슈때문에 선택 위치 변경
	
	if nCurrentTab == 2 then
		btnNext_OnClick( )
	elseif nCurrentTab == 0 then
		btnPrev_OnClick( )
	end if
End Sub

'============================================================================
Sub cmbGroup_OnEditComplete(iIndex)
	Dim szStyle, szKey
	
	szKey = cmbGroup.cbkeydata
	' 최근조회, 보유종목은 추가버튼 예외처리
	if szKey == "BB" or szKey == "CC" then
		tblSelect.SetCellFgColor(0, 1, "127")
	else
		tblSelect.SetCellFgColor(0, 1, "4")
	end if
	
	edtListCnt.caption = ""		' 종목리스크 카운트 에디트 클리어
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GLOBAL_INTR_GROUP_CHANGE", "") ' 초기화
	
	' 선택되어 있는 그룹의 키를 저장한다. 화면 다시 오픈시 적용
	Form.SetEnvData("1", "GLOBAL_INTR_GROUP_SELECT" , cmbGroup.cbkeydata)

	if g_szFirst == "0" then
		g_szFirst = "1"
'		Change_Style("SET_STYLE1")
		Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GLOBAL_INTR_STYLE", szStyle)
	end if
	
	'20211115 아이티젠(김성수) 관심 개선 START
	f_SetToggleUI(szKey)
	
	lblGroupNm.caption = cmbGroup.caption
	'20211115 아이티젠(김성수) 관심 개선 END
	
	' Sub화면에 조회 요청
	Form.triggerEvent("fmTab." & fmTab.currenttabpageid, "GLOBAL_INTR_LIST", cmbGroup.cbkeydata & "♥" & edtvrsnID.caption)
End Sub

'============================================================================
' 관심그룹보기 ◁(이전)버튼
'============================================================================
Sub btnPrev_OnClick( )
	If Int( cmbGroup.currentindex ) == 0 Then
		cmbGroup.currentindex = cmbGroup.rowcount - 1
	Else
		cmbGroup.currentindex = cmbGroup.currentindex - 1
	End If
End Sub

'============================================================================
' 관심그룹보기 ▷(다음)버튼
'============================================================================
Sub btnNext_OnClick( )
	If Int( cmbGroup.currentindex ) == Int( cmbGroup.rowcount - 1 ) Then
		cmbGroup.currentindex = 0
	Else
		cmbGroup.currentindex = cmbGroup.currentindex + 1
	End If
End Sub

'============================================================================
'20211019 아이티젠(김성수) 관심화면 개선 START
'============================================================================
' f_ShowGroupList : 관심그룹리스트 보이기
'============================================================================
Function f_ShowGroupList()
	dim nRowCnt, szSendData
	nRowCnt = CInt(grdGroup.rowcount)
	szSendData = ""
	
	if nRowCnt > 0 then
		for i=0 to nRowCnt-1
			dim sKey, sName, sStr
			sKey = grdGroup.GetCellData( "bd_code", i )
			sName = grdGroup.GetCellData( "bd_name", i )
			sStr = sKey & "`" & sName
			
			if szSendData == "" then
				szSendData = sStr
			else
				szSendData = szSendData & "★" & sStr
			end if
		next
	end if
	
	Form.SetSharedData("PresentSelectKey" , cmbGroup.cbkeydata) '현재 선택된 그룹키
	
	g_Ostype = Form.GetSharedData("&OS_TYPE", false )	'iOS("2") Android("1") 기타("9")
	if g_Ostype = "2" then
		Form.OpenPopupAnimation("mhprc11010_p7" , szSendData, "", "3")
	else 
		Form.OpenPopupAnimation("mhprc11010_p7" , szSendData, "", "1")
	end if
	
End Function

'============================================================================
Function f_SetToggleUI(szKey)
	'20160906 NOHES START 왓칭, 최근조회, 보유종목은 추가버튼 예외처리
	if szKey == "BB" or szKey == "CC" then
		imgEdit.visible = false
	else
		imgEdit.visible = true
	end if
	'20160906 NOHES END
End Function

'============================================================================
' imgEdit_OnClick : 종목추가 클릭 이벤트
'============================================================================
Sub imgEdit_OnClick()
	If CInt( edtListCnt.rowcount ) >= 100 Then
			Dim szMsg
			szMsg = "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. " &
			        "추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오."
			Form.ShowAlert( g_szTitle , szMsg )
		End If
		
		'해외선물옵션 종목검색창 열기
		Form.OpenCommonDialog( "SEARCH" , "18" , edtListCnt.caption )
End Sub

'============================================================================
' imgGrp_OnClick : 관심편집 클릭 이벤트
'============================================================================
Sub imgGrp_OnClick()
	Form.OpenFramePopup( "mhtrd43110_p2" , "GLOBAL_INTR_GROUP_ADD" , "" ) '편집 팝업 오픈
End Sub
'============================================================================
' btnOpenGroup_OnClick : 그룹메뉴 버튼
'============================================================================
Sub btnOpenGroup_OnClick()
	f_ShowGroupList()
End Sub

'============================================================================
' lblGroupNm_OnClick : 그룹명 label
'============================================================================
Sub lblGroupNm_OnClick()
	f_ShowGroupList()
End Sub

