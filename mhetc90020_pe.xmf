'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 로그인_ID조회완료
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_plain_rm	'v0001 MTS메모리평문적용여부
Dim g_POP_YN
Dim g_ACNO
Dim g_RCNO
Dim g_PWD

'============================================================================
'							FORM 함수
'============================================================================
Sub Form_OnFormInitBefore()
	ImgClose.setMaintainingRatio("1")
	Img0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()	
	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)

	g_POP_YN = Form.GetOpenLinkData()
	g_RCNO	= Form.GetSharedData("mhetc90020_pe_RCNO", 	true)
	g_ACNO	= Form.GetSharedData("mhetc90020_pe_ACNO", 	true)
	g_PWD	= Form.GetSharedData("mhetc90020_pe_PWD", 	true)
	
	DATAMANAGER.RequestTranData("obacp_opop_008r")	'고객정보 체크
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("mhetc90020_pe_RCNO" , "")
	Form.SetSharedData("mhetc90020_pe_ACNO" , "")
	Form.SetSharedData("mhetc90020_pe_PWD" , "")	
End Sub

'============================================================================
'						DATAMANAGER 함수
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID = "obacp_opop_008r" or szTranID = "obcsb_efif_000r" then
		DATAMANAGER.SetUserID("meritz")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO",		0, g_ACNO)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP",	0, g_RCNO)
		
		'MTS메모리평문 적용상태일때
		if g_plain_rm == "1" then
		    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , g_PWD)
		'MTS메모리평문 미적용상태일때
		else
		    DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetEncData(g_PWD))
		end if
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	'고객정보 체크
	if szTranID == "obacp_opop_008r" then
	
		if DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CSNM", 0) <> "" then
			DATAMANAGER.RequestTranData("obcsb_efif_000r")
		end if
		
	'고객HTSID조회
	elseif szTranID == "obcsb_efif_000r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(false, szTranID, "OutBlock1")
		
		if nCnt > 0 then
			Table0.visible	= true
			Label0.caption 	= "ID 찾기가 완료되었습니다."
			
			for i = 0 to nCnt - 1
				Dim ATMT_ISNC_YN
				ATMT_ISNC_YN = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ATMT_ISNC_YN", i)
				
				if "Y" == ATMT_ISNC_YN then
					Table0.SetCellString(0, 1, "자동 발급된 ID입니다.")
				end if
				
				grd0.AddRow()
				grd0.SetCellData("BD_ELFN_ID", 			i, "ID")
				grd0.SetCellData("BD_ID_REG_DATE",		i, "ID 생성일")
				grd0.SetCellData("ELFN_ID",				i, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ELFN_ID", 	i))
				grd0.SetCellData("ID_REG_DATE",			i, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ID_REG_DATE",	i))
				grd0.SetCellData("ATMT_ISNC_YN",		i, ATMT_ISNC_YN)

				grd1.AddRow()
				grd1.SetCellData("BD_ELFN_ID", 			i, "ID")
				grd1.SetCellData("BD_ID_REG_DATE",		i, "ID 생성일")
				grd1.SetCellData("ELFN_ID",				i, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ELFN_ID", 	i))
				grd1.SetCellData("ID_REG_DATE",			i, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ID_REG_DATE",	i))
				grd1.SetCellData("ATMT_ISNC_YN",		i, ATMT_ISNC_YN)
				
				if g_POP_YN == "Y" then
					grd0.visible = true
					grd1.visible = false
					
					grd0.SetMaintainingRatio("BD_BUTTON", 	i, "1")
					grd0.SetCellImage("BD_BUTTON", 			i, "input_01_n.9.png")
					grd0.SetCellData("BD_BUTTON", 			i, "선택")
				else
					grd0.visible = false
					grd1.visible = true
				end if
				
			next
			
		else
			Table0.visible	= false
			grd0.visible		= false
			grd1visible		= false
			Label0.caption 	= "조회된 ID 내역이 없습니다."
		end if
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if sSubMsg <> null and Trim(sSubMsg) <> "" then
		szErrMsg = szErrMsg & " " & sSubMsg
	end if
	
	Form.MsgBox("알림", szErrMsg, "", 0)
	Form.CloseForm()
End Sub

'============================================================================
'							CONTROL 함수
'============================================================================
' ID정보 선택
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)

	' 선택
	if szCellID == "BD_BUTTON" then
		Form.SetSharedData("mhetc90020_pe_ELFN_ID", 		grd0.GetCellData("ELFN_ID", 		lRow))
		Form.SetSharedData("mhetc90020_pe_ATMT_ISNC_YN",	grd0.GetCellData("ATMT_ISNC_YN", 	lRow))
		
		if g_POP_YN == "Y" then
			Form.SendReturnToParent("mhetc90020_pe", "RETURN")
			Form.CloseForm()
		end if
	
	end if
	
End Sub

'============================================================================
' 닫기 버튼
'============================================================================
Sub ImgClose_OnClick()
	Form.SendReturnToParent("mhetc90020_pe", "CLOSE")
	Form.CloseForm()
End Sub

