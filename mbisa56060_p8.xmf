'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 가입신청_계약자 확인사항
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.18 김은숙
'                2023.12.04 : 고승연 : v0002 : [] 투자성향등급 색상 변경, 온라인 설명의무 가이드 적용
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sRetData 
g_sRetData = "cancel"
Dim g_OsType

Dim g_szList
'g_szList(0)  : 계좌번호
'g_szList(1)  : 상품(MP) 코드
'g_szList(2)  : 상품(MP) 한글명
'g_szList(3)  : 투자성향진단 한글명
'g_szList(4)  : [재작성시] 직전 화면 Close시 g_sRetData값 (ok/cancel)
'g_szList(5)  : [재작성시] 직전 화면 Close시 edt0 입력값
'g_szList(6)  : [재작성시] 직전 화면 Close시 edt1 입력값
'g_szList(7)  : [재작성시] 직전 화면 Close시 edt2 입력값
'g_szList(8)  : [재작성시] 직전 화면 Close시 edt3 입력값
'g_szList(9)  : [재작성시] 직전 화면 Close시 edt4 입력값
'g_szList(10) : [재작성시] 직전 화면 Close시 edt5 입력값
'g_szList(11) : [재작성시] 직전 화면 Close시 edt6 입력값


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'계약자확인사항 작성중 화면 닫았다가 다시 열었을때 기존 작성 내용 유지
Sub SetInputText()
	cont0.edt0.caption = g_szList(5) 
	cont0.edt1.caption = g_szList(6) 
	cont0.edt2.caption = g_szList(7) 
	cont0.edt3.caption = g_szList(8) 
	cont0.edt4.caption = g_szList(9) 
	cont0.edt5.caption = g_szList(10) 
	cont0.edt6.caption = g_szList(11) 
	
	cont0.scroll_pos = 0
End Sub

'============================================================================
Sub SetTableData(szTranID)
	cont0.tbl0.SetCellString( 0, 0, "(" & g_szList(2) & ")")
	cont0.tbl1.SetCellString( 0, 0, "(" & g_szList(2) & ")")
	cont0.lbl2.caption = "(" & Form.GetAccountInfo(g_szList(0), "name") & ")"	'투자자성명
	cont0.lbl3.caption = "(" & g_szList(3) & ")"								'위험성향 등급
	
	'2번 항목 자산군 비중
	Dim sPcnt, nPcnt, sProd, sPName
	sProd = ""
	nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock3")
	
	For i = 0 to nCnt -1 
		sPcnt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock3", "INVT_PROD_RLIM" , i )
		If sPcnt <> "" then
			nPcnt = CDbl(sPcnt)

			If nPcnt > 0 then
				sPName = GetCodeName(DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock3", "WA_INVT_PROD_CLCD" , i ))
				sProd = sProd & sPName & " " & nPcnt & "%, "
			End If
		End If
	Next
	
	sProd = Left(sProd, Len(sProd)-2)
	cont0.lbl1.caption = "(" & sProd & ")"
	
	cont0.scroll_pos = 0
End Sub

'============================================================================
Function GetCodeName(sCode)
	Select Case sCode
		Case "01"
			return "주식"
		Case "02"
			return "채권"
		Case "03"
			return "집합투자증권"
		Case "04"
			return "RP"
		Case "05"
			return "선물옵션"
		Case "06"
			return "발행어음"
		Case "07"
			return "예금"
		Case "08"
			return "장외파생"
	End Select
End Function

'============================================================================
Function ValidateCheck()
	Dim sLblText(6)
	Dim sEdtText(6)

	For i = 0 to 6
		sLblText(i) =	Trim(Form.GetCtlProp("cont0.lbl" & i, "caption"))
		sLblText(i) = Replace(sLblText(i), " ", "")
		sLblText(i) = Replace(sLblText(i), ",", "")
		sLblText(i) = Replace(sLblText(i), "%", "")
		sLblText(i) = Replace(sLblText(i), "(", "")
		sLblText(i) = Replace(sLblText(i), ")", "")
		
		sEdtText(i) =	Trim(Form.GetCtlProp("cont0.edt" & i, "caption"))
		sEdtText(i) = Replace(sEdtText(i), " ", "")
		sEdtText(i) = Replace(sEdtText(i), ",", "")
		sEdtText(i) = Replace(sEdtText(i), "%", "")
		sEdtText(i) = Replace(sEdtText(i), "(", "")
		sEdtText(i) = Replace(sEdtText(i), ")", "")
		sEdtText(i) = UCASE(sEdtText(i))
	Next

	If sLblText(1) == "" or sLblText(2) == "" or sLblText(3) == "" or sLblText(4) == "" then
		Form.ShowAlert("알림", "계약자 확인사항 내용 조회에 실패하였습니다.")
		return False
	End If	
	
	If sLblText(0) <> sEdtText(0) then
		Form.ShowAlert("알림", "1번 항목 입력 내용이 일치하지 않습니다.")
		return False
	End If

	If sLblText(1) <> sEdtText(1) then
		Form.ShowAlert("알림", "2번 항목 입력 내용이 일치하지 않습니다.")
		return False
	End If

	If sLblText(2) <> sEdtText(2) then
		Form.ShowAlert("알림", "3번 항목 입력 내용이 일치하지 않습니다.")
		return False
	End If
	
	If sLblText(3) <> sEdtText(3) then
		Form.ShowAlert("알림", "4번 항목 입력 내용이 일치하지 않습니다.")
		return False
	End If
	
	If sLblText(4) <> sEdtText(4) then
		Form.ShowAlert("알림", "5번 항목 입력 내용이 일치하지 않습니다.")
		return False
	End If
	
	If sLblText(5) <> sEdtText(5) then
		Form.ShowAlert("알림", "6번 항목 입력 내용이 일치하지 않습니다.")
		return False
	End If

	If sLblText(6) <> sEdtText(6) then
		Form.ShowAlert("알림", "7번 항목 입력 내용이 일치하지 않습니다.")
		return False
	End If
	
	return True
End Function

'============================================================================
'작성 후 재선택시 기존 작성 내용 유지
Function SaveInputText()
	Dim sText
	
	sText = cont0.edt0.caption & "★" 
	sText = sText & cont0.edt1.caption & "★" 
	sText = sText & cont0.edt2.caption & "★" 
	sText = sText & cont0.edt3.caption & "★" 
	sText = sText & cont0.edt4.caption & "★"
	sText = sText & cont0.edt5.caption & "★"
	sText = sText & cont0.edt6.caption & "★"
	
	return sText
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim sLinkData
	sLinkData = Form.GetOpenLinkData()
	g_szList = Split(sLinkData,"★")		

	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	Form.SetScreenName("이해여부 확인")
	Call SetInputText()

	g_OsType = Form.GetSharedData("&OS_TYPE", FALSE )



	DATAMANAGER.RequestTranData("obwat_pdad_060r")	'랩상품자사배분내역조회
	DATAMANAGER.RequestTranData("obwat_csad_003r")	'랩상품상세조회
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbisa56060_p8" , g_sRetData & "★" & SaveInputText() )
End Sub

'============================================================================
Sub btnOK_OnClick()
	If ValidateCheck() == False then
		Exit Sub
	End If
	
	g_sRetData = "ok"
	Form.SendReturnToParent( "mbisa56060_p8" , g_sRetData & "★" & SaveInputText() )
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_PRCD" , 0 , g_szList(1))	'랩어카운트상품코드	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obwat_pdad_060r" then	
		Call SetTableData(szTranID)
	End If

	If szTranID == "obwat_csad_003r" then
		Dim sRiskCode, sRiskText
		
		sRiskCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WA_PROD_RISK_CLCD" , 0)	
		Select Case sRiskCode
			Case "01"
				sRiskText = "매우높은위험"
			Case "02"
				sRiskText = "높음위험"
			Case "03"
				sRiskText = "다소높은위험"
			Case "04"
				sRiskText = "보통위험"
			Case "05"
				sRiskText = "낮은위험"
			Case "06"
				sRiskText = "매우낮은위험"
		End Select
		
		cont0.lbl4.caption = "(" & sRiskText & ")"			'3번 항목 위험등급		
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub


'============================================================================
Sub cont0_edt6_OnClick()

	IF g_OsType <> "1" THEN '안드로이드가 아닌경우에만
		cont0.Label0.top = 685+340
		cont0.scroll_pos = 340
		cont0.SetScrollAutoSize()
	END IF 
	
	
End Sub

'============================================================================
Sub cont0_edt6_OnEditComplete()
	IF g_OsType <> "1" THEN '안드로이드가 아닌경우에만
		cont0.Label0.top = 685
		cont0.scroll_pos = 170
		cont0.SetScrollAutoSize()
	end if 
End Sub

