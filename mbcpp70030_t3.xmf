	<SCRIPT_INFO _len="1785" _ulen="1785" >
--===========================================================================
Dim risk_combo_score
Dim risk_combo_value
Dim risk_radio_score
Dim risk_radio_value
Dim lose_score
Dim lose_value
--===========================================================================

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	if iIndex = 0 then
		risk_combo_score = 0
	elseif iIndex = 1 then
		risk_combo_score = 2
	elseif iIndex = 2 then
		risk_combo_score = 3
	else
		risk_combo_score = 5
	end if
	
	risk_combo_value = iIndex+1
	

	
	Form.SetSharedData("Risk_Combo_Value", risk_combo_value)
	Form.SetSharedData("Risk_Combo_Score", risk_combo_score)

End Sub

'============================================================================
Sub Combo1_OnEditComplete(iIndex)

	if iIndex = 0 then
		lose_score = -2
		
	elseif iIndex = 1 then
		lose_score = 2
		
	elseif iIndex = 2 then
		lose_score = 4
		
	else
		lose_score = 6
		
	end if
	
	lose_value = iIndex+1
	

	
	Form.SetSharedData("Lose_Value", lose_value)
	Form.SetSharedData("Lose_Score", lose_score)

End Sub

'============================================================================
Sub RadioGroup1_OnClick(nIndex)
	if nIndex = 0 then
		risk_radio_score = -2
	elseif nIndex = 1 then
		risk_radio_score = 2
	elseif nIndex = 2 then
		risk_radio_score = 4
	else
		risk_radio_score = 6
	end if
	
	risk_radio_value = nIndex+1
	

	Form.SetSharedData("Risk_Radio_Value", risk_radio_value)
	Form.SetSharedData("Risk_Radio_Score", risk_radio_score)
End Sub

'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("Risk_Combo_Score", 0)
	Form.SetSharedData("Lose_Score", -2)
	
End Sub

	</SCRIPT_INFO>
</ROOT>