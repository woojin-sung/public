'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************

'의견선택콤보 인덱스(0:전체의견 1:매수의견 2:중립의견 3:매도의견 4:투자의견상향 5:투자의견하향)
Dim g_nOpinionIndex	
Dim g_szDate
Dim g_szTitle
Dim g_szUrl, g_szPdf	'pdf경로
Dim g_szCode			'종목코드
Dim j
		

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'============================================================================
' TR_Inquiry(nOpinionIndex, szDate) - TR
'============================================================================
Function TR_Inquiry(nOpinionIndex, szDate)

	'최신투자의견 TR
	DATAMANAGER.SetDataValue(0, "ohhts_1651_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "J")
	DATAMANAGER.SetDataValue(0, "ohhts_1651_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE", 0, 1651)
	DATAMANAGER.SetDataValue(0, "ohhts_1651_001r", "InBlock1", "FID_INPUT_DIV_CLS_CODE", 0, nOpinionIndex)
	DATAMANAGER.SetDataValue(0, "ohhts_1651_001r", "InBlock1", "FID_INPUT_DATE1", 0 , szDate)
	DATAMANAGER.RequestTranData("ohhts_1651_001r")
	
End Function


'============================================================================
' IsValidDate() - 유효날짜 확인 
'============================================================================
Function IsValidDate()
	
	Dim bIsValidDate
	Dim szDataTo
	Dim szDataFrom
	
	bIsValidDate = True	
	szDataTo = cldTo.caption
	szDataFrom = cldFrom.caption
	

	If Len(Trim(szDataFrom)) <> 8 then
		Form.ShowAlert("알림", "날짜입력이 정확하지 않습니다.")
		bIsValidDate = False
		Exit Function
	end if	
	
	If CDbl(Trim(szDataFrom)) > CDbl(Trim(szDataTo)) then
		Form.ShowAlert("알림", "날짜입력이 정확하지 않습니다.")
		bIsValidDate = False
		Exit Function
	end if
	
	'/////////////////////////////////////////////
	'//// IOS 오류로 인해 주석 처리 '/////////////
	'/////////////////////////////////////////////
'	If Len(Trim(szDataTo)) > Form.GetSharedData("#BP_CURR_DATE", 0) then
'		Form.ShowAlert("날짜오류", "날짜입력이 정확하지 않습니다.")
'		bIsValidDate = False
'		Exit Function
'	end if
'	
'	If Len(Trim(szDataFrom)) > Form.GetSharedData("#BP_CURR_DATE", 0) then
'		Form.ShowAlert("날짜오류", "날짜입력이 정확하지 않습니다.")
'		bIsValidDate = False
'		Exit Function
'	end if		
	'/////////////////////////////////////////////
	'//// IOS 오류로 인해 주석 처리 '/////////////
	'/////////////////////////////////////////////
	
End Function





'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_nOpinionIndex = cmbOpinion.currentindex
	g_szDate = cldFrom.caption
	TR_Inquiry(g_nOpinionIndex, g_szDate)
	j=0
End Sub


'============================================================================
' cmbOpinion_OnEditComplete(iIndex) - 콤보박스 조회
'============================================================================
Sub cmbOpinion_OnEditComplete(iIndex)	
	g_nOpinionIndex = iIndex
	btnSearch_OnClick()
End Sub


'============================================================================
' cldFrom_OnEditComplete() - 달력 조회
'============================================================================
Sub cldFrom_OnEditComplete()
	if cldFrom.caption > cldToday.caption then
		Form.MsgBox("알림", "오늘 이전 날짜를 선택해 주세요", "", 0)
		cldFrom.caption = cldToday.caption
	end if
	g_szDate = cldFrom.caption
	btnSearch_OnClick()
End Sub


'============================================================================
' btnSearch_OnClick() - 조회
'============================================================================
Sub btnSearch_OnClick()
	j=0
	call IsValidDate()
	call TR_Inquiry(g_nOpinionIndex, g_szDate)
End Sub





'============================================================================
' grdRecentOpinion_OnScrollEnd()
'============================================================================
Sub grdRecentOpinion_OnScrollEnd()
	DATAMANAGER.RequestNextData( "ohhts_1651_001r" )
End Sub


'============================================================================
' grdRecentOpinion_OnClickUp(lRow, szCellID)
'============================================================================
Sub grdRecentOpinion_OnClickUp(lRow, szCellID)	
	
	Dim listLocation
	Dim nYPos
	Dim height
	
	listLocation = Split(grdRecentOpinion.location, ":")
	nYPos = Int(listLocation[1])	'y위치
	height = listLocation[3]		'높이
	
	sPopupType = "0"
	
	g_szUrl = "http://home.imeritz.com/HKCPDF"
	g_szPdf = g_szUrl & grdRecentOpinion.GetCellData( "bd_cell5", lRow )
	
	g_szCode = grdRecentOpinion.GetCellData("bd_cell6", lRow )
	
	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "차트" & "★" & "PDF리포트" & "★" & "매수" & "★" & "매도")
End Sub


'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	Dim szListItems
	
	if sKeyName = "MOVEPOP_RETURN"	then
	
		szListItems = Split(sRet, "★")
		
		if szListItems(1) = "0" then	'현재가
			Form.OpenScreen("11000" , g_szCode & "★" & "0")
		elseif szListItems(1) = "1" then	'주식차트
			Form.OpenScreen("13000" , g_szCode)
		elseif szListItems(1) = "2" then	'PDF뷰어
			Form.OpenPdfViewer( g_szPdf, "리포트" )
		elseif szListItems(1) = "3" then	'매수
			Form.OpenScreen("12000" , "기타" & "★" & "0"  & "★" & g_szCode)
		elseif szListItems(1) = "4" then	'매도
			Form.OpenScreen("12000" , "기타" & "★" & "1"  & "★" & g_szCode)
		else 
		
		end if
	
	end if
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_1651_001r" then
	
		for i=0 to DATAMANAGER.GetDataCount(0,"ohhts_1651_001r", "OutBlock1" ) - 1			
			j= j+1
			Dim szTitle, szIsnm, szIscd
			szTitle = DATAMANAGER.GetDataValue(0, "ohhts_1651_001r", "OutBlock1", "FID_TITL2" , i)
			szTitle = Split(szTitle, "(", -1, 1)
			
			'20211206 SWJ START : 예외처리 추가
			if Ubound(szTitle) < 1 then
				szIsnm = ""
				szIscd = ""
			else
				szIsnm = Trim(szTitle(0))
				szIscd = Trim(szTitle(1))
				szIscd = Left(szIscd, 6) '20170320 HWG - 종목코드 필터링 수정 (종목코드만 추출)
			end if
			'20211206 SWJ END
			
			grdRecentOpinion.SetCellData( "bd_cell1", j-1, szIsnm )
			grdRecentOpinion.SetCellData( "bd_cell6", j-1, szIscd )
		next
	end if
End Sub



