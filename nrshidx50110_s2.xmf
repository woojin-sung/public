'===============================================
' 원자재 초기설정
'===============================================
' 원자재 기본컨트롤 설정 
Function Init_Control_Material()
	' 원자재 분류
	contMain.contMaterial.lblSubTitleMaterial0.paddinginfo = "0,0,0,0"
	contMain.contMaterial.lblSubTitleMaterial0.fgcolor = g_szTxtColor_Grey
	
	contMain.contMaterial.lblChk.fgcolor = g_szTxtColor_Grey
	contMain.contMaterial.lblChk.paddinginfo = "0,0,0,0"
	
	contMain.contMaterial.lblChk.setNeighborCtlPos("imgChk", "left", 2, "전체")
	
	contMain.contMaterial.imgChk.setMaintainingRatio("3")
	contMain.contMaterial.imgChk.imgpath = g_szChkImg_Normal
	
	' 귀금속 분류
	contMain.contMaterial.lblSubTitleMaterial1.paddinginfo = "0,0,0,0"
	contMain.contMaterial.lblSubTitleMaterial1.fgcolor = g_szTxtColor_Grey
	
	contMain.contMaterial.lblChk2.fgcolor = g_szTxtColor_Grey
	contMain.contMaterial.lblChk2.paddinginfo = "0,0,0,0"
	
	contMain.contMaterial.lblChk2.setNeighborCtlPos("imgChk", "left", 2, "전체")
	
	contMain.contMaterial.imgChk2.setMaintainingRatio("3")
	contMain.contMaterial.imgChk2.imgpath = g_szChkImg_Normal
	
	' 산업금속 분류
	contMain.contMaterial.lblSubTitleMaterial2.paddinginfo = "0,0,0,0"
	contMain.contMaterial.lblSubTitleMaterial2.fgcolor = g_szTxtColor_Grey
	
	contMain.contMaterial.lblChk3.fgcolor = g_szTxtColor_Grey
	contMain.contMaterial.lblChk3.paddinginfo = "0,0,0,0"
	
	contMain.contMaterial.lblChk3.setNeighborCtlPos("imgChk", "left", 2, "전체")
	
	contMain.contMaterial.imgChk3.setMaintainingRatio("3")
	contMain.contMaterial.imgChk3.imgpath = g_szChkImg_Normal
End Function

' 원자재 기본컨트롤 보임처리 
Function DisplaySetting_Control_Material(szGbn, isVisible)
	if szGbn = "원자재" then
		contMain.contMaterial.lblSubTitleMaterial0.visible = isVisible
		
		contMain.contMaterial.lblChk.visible = isVisible
		contMain.contMaterial.imgChk.visible = isVisible
		contMain.contMaterial.btnChk.visible = isVisible
		
		contMain.contMaterial.Pannel4.visible = isVisible
		
		
	elseif szGbn = "귀금속" then
		contMain.contMaterial.lblSubTitleMaterial1.visible = isVisible
		
		contMain.contMaterial.lblChk2.visible = isVisible
		contMain.contMaterial.imgChk2.visible = isVisible
		contMain.contMaterial.btnChk2.visible = isVisible
		
		contMain.contMaterial.Pannel8.visible = isVisible
		
		if isVisible =  true then
			nTop = contMain.contMaterial.Pannel4.top
			nHeight = contMain.contMaterial.Pannel4.height
			
			nTitleTop = nTop + nHeight + g_nCommon_Margin3
			nPannelTop = nTitleTop + g_nCommon_Margin4
			contMain.contMaterial.lblSubTitleMaterial1.top = nTitleTop
			
			contMain.contMaterial.lblChk2.top = nTitleTop
			contMain.contMaterial.imgChk2.top = nTitleTop
			contMain.contMaterial.btnChk2.top = nTitleTop
			
			contMain.contMaterial.Pannel8.top = nPannelTop
			
			nTop = contMain.contMaterial.Pannel8.top
			nHeight = contMain.contMaterial.Pannel8.height
			
			nTitleTop = nTop + nHeight + g_nCommon_Margin3
			nPannelTop = nTitleTop + g_nCommon_Margin4
			
			contMain.contMaterial.lblSubTitleMaterial2.top = nTitleTop
			
			contMain.contMaterial.lblChk3.top = nTitleTop
			contMain.contMaterial.imgChk3.top = nTitleTop
			contMain.contMaterial.btnChk3.top = nTitleTop
			
			contMain.contMaterial.Pannel9.top = nPannelTop
		else
			Clear_Material_Jewelry()
		end if
		
	elseif szGbn = "산업금속" then
		contMain.contMaterial.lblSubTitleMaterial2.visible = isVisible
		
		contMain.contMaterial.lblChk3.visible = isVisible
		contMain.contMaterial.imgChk3.visible = isVisible
		contMain.contMaterial.btnChk3.visible = isVisible
		
		contMain.contMaterial.Pannel9.visible = isVisible
		
		nIdx = Return_ArrayIndex(g_arrMaterial, "귀금속")
	
		if isVisible = true then
			if g_arrMaterial_Check(nIdx) = "1" then
				nTop = contMain.contMaterial.Pannel4.top
				nHeight = contMain.contMaterial.Pannel4.height
				
				nTitleTop = nTop + nHeight + g_nCommon_Margin3
				nPannelTop = nTitleTop + g_nCommon_Margin4
				contMain.contMaterial.lblSubTitleMaterial1.top = nTitleTop
				
				contMain.contMaterial.lblChk2.top = nTitleTop
				contMain.contMaterial.imgChk2.top = nTitleTop
				contMain.contMaterial.btnChk2.top = nTitleTop
				
				contMain.contMaterial.Pannel8.top = nPannelTop
				
				nTop = contMain.contMaterial.Pannel8.top
				nHeight = contMain.contMaterial.Pannel8.height
				
				nTitleTop = nTop + nHeight + g_nCommon_Margin3
				nPannelTop = nTitleTop + g_nCommon_Margin4
				
				contMain.contMaterial.lblSubTitleMaterial2.top = nTitleTop
				
				contMain.contMaterial.lblChk3.top = nTitleTop
				contMain.contMaterial.imgChk3.top = nTitleTop
				contMain.contMaterial.btnChk3.top = nTitleTop
				
				contMain.contMaterial.Pannel9.top = nPannelTop
				
			else
				
				nTop = contMain.contMaterial.Pannel4.top
				nHeight = contMain.contMaterial.Pannel4.height
				
				nTitleTop = nTop + nHeight + g_nCommon_Margin3
				nPannelTop = nTitleTop + g_nCommon_Margin4
				
				contMain.contMaterial.lblSubTitleMaterial2.top = nTitleTop
				
				contMain.contMaterial.lblChk3.top = nTitleTop
				contMain.contMaterial.imgChk3.top = nTitleTop
				contMain.contMaterial.btnChk3.top = nTitleTop
				
				contMain.contMaterial.Pannel9.top = nPannelTop
				
			end if
		else
			Clear_Material_Industrial()
		end if
	else
		'none
	end if
	
	isPannel9 = contMain.contMaterial.Pannel9.visible
	isPannel8 = contMain.contMaterial.Pannel8.visible
	
	if isPannel9 = "0" and isPannel8 = "0" then
		contMain.contMaterial.height = contMain.contMaterial.Pannel4.top + g_nStep0_Pannel_Height + g_nBottom_Margin
	elseif isPannel9 = "0" and isPannel8 = "1" then
	
		contMain.contMaterial.height = contMain.contMaterial.Pannel8.top + g_nStep1_Pannel_Height + g_nBottom_Margin
	else

		contMain.contMaterial.height = contMain.contMaterial.Pannel9.top + g_nStep2_Pannel_Height + g_nBottom_Margin
	end if
End Function

' 원자재 분류 데이터 세팅
Function Init_Material()
	g_arrMaterial = {}
	g_arrMaterial_Check = {}
	
	szData = Form.GetSharedData("ETF_Step1_2", false)
	g_arrMaterial = Convert_StringToArr(szData, "`")
	
	nArrCnt = #g_arrMaterial
	
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 

	contMain.contMaterial.Pannel4.rowcount = nPannelRowCnt
	
	g_nStep0_Pannel_Height = (g_nCommon_Row_Height  * nPannelRowCnt) + (g_nCommon_Row_Gap * (nPannelRowCnt-1))
	contMain.contMaterial.Pannel4.height = g_nStep0_Pannel_Height + 5
	
	nArrIdx = 0
	
	for i = 0 to nPannelRowCnt - 1
		g_arrMaterial_Check(nArrIdx) = "0"
		contMain.contMaterial.Pannel4.SetCellValue( "lblMaterial0", i, g_arrMaterial(nArrIdx))	
		
		contMain.contMaterial.Pannel4.setPropCardCell("imagefilepth", "lblMaterial0", i, g_szBtnImg_Normal)
		contMain.contMaterial.Pannel4.setPropCardCell("fgcolor", "lblMaterial0", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contMaterial.Pannel4.SetCellVisible("lblMaterial1",i,false)
			contMain.contMaterial.Pannel4.SetCellVisible("lblMaterial2",i,false)
			
			contMain.contMaterial.Pannel4.setPropCardCell("enable"	, "lblMaterial1", i, false)
			contMain.contMaterial.Pannel4.setPropCardCell("enable"	, "lblMaterial2", i, false)
			Exit for
		end if
		
		g_arrMaterial_Check(nArrIdx) = "0"
		contMain.contMaterial.Pannel4.SetCellValue( "lblMaterial1", i, g_arrMaterial(nArrIdx))
		
		contMain.contMaterial.Pannel4.setPropCardCell("imagefilepth", "lblMaterial1", i, g_szBtnImg_Normal)
		contMain.contMaterial.Pannel4.setPropCardCell("fgcolor", "lblMaterial1", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contMaterial.Pannel4.SetCellVisible("lblMaterial2",i,false)
			contMain.contMaterial.Pannel4.setPropCardCell("enable"	, "lblMaterial2", i, false)
			Exit for
		end if
		
		g_arrMaterial_Check(nArrIdx) = "0"
		contMain.contMaterial.Pannel4.SetCellValue( "lblMaterial2", i, g_arrMaterial(nArrIdx))	
		
		contMain.contMaterial.Pannel4.setPropCardCell("imagefilepth", "lblMaterial2", i, g_szBtnImg_Normal)
		contMain.contMaterial.Pannel4.setPropCardCell("fgcolor", "lblMaterial2", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
End Function

' 원자재 > 귀금속 분류 데이터 세팅 
Function Init_Material_Jewelry()
	' 귀금속 분류 배열 초기화
	g_arrMaterial_Jewelry = {}
	g_arrMaterial_Jewelry_Check = {}
	
	' 귀금속 분류 데이터 로드
	nArrIdx = Return_ArrayIndex(g_arrMaterial, "귀금속")
	szData = Form.GetSharedData("ETF_Step2_2_"&nArrIdx, false)
	g_arrMaterial_Jewelry = Convert_StringToArr(szData, "`")
	
	nArrCnt = #g_arrMaterial_Jewelry
	
	nPannelRowCnt = Cint(nArrCnt / 4)
	if (nArrCnt mod 4) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 
	
	' 귀금속 분류 항목 패널 세팅
	contMain.contMaterial.Pannel8.rowcount = nPannelRowCnt
	
	g_nStep1_Pannel_Height = (g_nCommon_Row_Height  * nPannelRowCnt) + (g_nCommon_Row_Gap * (nPannelRowCnt-1))
	contMain.contMaterial.Pannel8.height = g_nStep1_Pannel_Height + 5

	nArrIdx = 0
	
	for i = 0 to nPannelRowCnt - 1
		' 패널 첫번째 컨트롤
		contMain.contMaterial.Pannel8.SetCellValue( "lblMaterial00", i, g_arrMaterial_Jewelry(nArrIdx))	
		
		g_arrMaterial_Jewelry_Check(nArrIdx) = "0"
		contMain.contMaterial.Pannel8.setPropCardCell("imagefilepth"	, "lblMaterial00", i, g_szBtnImg_Normal)
		contMain.contMaterial.Pannel8.setPropCardCell("fgcolor"		, "lblMaterial00", i, g_szTxtColor_Normal)
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contMaterial.Pannel8.SetCellVisible("lblMaterial01",i,false)
			contMain.contMaterial.Pannel8.SetCellVisible("lblMaterial02",i,false)
			contMain.contMaterial.Pannel8.SetCellVisible("lblMaterial03",i,false)
			
			contMain.contMaterial.Pannel8.setPropCardCell("enable"	, "lblMaterial01", i, false)
			contMain.contMaterial.Pannel8.setPropCardCell("enable"	, "lblMaterial02", i, false)
			contMain.contMaterial.Pannel8.setPropCardCell("enable"	, "lblMaterial03", i, false)
			Exit for
		end if
		
		' 패널 두번째 컨트롤
		contMain.contMaterial.Pannel8.SetCellValue( "lblMaterial01", i, g_arrMaterial_Jewelry(nArrIdx))	
		
		g_arrMaterial_Jewelry_Check(nArrIdx) = "0"
		contMain.contMaterial.Pannel8.setPropCardCell("imagefilepth"	, "lblMaterial01", i, g_szBtnImg_Normal)
		contMain.contMaterial.Pannel8.setPropCardCell("fgcolor"		, "lblMaterial01", i, g_szTxtColor_Normal)
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contMaterial.Pannel8.SetCellVisible("lblMaterial02",i,false)
			contMain.contMaterial.Pannel8.SetCellVisible("lblMaterial03",i,false)
			
			contMain.contMaterial.Pannel8.setPropCardCell("enable"	, "lblMaterial02", i, false)
			contMain.contMaterial.Pannel8.setPropCardCell("enable"	, "lblMaterial03", i, false)
			Exit for
		end if
		
		' 패널 세번째 컨트롤
		contMain.contMaterial.Pannel8.SetCellValue( "lblMaterial02", i, g_arrMaterial_Jewelry(nArrIdx))	
		
		g_arrMaterial_Jewelry_Check(nArrIdx) = "0"
		contMain.contMaterial.Pannel8.setPropCardCell("imagefilepth"	, "lblMaterial02", i, g_szBtnImg_Normal)
		contMain.contMaterial.Pannel8.setPropCardCell("fgcolor"		, "lblMaterial02", i, g_szTxtColor_Normal)
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contMaterial.Pannel8.SetCellVisible("lblMaterial03",i,false)
		
			contMain.contMaterial.Pannel8.setPropCardCell("enable"	, "lblMaterial03", i, false)
			Exit for
		end if
		
		' 패널 네번째 컨트롤
		contMain.contMaterial.Pannel8.SetCellValue( "lblMaterial03", i, g_arrMaterial_Jewelry(nArrIdx))	
		
		g_arrMaterial_Jewelry_Check(nArrIdx) = "0"
		contMain.contMaterial.Pannel8.setPropCardCell("imagefilepth"	, "lblMaterial03", i, g_szBtnImg_Normal)
		contMain.contMaterial.Pannel8.setPropCardCell("fgcolor"		, "lblMaterial03", i, g_szTxtColor_Normal)
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
End Function

' 원자재 > 산업금속 분류 데이터 세팅 
Function Init_Material_Industrial()
	' 산업금속 분류 배열 초기화
	g_arrMaterial_Industrial = {}
	g_arrMaterial_Industrial_Check = {}
	
	' 산업금속 분류 데이터 로드
	nArrIdx = Return_ArrayIndex(g_arrMaterial, "산업금속")
	szData = Form.GetSharedData("ETF_Step2_2_"&nArrIdx, false)
	g_arrMaterial_Industrial = Convert_StringToArr(szData, "`")
	
	nArrCnt = #g_arrMaterial_Industrial
	
	nPannelRowCnt = Cint(nArrCnt / 2)
	if (nArrCnt mod 2) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 
	
	' 귀금속 분류 항목 패널 세팅
	contMain.contMaterial.Pannel9.rowcount = nPannelRowCnt
	g_nStep2_Pannel_Height = (g_nCommon_Row_Height  * nPannelRowCnt) + (g_nCommon_Row_Gap * (nPannelRowCnt-1))
	contMain.contMaterial.Pannel9.height = g_nStep2_Pannel_Height + 5

	nArrIdx = 0
	
	for i = 0 to nPannelRowCnt - 1
		' 패널 첫번째 컨트롤
		contMain.contMaterial.Pannel9.SetCellValue( "lblMaterial10", i, g_arrMaterial_Industrial(nArrIdx))	
		
		g_arrMaterial_Industrial_Check(nArrIdx) = "0"
		contMain.contMaterial.Pannel9.setPropCardCell("imagefilepth"	, "lblMaterial10", i, g_szBtnImg_Normal)
		contMain.contMaterial.Pannel9.setPropCardCell("fgcolor"		, "lblMaterial10", i, g_szTxtColor_Normal)
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contMaterial.Pannel9.SetCellVisible("lblMaterial11",i,false)
			contMain.contMaterial.Pannel9.setPropCardCell("enable"	, "lblMaterial11", i, false)

			Exit for
		end if
		
		' 패널 두번째 컨트롤
		contMain.contMaterial.Pannel9.SetCellValue( "lblMaterial11", i, g_arrMaterial_Industrial(nArrIdx))	
		
		g_arrMaterial_Industrial_Check(nArrIdx) = "0"
		contMain.contMaterial.Pannel9.setPropCardCell("imagefilepth"	, "lblMaterial11", i, g_szBtnImg_Normal)
		contMain.contMaterial.Pannel9.setPropCardCell("fgcolor"		, "lblMaterial11", i, g_szTxtColor_Normal)
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
End Function

Function DisplaySetting_Material(nidx,szCtlNm)
	nIndex = 0
	
	if g_szChk_Material = "1" then
		g_szChk_Material = "0"
		contMain.contMaterial.imgChk.imgpath = g_szChkImg_Normal
	end if
	
	if szCtlNm = "lblMaterial0" then
		nIndex = nidx * 3 + 0
	elseif szCtlNm = "lblMaterial1" then
		nIndex = nidx * 3 + 1
	elseif szCtlNm = "lblMaterial2" then
		nIndex = nidx * 3 + 2
	end if
	
	if g_arrMaterial_Check(nIndex) = "0" then
		g_arrMaterial_Check(nIndex) = "1"
		contMain.contMaterial.Pannel4.setPropCardCell("imagefilepth", szCtlNm, nidx, g_szBtnImg_Select)
	else 
		g_arrMaterial_Check(nIndex) = "0"
		contMain.contMaterial.Pannel4.setPropCardCell("imagefilepth", szCtlNm, nidx, g_szBtnImg_Normal)
	end if
	
	szReturn = Return_AllChkYN(g_arrMaterial_Check)
						
	if szReturn = "Y" then
		g_szChk_Material = "1"
		contMain.contMaterial.imgChk.imgpath = g_szChkImg_Select
	else
		g_szChk_Material = "0"
		contMain.contMaterial.imgChk.imgpath = g_szChkImg_Normal
	end if
	
	DisplaySetting_Material_SubView()
End Function

