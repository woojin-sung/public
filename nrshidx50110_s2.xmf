Sub Form_OnFormInit()
	g_szSharedData = Form.GetSharedData(g_szSharedKey, false)
	g_szSharedData_S1 = Form.GetSharedData("50110_S1_CHECK", false )
	'마지막 저장정보 리로드
	Init_Control()
	Init_Assets()

	Load_ChkData(g_szSharedData)
	
	Send_ChkDataToParent()
End Sub

'===============================================
' contMain_cmbAssets_OnEditComplete
'===============================================
Sub contMain_cmbAssets_OnEditComplete(iIndex)
	DisplaySetting_AssetsCont(iIndex)
	
	if g_isLoadChkData = "0" then
		Send_ChkDataToParent()
	else
		g_isLoadChkData = "0"
	end if
End Sub


'============================================================================
Sub contMain_contStock_Pannel0_OnClick(nIndex, sCellID)
	if sCellID = "" then
		Exit Sub
	end if
	
	nIdx = 0
	if sCellID = "lblStockStep00" then
		nIdx = nIndex * 4 + 0
	elseif sCellID = "lblStockStep01" then
		nIdx = nIndex * 4 + 1
	elseif sCellID = "lblStockStep02" then
		nIdx = nIndex * 4 + 2
	elseif sCellID = "lblStockStep03" then
		nIdx = nIndex * 4 + 3
	end if
	
	if g_arrStock_Step0_Check = nIdx then
		g_arrStock_Step0_Check = -1
		
		DisplaySetting_AssetsCont(0)
		
		Send_ChkDataToParent()
	else
	
		' 주식 Step1 세팅
		Init_Stock_Step1(nIdx)
	
		' 주식유형 선택 표시
		DisplaySetting_Stock_Step0(nIdx)
		
		Send_ChkDataToParent()
	end if

End Sub

'============================================================================
Sub contMain_contStock_Pannel1_OnClick(nIndex, sCellID)
	if sCellID = "" then
		Exit Sub
	end if
	
	nIdx = 0
	if sCellID = "lblStockStep20" then
		nIdx = nIndex * 3 + 0
	elseif sCellID = "lblStockStep21" then
		nIdx = nIndex * 3 + 1
	elseif sCellID = "lblStockStep22" then
		nIdx = nIndex * 3 + 2
	end if
	
	' 스타일-사이즈 선택 표시
	DisplaySetting_Stock_Step2(g_arrStock_Step0_Check, nIdx, "")
	
	Send_ChkDataToParent()
End Sub

'============================================================================
Sub contMain_contStock_lblStockStep1_OnClick()
	if g_arrStock_Step0_Check = 0 then
		szText = ""
		g_szSharedData_S1 = Form.GetSharedData("50110_S1_CHECK", false )
		if g_szSharedData_S1 <> "" then
			szText = "투자지역을 선택한 경우 국가 선택이 불가해요"
		end if
		Form.OpenPopup("nrshidx50110_p3" , "Stock_Step1★0★1★" & Convert_ArrToString(g_arrStock_Step1, "`") & "★" & Convert_ArrToString(g_arrStock_Step1_Check, "`") & "★" & szText , "")
	else
		Form.OpenPopup("nrshidx50110_p3" , "Stock_Step1★0★1★" & Convert_ArrToString(g_arrStock_Step1, "`") & "★" & Convert_ArrToString(g_arrStock_Step1_Check, "`") , "")
	end if

End Sub
