'============================================================================
Sub contMain_contBond_imgTooltip_OnClick()
	sText = "만기 구분\n·장기 : 10년 이상     ·중기 : 3~10년\n·단기 : 1~3년           ·초단기 : 1년 이하"
	g_nCommFontSize = Form.getEnvData("common.textsize")
	
	if g_nCommFontSize = "1" or g_nCommFontSize = "2" then
		contMain.contBond.imgTooltip.openToolTip( sText, 350, 100, 1 )
	else
		contMain.contBond.imgTooltip.openToolTip( sText, 300, 100, 1 )
	end if
	
End Sub

