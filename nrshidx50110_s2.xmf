Function DisplaySetting_Bond_Step0(nidx,szCtlNm)
	if g_szChk_Bond0 = "1" then
		g_szChk_Bond0 = "0"
		contMain.contBond.imgChk.imgpath = g_szChkImg_Normal
	end if
		
	nIndex = 0
	
	if szCtlNm = "lblBond0" then
		nIndex = nidx * 3 + 0
	elseif szCtlNm = "lblBond1" then
		nIndex = nidx * 3 + 1
	elseif szCtlNm = "lblBond2" then
		nIndex = nidx * 3 + 2
	end if
	
	if g_arrBond_Step0_Check(nIndex) = "0" then
		g_arrBond_Step0_Check(nIndex) = "1"
		contMain.contBond.Pannel2.setPropCardCell("imagefilepth", szCtlNm, nidx, g_szBtnImg_Select)
	else 
		g_arrBond_Step0_Check(nIndex) = "0"
		contMain.contBond.Pannel2.setPropCardCell("imagefilepth", szCtlNm, nidx, g_szBtnImg_Normal)
	end if
	
	szChk = "0"
		
	for i = 0 to #g_arrBond_Step0_Check-1
		if g_arrBond_Step0(i) <> "국채" and g_arrBond_Step0_Check(i) = "1" then
			szChk = "1"
			Exit for
		end if
	next
		
	if szChk = "0" then
		Init_Bond_Step2()
		
		contMain.contBond.lblSubTitleBond2.visible = false
		contMain.contBond.Pannel7.visible = false
		contMain.contBond.lblChk1.visible = false
		contMain.contBond.imgChk1.visible = false
		
		contMain.contBond.height = contMain.contBond.Pannel3.top + g_nStep1_Pannel_Height + g_nBottom_Margin
	else
		contMain.contBond.lblSubTitleBond2.visible = true
		contMain.contBond.Pannel7.visible = true
		contMain.contBond.lblChk1.visible = true
		contMain.contBond.imgChk1.visible = true
		
		contMain.contBond.height =  contMain.contBond.Pannel7.top + g_nStep2_Pannel_Height + g_nBottom_Margin
	end if

	
	szReturn = Return_AllChkYN(g_arrBond_Step0_Check)
						
	if szReturn = "Y" then
		g_szChk_Bond0 = "1"
		contMain.contBond.imgChk.imgpath = g_szChkImg_Select
	else
		g_szChk_Bond0 = "0"
		contMain.contBond.imgChk.imgpath = g_szChkImg_Normal
	end if
End Function

Function Reload_Bond_Step0(nArrIdx)
	nIndex = 0
	
	nIndex= nArrIdx / 3 
	nCtlIdx = nArrIdx % 3
	szCtlNm = ""
	
	if nCtlIdx = 0 then
		szCtlNm = "lblBond0"
	elseif nCtlIdx = 1 then
		szCtlNm = "lblBond1"
	elseif nCtlIdx = 2 then
		szCtlNm = "lblBond2"
	end if
	
	
	g_arrBond_Step0_Check(nArrIdx) = "1"
	contMain.contBond.Pannel2.setPropCardCell("imagefilepth", szCtlNm, nIndex, g_szBtnImg_Select)
	
	szChk = "0"
		
	for i = 0 to #g_arrBond_Step0_Check-1
		if g_arrBond_Step0(i) <> "국채" and g_arrBond_Step0_Check(i) = "1" then
			szChk = "1"
			Exit for
		end if
	next
		
	if szChk = "0" then
		Init_Bond_Step2()
		
		contMain.contBond.lblSubTitleBond2.visible = false
		contMain.contBond.Pannel7.visible = false
		contMain.contBond.lblChk1.visible = false
		contMain.contBond.imgChk1.visible = false
		
		contMain.contBond.height = contMain.contBond.Pannel3.top + g_nStep1_Pannel_Height + g_nBottom_Margin
	else
		contMain.contBond.lblSubTitleBond2.visible = true
		contMain.contBond.Pannel7.visible = true
		contMain.contBond.lblChk1.visible = true
		contMain.contBond.imgChk1.visible = true
		
		contMain.contBond.height =  contMain.contBond.Pannel7.top + g_nStep2_Pannel_Height + g_nBottom_Margin
	end if
	
'	if g_arrBond_Step0(nArrIdx) <> "국채" then
'		if g_arrBond_Step0_Check(nIndex) = "0" then
'			
'			Init_Bond_Step2()
