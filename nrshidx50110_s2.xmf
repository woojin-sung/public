'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	' 기초자산
	contMain.lblSubTitle.fgcolor = g_szTxtColor_Normal
	contMain.lblSubTitle.paddinginfo = "0,0,0,0"

	contMain.cmbAssets.fgcolor = g_szTxtColor_Normal
	contMain.cmbAssets.imagefilepth = g_szCmbImg_Normal
	
	contMain.setScrollBarVisible("2")
	
	contMain.setExceptInvisibleCtl(true)
	contMain.contStcok.setExceptInvisibleCtl(true)
	contMain.contBond.setExceptInvisibleCtl(true)
	contMain.contMaterial.setExceptInvisibleCtl(true)
	contMain.contMix.setExceptInvisibleCtl(true)
	contMain.contAlter.setExceptInvisibleCtl(true)
	
'	contMain.contStcok.setEnableScroll(false)
'	contMain.contBond.setEnableScroll(false)
'	contMain.contMaterial.setEnableScroll(false)
'	contMain.contMix.setEnableScroll(false)
'	contMain.contAlter.setEnableScroll(false)
End Function

'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Data()
	g_arrAssets = {}
End Function

'===============================================
' 기초자산 초기설정
'===============================================
Function Init_Assets()
	szData = Form.GetSharedData("ETF_Step0", false)
	g_arrAssets = Convert_StringToArr(szData, "`")
	
	nArrCnt = #g_arrAssets
	for i = 0 to nArrCnt-1
		contMain.cmbAssets.cbadddatatext = i&"`"&g_arrAssets(i)
	next
	
	g_isLoadChkData = "1"
	contMain.cmbAssets.currentindex = -1
	contMain.cmbAssets.caption = "선택해주세요"
	contMain_cmbAssets_OnEditComplete(-1)
	g_isLoadChkData = "0"
End Function

'===============================================
' 기초자산별 컨테이너 세팅
'===============================================
Function DisplaySetting_AssetsCont(nidx)
	
	g_nAssetsIdx = nIdx

	if nidx = 0 then
		'===============================================
		'주식
		'===============================================
		Init_Stock_Step0()
		
		contMain.contStock.visible 		= true
		contMain.contStock.left 		= 0
		contMain.contStock.top			= 120
		
		contMain.contBond.visible 		= false
		contMain.contBond.left			= 400
		contMain.contBond.top			= -1000
		
		contMain.contMaterial.visible 	= false
		contMain.contMaterial.left		= 400
		contMain.contMaterial.top			= -1000
		
		contMain.contMix.visible 		= false
		contMain.contMix.left			= 400
		contMain.contMix.top			= -1000
		
		contMain.contAlter.visible 		= false
		contMain.contAlter.left		= 400
		contMain.contAlter.top			= -1000
	elseif nidx = 1 then
		'===============================================
		'채권
		'===============================================
		Init_Bond()
		
		contMain.contStock.visible 		= false
		contMain.contStock.left 		= 400
		contMain.contStock.top			= -1000
		
		contMain.contBond.visible 		= true
		contMain.contBond.left			= 0
		contMain.contBond.top			= 120
		
		contMain.contMaterial.visible 	= false
		contMain.contMaterial.left		= 400
		contMain.contMaterial.top			= -1000
		
		contMain.contMix.visible 		= false
		contMain.contMix.left			= 400
		contMain.contMix.top			= -1000
		
		contMain.contAlter.visible 		= false
		contMain.contAlter.left		= 400
		contMain.contAlter.top			= -1000
		
		
	elseif nidx = 2 then
		'===============================================
		'원자재
		'===============================================
		Init_Control_Material()
	
		Init_Material()
		Init_Material_Jewelry()
		Init_Material_Industrial()
		
		DisplaySetting_Control_Material("원자재", true)
		DisplaySetting_Control_Material("귀금속", false)
		DisplaySetting_Control_Material("산업금속", false)
		
		contMain.contStock.visible 		= false
		contMain.contStock.left 		= 400
		
		contMain.contBond.visible 		= false
		contMain.contBond.left			= 400
		
		contMain.contMaterial.visible 	= true
		contMain.contMaterial.left		= 0
		
		contMain.contMix.visible 		= false
		contMain.contMix.left			= 400
		
		contMain.contAlter.visible 		= false
		contMain.contAlter.left		= 400
		
		contMain.contStock.top			= -1000
		contMain.contBond.top			= -1000
		contMain.contMaterial.top		= 120
		contMain.contMix.top			= -1000
		contMain.contAlter.top			= -1000
	elseif nidx = 3 then
		'===============================================
		'혼한(주식/채권)
		'===============================================
		Init_Mix()
		
		contMain.contStock.visible 		= false
		contMain.contStock.left 		= 400
		
		contMain.contBond.visible 		= false
		contMain.contBond.left			= 400
		
		contMain.contMaterial.visible 	= false
		contMain.contMaterial.left		= 400
		
		contMain.contMix.visible 		= true
		contMain.contMix.left			= 0
		
		contMain.contAlter.visible 		= false
		contMain.contAlter.left		= 400
		
		contMain.contStock.top			= -1000
		contMain.contBond.top			= -1000
		contMain.contMaterial.top		= -1000
		contMain.contMix.top			= 120
		contMain.contAlter.top			= -1000
	elseif nidx = 4 then
		'===============================================
		'대체
		'===============================================
		Init_Alter()
		
		contMain.contStock.visible 		= false
		contMain.contStock.left 		= 400
		
		contMain.contBond.visible 		= false
		contMain.contBond.left			= 400
		
		contMain.contMaterial.visible 	= false
		contMain.contMaterial.left		= 400
		
		contMain.contMix.visible 		= false
		contMain.contMix.left			= 400
		
		contMain.contAlter.visible 		= true
		contMain.contAlter.left		= 0
		
		contMain.contStock.top			= -1000
		contMain.contBond.top			= -1000
		contMain.contMaterial.top		= -1000
		contMain.contMix.top			= -1000
		contMain.contAlter.top			= 120
	elseif nidx = 5 then
		'===============================================
		'머니마켓
		'===============================================
		contMain.contStock.visible 		= false
		contMain.contStock.left 		= 400
		
		contMain.contBond.visible 		= false
		contMain.contBond.left			= 400
		
		contMain.contMaterial.visible 	= false
		contMain.contMaterial.left		= 400
		
		contMain.contMix.visible 		= false
		contMain.contMix.left			= 400
		
		contMain.contAlter.visible 		= false
		contMain.contAlter.left		= 400
		
		contMain.contStock.top		= -1000
		contMain.contBond.top			= -1000
		contMain.contMaterial.top		= -1000
		contMain.contMix.top			= -1000
		contMain.contAlter.top			= -1000
	else
		'===============================================
		'초기값
		'===============================================
		contMain.contStock.visible 	= false
		contMain.contStock.left 		= 400
		
		contMain.contBond.visible 		= false
		contMain.contBond.left			= 400
		
		contMain.contMaterial.visible 	= false
		contMain.contMaterial.left		= 400
		
		contMain.contMix.visible 		= false
		contMain.contMix.left			= 400
		
		contMain.contAlter.visible 	= false
		contMain.contAlter.left		= 400
		
		contMain.contStock.top			= -1000
		contMain.contBond.top			= -1000
		contMain.contMaterial.top		= -1000
		contMain.contMix.top			= -1000
		contMain.contAlter.top			= -1000
		

	end if
End Function

'===============================================
' 주식 초기설정
'===============================================

' 주식유형 초기화
Function Init_Stock_Step0()
	' 주식
	contMain.contStock.lblSubTitleStock0.paddinginfo = "0,0,0,0"
	contMain.contStock.lblSubTitleStock0.fgcolor = g_szTxtColor_Grey
	
	contMain.contStock.lblSubTitleStock1.paddinginfo = "0,0,0,0"
	contMain.contStock.lblSubTitleStock1.fgcolor = g_szTxtColor_Grey
	contMain.contStock.lblSubTitleStock1.visible = false
	
	contMain.contStock.lblChk.fgcolor = g_szTxtColor_Grey
	contMain.contStock.lblChk.paddinginfo = "0,0,0,0"
	
	contMain.contStock.lblChk.setNeighborCtlPos("imgChk", "left", 2, "전체")
	
	contMain.contStock.imgChk.setMaintainingRatio("3")
	contMain.contStock.imgChk.imgpath = g_szChkImg_Normal
	
	contMain.contStock.lblChk.visible = false
	contMain.contStock.imgChk.visible = false
	contMain.contStock.btnChk.visible = false
	
	g_arrStock_Step0_Check = -1
	
	g_arrStock_Step1 = {}
	g_arrStock_Step1_Check = {}
	
	g_arrStock_Step2 = {}
	g_arrStock_Step2_Check = {}
	g_arrStock_Step2_Sub_Check = {}

	szData = Form.GetSharedData("ETF_Step1_0", false)
	
	szData = szData 
	g_arrStock_Step0 = Convert_StringToArr(szData, "`")
	
	nArrCnt = #g_arrStock_Step0
	nPannelRowCnt = Cint(nArrCnt / 4)
	if (nArrCnt mod 4) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 

	contMain.contStock.Pannel0.rowcount = nPannelRowCnt
	
	' 대표지수 패널 높이값
	g_nStep0_Pannel_Height = (g_nCommon_Row_Height * nPannelRowCnt) + (g_nCommon_Row_Gap * (nPannelRowCnt-1))
	contMain.contStock.Pannel0.height = g_nStep0_Pannel_Height + 5
	
	contMain.contStock.height = contMain.contStock.Pannel0.top + g_nStep0_Pannel_Height + g_nBottom_Margin
	
	'contMain.setScrollAutoSize()

	nArrIdx = 0
	for i = 0 to nPannelRowCnt-1
		contMain.contStock.Pannel0.setPropCardCell("imagefilepth"	, "lblStockStep00", i, g_szBtnImg_Normal)
		contMain.contStock.Pannel0.setPropCardCell("fgcolor"		, "lblStockStep00", i, g_szTxtColor_Normal)
		contMain.contStock.Pannel0.setPropCardCell("caption"		, "lblStockStep00", i, g_arrStock_Step0(nArrIdx))
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contStock.Pannel0.SetCellVisible("lblStockStep01",i,false)
			contMain.contStock.Pannel0.SetCellVisible("lblStockStep02",i,false)
			contMain.contStock.Pannel0.SetCellVisible("lblStockStep03",i,false)
			
			contMain.contStock.Pannel0.setPropCardCell("enable"	, "lblStockStep01", i, false)
			contMain.contStock.Pannel0.setPropCardCell("enable"	, "lblStockStep02", i, false)
			contMain.contStock.Pannel0.setPropCardCell("enable"	, "lblStockStep03", i, false)
			Exit for
		end if
		
		contMain.contStock.Pannel0.setPropCardCell("imagefilepth"	, "lblStockStep01", i, g_szBtnImg_Normal)
		contMain.contStock.Pannel0.setPropCardCell("fgcolor"		, "lblStockStep01", i, g_szTxtColor_Normal)
		contMain.contStock.Pannel0.setPropCardCell("caption"		, "lblStockStep01", i, g_arrStock_Step0(nArrIdx))
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contStock.Pannel0.SetCellVisible("lblStockStep02",i,false)
			contMain.contStock.Pannel0.SetCellVisible("lblStockStep03",i,false)
			
			contMain.contStock.Pannel0.setPropCardCell("enable"	, "lblStockStep02", i, false)
			contMain.contStock.Pannel0.setPropCardCell("enable"	, "lblStockStep03", i, false)
			Exit for
		end if
		
		contMain.contStock.Pannel0.setPropCardCell("imagefilepth"	, "lblStockStep02", i, g_szBtnImg_Normal)
		contMain.contStock.Pannel0.setPropCardCell("fgcolor"		, "lblStockStep02", i, g_szTxtColor_Normal)
		contMain.contStock.Pannel0.setPropCardCell("caption"		, "lblStockStep02", i, g_arrStock_Step0(nArrIdx))
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contStock.Pannel0.SetCellVisible("lblStockStep03",i,false)
			
			contMain.contStock.Pannel0.setPropCardCell("enable"	, "lblStockStep03", i, false)
			Exit for
		end if
		
		contMain.contStock.Pannel0.setPropCardCell("imagefilepth"	, "lblStockStep03", i, g_szBtnImg_Normal)
		contMain.contStock.Pannel0.setPropCardCell("fgcolor"		, "lblStockStep03", i, g_szTxtColor_Normal)
		contMain.contStock.Pannel0.setPropCardCell("caption"		, "lblStockStep03", i, g_arrStock_Step0(nArrIdx))
		
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
	'(초기화) 국가유형 숨김
	contMain.contStock.lblStockStep1.visible = false
	
	'(초기화) 지수유형 숨김
	contMain.contStock.lblStockStep2.visible = false
	
	'(초기화) 사이즈(스타일 일부 유형만 표시)
	contMain.contStock.lblSubTitleStock1.visible = false
	contMain.contStock.Pannel1.visible = false
	contMain.contStock.lblChk.visible = false
	contMain.contStock.imgChk.visible = false
	contMain.contStock.btnChk.visible = false
End Function

' 주식유형 입력
Function DisplaySetting_Stock_Step0(nIdx)
	nIndex = 0
	
	nIndex= nIdx / 4 
	nCtlIdx = nIdx % 4
	szCtlNm = ""
	
	if nCtlIdx = 0 then
		szCtlNm = "lblStockStep00"
	elseif nCtlIdx = 1 then
		szCtlNm = "lblStockStep01"
	elseif nCtlIdx = 2 then
		szCtlNm = "lblStockStep02"
	elseif nCtlIdx = 3 then
		szCtlNm = "lblStockStep03"
	end if
	
	nArrIdx = 0
	for i = 0 to contMain.contStock.Pannel0.rowcount-1
		contMain.contStock.Pannel0.setPropCardCell("imagefilepth"	, "lblStockStep00", i, g_szBtnImg_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		contMain.contStock.Pannel0.setPropCardCell("imagefilepth"	, "lblStockStep01", i, g_szBtnImg_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		contMain.contStock.Pannel0.setPropCardCell("imagefilepth"	, "lblStockStep02", i, g_szBtnImg_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		contMain.contStock.Pannel0.setPropCardCell("imagefilepth"	, "lblStockStep03", i, g_szBtnImg_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
	contMain.contStock.Pannel0.setPropCardCell("imagefilepth"	, szCtlNm, nIndex, g_szBtnImg_Select)
End Function

' 첫번째 콤보박스 초기화
Function Init_Stock_Step1(nIdx)
	
	nArrCnt = #g_arrStock_Step0
	
	szIdx = ""
	if nIdx < nArrCnt then
		szIdx = trim(g_arrStock_Step0(nIdx))
	end if 
	
	g_arrStock_Step0_Check = nIdx
	
	g_arrStock_Step1 = {}
	g_arrStock_Step1_Check = {}
	
	g_arrStock_Step2 = {}
	g_arrStock_Step2_Check = {}
	g_arrStock_Step2_Sub_Check = {}
	
	contMain.contStock.lblStockStep1.imagefilepth = g_szBtnImg_Normal
	contMain.contStock.lblStockStep2.imagefilepth = g_szBtnImg_Normal
	
	szData = Form.GetSharedData("ETF_Step2_0_" & nIdx, false)
	g_arrStock_Step1 = Convert_StringToArr(szData, "`")
	
	g_nStep1_Top = contMain.contStock.Pannel0.top + g_nStep0_Pannel_Height + g_nCommon_Margin2
	g_nStep2_Top = g_nStep1_Top + g_nCommon_Row_Height2 + g_nCommon_Margin2
	
	if szIdx = "대표지수" then
		
		contMain.contStock.lblStockStep1.top = g_nStep1_Top
		contMain.contStock.lblStockStep1.caption = "국가 전체"
		contMain.contStock.lblStockStep1.visible = true		
		
		contMain.contStock.lblStockStep2.top = g_nStep2_Top
		contMain.contStock.lblStockStep2.caption = "지수 전체"
		contMain.contStock.lblStockStep2.visible = true
		
		contMain.contStock.height = g_nStep2_Top + g_nCommon_Row_Height2 + g_nBottom_Margin
		
		g_szSharedData_S1 = Form.GetSharedData("50110_S1_CHECK", false )
		DisplaySetting_Stock_Step1(g_szSharedData_S1)
		
		Init_Stock_Step2(0)
		
		contMain.contStock.lblSubTitleStock1.visible = false
		contMain.contStock.Pannel1.visible = false
		contMain.contStock.lblChk.visible = false
		contMain.contStock.imgChk.visible = false
		contMain.contStock.btnChk.visible = false
	elseif szIdx = "섹터" then
		contMain.contStock.lblStockStep1.top = g_nStep1_Top
		contMain.contStock.lblStockStep1.caption = "전체"
		contMain.contStock.lblStockStep1.visible = true
		
		contMain.contStock.height = g_nStep1_Top + g_nCommon_Row_Height2 + g_nBottom_Margin
		
		contMain.contStock.lblStockStep2.visible = false
		
		contMain.contStock.lblSubTitleStock1.visible = false
		contMain.contStock.Pannel1.visible = false
		
		contMain.contStock.lblChk.visible = false
		contMain.contStock.imgChk.visible = false
		contMain.contStock.btnChk.visible = false
	elseif szIdx = "스타일" then
		contMain.contStock.lblStockStep1.top = g_nStep1_Top
		contMain.contStock.lblStockStep1.caption = "전체"
		contMain.contStock.lblStockStep1.visible = true
		
		contMain.contStock.height = g_nStep1_Top + g_nCommon_Row_Height2 + g_nBottom_Margin
		
		contMain.contStock.lblStockStep2.visible = false
		
		contMain.contStock.lblSubTitleStock1.visible = false
		contMain.contStock.Pannel1.visible = false
		contMain.contStock.lblChk.visible = false
		contMain.contStock.imgChk.visible = false
		contMain.contStock.btnChk.visible = false
		Init_Stock_Step2(2)
	elseif szIdx = "테마" then
		contMain.contStock.lblStockStep1.top = g_nStep1_Top
		contMain.contStock.lblStockStep1.caption = "전체"
		contMain.contStock.lblStockStep1.visible = true
		
		contMain.contStock.height = g_nStep1_Top + g_nCommon_Row_Height2 + g_nBottom_Margin
		
		contMain.contStock.lblStockStep2.visible = false
		
		contMain.contStock.lblSubTitleStock1.visible = false
		contMain.contStock.Pannel1.visible = false
		contMain.contStock.lblChk.visible = false
		contMain.contStock.imgChk.visible = false
		contMain.contStock.btnChk.visible = false
	else
		'정의되지 않은 값 처리 
		contMain.contStock.lblStockStep1.visible = false
		
		contMain.contStock.lblStockStep2.visible = false
		
		contMain.contStock.lblSubTitleStock1.visible = false
		contMain.contStock.Pannel1.visible = false
		contMain.contStock.lblChk.visible = false
		contMain.contStock.imgChk.visible = false
		contMain.contStock.btnChk.visible = false
	end if
End Function

' 첫번째 콤보박스 입력
Function DisplaySetting_Stock_Step1(szData)
	szStep0 = g_arrStock_Step0(g_arrStock_Step0_Check)
	
	if szData = "" or szData = null then
		g_arrStock_Step1_Check = {}
		if szStep0 = "대표지수" then
			contMain.contStock.lblStockStep1.caption = "국가 전체"
		else
			contMain.contStock.lblStockStep1.caption = "전체"
		end if
		
		exit Function
	end if
	
	if szData = "전체" then
		if szStep0 = "대표지수" then
			contMain.contStock.lblStockStep1.caption = "국가 전체"
		else
			contMain.contStock.lblStockStep1.caption = "전체"
		end if
		
		g_arrStock_Step1_Check = {}
	else
		g_arrStock_Step1_Check = Convert_StringToArr(szData, "`")
		
		if #g_arrStock_Step1_Check > 1 then
			contMain.contStock.lblStockStep1.caption = g_arrStock_Step1_Check(0) & " 외 " & #g_arrStock_Step1_Check-1 & "개"
		elseif #g_arrStock_Step1_Check = 1 then
			contMain.contStock.lblStockStep1.caption = g_arrStock_Step1_Check(0)
		else 
			if szStep0 = "대표지수" then
				contMain.contStock.lblStockStep1.caption = "국가 전체"
			else
				contMain.contStock.lblStockStep1.caption = "전체"
			end if
		end if
	end if
End Function

' 두번째 콤보박스 or 판넬 초기화
Function Init_Stock_Step2(nIdx)
	nArrCnt = #g_arrStock_Step0
	
	szIdx = ""
	if nIdx < nArrCnt then
		szIdx = trim(g_arrStock_Step0(nIdx))
	end if 
	
	g_arrStock_Step2 = {}
	g_arrStock_Step2_Check = {}
	g_arrStock_Step2_Sub_Check = {}
	
	if szIdx = "대표지수" then
		szResult = ""
		
		if #g_arrStock_Step1_Check = 0 then
			for j = 0 to #g_arrStock_Step1-1
				if szResult <> "" then
					szResult = szResult & "`" 
				end if
			
				szData = Form.GetSharedData("ETF_Step3_0_0_"&j, false)
				szResult = szResult & szData
			next
		else
			for i = 0 to #g_arrStock_Step1_Check-1
				for j = 0 to #g_arrStock_Step1-1
					if g_arrStock_Step1(j) = g_arrStock_Step1_Check(i) then
					
						if szResult <> ""  then
							szResult = szResult & "`" 
						end if
					
						szData = Form.GetSharedData("ETF_Step3_0_0_"&j, false)
						szResult = szResult & szData
					end if
				next
			next
		end if
		
'		if #g_arrStock_Step1_Check > 0 then
'			contMain.contStock.lblStockStep2.caption = "선택국가 지수 전체"
'		else
			contMain.contStock.lblStockStep2.caption = "지수 전체"
'		end if
		
		g_arrStock_Step2 = Convert_StringToArr(szResult, "`")
	elseif szIdx = "섹터" then
		'none
	elseif szIdx = "스타일" then
		if g_szChk_Stock = "1" then
			g_szChk_Stock = "0"
			contMain.contStock.imgChk.imgpath = g_szChkImg_Normal
		end if
		
		szResult = ""
		if #g_arrStock_Step1_Check = 0 then
			for j = 0 to #g_arrStock_Step1-1
				' 사이즈 포함여부 확인
				szData = Form.GetSharedData("ETF_Step3_0_2_"&j, false)
				
				if szData <> "" and szData <> null then
					szResult = szResult & szData
					exit for
				end if
			next
		else
			
			for i = 0 to #g_arrStock_Step1_Check-1
				' 사이즈 포함여부 확인
				nIdx = Return_ArrayIndex(g_arrStock_Step1, g_arrStock_Step1_Check(i))
				szData = Form.GetSharedData("ETF_Step3_0_2_"&nIdx, false)
				
				if szData <> "" and szData <> null then
					szResult = szResult & szData
					exit for
				end if
			next
		end if
		
		contMain.contStock.Pannel1.rowcount = 0
		if szResult <> "" and szResult <> null then
			
			contMain.contStock.lblSubTitleStock1.visible = true
			contMain.contStock.Pannel1.visible = true
			contMain.contStock.lblChk.visible = true
			contMain.contStock.imgChk.visible = true
			contMain.contStock.btnChk.visible = true
		
			g_arrStock_Step2 = Convert_StringToArr(szResult, "`")
			g_arrStock_Step2_Check = {}
			g_arrStock_Step2_Sub_Check = {}
			nArrCnt = #g_arrStock_Step2
			nPannelRowCnt = Cint(nArrCnt / 3)
			if (nArrCnt mod 3) > 0 then
				nPannelRowCnt = nPannelRowCnt + 1
			end if 
			
			contMain.contStock.Pannel1.rowcount = nPannelRowCnt
			
			g_nStep3_Pannel_Height = (g_nCommon_Row_Height * nPannelRowCnt) + (g_nCommon_Row_Gap * (nPannelRowCnt-1))
			contMain.contStock.Pannel1.height = g_nStep3_Pannel_Height + 5
			
			nArrIdx = 0
			for i = 0 to nPannelRowCnt-1
				contMain.contStock.Pannel1.setPropCardCell("imagefilepth"	, "lblStockStep20", i, g_szBtnImg_Normal)
				contMain.contStock.Pannel1.setPropCardCell("fgcolor"		, "lblStockStep20", i, g_szTxtColor_Normal)
				contMain.contStock.Pannel1.setPropCardCell("caption"		, "lblStockStep20", i, g_arrStock_Step2(nArrIdx))
				
				g_arrStock_Step2_Sub_Check(nArrIdx) = "0"
				nArrIdx = nArrIdx + 1
				if nArrIdx > nArrCnt - 1 then
					contMain.contStock.Pannel1.SetCellVisible("lblStockStep21",i,false)
					contMain.contStock.Pannel1.SetCellVisible("lblStockStep22",i,false)
					
					contMain.contStock.Pannel1.setPropCardCell("enable"	, "lblStockStep21", i, false)
					contMain.contStock.Pannel1.setPropCardCell("enable"	, "lblStockStep22", i, false)
					Exit for
				end if
				
				contMain.contStock.Pannel1.setPropCardCell("imagefilepth"	, "lblStockStep21", i, g_szBtnImg_Normal)
				contMain.contStock.Pannel1.setPropCardCell("fgcolor"		, "lblStockStep21", i, g_szTxtColor_Normal)
				contMain.contStock.Pannel1.setPropCardCell("caption"		, "lblStockStep21", i, g_arrStock_Step2(nArrIdx))
				
				g_arrStock_Step2_Sub_Check(nArrIdx) = "0"
				nArrIdx = nArrIdx + 1
				if nArrIdx > nArrCnt - 1 then
					contMain.contStock.Pannel1.SetCellVisible("lblStockStep22",i,false)
					contMain.contStock.Pannel1.setPropCardCell("enable"	, "lblStockStep22", i, false)
					Exit for
				end if
				
				contMain.contStock.Pannel1.setPropCardCell("imagefilepth"	, "lblStockStep22", i, g_szBtnImg_Normal)
				contMain.contStock.Pannel1.setPropCardCell("fgcolor"		, "lblStockStep22", i, g_szTxtColor_Normal)
				contMain.contStock.Pannel1.setPropCardCell("caption"		, "lblStockStep22", i, g_arrStock_Step2(nArrIdx))
				
				g_arrStock_Step2_Sub_Check(nArrIdx) = "0"
				nArrIdx = nArrIdx + 1
				if nArrIdx > nArrCnt - 1 then
					Exit for
				end if
			next
			
			g_nStep3_Top = g_nStep1_Top + g_nCommon_Row_Height2 + g_nCommon_Margin3
			contMain.contStock.lblSubTitleStock1.top = g_nStep3_Top
			
			contMain.contStock.lblChk.top = g_nStep3_Top
			contMain.contStock.imgChk.top = g_nStep3_Top + 1
			contMain.contStock.btnChk.top = g_nStep3_Top
			
			contMain.contStock.Pannel1.top = g_nStep3_Top + g_nCommon_Margin4
			
			contMain.contStock.height = contMain.contStock.Pannel1.top + g_nStep3_Pannel_Height + g_nBottom_Margin
		else
			contMain.contStock.lblSubTitleStock1.visible = false
			contMain.contStock.Pannel1.visible = false
			contMain.contStock.lblChk.visible = false
			contMain.contStock.imgChk.visible = false
			contMain.contStock.btnChk.visible = false
			
			contMain.contStock.height = g_nStep1_Top + g_nCommon_Row_Height2 + g_nBottom_Margin
			
			g_arrStock_Step2 = {}
			g_arrStock_Step2_Check = {}
			g_arrStock_Step2_Sub_Check = {}
		end if
		
		
		

	
	elseif szIdx = "테마" then
		'none
	end if
	
	
End Function

Function DisplaySetting_Stock_Step2(nIdx, nSubIdx, szData)
	nArrCnt = #g_arrStock_Step0
	
	szIdx = ""
	if nIdx < nArrCnt then
		szIdx = g_arrStock_Step0(nIdx)
	end if 
	
	if szIdx = "대표지수" then
		
		if szData = "" or szData = null then
			contMain.contStock.lblStockStep2.caption = "지수 전체"
			g_arrStock_Step2_Check = {}
			exit Function
		end if
		
		if szData = "전체" then
			contMain.contStock.lblStockStep2.caption = "지수 전체"
			g_arrStock_Step2_Check = {}
		else
			g_arrStock_Step2_Check = Convert_StringToArr(szData, "`")
			
			if #g_arrStock_Step2_Check > 1 then
				contMain.contStock.lblStockStep2.caption = g_arrStock_Step2_Check(0) & " 외 " & #g_arrStock_Step2_Check-1 & "개"
			elseif #g_arrStock_Step2_Check = 1 then
				contMain.contStock.lblStockStep2.caption = g_arrStock_Step2_Check(0)
			else
				contMain.contStock.lblStockStep2.caption = "지수 전체"
			end if
		end if

	elseif szIdx = "섹터" then
		'none
	elseif szIdx = "스타일" then
		if g_szChk_Stock = "1" then
			g_szChk_Stock = "0"
			contMain.contStock.imgChk.imgpath = g_szChkImg_Normal
		end if
		
		nIndex= nSubIdx / 3 
		nCtlIdx = nSubIdx % 3
		szCtlNm = ""
		
		if nCtlIdx = 0 then
			szCtlNm = "lblStockStep20"
		elseif nCtlIdx = 1 then
			szCtlNm = "lblStockStep21"
		elseif nCtlIdx = 2 then
			szCtlNm = "lblStockStep22"
		end if
		

		if g_arrStock_Step2_Sub_Check(nSubIdx) = "0" then
			g_arrStock_Step2_Sub_Check(nSubIdx) = "1"
			contMain.contStock.Pannel1.setPropCardCell("imagefilepth", szCtlNm, nIndex, g_szBtnImg_Select)
		else
			g_arrStock_Step2_Sub_Check(nSubIdx) = "0"
			contMain.contStock.Pannel1.setPropCardCell("imagefilepth", szCtlNm, nIndex, g_szBtnImg_Normal)
		end if
		
		g_arrStock_Step2_Check = {}
		nIndex = -1
		for i = 0 to #g_arrStock_Step2-1
			if g_arrStock_Step2_Sub_Check(i) = "1" then
				nIndex = nIndex + 1
				g_arrStock_Step2_Check(nIndex) = g_arrStock_Step2(i)
			end if
		next 
		
		szReturn = Return_AllChkYN(g_arrStock_Step2_Sub_Check)
						
		if szReturn = "Y" then
			g_szChk_Stock = "1"
			contMain.contStock.imgChk.imgpath = g_szChkImg_Select
		else
			g_szChk_Stock = "0"
			contMain.contStock.imgChk.imgpath = g_szChkImg_Normal
		end if
	
	elseif szIdx = "테마" then
		'none
	end if
End Function

Function All_Stock()
	nArrCnt = #g_arrStock_Step2
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 

	nArrIdx = 0
	for i = 0 to nPannelRowCnt-1
		contMain.contStock.Pannel1.setPropCardCell("imagefilepth"	, "lblStockStep20", i, g_szBtnImg_Select)
		g_arrStock_Step2_Sub_Check(nArrIdx) = "1"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		contMain.contStock.Pannel1.setPropCardCell("imagefilepth"	, "lblStockStep21", i, g_szBtnImg_Select)
		g_arrStock_Step2_Sub_Check(nArrIdx) = "1"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		contMain.contStock.Pannel1.setPropCardCell("imagefilepth"	, "lblStockStep22", i, g_szBtnImg_Select)
		g_arrStock_Step2_Sub_Check(nArrIdx) = "1"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
	g_arrStock_Step2_Check = {}
	nIndex = -1
	for i = 0 to #g_arrStock_Step2-1
		if g_arrStock_Step2_Sub_Check(i) = "1" then
			nIndex = nIndex + 1
			g_arrStock_Step2_Check(nIndex) = g_arrStock_Step2(i)
		end if
	next 
End Function

Function Clear_Stock()
	nArrCnt = #g_arrStock_Step2
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 

	nArrIdx = 0
	for i = 0 to nPannelRowCnt-1
		contMain.contStock.Pannel1.setPropCardCell("imagefilepth"	, "lblStockStep20", i, g_szBtnImg_Normal)
		g_arrStock_Step2_Sub_Check(nArrIdx) = "0"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		contMain.contStock.Pannel1.setPropCardCell("imagefilepth"	, "lblStockStep21", i, g_szBtnImg_Normal)
		g_arrStock_Step2_Sub_Check(nArrIdx) = "0"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		contMain.contStock.Pannel1.setPropCardCell("imagefilepth"	, "lblStockStep22", i, g_szBtnImg_Normal)
		g_arrStock_Step2_Sub_Check(nArrIdx) = "0"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
	g_arrStock_Step2_Check = {}
End Function

