'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName = "50110_P3_RETURN_DATA_Stock_Step1" then
		DisplaySetting_Stock_Step1(sRet)
		Init_Stock_Step2(g_arrStock_Step0_Check)

		Send_ChkDataToParent()
		
	elseif sKeyName = "50110_P3_RETURN_DATA_Stock_Step2" then
		DisplaySetting_Stock_Step2(g_arrStock_Step0_Check, 0, sRet)

		Send_ChkDataToParent()
	end if 
End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "50110_S2_CHECK" then
		g_szSharedData = Form.GetSharedData(g_szSharedKey, false )
		g_szSharedData_S1 = Form.GetSharedData("50110_S1_CHECK", false )
		Load_ChkData(g_szSharedData)
	elseif sEventName = "50110_COND_STAT" then
		if sParam = "N" then
			contMain.height = 444
'			contMain.contStock.height = 324
'			contMain.contBond.height = 324
'			contMain.contMaterial.height = 324
'			contMain.contMix.height = 324
'			contMain.contAlter.height = 324
		elseif sParam = "Y" then
			contMain.height = 334
'			contMain.contStock.height = 214
'			contMain.contBond.height = 214
'			contMain.contMaterial.height = 214
'			contMain.contMix.height = 214
'			contMain.contAlter.height = 214
		end if
		
		contMain.setScrollAutoSize()
		contMain.contStock.setScrollAutoSize()
		contMain.contBond.setScrollAutoSize()
		contMain.contMaterial.setScrollAutoSize()
		contMain.contMix.setScrollAutoSize()
		contMain.contAlter.setScrollAutoSize()
		
		contMain.scroll_pos = "end"
	end if
End Sub


