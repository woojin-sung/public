Function Init_Bond()
	contMain.contBond.lblSubTitleBond0.paddinginfo = "0,0,0,0"
	contMain.contBond.lblSubTitleBond0.fgcolor = g_szTxtColor_Grey
	
	contMain.contBond.lblSubTitleBond1.paddinginfo = "0,0,0,0"
	contMain.contBond.lblSubTitleBond1.fgcolor = g_szTxtColor_Grey
	
	contMain.contBond.lblSubTitleBond2.paddinginfo = "0,0,0,0"
	contMain.contBond.lblSubTitleBond2.fgcolor = g_szTxtColor_Grey
	contMain.contBond.lblSubTitleBond2.visible = false
	
	contMain.contBond.lblChk.fgcolor = g_szTxtColor_Grey
	contMain.contBond.lblChk.paddinginfo = "0,0,0,0"
	
	contMain.contBond.lblChk.setNeighborCtlPos("imgChk", "left", 2, "전체")
	
	contMain.contBond.imgChk.setMaintainingRatio("3")
	contMain.contBond.imgChk.imgpath = g_szChkImg_Normal
	
	contMain.contBond.lblChk0.fgcolor = g_szTxtColor_Grey
	contMain.contBond.lblChk0.paddinginfo = "0,0,0,0"
	
	contMain.contBond.lblChk0.setNeighborCtlPos("imgChk0", "left", 2, "전체")
	
	contMain.contBond.imgChk0.setMaintainingRatio("3")
	contMain.contBond.imgChk0.imgpath = g_szChkImg_Normal
	
	contMain.contBond.lblChk1.fgcolor = g_szTxtColor_Grey
	contMain.contBond.lblChk1.paddinginfo = "0,0,0,0"
	
	contMain.contBond.lblChk1.setNeighborCtlPos("imgChk1", "left", 2, "전체")
	
	contMain.contBond.imgChk1.setMaintainingRatio("3")
	contMain.contBond.imgChk1.imgpath = g_szChkImg_Normal
	
	contMain.contBond.lblChk1.visible = false
	contMain.contBond.imgChk1.visible = false
	
	contMain.contBond.imgTooltip.setMaintainingRatio("3")
	contMain.contBond.imgTooltip.imgpath = g_szToolTipImg
	
	contMain.contBond.lblSubTitleBond1.setNeighborCtlPos("imgTooltip", "right", -5, "만기")
	
	contMain.contBond.Pannel7.visible = false
	
	g_arrBond_Step0 = {}
	g_arrBond_Step0_Check = {}
	
	g_arrBond_Step1 = {}
	g_arrBond_Step1_Check = {}

	g_arrBond_Step2_Check = {}
	
	szData = Form.GetSharedData("ETF_Step1_1", false)
	g_arrBond_Step0 = Convert_StringToArr(szData, "`")
	
	nArrCnt = #g_arrBond_Step0
	
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 

	contMain.contBond.Pannel2.rowcount = nPannelRowCnt
	g_nStep0_Pannel_Height = (g_nCommon_Row_Height * nPannelRowCnt) + (g_nCommon_Row_Gap * (nPannelRowCnt-1))
	
	contMain.contBond.Pannel2.height = g_nStep0_Pannel_Height + 5
	
	nArrIdx = 0
	
	for i = 0 to nPannelRowCnt - 1
		g_arrBond_Step0_Check(nArrIdx) = "0"
		contMain.contBond.Pannel2.SetCellValue( "lblBond0", i, g_arrBond_Step0(nArrIdx))	
		
		contMain.contBond.Pannel2.setPropCardCell("imagefilepth", "lblBond0", i, g_szBtnImg_Normal)
		contMain.contBond.Pannel2.setPropCardCell("fgcolor", "lblBond0", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contBond.Pannel2.SetCellVisible("lblBond1",i,false)
			contMain.contBond.Pannel2.SetCellVisible("lblBond2",i,false)
			
			contMain.contBond.Pannel2.setPropCardCell("enable"	, "lblBond1", i, false)
			contMain.contBond.Pannel2.setPropCardCell("enable"	, "lblBond2", i, false)
			Exit for
		end if
		
		g_arrBond_Step0_Check(nArrIdx) = "0"
		contMain.contBond.Pannel2.SetCellValue( "lblBond1", i, g_arrBond_Step0(nArrIdx))
		
		contMain.contBond.Pannel2.setPropCardCell("imagefilepth", "lblBond1", i, g_szBtnImg_Normal)
		contMain.contBond.Pannel2.setPropCardCell("fgcolor", "lblBond1", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contBond.Pannel2.SetCellVisible("lblBond2",i,false)
			contMain.contBond.Pannel2.setPropCardCell("enable"	, "lblBond2", i, false)
			Exit for
		end if
		
		g_arrBond_Step0_Check(nArrIdx) = "0"
		contMain.contBond.Pannel2.SetCellValue( "lblBond2", i, g_arrBond_Step0(nArrIdx))	
		
		contMain.contBond.Pannel2.setPropCardCell("imagefilepth", "lblBond2", i, g_szBtnImg_Normal)
		contMain.contBond.Pannel2.setPropCardCell("fgcolor", "lblBond2", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
	for i = 0 to #g_arrBond_Step0-1 
		szData = Form.GetSharedData("ETF_Step2_1_"&i, false)
		
		if szData <> "" then
			g_arrBond_Step1 = Convert_StringToArr(szData, "`")
			exit for
		end if 
	next 
	
	g_nStep1_Top = contMain.contBond.Pannel2.top + g_nStep0_Pannel_Height + g_nCommon_Margin3
	
	contMain.contBond.lblSubTitleBond1.top = g_nStep1_Top
	
	contMain.contBond.lblChk0.top = g_nStep1_Top
	contMain.contBond.imgChk0.top = g_nStep1_Top + 1
	contMain.contBond.btnChk0.top = g_nStep1_Top
	contMain.contBond.imgTooltip.top = g_nStep1_Top + 1
	
	contMain.contBond.Pannel3.top = g_nStep1_Top + g_nCommon_Margin4
	
	
	
	nArrCnt = #g_arrBond_Step1
	nPannelRowCnt = Cint(nArrCnt / 4)
	if (nArrCnt mod 4) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 
	
	nArrIdx = 0
	contMain.contBond.Pannel3.rowcount = nPannelRowCnt
	
	g_nStep1_Pannel_Height = (g_nCommon_Row_Height * nPannelRowCnt) + (g_nCommon_Row_Gap * (nPannelRowCnt-1))
	contMain.contBond.Pannel3.height = g_nStep1_Pannel_Height + 5
	
	contMain.contBond.height = contMain.contBond.Pannel3.top + g_nStep1_Pannel_Height + g_nBottom_Margin
	
	for i = 0 to nPannelRowCnt-1
		g_arrBond_Step1_Check(nArrIdx) = "0"
		contMain.contBond.Pannel3.SetCellValue( "lblBondStep00", i, g_arrBond_Step1(nArrIdx))
		
		contMain.contBond.Pannel3.setPropCardCell("imagefilepth", "lblBondStep00", i, g_szBtnImg_Normal)	
		contMain.contBond.Pannel3.setPropCardCell("fgcolor", "lblBondStep00", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contBond.Pannel3.SetCellVisible("lblBondStep01",i,false)
			contMain.contBond.Pannel3.SetCellVisible("lblBondStep02",i,false)
			contMain.contBond.Pannel3.SetCellVisible("lblBondStep03",i,false)
			
			contMain.contBond.Pannel3.setPropCardCell("enable"	, "lblBondStep01", i, false)
			contMain.contBond.Pannel3.setPropCardCell("enable"	, "lblBondStep02", i, false)
			contMain.contBond.Pannel3.setPropCardCell("enable"	, "lblBondStep03", i, false)
			Exit for
		end if
		
		g_arrBond_Step1_Check(nArrIdx) = "0"
		contMain.contBond.Pannel3.SetCellValue( "lblBondStep01", i, g_arrBond_Step1(nArrIdx))
		
		contMain.contBond.Pannel3.setPropCardCell("imagefilepth", "lblBondStep01", i, g_szBtnImg_Normal)	
		contMain.contBond.Pannel3.setPropCardCell("fgcolor", "lblBondStep01", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contBond.Pannel3.SetCellVisible("lblBondStep02",i,false)
			contMain.contBond.Pannel3.SetCellVisible("lblBondStep03",i,false)
			
			contMain.contBond.Pannel3.setPropCardCell("enable"	, "lblBondStep02", i, false)
			contMain.contBond.Pannel3.setPropCardCell("enable"	, "lblBondStep03", i, false)
			Exit for
		end if
		
		g_arrBond_Step1_Check(nArrIdx) = "0"
		contMain.contBond.Pannel3.SetCellValue( "lblBondStep02", i, g_arrBond_Step1(nArrIdx))
		
		contMain.contBond.Pannel3.setPropCardCell("imagefilepth", "lblBondStep02", i, g_szBtnImg_Normal)	
		contMain.contBond.Pannel3.setPropCardCell("fgcolor", "lblBondStep02", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contBond.Pannel3.SetCellVisible("lblBondStep03",i,false)

			contMain.contBond.Pannel3.setPropCardCell("enable"	, "lblBondStep03", i, false)
			Exit for
		end if
		
		g_arrBond_Step1_Check(nArrIdx) = "0"
		contMain.contBond.Pannel3.SetCellValue( "lblBondStep03", i, g_arrBond_Step1(nArrIdx))
		
		contMain.contBond.Pannel3.setPropCardCell("imagefilepth", "lblBondStep03", i, g_szBtnImg_Normal)	
		contMain.contBond.Pannel3.setPropCardCell("fgcolor", "lblBondStep03", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
	nArrCnt = #g_arrBond_Step2
	
	nPannelRowCnt = Cint(nArrCnt / 2)
	if (nArrCnt mod 2) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 
	
	contMain.contBond.Pannel7.rowcount = nPannelRowCnt
	
	g_nStep2_Pannel_Height = (g_nCommon_Row_Height * nPannelRowCnt) + (g_nCommon_Row_Gap * (nPannelRowCnt-1))
	contMain.contBond.Pannel7.height = g_nStep2_Pannel_Height + 5
	
	g_nStep2_Top = contMain.contBond.Pannel3.top + g_nStep1_Pannel_Height + g_nCommon_Margin3
	
	contMain.contBond.lblSubTitleBond2.top = g_nStep2_Top
	contMain.contBond.Pannel7.top = g_nStep2_Top + g_nCommon_Margin4
	contMain.contBond.lblChk1.top 		= g_nStep2_Top
	contMain.contBond.imgChk1.top 		= g_nStep2_Top + 1
	contMain.contBond.btnChk1.top 		= g_nStep2_Top

	nArrIdx = 0
	for i = 0 to nPannelRowCnt-1
		g_arrBond_Step2_Check(nArrIdx) = "0"
		contMain.contBond.Pannel7.SetCellValue( "lblBondStep10", i, g_arrBond_Step2(nArrIdx))
		
		contMain.contBond.Pannel7.setPropCardCell("imagefilepth", "lblBondStep10", i, g_szBtnImg_Normal)	
		contMain.contBond.Pannel7.setPropCardCell("fgcolor", "lblBondStep10", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contBond.Pannel7.SetCellVisible("lblBondStep11",i,false)
			contMain.contBond.Pannel7.setPropCardCell("enable"	, "lblBondStep11", i, false)
			Exit for
		end if
		
		g_arrBond_Step2_Check(nArrIdx) = "0"
		contMain.contBond.Pannel7.SetCellValue( "lblBondStep11", i, g_arrBond_Step2(nArrIdx))
		
		contMain.contBond.Pannel7.setPropCardCell("imagefilepth", "lblBondStep11", i, g_szBtnImg_Normal)	
		contMain.contBond.Pannel7.setPropCardCell("fgcolor", "lblBondStep11", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next

End Function

Function Init_Bond_Step0()
	g_arrBond_Step0 = {}
	g_arrBond_Step0_Check = {}
	
	szData = Form.GetSharedData("ETF_Step1_1", false)
	g_arrBond_Step0 = Convert_StringToArr(szData, "`")
	
