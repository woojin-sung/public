Function All_Bond0()
	nArrCnt = #g_arrBond_Step0
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 

	nArrIdx = 0
	for i = 0 to nPannelRowCnt-1
		contMain.contBond.Pannel2.setPropCardCell("imagefilepth"	, "lblBond0", i, g_szBtnImg_Select)
		g_arrBond_Step0_Check(nArrIdx) = "1"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		contMain.contBond.Pannel2.setPropCardCell("imagefilepth"	, "lblBond1", i, g_szBtnImg_Select)
		g_arrBond_Step0_Check(nArrIdx) = "1"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		contMain.contBond.Pannel2.setPropCardCell("imagefilepth"	, "lblBond2", i, g_szBtnImg_Select)
		g_arrBond_Step0_Check(nArrIdx) = "1"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
	
	contMain.contBond.lblSubTitleBond2.visible = true
	contMain.contBond.Pannel7.visible = true
	contMain.contBond.lblChk1.visible = true
	contMain.contBond.imgChk1.visible = true
	
	contMain.contBond.height =  contMain.contBond.Pannel7.top + g_nStep2_Pannel_Height + g_nBottom_Margin
End Function

Function Clear_Bond0()
	nArrCnt = #g_arrBond_Step0
