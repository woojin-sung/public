	szData = Form.GetSharedData("ETF_Step1_4", false)
	g_arrAlter = Convert_StringToArr(szData, "`")
	
	nArrCnt = #g_arrAlter
	
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 

	contMain.contAlter.Pannel6.rowcount = nPannelRowCnt
	
	g_nStep0_Pannel_Height = (g_nCommon_Row_Height  * nPannelRowCnt) + (g_nCommon_Row_Gap * (nPannelRowCnt-1))	
	contMain.contAlter.Pannel6.height = g_nStep0_Pannel_Height +5
	
	contMain.contAlter.height =  contMain.contAlter.Pannel6.top + g_nStep0_Pannel_Height + g_nBottom_Margin
	
	nArrIdx = 0
	
	for i = 0 to nPannelRowCnt - 1
		g_arrAlter_Check(nArrIdx) = "0"
		contMain.contAlter.Pannel6.SetCellValue( "lblAlter0", i, g_arrAlter(nArrIdx))	
		
		contMain.contAlter.Pannel6.setPropCardCell("imagefilepth", "lblAlter0", i, g_szBtnImg_Normal)
		contMain.contAlter.Pannel6.setPropCardCell("fgcolor", "lblAlter0", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contAlter.Pannel6.SetCellVisible("lblAlter1",i,false)
			contMain.contAlter.Pannel6.SetCellVisible("lblAlter2",i,false)
			
			contMain.contAlter.Pannel6.setPropCardCell("enable"	, "lblAlter1", i, false)
			contMain.contAlter.Pannel6.setPropCardCell("enable"	, "lblAlter2", i, false)
			Exit for
		end if
		
		g_arrAlter_Check(nArrIdx) = "0"
		contMain.contAlter.Pannel6.SetCellValue( "lblAlter1", i, g_arrAlter(nArrIdx))	
		
		contMain.contAlter.Pannel6.setPropCardCell("imagefilepth", "lblAlter1", i, g_szBtnImg_Normal)
		contMain.contAlter.Pannel6.setPropCardCell("fgcolor", "lblAlter1", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contAlter.Pannel6.SetCellVisible("lblAlter2",i,false)
			contMain.contAlter.Pannel6.setPropCardCell("enable"	, "lblAlter2", i, false)
			Exit for
		end if
		
		g_arrAlter_Check(nArrIdx) = "0"
		contMain.contAlter.Pannel6.SetCellValue( "lblAlter2", i, g_arrAlter(nArrIdx))	
		
		contMain.contAlter.Pannel6.setPropCardCell("imagefilepth", "lblAlter2", i, g_szBtnImg_Normal)
		contMain.contAlter.Pannel6.setPropCardCell("fgcolor", "lblAlter2", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
End Function

Function DisplaySetting_Alter(nidx,szCtlNm)
	nIndex = 0
	
	if g_szChk_Alter = "1" then
		g_szChk_Alter = "0"
		contMain.contAlter.imgChk.imgpath = g_szChkImg_Normal
	end if
	
	if szCtlNm = "lblAlter0" then
		nIndex = nidx * 3 + 0
	elseif szCtlNm = "lblAlter1" then
		nIndex = nidx * 3 + 1
	elseif szCtlNm = "lblAlter2" then
		nIndex = nidx * 3 + 2
	end if
	
	if g_arrAlter_Check(nIndex) = "0" then
		g_arrAlter_Check(nIndex) = "1"
		contMain.contAlter.Pannel6.setPropCardCell("imagefilepth", szCtlNm, nidx, g_szBtnImg_Select)
	else 
		g_arrAlter_Check(nIndex) = "0"
		contMain.contAlter.Pannel6.setPropCardCell("imagefilepth", szCtlNm, nidx, g_szBtnImg_Normal)
	end if
	
	szReturn = Return_AllChkYN(g_arrAlter_Check)
						
	if szReturn = "Y" then
		g_szChk_Alter = "1"
		contMain.contAlter.imgChk.imgpath = g_szChkImg_Select
	else
		g_szChk_Alter = "0"
		contMain.contAlter.imgChk.imgpath = g_szChkImg_Normal
	end if

	
End Function

Function Reload_Alter_Step0(nArrIdx)
	nIndex = 0
	
	nIndex= nArrIdx / 3
	nCtlIdx = nArrIdx % 3
	szCtlNm = ""
	
	if nCtlIdx = 0 then
		szCtlNm = "lblAlter0"
	elseif nCtlIdx = 1 then
		szCtlNm = "lblAlter1"
	elseif nCtlIdx = 2 then
		szCtlNm = "lblAlter2"
	end if
	
	
	g_arrAlter_Check(nArrIdx) = "1"
	contMain.contAlter.Pannel6.setPropCardCell("imagefilepth", szCtlNm, nIndex, g_szBtnImg_Select)
End Function

Function All_Alter()
	nArrCnt = #g_arrAlter
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 

	nArrIdx = 0
	for i = 0 to nPannelRowCnt-1
		contMain.contAlter.Pannel6.setPropCardCell("imagefilepth"	, "lblAlter0", i, g_szBtnImg_Select)
		g_arrAlter_Check(nArrIdx) = "1"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		contMain.contAlter.Pannel6.setPropCardCell("imagefilepth"	, "lblAlter1", i, g_szBtnImg_Select)
		g_arrAlter_Check(nArrIdx) = "1"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		contMain.contAlter.Pannel6.setPropCardCell("imagefilepth"	, "lblAlter2", i, g_szBtnImg_Select)
		g_arrAlter_Check(nArrIdx) = "1"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
End Function

Function Clear_Alter()
	nArrCnt = #g_arrAlter
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 

	nArrIdx = 0
	for i = 0 to nPannelRowCnt-1
		contMain.contAlter.Pannel6.setPropCardCell("imagefilepth"	, "lblAlter0", i, g_szBtnImg_Normal)
		g_arrAlter_Check(nArrIdx) = "0"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		contMain.contAlter.Pannel6.setPropCardCell("imagefilepth"	, "lblAlter1", i, g_szBtnImg_Normal)
		g_arrAlter_Check(nArrIdx) = "0"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		contMain.contAlter.Pannel6.setPropCardCell("imagefilepth"	, "lblAlter2", i, g_szBtnImg_Normal)
		g_arrAlter_Check(nArrIdx) = "0"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
End Function


Function Send_ChkDataToParent()
	szResultData = ""
	
	g_szSharedData_Assets = ""
	if g_nAssetsIdx > -1 then
		g_szSharedData_Assets = g_arrAssets(g_nAssetsIdx)
		
		szResultData = g_szSharedData_Assets
		
		if g_nAssetsIdx = 0 then
			if g_arrStock_Step0_Check > -1 then
				g_szSharedData_Step0 = g_arrStock_Step0(g_arrStock_Step0_Check)
				szResultData = szResultData & "★Step0" & g_szSharedData_Step0
				
				g_szSharedData_Step1 = Convert_ArrToString(g_arrStock_Step1_Check, "`")
				
				if g_szSharedData_Step1 <> "" then
					szResultData = szResultData & "★Step1" & g_szSharedData_Step1
					
					
				end if
				
				g_szSharedData_Step2 = Convert_ArrToString(g_arrStock_Step2_Check, "`")
		
				if g_szSharedData_Step2 <> "" then
					szResultData = szResultData & "★Step2" & g_szSharedData_Step2
				end if
			end if
			
		elseif g_nAssetsIdx = 1 then
			szBond = Convert_ChkArrToString(g_arrBond_Step0, g_arrBond_Step0_Check, "`")
			if szBond <> "" then
				if szResultData <> "" then
					szResultData = szResultData & "★Step0"
				end if
				szResultData = szResultData & szBond
			end if
			
			szStep0 = Convert_ChkArrToString(g_arrBond_Step1, g_arrBond_Step1_Check, "`")
			if szStep0 <> "" then
				if szResultData <> "" then
					szResultData = szResultData & "★Step1"
				end if
				szResultData = szResultData & szStep0
			end if
			
			szStep1 = Convert_ChkArrToString(g_arrBond_Step2, g_arrBond_Step2_Check, "`")
			Form.SetSharedData(g_szSharedKey&"1", szStep1)
			if szStep1 <> "" then
				if szResultData <> "" then
					szResultData = szResultData & "★Step2"
				end if
				szResultData = szResultData & szStep1
			end if
		elseif g_nAssetsIdx = 2 then
			szMaterial = Convert_ChkArrToString(g_arrMaterial, g_arrMaterial_Check, "`")
			if szMaterial <> "" then
				if szResultData <> "" then
					szResultData = szResultData & "★Step0"
				end if
				szResultData = szResultData & szMaterial
			end if
			
			szMaterial = Convert_ChkArrToString(g_arrMaterial_Jewelry, g_arrMaterial_Jewelry_Check, "`")
			if szMaterial <> "" then
				if szResultData <> "" then
					szResultData = szResultData & "★Step1"
				end if
				szResultData = szResultData & szMaterial
			end if
			
			szMaterial = Convert_ChkArrToString(g_arrMaterial_Industrial, g_arrMaterial_Industrial_Check, "`")
			if szMaterial <> "" then
				if szResultData <> "" then
					szResultData = szResultData & "★Step2"
				end if
				szResultData = szResultData & szMaterial
			end if
			
		elseif g_nAssetsIdx = 3 then
			szMix = Convert_ChkArrToString(g_arrMix, g_arrMix_Check, "`")
			Form.SetSharedData(g_szSharedKey&"0", szMix)
			if szMix <> "" then
				if szResultData <> "" then
					szResultData = szResultData & "★Step0"
				end if
				szResultData = szResultData & szMix
			end if
		elseif g_nAssetsIdx = 4 then
			szAlter = Convert_ChkArrToString(g_arrAlter, g_arrAlter_Check, "`")
			Form.SetSharedData(g_szSharedKey&"0", szAlter)
			if szAlter <> "" then
				if szResultData <> "" then
					szResultData = szResultData & "★Step0"
				end if
				szResultData = szResultData & szAlter
			end if
		elseif g_nAssetsIdx = 5 then
			'NONE
		end if
	end if
	
	Form.SetSharedData(g_szSharedKey, szResultData)
	Form.triggerEvent("#", g_szSharedKey, "")
End Function


Function Load_ChkData(szData)
	if szData = "" or szData = null then
		g_isLoadChkData = "1"
		contMain.cmbAssets.currentindex = -1
		contMain.cmbAssets.caption = "선택해주세요"
		contMain_cmbAssets_OnEditComplete(-1)
		g_isLoadChkData = "0"
		
		exit Function
	end if
	
	arrLoadData = Convert_StringToArr(szData, "★")
	nArrLoadCnt = #arrLoadData
	
	if nArrLoadCnt > 0 then
		nIdx = Return_ArrayIndex(g_arrAssets, arrLoadData(0))
		
		if nIdx > -1 then
			g_isLoadChkData = "1"
			contMain.cmbAssets.currentindex = nIdx
		end if
	end if
	
	if nArrLoadCnt > 1 then
		szLoadData = left(arrLoadData(1), 5)
		
		if szLoadData = "Step0" then
			szData_Step0 = replace(arrLoadData(1), "Step0", "")
			if g_nAssetsIdx > -1 then
			
				'주식
				if g_nAssetsIdx = 0 then
					nStep0_Idx = Return_ArrayIndex(g_arrStock_Step0, szData_Step0)
					
					if nStep0_Idx > -1 then
						DisplaySetting_Stock_Step0(nStep0_Idx)
						Init_Stock_Step1(nStep0_Idx)
					end if
					
				elseif g_nAssetsIdx = 1 then
					
					arrTempData2 = Convert_StringToArr(szData_Step0, "`")
						
					for i = 0 to #arrTempData2 - 1
						nStep0_Idx = Return_ArrayIndex(g_arrBond_Step0, arrTempData2(i))
						Reload_Bond_Step0(nStep0_Idx)
					next
					
					szReturn = Return_AllChkYN(g_arrBond_Step0_Check)
						
					if szReturn = "Y" then
						g_szChk_Bond0 = "1"
						contMain.contBond.imgChk.imgpath = g_szChkImg_Select
					end if
				
				elseif g_nAssetsIdx = 2 then
					
					arrTempData2 = Convert_StringToArr(szData_Step0, "`")
						
					for i = 0 to #arrTempData2 - 1
						nStep0_Idx = Return_ArrayIndex(g_arrMaterial, arrTempData2(i))
						Reload_Material_Step0(nStep0_Idx)
					next
					
					DisplaySetting_Material_SubView()
					
					szReturn = Return_AllChkYN(g_arrMaterial_Check)
						
					if szReturn = "Y" then
						g_szChk_Material = "1"
						contMain.contMaterial.imgChk.imgpath = g_szChkImg_Select
					end if

				elseif g_nAssetsIdx = 3 then
					arrTempData2 = Convert_StringToArr(szData_Step0, "`")
						
					for i = 0 to #arrTempData2 - 1
						nStep0_Idx = Return_ArrayIndex(g_arrMix, arrTempData2(i))
						Reload_Mix_Step0(nStep0_Idx)
					next
					
					szReturn = Return_AllChkYN(g_arrMix_Check)
						
					if szReturn = "Y" then
						g_szChk_Mix = "1"
						contMain.contMix.imgChk.imgpath = g_szChkImg_Select
					end if
				
				elseif g_nAssetsIdx = 4 then
					arrTempData2 = Convert_StringToArr(szData_Step0, "`")
						
					for i = 0 to #arrTempData2 - 1
						nStep0_Idx = Return_ArrayIndex(g_arrAlter, arrTempData2(i))
						Reload_Alter_Step0(nStep0_Idx)
					next
					
					szReturn = Return_AllChkYN(g_arrAlter_Check)
						
					if szReturn = "Y" then
						g_szChk_Alter = "1"
						contMain.contAlter.imgChk.imgpath = g_szChkImg_Select
					end if
				elseif g_nAssetsIdx = 5 then
				
				else
				
				end if
			end if
		
		elseif szLoadData = "Step1" then
			szData_Step1 = replace(arrLoadData(1), "Step1", "")
			
			if g_nAssetsIdx > -1 then
				if g_nAssetsIdx = 1 then
					arrTempData2 = Convert_StringToArr(szData_Step1, "`")
		
					for i = 0 to #arrTempData2 - 1
					
						nStep1_Idx = Return_ArrayIndex(g_arrBond_Step1, arrTempData2(i))
						
						nIndex = 0
	
						nIndex= nStep1_Idx / 4 
						nCtlIdx = nStep1_Idx % 4
						szCtlNm = ""
						
						if nCtlIdx = 0 then
							szCtlNm = "lblBondStep00"
						elseif nCtlIdx = 1 then
							szCtlNm = "lblBondStep01"
						elseif nCtlIdx = 2 then
							szCtlNm = "lblBondStep02"
						elseif nCtlIdx = 3 then
							szCtlNm = "lblBondStep03"
						end if
						
						DisplaySetting_Bond_Step1(nStep1_Idx, nIndex, szCtlNm)
					next
					
					szReturn = Return_AllChkYN(g_arrBond_Step1_Check)
						
					if szReturn = "Y" then
						g_szChk_Bond1 = "1"
						contMain.contBond.imgChk0.imgpath = g_szChkImg_Select
					end if
					
				end if
			end if	
		end if
	end if
	

	if nArrLoadCnt > 2 then
		szLoadData = left(arrLoadData(2), 5)

		if szLoadData = "Step1" then
			szData_Step1 = replace(arrLoadData(2), "Step1", "")
			
			if g_nAssetsIdx > -1 then
				if g_nAssetsIdx = 0 then
					
'					if g_szSharedData_S1 <> "" then
'						DisplaySetting_Stock_Step1(g_szSharedData_S1)
'					else	
						DisplaySetting_Stock_Step1(szData_Step1)
'					end if
					
					Init_Stock_Step2(g_arrStock_Step0_Check)
				elseif g_nAssetsIdx = 1 then
					arrTempData2 = Convert_StringToArr(szData_Step1, "`")
						
					for i = 0 to #arrTempData2 - 1
						nStep1_Idx = Return_ArrayIndex(g_arrBond_Step1, arrTempData2(i))
						
						nIndex = 0
	
						nIndex= nStep1_Idx / 4 
						nCtlIdx = nStep1_Idx % 4
						szCtlNm = ""
						
						if nCtlIdx = 0 then
							szCtlNm = "lblBondStep00"
						elseif nCtlIdx = 1 then
							szCtlNm = "lblBondStep01"
						elseif nCtlIdx = 2 then
							szCtlNm = "lblBondStep02"
						elseif nCtlIdx = 3 then
							szCtlNm = "lblBondStep03"
						end if
						
						DisplaySetting_Bond_Step1(nStep1_Idx, nIndex, szCtlNm)
					next
					
					
					szReturn = Return_AllChkYN(g_arrBond_Step1_Check)
						
					if szReturn = "Y" then
						g_szChk_Bond1 = "1"
						contMain.contBond.imgChk0.imgpath = g_szChkImg_Select
					end if
				elseif g_nAssetsIdx = 2 then
					arrTempData2 = Convert_StringToArr(szData_Step1, "`")
						
					for i = 0 to #arrTempData2 - 1
						nStep1_Idx = Return_ArrayIndex(g_arrMaterial_Jewelry, arrTempData2(i))
						Reload_Material_Step1(nStep1_Idx)
					next
					
					szReturn = Return_AllChkYN(g_arrMaterial_Jewelry_Check)
						
					if szReturn = "Y" then
						g_szChk_Material_Jewelry = "1"
						contMain.contMaterial.imgChk2.imgpath = g_szChkImg_Select
					end if

				else
					
				end if
			end if
		
		elseif szLoadData = "Step2" then
			szData_Step2 = replace(arrLoadData(2), "Step2", "")
			
			if g_nAssetsIdx > -1 then
				if g_nAssetsIdx = 0 then
					
					if g_arrStock_Step0_Check = 0 then
						DisplaySetting_Stock_Step2(g_arrStock_Step0_Check, 0, szData_Step2)
					elseif g_arrStock_Step0_Check = 2 then
						arrTempData2 = Convert_StringToArr(szData_Step2, "`")
						
						for i = 0 to #arrTempData2 - 1
							DisplaySetting_Stock_Step2(g_arrStock_Step0_Check, i, "")
						next
						
						szReturn = Return_AllChkYN(g_arrStock_Step2_Sub_Check)
						
						if szReturn = "Y" then
							g_szChk_Stock = "1"
							contMain.contStock.imgChk.imgpath = g_szChkImg_Select
						end if
					
					end if
				elseif g_nAssetsIdx = 1 then
					arrTempData2 = Convert_StringToArr(szData_Step2, "`")
					
					for i = 0 to #arrTempData2 - 1
						nStep2_Idx = Return_ArrayIndex(g_arrBond_Step2, arrTempData2(i))
				
						nIndex = 0
	
						nIndex= nStep2_Idx / 2 
						nCtlIdx = nStep2_Idx % 2
						szCtlNm = ""
						
						if nCtlIdx = 0 then
							szCtlNm = "lblBondStep10"
						elseif nCtlIdx = 1 then
							szCtlNm = "lblBondStep11"
						end if
						
						DisplaySetting_Bond_Step2(nStep2_Idx, nIndex, szCtlNm)
					next
					
					szReturn = Return_AllChkYN(g_arrBond_Step2_Check)
						
					if szReturn = "Y" then
						g_szChk_Bond2 = "1"
						contMain.contBond.imgChk1.imgpath = g_szChkImg_Select
					end if
				elseif g_nAssetsIdx = 2 then
					
					arrTempData2 = Convert_StringToArr(szData_Step2, "`")
						
					for i = 0 to #arrTempData2 - 1
						nStep2_Idx = Return_ArrayIndex(g_arrMaterial_Industrial, arrTempData2(i))
						Reload_Material_Step2(nStep2_Idx)
					next	
					
					szReturn = Return_AllChkYN(g_arrMaterial_Industrial_Check)
						
					if szReturn = "Y" then
						g_szChk_Material_Industrial = "1"
						contMain.contMaterial.imgChk3.imgpath = g_szChkImg_Select
					end if
				end if
			end if
		end if
	end if
	
	
	if nArrLoadCnt > 3 then
		szLoadData = left(arrLoadData(3), 5)
		
		if szLoadData = "Step2" then
			szData_Step2 = replace(arrLoadData(3), "Step2", "")
			if g_nAssetsIdx > -1 then
				if g_nAssetsIdx = 0 then
					
					if g_arrStock_Step0_Check = 0 then
						DisplaySetting_Stock_Step2(g_arrStock_Step0_Check, 0, szData_Step2)
					elseif g_arrStock_Step0_Check = 2 then
						arrTempData2 = Convert_StringToArr(szData_Step2, "`")
						
						for i = 0 to #arrTempData2 - 1
							DisplaySetting_Stock_Step2(g_arrStock_Step0_Check, i, "")
						next
						
						
						szReturn = Return_AllChkYN(g_arrStock_Step2_Sub_Check)
						
						if szReturn = "Y" then
							g_szChk_Stock = "1"
							contMain.contStock.imgChk.imgpath = g_szChkImg_Select
						end if
					
					end if
				elseif g_nAssetsIdx = 1 then
					arrTempData2 = Convert_StringToArr(szData_Step2, "`")
						
					for i = 0 to #arrTempData2 - 1
						nStep2_Idx = Return_ArrayIndex(g_arrBond_Step2, arrTempData2(i))
						
						nIndex = 0
	
						nIndex= nStep2_Idx / 2 
						nCtlIdx = nStep2_Idx % 2
						szCtlNm = ""
						
						if nCtlIdx = 0 then
							szCtlNm = "lblBondStep10"
						elseif nCtlIdx = 1 then
							szCtlNm = "lblBondStep11"
						end if
						
						DisplaySetting_Bond_Step2(nStep2_Idx, nIndex, szCtlNm)
					next
					
					szReturn = Return_AllChkYN(g_arrBond_Step2_Check)
						
					if szReturn = "Y" then
						g_szChk_Bond2 = "1"
						contMain.contBond.imgChk1.imgpath = g_szChkImg_Select
					end if
				elseif g_nAssetsIdx = 2 then
					
					arrTempData2 = Convert_StringToArr(szData_Step2, "`")
						
					for i = 0 to #arrTempData2 - 1
						nStep2_Idx = Return_ArrayIndex(g_arrMaterial_Industrial, arrTempData2(i))
						Reload_Material_Step2(nStep2_Idx)
					next		
					
					szReturn = Return_AllChkYN(g_arrMaterial_Industrial_Check)
						
					if szReturn = "Y" then
						g_szChk_Material_Industrial = "1"
						contMain.contMaterial.imgChk3.imgpath = g_szChkImg_Select
					end if
				end if
			end if
		end if
	end if
End Function


'===============================================
' 배열 -> 문자열 변환
'===============================================
Function Convert_ArrToString(arrData, szSeperator)
	szResult = ""
	
	if arrData = null then
		return szResult
	end if
	
	if szSeperator = null or szSeperator = "" then
		return szResult
	end if 	
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if i <> 0 then
			szResult = szResult & szSeperator 
		end if
		
		szResult = szResult & arrData(i) 
	next
	
	return szResult
End Function

'===============================================
' 배열 -> 문자열 변환(체크항목)
'===============================================
Function Convert_ChkArrToString(arrData, arrChkData, szSeperator)
	szResult = ""
	
	if arrData = null then
		return szResult
	end if
	
	if arrChkData = null then
		return szResult
	end if
	
	if szSeperator = null or szSeperator = "" then
		return szResult
	end if 	
	
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if arrChkData(i) = "1" then
			if szResult <> "" then
				szResult = szResult & szSeperator 
			end if
			szResult = szResult & arrData(i) 
		end if
	next
	
	return szResult
End Function

'===============================================
' 문자열 -> 배열 변환
'===============================================
Function Convert_StringToArr(szData, szSeperator)
	szArrData = ""
	
	if szData <> null and szData <> "" then
		szArrData = split(szData, szSeperator)
	end if
	
	return szArrData
End Function

'===============================================
' 배열 데이터 확인
'===============================================
Function Contains_Array(arrData, szData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		szArrData = arrData(i)
		
		if szArrData = szData then
			return true
		end if
	next 
	
	return false
End Function

'===============================================
' 체크배열 초기화
'===============================================
Function Clear_ChkArray(arrData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		arrData(i) = "0"	
	next 
End Function

'===============================================
' 체크배열 전체선택
'===============================================
Function All_ChkArray(arrData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		arrData(i) = "1"	
	next 
End Function

'===============================================
' 배열 인덱스 추출
'===============================================
Function Return_ArrayIndex(arrData, szData)
	nReturn = -1
	if arrData = null or arrData = "" then
		return nReturn
	end if
	
	if szData = null or szData = "" then
		return nReturn
	end if
	
	nArrCnt = #arrData
	for i = 0 to nArrCnt-1
		if arrData(i) = szData then
			nReturn = i
			exit for
		end if	
	next 
	
	return nReturn
End Function

Function Return_AllChkYN(arrData)
	if arrData = null or arrData = "" then
		return "N"
	end if
	
	nArrCnt = #arrData
	for i = 0 to nArrCnt-1
		if arrData(i) = "0" then
			return "N"
		end if	
	next 
	
	return "Y"
End Function




