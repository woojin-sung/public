'===============================================
' 혼합 초기설정
'===============================================
Function Init_Mix()
	contMain.contMix.lblSubTitleMix0.paddinginfo = "0,0,0,0"
	contMain.contMix.lblSubTitleMix0.fgcolor = g_szTxtColor_Grey
	
	contMain.contMix.lblChk.fgcolor = g_szTxtColor_Grey
	contMain.contMix.lblChk.paddinginfo = "0,0,0,0"
	
	contMain.contMix.lblChk.setNeighborCtlPos("imgChk", "left", 2, "전체")
	
	contMain.contMix.imgChk.setMaintainingRatio("3")
	contMain.contMix.imgChk.imgpath = g_szChkImg_Normal
	
	g_arrMix = {}
	g_arrMix_Check = {}
	
	szData = Form.GetSharedData("ETF_Step1_3", false)
	g_arrMix = Convert_StringToArr(szData, "`")
	
	nArrCnt = #g_arrMix
	
	nPannelRowCnt = Cint(nArrCnt / 2)
	if (nArrCnt mod 2) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 

	contMain.contMix.Pannel5.rowcount = nPannelRowCnt
	
	g_nStep0_Pannel_Height = (g_nCommon_Row_Height  * nPannelRowCnt) + (g_nCommon_Row_Gap * (nPannelRowCnt-1))	
	contMain.contMix.Pannel5.height = g_nStep0_Pannel_Height +5
	contMain.contMix.height =  contMain.contMix.Pannel5.top + g_nStep0_Pannel_Height + g_nBottom_Margin
	
	nArrIdx = 0
	
	for i = 0 to nPannelRowCnt - 1
		g_arrMix_Check(nArrIdx) = "0"
		contMain.contMix.Pannel5.SetCellValue( "lblMix0", i, g_arrMix(nArrIdx))	
		
		contMain.contMix.Pannel5.setPropCardCell("imagefilepth", "lblMix0", i, g_szBtnImg_Normal)
		contMain.contMix.Pannel5.setPropCardCell("fgcolor", "lblMix0", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			contMain.contMix.Pannel5.SetCellVisible("lblMix1",i,false)
			contMain.contMix.Pannel5.setPropCardCell("enable"	, "lblMix1", i, false)
			Exit for
		end if
		
		g_arrMix_Check(nArrIdx) = "0"
		contMain.contMix.Pannel5.SetCellValue( "lblMix1", i, g_arrMix(nArrIdx))	
		
		contMain.contMix.Pannel5.setPropCardCell("imagefilepth", "lblMix1", i, g_szBtnImg_Normal)
		contMain.contMix.Pannel5.setPropCardCell("fgcolor", "lblMix1", i, g_szTxtColor_Normal)
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
End Function

Function DisplaySetting_Mix(nidx,szCtlNm)
	nIndex = 0
	
	if g_szChk_Mix = "1" then
		g_szChk_Mix = "0"
		contMain.contMix.imgChk.imgpath = g_szChkImg_Normal
	end if
	
	if szCtlNm = "lblMix0" then
		nIndex = nidx * 2 + 0
	elseif szCtlNm = "lblMix1" then
		nIndex = nidx * 2 + 1
	end if
	
	if g_arrMix_Check(nIndex) = "0" then
		g_arrMix_Check(nIndex) = "1"
		contMain.contMix.Pannel5.setPropCardCell("imagefilepth", szCtlNm, nidx, g_szBtnImg_Select)
	else 
		g_arrMix_Check(nIndex) = "0"
		contMain.contMix.Pannel5.setPropCardCell("imagefilepth", szCtlNm, nidx, g_szBtnImg_Normal)
	end if
	
	szReturn = Return_AllChkYN(g_arrMix_Check)
						
	if szReturn = "Y" then
		g_szChk_Mix = "1"
		contMain.contMix.imgChk.imgpath = g_szChkImg_Select
	else
		g_szChk_Mix = "0"
		contMain.contMix.imgChk.imgpath = g_szChkImg_Normal
	end if

	
End Function

