Function Init_Alter()
	contMain.contAlter.lblSubTitleAlter0.paddinginfo = "0,0,0,0"
	contMain.contAlter.lblSubTitleAlter0.fgcolor = g_szTxtColor_Grey
	
	contMain.contAlter.lblChk.fgcolor = g_szTxtColor_Grey
