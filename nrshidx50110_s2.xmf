Function All_Material()
	nArrCnt = #g_arrMaterial
	nPannelRowCnt = Cint(nArrCnt / 3)
	if (nArrCnt mod 3) > 0 then
		nPannelRowCnt = nPannelRowCnt + 1
	end if 

	nArrIdx = 0
	for i = 0 to nPannelRowCnt-1
		contMain.contMaterial.Pannel4.setPropCardCell("imagefilepth"	, "lblMaterial0", i, g_szBtnImg_Select)
		g_arrMaterial_Check(nArrIdx) = "1"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		contMain.contMaterial.Pannel4.setPropCardCell("imagefilepth"	, "lblMaterial1", i, g_szBtnImg_Select)
		g_arrMaterial_Check(nArrIdx) = "1"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
		
		contMain.contMaterial.Pannel4.setPropCardCell("imagefilepth"	, "lblMaterial2", i, g_szBtnImg_Select)
		g_arrMaterial_Check(nArrIdx) = "1"
		nArrIdx = nArrIdx + 1
		if nArrIdx > nArrCnt - 1 then
			Exit for
		end if
	next
End Function

