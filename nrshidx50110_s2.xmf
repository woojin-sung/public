Function DisplaySetting_Material_SubView()
	for i = 0 to #g_arrMaterial-1
		if g_arrMaterial_Check(i) = "1" then
			if g_arrMaterial(i) = "귀금속" or g_arrMaterial(i) = "산업금속" then
				DisplaySetting_Control_Material(g_arrMaterial(i), true)
			end if
		else
			if g_arrMaterial(i) = "귀금속" or g_arrMaterial(i) = "산업금속" then
				DisplaySetting_Control_Material(g_arrMaterial(i), false)
			end if
		end if
	next
End Function

Function Reload_Material_Step0(nArrIdx)
	nIndex = 0
	
	nIndex= nArrIdx / 3 
	nCtlIdx = nArrIdx % 3
	szCtlNm = ""
	
	if nCtlIdx = 0 then
		szCtlNm = "lblMaterial0"
	elseif nCtlIdx = 1 then
		szCtlNm = "lblMaterial1"
	elseif nCtlIdx = 2 then
		szCtlNm = "lblMaterial2"
	end if
	
	
	g_arrMaterial_Check(nArrIdx) = "1"
