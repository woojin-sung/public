Sub Container0_contAcnt_EditRcno_OnEditComplete()
	bRslt = CloudConnectInputCheck("contAcnt.EditRcno", Container0.contAcnt.EditRcno.caption, True)

	if bRslt == True then
		if Len(Container0.contAcnt.EditRcno.caption) == 11 then
			Container0.contAcnt.EditRcno.mask = "1,0,,,1,###-####-####,0,1,1"
		elseif Len(Container0.contAcnt.EditRcno) == 10 then
			Container0.contAcnt.EditRcno.mask = "1,0,,,1,###-###-####,0,1,1"
		end if
		
		DATAMANAGER.RequestTranData("obacp_opop_073r")
	end if
End Sub

