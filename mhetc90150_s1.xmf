'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(CInt(sTimerID), 0, 0)

	if sTimerID == "1" or sTimerID == 1 then
		Container0.contAcnt.EditAcnt.SetShowKeypad(True)
	elseif sTimerID == "2" or sTimerID == 2 then
		Container0.contAcnt.EditPwd.SetShowKeypad(True)
	elseif sTimerID == "3" or sTimerID == 3 then
		Container0.contAcnt.EditRcno.SetShowKeypad(True)
	end if
	
	if sTimerID == "4" or sTimerID == 4 then
		Container0.contID.EditID.SetShowKeypad(True)
	elseif sTimerID == "5" or sTimerID == 5 then
		Container0.contID.EditPwd.SetShowKeypad(True)
	elseif sTimerID == "6" or sTimerID == 6 then
		Container0.contID.EditRcno.SetShowKeypad(True)
	end if
End Sub


