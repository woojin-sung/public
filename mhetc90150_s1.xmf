Sub ImgInfo_OnClick()
	ImgInfo.openToolTip("주민등록번호, 사업자등록번호, 외국인등록번호 중\n해당하는 실명확인번호를 입력해주세요.", 345, 60, 2)
End Sub
'============================================================================
Sub Container0_rdoAuthType_OnClick(nIndex)
	if Cint(nIndex) == 0 then
		Container0.contAcnt.visible = True
		Container0.contID.visible = False
		
		Container0.contAcnt.EditAcnt.caption = ""
		Container0.contAcnt.EditPwd.caption = ""
		Container0.contAcnt.EditRcno.caption = ""
		
		Form.SetTimerEvent2(1, 1, 0.2)
	else
		Container0.contAcnt.visible = False
		Container0.contID.visible = True
		
		Container0.contID.EditID.caption = ""
		Container0.contID.EditPwd.caption = ""
		Container0.contID.EditRcno.caption = ""
		
		Form.SetTimerEvent2(4, 1, 0.2)
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obacp_opop_073r" then
		
		if Cint(g_LoginType) <= 1 then
			DATAMANAGER.SetUserID("meritz")
		end if
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE", 		0, "3"			  	   )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 				0, Container0.contAcnt.EditAcnt.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 			0, Container0.contAcnt.EditRcno.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD", 			0, Container0.contAcnt.EditPwd.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CHAN_TYPE_CLS_CODE", 	0, g_MediaType		   )
	end if	
	
	if szTranID = "obcsb_efif_000r" then
	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"    ,   0, Container0.contAcnt.EditAcnt.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP",	0, Container0.contAcnt.EditRcno.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD",   0, Container0.contAcnt.EditPwd.caption)
		
	end if
	
	if szTranID == "obcsb_oimf_657r" then
		'DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO", 				0, g_szCustNo		  			 )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 				0, Container0.contAcnt.EditAcnt.caption	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 			0, Container0.contAcnt.EditRcno.caption	)
	end if
	
	if szTranID == "obcsb_efif_162r" then
		
		if Cint(g_LoginType) <= 1 then
			DATAMANAGER.SetUserID(Container0.contID.EditID.caption)
		end if
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID", 			0, Container0.contID.EditID.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CONN_PWD", 			0, Container0.contID.EditPwd.caption)
	end if
	
	if szTranID == "obcsb_efif_251r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID", 			0, Container0.contID.EditID.caption)
	end if
	
	if szTranID == "obcsb_acif_005r" then
		sCloudRcnoPip = Form.GetSharedData("CLOUD_CERT_RCNO_PIP", false )
		
		DATAMANAGER.SetDataValue(0, "obcsb_acif_005r", "InBlock1", "PROS_CLS_CODE",  0, "4")
		DATAMANAGER.SetDataValue(0, "obcsb_acif_005r", "InBlock1", "RCNO_PIP"	 ,  0, sCloudRcnoPip)
	end if
	
	if szTranID == "obpds_srvc_173r" then
		
		sUserID = Form.GetSharedData("CLOUD_CERT_ID", false)
		
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173r", "InBlock1", "ELFN_ID" , 0 , sUserID )		'ID
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173r", "InBlock1", "SVCD"	  , 0 ,"073" )		'서비스 코드

	'사고계좌 여부 확인	
	elseif szTranID == "obpds_srvc_173r_1" then
	
		sUserID = Form.GetSharedData("CLOUD_CERT_ID", false)
		
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173r_1", "InBlock1", "ELFN_ID" , 0 , sUserID )		'ID
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173r_1", "InBlock1", "SVCD"	  , 0 ,"ZZZ" )			'서비스 코드
		DATAMANAGER.SetDataValue( 0, "obpds_srvc_173r_1", "InBlock1", "CSNO"	  , 0 , g_sCloudCSNO)		'고객번호
	end if
	
	if szTranID == "obcsb_oimf_520r" then	
		sCloudRcnoPip = Form.GetSharedData("CLOUD_CERT_RCNO_PIP", false )
		
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS", 0, "2" )
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_520r", "InBlock1", "RCNO_PIP"  , 0, sCloudRcnoPip)	
	end if
	
	if szTranID == "obcsb_oimf_638r" then
		
		if Cint(Container0.rdoAuthType.currentindex) == 1 then
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , Container0.contID.EditID.caption )
		else
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "ACNO" , 0 , Container0.contAcnt.EditAcnt.caption )
		end if

		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID() )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "100" ) '인증서신규
	end if
	
	if szTranID == "obcsb_scif_033r" then
		
		sUserID = Form.GetSharedData("CLOUD_CERT_ID", false)
		
		if sUserID == "" then
			sUserID = Container0.contID.EditID.caption
		end if
		
		DATAMANAGER.SetDataValue( 0, "obcsb_scif_033r", "InBlock1", "ELFN_ID" , 0 , sUserID)
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacp_opop_073r" then
		
		szProsCls   = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PROS_CLS_CODE"    , 0 )
		g_szRcnoPip = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "RCNO_PIP" 		   , 0 )
		sCustName   = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CSNM" 		   , 0 )
		
		if szProsCls == "1" or szProsCls == 1 then
			
			'(미리 호출함)
			'모바일OTP 보안매체가 원장 기준으로는 있더라도
			'앱에 없을 때 보안매체 없는 고객이라고 띄우기 위함
			Form.requestMOTP("MOTP_GETINFO"     , "" , "90150")     '등록된 OTP alias 존재하는지 확인
			
			Form.SetSharedData("CLOUD_CERT_RCNO_PIP" , Container0.contAcnt.EditRcno.caption )
			Form.SetSharedData("CLOUD_CERT_ACNO" 	, Container0.contAcnt.EditAcnt.caption )
			Form.SetSharedData("CLOUD_CERT_CUST_NAME" , sCustName					       )
			
			'인증서 발급 시 마지막 단계에서 당사는 ID가 필수
			'계좌인증 시에는 따로 ID 조회해옴
			'DATAMANAGER.RequestTranData("obacp_opop_008r")	'ID조회 화면에서 가져왔는데 필요없어서 뺌(업무담당자 확인함)
			DATAMANAGER.RequestTranData("obcsb_efif_000r")
		else
			'3335 1~4회 비번 오류 / 2414 5회 이상 지점방문 에러메세지
			l_msgCode = DATAMANAGER.GetDataMsgCode(szTranID)
			if l_msgCode == "3335" or l_msgCode == 3335 or l_msgCode == "2414" or l_msgCode == 2414 then
				Dim sMsg, sSubMsg
				sMsg = DATAMANAGER.GetDataMsgText(szTranID)
				sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
					
				if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
					sMsg = sMsg.." "..sSubMsg
				end if
					
				Form.MsgBox( "안내", sMsg, "", 6 )
			else
				Form.ShowAlert("안내", "등록 정보가 일치하지 않습니다.\n 다시 한번 확인해주세요.")
			end if 
		end if
	
	end if
	
	'고객정보 체크
'	if szTranID == "obacp_opop_008r" then
'	
'		if DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CSNM", 0) <> "" then
'			DATAMANAGER.RequestTranData("obcsb_efif_000r")
'		
'		else
'			'혹시 몰라서 추가함(만약 빈 값이면 화면에서 아무 반응 없을 것이므로)
'			Form.MsgBox( "안내", "고객 정보가 없습니다.", "", 6 )
'		end if
		
	'고객HTSID조회
	if szTranID == "obcsb_efif_000r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(0 , szTranID, "OutBlock1")
		
		if Cint(nCnt) > 0 then
			
			if Cint(nCnt) = 1 then
				szAcntID = DATAMANAGER.GetDataValue(0 , szTranID, "OutBlock1", "ELFN_ID", 0)
				szCSNO   = DATAMANAGER.GetDataValue(0 , szTranID, "OutBlock1", "CSNO", 0)
				
				Form.SetSharedData("CLOUD_CERT_ID" , szAcntID	)
				
				Form.SetSharedData("CLOUD_CERT_CSNO" , szCSNO	)
				
				'인증서 발급/재발급
				if g_sRevData == "new" Then
'					
'					'인증 발급시 온라인 신원확인 동의 조회
					DATAMANAGER.RequestTranData("obpds_srvc_173r")
					
				else
					'단말기 지정여부 확인
					DATAMANAGER.RequestTranData("obcsb_oimf_638r")
				end if
				
			'ID가 복수 개인 경우
			else
				Dim szAcnt 
				szAcnt = Array()
				
				for i = 0 to nCnt - 1
					szAcnt(i) = DATAMANAGER.GetDataValue(0 , szTranID, "OutBlock1", "ELFN_ID", i)
					
					if i = 0 then						
						szMultiID = szAcnt(i)
					else
						szMultiID = szMultiID & "♥" & szAcnt(i)
					end if
					
				next

				Form.OpenPopupAnimation("mpopup_cloud", szMultiID ,"", "2")
			end if
			
		else
			'등록 불가 조건 체크
			DATAMANAGER.RequestTranData("obcsb_oimf_657r")
		end if
	
	'ID 조회 불가 조건 체크
	elseif szTranID == "obcsb_oimf_657r" then
	
		szGrpNo = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_657r", "OutBlock1", "GRP_NO" , 0 )	'0.정상

		Select Case Right(szGrpNo, 1)
		
		'등록 가능
		'정상 케이스가 나올까...??
		'Case "0" 
			
			
		'미성년자
		'Case "1"

		'법인
		'Case "2"
		
		'HTS 약정계좌 O & ID미등록 상태
		Case "3"
			szErrMsg = "ID등록 후 이용 가능합니다."
			Form.MsgBox("안내", szErrMsg, "NoHTS", 7, "ID등록", "확인")
			
		'HTS 약정계좌 X & ID미등록 상태
		Case "4"
			szErrMsg = "온라인 서비스 신청 및 ID등록 후\n이용 가능합니다."
			Form.MsgBox("안내", szErrMsg, "YesHTS", 7, "서비스 신청", "확인")
			
		'정보노출자로 등록된 고객
		'Case "5"
		
		'휴대폰 미등록 계좌
		'Case "6"

		'인증계좌 연결ID X & ID등록 상태
		'Case "7"
		
		'예외처리
		Case Else
			szErrMsg = "조회된 ID가 없습니다."
			Form.MsgBox( "안내", szErrMsg, "", 0 )
		End Select
		
	end if
	
'	if szTranID == "obcsb_acif_005r" then
'		g_sCloudCSNO   = DATAMANAGER.GetDataValue( 0, "obcsb_acif_005r", "OutBlock1", "CSNO"	   , 0 )
'		
'		'사고계좌 여부 확인
'		DATAMANAGER.RequestTranData("obpds_srvc_173r_1")
'	end if
	
	'인증서 온라인 신원확인 사전동의 조회 
	if szTranID == "obpds_srvc_173r" then
		
		g_sCloudCSNO = DATAMANAGER.GetDataValue( 0, "obpds_srvc_173r", "OutBlock2", "CSNO" , 0 )

		'약정(고객번호 있으면 약정으로 판단)
		if g_sCloudCSNO ~= null and Trim(g_sCloudCSNO) ~= "" then
			
			sAgrmYN = DATAMANAGER.GetDataValue( 0, "obpds_srvc_173r", "OutBlock1", "AGRM_YN" , 0 )
			
			'동의
			if sAgrmYN == "Y" Then
				
				'사고계좌 여부 확인
				DATAMANAGER.RequestTranData("obpds_srvc_173r_1")
			
			'미동의 - 진행불가 
			else
				Form.OpenPopup("mhetc90060_p12","","")
			end if
	    
	    '미약정 	
		else	
			'본인확인 스텝 
			if g_nIndex == 0 then
			
'				'사고계좌 여부 확인
				DATAMANAGER.RequestTranData("obpds_srvc_173r_1")
'					
			else			
				' 인증서 발급시 온라인 신원확인 사전동의 진행
				Form.OpenPopup("mhetc90060_p13","","")
			end if
			
		end if
	
	'사고계좌 여부 확인
	elseif szTranID == "obpds_srvc_173r_1" then
		Dim sAgrmYN2
		
		sAgrmYN2 = DATAMANAGER.GetDataValue( 0 , "obpds_srvc_173r_1", "OutBlock1", "AGRM_YN" , 0)
		
		if sAgrmYN2 == "N" then
			
			if Cint(g_nIndex) > 0 then
				DATAMANAGER.RequestTranData("obcsb_oimf_520r")
			else
				'인증서 발급 시 개인정보 노출자 체크
				DATAMANAGER.RequestTranData("obcsb_scif_033r")
			end if
			
			g_nIndex = g_nIndex + 1
		else
			sText = "사고의심계좌로 등록된 계좌는 인증서 발급/재발급 진행이 불가합니다."
			Form.MsgBox("알림", sText, "ACCI_MSG", 1)
		end if
	end if
	
	if szTranID == "obcsb_efif_162r" then
		sSuccYn   = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SUCS_YN"    , 0 )
		
		if sSuccYn == "Y" then
			DATAMANAGER.RequestTranData("obcsb_efif_251r")
		else
			l_msgCode = DATAMANAGER.GetDataMsgCode(szTranID)
			
			sMsg = DATAMANAGER.GetDataMsgText(szTranID)
			sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
					
			if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
				sMsg = sMsg.." "..sSubMsg
			end if
			
			'오류코드 
			'1348: 등록되지 않은 ID
			'8697: 비밀번호 5회 미만 오류
			'2413: 비밀번호 5회 이상 오류
			if l_msgCode == "1348" or l_msgCode == 1348 then
				Form.MsgBox( "안내", "등록되지 않은 ID입니다.\n\n다시 확인 후 입력해주세요.", "notRegisteredID", 6 )
			elseif l_msgCode == "8697" or l_msgCode == 8697 then
				
				sSplitMsg = Split(sSubMsg, ".")
				
				'예외 처리
				if Ubound(sSplitMsg) < 1 then
					szData = 0
				else
					szData = sSplitMsg(0)
				end if
				
				Form.MsgBox( "안내", "ID비밀번호 " & szData & "입니다.\n연속 5회 오류 시 접속이 제한됩니다.", "wrongPassword", 6 )
				
			elseif l_msgCode == "2413" or l_msgCode == 2413 then
				Form.MsgBox("안내", "ID비밀번호 5회 오류로\n이용이 제한되었습니다.\n\n재등록 후 이용해주세요.", "lockedPassword", 7, "재등록", "취소")
			else
				Form.ShowAlert("안내", "등록 정보가 일치하지 않습니다.\n 다시 한번 확인해주세요.")
			end if 
		end if
	end if
	
	if szTranID == "obcsb_efif_251r" then
		
		'(미리 호출함)
		'모바일OTP 보안매체가 원장 기준으로는 있더라도
		'앱에 없을 때 보안매체 없는 고객이라고 띄우기 위함
		Form.requestMOTP("MOTP_GETINFO"     , "" , "90150")     '등록된 OTP alias 존재하는지 확인

		sRCNO = DATAMANAGER.GetDataValue( 0, "obcsb_efif_251r", "OutBlock1", "RCNO_PIP" , 0 )
		g_sCUST_ABWR_NAME = DATAMANAGER.GetDataValue( 0, "obcsb_efif_251r", "OutBlock1", "CUST_ABWR_NAME" , 0 )
		
		if Container0.contID.EditRcno.caption == sRCNO then
			
			'인증서 발급/재발급
			if g_sRevData == "new" Then
				'인증 발급시 온라인 신원확인 동의 조회
				DATAMANAGER.RequestTranData("obpds_srvc_173r")
			else
				'단말기 지정여부 확인
				DATAMANAGER.RequestTranData("obcsb_oimf_638r")
			end if
		else
			Form.MsgBox( "안내", "고객정보가 일치하지 않습니다.\n입력하신 정보를 다시 한번 확인해주세요.", "", 6 )
		end if
	end if
	
	if szTranID == "obcsb_scif_033r" then
		szInfoChk = DATAMANAGER.GetDataValue( 0, "obcsb_scif_033r", "OutBlock1", "TRGT_YN" , 0 )
		if szInfoChk = "Y" then
			Form.MsgBox( "안내","개인정보노출자로 등록되어\n인증서 발급 및 바이오인증 등록이 불가합니다.", "", 6 )
		else
			
			'단말기 지정여부 확인
			DATAMANAGER.RequestTranData("obcsb_oimf_638r")
		end if
	end if
	
	'단말기 지정여부 팝업 오픈
	if szTranID == "obcsb_oimf_638r" then
		
		if Cint(Container0.rdoAuthType.currentindex) == 1 then
			Form.SetSharedData("CLOUD_CERT_RCNO_PIP" , Container0.contID.EditRcno.caption )
			Form.SetSharedData("CLOUD_CERT_ID" 		, Container0.contID.EditID.caption 	)
			Form.SetSharedData("CLOUD_CERT_CUST_NAME" , g_sCUST_ABWR_NAME 				)			
		end if 
		
		if DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r", "OutBlock1", "UI_SPLM_YN" , 0) == "Y" then
			Form.OpenPopup("mhetc90060_p14",g_sRevData, "")				
		else
			'추가인증 약정 여부
			if DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0) == "Y" then
				Form.SetSharedData("CLOUD_ADD_AUTH_FLAG" , g_sRevData)
				
				Form.OpenPopup("mhetc90060_p8", g_sRevData,"")
			else
				DATAMANAGER.RequestTranData("obcsb_oimf_520r")
			end if
		end if
	end if
	
	if szTranID == "obcsb_oimf_520r" then
		'0: 보안카드 / 1: 부가정보 / 2: otp,보안카드,부가정보 없음 / 3: otp / 9: 기타오류
		g_sGubunCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_520r", "OutBlock1", "RSLT_CLS" , 0)
		g_MotpYN      = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_520r", "OutBlock1", "UI_SMRT_OTP_YN" , 0)
		
		sTempID = Form.GetSharedData("CLOUD_CERT_ID", false)
		Form.SetSharedData("CERT_ID", sTempID)
		
		SetSecurityOpen()
	end if 
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID = "obacp_opop_073r" and szErrCode = "3431" then
		Form.ShowAlert("안내", "등록 정보가 일치하지 않습니다.\n 다시 한번 확인해주세요.")
		exit Sub
	end if 
	
	Form.MsgBox("안내", szErrMsg, szTranID , 0)
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "lockedPassword" then
		if sRet == "ok" then
			Form.OpenFramePopup("mhetc90020_pb", sOpenData, sPosInfo)
		else
			Form.CloseForm()
		end if
	
	elseif sKeyName == "NoHTS" then
		
		if sRet == "ok" then
			g_sCloseFlag = "NoHTS"
		end if
		
		Form.CloseForm()
		
	elseif sKeyName == "YesHTS" then
	
		if sRet == "ok" then
			g_sCloseFlag = "YesHTS"
		end if
		
		Form.CloseForm()
	end if
End Sub
'============================================================================
' 보안매체별 화면오픈
'============================================================================
Function SetSecurityOpen()
	
	'모바일OTP 인증화면에서
	'로그아웃 상태에서 520r 서비스 input을 ID로 태우지 않기 위함
	'보안카드 인증화면에도 모바일OTP발급 프로세스가 있음
'	if Cint(Container0.rdoAuthType.currentindex) == 0 then
'		Form.SetSharedData("IdRegPros", "Y")
'		Form.SetSharedData("IdRegProsAcno", Container0.contAcnt.EditAcnt.caption)
'	end if
	
	if Container0.contAcnt.visible then
		szRcno = Container0.contAcnt.EditRcno.caption
	else
		szRcno = Container0.contID.EditRcno.caption
	end if
	
	'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러	
	if g_sCustClsCode == "1" then
		if g_sGubunCode == "0" then '보안카드
			
			'보안카드 화면에도 모바일OTP 발급 프로세스를 만들거라고 함
			'Form.SetSharedData("MeritzAuth_Security", "MOTP")
			
'			if Container0.contAcnt.visible then
'				Form.SetSharedData("Meritz_OTP_RCNOPIP", Container0.contAcnt.EditRcno.caption)
'			else
'				Form.SetSharedData("Meritz_OTP_RCNOPIP", Container0.contID.EditRcno.caption)
'			end if
			
			'Form.OpenFramePopup( G_MERITZ_SECURITY_FILE , "MeritzAuth" & "★" , "" )	'보안카드풀팝업
			Form.OpenFramePopup( G_MERITZ_SECURITY_FILE , "individual_check" , "" )	'보안카드풀팝업
		
		'해당케이스는 삭제되었다고 함	
		elseif g_sGubunCode == "1" then '부가정보
			Form.OpenFramePopup( G_MERITZ_QUESTION_FILE , "individual_check" , "" )	'부가정보풀팝업
			
		elseif g_sGubunCode == "3" then 'OTP
			
			if g_MotpYN == "M" then
				
				if g_motpAppYN <> "00000" then
					Form.OpenPopup( "mhetc90190_p1", "" &"★"& szRcno &"★"& "N" &"★"& "", "")					'안내 팝업
					exit function
				end if
				
				'모바일otp 발급이 완료된 이후, 사설인증 프로세스로 돌아오기 위한 데이터 
				'(모바일OTP가 원장에는 등록 상태지만, 앱에 정보가 없는경우)
				'(인증화면 오픈 후에 발급화면으로 이동시킴)
				'(그래서 모바일OTP를 열 때 화면 오픈 전에 Set을 해줘도 될듯)
				'Form.SetSharedData("MeritzAuth_Security", "MOTP")
				
				Form.OpenPopup( G_MERITZ_MOTP_FILE , "motp_success" , "")	'MOTP
				
			'스마트OTP
			'elseif g_MotpYN == "Y" then
			
				'스마트OTP 화면에도 모바일OTP 발급 프로세스를 만들거라고 함
'				Form.SetSharedData("MeritzAuth_Security", "MOTP")
'				
'				if Container0.contAcnt.visible then
'					Form.SetSharedData("Meritz_OTP_RCNOPIP", Container0.contAcnt.EditRcno.caption)
'				else
'					Form.SetSharedData("Meritz_OTP_RCNOPIP", Container0.contID.EditRcno.caption)
'				end if
'				
'				Form.OpenFramePopup( G_MERITZ_SOTP_FILE , "MeritzAuth" & "★" , "")	'스마트OTP
			
			'OTP/스마트OTP
			else
				Form.OpenPopup( G_MERITZ_SOTP_FILE , "" , "")
			end if
	
		elseif g_sGubunCode == "2" then '없을경우
			Form.OpenPopup( "mhetc90190_p1", "", "")					'안내 팝업
			
		else '에러
			Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		end if
		
	'법인
	else
		if g_sGubunCode == "0" then '보안카드
			Form.OpenFramePopup( G_MERITZ_SECURITY_FILE , "" , "" )	'보안카드풀팝업
			
		elseif g_sGubunCode == "1" then '부가정보
			Form.OpenFramePopup( G_MERITZ_QUESTION_FILE , "" , "" )	'부가정보풀팝업
			
		elseif g_sGubunCode == "3" then 'OTP
			Form.OpenFramePopup( G_MERITZ_SOTP_FILE , "" , "" )	  	'일반/스마트OTP풀팝업
		
		elseif g_sGubunCode == "4" then '모바일OTP
			Form.OpenPopup( G_MERITZ_MOTP_FILE,"motp_success","")                          	'모바일 OTP
			
		elseif g_sGubunCode == "2" then '없을경우
		
			Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
			
		else '에러
			Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
			
		end if
	end if
End Function

'============================================================================
'Form.requestMOTP로 호출하면 여기로 리턴됨
'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam)

	if sEventName == "MOTP_GETINFO_RETURN_90150" then

		mOTPInfo  = Split(sParam,"★")    'resultcode★resultMsg★otpAlias(일련번호)
		
		if Ubound(mOTPInfo) < 1 then
			exit sub
		else	
			g_motpAppYN = mOTPInfo(0)
		end if
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	if g_sCloseFlag == "YesHTS" then
	
		Form.SetSharedData("&SCREEN_AUTH" , "99")
		Form.OpenPopup( "mbbdm85200" , "" , "")
		
	elseif g_sCloseFlag == "NoHTS" then
	
		Form.OpenScreen("85001" , "")
		
	end if
	
End Sub

