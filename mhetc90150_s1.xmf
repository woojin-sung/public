'============================================================================
'20240418 SWJ START
'클라우드 인증 발급_본인인증
'============================================================================
'로그인 or 인증센터 (CLOUD_EVENT_ACQUIREUSERINFO 이벤트 발생시) -> mhetc90302.xmf -> mhetc90303.xmf
'============================================================================
'기본 Flow 정리

'[계좌 인증]

'(발급/재발급)
'obacp_opop_073r(계좌 인증) -> obcsb_efif_000r(ID 조회, 인증서는 당사는 기본적으로 ID가 키 값)
'-> obpds_srvc_173r -> obpds_srvc_173r_1
'-> obcsb_scif_033r(개인정보 노출자 확인) -> obcsb_oimf_638r(단말기 지정여부 확인) 
'-> 추가인증 약정 여부 확인(약정이면 추가 인증 넘어가고 아니면 보안매체 인증으로 넘어감, ***하단 세부 Flow 참고***) -> PIN번호 설정 화면

'(타기관 등록)
''obacp_opop_073r(계좌 인증) -> obcsb_efif_000r(ID 조회, 인증서는 당사는 기본적으로 ID가 키 값)
'-> obcsb_oimf_638r(단말기 지정여부 확인) -> 추가인증 약정 여부 확인(약정이면 추가 인증 넘어가고, 아니면 보안매체 인증으로 넘어감) -> 인증서 선택 화면
'-> PIN번호 설정 화면

'[ID 인증]

'(발급/재발급)
' obcsb_efif_162r(ID, ID비번 체크) -> obcsb_efif_251r (실명확인번호 확인)
'-> obpds_srvc_173r -> obpds_srvc_173r_1
'-> obcsb_scif_033r(개인정보 노출자 확인) -> obcsb_oimf_638r(단말기 지정여부 확인) 
'-> 추가인증 약정 여부 확인(약정이면 추가 인증 넘어가고, 아니면 보안매체 인증으로 넘어감, ***하단 세부 Flow 참고***) -> PIN번호 설정 화면

'(타기관 등록)
' obcsb_efif_162r(ID, ID비번 체크) -> obcsb_efif_251r (실명확인번호 확인)
'-> obcsb_oimf_638r(단말기 지정여부 확인) -> 추가인증 약정 여부 확인(약정이면 추가 인증 넘어가고, 아니면 보안매체 인증으로 넘어감) -> 인증서 선택 화면
'-> PIN번호 설정 화면
'============================================================================
'세부 Flow 정리(발급/재발급 시에만 해당)

'추가인증 완료 후
'
'obpds_srvc_173r(온라인 신원확인 동의 조회)
'고객번호 있으면 약정으로 판단 
' 동의 O -> obpds_srvc_173r_1(사고계좌여부 확인) -> 사고계좌가 아니면, 보안매체 인증 진행
' 동의 X -> 진행 불가

'고객번호 없으면 미약정으로 판단 
'-> 온라인 신원확인 사전동의 진행 -> 약정을 맺고 돌아왔으면, obcsb_acif_005r(고객번호 조회) -> obpds_srvc_173r_1(사고계좌여부 확인) 
'-> 사고계좌가 아니면, 보안매체 인증 진행
'============================================================================
Dim g_Back_Flag   '뒤로가기플래그

g_Back_Flag = ""

Dim g_MediaType
g_MediaType = ""

Dim g_sGubunCode
g_sGubunCode = ""

Dim g_MotpYN
g_MotpYN = ""

Dim g_motpAppYN
g_motpAppYN = ""

Dim g_sRevData
g_sRevData = ""

Dim g_sCUST_ABWR_NAME
g_sCUST_ABWR_NAME = ""

Dim g_LoginType
g_LoginType = ""

Dim g_sCloseFlag
g_sCloseFlag = ""

Dim g_sCloudCSNO
g_sCloudCSNO = ""

Dim g_nIndex
g_nIndex = 0

Dim G_MERITZ_SECURITY_FILE 		'보안카드풀팝업
Dim G_MERITZ_QUESTION_FILE 		'부가정보풀팝업
Dim G_MERITZ_OTP_FILE 			'일반OTP풀팝업
Dim G_MERITZ_SOTP_FILE 		'스마트OTP풀팝업
Dim G_MERITZ_MOTP_FILE 		'모바일OTP풀팝업

G_MERITZ_SECURITY_FILE 		= "mhetc90060_p9"		'보안카드풀팝업
G_MERITZ_QUESTION_FILE			= "mhetc90060_pa"		'부가정보풀팝업
G_MERITZ_SOTP_FILE 			= "mhetc90060_pb"		'스마트OTP풀팝업
G_MERITZ_OTP_FILE 			= "mhetc90060_otp"	'일반OTP풀팝업
G_MERITZ_MOTP_FILE			= "mhetc90060_motp"    '모바일OTP풀팝업
'============================================================================
Sub Form_OnFormInitBefore()
	Container0.ImgBackPress.setMaintainingRatio("1")
	Container0.ImgInfo.setMaintainingRatio("1")
	
	Form.transmode = false 'true 불투명, false 투명
	
	szDev = Form.GetSharedData("&SERVER_MODE", False)
	
'	if szDev == "1" then
'		Container0.contID.Buttonok.visible = true
'	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	g_MediaType   = Form.GetSharedData("&MEDIA_CODE"   , false)
	g_LoginType = Form.GetSharedData("&LOGIN_TYPE", false )
	
	Form.transmode = true 'true 불투명, false 투명
	Container0.contAcnt.visible = true
	Container0.contID.visible = false

	Container0.contAcnt.EditAcnt.SetApplyLabel("계좌번호" 		, 0, 267, "left", false)  'True.필수입력 / False.선택입력
	Container0.contAcnt.EditRcno.SetApplyLabel("실명확인번호"	, 0, 267, "left", false)  'True.필수입력 / False.선택입력
	Container0.contAcnt.EditPwd.SetApplyLabel("계좌비밀번호"	, 0, 267, "left", false)  'True.필수입력 / False.선택입력
	
	Container0.contAcnt.EditAcnt.SetUseResultLabel(True, 1)	'True.사용가능 / False.사용불가, 라인수
	Container0.contAcnt.EditRcno.SetUseResultLabel(True, 1)	'True.사용가능 / False.사용불가, 라인수
	Container0.contAcnt.EditPwd.SetUseResultLabel(True, 1)		'True.사용가능 / False.사용불가, 라인수
	
	Container0.contID.EditID.SetApplyLabel("ID" 			, 0, 267, "left", false)  'True.필수입력 / False.선택입력
	Container0.contID.EditRcno.SetApplyLabel("실명확인번호"	, 0, 267, "left", false)  'True.필수입력 / False.선택입력
	Container0.contID.EditPwd.SetApplyLabel("ID비밀번호"	, 0, 267, "left", false)  'True.필수입력 / False.선택입력
	
	Container0.contID.EditID.SetUseResultLabel(True, 1)		'True.사용가능 / False.사용불가, 라인수
	Container0.contID.EditRcno.SetUseResultLabel(True, 1)		'True.사용가능 / False.사용불가, 라인수
	Container0.contID.EditPwd.SetUseResultLabel(True, 1)		'True.사용가능 / False.사용불가, 라인수
	
	'클라우드 발급: "new"
	'클라우드 타기관 등록: "regi"
	g_sRevData = Form.GetOpenLinkData()
	
	if g_sRevData == "regi" then
		Container0.labTitle.caption = "타기관 클라우드인증서 등록"
	end if 
	
	Form.SetTimerEvent2(1, 1, 0.2)
End Sub

'
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'클라우드연결(고객정보) 입력 -> 기기인증 후 리턴 (From mhetc90303)
		'InProgress 진행중
		'Complete 완료
		'Canceled 취소
		'AuthCodeDoesNotMatch 인증번호 불일치
		'Timeout 타임아웃
		'AuthCodeInvalidated 인증코드 전송횟수 초과

	if sKeyName == "CLOUDCERT_DEVICE_AUTH" then
		' sRet
		' 	- InProgress 진행중
		' 	- Complete 완료
		' 	- Canceled 취소
		' 	- AuthCodeDoesNotMatch 인증번호 불일치
		' 	- Timeout 타임아웃
		' 	- AuthCodeInvalidated 인증코드 전송횟수 초과		
		
		if sRet == "Complete" then
			Form.CloseForm()
			Form.SendReturnToParent("CLOUD_CHECK_CONNECT", "OK")	
		
		elseif sRet == "Canceled" then
			Form.MsgBox("알림", "클라우드연결을 위한 단말인증이 취소되었습니다.", "", 0)
			
		elseif sRet == "AuthCodeDoesNotMatch" then
			Form.MsgBox("알림", "클라우드연결을 위해 입력한 인증번호가 맞지않습니다.", "", 0)
			
		elseif sRet == "Timeout" then
			Form.MsgBox("알림", "클라우드연결을 위한 인증유효시간이 지났습니다.", "", 0)				

		elseif sRet == "AuthCodeInvalidated" then
			Form.MsgBox("알림", "클라우드연결을 위한 인증코드 전송횟수가 초과되었습니다. .", "", 0)				
		end if		
		
		Form.CloseForm()
		Form.SendReturnToParent("CLOUD_CHECK_CONNECT", "NO")
	end if
	
	if sKeyName == "mpopup_cloud" then
		if sRet <> "" then
			Form.SetSharedData("CLOUD_CERT_ID" , sRet)
			
			'인증서 발급/재발급
			if g_sRevData == "new" Then
				'인증 발급시 온라인 신원확인 동의 조회
				DATAMANAGER.RequestTranData("obpds_srvc_173r")
			else
				'단말기 지정여부 확인
				DATAMANAGER.RequestTranData("obcsb_oimf_638r")
			end if
		end if
	end if
	
	if sKeyName == "mhetc90060_p8" then
		
		if sRet == "ok" then
			
			g_sCustClsCode = Form.GetSharedData("CERT_CUST_CLS_CODE", true )
			
			'인증서 발급/재발급
			if g_sRevData == "new" Then
				'인증 발급시 온라인 신원확인 동의 조회
				DATAMANAGER.RequestTranData("obpds_srvc_173r")
				
			'타기관 등록
			else
				DATAMANAGER.RequestTranData("obcsb_oimf_520r")
			end if
			
		else
			Form.CloseForm()
		end if
	end if
	
	if sKeyName == "mhetc90152_p1" then
		
		if sRet <> "" then
			if sRet == "cancel" then
				Form.CloseForm()
			else
				'sRet은 클라우드 인증서ID
				
				Form.OpenPopup("mhetc90150_s3" , "register" & "★" & sRet , "")
			end if
		end if
	end if
	
	'완료 팝업
	if sKeyName == "mhetc90150_p2" then
		if sRet == "register" then
			Form.CloseForm()
		end if
	end if
	
	'인증서 발급시 온라인 신원확인 사전동의 팝업창 동의
	if sKeyName == "mhetc90060_p13" then 
		'약정(동의)
		if sRet == "AgreeY" then
			
			DATAMANAGER.RequestTranData("obpds_srvc_173r")
			
			'g_nStepIndex = g_nStepIndex+1
			'SetControlChange()
			
		'약정(미동의) 또는 발급/재발급 업무 중단 
		else
			Form.CloseForm()
		end if
	end if
	
	if sKeyName == G_MERITZ_SECURITY_FILE or sKeyName == G_MERITZ_QUESTION_FILE or sKeyName == G_MERITZ_OTP_FILE or sKeyName == G_MERITZ_SOTP_FILE or sKeyName == G_MERITZ_MOTP_FILE then
		 if sRet == "ok" then
			
			'인증서 발급/재발급
			 if g_sRevData == "new" Then
				
				 '법인
'				 if g_sCustClsCode == "2" then
'					 Form.OpenPopup("mhetc90150_s2" , "" , "")
'				 '개인
'				 else
					
					'개인/법인 모두 클라우드 인증서 발급
					 Form.OpenPopup("mhetc90150_s3" , "new" , "")
				 'end if
				 
			 else
				  '인증서 목록 화면
				  Form.OpenPopup("mhetc90152_p1" , "클라우드인증서" , "")
			 end if
			 
		 else
			 Form.CloseForm()
		 end if
	end if
	
	if sKeyName == "mhetc90150_s3" then
		if sRet == "register" then
			Form.OpenPopup("mhetc90150_p2","register","")
		elseif sRet == "new" then
			Form.CloseForm()
		else
			Form.CloseForm()
		end if

	end if
	
	if sKeyName == "mhetc90060_p14" then
		Form.SetSharedData("CLOUD_ADD_AUTH_FLAG" , g_sRevData)
		Form.OpenPopup( "mhetc90060_p8" , g_sRevData&"_otp", "" )	
	end if
End Sub

'============================================================================
Sub Container0_Buttonok_OnClick()
	
	if Container0.contAcnt.visible then
		bRslt = CloudConnectInputCheck("contAcnt.EditRcno", Container0.contAcnt.EditRcno.caption, True)
	
		if bRslt == True then
			if Len(Container0.contAcnt.EditRcno.caption) == 11 then
				Container0.contAcnt.EditRcno.mask = "1,0,,,1,###-####-####,0,1,1"
			elseif Len(Container0.contAcnt.EditRcno) == 10 then
				Container0.contAcnt.EditRcno.mask = "1,0,,,1,###-###-####,0,1,1"
			end if
			
			DATAMANAGER.RequestTranData("obacp_opop_073r")
		end if
	else
		bRslt = CloudConnectInputCheck("contID.EditRcno", Container0.contID.EditRcno.caption, True)

		if bRslt == True then
			if Len(Container0.contID.EditRcno.caption) == 11 then
				Container0.contID.EditRcno.mask = "1,0,,,1,###-####-####,0,1,1"
			elseif Len(Container0.contID.EditRcno) == 10 then
				Container0.contID.EditRcno.mask = "1,0,,,1,###-###-####,0,1,1"
			end if
			
			DATAMANAGER.RequestTranData("obcsb_efif_162r")
		end if
	end if
End Sub

'============================================================================
'계정연결 안하고 닫기


'============================================================================
Function CloudConnectInputCheck(sType, sInput, bShowKeypad)

	sInput = Trim(sInput)	
	
	if Cint(ImgInfo.top) == 403 then
		ImgInfo.visible = True
	else
		ImgInfo.visible = False
	end if
	
	if sType == "contAcnt.EditAcnt" then
		if sInput == "" Then
			Container0.contAcnt.EditAcnt.SetResultLabel("1","error","계좌번호를 입력해주세요.","Container0.contAcnt")
	
			if bShowKeypad == True and g_Back_Flag <> "Y" then
				Form.SetTimerEvent2(1, 1, 0.2) '0.1초뒤 보안키패드 활성화
			end if	

			return False
		
		else
			'공백 체크
		    sStr = Len(Container0.contAcnt.EditAcnt.Caption)
		    
		    If sStr <> 8 Then
			    Container0.contAcnt.EditAcnt.SetResultLabel("1","error","계좌번호 앞 8자리를 입력해주세요.","Container0.contAcnt")
		    else
				Container0.contAcnt.EditAcnt.SetResultLabel("0","complete","","Container0.contAcnt")
				
				if bShowKeypad == True And Container0.contAcnt.EditPwd.caption == "" Or Container0.contAcnt.EditPwd.caption == null then
					If g_Back_Flag <> "Y" Then
						Form.SetTimerEvent2(2, 1, 0.2) '0.1초뒤 보안키패드 활성화
					End If		
				end if
			end if
	    end if	
	
	
	elseif sType == "contAcnt.EditPwd" then
		if sInput == "" Then
			Container0.contAcnt.EditPwd.SetResultLabel("1","error","계좌비밀번호를 입력해주세요.","Container0.contAcnt")
			
			if bShowKeypad == True and g_Back_Flag <> "Y" then
				Form.SetTimerEvent2(2, 1, 0.2) '0.1초뒤 보안키패드 활성화
			end if	
			
			return False
	
		else
			nLen = Container0.contAcnt.EditPwd.pwdlen
			
			if Cint(nLen) < 4 then
			   Container0.contAcnt.EditPwd.SetResultLabel("1","error","4자 이상 입력해주세요.","Container0.contAcnt")
			else
				Container0.contAcnt.EditPwd.SetResultLabel("0","complete","","Container0")
			
				if Container0.contAcnt.EditRcno.caption == "" Or Container0.contAcnt.EditRcno.caption == null then
					If g_Back_Flag <> "Y" Then
						Form.SetTimerEvent2(3, 1, 0.2) '0.1초뒤 보안키패드 활성화
					End If		
				end if
			end if
		end if	
		
	elseif sType == "contAcnt.EditRcno" then
		if sInput == ""  Then
			Container0.contAcnt.EditRcno.SetResultLabel("1","error","1글자 이상 입력해주세요.","Container0.contAcnt")
			
			if bShowKeypad == True and g_Back_Flag <> "Y" then
				Form.SetTimerEvent2(3, 1, 0.2) '0.1초뒤 보안키패드 활성화
			end if	
			
			return False
			
		
		else
			Container0.contAcnt.EditRcno.SetResultLabel("0","complete","","Container0.contAcnt")
		end if		
	
	elseif sType == "contID.EditID" then
		if sInput == "" Then
			Container0.contID.EditID.SetResultLabel("1","error","계좌번호를 입력해주세요.","Container0.contID")
	
			if bShowKeypad == True and g_Back_Flag <> "Y" then
				Form.SetTimerEvent2(4, 1, 0.2) '0.1초뒤 보안키패드 활성화
			end if	

			return False
		
		else
			Container0.contID.EditID.SetResultLabel("0","complete","","Container0.contID")
				
			if bShowKeypad == True And Container0.contID.EditPwd.caption == "" Or Container0.contID.EditPwd.caption == null then
				If g_Back_Flag <> "Y" Then
					Form.SetTimerEvent2(5, 1, 0.2) '0.1초뒤 보안키패드 활성화
				End If		
			end if
	    end if
	
	elseif sType == "contID.EditPwd" then
		if sInput == "" Then
			Container0.contID.EditPwd.SetResultLabel("1","error","ID비밀번호를 입력해주세요.","Container0.contID")
			
			if bShowKeypad == True and g_Back_Flag <> "Y" then
				Form.SetTimerEvent2(5, 1, 0.2) '0.1초뒤 보안키패드 활성화
			end if	
			
			return False
	
		else
			Container0.contID.EditPwd.SetResultLabel("0","complete","","Container0.contID")
			
			if Container0.contID.EditRcno.caption == "" Or Container0.contID.EditRcno.caption == null then
				If g_Back_Flag <> "Y" Then
					Form.SetTimerEvent2(6, 1, 0.2) '0.1초뒤 보안키패드 활성화
				End If		
			end if
		end if	
	
	elseif sType == "contID.EditRcno" then
		if sInput == ""  Then
			Container0.contID.EditRcno.SetResultLabel("1","error","1글자 이상 입력해주세요.","Container0.contID")
			
			if bShowKeypad == True and g_Back_Flag <> "Y" then
				Form.SetTimerEvent2(6, 1, 0.2) '0.1초뒤 보안키패드 활성화
			end if	
			
			return False
		
		else
			Container0.contAcnt.EditRcno.SetResultLabel("0","complete","","Container0.contID")
		end if		
	
	end if

	return True
End Function

