		<LABEL name="Label1" visible="0" fgcolor="006:213049051" fontsize="-3" caption="※권리입고예정주식 확인요망" multiline="1" ly_horz="385,40,231,38,0" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="21189" _ulen="19367" >

'============================================================================
' 화 면 명 : 주식주문(가로)_잔고팝업
' 화면설명 : 주식주문(가로) 매도에서 잔고버튼 클릭시 오픈
' 작    성 : 2016.01.26 ~ 2016. 02. 05      ssang
'          : 2022.11.01 v002 대출대여관련 개발
'          : 2023.02.07 v003 양도담보관련 개발
'============================================================================

'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_szGbn, g_szChk, g_szTab, g_szSelect
g_szAcnt, g_szAcntCd, g_szGbn, g_szChk, g_szTab, g_szSelect = "", "", "", "", "", ""

Dim g_szTitle
g_szTitle = "알림"
Dim g_index
Dim g_Toggle1
Dim g_Toggle2
Dim g_Buffer


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' SetGridData
'============================================================================
Function SetGridData()
	Dim nRate, nData
	Dim szData, szReturnValue
	Dim nVLTN_PRLS_AMT, nBYNG_AMT, nEXPN_AMT	' 평가손익, 매입금액, 비용금액
	
	nVLTN_PRLS_AMT = 0
	nBYNG_AMT      = 0
	g_Toggle1      = 0
	g_Toggle2      = 0
	
	SetGridHeader(g_Toggle1, g_Toggl2)
	
	For i = 0 To grdList.rowcount -1
		If chk2.checkstate = "1" Then
			nVLTN_PRLS_AMT	= CDbl( grdList.GetCellData( "bd_cell6", i ) ) - CDbl( grdList.GetCellData("bd_cell0", i) )		
		Else
			nVLTN_PRLS_AMT	= CDbl( grdList.GetCellData( "bd_cell6", i ) )
		End If
	
		
		nBYNG_AMT 	  	= CDbl(grdList.GetCellData("bd_cell8", i))
		nPSNT_PRC		= grdList.GetCellData("bd_Hyun", i)
		szData			= grdList.GetCellData("bd_Gbn", i)
		
		grdList.SetCellData("bd_cell6", i, nVLTN_PRLS_AMT)
		
		'매입금액이 있는 경우에만 계산
		If CDbl( grdList.GetCellData( "bd_cell8", i ) ) = 0 Then
			grdList.SetCellData("bd_cell7", i, "" )
		Else
			grdList.SetCellData("bd_cell7", i, FormatNumber(FIX((nVLTN_PRLS_AMT/nBYNG_AMT)*10000)/100,2))
		End If
		
		If nPSNT_PRC = "" and chk2.checkstate = "1" Then
			nData = CDbl(grdList.GetCellData("bd_cell13", i)) * -1
			
			grdList.SetCellData("bd_LoanCd", i, nData)
		End If
						
		Select Case szData
			Case "0000"	szReturnValue = "보통"
			Case "0101"	szReturnValue = "자기융자"
			Case "0102"	szReturnValue = "유통융자"
			Case "0103"	szReturnValue = "자기대주"
			Case "0104"	szReturnValue = "유통대주"
			Case "0201"	szReturnValue = "예탁주식"
			Case "0202"	szReturnValue = "예탁채권"
			Case "0203"	szReturnValue = "예탁집합투자"
			Case "0204"	szReturnValue = "예탁장외파생"
			Case "0211"	szReturnValue = "예탁유통주식"
			Case "0212"	szReturnValue = "예탁유통채권"
			Case "0213"	szReturnValue = "예탁유통집합투자"
			Case "0214"	szReturnValue = "예탁유통장외파생"
			Case "0301"	szReturnValue = "매도증권담보대출"
			Case "0302"	szReturnValue = "수익증권환매"
			Case "0303"	szReturnValue = "ELS환매자금대출"
			Case "0401"	szReturnValue = "소액주식"
			Case "0402"	szReturnValue = "소액채권"
			Case "0403"	szReturnValue = "소액수익증권"
			Case "0404"	szReturnValue = "소액 ELS"
			Case "0501"	szReturnValue = "공모주청약"
			Case "0502"	szReturnValue = "ELS청약"
			Case "0503"	szReturnValue = "주식매입"
			Case "0601"	szReturnValue = "매입자금대출"
			Case "0701"	szReturnValue = "초단기대출"
			Case "0801"	szReturnValue = "CMA담보대출"
			Case "9201"   szReturnValue = "대출(대여)" 'v002 
			Case "8201"   szReturnValue = "양도담보" 'v003 
			Case "6201" szReturnValue = "슈퍼365(재활용)" '20230908 SWJ
			Case "7201" szReturnValue = "담보대여" 		'20230908 SWJ
		End Select
		
		'20180123 LES START - 대여주문 '20180904 대여주석처리
		if szData == "0000" then
			if grdList.GetCellData("bd_cell1", i) == "31" then
				szReturnValue = "주식대여"				'20230908 SWJ
			end if
		end if
		'20180123 LES END
			
		
		grdList.SetCellData("bd_Gbn", i, szReturnValue)
	Next	
	
	'v001. 최초 호출 후, ReceiveComplete에서 연속 호출(종목정보)
'	g_index = 0
'	iscd = grdList.GetCellData("bd_Cd", 0)
'		
'	DATAMANAGER.SetDataValue(0, "obsim_stsv_001r", "InBlock1", "ISCD" , 0 , iscd)	
'	DATAMANAGER.RequestTranData("obsim_stsv_001r")
	
'	nRate = Round((nVLTN_PRLS_AMT / nBYNG_AMT) * 100, 2)	
'
'	tbl0.SetCellString(0, 3, nVLTN_PRLS_AMT)		'미실현손익
'	tbl0.SetCellString(1, 3, nRate)				'손익률
End Function

'============================================================================
' Request_Data()
'============================================================================
Function Request_Data()
	grdList.rowcount = 0
	
	if g_szGbn == "1" then		' 예약주문에서 조회
		DATAMANAGER.RequestTranData("obtrs_comn_310r")	
	else
'		if g_szChk == "0" then
			If chk1.checkstate = "1" Then
				DATAMANAGER.RequestTranData("obtrs_comn_329r")
			Else
				DATAMANAGER.RequestTranData("obtrs_comn_310r")
			End If
'		elseif g_szChk == "1" then
'			DATAMANAGER.RequestTranData("obtrs_comn_310r")
'		end if
	end if
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("주식잔고")


	szOpen = Form.GetOpenLinkData()
	g_szChk = "0"
	g_Buffer = 0
	
	if Trim(szOpen) == "" then
		Exit Sub
	end if
	
	Button0.visible = false
	
	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt   = tData(0)
		g_szAcntCd = tData(1)
		g_szTab    = tData(2)
		g_szGbn    = tData(3)
		chk1.checkstate = tData(4)
	
		if tData(3) == "1" then		' 예약주문에서 여는경우
			chk1.left = 1000
			chk2.left = 1000
			grdList.top = 0
			grdList.height = 563		
		end if
		
		Request_Data()
	end if

	DATAMANAGER.RequestTranData("obtrs_oder_161r")
	
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szFEE_INCU_YN
	
	
	'비용반영
	if g_szGbn == "1" then		' 예약주문에서 조회
		szFEE_INCU_YN = "N"
	else
		if chk2.checkstate = "1" then
			szFEE_INCU_YN = "Y"
		else
			szFEE_INCU_YN = "N"
		end if
	end if

'	' ----------------------------------------------------------------------
'	' 개별계좌 평가내역
'	' ----------------------------------------------------------------------	
'	If szTranID = "obacb_balc_105r" Then
'		DATAMANAGER.ClearInputData(0, "obacb_balc_105r")
'		
'		DATAMANAGER.SetDataValue(0, "obacb_balc_105r", "InBlock1", "WRAP_ACNT_YN" 	, 0, "N")
'		DATAMANAGER.SetDataValue(0, "obacb_balc_105r", "InBlock1", "ACNO" 			, 0, g_szAcnt)		
'		DATAMANAGER.SetDataValue(0, "obacb_balc_105r", "InBlock1", "ASNO" 			, 0, g_szAcntCd)
'	' ----------------------------------------------------------------------
'	' 계좌 주식잔고내역
'	' ----------------------------------------------------------------------	
'	ElseIf szTranID = "obtrs_comn_308r" Then
'		DATAMANAGER.ClearInputData(0, "obtrs_comn_308r")
'		
'		DATAMANAGER.SetDataValue(0, "obtrs_comn_308r", "InBlock1", "ACNO"		 	, 0, g_szAcnt)
'		DATAMANAGER.SetDataValue(0, "obtrs_comn_308r", "InBlock1", "ASNO" 			, 0, g_szAcntCd)
'		DATAMANAGER.SetDataValue(0, "obtrs_comn_308r", "InBlock1", "UI_RMND_CLCD" 	, 0, "00")
'		DATAMANAGER.SetDataValue(0, "obtrs_comn_308r", "InBlock1", "FEE_INCU_YN" 	, 0, szFEE_INCU_YN)
	' ----------------------------------------------------------------------
	' 계좌 실시간 잔고조회2(미체결주
	' ----------------------------------------------------------------------			
	If szTranID = "obtrs_comn_310r" Then
		DATAMANAGER.ClearInputData(0,"obtrs_comn_310r" )
		
		DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "ACNO"			, 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "ASNO"			, 0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "UI_RMND_CLCD"	, 0, "00")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "IQRY_CLS_CODE"	, 0, "1")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "BRNG_STCK_YN"	, 0, "N")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_310r", "InBlock1", "FEE_INCU_YN"		, 0, szFEE_INCU_YN)		
	' ----------------------------------------------------------------------
	' 계좌 신용팝산 실시간 잔고조회
	' ----------------------------------------------------------------------			
	ElseIf szTranID = "obtrs_comn_329r" Then
		DATAMANAGER.ClearInputData(0, "obtrs_comn_329r")
		
		DATAMANAGER.SetDataValue(0, "obtrs_comn_329r", "InBlock1", "ACNO" 			, 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_329r", "InBlock1", "ASNO" 			, 0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obtrs_comn_329r", "InBlock1", "UI_RMND_CLCD" 	, 0, "00")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_329r", "InBlock1", "IQRY_CLS_CODE" 	, 0, "1")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_329r", "InBlock1", "BRNG_STCK_YN" 	, 0, "N")
		DATAMANAGER.SetDataValue(0, "obtrs_comn_329r", "InBlock1", "FEE_INCU_YN" 	, 0, szFEE_INCU_YN)
	' ----------------------------------------------------------------------
	' 고객별 매매수수료정보 조회
	' ----------------------------------------------------------------------			
	ElseIf szTranID = "obpds_srvc_326r" Then
		DATAMANAGER.ClearInputData(0, "obpds_srvc_326r")
		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_326r", "InBlock1", "ACNO" 			, 0, g_szAcnt)		
		DATAMANAGER.SetDataValue(0, "obpds_srvc_326r", "InBlock1", "ASNO" 			, 0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obpds_srvc_326r", "InBlock1", "ONLN_YN" 		, 0, "Y")
		
	ElseIf szTranID = "obtrs_oder_161r" Then
		DATAMANAGER.ClearInputData(0, "obtrs_oder_161r")
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_161r", "InBlock1", "ACNO"			, 0, g_szAcnt)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_161r", "InBlock1", "ASNO"			, 0, g_szAcntCd)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_161r", "InBlock1", "ISCD"			, 0, "%")
	End If
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	' ----------------------------------------------------------------------
'	' 개별계좌 평가내역
'	' ----------------------------------------------------------------------		
'	If szTranID = "obacb_balc_105r" Then
'		DATAMANAGER.RequestTranData("obtrs_comn_308r")
'	' ----------------------------------------------------------------------
'	' 계좌 주식잔고내역
'	' ----------------------------------------------------------------------		
'	ElseIf szTranID = "obtrs_comn_308r" Then
'		Request_Data()
	' ----------------------------------------------------------------------
	' 계좌 신용팝산 실시간 잔고조회, 계좌 실시간 잔고조회2(미체결주
	' ----------------------------------------------------------------------		
	If szTranID = "obtrs_comn_329r" Or szTranID = "obtrs_comn_310r" Then
		SetGridData()
		
		for i = 0 to grdList.rowcount - 1
			psnt_prc = Cdbl(grdList.GetCellData("bd_Hyun", i))
			psdy_clpr= Cdbl(grdList.GetCellData("bd_cell2",i))
			
			if psnt_prc > psdy_clpr then
				grdList.SetCellFgColor("bd_Hyun", i, "10")
			elseif psnt_prc = psdy_clpr then
				grdList.SetCellFgColor("bd_Hyun", i, "4")
			else
				grdList.SetCellFgColor("bd_Hyun", i, "11")
			end if
			
			if trim(grdList.GetCellData("bd_cell8", i)) == "" then
				byng_amt = 0
			else
				byng_amt = Cdbl(grdList.GetCellData("bd_cell8", i))
			end if
			
			if trim(grdList.GetCellData("bd_cell3", i)) == "" then
				loan_amt = 0
			else
				loan_amt = Cdbl(grdList.GetCellData("bd_cell3", i))
			end if
			
			grdList.SetCellData("bd_cell4", i, byng_amt - loan_amt)
		next
	'v001.
'	elseif szTranID = "obsim_stsv_001r" then
'		
'		if Cint(g_index) < Cint(grdList.rowcount)  then
'			
'			iscd = DATAMANAGER.GetDataValue(0, "obsim_stsv_001r", "OutBlock1", "ISCD" , 0)
'			prdy_clpr = DATAMANAGER.GetDataValue(0, "obsim_stsv_001r", "OutBlock1", "PRDY_CLPR" , 0)
'			
'			grdList.SetCellData("bd_cell2", g_index, prdy_clpr)
'			g_index = g_index + 1
'			
'			iscd = grdList.GetCellData("bd_Cd", g_index)
'			DATAMANAGER.SetDataValue(0, "obsim_stsv_001r", "InBlock1", "ISCD" , 0 , iscd)	
'			
'			DATAMANAGER.RequestTranData("obsim_stsv_001r")
'		end if
'		
'		'v001. g_index = grdList.rowcnt 일때 complete를 안타므로 바로 색상처리
'		if Cint(g_index) == Cint(grdList.rowcount) then
'			for i = 0 to grdList.rowcount - 1
'				psnt_prc = Cdbl(grdList.GetCellData("bd_Hyun", i))
'				psdy_clpr= Cdbl(grdList.GetCellData("bd_cell2", i))
'				
'				
'				if psnt_prc > psdy_clpr then
'					grdList.SetCellFgColor("bd_Hyun", i, "10")
'				elseif psnt_prc = psdy_clpr then
'					grdList.SetCellFgColor("bd_Hyun", i, "4")
'				else
'					grdList.SetCellFgColor("bd_Hyun", i, "11")
'				end if
'			next
'		end if
	ElseIf szTranID = "obtrs_oder_161r" Then
		if DATAMANAGER.GetDataValue(0,  "obtrs_oder_161r", "OutBlock1", "RGHT_HLDN_YN", 0) == "Y" then
			Button0.visible = true
			Label1.visible  = true
			
		end if
	End If
End Sub

'============================================================================
' chk1_OnChange
'============================================================================
Sub chk1_OnChange(sCheckState)
	If Trim(g_szAcnt) == "" Then
		Exit Sub
	End If

	g_szChk = "0"
	Request_Data()
End Sub

'============================================================================
' chk2_OnChange
'============================================================================
Sub chk2_OnChange(sCheckState)
	If Trim(g_szAcnt) == "" Then
		Exit Sub
	End If
	
	g_szChk = "1"
	Request_Data()
End Sub

'============================================================================
' grdList_OnClickUp
'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	Dim szCd, szQty, szLoanDate, szLoanCd, szLoanSr, szData
	Dim errmsg
	errmsg = "종목마스터의 오류로 주문 및 시세 조회가 불가능합니다. 동일 증상 반복 시 확인 버튼을 눌러 주시기 바랍니다.\n\n ※기타문의사항은 고객지원센터 (1588-3400)로 문의하여 주시기 바랍니다."
	
		
	if lRow > -1 then
		szCd       = grdList.GetCellData("bd_Cd",       lRow)
		szQty      = grdList.GetCellData("bd_Able",     lRow)
		szLoanDate = grdList.GetCellData("bd_LoanDate", lRow)	
		szLoanCd   = grdList.GetCellData("bd_LoanCd",   lRow)	
		szLoanSr   = grdList.GetCellData("bd_LoanSr",   lRow)
		
		'20230918 SWJ START: 위치 옮김 (뒤에 위치하면, szClcd값이 "31"이어서 대여주문 가능 메시지를 뿌림)
		if szLoanCd = "8201" then  'v003 양도담보 불가
			Form.ShowAlert("알림", "양도담보 잔고는 매도주문이 불가능 합니다.")
			Exit Sub
		end if 
			
		if szLoanCd = "9201" then  'v002 대출대여 신용합산 매도 불가
			Form.ShowAlert("알림", "대출대여 잔고는 MTS에서 매도주문이 불가능 합니다.")
			Exit Sub
		end if 
		'20230918 SWJ END
		
		'20180124 LES START - 대여주문
		szClcd 	  = grdList.GetCellData("bd_cell1", lRow)
		
		if szClcd == "31" or ( szLoanCd == "6201" or szLoanCd == "7201" ) then	'20230908 SWJ : 잔고 세분화 (담보대여, 슈퍼365재활용)
			Form.ShowAlert("알림", "해당종목은 대여주문화면에서 주문실행하시기 바랍니다.")
			Exit Sub
		end if
		'20180124 LES END - 대여주문

		'20161205 ETN이나 신주인수권 등 6자리가 아닌 종목은 Q나 J를 붙여서 종목안내창에 표기하므로
		'  그 부분에 대한 처리를 하여야 한다고 함.
		' 20160310 주문불가한 종목 예외처리
		'szCutCd = Mid(szCd, 2, Len(szCd))
		if(left(szCd,1) == "J" and len(szCd) == 9) or left(szCd,1) == "Q" or left(szCd,1) == "F" then
			szMk = Form.GetItemCodeInfo(szCd, "market")
		else
			szCutCd = Mid(szCd,2,len(szCd))
			szMk = Form.GetItemCodeInfo(szCutCd, "market")
		end if
		
		
		if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then
			'  전달내용/탭위치/종목코드/수량/대출일자/대출상세/신용합산여부/대출일련번호
			szData = "잔고" & "★" & g_szTab & "★" & szCd & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & chk1.checkstate & "♥" & szLoanSr
			g_szSelect = "1"
			
			Form.SendReturnToParent("12000_BALANCE", szData)
			Form.CloseForm()
		else
			Form.MsgBox("알림", errmsg, "REUPDATE", 1)		
		end if
	end if
End Sub

'============================================================================
' btnInquiry_OnClick
'============================================================================
Sub btnInquiry_OnClick()
	If Trim(g_szAcnt) == "" Then
		Exit Sub
	End If
	
	Request_Data()
End Sub

'============================================================================
' btnSearch_OnClick : 버튼 숨김
'============================================================================
Sub btnSearch_OnClick()
'	DATAMANAGER.RequestTranData("obacb_balc_105r")
End Sub


'============================================================================
' imgClose_OnClick : 닫기
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Dim szData
	
	if g_szSelect <> "1" then
		'  전달내용/탭위치/종목코드/수량/대출일자/대출상세/신용합산여부/대출일련번호
		szData = "잔고" & "★" & g_szTab & "★★♥♥♥" & chk1.checkstate & "♥"
		Form.SendReturnToParent("12000_BALANCE", szData)
	end if
	
	Form.SaveConfigData("mbtrs15000", "balance1", chk1.checkstate )	'신용합산
	Form.SaveConfigData("mbtrs15000", "balance2", chk2.checkstate ) '비용반영
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	if chk1.checkstate = "1" then
			DATAMANAGER.RequestNextData( "obtrs_comn_329r" )
	Else
			DATAMANAGER.RequestNextData( "obtrs_comn_310r" )
	End If
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REUPDATE" then
		if sRet == "ok" then
			Form.reUpdateFile("mts_master.crc")
		else
			exit sub
		end if
	end if
End Sub
'============================================================================
Sub Button0_OnClick()
'	sMesg = "유상청약, 무상주식, 배당 등 권리행사로" & Chr(13) &"취득할 주식(결제일까지 상장되는 주식)을" & Chr(13) &"해당 권리종목의 상장일(D일) 전일과 2일전에" & Chr(13) &"수량이 합산되어 주문처리가 가능합니다." & Chr(13) &"단, 기존 보유주식과 권리입고예정주식을" & Chr(13) &"합산할 경우 평균 매입가 정보가 상이할 수" & Chr(13) &"있으니 유의하시기 바랍니다."
'	Form.ShowAlert("알림", sMesg)
'	Form.OpenPopup("mbtrs15000_ph" , "" , "")
	Form.OpenScreen("12070" , "")
End Sub
'============================================================================
Sub grdList_OnHeaderClickUp(lRow, szCellID)
	if g_Buffer = 1 then
	
		if szCellID = "th_cell2" then
			g_Toggle1 = g_Toggle1 + 1
			g_Toggle2 = 0
		
			if g_Toggle1 > 2 then
				g_Toggle1 = 0
			end if
	
			SetGridHeader(g_Toggle1, g_Toggle2)
		elseif szCellID = "th_cell8" then
			g_Toggle1 = 0
			g_Toggle2 = g_Toggle2 + 1
		
			if g_Toggle2 > 2 then
				g_Toggle2 = 0
			end if
		
			SetGridHeader(g_Toggle1, g_Toggle2)
		end if
	end if
	
	g_Buffer = 1
End Sub
'============================================================================
Sub SetGridHeader(g_Toggle1, g_Toggle2)
	if g_Toggle1 = 0 then
		grdList.SetCellTopCaption("th_cell2", "종목명")
	elseif g_Toggle1 = 1 then
		grdList.SetCellTopCaption("th_cell2", "종목명▼")
	else
		grdList.SetCellTopCaption("th_cell2", "종목명▲")
	end if
	
	if g_Toggle2 = 0 then
		grdList.SetCellTopCaption("th_cell8", "평가손익")
	elseif g_Toggle2 = 1 then
		grdList.SetCellTopCaption("th_cell8", "평가손익▼")
	else
		grdList.SetCellTopCaption("th_cell8", "평가손익▲")
	end if
	
End Sub

