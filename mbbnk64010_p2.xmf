'============================================================================
' 화 면 명 : 외화이체 이체가능보유통화
'============================================================================

Dim g_szACNO
Dim g_szASNO
Dim g_szCurrencyCode

Dim g_szSeparator

Dim g_nNextIdx
Dim g_TotalCnt
Dim g_szOutTransYN	'타행이체 가능여부

'============================================================================
Sub Form_OnFormInitBefore()    
	grdList.setMaintainingRatio( "bd_logo" , 0, "1")
	
	imgNoData.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	imgNoData.visible = false
	
	f_InitValue()
    
	szData = Form.GetOpenLinkData()
	
	If szData <> "" and szData <> null then
		arrBankInfo = Split(szData, g_szSeparator)
		
		g_szACNO         = arrBankInfo(0)
		g_szASNO         = arrBankInfo(1)
		g_szCurrencyCode = arrBankInfo(2)
				
		DATAMANAGER.RequestTranData("obrtd_fcur_001r")    '외화 잔액내역조회 
	end if
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbbnk64010_p2", "close")
End Sub

'============================================================================
Sub f_InitValue()

	g_szSeparator = "★"
	
	g_nNextIdx = 0
	g_TotalCnt = 0
	g_szOutTransYN = "Y"	'타행이체가능
	
	grdList.SetClear()

End Sub

'============================================================================
' 이체가능보유통화 건수가 4건 이하이면 팝업 사이즈는 가변
'                         4건 이상이면 그리드 스크롤
'============================================================================
Sub f_SetScreen()
	imgNoData.visible = false
	lblNoData.visible = false
	grdList.visible = true

	if g_szOutTransYN = "N" then	'티헹이체 불가
	
		if g_TotalCnt >= 4 then
		
			imgBG.top = 330
			imgBG.height = 350
			
			Label0.top = 345
			
			lblInfo.visible = true
			lblInfo.top = 400
			
			grdList.top = 445
			grdList.height = 180
			
		else
		
			''((그리드 맥스 카운트 - 조회된 전체 카운트) * 데이터 한 건의 그리드 높이)
			imgBG.top = 330 + ( ( 4 - g_TotalCnt ) * 45 )
			imgBG.height = 350 - ( ( 4 - g_TotalCnt ) * 45 )
			
			Label0.top = 345 + ( ( 4 - g_TotalCnt ) * 45 )
			
			lblInfo.visible = true
			lblInfo.top = 400 + ( ( 4 - g_TotalCnt ) * 45 )
			
			grdList.top = 445 + ( ( 4 - g_TotalCnt ) * 45 )
			grdList.height = 180 - ( ( 4 - g_TotalCnt ) * 45 )
		
		end if
		
	Elseif g_szOutTransYN = "Y" then	'타행이체 가능
	
		if g_TotalCnt >= 4 then
			
			'g_szOutTransYN = "Y" 인 경우는 g_TotalCnt 최대가 4개
			imgBG.top = 330 + 45
			imgBG.height = 350 - 45
			Label0.top = 345 + 45
			lblInfo.visible = false
			grdList.top = 400 + 45
			grdList.height = 225 - 45
		
		else
		
			''((그리드 맥스 카운트 - 조회된 전체 카운트) * 데이터 한 건의 그리드 높이) + 안내문구 높이
			imgBG.top = 330 + ( ( 4 - g_TotalCnt ) * 45 ) + 45
			imgBG.height = 350 - ( ( 4 - g_TotalCnt ) * 45 ) - 45
			Label0.top = 345 + ( ( 4 - g_TotalCnt ) * 45 ) + 45
			lblInfo.visible = false
			grdList.top = 400 + ( ( 4 - g_TotalCnt ) * 45 ) + 45
			grdList.height = 225 - ( ( 4 - g_TotalCnt ) * 45 ) - 45
			
		end if
		
	End if
	
End Sub

'============================================================================
Sub grdList_OnClickUp(lRow, szCellID) '내 계좌 그리드 선택

	szCurrencyCode = grdList.GetCellData("bd_cell1"     , lRow)
	szAmt          = grdList.GetCellData("bd_cell2"     , lRow)
		
	sPosInfo = szCurrencyCode & "★" & szAmt	
	Form.SendReturnToParent("mbbnk64010_p2", sPosInfo)
	Form.CloseForm()

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
    If szTranID == "obrtd_fcur_001r" Then
		DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "ACNO" , 0 , g_szACNO)
		DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "ASNO" , 0 , g_szASNO)		
	End if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	If szTranID == "obrtd_fcur_001r" Then
    
		nCnt = CDbl(DATAMANAGER.GetDataCount(0 , szTranID , "OutBlock1"))
		grdList.rowcount = nCnt		
		g_TotalCnt = nCnt

		if nCnt = 0 then
			''((그리드 맥스 카운트 - 조회된 전체 카운트) * 데이터 한 건의 그리드 높이) + 안내문구 높이
			imgBG.top = 465	'330 + ( ( 4 - 2 ) * 45 ) + 45
			imgBG.height = 215	'350 - ( ( 4 - 2 ) * 45 ) - 45
			Label0.top = 480	'345 + ( ( 4 - 2 ) * 45 ) + 45
			
			lblInfo.visible = false
			imgNoData.visible = true
			lblNoData.visible = true
			grdList.visible = false
			Exit Sub
		end if
		
		
		For i = 0 To nCnt - 1
		    CRCD               = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "CRCD"                         , i) ' 통화코드
		    CRCD_KORNAME       = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "CRCD_KOR_NAME"                , i) ' 통화코드한글명
		    FRCR_WTMN_ABLE_AMT = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ATMT_INVT_VLTN_ADUP_FRCR_AMT" , i) ' 자동투자평가합계외화금액
		    		    
		    grdList.setMaintainingRatio( "bd_logo" , g_nNextIdx, "1")
		    grdList.setMaintainingRatio( "bd_check" , g_nNextIdx, "1")
		    
		    
		    grdList.SetCellData("bd_logo",  g_nNextIdx , f_GetCurrencyImage(CRCD)  )	'통화코드별 이미지
		    grdList.SetCellData("bd_cell0", g_nNextIdx , CRCD_KORNAME              )
		    grdList.SetCellData("bd_cell1", g_nNextIdx , CRCD                      )
		    grdList.SetCellData("bd_cell2", g_nNextIdx , FRCR_WTMN_ABLE_AMT        )
		    if CRCD = g_szCurrencyCode then
			    grdList.SetCellData("bd_check", g_nNextIdx , "icon_check_on.png"        )
		    else
			    grdList.SetCellData("bd_check", g_nNextIdx , "alpha.png"        )
		    end if
		    
		    if CRCD = "USD" or CRCD = "JPY" or CRCD = "HKD" or CRCD = "CNY" then
				'이 통화만 타행이체 가능.
				
			Else
				'타행이체 불가.
				g_szOutTransYN = "N"
				
		    End if
		    
		    g_nNextIdx = g_nNextIdx + 1
		Next
		
	    f_SetScreen()
	End if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    szSubErr = Trim(DATAMANAGER.GetDataMsgSubText( szTranID ))

    If szSubErr == "" Then
        Form.MsgBox( "알림", szErrMsg, "", 6 )		
    Else
        Form.MsgBox( "알림", szErrMsg.."\n("..szSubErr..")", "", 6 )		
    End If
    
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	szNext = DATAMANAGER.IsMoreNextData("obrtd_fcur_001r")
	If szNext == "1" Or szNext == True Then
	    DATAMANAGER.RequestNextData("obrtd_fcur_001r")
	End If
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Function f_GetCurrencyImage(CurrencyCode)

	'통화코드별 이미지
	if CurrencyCode = "USD" then		'미국
		szImageName = "flag_us2.png"		
	elseif CurrencyCode = "JPY" then	'일본
		szImageName = "flag_jp2.png"
	elseif CurrencyCode = "HKD" then	'홍콩
		szImageName = "flag_hk.png"
	elseif CurrencyCode = "CNY" then	'중국
		szImageName = "flag_chn.png"
	elseif CurrencyCode = "EUR" then	'유로화
		szImageName = "flag_eu.png"
	elseif CurrencyCode = "GBP" then	'영국
		szImageName = "flag_uk.png"
	elseif CurrencyCode = "AUD" then	'호주
		szImageName = "flag_aus.png"
	elseif CurrencyCode = "SGD" then	'싱가폴
		szImageName = "flag_sgp.png"
	elseif CurrencyCode = "CAD" then	'캐나다
		szImageName = "flag_can.png"
	elseif CurrencyCode = "CHF" Then	'스위스
		szImageName = "flag_swi.png"
	else
		szImageName = "flag_general.png"
	end if
	
	return szImageName
	
End Function

