Sub imgDetail_OnClick()
	Form.SetEnvData(1, "OVRS_JANGO_TOP_EXPAND", g_bTopDetail)
	
	if g_bTopDetail then
		'상세보기상태에서 요약보기로 변경
		lblDetail.caption = "상세"
		g_bTopDetail = false
		
		imgDetail.imgpath = "icon_gray_down"
		
		Image0.height = 95
		tblHide.visible = false
		lblTop4.visible = false
		lblTop5.visible = false
		lblTop6.visible = false
		lblTop7.visible = false
		
		rdoGbn.top = 235 - 44 
		contBody.top = 270 - 44 
		contBody2.top = 270 - 44 
		
		contClick.top = 235 - 44 
	else
		'요약보기상태에서 상세보기로 변경
		lblDetail.caption = "접기"
		g_bTopDetail = true

		imgDetail.imgpath = "icon_gray_up"
		
		Image0.height = 138
		tblHide.visible = true
		lblTop4.visible = true
		lblTop5.visible = true
		lblTop6.visible = true
		lblTop7.visible = true
		
		rdoGbn.top = 235 
		contBody.top = 270 
		contBody2.top = 270 
		
		contClick.top = 235 
	end if
End Sub

