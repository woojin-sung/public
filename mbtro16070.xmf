'============================================================================
Sub Form_OnFormInit()
	f_InitValue()
	Init_Control()
	g_NextCnt = 0
	contBody.setUseAdjustScroll(true)
	contBody.lblToggle.paddinginfo = "15,0,0,0"
	
	'v001
	g_szUserID = Form.GetSharedData("&USER_ID", false )	
	scrNo = Form.GetSharedData("&SCREEN_NO", false )
	g_szCustNum = Form.GetSharedData("&CUST_NUM", false )
	
	'v002
	
'	Form.SetCtlProp("ImgDytmCheck", "imgpath", "check_off")	
	g_szCrCd = Form.GetEnvData("OVRS_JANGO_NATION")
	g_szCrCdNm = Form.GetEnvData("OVRS_JANGO_NATION_NM")
	
	if g_szCrcd == "" then
		g_szCrCd = "000" 
		g_szCrCdNm = "전체"
		
		Form.SetEnvData("1", "OVRS_JANGO_NATION", g_szCrCd)
		Form.SetEnvData("1", "OVRS_JANGO_NATION_NM", g_szCrCdNm)
	end if
	
	lblCrCd.caption = g_szCrCd		

	if g_szCrCd == "000" or g_szCrCd == "" then
		lblCrCdNm.caption = "총 외화자산"
		
		nTxtWidth = Form.getTextWidth("총 외화자산", 2, true, false)
		
		imgSearch.left = 15 + nTxtWidth + 7
		
	else
		arrCrcdNm = split(g_szCrCdNm, "@") 
		nArrCnt = #arrCrcdNm
		
		nTxtWidth = Clng(Form.getTextWidth("총 외화자산 ", 2, true, false))

		if nArrCnt == 1 then
			lblCrCdNm.caption = "총 외화자산 (" & g_szCrCdNm & ")"
			nTxtWidth = nTxtWidth +  Clng(Form.getTextWidth("(" & g_szCrCdNm & ")", -2, true, false))
		else
			lblCrCdNm.caption = "총 외화자산 (" &arrCrcdNm(0) & " 외 " & nArrCnt-1 & ")"
			nTxtWidth = nTxtWidth +  Clng(Form.getTextWidth("(" &arrCrcdNm(0) & " 외 " & nArrCnt-1 & ")", -2, true, false))
		end if
		
		nTxtLen = Form.getLen(lblCrCdNm.caption)

		lblCrCdNm.changeTextAttr(6, nTxtLen-6, 333, -2, true)
		
		imgSearch.left = 15 + nTxtWidth + 7
	end if


	'20190924 HWG START : 예수금화면 연동버튼  추가 
	szFlg = Form.GetOpenLinkData()	
	if szFlg == "orderStock" or scrNo = "16071" then
		rdoGbn.currentindex = 1
	else	
		rdoGbn.currentindex = 0
	end if 
	'20190924 HWG END

	imgDetail_OnClick()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'20220704 ITGEN START
	' 유의팝업 추가
	'20220704 ITGEN END
	
	if sEventName = "SCREEN_MENU" then
		if sParam = "Show_NotiPopup" then
			Form.OpenPopup("mhtro16060_p13" , "" , "")
		end if
		
'	elseif sEventName = "REFRESH_DATA" then
'		lblTop0.caption = sParam
'		
'		nVltn = Cdbl(sParam)
'
'		nBuyTot = CDbl(lblTop1.caption)
'		nCrcdTot = CDbl(lblTop4.caption)
'		ntemp  = CDbl(lblTop6.caption)
'		
'		nVltnCamt = nVltn - nBuyTot
'		nVltnRate = (nVltnCamt / nBuyTot) * 100
'		
'		lblTop2.caption = nVltnCamt
'		lblTop3.caption = nVltnRate
'		
'		Table1.SetCellString(1, 0, nVltn + nCrcdTot - ntemp)
	elseif sEventName = "DAY_JONGA" then
		g_szDytmYN = sParam
		
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_265r", "InBlock1", "ACNO"                 , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_265r", "InBlock1", "ASNO"                 , 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_265r", "InBlock1", "DYTM_TR_CLPR_APLY_YN" , 0 , g_szDytmYN)
		
		szChk0 = "N"
		szChk1 = "N"
		szChk2 = "N"
		szChk3 = "1"
		
		if contBody.chk0.checkstate == "1" or CInt(contBody.chk0.checkstate) == 1 then '비용포함
			szChk0 = "Y"
		else
			szChk0 = "N"
		end if
			
		if contBody.chk1.checkstate == "1" or CInt(contBody.chk1.checkstate) == 1 then '대출합산
			szChk1 = "2"
		else
			szChk1 = "1"
		end if
	
		if contBody.chk2.checkstate == "1" or CInt(contBody.chk2.checkstate) == 1 then '정규종가
			szChk2 = "N"
		else
			szChk2 = "Y"
		end if

		
		DATAMANAGER.SetDataValue(0, "obtro_oder_265r", "InBlock1", "FEE_INCU_YN"	  , 0 , 			szChk0)
		DATAMANAGER.SetDataValue(0, "obtro_oder_265r", "InBlock1", "DYTM_TR_CLPR_APLY_YN", 0 , 	szChk2) 
		
		DATAMANAGER.SetDataValue(0,"obtro_oder_265r", "InBlock1", "IQRY_CLS_CODE" , 0 , 	szChk1) 'v004
		DATAMANAGER.SetDataValue(0,"obtro_oder_265r", "InBlock1", "UI_IQRY_COND_CNTT" , 0 , g_szCrCd) 'v004
	
		
		DATAMANAGER.RequestTranData("obtro_oder_265r")
	elseif sEventName = "CLICK_SETTING" then
		Form.OpenPopupAnimation("mbtro16070_p3" , "" , "","2")
	elseif sEventName = "INFO_CLICK" then
		Form.OpenPopup("mbtro16070_p0" , "" , "")
	end if
End Sub

'============================================================================
Sub f_InitValue()

	g_szCrCd = "000"
	g_szCrCdNm = "전체"

	lblCrCd.caption = g_szCrCd		
	lblCrCdNm.caption = "총 외화자산"
	
	nTxtWidth = Clng(Form.getTextWidth("총 외화자산", 2, true, false))
	imgSearch.left = 15 + nTxtWidth + 7
	
End Sub

'============================================================================
Sub Call_Tran()
	Form.SetTimerEvent(1, 0, 0)
	
	g_szAcno = left(acnt1.caption,8)
	g_szAsno = right(acnt1.caption,2)
	
	DATAMANAGER.SetDataValue(0, "obtro_oder_265r", "InBlock1", "ACNO"                 , 0 , g_szAcno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_265r", "InBlock1", "ASNO"                 , 0 , g_szAsno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_265r", "InBlock1", "DYTM_TR_CLPR_APLY_YN" , 0 , g_szDytmYN)
	
	szChk0 = "N"
	szChk1 = "N"
	szChk2 = "N"
	szChk3 = "1"
	
	if contBody.chk0.checkstate == "1" or CInt(contBody.chk0.checkstate) == 1 then '비용포함
		szChk0 = "Y"
	else
		szChk0 = "N"
	end if
		
	if contBody.chk1.checkstate == "1" or CInt(contBody.chk1.checkstate) == 1 then '대출합산
		szChk1 = "2"
	else
		szChk1 = "1"
	end if

	if contBody.chk2.checkstate == "1" or CInt(contBody.chk2.checkstate) == 1 then '정규종가
		szChk2 = "N"
	else
		szChk2 = "Y"
	end if

	
	DATAMANAGER.SetDataValue(0, "obtro_oder_265r", "InBlock1", "FEE_INCU_YN"	  , 0 , 			szChk0)
	DATAMANAGER.SetDataValue(0, "obtro_oder_265r", "InBlock1", "DYTM_TR_CLPR_APLY_YN", 0 , 	szChk2) 
	
	DATAMANAGER.SetDataValue(0,"obtro_oder_265r", "InBlock1", "IQRY_CLS_CODE" , 0 , 	szChk1) 'v004
	DATAMANAGER.SetDataValue(0,"obtro_oder_265r", "InBlock1", "UI_IQRY_COND_CNTT" , 0 , g_szCrCd) 'v004
	
	DATAMANAGER.RequestTranData("obtro_oder_265r")
	
	contBody.grd0.SetClear()
	
	'v002
	if Cint(rdoGbn.currentindex) = 0 then
'		'해외주식잔고 TAB
		contBody.visible = true
		contBody2.visible = false
		DisplaySetting_Grid()
		Request_Tran_obtro_comn_010r()
		
	elseif Cint(rdoGbn.currentindex) = 1 then
		contBody.visible = false
		contBody2.visible = true
		'외화예수금 TAB
		Request_Tran_obtro_oder_266r()
	else
		Form.ShowAlert("Error", "유효하지않은 탭입니다.")
		exit sub
	end if
End Sub

