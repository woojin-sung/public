'==============================================
' 컨트롤 초기설정
'==============================================
Function Init_Control()
	contClick.lblClick0.fgcolor = g_szTxtColor_Grey
	contClick.lblClick1.fgcolor = g_szTxtColor_Grey
	contClick.lblClick2.fgcolor = g_szTxtColor_Grey
	
	contClick.lblGuide0.bgcolor = g_szTxtColor_Grey
	contClick.lblGuide1.bgcolor = g_szTxtColor_Grey
	
	imgRefresh.maintainratio = "1"
	imgRefresh.imgpath = "icon_refresh"
	
	szData = Form.GetEnvData("OVRS_JANGO_STANDARD_GBN")
	
	if szData <> "" and szData <> null then
		g_nViewMode = Cint(szData)
		
		if g_nViewMode = 1 then
			contBody.imgToggle.imgpath = "toggle_2dots_03.9.png"
			contBody.lblToggle.caption = "원화"
		else
			contBody.imgToggle.imgpath = "toggle_2dots_02.9.png"
			contBody.lblToggle.caption = "외화"
		end if
	end if
	
	contBody.gesture = true
	contBody2.gesture = true
	
	szReal = Form.GetEnvData("OVRS_REAL_JANGO")
	if szReal == "" then
		Form.SetEnvData("1", "OVRS_REAL_JANGO", "1")
		szReal = "1"
	end if

	if szReal == "1" then
		g_isReal = true
	else
		g_isReal = false
	end if
	
	g_szSortIdx = Cint(Form.GetEnvData("OVRS_JANGO_SORT_IDX"))
	g_szSortHeader = Form.GetEnvData("OVRS_JANGO_SORT_HEADER")
	
	if g_szSortHeader == "" then
		g_szSortHeader = "th_cell01"
		g_szSortIdx = 2
		Form.SetEnvData(1, "OVRS_JANGO_SORT_HEADER", g_szSortHeader)
		Form.SetEnvData(1, "OVRS_JANGO_SORT_IDX", g_szSortIdx)
	end if
	

	szDetail = Form.GetEnvData("OVRS_JANGO_TOP_EXPAND")
	if szDetail == "" then
		Form.SetEnvData("1", "OVRS_JANGO_TOP_EXPAND", "1")
		szDetail = "1"
	end if

	if szDetail == "1" then
		g_bTopDetail = true
	else
		g_bTopDetail = false
	end if
	
	
	lblTop0.paddinginfo = "0,0,0,0"
	lblTop1.paddinginfo = "0,0,0,0"
	lblTop2.paddinginfo = "0,0,0,0"
	lblTop3.paddinginfo = "0,0,0,0"
	lblTop4.paddinginfo = "0,0,0,0"
	lblTop5.paddinginfo = "0,0,0,0"
	lblTop6.paddinginfo = "0,0,0,0"
	lblTop7.paddinginfo = "0,0,0,0"

	if g_isReal == true then
		contBody.chk0.checkstate = 0
		Form.SetEnvData("1", "OVRS_JANGO_CHK_1", "0")
		contBody.chk0.visible = false
		
		contBody.chk1.left = 10
		contBody.chk2.left = 100
	else
		contBody.chk0.visible = true
		
		contBody.chk1.left = 100
		contBody.chk2.left = 190
	end if
	
	g_szDytmYN = "Y"
	
	szChk1 =  Form.GetEnvData("OVRS_JANGO_CHK_1")
	szChk2 =  Form.GetEnvData("OVRS_JANGO_CHK_2")
	szChk3 =  Form.GetEnvData("OVRS_JANGO_CHK_3")
	
	contBody.chk0.checkstate = szChk1
	contBody.chk1.checkstate = szChk2
	contBody.chk2.checkstate = szChk3

	contBody2.grdDeposit.visible = False
	contBody2.Pannel0.visible = True
	
	g_nNextIdx = 0
	g_nGridIndex = 0 
	contBody2.Pannel0.rowcount = 0
	
	contBody2.imgNoData.visible = false
	contBody2.lblNoData.visible = false
	
	contBody.imgNoData.visible = false
	contBody.lblNoData.visible = false
	
	nWidth = Form.getTextWidth(contBody2.lblTitle.caption, 0, true, false)
	contBody2.imgTooltip.left = 10 + nWidth + 7
	
	contBody.grd0.setEnableScroll(false)
	contBody2.grdDeposit.setEnableScroll(false)
	contBody2.Pannel0.setEnableScroll(false)
	
	contBody2.lblGuideLine0.bgcolor = "220220220"
End Function

Function DisplaySetting_Grid()
	sMaskInfo_1 = ""
	sMaskInfo_2 = ""
	
	if g_nViewMode == 1 then
		sMaskInfo_1 = sMaskInfo_1 & "0,"	'숫자:0 문자:1
		sMaskInfo_1 = sMaskInfo_1 & "1,"	'0 보이지 않기 
		sMaskInfo_1 = sMaskInfo_1 & ","		'앞첨자
		sMaskInfo_1 = sMaskInfo_1 & ","		'뒷첨자
		sMaskInfo_1 = sMaskInfo_1 & "0,"	'문자열 마스크
		sMaskInfo_1 = sMaskInfo_1 & ","		'문자열 마스크
		sMaskInfo_1 = sMaskInfo_1 & "0,"	'소숫점 자릿수
		sMaskInfo_1 = sMaskInfo_1 & "1,"	'천단위 부호
		sMaskInfo_1 = sMaskInfo_1 & "1"		'마이너스 부호 
		
		sMaskInfo_2 = sMaskInfo_2 & "0,"	'숫자:0 문자:1
		sMaskInfo_2 = sMaskInfo_2 & "1,"	'0 보이지 않기 
		sMaskInfo_2 = sMaskInfo_2 & ","		'앞첨자
		sMaskInfo_2 = sMaskInfo_2 & ","		'뒷첨자
		sMaskInfo_2 = sMaskInfo_2 & "0,"	'문자열 마스크
		sMaskInfo_2 = sMaskInfo_2 & ","		'문자열 마스크
		sMaskInfo_2 = sMaskInfo_2 & "0,"	'소숫점 자릿수
		sMaskInfo_2 = sMaskInfo_2 & "1,"	'천단위 부호
		sMaskInfo_2 = sMaskInfo_2 & "1"		'마이너스 부호 
	else
		sMaskInfo_1 = sMaskInfo_1 & "0,"	'숫자:0 문자:1
		sMaskInfo_1 = sMaskInfo_1 & "1,"	'0 보이지 않기 
		sMaskInfo_1 = sMaskInfo_1 & ","		'앞첨자
		sMaskInfo_1 = sMaskInfo_1 & ","		'뒷첨자
		sMaskInfo_1 = sMaskInfo_1 & "0,"	'문자열 마스크
		sMaskInfo_1 = sMaskInfo_1 & ","		'문자열 마스크
		sMaskInfo_1 = sMaskInfo_1 & "4,"	'소숫점 자릿수
		sMaskInfo_1 = sMaskInfo_1 & "1,"	'천단위 부호
		sMaskInfo_1 = sMaskInfo_1 & "1"		'마이너스 부호 
		
		sMaskInfo_2 = sMaskInfo_2 & "0,"	'숫자:0 문자:1
		sMaskInfo_2 = sMaskInfo_2 & "1,"	'0 보이지 않기 
		sMaskInfo_2 = sMaskInfo_2 & ","		'앞첨자
		sMaskInfo_2 = sMaskInfo_2 & ","		'뒷첨자
		sMaskInfo_2 = sMaskInfo_2 & "0,"	'문자열 마스크
		sMaskInfo_2 = sMaskInfo_2 & ","		'문자열 마스크
		sMaskInfo_2 = sMaskInfo_2 & "2,"	'소숫점 자릿수
		sMaskInfo_2 = sMaskInfo_2 & "1,"	'천단위 부호
		sMaskInfo_2 = sMaskInfo_2 & "1"		'마이너스 부호 
	end if
	
	contBody.grd0.SetCellMaxLineCount("bd_cell01", "2")
	
	contBody.grd0.setCellIDMaskInfo("bd_cell05", sMaskInfo_1)	'현재가
	contBody.grd0.setCellIDMaskInfo("bd_cell55", sMaskInfo_1)	'매입가
	
	contBody.grd0.setCellIDMaskInfo("bd_cell06", sMaskInfo_2)	'평가손익
	
	contBody.grd0.setCellIDMaskInfo("bd_cell07", sMaskInfo_2)	'평가금액
	contBody.grd0.setCellIDMaskInfo("bd_cell57", sMaskInfo_2)	'매입금액
	
	contBody.grd0.setCellIDMaskInfo("bd_cell09", sMaskInfo_2)	'대출금액
	
	contBody.grd0.setCellIDMaskInfo("bd_cell12", sMaskInfo_2)	'매수수수료
	contBody.grd0.setCellIDMaskInfo("bd_cell62", sMaskInfo_2)	'매도수수료
	
	contBody.grd0.setCellIDMaskInfo("bd_cell13", sMaskInfo_2)	'제세금
	contBody.grd0.setCellIDMaskInfo("bd_cell63", sMaskInfo_2)	'신용이자
	
	contBody.grd0.setCellIDMaskInfo("bd_cell14", sMaskInfo_2)	'매수수수료
	contBody.grd0.setCellIDMaskInfo("bd_cell64", sMaskInfo_2)	'신용이자
End Function

'============================================================================
Function Transform_Exid2(sValue)
	if sValue = "HK" then
		Transform_Exid2 = "HKS"
		exit Function
	elseif sValue = "SH" then
		Transform_Exid2 = "SHS"
		exit Function
	elseif sValue = "SZ" then
		Transform_Exid2 = "SZS"
		exit Function
	elseif sValue = "NY" then
		Transform_Exid2 = "NYS"
		exit Function
	elseif sValue = "AX" then
		Transform_Exid2 = "AMX"
		exit Function
	elseif sValue = "OQ" then
		Transform_Exid2 = "NAS"
		exit Function
	elseif sValue = "JP" then
		Transform_Exid2 = "TSE"
		exit Function		
	end if
End Function

Function Calc_Data()

	nVltn_Won_Total = 0
	for i = 0 to contBody.grd0.rowcount-1
		'잔고수량
		szAmt  = replace(contBody.grd0.GetCellData("bd_cell04", i),",","")
		
		'현재가(외화)
		szHyun = replace(contBody.grd0.GetCellData("bd_cell71", i),",","")
		
		'매입금액 
		szPurchaseAmt = replace(contBody.grd0.GetCellData("bd_cell57", i),",","")
		
		'기준환율
		stnd_exrt	= replace(contBody.grd0.GetCellData("bd_cell15", i), ",", "")	
		
'		if i == 1 then
'			msgbox szAmt .. "|" .. szHyun .. "|" .. szPurchaseAmt .. "|" .. stnd_exrt
'		end if
		
		'1.평가금액 구하기 
		'- 외화평가금액 : 현재가(외화) * 잔고수량 -> 소수점 2자리 절삭
		'- 원화환산 : 평가금액(외화) * 기준환율 -> 소수점 0자리 절삭 
		nVltn = truncateToDecimalPlaces(Cdbl(szAmt) * Cdbl(szHyun), 2)
		nVltn_Won = truncateToDecimalPlaces(nVltn * Cdbl(stnd_exrt), 0)
		nVltn_Won_Total = nVltn_Won_Total + nVltn_Won
		
		nVltn_Stnd = 0
		
		'외화
		if g_nViewMode == 0 then
			nVltn_Stnd = nVltn
			
		'원화
		elseif g_nViewMode == 1 then
			nVltn_Stnd = nVltn_Won
			
		end if
		contBody.grd0.SetCellData("bd_cell07", i, nVltn_Stnd)
		
		'2.평가손익 구하기
		'- 평가금액 - 매입금액
		nVltn_Camt = nVltn_Stnd - Cdbl(szPurchaseAmt)
		contBody.grd0.SetCellData("bd_cell06", i, nVltn_Camt)
		
		'3.손익률 구하기
		'- 평가금액 / 매입금액 * 100 -> 소숫점 5자리 반올림
		nVltn_Rate = round(nVltn_Camt / Cdbl(szPurchaseAmt) * 100, 5)
		contBody.grd0.SetCellData("bd_cell56", i, nVltn_Rate)
	next
	
	'해외주식 평가금액 세팅
	lblTop0.caption = nVltn_Won_Total
	
	'매입금액
	nPurchaseAmt 	= CDbl(lblTop1.caption)
	'추정예수금
	nDeposit 	= CDbl(lblTop4.caption)
	'대출금액
	nLoanAmt 	= CDbl(lblTop6.caption)
	
	'평가손익 
	'해외주식평가금액 - 추정예수금
	nVltn_Camt = nVltn_Won_Total - nPurchaseAmt
	
	'손익률
	'평가금액 / 매입금액 * 100 -> 소숫점 5자리 반올림
	nVltn_Rate = round(nVltn_Camt / nPurchaseAmt * 100, 5)

	lblTop2.caption = nVltn_Camt
	lblTop3.caption = nVltn_Rate
	
	'총평가금액
	'해외주식 평가금액 + 추정예수금 - 대출금액
	Table1.SetCellString(1, 0, nVltn_Won_Total + nDeposit - nLoanAmt)
End Function

Function truncateToDecimalPlaces(nVal, nDeimalPlaces)
	nFactor = 10 ^ nDeimalPlaces
	return int(nVal*nFactor+0.00000000001) / nFactor
End Function

'==============================================
' 장운영정보 조회
'==============================================
Function Request_Tran_obtro_comn_010r()
	
	DATAMANAGER.ClearInputData(false, "obtro_comn_010r")
	
	DATAMANAGER.SetDataValue( false, "obtro_comn_010r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE"	, 0 , "01" )	
	
	DATAMANAGER.RequestTranData("obtro_comn_010r")
End Function

Function Process_Tran_obtro_comn_010r()
	
	g_szMktOpClsCd = DATAMANAGER.GetDataValue(false, "obtro_comn_010r", "OutBlock1", "OVRS_MKOP_CLS_CODE" , 0)
	
	if g_szMktOpClsCd == "001" then
		contBody.chk2.visible = true
	else
		contBody.chk2.checkstate = 0
		contBody.chk2.visible = false
	end if
	
	RequestData()
End Function

Function Request_Tran_obtro_oder_266r()

	
	contBody2.Pannel0.rowcount = 0
	DATAMANAGER.ClearInputData(false, "obtro_oder_266r")
	
	DATAMANAGER.SetDataValue(0, "obtro_oder_266r", "InBlock1", "ACNO" 		  , 0 , g_szAcno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_266r", "InBlock1", "ASNO" 		  , 0 , g_szAsno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_266r", "InBlock1", "UI_IQRY_COND_CNTT", 0 , g_szCrCd)
	DATAMANAGER.SetDataValue(0, "obtro_oder_266r", "InBlock1", "DYTM_TR_CLPR_APLY_YN", 0 , g_szDytmYN)
		
	DATAMANAGER.RequestTranData("obtro_oder_266r")
End Function

Function Process_Tran_obtro_oder_266r()
	
	nCnt	= CDBL(DATAMANAGER.GetDataCount(0, "obtro_oder_266r" , "OutBlock1"))
	
	If nCnt = 0 then
		contBody2.imgNoData.visible = true
		contBody2.lblNoData.visible = true
		Exit Function
	Else
		contBody2.imgNoData.visible = false
		contBody2.lblNoData.visible = false

		if g_nViewMode2 = 0 then
			contBody2.grdDeposit.visible = False
			contBody2.Pannel0.visible = True
		else		
			contBody2.grdDeposit.visible = True
			contBody2.Pannel0.visible = False
		end if			
	End if


	For i = 0 To nCnt - 1
		szCRCD        = DATAMANAGER.GetDataValue(0, "obtro_oder_266r", "OutBlock1", "CRCD", i)	'통화코드
		
		szVLTN_EXRT      = DATAMANAGER.GetDataValue(0, "obtro_oder_266r", "OutBlock1", "VLTN_EXRT", i)	'평가환율
					
		szFRCR_AMT2      = DATAMANAGER.GetDataValue(0, "obtro_oder_266r", "OutBlock1", "UI_FRCR_AMT", i)	'외화추정예수금
		szWNCR_VLTN_AMT2 = DATAMANAGER.GetDataValue(0, "obtro_oder_266r", "OutBlock1", "EXCL_WNCR_VLTN_AMT", i)	'원화평가금액
		
		nIdx = contBody2.Pannel0.AddRow()
		szFlag = Form.getIconImg("CRCD", szCRCD)
		if szFlag = "" then
			szFlag = "flag_general"
		end if
		
		contBody2.grdDeposit.setMaintainingRatio("bd_cell8", nIdx, "1")
		contBody2.grdDeposit.setCellImage("bd_cell8", nIdx, szFlag)
		
		contBody2.grdDeposit.SetCellData("bd_cell10", nIdx, ">")
		
		
		contBody2.Pannel0.setPropCardCell("bgcolor","lblGuideLine1",nIdx,"230230230")
		contBody2.Pannel0.setPropCardCell("maintainratio","imgCRCD",nIdx,"2")
		contBody2.Pannel0.SetCellValue( "imgCRCD",    nIdx, szFlag ) 	
		
		contBody2.Pannel0.SetCellValue( "lblCRCD",    nIdx, Form.getMetaData("통화코드", szCRCD) ) 			
		contBody2.Pannel0.SetCellValue( "lblExRate",   nIdx, "환율 " .. FormatNumber(szVLTN_EXRT, 2)    ) 
		
		contBody2.Pannel0.SetCellValue( "lblFrAmt",   nIdx, FormatNumber(szFRCR_AMT2, 2) .. " " .. szCRCD  ) 
		contBody2.Pannel0.SetCellValue( "lblAmt",     nIdx, FormatNumber(szWNCR_VLTN_AMT2, 0) .. " " .. "원") 
		
		g_nGridIndex = CInt(g_nGridIndex) + 1
	Next
	
End Function


'============================================================================
Function Transform_Exid(sValue)
	if sValue == "0537" then ' 나스닥
		return "OQ"
	elseif sValue == "0321" then ' 뉴욕
		return "NY"
	elseif sValue == "0066" then ' 아멕스
		return "AX"
	elseif sValue == "0215" then ' 상해
		return "SH"
	elseif sValue == "0214" then ' 심천
		return "SZ"
	elseif sValue == "0104" then ' 홍콩
		return "HK"
	elseif sValue == "0106" then ' 일본
		return "JP"
	else
		return ""
	end if
end Function



'============================================================================
Function OpenMovePopup(nIndex)

	'--------------------------------------------
	'무브팝업 화면에 넘겨줄 데이터 가져옴
	'--------------------------------------------
	listLocation =  Split(contBody.grd0.location,":")
	
'	if Cint(contBody.top) > 50 then
'		nYPos = Int(listLocation[1]) - 110
'		nHeight = listLocation[3]
'	else
		nYPos = Int(listLocation[1])
		nHeight = listLocation[3]
'	end if
	
	sIndex 		= nIndex
	sName 		= contBody.grd0.GetCellData("bd_cell01", nIndex)
	sCode 		= contBody.grd0.GetCellData("bd_cell16", nIndex)
	sVndrCode 	= contBody.grd0.GetCellData("bd_cell66", nIndex)
	
	szOffChk = Transform_Exid(sVndrCode)
	if szOffChk == "" then
		Form.ShowAlert("알림", "해당 종목은 온라인에서\n거래가 불가합니다.\n\n영업점 또는 해외주식 데스크로 문의해주세요")
		Exit Function
	end if
	szData = "OVRS_ODER_JANGO" & "★" & nYPos & "★" & nHeight & "★" & sIndex & "★" & sName & "★" & sCode & "★" & sVndrCode 
	
	'--------------------------------------------
	'무브팝업 오픈
	'--------------------------------------------
	Form.OpenPopup("mhtro16100_movepopup" , szData , "")
	

End Function

'============================================================================
' 무브팝업 연결화면 이동
'============================================================================
Function MoveScreen(sGubun,sIndex)

	Dim nIndex
	nIndex = Cint(sIndex)
	
	szOnlineYN = contBody.grd0.GetCellData("bd_cell0", sIndex) 
	
	if szOnlineYN == "N" then
		Form.MsgBox("안내", "해당 종목은 온라인에서 거래가 불가합니다.\n영업점 또는 해외주식 데스크로 문의해주세요", "OnLineCheck", 6)
		Exit Function
	end if
	
	Form.SetSharedData("16070_JANGO_INDEX" , sIndex)
	szItemCode 	= contBody.grd0.GetCellData("bd_cell21", sIndex) 
	szName 		= contBody.grd0.GetCellData("bd_cell01", sIndex) 
	sJangoGubun	= contBody.grd0.GetCellData("bd_cell68", sIndex) 
	sOrdAbleQty 	= contBody.grd0.GetCellData("bd_cell54", nIndex)
	sLoanType	= contBody.grd0.GetCellData("bd_cell23", nIndex)
	sLoanDate	= contBody.grd0.GetCellData("bd_cell24", nIndex)
	sLoanSrno	= contBody.grd0.GetCellData("bd_cell25", nIndex)

'	showalert  szItemCode .. "|" .. szName .. "|" .. sJangoGubun .. "|" .. sOrdAbleQty .. "|" .. sLoanType .. "|" .. sLoanDate .. "|" .. sLoanSrno
	Form.SetSharedData( "&ITEM_CODE" , szItemCode)
	Form.SetSharedData( "&ITEM_KORNAME" , szName  )	
	Form.SetSharedData( "&ITEM_OVERSTOCK", szItemCode.."★"..szName.."★".."", "" )			
	Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szItemCode.."★"..szName.."★".."", "" )
	
	'------------------------------------
	' [현재가] : 종목연동
	'------------------------------------
	if sGubun == "MOVE_HYUN" then
		if szItemCode <> "" then
			Form.OpenScreen("16000", "")	
		end if
	
	'------------------------------------
	' [차트] : 종목연동
	'------------------------------------
	elseif sGubun == "MOVE_CHART" then
		if szItemCode <> "" then
			Form.OpenScreen("16020", "")
		end if
	
	'------------------------------------
	' [매수] : 종목연동
	'------------------------------------
	elseif sGubun == "MOVE_MAESU" then
		'--------------------------------------------
		'소수점 잔고일 경우 소수점 주문화면으로 연동
		'--------------------------------------------
		if sJangoGubun == "03" then
			if szItemCode <> "" then
				szData = szItemCode & "★" & szName & "♥" & "0" & "♥" & "" & "♥" & "" & "♥" & "0000" & "♥" & "0" & "♥" & "00000000000"
				Form.OpenScreen("16092" , szData)
			end if
		
		'--------------------------------------------
		' 일반/대출 잔고일 경우 매수탭으로 연동
		'--------------------------------------------
		else
			if szItemCode <> "" then
				Form.OpenScreen("16060", "0")
			end if
			
		end if
		
	'------------------------------------
	' [매도] : 종목연동 / 매도가능수량 연동
	'------------------------------------
	elseif sGubun == "MOVE_MAEDO" then
		'---------------------------------------------------------------------------------------
		' 연동수량(주문가능수량) 천단위부호(,) 제거
		' 그리드에 있는 주문가능수량 데이터는 일반잔고/소수점 잔고의 수량을 
		' 표시하기 위해 문자형으로 세팅되어있음. 그대로 값을 가져오면 천단위 부호도 같이 넘어옴.
		' 넘어온 데이터를 그대로 천단위 부호까지 같이 넘기면
		' 안드로이드에서 천단위 부호 중복해서 보이는 현상 발생.
		'---------------------------------------------------------------------------------------
		sOrdAbleQty = replace(sOrdAbleQty,",","")
		
		'--------------------------------------------
		'소수점 잔고일 경우 소수점 주문화면으로 연동
		'--------------------------------------------
		if sJangoGubun == "03" then
		
			if szItemCode <> "" then
				szData = szItemCode & "★" & szName & "♥" & "1" & "♥" & "" & "♥" & "" & "♥" & "0000" & "♥" & "0" & "♥" & "00000000000"
				Form.OpenScreen("16092" , szData)
			end if
		
		'--------------------------------------------
		' 일반/대출 잔고일 경우 매도탭으로 연동
		'--------------------------------------------
		else
			
			if szItemCode <> "" then
				szData = szItemCode & "★" & szName & "♥" & "1" & "♥" & sOrdAbleQty & "♥" & sLoanDate & "♥" & sLoanType & "♥" & "0" & "♥" & sLoanSrno
				
				'--------------------------------------------
				' 현재 해외주식 신용합산 주문이 불가하므로,
				' 대출일 경우 대출합산 체크 여부 확인하여
				' 체크되어있으면 주문불가 안내팝업 발생
				'--------------------------------------------
				if sJangoGubun == "02" then
				
					nCheckHabsan = Cint(contBody.chk1.checkstate)
					
					if nCheckHabsan == 1 then
						Form.MsgBox("안내", "합산 주문이 불가합니다.\n대출합산 해지 후 매도를 진행해주세요.", "MOVEPOPUP_CHECK_HABSAN", 6)
						Exit Function
					end if
					
				end if
				
				Form.OpenScreen("16060", szData)
			
			end if
			
		end if
	
	end if

End Function
