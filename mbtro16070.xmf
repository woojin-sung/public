Sub contBody_OnGestureEvent(sParam)
	nRowCnt = Cint(contBody.grd0.rowcount)

	if sParam = "Up" then
		if nRowCnt < 5 then
			Exit Sub
		end if
	
		contBody.fixTopAreaWhenScrolling(true, 55, "Up")
	elseif sParam = "Down" then
		contBody_OnScrollTop()
	end if
End Sub

Sub contBody2_OnGestureEvent(sParam)
	if sParam = "Up" then
		nRowCnt = 0
		if g_nViewMode2 == 1 then
		
			nRowCnt = Cint(contBody2.grdDeposit.rowcount)
			
			if nRowCnt < 7 then
				Exit Sub
			end if
		else
			nRowCnt = Cint(contBody2.Pannel0.rowcount)
			
			if nRowCnt < 4 then
				Exit Sub
			end if
		end if
	
		contBody2.fixTopAreaWhenScrolling(true, 55, "Up")
	elseif sParam = "Down" then
		contBody2_OnScrollTop()
	end if
End Sub
'
Sub contBody_OnScrollTop()
	nrow = -1
	nrow = Cint(contBody.grd0.toprow)
	if nrow == 0 then
		if g_bTopDetail then
			contBody.fixTopAreaWhenScrolling(true, 270, "Down")
		else
			contBody.fixTopAreaWhenScrolling(true, 270 - 44, "Down")
		end if
	end if
End Sub

Sub contBody2_OnScrollTop()
	nrow = -1
	nRowCnt = 0
	if g_nViewMode2 == 1 then
		nrow = Cint(contBody2.grdDeposit.toprow)
		nRowCnt = Cint(contBody2.grdDeposit.rowcount)
	else
		nrow = Cint(contBody2.Pannel0.toprow)
		nRowCnt = Cint(contBody2.Pannel0.rowcount)
	end if

	
	if nrow == 0 then
		if g_bTopDetail then
			contBody2.fixTopAreaWhenScrolling(true, 270, "Down")
		else
			contBody2.fixTopAreaWhenScrolling(true, 270 - 44, "Down")
		end if
	end if
End Sub

Sub contBody_OnAnimationStart(sParam, sParam2)
	if sParam = "Down" then
		contBody.grd0.setEnableScroll(false)
	end if
End Sub

Sub contBody_OnAnimationComplete(sParam, sParam2)
	if sParam = "Up" then
		contBody.grd0.setEnableScroll(true)
	end if
	
End Sub

Sub contBody2_OnAnimationStart(sParam, sParam2)
	if sParam = "Down" then
		contBody2.grdDeposit.setEnableScroll(false)
		contBody2.Pannel0.setEnableScroll(false)
	end if
End Sub

Sub contBody2_OnAnimationComplete(sParam, sParam2)
	if sParam = "Up" then
		contBody2.grdDeposit.setEnableScroll(true)
		contBody2.Pannel0.setEnableScroll(true)
	end if
	
End Sub

'============================================================================
Sub contBody_grd0_OnClickUp(lRow, szCellID)
	OpenMovePopup(lRow)
End Sub

'============================================================================
Sub contBody_imgToggle_OnClick()
	
	if g_nViewMode = 0 then
		g_nViewMode = 1	'원화
		
		contBody.imgToggle.imgpath = "toggle_2dots_03.9.png"
		contBody.lblToggle.caption = "원화"
	else
		g_nViewMode = 0	'외화
	
		contBody.imgToggle.imgpath = "toggle_2dots_02.9.png"
		contBody.lblToggle.caption = "외화"
	end if
	
	Form.SetEnvData(1, "OVRS_JANGO_STANDARD_GBN", g_nViewMode)
	
'	Form.SetTimerEvent2(3, 1, 0.2)
	
'	DisplaySetting_Grid()
	Call_Tran()
End Sub

'============================================================================
Sub contBody_imgNotice_OnClick()
	'시세적용기준안내 팝업
	Form.OpenPopupAnimation("mbtro16070_p2" , szData , "" , "2")
End Sub

'============================================================================
Function RequestData()
	g_NextCnt = 0
	
	g_nTotal = 0
	
	contBody.imgNoData.visible = false
	contBody.lblNoData.visible = false
	
	DATAMANAGER.CancelRealData("ohhts_exst_cntg")
	DATAMANAGER.CancelRealData("ohhts_exst_cntg_1")
	DATAMANAGER.CancelRealData("ohhts_exst_cntd")
	DATAMANAGER.CancelRealData("ohhts_exst_cntd_1")
		
	DATAMANAGER.ClearInputData(0, "obtro_oder_267r")
	DATAMANAGER.SetDataValue(0, "obtro_oder_267r", "InBlock1", "ACNO" 		  , 0 , g_szAcno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_267r", "InBlock1", "ASNO" 		  , 0 , g_szAsno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_267r", "InBlock1", "ELFN_ID" 	  , 0 , g_szUserID) 'v002
	
	szChk0 = "N"
	szChk1 = "N"
	szChk2 = "N"
	szChk3 = "1"
	
	if contBody.chk0.checkstate == "1" or CInt(contBody.chk0.checkstate) == 1 then '비용포함
		szChk0 = "Y"
	else
		szChk0 = "N"
	end if
		
	if contBody.chk1.checkstate == "1" or CInt(contBody.chk1.checkstate) == 1 then '대출합산
		szChk1 = "2"
	else
		szChk1 = "1"
	end if

	if contBody.chk2.checkstate == "1" or CInt(contBody.chk2.checkstate) == 1 then '정규종가
		szChk2 = "N"
	else
		szChk2 = "Y"
	end if
	
	' 0 외화 1 원화
	if g_nViewMode == 1 then
		szChk3 = "2"
	else
		szChk3 = "1"
	end if
	
	DATAMANAGER.SetDataValue(0, "obtro_oder_267r", "InBlock1", "FEE_INCU_YN"	  , 0 , 			szChk0)
	DATAMANAGER.SetDataValue(0, "obtro_oder_267r", "InBlock1", "DYTM_TR_CLPR_APLY_YN", 0 , 	szChk2) 'v004
	
	DATAMANAGER.SetDataValue(0,"obtro_oder_267r", "InBlock1", "IQRY_CLS_CODE" , 0 , 	szChk1) 'v004
	DATAMANAGER.SetDataValue(0,"obtro_oder_267r", "InBlock1", "PROS_CLS" , 0 , 		szChk3) 'v004
	DATAMANAGER.SetDataValue(0,"obtro_oder_267r", "InBlock1", "UI_IQRY_COND_CNTT" , 0 , g_szCrCd) 'v004

	DATAMANAGER.RequestTranData("obtro_oder_267r")
End Function

'============================================================================
Sub contBody_chk0_OnChange(sCheckState)	
	Form.SetEnvData(1, "OVRS_JANGO_CHK_1", sCheckState)
	
	if sCheckState == "1" then
		szToolTipText = "비용포함 조건을 설정 시, 평가손익과 수익률은 수수료/세금/이자를 포함한 추정치로 오차가 생길 수 있습니다."
		
		contBody.imgTooltip.openToolTip(szToolTipText, 300, 80, 2)
	end if 
	Call_Tran()
End Sub

'============================================================================
Sub contBody_chk1_OnChange(sCheckState)
	Form.SetEnvData(1, "OVRS_JANGO_CHK_2", sCheckState)
	Call_Tran()
End Sub

'============================================================================
Sub contBody_chk2_OnChange(sCheckState)
	Form.SetEnvData(1, "OVRS_JANGO_CHK_3", sCheckState)
	if contBody.chk2.checkstate == "1" or CInt(contBody.chk2.checkstate) == 1 then '정규종가
		szChk2 = "N"
		g_szDytmYN = "N"
	else
		szChk2= "Y"
		g_szDytmYN = "Y"
	end if

	Call_Tran()
End Sub
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if "ohhts_exst_cntg" == szTranID or "ohhts_exst_cntg_1" == szTranID or "ohhts_exst_cnta_1" == szTranID or "ohhts_exst_cnta" == szTranID or "ohhts_exst_cntd_1" == szTranID or "ohhts_exst_cntd" == szTranID then
		DATAMANAGER.ClearInputData( 1, szTranID )
		DATAMANAGER.ClearOutputData( 1, szTranID )
		
		Dim szCode,szNowCode,InputCode
		Dim nIdx
		nIdx = 0
		szCode = ""
		
		for i = 0 to contBody.grd0.rowcount - 1
			szNowCode = contBody.grd0.GetCellData("bd_cell21", i)'종목코드
			
			szExchCd = right(contBody.grd0.GetCellData("bd_cell70", i),2)
			
			if szExchCd == "OQ" or szExchCd == "NY" or szExchCd == "AX" or szExchCd == "HK"  or szExchCd == "SH"  or szExchCd == "SZ"  or szExchCd == "JP" then   
				'동일한 종목은 제외시킨 후 담는다.
				
				if szNowCode <> szCode then
					szCode = szNowCode
					DATAMANAGER.SetDataValue( 1, szTranID, "InBlock1", "FIDXR_ISCD" 	, nIdx , szNowCode ) 
					nIdx = nIdx + 1
				end if
			end if
		next
	end if
End Sub

'============================================================================
Sub contBody2_imgTooltip_OnClick()
	szToolTipText = "외화예수금 + 해외주식정산금 - 미수금\n\n단, 미국달러의 경우 자동투자평가금액이\n포함되어 조회 됩니다. "
	
	contBody2.imgTooltip.openToolTip(szToolTipText, 260, 100, 2)
End Sub
'

'============================================================================
Sub contBody2_grdDeposit_OnClickUp(lRow, szCellID)
	dim szData
	dim szCRCD

	if lRow >= 0 then
		
		szCRCD = contBody2.grdDeposit.GetCellData("bd_cell0", lRow)
			
		'계좌번호★계좌순번★통화코드
		szData = g_szAcno .. "★" .. g_szAsno .. "★" .. szCRCD
	
		'시세적용기준안내 팝업
		Form.OpenPopupAnimation("mbtro16070_p2" , szData , "" , "2")		
	end if
	
End Sub

'============================================================================
Sub contBody2_imgViewMode_OnClick()
	if g_nViewMode2 = 0 then
		g_nViewMode2 = 1	'Grid
		contBody2.lblTitle.caption = "외화 예수금"
		contBody2.imgViewMode.imgpath = "btn_view_grid"
		contBody2.imgTooltip.visible = False
		contBody2.imgBg.visible = False
		contBody2.grdDeposit.visible = True
		contBody2.Pannel0.visible = False
	else
		g_nViewMode2 = 0	'Pannel
		contBody2.lblTitle.caption = "외화 추정 예수금"
		contBody2.imgViewMode.imgpath = "btn_view_list"
		contBody2.imgTooltip.visible = True
		contBody2.imgBg.visible = True
		contBody2.grdDeposit.visible = False
		contBody2.Pannel0.visible = True
	end if
	
	nWidth = Form.getTextWidth(contBody2.lblTitle.caption, 0, true, false)
	contBody2.imgTooltip.left = 10 + nWidth + 7
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if Cint(sTimerID) == 1 then
		Calc_Data()
		
	elseif Cint(sTimerID) == 2 then
		Form.SetTimerEvent2(Cint(sTimerID), 0, 0)
		Call_Tran()
		
	elseif Cint(sTimerID) == 3 then
		Form.SetTimerEvent(Cint(sTimerID), 0, 0)

		if g_nViewMode == 1 then
			DATAMANAGER.RequestRealData("ohhts_exst_cntd_1")
			DATAMANAGER.RequestRealData("ohhts_exst_cntg_1")
		else
			DATAMANAGER.RequestRealData("ohhts_exst_cntd")
			DATAMANAGER.RequestRealData("ohhts_exst_cntg")
		end if
	end if
End Sub


'============================================================================
Sub Form_OnTriggerEventSCREEN(sEventName,sParam)
	if g_isOpen = true then
		g_isOpen = false
		g_szPrevIdx = Form.GetSharedData("16070_JANGO_INDEX", true)	
	end if
End Sub
'============================================================================
Sub contBody_grd0_OnHeaderClickUp(lRow, szCellID)
	g_szSortIdx = g_szSortIdx + 1 
	if g_szSortIdx > 2 then
		g_szSortIdx = 0
	end if
	
	if szCellID <> g_szSortHeader then
		g_szSortHeader = szCellID
		g_szSortIdx = 0
	end if
	
	Form.SetEnvData(1, "OVRS_JANGO_SORT_HEADER", g_szSortHeader)
	Form.SetEnvData(1, "OVRS_JANGO_SORT_IDX", g_szSortIdx)
End Sub


'============================================================================
Sub Form_OnRefresh()
	Form.SetTimerEvent2(2, 1, 0.2)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if "ohhts_exst_cntg" == szTranID or "ohhts_exst_cntg_1" == szTranID or "ohhts_exst_cnta_1" == szTranID or "ohhts_exst_cnta" == szTranID or "ohhts_exst_cntd_1" == szTranID or "ohhts_exst_cntd" == szTranID then
		if g_isStart == true then
			g_isStart = false
			Form.SetTimerEvent(1, 1, 1)
		end if
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	
End Sub

