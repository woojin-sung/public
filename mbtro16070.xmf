'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName = "mbtro16070_p4" then
		
		'거래 국가 선택후.
		if sRet <> "" then
			tData = Split(sRet, "★")	
			
			g_szCrCd = trim(tData(0))
			g_szCrCdNm = trim(tData(1))
			
			Form.SetEnvData(1, "OVRS_JANGO_NATION", g_szCrCd)
			Form.SetEnvData(1, "OVRS_JANGO_NATION_NM", g_szCrCdNm)
			
	
			lblCrCd.caption = g_szCrCd		
			
			if g_szCrCd == "000" or g_szCrCd == "" then
				lblCrCdNm.caption = "총 외화자산"
				
				nTxtWidth = Form.getTextWidth("총 외화자산", 2, true, false)
				
				imgSearch.left = 15 + nTxtWidth + 7
				
			else
				arrCrcdNm = split(g_szCrCdNm, "@") 
				nArrCnt = #arrCrcdNm
				
				nTxtWidth = Clng(Form.getTextWidth("총 외화자산 ", 2, true, false))
	
				if nArrCnt == 1 then
					lblCrCdNm.caption = "총 외화자산 (" & g_szCrCdNm & ")"
					nTxtWidth = nTxtWidth +  Clng(Form.getTextWidth("(" & g_szCrCdNm & ")", -2, true, false))
				else
					lblCrCdNm.caption = "총 외화자산 (" &arrCrcdNm(0) & " 외 " & nArrCnt-1 & ")"
					nTxtWidth = nTxtWidth +  Clng(Form.getTextWidth("(" &arrCrcdNm(0) & " 외 " & nArrCnt-1 & ")", -2, true, false))
				end if
				
				nTxtLen = Form.getLen(lblCrCdNm.caption)
		
				lblCrCdNm.changeTextAttr(6, nTxtLen-6, 333, -2, true)
				
				imgSearch.left = 15 + nTxtWidth + 7
			end if
		end if
		
		Call_Tran()
	elseif sKeyName == "MOVEPOPUP_RETURN" then
	
		'sRet = 선택행인덱스★이동화면 구분값 
		arrData = Split(sRet,"★")
		
		sIndex = arrData(0)
		sGubun = arrData(1)
		
		if sIndex <> "" and sGubun <> "" then
			MoveScreen(sGubun,sIndex)
		end if
	elseif sKeyName == "OVRS_REAL_JANGO" then	
		Init_Control()
		imgDetail_OnClick()
		Call_Tran()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ooopc_cuma_093r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO"          , 0, g_szCustNum)
	elseif szTranID == "obacb_balc_153r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 0, "2")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO"          , 0, g_szCustNum)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID"       , 0, g_szUserID)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ooopc_cuma_093r" then
		if  DATAMANAGER.IsMoreNextData( "ooopc_cuma_093r" ) == True then 
			DATAMANAGER.RequestNextData("ooopc_cuma_093r")
		end if
	
		DATAMANAGER.RequestTranData( "obacb_balc_153r" )
	
	elseif szTranID == "obacb_balc_153r" then		
		OpenMyAsset()
		
	elseif szTranID = "obtro_oder_267r" then
		
		nCnt	= CDBL(DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1"))

		for i = 0 to contBody.grd0.rowcount-1
			contBody.grd0.setCellFgColor("bd_cell51", i, g_szTxtColor_Grey)
			
			stnd_exrt	= replace(contBody.grd0.GetCellData("bd_cell15", i), ",", "")	'기준환율
			
			szItemCd		= contBody.grd0.GetCellData("bd_cell16", i)	'종목코드
			exch			= contBody.grd0.GetCellData("bd_cell72", i)	'거래소구분코드

			vltn_prls_amt = replace(contBody.grd0.GetCellData("bd_cell06", i), ",", "")	'평가손익
			byov_amt 	= replace(contBody.grd0.GetCellData("bd_cell9", i) , ",", "")
			psnt_prc		= replace(contBody.grd0.GetCellData("bd_cell10", i), ",", "")
			nation		= contBody.grd0.GetCellData("bd_cell12", i)
			vltn_amt		= replace(contBody.grd0.GetCellData("bd_cell8", i), ",", "")
			byov_prc		= replace(contBody.grd0.GetCellData("bd_cell11", i), ",", "")
		
			dim sType, nOwnQty, nAbleQty
			
			sTemp = contBody.grd0.GetCellData("bd_cell16", i)
			
			sType = contBody.grd0.GetCellData("bd_cell18", i)
			
			nOwnQty = CDbl(contBody.grd0.GetCellData("bd_cell17", i))
			nAbleQty = CDbl(contBody.grd0.GetCellData("bd_cell67", i))
			
			if sType == "1" then
				nOwnQty = FormatNumber(nOwnQty, 0)
				nAbleQty = FormatNumber(nAbleQty, 0)
				contBody.grd0.SetCellData("bd_cell11", i, "일반")
			elseif sType == "2" then
	
				arrData = split(Cstr(nOwnQty), ".")
				arrData2 = split(Cstr(nAbleQty), ".")
				
				nOwnQty = FormatNumber(nOwnQty, 0)
				nAbleQty = FormatNumber(nAbleQty, 0)
				
				if #arrData > 1 then
					nOwnQty = nOwnQty & "." & arrData(1)
				end if
				
				if #arrData2 > 1 then
					nAbleQty = nAbleQty & "." & arrData2(1)
				end if
				
				
				contBody.grd0.SetCellData("bd_cell11", i, "소수점")
				contBody.grd0.SetCellData("bd_cell51", i, "소수점 | " & sTemp )
			end if
			
			contBody.grd0.SetCellData("bd_cell04", i, nOwnQty)
			contBody.grd0.SetCellData("bd_cell54", i, nAbleQty)

			sType = contBody.grd0.GetCellData("bd_cell53", i)
			
			
			if sType == "01" then
				contBody.grd0.SetCellData("bd_cell51", i, "현금 | " & sTemp )
			elseif sType == "02" then
				contBody.grd0.SetCellData("bd_cell51", i, "대출 | " & sTemp )
			end if
			
			
			if Cdbl(vltn_prls_amt) > 0 then
				contBody.grd0.SetCellFgColor("bd_cell06", i, "10")
			elseif Cdbl(vltn_prls_amt) < 0 then
				contBody.grd0.SetCellFgColor("bd_cell06", i, "11")
			else
				contBody.grd0.SetCellFgColor("bd_cell06", i, "4")
			end if
	
			szKorExch = Form.GetMetaData("해외주식거래국가코드", exch)
			contBody.grd0.SetCellData("bd_cell60", i, szKorExch)
			
			loan_type = Form.GetMetaData("대출상세유형코드", contBody.grd0.GetCellData("bd_cell69", i))
			contBody.grd0.SetCellData("bd_cell59", i, loan_type)
			contBody.grd0.SetCellFgColor("bd_cell05", i, "11")
			
			tmp_prc = contBody.grd0.GetCellData("bd_cell05", i)
			tmp_clpr = contBody.grd0.GetCellData("bd_cell20", i)
	
			if Cdbl(tmp_prc) > Cdbl(tmp_clpr) then
				contBody.grd0.SetCellFgColor("bd_cell05", i, "10")
			elseif Cdbl(tmp_prc) < Cdbl(tmp_clpr) then
				contBody.grd0.SetCellFgColor("bd_cell05", i, "11")
			else
				contBody.grd0.SetCellFgColor("bd_cell05", i, "4")
			end if
			
			szItemCode = contBody.grd0.GetCellData("bd_cell16", i)
			szExchCode = right(contBody.grd0.GetCellData("bd_cell70", i),2)
			contBody.grd0.SetCellData("bd_cell21", i, szExchCode&"@"&szItemCode)
		next
		
		if DATAMANAGER.IsMoreNextData("obtro_oder_267r") == true then
			DATAMANAGER.RequestNextData("obtro_oder_267r")
		else
			If Cint(contBody.grd0.rowcount) = 0 then
				contBody.imgNoData.visible = true
				contBody.lblNoData.visible = true
				Exit Sub
			Else
				contBody.imgNoData.visible = false
				contBody.lblNoData.visible = false
			End if
			
			contBody.grd0.toprow = g_szPrevIdx
			contBody.grd0.keyrow = "1"
			
			if g_szSortHeader <> "" and g_szSortIdx <> -1 then
				szData = replace(g_szSortHeader, "th_cell", "")
				if szData <> "" then
					szData = Cint(szData) - 1
					
					if szData > 24 then
						szData = szData - 50
					end if
					
					if szData > 2 then
						szData = szData - 2
					else 
						szData = 0
					end if
				end if
				
				contBody.grd0.onSortingByScript(g_szSortHeader, szData, g_szSortIdx)
			end if
			
			if Cint(contBody.grd0.rowcount) < 100 then
				isRealUse = false
				
				if contBody.chk0.checkstate == "0" and contBody.chk2.checkstate == "0" then
					isRealUse = true
				else
					isRealUse = false
				end if
				
				if g_isReal == true and isRealUse = true then
					contBody.grd0.setVisibleCol(9, "0")
					contBody.grd0.setVisibleCol(10, "0")
					contBody.grd0.setVisibleCol(11, "1")
					
					g_isStart = true
					
					Form.SetTimerEvent(3, 1, 1)
				else
					contBody.grd0.setVisibleCol(9, "1")
					contBody.grd0.setVisibleCol(10, "1")
					contBody.grd0.setVisibleCol(11, "0")

				end if
			end if
			
			
		end if
	elseif szTranID = "obtro_comn_010r" then
		Process_Tran_obtro_comn_010r()
	elseif szTranID = "obtro_oder_266r" then
		Process_Tran_obtro_oder_266r()
	end if
End Sub

