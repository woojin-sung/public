'============================================================================
' 화 면 명 : CFD배당내역조회(mbtrc22000.xmf)
'============================================================================

'============================================================================
' 전역변수
'============================================================================
Dim g_PrdCd		' 1 : 1개월 / 2 : 3개월 / 3 : 직접입력
Dim g_StaDate		' 조회 시작일
Dim g_FinDate		' 조회 종료일
Dim g_ServiceFlag ' 현금배당 : 1 / 주식배당 : 2
Dim g_DMST_ABRD_CLCD

'============================================================================
' 							FORM 함수
'============================================================================
Sub Form_OnFormInitBefore()
	
		'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  Form.GetSharedData("&OS_TYPE", false ) == "1" then'iOS("2")Android("1")
		ContAcct.setScrollBarVisible("2")
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()

	if Form.GetSharedData( "&SCREEN_NO" , false ) == "22002" then '해외
		cmbAccount.itemcodetype = "137"
	else ' 국내
		cmbAccount.itemcodetype = "136"
	end if 
	
	cmbAccount.ReLoadAccount()

	'CFD계좌 유
	if CInt(cmbAccount.accountcount) > 0 then
		g_PrdCd 			= "1"
		g_ServiceFlag		= "1"
		ContAcct.visible	= true
		
		' 초기 날짜 세팅 START -----------------------------------		
		tmp_date 	= LEFT(ContAcct.CalPsntDate.caption, 4) & "-" & RIGHT(LEFT(ContAcct.CalPsntDate.caption, 6), 2) & "-" & RIGHT(ContAcct.CalPsntDate.caption, 2)
		tmpPrd1month 	= CStr(DateAdd("d", 0, DateAdd("m", - 1, CDate(CStr(tmp_date)))))
		tmpPrd1month 	= Replace(tmpPrd1month, "-", "")

		g_StaDate 	= tmpPrd1month
		g_FinDate 	= ContAcct.CalPsntDate.caption

		f_SetFlag()
		' ----------------------------------------------------- END
		
		'계좌 체크
		if cmbAccount.caption <> "" and cmbAccount.caption <> null then
			f_SetScrn()
			f_ReqeustTranFn()
		end if
		
	'CFD계좌 무
	elseif CInt(cmbAccount.accountcount) = 0 then
		ContAcct.visible = false
	end if
	
	
	
	
End Sub

'============================================================================
'Sub Form_OnTriggerEvent(sEventName, sParam)
'
'	'상단 유의사항 아이콘 클릭 이벤트
'	if sEventName == "INFO_CLICK" then
'		Form.OpenPopup("mbonl88029_p1" , "" , "")
'	end If
'	
'End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	' 기간조회 팝업리턴
	if sKeyName = "mbtrc22000_p1" then
	
		if sRet <> "" and sRet <> null then
			Dim tData
			tData = Split(sRet, "★")

			g_PrdCd    = tData(0)		'1:1개월 2:3개월 3:직접입력
			g_StaDate  = tData(1)
			g_FinDate  = tData(2)

			f_SetFlag()
			f_ReqeustTranFn()
		end if
	
	' 현금/주식 배당 팝업리턴
	elseif sKeyName = "mbtrc22000_p2" then
	
		if sRet <> "" and sRet <> null then
			g_ServiceFlag = sRet
			
			f_SetScrn()
			f_ReqeustTranFn()
		end if
		
	end if
	
End Sub

'============================================================================
' 							DATAMANAGER 함수
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	' CFD 배당금/배당주 지급내역조회
	if szTranID == "obrgt_stas_468r" or szTranID == "obrgt_stas_469r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "LNKN_ACNO", 	0, cmbAccount.caption)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STA_DATE", 	0, g_StaDate)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FIN_DATE", 	0, g_FinDate)
	end if
	
End Sub	

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	' CFD 배당금 지급내역조회
	if szTranID == "obrgt_stas_468r" then
	
		' 상단 세팅 start -------------------------------------------------------------------------
		Dim MNRC_AMT, DRNG_AMT, FRCR_RCAM, FRCR_AMDR, DVDN_CRCD
		
		MNRC_AMT 		= CDBL(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MNRC_AMT", 	0))	'입금금액
		DRNG_AMT 		= CDBL(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DRNG_AMT", 	0))	'출금금액
		FRCR_RCAM 		= CDBL(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FRCR_RCAM", 	0))	'외화입금금액
		FRCR_AMDR 		= CDBL(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FRCR_AMDR", 	0))	'외화출금금액
		DVDN_CRCD 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DVDN_CRCD", 		0)	'배당통화코드
		g_DMST_ABRD_CLCD 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DMST_ABRD_CLCD", 	0)	'국내국외구분코드(1:국내, 2:해외)

		Dim sKorAmt, sFrcrAmt, sStaOffset, sFgcolor
		sKorAmt	= MNRC_AMT  - DRNG_AMT
		sFrcrAmt	= FRCR_RCAM - FRCR_AMDR

		' 국내계좌
		if g_DMST_ABRD_CLCD = "1" or g_DMST_ABRD_CLCD = 1 then
			ContAcct.Amt0.caption 	= FormatNumber(sKorAmt, 0).." 원"
			sStaOffset 			= ContAcct.Amt0.getLen(ContAcct.Amt0.caption) - 2
			sFgcolor 			= f_SetNumber(sKorAmt)
			ContAcct.Amt0.fgcolor	= sFgcolor			
			ContAcct.Amt0.changeTextAttr(sStaOffset, 2, sFgcolor, 5, true)
			
			ContAcct.lblSubTitle2.visible 	= false
			ContAcct.Amt0.visible 			= true
			ContAcct.Amt1.visible 			= false
			
		' 해외계좌
		elseif g_DMST_ABRD_CLCD = "2" or g_DMST_ABRD_CLCD = 2 then
			ContAcct.lblSubTitle2.visible = true
			
			' 원화배당, 외화배당 모두 존재하는 경우
			if (MNRC_AMT <> 0 or DRNG_AMT <> 0) and (FRCR_RCAM <> 0 or FRCR_AMDR <> 0) then

				' 외화세팅 -------------------------------------
				sFgcolor = f_SetNumber(sFrcrAmt)

				ContAcct.Amt1.SetCellString(0, 		0, FormatNumber(sFrcrAmt, 2)..DVDN_CRCD)
				ContAcct.Amt1.SetCellFgColor(0, 	0, sFgcolor)
				' 외화세팅 -------------------------------------
				
				' 원화세팅 -------------------------------------
				sFgcolor = f_SetNumber(sKorAmt)

				ContAcct.Amt1.SetCellString(0, 		1, FormatNumber(sKorAmt, 0).."원")
				ContAcct.Amt1.SetCellFgColor(0, 	1, sFgcolor)
				' 원화세팅 -------------------------------------				
				
				ContAcct.Amt0.visible = false
				ContAcct.Amt1.visible = true
				
			' 원화배당 또는 외화배당이 없는 경우 혹은 모두 없을 경우
			else				
				Dim sAMT, sLeng
				sAMT		= 0
				sLeng	= 0
				'원화배당
				if MNRC_AMT <> 0 or DRNG_AMT <> 0 then
					sFgcolor	= f_SetNumber(sKorAmt)
					sAMT 	= FormatNumber(sKorAmt, 0).." 원"
					sLeng	= 2
				
				'외화배당
				elseif FRCR_RCAM <> 0 or FRCR_AMDR <> 0 then
					sFgcolor	= f_SetNumber(sFrcrAmt)
					sAMT		= FormatNumber(sFrcrAmt, 2).." "..DVDN_CRCD
					sLeng	= Len(DVDN_CRCD) + 1

				' 없는 경우
				else
					sFgcolor	= f_SetNumber(0)
					sAMT		= FormatNumber(0, 0).." 원"
					sLeng	= 2
				end if

				ContAcct.Amt0.caption 	= sAMT
				sStaOffset 			= ContAcct.Amt0.getLen(ContAcct.Amt0.caption) - sLeng
				ContAcct.Amt0.fgcolor 	= sFgcolor
				ContAcct.Amt0.changeTextAttr(sStaOffset, sLeng, sFgcolor, 5, true)
				
				ContAcct.Amt0.visible = true
				ContAcct.Amt1.visible = false
			end if

		end if
		' 상단 세팅 --------------------------------------------------------------------------- END


		' 하단(그리드) 세팅 start -----------------------------------------------------------------
		Dim nCnt, nGrdCnt
		nCnt 	= CInt(DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2"))
		nGrdCnt 	= CInt(ContAcct.Grid0.rowcount)
		
		' 데이터가 있는 경우
		if nCnt > 0 then

			for i = 0 to nCnt - 1
				Dim PRVS_DATE, IO_CLS_NAME, DVDN_KIND_NAME, DVDN_AMT, DVDN_CAMT, DVDN_CRCD, ISCD_NAME, sAMT
				PRVS_DATE 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "PRVS_DATE", 		i)	'지급일자
				IO_CLS_NAME 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "IO_CLS_NAME", 		i)	'입출구분명
				DVDN_KIND_NAME 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "DVDN_KIND_NAME", 	i)	'배당종류명
				ISCD_NAME 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ISCD_NAME", 		i)	'종목코드명
				DVDN_CRCD 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "DVDN_CRCD", 		i)	'배당통화코드
				DVDN_AMT 		= CDBL(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "DVDN_AMT", 	i))	'배당금액
				DVDN_CAMT 		= CDBL(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "DVDN_CAMT", 	i))	'배당통화금액

				if DVDN_CRCD = "KRW" then
					sAMT	= FormatNumber(DVDN_AMT, 0).."원"
				else
					sAMT	= FormatNumber(DVDN_CAMT, 2)..DVDN_CRCD
				end if
				
				ContAcct.Grid0.AddRow()
				
				ContAcct.Grid0.SetCellData("BD_PRVS_DATE", 		nGrdCnt + i, PRVS_DATE)
				ContAcct.Grid0.SetCellData("BD_IO_CLS_NAME", 		nGrdCnt + i, IO_CLS_NAME)
				ContAcct.Grid0.SetCellData("BD_DVDN_KIND_NAME",	nGrdCnt + i, DVDN_KIND_NAME)
				ContAcct.Grid0.SetCellData("BD_ISCD_NAME", 		nGrdCnt + i, ISCD_NAME)
				ContAcct.Grid0.SetCellData("BD_AMT", 			nGrdCnt + i, sAMT)
				
				ContAcct.Grid0.SetCellFgColor("BD_PRVS_DATE", 	nGrdCnt + i, "110")
				ContAcct.Grid0.SetCellFgColor("BD_ISCD_NAME", 	nGrdCnt + i, "110")
				ContAcct.Grid0.SetPropGridCell("fontstyle", "BD_AMT", nGrdCnt + i, true)
			next

		end if
		
		if DATAMANAGER.IsMoreNextData("obrgt_stas_468r") = true then
			DATAMANAGER.RequestNextData("obrgt_stas_468r")
		else
		
			if Cint(ContAcct.Grid0.rowcount) > 0 then
				ContAcct.Grid0.height = (nCnt + nGrdCnt) * 70 + 5
				
				f_visibleFn(true)
			else
				ContAcct.Grid0.height = 0
				
				f_visibleFn(false)
			end if
			
			ContAcct.SetScrollAutoSize()
			ContAcct.scroll_pos = 0
		end if
		' 하단(그리드) 세팅 ------------------------------------------------------------------- END

	' CFD 배당주 지급내역조회
	elseif szTranID == "obrgt_stas_469r" then

		' 상단 세팅 start -------------------------------------------------------------------------
		g_DMST_ABRD_CLCD = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DMST_ABRD_CLCD", 0)	'국내국외구분코드(1:국내, 2:해외)
		
		' 국내계좌
		if g_DMST_ABRD_CLCD = "1" or g_DMST_ABRD_CLCD = 1 then
			ContAcct.lblSubTitle2.visible = false
			
		' 해외계좌
		elseif g_DMST_ABRD_CLCD = "2" or g_DMST_ABRD_CLCD = 2 then
			ContAcct.lblSubTitle2.visible = true
		end if
		' 상단 세팅 --------------------------------------------------------------------------- END				

				
		' 하단(그리드) 세팅 start -----------------------------------------------------------------
		Dim nCnt, nGrdCnt
		nCnt 	= CInt(DATAMANAGER.GetDataCount(0, szTranID, "OutBlock2"))
		nGrdCnt 	= CInt(ContAcct.Grid0.rowcount)

		' 데이터가 있는 경우
		if nCnt > 0 then
			
			for i = 0 to nCnt - 1
				Dim PRVS_DATE, IO_CLS_NAME, DVDN_KIND_NAME, ISCD_NAME, FRSK_AMT_CRCD, ASGM_QTY, FRSK_AMT, FRSK_CAMT, sAMT
				PRVS_DATE 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "PRVS_DATE", 		i)	'지급일자
				IO_CLS_NAME 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "IO_CLS_NAME", 		i)	'입출구분명
				DVDN_KIND_NAME 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "DVDN_KIND_NAME", 	i)	'배당종류명
				ISCD_NAME 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ISCD_NAME", 		i)	'종목코드명
				FRSK_AMT_CRCD 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "FRSK_AMT_CRCD", 	i)	'단수주금액통화코드
				ASGM_QTY			= CDBL(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "ASGM_QTY", 	i))	'배정수량
				FRSK_AMT 		= CDBL(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "FRSK_AMT", 	i))	'단수주금액
				FRSK_CAMT 		= CDBL(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "FRSK_CAMT", 	i))	'단수주통화금액
 
				'주식
				if ASGM_QTY <> 0 then
					sAMT	= FormatNumber(ASGM_QTY, 0).."주"
				'원화
				elseif FRSK_AMT <> 0 then
					sAMT	= FormatNumber(FRSK_AMT, 0).."원"
				'외화
				elseif FRSK_CAMT <> 0 then
					sAMT	= FormatNumber(FRSK_CAMT, 2)..FRSK_AMT_CRCD
				end if

				ContAcct.Grid0.AddRow()
				
				ContAcct.Grid0.SetCellData("BD_PRVS_DATE", 		nGrdCnt + i, PRVS_DATE)
				ContAcct.Grid0.SetCellData("BD_IO_CLS_NAME", 		nGrdCnt + i, IO_CLS_NAME)
				ContAcct.Grid0.SetCellData("BD_DVDN_KIND_NAME",	nGrdCnt + i, DVDN_KIND_NAME)
				ContAcct.Grid0.SetCellData("BD_ISCD_NAME", 		nGrdCnt + i, ISCD_NAME)
				ContAcct.Grid0.SetCellData("BD_AMT", 			nGrdCnt + i, sAMT)
				
				ContAcct.Grid0.SetCellFgColor("BD_PRVS_DATE", 	nGrdCnt + i, "110")
				ContAcct.Grid0.SetCellFgColor("BD_ISCD_NAME", 	nGrdCnt + i, "110")
				ContAcct.Grid0.SetPropGridCell("fontstyle", "BD_AMT", nGrdCnt + i, true)
			next

		end if
	
		if DATAMANAGER.IsMoreNextData("obrgt_stas_469r") = true then
			DATAMANAGER.RequestNextData("obrgt_stas_469r")
		else	

			if Cint(ContAcct.Grid0.rowcount) > 0 then
				ContAcct.Grid0.height = (nCnt + nGrdCnt) * 70 + 5

				f_visibleFn(true)
			else
				ContAcct.Grid0.height = 0

				f_visibleFn(false)
			end if
			
			ContAcct.SetScrollAutoSize()
			ContAcct.scroll_pos = 0
		end if
		' 하단(그리드) 세팅 ------------------------------------------------------------------- END
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert("안내", szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert("안내", szErrMsg)
	end if
	
End Sub

'============================================================================
' 							CONTROL 함수
'============================================================================
' 계좌선택
'============================================================================
Sub cmbAccount_ChangeAccount()
	f_ReqeustTranFn()
End Sub

'============================================================================
' 기간선택
'============================================================================
Sub ContAcct_lblFeeCdName_OnClick()
	dim sSendData
	sSendData = g_PrdCd&"★"&g_StaDate&"★"&g_FinDate
	
	Form.openPopupAnimation("mbtrc22000_p1", sSendData, "", "2")	
End Sub

Sub ContAcct_imgArrow0_OnClick()
	dim sSendData
	sSendData = g_PrdCd&"★"&g_StaDate&"★"&g_FinDate
	
	Form.openPopupAnimation("mbtrc22000_p1", sSendData, "", "2")	
End Sub

'============================================================================
' 현금배당 / 주식배당 선택
'============================================================================
Sub ContAcct_lblInfo0_OnClick()
	Form.openPopupAnimation("mbtrc22000_p2", "", "", "2")
End Sub

Sub ContAcct_imgArrow1_OnClick()
	Form.openPopupAnimation("mbtrc22000_p2", "", "", "2")
End Sub

'============================================================================
' 입금(결제) 통화 변경 클릭
'============================================================================
Sub ContAcct_lblSubTitle2_OnClick()
	Form.OpenFramePopup("mbtrc22000_p3", "", "")
End Sub

'============================================================================
' 							사용자 함수
'============================================================================
' 서비스 조회 함수
'============================================================================
Function f_ReqeustTranFn()
	f_SetInit()
	
	Dim srvcNm
	srvcNm = g_ServiceFlag == "1" and "obrgt_stas_468r" or "obrgt_stas_469r"
	
	DATAMANAGER.RequestTranData(srvcNm)
End Function

'============================================================================
' 화면 초기 세팅 함수
'============================================================================
Function f_SetInit()
	ContAcct.Amt0.caption 	= ""
	ContAcct.Amt0.fontsize	= 15
	ContAcct.Amt0.visible	= false
	
	ContAcct.Amt1.SetCellString(0, 0, "")
	ContAcct.Amt1.SetCellString(0, 1, "")
	ContAcct.Amt1.visible = false
	
	ContAcct.Grid0.rowcount	= 0
	ContAcct.Grid0.height 		= 0
	
	ContAcct.lblNoData.visible = true
	
	ContAcct.lblSubTitle2.caption = "입금(결제) 통화 변경 >"
End Function

'============================================================================
Function f_SetFlag()
	Dim tCodeName1
	Dim sStaDate, sFinDate
	
	if g_PrdCd == "1" then
		tCodeName1 				= "1개월"		
		ContAcct.imgArrow0.left	= 220
		
	elseif g_PrdCd == "2" then		
		tCodeName1 				= "3개월"
		ContAcct.imgArrow0.left	= 220
		
	elseif g_PrdCd == "3" then				
		sStaDate 	= Mid(g_StaDate, 3, 2) & "." & Mid(g_StaDate, 5, 2) & "." & Right(g_StaDate, 2)
		sFinDate 	= Mid(g_FinDate, 3 ,2) & "." & Mid(g_FinDate, 5, 2) & "." & Right(g_FinDate, 2)
		tCodeName1 	= sStaDate&" ~ "&sFinDate
		
		ContAcct.imgArrow0.left = 290
	else 
		tCodeName1 = ""
	end if
	
	ContAcct.lblFeeCdName.caption = tCodeName1
End Function

'============================================================================
Function f_SetScrn()

	' 현금배당
	if g_ServiceFlag = "1" then
		ContAcct.lblInfo0.caption	= "현금배당은?"
		
		ContAcct.Amt0.visible 		= true
		ContAcct.Amt1.visible 		= true
		
		ContAcct.ImgBg.height 		= 130
		
		ContAcct.lblSubTitle0.top 	= 155
		ContAcct.lblSubTitle1.top 	= 160
		ContAcct.lblSubTitle2.top 	= 160
		
		ContAcct.Grid0.top 		= 185
		
	' 주식배당
	elseif g_ServiceFlag = "2" then
		ContAcct.lblInfo0.caption	= "주식배당은?"
		
		ContAcct.Amt0.visible 		= false
		ContAcct.Amt1.visible 		= false
		
		ContAcct.ImgBg.height 		= 100
		
		ContAcct.lblSubTitle0.top 	= 125
		ContAcct.lblSubTitle1.top 	= 130
		ContAcct.lblSubTitle2.top 	= 130
		
		ContAcct.Grid0.top 		= 155
	end if

End Function

'============================================================================
Function f_visibleFn(TorF)
	
	if TorF then
		ContAcct.lblNoData.visible = false
	else
		ContAcct.lblNoData.visible = true
	end if

	ContAcct.lblSubTitle0.visible 	= TorF
	ContAcct.lblSubTitle1.visible 	= TorF
	ContAcct.Grid0.visible 		= TorF
	
	' 해외계좌
	if g_DMST_ABRD_CLCD = "2" or g_DMST_ABRD_CLCD = 2 then
		ContAcct.lblSubTitle2.visible = TorF
	end if
	
End Function

'============================================================================
' 마스크값(양수, 음수, 0 ) 세팅
'============================================================================
Function f_SetNumber(num)
	Dim sFgcolor
	
	if num > 0 then
		sFgcolor = "10"
	elseif num < 0 then
		sFgcolor = "11"
	else
		sFgcolor = "4"
	end if
	
	return sFgcolor
End Function

