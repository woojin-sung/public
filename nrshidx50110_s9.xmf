		<LABEL name="lblSubTitle0" fontstyle="01" caption="국내운용사" ly_vert="20,17,200,22,1" />
		<LABEL name="lblSubTitle1" fontstyle="01" caption="해외운용사" ly_vert="20,121,200,22,1" />
		<LABEL name="lblOperator0" fontsize="-2" click="1" ly_vert="20,50,335,44,1" />
		<LABEL name="lblOperator1" fontsize="-2" click="1" ly_vert="20,153,335,44,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="11383" _ulen="11129" >
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szTxtColor_Normal 
g_szTxtColor_Normal = "334"

Dim g_szTxtColor_Grey 
g_szTxtColor_Grey = "333"

Dim g_szTxtColor_White 
g_szTxtColor_White = "338"

Dim g_szBtnImg_Normal
g_szBtnImg_Normal = "btn_41_n.9"

Dim g_szBtnImg_Select
g_szBtnImg_Select = "btn_41_n.9"

Dim g_arrDomesticOperator
Dim g_arrDomesticOperator_Check

Dim g_arrOverseaOperator
Dim g_arrOverseaOperator_Check

Dim g_szSharedKey
g_szSharedKey = "50110_S9_CHECK"

Dim g_szSharedKey_Domestic
g_szSharedKey_Domestic = "50110_S9_CHECK_DOMESTIC"

Dim g_szSharedKey_Oversea
g_szSharedKey_Oversea = "50110_S9_CHECK_OVERSEA"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************
'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	lblSubTitle0.fgcolor = g_szTxtColor_Normal
	lblSubTitle0.paddinginfo = "0,0,0,0"
	
	lblSubTitle1.fgcolor = g_szTxtColor_Normal
	lblSubTitle1.paddinginfo = "0,0,0,0"
	
	lblOperator0.caption = "선택해주세요"
	lblOperator1.caption = "선택해주세요"
	
	lblOperator0.imagefilepth = g_szBtnImg_Normal
	lblOperator1.imagefilepth = g_szBtnImg_Normal
End Function

'===============================================
' 배열 -> 문자열 변환
'===============================================
Function Convert_ArrToString(arrData, szSeperator)
	szResult = ""
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if i <> 0 then
			szResult = szResult & szSeperator 
		end if
		
		szResult = szResult & arrData(i) 
	next
	
	return szResult
End Function

'===============================================
' 배열 -> 문자열 변환(체크항목)
'===============================================
Function Convert_ChkArrToString(arrData, arrChkData, szSeperator)
		szResult = ""
	
	if arrData = null then
		return szResult
	end if
	
	if arrChkData = null then
		return szResult
	end if
	
	if szSeperator = null or szSeperator = "" then
		return szResult
	end if 	
	
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if arrChkData(i) = "1" then
			if szResult <> "" then
				szResult = szResult & szSeperator 
			end if
			szResult = szResult & arrData(i) 
		end if
	next
	
	return szResult
End Function

'===============================================
' 문자열 -> 배열 변환
'===============================================
Function Convert_StringToArr(szData, szSeperator)
	szArrData = ""
	
	if szData <> null and szData <> "" then
		szArrData = split(szData, szSeperator)
	end if
	
	return szArrData
End Function

'===============================================
' 배열 데이터 확인
'===============================================
Function Contains_Array(arrData, szData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		szArrData = arrData(i)
		
		if szArrData = szData then
			return true
		end if
	next 
	
	return false
End Function
'
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	g_arrDomesticOperator = {}
	g_arrDomesticOperator_Check = {}
	
	g_arrOverseaOperator = {}
	g_arrOverseaOperator_Check = {}
		
	DATAMANAGER.RequestTranData("ohhts_metf_017r")
	DATAMANAGER.RequestTranData("ohhts_metf_017r_1")
	
	Init_Control()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "ohhts_metf_017r" then
		DATAMANAGER.SetDataValue(0,  "ohhts_metf_017r", "InBlock1", "FID_INPUT_CLS_CODE", 0 , "00")
	elseif szTranID = "ohhts_metf_017r_1" then
		DATAMANAGER.SetDataValue(0,  "ohhts_metf_017r_1", "InBlock1", "FID_INPUT_CLS_CODE", 0 , "01")
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_metf_017r" then
		
		nArrCnt = #g_arrDomesticOperator
		
		nDataCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_017r", "OutBlock1")
		for i = 0 to nDataCnt-1
			szData = DATAMANAGER.GetDataValue(0, "ohhts_metf_017r", "OutBlock1", "FIDX_MGCO_NAME", i)
			
			g_arrDomesticOperator(nArrCnt) = szData
			nArrCnt = nArrCnt+1
		next 
		
		if DATAMANAGER.IsMoreNextData(szTranID) = true then
			DATAMANAGER.RequestNextData(szTranID)
		else
			szData0 = Form.GetSharedData(g_szSharedKey_Domestic, false )
			g_arrDomesticOperator_Check = Convert_StringToArr(szData0, "`")
				
			if #g_arrDomesticOperator_Check > 1 then
				lblOperator0.imagefilepth = g_szBtnImg_Select
				lblOperator0.caption = g_arrDomesticOperator_Check(0) & " 외 " & #g_arrDomesticOperator_Check-1 & "개"
			elseif #g_arrDomesticOperator_Check = 1 then
				lblOperator0.imagefilepth = g_szBtnImg_Select
				lblOperator0.caption = g_arrDomesticOperator_Check(0)
			else
				lblOperator0.imagefilepth = g_szBtnImg_Normal
				lblOperator0.caption = "선택해주세요"
			end if
		end if
		
		
	elseif szTranID = "ohhts_metf_017r_1" then
		
		nArrCnt = #g_arrOverseaOperator
		nDataCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_017r_1", "OutBlock1")
		for i = 0 to nDataCnt-1
			szData = DATAMANAGER.GetDataValue(0, "ohhts_metf_017r_1", "OutBlock1", "FIDX_MGCO_NAME", i)
			
			g_arrOverseaOperator(nArrCnt) = szData
			nArrCnt = nArrCnt + 1
		next 
		
		nArrCnt = #g_arrOverseaOperator
		
		
		if DATAMANAGER.IsMoreNextData(szTranID) = true then
			DATAMANAGER.RequestNextData(szTranID)
		else
			szData1 = Form.GetSharedData(g_szSharedKey_Oversea, false )
			g_arrOverseaOperator_Check = Convert_StringToArr(szData1, "`")
			if #g_arrOverseaOperator_Check > 1 then
				lblOperator1.imagefilepth = g_szBtnImg_Select
				lblOperator1.caption = g_arrOverseaOperator_Check(0) & " 외 " & #g_arrOverseaOperator_Check-1 & "개"
			elseif #g_arrOverseaOperator_Check = 1 then
				lblOperator1.imagefilepth = g_szBtnImg_Select
				lblOperator1.caption = g_arrOverseaOperator_Check(0)
			else
				lblOperator1.imagefilepth = g_szBtnImg_Normal
				lblOperator1.caption = "선택해주세요"
			end if
		end if
	end if
End Sub

'============================================================================
Sub lblOperator0_OnClick()
	Form.OpenPopup("nrshidx50110_p3" , "DomesticOperator★1★0★" & Convert_ArrToString(g_arrDomesticOperator, "`") & "★" & Convert_ArrToString(g_arrDomesticOperator_Check, "`"), "")
End Sub

'============================================================================
Sub lblOperator1_OnClick()
	Form.OpenPopup("nrshidx50110_p3" , "OverseaOperator★1★0★" & Convert_ArrToString(g_arrOverseaOperator, "`")& "★" & Convert_ArrToString(g_arrOverseaOperator_Check, "`"), "")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "50110_P3_RETURN_DATA_DomesticOperator" then
		szData = sRet
		
		if szData = "" or szData = null then
			g_arrDomesticOperator_Check = {}
			lblOperator0.imagefilepth = g_szBtnImg_Normal
			lblOperator0.caption = "선택해주세요"
			
			Form.SetSharedData(g_szSharedKey_Domestic, "")
			Form.triggerEvent("#", g_szSharedKey, "")
			exit Sub
		end if
		
		if szData = "전체" then
			lblOperator0.caption = "전체"
			g_arrDomesticOperator_Check = szData
		else
			g_arrDomesticOperator_Check = Convert_StringToArr(szData, "`")
			
			if #g_arrDomesticOperator_Check > 1 then
				lblOperator0.imagefilepth = g_szBtnImg_Select
				lblOperator0.caption = g_arrDomesticOperator_Check(0) & " 외 " & #g_arrDomesticOperator_Check-1 & "개"
			elseif #g_arrDomesticOperator_Check = 1 then
				lblOperator0.imagefilepth = g_szBtnImg_Select
				lblOperator0.caption = g_arrDomesticOperator_Check(0)
			else
				lblOperator0.imagefilepth = g_szBtnImg_Normal
				lblOperator0.caption = "선택해주세요"
			end if
			
		end if
		
		Form.SetSharedData(g_szSharedKey_Domestic, szData)
		Form.triggerEvent("#", g_szSharedKey, "")
		
	elseif sKeyName = "50110_P3_RETURN_DATA_OverseaOperator" then
		szData = sRet
		
		if szData = "" or szData = null then
			g_arrOverseaOperator_Check = {}
			Form.SetSharedData(g_szSharedKey_Oversea, "")
			lblOperator1.imagefilepth = g_szBtnImg_Normal
			lblOperator1.caption = "선택해주세요"
			
			
			Form.SetSharedData(g_szSharedKey_Oversea, "")
			Form.triggerEvent("#", g_szSharedKey, "")
			exit Sub
		end if
		
		if szData = "전체" then
			lblOperator1.caption = "전체"
			g_arrOverseaOperator_Check = szData
		else
			g_arrOverseaOperator_Check = Convert_StringToArr(szData, "`")
			if #g_arrOverseaOperator_Check > 1 then
				lblOperator1.imagefilepth = g_szBtnImg_Select
				lblOperator1.caption = g_arrOverseaOperator_Check(0) & " 외 " & #g_arrOverseaOperator_Check-1 & "개"
			elseif #g_arrOverseaOperator_Check = 1 then
				lblOperator1.imagefilepth = g_szBtnImg_Select
				lblOperator1.caption = g_arrOverseaOperator_Check(0)
			else
				lblOperator1.imagefilepth = g_szBtnImg_Normal
				lblOperator1.caption = "선택해주세요"
			end if
			
		end if
		
		Form.SetSharedData(g_szSharedKey_Oversea, szData)
		Form.triggerEvent("#", g_szSharedKey, "")

	end if 
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "50110_S9_CHECK" then
		szData0 = Form.GetSharedData(g_szSharedKey_Domestic, false )
		g_arrDomesticOperator_Check = Convert_StringToArr(szData0, "`")
			
		if #g_arrDomesticOperator_Check > 1 then
			lblOperator0.imagefilepth = g_szBtnImg_Select
			lblOperator0.caption = g_arrDomesticOperator_Check(0) & " 외 " & #g_arrDomesticOperator_Check-1 & "개"
		elseif #g_arrDomesticOperator_Check = 1 then
			lblOperator0.imagefilepth = g_szBtnImg_Select
			lblOperator0.caption = g_arrDomesticOperator_Check(0)
		else
			lblOperator0.imagefilepth = g_szBtnImg_Normal
			lblOperator0.caption = "선택해주세요"
		end if
		
		szData1 = Form.GetSharedData(g_szSharedKey_Oversea, false )
		g_arrOverseaOperator_Check = Convert_StringToArr(szData1, "`")
		if #g_arrOverseaOperator_Check > 1 then
			lblOperator1.imagefilepth = g_szBtnImg_Select
			lblOperator1.caption = g_arrOverseaOperator_Check(0) & " 외 " & #g_arrOverseaOperator_Check-1 & "개"
		elseif #g_arrOverseaOperator_Check = 1 then
			lblOperator1.imagefilepth = g_szBtnImg_Select
			lblOperator1.caption = g_arrOverseaOperator_Check(0)
		else
			lblOperator1.imagefilepth = g_szBtnImg_Normal
			lblOperator1.caption = "선택해주세요"
		end if
	end if
End Sub

