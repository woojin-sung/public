'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 입출금/고 내역_보수징수
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.01 김은숙
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_bInitOK
g_bInitOK = False

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Function Account_Check()
	If Form.GetCtlProp("#acnt0", "total") = "" Then
		Form.ShowAlert("알림", "계좌번호는 필수값입니다.")
		Return False
	End If

	If Form.GetCtlProp("#cmbSeq", "caption") = "" Then
'		Form.ShowAlert("알림", "계약번호는 필수값입니다.")
		Return False
	End If
	
	Return true
End Function

'============================================================================
Sub CheckCalendar()
	Dim sSDate, sFDate
	sSDate = cldStart.calyear &"-"& cldStart.calmonth &"-"& cldStart.calday
	sFDate = cldFinish.calyear &"-"& cldFinish.calmonth &"-"& cldFinish.calday
	
	If DateDiff("d", sSDate, sFDate) > 180 then
		Form.MsgBox( "알림", "조회구간은 6개월 이내로 가능합니다.", "", 6 )
		return False
	End If
	
	return True
End Sub

'============================================================================
Function RequestData()
	grd0.rowcount = 0		'Clear Data
	
	If Account_Check() == True then			'계좌체크
		If CheckCalendar() == True then		'기간체크
			DATAMANAGER.RequestTranData( "obwat_ctcs_035r" )	'계약종합정보-보수징수내역 조회
		End If
	End If
End Function

'============================================================================
Sub SetGridData(szTranID)
	Dim i, sCode, sText
	
	'구분
	For i = 0 to grd0.rowcount-1
		sCode = grd0.GetCellData( "bd_cell4" , i )
		
		Select Case sCode
			Case "01"
				sText = "선취판매수수료"
			Case "02"
				sText = "선취판매수수료환급"
			Case "03"
				sText = "선취운용보수"
			Case "04"
				sText = "선취운용보수환급"
			Case "05"
				sText = "후취운용보수"
			Case "06"
				sText = "성과보수"
			Case "07"
				sText = "중도해지수수료"
			Case "08"
				sText = "기타수수료"
			Case "09"
				sText = "정기성과보수"
		End Select
		
		grd0.SetCellData( "bd_cell4" , i , sText )	
	Next
End Sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Call cmbPeriod_OnEditComplete(4)	'디폴트 6개월
	g_bInitOK = True
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "RECEIVE" Then
		RequestData()
	End If
End Sub

'============================================================================
Sub cldStart_OnEditComplete()
	Call RequestData()
End Sub

'============================================================================
Sub cldFinish_OnEditComplete()
	Call RequestData()
End Sub

'============================================================================
Sub cmbPeriod_OnEditComplete(iIndex)
	cldFinish.caption = cldToday.caption
	
	Select Case iIndex
		Case 0	'당일
			cldStart.caption = cldToday.caption	
		Case 1	'1주일
			cldStart.caption = Replace(DateAdd ("d", -7, cldToday.calyear &"-"& cldToday.calmonth &"-"& cldToday.calday), "-", "")
		Case 2	'1개월
			cldStart.caption = Replace(DateAdd ("d", -30, cldToday.calyear &"-"& cldToday.calmonth &"-"& cldToday.calday), "-", "")
		Case 3	'3개월
			cldStart.caption = Replace(DateAdd ("d", -90, cldToday.calyear &"-"& cldToday.calmonth &"-"& cldToday.calday), "-", "")
		Case 4	'6개월
			cldStart.caption = Replace(DateAdd ("d", -180, cldToday.calyear &"-"& cldToday.calmonth &"-"& cldToday.calday), "-", "")
	End Select

	If g_bInitOK == True then
		Call RequestData()	'조회
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNO, szASNO, szIdx
	
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#cmbSeq", "caption")
	
	If szTranID = "obwat_ctcs_035r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_ACNO" 	, 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WA_CNRC_NO" , 0 , szASNO )
	End If	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obwat_ctcs_035r" Then
		Call SetGridData(szTranID)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

