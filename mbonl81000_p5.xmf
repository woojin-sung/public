'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 고객연락처변경
' 02. 화면설명 : 고객연락처변경_Email입력창
' 03. 작    성 : 2016.01.25 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim sRevData, sTemp
	g_sRetData = "cancel"
	sRevData = Form.GetOpenLinkData()
	
	if sRevData == null or sRevData == "" then
		Exit Sub
	end if
	
	sTemp = Split(sRevData, ";")
	if sTemp[0] == "Register" then
		Form.SetScreenName("E-mail 등록")
	elseif sTemp[0] == "Modify" then
		Form.SetScreenName("E-mail 변경")
	end if
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	if iIndex == 0 then
		EditInput1.enable = true
	else
		EditInput1.caption = ""
		EditInput1.enable = false
	end if
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if EditInput.caption == "" then
		Form.MsgBox( "알림", "E-Mail을 입력해주세요.", "", 6 )
		Exit Sub
	end if
	
	if Combo0.cbkeydata == "0" then
		if EditInput1.caption == "" then
			Form.MsgBox( "알림", "E-Mail을 입력해주세요.", "", 6 )
			Exit Sub
		end if
	end if
	
	Dim sSendData	
	if Combo0.cbkeydata == "0" then
		sSendData = EditInput.caption.."@"..EditInput1.caption
	else
		sSendData = EditInput.caption.."@"..Combo0.caption
	end if
	
	Form.SetSharedData("mbonl81000_p5_EMAIL" , sSendData)
		
	g_sRetData = "ok"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl81000_p5" , g_sRetData)
End Sub




	</SCRIPT_INFO>
