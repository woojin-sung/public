'--===========================================================================
' 01. 화 면 명 : CFD한도
' 02. 화면설명 : CFD한도_한도조회
' 03. 작    성 : 2022.05.16 KSJ 
' 04. 수    정 : 2023-06-26 : 유재하 : (v001)CFD 미관리 계좌에 대한 한도 신설
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_ClearData() : 초기화
'============================================================================
Function f_ClearData()
	tblState.SetCellString( 0 , 1, "")	'총한도
	tblState.SetCellString( 1 , 1, "")	'기본한도
	tblState.SetCellString( 2 , 1, "")	'추가한도
	tblState.SetCellString( 3 , 1, "")	'(v001)소진한도
	tblState.SetCellString( 4 , 1, "")	'(v001)잔여한도
	
	tblState.SetCellString( 5 , 1, "")	'(v001)미관리계좌 한도
	tblState.SetCellString( 6 , 1, "")	'(v001)기본한도
	tblState.SetCellString( 7 , 1, "")     '(v001)추가한도
	tblState.SetCellString( 8 , 1, "")     '(v001)소진한도
	tblState.SetCellString( 9 , 1, "")     '(v001)잔여한도
	
	grdList.SetClear()			'협의한도 신청내역
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	f_ClearData()
End Sub

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	f_ClearData()
	if sEventName == "changeTab" then
		DATAMANAGER.RequestTranData( "obtrc_limt_012r" ) 'CFD고객한도조회
	end if	
End Sub

'============================================================================
' cmbAcct_ChangeAccount() : 계좌변경
'============================================================================
Sub cmbAcct_ChangeAccount()
	DATAMANAGER.RequestTranData( "obtrc_limt_012r" ) 'CFD고객한도조회
End Sub

'============================================================================
' grdList_OnScrollEnd() : Next 조회
'============================================================================
Sub grdList_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("obtrc_limt_012r") == true then
		DATAMANAGER.RequestNextData("obtrc_limt_012r")
	end if
End Sub

'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋데이터 세팅	
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'CFD고객한도조회
	If szTranID == "obtrc_limt_012r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE"	, 0 , "1"	)			'처리구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" 		, 0 , cmbAcct.total	)	'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" 		, 0 , cmbAcct.sequence )	'계좌일련번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ISCD" 		, 0 , "" )				'종목코드
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
        '(v001)서비스에서 총한도금액과 소진한도금액 산출하는 것으로 변경
	'CFD고객한도조회
	'If szTranID == "obtrc_limt_012r" Then
		'총한도 SET
		'Dim nBascLimtAmt, nCustSplmLimtAmt, nTotalLimt
		'nBascLimtAmt = tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "CUST_BASC_LIMT_AMT" , 0 )) '고객기본한도금액
		'nCustSplmLimtAmt = tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "CUST_SPLM_LIMT_AMT" , 0 )) '고객추가한도금액
		'nTotalLimt = nBascLimtAmt + nCustSplmLimtAmt
		
		'tblState.SetCellString( 0 , 1, nTotalLimt )	'총한도
		
		'총소진한도 SET
		'Dim nRmndStndExhsAmt, nNcntExhsAmt, nTotalExhsAmt
		'nRmndStndExhsAmt = tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "RMND_STND_EXHS_AMT" , 0 )) '잔고기준소진금액
		'nNcntExhsAmt = tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "NCNT_EXHS_AMT" , 0 )) '미체결소진금액
		'nTotalExhsAmt = nRmndStndExhsAmt + nNcntExhsAmt
		
		'tblState.SetCellString( 4 , 1, nTotalExhsAmt )	'총소진한도
	'End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 오류
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	Form.MsgBox( "알림", szErrMsg, "", 6 )
End Sub

'(v001)CFD 미관리 계좌에 대한 한도 신설
'============================================================================
Sub btnLimit_OnClick()
	Form.OpenFramePopup("mbtrc12000_p2" , "", "")
End Sub

