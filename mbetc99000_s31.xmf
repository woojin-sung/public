<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="99000" scrname="비중상세보기" version="2" writer="이은섭" />
	<FORM_INFO name="Form" ly_vert="0,0,375,550,1" />
	<CONTROL_INFO>
		<WEBVIEW name="webView01" urlpath="about:blank" ly_vert="6,7,363,483,1" />
		<BUTTON name="Button0" caption="확인" btnimage="btn_05.9" ly_vert="10,500,350,32,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="563" _ulen="557" >
Function webDraw(item_url)
	
	dim szURL
	
	szURL = item_url
	
	webView01.viewtype = 0
	webView01.urlpath = Cstr(item_url)
	
	
End Function 
'============================================================================
Sub Form_OnFormInit()

url = Cstr(Form.GetOpenLinkData())

'Form.MsgBox("테스트",url, "", 0)

call webDraw(url)

	
End Sub

'============================================================================

'============================================================================
Sub Button0_OnClick()
	Form.CloseForm()
End Sub
	</SCRIPT_INFO>
</ROOT>