Dim g_szItemCode
g_szItemCode	=""

'20180227 LES START - 실시간 on/off 기능 추가
Dim g_realRecv
g_realRecv = 1
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
