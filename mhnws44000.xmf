'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if	szTranID	=	"ohhts_news_001r"	then
		
'		grd01.SetClear()
		
		DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock1", "FID_INPUT_NEWS_ITN_EXCP_CLCD"	, 0 , "Y" )
		if rdoSect01.currentindex	=	"1"	then
			
			'20210622 LES START
			'DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock2", "FID_INPUT_ISCD"				, 0 , g_szItemCode )
			DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock2", "FID_NEW_INPUT_ISCD"			, 0 , g_szItemCode )
			'20210622 LES END
			
		else
			
			'20210622 LES START
			'DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock2", "FID_INPUT_ISCD"				, 0 , "")
			DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock2", "FID_NEW_INPUT_ISCD"			, 0 , "")
			'20210622 LES END
		
		end	if
		DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock1", "FID_INPUT_TITL",  0, edtKeyword.caption )
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	
	If szTranID = "ohhts_news_001r" Then
		Dim nCnt, szTime
		
		nCnt = DATAMANAGER.GetDataCount( 0, "ohhts_news_001r", "OutBlock1" )
		
		For i = 0 To nCnt - 1
			szTime = DATAMANAGER.GetDataValue( 0, "ohhts_news_001r", "OutBlock1", "FID_CNTG_HOUR" , i )	
			DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "OutBlock1", "FID_CNTG_HOUR" , i , Left(szTime, 4) )
		Next
		
	End If
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'20220124 SWJ START
	for i = 0 to 18
		DATAMANAGER.CancelRealData("ohhts_news_real")
	next
	'20220124 SWJ END
	
	if szTranID = "ohhts_news_001r" then
		
		For i = grd01.rowcount -1 To 0 Step -1
			Dim szNewsCorpCode
			szNewsCorpCode = grd01.GetCellData("bd_cell2", i)
			
			if szNewsCorpCode = "EY" Then
				grd01.SetDeleteRow( i )
			End If
		Next
		
		'20220124 SWJ START
		for i = 0 to 18
			Set_Real_Corp(i)
		next
		'DATAMANAGER.RequestRealData("ohhts_news_real")
		'20220124 SWJ END
	end if 
End Sub

'============================================================================
'20220124 SWJ START : 뉴스 제공업체 함수
'============================================================================
Function Set_Real_Corp(nidx)
	Select Case nidx
	
	Case 0
		'시황속보
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "n0")
	Case 1
		'공시정보
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "F0")
	Case 2
		'머니투데이
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "MT")
	Case 3
		'이투데이
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "SD")
	Case 4
		'인포스탁
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "IS")
	Case 5
		'매경뉴스
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "MK")
	Case 6
		'파이낸셜뉴스
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "FN")
	Case 7
		'연합뉴스
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "YN")
	Case 8
		'뉴스핌
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "NP")
	Case 9
		'아시아경제
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "AE")
	Case 10
		'헤럴드경제
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "HE")
	Case 11
		'CEO스코어데일리
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "CD")
	Case 12
		'서울경제
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "SE")
	Case 13
		'컨슈머타임스
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "CT")
	Case 14
		'팍스넷뉴스
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "PAX")
	Case 15
		'중국/홍콩
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "YICHN")
	Case 16
		'미국
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "YIUSA")
	Case 17
		'연합인포맥스
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "YIIFX")
	Case 18
		'NSP
		DATAMANAGER.SetDataValue( 1, "ohhts_news_real" , "InBlock1" , "FIDR_NEWS_OFER_ENTP_CODE" , nidx, "NSP")		'20240626_01 KBC : 뉴스원추가
		
	End Select
	
	'실시간on/off
	if g_realRecv == 1 then
		DATAMANAGER.RequestRealData("ohhts_news_real")
	else
		DATAMANAGER.CancelRealData("ohhts_news_real")
	end if	
End Function
