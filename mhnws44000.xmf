'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	'------------------------------------------------------------------
	' 20190814 HWG START : MTS 위변조체크로직 추가
	'------------------------------------------------------------------
	'MTS 위변조방지 스킵 대응
	szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	szDev 		= Form.GetSharedData("&SERVER_MODE", False)
	szAppVer 	= Form.GetSharedData("&APP_VERSION_CODE", False)
	szPrivateKey	= "vjdDoV5kQc7lNK4VARxk0TSWA4k=\n"
	
	if szDev <> "1" and szOsType == "1" and Cint(szAppVer) > 39 then
		szKeyValue = Form.GetSharedData("&KEY_VALUE", False)
		if trim(szPrivateKey) <> trim(szKeyValue) then
			
			'20180912_01 KBC START : 모의해킹결과조치
			if Cint(szAppVer) > 44 then
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.SetSharedData("&SGB" , "BBE") 
				
				Form.sendItemPrice()			'App 종료API 추가 (네이밍무관)
				Form.sendMessage()			'App 종료API 추가 (네이밍무관)
				Form.TerminateApp()
				
			else 
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.TerminateApp()
			end if

			'20180912_01 KBC END
			exit sub
		end if
	end if
	'------------------------------------------------------------------
	
	Form.SetSharedData("&CODE_DUPR_USE" , "YES")	'20191022 HWG : 해외파생 중복실행 차단
	
	g_szItemCode	=	Form.GetOpenLinkData()
	
'	if g_szItemCode = "" 	then
'		g_szItemCode = "008560" 	'임시
'	end if 

	ItemCode01.itemtype = "29:1:5:6:3:15"		'20220922 SWJ START : 최근조회 탭 추가

	if	g_szItemCode	<> NULL	and	len(trim(g_szItemCode))	>	4	then

		ItemCode01.caption	=	g_szItemCode
		rdoSect01.currentindex = "1"
		DATAMANAGER.RequestTranData("ohhts_news_001r")
	else
	     '20170203 HWG START - 종목컨트롤 초기화 후 전체뉴스 조회
		'g_szItemCode = Form.GetSharedData("&ITEM_STOCK", 0)		' 최근조회종목
          g_szItemCode	=	""
	     ItemCode01.caption	="empty"
		
		'if	g_szItemCode	<>	NULL	then
			'ItemCode01.caption = g_szItemCode
			'rdoSect01.currentindex = "1"
			DATAMANAGER.RequestTranData("ohhts_news_001r")
		'end	if
		'20170203 HWG END
	end	if
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	DATAMANAGER.RequestTranData("ohhts_news_001r")
End Sub


'============================================================================
'grd01_OnClickUp
'============================================================================
Sub grd01_OnClickUp(lRow, szCellID)
	Dim szTitle, szDate, szTime, szNewCorpName, szNewKey, szNewsCorpCode, szMsg, szCode, szName

	szTitle			= grd01.GetCellData( "bd_cell7", lRow )	' 제목			-- FID_TITL
	szDate			= grd01.GetCellData( "bd_cell3", lRow )	' 날짜   		-- FID_DATE
	szTime			= grd01.GetCellData( "bd_cell5", lRow )	' 시간    		-- FID_CNTG_HOUR
	szNewCorpName		= grd01.GetCellData( "bd_cell11", lRow )	' 뉴스제공업체명 	-- FID_KOR_ISNM
	szNewKey			= grd01.GetCellData( "bd_cell1", lRow )	' 뉴스키       	-- FID_NEWS_KEY
	szNewsCorpCode	= grd01.GetCellData( "bd_cell2", lRow )	' 뉴스제공업체코드-- FID_NEWS_OFER_ENTP_CODE
	szCode			= grd01.GetCellData( "bd_cell4", lRow )	' 종목코드
	szName			= Form.GetItemCodeInfo(szCode, "name")
	
	szMsg = szTitle & "|" & szDate & "|" & szTime & "|" & szNewCorpName & "|" & szNewKey & "|" & szNewsCorpCode & "|" &  szName
	
	Form.OpenPopup( "mhprc11000_p6" , szMsg, "" )
	
End Sub


