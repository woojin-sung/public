'============================================================================
'Form_OnCommonDialogReturn
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if	sDlgName	=	"SEARCH"	then
		if	sReturn1	<>	NULL		AND	len(trim(sReturn1))	>	 3	then
			g_szItemCode	=	sReturn1
			ItemCode01.caption	=	g_szItemCode
		
			name		=	Form.GetItemCodeInfo(g_szItemCode,	"name")
		
			DATAMANAGER.RequestTranData("ohhts_news_001r")
		end	if
	end	if
End Sub

'============================================================================
' 20180227 LES START - 실시간 on/off 기능 추가
'============================================================================
Sub ChkButton0_OnChange(sCheckState)
	
	
	if sCheckState = 1 or sCheckState = "1" then
	
		g_realRecv = 1
		 
		'DATAMANAGER.RequestRealData("ohhts_news_real")
	else
		
		g_realRecv = 0

		'DATAMANAGER.CancelRealData("ohhts_news_real")
	end if
	
	'20220124 SWJ START
	for i = 0 to 18
		Set_Real_Corp(i)
	next
	'20220124 SWJ END
End Sub

