'============================================================================
'rdoSect01_OnClick
'============================================================================
Sub rdoSect01_OnClick(nIndex)
	if	nIndex	=	0	then
		g_szItemCode	=	""
		ItemCode01.caption	="empty"
	
	end	if
	
	grd01.SetClear()
End Sub


