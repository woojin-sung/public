--===========================================================================
Dim g_sPlain_rm
Dim g_OsType
Dim g_szPreKeyPad
Dim g_sGubunCode
Dim g_bFlag
--===========================================================================
Dim g_szMangCode
Function f_CheckBefore()
	if acnt0.total == "" or acnt0.total == null then
		Form.ShowAlert("알림", "계좌번호를 확인해 주시기 바랍니다.")
		return False
	end if
	
	if EdtPswd.caption == "" or EdtPswd.caption == null then
		Form.ShowAlert("알림", "계좌 비밀번호를 입력해 주세요.")
		return False
	end if
	
	dim szCode
	szCode = cont0.Table0.GetCellString(0, 1)
	if szCode == "" or szCode == null then
		Form.ShowAlert("알림", "종목 정보가 없습니다.")
		return False
	end if
	
	if cont0.Edit0.caption == "" or CInt(cont0.Edit0.caption) <= 0  then
		Form.ShowAlert("알림", "신청 수량을 입력해 주시기 바랍니다.")
		return False
	end if
	
	return true
End Function

'============================================================================
Function f_Proc()
	'매수청구 신청																		> test skip
	DATAMANAGER.RequestTranData( "obrgt_dmac_108a" )
End Function

'============================================================================
Sub Form_OnFormInitBefore()
	g_bFlag = false
	g_sPlain_rm = Form.GetSharedData("&g_sPlain_rm" , false) '암호화 여부
	g_OsType = Form.GetSharedData("&OS_TYPE", FALSE )
End Sub

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName( "매수청구 신청" )
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData <> "" and szOpenData <> null then
		dim tData
		tData = Split(szOpenData, "★")
		'전달데이터
		'0 : 종목코드
		'1 : 종목명
		'2 : 마감일
		'3 : 기준일
		'4 : 청구금액
		'5 : 전일종가
		'6 : 현금 가능 수량
		'7 : 신용 가능 수량
		'8 : 유통 가능 수량
		'9 : 관리 지점코드
		'10 : 매수청구수량
		cont0.Table0.SetCellString(0, 3, tData(0))
		cont0.Table0.SetCellString(0, 1, tData(1))
		cont0.Table0.SetCellString(1, 1, tData(2))
		cont0.Table0.SetCellString(1, 3, tData(3))
		cont0.Table0.SetCellString(2, 1, CDbl(tData(4)))
		cont0.Table0.SetCellString(2, 3, tData(5))
		cont0.Table0.SetCellString(3, 2, CDbl(tData(6)))
		cont0.Table0.SetCellString(4, 2, CDbl(tData(7)))
		cont0.Table0.SetCellString(5, 2, CDbl(tData(8)))
		g_szMangCode = tData(9)
		cont0.Edit0.caption = CDbl(tData(10))
		if CDbl(tData(10)) > 0 then
			btnReg.enable = FALSE
			cont0.Edit0.enable = FALSE
		end if 
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p9" or sKeyName == "mhetc90060_pa" or sKeyName == "mhetc90060_pb"  or sKeyName == "mhetc90060_motp" then
		if sRet == "ok" then
			Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)		'공인인증서_비밀번호입력 풀팝업	> test skip
		end if 													'							> test skip
	elseif sKeyName == "mhetc90060_p5" then 							'							> test skip
		if sRet ~= "cancel" then									'							> test skip
			f_Proc()
		end if
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
	elseif sKeyName == "mhetc90190_p1" then										
		'if sRet == "ok" then									
		'end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obrgt_dmac_108a" then
		Dim sPwd, szDate
		'비밀번호 암호화
		If g_sPlain_rm == "1" Then
		    sPwd = EdtPswd.caption
		Else
		    sPwd = EdtPswd.encdata
		    if Trim(sPwd) == "" or Trim(sPwd) == null then
			    sPwd = EdtPswd.caption
		    end if
		End If
		'InBlock1
		szDate = cont0.Table0.GetCellString(1, 3)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"	, 0, "1"				)'처리구분코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "JOB_CLS_CODE"	, 0, "U"				)'작업구분코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RGHT_STND_DATE"	, 0, szDate			)'기준일자
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MANG_BRCD"		, 0, g_szMangCode		)'관리지점코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"			, 0, acnt0.total		)'계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"			, 0, acnt0.sequence	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD"			, 0, sPwd			)
		
		dim szItemCode, szDMPR_ABLE_QTY
		szItemCode = cont0.Table0.GetCellString(0, 3)
		szDMPR_ABLE_QTY = cont0.Edit0.caption
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD"				, 0, szItemCode 				)'종목코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DMPR_QTY"			, 0, szDMPR_ABLE_QTY 			)'현금 신청 수량
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DMPR_PRC_PRCN_YN"	, 0, "Y"						)'매수청구가격찬반여부
		
	elseif szTranID == "obcsb_oimf_625r" then
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		sACNO = acnt0.total
		
		'v0001
		'AS-IS
		'sACNO_PWD = Form.GetEncData(g_szList(2))
		
		'TO-BE
		'obcsb_oimf_625r 에 pw전달하지 않아도됨. 기존 g_szList(2)는 rght_type_code로, 잘못된 값 전달중이었음. 삭제처리.
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 		, 0 , "5" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "REG_CLCD" 			, 0 , "1" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DRNG_ACNO" 			, 0 , sACNO )
		'DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_BANK_CODE" 		, 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_ACNO" 			, 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TACT_AMT" 			, 0 , "" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_TERM_IDNT_KEY" 	, 0 , sDeviceID )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrgt_dmac_108a" then
		Dim sMsg, sSubMsg
		sMsg = DATAMANAGER.GetDataMsgText( szTranID )
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			sMsg = sMsg.." "..sSubMsg
		end if
		
		Form.MsgBox( "알림", sMsg, "", 6 )
		
		btnReg.enable = FALSE
		g_bFlag = true
		Form.CloseForm()
	elseif szTranID == "obcsb_oimf_625r" then	'보안인증
		Dim sSPLM_ATHN_NCSR_YN 
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			Case "4"
				Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "")		'공인인증서_일반/스마트OTP
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubMsg <> null and Trim(szSubMsg) <> "" Then
		szErrMsg = szErrMsg & "(" & szSubMsg & ")" 
	end if
	
	Form.ShowAlert( "알림", szErrMsg )
End Sub

'============================================================================
Sub cont0_Edit0_OnEditComplete()
	g_szPreKeyPad = "Edit0"
	
	if g_OSType <> "1" and g_szPreKeyPad == g_szCurKeyPad then
		cont0.lblScrollPos.top = 0
		cont0.SetScrollAutoSize()
		cont0.scroll_pos = 0
	end if
	
	dim nAbleQty, nEdit0
	nAbleQty = CDbl(cont0.Table0.GetCellString(3, 2))
	nEdit0 = CDbl(cont0.Edit0.caption)
	
	if nEdit0 > nAbleQty then
		Form.ShowAlert("알림", "현금 가능 수량보다 큽니다.")
		cont0.Edit0.caption = "0"
		Exit Sub
	end if
End Sub

'============================================================================
Sub cont0_Edit0_OnClick()
	IF g_OsType <> "1" THEN '안드로이드가 아닌경우에만
		g_szCurKeyPad = "Edit0"
		
		if g_OSType <> "1" then
			cont0.lblScrollPos.top = 500
			cont0.SetScrollAutoSize()
			cont0.scroll_pos = 80
		end if
	END IF 
End Sub

'============================================================================
Sub btnReg_OnClick()
	if f_CheckBefore() then
		DATAMANAGER.RequestTranData( "obcsb_oimf_625r" )
'		f_Proc() 'TEST
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	if g_bFlag == true then
		Form.SendReturnToParent( "REG_FIN" , "")
	end if
End Sub

'============================================================================
'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
'============================================================================
Sub RegisterOTP()
	'계좌번호★주민번호(필수아님)★Y/N( 모바일OTP/타기관OTP 발급 완료 후 인증 처리 진행여부를 판단함)★Y/N(처리 완료시 화면닫기)	
	Form.OpenPopup("mhetc90190_p1", acnt0.total &"★"& "" &"★"& "N" &"★"& "Y", "")	
End Sub

