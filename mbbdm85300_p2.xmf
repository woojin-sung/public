		<LABEL name="titleLabel0" fontsize="2" fontstyle="01" caption="알 림" halign="1" ly_vert="49,188,275,32,1" />
		<IMAGE name="Image0" imgpath="icon_main_13" ly_vert="304,169,21,21,1" />
		<BUTTON name="ButtonO" caption="확인" fontsize="2" btnimage="btn_22.9" ly_vert="29,327,312,60,1" />
		<TABLE name="Table0" insidelinecolor="102:255255255" colcount="1" rowcount="2" outline="0000" designorder="1" ly_vert="62,247,250,40,1" >
			<COL_INFO ly_vert_width="250" />
			<ROW_INFO ly_vert_height="20,20" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" line="0,0" caption="바이오인증 등록을" impidxs="" />
				<CELL cell_ly="0,1,0,1" line="0,0" caption="중단하시겠습니까?" impidxs="" />
			</CELL_INFO>
		</TABLE>
		<TABLE name="Table1" insidelinecolor="102:255255255" colcount="1" rowcount="3" outline="0000" designorder="1" ly_vert="55,233,250,65,1" >
			<COL_INFO ly_vert_width="250" />
			<ROW_INFO ly_vert_height="20,20,25" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" line="0,0" impidxs="" />
				<CELL cell_ly="0,1,0,1" line="0,0" impidxs="" />
