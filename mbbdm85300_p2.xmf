	</CONTROL_INFO>
	<SCRIPT_INFO _len="862" _ulen="862" >
'============================================================================
Sub Form_OnFormInit()
	Image2.imgpath = "alpha128.png"

	ErrorMsg = Form.GetOpenLinkData()
	
	if len(ErrorMsg) > 0 then
		errormsg = Split(ErrorMsg, ".")
		Table1.SetCellString(0, 0, errormsg(0)&".")
		
		if len(errormsg(1))>0 then
			Table1.SetCellString(1, 0, errormsg(1)&".")
		else
			exit sub
		end if
		
		if len(errormsg(2))>0 then
			Table1.SetCellString(2, 0, errormsg(2)&".")
		else
			exit sub
		end if
		
	end if
End Sub
'============================================================================


'============================================================================
Sub ButtonO_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
