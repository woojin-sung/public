'============================================================================
' 전문/일반 금융소비자 확인
'============================================================================

Dim	g_KYC_SPCL_INVR_YN	'전문투자자여부
Dim	g_szRcnoRip
Dim	g_szShortCd
Dim	g_szStndCd
Dim	g_szRmndNo
Dim	g_szGb
Dim	g_szClick

Dim g_szClsCd, g_szGrpCd, g_szGrpDetlCd

Dim g_AccNo
Dim g_FNPR_JOIN_SRNO
Dim g_LoanYN
Dim g_Jumin
'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()

	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")
	end if

	g_AccNo			= Form.GetSharedData( "SPCL_CNFR_ACNO", true )
	g_FNPR_JOIN_SRNO	= Form.GetSharedData( "FNPR_JOIN_SRNO", False )
	g_LoanYN			= Form.GetSharedData( "LoanYN", true )
	g_Jumin 			= Form.GetSharedData( "&JUMIN_NUM", false )

	DATAMANAGER.RequestTranData( "obcsb_acif_721r" )
	
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	g_szClick = "CANCEL_mbonl81010_p20" 
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	g_szClick = "CANCEL_mbonl81010_p20" 
	Form.SetSharedData( "81010_P20_RST", szRslt )
	
'홈화면으로 가기
'	Form.OpenScreen("41000", "")
	
'전체메뉴 오픈
'	Form.OpenMainMenuWithIndex(0, 1, 0)

	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	g_szClick = "NEXT_mbonl81010_p20" 
	DATAMANAGER.RequestTranData( "obcsb_acif_723a" ) 
'	Dim szSendData
'	szSendData = g_KYC_SPCL_INVR_YN & "★" & g_szRcnoRip & "★" & g_szShortCd & "★" & g_szStndCd & "★" & g_szRmndNo & "★" & g_szGb
'	Form.OpenPopup("mbfnp51000_p8", szSendData, sPosInfo)
End Sub

'''****************************************************************************
'''               		D A T A				M A N A G E R               
'''****************************************************************************

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obcsb_acif_721r" then	
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "RCNO_PIP" , 0, g_Jumin )
	elseif szTranID == "obcsb_acif_723a" then	
		
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FNPR_JOIN_SRNO" 		, 0, g_FNPR_JOIN_SRNO 	)	'금융상품가입일련번호	'필수
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "PFIN_CLS_CODE" 		, 0, g_szClsCd 		) 	'전문투자자구분코드	'필수
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FNCM_GRP_CODE" 		, 0, g_szGrpCd 		)	'금융소비자그룹코드	'필수
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FNCM_GRP_DETL_CODE" 	, 0, g_szGrpDetlCd 	)	'금융소비자그룹세부코드	'전문투자자일경우 필수
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "ACNO" 				, 0, g_AccNo )	
		
'		DATAMANAGER.SetDataValue( false, "obcsb_acif_723a", "InBlock1", "FNPR_JOIN_DETL_SRNO" 	, 0, szRcnoRip )	'금융상품가입세부일련번호
'		DATAMANAGER.SetDataValue( false, "obcsb_acif_723a", "InBlock1", "RCNO_PIP" 			, 0, szRcnoRip )	'실명확인번호
'		DATAMANAGER.SetDataValue( false, "obcsb_acif_723a", "InBlock1", "RCNO_TYPE_CODE" 		, 0, szRcnoRip )	'실명확인번호 유형코드
'		DATAMANAGER.SetDataValue( false, "obcsb_acif_723a", "InBlock1", "PXPR_YN" 			, 0, szRcnoRip )	'대리인여부
'		DATAMANAGER.SetDataValue( false, "obcsb_acif_723a", "InBlock1", "PXPR_NAME" 			, 0, szRcnoRip )	'대리인명
'		DATAMANAGER.SetDataValue( false, "obcsb_acif_723a", "InBlock1", "PXPR_BRDT" 			, 0, szRcnoRip )	'대리인생년월일
'		DATAMANAGER.SetDataValue( false, "obcsb_acif_723a", "InBlock1", "CUST_RLTS_CODE" 		, 0, szRcnoRip )	'고객관계코드
'		DATAMANAGER.SetDataValue( false, "obcsb_acif_723a", "InBlock1", "CUST_RLTS_ETC_CNTT" 	, 0, szRcnoRip )	'고객관계기타내용
	end if
end Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	

Dim szSpclYN
	if szTranID == "obcsb_acif_721r" then		
		
		g_szClsCd 		= DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "PFIN_CLS_CODE" 		, 0 ) 	'전문투자자구분코드
		g_szGrpCd 		= DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "FNCM_GRP_CODE" 		, 0 )	'금융소비자그룹코드
		g_szGrpDetlCd 	= DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "FNCM_GRP_DETL_CODE" 	, 0 )	'금융소비자그룹세부코드
		g_szGrpNm		= Form.getMetaData("금융소비자그룹코드", g_szGrpCd)
		
		szSpclYN = "N" '초기화

		If g_LoanYN == "Y" Then '대출성
		    If g_szGrpCd == "A" Or g_szGrpCd == "B" Or g_szGrpCd == "E" Or g_szGrpCd == "G" Or g_szGrpCd == "H" Or g_szGrpCd == "Y" Then
			    szSpclYN = "Y"
		    Else
			    szSpclYN = "N"
		    End If
		Else '투자성
		    If g_szGrpCd == "A" Or g_szGrpCd == "B" Or g_szGrpCd == "C" Or g_szGrpCd == "D" Or g_szGrpCd == "E" Or g_szGrpCd == "F" Then
			    szSpclYN = "Y"
		    Else
			    szSpclYN = "N"
		    End If
		End If
		
		If szSpclYN == "N" Then
			Container0.Table1.height = 50
			Container0.Label1.caption = "고객님은 일반금융소비자 입니다."
			Container0.Label1.changeTextAttr(5, 7, 6, 0, true)			
			Container0.Label7.visible = 0			
			Container0.Label6.visible = 0

			Container0.Table0.top = 100
			Container0.Label2.top = 120
			Container0.Label3.top = 180
			Container0.Label4.top = 240
'			Container0.Label4.top = 255
		Else
			Container0.Table1.height = 100
			Container0.Label1.caption = "고객님은 전문금융소비자 입니다."
			Container0.Label1.changeTextAttr(5, 7, 6, 0, true)
			Container0.Label7.caption = g_szGrpNm
			Container0.Label7.visible = 1
			Container0.Label6.visible = 1
			Container0.Label6.top = 165

			Container0.Table0.top = 200
			Container0.Label2.top = 220
			Container0.Label3.top = 280
			Container0.Label4.top = 340
'			Container0.Label4.top = 355
		End If
		
		DATAMANAGER.ClearInputData( 0, "obcsb_acif_721r" )
		
	elseif szTranID == "obcsb_acif_723a" then	
		
		szRslt = DATAMANAGER.GetDataValue( false, "obcsb_acif_723a", "OutBlock1", "RSLT_CLS" 	, 0 )
		
		Form.SetSharedData( "81010_P20_RST", szRslt )
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
end Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl81010_p20_CLOSE", g_szClick	)
End Sub

'============================================================================
Sub Container0_lblMore_OnClick()
	Form.openPopupAnimation("mbonl81010_p21", "" ,"","2")
End Sub

