'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData 

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("유의사항")
	g_sRetData = "cancel"
	
	Container0.Label0.caption = 	"·업무처리 가능시간 : 평일 08:00 ~ 17:00\n"&
								"    (지점 업무 마감 후에는 불가)\n\n"&
								"·만기연장 신청 가능 조건\n"& 
								"    - 만기연장 신청 시, 해당 종목이 신용공여\n"&
								"      불가 종목인 경우 연장처리 불가합니다.\n"&
								"    - 담보부족 및 이자미납계좌일 경우 연장\n"&
								"      처리 불가합니다.\n"&
								"    - 만기 10영업일 전부터 만기일까지 90일\n"& 
								"      단위로 연장신청 가능합니다.\n"&  
								"      (A,B군:요건 충족 시 횟수제한 없음,\n"&  
								"       C군 :요건 충족 시 90일 단위\n"&
								"                총기간 360일까지 연장가능)\n"& 
								"·이자율\n"&
								"    - ~ 20년 11월 6일 매수분까지 : \n"&
								"        이자율은 신용매수시점부터 상환시점까지의\n"&
								"        보유기간 중 일정기간별로 이자율을 \n"&
								"        다르게 적용하는 체차방식입니다.\n"&
								"    - 20년 11월 9일 신규매수분부터 : \n"&
								"        이자율은 신용매수시점부터 상환시점까지의\n"&
								"        보유기간에 따른 최종 이자율을 적용하는 \n"&
								"        소급방식입니다. \n"&
								"※ 상세 이자율은 당사 홈페이지(www.imeritz.com\n"&
								"     >고객지원>서비스안내>신용/대출안내\n"&
								"     >신용거래융자/대주),당사 HTS 프로그램\n"&
								"     (화면번호 7485)에서 조회 가능\n"
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl82020_p9" , g_sRetData)
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.SendReturnToParent("mbonl82020_p9" , g_sRetData)
	Form.CloseForm()
End Sub

