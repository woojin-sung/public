'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.SetChartType("pie")
End Sub




'============================================================================
Sub Form_OnFormInit()
	
	prtf_id = Cstr(Form.GetOpenLinkData())
	
	DATAMANAGER.SetDataValue(0, "obcpp_intr_702r", "InBlock1", "PRTF_ID" , 0 , prtf_id)
	DATAMANAGER.RequestTranData("obcpp_intr_702r")
	
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	cnt = DATAMANAGER.GetDataCount(0, "obcpp_intr_702r" , "OutBlock1")
	tmp2=""
	tmp3=""
	
	for i = 0 to cnt
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_702r", "OutBlock1", "PRTF_NAME", i)
	
	if i<8 then
	tmp2 = tmp2&tmp&";"
	
	else
	tmp2 = tmp2&tmp
	
	end if
	
	Table0.SetCellString(i+1, 0, tmp)
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_702r", "OutBlock1", "INP_LRNK_ISSU_RLIM", i)
	
	
	if i<8 then
	tmp3 = tmp3&tmp&";"
	
	else
	tmp3 = tmp3&tmp
	
	end if
	
	
	
	Table0.SetCellString(i+1, 1, round(tmp,2)&"%")
	
	
	next
	
	
	ChartEx0.SetAccrueData(tmp2&"="&tmp3&"=2=bottom")
	
	
	
	
	
End Sub

'============================================================================


'============================================================================
Sub Table0_OnClick(lRow , lColumn)
    
	
	Form.OpenPopup("mbetc99000_s31",DATAMANAGER.GetDataValue(0, "obcpp_intr_702r", "OutBlock1", "INP_LRNK_ISSU_URL", lRow-1 ) ,"")
	
	
End Sub


