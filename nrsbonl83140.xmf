'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'조회
'============================================================================
Function requestData()
 	f_ClearData()
	Pannel0.rowcount = 0
	
	if g_szGubun == "1" then  '조회/취소
		g_szProsClsCode = "4"
		lbNoticeMsg.caption = "반대의사/매수청구 취소내역이 존재하지 않아요."
	else '반대의사/매수청구
		g_szProsClsCode = "3"
		lbNoticeMsg.caption = "반대의사/매수청구 내역이 존재하지 않아요."
	end if
	
	'계좌체크
	if acnt0.total == "" or acnt0.total == null then
		'Form.ShowAlert("알림", "계좌번호를 확인해 주시기 바랍니다.")
		imgNotice.left = 160
		lbNoticeMsg.left = 0
		return False
	else
		imgNotice.left = 560
		lbNoticeMsg.left = 500	
	end if	
	
	DATAMANAGER.RequestTranData("obrgt_stpm_007r")
end Function

'============================================================================
