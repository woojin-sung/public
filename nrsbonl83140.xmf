Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "OPEN_TAB1_REG_POPUP" then
		if sParam <> "" and sParam <> null then
			Form.OpenFramePopup("mbonl83140_p1", sParam, "")
		end if
	elseif sEventName == "OPEN_TAB2_REG_POPUP" then
		if sParam <> "" and sParam <> null then
			Form.OpenFramePopup("mbonl83140_p2", sParam, "")
		end if
	end if
End Sub

