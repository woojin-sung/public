'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "nrsbonl83140_p1" then '반대의사 신청/취소
		'fmtab0.currenttab = "1" '조회
		'Pannel0.SetPropCardCell("enable", "Button0", g_nSelectRow, "false")
		if sRet == "ok2" then '취소
			requestData()	'재조회	
		else '신청
			requestData()	'재조회	
		end if
	elseif sKeyName == "nrsbonl83140_p2" then '매수청구 신청/취소
		'fmtab0.currenttab = "1" '조회
		'Pannel0.SetPropCardCell("enable", "Button0", g_nSelectRow, "false")
		if sRet == "ok2" then '취소
			requestData() '재조회		
		else '신청
			requestData() '재조회
		end if 		
	elseif sKeyName == "REG_FIN" then
		requestData()
	end if
End Sub

