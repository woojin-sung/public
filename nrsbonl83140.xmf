'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
'
	'------------------------------ SET INPUT ------------------------------
	'고객정보조회
	If szTranID == "obrgt_stpm_007r"  then '반대의사/매수청구

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CSNO" 		, 0 , Form.GetSharedData("&CUST_NUM", false ) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD" 		, 0 , "%" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE" 		, 0 , g_szProsClsCode )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 				, 0 , g_sAcno )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 				, 0 , g_sAsno )
		
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obrgt_stpm_007r" then   '반대의사/매수청구
		Dim nCnt, szClsNm, szCnclAbleYn
		Dim j
		
		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")	
		if nCnt == 0 then
			imgNotice.left = 160
			lbNoticeMsg.left = 0
			Pannel0.rowcount = 0
			Exit Sub
		else
			imgNotice.left = 560
			lbNoticeMsg.left = 500
		end if 

		Pannel0.rowcount = g_nIndex + nCnt
'msgbox Pannel0.rowcount		
		for i = 0 to nCnt-1		
			j = i + g_nIndex
			
			'종목명
			Pannel0.SetCellValue( "Label6", j, Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KOR_ISNM" , i))) 
			'권리유형
			'szRghtCd = Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RGHT_TYPE_CODE" , i))'권리유형코드
			'처리구분명
			szClsNm = Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PROS_CLS_NAME" , i))
			'취소가능여부
			szCnclAbleYn = Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CNCL_ABLE_YN" , i))			
			'if szClsNm == "매수청구" then
			if InStr(szClsNm, "매수청구") > 0  then
			
				Pannel0.SetCellValue( "Label11", j, szClsNm)			
				if g_szGubun == "1" then  '조회/취소
					'Pannel0.SetCellValue( "Label11", j, "매수청구완료")			
					Pannel0.SetCellValue( "Button0", j, "취소하기") '취소하기버튼		

					if szCnclAbleYn == "Y" then '취소가능
						Pannel0.SetPropCardCell("btnimage", "Button0", j, "btn_line.9")
						Pannel0.SetPropCardCell("fgcolor", "Button0", j, "12")					
						'Pannel0.SetPropCardCell("enable", "Button0", j, "true")
					else
					
						Pannel0.SetPropCardCell("btnimage", "Button0", j, "btn_line2.9")
						Pannel0.SetPropCardCell("fgcolor", "Button0", j, "100")
						if InStr(szClsNm, "접수") > 0  then
							Pannel0.SetCellValue( "Button0", j, szClsNm) '매수청구 접수중
						end if '취소하기 
						Pannel0.SetPropCardCell("enable", "Button0", j, "false")
					end if 				
					
				else
					'Pannel0.SetCellValue( "Label11", j, "매수청구")	
					Pannel0.SetCellValue( "Button0", j, "신청하기") '신청하기버튼
					Pannel0.SetPropCardCell("btnimage", "Button0", j, "btn_15.9")
					Pannel0.SetPropCardCell("fgcolor", "Button0", j, "62")
					if InStr(szClsNm, "완료") > 0  then
						Pannel0.SetPropCardCell("btnimage", "Button0", j, "btn_line2.9")
						Pannel0.SetPropCardCell("fgcolor", "Button0", j, "100")
						Pannel0.SetCellValue( "Button0", j, "신청완료")
						Pannel0.SetPropCardCell("enable", "Button0", j, "false")
					else
						'Pannel0.SetPropCardCell("btnimage", "Button0", j, "btn_15.9")
						Pannel0.SetPropCardCell("btnimage", "Button0", j, "btn_15.9")
						Pannel0.SetPropCardCell("fgcolor", "Button0", j, "62")
						'Pannel0.SetPropCardCell("enable", "Button0", j, "true")
					end if 
				end if 
				
				'매수청구마감일
				Pannel0.SetCellValue( "Label8", j, "매수청구마감일" )
				Pannel0.SetCellValue( "Label10", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DMPR_APLT_BRNC_CLSN_DATE" , i))
			else
				Pannel0.SetCellValue( "Label11", j, szClsNm)	
				if g_szGubun == "1" then  '조회/취소
					'Pannel0.SetCellValue( "Label11", j, "반대의사완료")			
					Pannel0.SetCellValue( "Button0", j, "취소하기") '취소하기버튼				
					if szCnclAbleYn == "Y" then '취소가능
						Pannel0.SetPropCardCell("btnimage", "Button0", j, "btn_line.9")
						Pannel0.SetPropCardCell("fgcolor", "Button0", j, "12")					
						'Pannel0.SetPropCardCell("enable", "Button0", j, "true")
					else
						Pannel0.SetPropCardCell("btnimage", "Button0", j, "btn_line2.9")
						Pannel0.SetPropCardCell("fgcolor", "Button0", j, "100")					
						Pannel0.SetPropCardCell("enable", "Button0", j, "false")
					end if 
				else
					'Pannel0.SetCellValue( "Label11", j, "반대의사")	
					Pannel0.SetCellValue( "Button0", j, "신청하기") '신청하기버튼				
					Pannel0.SetPropCardCell("btnimage", "Button0", j, "btn_15.9")
					Pannel0.SetPropCardCell("fgcolor", "Button0", j, "62")
					if InStr(szClsNm, "반대의사완료") > 0  then
						Pannel0.SetPropCardCell("btnimage", "Button0", j, "btn_line2.9")
						Pannel0.SetPropCardCell("fgcolor", "Button0", j, "100")	
						Pannel0.SetCellValue( "Button0", j, "신청완료")
						Pannel0.SetPropCardCell("enable", "Button0", j, "false")
					else
						Pannel0.SetPropCardCell("btnimage", "Button0", j, "btn_15.9")
						Pannel0.SetPropCardCell("fgcolor", "Button0", j, "62")
						'Pannel0.SetPropCardCell("enable", "Button0", j, "true")
					end if
				end if 
				
				'반대의사마감일
				Pannel0.SetCellValue( "Label8", j, "반대의사마감일" )
				Pannel0.SetCellValue( "Label10", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "OPST_INTN_EXRS_BRNC_CLSN_DATE" , i))
			end if 
	
			 '매수청구가격
			Pannel0.SetCellValue( "Label9", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DMPR_PRC" , i))
			 '기준일자
			Pannel0.SetCellValue( "Label17", j, DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RGHT_STND_DATE" , i))
		Next
		
		if  DATAMANAGER.IsMoreNextData( "obrgt_stpm_007r" ) == True then
			g_nIndex = _tonumber( grdList.rowcount )		
			DATAMANAGER.RequestNextData( "obrgt_stpm_007r" )
		else
			Pannel0.addfooter = "nrsbonl83000_p0.xmf"		
		end if
	end if 
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubMsg <> null and Trim(szSubMsg) <> "" Then
		szErrMsg = szErrMsg & "(" & szSubMsg & ")" 
	end if
	
	Form.ShowAlert( "알림", szErrMsg )	
End Sub

'============================================================================
Function _tonumber(data)
	return tonumber(data) or 0
end Function

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	Dim sTemp
	Dim szSendData, szItemCode, szItemNm, szDeadLine,szDate, szPrc, szPrePrc, szAbleQty1, szAbleQty2, szAbleQty3, szMangCode, szOpstQty1, szOpstQty2, szOpstQty3
	
	'if sCellID == "Button0"  then
		g_nSelectRow = nIndex
		if g_szGubun == "1" then  '조회/취소  취소하기버튼

			g_nSelectRow = nIndex
			sTemp = Pannel0.GetCellValue( "Label11", nIndex)	'반대의사완료,매수청구완료
			if sTemp == "매수청구완료" then

				szItemCode = grdList.GetCellData( "bd_itemcd", nIndex)
				if szItemCode <> "" and szItemCode <> null then
					szItemNm = grdList.GetCellData( "bd_itemnm", nIndex)
					szDeadLine = grdList.GetCellData( "bd_dmprdeaddate", nIndex)
					szDate = grdList.GetCellData( "bd_rgtdate", nIndex)
					szPrc = grdList.GetCellData( "bd_prc", nIndex)
					szPrePrc = grdList.GetCellData( "bd_preprc", nIndex)
					szAbleQty1 = grdList.GetCellData( "bd_dmprqty1", nIndex)
					szAbleQty2 = grdList.GetCellData( "bd_dmprqty2", nIndex)
					szAbleQty3 = grdList.GetCellData( "bd_dmprqty3", nIndex)
					szMangCode = grdList.GetCellData( "bd_mang", nIndex)
					szDmprQty = grdList.GetCellData( "bd_dmprqty", nIndex)
					
					'전달데이터
					'0 : 종목코드
					'1 : 종목명
					'2 : 마감일
					'3 : 기준일
					'4 : 청구금액
					'5 : 전일종가					
					'6 : 현금 가능 수량
					'7 : 신용 가능 수량
					'8 : 유통 가능 수량					
					'9 : 관리 지점코드
					'10: 매수청구수량
					'11 : 작업구분코드(취소 - 2)					
					szSendData = szItemCode & "★" & szItemNm & "★" & szDeadLine 
								& "★" & szDate & "★" & szPrc 
								& "★" & szPrePrc & "★" & szAbleQty1
								& "★" & szAbleQty2 & "★" & szAbleQty3
								& "★" & szMangCode& "★" & szDmprQty 
					if sCellID == "Button0" then
						szSendData = szSendData & "★2"
						'취소
						Form.OpenPopup("nrsbonl83140_p2", szSendData, "취소")
					else 
						szSendData = szSendData & "★0"
						'상세보기
						Form.OpenPopupAnimation("nrsbonl83140_p7", szSendData, "", "2")
					end if 
				end if
				
			elseif sTemp == "반대의사완료" then
		
				szItemCode = grdList.GetCellData( "bd_itemcd", nIndex)
				if szItemCode <> "" and szItemCode <> null then
					szItemNm = grdList.GetCellData( "bd_itemnm", nIndex)
					szDeadLine = grdList.GetCellData( "bd_opstdeaddate", nIndex)
					szDate = grdList.GetCellData( "bd_rgtdate", nIndex)
					szPrc = grdList.GetCellData( "bd_prc", nIndex)
					szPrePrc = grdList.GetCellData( "bd_preprc", nIndex)
					szAbleQty1 = grdList.GetCellData( "bd_opstqty1", nIndex)
					szAbleQty2 = grdList.GetCellData( "bd_opstqty3", nIndex) '유통
					szMangCode = grdList.GetCellData( "bd_mang", nIndex)
					szAbleQty3 = grdList.GetCellData( "bd_opstqty2", nIndex) '신용					
					
					szOpstQty1 = grdList.GetCellData( "bd_opstexrsqty", nIndex)   '반대의사표시수량
					szOpstQty2 = grdList.GetCellData( "bd_opsinputqry1", nIndex)  '반대의사표시신용수량
					szOpstQty3 = grdList.GetCellData( "bd_opsinputqry2", nIndex)  '반대의사표시유통수량					
					
					'전달데이터
					'0 : 종목코드
					'1 : 종목명
					'2 : 마감일
					'3 : 기준일
					'4 : 청구금액
					'5 : 전일종가
					'6 : 현금 가능 수량
					'7 : 유통 가능 수량
					'8 : 관리 지점코드					
					'9 : 신용 가능 수량 231006 추가						
					'10 : 반대의사표시수량 231027 추가	
					'11 : 반대의사표시신용수량 231027 추가	
					'12 : 반대의사표시유통수량 231027 추가
					'13 : 작업구분코드(취소 - 2)
					szSendData = szItemCode & "★" & szItemNm & "★" & szDeadLine 
								& "★" & szDate & "★" & szPrc 
								& "★" & szPrePrc & "★" & szAbleQty1
								& "★" & szAbleQty2 & "★" & szMangCode & "★" & szAbleQty3
								& "★" & szOpstQty1 & "★" & szOpstQty2 & "★" & szOpstQty3 
					if sCellID == "Button0" then
						szSendData = szSendData & "★2"
						'취소
						Form.OpenPopup("nrsbonl83140_p1", szSendData, "취소")
					else
						szSendData = szSendData & "★0"
						'상세보기
						Form.OpenPopupAnimation("nrsbonl83140_p6", szSendData, "", "2")
					end if 
					
				end if		
			end if 
			
			'Form.OpenPopupAnimation("nrsbonl83140_p5", g_sAcno&"★"&g_sAsno, "", "2")
			'계좌비밀번호
			'Form.OpenPopup("nrsbonl83140_p5", g_sAcno&"★"&g_sAsno, "")
			'f_Proc() 'TEST
			
		else '반대의사/매수청구  '신청하기버튼
			sTemp = Pannel0.GetCellValue( "Label11", nIndex)	'반대의사,매수청구
			'if sTemp == "매수청구" then '매수청구
			if InStr(sTemp, "매수청구") > 0  then '매수청구
				g_nSelectRow = nIndex
				szItemCode = grdList.GetCellData( "bd_itemcd", nIndex)
				if szItemCode <> "" and szItemCode <> null then
					szItemNm = grdList.GetCellData( "bd_itemnm", nIndex)
					szDeadLine = grdList.GetCellData( "bd_dmprdeaddate", nIndex)
					szDate = grdList.GetCellData( "bd_rgtdate", nIndex)
					szPrc = grdList.GetCellData( "bd_prc", nIndex)
					szPrePrc = grdList.GetCellData( "bd_preprc", nIndex)
					szAbleQty1 = grdList.GetCellData( "bd_dmprqty1", nIndex)
					szAbleQty2 = grdList.GetCellData( "bd_dmprqty2", nIndex)
					szAbleQty3 = grdList.GetCellData( "bd_dmprqty3", nIndex)
					szMangCode = grdList.GetCellData( "bd_mang", nIndex)
					szDmprQty = grdList.GetCellData( "bd_dmprqty", nIndex)
					
					'전달데이터
					'0 : 종목코드
					'1 : 종목명
					'2 : 마감일
					'3 : 기준일
					'4 : 청구금액
					'5 : 전일종가
					'6 : 현금 가능 수량
					'7 : 신용 가능 수량
					'8 : 유통 가능 수량
					'9 : 관리 지점코드
					'10: 매수청구수량	
					'11 : 작업구분코드(신청 - 1)					
					szSendData = szItemCode & "★" & szItemNm & "★" & szDeadLine 
								& "★" & szDate & "★" & szPrc 
								& "★" & szPrePrc & "★" & szAbleQty1
								& "★" & szAbleQty2 & "★" & szAbleQty3
								& "★" & szMangCode& "★" & szDmprQty 
					if sCellID == "Button0" then
						szSendData = szSendData & "★1"
						'신청	
						Form.OpenPopup("nrsbonl83140_p2", szSendData, "신청")
					else
						if InStr(sTemp, "완료") > 0  then '반대의사완료
							szSendData = szSendData & "★0"
							'상세보기
							Form.OpenPopupAnimation("nrsbonl83140_p7", szSendData, "", "2")
						end if 
					end if 
				end if			
			'elseif sTemp == "반대의사" then '반대의사			
			elseif InStr(sTemp, "반대의사") > 0  then '반대의사			
				g_nSelectRow = nIndex
				szItemCode = grdList.GetCellData( "bd_itemcd", nIndex)
				if szItemCode <> "" and szItemCode <> null then
					szItemNm = grdList.GetCellData( "bd_itemnm", nIndex)
					szDeadLine = grdList.GetCellData( "bd_opstdeaddate", nIndex)
					szDate = grdList.GetCellData( "bd_rgtdate", nIndex)
					szPrc = grdList.GetCellData( "bd_prc", nIndex)
					szPrePrc = grdList.GetCellData( "bd_preprc", nIndex)
					szAbleQty1 = grdList.GetCellData( "bd_opstqty1", nIndex)
					szAbleQty2 = grdList.GetCellData( "bd_opstqty3", nIndex) '유통
					szMangCode = grdList.GetCellData( "bd_mang", nIndex)
					szAbleQty3 = grdList.GetCellData( "bd_opstqty2", nIndex) '신용
					
'					szOpstQty1 = ""
'					szOpstQty2 = ""
'					szOpstQty3 = ""	
					szOpstQty1 = grdList.GetCellData( "bd_opstexrsqty", nIndex)   '반대의사표시수량
					szOpstQty2 = grdList.GetCellData( "bd_opsinputqry1", nIndex)  '반대의사표시신용수량
					szOpstQty3 = grdList.GetCellData( "bd_opsinputqry2", nIndex)  '반대의사표시유통수량						
					
					'전달데이터
					'0 : 종목코드
					'1 : 종목명
					'2 : 마감일
					'3 : 기준일
					'4 : 청구금액
					'5 : 전일종가
					'6 : 현금 가능 수량
					'7 : 유통 가능 수량
					'8 : 관리 지점코드					
					'9 : 신용 가능 수량 231006 추가						
					'10 : 반대의사표시수량 231027 추가	
					'11 : 반대의사표시신용수량 231027 추가	
					'12 : 반대의사표시유통수량 231027 추가						
					'13 : 작업구분코드(신청 - 1)
					szSendData = szItemCode & "★" & szItemNm & "★" & szDeadLine 
								& "★" & szDate & "★" & szPrc 
								& "★" & szPrePrc & "★" & szAbleQty1
								& "★" & szAbleQty2 & "★" & szMangCode & "★" & szAbleQty3
								& "★" & szOpstQty1 & "★" & szOpstQty2 & "★" & szOpstQty3 
					if sCellID == "Button0" then
						szSendData = szSendData & "★1"
						'신청
						Form.OpenPopup("nrsbonl83140_p1", szSendData, "신청")
					else
						if InStr(sTemp, "완료") > 0  then '반대의사완료
							szSendData = szSendData & "★0"
							'상세보기	
							Form.OpenPopupAnimation("nrsbonl83140_p6", szSendData, "", "2")
						end if 
					end if 					
				end if
			end if 
		end if		
	
	'end if 
End Sub

