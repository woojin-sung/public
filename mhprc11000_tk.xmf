'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket
Dim g_szDateIdx, g_szStartDate, g_szEndDate
g_szDateIdx = "0"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
Function Request_Tran_ohhts_metf_012r()
	DATAMANAGER.ClearInputData(false, "ohhts_metf_012r")

	DATAMANAGER.SetDataValue( false, "ohhts_metf_012r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "J" )		'시장구분			
	DATAMANAGER.SetDataValue( false, "ohhts_metf_012r", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , g_szItemCode )	'종목코드
	
	DATAMANAGER.RequestTranData("ohhts_metf_012r")
End Function

Function Response_Tran_ohhts_metf_012r()
	szCd = DATAMANAGER.GetDataValue( false, "ohhts_metf_012r", "OutBlock1", "FID_INPUT_COND_MRKT_CLS_CODE" , 0)
	Request_Tran_oocwi_mall_007r(szCd)
End Function

Function Request_Tran_oocwi_mall_007r(szCd)
	DATAMANAGER.ClearInputData(false, "oocwi_mall_007r")
	DATAMANAGER.SetDataValue( false, "oocwi_mall_007r", "InBlock1", "ISCD"	, 0 , szCd)		'시장구분			
	
	DATAMANAGER.RequestTranData("oocwi_mall_007r")
End Function

'============================================================================
' From일로부터 + @일/개월 가져오기
'============================================================================
Function CalcDate(sType,nDiff)

	sYear = Calendar0.calyear
	sMonth = Calendar0.calmonth
	sDay = Calendar0.calday
	
	sRsltDate = Replace(DateAdd (sType, nDiff,  sYear&"-"& sMonth &"-"& sDay), "-", "")
	return sRsltDate
	
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket	= Form.GetItemCodeInfo( g_szItemCode , "market")
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket	= Form.GetItemCodeInfo( g_szItemCode , "market")
		
		Request_Tran_ohhts_metf_012r()
	end	if	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
			Exit Sub
		End If
	
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		 
		Request_Tran_ohhts_metf_012r()
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_metf_012r" then
		Response_Tran_ohhts_metf_012r()
	end if
End Sub

'============================================================================
Sub btnPeriod_OnClick()
	
	Form.OpenPopupAnimation("mhprc11000_pg" , g_szDateIdx&"@"&Calendar0.caption &"@"&Calendar1.caption, "", "2")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "PERIOD_SET" then
		if sRet == "" then
			Exit Sub
		end if
		
		arrRet = split(sRet, "@")
		
		if #arrRet < 3 then
			Exit Sub
		end if 
		
		g_szDateIdx = arrRet(0)
		Calendar0.caption  = arrRet(1)
		Calendar1.caption  = arrRet(2)
		
		if g_szDateIdx == "0" then
			btnPeriod.caption = "1개월"
		elseif g_szDateIdx == "1" then
			btnPeriod.caption = "3개월"
		elseif g_szDateIdx == "2" then
			btnPeriod.caption = "6개월"
		elseif g_szDateIdx == "3" then
			btnPeriod.caption = "직접입력"
		else
			g_szDateIdx = "0"
			btnPeriod.caption = "1개월"
		end if
		
		Request_Tran_ohhts_metf_012r()
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	szData = CalcDate("m", -1)
	Calendar0.caption = szData
End Sub

'============================================================================
Sub Calendar0_OnEditComplete()
	g_szDateIdx = "3"
	btnPeriod.caption = "직접입력"
	
	if Clng(Calendar0.caption) > Clng(Calendar1.caption) then
		Calendar0.caption = Calendar1.caption
		Form.ShowAlert("알림", "시작일이 종료일 이후 입니다.")
	end if
End Sub

'============================================================================
Sub Calendar1_OnEditComplete()
	g_szDateIdx = "3"
	btnPeriod.caption = "직접입력"
	
	if Clng(Calendar0.caption) > Clng(Calendar1.caption) then
		Calendar1.caption = Calendar0.caption
		Form.ShowAlert("알림", "종료일이 시작일 이전 입니다.")
	end if
End Sub

'============================================================================
Sub grd0_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("oocwi_mall_007r") == true then
		DATAMANAGER.RequestNextData("oocwi_mall_007r")
	end if
End Sub

