'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 계좌비밀번호 재입력
' 02. 화면설명 : 계좌비밀번호 재입력
' 03. 작    성 : 2021.01.22 김유경
' 04. 수    정 :  
'-------------------------------------------------------------------------------------------
'****************************************************************************
' EdtPwReal : 실제 비밀번호 인증 과정 구현하는 에디트
' EdtPwFake : 사용자에게 보여지는 비밀번호입력 에디트 
'****************************************************************************

Dim nCnt

Dim gWRPL_TELNO
Dim gCLPH_TELNO
Dim gOWHS_TELNO
Dim gPW_PIP

Dim CloseFlag
CloseFlag = 0

Dim g_OsType

Dim g_CharFlag 'iOS의 경우 키패드의 취소와 입력완료를 구분할 수 없어서 Flag 값으로 구분
Dim g_CountSave
'************************* 참고 ********************************************
'취소버튼과 입력완료 버튼이 OnEditChar에 동일하게 "2"로 떨어집니다.
'입력완료의 경우에만 OnEditComplete()을 탑니다.
'***************************************************************************

'============================================================================
Sub Form_OnFormInit()

	g_OsType = Form.GetSharedData("&OS_TYPE", False)

	nCnt = 0	

	'Container1Step.EdtPwFake.imagefilepth = "alpha"
	Container1Step.Button0.imagefilepth   = "alpha"
	Container1Step.Image0.imagefilepth    = "icon_top_back_light"
	Container1Step.Label2.fgcolor         = 268
	Container1Step.Image2.imagefilepth    = "icon_exclamation_r"
	Container1Step.Label5.fgcolor         = 266
	Container1Step.Image3.imagefilepth    = "icon_arrow_right_on"
	Container1Step.Button1.imagefilepth   = "alpha"
	
	
	Container1Step.EdtPwChkReal.SetApplyLabel("숫자입력"	,0 , 76 , "left" , true) '호출해야 정상작동
	Form.SetTimerEvent2(1, 1, 0.5) '1초뒤 보안키패드 활성화
	
	'휴대폰번호
	HP1 = Form.GetSharedData("BDM_HP1" , false )
	HP2 = Form.GetSharedData("BDM_HP2" , false )
	HP3 = Form.GetSharedData("BDM_HP3" , false )
	gCLPH_TELNO = HP1 & HP2 & HP3
	
	gWRPL_TELNO = Form.GetSharedData("BDM_WRPLNUM"	, false )
	gOWHS_TELNO = Form.GetSharedData("BDM_OWHSNUM"	, false )
	
	gRCNO = Form.GetSharedData("BDM_RCNO_PIP"  , false ) '주민등록번호
	gRegUniqNo  = Form.GetSharedData("BDM_REG_UNIQ_NO" , false ) '등록고유번호
	
	gPW_PIP     = Form.GetSharedData("BDM_PW_PIP"      , false ) '비밀번호
	gCNFR_PW_PIP= Form.GetSharedData("BDM_CNFR_PW_PIP" , false ) '비밀번호확인
	gPW_PIP_ARIA = Form.GetSharedData("BDM_PW_PIP_ARIA", false ) '비밀번호 

	Container1Step.EdtPwReal.caption = gPW_PIP
	
'	If g_OsType == "2" Then
'		Container1Step.EdtPwChkReal.setHideCancel(true)
'	End If
	
End Sub

'============================================================================
Sub Container1Step_EdtPwChkReal_OnEditComplete()
	'입력완료 시에만 타게끔(취소는 안타고)
	if g_DeviceOS == "2"  then
		g_CharFlag = "N"
		PasswordInsert()

	end if
	
	'비밀번호 등록 완료
	gCNFR_PW_PIP = Container1Step.EdtPwChkReal.caption
	
	Form.SetSharedData("BDM_CNFR_PW_PIP", Container1Step.EdtPwChkReal.caption ) '비밀번호
	
	DATAMANAGER.RequestTranData("obaci_nmet_011r") '키패드 입력완료 시 검증 TR Call
End Sub
'===========================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obaci_nmet_011r" Then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"  , 0 , "2")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD_PIP"        , 0 , gPW_PIP_ARIA ) '계좌번호입력에서 넘어온 데이터 Container1Step.EdtPwReal.caption2
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CNFR_PWD_PIP"   , 0 , Container1Step.EdtPwChkReal.caption2) '재입력 화면에서 입력한 데이터
	
	ElseIf szTranID = "obaci_acct_059c" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_UNIQ_NO" 			, 0 , gRegUniqNo			     ) '등록고유번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_STAG_CLS_CODE" 		, 0 , "3"				     ) '등록단계구분코드
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock6",  "ACNT_PWD" 			, 0 , gPW_PIP				     )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock6",  "UI_CNFR_PWD" 		, 0 , gCNFR_PW_PIP		     )
	End If
End Sub 

'===========================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim gProsClsCode , gRsltCode
		
	If szTranID = "obaci_nmet_011r" Then
		gProsClsCode = ""
		gRsltCode    = ""
		
		gProsClsCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "PROS_CLS_CODE" , 0)
		gRsltCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "IF_RSLT_CODE"  , 0)
		
		If gProsClsCode == "2" and TRIM(gRsltCode) <> "00" Then
			nCnt = 0
			
			Container1Step.Label2.visible = False '다시 한번 입력해주세요.
			
			Container1Step.Image2.visible = True
			Container1Step.Label5.visible = True  '계좌비밀번호가 일치하지 않습니다.
			
			Container1Step.Label3.visible = True  '다시입력하기
			Container1Step.Image3.visible = True
			
			'Container1Step.EdtPwChkFake.caption = ""
			Container1Step.EdtPwChkReal.caption = ""
			
			'Container1Step.EdtPwChkFake.fgcolor = "1"   '에디트 글자 빨간색 변환
			'PasswordFail()
			PasswordInsert()
			
			Container1Step.EdtPwChkReal.SetShowKeypad(True)
			
			'Call PasswordInsert() '2021.04.29. 김유경 주석처리
			
			'Form.OpenPopup("mbbdm86180_p1", gRsltCode , "" ) '2021.04.05 비밀번호 재입력하는 화면에서는 MPOP 제거
			
		Else '비밀번호 체크 성공 시
			Container1Step.Label2.visible = True  '다시 한번 입력해주세요.
			
			Container1Step.Image2.visible = False
			Container1Step.Label5.visible = False '계좌비밀번호가 일치하지 않습니다.
			
			Container1Step.Label3.visible = False  '다시입력하기
			Container1Step.Image3.visible = False
			
			'Container1Step.EdtPwChkFake.fgcolor = "2"   '에디트 글자 파란색 변환

			'Container1Step.EdtPwChkFake.caption = " ●   ●   ●   ●   ●   ●"
			Call PasswordInsert()
			
			Form.SetTimerEvent2(2, 1, 0.5) '1초뒤 화면 넘어감
'	
'			'비밀번호 등록 완료
'			'Form.OpenPopup("mbbdm86181" , "" , "" )
'			'Form.CloseForm()

		End If
	
	ElseIf szTranID = "obaci_acct_059c" Then
		 Form.OpenNextPopup("mbbdm86190", "", "")
	End If
End Sub 

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = trim(DATAMANAGER.GetDataMsgSubText(szTranID))

'	If szTranId = "obaci_nmet_011r" Then	
'	
'	End If  

	if szTranID == "obaci_acct_059c" then
		if szErrCode == "4572" or szErrCode == "4480" then
			'Form.ShowAlert("안내", "이미 개설이 완료되었거나, 취소가 된 경우에는" & Chr(13) & Chr(10) & "이어하기가 불가합니다.")
			Form.MsgBox("안내", "이미 개설이 완료되었거나\n취소가 된 경우에는\n이어하기가 불가합니다.", "PrgsExit", 6)
			Exit Sub       
			
		else	
			if szSubMsg == "" or szSubMsg == null then
				Form.ShowAlert("안내", szErrMsg)
			else
				Form.ShowAlert("안내", szErrMsg .. "(" .. szSubMsg .. ")")
			end if			
		end if
	else
		if szSubMsg == "" or szSubMsg == null then
			Form.ShowAlert("안내", szErrMsg)
		else
			Form.ShowAlert("안내", szErrMsg .. "(" .. szSubMsg .. ")")
		end if
	end if	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)

	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0.5)
	
		Container1Step.EdtPwChkReal.SetShowKeypad(True)
		
	ElseIf sTimerID == "2" or sTimerID == 2 then 
		Form.SetTimerEvent2(sTimerID, 0, 0.5)

		'등록완료가 사라졌으므로 바로 obaci_acct_059c 호출
		DATAMANAGER.RequestTranData( "obaci_acct_059c" )
		
		'Form.CloseForm()
	ElseIf sTimerID == "9999" or sTimerID == 9999 then 
		Form.SetTimerEvent2("9999", 0, 0.1)
		if g_OsType == "1" then
			Form.CloseForm()
		end if
	end if
	
End Sub

'============================================================================
'패스워드 글자 개수 카운트
'============================================================================
Sub Container1Step_EdtPwChkReal_OnEditChar(CharCode)

	Select Case CharCode
	
	Case "0"
		
		'입력값 8초과할 때 초과 카운팅 방지
		if nCnt = 8 then
			nCnt = 8
		else
			nCnt = nCnt + 1
		end if
		
	Case "1"
		
		'입력값 없을 때 마이너스 카운팅 방지
		if nCnt = 0 then
			nCnt = 0
		else
			nCnt = nCnt - 1
		end if
	Case "2" '취소

		nCnt = 0
	End Select

	PasswordInsert()	
End Sub

'============================================================================
'사용자에게 보여지는 패스워드 모양 삽입 함수
'============================================================================
Function PasswordInsert()
	
	'입력완료일 시에 따로 개수 세이브해서 UI보이기
	if g_CharFlag = "N" then
		nCnt = g_CountSave
		g_CharFlag = ""
	end if
	
	Select Case nCnt
	
	Case 0
		Container1Step.Pwdbasic0.visible = true	
		Container1Step.Pwdbasic1.visible = true	
		Container1Step.Pwdbasic2.visible = true	
		Container1Step.Pwdbasic3.visible = true	

		Container1Step.PwdInsert0.visible = false	
		Container1Step.PwdInsert1.visible = false	
		Container1Step.PwdInsert2.visible = false	
		Container1Step.PwdInsert3.visible = false	

	Case 1
		Container1Step.Pwdbasic0.visible = false	
		Container1Step.Pwdbasic1.visible = true	
		Container1Step.Pwdbasic2.visible = true	
		Container1Step.Pwdbasic3.visible = true	

		Container1Step.PwdInsert0.visible = true
		Container1Step.PwdInsert1.visible = false	
		Container1Step.PwdInsert2.visible = false	
		Container1Step.PwdInsert3.visible = false		
	Case 2	
		Container1Step.PwdInsert0.visible = true	
		Container1Step.PwdInsert1.visible = true
		Container1Step.Pwdbasic2.visible = true	
		Container1Step.Pwdbasic3.visible = true	
		
		Container1Step.Pwdbasic0.visible = false	
		Container1Step.Pwdbasic1.visible = false
		Container1Step.PwdInsert2.visible = false	
		Container1Step.PwdInsert3.visible = false	
	Case 3
		Container1Step.PwdInsert0.visible = true	
		Container1Step.PwdInsert1.visible = true	
		Container1Step.PwdInsert2.visible = true
		Container1Step.Pwdbasic3.visible = true	
		Container1Step.Pwdbasic0.visible = false	
		Container1Step.Pwdbasic1.visible = false	
		Container1Step.Pwdbasic2.visible = false	
		Container1Step.PwdInsert3.visible = false
	Case 4
		Container1Step.PwdInsert0.visible = true	
		Container1Step.PwdInsert1.visible = true	
		Container1Step.PwdInsert2.visible = true	
		Container1Step.PwdInsert3.visible = true
		Container1Step.Pwdbasic0.visible = false	
		Container1Step.Pwdbasic1.visible = false	
		Container1Step.Pwdbasic2.visible = false	
		Container1Step.Pwdbasic3.visible = false		
	Case else
		Form.ShowAlert("알림", "4자리를 입력해주세요.")
	End Select
	
	Container1Step.PwdFail0.visible = false
	Container1Step.PwdFail1.visible = false
	Container1Step.PwdFail2.visible = false
	Container1Step.PwdFail3.visible = false
End Function

