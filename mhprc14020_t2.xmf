'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim g_szDateLimit 	'날짜제한
dim g_szItemCode	'종목코드
dim g_szMarket		'날짜구분

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'IsValidDate() : 입력된 날짜가 로직에 벗어나지 않는지 체크
'============================================================================
Function IsValidDate()
   
    dim bIsValidDate 
    dim szDataFrom   	
    dim szDataTo 	
    
    bIsValidDate = true
    szDataFrom   = cldFromDateT2.Caption
    szDataTo     = cldToDateT2.Caption
	
    if szDataFrom < g_szDateLimit then
	    Form.ShowAlert( "알림" , "최근1년까지만 조회됩니다." )
	    cldFromDateT2.caption = g_szDateLimit
    end if 
	
	
	If Len(Trim(szDataFrom)) <> 8 then
		Form.ShowAlert("알림" , "날짜입력이 정확하지 않습니다.")
		bIsValidDate = False
		Exit Function
	End if
	
	If Len(Trim(szDataTo)) <> 8 then
		Form.ShowAlert("알림" , "날짜입력이 정확하지 않습니다.")
		bIsValidDate = False
		Exit Function
	End if
	

     If CDbl(Trim(szDataFrom)) > CDbl(Trim(szDataTo)) then
		Form.ShowAlert("알림" , "날짜입력이 정확하지 않습니다.")
		bIsValidDate = False
		Exit Function
     End if

   
     If Trim(szDataFrom) > Form.GetSharedData( "&HOST_DATE" , 0 ) then
		Form.ShowAlert("알림" , "날짜입력이 정확하지 않습니다.")
	    bIsValidDate = False
	    Exit Function
	End if
	
	DATAMANAGER.RequestTranData("ohhts_1103_001r")
	return 0
    
End Function


'============================================================================
'RenameHeader() : 설정값에 따라 그리드 헤더 변경
'============================================================================
Function RenameHeader()
	dim szSectBuySell
	
'	0`순매수
'	1`순매도

	szSectBuySell = rdoBuySellT2.currentindex 
	
	if szSectBuySell = "0"  then 			'순매수
		grdT2.SetCellTopCaption("th_cell4", "순매수")
	elseif szSectBuySell = "1" then         '순매도
		grdT2.SetCellTopCaption("th_cell4", "순매도")
	else
		Form.ShowAlert("알림", "구분값을 확인하세요.")
	end if 
	
End Function 


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()

	g_szItemCode = Form.GetSharedData("&ITEM_STOCK", 0)		' 최근조회종목
	
	if	g_szItemCode <> NULL	and	len(trim(g_szItemCode)) > 3 	then
		ItemCode01.caption = g_szItemCode
		g_szMarket = Form.GetItemCodeInfo(g_szItemCode,	"market")
	
		g_szDateLimit = DateAdd ("yyyy", -1, cldStandardT2.calyear &"-"& cldStandardT2.calmonth &"-"& cldStandardT2.calday)
		g_szDateLimit = replace(g_szDateLimit, "-", "")			'날짜 선택 LIMIT 저장
	end	if
	
	DATAMANAGER.RequestTranData("ohhts_0512_001r")
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'cmbPeriodT2_OnEditComplete
'============================================================================
Sub cmbPeriodT2_OnEditComplete(iIndex)
	if cmbPeriodT2.cbkeydata = ""   then 	'누적기간
		cldFromDateT2.enable = 1
		cldToDateT2.enable = 1
	else
		cldFromDateT2.enable = 0
		cldToDateT2.enable = 0
	end if 
	
	DATAMANAGER.RequestTranData("ohhts_1103_001r")
End Sub


'============================================================================
'rdoBuySellT2_OnClick
'============================================================================
Sub rdoBuySellT2_OnClick(nIndex)
	call RenameHeader()
End Sub


'============================================================================
'cldFromDateT2_OnEditComplete
'============================================================================
Sub cldFromDateT2_OnEditComplete()
	call IsValidDate()
End Sub


'============================================================================
'cldToDateT2_OnEditComplete
'============================================================================
Sub cldToDateT2_OnEditComplete()
	call IsValidDate()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	DATAMANAGER.CancelRealData("ohhts_elw_cntg")
	
	'20230913_01 HWG START : 거래소 시세증속 대응 시세 묶음처리 기능 추가 
	'ohhts_stck_cntg -> ohhts_stck_incg 교체 
	DATAMANAGER.CancelRealData("ohhts_stck_incg")
	'20230913_01 HWG END
	
	if	szTranID = "ohhts_1001_001r" 	then
		DATAMANAGER.SetDataValue(0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarket)
		DATAMANAGER.SetDataValue(0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD", 0, g_szItemCode)
	elseif szTranID = "ohhts_1103_001r" then
		if cmbPeriodT2.cbkeydata = ""   then 	'누적기간
			DATAMANAGER.SetDataValue(0, "ohhts_1103_001r", "InBlock1", "FID_INPUT_CNT1" , 0 , 0)
			DATAMANAGER.SetDataValue(0, "ohhts_1103_001r", "InBlock1", "FID_INPUT_DAY_WEEK_MONTH_YR", 0, "U")
			DATAMANAGER.SetDataValue(0, "ohhts_1103_001r", "InBlock1", "FID_INPUT_ISCD", 0, g_szItemCode)

		else
			DATAMANAGER.SetDataValue(0, "ohhts_1103_001r", "InBlock1", "FID_INPUT_DAY_WEEK_MONTH_YR", 0, "D")
			DATAMANAGER.SetDataValue(0, "ohhts_1103_001r", "InBlock1", "FID_INPUT_DATE1", 0, "00000000")
			DATAMANAGER.SetDataValue(0, "ohhts_1103_001r", "InBlock1", "FID_INPUT_DATE2", 0, "00000000")
			DATAMANAGER.SetDataValue(0, "ohhts_1103_001r", "InBlock1", "FID_INPUT_ISCD", 0, g_szItemCode)  
		end if 
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if	szTranID = "ohhts_0512_001r" then
		if	cmbPeriodT2.cbkeydata <> "" then 			'기간지정
			cldFromDateT2.caption = DATAMANAGER.GetDataValue(0, "ohhts_0512_001r", "OutBlock1", "FID_STND_DATE1", 0)
			cldToDateT2.caption = DATAMANAGER.GetDataValue(0, "ohhts_0512_001r", "OutBlock1", "FID_STND_DATE2", 0)
			
			
			DATAMANAGER.RequestTranData("ohhts_1001_001r")		
			DATAMANAGER.RequestTranData("ohhts_1103_001r")
		end if
		
	elseif szTranID = "ohhts_1103_001r" then	

		nCnt = grdT2.rowcount - 1
		for i = nCnt  to 0 step -1
			sData = grdT2.GetCellData( "bd_cell4", i )
			'	0`순매수
			'	1`순매도
			szSectBuySell = rdoBuySellT2.currentindex 
			
			if szSectBuySell == "0" then
				if CInt(sData) < 0 then
					grdT2.SetDeleteRow(i)
				end if
			else
				if CInt(sData) > 0 then
					grdT2.SetDeleteRow(i)
				end if
			
			end if
		next	
	elseif		szTranID = "ohhts_1001_001r" then
	
		if g_szMarket = "W" then
			DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
		else
			'20230913_01 HWG START : 거래소 시세증속 대응 시세 묶음처리 기능 추가 
			'ohhts_stck_cntg -> ohhts_stck_incg 교체 
			DATAMANAGER.RequestRealData( "ohhts_stck_incg" )
			'20230913_01 HWG END
		end if
	end if 

	call RenameHeader()
End Sub


'============================================================================
'Sub DATAMANAGER_OnSendRealBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	'20230913_01 HWG START : 거래소 시세증속 대응 시세 묶음처리 기능 추가 
	'ohhts_stck_cntg -> ohhts_stck_incg 교체 
	if szTranID = "ohhts_stck_incg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD"  , 0 , g_szItemCode )
	'20230913_01 HWG END
	
	elseif szTranID = "ohhts_elw_cntg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD"  , 0 , g_szItemCode )
	end	if
	
end sub


'============================================================================
'ItemCode01_OnEditComplete
'============================================================================
Sub ItemCode01_OnEditComplete(sCode)
	if sCode <> "" then
			g_szItemCode	=	sCode
			g_szMarket		=	Form.GetItemCodeInfo(sCode,	"market")
	
			DATAMANAGER.RequestTranData("ohhts_1001_001r")		
			DATAMANAGER.RequestTranData("ohhts_1103_001r")
	end if	
End Sub

