	<SCRIPT_INFO _len="2073" _ulen="2041" >
--===========================================================================
Dim g_ACNO
Dim g_ASNO
--===========================================================================
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "oblon_rdmp_905r" then
		DATAMANAGER.SetDataValue(0, "oblon_rdmp_905r", "InBlock1", "ACNO" , 0 , Left(Account0.caption,8))
		DATAMANAGER.SetDataValue(0, "oblon_rdmp_905r", "InBlock1", "ASNO" , 0 , Right(Account0.caption,2))
		DATAMANAGER.SetDataValue(0, "oblon_rdmp_905r", "InBlock1", "LOAN_DTL_TYPE_CODE" , 0 , "%%")
		DATAMANAGER.SetDataValue(0, "oblon_rdmp_905r", "InBlock1", "LOAN_INT_CLS_CODE"  , 0 , "1")
		DATAMANAGER.SetDataValue(0, "oblon_rdmp_905r", "InBlock1", "STND_DATE1" , 0 , Calendar0.caption)
		DATAMANAGER.SetDataValue(0, "oblon_rdmp_905r", "InBlock1", "STND_DATE2" , 0 , Calendar1.caption)
	end if
	
End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	DATAMANAGER.RequestNextData("oblon_rdmp_905r")
End Sub


'============================================================================
Sub Form_OnFormInit()
	Grid0.SetClear()
	DATAMANAGER.RequestTranData("oblon_rdmp_905r")
End Sub

'============================================================================
Sub btnSearch_OnClick()
	DATAMANAGER.RequestTranData("oblon_rdmp_905r")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "oblon_rdmp_905r" then
		for i = 0 to Grid0.rowcount - 1
			loan_dtl_type_name = Form.GetMetaData("대출상세유형코드", Grid0.GetCellData("bd_cell3", i) )
			Grid0.SetCellData("bd_cell0", i, loan_dtl_type_name)
			
			if Grid0.GetCellData("bd_cell12", i) == "1" then
				Grid0.SetCellData("bd_cell1", i, "상환이자")
			elseif Grid0.GetCellData("bd_cell12", i) == "2" then
				Grid0.SetCellData("bd_cell1", i, "정기이자")
			end if
		next
	end if
End Sub

