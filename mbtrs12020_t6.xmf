'============================================================================
Sub btnSearch_OnClick()
	
	If Check_Accout() = False Then
		Exit Sub
	End If
		
	DATAMANAGER.RequestTranData( "obtrs_oder_503a" )
	
End Sub


'============================================================================
Sub Form_OnRefresh()
	btnSearch_OnClick()
End Sub

