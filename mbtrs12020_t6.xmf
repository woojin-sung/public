				Case "63"	grd0.SetCellData( "bd_cell15", i, "장개시전 시간외 바스켓")
				Case "64"	grd0.SetCellData( "bd_cell15", i, "장개시전 시간외 경쟁 대량매매")
				Case "67"	grd0.SetCellData( "bd_cell15", i, "장개시전 시간외대량 자사주 신탁")
