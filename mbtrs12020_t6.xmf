'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문의 처리결과 조회 화면
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------
'20200910 SWJ START 메모리평문제거 (plain_rm = 0 미적용 / plain_rm = 1 적용)
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szTitle
g_szTitle = "알림"

' 20200910 SWJ START 메모리평문제거 구분값
Dim plain_rm
plain_rm =""

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
'============================================================================
'	계좌번호/비밀번호 확인
'	내역조회는 비밀번호 없이 조회가능하도록 수정함. 	20160502 LKM 
'	주문올릴때만 비밀번호 확인하도록 로직 수정
'============================================================================
Function Check_Accout()

'20160502 LKM START

	Dim szAcctNo
	
	szAcctNo = Form.GetCtlProp("#acnt", "caption")
    
    If Len(Trim(szAcctNo)) < 10 Then
	    Form.ShowAlert( g_szTitle, "계좌번호를 확인후 다시 입력하십시오." )
	    Check_Accout = False
	    Exit Function
	End If

	Check_Accout = True
	
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	
End Sub

'============================================================================
Sub Form_OnFormInit()
'	DATAMANAGER.RequestTranData( "obtrs_oder_507r" )
	Call btnSearch_OnClick()
	
	'20200910 SWJ START
	'MTS메모리평문제거 적용유무
	'plain_rm = (0 : 미적용 / 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	If sEventName = "CHANGE_PASS" Then
		btnSearch_OnClick()
	'20160502 LKM START
	elseif sEventName = "CHANGE_ACCT" Then
		
		grd0.rowcount = 0	'기존내역 Clear
			
		If Check_Accout() = False Then
			Exit Sub
		End If
		
		btnSearch_OnClick()
	'20160502 LKM END
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	If szTranID = "obtrs_oder_503a" Then
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "ACNO"			, 0 , Form.GetCtlProp("#acnt", "total") 	)	' 계좌1
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "ASNO"			, 0 , Form.GetCtlProp("#acnt", "sequence") 	)	' 계좌2
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "ACNT_PWD"		, 0 , Form.GetCtlProp("#edtPwd", "caption") 	)	' 계좌비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else	
			DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "ACNT_PWD"		, 0 , Form.GetCtlProp("#edtPwd", "encdata") 	)	' 계좌비밀번호
		end if	
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "DEAL_CLS_CODE"	, 0 , "%" 		)	' 매매구분코드 1매도,2매수,%전체
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "ISCD"			, 0 , "" 		)	' 종목코드
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "DATA_CLS"		, 0 , "1" 		)	' 데이터구분 1전체,2미전송건
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "IQRY_CSNU"		, 0 , 20 		)	' 조회건수
		DATAMANAGER.SetDataValue( 0,  "obtrs_oder_503a", "InBlock1", "IQRY_CLS_CODE"	, 0 , "2" 		)	' 조회구분코드 1취소가능, 2전체
	
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	If szTranID = "obtrs_oder_503a" Then
		For i = 0 To grd0.rowcount -1 
			Dim szODER_CLS_CODE, szRSEV_TYPE_CODE, szADOD_TYPE_CODE, szSTAT_CLS_CODE
			
			szODER_CLS_CODE	= grd0.GetCellData( "bd_cell10" , i)	'매매구분
			szRSEV_TYPE_CODE  = grd0.GetCellData("bd_cell20", i)	'예약구분
			szADOD_TYPE_CODE	= grd0.GetCellData( "bd_cell11", i)	'주문유형
			szSTAT_CLS_CODE	= grd0.GetCellData( "bd_cell21", i)	'처리결과
			szDEAL_CLS_CODE	= grd0.GetCellData("bd_cellD2", i)	
			
			'매매구분
			Select Case szODER_CLS_CODE
				Case "01"	grd0.SetCellData( "bd_cell3", i, "현금매도" )
