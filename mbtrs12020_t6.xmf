				Case "3"	grd0.SetCellData( "bd_cell16", i, "거부")
				
			End Select
		
		Next

	ElseIf szTranID = "obtrs_oder_507r" Then
		cld0.caption = DATAMANAGER.GetDataValue( 0, "obtrs_oder_507r", "OutBlock1", "ODER_DATE" , 0 )
		szAcpw	= Form.GetCtlProp("#edtPwd", "caption")
		If szAcpw <> "" Then
			btnSearch_OnClick()
		end if	
	End If
End Sub

