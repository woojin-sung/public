	<SCRIPT_INFO _len="7621" _ulen="7219" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 담보대출신청
' 02. 화면설명 : 담보대출신청_대출이자가계산
' 03. 작    성 : 2016.02.01 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'계좌컨트롤
'100종합매매,105은행제휴(위탁),106은행제휴(수익)
Dim g_sAcc '계좌번호
Dim g_nNextFlag
Dim G_DETAIL_FILE '이자상세풀팝업

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'===========================================================================
' 계좌비밀번호 입력체크함수
'===========================================================================
Function GetPWCkeck()
	if EditPW.caption == null or EditPW.caption == "" then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	end if
	
	return false
End Function	

'===========================================================================
' 신용공여상세 세팅함수
'===========================================================================
Function SetComboControl()
	Combo0.clear = true
	
	Dim sInput 

	if RdoGubun.currentindex == "0" then
		sInput = "%`전체"
	elseif RdoGubun.currentindex == "1" then
		sInput = "01%`전체\r\n".."0101`자기융자\r\n".."0102`유통융자\r\n".."0103`자기대주\r\n".."0104`유통대주"
	else
		sInput = "02%`전체\r\n".."0201`주식\r\n".."0202`채권\r\n".."0203`집합투자\r\n".."0204`ELS"
	end if
	
	Combo0.cbinputdatatext = sInput
End Function	

'===========================================================================
' 대출이자조회함수
'===========================================================================
Function SetRequestData()
	if EditPW.caption ~= null and EditPW.caption ~= "" then
		g_nNextFlag = false
		Grid0.rowcount = "0"
		DATAMANAGER.RequestTranData( "oblon_pros_876r" ) '대출이자조회
	end if
End Function	

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()	
	Dim sRevData 
	sRevData = Form.GetOpenLinkData()
	g_nNextFlag = false
	G_DETAIL_FILE = "mbonl82020_p5"
	
	if sRevData == null or sRevData == "" then
		g_sAcc = Account0.caption
	else
		Form.SetScreenName("대출이자 가계산")
		
		Dim sTemp
		sTemp = Split(sRevData, ";")
		
		g_sAcc = sTemp[0]
		Account0.caption = g_sAcc
		EditPW.pwdlen  = sTemp[2]
		EditPW.caption = sTemp[1]
		
		Account0.enable = false
	end if
	
	SetRequestData()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sACNT_PWD 
	Dim plain_rm
	
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then
		sACNT_PWD = EditPW.caption
	'MTS메모리평문 미적용상태일때
	else
		sACNT_PWD = Form.GetEncData(EditPW.caption)
	end if
	'MTS메모리보안
	'sACNT_PWD = Form.GetEncData(EditPW.caption)
	if szTranID == "oblon_pros_876r" then
		DATAMANAGER.SetDataValue( 0, "oblon_pros_876r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_876r", "InBlock1", "ASNO" , 0 , Right(g_sAcc, 2) )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_876r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )

		if RdoGubun.currentindex == "0" then
			DATAMANAGER.SetDataValue( 0, "oblon_pros_876r", "InBlock1", "UI_LOAN_CLS_CODE" , 0 , "%" )
		elseif RdoGubun.currentindex == "1" then
			DATAMANAGER.SetDataValue( 0, "oblon_pros_876r", "InBlock1", "UI_LOAN_CLS_CODE" , 0 , "01" )
		else
			DATAMANAGER.SetDataValue( 0, "oblon_pros_876r", "InBlock1", "UI_LOAN_CLS_CODE" , 0 , "02" )
		end if
	
		DATAMANAGER.SetDataValue( 0, "oblon_pros_876r", "InBlock1", "STND_DATE" , 0 , Calendar0.caption )
		DATAMANAGER.SetDataValue( 0, "oblon_pros_876r", "InBlock1", "LOAN_DTL_TYPE_CODE" , 0 , Combo0.cbkeydata )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "oblon_pros_876r" then	
		g_nNextFlag = DATAMANAGER.IsMoreNextData( szTranID )
		
		Dim nCnt, nIndex
		nCnt = DATAMANAGER.GetDataCount( 0, "oblon_pros_876r", "OutBlock1" )
		if nCnt > 0 then
			Dim LOAN_DTL_TYPE_CODE, typname
			nIndex = Grid0.rowcount-nCnt
		
			for i = 0 to nCnt-1
				LOAN_DTL_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "oblon_pros_876r", "OutBlock1", "LOAN_DTL_TYPE_CODE" , i )
				typname = Form.GetMetaData("대출상세유형코드", LOAN_DTL_TYPE_CODE)
				
				Grid0.SetCellData( "bd_typename", nIndex, typname )
				
				nIndex = nIndex+1
			next
		end if
	end if
End Sub

'============================================================================
' 계좌 변경
'============================================================================
Sub Account0_ChangeAccount()
	g_sAcc = Account0.caption
End Sub

'============================================================================
' 비밀번호 입력
'============================================================================
Sub EditPW_OnEditComplete()
	SetRequestData()
End Sub
'============================================================================
Sub EditPW_OnCompletedAccountPassword()
	SetRequestData()
End Sub

'============================================================================
Sub RdoGubun_OnClick(nIndex)
	SetComboControl()
	SetRequestData()
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	SetRequestData()
End Sub

'============================================================================
Sub Calendar0_OnEditComplete()
	SetRequestData()
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	if GetPWCkeck() then
		Exit Sub
	end if

	Form.SetSharedData("mbonl82020_p4_code", Grid0.GetCellData("bd_code", lRow) )
	Form.SetSharedData("mbonl82020_p4_loandate", Grid0.GetCellData("bd_loandate", lRow) )
	Form.SetSharedData("mbonl82020_p4_stnddate", Calendar0.caption )
	Form.SetSharedData("mbonl82020_p4_typecode", Grid0.GetCellData("bd_typecode", lRow) )
	Form.SetSharedData("mbonl82020_p4_srno", Grid0.GetCellData("bd_srno", lRow) )
	
	Form.OpenFramePopup(G_DETAIL_FILE , g_sAcc , "")
End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	if g_nNextFlag == "1" or g_nNextFlag == true then
		DATAMANAGER.RequestNextData( "oblon_pros_876r" ) '대출이자조회
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("mbonl82020_p4_code", null )
	Form.SetSharedData("mbonl82020_p4_loandate", null )
	Form.SetSharedData("mbonl82020_p4_stnddate", null )
	Form.SetSharedData("mbonl82020_p4_typecode", null )
	Form.SetSharedData("mbonl82020_p4_srno", null )
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="oblon_pros_876r" trcode="oblon_pros_876r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
