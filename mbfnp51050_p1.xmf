	<SCRIPT_INFO _len="7241" _ulen="7045" >
Dim g_AcntNo
Dim g_AcntSeq

Dim g_tAgreeUrl
Dim g_tAgreeState 	

dim g_szUnCheckImg, g_szCheckImg'체크이미지
dim g_szUnCheckFg, g_szCheckFg	'체크 폰트 컬러

dim g_AllFundYn	'모든펀드일괄적용 여부

dim g_szRet


'============================================================================
Sub Form_OnFormInitBefore()
	contMain.imgAllAgree.setMaintainingRatio("1")
	contMain.ImgInfo.setMaintainingRatio("1")
	contMain.imgUIChk1.setMaintainingRatio("1")
	contMain.imgUIChk2.setMaintainingRatio("1")
	contMain.imgUIChk3.setMaintainingRatio("1")
	contMain.imgUIChk4.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()

	g_AllFundYn = "N"
	g_szCheckImg = "icon_check_on.png"
	g_szCheckFg = "4"
	
	g_szUnCheckImg = "alpha"	'"icon_check_off.png"
'	g_szUnCheckFg = "127"
	
	g_szRet = ""

	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")
		
		g_AcntNo 		= tData[0]
		g_AcntSeq 		= tData[1]
		g_RmndSrno 		= tData[2]
		g_InagTypeCode	= tData[3]

		If g_InagTypeCode == "21" then 	'E-mail
			contMain.imgUIChk3.imgpath = g_szCheckImg
			
		elseIf g_InagTypeCode == "03" then 		'자택
			contMain.imgUIChk1.imgpath = g_szCheckImg
			
		ElseIf g_InagTypeCode == "02" then 	'직장
			contMain.imgUIChk2.imgpath = g_szCheckImg
					    
		else	'If g_InagTypeCode == "51" then 	'수신거부
			contMain.imgUIChk4.imgpath = g_szCheckImg			
			
		End If
		
		btnOk.enable = true
		
		DATAMANAGER.RequestTranData("obcsb_acif_140r")	'주소조회
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	if	szTranID =	"obcsb_acif_140r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , g_AcntNo )	'계좌번호
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)	
	if	szTranID ==	"obcsb_acif_140r" then
		iCnt = DATAMANAGER.GetDataCount(0, "obcsb_acif_140r", "OutBlock2")
		For i = 0 to iCnt - 1
		    strInagTypeCode2 = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock2", "INAG_TYPE_CODE" , i)
		    strInagSrno2     = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock2", "INAG_SRNO"      , i)
		    strAddr          = DATAMANAGER.GetDataValue(0, "obcsb_acif_140r", "OutBlock2", "ADDR"           , i)
		    
		    
			If strInagTypeCode2 == "21" then 	'E-mail
				contMain.lblCdNm3.caption = strAddr
				
			elseIf strInagTypeCode2 == "03" then 		'자택
				contMain.lblCdNm1.caption = strAddr
				
			ElseIf strInagTypeCode2 == "02" then 	'직장
				contMain.lblCdNm2.caption = strAddr
					
'			ElseIf strInagTypeCode2 == "31" then 	'알림톡
'				contMain.lblCdNm1.caption = strAddr
					    
			else	'If strInagTypeCode2 == "51" then 	'수신거부
				
				
			End If
		Next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
End Sub

'============================================================================
Sub contMain_imgAllAgree_OnClick()
	if contMain.chkAll.checkstate == "1" then
		contMain.chkAll.checkstate = "0"
		contMain_chkAll_OnChange("0")
	else
		contMain.chkAll.checkstate = "1"
		contMain_chkAll_OnChange("1")
	end if
	
'	g_AllFundYn
'	
'	btnOk.enable = true
End Sub

'============================================================================
Sub contMain_lblAllAgree_OnClick()
	if contMain.chkAll.checkstate == "1" then
		contMain.chkAll.checkstate = "0"
		contMain_chkAll_OnChange("0")
	else
		contMain.chkAll.checkstate = "1"
		contMain_chkAll_OnChange("1")
	end if
	
'	btnOk.enable = true
End Sub

'============================================================================
Sub contMain_chkAll_OnChange(sCheckState)
	if sCheckState == "1" then
		contMain.chkAll.chksilence = "1"

		g_AllFundYn = "Y"
		contMain.imgAllAgree.imgpath = g_szCheckImg
	else
		contMain.chkAll.chksilence = "0"
		
		g_AllFundYn = "N"
		contMain.imgAllAgree.imgpath = g_szUnCheckImg
	end if
End Sub


'============================================================================
Sub contMain_imgUIChk1_OnClick()
	g_InagTypeCode = "03"	'자택
		
	contMain.imgUIChk1.imgpath = g_szCheckImg
	contMain.imgUIChk2.imgpath = g_szUnCheckImg
	contMain.imgUIChk3.imgpath = g_szUnCheckImg
	contMain.imgUIChk4.imgpath = g_szUnCheckImg
	
'	btnOk.enable = true
End Sub

'============================================================================
Sub contMain_lblChkText1_OnClick()
	contMain_imgUIChk1_OnClick()
End Sub


'============================================================================
Sub contMain_imgUIChk2_OnClick()
	g_InagTypeCode = "02"	'직장
		
	contMain.imgUIChk1.imgpath = g_szUnCheckImg
	contMain.imgUIChk2.imgpath = g_szCheckImg
	contMain.imgUIChk3.imgpath = g_szUnCheckImg
	contMain.imgUIChk4.imgpath = g_szUnCheckImg
	
'	btnOk.enable = true
End Sub

'============================================================================
Sub contMain_lblChkText2_OnClick()
	contMain_imgUIChk2_OnClick()
End Sub

'============================================================================
Sub contMain_imgUIChk3_OnClick()
	g_InagTypeCode = "21"	'이메일
		
	contMain.imgUIChk1.imgpath = g_szUnCheckImg
	contMain.imgUIChk2.imgpath = g_szUnCheckImg
	contMain.imgUIChk3.imgpath = g_szCheckImg
	contMain.imgUIChk4.imgpath = g_szUnCheckImg
	
'	btnOk.enable = true
End Sub

'============================================================================
Sub contMain_lblChkText3_OnClick()
	contMain_imgUIChk3_OnClick()
End Sub

'============================================================================
Sub contMain_imgUIChk4_OnClick()
	g_InagTypeCode = "51"	'수신거부
		
	contMain.imgUIChk1.imgpath = g_szUnCheckImg
	contMain.imgUIChk2.imgpath = g_szUnCheckImg
	contMain.imgUIChk3.imgpath = g_szUnCheckImg
	contMain.imgUIChk4.imgpath = g_szCheckImg
	
'	btnOk.enable = true
End Sub

'============================================================================
Sub contMain_lblChkText4_OnClick()
	contMain_imgUIChk4_OnClick()
End Sub

'============================================================================
Sub btnOk_OnClick()
	'계좌번호★계좌순번★잔고일련번호★타입코드★모든펀드일괄적용여부
	g_szRet = g_AcntNo & "★" & g_AcntSeq & "★" & g_RmndSrno & "★" & g_InagTypeCode & "★" & g_AllFundYn
	Form.CloseForm()
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbfnp51050_p1" , g_szRet )	
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm( )
End Sub

	</SCRIPT_INFO>
