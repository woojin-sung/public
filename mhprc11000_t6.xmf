	<SCRIPT_INFO _len="12620" _ulen="12286" >
'----------------------------------------------------------------------------
' 01. 화 면 명 : 탭_상세
' 02. 화면설명 : 주식현재가 상세 탭화면
' 03. 작    성 : 2015.12.17 LJS
'----------------------------------------------------------------------------
'20230913 LES START : stck_cntg -> stck_incg로 교체(신주인수권 > 상세 > 원주가격)

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket, g_szInnerMarket


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
Function RequestData()
	
	'20230913 LES START : stck_cntg -> stck_incg로 교체
	'DATAMANAGER.CancelRealData( "ohhts_stck_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_stck_incg" )
	
	DATAMANAGER.CancelRealData( "ohhts_etf_nav" 	)
	DATAMANAGER.CancelRealData( "ohhts_frbr_cntg"	)	'20180712 HAMWG : K-OTC MTS 도입
	
	If g_szItemMarket = "J" Then
		
		If g_szInnerMarket = "013" Then								'ETF
			DATAMANAGER.RequestTranData( "ohhts_1191_001r" )
			DATAMANAGER.RequestTranData( "ohhts_1191_002r" )
			DATAMANAGER.RequestTranData( "ohhts_1191_003r" )
			DATAMANAGER.RequestTranData( "ohhts_1191_003r_1" )
			DATAMANAGER.RequestTranData( "ohhts_1191_003r_2" )
			DATAMANAGER.RequestTranData( "ohhts_1191_003r_3" )
			
		Else		
			DATAMANAGER.RequestTranData( "ohhts_1001_001r" )				'주식
		
			If Left(g_szItemCode, 1) = "J" then							'신주인수권			
				DATAMANAGER.RequestTranData( "ohhts_2090_001r" )
				DATAMANAGER.RequestTranData( "ohhts_2090_002r" )
			End If
		End If
	
	ElseIf g_szItemMarket = "Q" Then 								'ETN
		DATAMANAGER.RequestTranData( "ohhts_1001_028r" )
		
	ElseIf g_szItemMarket = "W" Then 								'ELW
		DATAMANAGER.RequestTranData( "ohhts_3800_017r" )
		DATAMANAGER.RequestTranData( "ohhts_3800_002r" )				'20170201 LES - 잔존기간, 행사가격 필드 추가
	
	'20180712 HAMWG START : K-OTC MTS 도입	
	ElseIf g_szItemMarket = "T" Then
		DATAMANAGER.RequestTranData( "ohhts_1201_001r" )		
	'20180712 HAMWG END
		
	End If
	
End Function

'============================================================================
Function ChangeGridView()

	tbl1.visible	 = false		'일반 상세	    
	tbl2.visible   = false		'신주인수권 전용상세
	tblElw.visible = false 	'ELW	
	tblEtn.visible = false		'ETN
	tblEtf1.visible = false	'ETF
	tblEtf2.visible = false	'ETF
	tblKotc.visible = false	'K-OTC '20180712 HAMWG : K-OTC MTS 도입

	If g_szItemMarket = "J" Then
		If g_szInnerMarket = "013" Then								'ETF
			tblEtf1.visible = True
			tblEtf2.visible = True
		Else
			If Left(g_szItemCode, 1) = "J" then
			    tbl2.visible = True	'신주인수권 전용상세
			Else
			    tbl1.visible = True 	'일반 상세
			End If
		End If
	
	ElseIf g_szItemMarket = "Q" Then 								'ETN
		tblEtn.visible = True
		
	ElseIf g_szItemMarket = "W" Then 								'ELW
		tblElw.visible = True
		
	'20180712 HAMWG START : K-OTC MTS 도입	
	ElseIf g_szItemMarket = "T" Then
		tblKotc.visible = True
	'20180712 HAMWG END
		
	End If
	
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	g_szInnerMarket= Form.GetItemCodeInfo(g_szItemCode, "innermarket")
End Sub

'============================================================================
Sub Form_OnFormInit()
	tbl2.left 	= 0
	tblElw.left 	= 0
	tblEtn.left	= 0
	tblEtf1.left	= 0
	tblEtf2.left	= 0
	tblKotc.left	= 0	'20180712 HAMWG : K-OTC MTS 도입
'	RequestData()
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode, "market")
		g_szInnerMarket= Form.GetItemCodeInfo( g_szItemCode, "innermarket")
		
		ChangeGridView()
		RequestData()
	end	if	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
'			Form.triggerEvent( "#", "REQUEST_ITEMCODE", "")
			Exit Sub
		End If	
	
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		g_szInnerMarket= Form.GetItemCodeInfo( g_szItemCode, "innermarket")
		
		ChangeGridView()		
		RequestData()
		
	 end if
	 
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    
    '주식
    if szTranID = "ohhts_1001_001r" then
	    DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket )
	    DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode )
	
	'신주인수권
	elseif szTranID = "ohhts_2090_001r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_2090_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode )
		ChangeGridView()	    
	
	'신주인수권
	elseif szTranID = "ohhts_2090_002r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_2090_002r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode )
	
	'ELW
	elseif szTranID = "ohhts_3800_017r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_3800_017r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_3800_017r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode )
	
	
	'20170201 LES START
	'ELW(잔존일수+행사가격) 필드 추가
	elseif szTranID = "ohhts_3800_002r" then
		 DATAMANAGER.SetDataValue( 0, "ohhts_3800_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket )
		 DATAMANAGER.SetDataValue( 0, "ohhts_3800_002r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode )
		
	'ETN
	elseif szTranID = "ohhts_1001_028r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_028r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket )
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_028r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_szItemCode )
		
	'ETF
	elseif szTranID = "ohhts_1191_001r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1191_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "J" )
		DATAMANAGER.SetDataValue( 0, "ohhts_1191_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode )
		DATAMANAGER.SetDataValue( 0, "ohhts_1191_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "F" )
		DATAMANAGER.SetDataValue( 0, "ohhts_1191_001r", "InBlock2", "FID_INPUT_ETC_CLS_CODE" 		, 0 , "1" )
		
	elseif szTranID = "ohhts_1191_002r" then
		DATAMANAGER.SetDataValue( 0, "ohhts_1191_002r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "J" )
		DATAMANAGER.SetDataValue( 0, "ohhts_1191_002r", "InBlock2", "FID_INPUT_ISCD" 				, 0 , g_szItemCode )
		
	elseif szTranID = "ohhts_1191_003r" OR szTranID = "ohhts_1191_003r_1" OR szTranID = "ohhts_1191_003r_2" OR szTranID = "ohhts_1191_003r_3" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "J" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCode )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE"	, 0 , "1191" )
		
		If szTranID = "ohhts_1191_003r" Then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_CNT1"	, 0 , "1" )
		Elseif szTranID = "ohhts_1191_003r_1" Then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_CNT1"	, 0 , "2" )
		Elseif szTranID = "ohhts_1191_003r_2" Then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_CNT1"	, 0 , "3" )
		Elseif szTranID = "ohhts_1191_003r_3" Then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_CNT1"	, 0 , "4" )
		End If
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "J" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_ISCD"				, 0 ,  g_szItemCode)
	
	'20180712 HAMWG START : K-OTC MTS 도입		
	'K-OTC
	elseif szTranID =  "ohhts_1201_001r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_ISCD"	, 0 ,  g_szItemCode)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "FID_INPUT_ISCD"	, 0 ,  g_szItemCode)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock3", "FID_INPUT_ISCD"	, 0 ,  g_szItemCode)
	end if
	'20180712 HAMWG END
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	
	'20230913 LES START : stck_cntg -> stck_incg로 교체
	'If szTranID = "ohhts_stck_cntg" Then
	If szTranID = "ohhts_stck_incg" Then
	
		'20230913 LES START : stck_cntg -> stck_incg로 교체
		'DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD"	, 0 , g_szItemCode )
		DATAMANAGER.SetDataValue( 1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD"	, 0 , g_szItemCode )
	
	ElseIf szTranID = "ohhts_etf_nav" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_etf_nav", "InBlock1", "FIDR_SHRN_ISCD"	, 0 , g_szItemCode )
	
	'20180712 HAMWG START : K-OTC MTS 도입
	ElseIf szTranID = "ohhts_frbr_cntg" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD"	, 0 , g_szItemCode )
	'20180712 HAMWG END
	
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID = "ohhts_1001_001r" then
		Dim szRank
		szRank = Form.GetItemCodeInfo(g_szItemCode, "rank")
		tbl1.SetCellString( 11, 4, szRank )	
	    
	    if DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_SSTS_YN", 0 ) = "Y" then
		    tbl1.SetCellString( 6, 1, "가능" )
	    else
		    tbl1.SetCellString( 6, 1, "불가능" )
	    end if
	    
	elseif szTranID = "ohhts_2090_002r" then
	
		'20230913 LES START : stck_cntg -> stck_incg로 교체
		'DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		DATAMANAGER.RequestRealData( "ohhts_stck_incg" )
	    
	elseif szTranID = "ohhts_3800_017r" then
		
		If DATAMANAGER.GetDataValue( 0, "ohhts_3800_017r", "OutBlock1", "FID_NW_LP_ODER_ABLE_YN", 0 ) = "Y" then
			tblElw.SetCellString( 2, 1, "LP주문가능" )
		Else
			tblElw.SetCellString( 2, 1, "LP주문불가능" )
		End If
			
	elseif szTranID = "ohhts_1001_028r" then
		Dim szData1, nzData2
		szData1 = DATAMANAGER.GetDataValue( 0, "ohhts_1001_028r", "OutBlock1", "FID_ETN_LAST_STLM_MTCD" , 0 )
		nzData2 = CDbl(DATAMANAGER.GetDataValue( 0, "ohhts_1001_028r", "OutBlock1", "FID_LSTN_STCN" , 0 )) / 1000
		
		If szData1 = "A" Then
			tblEtn.SetCellString( 5, 3, "현금+실물인수도" )
		ElseIf szData1 = "C" Then
			tblEtn.SetCellString( 5, 3, "현금결제" )
		ElseIf szData1 = "D" Then
			tblEtn.SetCellString( 5, 3, "실물인수도" )
		End If
	
		tblEtn.SetCellString( 0, 3, nzData2)
	
		DATAMANAGER.RequestRealData( "ohhts_etf_nav" )
		
	
	elseif szTranID = "ohhts_1191_001r" then
		Dim nData1, nData2
		nData1 = CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_1191_001r", "OutBlock1", "FID_LSTN_STCN" 	, 0 ) ) / 1000
		nData2 = CDbl( DATAMANAGER.GetDataValue( 0, "ohhts_1191_001r", "OutBlock1", "FID_FRGN_HLDN_QTY" , 0 ) ) / 1000
		
		tblEtf1.SetCellString(  9, 1, nData1 )
		tblEtf1.SetCellString( 10, 1, nData2 )
		
	'20180712 HAMWG START : K-OTC MTS 도입	
	elseif szTranID = "ohhts_1201_001r" then
		Dim szVntrCd, nCpfn
		szVntrCd = DATAMANAGER.GetDataValue( 0, "ohhts_1201_001r", "OutBlock1", "FID_VNTR_ETPR_CLS_CODE", 0 )
		nCpfn	= CDbl(DATAMANAGER.GetDataValue( 0, "ohhts_1201_001r", "OutBlock1", "FID_CPFN", 0 ))

		If szVntrCd = "1" Then
			tblKotc.SetCellString(1, 4, "벤처")
		Else
			tblKotc.SetCellString(1, 4, "일반")
		End If
		
		If Cint(Right(nCpfn/10000000, 1)) > 4 Then
			tblKotc.SetCellString(7, 4, Cint((nCpfn / 100000000)) + 1)
		Else
			tblKotc.SetCellString(7, 4, nCpfn / 100000000)
		End If
		
		DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
	'20180712 HAMWG END		
	end if	
	
End Sub


