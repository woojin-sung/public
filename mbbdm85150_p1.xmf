Sub Container0_imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' 통합검색 / 일반검색
'============================================================================
Sub Container0_FormTab0_OnTabChanged(nCurrentTab)
	f_ControlSet(nCurrentTab)
	
	' 통합검색
	if nCurrentTab == 0 then
		ConPage0.Grid3.SetCellData("BD_DORO", 	0, "")
		ConPage0.Grid3.SetCellData("BD_ZIP", 	0, "")
		
		ConPage0.EditDtlAddr.caption = ""
		
		if g_DeviceOS == "2" then
			ConPage0.WebView0.SetUseJavaScript("1")
			ConPage0.WebView0.SetUserAgent("meritz_ios")
		end if
		
		f_SyncKAKAO() ' 카카오 주소검색 페이지 연동
		
	' 일반검색
	else		
		Container1Step.EditInput.caption 		= ""
		Container1Step.Grid0.rowcount    		= "0"
		Container1Step.Label18.visible    		= false
		Container2Step.EditInputAddress.caption	= ""
		Container2Step.EditInputAddress1.caption	= ""
		Container2Step.ContainerSub.ChkButton1.chksilence	= "0"
		Container2Step.ContainerSub.ChkButton2.chksilence = "0"
	end if
	
End Sub

'============================================================================
' 통합검색 : 상세주소
'============================================================================
Sub ConPage0_EditDtlAddr_OnEditComplete()

	'20230420 LES
	Call addrEndEditing()
	
	if ConPage0.Grid3.GetCellData("BD_POST", 0) == "" or ConPage0.Grid3.GetCellData("BD_POST", 0) == null then
		ConPage0.EditDtlAddr.caption = ""
		
		Form.MsgBox("알림", "기본주소를 검색하세요.", "", 6)
	else
		g_Post = ConPage0.Grid3.GetCellData("BD_POST", 0).." "..ConPage0.EditDtlAddr.caption
		
		DATAMANAGER.RequestTranData("obcpp_zipa_011r") '정제주소조회	
	end if
	
End Sub

'============================================================================
' 통합검색탭 : IOS의 경우 상세주소
'============================================================================
Sub ConPage0_EditDtlAddrBtn_OnClick()

	if Form.GetSharedData("&OS_TYPE", false) == "2" then
		Call addrWhileEditing()
	end if
	
End Sub

'============================================================================
' 통합검색탭 : 확인버튼
'============================================================================
Sub ConPage0_BtnOk0_OnClick()

	if g_CurTab == 0 and (ConPage0.EditDtlAddr.caption == "" or ConPage0.EditDtlAddr.caption == null) then
		Form.MsgBox("알림", "상세주소를 입력해주세요.", "", 6)
		Exit Sub
	end if

	Dim sYN
	sYN			= g_nFlag == "도로명주소" and "Y" 			or "N"
	g_BLDN_MNNO	= g_nFlag == "도로명주소" and g_BLDN_MNNO	or ""

	if g_Post == "" or g_Post == null then	
		Form.MsgBox("알림", "기본주소를 검색하세요.", "", 6)
		Exit Sub
	end if
	
	if g_Dtad == "" or g_Dtad == null then	
		Form.MsgBox("알림", "상세주소를 입력하세요.", "", 6)
		Exit Sub
	end if
	
	f_ResetSharedData()
	
	Form.SetSharedData(g_DataArr[0], 	sYN)
	Form.SetSharedData(g_DataArr[1],	LEFT(ConPage0.Grid3.GetCellData("BD_ZIP", 0), 	3))
	Form.SetSharedData(g_DataArr[2],	RIGHT(ConPage0.Grid3.GetCellData("BD_ZIP", 0), 	2))
	Form.SetSharedData(g_DataArr[3], 	g_Post)
	Form.SetSharedData(g_DataArr[4], 	g_Dtad)
	Form.SetSharedData(g_DataArr[5], 	g_BLDN_MNNO)
				
	g_sRetData = "ok"
	
	Form.SendReturnToParent("mbbdm85150_p1" , g_sRetData)
	Form.CloseForm()
End Sub

'============================================================================
' 일반검색탭 : 도로명/지번 주소 검색
'============================================================================
Sub Container1Step_EditInput_OnEditComplete()

	'초기화 ---------------------------------------------------
	Container1Step.Grid0.SetClear()
	Container1Step.Grid0.rowcount 				= "0"
	Container2Step.EditInputAddress.caption		= ""
	Container2Step.EditInputAddress1.caption		= ""
	Container2Step.ContainerSub.visible 			= False
	Container2Step.ContainerSub.Grid1.rowcount	= "0"
	Container2Step.ContainerSub.Grid2.rowcount	= "0"
	Container2Step.Button1.btnimage				= "btn_20.9"
	'초기화 ---------------------------------------------------
	
	Container1Step.ImgIcon.visible = true
	
	if Container1Step.EditInput.caption == "" then
		Form.MsgBox("안내", "도로명을 입력하세요.", "", 6)
		Exit Sub
	End if
	
	g_nNextFlag = false

	DATAMANAGER.RequestTranData("obcpp_zipa_010r")	'도로명주소조회
End Sub

