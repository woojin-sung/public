'============================================================================
' 일반검색탭 : 정제버튼
'============================================================================
Sub Container2Step_Button1_OnClick()

	if Container2Step.EditInputAddress.caption == "" then	
		Form.MsgBox("안내", "기본주소를 선택하세요.", "", 6)
		Exit Sub
	End if
	
	if Container2Step.EditInputAddress1.caption == "" then	
		Form.MsgBox("안내", "상세주소를 입력하세요.", "", 6)
		Exit Sub
	end if
	
	Container2Step.ContainerSub.visible = true
	Container2Step.ContainerSub.Image0.setStatus("normal")
	Container2Step.ContainerSub.Image1.setStatus("normal")
	
	Dim post
	
	if g_CurTab == 0 or g_CurTab == "0" then
		post = Container2Step.EditInputAddress.caption
	else
		post = g_010r_data
	end if

	Container2Step.ContainerSub.Image1.setStatus("focus")
	
	g_Post 				= post.." ".. Container2Step.EditInputAddress1.caption
	LabelAddress.caption 	= g_Post
	
	DATAMANAGER.RequestTranData("obcpp_zipa_011r") '정제주소조회
End Sub

'============================================================================
' 일반검색탭 : 도로명주소 체크버튼
'============================================================================
Sub Container2Step_ContainerSub_ChkButton2_OnChange(sCheckState)

	if sCheckState == "1" then 
		Container2Step.ContainerSub.ChkButton1.checkstate = "0"
		Container2Step.ContainerSub.Image1.setStatus("focus")
		Container2Step.ContainerSub.Image0.setStatus("normal")
	else
		Container2Step.ContainerSub.Image1.setStatus("normal")
	end if
	
End Sub

'============================================================================
' 일반검색탭 : 지번주소 체크버튼
'============================================================================
Sub Container2Step_ContainerSub_ChkButton1_OnChange(sCheckState)

	if sCheckState == "1" then
		Container2Step.ContainerSub.ChkButton2.checkstate = "0"
		Container2Step.ContainerSub.Image0.setStatus("focus")
		Container2Step.ContainerSub.Image1.setStatus("normal")
	else
		Container2Step.ContainerSub.Image0.setStatus("normal")
	end if
	
End Sub

'============================================================================
' 일반검색탭 : 확인버튼
'============================================================================
Sub Container2Step_btnOk_OnClick()
	Dim sPost, sDtad, sBLDN	
	
	f_ResetSharedData()
	
	if Container2Step.ContainerSub.ChkButton1.chksilence == "1" then
		sPost = Container2Step.ContainerSub.Grid1.GetCellData("bd_post", 0)
		sDtad = Container2Step.ContainerSub.Grid1.GetCellData("bd_dtad", 0)
		
		Form.SetSharedData(g_DataArr[0],	"N")
		Form.SetSharedData(g_DataArr[1],	LabelREGNZIP.caption)
		Form.SetSharedData(g_DataArr[2], 	LabelDTLZIP.caption )
		Form.SetSharedData(g_DataArr[3], 	sPost)
		Form.SetSharedData(g_DataArr[4], 	sDtad)
		Form.SetSharedData(g_DataArr[5], 	""   )
		
	elseif Container2Step.ContainerSub.ChkButton2.chksilence == "1" then
		sPost = Container2Step.ContainerSub.Grid2.GetCellData("bd_post", 0)
		sDtad = Container2Step.ContainerSub.Grid2.GetCellData("bd_dtad", 0)
		sBLDN = Container2Step.ContainerSub.Grid2.GetCellData("bd_bldn", 0)
		
		Form.SetSharedData(g_DataArr[0], 	"Y")
		Form.SetSharedData(g_DataArr[1], 	LabelREGNZIP.caption)
		Form.SetSharedData(g_DataArr[2], 	LabelDTLZIP.caption )
		Form.SetSharedData(g_DataArr[3], 	sPost)
		Form.SetSharedData(g_DataArr[4], 	sDtad)
		Form.SetSharedData(g_DataArr[5], 	sBLDN)
	end if
	
	if Container2Step.ContainerSub.ChkButton1.chksilence == "0" and Container2Step.ContainerSub.ChkButton2.chksilence == "0" then
		Form.MsgBox("안내", "반영할 주소를 선택하세요.", "", 6)
		Exit Sub	
	end if

	g_sRetData = "ok"
	
	Form.SendReturnToParent("mbbdm85150_p1" , g_sRetData)
	Form.CloseForm()	
End Sub

'===========================================================================
' 							사용자 함수
'============================================================================
' 탭 변경시 화면 세팅 함수
'============================================================================
Sub f_ControlSet(nCurrentTab)
	g_CurTab = nCurrentTab
	if nCurrentTab == 0 then
		ConPage0.visible 		= true
		Container1Step.visible	= false
		Container2Step.visible	= false
	else
		ConPage0.visible 		= false
		Container1Step.visible	= true
		Container2Step.visible	= false
		
		ConPage0.Grid3.visible			= false
		ConPage0.EditDtlAddr.visible 	= false
	end if
	
End Sub

'===========================================================================
' SetSharedData 리셋 함수
'===========================================================================
Function f_ResetSharedData()
	Form.SetSharedData("10050_ADDRESS_YN"       	, "")
	Form.SetSharedData("10050_ADDRESS_REGN_ZIP" 	, "")
	Form.SetSharedData("10050_ADDRESS_DTL_ZIP"  	, "")
	Form.SetSharedData("10050_ADDRESS_POST"     	, "")
	Form.SetSharedData("10050_ADDRESS_DTAD"     	, "")
	Form.SetSharedData("10050_ADDRESS_BLDN"     	, "")
	
	Form.SetSharedData("mbonl81000_p4_YN"		, "")
	Form.SetSharedData("mbonl81000_p4_REGN_ZIP"	, "")
	Form.SetSharedData("mbonl81000_p4_DTL_ZIP" 	, "")
	Form.SetSharedData("mbonl81000_p4_POST" 		, "")
	Form.SetSharedData("mbonl81000_p4_DTAD" 		, "")
	Form.SetSharedData("mbonl81000_p4_BLDN" 		, "")
End Function

'===========================================================================
' 카카오 주소검색 페이지 연동
'===========================================================================
Function f_SyncKAKAO()
	serverMode = Form.GetSharedData("&SERVER_MODE", false)
	
	if serverMode == "1" Then	'개발기
		ConPage0.WebView0.urlpath = "https://testhome.imeritz.com/biz/kakaoaddr.html"
	else
		ConPage0.WebView0.urlpath = "https://home.imeritz.com/biz/kakaoaddr.html"
	end if
	
End Function

'============================================================================
'20230420 LES
'============================================================================
Function addrWhileEditing()
	ConPage0.LblBar.top = 707
	ConPage0.EditDtlAddrBtn.width = 345
	ConPage0.setScrollAutoSize()
	'ConPage0.scroll_pos_noAni = ConPage0.scroll_pos + 220
	ConPage0.scroll_pos = ConPage0.scroll_pos + 220
	ConPage0.EditDtlAddr.setFocus()
	
	ConPage0.BtnOk0.visible = false	
End Function

'============================================================================
''20230420 LES
'============================================================================
Function addrEndEditing()
	ConPage0.LblBar.top = 505
	ConPage0.EditDtlAddrBtn.width = 370
	ConPage0.setScrollAutoSize()
		
	ConPage0.BtnOk0.visible = true
End Function

'============================================================================
'어느 화면에서 왔느냐에 따라 sharedData 변수 할당
'============================================================================
Function f_SetSharedDataVal()
	Dim OpnScrnNm
	OpnScrnNm = Form.GetOpenLinkData() == "pass" and "mbbdm85150_p1" or "mbonl81000_p4"
	
	if OpnScrnNm == "mbbdm85150_p1" then
		
		for i = 0 to #g_DataArr - 1
			g_DataArr[i] = "10050_ADDRESS_"..g_DataArr[i]
		next
		
	else
	
		for i = 0 to #g_DataArr - 1
			g_DataArr[i] = "mbonl81000_p4_"..g_DataArr[i]
		next
		
	end if

End Function

