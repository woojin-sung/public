Sub Container1Step_Grid0_OnClickUp(lRow, szCellID)	
	Container0.FormTab0.visible	= false
	Container1Step.visible		= false
	Container2Step.visible 	= true
	
	Dim regnzip, dtlzip, post , simple_post
	regnzip = Container1Step.Grid0.GetCellData("bd_regnzip",	lRow)
	dtlzip  = Container1Step.Grid0.GetCellData("bd_dtlzip",	lRow)
	post    = Container1Step.Grid0.GetCellData("bd_address",	lRow)
	simple_post = Container1Step.Grid0.GetCellData("bd_post",	lRow)
	'Form.ShowAlert("jsi 알림", post)
	'Form.ShowAlert("jsi 알림", simple_post)
	LabelREGNZIP.caption = regnzip
	LabelDTLZIP.caption  = dtlzip

	Container2Step.EditInputAddress.caption = post			'도로명주소
	Container2Step.EditInputAddress1.SetShowKeypad(True)
	
	g_010r_data = simple_post 
'	Container2Step.EditInputAddress1.setFocus()
End Sub

