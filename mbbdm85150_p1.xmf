	<SCRIPT_INFO _len="24971" _ulen="23673" >
'============================================================================
' 01. 화 면 명 : 주소검색
' 02. 화면설명 : 주소검색
' 03. 작    성 : 김유경
' 04. 수    정 : 2023.04.14 신명준 : 통합검색(카카오MAP API) 추가
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nNextFlag
Dim sAddr1 
Dim sAddrDtl1
DIm sAddr2 
DIm sAddrDtl2
Dim g_Post
Dim g_Dtad
Dim g_BLDN_MNNO
Dim g_nFlag
Dim g_DeviceOS
Dim g_DataArr
Dim g_CurTab
Dim g_010r_data
g_CurTab = 0
g_DataArr = {"YN", "REGN_ZIP", "DTL_ZIP", "POST", "DTAD", "BLDN"}

'===========================================================================
' 							FORM 함수
'============================================================================
Sub Form_OnFormInit()
	f_SetSharedDataVal()

	'============================================================================
	'20230420 LES
	'============================================================================
	if Form.GetSharedData("&OS_TYPE", false) == "2" then
		ConPage0.EditDtlAddrBtn.visible = true
	else
		ConPage0.EditDtlAddrBtn.visible = false
	end if
	'============================================================================

	g_nNextFlag = false
	Container2Step.ContainerSub.visible = False
	Container2Step.Button1.btnimage = "btn_20.9"
	
	ConPage0.EditDtlAddr.imagefilepth 		= "login_input.9.png"
	Container1Step.EditInput.imagefilepth 	= "login_input.9.png"
	
	Container2Step.EditInputAddress.setApplyLabel ("기본주소" , 0 , 268 , "left" , false)
	Container2Step.EditInputAddress1.setApplyLabel("상세주소" , 0 , 268 , "left" , false)
	
	'Default값 셋팅 후 비활성화 컨트롤: 컨트롤 속성에서 사용가능으로 체크한 후에 setApplyLabel 아래에서 enable = False
	Container2Step.EditInputAddress.enable = False
	
	
	Container2Step.Button0.btnimage = "alpha"
	
	'############ LES START ######################
	'iOS 는 컨테이너 이미지, 안드로이드는 이미지에 이미지, 힌트캡션
	OsType = Form.GetSharedData("&OS_TYPE", false)
	
	if OsType == "2" then
		Container0.containerimage = "popup_bg.9"
		Container1Step.EditInput.hintcaption = "예)판교역로 166, 분당 주공, 백현동 532"
	else
		Container0.Image4.imgpath = "popup_bg.9"
		Container1Step.EditInput.hintcaption = "예)판교역로 166, 분당 주공"
	end if
	'############ LES End ######################

	'========================================================================
	' 앱<->웹 연동을 위한 필수 세팅 
	'========================================================================
	g_DeviceOS = Form.GetSharedData("&OS_TYPE", False) 	'1.안드로이드 2.iOS
	
	if g_DeviceOS == "1" then
		ConPage0.ConPage0.WebView0.SetUserAgent("meritz_android")
	elseif g_DeviceOS == "2" then
		ConPage0.WebView0.SetUseJavaScript("1")
		ConPage0.WebView0.SetUserAgent("meritz_ios")
	end if
	
	f_SyncKAKAO() ' 카카오 주소검색 페이지 연동	
End Sub

'===========================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	'========================================================================
	' 주소선택 후(통합검색 카카오API)
	'========================================================================
	if sEventName == "WebViewReturn" then
		ConPage0.Grid3.visible 		= true
		ConPage0.EditDtlAddr.visible 	= true
		ConPage0.EditDtlAddr.caption	= ""
		
'		arrData(0) : 도로명주소 / arrData(1) : 지번주소 / arrData(2) : 우편번호
		arrData = Split(sParam , "@")

		if arrData(0) == "" or arrData(0) == null then
			g_nFlag = "지번주소"
			ConPage0.Grid3.SetCellData("BD_POST", 0, arrData(1))
		else
			g_nFlag = "도로명주소"
			ConPage0.Grid3.SetCellData("BD_POST", 0, arrData(0))
		end if

		ConPage0.Grid3.SetCellData("BD_ZIP", 0, arrData(2))
		ConPage0.Grid3.SetCellFgColor("BD_ZIP", 0, 350)
	end if
	
End Sub

'===========================================================================
' 							DATAMANAGER 함수
'===========================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
		
	if szTranID == "obcpp_zipa_010r" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ROAD_NAME", 	0, Container1Step.EditInput.caption)
		
	elseif szTranID == "obcpp_zipa_011r" then	
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ADDR", 		0, g_Post)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcpp_zipa_010r" then
		g_nNextFlag = DATAMANAGER.IsMoreNextData(szTranID)

		Dim nCnt, nIndex
		nCnt = DATAMANAGER.GetDataCount(false, szTranID, "OutBlock1")
		
		if nCnt > 0 then
			Container1Step.Label18.visible = False
			
			Dim REGN_ZIP, DTL_ZIP
			nIndex = Container1Step.Grid0.rowcount - nCnt
			
			for i = 0 to nCnt - 1
				REGN_ZIP	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "REGN_ZIP",	i)
				DTL_ZIP	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "DTL_ZIP",	i)

				Container1Step.Grid0.SetCellData("bd_zip", nIndex, REGN_ZIP..DTL_ZIP)
				nIndex = nIndex + 1
			next
		
		else
			Container1Step.Label18.visible = true
		end if
		
	elseif szTranID == "obcpp_zipa_011r" then
		g_Post = ""
		
		if Container0.FormTab0.currenttabpageid == "page0" then
			g_Post		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "POST", 		0)
			g_Dtad		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "DTAD", 		0)
			g_BLDN_MNNO	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "BLDN_MNNO",	0)
			
		else
			sAddr1    = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "POST" , 0)
			sAddrDtl1 = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "DTAD" , 0)
	
			sAddr2    = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "POST" , 0)
			sAddrDtl2 = DATAMANAGER.GetDataValue(false, szTranID, "OutBlock2", "DTAD" , 0)
	
			if Trim(sAddr1) <> "" and Trim(sAddrDtl1) <> ""  then		
				Container2Step.ContainerSub.Label4.caption  = sAddr1
				Container2Step.ContainerSub.Label41.caption = sAddrDtl1
			end if
	
			if Trim(sAddr2) <> "" and Trim(sAddrDtl2) <> ""  then		
				Container2Step.ContainerSub.Label5.caption  = sAddr2
				Container2Step.ContainerSub.Label51.caption = sAddrDtl2
			end if
			
			Container2Step.Button1.btnimage = "btn_21.9"
			Container2Step.Button1.enable   =  False
			
			Container2Step.ContainerSub.ChkButton2.checkstate = "1"
			
			if len(Trim(Container2Step.ContainerSub.Label4.caption)) == 0 and len(Trim(Container2Step.ContainerSub.Label5.caption)) == 0 then
				Container2Step.btnOk.enable = false
				
				'2021.04.20. 김유경. 정제불가 안내 추가
				Container2Step.ContainerSub.ChkButton1.checkstate = "0"
				Container2Step.ContainerSub.ChkButton2.checkstate = "0"
				Container2Step.ContainerSub.Image0.setStatus("normal")
				Container2Step.ContainerSub.Image1.setStatus("normal")
				
				'2021.04.28. 김유경. 기본주소, 상세주소 없으면 팝업 추가
				'############ LES START ######################
				OsType = Form.GetSharedData("&OS_TYPE", false)
				if OsType == "1" then
					Form.OpenPopup("mbbdm85150_p2", "" , "" )
				else
					Form.MsgBox("안내", "주소를 다시확인해주세요.\n주소가 조회되지 않아 기본주소 검색으로 이동합니다.", "FAIL", 0)
				end if
				'############ LES End ######################
			else
				Container2Step.scroll_pos = CInt(Form.calcUnResize(Container2Step.EditInputAddress1.top, "1")) '2021.05.01. 김유경. 
				Container2Step.btnOk.enable = true
			end if
			
		end if
		
	end if
	
End Sub	

