		<LABEL name="lblTitle" fontsize="3" fontstyle="01" caption="추가진행절차를 확인해주세요!" ly_vert="20,158,335,32,1" />
		<GRID name="grdText" ly_vert="20,204,335,138,1" ver="1" itemcodeid="" >
