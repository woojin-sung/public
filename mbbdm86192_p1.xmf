'============================================================================
Sub Form_OnFormInit()
	Dim szSendData, tData
	szSendData = Form.GetOpenLinkData()
	
	'szSendData = "N★Y★N★Y"
	
'	if Form.GetSharedData("&OS_TYPE", false) == "1" then
'		contOVFO.lblText.changeTextAttr(57, 7, 96, -2, true)
'	else
'		contOVFO.lblText.changeTextAttr(59, 7, 96, -2, true)
'	end if
	
	if szSendData <> "" and szSendData <> null then
		'중개형ISA 여부, CFD 여부, 선물옵션 여부, 해외선옵 여부
		tData = Split(szSendData, "★")
		
		Dim szMISAYN, szCFDYN, szFUOT, szOVFO
		szMISAYN = tData[0]
		szCFDYN = tData[1]
		szFUOT = tData[2]
		szOVFO = tData[3]
		
		'ISA 이수전용 여부
		Dim szIsaAcntOpngClcd			
		szIsaAcntOpngClcd	= Form.GetSharedData("BDM_ISA_ACNT_OPNG_CLCD"    , False )	
		
		Dim nCnt
		nCnt = 0
		grdText.SetClear()
		
		if szCFDYN == "Y" then
			grdText.AddRow()
			grdText.SetCellData("bd_title", nCnt, "CFD 계좌")
			grdText.SetCellData("bd_text", nCnt, "장외파생상품 거래를 위해 CFD계약서 작성이 필요합니다. 신청 이력이 없는 고객은 로그인 후 'CFD 계좌 계약서 승인'에서 신청을 먼저 진행해 주세요.")
			
			nCnt = nCnt + 1
		end if
		if szMISAYN == "Y" then
			grdText.AddRow()
			if szIsaAcntOpngClcd == "2" then
				grdText.SetCellData("bd_title", nCnt, "중개형ISA(이수전용) 계좌")
				grdText.SetCellData("bd_text", nCnt, "중개형 ISA 이수전용 계좌는 이전 신청이 필요합니다. 로그인 후 '타사에서 가져오기'에서 이전 신청을 해주세요.")

'				contMISA.lblName.caption = "중개형ISA(이수전용) 계좌"
'				contMISA.lblText.caption = "중개형 ISA 이수전용 계좌는 이전 신청이 필요합니다. 로그인 후 '타사에서 가져오기'에서 이전 신청을 해주세요."
			else
				grdText.SetCellData("bd_title", nCnt, "중개형ISA")
				grdText.SetCellData("bd_text", nCnt, "중개형 ISA 개설 시, 1원을 입금해 드리며 당해년도 납입 가능금액은 연 납입한도 2천만원에서 1원이 차감된 19,999,999원 입니다.")
				
'				contMISA.lblName.caption = "중개형ISA"
'				contMISA.lblText.caption = "중개형 ISA 개설 시, 1원을 입금해 드리며 당해년도 납입 가능금액은 연 납입한도 2천만원에서 1원이 차감된 19,999,999원 입니다."
				
			end if
			
			nCnt = nCnt + 1
		end if
		if szFUOT == "Y" then
			grdText.AddRow()
			grdText.SetCellData("bd_title", nCnt, "선물옵션 계좌")
			grdText.SetCellData("bd_text", nCnt, "파생상품 거래를 위해 관리점에서 승인 절차가 한번 더 이루어집니다. 관리점 승인 후 이용해 주세요.")
			
			nCnt = nCnt + 1
		end if
		if szOVFO == "Y" then
'			grdText.AddRow()
'			grdText.SetCellData("bd_title", nCnt, "해외파생 계좌")
'			grdText.SetCellData("bd_text", nCnt, "파생상품 거래를 위해 관리점에서 승인 절차가 한번 더 이루어집니다. 관리점 승인 후 이용해 주세요.")			
			'grdText.SetCellData("bd_text", nCnt+1, "해외파생거래는 투자위험 1등급 상품으로 실거래 시작 전 충분한 모의거래를 통해 내용을 숙지하시기 바랍니다.")			
'			grdText.SetCellData("bd_text", nCnt, "파생상품 거래를 위해 관리점에서 승인 절차가 한번 더 이루어집니다. 관리점 승인 후 이용해 주세요.\n해외파생거래는 투자위험 1등급 상품으로 실거래 시작 전 충분한 모의거래를 통해 내용을 숙지하시기 바랍니다.")
			
			contOVFO.visible = true
			
			nCnt = nCnt + 1 
		end if
		
		grdText.height = (85 * nCnt) + 2 
		
		if nCnt == 1 then
			if szOVFO == "Y" then
'				imgBottom.top = 138 + 85 + 85 + 65 	
'				lblTitle.top = 158 + 85 + 85 + 65 	
'				grdText.top = 204 + 85 + 85 + 65 	
				
				imgBottom.top = 400
				lblTitle.top  = 420
				grdText.top   = 470
			elseif szFUOT == "Y" then
				imgBottom.top = 138 + 85 + 85 + 85 + 20	
				lblTitle.top  = 158 + 85 + 85 + 85 + 20 	
				grdText.top   = 204 + 85 + 85 + 85 + 20 
			else
				imgBottom.top = 138 + 85 + 85 + 85 	
				lblTitle.top  = 158 + 85 + 85 + 85 	
				grdText.top   = 204 + 85 + 85 + 85 	
			end if
		elseif nCnt == 2 then
			if szOVFO == "Y" then
				if szFUOT == "Y" then
					imgBottom.top = 138 + 85 + 65 + 20 + 20		
					lblTitle.top  = 158 + 85 + 65 + 20 + 20	
					grdText.top   = 204 + 85 + 65 + 20 + 20	
					
					contOVFO.top  = 465
				else
					imgBottom.top = 138 + 85 + 65 + 20		
					lblTitle.top  = 158 + 85 + 65 + 20	
					grdText.top   = 204 + 85 + 65 + 20					
				end if
			else
				if szFUOT == "Y" then
					imgBottom.top = 138 + 85 + 85 + 20 + 20		
					lblTitle.top  = 158 + 85 + 85 + 20 + 20	
					grdText.top   = 204 + 85 + 85 + 20 + 20	
				else
					imgBottom.top = 138 + 85 + 85 + 20		
					lblTitle.top  = 158 + 85 + 85 + 20	
					grdText.top   = 204 + 85 + 85 + 20					
				end if
			end if
		elseif nCnt == 3 then
			if szOVFO == "Y" then
				
				if szFUOT == "Y" then
					imgBottom.top = 138 + 65 + 25 + 20
					lblTitle.top  = 158 + 65 + 25 + 20		
					grdText.top   = 204 + 65 + 25	+ 20			
				
					contOVFO.top = 465
				else
					imgBottom.top = 138 + 65 + 25 			
					lblTitle.top  = 158 + 65 + 25		
					grdText.top   = 204 + 65 + 25				
				
				end if
			else
				imgBottom.top = 138 + 105 + 25
				lblTitle.top  = 158 + 105 + 25		
				grdText.top   = 204 + 105 + 25					
			end if
		elseif nCnt == 4 then
			imgBottom.top = 138 + 30
			lblTitle.top  = 158 + 30
			grdText.top   = 204 + 30
		end if
	end if
End Sub


'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnContinue_OnClick()
	Form.CloseForm()
End Sub

