'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 예약주문
' 02. 화면설명 : 예약주문 주문확인창
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


Dim g_nCount
	g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
Dim g_szOrder_MarketType	' 주문종류 ( J:주식, W:ELW )
Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szOrd_ItmCode		' 종목코드
Dim 	g_szOrd_ItmName		' 종목명
Dim 	g_szOrd_MktType		' 시장구분
Dim 	g_szOrd_Security		' 현금/신용
Dim 	g_szOrd_SmtType		' 소액매매구분
Dim 	g_szOrd_OrdDate		' 대출일자
Dim 	g_nOrd_Qty			' 주문수량
Dim 	g_nOrd_Price			' 주문가격
Dim 	g_nOrd_OrdNo			' 원주문번호
Dim     g_nOrd_ChkTax           ' 과세구분 
'Dim 	g_nOrd_ChkAll			' 잔량전부	


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data()

'    If g_nOrd_ChkAll = "1" Then
'		g_nOrd_Price = "잔량"
 '   End If
    
'    If g_nIndex <> 3 Then
'	    Select Case g_szOrd_OrdType	'단가입력하지 않는 주문유형은 가격 초기화
'		Case 005, 012, 013, 061, 071, 305, 312, 405, 412, 053, 353, 453, 064
'		    g_nOrd_Price = "0"
'		End Select
'    End If

    

	contMaesu1.tblMaesu1.SetCellString( 0, 1, g_szOrder_Acc 	)
	contMaesu1.tblMaesu1.SetCellString( 0, 2, g_szOrder_AccName 	)
	contMaesu1.tblMaesu1.SetCellString( 1, 1, g_szOrd_ItmCode	)
	contMaesu1.tblMaesu1.SetCellString( 2, 1, g_szOrd_ItmName 	)
	contMaesu1.tblMaesu1.SetCellString( 3, 1, g_nOrd_Qty	)
	contMaesu1.tblMaesu1.SetCellString( 4, 1, g_nOrd_OrdNo		)
	
End Function

'============================================================================
Function SendOrder()
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문전송" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
    End If
    
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	

	g_szOrder_MarketType	= arrData( 1)	' 시장종류 
	g_szOrder_Acc			= arrData( 2)	' 계좌번호
	g_szOrder_AccName		= arrData( 3)	' 고객명
	g_szOrd_ItmCode 		= arrData( 4)	' 종목코드
	g_szOrd_ItmName 		= arrData( 5)	' 종목명
	g_szOrd_SmtType  		= arrData( 6)	' 소액매매구분
	g_szOrd_SmtData 		= arrData( 7)	' 소액매매구분값
	g_szOrd_MktType 		= arrData( 8)	' 시장구분
	g_szOrd_OrdDate 		= arrData( 9)	' 매수일자
	g_nOrd_Qty   			= arrData(10)	' 주문수량
	g_nOrd_Price 			= arrData(11)	' 주문가격
	g_nOrd_OrdNo 			= arrData(12)	' 원주문번호
	g_nOrd_ChkTax 		    = arrData(13)	' 과세구분
	
End Sub

'============================================================================
Sub Form_OnFormInit()
 '   contMaesu1.lblMaesu1Title.bgcolor = "29"
    Call Set_Data()
    
End Sub

'============================================================================
Sub contMaesu1_btnMaesu1Close_OnClick()
	Form.CloseForm( )	
End Sub

'============================================================================
Sub contMaesu1_btnMaesu1_OnClick()
	SendOrder()
End Sub

'============================================================================
Sub contMaesu1_imgClose1_OnClick()
	Form.CloseForm( )
End Sub


