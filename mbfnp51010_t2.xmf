'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	g_szAutoMove	=	"0"								'메뉴얼이동
	g_szFullAcnt	= Form.GetCtlProp("#acnt01", "caption")
	g_szFndname	= Form.GetSharedData("&FNDNAME_51010", 0 )

	ResetItems()
	
	'DATAMANAGER.RequestTranData("obsap_acif_999a")		' 금융상품일련번호 채번
	
	if len(g_szFullAcnt)	>	8	then
	    'v012 임동군 변경
		'DATAMANAGER.RequestTranData("obrtp_drab_001r")
		DATAMANAGER.RequestTranData("obsat_deal_109r")
	end if
	
End Sub


