'============================================================================
'cont01_btnAddBuy_OnClick
'============================================================================
Sub cont01_btnAddBuy_OnClick()
	g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")
	g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")
	
	if	Form.GetSharedData( "81010_P20_RST", false ) == "Y" then
			
	else
		Form.ShowAlert(g_szAlertTitle, "금융소비자 유형을 확인해주시기바랍니다.")
		Exit	Sub
	end	if

	if	g_szPasswd = NULL		or	len(trim(g_szPasswd))	<	4	then
		Form.ShowAlert(g_szAlertTitle, "비밀번호를 입력하여주세요")
		Exit	Sub
	end if
	
	if	g_szFullAcnt=	NULL		or	len(trim(g_szFullAcnt)) <	8	then
		Form.ShowAlert(g_szAlertTitle, "계좌를선택하여 주세요")
		Exit	Sub
	end if

	if	g_szRmndNo =	""		or		cont01.tbl01.GetCellString(0, 1)	=	""		then
		Form.ShowAlert(g_szAlertTitle, "매수펀드를 선택하여 주시기 바랍니다.")
		Exit	Sub
	end if

	'21.08.19 JHY START (v0009)
	Dim szMinAmount
	szMinAmount = Form.GetSharedData("obsim_idmn_018r_STA_SDPR" , false)
	
	if tonumber(cont01.edtBuyAmt.caption) <> NULL and tonumber(cont01.tbl02.GetCellString(0, 1)) <> NULL then
		if tonumber(szMinAmount) > tonumber(cont01.edtBuyAmt.caption) then
			Form.ShowAlert(g_szAlertTitle, "신청하신 금액이 신규매수 최소매수금액보다 작습니다. 매수신청 금액을 확인하시기 바랍니다.")
			return -1
		end if
		
		if	tonumber(cont01.edtBuyAmt.caption) > tonumber(cont01.tbl02.GetCellString(0, 1)) or tonumber(cont01.edtBuyAmt.caption) == 0 then
			Form.ShowAlert(g_szAlertTitle, "매수신청금액을 확인바랍니다.")
			return -1
		end	if
		
	else
		Form.ShowAlert(g_szAlertTitle, "매수신청금액을 확인바랍니다.")
		return -1
	end if
	'21.08.19 JHY END
	
	if	g_szAutoMove	=	"1"	then										'자동(신규에서 자동으로 넘어온경우)일때는 공인인증서 로그인
'v0004 sta 테스트 땐 OpenFramePopup("mhetc90060_p5") 내용 주석처리하여 스킵, 추가매수팝업 주석해제하여 매수가능도록 처리하기
		Form.OpenFramePopup("mhetc90060_p5" , "" , sPosInfo)			'공인인증서테스트
'g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")
'g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")

'if	g_szPasswd = NULL		or	len(trim(g_szPasswd))	<	4	then
'	Form.ShowAlert(g_szAlertTitle, "비밀번호를 입력하여주세요")
'	Exit	Sub
'end if
'
'if	g_szFullAcnt = NULL	or	len(g_szFullAcnt)	<	3	then
'	Form.ShowAlert(g_szAlertTitle, "계좌를 선택하여주시기바랍니다.")
'	Exit	Sub
'end	if
'
'if	len(trim(g_szPasswd))	>=	4	and	len(trim(g_szFullAcnt))	>=	10	then
'
'	'계좌번호, 잔고번호, 펀드명, 저축방법, 매수신청금액, 선취수수료 
'	Form.OpenPopup("mbfnp51010_p5" , g_szFullAcnt & "★" &  g_szRmndNo & "★" &  g_szFndname & "★" &
'								 g_szSaveType & "★" &  cont01.edtBuyAmt.caption 
'								, sPosInfo)
'end if
'v0004 fin
	else
	
		'v0001 szRet 추가
		dim	szRet
	
		szRet = chkSteps()
		
		
		if szRet = 1	then
		
	
			if	g_szFullAcnt = NULL	or	len(g_szFullAcnt)	<	3	then
				Form.ShowAlert(g_szAlertTitle, "계좌를 선택하여주시기바랍니다.")
				Exit	Sub
			end	if
			
			if	g_szShortCd = NULL	or	len(g_szShortCd)	<	3	then
				Form.ShowAlert(g_szAlertTitle, "종목을 선택하여주시기바랍니다.")
				Exit	Sub
			end	if
			
			if	g_szPasswd = NULL	or	len(g_szPasswd)	<	3	then
				Form.ShowAlert(g_szAlertTitle, "비밀번호를 입력하여주시기바랍니다.")
				Exit	Sub
			end	if
			
			g_szAccNo	=	left(g_szFullAcnt, 8)
			g_szAsNo		=	mid(g_szFullAcnt,9,2)
			
			if	len(trim(g_szAccNo)) 	>	0	and	 len(trim(g_szAsNo)) 	>	0	and	 
				len(trim(g_szShortCd)) >	0	and	 len(trim(g_szPasswd)) >	0	then
				Form.OpenPopup("mbonl81010_p1" , "51000★1★" & g_szAccNo & "★" &  g_szAsNo & "★" &  g_szShortCd & "★" & g_szPasswd)
			end if
		end if
	end	if

End Sub

'============================================================================
' 21.08.10 JHY 추가
' cont01_edtBuyAmt_OnClick() : 노치 있는 아이폰의 경우, 매수입력금액을 키패드가 가려버려서 컨테이너에 컨트롤들 다 넣고, 스크롤 위치 강제 변경
'============================================================================
Sub cont01_edtBuyAmt_OnClick()
	Dim	szOSType
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	if szOSType <> "1" then
		cont01.lblScrollPos.top = 500
		cont01.SetScrollAutoSize()
		cont01.scroll_pos = 100
	end if
End Sub

'============================================================================
'cont01_edtBuyAmt_OnEditComplete
'============================================================================
Sub cont01_edtBuyAmt_OnEditComplete()
	dim nAbleAmt			'가능금액
	dim nInputAmt			'매수신청금액
	nAbleAmt	=	0
	
	nAbleAmt		=	CDbl(cont01.tbl02.GetCellString(0, 1))
	nInputAmt	=	cont01.edtBuyAmt.caption

	if	Cdbl(nInputAmt)	>	Cdbl(nAbleAmt)	then
		Form.ShowAlert(g_szAlertTitle, "매수가능 금액을 초과합니다.")
		cont01.edtBuyAmt.caption	=	"0"
	end	if
	
	' 21.08.10 JHY START
	' cont01_edtBuyAmt_OnClick() : 노치 있는 아이폰의 경우, 매수입력금액을 키패드가 가려버려서 컨테이너 스크롤 위치 강제 변경한것 제자리로
	Dim	szOSType
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	if szOSType <> "1" then
		cont01.lblScrollPos.top = 0
		cont01.SetScrollAutoSize()
		cont01.scroll_pos = 0
	end if
	' 21.08.10 JHY END
End Sub

'============================================================================
' '21.09.23 JHY : cont01_chkKeyManual_OnChange(sCheckState) : 핵심상품설명서 오픈 (v0010)
'============================================================================
Sub cont01_chkKeyManual_OnChange(sCheckState)
	if g_szPROD_FILE == NULL or g_szPROD_FILE == "" then
		Form.ShowAlert(g_szAlertTitle, "핵심상품설명서 파일이 없습니다.(조회오류)")
		cont01.chkKeyManual.chksilence	=	"0"
		return false
	end if
	
	dim	szURL
	
	if	sCheckState	=	"1"	then

		if	g_szShortCd = NULL	or	len(g_szShortCd) <  3	then
			Form.ShowAlert(g_szAlertTitle, "종목코드를 선택하여주십시오.")
		end	if
		
		If g_szShortCd <> "" then
			szURL = "http://home.imeritz.com/include/ocw/"&g_szPROD_FILE
			Form.OpenPdfViewer( 	szURL, "핵심상품설명서" )
			
			cont01.chkKeyManual.chksilence	=	"1"
	
		End if
	else
	        ' [v0013] 2022.08.02 임동군 주석
		' 투설/간투설/핵심설명서 다시볼 수 있도록 체크 활설/비활성화 로직 살림
		'cont01.chkKeyManual.chksilence	=	"1"
	end	if
End Sub

'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")
	g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")
	
	if	szTranID	=	"obrtp_drab_001r"	then
		DATAMANAGER.SetDataValue(0, "obrtp_drab_001r", "InBlock1", "ACNO", 0, left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0, "obrtp_drab_001r", "InBlock1", "ASNO", 0, mid(g_szFullAcnt,9,2))
    ' v012 임동군 추가
    elseif	szTranID	=	"obsat_deal_109r"	then
		DATAMANAGER.SetDataValue(0, "obsat_deal_109r", "InBlock1", "ACNO", 0, left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0, "obsat_deal_109r", "InBlock1", "ASNO", 0, mid(g_szFullAcnt,9,2))
	elseif	szTranID	=	"obsai_deal_001a"	then
		DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "CONT_CLS_CODE", 0, "4")	'접촉구분코드 HTS 4
		DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "ACNO", 0, left(g_szFullAcnt,8))
		DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "ASNO", 0, mid(g_szFullAcnt,9,2))
		DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "RMND_SRNO", 0, g_szRmndNo )
		DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "CASH_AMT", 0, 	cont01.tbl02.GetCellString(1, 1) )
		DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "RP_VLTN_AMT", 0,cont01.tbl02.GetCellString(2, 1) )
		DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "BYOV_AMT", 0, cont01.edtBuyAmt.caption)
		DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "FNPR_JOIN_SRNO", 0, g_szFnprJoinSrno)
		
		'v0005
		'MTS메모리평문 적용유무
		'plain_rm = ( 0 : 미적용 / 1: 적용)
		plain_rm = Form.GetSharedData("&PLAIN_RM", false )
		'MTS메모리평문 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "ACNT_PWD", 0, g_szPasswd	)	
		'MTS메모리평문 미적용상태 일 때
		else
			DATAMANAGER.SetDataValue(0, "obsai_deal_001a", "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPasswd))
		end if
		
		'21.07.20 JHY START
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CAFU_TRGT_YN" 		, 0 	, g_szCAFU_TRGT_YN ) '숙려대상여부
		
		Dim szHgdtYN, szOldtYN, szInfoYN, szUnfitYN
		szHgdtYN 	= Form.GetSharedData("700r_HGDT_PROD_YN", false) '고난도상품여부
		szOldtYN 	= Form.GetSharedData("700r_CAFU_OLDT_YN", false) '숙려고령자여부
		szInfoYN 	= Form.GetSharedData("700r_INFO_REFS_YN", szInfoYN) '정보미제공여부
		szUnfitYN 	= Form.GetSharedData("700r_UNFIT_YN", szUnfitYN) '부적합여부		
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "HGDT_PROD_YN" 		, 0 	, szHgdtYN ) '고난도상품여부
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CAFU_OLDT_YN" 		, 0 	, szOldtYN ) '숙려고령자여부
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "INFO_REFS_YN" 		, 0 	, szInfoYN ) '정보미제공여부
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UNFIT_YN" 		, 0 	, szUnfitYN ) '부적합여부
		'21.07.20 JHY END
		
		
	'v0002
	elseif	szTranID =	"obcsb_acad_106r" then
		DATAMANAGER.SetDataValue(0, "obcsb_acad_106r", "InBlock1", "ACNO" , 0, left(g_szFullAcnt,8))
	'v0003
	elseif	szTranID =	"obsim_idmn_080r" then
		DATAMANAGER.SetDataValue(0, "obsim_idmn_080r", "InBlock1", "ISCD"				, 0, g_szShortCd	)
		DATAMANAGER.SetDataValue(0, "obsim_idmn_080r", "InBlock1", "MFI_ATCH_FILE_CLCD" 	, 0, "%"			)
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	szCash, szRp
	dim	szMsg
	
	szCash	=""
	szRp		=""
	szMsg	=""
	
	if	szTranID	=	"obrtp_drab_001r"	then
		szCash	= CDbl(DATAMANAGER.GetDataValue(0, "obrtp_drab_001r", "OutBlock1", "ALTN_ABLE_CASH_AMT",0)) 
		szRp 	= CDbl(DATAMANAGER.GetDataValue(0, "obrtp_drab_001r", "OutBlock1", "ALTN_ABLE_RP_VLTN_AMT" ,0))  

		cont01.tbl02.SetCellString(0, 1, trim(szCash + szRp	))	'매수가능 현금
		cont01.tbl02.SetCellString(1, 1, szCash)				'매수가능 현금
		cont01.tbl02.SetCellString(2, 1, szRp)					'매수가능 현금성자산	
	'v012 임동군 추가
    elseif	szTranID	=	"obsat_deal_109r"	then
		szCash	= CDbl(DATAMANAGER.GetDataValue(0, "obsat_deal_109r", "OutBlock1", "CASH_AMT",0)) 
		szRp 	= CDbl(DATAMANAGER.GetDataValue(0, "obsat_deal_109r", "OutBlock1", "RP_VLTN_AMT" ,0))  

		cont01.tbl02.SetCellString(0, 1, trim(szCash + szRp	))	'매수가능 현금
		cont01.tbl02.SetCellString(1, 1, szCash)				'매수가능 현금
		cont01.tbl02.SetCellString(2, 1, szRp)					'매수가능 현금성자산	
	elseif	szTranID	=	"obsai_deal_001a"	then
		'21.07.20 JHY START
		Dim szCAFU_DDLN_STA_DATE, szCAFU_DDLN_FIN_DATE, szINTN_DTRM_STA_DATE, szINTN_DTRM_FIN_DATE
		
		szCAFU_DDLN_STA_DATE	=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_BSOP_DATE1", 0 )
		szCAFU_DDLN_FIN_DATE	=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_BSOP_DATE2", 0 )
		szINTN_DTRM_STA_DATE	=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_BSOP_DATE3", 0 )
		szINTN_DTRM_FIN_DATE	=	DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_BSOP_DATE4", 0 )
		'21.07.20 JHY END
		
		if	DATAMANAGER.GetDataMsgCode("obsai_deal_001a")		=	"8128"	then
			szMsg	=	Form.GetSharedData("&HOST_DATE", 0)
			szMsg	=	szMsg & " 에 매도 신청한 전액매도 결제시, 현재 매수 신청하는 금액은 미포함 됩니다. 처리하시겠습니까?"
			Form.MsgBox(g_szAlertTitle, szMsg, "MSG_8128", 6)
		else				
			
			
			'21.07.20 JHY START
			Inv_ResetItems()
			cont01.edtBuyAmt.caption	=	"0"									'1.	매수가능금액 초기화
			if len(g_szFullAcnt)	>	8	then
			    ' v012 임동군 변경
				'DATAMANAGER.RequestTranData("obrtp_drab_001r")			'2. 잔고재조회
				DATAMANAGER.RequestTranData("obsat_deal_109r")			'2. 잔고재조회
			end if
			
			if g_szCAFU_TRGT_YN = "Y" then 
				Dim szSavingTpCode
				
				if g_szSaveType == "임의식" then
					szSavingTpCode = "1"
				elseif g_szSaveType == "자유적립식" then
					szSavingTpCode = "3"
				end if 
				
				Dim szHgdtYN, szOldtYN, szInfoYN, szUnfitYN
				szHgdtYN 	= Form.GetSharedData("700r_HGDT_PROD_YN", false) '고난도상품여부
				szOldtYN 	= Form.GetSharedData("700r_CAFU_OLDT_YN", false) '숙려고령자여부
				szInfoYN 	= Form.GetSharedData("700r_INFO_REFS_YN", szInfoYN) '정보미제공여부
				szUnfitYN 	= Form.GetSharedData("700r_UNFIT_YN", szUnfitYN) '부적합여부		
				
				Dim szReason
				szReason = "숙려제도 대상 고객"
				
				if szHgdtYN == "Y" then
					szReason = "고난도상품"
				elseif szOldtYN == "Y" then
					szReason = "만 65세 이상 투자자"
				elseif szUnfitYN == "Y" then
					szReason = "부적합투자자"
				end if
				
				Form.OpenPopup("mbonl81010_p9" ,	g_szRmndNo  & "★" &  
													g_szFndname	& "★" & szSavingTpCode	& "★" &
													szReason 	& "★" & szCAFU_DDLN_STA_DATE	& "★" & szCAFU_DDLN_FIN_DATE& "★" & szINTN_DTRM_STA_DATE	& "★" & szINTN_DTRM_FIN_DATE
										, sPosInfo)
			else 
				Form.ShowAlert(g_szAlertTitle, "펀드매수신청이 완료되었습니다.")
			end if
			'21.07.20 JHY END
		end	if
		
		Form.SetSharedData( "81010_P20_RST", "N" )
		
	'v0003 추가
	elseif	szTranID =	"obsim_idmn_080r" then
		 g_szCTCN_FILE = 	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_CTCN_ATCH_FILE_ORTX_NAME", 0)	'집합투자규약 파일명
		 g_szINVT_FILE =	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_INVT_ATCH_FILE_ORTX_NAME", 0)	'투자설명서 파일명
		 g_szCORE_FILE =	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_CORE_ATCH_FILE_ORTX_NAME", 0)	'간이설명서 파일명
		 g_szCO_FILE	=	DATAMANAGER.GetDataValue(0,"obsim_idmn_080r", "OutBlock1", "UI_CO_ATCH_FILE_ORTX_NAME", 0)		'벤처펀드약관 설명서 파일명
		 
		 '21.09.23 JHY START (v0010)
		 g_szPROD_FILE	=	DATAMANAGER.GetDataValue(0,szTranID, "OutBlock1", "UI_PROD_ATCH_FILE_ORTX_NAME", 0)		'UI상품첨부파일원본명
		 '21.09.23 JHY END
	'v0011
	elseif	szTranID	=	"obsai_deal_701r"	then
		 g_szFND_DEAL_RSTC_CLCD = DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "FND_DEAL_RSTC_CLCD", 0)	'펀드매매제한구분코드
		 g_szTN_INFORM_YN = DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "TN_INFORM_YN", 0)		'주의알림여부
		 g_szDEAL_ABLE_YN = DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "DEAL_ABLE_YN", 0)		'매매제한여부
		 
		 if g_szTN_INFORM_YN = "Y" then
			 if g_szFND_DEAL_RSTC_CLCD = "001" then
				 'Form.ShowAlert(g_szAlertTitle, "선택하신 펀드는 횡령사건으로 거래가 중지된 오스템임플란트 주식을 편입하고 있습니다. 해당펀드는 오스템임플란트 주가를 작년말 종가로 기준가격에 반영하고 있어 향후 전개상황에 따라 펀드 수익률 변동이 예상됩니다. 투자의사 결정시 참고하시기 바랍니다. 자세한 사항은 고객센터(1588-3400) 또는 거래 영업점으로 문의하시기 바랍니다.")
				 Form.ShowAlert(g_szAlertTitle, "선택하신 펀드는 오스템임플란트 주식(2022.01.03일자 거래정지)을 편입하고 있습니다. 오스템임플란트 주식을 편입한 펀드의 경우, 운용사에서 공정가치 재평가 후 자산 상각을 진행하여 기준가에 반영하였으나 향후 추가 상각될 가능성이 있습니다. 이와 관련하여 편입비율 변동 및 추가 위험에 노출될 수 있으니 투자시 유의하시기 바랍니다. 자세한 사항은 거래 영업점 또는 고객센터(1588-3400)로 문의하시기 바랍니다.")
				 

			 elseif g_szFND_DEAL_RSTC_CLCD = "002" then
				 Form.ShowAlert(g_szAlertTitle, "선택하신 펀드는 주요 투자 지역(러시아)의 지정학적 리스크 확대 및 투자자산의 유동성 제한에 따라 환매 연기 조치 되었습니다. 이에 따라 적립식 매수를 포함한 매수신청이 제한됨을 안내드립니다.")	 
			 end if
			 
			 if g_szDEAL_ABLE_YN = "N" then
				 cont01.btnAddBuy.enable = FALSE
			 else 
				 cont01.btnAddBuy.enable = TRUE
			 end if
		 else 
			 cont01.btnAddBuy.enable = TRUE
		 end if
	elseif	szTranID	=	"obsap_acif_999a"	then
		Dim szFnprJoinSrno
		g_szFnprJoinSrno = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FNPR_JOIN_SRNO", 0)		'금융상품일련번호
		Form.SetSharedData("FNPR_JOIN_SRNO", g_szFnprJoinSrno)	
		Form.SetSharedData("SPCL_CNFR_ACNO", left(g_szFullAcnt, 8))	
		
		'잔고번호가 있으면
		if TRIM(cont01.tbl01.GetCellString(0, 1)) <> "" then
			Form.OpenPopup("mbonl81010_p20" , "" , "")
		end if
		
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'v0002
	if szTranID =	"obcsb_acad_106r" and szErrCode = "5820" then
		Form.OpenPopup("mbfnp51010_p10" , "통보처★" & left(g_szFullAcnt, 8), sPosInfo) ''에러
	else
	
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
		if	len(trim(szSubMsg))	>	0	then
			Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szAlertTitle, szErrMsg )
		end	if
	end if
End Sub


'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	dim	szNewAcnt	'이벤트에 의해 가져온 계좌번호
	szNewAcnt	=	""

	if	sEventName		=	"FNDCODE_CHG"	then					'펀드코드변경
		if	len(sParam)	>	3	then
			
			g_szShortCd	=	getListItem(sParam, 0)
			g_szStndCd	=	getListItem(sParam, 1)
			g_szFndname	=	getListItem(sParam, 2)
			
			'v0011
			DATAMANAGER.SetDataValue(0, "obsai_deal_701r" , "InBlock1", "ISCD", 0 , TRIM(g_szShortCd))
			DATAMANAGER.SetDataValue(0, "obsai_deal_701r" , "InBlock1", "FND_DEAL_CLCD", 0 , "02") '추가매수
			DATAMANAGER.RequestTranData("obsai_deal_701r")
		end	if
		
		Inv_ResetItems() 'v0001 펀드코드변경시 투자설명서 체크 초기화
		
		'v0003
		if	len(g_szShortCd)	>	3	then						'ShortCD 필요
			getInvtAtchFile()
		end if
		
	elseif	sEventName		=	"ACNTINFO_CHG"	then
		szNewAcnt= Form.GetCtlProp("#acnt01", "caption")
	
		if	szNewAcnt	<>	g_szFullAcnt	then		'계좌가 변경될때만 잔고팝업올림
			
			g_szFullAcnt	=	szNewAcnt	
			'v0006 sta
			cont01_btnBal_OnClick()						'계좌콤보 변경시 잔고팝업처리
			'v0006 fin
		end	if
	
		if len(g_szFullAcnt)	>	8	then
		    ' v012 임동군 변경
			'DATAMANAGER.RequestTranData("obrtp_drab_001r")			'잔고는 계좌만 있으면 됨
			DATAMANAGER.RequestTranData("obsat_deal_109r")			'잔고는 계좌만 있으면 됨
		end if
		
		
		
'		'v0002 추가
		DATAMANAGER.RequestTranData("obcsb_acad_106r")			'실질수익률보고서 통보처 조회
		
		Inv_ResetItems()	'v0001 계좌변경시 투자설명서 체크 초기화
				
		
	elseif	sEventName	=	"PWDINFO_CHG"	then
		
		if len(g_szFullAcnt)	>	8	then
		    ' v012 임동군 변경
			'DATAMANAGER.RequestTranData("obrtp_drab_001r")			'잔고는 계좌만 있으면 됨
			DATAMANAGER.RequestTranData("obsat_deal_109r")			'잔고는 계좌만 있으면 됨
		end if
		
	elseif	sEventName	=	"BUY_NOCHK"	then						'투자성향진단태우지않도록
		g_szAutoMove	=	"1"
		
		'신규매수로 들어온 건에 대해선 다시 투자설명서, 성향진단 체크 안 보이도록 함.  v0001
		cont01.chkExplain.visible = False
		cont01.chkCapExplain.visible = False
		
		'21.09.23 JHY START (v0010)
		cont01.chkKeyManual.visible = False
		'21.09.23 JHY END
'		cont01.chkPolicy.visible = False		
		
		cont01.btnDeal.top = 238
		cont01.btnDeal.left = 10
		cont01.btnDeal.height = 39
		cont01.btnDeal.width = 172
		
		cont01.btnCaution.top = 238
		cont01.btnCaution.left = 192
		cont01.btnCaution.height = 39
		cont01.btnCaution.width = 172
		
		
	'--------------------------------------------
	'잔고번호 있을시
	'--------------------------------------------
	elseif	sEventName	=	"INIT_WITHRMNO"	then
	
		g_szRmndNo 	= 	Form.GetSharedData("RMNDNO_51010", 1)
		g_szSaveType	=	Form.GetSharedData("SAVETYPE_51010", 0)

		cont01.tbl01.SetCellString(0, 1, g_szRmndNo)							'잔고번호
		cont01.tbl01.SetCellString(1, 1, g_szSaveType)							'저축방법
		DATAMANAGER.RequestTranData("obsap_acif_999a")		' 금융상품일련번호 채번
		
	'--------------------------------------------
	'잔고번호 없을시
	'--------------------------------------------	
	elseif	sEventName	=	"INIT_NORMNO"	then
		'1. 잔고 조회
		cont01_btnBal_OnClick()
		
	'--------------------------------------------
	'종목검색을 통해이벤트 받을시
	'--------------------------------------------	
	elseif	sEventName	=	"RESET_ITEM"	then							
		ResetItems()
		g_szShortCd	= ""
		g_szFndname	= ""
	end if
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim	szRmno,	szFundCode,	szStndCode,	szFundName

	'-----------------------------------
	'잔고팝업(CLOSE시)
	'-----------------------------------	
	if	sKeyName	=	"51010_RMNOSELECTED"	then
		if	sRet	=	"0"		then
			'Form.triggerEvent("#", "CHGTAB_51010", "4")
			ResetItems()	'잔고, 저축타입,매수금액초기화
		end	if
	
	'-----------------------------------
	'잔고팝업
	'-----------------------------------	
	elseif	sKeyName	=	"51010_RMNO"	then
	
		if	len(sRet)	>	4	then
			szRmno		=	getListItem(sRet, 0)
			g_szSaveType	=	getListItem(sRet, 1)
			szFundCode	=	getListItem(sRet, 2)	'펀드코드
			szStndCode	=	getListItem(sRet, 3)	'표준코드
			szFundName	=	getListItem(sRet, 4)	'펀드명
					
			cont01.tbl01.SetCellString(0, 1, szRmno)		'잔고번호
			cont01.tbl01.SetCellString(1, 1, g_szSaveType)	'저축방법
				
			g_szRmndNo	=	szRmno
			
			Form.triggerEvent("#", "CHGCODE_51010", szFundCode & "★" &	 szStndCode & "★" & szFundName)
			cont01.edtBuyAmt.caption	=	"0"			'매수가능금액
		end	if	
		
	'-----------------------------------
	'공인인증검증
	'-----------------------------------	
	elseif	sKeyName	=	"mhetc90060_p5"	then			

		if	 sRet	<>	"cancel"		then
		
			g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")
			g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")

			if	g_szPasswd = NULL		or	len(trim(g_szPasswd))	<	4	then
				Form.ShowAlert(g_szAlertTitle, "비밀번호를 입력하여주세요")
				Exit	Sub
			end if
			
			if	g_szFullAcnt = NULL	or	len(g_szFullAcnt)	<	3	then
				Form.ShowAlert(g_szAlertTitle, "계좌를 선택하여주시기바랍니다.")
				Exit	Sub
			end	if
			
			if	len(trim(g_szPasswd))	>=	4	and	len(trim(g_szFullAcnt))	>=	10	then
		
				'계좌번호, 잔고번호, 펀드명, 저축방법, 매수신청금액, 선취수수료 
				Form.OpenPopup("mbfnp51010_p5" , g_szFullAcnt & "★" &  g_szRmndNo & "★" &  g_szFndname & "★" &
											 g_szSaveType & "★" &  cont01.edtBuyAmt.caption 
											, sPosInfo)
									
			end	if					
		end	if
		
	'-----------------------------------
	'추가매수확인팝업
	'-----------------------------------		
	elseif	sKeyName	=	"mbfnp51010_p5"	then
		
		szSect	=	getListItem(sRet, 0)
		
		if	szSect	=	"ok"		then
			g_szDealFee	=	getListItem(sRet, 1)
			
			DATAMANAGER.SetEventFlag("obsai_deal_001a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_001a")	'매수신청
		end	if
	
	'-----------------------------------
	'투자성향확인
	'-----------------------------------		
	elseif	sKeyName = 	"KYCCHK_RETURN"	then
		if	sRet	=	"Y"	then
			'21.07.20 JHY START
			'숙려대상여부 
			g_szCAFU_TRGT_YN		= Form.GetSharedData("CAFU_TRGT_YN", 0 )
'		g_szCAFU_TRGT_YN = "Y" '테스트	
			'21.07.20 JHY END
	
' 테스트 끝나면 앞정렬 지우고 밑에 주석처리 풀기 v0004 sta
			Form.OpenFramePopup("mhetc90060_p5" , "" , sPosInfo)			'공통프로세스 체크완료후 공인인증서
'g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")
'g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")

'if	g_szPasswd = NULL		or	len(trim(g_szPasswd))	<	4	then
'	Form.ShowAlert(g_szAlertTitle, "비밀번호를 입력하여주세요")
'	Exit	Sub
'end if
'
'if	g_szFullAcnt = NULL	or	len(g_szFullAcnt)	<	3	then
'	Form.ShowAlert(g_szAlertTitle, "계좌를 선택하여주시기바랍니다.")
'	Exit	Sub
'end	if
'
'if	len(trim(g_szPasswd))	>=	4	and	len(trim(g_szFullAcnt))	>=	10	then
'
'	'계좌번호, 잔고번호, 펀드명, 저축방법, 매수신청금액, 선취수수료 
'	Form.OpenPopup("mbfnp51010_p5" , g_szFullAcnt & "★" &  g_szRmndNo & "★" &  g_szFndname & "★" &
'								 g_szSaveType & "★" &  cont01.edtBuyAmt.caption 
'								, sPosInfo)
'end if
'v0004 fin
		else
			Exit Sub
		end if
	
	'-----------------------------------------------
	'펀드 실질투자수익률 보고서 통보처 팝업 v0002
	'-----------------------------------------------
	elseif	sKeyName =	"returnACTL_RPRT_INAG"	then
		'통보처 등록 성공
		if	sRet =	"SUCC" then
			
			DATAMANAGER.RequestTranData("obcsb_acad_106r")
		'통보처 등록 실패
		else
			Form.ShowAlert("알림", "펀드 실질투자수익률 보고서 통보처 선택은 필수입니다.")
			Form.OpenPopup("mbfnp51010_p10" , "통보처★" & left(g_szFullAcnt, 8), sPosInfo) ''에러
			'cont01.btnBuy.enable = False
		end if

	'-----------------------------------------------
	'숙려안내 popup return
	'-----------------------------------------------	
	elseif	sKeyName = "mbonl81010_p9"		then						'고위험거래확인팝업
		if 	sRet = 	"OK" then
			Form.ShowAlert(g_szAlertTitle, "펀드매수신청이 완료되었습니다.")
		end if
	'21.07.09 JHY END	
	end if
End Sub


'============================================================================
'Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if	sKeyName	=	"MSG_8128"	then
		if	sRet	=	"ok"	then
			cont01.cmbAplyYN.cbkeydata	=	"Y"
			DATAMANAGER.RequestTranData("obsai_deal_001a")	'매수신청
		else
			cont01.cmbAplyYN.cbkeydata	=	"N"
		end	if
	end	if
End Sub


'============================================================================
'cont01_chkExplain_OnChange v0001
'============================================================================
Sub cont01_chkExplain_OnChange(sCheckState)
	dim	szURL
	
	if	sCheckState	=	"1"	then
		if	g_szShortCd = NULL	or	len(g_szShortCd) <  3	then
			Form.ShowAlert(g_szAlertTitle, "종목코드를 선택하여주십시오.")
		end	if
		
		If g_szShortCd <> "" then
		    'g_zer_st = string(12-len(g_szShortCd),"0") & g_szShortCd 
			'szURL = "http://home.imeritz.com/include/ocw/"& g_zer_st&"T.pdf" 
			
			'v0003
			szURL = "http://home.imeritz.com/include/ocw/"&g_szINVT_FILE
			Form.OpenPdfViewer( 	szURL, "투자설명서" )
			
			cont01.chkExplain.chksilence	=	"1"
		End if
	else
	        ' [v0013] 2022.08.02 임동군 주석
		' 투설/간투설/핵심설명서 다시볼 수 있도록 체크 활설/비활성화 로직 살림
		'cont01.chkExplain.chksilence	=	"1"
	end	if
End Sub

