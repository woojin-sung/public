'============================================================================
'cont01_btnBal_OnClick
'============================================================================
Sub cont01_btnBal_OnClick()
	cont01.tbl01.SetCellString(0, 1, "")							'잔고번호
	cont01.tbl01.SetCellString(1, 1, "")							'저축방법
	DATAMANAGER.RequestTranData("obsap_acif_999a")		' 금융상품일련번호 채번
	Form.OpenPopup("mbfnp51010_p2" , g_szFullAcnt , sPosInfo)
End Sub


'============================================================================
'cont01_btnAll_OnClick
'============================================================================
Sub cont01_btnAll_OnClick()
	dim szOrgNum
	
	szOrgNum = cont01.tbl02.GetCellString(0, 1)
	cont01.edtBuyAmt.caption	=	szOrgNum
End Sub


'============================================================================
'cont01_btnDeal_OnClick
'============================================================================
Sub cont01_btnDeal_OnClick()
'	dim	szFundcd,	szFundName
'	
'	szFundcd		=	Form.GetSharedData("FUNDCODE_51010", 0)	'결제정보, 	from fmtab
'	szFundName	=	Form.GetSharedData("FNDNAME_51010", 0)	'결제정보,	from fmtab
	if	g_szShortCd	=	NULL  or	len(g_szShortCd) < 3 	then
		Form.ShowAlert(g_szAlertTitle, "종목 코드를 입력하세요.")
		Exit	Sub
	end	if
	
	
	if	len(g_szShortCd)	>	0	and	len(g_szFndname) > 0	then
		'-------------------------
		' 결제정보 팝업:  
		' 1. ShortCode
		' 2. 펀드명 
		'--------------------------
		Form.OpenPopup("mbfnp51010_p3" , g_szShortCd & "★" & g_szFndname , sPosInfo)
	end if

End Sub


