			'v0003
			szURL = "http://home.imeritz.com/include/ocw/"&g_szCORE_FILE
			Form.OpenPdfViewer( 	szURL, "간이투자설명서" )
			
			cont01.chkCapExplain.chksilence	=	"1"
	
