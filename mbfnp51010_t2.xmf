dim	g_szDealFee		'선취수수료
dim	g_szAlertTitle	'알림타이틀
dim	g_szAutoMove		'신규매수에서 넘어온것인지

Dim g_szCTCN_FILE			'집합투자규약 파일명
Dim g_szINVT_FILE			'투자설명서 파일명
Dim g_szCORE_FILE			'간이설명서 파일명
Dim g_szCO_FILE			'벤처펀드약관 설명서 파일명

g_szFullAcnt	=	""	
g_szPasswd	=	""
g_szRmndNo	=	""

g_szShortCd	=	""
g_szStndCd	=	""
g_szFndname	=	""
g_szSaveType	=	""
g_szDealFee	=	""
g_szAlertTitle	=	"알림"
g_szAutoMove	=	"0"			'메뉴얼

Dim g_szFnprJoinSrno
Dim g_szPROD_FILE '21.09.23 추가 : UI상품첨부파일원본명 (v0010)
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'ResetItems
'============================================================================
Function	ResetItems()

	'1. 잔고번호
	'2. 저축방법
	'3. 매수가능금액초기화

	cont01.tbl01.SetCellString(0, 1, "")		'잔고번호
	cont01.tbl01.SetCellString(1, 1, "")		'저축방법
	cont01.edtBuyAmt.caption	=	"0"			'매수가능금액
	g_szRmndNo	=	""				'잔고번호
	g_szSaveType	=	""				'저축방법

End	Function

'============================================================================
'AddNum	:	수량입력
'============================================================================
Function	AddNum(nAddNum)
	dim szOrgNum
	
	szOrgNum = cont01.edtBuyAmt.caption	
	cont01.edtBuyAmt.caption	=	szOrgNum + nAddNum
	
	if	CDBL(cont01.edtBuyAmt.caption)		>	CDbl(cont01.tbl02.GetCellString(0, 1))	then
		Form.ShowAlert(g_szAlertTitle, "매수신청금액을 확인바랍니다.")
		cont01.edtBuyAmt.caption	=	"0"
	end	if
End Function


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function

'============================================================================
'투자설명서 가져오는 함수
'============================================================================
Function getInvtAtchFile()
 	
	DATAMANAGER.RequestTranData("obsim_idmn_080r")

End Function


