'20230913 LES START : stck_cntg -> stck_incg로 교체

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szItemCode, g_szItemMarket

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Function SetHogaTblFgColor( nPrice )

	If nPrice  > 0 then 
		tblHoga.SetCellFgColor( 0, 0, "10" )
	ElseIf nPrice < 0 then
		tblHoga.SetCellFgColor( 0, 0, "11" )
	Else
		tblHoga.SetCellFgColor( 0, 0, "12" )
	End If

End Function

'============================================================================
Sub Form_OnFormInitBefore()
'	g_szItemCode =  Form.GetSharedData( "&ITEM_STOCK", 0 )
'	g_szItemCode = "005930"
'	g_szItemMarket = "J"
	
	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	

	g_szItemCode		= arrData(0)
	g_szItemMarket	= arrData(1)	
	
	Form.SetScreenName( arrData(2) )

	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	If Trim( g_szItemCode ) <> "" Then	
		DATAMANAGER.RequestTranData( "ohhts_1001_001r" )	
		Web0.urlpath = "http://m.comp.fnguide.com/svo/mobilecompany.asp?cid=10&colortype=w&gicode=" & g_szItemCode
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , g_szItemMarket )
	DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_szItemCode )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)

	'20230913 LES START : stck_cntg -> stck_incg로 교체
	'DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , g_szItemCode )
	DATAMANAGER.SetDataValue( 1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD" , 0 , g_szItemCode )
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim 	nPrice					'전일대비
	
	nPrice = DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_PRDY_VRSS" , 0 )	
	SetHogaTblFgColor( CDbl( nPrice ) )
	
	'20230913 LES START : stck_cntg -> stck_incg로 교체
	'DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
	DATAMANAGER.RequestRealData( "ohhts_stck_incg" )
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	'Form.SendReturnToParent("mhprc11000_p4" , "contHoga.scroll_pos")
End Sub

