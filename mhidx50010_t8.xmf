'============================================================================
' 01. 화 면 명 : HOME_시장지표
' 02. 화면설명 : 시장지표
' 03. 작    성 : 
'============================================================================
Dim g_szSpData
Dim nRow
Dim g_szOsType
'============================================================================
Sub Form_OnFormInit()	
	g_szOsType = Form.GetSharedData("&OS_TYPE", false )

	InsertTab1()
End Sub

'============================================================================
Sub InsertTab1()
	FormTab0.insertPage( 0, "page0", "page0", "empty", "0", " 환율 ")
	FormTab0.insertPage( 1, "page1", "page1", "empty", "0", " 귀금속 ")
	FormTab0.insertPage( 2, "page2", "page2", "empty", "0", " 비철금속 ")	'20231214 HSZ: 하락률 추가
	FormTab0.insertPage( 3, "page3", "page3", "empty", "0", " 곡물 ")
	FormTab0.insertPage( 4, "page4", "page4", "empty", "0", "  원유  ")	
End Sub

'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim szData

	DATAMANAGER.CancelRealData("ohhts_exrt_cntg")
	DATAMANAGER.CancelRealData("ohhts_nfut_cntg")
	
	if szTranID = "ohhts_1684_001r" then
	    For i = 0 to 2
			Select Case i
			Case 0			    
			    szData = "USDKRWSMBS" '원/달러
			Case 1
			    szData = "USDCNYCOMP" '중국 위안/달러
			Case 2
			    szData = "USDJPYCOMP" '일본 엔/달러 
			End Select
		    
		    DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i , "EN" )
		    DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_ISCD" , i , szData )
	    Next	    

	else
		For i = 0 to 2
		    DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , i , "FN" )
		    DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD" , i , g_szSpData(i) )
		Next
	End if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	dim ncnt1684
	dim szOrgTime
		
	ncnt1684 = DATAMANAGER.GetDataCount(0, "ohhts_1684_001r" , "OutBlock1")
	
	if szTranID = "ohhts_1684_001r" then
		
		for i = 0 to 2
			szOrgTime = DATAMANAGER.GetDataValue(0, "ohhts_1684_001r", "OutBlock1", "FID_CNCN_DATE", i)
			if szOrgTime = "" or szOrgTime = null then '20220302 HSZ : 예외처리 추가
				exit Sub
			else
				DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "OutBlock1", "FID_CNCN_DATE", i , mid(szOrgTIme,3,2) &  mid(szOrgTIme,5,2)  &  mid(szOrgTIme,7,2)  )
			end if
		next	
	end if 
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim szRealID
	
	if szTranID = "ohhts_1684_001r" then 
		szRealID = "ohhts_exrt_cntg"	'환율
	else
		szRealID = "ohhts_nfut_cntg"	'해외선물
	end if
	
	DATAMANAGER.CancelRealData("ohhts_exrt_cntg")
	DATAMANAGER.CancelRealData("ohhts_nfut_cntg")
	
	for i = 0 to 2
		szRealCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_CNCN_ISCD", i )
		szSignData = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN", i ))
		
		diff			= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FID_CNCN_PRDY_VRSS" , i )
		sign			= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN", i )
		
		'패딩 설정
		if g_szOsType == "1" then
			Pannel0.setPropCardCell("paddinginfo","Change0",i,"0,0,0,0")
			Pannel0.setPropCardCell("paddinginfo","lblPr",i,"0,0,3,0")
		else
			Pannel0.setPropCardCell("paddinginfo","lblPr",i,"0,0,4,0")
		end if
			
		'현재가 색상 세팅 방지
		Pannel0.setPropCardCell("attributeenable","lblPr",i,"0")
		
		'등락컨트롤 세팅
		Pannel0.setPropCardCell("signpos","Change0", i, "1")		'등락기호 좌측세팅
		Pannel0.setPropCardCell("caption","Change0",i, diff)
		Pannel0.SetCellValue("Change0", i, diff)
		Pannel0.setPropCardCell("changesign","Change0", i, sign)	
		
		'동일 이미지 중복세팅 방지 & 등락률 이미지 세팅
		if szSignData = 1 or szSignData = 2 then
			Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1")
			Pannel0.setPropCardCell("imgpath", "imgBg", i, "roundbox_4r_pink.9.png")
		elseif szSignData = 4 or szSignData = 5 then
			Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1")
			Pannel0.setPropCardCell("imgpath", "imgBg", i, "roundbox_4r_blue.9.png")
		else
			Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1")
			Pannel0.setPropCardCell("imgpath", "imgBg", i, "roundbox_4r_gray.9.png")
		end if
		
		' 실시간 인풋 세팅
		DATAMANAGER.SetDataValue(1, szRealID, "InBlock1", "FIDR_SYMB", i, szRealCode) 
	Next	    
	
	DATAMANAGER.RequestRealData(szRealID)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	dim ncntExrt
	dim szOrgTime

	nRow = -1
	
	szCode = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_SYMB" , 0 )
	nRow = Pannel0.FindRow("lblCode",szCode,0)
	
	if nRow >= 0 then

		'등락 컨트롤 값 세팅
		if szTranID 		= "ohhts_exrt_cntg" then		'환율 실시간
			diff			= DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_EXRT_PRDY_VRSS" , j )
		elseif szTranID 	= "ohhts_nfut_cntg" then	'해외선물 실시간
			diff			= DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_PRDY_VRSS2" , j )
		end if
		sign				= DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", "FIDR_PRDY_VRSS_SIGN", j )
		
		Pannel0.setPropCardCell("caption","Change0",nRow,diff)
		Pannel0.SetCellValue("Change0",nRow,diff)
		Pannel0.setPropCardCell("changesign","Change0",nRow,sign)
			
		'실시간에 따라 등락률 배경이미지 변경
		szSignData	= CInt( Pannel0.GetCellValue("lblSign",nRow) )
					
		if szSignData = 1 or szSignData = 2 then
			Pannel0.setPropCardCell("imgpath", "imgBg", nRow, "roundbox_4r_pink.9.png")
		elseif szSignData = 4 or szSignData = 5 then
			Pannel0.setPropCardCell("imgpath", "imgBg", nRow, "roundbox_4r_blue.9.png")
		else
			Pannel0.setPropCardCell("imgpath", "imgBg", nRow, "roundbox_4r_gray.9.png")
		end if
			
	end if
	
End Sub

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	dim szSymbol
	dim szMarket
	dim szName
	
	szSymbol = Pannel0.GetCellValue("lblCode",nIndex)
	szMarket = Pannel0.GetCellValue("lblMarket",nIndex)
	szName = Pannel0.GetCellValue("lblName",nIndex)
	
	Form.OpenFramePopup("mhidx42040_p1" , szSymbol & "★" &  szMarket & "★" & szName , "")
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)

    Select Case CInt(nCurrentTab)
	    Case 0
		    '환율: 원/달러, 중국 위안/달러, 일본 엔/달러
			szData = "USDKRWSMBS:USDCNYCOMP:USDJPYCOMP"
			g_szSpData = Split(szData, ":")
			 
			DATAMANAGER.RequestTranData("ohhts_1684_001r")
	    Case 1
		    '귀금속비: 금, 은, 백금
			szData = "COM@GC:COM@SI:NYM@PL"
			g_szSpData = Split(szData, ":")
		    
			DATAMANAGER.RequestTranData("ohhts_1682_001r")
	    Case 2
		    '비철금속: 동 최근월, 납 캐시, 아연 캐시    
			szData = "COM@HG:LME@PDY:LME@ZDY"		    
			g_szSpData = Split(szData, ":")	
		    
		    DATAMANAGER.RequestTranData("ohhts_1682_001r")
	    Case 3
		    '곡물: 옥수수 최근월, 대두 최근월, 소맥 최근월
			szData = "CBT$ZC:CBT$ZS:CBT$ZW"
			g_szSpData = Split(szData, ":")	
		    
		    DATAMANAGER.RequestTranData("ohhts_1682_001r")
	    Case 4
		    '원유: WTI 최근월, 브렌트유 최근월, 두바이유 현물
			szData = "NYM@CL:IPE@EB:SPT@DU"
			g_szSpData = Split(szData, ":")
		    
			DATAMANAGER.RequestTranData("ohhts_1682_001r")
	End Select
	    
End Sub

'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData("ohhts_exrt_cntg")
	DATAMANAGER.CancelRealData("ohhts_nfut_cntg")
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	nTab = FormTab0.currenttab
	call FormTab0_OnTabChanged(nTab)
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "TAB_CHANGE" then
		if trim(sParam) <> "" then
			FormTab0.currenttab = CInt(sParam)
			call FormTab0_OnTabChanged(sParam)
		end if
	end if
	
End Sub

