	<SCRIPT_INFO _len="9863" _ulen="9185" >
dim g_arrCodeInfo
dim g_tImage

g_tImage = {["0"]="realtime_red", ["1"]="realtime_gray"}	'red:실시간  gray:지연

'============================================================================
Sub Form_OnFormInit()
	'왼쪽 항목캡션 셋팅
	f_TitleCaption()
	
	'2열만 남기고 히든처리
	f_ColHidden()
End Sub

'============================================================================
Sub f_ColHidden()
	for i = 3 to 5
		Grid0.SetVisibleCol( i, "0" )
	next
End Sub

'============================================================================
Sub f_TitleCaption()
	dim nDataCnt, arrData
	
	nDataCnt = 11
	
	Grid0.rowcount = 1
	
	arrData = {"현재가", "대비/등락률", "52주등락률", "거래량", "평균거래량(3개월)", 
				"업종", "산업", "시가총액(백만)", "PER",
				"PBR", "EPS" }
	
	for i = 0 to nDataCnt - 1
		Grid0.SetCellData( "bd_title"..i, 0, arrData[i] )
	next
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData( 0, szTranID )
	
	if szTranID == "ohhts_6252_001r" then
		dim tCodeInfo
		dim szCodeMarket, szCode, szMarket, nRealTime
		
		if CStr(Instr(g_arrCodeInfo, "★")) <> "0" then
			tCodeInfo = split(g_arrCodeInfo, "★")
			
			for i = 0 to #tCodeInfo - 1
				'열보임
				Grid0.SetVisibleCol( i+1, "1" )
				
				szCodeMarket = split(tCodeInfo[i], "@")

				szMarket = szCodeMarket[0] 
				szCode = szCodeMarket[1]
				
				nRealTime = FormatNumber(Form.GetSharedData("REALTIME_"..szMarket, false), 0)

				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" ,	i, "OV")		'FID입력조건시장분류코드
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_COND_MRKT_CLS_CODE" , 			i, szMarket)	'FID조건시장구분코드
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_OVRS_ISCD" , 			i, szCode)	'FID입력해외종목코드
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 	i, nRealTime)	'FIDX입력지연실시간구분코드
				
				DATAMANAGER.SetDataValue(1, "ohhts_exst_ictg" , "InBlock1" , "FIDXR_ISCD" , i ,szMarket.."@"..szCode)'FIDXR종목코드(종목코드로 for문 돌고 있어서 미리셋팅)
			next
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6252_001r" then
		dim nDataCnt
		
		nDataCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")

		dim sFID_CNCN_DATE, sFIDX_ISCD, sFIDX_KOR_ISNM, sFIDX_PRPR, sFIDX_PRDY_VRSS_SIGN
		dim sFIDX_PRDY_VRSS, sFIDX_PRDY_CTRT, FIDX_52_WEEK_RSFL_RT, sFIDX_ACML_VOL, sFIDX_M3_AVRG_VOL
		dim sFIDX_BSTP_LRDV_NAME, sFIDX_BSTP_MDDV_NAME, sFIDX_AVLS, sFID_CNCN_DVDN_ERT
		dim sFID_CNCN_PER, sFID_CNCN_PBR, sFID_CNCN_PCR, sFID_CNCN_EPS
		
		dim sREALTIME

		for i = 0 to nDataCnt - 1
			sFID_CNCN_DATE = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_COND_MRKT_CLS_CODE", i)	'FID조건 시장구분코드
			sFIDX_ISCD = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_ISCD", i)					'FIDX종목코드
			sFIDX_KOR_ISNM = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_KOR_ISNM", i)			'FIDX한글종목명
			sFIDX_PRPR = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_PRPR", i)					'FIDX현재가
			sFIDX_PRDY_VRSS_SIGN = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_PRDY_VRSS_SIGN", i)	'FIDX전일대비부호
			
			sFIDX_PRDY_VRSS = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_PRDY_VRSS", i)			'FIDX전일대비
			sFIDX_PRDY_CTRT = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_PRDY_CTRT", i)			'FIDX전일대비율
			sFIDX_52_WEEK_RSFL_RT = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_52_WEEK_RSFL_RT", i)'FIDX52주등락률
			sFIDX_ACML_VOL = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_ACML_VOL", i)			'FIDX누적거래량
			sFIDX_M3_AVRG_VOL = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_M3_AVRG_VOL", i)		'FIDX3개월평균거래량
			sFIDX_BSTP_LRDV_NAME = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_BSTP_LRDV_NAME", i)	'FIDX업종대분류명
			
			sFIDX_BSTP_MDDV_NAME = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_BSTP_MDDV_NAME", i)	'FIDX업종중분류명
			sFIDX_AVLS = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_AVLS", i)					'FIDX시가총액
			sFID_CNCN_PER = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_CNCN_PER", i)				'FID관심PER
			sFID_CNCN_PBR = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_CNCN_PBR", i)				'FID관심PBR
			sFID_CNCN_EPS = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_CNCN_EPS", i)				'FID관심EPS
			
			Form.SetCtlProp("lblDebi"..i, "caption", sFIDX_PRDY_VRSS)
			
			sFIDX_PRDY_VRSS = Form.GetCtlProp("lblDebi"..i, "dispcaption")
			sFIDX_PRDY_CTRT = FormatNumber(sFIDX_PRDY_CTRT, 2)
			sFIDX_AVLS = tonumber(sFIDX_AVLS)/1000
			
			'그리드 헤더(종목명)
			Grid0.SetCellTopCaption( "th_name"..i+1, sFIDX_KOR_ISNM )
			Grid0.SetCellTopCaption( "th_code"..i+1, "("..sFIDX_ISCD..")" )
			
			'그리드 컬럼
			Grid0.SetCellData( "bd_val1"..i, 	0, sFIDX_PRPR )							'현재가
			Grid0.SetCellData( "bd_sign2"..i, 	0, sFIDX_PRDY_VRSS_SIGN )					'전일대비부호
			Grid0.SetCellData( "bd_val2"..i, 	0, Replace(sFIDX_PRDY_VRSS, "-", "").." / "..sFIDX_PRDY_CTRT )	'대비/등락률
			Grid0.SetCellData( "bd_val3"..i, 	0, sFIDX_52_WEEK_RSFL_RT )					'52주등락률
			Grid0.SetCellData( "bd_val4"..i, 	0, sFIDX_ACML_VOL )						'거래량
			Grid0.SetCellData( "bd_val5"..i, 	0, sFIDX_M3_AVRG_VOL )						'평균거래량(3개월)
			Grid0.SetCellData( "bd_val6"..i, 	0, sFIDX_BSTP_LRDV_NAME )					'업종
			Grid0.SetCellData( "bd_val7"..i, 	0, sFIDX_BSTP_MDDV_NAME )					'산업
			Grid0.SetCellData( "bd_val8"..i, 	0, sFIDX_AVLS )							'시가총액(백만)
			Grid0.SetCellData( "bd_val9"..i, 	0, sFID_CNCN_PER )						'PER
			Grid0.SetCellData( "bd_val10"..i, 	0, sFID_CNCN_PBR )						'PBR
			Grid0.SetCellData( "bd_val11"..i, 	0, sFID_CNCN_EPS )						'EPS
			
			'실시간/지연 표시
			sREALTIME = Form.GetSharedData("REALTIME_"..sFID_CNCN_DATE, false)
			Grid0.SetCellData( "bd_real1"..i, 0, g_tImage[sREALTIME] )

			' 상승
			if sFIDX_PRDY_VRSS_SIGN == "1" or sFIDX_PRDY_VRSS_SIGN == "2" then
				Grid0.SetCellFgColor( "bd_val1"..i, 0, "1" )
				Grid0.SetCellFgColor( "bd_val2"..i, 0, "1" )				
			' 하락	
			elseif sFIDX_PRDY_VRSS_SIGN == "4" or sFIDX_PRDY_VRSS_SIGN == "5" then
				Grid0.SetCellFgColor( "bd_val1"..i, 0, "2" )
				Grid0.SetCellFgColor( "bd_val2"..i, 0, "2" )			
			' 보합
			else
				Grid0.SetCellFgColor( "bd_val1"..i, 0, "3" )
				Grid0.SetCellFgColor( "bd_val2"..i, 0, "3" )
			end if
		next

		' 해외주식체결 자동갱신
		DATAMANAGER.RequestRealData( "ohhts_exst_ictg" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID == "ohhts_exst_ictg" then
		dim nCount, sFIDXR_ISCD, sFIDXR_PRPR, sFIDXR_VRSS_SIGN, sFIDXR_PRDY_VRSS, sFIDXR_RSFL_RT, sFIDXR_ACML_VOL
		dim tCodeInfo, tCodeMarket, sItemCode
		
		nCount = DATAMANAGER.GetDataCount( 1, szTranID , "OutBlock1" )

		for i = 0 to nCount - 1
			sFIDXR_ISCD = DATAMANAGER.GetDataValue( 1, szTranID , "OutBlock1" , "FIDXR_ISCD" , i )				'FIDXR종목코드
			sFIDXR_PRPR = DATAMANAGER.GetDataValue( 1, szTranID , "OutBlock1" , "FIDXR_PRPR" , i )				'FIDXR현재가
			sFIDXR_VRSS_SIGN = DATAMANAGER.GetDataValue( 1, szTranID , "OutBlock1" , "FIDXR_VRSS_SIGN" , i )	'FIDXR대비부호
			sFIDXR_PRDY_VRSS = DATAMANAGER.GetDataValue( 1, szTranID , "OutBlock1" , "FIDXR_PRDY_VRSS" , i )	'FIDXR전일대비
			sFIDXR_RSFL_RT = DATAMANAGER.GetDataValue( 1, szTranID , "OutBlock1" , "FIDXR_RSFL_RT" , i )		'FIDXR등락율
			sFIDXR_ACML_VOL = DATAMANAGER.GetDataValue( 1, szTranID , "OutBlock1" , "FIDXR_ACML_VOL" , i )		'FIDXR누적거래량
			
			tCodeInfo = split(g_arrCodeInfo, "★")
			
			for j = 0 to #tCodeInfo - 1
				tCodeMarket = split(tCodeInfo[j], "@")
				sItemCode = tCodeMarket[0].."@"..tCodeMarket[1]

				if sFIDXR_ISCD == sItemCode then
					'그리드 컬럼
					Grid0.SetCellData( "bd_val1"..j, 	0, sFIDXR_PRPR )											'현재가
					Grid0.SetCellData( "bd_sign2"..j, 	0, sFIDXR_VRSS_SIGN )										'전일대비부호
					Grid0.SetCellData( "bd_val2"..j, 	0, Replace(sFIDXR_PRDY_VRSS, "-", "").." / "..sFIDXR_RSFL_RT )	'대비/등락률
					Grid0.SetCellData( "bd_val4"..j, 	0, sFIDXR_ACML_VOL )										'거래량
			
					' 상승
					if sFIDXR_VRSS_SIGN == "1" or sFIDXR_VRSS_SIGN == "2" then
						Grid0.SetCellFgColor( "bd_val1"..j, 0, "1" )
						Grid0.SetCellFgColor( "bd_val2"..j, 0, "1" )				
					' 하락	
					elseif sFIDXR_VRSS_SIGN == "4" or sFIDXR_VRSS_SIGN == "5" then
						Grid0.SetCellFgColor( "bd_val1"..j, 0, "2" )
						Grid0.SetCellFgColor( "bd_val2"..j, 0, "2" )			
					' 보합
					else
						Grid0.SetCellFgColor( "bd_val1"..j, 0, "3" )
						Grid0.SetCellFgColor( "bd_val2"..j, 0, "3" )
					end if
				end if
			next
		next
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SELECT_CODE" then
		for i = 1 to 5
			Grid0.SetCellTopCaption( "th_item"..i, "" )
		next
		
		'그리드 내용 초기화
		Grid0.SetClear()
		
		'왼쪽 항목캡션 셋팅
		f_TitleCaption()
		
		'2열만 남기고 히든처리
		f_ColHidden()
			
		dim szCodeInfo
		
		szCodeInfo = Form.GetSharedData("PEERGRP_CODEINFO", false)

		if szCodeInfo ~= nil and szCodeInfo ~= "" then
			g_arrCodeInfo = szCodeInfo
			
			DATAMANAGER.RequestTranData("ohhts_6252_001r")
		end if
	end if
End Sub

