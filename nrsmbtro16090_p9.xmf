Sub RadioGroup0_OnClick(nIndex)
	if nIndex == 1 then '동의
		img1y1.imgpath = "check_on.png"
		img1n1.imgpath = "check_off.png"	
	elseif nIndex == 0 then '미동의
		img1y1.imgpath = "check_off.png"
		img1n1.imgpath = "check_on.png"
	else
