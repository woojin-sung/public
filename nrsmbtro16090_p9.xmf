'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 해외주식 실시간시세신청 개인정보동의 요약
' 02. 화면설명 : 해외주식 실시간시세신청 개인정보동의 요약
' 03. 작    성 : 2021.07.14 이명구
'-------------------------------------------------------------------------------------------
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRevData
Dim g_sAcno
Dim g_sAsno
Dim g_EmplYn
Dim g_CloseYn
g_CloseYn = "N"
Dim g_AllYn
g_AllYn = "N"

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Label0.changeTextAttr(0, 5, 265, 0, true)
	Label3.changeTextAttr(0, 2, 265, 0, true)	
	
	Dim sURL	
	g_sRevData = Form.GetOpenLinkData()	
	if g_sRevData == null or Trim(g_sRevData) == "" then
		Exit Sub
	end if
	
	Form.SetScreenName(g_sRevData)	
	totalAcno = Form.GetSharedData("ACNO", true )	'전체계좌번호
	g_sAcno = left(totalAcno, 8)
	g_sAsno = mid(totalAcno, 9, 2)
	g_EmplYn = Form.GetSharedData("EMPLYN", true ) '직원여부 : N
End Sub

'============================================================================
Sub Form_OnFormClose()
	
	'전체 동의
	If RadioGroup0.currentindex = "1" AND RadioGroup1.currentindex = "1" AND RadioGroup2.currentindex = "1" AND RadioGroup3.currentindex = "1" Then
		g_AllYn = "Y"
	else
		g_AllYn = "N"
	End If
	'전체동의 여부 Return
	Form.SendReturnToParent("ALL_YN" , g_AllYn)
End Sub
'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obtrd_acnt_901a" Then
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "AGRM_PROD_CLCD" , 0 , "06" )	'해외주식
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "ACNO" , 0 , CStr(g_sAcno) )	'계좌번호
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "ASNO" , 0 , CStr(g_sAsno) )	'계좌일련번호
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "EMPL_YN" , 0 , CStr(g_EmplYn) )'직원여부		
	end if	
End Sub
'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obtrd_acnt_901a" Then
'		Form.ShowAlert("알림", "등록되었습니다.")
		Form.SendReturnToParent("nrsmbtro16090_p9" , "OK")		
		Form.CloseForm()
	end If
End Sub
'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID = "obtrd_acnt_901a" Then
		Form.ShowAlert("알림", "["&szErrCode&"] "&szErrMsg)
	end If
End Sub
'============================================================================
' 상세보기
'============================================================================
Sub btnDetail_OnClick()
	Form.OpenPopup("nrsmbtro16090_p13" , "해외주식 개인(신용)정보 동의서" , "")	
End Sub

'============================================================================
' 처리버튼
'============================================================================
Sub btnOK_OnClick()
'Form.SendReturnToParent("nrsmbtro16090_p9" , "OK")		
'Form.CloseForm()
'

	if RadioGroup0.currentindex = "-1" then
		Form.ShowAlert("알림", "수집·이용 항목을 확인해 주세요.")
		Exit Sub
	end if
	if RadioGroup1.currentindex = "-1" then
		Form.ShowAlert("알림", "수집·이용 항목을 확인해 주세요.")
		Exit Sub
	end if
	if RadioGroup2.currentindex = "-1" then
		Form.ShowAlert("알림", "제공 항목을 확인해 주세요.")
		Exit Sub
	end if
	if RadioGroup3.currentindex = "-1" then
		Form.ShowAlert("알림", "제공 항목을 확인해 주세요.")
		Exit Sub
	end if
	
	if RadioGroup0.currentindex = "0" OR RadioGroup1.currentindex = "0" OR RadioGroup2.currentindex = "0" OR RadioGroup3.currentindex = "0" Then
		Form.ShowAlert("알림", "미동의 항목이 존재합니다.")
		Exit Sub
	end if
	
	'해외 개인신용정보동의 처리
	DATAMANAGER.RequestTranData("obtrd_acnt_901a")
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.SendReturnToParent("nrsmbtro16090_p9" , "CANCEL")
	Form.CloseForm()
End Sub

