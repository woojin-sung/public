'==============================================
' 이종통화 환전신청(베트남) 
'==============================================
Function Request_Tran_obtsd_fbnk_301a()	
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_301a")
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_301a" , "InBlock1" , "ACNO" 			, 0 , left(g_szFullAcnt,8))
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_301a" , "InBlock1" , "ASNO" 			, 0 , right(g_szFullAcnt,2))

	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_301a" , "InBlock1" , "ACNT_PWD" 		, 0 , g_szPwd)
	
	DATAMANAGER.SetDataValue(false , "obtsd_fbnk_301a" , "InBlock1" , "CONT_CLS_CODE"     , 0 , "4"  )   '온라인
	DATAMANAGER.SetDataValue(false , "obtsd_fbnk_301a" , "InBlock1" , "PROS_CLS_CODE"     , 0 , "2"  )   '신청
	
	DATAMANAGER.SetDataValue(false , "obtsd_fbnk_301a" , "InBlock1" , "ORGL_ACPT_DATE" , 0 , g_szApltDate) '원신청일자
	DATAMANAGER.SetDataValue(false , "obtsd_fbnk_301a" , "InBlock1" , "ORGL_SRNO"      , 0 , g_szApltSrno) '원신청일련번호
	
	DATAMANAGER.RequestTranData("obtsd_fbnk_301a")
End Function

