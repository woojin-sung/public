'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "PERIOD_SET" then
		'조회 날짜 선택 후
		tData = Split(sRet, "@")
		
		g_szDateType = tData(0)
		g_szStartDate = tData(1)
		g_szEndDate = tData(2)
'ShowAlert(g_szDateType, 	g_szStartDate .. " : " .. 	g_szEndDate)
		
		lblDate.caption = Mid(g_szStartDate, 3, 2) & "." & Mid(g_szStartDate, 5, 2) & "." & Right(g_szStartDate, 2) &
							 " ~ " &
						 Mid(g_szEndDate, 3, 2) & "." & Mid(g_szEndDate, 5, 2) & "." & Right(g_szEndDate, 2)
		
		if len(trim(g_szFullAcnt))	> 8 then
			f_InitValue()
			
			Request_Tran_obtsd_fbnk_320r()	
			'DATAMANAGER.RequestTranData("obtsd_fbnk_203r")
		end if
		
	elseif sKeyName = "nrsbbnk65020_p1" then
		'신청구분◆환전현황◆통화구분
		tData = Split(sRet, "`")
		
		g_szGubun = tData(0)
		g_szStatus = tData(1)
		g_szCrcd = tData(2)
		g_szCheck = tData(3)
		
		f_SetFilterName()

		if len(trim(g_szFullAcnt))	> 8 then
			f_InitValue()
			
			Request_Tran_obtsd_fbnk_320r()	
			'DATAMANAGER.RequestTranData("obtsd_fbnk_203r")
		end if
	end if
End Sub

'============================================================================
Sub f_SetFilterName()
	dim szCode, szCode2, szCode3
	
	Select Case g_szGubun
		Case "%"
			szCode = "전체"
		Case "1"
			szCode = "실시간"
		Case "2"
			szCode = "시간외"
		Case "3"
			szCode = "베트남"
		Case "4"
			szCode = "가환전·정산"
	End Select
	
	Select Case g_szStatus
		Case "%"
			szCode2 = "전체현황"
		Case "1"
			szCode2 = "신청"
		Case "2"
			szCode2 = "취소"
		Case "3"
			szCode2 = "완료"
	End Select
	
	Select Case g_szCrcd
		Case "%"
			szCode3 = "전체통화"
		Case Else
			szCode3 = g_szCrcd
'		Case "USD"
'			szCode3 = "미국"
'		Case "JPY"
'			szCode3 = "일본"
'		Case "CNY"
'			szCode3 = "중국"
'		Case "HKD"
'			szCode3 = "홍콩"
'		Case "AUD"
'			szCode3 = "호주"
'		Case "CAD"
'			szCode3 = "캐나다"			
'		Case "EUR"
'			szCode3 = "유로화"
'		Case "CHF"
'			szCode3 = "스위스"
'		Case "SGD"
'			szCode3 = "싱가포르"
'		Case "VND"
'			szCode3 = "베트남"
	End Select
	
	if g_szGubun == "%" and g_szStatus == "%" and g_szCrcd == "%" then
		lblFilter.caption = "전체"
	else
		lblFilter.caption = szCode .. "\n" .. szCode2 .. "·" .. szCode3	
	end if
End Sub

'============================================================================
Sub f_SetFilterName2()
	dim szCode
	
	Select Case g_szSort
		Case "0"
			szCode = "최근일순"
			imgFilter0.imgpath = g_ImgArrow_Down
		Case "1"
			szCode = "거래일순"
			imgFilter0.imgpath = g_ImgArrow_Down
	End Select
	
	lblFilter0.caption = szCode 
	
End Sub

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
'	if sCellID == "lblGubun" or sCellID == "lblFrAmt" or sCellID == "imgArrow"  then
'		szApltSrNo = Pannel0.GetCellValue( "lblApltSrNo", nIndex)	'신청일련번호
'		if szApltSrNo <> "" and szApltSrNo <> null then
'			Form.OpenPopup("nrsbbnk65020_p2" , szApltSrNo)	
'		end if
'	end if
	
	if sCellID == "lblFrAmt" or sCellID == "imgArrow"  then
'		szApltSrNo = Pannel0.GetCellValue( "lblPeriod", nIndex)	'신청일련번호
'		if szApltSrNo <> "" and szApltSrNo <> null then

		szLinkData = ""
		
		szExchGbn = Pannel0.getPropCardCell("caption", "lblHide0", nIndex)
		for i = 0 to 16
			szData = Pannel0.getPropCardCell("caption", "lblHide"&i, nIndex)
			
			if i = 0 then
				szLinkData = szData
			else
				if szExchGbn == "0" and (i == 11 or i == 12) then
					'skip
				else
					szLinkData = szLinkData &"`"& szData
				end if
			end if
		next
		
		Form.OpenPopup("nrsbbnk65020_p2" , szLinkData)	
			
'		for i = 0 to 16
'			szData = Pannel0.getPropCardCell("caption", "lblHide"&i, nIndex)
'			
'			if i = 0 then
'				szLinkData = szData
'			else
'				szLinkData = szLinkData &"`"& szData
'			end if
'		next
'			Form.OpenPopup("nrsbbnk65020_p4" , szLinkData)	
'		end if
	elseif sCellID == "lblVndCancel" then
		szCd = Pannel0.getPropCardCell("caption", "lblHide17", nIndex)
		
		if szCd == "0" then
			g_szApltDate = Pannel0.getPropCardCell("caption", "lblHide1", nIndex)
			g_szApltSrno = Pannel0.getPropCardCell("caption", "lblHide2", nIndex)
		
			Form.MsgBox("알림", "베트남 VND 환전 신청을\n취소하시겠습니까?", "CANCEL_ORDER", 7, "취소하기", "닫기")
		end if
	end if
End Sub

'============================================================================
Sub Pannel0_OnScrollEnd()

	if DATAMANAGER.IsMoreNextData("obtsd_fbnk_320r") ==  true then
		DATAMANAGER.RequestNextData("obtsd_fbnk_320r")
	end if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "CANCEL_ORDER" then
		if sRet == "ok" then
			Form.triggerEvent("#", "CHECK_PWD", "")
		end if
	end if
End Sub



'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	if Cint(iIndex) == 0 then
		g_szSort = "0"
	elseif Cint(iIndex) == 1 then
		g_szSort = "1"
	end if
	
	f_SetFilterName2()

	if len(trim(g_szFullAcnt))	> 8 then
		f_InitValue()
		
		Request_Tran_obtsd_fbnk_320r()	
		'DATAMANAGER.RequestTranData("obtsd_fbnk_203r")
	end if
End Sub

