'============================================================================
Sub Form_OnFormInitBefore()
	imgNoData.SetMaintainingRatio("1")
	imgFilter0.SetMaintainingRatio("1")
	
	lblFilter.paddinginfo = "0,0,0,0"
End Sub

'============================================================================
Sub Form_OnFormInit()	
	if Form.GetSharedData("&OS_TYPE", false) == "2" then
		lblFilter.autofontsize = "1" 
		lblFilter.setKeepMaxLine(true)
	end if
	
	lblFilter.maxlinecnt = "2"
	
	g_szFullAcnt = Form.GetCtlProp("#acnt01", "caption")
	
	g_szToday = Form.GetSharedData("&HOST_DATE", false)
	g_szStartDate = g_szToday
	g_szEndDate = g_szToday
	g_szDateType = 0
	
	lblDate.caption = Mid(g_szStartDate, 3, 2) & "." & Mid(g_szStartDate, 5, 2) & "." & Right(g_szStartDate, 2) &
					 " ~ " &
					 Mid(g_szEndDate, 3, 2) & "." & Mid(g_szEndDate, 5, 2) & "." & Right(g_szEndDate, 2)
	
	g_szGubun = "%"
	g_szStatus = "%"
	g_szCrcd = "%"
	g_szSort = "0"
	
	f_SetFilterName()
	f_SetFilterName2()
	
	
	if len(trim(g_szFullAcnt))	> 8 then
		f_InitValue()
		
		'Request_Tran_obtsd_fbnk_320r()	
'		DATAMANAGER.RequestTranData("obtsd_fbnk_203r")
	end if
End Sub

'============================================================================
Sub f_InitValue()
	g_nNextIdx = 0
	g_nGridIndex = 0 
	Pannel0.rowcount = 0

	imgNoData.visible = false
	lblNoData.visible = false	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "ACNTINFO_CHG"	 then
		g_szFullAcnt = Form.GetCtlProp("#acnt01", "caption") 'g_szFullAcnt= Form.GetSharedData("&ACCOUNT", 0 )
				
		if len(trim(g_szFullAcnt)) > 8 then
			f_InitValue()
			Request_Tran_obtsd_fbnk_320r()	
			'DATAMANAGER.RequestTranData("obtsd_fbnk_203r")
		end if
	elseif sEventName = "CORRECT_PWD" then
		g_szPwd = sParam
		Request_Tran_obtsd_fbnk_301a()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obtsd_fbnk_320r" then
		Process_Tran_obtsd_fbnk_320r()
	elseIf szTranID = "obtsd_fbnk_301a" then
		Process_Tran_obtsd_fbnk_301a()
    End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox("알림" , szErrMsg & "\n(" & szSubMsg & ")" , "", 0)	
End Sub

'============================================================================
Function getMnecCdColor (szOrgMnCd)
	if szOrgMnCd = "1" or szOrgMnCd = "4" then
		return g_szTxtColor_Red
	elseif szOrgMnCd = "2" or szOrgMnCd = "5" then
		return g_szTxtColor_Blue
	else
		return g_szTxtColor_Normal
	end if

End Function

'''mbonl90301_t2 파일 참조!!!!
