Sub btnDate_OnClick()
	Dim szData
	
	szData = g_szDateType		& "@" &
			g_szStartDate		& "@" &
			g_szEndDate
			
	'Form.OpenPopupAnimation("mbonl90301_p1", szData,  "",  2)
	Form.OpenPopupAnimation("nrsbbnk65020_p5", szData,  "",  2)
End Sub

'============================================================================
Sub btnFilter_OnClick()
	szSendData = g_szGubun .. "★" .. g_szStatus .."★" .. g_szCrcd .."★" .. g_szCheck
	Form.OpenPopupAnimation("nrsbbnk65020_p1", szSendData, "", "2")
End Sub

