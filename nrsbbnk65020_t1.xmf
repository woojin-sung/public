'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'==============================================
' 컬러코드
'==============================================
' 기본 텍스트 컬러 (검정색)
Dim g_szTxtColor_Normal 
g_szTxtColor_Normal 	= "334"

' 기본 텍스트 컬러 (회색)
Dim g_szTxtColor_Grey 
g_szTxtColor_Grey 	= "333"

' 기본 텍스트 컬러 (흰색)
Dim g_szTxtColor_White 
g_szTxtColor_White 	= "338"

' 빨강
Dim g_szTxtColor_Red 
g_szTxtColor_Red = "290"

' 파랑
Dim g_szTxtColor_Blue 
g_szTxtColor_Blue = "291"

' 기본 배경색상
Dim g_szContBgColor
g_szContBgColor = "320"

' 기본 구분선 색상
' 진한색
Dim g_szLineColor
g_szLineColor = "347"
' 중간색
Dim g_szLineColor2
g_szLineColor2 = "256"
' 연한색
Dim g_szLineColor3
g_szLineColor3 = "320"

' 빨강
Dim g_szBadgeBgColor_Red
g_szBadgeBgColor_Red = "339"

' 파랑
Dim g_szBadgeBgColor_Blue
g_szBadgeBgColor_Blue = "340"

Dim g_ImgArrow_Down
g_ImgArrow_Down = "icon_arrow_d"

Dim g_ImgArrow_Up
g_ImgArrow_Up = "icon_arrow_u"

dim	g_szFullAcnt	'계좌번호 (8+2)

Dim g_nNextIdx
Dim g_nGridIndex

Dim g_szDateType
Dim g_szStartDate
Dim g_szEndDate

Dim g_szGubun
Dim g_szStatus
Dim g_szCrcd
Dim g_szCheck
g_szCheck = "Y"

Dim g_szSort
g_szSort = "0"

'환전구분(로컬용) -> 상세내역 테이블 구성이 다름
'0:실시간(일반/이종통화/협의), 시간외, 가환전 / 1:시간외정상, 정산환전 / 2:베트남
Dim g_szExchGbn
g_szExchGbn = ""

Dim g_szApltDate
g_szApltDate = ""

Dim g_szApltSrno
g_szApltSrno = ""

Dim g_szPwd
g_szPwd = ""

'==============================================
' 환전신청
'==============================================
Function Request_Tran_obtsd_fbnk_320r()	
	Pannel0.rowcount = 0
	
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_320r")
	
	'계좌번호
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_320r" , "InBlock1" , "ACNO" 			, 0 , left(g_szFullAcnt,8))
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_320r" , "InBlock1" , "ASNO" 			, 0 , right(g_szFullAcnt,2))
	
	'기간(From ~ To)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_320r", "InBlock1", "STA_DATE"		, 0 , g_szStartDate)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_320r", "InBlock1", "FIN_DATE" 		, 0 , g_szEndDate)
	
	'신청구분코드
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_320r", "InBlock1", "APLT_CLS_CODE"	, 0 , g_szGubun)
	
	'환전구분코드
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_320r", "InBlock1", "PROS_CLS_CODE"	, 0 , g_szStatus)
	
	'가환전포함여부(Y/N)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_320r", "InBlock1", "UI_IQRY_CLS"		, 0 , g_szCheck)
	
	'통화코드
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_320r", "InBlock1", "CRCD"			, 0 , g_szCrcd)
	
	'정렬구분
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_320r", "InBlock1", "SORT_CLCD"		, 0 , g_szSort)
	
	DATAMANAGER.RequestTranData("obtsd_fbnk_320r")
End Function

'==============================================
' 환전신청 처리
'==============================================
Function Process_Tran_obtsd_fbnk_320r()
	nCnt	= CDBL(DATAMANAGER.GetDataCount(0, "obtsd_fbnk_320r" , "OutBlock1"))

	If nCnt = 0 and Pannel0.rowcount = "0" then
		imgNoData.visible = true
		lblNoData.visible = true
		
		Exit Function
	Else
		imgNoData.visible = false
		lblNoData.visible = false
	End if


	For i = 0 To nCnt - 1
		'거래일자
		szData0       = DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "TR_DATE", i)	
		'일련번호
		szData1		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "SRNO", i)
		'요청업무코드
		szData2		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "RQST_BSWR_CLS_CODE", i)
		'계좌번호
		szData3		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "ACNO", i)
		'계좌일련번호
		szData4		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "ASNO", i)
		'환전구분코드
		szData5		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "MNEC_CLCD", i)
		'적용환율
		szData6		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "APLY_EXRT", i)
'		'통화코드
		szData7		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "CRCD", i)
		'외화거래금액
		szData8		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "FRCR_TR_AMT", i)
		'거래금액
		szData9		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "TR_AMT", i)
		'채널유형코드
		szData10		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "CHAN_TYPE_CLS_CODE", i)
		'신청지점코드
		szData11		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "APLT_BRCD", i)
		'신청기간
		szData12		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "APLT_HOUR", i)
		'신청직원번호
		szData13		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "APLT_EMPNO", i)
		'외부응답코드
		szData14		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "OUTS_RSPN_CODE", i)
		'환전손익금액
		szData15		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "MNEC_PRLS_AMT", i)
		'출금거래일련번호
		szData16		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "DRNG_TR_SRNO", i)
		
		'-----------------------------
		'베트남환전 전용필드 START
		'-----------------------------
		'매도통화코드
		szData17		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "SELN_CRCD", i)
		'외화매도신청금액
		szData18		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "FRCR_SELN_APLT_AMT", i)
		'매수통화코드
		szData19		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "BYOV_CRCD", i)
		'취소여부
		szData20		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "CNCL_YN", i)
		'취소직원번호
		szData21		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "CNCL_EMPNO", i)
		'취소일자
		szData22		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "CNCL_DATE", i)
		'취소시각
		szData23		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "CNCL_TIME", i)
		'신청응답코드
		szData24		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "APLT_RSPN_CODE", i)
		'환전예정일자
		szData25		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "MNEC_SCDL_DATE", i)
		'환율적용일자
		szData26		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "EXRT_APLY_DATE", i)
		'처리일자
		szData27		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "PROS_DATE", i)
		'처리상태구분코드
		szData28		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "PROS_STAT_CLS_CODE", i)
		'외화매수금액
		szData29		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "FRCR_BYOV_AMT", i)
		'외화매도금액
		szData30		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "FRCR_SELN_AMT", i)
		'-----------------------------
		'베트남환전 전용필드 END
		'-----------------------------
		
		'조작일시
		szData31		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "MNPL_YMDH", i)
		'조작단말번호
		szData32		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "MNPL_TRNO", i)
		'조작직원번호
		szData33		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "MNPL_EMPNO", i)
		'응답내용
		szData34		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "RSPN_CNTT", i)
		'우대적용구분
		szData35		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "PRFT_APLY_CLS_VAL", i)
		'우대적용구분코드
		szData36		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "PRFT_APLY_CLCD", i)
		
		'-----------------------------
		'시간외환전 전용필드 START
		'-----------------------------
		'정산차액
		szData37		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "EXCL_DRAM", i)
		'-----------------------------
		'시간외환전 전용필드 END
		'-----------------------------
		
		'UI항목명1(환전구분)
		szData38		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "UI_ITEM_NAME1", i)
		
		'-----------------------------
		'베트남환전 전용필드 START
		'-----------------------------
		'UI항목명1(베트남환전진행상태)
		szData39		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "UI_ITEM_NAME2", i)
		'-----------------------------
		'베트남환전 전용필드 END
		'-----------------------------
		
		szData40		= DATAMANAGER.GetDataValue(0, "obtsd_fbnk_320r", "OutBlock1", "UI_ITEM_NAME3", i)
		
		nIdx = Pannel0.AddRow()
		
		Pannel0.setPropCardCell("maintainratio", "imgArrow", nIdx, "2")
		Pannel0.setPropCardCell("imgpath", "imgArrow", nIdx, "icon_arrow")
		
		'-----------------------------
		'처리업무구분 (로컬용)
		'-----------------------------
		g_szExchGbn = ""
		'베트남
		if szData2 == "ZZZZ" then
			g_szExchGbn = "2"
		'시간외정산 / 정산환전(전체)
		elseif szData2 == "3006" or szData2 == "3102" or szData2 == "3113" or szData2 == "3121" or szData2 == "3122" then
			g_szExchGbn = "1" 
		'실시간(일반/이종통화/협의) / 시간외 / 가환전
		else
			g_szExchGbn = "0"
		end if
		
		szChannel = Form.GetMetaData("채널유형구분코드", szData10)
		
		Pannel0.setPropCardCell("imagefilepth", "lblApltSrNo", nIdx, "alpha")
		'-----------------------------
		'판넬 데이터 세팅
		'-----------------------------
		if g_szExchGbn <> "2" then
			'-----------------------------
			'환전구분(외화매수/외화매도)
			'-----------------------------
			szOrdGbn = ""
			if szData5 = "1" or szData5 = "4" then
				szOrdGbn = "외화매수"
			elseif szData5 = "2" or szData5 = "5" then
				szOrdGbn = "외화매도"
			else
				szOrdGbn = "-"
			end if
			
			szOrdGbn_Total = szOrdGbn & " | " & szData38
			
			szAplyExrt = ""
			szFrcrAmt = ""
			szWonAmt = ""
		
			'-----------------------------
			'적용환율
			'-----------------------------
			if szData2 == "3005" then
				szAplyExrt = "예상환율  " & FormatNumber(szData6, 2)
			else
				szAplyExrt = "환율  " & FormatNumber(szData6, 2)
			end if
			
			'-----------------------------
			'외화거래금액
			'-----------------------------
			
			if szData7 == "JPY" then
				szFrcrAmt = FormatNumber(szData8, 0) .. " " .. szData7
			else
				szFrcrAmt = FormatNumber(szData8, 2) .. " " .. szData7
			end if
			
			'-----------------------------
			'원화거래금액
			'-----------------------------
			szWonAmt = FormatNumber(szData9, 0) .. " " .. "KRW"
		
			'신청일자
