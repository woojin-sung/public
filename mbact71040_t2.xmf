	<SCRIPT_INFO _len="11128" _ulen="10246" >
'============================================================================
' 01. 화 면 명 : 거래내역_입출금
' 02. 화면설명 : 거래내역_입출금
' 03. 작    성 : 2016. 02. 03. 유창재
'                2019. 01. 30. 장원혁 v0001  해외파생 관련 입출금 시 외화 수수료 표기
'                2019. 06. 12. 장원혁 v0002  연속조회 시 추가 조회된 Row에 대해 '잔액' 항목 미표기 오류 정정
'                2019. 10. 08. 장원혁 v0003  브라질채권 관련 거래 발생 시 수수료 항목 표기 수정
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szList		'거래내역 화면에서 받아온 내용 저장 리스트
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam) : 트리거를 받아서 입력값 연결
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "입출금" then
	
	g_szList = Split(sParam,"★")
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
'	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "ACNO" , 0 , g_szList(0))
'	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "ASNO" , 0 , g_szList(1))
'	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "FRST_TR_DATE" , 0 , g_szList(2))
'	DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "LAST_TR_DATE" , 0 , g_szList(3))
	
	end if
	
	g_nNextCount = 0
	DATAMANAGER.RequestTranData( "obrtp_tran_001r" )
End Sub
'============================================================================
' grd0_OnScrollEnd() : 스크롤 내릴때 추가 데이터 연결
'============================================================================
Sub grd0_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obrtp_tran_001r" )
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 거래구분을 거래코드에 값에 따라 입금,출금 출력
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim nType		'거래구분에 사용되는 변수
	Dim TRType		'상세팝업에 쓰일 거래구분 저장 변수
	Dim AccountName		'상대계좌명
	Dim BankCode			'은행코드
	Dim AccountList		
	
	if szTranID == "obrtp_tran_001r" then
		for i = 0 to (DATAMANAGER.GetDataCount( 0 , "obrtp_tran_001r", "OutBlock1" ) - 1)
			g_nNextCount = g_nNextCount + 1
		
'			BankCode = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "BANK_CODE" , i)
'			AccountName = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "CNFT_ACNM" , i)
'			if AccountName == "" then
'				AccountName = "/"
'			end if
'			AccountList = Split(AccountName,"/")
''			if UBOUND(AccountList) < 1 then
''				Exit Sub
''			End if
'			
'			if BankCode == "" then	'은행코드가 없을때 - 메리츠 계좌일때	거래상대이름만 자름
'				grd0.SetCellData( "bd_cell6", g_nNextCount - 1, AccountList(1) )'Right(Trim(AccountName), 8))
'			else
'				Dim sztrash		'TR에 붙어서 내려오는 쓰레기값 제거
'				sztrash = Split(AccountList(2),"　")		'뒤에 특수문자 공백이 들어간 부분 제거
'				
'				grd0.SetCellData( "bd_cell6", g_nNextCount - 1, sztrash(0) )'Right(Trim(AccountName), 9))
'			end if
		
			nType = Right(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "SMCD" , i), 2)
			szIoClsCode = Right(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "IO_CLS_CODE" , i), 1)
			szCnclYn = Right(DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "CNCL_YN" , i), 1)
			
			TRType = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "TR_TYPE_CODE" , i)
			'TR데이터가 부족한 관계로 추후 수정이 필요할수 있는 부분 -> 데이터 충돌이나 없는 부분이 생기면
			'TRType을 가지고 똑같이 거래구분으로 사용 할것.
			FrcrTrAmt = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "FRCR_TR_AMT" , i)
			szSMCD = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "SMCD" , i)
'tbl0.SetCellMaskInfo(4, 1, "0,0,,,1,,2,1,0")			
			
			szTrName = ""
			if szIoClsCode = "1" then
				szTrName = "입금"
			elseif szIoClsCode = "2" then
				szTrName = "출금"
			end if
			
			if szCnclYn = "Y" then
				szTrName = szTrName &"취소"
			end if
			
			grd0.SetCellData( "bd_cell1", g_nNextCount - 1 , szTrName )
			
'v0001 start ------------------------------------------------------------------------------------

			Dim ovscDealFee

			if MID(szSMCD,1,3) = "263" or MID(szSMCD,1,3) = "273" or szSMCD = "117120" or szSMCD = "117129" or szSMCD = "117130" or szSMCD = "117139" or szSMCD = "117140" or szSMCD = "117149" or szSMCD = "117150" or szSMCD = "117159" or szSMCD = "117160" or szSMCD = "117169" or szSMCD = "117170" or szSMCD = "117179" Then
			   'v0003 적요코드 117120 ~ 117179 추가
			   
			   grd0.SetCellData( "bd_cell3", g_nNextCount - 1 , DATAMANAGER.GetDataValue(0 , "obrtp_tran_001r", "OutBlock1", "OVSC_DEAL_FEE", i) )
                
			end if

'v0001 end   ------------------------------------------------------------------------------------
			
			Select Case TRType
				Case "01" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출금")
				Case "02" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출금")
				Case "03" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case "04" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case "05" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "06" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "07" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "08" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "09" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "10" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "11" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case "12" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case "13" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "14" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "매매")
				Case "15" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출금")
				Case "16" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case "17" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case "18" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case "19" grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출고")
				Case Else grd1.SetCellData( "bd_cell3" , g_nNextCount - 1, "입출금")
			End Select
			
			Dim tmpStr 
			Dim numStr
			
			
			if CDbl(FrcrTrAmt) <> 0 AND szSMCD <> "001100" AND szSMCD <> "001200" Then
				tmpStr = DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "FRCR_TFAM_NWRM" , i)
'				grd0.SetCellData("bd_cell7", i, DATAMANAGER.GetDataValue( 0 , "obrtp_tran_001r", "OutBlock1", "FRCR_TFAM_NWRM" , i))				
				numStr = FormatNumber(CDbl(tmpStr), 2)
			else
				'tmpStr = grd0.SetCellData( "bd_cell7" , g_nNextCount - 1, DATAMANAGER.GetDataValue(0 , "obrtp_tran_001r", "OutBlock1", "PRNC_BAL", i) + DATAMANAGER.GetDataValue(0 , "obrtp_tran_001r", "OutBlock1", "TFAM_NWRM", i))
				tmpStr = DATAMANAGER.GetDataValue(0 , "obrtp_tran_001r", "OutBlock1", "PRNC_BAL", i) + DATAMANAGER.GetDataValue(0 , "obrtp_tran_001r", "OutBlock1", "TFAM_NWRM", i)
				numStr = FormatNumber(CDbl(tmpStr), 0)
				'Form.ShowAlert("", numStr)
			end if
'			grd0.SetCellData("bd_cell7", i, numStr)	v0002 주석처리
			grd0.SetCellData("bd_cell7", g_nNextCount - 1, numStr) 'v0002
		next
		
	end if
	
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID) : 행 선택시 상세팝업에 쓰일 입력값 전달
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szData
	
	'상세팝업에 필요한 데이터 전부 보냄								
'	szData = grd1.GetCellData( "bd_cell0", lRow ) & "●" & g_szList(0) & g_szList(1) & "●" & grd1.GetCellData( "bd_cell2", lRow ) & "●" & 
'	grd1.GetCellData( "bd_cell3", lRow ) & "●" & grd1.GetCellData( "bd_cell4", lRow ) & "●" & grd1.GetCellData( "bd_cell5", lRow ) & "●" & grd1.GetCellData( "bd_cell6", lRow ) & "●" & 
'	grd1.GetCellData( "bd_cell7", lRow ) & "●" & grd1.GetCellData( "bd_cell8", lRow ) & "●" & grd1.GetCellData( "bd_cell9", lRow ) & "●" & grd1.GetCellData( "bd_cell10", lRow ) & "●" & 
'	grd1.GetCellData( "bd_cell11", lRow ) & "●" & grd1.GetCellData( "bd_cell12", lRow ) & "●" & grd1.GetCellData( "bd_cell13", lRow ) & "●" &
'	grd1.GetCellData( "bd_cell14", lRow ) & "●" & grd1.GetCellData( "bd_cell15", lRow ) & "●" & grd1.GetCellData( "bd_cell16", lRow ) & "●" &
'	g_szList(1)

	szData = g_szList(0) & "●" & g_szList(1) & "●" & grd1.GetCellData( "bd_cell0", lRow ) & "●" & grd1.GetCellData( "bd_cell1", lRow ) 
	
	Form.OpenFramePopup( "mbact71040_p1" , szData , sPosInfo)
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obrtp_tran_001r" then
		DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "ACNO" , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "ASNO" , 0 , g_szList(1))
		DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "FRST_TR_DATE" , 0 , g_szList(2))
		DATAMANAGER.SetDataValue( 0 , "obrtp_tran_001r", "InBlock1", "LAST_TR_DATE" , 0 , g_szList(3))	
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	
	g_nNextCount = 0 'v0001
	DATAMANAGER.RequestTranData( "obrtp_tran_001r" )
	
End Sub

