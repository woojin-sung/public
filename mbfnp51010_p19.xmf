	<SCRIPT_INFO _len="3242" _ulen="2944" >
dim	g_szRet	'리턴값

dim	g_szAcNo		'계좌번호
dim	g_szAsNo		'계좌일련번호
dim	g_szSrno		'잔고번호
dim	g_szIsCd		'종목코드

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	
	'숙려주문시 테이블 별도로 처리
	tblInfoCafu.visible = false
	
	if szOpenData <> "" and szOpenData <> null then
		dim tData, szProdCd, szProdText
		tData = Split(szOpenData, "★")
		
		dim szSaveTypeNm
		szSaveTypeNm = ""
	
		szProdCd = Form.GetAccountInfo(tData(0), "productcode")
		szProdText = Form.GetMetaData("상품코드", szProdCd)
		
		
		'종목명 긴 경우, 멀티라인 2줄까지만 출력되도록..
		if Len(tData(1)) > 40 then
			lblFndName.fontsize = -2
		else
			lblFndName.fontsize = 0
		end if
		
		if tData(3) == "3" then
			szSaveTypeNm = "자유적립식"
		elseif tData(3) == "4" then
			szSaveTypeNm = "거치식(분리과세신청)"
		else
			szSaveTypeNm = "임의식"
		end if
		
		g_szCafuYn	= tData(10)	'숙려여부
		if g_szCafuYn = "Y" then
			tblInfoCafu.visible = true
			
			tblInfoCafu.SetCellString(2, 1, tData(7)) '선취수수료
		else
			tblInfoCafu.visible = false
				
			tblInfo.SetCellString( 5, 1, tData(5)) '기준가적용일
			tblInfo.SetCellString( 6, 1, tData(6)) '결제예정일
			tblInfo.SetCellString( 7, 1, tData(7)) '선취수수료		
		end if
		
		lblFndName.caption 		= tData(1)	'상품명
		tblInfo.SetCellString( 1, 1, "["&szProdText&"] "&Left(tData(0),4)&"-"&Mid(tData(0),5,4)&"-"&Right(tData(0),2)) 	'신청계좌
		tblInfo.SetCellString( 2, 1, tData(2)) '잔고번호
		tblInfo.SetCellString( 3, 1, szSaveTypeNm) '투자방식
		tblInfo.SetCellString( 4, 1, tData(4)) '매수금액
		
		
		g_szAcNo	= Left(tData(0),8)
		g_szAsNo	= Right(tData(0),2)
		g_szSrno	= tData(2)
		
		g_szIsCd	= tData(8)	'종목코드
		g_szPwd	= tData(9)	'계좌비밀번호
		
	end if
	
End Sub

'============================================================================
Sub btnList_OnClick()	
	'주문내역
'	Form.OpenPopup( "mbfnp51030" , "" , "")
	Form.OpenScreen("51030" , "")
	Form.CloseForm()
	Exit Sub
End Sub

'============================================================================
Sub btnOk_OnClick()
	Dim szSendData
	szSendData = g_szAcNo & "★" & g_szAsNo & "★" & g_szPwd & "★" & g_szSrno & "★" & g_szIsCd & "★" & lblFndName.caption

	'자동이체서비스신청 팝업
	Form.openPopupAnimation("mbfnp51010_p21", szSendData, "", "2")
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbfnp51010_p19" ,  "close")
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "mbfnp51010_p21" then
		if sRet == "close" then
			Form.CloseForm()
		end if
	end if
End Sub

	</SCRIPT_INFO>
