<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="99999" scrname="공지팝업_신용공여" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<CONTAINER name="Container0" vscroll="1" scroll_pos="0,0" ly_vert="0,0,375,594,1" scroll_ly_vert="0,0" >
			<CONTROL_INFO>
				<IMAGE name="Image0" autosize="1" ly_vert="0,0,375,1060,1" />
				<IMAGE name="Image5" imgpath="icon_main_11" ly_vert="342,2,30,28,1" />
			</CONTROL_INFO>
		</CONTAINER>
		<BUTTON name="Button2" caption="닫기" fgcolor="004:000000000" fontsize="-2" ly_vert="293,610,77,25,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="671" _ulen="635" >
Dim g_szData
'============================================================================
Sub Button2_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_Image5_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_szData = Form.GetOpenLinkData()
	
	'신용공여 + 이자율 인상 대상
	if g_szData == "001" then
		Container0.Image0.imgpath = "notice_p10.png"
	'이자율 인상 대상
	elseif g_szData == "002" then
		Container0.Image0.imgpath = "mobile_pop_efif.png"
	end if
End Sub

	</SCRIPT_INFO>
</ROOT>