Sub Form_OnFormInit()
'	cont0.imgBg.imgpath = "home_banner01.png"
	cont0.imgBg.imgpath = "img_bground_360_361_10"
	
	Dim nHostDate, nHostTime
	nHostDate = Form.GetSharedData( "&HOST_DATE", false )	'오늘날짜
	nHostTime = CDBL(LEFT(Form.GetSharedData( "&HOST_TIME", false ),4))	'오늘시간(시분)
	
	'영업시간 내
	cont0.visible = True
	cont1.visible = False
	
