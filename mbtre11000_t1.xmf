'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_szACNO, g_szASNO, g_szData, g_szOrderData
Dim g_bFalg, g_szFold

Dim g_index

Dim g_RghtFlag
Dim g_Toggle1
Dim g_Toggle2
Dim g_Buffer
Dim g_switch
Dim g_VltnFlag '0 계좌평가금액 1 잔고평가금액

g_bFalg = True
g_szFold = "0" 

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
Function Account_Check()
	Dim szACNO, szASNO
	
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
	
	If szACNO = "" OR szASNO = "" Then
		Form.ShowAlert("알림", "계좌정보가 없습니다.")
		Return False
	End If

	Return true
End Function

'============================================================================
Function SetGridData()
'	Dim i, nRate, szData, szReturnValue
'	Dim nVLTN_PRLS_AMT	' 평가손익
'	Dim nBYNG_AMT			' 매입금액	
'	Dim nEXPN_AMT			' 비용금액
'	Dim nTOT_VLTN_PRLS_AMT	' 평가손익합계
'	Dim nTOT_BYNG_AMT		' 매입금액합계
'	
'	nVLTN_PRLS_AMT 	 = 0
'	nBYNG_AMT 		 = 0
'	nTOT_VLTN_PRLS_AMT = 0
'	nTOT_BYNG_AMT		 = 0
	g_Toggle1 = 0
	g_Toggle2 = 0
'
	SetGridHeader(g_Toggle1, g_Toggle2)
'	
'	For i = 0 To grd0.rowcount -1
'		nVLTN_PRLS_AMT	= CDbl( grd0.GetCellData( "bd_cell5", i ) )
'	
'		nBYNG_AMT 	  	= CDbl( grd0.GetCellData( "bd_cell8", i ) )
'		nPSNT_PRC		= grd0.GetCellData( "bd_cell4", i )
'		
'		nTOT_VLTN_PRLS_AMT= nTOT_VLTN_PRLS_AMT + nVLTN_PRLS_AMT
'		nTOT_BYNG_AMT		= nTOT_BYNG_AMT + nBYNG_AMT
'	Next	
'	
'	'20210628 마지막 종목의 매입금액이 0인 경우 수익률이 0으로 나오는 경우가 있어서 총매입금액으로 변경
''	if nBYNG_AMT == 0 then
'	if nTOT_BYNG_AMT == 0 then
'		nRate = 0
'	else
'		nRate = Round((nTOT_VLTN_PRLS_AMT / nTOT_BYNG_AMT) * 100, 2)	
'	end if
'	
'	tbl0.SetCellString( 2, 2, nTOT_VLTN_PRLS_AMT	)	'미실현손익
'	tbl0.SetCellString( 2, 1, nRate   			)	'손익률


	For i = 0 To grd0.rowcount -1
		'매매구분
		szData = grd0.GetCellData( "bd_TypeCd", i)
		
		If szData = "1" Then
			grd0.SetCellFgColor("bd_Type", i, "11")
		Else
			grd0.SetCellFgColor("bd_Type", i, "10")
		End If
		
		'v0001 STA CFD 장부금액 > 매입금액원화계산
		Dim nCFDamt, nCalAmt, nExRate
		nExRate = tonumber(grd0.GetCellData( "bd_ExtRate", i)) '매매기준환율
		nCFDamt = tonumber(grd0.GetCellData( "bd_cell9", i)) 'CFD장부금액
		nKCalAmt = nExRate * nCFDamt
		
		grd0.SetCellData( "bd_cell12", i, nKCalAmt) '매입금액(￦)
		'v0001 FIN
	Next
End Function

'============================================================================
Function RequestData()
	grd0.rowcount = 0
	
	DATAMANAGER.RequestTranData( "obtre_oder_002r" )'잔고조회
	
End Function

'============================================================================
'Transform_Exid2 : 거래소 심볼 변환
'============================================================================
Function Transform_Exid2(sValue)
	if sValue = "HK" then
		return "HKS"
	elseif sValue = "SH" then
		return "SHS"
	elseif sValue = "SZ" then
		return "SZS"
	elseif sValue = "NY" then
		return "NYS"
	elseif sValue = "AX" then
		return "AMX"
	elseif sValue = "OQ" then
		return "NAS"
	elseif sValue = "JP" then
		return "TSE"
	else
		return ""
	end if
End Function

'============================================================================
'f_SetExMask : 환율 라벨 소수점 자리수 SET
'============================================================================
Function f_SetGrdMask()
	Dim szType
	szType = Trim(Form.GetCtlProp("#lblAcntNation", "caption"))
	
	lblExRate.caption = ""
	
	if szType == "392" then '일본은 소수점 4자리 표시
		lblExRate.mask = "0,0,기준환율 : ,,0,,4,1,0,0,0"
	else
		lblExRate.mask = "0,0,기준환율 : ,,0,,2,1,0,0,0"
	end if
	
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim szChkVal1, szChkVal2, szFold
	
	szChkVal1 = Form.LoadConfigData( "mbtre11000", "balance1"	)		'신용합산
	szFold	 = Form.LoadConfigData( "mbtre11000", "fold"		)		'펼침버튼
	szChkVal2 = Form.LoadConfigData( "mbtre11000", "balance2"	)		'20220512 KSJ 원화/외화
	
	If szChkVal1 <> "" Then
		rdo0.currentindex = CInt(szChkVal1)
	End If
	
	If szChkVal2 <> "" Then
		rdo1.currentindex = CInt(szChkVal2)
	End If
	
	
	g_VltnFlag = "0"
	
	If szFold <> "" Then
		If szFold = "1" Then
			g_szFold = "0"
		Else
			g_szFold = "1"
		End If
	End If
	
	btnFold_OnClick()
	btnSearch_OnClick()
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szData
	
	szData = rdo0.currentindex
	
	If sEventName = "CHANGE_ORIENTATION" Then
		Form.OpenPopup( "mbtrs15000_h0" , szData , "" )
		Return False
	ElseIf sEventName = "RECEIVE" Then
		btnSearch_OnClick()
		f_SetGrdMask()
	ElseIf sEventName = "CHANGE_ACCTNO" Then
		btnSearch_OnClick()
		f_SetGrdMask()
	End If

End Sub

'============================================================================
Sub rdo0_OnClick(nIndex)
	RequestData()
End Sub

'============================================================================
Sub btnSearch_OnClick()
	g_switch  = 0
	g_Buffer  = 0
	
	RequestData()
End Sub

'============================================================================
Sub btnRate_OnClick()
	Dim szData

	If tbl0.GetCellString(3, 0) = "" Or tbl0.GetCellString(3, 0) = "0" Or tbl0.GetCellString(3, 0) = 0 Then
		Form.ShowAlert("알림", "조회를 먼저 하셔야 합니다.")
		Exit Sub
	End If

	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
	
	szData = szACNO & "|" & szASNO & "|" & CDbl( tbl0.GetCellString(1, 2) )

	Form.OpenFramePopup( "mbtrs15000_p1" , szData , "")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNO, szASNO
	
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
	
	Dim IQRY_CLS_CODE
		
	If rdo0.currentindex = "0" or rdo0.currentindex = 0 then
		IQRY_CLS_CODE = "1" '개별잔고 기준
	Else
		IQRY_CLS_CODE = "2" '이평잔고 기준
	End If
		
	If szTranID = "obtre_oder_002r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0 , szACNO 		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO", 0 , szASNO 		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "STND_DATE", 0 , Form.GetSharedData( "&HOST_DATE", False) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE", 0 , IQRY_CLS_CODE )
	
	ElseIf szTranID = "obtre_oder_003r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0 , szACNO 		)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO", 0 , szASNO 		)

	ElseIf szTranID = "obtre_rmnd_001r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO", 0 , szASNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "STND_DATE", 0 , Form.GetSharedData( "&HOST_DATE", False) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_CLS_CODE", 0 , "1" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "UI_IQRY_CLS", 0 , "1" )
		
	ElseIf szTranID = "ooase_seex_084r" Then
		DATAMANAGER.SetDataValue( 0, "ooase_seex_084r", "InBlock1", "ACNO" 			, 0 , szACNO 		)
		DATAMANAGER.SetDataValue( 0, "ooase_seex_084r", "InBlock1", "ASNO" 			, 0 , szASNO 		)
		DATAMANAGER.SetDataValue( 0, "ooase_seex_084r", "InBlock1", "UI_VLTN_AMT" 	, 0 , tbl0.GetCellString( 1, 2 ))
		
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obtre_oder_002r" Then
		DATAMANAGER.RequestTranData( "obtre_oder_003r" )'예수금 조회
		DATAMANAGER.RequestTranData( "obtre_rmnd_001r" )'총수익률 조회
		
		SetGridData()
		
		g_switch  = 1
		
	elseIf szTranID = "ooase_seex_084r" Then
'		temp = DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN", 0 )
'		Form.ShowAlert(szTranID, temp)
		'당일
		tbl0.SetCellString( 3, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_PRLS_AMT", 0 ) )
		
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN", 0 ) = "Y" THEN 
			tbl0.SetCellMaskInfo( 3, 1, "1,0,,,0,,0,1,1,0,0" )
			tbl0.SetCellString( 3, 1, "-" )
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN", 0 ) = "A" THEN 
			tbl0.SetCellMaskInfo( 3, 1, "1,0,,,0,,0,1,1,0,0" )
			tbl0.SetCellString( 3, 1, "N/A" )
		ELSE 
			tbl0.SetCellMaskInfo( 3, 1, "0,0,,%,0,,2,1,1,0,0" )
			tbl0.SetCellString( 3, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "PLRT", 0 ) )
		End If
	
		'누적
		tbl0.SetCellString( 4, 2, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_PRLS_AMT5" 		, 0 ) )
		
		If DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN4", 0 ) = "Y" THEN 
			tbl0.SetCellMaskInfo( 4, 1, "1,0,,,0,,0,1,1,0,0" )
			tbl0.SetCellString( 4, 1, "-" )
		ElseIf DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "UI_ABLE_YN4", 0 ) = "A" THEN 
			tbl0.SetCellMaskInfo( 4, 1, "1,0,,,0,,0,1,1,0,0" )
			tbl0.SetCellString( 4, 1, "N/A" )
		ELSE 
			tbl0.SetCellMaskInfo( 4, 1, "0,0,,%,0,,2,1,1,0,0" )
			tbl0.SetCellString( 4, 1, DATAMANAGER.GetDataValue( 0, "ooase_seex_084r", "OutBlock1", "M6_PLRT", 0 ) )
		End If	
		
	ElseIf szTranID = "obtre_oder_003r" Then
		g_bFalg = False
		
		MKSC_VLTN_AMT	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "RMND_VLTN_AMT" , 0)
		VLTN_AMT		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ACNT_VLTN_AMT"	, 0)
		
		if g_VltnFlag == "0" then
			tbl0.SetCellString(1, 1, VLTN_AMT)
			tbl1.SetCellString(0, 2, MKSC_VLTN_AMT)
		else
			tbl0.SetCellString(1, 1, MKSC_VLTN_AMT)
			tbl1.SetCellString(0, 2, VLTN_AMT)
		end if
		
		DATAMANAGER.RequestTranData( "ooase_seex_084r" )	
		
	End If
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "MOVEPOP_RETURN"	then
		Dim szListItems
		szListItems	=	split(sRet,"★")
		
		if szListItems(1) = "0" then '현재가
			Form.OpenScreen("16100" , g_szData )
			
		elseif szListItems(1) = "1"	 then '차트
			Form.OpenScreen("16100" , g_szData & "♥" & "2" )
			
		elseif szListItems(1) = "2" then '청산
			Form.OpenScreen("16200" , "잔고" & "★" & "2" & "★" & g_szOrderData )
			
		end if
		
		g_szData = ""
		g_szOrderData = ""
		
	end if 
	
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szItemInfo, szItemCode, szExSym, szTranExch
	Dim szItemName, szFullCode, szQty, sMasudoType
	Dim listLocation, nYPos, height
	
	szItemInfo = ""
	szItemInfo = grd0.GetCellData("bd_cell10", lRow)
	
	tItemInfo 	= split(szItemInfo, ".")
	szItemCode	= tItemInfo(0)
	szExSym		= tItemInfo(1)
	
	'20220527 SWJ START : 종목코드에 "."이 들어간 경우 파싱 오류 수정(EX.버크셔해서웨이)
	if instr(szItemInfo,".") <> instrRev(szItemInfo,".") then
			
		sztempExid = Right(szItemInfo,len(szItemInfo) - instrRev(szItemInfo,"."))			
		sztempCode = Replace(szItemInfo,"." & sztempExid,"")
			
		szItemCode = sztempCode
		szExSym = sztempExid
	end if
	'20220527 SWJ END 
	
	szTranExch	= Transform_Exid2(szExSym)
	
	' 온라인 거래소가 아닌경우
	if szTranExch == "" or szTranExch == null Then
		Form.ShowAlert("알림", "선택상품은 MTS에서 거래되지 않는 상품입니다.")
		Exit Sub
	end if
	
	szFullCode	= szExSym &"@"& szItemCode
'	szItemName	= grd0.GetCellData("bd_cell0" , lRow)
	szItemName	= Form.GetItemCodeInfo(szFullCode, "name")
	szQty      	= grd0.GetCellData("bd_cell3" , lRow)
	sMasudoType	= grd0.GetCellData("bd_TypeCd" , lRow)
	
	listLocation	=  Split(grd0.location,":")
	nYPos  = Int(listLocation[1])
	height = listLocation[3]
	
	sPopupType = "2"
'	Form.ShowAlert(szFullCode, szItemName)
	g_szData = szFullCode & "★" & szItemName
	g_szOrderData = szFullCode & "★" & szQty & "♥" & sMasudoType & "♥" & "" & "♥" & "" & "♥" & ""
	
	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  ""  & "★" & "현재가" & "★" & "차트" & "★" & "청산" & "★" & "" & "★" & "")
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SaveConfigData("mbtre11000", "balance1"	, rdo0.currentindex )	'신용합산
	Form.SaveConfigData("mbtre11000", "fold"		, g_szFold		) 	'펼침버튼
	Form.SaveConfigData("mbtre11000", "balance2"	, rdo1.currentindex ) 	'20220512 KSJ 원화/외화
End Sub

'============================================================================
Sub grd0_OnScrollEnd()
	Dim isMore
	isMore = DATAMANAGER.IsMoreNextData( "obtre_oder_002r" )
	
	if isMore == true or isMore == 1 or isMore == "1" then
		DATAMANAGER.RequestNextData( "obtre_oder_002r" )
		
	end if
	
End Sub

'============================================================================
Sub Image0_OnClick()
	btnRate_OnClick()
End Sub

'============================================================================
Sub tbl0_OnClick(lRow , lColumn)
	If lRow = 4 And lColumn = 0  Then
		btnRate_OnClick()
	elseif lRow = 1 and lColumn = 0 Then
		Image1_OnClick()
	End if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REUPDATE" then
		if sRet == "ok" then
			Form.reUpdateFile("mts_master.crc")
		else
			exit sub
		end if
	end if
End Sub

'============================================================================
Sub grd0_OnHeaderClickUp(lRow, szCellID)
	if g_switch = 1 then
		if g_Buffer = 1 then
			
			if szCellID = "th_cell0" or szCellID = "th_cell1" then
				g_Toggle1 = g_Toggle1 + 1
				g_Toggle2 = 0
				
				if g_Toggle1 > 2 then
					g_Toggle1 = 0
				end if
		
				SetGridHeader(g_Toggle1, g_Toggle2)
			elseif szCellID = "th_cell4" or szCellID = "th_cell5"  or
				szCellID = "th_cell2" or szCellID = "th_cell3" or
				szCellID = "th_cell6" or szCellID = "th_cell7" or
				szCellID = "th_cell14" or szCellID = "th_cell15" then	'th_cell14/th_cell15 v0001
				g_Toggle1 = 0
				g_Toggle2 = g_Toggle2 + 1
				
				if g_Toggle2 > 2 then
					g_Toggle2 = 0
				end if
			
				SetGridHeader(g_Toggle1, g_Toggle2)
			end if
		end if
	
		g_Buffer = 1
	end if
	
	'20201028 LES START 보유잔고 정렬마킹
	if szCellID == "th_cell8" or szCellID == "th_cell9" then	
		grdTopCaption = grd0.GetCellTopCaption("th_cell9")
		
		if grdTopCaption == "평가금액(외화)▼" then
			grd0.SetCellTopCaption("th_cell9", "평가금액(외화)▲")
		elseif grdTopCaption ==  "평가금액(외화)▲" then
			grd0.SetCellTopCaption("th_cell9", "평가금액(외화)")
		else
			grd0.SetCellTopCaption("th_cell9", "평가금액(외화)▼")
		end if
	
	end if
	
	'v0001 sta
	if szCellID == "th_cell12" or szCellID == "th_cell13" then	
		grdTopCaption = grd0.GetCellTopCaption("th_cell13")
		
		if grdTopCaption == "평가금액(￦)▼" then
			grd0.SetCellTopCaption("th_cell13", "평가금액(￦)▲")
		elseif grdTopCaption ==  "평가금액(￦)▲" then
			grd0.SetCellTopCaption("th_cell13", "평가금액(￦)")
		else
			grd0.SetCellTopCaption("th_cell13", "평가금액(￦)▼")
		end if
	
	end if
	
	if szCellID == "th_cell14" or szCellID == "th_cell15" then	
		grdTopCaption = grd0.GetCellTopCaption("th_cell15")
		
		if grdTopCaption == "평가손익(￦)▼" then
			grd0.SetCellTopCaption("th_cell15", "평가손익(￦)▲")
		elseif grdTopCaption ==  "평가손익(￦)▲" then
			grd0.SetCellTopCaption("th_cell15", "평가손익(￦)")
		else
			grd0.SetCellTopCaption("th_cell15", "평가손익(￦)▼")
		end if
	
	end if
	'v0001 Fin
	
	if szCellID == "th_cell6" or szCellID == "th_cell7" then	
		grdTopCaption = grd0.GetCellTopCaption("th_cell7")
		
		if grdTopCaption == "평가손익(외화)▼" then
			grd0.SetCellTopCaption("th_cell7", "평가손익(외화)▲")
		elseif grdTopCaption ==  "평가손익(외화)▲" then
			grd0.SetCellTopCaption("th_cell7", "평가손익(외화)")
		else
			grd0.SetCellTopCaption("th_cell7", "평가손익(외화)▼")
		end if
	
	end if
	
	if szCellID == "th_cell2" or szCellID == "th_cell3" then	
		grdTopCaption = grd0.GetCellTopCaption("th_cell2")
				
		if grdTopCaption == "매입수량▼" then
			grd0.SetCellTopCaption("th_cell2", "매입수량▲")
		elseif grdTopCaption ==  "매입수량▲" then
			grd0.SetCellTopCaption("th_cell2", "매입수량")
		else
			grd0.SetCellTopCaption("th_cell2", "매입수량▼")
		end if
	
	end if
	'20201028 LES END
	
	
	
End Sub

'============================================================================
Sub SetGridHeader(g_Toggle1, g_Toggle2)
	if g_Toggle1 = 0 then
		grd0.SetCellTopCaption("th_cell0", "종목명")
	elseif g_Toggle1 = 1 then
		grd0.SetCellTopCaption("th_cell0", "종목명▼")
	else
		grd0.SetCellTopCaption("th_cell0", "종목명▲")
	end if
	
'	if g_Toggle2 = 0 then
'		grd0.SetCellTopCaption("th_cell7", "평가손익")
'	elseif g_Toggle2 = 1 then
'		grd0.SetCellTopCaption("th_cell7", "평가손익▼")
'	else
'		grd0.SetCellTopCaption("th_cell7", "평가손익▲")
'	end if	
End Sub

'============================================================================
Sub Image1_OnClick()
	Dim tbl0_vltn_amt, tbl1_vltn_amt
	Dim tbl0_vltn_name, tbl1_vltn_name
	
	tbl0_vltn_amt  = tbl0.GetCellString(1, 2)
	tbl0_vltn_name = tbl0.GetCellString(1, 0)
	tbl1_vltn_amt  = tbl1.GetCellString(0, 2)
	tbl1_vltn_name = tbl1.GetCellString(0, 0)
	
	tbl0.SetCellString(1, 0, tbl1_vltn_name)
	tbl0.SetCellString(1, 2, tbl1_vltn_amt)
	tbl1.SetCellString(0, 0, tbl0_vltn_name)
	tbl1.SetCellString(0, 2, tbl0_vltn_amt)
	
	if g_VltnFlag == "0" then
		g_VltnFlag = "1"
		Image1.left = 103
	else
		g_VltnFlag = "0"
		Image1.left = 173
	end if
	
End Sub

