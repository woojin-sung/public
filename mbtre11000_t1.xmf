'============================================================================
Sub btnFold_OnClick()
	If g_szFold = "1" Then
		g_szFold = "0"
'		btnFold.btnimage = "btn_filter2.9.png"
		btnFold.caption = "상세"
		Image0.visible = true
		Image1.visible = true
		tbl0.visible = true
		
		rdo0.top = 205
		rdo1.top = 205 'v0001
		btnFold.top = 205
		grd0.top = 249
		grd0.height = 220
		lblExRate.top = 205
	Else
		g_szFold = "1"
'		btnFold.btnimage = "btn_filter.9.png"
		btnFold.caption = "요약"
		Image0.visible = false
		Image1.visible = false
		tbl0.visible = false
		
		rdo0.top = 10
		rdo1.top = 10 'v0001
		btnFold.top = 10
		grd0.top = 54
		grd0.height = 415
		lblExRate.top = 10
	End If
End Sub


'============================================================================
'v0001 원화/외화 라디오
'============================================================================
Sub rdo1_OnClick(nIndex)
	If nIndex == 0 Then
		grd0.SetVisibleCol( 3, true )
		grd0.SetVisibleCol( 4, true )
		grd0.SetVisibleCol( 5, false )
		grd0.SetVisibleCol( 6, false )
	Else
		grd0.SetVisibleCol( 3, false )
		grd0.SetVisibleCol( 4, false )
		grd0.SetVisibleCol( 5, true )
		grd0.SetVisibleCol( 6, true )
	End If
End Sub

