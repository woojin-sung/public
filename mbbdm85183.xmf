	<SCRIPT_INFO _len="7943" _ulen="7239" >
'============================================================================
' 화 면 명 : 업무신청_진행상태_조회(mbbdm85183.xmf)
' 2024.01.11 : v0001 : 전상일 : rcno_pip 인풋값 변경 ( 휴대폰 인증 시 해당 rcno_pip 가져올 수 있도록 수정)
'============================================================================
Dim g_rcno_pip
'
'============================================================================
'							FORM 함수
'============================================================================
Sub Form_OnFormInitBefore()
	ContainerHeader.ImgInfo.setMaintainingRatio("1")
End Sub

'===========================================================================
Sub Form_OnFormInit()
	'v0001 start
	l_bdm_rcno_pip = Form.GetSharedData("BDM_RCNO_PIP"     , False)
	l_jmNum = Form.GetSharedData("&JUMIN_NUM", false )
	
	if l_bdm_rcno_pip <> "" then
		g_rcno_pip = l_bdm_rcno_pip
	else
		g_rcno_pip = l_jmNum
	end if
	'v0001 end
	
	'업무신청현황 초기 set
	ContainerB.ContainerExistB.GridB1.SetClear()
	DATAMANAGER.RequestTranData("obaci_nmet_014r")
End SUb

'============================================================================
'						DATAMANAGER 함수
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	'비대면 유선업무 신청내역 조회
	if szTranID = "obaci_nmet_014r"	Then
		'v0001 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 0, g_rcno_pip)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
		
	'비대면 유선업무 신청내역 조회
	if szTranID = "obaci_nmet_014r"	Then
		ContainerB.ContainerExistB.GridB1.SetClear() '업무신청현황 초기화
	
		nCnt2 = DATAMANAGER.GetDataCount( 0 , "obaci_nmet_014r", "OutBlock1")
		
		if nCnt2  == 0  then
			ContainerB.ContainerExistB.GridB1.visible	= false
			ContainerB.ContainerExistB.Grid2.visible		= true
			
			ContainerB.ContainerExistB.Grid2.SetCellData("bd_cell5", 0, "업무 신청 내역이 없습니다.")
			
			exit Sub
		else
			ContainerB.ContainerExistB.GridB1.visible	= true
			ContainerB.ContainerExistB.Grid2.visible		= false
		end if		
		
		for i = 0 to nCnt2 -1
			aplt_date 		  	  = DATAMANAGER.GetDataValue(0, "obaci_nmet_014r", "OutBlock1", "APLT_DATE" 				, i) '신청일자
			aplt_acno 		  	  = DATAMANAGER.GetDataValue(0, "obaci_nmet_014r", "OutBlock1", "ACNO" 	  				, i) '신청계좌번호

			nmet_cbl_bswr_code  	  = DATAMANAGER.GetDataValue(0, "obaci_nmet_014r", "OutBlock1", "NMET_CBL_BSWR_CODE" 		, i) '비대면업무코드
			nmet_bswr_aplt_stat_code = DATAMANAGER.GetDataValue(0, "obaci_nmet_014r", "OutBlock1", "NMET_BSWR_APLT_STAT_CODE"	, i) '비대면신청상태코드
			dpnm			      	  = DATAMANAGER.GetDataValue(0, "obaci_nmet_014r", "OutBlock1", "DPNM" 					, i) '부서명
			whol_telno	      	  = DATAMANAGER.GetDataValue(0, "obaci_nmet_014r", "OutBlock1", "WHOL_TELNO" 				, i) '전체전화번호
			
			Form.SetCtlProp("ContainerB.ContainerExistB.GridB1", "insertrow", i)	'한줄삽입
		
			ContainerB.ContainerExistB.GridB1.SetCellData( "bd_cell0"	, i	, "신청일"	)
			ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_date"	, i	, aplt_date	)
			ContainerB.ContainerExistB.GridB1.SetCellData( "Acno_data"	, i	, aplt_acno	)

			if nmet_cbl_bswr_code == "001" then
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_gubun1"	, i, "온라인개설계좌 실명확인"		)
			elseif nmet_cbl_bswr_code == "002" then
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_gubun1"	, i, "계좌 비밀번호 재설정"			)
			elseif nmet_cbl_bswr_code == "003" then
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_gubun1"	, i, "인증서 온라인신원확인 동의"		)
			elseif nmet_cbl_bswr_code == "004" then
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_gubun1"	, i, "온라인 서비스 신청"				)
			elseif nmet_cbl_bswr_code == "005" then
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_gubun1"	, i, "온라인 이체한도 등록 및 증액"	)
			elseif nmet_cbl_bswr_code == "006" then
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_gubun1"	, i, "타기관 OTP 이용등록"	)
			elseif nmet_cbl_bswr_code == "007" then
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_gubun1"	, i, "타기관 은행이체 등록"			)
			elseif nmet_cbl_bswr_code == "008" then
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_gubun1"	, i, "메리츠 종합계좌간 대체 등록"		)
			elseif nmet_cbl_bswr_code == "009" then
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_gubun1"	, i, "모바일 OTP 발급"		)
			elseif nmet_cbl_bswr_code == "010" then
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_gubun1"	, i, "단기다수 출금/고 제한 해지"		)	
			elseif nmet_cbl_bswr_code == "M01" then
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_gubun1" , i, "온라인 서비스 신청\n\n온라인 이체한도 등록 및 증액"	)
				'ContainerExist.Grid1.SetCellData( "aplt_gubun2"	, i, "온라인 이체한도 등록 및 증액"	)
			end if

			if nmet_bswr_aplt_stat_code == "0" then '신청중
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_state1"	, i, "신청중" 	)
			elseif nmet_bswr_aplt_stat_code == "1" then '신청완료
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_state1"	, i, "신청완료"	)
			elseif nmet_bswr_aplt_stat_code == "2" then '신청취소
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_state1"	, i, "신청취소"	)
			elseif nmet_bswr_aplt_stat_code == "3" then '처리완료
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_state1"	, i, "처리완료"	)
			elseif nmet_bswr_aplt_stat_code == "4" then '승인완료
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_state1"	, i, "승인완료"	)
			elseif nmet_bswr_aplt_stat_code == "5" then '자동취소
				ContainerB.ContainerExistB.GridB1.SetCellData( "aplt_state1"	, i, "자동취소"	)
			end if
			
			dpnm = dpnm +"  "+whol_telno
			ContainerB.ContainerExistB.GridB1.SetCellData( "brcd_name"	, i, dpnm			)
			
			ContainerB.ContainerExistB.GridB1.SetCellData( "bd_callnum"	, i, whol_telno		) '전화걸기용 별도 전화번호 저장
		next

	end if
	
End Sub

