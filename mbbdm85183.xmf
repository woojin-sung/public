Sub ContainerHeader_ImgInfo_OnClick()
	Form.OpenPopup("mbbdm85183_p1", "", "")
End Sub

'============================================================================
'업무신청 통화연결
'============================================================================
Sub ContainerB_ContainerExistB_GridB1_OnClickUp(lRow, szCellID)

	if szCellID =="bd_cell6" then
		tmp_call_num = ContainerB.ContainerExistB.GridB1.GetCellData("bd_callnum", lRow)
		tmp_call_num = replace(tmp_call_num, "-" , "")
		
		Form.SendCall( tmp_call_num )
	end if

End Sub

