	<CONTROL_INFO/>
	<SCRIPT_INFO _len="4193" _ulen="4129" >

'===========================================================================
' 01. 업무구분 :
' 02. 화면 : 
' 03. 화면설명 : 
' 04. 작성자 : 김철중
' 05. 작성일 : 2020.04.29
' 06. 수정이력 : 
'===========================================================================

Dim g_tCodeList()
Dim g_nCnt
Dim g_nCnt2
Dim g_sData
Dim g_nTotal

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "CodeList" then
		
		g_tCodeList = Split(sParam, "`")

		if #g_tCodeList > 0 and sParam ~= "" then
			if #g_tCodeList > 100 then
				g_nCnt = Cint(#g_tCodeList) / 100
				temp = Cint(#g_tCodeList) % 100
				if temp > 0 then
					g_nCnt = Cint(g_nCnt) + 1
				end if
			else
				g_nCnt = 1
			end if
			
			DATAMANAGER.ClearInputData( false, "ohhts_6000_010r" )
			DATAMANAGER.RequestTranData( "ohhts_6000_010r" )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_6000_010r" then
		for i=0 to #g_tCodeList-1
			if i >= 99 then
				exit for
			end if 
			
			if g_nCnt2 >= #g_tCodeList then
				exit for
			end if
			
			tData = Split(g_tCodeList(g_nCnt2),"@")
			
			szCode = tData[1]
			szMarket = ConvertExchCode(tData[0])
		    
			szDelay = ""
			if szMarket <> "" then
				szDelay = Form.GetSharedData("REALTIME_"..szMarket, 0 )
			end if
			
			DATAMANAGER.SetDataValue(0, "ohhts_6000_010r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i, "OV")
			DATAMANAGER.SetDataValue(0, "ohhts_6000_010r", "InBlock1", "FID_INPUT_OVRS_ISCD", i, szCode)
			DATAMANAGER.SetDataValue(0, "ohhts_6000_010r", "InBlock1", "FID_COND_MRKT_CLS_CODE", i, szMarket)
			DATAMANAGER.SetDataValue(0, "ohhts_6000_010r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE", i, szDelay)
			
			g_nCnt2 = Cint(g_nCnt2) + 1
		next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6000_010r" then
		Dim nCount, sData
		nCount = DATAMANAGER.GetDataCount( 0, "ohhts_6000_010r" , "OutBlock1" )
		'sData = ""
		
		for i=0 to nCount-1
			Dim sKormark, sCode , sClose, sDiff, sDecimal

			sKormark	= DATAMANAGER.GetDataValue( 0, "ohhts_6000_010r" , "OutBlock1", "FID_COND_MRKT_CLS_CODE" , i )
			sCode	= DATAMANAGER.GetDataValue( 0, "ohhts_6000_010r" , "OutBlock1", "FIDX_ISCD" , i )
			sClose	= DATAMANAGER.GetDataValue( 0, "ohhts_6000_010r" , "OutBlock1", "FIDX_PRPR" , i )
			sDiff	= DATAMANAGER.GetDataValue( 0, "ohhts_6000_010r" , "OutBlock1", "FIDX_PRDY_VRSS" , i )
			sDecimal	= DATAMANAGER.GetDataValue( 0, "ohhts_6000_010r" , "OutBlock1", "FIDX_DCPN_CNT" , i )
			
			sKormark = Form.GetItemCodeInfo( sKormark & "@" & sCode , "exchcode3") '다시 3자리로
			
			g_sData = g_sData & sKormark & "◆" & sKormark & "@" & sCode & "◆" & sClose & "◆" & sDiff & "◆" & sDecimal
		
			if i ~= nCount-1 then
				g_sData = g_sData & "`"
			end if
		next
		
		g_nCnt = Cint(g_nCnt) - 1
		if Cint(g_nCnt) > 0 then
			DATAMANAGER.ClearInputData( false, "ohhts_6000_010r" )
			DATAMANAGER.RequestTranData( "ohhts_6000_010r" )
		else 
			if g_sData ~= null and g_sData ~= "" then
				Form.triggerEvent("#", "CodeData", g_sData)
				
				'20210119 LES START 
				g_sData = ""
				g_nCnt2 = 0
				g_nTotal = Cint()
				'20210119 LES END
				
			end if
		end if
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_sData = ""
    g_nCnt2 = 0
    g_nTotal = Cint()
End Sub

'============================================================================
Function ConvertExchCode(sCode)
	Dim exCode
	exCode = ""
    if sCode == "NAS" then
	    exCode = "OQ"
    elseif sCode == "AMX" then
	    exCode = "AX"
    elseif sCode == "NYS" then
	    exCode = "NY"
    elseif sCode == "SHS" then
	    exCode = "SH"
    elseif sCode == "SZS" then
	    exCode = "SZ"
    elseif sCode == "HKS" then
	    exCode = "HK"
    elseif sCode == "TSE" then
	    exCode = "JP"
    end if
    
    return exCode
End Function

