				<LABEL name="lblBondMore" fgcolor="334:034034034" fontsize="-2" fontstyle="10" caption="더 알아보기" halign="1" paddinginfo="1,0,0,0" click="1" ly_vert="40,671,295,20,1" />
				<LABEL name="lblText5" fontsize="4" caption="ETF도 실시간으로" valign="0" paddinginfo="1,0,0,0" ly_vert="20,765,200,25,1" />
