				<LABEL name="lblText8" fgcolor="334:034034034" fontsize="-2" caption="실시간 정보 제공은 물론, 쉽고 빠른 파워 검색으로
내 목표에 맞춘 투자가 가능해요" multiline="1" paddinginfo="1,0,0,0" ly_vert="40,1088,295,40,1" />
				<LABEL name="lblText9" fgcolor="321:115118124" fontsize="-2" caption="#업계최고 #어디서도 보지 못했던 #ETF파워검색" paddinginfo="1,0,0,0" ly_vert="40,1165,295,20,1" />
