<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="81000" scrname="고객연락처변경_개인정보수집이용제공동의" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,375,607,1" />
	<CONTROL_INFO>
		<WEBVIEW name="WebView0" urlpath="about:blank" ly_vert="6,105,363,180,1" />
		<WEBVIEW name="WebView1" urlpath="about:blank" ly_vert="6,333,363,180,1" />
		<LABEL name="Label1" fontsize="-2" caption="『개인정보보호법』 제15조(개인정보의 수집.이용), 제17조(개인정보의 제공), 제 24조(고유식별정보의 처리 제한) 및 『정보통신망법』에 제22조(개인정보의 수집.이용), 제24조의2(개인정보의 제공)에 따라, 다음의 내용을 고지하고 고객님의 동의를 요청합니다." valign="0" multiline="1" ly_vert="6,9,363,105,1" />
		<CHKBUTTON name="ChkButton0" fontsize="-2" chkcaption="필수정보 동의" unchkcaption="필수정보 동의" ly_vert="6,285,136,39,1" />
		<CHKBUTTON name="ChkButton1" fontsize="-2" chkcaption="고유식별번호 동의" unchkcaption="고유식별번호 동의" ly_vert="129,285,142,39,1" />
		<CHKBUTTON name="ChkButton2" fontsize="-2" chkcaption="전체 동의" unchkcaption="전체 동의" ly_vert="277,285,117,39,1" />
		<CHKBUTTON name="ChkButton3" fontsize="-2" chkcaption="필수정보 동의" unchkcaption="필수정보 동의" ly_vert="6,513,138,39,1" />
		<CHKBUTTON name="ChkButton4" fontsize="-2" chkcaption="고유식별번호 동의" unchkcaption="고유식별번호 동의" ly_vert="129,513,144,39,1" />
		<BUTTON name="ButtonOK" caption="확인" fgcolor="128:188030030" btnimage="btn_pop2.9.png" ly_vert="187,562,188,45,1" />
		<CHKBUTTON name="ChkButton5" fontsize="-2" chkcaption="전체 동의" unchkcaption="전체 동의" ly_vert="277,513,117,39,1" />
		<BUTTON name="ButtonCancel" caption="취소" fgcolor="004:000000000" btnimage="btn_pop1.9.png" ly_vert="0,562,187,45,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="5778" _ulen="4484" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 고객연락처변경
' 02. 화면설명 : 고객연락처변경_개인정보수집이용제공동의
' 03. 작    성 : 2016.01.25 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_sRetData = "cancel"
	Form.SetScreenName("개인정보 수집.이용.제공 동의")
	
	WebView0.loaddata = "<html><body>개인정보 수집.이용<br>"..
					"개인정보 수집.이용 목적 : 휴대폰 본인확인 및 SMS 인증<br>"..
					"개인정보 수집.이용 항목<br>"..
					"- 필수 정보 : 성명, 주민등록번호 등 고유식별번호, 이동통신사 구분, 휴대폰번호<br>"..
					"- 고유식별번호 : 주민등록번호 등 실명확인번호<br>"..
					"보유.이용기간 : 전자금융거래기록의 생성 및 보존을 위해 동의일로부터 (금융)거래 종료일까지<br><br>"..
					"고객님께서는 개인정보 수집.이용에 대한 동의를 거부할 권리를 갖습니다. 반면에 동의거부 시 휴대폰 본인확인 실패로 사용자 확인과 SMS인증 등이 필요한 서비스의 이용이 제한됩니다."
					&"</body></html>"
	WebView1.loaddata = "<html><body>개인정보 제공<br>"..
					"개인정보의를 제공받는 자 : 에스케이텔레콤, 케이티, LG유플러스, 삼성SDS, 드림시큐리티, 모빌리"..
					"언스, SK네트웍스, 케이스카이비, 다날, 통신사와 도매제공협정을 체결한 알뜰폰사업자, NICE평가"..
					"정보㈜, 서울신용평가정보, 코리아크레딧뷰로<br>"..
					"개인정보 제공 목적 : 휴대폰 사용자의 본인확인(연계정보(CI)/중복가입확인정보(DI) 생성 및 제공".. 
					"포함)과 SMS 발송<br>"..
					"제공할 개인정보 항목<br>"..
					"- 필수 정보 :  성명, 주민등록번호 등 고유 식별번호, 이동통신사 구분, 휴대폰번호, 연계정보"..
					"(CI), 중복확인정보(DI)<br>"..
					"- 고유식별번호 : 통신사가 보유하고 있는 본인의 주민등록번호, 외국인등록번호 등 실명확인번호<br>"..
					"제공받는 자의 개인정보 보유.이용 기간 : 개인정보의 이용목적 달성 즉시 폐기<br>"..
					"(단, 회사의 내부 방침 및 관계법령에 의한 보유사유가 있을 경우 예외)<br><br>"..
					"고객님께서는 개인정보 제공에 대한 동의를 거부할 권리를 갖습니다. 반면에 동의거부 시 휴대폰 "..
					"본인확인 실패로 사용자 확인과 SMS인증 등이 필요한 서비스의 이용이 제한됩니다.</body></html>"
End Sub

'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if ChkButton2.chksilence == "0" then
		Form.MsgBox( "알림", "개인정보 수집.이용 동의를 확인하시기 바랍니다.", "", 6 )
		Exit Sub
	end if
	
	if ChkButton5.chksilence == "0" then
		Form.MsgBox( "알림", "개인정보 제공 동의를 확인하시기 바랍니다.", "", 6 )
		Exit Sub
	end if

	g_sRetData = "ok"
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl81000_p3" , g_sRetData)
End Sub

'============================================================================
Sub ChkButton0_OnChange(sCheckState)
	if sCheckState == "1" and ChkButton1.chksilence == "1" then
		ChkButton2.chksilence = "1"
	else
		ChkButton2.chksilence = "0"
	end if
End Sub

'============================================================================
Sub ChkButton1_OnChange(sCheckState)
	if sCheckState == "1" and ChkButton0.chksilence == "1" then
		ChkButton2.chksilence = "1"
	else
		ChkButton2.chksilence = "0"
	end if
End Sub

'============================================================================
Sub ChkButton2_OnChange(sCheckState)
	ChkButton0.chksilence = sCheckState
	ChkButton1.chksilence = sCheckState
End Sub

'============================================================================
Sub ChkButton3_OnChange(sCheckState)
	if sCheckState == "1" and ChkButton4.chksilence == "1" then
		ChkButton5.chksilence = "1"
	else
		ChkButton5.chksilence = "0"
	end if
End Sub

'============================================================================
Sub ChkButton4_OnChange(sCheckState)
	if sCheckState == "1" and ChkButton3.chksilence == "1" then
		ChkButton5.chksilence = "1"
	else
		ChkButton5.chksilence = "0"
	end if
End Sub

'============================================================================
Sub ChkButton5_OnChange(sCheckState)
	ChkButton3.chksilence = sCheckState
	ChkButton4.chksilence = sCheckState
End Sub


	</SCRIPT_INFO>
</ROOT>