	<SCRIPT_INFO _len="628" _ulen="614" >
'--===========================================================================
' 01. 신규작성 : 장원혁 v000 
'--===========================================================================

'============================================================================
Sub ChkButton_OnChange(sCheckState)

	If sCheckState == 0 Or sCheckState == "0" Then
	    BtnCnfr.enable = False
	Else
	    BtnCnfr.enable = True
	End If
	
End Sub

'============================================================================
Sub BtnCnfr_OnClick()
    Form.SendReturnToParent("warning" , "ok")
    Form.CloseForm()
End Sub

