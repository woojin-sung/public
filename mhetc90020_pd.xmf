	<SCRIPT_INFO _len="2556" _ulen="2392" >
'============================================================================
Dim g_strDate	'오늘하루 열지 않음 결과값 (체크:오늘날짜 체크해지:00000000)

'20180831 LES START - CDD이행팝업 개선
Dim g_CustClsCode
Dim g_returnVal

'============================================================================
' 확인버튼 
'============================================================================
Sub btnOk_OnClick()
	
	g_returnVal = "REG"
	
	'개인고객
	szData = "90020_pd" & "★" & Form.GetSharedData("&USER_ID", false )
	if g_CustClsCode == "1" then
		'Form.OpenFramePopup("mhetc90020_cddReg" , szData , "")
		Form.CloseForm()
	else
		Form.MsgBox("안내", "법인 고객은 영업점을 방문하여 처리하여 주시기 바랍니다.", "", 0)
	end if
	

	
End Sub
'============================================================================
Sub Form_OnFormClose()

	if g_returnVal = "REG" then
		Form.SendReturnToParent("mhetc90020_pd" , g_returnVal)
	else
		Form.SendReturnToParent("mhetc90020_pd" , g_strDate)
	end if
	
End Sub
'============================================================================
' 오늘하루열지않음 
'============================================================================
Sub ChkButton0_OnChange(sCheckState)
	
	'체크했을때는 오늘 날짜 넘김 
	if sCheckState == "1" Then 
		g_strDate = Trim(Form.GetSharedData("&HOST_DATE", false ))
	else
		g_strDate = "99999999"
	end if
	
End Sub

'============================================================================

'============================================================================
Sub Form_OnFormInit()
	g_strDate = "99999999"
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	
	'szID = Form.GetSharedData("&USER_ID", false )	
	szID = Form.GetOpenLinkData( )
	
	DATAMANAGER.SetDataValue(0, "obcmm_kcdd_042r", "InBlock1", "PROS_CLS_CODE" , 0 , "1")
	DATAMANAGER.SetDataValue(0, "obcmm_kcdd_042r", "InBlock1", "ELFN_ID" 	  , 0 , szID)
	DATAMANAGER.RequestTranData("obcmm_kcdd_042r")
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcmm_kcdd_042r" then
		g_CustClsCode = DATAMANAGER.GetDataValue(0, "obcmm_kcdd_042r", "OutBlock1", "CUST_CLS_CODE" , 0)
	end if
End Sub

