	<SCRIPT_INFO _len="6132" _ulen="5938" >
Dim gOsType

'============================================================================
Sub Form_OnFormInitBefore()
	
	gOsType = Form.GetSharedData("&OS_TYPE", false)
	
	imgBack.setMaintainingRatio("2")
	imgTitle.setMaintainingRatio("1")
	imgSort.setMaintainingRatio("1")
	grdList.setMaintainingRatio("bd_pdf", 0, "1")
	
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	'--------------------------------------------------------------
	'큰글씨모드 대응
	'--------------------------------------------------------------
	szTextSizeMode = Form.GetEnvData("common.textsize")
	
	if CInt(szTextSizeMode) > 0 then
	
		if gOsType == "1" then
			lblTitleText.fontsize = 1 - Cint((szTextSizeMode * 2))
			
		else
			lblTitleText.fontsize = -1 - Cint((szTextSizeMode * 2))
		end if
		
	end if	


	'배경색/글자색 설정
	lblTitleBg.bgcolor = 397
	lblTitleText.fgcolor = 398
	
	'ETF 리서치 컨텐츠 목록 조회
	DATAMANAGER.RequestTranData( "ooopc_rprt_003r" )
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ooopc_rprt_003r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_GRP_ID" , 0 , "bascGrp")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_ID" , 0 , "sih02")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_CNTT_DIV_CODE" , 0 , "%")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_CNTT_WRTR_NAME" , 0 , "%")
		'DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_CNTT_TITL_NAME" , 0 , "%")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_CNTT_TITL_NAME" , 0 , "ETF")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "STA_DATE" , 0 , "00000000")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "FIN_DATE" , 0 , "99999999")
		'DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_CNTT_SPLM_ITEM_VAL11" , 0 , "Meritz Bi-Weekly")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "BBS_CNTT_SPLM_ITEM_VAL11" , 0 , "")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , cmbSort.cbkeydata)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ooopc_rprt_003r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" )
		if nCnt > 0 then
			Dim nGrdCnt
			nGrdCnt = CInt(grdList.rowcount)
			
			for i = 0 to nCnt - 1
				Dim szTitle, szDate, szWriter
				szTitle = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "BBS_CNTT_TITL_NAME" , i )
				szDate = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "BBS_CNTT_WRTN_YMDH" , i )
				szDate = replace(szDate, "/" , "")
				szWriter = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "BBS_CNTT_WRTR_NAME" , i )
				
				grdList.AddRow()
				
				'타이틀 2줄표기 / 글자크기 줄임없이 넘치면 ... 표시
				grdList.SetCellMaxLineCount("bd_title",2)
				grdList.SetSizeToFitTextSkip(true)
				
				grdList.SetCellData("bd_title", nGrdCnt + i, szTitle)
				grdList.SetCellData("bd_sub", nGrdCnt + i, Mid(szDate, 3, 2) .. "." .. Mid(szDate, 5, 2) .. "." .. Mid(szDate, 7, 2) .. "  " .. szWriter )
				
				Dim szFilePath, szSeqNo
				szFilePath = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "BBS_ATCH_ORTX_FILE_NAME" , i )
				szSeqNo = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "BBS_CNTT_TURN_NO" , i )
				grdList.SetCellData("bd_file", nGrdCnt + i, szFilePath)
				grdList.SetCellData("bd_seq", nGrdCnt + i, szSeqNo)
			next
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szMsgText, szSubText
	szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
	szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
	if szSubText <> "" and szSubText <> null then
		Form.ShowAlert("알림", szMsgText & "(" & szSubText &")")
	else
		Form.ShowAlert("알림", szMsgText)
	end if
End Sub

'============================================================================
Sub btnSort_OnClick()
	cmbSort.openList()
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("ooopc_rprt_003r") then
		DATAMANAGER.RequestNextData( "ooopc_rprt_003r" )
	end if
End Sub

'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
'	if szCellID == "bd_pdf" then
		Dim szMode, szUrl, szFileName
	
		szMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
		
		if CInt(szMode) == 0 then
			szUrl = "https://home.imeritz.com/include/resource/research/WorkFlow"	'운영계 주소
		elseif CInt(szMode) == 1 then
			szUrl = "https://testhome.imeritz.com/include/resource/research/WorkFlow"	'테스트계주소
		end if
		
		szFileName = Trim(szUrl) & "/" & grdList.GetCellData("bd_file", lRow)
		
		if szFileName <> "" then
			Form.OpenPdfViewer(szFileName, "ETF 리포트")
		else
			Form.ShowAlert("알림", "pdf파일을 다운로드 할 수 없습니다.")
		end if
		
'		Form.OpenExternalBrowser(szFileName)
'	else
'		Dim szTitle, szSub, szFileName, szSeq, szSendData
'		szTitle = grdList.GetCellData("bd_title", lRow)
'		szSub = grdList.GetCellData("bd_sub", lRow)
'		szFileName = grdList.GetCellData("bd_file", lRow)
'		szSeq = grdList.GetCellData("bd_seq", lRow)
'		
'		szSendData = szTitle .. "★" .. szSub .. "★" .. szFileName .. "★" .. szSeq
'		
'		Form.OpenPopup("nrshidx50410", szSendData, "")
