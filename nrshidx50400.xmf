End Sub

'============================================================================
Sub imgBack_OnClick()
	Form.openPrevScreen()
End Sub

'============================================================================
Sub cmbSort_OnEditComplete(iIndex)
	grdList.SetClear()
	
	'ETF 리서치 컨텐츠 목록 조회
	DATAMANAGER.RequestTranData( "ooopc_rprt_003r" )
End Sub

