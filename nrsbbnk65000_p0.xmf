'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	lblTemp0.paddinginfo = "0,0,0,0"
	lblTemp1.paddinginfo = "0,0,0,0"
	lblTemp2.paddinginfo = "0,0,0,0"
'	Label1.paddinginfo = "0,0,0,0"
'	Label2.paddinginfo = "0,0,0,0"
	Form.SetTimerEvent2(1, 1, 0.01)
   'Init_Control()
End Sub

'===============================================
' imgInfo_OnClick
'===============================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if Cint(sTimerID) == 1 then
		Form.SetTimerEvent2(1, 0, 0)
		Init_Control()
	end if
End Sub

