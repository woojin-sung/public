'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'-----------------------------------------------
' 이미지
'-----------------------------------------------
Dim g_szCloseImg  
g_szCloseImg = "icon_close"

'-----------------------------------------------
' 컬러코드
'-----------------------------------------------
' 기본 텍스트 컬러 (검정색)
Dim g_szTxtColor_Normal 
g_szTxtColor_Normal 	= "334"

' 기본 텍스트 컬러 (회색)
Dim g_szTxtColor_Grey 
g_szTxtColor_Grey 	= "333"

' 기본 텍스트 컬러 (흰색)
Dim g_szTxtColor_White 
g_szTxtColor_White 	= "338"

' 기본 텍스트 컬러 (흰색)
Dim g_szLineColor_Grey 
g_szLineColor_Grey 	= "320"

' 기본 텍스트 컬러 (빨강)
Dim g_szTxtColor_Red 
g_szTxtColor_Red = "326"

'-----------------------------------------------
' 기타 전역변수
'-----------------------------------------------
Dim g_szTitle
g_szTitle = "환전신청 유의사항"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************

Function DisplaySetting_PannelRow(nIdx, szType, nDepth, szHead, szText, szSize, szBold, szFgColor)
	
	' 글머리 기호
	Pannel0.setPropCardCell("paddinginfo" 	,"lblGuide", nIdx, "0,1,0,0")
	Pannel0.setPropCardCell("fgcolor" 		,"lblGuide", nIdx, szFgColor)

	' 본문
	Pannel0.setPropCardCell("paddinginfo" ,"lblInfo",nIdx,"0,0,0,0")
	Pannel0.setPropCardCell("fgcolor" ,"lblInfo",nIdx,szFgColor)
	
	' 이미지
	Pannel0.setPropCardCell("maintainratio" ,"imgGuide0",nIdx, "1")
	
	' 구분라인
	Pannel0.setPropCardCell("bgcolor" ,"lblDiv",nIdx, szFgColor)
	
	
	'---------------------------------------------------------------
	'들여쓰기 단계
	'---------------------------------------------------------------
	szCtlNm = ""
	'0단계(기본) : 글머리 20 / 본문 35 (310)
	if nDepth == 0 then
		Pannel0.setPropCardCell("left",  "lblGuide", nIdx, "20")
		Pannel0.setPropCardCell("left",  "lblInfo" , nIdx, "35")
		Pannel0.setPropCardCell("width", "lblInfo" , nIdx, "310")
		szCtlNm = "lblTemp0"
	'1단계 : 글머리 35 / 본문 50 (295) 
	elseif nDepth == 1 then
		Pannel0.setPropCardCell("left",  "lblGuide", nIdx, "35")
		
		'글머리 유무 체크
		if szHead == "" then
			Pannel0.setPropCardCell("left",  "lblInfo" , nIdx, "35")
			Pannel0.setPropCardCell("width", "lblInfo" , nIdx, "310")
			szCtlNm = "lblTemp0"
		else
			Pannel0.setPropCardCell("left",  "lblInfo" , nIdx, "50")
			Pannel0.setPropCardCell("width", "lblInfo" , nIdx, "295")
			szCtlNm = "lblTemp1"
		end if
		
	'2단계 : 글며리 50 / 본문 75 (280)
	elseif nDepth == 2 then
		Pannel0.setPropCardCell("left",  "lblGuide", nIdx, "50")
		
		'글머리 유무 체크
		if szHead == "" then
			Pannel0.setPropCardCell("left",  "lblInfo" , nIdx, "50")
			Pannel0.setPropCardCell("width", "lblInfo" , nIdx, "295")
			szCtlNm = "lblTemp1"
		else
			Pannel0.setPropCardCell("left",  "lblInfo" , nIdx, "75")
			Pannel0.setPropCardCell("width", "lblInfo" , nIdx, "280")
			szCtlNm = "lblTemp2"
		end if
	else
		Pannel0.setPropCardCell("left",  "lblGuide", nIdx, "20")
		Pannel0.setPropCardCell("left",  "lblInfo" , nIdx, "35")
		Pannel0.setPropCardCell("width", "lblInfo" , nIdx, "310")
		szCtlNm = "lblTemp0"
	end if
	'---------------------------------------------------------------
	
	'---------------------------------------------------------------
	'폰트스타일 (사이즈 / 볼드 / 글자색)
	'---------------------------------------------------------------
	Pannel0.setPropCardCell("fontsize" ,"lblGuide",nIdx, szSize)
	Pannel0.setPropCardCell("fontsize" ,"lblInfo",nIdx, szSize)
	'Form.SetCtlProp(szCtlNm, "fontsize", szSize)

	Pannel0.setPropCardCell("fontbold" ,"lblGuide",nIdx, szBold)
	Pannel0.setPropCardCell("fontbold" ,"lblInfo",nIdx, szBold)
	'Form.SetCtlProp(szCtlNm, "fontbold", szBold)
	
	Pannel0.setPropCardCell("fgcolor" ,"lblGuide",nIdx, szFgColor)
	Pannel0.setPropCardCell("fgcolor" ,"lblInfo",nIdx, szFgColor)
	'---------------------------------------------------------------
	
	nHeight = 0
	'---------------------------------------------------------------
	'데이터 세팅
	'---------------------------------------------------------------
	'텍스트
	if szType == "0" then
		Pannel0.setPropCardCell("caption" ,"lblGuide",nIdx, szHead)
		Pannel0.setPropCardCell("caption" ,"lblInfo",nIdx, szText)
		
		Pannel0.setPropCardCell("imgpath" ,"imgGuide0",nIdx, "alpha")
		Pannel0.setPropCardCell("left" ,"lblDiv",nIdx, "500")
		
		nLineCnt = 0
		if szCtlNm == "lblTemp0" then
			lblTemp0.caption = szText
			nLineCnt = lblTemp0.linecnt
		elseif szCtlNm == "lblTemp1" then
			lblTemp1.caption = szText
			nLineCnt = lblTemp1.linecnt
		elseif szCtlNm == "lblTemp2" then
			lblTemp2.caption = szText
			nLineCnt = lblTemp2.linecnt
		end if
		
		nHeight = Resize_LineH(szText, Cint(szSize), nLineCnt)
		Pannel0.SetCardWHAt(nIdx, nHeight)
	'이미지
	elseif szType == "1" then
		Pannel0.setPropCardCell("caption" ,"lblGuide",nIdx, "")
		Pannel0.setPropCardCell("caption" ,"lblInfo",nIdx, "")
		
		Pannel0.setPropCardCell("imgpath" ,"imgGuide0",nIdx, "alpha")
		Pannel0.setPropCardCell("left" ,"lblDiv",nIdx, "500")
		
	'구분선(Divide)
	elseif szType == "2" then
		Pannel0.setPropCardCell("caption" ,"lblGuide",nIdx, "")
		Pannel0.setPropCardCell("caption" ,"lblInfo",nIdx, "")
		
		Pannel0.setPropCardCell("imgpath" ,"imgGuide0",nIdx, "alpha")
		Pannel0.setPropCardCell("left" ,"lblDiv",nIdx, "20")
		Pannel0.setPropCardCell("width" ,"lblDiv",nIdx, "335")

	'초기화	
	else
		Pannel0.setPropCardCell("caption" ,"lblGuide",nIdx, "")
		Pannel0.setPropCardCell("caption" ,"lblInfo",nIdx, "")
		
		Pannel0.setPropCardCell("imgpath" ,"imgGuide0",nIdx, "alpha")
		Pannel0.setPropCardCell("left" ,"lblDiv",nIdx, "500")
	end if
	'---------------------------------------------------------------
	
	return nHeight
End Function

Function Resize_LineH(szText, nFontSize, nLineCnt)
	nResult = 0
	nLineHeigth = 20 + nFontSize
	nGap = 0 
	
	szOsType = Form.GetSharedData("&OS_TYPE", false)
	szTextSize = Form.getEnvData("common.textsize")
	
	if szOsType == "1" then
		nGap = 1
	elseif szOsType == "2" then
		nGap = 2
	end if
	
'	Form.SetCtlProp(szCtlNm, "caption", szText)
'	nLineCnt = Form.GetCtlProp(szCtlNm, "linecnt")
	nResult = (nLineHeigth + (Cint(szTextSize) * nGap)) * nLineCnt + 5
	
	return nResult
End Function

'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	'-----------------------------------------------
	' 뒤로가기 버튼 초기화
	'-----------------------------------------------
	lblTitle.paddinginfo = "0,0,0,0"
	lblTitle.caption = g_szTitle
	
	'-----------------------------------------------
	' 유의사항 버튼 초기화
	'-----------------------------------------------
	imgClose.SetMaintainingRatio("3")
	imgClose.imgpath = g_szCloseImg
	
	'-----------------------------------------------
	' 유의사항 본문내용 초기화
	'-----------------------------------------------
	szTextSize = Form.getEnvData("common.textsize")
	
	szInfo0 = "해외주식거래 또는 외화금융상품거래 약정 등록된 종합매매계좌, Super365계좌, 해외파생계좌, 해외CFD계좌만 환전 가능합니다."
	szInfo0_1 = "(단,해외CFD계좌의 경우 거래 국가 통화만 환전 가능)"
	
	szInfo1 = "환전가능시간"
	szInfo1_1 = "USD"
	szInfo1_2 = "실시간 환전 : 영업일 09:00 ~ 익일 02:00"
	szInfo1_3 = "시간외 환전 : 익일 02:00 ~ 익영업일 06:00"
	
	szInfo1_4 = "그 외 통화"
	szInfo1_5 = "실시간 환전 : 영업일 09:00 ~ 영업일 15:30"
	szInfo1_6 = "시간외 환전 : 영업일 15:40 ~ 익영업일 06:00"
	
	szInfo2 = "환전 신청 후 취소 불가하오니 유의하시기 바랍니다."
	
	szInfo3 = "국내 휴일 및 수표 입금 시, 당일 환전이 불가합니다."
	szInfo3_1 = "(수표 입금액은 익영업일 수표 정산 후 환전 가능)"
	
	szInfo4 = "외화 환전은 외화증권의 투자목적용으로 제한됩니다. 외화 증권 투자와 관계없는 단순 환전이 지속될 경우, 외국환거래 규정에 의거하여 거래가 제한될 수 있으니 유의하시기 바랍니다."
	
	szInfo5 = "환전 환율은 시장환율+당사가 정한 스프레드로 적용되며, 당사의 환율 우대 정책에 따라 높은 우대율 우선순으로 자동 적용됩니다."
	
	szInfo6 = "환전 시, 소수점 미만은 절사합니다."
	
	szInfo7 = "실시간 환율 적용으로 조회시점과 환전 처리시점의 환율이 달라질 수 있으므로, 환전 후 최종 적용환율을 확인하시기 바랍니다."
	
	szInfo8 = "1회 환전 한도"
	
	szInfo9 = "시간외 환전은 USD(미국), HKD(홍콩), EUR(유로), CHF(스위스) 매수 환전만 가능합니다."
	
	szInfo10 = "시간외 환전 절차"
	szInfo10_1 = "당일 마감환율로 산정된 원화금액 +5%로 환전"
	szInfo10_2 = "익영업일 9시경 실시간 환율로 정산처리"
	
	szInfo11 = "이종통화 환전은 원화를 거쳐 두 번 환전 처리됩니다."
	szInfo11_1 = "(외화매도 → 원화 → 외화매수)"
	
	szInfo12 = "이종통화 환전 시, 우대율은 당사 우대 정책에 따라 통화별 각각 높은 우대율이 자동 적용됩니다."
	szInfo12_1 = "(외화매도 통화 우대율, 외화매수 통화 우대율 각각 적용)"
	
	szInfo13 = "환전 신청 후, 반드시 환전 처리결과 여부를 확인하시기 바랍니다."
	
	szInfo14 = "베트남(VND) 환전"
	
	szInfo15 = "베트남(VND) 환전은 현지 외환관리규정에 따라 미국(USD)로만 환전 신청이 가능합니다."
	szInfo15_1 = "VND매수환전"
	szInfo15_2 = "USD 송금 후 현지에서 VND 환전/입금"
	szInfo15_3 = "VND매도환전"
	szInfo15_4 = "VND 송금 후 현지에서 USD 환전/입금"
	
	szInfo16 = "베트남(VND) 환전 안내"
	
	szInfo17 = "베트남(VND) 통화는 현지 주식투자 용도의 환전으로, 다른 외화와 달리 타사 계좌로 이체ㆍ대체는 제한됩니다."
	szInfo17 = szInfo17 & "(이체ㆍ대체를 원하는 경우, USD로 환전 후 가능)"
	
	szInfo18 = "환전 결제일 매도 통화 부족 시, 외화 미수금이 발생할 수 있습니다."
	
	szInfo19 = "현지 사정 또는 국내/현지 휴일 등의 사유로 환전 처리 결제일은 지연될 수 있습니다."
	
	szInfo20 = "현지 환전 결과가 USD 0.01미만인 경우는 환전 신청은 취소될 수 있습니다."
	
	'==================================================================================================================================================
	szOsType = Form.GetSharedData("&OS_TYPE", false)
	nHeight = 0
	
	nIdx = Pannel0.AddRow()
	DisplaySetting_PannelRow(nIdx, "0", 0, "ㆍ", szInfo0, "-2", "0", g_szTxtColor_Grey)
	
	nIdx = Pannel0.AddRow()
	nHeight = DisplaySetting_PannelRow(nIdx, "0", 1, "", szInfo0_1, "-2", "0", g_szTxtColor_Grey)
	Pannel0.SetCardWHAt(nIdx, nHeight + 10)
	'---------------------------------------------------------------------------------------
	'Step1 START
	'---------------------------------------------------------------------------------------
	nIdx = Pannel0.AddRow()
	nHeight = DisplaySetting_PannelRow(nIdx, "0", 0, "ㆍ", szInfo1, "-2", "1", g_szTxtColor_Normal)

	nIdx = Pannel0.AddRow()
	DisplaySetting_PannelRow(nIdx, "0", 1, "-", szInfo1_1, "-2", "0", g_szTxtColor_Grey)

