' 01. 화 면 명 : 오픈뱅킹_한번에 잔액 모으기 1단계
' 02. 화면설명 : 한번에 잔액 모으기 1단계
' 03. 작    성 : 2020.10.12 장원혁
' 04. 수    정 : 2021.04.02 장원혁 v001 처리 시 인증절차 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'전역 변수 선언
Dim currentLoopIndex
Dim MNRC_ACNT
Dim PROS_CNT
Dim RSLT_CODE
Dim USER_NAME
Dim g_szCertUserType 'v001

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()

    g_szCertUserType= Form.GetSharedData("&CERT_USE_TYPE", false )  'v001 로그인타입

    szAcnt = Form.GetSharedData("mbbnk62010_MNRC_ACNO" , False )
    
    Account.caption = szAcnt

    szData = Form.GetSharedData("mbbnk62010_MultiRowData" , False)
       
    Dim szList
    szList = Split(szData, "●")
    If UBOUND(szList) < 1 then
        Exit Sub
    End If
    
    MNRC_AMT = 0
    
    For i = 0 To 4
        CurrentData = Split(szList(i),"★")
        If UBOUND(szList) < 1 then
            Exit Sub
        End If
        Grid0.AddRow()
        Grid0.SetCellData("bd_cell0" , i , CurrentData(0))
        Grid0.SetCellData("bd_cell1" , i , CurrentData(1))
        Grid0.SetCellData("bd_cell2" , i , CurrentData(2))
        Grid0.SetCellData("bd_cell3" , i , CurrentData(3))
	
        MNRC_AMT = MNRC_AMT + Grid0.GetCellData("bd_cell1", i)
	
    Next
    
    MnrcAmt.caption = FormatNumber(MNRC_AMT , 0) & "원"
    
    USER_NAME = Form.GetSharedData("mbbnk62010_USER_NAME", False )
    
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

    If sKeyName == "mhetc90060_p5" then 'v001
		if sRet ~= "cancel" then
			'등록
			Run()
		end if
    End If
		
    If sKeyName == "mhetc90060_px" Then 'v001
         If sRet == "ok" Then
	         Run()
	     End If
    End If

    If sKeyName = "CLOSE_YN" Then
        If sRet = "Y" Then
            Form.SendReturnToParent("CLOSE_YN" , "Y")
            Form.CloseForm()
        End If
    End If

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "obtss_opnf_003a" Then
	
        If currentLoopIndex = 0 Or currentLoopIndex = "0" Then
            RSLT_CODE =                    "정상"
        Else
            RSLT_CODE = RSLT_CODE & "★" & "정상"
        End If
	
        currentLoopIndex = currentLoopIndex + 1
	
        If currentLoopIndex > 4 Or Grid0.GetCellData("bd_cell0" , currentLoopIndex) = "" Then
            
            For i = 0 To 4 - currentLoopIndex
                RSLT_CODE = RSLT_CODE & "★"
            Next
	    
	        Form.SetSharedData("mbbnk62010_RSLT_CODE" , RSLT_CODE)
	    
            Form.OpenFramePopup("mbbnk62010_t3" , "" , "")

            Exit Sub
	    
        End If
	
	   TR_AMT = Grid0.GetCellData("bd_cell1", currentLoopIndex)
	
        loginID = Form.GetSharedData("&USER_ID", false )    
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "PROS_CLS_CODE"  , 0 , "2") '잔액모으기
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "ELFN_ID"        , 0 , loginID)
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "DRNG_BANK_CODE" , 0 , Grid0.GetCellData("bd_cell2", currentLoopIndex))
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "DRNG_BANK_ACNO" , 0 , Grid0.GetCellData("bd_cell3", currentLoopIndex))
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "MNRC_BANK_CODE" , 0 , "287"    ) '입금은행코드 : 메리츠
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "RCVN_BANK_ACNO" , 0 , MNRC_ACNT) '입금계좌
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "TR_AMT"         , 0 , TR_AMT) '입금액
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "RMT_NAME"       , 0 , USER_NAME) '수취인명
        DATAMANAGER.RequestTranData("obtss_opnf_003a")
    
	End If

	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	If szTranID = "obtss_opnf_003a" Then
	
        If currentLoopIndex = 0 Or currentLoopIndex = "0" Then
            RSLT_CODE =                    szErrMsg
        Else
            RSLT_CODE = RSLT_CODE & "★" & szErrMsg
        End If
	
        currentLoopIndex = currentLoopIndex + 1
	
        If currentLoopIndex > 4 Or Grid0.GetCellData("bd_cell0" , currentLoopIndex) = "" Then
            
            For i = 0 To 4 - currentLoopIndex
                RSLT_CODE = RSLT_CODE & "★"
            Next
	    
	        Form.SetSharedData("mbbnk62010_RSLT_CODE" , RSLT_CODE)
	    
            Form.OpenDialog("mbbnk62010_t3" , "" , "")
            Exit Sub
        End If
	
	   TR_AMT = Grid0.GetCellData("bd_cell1", currentLoopIndex)
	
        loginID = Form.GetSharedData("&USER_ID", false )    
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "PROS_CLS_CODE"  , 0 , "2")
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "ELFN_ID"        , 0 , loginID)
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "DRNG_BANK_CODE" , 0 , Grid0.GetCellData("bd_cell2", currentLoopIndex))
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "DRNG_BANK_ACNO" , 0 , Grid0.GetCellData("bd_cell3", currentLoopIndex))
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "MNRC_BANK_CODE" , 0 , "287"    ) '입금은행코드 : 메리츠
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "RCVN_BANK_ACNO" , 0 , MNRC_ACNT) '입금계좌
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "TR_AMT"         , 0 , TR_AMT) '입금금액
        DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "RMT_NAME"       , 0 , USER_NAME) '수취인명
        DATAMANAGER.RequestTranData("obtss_opnf_003a")
    
	End If	
	
End Sub


