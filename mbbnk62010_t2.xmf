'============================================================================
Sub Run() 'v001

    BtnCnfr.enable = False
    BtnCncl.enable = False

    MNRC_ACNT = Left(Account.caption,4) & Mid(Account.caption,6,4) & Mid(Account.caption,11,2)
    
    currentLoopIndex = 0
    
    TR_AMT = Grid0.GetCellData("bd_cell1", currentLoopIndex)
    
    loginID = Form.GetSharedData("&USER_ID", false )    
    DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "PROS_CLS_CODE"  , 0 , "2") '잔액모으기
    DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "ELFN_ID"        , 0 , loginID)
    DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "DRNG_BANK_CODE" , 0 , Grid0.GetCellData("bd_cell2", currentLoopIndex))
    DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "DRNG_BANK_ACNO" , 0 , Grid0.GetCellData("bd_cell3", currentLoopIndex))
    DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "MNRC_BANK_CODE" , 0 , "287"    ) '입금은행코드 : 메리츠
    DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "RCVN_BANK_ACNO" , 0 , MNRC_ACNT) '입금계좌
    DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "TR_AMT"         , 0 , TR_AMT) '입금계좌
    DATAMANAGER.SetDataValue(0 , "obtss_opnf_003a" , "InBlock1" , "RMT_NAME"       , 0 , USER_NAME) '수취인명
    DATAMANAGER.RequestTranData("obtss_opnf_003a")
    
End Sub

