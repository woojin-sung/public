	<SCRIPT_INFO _len="3306" _ulen="3120" >
'============================================================================
' 01. 화 면 명 : 선옵 당일/익일 증거금 당일증거금
' 02. 화면설명 : 선옵 당일/익일 증거금 당일증거금 테이블
' 03. 작    성 : 2016.01.11 ~ 최지희
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************

Dim g_nAccountNumber			'계좌번호
Dim g_nAccountSerialNumber		'일련번호
Dim g_szAccountPassword		'계좌비밀번호
Dim g_szData					'계좌번호★일련번호




'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(g_nAccountNumber, g_nAccountSerialNumber)
	DATAMANAGER.SetDataValue(0,"obtrf_cntg_727r", "InBlock1", "ACNO", 0 , g_nAccountNumber)
	DATAMANAGER.SetDataValue(0,"obtrf_cntg_727r", "InBlock1", "ASNO", 0 , g_nAccountSerialNumber)
	DATAMANAGER.SetDataValue(0,"obtrf_cntg_727r", "InBlock1", "ACNT_PWD", 0 , g_szAccountPassword)
	
	DATAMANAGER.RequestTranData("obtrf_cntg_727r")
End Function




'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' btnDetail_OnClick - 돋보기(상세)버튼 클릭
'============================================================================
Sub btnDetail_OnClick()
	Form.OpenFramePopup("mbtrf35066_p1" , g_szData , sPosInfo)
End Sub


'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	for i=0 to 6
		Table0.SetCellString( i, 1, "" )
		Table0.SetCellString( i, 3, "" )
	next
	
	for j=0 to 2	
		Table1.SetCellString( i, 1, "" )
		Table1.SetCellString( i, 3, "" )
	next

	btnDetail.enable = false	'TR 조회 전 버튼 비활성화

	if sEventName == "TodaySearch" then 

		g_szData = sParam
		Dim szList
		szList = Split(sParam, "★")
		
		if UBOUND(szList) < 1 then
			exit sub
		end if
		g_nAccountNumber = szList(0)
		g_nAccountSerialNumber = szList(1)
		if szList(2) <> "" then
			g_szAccountPassword = szList(2)
		else
			g_szAccountPassword = ""
		end if
		
		TR_Inquiry(g_nAccountNumber, g_nAccountSerialNumber)
	end if
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranData - TR 조회 후 버튼 활성화
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	btnDetail.enable = true
End Sub

	</SCRIPT_INFO>
