'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : PTP종목 경고안내
' 02. 화면설명 : 
' 03. 작    성 : 2022.12.06 KBC
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_nCount
Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
Dim g_szErrMsg			' 경고메세지

g_nCount = 0
g_nIndex = "0"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
Function SendOrder()
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "PTP주문경고" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
    End If    
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	

	g_nIndex				= arrData(0) ' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소, 10:예약매수, 11:예약매도, 12:예약취소)
	g_szErrMsg	 		= arrData(1)	' 경고메세지
	
End Sub

'============================================================================
Sub Form_OnFormInit()	
	If g_nIndex = "0" Then
		lblTitle.bgcolor = "92"
		btnOrder.btnimage = "btn_05.9"
		btnOrder.caption="매수"
		
	ElseIf g_nIndex = "1" Then
		lblTitle.bgcolor = "91"
		btnOrder.btnimage = "btn_06.9"
		btnOrder.caption="매도"
	
	End If	
End Sub

'============================================================================
Sub btnOrder_OnClick()
	SendOrder()
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm( )	
End Sub

'============================================================================
Sub imgClose1_OnClick()
	Form.CloseForm( )
End Sub



	</SCRIPT_INFO>
