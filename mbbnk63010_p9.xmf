		else
			contResultOneY.contInfo.tblInfo.SetCellString(2, 1, FormatNumber(arrTransInfo(5),0).."원" )
		end if
		contResultOneY.contInfo.tblInfo.SetCellString(3, 1, arrTransInfo(6) )
		contResultOneY.contInfo.tblInfo.SetCellString(4, 1, arrTransInfo(7) )

		contOne.visible = "0"
		contResultOneY.visible = "1"
	end if
	
	g_szTransLastStep = "1"
End Sub

'============================================================================
' 이체 완료 세팅 실패
'============================================================================
Sub f_SetResultInfoFail(szResult, szErrMsg)
	if g_nTranIndex > 1 then

	else
		szTransInfo = f_GetTransInfoItem(g_nTransCnt)
		arrTransInfo = Split(szTransInfo, g_szSeparator)

		contResultOneN.lblName.caption = arrTransInfo(3)
		contResultOneN.lblMsg.caption = szErrMsg
		if arrTransInfo(0) == "287" then
			contResultOneN.tblInfo.SetCellString(0, 1, "메리츠증권 "..Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2) )
		else
			contResultOneN.tblInfo.SetCellString(0, 1, arrTransInfo(2).." "..arrTransInfo(1) )
		end if
		contResultOneN.tblInfo.SetCellString(1, 1, arrTransInfo(4) )
		
		contOne.visible = "0"
		contResultOneN.visible = "1"
		
	end if
	g_szTransLastStep = "1"
End Sub

'============================================================================
' 이체 정보 Set
'============================================================================
Sub f_SetTransInfoItem(szData, nIndex)
	if nIndex == 1 then
		g_szTransInfo1 = szData
	elseif nIndex == 2 then
		g_szTransInfo2 = szData
	elseif nIndex == 3 then
		g_szTransInfo3 = szData
	elseif nIndex == 4 then
		g_szTransInfo4 = szData
	elseif nIndex == 5 then
		g_szTransInfo5 = szData
	end if
End Sub

'============================================================================
' 이체 정보 Get
'============================================================================
Function f_GetTransInfoItem(nIndex)
	if nIndex == 1 then
		Return g_szTransInfo1
	elseif nIndex == 2 then
		Return g_szTransInfo2
	elseif nIndex == 3 then
		Return g_szTransInfo3
	elseif nIndex == 4 then
		Return g_szTransInfo4
	elseif nIndex == 5 then
		Return g_szTransInfo5
	end if
End Function

'============================================================================
' 이체 정보 Set 입력금액
' 입금계좌은행코드★입금계좌번호★입금계좌은행명★입금계좌명★출금금액
'============================================================================
Sub f_SetTransInfoAmt()
	szTransInfo = f_GetTransInfoItem(g_nTranIndex)
	arrTransInfo = Split(szTransInfo, g_szSeparator)
	
	szData = arrTransInfo(0)..g_szSeparator..arrTransInfo(1)..g_szSeparator..arrTransInfo(2)..g_szSeparator..arrTransInfo(3)..g_szSeparator..CInt(contAmt.edtAmt.caption)

	f_SetTransInfoItem(szData, g_nTranIndex)
End Sub

'============================================================================
' 이체 정보 Set 수수료
' 입금계좌은행코드★입금계좌번호★입금계좌은행명★입금계좌명★출금금액★수수료
'============================================================================
Sub f_SetTransInfoFee(nFee)
	szTransInfo = f_GetTransInfoItem(g_nTranIndex)

	szData = arrTransInfo(0)..g_szSeparator..arrTransInfo(1)..g_szSeparator..arrTransInfo(2)..g_szSeparator..arrTransInfo(3)..g_szSeparator..CInt(contAmt.edtAmt.caption)..g_szSeparator..nFee

	f_SetTransInfoItem(szData, g_nTranIndex)
End Sub

'============================================================================
' 이체 정보 Set 최종 
' 입금계좌은행코드★입금계좌번호★입금계좌은행명★입금계좌명★출금금액★수수료★내통장표기★받는분통장표기★내계좌여부 (당사)
' 입금계좌은행코드★입금계좌번호★입금계좌은행명★입금계좌명★출금금액★수수료★내통장표기★받는분통장표기★지점코드 (타행)
'============================================================================
Sub f_SetTransInfoLast()
	szTransInfo = f_GetTransInfoItem(g_nTranIndex)
	arrTransInfo = Split(szTransInfo, g_szSeparator)
	
	szMyMemo = ""
	szYourMemo = ""
	
	if g_nTranIndex == 1 then
		szMyMemo = contOne.tblMemo.GetCellString(0, 1)
		szYourMemo = contOne.tblMemo.GetCellString(1, 1)
	elseif g_nTranIndex == 2 then
		szMyMemo = contMany.contTrans.contTrans2.tblTrans0.GetCellString(0, 1)
		szYourMemo = contMany.contTrans.contTrans2.tblTrans0.GetCellString(1, 1)
	elseif g_nTranIndex == 3 then
		szMyMemo = contMany.contTrans.contTrans3.tblTrans0.GetCellString(0, 1)
		szYourMemo = contMany.contTrans.contTrans3.tblTrans0.GetCellString(1, 1)
	elseif g_nTranIndex == 4 then
		szMyMemo = contMany.contTrans.contTrans4.tblTrans0.GetCellString(0, 1)
		szYourMemo = contMany.contTrans.contTrans4.tblTrans0.GetCellString(1, 1)
	elseif g_nTranIndex == 5 then
		szMyMemo = contMany.contTrans.contTrans5.tblTrans0.GetCellString(0, 1)
		szYourMemo = contMany.contTrans.contTrans5.tblTrans0.GetCellString(1, 1)
	end if
	
	if arrTransInfo(0) == "287" then
		szData = szTransInfo..g_szSeparator..szMyMemo..g_szSeparator..szYourMemo..g_szSeparator..g_szSapeYN
	else
		szData = szTransInfo..g_szSeparator..szMyMemo..g_szSeparator..szYourMemo..g_szSeparator..g_szBrcd
	end if

	f_SetTransInfoItem(szData, g_nTranIndex)
End Sub


'============================================================================
' 이체 정보 Set 최종 
' 입금계좌은행코드★입금계좌번호★입금계좌은행명★입금계좌명★출금금액★수수료★내통장표기★받는분통장표기★내계좌여부 (당사)
' 입금계좌은행코드★입금계좌번호★입금계좌은행명★입금계좌명★출금금액★수수료★내통장표기★받는분통장표기★지점코드 (타행)
'============================================================================
Sub f_SetTransInfoMemo(szType, szMemo, nIndex)
	szTransInfo = f_GetTransInfoItem(nIndex)
	arrTransInfo = Split(szTransInfo, g_szSeparator)
	
	szData = ""
	if szType == "My" then
		szData = arrTransInfo(0)..g_szSeparator..arrTransInfo(1)..g_szSeparator..arrTransInfo(2)..g_szSeparator..arrTransInfo(3)..g_szSeparator..arrTransInfo(4)..g_szSeparator..arrTransInfo(5)..g_szSeparator..szMemo..g_szSeparator..arrTransInfo(7)..g_szSeparator..arrTransInfo(8)
	else
		szData = arrTransInfo(0)..g_szSeparator..arrTransInfo(1)..g_szSeparator..arrTransInfo(2)..g_szSeparator..arrTransInfo(3)..g_szSeparator..arrTransInfo(4)..g_szSeparator..arrTransInfo(5)..g_szSeparator..arrTransInfo(6)..g_szSeparator..szMemo..g_szSeparator..arrTransInfo(8)
	end if

	f_SetTransInfoItem(szData, nIndex)
End Sub

'============================================================================
' 이체 정보 Set 결과
' 입금계좌은행코드★입금계좌번호★입금계좌은행명★입금계좌명★출금금액★수수료★내통장표기★받는분통장표기★내계좌여부 (당사)★결과값(YN)★결과메시지★지연이체여부
