Sub f_ResetDataConfirmPage()
	contMany.visible = "0"
	contOne.visible = "0"
	contMany.contTrans.contTrans1.visible = "0"
	contMany.contTrans.contTrans2.visible = "0"
	contMany.contTrans.contTrans3.visible = "0"
	contMany.contTrans.contTrans4.visible = "0"
	contMany.contTrans.contTrans5.visible = "0"
	f_SetDataConfirm()
End Sub

