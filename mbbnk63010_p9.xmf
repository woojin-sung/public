			contResultManyY.contTrans.contTrans5.tblInfo.SetCellString(1, 1, arrTransInfo(4) )
			if arrTransInfo(5) == "0" then
				contResultManyY.contTrans.contTrans5.tblInfo.SetCellString(2, 1, "무료" )
			else
				contResultManyY.contTrans.contTrans5.tblInfo.SetCellString(2, 1, FormatNumber(arrTransInfo(5),0).."원" )
			end if
			contResultManyY.contTrans.contTrans5.tblInfo.SetCellString(3, 1, arrTransInfo(6) )
			contResultManyY.contTrans.contTrans5.tblInfo.SetCellString(4, 1, arrTransInfo(7) )

			contResultManyY.contTrans.contTrans5.top = "728"
