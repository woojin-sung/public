Sub contOne_btnAddTrans_OnClick()
	if g_nTranIndex == 5 then
		Form.MsgBox("알림", "추가이체는 5건까지 가능합니다.", "", 6)
		return
	end if
	
	g_szAddFlag = "1"
	DATAMANAGER.RequestTranData( "obrtp_comn_025r" )

End Sub

