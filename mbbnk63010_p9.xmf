'============================================================================
Sub f_DeleteTransInfoItem(nIndex)
	if nIndex == 5 then
		f_SetTransInfoItem("", 5)
	else
		for i=nIndex+1 to 5
			szData = f_GetTransInfoItem(i)
			f_SetTransInfoItem(szData, i-1)
		next
	end if
End Sub

