Dim g_szACNO
DIm g_szASNO

Dim g_nTranIndex
Dim g_szTransInfo1
Dim g_szTransInfo2
Dim g_szTransInfo3
Dim g_szTransInfo4
Dim g_szTransInfo5

Dim g_szLNKD_BANK_CLS_CODE 
Dim g_szTR_DATE            
Dim g_szOTSD_TR_UNIQ_NO    
Dim g_szTACT_LNKD_ISTU_CODE
Dim g_szTACT_STND_TR_CODE  
Dim g_szLNKD_TLMS_MNNO     
Dim g_szRcvn_iqry_tmnu '수취조회횟수
Dim g_szTact_rpcs_tmnu   '이체조회횟수
Dim g_szBrcd

Dim g_nEasyAcmlAmt'간편이체누적금액
Dim g_nAcmlAmt	'이체누적금액
Dim g_nOneTimeAmt	'1회한도금액
Dim g_nOneDayAmt	'1일한도금액
Dim g_nLimitAmt
DIm g_szMNRC_ACNT_DSGT_YN

Dim g_nVoiceCnt
Dim g_nTransCnt

DIm g_szMnrcAcntYn
Dim g_szSapeYN
Dim g_szPlusUI
DIm g_szGubunCode
Dim g_szTRPass		
