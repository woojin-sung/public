Sub contAmt_btnAll_OnClick()
	szTransInfo = f_GetTransInfoItem(g_nTranIndex)
	arrTransInfo = Split(szTransInfo, g_szSeparator)
	
	contAmt.edtAmt.caption = contAmt.lblAbleAmt.caption - CInt(arrTransInfo(5))
	f_CheckAbleAmt()
End Sub

'============================================================================
Sub f_AppendAmt(szAmt)
	if (CInt(contAmt.edtAmt.caption..szAmt) >= 100000000000) then
		return
	end if

	contAmt.edtAmt.caption = contAmt.edtAmt.caption..szAmt

	f_CheckAbleAmt()
End Sub

'============================================================================
Sub f_AddAmt(szAmt)
	if (CInt(contAmt.edtAmt.caption) + CInt(szAmt) >= 100000000000) then
		return
	end if

	contAmt.edtAmt.caption = CInt(contAmt.edtAmt.caption) + CInt(szAmt)

	f_CheckAbleAmt()
End Sub

'============================================================================
Sub f_CheckAbleAmt()
	if CInt(contAmt.lblAbleAmt.caption) < CInt(contAmt.edtAmt.caption) then
		contAmt.lblOver.visible = "1"
		contAmt.btnConfirm.enable = "0"
	else
		contAmt.lblOver.visible = "0"
		contAmt.btnConfirm.enable = "1"
	end if
End Sub

'============================================================================
Sub contAmt_btnAcnt_OnClick()
	if g_nTranIndex == 1 then
		Form.OpenPopupAnimation("mbbnk63010_p4", "" , "","2")
	end if
End Sub

'============================================================================
Sub contAmt_btnConfirm_OnClick()
	if Trim(contAmt.edtAmt.caption) == "" or Trim(contAmt.edtAmt.caption) == "0" then
		Form.ShowAlert("알림", "이체금액을 입력하십시요.")
		return
	end if
	
	'출금금액이 출금가능금액보다 클 경우
	if CInt(contAmt.lblAbleAmt.caption) < CInt(contAmt.edtAmt.caption) then
		Form.ShowAlert("알림", "출금가능금액이 부족합니다")
		return
	end if

	f_SetTransInfoAmt()
	
	DATAMANAGER.RequestTranData( "obtss_elbs_240r" ) '동일이체 여부 조회
End Sub

'============================================================================
' 이체 확인 전 조건 체크
'============================================================================
Sub f_CheckTrans()

	szTransInfo = f_GetTransInfoItem(g_nTranIndex)
	arrTransInfo = Split(szTransInfo, g_szSeparator)
	
	' 출금계좌와 입금계좌가 같을경우
	if arrTransInfo(1) == g_szACNO..g_szASNO then
		Form.MsgBox("알림", "출금계좌번호와 입금계좌번호가 같습니다.", "", "6")
		return
	end if
	
	' 당사 본인계좌가 아닌경우
	if g_szSapeYN <> "Y" then
		'(1일한도금액-이체누적금액-간편이체누적금액) 보다 이체금액이 크거나
		'1회한도금액, 1일한도금액 보다 클 경우 이체한도초과팝업
		if (g_nOneDayAmt - g_nAcmlAmt - g_nEasyAcmlAmt) < CInt(contAmt.edtAmt.caption) or (g_nOneTimeAmt) < CInt(contAmt.edtAmt.caption) or (g_nOneDayAmt) < CInt(contAmt.edtAmt.caption) then
			szData = (g_nOneDayAmt - g_nAcmlAmt - g_nEasyAcmlAmt)..g_szSeparator..g_nOneTimeAmt..g_szSeparator..g_nOneDayAmt..g_szSeparator..g_nTranIndex
			Form.OpenPopup("mbbnk63010_p7" , szData , "")
			return
		end if
	end if

'	' 입금계좌지정 서비스 신청 계좌인 경우 미지정 계좌로 이체 시 한도 체크
'	if g_nLimitAmt < CInt(contAmt.edtAmt.caption) and g_szMNRC_ACNT_DSGT_YN == "N" then
'		Form.MsgBox("알림", "미지정계좌 1일 이체한도를 초과하였습니다.\n입금계좌지정 서비스 한도를 확인해주세요.", "", "6")
'		return
'	end if
	
	'보이스 피싱 300만원 이상 타사 또는 당사타명의 일경우 체크
	if CInt(contAmt.edtAmt.caption) >= 3000000 then
		if arrTransInfo(0) <> "287" or g_szSapeYN <> "Y" then
			Form.OpenPopup("mbbnk63010_p5" , "" , "")
			return
		end if
	end if
	
	f_SetDataConfirm()
End Sub

'============================================================================
' 이체 확인 페이지 Set
'============================================================================
Sub f_SetDataConfirm()
	if g_nTranIndex > 1 then '다건이체
		szTotalAmt = 0
		szTotalFee = 0
		For i=1 to g_nTranIndex
			szTransInfo = f_GetTransInfoItem(i)
			arrTransInfo = Split(szTransInfo, g_szSeparator)
			szTotalAmt = szTotalAmt + arrTransInfo(4)
			szTotalFee = szTotalFee + arrTransInfo(5)
		Next
		
		contMany.lblTransInfo.caption = "총 "..g_nTranIndex.." 건\n"..FormatNumber(CInt(szTotalAmt),0).."원을 보내시겠어요?"
		
		contMany.tblTrans.SetCellString(0, 1, Left(acntList.total,4).."-"..Right(acntList.total,4).."-"..acntList.sequence)
		if CInt(szTotalFee) == 0 then
			contMany.tblTrans.SetCellString(1, 1, "무료")
		else
			contMany.tblTrans.SetCellString(1, 1, FormatNumber(CInt(szTotalFee),0).."원")
		end if
		
		if g_nTranIndex == 5 then
			szTransInfo = f_GetTransInfoItem(5)
			arrTransInfo = Split(szTransInfo, g_szSeparator)
			
			contMany.contTrans.contTrans5.imgLogo.imgpath = "bank"..arrTransInfo(0)..".png"
			contMany.contTrans.contTrans5.lblName.caption = arrTransInfo(3)
			
			if arrTransInfo(0) == "287" then
				contMany.contTrans.contTrans5.tblTrans.SetCellString(0, 1, Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2))
			else
				contMany.contTrans.contTrans5.tblTrans.SetCellString(0, 1, arrTransInfo(1))
			end if
			
			contMany.contTrans.contTrans5.tblTrans.SetCellString(1, 1, arrTransInfo(4))
			if arrTransInfo(5) == "0" then
				contMany.contTrans.contTrans5.tblTrans.SetCellString(2, 1, "무료")
			else
				contMany.contTrans.contTrans5.tblTrans.SetCellString(2, 1, FormatNumber(CInt(arrTransInfo(5)),0).."원")
			end if

			'내통장에 표기
			if arrTransInfo(6) <> "" and arrTransInfo(6) <> null then
				contMany.contTrans.contTrans5.tblTrans0.SetCellString(0, 1, arrTransInfo(6))
			else
				contMany.contTrans.contTrans5.tblTrans0.SetCellString(0, 1, arrTransInfo(3))
			end if
			'받는분에게 표기
			if arrTransInfo(7) <> "" and arrTransInfo(7) <> null then
				contMany.contTrans.contTrans5.tblTrans0.SetCellString(1, 1, arrTransInfo(7))
			else
				contMany.contTrans.contTrans5.tblTrans0.SetCellString(1, 1, g_szUserNm)
			end if
			
			contMany.contTrans.contTrans5.top = "816"
			contMany.contTrans.contTrans5.visible = "1"
		end if
		
		if g_nTranIndex >= 4 then
			szTransInfo = f_GetTransInfoItem(4)
			arrTransInfo = Split(szTransInfo, g_szSeparator)
			
			contMany.contTrans.contTrans4.imgLogo.imgpath = "bank"..arrTransInfo(0)..".png"
			contMany.contTrans.contTrans4.lblName.caption = arrTransInfo(3)
			
			if arrTransInfo(0) == "287" then
				contMany.contTrans.contTrans4.tblTrans.SetCellString(0, 1, Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2))
			else
				contMany.contTrans.contTrans4.tblTrans.SetCellString(0, 1, arrTransInfo(1))
			end if
			
			contMany.contTrans.contTrans4.tblTrans.SetCellString(1, 1, arrTransInfo(4))
			if arrTransInfo(5) == "0" then
				contMany.contTrans.contTrans4.tblTrans.SetCellString(2, 1, "무료")
			else
				contMany.contTrans.contTrans4.tblTrans.SetCellString(2, 1, FormatNumber(CInt(arrTransInfo(5)),0).."원")
			end if

			'내통장에 표기
			if arrTransInfo(6) <> "" and arrTransInfo(6) <> null then
				contMany.contTrans.contTrans4.tblTrans0.SetCellString(0, 1, arrTransInfo(6))
			else
				contMany.contTrans.contTrans4.tblTrans0.SetCellString(0, 1, arrTransInfo(3))
			end if
			'받는분에게 표기
			if arrTransInfo(7) <> "" and arrTransInfo(7) <> null then
				contMany.contTrans.contTrans4.tblTrans0.SetCellString(1, 1, arrTransInfo(7))
			else
				contMany.contTrans.contTrans4.tblTrans0.SetCellString(1, 1, g_szUserNm)
			end if

			contMany.contTrans.contTrans4.top = "612"
			contMany.contTrans.contTrans4.visible = "1"
		end if
		
		if g_nTranIndex >= 3 then
			szTransInfo = f_GetTransInfoItem(3)
			arrTransInfo = Split(szTransInfo, g_szSeparator)
			
			contMany.contTrans.contTrans3.imgLogo.imgpath = "bank"..arrTransInfo(0)..".png"
			contMany.contTrans.contTrans3.lblName.caption = arrTransInfo(3)
			
			if arrTransInfo(0) == "287" then
				contMany.contTrans.contTrans3.tblTrans.SetCellString(0, 1, Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2))
			else
				contMany.contTrans.contTrans3.tblTrans.SetCellString(0, 1, arrTransInfo(1))
			end if
			
			contMany.contTrans.contTrans3.tblTrans.SetCellString(1, 1, arrTransInfo(4))
			if arrTransInfo(5) == "0" then
				contMany.contTrans.contTrans3.tblTrans.SetCellString(2, 1, "무료")
			else
				contMany.contTrans.contTrans3.tblTrans.SetCellString(2, 1, FormatNumber(CInt(arrTransInfo(5)),0).."원")
			end if

			'내통장에 표기
			if arrTransInfo(6) <> "" and arrTransInfo(6) <> null then
				contMany.contTrans.contTrans3.tblTrans0.SetCellString(0, 1, arrTransInfo(6))
			else
				contMany.contTrans.contTrans3.tblTrans0.SetCellString(0, 1, arrTransInfo(3))
			end if
			'받는분에게 표기
			if arrTransInfo(7) <> "" and arrTransInfo(7) <> null then
				contMany.contTrans.contTrans3.tblTrans0.SetCellString(1, 1, arrTransInfo(7))
			else
				contMany.contTrans.contTrans3.tblTrans0.SetCellString(1, 1, g_szUserNm)
			end if
			
			contMany.contTrans.contTrans3.top = "408"
			contMany.contTrans.contTrans3.visible = "1"
		end if
		
		if g_nTranIndex >= 2 then
			szTransInfo = f_GetTransInfoItem(2)
			arrTransInfo = Split(szTransInfo, g_szSeparator)
			
			contMany.contTrans.contTrans2.imgLogo.imgpath = "bank"..arrTransInfo(0)..".png"
			contMany.contTrans.contTrans2.lblName.caption = arrTransInfo(3)
			
			if arrTransInfo(0) == "287" then
				contMany.contTrans.contTrans2.tblTrans.SetCellString(0, 1, Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2))
			else
				contMany.contTrans.contTrans2.tblTrans.SetCellString(0, 1, arrTransInfo(1))
			end if
			
			contMany.contTrans.contTrans2.tblTrans.SetCellString(1, 1, arrTransInfo(4))
			if arrTransInfo(5) == "0" then
				contMany.contTrans.contTrans2.tblTrans.SetCellString(2, 1, "무료")
			else
				contMany.contTrans.contTrans2.tblTrans.SetCellString(2, 1, FormatNumber(CInt(arrTransInfo(5)),0).."원")
			end if

			'내통장에 표기
			if arrTransInfo(6) <> "" and arrTransInfo(6) <> null then
				contMany.contTrans.contTrans2.tblTrans0.SetCellString(0, 1, arrTransInfo(6))
			else
				contMany.contTrans.contTrans2.tblTrans0.SetCellString(0, 1, arrTransInfo(3))
			end if
			'받는분에게 표기
			if arrTransInfo(7) <> "" and arrTransInfo(7) <> null then
				contMany.contTrans.contTrans2.tblTrans0.SetCellString(1, 1, arrTransInfo(7))
			else
				contMany.contTrans.contTrans2.tblTrans0.SetCellString(1, 1, g_szUserNm)
			end if
			
			contMany.contTrans.contTrans2.top = "204"
			contMany.contTrans.contTrans2.visible = "1"
		end if
		
		if g_nTranIndex >= 1 then
			szTransInfo = f_GetTransInfoItem(1)
			arrTransInfo = Split(szTransInfo, g_szSeparator)
			
			contMany.contTrans.contTrans1.imgLogo.imgpath = "bank"..arrTransInfo(0)..".png"
			contMany.contTrans.contTrans1.lblName.caption = arrTransInfo(3)
			
			if arrTransInfo(0) == "287" then
				contMany.contTrans.contTrans1.tblTrans.SetCellString(0, 1, Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2))
			else
				contMany.contTrans.contTrans1.tblTrans.SetCellString(0, 1, arrTransInfo(1))
			end if
			
			contMany.contTrans.contTrans1.tblTrans.SetCellString(1, 1, arrTransInfo(4))
			if arrTransInfo(5) == "0" then
				contMany.contTrans.contTrans1.tblTrans.SetCellString(2, 1, "무료")
			else
				contMany.contTrans.contTrans1.tblTrans.SetCellString(2, 1, FormatNumber(CInt(arrTransInfo(5)),0).."원")
			end if
			
			contMany.contTrans.contTrans1.tblTrans0.SetCellString(0, 1, arrTransInfo(6))
			contMany.contTrans.contTrans1.tblTrans0.SetCellString(1, 1, arrTransInfo(7))

			contMany.contTrans.contTrans1.visible = "1"
		end if

		contAmt.visible = "0"
		contMany.visible = "1"
		lblLimit.visible = "0"
		lblCancel.visible = "1"
		lblCancel.caption = "전체취소"
		
		contMany.contTrans.SetScrollAutoSize()
		
	else
		szTransInfo = f_GetTransInfoItem(g_nTranIndex)
		arrTransInfo = Split(szTransInfo, g_szSeparator)

		contOne.tblTrans.SetCellString(0, 1, Left(g_szACNO,4).."-"..Right(g_szACNO,4).."-"..g_szASNO)
		if arrTransInfo(5) == "0" then
			contOne.tblTrans.SetCellString(1, 1, "무료")
		else
			contOne.tblTrans.SetCellString(1, 1, FormatNumber(CInt(arrTransInfo(5)),0).."원")
		end if

		contOne.tblMemo.SetCellString(0, 1, arrTransInfo(3)) '내통장에 표기
		contOne.tblMemo.SetCellString(1, 1, g_szUserNm) '받는분에게 표기
		
		contOne.lblTransInfo.caption = arrTransInfo(3).." 님에게\n"..FormatNumber(CInt(arrTransInfo(4)),0).."원을 보내시겠어요?"
		contOne.imgLogo.imgpath = "bank"..arrTransInfo(0)..".png"
		
		if arrTransInfo(0) == "287" then
			contOne.lblBankName.caption = "메리츠증권 "..Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2)
		else
			contOne.lblBankName.caption = arrTransInfo(2).." "..arrTransInfo(1)
		end if
		

		contAmt.visible = "0"
		contOne.visible = "1"
		lblLimit.visible = "0"
		lblCancel.visible = "1"
	end if
End Sub

