'============================================================================
Function f_CheckOftenAcnt(szAcnt)
	nCnt = CInt(grdOften.rowcount)
	
	for i=0 to nCnt-1
		szCheckAcnt = grdOften.GetCellData( "bd_acno", i )
		if szCheckAcnt == szAcnt then
			return true
		end if
	next
	
	return false
End Function

