'============================================================================
' OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	imgBack.setMaintainingRatio("1")
	contOne.imgLogo.setMaintainingRatio("1")
	contResultOneY.contInfo.imgStar.setMaintainingRatio("1")
	contResultOneY.contInfo.imgShare.setMaintainingRatio("1")
	contResultManyY.contTrans.contTrans1.imgStar.setMaintainingRatio("1")
	contResultManyY.contTrans.contTrans1.imgShare.setMaintainingRatio("1")
	contResultManyY.contTrans.contTrans2.imgStar.setMaintainingRatio("1")
	contResultManyY.contTrans.contTrans2.imgShare.setMaintainingRatio("1")
	contResultManyY.contTrans.contTrans3.imgStar.setMaintainingRatio("1")
	contResultManyY.contTrans.contTrans3.imgShare.setMaintainingRatio("1")
	contResultManyY.contTrans.contTrans4.imgStar.setMaintainingRatio("1")
	contResultManyY.contTrans.contTrans4.imgShare.setMaintainingRatio("1")
	contResultManyY.contTrans.contTrans5.imgStar.setMaintainingRatio("1")
	contResultManyY.contTrans.contTrans5.imgShare.setMaintainingRatio("1")
	contMany.contTrans.contTrans1.imgLogo.setMaintainingRatio("1")
	contMany.contTrans.contTrans2.imgLogo.setMaintainingRatio("1")
	contMany.contTrans.contTrans3.imgLogo.setMaintainingRatio("1")
	contMany.contTrans.contTrans4.imgLogo.setMaintainingRatio("1")
	contMany.contTrans.contTrans5.imgLogo.setMaintainingRatio("1")
End Sub

'============================================================================
' OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szACNO = ""
	g_szASNO = ""
	g_nVoiceCnt = 1
	g_nTransCnt = 1
	g_szSeparator = "★"
	g_szSapeYN = ""
	g_szBrcd = ""
	g_szUseSimple = ""
	g_szTransLastStep = "0"
	g_szRcvn_iqry_tmnu = 0
	g_szTact_rpcs_tmnu = 0
	g_szYourMemo = ""
	g_szAddFlag = "0"
	g_szUserNm = Form.GetSharedData("&USER_NAME", false) '고객명
	g_szUserID = Form.GetSharedData("&USER_ID", false) '고객아이디
	g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
	g_szPoupText = ""
	
	szData = Form.GetOpenLinkData()
	
	if szData <> "" and szData <> null then
		arrTransInfo = Split(szData, "♥")
		g_szUseSimple = arrTransInfo(0)
		g_nTranIndex = CInt(arrTransInfo(1))
		g_szTransInfo1 = arrTransInfo(2)
		g_szTransInfo2 = arrTransInfo(3)
		g_szTransInfo3 = arrTransInfo(4)
		g_szTransInfo4 = arrTransInfo(5)
		g_szTransInfo5 = arrTransInfo(6)

		DATAMANAGER.RequestTranData( "obacp_comm_064r" )
	end if
End Sub

'============================================================================
' OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbbnk63010_p4" then
		arrAcntInfo = Split(sRet, g_szSeparator)
		g_szACNO = Left(arrAcntInfo(0),8)
		g_szASNO = Right(arrAcntInfo(0),2)
'		contAmt.lblAbleAmt.caption = arrAcntInfo(2)
		DATAMANAGER.RequestTranData( "obrtp_drab_001r" )
		f_SetAccountText(arrAcntInfo(1))
		f_CheckAbleAmt()
		
	elseif sKeyName == "mbbnk63010_p5" then
		if sRet == "ok" then
			DATAMANAGER.RequestTranData( "obtss_comm_502a" )
		else
			f_SetDataConfirm()
		end if
	elseif sKeyName == "mbbnk63010_p6" then
		Form.SendReturnToParent("mbbnk63010_p9" , "AllReset")
		Form.CloseForm()
		
	elseif sKeyName == "CORRECT_PWD" then
		szData = Split(sRet, g_szSeparator)
		if szData(0) <> "" then
			g_szPwd = szData(0)
	
			DATAMANAGER.RequestTranData( "obrtp_comn_025r" )
		end if
	
	elseif sKeyName == "mhetc90060_p8" then	'추가인증 
		if sRet == "ok" then	'추가인증성공
			Select Case g_szGubunCode
				Case "1"
					Form.ShowAlert( "알림", "부가정보만 존재할경우 처리가 불가능합니다.")
				Case "2"	
					Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				Case "9"
					Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
				Case "0"
					'공인인증서_보안카드화면
					Form.OpenPopupAnimation("seccardcheckpopup", " " , "","2")
				Case "3"
					'공인인증서_일반/스마트OTP
					Form.OpenPopupAnimation("otpcheckpopup", " " , "","2")
				Case "4"
					'공인인증서_mOTP
					Form.OpenPopupAnimation("otpcheckpopup", " " , "","2")
			End Select
		end if

	elseif sKeyName == "보안카드" or sKeyName == "OTP" then
		if sRet == "Success" then
			f_CheckBioCert()
		end if

	elseif sKeyName == "mhetc90060_p5"or sKeyName == "mhetc90060_px" then
		szData = Split(sRet, ";")
		if szData(0) == "ok" or sRet == "ok" Then
			f_RequestTransfer()
		end if
		
	elseif sKeyName == "POPUP_TEXT" then
		if g_szPoupText == "MyMemoOne" then
			contOne.tblMemo.SetCellString(0, 1, Trim(sRet))

		elseif g_szPoupText == "MyMemoMany1" then
			contMany.contTrans.contTrans1.tblTrans0.SetCellString(0, 1, Trim(sRet))
			if g_nTranIndex <> 1 then
				f_SetTransInfoMemo("My", Trim(sRet), 1)
			end if

		elseif g_szPoupText == "MyMemoMany2" then
			contMany.contTrans.contTrans2.tblTrans0.SetCellString(0, 1, Trim(sRet))
			if g_nTranIndex <> 2 then
				f_SetTransInfoMemo("My", Trim(sRet), 2)
			end if
			
		elseif g_szPoupText == "MyMemoMany3" then
			contMany.contTrans.contTrans3.tblTrans0.SetCellString(0, 1, Trim(sRet))
			if g_nTranIndex <> 3 then
				f_SetTransInfoMemo("My", Trim(sRet), 3)
			end if
			
		elseif g_szPoupText == "MyMemoMany4" then
			contMany.contTrans.contTrans4.tblTrans0.SetCellString(0, 1, Trim(sRet))
			if g_nTranIndex <> 4 then
				f_SetTransInfoMemo("My", Trim(sRet), 4)
			end if
			
		elseif g_szPoupText == "MyMemoMany5" then
			contMany.contTrans.contTrans5.tblTrans0.SetCellString(0, 1, Trim(sRet))
			if g_nTranIndex <> 5 then
				f_SetTransInfoMemo("My", Trim(sRet), 5)
			end if
			
		elseif g_szPoupText == "YourMemoOne" or g_szPoupText == "YourMemoMany1" or g_szPoupText == "YourMemoMany2" or g_szPoupText == "YourMemoMany3" or g_szPoupText == "YourMemoMany4" or g_szPoupText == "YourMemoMany5" then
			f_CheckFDS(sRet)
			
		end if
		
	end if
End Sub

'============================================================================
' OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "isReset" then
		if sRet == "ok" then
			Form.SendReturnToParent("mbbnk63010_p9" , "AllReset")
			Form.CloseForm()
		end if
	elseif sKeyName == "EXCEPT_TRANS" then
		if g_szPoupText == "YourMemoMany1" then
			g_nTranIndex = g_nTranIndex - 1
			f_DeleteTransInfoItem(1)
			f_ResetDataConfirmPage()
		elseif g_szPoupText == "YourMemoMany2" then
			g_nTranIndex = g_nTranIndex - 1
			f_DeleteTransInfoItem(2)
			f_ResetDataConfirmPage()
		elseif g_szPoupText == "YourMemoMany3" then
			g_nTranIndex = g_nTranIndex - 1
			f_DeleteTransInfoItem(3)
			f_ResetDataConfirmPage()
		elseif g_szPoupText == "YourMemoMany4" then
			g_nTranIndex = g_nTranIndex - 1
			f_DeleteTransInfoItem(4)
			f_ResetDataConfirmPage()
		elseif g_szPoupText == "YourMemoMany5" then
			g_nTranIndex = g_nTranIndex - 1
			f_DeleteTransInfoItem(5)
			f_ResetDataConfirmPage()
		end if
		
	elseif sKeyName == "SAME_TRANS" then
		if sRet == "ok" then
			g_szRcvn_iqry_tmnu = 0
			DATAMANAGER.RequestTranData( "obtss_elbs_121r" ) '타행이체 수취조회 전문발송
		end if
		
	end if
End Sub

'============================================================================
' OnTimerEvent
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
     '수취조회
	if trim(sTimerID) == "1" then
		Form.SetTimerEvent2(1,0,0)
		
		DATAMANAGER.RequestTranData( "obtss_elbs_221r" )

     '타행이체 실행
	elseif trim(sTimerID) == "2" then
		Form.SetTimerEvent2(2,0,0)
		
		DATAMANAGER.RequestTranData( "obtss_elbs_231r" )
		
	elseif trim(sTimerID) == "9999" then 'remove
		Form.removeWaitCursor()
		Form.SetTimerEvent(9999,0,1)
		
	end if

End Sub

'============================================================================
' OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	'출금계좌번호조회
	if szTranID = "obacp_comm_064r" then
		szACNO = acntList.total
		szASNO = acntList.sequence
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ELFN_ID" , 0 , g_szUserID)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO" , 0 , szACNO)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ASNO" , 0 , szASNO)
		
	'자주쓰는계좌 조회
	elseif szTranID == "obrtp_tact_002r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ONCO_OTCO_CLS_CODE" , 0 , "0" ) '자사타사구분코드 0모두, 1당사, 2타사
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO" , 0 , g_szACNO ) '계좌번호
		
	'출금가능금액조회
	elseif szTranID == "obrtp_drab_001r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO" , 0 , g_szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ASNO" , 0 , g_szASNO )

	'이체누적금액조회
	elseif szTranID == "obrtp_comn_017r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0, g_szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCPY_DATE", 0, Form.GetSharedData("&BIZ_DT" , false) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ODER_CHAN_TYPE_CLS_CODE", 0, "020" )

	'이체한도조회
	elseif szTranID == "obrtp_comn_018r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0, g_szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TACT_CLS_CODE", 0, "03" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ODER_CHAN_TYPE_CLS_CODE", 0, "020" )

	'보이스피싱 피해예방 로그생성
	elseif szTranID == "obtss_comm_502a" then
		szTransInfo = f_GetTransInfoItem(g_nVoiceCnt)
		arrTransInfo = Split(szTransInfo, g_szSeparator)
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DRNG_ACNO"     , 0,  g_szACNO      			) 
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DRNG_ASNO"     , 0,  g_szASNO				)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFT_BANK_CODE", 0,  arrTransInfo(0)        )
		if Trim(arrTransInfo(0)) == "287" then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_ACNO"  , 0,  Left (arrTransInfo(1), 8)  )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_ASNO"  , 0,  Right(arrTransInfo(1), 2)  )
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_ACNO"  , 0,  arrTransInfo(1)      )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_ASNO"  , 0,  ""					)
		end if
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RMT_NAME"      , 0,  arrTransInfo(3)       )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CRCD"          , 0,  "KRW"                 )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CHECK_AMT"     , 0,  0                     )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FRCR_TR_AMT"   , 0,  arrTransInfo(4)       )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PRTR_DTL_CNTT" , 0,  "MTS다건이체"         )
       
	'타행이체 수취조회 전문발송 ( 당행도 가능 )
	elseif szTranID == "obtss_elbs_121r" then
		szTransInfo = f_GetTransInfoItem(g_nTranIndex)
		arrTransInfo = Split(szTransInfo, g_szSeparator)
		
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "MNRC_BANK_CODE"		, 0 , arrTransInfo(0)	) '입금은행코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "JOB_TRNO"			, 0 , "031"			) '작업단말번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "MNRC_ACNO"			, 0 , arrTransInfo(1)	) '입금계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "TR_AMT"			, 0 , arrTransInfo(4)	) '거래금액
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "DRNG_ACNO"			, 0 , g_szACNO		) '출금계좌번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNT_PROD_CLS_CODE" , 0 , g_szASNO		) '계좌상품구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "PWD"				, 0 , ""				) '비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "RMRK"				, 0 , "N"			) '비고  ( N:비밀번호 스킵 )
		
		Form.addWaitCursor()
		
	'타행이체 수취조회 응답수신 ( 타행만 호출 )
	elseif szTranID == "obtss_elbs_221r" then
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "LNKD_BANK_CLS_CODE" , 0, g_szLNKD_BANK_CLS_CODE  )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TR_DATE"            , 0, g_szTR_DATE             )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "OTSD_TR_UNIQ_NO"    , 0, g_szOTSD_TR_UNIQ_NO     )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TACT_LNKD_ISTU_CODE", 0, g_szTACT_LNKD_ISTU_CODE )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TACT_STND_TR_CODE"  , 0, g_szTACT_STND_TR_CODE   )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "LNKD_TLMS_MNNO"     , 0, g_szLNKD_TLMS_MNNO      )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "RPCS_TMNU"          , 0, g_szRcvn_iqry_tmnu      )
		
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "DRNG_ACNO"          , 0, g_szACNO      		   ) '계좌번호
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "ACNT_PROD_CLS_CODE" , 0, g_szASNO			   ) '계좌일련번호
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "PWD"                , 0, ""				   ) '비밀번호
	
	'당사 본인명의 계좌여부 조회
	elseif szTranID == "obrtp_comn_019r" then	
		szTransInfo = f_GetTransInfoItem(g_nTranIndex)
		arrTransInfo = Split(szTransInfo, g_szSeparator)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" 		, 0, g_szACNO					) '계좌번호(From)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" 		, 0, g_szASNO					) '계좌일련번호(From)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFT_ACNO" 	, 0, Left(arrTransInfo(1),8)	) '계좌번호(To)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFT_ASNO" 	, 0, Right(arrTransInfo(1),2)	) '계좌일련번호(To)

	'동일이체 여부 조회
	elseif szTranID == "obtss_elbs_240r" then
		szTransInfo = f_GetTransInfoItem(g_nTranIndex)
		arrTransInfo = Split(szTransInfo, g_szSeparator)
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO"		, 0 , g_szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ASNO"		, 0 , g_szASNO )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "BANK_CODE"	, 0 , arrTransInfo(0) )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "MNRC_ACNO"	, 0 , arrTransInfo(1) )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "TR_AMT"	, 0 , arrTransInfo(4) )
		
	'수취인 통장문구 체크 (FDS)
	elseif szTranID == "obrtp_comn_025r" then
		szMemo = ""
		if g_nIndex == 1 then
			szMemo = contOne.tblMemo.GetCellString(1, 1)
		elseif g_nIndex == 2 then
			szMemo = contMany.contTrans2.tblTrans0.GetCellString(1, 1)
		elseif g_nIndex == 3 then
			szMemo = contMany.contTrans3.tblTrans0.GetCellString(1, 1)
		elseif g_nIndex == 4 then
			szMemo = contMany.contTrans4.tblTrans0.GetCellString(1, 1)
		elseif g_nIndex == 5 then
			szMemo = contMany.contTrans5.tblTrans0.GetCellString(1, 1)
		end if
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"   , 0 , g_szACNO)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"   , 0 , g_szASNO)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TR_EXPL", 0 , szMemo )
	
	'수취인 통장문구 체크 (FDS) 받는분 메모 변경시
	elseif szTranID == "obrtp_comn_025r_1" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"   , 0 , g_szACNO)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO"   , 0 , g_szASNO)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TR_EXPL", 0 , g_szYourMemo )
		
	'전자금융사기예방 고객조회
	elseif szTranID == "obcsb_oimf_638r_1" then	
		szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID	
       
		'16-03-08  Input값 수정 MAC주소 -> DeviceID
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID" , 0 , szUserId)	'사용자ID
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID())	'UI단말식별키

		if g_szCertUserType = "1" THEN
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "201")	'201 SPIN 로그인 이체
		elseif g_szCertUserType = "3" THEN
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "203")	'203 바이오 로그인 이체
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "200")'이체	'기본 '200'  등록 '400'
		end if
		
		if g_nTranIndex > 1 then
			for i=0 to CInt(g_nTranIndex)-1 
				szTransInfo = f_GetTransInfoItem(i+1)
				arrTransInfo = Split(szTransInfo, g_szSeparator)

				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "DRNG_ACNO" , i, g_szACNO )
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "DRNG_ASNO", i, g_szASNO )
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "MNRC_BANK_CODE", i , arrTransInfo(0))
				if arrTransInfo(0) == "287" then
					DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "TACT_CLS_CODE", i ,"01")'대체출금
					DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "MNRC_ACNO", i, Left(arrTransInfo(1), 8))
					DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "MNRC_ASNO", i, Right(arrTransInfo(1), 2))
				else
					DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "TACT_CLS_CODE", i ,"03")'이체출금
					DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "MNRC_ACNO", i, arrTransInfo(1))
					DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "MNRC_ASNO", i, "")
				end if
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "TACT_AMT" , i, arrTransInfo(4))
			next
		else
			szTransInfo = f_GetTransInfoItem(g_nTranIndex)
			arrTransInfo = Split(szTransInfo, g_szSeparator)
			
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "DRNG_ACNO", 0, g_szACNO )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "DRNG_ASNO", 0, g_szASNO )
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "MNRC_BANK_CODE", 0 , arrTransInfo(0))
			if arrTransInfo(0) == "287" then
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "TACT_CLS_CODE", 0 ,"01")'대체출금
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "MNRC_ACNO", 0, Left(arrTransInfo(1), 8))
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "MNRC_ASNO", 0, Right(arrTransInfo(1), 2))
			else
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "TACT_CLS_CODE", 0 ,"03")'이체출금
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "MNRC_ACNO", 0, arrTransInfo(1))
				DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "MNRC_ASNO", 0, "")
			end if
	    
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock2", "TACT_AMT" , 0, arrTransInfo(4))
		end if
		
	'당행 이체 실행
	elseif szTranID == "obrtd_drng_004a" then
		szTransInfo = f_GetTransInfoItem(g_nTransCnt)
		arrTransInfo = Split(szTransInfo, g_szSeparator)
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO" , 		0, g_szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO" , 		0, g_szASNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PWD", 		0, g_szPwd )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "AMDR" , 		0, arrTransInfo(4) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CASH_DRNG_AMT", 	0, arrTransInfo(4) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RSEV_YN" , 		0, "N" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCPY_DATE", 	0, Form.GetSharedData("&BIZ_DT" , false) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "SMCD" , 		0, "003020")
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TACT_CLS_CODE", 	0, "01" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TRMD_CLS_CODE", 	0, "17" )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TACT_ACNO" , 	0, Left(arrTransInfo(1),8))
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TACT_ASNO" , 	0, Right(arrTransInfo(1),2) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TR_EXPL", 		0, arrTransInfo(6) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFT_TR_EXPL" ,	0, arrTransInfo(7) )

		'내계좌 일때
		If arrTransInfo(8) == "Y" Then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BNKB_GRP_NO" ,	0, g_szCertUserType & "N" )
		else
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BNKB_GRP_NO" ,	0, g_szCertUserType & g_szMdiaSkipYn )
		end if
		
	'타행 이체 실행 접수
	elseif szTranID == "obtss_elbs_131u" then
		szTransInfo = f_GetTransInfoItem(g_nTransCnt)
		arrTransInfo = Split(szTransInfo, g_szSeparator)

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_BANK_CODE" ,		0, arrTransInfo(0))
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "JOB_TRNO" ,				0, "031" )'단말
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MNRC_ACNO" ,			0, arrTransInfo(1) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "TR_AMT",				0, arrTransInfo(4))
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DRNG_ACNO" ,			0, g_szACNO)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNT_PROD_CLS_CODE",		0, g_szASNO)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD",					0, g_szPwd )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RMT_NAME",				0, arrTransInfo(3) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FEE" ,					0, arrTransInfo(5) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "STDL_CNFT_BRCD",			0, arrTransInfo(8) )'지점코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "DRNG_ACNT_BNKB_EXRS_CNTT",	0, arrTransInfo(6) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PMPP_INFO_CNTT" ,		0, arrTransInfo(7) )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RMRK" ,				0, g_szCertUserType & g_szMdiaSkipYn )

	'타행 이체 실행 수신
	elseif szTranID == "obtss_elbs_231r" then
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "LNKD_BANK_CLS_CODE" , 0, g_szLNKD_BANK_CLS_CODE)
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TR_DATE"            , 0, g_szTR_DATE)
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "OTSD_TR_UNIQ_NO"    , 0, g_szOTSD_TR_UNIQ_NO)
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TACT_LNKD_ISTU_CODE", 0, g_szTACT_LNKD_ISTU_CODE)
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TACT_STND_TR_CODE"  , 0, g_szTACT_STND_TR_CODE)
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "LNKD_TLMS_MNNO"     , 0, g_szLNKD_TLMS_MNNO)
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "RPCS_TMNU"          , 0, g_szTact_rpcs_tmnu )
		
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "DRNG_ACNO"          , 0, g_szACNO ) '계좌번호
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "ACNT_PROD_CLS_CODE" , 0, g_szASNO ) '계좌일련번호
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "PWD"                , 0, g_szPwd) '비밀번호

	'이체 완료 후 출금가능금액조회
	elseif szTranID == "obrtp_drab_001r_1" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO" , 0 , g_szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ASNO" , 0 , g_szASNO )
		
	end if
End Sub

'============================================================================
' OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'출금계좌번호조회
	if szTranID = "obacp_comm_064r" then
		nCnt = CInt(DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1"))
		if nCnt > 0 then
			Dim szPRNM
			szPRNM = ""
			
			szAcntInfo = Form.GetSharedData("63010_ACNT_INFO" , true)
			if szAcntInfo <> null and szAcntInfo <> "" then
				arrAcntInfo = Split(szAcntInfo, g_szSeparator)
				
				for i=0 to nCnt - 1
					szACNO = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "ACNO" , i)
					szASNO = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "ASNO" , i)
					szPRNM = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "PRNM" , i)

					if arrAcntInfo(0) == szACNO and arrAcntInfo(1) == szASNO then
						g_szACNO = szACNO
						g_szASNO = szASNO
						contAmt.imgArrow.visible = "0"
					end if
				next
			else
				g_szACNO = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "ACNO" , 0)
				g_szASNO = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "ASNO" , 0)
				szPRNM = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "PRNM" , 0)
			end if
			
			f_SetAccountText(szPRNM)
			DATAMANAGER.RequestTranData( "obrtp_drab_001r" )
			DATAMANAGER.RequestTranData( "obrtp_tact_002r" )
		end if
		
	'자주쓰는계좌 조회
	elseif szTranID == "obrtp_tact_002r" then
		nCnt = grdOften.rowcount
		
		For i=0 to nCnt-1
			szBankName = grdOften.GetCellData( "bd_bankname", i)
			szAcno = grdOften.GetCellData( "bd_acno", i)
			
			szBankAcnm = grdOften.GetCellData( "bd_bankacnm", i)
			
			szCnftAcnm = grdOften.GetCellData( "bd_cnftacnm", i)
			szCnftAcno = grdOften.GetCellData( "bd_cnftacno", i)
			szCnftAsno = grdOften.GetCellData( "bd_cnftasno", i)

			szBankCode = grdOften.GetCellData( "bd_code", i)
			
			if szBankCode == "" or szBankCode == "287" then
				grdOften.SetCellData( "bd_bank", i, szBankName .. " " .. szCnftAcno..szCnftAsno)
				grdOften.SetCellData( "bd_name", i, szCnftAcnm)
				grdOften.SetCellData( "bd_acno", i, szCnftAcno..szCnftAsno)
			else
				grdOften.SetCellData( "bd_bank", i, szBankName .. " " .. szAcno)
				grdOften.SetCellData( "bd_name", i, szBankAcnm)
			end if
			
			grdOften.SetCellData( "bd_logo", i, "bank"..szBankCode..".png")
			
		Next
		
	'출금가능금액조회
	elseif szTranID == "obrtp_drab_001r" then
		DATAMANAGER.RequestTranData( "obrtp_comn_017r" )
		
	'이체누적금액조회
	elseif szTranID == "obrtp_comn_017r" then
		g_nAcmlAmt = CDbl( DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "TR_AMT", 0 )) '이체누적금액 
		g_nEasyAcmlAmt = CDbl( DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "EASY_TACT_ACML_AMT", 0 )) '간편이체누적금액

		DATAMANAGER.RequestTranData( "obrtp_comn_018r" )

	'이체한도조회
	elseif szTranID == "obrtp_comn_018r" then
		g_nOneTimeAmt = CDbl( DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "T1_TACT_LIMT_AMT", 0 )) '1회한도금액
		g_nOneDayAmt  = CDbl( DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "D1_TACT_LIMT_AMT", 0 )) '1일한도금액
		g_szMnrcAcntYn  = DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "MNRC_ACNT_DSGT_YN", 0 ) '입금계좌지정여부
		g_nLimitAmt  = CDbl( DATAMANAGER.GetDataValue (0, szTranID, "OutBlock1", "EXLS_ACNT_TACT_LIMT_AMT", 0 )) '제외계좌이체한도금액

	'보이스피싱 피해예방 로그생성
	elseif szTranID == "obtss_comm_502a" then
		if g_nTranIndex > g_nVoiceCnt then
			g_nVoiceCnt = g_nVoiceCnt + 1
			DATAMANAGER.RequestTranData( "obtss_comm_502a" )
		else
			Form.OpenPopup("mbbnk63010_p6" , "" , "")
		end if

	'타행이체 수취조회 전문발송
	elseif szTranID == "obtss_elbs_121r" then
	    if DATAMANAGER.GetDataMsgCode( szTranID ) == "6617" then  '처리 대기중입니다.
			g_szLNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_BANK_CLS_CODE" , 0 )
			g_szTR_DATE             = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TR_DATE"            , 0 )
			g_szOTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "OTSD_TR_UNIQ_NO"    , 0 )
			g_szTACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_LNKD_ISTU_CODE", 0 )
			g_szTACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_STND_TR_CODE"  , 0 )
			g_szLNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_TLMS_MNNO"     , 0 )

			Form.SetTimerEvent2(1,1,0.5) '처음은 0.5초 후 조회
			g_szMNRC_ACNT_DSGT_YN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "MNRC_ACNT_DSGT_YN", 0) '입금계좌지정여부
			exit sub
		else
			szTransInfo = f_GetTransInfoItem(g_nTranIndex)
			arrTransInfo = Split(szTransInfo, g_szSeparator)
			
			if arrTransInfo(0) == "287" then
				szDELY_TACT_CLSN_YN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "DELY_TACT_CLSN_YN", 0)
				if szDELY_TACT_CLSN_YN == "Y" then
					Form.MsgBox("알림", "지연이체 가능시간이 아닙니다.", "", 6)
					return
				end if
				f_SetTransInfoFee(0)
				
				DATAMANAGER.RequestTranData( "obrtp_comn_019r" ) '당사 본인명의 계좌여부 조회
			end if
			Form.SetTimerEvent(9999, 1, 1)
			g_szMNRC_ACNT_DSGT_YN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "MNRC_ACNT_DSGT_YN", 0) '입금계좌지정여부
		end if
		
	'타행이체 수취조회 응답수신	
	elseif szTranID == "obtss_elbs_221r" then
		if DATAMANAGER.GetDataMsgCode( szTranID ) == "6617" then  '처리 대기중입니다.
			g_szLNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_BANK_CLS_CODE" , 0 )
			g_szTR_DATE             = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TR_DATE"            , 0 )
			g_szOTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "OTSD_TR_UNIQ_NO"    , 0 )
			g_szTACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_LNKD_ISTU_CODE", 0 )
			g_szTACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_STND_TR_CODE"  , 0 )
			g_szLNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_TLMS_MNNO"     , 0 )
		    
		    	g_szRcvn_iqry_tmnu = g_szRcvn_iqry_tmnu + 1 '수취조회횟수 증가
			
			if g_szRcvn_iqry_tmnu < 5 then '5초 MAX
				SLEEP_SEC = g_szRcvn_iqry_tmnu
			else
				SLEEP_SEC = 5
			end if

			Form.SetTimerEvent2(1,1,SLEEP_SEC)
			
			exit sub
		else
			
			Form.SetTimerEvent(9999, 1, 1) 'remove
			
			szDELY_TACT_CLSN_YN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "DELY_TACT_CLSN_YN", 0)
			if szDELY_TACT_CLSN_YN == "Y" then
				Form.MsgBox("알림", "지연이체 가능시간이 아닙니다.", "", 6)
				return
			end if
			
			nFee = CInt(DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FEE" , 0 ))
			g_szBrcd = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "STDL_CNFT_BRCD", 0)
			
			f_SetTransInfoFee(nFee)
			f_CheckTrans()
		end if
		
	'당사 본인명의 계좌여부 조회
	elseif szTranID == "obrtp_comn_019r" then	
		g_szSapeYN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SAPE_YN" , 0)		'동일인 여부(Y/N)
		
		f_CheckTrans()
		
	'동일이체 여부 조회
	elseif szTranID == "obtss_elbs_240r" then
		szDPLC_TR_CNFR_YN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "DPLC_TR_CNFR_YN" , 0)

		if szDPLC_TR_CNFR_YN == "Y" then
			Form.MsgBox("알림", "당일 출금계좌, 입금계좌, 이체금액 모두 동일하게 이체된 건이 있습니다.\n추가로 이체하시겠어요?", "SAME_TRANS", 1)
		else
			if g_nTranIndex > 1 then '다건이체
				For i=1 to g_nTranIndex - 1
					szTransInfo = f_GetTransInfoItem(i)
					arrTransInfo = Split(szTransInfo, g_szSeparator)
					
					szTransInfoCurrent = f_GetTransInfoItem(g_nTranIndex)
					arrTransInfoCurrent = Split(szTransInfoCurrent, g_szSeparator)
					
					' 은행코드, 입금계좌번호, 출금금액이 같은경우
					if arrTransInfo(0) == arrTransInfoCurrent(0) and arrTransInfo(1) == arrTransInfoCurrent(1) and arrTransInfo(4) == arrTransInfoCurrent(4) then
						Form.MsgBox("알림", "이체접수 중인 입금계좌, 이체금액이 모두 동일하게 이체된 건이 있습니다.\n추가로 이체하시겠어요?", "SAME_TRANS", 1)
						return
					end if
				Next
			end if
			g_szRcvn_iqry_tmnu = 0
			DATAMANAGER.RequestTranData( "obtss_elbs_121r" ) '타행이체 수취조회 전문발송
		end if

	'수취인 통장문구 체크 (FDS)
	elseif szTranID == "obrtp_comn_025r" then
		szProsAbleYn = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PROS_ABLE_YN" , 0)
		if szProsAbleYn == "Y" Then
			if g_szAddFlag == "0" then
				DATAMANAGER.RequestTranData( "obcsb_oimf_638r_1" )
			elseif g_szAddFlag == "1" then
				Form.SetSharedData("63010_ACNT_INFO" , g_szACNO..g_szSeparator..g_szASNO)
				f_SetTransInfoLast()

				szData = g_nTranIndex.."♥"..
						g_szTransInfo1.."♥"..
						g_szTransInfo2.."♥"..
						g_szTransInfo3.."♥"..
						g_szTransInfo4.."♥"..
						g_szTransInfo5
						
				Form.SendReturnToParent("mbbnk63010_p9_AddTrans" , szData)
				Form.CloseForm()
			end if
		end if
		
	'수취인 통장문구 체크 (FDS)  받는분 메모 변경시
	elseif szTranID == "obrtp_comn_025r_1" then
		szProsAbleYn = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "PROS_ABLE_YN" , 0)
		if szProsAbleYn == "Y" Then
			if g_szPoupText == "YourMemoOne" then
				contOne.tblMemo.SetCellString(1, 1, Trim(g_szYourMemo))
			elseif g_szPoupText == "YourMemoMany1" then
				contMany.contTrans.contTrans1.tblTrans0.SetCellString(1, 1, Trim(g_szYourMemo))
				if g_nTranIndex <> 1 then
					f_SetTransInfoMemo("Your", Trim(g_szYourMemo), 1)
				end if
			elseif g_szPoupText == "YourMemoMany2" then
				contMany.contTrans.contTrans2.tblTrans0.SetCellString(1, 1, Trim(g_szYourMemo))
				if g_nTranIndex <> 2 then
					f_SetTransInfoMemo("Your", Trim(g_szYourMemo), 2)
				end if
			elseif g_szPoupText == "YourMemoMany3" then
				contMany.contTrans.contTrans3.tblTrans0.SetCellString(1, 1, Trim(g_szYourMemo))
				if g_nTranIndex <> 3 then
					f_SetTransInfoMemo("Your", Trim(g_szYourMemo), 3)
				end if
			elseif g_szPoupText == "YourMemoMany4" then
				contMany.contTrans.contTrans4.tblTrans0.SetCellString(1, 1, Trim(g_szYourMemo))
				if g_nTranIndex <> 4 then
					f_SetTransInfoMemo("Your", Trim(g_szYourMemo), 4)
				end if
			elseif g_szPoupText == "YourMemoMany5" then
				contMany.contTrans.contTrans5.tblTrans0.SetCellString(1, 1, Trim(g_szYourMemo))
				if g_nTranIndex <> 5 then
					f_SetTransInfoMemo("Your", Trim(g_szYourMemo), 5)
				end if
			end if
		elseif szProsAbleYn == "N" Then
			if g_nIndex > 1 then
				Form.MsgBox("알림", "\'받는분에게 표기\' 내용게 부적절한 문구가 포함되어 이체를 진행할 수 없습니다.\n해당 건은 제외하고 이체하시겠습니까?", "EXCEPT_TRANS", 1)
			else
				Form.MsgBox("알림", "\'받는분에게 표기\' 내용게 부적절한 문구가 포함되어 이체를 진행할 수 없습니다.", "", 6)
			end if
		end if
		
	'전자금융사기예방 고객조회
	elseif szTranID == "obcsb_oimf_638r_1" then	
		g_szPlusUI		= Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SPLM_ATHN_NCSR_YN", 0 ))'추가인증팝업여부
		g_szTRPass		= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "UI_SPLM_YN" , 0)
		g_szMdiaSkipYn	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock3", "SECU_MDIA_EXLS_YN" , 0)
		g_szGubunCode		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "SCRC_OTP_CLS_CODE" , 0 )
		
		szSapeYN = "Y"
		
		For i=1 to g_nTranIndex
			szTransInfo = f_GetTransInfoItem(i)
			arrTransInfo = Split(szTransInfo, g_szSeparator)
			if arrTransInfo(8) == "N" or arrTransInfo(0) <> "287" then
				szSapeYN = "N"
			end if
		Next
		
		'내계좌 일때
		If szSapeYN == "Y" Then
			DATAMANAGER.RequestTranData( "obrtd_drng_004a" )
			Exit Sub
		End If
		
		'보안매체제외인경우 and 간편이체 약정인경우 인증도 안타야됨
		if g_szMdiaSkipYn = "Y" and g_szUseSimple == "Y" then 
			f_RequestTransfer()
			Exit Sub
		end if

'         g_szPlusUI = "Y"
		'추가인증이 필요할때
		if g_szPlusUI == "Y" then
			szPlusData = ""
			For i=1 to g_nTranIndex
				szTransInfo = f_GetTransInfoItem(i)
				arrTransInfo = Split(szTransInfo, g_szSeparator)
				if i == 1 then
					szPlusData =  arrTransInfo(2) &"★"& arrTransInfo(0) &"★"& arrTransInfo(3) &"★"& arrTransInfo(4)
				else
					szPlusData =  szPlusData & "★"&  arrTransInfo(2) &"★"& arrTransInfo(0) &"★"& arrTransInfo(3) &"★"& arrTransInfo(4)
				end if
			Next

			szData = Form.GetSharedData("&USER_ID", false )
			Form.SetSharedData("CERT_ID" , szData )
			Form.SetSharedData("CERT_ACNO" , g_szACNO )
			if g_nTranIndex == 1 then
				Form.SetSharedData("BANK_TRANSTYPE" , "01")
			else
				Form.SetSharedData("BANK_TRANSTYPE" , "02")
			end if

			Form.OpenFramePopup("mhetc90060_p8" , "bank_61010★" & g_nTranIndex &"★"& szPlusData , "")
			Exit Sub
		end if

'		szTransInfo = f_GetTransInfoItem(g_nTransCnt)
'		arrTransInfo = Split(szTransInfo, g_szSeparator)
'		
'		if arrTransInfo(0) == "287" Then
'			DATAMANAGER.RequestTranData( "obrtd_drng_004a" )
'		else
'			DATAMANAGER.RequestTranData( "obtss_elbs_131u" )
'		end if

		Select Case g_szGubunCode
			Case "1"
				Form.ShowAlert( "알림", "부가정보만 존재할경우 처리가 불가능합니다.")
			Case "2"	
				Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
			Case "0"
				'공인인증서_보안카드화면
				Form.OpenPopupAnimation("seccardcheckpopup", " " , "","2")
			Case "3"
				'공인인증서_일반/스마트OTP
				Form.OpenPopupAnimation("otpcheckpopup", " " , "","2")
			Case "4"
				'공인인증서_mOTP
				Form.OpenPopupAnimation("otpcheckpopup", " " , "","2")
		End Select

	'당행 이체 실행
	elseif szTranID == "obrtd_drng_004a" then
		szDelay = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "DELY_TACT_YN", 0 ) '지연이체여부

		if g_nTranIndex = g_nTransCnt then
			f_SetTransInfoResult(g_nTransCnt, "Y", "", szDelay)
			f_SetResultInfoSuccess()
		elseif g_nTranIndex > g_nTransCnt then
			f_SetTransInfoResult(g_nTransCnt, "Y", "", szDelay)
			g_nTransCnt = g_nTransCnt + 1
			f_RequestTransfer()
		end if
		
	'타행 이체 실행 접수
	elseif szTranID == "obtss_elbs_131u" then
		g_szLNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_BANK_CLS_CODE" , 0 )
         g_szTR_DATE             = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TR_DATE"            , 0 )
		g_szOTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "OTSD_TR_UNIQ_NO"    , 0 )
		g_szTACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_LNKD_ISTU_CODE", 0 )
		g_szTACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_STND_TR_CODE"  , 0 )
		g_szLNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_TLMS_MNNO"     , 0 )
		
		Form.SetTimerEvent2(2,1,0.5)
		
	'타행 이체 실행 수신
	elseif szTranID == "obtss_elbs_231r" then
		if DATAMANAGER.GetDataMsgCode( szTranID ) == "6617" then  '처리 대기중입니다.
			g_szLNKD_BANK_CLS_CODE  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_BANK_CLS_CODE" , 0 )
			g_szTR_DATE             = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TR_DATE"            , 0 )
			g_szOTSD_TR_UNIQ_NO     = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "OTSD_TR_UNIQ_NO"    , 0 )
			g_szTACT_LNKD_ISTU_CODE = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_LNKD_ISTU_CODE", 0 )
			g_szTACT_STND_TR_CODE   = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "TACT_STND_TR_CODE"  , 0 )
			g_szLNKD_TLMS_MNNO      = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "LNKD_TLMS_MNNO"     , 0 )
								    
			g_szTact_rpcs_tmnu = g_szTact_rpcs_tmnu + 1 '이체조회횟수 증가
			
			if g_szTact_rpcs_tmnu < 5 then '5초 MAX
				SLEEP_SEC = g_szTact_rpcs_tmnu
			else
				SLEEP_SEC = 5
			end if

			Form.SetTimerEvent2(2,1,SLEEP_SEC)
			
			exit sub
		
		else
			Form.SetTimerEvent(9999, 1, 1)
			
			szDelay = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "DELY_TACT_YN", 0 ) '지연이체여부
			
			if g_nTranIndex = g_nTransCnt then
				f_SetTransInfoResult(g_nTransCnt, "Y", "", szDelay)
				f_SetResultInfoSuccess()
			elseif g_nTranIndex > g_nTransCnt then
				f_SetTransInfoResult(g_nTransCnt, "Y", "", szDelay)
				g_nTransCnt = g_nTransCnt + 1
				f_RequestTransfer()
			end if
			
		end if 
		
	end if
End Sub

'============================================================================
' OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Form.ShowAlert(szTranID, szErrMsg)
	'타행이체 수취조회 전문발송, 수신
	if szTranID == "obtss_elbs_121r" or szTranID == "obtss_elbs_221r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )

		Form.SetTimerEvent(9999, 1, 1)
		
	'수취인 통장문구 체크 (FDS)
	elseif szTranID == "obrtp_comn_025r" then
		if szErrCode <> "5036" then
			szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
			Form.ShowAlert( "알림", szErrMsg.."\n".."("..szSubErr..")" )
		else
			Form.MsgBox("알림", "\'받는분에게 표기\' 내용게 부적절한 문구가 포함되어 이체를 진행할 수 없습니다.", "", 6)
		end if
		
	'수취인 통장문구 체크 (FDS)  받는분 메모 변경시
	elseif szTranID == "obrtp_comn_025r_1" then
		if szErrCode <> "5036" then
			szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
			Form.ShowAlert( "알림", szErrMsg.."\n".."("..szSubErr..")" )
		else
			if g_nIndex > 1 then
				Form.MsgBox("알림", "\'받는분에게 표기\' 내용게 부적절한 문구가 포함되어 이체를 진행할 수 없습니다.\n해당 건은 제외하고 이체하시겠습니까?", "EXCEPT_TRANS", 1)
			else
				Form.MsgBox("알림", "\'받는분에게 표기\' 내용게 부적절한 문구가 포함되어 이체를 진행할 수 없습니다.", "", 6)
			end if
		end if
		
	elseif szTranID == "obcsb_oimf_638r_1" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		if szErrCode = "9150" then
			Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
		end if
	
	'이체 실행
	elseif szTranID == "obrtd_drng_004a" or szTranID == "obtss_elbs_131u" or szTranID == "obtss_elbs_231r" then
		if g_nTranIndex > 1 then
			if g_nTranIndex = g_nTransCnt then
				f_SetTransInfoResult(g_nTransCnt, "N", szErrMsg, "N")
				f_SetResultInfoFail("N", szErrMsg)
			elseif g_nTranIndex > g_nTransCnt then
				f_SetTransInfoResult(g_nTransCnt, "N", szErrMsg, "N")
				g_nTransCnt = g_nTransCnt + 1
				f_RequestTransfer()
			end if
		else
			f_SetResultInfoFail("N", szErrMsg)
		end if
	end if
End Sub

'============================================================================
' 이체 서비스 호출
'============================================================================
Sub f_RequestTransfer()
	szTransInfo = f_GetTransInfoItem(g_nTransCnt)
	arrTransInfo = Split(szTransInfo, g_szSeparator)
	
	if arrTransInfo(0) == "287" Then
		DATAMANAGER.RequestTranData( "obrtd_drng_004a" )
	else
		g_szTact_rpcs_tmnu = 0
		DATAMANAGER.RequestTranData( "obtss_elbs_131u" )
	end if
End Sub

'============================================================================
' 인증 팝업 호출
'============================================================================
Sub f_CheckBioCert()
	'간편비번 only
	if g_szCertUserType = "1" then
		Form.OpenPopup("mhetc90060_px", "", "")
		Exit Sub
		
	'바이오 only
	elseif g_szCertUserType = "0" or g_szCertUserType = "3" or g_szCertUserType = "4" then		
		szBIO_TR_CODE = "1"                                       '바이오거래유형코드 0: 인증 1: 서명 
		szATHN_USAG_CLS_CODE = "0"								' 서명데이터 생성여부
		
		szTransInfo = f_GetTransInfoItem(g_nTranIndex)
		arrTransInfo = Split(szTransInfo, g_szSeparator)

		szTRMsg = "이체예정내역\n" & "입금기관:" & arrTransInfo(2) & "\n" & "입금계좌:" & arrTransInfo(0) & "\n" & "예금주명:" & arrTransInfo(3) & "\n" & "이체금액:" & FormatNumber(CDbl(arrTransInfo(4)), 0, 0, 0, -1) & "원\n" 
		
		if g_nTranIndex > 1 then
			szTotalAmt = 0
			For i=1 to g_nTranIndex
				szTransInfo = f_GetTransInfoItem(i)
				arrTransInfo = Split(szTransInfo, g_szSeparator)
				szTotalAmt = szTotalAmt + arrTransInfo(4)
			Next
			szTRMsg = szTRMsg & "외 " & g_nTranIndex -1 & " 건\n"
			szTRMsg = szTRMsg & "총금액 : " & FormatNumber(szTotalAmt, 0, 0, 0, -1) & " 원\n"
		end if
			
		szData = ""
		if g_szCertUserType = "4" then
		    szData = "BCHAIN_trType★"& szBIO_TR_CODE  &"★"&  szTRMsg &"★"& szATHN_USAG_CLS_CODE 
		else
		    szData = "BIO_trType★"& szBIO_TR_CODE  &"★"&  szTRMsg &"★"& szATHN_USAG_CLS_CODE 
		end if
	
		Form.OpenFramePopup("mhetc90060_p5" , sData , "")
		Exit Sub
	end if 
End Sub

'============================================================================
' 이체 완료 세팅 성공
'============================================================================
Sub f_SetResultInfoSuccess()
	DATAMANAGER.RequestTranData("obrtp_drab_001r_1") '출금가능금액조회
	
	if g_nTranIndex > 1 then
		szTotalAmt = 0
		szTotalFee = 0
		szTotalCnt = 0
		szDelayCnt = 0
		
		For i=1 to g_nTranIndex
			szTransInfo = f_GetTransInfoItem(i)
			arrTransInfo = Split(szTransInfo, g_szSeparator)
			if arrTransInfo(9) == "Y" then
				szTotalAmt = szTotalAmt + arrTransInfo(4)
				szTotalFee = szTotalFee + arrTransInfo(5)
				szTotalCnt = szTotalCnt + 1
			end if
			if arrTransInfo(11) == "Y" then
				szDelayCnt = szDelayCnt + 1
			end if
		Next
		
		if szTotalCnt == 0 then
			contResultManyY.lblTransInfo.caption = "총 "..g_nTranIndex.." 건\n이체가 처리 되지 않았습니다."
			contResultManyY.imgNameBg.visible = "0"
			contResultManyY.tblTrans.visible = "0"
			contResultManyY.contTrans.top = 160
			contResultManyY.contTrans.height = 407
			contResultManyY.contTrans.SetScrollAutoSize()
		else
			if szDelayCnt > 0 then
				contResultManyY.lblTransInfo.caption = "총 "..szTotalCnt.." 건\n"..FormatNumber(CInt(szTotalAmt),0).."원이 이체(접수)되었습니다."
			else
				contResultManyY.lblTransInfo.caption = "총 "..szTotalCnt.." 건\n"..FormatNumber(CInt(szTotalAmt),0).."원이 이체되었습니다."
			end if
			
			contResultManyY.tblTrans.SetCellString(0, 1, Left(acntList.total,4).."-"..Right(acntList.total,4).."-"..acntList.sequence)
			if CInt(szTotalFee) == 0 then
				contResultManyY.tblTrans.SetCellString(1, 1, "무료")
			else
				contResultManyY.tblTrans.SetCellString(1, 1, FormatNumber(CInt(szTotalFee),0).."원")
			end if
		end if
		
		if g_nTranIndex == 5 then
			szTransInfo = f_GetTransInfoItem(5)
			arrTransInfo = Split(szTransInfo, g_szSeparator)
			
			'이체 성공여부
			if arrTransInfo(9) == "N" then
				contResultManyY.contTrans.contTrans5.lblFail.visible = "1"
				contResultManyY.contTrans.contTrans5.imgStar.visible = "0"
				contResultManyY.contTrans.contTrans5.imgShare.visible = "0"
			else
				if f_CheckOftenAcnt(arrTransInfo(5)) then
					contResultManyY.contTrans.contTrans5.imgStar.imgpath = "star_on.png"
				else
					contResultManyY.contTrans.contTrans5.imgStar.imgpath = "star_off.png"
				end if
			end if
			
			'지연이체 여부
			if arrTransInfo(11) == "Y" then
				contResultManyY.contTrans.contTrans5.imgStar.left = "297"
				contResultManyY.contTrans.contTrans5.imgShare.visible = "0"
				contResultManyY.contTrans.contTrans5.imgDelayBg.visible = "1"
				contResultManyY.contTrans.contTrans5.lblDelayText.visible = "1"
				contResultManyY.contTrans.contTrans5.lblDelayMove.visible = "1"
			end if
			
			contResultManyY.contTrans.contTrans5.lblName.caption = arrTransInfo(3)
			if arrTransInfo(0) == "287" then
				contResultManyY.contTrans.contTrans5.tblInfo.SetCellString(0, 1, "메리츠증권 "..Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2) )
			else
				contResultManyY.contTrans.contTrans5.tblInfo.SetCellString(0, 1, arrTransInfo(2).." "..arrTransInfo(1) )
