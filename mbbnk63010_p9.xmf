		end if

		'지연이체 여부
		if arrTransInfo(11) == "Y" then
			contResultOneY.contInfo.imgStar.left = "297"
			contResultOneY.contInfo.imgShare.visible = "0"
			contResultOneY.contInfo.imgDelayBg.visible = "1"
			contResultOneY.contInfo.lblDelayText.visible = "1"
			contResultOneY.contInfo.lblDelayMove.visible = "1"
			contResultOneY.lblTransInfo.caption = arrTransInfo(3).." 님에게\n"..FormatNumber(arrTransInfo(4),0).."원이 이체(접수)되었습니다."
		else
			contResultOneY.lblTransInfo.caption = arrTransInfo(3).." 님에게\n"..FormatNumber(arrTransInfo(4),0).."원이 이체되었습니다."
		end if
		
		
		contResultOneY.tblTrans.SetCellString(0, 1, Left(acntList.total,4).."-"..Right(acntList.total,4).."-"..acntList.sequence)

		contResultOneY.contInfo.lblName.caption = arrTransInfo(3)
		if arrTransInfo(0) == "287" then
			contResultOneY.contInfo.tblInfo.SetCellString(0, 1, "메리츠증권 "..Left(arrTransInfo(1),4).."-"..Mid(arrTransInfo(1),5,4).."-"..Right(arrTransInfo(1),2) )
