--===========================================================================
--===========================================================================
Dim g_szFncd
Dim g_szACNO
Dim g_szASNO

'============================================================================
Sub Form_OnFormInit()

End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "REQUEST" THEN
		if sParam <> null then
			g_szFncd = sParam
			'펀드코드 계좌조회
			DATAMANAGER.RequestTranData("obfnp_fnmt_011r")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obfnp_fnmt_011r" then		
		if Trim(g_szFncd) = "" or Len(g_szFncd) < 4 Then
			Form.ShowAlert("알림", "펀드코드를 입력하십시요.")
			Exit Sub
		end if
		DATAMANAGER.SetDataValue( false, "obfnp_fnmt_011r", "InBlock1", "FNCD"	, 0, g_szFncd )
	end if
	
	if szTranID = "obfnd_oder_011r" then
		DATAMANAGER.SetDataValue( false, "obfnd_oder_011r", "InBlock1", "BSOP_DATE" , 0 , Form.GetSharedData("&HOST_DATE", false ) )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_011r", "InBlock1", "ACNO" , 0 , g_szACNO )
		DATAMANAGER.SetDataValue( false, "obfnd_oder_011r", "InBlock1", "ASNO" , 0 , g_szASNO )	
				
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID = "obfnp_fnmt_011r" then	
		g_szACNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ACNO" , i) '계좌번호
		g_szASNO 	= DATAMANAGER.GetDataValue( false, "obfnp_fnmt_011r", "OutBlock1", "ASNO" , i) '계좌일련번호
		'해외파생 고유 청산내역 호출
		DATAMANAGER.RequestTranData("obfnd_oder_011r")
	end if

	if szTranID = "obfnd_oder_011r" then
		Dim szClrnDeal, szIntoDeal, szCRCD, szFUTS_CLRN_PRLS_FAMT, szFTRS_CLRN_PRLS_FAMT, szENTM_FFEE, szNTPL_FAMT, szCLRN_PRLS_FAMT
		Dim nCnt, nIndex
		
		nCnt = DATAMANAGER.GetDataCount( false, "obfnd_oder_011r", "OutBlock1")
		nIndex = tonumber(grdList.rowcount) - nCnt
		
		for i = 0 to nCnt - 1 
			szIntoDeal 			= DATAMANAGER.GetDataValue( false, "obfnd_oder_011r", "OutBlock1", "DEAL_CLS_CODE_NAME" , i)
			szClrnDeal 			= DATAMANAGER.GetDataValue( false, "obfnd_oder_011r", "OutBlock1", "DEAL_CLS_NAME" , i)
			szFUTS_CLRN_PRLS_FAMT 	= DATAMANAGER.GetDataValue( false, "obfnd_oder_011r", "OutBlock1", "FUTS_CLRN_PRLS_FAMT" , i)
			szFTRS_CLRN_PRLS_FAMT 	= DATAMANAGER.GetDataValue( false, "obfnd_oder_011r", "OutBlock1", "FTRS_CLRN_PRLS_FAMT" , i)
			szENTM_FFEE 			= DATAMANAGER.GetDataValue( false, "obfnd_oder_011r", "OutBlock1", "ENTM_FFEE" , i)
			szNTPL_FAMT 			= DATAMANAGER.GetDataValue( false, "obfnd_oder_011r", "OutBlock1", "UI_NTPL_FAMT" , i)
			szCRCD 				= DATAMANAGER.GetDataValue( false, "obfnd_oder_011r", "OutBlock1", "CRCD" , i)
			
			szCLRN_PRLS_FAMT = szFUTS_CLRN_PRLS_FAMT + szFTRS_CLRN_PRLS_FAMT
			
			if szIntoDeal = "매수" then
				grdList.SetCellFgColor("bd_cell8", nIndex+i, "1")
			elseif szIntoDeal = "매도" then
				grdList.SetCellFgColor("bd_cell8", nIndex+i, "2")
			end if
			
			if szClrnDeal = "매수" then
				grdList.SetCellFgColor("bd_cell1", nIndex+i, "1")
			elseif szClrnDeal = "매도" then
				grdList.SetCellFgColor("bd_cell1", nIndex+i, "2")
			end if
			
			if szCRCD = "KRW" or szCRCD = "JPY" then
				grdList.SetCellData("bd_cell3", nIndex+i, FormatNumber(szCLRN_PRLS_FAMT,0))
				grdList.SetCellData("bd_cell10", nIndex+i, FormatNumber(szENTM_FFEE,0))
				grdList.SetCellData("bd_cell4", nIndex+i, FormatNumber(szNTPL_FAMT,0))
			else
				grdList.SetCellData("bd_cell3", nIndex+i, FormatNumber(szCLRN_PRLS_FAMT, 2))
				grdList.SetCellData("bd_cell10", nIndex+i, FormatNumber(szENTM_FFEE, 2))
				grdList.SetCellData("bd_cell4", nIndex+i, FormatNumber(szNTPL_FAMT, 2))
			end if
		next
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Dim szSubMsg
'	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
'		
'	if Trim(szSubMsg) <> "" then
'		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
'	else
'		Form.ShowAlert("알림", szErrMsg)
'	end if
End Sub

'============================================================================
Sub grdList_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("obfnd_oder_011r") = true then
		DATAMANAGER.RequestNextData( "obfnd_oder_011r" )
	end if
End Sub
