Dim g_szAcno
Dim g_szAsno
Dim g_szData
Dim g_szItemCode
Dim g_szNewData
Dim g_szNewOrderData
Dim g_NextCnt
Dim g_szUserID 'v002
Dim g_GrdCnt
Dim g_szSelectType 'v003
Dim g_szDytmYN 'v004
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "TRANCALL" then
	
		g_NextCnt = 0
		grd0.SetClear()
		
		tmp = Split(sParam,"||")
		
		g_szAcno = tmp(0)
		g_szAsno = tmp(1)
		g_szUserID = tmp(2)
		g_szDytmYN = tmp(3)
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_209r", "InBlock1", "ACNO" 		  , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_209r", "InBlock1", "ASNO" 		  , 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_209r", "InBlock1", "CNTG_CLS_CODE" , 0 , "1")
		DATAMANAGER.SetDataValue(0, "obtro_oder_209r", "InBlock1", "FEE_INCU_YN"	  , 0 , "0")
		DATAMANAGER.SetDataValue(0, "obtro_oder_209r", "InBlock1", "ELFN_ID" 	  , 0 , g_szUserID) 'v002
		DATAMANAGER.SetDataValue(0, "obtro_oder_209r", "InBlock1", "DYTM_TR_CLPR_APLY_YN", 0 , g_szDytmYN) 'v004
		DATAMANAGER.RequestTranData("obtro_oder_209r")
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID = "obtro_oder_209r" then
		for i = g_NextCnt to grd0.rowcount-1
			vltn_prls_amt = grd0.GetCellData("bd_cell6", i)
			byov_amt 	= grd0.GetCellData("bd_cell9", i) 
			psnt_prc		= grd0.GetCellData("bd_cell10", i)
			nation		= grd0.GetCellData("bd_cell12", i)
			vltn_amt		= grd0.GetCellData("bd_cell8", i)
			byov_prc		= grd0.GetCellData("bd_cell11", i)
			
			'crcd			= grd0.GetCellData("bd_cell3", i)
			
			iscd			= grd0.GetCellData("bd_cell1", i)
			exch			= grd0.GetCellData("bd_cell21", i)
			
			'v001
			'loan_type     = grd0.GetCellData("bd_cell2", i)
			
			
			
			
			'byov_exrt 	= grd0.GetCellData("bd_cell15", i)
			stnd_exrt	= grd0.GetCellData("bd_cell14", i)
			
			'v003 START
			dim sType, nOwnQty, nAbleQty
			sType = grd0.GetCellData("bd_cell28", i)
			nOwnQty = CDbl(grd0.GetCellData("bd_cell30", i))
			nAbleQty = CDbl(grd0.GetCellData("bd_cell31", i))
			if sType == "1" then
				nOwnQty = FormatNumber(nOwnQty, 0)
				nAbleQty = FormatNumber(nAbleQty, 0)
				grd0.SetCellData("bd_cell3", i, "일반")
			elseif sType == "2" then
				nOwnQty = FormatNumber(nOwnQty, 6)
				nAbleQty = FormatNumber(nAbleQty, 6)
				grd0.SetCellData("bd_cell3", i, "소수점")
			end if
			
			grd0.SetCellData("bd_cell4", i, nOwnQty)
			grd0.SetCellData("bd_cell5", i, nAbleQty)
			'v003 END
			
			grd0.SetCellData("bd_cell14", i, FormatNumber(stnd_exrt,2))
			'grd0.SetCellData("bd_cell15", i, FormatNumber(stnd_exrt,2))
			
			'금액 -> 2자리
			'grd0.SetCellData("bd_cell6",  i, FormatNumber(vltn_prls_amt,2))
			'grd0.SetCellData("bd_cell9",  i, FormatNumber(byov_amt,2)     )
			'grd0.SetCellData("bd_cell8",  i, FormatNumber(vltn_amt,2)     )
			
			'가격 -> 4자리
			'grd0.SetCellData("bd_cell11", i, FormatNumber(byov_prc,4)     )			
			'grd0.SetCellData("bd_cell10", i, FormatNumber(psnt_prc,4)     )			
			
'			if crcd = "USD" then
'				grd0.SetCellData("bd_cell6",  i, FormatNumber(vltn_prls_amt,4))
'				grd0.SetCellData("bd_cell8",  i, FormatNumber(byov_amt,4)     )
'				grd0.SetCellData("bd_cell10", i, FormatNumber(psnt_prc,4)     )
'				grd0.SetCellData("bd_cell9",  i, FormatNumber(vltn_amt,4)     )
'				grd0.SetCellData("bd_cell11", i, FormatNumber(byov_prc,4)     )
'			else
'				grd0.SetCellData("bd_cell6",  i, FormatNumber(vltn_prls_amt,3))
'				grd0.SetCellData("bd_cell8",  i, FormatNumber(byov_amt,3)     )
'				grd0.SetCellData("bd_cell10", i, FormatNumber(psnt_prc,3)     )
'				grd0.SetCellData("bd_cell9",  i, FormatNumber(vltn_amt,3)     )
'				grd0.SetCellData("bd_cell11", i, FormatNumber(byov_prc,3)     )
'			end if
			
			if Cdbl(vltn_prls_amt) > 0 then
				grd0.SetCellFgColor("bd_cell6", i, "10")
			elseif Cdbl(vltn_prls_amt) < 0 then
				grd0.SetCellFgColor("bd_cell6", i, "11")
			else
				grd0.SetCellFgColor("bd_cell6", i, "4")
			end if
			
			if exch = "01" then
				grd0.SetCellData("bd_cell13", i, "미국")
			elseif exch = "02" then
				grd0.SetCellData("bd_cell13", i, "홍콩")
			elseif exch = "03" then
				grd0.SetCellData("bd_cell13", i, "중국")
			elseif exch = "04" then
				grd0.SetCellData("bd_cell13", i, "중국")
			elseif exch = "05" then
				grd0.SetCellData("bd_cell13", i, "일본")
			elseif exch = "06" then
				grd0.SetCellData("bd_cell13", i, "호주")
			elseif exch = "07" then
				grd0.SetCellData("bd_cell13", i, "싱가폴")
			elseif exch = "08" then
				grd0.SetCellData("bd_cell13", i, "영국")
			elseif exch = "09" then
				grd0.SetCellData("bd_cell13", i, "영국")
			elseif exch = "10" then
				grd0.SetCellData("bd_cell13", i, "독일")
			elseif exch = "11" then
				grd0.SetCellData("bd_cell13", i, "핀란드")
			elseif exch = "12" then
				grd0.SetCellData("bd_cell13", i, "프랑스")
			elseif exch = "13" then
				grd0.SetCellData("bd_cell13", i, "벨기에")
			elseif exch = "14" then
				grd0.SetCellData("bd_cell13", i, "네덜란드")
			elseif exch = "15" then
				grd0.SetCellData("bd_cell13", i, "포르투갈")
			elseif exch = "16" then
				grd0.SetCellData("bd_cell13", i, "그리스")
			elseif exch = "17" then
				grd0.SetCellData("bd_cell13", i, "아일랜드")
			elseif exch = "18" then
				grd0.SetCellData("bd_cell13", i, "이탈리아")
			elseif exch = "19" then
				grd0.SetCellData("bd_cell13", i, "스페인")
			elseif exch = "20" then
				grd0.SetCellData("bd_cell13", i, "오스트리아")
			elseif exch = "21" then
				grd0.SetCellData("bd_cell13", i, "캐나다")
			elseif exch = "23" then
				grd0.SetCellData("bd_cell13", i, "인도네시아")
			elseif exch = "24" then
				grd0.SetCellData("bd_cell13", i, "베트남")
			elseif exch = "25" then
				grd0.SetCellData("bd_cell13", i, "베트남")
			elseif exch = "26" then
				grd0.SetCellData("bd_cell13", i, "스위스") 'v005
			end if
			
			
			'v001
			'if loan_type = "0000" then
			'	grd0.SetCellData("bd_cell2", i, "보통")
			'elseif loan_type = "0251" then
				'grd0.SetCellData("bd_cell2", i, "예탁주식(해외)")
			'else
				'grd0.SetCellData("bd_cell2", i, "")
			'end if
			
			loan_type = Form.GetMetaData("대출상세유형코드", grd0.GetCellData("bd_cell24", i))
			grd0.SetCellData("bd_cell2", i, loan_type)
		
'			if exch = "NY" then
'				grd0.SetCellData("bd_cell12", i, "뉴욕")
'			elseif exch = "AX" then
'				grd0.SetCellData("bd_cell12", i, "아멕스")
'			elseif exch = "OQ" then
'				grd0.SetCellData("bd_cell12", i, "나스닥")
'			elseif exch = "SZ" then
'				grd0.SetCellData("bd_cell12", i, "심천")
'			elseif exch = "SH" then
'				grd0.SetCellData("bd_cell12", i, "상해")
'			elseif exch = "HK" then
'				grd0.SetCellData("bd_cell12", i, "홍콩")
'			else
'				Form.ShowAlert("TEST", "해당하는 시장 없음 : " & exch & " , " &  i)
'				
'			end if
			
'			if nation = "아멕스" or nation = "뉴욕" or nation = "나스닥" then
'				grd0.SetCellData("bd_cell13", i, "미국")
'			elseif nation = "홍콩" then
'				grd0.SetCellData("bd_cell13", i, "홍콩")
'			elseif nation = "선강통" then
'				grd0.SetCellData("bd_cell13", i, "중국")
'			elseif nation = "후강통" then
'				grd0.SetCellData("bd_cell13", i, "중국")
'			else
'				Form.ShowAlert("TEST", "해당하는 국가 없음: " & nation & " , " &  i)
'			end if
		next
		
		g_NextCnt = g_NextCnt + DATAMANAGER.GetDataCount(0, "obtro_oder_209r", "OutBlock1")
		
		'if DATAMANAGER.IsMoreNextData("obtro_oder_209r") = FALSE then
			tmp_rowcount = grd0.rowcount
			if Cint(tmp_rowcount) > 0 then
				g_GrdCnt = 0
				
				DATAMANAGER.SetDataValue(0, "obsim_oscm_321r", "InBlock1", "ISCD" , 0 , grd0.GetCellData("bd_cell1", 0))
				DATAMANAGER.RequestTranData("obsim_oscm_321r")
				
			end if
		'end if
	elseif szTranID = "obsim_oscm_321r" then
		tmp_prc = DATAMANAGER.GetDataValue(0, "obsim_oscm_321r", "OutBlock1", "CLPR" , 0)
		tmp_clpr = grd0.GetCellData("bd_cell10", g_GrdCnt)
		grd0.SetCellData("bd_cell26", g_GrdCnt, tmp_prc)
		
		
		
		if Cdbl(tmp_clpr) > Cdbl(tmp_prc) then
			grd0.SetCellFgColor("bd_cell10", g_GrdCnt, "10")
		elseif Cdbl(tmp_clpr) < Cdbl(tmp_prc) then
			grd0.SetCellFgColor("bd_cell10", g_GrdCnt, "11")
		else
			grd0.SetCellFgColor("bd_cell10", g_GrdCnt, "4")
		end if
		
		g_GrdCnt = g_GrdCnt+1
		
		if Cint(grd0.rowcount) > g_GrdCnt then
			DATAMANAGER.SetDataValue(0, "obsim_oscm_321r", "InBlock1", "ISCD" , 0 , grd0.GetCellData("bd_cell1", g_GrdCnt))
			DATAMANAGER.RequestTranData("obsim_oscm_321r")
		end if
	end if
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szItemCode, szQty, szLoanData, szLoanCd, szLoanSr, szData
	dim nAbleQty 'v003

	g_szItemCode = grd0.GetCellData("bd_cell1", lRow)
	
	listLocation =  Split(grd0.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	'v003 START
	g_szSelectType = grd0.GetCellData("bd_cell28", lRow) '1:일반,2:소수점 
	nAbleQty = CDbl(grd0.GetCellData("bd_cell31", lRow))
	
	if sType == "1" then '일반
		nAbleQty = CInt(nAbleQty)
	elseif sType == "2" then '소수점
		nAbleQty = FormatNumber(nAbleQty, 6)
	end if
	'v003 END
	
	szItemCode = grd0.GetCellData("bd_cell1", lRow)
	szItemName = grd0.GetCellData("bd_cell0", lRow)
'	szQty      = grd0.GetCellData("bd_cell5" , lRow)
	szQty      = nAbleQty 'v003
	
	'CutData = Split(szItemCode, ".")
	
	'뒤에서 2자리 & '.' 을 제외한 나머지를 종목코드로 수정
	'szCutIscd	= CutData(0)
	'뒤에서 2자리 자르는 것으로 수정
	'szTranExch	= Transform_Exid2(CutData(1))
	szCutIscd  = Mid(szItemCode, 1, Len(szItemCode)-3)	
	szTranExch = Transform_Exid2(right(szItemCode, 2))
	
	' 온라인 거래소가 아닌경우
	if szTranExch = nil Then
		 Form.ShowAlert("알림", "MTS에서 거래가 불가한 종목입니다.\n(영업점 또는 해외주식 데스크 문의)") 'v005
		Exit Sub
	end if
	
	'msgbox szTranExch
		
'	if ubound(CutData) < 1 then
'		msgbox "잘못된 데이터형식입니다." & "ubound(CutData) : " & ubound(CutData)
'		exit sub
'	end if
	
	if len(szCutIscd) < 0 or len(szTranExch) < 0 then
		msgbox "필수 데이터 값이 존재하지 않습니다." & "@" & szCutIscd & "@" & szTranExch
		
	end if
	
	'거래소영문@종목코드★종목명
	
	g_szNewData = szTranExch & "@" & szCutIscd & "★" & szItemName
	 
	

	
	
	
	szLoanDate = ""'grd0.GetCellData("bd_cell10", lRow)
	szLoanCd   = "0000"'grd0.GetCellData("bd_cell14", lRow)
	szLoanSr   = "00000000000"'grd0.GetCellData("bd_cell15", lRow)
	
	sPopupType = "2"
	
	g_szData = szItemCode & "★" & szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & "0" & "♥" & szLoanSr '0은 신용합산
	g_szNewBuyData = szTranExch & "@" & szCutIscd & "★" & szItemName & "♥" & "0" & "♥"& szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & "0" & "♥" & szLoanSr '0은 신용합산
	g_szNewSelData = szTranExch & "@" & szCutIscd & "★" & szItemName & "♥" & "1" & "♥"& szQty & "♥" & szLoanDate & "♥" & szLoanCd & "♥" & "0" & "♥" & szLoanSr '0은 신용합산
	
	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매수" & "★" & "매도" & "★" & "" & "★" & "")
	
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "MOVEPOP_RETURN" then
		Dim szListItems, szScreenNo
		szListItems	=	split(sRet,"★")
		
		'v003 START
		if g_szSelectType == "1" then '일반
			szScreenNo = "16060"
		elseif g_szSelectType == "2" then '소수점
			szScreenNo = "16092"
		end if
		'v003 END
		
		if	szListItems(1)	=	"0"	then			'현재가
			Form.OpenScreen("16000" , g_szNewData)
		elseif szListItems(1)	=	"1"	then
'			Form.OpenScreen("16060" , g_szNewBuyData)
			Form.OpenScreen(szScreenNo , g_szNewBuyData) 'v003
		elseif szListItems(1)	=	"2"	then
'			Form.OpenScreen("16060" , g_szNewSelData)
			Form.OpenScreen(szScreenNo , g_szNewSelData) 'v003
		end if
	end if
End Sub

'============================================================================
Function Transform_Exid2(sValue)

	
	if sValue = "HK" then
		Transform_Exid2 = "HKS"
		exit Function
	elseif sValue = "SH" then
		Transform_Exid2 = "SHS"
		exit Function
	elseif sValue = "SZ" then
		Transform_Exid2 = "SZS"
		exit Function
	elseif sValue = "NY" then
		Transform_Exid2 = "NYS"
		exit Function
	elseif sValue = "AX" then
		Transform_Exid2 = "AMX"
		exit Function
	elseif sValue = "OQ" then
		Transform_Exid2 = "NAS"
		exit Function
	elseif sValue = "JP" then
		Transform_Exid2 = "TSE"
		exit Function		
	end if
End Function

'============================================================================
'Function Transform_Exid2(sValue)
' if sValue == "0104" then ' 홍콩
'  return "HKS"
' elseif sValue == "0529" then ' 항셍 지수
'  return "HSI"
' elseif sValue == "0211115" then ' 상해
'  return "SHS"
' elseif sValue == "0214" then ' 심천거래소 종목
'  return "SZS"
' elseif sValue == "0321" then ' 뉴욕
'  return "NYS"
' elseif sValue == "0066" then ' 아멕스
'  return "AMX"
' elseif sValue == "0537" then ' 나스닥
'  return "NAS"
' elseif sValue == "0130" then ' 미국 OTCBB
'  return "NAO"
' elseif sValue == "0625" then ' S&P 지수
'  return "SPI"
' elseif sValue == "0310" then ' 다우존스 지수
'  return "DJI"
' elseif sValue == "0106" then ' 도쿄
'  return "TSE"
'elseif sValue == "0107" then ' 오사카거래소 종목
'  return "OSE"
' elseif sValue == "0112" then ' 자스닥거래소 종목
'  return "JSD"
