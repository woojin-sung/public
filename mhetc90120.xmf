Sub Image0_OnClick()
	'간편인증 등록 단계에서 사용하는 shared변수이므로 진입 시 클리어
	Form.SetSharedData("MeritzAuth_Security", "")
	
	'20230619
	if g_OSType == "2" then
		Form.OpenScreen("86000", "POPUP_ALL_CLOSE")
	else
'		20240306 HSZ START: 화면유형 변경(일반->풀팝업)
'		Form.OpenScreen("86000", "")
		Form.OpenPopup("mbonl86005" , "" , "")
'		20240306 HSZ END
	end if
	'20230619

End Sub
