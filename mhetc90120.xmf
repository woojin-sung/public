'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 인증센터
' 02. 화면설명 : 인증센터 서비스 메인
' 03. 작    성 : 2016.11.11  NOHES
'-------------------------------------------------------------------------------------------
'20230519 SWJ START : 메리츠 사설인증 신규 개발 (간편인증센터 위치 삭제(위치 변경))
'-------------------------------------------------------------------------------------------
'20240418 SWJ START : 클라우드인증서 신규 개발
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szData			'링크데이터	1:90020 로그인화면에서 call
g_szData = ""

'20211026 HWG START : TartgetSDK30 업데이트(공동인증서 디폴트값 선택)
Dim g_bReCheckCert
g_bReCheckCert = false
'20211026 HWG END

'20220805_01 KBC : 로그인개선
Dim g_bCertLogin
g_bCertLogin = false

Dim DEF_TAB_CERT
DEF_TAB_CERT			= "1"	'인증서로그인

'20230524 SWJ START : 메리츠 간편인증 신규 개발
Dim g_SBVersion, g_SBAlias
DIM g_DeviceId
Dim g_RelayTranNo, g_RelayTranEasyNo, g_RelayEncElsgOnttCon, g_RelayEncRandomKey

'20230612 KBC START : QR
Dim DEF_ATON_PIN
Dim DEF_ATON_BIO

DEF_ATON_PIN			= "10"
DEF_ATON_BIO 			= "20"

Dim g_QRCode
g_QRCode 			= ""
'20230612 KBC END

Dim g_Open
g_Open = ""

Dim g_OSType
g_OSType = ""

Dim g_MotpManager
g_MotpManager = ""

Dim g_sRet
g_sRet = ""

Dim g_sLoginID
g_sLoginID = ""

Dim g_CustNo
g_CustNo = ""
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************


'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&SCREEN_AUTH" , "")	'20210622 HWG : 비대면 화면권한 초기화
	Form.SetSharedData("&NEW_CUSTOMER","")
	
	g_szData = Form.GetOpenLinkData()	'로그인 화면에서 들어온 경우인지 확인
	
	g_logintype = Form.GetSharedData( "&LOGIN_TYPE" , false)
	g_DeviceId = Form.GetDeviceID2() '20230612 KBC : QR
	
	'20170111 NOHES : IOS) 결제원 앱 미설치 및 비정상 시 바이오인증 지원여부 확인이 불가하므로,
	' 무조건 전체 선택창 보여주는 방식으로 변경함
	s_OSTYPE = Form.GetSharedData("&OS_TYPE", false ) 'iOS("2")Android("1")
	g_OSType = s_OSTYPE	'20230619 SWJ START
	
	'20230628_01 KBC START
	if g_szData == "QR_RUN" then
		Form.SetTimerEvent2( "1", 1, 0.1)
	end if
	'20230628_01 KBC END	
	
	if s_OSTYPE == "2" Then
		Cont0.top = 240		'20230519 SWJ : 위치 조절
		Cont0.visible = True
		Cont1.visible = False
		
		'20191219 LES START 바이오인증 이미지 교체
		'Cont0.Image6.imgpath = "btn_bio_center_ios" '20220805_01 KBC : 로그인개선
		Cont0.Table0.SetCellString(7, 1, "생체정보(지문/얼굴) 또는 간편비밀번호")
		Cont0.Table0.SetCellString(8, 1, "(숫자6자리)를 이용한 인증 신청 및 해지")
		'20191219 LES END

		Exit Sub
	end if

	'20170111 NOHES : Android)결제원 앱 설치 상관없이 바이오인증 지원 가능 단말 여부
	'				IOS)결제원 앱에서 판단하는 바이오인증 지원 가능 단말 여부
	sRet = Form.GetKftcBioDeviceEnbl()	'바이오인증 지원 여부 : 0.미지원 1.지원(지문가능) 2.지원(지문불가)
	'20161108 NOHES 베타테스트용 오픈
	
	'KBC START : KITKAT 임시제외
	'KITKAT에서 바이오인증이 정상처리 되지 않아서 임시 처리함 (결제원 확인중)
	if s_OSTYPE == "1" then
		szSdkVer = Form.GetSharedData("&SDK_VERSION", False)
		if Cint(szSdkVer) < 21 then
			sRet = "0"
		end if
	end if
	'KBC END : KITKAT 임시제외
	
	'20230830 SWJ START : 삭제
	'20180911_01 KBC START : 바이오인증 인증방식 추가 및 스크립트 정리
'	If sRet == "0" then
'		'바이오인증 불가
'		Cont1.top = 240			'20230519 SWJ : 위치 조절
'		Cont0.visible = False
'		Cont1.visible = True
'	else		
		Cont0.top = 240			'20230519 SWJ : 위치 조절
		Cont0.visible = True
		Cont1.visible = False
	'end if
	'20180911_01 KBC END
	'20230830 SWJ END
End Sub


'============================================================================
Sub Cont0_Table0_OnClick(lRow , lColumn)
	
	if lRow == 0 or lRow == 1  or lRow == 2 then 'or lRow == 3 or lRow == 4 then '인증센터
		Cont0_Image2_OnClick()'공동(공인)인증 센터
		
	'20240418 SWJ START
	elseif lRow == 3  then
		Cont0_Image6_OnClick()	'클라우드인증센터
	'20240418 SWJ END
	
	elseif lRow == 4 or lRow == 5  or lRow == 6 then' or lRow == 8 or lRow ==9 or  lRow == 10 then  '바이오
		Cont0_Image4_OnClick()'바이오인증 센터
	
	'인증센터에서 삭제(위치 변경 : 인증/OTP > 공동인증센터>인증서 관리>간편인증센터)
'	elseif lRow ==11 or lRow == 12  or lRow == 13 or lRow == 14 or lRow == 15 or lRow == 16 then  '간편 
'		Cont0_Image5_OnClick()'간편인증 센터	
	end if	
End Sub

'============================================================================
Sub Cont1_Table0_OnClick(lRow , lColumn)
	if lRow == 0 or lRow == 1 or lRow == 2 or lRow == 3 or lRow == 4 then '인증센터
		Cont0_Image2_OnClick()'공동(공인)인증 센터
		
'	elseif lRow == 5 or lRow == 6 or lRow == 7 or lRow == 8 or lRow ==9 or lRow == 10 then  '간편
'		Cont0_Image5_OnClick()'간편인증 서비스 해지	
	end if
End Sub
'============================================================================
Sub Table1_OnClick(lRow , lColumn)
	if lRow == 0 or lRow ==1 or lRow ==2 then
		Image0_OnClick()							'OTP관리
	elseif lRow == 3 or lRow ==4 or lRow ==5 then
		Image1_OnClick()							'모바일OTP관리
	elseif lRow == 6 or lRow ==7 or lRow ==8 then
		Image3_OnClick()							'모바일OTP인증
	end if
End Sub
