Sub ImgBtnQR_OnClick()
	ImgBtnQR.imgpath = "bg_infobox_o.9"
	g_btnQR = true
	ImgBtnQR.imgpath = "bg_infobox_n.9"
	
	g_sLoginID = Form.GetSharedData( "&USER_ID", false)
	g_CustNo   = Form.GetSharedData("&CUST_NUM", false)
	
	'20230726 SWJ START : MTS 로그인이 안되는 경우에 대한 메시지 처리 개선
	'앱에 등록된 인증서 정보가 있는지 판단
	'있음
	if fnGetSBInfo("") == True then
		szLoginYn = Form.GetEnvData("meritzauth.notuse.mobile")
		
		'간편인증이 등록되어있으나 모바일 거부 약정 등의 사유로
		'로그인을 못하는 경우 고객번호를 쉐어드변수로 가져올 수 없어서 조회가 안됨
		
		'앱을 설치하고 로그인 하는 경우는 QR인증 못하도록 막고,
		'MTS를 쓰다가 중간에 거부약정을 맺는 경우는 QR인증 가능하게 함
		if Trim(g_sLoginID) == "" then
			
			if szLoginYn == "Y" then
				Form.MsgBox("안내", "모바일서비스 이용거부 상태입니다.\nHTS [7439]에서 이용 신청 후 이용해주세요." , "", 0)	
			else
				Form.MsgBox("안내", "최초 1회 로그인 후 이용 가능합니다." , "", 0)	
			end if
		else
			'-----------------------------------------------------------------------
			'전문전송
			'-----------------------------------------------------------------------	
			procRequestAtonTR_INQUIRYCERT(sAlias)
		end if
	end if
	'20230726 SWJ END
	
	'Form.runQRCamera()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "QR" then
		'sParam : QR수신시 번호, 그외 "manual input", "cancel camera"
		
		Select Case sParam
		
		'직접 인증번호 넣는 경우
		Case "manual input" 
			Form.OpenFramePopup("mhetc90060_py" , "mhetc90120_qrinput" , "") 'QR직적입력수행
			
		'카메라 취소 (뒤로 가기)
		Case "cancel camera"
		
		'순서 : 서명원문조회 -> 사용자인증 -> 서명메시지 등록
		Case Else
			if sParam <> "" then
				g_QRCode = sParam 'QR번호
				g_sRet = "ok_qrphoto"
				procRequestAtonTR_INQUIRYPRE_RELAY(g_QRCode) '(순서변경) QR -> ohhts_pauth_802(서명원문조회) -> 간편인증
				'Form.OpenFramePopup("mhetc90060_py" , "" , "") '간편인증수행
			end if
		End Select
		
	end if
End Sub

'============================================================================
'-----------------------------------------------------------------------------
'SafeBox 정보획득
'-----------------------------------------------------------------------------
function fnGetSBInfo(sParam)
	'-----------------------------------------------------------------------
	'ATON_GETALLINFO
	'-----------------------------------------------------------------------
	sRet = Form.requestAtonAuth("ATON_GETALLINFO" , "" , "")
	sRetItem = Split(sRet, "★")
	
	sErrorCode	= sRetItem[0]
	sErrorMsg	= sRetItem[1]
	g_SBVersion  	= sRetItem[2] 'SafeBox 버전 (에러여도 값 있음)
	g_SBAlias 	= sRetItem[3] '인증서일련번호(식별자)

	if sErrorCode == "00000" then
		return True
	else
		if sParam <> "ISSUE" then
			if sErrorCode == "E3201" then
				Form.MsgBox("안내", "메리츠 간편인증 등록 후\n이용해주세요.", "E3201", 7, "간편인증 등록","취소")
			else
				Form.MsgBox("안내", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			end if
		end if
	
		return False
	end if
	
	return True
end function
'============================================================================
Sub procRequestAtonTR_INQUIRYCERT(paramKeyAlias)	
	sTranID = "ohhts_pauth_004"
	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , "MERITZSMART")	'매체구분코드
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CUST_NO" 					, 0 , g_CustNo	)	'(고객번호, 일련번호 중 1개는 필수)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId  )	'이용자접속기기ID
		
	DATAMANAGER.RequestTranData(sTranID)
End Sub
'============================================================================
'20230612 KBC START : QR
'============================================================================
'서명원문조회(RELAY)
Sub procRequestAtonTR_INQUIRYPRE_RELAY(paramTranEasyNo)

	if fnGetSBInfo("") == False then 
		exit sub
	end if
				
	sTranID = "ohhts_pauth_802"
	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , "MERITZSMART")	'매체구분코드
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CERT_SEQ_NO" 				, 0 , g_SBAlias)		'인증서일련번호
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId)		'이용자접속기기ID
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_REL_TRAN_EASY_NO" 			, 0 , paramTranEasyNo)	'연계간편인증번호
	
	DATAMANAGER.RequestTranData(sTranID)		
End Sub
'============================================================================
'인증서 사용자인증(RELAY)
Sub procRequestAtonTR_AUTHUSER_RELAY(paramCrtcDataCon, paramTranNo, paramTranEasyNo)
	sTranID = "ohhts_pauth_803"
	
	sAuthType = Form.GetSharedData("90060py_AuthType", false)
	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , "MERITZSMART")	'매체구분코드
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CERT_SEQ_NO" 				, 0 , g_SBAlias)		'인증서일련번호
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_MSB_VRSN_VL" 				, 0 , g_SBVersion)	'mSB버전값 (라이브러리 버전 정보)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId)		'이용자접속기기ID
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CRTC_PTRN_DCD" 			, 0 , sAuthType)		'인증유형구분코드 (10:PIN, 20:BIO, 30:Pattern)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_BIO_CRTC_SUCC_YN" 			, 0 , "Y")			'바이오인증성공여부(Y:인증성공, N:인증실패) 인증유형구분코드가 '20(BIO)' 인 경우에만 해당 필드가 유효함	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CRTC_DATA_CON" 			, 0 , paramCrtcDataCon)'인증유형데이터내용 (HexString, 64Byte)
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_REL_TRAN_NO" 				, 0 , paramTranNo)	'연계거래번호
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_REL_TRAN_EASY_NO" 			, 0 , paramTranEasyNo)	'연계간편인증번호

	DATAMANAGER.RequestTranData(sTranID)		
End Sub
'============================================================================
'서명메시지 등록(RELAY)
Sub procRequestAtonTR_TRAN_RELAY(paramElsgDataCon, paramTranNo, paramTranEasyNo)			
	sTranID = "ohhts_pauth_804"
	
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_RQST_CHNL_DCD" 			, 0 , "MERITZSMART")	'매체구분코드
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_CERT_SEQ_NO" 				, 0 , g_SBAlias)		'인증서일련번호
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_USR_CCTN_MCTL_ID" 			, 0 , g_DeviceId)		'이용자접속기기ID
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_TRAN_ELSG_DATA_CON" 		, 0 , paramElsgDataCon)'거래전자서명데이터내용
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_REL_TRAN_NO" 				, 0 , paramTranNo)	'연계거래번호
	DATAMANAGER.SetDataValue(0, sTranID, "InBlock1", "PAU_REL_TRAN_EASY_NO" 			, 0 , paramTranEasyNo)	'연계간편인증번호	
	
	DATAMANAGER.RequestTranData(sTranID)		
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
		
	Form.MsgBox( "안내", szErrMsg, "", 6 )

End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	'(중계서버 ohhts_pauth_802) 서명원문조회(RELAY)
	if szTranID == "ohhts_pauth_802" then
		sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" ,0)
	
		if sErrorCode <> "000000" then
			'QR비번 오류 시 창 다시 띄움
			if sErrorCode == "060102" then
				if g_sRet = "ok_qrinput" then
					'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
					sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode, "")
				else
					sErrorMsg = "QR인증에 실패하였습니다.\n다시 시도해주세요."
				end if
	
				Form.MsgBox("안내", sErrorMsg , g_sRet, 0)
				exit sub
			elseif sErrorCode == "030104" then
				'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
				sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode, "")
				
				Form.MsgBox("안내", sErrorMsg , "030104", 7, "재등록","취소")
				exit sub
			else
				'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
				sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode, "")
	
				Form.MsgBox("안내", sErrorMsg , "", 0)
				exit sub
			end if
		end if
		
		'연계거래번호
		g_RelayTranNo		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_REL_TRAN_NO" ,0)

		'연계간편인증번호
		g_RelayTranEasyNo	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_REL_TRAN_EASY_NO" ,0)
		
		'암호화된거래전자서명원문
		g_RelayEncElsgOnttCon	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ENC_TRAN_ELSG_ONTT_CON" ,0)
		
		'암호화된거래전자서명원문복호화키
		g_RelayEncRandomKey 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ENC_RANDOM_KEY" ,0)
	
		
		'-----------------------------------------------------------------------
		'간편인증수행
		'-----------------------------------------------------------------------	
		Form.OpenFramePopup("mhetc90060_py" , "" , "") '간편인증수행

'		'-----------------------------------------------------------------------
'		'인증유형데이터
'		'-----------------------------------------------------------------------	
'		sCrtcDataCon = Form.GetSharedData("90060py_AuthPwd", false)
'
'		'인증서사용자인증
'		procRequestAtonTR_AUTHUSER_RELAY(sCrtcDataCon, g_RelayTranNo, g_RelayTranEasyNo)

	'(중계서버 ohhts_pauth_803) 인증서 사용자인증(RELAY)
	elseif szTranID == "ohhts_pauth_803" then
		sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" ,0)
		
		if sErrorCode <> "000000" then
			'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
			sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode, "")

			Form.MsgBox("안내", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if	
		
		'-----------------------------------------------------------------------
		'ATON_SIGNRELAY
		'-----------------------------------------------------------------------
		sRet = Form.requestAtonAuth("ATON_SIGNRELAY" , g_SBAlias & "★" & g_RelayEncElsgOnttCon & "★" & g_RelayEncRandomKey, "")
		sRetItem = Split(sRet, "★")
		
		sErrorCode	= sRetItem[0]
		sErrorMsg	= sRetItem[1]
		sPKCS7		= sRetItem[2] '서명원문의 byte 형식 데이터
		
		if sErrorCode <> "00000" then
			Form.MsgBox("안내", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if	

		procRequestAtonTR_TRAN_RELAY(sPKCS7, g_RelayTranNo, g_RelayTranEasyNo)			
	
	'(중계서버 ohhts_pauth_804) 서명메시지 등록(RELAY)
	elseif szTranID == "ohhts_pauth_804" then
		sErrorCode	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" ,0)
		
		if sErrorCode <> "000000" then
			'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
			sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode, "")

			Form.MsgBox("안내", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if
		
		'Form.Toast(0,"PC(QR)인증이 완료되었습니다.", 0)
		Form.MsgBox("안내", "PC(QR)인증이 완료되었습니다." , "", 0)	
	
	end if
	
	if szTranID == "ohhts_pauth_004" then
		sErrorCode 	= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "PAU_ERR_CD" 					,0)
		
		sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode , "")
		
		if sErrorCode  == "000000" then
			Form.runQRCamera()
		'000101은 필수항목 누락 시 사용하는 메시지
		elseif sErrorCode  == "030102" or sErorCode = "000101" or sErrorCode  == "E3201" then
			Form.MsgBox("안내", "메리츠 간편인증 등록 후\n이용해주세요.", "E3201", 7, "간편인증 등록","취소")
			exit sub
		else
			'전문에러 : metaimsi 등 활용해서 에러메시지 처리필요
			sErrorMsg = Form.requestAtonAuth("ATON_GETERRORMSG_SVR", sErrorCode , "")
			
			Form.MsgBox("알림", sErrorMsg & "(" & sErrorCode & ")", "", 0)
			exit sub
		end if		
	end if
End Sub
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2("1", 0, 1)
		ImgQR_OnClick()
	end if
End Sub

