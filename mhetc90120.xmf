'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "GOTOCERTLOGIN" Then
		if sRet == "ok" then
			g_bCertLogin = true
			g_Open = ""		'20230619 SWJ START : OTP쪽 화면오픈할 때 변수 클리어
			Form.CloseForm()
			
			if g_szData <> "1" Then
				Form.SetEnvData(1, "login.input.savetab", DEF_TAB_CERT) '20220805_01 KBC : 로그인개선
				Form.OpenScreen("90020" , "90120") '20180911_01 KBC : 바이오인증 인증방식 추가
			end if
		end if
	end if
	
	if sKeyName == "ok_qrphoto" then
		Form.runQRCamera()
	elseif sKeyName == "ok_qrinput" then
		Form.OpenFramePopup("mhetc90060_py" , "mhetc90120_qrinput" , "") 'QR직적입력수행
	elseif sKeyName == "030104" then
		if sRet == "ok" then
			Form.OpenNextPopup("mhetc90190_s1" , "" , "")
		end if
	elseif sKeyName == "E3201" then
		if sRet == "ok" then
			Form.OpenPopup("mhetc90190_s1" , "" , "")
		end if
	end if
End Sub
'test
'============================================================================

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "OneShotCancel" then
		if sRet == "ok" then
			g_Open = ""		'20230619 SWJ START : OTP쪽 화면오픈할 때 변수 클리어
			Form.CloseForm()
		end if
		
	'20230612 KBC START
	elseif sKeyName == "mhetc90060_py" then
		if sRet == "ok_qrinput" then
			'QR인식후 (또는 인증비밀번호 직접입력 후 진입)
			g_QRCode = Form.GetSharedData("90060py_QrCd", false) 'QR번호
			g_sRet   = sRet								'QR코드 인증과 번호 인증을 화면에서 구분
			procRequestAtonTR_INQUIRYPRE_RELAY(g_QRCode) '(순서변경) QR -> ohhts_pauth_802(서명원문조회) -> 간편인증
			'Form.OpenFramePopup("mhetc90060_py" , "" , "") '간편인증수행

		elseif sRet == "ok" then		
			'간편인증후 QR인증 후속진행			
			'-----------------------------------------------------------------------
			'인증유형데이터
			'-----------------------------------------------------------------------	
			sCrtcDataCon = Form.GetSharedData("90060py_AuthPwd", false)
	
			'인증서사용자인증
			procRequestAtonTR_AUTHUSER_RELAY(sCrtcDataCon, g_RelayTranNo, g_RelayTranEasyNo)			
		end if
	'20230612 KBC END
		
	'20211026 HWG START : TartgetSDK30 업데이트(공동인증서 디폴트값 선택)
	elseif sKeyName == "RECHECK_CERT" then
		g_bReCheckCert = true
	'20211026 HWG END
	
	'20230519 SWJ START : 인증센터로 다시 리턴되면 비활성화 이미지
	elseif sKeyName == "BTN_IMAGE_ENABLE" then
		ImgBtnMeritz.imgpath = "bg_infobox_n.9"
		ImgBtnQR.imgpath = "bg_infobox_n.9"
	
'	elseif sKeyName == "Login_Type" then
'	
'		if Cint(sRet) > 1 then
'			Form.CloseForm()
'		end if
'	
	end if
	'20230519 SWJ END
End Sub

'============================================================================
'20211026 HWG START : TartgetSDK30 업데이트(공동인증서 디폴트값 선택)
Sub Form_OnFormClose()
	
	'20230619
'	if g_Open == "86000" then
'		Form.OpenFramePopup("mbonl86000" , "" , "")
'	elseif g_Open == "87003" then
'		Form.OpenPopup("mbotp86105" , "", "")
'		'Form.OpenPopup("mbotp86105" , "" , "")
'	elseif g_Open == "10003" then
'		Form.OpenNextPopup("mhetc90060_motp" , "", "")
'	end if
	'20230619
	
	if g_bReCheckCert == true then
		Form.SendReturnToParent("RECHECK_CERT" , "")
	elseif g_szData == "1" Then					'로그인 화면 통해서 들어왔을 경우
		'20220805_01 KBC : 로그인개선
		if g_bCertLogin == true then
			'간편인증 등록 -> 인증서로그인 필요 -> 로그인화면이 무조건 인증서로그인으로 선택되도록 해야 함
			Form.SendReturnToParent("FORM_CLOSE_CERT" , "") 
		else
			Form.SendReturnToParent("FORM_CLOSE" , "")
		end if
	end if
End Sub
'20211026 HWG END

