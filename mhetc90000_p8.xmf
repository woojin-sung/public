	<SCRIPT_INFO _len="2567" _ulen="2335" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 환결설정 온라인 동시접속 허용팝업
' 02. 작    성 : 2023.06.12
'
' 20230612 KKM 접속비밀번호 입력하지 않고 온라인 동시접속 여부를 설정함. 참고화면(mbonl86020.xmf)
'-------------------------------------------------------------------------------------------

Dim g_szId			'사용자아이디
Dim g_szPAndICheck	'동시접속차단/허용 선택 (차단 : N 허용 : Y)


'============================================================================
' Form_OnFormInitBefore - 기기에 저장된 ID를 가져와 설정한다
'============================================================================
Sub Form_OnFormInitBefore()
	g_szId = Form.GetSharedData("&USER_ID" , false)	
End Sub

'============================================================================
' btnSetting_OnClick - 동시접속 설정 허용으로 변경
'============================================================================
Sub btnSetting_OnClick()
	DATAMANAGER.RequestTranData("obcsb_efif_167a")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	g_szPAndICheck = "Y" '동시접속 허용
	DATAMANAGER.SetDataValue(0, "obcsb_efif_167a", "InBlock1", "ELFN_ID" , 0 , g_szId)
	'DATAMANAGER.SetDataValue(0, "obcsb_efif_167a", "InBlock1", "CONN_PWD" , 0 , g_szPassword)
	DATAMANAGER.SetDataValue(0, "obcsb_efif_167a", "InBlock1", "CNCC_CONN_INFR_YN", 0 , g_szPAndICheck)	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	'동시접속 설정 변경을 위한 TR
	if szTranID == "obcsb_efif_167a" then
'		Dim szMsg
'		szMsg = DATAMANAGER.GetDataMsgText("obcsb_efif_167a")
'		if szMsg <> "" then
'			Form.MsgBox("알림", szMsg, "", 0)
'		end if'
		Form.SendReturnToParent("mhetc90000_p8" , "common.pandlcheck")
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	if szTranID == "obcsb_efif_167a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		Form.MsgBox("알림", szErrMsg.."("..szSubErr..")" , "", 0)
		Form.CloseForm()		
	end if
End Sub

'============================================================================
Sub ImgClose_OnClick()
	Form.CloseForm()
End Sub



