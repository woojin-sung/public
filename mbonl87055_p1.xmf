'--===========================================================================
' 01. 화 면 명 : 대용설정_대용질권설정/해지팝업
' 02. 화면설명 : 대용설정_대용질권설정/해지팝업
' 03. 작    성 : 2021.11.29 김수진
' 04. 수    정 : 
'--===========================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szRetData
Dim g_szState		'신청 : set, 해지 : cancel
Dim g_szType
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()

	g_szState = Form.GetOpenLinkData()		'신청 : set, 해지 : cancel
	if g_szState == null or g_szState == "" then
		Exit Sub
	end if

	If g_szState == "set" Then
		Form.SetScreenName("대용질권 설정")
		Table0.SetCellString( 6, 0, "설정수량" )
		Table0.SetCellString( 6, 2, "설정금액" )
	Else
		Form.SetScreenName("대용질권 해지")
		Table0.SetCellString( 6, 0, "해지수량" )
		Table0.SetCellString( 6, 2, "해지금액" )
	End If
	
	g_szRetData = "cancel"	

	Dim szName, nPrice, nAbleQty, nAmount
	
	szName = Form.GetSharedData("mbonl87055_t2_name" , false)
	nPrice = CDbl(Form.GetSharedData("mbonl87055_t2_price" , false))
	nAbleQty = CDbl(Form.GetSharedData("mbonl87055_t2_ableqty" , false))
	g_szType = Form.GetSharedData("mbonl87055_t2_type" , false) '추가
	
	'2024-03-12 CFD 채권대용추가
	If g_szType == "03" Then
		nAmount = nPrice * (nAbleQty/10)
	Else
		nAmount = nPrice * nAbleQty
	End If
	

	Table0.SetCellString( 0, 1, szName )
	Table0.SetCellString( 1, 1, nPrice )
	Table0.SetCellString( 2, 1, nAbleQty )
	Table0.SetCellString( 3, 1, nAmount )
End Sub

'============================================================================
' RdoGubun_OnClick(nIndex) : 금액기준 수량기준 선택
'============================================================================
Sub RdoGubun_OnClick(nIndex)
	EditInput.caption = ""
	
	if nIndex == 0 then
		Table0.SetCellString( 5, 0, "금액" )	
		
		EditInput.mask = "0,0,,원,0,,0,1,0"
	else
		Table0.SetCellString( 5, 0, "수량" )	
		
		EditInput.mask = "0,0,, ,0,,0,1,0"
	end if
	
	Table0.SetCellString( 7, 0, "" )
	Table0.SetCellString( 7, 2, "" )
End Sub

'============================================================================
' EditInput_OnEditComplete()
'============================================================================
Sub EditInput_OnEditComplete()
	Table0.SetCellString( 7, 0, "" )
	Table0.SetCellString( 7, 2, "" )
End Sub

'============================================================================
' ButtonRequest_OnClick ()
'============================================================================
Sub ButtonRequest_OnClick()
	Dim nSetPrice
	'금액기준
	if RdoGubun.currentindex == "0" then	
		if EditInput.caption == "" or EditInput.caption == "0" then
			Form.MsgBox( "알림", "금액을 확인하세요.", "", 6 )
			Exit Sub
		end if
		if CDbl(EditInput.caption) > CDbl(Table0.GetCellString( 3, 1 )) then
			Form.MsgBox( "알림", "가능금액을 초과합니다.", "", 6 )
			Exit Sub	
		end if
		
		Dim nAbleQty
		
		
		'2024-03-12 CFD 채권대용추가
		If g_szType == "03" Then
			nAbleQty = ( CDbl(EditInput.caption) / CDbl(Table0.GetCellString( 1, 1 )) ) * 10
		Else
			nAbleQty = CDbl(EditInput.caption) / CDbl(Table0.GetCellString( 1, 1 ))
		End If
		
		if nAbleQty == Int(nAbleQty) then
			nAbleQty = Int(nAbleQty)
		else
			nAbleQty = Int(nAbleQty) + 1
		end if
		Table0.SetCellString( 7, 0, nAbleQty )
		
		
		'2024-03-12 CFD 채권대용추가
		If g_szType == "03" Then
			nSetPrice = (nAbleQty/10) * CDbl(Table0.GetCellString( 1, 1 ))
		Else
			nSetPrice = nAbleQty * CDbl(Table0.GetCellString( 1, 1 ))
		End If
		
	'수량기준
	else
		if EditInput.caption == "" or EditInput.caption == "0" then
			Form.MsgBox( "알림", "수량을 확인하세요.", "", 6 )
			Exit Sub
		end if
		
		if CDbl(EditInput.caption) > CDbl(Table0.GetCellString( 2, 1 )) then
			Form.MsgBox( "알림", "가능수량을 초과합니다.", "", 6 )
			Exit Sub	
		end if
		
		Table0.SetCellString( 7, 0, EditInput.caption )
		
		'2024-03-12 CFD 채권대용추가
		If g_szType == "03" Then
			nSetPrice = (CDbl(EditInput.caption)/10) * CDbl(Table0.GetCellString( 1, 1 ))
		Else
			nSetPrice = CDbl(EditInput.caption) * CDbl(Table0.GetCellString( 1, 1 ))
		End If
	end if
	
	Table0.SetCellString( 7, 2, nSetPrice )
End Sub

'============================================================================
' ButtonOK_OnClick() : 확인 버튼
'============================================================================
Sub ButtonOK_OnClick()
	if CDbl(Table0.GetCellString( 7, 0 )) == 0 or CDbl(Table0.GetCellString( 7, 2 )) == 0 then
		If g_szState == "set" Then
			Form.MsgBox( "알림", "설정수량 및 설정금액을 확인하세요.", "", 6 )
		Else
			Form.MsgBox( "알림", "해지수량 및 해지금액을 확인하세요.", "", 6 )
		End If
		Exit Sub
	end if
	
	Form.SetSharedData("mbonl87055_t2_inputqty" , Table0.GetCellString( 7, 0 ))
	Form.SetSharedData("mbonl87055_t2_inputprc" , Table0.GetCellString( 7, 2 ))
	
	g_szRetData = "ok"
	Form.CloseForm()
End Sub

'============================================================================
' ButtonCancel_OnClick() : 취소 버튼
'============================================================================
Sub ButtonCancel_OnClick()
	Form.CloseForm() 
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl87055" , g_szRetData)
End Sub

