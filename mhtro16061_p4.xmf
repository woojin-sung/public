'============================================================================
Sub btnSave_OnClick()
	Form.SaveConfigData("mhtro16061", "mhtro16061_p4", "0" )
	Form.CloseForm()
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szPopup
	szPopup = Form.LoadConfigData( "mhtro16061", "mhtro16061_p4" )
	
	If szPopup == "1" Then
		Form.CloseForm()
	End If
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.SaveConfigData("mhtro16061", "mhtro16061_p4", "1" )
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
