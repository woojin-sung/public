'============================================================================
' 작성 : 2021.02.07. 장원혁
' 수정 : 2021.08.31 정효영 (v001) : 금소법_투자성향진단 내용에 따른 obcsb_acif_701r, obcsb_acif_712a 변경건 적용
'============================================================================

'전역변수 설정

Dim g_OsType

Dim unPressedImgPath 
Dim PressedImgPath

Dim Q1Answer
Dim Q2Answer
Dim Q3Answer

Dim aFlag '아코디언 플래그
Dim ChckFlag '체크 플래그
Dim AgrmRequiredFlag '동의 필요 여부

Dim g_RCNO_PIP
Dim g_CSNO
Dim g_CUST_FULL_NAME
Dim g_KYC_INVT_RCMD_CLS_CODE
Dim g_PXPR_RCNO_TYPE_CODE
Dim g_PXPR_RCNO
Dim g_PXPR_NAME
Dim g_CUST_RLTS_CODE
Dim g_CUST_RLTS_ETC_CNTT
Dim g_EXSN_QUES_YN
Dim g_RCMD_YN 
Dim g_INFO_OFER_YN
Dim g_GRADE_CUST

Dim nRet
Dim g_BDM_WEAK_FNNC_YN 

Dim g_ProsGb

Dim g_BDM_MANG_BRCD          '관리점

Dim g_nTryCnt '21.09.13 JHY 추가
'============================================================================
Sub Form_OnFormInit()
    ContainerBody.SetScrollAutoSize()    

    g_OsType = Form.GetSharedData("&OS_TYPE", False)
    
    BtnNext.enable = False
    szTheme = Form.GetEnvData("common.theme")
    BtnNext.fgcolor = "269"
    If szTheme == "white" Then
        BtnNext.btnimage = "btn_21.9"
    Else
        BtnNext.btnimage = "btn_27.9"
    End If
    
    unPressedImgPath = "input_03_n.9.png"
    PressedImgPath   = "input_03_o.9.png"

    Q1Answer = 0
    Q2Answer = 0
    Q3Answer = 0
    
    ContainerBody.ImgQ1A1.imgpath = unPressedImgPath
    ContainerBody.ImgQ1A2.imgpath = unPressedImgPath    
    
    ContainerBody.ImgQ2A1.imgpath = unPressedImgPath
    ContainerBody.ImgQ2A2.imgpath = unPressedImgPath    
    
    ContainerBody.ImgQ3A1.imgpath = unPressedImgPath
    ContainerBody.ImgQ3A2.imgpath = unPressedImgPath        

    aFlag = 0      
    ChckFlag = 0
    
    g_ProsGb = Form.GetOpenLinkData( )
    'NEW.신규/재진단 PASS.기존과 동일 StepBack.설문항목에서넘어온경우
    if g_ProsGb ~= "NEW" and g_ProsGb ~= "PASS" then  'and g_ProsGb ~= "StepBack" then
        '처리구분값 없는경우, 재진단 / 설문항목에서넘어온경우에도 신규(재)진단
        g_ProsGb = "NEW"
    end if
    
    g_RCNO_PIP       = Form.GetSharedData("BDM_RCNO_PIP", false )
    g_CUST_FULL_NAME = Form.GetSharedData("BDM_NAME"    , False)     
    g_BDM_MANG_BRCD  = Form.GetSharedData("BDM_MANG_BRCD"          , false)  '관리점
    
    
    DATAMANAGER.SetDataValue(0, "obcsb_acif_701r", "InBlock1", "RCNO"           , 0, "NMET"  )
    DATAMANAGER.SetDataValue(0, "obcsb_acif_701r", "InBlock1", "RCNO_PIP"       , 0, g_RCNO_PIP)
    DATAMANAGER.SetDataValue(0, "obcsb_acif_701r", "InBlock1", "RCNO_TYPE_CODE" , 0, "01"    )
    DATAMANAGER.RequestTranData("obcsb_acif_701r")      
       
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    if szTranID == "obcsb_acif_715a" then
        DATAMANAGER.SetDataValue(0 , "obcsb_acif_715a", "InBlock1", "CNSH_CLS_CODE"  , 0 , "09"     ) '확인서구분코드
        DATAMANAGER.SetDataValue(0 , "obcsb_acif_715a", "InBlock1", "RCNO_TYPE_CODE" , 0 , "01"     ) '실명확인번호 구분코드
        DATAMANAGER.SetDataValue(0 , "obcsb_acif_715a", "InBlock1", "RCNO_PIP"       , 0 , g_RCNO_PIP ) '실명확인번호 구분코드
	
        If Q3Answer == "2" or Q3Answer == 2 Then '취약금융소비자입니까? : 예
            DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a", "InBlock1", "CUST_CNFR_YN", 0 , "Y" )	'고객확인여부
        ElseIf Q3Answer == "1" or Q3Answer == 1 Then '취약금융소비자입니까? : 아니오
            DATAMANAGER.SetDataValue(0,  "obcsb_acif_715a", "InBlock1", "CUST_CNFR_YN", 0 , "N" )	'고객확인여부
        End If	    
    end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
    If szTranID = "obcsb_acif_701r" Then
    
	    szInvGradeIn = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "KYC_INVT_INCL_GRAD_CODE", 0)	
	    '	[KYC투자성향등급코드]
	    '	00@정보미제공
	    '	01@고수익지향형
	    '	02@성장지향형
	    '	03@중립형
	    '	04@안정지향형
	    '	05@이자소득형
'        If szInvGradeIn == "00" Or szInvGradeIn == "" Or szInvGradeIn == Null Then
'		
'        Else
'            szInvGradeOut = Form.GetMetaData("KYC투자성향등급코드", szInvGradeIn)
'        End If        
    
        g_CSNO                   = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "CSNO"                   , 0)
        g_GRADE_CUST             = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "KYC_INVT_INCL_GRAD_CODE", 0)
        g_KYC_INVT_RCMD_CLS_CODE = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "KYC_INVT_RCMD_CLS_CODE" , 0)
        g_PXPR_RCNO_TYPE_CODE    = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "PXPR_RCNO_TYPE_CODE"    , 0)
        g_PXPR_RCNO              = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "PXPR_RCNO"              , 0)
        g_PXPR_NAME              = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "PXPR_NAME"              , 0)
        g_CUST_RLTS_CODE         = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "CUST_RLTS_CODE"         , 0)
        g_CUST_RLTS_ETC_CNTT     = DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "CUST_RLTS_ETC_CNTT"     , 0)    
        
		'21.09.13 JHY START (v001)
		g_nTryCnt = CDbl(DATAMANAGER.GetDataValue(0 , "obcsb_acif_701r", "OutBlock1", "KYC_ACMP_TMNU"     , 0))
'
'		if CDbl(g_nTryCnt) <> NULL then
'			ContainerBody.tblTry.SetCellString(0, 1, g_nTryCnt & "회 ( 1일 3회까지 가능 )")
'		end if
		'21.09.13 JHY END

        '기존과 동일한 경우, 기등록정보로 처리
        If g_ProsGb == "PASS" then
            '1.투자권유희망+정보제공 2.투자권유희망+정보미제공 3.투자권유불원+정보제공 4.투자권유불원+정보미제공
		   szInvtRcmdGb = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "KYC_INVT_RCMD_CLS_CODE", 0)
            if szInvtRcmdGb == "1" or szInvtRcmdGb == 1 then
                ContainerBody_ImgQ1A2_OnClick()
                ContainerBody_ImgQ2A2_OnClick()
                'Q1Answer = "2"
                'Q2Answer = "2"
            elseif szInvtRcmdGb == "2" or szInvtRcmdGb == 2 then
                ContainerBody_ImgQ1A1_OnClick()
                ContainerBody_ImgQ2A2_OnClick()
                'Q1Answer = "1"
                'Q2Answer = "2"
            elseif szInvtRcmdGb == "3" or szInvtRcmdGb == 3 then
                ContainerBody_ImgQ1A2_OnClick()
                ContainerBody_ImgQ2A1_OnClick()
                'Q1Answer = "2"
                'Q2Answer = "1"
            elseif szInvtRcmdGb == "4" or szInvtRcmdGb == 4 then
                ContainerBody_ImgQ1A1_OnClick()
                ContainerBody_ImgQ2A1_OnClick()
                Q1Answer = "1"
                Q2Answer = "1"
            else
                Q1Answer = ""
                Q2Answer = ""
		   end if

            szWeakYN = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "WEAK_YN", 0)

            if szWeakYN == "Y" then
                ContainerBody_ImgQ3A2_OnClick()
                'Q3Answer = "2"
            elseif szWeakYN == "N" then
                ContainerBody_ImgQ3A1_OnClick()
                'Q3Answer = "1"
            else
                Q3Answer = ""
            end if

            'DATAMANAGER.RequestTranData("obcsb_acif_715a" )	'확인서 이력등록	
        End If
    End If
    
    If szTranID == "obcsb_acif_715a" Then
        
        If Q1Answer == "1" or Q1Answer == 1 Then
            Form.SetSharedData("BDM_RCMD_YN" , "N") ' 투자권유여부 : 아니오
            g_RCMD_YN = "N"
        ElseIf Q1Answer == "2" or Q1Answer == 2 Then
            Form.SetSharedData("BDM_RCMD_YN" , "Y") ' 투자권유여부 : 예
            g_RCMD_YN = "Y"
        End If	
	
        If Q2Answer == "1" or Q2Answer == 1 Then
            Form.SetSharedData("BDM_INFO_OFER_YN" , "N") '고객정보제공여부 : 아니오
            g_INFO_OFER_YN = "N"
        ElseIf Q2Answer == "2" or Q2Answer == 2 Then
            Form.SetSharedData("BDM_INFO_OFER_YN" , "Y") '고객정보제공여부 : 예
            g_INFO_OFER_YN = "Y"
        End If
	
        If g_INFO_OFER_YN == "Y" Then '정보제공인 경우
'			Form.ShowAlert("g_nTryCnt", g_nTryCnt)
			
			'21.09.14 JHY START
			if g_nTryCnt < 4 then
				Form.OpenPopup("mbbdm85142", g_ProsGb, "")
				g_ProsGb = ""
			else
				Form.ShowAlert("알림", "투자성향진단 등록은 1일 3회까지만 가능합니다 (등록횟수 초과)")
			end if
			'21.09.14 JHY END
	    
		    
        Else '정보미제공인경우, 바로 등록 
	    
            If g_INFO_OFER_YN <> "Y" Then 
                If Set712Input() == True Then
				'21.09.13 JHY START : 2회차부터 재진단 사유 표기
				if 1 < g_nTryCnt then
'					Form.ShowAlert("g_nTryCnt", g_nTryCnt)
					if g_nTryCnt < 4 then
						Form.OpenPopup("mbonl81010_p15" , "" , "")
					else
						Form.ShowAlert("알림", "투자성향진단 등록은 1일 3회까지만 가능합니다 (등록횟수 초과)")
					end if
				else
				    DATAMANAGER.RequestTranData("obcsb_acif_712a")
			    end if
                End If          
            End If
        End If
	
    End If
    
    If szTranID == "obcsb_acif_712a" Then
        ' 21.09.13 JHY START
		'	[KYC투자성향등급코드]
		'	00@정보미제공
		'	01@고수익지향형
		'	02@성장지향형
		'	03@중립형
		'	04@안정지향형
		'	05@이자소득형
	
		Dim szInvGradeIn, szInvGradeOut, szEntt, szTrust, szEnttName, szTrustName
		
		'만기일 추가
		Dim szKycValid, szEnttValid, szTrustValid			'일반투자성향만기일, 일임형만기일, 신탁만기일
	
		szInvGradeIn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_INVT_INCL_GRAD_CODE", 0)
		szEntt = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ENTT_IVIC_GRCD", 0)
		szTrust = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TRUST_IVIC_GRCD", 0)
		
		szKycValid = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "KYC_VALD_PRD_MTRT_DATE", 0)
		szEnttValid = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ENTT_KYC_MTRT_DATE", 0)
		szTrustValid = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "TRUST_KYC_MTRT_DATE", 0)
	
		' KYC꺼에 맵핑하면 된다고 권오상 차장님 확인
		szInvGradeOut = Form.GetMetaData("KYC투자성향등급코드", szInvGradeIn)
		szEnttName = Form.GetMetaData("KYC투자성향등급코드", szEntt)
		szTrustName = Form.GetMetaData("KYC투자성향등급코드", szTrust)

		Form.OpenPopup("mbbdm85143" , szInvGradeOut & "★" & szEnttName & "★" & szTrustName & "★" & szKycValid & "★" & szEnttValid & "★" & szTrustValid, "")  '진단완료
		' 21.09.13 JHY END
    End If    
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    If Trim(szSubMsg) == "" Then
        Form.MsgBox("알림" , szErrMsg, "", 6)
    Else
        Form.MsgBox("알림" , szErrMsg & Chr(13) & Chr(10) & "(" & szSubMsg & ")" , "", 6)
    End If	
    
End Sub

'============================================================================
Sub Common_Check()

    '1번 또는 2번을 '아니오'로 체크했으면 강제로 아코디언을 연다
    If Q1Answer == 1 Or Q2Answer == 1 Then 
    
        AgrmRequiredFlag = 1
        aFlag = 1  
'        ContainerBody.LblDummy.top = 1325
	
        ContainerBody.SetScrollAutoSize()
	
    Else
    
        AgrmRequiredFlag = 0
	
'        ContainerBody.LblDummy.top = 1265
        Form.SetTimerEvent("9999", 1, 1)
   
    End If
    
'    '1번 또는 2번을 '예'로 클릭했을 경우
'    If Q1Answer == 2 Or Q2Answer == 2 Then
'        If aFlag == 0 Then
'	
'            ContainerBody_BtnAccordion_OnClick()	
'	
'        End If
'    End If
    
    If (Q1Answer == "0" or Q1Answer == 0) Or (Q2Answer == "0" or Q2Answer == 0) Or (Q3Answer == "0" or Q3Answer == 0) Then
    
        BtnNext.enable = False
        BtnNext.fgcolor = "269"	
        szTheme = Form.GetEnvData("common.theme")
        If szTheme == "white" Then
            BtnNext.btnimage = "btn_21.9"
        Else
            BtnNext.btnimage = "btn_27.9"
        End If

    Else
        BtnNext.enable = True
        BtnNext.btnimage = "btn_20.9"
        BtnNext.fgcolor = "273"
	
'        If Q1Answer == 1 Or Q2Answer == 1 Then '1번 또는 2번 응답이 아니오 이면
'            ContainerBody.scroll_pos = 975
'        End If
	
    End If
    
End Sub

'============================================================================
Sub ContainerBody_ImgQ1A1_OnClick()

    Q1Answer = 1
    ContainerBody.ImgQ1A1.imgpath = PressedImgPath
    ContainerBody.ImgQ1A2.imgpath = unPressedImgPath                     
    
    '위의 처리와 동시에 2번항목 다시 선택할 수 있도록 활성화 처리
    ContainerBody.ImgQ2A1.enable = true
    ContainerBody.ImgQ2A2.enable = true
    
    Common_Check()
    
End Sub

'============================================================================
Sub ContainerBody_ImgQ1A2_OnClick()

    Q1Answer = 2
    ContainerBody.ImgQ1A1.imgpath = unPressedImgPath
    ContainerBody.ImgQ1A2.imgpath = PressedImgPath            
    
    Q2Answer = 2 '1번 문항 응답이 '예'인 경우 2번도 자동으로 '예' 선택
    ContainerBody.ImgQ2A1.imgpath = unPressedImgPath
    ContainerBody.ImgQ2A2.imgpath = PressedImgPath           
    
    '위의 처리와 동시에 2번항목 아니오 고르지 못하도록 비활성화 처리
    ContainerBody.ImgQ2A1.enable = false
    ContainerBody.ImgQ2A2.enable = false
    
    Common_Check()	
    
End Sub

'============================================================================
Sub ContainerBody_ImgQ2A1_OnClick()
    Q2Answer = 1
    ContainerBody.ImgQ2A1.imgpath = PressedImgPath
    ContainerBody.ImgQ2A2.imgpath = unPressedImgPath      
    Common_Check()	
End Sub

'============================================================================
Sub ContainerBody_ImgQ2A2_OnClick()
    Q2Answer = 2
    ContainerBody.ImgQ2A1.imgpath = unPressedImgPath
    ContainerBody.ImgQ2A2.imgpath = PressedImgPath          
    Common_Check()	
End Sub

