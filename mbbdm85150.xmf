'============================================================================
' 신규종합 입력 정보 체크
'============================================================================
Function chkDataFunction()
	
	'#이름 - 전단계에서 Setting 해주는 값이므로 help msg가 아니라 팝업
	If LEN(TRIM(ContMain.EdtName.caption)) < 0 Then
		Form.MsgBox("알림", "고객 정보를 정상적으로 읽지 못했습니다. 본인확인 절차로 돌아가십시오", "Exit", "2")  '2.예/아니오
		return False
	End If 

	'#주민등록번호 - 전단계에서 Setting 해주는 값이므로 help msg가 아니라 팝업
	If LEN(TRIM(ContMain.EdtEngName.caption)) < 0 Then
		Form.MsgBox("알림", "고객 정보를 정상적으로 읽지 못했습니다. 본인확인 절차로 돌아가십시오", "Exit", "2")  '2.예/아니오
		return False
	End If 
	
	'#영문명 - help msg 고객영문명을 확인하세요.
	If TRIM(ContMain.EdtEngName.caption) == "" Then				'아래의 문자열 길이로 판단하면 빈칸 넣어도 넘어갈 수 있음 
'	If LEN(TRIM(ContMain.EdtEngName.caption)) < 0 Then
		ContMain.EdtEngName.SetResultLabel("1","error","고객영문명을 확인하세요.","ContMain")
		ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.EdtEngName.top, "1")) '2021.05.01. 김유경.
		return False
	Else 
		ContMain.EdtEngName.SetResultLabel("0","complete","","ContMain")
	End If 	
	
	'#기본주소 - help msg 주소를 확인하세요.
	'2021.04.16 . 김유경 Butto0 -> RadioSelectGbn2 컨트롤 변경
	'If ContMain.Button0.switchIndex == "0" or ContMain.Button0.switchIndex == 0 Then	'자택
	If ContMain.RadioSelectGbn2.currentindex == "0" or ContMain.RadioSelectGbn2.currentindex == 0 Then
		If TRIM(g_OwhsPost) == "" Then
			ContMain.EdtAddr.SetResultLabel("1","error","주소를 확인하세요.","ContMain")
			ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.RadioSelectGbn2.top, "1")) '2021.05.01. 김유경.
			return False
		Else 
			ContMain.EdtAddr.SetResultLabel("0","complete","","ContMain")
		End If 
	Else								     '직장 
		If TRIM(g_CoPost) == "" Then
			ContMain.EdtAddr.SetResultLabel("1","error","주소를 확인하세요.","ContMain")
			ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.RadioSelectGbn2.top, "1")) '2021.05.01. 김유경.
			return False
		Else 
			ContMain.EdtAddr.SetResultLabel("0","complete","","ContMain")
		End If 
	End If 
	
	'#상세주소 - help msg 주소를 확인하세요.
	'2021.04.16 . 김유경 Butto0 -> RadioSelectGbn2 컨트롤 변경
	'If ContMain.Button0.switchIndex == "0"  or ContMain.Button0.switchIndex == 0 Then	'자택
	If ContMain.RadioSelectGbn2.currentindex == "0" or ContMain.RadioSelectGbn2.currentindex == 0 Then
		If TRIM(g_OwhsDtad) == "" Then
			ContMain.EdtAddr.SetResultLabel("1","error","주소를 확인하세요.","ContMain")
			ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.RadioSelectGbn2.top, "1")) '2021.05.01. 김유경.
			return False
		Else 
			ContMain.EdtAddr.SetResultLabel("0","complete","","ContMain")
		End If 
	Else									     '직장
		If TRIM(g_CoDtad) == "" Then
			ContMain.EdtAddr.SetResultLabel("1","error","주소를 확인하세요.","ContMain")
			ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.RadioSelectGbn2.top, "1")) '2021.05.01. 김유경.
			return False
		Else 
			ContMain.EdtAddr.SetResultLabel("0","complete","","ContMain")
		End If 	
	End If
	
	'#거래내역 통보 - help msg 거래내역 통보구분을 확인하세요.
	If ContMain.RadioSelectGbn0.currentindex == "-1" or ContMain.RadioSelectGbn0.currentindex == -1 Then
		ContMain.RadioSelectGbn0.SetResultLabel("1", "error","거래내역 통보구분을 확인하세요.","ContMain")
		ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.RadioSelectGbn2.top, "1"))
		return False
	End If 
	
	'#우편물 통보 - help msg 우편물 통보구분을 확인하세요.
	If ContMain.RadioSelectGbn1.currentindex == "-1" or ContMain.RadioSelectGbn1.currentindex == -1 Then
		ContMain.RadioSelectGbn1.SetResultLabel("1", "error","우편물 통보구분을 확인하세요.","ContMain")
		ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.RadioSelectGbn2.top, "1"))
		return False
	End If
		
	'#주소지 정보와 거래내역통보 불일치
	If (ContMain.RadioSelectGbn2.currentindex == "0" or ContMain.RadioSelectGbn2.currentindex == 0) and (ContMain.RadioSelectGbn0.currentindex == "2" or ContMain.RadioSelectGbn0.currentindex == 2)  Then
		ContMain.RadioSelectGbn0.SetResultLabel("1", "error","주소지구분과 거래내역통부구분 확인하세요.","ContMain")
		ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.RadioSelectGbn2.top, "1"))
		return False
	End If
	
	If (ContMain.RadioSelectGbn2.currentindex == "1" or ContMain.RadioSelectGbn2.currentindex == 1) and (ContMain.RadioSelectGbn0.currentindex == "1" or ContMain.RadioSelectGbn0.currentindex == 1)  Then
		ContMain.RadioSelectGbn0.SetResultLabel("1", "error","주소지구분과 거래내역통부구분 확인하세요.","ContMain")
		ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.RadioSelectGbn2.top, "1"))
		return False
	End If	
	
	'#이메일주소 - help msg 이메일주소을 확인하세요.
	If TRIM(ContMain.EdtEmail.caption) == "" Then
		ContMain.EdtEmail.SetResultLabel("0", "", "", "", 1)	'v0007 Email help msg 줄 수 설정설정 전 리셋(야후/핫메일 help msg 줄수로 인한)
		ContMain.EdtEmail.SetUseResultLabel(true, 1)			'v0007 Email help msg 줄 수 설정
		ContMain.EdtEmail.SetResultLabel("1","error","이메일을 확인하세요.(필수입력)","ContMain")
		ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.EdtEmail.top, "1")) '2021.05.01. 김유경.
		return False
	Else 
		ContMain.EdtEmail.SetResultLabel("0","complete","","ContMain")
	End If 
	
	'#이메일주소 - 야후 또는 핫메일 사용불가
	If Cint(InStr(ContMain.EdtEmail.caption, "@yahoo")) <> 0 Or Cint(InStr(ContMain.EdtEmail.caption, "@hotmail")) <> 0 Then
		ContMain.EdtEmail.SetUseResultLabel(true, 3)		
		ContMain.EdtEmail.SetResultLabel("1", "error","야후코리아(yahoo.co.kr), 핫메일(hotmail.com)\n계정은 사용이 불가합니다.","ContMain", 3)	'v0007
		return False
	Else
		ContMain.EdtEmail.SetResultLabel("0","complete","","ContMain")
	End If
	
	'#교부방식 - help msg 계약서류 제공 방법을 선택해 주세요.
	If f_CheckOnlyWrap() == False Then
		If ContMain.rdoProvision.currentindex == "-1" or ContMain.rdoProvision.currentindex == -1 Then 
			ContMain.rdoProvision.SetResultLabel("1","error","계약서류 제공 방법을 선택해 주세요.","ContMain")
			return False
		Else
			ContMain.rdoProvision.SetResultLabel("0","complete","","ContMain")
		End If	
	End If
	
	'#연금저축 - help msg 연금수익률보고서 통보처를 선택해 주세요.
	If getPRCD131 == "Y" Then
		If ContMain.rdoPension.currentindex == "-1" or ContMain.rdoPension.currentindex == -1 Then 
			ContMain.rdoPension.SetResultLabel("1","error","연금수익률보고서 통보처를 선택해 주세요.","ContMain")
			return False
		Else
			ContMain.rdoPension.SetResultLabel("0","complete","","ContMain")
		End If	
	End If
	
	return true
End Function 
