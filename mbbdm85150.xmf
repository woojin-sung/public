'============================================================================
Sub Form_OnFormInit()
	'2021.04.07. 김유경 추가
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	'******************************************************
	' 컨트롤 셋팅
	'******************************************************
	ControlSize = 10
	
	Image1.imgpath  = "icon_top_back_light"
	BtnNext.btnimage = "btn_20.9"
		
	ContMain.EdtName.fgcolor    = 267
	ContMain.EdtJumin.fgcolor   = 267
	ContMain.EdtEngName.fgcolor = 267
	ContMain.Label1.fgcolor     = 269
	
	closeFlag = "0"
	setRadioButtonData = -1
	sProsAbleYn  = 0
	sProsAbleYn1 = 0
	
	'***************************************************************
	'주의: Label5.top 처럼 top 값을 셋팅해주면 컨트롤 움직임 이상이
	'발생할 수있으므로 컨트롤.top 말고 숫자로 셋팅해줘야함.
	'***************************************************************
	'주소 정보 입력
	ContMain.EdtAddr.top    = 411 + 15 '주소지 정보 Lable2 + 간격
	ContMain.BtnAddr.top    = 411 + 15 '주소지 정보 Lable2 + 간격
	 
	'에디트 위에 다른 컨트롤이 올라가면 꼭 호출해줘야함
	ContMain.BtnAddr.bringFront("1")
	
	ContMain.EdtAddrDtl.top = 411 + 15 + 74 + 10 
	ContMain.BtnAddrDtl.top = 411 + 15 + 74 + 10
	
	'에디트 위에 다른 컨트롤이 올라가면 꼭 호출해줘야함
	ContMain.BtnAddrDtl.bringFront("1") 
		
	'거래내역 통보
	ContMain.Label3.top = 510 + 74 + 20
	ContMain.Label3.left = 18

	'거래내역 통보 라디오버튼
	ContMain.RadioSelectGbn0.top  = 604 + 20  + 10
	ContMain.RadioSelectGbn0.left = 20

	'우편물 통보
	ContMain.Label4.top = 634 + 50 + 20 
	ContMain.Label4.left = 18
	
	'우편물 통보 안내텍스트
	ContMain.Label8.top = 633 + 50 + 20 
	ContMain.Label8.left = 113
	
	
	'우편물 통보 라디오버튼
	ContMain.RadioSelectGbn1.top  = 704 + 20 + 10		
	ContMain.RadioSelectGbn1.left = 20
	
	'연락처
	ContMain.Label5.top = 734 + 50 + 30
	ContMain.Label5.left = 18

	ContMain.EdtPhone.top  = 814 + 20 + 10	  '연락처
	ContMain.EdtPhone.left = 20
	
	ContMain.EdtEmail.top   = 844  + 74   + 10 '이메일주소
	ContMain.EdtEmail.left  = 20
	ContMain.EdtOwhsNum.top = 928  + 74   + 10 '자택전화번호
	ContMain.EdtOwhsNum.left= 20
	ContMain.EdtWrplNum.top = 1012 + 74 + 10  '직장전화번호
	ContMain.EdtWrplNum.left= 20
	
	'v0007 STA : 계약서류 제공 방식 추가
	ContMain.lblProvision.top = 1096 + 74 + 20  
	ContMain.lblProvision.left= 20
	ContMain.rdoProvision.top = 1190 + 20 + 10  
	ContMain.rdoProvision.left= 20
	'v0007 END
	
	'연금수익률보고서 통보지 추가
	ContMain.lblPension.top = 1220 + 74
	ContMain.lblPension.left = 20
	ContMain.rdoPension.top = 1314 + 10
	ContMain.rdoPension.left = 20
	
	BtnNext.visible = False
	
	'*****************************************************
	'주의: init 했을 때 컨트롤 위치 셋팅 후 setApplyLabel
	'에디트 컨트롤 입력항목명 생성
	'*****************************************************
	ContMain.EdtName.setApplyLabel   ("이름" 	   , 0 , 268 , "left" , false)
	ContMain.EdtJumin.setApplyLabel  ("주민등록번호" , 0 , 268 , "left" , false)
	ContMain.EdtEngName.setApplyLabel("영문명"       , 0 , 268 , "left" , true)
	ContMain.EdtAddr.setApplyLabel   ("주소" 	   , 0 , 268 , "left" , true)
	ContMain.EdtAddrDtl.setApplyLabel("상세주소" 	   , 0 , 268 , "left" , true)	
	ContMain.EdtPhone.setApplyLabel  ("휴대폰번호"   , 0 , 268 , "left" , true)
	ContMain.EdtEmail.setApplyLabel  ("이메일 주소"  , 0 , 268 , "left" , true)
	ContMain.EdtOwhsNum.setApplyLabel("자택 전화번호", 0 , 268 , "left" , false)
	ContMain.EdtWrplNum.setApplyLabel("직장 전화번호", 0 , 268 , "left" , false)
	
	'Default값 셋팅 후 비활성화 컨트롤: 컨트롤 속성에서 사용가능으로 체크한 후에 setApplyLabel 아래에서 enable = False
	ContMain.EdtName.enable = False
	ContMain.EdtJumin.enable = False
	ContMain.EdtPhone.enable = False
	
	'help msg
	ContMain.EdtEmail.SetUseResultLabel(true,1)
	ContMain.RadioSelectGbn0.SetUseResultLabel(true,2)
	ContMain.EdtOwhsNum.SetUseResultLabel(true, 1) '2021.04.12.김유경. 자택/직장전화번호 체크 추가
	ContMain.EdtWrplNum.SetUseResultLabel(true, 1) '2021.04.12.김유경. 자택/직장전화번호 체크 추가
	ContMain.EdtEngName.SetUseResultLabel(true, 1) '2021.04.13.김유경. 영문명 help msg 추가
	'2021.04.14. 김유경 입력값 체크 추가
	ContMain.EdtAddr.SetUseResultLabel(true, 1)
	ContMain.EdtAddrDtl.SetUseResultLabel(true, 1)
	ContMain.RadioSelectGbn1.SetUseResultLabel(true,1)
	ContMain.rdoProvision.SetUseResultLabel(true,1)	'v0007 계약서류 제공 help msg 추가
	ContMain.rdoPension.SetUseResultLabel(true,1)		'연금수익률보고서 통보처 help msg 추가
	'****************
	' 컨트롤 초기화 
	'****************
	Call ContClear()
	
	'*****************************************************************************************
	' 데이터 셋팅
	'*****************************************************************************************
	gRCNO = Form.GetSharedData("BDM_RCNO_PIP"  , false ) '주민등록번호
	HP1	 = Form.GetSharedData("BDM_HP1"	      , false ) '휴대폰번호
	HP2 	 = Form.GetSharedData("BDM_HP2"	      , false )
	HP3 	 = Form.GetSharedData("BDM_HP3"	      , false )
	gRegUniqNo = Form.GetSharedData("BDM_REG_UNIQ_NO"  , false ) '등록고유번호
	gMaskRcno  = Form.GetSharedData("BDM_MaskRcno" , false)
	
	gPageID    = "3" '화면단계 구분
	ContMain.EdtPhone.caption = HP1 & "-" & HP2  & "-" & HP3
		
	'2021.04.15. 김유경. 이전화면 데이터 셋팅 추가
	Call GetSharedData_Setting()
		
	sRevData = Form.GetOpenLinkData()
	
	'이전 화면에서 돌아오면 컨트롤 모두보이기
	If sRevData == "StepBack" then
		'고객정보
		ContMain.Label6.visible     = true
		ContMain.EdtName.visible    = true
		ContMain.EdtJumin.visible   = true
		ContMain.EdtEngName.visible = true
		
		'주소지정보
		ContMain.Label2.visible     = true
		'ContMain.Button0.visible    = true
		ContMain.RadioSelectGbn2.visible    = true '2021.04.16. 김유경 Butto0 -> RadioSelectGbn2 컨트롤 변경
		ContMain.EdtAddr.visible    = true
		ContMain.EdtAddrDtl.visible = true
		ContMain.BtnAddr.visible    = true
		ContMain.BtnAddrDtl.visible = true
		
		'거래내역 통보
		ContMain.Label3.visible          = true
		ContMain.RadioSelectGbn0.visible = true
		
		
		'우편물 통보
		ContMain.Label4.visible          = true
		ContMain.Label8.visible          = true
		ContMain.RadioSelectGbn1.visible = true
		
		'연락처 정보
		ContMain.Label5.visible      = true
		
		ContMain.EdtPhone.visible    = true
		ContMain.EdtEmail.visible    = true
		ContMain.EdtOwhsNum.visible  = true
		ContMain.EdtWrplNum.visible  = true

		'계약서류 제공 정보
		'v0007 STA : 계약서류 제공 visible 설정
		ContMain.lblProvision.visible 	= true	
		ContMain.rdoProvision.visible 	= true		
		'v0007 END

		'입력한 정보 Setting
		ContMain.EdtName.caption    = getDataName
		ContMain.EdtJumin.caption   = gMaskRcno 'Form.GetSharedData( "BDM_MaskRcno" , false)
		ContMain.EdtEngName.caption = getDataEngname
		
		'주소지정보
		'2021.04.16 . 김유경 Butto0 -> RadioSelectGbn2 컨트롤 변경
		'Contmain.Button0.SetApplySwitch("자택","직장")
		If getDataAddrgbn == "01" Then
			'ContMain.Button0.switchIndex = "0"
			ContMain.RadioSelectGbn2.currentindex = "0"
		ElseIf getDataAddrgbn == "02" Then
			'ContMain.Button0.switchIndex = "1"
			ContMain.RadioSelectGbn2.currentindex = "1"
		End If
		
		ContMain.EdtRegnZip.caption	    = getDataRegnzip
		ContMain.EdtDtlZip.caption     = getDataDtlzip
		ContMain.EdtAddr.caption       = getDataAddr
		ContMain.EdtAddrDtl.caption    = getDataAddrdtl
		ContMain.CYN.caption           = getDataCyn
		ContMain.Cbldn.caption         = getDataCbldn
	
		If getDataAddrgbn = "01" Then
			'자택 주소
			g_OwhsRegnZip 	= ContMain.EdtRegnZip.caption 			
			g_OwhsDtlZip 		= ContMain.EdtDtlZip.caption			
			g_OwhsPost 		= ContMain.EdtAddr.caption					
			g_OwhsDtad 		= ContMain.EdtAddrDtl.caption				
			g_OwhsNwAddrUseYN	= ContMain.CYN.caption				
			g_OwhsBldnMnno 	= ContMain.Cbldn.caption				
					
		ElseIf getDataAddrgbn = "02" Then
			'직장 주소
			g_CoRegnZip 		= ContMain.EdtRegnZip.caption 				
			g_CoDtlZip 		= ContMain.EdtDtlZip.caption					
			g_CoPost 		= ContMain.EdtAddr.caption						
			g_CoDtad 		= ContMain.EdtAddrDtl.caption						
			g_CoNwAddrUseYN	= ContMain.CYN.caption		
			g_CoBldnMnno 		= ContMain.Cbldn.caption	
			
		End If
	
		'거래내역 통보
		If getDataSnmlclcd == "13" Then					'"13": 알림톡 추가
			ContMain.RadioSelectGbn0.currentindex = "0"
		ElseIf getDataSnmlclcd == "21" Then
			ContMain.RadioSelectGbn0.currentindex = "1"
		ElseIf getDataSnmlclcd == "01" Then
			ContMain.RadioSelectGbn0.currentindex = "2"
		ElseIf getDataSnmlclcd == "02" Then
			ContMain.RadioSelectGbn0.currentindex = "3"
		End If
		
		'우편물 통보
		If getDataMailclcd == "01" Then
			ContMain.RadioSelectGbn1.currentindex = "0"
		ElseIf getDataMailclcd == "02" Then
			ContMain.RadioSelectGbn1.currentindex = "1"
		End If
		
		ContMain.EdtEmail.caption    = getDataEmail
		ContMain.EdtOwhsNum.caption  = getDataOwhsnum
		ContMain.EdtWrplNum.caption  = getDataWrplnum
		
		'v0007 STA : 계약서류 제공 정보
		If getHndvMthdCd == "04" Then
			ContMain.rdoProvision.currentindex = "0"
		ElseIf getHndvMthdCd == "02" Then
			ContMain.rdoProvision.currentindex = "1"
		End If	
		'v0007 END
		
		'연금수익률보고서 통보처 유형코드
		If getPRCD131 == "Y" Then
			ContMain.lblPension.visible = true
			ContMain.rdoPension.visible = true
			If getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE == "99" Then
				ContMain.rdoPension.currentindex = "0"
			ElseIf getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE == "21" Then
				ContMain.rdoPension.currentindex = "1"
			ElseIf getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE == "01" Then
				ContMain.rdoPension.currentindex = "2"
			ElseIf getBDM_PNSN_ERT_RPRT_INAG_TYPE_CODE == "02" Then
				ContMain.rdoPension.currentindex = "3"
			End If
		End If
		
		If f_CheckOnlyWrap() Then
			'유효한 종합계좌 또는 CMA 계좌가 있는지 조회
			'있으면 계약서류발송방식 영역을 보여줌
			
			'비대면용 설정가능계좌 내역조회
			DATAMANAGER.RequestTranData( "obaci_nmet_016r" )
			
'			ContMain.lblProvision.visible = false
'			ContMain.rdoProvision.visible = false
		End If
		
		
		BtnNext.visible = True
		'ContMain.scroll_pos = 1194
		ContMain.setScrollAutoSize()
	Else
		DATAMANAGER.RequestTranData("obaci_acct_072r")
	End If
	
	
End Sub

'============================================================================
Sub ContMain_EdtEngName_OnEditComplete()
	If Str_Chk(ContMain.EdtEngName.caption, "ENG_NAME") == False then		 
		ContMain.EdtEngName.SetResultLabel("1","error","고객영문명은 영문만 입력 가능합니다.","ContMain")
		Exit Sub
	Else
		ContMain.EdtEngName.SetResultLabel("0","complete","","ContMain")
	End If
	
	if Trim(ContMain.EdtEngName.caption) <> "" then
		
		'주소지정보 라벨 
		ContMain.Label2.visible  = true
		
		'직장/자택 선택버튼
		'2021.04.16 . 김유경 Butto0 -> RadioSelectGbn2 컨트롤 변경
		'ContMain.Button0.visible = true
		'Contmain.Button0.SetApplySwitch("자택","직장")
		'Contmain.Button0.switchIndex = 0
		ContMain.RadioSelectGbn2.visible = true
		ContMain.RadioSelectGbn2.currentindex = "-1"
		
		'주소입력 에디트
		ContMain.EdtAddr.visible = true
		ContMain.BtnAddr.visible = true
		
		'상세주소 입력에디트 
		ContMain.EdtAddrDtl.visible = true
		ContMain.BtnAddrDtl.visible = true
		
		Form.SetTimerEvent2(2, 1, 0.6)	
	End if
End Sub

'============================================================================
'주소지정보 입력완료
'============================================================================
Sub ContMain_EdtAddr_OnEditComplete()
	If ContMain.EdtAddr.caption <> "" then
		'상세주소 입력에디트 
		ContMain.EdtAddrDtl.visible = true
	End if
	
End Sub
'============================================================================
'상세주소 정보 입력완료
'============================================================================
Sub ContMain_EdtAddrDtl_OnEditComplete()
	If ContMain.EdtAddrDtl.caption <> ""  then

		'스크롤 이동은 timerEvent 함수에서 발생시키지만 예외CASE
		nLabStndTop = 1034
		nCtrlTop = Cint(Form.calcUnResize(ContMain.EdtAddr.top, "1"))
		ContMain.LabStnd.top = nLabStndTop
		ContMain.setScrollAutoSize()
		ContMain.scroll_pos = nCtrlTop

		'거래내역통보 라벨
		ContMain.Label3.visible = true
	
		'이메일/자택/직장 라디오버튼
		ContMain.RadioSelectGbn0.visible = true
		
		'우편물통보
		ContMain.Label4.visible = true
		ContMain.Label8.visible = true
	
		'자택/직장 라디오버튼
		ContMain.RadioSelectGbn1.visible = true
		ContMain.RadioSelectGbn1.currentindex = setRadioButtonData '20210308 데이터 셋팅
	End if
	
End Sub

'============================================================================
' 거래내역 통보 라디오버튼
'============================================================================
Sub ContMain_RadioSelectGbn0_OnClick(nIndex)
	'우편물통보
	ContMain.Label4.visible = true
	ContMain.Label8.visible = true
	
	'자택/직장 라디오버튼
	ContMain.RadioSelectGbn1.visible = true
	'ContMain.RadioSelectGbn1.currentindex = setRadioButtonData '20210308 데이터 셋팅
	
	If nIndex == 0 Then
		'2021.04.08. 김유경 수정
		'ContMain.RadioSelectGbn0.SetResultLabel("1", "error","자택 또는 직장으로 선택하시는 경우 주소에서\n 선택한 통보처와 동일하게 선택 가능합니다.","ContMain")
		'ContMain.RadioSelectGbn0.currentindex = "-1"
		ContMain.RadioSelectGbn0.SetResultLabel("0", "complete", "", "ContMain") 'helpmsg Reset
		Call ContMain_RadioSelectGbn1_OnClick()
	ElseIf nIndex == 1  or nIndex == 2  Then
		'2021.04.08. 김유경 수정
		If nIndex == 1 Then
			
			'2021.04.14. 김유경. 선택 시 주소 입력 되었는 지 체크
			'#기본주소 - help msg 주소를 확인하세요.
			'2021.04.16 . 김유경 Butto0 -> RadioSelectGbn2 컨트롤 변경
			'If ContMain.Button0.switchIndex == "0" or ContMain.Button0.switchIndex == 0 Then	'자택
			If ContMain.RadioSelectGbn2.currentindex == "0" or ContMain.RadioSelectGbn2.currentindex == 0 Then
				If TRIM(g_OwhsPost) == "" Then
					ContMain.EdtAddr.SetResultLabel("1","error","주소를 확인하세요.","ContMain")
					ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.RadioSelectGbn2.top, "1")) '2021.05.01. 김유경.
					Exit Sub
				Else 
					ContMain.EdtAddr.SetResultLabel("0","complete","","ContMain")
				End If 
			End If 
				
			'If  ContMain.Button0.switchIndex == "1" Then
			If ContMain.RadioSelectGbn2.currentindex == "1" or ContMain.RadioSelectGbn2.currentindex == 1 Then
				ContMain.RadioSelectGbn0.SetResultLabel("1", "error","자택 또는 직장으로 선택하시는 경우 주소에서\n 선택한 통보처와 동일하게 선택 가능합니다.","ContMain")
				ContMain.RadioSelectGbn0.currentindex = "-1"
				Exit Sub
			Else
				ContMain.RadioSelectGbn0.SetResultLabel("0", "complete", "", "ContMain")
				Call ContMain_RadioSelectGbn1_OnClick()
			End If
		Else
			'2021.04.14. 김유경. 선택 시 주소 입력 되었는 지 체크
			'#기본주소 - help msg 주소를 확인하세요.
			'2021.04.16 . 김유경 Butto0 -> RadioSelectGbn2 컨트롤 변경
			'If ContMain.Button0.switchIndex == "1" or ContMain.Button0.switchIndex == 1 Then '직장 
			If ContMain.RadioSelectGbn2.currentindex == "1" or ContMain.RadioSelectGbn2.currentindex == 1 Then
				If TRIM(g_CoPost) == "" Then
					ContMain.EdtAddr.SetResultLabel("1","error","주소를 확인하세요.","ContMain")
					ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.RadioSelectGbn2.top, "1")) '2021.05.01. 김유경.
					Exit Sub
				Else 
					ContMain.EdtAddr.SetResultLabel("0","complete","","ContMain")
				End If 
			End If 
			
			'If ContMain.Button0.switchIndex == "0" Then
			If ContMain.RadioSelectGbn2.currentindex == "0" or ContMain.RadioSelectGbn2.currentindex == 0 Then
				ContMain.RadioSelectGbn0.SetResultLabel("1", "error","자택 또는 직장으로 선택하시는 경우 주소에서\n 선택한 통보처와 동일하게 선택 가능합니다.","ContMain")
				ContMain.RadioSelectGbn0.currentindex = "-1"	
				Exit Sub
			Else 
				ContMain.RadioSelectGbn0.SetResultLabel("0", "complete", "", "ContMain")
				Call ContMain_RadioSelectGbn1_OnClick()
			End If 
		End If 
	End if
	ContMain.EdtAddr.SetResultLabel("0","complete","","ContMain")
End Sub

'============================================================================
' 우편물통보 라디오버튼
'============================================================================
Sub ContMain_RadioSelectGbn1_OnClick(nIndex)
	'2021.04.12. 김유경. 거래내역 통보 선택 여부 로직 추가
	If ContMain.RadioSelectGbn0.currentindex <> "-1" and ContMain.RadioSelectGbn0.currentindex <> -1 Then 
	
		'연락처정보 라벨
		ContMain.Label5.visible = true
		
		'연락처정보 입력에디트
		ContMain.EdtPhone.visible = true
		
		'이메일주소
		ContMain.EdtEmail.visible = true
			
		If TRIM(ContMain.EdtEmail.caption) <> "" Then  '2021.03.30 수정
			'2021.04.05 obaci_acct_049c 입력값 체크 완료 시 다음버튼 활성화
			'BtnNext.visible = True	
			'DATAMANAGER.RequestTranData("obaci_acct_049c") '2021.04.14. 김유경 다음버튼 눌렀을 때 콜로 변경
			
			'2021.04.14. 김유경. 콜 위치 변경
			BtnNext.visible = True
		Else
			BtnNext.visible = True '2021.04.26. 김유경. 순번 277 관련 수정
			
			Form.SetTimerEvent2(4, 1, 0.4)
		End If 
		
		'자택전화번호
		ContMain.EdtOwhsNum.visible = true
		
		'직장전화번호
		ContMain.EdtWrplNum.visible = true
		
		'v0007 STA
		'교부방식
		If f_CheckOnlyWrap() == False then
			ContMain.lblProvision.visible = true
			ContMain.rdoProvision.visible = true
		Else
			'유효한 종합계좌 또는 CMA 계좌가 있는지 조회
			'있으면 계약서류발송방식 영역을 보여줌
			
			'비대면용 설정가능계좌 내역조회
			DATAMANAGER.RequestTranData( "obaci_nmet_016r" )
			
'			ContMain.lblProvision.visible = false
'			ContMain.rdoProvision.visible = false
		End If
		'v0007 END
		
		'2021.04.18. 김유경. 주소지정보 변경 시 거래내역 통보 리셋. 포커스 이동
		If ContMain.RadioSelectGbn0.currentindex <> "-1" and ContMain.RadioSelectGbn0.currentindex <> -1 Then
			'If Trim(ContMain.EdtAddr.caption) <> "" Then '2021.04.30. 김유경 로직 추가
				Form.SetTimerEvent2(3, 1, 0.4)
			'End If
		End If 
	End If
End Sub

'============================================================================
' 계약서류 제공 라디오 선택 v0007
'============================================================================
Sub ContMain_rdoProvision_OnClick(nIndex)
	If ContMain.rdoProvision.currentindex <> "-1" and ContMain.rdoProvision.currentindex <> -1 Then 
		
		'이메일 선택했을 경우 이메일 에디트 빈값이면 알럿 메시지 생성
		If ContMain.rdoProvision.currentindex == "1" or ContMain.rdoProvision.currentindex == 1 Then 	
			If TRIM(ContMain.EdtEmail.caption) == "" Then  
				ContMain.EdtEmail.SetResultLabel("0", "", "", "", 1)	'v0007 Email help msg 줄 수 설정설정 전 리셋(야후/핫메일 help msg 줄수로 인한)
				ContMain.EdtEmail.SetUseResultLabel(true, 1)			'v0007 Email help msg 줄 수 설정
				ContMain.EdtEmail.SetResultLabel("1","error","이메일 주소를 입력해 주세요.","ContMain")
			End If			
		End If
		
		ContMain.rdoProvision.SetResultLabel("0","complete","","ContMain")
		
		'연금저축 개설케이스라면 포커스 변경
		If g_szPnsnYn == "Y" Then
			Form.SetTimerEvent2(5, 1, 0.4)
		End If
	End If
End Sub

'============================================================================
' 다음버튼 
'============================================================================
Sub BtnNext_OnClick()

	If sProsAbleYn < 1 and sProsAbleYn1 < 1 Then
		Call SetSharedData()
		
		DATAMANAGER.RequestTranData("obaci_acct_049c") '2021.04.14. 김유경 다음버튼 눌렀을 때 콜로 변경
	End If 

End Sub

'===========================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obaci_acct_072r" Then
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"	 	 , 0 , gRCNO      )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE"     , 0 , "2"		)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_UNIQ_NO"		 , 0 , gRegUniqNo	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "REG_STAG_CLS_CODE" , 0 , gPageID	)
		
	ElseIf szTranID = "obcsb_acif_809r" Then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 0, gRCNO)
	ElseIf szTranID = "obcsb_acif_809r_1" Then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 0, gRCNO)
	'2021.04.05 각 화면에서 입력값 체크하도록 수정
	ElseIf szTranId = "obaci_acct_049c" Then
		'Call SetData()
			
		'공통-필수(InBlock1)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_UNIQ_NO" 		 , 0 , gRegUniqNo	) '등록고유번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_STAG_CLS_CODE" 	 , 0 , "A"	     ) '등록단계구분코드

		'3단계-고객정보(InBlock5)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "ACNT_OPNG_CLCD" 	 , 0 , getDataAcntopngclcd		  ) '계좌개설구분코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CUST_ABWR_NAME" 	 , 0 , ContMain.EdtName.caption   ) '고객약어명
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CUST_ENG_NAME" 		 , 0 , ContMain.EdtEngName.caption) '고객영문명
		
		'DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_ADDR_SRNO" 		, 0 , getOwhsAddrSrno		     ) '자택주소일련번호
		'DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_ADDR_SRNO" 			, 0 , getCoAddrSrno		     ) '회사주소일련번호
		'DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "EMAIL_ADDR_SRNO" 		, 0 , getEmailAddrSrno		     ) '이메일주소일련번호	
	
		'2021.04.16 . 김유경 Butto0 -> RadioSelectGbn2 컨트롤 변경
'		If ContMain.Button0.switchIndex == "0" Then
'			g_InagTypeCode = "01"
'		ElseIf ContMain.Button0.switchIndex == "1" Then
'			g_InagTypeCode = "02"
'		End If
		If ContMain.RadioSelectGbn2.currentindex == "0" or ContMain.RadioSelectGbn2.currentindex == 0 Then
			g_InagTypeCode = "01"
		ElseIf ContMain.RadioSelectGbn2.currentindex == "1" or ContMain.RadioSelectGbn2.currentindex == 1 Then
		     g_InagTypeCode = "02"
		End If 
		
		If g_InagTypeCode ="01" Then '주소지정보: 자택 
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_REGN_ZIP" 		     , 0 , ContMain.EdtRegnZip.caption 	) '자택지역우편번호
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_DTL_ZIP" 			 , 0 , ContMain.EdtDtlZip.caption   ) '자택상세우편번호
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_POST" 			 , 0 , ContMain.EdtAddr.caption     ) '자택우편주소
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_DTAD" 			 , 0 , ContMain.EdtAddrDtl.caption  ) '자택상세주소
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_NW_ADDR_USE_YN"      , 0 , ContMain.CYN.caption ) '자택신주소사용여부
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_BLDN_MNNO" 		 , 0 , ContMain.Cbldn.caption    ) '자택건물관리번호
		ElseIf g_InagTypeCode ="02" Then '주소지정보: 직장 
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_REGN_ZIP" 			 , 0 , ContMain.EdtRegnZip.caption 	) '회사지역우편번호
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_DTL_ZIP" 			 , 0 , ContMain.EdtDtlZip.caption  	) '회사상세우편번호
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_POST" 				 , 0 , ContMain.EdtAddr.caption     ) '회사우편주소
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_DTAD" 				 , 0 , ContMain.EdtAddrDtl.caption  ) '회사상세주소
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_NW_ADDR_USE_YN"        , 0 , ContMain.CYN.caption     	) '회사신주소사용여부
			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_BLDN_MNNO" 			 , 0 , ContMain.Cbldn.caption   	) '회사건물관리번호
		End If
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "EMAIL_ADDR" 			 , 0 , ContMain.EdtEmail.caption) '이메일주소
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_ARCD" 			 , 0 , g_OwhsArcd ) '자택지역번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_TONO" 			 , 0 , g_OwhsTono ) '자택국번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_TELNO" 			 , 0 , g_OwhsTelno) '자택전화번호

		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_ARCD" 				 , 0 , g_CoArcd ) '회사지역번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_TONO" 				 , 0 , g_CoTono ) '회사국번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_TELNO" 				 , 0 , g_CoTelno) '회사전화번호

		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CLPH_ARCD" 			 , 0 , HP1	) '휴대폰지역번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CLPH_TONO" 			 , 0 , HP2	) '휴대폰국번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CPNO" 					 , 0 , HP3	) '휴대폰번호
		
		If ContMain.RadioSelectGbn0.currentindex == "0" Then
			g_SnmlInagTypeCode = "13"
		ElseIf ContMain.RadioSelectGbn0.currentindex == "1" Then
			g_SnmlInagTypeCode = "21"
		ElseIf ContMain.RadioSelectGbn0.currentindex == "2" Then
			g_SnmlInagTypeCode = "01"
		ElseIf ContMain.RadioSelectGbn0.currentindex == "3" Then
			g_SnmlInagTypeCode = "02"
		End If
		
		'우편물통보
		If ContMain.RadioSelectGbn1.currentindex == "0" Then
			g_MailInagTypCode = "01"
		Else
			g_MailInagTypCode = "02"
		End If
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "SNML_INAG_TYPE_CODE"      , 0 , g_SnmlInagTypeCode ) '발송물통보처유형코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "MAIL_INAG_TYPE_CODE"      , 0 , g_MailInagTypCode  ) '우편물통보처유형코드	

		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "OWHS_CNPL_SRNO" 		 , 0 , "0"			) '자택연락처일련번호	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CO_CNPL_SRNO" 			 , 0 , "0"			) '회사연락처일련번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "CLPH_CNPL_SRNO" 		 , 0 , "0"			) '휴대폰연락처일련번호

		'v0007 STA: 계약서류 제공 방식 추가 
'		If f_CheckOnlyWrap() == False Then
			If ContMain.rdoProvision.currentindex == "0" or ContMain.rdoProvision.currentindex == 0 Then
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "HNDV_MTHD_CODE" 		 , 0 , "04"			) '교부방식
			ElseIf ContMain.rdoProvision.currentindex == "1" or ContMain.rdoProvision.currentindex == 1 Then
			    DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "HNDV_MTHD_CODE" 		 , 0 , "02"			) '교부방식
			End If
'		Else
'			DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "HNDV_MTHD_CODE" 		 , 0 , ""			)
'		End If
		'v0007 FIN
		
		'연금저축 추가
		'연금수익률보고서 통보처 유형코드
		If getPRCD131 == "Y" Then
			If ContMain.rdoPension.currentindex == "0" or ContMain.rdoPension.currentindex == 0 Then
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "PNSN_ERT_RPRT_INAG_TYPE_CODE" 		 , 0 , "99"  ) 
			ElseIf ContMain.rdoPension.currentindex == "1" or ContMain.rdoPension.currentindex == 1 Then
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "PNSN_ERT_RPRT_INAG_TYPE_CODE" 		 , 0 , "21"  ) 
			ElseIf ContMain.rdoPension.currentindex == "2" or ContMain.rdoPension.currentindex == 2 Then
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "PNSN_ERT_RPRT_INAG_TYPE_CODE" 		 , 0 , "01"  ) 
			ElseIf ContMain.rdoPension.currentindex == "3" or ContMain.rdoPension.currentindex == 3 Then
				DATAMANAGER.SetDataValue(0, szTranID , "InBlock5",  "PNSN_ERT_RPRT_INAG_TYPE_CODE" 		 , 0 , "02"  ) 
			End If
		End If
	
	'비대면용 설정가능계좌 조회
	ElseIf szTranID == "obaci_nmet_016r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "BSWR_CLS_CODE"            , 0 , "2"	)		' "2": 랩 계약시 입금가능한 계좌리스트 조회(종합매매/CMA)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"            , 0 , gRCNO	)
	End If
End Sub
	
'===========================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obaci_acct_072r" Then
	 
		g_sUserName	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "CUST_ABWR_NAME"  	  , 0)
		g_MaskRCNO	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock3" , "UI_RCNO"	     	  , 0)
		
		ContMain.EdtName.caption  = g_sUserName
		ContMain.EdtJumin.caption = g_MaskRCNO
		
		'연금저축 개설여부 판단
		Dim szPnsnYn
		szPnsnYn = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock5" , "PNSN_SVNG_ACNT_APLT_YN" , 0 )
		If szPnsnYn == "Y" Then
			ContMain.lblPension.visible = true
			ContMain.rdoPension.visible = true
		Else
			ContMain.lblPension.visible = false
			ContMain.rdoPension.visible = false
		End If
		g_szPnsnYn = szPnsnYn
		
		If f_CheckOnlyWrap() Then
			'유효한 종합계좌 또는 CMA 계좌가 있는지 조회
			'있으면 계약서류발송방식 영역을 보여줌
			
			'비대면용 설정가능계좌 내역조회
			DATAMANAGER.RequestTranData( "obaci_nmet_016r" )
			
'			ContMain.lblProvision.visible = false
'			ContMain.rdoProvision.visible = false
		End If
		 
		'기고객 유무 판단 TR 호출
		DATAMANAGER.RequestTranData("obcsb_acif_809r")
		
	ElseIf szTranID = "obcsb_acif_809r" Then
		bOLD 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "EXSN_CUST_YN", 0 ) '기존고객여부
		g_CSNO 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CSNO"		 , 0 ) '고객번호
		s_CustEngName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CUST_ENG_NAME", 0 ) '영문명
		
		ContMain.EdtEngName.caption = s_CustEngName
		
		If LEN(TRIM(ContMain.EdtEngName.caption)) > 0 Then
			ContMain.EdtEngName.enable = False
			'2021.04.13. 김유경 아래 Call 주석. 로직 추가
			'Call ContMain_EdtEngName_OnEditComplete()
			
			if ContMain.EdtEngName.caption <> "" then
	
				'주소지정보 라벨 
				ContMain.Label2.visible  = true
				
				'직장/자택 선택버튼
				'2021.04.16 . 김유경 Butto0 -> RadioSelectGbn2 컨트롤 변경
'				ContMain.Button0.visible = true
'				Contmain.Button0.SetApplySwitch("자택","직장")
'				Contmain.Button0.switchIndex = 0
				ContMain.RadioSelectGbn2.visible = true
				
				'주소입력 에디트
				ContMain.EdtAddr.visible = true
				ContMain.BtnAddr.visible = true
				
				'상세주소 입력에디트 
				ContMain.EdtAddrDtl.visible = true
				ContMain.BtnAddrDtl.visible = true
				
				'Form.SetTimerEvent2(2, 1, 0.6)
			End if
			'2021.04.13 fin
	
			'애니메이션#1 - CALL
			Form.SetTimerEvent2(1, 1, 0.6)
		
		Else 
			
			ContMain.EdtEngName.enable = True
			Form.SetTimerEvent2(1, 1, 0.6)
			
		End If
		
		'AS-IS 와 동일하게 기존고객(bOLD="Y"), 신규종합(bNewYn = "Y")인 경우 등록되어있는 고객 주소 Setting.
		If bOLD == "Y" Then
			'자택 주소
			g_OwhsRegnZip 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_OWHS_REGN_ZIP" 		, 0) 
			g_OwhsDtlZip 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_OWHS_DTL_ZIP" 		, 0) 	
			g_OwhsPost 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_OWHS_POST" 			, 0) 
			g_OwhsDtad 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_OWHS_DTAD" 			, 0) 	
			g_OwhsNwAddrUseYN 	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_OWHS_NW_ADDR_USE_YN" 	, 0)
			g_OwhsBldnMnno 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_OWHS_BLDN_MNNO" 		, 0)		
			
			'직장 주소
			g_CoRegnZip 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_CO_REGN_ZIP" 			, 0)
			g_CoDtlZip 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_CO_DTL_ZIP" 			, 0)
			g_CoPost 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_CO_POST"				, 0)
			g_CoDtad 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_CO_DTAD" 				, 0)
			g_CoNwAddrUseYN 		= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_WRPL_NW_ADDR_USE_YN" 	, 0)
			g_CoBldnMnno 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "UI_WRPL_BLDN_MNNO" 		, 0)
			
			'자택 연락처
			g_OwhsArcd 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OWHS_ARCD" 				, 0)
			g_OwhsTono 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OWHS_TONO" 				, 0)
			g_OwhsTelno 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "OWHS_TLPH_SRNO" 			, 0)
			
			'직장 연락처
			g_CoArcd 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CO_ARCD" 				, 0)
			g_CoTono 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CO_TONO" 				, 0)
			g_CoTelno 			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CO_TELNO2" 				, 0)	
			g_EmailAddr			= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "EMAIL_ADDR" 				, 0)	
			
			'2021.04.16. 김유경 Butto0 -> RadioSelectGbn2 컨트롤 변경 및 디폴드 값 삭제에 따라 주석 처리
			'자택 주소        
'			ContMain.EdtRegnZip.caption  = g_OwhsRegnZip 		  
'			ContMain.EdtDtlZip.caption   = g_OwhsDtlZip 			
'			ContMain.EdtAddr.caption     = g_OwhsPost 		    
'			ContMain.EdtAddrDtl.caption  = g_OwhsDtad 			  
'			ContMain.CYN.caption         = g_OwhsNwAddrUseYN  
'			ContMain.Cbldn.caption       = g_OwhsBldnMnno 				
			
			'직장 주소(Default 는 자택이므로 직장을 눌렀을 때 직장으로 셋팅)
			
			'가져온 후 샘플 전화번호에 해당되는지 체크
			If Trim(g_OwhsArcd) <>  "" and Trim(g_OwhsTono) <>  "" and Trim(g_OwhsTelno) <>  "" THen 
				'자택 연락처        
				ContMain.EdtOwhsNum.caption = g_OwhsArcd & "-" & g_OwhsTono &  "-" & g_OwhsTelno
				f_ChkPhoneNum("Home")
			End If
			
			If Trim(g_CoArcd) <>  "" and Trim(g_CoTono) <>  "" and Trim(g_CoTelno) <>  "" THen 
				'직장 연락처 
				ContMain.EdtWrplNum.caption = g_CoArcd & "-" & g_CoTono & "-" & g_CoTelno
				f_ChkPhoneNum("Office")
			End If 
			
			'이메일주소
			ContMain.EdtEmail.caption    = g_EmailAddr
			
			'가져온 이메일이 yahoo 또는 hotmail 인지 체크
			If Cint(InStr(ContMain.EdtEmail.caption, "@yahoo")) <> 0 Or Cint(InStr(ContMain.EdtEmail.caption, "@hotmail")) <> 0 Then
				ContMain.EdtEmail.SetUseResultLabel(true, 3)		
				ContMain.EdtEmail.SetResultLabel("1", "error","야후코리아(yahoo.co.kr), 핫메일(hotmail.com)\n계정은 사용이 불가합니다.","ContMain", 3)	'v0007
			Else
				ContMain.EdtEmail.SetResultLabel("0", "", "", "", 1)
				ContMain.EdtEmail.SetUseResultLabel(true, 1)		
			End If
			
		End If
	'2021.04.05 추가
	'3단계 완료 전 입력값 체크
	ElseIf szTranID = "obaci_acct_049c" Then
		'2021.04.14. 김유경. 콜 위치 변경
		'BtnNext.visible = True
		Dim chkData
		chkData = False
			
		chkData = chkDataFunction() '고객주소정보 입력값 검증
	
		If chkData == True Then
			'20210308 HWG START	
			closeFlag = "1"
			Form.OpenNextPopup("mbbdm85151" , "" , "")
			'20210308 HWG END
		End If
	
	'비대면용 설정가능계좌 조회
	ElseIf szTranID == "obaci_nmet_016r" Then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "IQRY_CSNU" , 0)			'조회건수
		
		'랩 계약시 입금가능한 계좌가 없음
		'계좌가 없는 경우는 이전 단계에서 예외처리 되겠지만... 일단 내용 추가
		If CInt(nCnt) == 0 Then
			ContMain.lblProvision.visible = false
			ContMain.rdoProvision.visible = false
		Else
			ContMain.lblProvision.visible = true
			ContMain.rdoProvision.visible = true
		End If
	End If
End Sub 

'============================================================================
'SetSharedData
'============================================================================
Function SetSharedData()
	
	If ContMain.RadioSelectGbn2.currentindex == "0" or ContMain.RadioSelectGbn2.currentindex == 0 Then
		g_InagTypeCode = "01"
	ElseIf ContMain.RadioSelectGbn2.currentindex == "1" or ContMain.RadioSelectGbn2.currentindex == 1 Then
	     g_InagTypeCode = "02"
	End If 
		
	'JMY 현재화면상 입력된 정보로 설정
'	ContMain.EdtRegnZip.caption  = Trim(s_AD_REGN_ZIP)
'	ContMain.EdtDtlZip.caption   = Trim(s_AD_DTL_ZIP)
'	ContMain.ContEdtAddr.caption = Trim(s_AD_POST)
'	ContMain.EdtAddrDtl.caption  = Trim(s_AD_DTAD)
	
	If g_InagTypeCode = "01" Then
		'자택 주소
		g_OwhsRegnZip 	= ContMain.EdtRegnZip.caption 			
		g_OwhsDtlZip 		= ContMain.EdtDtlZip.caption			
		g_OwhsPost 		= ContMain.EdtAddr.caption					
		g_OwhsDtad 		= ContMain.EdtAddrDtl.caption				
		g_OwhsNwAddrUseYN	= ContMain.CYN.caption				
		g_OwhsBldnMnno 	= ContMain.Cbldn.caption				

		g_CoRegnZip 		= ""
		g_CoDtlZip 		= ""
		g_CoPost 		= ""
		g_CoDtad 		= ""
		g_CoNwAddrUseYN 	= ""		
		g_CoBldnMnno 		= ""
			
	ElseIf g_InagTypeCode = "02" Then
		'직장 주소
		g_CoRegnZip 		= ContMain.EdtRegnZip.caption 				
		g_CoDtlZip 		= ContMain.EdtDtlZip.caption					
		g_CoPost 		= ContMain.EdtAddr.caption						
		g_CoDtad 		= ContMain.EdtAddrDtl.caption						
		g_CoNwAddrUseYN	= ContMain.CYN.caption		
		g_CoBldnMnno 		= ContMain.Cbldn.caption	
		
		g_OwhsRegnZip 	= ""
		g_OwhsDtlZip 		= ""
		g_OwhsPost 		= ""
		g_OwhsDtad 		= ""
		g_OwhsNwAddrUseYN	= "" 		
		g_OwhsBldnMnno 	= ""
	End If
	
	'거래내역통보
	If ContMain.RadioSelectGbn0.currentindex == "0" Then
		g_SnmlInagTypeCode = "13"
	ElseIf ContMain.RadioSelectGbn0.currentindex == "1" Then
		g_SnmlInagTypeCode = "21"
	ElseIf ContMain.RadioSelectGbn0.currentindex == "2" Then
		g_SnmlInagTypeCode = "01"
	ElseIf ContMain.RadioSelectGbn0.currentindex == "3" Then
		g_SnmlInagTypeCode = "02"
	Else
		g_SnmlInagTypeCode = ""
	End If
	
	'우편물통보
	If ContMain.RadioSelectGbn1.currentindex == "0" Then
		g_MailInagTypCode = "01"
	ElseIf ContMain.RadioSelectGbn1.currentindex == "1" Then
		g_MailInagTypCode = "02"
	Else
		g_MailInagTypCode = ""	
	End If
	
	'자택 연락처
     Dim sTail, sParam
     
     sParam = ""
	sTail  = ""
	
     sParam  = ContMain.EdtOwhsNum.caption
	sTail   = split(sParam, "-")
	
	If LEN(TRIM(sParam)) > 0 Then
		If Trim(sTail[1]) <> "" and Trim(sTail[2]) <> "" Then
			g_OwhsArcd 	= Trim(sTail[0])
			g_OwhsTono 	= Trim(sTail[1]) 					
			g_OwhsTelno 	= Trim(sTail[2])	
		End If
	Else
		g_OwhsArcd 	= ""
		g_OwhsTono 	= ""
		g_OwhsTelno 	= ""
	End If
		
	'직장 연락처
	sParam = ""
	sTail  = ""
	
	sParam = ContMain.EdtWrplNum.caption
	sTail = split(sParam, "-")
	
	If LEN(TRIM(sParam)) > 0 Then
		If Trim(sTail[1]) <> "" and Trim(sTail[2]) <> "" Then
			g_CoArcd 			= Trim(sTail[0])
			g_CoTono 			= Trim(sTail[1])
			g_CoTelno 			= Trim(sTail[2])
		End If 
	Else
		g_CoArcd 			= ""
		g_CoTono 			= ""
		g_CoTelno 			= ""
	End If
	
	Form.SetSharedData( "BDM_MaskRcno"     , ContMain.EdtJumin.caption   ) '마스킹된 주민번호
	Form.SetSharedData( "BDM_NAME"         , ContMain.EdtName.caption    ) '이름
	Form.SetSharedData( "BDM_RCNO"         , gRCNO                       ) '주민등록번호
	Form.SetSharedData( "BDM_ENGNAME"      , ContMain.EdtEngName.caption ) '영문명
	Form.SetSharedData( "BDM_ADDRGBN"      , g_InagTypeCode              ) '주소지정보(자택/직장)
	Form.SetSharedData( "BDM_REGNZIP"      , ContMain.EdtRegnZip.caption ) '우편주소
	Form.SetSharedData( "BDM_DTLZIP"       , ContMain.EdtDtlZip.caption  ) '우편주소
	Form.SetSharedData( "BDM_ADDR"         , ContMain.EdtAddr.caption    ) '주소
	Form.SetSharedData( "BDM_ADDRDTL"      , ContMain.EdtAddrDtl.caption ) '상세주소
	Form.SetSharedData( "BDM_CYN"          , ContMain.CYN.caption        ) '도로명주소사용여부
	Form.SetSharedData( "BDM_CBLDN"        , ContMain.Cbldn.caption      ) '건물주소
	Form.SetSharedData( "BDM_SNMLCLCD"     , g_SnmlInagTypeCode          ) '거래내역통보(자택/직장)
	Form.SetSharedData( "BDM_MAILCLCD"     , g_MailInagTypCode           ) '우편물통보(자택/직장)
	Form.SetSharedData( "BDM_CLPHCNPLSRNO" , "0"			              )
	Form.SetSharedData( "BDM_HP"           , HP1 & HP2 & HP3             ) '휴대폰번호
	Form.SetSharedData( "BDM_EMAIL"        , ContMain.EdtEmail.caption   ) '이메일주소
	Form.SetSharedData( "BDM_CLPHARCD"     , HP1	     			     )
	Form.SetSharedData( "BDM_CLPHTONO"     , HP2	                       )
	Form.SetSharedData( "BDM_CPNO" 	       , HP3		                   )
	Form.SetSharedData( "BDM_OWHSCNPLSRNO" , "0"			              )
	Form.SetSharedData( "BDM_OWHSNUM"      , ContMain.EdtOwhsNum.caption ) '자택전화번호
	Form.SetSharedData( "BDM_OWHSARCD"     , g_OwhsArcd                  ) '자택전화번호
	Form.SetSharedData( "BDM_OWHSTONO"     , g_OwhsTono                  ) '자택전화번호
	Form.SetSharedData( "BDM_OWHSTELNO"    , g_OwhsTelno                 ) '자택전화번호
	Form.SetSharedData( "BDM_COCNPLSRNO"   , "0"	                       )
	Form.SetSharedData( "BDM_WRPLNUM"      , ContMain.EdtWrplNum.caption ) '직장전화번호	
	Form.SetSharedData( "BDM_WRPLARCD"     , g_CoArcd                    ) '자택전화번호
	Form.SetSharedData( "BDM_WRPLTONO"     , g_CoTono                    ) '자택전화번호
	Form.SetSharedData( "BDM_WRPLTELNO"    , g_CoTelno                   ) '자택전화번호	
	Form.SetSharedData( "BDM_ACNTOPNGCLCD" , "1"                         ) '계좌개설구분
	
	Dim stemp
	If bOLD == "Y" Then '기존고객
		stemp = DATAMANAGER.GetDataValue(0, "obcsb_acif_809r" , "OutBlock1" ,  "UI_OWHS_ADDR_SRNO",0 			) 
		Form.SetSharedData("BDM_OWHS_ADDR_SRNO"  , stemp)  '자택주소일련번호
	
		stemp = DATAMANAGER.GetDataValue(0, "obcsb_acif_809r" , "OutBlock1" ,  "UI_CO_ADDR_SRNO",0 				) 
		Form.SetSharedData("BDM_CO_ADDR_SRNO"  , stemp) '회사주소일련번호
		
		stemp = DATAMANAGER.GetDataValue(0, "obcsb_acif_809r" , "OutBlock1" ,  "UI_EMAIL_ADDR_SRNO",0 			) 
		Form.SetSharedData("BDM_EMAIL_ADDR_SRNO"  , stemp) '이메일주소일련번호
	Else
		Form.SetSharedData("OWHS_ADDR_SRNO"  , "0") '자택주소일련번호	
		Form.SetSharedData("CO_ADDR_SRNO"    , "0") '회사주소일련번호
		Form.SetSharedData("EMAIL_ADDR_SRNO" , "0") '이메일주소일련번호
	End If 
	'v0007 STA : 계약서류 제공방식 추가
	If ContMain.rdoProvision.currentindex == "0" or ContMain.rdoProvision.currentindex == 0 Then
		Form.SetSharedData( "BDM_HNDV_MTHD_CODE"	, "04"              ) '계약서류 제공방식(알림톡/문자)
	ElseIf ContMain.rdoProvision.currentindex == "1" or ContMain.rdoProvision.currentindex == 1 Then
	     Form.SetSharedData( "BDM_HNDV_MTHD_CODE"	, "02"              ) '주소지정보(이메일)
	End If 
	'v0007 END
	
	'연금수익률보고서 통보처 유형코드 추가
	If getPRCD131 == "Y" Then
		If ContMain.rdoPension.currentindex == "0" or ContMain.rdoPension.currentindex == 0 Then		'수신거부
			Form.SetSharedData( "BDM_PNSN_ERT_RPRT_INAG_TYPE_CODE"	, "99"  )
		ElseIf ContMain.rdoPension.currentindex == "1" or ContMain.rdoPension.currentindex == 1 Then	'이메일
			Form.SetSharedData( "BDM_PNSN_ERT_RPRT_INAG_TYPE_CODE"	, "21"  )
		ElseIf ContMain.rdoPension.currentindex == "2" or ContMain.rdoPension.currentindex == 2 Then	'자택
			Form.SetSharedData( "BDM_PNSN_ERT_RPRT_INAG_TYPE_CODE"	, "01"  )
		ElseIf ContMain.rdoPension.currentindex == "3" or ContMain.rdoPension.currentindex == 3 Then	'회사
			Form.SetSharedData( "BDM_PNSN_ERT_RPRT_INAG_TYPE_CODE"	, "02"  )
		End If
	End If
End Function 

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	'우편번호
	If sKeyName == "mbbdm85150_p1" Then	
		If sRet == "ok" Then
			Set_Address()
		End If
	ElseIf sKeyName = "mbbdm85100_p9_end" Then
		If sRet == "ok" Then
			'20210308 HWG START
			closeFlag = "2"
			Form.CloseForm()
			'20210308 HWG END
		End If
	End If
	
End Sub 

'============================================================================
Sub Set_Address()
	ContMain.RadioSelectGbn0.SetResultLabel("0", "complete", "", "ContMain") 'helpmsg Reset

	s_AD_YN 		= Form.GetSharedData("10050_ADDRESS_YN"      , False ) 'Y: 신주소 N: 구주소
	s_AD_REGN_ZIP	= Form.GetSharedData("10050_ADDRESS_REGN_ZIP", False )
	s_AD_DTL_ZIP	= Form.GetSharedData("10050_ADDRESS_DTL_ZIP" , False )
	s_AD_POST 	= Form.GetSharedData("10050_ADDRESS_POST"    , False )
	s_AD_DTAD 	= Form.GetSharedData("10050_ADDRESS_DTAD"    , False )
	s_AD_BLDN 	= Form.GetSharedData("10050_ADDRESS_BLDN"    , False )
	
	ContMain.EdtRegnZip.caption  = Trim(s_AD_REGN_ZIP)
	ContMain.EdtDtlZip.caption   = Trim(s_AD_DTL_ZIP)
	ContMain.EdtAddr.caption     = Trim(s_AD_POST)
	ContMain.EdtAddrDtl.caption  = Trim(s_AD_DTAD)
	
	ContMain.CYN.caption = s_AD_YN
	ContMain.Cbldn.caption = s_AD_BLDN

	ContMain.EdtAddr.SetResultLabel("0","complete","","ContMain")
	ContMain.EdtAddrDtl.SetResultLabel("0","complete","","ContMain")
	
	If ContMain.RadioSelectGbn2.currentindex == "0" or ContMain.RadioSelectGbn2.currentindex == 0 Then
		g_InagTypeCode = "01"
	ElseIf ContMain.RadioSelectGbn2.currentindex == "1" or ContMain.RadioSelectGbn2.currentindex == 1 Then
	     g_InagTypeCode = "02"
	End If 
		
	If g_InagTypeCode = "01" Then
		'자택 주소
		g_OwhsRegnZip 	= ContMain.EdtRegnZip.caption 			
		g_OwhsDtlZip 		= ContMain.EdtDtlZip.caption			
		g_OwhsPost 		= ContMain.EdtAddr.caption					
		g_OwhsDtad 		= ContMain.EdtAddrDtl.caption				
		g_OwhsNwAddrUseYN	= ContMain.CYN.caption				
		g_OwhsBldnMnno 	= ContMain.Cbldn.caption				
	ElseIf g_InagTypeCode = "02" Then
		'직장 주소
		g_CoRegnZip 		= ContMain.EdtRegnZip.caption 				
		g_CoDtlZip 		= ContMain.EdtDtlZip.caption					
		g_CoPost 		= ContMain.EdtAddr.caption						
		g_CoDtad 		= ContMain.EdtAddrDtl.caption						
		g_CoNwAddrUseYN	= ContMain.CYN.caption		
		g_CoBldnMnno 		= ContMain.Cbldn.caption	
	End If

	Call ContMain_EdtAddrDtl_OnEditComplete()
		
End Sub 

'============================================================================
Function Str_Chk(str, sGubn)
	dim i							'루프용 
	dim chk_n						'숫자 체크
	dim chk_c						'영문 체크
	dim chk_t						'특수 체크
    
	chk_n = 0 '숫자
	chk_c = 0 '영어
	chk_t = 0 '특수문자
    
	For i = 1 to Len(str)
		nAscii = Asc(Mid(str, i, 1))
		
	    '48~57 : 0~9
	    '65~90 : A~Z
	    '97~122: a~z
		If nAscii >=48 and nAscii <=57 Then 
		    chk_n = 1 	
		Elseif   (nAscii >=65 and nAscii <=90) or ( nAscii >=97 and nAscii <=122) Then
		    chk_c = 1 
		Elseif   (nAscii >=33 and nAscii <=47) or ( nAscii >=58 and nAscii <=64)  or ( nAscii >=91 and nAscii <=96)  or ( nAscii >=123 and nAscii <=126) Then
		    chk_t = 1 
		Else 
		   If nAscii <> 32 Then 'space	
			   return False
		   End If
		End if 		    
	Next
    
	If sGubn == "ENG_NAME" then
		If chk_n == 1 Then  
			return False
		End if
	End if
	
	return True
End Function 

'============================================================================
'2021.04.16 . 김유경 Butto0 -> RadioSelectGbn2 컨트롤 변경



'============================================================================
Sub ContMain_RadioSelectGbn2_OnClick(nIndex)
	If nIndex == 0 Then '자택
		ContMain.EdtRegnZip.caption  = ""
		ContMain.EdtDtlZip.caption   = ""
		ContMain.EdtAddr.caption     = ""
		ContMain.EdtAddrDtl.caption  = ""
		ContMain.CYN.caption         = ""
		ContMain.Cbldn.caption       = ""
		 
		'자택 주소        
		ContMain.EdtRegnZip.caption  = g_OwhsRegnZip 
		ContMain.EdtDtlZip.caption   = g_OwhsDtlZip 			
		ContMain.EdtAddr.caption     = g_OwhsPost 		    
		ContMain.EdtAddrDtl.caption  = g_OwhsDtad 			  
		ContMain.CYN.caption         = g_OwhsNwAddrUseYN  
		ContMain.Cbldn.caption       = g_OwhsBldnMnno
		
		'(AS-IS와 동일) 주소 선택값을 우편물 통보 값으로 셋팅
		setRadioButtonData = "0"	
		ContMain.RadioSelectGbn1.currentindex = setRadioButtonData
	ElseIf nIndex == 1 Then '직장
		
		ContMain.EdtRegnZip.caption  = ""
		ContMain.EdtDtlZip.caption   = ""
		ContMain.EdtAddr.caption     = ""
		ContMain.EdtAddrDtl.caption  = ""
		ContMain.CYN.caption         = ""
		ContMain.Cbldn.caption       = ""
		
		ContMain.EdtRegnZip.caption	  =  g_CoRegnZip 		  
		ContMain.EdtDtlZip.caption   =  g_CoDtlZip 			
		ContMain.EdtAddr.caption     =  g_CoPost 			  
		ContMain.EdtAddrDtl.caption  =  g_CoDtad 			  
		ContMain.CYN.caption       	  =  g_CoNwAddrUseYN  
		ContMain.Cbldn.caption     	  =  g_CoBldnMnno 	
		
		'(AS-IS와 동일) 주소 선택값을 우편물 통보 값으로 셋팅
		setRadioButtonData = "1"
		ContMain.RadioSelectGbn1.currentindex = setRadioButtonData
	End If 

	'2021.04.18. 김유경. AS-IS와 동일하게 변경 시 거래내역통보 구분값 리셋
	ContMain.RadioSelectGbn0.currentindex = "-1"
	
	ContMain.EdtAddr.SetResultLabel("0","complete","","ContMain")
	
	'2021.04.30. 김유경 로직 추가
	ContMain.scroll_pos = CInt(Form.calcUnResize(ContMain.RadioSelectGbn2.top, "1"))	
	If Trim(ContMain.EdtAddr.caption) <> "" Then
		Call ContMain_EdtAddrDtl_OnEditComplete()
	End If
End Sub


