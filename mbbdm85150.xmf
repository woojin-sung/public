'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	'애니메이션#1 - START
	'영문명이있으면 => 주소지입력까지 노출 & 포커스 없음
	'영문명이없으면 => 영문명까지만 노출 & 영문명입력란 포커스
	If sTimerID == "1" or sTimerID == 1 then

		'타이머중지
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		
		'스크롤이동
		nCtrlTop = 0 
		nLabStndTop = 0
		
		
		if ContMain.EdtEngName.caption <> "" then
			
			if ContMain.EdtAddr.caption <> "" then
				
				nLabStndTop = 861
				nCtrlTop = Cint(Form.calcUnResize(ContMain.Label2.top, "1")) - 20
				
				ContMain.LabStnd.top = nLabStndTop
				ContMain.setScrollAutoSize()
				
				ContMain.scroll_pos = nCtrlTop
				
				'거래내역통보 라벨
				ContMain.Label3.visible = true
	
				'이메일/자택/직장 라디오버튼
				ContMain.RadioSelectGbn0.visible = true
		
				'우편물통보
				ContMain.Label4.visible = true
				ContMain.Label8.visible = true
	
				'자택/직장 라디오버튼
				ContMain.RadioSelectGbn1.visible = true
				ContMain.RadioSelectGbn1.currentindex = setRadioButtonData '20210308 데이터 셋팅
			
			else
			
				nLabStndTop = 631
				nCtrlTop = Cint(Form.calcUnResize(ContMain.EdtJumin.top, "1"))
			
				ContMain.LabStnd.top = nLabStndTop
				ContMain.setScrollAutoSize()
				ContMain.scroll_pos = nCtrlTop
			
			end if
		
		else
			nLabStndTop = 500
			CtrlTop = Cint(Form.calcUnResize(ContMain.Label1.top, "1"))
			
			ContMain.LabStnd.top = nLabStndTop
			ContMain.setScrollAutoSize()
			ContMain.scroll_pos = CtrlTop
			
			ContMain.EdtEngName.SetShowKeypad(true)
			
		End If 
		
	
	'애니메이션#2 - START
	'영문명없는 경우, 영문명 입력완료 시
	elseif sTimerID == "2" or sTimerID == 2 then
	
		
		'타이머중지
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		
		'스크롤이동
		nCtrlTop = 0 
		nLabStndTop = 0
		
		nLabStndTop = 631
		nCtrlTop = Cint(Form.calcUnResize(ContMain.EdtJumin.top, "1"))
		
		ContMain.LabStnd.top = nLabStndTop
		ContMain.setScrollAutoSize()
		ContMain.scroll_pos = nCtrlTop
		
		'2021.04.16 . 김유경 Butto0 -> RadioSelectGbn2 컨트롤 변경
		'Call ContMain_Button0_OnClick()
		Call ContMain_RadioSelectGbn2_OnClick()
		
	'#애니메이션3 - START
	'우편물통보 선택 후 스크롤 이동
	elseif sTimerID == "3" or sTimerID == 3 then
		
		'타이머중지
		Form.SetTimerEvent2(sTimerID, 0, 0.4)
		
		'스크롤이동
		nCtrlTop = 0 
		nLabStndTop = 0
	
		'v0007 스크롤 사이지 변경 1296 > 1366
		'20210308 HWG START
		nLabStndTop = 1366'CInt(Form.calcUnResize(ContMain.LabStnd.top, "1")) + 110
		
		'v0007 스크롤 위치 변경
'		nCtrlTop = Cint(Form.calcUnResize(ContMain.Label4.top, "1"))	
		nCtrlTop = Cint(Form.calcUnResize(ContMain.Label5.top, "1"))

		ContMain.LabStnd.top = nLabStndTop
		ContMain.setScrollAutoSize()
		ContMain.scroll_pos = nCtrlTop 
		

	ElseIf sTimerID == "4" or sTimerID == 4 then
		
		Form.SetTimerEvent2(sTimerID, 0, 0.4)
		If TRIM(ContMain.EdtEmail.caption) = "" Then 
			ContMain.EdtEmail.SetShowKeypad(true)
		End If 
'	ElseIf sTimerID == "5" or sTimerID == 5 then
'		Form.SetTimerEvent2(5, 0, 0.1)
'		ContMain.RadioSelectGbn0.SetResultLabel("1", "error","자택 또는 직장으로 선택하시는 경우 주소에서\n 선택한 통보처와 동일하게 선택 가능합니다.","ContMain")
'		ContMain.RadioSelectGbn0.currentindex = "-1"	

	ElseIf sTimerID == "5" or sTimerID == 5 Then
		Form.SetTimerEvent2(sTimerID, 0, 0.4)
		
		nCtrlTop = 0 
		nLabStndTop = 0
		
		nLabStndTop = 1500
		
		nCtrlTop = Cint(Form.calcUnResize(ContMain.lblPension.top, "1"))

		ContMain.LabStnd.top = nLabStndTop
		ContMain.setScrollAutoSize()
		ContMain.scroll_pos = nCtrlTop 
	End If
	
End Sub

