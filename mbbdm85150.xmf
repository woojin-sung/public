'============================================================================
Sub ContMain_EdtEmail_OnEditComplete()
	ContMain.EdtEmail.SetResultLabel("0", "", "", "", 1)	'v0007 Email help msg 줄 수 설정설정 전 리셋(야후/핫메일 help msg 줄수로 인한)
	ContMain.EdtEmail.SetUseResultLabel(true, 1)			'v0007 Email help msg 줄 수 설정
	
	Dim sParam, sTail, sTailTemp, sTailDetail
	sParam  = ""
	sTail   = ""
	sTailTemp = ""
	sTailDetail = ""

	sParam = ContMain.EdtEmail.caption
	If LEN(TRIM(sParam)) > 0 Then 
		sTail = split(sParam, "@")
		
		If ubound(sTail) > 0 Then 
		
			'2021.05.01. 김유경. 개선사항 추가
			If Str_Chk_Email(ContMain.EdtEmail.caption, "EMAIL") == False then		 
				ContMain.EdtEmail.SetResultLabel("1","error","이메일을 확인하세요.","ContMain")
				Exit Sub
			End If
	
			sTailTemp = sTail[1]
			sTailDetail = split(sTailTemp, ".")
			
			If sTailDetail[0] == "yahoo" or sTailDetail[0] == "hotmail" Then
				'ShowAlert("알림", "야후코리아(yahoo.co.kr), 핫메일(hotmail.com) 계정은 사용이 불가합니다.")
				ContMain.EdtEmail.SetUseResultLabel(true, 3)		'v0007 Email help msg 줄 수 설정
				ContMain.EdtEmail.SetResultLabel("1", "error","야후코리아(yahoo.co.kr), 핫메일(hotmail.com)\n계정은 사용이 불가합니다.","ContMain", 3)	'v0007
				ContMain.EdtEmail.caption = ""
				
				'v0007 오류 발생으로 주석
				'20210308 HWG START 
'				ContMain.EdtOwhsNum.top = CInt(Form.calcUnResize(ContMain.EdtEmail.top,"1"))   + CInt(Form.calcUnResize(ContMain.EdtEmail.height, "2"))   + ControlSize + 30 '자택전화번호
'				ContMain.EdtWrplNum.top = CInt(Form.calcUnResize(ContMain.EdtOwhsNum.top,"1")) + CInt(Form.calcUnResize(ContMain.EdtOwhsNum.height, "2")) + ControlSize      '직장전화번호
				'20210308 HWG END
				
				Exit Sub
			Else 
				'2021.04.05 obaci_acct_049c 입력값 체크 완료 시 다음버튼 활성화
				'BtnNext.visible = True	
				
				'2021.04.14. 김유경. 콜 위치 변경
				'DATAMANAGER.RequestTranData("obaci_acct_049c")
				ContMain.EdtEmail.SetResultLabel("0","complete","","ContMain")
				BtnNext.visible = True
			
			End If
		End If
	End If
	
End Sub
