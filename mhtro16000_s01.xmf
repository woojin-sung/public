'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	Init_Control()
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID = "ohhts_metf_008r" then
		ResponseTranData_ChartEx0(szTranID)
		g_is008r = "1"
	elseif  szTranID = "ohhts_metf_008r_1"  then
		ResponseTranData_ChartEx0(szTranID)
		g_is008r_1 = "1"
	elseif szTranID = "ohhts_metf_009r"  then
		ResponseTranData_ChartEx1(szTranID)	
		g_is009r = "1"
	elseif szTranID = "ohhts_metf_007r" then
		ResponseTranData_tbl0()
	end if
	
	if g_is008r = "1" and g_is009r = "1" then 'and g_is008r_1 = "1" then
		Init_ChartEx0()
		Init_ChartEx1()
		
		Resize_Layout()
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID = "ohhts_metf_008r" then
		g_is008r = "1"
		g_nReduce1 = 275
	elseif szTranID = "ohhts_metf_008r_1"  then
		g_is008r_1 = "1"
		g_nReduce1 = 275
	elseif szTranID = "ohhts_metf_009r"  then
		g_is009r = "1"
		g_nReduce2 = 240
	end if
	
	if g_is008r = "1" and g_is009r = "1" then 'and g_is008r_1 = "1" then
		Init_ChartEx0()
		Init_ChartEx1()
		
		Resize_Layout()
	end if
End Sub


'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INIT_CODE" then
		g_szItemCd = sParam
		g_szExidCd = ""
		if instr(g_szItemCd, "@") > 0 then
			sTemp = split(g_szItemCd, "@")
			g_szExidCd = sTemp[0] '시장구분
			g_szOnlyCd = sTemp[1] '종목코드 
			
			contMain.lblTitle3.visible = false
			contMain.lblData3.visible = false
			
			szRtChk = Form.GetSharedData( "REALTIME_"..g_szExidCd, false )
			'contMain.FormTab0.currenttab = 2
			contMain.rdoPeriod.currentindex = 0
			RequestTranData_tbl0(g_szOnlyCd,g_szExidCd,szRtChk)
			RequestTranData_ChartEx0(g_szOnlyCd,g_szExidCd)
			RequestTranData_ChartEx1(g_szOnlyCd,g_szExidCd)
		else
			g_szOnlyCd = g_szItemCd
			g_szExidCd = "J"
			'contMain.FormTab0.currenttab = 2
			contMain.rdoPeriod.currentindex = 0
			RequestTranData_tbl0(g_szOnlyCd,g_szExidCd, "")
			RequestTranData_ChartEx0(g_szOnlyCd,g_szExidCd)
			RequestTranData_ChartEx1(g_szOnlyCd,g_szExidCd)
		end if
	end if
End Sub

''============================================================================
'Sub contMain_FormTab0_OnTabChanged(nCurrentTab)
'	RequestTranData_ChartEx0(g_szOnlyCd,g_szExidCd)
'End Sub


'============================================================================
Sub contMain_rdoPeriod_OnClick(nIndex)
	RequestTranData_ChartEx0(g_szOnlyCd,g_szExidCd)
End Sub
'============================================================================
Sub contMain_imgTooltip0_OnClick()
	sText = "수익률 조회 기준(NAV 기준)\n- 분배금 재투자를 가정한 세전 수익률로\n   전 영업일 기준으로 제공돼요."
	contMain.imgTooltip0.ToolTipBringFront(true)
	
	if g_nCommFontSize = "1" or g_nCommFontSize = "2" then
		contMain.imgTooltip0.openToolTip( sText, 350, 80, 2 )
	else
		contMain.imgTooltip0.openToolTip( sText, 300, 80, 2 )
	end if
	
End Sub

'============================================================================
Sub contMain_imgTooltip1_OnClick()
	sText = "자금흐름 조회 기준\n- 모닝스타에서 제공되는 추정 데이터로\n   전 영업일 기준으로 제공돼요."
	contMain.imgTooltip1.ToolTipBringFront(true)
	if g_nCommFontSize = "1" or g_nCommFontSize = "2" then
		contMain.imgTooltip1.openToolTip( sText, 350, 80, 2 )
	else
		contMain.imgTooltip1.openToolTip( sText, 300, 80, 2 )
	end if
End Sub

'============================================================================
Sub contMain_lblExpand_OnClick()
	Form.triggerEvent("#", "RETURN_LAYOUT", "호가")
End Sub

'============================================================================
Sub contMain_lblExpand0_OnClick()
	Form.triggerEvent("#", "RETURN_LAYOUT", "체결일자별")
End Sub

