Function Init_Control()
	g_nCommFontSize = Form.getEnvData("common.textsize")
	contMain.FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 4) '활성화/비활성화/여백
	contMain.FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	
	contMain.lblSubTitle0.fgcolor = g_szTxtColor_Normal
	contMain.lblSubTitle0.paddinginfo = "0,0,0,0"
	
	contMain.lblSubTitle1.fgcolor = g_szTxtColor_Normal
	contMain.lblSubTitle1.paddinginfo = "0,0,0,0"
	
	contMain.lblSubTitle1.caption = "기간 수익률 (전영업일 기준)"

	contMain.lblSubTitle1.changeTextAttr(0,7,334,0,true)
	contMain.lblSubTitle1.changeTextAttr(7,9,333,-6,true)
	
	contMain.lblSubTitle2.fgcolor = g_szTxtColor_Normal
	contMain.lblSubTitle2.paddinginfo = "0,0,0,0"
	
	contMain.lblSubTitle2.caption = "자금흐름 (전영업일 기준)"

	contMain.lblSubTitle2.changeTextAttr(0,5,334,0,true)
	contMain.lblSubTitle2.changeTextAttr(5,9,333,-6,true)
	
	contMain.lblExpand.paddinginfo = "0,0,0,0"
	contMain.lblExpand.fgcolor = g_szTxtColor_Grey
	
	contMain.lblExpand0.paddinginfo = "0,0,0,0"
	contMain.lblExpand0.fgcolor = g_szTxtColor_Grey
	
	szScrNo = Form.GetSharedData("&SCREEN_NO", false)
	if szScrNo == "11000" then
		contMain.lblExpand.visible = false
		contMain.lblExpand0.visible = false
	end if
	
	contMain.Button0.makeRangeSlider(false, 0, 100, 0, 50, 1.0)
	contMain.Button0.exceptSliderHandleType("1")
	contMain.Button0.SetRangeSliderLineHeight(3)
	contMain.Button0.setRangeSliderLineColor(347, 347)
	contMain.Button0.SetRangeSliderHandleSize(20)
	contMain.Button0.SetRangeSliderHandleImage("triangle")
	
	contMain.Button0.enable = false
	contMain.Button0.visible = false
	
	contMain.lblLow.imagefilepth = "bg_box_line.9"
	contMain.lblHigh.imagefilepth = "bg_box_line.9"
	
	contMain.ChartEx0.visible = false
	contMain.ChartEx1.visible = false
	
	for i = 0 to 5
		Form.SetCtlProp("contMain.lblTitle"&i, "fgcolor", g_szTxtColor_Grey)
		Form.SetCtlProp("contMain.lblTitle"&i, "paddinginfo", "10,0,0,0")
		
		Form.SetCtlProp("contMain.lblData"&i, "fgcolor", g_szTxtColor_Normal)
		Form.SetCtlProp("contMain.lblData"&i, "paddinginfo", "0,0,10,0")
	next
	
	contMain.imgTooltip0.setMaintainingRatio("2")
	contMain.imgTooltip0.imgpath = g_szToolTipImg
	
	nTextWidth = Form.getTextWidth("기간 수익률", 0, true, false)
	contMain.imgTooltip0.left = 20 + nTextWidth + 5
	
	'contMain.lblSubTitle1.setNeighborCtlPos("imgTooltip0", "right", 5, "기간 수익률")
	
	contMain.imgTooltip1.setMaintainingRatio("2")
	contMain.imgTooltip1.imgpath = g_szToolTipImg
	
	nTextWidth = Form.getTextWidth("자금흐름", 0, true, false)
	contMain.imgTooltip1.left = 20 + nTextWidth + 5
	
	'contMain.lblSubTitle2.setNeighborCtlPos("imgTooltip1", "right", 5, "자금흐름")
	
	contMain.lblRate.maxlinecnt = "1"
	contMain.lblLow.imagefilepth = "roundbox_4r_stoke02.9"
	contMain.lblHigh.imagefilepth = "roundbox_4r_stoke02.9"
	contMain.lblLine0.bgcolor = g_szLineColor3
	contMain.lblLine1.bgcolor = "255255255"'g_szLineColor2
	contMain.lblLine2.bgcolor = "255255255"'g_szLineColor3
	contMain.lblLine3.bgcolor = "255255255"'g_szLineColor2
	contMain.lblLine4.bgcolor = "255255255"'g_szLineColor2
	
	contMain.lblDiv0.bgcolor = g_szLineColor3
	contMain.lblDiv1.bgcolor = g_szLineColor3
	contMain.lblDiv2.bgcolor = g_szLineColor3
	
	contMain.ChartEx0.visible 		= false
	contMain.lblSubTitle1.visible 	= false
	contMain.lblExpand0.visible 	= false
	contMain.lblLine3.visible 		= false
	contMain.FormTab0.visible 		= false
	contMain.rdoPeriod.visible		= false
	contMain.imgTooltip0.visible	= false
	contMain.lblDiv1.visible 		= false
	
	contMain.lblChartIdx0.visible 	= false
	contMain.lblChartTitle0.visible = false
	contMain.lblChartIdx1.visible 	= false
	contMain.lblChartTitle1.visible = false
	
	contMain.ChartEx1.visible 		= false
	contMain.lblSubTitle2.visible 	= false
	contMain.lblLine4.visible 		= false
	contMain.imgTooltip1.visible	= false
End Function

Function Init_ChartEx0()
	szData = ""
	szData2 = ""
	szData3 = ""
	szData4 = ""
	szData3_Nm = ""
	szData4_Nm = ""
	
	if g_szData_Date_008r = "" then
		exit Function
	end if
	contMain.lblRate.caption = g_szData_Last
	
	contMain.ChartEx0.visible 		= true
	contMain.lblSubTitle1.visible 	= true
	
	szScrNo = Form.GetSharedData("&SCREEN_NO", false)
	if szScrNo <> "11000" then
		contMain.lblExpand0.visible 	= true
	end if
	
	contMain.lblLine3.visible 		= true
	contMain.rdoPeriod.visible		= true
	contMain.imgTooltip0.visible 	= true
	contMain.lblDiv1.visible 		= true
	
