'		szData4_Nm = "NAV"
'	else
'		szData = g_szData_Date_008r_1
'		szData2 = g_szData_Init_008r_1
'		szData3 = g_szData_Rate_008r_1
'		szData4 = g_szData_Rate_008r
'		
'		if szData3 = "" then
'			szData3 = "0"
'		end if
'		
'		szData3_Nm = "NAV"
'		szData4_Nm = Form.getItemCodeInfo(g_szItemCd, "name")
'	end if
	szData3_Nm = Form.getItemCodeInfo(g_szItemCd, "name")
	'----------------------------------------
	' 종목명1,종목명2,차트유형,스케일유형
	'----------------------------------------
	contMain.ChartEx0.SetAccrueName(szData3_Nm&",ETF_Compare_FundFlow,L")
'	contMain.ChartEx0.SetAccrueName(szData3_Nm&","&szData4_Nm&",ETF_Compare2,L")
	
	'----------------------------------------
	' 데이터 자리 초기화
	'----------------------------------------
	contMain.ChartEx0.SetAccrueData("initdata="..g_szData_Init_008r)
	
	'----------------------------------------
	' 날짜 데이터
	'----------------------------------------
	
	contMain.ChartEx0.SetAccrueData("자료일자="..g_szData_Date_008r)
	
	'----------------------------------------
	' 차트 데이터
	'----------------------------------------
	contMain.ChartEx0.SetAccrueData("ETF_Titles= (%);%;% ")
	contMain.ChartEx0.SetAccrueData("data1="..g_szData_Rate_008r.."=2")
'	contMain.ChartEx0.SetAccrueData("data2="..szData4.."=2")

'	
'	'----------------------------------------
'	' 차트 그리기
'	'----------------------------------------
	contMain.ChartEx0.SetLineColor(szData3_Nm&";117;147;226")
'	contMain.ChartEx0.SetLineColor(szData4_Nm&";219;161;12")
	
'	contMain.lblChartIdx0.bgcolor = "117147226"
'	contMain.lblChartIdx1.bgcolor = "219161012"
'	
'	contMain.lblChartTitle0.paddinginfo = "10,0,0,0"
'	contMain.lblChartTitle1.paddinginfo = "10,0,0,0"
