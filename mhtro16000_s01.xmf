End Function

Function Init_ChartEx1()

	if g_szData_Aset_009r = "" then
		Exit Function
	end if
	
	contMain.ChartEx1.visible = true
	contMain.lblSubTitle2.visible = true
	contMain.lblLine4.visible = true
	contMain.imgTooltip1.visible	= true
	
	contMain.lblChartIdx2.visible = false
	contMain.lblChartTitle2.visible = false

	szData_Nm = Form.getItemCodeInfo(g_szItemCd, "name")
	
	'----------------------------------------
	' 종목명1,종목명2,차트유형,스케일유형
	'----------------------------------------
	contMain.ChartEx1.SetAccrueName(szData_Nm&",ETF_Compare_FundFlow,L")
	
	'----------------------------------------
	' 데이터 자리 초기화
	'----------------------------------------
	contMain.ChartEx1.SetAccrueData("initdata="..g_szData_Init_009r)
	
	'----------------------------------------
	' 날짜 데이터
	'----------------------------------------
	contMain.ChartEx1.SetAccrueData("자료일자="..g_szData_Date_009r)
	
	'----------------------------------------
	' 차트 데이터
	'----------------------------------------
	szAsetNm1 = ""
	szAsetNm2 = ""
	if g_szExidCd = "OQ" or g_szExidCd = "AX" or g_szExidCd = "NY" then
		szAsetNm1 = "백만달러"
	elseif g_szExidCd = "JP" then
		szAsetNm1 = "백만엔"
	elseif g_szExidCd = "HK" then
		szAsetNm1 = "백만홍콩달러"
	elseif g_szExidCd = "SZ" or g_szExidCd = "SH" then
		szAsetNm1 = "백만위안"
	else
		szAsetNm1 = "십억"
	end if 
	
	contMain.ChartEx1.SetAccrueData("ETF_Titles=("&szAsetNm1&");;("&szAsetNm1&")")
	contMain.ChartEx1.SetAccrueData("data1="..g_szData_Aset_009r.."=2")
	
	contMain.lblChartIdx2.bgcolor = "092102158"
	contMain.lblChartTitle2.caption = szData_Nm
	
	'----------------------------------------
	' 차트 그리기
	'----------------------------------------
	contMain.ChartEx1.SetLineColor(szData_Nm&";92;102;158")
	contMain.ChartEx1.SetAccrueData("repaintall")
End Function

Function RequestTranData_tbl0(szData0, szData1, szData2)
	DATAMANAGER.ClearInputData(0, "ohhts_metf_007r")
	
	DATAMANAGER.SetDataValue(0, "ohhts_metf_007r", "InBlock1", "FID_INPUT_OVRS_ISCD"			, 0 , szData0)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_007r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , szData1)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_007r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE"	, 0 , szData2)
	
	DATAMANAGER.RequestTranData("ohhts_metf_007r")
End Function

Function ResponseTranData_tbl0()

	szNav  =  DATAMANAGER.GetDataValue(0, "ohhts_metf_007r", "OutBlock1", "FIDX_NAV" , 0)
	sziNav  =  DATAMANAGER.GetDataValue(0,"ohhts_metf_007r", "OutBlock1", "FIDX_ESTM_NAV" , 0)
	
	szhyun = DATAMANAGER.GetDataValue(0,"ohhts_metf_007r", "OutBlock1", "FID_PRPR" , 0)
	szhigh = DATAMANAGER.GetDataValue(0, "ohhts_metf_007r", "OutBlock1", "FIDX_52_WEEK_HGPR", 0)
	szlow = DATAMANAGER.GetDataValue(0, "ohhts_metf_007r", "OutBlock1", "FIDX_52_WEEK_LWPR", 0)
	
	if szNav <> "" and Cdbl(szNav) <> 0 then
		contMain.lblData0.caption = FormatNumber(szNav, 2)
	else
		contMain.lblData0.caption = "-"
	end if
	
	if sziNav <> "" and Cdbl(sziNav) <> 0 then
		contMain.lblData3.caption = FormatNumber(sziNav, 2)
	else
		contMain.lblData3.caption = "-"
	end if

	if szhyun <> "" and szhigh <> "" and szlow <> "" then
		if cdbl(szhyun) < cdbl(szlow) then
			szhyun =  cdbl(szlow)
		end if
		
		if cdbl(szhyun) > cdbl(szhigh) then
			szhyun = cdbl(szhigh)
		end if
		
		contMain.Button0.visible = true
		
		if Cdbl(szlow) = 0 and Cdbl(szhigh) = 0 then
			contMain.lblLow.caption =  "1년 최저가"
			contMain.lblHigh.caption =  "1년 최고가"
			
			contMain.lblLow.fgcolor = 333
			contMain.lblHigh.fgcolor = 333
			
			contMain.Button0.SetRangeSliderHandleImage("alpha")
			contMain.Button0.setRangeSliderLineColor(272, 272)
		else
			if g_szExidCd = "AX" or g_szExidCd = "NY" or g_szExidCd = "OQ" then
				
				contMain.Button0.SetRangeSlider( szlow, szhigh, szhyun, szhyun, 0.0001, 4)
				
				szhigh = FormatNumber(szhigh, 4)
				szlow = FormatNumber(szlow, 4)
			elseif g_szExidCd = "HK" or g_szExidCd = "SH" or g_szExidCd = "SZ" then
	
				contMain.Button0.SetRangeSlider( szlow, szhigh, szhyun, szhyun, 0.001,3)
				
				szhigh = FormatNumber(szhigh, 3)
				szlow = FormatNumber(szlow, 3)
			elseif g_szExidCd = "JP" then
	
				contMain.Button0.SetRangeSlider( szlow, szhigh, szhyun, szhyun, 0.1,1)
				
				szhigh = FormatNumber(szhigh, 1)
				szlow = FormatNumber(szlow, 1)
			else
	
				contMain.Button0.SetRangeSlider( szlow, szhigh, szhyun, szhyun, 1.0,0)
				
				szhigh = FormatNumber(szhigh, 0)
				szlow = FormatNumber(szlow, 0)
			end if
			
			nLen_High = Form.getLen(szhigh)
			nLen_Low = Form.getLen(szlow)
		

			contMain.lblLow.caption = szlow & "\n1년 최저가"
			contMain.lblHigh.caption = szhigh & "\n1년 최고가"
		
			contMain.lblLow.changeTextAttr(nLen_Low+1,6,333,-3,false) 
			contMain.lblHigh.changeTextAttr(nLen_High+1,6,333,-3,false) 
		end if
	end if
End Function

Function RequestTranData_ChartEx0(szData0, szData1)
	
	g_is008r = "0"
	g_is008r_1 = "0"
	
	g_nReduce1 = 0
	
	g_szData_Date_008r = ""
	g_szData_Rate_008r = ""
	g_szData_Init_008r = ""
	
	g_szData_Date_008r_1 = ""
	g_szData_Rate_008r_1 = ""
	g_szData_Init_008r_1 = ""
	g_szData_Last = ""
	contMain.lblRate.caption = ""
	
	nPeriod = ""
	nCurTab = Cint(contMain.rdoPeriod.currentindex) 'Cint(contMain.FormTab0.currenttab)
	
	
	if nCurTab = 0 then
		nPeriod = "1"
	elseif nCurTab = 1 then
		nPeriod = "3"
'	elseif nCurTab = 2 then
'		nPeriod = "6"
	elseif nCurTab = 2 then
		nPeriod = "12"
	elseif nCurTab = 3 then
		nPeriod = "36"
	else
		nPeriod = "12"
	end if

	DATAMANAGER.ClearInputData(0, "ohhts_metf_008r")
	
	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r", "InBlock1", "FID_INPUT_OVRS_ISCD"				, 0 , szData0)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"		, 0 , szData1)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r", "InBlock1", "FID_INPUT_DIV_CLS_CODE"			, 0 , "0")
	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r", "InBlock1", "FID_INPUT_SCTN_CLS_CODE"			, 0 , nPeriod)
	
	DATAMANAGER.RequestTranData("ohhts_metf_008r")
	
'	DATAMANAGER.ClearInputData(0, "ohhts_metf_008r_1")
'	
'	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r_1", "InBlock1", "FID_INPUT_OVRS_ISCD"			, 0 , szData0)
'	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"		, 0 , szData1)
'	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r_1", "InBlock1", "FID_INPUT_DIV_CLS_CODE"			, 0 , "1")
'	DATAMANAGER.SetDataValue(0, "ohhts_metf_008r_1", "InBlock1", "FID_INPUT_SCTN_CLS_CODE"			, 0 , nPeriod)
'	
'	DATAMANAGER.RequestTranData("ohhts_metf_008r_1")
End Function

Function RequestTranData_ChartEx1(szData0, szData1)
	g_nReduce2 = 0
	
	contMain.lblSubTitle2.visible = false
	contMain.lblLine4.visible = false
	contMain.ChartEx1.visible = false
	
	contMain.lblChartIdx2.visible = false
	contMain.lblChartTitle2.visible = false
	
	DATAMANAGER.ClearInputData(0, "ohhts_metf_009r")
	
	DATAMANAGER.SetDataValue(0, "ohhts_metf_009r", "InBlock1", "FID_INPUT_OVRS_ISCD"			, 0 , szData0)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_009r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , szData1)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_009r", "InBlock1", "FID_INPUT_DIV_CLS_CODE"		, 0 , "2")
	
	DATAMANAGER.SetDataValue(0, "ohhts_metf_009r", "InBlock2", "FID_INPUT_OVRS_ISCD"			, 0 , szData0)
	DATAMANAGER.SetDataValue(0, "ohhts_metf_009r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , szData1)
	
	DATAMANAGER.RequestTranData("ohhts_metf_009r")
End Function


Function ResponseTranData_ChartEx0(szTranID)
		szData_Date = ""
		szData_Rate = ""
		szData_Init = ""
		
		nDataCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")

		if nDataCnt > 0 then
			for i = 0 to nDataCnt-1
				
				szDate = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_DATE" , i)
				szRate = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_ERNN_RATE" , i)
				
				if g_szData_Last = "" then
					g_szData_Last = szRate
				end if
			
				if i <> 0 then
					szData_Date = ";" & szData_Date 
					szData_Rate = ";" & szData_Rate
					szData_Init = ";" & szData_Init 
				end if
				
				szData_Date = szDate & szData_Date 
				szData_Rate = szRate & szData_Rate
				szData_Init = i & szData_Init 
				
				if szTranID = "ohhts_metf_008r" and i = 0 then
					szYear = left(szDate,4)
					szMonth = mid(szDate,5,2)
					szDay = right(szDate,2)
					contMain.lblSubTitle1.caption = "기간 수익률       ("&szYear&"."&szMonth&"."&szDay&"기준)"

					contMain.lblSubTitle1.changeTextAttr(0,7,334,0,true)
					contMain.lblSubTitle1.changeTextAttr(13,14,333,-6,true)
				end if
			next
		else
			if szTranID = "ohhts_metf_008r" then
				g_nReduce1 = 275
			end if
		end if
		
		if szTranID = "ohhts_metf_008r" then
			g_szData_Init_008r = szData_Init
			g_szData_Date_008r = szData_Date
			g_szData_Rate_008r = szData_Rate
		elseif szTranID = "ohhts_metf_008r_1" then
			g_szData_Init_008r_1 = szData_Init
			g_szData_Date_008r_1 = szData_Date
			g_szData_Rate_008r_1 = szData_Rate
		end if
End Function

Function ResponseTranData_ChartEx1(szTranID)
		g_szData_Date_009r = ""
		g_szData_Aset_009r = ""
		g_szData_Init_009r = ""
		
		szData_Date = ""
		szData_Aset = ""
		szData_Init = ""
		
		nDataCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")

		if Cint(nDataCnt) > 0 then
			for i = 0 to nDataCnt-1
				
				szDate = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_DATE" , i)
				szAset = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_ASET_TOT" , i)
				
	
				szAsetNew = ""
				if g_szExidCd = "OQ" or g_szExidCd = "AX" or g_szExidCd = "NY" then
					szAsetNew = round(Cdbl(szAset) / 1000000, 2)
				elseif g_szExidCd = "JP" then
					szAsetNew = round(Cdbl(szAset) / 1000000, 2)
				elseif g_szExidCd = "HK" then
					szAsetNew = round(Cdbl(szAset) / 1000000, 2)
				elseif g_szExidCd = "SZ" or g_szExidCd = "SH" then
					szAsetNew = round(Cdbl(szAset) / 1000000, 2)
				else
					szAsetNew = round(Cdbl(szAset) / 1000000000, 2)
				end if 
				
				if i <> 0 then
					szData_Date = ";" & szData_Date 
					szData_Aset = ";" & szData_Aset 
					szData_Init = ";" & szData_Init 
				end if
			
				szData_Date = szDate & szData_Date 
				szData_Aset = szAsetNew & szData_Aset
				szData_Init = i & szData_Init 
				
				if i = 0 then
					szYear = left(szDate,4)
					szMonth = mid(szDate,5,2)
					szDay = right(szDate,2)
					contMain.lblSubTitle2.caption = "자금흐름       ("&szYear&"."&szMonth&"."&szDay&"기준)"
		
					contMain.lblSubTitle2.changeTextAttr(0,5,334,0,true)
					contMain.lblSubTitle2.changeTextAttr(11,14,333,-6,true)
				end if
			next
		else
			g_nReduce2 = 240
		end if
		
		g_szData_Date_009r = szData_Date
		g_szData_Aset_009r = szData_Aset
		g_szData_Init_009r = szData_Init
End Function

Function Resize_Layout()
	nTotReduce = g_nReduce1 + g_nReduce2

	if g_nReduce1 = 275 and g_nReduce2 = 0 then
		contMain.lblSubTitle2.top 	= 525 - nTotReduce
		contMain.lblLine4.top 		= 555 - nTotReduce
		contMain.ChartEx1.top 		= 563 - nTotReduce
		contMain.imgTooltip1.top	= 529 - nTotReduce
		contMain.lblDiv2.top		= 733 - nTotReduce
	end if
	
	Form.triggerEvent("#", "CHANGE_LAYOUT_S1", 768 - nTotReduce)
End Function

