'============================================================================
' 투자주요내용
'============================================================================

Dim g_szReturnKey

Dim szOSType
	
Dim g_OpenFilePath	'투자설명서 파일 경로

'============================================================================
Sub Form_OnFormInitBefore()
	Container0.ImgInvRisk1.setMaintainingRatio("1")
	Container0.ImgInvRisk2.setMaintainingRatio("1")
	Container0.ImgInvRisk3.setMaintainingRatio("1")
	Container0.ImgInvRisk4.setMaintainingRatio("1")
	Container0.ImgInvRisk5.setMaintainingRatio("1")
	Container0.ImgInvRisk6.setMaintainingRatio("1")
	Container0.ImgInvRisk7.setMaintainingRatio("1")
	Container0.ImgInvRisk8.setMaintainingRatio("1")
	
	Container0.imgArrow1.setMaintainingRatio("1")
	Container0.imgArrow2.setMaintainingRatio("1")
	Container0.imgArrow3.setMaintainingRatio("1")
	Container0.imgArrow4.setMaintainingRatio("1")
	Container0.imgArrow5.setMaintainingRatio("1")
	Container0.imgArrow6.setMaintainingRatio("1")
	
	Container0.ImgQuery2.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	g_szReturnKey = ""
	g_OpenFilePath = ""
	
	Container0.Label3.fgcolor = "10"
	Container0.Label4.changeTextAttr(0, 8, 10, 0, true)
	Container0.Label4.changeTextAttr(8, 12, 4, 0, true)
		
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		g_OpenFilePath		= szOpenData		
	end if
		
	'상품상세화면에서 SetShared한 값으로 조회함.
	g_SHTR_BOND_REG_CLS_CODE = Form.GetSharedData("MBONL88060_P1_SHTR_BOND_REG_CLS_CODE")
	''단기사채등록구분코드(1:발행물/2:유통물)
	if g_SHTR_BOND_REG_CLS_CODE == "1" then
		Container0.ImgInvRisk1.imgpath = "icon_investmentrisk_case1_5"
	else
		Container0.ImgInvRisk1.imgpath = "icon_investmentrisk_case1_4"
	end if
	
	btnNext.enable = false
'	btnNext.btnimage = "btn_20.9"
'	btnNext.fgcolor = "273"	
	
	'안드로이드인 경우, 컨테이너 스크롤 없애기
	if  szOSType == "1" then'iOS("2")Android("1")
		Container0.setScrollBarVisible("2")
	end if
	f_isEnbleProc()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)	
	if sKeyName == "mbonl88060_p14" then	'//상품내용 및 투자대상 팝업
		if sRet = "ok" then
			Container0.imgBox1.imgpath = "btn_line_red_o.9.png"
			Container0.chk1.chksilence = "1"
		else
			Container0.imgBox1.imgpath = "btn_line_red_n.9.png"
			Container0.chk1.chksilence = "0"
		end if
		f_isEnbleProc()
	Elseif sKeyName == "mbonl88060_p15" then	'//투자위험 및 불이익 팝업
		if sRet = "ok" then
			Container0.imgBox2.imgpath = "btn_line_red_o.9.png"
			Container0.chk2.chksilence = "1"
		else
			Container0.imgBox2.imgpath = "btn_line_red_n.9.png"
			Container0.chk2.chksilence = "0"
		end if
		f_isEnbleProc()
	Elseif sKeyName == "mbonl88060_p12" then	'//투자설명서 팝업
		if sRet = "ok" then
			Container0.imgBox3.imgpath = "btn_line_red_o.9.png"
			Container0.chk3.chksilence = "1"
		else	'close
			Container0.imgBox3.imgpath = "btn_line_red_n.9.png"
			Container0.chk3.chksilence = "0"
		end if
		f_isEnbleProc()
	Elseif sKeyName == "mbonl88060_p16" then	'//투자자 유의사항 팝업
		if sRet = "ok" then
			Container0.imgBox4.imgpath = "btn_line_red_o.9.png"
			Container0.chk4.chksilence = "1"
		else
			Container0.imgBox4.imgpath = "btn_line_red_n.9.png"
			Container0.chk4.chksilence = "0"
		end if
		f_isEnbleProc()
	Elseif sKeyName == "mbonl88060_p17" then	'//금융소비자의 권리 팝업
		if sRet = "ok" then
			Container0.imgBox5.imgpath = "btn_line_red_o.9.png"
			Container0.chk5.chksilence = "1"
		else
			Container0.imgBox5.imgpath = "btn_line_red_n.9.png"
			Container0.chk5.chksilence = "0"
		end if
		f_isEnbleProc()
	Elseif sKeyName == "mbonl88060_p18" then	'//이해여부확인 팝업
		if sRet = "ok" then
			'정상확인 후, 매수화면에서 계좌비밀번호 입력 팝업 띄움..
			g_szReturnKey = sRet
			Form.CloseForm()
		else
			'do nothing!
		end if
	ElseIf sKeyName == "errMsgBox"  Then 
		if sRet = "Left" then				
			'취소
		elseif sRet = "Call" then
			'상담센터 연결
			Form.SendCall("15883400")
		end if
	End If	
End Sub

'============================================================================
Function f_isEnbleProc()
	If CInt(Container0.chk1.chksilence) == 1 and
		CInt(Container0.chk2.chksilence) == 1 and
		CInt(Container0.chk3.chksilence) == 1 and
		CInt(Container0.chk4.chksilence) == 1 and
		CInt(Container0.chk5.chksilence) == 1 then
		
		btnNext.enable = true
'		btnNext.btnimage = "btn_20.9"
'		btnNext.fgcolor = "273"
		
	Else
		
		btnNext.enable = false
'		btnNext.btnimage = "btn_20.9"
'		btnNext.fgcolor = "273"
	End if
End Function

'============================================================================
Sub Container0_lblGoQuery_OnClick()
	'금융용어사전 검색 바로가기
	'금강원 파인 사이트 내 금융용어사전 화면으로 이동
	'http://find.fss.or.kr/main/fin_fip/dic/financedic.jsp
	Form.OpenPopup("mbfnp51000_p11", "", "")
End Sub

'============================================================================
Sub btnCounseling_OnClick()
	''상담 안내 팝업 후, 메리츠증권 고객지원센터 전화 연결
	Dim szAlertData, szTitle
	szTitle = "안내"
	g_ErrMsgText = "금융상품 전화 상담으로 연결됩니다.\n연결하시겠습니까?\n(상담가능시간 : 평일08시~18시)"
	szAlertData = "2".."★"..szTitle.."★"..g_ErrMsgText.."★".."errMsgBox".."★".."취소".."★".."연결하기"
	
	Form.OpenPopup("mbfnp51000_p12", szAlertData, "")	
End Sub

'============================================================================
Sub btnNext_OnClick()
	Form.OpenPopup( "mbonl88060_p18" ,  szData , "" )
'	g_szReturnKey = "OK"
'	Form.CloseForm()	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent( "mbonl88060_p13" , g_szReturnKey)
End Sub

'============================================================================
Sub Container0_btnCheck1_OnClick()
	'상품내용 및 투자대상
	Form.openPopupAnimation("mbonl88060_p14", "", "", "2")
End Sub

'============================================================================
Sub Container0_btnCheck2_OnClick()
	'투자위험 및 불이익
	Form.openPopupAnimation("mbonl88060_p15", "", "", "2")
End Sub

'============================================================================
Sub Container0_btnCheck3_OnClick()
	'투자설명서
	if g_OpenFilePath <> "" and g_OpenFilePath <> NULL then	
		'타이틀, url, 웹뷰type, 동의여부, 동의텍스트, 인덱스, 현재체크상태
		szData = "투자설명서".."★"..g_OpenFilePath.."★".."urlpath".."★".."N".."★".."".."★".."0".."★".."0"
		Form.OpenPopup( "mbonl88060_p12" ,  szData , "" )
	else
		Form.ShowAlert("알림", "파일없음")
		exit sub
	End if
End Sub

'============================================================================
Sub Container0_btnCheck4_OnClick()
	'투자자 유의사항
	Form.openPopupAnimation("mbonl88060_p16", "", "", "2")	
End Sub

'============================================================================
Sub Container0_btnCheck5_OnClick()
	'금융소비자의 권리
	Form.openPopupAnimation("mbonl88060_p17", "", "", "2")	
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	g_szReturnKey = "cancel"
	Form.CloseForm()	
End Sub

