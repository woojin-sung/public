'============================================================================
Sub Form_OnFormInit()

input1 = Form.GetSharedData("input1",false) '최초투자금액
input2 = Form.GetSharedData("input2",false) '월투자금액
input3 = Form.GetSharedData("input3",false) '투자예정기간
input4 = Form.GetSharedData("input4",false) '목표수익률
input5 = input1 + (input2 * input3) '최종 투자원금
input6 = Form.GetSharedData("input5",false) '예상 총 수익금
input7 = input5+input6 '최종목표자금
input8 = Form.GetSharedData("result",false)
input9 = Form.GetSharedData("purpose",false)



Table0.SetCellString(0, 1, input1&" 만원")
Table0.SetCellString(1, 1, input2&" 만원")
Table0.SetCellString(2, 1, input3&" 개월")

Table0.SetCellString(3, 1, input4&" %")
Table0.SetCellString(4, 1, input5&" 만원")
Table0.SetCellString(5, 1, "+"&input6&" 만원")  Table0.SetCellFgColor(5, 1, "92")

Table0.SetCellString(6, 1, input7&" 만원")
Table0.SetCellString(7, 1, input8)
Table0.SetCellString(8, 1, input9)
	
End Sub

'============================================================================
Sub Button0_OnClick()
	Form.OpenFramePopup("mbetc99000_s18" , "" , "")
End Sub

