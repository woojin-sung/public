		<CONTAINER name="contMain" vscroll="1" ly_vert="0,40,375,662,1" scroll_ly_vert="0,40,375,662,1" >
			<CONTROL_INFO>
				<LINKFORM name="LinkForm0" linkfile="nrshidx50020_s1" ly_vert="0,0,375,235,1" />
