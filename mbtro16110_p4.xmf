'		If g_BDM_Mndt_2_1_2_1 <> "Y" Or g_BDM_Mndt_2_1_2_2 <> "Y" Then
'			strYN = "N"
'		End If
'	End If
'	
'	If g_BDM_PRCD100 = "Y" Or g_BDM_PRCD101 = "Y" Or g_BDM_PRCD135 = "Y" Or g_BDM_PRCDCFD = "Y" Or g_BDM_PRCD137 = "Y" Then  'v0002 CFD추가	'v0003 해외CFD추가
		'3  조회(상품)_신용공여/미수/파생상품/해외파생_고유식별/개인신용
