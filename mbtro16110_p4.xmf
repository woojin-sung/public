' 종료
'============================================================================
'============================================================================
Sub Form_OnFormBackKeyPressed()
    btnExit_OnClick()
End Sub
'============================================================================
Sub btnExit_OnClick()
    g_RetFlag = "cancel"
'    if g_sz_OSType == "1" or g_sz_OSType == 1 then
'        NextStep()
'        Form.SetTimerEvent2("9999", 1, 0.1)
'    elseif g_sz_OSType == "2" or g_sz_OSType == 2 then
'        Form.CloseForm()
'	end if
	
	Form.CloseForm()
	
End Sub
'============================================================================
' 확인종료
'============================================================================
Sub btnOK_OnClick()
    g_RetFlag = "ok"
'    if g_sz_OSType == "1" or g_sz_OSType == 1 then
'        NextStep()
'        Form.SetTimerEvent2("9999", 1, 0.1)
'    elseif g_sz_OSType == "2" or g_sz_OSType == 2 then
'        Form.CloseForm()
'	end if
	
	NextStep()
	
End Sub
'============================================================================
Function NextStep()
    if g_RetFlag == "ok" then
        '공유정보Set
	    User_SharedData_Set("")
    end if    
    
    Dim bAllView
    bAllView = Form.GetSharedData("mbtro16110_Agree_AllYn", false)
    
    If CInt(bAllView) == 1 Then
	    '전체동의의 경우 고객 유의사항 띄워줌
	    Form.OpenPopup("mbtro16110_p5", "", "")
    Else
	    '약관목록으로 돌아가고 현재화면 닫기
	    Form.SendReturnToParent("mbtro16110_p4", g_RetFlag)
	    Form.CloseForm()
    End If
    
'    '약관목록으로 돌아가고 현재화면 닫기
'    Form.SendReturnToParent("mbtro16110_p4", g_RetFlag)
End Function
