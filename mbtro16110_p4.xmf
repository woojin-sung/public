    g_BDM_137_CtcnChk1 	= Form.GetSharedData("BDM_137_CtcnChk1"		, false)	'v0004 해외CFD계좌 약관/거래설명서
    g_BDM_BNK_MNY_OPNG_YN 	= Form.GetSharedData("BDM_BNK_MNY_OPNG_YN"    , false)	'v0007 단기다수개설 여부 
