Function User_Conti_Data_Set()

	'기선택된 정보인 경우 화면표시 처리
	User_Chk_Image_Set("1_1_1_1", g_BDM_Mndt_1_1_1_1)   '1.1 수집이용(공통)_고유식별
	User_Chk_Image_Set("1_1_1_2", g_BDM_Mndt_1_1_1_2)		'1.1 수집이용(공통)_개인신용
	User_Chk_Image_Set("1_2_1_1", g_BDM_Mndt_1_2_1_1)		'1.2 수집이용(상품)_신용/미수/파생_고유식별
	User_Chk_Image_Set("1_2_1_2", g_BDM_Mndt_1_2_1_2)		'1.2 수집이용(상품)_신용/미수/파생_개인신용
	User_Chk_Image_Set("1_2_2_1", g_BDM_Mndt_1_2_2_1)		'1.2 수집이용(상품)_비과세/ISA/연금저축_고유식별
	User_Chk_Image_Set("1_2_2_3", g_BDM_Mndt_1_2_2_3)		'1.2 수집이용(상품)_비과세/ISA/연금저축_민감정보
	User_Chk_Image_Set("1_2_2_2", g_BDM_Mndt_1_2_2_2)		'1.2 수집이용(상품)_비과세/ISA/연금저축_개인신용
	User_Chk_Image_Set("1_2_3_1", g_BDM_Mndt_1_2_3_1)		'1.2 수집이용(상품)_해외주식/해외파생/해외금융/EUREX_고유식별
	User_Chk_Image_Set("1_2_3_2", g_BDM_Mndt_1_2_3_2)		'1.2 수집이용(상품)_해외주식/해외파생/해외금융/EUREX_개인신용
	User_Chk_Image_Set("2_1_1_1", g_BDM_Mndt_2_1_1_1)		'2.1 제공(상품)_신용/미수/파생/해외파생_고유식별
	User_Chk_Image_Set("2_1_1_2", g_BDM_Mndt_2_1_1_2)		'2.1 제공(상품)_신용/미수/파생/해외파생_개인신용
	User_Chk_Image_Set("2_1_2_1", g_BDM_Mndt_2_1_2_1)		'2.1 제공(상품)_해외주식/해외파생/해외금융/EUREX_고유식별
	User_Chk_Image_Set("2_1_2_2", g_BDM_Mndt_2_1_2_2)		'2.1 제공(상품)_해외주식/해외파생/해외금융/EUREX_개인신용
	User_Chk_Image_Set("3_1_1_1", g_BDM_Mndt_3_1_1_1)		'3   조회(상품)_신용/미수/파생/해외파생_고유식별
	User_Chk_Image_Set("3_1_1_2", g_BDM_Mndt_3_1_1_2)		'3   조회(상품)_신용/미수/파생/해외파생_개인신용
	
	'다음버튼 활성화/비활성화
	User_Btn_OKStep()
End Function




