'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'안드로이드-백버튼 작동X
	'부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
	'Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")

	'약관
	if sKeyName == "mbtro16110_p6" then
		if sRet == "ok_Mndt" then
			'약관확인 종료시, 모두동의 한 것으로 체크
			g_BDM_Mndt_1_1_1_1 = "Y"
			g_BDM_Mndt_1_1_1_2 = "Y"
			User_Chk_OK("1_1_1_1", g_BDM_Mndt_1_1_1_1)	' 수집이용(공통)_고유식별
