Function User_Chk_Image_Set(trgt, chk)

	'수집이용(공통)
	If trgt = "1_1_1_1" Then '고유식별
		If chk == "Y" Then
			containMain.contain1S.img11.imgpath = "check_on.png"
		Else
			containMain.contain1S.img11.imgpath = "check_off.png"
		End If
	ElseIf trgt = "1_1_1_2" Then '개인신용
		If chk == "Y" Then
			containMain.contain1S.img12.imgpath = "check_on.png"
		Else
			containMain.contain1S.img12.imgpath = "check_off.png"
		End If	

	'수집이용(상품)_신용공여/미수
	ElseIf trgt = "1_2_1_1" Then '고유식별
		If chk == "Y" Then
			containMain.contain2S11.img11.imgpath = "check_on.png"
		Else
			containMain.contain2S11.img11.imgpath = "check_off.png"
		End If
	ElseIf trgt = "1_2_1_2" Then '개인신용
		If chk == "Y" Then
			containMain.contain2S11.img12.imgpath = "check_on.png"
		Else
			containMain.contain2S11.img12.imgpath = "check_off.png"
		End If	

	'수집이용(상품)_비과세/ISA/연금
	ElseIf trgt = "1_2_2_1" Then '고유식별
		If chk == "Y" Then
			containMain.contain2S21.img11.imgpath = "check_on.png"
		Else
			containMain.contain2S21.img11.imgpath = "check_off.png"
		End If
	ElseIf trgt = "1_2_2_2" Then '개인신용
		If chk == "Y" Then
			containMain.contain2S21.img12.imgpath = "check_on.png"
		Else
			containMain.contain2S21.img12.imgpath = "check_off.png"
		End If	

	'수집이용(상품)_해외주식/해외파생/EUREX
	ElseIf trgt = "1_2_3_1" Then '고유식별
		If chk == "Y" Then
			containMain.contain2S31.img11.imgpath = "check_on.png"
		Else
			containMain.contain2S31.img11.imgpath = "check_off.png"
		End If
	ElseIf trgt = "1_2_3_2" Then '개인신용
		If chk == "Y" Then
			containMain.contain2S31.img12.imgpath = "check_on.png"
		Else
			containMain.contain2S31.img12.imgpath = "check_off.png"
		End If	

	'제공(상품)_신용공여/미수/해외파생
	ElseIf trgt = "2_1_1_1" Then '고유식별
		If chk == "Y" Then
			containMain.contain3S11.img11.imgpath = "check_on.png"
		Else
			containMain.contain3S11.img11.imgpath = "check_off.png"
		End If
	ElseIf trgt = "2_1_1_2" Then '개인신용
		If chk == "Y" Then
			containMain.contain3S11.img12.imgpath = "check_on.png"
		Else
			containMain.contain3S11.img12.imgpath = "check_off.png"
		End If

	'제공(상품)_해외주식/해외파생/해외금융/EUREX
	ElseIf trgt = "2_1_2_1" Then '고유식별
		If chk == "Y" Then
			containMain.contain3S21.img11.imgpath = "check_on.png"
		Else
			containMain.contain3S21.img11.imgpath = "check_off.png"
		End If
	ElseIf trgt = "2_1_2_2" Then '개인신용
		If chk == "Y" Then
			containMain.contain3S21.img12.imgpath = "check_on.png"
		Else
			containMain.contain3S21.img12.imgpath = "check_off.png"
		End If
		
	'조회(상품)_신용공여/미수/해외파생
	ElseIf trgt = "3_1_1_1" Then '고유식별
		If chk == "Y" Then
			containMain.contain4S11.img11.imgpath = "check_on.png"
		Else
			containMain.contain4S11.img11.imgpath = "check_off.png"
		End If
	ElseIf trgt = "3_1_1_2" Then '개인신용
		If chk == "Y" Then
			containMain.contain4S11.img12.imgpath = "check_on.png"
		Else
			containMain.contain4S11.img12.imgpath = "check_off.png"
		End If

	End If

End Function 
'============================================================================
Function User_Chk_OK(trgt, chk)
	'Y/N 설정
	'수집이용(공통)
	If trgt = "1_1_1_1" Then '고유식별
		g_BDM_Mndt_1_1_1_1 = chk
	ElseIf trgt = "1_1_1_2" Then '개인신용
		g_BDM_Mndt_1_1_1_2 = chk

	'수집이용(상품)_신용공여/미수
	ElseIf trgt = "1_2_1_1" Then '고유식별
		g_BDM_Mndt_1_2_1_1 = chk
	ElseIf trgt = "1_2_1_2" Then '개인신용
		g_BDM_Mndt_1_2_1_2 = chk

	'수집이용(상품)_비과세/ISA/연금
	ElseIf trgt = "1_2_2_1" Then '고유식별
		g_BDM_Mndt_1_2_2_1 = chk
	ElseIf trgt = "1_2_2_2" Then '개인신용
		g_BDM_Mndt_1_2_2_2 = chk

	'수집이용(상품)_해외주식/해외파생/EUREX
	ElseIf trgt = "1_2_3_1" Then '고유식별
		g_BDM_Mndt_1_2_3_1 = chk		
	ElseIf trgt = "1_2_3_2" Then '개인신용
		g_BDM_Mndt_1_2_3_2 = chk

	'제공(상품)_신용공여/미수/해외파생
	ElseIf trgt = "2_1_1_1" Then '고유식별
		g_BDM_Mndt_2_1_1_1 = chk
	ElseIf trgt = "2_1_1_2" Then '개인신용
		g_BDM_Mndt_2_1_1_2 = chk

	'제공(상품)_해외주식/해외파생/해외금융/EUREX
	ElseIf trgt = "2_1_2_1" Then '고유식별
		g_BDM_Mndt_2_1_2_1 = chk
	ElseIf trgt = "2_1_2_2" Then '개인신용
		g_BDM_Mndt_2_1_2_2 = chk
		
	'조회(상품)_신용공여/미수/해외파생
	ElseIf trgt = "3_1_1_1" Then '고유식별
		g_BDM_Mndt_3_1_1_1 = chk
	ElseIf trgt = "3_1_1_2" Then '개인신용
		g_BDM_Mndt_3_1_1_2 = chk
		
	End If
	
	'Y/N 설정에 따른 색상표시
	User_Chk_Image_Set(trgt, chk)

	'다음버튼 활성화/비활성화
	User_Btn_OKStep()
	
End Function
'============================================================================
Function User_Btn_OKStep()

	strYN = "Y"

	'수집이용(공통)_고유식별/개인신용
	If g_BDM_Mndt_1_1_1_1 <> "Y" Or g_BDM_Mndt_1_1_1_2 <> "Y" Then
		strYN = "N"
	End If
