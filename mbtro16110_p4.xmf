Function f_sGetURL(iIdx)	
	dim sURLheader, sURL
	Select Case iIdx
		Case 1
			'"보유주식 수익 서비스 약관"
			If ServerMode == "1" Then	'개발기
				sURLheader = "http://211.201.184.87/include/resource/comm/ctcn/pdf/"
			Else
				sURLheader = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/"
			End If
			sURL = sURLheader & "crinoferagrm14.pdf"
		Case 2
			'"보유주식 수익 서비스 핵심설명서"
			If ServerMode == "1" Then	'개발기
				sURLheader = "http://211.201.184.87/include/resource/comm/ctcn/pdf/"
			Else
				sURLheader = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/"
			End If
			sURL = sURLheader & "crinoferagrm15.pdf"
	End Select
	
	return sURL
End Function

Function f_sGetURLTitle(iIdx)
	Dim szTitle
	Select Case iIdx
		Case 1
			szTitle = "개인정보제공 및 활용동의"
		Case 2
			szTitle = "개인정보제공 및 활용동의"
	End Select
	return szTitle
End Function

'============================================================================
' 동의서보기
'============================================================================
Sub lblCtcnShow_OnClick()
'	'공유정보Set
'	User_SharedData_Set("")
'
'	Form.OpenPopup(G_STEP2_2_P1_FILE, "Mndt", "")
	
	szURL = f_sGetURL(1) & "★" & f_sGetURL(2)
	szTitle = f_sGetURLTitle(1) & "★" & f_sGetURLTitle(2)
	
	g_bAllView = true
	
	'팝업 호출
	if szURL <> "" then
		Form.OpenPopup("mbtro16110_p6" , szURL&"♥"&szTitle, "")
	end if		
	
End Sub


'============================================================================
Sub Form_OnTimerEvent(sTimerID)
    if sTimerID == "9999" or sTimerID == 9999 then
        Form.SetTimerEvent2(sTimerID, 0, 0.1)
        if g_sz_OSType == "1" or g_sz_OSType == 1 then
            Form.CloseForm()
        end if
    end if
End Sub
