--===========================================================================
--===========================================================================

'============================================================================
Sub Form_OnFormInit()
	
	Dim sSendData
	
	'sSendData ==> 계좌번호★계좌일련번호★비밀번호★포트폴리오번호

	sSendData = Form.GetOpenLinkData()
	g_szList = Split(sSendData,"★")

	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	DATAMANAGER.RequestTranData("obsap_smpr_009r")

End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obsap_smpr_009r" Then
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_009r", "InBlock1", "ACNO" 			, 0 , g_szList(0) )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_009r", "InBlock1", "ASNO" 			, 0 , g_szList(1) )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_009r", "InBlock1", "PRTF_SRNO" 		, 0 , g_szList(3) )
	End If	
	If szTranID == "obsap_smpr_002a" Then
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_002a", "InBlock1", "ACNO" 			, 0 , g_szList(0) )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_002a", "InBlock1", "ASNO" 			, 0 , g_szList(1) )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_002a", "InBlock1", "ACNT_PWD" 		, 0 , g_szList(2) )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_002a", "InBlock1", "PRTF_SRNO" 		, 0 , g_szList(3) )
	End If
	If szTranID == "obcpp_bsdy_006r" Then ' 익영업일
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r", "InBlock1", "CLND_CLS_CODE" 	, 0 , "C003" ) ' 거래소
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r", "InBlock1", "MANG_DATE" 		, 0 , Calendar0.caption )
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r", "InBlock1", "CALC_DYNU" 		, 0 , 1 )
	End If
	If szTranID == "obcpp_bsdy_006r_1" Then ' 익익영업일
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r_1", "InBlock1", "CLND_CLS_CODE" 	, 0 , "C003" ) ' 거래소
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r_1", "InBlock1", "MANG_DATE" 		, 0 , Calendar0.caption )
		DATAMANAGER.SetDataValue( 0, "obcpp_bsdy_006r_1", "InBlock1", "CALC_DYNU" 		, 0 , 2 )
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obsap_smpr_009r" Then
		DATAMANAGER.RequestTranData("obcpp_bsdy_006r")
		DATAMANAGER.RequestTranData("obcpp_bsdy_006r_1")
	End If
	If szTranID == "obcpp_bsdy_006r" Then
		NxBsdy = DATAMANAGER.GetDataValue(0, "obcpp_bsdy_006r" , "OutBlock1" , "MANG_DATE", 0)
		Container0.Table1.SetCellString( 2, 1, "\n익 영업일(" & Left(NxBsdy, 4) & "년\n" & Mid( NxBsdy, 5, 2 ) & "월 " & Mid( NxBsdy, 7, 2 ) &  "일)" & " 3시\n" )
		Container0.Table1.SetCellString( 1, 2, "\n익 영업일(" & Left(NxBsdy, 4) & "년\n" & Mid( NxBsdy, 5, 2 ) & "월 " & Mid( NxBsdy, 7, 2 ) &  "일)" & " 오전\n" )
	End If
	If szTranID == "obcpp_bsdy_006r_1" Then
		Nx2Bsdy = DATAMANAGER.GetDataValue(0, "obcpp_bsdy_006r_1" , "OutBlock1" , "MANG_DATE", 0)
		Container0.Table1.SetCellString( 2, 2, "\n익익 영업일(" & Left(Nx2Bsdy, 4) & "년\n" & Mid( Nx2Bsdy, 5, 2 ) & "월 " & Mid( Nx2Bsdy, 7, 2 ) &  "일)" & " 3시\n" )
	End If	
	If szTranID == "obsap_smpr_002a" Then
		Form.MsgBox( "검토신청", "검토신청이 완료되었습니다.\n\n진행상황은 주식>Smart Pro>진행현황에서 확인 가능합니다.", "EXMN_APLT_COMPLETE", 0 )
	End If	
End Sub

'============================================================================
Sub Button0_OnClick()
	Form.MsgBox( "검토신청", "검토신청 하시겠습니까?", "EXMN_APLT", 1 )
End Sub


'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "EXMN_APLT" Then '검토신청 확인취소
		If sRet == "ok" Then
			DATAMANAGER.RequestTranData("obsap_smpr_002a")
		Else
			Exit Sub
		End If
	ElseIf sKeyName == "EXMN_APLT_COMPLETE" Then
		Form.OpenScreen("55001" , "") '진행현황
	End If
End Sub

'============================================================================
Sub Button1_OnClick() ' 이전
	
	Form_OnFormBackKeyPressed()
	
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")

End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()

	Form.CloseForm()
	
End Sub

