'============================================================================
Sub BtnNext_OnClick()

	'20210309 김유경 Form.CloseForm() 제거, OpenNextPopup 추가
	If sNmetBswrGb == "001" Then
		Form.OpenNextPopup("mbbdm85250", "", "" ) '001.온라인개설계좌 실명확인
	ElseIf sNmetBswrGb == "002" Then
		Form.OpenNextPopup("mbbdm85290", "", "" ) '002.계좌비밀번호 재설정
	ElseIf sNmetBswrGb == "003" Then	
		Form.OpenNextPopup("mbbdm85260", "", "" ) '003.인증서 온라인신원확인 동의
	ElseIf sNmetBswrGb == "004" Then
		Form.OpenNextPopup("mbbdm85210", "", "" ) '004.온라인서비스 신청
	ElseIf sNmetBswrGb == "005" Then
		Form.OpenNextPopup("mbbdm85220", "", "" ) '005.온라인 이체한도 등록 및 증액
	ElseIf sNmetBswrGb == "006" Then
		Form.OpenNextPopup("mbotp86106", "", "" ) '006.타기관 OTP이용등록
	ElseIf sNmetBswrGb == "007" Then
		Form.OpenNextPopup("mbbdm85270", "", "" ) '007.타기관 은행 이체 등록
	ElseIf sNmetBswrGb == "008" Then
		Form.OpenNextPopup("mbbdm85280", "", "" ) '008.메리츠 종합계좌간 대체 등록
	ElseIf sNmetBswrGb == "009" Then
		Form.OpenNextPopup("mbotp86100", "", "" ) '009.모바일OTP발급
	ElseIf sNmetBswrGb == "300" Then		'300. MTS에서 모바일 OTP 발급 진행
		Form.PostLinkData( "mOTPIssuAbleYn", "OK")
		Form.CloseForm()
	ElseIf sNmetBswrGb == "301"     Then
		szData = "P☆안내"
		Form.OpenNextPopup("mbotp86101", szData, "" ) '301. 모바일OTP비밀번호 초기화
		
	ElseIf sNmetBswrGb == "010" Then		'단기다수개설_출금고_제한해지
		Form.OpenNextPopup("mbbdm85240", "", "")
		'Form.CloseForm()
	End If
	'20210309 김유경 Form.CloseForm() 제거, OpenNextPopup 추가
	
End Sub

'============================================================================
' 테스트인증Skip
'============================================================================
Sub chkSkip_OnChange(sCheckState)
	If sCheckState == "0" Or sCheckState == 0 Then     	
		BtnNext.enable = False
		BtnNext.btnimage = "btn_21.9"
		BtnNext.fgcolor = "269"
	Else 
		BtnNext.enable = True
		BtnNext.btnimage = "btn_20.9"
		BtnNext.fgcolor = "273"
    End If
End Sub 

'============================================================================
Sub Form_OnFormClose()
	If closeFlag == "2" Then
		Form.OpenScreen( "41000" , "")
	End If
End Sub 
'============================================================================
Sub ContMain_Button0_OnClick()
	Call Image1_OnClick()
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	If sTimerID == "2" or sTimerID == 2 Then
		Form.SetTimerEvent2("2", 0, 0.8)
		ContMain.Edit0.SetShowKeypad(true)
	Elseif sTimerID == 14 or sTimerID == "14" then
		if g_HPSec ==  0 then
			Form.SetTimerEvent(14, 0, 1)
			Call InitCountTimer()					'5분 타이머 초기화
			ContMain.Edit0.SetResultLabel("1", "error","인증시간이 만료되었습니다.\n 다시 시도하여 주시기 바랍니다." ,"ContMain")
			ContMain.Image3.visible = true
			ContMain.LblTime.visible = false
			ContMain.Edit0.enable = false
			ContMain.Edit0.SetStatus("error")
			'Container0.Edit1.enable = false
			'Container0.Edit1.caption = ""
			'Container0.btnConfirm.enable = false		
			'Container0.btnConfirm.visible = false	
			
		else
			Dim nMin, nSec
			nMin  = int(g_HPSec / 60 )
			nSec  =  g_HPSec mod  60
			if len(nSec) == 1 then 
				nSec = "0"..nSec
				nSec = nSec
			End if 	
			ContMain.LblTime.caption = nMin..":"..nSec
			g_HPSec = g_HPSec-1		
		End if
	Elseif sTimerID == 15 or sTimerID == "15" then
		Form.SetTimerEvent2(sTimerID, 0, 0)
		ContMain.Edit0.SetResultLabel("1", "error",g_szResultText,"ContMain")	
	End If
End Sub

'============================================================================
' 인증번호 만료기간 5분 타이머 초기화 'v0007
'============================================================================
Sub InitCountTimer()
	ContMain.LblTime.caption	= "5:00"	
	g_HPSec = 300
	Form.SetTimerEvent(14, 0, 1)	'5분타이머 종료
End Sub

'============================================================================
' v0007 인증번호 재요청
'============================================================================
Sub ContMain_Image3_OnClick()
    DATAMANAGER.RequestTranData("obtss_opnf_101a")
End Sub

