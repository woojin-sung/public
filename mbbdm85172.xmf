'============================================================================
Sub ContMain_Image0_OnClick()
	ContMain_Label0_OnClick()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranId = "obaci_nmet_012a" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "ATHN_CNFR_NO"  , 0 , ContMain.Edit0.caption) '인증확인번호	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_UNIQ_NO"   , 0 , gRegUniqNo            ) '인증확인번호	
	ElseIf szTranId = "obcsb_nmet_101a" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "CSNO" 			, 0 , gCsno                 ) '거래일자
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_UNIQ_NO" 	, 0 , gRegUniqNo            ) '등록고유번호
	ElseIf szTranID = "obtss_opnf_101a" Then
		'v0007 start
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "RCVN_DATE"			 , 0 , gRcvnDate              )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "RCVN_IQRY_NO"		 , 0 , gRcvnIqryNo            )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "NMET_BSWR_CLCD"		 , 0 , sNmetBswrGb            )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "MNRC_BANK_CODE"		 , 0 , getDataBankCode             )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "BANK_ACNO"			 , 0 , getDataBankAcno )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "ACHO_NAME"			 , 0 , sName                  )
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1",  "REG_UNIQ_NO"		 , 0 , gRegUniqNo             )
		'v0007 end
	End If
End Sub

'===========================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obaci_nmet_012a" Then
		
		gAthnMstkCsnu = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" ,  "ATHN_MSTK_CSNU", 0) 
		gAthnCnfrDate = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" ,  "ATHN_CNFR_DATE", 0) 
		
		If LEN(TRIM(gAthnCnfrDate)) > 0 Then '인증완료 
			InitCountTimer()
			ContMain.Edit0.SetResultLabel("1", "complete","본인계좌 인증에 성공하였습니다.","ContMain")
			ContMain.Edit0.enable = False
			Form.SetTimerEvent(14, 0, 1)   '타이머 종료
			'2021.04.28. CIKEY insert/update 서비스 콜 제거
			'DATAMANAGER.RequestTranData("obcsb_nmet_101a")
			BtnNext.enable = True
			BtnNext.btnimage = "btn_20.9"
			BtnNext.fgcolor = "273"
			
		Else
			
			If Cint(gAthnMstkCsnu) >= 10 Then
				Form.OpenPopup("mbbdm85172_p1", "" , "" )
			Else
				if g_HPSec ==  60 then
				else
					g_szResultText = "인증번호가 일치하지 않습니다.("..	Cint(gAthnMstkCsnu).."/10)\n 10회 오류 시 신청과정이 종료됩니다."
					Form.SetTimerEvent2(15, 1, 0.3)
					'ContMain.Edit0.SetResultLabel("1", "error","인증번호가 일치하지 않습니다.("..	Cint(gAthnMstkCsnu).."/10)\n 10회 오류 시 신청과정이 종료됩니다." ,"ContMain")
					Form.SetTimerEvent2("2", 1, 0.8) '1:Set
				End If
			End If

		End If
	'2021.04.28. CIKEY insert/update 서비스 콜 제거
'	ElseIf szTranID = "obcsb_nmet_101a" Then
'		BtnNext.enable = True
'		BtnNext.btnimage = "btn_20.9"
'		BtnNext.fgcolor = "273"
	'v0007 start
	ElseIf szTranID = "obtss_opnf_101a" Then
		Dim gNrmlYn
		gNrmlYn           = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "NRML_YN" 	         , 0)
		if gNrmlYn == "Y" Then
			Form.MsgBox( "알림", "1원송금을 완료했습니다.\n입금자명을 확인해주시기 바랍니다.", "", 6 )
			ContMain.Image3.visible = false
			ContMain.LblTime.visible = true
			ContMain.Edit0.enable = true
			ContMain.Edit0.SetResultLabel("0", "","" ,"ContMain")
			ContMain.Edit0.caption = ""
			InitCountTimer()
			Form.SetTimerEvent(14, 1, 1)	
		else
			Form.MsgBox( "알림", "본인계좌인증에 실패하였습니다. 다시 시도하여 주시기 바랍니다.", "", 6 )
		end if
	'v0007 end
	End If
End Sub 
	
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) 
	If szTranID == "obaci_nmet_012a" Then
		'2021.04.13. 김유경. 메시지 추가
		'ContMain.Edit0.SetResultLabel("1", "error","계좌변경 선택 후 재처리 바랍니다." ,"ContMain")
		g_szResultText = "계좌변경 선택 후 재처리 바랍니다."
		Form.SetTimerEvent2(15, 1, 0.3)
	Else
		ShowAlert "안내", szErrMsg&"\n("&DATAMANAGER.GetDataMsgSubText(szTranID)&")"
	End If
			
End Sub 


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'	If sKeyName == "mbbdm10071_p1" Then	
'		Form.OpenPopup("tmp10002", "" , "" ) '홈으로
'	End If

	If sKeyName = "mbbdm85172_p1_end" Then
		If sRet == "ok" Then
			
			closeFlag = "2"
			Form.CloseForm()
			
		End If
		
    end if
    
End Sub 
