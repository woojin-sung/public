'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 업무신청-본인계좌 인증(2/2)
' 02. 화면설명 : 본인계좌 인증_입금자명 인증
' 03. 작    성 : 2021.01.13 김유경
' 04. 수    정 :  
'-------------------------------------------------------------------------------------------
' 1. 수취조회
'    - mbbdm10070.xmf (obtss_arss_101r)
' 2. 비대면 업무신청  송금정보 관리 (신규)
'    - TBACIA072L03  계좌_비대면계좌개설예정 송금정보  / 변경
'    - 수취조회한 이력까지만 INSERT 
'    -  mbbdm10070.xmf (obaci_nmet_013a)
' 3. 1원 역이체 
'    -  mbbdm10070.xmf (obtss_opnf_101a)
' 4. 1원이체 검증 (신규)_
'    -  mbbdm10072.xmf (obaci_nmet_012a)
' 5. 민간인증서 관리/사용에 필요한 CIKEY 정보 INSERT (신규)
'   - TBCSBA100L00 고객_개인식별번호내역
'   -  mbbdm10072.xmf (obcsb_nmet_101a)
' 2022.12.08 : 강희승 : v0007 : 비대면 본인계좌인증 화면 개선 요청의 건
' 2023.08.04 : 양현정 : v0008 : 권한설정 추가
' 2023.08.22 : 전상일 : v0009 : "계좌변경" 텍스트 짤림 수정(스크립트 수정 없음)
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim gTrDate
Dim gOtsdTrUniqNo
Dim gAthnMstkCsnu
Dim sNmetBswrGb '비대면업무구분 (100.비대면계좌개설 000.비대면업무신청)
Dim gRegUniqNo '등록고유번호
Dim gCsno
Dim gBackYn

Dim g_OsType
Dim szTheme

Dim sLOGIN_TYPE 'v0008

'****************************************************************************
' v0007 obtss_opnf_101a
'****************************************************************************
Dim gRcvnDate
Dim gRcvnIqryNo
Dim gBankCode
Dim gBankAcno
Dim sName
Dim getDataBankCode        
Dim getDataBankAcno  
Dim getDataBankName
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
Sub Form_OnFormInit()
	g_OsType = Form.GetSharedData("&OS_TYPE", False)
	szTheme  = Form.GetEnvData("common.theme")
	ContMain.Image3.SetMaintainingRatio("3")
	ContMain.Image3.imgpath ="btn_re_request"
	
	Image1.imgpath = "icon_top_back_light"
	
	'확인버튼 비활성화
	BtnNext.enable   = False
	If szTheme == "black" Then
		BtnNext.btnimage = "btn_27.9"
	Else
		BtnNext.btnimage = "btn_21.9"
	End If
	BtnNext.fgcolor  = "269"
	
	
    'v0008 다른앱 인증번호 확인후 돌아오면서 권한설정 풀리는 경우가 있어 재설정 추가(함원규대리확인)
    '로그인여부
    sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", False )

    '비로그인상태에서만 비대면화면 권한부여
    If CInt(sLOGIN_TYPE) <= 1 Then '비로그인상태
        Form.SetSharedData("&SCREEN_AUTH" , "99") '비대면화면 권한부여
    End If
    	
	
	ContMain.Edit0.setApplyLabel("입금자 표시번호" ,0 , 268 , "left" , False )
	ContMain.Edit0.SetUseResultLabel(true,2)
	'v0007 start
	ContMain.LblTime.bringFront("1")
	ContMain.Image3.bringFront("1")
	ContMain.Image3.visible = false
	InitCountTimer()
	Form.SetTimerEvent(14, 1, 1)
	'v0007 end
	
	sNmetBswrGb	= Form.GetSharedData("BDM_NMETBSWRGB"      , false ) 
	gTrDate 	     = Form.GetSharedData("BDM_TR_DATE"         , false ) 
	gOtsdTrUniqNo = Form.GetSharedData("BDM_OTSD_TR_UNIQ_NO" , false ) 
	gRegUniqNo    = Form.GetSharedData("BDM_REG_UNIQ_NO"     , false ) 
	gCsno         = Form.GetSharedData("BDM_CSNO"            , false ) 
	
	'v0007 start
	gRcvnDate = Form.GetSharedData("RCVN_DATE"      , false ) 
	gRcvnIqryNo = Form.GetSharedData("RCVN_IQRY_NO"      , false ) 
	sName = Form.GetSharedData("ACHO_NAME"      , false )
	
	getDataBankCode = Form.GetSharedData("BDM_BANKCODE"	      , false )
	getDataBankAcno = Form.GetSharedData("BDM_BANKACNO"	      , false )
	getDataBankName =	Form.GetSharedData("BDM_BANKNAME"         , false )
	'v0007 end
	
	'테스트용 인증스킵 체크
    nDev = Form.GetSharedData("&SERVER_MODE", False )
    
    If nDev == "1" Or nDev == 1 Then
        chkSkip.visible = True
        'chkSkip.checkstate = "1"  '자동체크 해제
    Else
        chkSkip.visible = False
        chkSkip.checkstate = "0"
    End If
    
End Sub

'============================================================================
Sub ContMain_Edit0_OnEditComplete()
	If ContMain.Edit0.caption = "" Then
	   g_szResultText = "인증번호가 입력되지 않았습니다."
	   Form.SetTimerEvent2(15, 1, 0.3)
	   ContMain.Edit0.SetStatus("error")
	else
		DATAMANAGER.RequestTranData("obaci_nmet_012a")
	End If
End Sub

