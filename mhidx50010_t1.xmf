'============================================================================
' 01. 화 면 명 : HOME_실시간순위
' 02. 화면설명 : 실시간순위_국내
' 03. 작    성 : 
'============================================================================
' 컨트롤 정리
'grdCode		-> 종목 목록 (시세조회 전- 종목코드 코드 관련 정보만)
'grdMk		-> 마켓별 종목 분류
'grdGroup	-> 관심그룹 목록
'grd0 (삭제)	-> 정리된 종목 목록 시세처리 받는 컨트롤(ASIS mhidx41020_s4에 있었음. 이번엔 판넬에 바로 적용하여 삭제)

'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szCode			'종목코드
Dim g_nCount			'항목개수
g_nCount = 0 			'20210916 SWJ START
Dim g_nHour			'시간
Dim g_nMinute			'분

dim	g_szRSelect
g_szRSelect = "0"

dim g_nProc
g_nProc = 0

dim g_tCode
g_tCode = {}

Dim g_nMaxCnt
g_nMaxCnt = 5

Dim g_szUserID

Dim g_tGSelect
Dim g_tGDefault
Dim g_tKey
Dim g_tNm

Dim g_szIndex

Dim g_szAppFirst
g_szAppFirst = "NO"

Dim g_sPopupType

Dim g_szOsType

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************

'============================================================================
' Save_grdMk : 실시간을 위해 중복되지 않는 시장구분을 저장해둔다.
'============================================================================
Function Save_grdMk()
	grdMk.rowcount = 0
	dim szMk, szCd, szGubun
	
	For i = 0 to grdCode.rowcount-1
	
		szMk = Trim(grdCode.GetCellData("bd_mk", i))
		szCd = Trim(grdCode.GetCellData("bd_code", i))
		szGubun = Trim(grdCode.GetCellData("bd_gubun", i))
		
		' MTS에서 보여주는 상품의 종목만 선택
		szMk =  f_ChkMarket(szMk, szCd)
		
		if szMk <> "" then
			nRow2 = CInt(grdMk.rowcount)
	
			if nRow2 == 0 then
				grdMk.insertrow = 0
				grdMk.SetCellData("bd_mk", 0, szMk)
				grdMk.SetCellData("bd_code", 0, szCd)
				grdMk.SetCellData("bd_gubun", 0, szGubun)
			end if
	
			For j = 0 to nRow2 - 1
				dim szMk2
				szMk2 = Trim(grdMk.GetCellData("bd_mk", j))
				
				if szMk == szMk2 then		
					szCd2 = grdMk.GetCellData("bd_code", j) & "★" & szCd
					grdMk.SetCellData("bd_code", j, szCd2)
					grdMk.SetCellData("bd_gubun", j, szGubun)
				end if
				
				if j == nRow2 - 1 then
					grdMk.insertrow = 0
					grdMk.SetCellData("bd_mk", 0, szMk)
					grdMk.SetCellData("bd_code", 0, szCd)
					grdMk.SetCellData("bd_gubun", j, szGubun)
				end if
			Next		
		end if
	Next

	' 관심종목 데이터조회
	DATAMANAGER.RequestTranData( "ohhts_1020_004r" ) '국내 시세 조회 -> 해외 시세 조회

End Function

'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	Select Case szMk
		Case "J", "Q", "F", "MF", "XF", "O", "MO", "QO", "U", "T", "W", "B", "P", "N", "EN", "FN", "EMPTY", "JF", "JO", "WO", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	
			return szMk
		'해외주식	
		Case "AX", "HK", "JP", "SZ", "SH", "NY", "OQ"
			return szMk
'		Case "N"			' 해외지수, 환율은 같은 시장구분으로 내려오기에 분리시켜야 한다.
'			If InStr(szCd, "@") == 0 then
'				return "EN"
'			else
'				return szMk
'			end if
		Case Else
			return ""
	End Select
	
End Function

'============================================================================
' Change_EtcMarket :  해외지수(대표, 업종지수)/ 채권의 마켓구분 변경
'============================================================================
Function Change_EtcMarket(szData)
	if Trim(szData) == "UJ" then
		return "N"
	elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		return "B"
	end if	
	
	return szData
End Function
'============================================================================
' f_getExchCode2 :  3자리 일경우 2자리로 변경
'============================================================================
Function f_getExchCode2(szExchCode3)
	if szExchCode3 == "NAS" then
		return "OQ"
	elseif szExchCode3 = "AMX" then
		return "AX"
	elseif szExchCode3 = "NYS" then
		return "NY"
	elseif szExchCode3 = "SHS" then
		return "SH"
	elseif szExchCode3 = "SZS" then
		return "SZ"
	elseif szExchCode3 = "HKS" then
		return "HK"
	elseif szExchCode3 = "TSE" then
		return "JP"
	end if
	
	return szExchCode3
End Function

'============================================================================
' 입력값조절
'============================================================================
Sub Decimal_Setting(sValue, sDecimalLen)
	Dim sReturn
	sReturn = sValue
	if ( sValue ~= nil and sValue ~= "" ) and ( sDecimalLen ~= nil and sDecimalLen ~= "" ) then
		Dim sSign
		Dim nDecimal
		sSign = Left(sValue, 1)
		nDecimal = CDbl(sDecimalLen)
		if CDbl( sValue ) == 0 then
			if nDecimal > 0 then
				sReturn = "0."
				for i = 0 to nDecimal-1
					sReturn = sReturn.."0"
				next
			else
				sReturn = "0"
			end if			
		else
			Dim sTemp
			sTemp = {}
			sTemp = Split( sValue, "." )
			if nDecimal > 0 then
				if #sTemp >= 2 and sTemp[1] ~= nil and sTemp[1] ~= "" then
					Dim tempLen
					tempLen = Len(sTemp[1])
					if tempLen > nDecimal then
						sReturn = sTemp[0].."."..Left(sTemp[1], nDecimal)
					elseif tempLen < nDecimal then
						sReturn = sTemp[0].."."..sTemp[1]
						for i = 0 to (nDecimal-tempLen)-1
							sReturn = sReturn.."0"
						next
					end if
				else
					sReturn = sReturn.."."
					for i = 0 to (nDecimal)-1
						sReturn = sReturn.."0"
					next
				end if
			end if			
		end if
	end if
	
	if sSign == "-" or sSign == "+" then
		sReturn = sSign..sReturn
	end if
	
	return sReturn
end Sub

'============================================================================
' Request_RealData : Real 요청
'============================================================================
Function Request_RealData(szMk)

	Select Case szMk
		' [[ 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권 ]]	
		Case "J", "Q"
			DATAMANAGER.RequestRealData("ohhts_stck_incg")		' 주식체결 자동갱신 20220103 HSZ
			
		' [[ KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드, KRX300 선물/선물 스프레드 ]]
		Case "F", "MF", "XF", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300 추가)	
			DATAMANAGER.RequestRealData("ohhts_futs_cntg")		' 선물 체결 자동갱신
		' [[ KOSPI지수 옵션, 미니코스피 옵션, 코스닥150 옵션, 위클리 옵션 ]]
		Case "O", "MO", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)		
			DATAMANAGER.RequestRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
		' [[ 업종코드	]]				
		Case "U"
			DATAMANAGER.RequestRealData("ohhts_nmix_cntg")		' 업종지수 체결 자동갱신
			
		'20180712 HAMWG START : K-OTC MTS 도입
		' [[ K-OTC(프리보드) ]]
		Case "T"
			DATAMANAGER.RequestRealData("ohhts_frbr_cntg")		' 프리보드체결 자동갱신
		'20180712 HAMWG END
		
		' [[ ELW ]]		
		Case "W"
			DATAMANAGER.RequestRealData("ohhts_elw_cntg")			' ELW체결 자동갱신
		' [[ 소액채권, 장내채권 ]]
		Case "B"
			DATAMANAGER.RequestRealData("ohhts_bond_cntg")		' 일반채권 체결 자동갱신
		' [[ 해외지수(대표지수, 업종지수) ]]
		Case "N"
			DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")		' 해외지수/종목 체결 자동갱신
		' [[ 해외지수(CME선물, 상품선물) ]]			
		Case "FN"
			DATAMANAGER.RequestRealData("ohhts_nfut_cntg")		' 해외선물 체결 자동갱신
		' [[ 세계환율 ]]				
		Case "EN"
			DATAMANAGER.RequestRealData("ohhts_exrt_cntg")		' 환율 체결 자동갱신
		' [[ 주식선물	]]	2018.01.02 CJH 추가		
		Case "JF"
			DATAMANAGER.RequestRealData("ohhts_sfut_cntg")		' 주식선물 체결		
		' [[ 주식옵션	]]	2018.01.02 CJH 추가		
		Case "JO"
			DATAMANAGER.RequestRealData("ohhts_sopt_cntg")		' 주식옵션 체결	
			
		'해외주식	
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
			DATAMANAGER.RequestRealData("ohhts_exst_ictg")		
 			
	End Select
End Function

'============================================================================
' 1 : Real 해제 
'============================================================================
Function Cancel_RealData()
	'전체 실시간 해제
	DATAMANAGER.CancelRealData("ohhts_stck_incg")		' 주식체결 자동갱신 20220103 HSZ
	DATAMANAGER.CancelRealData("ohhts_futs_cntg")		' 선물 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_optn_cntg")		' 옵션 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_nmix_cntg")		' 업종지수 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_frbr_cntg")		' 프리보드체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_elw_cntg")		' ELW체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_bond_cntg")		' 일반채권 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_ovrs_nmix")		' 해외지수/종목 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_nfut_cntg")		' 해외선물 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_exrt_cntg")		' 환율 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_sfut_cntg")		' 주식선물 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_sopt_cntg")		' 주식옵션 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_exst_ictg")		' 해외주식 체결 자동갱신			

End Function

'============================================================================
' Set_Real_Input : real_input 정의 (0현재, 1예상, 2단일)
'============================================================================
Function Set_Real_Input(szMk, nIdx, szCd)
	g_szRSelect = "0"
	
	Select Case szMk
		Case "J", "Q"				' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 주식체결 자동갱신
			end if
			
		Case "F", "MF"		' KOSPI200지수 선물/선물 스프레드, 코스닥150 선물, 미니코스피 선물/선물 스프레드
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 선물 체결 자동갱신
			end if 
			
		Case "O", "MO"		' KOSPI지수 옵션, 미니코스피 옵션
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 옵션 체결 자동갱신
			end if 
			
		Case "U"		' 업종코드
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", nIdx, szCd)	' 업종지수 체결 자동갱신
			end if 
		Case "T"		' K-OTC(프리보드)
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", nIdx, szCd)		' 프리보드체결 자동갱신
			end if 
		
		Case "W"		' ELW
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_elw_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' ELW체결 자동갱신
			end if 
			
		Case "N"	' 해외지수
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 해외지수/종목 체결 자동갱신
			end if 
		
		Case "B"	' 소액채권, 장내채권
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_bond_cntg", "InBlock1", "FIDR_STND_ISCD", nIdx, szCd)		' 일반채권 체결 자동갱신
			end if
			
		Case "EN"		' 세계환율
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg", "InBlock1", "FIDR_SYMB", nIdx, szCd)			' 환율 체결 자동갱신
			end if 			
		Case "JF"		
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_sfut_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식선물 체결 자동갱신
			end if 
		' [[ 주식옵션 ]]	 2018.01.02 CJH 추가
		Case "JO"		
			if g_szRSelect == "0" then
				DATAMANAGER.SetDataValue(1, "ohhts_sopt_cntg", "InBlock1", "FIDR_SHRN_ISCD", nIdx, szCd)		' 주식옵션 체결 자동갱신
			end if
	End Select
End Function


'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	imgGrp.setMaintainingRatio("1")
	imgNotice.setMaintainingRatio("1")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_szOsType = Form.GetSharedData("&OS_TYPE", false)
	if g_szOsType == "1" then
		FormTab0.setTabDefaultImage("tab_03_o.9","alpha.9")
	else
		FormTab0.setTabHeaderImage("tab_00_o.9","alpha", 0)
	end if
	
	g_szUserID =  Form.GetSharedData("&USER_ID", false)
	
	g_nCount = 0
	
	Dim nCurTab
	nCurTab = Form.GetSharedData( "MY_STOCK", true  )
	if nCurTab == "" then
		nCurTab = 0
	end if
	
	DIm szRecentTab, szHoldTab
	
	szRecentTab = Form.LoadConfigData("GW_SET2", "RECENT")
	szHoldTab = Form.LoadConfigData("GW_SET2", "HOLD")
	
	'0808 설정값 없을 때 예외처리 추가
	if szRecentTab == "1" or szRecentTab == "" then
		FormTab0.insertPage( FormTab0.tabcount, "page1", "page1", "empty", "0", "최근")
	end if
	if szHoldTab == "1" or szHoldTab == "" then
		FormTab0.insertPage( FormTab0.tabcount, "page2", "page2", "empty", "0", "보유")
	end if
	FormTab0.insertPage( FormTab0.tabcount, "page3", "page3", "empty", "0", "관심")
	
	if CInt(FormTab0.tabcount) - 1 < CInt(nCurTab) then
		nCurTab = 0
	end if
		
	FormTab0.currenttab = nCurTab
	
	if FormTab0.currenttabpageid <> "page3" then
		f_RequestItemData()
	else
		init_GWGroup()
	end if


End Sub

'============================================================================
' f_RequestItemData() : 버튼 타입에 따라 서비스 호출
'============================================================================
Function f_RequestItemData()
	Pannel0.rowcount = 0
	grdCode.rowcount = 0
	
	Cancel_RealData()
	
	if FormTab0.currenttabpageid == "page1" then		' 최근조회 종목
		szRecent = Form.GetRecentHistory("99") '국내+해외		
		Load_RecentList(szRecent)
		
	elseif FormTab0.currenttabpageid == "page2" then		' 보유종목
		g_nNextCount = 0
		DATAMANAGER.RequestTranData("obsim_stsv_047r") '국내보유종목 모두 조회후 해외보유종목 조회(obsim_stsv_048r)
	
	elseif FormTab0.currenttabpageid == "page3" then
		' 관심그룹의 종목을 재설정
		init_GWList()		
	end if
	
End Function

'============================================================================
' Load_RecentList :  최근조회종목 리스트
'============================================================================
Function Load_RecentList(szData)
	Dim tList
	Dim szMk, szName, szCode
	Dim szGubun '01:국내, 02:해외
	
	'국내: 종목코드, 해외: 마켓@종목코드 구분자 : `
	grdCode.rowcount = 0
	if Trim(szData) <> "" then
		tList = Split(szData, "`")		
		
		'최근조회종목 100개로 제한
		
		if #tList >= 100 then
			szLen = 100
		else
			szLen = #tList - 1 		
		end if

		nRowcount = 0
		for i = 0 to szLen
			szCode 	= tList(i)
			szMk 	= Form.GetItemCodeInfo(tList(i), "market")
			szMk 	= Change_EtcMarket(szMk)
			
			if trim(szMk) <> "" then
				Dim  nMkLen, tCode
					
				if CInt(Instr(szCode, "@")) > 0 then	'@ 포함된 종목코드(해외주식, 해외지수 등)
					tCode = Split(szCode, "@")
					szMk  = tCode[0]
					
					if Trim(szMk) <> "" then
						nMkLen = Form.getLen(szMk)
						if nMkLen == 2 then
							szGubun = "OV" '해외주식(마켓구분 2자리)
						else
							szGubun = "KR"
						end if
					end if
				else
					szGubun = "KR"
				end if 
				
				szName 	= Form.GetItemCodeInfo(tList(i), "name")
				'----------------------------------------------------------------------------------------------------
				
				If szGubun <> "KR" Then '해외
	'				tCode = Split(tList(i), "@")
					szMk = f_getExchCode2(szMk)
					szCode  = tCode[1]
				else ' 국내
					szMk = Form.GetItemCodeInfo(tList(i), "market")
					szMk = Change_EtcMarket(szMk)
					szCode = tList(i)
				end if 
				
				'최근조회종목 - 상품선물 안보이게
				'상품선물 "FF"분기처리 추가
				if szMk == "CF" or szMk == "FF" then
	
				else
					grdCode.insertrow = nRowcount
					grdCode.SetCellData("bd_code", nRowcount, szCode)
					grdCode.SetCellData("bd_mk",   nRowcount, szMk)
					grdCode.SetCellData("bd_memo", nRowcount, "")
					grdCode.SetCellData("bd_name", nRowcount, szName)
					grdCode.SetCellData("bd_gubun", nRowcount, szGubun) 
					nRowcount = nRowcount + 1
				end if
			end if
		Next
		
		if CInt(grdCode.rowcount) > 5 then
			grdCode.rowcount = 5
		end if

		Save_grdMk()		
	else
		
		Pannel0.visible = false
		imgNotice.visible = true
		lbNoticeMsg.visible = true
		lbNoticeMsg.caption = "최근 조회 종목이 없어요."
	end if
	
	if CInt(grdCode.rowcount) = 0 then
		Pannel0.visible = false
		imgNotice.visible = true
		lbNoticeMsg.visible = true
		lbNoticeMsg.caption = "최근 조회 종목이 없어요."
	end if
	
End Function

'============================================================================
' 관심그룹 재설정 (로컬/서버)
'============================================================================
Function init_GWGroup()
	grdGroup.rowcount = 0
	DATAMANAGER.RequestTranData("ohhts_intr_006r")
End Function

'============================================================================
' 관심그룹을 그룹콤보에 넣기
'============================================================================
Function Insert_cmbGroup()
	Dim szgrpList, szKey, szNm, szSave
	Dim nRow, nIdx, nSelect

	' 콤보 리스트 클리어
	Form.SetCtlProp("cmbGroup", "clear", "")
	
	nRow 		= grdGroup.rowcount
	nIdx 		= -1
	nSelect 		= -1
	szgrpList	= ""
	
	' 최종 선택(저장)된 관심그룹 키
	szSave = Form.GetEnvData("SELECT_GWGROUP")
	if szSave == "" or szSave == null then
		szSave = "000"
	end if
	
	' ---- 관심종목 그룹 리스트 존재시 Start --------------------------------
	if Int(nRow) > 0 then
		g_szAppFirst = "NO"
		
		For i = 0 to nRow -1
			szKey = grdGroup.GetCellData("bd_code", i)
			szNm  = grdGroup.GetCellData("bd_name", i)

			if szgrpList == "" then
				szgrpList = szKey & "`" & szNm
			else
				szgrpList = szgrpList & "\r\n" & szKey & "`" & szNm
			end if
			
			if nIdx >= 0 then
				nIdx = nIdx + 1
			else
				nIdx = 0
			end if
			
			if szSave == szKey then
				nSelect = nIdx
			end if
			
			' 선택된 그룹을 삭제하였을경우의 예외처리
			if i == nRow -1 then
				if nSelect < 0 then
					nSelect = 0
				end if
			end if
		Next
	else
		g_szAppFirst = "YES"
	end if
	' ---- 관심종목 그룹 리스트 존재시 End ----------------------------------
	' 관심그룹콤보에 리스트 init		
	cmbGroup.cbinputdatatext = szgrpList

	' 관심그룹콤보에서 최종 저장된 그룹 선택
	If CStr(nSelect) == "-1" or szSave == "CC" or szSave == "BB" Then	'없거나 보유종목인 경우
		nSelect = 0	'MY관심종목 뉴스에서는 첫 관심그룹으로 세팅 - 2302 HSZ 업혁 박효정 과장님 요건
	End If
	
	if cmbGroup.caption <> "" then
		cmbGroup.currentindex = CStr(nSelect)	
	end if

End Function

'============================================================================
' init_GWList :  관심그룹의 종목 재설정 (로컬/서버)
'============================================================================
Function init_GWList()
	DATAMANAGER.RequestTranData("ohhts_intr_007r")

End Function

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'국내 보유종목 리스트
	if szTranID == "obsim_stsv_047r" then
		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
	
		if nCnt > 0 then				
			'nRow = 0
			nRow = g_nNextCount
			if g_nNextCount == 0 then
				grdCode.SetClear()
			end if 				
			For i = 0 to nCnt -1 
			
				szCd = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ISCD", i)
				grdCode.insertrow = nRow

				'20160729 NOHES START ETN, 채권 마켓타입에 따른 처리 추가
				szMk = Form.GetItemCodeInfo(szCd, "market")
				szMk = Change_EtcMarket(szMk)
				select Case szMk
				Case "Q", "BN", "B"
				
				'20210608 SWJ START : 신주인수권 보유종목 조회 오류현상 수정
				Case "J"
					szCutCd = szCd
				'20210608 SWJ END
				
				Case Else
					szCutCd = Mid(szCd, 2, Len(szCd))
					szMk = Form.GetItemCodeInfo(szCutCd, "market")
				End Select
				'20160729 NOHES END
				
				' 보유종목리스트에서 주식종목은 종목코드 맨 앞에 "A", ELW는 "J"가 붙어서 내려옴. 예외처리 ////
				' 보유종목리스트에서 선옵종목은 종목코드 맨 앞에 "K"가 붙어서 내려옴. 예외처리 20160402
				' ETN (mk) = Q, 채권(mk) = BN(소액), MM(장내)
		
				Select Case szMk
					Case "J", "T", "W", "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO", "KF"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)
						grdCode.SetCellData("bd_code", nRow, szCutCd)
						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCutCd, "name"))	' 20160325 위젯위해 종목명 추가
					'20160729 NOHES START ETN, 채권 마켓타입에 따른 처리 추가
					Case "Q", "BN", "B"
						grdCode.SetCellData("bd_code", nRow, szCd)
						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))
					Case "" 										'코드가 유효하지 않은 경우, 2자리 자르지 않은 전체 종목코드로 보여줌.
						grdCode.SetCellData("bd_code", nRow, szCd)
						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))						
					'20160729 NOHES END
					Case Else
						if Left(szCd, 1, 1) == "A" or Left(szCd, 1, 1) == "K" then
							grdCode.SetCellData("bd_code", nRow, szCutCd)
							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCutCd, "name"))	' 20160325 위젯위해 종목명 추가
						else
							grdCode.SetCellData("bd_code", nRow, szCd)
							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))	' 20160325 위젯위해 종목명 추가
						end if
				End Select
				' ////////////////////////////////////////////////////////////////////////////////////////////

				grdCode.SetCellData("bd_mk",   nRow, szMk)
				grdCode.SetCellData("bd_gubun",   nRow, "KR") '국내
				
				nRow = nRow + 1
			Next
		end if
		
	     g_nNextCount = CInt(grdCode.rowcount)

	     if g_nNextCount < 6 then	'5개 미만이면 해외보유도 호출
			DATAMANAGER.RequestTranData( "obsim_stsv_048r" )
		else	
			grdCode.rowcount = 5
			g_nNextCount = 5
			Save_grdMk()
		end if

	'해외 보유종목 리스트		
	elseif szTranID == "obsim_stsv_048r" then
		nCnt = CInt(DATAMANAGER.GetDataCount(0, "obsim_stsv_048r", "OutBlock1"))
		if nCnt > 0 then
			nRow = g_nNextCount
			if g_nNextCount == 0  then	'체크필요
				grdCode.SetClear()
			end if
			
			For i = 0 to nCnt -1 
				szCd = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "ISCD", i)
				szName = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "KOR_NAME", i)
				grdCode.insertrow = nRow
				
				if Trim(szCd) <> "" then
					tCode = Split(szCd, ".")
					szCutCd = tCode[0]
					szMk = tCode[1]
					
					'20220811 SWJ START : "."이 종목코드에 들어간 종목 화면 파싱 오류
					if instr(szCd,".") <> instrRev(szCd,".") then
						szMk 	= Right(szCd,len(szCd) - instrRev(szCd,"."))			
						szCutCd  = Replace(szCd,"." & szMk,"")
					end if
					'20220811 SWJ END
				end if
				
				grdCode.SetCellData("bd_code", nRow, szCutCd )
				grdCode.SetCellData("bd_mk",   nRow, szMk)
				grdCode.SetCellData("bd_gubun",   nRow, "OV") '해외
				
				nRow = nRow + 1
			Next				
		end if
		
		ngrdCnt = CInt(grdCode.rowcount)
	     if CInt(grdCode.rowcount) > 5 then
			grdCode.rowcount = 5
			g_nNextCount = 5
		end if
		
		Save_grdMk()
		
	' ----------------------------------------------------------------------
	' 관심그룹 목록 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_006r" then
		If CInt(DATAMANAGER.GetDataCount(0, "ohhts_intr_006r" , "OutBlock1")) < 1 Then	
			imgGrp.visible = false
			lblGroupNm.visible = false
			Pannel0.visible = false
			imgNotice.visible = true
			lbNoticeMsg.visible = true
			lbNoticeMsg.caption = "등록된 관심그룹이 없어요."
		else
			imgGrp.visible = true
			lblGroupNm.visible = true
		end if
	'------------------------------------------------------------------------------------------
		Call Insert_cmbGroup()		' 관심그룹을 그룹콤보에 넣기
		
		g_szAppFirst = "YES"
		
	' ----------------------------------------------------------------------
	' 관심종목 종목
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		dim nRow
		nRow = Cint(DATAMANAGER.GetDataCount( 0, "ohhts_intr_007r", "OutBlock1"))
		grdCode.rowcount = nRow
		Pannel0.rowcount = 0

		for i = nRow - 1 to  0 step -1
		
			dim szCode, szMk, szName, tCode, nMkLen, szGubun
			'0804 JJH grdCode에 스크립트로 데이터 삽입
		'----------------------------------------------------------------------------------------------------
			szMk = DATAMANAGER.GetDataValue( 0, "ohhts_intr_007r", "OutBlock1", "FID_INPUT_MRKT_CLS_CODE" , i )
			szCode = DATAMANAGER.GetDataValue( 0, "ohhts_intr_007r", "OutBlock1", "FID_OVDV_ISCD" , i )
			szMemo = DATAMANAGER.GetDataValue( 0, "ohhts_intr_007r", "OutBlock1", "FID_MEMO_CNTT" , i )
		'----------------------------------------------------------------------------------------------------
			szMk 	= Change_EtcMarket(szMk)			
			szName	= Form.GetItemCodeInfo(szCode, "name")
			
			if Trim(szName) == "" then
				szName = Form.GetItemCodeInfo(szMk & "@" & szCode, "name")
			end if
			
			if Form.GetItemCodeInfo(szMk & "@" & szCode, "market") == "OV" then
				szGubun = "OV"
			else
				szGubun = "KR"
			end if
			
			grdCode.SetCellData("bd_code", 	i, szCode)
			grdCode.SetCellData("bd_mk", 	i, szMk)
			grdCode.SetCellData("bd_name", 	i, szName)
			grdCode.SetCellData("bd_gubun", i, szGubun) 
			'JJH 0809 공백제거 추가
			if szCode == "EMPTY" or szCode == "" or szName == "" then
				grdCode.SetDeleteRow(i)
			end if
		next
		
		Call Save_grdMk()
	' ----------------------------------------------------------------------
	' 관심종목 종목데이터 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_1020_004r" then '국내
		
		g_nCount = 0
		
		dim nCount, nDataCnt
		nCount = grdCode.rowcount
		Pannel0.rowcount = nCount
		nDataCnt = CInt(DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1"))

		for i = 0 to CInt(nCount) - 1
			if CInt(nCount) > 0 then
				
				szCd = grdCode.GetCellData("bd_code", i)
				szMk = grdCode.GetCellData("bd_mk", i)
				korname = grdCode.GetCellData("bd_name", i)			
				szbdGubun = grdCode.GetCellData("bd_gubun", i)
			
				if szbdGubun == "KR" then '국내인 경우
					For j = 0 to nDataCnt - 1	
						dim nGridRow, code
						nGridRow = i
						code = DATAMANAGER.GetDataValue( 0, "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ISCD" , j )  '종목코드
						
						if code == szCd and Trim(code) <> ""  then	'20230518 HSZ : 빈값체크로직 추가
							
							sclose	= DATAMANAGER.GetDataValue( 0,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRPR", j ) '현재가							
							diff		= DATAMANAGER.GetDataValue( 0,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRDY_VRSS" , j ) '대비
							sign		= DATAMANAGER.GetDataValue( 0,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRDY_VRSS_SIGN", j ) '대비부호
							rate		= DATAMANAGER.GetDataValue( 0,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_PRDY_CTRT", j ) '대비율
							isnm		= DATAMANAGER.GetDataValue( 0,  "ohhts_1020_004r", "OutBlock1", "FID_CNCN_ISNM", j ) '종목명

							Pannel0.setPropCardCell("maxlinecnt", "lblName", i, "2^-1")
							Pannel0.setPropCardCell("caption","lblName",i, korname)
							
							Pannel0.setPropCardCell("attributeenable","lblPr",i,"0")	'현재가 색상 세팅 방지
							Pannel0.setPropCardCell("caption","lblPr",i, sclose)
							
							Pannel0.setPropCardCell("caption","lblCode",i, szCd)
							Pannel0.SetCellValue("lblCode",i,szCd)
							
							Pannel0.setPropCardCell("signpos","Change0", i, "1")	'등락기호 좌측세팅
							Pannel0.setPropCardCell("caption","Change0",i, diff)
							Pannel0.setPropCardCell("changesign","Change0",i, sign)
							Pannel0.setPropCardCell("caption","lblCtrt",i, rate)
							Pannel0.setPropCardCell("caption","lblSign",i, sign)
							Pannel0.SetCellValue("lblSign",i, sign)
							Pannel0.setPropCardCell("caption","lblMarket",i, szMk)
							
							g_nCount = g_nCount + 1
						end if 
					Next
				end if
			end if
		Next
		
		DATAMANAGER.RequestTranData( "ohhts_1030_002r" ) '해외
			
	elseif szTranID == "ohhts_1030_002r" then	'해외(주간시세)
		Dim tItemData, nIndex, sCellBong, szMk, szFlag
		Dim nRequestCount1, nRequestCount2 
		nRequestCount1 = 0
		nRequestCount2 = 0
		
		DATAMANAGER.CancelRealData("ohhts_exst_ictg")
		
		nCount = CInt( DATAMANAGER.GetDataCount(0,"ohhts_1030_002r", "OutBlock1" ) )

		For i = 0 to grdCode.rowcount - 1
			dim szCd, szMk, korname, szbdGubun
			
			szCd = grdCode.GetCellData("bd_code", i)
			szMk = grdCode.GetCellData("bd_mk", i)
			korname = grdCode.GetCellData("bd_name", i)			
			szbdGubun = grdCode.GetCellData("bd_gubun", i)

			if szbdGubun == "OV" then '해외인 경우 
			
				For j = 0 to nCount-1
				
					code = DATAMANAGER.GetDataValue( 0, "ohhts_1030_002r", "OutBlock1", "FIDX_ISCD" , j ) 
					nDtclose	= Cdbl(DATAMANAGER.GetDataValue( 0,  "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRPR", j ))	'20230109 HSZ
					
					if code == szCd and Trim(code) <> "" then	'20230518 HSZ : 빈값체크로직 추가
						symbol		= szMk
						korname		= DATAMANAGER.GetDataValue( 0, "ohhts_1030_002r", "OutBlock1", "FIDX_KOR_ISNM" , j )					
						sclose		= DATAMANAGER.GetDataValue( 0,  "ohhts_1030_002r", "OutBlock1", "FIDX_PRPR", j )
						diff			= DATAMANAGER.GetDataValue( 0, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_VRSS" , j )
						sign			= DATAMANAGER.GetDataValue( 0, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_VRSS_SIGN" , j )
						rate			= DATAMANAGER.GetDataValue( 0, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_CTRT" , j )
						sdecimal		= DATAMANAGER.GetDataValue( 0,  "ohhts_1030_002r", "OutBlock1", "FIDX_DCPN_CNT", j )

						Pannel0.setPropCardCell("maxlinecnt", "lblName", i, "2^-1")
						
						Pannel0.setPropCardCell("attributeenable","lblPr",i,"0")	'현재가 색상 세팅 방지
						Pannel0.setPropCardCell("caption","lblPr",i, Decimal_Setting( sclose , sdecimal ))
						Pannel0.setPropCardCell("caption","lblCode",i, szMk&"@"&szCd)
						Pannel0.SetCellValue("lblCode",i,szMk&"@"&szCd)
						Pannel0.setPropCardCell("caption","lblName",i, korname)
						
						Pannel0.setPropCardCell("signpos","Change0", i, "1")	'등락기호 좌측세팅
						Pannel0.setPropCardCell("caption","Change0",i, diff)
						Pannel0.setPropCardCell("changesign","Change0",i, sign)
						
						Pannel0.setPropCardCell("caption","lblCtrt",i, rate)
						
						Pannel0.setPropCardCell("caption","lblSign",i, sign)
						Pannel0.SetCellValue("lblSign",i, sign)
						
						Pannel0.setPropCardCell("caption","lblMarket",i, szMk)
						
						g_nCount = g_nCount + 1
						
						'해외 실시간 인블럭 세팅
						DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , nRequestCount2 , szMk&"@"&szCd)
						nRequestCount2 = nRequestCount2 + 1
						
					else
						' 오프라인 종목일경우 obsim_stsv_048r 에서 나온 현재가, 종목명 등을 사용
						if szOnline == "N" then
							Pannel0.setPropCardCell("caption","lblCode",g_nCount, szMk&"@"&szCd)
							Pannel0.SetCellValue("lblCode",g_nCount,szMk&"@"&szCd)
						end if
					end if
				Next
			end if 
		Next
		
		'최대 5 종목만 시세조회가 가능
		if g_nCount < 5 then
			Pannel0.rowcount = g_nCount
		else
			Pannel0.rowcount = 5
		end if 
		
		for i = 0 to CInt(Pannel0.rowcount) - 1
			'패딩 설정
			if g_szOsType == "1" then
				Pannel0.setPropCardCell("paddinginfo","Change0",i,"0,0,0,0")
				Pannel0.setPropCardCell("paddinginfo","lblPr",i,"0,0,3,0")
			else
				Pannel0.setPropCardCell("paddinginfo","lblPr",i,"0,0,4,0")
			end if
			
			szSign 	 = Pannel0.getPropCardCell("caption" ,"lblSign" ,i)
			szCode	 = Pannel0.getPropCardCell("caption" ,"lblCode" ,i)
			szMk		 = Pannel0.getPropCardCell("caption" ,"lblMarket" ,i)
			szbdGubun = grdCode.GetCellData("bd_gubun", i)

			if Trim(szCode) <> "" then
				'등락률 배경이미지 세팅
				f_SetimgBg(i, CInt(szSign))

				'종목CI 이미지 세팅
				f_SetimgCi(i, szMk, szCode, szbdGubun)
			end if
		next
		
		if Cint(Pannel0.rowcount) == 0 then
			imgNotice.visible = true
			lbNoticeMsg.visible = true
			if FormTab0.currenttabpageid == "page2" then
				lbNoticeMsg.caption = "보유한 종목이 없어요."
			elseif FormTab0.currenttabpageid == "page3" then
				lbNoticeMsg.caption = "등록된 종목이 없어요."	
			elseif FormTab0.currenttabpageid == "page3" then
				lbNoticeMsg.caption = "최근 조회 종목이 없어요."
			end if
		else
			imgNotice.visible = false
			lbNoticeMsg.visible = false
		end if
		
		' 실시간을 위한 작업 ////////////////////////////////////////////// 
		'전체, 해외
		For j = 0 to grdMk.rowcount - 1
			szCd = grdMk.GetCellData("bd_code", j)
			szMk = grdMk.GetCellData("bd_mk", j)
			
			if szCd <> "" and szMk <> "" then
				tCode = Split(szCd, "★")
				
				For k = 0 to #tCode-1
					' MTS에서 보여주는 상품의 종목만 선택
					szMk = f_ChkMarket(szMk, tCode(k))

					if szMk <> "" then
						'국내
						Set_Real_Input(szMk, k, tCode(k))
					end if
				Next
				
				Request_RealData(szMk)
			end if
		Next
	end if
	
End Sub
'============================================================================
'	(조회) 글자 색상 및 등락률 이미지 세팅
'============================================================================
Function f_SetimgBg(i, nVrssSign)
	Select Case nVrssSign
		Case 1, 2
			Pannel0.setPropCardCell("fgcolor","lblCtrt",i,"10")
						
			Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1")	'동일 이미지 중복세팅 방지
			Pannel0.setPropCardCell("imgpath", "imgBg", i, "roundbox_4r_pink.9.png")
		Case 4, 5
			Pannel0.setPropCardCell("fgcolor","lblCtrt",i,"11")
						
			Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1")	'동일 이미지 중복세팅 방지
			Pannel0.setPropCardCell("imgpath", "imgBg", i, "roundbox_4r_blue.9.png")
		Case Else
			Pannel0.setPropCardCell("fgcolor","lblCtrt",i,"12")
						
			Pannel0.setPropCardCell("imgduplicate", "imgBg", i, "1")	'동일 이미지 중복세팅 방지
			Pannel0.setPropCardCell("imgpath", "imgBg", i, "roundbox_4r_gray.9.png")
		End Select
End Function
'============================================================================
'	(조회) 종목 Ci 이미지 세팅
'============================================================================
Function f_SetimgCi(i, szMk, szCode, szbdGubun)
	sGroupID = ""
	sNation = ""
	szImgNm = ""
	
	if szbdGubun == "KR" then
		sGroupID = "CI_KOR"
		
		szImgNm = Form.getIconImg(sGroupID, szCode) '종목 로고
		
		if szImgNm == "" then
		
			szMrk = Form.getItemCodeInfo(szCode, "market")
			'EN	: 환율		MARKET_TYPE_OVERSEA_EXRATE
			'UJ	: 해외지수	MARKET_TYPE_OVERSEA_INDEX
			'FN	: 해외선물	MARKET_TYPE_OVERSEA_FUTURE
			if szMrk == "EN" or szMrk == "UJ" or szMrk == "FN" then
				szImgNm = "flag_general"
			else
				szImgNm = "flag_kor_round"
			end if
		end if		
		
	else
		'해외종목
		sGroupID = ""
		szImgNm = ""
		
		if Instr(szCode, "@") > 0 then
			'여기는 안타지만 로직음 혹시몰라 둠
			szData = Split(szCode, "@")
			szMk = szData(0)
			szCode = szData(1)
		end if
		
		if szMk = "AX" or szMk = "NY" or szMk = "OQ" then
			sGroupID = "CI_USD"
		elseif szMk = "JP" then
			sGroupID = "CI_JPN"
		elseif szMk = "SH" or szMk = "SZ" then
			sGroupID = "CI_CHN"
		elseif szMk = "HK" then
			sGroupID = "CI_HKG"
		else
			sGroupID = "CI_KOR"
		end if
	
		szImgNm = Form.getIconImg(sGroupID, szCode)		'종목 로고
		
		if szImgNm == "" then
			szImgNm = Form.getIconImg("MK_FLAG", szMk)	'거래소코드 -> 국가이미지명
			
			if szImgNm == "" then
				szImgNm = "flag_general"
			end if
		end if		
	end if

	Pannel0.setPropCardCell("maintainratio","imgCi",i,"1")
	Pannel0.setPropCardCell("imgpath","imgCi",i,szImgNm)
End Function

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 보유종목 조회(국내/국내CFD, 해외/해외CFD)
	' ----------------------------------------------------------------------	
	if szTranID == "obsim_stsv_047r" or szTranID == "obsim_stsv_048r" then
	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID", 0, g_szUserID)
	' ----------------------------------------------------------------------
	' 관심그룹 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_006r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_USER_ID", 0, g_szUserID)

	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		grdCode.rowcount = 0
		grdCode.SetClear()
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_USER_ID", 0, g_szUserID)	' USER ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_CNCN_ISSU_NEW_GRP_ID", 0, g_szGSID)		
	' ----------------------------------------------------------------------
	' 관심종목 데이터조회		
	' 국내 시세 TR
	' ----------------------------------------------------------------------
	elseif szTranID ==  "ohhts_1020_004r" then
		DATAMANAGER.ClearInputData( false, "ohhts_1020_004r" )
		Pannel0.rowcount = 0
		
		j = 0

		For i = 0 to grdCode.rowcount-1
			if grdCode.GetCellData("bd_gubun", i) == "KR" then '국내인 경우 
				szMk = grdCode.GetCellData("bd_mk", i)
			
				szCd = Trim(grdCode.GetCellData("bd_code", i))
				
				' MTS에서 보여주는 상품의 종목만 선택
				szMk = f_ChkMarket(szMk, szCd)
				
				DATAMANAGER.SetDataValue(0, "ohhts_1020_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", j, szMk)
				DATAMANAGER.SetDataValue(0, "ohhts_1020_004r", "InBlock1", "FID_INPUT_ISCD",               j, szCd)
				j = j + 1
			end if 
		Next
	' ----------------------------------------------------------------------
	' 관심종목 데이터조회		
	' 해외 시세 TR
	' ----------------------------------------------------------------------
	elseif szTranID ==  "ohhts_1030_002r" then	
		DATAMANAGER.ClearInputData( false, "ohhts_1030_002r" )
		
		j = 0
		For i = 0 to grdCode.rowcount-1
		
		    if grdCode.GetCellData("bd_gubun", i) == "OV" then '해외인 경우 
				szMk = grdCode.GetCellData("bd_mk", i)
				szCd = Trim(grdCode.GetCellData("bd_code", i))
				tCode = {}
				
				' MTS에서 보여주는 상품의 종목만 선택
				szMk = f_ChkMarket(szMk, szCd)
				
				DATAMANAGER.SetDataValue( 0, "ohhts_1030_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", j , "OV" ) '해외주식			
				DATAMANAGER.SetDataValue( 0, "ohhts_1030_002r", "InBlock1", "FID_INPUT_OVRS_ISCD", j , szCd ) ' 종목코드
				DATAMANAGER.SetDataValue( 0, "ohhts_1030_002r", "InBlock1", "FID_COND_MRKT_CLS_CODE", j , szMk ) '종목시장
				' 시장별 실시간여부값
				szRealAble = Form.GetSharedData( "REALTIME_"&szMk, false )
				DATAMANAGER.SetDataValue( 0, "ohhts_1030_002r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE", j, szRealAble ) '실시간여부
				j = j + 1
			end if 
		Next
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
End Sub

'============================================================================
Sub Form_OnRefresh()
	nTab = FormTab0.currenttab
	call FormTab0_OnTabChanged(nTab)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	'판넬은 조회서비스 매핑 안해놓으면 실시간서비스 매핑해도 데이터 못가져옴
	'데이터 다 스크립트로 처리
	
	nRow = -1
	
	'-------------------------------------------------------------------------
	'실시간 서비스별 필드명
	'-------------------------------------------------------------------------
	' 등락기호
	if szTranID = "ohhts_stck_incg" then
		szSignField = "RLTM_PRDY_VRSS_SIGN"
	
	elseif szTranID = "ohhts_exst_ictg" or szTranID = "ohhts_exst_cntd" then
		szSignField = "FIDXR_VRSS_SIGN"
		
	else
		szSignField = "FIDR_PRDY_VRSS_SIGN"
	end if
	
	' 등락
	if szTranID = "ohhts_stck_incg" then
		szVrssField = "RLTM_PRDY_VRSS"
		
	elseif szTranID = "ohhts_exrt_cntg" then
		szVrssField = "FIDR_EXRT_PRDY_VRSS"
		
	elseif szTranID = "ohhts_exst_ictg" or szTranID = "ohhts_exst_cntd" then
		szVrssField = "FIDXR_PRDY_VRSS"
		
	elseif szTranID = "ohhts_frbr_cntg" or szTranID = "ohhts_elw_cntg" or szTranID = "ohhts_sfut_cntg" or szTranID = "ohhts_sopt_cntg" then
		szVrssField = "FIDR_PRDY_VRSS"
		
	else
		szVrssField = "FIDR_PRDY_VRSS2"
	end if
	
	'종목코드
	if szTranID = "ohhts_stck_incg" then
		szCodeField = "RLTM_SHRN_ISCD"
		
	elseif szTranID = "ohhts_bond_cntg" then
		szCodeField = "FIDR_STND_ISCD"
		
	elseif szTranID = "ohhts_exst_ictg" or szTranID = "ohhts_exst_cntd" then
		szCodeField = "FIDXR_ISCD"
		
	elseif szTranID = "ohhts_nmix_cntg" then
		szCodeField = "FIDR_BSTP_CLS_CODE"
		
	elseif szTranID = "ohhts_ovrs_nmix" or szTranID = "ohhts_nfut_cntg" or szTranID = "ohhts_exrt_cntg" then
		szCodeField = "FIDR_SYMB"
		
	else
		szCodeField = "FIDR_SHRN_ISCD"
	end if
	
	'현재가
	if szTranID = "ohhts_stck_incg" then
		szPrField = "RLTM_PRPR"
		
	elseif szTranID = "ohhts_frbr_cntg" or szTranID = "ohhts_elw_cntg" or szTranID = "ohhts_sfut_cntg" or szTranID = "ohhts_sopt_cntg" then
		szPrField = "FIDR_PRPR"
		
	elseif szTranID = "ohhts_exrt_cntg" then
		szPrField = "FIDR_EXRT_PRPR"
		
	elseif szTranID = "ohhts_exst_ictg" or szTranID = "ohhts_exst_cntd" then
		szPrField = "FIDXR_PRPR"
		
	else
		szPrField = "FIDR_PRPR2"
	end if
	
	'등락률
	if szTranID = "ohhts_stck_incg" then
		szCtrtField = "RLTM_PRDY_CTRT"
		
	elseif szTranID = "ohhts_exst_ictg" or szTranID = "ohhts_exst_cntd" then
		szCtrtField = "FIDXR_RSFL_RT"
		
	else
		szCtrtField = "FIDR_PRDY_CTRT"
	end if
	
	'-------------------------------------------------------------------------
	' 데이터 세팅
	'-------------------------------------------------------------------------
	nRow = -1
		
	szCode = DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", szCodeField , 0)
	nRow = Pannel0.FindRow("lblCode",szCode,0)
	
	if CInt(nRow) >= 0 then
		'등락 컨트롤 값 세팅
		diff			= DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", szVrssField, 0 )
		sign			= DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", szSignField, 0 )

		Pannel0.setPropCardCell("caption","Change0",nRow,diff)
		Pannel0.setPropCardCell("changesign","Change0",nRow,sign)
		
		'현재가 세팅
		szPr			= DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", szPrField, 0 )
		
		Pannel0.setPropCardCell("caption","lblPr",nRow,szPr)
		
		'등락률 세팅
		szCtrt			= DATAMANAGER.GetDataValue( 1, szTranID, "OutBlock1", szCtrtField, 0 )
		
		Pannel0.setPropCardCell("caption","lblCtrt",nRow,szCtrt)
		
		'등락률 이미지 세팅
		nSign = CInt(sign)
		if nSign = 1 or nSign = 2 then
			Pannel0.setPropCardCell("fgcolor","lblCtrt",nRow, "10")
			Pannel0.setPropCardCell("imgpath", "imgBg", nRow, "roundbox_4r_pink.9.png")
		elseif nSign = 4 or nSign = 5 then
			Pannel0.setPropCardCell("fgcolor","lblCtrt",nRow, "11")
			Pannel0.setPropCardCell("imgpath", "imgBg", nRow, "roundbox_4r_blue.9.png")
		else
			Pannel0.setPropCardCell("fgcolor","lblCtrt",nRow, "12")
			Pannel0.setPropCardCell("imgpath", "imgBg", nRow, "roundbox_4r_gray.9.png")
		end if
	end if

End Sub

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	dim szCode, szMk, szNm
	szCode = Pannel0.getPropCardCell("caption", "lblCode",nIndex)
	szMk = Pannel0.getPropCardCell("caption", "lblMarket",nIndex)
	szNm = Pannel0.getPropCardCell("caption", "lblName",nIndex)
	
'	showalert szCode..szMk..szNm
	f_OpenScreen(szCode, szMk, szNm)
End Sub

'============================================================================
' f_OpenScreen(szCode) : 현재가 이동 함수
'============================================================================
Function f_OpenScreen(szCode, szMk, szKorname)
	if szCode = "" or szCode = null then
		Form.ShowAlert("안내", "종목 정보가 없습니다.")
		exit Function 
	end if
	
	Form.SetSharedData("HOME_MYSTOCKMYNEWS" , "0")
	Form.SetSharedData( "MY_STOCK" , FormTab0.currenttab)
	
	Select Case szMk
		Case "J", "Q", "T", "W"		' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
			Form.OpenScreen("11000", szCode)
		Case "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO", "KF"	' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	' 20240412 HSZ : 코스닥글로벌지수 추가	
			Form.OpenScreen("31000", szCode)
		Case "U"						' 업종코드
			Form.OpenScreen("42000", "2" & "★" & szCode )	'20230922 HSZ: 업종현재가 이동
		Case "N", "EN", "FN"			' 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
'			szData = nYPos & "★" & nheight & "★" & "3" & "★" & g_szSltMk & "★해외지수★해외차트★★★"
'			
'			Screen_No(szData, "42040", "", "42050")

			Form.OpenScreen("42040", szCode)
		Case "B"						' 소액채권, 장내채권
			Form.OpenScreen("54010", "관심종목★" & szCode & "★" )
'		Case "U", "N", "EN", "FN"		' 업종코드(U) 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
'			LblGuide.visible = true
			
'		'해외주식	
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"	
			Form.SetSharedData( "&ITEM_CODE" , szCode )
			Form.SetSharedData( "&ITEM_KORNAME" , szKorname )
			Form.SetSharedData( "&ITEM_OVERSTOCK", szCode.."★"..szKorname.."★".."", "" )	
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szCode.."★"..szKorname.."★".."", "" )
			Form.OpenScreen("16000", "")
	End Select

End Function

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	grdCode.rowcount = 0
	
	Pannel0.visible = true
	imgNotice.visible = false
	lbNoticeMsg.visible = false
	
	if FormTab0.currenttabpageid <> "page3" then
		imgGrp.visible = false
		lblGroupNm.visible = false
		
	else
		'0807 JJH "ohhts_intr_006r" 서비스 시작위치 변경
		'------------------------------------------------------------------------------------------
		if cmbGroup.caption == "" or cmbGroup.caption == null then 
			if g_szAppFirst == "NO" then
				Call init_GWGroup()
			else
				imgGrp.visible = false
				lblGroupNm.visible = false
				Pannel0.visible = false
				imgNotice.visible = true
				lbNoticeMsg.visible = true
				lbNoticeMsg.caption = "등록된 관심그룹이 없어요."
			end if
			Exit Sub
		'------------------------------------------------------------------------------------------
		else
			imgGrp.visible = true
			lblGroupNm.visible = true
		end if
	end if
	
	if FormTab0.currenttabpageid == "page1" then
		Form.SetEnvData("1", "SELECT_GWGROUP" , "BB")
	elseif FormTab0.currenttabpageid == "page2" then
		Form.SetEnvData("1", "SELECT_GWGROUP" , "CC")
	end if
	
	Call f_RequestItemData()
End Sub

'============================================================================
' 관심그룹
'============================================================================
Sub cmbGroup_OnEditComplete(iIndex)
	lblGroupNm.caption = cmbGroup.caption
	lblGroupNm.setmaxlinecount(2)
	g_szGSID = cmbGroup.cbkeydata
	
	if FormTab0.currenttabpageid == "page3" then
		' 선택되어 있는 그룹의 키를 저장한다. 화면 다시 오픈시 적용
		Form.SetEnvData("1", "SELECT_GWGROUP" , cmbGroup.cbkeydata)
		init_GWList()
	end if
End Sub

'============================================================================
Sub lblGroupNm_OnClick()
	'종목편집 창에서 Env가 바뀌는 것때문에 현재 선택 그룹키 값을 저장
	Form.SetSharedData("PresentSelectKey", cmbGroup.cbkeydata)
	
	cmbGroup.openlist()
End Sub


'============================================================================
Sub Form_OnFormClose()
	Cancel_RealData()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "LOGIN" then
		if Trim(sParam) = "" then
			exit sub
		end if
		g_szUserID = sParam
		
		if FormTab0.currenttabpageid <> "page3" then
			f_RequestItemData()
		else
			grdCode.rowcount = 0
			init_GWGroup()
		end if
		
	elseif sEventName == "MOVE_MORE_SCREEN" then	'껍데기화면 더보기 클릭
		Form.SetSharedData( "MY_STOCK" , FormTab0.currenttab)

		if FormTab0.currenttabpageid == "page1" then
			szLink = "BB"
		elseif FormTab0.currenttabpageid == "page2" then
			szLink = "CC"
		elseif FormTab0.currenttabpageid == "page3" then
			szLink = cmbGroup.cbkeydata
		end if
		Form.OpenScreen("11010" , "HOME★" & szLink)

	elseif sEventName = "SWIPE" then			'스와이프 탭변경
		if sParam = "NEXT" then
			btnNext()
		elseif sParam = "PREV" then
			btnPrev()
		end if
		
	end if
	
End Sub

'스와이프 기능 추가
'============================================================================
Function btnPrev()
	Dim nTab
	
	nCurTab = CInt(FormTab0.currenttab)
	if nCurTab == 0 then
		nTab = 0		
	else
		nTab = nCurTab - 1		
	end if
	
	FormTab0.currenttab = nTab
	call FormTab0_OnTabChanged(nTab)
	
End Function

'============================================================================
Function btnNext()
	Dim nTab
	
	nCurTab = CInt(FormTab0.currenttab)
	nTabCnt = CInt(FormTab0.tabcount)
	
	if nCurTab == nTabCnt then
		nTab = nTabCnt		
	else
		nTab = nCurTab + 1		
	end if
	
	FormTab0.currenttab = nTab
	call FormTab0_OnTabChanged(nTab)
	
End Function

