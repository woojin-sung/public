Sub f_AllCheck0()
	if bAllCheck0() then
		contStep3.imgAllAgree0.imgpath = "btn_15_n.9.png"
		contStep3.lblConfirm0.fgcolor = "062:255255255"
		contStep3.contSub.visible = true
		contStep3.SetScrollAutoSize()
		contStep3.scroll_pos = g_nContSubTop
		
		if bAllCheck1() then
			btnNext.enable = true
		else
			btnNext.enable = false
		end if
	else
		contStep3.imgAllAgree0.imgpath = "input_01_n.9.png"
		contStep3.lblConfirm0.fgcolor = "004:000000000"
		btnNext.enable = false
	end if
End Sub

Function bAllCheck0()
	if contStep3.chkSub00.checkstate == "0" then
		bAllCheck0 = false
		Exit Function
	end if
	
	if contStep3.chkSub01.checkstate == "0" then
		bAllCheck0 = false
		Exit Function
	end if
	
	if contStep3.chkSub02.checkstate == "0" then
		bAllCheck0 = false
		Exit Function
	end if
	
	if contStep3.chkSub03.visible == true or contStep3.chkSub03.visible == "1" then
		if contStep3.chkSub03.checkstate == "0" then
			bAllCheck0 = false
			Exit Function
		end if
	end if
	
	if contStep3.chkSub04.visible == true or contStep3.chkSub04.visible == "1" then
		if contStep3.chkSub04.checkstate == "0" then
			bAllCheck0 = false
			Exit Function
		end if
	end if
	
	if contStep3.chkSub10.visible == true or contStep3.chkSub10.visible == "1" then
		if contStep3.chkSub10.checkstate == "0" then
			bAllCheck0 = false
			Exit Function
		end if
	end if
	
	if contStep3.chkSub20.visible == true or contStep3.chkSub20.visible == "1" then
		if contStep3.chkSub20.checkstate == "0" then
			bAllCheck0 = false
			Exit Function
		end if
	end if
	
	if contStep3.chkSub30.visible == true or contStep3.chkSub30.visible == "1" then
		if contStep3.chkSub30.checkstate == "0" then
			bAllCheck0 = false
			Exit Function
		end if
	end if
		
	bAllCheck0 = true
End Function

