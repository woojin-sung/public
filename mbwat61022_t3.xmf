'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Wrap상품 목록 조회
' 02. 화면설명 : 
' 03. 이    력 : 2022.10.21 : 고승연 : v0001 : 
'                2023.05.08 : 고승연 : v0002 : [T2305030027] obwat_csad_021r IO 수정, 고객번호,조회구분 입력 추가
'                2023.11.10 : 고승연 : v0003 : 상품위험등급 구분 변경, obwat_pdad_065r IO 수정
'                2024.03.26 : 고승연 : v0004 : [T2402290007] obwat_pdad_065r IO 수정
'-------------------------------------------------------------------------------------------
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szWA_PRCD
Dim g_sData
Dim g_nContSubTop
Dim g_sFileName0
Dim g_sFileName1
Dim g_sFileName2
Dim g_sAdcpClsName

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	ImageStep0.setMaintainingRatio("1")
	contStep3.imgConfirm0.setMaintainingRatio("1")
	contStep3.contSub.imgConfirm1.setMaintainingRatio("1")
	
	contStep3.imgChkSub00.setMaintainingRatio("1")
	contStep3.imgChkSub01.setMaintainingRatio("1")
	contStep3.imgChkSub02.setMaintainingRatio("1")
	contStep3.imgChkSub03.setMaintainingRatio("1")
	contStep3.imgChkSub04.setMaintainingRatio("1")
	contStep3.imgChkSub10.setMaintainingRatio("1")
	contStep3.imgChkSub20.setMaintainingRatio("1")
	contStep3.imgChkSub30.setMaintainingRatio("1")
	contStep3.contSub.imgChkSub0.setMaintainingRatio("1")
	contStep3.contSub.imgChkSub1.setMaintainingRatio("1")
	contStep3.contSub.imgChkSub2.setMaintainingRatio("1")
	contStep3.contSub.imgChkSub3.setMaintainingRatio("1")
	contStep3.contSub.imgChkSub4.setMaintainingRatio("1")
	contStep3.contSub.imgChkSub5.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	g_sFileName0 = ""
	g_sFileName1 = ""
	g_sFileName2 = ""
	g_sAdcpClsName = ""
	
	contStep3.SetScrollAnimation(true)
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "001rData" then
		if sParam <> "" then
			Dim tData, sCsno
			sCsno = Form.GetSharedData("&CUST_NUM", false)
			tData = Split(sParam, "|")
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "IQRY_CLS_CODE" , 0 , "1" )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "NMET_APLT_DATE" , 0 , tData(0) )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "NMET_APLT_SRNO" , 0 , tData(1) )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_001r", "InBlock1", "CSNO" , 0 , sCsno )
			DATAMANAGER.RequestTranData( "obwat_onln_001r" )
		end if
	end if
End Sub

'============================================================================
Sub contStep3_lblConfirm0_OnClick()
	Dim sSub03, sSub04, sSub10, sSub20, sSub30, sData
	
	sSub03 = (contStep3.chkSub03.visible = true or contStep3.chkSub03.visible = "1") and "Y" or "N"
	sSub04 = (contStep3.chkSub04.visible = true or contStep3.chkSub04.visible = "1") and "Y" or "N"
	sSub10 = (contStep3.chkSub10.visible = true or contStep3.chkSub10.visible = "1") and "Y" or "N"
	sSub20 = (contStep3.chkSub20.visible = true or contStep3.chkSub20.visible = "1") and "Y" or "N"
	sSub30 = (contStep3.chkSub30.visible = true or contStep3.chkSub30.visible = "1") and "Y" or "N"
	
	sData = g_sFileName0.."|"..g_sFileName1.."|"..g_sFileName2.."|"..sSub03.."|"..sSub04.."|"..sSub10.."|"..sSub20.."|"..sSub30
	
	Form.OpenPopup("mbwat61022_p4" , sData, "")
End Sub

'============================================================================
Sub contStep3_contSub_lblConfirm1_OnClick()
	Dim sCheckState
	
	if bAllCheck1() then
		contStep3.contSub.imgAllAgree1.imgpath = "input_01_n.9.png"
		contStep3.contSub.lblConfirm1.fgcolor = "004:000000000"
		sCheckState = "0"
		btnNext.enable = false
	else
		contStep3.contSub.imgAllAgree1.imgpath = "btn_15_n.9.png"
		contStep3.contSub.lblConfirm1.fgcolor = "062:255255255"
		sCheckState = "1"
		
		if bAllCheck0() then
			btnNext.enable = true
		else
			btnNext.enable = false
		end if
	end if
		
	contStep3.contSub.chkSub0.checkstate = sCheckState
	contStep3.contSub.chkSub1.checkstate = sCheckState
	contStep3.contSub.chkSub2.checkstate = sCheckState
	
	if sCheckState == "1" then
		contStep3.contSub.imgChkSub0.imgpath = "icon_chk_off"
		contStep3.contSub.imgChkSub1.imgpath = "icon_chk_off"
		contStep3.contSub.imgChkSub2.imgpath = "icon_chk_off"
	else
		contStep3.contSub.imgChkSub0.imgpath = "icon_chk_on"
		contStep3.contSub.imgChkSub1.imgpath = "icon_chk_on"
		contStep3.contSub.imgChkSub2.imgpath = "icon_chk_on"
	end if
	
	if contStep3.contSub.chkSub3.visible = true or contStep3.contSub.chkSub3.visible == "1" then
		contStep3.contSub.chkSub3.checkstate = sCheckState
		if sCheckState == "1" then
			contStep3.contSub.imgChkSub3.imgpath = "icon_chk_off"
		else
			contStep3.contSub.imgChkSub3.imgpath = "icon_chk_on"
		end if
	end if
	
	if contStep3.contSub.chkSub4.visible = true or contStep3.contSub.chkSub4.visible == "1" then
		contStep3.contSub.chkSub4.checkstate = sCheckState
		if sCheckState == "1" then
			contStep3.contSub.imgChkSub4.imgpath = "icon_chk_off"
		else
			contStep3.contSub.imgChkSub4.imgpath = "icon_chk_on"
		end if
	end if
	
	if contStep3.contSub.chkSub5.visible = true or contStep3.contSub.chkSub5.visible == "1" then
		contStep3.contSub.chkSub5.checkstate = sCheckState
		if sCheckState == "1" then
			contStep3.contSub.imgChkSub5.imgpath = "icon_chk_off"
		else
			contStep3.contSub.imgChkSub5.imgpath = "icon_chk_on"
		end if
	end if
End Sub

'============================================================================
Sub btnNext_OnClick()
	DATAMANAGER.RequestTranData( "obwat_onln_002a" )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_onln_001r" then
		Dim sDate, sSrno, sAcnt, sAcntSub, sCode, sData1, sData2
		
		sDate = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "NMET_APLT_DATE" , 0 )
		sSrno = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "NMET_APLT_SRNO" , 0 )
		sAcnt = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "ACNO" , 0 )
		sAcntSub = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "ASNO" , 0 )
		sCode = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "ISCD" , 0 )
		sData1 = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "SVC_DTL_CNTT1" , 0 )
		g_sData = DATAMANAGER.GetDataValue( 0, "obwat_onln_001r", "OutBlock1", "SVC_DTL_CNTT2" , 0 )
		
		g_szWA_PRCD = sCode
		
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_791r", "InBlock1", "ACNO" , 0 , sAcnt )
		
		DATAMANAGER.SetDataValue( 0, "obwat_csad_003r", "InBlock1", "WA_PRCD" , 0 , g_szWA_PRCD )
		DATAMANAGER.SetDataValue( 0, "obwat_csad_003r", "InBlock1", "PROS_CLS_CODE" , 0 , "2" )
		DATAMANAGER.RequestTranData( "obwat_csad_003r" )
		
		DATAMANAGER.SetEventFlag( "obwat_onln_002a", "U" )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "NMET_APLT_DATE" , 0 , sDate )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "NMET_APLT_SRNO" , 0 , sSrno )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "PRGS_STAT_CODE" , 0 , "03" )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "BSWR_CLCD" , 0 , "01" )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "ACNO" , 0 , sAcnt )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "ASNO" , 0 , sAcntSub )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "ISCD" , 0 , sCode )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "SVC_DTL_CNTT1" , 0 , sData1 )
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "SVC_DTL_CNTT2" , 0 , g_sData )
		
	elseif szTranID == "obwat_csad_003r" then
		DATAMANAGER.RequestTranData( "obcsb_acif_791r" )
		
	elseif szTranID == "obcsb_acif_791r" then
		f_LocationUI()
		
		DATAMANAGER.RequestTranData( "obwat_csad_024r" )
		
	elseif szTranID == "obwat_csad_024r" then
		g_sFileName0 = DATAMANAGER.GetDataValue( 0, "obwat_csad_024r", "OutBlock1", "UI_1_ATCH_FILE_NAME" , 0 )
		g_sFileName1 = DATAMANAGER.GetDataValue( 0, "obwat_csad_024r", "OutBlock1", "UI_2_ATCH_FILE_NAME" , 0 )
		g_sFileName2 = DATAMANAGER.GetDataValue( 0, "obwat_csad_024r", "OutBlock1", "UI_3_ATCH_FILE_NAME" , 0 )
		
		if contStep3.contSub.chkSub1.visible == true or contStep3.contSub.chkSub1.visible == "1" then
			DATAMANAGER.RequestTranData( "obwat_csad_021r" )
		end if
		
	elseif szTranID == "obwat_csad_021r" then
		g_sAdcpClsName = DATAMANAGER.GetDataValue( 0, "obwat_csad_021r", "OutBlock1", "UI_ADCP_CLS_NAME" , 0 )
		
	elseif szTranID == "obwat_onln_002a" then
		Form.triggerEvent("#", "NEXT", "")
		
	end if
End Sub

Sub f_LocationUI()
	if g_sData <> null and g_sData <> "" then
		DIm tData
		tData = Split(g_sData, "|")
		
		Dim nTop
		nTop = 195
		
		Dim sPfinYN
		sPfinYN = DATAMANAGER.GetDataValue( 0, "obcsb_acif_791r", "OutBlock1", "UI_PFIN_YN" , 0 )
		
		if sPfinYN <> "Y" then '전문투자자가 아니면 개인전문투자자 보호제도 미적용 off
			contStep3.chkSub03.visible = false
			contStep3.lblSub03.visible = false
			contStep3.imgChkSub03.visible = false
			nTop = nTop - 25
		end if
		
		if not(tData(7) == "Y" or tData(8) == "Y") then '선물옵션YN
			'장내파생상품 거래 설명서 off
			contStep3.chkSub04.visible = false
			contStep3.lblSub04.visible = false
			contStep3.imgChkSub04.visible = false
			
			nTop = nTop + 10
		else
			contStep3.chkSub04.top = nTop
			contStep3.lblSub04.top = nTop
			contStep3.imgChkSub04.top = nTop +3
			nTop = nTop + 35
		end if
		
		if tData(4) <> "Y" then 'K-OTC
			'K-OTC 유의사항 off
			contStep3.lblTitle1.visible = false
			contStep3.chkSub10.visible = false
			contStep3.lblSub10.visible = false
			contStep3.imgChkSub10.visible = false
		else
			contStep3.lblTitle1.top = nTop
			nTop = nTop + 30
			contStep3.chkSub10.top = nTop
			contStep3.lblSub10.top = nTop
			contStep3.imgChkSub10.top = nTop +3
			nTop = nTop + 35
		end if
		
		if tData(11) <> "Y" then '파생ETF
			'파생 ETF투자위험 고지문 off
			contStep3.lblTitle2.visible = false
			contStep3.chkSub20.visible = false
			contStep3.lblSub20.visible = false
			contStep3.imgChkSub20.visible = false
		else
			contStep3.lblTitle2.top = nTop
			nTop = nTop + 30
			contStep3.chkSub20.top = nTop
			contStep3.lblSub20.top = nTop
			contStep3.imgChkSub20.top = nTop +3
			nTop = nTop + 35
		end if
		
		if tData(3) <> "Y" then 'ETN
			'상장지수증권(ETN)거래에 관한 위험고지 off
			contStep3.lblTitle3.visible = false
			contStep3.chkSub30.visible = false
			contStep3.lblSub30.visible = false
			contStep3.imgChkSub30.visible = false
		else
			contStep3.lblTitle3.top = nTop
			nTop = nTop + 30
			contStep3.chkSub30.top = nTop
			contStep3.lblSub30.top = nTop
			contStep3.imgChkSub30.top = nTop +3
			nTop = nTop + 35
		end if
		
		contStep3.imgBg0.height = nTop - 5
		
		g_nContSubTop = nTop + 20
		contStep3.contSub.top = g_nContSubTop
		
		Dim sWA_PROD_CLCD
		sWA_PROD_CLCD = DATAMANAGER.GetDataValue( 0, "obwat_csad_003r", "OutBlock1", "WA_PROD_CLCD" , 0 )
		nTop = 116
		
		if sWA_PROD_CLCD <> "5" then
			contStep3.contSub.chkSub1.visible = false
			contStep3.contSub.lblSub1.visible = false
			contStep3.contSub.imgChkSub1.visible = false
			contStep3.contSub.chkSub2.top = nTop
			contStep3.contSub.lblSub2.top = nTop
			contStep3.contSub.imgChkSub2.top = nTop +3
		else
			nTop = nTop + 25
			contStep3.contSub.chkSub2.top = nTop
			contStep3.contSub.lblSub2.top = nTop
			contStep3.contSub.imgChkSub2.top = nTop +3
		end if
		
		nTop = nTop + 25
		
		if tData(17) <> "Y" then '계열사종목운용
			'이해 관계인 발행증권 투자 동의 off
			contStep3.contSub.chkSub3.visible = false
			contStep3.contSub.lblSub3.visible = false
			contStep3.contSub.imgChkSub3.visible = false
		else
			contStep3.contSub.chkSub3.top = nTop
			contStep3.contSub.lblSub3.top = nTop
			contStep3.contSub.imgChkSub3.top = nTop +3
			nTop = nTop + 25
		end if
		
		if not(tData(7) == "Y" or tData(8) == "Y") then '선물옵션YN
			'선물옵션 투자시 확인 및 동의 off
			contStep3.contSub.chkSub4.visible = false
			contStep3.contSub.lblSub4.visible = false
			contStep3.contSub.imgChkSub4.visible = false
		else
			contStep3.contSub.chkSub4.top = nTop
			contStep3.contSub.lblSub4.top = nTop
			contStep3.contSub.imgChkSub4.top = nTop +3
			nTop = nTop + 25
		end if
		
		if tData(9) <> "Y" then '채권
			'채무증권 투자시 확인사항 확인 off
			contStep3.contSub.chkSub5.visible = false
			contStep3.contSub.lblSub5.visible = false
			contStep3.contSub.imgChkSub5.visible = false
			nTop = nTop + 10
		else
			contStep3.contSub.chkSub5.top = nTop
			contStep3.contSub.lblSub5.top = nTop
			contStep3.contSub.imgChkSub5.top = nTop +3
			nTop = nTop + 35
		end if
		
		contStep3.contSub.imgBg1.height = nTop - 30
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obwat_onln_002a" then
		Dim sData3, sDateTime, sUnDateTime
		sData3 = ""
		sDateTime = Form.GetSharedData("&HOST_DATE", false)..Form.GetSharedData("&HOST_TIME", false)
		sUnDateTime = "99991231125959" '미확인인경우 확인일시
		
		if contStep3.chkSub00.checkstate = "1" then 'Wrap 약관
			sData3 = "Y".."|"..sDateTime.."|"
		else
			sData3 = "N".."|"..sUnDateTime.."|"
		end if
		
		if contStep3.chkSub01.checkstate = "1" then 'Wrap 계약권유문서
			sData3 = sData3.."Y".."|"..sDateTime.."|"
		else
			sData3 = sData3.."N".."|"..sUnDateTime.."|"
		end if
		
		if contStep3.chkSub02.checkstate = "1" then '핵심설명서
			sData3 = sData3.."Y".."|"..sDateTime.."|"
		else
			sData3 = sData3.."N".."|"..sUnDateTime.."|"
		end if
		
		if contStep3.chkSub03.checkstate = "1" then '개인전문투자자에 대한 보호제도 미적용 확인서
			sData3 = sData3.."Y".."|"..sDateTime.."|"
		else
			sData3 = sData3.."N".."|"..sUnDateTime.."|"
		end if
		
		if contStep3.chkSub04.checkstate = "1" then '장내파생상품 거래 설명서
			sData3 = sData3.."Y".."|"..sDateTime.."|"
		else
			sData3 = sData3.."N".."|"..sUnDateTime.."|"
		end if
		
		if contStep3.chkSub10.checkstate = "1" then 'K-OTC 유의사항
			sData3 = sData3.."Y".."|"..sDateTime.."|"
		else
			sData3 = sData3.."N".."|"..sUnDateTime.."|"
		end if
		
		if contStep3.chkSub20.checkstate = "1" then '파생 ETF투자위험 고지문
			sData3 = sData3.."Y".."|"..sDateTime.."|"
		else
			sData3 = sData3.."N".."|"..sUnDateTime.."|"
		end if
		
		if contStep3.chkSub30.checkstate = "1" then '상장지수증권(ETN)거래에 관한 위험고지
			sData3 = sData3.."Y".."|"..sDateTime.."|"
		else
			sData3 = sData3.."N".."|"..sUnDateTime.."|"
		end if
		
		if contStep3.contSub.chkSub0.checkstate = "1" then '계약자 확인사항
			sData3 = sData3.."Y".."|"..sDateTime.."|"
		else
			sData3 = sData3.."N".."|"..sUnDateTime.."|"
		end if
		
		if contStep3.contSub.chkSub1.checkstate = "1" then '투자자문업자 동의
			sData3 = sData3.."Y".."|"..sDateTime.."|"
		else
			sData3 = sData3.."N".."|"..sUnDateTime.."|"
		end if
		
		if contStep3.contSub.chkSub2.checkstate = "1" then '수수료 관련 확인 및 동의
			sData3 = sData3.."Y".."|"..sDateTime.."|"
		else
			sData3 = sData3.."N".."|"..sUnDateTime.."|"
		end if
		
		if contStep3.contSub.chkSub3.checkstate = "1" then '이해 관계인 발행증권 투자 동의
			sData3 = sData3.."Y".."|"..sDateTime.."|"
		else
			sData3 = sData3.."N".."|"..sUnDateTime.."|"
		end if
		
		if contStep3.contSub.chkSub4.checkstate = "1" then '선물옵션 투자시 확인 및 동의
			sData3 = sData3.."Y".."|"..sDateTime.."|"
		else
			sData3 = sData3.."N".."|"..sUnDateTime.."|"
		end if
		
		if contStep3.contSub.chkSub5.checkstate = "1" then '채무증권 투자시 확인사항 확인
			sData3 = sData3.."Y".."|"..sDateTime
		else
			sData3 = sData3.."N".."|"..sUnDateTime
		end if
		
		DATAMANAGER.SetDataValue( 0, "obwat_onln_002a", "InBlock1", "SVC_DTL_CNTT3" , 0 , sData3 )
	
	elseif szTranID == "obwat_csad_024r" then
		DATAMANAGER.SetDataValue( 0, "obwat_csad_024r", "InBlock1", "WA_PRCD" , 0 , g_szWA_PRCD )
		
	elseif szTranID == "obwat_csad_021r" then
		'v0002
		DATAMANAGER.SetDataValue( 0, "obwat_csad_021r", "InBlock1", "IQRY_CLS_CODE", 0 , "2")
		DATAMANAGER.SetDataValue( 0, "obwat_csad_021r", "InBlock1", "WA_PRCD" , 0 , g_szWA_PRCD )
		
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "AGREE" then
		contStep3.imgAllAgree0.imgpath = "btn_15_n.9.png"
		contStep3.lblConfirm0.fgcolor = "062:255255255"
		contStep3.chkSub00.checkstate = "1"
		contStep3.imgChkSub00.imgpath = "icon_chk_off"
		contStep3.chkSub01.checkstate = "1"
		contStep3.imgChkSub01.imgpath = "icon_chk_off"
		contStep3.chkSub02.checkstate = "1"
		contStep3.imgChkSub02.imgpath = "icon_chk_off"
		contStep3.chkSub03.checkstate = "1"
		contStep3.imgChkSub03.imgpath = "icon_chk_off"
		
		if contStep3.chkSub04.visible = true or contStep3.chkSub04.visible = "1" then
			contStep3.chkSub04.checkstate = "1"
			contStep3.imgChkSub04.imgpath = "icon_chk_off"
		end if
		
		if contStep3.chkSub10.visible = true or contStep3.chkSub10.visible = "1" then
			contStep3.chkSub10.checkstate = "1"
			contStep3.imgChkSub10.imgpath = "icon_chk_off"
		end if
		
		if contStep3.chkSub20.visible = true or contStep3.chkSub20.visible = "1" then
			contStep3.chkSub20.checkstate = "1"
			contStep3.imgChkSub20.imgpath = "icon_chk_off"
		end if
		
		if contStep3.chkSub30.visible = true or contStep3.chkSub30.visible = "1" then
			contStep3.chkSub30.checkstate = "1"
			contStep3.imgChkSub30.imgpath = "icon_chk_off"
		end if
		
		contStep3.contSub.visible = true
		contStep3.SetScrollAutoSize()
		contStep3.scroll_pos = g_nContSubTop
		
	elseif sKeyName == "RETURN" then
		if sRet <> null and sRet <> "" then
			Form.SetCtlProp("contStep3.contSub.chkSub"..sRet, "checkstate", "1")
			f_AllCheck1()
		end if
		
	end if
End Sub

