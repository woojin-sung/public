Function bAllCheck1()
	if contStep3.contSub.chkSub0.checkstate == "0" then
		bAllCheck1 = false
		Exit Function
	end if
	
	if contStep3.contSub.chkSub1.visible == true or contStep3.contSub.chkSub1.visible == "1" then
		if contStep3.contSub.chkSub1.checkstate == "0" then
			bAllCheck1 = false
			Exit Function
		end if
	end if
	
	if contStep3.contSub.chkSub2.checkstate == "0" then
		bAllCheck1 = false
		Exit Function
	end if
	
	if contStep3.contSub.chkSub3.visible == true or contStep3.contSub.chkSub3.visible == "1" then
		if contStep3.contSub.chkSub3.checkstate == "0" then
			bAllCheck1 = false
			Exit Function
		end if
	end if
	
	if contStep3.contSub.chkSub4.visible == true or contStep3.contSub.chkSub4.visible == "1" then
		if contStep3.contSub.chkSub4.checkstate == "0" then
			bAllCheck1 = false
			Exit Function
		end if
	end if
	
	if contStep3.contSub.chkSub5.visible == true or contStep3.contSub.chkSub5.visible == "1" then
		if contStep3.contSub.chkSub5.checkstate == "0" then
			bAllCheck1 = false
			Exit Function
		end if
	end if
		
	bAllCheck1 = true
End Function

