		<ACCOUNT name="acnt01" itemcodetype="100,118,123,126,200" accpwdctl="edtPwd01" accnamectl="lblName" ly_vert="5,6,271,39,1" />
		<EDIT name="edtPwd01" halign="1" password="2" imetype="1" maxlength="8" minlength="4" hintcaption="비밀번호" ly_vert="282,6,86,39,1" />
		<FORMTAB name="FormTab0" tabcount="3" tabwidthtype="1" tabheadheight="35" autosave="1" ly_vert="0,57,375,505,1" >
			<PAGE name="page008258" caption="자동이체등록" linkfile="mbbnk61040_t1" loadingtype="1" />
