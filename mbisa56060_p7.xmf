	<SCRIPT_INFO _len="2655" _ulen="2611" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 상품상담안내
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.18 김은숙
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szACNO


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************



'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_szACNO = Form.GetOpenLinkData()
	DATAMANAGER.RequestTranData("obacp_opop_064r")
End Sub

'============================================================================
Sub cont0_BtnCall0_OnClick()
	Form.SendCall( "0220626677" )
End Sub

'============================================================================
'확인
Sub cont0_btnOK_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obacp_opop_064r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , g_szACNO)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obacp_opop_064r" then	
		Dim sBranchCode
		sBranchCode = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MANG_BRCD" , 0)
		DATAMANAGER.SetDataValue( 0 , "obcpp_fnds_803r", "InBlock1", "DPCD" , 0 , sBranchCode)
		DATAMANAGER.RequestTranData("obcpp_fnds_803r")
	End If

	If szTranID == "obcpp_fnds_803r" then	
		Dim sBranch
		sBranch = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "DPNM" , 0)
		cont0.tblBranch.SetCellString( 0, 1, sBranch)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obacp_opop_064r" trcode="obacp_opop_064r" compress="1" encryption="1" inputcheck="1" useattr="0" />
