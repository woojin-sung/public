'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 정기이체
' 02. 화면설명 : 정기이체_등록내역조회취소
' 03. 작    성 : 16.03.08
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szAccountNumber	'계좌번호
Dim g_szAccountSerialNumber	'계좌일련번호
Dim g_szAccountPassword	'계좌비밀번호
Dim g_szAccount	'계좌번호+일련번호
Dim g_szAccountName	'계좌명

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Function TR_Inquiry(szTranID)
	if szTranID == "obtss_igrs_697r" then
		Dim sDate 
		sDate = Form.GetSharedData("&HOST_DATE", false )
		
		DATAMANAGER.SetDataValue(0, "obtss_igrs_697r", "InBlock1", "APLT_CLS_CODE"  , 0 , "1")
		DATAMANAGER.SetDataValue(0, "obtss_igrs_697r", "InBlock1", "DRNG_TRGT_ACNO" , 0 , g_szAccount)
		DATAMANAGER.SetDataValue(0, "obtss_igrs_697r", "InBlock1", "IQRY_STA_DATE", 0 , "19900101")
		DATAMANAGER.SetDataValue(0, "obtss_igrs_697r", "InBlock1", "IQRY_FIN_DATE", 0 , sDate)
		DATAMANAGER.SetDataValue(0, "obtss_igrs_697r", "InBlock1", "CUST_ACNT_CLS_CODE" , 0 , "1")
		
		DATAMANAGER.RequestTranData("obtss_igrs_697r")
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "Password" then
		g_szAccountPassword = sParam
	end if
	
	if sEventName == "AllAccount" then
		Dim szList
		szList = Split(sParam, "★")
		
		if UBOUND(szList) < 1 then
			exit sub
		end if
		g_szAccount = szList(0) & szList(1)
		g_szAccountNumber = szList(0)
		g_szAccountSerialNumber = szList(1)
		if szList(2) == "" then
			g_szAccountPassword = ""
		else
			g_szAccountPassword = szList(2)
		end if
		
		g_szAccountName = szList(3)
		
		TR_Inquiry("obtss_igrs_697r")
		
	end if
End Sub

'============================================================================
'grdT201_OnScrollEnd
'============================================================================
Sub grdT201_OnScrollEnd()
	DATAMANAGER.RequestNextData("obtss_igrs_697r")
End Sub

'============================================================================
Sub grdT201_OnClickUp(lRow, szCellID)
	if Trim(g_szAccountPassword) == "" then
		Form.MsgBox("알림", "비밀번호를 입력하세요.", "", 0)
		exit sub
	end if
	
	' 등록일자/지정일/이체기간/출금계좌/입금은행/입금계좌/입금자명/출금금액/내통장표시/받는분통장표시/은행코드/신청구분코드/신청일련번호/조회구분코드/비밀번호
	Dim sSendData, sRegDate, sDay, sFromYM, sToYM, sACNO, sBANKNM, sBANKACNO, sBANKACNONM, sAMT, sText1, sText2, sBANKCODE, sGUBUN, sSRNO, pwd
	sRegDate = grdT201.GetCellData( "bd_regdate", lRow )
	sDay = grdT201.GetCellData( "bd_day", lRow )
	sFromYM = grdT201.GetCellData( "bd_fromym", lRow )
	sToYM = grdT201.GetCellData( "bd_toym", lRow )
	sACNO = grdT201.GetCellData( "bd_acno", lRow )
	sBANKNM = grdT201.GetCellData( "bd_banknm", lRow )
	sBANKACNO = grdT201.GetCellData( "bd_bankacno", lRow )
	sBANKACNONM = grdT201.GetCellData( "bd_bankacnonm", lRow )
	sAMT = grdT201.GetCellData( "bd_amt", lRow )
	sText1 = grdT201.GetCellData( "bd_text1", lRow )
	sText2 = grdT201.GetCellData( "bd_text2", lRow )
	sBANKCODE = grdT201.GetCellData( "bd_bankcode", lRow )
	sGUBUN = grdT201.GetCellData( "bd_gubun", lRow )
	sSRNO = grdT201.GetCellData( "bd_srno", lRow )
	sIQRYcode = grdT201.GetCellData( "bd_iqrycode", lRow )
	pwd = g_szAccountPassword
	
	sSendData = sRegDate.."★"..sDay.."★"..sFromYM.."★"..sToYM.."★"..sACNO.."★"..sBANKNM.."★"..sBANKACNO.."★"..sBANKACNONM.."★"..sAMT.."★"..sText1.."★"..sText2.."★"..
				sBANKCODE.."★"..sGUBUN.."★"..sSRNO.."★"..sIQRYcode.."★"..pwd
	
	Form.OpenPopup("mbbnk61040_p4" , sSendData , "")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbbnk61040_p4" then
		if sRet == "ok" then
			TR_Inquiry("obtss_igrs_697r")
		end if
	end if
End Sub

