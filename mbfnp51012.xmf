'			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")
'			
'		end if		
	end	if
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'	dim	szRmno,	szSaveType,	szFundCode,	szStndCode,	szFundName
	
	'===============================================
	' 가격입력창에서 리턴
	'===============================================
	if sKeyName == "PRC_POPUP" then	
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			contInput.ImgPrcreset.visible = true
			g_szPopPrc = sRet
			
			if g_SellType = "01" then	'금액매도
				contInput.LblPrcin.mask="0,0,,원,0,,0,1,0,0,0"
			else
				contInput.LblPrcin.mask="0,0,,좌,0,,0,1,0,0,0"
			end if
			
			contInput.LblAlert.visible = 1
			
			call contInput_LblPrcin_OnClick()
		else
			contInput.ImgPrcreset.visible = false
			contInput.LblAlert.caption = ""	'' 
			contInput.BtnPrcin.caption = "금액을 입력해주세요"
			
			contInput.LblAlert.visible = 0			
		end if

	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	Elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				contInput.edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				contInput.edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				contInput.edtPassword.pwdlen = tData(1)
				contInput.edtPassword.caption = tData(0)
			end if
			
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")			'공통프로세스 체크완료후 공인인증서
		end if
		
	'-----------------------------------
	'공인인증검증
	'-----------------------------------	
	elseif	sKeyName	=	"mhetc90060_p5"	then
		if	 sRet	<>	"cancel"		then				
			g_szIISC_FEE_LEVY_CLS_CODE	= "3"	'최초3입력
			g_szAPRV_YN				= ""		'최초 NULL입력
			g_szUI_ATMT_BYOV_STPL_YN	= "N"	'최초 N입력
			g_szCNVR_ABLE_YN			= "N"	'최초 N입력
			
			
			DATAMANAGER.SetEventFlag("obsai_deal_002a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_002a")								
		end	if
	
	elseif	sKeyName =	"mbfnp51012_p2" then
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			'g_szRet = sRet
			Form.CloseForm()
		end if	
	end if
	
'	'-----------------------------------
'	'잔고팝업(CLOSE시)
'	'-----------------------------------	
'	elseif	sKeyName	=	"51010_RMNOSELECTED"	then
'		if	sRet	=	"0"		then
'			'Form.triggerEvent("#", "CHGTAB_51010", "4")
'			ResetItems()
'		end	if
'		
'	'-----------------------------------
'	'잔고팝업
'	'-----------------------------------		
'	elseif	sKeyName	=	"51010_RMNO"	then
'		
'		if	len(sRet)	>	4	then
'			szRmno		=	getListItem(sRet, 0)
'			szSaveType	=	getListItem(sRet, 1)
'			szFundCode	=	getListItem(sRet, 2)	'펀드코드
'			szStndCode	=	getListItem(sRet, 3)	'표준코드
'			szFundName	=	getListItem(sRet, 4)	'펀드명
'			g_szOvrlSptxCd	=	getListItem(sRet, 5)	'종합분리과세코드
'			
'					
'			tbl01.SetCellString(0, 1, szRmno)		'잔고번호
'			tbl01.SetCellString(1, 1, szSaveType)	'저축방법
'				
'			g_szRmndNo	=	szRmno
'				
'			Form.triggerEvent("#", "CHGCODE_51010", szFundCode & "★" &	 szStndCode & "★" & szFundName) 	
'			
''			g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")
'			
'			edtSellAmt.caption	=	"0"		'매도가능좌수
'			if	len(trim(g_szFullAcnt))  > 8	and 	len(trim(szRmno))	>	0	then
'				DATAMANAGER.RequestTranData("obsai_deal_042r")
'			else
'				ResetItems()
'			end	if
'		end	if

'	'-----------------------------------
'	'매도확인팝업창
'	'-----------------------------------	
'	elseif	sKeyName	=	"mbfnp51010_p7"	then
'	
'		szSect	=	getListItem(sRet, 0)
'		
'		if	szSect	=	"ok"		then
''			g_szDealFee	=	getListItem(sRet, 1)
'			
'			DATAMANAGER.SetEventFlag("obsai_deal_002a", "I")
'			DATAMANAGER.RequestTranData("obsai_deal_002a")
'
'		end	if
'	end if
End Sub


'============================================================================
' BtnPrcin_OnClick
'============================================================================
Sub contInput_BtnPrcin_OnClick()
	Dim szPrc, szData, szType

	szPrc = ""
	
	contInput.BtnPrcin.caption = ""
	contInput.LblPrcin.caption = ""
	
'	Form.SetSharedData("OPEN_FILE_NAME", "mbfnp51010" )

	if g_SellType = "01" then	'금액매도
	
		szType = "원"
	
		if tonumber(contInput.lblInvtAbleAmt.caption) <> NULL and tonumber(contInput.lblInvtAbleAmt.caption) <> NULL then
			szMaxPrc = contInput.lblInvtAbleAmt.caption		'매도가능 합계
		else
			szMaxPrc = 0
		end if
	
	else'if g_SellType = "02" then	'좌수매도
		
		szType = "좌"
		
		if tonumber(contInput.lblInvtAbleQty.caption) <> NULL and tonumber(contInput.lblInvtAbleQty.caption) <> NULL then
			szMaxPrc = contInput.lblInvtAbleQty.caption		'매도가능 합계
		else
			szMaxPrc = 0
		end if
	
	'else	'전액매도	'''case 없음!
	
		'szType = "좌"
		
	end if

	Form.openPopup("mbfnp51010_p20", szPrc.."★"..szMaxPrc.."★"..szType, "")	'mhtro16090_p1
	
End Sub

'============================================================================
' Init_AfterOrder : 주문후 초기화
'============================================================================
Function	Init_InputControl()
	contInput.ImgPrcreset.visible = false
	if g_SellType = "01" then
		contInput.BtnPrcin.caption = "금액을 입력해주세요"
	else'if g_SellType = "02" then
		contInput.BtnPrcin.caption = "좌수를 입력해주세요"
	end if
	
	contInput.LblPrcin.caption = ""
	contInput.LblAlert.caption = ""

End Function

'============================================================================
Sub contInput_ImgPrcreset_OnClick()
	Init_InputControl()
End Sub

'============================================================================
Sub contInput_LblPrcin_OnClick()
	contInput.ImgPrcreset.visible = true
	if Trim(g_szPopPrc) <> "" then
		szPrc = CLng(g_szPopPrc)
	else
		szPrc = CLng(contInput.LblPrcin.caption)
	end if
	

	contInput.LblAlert.caption = ""
	if szPrc == 0 then
		contInput.LblPrcin.caption = ""
		contInput.BtnPrcin.caption = "매도 금액을 입력해주세요"
	else
		contInput.LblPrcin.caption = szPrc	
	end if
	
'	if szPrc <> "" and szPrc <> null then
'		DATAMANAGER.RequestTranData( "obfnp_fnmt_994r" )
'	end if

End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contInput_cmbAccount_ChangeAccount()
	DATAMANAGER.RequestTranData("obsai_deal_042r")
	
	contInput_ImgAmt_OnClick()	'금액매도 디폴트
End Sub

'============================================================================
Sub contInput_ImgAmt_OnClick()
	g_SellType = "01"	'정액매도
	
	contInput.LblPrcin.caption	= ""
	contInput.BtnPrcin.caption = "매도 금액을 입력해주세요"
	contInput.BtnPrcin.enable = true
	
	Form.SetCtlProp("contInput.ImgAmt", "imgpath", PressedImgPath)
	Form.SetCtlProp("contInput.ImgQty", "imgpath", unPressedImgPath)
	Form.SetCtlProp("contInput.ImgAllQty", "imgpath", unPressedImgPath)
End Sub

'============================================================================
Sub contInput_ImgQty_OnClick()
	g_SellType = "02"	'좌수매도

	contInput.LblPrcin.caption = ""
	contInput.BtnPrcin.caption = "좌수를 입력해주세요"
	contInput.BtnPrcin.enable = true
	
	Form.SetCtlProp("contInput.ImgAmt", "imgpath", unPressedImgPath)
	Form.SetCtlProp("contInput.ImgQty", "imgpath", PressedImgPath)
	Form.SetCtlProp("contInput.ImgAllQty", "imgpath", unPressedImgPath)
End Sub

'============================================================================
Sub contInput_ImgAllQty_OnClick()
	g_SellType = "03"	'전액매도

	contInput.LblPrcin.mask="0,0,,좌,0,,0,1,0,0,0"
	contInput.LblPrcin.caption = contInput.lblInvtAbleQty.caption
	contInput.BtnPrcin.caption = ""
	contInput.BtnPrcin.enable = false
	
	Form.SetCtlProp("contInput.ImgAmt", "imgpath", unPressedImgPath)
	Form.SetCtlProp("contInput.ImgQty", "imgpath", unPressedImgPath)
	Form.SetCtlProp("contInput.ImgAllQty", "imgpath", PressedImgPath)
End Sub

