'============================================================================
' 01.화면명 	: 펀드매매
' 02.화면설명	: 펀드매매_매도탭
' 03.작성	: 2016.02.19
' 04.수정 	: 2020.09.15 : 비밀번호 메모리 평문 노출 취약점 조치 v001 
'		: 2022.03.07 : v002 정우희 러시아펀드 매수/환매 불가 팝업창 추가
'               : 2022.06.21 : v003 임동군 매도구분 변경에 따라 caption 변경
'============================================================================



'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szFullAcnt		'계좌번호 8+2
dim	g_szPasswd		'비밀번호
dim	g_szRmndNo		'펀드잔고번호

dim	g_szShortCd		'펀드단축코드
dim	g_szStndCd		'펀드풀코드
dim	g_szFndname		'펀드명
dim	g_szDealFee		'수수료
dim	g_szOvrlSptxCd	'종합분리과세구분코드

dim	g_szIISC_FEE_LEVY_CLS_CODE	'집합투자증권수수료징수구분코드
dim	g_szAPRV_YN				'승인여부
dim	g_szUI_ATMT_BYOV_STPL_YN	'UI 자동매수1약정여부
dim	g_szCNVR_ABLE_YN			'전환가능여부
dim	g_szAlertTitle	'알림타이틀

dim g_SellType
dim unPressedImgPath 
dim PressedImgPath

g_szFullAcnt	=	""	
g_szPasswd	=	""
g_szRmndNo	=	""

g_szShortCd	=	""
g_szStndCd	=	""
g_szFndname	=	""
g_szDealFee	=	""
g_szOvrlSptxCd =	""

g_szIISC_FEE_LEVY_CLS_CODE	= "3"	'최초3입력
g_szAPRV_YN				= ""		'최초 NULL입력
g_szUI_ATMT_BYOV_STPL_YN	= "N"	'최초 N입력
g_szCNVR_ABLE_YN			= "N"	'최초 N입력

g_szAlertTitle	=	"알림"

g_SellType = "01"	'최초 금액선택

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'ResetItems
'============================================================================
Function	ResetItems()

	'1. 잔고번호
	'2. 저축방법
	'3. 매도신청좌수초기화
	'4. 매도가능잔고, 평가금액, 예상환매수수료 초기화

	g_szRmndNo	=	""				'잔고번호
	g_szSaveType	=	""				'저축방법

'	tbl01.SetCellString(0, 1, "")		'잔고번호
'	tbl01.SetCellString(1, 1, "")		'저축방법
'	edtSellAmt.caption	=	"0"		'매도가능좌수

'	tbl02.SetCellString(0, 1, "0")
'	tbl02.SetCellString(1, 1, "0")
'	tbl02.SetCellString(2, 1, "0")

End	Function


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	imgInfo.setMaintainingRatio("1")
End Sub

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()	

	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")
		
		g_szAccNo	= Form.GetSharedData("ADD_FUND_ACCOUNT_NO",false)	'계좌번호
		g_szAsNo		= Form.GetSharedData("ADD_FUND_ACCOUNT_SEQ",false)	'계좌순번
		g_szFullAcnt	= g_szAccNo & g_szAsNo
		
		contInput.cmbAccount.caption = g_szFullAcnt	'계좌콤보에 계좌번호SharedData 셋팅한번 더해줌.
		
		g_szRmndNo 	=	tData[0]	'잔고일련번호
		g_szShortCd	=	tData[1]
		g_szStndCd 	=	tData[2]	'종목코드
		g_szSaveType 	=	tData[3]	'저축유형
		
		szSaveTypeNm =  Form.GetMetaData("집합투자증권저축유형코드", g_szSaveType)
		
		DATAMANAGER.RequestTranData("oocwi_mall_003r")
	end if
	
	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	unPressedImgPath = "btn_line_n.9.png"
	PressedImgPath   = "btn_line_o.9.png"

	'잔고에서 선택한 계좌로 추가매수하기 위함.
	contInput.cmbAccount.enable = False
	'계좌 체크
	if g_szAccNo <> "" and g_szAccNo <> null then 
		DATAMANAGER.RequestTranData("obsai_deal_042r")
		DATAMANAGER.RequestTranData("obsai_deal_701r")
	end if
	
	'Form.ShowAlert(g_szAlertTitle, "분리과세 해지 후 매도신청 가능합니다. 거래하시는 지점 또는 고객지원센터(1588-3400)로 연락주시기 바랍니다.")

'	
'	ResetItems()
'	g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")			'1. 계좌만 세팅
		
End Sub


'============================================================================
'btnBal_OnClick
'============================================================================
Sub btnBal_OnClick()
	Form.OpenPopup("mbfnp51010_p2" , g_szFullAcnt , "")
End Sub



'============================================================================
'btnDeal_OnClick
'============================================================================
Sub btnDeal_OnClick()
	if	g_szShortCd	=	NULL	 	or		len(trim(g_szShortCd))	<	0	then
		Form.ShowAlert(g_szAlertTitle, "종목코드를 입력하여 주십시오.")
	end	if

	if	len(g_szShortCd)	>	0	and	len(g_szFndname) > 0	then
		Form.OpenPopup("mbfnp51010_p3" , g_szShortCd & "★" & g_szFndname , "")
	end if
End Sub


'============================================================================
'btnCaution_OnClick
'============================================================================
Sub btnCaution_OnClick()
	Form.OpenPopup("mbfnp51010_p4" , "", "")
End Sub

'============================================================================
'btnSell_OnClick
'============================================================================
Sub contInput_btnSell_OnClick()
	if f_bCheckBeforeReg() then		
	'	'분리과세하이일드펀드 체크 >> 아닌경우, 비밀번호 팝업. 맞으면 안내팝업!
		DATAMANAGER.RequestTranData("obacp_opop_030r")		
	end if
End Sub

'============================================================================
'f_bCheckBeforeReg() : 펀드매수 적합성 체크
'============================================================================
Function f_bCheckBeforeReg()

'	g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")
	
	if	len(trim(contInput.cmbAccount.caption))	<	8	then
		Form.ShowAlert(g_szAlertTitle, "계좌번호를 입력해 주십시오.")
		Exit Function
	end	if
	
	if	g_szRmndNo =	""	then
		Form.ShowAlert(g_szAlertTitle, "매도펀드를 선택하여 주시기 바랍니다.")
		Exit	Function
	end if
	
	IF g_SellType = "01" THEN
		if ( CDBL(contInput.LblPrcin.caption) > CDBL(contInput.lblInvtAbleAmt.caption) ) or 
			CDBL(contInput.LblPrcin.caption)	=	0 then
				Form.ShowAlert(g_szAlertTitle, "매도신청 금액을 확인바랍니다.")
			Exit	Function
		end if
	end if
	
	IF g_SellType = "02" THEN
		if ( CDBL(contInput.LblPrcin.caption) > CDBL(contInput.lblInvtAbleQty.caption) ) or 
			CDBL(contInput.LblPrcin.caption)	=	0 then
				Form.ShowAlert(g_szAlertTitle, "매도신청 좌수를 확인바랍니다.")
			Exit	Function
		end if
	end if
		
	IF g_SellType = "03" THEN
		if CDBL(contInput.LblPrcin.caption)	=	0 then
				Form.ShowAlert(g_szAlertTitle, "매도신청 좌수를 확인바랍니다.")
			Exit	Function
		end if
	end if
	
	
	szSaveTypeNm =  Form.GetMetaData("집합투자증권저축유형코드", g_szSaveType)
	
	if (( szSaveTypeNm = "자유적립식" or szSaveTypeNm = "정액적립식" ) and g_SellType = "03" ) then
		ShowAlert "알림", "가입하신 적립식저축펀드를 전액매도하시면 자동으로 저축계약이 해지됩니다. 해지 후 추가매수하실 수 없습니다."
	end if
	
	'부동산분리과세 잔고 매도 시 팝업 요청
	if	g_szOvrlSptxCd = "9" then
		ShowAlert "알림", "공모부동산펀드 분리과세 신청 된 잔고로 과세 혜택 내역이 있는 경우 수정신고 대상이며, 세금추징이 발생될 수 있습니다."
	end if
	
'	DATAMANAGER.RequestTranData("obacp_opop_068r")

	'적합
	return true
End Function

'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	g_szAccNo	=	left(contInput.cmbAccount.caption, 8)	'계좌번호
	g_szAsNo		=	mid(contInput.cmbAccount.caption, 9, 2)	'계좌순번
	g_szFullAcnt	= g_szAccNo & g_szAsNo
	
	'---------------------------------------
	'펀드정보조회
	'---------------------------------------
	if	szTranID	=	"oocwi_mall_003r"	then
		DATAMANAGER.SetDataValue(0, "oocwi_mall_003r", "InBlock1", "ISCD", 0, g_szStndCd)
	
	elseif	szTranID	=	"obsim_idmn_018r"	then				'종목집투기본정보조회
		DATAMANAGER.SetDataValue(0, "obsim_idmn_018r", "InBlock1", "ISCD", 0, g_szShortCd)
		
	'---------------------------------------
	'매도가능잔고조회
	'---------------------------------------
	elseif	szTranID	=	"obsai_deal_042r"	then
		DATAMANAGER.ClearInputData(0, "obsai_deal_042r")

		DATAMANAGER.SetDataValue(0, "obsai_deal_042r", "InBlock1", "ACNO", 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0, "obsai_deal_042r", "InBlock1", "ASNO", 0, g_szAsNo)
		DATAMANAGER.SetDataValue(0, "obsai_deal_042r", "InBlock1", "RMND_SRNO", 0, g_szRmndNo )

		DATAMANAGER.SetDataValue(0, "obsai_deal_042r", "InBlock1", "DEAL_CLS_CODE", 0, "1")
		DATAMANAGER.SetDataValue(0, "obsai_deal_042r", "InBlock1", "LOAN_YN", 0, "N")
				
	elseif	szTranID	=	"obsai_deal_701r"	then
		DATAMANAGER.SetDataValue(0, "obsai_deal_701r", "InBlock1", "ACNO", 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0, "obsai_deal_701r", "InBlock1", "ASNO", 0, g_szAsNo)
		DATAMANAGER.SetDataValue(0, "obsai_deal_701r", "InBlock1", "RMND_SRNO", 0, g_szRmndNo )
		DATAMANAGER.SetDataValue(0, "obsai_deal_701r" , "InBlock1", "ISCD", 0 , g_szShortCd)
		DATAMANAGER.SetDataValue(0, "obsai_deal_701r" , "InBlock1", "FND_DEAL_CLCD", 0 , "02") '추가매수
		
	'---------------------------------------
'	'비밀번호조회
'	'---------------------------------------
'	elseif		szTranID	=	"obacp_opop_068r"	then
'		DATAMANAGER.SetDataValue(0, "obacp_opop_068r", "InBlock1", "ACNO", 0, g_szAccNo)
'		'v0002 컨트롤매핑->스크립트 변경
'		if g_plain_rm == "1" then
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , contInput.edtPassword.caption)	'비밀번호
'		else
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("contInput.edtPassword", "encdata"))
'		end if
		
		
	'---------------------------------------
	'분리과세하이일드 펀드 체크
	'---------------------------------------
	elseif		szTranID	=	"obacp_opop_030r"	then
		DATAMANAGER.SetDataValue(0, "obacp_opop_030r", "InBlock1", "ACNO", 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0, "obacp_opop_030r", "InBlock1", "ASNO", 0, g_szAsNo)
		DATAMANAGER.SetDataValue(0, "obacp_opop_030r", "InBlock1", "RMND_SRNO", 0, g_szRmndNo)
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obacp_opop_030r", "InBlock1", "ACNT_PWD" , 0 , contInput.edtPassword.caption)	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, "obacp_opop_030r", "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("contInput.edtPassword", "encdata"))
		end if
	
	
	'---------------------------------------
	'펀드매도
	'---------------------------------------
	elseif		szTranID	=	"obsai_deal_002a"	then
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "ACNO", 0, g_szAccNo)
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "ASNO", 0, g_szAsNo)
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "RMND_SRNO", 0, g_szRmndNo)
		'v0002 컨트롤매핑->스크립트 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , contInput.edtPassword.caption)	'비밀번호
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD" , 0 , Form.GetCtlProp("contInput.edtPassword", "encdata"))
		end if
		
		'IISC_SELN_FORM_CLS_CODE	'매도구분		컴포넌트직접연결
		'SELN_ACNU				'매도신청좌수는	컴포넌트직접연결

		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "IISC_SELN_FORM_CLS_CODE"	,0 ,g_SellType)
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "SELN_ACNU"				,0 ,CDbl(contInput.LblPrcin.caption))

		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "RNVS_RMND_INCU_SELN_YN"	,0 ,"N")
		DATAMANAGER.SetDataValue(0,	 "obsai_deal_002a", "InBlock1", "IISC_FEE_LEVY_CLS_CODE"	,0 ,g_szIISC_FEE_LEVY_CLS_CODE)	'최초3 , 추후 규칙따름
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "TACT_APLT_YN"			,0 ,"N")
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "TACT_MTHD_CLS_CODE"		,0 ,"00")
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "PNSN_MOVE_APLT_YN"		,0 ,"N")
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "APRV_YN"					,0 ,g_szAPRV_YN)							'최초 NULL, 이후 규칙따름
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "UI_ATMT_BYOV_STPL_YN"		,0 ,g_szUI_ATMT_BYOV_STPL_YN)		'최초 N 입력, 규칙따름
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "CNVR_ABLE_YN"			,0 ,g_szCNVR_ABLE_YN)	'최초 N입력, 이후 규칙따름
		DATAMANAGER.SetDataValue(0, "obsai_deal_002a", "InBlock1", "ODER_GRP_NO" 			,0 ,"0")
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	szMsgCode

	szMsgCode	=""

	if	szTranID	=	"oocwi_mall_003r"	then
		Dim szGradCode, szTransGradNm, szTypeNm, szFundName
		
		szGradCode = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "PROD_GRAD_CODE", 0) 	'펀드등급
		szTransGradNm = Form.GetMetaData("집합투자증권상품등급코드", szGradCode)
		contInput.lblRiskNm.caption = szTransGradNm
'		contInput.lblRiskNm.fgcolor = 261
'		
''		    grd01T1.SetCellFgColor("bd_grade", i, 261)
'		if szGradCode = "01" then
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_296.png"
''				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_296.png")
'		elseif szGradCode = "02" then
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_297.png"
''				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_297.png")
'		elseif szGradCode = "03" then
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_298.png"
''				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_298.png")
'		elseif szGradCode = "04" then
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_299.png"
''				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_299.png")
'		elseif szGradCode = "05" then
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_300.png"
''				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_300.png")
'		else
'			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_300.png"
''				grd01T1.SetCellImage("bd_grade", i, "img_bgsquare_grade_300.png")
'		end if
		
		if szGradCode = "01" then
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_372.png"
			contInput.lblRiskNm.fgcolor = 273
		elseif szGradCode = "02" then
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_373.png"
			contInput.lblRiskNm.fgcolor = 144
		elseif szGradCode = "03" then
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_374.png"
			contInput.lblRiskNm.fgcolor = 144
		elseif szGradCode = "04" then
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_375.png"
			contInput.lblRiskNm.fgcolor = 144
		elseif szGradCode = "05" then
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_376.png"
			contInput.lblRiskNm.fgcolor = 144
		else
			contInput.ImgBadge1.imgpath = "img_bgsquare_grade_377.png"
			contInput.lblRiskNm.fgcolor = 273
		end if
		szTypeNm = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "ZI_TYPE_NAME", 0) 	'펀드유형		
		contInput.lblTypeNm.caption = szTypeNm
		contInput.ImgBadge2.imgpath = "img_bgsquare_grade_316.png"
		
		szFundName = DATAMANAGER.GetDataValue(0, "oocwi_mall_003r", "OutBlock1", "ZI_KOR_FUND_NAME", 0)	'펀드명
		contInput.lblFundNm.caption = szFundName
		contInput.lblFundNm.SetMaxLineCount(2)	'컨트롤 라인 제한 함수
		
		
		DATAMANAGER.RequestTranData("obsim_idmn_018r")
		
	elseif	szTranID	=	"obsim_idmn_018r"	then				'종목집투기본정보조회	
		szSaComCode = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock2", "IISC_ITCO_CODE", 0) 	'집합투자증권투자신탁회사코드 = "511" : 계열사
		szHGDTYn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock5", "HGDT_PROD_YN", 0)	'고난도상품여부
		szFITYn = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock5", "FIT_PROD_YN", 0)	'적정성상품여부

		'----- 적정성/고난도 유형 -----
		''적정성이나 고난도인 경우, 위험등급|펀드유형|적정성/고난도|계열사 순으로 뱃지 보이고
		''적정성이나 고난도가 아닌 경우, 위험등급|펀드유형|계열사 뱃지만 보이도록 뱃지 위치 조정	
		if szFITYn = "Y" or szHGDTYn = "Y"  then			
			if szFITYn == "Y" then
				contInput.ImgBadge3.imgpath = "img_bgsquare_grade_302.png"
				contInput.lblBadge3.caption = "적정성상품"
				contInput.lblBadge3.fgcolor = 261
			end if
			
			if szHGDTYn == "Y" then
				contInput.ImgBadge3.imgpath = "img_bgsquare_grade_302.png"
				contInput.lblBadge3.caption = "고난도상품"
				contInput.lblBadge3.fgcolor = 261
			end if
			'----- 적정성/고난도 유형 -----
				
			'----- 계열사구분코드 -----
			if szSaComCode = "511" then
				contInput.ImgBadge4.imgpath = "img_bgsquare_grade_303.png"
				contInput.lblBadge4.caption = "계열사"
				contInput.lblBadge4.fgcolor = 261
			else
				contInput.ImgBadge4.imgpath = "alpha.png"
				contInput.lblBadge4.caption = ""
				contInput.lblBadge4.fgcolor = 261
			end if
			'----- 계열사구분코드 -----
		
		else			
			'----- 계열사구분코드 -----
			if szSaComCode = "511" then
				contInput.ImgBadge3.imgpath = "img_bgsquare_grade_303.png"
				contInput.lblBadge3.caption = "계열사"
				contInput.lblBadge3.fgcolor = 261
			else
				contInput.ImgBadge3.imgpath = "alpha.png"
				contInput.lblBadge3.caption = ""
				contInput.lblBadge3.fgcolor = 261
			end if
	
			contInput.ImgBadge4.imgpath = "alpha.png"
			contInput.lblBadge4.caption = ""
			contInput.lblBadge4.fgcolor = 261
			'----- 계열사구분코드 -----
		end if
		
	'---------------------------------------
	'분리과세하이일드 펀드 체크
	'---------------------------------------
	elseif		szTranID	=	"obacp_opop_030r"	then
		dim szOVRL_SPTX_CLS_CODE, szJOIN_DATE, tmpToDate, tmpPre1Year

		szOVRL_SPTX_CLS_CODE = DATAMANAGER.GetDataValue(0,"obacp_opop_030r", "OutBlock1", "OVRL_SPTX_CLS_CODE", 0)	'종합 분리과세 구분 코드
		szJOIN_DATE = DATAMANAGER.GetDataValue(0,"obacp_opop_030r", "OutBlock1", "FRST_BYOV_DATE", 0)	'가입 일자

		nHostDate = Form.GetSharedData( "&HOST_DATE", false )	'오늘날짜		
		tmpToDate = LEFT(nHostDate,4) & "-" & RIGHT(LEFT(nHostDate,6),2) & "-" & RIGHT(nHostDate,2)	'오늘날짜		
		tmpPre1Year = CStr(DateAdd("d",0,DateAdd("m", -12, CDate(CStr(tmpToDate)))))	'1년전 오늘
		tmpPre1Year = Replace(tmpPre1Year, "-", "")
		
		tmpToDate = Replace(tmpToDate, "-", "")
		
		if szOVRL_SPTX_CLS_CODE == "8" and 
			(CDBL(szJOIN_DATE) > CDBL(tmpPre1Year))  and (CDBL(szJOIN_DATE) <= CDBL(tmpToDate)) then
			
			'메시지 보이고, 무조건 매도 불가!
			Form.ShowAlert(g_szAlertTitle, "분리과세 해지 후 매도신청 가능합니다. 거래하시는 지점 또는 고객지원센터(1588-3400)로 연락주시기 바랍니다.")
'			'Form.MsgBox(g_szAlertTitle, "분리과세 해지 후 매도신청 가능합니다. 거래하시는 지점 또는 고객지원센터(1588-3400)로 연락주시기 바랍니다." , "MSG_HIGH", "1")

		else
		
			Dim sSendData
			sSendData = contInput.cmbAccount.total&contInput.cmbAccount.sequence&"☆"&"0"
			'비밀번호 팝업 띄움..	
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")			
		end if
		
	elseif	szTranID	=	"obsai_deal_002a"	then	
		
		szMsgCode	=	DATAMANAGER.GetDataMsgCode("obsai_deal_002a")
	'Form.ShowAlert("Rcv_Msgcode", szMsgCode)
		
		if	szMsgCode	=	"0354"	then
			Form.MsgBox(g_szAlertTitle, "정기입금 이체가 신청중입니다. 매수자금이 입금 될 수 있으니 확인 바랍니다." , "MSG_0354", "6")
		elseif	szMsgCode	=	"4304"	then
			Form.MsgBox(g_szAlertTitle, "정기이체약정이 설정된 펀드입니다. 정기이체약정 유지 및 해지 여부를 확인하세요." , "MSG_4304", "6")
		elseif	szMsgCode	=	"7550"	then
			Form.MsgBox(g_szAlertTitle, "적립식 일부매도는 임의식으로 자동 전환 됩니다." , "MSG_7550", "6")
		elseif	szMsgCode	=	"3016"	then
			if	g_SellType	=	"02"		or	g_SellType	=	"03"		then
				Form.MsgBox(g_szAlertTitle, "환매수수료가 징구됩니다. 처리하시겠습니까?" , "MSG_3016A", "1")
			else
				Form.MsgBox(g_szAlertTitle, "정액매도시 환매수수료가 징구될 수 있습니다. 처리하시겠습니까?" , "MSG_3016B", "1")	'MTS오픈이후 사용됨.
			end	if
		elseif	szMsgCode	=	"5132"	then
			Form.MsgBox(g_szAlertTitle, "적립식 일부매도는 임의식으로 자동전환됩니다." , "MSG_5132", "6")
		else
			szSDPR_APLY_DATE 		= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SDPR_APLY_DATE", 0)	'기준가적용일자
			szSTLM_DATE 			= DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "STLM_DATE", 0)	'결제 일자
	
			'완료 페이지	'정상적으로 매도되었습니다
			Form.OpenPopup("mbfnp51012_p2", g_szAccNo & g_szAsNo & "★" & contInput.lblFundNm.caption & "★" & contInput.LblPrcin.caption & "★" & szSDPR_APLY_DATE & "★" & szSTLM_DATE & "★" & g_SellType, "")
		
		end	if
	elseif	szTranID	=	"obsai_deal_042r"	then
		g_szDRNG_ABLE_AMT = DATAMANAGER.GetDataValue(0,"obsai_deal_042r", "OutBlock1", "DRNG_ABLE_AMT", 0)	'평가금액
		g_szVLTN_AMT = DATAMANAGER.GetDataValue(0,"obsai_deal_042r", "OutBlock1", "VLTN_AMT", 0)	'출금가능금액
		 
		g_szDealFee	=	DATAMANAGER.GetDataValue(0, "obsai_deal_042r", "OutBlock1", "DEAL_FEE", 0)	'선취수수료
				
		contInput.lblInvtAbleAmt.caption = g_szVLTN_AMT
		contInput.lblInvtAbleQty.caption = g_szDRNG_ABLE_AMT
	
	
		if g_SellType = "01"	then			'정액매도시
			contInput_ImgAmt_OnClick()
		elseif	g_SellType = "02"	then		'좌수매도시
			contInput_ImgQty_OnClick()
		elseif	g_SellType = "03"	then		'전액매도시
			contInput_ImgAllQty_OnClick()
		end	if
		
	'v002
	elseif	szTranID	=	"obsai_deal_701r"	then
		 g_szFND_DEAL_RSTC_CLCD = DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "FND_DEAL_RSTC_CLCD", 0)	'펀드매매제한구분코드
		 g_szTN_INFORM_YN = DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "TN_INFORM_YN", 0)		'주의알림여부
		 g_szDEAL_ABLE_YN = DATAMANAGER.GetDataValue(0,"obsai_deal_701r", "OutBlock2", "DEAL_ABLE_YN", 0)		'매매제한여부
		 
		 if g_szTN_INFORM_YN = "Y" then
			 if g_szFND_DEAL_RSTC_CLCD = "002" then
				 Form.ShowAlert("알림", "선택하신 펀드는 주요 투자 지역(러시아)의 지정학적 리스크 확대 및 투자자산의 유동성 제한에 따라 환매 연기 조치 되었습니다. 환매연기 사유 해소시까지 환매신청이 제한됨을 안내드립니다. 자세한 사항은 고객센터(1588-3400)또는 거래 영업점으로 문의하시기 바랍니다.")	 
			 end if
			 
			 if g_szDEAL_ABLE_YN = "N" then
				 contInput.btnSell.enable = FALSE
			 end if
	      else 
			 contInput.btnSell.enable = TRUE
		 end if	
	end	if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	dim	szMsgCode
	dim	szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	contInput.btnBuy.enable = true
	
	if	szTranID	=	"obsai_deal_042r"	then
	
		szMsgCode	=	DATAMANAGER.GetDataMsgCode("obsai_deal_042r")
		
		if	szMsgCode	<>	"1594"	then		'잔고가 없습니다.:MSGCODE =1594
			if	len(trim(szSubMsg))	>	0	then
				Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
			else
				Form.ShowAlert(g_szAlertTitle, szErrMsg )
			end	if
		end	if
		
		contInput.lblInvtAbleAmt.caption = 0
		contInput.lblInvtAbleQty.caption = 0
		
'		tbl02.SetCellString(0, 1, "0")
'		tbl02.SetCellString(1, 1, "0")
'		tbl02.SetCellString(2, 1, "0")
	
	else
		if	len(trim(szSubMsg))	>	0	then
			Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szAlertTitle, szErrMsg )
		end	if
		
		if szTranID == "obsai_deal_002a" then
			contInput.btnSell.enable = false
		end if
	end if
	
End Sub	


'============================================================================
'Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

	if sKeyName = "MSG_0354" then							'정기입금 이체가 신청중..
		if	sRet		=	"close"		then
			g_szUI_ATMT_BYOV_STPL_YN	= "Y"	
			DATAMANAGER.SetEventFlag("obsai_deal_002a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_002a")
		end	if
	elseif	 sKeyName = "MSG_4304" then						'정기이체약정이 설정된 펀드..
		if	sRet		=	"close"		then
			g_szUI_ATMT_BYOV_STPL_YN	= "Y"	
			DATAMANAGER.SetEventFlag("obsai_deal_002a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_002a")
		end	if
	elseif	 sKeyName = "MSG_7550" then						'적립식 일부매도는 임의식으로 자동전환됨
		if	sRet		=	"close"		then
			g_szCNVR_ABLE_YN			= "Y"
			g_szAPRV_YN				= "Y"				'160324 권오상과장님 요청에 의해 추가.
			DATAMANAGER.SetEventFlag("obsai_deal_002a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_002a")
		end	if
	elseif	 sKeyName = "MSG_3016A" then					'전액, 일부
		if	sRet		=	"ok"		then
			g_szIISC_FEE_LEVY_CLS_CODE	= "1"	'최초3입력
			g_szCNVR_ABLE_YN			= "Y"	'최초 N입력
			DATAMANAGER.SetEventFlag("obsai_deal_002a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_002a")
		end	if
	elseif	 sKeyName = "MSG_3016B" then					'정액매도
		if	sRet		=	"ok"		then
			g_szIISC_FEE_LEVY_CLS_CODE	= "1"	'최초3입력
			g_szCNVR_ABLE_YN			= "Y"	'최초 N입력
			g_szUI_ATMT_BYOV_STPL_YN	= "Y"	'최초 N입력
			DATAMANAGER.SetEventFlag("obsai_deal_002a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_002a")
		end	if
	elseif	 sKeyName = "MSG_5132" then						'적립식 일부매도는 임의식으로 자동전환됨
		if	sRet		=	"close"		then
			g_szCNVR_ABLE_YN			= "Y"	'최초 N입력
			g_szAPRV_YN				= "Y"	'최초 NULL입력
			DATAMANAGER.SetEventFlag("obsai_deal_002a", "I")
			DATAMANAGER.RequestTranData("obsai_deal_002a")
		end	if
'	elseif	 sKeyName = "MSG_HIGH" then	
'		if	sRet		=	"ok"		then
'			
'			Dim sSendData
'			sSendData = contInput.cmbAccount.total&contInput.cmbAccount.sequence&"☆"&"0"
