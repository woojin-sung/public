Dim g_nPage
Dim g_xPos
Dim g_nIndex
Dim szNext
Dim szSaveCmb0, szSaveCmb1
g_nPage = 0
g_xPos  = ""
g_nIndex = 0
szNext = ""
'============================================================================
Sub Form_OnFormInit()
	Combo0.bgimagetype = "1"
	Combo1.bgimagetype = "1"
	Combo2.bgimagetype = "1"
	if Form.GetEnvData("16050_T1_COMBO0") <> null and Form.GetEnvData("16050_T1_COMBO0") <> ""	then
		Combo0.cbkeydata = Form.GetEnvData("16050_T1_COMBO0")
	end if
	if Form.GetEnvData("16050_T1_COMBO1") <> null and Form.GetEnvData("16050_T1_COMBO1") <> ""	then
		Combo1.cbkeydata = Form.GetEnvData("16050_T1_COMBO1")
	end if
	if Form.GetEnvData("16050_T1_COMBO2") <> null and Form.GetEnvData("16050_T1_COMBO2") <> ""	then
		Combo2.cbkeydata = Form.GetEnvData("16050_T1_COMBO2")
	end if
	if Form.GetEnvData("16050_T1_RADIO1") <> null and Form.GetEnvData("16050_T1_RADIO1") <> ""	then
		RadioGroup1.currentindex = Form.GetEnvData("16050_T1_RADIO1")
	end if
	DATAMANAGER.RequestTranData("ohhts_6222_001r")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_6222_001r"	then
		Dim szCmb0, szCmb1, szDate, szDelay
		szCmb0 = Combo0.cbkeydata
		szCmb1 = Combo1.cbkeydata
		szCmb2 = Combo2.cbkeydata
		
		if RadioGroup1.currentindex == "0" or RadioGroup1.currentindex == 0	then
			szDate = "1"
		elseif RadioGroup1.currentindex == "1" or RadioGroup1.currentindex == 1	then
			szDate = "5"
		elseif RadioGroup1.currentindex == "2" or RadioGroup1.currentindex == 2	then
			szDate = "10"
		elseif RadioGroup1.currentindex == "3" or RadioGroup1.currentindex == 3	then
			szDate = "20"
		elseif RadioGroup1.currentindex == "4" or RadioGroup1.currentindex == 4	then
			szDate = "60"
		elseif RadioGroup1.currentindex == "5" or RadioGroup1.currentindex == 5	then
			szDate = "90"
		end if
		
		if szCmb2 == "US" then
			szDelay = Form.GetSharedData("REALTIME_AX", 0 ) ' 미국은 AX,OQ,NY 모두 같아서 AX로 가져옴
		else
			szDelay = Form.GetSharedData("REALTIME_"..szCmb2, 0 )
		end if
		
		'상해/심천 거래소는 시장코드로 구분(거래소별 실시간 여부 다름)
		if szCmb2 == "SH" or szCmb2 == "SZ" then
			DATAMANAGER.SetDataValue( 0, "ohhts_6222_001r" , "InBlock1", "FIDX_INPUT_NTNL_CODE" , 0 , "CN" )
			DATAMANAGER.SetDataValue( 0, "ohhts_6222_001r" , "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , szCmb2 )
		else
			DATAMANAGER.SetDataValue( 0, "ohhts_6222_001r" , "InBlock1", "FIDX_INPUT_NTNL_CODE" , 0 , szCmb2 )
			DATAMANAGER.SetDataValue( 0, "ohhts_6222_001r" , "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , "" )
		end if


		DATAMANAGER.SetDataValue( 0, "ohhts_6222_001r" , "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( 0, "ohhts_6222_001r" , "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "62220" )
		DATAMANAGER.SetDataValue( 0, "ohhts_6222_001r" , "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay ) '실시간:0 지연:1
		DATAMANAGER.SetDataValue( 0, "ohhts_6222_001r" , "InBlock1", "FID_INPUT_DATE1" , 0 , szDate )
		DATAMANAGER.SetDataValue( 0, "ohhts_6222_001r" , "InBlock1", "FID_INPUT_VOL1" , 0 , szCmb0 )
		DATAMANAGER.SetDataValue( 0, "ohhts_6222_001r" , "InBlock1", "FIDX_INPUT_TR_PBMN" , 0 , szCmb1 )
		DATAMANAGER.SetDataValue( 0, "ohhts_6222_001r" , "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE4" , 0 , "0" )

	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6222_001r" then
		Dim nCount
		nCount    	= _tonumber( DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ) )

		for i=0 to nCount-1
			nLevg = _tonumber(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FID_LVRG" , i))

			'레버리지 셋팅                              
			if nLevg > 0  then
				Grid0.SetCellData( "bd_cell7", g_nIndex + i, "+" .. tostring(nLevg) )
			elseif nLevg < 0  then
				Grid0.SetCellData( "bd_cell7", g_nIndex + i, (nLevg) )
			else 
				Grid0.SetCellData( "bd_cell7", g_nIndex + i, "" )
			end if
			
			Dim szExid, szCode

			szExid  = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FID_COND_MRKT_CLS_CODE" , i)
			szCode  = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FIDX_ISCD" , i)
			
			Grid0.SetCellData("bd_cell5", g_nIndex + i, szExid.."@"..szCode)
			
			'DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , i , szExid.."@"..szCode )
		next
		Grid0.keyall = "1"
		'DATAMANAGER.RequestRealData("ohhts_exst_ictg")
		g_nIndex = _tonumber( Grid0.rowcount )
	end if
end Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	Grid0.SetClear( )
	g_nPage  = 0
	g_nIndex = 0
	szNext = ""
	Form.SetEnvData(1,"16050_T1_COMBO0", Combo0.cbkeydata)
	szSaveCmb0 = Combo0.cbkeydata
	szSaveCmb1 = Combo1.cbkeydata
	DATAMANAGER.RequestTranData( "ohhts_6222_001r" )
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

'============================================================================
Sub Combo1_OnEditComplete(iIndex)
	Grid0.SetClear( )
	g_nPage = 0
	g_nIndex = 0
	szNext = ""
	Form.SetEnvData(1, "16050_T1_COMBO1", Combo1.cbkeydata)
	szSaveCmb0 = Combo0.cbkeydata
	szSaveCmb1 = Combo1.cbkeydata
	DATAMANAGER.RequestTranData("ohhts_6222_001r")
End Sub

'============================================================================
Sub Combo2_OnEditComplete(iIndex)
	Grid0.SetClear( )
	g_nPage = 0
	g_nIndex = 0
	szNext = ""
	Form.SetEnvData(1, "16050_T1_COMBO2", Combo2.cbkeydata)
	szSaveCmb0 = Combo0.cbkeydata
	szSaveCmb1 = Combo1.cbkeydata
	DATAMANAGER.RequestTranData("ohhts_6222_001r")
End Sub

Function _tonumber(data)
	return tonumber(data) or 0
end Function

'============================================================================
Sub Grid0_OnScrollEnd()
	Dim bNext
	bNext = DATAMANAGER.IsMoreNextData( "ohhts_6222_001r" )
	if bNext == "1" or bNext == true then
		DATAMANAGER.RequestNextData( "ohhts_6222_001r" )
	end if
end Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	Dim sCode
	sCode = Grid0.GetCellData("bd_cell5", lRow)
	sExid = Grid0.GetCellData("bd_cell1", lRow)
	sProCode = Grid0.GetCellData("bd_cell6", lRow)
	sName = Grid0.GetCellData("bd_cell0", lRow)
	
	if sCode <> null and sCode <> ""	then
		listlocation = split(Grid0.location, ":")
		nYPos = Int(listLocation[1])
		szData = sCode.."^"..sProCode.."^"..sName.."^".."".."^"..sExid.."^"..nYPos
		'Form.OpenPopup("mhtro16051_p2" , szData , "")
		
		' [18.11.19 김경민] - mhtro16051_p2 팝업창을 mhtro16052_p1 으로 변경
		Form.OpenPopup("mhtro16052_p1" , szData , "")
	end if
End Sub

'============================================================================
Sub RadioGroup1_OnClick(nIndex)
	Grid0.SetClear( )
	g_nPage = 0
	g_nIndex = 0
	szNext = ""
	Form.SetEnvData(1, "16050_T1_RADIO1", RadioGroup1.currentindex)
	DATAMANAGER.RequestTranData("ohhts_6222_001r")
End Sub

'============================================================================
Sub Form_OnRefresh()
	g_nPage  = 0
	g_nIndex = 0
	Grid0.SetClear( )
	szNext = ""
	DATAMANAGER.RequestTranData( "ohhts_6222_001r" )
End Sub

