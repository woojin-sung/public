'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAcnt, g_szAcntCd, g_szStartDt, g_szEndDt, g_szGbCd


'============================================================================
Sub Form_OnFormInit()
	szOpen = Form.GetOpenLinkData()

	if Trim(szOpen) == "" then
		Exit Sub
	end if

	tData = Split(szOpen, "★")
	
	if UBound(tData) > 0 then
		g_szAcnt   	= tData(0)
		g_szAcntCd 	= tData(1)
		g_szStartDt	= tData(2)
		g_szEndDt	= tData(3)
		g_szGbCd		= tData(4)	'1:원화RP 2:외화RP
	end if
	
	if CDbl(g_szGbCd) == 1 then
		lblTitle.caption = "원화RP 수익금 내역"
		GridWon.visible = true
		GridUsd.visible = false
	else
		lblTitle.caption = "외화RP 수익금 내역"
		GridWon.visible = false
		GridUsd.visible = true
	end if
	
	DATAMANAGER.RequestTranData( "obsav_bsop_323r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obsav_bsop_323r" Then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"	 		, 0 , g_szAcnt)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" 	  		, 0 , g_szAcntCd)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "STA_DATE" 		, 0 , g_szStartDt)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FIN_DATE" 		, 0 , g_szEndDt)	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE"	, 0 , g_szGbCd)	
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obsav_bsop_323r" Then
		Dim nCnt, nGridCnt
		
		nCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		nGridWonCnt = CInt(GridWon.rowcount)
		nGridUsdCnt = CInt(GridUsd.rowcount)
		
		if nCnt = 0 then
			lblNoData.visible = true
			GridWon.visile = false
			GridUsd.visible = false
		else
			' 원화/외화 RP수익률 폰트컬러 회색처리
			if CDbl(g_szGbCd) == 1 then
				for i = (nGridWonCnt - nCnt) to nGridWonCnt-1
					GridWon.SetCellFgColor("bd_cell1", i, 146)			
				next
			else
				for i = (nGridUsdCnt - nCnt) to nGridUsdCnt-1
					GridUsd.SetCellFgColor("bd_cell1", i, 146)			
				next
			end if
		end if
		
		
	    If DATAMANAGER.IsMoreNextData( "obsav_bsop_323r" ) = True then
	       DATAMANAGER.RequestNextData( "obsav_bsop_323r" )
	    End If
	End If
End Sub

'============================================================================
'TR오류시..
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( szTranID .. "안내" , szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( szTranID .. "안내" , szErrMsg)
	end if
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'여백클릭시 꺼지도록 함
'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub
