	<SCRIPT_INFO _len="8927" _ulen="8131" >
'--===========================================================================
'--===========================================================================
Dim m_sEditIndex
Dim m_b4Switch
Dim m_bErrorCheck
Dim m_bCloseForm
Dim m_bOpenPopup


Dim g_sRetData
Dim g_sUserID
Dim g_sSecCardCertYn
Dim g_plain_rm  'v0001 메모리평문적용여부
'============================================================================
'초기화 함수
'============================================================================
Function Func_Clear_Pwd()
	m_sEditIndex = 0

End Function

'============================================================================
Sub Form_OnFormInit()

	EditInput1.certname = "보안카드 "&Label1.caption&Label2.caption
	EditInput2.certname = "보안카드 "&Label3.caption&Label4.caption
	
	EditInput1.imagefilepth = "login_input.9"
	EditInput2.imagefilepth = "login_input.9"
	
	g_sSecCardCertYn = "N"
	g_sRetData = "cancel"

	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	if g_plain_rm == "1" then
	     '화면 마스킹표시/평문데이터로 설정(컨트롤속성-일반비밀번호사용 적용필수)
		EditInput1.SetEncExcept()
		EditInput2.SetEncExcept()
	end if 

	g_sUserID = Form.GetSharedData("CERT_ID" , false)
	szUserID = Form.GetSharedData("&USER_ID" , false)
	if g_sUserID == null or g_sUserID == "" then
		g_sUserID = szUserID
	elseif g_sUserID ~= szUserID then
		g_sUserID = szUserID
	end if

	if g_sUserID ~= null and g_sUserID ~= "" then
		DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
	end if
	
	m_sEditIndex = 0 
	
	m_bErrorCheck 	= false	'
	m_bCloseForm 		= true	'비밀번호 검증 완료 시, 팝업종료 여부 
	m_bOpenPopup 		= false	'자동저장기능 안내팝업 여부
	
	'0.5초 후 보안키패드 띄움
	Form.SetTimerEvent2(1, 1, 0.5)             
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)

	if Cint(sTimerID) = 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0.5)
		EditInput1.setShowKeypad(True)
	
	'20221103 LES START
	elseif Cint(sTimerID) = 2 then
		Form.SetTimerEvent2(sTimerID, 0, 0.1)
		EditInput2.setShowKeypad(True)
	
	elseif Cint(sTimerID) = 3 then
		Form.SetTimerEvent2(sTimerID, 0, 0.1)
		EditInput1.setShowKeypad(True)
	'20221103 LES END
	
	end if
End Sub

'============================================================================
Sub Button1_OnClick()
	Func_Clear_Pwd()
	EditInput1.setShowKeypad(True)
	m_bCloseForm = false
End Sub

'============================================================================
Sub Button2_OnClick()
	Func_Clear_Pwd()
'	20221117 HSZ START
	if (EditInput1.caption == null or EditInput1.getLen(EditInput1.caption) < 2 ) then
		Form.SetTimerEvent2(3, 1, 0.1)
	elseif (EditInput2.caption == null or EditInput2.getLen(EditInput2.caption) < 2 ) then
		Form.SetTimerEvent2(2, 1, 0.1)
	else
		m_bCloseForm = false
	end if
'	EditInput1.setShowKeypad(True)
'	m_bCloseForm = false
'	20221117 HSZ END
End Sub
'============================================================================
Sub Button3_OnClick()
	m_bCloseForm = false
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	if g_sSecCardCertYn = "Y" then
		Form.SendReturnToParent("보안카드" , "Success")
	else
		Form.SendReturnToParent("보안카드" , "Fail")
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	m_bOpenPopup = false
	EditInput1.setShowKeypad(True)
End Sub
'============================================================================
Sub Form_OnFormInitBefore()
	imgIcon0.setMaintainingRatio("1")
	imgIcon1.setMaintainingRatio("1")
	imgIcon2.setMaintainingRatio("1")
	imgIcon3.setMaintainingRatio("1")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "1" ) '전자금융ID
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
	elseif szTranID == "obcsb_simf_000r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "INPUT_CLS" , 0 , "2" ) '전자금융ID
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "SCRC_IDX_NO1" , 0 , Label1.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "SCRC_IDX_NO2" , 0 , Label3.caption )
		'v0001 값은 평문으로 전송(서비스에서 해쉬암호화처리해서 체크함)
		'MTS메모리평문적용(g_plain_rm == "1")시에는 OnFormInit()에서 평문데이터로 설정하므로 caption으로 전송가능
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "SCRC_NO1" , 0 , EditInput1.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "SCRC_NO2" , 0 , EditInput2.caption )
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		Dim sRSLT_CLS, sSCRC_STAT_CODE
		
		'결과구분 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "RSLT_CLS" , 0 )
		'보안카드상태코드 0:정상, 1:매체사고, 2:비번오류횟수초과, 6:사용등록안됨
		sSCRC_STAT_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "SCRC_STAT_CODE" , 0 )
	
		if sRSLT_CLS == "0" then '보안카드
			if sSCRC_STAT_CODE == "0" then '정상
				'ButtonOK.enable = true
			elseif sSCRC_STAT_CODE == "1" then '매체사고	
				Form.MsgBox( "알림", "매체사고 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "2" then '비번오류횟수초과	
				Form.MsgBox( "알림", "비밀번호 오류초과 입니다.", "", 6 )
			elseif sSCRC_STAT_CODE == "6" then '사용등록안됨	
				Form.MsgBox( "알림", "사용등록이 안되었습니다.", "", 6 )
			else '그외
				Form.MsgBox( "알림", "미지정 상태입니다.", "", 6 )
			end if
		end if
		
		EditInput1.certname = "보안카드 "&CInt(Label1.caption)&Label2.caption
		EditInput2.certname = "보안카드 "&CInt(Label3.caption)&Label4.caption
	elseif szTranID == "obcsb_simf_000r" then
		Dim sRSLT_CLS, sSCRC_PWD_MSTK_TMNU
		
		'결과구분 0:정상 그외에러
		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_simf_000r", "OutBlock1", "RSLT_CLS" , 0 )
		'보안카드오류횟수
		sSCRC_PWD_MSTK_TMNU = DATAMANAGER.GetDataValue( 0, "obcsb_simf_000r", "OutBlock1", "SCRC_PWD_MSTK_TMNU" , 0 )
		
		if sRSLT_CLS == "0" then '정상
			if CInt(sSCRC_PWD_MSTK_TMNU) > 5 then '에러
				Form.MsgBox( "알림", "보안카드 입력 오류 횟수 초과입니다.", "", 6 )				
			else
				g_sSecCardCertYn = "Y"
'				Form.SendReturnToParent("보안카드" , "Success")
				Form.CloseForm()
			end if
		else
			Dim sMsg, sSubMsg 
			sMsg = DATAMANAGER.GetDataMsgText( szTranID )
			sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
			Form.MsgBox( "알림", sMsg.." "..sSubMsg, "", 6 )
		end if
	end if
End Sub

'============================================================================
Sub EditInput1_OnEditComplete()

	if (EditInput1.caption == null or EditInput1.getLen(EditInput1.caption) < 2 ) then
		Form.MsgBox( "알림", "보안카드 번호를 입력해주세요.", "EditInput1", 6 )
		EditInput1.caption = ""
	elseif (EditInput2.caption == null or EditInput2.getLen(EditInput2.caption) < 2 ) then
		
		'20221103 LES START
		Form.SetTimerEvent2(2, 1, 0.1)
		'EditInput2.setShowKeypad(True)
		'20221103 LES END 
		
	else
		DATAMANAGER.RequestTranData( "obcsb_simf_000r" ) '보안카드정보확인
	end if	
End Sub

'============================================================================
Sub EditInput2_OnEditComplete()
	if (EditInput2.caption == null or EditInput2.getLen(EditInput2.caption) < 2 ) then
		Form.MsgBox( "알림", "보안카드 번호를 입력해주세요.", "EditInput2", 6 )
		EditInput2.caption = ""
	elseif (EditInput1.caption == null or EditInput1.getLen(EditInput1.caption) < 2 ) then
		
		'20221103 LES START
		Form.SetTimerEvent2(3, 1, 0.1)
		'EditInput1.setShowKeypad(True)
		'20221103 LES END 
		
	else
		DATAMANAGER.RequestTranData( "obcsb_simf_000r" ) '보안카드정보확인
	end if	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "EditInput1" then
		EditInput1.setShowKeypad(True)
	elseif sKeyName == "EditInput1" then
		EditInput2.setShowKeypad(True)
	end if
End Sub

	</SCRIPT_INFO>
