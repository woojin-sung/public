	<SCRIPT_INFO _len="8224" _ulen="7384" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 로그인_ID 비밀번호 재설정
' 02. 화면설명 : 
' 03. 작    성 : 2016.03.30 김은숙
' 2020.10.12 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
' 2020.10.27 : 권오상 : v002 : T2008250015 : 실명확인번호 암호화 처리'
' 2023.11.14 : 양현정 : v0003 : 변수명이 동일해서 길이세팅이 자꾸 변경됨..
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sPopupFileName
Dim g_plain_rm			'v0001 메모리평문적용여부
Dim g_ATMT_ISNC_YN

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
'내국인/외국인/법인 선택에 따른 실명번호
Function GetRCNO()
	Dim sRCNO
	
	if rdoGubn.currentindex == "0" then		'내국인
		sRCNO = contBirth.edt01.caption
	elseif rdoGubn.currentindex == "1" then	'외국인(재외국민)
		sRCNO = contForeign.edt02.caption
	else									'법인
		sRCNO = contLicens.edt03.caption
	end if
	
	return sRCNO
End Function

'============================================================================
'필수정보 입력 여부 확인
Function ValidatCheck()
	' 20180323 HAMWG : ID입력 자릿수 제한 수정 (6자리->1자리)
	if Len(edtID.caption) < 1 then
		Form.MsgBox( "알림", "접속ID를 입력해 주세요.", "", 6 )
		return False
	end if
	
	if rdoGubn.currentindex == "0" then		'내국인
		if Len(contBirth.edt01.caption) < 6 then
			Form.MsgBox( "알림", "생년월일을 입력해 주세요.", "", 6 )
			return False
		end if
	elseif rdoGubn.currentindex == "1" then	'외국인(재외국민)
		if contForeign.edt02.caption == "" then
			Form.MsgBox( "알림", "실명확인번호를 입력해 주세요.", "", 6 )
			return False
		end if
	else									'법인
		if contLicens.edt03.caption == "" then
			Form.MsgBox( "알림", "사업자등록번호를 입력해 주세요.", "", 6 )
			return False
		end if
	end if
	
	if Len(contBtm.edtAcnt.caption) < 8 then
		Form.MsgBox( "알림", "계좌번호를 입력해 주세요.", "", 6 )
		return False
	end if
	
	'v0001 메모리평문적용인경우에는 4자리만 체크
	if Len(contBtm.edtPW0.caption) < 4 or (g_plain_rm ~= "1" and Len(contBtm.edtPW0.caption) > 8) then
		Form.MsgBox( "알림", "계좌 비밀번호는 4~8자리만 가능합니다.", "", 6 )
		return False
	end if

	return True
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Label2.caption	= "ID찾기 >"
	g_sRetData		= "cancel"
	g_sPopupFileName	= "mhetc90020_pc"
	
	Form.SetScreenName("ID 비밀번호 재설정")
	
	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)

	Call rdoGubn_OnClick(0)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == g_sPopupFileName then
	
		if sRet == "ok" then
			g_sRetData = "ok"
			Form.CloseForm( )
		end if
		
	elseif sKeyName == "mhetc90020_pa" then
		g_ATMT_ISNC_YN = Form.GetSharedData("mhetc90020_pe_ATMT_ISNC_YN",	true)

		'ID자동발급여부
		if g_ATMT_ISNC_YN == "Y" then
			Label3.visible = true
		else
			Label3.visible = false
		end if
		
		edtID.caption = sRet
		
	elseif sKeyName == "mhetc90020_pj" then
		Form.OpenNextPopup("mhetc90024", "", "")
	end if
	
End Sub

'============================================================================
'내국인/외국인/법인 선택에 따른 CONTAINER SWITCH
Sub rdoGubn_OnClick(nIndex)
	contBirth.visible = False
	contForeign.visible = False
	contLicens.visible = False
	
	if nIndex == 0 then		'내국인
		contBirth.visible = True
		contBtm.top = 159
	elseif nIndex == 1 then	'외국인
		contForeign.visible = True
		contBtm.top = 176
	elseif nIndex == 2 then	'법인
		contLicens.visible = True
		contBtm.top = 159
	end if
End Sub

'============================================================================
'취소 버튼
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'다음 버튼
Sub btnOK_OnClick()
	if ValidatCheck() == False then		'필수정보 입력 여부 확인
		Exit Sub
	end if
	
	if g_ATMT_ISNC_YN == "Y" then
		Form.OpenPopup("mhetc90020_pj", "", "")
		Exit Sub
	end if
	
	DATAMANAGER.RequestTranData("obacp_opop_008r")	'고객정보 체크
End Sub

'============================================================================
' ID찾기
Sub Button0_OnClick()
	Form.OpenPopup("mhetc90020_pa", "mhetc90020_pa_ELFN_ID", "")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	'20170828 LES START - UESRID헤더값 세팅
	DATAMANAGER.SetUserID(edtID.caption)
	'20170828 LES END
	
	
	if szTranID = "obacp_opop_008r" then
'		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO", 0, GetRCNO())	'실명확인번호 'v002
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP", 0, GetRCNO())	'실명확인번호 'v002
		'v0001 컨트롤 직접매핑->스크립트로 변경
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD", 0, contBtm.edtPW0.caption)  '계좌비밀번호
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNT_PWD", 0, Form.GetCtlProp( "contBtm.edtPW0", "encdata" ))
		end if
	end if 
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'고객정보 체크
	if szTranID == "obacp_opop_008r" then
		if DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CSNM" , 0) <> "" then
			'20160512 NOHES START 추가 : 요청한 ID에 대한 DN값으로 공인인증서 DN값 셋팅
			If DATAMANAGER.GetDataValue(0, szTranID ,"OutBlock1", "DN_DATA" , 0) <> "" then
				Dim sDN
				sDN = DATAMANAGER.GetDataValue(0, szTranID ,"OutBlock1", "DN_DATA" , 0)
				Form.SetSharedData("CERT_DN" , sDN)
			End If
			'20160512 NOHES END
			Dim sSendData
	
			sSendData = "ChangePswd" + "★"
			sSendData = sSendData + edtID.caption + "★"
			sSendData = sSendData + contBtm.edtAcnt.caption + "★" + contBtm.edtPW0.caption + "★"
	
	
			'20240311 KKM START : 개인/법인 구분하는 값 저장
			Dim sCustCls
			if CInt(rdoGubn.currentindex) == 2 Then 	' 법인인경우
				sCustCls = "2"
			Else								' 개인인 경우
				sCustCls = "1"
			End If			
			Form.SetSharedData("LOGIN_CUST_CLS_CODE", sCustCls)
			'20230803 KKM END
			
			Form.OpenFramePopup( g_sPopupFileName , sSendData , sPosInfo)		
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szErrCode == "0561" or szErrCode == 0561 then
		'인증서 없는 오류는 skip
		sSendData = "ChangePswd" + "★"
		sSendData = sSendData + edtID.caption + "★"
		sSendData = sSendData + contBtm.edtAcnt.caption + "★" + contBtm.edtPW0.caption + "★"

		Form.OpenFramePopup( g_sPopupFileName , sSendData , sPosInfo)
	else	
		sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.MsgBox( "알림", szErrMsg & " " & sSubmsg, "", 0 )
	end if
End Sub

'============================================================================
Sub edtID_OnEditComplete()
	g_ATMT_ISNC_YN = ""
	Label3.visible = false
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
