			<TRAN name="obacp_opop_008r" title="고객정보 체크" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="257" _ulen="193" >

IQRY_CLS_CODE^조회구분코드^1^0^0^0^0^0^0
