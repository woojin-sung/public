'============================================================================
' 화 면 명 : 자주하는질문(FAQ) 메인
'============================================================================

Dim g_szQryClsCode
Dim g_szGrpTypeCode
Dim g_szQryUseCntt

Dim g_nNextIdx
Dim g_nGridIndex

'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.SetMaintainingRatio("1")
	Image1.SetMaintainingRatio("1")
	imgNoData.SetMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Edit0.SetOnOffImage("alpha", "alpha")
	tabType_OnTabChanged(0)

	imgNoData.visible = false
	lblNoData.visible = false
	
	'FAQ 그룹 조회
	Combo0.cbadddatatext = "%`전체"
	DATAMANAGER.RequestTranData("obcpp_cbbs_023r")
End Sub

'============================================================================
Sub tabType_OnTabChanged(nCurrentTab)
	'BEST : 1, 전체 : 2
	if nCurrentTab == 0 then
		Image2.visible = false
		Combo0.visible = false
		imgGubun.visible = false
	
		Image0.left = 140 - 120'20
		Image0.width = 215 + 120
		Image1.left = 145 - 120 	'15
		Edit0.left = 165 - 120
		Edit0.width = 190 + 120
			
		g_szQryClsCode = "1"
		
	else
	
		Image2.visible = true
		Combo0.visible = true
		imgGubun.visible = true
		
		Image0.left = 140
		Image0.width = 215
		Image1.left = 145
		Edit0.left = 165
		Edit0.width = 190
		
		g_szQryClsCode = "2"
	end if
	
	g_nNextIdx = 0
	g_nGridIndex = 0 
	Pannel0.rowcount = 0
	DATAMANAGER.RequestTranData("obcpp_cbbs_020r")
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	g_nNextIdx = 0
	Pannel0.rowcount = 0
	DATAMANAGER.RequestTranData("obcpp_cbbs_020r")
End Sub

'============================================================================
Sub Edit0_OnEditComplete()
	g_nNextIdx = 0
	Pannel0.rowcount = 0
	DATAMANAGER.RequestTranData("obcpp_cbbs_020r")
End Sub

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	if sCellID == "LblQuestion" or sCellID == "imgArrow"  then
		szPropRegID = Pannel0.GetCellValue( "LblRegID", nIndex)	'제안등록ID
		if szPropRegID <> "" and szPropRegID <> null then
			Form.OpenPopup("mbcpp11010_p1" , szPropRegID)	
		end if
	end if
End Sub

'============================================================================
Sub Pannel0_OnScrollEnd()
	szNext = DATAMANAGER.IsMoreNextData("obcpp_cbbs_020r")
	If szNext == "1" Or szNext == True Then
	    DATAMANAGER.RequestNextData("obcpp_cbbs_020r")
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	g_szGrpTypeCode = Combo0.cbkeydata
	g_szQryUseCntt = Edit0.caption

	If szTranID == "obcpp_cbbs_023r" Then
		DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "GRP_TYPE_CODE" , 0 , "%")	'그룹유형코드
		DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "DEL_YN"        , 0 , "N")	'삭제여부
	
	ElseIf szTranID == "obcpp_cbbs_020r" Then
		DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "IQRY_CLS_CODE" , 0 , g_szQryClsCode)	'조회구분코드(1:BEST, 2:전체)
		DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "GRP_TYPE_CODE" , 0 , g_szGrpTypeCode)	'그룹유형코드
		DATAMANAGER.SetDataValue(0 , szTranID, "InBlock1" , "IQRY_USE_CNTT" , 0 , g_szQryUseCntt)	'조회사용내용
	End if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
    If szTranID == "obcpp_cbbs_023r" Then
    
	    iCnt = CDbl(DATAMANAGER.GetDataCount(0 , szTranID , "OutBlock1"))
		for i = 0 to iCnt - 1
		    szTypeCode = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "GRP_TYPE_CODE", i)
		    szTypeName = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "GRP_TYPE_NAME", i)
		    
			Combo0.cbadddatatext = szTypeCode.."`"..szTypeName
		next
'		DATAMANAGER.RequestTranData("obcpp_cbbs_020r")
		
		szNext = DATAMANAGER.IsMoreNextData("obcpp_cbbs_023r")	
		If szNext == "1" Or szNext == True Then
		    DATAMANAGER.RequestNextData("obcpp_cbbs_023r")
		End If
    
		
    ElseIf szTranID == "obcpp_cbbs_020r" Then
		nCnt = CDbl(DATAMANAGER.GetDataCount(0 , szTranID , "OutBlock1"))		
		Pannel0.rowcount = g_nNextIdx + nCnt

		If nCnt = 0 then
			imgNoData.visible = true
			lblNoData.visible = true
			Exit Sub
		Else
			imgNoData.visible = false
			lblNoData.visible = false
		End if
    
		For i = 0 To nCnt - 1
		    szPROP_REG_ID      = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "PROP_REG_ID", i)	'제안등록ID
		    szTITL_NAME        = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "QSTN_TITL_NAME", i)		'제목명

			
			Pannel0.SetCellValue( "LblQuestion", g_nNextIdx + i, szTITL_NAME ) 
			Pannel0.SetCellValue( "LblRegID", g_nNextIdx + i, szPROP_REG_ID ) 
			
			sLength = Form.GetLen(szTITL_NAME)
			sLine = (sLength / 34)	'38
			
			if sLine < 1 then
				sLine = 1
			end if
	
'			'라벨 초기높이 : 40			
'			rowH = 50 + (40 * (sLine - 1)) + 10
'			labelH = sLine * 40 + 10
'			lineT = 50 + (40 * (sLine - 1)) - 1 + 10
'			imageT = (rowH + 10) / 2 - 10	''imageT = rowH / 2 - 10

			'라벨 초기높이 : 32			
			rowH = 42 + (32 * (sLine - 1)) + 10
			labelH = sLine * 32 + 10
			lineT = 42 + (32 * (sLine - 1)) - 1 + 10
			imageT = (rowH + 10) / 2 - 10	''imageT = rowH / 2 - 10

			Pannel0.setPropCardCell("height","Label3" ,g_nNextIdx + i ,labelH)	'Q.
			Pannel0.setPropCardCell("height","LblQuestion" ,g_nNextIdx + i ,labelH)
			Pannel0.SetCardWHAt(g_nNextIdx + i,rowH  )
			Pannel0.setPropCardCell("top","LblLine" ,g_nNextIdx + i ,lineT)
			Pannel0.setPropCardCell("top","imgArrow", g_nNextIdx + i ,imageT)		
			
			g_nGridIndex = CInt(g_nGridIndex) + 1
		Next

		g_nNextIdx = g_nNextIdx + nCnt
		
    End If
    
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    szSubErr = Trim(DATAMANAGER.GetDataMsgSubText( szTranID ))

    If szSubErr == "" Then
        Form.MsgBox( "알림", szErrMsg, "", 6 )		
    Else
        Form.MsgBox( "알림", szErrMsg.."\n("..szSubErr..")", "", 6 )		
    End If
    
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	Form.openPrevScreen()
	'Form.CloseForm()
End Sub

'============================================================================
Sub lblBtn_OnClick()
	Form.OpenScreen("89022" , "")
End Sub

