Sub Form_OnFormInitBefore()
	imgInfo.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
	imgInfo0.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
End Sub

'============================================================================
Sub imgInfo0_OnClick()
	imgInfo0.openToolTip("세금은 보유기간에 따른 이자소득에 대해 \n일반과세 15.4%(소득세14%, 지방소득세1.4%)를 가정하여 산출하였으며 최종 정산금액과 차이가 발생할 수 있습니다.",335,100,2)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("알림", szErrMsg)
End Sub

