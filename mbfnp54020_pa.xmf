	<SCRIPT_INFO _len="4897" _ulen="4463" >
Dim g_tData

'============================================================================
Sub Form_OnFormInit()
	Label0.setNeighbolCtlPos("imgInfo","right",0,"")
	
	Dim tData
	Dim szData
	szData = Form.GetOpenLinkData()
	
	if szData <> "" then
		tData = Split(szData, "★")
	
		if UBound(tData) > 0 then
			g_tData = tData
			
			lblQty.caption = g_tData(4)
			lblPrc.caption = g_tData(5)
			szPrc = lblPrc.caption * 100
			
			lblOrderPrc.caption = szPrc * g_tData(4) / 1000
			lblOrderPrc0.caption = szPrc * g_tData(4) / 1000
			
			Dim szType
			szType = g_tData(6)
			
			if g_tData(4) == "0" then'수량이 0이면
				lblFee.caption = "0"
				lblTax.caption = "0"
				lblLastPrc.caption = "0"
				
				exit sub
			end if
			
			RequestData()
		end if
	else
		exit sub
	end if
End Sub

'============================================================================
' RequestData
'============================================================================
Function RequestData()
	szDate = Form.GetSharedData("&HOST_DATE" , false)
	DATAMANAGER.ClearInputData(0, "obtrs_cntg_812r")
	DATAMANAGER.SetDataValue(0,	"obtrs_cntg_812r", "InBlock1", "ACNO"             , 0, g_tData(0))	' 계좌번호
	DATAMANAGER.SetDataValue(0,	"obtrs_cntg_812r", "InBlock1", "ASNO"             , 0, g_tData(1))	' 계좌일련번호
	DATAMANAGER.SetDataValue(0,	"obtrs_cntg_812r", "InBlock1", "ISCD"             , 0, g_tData(2))	' 종목코드
	DATAMANAGER.SetDataValue(0,	"obtrs_cntg_812r", "InBlock1", "ODER_DATE"        , 0, szDate)		' 주문일자
	DATAMANAGER.SetDataValue(0,	"obtrs_cntg_812r", "InBlock1", "DEAL_CLS_CODE"    , 0, g_tData(3))	' 매매구분코드
	DATAMANAGER.SetDataValue(0,	"obtrs_cntg_812r", "InBlock1", "ODQT"             , 0, g_tData(4))	' 주문수량
	DATAMANAGER.SetDataValue(0,	"obtrs_cntg_812r", "InBlock1", "BOND_ODER_UNPR"   , 0, g_tData(5))	' 주문단가
	DATAMANAGER.SetDataValue(0,	"obtrs_cntg_812r", "InBlock1", "BOND_MKPL_CLS_CODE"    , 0, "01")	' 매매시장구분코드
	DATAMANAGER.SetDataValue(0,	"obtrs_cntg_812r", "InBlock1", "CHAN_TYPE_CLS_CODE", 0, "157")		' 수수료매체그룹코드
	
	DATAMANAGER.SetDataValue(0,	"obtrs_cntg_812r", "InBlock1", "OVRL_SPTX_CLS_CODE", 0, g_tData(7))	' 종합분리과세구분코드
	
	if CInt(g_tData(3)) == 1 then	'매도
		DATAMANAGER.SetDataValue(0,	"obtrs_cntg_812r", "InBlock1", "BYOV_DATE" , 0, g_tData(8))	' 잔고의 매수일자(매도인 경우에만)
	else
		DATAMANAGER.SetDataValue(0,	"obtrs_cntg_812r", "InBlock1", "BYOV_DATE" , 0, "")	' 잔고의 매수일자(매도인 경우에만)
	end if
			
	DATAMANAGER.RequestTranData("obtrs_cntg_812r")
End Function

