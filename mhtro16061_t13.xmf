Dim g_szOdrPop
Dim g_szAfterInit
Dim g_szChangeInit
Dim g_szSellQty, g_szSellQtyCnt 
Dim g_szAfterOrg

Dim g_szCd, g_szMk, g_szNg	' 종목코드, 거래소코드, 국가코드
g_szCd = ""
g_szMk = ""
g_szNg = ""

Dim	g_szWarnFlag			' 주문 경고 확인플래그
g_szWarnFlag	= "N"

Dim g_szTR
g_szTR = ""

Dim g_szTitle
g_szTitle = "안내"

Dim g_szOrdSize		' 매매단위
g_szOrdSize = ""

Dim g_szCurPrice		' 현재가
g_szCurPrice = ""

Dim g_szUpLimit		' 상한가
g_szUpLimit =  ""

Dim g_szDnLimit		' 하한가
g_szDnLimit =  ""

Dim g_szUnit			' 호가단위
g_szUnit =  ""

Dim g_szDecimal		' 종목가격 자릿수
g_szDecimal =  ""

Dim g_szKorName		' 한글종목명
g_szKorName =  ""

Dim g_szTickType		' 종목틱타입
g_szTickType =  ""

Dim g_szCurrency		' 통화
g_szCurrency = ""

Dim gTotalYN			' 통합증거금 약정여부
gTotalYN = false

Dim g_szCashNT		' 통합증거금 조회구분(N:일반 / T:통합)
g_szCashNT = ""

Dim gLoanType			' 대출구분
gLoanType = ""

Dim gLoanDate 		' 대출일자
gLoanDate = ""

Dim gLoanSrno 		' 대출일련번호
gLoanSrno = ""

Dim gReturnQtyPrice	' 미체결 그리드에서 리턴받은 가격/수량이있는지 여부
gReturnQtyPrice = false

Dim gSelectIndex 		' 미체결 그리드에서 선택한 인덱스
gSelectIndex = -1

Dim gOrderReqIndex	' 1:정정/2:취소/3:전체취소 서비스 호출
gOrderReqIndex = -1

Dim gOsType

Dim gOrderAble		'주문 취소가능 여부
gOrderAble = false

