'============================================================================
Sub Form_OnFormInitBefore()

	gOsType = Form.GetSharedData("&OS_TYPE", false)

	imgRefresh.setmaintainingratio("1")
	imgNodata.setmaintainingratio("1")

End Sub
'============================================================================
Sub Form_OnFormInit()
	Form.SetCtlProp("cld0", "addday", "-3")
	
	'--------------------------------------------------
	' 컨트롤 설정
	'--------------------------------------------------
	Grid0.SetUseLoadFast(true) 'iOS전용(체크이미지 변경 속도개선)
	
	szTextSize = Form.GetEnvData("common.textsize")
	
	if CInt(szTextSize) > 0 then '큰글씨
		chkAllCancel.fontsize = - 2 - CInt(szTextSize)
		cld0.fontsize = - 4 - CInt(szTextSize)
		cld1.fontsize = - 4 - CInt(szTextSize)
	end if
	'--------------------------------------------------
	'그리드 타입 설정(디폴트:선택종목 없는 상태)
	'--------------------------------------------------
	ChangeGridType("3")

	'--------------------------------------------------
	' 주문환경설정 값 Load
	'--------------------------------------------------
	Load_OrderSet()
	
	'--------------------------------------------------
	' 미체결 내역 조회
	'--------------------------------------------------
	RequestData()
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'Form.ShowAlert(sEventName, sParam)
	'============================================================================
	' 종목정보 연동
	'============================================================================
	if sEventName == "SEND_ITEM_INFO" then
	
		'-----------------------------------------------------------------------
		'현재가★상한가★하한가★매매단위★통화★소수점자리수★한글종목명★틱타입
		'-----------------------------------------------------------------------
		arrItemInfo = Split(sParam, "★")
		
		g_szCurPrice 	= arrItemInfo(0)
		g_szUpLimit	= arrItemInfo(1)
		g_szDnLimit	= arrItemInfo(2)
		g_szOrdSize 	= arrItemInfo(3)
		g_szCurrency	= arrItemInfo(4)
		g_szDecimal	= arrItemInfo(5)
		g_szKorName	= arrItemInfo(6)
		g_szTickType	= arrItemInfo(7)
		g_szUnit		= GetHogaUnit(g_szMk, g_szCurPrice, 0)
		
		'-----------------------------------------------------------------------
		'종목/탭 변경시 가격입력창/수량입력창 입력값 초기화 
		'-----------------------------------------------------------------------
		if g_szChangeInit == "1" then
			Init_InputControl()
		end if
	
	'============================================================================
	' 종목코드 초기화/종목코드 변경/탭 변경
	'============================================================================
	elseif sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then
		
		if g_szCd <> sParam then
			
			g_szCd = sParam
			g_szNg = Form.GetItemCodeInfo(g_szCd, "ovsnation")	' 국가구분코드
			g_szMk = Form.GetItemCodeInfo(g_szCd, "exchid")		' 거래소벤더코드
			
			'---------------------------------------------------------------------------------
			'환율정보 라벨 클리어(이전 데이터 남아있어 깜빡임 방지)
			'---------------------------------------------------------------------------------
			
			if sEventName == "ChangeTab" then
				
				'---------------------------------------------------------------------------------
				' [금액 자동입력]
				'---------------------------------------------------------------------------------
				' 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅
				' 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
				'---------------------------------------------------------------------------------
				'sPrice = Form.GetSharedData("PRICE", true)
				'
				'if sPrice <> "" and sPrice <> null	then
				'	edtPrc.caption = sPrice
				'	
				'else
				'	
				'	if g_szChangeInit <> "1" then
				'		RequestAutoPrice()
				'	end if
				'
				'end if
				
				'--------------------------------------------------
				' 미체결 내역 조회
				'--------------------------------------------------
				RequestData()
							
			end if
			
		
		else
		
			'---------------------------------------------------------------------------------
			' 정정/취소 탭에 위치한 상태에서 다시 정정/취소 탭 눌렀을때, 
			' 종목코드는 그대로지만 그리드 타입 초기화
			'---------------------------------------------------------------------------------
			if sEventName == "ChangeTab" then
				'전체취소버튼 미체크 상태로 전환
				chkAllCancel.chksilence = "0"
				
				'그리드상태 초기화
				ChangeGridType("3")
				Grid0.SetPropGridCell("alluncheck","bd_cell21",0,"")
				
				'--------------------------------------------------
				' 미체결 내역 조회
				'--------------------------------------------------
				RequestData()
				
			end if
			
		end if

		
	'============================================================================
	' 계좌변경(통합증거금 약정여부 조회 및 입력창 초기화)
	'============================================================================	
	elseif sEventName == "ChangeAcnt" then
		imgRefresh_OnClick()
		
		if g_szChangeInit == "1" then
			Init_InputControl()
		end if
		
	'============================================================================
	' 주문/체결 탭에서 미체결수량이 있는 종목 선택 시 연동
	'============================================================================
	elseif sEventName == "SendMiChegyulItem" then
		
		'----------------------------------------------------------------------------------------
		'Init_InputControl() 		: gReturnQtyPrice가 true 일떄 입력창 클리어안함
		'obtro_oder_103r Complete 	: gbLinkMiCheItem가 true 일때 입력창 클리어 안함.
		'----------------------------------------------------------------------------------------
		'입력창 클리어해주는 부분이 호출되는 시점이 랜덤이라.. 둘다 true로 변환하여
		'입력창이 클리어되지 않고, 주문/체결탭에서 넘어온 미체결종목의 수량/가격이 세팅되게한다.
		'----------------------------------------------------------------------------------------
		gReturnQtyPrice = true
		gbLinkMiCheItem = true
		
		'--------------------------------------------------
		' 미체결 종목정보
		'--------------------------------------------------
		gLinkMiCheItemInfo = sParam	
		
		'--------------------------------------------------
		'전체취소버튼 미체크 상태로 전환
		'--------------------------------------------------
		chkAllCancel.chksilence = "0"
	
		'--------------------------------------------------
		'그리드 체크 모두 해제
		'--------------------------------------------------
		Grid0.SetPropGridCell("alluncheck","bd_cell21",0,"")
		
		'--------------------------------------------------
		' 미체결 내역 조회
		'--------------------------------------------------
		RequestData()
		
	'============================================================================
	' 약정 계좌 > 미약정 계좌로 변경 시 데이터 클리어를 위해 호출
	'============================================================================
	elseif sEventName == "ClearData" then
		
		imgRefresh_OnClick()
		
	'============================================================================
	' 비밀번호 검증 후 주문확인창 자동 오픈
	'============================================================================
	elseif sEventName == "OPEN_CONFIRM" then
		
		if gOrderReqIndex == 2 then
			btnCancel_OnClick()
		elseif gOrderReqIndex == 3 then
			btnAllCancel_OnClick()
		end if
		
	'주문번호 연동 => 원주문번호만으로 주문가능? 주문일자 반드시 넣어줘야하면 무쓸모임
	elseif sEventName == "AFTER_ORGNO" then
		
	end if
	
End Sub


'============================================================================
' (가격)자동입력값 요청
'============================================================================
Function RequestAutoPrice()
	
	Form.triggerEvent("#", "RequestAutoPrice", "MOD")

End Function

'============================================================================
' (가격/수량)입력창 입력값 초기화
'============================================================================
Function Init_InputControl()
	
	if g_szChangeInit == "1" then
		
		'----------------------------------------------------
		' 미체결 그리드에서 종목선택한 경우 gReturnQtyPrice = true
		' gReturnQtyPrice == true인 경우에는 미체결그리드에서 넘어온
		' 미체결수량/주문가격이 입력창에 세팅될 수 있도록 
		' 입력창 클리어해주지 않음.
		'
		' 주문/체결탭에서 종목 선택한 경우 gbLinkMiCheItem = true
		' gbLinkMiCheItem == true인 경우에는 주문/체결탭에서 넘어온
		' 미체결수량/주문가격이 입력창에 세팅될 수 있도록
		' 입력창 클리어해주지 않음.
		'----------------------------------------------------
		if gReturnQtyPrice == true then
			gReturnQtyPrice = false
		
		else
			gReturnQtyPrice = false
		end if
		
	end if
	
End Function

'============================================================================
' 거래소 호가단위 설정
'============================================================================
Function GetHogaUnit(szMk, szPrc, nGbn) 
	
	'-----------------------------------------------------------------------
	' 호가단위 초기화
	'-----------------------------------------------------------------------
	szOrdPrc = CDbl(szPrc)
	
	if szOrdPrc == "" then
		if g_szCurPrice = "" or CDbl(g_szCurPrice) == 0 then
			szOrdPrc = 0		
		else
			szOrdPrc = CDbl(g_szCurPrice)
		end if	
	end if
	
	szUnit = "1.000"
	
	'-----------------------------------------------------------------------
	' 틱타입 확인
	'-----------------------------------------------------------------------
	szTtype = Cint(g_szTickType)

	if szTtype == 0 or szTtype == "" then
		szTtype = "0"
	end if
	
	'-----------------------------------------------------------------------
	' 중국(상해/심천) 호가단위 설정
	'-----------------------------------------------------------------------
	if szMk == "0215" then '상해
		szUnit = "0.010"
		
	elseif szMk == "0214" then '심천
		szUnit = "0.010"
		
	'-----------------------------------------------------------------------
	' 미국(뉴욕/나스닥/아멕스) 호가단위 설정
	'-----------------------------------------------------------------------
	elseif szMk == "0321" or szMk == "0537" or szMk == "0066" then '뉴욕, 나스닥, 아멕스
		if szTtype == 1 then
			szUnit = "0.010"
			
		elseif szTtype == 2 then
			szUnit = "0.050"
			
		elseif szTtype == 3 then
			szUnit = "0.050"
			
		elseif szTtype == 4 then
			szUnit = "0.050"
			
		else
			szUnit = "0.010"
		end if
	
	'-----------------------------------------------------------------------
	' 홍콩 호가단위 설정, (홍콩ETF종목 호가단위 변경)
	'-----------------------------------------------------------------------
	elseif szMk == "0104" then '홍콩
		
		if szTtype == 3 then
			szUnit = "0.050"
			
		'홍콩 ETF종목 호가단위 변경
		'type = 5 (ETF종목) 추가
		elseif szTtype == 5 then
			
			if nGbn == 0 then
				if szOrdPrc < 1.00 then
					szUnit = "0.001"
				elseif szOrdPrc < 5.00 then
					szUnit = "0.002"
				elseif szOrdPrc < 10.00 then
					szUnit = "0.005"
				elseif szOrdPrc < 20.00 then
					szUnit = "0.010"
				elseif szOrdPrc < 100.00 then
					szUnit = "0.020"
				elseif szOrdPrc < 200.00 then
					szUnit = "0.050"
				elseif szOrdPrc < 500.00 then
					szUnit = "0.100"
				elseif szOrdPrc < 1000.00 then
					szUnit = "0.200"
				elseif szOrdPrc < 2000.00 then
					szUnit = "0.500"
				else
					szUnit = "1.000"
				end if
			
			else
				if szOrdPrc <= 1.00 then
					szUnit = "0.001"
				elseif szOrdPrc <= 5.00 then
					szUnit = "0.002"
				elseif szOrdPrc <= 10.00 then
					szUnit = "0.005"
				elseif szOrdPrc <= 20.00 then
					szUnit = "0.010"
				elseif szOrdPrc <= 100.00 then
					szUnit = "0.020"
				elseif szOrdPrc <= 200.00 then
					szUnit = "0.050"
				elseif szOrdPrc <= 500.00 then
					szUnit = "0.100"
				elseif szOrdPrc <= 1000.00 then
					szUnit = "0.200"
				elseif szOrdPrc <= 2000.00 then
					szUnit = "0.500"
				else
					szUnit = "1.000"
				end if
			
			end if
		
		else
			if nGbn == 0 then
				if szOrdPrc < 0.25 then
					szUnit = "0.001"
		
				elseif szOrdPrc < 0.50 then
					szUnit = "0.005"
		
				elseif szOrdPrc < 10.00 then
					szUnit = "0.010"
		
				elseif szOrdPrc < 20.00 then	
					szUnit = "0.020"
		
				elseif szOrdPrc < 100.00 then
					szUnit = "0.050"
					
				elseif szOrdPrc < 200.00 then
					szUnit = "0.100"
		
				elseif szOrdPrc < 500.00 then
					szUnit = "0.200"
		
				elseif szOrdPrc < 1000.00 then
					szUnit = "0.500"
		
				elseif szOrdPrc < 2000.00 then
					szUnit = "1.000"
		
				elseif szOrdPrc < 5000.00 then
					szUnit = "2.000"
		
				else 
					szUnit = "5.000"
		
				end if
			else
				if szOrdPrc <= 0.25 then
					szUnit = "0.001"
		
				elseif szOrdPrc <= 0.50 then
					szUnit = "0.005"
		
				elseif szOrdPrc <= 10.00 then
					szUnit = "0.010"
		
				elseif szOrdPrc <= 20.00 then	
					szUnit = "0.020"
		
				elseif szOrdPrc <= 100.00 then
					szUnit = "0.050"
					
				elseif szOrdPrc <= 200.00 then
					szUnit = "0.100"
		
				elseif szOrdPrc <= 500.00 then
					szUnit = "0.200"
		
				elseif szOrdPrc <= 1000.00 then
					szUnit = "0.500"
		
				elseif szOrdPrc <= 2000.00 then
					szUnit = "1.000"
		
				elseif szOrdPrc <= 5000.00 then
					szUnit = "2.000"
		
				else
					szUnit = "5.000"
		
				end if
			
			end if
			
		end if
	
	'-----------------------------------------------------------------------
	' 해외주식 일본시장(도쿄거래소) 추가
	'-----------------------------------------------------------------------
	elseif szMk == "0106" then '도쿄
		if szTtype == 3 then
			if nGbn == 0 then
				if szOrdPrc < 1000 then
					szUnit = "0.1"
		
				elseif szOrdPrc < 3000 then
					szUnit = "0.5"
		
				elseif szOrdPrc < 5000 then
					szUnit = "1"
		
				elseif szOrdPrc < 10000 then	
					szUnit = "1"
		
				elseif szOrdPrc < 30000 then
					szUnit = "5"
					
				elseif szOrdPrc < 50000 then
					szUnit = "10"
		
				elseif szOrdPrc < 100000 then
					szUnit = "10"
		
				elseif szOrdPrc < 300000 then
					szUnit = "50"
		
				elseif szOrdPrc < 500000 then
					szUnit = "100"
		
				elseif szOrdPrc < 1000000 then
					szUnit = "100"
				
				elseif szOrdPrc < 3000000 then
					szUnit = "500"
					
				elseif szOrdPrc < 5000000 then
					szUnit = "1000"
					
				elseif szOrdPrc < 10000000 then
					szUnit = "1000"
					
				elseif szOrdPrc < 30000000 then
					szUnit = "5000"
		
				else 
					szUnit = "10000"
		
				end if
			else
				if szOrdPrc <= 1000 then
					szUnit = "0.1"
		
				elseif szOrdPrc <= 3000 then
					szUnit = "0.5"
		
				elseif szOrdPrc <= 5000 then
					szUnit = "1"
		
				elseif szOrdPrc <= 10000 then	
					szUnit = "1"
		
				elseif szOrdPrc <= 30000 then
					szUnit = "5"
					
				elseif szOrdPrc <= 50000 then
					szUnit = "10"
		
				elseif szOrdPrc <= 100000 then
					szUnit = "10"
		
				elseif szOrdPrc <= 300000 then
					szUnit = "50"
		
				elseif szOrdPrc <= 500000 then
					szUnit = "100"
		
				elseif szOrdPrc <= 1000000 then
					szUnit = "100"
		
				elseif szOrdPrc <= 3000000 then
					szUnit = "500"
					
				elseif szOrdPrc <= 5000000 then
					szUnit = "1000"
					
				elseif szOrdPrc <= 10000000 then
					szUnit = "1000"
					
				elseif szOrdPrc <= 30000000 then
					szUnit = "5000"
		
				else 
					szUnit = "10000"
		
				end if
			
			end if	
		else
			if nGbn == 0 then
				if szOrdPrc < 1000 then
					szUnit = "1"
		
				elseif szOrdPrc < 3000 then
					szUnit = "1"
		
				elseif szOrdPrc < 5000 then
					szUnit = "5"
		
				elseif szOrdPrc < 10000 then	
					szUnit = "10"
		
				elseif szOrdPrc < 30000 then
					szUnit = "10"
					
				elseif szOrdPrc < 50000 then
					szUnit = "50"
		
				elseif szOrdPrc < 100000 then
					szUnit = "100"
		
				elseif szOrdPrc < 300000 then
					szUnit = "100"
		
				elseif szOrdPrc < 500000 then
					szUnit = "500"
		
				elseif szOrdPrc < 1000000 then
					szUnit = "1000"
				
				elseif szOrdPrc < 3000000 then
					szUnit = "1000"
					
				elseif szOrdPrc < 5000000 then
					szUnit = "5000"
					
				elseif szOrdPrc < 10000000 then
					szUnit = "10000"
					
				elseif szOrdPrc < 30000000 then
					szUnit = "10000"
		
				else 
					szUnit = "50000"
		
				end if
			else
				if szOrdPrc <= 1000 then
					szUnit = "1"
		
				elseif szOrdPrc <= 3000 then
					szUnit = "1"
		
				elseif szOrdPrc <= 5000 then
					szUnit = "5"
		
				elseif szOrdPrc <= 10000 then	
					szUnit = "10"
		
				elseif szOrdPrc <= 30000 then
					szUnit = "10"
					
				elseif szOrdPrc <= 50000 then
					szUnit = "50"
		
				elseif szOrdPrc <= 100000 then
					szUnit = "100"
		
				elseif szOrdPrc <= 300000 then
					szUnit = "100"
		
				elseif szOrdPrc <= 500000 then
					szUnit = "500"
		
				elseif szOrdPrc <= 1000000 then
					szUnit = "1000"
				
				elseif szOrdPrc <= 3000000 then
					szUnit = "1000"
					
				elseif szOrdPrc <= 5000000 then
					szUnit = "5000"
					
				elseif szOrdPrc <= 10000000 then
					szUnit = "10000"
					
				elseif szOrdPrc <= 30000000 then
					szUnit = "10000"
		
				else 
					szUnit = "50000"
				end if
			
			end if
		
		end if
	
	end if
	
	return szUnit
	
End Function


'============================================================================
' (공통) 주문 환경설정값 적용
'============================================================================
Function Load_OrderSet()
	
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력
	
	g_szSellQty     = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTY")		' 매도수량 자동입력(0:미사용, 1:현금가능수량, 2:최대가능수량(미수포함), 3:수량입력
	g_szSellQtyCnt  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTYCNT")	' 매도수량 주수(수량입력 선택시)
	
	'--------------------------------------------
	' 주문확인창(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	'--------------------------------------------
	' 주문전송 후 초기화(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'--------------------------------------------
	'종목/탭 변경시 초기화 사용을 초기값으로 설정
	'종목/탭 변경시 초기화(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	

	'--------------------------------------------
	' 원주문번호 자동입력(기본값 : 사용)
	'--------------------------------------------
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	'--------------------------------------------
	' 매수수량 자동입력(기본값 : 사용하지 않음)
	'--------------------------------------------
	if Trim(g_szSellQty) = "" then
		g_szSellQty = "0"		
	end if
	
End Function


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	'----------------------------------------------------------
	'취소 주문용
	'----------------------------------------------------------
	if szTranID == "obtro_oder_113a" then
		
		g_szTR = szTranID
		
		nSelectIndex = GetCheckIndex()
		
		szOrdDate = Grid0.GetCellData("bd_cell1", nSelectIndex)
		szOrdOrgnNo = Grid0.GetCellData("bd_cell11", nSelectIndex)
		
		szAcno = Form.GetTopCtlProp("acnt", "total")
		szAsno = Form.GetTopCtlProp("acnt", "sequence")
		szAcpw = Form.GetTopCtlProp("edtPwd", "caption")
		
		DATAMANAGER.ClearInputData(0, "obtro_oder_113a")
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_113a", "InBlock1", "ACNO"					, 0, szAcno)		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtro_oder_113a", "InBlock1", "ASNO"					, 0, szAsno)		' 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, "obtro_oder_113a", "InBlock1", "ACNT_PWD"				, 0, szAcpw)		' 계좌 비밀번호
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_113a", "InBlock1", "ODER_RSEV_MST_DATE"		, 0, szOrdDate)	' 주문예약마스터일자
		DATAMANAGER.SetDataValue(0, "obtro_oder_113a", "InBlock1", "ODER_RSEV_MST_NO"			, 0, szOrdOrgnNo)	' 주문예약마스터번호
		
	end if
	
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'==========================================================================
	' 취소 주문용(113a)
	'==========================================================================
	if szTranID == "obtro_oder_113a" then
	
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0) '경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
	
		'--------------------------------
		' 경고
		'--------------------------------
		if szWarnCd = "1" then							
		
			Open_ConfirmPopup(szWarnMsg)
		
		'--------------------------------
		' 보류(해외주식 제외)
		'--------------------------------
		elseif szWarnCd = "2" then						'
			
			g_szTR = ""
		
		'--------------------------------
		' 정상주문 처리
		'--------------------------------
		else
		
			g_szTR = ""
				
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
	
			'-----------------------------
			' 정상주문
			'-----------------------------
			
			if Trim(szOrdCd) == "0000" then			
				
				'-----------------------------
				' 주문처리 메시지 출력
				'-----------------------------
				Form.Toast(0, szOrdMsg, true)
				
				'-----------------------------
				' 주문후 초기화
				'-----------------------------
				if g_szAfterInit == "1" then		
					Init_InputControl()
				end if
				
				'-----------------------------
				' 주문번호 연동
				'-----------------------------
				if g_szAfterOrg == "1" then			
					szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
					Form.triggerEvent("#", "AfterOrd", szOrgNo)
				end if
				
				'-----------------------------
				' 정정/취소 주문 후 미체결내역 재조회
				'-----------------------------
				Form.SetTimerEvent2(1, 1, 0.5)
				'imgRefresh_OnClick()
					
			end if
			
		end if
		
	
	'==========================================================================
	' 일괄취소 주문용(113a_1)
	'==========================================================================
	elseif szTranID == "obtro_oder_113a_1" then
	
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0) '경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
		
		'--------------------------------
		' 경고
		'--------------------------------
		if szWarnCd = "1" then							
		
			Open_ConfirmPopup(szWarnMsg)
		
		'--------------------------------
		' 보류(해외주식 제외)
		'--------------------------------
		elseif szWarnCd = "2" then						'
			
			g_szTR = ""
			
		'--------------------------------
		' 정상주문 처리
		'--------------------------------
		else
		
			g_szTR = ""
			
			'----------------------------------
			'남은 주문건수 -1
			'----------------------------------
			gRemainItemCnt = gRemainItemCnt - 1
			
			'----------------------------------
			'남은 건수가 0건이면 주문완료
			'----------------------------------
			if gRemainItemCnt == 0 then
			
				'--------------------------------------
				'주문전송에 실패한 건수가 있는지 체크
				'--------------------------------------
				
				'실패건수가 없을 때
				if gOrdFailItemCnt == 0 then
					Form.ShowAlert("알림", "주문이 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
				
				'모두 실패했을 때
				elseif gCanCelItemCnt == gOrdFailItemCnt then
					Form.ShowAlert("알림", "취소가 불가합니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
				
				'일부만 실패했을 때
				else
					Form.ShowAlert("알림", "주문이 일부만 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
				end if
				
				gCanCelItemCnt = -1
				gOrdFailItemCnt = 0
				gOrderIndex  = 0
				gCanCelFirstItem = true
				
				'--------------------------------------
				' 일괄취소 후 미체결내역 재조회
				'--------------------------------------
				Form.SetTimerEvent2(1, 1, 0.5)
				'imgRefresh_OnClick()
				
				
			else
			
				Request_OrderAllCancel()
			
			end if
			
		
		end if

	'==========================================================================
	' 미체결내역 조회
	'==========================================================================
	elseif szTranID == "obtro_oder_114r" then
		
		if DATAMANAGER.IsMoreNextData("obtro_oder_114r") then
			DATAMANAGER.RequestNextData("obtro_oder_114r")
		else
			
			nDataCnt = Cint(Grid0.rowcount)
			
			if nDataCnt == 0 then
				
				'데이터없음 이미지/라벨 표시
				imgNodata.left = 162
				lblNodata.left = 0
				imgNodata.visible = true
				lblNodata.visible = true
				
				'호가테이블 숨기기
				ChangeGridType("3")
				
				'전체취소버튼 비활성화
				chkAllCancel.enable = false
				
			else
				imgNodata.left = 500
				lblNodata.left = 500
				imgNodata.visible = false
				lblNodata.visible = false
				
				'전체취소버튼 활성화
				chkAllCancel.enable = true
				
			end if
		
			'------------------------------------------------------------
			' 종목명 최대라인수 설정
			'------------------------------------------------------------
			Grid0.SetCellMaxLineCount("bd_cell26",2)
			Grid0.SetCellMaxLineCount("bd_cell25",2)
			
			for i = 0 to Grid0.rowcount - 1
			
				'------------------------------------------------------------
				' 현금/대출 구분
				'------------------------------------------------------------
				sCashCredit = Grid0.GetCellData("bd_loantype", i)

				if sCashCredit == "0251" then
					Grid0.SetCellData("bd_cell24", i, "대출")
					Grid0.SetCellData("bd_cell240", i, "대출")
				else
					Grid0.SetCellData("bd_cell24", i, "현금")
					Grid0.SetCellData("bd_cell240", i, "현금")
				end if
				
				'------------------------------------------------------------
				'매매구분
				'------------------------------------------------------------
				szType    = Grid0.GetCellData( "bd_cell6"	, i)	'매매구분
				Select Case szType
					Case "1"	
						Grid0.SetCellFgColor( "bd_cell2", i, "2" )
						Grid0.SetCellFgColor( "bd_cell20", i, "2" )
						szGubun = Grid0.GetCellData("bd_cell15", i)
						
						if szGubun = "0251" then
							Grid0.SetCellData( "bd_cell2", i, "예탁담보매도" )
							Grid0.SetCellData( "bd_cell20", i, "예탁담보매도" )
						else
							Grid0.SetCellData( "bd_cell2", i, "매도" )
							Grid0.SetCellData( "bd_cell20", i, "매도" )
						end if
					Case "2"	
						Grid0.SetCellFgColor( "bd_cell2", i, "1" )
						Grid0.SetCellFgColor( "bd_cell20", i, "1" )
						Grid0.SetCellData( "bd_cell2", i, "매수")
						Grid0.SetCellData( "bd_cell20", i, "매수")
				End Select
				
				'------------------------------------------------------------
				'주문예약구분코드
				'------------------------------------------------------------
				rSevType  = Grid0.GetCellData( "bd_cell8"	, i)
				Select Case rSevType 
					Case "1"
						Grid0.SetCellData( "bd_cell8", i, "일반예약")
					Case "2" 
						Grid0.SetCellData( "bd_cell8", i, "기간잔량")
					Case "3" 
						Grid0.SetCellData( "bd_cell8", i, "기간예약")
					Case "4" 
						Grid0.SetCellData( "bd_cell8", i, "특정일주문")
				End Select
				
				'------------------------------------------------------------
				'주문예약시간구분코드
				'------------------------------------------------------------
				hOurType  = Grid0.GetCellData( "bd_cell18", i)	'주문예약시간구분코드
				Select Case hOurType
				Case "0"
					Grid0.SetCellData( "bd_cell18", i, "장개시")
				Case "1" 
					Grid0.SetCellData( "bd_cell18", i, "장마감10분전")
				Case "2" 
					Grid0.SetCellData( "bd_cell18", i, "장마감30분전")
				Case "3" 
					Grid0.SetCellData( "bd_cell18", i, "장개시30분후")
				End Select
				
				'------------------------------------------------------------
				'시장구분
				'------------------------------------------------------------
				sCountryCode = Grid0.GetCellData("bd_mrktcode", i)
				sVndrCode = Grid0.GetCellData("bd_vndrcode", i)
				sCountryName = GetCountryNameByCode(sCountryCode,sVndrCode)
				Grid0.SetCellData("bd_marketgubun", i, sCountryName)
				
				'------------------------------------------------------------
				'주문구분
				'------------------------------------------------------------
				sOrderCode = Grid0.GetCellData("bd_cell22", i)
				sOrderName = GetOrderNameByCode(sOrderCode)
				Grid0.SetCellData("bd_cell12", i, sOrderName)
				
				'------------------------------------------------------------
				'주문구분
				'------------------------------------------------------------
				szAble = Trim(Grid0.GetCellData("bd_able", i))	'주문 취소가능여부: Y/N
				if szAble = "N" then
					Grid0.setCellEnable("bd_cell21", i, "0")
				end if
			
			next
		end if
	end if
	
	'해외주식 주문착오 방지
	g_szWarnFlag = "N"	
	
End Sub

'============================================================================
' 서비스 오류처리
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szTranID == "obtro_oder_113a_1" then
	
		
		g_szTR = ""
			
		'----------------------------------
		'남은 주문건수 -1
		'----------------------------------
		gRemainItemCnt = gRemainItemCnt - 1
		gOrdFailItemCnt = gOrdFailItemCnt + 1
		
		'----------------------------------
		'남은 건수가 0건이면 주문완료
		'----------------------------------
		if gRemainItemCnt == 0 then
		
			'--------------------------------------
			'주문전송에 실패한 건수가 있는지 체크
			'--------------------------------------
			
			'실패건수가 없을 때
			if gOrdFailItemCnt == 0 then
				Form.ShowAlert("알림", "주문이 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
			
			'모두 실패했을 때
			elseif gCanCelItemCnt == gOrdFailItemCnt then
				Form.ShowAlert("알림", "취소가 불가합니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
			
			'일부만 실패했을 때
			else
				Form.ShowAlert("알림", "주문이 일부만 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
			end if
			
			gCanCelItemCnt = -1
			gOrdFailItemCnt = 0
			gOrderIndex  = 0
			gCanCelFirstItem = true
			
			'--------------------------------------
			' 일괄취소 후 미체결내역 재조회
			'--------------------------------------
			Form.SetTimerEvent2(1, 1, 0.5)
			'imgRefresh_OnClick()
			
		else
		
			Request_OrderAllCancel()
		
		end if
	
	
	else
		
'		'------------------------------------------------------------------
'		' 해외ETP 미약정 고객
'		'------------------------------------------------------------------
'		if szErrCode == "6207" then
'			
'			Form.MsgBox("안내", "해외ETP 거래 미신청 계좌 입니다.\n해당 화면으로 이동하시겠습니까?", "ETP_MSG", 7, "거래신청하기","취소")
'		
'		'------------------------------------------------------------------
'		' 대출주문 대출일자/대출일련번호 미입력 시
'		'------------------------------------------------------------------
'		elseif szErrCode == "1256" or szErrCode == "1258" then
'			
'			Form.ShowAlert("안내", "대출일자 선택 후 주문이 가능해요.\n잔고에서 매도할 종목 선택 후 매도를 진행해주세요.")
		
		'------------------------------------------------------------------
		' 그외
		'------------------------------------------------------------------
'		else
			if Trim(szSubMsg) <> "" then
				Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
			else
				Form.ShowAlert(g_szTitle, szErrMsg)
			end if
		end if
		
'	end if
	
End Sub

'============================================================================
' 메시지박스 리턴
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

	if sKeyName == "ETP_MSG" then
		
		if sRet == "ok" then
			Form.OpenScreen("87051" , "")
		end if
	
	end if
	
End Sub

'============================================================================
' 취소버튼 클릭
'============================================================================
Sub btnCancel_OnClick()

	gOrderReqIndex = 2
	
	if Check_InputData("Order") == true then
		
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup("")
		else
			Request_Order()
		end if
		
	end if

	
	
End Sub

'============================================================================
' 전체취소 버튼
'============================================================================
Sub btnAllCancel_OnClick()

	gOrderReqIndex = 3
	
	if Check_InputData("ALL_CANCEL") == true then
		
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup("")
		else
			Request_OrderAllCancel()
		end if
		
	end if
	
End Sub

'============================================================================
' 주문전송 전 입력값 정합성 검증
'============================================================================
Function Check_InputData(sGubun)
	
	if sGubun == "Order" then
		
		'-----------------------------------------------------------------
		'계좌번호
		'-----------------------------------------------------------------
		szAcnt = Form.GetTopCtlProp("acnt", "caption")
		If Len(szAcnt) < 10 Then
			Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
			return False
		End If
		
		'-----------------------------------------------------------------
		'계좌비밀번호
		'-----------------------------------------------------------------
		szPwd = Form.GetTopCtlProp("edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.triggerEvent("#", "ShowPasswordKeyPad", "")
			return False
		end if
		
		'-----------------------------------------------------------------
		'종목코드
		'-----------------------------------------------------------------
		if Trim(g_szCd) == "" then
			Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
			return false
		end if
	
		return true
		
	elseif sGubun == "ALL_CANCEL" then
	
		nCheckNum = GetCheckNum()
		
		if nCheckNum > 0 then
			return true
		else
			Form.MsgBox("안내", "일괄취소할 주문을 선택해주세요.", "CHECK_ALL_CANCEL", 6)
			return false
		end if
		
	end if
	
End Function

'============================================================================
' 주문확인창/경고팝업 오픈
'============================================================================
Function Open_ConfirmPopup(szWarn)
	
	Dim szData, szOrdNm, szOrdGubun,szPrcOrd
	'--------------------------------------------------
	'취소
	'--------------------------------------------------
	if gOrderReqIndex == 2 then
	
		'선택행
		nRowIdx = GetCheckIndex()
		
	    ' 주문구분
		szOrdType    = Grid0.GetCellData( "bd_cell6"	, nRowIdx)
		' 계좌번호, 계좌명
		szAcctNo 	= Form.GetTopCtlProp("acnt", "caption")
		szAcctName 	= Form.GetTopCtlProp("acnt", "accountname")
	
		' 종목코드확인   
		g_szItmCode 	= Grid0.GetCellData("bd_cell3", nRowIdx)
	
		' 예약주문번호  
		g_szOrdNo = Grid0.GetCellData("bd_cell11", nRowIdx)		
	
		' 예약등록일자
		g_szDate = Grid0.GetCellData( "bd_cell1", nRowIdx)
		
		' 종목명
		szItmName = Grid0.GetCellData("bd_cell13", nRowIdx)
	
		' 잔량전부(취소주문은 잔량 전부)
		g_szOrd_ChkAll = "Y"
	
		'주문유형명
		szOrdNm = Grid0.GetCellData("bd_cell12", nRowIdx)
		
		'주문수량
		szOrdQty = Grid0.GetCellData("bd_cell14", nRowIdx)
		
		'주문가격
		szOrdPrc = Grid0.GetCellData("bd_cell4", nRowIdx)
	
		'현금/대출구분(선택행의 대출상세유형 코드로 구분)
		szLoanType = Grid0.GetCellData("bd_loantype", nRowIdx)
		szLoanDate = Grid0.GetCellData("bd_loandate", nRowIdx)
		szLoanSrno = Grid0.GetCellData("bd_loansrno", nRowIdx)
		
		if szLoanType == "0251" then
			szOrdGubun = "1"
		else
			szOrdGubun = "0"
		end if
		
		'주문데이터    
		szData = szOrdType													' 매수/매도
		szData = szData & "|" & Form.GetTopCtlProp("acnt", "caption")		' 계좌번호
		szData = szData & "|" & Form.GetTopCtlProp("acnt", "accountname")	' 계좌명
		szData = szData & "|" & g_szItmCode								' 종목코드
		szData = szData & "|" & szItmName								' 종목명
		szData = szData & "|" & szOrdNm									' 주문구분
		szData = szData & "|" & szOrdGubun								' 현금(0:현금/1:대출)
		szData = szData & "|" & szOrdQty								' 주문수량
		szData = szData & "|" & szOrdPrc								' 주문가격
		szData = szData & "|" & g_szOrdNo								' 원주문번호
		szData = szData & "|" & g_szOrd_ChkAll							' 잔량전부
		szData = szData & "|" & g_szDecimal								' 가격자릿수
		szData = szData & "|" & g_szCurrency							' 통화기호
		szData = szData & "|" & szOrdNm									' 시장가or지정가
			
		'대출관련 추가 정보
		szData = szData & "|" & szLoanType 								' 대출구분
		szData = szData & "|" & szLoanDate 								' 대출일자
		szData = szData & "|" & szLoanSrno 								' 대출일련번호
    
	
	'--------------------------------------------------
	' 전체취소
	'--------------------------------------------------
	elseif gOrderReqIndex == 3 then

		szData = Form.GetTopCtlProp("acnt", "caption")					' 계좌번호
		szData = szData & "|" & Form.GetTopCtlProp("acnt", "accountname")	' 계좌명
		
		nGridRowCnt = Cint(Grid0.rowcount)
		nCheckNum = Cint(GetCheckNum())
		
		szData = szData & "|" & nCheckNum								' 선택건수
		
		if nGridRowCnt == nCheckNum then
			szData = szData & "|" & "Y" & "|"							' 선택건수가 전체선택인지 여부
		else
			szData = szData & "|" & "N" & "|"
		end if
	
	end if

	'----------------------------------------------------
	' 경고팝업 오픈 (취소는 경고팝업 안뜸)
	'----------------------------------------------------
	if Trim(szWarn) <> "" then		
		
		'경고메세지 추가	
		szData = szData & "|" & szWarn			
		Form.OpenPopupAnimation("mhtro16100_p8", szData , "", "2")
	
	'----------------------------------------------------
	' 주문확인팝업 오픈
	'----------------------------------------------------
	else							
		
		'gOrderReqIndex => 1:정정/2:취소/3:전체취소 서비스 호출
		if gOrderReqIndex == 2 then
			Form.OpenPopupAnimation("mhtro16061_p6", szData , "", "2")
		elseif gOrderReqIndex == 3 then
			Form.OpenPopupAnimation("mhtro16061_p7", szData , "", "2")
		end if
		
	end if
	
End Function

'============================================================================
' 주문전송
'============================================================================
Function Request_Order()
	
	'------------------------
	' 해외주식 주문착오 방지
	'------------------------
	g_szWarnFlag	= "N"
	
	'----------------------------------
	' 주문서비스 호출
	'----------------------------------
	DATAMANAGER.RequestTranData("obtro_oder_113a")
	
End Function

'============================================================================
' 전체취소 주문전송
'============================================================================
Function Request_OrderAllCancel()

	'--------------------------------------------
	' 주문나갈 행 인덱스
	'--------------------------------------------
	Dim szIdx
	szIdx = "" 
	
	'--------------------------------------------
	'gCanCelItemCnt : 주문이 나가야되는 전체건수
	'gRemainItemCnt : 주문이 나가고 남은 건수
	'--------------------------------------------
	if gCanCelItemCnt < 0 then
		gCanCelItemCnt = GetCheckNum()
		gRemainItemCnt = gCanCelItemCnt
		gOrderIndex = 0
		gCanCelFirstItem = true
	end if
	
	
	'----------------------------------------------
	' 첫번째 주문은 0번째 행부터 서칭
	'----------------------------------------------
	if gCanCelFirstItem == true then
		
		for i = gOrderIndex to Cint(Grid0.rowcount) - 1
			
			szChk = Cint(Grid0.GetCellData("bd_cell21", i))
			
			if szChk == 1 then
				szIdx = i
				gOrderIndex  = szIdx
				gCanCelFirstItem = false
				exit for
			end if
			
		next
	
	'----------------------------------------------
	' 두번째 주문부터는 직전 인덱스 다음부터 서칭
	'----------------------------------------------
	else
		
		for i = gOrderIndex + 1 to Cint(Grid0.rowcount) - 1
			
			szChk = Cint(Grid0.GetCellData("bd_cell21", i))
			
			if szChk == 1 then
				szIdx = i
				gOrderIndex  = szIdx
				exit for
			end if
		
		next
	
	end if
	
	
	'----------------------------------------------
	' 주문나갈 종목 정보가져오기
	'----------------------------------------------
	if gOrderIndex  <> "" then
		
		nGridLastIndex = Cint(Grid0.rowcount) - 1
		
		if gOrderIndex <= nGridLastIndex then
			
			'Form.ShowAlert("TEST", "(예정)총 주문건수 : " .. gCanCelItemCnt .."\n".. "주문전송행 : "..gOrderIndex.."\n".. "남은 건수 : " .. gRemainItemCnt .."\n".. "실패건수 : "..gOrdFailItemCnt)
			
			g_szTR = "obtro_oder_113a_1"
		
			szOrdDate = Grid0.GetCellData("bd_cell1", gOrderIndex)
			szOrdOrgnNo = Grid0.GetCellData("bd_cell11", gOrderIndex)
			szModeCancelType = "2" 
			
			szAcno = Form.GetTopCtlProp("acnt", "total")
			szAsno = Form.GetTopCtlProp("acnt", "sequence")
			szAcpw = Form.GetTopCtlProp("edtPwd", "caption")
	
			DATAMANAGER.ClearInputData(0, "obtro_oder_113a_1")
	
			DATAMANAGER.SetDataValue(0, "obtro_oder_113a_1", "InBlock1", "ACNO"					, 0, szAcno)		' 계좌번호(8)
			DATAMANAGER.SetDataValue(0, "obtro_oder_113a_1", "InBlock1", "ASNO"					, 0, szAsno)		' 계좌일련번호(2)
			DATAMANAGER.SetDataValue(0, "obtro_oder_113a_1", "InBlock1", "ACNT_PWD"				, 0, szAcpw)		' 계좌 비밀번호
			
			DATAMANAGER.SetDataValue( 0, "obtro_oder_113a_1", "InBlock1", "ODER_RSEV_MST_DATE"	, 0 , szOrdDate	)	' 주문예약마스터일자(8) - 2019.10.14
			DATAMANAGER.SetDataValue( 0, "obtro_oder_113a_1", "InBlock1", "ODER_RSEV_MST_NO"		, 0 , szOrdOrgnNo	)	' 주문예약마스터번호
			
			DATAMANAGER.RequestTranData("obtro_oder_113a_1")
			
		end if
	
	end if
	
	
	
End Function 

'============================================================================
' 팝업창 리턴처리
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	' ----------------------------------------------------------------------
	' (사용)해외주식 주문착오 방지 (경고팝업에서 리턴)
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end if	
	
	' ----------------------------------------------------------------------
	' (사용)PTP경고팝업에서 리턴 (20221206_01 KBC START : 해외주식 미국PTP 종목과세관련)
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PTP주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end if		
	
	' ----------------------------------------------------------------------
	' (사용)주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end if
		
	'----------------------------------------------------------------------
	' (사용) 전체취소 주문확인창에서 리턴
	'----------------------------------------------------------------------
	elseif sKeyName == "전체취소주문전송" then
		if sRet == "1" then
			Request_OrderAllCancel()
		end if
			
	end if
	
End Sub


'============================================================================
' 거래소코드(4자리) <- 거래명(2자리)
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "0104" then	  ' 홍콩
		return "HK"
	elseif sValue == "0215" then ' 상해
		return "SH"
	elseif sValue == "0214" then ' 심천
		return "SZ"
	elseif sValue == "0321" then ' 뉴욕
		return "NY"
	elseif sValue == "0066" then ' 아멕스
		return "AX"
	elseif sValue == "0537" then ' 나스닥
		return "OQ"
	elseif sValue == "0106" then ' 도쿄
		return "JP"
	end if
end Function

'============================================================================
' 정정/취소화면 전용 함수
'============================================================================
Function ChangeGridType(sType)
	
	'sType : 3 => 선택종목이 없는 경우(디폴트)
	if sType == "3" then
	
		Grid0.height = 346
		
		btnCancel.visible = false
		btnAllCancel.visible = false

	
	'sType : 4 => 선택종목이 있는 경우
	elseif sType == "4" then
	
		Grid0.height = 288
		
		btnCancel.visible = true
		btnAllCancel.visible = false

		
	'sType : 5 => 전체취소 모드
	elseif sType == "5" then
	
		Grid0.height = 288
		
		btnCancel.visible = false
		btnAllCancel.visible = true

	
	end if

End Function

'============================================================================
' 예약내역 조회
'============================================================================
Function RequestData()

	'------------------------------------------------------------------------------------
	' 미체결 내역
	'------------------------------------------------------------------------------------
	Grid0.rowcount = 0
	Grid0.SetClear()
	
	DATAMANAGER.ClearInputData(0, "obtro_oder_114r")
	
	szAcno = Form.GetTopCtlProp("acnt", "total")
	szAsno = Form.GetTopCtlProp("acnt", "sequence")
	szAcpw = Form.GetTopCtlProp("edtPwd", "caption")

	DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "ACNO" 		, 0 , szAcno 	)	' 계좌번호(8)
	DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "ASNO" 		, 0 , szAsno 	)	' 계좌일련번호(2)
	DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "ACNT_PWD" 	, 0 , szAcpw	)	' 계좌비밀번호
	
	DATAMANAGER.RequestTranData("obtro_oder_114r")
	
End Function

'============================================================================
' 국가코드 => 국가명 가져오기
'============================================================================
Function GetCountryNameByCode(sCountryCode,sVndrCode)

	if sCountryCode = "01" then
		return "미국"
	elseif sCountryCode = "02" then
		return "홍콩"
	elseif sCountryCode = "03" then
'		return "상해"
		return "중국"
	elseif sCountryCode = "04" then
'		return "심천"
		return "중국"
	elseif sCountryCode = "05" then 
		return "일본"
	elseif sCountryCode = "06" then
		return "호주"
	elseif sCountryCode = "07" then
		return "싱가폴"
	elseif sCountryCode = "08" then
		return "영국"
	elseif sCountryCode = "09" then
		return "영국"
	elseif sCountryCode = "10" then
		return "독일"
	elseif sCountryCode = "11" then
		return "핀란드"
	elseif sCountryCode = "12" then
		return "프랑스"
	elseif sCountryCode = "13" then
		return "벨기에"
	elseif sCountryCode = "14" then
		return "네덜란드"
	elseif sCountryCode = "15" then
		return "포르투갈"
	elseif sCountryCode = "16" then
		return "그리스"
	elseif sCountryCode = "17" then
		return "아일랜드"
	elseif sCountryCode = "18" then
		return "이탈리아"
	elseif sCountryCode = "19" then
		return "스페인"
	elseif sCountryCode = "20" then
		return "오스트리아"
	elseif sCountryCode = "21" then
		return "캐나다"
	elseif sCountryCode = "23" then
		return "인도네시아"
	elseif sCountryCode = "24" then
		
		if sVndrCode == "XSTC" then 
			return "호치민"
		elseif sVndrCode == "HSTC" then
			return "하노이"
		end if
	
	elseif sCountryCode = "26" then
		return "스위스"
		
	else
		return ""
	end if 

End Function

'============================================================================
' 주문유형코드 => 주문유형명 가져오기
'============================================================================
Function GetOrderNameByCode(sCode)
	
	if sCode == "1" then
		return "지정가"
	elseif sCode == "2" then
		return "시장가"
	elseif sCode == "4" then
		return "LOO"
	elseif sCode == "5" then
		return "LOC"
	elseif sCode == "6" then
		return "MOO"
	elseif sCode == "7" then
		return "MOC"
	elseif sCode == "8" then
		return "Limit VWAP"
	elseif sCode == "9" then
		return "Limit TWAP"
	elseif sCode == "A" then
		return "VWAP"
	elseif sCode == "B" then
		return "TWAP"
	else
		return ""
	end if

End Function

'============================================================================
' 주문상태코드 => 주문상태명 가져오기
'============================================================================
Function GetOrderStateNameByCode(sCode)

	if sCode == "0" then
		return "정상"
	elseif sCode == "1" then
		return "거부"
	elseif sCode == "2" then
		return "자동거부"
	elseif sCode == "3" then
		return "자동취소"
	elseif sCode == "4" then
		return "미접수"
	else
		return ""
	end if
	
End Function

'============================================================================
' 미체결 종목 선택
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)

	'-----------------------------------------------
	'전체취소 체크 상태
	'-----------------------------------------------
	if chkAllCancel.checkstate == "1" then
	
		'-----------------------------------------------
		' 선택한 행이 체크상태이면 미체크/미체크상태이면 체크
		'-----------------------------------------------
		SetCheckReverse(lRow,szCellID)
		
		'-----------------------------------------------
		'체크종목 개수 확인
		'-----------------------------------------------
		nCheckCnt = GetCheckNum()
		
		'-----------------------------------------------
		'체크된 행의 개수에 따라 전체취소모드 설정/해제
		'-----------------------------------------------
		nRowCnt = Grid0.rowcount
		
		'-----------------------------------------------
		'모든행이 체크되어있는 경우 전체취소모드 자동전환
		'-----------------------------------------------
		if nCheckCnt == nRowCnt then
			chkAllCancel.chksilence = "1"
			ChangeGridType("5")
		end if
		
		'-----------------------------------------------
		'모든행이 미체크되어있는 경우 전체취소모드 자동해제
		'-----------------------------------------------
		if nCheckCnt == 0 then
			chkAllCancel.chksilence = "0"
			ChangeGridType("3")
		end if
		
	
	'-----------------------------------------------
	'전체취소 미체크 상태
	'-----------------------------------------------
	else
		
		'-----------------------------------------------
		'선택한 행 이외에 나머지 행 체크되어있다면 해제
		'-----------------------------------------------
		SetCheckExceptSelectRow(lRow,szCellID)
		
		'-----------------------------------------------
		'체크종목 개수 확인
		'-----------------------------------------------
		nCheckCnt = GetCheckNum()
		
		'-----------------------------------------------
		'체크된 행개수에 따른 현재화면 컨트롤 위치조정
		'-----------------------------------------------
		if nCheckCnt > 0 then
			ChangeGridType("4")
		else
			ChangeGridType("3")
		end if

		'-----------------------------------------------
		'취소 불가 주문인 경우, 밑에 로직 안타게끔
		'-----------------------------------------------
		if gOrderAble then
			Form.ShowAlert("알림", "이미 주문 처리되거나 예약기간이 경과하여 취소가 불가합니다.")
			gOrderAble = false
			Exit Sub
		end if
		
		'-----------------------------------------------
		'메인화면에 선택한 종목정보 던지기
		'-----------------------------------------------
		sVndrCode = Grid0.GetCellData("bd_vndrcode", lRow)
		
		sMarektCode = Transform_Exid(sVndrCode)
		sCode = Grid0.GetCellData("bd_cell25", lRow) 
		sName = Grid0.GetCellData("bd_cell26", lRow)
		
		szData = sMarektCode .. "@" .. sCode .. "★" .. sName
		Form.triggerEvent("#", "SendModCancelItem", szData)
		
		'-----------------------------------------------
		'선택행 주문에 필요한 데이터 가져오기
		'-----------------------------------------------
		szChk = CInt(Grid0.GetCellData("bd_cell21", lRow))
		
		if szChk == 1 then
		
			'미체결그리드에서 넘어온 가격/수량이 클리어 되지 않도록해주는 변수
			gReturnQtyPrice = true
			
'			'자동 수량/가격 세팅해주기 위해 일회성으로 얻어오는 값.
'			'실제로 주문전송 시에는 컨트롤에 있는 값을 읽어와서 주문 낸다.
'			sOrdMiChecQty	 = Grid0.GetCellData("bd_micheqty", lRow)
'			sOrdPrice	 = Grid0.GetCellData("bd_orderprice", lRow)
			
		end if
		
	
	end if

	
	
End Sub

'============================================================================
' 선택행의 체크상태를 반대로 바꿔준다.
'============================================================================
Function SetCheckReverse(nRow,sCellD)
	if sCellD <> "bd_cell21" then
	
		szChk = CInt(Grid0.GetCellData("bd_cell21", nRow))
		szAble = Trim(Grid0.GetCellData("bd_able", nRow))	'주문 취소가능여부: Y/N

		if szChk == 1 then
			Grid0.SetCellData("bd_cell21", nRow, "0")
		else
			if szAble <> "N" then		'주문 불가면 체크안해줌
				Grid0.SetCellData("bd_cell21", nRow, "1")
			elseif szAble == "N" then	'주문 불가면 알럿처리
				Form.ShowAlert("알림", "이미 주문 처리되거나 예약기간이 경과하여 취소가 불가합니다.")
			end if
		end if
	
	end if
	

End Function
'============================================================================
' 선택행 외에 체크된 행이 있다면 체크해제 / 선택행이 이미 체크되어있는 상태이면 체크해제
'============================================================================
Function SetCheckExceptSelectRow(nRow,sCellID)
	
	nRowCnt = Grid0.rowcount
	
	for i = 0 to nRowCnt - 1

		if i <> nRow then
			Grid0.SetCellData("bd_cell21", i, "0")
		else
		
			'체크버튼을 직접 클릭한 경우에는 자기가 알아서 체크/체크해제 되므로
			'toprow세팅만 해준다.
			if sCellID <> "bd_cell21" then
		
				szChk = CInt(Grid0.GetCellData("bd_cell21", i))
				szAble = Trim(Grid0.GetCellData("bd_able", nRow))	'주문 취소가능여부: Y/N
				
				if szChk == 1 then
					Grid0.SetCellData("bd_cell21", i, "0")
				else
					if szAble <> "N" then	'주문 불가면 체크안해줌
						Grid0.SetCellData("bd_cell21", i, "1")
						Grid0.toprow = nRow
					else
						gOrderAble = true
					end if
					
				end if
			else
			
				Grid0.toprow = nRow
			
			end if
			
		end if
	
	next


End Function
'============================================================================
' 체크종목 개수 확인
'============================================================================
Function GetCheckNum()
	
	nRowCnt = Grid0.rowcount
	nCheckCnt = 0
	
	for i = 0 to nRowCnt - 1
		szChk = CInt(Grid0.GetCellData("bd_cell21", i))
		
		if szChk == 1 then
			nCheckCnt = nCheckCnt + 1
		end if
		
	
	next
	
	return nCheckCnt

End Function
'============================================================================
' 체크되어있는 인덱스 가져오기
' for문 돌아서 비효율적이긴한데 안전하게...
'============================================================================
Function GetCheckIndex()
	
	Dim nRowCnt
	nRowCnt = Grid0.rowcount
	
	for i = 0 to nRowCnt - 1
	
		szChk = CInt(Grid0.GetCellData("bd_cell21", i))
		
		if szChk == 1 then
			return i
		end if
	next
	
	return -1

End Function

'============================================================================
Sub chkAllCancel_OnChange(sCheckState)
	
	if sCheckState == 1 or sCheckState == "1" then
		
		'----------------------------------
		' 전체 미체결내역 체크
		'----------------------------------
'		if gOsType == "1" then
			
			nCnt = Grid0.rowcount
			
			for i = 0 to nCnt - 1
				szAble = Trim(Grid0.GetCellData("bd_able", i))	'주문 취소가능여부: Y/N
				if szAble <> "N" then
					Grid0.SetCellData("bd_cell21", i, "1")
				end if
			next
			
'		else
'			Grid0.SetPropGridCell("allcheck","bd_cell21",0,"")
'		end if
		
		'전체취소 모드 일때는 
		'현재화면/메인화면 선택종목 없을때 처럼 컨트롤 위치 이동
		ChangeGridType("5")
	
	else
		
		'----------------------------------
		' 전체 미체결내역 체크해제
		'----------------------------------
		if gOsType == "1" then
			
			nCnt = Grid0.rowcount
			
			for i = 0 to nCnt - 1
				Grid0.SetCellData("bd_cell21", i, "0")
			next
			
		else
			Grid0.SetPropGridCell("alluncheck","bd_cell21",0,"")
		end if
		
		
		ChangeGridType("3")
	
	end if
	
End Sub

'============================================================================
' 새로고침
'============================================================================
Sub imgRefresh_OnClick()
	
	'미체결조회 서비스 호출
	RequestData()
	
	'전체취소버튼 미체크 상태로 전환
	chkAllCancel.chksilence = "0"
	
	'그리드상태 초기화
	ChangeGridType("3")
	Grid0.SetPropGridCell("alluncheck","bd_cell21",0,"")
	
	
End Sub


'============================================================================
Sub Form_OnFormClose()
	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(1, 0, 0.5)
	imgRefresh_OnClick()
End Sub

'============================================================================
Sub btnRefresh_OnClick()
	imgRefresh_OnClick()
End Sub

'============================================================================
Sub Grid0_OnHeaderClickUp(lRow, szCellID)
	if szCellID = "th_cell26" then		' 종목명 -> 종목코드
	    Grid0.SetVisibleCol(1, 0)
	    Grid0.SetVisibleCol(2, 1)
	    
	elseif szCellID = "th_cell28" then	' 종목코드 -> 종목명 
	    Grid0.SetVisibleCol(1, 1)
	    Grid0.SetVisibleCol(2, 0)
	    
	end if
End Sub

