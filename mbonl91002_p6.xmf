'============================================================================
' 01.화면명 	: 예외대상
' 02.화면설명	: 예외대상_CheckList
' 03.작성	: 2016.09.22 윤형빈
' 04.로직수정	: 허우석
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_DataCount
Dim R_value

'---------------------------	INIT			-------------------------------

'----------------------------------------------------------------------------
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'setGridIndex	: 	 그리드 Index를 보정한다.
'============================================================================
Function setGridIndex (szCount)

	for i=1 to szCount
		Grid0.SetCellData("bd_cell0", i-1, i)
	next
		
End Function

'============================================================================
'calGridCheck	: 	 그리드 Check 숫자를 리턴한다.
'============================================================================
Function calGridCheck (szCount)
	R_value = ""			
	temp_count = 0
	temp = 0

	for i=0 to szCount-2
		if Grid0.GetCellData("bd_cell2", szCount-i-2) == "1" then
			if temp == 0 then 
				R_value = "030" & Grid0.GetCellData("bd_cell0", szCount-i-2)
				temp = temp + 1
			else 
				R_value = R_value & ",030" & Grid0.GetCellData("bd_cell0", szCount-i-2)
			end if
		end if
		temp_count = temp_count + Grid0.GetCellData("bd_cell2", szCount-i-2)	
	next
		
	calGridCheck = temp_count
		
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
'Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	
	
End Sub

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	
	DATAMANAGER.RequestTranData("obcmp_momt_475r" )
	
End Sub

'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID = "obcmp_momt_475r" then '포괄적 직무 관련성 CheckList만 조회
		DATAMANAGER.SetDataValue(0, "obcmp_momt_475r", "InBlock1", "LRDV_CODE", 0 , "03")
		DATAMANAGER.SetDataValue(0,"obcmp_momt_475r", "InBlock1", "SMDV_CODE" , 0 , "%")
		
	End if
	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID = "obcmp_momt_475r" then 
		g_DataCount = DATAMANAGER.GetDataCount(0,"obcmp_momt_475r", "OutBlock1")
		setGridIndex(g_DataCount)
	End if


End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

End Sub


'============================================================================
'Button0_OnClick
'============================================================================
Sub Button0_OnClick()
	
	count = Cint(calGridCheck(g_DataCount))
	
	if R_value == "" then 
		R_value = "030" & g_DataCount
	end if
	
	if count > 0 then
		temp = R_value & "," & Form.GetSharedData("Clist2_result", false)
		Form.SetSharedData("Clist3_result", temp)
		Form.SendReturnToParent("Clist3", 1)
		Form.CloseForm()
	else
		if Cint(Grid0.GetCellData("bd_cell2", g_DataCount-1))= 0 then
			Form.MsgBox("경고", "하나라도 반드시 선택하셔야 합니다", "", "")
		else 
			Form.MsgBox("경고", "청탁 금지법 위반 가능성이 높은 행위입니다.", "", "")
			Form.SendReturnToParent("Clist3", 0)
			Form.CloseForm()
		end if
	end if
		
End Sub


'============================================================================
'Grid0_OnClickUp
'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	if  Grid0.GetCellData("bd_cell2", g_DataCount-1) == "1" then
		if szCellID == "bd_cell2" then
			if lRow == g_DataCount-1 then
				for i = 0 to g_DataCount-2
					Grid0.SetCellData( "bd_cell2",i, "0" )
				next
			else
				Grid0.SetCellData("bd_cell2", g_DataCount-1, "0")
			end if		
		end if	
	end if

End Sub



