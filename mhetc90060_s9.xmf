'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "TabChange" then
		DATAMANAGER.RequestTranData( "obcsb_acad_002r" )
	elseif sEventName == "NextCheck" then
		Form.triggerEvent( "#", "NextStep", "4" )
	elseif sEventName == "BeforeCheck" then
		Form.triggerEvent( "#", "BeforeStep", "2" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_acad_002r" then	
		Dim sACNO, sACNT_PWD
		sACNO = Form.GetSharedData("CERT_ACNO" , false)
		sACNT_PWD = Form.GetSharedData("CERT_ACNT_PWD" , false)
	
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "PWD" , 0 , sACNT_PWD )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acad_002r" then	
		Dim nCnt, sPOST, sDTAD, sARCD, sTONO, sTELNO, sEMAIL_ADDR, sINAG_TYPE_CODE
		
		nCnt = DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock1" )
		
		if nCnt > 0 then
			for i = 0 to nCnt-1
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "INAG_TYPE_CODE" , i )
				
				if sINAG_TYPE_CODE == "01" then '자택주소
					sPOST = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "POST" , i )
					sDTAD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "DTAD" , i )
					
					Table0.SetCellString( 3, 1, sPOST.." "..sDTAD )
				elseif sINAG_TYPE_CODE == "21" then 'E-mail
					sEMAIL_ADDR = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock1", "EMAIL_ADDR" , i )
			
					Table0.SetCellString( 0, 1, sEMAIL_ADDR )
				end if
			next
		end if
		
		nCnt = DATAMANAGER.GetDataCount( 0, "obcsb_acad_002r", "OutBlock3" )
		
		if nCnt > 0 then
			for i = 0 to nCnt-1
				sINAG_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "INAG_TYPE_CODE" , i )
				
				if sINAG_TYPE_CODE == "11" then '자택전화번호
					sARCD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
					sTONO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
					sTELNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
					
					Table0.SetCellString( 2, 1, sARCD.."-"..sTONO.."-"..sTELNO )
				elseif sINAG_TYPE_CODE == "13" then '휴대폰번호
					sARCD = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "ARCD" , i )
					sTONO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TONO" , i )
					sTELNO = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock3", "TELNO" , i )
					
					Table0.SetCellString( 1, 1, sARCD..sTONO..sTELNO )
				end if
			next
		end if	
	end if
End Sub


