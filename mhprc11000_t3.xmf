	'20230427 KKM 컨테이너 스크롤삭제
	Container0.setScrollBarVisible("0") 

	'20180712 HAMWG START : K-OTC MTS 도입
	If g_szItemMarket <> "T" Then
		Container0.grd0.visible = True
		Container0.grd1.visible = False
	Else
		Container0.grd0.visible = False
		Container0.grd1.visible = True	
	End If
	'20180712 HAMWG END
	
	If Left(g_szgrdHeader, 7) = "th_cell" then		
		'20180712 HAMWG START : K-OTC MTS 도입
		If g_szItemMarket <> "T" Then
			Container0_grd0_OnHeaderClickUp(0, g_szgrdHeader)
		Else
			Container0_grd1_OnHeaderClickUp(0, g_szgrdHeader)	
		End If
		'20180712 HAMWG END
	End if 
	
	'======================================================
	'*********************LES START************************
	'======================================================
	'ChartEx0.SetAccrueName("종가")	
	 Container0.ChartEx0.SetPeriodType(3)	'0:틱, 1:분, 2:일자
	'ChartEx0.setViewDataCount(-1)
	'ChartEx0.SetLineColor("종가;222;0;255");
	'ChartEx0.SetShowCrossLine("true")
	'======================================================
	'*********************LES END**************************
	'======================================================\
	
'	DATAMANAGER.RequestTranData( "ohhts_1002_003r" )

End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		'20180712 HAMWG START : K-OTC MTS 도입
		If g_szItemMarket <> "T" Then
			Container0.grd0.visible = True
			Container0.grd1.visible = False
			
			DATAMANAGER.RequestTranData( "ohhts_1002_003r" )
		Else
			Container0.grd0.visible = False
			Container0.grd1.visible = True	
			
			DATAMANAGER.RequestTranData( "ohhts_1202_003r" )
		End If
		'20180712 HAMWG END
		
		RequestData()
	end	if	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		If sParam = "" Then
			Form.GetCtlProp("lblItemCode", "caption")
'			Form.triggerEvent( "#", "REQUEST_ITEMCODE", "")
			Exit Sub
		End If	
	
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		'20180712 HAMWG START : K-OTC MTS 도입
		If g_szItemMarket <> "T" Then
			Container0.grd0.visible = True
			Container0.grd1.visible = False
			
			DATAMANAGER.RequestTranData( "ohhts_1002_003r" )
		Else
			Container0.grd0.visible = False
			Container0.grd1.visible = True	
			
			DATAMANAGER.RequestTranData( "ohhts_1202_003r" )
		End If
		'20180712 HAMWG END
		
		RequestData()
	 end if
	 
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    if szTranID = "ohhts_1002_003r" then
	    DATAMANAGER.CancelRealData("ohhts_elw_cntg")
'	    DATAMANAGER.CancelRealData("ohhts_stck_cntg") 
	    DATAMANAGER.CancelRealData("ohhts_stck_incg") '20220211 HSZ : 시세속도 개선
	    DATAMANAGER.CancelRealData("ohhts_frbr_cntg")	'20180712 HAMWG : K-OTC MTS 도입
	    
	    DATAMANAGER.SetDataValue( 0, "ohhts_1002_003r", "InBlock1", "FID_INPUT_ISCD"				, 0, g_szItemCode )
	    DATAMANAGER.SetDataValue( 0, "ohhts_1002_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szItemMarket )
	
	'20180712 HAMWG START : K-OTC MTS 도입
	elseif szTranID = "ohhts_1202_003r" then
	    DATAMANAGER.CancelRealData("ohhts_elw_cntg")
'	    DATAMANAGER.CancelRealData("ohhts_stck_cntg")
	    DATAMANAGER.CancelRealData("ohhts_stck_incg") '20220211 HSZ : 시세속도 개선
	    DATAMANAGER.CancelRealData("ohhts_frbr_cntg")	
	    
	    DATAMANAGER.SetDataValue( 0, "ohhts_1202_003r", "InBlock2", "FID_INPUT_ISCD"				, 0, g_szItemCode )
	    DATAMANAGER.SetDataValue( 0, "ohhts_1202_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szItemMarket )
	'20180712 HAMWG END
	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
'	DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szItemCode )
	DATAMANAGER.SetDataValue( 1, "ohhts_stck_incg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szItemCode ) '20220211 HSZ : 시세속도 개선
	DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg" , "InBlock1", "FIDR_SHRN_ISCD", 0, g_szItemCode )
	DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szItemCode )	'20180712 HAMWG : K-OTC MTS 도입
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
    if szTranID = "ohhts_1002_003r" then
	    For i = 0 To Container0.grd0.rowcount - 1
		    Dim nData, szColor
		    nData = CDbl( Container0.grd0.GetCellData( "bd_cell2", i ) )
		    
		    If nData > 0 Then
			    szColor = "10"
		    ElseIf nData < 0 Then
			    szColor = "11"
		    Else
			    szColor = "12"
		    End If		    
		    
			Container0.grd0.SetCellFgColor("bd_cell1", i, szColor)
		Next
    
		if g_szItemMarket = "W" then
		    DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
		
		'20180712 HAMWG START : K-OTC MTS 도입
		elseif g_szItemMarket = "T" then
		    DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
		'20180712 HAMWG END
		
		else
'		    DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		    DATAMANAGER.RequestRealData( "ohhts_stck_incg" ) '20220211 HSZ : 시세속도 개선
		end if
	
	'20180712 HAMWG START : K-OTC MTS 도입
	elseif szTranID = "ohhts_1202_003r" then
	    For i = 0 To Container0.grd1.rowcount - 1
		    Dim nData, szColor
		    nData = CDbl( Container0.grd1.GetCellData( "bd_cell2", i ) )
		    
		    If nData > 0 Then
			    szColor = "10"
		    ElseIf nData < 0 Then
			    szColor = "11"
		    Else
			    szColor = "12"
		    End If		    
		    
			Container0.grd1.SetCellFgColor("bd_cell1", i, szColor)
		Next
    
		if g_szItemMarket = "W" then
		    DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
		
		elseif g_szItemMarket = "T" then
		    DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
		
		else
'		    DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		    DATAMANAGER.RequestRealData( "ohhts_stck_incg" ) '20220211 HSZ : 시세속도 개선
		end if
	'20180712 HAMWG END	
	'==========================================================
	'*********************LES START****************************
	'==========================================================
	elseif szTranID = "ohhts_5010_001r" then
	
'		test = DATAMANAGER.GetDataValue(0, "ohhts_5010_001r", "OutBlock2", "FID_STCK_CLPR" , 0)
'		Form.ShowAlert("test", test)
		
		if g_szItemMarket = "W" then
			DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
		
		'20180712 HAMWG START : K-OTC MTS 도입
		elseif g_szItemMarket = "T" then
		    DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
		'20180712 HAMWG END
		
		else
'			DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
			DATAMANAGER.RequestRealData( "ohhts_stck_incg" ) '20220211 HSZ : 시세속도 개선
		end if
	'==========================================================
	'************************LES END***************************
	'==========================================================
			
    end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SaveConfigData("mhprc11000", "T3_grdHeader", g_szgrdHeader)	
End Sub

'============================================================================
Sub Container0_grd0_OnHeaderClickUp(lRow, szCellID)

	if szCellID = "th_cell2" then				' 거래량
		Container0.grd0.SetVisibleCol(2, 0)
		Container0.grd0.SetVisibleCol(3, 1)
		
	elseif szCellID = "th_cell3" then			' 대비
		Container0.grd0.SetVisibleCol(2, 1)
		Container0.grd0.SetVisibleCol(3, 0)
		
	end if	    
	
	g_szgrdHeader = szCellID

End Sub

'============================================================================
'20180712 HAMWG START : K-OTC MTS 도입
'============================================================================
Sub Container0_grd1_OnHeaderClickUp(lRow, szCellID)

	if szCellID = "th_cell2" then				' 거래량
		Container0.grd1.SetVisibleCol(2, 0)
		Container0.grd1.SetVisibleCol(3, 1)
		
	elseif szCellID = "th_cell3" then			' 대비
		Container0.grd1.SetVisibleCol(2, 1)
		Container0.grd1.SetVisibleCol(3, 0)
		
	end if	    
	
	g_szgrdHeader = szCellID


End Sub
'20180712 HAMWG END


'=================================================================================
'*********************************LES START***************************************
'=================================================================================
Function RequestData()
	
	g_szToday = Form.GetSharedData("&HOST_DATE", 0 )
	
	
'	DATAMANAGER.CancelRealData("ohhts_stck_cntg")
	DATAMANAGER.CancelRealData("ohhts_stck_incg") '20220211 HSZ : 시세속도 개선
	DATAMANAGER.CancelRealData("ohhts_elw_cntg")
	DATAMANAGER.CancelRealData("ohhts_frbr_cntg")	'20180712 HAMWG : K-OTC MTS 도입
		
	
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
	
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR" , 0,"D")  'D/W/M/Y 일/주/월/년 
	DATAMANAGER.SetDataValue( 0, "ohhts_5010_001r", "InBlock2", "FID_INPUT_DATE1" , 0,g_szToday)
	
	DATAMANAGER.RequestTranData("ohhts_5010_001r")	
	
'	Form.ShowAlert("g_szItemMarket", g_szItemMarket)
'	Form.ShowAlert("g_szItemCode", g_szItemCode)
'	Form.ShowAlert("g_szToday", g_szToday)
'
End Function


