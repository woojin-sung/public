		DATAMANAGER.SetDataValue(0, "obtro_oder_810r", "InBlock1", "ODER_STA_DATE" 	, 0 , szDate	)
'		DATAMANAGER.SetDataValue(0, "obtro_oder_810r", "InBlock1", "ODER_STA_DATE" 	, 0 , "20220501"	)
		DATAMANAGER.SetDataValue(0, "obtro_oder_810r", "InBlock1", "ODER_FIN_DATE"	, 0 , szDate	)
		DATAMANAGER.SetDataValue(0, "obtro_oder_810r", "InBlock1", "SELN_BYOV_CLCD"	, 0 , "%"	) '매수매도 구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_810r", "InBlock1", "CNCL_YN"			, 0 , "N"	) '취소여부(%:전체, Y:취소주문, N.일반주문)
	end if
	'20171204 HAMWG END
End Sub
				
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szWarnCd, szOdrMsg

	' ----------------------------------------------------------------------
	' 해외주식 취소주문
	' ----------------------------------------------------------------------	
	Select Case szTranID		
'		Case "obtro_oder_102a"	
		Case "obtro_oder_802a"	
			' 20181022 HWG START : 해외주식 주문착오 방지
			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
			
			if szWarnCd = "1" then							' 경고
				Open_ConfirmPopup(szWarnMsg)
			elseif szWarnCd = "2" then						' 보류(해외주식 제외)
				g_szTR = ""
			else
				g_szTR = ""
				
				szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
				szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
				
'				Form.ShowAlert("g_CnclOrdRow", g_CnclOrdRow)
'				Form.ShowAlert("g_LngNumofOrd", g_LngNumofOrd)
'				cont0.grdOrder.SetCellData("bd_check", g_CnclOrdRow, "0")
				
				if g_szIndex = g_LngNumofOrd then 
'					Form.ShowAlert("알림", "모든 취소주문이 완료되었습니다.")
					bQuery = true
				else
					bQuery = false
					Request_Order(g_szIndex)
				end if

				
				if bQuery == true then
					call Show_Popup()
				end if
'				end if
			end if
			
			' 20181022 HWG END
		Case "obtro_oder_810r"
		    g_nCnt = DATAMANAGER.GetDataCount( 0, "obtro_oder_810r" , "OutBlock1" ) 
			if g_nCnt > 0 then
				cont0.visible = true
				LblEmpty.visible = false
				f_SetGridData()
			else
				cont0.visible = false
				LblEmpty.visible = true
			end if

	End Select
	
	g_szWarnFlag = "N"	' 20181022 HWG : 해외주식 주문착오 방지
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	if szTranID = "obtro_oder_810r" then
		if Trim(szSubMsg) <> "" then
			Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		else
			Form.ShowAlert(g_szTitle, szErrMsg)
		end if	
	elseif szTranID = "obtro_oder_802a" then
		g_NumofFail = g_NumofFail+1
		
		if g_szIndex = g_LngNumofOrd then 
			bQuery = true
		else
			bQuery = false     
			Request_Order(g_szIndex)
		end if

		if bQuery == true then
			call Show_Popup()
		end if
	end if
End Sub
'============================================================================
Sub Show_Popup()	
'	Form.ShowAlert(g_LngNumofOrd, g_NumofFail)
	if g_NumofFail == g_LngNumofOrd then
'		Form.ShowAlert("알림","취소가 불가합니다.")
		Form.OpenPopup("mhtro16090_p8", "NONE_CANCEL" , "" , "2")
	elseif g_NumofFail>0 then
'		Form.ShowAlert("알림","소수점 주문이 일부만 취소되었습니다. 주문내역을 확인해주세요.")
		Form.OpenPopup("mhtro16090_p8", "PART_CANCEL" , "" , "2")
	elseif g_NumofFail == 0 then
		Form.OpenPopup("mhtro16090_p8", "ALL_CANCEL" , "" , "2")
	end if
	
	if g_szAfterInit == "1" then		' 주문후 초기화
		Init_InputControl()
	end if
End Sub
