'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	btnCnl.fontbold = true
	Load_OrderSet() '주문설정값 읽어오기   
'	chkAll_OnChange("1")
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	 plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
	
	cont0.grdOrder.setUseCardView(true, 10, "btn_12_n.9")
	cont0.setScrollBarVisible("1") 
	DATAMANAGER.RequestTranData("obtro_oder_810r")

End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 메인화면 이벤트 처리 (종목변경, 탭변경)
	' ----------------------------------------------------------------------		
	' 20171127 HAMWG START : 해외주식 종목코드 가져오기
	if sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then	
		if g_szCd <> sParam or g_szCd == "" then
			g_szCd = sParam
			g_sCodeData = Split(sParam, "@")		
			g_szKorName = Form.GetItemCodeInfo(g_szCd, "name")	' 한글종목명
			g_szNg = Form.GetItemCodeInfo(g_szCd, "ovsnation")	' 국가구분코드
			g_szMk = Form.GetItemCodeInfo(g_szCd, "exchid")	' 거래소벤더코드
		end if
		
'		DATAMANAGER.RequestTranData( "ohhts_6000_001r" )
		
		if g_bCntrtRtn == false then
			if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
				Init_InputControl()
			end if
		else
			g_bCntrtRtn = false
		end if	
	' ----------------------------------------------------------------------
	' 계좌변경시 초기화
	' ----------------------------------------------------------------------	
	elseif sEventName == "ChangeAcnt" then
		if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
			Init_InputControl()
		end if
	' 20171127 HAMWG END	

	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' 20181022 HWG START : 해외주식 주문착오 방지
	' ----------------------------------------------------------------------
	' 경고팝업에서 리턴
	' ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	
	' 20181022 HWG END
	' ----------------------------------------------------------------------
	' 주문확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			g_szIndex = 0
			Request_Order(g_szIndex)
'			Request_Order()	
		end if
	' ----------------------------------------------------------------------
	' 수량입력창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then		
		edtQty.caption = sRet
		g_szQty = sRet		
		edtQty_OnEditComplete()
	' ----------------------------------------------------------------------
	' 해외주식 미체결팝업 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "16060_CONTRACT" then
		if sRet == "" then
			Exit Sub
		end if
		
		g_bCntrtRtn = true
		Return_ContractScreen(sRet)	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)	
	' ----------------------------------------------------------------------
	' 해외주식 취소주문
	' ----------------------------------------------------------------------	
'	if szTranID == "obtro_oder_102a" then
	if szTranID == "obtro_oder_802a" then
		g_szTR = szTranID
		DATAMANAGER.ClearInputData(0, "obtro_oder_802a")

		DATAMANAGER.SetDataValue(0, "obtro_oder_802a", "InBlock1", "ACNO"					, 0, Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtro_oder_802a", "InBlock1", "ASNO"					, 0, Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_802a", "InBlock1", "ACNT_PWD"			, 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else	
			DATAMANAGER.SetDataValue(0, "obtro_oder_802a", "InBlock1", "ACNT_PWD"			, 0, Form.GetTopCtlProp("edtPwd", "encdata"))		' 계좌 비밀번호
		end if
		'20200910 SWJ END
		DATAMANAGER.SetDataValue(0, "obtro_oder_802a", "InBlock1", "ODER_DATE"				, 0, g_szOrdDate)								' 주문일자
		DATAMANAGER.SetDataValue(0, "obtro_oder_802a", "InBlock1", "ACPT_SRNO"				, 0, g_szAcptSrno)							' 접수번호
		DATAMANAGER.SetDataValue(0, "obtro_oder_802a", "InBlock1", "ODER_OCRN_TYPE_CODE"		, 0, g_szOcrnType)'"01")						' 주문발생유형코드(01:일반주문)	
	' ----------------------------------------------------------------------
'	' 해외주식 시세조회
'	' ----------------------------------------------------------------------	
'	elseif szTranID == "ohhts_6000_001r" then
'		Dim g_sCodeData, szDelay
'	
'		g_sCodeData = {}	' g_sCodeData[1] 마켓, sCodeData[2] 코드
'		g_sCodeData = Split( g_szCd, "@" )
'		
'		szDelay = Form.GetSharedData("REALTIME_"..g_sCodeData[0], 0 )
'	
'		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" ) ' 해외주식 OV
'		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" , h0 , g_sCodeData[1] ) ' 종목코드
'		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , g_sCodeData[0] ) ' 거래소코드
'		DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay ) ' 실시간구분 0 : 실시간 (Default), 1:지연
'	
'	'20171204 HAMWG START : 해외주식_시세조회 서비스 세팅
'	elseif szTranID == "getGtsHogaDetail" then
'		DATAMANAGER.SetDataValue( 0, "getGtsHogaDetail", "inblock", "code" , 0 , g_szCd )
	' ----------------------------------------------------------------------
	' 소수점주문 접수내역 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obtro_oder_810r" then
		szDate = Form.GetSharedData("&HOST_DATE", false)
'
		DATAMANAGER.SetDataValue(0, "obtro_oder_810r", "InBlock1", "ACNO"			, 0, Form.GetTopCtlProp("acnt", "total"))		' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtro_oder_810r", "InBlock1", "ASNO"			, 0, Form.GetTopCtlProp("acnt", "sequence"))		' 계좌일련번호(2)
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_810r", "InBlock1", "ACNT_PWD"				, 0, Form.GetTopCtlProp("edtPwd", "caption"))		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else	
			DATAMANAGER.SetDataValue(0, "obtro_oder_810r", "InBlock1", "ACNT_PWD"				, 0, Form.GetTopCtlProp("edtPwd", "encdata"))		' 계좌 비밀번호
