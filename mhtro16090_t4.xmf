'============================================================================
' Init_AfterOrder : 주문후 초기화
'============================================================================
Function	Init_InputControl()
'	edtOrgNo.caption = ""
'	edtOrgNo_OnEditComplete()
'	
'	g_szQty = ""	
'	edtQty.caption = ""
'	edtQty_OnEditComplete()
	g_NumofFail = 0
	DATAMANAGER.RequestTranData("obtro_oder_810r")
	cont0.ChkAll.chksilence = "0"
	call cont0_ChkAll_OnChange("0")
End Function

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력
	
	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170725 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170725 HAMWG END
	
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if	
End Function

'============================================================================
' Check_InputData
'============================================================================
Function Check_InputData(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Check_Account(nGbn) == false then
		return false
	end if
	
'	if Trim(g_szCd) == "" then
'		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
'		return false
'	end if
'
'	if Trim(edtOrgNo.caption) == "" then
'		Form.ShowAlert(g_szTitle, "원주문번호를 입력하십시요.")
'		return false
'	end if
	
'	if chkAll.checkstate == "0" then		' 일부잔량 선택시
'		if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
'			Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
'			return false
'		end if
'	end if
	call Data_CancelOrder()
	if g_LngNumofOrd = 0 then
		return false
	end if
	
	if nGbn <> 2 then	
'		Data_CancelOrder()
		' 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup()
		else
			g_szIndex = 0
			Request_Order(g_szIndex)
		end if
	end if
	
	return true
End Function

'============================================================================
' Data_CancelOrder 0509
'============================================================================
Sub Data_CancelOrder()
	szData = ""
	g_szOrdData = ""
	g_LngNumofOrd = 0
	For i = g_nCnt To 0 Step -1  
		szCheck = cont0.grdOrder.GetCellData( "bd_check", i)
		if szCheck == "1" then
			szScno 		= cont0.grdOrder.GetCellData( "bd_srno", i)
			szOcrntype 	= cont0.grdOrder.GetCellData( "bd_ocrntype", i)
			szDate 		= cont0.grdOrder.GetCellData( "bd_date", i)
			szGubun 		= cont0.grdOrder.GetCellData( "bd_gubun", i)
			szItmcode	= cont0.grdOrder.GetCellData( "bd_code", i)&"|"&cont0.grdOrder.GetCellData( "bd_name", i)
			szData = Form.GetTopCtlProp("acnt", "caption")	'계좌번호
			szData = szData & "|" & szGubun					'매매구분
			szData = szData & "|" & szItmcode				'종목코드,종목명
			szData = szData & "|" & szDate					'주문일자
			szData = szData & "|" & szScno					'접수일련번호
			szData = szData & "|" & szOcrntype & "★"		'주문발생유형코드
			ArrIdx(g_LngNumofOrd) = i 						'row 인덱스 추가
			g_LngNumofOrd = g_LngNumofOrd+1
		end if
	Next
	g_szOrdData = szData
	
	if g_LngNumofOrd = 0 then
		Form.ShowAlert("안 내", "취소할 주문을 선택해주세요")
		exit Sub 
	else
		g_szOrdData = g_LngNumofOrd & "|" & g_szOrdData
	end if
	
'	g_sCodeData = Split(g_szCd, "@")
'	szData = "3"													' 매매구분
'	szData = szData & "|" & Form.GetTopCtlProp("acnt", "caption")		' 계좌번호
'	szData = szData & "|" & Form.GetTopCtlProp("acnt", "accountname")	' 계좌명
'	szData = szData & "|" & g_sCodeData[1]							' 종목코드
'	szData = szData & "|" & g_szKorName								' 종목명
'	szData = szData & "|" & "지정가"								' 주문구분
'	szData = szData & "|" & "0"										' 현금
'	szData = szData & "|" & LblQty.caption							' 주문수량
'	szData = szData & "|" & edtPrcin.caption							' 주문가격
'	szData = szData & "|" & ""										' 원주문번호
'	szData = szData & "|" & "1"										' 전량전부
	
	' 20181022 HWG START : 해외주식 주문착오 방지
'	if Trim(szWarn) <> "" then		' 경고팝업 오픈
'		szData = szData & "|" & szWarn		' 경고메세지		
'		Form.OpenPopupAnimation("mhtro16060_p7", szData , "")		
'	else							' 주문확인팝업 오픈
'		Form.OpenPopupAnimation("mhtro16090_p7", szData , "", "2") 
'	end if
	' 20181022 HWG END
End Sub
'============================================================================
' Open_ConfirmPopup
'============================================================================
Function Open_ConfirmPopup(szWarn)
'	Dim szData
'	g_sCodeData = Split(g_szCd, "@")
'	szData = "3"													' 매매구분
'	szData = szData & "|" & Form.GetTopCtlProp("acnt", "caption")		' 계좌번호
'	szData = szData & "|" & Form.GetTopCtlProp("acnt", "accountname")	' 계좌명
'	szData = szData & "|" & g_sCodeData[1]							' 종목코드
'	szData = szData & "|" & g_szKorName								' 종목명
'	szData = szData & "|" & "지정가"								' 주문구분
'	szData = szData & "|" & "0"										' 현금
'	szData = szData & "|" & LblQty.caption							' 주문수량
'	szData = szData & "|" & edtPrcin.caption							' 주문가격
'	szData = szData & "|" & ""										' 원주문번호
'	szData = szData & "|" & "1"										' 전량전부
'	
'	' 20181022 HWG START : 해외주식 주문착오 방지
	if Trim(szWarn) <> "" then		' 경고팝업 오픈
		g_szOrdData = g_szOrdData & "|" & szWarn		' 경고메세지		
		Form.OpenPopupAnimation("mhtro16060_p7", g_szOrdData , "")		
	else							' 주문확인팝업 오픈
		Form.OpenPopupAnimation("mhtro16090_p7", g_szOrdData , "", "2") 
	end if
'	' 20181022 HWG END
End Function

'============================================================================
' Request_Order
'============================================================================
Function Request_Order(IRow)
	g_szWarnFlag	= "N"	' 20181022 HWG : 해외주식 주문착오 방지
	'Dim g_szOrdDate, g_szAcptSrno, g_szOcrnType

'	arrData = Split(g_szOrdData,"★")
'	
'	if g_LngNumofOrd > 1 then
'		for i = 0 to g_LngNumofOrd-1
'			orderData = Split(arrData[i],"|")
'			g_szOrdDate = orderData[4]
'			g_szAcptSrno = orderData[5]
'			g_szOcrnType = orderData[6]
'			DATAMANAGER.RequestTranData("obtro_oder_802a")
'		next
'	elseif g_LngNumofOrd = 1 then
'		orderData = Split(arrData[0],"|")
'		
'		g_szOrdDate = orderData[4]
'		g_szAcptSrno = orderData[5]
'		g_szOcrnType = orderData[6]
'		DATAMANAGER.RequestTranData("obtro_oder_802a")
'	else
'		exit function
'	end if
	
	g_CnclOrdRow = ArrIdx(IRow)
	g_szAcptSrno 		= cont0.grdOrder.GetCellData( "bd_srno", g_CnclOrdRow)
	g_szOcrnType 		= cont0.grdOrder.GetCellData( "bd_ocrntype", g_CnclOrdRow)
	g_szOrdDate 		= cont0.grdOrder.GetCellData( "bd_date", g_CnclOrdRow)
	g_szIndex 		= g_szIndex + 1
	DATAMANAGER.RequestTranData("obtro_oder_802a")
End Function

'============================================================================
' Check_Account
'============================================================================
Function Check_Account(nGbn)
	Dim szAcnt, szPwd
'	
	szAcnt = Form.GetTopCtlProp("acnt", "caption")
	
	If Len(szAcnt) < 10 Then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
		return False
	end If
	
	if nGbn <> 2 then
		szPwd = Form.GetTopCtlProp("edtPwd", "caption")
		If Trim(szPwd) = "" Then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end If
	end if
	
	return True
End Function

'============================================================================
' Return_ContractScreen : 미체결팝업에서 리턴된 값 적용
'============================================================================
Function Return_ContractScreen(szRet)
	tData = Split(szRet, "★")
	
	if UBound(tData) > 0 then
		szMkCd = Transform_Exid(tData(2))
		Form.triggerEvent("#", "16060_CONTRACT", szMkCd & "@" & tData(1) & "★" & tData(3))
		
		' 주문번호
		edtOrgNo.caption = tData(5)						
		edtOrgNo_OnEditComplete()
		
		' 주문일자
		g_szOrdDate = tData(4)

		' 수량
		g_szQty = ""
		edtQty.caption = tData(6)	
		edtQty_OnEditComplete()
		g_szQty = tData(6)
	end if
End Function

'============================================================================
' 거래소코드 <- 거래소 벤더코드
'============================================================================
Function Transform_Exid(sValue)
	if sValue == "0104" then	' 홍콩
		return "HK"
	elseif sValue == "0215" then ' 상해
		return "SH"
	elseif sValue == "0214" then ' 심천거래소 종목
		return "SZ"
	elseif sValue == "0321" then ' 뉴욕
		return "NY"
	elseif sValue == "0066" then ' 아멕스
		return "AX"
	elseif sValue == "0537" then ' 나스닥
		return "OQ"
	elseif sValue == "0106" then ' 도쿄
		return "JP"
	end if
end Function
