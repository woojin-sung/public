'============================================================================
' btnEnroll_OnClick - 신청
'============================================================================
Sub btnEnroll_OnClick()
	g_YoN = "I"

	Dim szData
	
	if g_szAccountPassword == "" or Form.GetCtlProp( "#EditPW", "caption") == "" then
		Form.MsgBox("알림", "계좌 비밀번호를 입력하세요", "", 0)
		exit sub
	else
		szData = "87040_t2" & "★" & g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & g_szAccountPassword & "★" & "076"
	     'v0005 메모리평문적용시 가장마지막에 비밀번호자릿수 넘겨줌
	     '      g_szAccountPassword값은 메모리평문 적용여부에 따라 암호화/미암호화된 정보로 넘어감
	     'v0005 CMA계좌전환신청에 따른 투자성향진단 오픈시, 비밀번호 컨트롤설정이 없으므로 자릿수 설정 주석처리함
		'if g_plain_rm == "1" then
		'	szData = Trim(szData) & "★" & g_pwdLen 
		'end if
	end if
	
	'v0004 
	if ChkView0.chksilence == "0" then
		Form.MsgBox( "알림", "개인(신용)정보 처리 동의를 확인하시기 바랍니다.", "", 6 )	
		Exit Sub
	end if

	if ChkView1.chksilence == "0" then
		Form.MsgBox( "알림", "EUREX연계선물 거래계좌설정 약관에 동의하셔야 합니다.", "", 6 )	
		Exit Sub
	end if
	
	if ChkView2.chksilence == "0" then
		Form.MsgBox( "알림", "EUREX연계선물 거래설명서에 동의하셔야 합니다.", "", 6 )	
		Exit Sub
	end if

	'v0006
	if ChkView4.chksilence == "0" then
		Form.MsgBox( "알림", "일중매매거래위험 고지서를 확인하셔야합니다.", "", 6 )	
		Exit Sub
	end if

	'v0004
	if ChkView3.chksilence == "0" then
		Form.MsgBox( "알림", "글로벌거래의 수탁에 관한 약정서에 동의하셔야 합니다.", "", 6 )	
		Exit Sub
	end if
	
	'서류제공방식선택 추가
	if chkProvision.checkstate == "0" then
		Form.MsgBox( "알림", "서류 제공방식을 선택하세요.", "", 6 )	
		Exit Sub
	end if
	
	If ChkView5.chksilence == "0" Then
		Form.MsgBox("알림", "전문, 일반 금융소비자를 확인 바랍니다.", "Show_mbonl81010", "1")
		Exit Sub		
	End If

	Form.OpenFramePopup( "mbonl81010_p1" , szData , sPosInfo)
	'DATAMANAGER.RequestTranData( "obpds_srvc_045a" )'약정
End Sub


