'        End If
	End If
	
	If szTranID = "obcsb_dbif_322a" Then
		DATAMANAGER.RequestTranData( "obcsb_acif_199a" )
	End If
	
	if szTranID == "obcsb_acif_199a" then 
		'계약서류교부처리가 끝나면 변수 초기화
		g_szFnprJoinSrno = ""
		g_szSvcSrno = ""
	end if
End Sub

