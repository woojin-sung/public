	<SCRIPT_INFO _len="35344" _ulen="31908" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : EUREX 야간거래 신청/해지
' 02. 화면설명 : EUREX 야간거래 약정을 신청 해지하는 화면
' 03. 작    성 : 2017.05.24 김동구
' 04. 수    정 : 2018.02.08 윤유정 : 약관파일변경 v0001
'                2019.04.30 장원혁 : 개인(신용)정보 처리 동의 변경 v0002
' 2020.04.01 : 정민영 : v0003 : [T2003040024] 종금영업종료 및 사명 변경
' 2020.04.13 : 정민영 : v0004 : [T2004090004] 약정파일 추가 및 개인(신용)정보처리동의 보완
' 2020.09.18 : 정민영 : v0005 : [T2008250015] 메모리취약점 보완
' 2020.12.14 : 정민영 : v0006 : [T2012140011] '일중매매거래위험 고지' 추가
' 2021.02.23 : 정민영 : v0007 : [T2102030017] 유의사항 문구수정
' 2021.05.22 : 정민영 : v0008 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obpds_srvc_045a IO변경분 적용
' 2021.05.26 : 김수진 : 개인신용정보동의 공통팝업처리  obpds_srvc_045a PROS_DATE, PROS_SRNO
' 2021.07.07 : 정민영 : v0009 : [T2106210023] 유의사항 문구수정
' 2024.06.24 : 양현정 : v0010 : 약관 테스트url 수정, 해지시 초기화 추가
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_Srno '서비스약정일련번호
Dim g_Accept
Dim g_Csno
Dim g_szAccountNumber	'계좌번호 (8자리)
Dim g_szAccountSerialNumber '계좌일련번호(2자리)
Dim g_szAccountPassword	'계좌비밀번호
Dim g_YoN
Dim g_ServerMode  		'v0003
Dim g_plain_rm  			'v0005 메모리평문적용여부
Dim g_pwdLen				'v0005 비밀번호자릿수(Lx)
Dim g_szFnprJoinSrno		'금융상품일련번호
Dim g_szSvcSrno			'서비스일련번호

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Sub Form_OnFormInit()
    g_ServerMode = Form.GetSharedData("&SERVER_MODE", False)  'v0003

	'v0005 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	DATAMANAGER.RequestTranData( "obsap_acif_999a" ) '금융상품 일련번호 GET
	SetRequestData()
End Sub

'===========================================================================
' 조회함수
'===========================================================================
Function SetRequestData()
'	SetControlViewClear()
	DATAMANAGER.RequestTranData( "obpds_srvc_070r" ) '약정고객정보 조회
'	DATAMANAGER.RequestTranData( "obcsb_acif_556r" ) 'v0004 고객신용정보조회
End Function

Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obpds_srvc_070r" then
		g_Csno = DATAMANAGER.GetDataValue( 0, "obpds_srvc_070r", "OutBlock1", "CSNO", 0 )
		DATAMANAGER.RequestTranData( "obpds_srvc_069r"	)
	End If

	'v0004 고객신용정보조회
'	If szTranID = "obcsb_acif_556r" Then
'		Dim sAgrm_C3
'		Dim sAgrm_P4
'		Dim sAgrm_P14
'		sAgrm_C3  = DATAMANAGER.GetDataValue( 0, "obcsb_acif_556r", "OutBlock1", "UI_COMN_AGRM_YN3" , 0 )  '필수(공통)_고유식별정보의처리
'		sAgrm_P4  = DATAMANAGER.GetDataValue( 0, "obcsb_acif_556r", "OutBlock2", "UI_PROD_AGRM_YN4" , 0 )  '필수(상품별)_조회
'		sAgrm_P14 = DATAMANAGER.GetDataValue( 0, "obcsb_acif_556r", "OutBlock2", "UI_PROD_AGRM_YN14", 0 )  '필수(상품별)_해외주식/파생제공
'       
'		If sAgrm_C3 == "Y" And sAgrm_P4 == "Y" And sAgrm_P14 == "Y" Then
'			ChkView0.chksilence = "1"
'		Else
'			ChkView0.chksilence = "0"
'		End If
'	End If
'	
    If szTranID = "obpds_srvc_069r" then
'	    if DATAMANAGER.GetDataValue( 0, "obpds_srvc_069r", "OutBlock1", "SVC_SRNO", 0 ) = "" then
'		    g_Srno = 1
'   	    else
'		    g_Srno = DATAMANAGER.GetDataValue( 0, "obpds_srvc_069r", "OutBlock1", "SVC_SRNO", 0 )
'	    end if
'	    
		Dim nCnt
		Dim nAcc_cnt
		nCnt = DATAMANAGER.GetDataCount( 0, "obpds_srvc_069r", "OutBlock1" )
		nAcc_cnt = 0
		
		if nCnt > 0 then
'			Dim sMoASNO, ASNO
'			sMoASNO = Right(g_sAcc, 2)
'			Form.MsgBox( "알림", g_szAccountSerialNumber, "", 6 )	
			for i = 0 to nCnt-1 
				ASNO = DATAMANAGER.GetDataValue( 0, "obpds_srvc_069r", "OutBlock1", "ASNO" , i )
				
