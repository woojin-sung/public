'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)	
'Form.MsgBox( "알림", sEventName , "", 6 ) 	
	Dim szList, argIdx

	'v0005 배열의마지막위치값 설정
	szList = Split(sParam, "★")	'계좌번호, 일련번호, 비밀번호
	argIdx = UBOUND(szList)
	
	if sEventName == "AccountData" or sEventName == "SELECT" then
		'InitDataSetting()	
		'BtnEnrollEnable()
		'Dim szList	
		'v0005 로직이동 szList = Split(sParam, "★")	'계좌번호, 일련번호, 비밀번호	
		
		'v0005 인자갯수별 정보설정
'		g_szAccountNumber = szList(0)
'		g_szAccountSerialNumber = szList(1)
'		if szList(2) == "" then
'			g_szAccountPassword = ""
'		else
'			g_szAccountPassword = szList(2)
'		end if
		g_szAccountNumber = szList(0)
		
		if argIdx >= 1 then
			g_szAccountSerialNumber = szList(1)	
		else
			g_szAccountSerialNumber = ""
		end if
		if argIdx >= 2 then
			g_szAccountPassword = szList(2)	'부모화면에서(mbonl87040) 메모리평문적용여부에 따라 암호화/미암호화된 정보로 넘어오므로 연계화면 변경시 확인필수
		else
			g_szAccountPassword = ""
		end if
		
		if argIdx >= 3 then
			g_pwdLen = szList(3)	'메모리평문적용 타화면연동시, 비밀번호 자릿수 넘겨주기위해 부모로부터 받아 저장
		else
			g_pwdLen = ""
		end if
		'v0005 계좌정보 넘어온 경우에만 자동조회
		if argIdx >= 1 then
			SetRequestData()
		end if 
		
	end if	
	
	if sEventName == "PASSWORD" then
	
		'v0005 
		if g_plain_rm == "1" then
			g_szAccountPassword = szList(0)
			if argIdx >= 1 then
				g_pwdLen = szList(1)	'메모리평문적용 타화면연동시, 비밀번호 자릿수 넘겨주기위해 부모로부터 받아 저장
			else
				g_pwdLen = ""
			end if
		else
			'g_szAccountPassword = sParam
			g_szAccountPassword = szList(0)	'부모화면에서(mbonl87040) 메모리평문적용여부에 따라 암호화/미암호화된 정보로 넘어오므로 연계화면 변경시 확인필수
			
		end if 
		
		if szList(0) <> "" then
			Form.SetSharedData("SPCL_CNFR_ACNO", g_szAccountNumber )
			
			if tblState.GetCellString(0, 1) <> "신청" then
				Form.OpenPopup("mbonl81010_p20" , "" , "")	'2023.05.22 금융소비자 팝업 추가
			end if
		end if
	end if
	
	'v0005 AccountData이벤트와 같이 처리
'	if sEventName == "SELECT" then
'		SetRequestData()
'	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    If szTranID = "obpds_srvc_070r" then
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_070r", "InBlock1", "ACNO" , 0 , g_szAccountNumber )
    End if
    
    'v0004 고객신용정보조회
'    If szTranID = "obcsb_acif_556r" then
'	    DATAMANAGER.SetDataValue( 0, "obcsb_acif_556r", "InBlock1", "ACNO"     , 0 , g_szAccountNumber )  '계좌번호
'		'v0005 메모리평문적용시 암호화된 정보로 넘어옴
'		if g_plain_rm == "1" then
'			DATAMANAGER.SetDataValue( 0, "obcsb_acif_556r", "InBlock1", "ACNT_PWD" , 0 , g_szAccountPassword )  '계좌비밀번호
'		else
'			DATAMANAGER.SetDataValue( 0, "obcsb_acif_556r", "InBlock1", "ACNT_PWD" , 0 , Form.GetEncData(g_szAccountPassword) )  '계좌비밀번호
'		end if
'    End if
    
    If szTranID = "obpds_srvc_069r" then
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_069r", "InBlock1", "ACNO" , 0 , g_szAccountNumber )    
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_069r", "InBlock1", "CSNO" , 0 , g_Csno )
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_069r", "InBlock1", "SVCD" , 0 , "076" )
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_069r", "InBlock1", "PROS_CLS_CODE" , 0 , "0" )
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_069r", "InBlock1", "STPL_STAT_CLS_CODE" , 0 , "01" )
    End if
    
    If szTranID = "obpds_srvc_045a" then
    '고객번호, 계좌번호, 일련번호, 비밀번호 매핑해줘야함.
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "PROS_CLS_CODE" , 0 , g_YoN ) '처리구분코드
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "SVCD" , 0 , "076" ) 'HTS불원 서비스 코드	    
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "SVC_MANG_UNIT_CODE" , 0 , "02" ) '서비스 관리 단위 코드
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "ACNO" , 0 , g_szAccountNumber ) '계좌번호
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "ASNO" , 0 , g_szAccountSerialNumber )	'계좌일련번호   

		'v0005 메모리평문적용시 암호화된 정보로 넘어옴
		if g_plain_rm == "1" then
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "ACNT_PWD" , 0 , g_szAccountPassword )
		else
			DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "ACNT_PWD" , 0 , Form.GetEncData(g_szAccountPassword) )	'비밀번호 v0002
		end if

	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "ELFN_ID" , 0 , Form.GetSharedData("&USER_ID", false ) ) 'HTS ID
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "CSNO" , 0 , g_Csno ) '고객번호
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "SVC_SRNO" , 0 , g_Srno )
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_045a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )
	    
	    '처리일자, 처리일련번호
		Dim sProsDate, sProsSrno 
		sProsDate = Form.GetSharedData( "PROS_DATE", false )
		sProsSrno = Form.GetSharedData( "PROS_SRNO", false )
		DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "PROS_DATE", 0, sProsDate)	'처리일자
		DATAMANAGER.SetDataValue(0, "obpds_srvc_045a", "InBlock1", "PROS_SRNO", 0, sProsSrno)	'처리일련번호
    End if
       
    If szTranID = "obpds_srvc_068r" then
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_068r", "InBlock1", "ACNO" , 0 , g_szAccountNumber ) '계좌번호
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_068r", "InBlock1", "ASNO" , 0 , g_szAccountSerialNumber )	'계좌일련번호       
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_068r", "InBlock1", "CSNO" , 0 , g_Csno )    
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_068r", "InBlock1", "SVCNM" , 0 , "076" )
	    DATAMANAGER.SetDataValue( 0, "obpds_srvc_068r", "InBlock1", "PROS_CLS_CODE" , 0 , "0" )
    End if  	
    
    if szTranID == "obcsb_dbif_322a" then 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" 				 , 0 , g_szAccountNumber	) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNPR_JOIN_SRNO" 	 , 0 , g_szFnprJoinSrno	) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "BSWR_LRDV_CODE" 	 , 0 , "017"				)	'001:계좌개설 / 017:서비스약정 
		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "FNPR_JOIN_DETL_SRNO" , 0 , "00001"			)	'다건일경우 하나씩 증가
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock2", "ISCD"				 , 0 , "076"				)	'prcd:계좌개설 / svcd:서비스약정 
