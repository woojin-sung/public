Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "KYCCHK_RETURN" then			'투자성향진단 OK면 Y값내려줌
		if sRet == "Y" then
			SetTrans()
		end if
	elseif sKeyName == "mbonl81020" Then         'v0002	
	    if sRet == "ok" then
	        ChkView0.chksilence = "1"
	    end If
	    
    '서류제공방식선택 추가
	elseif sKeyName == "ok_mbonl81010_p16" then
		If Trim(sRet) == "OK" then
			chkProvision.checkstate = "1"	
		else
			chkProvision.checkstate = "0"
		end if	
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			ChkView5.checkstate = "1"
		elseif sRet == "CANCEL_mbonl81010_p20" then
			ChkView5.checkstate = "0"
			
			'가입중단시 처리미완료인경우 메뉴트리로 빠지도록 함 (2023.06.14)
			tRst = Form.GetSharedData( "81010_P20_RST" , false )
			if trim(tRst) <> "Y" then
				Form.OpenMainMenuWithIndex(0,1,0)
			end if			
		end if
	else
		if sRet == "유렉스(EUREX)연계선물거래 계좌설정약관" then
			ChkView1.chksilence = "1"
		elseif sRet == "유렉스(EUREX)연계선물거래 설명서 및 위험고지서" then
			ChkView2.chksilence = "1"
		elseif sRet == "글로벌거래의 수탁에 관한 약정서" then  'v0004
			ChkView3.chksilence = "1"
		elseif sRet == "일중매매거래위험 고지서" then  'v0006
			ChkView4.chksilence = "1"
		end if	
	
	end if	
End Sub


