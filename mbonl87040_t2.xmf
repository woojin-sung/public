Function GetPWCheck()
    If g_szAccountPassword == "" or Form.GetCtlProp( "#EditPW", "caption") == "" then
        Form.MsgBox( "알림" , "비밀번호를 입력십시오." , "" , 6 )
        Return False
    End If
	
    Return True
	
End Function	

