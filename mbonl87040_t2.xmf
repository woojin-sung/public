		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_SMDV_LEVL_CODE"	, 0 , "02"& "076"		)	'&서비스약정코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_DTL_DIV_LEVL_CODE"	, 0 , "000" 			)	'CMA전환신청인경우 "009" 그외엔 "000"
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "FNCM_PROD_ISSU_DIV_LEVL_CODE", 0 , "000"			) 
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ISCD" 	 					, 0 , "076"			)	'076 서비스약정 코드
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "KOR_ISNM" 					, 0 , ""				)	
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CSNO"						, 0 , g_Csno		)	'고객번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "SVC_MANG_UNIT_CODE"	 		, 0 , "01" 			)	'서비스관리단위코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO"	 					, 0 , g_szAccountNumber )	'계좌컨트롤 8자리
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" 	 					, 0 , ""				) 	'SVC_MANG_UNIT_CODE가 03일때만 매핑
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CONT_CLS_CODE" 	 			, 0 , "4"			)	'온라인
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CHAN_TYPE_CLS_CODE" 		, 0 , ""				)	
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CAFU_TRGT_YN"				, 0 , ""				)	
'		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ODER_DATE"	 				, 0 , "" 			)	
