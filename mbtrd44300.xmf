--===========================================================================
--===========================================================================
'-----------------------------------------------------------------------------
'20200910 SWJ START 메모리평문제거 (plain_rm = 0 미적용 / plain_rm = 1 적용)
'-----------------------------------------------------------------------------
'주문설정값
Dim g_szChangeInit
Dim g_szBuyPrc
Dim g_szSelPrc
Dim g_szModPrc
Dim g_szAfterOrg

' 계좌비밀번호 저장여부
Dim g_szSavePwd 
g_szSavePwd  = "0"

Dim g_szItemCode '종목코드
Dim g_szExchName '거래소명

Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북

Dim g_szGTD 'GTD날짜

' 20200910 SWJ START : 메모리평문제거 적용구분값
Dim plain_rm
plain_rm =""

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet()
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")		  ' 종목/탭 변경시 초기화
	g_szBuyPrc = Form.LoadConfigData("SET_ORDER", "AUTO_GLOBAL_FUTOPT_BUYPRC") ' 해외파생매수주문가격 자동입력
	g_szSelPrc = Form.LoadConfigData("SET_ORDER", "AUTO_GLOBAL_FUTOPT_SELPRC") ' 해외파생매도주문가격 자동입력
	g_szModPrc = Form.LoadConfigData("SET_ORDER", "AUTO_GLOBAL_FUTOPT_MODPRC") ' 해외파생정정주문가격 자동입력
	g_szAfterOrg = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")			  ' 원주문번호 자동입력
	
	g_szSavePwd = Form.GetEnvData("order.save_orderpwd")					' 계좌비밀번호 저장여부

	' 해외파생매수주문가격 자동입력(기본값 : 미사용, 6:현재가)
	if Trim(g_szBuyPrc) = "" then
		g_szBuyPrc = "0"
	end if

	' 해외파생매도주문가격 자동입력(기본값 : 미사용, 6:현재가)
	if Trim(g_szSelPrc) = "" then
		g_szSelPrc = "0"
	end if
	
	' 해외파생정정주문가격 자동입력(기본값 : 미사용, 6:현재가)
	if Trim(g_szModPrc) = "" then
		g_szModPrc = "0"
	end if
	
	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
	
	'20170725 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if
	
	' 계좌비밀번호사용여부 초기화(기본값 : 미사용)
	if Trim(g_szSavePwd) = "" then
		g_szSavePwd = "0"
	end if	
	
	'20220425 HWG START : 계좌비밀번호 입력 개선
	if g_szSavePwd == "0" then
		edtPwdIcon.imgpath = "icon_save_password_n.9"
		edtPwd.caption = ""
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'20220425 HWG END
End Function

'============================================================================
' 호가 선택
'============================================================================
Sub hogaTbl_OnClick(lRow, lCol)
	f_SelectHoga(hogaTbl.GetCellString(lRow, 0))
End Sub

'============================================================================
' 호가 선택
'============================================================================
Function f_SelectHoga(szPrc)
	'매수, 매도, 정정/취소탭에만 데이터 전달
	if tonumber(fmtab.currenttab) < 3 then
		Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "HOGA", szPrc)
	end if
End Function

'============================================================================
' 호가 조회
'============================================================================
Function f_RequestHoga()
	if g_szItemCode <> nil and g_szItemCode <> "" then
		DATAMANAGER.CancelRealData( "ohhts_ovdv_aspr" )
		DATAMANAGER.CancelRealData( "ohhts_ovdv_cntf" )
		DATAMANAGER.ClearInputData( 1, "ohhts_ovdv_aspr" )
		DATAMANAGER.ClearOutputData( 1, "ohhts_ovdv_aspr" )
		DATAMANAGER.ClearInputData( 1, "ohhts_ovdv_cntf" )
		DATAMANAGER.ClearOutputData( 1, "ohhts_ovdv_cntf" )
		
		if g_szExchName <> "" then
			DATAMANAGER.RequestTranData( "ohhts_6500_002r" ) '현재가 조회
			DATAMANAGER.RequestTranData( "ohhts_6500_007r" ) '호가 조회
		end if
	end if
End Function

'============================================================================
' 가격 자동연동(화면실행 or 탭변경시)
'============================================================================
Function f_AutoPrice()
	Dim nTab, szAuto
	
	if g_szChangeInit == "1" then		' 종목/탭 변경시 초기화 사용시는 가격자동연동 제외
		Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "AUTO_PRICE", "")
		Exit Function
	end if
	
	nTab = tonumber(fmtab.currenttab)

	if nTab < 3 then
		if nTab = 0 then
			szAuto = g_szBuyPrc
		elseif nTab = 1 then
			szAuto = g_szSelPrc
		elseif nTab = 2 then
			szAuto = g_szModPrc
		end if

		Select Case Trim(szAuto)
			Case "1"											' 매도5호가
				szPrc = hogaTbl.GetCellString( 0, 0)
			Case "2"											' 매도4호가
				szPrc = hogaTbl.GetCellString( 1, 0)
			Case "3"											' 매도3호가
				szPrc = hogaTbl.GetCellString( 2, 0)
			Case "4"											' 매도2호가
				szPrc = hogaTbl.GetCellString( 3, 0)
			Case "5"											' 매도1호가
				szPrc = hogaTbl.GetCellString( 4, 0)
			Case "6"											' 현재가
				szPrc = lblHyun.caption					
			Case "7"											' 매수1호가
				szPrc = hogaTbl.GetCellString(5, 0)
			Case "8"											' 매수2호가
				szPrc = hogaTbl.GetCellString(6, 0)
			Case "9"											' 매수3호가
				szPrc = hogaTbl.GetCellString(7, 0)
			Case "10"										' 매수4호가
				szPrc = hogaTbl.GetCellString(8, 0)
			Case "11"										' 매수5호가
				szPrc = hogaTbl.GetCellString(9, 0)
			Case Else										' 미적용 및 기타에러
				szPrc = ""
		End Select
		
		Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "AUTO_PRICE", szPrc)
	end if
End Function

'============================================================================
Sub Form_OnFormInitBefore()
	Form.SetSearchType ("16") '해외파생 종목검색 타입셋팅
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	btnPwd.bringfront("1")	'20220425 HWG : 계좌비밀번호 입력 개선
	
	'20210113 SWJ START : 해외파생 불공정거래 팝업 게시 (매달 18~22일 주기)
	Form.OpenPopup("notice_abrdFO" , "" , "")
	'20210113 SWJ END
	
	Load_OrderSet() '환경설정값 정의
	
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	 plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	'20200910 SWJ END
	Form.SetInterestTitle("N")		'비활성화로 기본 세팅 20230722 HSZ
	
	Dim szData, tData, szTabIndex, szPrc, szQty
	szData = Form.GetOpenLinkData( )
	
	if szData <> nil and szData <> "" then
		tData = Split(szData, "★")
	end if
	
	g_szItemCode = Form.GetSharedData("&ITEM_GLOBAL_FUTOPT", 0)	 ' 최근조회종목

	if tData <> nil and UBound(tData) > 0 then
		if tData(0) = "관심종목" or tData(0) = "주요종목" or tData(0) = "보유잔고" then '관심에서 넘어옴, 주요종목에서 넘어옴
			szTabIndex = tData(1)
			g_szItemCode = tData(2)
			if tData(0) = "보유잔고" then
				szQty = tData(3)
			end if
		else
			szTabIndex = tData(0)
			szPrc = tData(1)
		end if
	end if

	if g_szItemCode <> nil and g_szItemCode <> "" then
'PENTA13 START => 2019.11.28	해외파생시세제어
		if Form.getSiseEnable(g_szItemCode) then
			g_szExchName = Form.GetItemCodeInfo( g_szItemCode, "exchname")
			if g_szExchName <> "" then
				Form.SetItemCode(g_szItemCode)	'상단헤더에 종목코드 셋팅
			end if
			f_RequestHoga() 					'호가 조회
		end if
'PENTA13 END
	end if
	
	if fmtab.currenttab = 3 then
		tblHogaTitle.visible = false
		hogaTbl.visible = false
		imgToggle.visible = false
	end if
	
	'------------------------------------------------------------------------
	' 현재가화면에서 매수매도로 넘어옴, 주문가격 셋팅
	' 관심에서 넘어옴
	' 보유잔고에서 넘어옴
	'------------------------------------------------------------------------
	if szTabIndex <> nil and szTabIndex <> "" then
		fmtab.currenttab = szTabIndex
	end if
	if szPrc <> nil and szPrc <> "" then
		Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "PRC", szPrc)
	end if
	if szQty <> nil and szQty <> "" then
		Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "QTY", szQty)
	end if
	'------------------------------------------------------------------------
	
	Dim szHAlign '호가정렬
	
	if Form.GetSharedData("GLOBAL_ODER_HOGA", false ) = "0" then
		Form.SetSharedData("GLOBAL_ODER_HOGA" , "0")
		hogaTbl.SetColumnWidth( "115,0,56" )
		szHAlign = "1"
	else
		Form.SetSharedData("GLOBAL_ODER_HOGA" , "1")
		hogaTbl.SetColumnWidth( "82,33,56" )
		szHAlign = "2"
	end if
	
	for i = 0 to 9 step 1
		hogaTbl.SetCellHAlign(i, 0, szHAlign)
	next
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		if sValue <> "" then
			edtOrgNo.caption = ""
			
			if g_szItemCode <> sValue then
				g_szItemCode = sValue
				g_szExchName = Form.GetItemCodeInfo( g_szItemCode , "exchname")
				
				f_RequestHoga() '호가 조회
			end if
			
			Form.triggerEvent("fmtab.page01", "ITEMCODE", sValue)
			Form.triggerEvent("fmtab.page02", "ITEMCODE", sValue)
			
			DATAMANAGER.RequestTranData( "obtrd_comm_500r" ) 'GTD날짜조회
		end if
	end if
End Sub

'============================================================================
Sub acnt_ChangeAccount()
	'20220425 HWG START : 계좌비밀번호 입력 개선
	if g_szSavePwd == "0" then
		edtPwd.caption = ""
		edtPwdIcon.imgpath = "icon_save_password_n.9"
	else
		edtPwdIcon.imgpath = "icon_save_password_o.9"
	end if
	'20220425 HWG END
	
	edtOrgNo.caption = ""
	Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "CHANGE_ACNT", "")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_MENU" then '연결 리스트
		if sParam == "POPUP1" or sParam == "POPUP2" then '예탁자산현황 팝업, 보유잔고 팝업
			if f_CheckAccount() = true then
				Dim szData
				szData = Form.GetCtlProp("acnt", "total")
				szData = szData & "★" & Form.GetCtlProp("acnt", "sequence")
				
				if sParam == "POPUP1" then '예탁자산현황 팝업
					Form.OpenFramePopup("mbtrd44300_p9" , szData , "")
				elseif sParam == "POPUP2" then '보유잔고 팝업
					Form.OpenFramePopup("mbtrd44300_p10" , szData , "")
				end if
			end if
		elseif sParam == "SET_SCREEN" then '주문설정
			Form.OpenScreen("90000" , "1")
		elseif sParam == "SHA_SNS" then 'SNS공유
			Form.OpenDialog("sharesns" , "1", "")
		'20230405 HSZ START
		elseif sParam = "HK_POPUP" then '홍콩 Disclaimer
			Form.OpenPopupAnimation("mhtrd43100_p2", "", "", "2")
		'20230405 HSZ END
		end if
	
	elseif sEventName = "sharedata" Then
		Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
		
	elseif sEventName == "AUTO_PRICE" then '가격 자동연동
		f_AutoPrice()
		
	elseif sEventName == "CONTRACT_OPEN" then '정정/취소화면에서 미체결팝업 오픈
		Dim szData
		
		szData = Form.GetCtlProp("acnt", "total") '계좌번호
		szData = szData & "★" & Form.GetCtlProp("acnt", "sequence") '계좌일련번호
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			szData = szData & "★" & Form.GetCtlProp("edtPwd", "caption") '계좌비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			szData = szData & "★" & Form.GetCtlProp("edtPwd", "encdata") '계좌비밀번호
		end if
		'20200910 SWJ END
		
		Form.OpenFramePopup("mbtrd44300_p8" , szData , "")
		
	elseif sEventName = "REG_INTR" then '관심별표
		if g_szItemCode <> nil and g_szItemCode <> "" then
			Form.OpenPopup("mhtrd43110_p4" , g_szItemCode , "")
		else
			Form.ShowAlert("알림", "종목코드를 입력하십시요.")
		end if
		
	elseif sEventName = "CONTRACT" then '주문내역탭에서 미체결내역 탭시 정정취소로 이동
		tblHogaTitle.visible = true
		hogaTbl.visible = true
		imgToggle.visible = true
		fmtab.currenttab = "2"
		Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "CONTRACT", sParam)
		
	elseif sEventName = "QTY" then '매수,매도탭에서 잔고버튼 탭시 보유잔고팝업 오픈
		if f_CheckAccount() = true then
			Dim szData
			szData = Form.GetCtlProp("acnt", "total")
			szData = szData & "★" & Form.GetCtlProp("acnt", "sequence")
			
			Form.OpenFramePopup("mbtrd44300_p10" , szData , "")
		end if
	' 상단바 클릭 시
	'20220922 SWJ START : 상단 바 클릭 시, 종목선택창 팝업 추가
	ElseIf sEventName = "TITLE_CLICK" Then
		Form.OpenCommonDialog("SEARCH", "16" , "")
	'20220922 SWJ END		
	end if
End Sub

'============================================================================
' 계좌 비밀번호 체크
'============================================================================
Function f_CheckAccount()
	if Len(Form.GetCtlProp("acnt", "caption")) < 10 then
		Form.ShowAlert("알림", "계좌번호를 확인후 다시 입력하십시오.")
		return false
		
	end if
		
	return true
End Function

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "ohhts_6500_002r" then '현재가 조회
		DATAMANAGER.SetDataValue( false, "ohhts_6500_002r", "InBlock1", "FID_OVDV_QTTN_EXCH_NAME" , 0 , g_szExchName ) '거래소명
		DATAMANAGER.SetDataValue( false, "ohhts_6500_002r", "InBlock1", "FID_OVDV_ISCD" , 0 , g_szItemCode ) '종목코드
		
	elseif szTranID = "ohhts_6500_007r" then '호가 조회
		DATAMANAGER.SetDataValue( false, "ohhts_6500_007r", "InBlock1", "FID_OVDV_QTTN_EXCH_NAME" , 0 , g_szExchName ) '거래소명
		DATAMANAGER.SetDataValue( false, "ohhts_6500_007r", "InBlock1", "FID_OVDV_ISCD" , 0 , g_szItemCode ) '종목코드
		
	elseif szTranID = "obtrd_comm_500r" then 'GTD날짜조회
		DATAMANAGER.SetDataValue( false, "obtrd_comm_500r", "InBlock1", "FISCD" , 0 , g_szItemCode ) '종목코드
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_6500_002r" then '현재가 조회
		DATAMANAGER.RequestRealData( "ohhts_ovdv_cntf" ) '현재가 실시간 조회
		
	elseif szTranID = "ohhts_6500_007r" then '호가 조회
	'	if fmtab.currenttab = 0 or fmtab.currenttab = 1 then
			f_AutoPrice() '가격 자동연결
	'	end if
		DATAMANAGER.RequestRealData( "ohhts_ovdv_aspr" ) '호가 실시간 조회
		
	elseif szTranID = "obtrd_comm_500r" then 'GTD날짜조회
		g_szGTD = DATAMANAGER.GetDataValue( false, "obtrd_comm_500r", "OutBlock1", "TRHT_DATE" , 0 ) '거래정지일자
		
		if tonumber(fmtab.currenttab) < 2 then
			Form.triggerEvent("fmtab."..fmtab.currenttabpageid, "GTD", g_szGTD)
			Form.triggerEvent("fmtab."..fmtab.currenttabpageid, "GTD", g_szGTD)
		end if
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if szTranID = "ohhts_ovdv_aspr" then '호가 실시간 조회
		DATAMANAGER.SetDataValue( 1, "ohhts_ovdv_aspr", "InBlock1", "FID_OVDV_ISCD" , 0 , g_szItemCode ) '종목코드
	
	elseif szTranID = "ohhts_ovdv_cntf" then '현재가 실시간 조회
		DATAMANAGER.SetDataValue( 1, "ohhts_ovdv_cntf", "InBlock1", "FID_OVDV_ISCD" , 0 , g_szItemCode ) '종목코드
		
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	f_RequestHoga() '호가 조회
End Sub

'============================================================================
Sub fmtab_OnTabChanged(nCurrentTab)
	if nCurrentTab < 3 then '매수, 매도, 정정/취소
		tblHogaTitle.visible = true
		hogaTbl.visible = true
		imgToggle.visible = true
		if nCurrentTab = 2 then
			if g_szAfterOrg == "1" then		'주문연동시
				if edtOrgNo.caption <> "" then
					Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "AFTER_ORGNO", edtOrgNo.caption) '주문번호 연동
				end if
			end if
		end if
		if nCurrentTab < 2 then
			Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "ITEMCODE", g_szItemCode)
			f_AutoPrice() '가격 자동연결
			Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "GTD", g_szGTD)
		end if
		
	else '나머지
		tblHogaTitle.visible = false
		hogaTbl.visible = false
		imgToggle.visible = false
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert("알림", szErrMsg)
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "CONTRACT" then '미체결팝업 리턴
		Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "CONTRACT", sRet)
		
	elseif sKeyName = "QTY" then '보유잔고팝업 리턴
		if sRet <> nil and sRet <> "" then
			Dim tData, szTab, szItemCode, szQty
			tData = split(sRet, "★")
			szTab = tData(0)
			szItemCode = tData(1)
			szQty = tData(2)
			
			if fmtab.currenttab <> szTab then
				fmtab.currenttab = szTab
			end if
			
			if g_szItemCode = szItemCode then
				Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "QTY", szQty)
			else
				Form.SetItemCode(szItemCode) '상단헤더에 종목코드 셋팅
				Form.triggerEvent("fmtab." & fmtab.currenttabpageid, "QTY", szQty)
			end if
		end if
		
	elseif sKeyName = "snsshare" then 'SNS공유
		g_nSNSType = Cint(sRet)
		
		if g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		else
			Form.triggerEvent("lkForm", "sharedata", "")
		end if
		
	'20220425 HWG START : 계좌비밀번호 입력 개선
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
			end if
			
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
			else
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
		else
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if g_szSavePwd == "0" then
				edtPwdIcon.imgpath = "icon_save_password_n.9"
				edtPwd.caption = ""
			else
				szCurAcc = acnt.caption
				nCnt = Cint(acnt.accountcount)
				For i = 0 to nCnt - 1
					szCompAcc = acnt.getAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						acnt.currentindex = i
						Exit For
					end if
				Next
				edtPwdIcon.imgpath = "icon_save_password_o.9"
			end if
			
		end if 
	'20220425 HWG END
		
	end if
End Sub

'============================================================================
Sub tblHogaTitle_OnClick(lRow , lColumn)
	if lColumn = 0 then
		Dim szHAlign '호가정렬
		
		if Form.GetSharedData("GLOBAL_ODER_HOGA", false ) = "0" then
			Form.SetSharedData("GLOBAL_ODER_HOGA" , "1")
			hogaTbl.SetColumnWidth( "82,33,56" )
			szHAlign = "2"
		else
			Form.SetSharedData("GLOBAL_ODER_HOGA" , "0")
			hogaTbl.SetColumnWidth( "115,0,56" )
			szHAlign = "1"
		end if
		
		for i = 0 to 9 step 1
			hogaTbl.SetCellHAlign(i, 0, szHAlign)
		next
	end if
End Sub

'20220425 HWG START : 계좌비밀번호 입력 개선
