Dim g_sCode
Dim g_sDecimalLen

'============================================================================
function Tonum(sValue)
	return tonumber( sValue ) or 0
end functino

'============================================================================
' 현재가, 전일대비, 등락률 색상 세팅
'============================================================================
function Data_Color_Setting()
	Dim sDiff 
	sDiff = Tonum( Label6.caption )
	Dim sColor
	sColor = "4"
	
	if sDiff > 0 then
		sColor = "1"
	elseif sDiff < 0 then
		sColor = "2"
	elseif sDiff == 0 then
		sColor = "3"
	end if
	
	Label0.fgcolor = sColor
	Label6.fgcolor = sColor
	Label7.fgcolor = sColor
end function

'============================================================================
' 거래소 ID 시장명으로 변환
'============================================================================
function Transform_Market(sValue)
	if sValue == "HK" then
		return "홍콩"
	elseif sValue == "CN" then
		return "중국"
	elseif sValue == "JP" then
		return "일본"
	elseif sValue == "US" then
		return "미국"
	end if
end function

'============================================================================
'[[ 폼 초기화 ]]
'============================================================================
Sub Form_OnFormInit()
	Form.TriggerEvent( "LinkForm0", "ChartLarge", "ok" )

	g_sCode = ItemCode0.code	' ItemCode0.code 로 변경하기
	
	if g_sCode <> nil and g_sCode <> "" then
		Form.TriggerEvent( "LinkForm0", "RequestData", g_sCode )
		DATAMANAGER.RequestTranData( "getGtsHogaDetail" )
	end if
end Sub

'============================================================================
'[[ 폼탭 변경시 ]]
'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	Form.TriggerEvent( "LinkForm0", "RequestData", g_sCode )
end Sub

'============================================================================
Sub ItemCode0_OnEditComplete(sCode)
	g_sCode = sCode	' sCode 로 변경하기
	if g_sCode <> nil and g_sCode <> "" then
		Form.TriggerEvent( "LinkForm0", "RequestData", g_sCode )
		DATAMANAGER.RequestTranData( "getGtsHogaDetail" )
	end if
end Sub

'============================================================================
'[[ DATAMANAGER 조회 BEFORE ]]
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "getGtsHogaDetail" then
		DATAMANAGER.CancelRealData( "TRD" )
		Label0.mask = "0,0,,,0,,-1,1,0"
		Label6.mask = "0,0,,,0,,-1,1,0"
		DATAMANAGER.SetDataValue( false, "getGtsHogaDetail", "inblock", "code" , 0 , g_sCode )
	end if
end Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	Dim sTemp
	sTemp = {}
	Dim sMarketNm 
	sMarketNm = ""
	if szTranID == "getGtsHogaDetail" then
		sTemp = Trim( DATAMANAGER.GetDataValue( 0, "getGtsHogaDetail", "price", "natcode" , 0 ) )
		
		sMarketNm = Transform_Market( sTemp ) ' 거래소 ID 시장명으로 변환
		
		Label8.caption = sMarketNm
	end if
end Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim sTemp
	if szTranID == "getGtsHogaDetail" then
		
		Data_Color_Setting()		' 현재가, 전일대비, 등락률 색상 세팅
		
		sTemp = Label0.caption
		if sTemp <> nil and sTemp <> "" then
			g_sDecimalLen = Split( sTemp , "." )
			
			if g_sDecimalLen[2] <> nil and g_sDecimalLen[2] <> "" then
				Label0.mask = "0,0,,,0,,".. Len(g_sDecimalLen[2]) ..",1,0"
				Label6.mask = "0,0,,,0,,".. Len(g_sDecimalLen[2]) ..",1,0"
			end
			
			Dim szRealCode
			szRealCode = ""
			szRealCode = DATAMANAGER.GetDataValue( false, "getGtsHogaDetail", "price", "trdcode" , 0 )
			
			DATAMANAGER.SetDataValue( 1, "TRD", "inblock", "codelist" , 0 , szRealCode )
			DATAMANAGER.RequestRealData( "TRD" )
		end if
	end if
end Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID == "TRD" then
		Data_Color_Setting()		' 현재가, 전일대비, 등락률 색상 세팅
	end if
end Sub

'============================================================================
'[[ 추가 버튼 ]]
'============================================================================
Sub BtnAdd_OnClick()
	Dim sCode
	Dim sSymbol
	Dim sKorname
	Dim sEngName
	Dim sOrdersize
	Dim sExid
	Dim sSendData
	
	sCode = Form.GetSharedData( "&ITEM_CODE" , 0 )
	sSymbol = Form.GetSharedData( "&ITEM_SYMBOL" , 0 )
	sKorname  = Form.GetSharedData( "&ITEM_KORNAME" , 0 )
	sEngName  = Form.GetSharedData( "&ITEM_ENGNAME" , 0 )
	sOrdersize  = Form.GetSharedData( "&ITEM_ORDERSIZE" , 0 )
	sExid  = Form.GetSharedData( "&ITEM_EXID" , 0 )
	sSendData = sCode .."`".. sSymbol .."`".. sKorname .."`".. sEngName .."`".. sOrdersize .."`".. sExid

	Form.PostLinkData( "Item_Add", sSendData )
end Sub

'============================================================================
'[[ 환전 버튼 ]]
'============================================================================
Sub BtnTrans_OnClick()
'	Form.OpenPopup( "I111P1" , "EXCHANGE" , "" )
end Sub

'============================================================================
Sub Form_OnRefresh()
	g_sCode = ItemCode0.code
	
	if g_sCode <> nil and g_sCode <> "" then
		Form.TriggerEvent( "LinkForm0", "RequestData", g_sCode )
		DATAMANAGER.RequestTranData( "getGtsHogaDetail" )
	end if
end Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH" then
		g_sCode = ItemCode0.code
	
		if g_sCode <> nil and g_sCode <> "" then
			Form.TriggerEvent( "LinkForm0", "RequestData", g_sCode )
			DATAMANAGER.RequestTranData( "getGtsHogaDetail" )
		end if
'	elseif sEventName == "HORIZON" then
'		Form.TriggerEvent( "LinkForm0", "HORIZON", "OK" )
	end if
end Sub

