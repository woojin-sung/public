	<SCRIPT_INFO _len="681" _ulen="607" >

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
'	szOpenData = "2"
	If szOpenData <> "" And szOpenData <> null Then
		If szOpenData == "1" Then
			tblText.SetCellString(0, 1, "등록된 이메일 정보가 없습니다.")
		ElseIf szOpenData == "2" Then
			tblText.SetCellString(0, 1, "등록된 자택 정보가 없습니다.")
		Else
			tblText.SetCellString(0, 1, "등록된 직장 정보가 없습니다.")
		End If
	End If
End Sub

	</SCRIPT_INFO>
</ROOT>