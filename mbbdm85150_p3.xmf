	<CONTROL_INFO>
		<IMAGE name="imgBack" autosize="1" imgpath="alpha128.png" ly_vert="0,0,375,647,1" />
		<IMAGE name="imgBg" imgpath="popup_bg_common.9" ly_vert="32,212,312,157,1" />
		<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="알림" halign="1" ly_vert="52,226,275,32,1" />
		<BUTTON name="btnOK" caption="확인" fontsize="2" btnimage="btn_22.9" ly_vert="32,335,312,60,1" />
		<TABLE name="tblText" insidelinecolor="102:255255255" colcount="2" rowcount="2" outline="0000" designorder="1" ly_vert="48,270,285,40,1" >
			<COL_INFO ly_vert_width="5,280" />
			<ROW_INFO ly_vert_height="20,20" />
			<CELL_INFO>
				<CELL cell_ly="0,0,0,0" line="0,0" fontsize="2" impidxs="" />
				<CELL cell_ly="1,0,1,0" line="0,0" impidxs="" />
				<CELL cell_ly="0,1,0,1" line="0,0" impidxs="" />
				<CELL cell_ly="1,1,1,1" line="0,0" caption="다른 통보처를 선택해주세요." impidxs="" />
