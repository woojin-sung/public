'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Call acnt0_ChangeAccount()
End Sub

'============================================================================
Sub Form_OnRefresh()
	Call RequestData()	'조회
End Sub

'============================================================================
Sub acnt0_ChangeAccount()
	Call ClearAllData()
	cmbSeq.clear = 1								'계약번호 초기화
	DATAMANAGER.RequestTranData( "obwat_ctad_011r" )	'계약번호 조회
End Sub

'============================================================================
Sub edtPwd_OnEditComplete()
	Call RequestData()	'조회
End Sub

'============================================================================
Sub cmbSeq_OnEditComplete(iIndex)
	If edtPwd.caption <> "" Then
		Call RequestData()	'조회
	End If
End Sub

'============================================================================
Sub btnSearch_OnClick()
	Call RequestData()	'조회
End Sub

'============================================================================
Sub tab0_OnTabChanged(nCurrentTab)
	If edtPwd.caption <> "" Then
		Call RequestData()	'조회
	End If
End Sub

'============================================================================
'계약정보 변경
Sub tab0_page1_btnOK_OnClick()
	If Account_Check() == False then
		Exit Sub
	End If
	
	DATAMANAGER.RequestTranData( "obwat_ctad_013a" )
End Sub

'============================================================================
'운용지침 변경
Sub tab0_page2_btnOK_OnClick()
	If Account_Check() == False then
		Exit Sub
	End If
	
'	If tab0.page2.edt0.caption == "" then
'		Form.ShowAlert("알림", "목표수익률을 입력해주세요.")
'		Exit Sub
'	End If
'	
'	If tab0.page2.edt1.caption == "" then
'		Form.ShowAlert("알림", "손절수익률을 입력해주세요.")
'		Exit Sub
'	End If

	If tab0.page2.edt0.caption <> "" then
		If CDbl(tab0.page2.edt0.caption) >= 1000 then
			Form.ShowAlert("알림", "목표수익률은 1000 미만으로 입력가능합니다.")
			Exit Sub
		End If
	End If
	
	If tab0.page2.edt1.caption <> "" then
		If CDbl(tab0.page2.edt1.caption) >= 1000 then
			Form.ShowAlert("알림", "손절수익률은 1000 미만으로 입력가능합니다.")
			Exit Sub
		End If
	End If
	
	DATAMANAGER.RequestTranData( "obwat_ctad_017a" )	
End Sub

'============================================================================
Sub tab0_page1_cmbReport_OnEditComplete(iIndex)
	Dim sKey
	sKey = tab0.page1.cmbReport.cbkeydata
	
	If sKey == "01" then		'자택
		tab0.page1.tbl0.SetCellString( 3, 1, g_sHomeAddr) 'v0001 만기연장 변경 추가 (2->3)
	ElseIf sKey == "02" then	'직장
		tab0.page1.tbl0.SetCellString( 3, 1, g_sCoAddr)
	ElseIf sKey == "21" then	'Email
		tab0.page1.tbl0.SetCellString( 3, 1, g_sEMail)
	End If	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_CNRC_NO" , 0 , cmbSeq.caption)
	
	If szTranID == "obwat_ctad_023r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_INDV_MGRI_ASNO" , 0 , acnt0.sequence)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CSNO" , 0 , g_sCSNO)
	End If
	
	If szTranID == "obwat_ctad_016r" then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CSNO" , 0 , g_sCSNO)
	End If
	
	If szTranID == "obwat_ctad_013a" then
		DATAMANAGER.SetEventFlag( szTranID, "U")
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ASNO" , 0 , acnt0.sequence)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_INDV_MGRI_ASNO" , 0 , acnt0.sequence)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "SNML_INAG_TYPE_CODE" , 0 , tab0.page1.cmbReport.cbkeydata)	'보고서발송처
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CSNO"      , 0 , g_sCSNO)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "CNTM_MNCN" , 0 , tab0.page1.cmbCntmMncn.cbkeydata)	          'v0001. 계약기간월수 추가
	End If
	
	If szTranID == "obwat_ctad_017a" then
		'목표수익률
		If tab0.page2.edt0.caption == "" then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_GOAL_ERT" , 0 , "0")		
		Else
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "WA_GOAL_ERT" , 0 , CDbl(tab0.page2.edt0.caption))	
		End If
		
		'손절수익률
		If tab0.page2.edt1.caption == "" then
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "LOSS_LIMT_RATE" , 0 , "0")
		Else
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "LOSS_LIMT_RATE" , 0 , CDbl(tab0.page2.edt1.caption))		
		End If
	End If
	'v0002. 은합회 결과값에 따라 가입가능 여부 체크 sta
	If szTranID == "obaci_acct_089r" or szTranID == "obaci_acct_089r_1" or szTranID == "obaci_acct_089r_2" or szTranID == "obaci_acct_089r_3" or szTranID == "obaci_acct_089r_4" then		
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "TXCM_PRCD" , 0 , "84"        )	'은행연합회 상품코드
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO"      , 0 , acnt0.total )	'계좌번호
	End If
	'v0002. fin
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'고객번호 조회
	If szTranID == "obcsb_acif_000r" then
		g_sCSNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "CSNO" , 0 )	
		
		If tab0.currenttab == 0 or tab0.currenttab == "0" then	'계약정보 변경
			DATAMANAGER.RequestTranData("obwat_ctad_023r")	
		Else							'운용지침 변경
			DATAMANAGER.RequestTranData("obwat_ctad_016r")	
		End If
	End If
	
	'계약번호 조회
	If szTranID == "obwat_ctad_011r" then
		Dim i, nCnt	

		nCnt = DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" )
		
		If nCnt == 0 then
			Form.ShowAlert("알림", "ISA 계약이 존재하지 않습니다.")
			Exit Sub
		End If
		
		For i = 0 To nCnt - 1
			cmbSeq.cbadddatatext = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WA_CNRC_NO" , i )		'계약번호
		Next

		cmbSeq.SetCurSel( 0 )	
	End If
	
	'계약정보 변경 조회
	If szTranID == "obwat_ctad_023r" then
		Call SetTableData(szTranID)
		Call SetInputData(szTranID)		'보고서 발송처를 제외한 나머지 데이터는 조회 데이터를 변경 TR InBlock에 넣어준다.
	End If
	
	'운용지침 변경 조회
	If szTranID == "obwat_ctad_016r" then
		Call SetTableData(szTranID)
		Call SetInputData(szTranID)		'목표수익률, 손절수익률을 제외한 나머지 데이터는 조회 데이터를 변경 TR InBlock에 넣어준다.
	End If
	
	'계약정보 변경
	If szTranID == "obwat_ctad_013a" then
	
		'v0001. ISA 세제개편 sta
		Dim sCode 
		Dim gTmp
		gTmp  = DATAMANAGER.GetDataValue( 0 , "obwat_ctad_013a", "OutBlock1", "LNKD_TLMS_MNNO" , 0)	
		sCode = DATAMANAGER.GetDataMsgCode( szTranID ) 
		
		If sCode == "6616" then '6616.처리 대기중입니다.
		
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "TRNM_RSLT_YN" , 0 , "Y")	 'Y.전송결과조회
			DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "LNKD_TLMS_MNNO" , 0 , gTmp) '연계전문관리번호
				
			DATAMANAGER.RequestTranData( szTranID )
			Exit Sub
		End If
		'v0001 fin
		
		Form.ShowAlert("알림", "계약정보 변경이 완료되었습니다.")
		Call RequestData()
	End If
	
	'운용지침 변경
	If szTranID == "obwat_ctad_017a" then
		Form.ShowAlert("알림", "운용지침 변경이 완료되었습니다.")
		Call RequestData()
	End If
	
