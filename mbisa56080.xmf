	<SCRIPT_INFO _len="35985" _ulen="33805" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : ISA 계약정보 변경
' 02. 화면설명 : 
' 03. 작    성 : 2016.04.18 김은숙
' 04. 수    정 : 2020.12.10 김유경. ISA 세제개편_만기연장 가능하도록 수정 v0001
' 2021-05-10 : 신극수 : v0002 : [T2103310007][ISA] 금융소득종합과세 대상자 특례 제한 관련 변경 세금우대설계서 반영 요청
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sHomeAddr	'보고서발송처 자택주소
Dim g_sCoAddr		'보고서발송처 직장주소
Dim g_sEMail		'보고서발송처 Email
Dim g_sCSNO		'고객번호


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Function Account_Check()
	If acnt0.caption == "" Then
		Form.ShowAlert("알림", "계좌번호는 필수값입니다.")
		Return False
	End If

	If edtPwd.caption == "" Then
		Form.ShowAlert("알림", "비밀번호는 필수값입니다.")
		Return False
	End If
	
	If cmbSeq.caption == "" Then
		'Form.ShowAlert("알림", "계약번호는 필수값입니다.")
		Return False
	End If
	
	Return true
End Function

'============================================================================
'조회
Sub RequestData()
	Call ClearAllData()
	
	If Account_Check() == False then
		Exit Sub
	End If
	
	DATAMANAGER.RequestTranData("obcsb_acif_000r")	'고객번호 조회	
End Sub

'============================================================================
Sub ClearAllData()
	If tab0.currenttab == 0 or tab0.currenttab == "0" then	'계약정보 변경
		For i = 0 to 4
			tab0.page1.tbl0.SetCellString( i, 1, "" )
		Next
	Else							'운용지침 변경
		tab0.page2.tbl0.SetCellString( 0, 1, "" )
		tab0.page2.edt0.caption = ""
		tab0.page2.edt1.caption = ""
	End If
End Sub

'============================================================================
Sub SetTableData(szTranID)
	'계약정보 변경 조회
	If szTranID == "obwat_ctad_023r" then
	
		'보고서발송처 : 연락처가 존재하는 항목만 콤보에 셋팅	
		tab0.page1.cmbReport.clear = 1
		
		g_sHomeAddr = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_ADDR" , 0)	'자택주소
		g_sCoAddr = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CO_ADDR" , 0)		'회사주소
		g_sEMail = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "EMAIL_ADDR" , 0)		'이메일주소	
		
		If g_sHomeAddr <> "" then
			tab0.page1.cmbReport.cbadddatatext = "01`자택"
		End If
		
		If g_sCoAddr <> "" then
			tab0.page1.cmbReport.cbadddatatext = "02`직장"
		End If
		
		If g_sEMail <> "" then
			tab0.page1.cmbReport.cbadddatatext = "21`Email"
		End If
	
		'보고서발송처
		Dim sCode0, sCode1, sCode2
		
		sCode0 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "SNML_INAG_TYPE_CODE" , 0 )
		tab0.page1.cmbReport.cbkeydata = sCode0
		
		If sCode0 == "01" then		'자택
			tab0.page1.tbl0.SetCellString( 3, 1, g_sHomeAddr) 'v0001 만기연장 변경 추가 (2->3)
		ElseIf sCode0 == "02" then	'직장 
			tab0.page1.tbl0.SetCellString( 3, 1, g_sCoAddr)   'v0001 만기연장 변경 추가 (2->3)
		ElseIf sCode0 == "21" then	'Email
			tab0.page1.tbl0.SetCellString( 3, 1, g_sEMail)     'v0001 만기연장 변경 추가 (2->3)
		End If
		
		'만기처리방법
		sCode1 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ATMT_CANC_YN" , 0 )
		If sCode1 == "Y" then
			tab0.page1.tbl0.SetCellString( 4, 1, "자동매도") 'v0001 만기연장 변경 추가 (3->4)
		ElseIf sCode1 == "N" then
			tab0.page1.tbl0.SetCellString( 4, 1, "지정매도") 'v0001 만기연장 변경 추가 (3->4)
		End If
		
		'사전운용통지
		sCode2 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ASET_RE_DSTR_PRIR_NTFY_CLCD" , 0 )
		If sCode2 == "01" then
			tab0.page1.tbl0.SetCellString( 5, 1, "SMS")      'v0001 만기연장 변경 추가 (4->5)
		End If
	End If
	
	'운용지침 변경 조회
	If szTranID == "obwat_ctad_016r" then
		Dim sRate0, sRate1
		'목표수익률
		sRate0 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WA_GOAL_ERT" , 0 )
		If sRate0 <> "" then
			tab0.page2.edt0.caption = CDbl(sRate0)
		End If
		
		'손절수익률
		sRate1 = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "LOSS_LIMT_RATE" , 0 )
		If sRate1 <> "" then
			tab0.page2.edt1.caption = CDbl(sRate1)
		End If
	End If
End Sub

'============================================================================
Sub SetInputData(szOutTranID)
