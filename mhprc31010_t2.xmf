'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	If szTranID = "ohhts_3072_003r" Then
		
	'만기년월
	If szTranID = "ohhts_3072_100r" Then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, "ohhts_3072_100r", "OutBlock1" )
			
		if nCnt > 0 then
			Dim sYYMM
			
			for i = 0 to nCnt-1 
				sYYMM = DATAMANAGER.GetDataValue( 0, "ohhts_3072_100r", "OutBlock1", "FID_MTRT_YYMM" , i )
				
				ComboYYMM.cbadddatatext = sYYMM.."`"..sYYMM '결제월콤보세팅
			next
			
			SetCallPutRequest()	
		end if
		
	'하단그리드
	elseif szTranID == "ohhts_3072_002r" then
		DATAMANAGER.RequestRealData( "ohhts_sfut_cntg" )
	
	elseif szTranID == "ohhts_3072_005r" then
		if RadioGroupCP.currentindex == "0" then
			Dim nCnt, nTopRow
			nCnt = CInt(Container0.GridAllC.rowcount)
			nTopRow = 0
			
			'20210630 HWG START : ATM 실시간 하이라이트 적용
			nBaseJisu = CInt(Table0.GetCellString(0, 1))
			nMinDiff = 0
			nMinIdx = 0
			'20210630 HWG END
			
			if nCnt > 0 then
				Container0.GridAllC.height = CInt(47.2*nCnt)
				Container0.GridAllP.height = CInt(47.2*nCnt)
				Container0.SetScrollAutoSize()
				
				Dim nSign, sAtm, sCode
				
				for i = 0 to nCnt-1 
					sCode = Container0.GridAllC.GetCellData( "bd_callcode", i )
					sAtm = Container0.GridAllC.GetCellData( "bd_callatm", i )
					nPrc = CInt(Container0.GridAllC.GetCellData( "bd_cell2", i ))	'20210630 HWG : ATM 실시간 하이라이트 적용
					
					'그리드 실시간 자동업데이트 안되서 일단 세팅
					DATAMANAGER.SetDataValue( 1, "ohhts_sopt_cntg", "InBlock1", "FIDR_SHRN_ISCD" , i , sCode )
					
					'20210630 HWG START : ATM 실시간 하이라이트 적용
					nHDiff = ABS(nBaseJisu - nPrc)
					if i = 0 then
						nMinDiff = nHDiff
					else
						if nHDiff < nMinDiff then
							nMinDiff = nHDiff
							nMinIdx = i
						end if
					end if
					
'					if sAtm == "ATM" then
'						if i > 2 then
'							nTopRow = i-3
'						end if
'						
'						Container0.GridAllC.SetCellBgColor( "bd_cell2", i, "156:255253233" )
						'g_nGIdx =  i	'20210630 HWG : ATM 실시간 하이라이트 적용
'					end if 
					'20210630 HWG END
				next
				
				'20210630 HWG START : ATM 실시간 하이라이트 적용
				if nMinIdx > 2 then
					nTopRow = nMinIdx-3
				end if
						
				Container0.GridAllC.SetCellBgColor( "bd_cell2", nMinIdx, "156:255253233" )
				g_nGIdx =  nMinIdx
				
				if nTopRow ~= 0 then
					szOsType = Form.GetSharedData("&OS_TYPE", false )
					if szOsType = "2" then
						Container0.scroll_pos_noAni = (nTopRow*47)+63
					else
						Container0.scroll_pos = (nTopRow*47)+63
					end if
				end if
				'20210630 HWG END
			else
				Container0.GridAllC.height = "0"
				Container0.SetScrollAutoSize()
			end if
		else
			SetCallPutGrid()
		end if

		DATAMANAGER.RequestRealData( "ohhts_stck_incg" )
		DATAMANAGER.RequestRealData( "ohhts_sopt_cntg" ) '콜실시간조회
	
	elseif szTranID == "ohhts_3072_005r_1" then
		if RadioGroupCP.currentindex == "0" then
			Dim nCnt
			nCnt = CInt(Container0.GridAllP.rowcount)
			
			if nCnt > 0 then
				Container0.GridAllP.height = CInt(63.2*nCnt)
				
				Dim nSign, sCode
				
				for i = 0 to nCnt-1 
					sCode = Container0.GridAllP.GetCellData( "bd_putcode", i )
					
					'그리드 실시간 자동업데이트 안되서 일단 세팅
					DATAMANAGER.SetDataValue( 1, "ohhts_sopt_cntg_1", "InBlock1", "FIDR_SHRN_ISCD" , i , sCode )
				next
			else
				Container0.GridAllP.height = "0"
			end if
		else
			SetCallPutGrid()
		end if
		
		DATAMANAGER.RequestRealData( "ohhts_stck_incg" )
		DATAMANAGER.RequestRealData( "ohhts_sopt_cntg_1" ) '풋실시간조회
	
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	If szTranID = "ohhts_stck_incg" Then
		DATAMANAGER.SetDataValue( 1, szTranID , "InBlock1" , "RLTM_SHRN_ISCD" , 				0 , g_szJongCode )
	End If
End Sub

'============================================================================
Sub ComboYYMM_OnEditComplete(iIndex)
	Container0.GridAllC.rowcount = "0"
	Container0.GridAllP.rowcount = "0"
	GridCP.rowcount = "0"

	SetCallPutRequest()
End Sub

'============================================================================
Sub Form_OnRefresh()	
	ComboYYMM.clear = true

	Container0.GridAllC.rowcount = "0"
	Container0.GridAllP.rowcount = "0"
	GridCP.rowcount = "0"
	
	DATAMANAGER.RequestTranData( "ohhts_3072_003r" )
	DATAMANAGER.RequestTranData( "ohhts_3072_100r" )
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "REFRESH" Then
		DATAMANAGER.RequestTranData( "ohhts_3072_002r" )
	End If
End Sub


'20210630 HWG START: ATM 실시간 하이라이트 적용
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID = "ohhts_stck_incg" or szTranID = "ohhts_stck_incg_1" then
		szHyunJisu = CInt(Table0.GetCellString(0, 1))
		
		if RadioGroupCP.currentindex = "0" then
			SetAllRealAtm(szHyunJisu)
		else
			SetCallPutRealAtm(szHyunJisu)
		end if
	
	end if
End Sub

'============================================================================
Function SetCallPutRealAtm(szHyunJisu)
	nCnt = CInt(GridCP.rowcount)
	nAtm = CInt(GridCP.GetCellData("bd_cell0", g_nGIdx))
	nDiff = ABS(CInt(szHyunJisu) - nAtm) 
	nMinDiff = 0
	nMinIdx = 0
	
	for i = 0 to nCnt - 1
		nPrc = CInt(GridCP.GetCellData("bd_cell0", i))
		nHDiff = ABS(CInt(szHyunJisu) - nPrc)
		
		if i = 0 then
			nMinDiff = nHDiff
		else
			if nHDiff < nMinDiff then
				nMinDiff = nHDiff
				nMinIdx = i
			end if
		end if
	next
	
	if nMinIdx <> g_nGIdx then
		if nMinDiff < nDiff then
			GridCP.SetCellBgColor( "bd_cell0", nMinIdx, "156:255253233" )
			GridCP.SetCellBgColor( "bd_cell0", g_nGIdx, "38:255255255" )
			
'			nTopRow = 0
'			if nMinIdx > 1 then
'				nTopRow = nMinIdx - 2
'			end if
'			
'			if nTopRow ~= 0 then
'				GridCP.toprow = nTopRow		
'			end if
			
			g_nGIdx = nMinIdx
		end if
	end if
End Function

'============================================================================
Function SetAllRealAtm(szHyunJisu)
	nCnt = CInt(Container0.GridAllC.rowcount)
	nAtm = CInt(Container0.GridAllC.GetCellData("bd_cell2", g_nGIdx))
	nDiff = ABS(CInt(szHyunJisu) - nAtm) 
	nMinDiff = 0
	nMinIdx = 0
	
	for i = 0 to nCnt - 1
		nPrc = CInt(Container0.GridAllC.GetCellData("bd_cell2", i))
		nHDiff = ABS(CInt(szHyunJisu) - nPrc)
		
		if i = 0 then
			nMinDiff = nHDiff
		else
			if nHDiff < nMinDiff then
				nMinDiff = nHDiff
				nMinIdx = i
			end if
		end if
	next
	
	if nMinIdx <> g_nGIdx then
		if nMinDiff < nDiff then
			Container0.GridAllC.SetCellBgColor( "bd_cell2", g_nGIdx, "38:255255255" )
			Container0.GridAllC.SetCellBgColor( "bd_cell2", nMinIdx, "156:255253233" )
			
'			nTopRow = 0
'			if nMinIdx > 2 then
'				nTopRow = nMinIdx - 3
'			end if
'			
'			if nTopRow ~= 0 then
'				Container0.scroll_pos = (nTopRow * 47)+64
'			end if
			
			g_nGIdx = nMinId
		end if
	end if
End Function
'20210630 HWG END
'============================================================================
'20230322 SWJ START : 매수/매도 팝업 추가 
'그리드 높이 맞추기 거의 불가함 : 기종별로 다름
'따라서, 위치 상관없이 팝업 처리하는 방식으로
'============================================================================
Sub Container0_GridAllC_OnClickUp(lRow, szCellID)
	g_szItemCode = Container0.GridAllC.GetCellData("bd_callcode" , lRow)
	g_nPrice = Container0.GridAllC.GetCellData("bd_callprc" , lRow)
	g_ndebi  = Container0.GridAllC.GetCellData("bd_calldebi" , lRow)
	
	if szCellID == "bd_callprc" or szCellID == "bd_callsign" or szCellID == "bd_calldebi" then
		if g_szItemCode <> "" then
			szKorName = Form.GetItemCodeInfo(g_szItemCode, "name")
			lblLine.SetCellString(0, 0, szKorName)
			SetTblColor(g_nPrice, g_ndebi)
	
			SetPopupUI(1)
		end if
	end if
	
End Sub
'============================================================================
Sub Container0_GridAllP_OnClickUp(lRow, szCellID)	
	g_szItemCode = Container0.GridAllP.GetCellData("bd_cell3" , lRow)
	g_nPrice = Container0.GridAllP.GetCellData("bd_putprc" , lRow)
	g_ndebi  = Container0.GridAllP.GetCellData("bd_putdebi" , lRow)
	
	if szCellID == "bd_putprc" or szCellID == "bd_putsign" or szCellID == "bd_putdebi" then	
		if g_szItemCode <> "" then
			szKorName = Form.GetItemCodeInfo(g_szItemCode, "name")
			lblLine.SetCellString(0, 0, szKorName)
			SetTblColor(g_nPrice, g_ndebi)
			
			SetPopupUI(1)
		end if
	end if
End Sub

'============================================================================
Sub SetPopupUI(sVisible)
	Image0.visible = sVisible
	lblLine.visible = sVisible
	btnBuy.visible = sVisible
	btnSell.visible = sVisible
	btnMado.visible = sVisible
	btnMasu.visible = sVisible
	
	Image5.left = 0
	Image0.left = 0
	lblLine.left = 111
	btnBuy.left = 267
	btnSell.left = 18
	btnMado.left = 18
	btnMasu.left = 267
End Sub
'============================================================================
Function SetTblColor(nPrice, nPrcVrss)
	if Cdbl(nPrcVrss) > 0 then
		lblLine.SetCellFgColor(1, 0, "10")
	elseif Cdbl(nPrcVrss) < 0 then
		lblLine.SetCellFgColor(1, 0, "11")
	else
		lblLine.SetCellFgColor(1, 0, "12")
	end if
		
	lblLine.SetCellString(1, 0, nPrice)
	lblLine.SetCellString(1, 1, nPrcVrss)
	
End Function
'============================================================================
Sub Image0_OnClick()
	SetPopupUI(0)
End Sub
'============================================================================
Sub btnMado_OnClick()
	szData = "현재가" & "★" & 1 & "★" & g_szItemCode & "★" & g_nPrice
	Form.SetSharedData("FUTHYUN_RETURN" , g_nPrice)
	
	Form.OpenScreen( "31030" , szData )
	Form.CloseForm()
End Sub

'============================================================================
Sub btnMasu_OnClick()
	szData = "현재가" & "★" & 0 & "★" & g_szItemCode & "★" & g_nPrice
	Form.SetSharedData("FUTHYUN_RETURN" , g_nPrice)
	
	Form.OpenScreen( "31030" , szData )
	Form.CloseForm()
End Sub

