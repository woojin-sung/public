	<SCRIPT_INFO _len="20707" _ulen="19941" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵종합시세
' 02. 화면설명 : 선옵종합시세_주식선옵
' 03. 작    성 : 
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szJongName, g_szJongCode
Dim g_nGIdx 	'20210630 HWG : ATM 실시간 하이라이트 적용
g_nGIdx = 0

'20230322 SWJ START
Dim g_nPrice, g_szItemCode, g_ndebi 
'20230322 SWJ END
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' 콜/풋 조회
'============================================================================
Function SetCallPutRequest()
	Container0.GridAllC.rowcount = "0"
	Container0.GridAllP.rowcount = "0"
	GridCP.rowcount = "0"
		
	if RadioGroupCP.currentindex == "1" then
		DATAMANAGER.RequestTranData( "ohhts_3072_005r" ) '콜시세조회
	elseif RadioGroupCP.currentindex == "2" then
		DATAMANAGER.RequestTranData( "ohhts_3072_005r_1" ) '풋시세조회
	else
		DATAMANAGER.RequestTranData( "ohhts_3072_005r" ) '콜시세조회
		DATAMANAGER.RequestTranData( "ohhts_3072_005r_1" ) '풋시세조회
		DATAMANAGER.RequestTranData( "ohhts_3072_005r_2" ) '단축종목코드 조회 	'20230322 SWJ START
	end if	
End Function

'============================================================================
' 콜/풋 선택
'============================================================================
Sub RadioGroupCP_OnClick(nIndex)
	if nIndex == 0 then
		Container0.visible = true
		Table1.visible = true
		GridCP.visible = false
	else
		Container0.visible = false
		Table1.visible = false
		GridCP.visible = true
	end if
	
	SetCallPutRequest()
End Sub

'============================================================================
' 콜/풋 선택
'============================================================================
Function SetCallPutGrid()
	Dim nCnt, nTopRow, sTranID
	nCnt = CInt(GridCP.rowcount)
	nTopRow = 0
	
	'20210630 HWG START : ATM 실시간 하이라이트 적용
	nBaseJisu = CInt(Table0.GetCellString(0, 1))
	nMinDiff = 0
	nMinIdx = 0
	'20210630 HWG END
			
	if RadioGroupCP.currentindex == "1" then '콜
		sTranID = "ohhts_sopt_cntg"
	elseif RadioGroupCP.currentindex == "2" then '풋
		sTranID = "ohhts_sopt_cntg_1"
	end if
	
	if nCnt > 0 then
		Dim nSign, sAtm, sCode
		
		for i = 0 to nCnt-1 
			sCode = GridCP.GetCellData( "bd_code", i )
			sAtm = GridCP.GetCellData( "bd_atm", i )
			nPrc = CInt(GridCP.GetCellData( "bd_cell0", i ))	'20210630 HWG : ATM 실시간 하이라이트 적용
			
			'그리드 실시간 자동업데이트 안되서 일단 세팅
			DATAMANAGER.SetDataValue( 1, sTranID, "InBlock1", "FIDR_SHRN_ISCD" , i , sCode )
			
			'20210630 HWG START : ATM 실시간 하이라이트 적용
			nHDiff = ABS(nBaseJisu - nPrc)
			if i = 0 then
				nMinDiff = nHDiff
			else
				if nHDiff < nMinDiff then
					nMinDiff = nHDiff
					nMinIdx = i
				end if
			end if
			
'			if sAtm == "ATM" then
'				if i > 2 then
'					nTopRow = i-2
'				end if
'				
'				GridCP.SetCellBgColor( "bd_cell0", i, "156:255253233" )
'				g_nGIdx =  i	'20210630 HWG : ATM 실시간 하이라이트 적용
'			end if 
			'20210630 HWG END
		next
		
		'20210630 HWG START : ATM 실시간 하이라이트 적용
		if nMinIdx > 2 then
			nTopRow = nMinIdx-2
		end if
				
		GridCP.SetCellBgColor( "bd_cell0", nMinIdx, "156:255253233" )
		g_nGIdx =  nMinIdx
		'20210630 HWG END : ATM 실시간 하이라이트 적용
	
		if nTopRow ~= 0 then
			GridCP.toprow = nTopRow
		end if
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' 기초자산리스트 검색 팝업
'============================================================================
Sub btnSerchUNAS_OnClick()
	Form.OpenPopup( "mhprc31010_p1" , "" , "" )
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szLoadData
	
	ComboYYMM.clear = true
	
	szLoadData = Form.LoadConfigData( "mhprc31010", "mhprc31010_t2" )

	if szLoadData == nli or szLoadData == "" then
		return
	else
		szList = Split(szLoadData, "★")
			
		if UBOUND(szList) < 1 then
			Exit Sub
		End if
	
		g_szJongName = szList(0)
		g_szJongCode = szList(1)
	
		lblJongCode.caption = g_szJongName
		
		DATAMANAGER.RequestTranData( "ohhts_3072_003r" )
		DATAMANAGER.RequestTranData( "ohhts_3072_100r" )
		DATAMANAGER.RequestTranData( "ohhts_3072_002r" )
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "mhprc31010" Then
		Container0.GridAllC.rowcount = "0"
		Container0.GridAllP.rowcount = "0"
		GridCP.rowcount = "0"
	
		Dim szGetData, szList
		
		ComboYYMM.clear = true
		
		'한글종목명★단축종목코드
		szGetData = sRet
				
		If szGetData = nil or szGetData = "" Then
			return
		Else
			szList = Split(szGetData, "★")
			
			Form.SaveConfigData( "mhprc31010", "mhprc31010_t2", szGetData )
			
			if UBOUND(szList) < 1 then
				Exit Sub
			End if
		
			g_szJongName = szList(0)
			g_szJongCode = szList(1)
		
			lblJongCode.caption = g_szJongName
			
			DATAMANAGER.RequestTranData( "ohhts_3072_003r" )
			DATAMANAGER.RequestTranData( "ohhts_3072_100r" )
			DATAMANAGER.RequestTranData( "ohhts_3072_002r" )
		End If
	End If
End Sub

