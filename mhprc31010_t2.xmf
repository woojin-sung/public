		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "FID_INPUT_COND_SCR_DIV_CODE" , 	0 , "3072" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "FID_INPUT_MRKT_CLS_CODE" , 		0 , "PO" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "FID_INPUT_MTRT_CNT" , 			0 , ComboYYMM.caption )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock2" , "FID_INPUT_UNAS_ISCD" , 			0 , g_szJongCode )
	
