	<SCRIPT_INFO _len="12596" _ulen="11702" >
'============================================================================
' 01.화면명 		: 펀드매매
' 02.화면설명		: 펀드매매_신청현황/취소탭
' 03.작성		: 2016.02.19
' 04.수정		: 2020.09.15 비밀번호 메모리 평문 노출 취약점 조치 v001
'			: 21.07.07 JHY    : 고난도 업무제어 펀드건 (고난도금융투자상품에 대한 내용 추가) v002
'			: 22.06.21 임동군 : 정액매도시 신청금액이 조회되지 않는 오류 개선 v003
'                                               : 집합투자증권 매도방식구분코드 추가 v003
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szFullAcnt	'계좌번호 (8+2)
dim	g_szPasswd	'계좌비밀번호
dim	g_szAlertTitle	'알림타이틀

g_szFullAcnt	=""
g_szPasswd	=""
g_szAlertTitle	=	"알림"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()

	g_szFullAcnt= Form.GetCtlProp("#acnt01", "caption")
	
	g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")
	
	if len(trim(g_szFullAcnt))	>	8	and	len(trim(g_szPasswd))	then
			DATAMANAGER.RequestTranData("obsai_deal_070r")
	end if

End Sub


'============================================================================
'grdT401_OnClickUp
'============================================================================
Sub grdT401_OnClickUp(lRow, szCellID)
	dim	szProsYN
	dim	szFundName	'펀드명
	dim	szOrdno		'주문번호
	dim	szReqDate	'신청일자
	dim	szAplDate	'기준가적용일
	dim	szDealDate	'결제일
	dim	szBuySell	'매매구분
	dim	szReqQty		'신청좌수
	dim	szReqAmt		'신청금액
	dim	szRmndSrno	'잔고번호
	dim	szCarefulYN	'고난도 금융투자상품 숙려대상 ' 21.07.07 JHY v002
	dim	szIiscSelnFormClsCode	'집합투자증권 매도방식구분코드 v003
	
	'21.07.07 JHY START
	'v002
	szFundName	=	grdT401.GetCellData("bd_cell2", lRow)		'펀드명
	szOrdno		=	grdT401.GetCellData("bd_cell7", lRow)		'주문번호
	szReqDate	=	grdT401.GetCellData("bd_cell0", lRow)		'신청일자
	szAplDate	=	grdT401.GetCellData("bd_cell5", lRow)		'기준가적용일
	szDealDate	=	grdT401.GetCellData("bd_cell12", lRow)		'결제일
	szBuySell	=	grdT401.GetCellData("bd_cell9", lRow)		'매매구분
	szReqQtyAmt	=	grdT401.GetCellData("bd_cell10", lRow)		'신청좌수/금액
	'szReqAmt	=	grdT401.GetCellData("bd_cell11", lRow)		'신청금액
	szRmndSrno	=	grdT401.GetCellData("bd_cell8", lRow)		'잔고번호
	szCarefulYN	=	grdT401.GetCellData("bd_CarefulYN", lRow)	'고난도 금융투자상품 숙려대상 ' 21.07.07 JHY
	'21.07.07 JHY END
	szIiscSelnFormClsCode = grdT401.GetCellData("bd_SelnForm", lRow)	'v003

	if	szCellID	=	"bd_Cancel"	then
		szProsYN	=	grdT401.GetCellData("bd_cell3", lRow)
		
		if	szProsYN	=	"Y"	then
			g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")
			g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")
			
			if	len(trim(g_szPasswd))	<	4	then
				Form.ShowAlert(g_szAlertTitle, "비밀번호를 확인해 주십시오.")
				Exit Sub
			end	if
			
			if	len(trim(g_szFullAcnt))	<	8	then
				Form.ShowAlert(g_szAlertTitle, "계좌번호를 입력해 주십시오.")
				Exit Sub
			end	if
			
			Form.OpenPopup("mbfnp51010_p6" ,  szFundName & "★" & szOrdno & "★" & szReqDate & "★" 
										& szAplDate & "★" & szDealDate & "★" & szBuySell & "★" 
										& szReqQtyAmt& "★" & szRmndSrno   & "★" 
										& g_szFullAcnt & "★" & g_szPasswd & "★" & szIiscSelnFormClsCode , sPosInfo) 'v003(매도방식추가)

		elseif	szProsYN	=	"N"	then
			Form.ShowAlert(g_szAlertTitle, "해당상품은 매매취소가 불가합니다.")
		else
		end if
	
	'21.07.12 JHY START
	'v002
	elseif szCellID == "bd_CarefulBTN" then
		if szCarefulYN == "Y" then
			'21.07.20 JHY START
			Dim szCAFU_DDLN_STA_DATE, szCAFU_DDLN_FIN_DATE, szINTN_DTRM_STA_DATE, szINTN_DTRM_FIN_DATE
			Dim szSavingCode
			
			szCAFU_DDLN_STA_DATE	=	grdT401.GetCellData("bd_Date1", lRow)
			szCAFU_DDLN_FIN_DATE	=	grdT401.GetCellData("bd_Date2", lRow)
			szINTN_DTRM_STA_DATE	=	grdT401.GetCellData("bd_Date3", lRow)
			szINTN_DTRM_FIN_DATE	=	grdT401.GetCellData("bd_Date4", lRow)
			
			szSavingCode			=	grdT401.GetCellData("bd_SavingCd", lRow)
			
			Dim szReason
			szReason = "숙려제도 대상 고객"
			
			Dim szClsCode, szTrgtCode
			
			szClsCode =	grdT401.GetCellData("bd_CAFU_CLS", lRow)
			szTrgtCode =	grdT401.GetCellData("bd_CAFU_TRGT", lRow)
			
			if szClsCode == "01" and szTrgtCode == "01" then
				szReason = "고난도상품"
			elseif szClsCode == "02" and szTrgtCode == "02" then
				szReason = "만 65세 이상 투자자"
			elseif szClsCode == "02" and szTrgtCode == "03" then
				szReason = "부적합투자자"
			end if
			
			'21.07.20 JHY END
			
			Form.OpenPopup("mbonl81010_p9" ,	szRmndSrno  & "★" &  
									szFundName	& "★" & szSavingCode	& "★" &
									szReason 	& "★" & szCAFU_DDLN_STA_DATE	& "★" & szCAFU_DDLN_FIN_DATE& "★" & szINTN_DTRM_STA_DATE	& "★" & szINTN_DTRM_FIN_DATE & "★" & "mbfnp51010_t4"
						, sPosInfo)
		else
		end if
	'21.07.12 JHY END
	end	if
End Sub

'============================================================================
' grdT401_OnScrollEnd() : 연속조회
'============================================================================
Sub grdT401_OnScrollEnd()
	if  DATAMANAGER.IsMoreNextData( "obsai_deal_070r" ) == true then 
		DATAMANAGER.RequestNextData( "obsai_deal_070r" )
	end if	
End Sub

'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	g_szPasswd	=	Form.GetCtlProp("#edtPwd01", "caption")
	g_szFullAcnt	=	Form.GetCtlProp("#acnt01", "caption")

	DATAMANAGER.SetDataValue(0, "obsai_deal_070r", "InBlock1", "ACNO", 0, left(g_szFullAcnt,8))
	DATAMANAGER.SetDataValue(0, "obsai_deal_070r", "InBlock1", "ASNO", 0, mid(g_szFullAcnt,9,2))
	
	'v001
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용 / 1: 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )
	'MTS메모리평문 적용상태일 때
	if plain_rm == "1" then
		DATAMANAGER.SetDataValue(0, "obsai_deal_070r", "InBlock1", "ACNT_PWD", 0, g_szPasswd)
	else
		DATAMANAGER.SetDataValue(0, "obsai_deal_070r", "InBlock1", "ACNT_PWD", 0, Form.GetEncData(g_szPasswd))
	end if
	
	
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	dim	szDataCnt
	dim	szOrgBuySell
	dim	szDealAmt,	szDealQty
	
	szDataCnt=""
	szOrgBuySell=""
	szDealAmt=""
	szDealQty=""
	szSelnClsCode="" 'v003
	
	szDataCnt	=	DATAMANAGER.GetDataCount(0, "obsai_deal_070r", "OutBlock1")
	
	for	i=0	to	szDataCnt - 1
		szOrgBuySell	=	DATAMANAGER.GetDataValue(0, "obsai_deal_070r", "OutBlock1", "DEAL_CLS_CODE", i)
		szDealAmt	        =	DATAMANAGER.GetDataValue(0,	"obsai_deal_070r", "OutBlock1", "DEAL_AMT", i)
		szDealQty	        =	DATAMANAGER.GetDataValue(0,	"obsai_deal_070r", "OutBlock1", "DEAL_QTY", i)
		szSelnClsCode  =       DATAMANAGER.GetDataValue(0,"obsai_deal_070r", "OutBlock1", "IISC_SELN_FORM_CLS_CODE", i) 'v003

		if	szOrgBuySell	=	"2"		then		'매수
			DATAMANAGER.SetDataValue(0,	"obsai_deal_070r", "OutBlock1", "DEAL_AMT", i, szDealAmt)
		else
		        IF szSelnClsCode = "01" THEN '정액매도 v003
			    DATAMANAGER.SetDataValue(0,	"obsai_deal_070r", "OutBlock1", "DEAL_AMT", i, szDealAmt)
			ELSE
			    DATAMANAGER.SetDataValue(0,	"obsai_deal_070r", "OutBlock1", "DEAL_AMT", i, szDealQty)
			END IF
		end	if
	next	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	n070Cnt, szDataCnt
	dim	szOrgBuySell	,	szTrsBuySell
	dim	szOrgCancel	,	szTrsCancel
	dim	szOrgHourCode	,	szTrsHourCode
	
	dim  nMulti
	
	szOrgBuySell	=""
	szTrsBuySell	=""
	szOrgCancel	=""
	szTrsCancel	=""
	szOrgHourCode	=""
	szTrsHourCode =""
	
	
	if	szTranID	=	"obsai_deal_070r"	then
	
		n070Cnt 	=	grdT401.rowcount
		szDataCnt	=	DATAMANAGER.GetDataCount(0, "obsai_deal_070r", "OutBlock1")
		nMulti =  ( n070Cnt / szDataCnt ) - 1
		
		for	i=0+(nMulti * szDataCnt) to	n070Cnt-1
		
			szOrgBuySell 		=	grdT401.GetCellData("bd_cell9", i)
			szOrgCancel 	 	=	grdT401.GetCellData("bd_cell1", i)
			szOrgHourCode		=	grdT401.GetCellData("bd_cell13", i)


			'1. 매매구분코드
			szTrsBuySell	=	Form.GetMetaData("매매구분코드", szOrgBuySell)
			
			'2. 취소구분코드
			if	szOrgCancel	=	"Y"	then
				szTrsCancel	=	"취소"
			else
				szTrsCancel	=	"정상"
			end if
			
			
			'2-1 취소 구분에 따라 색상변경
			'버튼 폰트색		
			grdT401.SetCellData("bd_Cancel", i, "취소")
			
			if	szOrgCancel	=	"Y"	then		'취소
				grdT401.SetCellFgColor("bd_Cancel", i, "27")
			else								'정상
				grdT401.SetCellFgColor("bd_Cancel", i, "1")
			end	if
			
			
			'3. 시간코드
			if	szOrgHourCode	=	"01"	then
				szTrsHourCode	=	"15시"
			elseif		szOrgHourCode	=	"02"	then
				szTrsHourCode	=	"17시"
			elseif		szOrgHourCode	=	"03"	then
				szTrsHourCode	=	"13시"
			else
				szTrsHourCode	=	""
			end if
			
			grdT401.SetCellData("bd_cell9", i, szTrsBuySell)
			grdT401.SetCellData("bd_cell1", i, szTrsCancel)
			grdT401.SetCellData("bd_cell13", i, szTrsHourCode)

			'21.07.06 JHY STRAT
			'v002
			'숙려중인경우 기준가 적용일, 결제일 표시 안함
			Dim szCarefulYN
			szCarefulYN = grdT401.GetCellData("bd_CarefulYN", i)
			grdT401.SetCellData( "bd_CarefulBTN", i, "숙려내용확인")

			if szCarefulYN == "Y" then
				grdT401.SetCellData("bd_cell5", i, "")
				grdT401.SetCellData("bd_cell12", i, "")
	
				grdT401.SetCellEnable( "bd_CarefulBTN", i, true)
				
				grdT401.SetCellFgColor("bd_Cancel", i, "27")
				grdT401.SetCellEnable( "bd_Cancel", i, false)
			
			else
				grdT401.SetCellEnable( "bd_CarefulBTN", i, false)
			end if			
			'21.07.06 JHY END 
		next

	end if
End Sub


'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if	sEventName		=	"ACNTINFO_CHG"	then
		g_szFullAcnt= Form.GetSharedData("&ACCOUNT", 0 )
				
		if len(trim(g_szFullAcnt))	>	8	and	len(trim(g_szPasswd))	then
			DATAMANAGER.RequestTranData("obsai_deal_070r")
		end if

	elseif	sEventName	=	"PWDINFO_CHG"	then
		g_szPasswd	=	sParam
		
		if len(trim(g_szFullAcnt))	>	8	and	len(trim(g_szPasswd))	then
			DATAMANAGER.RequestTranData("obsai_deal_070r")
		end if
	end if
	
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if	sKeyName	=	"CANCELRETURN_070A"	then
		if	sRet	=	"Y"	then	
			Form.ShowAlert(g_szAlertTitle, "정상취소되었습니다.")
			DATAMANAGER.RequestTranData("obsai_deal_070r")
		end	if
	end	if
			

End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if	len(trim(szSubMsg))	>	0	then
		Form.ShowAlert(g_szAlertTitle, szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert(g_szAlertTitle, szErrMsg )
	end	if
End Sub

