' 화면설명 : 해외관심종목_탭
' 작    성 : 2021.04.30 ~ 2021.  .       yyj
'============================================================================
'20230109 HSZ  주간거래 시세 추가: 조회TR 교체(ohhts_1030_001r->002r), 실시간 추가(ohhts_exst_cntd)
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


' 관심그룹 Key
Dim g_szGSID 
g_szGSID = ""

' 종목선택시 연결화면(0:연결화면, 1:현재가, 2:주문, 3:차트)
DIm g_szMove
g_szMove = "0"

' 화면에서 종목추가위해 선택관심그룹명 필요
Dim g_GrpName

' 20160309 중복종목 체크
Dim g_szCd
g_szCd = ""

Dim g_szTitle
g_szTitle = "알림"

' 20160407 종목다중선택을 위해 필요한 변수
Dim g_tCode()
g_tCode = {}

'20220919 HSZ 헤더추가
Dim g_nBuffer1, g_nBuffer2
g_nBuffer1, g_nBuffer2 = 0, 0
Dim g_nNameSort1, g_nNameSort2, g_nState1
g_nNameSort1, g_nNameSort2, g_nState1 = 0, 0, 0

'20230109 HSZ 주간거래 시세 추가
Dim g_szDaysise
g_szDaysise = "0"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' init_GWList :  관심그룹의 종목 조회
'============================================================================
Function init_GWList()
	Dim szSave, sKey, sEnvKey
	sEnvKey = "INTEREST_" & Form.GetSharedData( "&USER_ID", false )
	szSave = Form.GetEnvData(sEnvKey)
	if szSave <> "" and szSave <> null then
		if szSave == "BB" then		' 최근조회 종목
			Load_RecentList()
		elseif szSave == "CC" then	' 보유종목
			Dim szScreenNum
			szScreenNum = Form.GetSharedData( "&SCREEN_NO" , false )
			
			if szScreenNum == "16110" then '해외CFD
				DATAMANAGER.RequestTranData("obsim_stsv_073r")
			else
				DATAMANAGER.RequestTranData("obsim_stsv_048r")
			end if
			
		else
			DATAMANAGER.RequestTranData("ohhts_intr_037r")
		end if
	else
		DATAMANAGER.RequestTranData("ohhts_intr_037r")
	end if
End Function

'============================================================================
' Load_RecentList :  최근조회종목 리스트
'============================================================================
Function Load_RecentList()
	Dim nHistoryCount, szItemHistory, tItemHistory, nRowCount, nCurCount, tCode, szMk, szCode
	tCode = {}
	nHistoryCount = Form.GetRecentHistoryIMaxCount()
	
	For i = nHistoryCount-1 to 0 Step -1
		szItemHistory = Form.GetRecentHistoryIMax(i)
		if( not isNull( szItemHistory ) ) then	
			tItemHistory = Split( szItemHistory, "★" )
			'20211221 HSZ START 예외처리 추가
			if UBOUND(tItemHistory) < 1 then
				Exit Function 
			End if
			'20211221 HSZ END
			if Null <> tItemHistory and #tItemHistory >= 2 then
				grdCode.insertrow = CInt(grdCode.rowcount)
				if tItemHistory[0] <> "" then
					tCode = Split(tItemHistory[0], "@")
					szMk = tCode[0]
					szCode  = tCode[1]
				end if
				
				szMk = f_getExchCode2(szMk)
				grdCode.SetCellData("bd_code", grdCode.rowcount-1, szCode)
				grdCode.SetCellData("bd_mk",   grdCode.rowcount-1, szMk)
				grdCode.SetCellData("bd_memo", grdCode.rowcount-1, "")
				grdCode.SetCellData("bd_name", grdCode.rowcount-1, tItemHistory[1])
			end if
		end if
	Next
	'20190207 LES END

	Form.SetCtlProp("#edtListCnt", "caption", grdlist0.rowcount)
	Save_grdMk()
End Function



'============================================================================
' f_getExchCode2 :  3자리 일경우 2자리로 변경
'============================================================================
Function f_getExchCode2(szExchCode3)
	if szExchCode3 == "NAS" then
		return "OQ"
	elseif szExchCode3 = "AMX" then
		return "AX"
	elseif szExchCode3 = "NYS" then
		return "NY"
	elseif szExchCode3 = "SHS" then
		return "SH"
	elseif szExchCode3 = "SZS" then
		return "SZ"
	elseif szExchCode3 = "HKS" then
		return "HK"
	elseif szExchCode3 = "TSE" then
		return "JP"
	end if
	
	return szExchCode3
End Function
'============================================================================
' Save_grdMk : 실시간을 위해 중복되지 않는 시장구분을 저장해둔다.
'============================================================================
Function Save_grdMk()
	grdMk.rowcount = 0
	
	For i = 0 to grdCode.rowcount-1
	
		szMk = Trim(grdCode.GetCellData("bd_mk", i))
		szCd = Trim(grdCode.GetCellData("bd_code", i))
		
		' MTS에서 보여주는 상품의 종목만 선택
		szMk =  f_ChkMarket(szMk, szCd)
		
		if szMk <> "" then
			nRow2 = CInt(grdMk.rowcount)
	
			if nRow2 == 0 then
				grdMk.insertrow = 0
				grdMk.SetCellData("bd_mk", 0, szMk)
				grdMk.SetCellData("bd_code", 0, szCd)
			end if
	
			For j = 0 to nRow2 - 1
				szMk2 = Trim(grdMk.GetCellData("bd_mk", j))
				
				if szMk == szMk2 then		
					szCd2 = grdMk.GetCellData("bd_code", j) & "★" & szCd
					grdMk.SetCellData("bd_code", j, szCd2)
					
					Exit For
				end if
				
				if j == nRow2 - 1 then
					grdMk.insertrow = 0
					grdMk.SetCellData("bd_mk", 0, szMk)
					grdMk.SetCellData("bd_code", 0, szCd)
				end if
			Next		
		end if
	Next

	if CInt(grdCode.rowcount) > 0 then
		' 관심종목 데이터조회
'		DATAMANAGER.RequestTranData( "ohhts_1030_001r" )
		DATAMANAGER.RequestTranData( "ohhts_1030_002r" )		'20230109 HSZ
	end if
End Function

'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	Select Case szMk
		Case "AX", "HK", "JP", "SZ", "SH", "NY", "OQ"
			return szMk
		Case Else
			return ""
	End Select
End Function

'============================================================================
' null 체크
'============================================================================
Sub isNull(str)
	if null == str or "" == str or Len(Trim(str)) <= 0 then
		return true
	end if
	
	return false
end Sub

'============================================================================
' Check_LocalOrServer : 로컬, 서버 구분하여 종목을 편집한다.
'============================================================================
Function Check_LocalOrServer()
	DATAMANAGER.RequestTranData("ohhts_intr_039r")
End Function

'============================================================================
' Change_Len
'============================================================================
Function Change_Len(szData)
	if Len(szData) == 1 then
		Change_Len = "0" & CStr(szData)
	else
		Change_Len = CStr(szData)
	end if 
End Function

'============================================================================
' Add_Item : 종목추가 20060309 , 20160407 종목다중선택위해 변수 추가
'============================================================================
Function Add_Item(nGbn)
	Dim szName, szMk, szCode
	szName, szMk, szCode = "", "", ""
	
	grdCode.insertrow = 0
	grdCode.SetCellData("bd_memo", 0, "")

	szName = Form.GetItemCodeInfo(g_szCd, "name")		' 20160325 위젯위해 종목명 추가
	if g_szCd <> "" then
		tCode = Split(g_szCd, "@")
		'20211221 HSZ START 예외처리 추가
		if UBOUND(tCode) < 1 then
			Exit Function 
		End if
		'20211221 HSZ END
		szMk = tCode[0]
		szCode = tCode[1]
	end if
	
	grdCode.SetCellData("bd_code", 0, szCode)
	grdCode.SetCellData("bd_mk",   0, szMk)
	grdCode.SetCellData("bd_name", 0, szName)		' 20160325 위젯위해 종목명 추가
	
	g_szCd = ""
	
	if nGbn == 0 then				' 20160407	
		Check_LocalOrServer()
	end if
End Function

