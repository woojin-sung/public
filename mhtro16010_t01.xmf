Sub Form_OnFormInit()
'	20220919 HSZ START : 헤더 추가
	grdlist0.setSortCellID("th_cell0","bd_name")
	grdlist0.setSortCellID("th_cell2","bd_mk")
	grdlist0.setSortCellID("th_cell4","bd_rate")
'	20220919 HSZ END
	f_EventPopup()
End Sub

'============================================================================
' 종목 추가
'============================================================================
Sub BtnItemAdd_OnClick( )
	' 최근조회, 보유종목 예외처리 ////////////////////////////////////
	szKey = g_szGSID
	
'	NOHES START 최근조회, 보유종목 추가버튼만 예외처리
	if szKey == "BB" or szKey == "CC" then
		Exit Sub
	end if
	
	Dim nRowCount
	nRowCount = CInt(grdlist0.rowcount)
	if g_nGroupCnt = 0 then
		Form.MsgBox("알림", "등록된 관심그룹이 없습니다.\n생성하시겠습니까?", "MAKE_INTEREST_GROUP", 1)
	else
		if nRowCount >= 100 then
			Form.ShowAlert( "알림", "1개의 관심그룹에는 최대 100개의 종목만 등록하실 수 있습니다. 추가하시려면 이전 종목을 삭제하거나 또는 새 그룹으로 등록하여 주십시오.")
		else
			Form.OpenCommonDialog("SEARCH", "20", grdlist0.rowcount)		'종목갯수를 플랫폼에 보낸다.
		end if
	end if
end Sub

'============================================================================
' 관심 편집
'============================================================================
Sub BtnItemEdit_OnClick()
	Form.OpenFramePopup("mhtro16010_p0" , "" , "")
end Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 메인화면에서 관심종목 조회를 요청 Trigger
	' ----------------------------------------------------------------------	
	if sEventName == "GW_LIST" then
		tData = Split(sParam, "♥")
		g_szGSID = tData[0]
		edtvrsnID.caption = tData[1]
		
		DATAMANAGER.CancelRealData("ohhts_exst_ictg")		' 실시간 해제
		DATAMANAGER.CancelRealData("ohhts_exst_cntd")		' 20230109 HSZ 주간거래 실시간 해제
		
		' 종목선택시 연결화면(0:연결화면, 1:현재가, 2:주문, 3:차트)
		g_szMove = Form.GetEnvData("GW_MOVE_OVERSEA")
		
		grdlist0.rowcount = 0
		grdCode.rowcount = 0
		
		grdList0.SetRequestUpdate("1")
		' 실시간 하이라이트 표시
		grdList0.highlightuse = "1"
		
		init_GWList()
		
	' ----------------------------------------------------------------------	
	' 종목추가
	' ----------------------------------------------------------------------	
	elseif sEventName == "GW_ADD" then
		Dim nRow
		Dim szCode, szName
		
		nRow = 0
		szCode, szName, szMk = "", "", ""
		g_tCode = {}
		if sParam <> "" then
			tData = Split(sParam, "★")
			'20211221 HSZ START 예외처리 추가
			if UBOUND(tData) < 1 then
				Exit Sub
			End if
			'20211221 HSZ END
			if Trim(tData[0]) <> "" then
				g_tCode = Split(tData[0], ":")
				nRow = grdCode.rowcount()
		
				if #g_tCode == 1 then
					For i = 0 to nRow - 1
						szCode = Trim(grdCode.GetCellData("bd_code", i))
						szMk = Trim(grdCode.GetCellData("bd_mk", i))
						
						if szMk&"@"&szCode == Trim(g_tCode[0]) then
							szName = Form.GetItemCodeInfo(tData[0], "name")
							g_szCd = g_tCode[0]
							g_GrpName = tData(1)
							Form.MsgBox(g_szTitle, szName & "은(는) 이미 등록되어 있습니다.\r\n\n중복해서 등록하시겠습니까?", "ADD_ITEM", 1)
							Exit Sub
						end if
					Next
					
					g_szCd = g_tCode[0]
					g_GrpName = tData(1)
					DATAMANAGER.CancelRealData("ohhts_exst_ictg")		' 실시간 해제
					DATAMANAGER.CancelRealData("ohhts_exst_cntd")		' 20230109 HSZ : 주간거래 실시간 해제
					Add_Item(0)
				elseif #g_tCode > 1 then
					For j = 0 to #g_tCode - 1
						For i = 0 to nRow - 1
							szCode = Trim(grdCode.GetCellData("bd_code", i))
							szMk = Trim(grdCode.GetCellData("bd_mk", i))
							
							if szMk&"@"&szCode == Trim(g_tCode[j]) then
								g_szCd = g_tCode[j]
								
								Form.MsgBox(g_szTitle, "선택종목들 중 이미 등록되어 있는 종목이 있습니다.\r\n\n중복해서 등록하시겠습니까?", "ADD_ITEMS", 1)
								Exit Sub
							end if
						Next					
					Next
					
					' 20160411 : 확인이 다 되었으면 리스트에 담는다.
					For k = 0 to #g_tCode - 1
						g_szCd = g_tCode[k]
						g_GrpName = tData(1)
						DATAMANAGER.CancelRealData("ohhts_exst_ictg")		' 실시간 해제
						DATAMANAGER.CancelRealData("ohhts_exst_cntd")		' 20230109 HSZ 주간거래 실시간 해제
						Add_Item(1)
					Next	
						
					Check_LocalOrServer()
				end if
			end if
		end if
	' ----------------------------------------------------------------------
	' FID버전 재조회
	' ----------------------------------------------------------------------	
	elseif sEventName == "NEW_FIDVRSN" then
		edtvrsnID.caption = sParam
	' ----------------------------------------------------------------------
	' 주간거래 시세 추가 20230109 HSZ
	' ----------------------------------------------------------------------	
	elseif sEventName == "DAY_CHECK" then
		g_szDaysise = sParam
		DATAMANAGER.RequestTranData( "ohhts_1030_002r" )
	end if
End Sub

'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	' 종목 추가
	if sKeyName == "ADD_ITEM" then
		if sRet == "ok" then	
			Add_Item(0)
		end if
	' 20160407 : 다건종목 추가
	elseif sKeyName == "ADD_ITEMS" then
		if sRet == "ok" then
			For j = 0 to #g_tCode - 1					
				g_szCd = g_tCode[j]
				Add_Item(1)
			Next
			
			Check_LocalOrServer()		
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 보유종목 조회
	' ----------------------------------------------------------------------	
	if szTranID == "obsim_stsv_048r" or szTranID == "obsim_stsv_073r" then
		grdCode.rowcount = "0"
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID", 0, Form.GetSharedData("&USER_ID", false))
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_037r" then
		grdCode.rowcount = "0"
		DATAMANAGER.SetDataValue(0, "ohhts_intr_037r", "InBlock1", "FID_USER_ID",          0, Form.GetSharedData("&USER_ID", false))	' USER ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_037r", "InBlock1", "FID_KIND_CODE",         0, "1")	' 통합구분 (0:국내해외통합, 1:해외주식전용)
		DATAMANAGER.SetDataValue(0, "ohhts_intr_037r", "InBlock1", "FID_CNCN_ISSU_GRP_ID", 0, g_szGSID)								' 관심그룹ID	
	' ----------------------------------------------------------------------
	' 관심종목 데이터조회	20230109 HSZ : 주간거래 시세 포함 TR로 교체
	' ----------------------------------------------------------------------
'	elseif szTranID ==  "ohhts_1030_001r" then
	elseif szTranID ==  "ohhts_1030_002r" then
		grdList0.rowcount = "0"		' 종목조회그리드 초기화
		DATAMANAGER.ClearInputData( false, "ohhts_1030_002r" )
		For i = 0 to grdCode.rowcount-1
			szMk = grdCode.GetCellData("bd_mk", i)
			szCd = Trim(grdCode.GetCellData("bd_code", i))
			tCode = {}
			
			' MTS에서 보여주는 상품의 종목만 선택
			szMk = f_ChkMarket(szMk, szCd)
			
			DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i , "OV" ) '해외주식			
			DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_INPUT_OVRS_ISCD", i , szCd ) ' 종목코드
			DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_COND_MRKT_CLS_CODE", i , szMk ) '종목시장
			' 시장별 실시간여부값
			szRealAble = Form.GetSharedData( "REALTIME_"&szMk, false )
			DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE", i , szRealAble ) '실시간여부
		Next

	' ----------------------------------------------------------------------
	' 관심 수정 TR : 종목추가
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_039r" then
		DATAMANAGER.ClearInputData(false, "ohhts_intr_039r")
		DATAMANAGER.ClearOutputData(false, "ohhts_intr_039r")
		
		Dim sGroupKey, sGroupName
		sGroupKey = g_szGSID
		sGroupName = g_GrpName
		
		if not isNull(sGroupKey) then
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock1", "FID_USER_ID",     0, Form.GetSharedData("&USER_ID", false))	' FID사용자ID
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock1", "FID_KIND_CODE",     0, "1")								' 통합구분 (0:국내해외통합, 1:해외주식전용)
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)						' FID버전ID	
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock1", "FID_MOD_YN",      0, "0")									' FID수정여부				
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock1", "FID_ISSU_MOD_YN", 0, "0")									' FID종목수정여부
			
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock2", "FID_CNCN_ISSU_GRP_ID", 0, sGroupKey)						' FID관심종목그룹ID
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock2", "FID_CNCN_GRP_NAME",    0, sGroupName)						' FID관심그룹명	
			DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock2", "FID_ISSU_MOD_YN",      0, "1")

			For j = 0 to grdCode.rowcount - 1
				' FID관심종목그룹			
				DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_CNCN_ISSU_GRP_ID",    j, g_szGSID)
				' FID관심종목
				DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_CNCN_ISSU_ID2",       j, Change_Len(j))
				' FID코드구분코드
				if Trim( grdCode.GetCellData("bd_mk", j)) == "" then													
					if Trim(grdCode.GetCellData("bd_name", j)) == "" then
						DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_CODE_CLS_CODE", j, "2")	' 빈칸
					else
						DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_CODE_CLS_CODE", j, "3")	' 메모
					end if
				else
					DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_CODE_CLS_CODE", j, "1")		' 종목
				end if
	
				' FID입력시장구분코드
				DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_INPUT_MRKT_CLS_CODE", j, "OV")					
				DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_COND_MRKT_CLS_CODE", j, grdCode.GetCellData("bd_mk", j) )' FID입력시장구분코드	
				
				' FID관심종목코드 / FID메모내용
				if Trim(grdCode.GetCellData("bd_code", j)) == "빈칸" then
					DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_OVDV_ISCD", j, "EMPTY")
					DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_MEMO_CNTT", j, grdCode.GetCellData("bd_memo", j))	
				else
					DATAMANAGER.SetDataValue(0, "ohhts_intr_039r", "InBlock3", "FID_OVDV_ISCD", j, grdCode.GetCellData("bd_code", j))
				end if
			Next
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranData
'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_intr_037r" then
		Dim nCnt
		Dim szCode
		
		nCnt = DATAMANAGER.GetDataCount(0, "ohhts_intr_037r", "OutBlock1")
		
		For i = 0 to nCnt-1
			szCode = Trim(DATAMANAGER.GetDataValue(0, "ohhts_intr_037r", "OutBlock1", "FID_OVDV_ISCD", i))
			
			if szCode == "EMPTY" then
				DATAMANAGER.SetDataValue(0, "ohhts_intr_037r", "OutBlock1", "FID_OVDV_ISCD", i, "빈칸")
			end if
		Next
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szCd, szMk, szMm, tCode, szCutCd, szName, szOnline, szPre
	tCode = {}
	'  보유종목/관심종목 종목 
	if szTranID == "obsim_stsv_048r" or szTranID == "ohhts_intr_037r" 
		or szTranID == "obsim_stsv_073r" then '20220118 아이티젠 김성수 추가
		
		if szTranID == "obsim_stsv_048r" then
			nCnt = DATAMANAGER.GetDataCount(0, "obsim_stsv_048r", "OutBlock1")
			
			if nCnt > 0 then
				nRow = 0
				
				For i = 0 to nCnt -1 
					szCd = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "ISCD", i)
					szName = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "KOR_NAME", i)
					szOnline = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "ONLN_YN", i)
					szPre = DATAMANAGER.GetDataValue(0, "obsim_stsv_048r", "OutBlock1", "CLPR", i)
					
					grdCode.insertrow = nRow
					
					if Trim(szCd) <> "" then
						tCode = Split(szCd, ".")
						szCutCd = tCode[0]
						szMk = tCode[1]
						
						'20220811 SWJ START : "."이 종목코드에 들어간 종목 화면 파싱 오류
						if instr(szCd,".") <> instrRev(szCd,".") then
							szMk 	= Right(szCd,len(szCd) - instrRev(szCd,"."))			
							szCutCd  = Replace(szCd,"." & szMk,"")
						end if
						'20220811 SWJ END
					end if
					
					grdCode.SetCellData("bd_code", nRow, szCutCd )
					grdCode.SetCellData("bd_mk",   nRow, szMk)
					grdCode.SetCellData("bd_online",   nRow, szOnline)
					grdCode.SetCellData("bd_pre",   nRow, szPre)
					
					' 오프라인종목일경우 종목명은 서비스에서 받아씀
					if szOnline == "N" then
						grdCode.SetCellData("bd_name", nRow, szName)
					else
						grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szMk&"@"&szCutCd, "name"))
					end if
					
					nRow = nRow + 1
				Next
			end if
		
		'20220118 아이티젠 김성수 추가 START
		elseif szTranID == "obsim_stsv_073r" then
			nCnt = CInt(DATAMANAGER.GetDataCount(0, "obsim_stsv_073r", "OutBlock1"))
			
			if nCnt > 0 then
				nRow = 0
				
				For i = 0 to nCnt -1 
					szCd = DATAMANAGER.GetDataValue(0, "obsim_stsv_073r", "OutBlock1", "ISCD", i)
					szName = DATAMANAGER.GetDataValue(0, "obsim_stsv_073r", "OutBlock1", "KOR_NAME", i)
					
					grdCode.insertrow = nRow
					
					if Trim(szCd) <> "" then
						tCode = Split(szCd, ".")
						szCutCd = tCode[0]
						szMk = tCode[1]
						
						'20220811 SWJ START : "."이 종목코드에 들어간 종목 화면 파싱 오류
						if instr(szCd,".") <> instrRev(szCd,".") then
							szMk 	= Right(szCd,len(szCd) - instrRev(szCd,"."))			
							szCutCd  = Replace(szCd,"." & szMk,"")
						end if
						'20220811 SWJ END
					end if
					
					grdCode.SetCellData("bd_code", nRow, szCutCd )
					grdCode.SetCellData("bd_mk",   nRow, szMk)
					grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szMk&"@"&szCutCd, "name"))
					
					nRow = nRow + 1
				Next
			end if
		'20220118 아이티젠 김성수 추가 END
		' 관심종목 종목 조회
		elseif szTranID == "ohhts_intr_037r" then
			nRow = grdCode.rowcount
			Dim szName, tCode, szMk, szCode
			tCode = {}
			szMk = ""
			szName = ""
			szCode = ""
			For i = 0 to nRow - 1 
				szCode = grdCode.GetCellData("bd_code", i)
				szMk = grdCode.GetCellData("bd_mk", i)
				szName = Form.GetItemCodeInfo(szMk&"@"&szCode, "name")
				
				grdCode.SetCellData("bd_code", i, szCode )
				grdCode.SetCellData("bd_mk", i, szMk)
				grdCode.SetCellData("bd_name", i, szName)
			Next
		end if
		
		' 메인화면에서 종목추가 가능하므로 메인화면에 종목리스트 카운트를 알린다.
		Form.SetCtlProp("#edtListCnt", "caption", grdCode.rowcount)

		Save_grdMk()		
	' ----------------------------------------------------------------------
	' 관심종목 종목데이터 조회
	' ----------------------------------------------------------------------
'	elseif szTranID == "ohhts_1030_001r" then
	elseif szTranID == "ohhts_1030_002r" then	'20230109 HSZ 주간시세 포함 조회TR로 교체
		Dim tItemData, nIndex, sCellBong, szMk, szKormarket, szOnline, szOfflineName, szOfflinePre
		szKormarket = ""
		DATAMANAGER.CancelRealData("ohhts_exst_ictg")
		DATAMANAGER.CancelRealData("ohhts_exst_cntd")	'20230109 HSZ 주간거래 실시간 해제
		
		grdlist0.SetClear()
		

		nCount = CInt( DATAMANAGER.GetDataCount(0,"ohhts_1030_002r", "OutBlock1" ) )
		
		grdlist0.rowcount = nCount
		
		Dim nRequestCount
		nRequestCount = 0
		'20230109 HSZ START : 주간거래 실시간
		Dim nRequestCount1, nRequestCount2
		nRequestCount1 = 0
		nRequestCount2 = 0
		'20230109 HSZ END
		For i = 0 to grdCode.rowcount - 1
			
			szMm = grdCode.GetCellData("bd_memo", i)
			szCd = grdCode.GetCellData("bd_code", i)
			szMk = grdCode.GetCellData("bd_mk", i)
			szOnline = grdCode.GetCellData("bd_online", i)
			szOffLineName = grdCode.GetCellData("bd_name", i)
			szOfflinePre = grdCode.GetCellData("bd_pre", i)

			Dim tCode
			
			if Trim(szMm) <> "" then
				grdList0.SetPropGridCell("memo", "bd_code", i, szMm)
			end if	
			
			For j = 0 to nCount-1
				grdlist0.SetMaintainingRatio("bd_realicon", j, "1")	'20230707 HSZ
				code = DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_ISCD" , j ) 
				nDtclose	= Cdbl(DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRPR", j ))	'20230109 HSZ
				
				if code == szCd and Trim(code) <> "" then	'20230518 HSZ : 빈값체크로직 추가
					if szMk == "AX" then
						szKormarket = "아멕스"
					elseif szMk == "HK" then
						szKormarket = "홍콩"
					elseif szMk == "JP" then
						szKormarket = "도쿄"
					elseif szMk == "SZ" then
						szKormarket = "심천"
					elseif szMk == "SH" then
						szKormarket = "상해"
					elseif szMk == "NY" then
						szKormarket = "뉴욕"
					elseif szMk == "OQ" then
						szKormarket = "나스닥"
					end if
					
					'20230109 HSZ START : 주간시세 적용 분기 구문
					if g_szDaysise = "1" and nDtclose <> 0 then '주간시세 체크O & 주간시세 종목O
						symbol		= szMk
						korname		= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_KOR_ISNM" , j )					
						sDtclose		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRPR", j )
						sclose		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_PRPR", j )
						diff			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRDY_VRSS" , j )
						rate			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRDY_CTRT" , j )
						tvol			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_ACML_VOL" , j )
						sdecimal		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DCPN_CNT", j )
						open			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_OPRC" , j )
						high			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_HPRC", j )
						low			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_LPRC", j )
						grdlist0.SetCellData( "bd_hyun" , j, Decimal_Setting( sDtclose , sdecimal ) )
					else
						'code		= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "code" , j )
						symbol		= szMk
						korname		= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_KOR_ISNM" , j )					
						sclose		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_PRPR", j )
						'sign			= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "sign" , j )
						diff			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_VRSS" , j )
						rate			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_CTRT" , j )
						tvol			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_ACML_VOL" , j )
						'isvalid		= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "isvalid" , j )
						sdecimal		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DCPN_CNT", j )
						'market		= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "market" , j )
						'orgcode		= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "orgcode" , j )
						'accessibility	= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "accessibility" , j )
		'				realcode		= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "realcode" , j )
						open			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_OPRC" , j )
						high			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_HPRC", j )
						low			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_LPRC", j )
						'pbid			= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "pbid" , j )
						'pask			= DATAMANAGER.GetDataValue( false, "getGtsInterest", "priceList", "pask" , j )
						grdlist0.SetCellData( "bd_hyun" , j, Decimal_Setting( sclose , sdecimal ) )
					end if
					'20230109 HSZ END
					
					sCellBong  = "|" & open & "|" & high & "|" & low & "|" & sclose

					grdlist0.SetCellData( "bd_code" , j, szMk&"@"&szCd )
					grdlist0.SetCellData( "bd_name" , j, korname )
'					grdlist0.SetCellData( "bd_hyun" , j, Decimal_Setting( sclose , sdecimal ) )	'20230109
					grdlist0.SetCellData( "bd_debi" , j, Decimal_Setting( diff , sdecimal ) )
					grdlist0.SetCellData( "bd_codeSub" , j, szCd )
					grdlist0.SetCellData( "bd_mk" , j, szKormarket )
					grdlist0.SetCellData( "bd_vol" , j, tvol )
					grdlist0.SetCellData( "bd_rate" , j, rate )
					grdlist0.SetCellData( "bd_bong" , j, sCellBong )
					grdlist0.SetCellData( "bd_decimal", j, sdecimal )
					grdlist0.SetCellData( "bd_symbol", j, symbol )
					grdlist0.SetCellData( "bd_market", j, szMk )
					
					' 시장별 실시간여부값
					szRealAble = Form.GetSharedData( "REALTIME_"&szMk, false )					
					
'					' 실시간	20230109 HSZ : 기존 소스 주석처리 (->settingRealTime(nIndex, szRealAble))
'					if szRealAble == "0" then
'						grdlist0.SetCellData( "bd_realicon", i, "realtime_red" )
'					' 실시간아님
'					elseif szRealAble == "1" then
'						grdlist0.SetCellData( "bd_realicon", i, "realtime_gray" )
'					end if
					
					swapItemColor( j, CDbl(diff))
					
					'20230109 HSZ START : 주간거래 실시간 체크 분기처리 추가
					if g_szDaysise = "1" then	'주간거래 실시간 체크 -> 미국장은 주간거래 실시간만 받도록
						if szMk == "AX" or szMk == "NY" or szMk == "OQ" then
							grdlist0.SetCellData( "bd_realicon", i, "realtime_green" )	'실시간 표시
							DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntd", "InBlock1", "FIDXR_ISCD" , nRequestCount1 , szMk&"@"&szCd)
							nRequestCount1 = nRequestCount1 + 1
						else
							settingRealTime(i, szRealAble)
							DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , nRequestCount2 , szMk&"@"&szCd)
							nRequestCount2 = nRequestCount2 + 1
						end if
					'20230109 HSZ END
					else
						settingRealTime(i, szRealAble)
						DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , nRequestCount , szMk&"@"&szCd)
						nRequestCount = nRequestCount + 1
						
					end if
				else
					' 오프라인 종목일경우 obsim_stsv_048r 에서 나온 현재가, 종목명 등을 사용
					if szOnline == "N" then
						grdlist0.SetCellData( "bd_code" , i, szMk&"@"&szCd )
						grdlist0.SetCellData( "bd_name" , i, szOffLineName )
						grdlist0.SetCellData( "bd_hyun" , i, szOfflinePre )
						grdlist0.SetCellData( "bd_codeSub" , i, szCd )
						grdlist0.SetCellData( "bd_online" , i, szOnline )
					end if
				end if
			Next
		Next
		grdlist0.keyall = "1"
		'20230109 HSZ START : 주간거래 실시간 체크 분기처리 추가
		if g_szDaysise = "1" then	'주간거래 실시간 체크 -> 미국장은 주간거래 실시간만 받도록
			DATAMANAGER.RequestRealData("ohhts_exst_ictg")
			DATAMANAGER.RequestRealData("ohhts_exst_cntd")
		else
			DATAMANAGER.RequestRealData("ohhts_exst_ictg")
		end if
		'20230109 HSZ END
	' ----------------------------------------------------------------------
	' 관심 수정 TR : 종목추가
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_039r" then
		Form.SetCtlProp("#edtvrsnID", "caption", edtvrsnID.caption)
		Form.SetCtlProp("#edtListCnt", "caption", grdCode.rowcount)
		
		Save_grdMk()
		
	end if
End Sub

'============================================================================
' 입력값조절
'============================================================================
Sub Decimal_Setting(sValue, sDecimalLen)
	Dim sReturn
	sReturn = sValue
	if ( sValue ~= nil and sValue ~= "" ) and ( sDecimalLen ~= nil and sDecimalLen ~= "" ) then
		Dim sSign
		Dim nDecimal
		sSign = Left(sValue, 1)
		nDecimal = CDbl(sDecimalLen)
		if CDbl( sValue ) == 0 then
			if nDecimal > 0 then
				sReturn = "0."
				for i = 0 to nDecimal-1
					sReturn = sReturn.."0"
				next
			else
				sReturn = "0"
			end if			
		else
			Dim sTemp
			sTemp = {}
			sTemp = Split( sValue, "." )
			if nDecimal > 0 then
				if #sTemp >= 2 and sTemp[1] ~= nil and sTemp[1] ~= "" then
					Dim tempLen
					tempLen = Len(sTemp[1])
					if tempLen > nDecimal then
						sReturn = sTemp[0].."."..Left(sTemp[1], nDecimal)
					elseif tempLen < nDecimal then
						sReturn = sTemp[0].."."..sTemp[1]
						for i = 0 to (nDecimal-tempLen)-1
							sReturn = sReturn.."0"
						next
					end if
				else
					sReturn = sReturn.."."
					for i = 0 to (nDecimal)-1
						sReturn = sReturn.."0"
					next
				end if
			end if			
		end if
	end if
	
	if sSign == "-" or sSign == "+" then
		sReturn = sSign..sReturn
	end if
	
	return sReturn
end Sub

'============================================================================
' 2017.11.22 -  LSS : 종목 대비값에 따른 색상 및 대비부호 설정
'============================================================================
Function swapItemColor(nIndex, nDiff)
	grdlist0.SetCellFgColor( "bd_hyun", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
	grdlist0.SetCellFgColor( "bd_debi", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
	grdlist0.SetCellFgColor( "bd_rate", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
	grdlist0.SetCellData( "bd_debiIcon", nIndex, nDiff > 0 and "2" or ( nDiff < 0 and "5" or "0" ) )
End Function
'============================================================================
' 2023.02.06 -  HSZ : 실시간 여부에 따른 이미지 설정
'============================================================================
Function settingRealTime(nIndex, szRealAble)
	' 실시간	
	if szRealAble == "0" then
		grdlist0.SetCellData( "bd_realicon", nIndex, "realtime_green" )
	' 실시간아님
	elseif szRealAble == "1" then
		grdlist0.SetCellData( "bd_realicon", nIndex, "realtime_grey" )
	end if
End Function
	
'============================================================================
' grdlist0_OnClickUp : 현재가 그리드 클릭
'============================================================================
Sub grdlist0_OnClickUp(lRow, szCellID)
	szCd = grdList0.GetCellData("bd_code", lRow)
	szOnline = grdList0.GetCellData("bd_online", lRow)
	
	if Trim(szCd) == "" then
		Exit Sub
	end if	
	
	' 오프라인종목일 경우 진행하지않음
	if Trim(szOnline) == "N" then
		Form.ShowAlert( "알림", "현재 화면에서 거래가 불가한 종목입니다. (오프라인 거래국가 조회불가)" )
		Exit Sub
	end if	
	
	Dim sKorname
	
	
	sKorname = grdlist0.GetCellData( "bd_name", lRow )
	
	
	
	if g_szMove == "0" or g_szMove == "" then ' 연결팝업
		if Trim(szCd) <> "" then
			listLocation =  Split(grdlist0.location,":")
			'20211221 HSZ START 예외처리 추가
			if UBOUND(listLocation) < 1 then
				Exit Sub
			End if
			'20211221 HSZ END
			nYPos = Int(listLocation[1])
			szData = szCd.."^"..sKorname.."^"..nYPos
			
			Form.OpenPopup("mhtro16010_p4" , szData , "")
		end if
	elseif g_szMove == "1" then ' 현재가
			Form.SetSharedData( "&ITEM_CODE" , szCd )
			Form.SetSharedData( "&ITEM_KORNAME" , sKorname )	
			
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szCd.."★"..sKorname.."★".."", "" )
			Form.OpenScreen("16000", "")
			Form.CloseForm( )
	elseif g_szMove == "2" then ' 주문
			Form.SetSharedData( "&ITEM_CODE" , szCd )
			Form.SetSharedData( "&ITEM_KORNAME" , sKorname )	
			
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szCd.."★"..sKorname.."★".."", "" )
			szMediaCode = Form.GetSharedData("&MEDIA_CODE", false)
			
			if szMediaCode = "156" or szMediaCode = "157" then
				Form.OpenScreen("16060", "")
			elseif szMediaCode = "158" or szMediaCode = "159" then
				Form.OpenScreen("02000", "")
			end if
	elseif g_szMove == "3" then ' 차트
		Form.SetSharedData( "&ITEM_CODE" , szCd )
		Form.SetSharedData( "&ITEM_KORNAME" , sKorname )	
		
		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szCd.."★"..sKorname.."★".."", "" )
		Form.OpenScreen("16020", "")
		Form.CloseForm( )
	end if 
End Sub

'============================================================================
' 해외주식 공지팝업
'============================================================================
function f_EventPopup()
    Dim szEndDate
    Dim szToday
    Dim szDate
    Dim nDiffDay
    
	'20200526 SWJ START : MTS 해외주식 실시간 서비스 비용 변동 안내 팝업
    szMediaCode = Form.GetSharedData("&MEDIA_CODE", false )
    if szMediaCode = "156" or szMediaCode = "157" then
	    szEndDate = "20200612"                            	' 팝업노출일
	    szToday = Form.GetSharedData("&HOST_DATE", false )    ' 현재일
	    szDate = Form.GetEnvData("EVENT_DATE_YH")            ' 일주일간 열지 않기 체크한 날짜
    
	    if tonumber(Form.DiffDate(szToday, szEndDate)) >= 0 then
			if szDate == null or szDate == "" then
			    Form.OpenPopup("popup_noti", "" , "")
			else
			    nDiffDay =  tonumber(Form.DiffDate(szDate, szToday))
			    if nDiffDay > 7 then
					Form.SetEnvData(0, "EVENT_DATE_YH", "")
					Form.OpenPopup("popup_noti", "" , "")
			    end if
			end if
	    end if
	end if
	'20200526 SWJ END

end function

'============================================================================
Sub grdlist0_OnHeaderClickUp(lRow, szCellID)
	Dim sText
	if szCellID == "th_cell0" then
		if g_nBuffer1 == 0 then
			g_nBuffer1 = 1
			sText = "종목명"
		else
			if g_nNameSort1 == 0 then
				g_nNameSort1 = 1
'				sText = "종목명▼"	'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
				sText = "종목명"	
			elseif g_nNameSort1 == 1 then
				g_nNameSort1 = 2
'				sText = "종목명▲"	'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
				sText = "종목명"
			elseif g_nNameSort1 == 2 then
				g_nNameSort1 = 0
				sText = "종목명"
			end if
		end if
		grdlist0.SetCellTopCaption( szCellID, sText )
		grdlist0.SetCellTopCaption( "th_cell2", "거래소" )
		grdlist0.SetCellTopCaption( "th_cell4", "등락률" )
	end if
	if szCellID == "th_cell2" then
		if g_nBuffer2 == 0 then
			g_nBuffer2 = 1
			sText = "거래소"
		else
			if g_nNameSort2 == 0 then
				g_nNameSort2 = 1
'				sText = "거래소▼"	'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
				sText = "거래소"
			elseif g_nNameSort2 == 1 then
				g_nNameSort2 = 2
'				sText = "거래소▲"	'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
				sText = "거래소"
			elseif g_nNameSort2 == 2 then
				g_nNameSort2 = 0
				sText = "거래소"
			end if
		end if
		grdlist0.SetCellTopCaption( szCellID, sText )
		grdlist0.SetCellTopCaption( "th_cell0", "종목명" )
		grdlist0.SetCellTopCaption( "th_cell4", "등락률" )
	end if
	if szCellID == "th_cell4" then
		if g_nState1 == 0 then
			g_nState1 = 1
'			sText = "등락률▼"	'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
			sText = "등락률"
		elseif g_nState1 == 1 then
			g_nState1 = 2
'			sText = "등락률▲"	'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
			sText = "등락률"
		elseif g_nState1 == 2 then
			g_nState1 = 0
			sText = "등락률"
		end if
		grdlist0.SetCellTopCaption( szCellID, sText )	
		grdlist0.SetCellTopCaption( "th_cell0", "종목명" )
		grdlist0.SetCellTopCaption( "th_cell2", "거래소" )
	end if
End Sub

