'============================================================================
' 01. 화 면 명 : 선옵 가상체결증거금 조회
' 02. 화면설명 : 선옵 가상체결증거금 조회 폼탭
' 03. 작    성 : 2016.01.12 ~ 최지희
'              : 2020.09.10 V001. 윤현수 MTS메모리보안적용
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_nAccountNumber	'계좌번호 8글자 ex)18431988
Dim g_nAccountSerialNumber	'계좌 일련번호 2글자 ex)01
Dim g_szAccountPassword		'계좌비밀번호
Dim g_szData			'계좌번호★일련번호★비밀번호  ex) 18431988★01★12345678
Dim g_nDataStartRow
Dim g_szChoiceRow		'가상잔고 선택된 row값		
Dim h

Dim g_sFlag '기존가상잔고("0")/추가가상잔고("1")
'V001
Dim plain_rm 'MTS메모리평문 적용유무	

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)
	if szTranID == "ohhts_jong_002r" then		'선물옵션(호가)
		DATAMANAGER.RequestTranData("ohhts_jong_002r")
	elseif szTranID == "ohhts_jong_002r_1" then
		DATAMANAGER.RequestTranData("ohhts_jong_002r_1")
	elseif szTranID == "obtrf_oder_606r" then	'장내파생현재시세
		DATAMANAGER.SetDataValue(0,"obtrf_oder_606r", "InBlock1", "ACNO" , 0 , g_nAccountNumber)
		DATAMANAGER.SetDataValue(0, "obtrf_oder_606r", "InBlock1", "ASNO", 0 , g_nAccountSerialNumber)
		DATAMANAGER.RequestTranData("obtrf_oder_606r")
	elseif szTranID == "obtrf_oder_606r_1" then	'장내파생현재시세
		DATAMANAGER.SetDataValue(0,"obtrf_oder_606r_1", "InBlock1", "ACNO" , 0 , g_nAccountNumber)
		DATAMANAGER.SetDataValue(0, "obtrf_oder_606r_1", "InBlock1", "ASNO", 0 , g_nAccountSerialNumber)
		DATAMANAGER.RequestTranData("obtrf_oder_606r_1")
	elseif szTranID == "obtrf_cntg_302r" then	'장내파생기존잔고내역조회
		DATAMANAGER.SetDataValue(0,"obtrf_cntg_302r", "InBlock1", "ACNO", 0 , g_nAccountNumber)
		DATAMANAGER.SetDataValue(0,"obtrf_cntg_302r", "InBlock1", "ASNO", 0 , g_nAccountSerialNumber)
		DATAMANAGER.SetDataValue(0,"obtrf_cntg_302r", "InBlock1", "ACNT_PWD", 0 , g_szAccountPassword)
		DATAMANAGER.RequestTranData("obtrf_cntg_302r")
	end if
End Function


'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	'V001
	'MTS메모리평문 적용유무 (0:미적용 / 1:적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false )

	g_nAccountNumber = cmbAccount.total
	g_nAccountSerialNumber = cmbAccount.sequence
	'g_szAccountPassword = Form.GetEncData(edtPassword.caption)	
	'V001
	'MTS 메모리평문 적용상태일때
	if plain_rm == "1" then
		g_szAccountPassword = edtPassword.caption
	'MTS메모리평문 미적용상태일때
	else
		g_szAccountPassword = Form.GetEncData(edtPassword.caption)	
	end if
	
	g_szData = g_nAccountNumber & "★" & g_nAccountSerialNumber & "★" & g_szAccountPassword
	g_nDataStartRow = 0 
	btnSearch_OnClick()
End Sub

'============================================================================
' btnSearch_OnClick - 조회버튼
'============================================================================
Sub btnSearch_OnClick()
	g_szData = g_nAccountNumber & "★" & g_nAccountSerialNumber & "★" & g_szAccountPassword
	Form.triggerEvent("fmtabImagineSignDeposit." & fmtabImagineSignDeposit.currenttabpageid, "ExistBalance", g_szData)	'기존잔고
	Form.triggerEvent("fmtabImagineSignDeposit." & fmtabImagineSignDeposit.currenttabpageid, "NonTighteningHistory", g_szData)	'미체결내역
	g_nDataStartRow = 0
'	tempImageData = "" 
	grdImageBalance.SetClear( )
	Grid1.SetClear()
	h=0
	TR_Inquiry("obtrf_cntg_302r")
End Sub

'============================================================================
' fmtabImagineSignDeposit_OnTabChanged
'============================================================================
Sub fmtabImagineSignDeposit_OnTabChanged(nCurrentTab)
	g_szData = g_nAccountNumber & "★" & g_nAccountSerialNumber & "★" & g_szAccountPassword

	if nCurrentTab == 0 then
		Form.triggerEvent("fmtabImagineSignDeposit." & fmtabImagineSignDeposit.currenttabpageid, "ExistBalance", g_szData)	'기존잔고
	elseif nCurrentTab == 1 then
		Form.triggerEvent("fmtabImagineSignDeposit." & fmtabImagineSignDeposit.currenttabpageid, "NonTighteningHistory", g_szData)	'미체결내역
	end if
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "ImagineBalance" then		'기존잔고에서 선택되어 들어온 데이터들
		Dim szList
		Dim szIscd	'종목코드
		Dim szSort	'구분(매수/매도)
		Dim szAmount	'수량
		Dim szPrice	'매입가
		Dim szPosition	'포지션코드
		Dim szInterlock	'종목연동'
		Dim szTempIscd		
		
		szList = Split(sParam, "★")
		
		if UBOUND(szList) < 1 then
			exit sub
		end if
		
		szIscd = szList(0)	'종목코드
		szSort = szList(1)	'구분(매수/매도)
		szAmount = szList(2)	'수량
		szPrice = szList(3)	'매입가
		szPosition = szList(4)	'1/2
		szInterlock = szList(5)	'종목코드 1~12자리	
		
		szTempIscd = Mid(szIscd, 2, 8)
		
		'//////종목코드 연동/////////////
		Dim nDataCount
		nDataCount = grdImageBalance.rowcount	
		
		if nDataCount > "0" then	'가상잔고에 데이터 있으면		
			for i=0 to nDataCount				
				if szTempIscd == grdImageBalance.GetCellData( "bd_cell0", i ) then					
					Form.MsgBox("알림", "이미 추가된 종목입니다.", "", 0)
					exit sub
				end if
			next
		end if		
		
		if nDataCount == 0 then
			g_nDataStartRow = 0
		else 
			g_nDataStartRow = nDataCount
			grdImageBalance.insertrow = g_nDataStartRow	'한 행을 추가한다 
		end if
	
		'//////종목코드 연동/////////////
		
		grdImageBalance.SetCellData( "bd_cell0", g_nDataStartRow, szTempIscd )	'종목코드(101ㅣ3000)
		grdImageBalance.SetCellData( "bd_cell1", g_nDataStartRow, szSort )		'구분(매수/매도)

		if Trim(szList(1)) == "매도" then
			grdImageBalance.SetCellFgColor( "bd_cell1", g_nDataStartRow, "7")
		elseif Trim(szList(1)) == "매수" then
			grdImageBalance.SetCellFgColor( "bd_cell1", g_nDataStartRow, "6")
		end if
		
		grdImageBalance.SetCellData( "bd_cell2", g_nDataStartRow, szAmount )		'수량
		grdImageBalance.SetCellData( "bd_cell3", g_nDataStartRow, szPrice )		'가격
		grdImageBalance.SetCellData( "bd_cell4", g_nDataStartRow, "" )	'신규위탁	
		grdImageBalance.SetCellData( "bd_cell5", g_nDataStartRow, szPosition )	'포지션코드
		grdImageBalance.SetCellData( "bd_cell6", g_nDataStartRow, szIscd )		'전체종목코드

		'//////신규주문증거금 연동/////////////		
		Dim szUIscd, szVidCode
		szUIscd = UCase(Trim(szIscd))
		
		if Mid(szUIscd, 1, 1) == "K" then
			szUIscd = Mid(szUIscd, 2, 8)
		end if
		
		if Mid(szUIscd, 1, 1) == "1"  or Mid(szUIscd, 1, 1) == "A" then
			if Mid(szUIscd, 2, 2) == "01" then
				szVidCode = "F"
				
			elseif Mid(szUIscd, 2, 2) == "05" then
				szVidCode = "MF"
				
			elseif Mid(szUIscd, 2, 2) == "03" then
				szVidCode = "SF"
				
			else
				szVidCode = "JF"
			end if
			
		elseif Mid(szUIscd, 1, 1) == "2"  or Mid(szUIscd, 1, 1) == "B" then
			if Mid(szUIscd, 2, 2) == "01" then
				szVidCode = "O"
				
			elseif Mid(szUIscd, 2, 2) == "03" then
				szVidCode = "SF"
				
			elseif Mid(szUIscd, 2, 2) == "05" then
				szVidCode = "MO"
				
			elseif Mid(szUIscd, 2, 2) == "09" or Mid(szUIscd, 2, 2) == "AF"  then
				szVidCode = "WO"
				
			else 
				szVidCode = "JO"
			end if
		elseif Mid(szUIscd, 1, 1) == "3" or Mid(szUIscd, 1, 1) == "C" then
			if Mid(szUIscd, 2, 2) == "01" then
				szVidCode = "O"
				
			elseif Mid(szUIscd, 2, 2) == "03" then
				szVidCode = "SF"
			
			elseif Mid(szUIscd, 2, 2) == "05" then
				szVidCode = "MO"
				
			elseif Mid(szUIscd, 2, 2) == "09" or Mid(szUIscd, 2, 2) == "AF"  then
				szVidCode = "WO"
				
			else
				szVidCode = "JO"
			end if
		end if
		
		DATAMANAGER.SetDataValue(0,"ohhts_jong_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , szVidCode)
		DATAMANAGER.SetDataValue(0,  "ohhts_jong_002r", "InBlock1", "FID_INPUT_ISCD", 0 , szUIscd)
		
		TR_Inquiry("ohhts_jong_002r")
		
		'신규주문증거금 셋팅
		
		Dim szOldSetting, szOldItemCode
		szOldSetting = UCase(Trim(szIscd))
		
		if Mid(szOldSetting, 1, 1) <> "K" then
			szOldItemCode = "K" & szOldSetting
		else
			szOldItemCode = szOldSetting
		end if
		
		DATAMANAGER.SetDataValue(0, "obtrf_oder_606r", "InBlock1", "PROS_CLS" , 0 , "2")	'처리구분
		DATAMANAGER.SetDataValue(0,  "obtrf_oder_606r", "InBlock1", "ISCD", 0 , szOldItemCode)	'종목코드
		DATAMANAGER.SetDataValue(0, "obtrf_oder_606r", "InBlock1", "DEAL_CLS_CODE", 0 , Trim(szPosition))
		DATAMANAGER.SetDataValue(0, "obtrf_oder_606r", "InBlock1", "ODQT" , 0 , Trim(szAmount))	'주문수량
		DATAMANAGER.SetDataValue(0, "obtrf_oder_606r", "InBlock1", "FTOP_ODER_UNPR" , 0 , Trim(szPrice))	'주문단가
		
		TR_Inquiry("obtrf_oder_606r")
	end if
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_jong_002r" then		
		grdImageBalance.SetCellData( "bd_cell3", g_nDataStartRow, DATAMANAGER.GetDataValue(0, "ohhts_jong_002r", "OutBlock1", "FID_PRPR" , 0) )
		grdImageBalance.SetCellData( "bd_cell9", g_nDataStartRow, DATAMANAGER.GetDataValue(0, "ohhts_jong_002r", "OutBlock1", "FID_MXPR2" , 0) )
		grdImageBalance.SetCellData( "bd_cell10", g_nDataStartRow, DATAMANAGER.GetDataValue(0, "ohhts_jong_002r", "OutBlock1", "FID_LLAM2" , 0) )
	elseif szTranID == "ohhts_jong_002r_1" then
		grdImageBalance.SetCellData( "bd_cell3", g_szChoiceRow, DATAMANAGER.GetDataValue(0, "ohhts_jong_002r_1", "OutBlock1", "FID_PRPR" , 0) )
		grdImageBalance.SetCellData( "bd_cell9", g_szChoiceRow, DATAMANAGER.GetDataValue(0, "ohhts_jong_002r_1", "OutBlock1", "FID_MXPR2" , 0) )
		grdImageBalance.SetCellData( "bd_cell10", g_szChoiceRow, DATAMANAGER.GetDataValue(0, "ohhts_jong_002r_1", "OutBlock1", "FID_LLAM2" , 0) )
	elseif szTranID == "obtrf_oder_606r" then
		grdImageBalance.SetCellData( "bd_cell4", g_nDataStartRow, DATAMANAGER.GetDataValue(0, "obtrf_oder_606r", "OutBlock1", "NEW_TOTAL_ODER_MARG" , 0) )
	elseif szTranID == "obtrf_oder_606r_1" then
		grdImageBalance.SetCellData( "bd_cell4", g_szChoiceRow, DATAMANAGER.GetDataValue(0, "obtrf_oder_606r_1", "OutBlock1", "NEW_TOTAL_ODER_MARG" , 0) )
	elseif szTranID == "obtrf_cntg_302r" then
		for i=0 to DATAMANAGER.GetDataCount(0, "obtrf_cntg_302r", "OutBlock2")-1
			h= h+1
			Dim szCode		'포지션 구분코드
			Dim szData		'받은 포지션 구분코드를 변환하여 구분으로 변환
			Dim szTemp		'종목코드의 1~12자리까지를 추출하기 위한 변수
			szData = ""
			szCode = DATAMANAGER.GetDataValue(0, "obtrf_cntg_302r", "OutBlock2", "PSTN_CLS_CODE" , i)
			szData = Form.GetMetaData("포지션구분코드", szCode)
			Grid1.SetCellData( "bd_cell1", h-1, szData )
			szTemp = Mid(DATAMANAGER.GetDataValue(0,"obtrf_cntg_302r", "OutBlock2", "ISCD", i), 1, 12)
			Grid1.SetCellData( "bd_cell5", h-1, szTemp )
		next		
	end if	
End Sub

'============================================================================
' grdImageBalance_OnClickUp
'============================================================================
Sub grdImageBalance_OnClickUp(lRow, szCellID)
	if szCellID == "bd_del" then ' 삭제추가
		grdImageBalance.SetDeleteRow( lRow )
	else
		Dim szTempCellData
		g_szChoiceRow = lRow
		if szCellID == "bd_cell0" then	'종목코드 클릭
			g_sFlag = "0"
			
			Form.OpenCommonDialog("SEARCH", "4:14", "")
			
		elseif szCellID == "bd_cell1" then 	'구분 클릭
			szTempCellData = szCellID & "★" & grdImageBalance.GetCellData( "bd_cell1", g_szChoiceRow )
			Form.OpenPopup("mbact72010_p2" , szTempCellData , sPosInfo)
			
		elseif szCellID == "bd_cell2" then 	'수량 클릭
			szData =  grdImageBalance.GetCellData( "bd_cell2", g_szChoiceRow )
			Form.OpenPopup("mbtrf31030_p1", szData ,"")

			'szTempCellData = szCellID & "★" & grdImageBalance.GetCellData( "bd_cell2", g_szChoiceRow )
			'Form.OpenPopup("mbact72010_p2" , szTempCellData , sPosInfo)
		elseif szCellID == "bd_cell7" then 	'수량 이미지 클릭
			szData =  grdImageBalance.GetCellData( "bd_cell2", g_szChoiceRow )
			Form.OpenPopup("mbtrf31030_p1", szData ,"")

			'szTempCellData = szCellID & "★" & grdImageBalance.GetCellData( "bd_cell2", g_szChoiceRow )
			'Form.OpenPopup("mbact72010_p2" , szTempCellData , sPosInfo)
			
		elseif szCellID == "bd_cell3" or szCellID == "bd_cell8" then 	'가격 클릭	
			szCode = grdImageBalance.GetCellData("bd_cell0", g_szChoiceRow)
			
			If Left( Trim(szCode), 1 ) = "K" Then
				g_szItemCode	= Right( Trim(szCode), Len(Trim(szCode)) - 1)
			Else
				g_szItemCode	= szCode
			End If
			szMk = Form.GetItemCodeInfo(szCode, "market")		
			szPrc = CDbl(grdImageBalance.GetCellData( "bd_cell3", g_szChoiceRow ))	
			szHighPrc = CDbl(grdImageBalance.GetCellData( "bd_cell9", g_szChoiceRow ))	
			szLowPrc = CDbl(grdImageBalance.GetCellData( "bd_cell10", g_szChoiceRow ))	
			szData = szPrc & "★" & szCode & "★" & szMk & "★" & "20" & "★" &  szHighPrc & "★" & szLowPrc	
			Form.OpenPopup("mbtrf31030_p2" , szData , "")
			
			'szTempCellData = szCellID & "★" & grdImageBalance.GetCellData( "bd_cell3", g_szChoiceRow )
			'Form.OpenPopup("mbact72010_p2" , szTempCellData , sPosInfo)
		'elseif szCellID == "bd_cell8" then 	'가격 이미지 클릭	
			'szTempCellData = szCellID & "★" & grdImageBalance.GetCellData( "bd_cell3", g_szChoiceRow )
			'Form.OpenPopup("mbact72010_p2" , szTempCellData , sPosInfo)
		end if
	end if
End Sub

'============================================================================
' Form_OnCommonDialogReturn
'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName == "SEARCH" then
		if g_sFlag == "1" then
			if Trim(sReturn1) == "" then	' 20160331예외처리 추가
				Exit Sub
			end if
			
			Dim nDataCount
			nDataCount = grdImageBalance.rowcount	
			
			if tonumber(nDataCount) > 0 then	'가상잔고에 데이터 있으면		
				for i=0 to nDataCount				
					if sReturn1 == grdImageBalance.GetCellData( "bd_cell0", i ) then					
						Form.MsgBox("알림", "이미 추가된 종목입니다.", "", 0)
						exit sub
					end if
				next
			end if		
		
			Dim nRow 
			nRow = nDataCount
			
			grdImageBalance.insertrow = nRow
			
			grdImageBalance.SetCellData( "bd_cell0", nRow, sReturn1 )
			grdImageBalance.SetCellData( "bd_cell1", nRow, "매수" )
			grdImageBalance.SetCellFgColor( "bd_cell1", nRow, "6")
			grdImageBalance.SetCellData( "bd_cell5", nRow, "2" )
			grdImageBalance.SetCellData( "bd_cell2", nRow, "0" )		'수량
			grdImageBalance.SetCellData( "bd_cell3", nRow, "0" )		'가격
			grdImageBalance.SetCellData( "bd_cell4", nRow, "" )	'신규위탁		
			grdImageBalance.SetCellData( "bd_cell6", nRow, sReturn1 )		'전체종목코드
			
			g_szChoiceRow = nRow
			szMarket = Form.GetItemCodeInfo( sReturn1 , "market")
			DATAMANAGER.SetDataValue(0,"ohhts_jong_002r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , szMarket)		
			DATAMANAGER.SetDataValue(0,  "ohhts_jong_002r_1", "InBlock1", "FID_INPUT_ISCD", 0 , sReturn1)		
			TR_Inquiry("ohhts_jong_002r_1")
			
		else
'			if Trim(sReturn1) <> "" then	' 20160329 예외처리 추가
'				grdImageBalance.SetCellData( "bd_cell0", g_szChoiceRow, sReturn1 )
'			end if
			
			if Trim(sReturn1) == "" then	' 20160331예외처리 추가
				Exit Sub
			end if
			
			Dim nDataCount
			nDataCount = grdImageBalance.rowcount	
			
			if tonumber(nDataCount) > 0 then	'가상잔고에 데이터 있으면		
				for i=0 to nDataCount				
					if sReturn1 == grdImageBalance.GetCellData( "bd_cell0", i ) then					
						Form.MsgBox("알림", "이미 추가된 종목입니다.", "", 0)
						exit sub
					end if
				next
			end if		
		
			Dim nRow 
'			nRow = nDataCount
			
'			grdImageBalance.insertrow = nRow
			
			grdImageBalance.SetCellData( "bd_cell0", g_szChoiceRow, sReturn1 )
			grdImageBalance.SetCellData( "bd_cell1", g_szChoiceRow, "매수" )
			grdImageBalance.SetCellFgColor( "bd_cell1", g_szChoiceRow, "6")
			grdImageBalance.SetCellData( "bd_cell5", g_szChoiceRow, "2" )
			grdImageBalance.SetCellData( "bd_cell2", g_szChoiceRow, "0" )		'수량
			grdImageBalance.SetCellData( "bd_cell3", g_szChoiceRow, "0" )		'가격
			grdImageBalance.SetCellData( "bd_cell4", g_szChoiceRow, "" )	'신규위탁		
			grdImageBalance.SetCellData( "bd_cell6", g_szChoiceRow, sReturn1 )		'전체종목코드
			
'			g_szChoiceRow = nRow
			szMarket = Form.GetItemCodeInfo( sReturn1 , "market")
			DATAMANAGER.SetDataValue(0,"ohhts_jong_002r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , szMarket)		
			DATAMANAGER.SetDataValue(0,  "ohhts_jong_002r_1", "InBlock1", "FID_INPUT_ISCD", 0 , sReturn1)		
			TR_Inquiry("ohhts_jong_002r_1")
			
			
		end if
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "SORT" then	'구분
		if sRet == "1" then	'매수
			grdImageBalance.SetCellData( "bd_cell1", g_szChoiceRow, "매수" )
			grdImageBalance.SetCellFgColor( "bd_cell1", g_szChoiceRow, "6")
			grdImageBalance.SetCellData( "bd_cell5", g_szChoiceRow, "2" )
		elseif sRet == "0" then	'매도
			grdImageBalance.SetCellData( "bd_cell1", g_szChoiceRow, "매도" )
			grdImageBalance.SetCellFgColor( "bd_cell1", g_szChoiceRow, "7")
			grdImageBalance.SetCellData( "bd_cell5", g_szChoiceRow, "1" )
		else		
		end if				
		
		'---------------------------------------------------------------
	    ' 현재가 셋팅
	    '---------------------------------------------------------------
		Dim szChangeIscd
		
		szChangeIscd = UCase(Trim(grdImageBalance.GetCellData( "bd_cell0", g_szChoiceRow )))
		Dim szChangeVidCode 
		
		if Mid(szChangeIscd, 1, 1) == "K" then
			szChangeIscd = Mid(szChangeIscd, 2, 8)
		
		end if
		
		if Mid(szChangeIscd, 1, 1) = "1" or Mid(szChangeIscd, 1, 1) = "A" then
			if Mid(szChangeIscd, 2, 2) = "01" then
				szChangeVidCode = "F"
			
			elseif Mid(szChangeIscd, 2, 2) = "03" then
				szChangeVidCode = "SF"
			
			elseif Mid(szChangeIscd, 2, 2) = "05" then
				szChangeVidCode = "MF"
				
			else
				szChangeVidCode = "JF"
			end if
			
		elseif Mid(szChangeIscd, 1, 1) == "2"  or Mid(szChangeIscd, 1, 1) == "B"  then
			if Mid(szChangeIscd, 2, 2) = "01" then
			    szChangeVidCode = "O"
		    
		    elseif Mid(szChangeIscd, 2, 2) = "03" then
			    szChangeVidCode = "SF"
		    
		    elseif Mid(szChangeIscd, 2, 2) = "05" then
				szChangeVidCode = "MO"
				
		    elseif Mid(szChangeIscd, 2, 2) = "09" or Mid(szChangeIscd, 2, 2) = "AF" then
			    szChangeVidCode = "WO"
			    
		    else
			    szChangeVidCode = "JO"
		    end if
		
		elseif Mid(szChangeIscd, 1, 1) == "3" or Mid(szChangeIscd, 1, 1) == "C"  then
			if Mid(szChangeIscd, 2, 2) = "01" then
			    szChangeVidCode = "O"
		    
		    elseif Mid(szChangeIscd, 2, 2) = "03" then
			    szChangeVidCode = "SF"
		    
		    elseif Mid(szChangeIscd, 2, 2) = "05" then
				szChangeVidCode = "MO"
				
		     elseif Mid(szChangeIscd, 2, 2) = "09"  or Mid(szChangeIscd, 2, 2) = "AF" then
			    szChangeVidCode = "WO"
			    
		    else
			    szChangeVidCode = "JO"
		    end if		    
		end if
		
		
		DATAMANAGER.SetDataValue(0,"ohhts_jong_002r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , szChangeVidCode)
		DATAMANAGER.SetDataValue(0,  "ohhts_jong_002r_1", "InBlock1", "FID_INPUT_ISCD", 0 , szChangeIscd)		
		TR_Inquiry("ohhts_jong_002r_1")

		
		' 신규주문증거금 셋팅	
		
		Dim szChangeOderQty
		szChangeOderQty=0
		
		if Len(Trim(grdImageBalance.GetCellData( "bd_cell2", g_szChoiceRow ))) > 0 then
			szChangeOderQty = clng(Trim(grdImageBalance.GetCellData( "bd_cell2", g_szChoiceRow )))	'수량
		end if
		
		if szChangeOderQty <= 0 then
			Form.ShowAlert("알림", "주문수량을 확인하세요")
			exit sub
		end if
		
			
		Dim szNewIscd, szNewItemCode
		
		szNewIscd = UCase(Trim(grdImageBalance.GetCellData( "bd_cell0", g_szChoiceRow )))
		
		if Mid(szNewIscd, 1, 1) <> "K" then
			szNewItemCode = "K" & szNewIscd
		else
			szNewItemCode = szNewIscd
		end if 
		

		if szChangeOderQty > 0 then			
			DATAMANAGER.SetDataValue(0,"obtrf_oder_606r_1", "InBlock1", "PROS_CLS" , 0 , "2")
			DATAMANAGER.SetDataValue(0,"obtrf_oder_606r_1", "InBlock1", "ISCD" , 0 , szNewItemCode)
			DATAMANAGER.SetDataValue(0,"obtrf_oder_606r_1", "InBlock1", "DEAL_CLS_CODE" , 0 , Trim(grdImageBalance.GetCellData( "bd_cell5", g_szChoiceRow )))		'1/ 2
			DATAMANAGER.SetDataValue(0, "obtrf_oder_606r_1", "InBlock1", "ODQT", 0 , Trim(grdImageBalance.GetCellData( "bd_cell2", g_szChoiceRow )))			'수량
			DATAMANAGER.SetDataValue(0,"obtrf_oder_606r_1", "InBlock1", "FTOP_ODER_UNPR", 0 , Trim(grdImageBalance.GetCellData( "bd_cell3", g_szChoiceRow )))			'가격
			TR_Inquiry("obtrf_oder_606r_1")
		end if
				
	elseif sKeyName == "QTY_POPUP" then	'수량
		grdImageBalance.SetCellData( "bd_cell2", g_szChoiceRow, sRet)
		
		' 신규주문증거금 셋팅	
		
		Dim szChangeOderQty1
		szChangeOderQty1=0
		
		if Len(Trim(grdImageBalance.GetCellData( "bd_cell2", g_szChoiceRow ))) > 0 then
			szChangeOderQty1 = clng(Trim(grdImageBalance.GetCellData( "bd_cell2", g_szChoiceRow )))	'수량
		end if
		
		if szChangeOderQty1 <= 0 then
			Form.ShowAlert("알림", "주문수량을 확인하세요")
			exit sub
		end if
		
			
		Dim szNewIscd1, szNewItemCode1
		
		szNewIscd1 = UCase(Trim(grdImageBalance.GetCellData( "bd_cell0", g_szChoiceRow )))
		
		if Mid(szNewIscd1, 1, 1) <> "K" then
			szNewItemCode1 = "K" & szNewIscd1
		else
			szNewItemCode1 = szNewIscd1
		end if 
		

		if szChangeOderQty1 > 0 then			
			DATAMANAGER.SetDataValue(0,"obtrf_oder_606r_1", "InBlock1", "PROS_CLS" , 0 , "2")
			DATAMANAGER.SetDataValue(0,"obtrf_oder_606r_1", "InBlock1", "ISCD" , 0 , szNewItemCode1)
			DATAMANAGER.SetDataValue(0,"obtrf_oder_606r_1", "InBlock1", "DEAL_CLS_CODE" , 0 , Trim(grdImageBalance.GetCellData( "bd_cell5", g_szChoiceRow )))		'1/ 2
			DATAMANAGER.SetDataValue(0, "obtrf_oder_606r_1", "InBlock1", "ODQT", 0 , Trim(grdImageBalance.GetCellData( "bd_cell2", g_szChoiceRow )))			'수량
			DATAMANAGER.SetDataValue(0,"obtrf_oder_606r_1", "InBlock1", "FTOP_ODER_UNPR", 0 , Trim(grdImageBalance.GetCellData( "bd_cell3", g_szChoiceRow )))			'가격
			TR_Inquiry("obtrf_oder_606r_1")
		end if
		
		
	elseif sKeyName == "PRC_POPUP" then		'가격
		grdImageBalance.SetCellData( "bd_cell3", g_szChoiceRow, sRet)	
		
		' 신규주문증거금 셋팅	
		
		Dim szChangeOderQty2
		szChangeOderQty2=0
		
		if Len(Trim(grdImageBalance.GetCellData( "bd_cell2", g_szChoiceRow ))) > 0 then
			szChangeOderQty2 = clng(Trim(grdImageBalance.GetCellData( "bd_cell2", g_szChoiceRow )))	'수량
		end if
		
		if szChangeOderQty2 <= 0 then
			Form.ShowAlert("알림", "주문수량을 확인하세요")
			exit sub
		end if
		
			
		Dim szNewIscd2, szNewItemCode2
		
		szNewIscd2 = UCase(Trim(grdImageBalance.GetCellData( "bd_cell0", g_szChoiceRow )))
		
		if Mid(szNewIscd2, 1, 1) <> "K" then
			szNewItemCode2 = "K" & szNewIscd2
		else
			szNewItemCode2 = szNewIscd2
		end if 

		if szChangeOderQty2 > 0 then			
			DATAMANAGER.SetDataValue(0,"obtrf_oder_606r_1", "InBlock1", "PROS_CLS" , 0 , "2")
			DATAMANAGER.SetDataValue(0,"obtrf_oder_606r_1", "InBlock1", "ISCD" , 0 , szNewItemCode2)
			DATAMANAGER.SetDataValue(0,"obtrf_oder_606r_1", "InBlock1", "DEAL_CLS_CODE" , 0 , Trim(grdImageBalance.GetCellData( "bd_cell5", g_szChoiceRow )))		'1/ 2
			DATAMANAGER.SetDataValue(0, "obtrf_oder_606r_1", "InBlock1", "ODQT", 0 , Trim(grdImageBalance.GetCellData( "bd_cell2", g_szChoiceRow )))			'수량
			DATAMANAGER.SetDataValue(0,"obtrf_oder_606r_1", "InBlock1", "FTOP_ODER_UNPR", 0 , Trim(grdImageBalance.GetCellData( "bd_cell3", g_szChoiceRow )))			'가격
			TR_Inquiry("obtrf_oder_606r_1")
		end if
	end if
End Sub

'============================================================================
' btnCalculation_OnClick() - 가상 체결 증거금 계산
'============================================================================
Sub btnCalculation_OnClick()
	Dim tempImageData, szCd
	tempImageData, szCd = "", ""
	
	if grdImageBalance.rowcount == "0" then	'가상잔고가 없을 때
		Form.SetSharedData("GridImageBalanceNon" , "1")
		for i=0 to Grid1.rowcount-1
			tempImageData = tempImageData & Grid1.GetCellData( "bd_cell0", i) & "○" & Grid1.GetCellData( "bd_cell1", i) & "○" & Grid1.GetCellData( "bd_cell2", i) & "○" & Grid1.GetCellData( "bd_cell3", i)& "●"
			
		next
	else
		Form.SetSharedData("GridImageBalanceNon" , "2")
		for i=0 to grdImageBalance.rowcount-1	
		
			szCd = grdImageBalance.GetCellData( "bd_cell0", i)
			
			if Mid(szCd, 1, 1) <> "K" then
				szCd = "K" & szCd
			end if
		
			tempImageData = tempImageData & szCd & "○" & grdImageBalance.GetCellData( "bd_cell1", i) & "○" & grdImageBalance.GetCellData( "bd_cell2", i) & "○" & grdImageBalance.GetCellData( "bd_cell3", i)& "●"
		next 
	end if
	
	for i = 0  to grdImageBalance.rowcount - 1
		if grdImageBalance.GetCellData( "bd_cell2", i) <> "0" and grdImageBalance.GetCellData( "bd_cell3", i) <> "0" then
			
		else
			Form.ShowAlert( "알림", "가상잔고 입력데이터를 확인하세요.")
			Exit Sub
		end if
	next
	
	Dim szAllImageData
	szAllImageData = g_szData & "☆" & grdImageBalance.rowcount & "☆" & tempImageData
	Form.OpenPopup("mbact72010_p1" , szAllImageData , sPosInfo)
	'Form.OpenPopup("mbact72010_p1" , sOpenData , sPosInfo)
	'계좌번호, 일련번호, 가상잔고, 미체결내역, 기존잔고 내역이 들어와야함
	'계좌번호 ★ 일련번호 ☆ 가상잔고 갯수 ☆ 가상잔고총데이타("○")
End Sub

'============================================================================
' cmbAccount_ChangeAccount
'============================================================================
Sub cmbAccount_ChangeAccount()
	g_nAccountNumber = cmbAccount.total
	g_nAccountSerialNumber = cmbAccount.sequence
	'g_szAccountPassword = edtPassword.caption
	'V001
	'MTS 메모리평문 적용상태일때
	if plain_rm == "1" then
		g_szAccountPassword = edtPassword.caption
	'MTS메모리평문 미적용상태일때
	else
		g_szAccountPassword = Form.GetEncData(edtPassword.caption)	
	end if
	
	g_szData = g_nAccountNumber & "★" & g_nAccountSerialNumber & "★" & g_szAccountPassword
	btnSearch_OnClick()
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtrf_oder_606r" or szTranID == "obtrf_oder_606r_1" then
		'주문추가시 오류팝업 예외처리 이호철
		if (szErrCode == "6001") then
			return
		end if
		
		Form.ShowAlert("알림", szErrMsg)
	end if
End Sub

'============================================================================
' 가상잔고 추가
'============================================================================
Sub btnAdd_OnClick()
	g_sFlag = "1"
	
	Form.OpenCommonDialog("SEARCH", "4:14", "")
End Sub



