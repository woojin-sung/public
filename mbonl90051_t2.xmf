'============================================================================
' 01.화면명  : ETN 종합시세
' 02.화면설명: 장외채권 연계 ETN 종목검색
' 03.작성	 : 2023.12.18  
'============================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_ListCnt
Dim g_SortData, g_FilterData, g_FilterList
Dim g_szSelectedItem

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_FilterData = "99★2★99★99"
	g_FilterList = split(g_FilterData, "★")
	g_SortData = 0
	
	contSearch.edtSearch01.SetOnOffImage("alpha", "alpha")
	
	DATAMANAGER.RequestTranData("ohhts_1305_001r")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szData, szList
	
	if sEventName == "Init_Symbol" then
'		Form.ShowAlert("90051_t1_TriggerEvent", sParam)
		szData = sParam
		szList = split(szData, "|")
		
		contSearch.edtSearch01.caption = szList(1)
		DATAMANAGER.RequestTranData("ohhts_1305_001r")
		
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	DATAMANAGER.RequestTranData("ohhts_1305_001r")
End Sub

'============================================================================
Sub contSearch_edtSearch01_OnEditComplete()
'	DATAMANAGER.RequestTranData("ohhts_1305_001r")
End Sub

'============================================================================
Sub contSearch_imgSearchBox_OnClick()
	contSearch_edtSearch01_OnClick()
End Sub

'============================================================================
Sub contSearch_imgSearch01_OnClick()
	contSearch_edtSearch01_OnClick()
End Sub

'============================================================================
Sub contSearch_edtSearch01_OnClick()
	Form.openCommonDialog("SEARCH", "29:5:6", "")
End Sub

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
'	Form.ShowAlert("DialogReturn", sDlgName .. " : " .. sReturn1 .. " : " .. sReturn2)
	if sDlgName == "SEARCH" then
		g_szFullCode = sReturn1
		g_szSearchWord = Form.GetItemCodeInfo(g_szFullCode, "name")	
		g_szMarket = Form.GetItemCodeInfo(g_szFullCode, "market")
		
		contSearch.edtSearch01.caption = g_szSearchWord
		DATAMANAGER.RequestTranData("ohhts_1305_001r")
	end if
End Sub

'============================================================================
Sub contSearch_btnFilter_OnClick()
	Dim szData
	
	szData = "2★" & g_FilterData
	
	Form.OpenPopup("mbonl90051_p2", szData, "")
End Sub

'============================================================================
Sub contSearch_btnSort_OnClick()
	Dim szData
	
	szData = g_SortData
	'	0`거래량 많은순
	'	1`거래대금 많은 순
	'	2`상승률 순
	'	3`하락률순

	Form.OpenPopup("mbonl90051_p1", szData, "")
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	g_szSelectedItem	= Grid0.GetCellData( "bd_cell0", lRow )

	listLocation =  Split(Grid0.location,":")
	nYPos = Int(listLocation[1])
	height = listLocation[3]
	
	sPopupType = "0"

	Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "차트" & "★" & "관심등록" & "★" & "매수" & "★" & "매도")

End Sub

'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	dim szListItems, szData
	
	if sKeyName == "MOVEPOP_RETURN"	then
		szListItems	=	split(sRet,"★")
		
		if	szListItems(1)	=	"0"	then			'현재가
			Form.OpenScreen("11000" , g_szSelectedItem & "★" & "0") 
		elseif	szListItems(1)	=	"1"	then		'차트
			Form.OpenScreen("11000" , g_szSelectedItem & "★" & "2") 
		elseif 	szListItems(1)	=	"2"	then		'관심등록-편집
		    'Form.OpenScreen("11010" , g_szSelectedItem & "★" & "4") 
		    Form.OpenPopup("mhprc11000_pd" , g_szSelectedItem , "")
		elseif 	szListItems(1)	=	"3"	then		'매수
			Form.OpenScreen("12000" , "기타" &  "★" & "0" &  "★"& g_szSelectedItem) 
		elseif 	szListItems(1)	=	"4"	then		'매도
			Form.OpenScreen("12000" , "기타" &  "★" & "1" &  "★"& g_szSelectedItem) 
		else
		end if
		
	elseif sKeyName == "SORT_CONDITION" then
		'정렬조건
		g_SortData = sRet
		
'		Form.ShowAlert("PopupReturn", g_SortData)
		select case g_SortData
			case "0"
				contSearch.lblSort.caption = "거래량 많은 순"
			case "1"
				contSearch.lblSort.caption = "거래대금 많은 순"
			case "2"
				contSearch.lblSort.caption = "상승률 순"
			case "3"
				contSearch.lblSort.caption = "하락률 순"
		end select
		
		DATAMANAGER.RequestTranData("ohhts_1305_001r")
		
	elseif sKeyName == "FILTER_CONDITION" then
		g_FilterData = sRet
		g_FilterList = split(g_FilterData, "★")
		'0	시장구분
		'1	기초자산 
		'2	레버리지
		'3	운용사
		
		DATAMANAGER.RequestTranData("ohhts_1305_001r")
	end if 
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림_90051_t1" , szTranID .. "\n" .. szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림_90051_t1" , szTranID .. "\n" .. szErrCode .. " : ".. szErrMsg)
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szValue
	
	If szTranID = "ohhts_1305_001r" Then
		DATAMANAGER.CancelRealData("ohhts_etf_nav")
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE",		0, "J")		'시장분류코드 J:주식시장
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE",		0, "1305")	'화면분류코드	
		
		g_FilterList = split(g_FilterData, "★")
		
'		Form.ShowAlert("TranBefore1", g_FilterList(3))
		select case CInt(g_FilterList(3))
			case 99		szValue = ""			'발행사전체
			case 1		szValue = "00030"		'삼성증권
			case 2		szValue = "00005"		'미래에셋증권
			case 3		szValue = "00017"		'KB증권
			case 4		szValue = "00021"		'한화투자
			case 5		szValue = "00001"		'교보증권
			case 6		szValue = "00004"		'대신증권
			case 7		szValue = "00050"		'키움증권
			case 8		szValue = "00012"		'NH투자증권
			case 9		szValue = "00002"		'신한증권     
			case 10		szValue = "00010"		'메리츠
			case 11		szValue = "00056"		'하나증권
			case 12		szValue = "99999"		'기타
		end select
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_CLS_CODE", 	0, szValue)	'시장구분코드 운용사
		
		select case CInt(g_FilterList(2))
			case 99		szValue = "00"		'전체
			case 1		szValue = "P1"		'x1
			case 2		szValue = "N1"		'-x1
			case 3		szValue = "P2"		'x2
			case 4		szValue = "N2"		'-x2
			case 5		szValue = "P3"		'x3
			case 6		szValue = "N3"		'-x3
		end select
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_NMIX_LVRG_INVRS_CLS", 	0, szValue)	'지수레버리지인버스구분
'		Form.ShowAlert(g_FilterList(2), szValue)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_TXTN_TYPE",				0, " ") '과세유형
		
		select case CInt(g_FilterList(0))
			case 99		szValue = "000000"		'전체
			case 1		szValue = "010000"		'국내
			case 2		szValue = "020000"		'해외
			case 3		szValue = "030000"		'국내&해외
		end select
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_NMIX_MRKT_DIV",			0, szValue) '지수시장분류
		
		select case CInt(g_FilterList(1))
			case 99		szValue = "000000"		'전체
			case 1		szValue = "010000"		'주식
			case 2		szValue = "020000"		'채권
			case 3		szValue = "030000"		'원자재
			case 4		szValue = "040000"		'부동산
			case 5		szValue = "050000"		'통화
			case 6		szValue = "060000"		'혼합자산
			case 7		szValue = "070000"		'ELS
			case 8		szValue = "080000"		'기타
		end select
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_NMIX_ASET_DIV", 			0, szValue) '지수자산분류
		
		select case CInt(g_SortData)
			case 0		szValue = "0"		'거래량 많은 순 (거래량 내림차순)
			case 1		szValue = "8"		'거래대금 많은 순
			case 2		szValue = "2"		'상승률 순 (등락율 내림차순)
			case 3		szValue = "4"		'하략률 순 (등락율 오름차순)
		end select		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE", 	0, szValue)	'순위정렬구분코드
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_SRCH_NAME", 			0, contSearch.edtSearch01.caption)	'입력검색명		
	end If 
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_1305_001r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0, g_TRID , "OutBlock1" ) -1
			szCd = DATAMANAGER.GetDataValue(0, g_TRID, "OutBlock1", "FID_SHRN_ISCD", i)
			
			DATAMANAGER.SetDataValue(1, "ohhts_etf_nav", "InBlock1", "FIDR_SHRN_ISCD", i, szCd)
		Next    
		DATAMANAGER.RequestRealData( "ohhts_etf_nav" )
		
		if CInt(Grid0.rowcount) > 0 then
			Grid0.visible = True
			lblReset.visible = False
			imgReset.visible = False
			
		else
			Grid0.visible = False
			lblReset.visible = True
			imgReset.visible = True
		end if

	end if
End Sub

'============================================================================
Sub imgReset_OnClick()	
	g_FilterData = "99★2★99★99"
	contSearch.edtSearch01.caption = ""
	
	DATAMANAGER.RequestTranData("ohhts_1305_001r")		
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	contSearch.imgSearch01.setMaintainingRatio("1")
End Sub
