End Sub

'============================================================================
' 비용포함 체크 시, 안내메시지 보임여부
'============================================================================
Function SetShowToast(bShow)
	
	if bShow then
	
		contToast.left = 30
		contToast.visible = true
		
		Form.SetTimerEvent2(1, 1, 5)
		
	else
		contToast.visible = false
		contToast.left = 500
		
		Form.SetTimerEvent2(1, 0, 5)
		
		
	end if

End Function

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	SetShowToast(false)
End Sub

