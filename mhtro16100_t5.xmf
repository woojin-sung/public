'============================================================================
Sub contBody_contCash_LabelCashTitle_OnSizeAutoFit()
	
	if gOsType == "1" then
		nLeft = Form.calcUnResize(contBody.contCash.LabelCashTitle.left, "2")
		nWidth = Form.calcUnResize(contBody.contCash.LabelCashTitle.width, "2")
	else
		nLeft = contBody.contCash.LabelCashTitle.left
		nWidth = contBody.contCash.LabelCashTitle.width
	end if
	
	contBody.contCash.ImageQuestion.left = nLeft + nWidth + 5

End Sub

