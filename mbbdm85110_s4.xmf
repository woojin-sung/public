Dim	g_sz_OSType		'OS타입


'============================================================================
Sub Form_OnFormInit()
	'OSType 1.안드로이드 2.IOS
	g_sz_OSType = Form.GetSharedData("&OS_TYPE", False)
	'Form.ShowAlert("OS_VERSION", "["..g_sz_OSType.."](1.안드로이드 2.IOS)")
	
	'스크롤 처음으로 강제설정
'	If g_sz_OSType = "1" Then	'안드로이드
		contMain.scroll_pos = CInt(Form.calcUnResize(contMain.lbl1.top, "1"))
'	Else	
'		contMain.scroll_pos = CInt(contMain.lbl1.top)
'	End If

	'통신사별 약관 링크
	'SKT
	contMain.webSKT.viewtype = 0
	contMain.webSKT.urlpath = "http://home.imeritz.com/include/resource/comm/ctcn/files/agree_04_sk.html"

	'KT
	contMain.webKT.viewtype = 0
	contMain.webKT.urlpath = "http://home.imeritz.com/include/resource/comm/ctcn/files/agree_04_kt.html"
	
	'LG U+
	contMain.webLGU.viewtype = 0
	contMain.webLGU.urlpath = "http://home.imeritz.com/include/resource/comm/ctcn/files/agree_04_lg.html"
End Sub


'============================================================================
Sub contMain_webSKT_OnLoadingFinished()
	contMain.webSKT.scrollTop()

End Sub
'============================================================================
Sub contMain_webKT_OnLoadingFinished()
	contMain.webKT.scrollTop()

End Sub
'============================================================================
Sub contMain_webLGU_OnLoadingFinished()
	contMain.webLGU.scrollTop()
End Sub
