'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	'우측 상단 유의사항으로 오픈되었을때
	If szOpenData == "1" Then
		labTitle.visible = false
		btnOK.visible = false
		btnExit.visible = false
		
		Container0.top = 15
		Container0.height = 592
		
		Form.SetScreenName("해외주식 양도소득 신고대행 안내")
	Else
		labTitle.visible = true
		btnOK.visible = true
		btnExit.visible = true
	End If
End Sub

'============================================================================
Sub btnExit_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.SendReturnToParent("mbtro16110_p5", "")
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>