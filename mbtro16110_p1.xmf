	<SCRIPT_INFO _len="1039" _ulen="975" >


'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
		'신고년도 / 납부고지서 수령방법 / 수령지 주소1 / 수령지 주소2
		Dim tData
		tData = Split(szOpenData, "★")
		tblData.SetCellString(0, 1, tData[0] & "년")
		If tData[1] == "0" Or tData[1] == 0 Then
			tblData.SetCellString(1, 1, "이메일")
			tblData.SetCellString(2, 1, tData[2])
			
			Image1.height = 195
		Else
			tblData.SetCellString(1, 1, "등기우편")
			tblData.SetCellString(2, 1, tData[2])
			tblData.SetCellString(3, 1, tData[3])
		End If
	End If
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.SendReturnToParent("mbtro16110_p1" , "")
	Form.CloseForm()
End Sub

