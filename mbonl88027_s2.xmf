'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName == "INIT_SCREEN" And sParam <> "" And sParam <> null Then
		'계좌 및 디폴트기간 세팅
		g_szStatusGb = "%"
		g_szPeriodType = "2"
		g_szAcno = Left(sParam, 8)
		g_szAsno = Right(sParam, 2)
		
		g_nSelectRow = -1
		
		Dim szTmpDt
		g_szToDt = Form.GetSharedData("&HOST_DATE", false )
		szTmpDt = Left(g_szToDt, 4) & "-" & Mid(g_szToDt, 5, 2) & "-" & Right(g_szToDt, 2)
		g_szFromDt = Replace(DateAdd("m", -1, szTmpDt), "-", "")
		
		grdList.SetClear()
		
		'CDS 매수 신청 대상 조회
		DATAMANAGER.RequestTranData( "obsat_cdss_004r" )
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'검색조건팝업 리턴
	If sKeyName == "COND_RETURN" And sRet <> "" And sRet <> null Then
		'진행상태구분값★기간구분값★시작일자★종료일자
		Dim tData
		tData = Split(sRet, "★")
		
		g_szStatusGb = tData[0]
		g_szPeriodType = tData[1]
		
		Dim szTmpDt
		If g_szPeriodType == "1" Then		'최근1주일
			g_szToDt = Form.GetSharedData("&HOST_DATE", false )
			szTmpDt = Left(g_szToDt, 4) & "-" & Mid(g_szToDt, 5, 2) & "-" & Right(g_szToDt, 2)
			g_szFromDt = Replace(DateAdd("w", -7, szTmpDt), "-", "")
		ElseIf g_szPeriodType == "2" Then	'최근1개월
			g_szToDt = Form.GetSharedData("&HOST_DATE", false )
			szTmpDt = Left(g_szToDt, 4) & "-" & Mid(g_szToDt, 5, 2) & "-" & Right(g_szToDt, 2)
			g_szFromDt = Replace(DateAdd("m", -1, szTmpDt), "-", "")
		Else								'직접입력한 날짜
			g_szFromDt = tData[2]
			g_szToDt = tData[3]
		End If
		
'		g_szFromDt = tData[2]
'		g_szToDt = tData[3]
		
		lblCond.caption = f_SetCondText()
		
		grdList.SetClear()
		
		'CDS 매수 신청 대상 조회
		DATAMANAGER.RequestTranData( "obsat_cdss_004r" )
	
	'계좌 비밀번호 입력 리턴
	ElseIf sKeyName == "CORRECT_PWD" And sRet <> "" And sRet <> Null Then
'		Form.ShowAlert(sKeyName, sRet)
		Dim tData
		tData = Split(sRet, "★")
		If UBOUND(tData) > 0 Then
			g_szPwd = tData[0]
			
			Dim szStatus
			szStatus = grdList.GetCellData("Data1", g_nSelectRow)
			If szStatus == "1" Then
				'CDS 취소 신청
				DATAMANAGER.RequestTranData( "obsat_cdss_002a" )
			Else
				'CDS 해지 신청
				DATAMANAGER.RequestTranData( "obsat_cdss_003a" )
			End If
		End If
	
	'해지 확인 팝업 리턴
	ElseIf sKeyName == "mbonl88027_p4" Then
		'계좌비밀번호 확인 후 처리
		Form.openPopupAnimation("pwdcheckpopup", g_szAcno & "☆0" , "", "2")
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'취소신청 확인 메시지 리턴
	If sKeyName == "CANCEL_CONFIRM" And sRet == "ok" Then
		'계좌비밀번호 확인 후 처리
		Form.openPopupAnimation("pwdcheckpopup", g_szAcno & "☆0" , "", "2")
	
	ElseIf sKeyName == "PROC_COMPLETE" Then
		g_nSelectRow = -1
		
		grdList.SetClear()
		
		'CDS 매수 신청 대상 조회
		DATAMANAGER.RequestTranData( "obsat_cdss_004r" )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'CDS 매수 신청 대상 조회
	If szTranID == "obsat_cdss_004r" Then
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" , 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "STA_DATE" , 0 , g_szFromDt)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "FIN_DATE" , 0 , g_szToDt)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PRGS_STAT_CODE" , 0 , g_szStatusGb)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "APLT_CLS_CODE" , 0 , cmbSort.cbkeydata)
	
	'CDS 취소 신청
	ElseIf szTranID == "obsat_cdss_002a" Then
		Dim szAcptDate, szAcptSrno
		szAcptDate = grdList.GetCellData("Data3", g_nSelectRow)	'접수일자
		szAcptSrno = grdList.GetCellData("Data4", g_nSelectRow)	'접수일련번호
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACPT_DATE" , 0 , szAcptDate)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACPT_SRNO" , 0 , szAcptSrno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" , 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , g_szPwd)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CNCL_YN" , 0 , "Y")
		
	'CDS 해지 신청
	ElseIf szTranID == "obsat_cdss_003a" Then	
		Dim szAcptDate, szAcptSrno, szIscd, szByovDate, szByovSrno
		szAcptDate = grdList.GetCellData("Data3", g_nSelectRow)	'접수일자
		szAcptSrno = grdList.GetCellData("Data4", g_nSelectRow)	'접수일련번호
		szIscd = grdList.GetCellData("Data2", g_nSelectRow)		'종목코드
		szByovDate = grdList.GetCellData("Data5", g_nSelectRow)	'매수일자
		szByovSrno = grdList.GetCellData("Data6", g_nSelectRow)	'매수일련번호
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACPT_DATE" , 0 , szAcptDate)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACPT_SRNO" , 0 , szAcptSrno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" , 0 , g_szAcno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" , 0 , g_szAsno)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD" , 0 , g_szPwd)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ISCD" , 0 , szIscd)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BYOV_DATE" , 0 , szByovDate)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BYOV_SRNO" , 0 , szByovSrno)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'CDS 매수 신청 대상 조회
	If szTranID == "obsat_cdss_004r" Then
		Dim nCnt
		nCnt = CInt(DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1"))
'		Form.ShowAlert("nCnt", nCnt)
		
		Dim szName, szRegDt, szExpDt, szReYn, szAmt, szCntcAmt, szStatus, szCancYn
		If nCnt > 0 Then
			grdList.visible = true
			lblNoData.visible = false
			
			For i = 0 To nCnt - 1 
				grdList.AddRow()
				szName = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "KOR_ISSU_ABWR_NAME" , i)
				szRegDt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACPT_DATE" , i)
				szExpDt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "MTRT_DATE" , i)
				szReYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "RNVS_YN" , i)
				szAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "MNRC_AMT" , i)
				szCntcAmt = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "NOMN_AMT" , i)
				szStatus = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "PRGS_STAT_CODE" , i)
				szCancYn = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CANC_ABLE_YN" , i)
				
				grdList.SetCellData("bd_name", i, szName)
				grdList.SetCellData("bd_title1", i, "신청일")
				grdList.SetCellData("bd_title2", i, "만기일(재투자일)")
				grdList.SetCellData("bd_title3", i, "재투자여부")
				grdList.SetCellData("bd_title4", i, "신청금액")
				grdList.SetCellData("bd_title5", i, "계약(액면)금액")
				grdList.SetCellData("bd_title6", i, "거래상태")
				
				grdList.SetCellData("bd_regdate", i, szRegDt)
				grdList.SetCellData("bd_expdate", i, szExpDt)
				If szReYn == "Y" Then
					grdList.SetCellData("bd_re", i, "재투자")
				Else
					grdList.SetCellData("bd_re", i, "만기상환")
				End If
				grdList.SetCellData("bd_amount", i, szAmt)
				grdList.SetCellData("bd_contamt", i, szCntcAmt)
				
				'진행상태별 처리
				If szStatus == "1" Then
					grdList.SetCellData("bd_status", i, "신청완료(승인전)")
					grdList.SetCellFgColor("bd_status", i, "7")
				ElseIf szStatus == "2" Then
					grdList.SetCellData("bd_status", i, "승인완료")
					grdList.SetCellFgColor("bd_status", i, "7")
				ElseIf szStatus == "3" Then
					grdList.SetCellData("bd_status", i, "재투자승인")
					grdList.SetCellFgColor("bd_status", i, "7")
				'4 취소 삭제 > 7 고객취소, 8 승인거절 로 분리
'				ElseIf szStatus == "4" Then
'					grdList.SetCellData("bd_status", i, "취소")
'					grdList.SetCellFgColor("bd_status", i, "6")
				ElseIf szStatus == "5" Then
					grdList.SetCellData("bd_status", i, "해지")
					grdList.SetCellFgColor("bd_status", i, "6")
				ElseIf szStatus == "8" Then
					grdList.SetCellData("bd_status", i, "고객취소")
					grdList.SetCellFgColor("bd_status", i, "6")
				ElseIf szStatus == "7" Then
					grdList.SetCellData("bd_status", i, "승인거절")
					grdList.SetCellFgColor("bd_status", i, "6")
				End If
				
				Dim szToday
				szToday = Form.GetSharedData("&HOST_DATE", false)
				
				'하단버튼 처리
				'승인대기 상태이고 + 당일 신청한 내역일 경우 취소가능
				If szStatus == "1" And (szRegDt == szToday) Then
					grdList.SetCellData("ProcYn", i, "Y")
					grdList.SetCellData("bd_proc", i, "취소하기")
					grdList.SetCellImage("bd_proc", i, "img_bgbox.9.png")
					
				'승인완료 또는 재투자승인 상태이고 + 현재 날짜가 만기일 전날까지의 범위인 경우 + 재투자여부가 재투자인 경우
'				ElseIf (szStatus == "2" Or szStatus == "3") And (CInt(szToday) < CInt(szExpDt)) And szReYn == "Y" Then

				'해지가능여부 데이터 추가 CANC_ABLE_YN
				ElseIf (szStatus == "2" Or szStatus == "3") And szCancYn == "Y" Then
					grdList.SetCellData("ProcYn", i, "Y")
					grdList.SetCellData("bd_proc", i, "해지신청하기")
					grdList.SetCellImage("bd_proc", i, "img_bgbox.9.png")
					
				'그 외는 버튼 없음
				Else
					grdList.SetCellData("ProcYn", i, "N")
					grdList.SetCellData("bd_proc", i, "")
					grdList.SetCellImage("bd_proc", i, "alpha")
				End If
				
				'서비스 처리에 필요한 데이터들
				grdList.SetCellData("Data1", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "PRGS_STAT_CODE" , i))	'진행상태코드
				grdList.SetCellData("Data2", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ISCD" , i))			'종목코드
				grdList.SetCellData("Data3", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACPT_DATE" , i))		'접수일자
				grdList.SetCellData("Data4", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "ACPT_SRNO" , i))		'접수일련번호
				grdList.SetCellData("Data5", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BYOV_DATE" , i))		'매수일자
				grdList.SetCellData("Data6", i, DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "BYOV_SRNO" , i))		'매수일련번호
			Next
		Else
			grdList.visible = false
			lblNoData.visible = true
		End If
	
	'CDS 취소 신청
	ElseIf szTranID == "obsat_cdss_002a" Then
		Form.MsgBox("안내", "거래 신청이 취소 되었습니다.", "PROC_COMPLETE", 6)
	
	'CDS 해지 신청
	ElseIf szTranID == "obsat_cdss_003a" Then	
		Form.MsgBox("안내", "해지 신청이 완료 되었습니다.", "PROC_COMPLETE", 6)
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szMsgCode, szMsgText, szSubText
	szMsgCode = DATAMANAGER.GetDataMsgCode(szTranID)
	szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
	szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubText <> "" And szSubText <> null Then
		Form.ShowAlert("알림", szMsgText & "(" & szSubText &")")
	Else
		Form.ShowAlert("알림", szMsgText)
	End If
End Sub

'============================================================================
Function f_SetCondText()
	Dim szReturnText
	If g_szPeriodType == "1" Then
		szReturnText = "최근1주일·"
	ElseIf g_szPeriodType == "2" then
		szReturnText = "최근1개월·"
	Else
		szReturnText = Mid(g_szFromDt, 3, 2) & "/" & Mid(g_szFromDt, 5, 2) & "/" & Right(g_szFromDt, 2) & "~" & Mid(g_szToDt, 3, 2) & "/" & Mid(g_szToDt, 5, 2) & "/" & Right(g_szToDt, 2) & "·"
	End If
	
	If g_szStatusGb == "%" Then
		szReturnText = szReturnText & "전체"
	ElseIf g_szStatusGb == "1" Then
		szReturnText = szReturnText & "신청완료"
	ElseIf g_szStatusGb == "2" Then
		szReturnText = szReturnText & "매수승인"
	ElseIf g_szStatusGb == "3" Then
		szReturnText = szReturnText & "재투자승인"
	ElseIf g_szStatusGb == "4" Then
		szReturnText = szReturnText & "취소"
	ElseIf g_szStatusGb == "5" Then
		szReturnText = szReturnText & "해지"
	End If
	
'	szReturnText = szReturnText & "∨"
	
	Return szReturnText
End Function

'============================================================================
Sub btnCond_OnClick()
	'검색조건 팝업 오픈
	'진행상태구분값★기간구분값★시작일자★종료일자
	Dim szSendData
	szSendData = g_szStatusGb & "★" & g_szPeriodType & "★" & g_szFromDt & "★" & g_szToDt
	Form.OpenPopupAnimation( "mbonl88027_p3", szSendData, "", "2" )
End Sub

'============================================================================
Sub grdList_OnClickUp(lRow, szCellID)
	'취소하기 또는 해지신청하기
	If szCellID == "bd_proc" Then
		g_nSelectRow = CInt(lRow)
		
		Dim szStatus, szTime, szProcYn
		szTime = Form.GetSharedData("&HOST_TIME", false)
		szStatus = grdList.GetCellData("Data1", g_nSelectRow)		'진행상태코드
		szProcYn = grdList.GetCellData("ProcYn", g_nSelectRow)	'취소 또는 해지 가능여부
		If szStatus == "1" And szProcYn == "Y" Then		'취소
			'************************ test 목적으로 09시~21시까지 시간 체크 *****************************
'			If CInt(szTime) < 90000 Or CInt(szTime) > 210000 Then
			If CInt(szTime) < 90000 Or CInt(szTime) > 150000 Then
				Form.ShowAlert("알림", "신청시간이 아닙니다.\n신청가능시간 09:00 ~ 15:00")
				Exit Sub
			End If
			
			'취소 확인 메시지박스 노출
			Form.MsgBox("안내", "거래신청을 취소 하시겠습니까?", "CANCEL_CONFIRM", 7, "거래신청취소", "닫기")
			
		ElseIf (szStatus == "2" Or szStatus == "3") And szProcYn == "Y" Then		'해지
			'************************ test 목적으로 09시~21시까지 시간 체크 *****************************
'			If CInt(szTime) < 90000 Or CInt(szTime) > 210000 Then
			If CInt(szTime) < 90000 Or CInt(szTime) > 150000 Then
				Form.ShowAlert("알림", "신청시간이 아닙니다.\n신청가능시간 09:00 ~ 15:00")
				Exit Sub
			End If
			
			'해지 확인 팝업 오픈
			Form.OpenPopupAnimation("mbonl88027_p4", "", "", "2")
		End If
	End If
End Sub

'============================================================================
Sub cmbSort_OnEditComplete(iIndex)
	grdList.SetClear()
		
	'CDS 매수 신청 대상 조회
	DATAMANAGER.RequestTranData( "obsat_cdss_004r" )
End Sub

