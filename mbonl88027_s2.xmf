Dim g_szAcno
Dim g_szAsno
Dim g_szPwd
Dim g_szStatusGb			'진행상태 조회 구분값
Dim g_szPeriodType		'기간설정 "1":1주일, "2":1개월, "3":직접입력
Dim g_szFromDt
Dim g_szToDt
Dim g_nSelectRow

'============================================================================
