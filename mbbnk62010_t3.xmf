'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 오픈뱅킹_한번에 잔액 모으기 1단계
' 02. 화면설명 : 한번에 잔액 모으기 1단계
' 03. 작    성 : 2020.10.12 장원혁
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'전역 변수 선언

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'============================================================================
Sub Form_OnFormInit()

    szAcnt = Form.GetSharedData("mbbnk62010_MNRC_ACNO" , False )
    
    LblAcnt.caption = szAcnt

    Dim szList

    szData = Form.GetSharedData("mbbnk62010_MultiRowData" , False)
       
    szList = Split(szData, "●")
    If UBOUND(szList) < 1 then
        Exit Sub
    End If
    
    MNRC_AMT = 0
    
    For i = 0 To 4
        CurrentData = Split(szList(i),"★")
        'If UBOUND(szList(i)) < 1 then
            'Exit Sub
        'End If
        Grid0.AddRow()
        Grid0.SetCellData("bd_cell0" , i , CurrentData(0))
        Grid0.SetCellData("bd_cell1" , i , CurrentData(1))
	
        MNRC_AMT = MNRC_AMT + Grid0.GetCellData("bd_cell1", i)
	
    Next
    
    LblMnrcAmt.caption = FormatNumber(MNRC_AMT, 0) & "원"
    
    szData = Form.GetSharedData("mbbnk62010_RSLT_CODE" , False )

    CurrentData = Split(szData,"★")
    If UBOUND(CurrentData) < 1 then
       Exit Sub
    End If

    Grid0.SetCellData("bd_cell2" , 0 , CurrentData(0))
    Grid0.SetCellData("bd_cell2" , 1 , CurrentData(1))
    Grid0.SetCellData("bd_cell2" , 2 , CurrentData(2))
    Grid0.SetCellData("bd_cell2" , 3 , CurrentData(3))
    Grid0.SetCellData("bd_cell2" , 4 , CurrentData(4))
    
    SUCC_CNT = 0
    FAIL_CNT = 0
    
    For i = 0 To 4 
        If Grid0.GetCellData("bd_cell2" , i) = "정상" Then
	        SUCC_CNT = SUCC_CNT + 1
        ElseIf TRIM(Grid0.GetCellData("bd_cell2" , i)) <> "" Then
	        FAIL_CNT = FAIL_CNT + 1
        End If
    Next
    
    Label3.Caption = "성공 " & SUCC_CNT & "건"
    Label4.Caption = "실패 " & FAIL_CNT & "건"
    
End Sub

'============================================================================
Sub BtnCncl_OnClick()
     Form.SendReturnToParent("CLOSE_YN" , "Y")
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("CLOSE_YN" , "Y")
End Sub


