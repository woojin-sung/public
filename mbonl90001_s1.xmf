'============================================================================
'배너 페이지로 정보 전달
sub f_sendTrigger(iIndex, iCnt)
	szData = iIndex + 1 & "|" &				'0 순번
			iCnt & "|" &					'1 전체갯수
			g_szQryType & "|" &			'2 조회구분  1, 2
			g_szBanner[iIndex][0] & "|" &	'3 조회우선순위
			g_szBanner[iIndex][1] & "|" &	'4 일련번호
			g_szBanner[iIndex][2] & "|" &	'5 상품유형코드	  09:채권(장내), 12:단기사채, 99:채권(장외)
			g_szBanner[iIndex][3] & "|" &	'6 투자대상유형코드  13:장외채권, 46:단기사채(발행물), 20:단기사채(유통물)
			g_szBanner[iIndex][4] & "|" &	'7 종목코드
			g_szBanner[iIndex][5] & "|" &	'8 종목명
			g_szBanner[iIndex][6] & "|" &	'9 매수수익률
			g_szBanner[iIndex][7] & "|" &	'10 추천상세내용(tag값)
			g_szAccount			& "|" &	'11	
			g_szAccountSeq		& "|" &	'12
			g_szPwd				& "|" &	'13	
			g_COMN_PFIN_YN		& "|" &	'14 전문투자자 여부
			g_PFIN_VLDT_EXPR_YN	& "|" &	'15 전문투자자 만료 여부
			g_CUST_CLS_CODE		& "|" &	'16 고객구분코드(2:법인)				
			g_szBanner[iIndex][8] & "|" &	'17 KYC상품등급코드
			g_szBanner[iIndex][9] & "|" &	'18 장외)신용등급
			g_szBanner[iIndex][10] & "|" &	'19 장외)채권분류명
			g_szBanner[iIndex][11] & "|" &	'20 장외)잔존일수
			g_szBanner[iIndex][12] & "|" &	'21 장외)표면이자율
			g_szBanner[iIndex][13] & "|" &	'22 장외)매매단가
			g_szBanner[iIndex][14] & "|" &	'23 단기사채)투자기간
			g_szBanner[iIndex][15] & "|" &	'24 단기사채)만기일
			g_szBanner[iIndex][16]			'25 단기사채)가능수량
	
'	Form.ShowAlert("90001_s1_f_sendTrigger", szData)
	Form.triggerEvent("FormTab0." & contMain.FormTab0.currenttabpageid, "Forminit", szData)
end sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
