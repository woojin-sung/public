Sub Form_OnFormInitBefore()
	
End Sub


'============================================================================
Sub Form_OnFormInit()
'	Dim szData
	
'	szData = Form.GetOpenLinkData()
'	szList = Split(szData , "★")

	'고객ID
	g_szUSERID = Form.GetSharedData("&USER_ID", false )
	
	'고객번호
	g_szCsno = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴

	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
		
	g_szQryType               = 2
	g_HLDY_YN                 = "N"
	g_DEAL_ABLE_YN 	  	   = "Y"
	g_IQRY_CSNU			   = 0
	g_COMN_PFIN_YN      	   = "N"
	g_PFIN_VLDT_EXPR_YN 	   = "N"
	
	g_KYC_INVT_INCL_GRAD_CODE = "05"
	g_KYC_INVT_INCL_GRAD_NAME = "이자소득형"
	g_IVIC_VLDT_EXPR_YN       = "N"
	g_KYC_INVT_RCMD_CLS_CODE  = "1"
	
	g_szAccount			= ""
	g_szAccountSeq		= ""
	g_szPwd				= ""
	g_COMN_PFIN_YN		= ""
	g_PFIN_VLDT_EXPR_YN	= ""
	
'	f_setState(0)
	
	g_szBanner = {}
	contMain.FormTab0.deleteAllPage()
		
End Sub


'============================================================================


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , "mbonl90001_s1("..szTranID..")\n" .. szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , "mbonl90001_s1("..szTranID..")\n" .. szErrCode .. " : ".. szErrMsg)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obsab_deal_601r" then
'		Form.ShowAlert("90001_s1_TranBefore"..szTranID, g_KYC_INVT_INCL_GRAD_CODE)
	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE",		0 , g_szQryType)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ELFN_ID", 			0 , g_szUSERID)		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "KYC_INVT_INCL_GRAD_CODE",	0 , g_KYC_INVT_INCL_GRAD_CODE)
		
	end if  'end of if szTranID == "obsab_deal_601r"
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	Form.ShowAlert("TranComplete", szTranID)
	Dim szData, iCnt, iLength
	Dim iIndex
	
	if szTranID == "obsab_deal_601r" then		
		'배열의 크기 구하기
		iLength = #g_szBanner  'UBound(g_szBanner) - LBound(g_szBanner) + 1
		
		g_IQRY_CSNU = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "IQRY_CSNU", 0)
		
		iCnt = CInt(DATAMANAGER.GetDataCount(0, szTranID, "OutBlock4" ))
'		Form.ShowAlert("TranComplete1", iLength & " , " & iCnt)
		
		for i = 0 to iCnt - 1
			table.insert(g_szBanner, {})
			
			g_szBanner[i + iLength] = {}
		
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "IQRY_PRTY_RANK" , i)
			table.insert(g_szBanner[i+iLength], szData)
'			Form.ShowAlert("TranComplete1", szData)
'			Form.ShowAlert("TranComplete2", g_szBanner[i+iIndex][0])
						
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "SRNO", i)
			table.insert(g_szBanner[i+iLength], szData)
						
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "PROD_TPCD", i)
			table.insert(g_szBanner[i+iLength], szData)
			
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "INVT_TRGT_TYPE_CODE", i)
			table.insert(g_szBanner[i+iLength], szData)
			
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "ISCD" , i)
			table.insert(g_szBanner[i+iLength], szData)
			
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "ISNM" , i)
			table.insert(g_szBanner[i+iLength], szData)
			
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "BYOV_ERT" , i)
			table.insert(g_szBanner[i+iLength], szData)
			
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "PROD_RCMT_DTL_CNTT" , i)
			table.insert(g_szBanner[i+iLength], szData)
			
			'// 2024.05.02 OutBlock 항목 추가------------------------------------------------------
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "KYC_PROD_GRAD_CODE" , i)
			table.insert(g_szBanner[i+iLength], szData)
			
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "CRDT_GRAD_CODE" , i)
			table.insert(g_szBanner[i+iLength], szData)
			
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "BOND_DIV_NAME" , i)
			table.insert(g_szBanner[i+iLength], szData)
			
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "RMNN_DYNU" , i)
			table.insert(g_szBanner[i+iLength], szData)
			
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "SRFC_INTRT" , i)
			table.insert(g_szBanner[i+iLength], szData)
			
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "DEAL_UNPR" , i)
			table.insert(g_szBanner[i+iLength], szData)
			
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "INVT_DYNU" , i)
			table.insert(g_szBanner[i+iLength], szData)
			
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "MTRT_DATE" , i)
			table.insert(g_szBanner[i+iLength], szData)
			
			szData = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock4" , "RMNN_WNCR_AMT" , i)
			table.insert(g_szBanner[i+iLength], szData)			
			'// 2024.05.02 OutBlock 항목 추가------------------------------------------------------
			
			
'			contMain.FormTab0.insertPage( contMain.FormTab0.tabcount, "page"..i, "page"..i, "mbonl90001_b1", "1", "Bond365배너")
			
'			Form.ShowAlert("", g_szBanner[i+iIndex][0] & " : " &
'							 g_szBanner[i+iIndex][1] & " : " &
'							 g_szBanner[i+iIndex][2] & " : " &
'							 g_szBanner[i+iIndex][3] & " : " &
'							 g_szBanner[i+iIndex][4] & " : " &
'							 g_szBanner[i+iIndex][5] & " : " &
'							 g_szBanner[i+iIndex][6] & " : " &		
'							 g_szBanner[i+iIndex][7] & " : " &		
'							 g_szBanner[i+iIndex][8] & " : " &		
'							 g_szBanner[i+iIndex][9] & " : " &		
'							 g_szBanner[i+iIndex][10] & " : " &		
'							 g_szBanner[i+iIndex][11] & " : " &		
'							 g_szBanner[i+iIndex][12] & " : " &		
'							 g_szBanner[i+iIndex][13] & " : " &		
'							 g_szBanner[i+iIndex][14] & " : " &		
'							 g_szBanner[i+iIndex][15] & " : " &		
'							 g_szBanner[i+iIndex][16]
'			)
'			
		next
				
		if DATAMANAGER.IsMoreNextData(szTranID) == true then
			'다음 조회 요청
			DATAMANAGER.RequestNextData(szTranID)
			
		else
			iLength = #g_szBanner   'UBound(g_szBanner) - LBound(g_szBanner) + 1
			
'			Form.ShowAlert("TranComplete2", "make banner : " & iLength)
			
			'폼탭에 배너페이지 추가
			if iLength > 0 then
				contMain.FormTab0.visible = False
				contMain.FormTab0.deleteAllPage()
				
				for i = 0 to iLength - 1
					szData = "page"..CStr(i)
					
					contMain.FormTab0.insertPage(contMain.FormTab0.tabcount, szData, szData, "mbonl90001_b1", "0", "Bond365배너")
					contMain.FormTab0.currenttab = contMain.FormTab0.tabcount - 1
					
					f_sendTrigger(i, iCnt)					
				next			
				
				'page가 2개일 경우 스크롤시 빈화면이 노출되기 때문에 자연스럽게 만들기 위해서 4개로 만들어준다.
				if iLength == 2 then
					contMain.FormTab0.insertPage(contMain.FormTab0.tabcount, "page2", "page2", "mbonl90001_b1", "0", "Bond365배너")
					contMain.FormTab0.currenttab = contMain.FormTab0.tabcount - 1						
					f_sendTrigger(0, iCnt)
					
					contMain.FormTab0.insertPage(contMain.FormTab0.tabcount, "page3", "page3", "mbonl90001_b1", "0", "Bond365배너")
					contMain.FormTab0.currenttab = contMain.FormTab0.tabcount - 1						
					f_sendTrigger(1, iCnt)
				
				'end of if iCnt == 2
				end if
				
				contMain.FormTab0.currenttab = 0
				contMain.FormTab0.visible = True
				
				if iLength > 1 then
					contMain.FormTab0.setAutoScroll(true, 4)
				end if
				
			'end of if iLength > 0 then
				
			end if  
			
			f_setState(iLength)
'			f_setState(0)
			
'		'end of if DATAMANAGER.IsMoreNextData(szTranID) == true
		end if
		
	'end of if szTranID == "obsab_deal_601r"	
	end if
	
'	Form.ShowAlert("TranComplete5", i)
End Sub

'============================================================================
Sub contMain_lblGuide_OnClick()
	Form.OpenPopup("mbonl90002", "", "")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)	
	if sEventName == "obsab_deal_601r" then
'		Form.ShowAlert("90001_s1_TriggerEvent", sParam)
		
		g_szLinkData = sParam
		g_szList = Split(g_szLinkData , "|")
		
		g_szQryType               	= g_szList(0)		'조회구분 : 1:전체조회, 2:내성향에 맞춰
		g_HLDY_YN                 	= g_szList(1)		'휴일여부
		g_DEAL_ABLE_YN 	  	   	= g_szList(2)		'거래가능일 여부
	 	
		g_COMN_PFIN_YN      	   	= g_szList(3)		'전문투자자 여부
		g_PFIN_VLDT_EXPR_YN 	   	= g_szList(4)		'전문투자자 만료 여부
		
		g_KYC_INVT_INCL_GRAD_CODE 	= g_szList(5)		'투자자등급 코드
		g_KYC_INVT_INCL_GRAD_NAME 	= g_szList(6)		'투자자등급명
		g_IVIC_VLDT_EXPR_YN       	= g_szList(7)		'투자자등급 만료 여부
		g_KYC_INVT_RCMD_CLS_CODE  	= g_szList(8)		'투자자권유 구분코드 
		'1:투자권유희망 + 정보제공
		'2:투자권유희망 + 정보미제공
		'3:투자권유불원 + 정보제공
		'4:투자권유불원 + 정보미제공
				
		g_szAccount				= g_szList(9)
		g_szAccountSeq			= g_szList(10)
		g_IQRY_CSNU				= g_szList(11)	'조회건수
		g_CUST_CLS_CODE			= g_szList(12)	'고객구분코드(2:법인)
				
'		f_setState(0)
		
		g_szBanner = {}
		contMain.FormTab0.deleteAllPage()
				
		DATAMANAGER.RequestTranData( "obsab_deal_601r" )
	end if 
	
End Sub

'============================================================================


'test용으로 사용중
'============================================================================
Sub contMain_Button0_OnClick()
	if g_szQryType == 1 then
		g_szQryType = 2
	else
		g_szQryType = 1
	end if
	
	g_HLDY_YN                 = "N"
	g_DEAL_ABLE_YN 	  	   = "Y"
	
	g_COMN_PFIN_YN      	   = "N"
	g_PFIN_VLDT_EXPR_YN 	   = "N"
	
	g_KYC_INVT_INCL_GRAD_CODE = "05"
	g_KYC_INVT_INCL_GRAD_NAME = "이자소득형"
	g_IVIC_VLDT_EXPR_YN       = "N"
	g_KYC_INVT_RCMD_CLS_CODE  = "1"
			
	f_setState(0)
	
'	for k, v in pairs(g_szBanner) 
'		g_szBanner[k] = null
'	next
	
	g_szBanner = {}
	contMain.FormTab0.deleteAllPage()
	
	DATAMANAGER.RequestTranData( "obsab_deal_601r" )
End Sub

