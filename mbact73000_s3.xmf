	g_BDM_OTSD_TR_UNIQ_NO      = Form.GetSharedData("BDM_OTSD_TR_UNIQ_NO" 	, false) 
	g_BDM_RSPN_TYPE_CODE       = Form.GetSharedData("BDM_RSPN_TYPE_CODE" 	, false) 
	g_BDM_IDNTF_TORF_YN        = Form.GetSharedData("BDM_IDNTF_TORF_YN" 	     , false) 
	g_BDM_IDNTF_IMG_DATA_SIZE  = Form.GetSharedData("BDM_IDNTF_IMG_DATA_SIZE", false) 
	g_BDM_KAKAO_TR_DATE        = Form.GetSharedData("BDM_KAKAO_TR_DATE" 		, false) 

End Function


'============================================================================
Sub Form_OnFormInit()
	'공유변수 Get
	User_SharedData_Get()
	
	'뒤로가기(물리버튼) 막음
	'Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
End Sub



'============================================================================
'촬영하기 버튼
'============================================================================
Sub BtnRunCamera_OnClick()
	
	Form.runInziCamera()
	'Form.OpenPopupAnimation("mbbdm85120_p1"  , "" , "", "2")
	
End Sub

'============================================================================
'코치마크 화면오픈
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
    '안드로이드-백버튼 작동X
    '부모창이 먼저 닫히는 오류방지를 위해 해당화면은 백버튼 작동X 처리
    Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
    
	if sKeyName = "mbbdm85120_p1" then
		if sRet = "close" then
			Form.runInziCamera()
			
		end if
		
	elseif sKeyName = "mbbdm85121" then
	
		if sRet = "OCREND" then
			Form.CloseForm()
		end if

	elseif sKeyName == "mbact73000_s4" then
		if sRet == "complete_ok" then
			
			'공유변수 설정
			User_SharedData_Set("")
			Form.OpenNextPopup("mbact73000_s5" , "" , "")
		elseif sRet == "exit" then	
			Form.OpenNextPopup("mbact73000" , "" , "")
		end if		
	end if	
		
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "OCRCOMPLETE" then
		if sParam == "1" then
			
			'공유변수 Set
			User_SharedData_Set("")
			Form.OpenNextPopup("mbact73000_s4" , "" , "")
			
		end if
		
	end if
	
End Sub

