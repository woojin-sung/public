	g_BDM_HP2              	= Form.GetSharedData("BDM_HP2"                , false)
	g_BDM_HP3               	= Form.GetSharedData("BDM_HP3"                , false)

	'신분증진위확인에서 설정되는 정보 ---------------------------------------
	g_BDM_IDNTF_SRNO			= Form.GetSharedData("BDM_IDNTF_SRNO"        	, false)	'신분증일련번호

	'이어하기안내용, 진행상태보기용 Data ---------------------------------------
'	g_BDM_LAST_STAG_CLS_CODE 	= Form.GetSharedData("BDM_LAST_STAG_CLS_CODE"	, false)	'최종등록단계구분코드
