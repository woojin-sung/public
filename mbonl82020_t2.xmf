'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 담보대출신청
' 02. 화면설명 : 담보대출신청_예탁담보가능계좌등록
' 03. 작    성 : 2016.02.01 김보라
' 04. 변    경 : 2021.07.01 v001 법인인 경우 개인정보처리동의 제외
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sAcc '계좌번호
Dim g_nNextFlag
Dim G_PERSONAL_AGREE_FILE '개인정보제공 및 활용동의풀팝업
Dim g_sCustClsCode	'v001 고객구분코드

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'===========================================================================
' 계좌비밀번호 입력체크함수
'===========================================================================
Function GetPWCkeck()
	Dim sACNT_PWD 
	sACNT_PWD = Form.GetCtlProp( "#EditPW0", "caption" )
	
	if sACNT_PWD == null or sACNT_PWD == "" then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	end if
	
	return false
End Function	

'===========================================================================
' 속성 초기화함수
'===========================================================================
Function SetControlViewClear()
	g_nNextFlag = false
	
	Table0.SetCellString( 1, 0, "" )
	Table0.SetCellString( 1, 1, "" )
	Table0.SetCellString( 1, 2, "" )
	
	for i = 0 to Grid0.rowcount-1
		Grid0.SetCellData( "bd_check", i, "0" )
		Grid0.SetCellData( "bd_check1", i, "0" )
	next
	Grid0.rowcount = "0"
	
	for i = 0 to Grid1.rowcount-1
		Grid1.SetCellData( "bd_check", i, "0" )
		Grid1.SetCellData( "bd_check1", i, "0" )
	next
	Grid1.rowcount = "0"
	
End Function	

'===========================================================================
' 숫자 리턴함수
'===========================================================================
Function GetTonumber(sNum)
	Dim nDbl
	nDbl = 0
	
	if sNum == null or Trim(sNum) == "" then
		return nDbl
	end if
	
	nDbl = CDbl(sNum)
	
	return nDbl
End Function

'===========================================================================
' 그리드 세팅함수
' 등록인경우(모든계좌표시)
' 등록계좌 	체크 and disable
' 미등록계좌 	미체크 and able

' 해지인경우(등록된계좌만표시)
' 등록계좌 	체크 and able
'===========================================================================
Function SetCheckGridView()
	if RdoGubun.currentindex == "0" then
		ButtonOK.caption = "등록"
		
		Grid0.visible = true
		Grid1.visible = false
		ChkButton0.checkstate = "0"
		Button0.enable = true
	else
		ButtonOK.caption = "해지"
		
		Grid0.visible = false
		Grid1.visible = true
		ChkButton0.checkstate = "0"
		Button0.enable = false
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_sAcc = ""
	g_nNextFlag = false
	
	call RdoGubun_OnClick(1)
	G_PERSONAL_AGREE_FILE = "mbonl81020"
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "TabChange" then
		'비밀번호없이 조회되도록 요청하여 주석처리
'		if GetPWCkeck() then
'			Exit Sub
'		end if
		
		g_sAcc = sParam
		
		SetControlViewClear()	
		call RdoGubun_OnClick(1) 'v001
		DATAMANAGER.RequestTranData( "oblon_basc_800r" ) '대출가능계좌조회
		DATAMANAGER.RequestTranData( "obcsb_acad_002r" ) 'v001 고객구분조회
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim sACNT_PWD 
	'sACNT_PWD = Form.GetCtlProp( "#EditPW0", "caption" )
	Dim plain_rm
	
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'MTS메모리평문 적용상태일때
	if plain_rm == "1" then
		sACNT_PWD = Form.GetCtlProp( "#EditPW0", "caption" )
	'MTS메모리평문 미적용상태일때
	else
		sACNT_PWD = Form.GetCtlProp( "#EditPW0", "encdata" )
	end if
	'MTS메모리보안
	'sACNT_PWD = Form.GetEncData(sACNT_PWD)
	
	
	if szTranID == "oblon_basc_800r" then
		DATAMANAGER.SetDataValue( 0, "oblon_basc_800r", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_800r", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_800r", "InBlock1", "PROS_CLS_CODE" , 0 , "1" ) '등록
		DATAMANAGER.SetDataValue( 0, "oblon_basc_800r", "InBlock2", "ACNO" , 0 , Left(g_sAcc, 8) )
	elseif szTranID == "oblon_basc_800r_1" then
		DATAMANAGER.SetDataValue( 0, "oblon_basc_800r_1", "InBlock1", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_800r_1", "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_800r_1", "InBlock1", "PROS_CLS_CODE" , 0 , "2" ) '해지
		DATAMANAGER.SetDataValue( 0, "oblon_basc_800r_1", "InBlock2", "ACNO" , 0 , Left(g_sAcc, 8) )
	elseif szTranID == "oblon_basc_800a" then
		Dim sProsDate
		Dim sProsSrno
		sProsDate = Form.GetSharedData( "PROS_DATE", false )
		sProsSrno = Form.GetSharedData( "PROS_SRNO", false )
		
		DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock2", "ACNO" , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock2", "ACNT_PWD" , 0 , sACNT_PWD )
		DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock2", "CRDT_AGRM_BSWR_KIND_CLCD", 0, "014")
		DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock2", "PROS_DATE", 0, sProsDate)
		DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock2", "PROS_SRNO", 0, sProsSrno)
	elseif szTranID == "obcsb_acad_002r" then 'v001
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "ACNO"  , 0 , Left(g_sAcc, 8) )
		DATAMANAGER.SetDataValue( 0, "obcsb_acad_002r", "InBlock1", "PWD"   , 0 , sACNT_PWD)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "oblon_basc_800r" then
		Dim nCnt, nGridCnt
		nCnt = DATAMANAGER.GetDataCount( 0, "oblon_basc_800r", "OutBlock2" )
		ChkButton0.checkstate = "0"
		if nCnt > 0 then
			Dim CANC_YN, LIMT_AMT, REG_DATE
			
			for i = 0 to nCnt-1 
				CANC_YN = DATAMANAGER.GetDataValue( 0, "oblon_basc_800r", "OutBlock2", "CANC_YN" , i ) '해지여부
				LIMT_AMT = DATAMANAGER.GetDataValue( 0, "oblon_basc_800r", "OutBlock2", "LIMT_AMT" , i ) '약정금액
				REG_DATE = DATAMANAGER.GetDataValue( 0, "oblon_basc_800r", "OutBlock2", "REG_DATE" , i ) '약정일자
						
				if i == 0 then
					if CANC_YN == "" or CANC_YN == "Y" then
						Table0.SetCellString( 1, 0, "등록" )
						Table0.SetCellString( 1, 1, REG_DATE )
						Table0.SetCellString( 1, 2, LIMT_AMT )
					else
						Table0.SetCellString( 1, 0, "미등록" )
					end if
				end if
			next
		end if
	
		nCnt = DATAMANAGER.GetDataCount( 0, "oblon_basc_800r", "OutBlock1" )
		nGridCnt = GetTonumber(Grid0.rowcount)
		
		if nCnt > 0 then
			Dim ACNO, ASNO, UI_DEPS_MORG_STPL_YN
		
			for i = 0 to nCnt-1
				ACNO = DATAMANAGER.GetDataValue( 0, "oblon_basc_800r", "OutBlock1", "ACNO" , i )
				ASNO = DATAMANAGER.GetDataValue( 0, "oblon_basc_800r", "OutBlock1", "ASNO" , i )
				UI_DEPS_MORG_STPL_YN = DATAMANAGER.GetDataValue( 0, "oblon_basc_800r", "OutBlock1", "UI_DEPS_MORG_STPL_YN" , i )
				SELN_ASCR_STPL_YN = DATAMANAGER.GetDataValue( 0, "oblon_basc_800r", "OutBlock1", "SELN_ASCR_STPL_YN" , i )
				
				Grid0.SetCellData( "bd_acc", i, ACNO..ASNO )
				
				if UI_DEPS_MORG_STPL_YN == "1" then
					Grid0.SetCellEnable( "bd_check", i, false )
				else
					Grid0.SetCellEnable( "bd_check", i, true )
				end if
				
				if SELN_ASCR_STPL_YN == "1" then
					Grid0.SetCellEnable( "bd_check1", i, false )
				else
					Grid0.SetCellEnable( "bd_check1", i, true )
				end if
			next
		end if
		
		DATAMANAGER.RequestTranData( "oblon_basc_800r_1" ) '대출가능계좌조회
	elseif szTranID == "oblon_basc_800r_1" then
		Dim nCnt, nGridCnt
		nCnt = DATAMANAGER.GetDataCount( 0, "oblon_basc_800r_1", "OutBlock1" )
		nGridCnt = GetTonumber(Grid1.rowcount)
		
		if nCnt > 0 then
			Dim ACNO, ASNO
		
			for i = 0 to nCnt-1
				ACNO = DATAMANAGER.GetDataValue( 0, "oblon_basc_800r_1", "OutBlock1", "ACNO" , i )
				ASNO = DATAMANAGER.GetDataValue( 0, "oblon_basc_800r_1", "OutBlock1", "ASNO" , i )
				'16-03-25 해지시 등록하지 않은 부분은 enalbe 처리 요청 - 전요셉과장님
				UI_DEPS_MORG_STPL_YN = DATAMANAGER.GetDataValue( 0, "oblon_basc_800r_1", "OutBlock1", "UI_DEPS_MORG_STPL_YN" , i )
				SELN_ASCR_STPL_YN = DATAMANAGER.GetDataValue( 0, "oblon_basc_800r_1", "OutBlock1", "SELN_ASCR_STPL_YN" , i )
				
				Grid1.SetCellData( "bd_acc", i, ACNO..ASNO )
				
				if UI_DEPS_MORG_STPL_YN ~= "1" then
					Grid1.SetCellEnable( "bd_check", i, false )
				else
					Grid1.SetCellEnable( "bd_check", i, true )
				end if
				
				if SELN_ASCR_STPL_YN ~= "1" then
					Grid1.SetCellEnable( "bd_check1", i, false )
				else
					Grid1.SetCellEnable( "bd_check1", i, true )
				end if
			next
			
			for i = nGridCnt-1 to 0 step -1
				if Grid1.GetCellData( "bd_ye", i ) ~= "1" and Grid1.GetCellData( "bd_slsc", i ) ~= "1" then
					Grid1.SetDeleteRow(i)
				end if
			next
		end if
	elseif szTranID == "oblon_basc_800a" then
		Dim sMsg, sSubMsg
		sMsg = DATAMANAGER.GetDataMsgText( szTranID )
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
			sMsg = sMsg.." "..sSubMsg
		end if
		
		Form.MsgBox( "알림", sMsg, "", 6 )
		
		SetControlViewClear()	
		DATAMANAGER.RequestTranData( "oblon_basc_800r" ) '대출가능계좌조회
	elseif szTranID == "obcsb_acad_002r" then 'v001
		g_sCustClsCode = DATAMANAGER.GetDataValue( 0, "obcsb_acad_002r", "OutBlock5", "CUST_CLS_CODE", 0)
		
		if g_sCustClsCode == "2" then
			Button0.enable = false
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubMsg
	sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if sSubMsg ~= null and Trim(sSubMsg) ~= "" then
		szErrMsg = szErrMsg.." "..sSubMsg
	end if
	
	if szTranID == "oblon_basc_800a" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub

'============================================================================
Sub RdoGubun_OnClick(nIndex)
	SetCheckGridView()
End Sub

'============================================================================
Sub ButtonOK_OnClick()
	if GetPWCkeck() then
		Exit Sub
	end if

	DATAMANAGER.ClearInputData( 0, "oblon_basc_800a" )
	
	if RdoGubun.currentindex == "0" then
		if Table0.GetCellString( 1, 0 ) ~= "등록" then
			Form.MsgBox( "알림", "계좌등록을 위한 약정등록내역이 없습니다.", "", 6 )
			Exit Sub
		end if
		
		if ChkButton0.checkstate == "0" and g_sCustClsCode <> "2" then
			Form.MsgBox("알림", "개인(신용)정보 처리 동의에 동의해주시기 바랍니다", "", 6)
			Exit Sub
		end if
		
		Dim nCnt, nCheckCnt, ACNO, ASNO, UI_DEPS_MORG_STPL_YN, UI_SLSC_STPL_YN, SBSC_ABLE_YN, UI_SPLM_YN
		nCnt = GetTonumber(Grid0.rowcount)
		nCheckCnt = 0
		
		if nCnt > 0 then
			for i = 0 to nCnt-1
				if Grid0.GetCellData( "bd_check", i ) == "1" or Grid0.GetCellData( "bd_check1", i ) == "1" then
					ACNO = Grid0.GetCellData( "bd_acno", i )
					ASNO = Grid0.GetCellData( "bd_asno", i )
					UI_DEPS_MORG_STPL_YN = Grid0.GetCellData( "bd_check", i )
					UI_SLSC_STPL_YN = Grid0.GetCellData( "bd_check1", i )
					SBSC_ABLE_YN = Grid0.GetCellData( "bd_sbsc", i )
					UI_SPLM_YN = Grid0.GetCellData( "bd_splm", i )
		
					DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock1", "PROS_CLS_CODE" , nCheckCnt , "I" )
					DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock1", "ACNO" , nCheckCnt , ACNO )
					DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock1", "ASNO" , nCheckCnt , ASNO )
					DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock1", "UI_DEPS_MORG_STPL_YN" , nCheckCnt , UI_DEPS_MORG_STPL_YN )
					DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock1", "UI_SLSC_STPL_YN" , nCheckCnt , UI_SLSC_STPL_YN)
					DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock1", "SBSC_ABLE_YN" , nCheckCnt , SBSC_ABLE_YN )
					DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock1", "UI_SPLM_YN" , nCheckCnt , UI_SPLM_YN )
					
					nCheckCnt = nCheckCnt+1
				end if
			next
		end if
		
		if nCheckCnt == 0 then
			Form.MsgBox( "알림", "등록할 계좌번호를 선택바랍니다.", "", 6 )
			Exit Sub
		end if
	else
		if Table0.GetCellString( 1, 0 ) ~= "등록" then
			Form.MsgBox( "알림", "계좌해지를 위한 약정등록내역이 없습니다.", "", 6 )
			Exit Sub
		end if
		
		Dim nCnt, nCheckCnt, ACNO, ASNO, UI_DEPS_MORG_STPL_YN, UI_SLSC_STPL_YN, SBSC_ABLE_YN, UI_SPLM_YN
		nCnt = GetTonumber(Grid1.rowcount)
		nCheckCnt = 0
		
		if nCnt > 0 then
			for i = 0 to nCnt-1
				if Grid1.GetCellData( "bd_check", i ) == "1" or Grid1.GetCellData( "bd_check1", i ) == "1" then
					ACNO = Grid1.GetCellData( "bd_acno", i )
					ASNO = Grid1.GetCellData( "bd_asno", i )
					UI_DEPS_MORG_STPL_YN = Grid1.GetCellData( "bd_check", i )
					UI_SLSC_STPL_YN = Grid1.GetCellData( "bd_check1", i )
					SBSC_ABLE_YN = Grid1.GetCellData( "bd_sbsc", i )
					UI_SPLM_YN = Grid1.GetCellData( "bd_splm", i )
					
					DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock1", "PROS_CLS_CODE" , nCheckCnt , "U" )
					DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock1", "ACNO" , nCheckCnt , ACNO )
					DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock1", "ASNO" , nCheckCnt , ASNO )
					DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock1", "UI_DEPS_MORG_STPL_YN" , nCheckCnt , UI_DEPS_MORG_STPL_YN )
					DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock1", "UI_SLSC_STPL_YN" , nCheckCnt , UI_SLSC_STPL_YN )
					DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock1", "SBSC_ABLE_YN" , nCheckCnt , SBSC_ABLE_YN )
					DATAMANAGER.SetDataValue( 0, "oblon_basc_800a", "InBlock1", "UI_SPLM_YN" , nCheckCnt , UI_SPLM_YN )
					
					nCheckCnt = nCheckCnt+1
				end if
			next
		end if
		
		if nCheckCnt == 0 then
			Form.MsgBox( "알림", "해지할 계좌번호를 선택바랍니다.", "", 6 )
			Exit Sub
		end if
	end if
	
	DATAMANAGER.SetEventFlag( "oblon_basc_800a", "A" )
	DATAMANAGER.RequestTranData( "oblon_basc_800a" ) '가능계좌등록
End Sub

'============================================================================
Sub Button0_OnClick()
	if Button0.enable == "1" then
		call Button0_OnClick_Sub()
	end if
End Sub

'============================================================================
Sub Button0_OnClick_Sub()
	Dim sSendData
	sSendData = "014;"&g_sAcc
	Form.OpenFramePopup(G_PERSONAL_AGREE_FILE , sSendData , "")
End Sub
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sRet == "ok" then
		ChkButton0.chksilence = "1"
	end if
End Sub
