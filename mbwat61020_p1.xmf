	<SCRIPT_INFO _len="4606" _ulen="4386" >

Dim g_sAcnt

'============================================================================
Sub Form_OnFormInitBefore()
	ImgBack.setMaintainingRatio("1")
'	imgSearchBg.setMaintainingRatio("1")
	imgSearchIcon.setMaintainingRatio("1")
End Sub

' 뒤로가기
'============================================================================
Sub btnBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.OpenScreen("57020", "")
End Sub

'============================================================================
Sub Form_OnFormInit()
	edtSearch.SetOnOffImage("alpha", "alpha")
	g_sAcnt = Form.GetOpenLinkData()
	tabTitle.currenttab = 1
	tabTitle_OnTabChanged("1")
End Sub

'============================================================================
Sub tabTitle_OnTabChanged(nCurrentTab)
	edtSearch.caption = ""
	
	grdData0.visible = false
	grdData1.visible = false
	grdData0.SetClear()
	grdData1.SetClear()
	lblNoData.visible = false
	
	if CInt(nCurrentTab) = 0 then
		edtSearch.hintcaption = "상품명을 입력해주세요."
		grdData0.visible = true
	elseif CInt(nCurrentTab) = 1 then
		edtSearch.hintcaption = "직원명을 입력해주세요."
		grdData1.visible = true
	end if
End Sub

'============================================================================
Sub imgSearch_OnClick()
	edtSearch.SetShowKeypad(true)
End Sub

'============================================================================
Sub edtSearch_OnEditChar(CharCode)
	lblNoData.visible = false
	
	if CInt(tabTitle.currenttab) = 0 then
		grdData0.SetClear()
		DATAMANAGER.RequestTranData("obwat_csad_023r")
	elseif CInt(tabTitle.currenttab) = 1 then
		grdData1.SetClear()
		DATAMANAGER.RequestTranData("obwat_oiad_021r")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obwat_csad_023r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "WA_PRNM", 0, edtSearch.caption) '랩어카운트상품코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "NRML_YN", 0 , "Y") '정상여부
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO", 0 , g_sAcnt) '계좌번호
		
	elseif szTranID = "obwat_oiad_021r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "NRML_YN", 0 , "Y") '정상여부
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "DPCD", 0 , "") '부서코드
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FLNM", 0, edtSearch.caption) '성명
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obwat_csad_023r" or szTranID = "obwat_oiad_021r" then
		Dim nCount, sText
		nCount = 0
		sText = ""
		
		if szTranID = "obwat_csad_023r" then
			nCount = tonumber(grdData0.rowcount)
			sText = "검색하신 상품이\n존재하지 않습니다."
		elseif szTranID = "obwat_oiad_021r" then
			nCount = tonumber(grdData1.rowcount)
			sText = "검색하신 운용역이\n존재하지 않습니다."
		end if
		
		lblNoData.visible = false
		
		if nCount == 0 then
			lblNoData.visible = true
			lblNoData.caption = sText
		end if
	end if
End Sub

' 상품명 선택
'============================================================================
Sub grdData0_OnClickUp(lRow, szCellID)
	Dim sCode
	sCode = grdData0.GetCellData("code", lRow)
	
	Form.OpenPopup("mbwat61020_p2", g_sAcnt.."|"..sCode.."|", "") '상품검색
End Sub

' 상품명 연속조회
'============================================================================
Sub grdData0_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "obwat_csad_023r" ) then
		DATAMANAGER.RequestNextData( "obwat_csad_023r" )
	end if
End Sub

' 운용역 선택
'============================================================================
Sub grdData1_OnClickUp(lRow, szCellID)
	Dim sEmpno
	sEmpno = grdData1.GetCellData("empno", lRow)
	
	Form.OpenPopup("mbwat61020_p4", "0".."|"..sEmpno.."|", "")
End Sub

' 운용역 연속조회
'============================================================================
Sub grdData1_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "obwat_oiad_021r" ) then
		DATAMANAGER.RequestNextData( "obwat_oiad_021r" )
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "SEARCH_EMP_PRD" then
		Form.OpenPopup("mbwat61020_p2", g_sAcnt.."||"..sRet, "")
	end if
End Sub

