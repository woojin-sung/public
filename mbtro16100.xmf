Dim g_szFromDt
Dim g_szToDt
Dim g_bMore

'============================================================================
Sub Form_OnFormInitBefore()
	contMain.imgToolTip.setMaintainingRatio("2")
	contMain.imgMore.setMaintainingRatio("1")
	
	Image0.setMaintainingRatio("1")
	Image1.setMaintainingRatio("1")
	Image2.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	'비밀번호 투명 버튼을 레이아웃 맨 위로
	btnPwd.bringFront("1")
	
	'툴팁 아이콘 OS별로 위치 조정
	Dim szOSType
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	If szOSType == "1" Then
		contMain.imgToolTip.left = 238
	Else
		contMain.imgToolTip.left = 245
	End If
	
	Dim szDate, szYear
	szDate = Form.GetSharedData("&HOST_DATE", false)
	szYear = Left(szDate, 4)
	
	'조회연도 세팅 (디폴트는 당해년도의 직전년도로 세팅)
	For i = CLng(szYear) To 2018 Step -1		'당해년도부터 순서가 형성되도록
		cmbYear.cbadddatatext = i & "`" & i & "년"
	Next
	cmbYear.cbkeydata = CLng(szYear) - 1
	
	g_szFromDt = cmbYear.cbkeydata & "0101"
	g_szToDt = cmbYear.cbkeydata & "1231"
	
	f_SetClear("All")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "CORRECT_PWD" Then
		If nil ~= sRet And "" ~= sRet Then
			Dim tPwd
			tPwd = Split(sRet, "★") '"nPwdLen★sEncPwd(암호화된 비밀번호)"
			
			if UBOUND(tPwd) > 0 then
				edtPwd.pwdlen = tPwd(1)
				edtPwd.caption = tPwd(0)
				
				lblNoPwd.visible = false
				contMain.visible = true
				
				'해외주식 양도소득 과표 조회(합계)
				DATAMANAGER.RequestTranData( "obtro_stlm_438r" )
			End If
		End If
	End If
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'상단 유의사항
	If sEventName == "INFO_CLICK" Then
		Form.OpenFramePopup("mbtro16100_p2" , "" , "")
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'해외주식 양도소득 과표 조회(합계)
	If szTranID == "obtro_stlm_438r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , acnt.sequence )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PWD" , 0 , edtPwd.caption )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_STA_DATE" , 0 , g_szFromDt )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_FIN_DATE" , 0 , g_szToDt )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "OVRS_STCK_EXCH_IDNO" , 0 , "%" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , cmbSort.cbkeydata )
		If cmbSort.currentindex == "0" Or cmbSort.currentindex == 0 Then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PRCD" , 0 , "%" )
		Else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PRCD" , 0 , acnt.itemcodetype )
		End If
	
	'해외주식 양도소득 과표 조회(종목별 합계)
	ElseIf szTranID == "obtro_stlm_439r" Then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ACNO" , 0 , acnt.total )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ASNO" , 0 , acnt.sequence )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_STA_DATE" , 0 , g_szFromDt )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_FIN_DATE" , 0 , g_szToDt )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , cmbSort.cbkeydata )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "OVRS_STCK_EXCH_IDNO" , 0 , "%" )
		If cmbSort.currentindex == "0" Or cmbSort.currentindex == 0 Then
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PRCD" , 0 , "%" )
		Else
			DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PRCD" , 0 , acnt.itemcodetype )
		End If
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'해외주식 양도소득 과표 조회(합계)
	If szTranID == "obtro_stlm_438r" Then
		lblNoPwd.visible = false
		contMain.visible = true
		cmbSort.visible = true
		cmbYear.visible = true
		cmbQuarter.visible = true
		Image0.visible = true
		Image1.visible = true
		Image2.visible = true
		
		'상단 테이블 데이터
		Dim szSellAmt, szBuyAmt, szNcsrAmt, szPrlsAmt
		szSellAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "WNCR_SELN_AMT" , 0)	'양도가액 합계
		szBuyAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "WNCR_BYOV_AMT" , 0)	'취득가액 합계
		szNcsrAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "NCSR_AMT" , 0)		'필요경비 합계
		szPrlsAmt = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "PRLS_AMT" , 0)		'양도소득 합계
		
		'과세표준 금액과 예상 양도소득세는 계산하여 표시
		contMain.tblData.SetCellString(1, 1, szSellAmt)
		contMain.tblData.SetCellString(2, 1, szBuyAmt)
		contMain.tblData.SetCellString(3, 1, szNcsrAmt)
		contMain.tblData.SetCellString(0, 1, szPrlsAmt)
		contMain.tblData.SetCellString(5, 1, CLng(szPrlsAmt) - 2500000 )
		
		If Clng(szPrlsAmt) < 2500000 Then
			contMain.tblData.SetCellString(5, 1, "0" )
			
			contMain.lblTotal.caption = "0"
		Else
			contMain.tblData.SetCellString(5, 1, CLng(szPrlsAmt) - 2500000 )
			
			contMain.lblTotal.caption = (CLng(szPrlsAmt) - 2500000) * 0.22
		End If
		
		'해외주식 양도소득 과표 조회(종목별 합계)
		DATAMANAGER.RequestTranData( "obtro_stlm_439r" )
	
	'해외주식 양도소득 과표 조회(종목별 합계)
	ElseIf szTranID == "obtro_stlm_439r" Then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1")
		If nCnt > 0 Then
			Dim szItemName, szQty, szSellAmt, szBuyAmt, szFeeTotal, szPrlsAmt, szIscd
			Dim nRow
			nRow = CLng(contMain.grdList.rowcount)
			
			contMain.lblNoData.visible = false
			
			For i = 0 To nCnt - 1 
				contMain.grdList.AddRow()
				
				szItemName = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "KOR_ISNM" , i )		'종목명
				szQty = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "DQTY" , i )				'수량
				szSellAmt = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WNCR_SELN_AMT" , i )	'매도금액
				szBuyAmt = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "WNCR_BYOV_AMT" , i )		'매수금액
				szFeeTotal = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "FEE_SMTN_AMT" , i )	'필요경비
				szPrlsAmt = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "PRLS_AMT" , i )		'양도소득액
				szIscd = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ISCD" , i )				'종목코드
				
				contMain.grdList.SetCellData("bd_title1", nRow+i, "매수금액")
				contMain.grdList.SetCellData("bd_title2", nRow+i, "필요경비")
				contMain.grdList.SetCellData("bd_title3", nRow+i, "매도금액")
				contMain.grdList.SetCellData("bd_title4", nRow+i, "양도소득액")
				contMain.grdList.SetCellData("bd_name", nRow+i, szItemName)
'				contMain.grdList.SetCellData("bd_qty", nRow+i, szQty)
				
				Dim tTemp
				tTemp = Split(szQty, ".")
				If CLng(tTemp[1]) > 0 Then
					contMain.grdList.SetCellData("bd_qty", nRow+i, FormatNumber(szQty, 6))
				Else
					contMain.grdList.SetCellData("bd_qty", nRow+i, FormatNumber(szQty, 0))
				End If
				
				contMain.grdList.SetCellData("bd_buyamt", nRow+i, szBuyAmt)
				contMain.grdList.SetCellData("bd_fee", nRow+i, szFeeTotal)
				contMain.grdList.SetCellData("bd_sellamt", nRow+i, szSellAmt)
				contMain.grdList.SetCellData("bd_trnfamt", nRow+i, szPrlsAmt)
				contMain.grdList.SetCellData("bd_iscd", nRow+i, szIscd)
			Next
		Else
'			Form.ShowAlert("알림", "조회할 내역이 없습니다.")
			
			contMain.lblNoData.visible = true
			
			contMain.tblData.SetCellString(5, 0, "" )
			contMain.tblData.SetCellString(5, 1, "" )
		End If
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	If szSubMsg <> "" And szSubMsg <> null Then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	Else
		Form.ShowAlert("알림", szErrMsg)
	End If
End Sub

'============================================================================
Function f_SetClear(szType)
	'비밀번호 입력 전 상태로 돌리는 경우
	If szType == "All" Then
		lblNoPwd.visible = true
		contMain.visible = false
		cmbSort.visible = false
		cmbYear.visible = false
		cmbQuarter.visible = false
		Image0.visible = false
		Image1.visible = false
		Image2.visible = false
		contMain.lblNoData.visible = false
		
		g_bMore = true
		f_SetMore()
		
		edtPwd.caption = ""
		
		cmbSort.currentindex = "0"
		cmbQuarter.currentindex = "0"
		
		Dim szDate, szYear
		szDate = Form.GetSharedData("&HOST_DATE", false)
		szYear = Left(szDate, 4)
		cmbYear.cbkeydata = CLng(szYear) - 1
		
		Dim szNowYear
		szNowYear = cmbYear.cbkeydata
		g_szFromDt = szNowYear & "0101"
		g_szToDt = szNowYear & "1231"
	End If
	
	contMain.tblData.SetCellString(1, 1, "")
	contMain.tblData.SetCellString(2, 1, "")
	contMain.tblData.SetCellString(3, 1, "")
	contMain.tblData.SetCellString(0, 1, "")
	contMain.tblData.SetCellString(5, 1, "")
	
	contMain.tblData.SetCellString(5, 0, "과세표준금액")
	
	contMain.grdList.SetClear()
End Function

'============================================================================
Function f_SetMore()
	'상단 아코디언 영역 처리
	If g_bMore Then
		g_bMore = false
		
		contMain.lblMore.caption = "상세"
		contMain.imgMore.imgpath = "icon_gray_down"
		
		contMain.Label1.top = 120
		contMain.grdList.top = 155
		contMain.Label3.top = 505
		
		contMain.lblNoData.top = 250
		
		contMain.lblMore.top = 75
		contMain.imgMore.top = 75
		
		contMain.imgBg.height = 108
		
		contMain.tblData.visible = false
	Else
		g_bMore = true
		
		contMain.lblMore.caption = "접기"
		contMain.imgMore.imgpath = "icon_gray_up"
		
		contMain.Label1.top = 275
		contMain.grdList.top = 310
		contMain.Label3.top = 660
		
		contMain.lblNoData.top = 365
		
		contMain.lblMore.top = 225
		contMain.imgMore.top = 225
		
		contMain.imgBg.height = 258
		
		contMain.tblData.visible = true
	End If
	
	contMain.SetScrollAutoSize()
End Function

'============================================================================
Sub btnPwd_OnClick()
	If edtPwd.caption == "" Or edtPwd.caption == null Then
		Form.openPopupAnimation( "pwdcheckpopup", acnt.caption & "☆2", "", "2" )
	End If
End Sub

'============================================================================
Sub cmbSort_OnEditComplete(iIndex)
	If edtPwd.caption <> "" And edtPwd.caption <> null Then
		f_SetClear("")
		
		'해외주식 양도소득 과표 조회(합계)
		DATAMANAGER.RequestTranData( "obtro_stlm_438r" )
	End If
End Sub

'============================================================================
Sub cmbYear_OnEditComplete(iIndex)
	If edtPwd.caption <> "" And edtPwd.caption <> null Then
		f_SetClear("")
		
		'변경된 년도로 날짜 변수 세팅하고 서비스 호출
		Dim szNowYear
		szNowYear = cmbYear.cbkeydata
		
		If CInt(cmbQuarter.currentindex) == 0 Then
			g_szFromDt = szNowYear & "0101"
			g_szToDt = szNowYear & "1231"
		ElseIf CInt(cmbQuarter.currentindex) == 1 Then
			g_szFromDt = szNowYear & "0101"
			g_szToDt = szNowYear & "0331"
		ElseIf CInt(cmbQuarter.currentindex) == 2 Then
			g_szFromDt = szNowYear & "0401"
			g_szToDt = szNowYear & "0630"
		ElseIf CInt(cmbQuarter.currentindex) == 3 Then
			g_szFromDt = szNowYear & "0701"
			g_szToDt = szNowYear & "0930"
		ElseIf CInt(cmbQuarter.currentindex) == 4 Then
			g_szFromDt = szNowYear & "1001"
			g_szToDt = szNowYear & "1231"
		End If
		
		'해외주식 양도소득 과표 조회(합계)
		DATAMANAGER.RequestTranData( "obtro_stlm_438r" )
	End If
End Sub

'============================================================================
Sub cmbQuarter_OnEditComplete(iIndex)
	If edtPwd.caption <> "" And edtPwd.caption <> null Then
		f_SetClear("")
		
		Dim szNowYear
		szNowYear = cmbYear.cbkeydata
		
		'분기별로 조회날짜 세팅
		If CInt(iIndex) == 0 Then
			g_szFromDt = szNowYear & "0101"
			g_szToDt = szNowYear & "1231"
		ElseIf CInt(iIndex) == 1 Then
			g_szFromDt = szNowYear & "0101"
			g_szToDt = szNowYear & "0331"
		ElseIf CInt(iIndex) == 2 Then
			g_szFromDt = szNowYear & "0401"
			g_szToDt = szNowYear & "0630"
		ElseIf CInt(iIndex) == 3 Then
			g_szFromDt = szNowYear & "0701"
			g_szToDt = szNowYear & "0930"
		ElseIf CInt(iIndex) == 4 Then
			g_szFromDt = szNowYear & "1001"
			g_szToDt = szNowYear & "1231"
		End If
		
		'해외주식 양도소득 과표 조회(합계)
		DATAMANAGER.RequestTranData( "obtro_stlm_438r" )
	End If
End Sub

'============================================================================
Sub contMain_grdList_OnClickUp(lRow, szCellID)
	If lRow <> -1 Then
		Dim szSendData
		Dim szItemCode
		szItemCode = contMain.grdList.GetCellData("bd_iscd", lRow)
		szSendData = acnt.total & "★" & acnt.sequence & "★" & g_szFromDt & "★" & g_szToDt & "★" & cmbSort.cbkeydata & "★" & szItemCode & "★" & acnt.itemcodetype
		
		Form.OpenFramePopup("mbtro16100_p1" , szSendData, "")
	End If
End Sub

'============================================================================
Sub acnt_ChangeAccount()
	f_SetClear("All")
End Sub

'============================================================================
Sub contMain_grdList_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData( "obtro_stlm_439r" ) Then
		DATAMANAGER.RequestNextData( "obtro_stlm_439r" )
	End If
End Sub

'============================================================================
Sub contMain_imgToolTip_OnClick()
	Dim szText
	szText = "예상 양도소득세:\n과세표준금액(양도소득합계 - 기본공제금액) * 22%"
	
	Dim szOSType
	szOSType = Form.GetSharedData("&OS_TYPE", false)
	
	If szOSType == "1" Then
		contMain.imgToolTip.openToolTip(szText, 335, 70, 2)
	Else
		contMain.imgToolTip.openToolTip(szText, 340, 70, 2)
	End If
End Sub

'============================================================================
Sub contMain_lblMore_OnClick()
	f_SetMore()
End Sub

'============================================================================
Sub contMain_imgMore_OnClick()
	f_SetMore()
End Sub

