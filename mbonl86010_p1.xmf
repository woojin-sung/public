	<SCRIPT_INFO _len="2020" _ulen="1778" >
'============================================================================
' 01. 화 면 명 : 중요거래단말지정서비스_안내사항팝업
' 02. 화면설명 : 중요거래단말지정서비스_안내사항팝업
' 03. 작    성 : 2016.01.19 ~ 최지희
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' imgClose_OnClick
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Container0.tblEnroll.visible = false
	Container0.tblCancel.visible = false

	Dim szSort						'이용단말등록, 지정단말조회 중 어느 화면에서 넘어왔는지 여부
	szSort = Form.GetOpenLinkData()
	
	if szSort == "이용단말등록안내" then		'영업지원팀 박미정 대리님이 한페이지에 보일수 있게 수정 요청 -> 줄 띄어쓰기 수정
		Container0.tblEnroll.visible = true
		Container0.tblCancel.visible = false

	elseif szSort == "지정단말조회해지" then
		Container0.tblEnroll.visible = false
		Container0.tblCancel.visible = true
	end if
End Sub

	</SCRIPT_INFO>
</ROOT>