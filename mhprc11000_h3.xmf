Sub Form_OnFormInitBefore()
	g_szItemCode   = Form.GetSharedData( "&ITEM_STOCK", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	'20180712 HAMWG START : K-OTC MTS 도입
	If g_szItemMarket = "T" Then
		grd0.visible = False
		grd1.visible = True
	Else
		grd0.visible = True
		grd1.visible = False
	End If
	'20180712 HAMWG END	

End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		'20180712 HAMWG START : K-OTC MTS 도입
		If g_szItemMarket = "T" Then
			grd0.visible = False
			grd1.visible = True
			
			DATAMANAGER.RequestTranData( "ohhts_1202_003r" )
		Else
			grd0.visible = True
			grd1.visible = False
			
			DATAMANAGER.RequestTranData( "ohhts_1002_003r" )
		End If
		'20180712 HAMWG END	
		
	end	if	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "INIT_CODE" then
		g_szItemCode   =  sParam
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")
		
		'20180712 HAMWG START : K-OTC MTS 도입
		If g_szItemMarket = "T" Then
			grd0.visible = False
			grd1.visible = True
			
			DATAMANAGER.RequestTranData( "ohhts_1202_003r" )
		Else
			grd0.visible = True
			grd1.visible = False
			
			DATAMANAGER.RequestTranData( "ohhts_1002_003r" )
		End If
		'20180712 HAMWG END	
		
	 end if
	 
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
    if szTranID = "ohhts_1002_003r" then
	    DATAMANAGER.CancelRealData("ohhts_elw_cntg")
	    DATAMANAGER.CancelRealData("ohhts_stck_cntg")
	    DATAMANAGER.CancelRealData("ohhts_frbr_cntg")	'20180712 HAMWG START : K-OTC MTS 도입
	    
	    DATAMANAGER.SetDataValue( 0, "ohhts_1002_003r", "InBlock1", "FID_INPUT_ISCD"				, 0, g_szItemCode )
	    DATAMANAGER.SetDataValue( 0, "ohhts_1002_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szItemMarket )
	    '20170823 HAMWG : 수정주가 미사용 설정 (사용:0 미사용:1)
	    DATAMANAGER.SetDataValue( 0, "ohhts_1002_003r", "InBlock1", "FID_INPUT_MOD_STPR_CLS_CODE"	, 0, 1 )
	 
	'20180712 HAMWG START : K-OTC MTS 도입
	elseif szTranID = "ohhts_1202_003r" then
	    DATAMANAGER.CancelRealData("ohhts_elw_cntg")
	    DATAMANAGER.CancelRealData("ohhts_stck_cntg")
	    DATAMANAGER.CancelRealData("ohhts_frbr_cntg")	'20180712 HAMWG START : K-OTC MTS 도입
	    
	    DATAMANAGER.SetDataValue( 0, "ohhts_1202_003r", "InBlock2", "FID_INPUT_ISCD"				, 0, g_szItemCode )
	    DATAMANAGER.SetDataValue( 0, "ohhts_1202_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szItemMarket )
	'20180712 HAMWG END
	    
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
    DATAMANAGER.SetDataValue( 1, "ohhts_stck_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szItemCode )
    DATAMANAGER.SetDataValue( 1, "ohhts_elw_cntg" , "InBlock1", "FIDR_SHRN_ISCD", 0, g_szItemCode )
    DATAMANAGER.SetDataValue( 1, "ohhts_frbr_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szItemCode )	'20180712 HAMWG : K-OTC MTS 도입
End Sub




'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
    if szTranID = "ohhts_1002_003r" then
	    For i = 0 To grd0.rowcount - 1
		    Dim nData, szColor, nAmt
		    nData = CDbl( grd0.GetCellData( "bd_cell2", i ) )		    
		    
		    If nData > 0 Then
			    szColor = "10"
		    ElseIf nData < 0 Then
			    szColor = "11"
		    Else
			    szColor = "12"
		    End If		    
		    
			grd0.SetCellFgColor("bd_cell1", i, szColor)
			
			nAmt  = CDbl( grd0.GetCellData( "bd_cell9", i ) ) / 1000000
			grd0.SetCellData("bd_cell7", i, nAmt)
		Next
    
		if g_szItemMarket = "W" then
		    DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
		else
		    DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
		end if
	'20180712 HAMWG START : K-OTC MTS 도입
	elseif szTranID = "ohhts_1202_003r" then
	    For i = 0 To grd1.rowcount - 1
		    Dim nData, szColor, nAmt
		    nData = CDbl( grd1.GetCellData( "bd_cell2", i ) )		    
		    
		    If nData > 0 Then
			    szColor = "10"
		    ElseIf nData < 0 Then
			    szColor = "11"
		    Else
			    szColor = "12"
		    End If		    
		    
			grd1.SetCellFgColor("bd_cell1", i, szColor)
			
			nAmt  = CDbl( grd1.GetCellData( "bd_cell9", i ) ) / 1000000
			grd1.SetCellData("bd_cell7", i, nAmt)
		Next
    
		if g_szItemMarket = "T" then
		    DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
		end if
	'20180712 HAMWG END
    end if
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	Dim nAmt
	
	'20180712 HAMWG START : K-OTC MTS 도입
	if g_szItemMarket = "T" then
	    	nAmt  = CDbl( grd1.GetCellData( "bd_cell9", 0 ) ) / 1000000
		grd1.SetCellData("bd_cell7", 0, nAmt)
	else
		nAmt  = CDbl( grd0.GetCellData( "bd_cell9", 0 ) ) / 1000000
		grd0.SetCellData("bd_cell7", 0, nAmt)
	end if	
	'20180712 HAMWG END
	
End Sub

