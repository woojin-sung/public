'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	Dim szLinkData
	szLinkData = ""
	szLinkData = Form.GetOpenLinkData()
'
'	if szLinkData == "" then
'		Form.CloseForm()
'		Exit Sub
'	end if 
	
	Init_Control()
	
	arrLinkData = split(szLinkData, "★")
	
	if #arrLinkData < 1 then
		Form.CloseForm()
		Exit Sub
	else
		if #arrLinkData > 2 then
	
			arrLinkData_1 = split(arrLinkData(0), "`")
			arrLinkData_2 = split(arrLinkData(1), "`")
			arrLinkData_3 = split(arrLinkData(2), "`")
			
			'1:외화매수 / 2:외화매도
			g_szOrderType = arrLinkData_1(0) 
			
			szFlag = Form.getIconImg("CRCD", arrLinkData_2(0))
			if szFlag = "" then
				szFlag = "flag_general"
			end if
			
			contBg.imgFlagTarget.imgpath = szFlag
			contBg.lblTargetRateData.caption = arrLinkData_2(1)
			
			nTxtWidth = Form.getTextWidth(arrLinkData_2(1), -2, true, false)
			nleft = (375 - nTxtWidth) / 2 - 20
			contBg.imgFlagTarget.left = nleft
			
			if g_szOrderType == "1" then
				
				contBg.lblCrcd00.caption = "KRW"
				contBg.lblSellAmt.caption = "환전 체결 후 확정"
				
				szFlag1 = Form.getIconImg("CRCD", "KRW")
				if szFlag1 = "" then
					szFlag1 = "flag_general"
				end if
				
				contBg.imgFlag00.imgpath = szFlag1
				
				
				contBg.lblCrcd01.caption = arrLinkData_2(0)
				contBg.lblBuyAmt.caption = arrLinkData_2(2)
				
				szFlag2 = Form.getIconImg("CRCD", arrLinkData_2(0))
				if szFlag2 = "" then
					szFlag2 = "flag_general"
				end if
				
				contBg.imgFlag01.imgpath = szFlag2
			
			elseif g_szOrderType == "2" then
				contBg.lblCrcd00.caption = arrLinkData_2(0)
				contBg.lblSellAmt.caption = arrLinkData_2(2)
				
				szFlag1 = Form.getIconImg("CRCD", arrLinkData_2(0))
				if szFlag1 = "" then
					szFlag1 = "flag_general"
				end if
				
				contBg.imgFlag00.imgpath = szFlag1
				
				
				contBg.lblCrcd01.caption = "KRW"
				contBg.lblBuyAmt.caption = "환전 체결 후 확정"
				
				szFlag2 = Form.getIconImg("CRCD", "KRW")
				if szFlag2 = "" then
					szFlag2 = "flag_general"
				end if
				
				contBg.imgFlag01.imgpath = szFlag2
			end if
			
			contBg.lblExchange00.caption = arrLinkData_3(1)
		end if
		
	end if 

End Sub

'===============================================
' imgBg_OnClick
'===============================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'===============================================
' contBg_btnCancel_OnClick
'===============================================
Sub contBg_btnCancel_OnClick()
	Form.CloseForm()
End Sub

'===============================================
' contBg_btnOk_OnClick
'===============================================
Sub contBg_btnOk_OnClick()
	Form.SendReturnToParent("EXCHANGE_STEP0" , "OK")
	Form.CloseForm()
End Sub

