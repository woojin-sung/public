'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	contBg.setEnableScroll(false)

	'-------------------------------
	' 팝업 타이틀
	'-------------------------------
	contBg.lblTitle.paddinginfo = "0,0,0,0"
	contBg.lblTitle.fgcolor = g_szTxtColor_Normal
	
	'-------------------------------
	' 목표환율 영역
	'-------------------------------
	contBg.lblTargetRateTitle.paddinginfo = "0,0,0,0"
	contBg.lblTargetRateTitle.fgcolor = g_szTxtColor_Grey
	
	contBg.lblTargetRateData.paddinginfo = "0,0,0,0"
	contBg.lblTargetRateData.maxlinecnt = "1"
	contBg.lblTargetRateData.fgcolor = g_szTxtColor_Normal
	
	contBg.imgFlagTarget.maintainratio = "3"
	
	'contBg.lblBg.bgcolor = g_szContBgColor
	contBg.lblBg.imagefilepth = "roundbox_4r_gray.9"
	'-------------------------------
	' 예상환전 영역
	'-------------------------------
	contBg.lblPredictedAmtTitle.paddinginfo = "0,0,0,0"
	contBg.lblPredictedAmtTitle.maxlinecnt = "1"
	contBg.lblPredictedAmtTitle.fgcolor = g_szTxtColor_Grey

	contBg.lblCrcd00.paddinginfo = "0,0,0,0"
	contBg.lblCrcd00.maxlinecnt = "1"
	contBg.lblCrcd00.fgcolor = g_szTxtColor_Normal
	
	contBg.imgFlag00.maintainratio = "3"
	
	contBg.lblCrcd01.paddinginfo = "0,0,0,0"
	contBg.lblCrcd01.maxlinecnt = "1"
	contBg.lblCrcd01.fgcolor = g_szTxtColor_Normal
	
	contBg.imgFlag01.maintainratio = "3"
	
	contBg.lblArrow.paddinginfo = "0,0,0,0"
	contBg.lblArrow.maxlinecnt = "1"
	contBg.lblArrow.fgcolor = g_szTxtColor_Normal
	contBg.lblArrow.caption = "→"
	
	contBg.lblSellAmt.paddinginfo = "0,0,0,0"
	contBg.lblSellAmt.maxlinecnt = "1"
	contBg.lblSellAmt.fgcolor = g_szTxtColor_Normal
	
	contBg.lblBuyAmt.paddinginfo = "0,0,0,0"
	contBg.lblBuyAmt.maxlinecnt = "1"
	contBg.lblBuyAmt.fgcolor = g_szTxtColor_Normal
	
	
	contBg.lblExchangeInfo00.paddinginfo = "0,0,0,0"
	contBg.lblExchangeInfo00.maxlinecnt = "1"
	contBg.lblExchangeInfo00.fgcolor = g_szTxtColor_Grey
	
	contBg.lblExchange00.paddinginfo = "0,0,0,0"
	contBg.lblExchange00.maxlinecnt = "1"
	contBg.lblExchange00.fgcolor = g_szTxtColor_Normal
	
	contBg.lblGuidLine.bgcolor = g_szLineColor

	contBg.lblInfo1.paddinginfo = "0,0,0,0"
	contBg.lblInfo1.maxlinecnt = "2"
	contBg.lblInfo1.fgcolor = g_szTxtColor_Normal
	contBg.lblInfo1.caption = "목표환율환전신청 후 체결완료 시 취소 불가합니다.\n환전 신청을 하시겠습니까?"

	contBg.btnCancel.fgcolor = g_szTxtColor_Normal
	contBg.btnOk.fgcolor = g_szTxtColor_White
End Function

