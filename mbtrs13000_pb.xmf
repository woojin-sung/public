'============================================================================
Sub grdList_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obtrc_rmnd_001r" )
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REUPDATE" then
		if sRet == "ok" then
			Form.reUpdateFile("mts_master.crc")
		else
			exit sub
		end if
	end if
End Sub

'============================================================================
Sub grdList_OnHeaderClickUp(lRow, szCellID)
	if g_Buffer = 1 then
		if szCellID = "th_cell0" or szCellID = "th_cell1" then
			g_Toggle1 = g_Toggle1 + 1
'			g_Toggle2 = 0
			
			if g_Toggle1 > 2 then
				g_Toggle1 = 0
			end if
	
			SetGridHeader(g_Toggle1, 0)
			
		end if
	end if
	
	if szCellID = "th_cell6" or szCellID = "th_cell7" then
'		g_Toggle1 = 0
		g_Toggle2 = g_Toggle2 + 1
	
		if g_Toggle2 > 2 then
			g_Toggle2 = 0
		end if
	
		SetGridHeader(0, g_Toggle2)
	end if
	
End Sub
'============================================================================
Sub SetGridHeader(g_Toggle1, g_Toggle2)
	if g_Toggle1 = 0 then
		grdList.SetCellTopCaption("th_cell0", "종목명")
	elseif g_Toggle1 = 1 then
'		grdList.SetCellTopCaption("th_cell0", "종목명▼")	'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
		grdList.SetCellTopCaption("th_cell0", "종목명")
	else
'		grdList.SetCellTopCaption("th_cell0", "종목명▲")	'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
		grdList.SetCellTopCaption("th_cell0", "종목명")
	end if
	
	if g_Toggle2 = 0 then
		grdList.SetCellTopCaption("th_cell6", "평가손익")
	elseif g_Toggle2 = 1 then
'		grdList.SetCellTopCaption("th_cell6", "평가손익▼")	'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
		grdList.SetCellTopCaption("th_cell6", "평가손익")
	else
'		grdList.SetCellTopCaption("th_cell6", "평가손익▲")	'20230627 HSZ: 앱 메인수정 대응 - 소팅이미지 자동세팅
		grdList.SetCellTopCaption("th_cell6", "평가손익")
	end if
	
End Sub

