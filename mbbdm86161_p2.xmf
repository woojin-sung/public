'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
'Form_OnFormInit()  
'============================================================================
Sub Form_OnFormInit()
	'btnNext.enable = false
	
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData ~= null and szOpenData ~= "" Then
		edtName.caption = szOpenData
	End If		
End Sub

'============================================================================
'Form_OnFormBackKeyPressed() : 닫기 
'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
	Form.CloseForm()
End Sub

'============================================================================
' imgBg_OnClick() : 닫기
'============================================================================
'Sub imgBg_OnClick()
'	Form.CloseForm()
'End Sub

'============================================================================
' btnNext_OnClick() : 목표시장 일치 
'============================================================================
Sub btnNext_OnClick()
	if edtName.caption == "" or edtName.caption == null then
		Form.ShowAlert("안내", "직업명을 입력해주세요.")
		exit sub
	end if

	Form.SendReturnToParent("mbbdm86161_p2" , edtName.caption)
	Form.CloseForm()	
End Sub

'============================================================================
' Form_OnFormClose()
'============================================================================
'Sub Form_OnFormClose()
'	
'End Sub


'============================================================================
Sub edtName_OnEditComplete()
	btnNext.enable = false
	
	if Str_Chk(edtName.Caption) == False then
		exit Sub
	end if
	
	btnNext.enable = true
End Sub

