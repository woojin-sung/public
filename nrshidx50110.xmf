'===============================================
' DATAMANAGER_OnSendTranBefore
'===============================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "ohhts_metf_031r" then
		DATAMANAGER.SetDataValue(0, "ohhts_metf_031r", "InBlock1", "FID_ETF_CTGR_NO", 0 , "5")
	elseif szTranID = "ohhts_metf_003r" then
		
		
		
	end if
End Sub

'===============================================
' DATAMANAGER_OnReceiveTranComplete
'===============================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_metf_031r" then
		
		nDataCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_031r", "OutBlock1")
		
		for i = 0 to nDataCnt-1
			szCd_Step0 = DATAMANAGER.GetDataValue(0, "ohhts_metf_031r", "OutBlock1", "FID_ETF_UNAS_SRNO" 		, i)
			szNm_Step0 = DATAMANAGER.GetDataValue(0, "ohhts_metf_031r", "OutBlock1", "FID_ETF_UNAS_NAME" 		, i)
			
			szCd_Step1 = DATAMANAGER.GetDataValue(0, "ohhts_metf_031r", "OutBlock1", "FID_ETF_LRDV_SRNO"		, i)
			szNm_Step1 = DATAMANAGER.GetDataValue(0, "ohhts_metf_031r", "OutBlock1", "FID_ETF_LRDV_NAME"		, i)
			
			szCd_Step2 = DATAMANAGER.GetDataValue(0, "ohhts_metf_031r", "OutBlock1", "FID_ETF_MDDV_SRNO"		, i)
			szNm_Step2 = DATAMANAGER.GetDataValue(0, "ohhts_metf_031r", "OutBlock1", "FID_ETF_MDDV_NAME" 		, i)
			
			szCd_Step3 = DATAMANAGER.GetDataValue(0, "ohhts_metf_031r", "OutBlock1", "FID_ETF_SMDV_SRNO"		, i)
			szNm_Step3 = DATAMANAGER.GetDataValue(0, "ohhts_metf_031r", "OutBlock1", "FID_ETF_SMDV_NAME"		, i)
			
			szStep0 = szNm_Step0
			szStep1 = szNm_Step1
			szStep2 = szNm_Step2
			szStep3 = szNm_Step3
			
			
			if Contains_Array(g_arrStep0, szStep0) = false then
				if szCd_Step0 <> "0000" then
					Table.insert(g_arrStep0, szStep0)
				end if
				
				if g_arrStep0_Idx <> -1 then
					Form.SetSharedData("ETF_Step1_"&g_arrStep0_Idx , Convert_ArrToString(g_arrStep1, "`"))
					Form.SetSharedData("ETF_Step2_"&g_arrStep0_Idx&"_"&g_arrStep1_Idx , Convert_ArrToString(g_arrStep2, "`"))
					Form.SetSharedData("ETF_Step3_"&g_arrStep0_Idx&"_"&g_arrStep1_Idx&"_"&g_arrStep2_Idx , Convert_ArrToString(g_arrStep3, "`"))
				end if
				
				g_arrStep1 = {}
				g_arrStep2 = {}
				g_arrStep3 = {}
				
				g_arrStep0_Idx = g_arrStep0_Idx + 1
				g_arrStep1_Idx = -1
				g_arrStep2_Idx = -1
			end if	
		
			if Contains_Array(g_arrStep1, szStep1) = false then
				if szCd_Step1 <> "0000" then
					Table.insert(g_arrStep1, szStep1)
				end if
				
				if g_arrStep1_Idx <> -1 then
					Form.SetSharedData("ETF_Step2_"&g_arrStep0_Idx&"_"&g_arrStep1_Idx , Convert_ArrToString(g_arrStep2, "`"))
					Form.SetSharedData("ETF_Step3_"&g_arrStep0_Idx&"_"&g_arrStep1_Idx&"_"&g_arrStep2_Idx , Convert_ArrToString(g_arrStep3, "`"))
				end if
				
				g_arrStep2 = {}
				g_arrStep3 = {}
				
				g_arrStep1_Idx = g_arrStep1_Idx +  1
				g_arrStep2_Idx = -1
			end if
			
			if Contains_Array(g_arrStep2, szStep2) = false then
				if szCd_Step2 <> "0000" then
					Table.insert(g_arrStep2, szStep2)
				end if
				
				if g_arrStep2_Idx <> -1 then
					Form.SetSharedData("ETF_Step3_"&g_arrStep0_Idx&"_"&g_arrStep1_Idx&"_"&g_arrStep2_Idx , Convert_ArrToString(g_arrStep3, "`"))
				end if
				
				g_arrStep3 = {}
				
				g_arrStep2_Idx = g_arrStep2_Idx +  1
			end if
			
			
			if Contains_Array(g_arrStep3, szStep3) = false then
				if szCd_Step3 <> "0000" then
					Table.insert(g_arrStep3, szStep3)
				end if
			end if	
		next
			
		if DATAMANAGER.IsMoreNextData("ohhts_metf_031r") then
			DATAMANAGER.RequestNextData("ohhts_metf_031r")
		else
			Form.SetSharedData("ETF_Step0" , Convert_ArrToString(g_arrStep0, "`"))
			g_arrStep0 = {}
			
			Form.SetSharedData("ETF_Step1_"&g_arrStep0_Idx , Convert_ArrToString(g_arrStep1, "`"))
			g_arrStep1 = {}
			
			Form.SetSharedData("ETF_Step2_"&g_arrStep0_Idx&"_"&g_arrStep1_Idx , Convert_ArrToString(g_arrStep2, "`"))
			g_arrStep2 = {}
			
			Form.SetSharedData("ETF_Step3_"&g_arrStep0_Idx&"_"&g_arrStep1_Idx&"_"&g_arrStep2_Idx , Convert_ArrToString(g_arrStep3, "`"))
			g_arrStep3 = {}
			
			g_arrStep0_Idx = -1
			g_arrStep1_Idx = -1
			g_arrStep2_Idx = -1
			g_arrStep3_Idx = -1
		end if
		
	elseif szTranID = "ohhts_metf_003r" then
		szCntData = DATAMANAGER.GetDataValue(0, "ohhts_metf_003r", "OutBlock1", "FID_ISSU_CNT", 0)
		g_nSearchCnt = Clng(szCntData)
		
		btnSearch.caption = "종목 확인 하기 ("& FormatNumber(g_nSearchCnt,0)&"건)"
		
		if g_isPrev = true then
			btnSearch_OnClick()
			g_isPrev = false
		end if
	end if
End Sub

'===============================================
' DATAMANAGER_OnReceiveTranError
'===============================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID = "obsim_stsv_100r" then
		Form.ShowAlert("안내", szErrMsg)
	elseif szTranID = "ohhts_metf_003r" then
		szCntData = DATAMANAGER.GetDataValue(0, "ohhts_metf_003r", "OutBlock1", "FID_ISSU_CNT", 0)
		g_nSearchCnt = Clng(szCntData)
		
		btnSearch.caption = "종목 확인 하기 ("&FormatNumber(g_nSearchCnt,0)&"건)"
	end if
End Sub

'===============================================
' Form_OnTriggerEvent
'===============================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "50110_S1_CHECK" then
		szData = Form.GetSharedData(sEventName, false )
		Check_Category(szData, 0)
		
		for i = 0 to #g_arrCategory_Order-1
			if g_arrCategory_Order(i) = sEventName then
				Table.remove(g_arrCategory_Order, i+1)
			end if 
		next
		
		Table.insert(g_arrCategory_Order, sEventName)
		Form.SetSharedData("50110_CATEGORY" , Convert_ArrToString(g_arrCategory_Order, "`"))
		
		g_arrS1 = Convert_StringToArr(szData, "`")
		g_arrS1_Idx = #g_arrS1

		if g_arrS2_Idx > 1 then
			if g_arrS2(0) = "주식" and g_arrS2(1) = "Step0대표지수" then
				if g_arrS2_Idx > 3  then
					Table.remove(g_arrS2,3)
					Table.remove(g_arrS2,3)
				elseif  g_arrS2_Idx > 2  then
					Table.remove(g_arrS2,3)
				end if
					
				if szData <> "" then
					Table.insert(g_arrS2, 3, "Step1"&szData)
				end if		
			end if		
			
			g_arrS2_Idx = #g_arrS2
			Form.SetSharedData("50110_S2_CHECK" , Convert_ArrToString(g_arrS2, "★"))
		end if
		
'		Form.SetTimerEvent3(1,0,0)
		DisplaySetting_Cond()
	
	elseif sEventName = "50110_S2_CHECK" then
		szData = Form.GetSharedData(sEventName, false )

		Check_Category(szData, 1)
		
		for i = 0 to #g_arrCategory_Order-1
			if g_arrCategory_Order(i) = sEventName then
				Table.remove(g_arrCategory_Order, i+1)
			end if 
		next
		
		Table.insert(g_arrCategory_Order, sEventName)
		Form.SetSharedData("50110_CATEGORY" , Convert_ArrToString(g_arrCategory_Order, "`"))
		
		g_arrS2 = {}
		g_arrS2_Idx = 0
		
		g_arrS2 = Convert_StringToArr(szData, "★")
		g_arrS2_Idx = #g_arrS2
'		Form.SetTimerEvent3(1,0,0)
		DisplaySetting_Cond()
		
	elseif sEventName = "50110_S3_CHECK" then
		szData = Form.GetSharedData(sEventName, false )
		Check_Category(szData, 2)
		
		for i = 0 to #g_arrCategory_Order-1
			if g_arrCategory_Order(i) = sEventName then
				Table.remove(g_arrCategory_Order, i+1)
			end if 
		next
		
		Table.insert(g_arrCategory_Order, sEventName)
		Form.SetSharedData("50110_CATEGORY" , Convert_ArrToString(g_arrCategory_Order, "`"))
		
		g_arrS3 = Convert_StringToArr(szData, "`")
		g_arrS3_Idx = #g_arrS3
		
		szMrgData = ""
		szData = Form.GetSharedData("50110_S4_CHECK_DOMESTIC", false )
		szMrgData = szMrgData & szData
	
		g_arrS4_0 = Convert_StringToArr(szData, "`")
		g_arrS4_0_Idx = #g_arrS4_0
		
		szData = Form.GetSharedData("50110_S4_CHECK_OVERSEA", false )
		szMrgData = szMrgData & szData
		
		g_arrS4_1 = Convert_StringToArr(szData, "`")
		g_arrS4_1_Idx = #g_arrS4_1
		
		Check_Category(szMrgData, 3)
		Reload_Category()
'		Form.SetTimerEvent3(1,0,0)
		DisplaySetting_Cond()
		
	elseif sEventName = "50110_S4_CHECK" then
		szMrgData = ""
		szData = Form.GetSharedData(sEventName&"_DOMESTIC", false )
		szMrgData = szMrgData & szData
	
		g_arrS4_0 = Convert_StringToArr(szData, "`")
		g_arrS4_0_Idx = #g_arrS4_0
		
		szData = Form.GetSharedData(sEventName&"_OVERSEA", false )
		szMrgData = szMrgData & szData
		
		g_arrS4_1 = Convert_StringToArr(szData, "`")
		g_arrS4_1_Idx = #g_arrS4_1
		Check_Category(szMrgData, 3)
		
		for i = 0 to #g_arrCategory_Order-1
			if g_arrCategory_Order(i) = sEventName then
				Table.remove(g_arrCategory_Order, i+1)
			end if 
		next
		Table.insert(g_arrCategory_Order, sEventName)
		Form.SetSharedData("50110_CATEGORY" , Convert_ArrToString(g_arrCategory_Order, "`"))
'		Form.SetTimerEvent3(1,0,0)
		DisplaySetting_Cond()
		
	elseif sEventName = "50110_S5_CHECK" then
		szData = Form.GetSharedData(sEventName, false )
		Check_Category(szData, 4)
		
		g_arrS5 = Convert_StringToArr(szData, "`")
		g_arrS5_Idx = #g_arrS5
		
		for i = 0 to #g_arrCategory_Order-1
			if g_arrCategory_Order(i) = sEventName then
				Table.remove(g_arrCategory_Order, i+1)
			end if 
		next
		
		Table.insert(g_arrCategory_Order, sEventName)
		Form.SetSharedData("50110_CATEGORY" , Convert_ArrToString(g_arrCategory_Order, "`"))
'		Form.SetTimerEvent3(1,0,0)
		DisplaySetting_Cond()
		
	elseif sEventName = "50110_S6_CHECK" then
		szData = Form.GetSharedData(sEventName, false )
		Check_Category(szData, 5)
		
		g_arrS6 = Convert_StringToArr(szData, "`")
		g_arrS6_Idx = #g_arrS6
		
		for i = 0 to #g_arrCategory_Order-1
			if g_arrCategory_Order(i) = sEventName then
				Table.remove(g_arrCategory_Order, i+1)
			end if 
		next

		Table.insert(g_arrCategory_Order, sEventName)
		Form.SetSharedData("50110_CATEGORY" , Convert_ArrToString(g_arrCategory_Order, "`"))
'		Form.SetTimerEvent3(1,0,0)
		DisplaySetting_Cond()
		
	elseif sEventName = "50110_S7_CHECK" then
		szMrgData = ""
		szData = Form.GetSharedData(sEventName&"_RATE", false )
		szMrgData = szMrgData & szData
		
		szSubResult = ""
		if szData <> "" then
			arrTempData = Convert_StringToArr(szData, "`")
			
			if #arrTempData > 1 then
				szSubResult = arrTempData(0)&" ~ "&arrTempData(1)
			end if
		end if
		
		if szSubResult <> "" then
			g_arrS7_0 = {szSubResult}
		else
			g_arrS7_0 = {}
		end if
		
		g_arrS7_0_Idx = #g_arrS7_0
		
		szData = Form.GetSharedData(sEventName&"_PERIOD", false )
		szMrgData = szMrgData & szData
	
		g_arrS7_1 = Convert_StringToArr(szData, "`")
		g_arrS7_1_Idx = #g_arrS7_1
		
		for i = 0 to #g_arrCategory_Order-1
			if g_arrCategory_Order(i) = sEventName then
				Table.remove(g_arrCategory_Order, i+1)
			end if 
		next
		
		Table.insert(g_arrCategory_Order, sEventName)
		Form.SetSharedData("50110_CATEGORY" , Convert_ArrToString(g_arrCategory_Order, "`"))
		
		Check_Category(szMrgData, 6)
'		Form.SetTimerEvent3(1,0,0)
		DisplaySetting_Cond()
		
	elseif sEventName = "50110_S8_CHECK" then
		szMrgData = ""
		szData = Form.GetSharedData(sEventName&"_RATE", false )
		szMrgData = szMrgData & szData
	
		
		szSubResult = ""
		if szData <> "" then
			arrTempData = Convert_StringToArr(szData, "`")
			
			if #arrTempData > 1 then
				szSubResult = arrTempData(0)&" ~ "&arrTempData(1)
			end if
		end if
		
		if szSubResult <> "" then
			g_arrS8_1 = {szSubResult}
		else
			g_arrS8_1 = {}
		end if
		
		g_arrS8_1_Idx = #g_arrS8_1
		
		szData = Form.GetSharedData(sEventName&"_PERIOD", false )
		szMrgData = szMrgData & szData
		
		g_arrS8_0 = Convert_StringToArr(szData, "`")
		g_arrS8_0_Idx = #g_arrS8_0
		
		for i = 0 to #g_arrCategory_Order-1
			if g_arrCategory_Order(i) = sEventName then
				Table.remove(g_arrCategory_Order, i+1)
			end if 
		next
		
		Table.insert(g_arrCategory_Order, sEventName)
		Form.SetSharedData("50110_CATEGORY" , Convert_ArrToString(g_arrCategory_Order, "`"))
		
		Check_Category(szMrgData, 7)
'		Form.SetTimerEvent3(1,0,0)
		DisplaySetting_Cond()
		
	elseif sEventName = "50110_S9_CHECK" then
		szMrgData = ""
		szData = Form.GetSharedData(sEventName&"_DOMESTIC", false )
		szMrgData = szMrgData & szData
		
		if szData <> "" then
			g_arrS9_0 = {szData}
		else
			g_arrS9_0 = {}
		end if
		g_arrS9_0_Idx = #g_arrS9_0
		
		szData = Form.GetSharedData(sEventName&"_OVERSEA", false )
		szMrgData = szMrgData & szData
		
		if szData <> "" then
			g_arrS9_1 = {szData}
		else
			g_arrS9_1 = {}
		end if
		g_arrS9_1_Idx = #g_arrS9_1
		
		for i = 0 to #g_arrCategory_Order-1
			if g_arrCategory_Order(i) = sEventName then
				Table.remove(g_arrCategory_Order, i+1)
			end if 
		next
		
		Table.insert(g_arrCategory_Order, sEventName)
		Form.SetSharedData("50110_CATEGORY" , Convert_ArrToString(g_arrCategory_Order, "`"))
		
		Check_Category(szMrgData, 8)
'		Form.SetTimerEvent3(1,0,0)
		DisplaySetting_Cond()
		
	elseif sEventName = "50110_S7_KEYPAD" then
		if sParam = "CLOSE" then
			linkfmKeypad.left = 400
		else 
			linkfmKeypad.left = 0
			Form.triggerEvent("linkfmKeypad", "INIT_KEYPAD", sParam)
		end if
	elseif sEventName = "50110_S8_KEYPAD" then
		if sParam = "CLOSE" then
			linkfmKeypad.left = 400
		else 
			linkfmKeypad.left = 0
			Form.triggerEvent("linkfmKeypad", "INIT_KEYPAD", sParam)
		end if
	end if
	
	
	if sEventName = "KEYPAD" then
		Form.triggerEvent("linkfmDetailCond", "KEYPAD", sParam)
	end if
	
	if sEventName = "KEYPAD_END" then
		linkfmKeypad.left = 400
		Form.triggerEvent("linkfmDetailCond", "KEYPAD_END", sParam)
	end if
	

	if sEventName = "50100_INDEX" then
		if sParam = "PREV" then
			g_isPrev = true
			
			Dim szData
			szData = Form.GetSharedData("50110_CATEGORY", false )
			
			g_arrCategory_Order = Convert_StringToArr(szData, "`")
			
			if g_arrCategory_Order = "" then
				g_arrCategory_Order = {}
			end if
		
			szData = Form.GetSharedData("50110_S1_CHECK", false )
			Check_Category(szData, 0)
			
			g_arrS1 = Convert_StringToArr(szData, "`")
			g_arrS1_Idx = #g_arrS1
			
			szData = Form.GetSharedData("50110_S2_CHECK", false )
			Check_Category(szData, 1)
			
			g_arrS2 = Convert_StringToArr(szData, "★")
			g_arrS2_Idx = #g_arrS2
			
			szData = Form.GetSharedData("50110_S3_CHECK", false )
			Check_Category(szData, 2)
			g_arrS3 = Convert_StringToArr(szData, "`")
			g_arrS3_Idx = #g_arrS3
			
			szData0 = Form.GetSharedData("50110_S4_CHECK_DOMESTIC", false )
			g_arrS4_0 = Convert_StringToArr(szData0, "`")
			g_arrS4_0_Idx = #g_arrS4_0
			
			szData1 = Form.GetSharedData("50110_S4_CHECK_OVERSEA", false )
			g_arrS4_1 = Convert_StringToArr(szData1, "`")
			g_arrS4_1_Idx = #g_arrS4_1
			
			szData = szData0&szData1
			Check_Category(szData, 3)
			
			szData = Form.GetSharedData("50110_S5_CHECK", false )
			Check_Category(szData, 4)
			g_arrS5 = Convert_StringToArr(szData, "`")
			g_arrS5_Idx = #g_arrS5
			
			szData = Form.GetSharedData("50110_S6_CHECK", false )
			Check_Category(szData, 5)
			g_arrS6 = Convert_StringToArr(szData, "`")
			g_arrS6_Idx = #g_arrS6
			
			szData0 = Form.GetSharedData("50110_S7_CHECK_RATE", false )
			szSubResult = ""
			if szData0 <> "" then
				arrTempData = Convert_StringToArr(szData0, "`")
				
				if #arrTempData > 1 then
					szSubResult = arrTempData(0)&" ~ "&arrTempData(1)
				end if
			end if
			
			if szSubResult <> "" then
				g_arrS7_0 = {szSubResult}
			else
				g_arrS7_0 = {}
			end if
			
			g_arrS7_0_Idx = #g_arrS7_0
			
			szData1 = Form.GetSharedData("50110_S7_CHECK_PERIOD", false )
			g_arrS7_1 = Convert_StringToArr(szData1, "`")
			g_arrS7_1_Idx = #g_arrS7_1
			
			szData = szData0&szData1
			Check_Category(szData, 6)
			
			szData0 = Form.GetSharedData("50110_S8_CHECK_PERIOD", false )
			g_arrS8_0 = Convert_StringToArr(szData0, "`")
			g_arrS8_0_Idx = #g_arrS8_0
			
			szData1 = Form.GetSharedData("50110_S8_CHECK_RATE", false )
			
			szSubResult = ""
			if szData1 <> "" then
				arrTempData = Convert_StringToArr(szData1, "`")
				
				if #arrTempData > 1 then
					szSubResult = arrTempData(0)&" ~ "&arrTempData(1)
				end if
			end if
			
			if szSubResult <> "" then
				g_arrS8_1 = {szSubResult}
			else
				g_arrS8_1 = {}
			end if
			
			g_arrS8_1_Idx = #g_arrS8_1
			
			szData = szData0&szData1
			Check_Category(szData, 7)
			
			szData0 = Form.GetSharedData("50110_S9_CHECK_DOMESTIC", false )
			if szData0 <> "" then
				g_arrS9_0 = {szData0}
			else
				g_arrS9_0 = {}
			end if
			
			g_arrS9_0_Idx = #g_arrS9_0
			
			szData1 = Form.GetSharedData("50110_S9_CHECK_OVERSEA", false )
			if szData1 <> "" then
				g_arrS9_1 = {szData1}
			else
				g_arrS9_1 = {}
			end if
			g_arrS9_1_Idx = #g_arrS9_1
			
			szData = szData0&szData1
			Check_Category(szData, 8)
			
			
			Reload_Category()
			DisplaySetting_Cond()
			
			nCnt = #g_arrCategory_Order
			if nCnt > 0 then
				szLast = g_arrCategory_Order(nCnt-1)
				
				szIdx = ""
				for i = 1 to 9 
					if instr(szLast, "S"&i) > 0 then
						szIdx = i-1
						exit for
					end if
				next
				
				if szIdx = "" then
					DisplaySetting_Category(-1)
				else
					DisplaySetting_Category(szIdx)
				end if
			else
				DisplaySetting_Category(-1)
			end if

		else
			Clear_Cond()
		end if
	end if
	
	if sEventName = "50100_TAB_CHANGE" then
		Clear_Cond()
	end if
End Sub

