'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	if sCellID = "imgRemove" then
		Remove_Cond(nIndex)
		Reload_Category()
		DisplaySetting_Cond()
	end if
End Sub

'============================================================================
Sub btnClear_OnClick()
	Clear_Cond()
End Sub

'============================================================================
Sub btnSearch_OnClick()
	if g_nSearchCnt > 0 then
		szLnkData = g_szInBlock1 & "★" & g_szInBlock2 & "★" & g_szInBlock3 & "★" & g_szInBlock4 & "★" & g_szInBlock5 & "★" & g_szInBlock6 & "★" & g_szInBlock7 & "★" & g_szInBlock8 & "★" & g_szInBlock9 & "★" & g_szInBlock10 & "★" & g_szInBlock11 & "★" & g_szInBlock12_1 & "★" & g_szInBlock12_2 & "★" & g_szInBlock12_3 & "★" & g_szInBlock12_4 & "★" & g_szInBlock12_5
		szLnkData = szLnkData & "★" & g_nSearchCnt
		if g_isPrev = true then
			szLnkData = szLnkData & "★1" 
		else
			szLnkData = szLnkData & "★0"
		end if
		
		Form.setSharedData("50110_LINK_DATA", szLnkData)
		Form.OpenPopup("nrshidx50110_p2" , szLnkData, "")
	else
		Form.ShowAlert("안내", "검색된 종목이 없습니다. 조건설정을 확인하세요")
	end if
End Sub



