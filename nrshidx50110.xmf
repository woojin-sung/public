Dim g_isRequset
g_isRequset = false
'===============================================
' 상세조건 삭제
'===============================================
Function Remove_Cond(nIdx)
	nStartIdx = 0
	nDataCnt = 0
	arrTemp = g_arrCategory_Order
	
	for k = 0 to #arrTemp-1 
		
		if arrTemp(k) = "50110_S1_CHECK" then
			nStartIdx = nDataCnt
			nDataCnt = nDataCnt + g_arrS1_Idx
			
			if g_arrS1_Idx <> 0 and nIdx < nDataCnt and nIdx >= nStartIdx then
				nPos = nIdx - nStartIdx + 1
				'nArrCnt = g_arrS1_Idx
				
				szRemoveData = g_arrS1(nPos-1)
				
				Table.remove(g_arrS1, nPos)
				g_arrS1_Idx = g_arrS1_Idx - 1
				
				szResultData = Convert_ArrToString(g_arrS1, "`")
				
				Check_Category(Convert_ArrToString(g_arrS1, "`"), 0)
				Form.SetSharedData("50110_S1_CHECK" , Convert_ArrToString(g_arrS1, "`"))
				Form.triggerEvent("linkfmDetailCond", "50110_S1_CHECK", "")
				
				if szResultData <> "" then
					if g_arrS2_Idx > 1 then
						if g_arrS2(0) = "주식" and g_arrS2(1) = "Step0대표지수" then
							if g_arrS2_Idx > 3  then
								Table.remove(g_arrS2,3)
								Table.remove(g_arrS2,3)
							elseif  g_arrS2_Idx > 2  then
								Table.remove(g_arrS2,3)
							end if
								
							Table.insert(g_arrS2, 3, "Step1"&szResultData)
					
							g_arrS2_Idx = #g_arrS2
							Form.SetSharedData("50110_S2_CHECK" , Convert_ArrToString(g_arrS2, "★"))
							
							Form.triggerEvent("linkfmDetailCond", "50110_S2_CHECK", "")
						end if
					end if	
				elseif szResultData = "" then
					if g_arrS2_Idx > 1 then
						if g_arrS2(0) = "주식" and g_arrS2(1) = "Step0대표지수" then
							if g_arrS2_Idx > 3  then
								Table.remove(g_arrS2,3)
								Table.remove(g_arrS2,3)
							elseif  g_arrS2_Idx > 2  then
								Table.remove(g_arrS2,3)
							end if
						end if
					end if
					
					g_arrS2_Idx = #g_arrS2
					Form.SetSharedData("50110_S2_CHECK" , Convert_ArrToString(g_arrS2, "★"))
					
					Form.triggerEvent("linkfmDetailCond", "50110_S2_CHECK", "")
					
					Table.remove(g_arrCategory_Order, k+1)
					Form.SetSharedData("50110_CATEGORY" , Convert_ArrToString(g_arrCategory_Order, "`"))
				end if
				
				exit Function
			end if
		
		elseif arrTemp(k) = "50110_S2_CHECK" then
			nStartIdx = nDataCnt
			nDataCnt = nDataCnt + g_arrS2_Idx
			
			if g_arrS2_Idx <> 0  and  nIdx < nDataCnt and nIdx >= nStartIdx then
				nPos = nIdx - nStartIdx + 1
				nArrCnt = g_arrS2_Idx
		
				if nArrCnt > 0 then
					if g_arrS2(0) = "채권" then
						if g_arrS2(nPos-1) = "채권" then
							for i = nPos to nArrCnt
								Table.remove(g_arrS2, nPos)
								g_arrS2_Idx = g_arrS2_Idx - 1
							next
						else
							if instr(g_arrS2(nPos-1), "Step0") > 0 then
								for i = nPos to nArrCnt
									if instr(g_arrS2(i-1), "Step2") > 0 then
							
										Table.remove(g_arrS2, i)
										g_arrS2_Idx = g_arrS2_Idx - 1
									end if
								next
							end if
							
							Table.remove(g_arrS2, nPos)
							g_arrS2_Idx = g_arrS2_Idx - 1
						end if
						
					elseif g_arrS2(0) = "원자재" then
						
						if g_arrS2(nPos-1) = "원자재" then
							for i = nPos to nArrCnt
								Table.remove(g_arrS2, nPos)
								g_arrS2_Idx = g_arrS2_Idx - 1
							next
						else
							if instr(g_arrS2(nPos-1), "Step0") > 0 then
								for i = nPos to nArrCnt
									Table.remove(g_arrS2, i)
									g_arrS2_Idx = g_arrS2_Idx - 1
								next
							else
								Table.remove(g_arrS2, nPos)
								g_arrS2_Idx = g_arrS2_Idx - 1
							end if
						
						end if
					else
						if g_arrS2_Idx > 1 then
							if g_arrS2(0) = "주식" and g_arrS2(1) = "Step0대표지수" then
								if g_arrS1_Idx > 0 and instr(g_arrS2(nPos-1), "Step1") > 0 then
								
								else
									for i = nPos to nArrCnt
										Table.remove(g_arrS2, nPos)
										g_arrS2_Idx = g_arrS2_Idx - 1
									next
								end if
							else
								for i = nPos to nArrCnt
									Table.remove(g_arrS2, nPos)
									g_arrS2_Idx = g_arrS2_Idx - 1
								next
							end if
						else
							for i = nPos to nArrCnt
								Table.remove(g_arrS2, nPos)
								g_arrS2_Idx = g_arrS2_Idx - 1
							next
						end if
					end if
					
					szResultData = Convert_ArrToString(g_arrS2, "")
					if szResultData = "" then
						Table.remove(g_arrCategory_Order, k+1)
						Form.SetSharedData("50110_CATEGORY" , Convert_ArrToString(g_arrCategory_Order, "`"))
					end if
					
					Check_Category(Convert_ArrToString(g_arrS2, "`"), 1)
					Form.SetSharedData("50110_S2_CHECK" , Convert_ArrToString(g_arrS2, "★"))
					Form.triggerEvent("linkfmDetailCond", "50110_S2_CHECK", "") 
				end if
				
				exit Function
			end if
		
		elseif arrTemp(k) = "50110_S3_CHECK" then
			nStartIdx = nDataCnt
			nDataCnt = nDataCnt + g_arrS3_Idx
			
			if g_arrS3_Idx <> 0 and nIdx < nDataCnt and nIdx >= nStartIdx then
				nPos = nIdx - nStartIdx + 1
				nArrCnt = g_arrS3_Idx
				
				if g_arrS3(nPos-1) = "한국 상장" then
					Form.SetSharedData("50110_S4_CHECK_DOMESTIC", "" )
					g_arrS4_0 = {}
					g_arrS4_0_Idx = 0
					
					Check_Category(Convert_ArrToString(g_arrS4_0, "`"), 3)
				end if
				
				if g_arrS3(nPos-1) = "미국 상장" or g_arrS3(nPos-1) = "중국 상장" or g_arrS3(nPos-1) = "홍콩 상장" or g_arrS3(nPos-1) = "일본 상장"  then
					if (g_arrS3(0) <> "한국 상장" and #g_arrS3 = 1) or (g_arrS3(0) = "한국 상장" and #g_arrS3 = 2) then
						Form.SetSharedData("50110_S4_CHECK_OVERSEA", "" )
						g_arrS4_1 = {}
						g_arrS4_1_Idx = 0
						
						Check_Category(Convert_ArrToString(g_arrS4_1, "`"), 3)
					end if
				end if
				
				Table.remove(g_arrS3, nPos)
				g_arrS3_Idx = g_arrS3_Idx - 1
				
				szResultData = Convert_ArrToString(g_arrS3, "")
				if szResultData = "" then
					Table.remove(g_arrCategory_Order, k+1)
					Form.SetSharedData("50110_CATEGORY" , Convert_ArrToString(g_arrCategory_Order, "`"))
				end if
				
				Check_Category(Convert_ArrToString(g_arrS3, "`"), 2)
				Form.SetSharedData("50110_S3_CHECK" , Convert_ArrToString(g_arrS3, "`"))
				Form.triggerEvent("linkfmDetailCond", "50110_S3_CHECK", "") 	
				Form.triggerEvent("linkfmDetailCond", "50110_S4_CHECK", "")
				exit Function
			end if
		
