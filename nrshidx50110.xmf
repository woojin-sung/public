	g_arrS5_Idx = 0
	
	g_arrS6 = {}
	g_arrS6_Idx = 0
	
	g_arrS7_0 = {}
	g_arrS7_0_Idx = 0
	
	g_arrS7_1 = {}
	g_arrS7_1_Idx = 0
	
	g_arrS8_0 = {}
	g_arrS8_0_Idx = 0
	
	g_arrS8_1 = {}
	g_arrS8_1_Idx = 0
	
	g_arrS9_0 = {}
	g_arrS9_0_Idx = 0
	
	g_arrS9_1 = {}
	g_arrS9_1_Idx = 0
	
	Check_Category("", 0)
	Check_Category("", 1)
	Check_Category("", 2)
	Check_Category("", 3)
	Check_Category("", 4)
	Check_Category("", 5)
	Check_Category("", 6)
	Check_Category("", 7)
	Check_Category("", 8)
	
	
	Form.SetSharedData("50110_CATEGORY", "" )
	Form.SetSharedData("50110_S1_CHECK", "" )
	
	Form.SetSharedData("50110_S2_CHECK", "" )
	
	Form.SetSharedData("50110_S3_CHECK", "" )
	
	Form.SetSharedData("50110_S4_CHECK_DOMESTIC", "" )
	Form.SetSharedData("50110_S4_CHECK_OVERSEA", "" )
	
	Form.SetSharedData("50110_S5_CHECK", "" )
	
	Form.SetSharedData("50110_S6_CHECK", "" )
	
	Form.SetSharedData("50110_S7_CHECK_RATE", "" )
	Form.SetSharedData("50110_S7_CHECK_PERIOD", "" )
	
	Form.SetSharedData("50110_S8_CHECK_RATE", "" )
	Form.SetSharedData("50110_S8_CHECK_PERIOD", "" )
	
	Form.SetSharedData("50110_S9_CHECK_DOMESTIC", "" )
	Form.SetSharedData("50110_S9_CHECK_OVERSEA", "" )
	
	
	
	Reload_Category()
	DisplaySetting_Cond()
	DisplaySetting_Category(-1)
End Function


'===============================================
' 배열 -> 문자열 변환
'===============================================
Function Convert_ArrToString(arrData, szSeperator)
	szResult = ""
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if i <> 0 then
			szResult = szResult & szSeperator 
		end if
		
		szResult = szResult & arrData(i) 
	next
	
	return szResult
End Function

'===============================================
' 배열 -> 문자열 변환(체크항목)
'===============================================
Function Convert_ChkArrToString(arrData, arrChkData, szSeperator)
	szResult = ""
	szArrCnt = #arrData
	
	for i = 0 to szArrCnt - 1
		if arrChkData(i) = "1" then
			if szResult <> "" then
				szResult = szResult & szSeperator 
			end if
			szResult = szResult & arrData(i) 
		end if
	next
	
	return szResult
End Function

'===============================================
' 문자열 -> 배열 변환
'===============================================
Function Convert_StringToArr(szData, szSeperator)
	szArrData = ""
	
	if szData <> null and szData <> "" then
		szArrData = split(szData, szSeperator)
	end if
	
	return szArrData
End Function

'===============================================
' 배열 데이터 확인
'===============================================
Function Contains_Array(arrData, szData)

	if arrData = null or arrData = "" then
		return false
	end if
	
	if szData = null or szData = "" then
		return false
	end if
	
	nArrCnt = #arrData
	
	for i = 0 to nArrCnt-1
		szArrData = arrData(i)
		
		if szArrData = szData then
			return true
		end if
	next 
	
	return false
End Function

