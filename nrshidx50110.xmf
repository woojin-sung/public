'==============================================
' 컨트롤 초기설정
'==============================================
Function Init_Control()
	lblGuide.fgcolor = g_szTxtColor_Grey
	
	btnClear.fgcolor = g_szTxtColor_Normal
	btnSearch.fgcolor = g_szTxtColor_White
	
	btnClear.btnimage = "btn_21.9"
	btnSearch.btnimage = "btn_20.9"
	
	btnClear.caption = "초기화"
	
	imgArrow.maintainratio = "1"
	imgArrow.imgpath = "img_etf_search"

	contCategory.bgcolor = g_szContBgColor
	nArrCnt = #g_arrCategory
	for i = 0 to nArrCnt - 1
		Form.setCtlProp("contCategory.btnCategory"&i, "caption", g_arrCategory(i))
	next
End Function

'===============================================
' 데이터 초기설정
'===============================================
Function Init_Data()

End Function

'===============================================
' 카테고리 항목 세팅
'===============================================
Function DisplaySetting_Category(nIdx)
	linkfmKeypad.left = 400
	
	if nIdx < 0 then
		imgArrow.visible = true
		lblGuide.visible = true
		linkfmDetailCond.visible = false
		
		linkfmDetailCond.linkfile = "nrsempty.xmf"
	else
		imgArrow.visible = false
		lblGuide.visible = false
		linkfmDetailCond.visible = true
		
		g_nCategoryIdx = nIdx
		linkfmDetailCond.linkfile = g_arrMap(nIdx)
	end if
	
	nArrCnt = #g_arrCategory

	for i = 0 to nArrCnt - 1
		if nIdx = i then
			Form.setCtlProp("contCategory.btnCategory"&i, "fgcolor", g_szTxtColor_Normal)
			Form.setCtlProp("contCategory.btnCategory"&i, "singleimage", g_szBtnImg_Select)
		else
			if g_arrCategory_Check(i) = "1" then
				Form.setCtlProp("contCategory.btnCategory"&i, "fgcolor", g_szTxtColor_White)
				Form.setCtlProp("contCategory.btnCategory"&i, "singleimage", g_szBtnImg_Check)
			else
				Form.setCtlProp("contCategory.btnCategory"&i, "fgcolor", g_szTxtColor_Normal)
				Form.setCtlProp("contCategory.btnCategory"&i, "btnimage", g_szBtnImg_Normal)
			end if
		end if
	next
	
	nPannelCnt = Pannel0.rowcount
	if Cint(nPannelCnt) = 0 then
		Form.triggerEvent("linkfmDetailCond", "50110_COND_STAT", "N")
	else
		Form.triggerEvent("linkfmDetailCond", "50110_COND_STAT", "Y")
	end if
End Function

Function Reload_Category()
	nArrCnt = #g_arrCategory

	for i = 0 to nArrCnt - 1
		if i = g_nCategoryIdx then
			Form.setCtlProp("contCategory.btnCategory"&i, "fgcolor", g_szTxtColor_Normal)
			Form.setCtlProp("contCategory.btnCategory"&i, "singleimage", g_szBtnImg_Select)
		else
			if g_arrCategory_Check(i) = "1" then
				Form.setCtlProp("contCategory.btnCategory"&i, "fgcolor", g_szTxtColor_White)
				Form.setCtlProp("contCategory.btnCategory"&i, "singleimage", g_szBtnImg_Check)
			else
				Form.setCtlProp("contCategory.btnCategory"&i, "fgcolor", g_szTxtColor_Normal)
				Form.setCtlProp("contCategory.btnCategory"&i, "btnimage", g_szBtnImg_Normal)
			end if
		end if
	next
End Function

'===============================================
' 카테고리 상세조건 체크여부 확인
'===============================================
Function Check_Category(szData, nCategoryIdx)
	if szData <> "" and szData <> null then
		g_arrCategory_Check(nCategoryIdx) = "1"
	else
		g_arrCategory_Check(nCategoryIdx) = "0"
	end if
End Function

'===============================================
' 상세조건 세팅
'===============================================
Function DisplaySetting_Cond()
	DATAMANAGER.ClearInputData(0, "ohhts_metf_003r")

	g_szInBlock1 = ""
	g_szInBlock2 = ""
	g_szInBlock3 = ""
	g_szInBlock4 = ""
	g_szInBlock5 = ""
	g_szInBlock6 = ""
	g_szInBlock7 = ""
	g_szInBlock8 = ""
	g_szInBlock9 = ""
	g_szInBlock10 = ""
	g_szInBlock11 = ""
	g_szInBlock12_1 = ""
	g_szInBlock12_2 = ""
	g_szInBlock12_3 = ""
	g_szInBlock12_4 = ""
	g_szInBlock12_5 = ""
	
	Pannel0.rowcount = 0
	Pannel0.rowcount = g_arrS1_Idx + g_arrS2_Idx + g_arrS3_Idx + g_arrS4_0_Idx + g_arrS4_1_Idx + g_arrS5_Idx + g_arrS6_Idx + g_arrS7_0_Idx + g_arrS7_1_Idx + g_arrS8_0_Idx + g_arrS8_1_Idx  + g_arrS9_0_Idx + g_arrS9_1_Idx
	
'	if Cint(Pannel0.rowcount) > 0 then
'		Pannel0.toprow = Cint(Pannel0.rowcount-1)
'	end if
	
	if Cint(Pannel0.rowcount) > 0 then
		imgCondBg.visible = true
		Pannel0.visible = true
		btnClear.visible = true
		btnSearch.visible = true
		
		Form.triggerEvent("linkfmDetailCond", "50110_COND_STAT", "Y")
	else
		imgCondBg.visible = false
		Pannel0.visible = false
		btnClear.visible = false
		btnSearch.visible = false
		
		Form.triggerEvent("linkfmDetailCond", "50110_COND_STAT", "N")
	end if
	
	
	nStartIdx = -1
	
	nLvrgCnt = 0
	for k = 0 to #g_arrCategory_Order-1 
		
		if g_arrCategory_Order(k) = "50110_S1_CHECK" then
			
			nArrCnt = g_arrS1_Idx
			for i = 0 to nArrCnt-1 
				nStartIdx = nStartIdx + 1
				Pannel0.setPropCardCell("paddinginfo","lblCond",nStartIdx,"0,0,0,0")
				Pannel0.setPropCardCell("maintainratio","imgRemove",nStartIdx,"3")
				Pannel0.setPropCardCell("imgpath","imgRemove",nStartIdx,"icon_close")
				'Pannel0.setPropCardCell("autofit","lblCond",nStartIdx,"1")
			
				szTempData = ""
				if instr(g_arrS1(i), "^") > 0 then
					arrTempData = Convert_StringToArr(g_arrS1(i), "^")
					szTempData = arrTempData(1)
				else
					szTempData = g_arrS1(i)
				end if
				
				if g_szInBlock1 <> "" then
					g_szInBlock1 = g_szInBlock1 & "`" & szTempData
				else
					g_szInBlock1 = szTempData
				end if
				
				DATAMANAGER.SetDataValue(0, "ohhts_metf_003r", "InBlock1", "FID_INVT_REGN_NAME" , i , szTempData)
				
				Pannel0.setPropCardCell("caption","lblCond",nStartIdx, szTempData)
				
				nWidth = Form.getTextWidth(szTempData, -2, false, false)
				Pannel0.setPropCardCell("width", "lblCond", nStartIdx, Cint(nWidth) + 2)
				Pannel0.setPropCardCell("left", "imgRemove", nStartIdx, nWidth + g_nRemove_Gap)
				Pannel0.SetCardWHAt(nStartIdx,nWidth+g_nRemove_Gap+g_nRemove_Width)
				
			next
		
		elseif g_arrCategory_Order(k) = "50110_S2_CHECK" then
			
			
			'기초자산 중복선택 표시 필요
			nArrCnt = g_arrS2_Idx
			nSubCnt = 0
			for i = 0 to nArrCnt-1
				nStartIdx = nStartIdx + 1
				Pannel0.setPropCardCell("paddinginfo","lblCond",nStartIdx,"0,0,0,0")
				Pannel0.setPropCardCell("maintainratio","imgRemove",nStartIdx,"3")
				Pannel0.setPropCardCell("imgpath","imgRemove",nStartIdx,"icon_close")
				arrTempData = Convert_StringToArr(g_arrS2(i), "`")
				szTempData = ""
				
				
				if instr(arrTempData(0), "^") > 0 then
					arrTempData2 = Convert_StringToArr(arrTempData(0), "^")
					szTempData = arrTempData2 (1)
				else
					if instr(arrTempData(0), "Step0") > 0 then
						szTempData = replace(arrTempData(0), "Step0", "")
						
						for j = 0 to #arrTempData-1
							szValue = ""
							if j = 0 then
								szValue = replace(arrTempData(j), "Step0", "")
							else
								szValue = arrTempData(j)
							end if
							
							if g_szInBlock4 <> "" then
								g_szInBlock4 = g_szInBlock4 & "`" & szValue
							else
								g_szInBlock4 = szValue
							end if
						
							DATAMANAGER.SetDataValue(0, "ohhts_metf_003r", "InBlock4", "FID_LRDV_CODE_NAME", j , szValue)
						next
						
					elseif instr(arrTempData(0), "Step1") > 0 then
						szTempData = replace(arrTempData(0), "Step1", "")
						
						for j = 0 to #arrTempData-1
							szValue = ""
							if j = 0 then
								szValue = replace(arrTempData(j), "Step1", "")
							else
								szValue = arrTempData(j)
							end if
							
							if g_szInBlock5 <> "" then
								g_szInBlock5 = g_szInBlock5 & "`" & szValue
							else
								g_szInBlock5 = szValue
							end if
							DATAMANAGER.SetDataValue(0, "ohhts_metf_003r", "InBlock5", "FID_MDDV_CODE_NAME", j , szValue)
						next
						
					elseif instr(arrTempData(0), "Step2") > 0 then
						szTempData = replace(arrTempData(0), "Step2", "")
						
						nSubCnt = DATAMANAGER.GetDataCount(0, "ohhts_metf_003r", "InBlock5")
						szData = DATAMANAGER.GetDataValue(0, "ohhts_metf_003r", "InBlock3", "FID_UNAS_NAME", 0)
						for j = 0 to #arrTempData-1
							szValue = ""
							if j = 0 then
								szValue = replace(arrTempData(j), "Step2", "")
							else
								szValue = arrTempData(j)
							end if
							
							if szData = "원자재" then
							
								if g_szInBlock5 <> "" then
									g_szInBlock5 = g_szInBlock5 & "`" & szValue
								else
									g_szInBlock5 = szValue
								end if
		
								DATAMANAGER.SetDataValue(0,"ohhts_metf_003r", "InBlock5", "FID_MDDV_CODE_NAME" , j + nSubCnt , szValue)
							else
								if g_szInBlock6 <> "" then
									g_szInBlock6 = g_szInBlock6 & "`" & szValue
								else
									g_szInBlock6 = szValue
								end if
								szTempVal = szValue
								
								if szTempVal = "BBB-- 이상" then
									szTempVal = "IG"
								elseif szTempVal = "BB+ 이하" then
									szTempVal = "HY"
								end if
							
					
								DATAMANAGER.SetDataValue(0,"ohhts_metf_003r", "InBlock6", "FID_SMDV_CODE_NAME" , j , szTempVal)
							end if
						next
					else
						szTempData = arrTempData(0)
						if g_szInBlock3 <> "" then
							g_szInBlock3 = g_szInBlock3 & "`" & szTempData
						else
							g_szInBlock3 = szTempData
						end if
						DATAMANAGER.SetDataValue(0, "ohhts_metf_003r", "InBlock3", "FID_UNAS_NAME", i , szTempData)
					end if
				end if
				
				nArrCnt  = #arrTempData-1
				
				if nArrCnt > 0 then
					szTempData = szTempData & " 외 " & nArrCnt & "개"
				end if
				
				nWidth = Form.getTextWidth(szTempData, -2, false, false)
				Pannel0.setPropCardCell("width", "lblCond", nStartIdx, nWidth)
				Pannel0.setPropCardCell("left", "imgRemove", nStartIdx, nWidth + g_nRemove_Gap)
				Pannel0.SetCardWHAt(nStartIdx,nWidth+g_nRemove_Gap+g_nRemove_Width)
				
				Pannel0.setPropCardCell("caption","lblCond",nStartIdx, szTempData)
			next
		
		elseif g_arrCategory_Order(k) = "50110_S3_CHECK" then
			nArrCnt = g_arrS3_Idx
			for i = 0 to nArrCnt-1
				nStartIdx = nStartIdx + 1
				Pannel0.setPropCardCell("paddinginfo","lblCond",nStartIdx,"0,0,0,0")
				Pannel0.setPropCardCell("maintainratio","imgRemove",nStartIdx,"3")
				Pannel0.setPropCardCell("imgpath","imgRemove",nStartIdx,"icon_close")
				szTempData = ""
				if instr(g_arrS3(i), "^") > 0 then
					arrTempData = Convert_StringToArr(g_arrS3(i), "^")
					szTempData = arrTempData(1)
				else
					szTempData = g_arrS3(i)
				end if
				
				szNationCd = ""
				if szTempData = "한국 상장" then
					szNationCd = "KOR"
				elseif szTempData = "미국 상장" then
					szNationCd = "USA"
				elseif szTempData = "중국 상장" then
					szNationCd = "CHN"
				elseif szTempData = "홍콩 상장" then
					szNationCd = "HKG"
				elseif szTempData = "일본 상장" then
					szNationCd = "JPN"
				end if
				
				if g_szInBlock2 <> "" then
					g_szInBlock2 = g_szInBlock2 & "`" & szNationCd
				else
					g_szInBlock2 = szNationCd
				end if
				
				DATAMANAGER.SetDataValue(0, "ohhts_metf_003r", "InBlock2", "FID_LSTN_NTNL_CODE", i , szNationCd)
				
				nWidth = Form.getTextWidth(szTempData, -2, false, false)
				Pannel0.setPropCardCell("width", "lblCond", nStartIdx, nWidth)
				Pannel0.setPropCardCell("left", "imgRemove", nStartIdx, nWidth + g_nRemove_Gap)
				Pannel0.SetCardWHAt(nStartIdx,nWidth+g_nRemove_Gap+g_nRemove_Width)
				
				Pannel0.setPropCardCell("caption","lblCond",nStartIdx, szTempData)
			next
		
		elseif g_arrCategory_Order(k) = "50110_S4_CHECK" then
			nSubCnt = 0
			nArrCnt =  g_arrS4_0_Idx
			for i = 0 to nArrCnt-1
				nStartIdx = nStartIdx + 1
				Pannel0.setPropCardCell("paddinginfo","lblCond",nStartIdx,"0,0,0,0")
				Pannel0.setPropCardCell("maintainratio","imgRemove",nStartIdx,"3")
				Pannel0.setPropCardCell("imgpath","imgRemove",nStartIdx,"icon_close")
				szTempData = ""
