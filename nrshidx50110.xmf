Function Clear_Cond()
	g_arrS1 = {}
	g_arrS1_Idx = 0
	
	g_arrS2 = {}
	g_arrS2_Idx = 0
	
	g_arrS3 = {}
	g_arrS3_Idx = 0
	
	g_arrS4_0 = {}
