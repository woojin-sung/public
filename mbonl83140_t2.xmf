	<SCRIPT_INFO _len="2981" _ulen="2845" >
--===========================================================================
--===========================================================================
Dim g_sAcno, g_sAsno
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "REQ" then
		if sParam <> "" and sParam <> null then
			g_sAcno = Left(sParam, 8)
			g_sAsno = Right(sParam, 2)
			
			DATAMANAGER.RequestTranData( "obrgt_dmac_105r" )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obrgt_dmac_105r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "PROS_CLS_CODE", 0, "1")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO", 0, g_sAcno )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ASNO", 0, g_sAsno )
	end if
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	dim szSendData, szItemCode, szItemNm, szDeadLine,szDate, szPrc, szPrePrc, szAbleQty1, szAbleQty2, szAbleQty3, szMangCode
	szItemCode = Grid0.GetCellData( "bd_code", lRow)
	if szItemCode <> "" and szItemCode <> null then
		szItemNm = Grid0.GetCellData( "bd_itemnm", lRow)
		szDeadLine = Grid0.GetCellData( "bd_deaddate", lRow)
		szDate = Grid0.GetCellData( "bd_date", lRow)
		szPrc = Grid0.GetCellData( "bd_prc", lRow)
		szPrePrc = Grid0.GetCellData( "bd_preprc", lRow)
		szAbleQty1 = Grid0.GetCellData( "bd_qty1", lRow)
		szAbleQty2 = Grid0.GetCellData( "bd_qty2", lRow)
		szAbleQty3 = Grid0.GetCellData( "bd_qty3", lRow)
		szMangCode = Grid0.GetCellData( "bd_mang", lRow)
		szDmprQty = Grid0.GetCellData( "bd_dmprqty", lRow)
		
		'전달데이터
		'0 : 종목코드
		'1 : 종목명
		'2 : 마감일
		'3 : 기준일
		'4 : 청구금액
		'5 : 전일종가
		'6 : 현금 가능 수량
		'7 : 신용 가능 수량
		'8 : 유통 가능 수량
		'9 : 관리 지점코드
		'10: 매수청구수량
		szSendData = szItemCode & "★" & szItemNm & "★" & szDeadLine 
					& "★" & szDate & "★" & szPrc 
					& "★" & szPrePrc & "★" & szAbleQty1
					& "★" & szAbleQty2 & "★" & szAbleQty3
					& "★" & szMangCode& "★" & szDmprQty
	end if
	
	Form.triggerEvent("#", "OPEN_TAB2_REG_POPUP", szSendData)
End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData( "obrgt_dmac_105r" ) == True then
		DATAMANAGER.RequestNextData( "obrgt_dmac_105r" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	If szSubMsg <> null and Trim(szSubMsg) <> "" Then
		szErrMsg = szErrMsg & "(" & szSubMsg & ")" 
	end if
	
	Form.ShowAlert( "알림", szErrMsg )
End Sub


