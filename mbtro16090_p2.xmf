'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'영문직업
	if sKeyName == "mbtro16090_p7_RETURN" then
		cmbJobName.cbkeydata = sRet
		
		lblJobName.caption = cmbJobName.caption
	end if
End Sub

'============================================================================
Sub btnUpdate_OnClick()
	Dim szCUST_NUM
	Dim szTranID
	szCUST_NUM = Form.GetSharedData("&CUST_NUM", false)
	szTranID   = "obtro_acnt_207a"
	
	DATAMANAGER.ClearInputData(0, szTranID)
	
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 	0 , "U" )				'처리구분코드
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" , 			0 , szCUST_NUM )			'고객번호
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CUST_ENG_NAME" , 	0 , edtName.caption )		'고객영문명
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_ADDR" , 		0 , edtAddr.caption )		'영문주소
	'DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_OCPT_NAME" , 	0 , cmbJobName.cbkeydata )	'영문직업명
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_OCPT_NAME" , 	0 , g_szInPutJobName )	'영문직업명
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_CO_NAME" , 	0 , edtComName.caption )	'영문회사명
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_CO_ADDR" , 	0 , edtComAddr.caption )	'영문회사주소
	'DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CLPS_NAME" , 		0 , edtClpsName.caption )	'직급명
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CLPS_NAME" , 		0 , g_szInPutClpsName )	'직급명
	DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "RSNS_BSWR_NAME" , 	0 , edtBswrName.caption )	'담당업무명
	
	DATAMANAGER.RequestTranData(szTranID)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErrMsg
	szSubErrMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	if szTranID == "obtro_acnt_207a" then
		Form.ShowAlert("알림", szErrMsg.."("..szSubErrMsg..")")
	end if
End Sub

'============================================================================
Function cmbClpsNameFindKeyData(KeyData)
	Dim szSearchFlag
	
	for i = 0 to ubound(g_szKeyClpsName)
		if g_szKeyClpsName(i) == KeyData then
			'cmbClpsName.currentindex = i
			szSearchFlag = "Y"
		end if
	next
	
	if szSearchFlag == "Y" then
		cmbClpsName.cbkeydata = KeyData
	else
		cmbClpsName.cbkeydata = ""
		cmbClpsName.caption   = KeyData
	end if
	
	return KeyData
End Function

'============================================================================
Function cmbJobNameFindKeyData(KeyData)
	Dim szSearchFlag
	
	for i = 0 to ubound(g_szKeyJobName)
		if g_szKeyJobName(i) == KeyData then
			'cmbClpsName.currentindex = i
			szSearchFlag = "Y"
		end if
	next
	
	if szSearchFlag == "Y" then
		cmbJobName.cbkeydata = KeyData
		g_nBefIndex = cmbJobName.currentindex
	else
		cmbJobName.cbkeydata = ""
		cmbJobName.caption   = KeyData
		g_nBefIndex = -1
	end if
	
	return KeyData
End Function


'============================================================================
Sub cmbClpsName_OnEditComplete(iIndex)
	g_szInPutClpsName = cmbClpsNameFindKeyData( cmbClpsName.cbkeydata )
End Sub



'============================================================================
Sub cmbJobName_OnEditComplete(iIndex)

	if iIndex == 19 or iIndex == 16 or iIndex == 18 or iIndex == 13 then
		cmbClpsName.currentindex = 9
		edtComName.caption  = "Other"
		edtComAddr.caption  = "Other"
		edtBswrName.caption = "Other"
	elseif (Cint(g_nBefIndex) == 19 or Cint(g_nBefIndex) == 16 or Cint(g_nBefIndex) == 18 or Cint(g_nBefIndex) == 13) and (iIndex <> 19 and iIndex <> 16 and iIndex <> 18 and iIndex <> 13) then
		cmbClpsName.currentindex = -1
		cmbClpsName.caption = ""
		g_szInPutClpsName = ""
		edtComName.caption  = ""
		edtComAddr.caption  = ""
		edtBswrName.caption = ""
	else
		'msgbox "ELSE g_nBefIndex = "..g_nBefIndex..", iIndex = "..iIndex
	end if
	
	g_szInPutJobName = cmbJobNameFindKeyData( cmbJobName.cbkeydata )
	
End Sub

