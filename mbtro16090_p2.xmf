'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("해외주식 시세신청 신청자정보입력")
	
	cmbJobName.caption = ""
	lblJobName.caption = ""
	cmbClpsName.caption = ""
	
	Dim szOpenData, szSplitData
	
	szOpenData = Form.GetOpenLinkData()
	
	if szOpenData <> "" then
		szSplitData = Split(szOpenData, "★")
		
		if szSplitData[0] == "" then
			'해외주식 실시간 추가정보 조회(조회)
			DATAMANAGER.RequestTranData( "obtro_acnt_206r_1" )
		else
			g_szEngName = szSplitData[0]
			g_szEngAddress = szSplitData[1]
			
			g_szEngOcptName = szSplitData[2]
			g_szEngCoName = szSplitData[3]
			g_szEngCoAddr = szSplitData[4]
			g_szEngClpsName = szSplitData[5]
			g_szEngRsnsBswrName = szSplitData[6]
			
			edtName.caption = g_szEngName
			edtAddr.caption = g_szEngAddress
			'cmbJobName.cbkeydata = g_szEngOcptName
			g_szInPutJobName = cmbJobNameFindKeyData(g_szEngOcptName)
			edtComName.caption = g_szEngCoName
			edtComAddr.caption = g_szEngCoAddr
			'edtClpsName.caption = g_szEngClpsName
			'cmbClpsName.cbkeydata = g_szEngClpsName
			g_szInPutClpsName = cmbClpsNameFindKeyData(g_szEngClpsName)
			edtBswrName.caption = g_szEngRsnsBswrName
			
			lblJobName.caption = cmbJobName.caption
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCUST_NUM
	szCUST_NUM = Form.GetSharedData("&CUST_NUM", false)
		
	'해외주식 실시간 추가정보 조회(조회)
	if szTranID == "obtro_acnt_206r_1" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 	0 , "2" )				'처리구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" , 			0 , szCUST_NUM )			'고객번호
		
	'해외주식 실시간 추가정보 조회(정합성체크)
	elseif szTranID == "obtro_acnt_206r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 	0 , "1" )				'처리구분코드
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" , 			0 , szCUST_NUM )			'고객번호
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CUST_ENG_NAME" , 	0 , edtName.caption )		'고객영문명
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_ADDR" , 		0 , edtAddr.caption )		'영문주소
		'DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_OCPT_NAME" , 	0 , cmbJobName.cbkeydata )	'영문직업명
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_OCPT_NAME" , 	0 , g_szInPutJobName )	'영문직업명
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_CO_NAME" , 	0 , edtComName.caption )	'영문회사명
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "ENG_CO_ADDR" , 	0 , edtComAddr.caption )	'영문회사주소
		'DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CLPS_NAME" , 		0 , edtClpsName.caption )	'직급명
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CLPS_NAME" , 		0 , g_szInPutClpsName )	'직급명
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "RSNS_BSWR_NAME" , 	0 , edtBswrName.caption )	'담당업무명
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'해외주식 실시간 추가정보 조회(조회)
	if szTranID == "obtro_acnt_206r_1" then
		Dim szENG_OCPT_NAME
		Dim szCLPS_NAME
		Dim szSearchFlag
		
		szENG_OCPT_NAME = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "ENG_OCPT_NAME" , 0 )	'직급명
		szCLPS_NAME     = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "CLPS_NAME"     , 0 )
		szSearchFlag      = "N"
		
'		if tonumber(szENG_OCPT_NAME) == nil or tonumber(szENG_OCPT_NAME) == "" then
'			cmbJobName.cbkeydata = ""
'			lblJobName.caption = ""
'		else
'			cmbJobName.cbkeydata = szENG_OCPT_NAME
'		
'			lblJobName.caption = cmbJobName.caption
'		end if
		g_szInPutJobName  = cmbJobNameFindKeyData(szENG_OCPT_NAME)
		g_szInPutClpsName = cmbClpsNameFindKeyData(szCLPS_NAME)
		
	'해외주식 실시간 추가정보 조회(정합성체크)
	elseif szTranID == "obtro_acnt_206r" then
		Dim szNRML_YN, szNRML_REAS
		szNRML_YN = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "NRML_YN" , 0 )		'정상여부
		szNRML_REAS = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "NRML_REAS" , 0 )	'정상사유
		
		'정상
		if szNRML_YN == "Y" then
			szSendData = edtName.caption & "★" & edtAddr.caption & "★" & g_szInPutJobName & "★" & edtComName.caption & "★" & edtComAddr.caption & "★" & g_szInPutClpsName & "★" & edtBswrName.caption
			Form.SendReturnToParent("INFO_RETURN" , szSendData)
			
			Form.CloseForm()
		'오류 - 예)영문이름 한글 불가	
		else
			Form.ShowAlert("알림", "입력데이터 확인이 필요합니다.("..szNRML_REAS..")")
		end if
	elseif szTranID == "obtro_acnt_207a" then
		Form.ShowAlert("알림", "정상적으로 수정되었습니다.")
		szSendData = edtName.caption & "★" & edtAddr.caption & "★" & g_szInPutJobName & "★" & edtComName.caption & "★" & edtComAddr.caption & "★" & g_szInPutClpsName & "★" & edtBswrName.caption
		Form.SendReturnToParent("INFO_RETURN" , szSendData)
	end if
End Sub

'============================================================================
Sub btnSubmit_OnClick()
	Dim szSendData

	if Trim(edtName.caption) = "" then
		Form.ShowAlert("알림", "영문이름을 입력해주세요.")			
		Exit Sub
	end if
	
	if Trim(edtAddr.caption) = "" then
		Form.ShowAlert("알림", "영문주소를 입력해주세요.")		
		Exit Sub
	end if
	
	if Trim(cmbJobName.caption) = "" then
		Form.ShowAlert("알림", "영문직업을 입력해주세요.")		
		Exit Sub
	end if
	
	if Trim(edtComName.caption) = "" then
		Form.ShowAlert("알림", "영문회사명을 입력해주세요.")		
		Exit Sub
	end if
	
	if Trim(edtComAddr.caption) = "" then
		Form.ShowAlert("알림", "영문회사주소를 입력해주세요.")		
		Exit Sub
	end if

'	if Trim(edtClpsName.caption) = "" then
'		Form.ShowAlert("알림", "영문직급및직위를 입력해주세요.")		
'		Exit Sub
'	end if

	if Trim(cmbClpsName.caption) = "" then
		Form.ShowAlert("알림", "영문직급및직위를 입력해주세요.")		
		Exit Sub
	end if
	
	if Trim(edtBswrName.caption) = "" then
		Form.ShowAlert("알림", "영문담당업무를 입력해주세요.")		
		Exit Sub
	end if
	
	'해외주식 실시간 추가정보 조회(정합성체크)
	DATAMANAGER.RequestTranData( "obtro_acnt_206r" )
End Sub

