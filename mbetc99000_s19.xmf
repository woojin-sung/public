Sub Form_OnFormInit()


	'szList = split(szData,"●")
	
	
	'c_score = Cint(szList(0))
	'prtf_id = Cstr(szList(0))
	
	
	check_flag = 0 '관심등록 여부 플래그
	
	check_flag_1 = 0

	prtf_id = Cstr(Form.GetOpenLinkData())




    
    
    'Form.MsgBox("", prtf_id, "", "")


	DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "INP_CLS_CODE" , 0 , 1)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "PRTF_ID" , 0 , prtf_id)
	DATAMANAGER.RequestTranData("obcpp_intr_759r") '3개월 지표 서비스 호출
	
	
	DATAMANAGER.SetDataValue(0, "obcpp_intr_722r", "InBlock2", "PRTF_ID" , 0 , prtf_id)
	DATAMANAGER.RequestTranData("obcpp_intr_722r") '해당포트폴리오 상세조회 서비스 호출
	
	
	Container0.Table0.SetCellFgColor(0, 0, "92")
	Container0.Table1.SetCellFgColor(0, 0, "89")
	Container0.Table2.SetCellFgColor(0, 0, "89")
	Container0.Table3.SetCellFgColor(0, 0, "89")
	
	'Container0.Table0.SetCellBgColor(0, 0, "90")
	
	
	'if check_flag == 1 then
	'Table6.SetCellString(0, 0, "관심해제")
	
	'else
	'Table6.SetCellString(0, 0, "관심등록")
	
	'end if
	
	
	
	
	
	
	
	
	
	
End Sub

'============================================================================
Sub Container0_Table0_OnClick(lRow , lColumn) '과거수익률 버튼

Container0.Table0.SetCellFgColor(0, 0, "92")
	Container0.Table1.SetCellFgColor(0, 0, "89")
	Container0.Table2.SetCellFgColor(0, 0, "89")
	Container0.Table3.SetCellFgColor(0, 0, "89")


	DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "INP_CLS_CODE" , 0 , 1)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "PRTF_ID" , 0 , prtf_id)
	
	DATAMANAGER.RequestTranData("obcpp_intr_759r") '과거수익률 그래프 서비스 호출
	
	
	tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "D1_ERT" , 0) ''1일 수익률
	Container0.Table4.SetCellString(1, 1 , round(tmp,2)&"%")
 
 
	 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "W1_ERT" , 0) '1주일 수익률
	 Container0.Table4.SetCellString(1, 2 , round(tmp,2)&"%")
 
	 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "M1_ERT" , 0) '1개월 수익률
	 Container0.Table4.SetCellString(3, 0 , round(tmp,2)&"%")
 
	 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "M3_ERT" , 0) '3개월 수익률
	 Container0.Table4.SetCellString(3, 1 , round(tmp,2)&"%")
 
	


	
End Sub

'============================================================================
Sub Container0_Table1_OnClick(lRow , lColumn) '샤프지수 버튼

Container0.Table0.SetCellFgColor(0, 0, "89")
	Container0.Table1.SetCellFgColor(0, 0, "92")
	Container0.Table2.SetCellFgColor(0, 0, "89")
	Container0.Table3.SetCellFgColor(0, 0, "89")

DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "INP_CLS_CODE" , 0 , 2)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "PRTF_ID" , 0 , prtf_id)
	
	DATAMANAGER.RequestTranData("obcpp_intr_759r")
	
	
	tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "UI_SHRO_Y1_VAL" , 0) ''1일 샤프지수
	Container0.Table4.SetCellString(1, 1 , round(tmp,2)&"%")
 
 
	 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "UI_SHRO_Y2_VAL" , 0) '1주일 샤프지수
	 Container0.Table4.SetCellString(1, 2 , round(tmp,2)&"%")
 
	 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "UI_SHRO_Y3_VAL" , 0) '1개월 샤프지수
	 Container0.Table4.SetCellString(3, 0 , round(tmp,2)&"%")
 
	 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "UI_SHRO_Y4_VAL" , 0) '3개월 샤프지수
	 Container0.Table4.SetCellString(3, 1 , round(tmp,2)&"%")
 
	
	
	
	
End Sub

