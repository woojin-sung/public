Sub Container0_Table2_OnClick(lRow , lColumn) 'MDD 버튼

Container0.Table0.SetCellFgColor(0, 0, "89")
	Container0.Table1.SetCellFgColor(0, 0, "89")
	Container0.Table2.SetCellFgColor(0, 0, "92")
	Container0.Table3.SetCellFgColor(0, 0, "89")

DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "INP_CLS_CODE" , 0 , 3)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "PRTF_ID" , 0 , prtf_id)
	
	DATAMANAGER.RequestTranData("obcpp_intr_759r")
	
	
	
	tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "Y1_ERT" , 0) ''1일 MDD
	Container0.Table4.SetCellString(1, 1 , round(tmp,2)&"%")
 
 
	 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "Y2_ERT", 0) '1주일 MDD
	 Container0.Table4.SetCellString(1, 2 , round(tmp,2)&"%")
 
	 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "Y3_ERT" , 0) '1개월 MDD
	 Container0.Table4.SetCellString(3, 0 , round(tmp,2)&"%")
 
	 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "Y4_ERT" , 0) '3개월 MDD
	 Container0.Table4.SetCellString(3, 1 , round(tmp,2)&"%")
	
	
	
End Sub

'============================================================================
Sub Container0_Table3_OnClick(lRow , lColumn) '표준편차 버튼

Container0.Table0.SetCellFgColor(0, 0, "89")
	Container0.Table1.SetCellFgColor(0, 0, "89")
	Container0.Table2.SetCellFgColor(0, 0, "89")
	Container0.Table3.SetCellFgColor(0, 0, "92")

DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "INP_CLS_CODE" , 0 , 4)
	DATAMANAGER.SetDataValue(0, "obcpp_intr_759r", "InBlock1", "PRTF_ID" , 0 , prtf_id)
	
	DATAMANAGER.RequestTranData("obcpp_intr_759r")
	
	
	
	tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "UI_STDV_Y1_VAL" , 0) ''1일 표준편차
	Container0.Table4.SetCellString(1, 1 , round(tmp,2)&"%")
 
 
	 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "UI_STDV_Y2_VAL", 0) '1주일 표준편차
	 Container0.Table4.SetCellString(1, 2 , round(tmp,2)&"%")
 
	 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "UI_STDV_Y3_VAL" , 0) '1개월 표준편차
	 Container0.Table4.SetCellString(3, 0 , round(tmp,2)&"%")
 
	 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "UI_STDV_Y4_VAL" , 0) '3개월 표준편차
	 Container0.Table4.SetCellString(3, 1 , round(tmp,2)&"%")
	
	
	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

 if szTranID == "obcpp_intr_722r" then
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "FERT" , 0) '수수료
 Container0.Table4.SetCellString(1, 0 , round(tmp,2)&"%")
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "D1_ERT" , 0) ''1일 수익률
 Container0.Table4.SetCellString(1, 1 , round(tmp,2)&"%")
 
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "W1_ERT" , 0) '1주일 수익률
 Container0.Table4.SetCellString(1, 2 , round(tmp,2)&"%")
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "M1_ERT" , 0) '1개월 수익률
 Container0.Table4.SetCellString(3, 0 , round(tmp,2)&"%")
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "M3_ERT" , 0) '3개월 수익률
 Container0.Table4.SetCellString(3, 1 , round(tmp,2)&"%")
 
 
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "ADCP_NAME" , 0) '자문사명
 Container0.Table5.SetCellString(0, 1 , tmp)
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "PRTF_NAME" , 0) '포트폴리오명
 Container0.Table5.SetCellString(1, 1 , tmp)
 
 
 tmp = Cint(DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "LWST_JOIN_AMT" , 0)) '최저가입금액
 Container0.Table5.SetCellString(2, 1 , Cint(tmp/10000)&"만원")
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "CNRC_PRD" , 0) '계약기간
 Container0.Table5.SetCellString(3, 1 , cint(tmp)&"개월 (만기시 자동연장)")
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "ANTC_ERT" , 0) '예상수익률
 Container0.Table5.SetCellString(4, 1 ,round(tmp,2)&"%")
 
 
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "INP_RBDV_VLPN" , 0) '예상수익률
 
 
 if round(tmp,0) == 1 then
	tmp = "★☆☆☆☆"
	  
	elseif round(tmp,0) == 2 then
	tmp = "★★☆☆☆"
	
	elseif round(tmp,0) ==3 then
	tmp = "★★★☆☆"
	
	elseif round(tmp,0) == 4 then
	tmp = "★★★★☆"
	
	elseif round(tmp,0) ==5 then
	tmp = "★★★★★"
	
	end if
 Container0.Table5.SetCellString(5, 1 , tmp)
 
 tmp = DATAMANAGER.GetDataValue(0,"obcpp_intr_722r", "OutBlock1", "INP_INVT_INCL_CLCD" , 0) '포트폴리오 위험등급
 
 if abs(tmp) == 1 then
	tmp = "안정형"
	  
	elseif abs(tmp) == 2 then
	tmp = "안정추구형"
	
	elseif abs(tmp) ==3 then
	tmp = "중립형"
	
	elseif abs(tmp) == 4 then
	tmp = "수익추구형"
	
	elseif abs(tmp) ==5 then
	tmp = "고수익추구형"
	
end if
	
 
 Container0.Table5.SetCellString(6, 1 , tmp)
 
 
 elseif szTranID == "obcpp_intr_754r" then
 
 cnt = DATAMANAGER.GetDataCount(0, "obcpp_intr_754r" , "OutBlock1")
 
 for i=0 to cnt
	 if prtf_id == DATAMANAGER.GetDataValue(0, "obcpp_intr_754r", "OutBlock1", "PRTF_ID", i) then '이미 관심등록되어있는지 검사
		 check_flag = 1
		 Table6.SetCellString(0, 0, "관심해제")
		 exit for
		 
	 else
		 check_flag = 0
		 Table6.SetCellString(0, 0, "관심등록")
		 
     end if
     
 next
 
 
 elseif szTranID =="obcpp_intr_754r_1" then '모의투자 유무 확인
 
 cnt = DATAMANAGER.GetDataCount(0, "obcpp_intr_754r_1" , "OutBlock1")
 
 for i=0 to cnt
	 if prtf_id == DATAMANAGER.GetDataValue(0, "obcpp_intr_754r_1", "OutBlock1", "PRTF_ID", i) then '이미 모의투자 등록되어있는지 검사
		 check_flag_1 = 1
		' Table6.SetCellString(0, 0, "관심해제")
		 exit for
		 
	 else
		 check_flag_1 = 0
	'	 Table6.SetCellString(0, 0, "관심등록")
		 
     end if
     
 next
	 
 
 end if
 
 
 
End Sub

'============================================================================
Sub Table9_OnClick(lRow , lColumn)

Form.OpenFramePopup("mbetc99000_s20" , prtf_id , "")
	
End Sub

'============================================================================
Sub Table8_OnClick(lRow , lColumn)

Form.OpenFramePopup("mbetc99000_s23" , prtf_id , "")
	
End Sub

'============================================================================
Sub Table7_OnClick(lRow , lColumn)
	if check_flag_1 == 1 then
	Form.Toast(0, "이미 모의투자 진행중인 상품입니다.", 0.5)
	
	else
	Form.OpenPopup("mbetc99000_s27","","")
	
	end if 
	
End Sub


'============================================================================


Sub Form_OnPopupReturn(sKeyName, sRet)

if sKeyName =="mbetc99000_s27" then '모의투자 초기값 입력 완료 후 

 

g_szData = sRet
g_szList = Split(g_szData, "●")

frst_cnrc_amt = Cint(g_szList(0))
splm_invt_amt = cint(g_szList(1))

DATAMANAGER.SetEventFlag("obcpp_intr_757a", "I")
