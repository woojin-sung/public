'============================================================================
' 01.화면명 	: HOME_Market
' 02.화면설명	: HOME_Market_메인화면
' 03.작성	: 
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

dim g_szInputFile		'읽어들일리스트세팅파일
dim g_szKeys			'읽어들일키값
dim g_szValues		'읽어들인세팅값
dim g_szLinkNames		'링크이름들
dim g_nTotalSize
dim g_szOrgList		'전체리스트순서및값
dim g_nInitTopSize	'맨위 사이즈 - 20210303 HSZ 배너추가
dim g_LoginType

dim g_szChangeList	'HOME편집기능 사용여부
dim gOsType	

'파일에 저장된 KEY값
g_szKeys		=	Array(	"50010_INDEX", "50010_NEWS", "50010_BANNER", "50010_MYNEWS", 
						"50010_RANKING"  , "50010_MARKET", "50010_SECTOR", "50010_INDUSTRY", "50010_REPORT", "50010_NOTICE", "50010_LINK" )
						
'실제 링크폼명
g_szLinkNames 	=	Array(	"cont01.linkfm0",	"cont01.linkfm1",	"cont01.linkfm2",  "cont01.linkfm3",	"cont01.linkfm4",
							"cont01.linkfm5", "cont01.linkfm6", "cont01.linkfm7", "cont01.linkfm8", "cont01.linkfm9", "cont01.linkfm10" )

g_szInputFile	= "50010ITEMS.ini"
	

dim g_nNameCol, g_nTopCol, g_nHeightCol, g_sValCol, g_sKeyCol
g_nNameCol 	= 0 '테이블 내 linkform 이름
g_nTopCol 	= 1 '테이블 내 Top Value
g_nHeightCol	= 2 '테이블 내 Height Value
g_nValCol 	= 3 '테이블 내 Visible Value
g_nKeyCol	= 4 '테이블 내 key Value

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'============================================================================
'reassignItems:	 변경된 값으로 재 할당
'============================================================================
Function	reassignItems(inList)

	dim szRefreshKeys()
	dim nListCnt
	
	dim nTopval		'Top 값
	dim nPreHeight	'전아이템의 높이값
	dim nInterSize 	'중간 사이즈
	dim nItemIdx		'삽입될아이템순서

	nTopval 	   	= 0
	nInterSize   	= 0
	szItemIdx  	= 0 
	nPreHeight		= 0
	
	nListCnt	= getListItem(inList,0)		'리턴값으로 처리

	For i = 0 to nListCnt -1 
		szRefreshKeys(i)	=	getListItem(inList,(i*2)+1)
	next
	
	'1. TOP 값 초기화 
	For i = 0 to UBound(g_szKeys)
		cont01.Table1.SetCellString(i+1, 1, -1)
	Next 
	
	'2. '재정렬된 값중에서 해당하는 값만 세팅							
	For i = 0 to nListCnt -1 
		For	j = 0 to UBound(g_szKeys)					
			if	szRefreshKeys(i)	=	g_szKeys (j)	then
			
				if szItemIdx = 0	then								'첫 아이템 Init
					nTopval = g_nInitTopSize
					nPreHeight = cont01.Table1.GetCellString(j+1, 2)
				elseif szItemIdx = 1	then
					nTopval = nTopval + nPreHeight + 4					
				else 
					nTopval = nTopval + nPreHeight + nInterSize			'Top 값 계산
				end if 
						
				cont01.Table1.SetCellString(j+1, 1, nTopval)
				szItemIdx = szItemIdx + 1 								'아이템 카운트 증가
						
				nPreHeight = cont01.Table1.GetCellString(j+1, 2)
				
			end if 
		next
	next

end function


'============================================================================
'해당하는 값의 아이템을 리턴
'============================================================================
Function getListItem(szInput, nIdx)
	dim szList
	
	if szInput = "" then
		return 
	else
		szList = split(szInput, "★")
		if szList <> "" then
			return szList(nIdx)
		else
			return
		end if 
	end if 
	
end function


'============================================================================
'LoadSettings() : 파일에서 세팅값을 읽어들여서 화면 세팅
'============================================================================
Function LoadSettings()
	dim nInterSize 		'중간 사이즈
	dim nItemIdx			'삽입될아이템순서
	dim nTopval			'Top 값
	dim nPreHeight		'전아이템의 높이값
	dim nOnOff			'사용여부

	nInterSize   	= 5
	nInterSize   	= 0
	szItemIdx  	= 0 
	nTopval 	   	= 0
	nPreHeight	= 0
	
	dim szLoadData
	dim szRefreshKeys()
	

	szLoadData = Form.LoadConfigData(g_szInputFile, "50010_LISTITEMS")
	
	'LOAD 데이터가 없을 경우 초기 값 SET
	if szLoadData == "" or szLoadData == null then
		Dim nKeyCount
		nKeyCount = UBound(g_szKeys) - LBound(g_szKeys) + 1
		szLoadData = nKeyCount 
		
		for i = 0 to  nKeyCount - 1
			dim sKeys, sValue
			sKeys = g_szKeys(i)
			sValue = "1"
			szLoadData = szLoadData & "★" & sKeys & "★" & sValue
		next
		
		Form.SaveConfigData(g_szInputFile, "50010_LISTITEMS", szLoadData)	'202302 HSZ
	end if
	
	nListCnt	= getListItem(szLoadData,0)	'리턴값으로 처리
	
	'Table에 Data SET
	dim nTableRow
	nTableRow = CInt(cont01.Table1.rowcount)
	
	'Table visible 값 초기화 
	For k = 0 to nTableRow - 1
		cont01.Table1.SetCellString(k+1, g_nValCol, 0 ) 'Visible 초기화
	Next 
	
	if szLoadData <> "" and szLoadData <> null then
		For i = 0 to nListCnt -1
			Dim szTempData
			szTempData = getListItem(szLoadData,(i*2)+1)
			
			if szTempData <> "" then
				szRefreshKeys(i) = szTempData
				
				for j=0 to nTableRow - 1 
					dim szTableKey
					szTableKey = cont01.Table1.GetCellString( j, g_nKeyCol )
					
					if szTempData == szTableKey then
						cont01.Table1.SetCellString( j, g_nValCol, "1" )
					end if
				next
			end if
			
		Next
	end if
	
	
	Dim nTableRow
	nTableRow = CInt(cont01.Table1.rowcount)
	
	'Table Top 값 초기화 
	For k = 0 to nTableRow - 1
		cont01.Table1.SetCellString(k+1, g_nTopCol, -1) 'Top 초기화
	Next 
	
	For i = 0 to nListCnt -1
		For	j = 0 to nTableRow-1
			dim szTableKey
			szTableKey = cont01.Table1.GetCellString( j, g_nKeyCol )
			
			'테이블 키 값과 비교 후 높이 SET
			if szRefreshKeys(i) ==  szTableKey then
				cont01.Table1.SetCellString(j, 1, nPreHeight )
				nPreHeight = nPreHeight + CInt(cont01.Table1.GetCellString(j, g_nHeightCol)) + nInterSize
			end if
		next
	next
	
'TEST 출력용 
'	For j = 0 to UBound(g_szKeys)
'		Form.ShowAlert("output22",g_szKeys(j) & "=" & g_szValues(j)  & ",," & j )
'	Next

End Function

'============================================================================
'DisplaySettings() : 가져온 값으로 화면 아이템리스트 세팅 
'============================================================================
'20221228 SWJ START : 배너 게시할 건이 없어서 우선 삭제
'컨트롤에서 배너 높이 79 였는데 0으로 변경 (스크립트에서 고친건 없고 수치 기록용으로 주석 남김)
'============================================================================
Function DisplaySettings()
	'20211005 아이티젠(김성수) START
	'시장종합 개편 추가
	dim nTopValue
	dim nEditBtnTop
	
	nEditBtnTop 	= 0 '편집 버튼 위치
	
	Dim nTableRow
	nTableRow = CInt(cont01.Table1.rowcount)
	
	for i = 0  to nTableRow - 2 '헤더 행 제외
		nTopValue = CInt(cont01.Table1.GetCellString(i+1, g_nTopCol))
		
		dim szLinkFormNm, sVisible
		szLinkFormNm 	= "cont01." & cont01.Table1.GetCellString(i+1, g_nNameCol)
		sVisible 	= cont01.Table1.GetCellString(i+1, g_nValCol )
		
		if sVisible == "1" then
			Form.SetCtlProp( szLinkFormNm, "visible"	, true 	)
			Form.SetCtlProp( szLinkFormNm, "top"		, nTopValue 	)
			
			if nTopValue >= nEditBtnTop then
				dim nHeight
				nHeight = CInt(cont01.Table1.GetCellString(i+1, g_nHeightCol ))
				nEditBtnTop = nTopValue + nHeight
			end if

		else
			Form.SetCtlProp(szLinkFormNm, "visible"	, false	)
			Form.SetCtlProp(szLinkFormNm, "enable"	, false	)
			Form.SetCtlProp(szLinkFormNm, "top"		, 0		)
			'빈공간 처리해야함
		end if
	next 
	
	if nEditBtnTop > 0 then
		cont01.cont02.top = nEditBtnTop
	end if
	
	'20211005 아이티젠(김성수) END
	
'	ASIS 스크롤 위치 세팅 위치
	cont01.SetScrollAutoSize()

End Function
'============================================================================
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	cont01.gesture = true
	cont01.SetUseScrollingEvent(true)
	
	'20210916 SWJ START : 앱 재설치 시 config파일이 안생기는 케이스 방어로직
	'메인쪽에서 config파일명 뒤에 userid를 매칭해서 파일명에 append해서 생기는 문제

	Form.SetSharedData("&LoginProcess_RollBack" , "Y")		'20230227 HSZ : 로그인 후 메인에서 띄우는 팝업 딜레이
	gOsType = Form.GetSharedData("&OS_TYPE", false)
	
	g_szOrgList = Form.LoadConfigData(g_szInputFile, "50010_LISTITEMS")
	
	g_szChangeList = Form.LoadConfigData(g_szInputFile, "50010_CHANGE")
	if g_szChangeList = "1" then
		f_SettingLinkFile()
	else
		f_ScrollingLinkFile()
	end if

	if len(trim(g_szOrgList))	<=	2 then '초기 값 설정
'		'전체 아이템 세팅
		for i = 0 to CInt(cont01.Table1.rowcount)-2
			Form.SaveConfigData(g_szInputFile, g_szKeys(i), "1")
		next
		
	end if 
	
	call LoadSettings()
	call DisplaySettings()

	'202302 HSZ START
	if gOsType == "1" then	'안드로이드만 스크롤보임 후 숨김처리
		cont01.setScrollBarVisible("2")
	else	'20230721 HSZ - ohhts_intr_007r서비스 I/O 변경에 따른 iOS에러 방지로직 추가
		szCategory = Form.GetEnvData("common.curtouch_swing")
		
		if szCategory == "1" or szCategory == "" then
			Form.SetEnvData(1, "common.curtouch_swing", "0")
			Form.ACRSetProp( "category" , "H0" )	
		end if
	end if
	'202302 HSZ END
	
	szTextSize = Form.GetEnvData("common.textsize")
	
	if CInt(szTextSize) > 0 then '큰글씨
		cont01.cont02.btnEdit01.width = 140
	end if
	
'	f_SettingLinkFile()
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName = "REFRESH_MAIN" then	
		'1. 세팅된값으로 저장 값 리로드
		call LoadSettings()
		
		'2. 세팅된값 재표시
		call DisplaySettings()

	elseif sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else
			Form.triggerEvent("linkfmHoga", "sharedata", "")
		End If
	end if 
End Sub

'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if	sEventName	=	"SCREEN_MENU"		then
			
		if	trim(sParam)	==	"MARKET_SET"	then
			Form.OpenFramePopup("mhidx41000_p1" , sOpenData , sPosInfo)
		end	if
		if	trim(sParam)	==	"MARKET_ADD"	then
			Form.OpenFramePopup("mhidx41000_p2" , sOpenData , sPosInfo)
		end	if
		
		If sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns1" , "0", "")
		End If
		
	elseif sEventName = "HOME_SCROLL" then	'스크롤 위치 세팅
		nScrollPos = CInt(Form.GetSharedData("HOME_SCROLL", false ))

		szDeviceOS = Form.GetSharedData("&OS_TYPE", false)
		if Trim(nScrollPos) <> "" then
			cont01.uniSetScroll("0", nScrollPos)
		else
			cont01.scroll_pos = "top"
		end if
		
	elseif sEventName = "NOTICE_HIDE" then	'공지사항 티커 조회오류 시
		linkNotice.visible = false
		cont01.setAutoVisible(false, "linkNotice")	'숨김처리
		
	elseif sEventName = "NOTICE_SHOW" then	'공지사항 티커 조회정상 시
		linkNotice.visible = true
		cont01.setAutoVisible(true, "linkNotice")	'보임처리
	end if
	
End Sub


'============================================================================
'Form_OnLinkData
'============================================================================
Sub Form_OnLinkData(sKey, sValue)

	if	sKey	=	"&LOGIN"	then				'로그인전에는 실시간 못던지는 문제때문에 추가
		if	sValue	=	"login"	then

			Form_OnFormInit()
		end	if
	end	if
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	cont01.cont02.imgSetting.setMaintainingRatio("1")	'202302 HSZ
	cont01.icnSearch.setMaintainingRatio("1")		'202302 HSZ
	
	'------------------------------------------------------------------
	' 20190814 HWG START : MTS 위변조체크로직 추가
	'------------------------------------------------------------------
	'MTS 위변조방지 스킵 대응
	szOsType 	= Form.GetSharedData("&OS_TYPE", False) '1.안드로이드 2.iOS
	szDev 		= Form.GetSharedData("&SERVER_MODE", False)
	szAppVer 	= Form.GetSharedData("&APP_VERSION_CODE", False)
	szPrivateKey	= "vjdDoV5kQc7lNK4VARxk0TSWA4k=\n"
	
	if szDev <> "1" and szOsType == "1" and Cint(szAppVer) > 39 then
		szKeyValue = Form.GetSharedData("&KEY_VALUE", False)
		if trim(szPrivateKey) <> trim(szKeyValue) then
			
			'20180912_01 KBC START : 모의해킹결과조치
			if Cint(szAppVer) > 44 then
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.SetSharedData("&SGB" , "BBE") 
				
				Form.sendItemPrice()			'App 종료API 추가 (네이밍무관)
				Form.sendMessage()			'App 종료API 추가 (네이밍무관)
				Form.TerminateApp()
				
			else 
				Form.Toast(0,"위변조된 앱 입니다. 앱을 재설치 하시기 바랍니다.", 1)
				Form.TerminateApp()
			end if

			'20180912_01 KBC END
			exit sub
		end if
	end if
	
	Form.SetSharedData("&CODE_DUPR_USE" , "YES")	'20191022 HWG : 해외파생 중복실행 차단

	g_nInitTopSize = 107

End Sub

'============================================================================
'20210916 SWJ START : 시장종합 화면 개편
'============================================================================

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
	if sDlgName = "SEARCH" then
		if sReturn1 <> "" or sRturn1 <> null then
			g_szItemCode = sReturn1
			g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market")

			Form.OpenScreen("11000",sReturn1,"")
		end if
	end	if	
End Sub

