'============================================================================
'	f_SettingLinkFile() : 링크폼에 맵파일 세팅 - 20230208 HSZ
'============================================================================
Function f_SettingLinkFile()
	cont01.linkfm0.linkfile = "mhidx50010_s1"
	cont01.linkfm1.linkfile = "mhidx50010_s2"
	cont01.linkfm2.linkfile = "mhidx50010_s3"
	cont01.linkfm3.linkfile = "mhidx50010_s4"
	cont01.linkfm4.linkfile = "mhidx50010_s5"
	cont01.linkfm5.linkfile = "mhidx50010_s6"
	cont01.linkfm6.linkfile = "mhidx50010_s7"
	cont01.linkfm7.linkfile = "mhidx50010_s8"
	cont01.linkfm8.linkfile = "mhidx50010_s9"
	cont01.linkfm9.linkfile = "mhidx50010_s10"
	cont01.linkfm10.linkfile = "mhidx50010_s11"
	
	linkNotice.linkfile = "mhidx50010_s12"
	
End Function 
'============================================================================
'	f_ScrollingLinkFile() : 링크폼에 맵파일 세팅
'	수정이력 없는 경우 -> 스크롤 위치에 따라
'============================================================================
Function f_ScrollingLinkFile()
	cont01.linkfm0.linkfile = "mhidx50010_s1"
	cont01.linkfm1.linkfile = "mhidx50010_s2"
	cont01.linkfm2.linkfile = "mhidx50010_s3"
	linkNotice.linkfile = "mhidx50010_s12"
	cont01.linkfm3.linkfile = "mhidx50010_s4"
	
	'영역별 스크롤 위치값 세팅 - 안드
	if gOsType == "1" then
		szTop = cont01.Table1.GetCellString(1, 1)
		
		nFirstAreaScrollPosNoti 	= 0
		nSecondAreaScrollPosNoti 	= CInt(Form.calcUnResize(szTop , "1")) - 10
		
		cont01.SetNotifyScrollPos(nFirstAreaScrollPosNoti..":".. nSecondAreaScrollPosNoti)
	else
	' 한번에 다 세팅 - iOS (스크롤 중일 때 서비스 조회 안하는 로직 메인에 있음)
		cont01.linkfm4.linkfile = "mhidx50010_s5"
		cont01.linkfm5.linkfile = "mhidx50010_s6"
		cont01.linkfm6.linkfile = "mhidx50010_s7"
		cont01.linkfm7.linkfile = "mhidx50010_s8"
		cont01.linkfm8.linkfile = "mhidx50010_s9"
		cont01.linkfm9.linkfile = "mhidx50010_s10"
		cont01.linkfm10.linkfile = "mhidx50010_s11"
	end if

End Function 
'============================================================================
Sub cont01_OnNotifyScrolling(nIndex)
	if nIndex == 1 then

		cont01.linkfm4.linkfile = "mhidx50010_s5"
		cont01.linkfm5.linkfile = "mhidx50010_s6"
		cont01.linkfm6.linkfile = "mhidx50010_s7"
		cont01.linkfm7.linkfile = "mhidx50010_s8"
		cont01.linkfm8.linkfile = "mhidx50010_s9"
		cont01.linkfm9.linkfile = "mhidx50010_s10"
		cont01.linkfm10.linkfile = "mhidx50010_s11"
		
		cont01.SetNotifyScrollPos("")
	end if

End Sub


'============================================================================
Sub Form_OnFormClose()
	'스크롤 위치 저장
	szPos = cont01.uniGetScroll()
	Form.SetSharedData("HOME_SCROLL" , szPos)
	
End Sub

