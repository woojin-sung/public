'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

' 등록일자/지정일/이체기간/출금계좌/입금은행/입금계좌/입금자명/출금금액/내통장표시/받는분통장표시/은행코드/신청구분코드/신청일련번호/조회구분코드/비밀번호
Dim g_sRegDate, g_sDay, g_sFromYM, g_sToYM, g_sACNO, g_sBANKNM, g_sBANKACNO, g_sBANKACNONM, g_sAMT, g_sText1, g_sText2, g_sBANKCODE, g_sGUBUN, g_sSRNO, g_sIQRYcode, g_szAccountPassword
Dim g_szCertUserType
	

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

Function TR_Inquiry(szTranID)
	if szTranID == "obcsb_oimf_625r" THEN		'보안매체확인
		Dim sDeviceID, sACNO, sACNO_PWD
		
		sDeviceID = Form.GetDeviceID()
		sACNO = g_sACNO
		sACNO_PWD = g_szAccountPassword
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PROS_CLS_CODE" , 0 , "5" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "REG_CLCD" , 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "DRNG_ACNO" , 0 , sACNO )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "PWD" , 0 , sACNO_PWD )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_BANK_CODE" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "MNRC_ACNO" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "TACT_AMT" , 0 , "" )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_625r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , sDeviceID )
		DATAMANAGER.RequestTranData("obcsb_oimf_625r")
	end if
	
	if szTranID == "obtss_igrs_683c" then	'등록
		DATAMANAGER.SetEventFlag( "obtss_igrs_683c", "D" )
		
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock2", "DRNG_TRGT_ACNO", 0 , g_sACNO)	'출금계좌번호
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock2", "RCVN_EXIN_CODE", 0 , g_sBANKCODE)	'은행코드
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock2", "RCVN_ACNO", 0 , g_sBANKACNO)	'수취계좌번호
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock2", "TMPY_DAY", 0 , g_sDay)	'납기일
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock2", "AMT", 0 , g_sAMT)	'금액
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock2", "PWD" , 0 , g_szAccountPassword)	'비밀번호
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock2", "ATMT_TACT_APLT_CLS_CODE", 0 , g_sGUBUN)	'자동이체신청구분코드
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock2", "IQRY_CLS_CODE", 0 , g_sIQRYcode)	'조회구분코드
		DATAMANAGER.SetDataValue(0,  "obtss_igrs_683c", "InBlock2", "APLT_SRNO", 0 , g_sSRNO)	'신청일련번호
	
		DATAMANAGER.RequestTranData("obtss_igrs_683c")
	'수정전 	
	elseif szTranID == "obpds_srvc_035a" then	'당사 등록
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "PROS_CLS_CODE", 0 , "D")	'처리구분코드	
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "CSNO", 0 , "")	'고객번호	
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "SVCD", 0 , "013")	'서비스 코드
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "SVC_SRNO", 0 , g_sSRNO)	'서비스 일련번호
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "SVC_MANG_UNIT_CODE", 0 , "03")	'상품단위
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "ACNO", 0, Mid(g_sACNO,1,8) )	'계좌번호	
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "ASNO", 0 , Mid(g_sACNO,9,2) )	'일련번호	
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "ACNT_PWD", 0 , g_szAccountPassword)	'비밀번호
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "TACT_ACNT_CLS_CODE", 0 , "1")	'이체구분코드	
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "TACT_SCRT_ACNO", 0 , Mid(g_sBANKACNO,1,8))	'이체증권계좌번호	
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "TACT_SCRT_ASNO", 0 , Mid(g_sBANKACNO,9.2))	'이체증권계좌일련번호
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "TACT_AMT", 0 , g_sAMT)	'이체금액
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "TACT_HOPE_DAY_CODE", 0 ,g_sDay)	'이체희망일코드
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "NXET_TIMS_ATMT_APLT_YN", 0 , "N")	'다음회차자동신청여부
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "TACT_STA_DATE", 0 , "")	
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "TACT_FIN_DATE", 0 , "")			
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "MNRC_ACNT_BNKB_EXRS_CNTT", 0 , "")	'받는분통장표시
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "DRNG_ACNT_BNKB_EXRS_CNTT", 0 , "")	'내통장표시
		DATAMANAGER.SetDataValue(0,  "obpds_srvc_035a", "InBlock1", "CONT_CLS_CODE", 0 , "4")	'온라인
		
		DATAMANAGER.RequestTranData("obpds_srvc_035a")		
	end if

End Function

