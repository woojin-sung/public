' btnCancel_OnClick - 취소
'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
' btnEnroll_OnClick - 등록
'============================================================================
Sub btnEnroll_OnClick()
	'확인정보로 등록
	'추가인증-> 보안매체-> 공인인증 순으로 처리 후 완료되었다는 메세지 띄우고 종료
	
'	Form.SetSharedData("BANK_ACNONM" , g_sBANKACNONM)
'	Form.SetSharedData("BANK_AMT" , g_sAMT)
'	Form.SetSharedData("BANK_FROMYM" , g_sFromYM..g_sDay)
'	Form.SetSharedData("BANK_TOYM" , g_sToYM..g_sDay)
	
'	Form.OpenFramePopup("mhetc90060_p8" , "bank_monthlyD" , "")
	TR_Inquiry("obcsb_oimf_625r")
End Sub



'============================================================================
' Form_OnPopupReturn 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p8" then	'추가인증 
		if sRet == "ok" then	'추가인증성공
			TR_Inquiry("obcsb_oimf_625r")
		else
			exit sub
		end if
	end if
	
	if sKeyName == "mhetc90060_p9" then	'보안카드(보안매체1)
		if sRet == "ok" then			'성공
			if g_szCertUserType == "1" Then
				Form.OpenFramePopup("mhetc90060_px" , "" , "")
			else
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
			end if
		else 					'실패
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_pa" then	'부가정보인증
		if sRet == "ok" then			'성공
			Form.OpenFramePopup("mhetc90060_p5" , "" , "")
		else 					'실패
			exit sub
		end if
	end if
	
	if sKeyName == "mhetc90060_pb" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
			if g_szCertUserType == "1" Then
				Form.OpenFramePopup("mhetc90060_px" , "" , "")
			else
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
			end if
		else						'실패		
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_motp" then	'mOTP v003
		if sRet == "ok" then			'성공
			if g_szCertUserType == "1" Then
				Form.OpenFramePopup("mhetc90060_px" , "" , "")
			else
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
			end if
		else						'실패		
			exit sub
		end if	
	end if	
	
	if sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			if g_sBANKNM == "메리츠증권" then
			     TR_Inquiry("obpds_srvc_035a")
			else
				TR_Inquiry("obtss_igrs_683c")
			end if
		else						'실패
			exit sub
		end if
		
	end if
	
	If sKeyName == "mhetc90060_px" Then
		If sRet == "ok" Then
			if g_sBANKNM == "메리츠증권" then
			     TR_Inquiry("obpds_srvc_035a")
			else
				TR_Inquiry("obtss_igrs_683c")
			end if
		ElseIf sRet == "cancel" Then
			'Form.ShowAlert("알림", "간편인증 실패.")
		End If
	End If
	
	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
'	if sKeyName == "mhetc90190_p1" then										
'		'if sRet == "ok" then									
'		'end if
'	end if 	
End Sub


'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szData, szList
	
	g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
	szData = Form.GetOpenLinkData()
	
	szList = Split(szData, "★")
	
	if UBOUND(szList) < 1 THEN
		EXIT SUB
	END IF
	
'	Form.ShowAlert("szData", szData)

	' 등록일자/지정일/이체기간/출금계좌/입금은행/입금계좌/입금자명/출금금액/받는분통장표시/내통장표시/은행코드/신청구분코드/신청일련번호/조회구분코드/비밀번호
	g_sRegDate = szList(0)
	g_sDay = szList(1)
	g_sFromYM = szList(2)
	g_sToYM = szList(3)
	g_sACNO = szList(4)
	g_sBANKNM = szList(5)
	g_sBANKACNO = szList(6)
	g_sBANKACNONM = szList(7)
	g_sAMT = szList(8)
	g_sText1 = szList(9)
	g_sText2 = szList(10)
	g_sBANKCODE = szList(11)
	g_sGUBUN = szList(12)
	g_sSRNO = szList(13)
	g_sIQRYcode = szList(14)
	g_szAccountPassword = szList(15)

	Table0.SetCellString( 0, 1, g_sRegDate )	
	Table0.SetCellString( 1, 1, g_sDay )	
	Table0.SetCellString( 2, 1, Left(g_sFromYM, 4).."/"..Mid(g_sFromYM, 5, 2) & " ~ " & Left(g_sToYM, 4).."/"..Mid(g_sToYM, 5, 2))	
	Table0.SetCellString( 3, 1, g_sACNO)	
	Table0.SetCellString( 4, 1, g_sBANKNM & "/" & g_sBANKACNO)	
	Table0.SetCellString( 5, 1, g_sBANKACNONM )	
	Table0.SetCellString( 6, 1, g_sAMT )	
	Table0.SetCellString( 7, 1, g_sText2 )	
	Table0.SetCellString( 8, 1, g_sText1 )	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_625r" then
		Dim sSPLM_ATHN_NCSR_YN, g_sGubunCode
		sSPLM_ATHN_NCSR_YN = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock1", "SPLM_ATHN_NCSR_YN" , 0 )
		g_sGubunCode = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_625r", "OutBlock2", "SCRC_OTP_CLS_CODE" , 0 )
		
		'보안매체구분코드 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		Select Case g_sGubunCode
			Case "0"
				Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
			Case "1"
				'16-04-19 YCJ 이체 화면들 부가정보시 이체안된다는 안내팝업 이후 이체 정보 Clear
'				Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
				Form.ShowAlert( "알림", "부가정보만 존재할경우 처리가 불가능합니다.")
				Form.SendReturnToParent("mbbnk61040_p4" , "ok")
				Form.CloseForm( )
			Case "2"	
				'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 사고등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
				RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
			Case "3"
				Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
			Case "4" 'v003
				Form.OpenPopup( "mhetc90060_motp" , "motp_success" , "" ) '모바일OTP
			Case "9"
				Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
		End Select
	end if
	
	
	if szTranID == "obtss_igrs_683c" then	'해지성공
		Form.MsgBox("알림", "자동이체가 정상적으로 해지 되었습니다.", "", 0)
		Form.SendReturnToParent("mbbnk61040_p4" , "ok")
		Form.CloseForm()
	end if
	
	if szTranID == "obpds_srvc_035a" then	'해지성공
		Form.MsgBox("알림", "자동이체가 정상적으로 해지 되었습니다.", "", 0)
		Form.SendReturnToParent("mbbnk61040_p4" , "ok")
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtss_igrs_683c" then	
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		if sSubMsg <> null and Trim(sSubMsg) <> "" then
			szErrMsg = szErrMsg & " " & sSubMsg
		end if
		Form.MsgBox("알림", szErrMsg, "", 0)
		Form.CloseForm()
	end if
	
	if szTranID == "obpds_srvc_035a" then	
		sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
		if sSubMsg <> null and Trim(sSubMsg) <> "" then
			szErrMsg = szErrMsg & " " & sSubMsg
		end if
		Form.MsgBox("알림", szErrMsg, "", 0)
		Form.CloseForm()
	end if	
End Sub

