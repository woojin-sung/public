'============================================================================
Dim g_Phone

Sub Table0_OnClick(lRow , lColumn)
	if lColumn == 2 then
		Form.SendCall( g_Phone )
	end if
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim sTitle, sAddres, sPhone, sGps_lat,sGps_Lon
	sData = Form.GetOpenLinkData( )
	if sData == "0" then
		sTitle = "본점"
		sAddres = " 서울시 영등포구 국제금융로6길 15 2층"
		sTelphone = "02) 6309-4700"
		sGps_lat = "37.5220963"
		sGps_Lon = "126.9284835"
		g_Phone = "0263094700" 
	elseif sData == "1" then
		sTitle = "서울 강남금융센터"
		sAddres = "서울시 강남구 삼성동 테헤란로 407, EK타워 6,7,8,9층"
		sTelphone = "02) 6286-6611"
		sGps_lat = "37.505286"
		sGps_Lon = "127.0501238"
		g_Phone = "0262866611"
	elseif sData == "2" then
