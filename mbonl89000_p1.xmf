		sTelphone = "053) 605-6611"
		sGps_lat = "35.8600369"
		sGps_Lon = "128.6271784"
		g_Phone = "0536056611"
	elseif sData == "4" then
		sTitle = "부산 금융센터"
		sAddres = "부산시 부산진구 서전로 8 현대캐피탈빌딩 11,12층"
		sTelphone = "051) 604-6611"
		sGps_lat = "35.157515"
		sGps_Lon = "129.060444"
		g_Phone = "0516046611"
	elseif sData == "5" then
		sTitle = "영업부금융센터" '20180204 KBC
		sAddres = "서울시 영등포구 국제금융로10, Three IFC 2, 22층" '20180204 KBC
		sTelphone = "02) 6454-6611" ' 20180205 HAMWG : 영업부 전화번호 변경
		sGps_lat = "37.525077"
		sGps_Lon = "126.926014"
		g_Phone = "0264546611" ' 20180205 HAMWG : 영업부 전화번호 변경
	elseif sData == "6" then
		sTitle = "서울 도곡금융센터"
		sAddres = "서울시 강남구 도곡동 언주로30길 39 린스퀘어 9층" '20200709 SWJ : 건물명 변경
		sTelphone = "02) 6007-6611"
		sGps_lat = "37.4888138"
		sGps_Lon = "127.0532538"
		g_Phone = "0260076611"
	end if
	
	Table0.SetCellString( 0, 0, sTitle )
	Table0.SetCellString( 1, 0, sAddres )
	Table0.SetCellString( 2, 0, sTelphone )
	
	WebView0.urlpath = "http://www.google.co.kr/maps/place/" & sGps_lat & "," & sGps_Lon
End Sub
