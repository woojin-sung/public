<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="70180" scrname="상품비교_추가" version="2" writer="조승행" />
	<FORM_INFO name="Form" ly_vert="0,0,375,562,1" />
	<CONTROL_INFO>
		<FORMTAB name="FormTab0" tabcount="2" tabwidthtype="1" tabheadheight="36" ly_vert="4,5,362,554,1" >
			<PAGE name="page004398" caption="상품검색" linkfile="mbcpp70180_t1" />
			<PAGE name="page003638" caption="관심상품" linkfile="mbcpp70180_t2" />
		</FORMTAB>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="860" _ulen="860" >
--===========================================================================
--===========================================================================
Dim sprCode
'============================================================================


Sub Form_OnFormInit()
	sprCode = 0
End Sub
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	
	if sKey == "closelink" then
		if sValue == "donefav" then
			sprCode = 1
			Form.CloseForm( )
	
		elseif sValue == "doneadd" then
			sprCode = 2
			Form.CloseForm( )
	
		end if
	end if

End Sub



'============================================================================

'============================================================================
Sub Form_OnFormClose()
	
	Form.SendReturnToParent("A",  sprCode) 
	
	
End Sub



	</SCRIPT_INFO>
</ROOT>