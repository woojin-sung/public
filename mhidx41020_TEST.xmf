'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData("ohhts_1171_001r")
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim iIdx			
	dim iIdxMarket	'코스피 코스닥 KRX100
	dim iTimeSect		'장시작전, 장마감
	dim szIscd		'업종코드 
	
	DATAMANAGER.CancelRealData("ohhts_nmix_antg")
	DATAMANAGER.CancelRealData("ohhts_up_rsfl")
	
	iIdx = rdoTime00.currentindex 
	iIdxMarket = rdoMrkt.currentindex
	
	if iIdx = "0" then	'장시작전
		iTimeSect = 1
	else					'장마감
		iTimeSect = 2
	end if 
	

	if iIdxMarket = "0" then			'코스피
		szIscd = "0001"
	elseif iIdxMarket = "1"	then			'코스닥
		szIscd = "1001"
	elseif iIdxMarket = "2"	then			'KRX100
		szIscd = "3043"
	else
		Form.ShowAlert("알림", "잘못된 시장 코드값입니다.")
	end if 	
		
	if szTranID = "ohhts_1171_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_1171_001r", "InBlock2", "FID_INPUT_MKOP_CLS_CODE", 0, iTimeSect)
		DATAMANAGER.SetDataValue(0, "ohhts_1171_001r", "InBlock2", "FID_INPUT_ISCD", 0, szIscd)
	end if 
	
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim ncnt1171
	dim szRealCode
	
	ncnt1171 = DATAMANAGER.GetDataCount(0, "ohhts_1171_001r" , "OutBlock1")
	
	if szTranID = "ohhts_1171_001r" then
	
		for i = 0 to ncnt1171 - 1
			szRealCode = DATAMANAGER.GetDataValue(0, "ohhts_1171_001r", "OutBlock1", "FID_SHRN_ISCD", i)
			DATAMANAGER.SetDataValue(1, "ohhts_nmix_antg", "InBlock1", "FIDR_BSTP_CLS_CODE", i, szRealCode)
			DATAMANAGER.SetDataValue(1, "ohhts_up_rsfl", "InBlock1", "FIDR_BSTP_CLS_CODE", i, szRealCode)
		next
		
		DATAMANAGER.RequestRealData("ohhts_nmix_antg")
		DATAMANAGER.RequestRealData("ohhts_up_rsfl")
	end if 

End Sub


