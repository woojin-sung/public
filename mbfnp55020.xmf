'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szType '1:다드림-원화RP 2:다드림-외화RP 3:기타-외화RP
Dim g_szCode '종목코드
Dim g_szBuySeq '매수일련번호
Dim g_szBuyDate '매수일자

Dim plain_rm
Dim g_szSavePwd
Dim gRpProdTypeCode
'============================================================================
'Form.OpenFramePopup("mbfnp55020" , "", "")
'****************************************************************************
'					F O R M	F U N C T I O N
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	ImgPrcreset.SetMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("외화RP매도")
	
	Dim szData, arrData
	 
	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"☆")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if
	
	acnt0.caption = arrData(0)
	
	g_szType = arrData(1) ' 원화외화구분
	g_szCode = arrData(2)
	g_szBuySeq = arrData(3)
	g_szBuyDate = arrData(4)
	
	Form.triggerEvent( "LinkForm0", "INIT", g_szType) '키패드에 외화(2) 전송
	
	lblFold_OnClick()
	
	DATAMANAGER.RequestTranData( "obsat_deal_122r" ) '잔고내용 조회
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'키패드 클릭시
	if sEventName == "keypad_edit" then
		f_setPrice(sParam)
		
		if InStr(edtPrice.caption, ".") == Len(edtPrice.caption) then
			lblPrice.mask = "0,0,,. USD,0,,0,1,1,0,0"
		end if
	'전액 클릭시
	elseif sEventName == "keypad_all" then
		f_setPrice(Cdbl(lblAble.caption))
		Form.triggerEvent( "LinkForm0", "Able_Amt", Cdbl(lblAble.caption ))
		
	end if
	
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "ORDER_CONFIRM" then
		if sRet == "ok" then
			g_szSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			'계좌비밀번호사용여부 초기화(기본값 : 미사용)
			if Trim(g_szSavePwd) = "" then
				g_szSavePwd = "0"
			end if	
	
			if g_szSavePwd == "0" then
				Form.openPopupAnimation("pwdcheckpopup", acnt0.caption ,"","2")
			else
				f_RequestSell()
			end if
		end if
	end if
End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
				
				f_RequestSell()
			end if
		end if
		
	elseif sKeyName = "RP_MAEDO_COMPLETE" then
		Form.SendReturnToParent( "RP_MAEDO_COMPLETE" , "" )
		Form.CloseForm()
	
	end if
End Sub

'****************************************************************************
'				D A T A M A N A G E R	F U N C T I O N
'****************************************************************************
'============================================================================
Sub f_RequestSell()
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	DATAMANAGER.RequestTranData( "obsav_deal_203a" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szDate
	szDate = Form.GetSharedData("&HOST_DATE", false )
		
	'잔고 조회
	if szTranID == "obsat_deal_122r" then
	
		DATAMANAGER.ClearInputData(0, "obsat_deal_122r")
		DATAMANAGER.SetDataValue( 0 , "obsat_deal_122r", "InBlock1", "ACNO" , 0 , acnt0.total )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obsat_deal_122r", "InBlock1", "ASNO" , 0 , acnt0.sequence )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obsat_deal_122r", "InBlock1", "ISCD" , 0 , g_szCode )	'종목코드
		DATAMANAGER.SetDataValue( 0 , "obsat_deal_122r", "InBlock1", "BYOV_DATE" , 0 , g_szBuyDate )	'매수일자
		DATAMANAGER.SetDataValue( 0 , "obsat_deal_122r", "InBlock1", "BYOV_SRNO" , 0 , g_szBuySeq )	'매수일련번호
		
	'매도주문
	elseif szTranID == "obsav_deal_203a" then
		DATAMANAGER.ClearInputData(0, "obsav_deal_203a")
		DATAMANAGER.SetDataValue( 0 , "obsav_deal_203a", "InBlock1", "ACNO" , 0 , acnt0.total )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obsav_deal_203a", "InBlock1", "ASNO" , 0 , acnt0.sequence )	'계좌번호
		
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obsav_deal_203a", "InBlock1", "ACNT_PWD"			, 0, edtPwd.caption)		' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue(0, "obsav_deal_203a", "InBlock1", "ACNT_PWD"			, 0, edtPwd.encdata)		' 계좌 비밀번호
		end if
		
		DATAMANAGER.SetDataValue( 0 , "obsav_deal_203a", "InBlock1", "CONT_CLS_CODE" , 0 , "4" )	'접촉구분코드
		DATAMANAGER.SetDataValue( 0 , "obsav_deal_203a", "InBlock1", "CRCD" , 0 , "USD" )	'통화코드
		DATAMANAGER.SetDataValue( 0 , "obsav_deal_203a", "InBlock1", "CALC_CLS_CODE" , 0 , "0" )	'계산구분코드
		DATAMANAGER.SetDataValue( 0 , "obsav_deal_203a", "InBlock1", "RP_DEAL_CLS_CODE" , 0 , "2" )	'매매구분코드
		'DATAMANAGER.SetDataValue( 0 , "obsav_deal_203a", "InBlock1", "ODER_DATE" , 0 , szDate )	'주문일자
		DATAMANAGER.SetDataValue( 0 , "obsav_deal_203a", "InBlock1", "ODER_GRP_NO" , 0 , "" )	'주문그룹번호
		
		DATAMANAGER.SetDataValue( 0 , "obsav_deal_203a", "InBlock2", "PROS_CLS_CODE" , 0 , "" )	'처리구분코드
		DATAMANAGER.SetDataValue( 0 , "obsav_deal_203a", "InBlock2", "ISCD" , 0 , g_szCode )	'종목코드
		
		Dim sBYOV_DATE
		sBYOV_DATE = DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "BYOV_DATE" , 0 )
		DATAMANAGER.SetDataValue( 0 , "obsav_deal_203a", "InBlock2", "BYOV_DATE" , 0 , sBYOV_DATE )	'매수일자
		
		Dim sBYOV_SRNO
		sBYOV_SRNO = DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "BYOV_SRNO" , 0 )
		DATAMANAGER.SetDataValue( 0 , "obsav_deal_203a", "InBlock2", "BYOV_SRNO" , 0 , sBYOV_SRNO )	'매수일련번호
		
		DATAMANAGER.SetDataValue( 0 , "obsav_deal_203a", "InBlock2", "FRCR_RPRC_PRNC" , 0 , edtPrice.caption )	'환매금액
		
		Dim sRP_PROD_TYPE_CODE
		sRP_PROD_TYPE_CODE = DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "RP_PROD_TYPE_CODE" , 0 )
		DATAMANAGER.SetDataValue( 0 , "obsav_deal_203a", "InBlock2", "RP_PROD_TYPE_CODE" , 0 , sRP_PROD_TYPE_CODE )	'RP상품유형코드
		
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'매도주문
	if szTranID == "obsav_deal_203a" then		
		Dim szToday,szEndDate,szData
		
		szToday = Form.GetSharedData("&HOST_DATE", false ) '매도일자(오늘)
		szEndDate = DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "MTRT_DATE" , 0 ) '만기일자
		
		if g_szType == "2" then '다드림 외화
			'매수정보
			szData = DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "KOR_ISNM" , 0 ) & "☆" ' 종목명 0
			szData = szData & Cdbl(DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "FRCR_MNRC_AMT" , 0 )) & "☆" ' 매입금액(외화입금금액) 1
			szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "RPRC_INRT" , 0 ) & "☆" ' 약정이율(환매이율) 2
			szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "BYOV_DATE" , 0 ) & "☆" ' 매수일자 3
			szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "MTRT_DATE" , 0 ) & "☆" ' 만기일자 4
		
			'매도정보
			if Cdbl(szToday) == Cdbl(szEndDate) then '매도일자 = 만기일자 : 만기이율
				szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "RPRC_INRT" , 0 ) & "☆" '적용이율(만기이율) 5
			elseif Cdbl(szToday) < Cdbl(szEndDate) then ' 매도일자 < 만기일자 : 중도매도이율
				szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "HLFW_RPRC_INRT" , 0 ) & "☆" '적용이율(중도매도이율) 5
			elseif Cdbl(szToday) > Cdbl(szEndDate) then ' 매도일자 > 만기일자 : 만기후적용이율
				szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "MTRT_AFT_APLY_INRT" , 0 ) & "☆" '적용이율(만기후적용이율) 5
			end if
			szData = szData & Cdbl(DATAMANAGER.GetDataValue( 0, "obsav_deal_203a", "OutBlock1", "FRCR_TR_AMT" , 0 )) & "☆" '매도신청금액(외화거래금액) 6
			szData = szData & Cdbl(DATAMANAGER.GetDataValue( 0, "obsav_deal_203a", "OutBlock1", "FRCR_INT_AMT" , 0 )) & "☆" '외화이자 7
			szData = szData & Cdbl(DATAMANAGER.GetDataValue( 0, "obsav_deal_203a", "OutBlock1", "TAX_SMTN_FRCR_AMT" , 0 )) & "☆" '외화세금합계 8
			szData = szData & Cdbl(DATAMANAGER.GetDataValue( 0, "obsav_deal_203a", "OutBlock1", "FRCR_EXCL_AMT" , 0 ))  & "☆" '정산금액 9
		
			szData = szData & acnt0.total & "☆" '계좌번호 10
			szData = szData & acnt0.sequence & "☆" '계좌일련번호 11
			
			Form.OpenPopup("mbfnp55020_p2", szData , "","2")
			
		elseif g_szType == "3" then '기타 외화
		
			'매수정보
			szData = DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "KOR_ISNM" , 0 ) & "☆" ' 종목명 0
			szData = szData & Cdbl(DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "FRCR_MNRC_AMT" , 0 )) & "☆" ' 매입금액(외화입금금액) 1
			szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "RPRC_INRT" , 0 ) & "☆" ' 약정이율(환매이율) 2
			szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "HLFW_RPRC_INRT" , 0 ) & "☆" ' 중도매도이율(중도환매이율) 2
			szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "BYOV_DATE" , 0 ) & "☆" ' 매수일자 3
			szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "MTRT_DATE" , 0 ) & "☆" ' 만기일자 4
		
			'매도정보
			if Cdbl(szToday) == Cdbl(szEndDate) then '매도일자 = 만기일자 : 만기이율
				szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "RPRC_INRT" , 0 ) & "☆" '적용이율(만기이율) 5
			elseif Cdbl(szToday) < Cdbl(szEndDate) then ' 매도일자 < 만기일자 : 중도매도이율
				szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "HLFW_RPRC_INRT" , 0 ) & "☆" '적용이율(중도매도이율) 5
			elseif Cdbl(szToday) > Cdbl(szEndDate) then ' 매도일자 > 만기일자 : 만기후적용이율
				szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "MTRT_AFT_APLY_INRT" , 0 ) & "☆" '적용이율(만기후적용이율) 5
			end if
			szData = szData & Cdbl(DATAMANAGER.GetDataValue( 0, "obsav_deal_203a", "OutBlock1", "FRCR_TR_AMT" , 0 )) & "☆" '매도신청금액(외화거래금액) 6
			szData = szData & Cdbl(DATAMANAGER.GetDataValue( 0, "obsav_deal_203a", "OutBlock1", "FRCR_INT_AMT" , 0 )) & "☆" '외화이자 7
			szData = szData & Cdbl(DATAMANAGER.GetDataValue( 0, "obsav_deal_203a", "OutBlock1", "TAX_SMTN_FRCR_AMT" , 0 )) & "☆" '외화세금합계 8
			szData = szData & Cdbl(DATAMANAGER.GetDataValue( 0, "obsav_deal_203a", "OutBlock1", "FRCR_EXCL_AMT" , 0 ))  & "☆"  '정산금액 9
			
			szData = szData & acnt0.total & "☆" '계좌번호 11
			szData = szData & acnt0.sequence & "☆" '계좌일련번호 12
		
			Form.OpenPopup("mbfnp55020_p5", szData , "","2")
			
		end if
	elseif szTranID == "obsat_deal_122r" then	
		gRpProdTypeCode = DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "RP_PROD_TYPE_CODE" , 0 )
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'Form.ShowAlert("알림", szErrMsg)
	
	If szTranID == "obsav_deal_203a" then
		If szErrCode == "2444" Then
			Form.openPopupAnimation("pwdcheckpopup", acnt0.caption ,"","2")
		elseIf szErrCode == "3380" Then
			Form.MsgBox("알림", "주문 가능 시간이 아닙니다.\n(가능시간 09:00~14:00)" , "", 8, "확인")
		Else
			Dim sMsg
			sMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		
			If TRIM(sMsg) == "매도가능잔고가 부족합니다." Then
				Form.MsgBox("알림", sMsg , "", 8, "확인")
				DATAMANAGER.RequestTranData( "obsat_deal_122r" ) '잔고내용 조회
			Else
				Form.MsgBox("알림", szErrMsg , "", 8, "확인")
			End If 
		End If
		
	End If
	
End Sub

'****************************************************************************
'				C O N T R O L	 F U N C T I O N
'****************************************************************************
'============================================================================
'예상금액조회 버튼
Sub btnVirtual_OnClick()
	if Cdbl(edtPrice.caption) < 0.01 then
		'Form.ShowAlert("알림", "매도금액 입력 후 예상금액을 조회해주세요.")
		Form.MsgBox("알림", "매도금액 입력 후 예상금액을 조회해주세요." , "", 8, "확인")
		Exit Sub
	end if
	
	if Cdbl(edtPrice.caption) > Cdbl(lblAble.caption) then
		Form.MsgBox("알림", "매도가능잔고를  초과하였습니다. 매도신청금액을 다시 입력해주세요.", "", 8, "확인")
		Exit Sub
	end if
	
	Dim szData

	szData = acnt0.total & "☆" '계좌번호8 0
	szData = szData & acnt0.sequence & "☆" '계좌번호2 1
	szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "RP_PROD_TYPE_CODE" , 0 ) & "☆" 'RP상품유형코드 2
	szData = szData & g_szCode & "☆" '종목코드 3
	szData = szData & edtPrice.caption & "☆" '매도신청금액 4
	szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "BYOV_DATE" , 0 ) & "☆" '매수일자 5
	szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "BYOV_SRNO" , 0 ) & "☆" '매수일련번호 6
	szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "MTRT_DATE" , 0 ) & "☆" '만기일자 7
	szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "RPRC_INRT" , 0 ) & "☆" '약정이자율 8
	szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "HLFW_RPRC_INRT" , 0 ) & "☆" '중도환매이율 9
	szData = szData & DATAMANAGER.GetDataValue( 0, "obsat_deal_122r", "OutBlock1", "MTRT_AFT_APLY_INRT" , 0 ) '만기후적용이율 10
	
	if g_szType == "2" then '다드림 외화
		Form.OpenPopupAnimation("mbfnp55020_p1", szData , "","2") 
	elseif g_szType == "3" then '기타 외화
		Form.OpenPopupAnimation("mbfnp55020_p4", szData , "","2") 
	end if
	
End Sub

'============================================================================
'매도하기 버튼
Sub btnSel_OnClick()	
	if Cdbl(edtPrice.caption) < 0.01 then
		'Form.ShowAlert("알림", "매도금액을 입력해주세요.")
		Form.MsgBox("알림", "매도금액을 입력해주세요.", "", 8, "확인")
		Exit Sub
	end if
	
	if Cdbl(edtPrice.caption) > Cdbl(lblAble.caption) then
		'Form.ShowAlert("알림", "매도가능잔고가 부족합니다.")
		Form.MsgBox("알림", "매도가능잔고가 부족합니다.", "", 8, "확인")
		Exit Sub
	end if
	
	If gRpProdTypeCode == "70" Then
		if Cdbl(edtPrice.caption) <> Cdbl(lblAble.caption) then
			Form.MsgBox("알림", "기간물은 전액만 매도 가능합니다.", "", 8, "확인")
			Exit Sub
		end if	
	End If
	
	Form.MsgBox("알림", "RP매도 후 취소 불가합니다.\n매도 진행 하시겠습니까?", "ORDER_CONFIRM", 1)
End Sub

'============================================================================
' 더보기 / 접기
Sub lblFold_OnClick()
	if lblFold.caption == "더보기" then
		lblFold.caption = "접기"
		imgArrow.imgpath = "icon_arrow_up.png"
		imgBG.height = 165
		lblFold.top = 231
		imgArrow.top = 229
		Table0.visible = true
	else
		lblFold.caption = "더보기"
		imgArrow.imgpath = "icon_arrow_down.png"
		imgBG.height = 105
		lblFold.top = 171
		imgArrow.top = 169
		Table0.visible = false
		
	end if
	
End Sub


'============================================================================
Sub imgArrow_OnClick()
	lblFold_OnClick()
End Sub

'============================================================================
'에디트 X 버튼
Sub ImgPrcreset_OnClick()
	f_setPrice("")
	Form.triggerEvent( "LinkForm0", "clear", "")
End Sub

'============================================================================
'키패드 링크폼에서 받은 데이터를 에디트,라벨에 세팅하는 함수
Sub f_setPrice(sData)
	edtPrice.caption = sData
	lblPrice.caption = edtPrice.caption

	lblPrice.mask = "0,0,, USD,0,,-1,1,1,0,0"
	
	if sData = "" then
		lblHint.visible = true
		lblPrice.visible = false
		
		ImgPrcreset.visible = false
	else
		lblHint.visible = false
		lblPrice.visible = true
		
		ImgPrcreset.visible = true
		
	end if
	
	if Cdbl(edtPrice.caption) > Cdbl(lblAble.caption) then
		lblWarning.visible = true
		
	else
		lblWarning.visible = false
		
	end if
	
End Sub


'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

