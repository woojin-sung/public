'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	
	Form.SetScreenName("가격입력기")
	szOpen = Form.GetOpenLinkData()
	
	if Trim(szOpen) <> "" then
		tData = Split(szOpen, "★")
	
		edtPrc.caption = tData(1)
		g_szCd   = tData(3)
		g_szMk   = tData(2)
'		g_szUnit = tData(3)
'		g_szType = tData(4)
		
		Request_Data()
	else
		edtPrc.caption = ""
	end if
	
	g_sIsFirst = true
	
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData("ohhts_smbd_aspr")
	DATAMANAGER.CancelRealData("ohhts_bond_aspr")
'	DATAMANAGER.CancelRealData("ohhts_rebd_aspr")	
	DATAMANAGER.CancelRealData("ohhts_smbd_cntg")
	DATAMANAGER.CancelRealData("ohhts_bond_cntg")
'	DATAMANAGER.CancelRealData("ohhts_rebd_cntg")		
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	' ----------------------------------------------------------------------
	' 현재가(호가)
	' ----------------------------------------------------------------------	
	if szTranID = "ohhts_7052_005r" then
		DATAMANAGER.ClearInputData(0, "ohhts_7052_005r")
	
		DATAMANAGER.SetDataValue(0, "ohhts_7052_005r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_7052_005r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
	' ----------------------------------------------------------------------
	' 현재가
	' ----------------------------------------------------------------------		
	elseif szTranID = "ohhts_7052_001r" then
		DATAMANAGER.ClearInputData(0, "ohhts_7052_001r")

		DATAMANAGER.SetDataValue(0,"ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0,"ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 현재가(호가)
	' ----------------------------------------------------------------------			
	if szTranID = " ohhts_7052_005r" then			
		if g_szMk == "B" then' 일반채권(호가&체결)
		   DATAMANAGER.RequestRealData( "ohhts_bond_aspr" )
	    else ' 소액채권(호가&체결)	
		   DATAMANAGER.RequestRealData( "ohhts_smbd_aspr" )
		end if   
	
	' ----------------------------------------------------------------------
	' 현재가
	' ----------------------------------------------------------------------			
	elseif szTranID = "ohhts_7052_001r" then		
		if g_szMk = "B" then		
			DATAMANAGER.RequestRealData("ohhts_bond_cntg")
		else
			DATAMANAGER.RequestRealData("ohhts_smbd_cntg")
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 일반채권 호가 자동갱신
	' ----------------------------------------------------------------------			
	if szTranID == "ohhts_bond_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_bond_aspr", "InBlock1", "FIDR_STND_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 소액채권 호가 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_smbd_aspr" then
		DATAMANAGER.SetDataValue(1, "ohhts_smbd_aspr" , "InBlock1", "FIDR_STND_ISCD", 0, g_szCd)		
	' ----------------------------------------------------------------------
	' 소매채권 호가 자동갱신
	' ----------------------------------------------------------------------			
'	elseif szTranID == "ohhts_ovtp_aspr" then
'		DATAMANAGER.SetDataValue(1, "ohhts_frbr_aspr", "InBlock1", "FIDR_SHRN_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 일반채권 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_bond_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_bond_cntg", "InBlock1", "FIDR_STND_ISCD", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 소액채권 자동갱신
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_smbd_cntg" then
		DATAMANAGER.SetDataValue(1, "ohhts_smbd_cntg", "InBlock1", "FIDR_STND_ISCD", 0, g_szCd)		
	' ----------------------------------------------------------------------
	' 소매채권 자동갱신
	' ----------------------------------------------------------------------			
'	elseif szTranID == "ohhts_ovtp_cntg" then
'		DATAMANAGER.SetDataValue(1, "ohhts_ovtp_cntg", "InBlock1", "RLTM_SHRN_ISCD", 0, g_szCd)		
	end if
End Sub

