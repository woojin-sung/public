	<SCRIPT_INFO _len="7734" _ulen="7686" >
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_nMin, g_nMax ,g_nPoint
g_nPoint = 0
g_nMin = 0
g_nMax = 100
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************
'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
End Function

'===============================================
' 키패드 입력 
'===============================================
Function Input_Btn(szKeyIdx)
	szTempText = lblTempText.caption

	if szKeyIdx = "Back" then
		nLen = Form.getLen(szTempText)
		
		if nLen = 2 and left(szTempText, 1) = "-" then 
			szTempText = left(szTempText, nLen - 2)
		else
			szTempText = left(szTempText, nLen - 1)
			
			if right(szTempText, 1) = "." then
				nLen = Form.getLen(szTempText)
				szTempText = left(szTempText, nLen - 1)
			end if
		end if
	elseif szKeyIdx = "Clear" then
		szTempText = ""
	
	elseif szKeyIdx = "Minus" then
		if g_nMin < 0 then
			if szTempText = "" or left(szTempText, 1) <> "-" then 'and cdbl(szTempText) <> 0 then
				szTempText = "-" & szTempText
			end if
		end if
	
	elseif szKeyIdx = "Dot" then
		nLen = Form.getLen(szTempText)
		if g_nPoint > 0 then
			if Instr(szTempText, ".") = 0 then
			
				if left(szTempText, 1) <> "-" then
					if nLen > 0 then
						szTempText = szTempText & "."
					end if
				else	
					if nLen > 1 then
						szTempText = szTempText & "."
					end if
				end if
			end if
		end if
	else
	
		if szKeyIdx = "0" then
			if Instr(szTempText, ".") = 0 then
				if szTempText = "" then
					szTempText = "0"
				elseif szTempText = "-" or szTempText = "-0" then
					szTempText = "-0"
				elseif cdbl(szTempText) = 0 then
					szTempText = "0"
				else
					szTempText = szTempText & szKeyIdx
				end if
			else
				arrTemp = split(szTempText, ".")
				nLen = Form.getLen(arrTemp(1))
				
				if nLen < g_nPoint then
					szTempText = szTempText & szKeyIdx
				end if
			end if
		elseif szKeyIdx = "00" then
			if Instr(szTempText, ".") = 0 then
				if szTempText = "" then
					szTempText = "0"
				elseif szTempText = "-" or szTempText = "-0" then
					szTempText = "-0"
				elseif cdbl(szTempText) = 0 then
					szTempText = "0"
				else
					szTempText = szTempText & szKeyIdx
				end if
			else
				arrTemp = split(szTempText, ".")
				nLen = Form.getLen(arrTemp(1))
				
				if nLen < g_nPoint-1 then
					szTempText = szTempText & szKeyIdx
				end if
			end if
		else
			if Instr(szTempText, ".") = 0 then
			
				if cdbl(szTempText) = 0 and szTempText <> "-" then
					szTempText = szKeyIdx
				else
					szTempText = szTempText & szKeyIdx
				end if
			else
				arrTemp = split(szTempText, ".")
				nLen = Form.getLen(arrTemp(1))
				
				if nLen < g_nPoint then
					szTempText = szTempText & szKeyIdx
				end if
			end if
		
		end if
		
	end if
	
	if g_nMin <= Cdbl(szTempText) and Cdbl(szTempText) <= g_nMax then
		Form.triggerEvent("#", "KEYPAD", szTempText)
		lblTempText.caption = szTempText
		
	elseif szTempText = "-" then
		Form.triggerEvent("#", "KEYPAD", szTempText)
		lblTempText.caption = szTempText
	else
		Form.ShowAlert("안내", g_nMin&"% ~ "& g_nMax & "% 까지만 입력 가능합니다." )
	end if
End Function

