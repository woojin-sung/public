'============================================================================
Sub btnOk_OnClick()
	Form.triggerEvent("#", "KEYPAD_END", lblTempText.caption)
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "INIT_KEYPAD" then
		Dim szData, arrData
		szData = sParam
		arrData = split(szData, "`")
		
		if #arrData > 3 then
			g_nMin = Cdbl(arrData(0))
			g_nMax = Cdbl(arrData(1))
			
			g_nPoint = Cdbl(arrData(2))
			
			lblTempText.caption = arrData(3)
			
			if g_nMin >= 0 then
				btnMinus.visible = false
			else
				btnMinus.visible = true
			end if
			
			if g_nMax < 100 then
				
				btnNum00.visible = false
			else
				btnNum00.visible = true
			end if
			
			if g_nPoint = 0 then
				btnDot.visible = false
			else
				btnDot.visible = true
			end if
		end if
	end if
End Sub

