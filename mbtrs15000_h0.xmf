Sub DATAMANAGER_OnReceiveTranData(szTranID)
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "obacb_balc_105r" Then
		DATAMANAGER.RequestTranData( "obtrs_comn_308r" )
		
	ElseIf szTranID = "obtrs_comn_308r" Then
		If chk1.checkstate = "1" Then
			DATAMANAGER.RequestTranData( "obtrs_comn_329r" )
		Else
			DATAMANAGER.RequestTranData( "obtrs_comn_310r" )
		End If
	
	ElseIf szTranID = "obtrs_comn_329r" Or szTranID = "obtrs_comn_310r" Then
		SetGridData()
		for i = 0 to grd0.rowcount - 1
			psnt_prc = Cdbl(grd0.GetCellData("bd_cell12", i))
			psdy_clpr= Cdbl(grd0.GetCellData("bd_cell3",i))
			
			if psnt_prc > psdy_clpr then
				grd0.SetCellFgColor("bd_cell12", i, "10")
			elseif psnt_prc = psdy_clpr then
				grd0.SetCellFgColor("bd_cell12", i, "4")
			else
				grd0.SetCellFgColor("bd_cell12", i, "11")
			end if
			
			if trim(grd0.GetCellData("bd_cell14", i)) = "" then
				byng_amt = 0
			else
				byng_amt = cdbl(grd0.GetCellData("bd_cell14", i))
			end if
			
			if trim(grd0.GetCellData("bd_cell5", i)) = "" then
				loan_amt = 0
			else
				loan_amt = cdbl(grd0.GetCellData("bd_cell5", i))
			end if
			
			grd0.SetCellData("bd_cell7", i, byng_amt -  loan_amt)
		next				
'	ElseIf szTranID = "obsim_stsv_001r" Then
'		if Cint(g_index) < Cint(grd0.rowcount) then
'			iscd = DATAMANAGER.GetDataValue(0, "obsim_stsv_001r", "OutBlock1", "ISCD" , 0)
'			prdy_clpr = DATAMANAGER.GetDataValue(0, "obsim_stsv_001r", "OutBlock1", "PRDY_CLPR" , 0)
'			
'			grd0.SetCellData("bd_cell3", g_index, prdy_clpr)
'			g_index = g_index + 1
'			
'			iscd = grd0.GetCellData("bd_cell24", g_index)
'			DATAMANAGER.SetDataValue(0, "obsim_stsv_001r", "InBlock1", "ISCD" , 0 , iscd)
'			
'			DATAMANAGER.RequestTranData("obsim_stsv_001r")
'		end if
'		
'		if Cint(g_index) < Cint(grd0.rowcount) then
'			for i = 0 to grd0.rowcount - 1
'				psnt_prc = Cdbl(grd0.GetCellData("bd_cell12", i))
'				psdy_clpr= Cdbl(grd0.GetCellData("bd_cell3", i))
'				
'				
'				if psnt_prc > psdy_clpr then
'					grd0.SetCellFgColor("bd_cell12", i, "10")
'				elseif psnt_prc = psdy_clpr then
'					grd0.SetCellFgColor("bd_cell12", i, "4")
'				else
'					grd0.SetCellFgColor("bd_cell12", i, "11")
'				end if
'			next
'		end if
	ElseIf szTranID = "obtrs_oder_161r" then
		if DATAMANAGER.GetDataValue(0, "obtrs_oder_161r", "OutBlock1", "RGHT_HLDN_YN" , 0) == "Y" then
			Button0.visible = true
			Label0.visible  = true
			
			chk1.height = 19
			chk1.fontsize = 0
			chk2.height = 19
			chk2.fontsize = 0
		else
			Button0.visible = false
			Label0.visible  = false
			
			chk1.height = 39
			chk1.fontsize = 0
			chk2.height = 39
			chk2.fontsize = 0
		end if
	End If
	
End Sub



