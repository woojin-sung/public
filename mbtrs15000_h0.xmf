Sub btnClose_OnClick()
	
	Dim szData
	
	szData = CStr( chk1.checkstate ) & "|" & CStr( chk2.checkstate )  & "|" &  acnt0.caption
	
	Form.CloseForm()
	Form.SendReturnToParent("mbtrs15000" , szData)

	
End Sub

