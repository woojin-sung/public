'============================================================================
Sub Form_OnFormInit()

	Dim szData, arrData

	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if

	g_szChk1 = arrData(0)
	g_szChk2 = arrData(1)

	If g_szChk1 = "1" Then
		chk1.checkstate = true
	Else
		chk1.checkstate = false
	End If
	
	If g_szChk2 = "1" Then		
		chk2.checkstate = 1
	Else
		chk2.checkstate = 0
	End If
		
	btnSearch_OnClick()
	
End Sub

'============================================================================
Sub chk1_OnChange(sCheckState)

	RequestData()

End Sub

'============================================================================
Sub chk2_OnChange(sCheckState)

	RequestData()
	
End Sub

'============================================================================
Sub btnSearch_OnClick()
	g_Buffer = 0
	DATAMANAGER.RequestTranData("obtrs_oder_161r")
	
	If sCheckState = "1" Then
		DATAMANAGER.RequestTranData( "obtrs_comn_329r" )
	Else
		DATAMANAGER.RequestTranData( "obtrs_comn_310r" )
	End If

End Sub


