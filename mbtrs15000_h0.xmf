'============================================================================
Sub grd0_OnHeaderClickUp(lRow, szCellID)
	if g_Buffer = 1 then
	
		if szCellID = "th_cell2" then
			g_Toggle1 = g_Toggle1 + 1
			g_Toggle2 = 0
		
			if g_Toggle1 > 2 then
				g_Toggle1 = 0
			end if
	
			SetGridHeader(g_Toggle1, g_Toggle2)
		elseif szCellID = "th_cell8" then
			g_Toggle1 = 0
			g_Toggle2 = g_Toggle2 + 1
		
			if g_Toggle2 > 2 then
				g_Toggle2 = 0
			end if
		
			SetGridHeader(g_Toggle1, g_Toggle2)
		end if
	end if
	
	g_Buffer = 1
End Sub
'============================================================================
Sub SetGridHeader(g_Toggle1, g_Toggle2)
	if g_Toggle1 = 0 then
		grd0.SetCellTopCaption("th_cell2", "종목명")
	elseif g_Toggle1 = 1 then
		grd0.SetCellTopCaption("th_cell2", "종목명▼")
	else
		grd0.SetCellTopCaption("th_cell2", "종목명▲")
	end if
	
	if g_Toggle2 = 0 then
		grd0.SetCellTopCaption("th_cell8", "평가손익")
	elseif g_Toggle2 = 1 then
		grd0.SetCellTopCaption("th_cell8", "평가손익▼")
	else
		grd0.SetCellTopCaption("th_cell8", "평가손익▲")
	end if
	
End Sub
