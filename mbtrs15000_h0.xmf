	Dim i, nRate, szData, szReturnValue
	Dim nVLTN_PRLS_AMT	' 평가손익
	Dim nBYNG_AMT			' 매입금액	
	Dim nEXPN_AMT			' 비용금액
	Dim szLOAN_DATE		' 대출일자
	
	nVLTN_PRLS_AMT 	 = 0
	nBYNG_AMT 		 = 0
	g_Toggle1		 = 0
	g_Toggle2		 = 0
	
	SetGridHeader(g_Toggle1, g_Toggle2)
	
	For i = 0 To grd0.rowcount -1
		If chk2.checkstate = "1" Then
			nVLTN_PRLS_AMT	= CDbl( grd0.GetCellData( "bd_cell8", i ) ) - CDbl( grd0.GetCellData("bd_cell1", i) )
		
		Else
			nVLTN_PRLS_AMT	= CDbl( grd0.GetCellData( "bd_cell8", i ) )
		End If	
		
		nBYNG_AMT 	  	= CDbl( grd0.GetCellData( "bd_cell16", i ) )
		nPSNT_PRC		= grd0.GetCellData( "bd_cell12", i )
		szData			= grd0.GetCellData( "bd_cell0", i )
		szLOAN_DATE		= grd0.GetCellData( "bd_cell20", i )
		szRMND_CLCD	     = grd0.GetCellData( "bd_cell9", i )
		
		grd0.SetCellData("bd_cell8", i, nVLTN_PRLS_AMT)
		
		'매입금액이 있는 경우에만 계산
		If CDbl( grd0.GetCellData( "bd_cell16", i ) ) = 0 Then
			grd0.SetCellData("bd_cell10", i, "" )
		Else
			grd0.SetCellData("bd_cell10", i, FormatNumber(FIX((nVLTN_PRLS_AMT/nBYNG_AMT)*10000)/100,2))
		End If
		
		If nPSNT_PRC = "" and chk2.checkstate = "1" Then
			Dim nData
			nData = CDbl(grd0.GetCellData( "bd_cell26", i )) * -1
			
			grd0.SetCellData( "bd_cell8", i, nData )
		End If
						
		Select Case szData
			Case "0000"	szReturnValue = "보통"
			Case "0101"	szReturnValue = "자기융자"
			Case "0102"	szReturnValue = "유통융자"
			Case "0103"	szReturnValue = "자기대주"
			Case "0104"	szReturnValue = "유통대주"
			Case "0201"	szReturnValue = "예탁주식"
			Case "0202"	szReturnValue = "예탁채권"
			Case "0203"	szReturnValue = "예탁집합투자"
			Case "0204"	szReturnValue = "예탁장외파생"
			Case "0211"	szReturnValue = "예탁유통주식"
			Case "0212"	szReturnValue = "예탁유통채권"
			Case "0213"	szReturnValue = "예탁유통집합투자"
			Case "0214"	szReturnValue = "예탁유통장외파생"
			Case "0301"	szReturnValue = "매도증권담보대출"
			Case "0302"	szReturnValue = "수익증권환매"
			Case "0303"	szReturnValue = "ELS환매자금대출"
			Case "0401"	szReturnValue = "소액주식"
			Case "0402"	szReturnValue = "소액채권"
			Case "0403"	szReturnValue = "소액수익증권"
			Case "0404"	szReturnValue = "소액 ELS"
			Case "0501"	szReturnValue = "공모주청약"
			Case "0502"	szReturnValue = "ELS청약"
			Case "0503"	szReturnValue = "주식매입"
			Case "0601"	szReturnValue = "매입자금대출"
			Case "0701"	szReturnValue = "초단기대출"
			Case "0801"	szReturnValue = "CMA담보대출"
			Case "9201"	szReturnValue = "대출(대여)" 'v002
			Case "8201"	szReturnValue = "양도담보" 'v003
			Case Else	szReturnValue = szData
		End Select

		if szData = "0000" then
			if szRMND_CLCD = "31" then
				szReturnValue = "대여주식"
			elseif szRMND_CLCD = "32" then
				szReturnValue = "CFD대용"
			elseif szRMND_CLCD = "16" then
				szReturnValue = "선물대용"
			end if
		end if
		
		grd0.SetCellData( "bd_cell0", i, szReturnValue )
	
	Next	
	
	g_index = 0
	
'	iscd = grd0.GetCellData("bd_cell24", g_index)
'	
'	DATAMANAGER.SetDataValue(0, "obsim_stsv_001r", "InBlock1", "ISCD" , 0 , iscd)	
'	DATAMANAGER.RequestTranData("obsim_stsv_001r")	
'	
End Function

'============================================================================
Function RequestData()

	grd0.rowcount = 0

	If chk1.checkstate = "1" Then
		DATAMANAGER.RequestTranData( "obtrs_comn_329r" )
	Else
		DATAMANAGER.RequestTranData( "obtrs_comn_310r" )
	End If

End Function

