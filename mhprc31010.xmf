'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵종합시세
' 02. 화면설명 : 선옵종합시세
' 03. 작    성 : 2016.01.07 김보라
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
'20210630 HWG START : ATM 실시간 하이라이트 적용
Dim g_nGIdx, g_nJisu, g_bFirst	
g_nGIdx = 0
g_nJisu = 0
g_bFirst = false
'20210630 HWG END

'20230322 SWJ START
Dim g_nPrice, g_szItemCode, g_ndebi 
'20230322 SWJ END

' 20230628_01 KBC START : 위클리옵션(월요일) 추가
Dim	g_KOSPI200
Dim	g_K200WEEKM
Dim	g_K200WEEK
Dim	g_K200MINI
Dim	g_KSQ150
Dim	g_STKOPT

g_KOSPI200 	= 0
g_K200WEEKM	= 1
g_K200WEEK 	= 2
g_K200MINI 	= 3
g_KSQ150		= 4
g_STKOPT		= 5
' 20230628_01 KBC END

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' 주식선옵일 때 UI가 달라서 보임 처리.
'============================================================================
Function SetControl()
	Dim nCurrentTab
	nCurrentTab = FormTab0.currenttab
	
	'20210630 HWG START : ATM 실시간 하이라이트 적용
	GridCP.SetClear()
	Container0.GridAllC.SetClear()
	Container0.GridAllP.SetClear()
	'20210630 HWG END

	' KOSPI200 & Mini KOSPI200
	
	' 20230628_01 KBC : 위클리옵션(월요일) 추가
	' 20190809_01 HWG START : 위클리옵션추가
	'KBC : 안드로이드는 숫자, iOS는 문자
	If CInt(nCurrentTab) = g_KOSPI200 or CInt(nCurrentTab) = g_K200MINI or CInt(nCurrentTab) = g_KSQ150 Then 
		ComboYYMM.visible 	= true
		RadioGroupCP.visible 	= true
		Table0.visible 		= true
		GridCP.visible 		= true
		Container0.visible 	= true
		Table1.visible 		= true	
		
		GridCP.top = 173
		GridCP.height = 389
		
		Table1.top = 173
		
		Container0.top = 202
		Container0.height = 360
	
	Elseif CInt(nCurrentTab) = g_K200WEEK or CInt(nCurrentTab) = g_K200WEEKM then
		ComboYYMM.visible 	= true
		RadioGroupCP.visible 	= true
		Table0.visible 		= false
		GridCP.visible 		= true
		Container0.visible 	= true
		Table1.visible 		= true	
		
		GridCP.top = 94
		GridCP.height = 468
		
		Table1.top = 94
		
		Container0.top = 123
		Container0.height = 439
	' 20190809_01 HWG END
		
	' 주식선옵
	Else
		ComboYYMM.visible 	= false
		RadioGroupCP.visible 	= false
		Table0.visible 		= false
		GridCP.visible 		= false
		Container0.visible 	= false
		Table1.visible 		= false
	End If
	
End Function


'============================================================================
' 콜/풋 선택
'============================================================================
Function SetCallPutGrid()
	Dim nCnt, nTopRow, sTranID
	nCnt = CInt(GridCP.rowcount)
	nTopRow = 0
	
	if RadioGroupCP.currentindex = "1" then '콜
		sTranID = "ohhts_optn_cntg"
	elseif RadioGroupCP.currentindex = "2" then '풋
		sTranID = "ohhts_optn_cntg_1"
	end if
	
	if nCnt > 0 then
		Dim nSign, sAtm, sCode
		
		for i = 0 to nCnt-1 
			sCode = GridCP.GetCellData( "bd_code", i )
			sAtm = GridCP.GetCellData( "bd_atm", i )
			
			'그리드 실시간 자동업데이트 안되서 일단 세팅
			DATAMANAGER.SetDataValue( 1, sTranID, "InBlock1", "FIDR_SHRN_ISCD" , i , sCode )
			
			if sAtm = "ATM" then
'				if i > 2 then
'					nTopRow = i-3
'				end if
'				
'				GridCP.SetCellBgColor( "bd_cell0", i, "156:255253233" )
				g_nGIdx = i	'20210630 HWG : ATM 실시간 하이라이트 적용
			end if 
		next
	
'		if nTopRow ~= 0 then
'			GridCP.toprow = nTopRow		
'		end if
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Dim nCurrentTab
	nCurrentTab = FormTab0.currenttab

	'' 아이폰에서만 사용. 스크롤을 멈추게 한다.
	Container0.GridAllC.scrollenable = "0"
	Container0.GridAllP.scrollenable = "0"
	Form.SetTitleCaption("선물옵션종합시세")
	
	SetControl()
	
	' 20230628_01 KBC : 위클리옵션(월요일) 추가
	' 20190809_01 HWG START : 위클리옵션추가
	If CInt(nCurrentTab) = g_KOSPI200 or CInt(nCurrentTab) = g_K200WEEK or CInt(nCurrentTab) = g_K200WEEKM or CInt(nCurrentTab) = g_K200MINI or CInt(nCurrentTab) = g_KSQ150 Then
		if CInt(nCurrentTab) <> g_K200WEEK and CInt(nCurrentTab) <> g_K200WEEKM then
			DATAMANAGER.RequestTranData( "ohhts_0510_001r" ) '결제월조회
		end if
		
		DATAMANAGER.RequestTranData( "ohhts_3002_002r" ) '결제월조회
	End If
	' 20190809_01 HWG END
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	Dim nCurrentTab
	nCurrentTab = FormTab0.currenttab
	
	ComboYYMM.clear = true

	Container0.GridAllC.rowcount = "0"
	Container0.GridAllP.rowcount = "0"
	GridCP.rowcount = "0"
	
	' 20230628_01 KBC : 위클리옵션(월요일) 추가
	' 20190809_01 HWG START : 위클리옵션추가
	If CInt(nCurrentTab) = g_KOSPI200 or CInt(nCurrentTab) = g_K200WEEK or CInt(nCurrentTab) = g_K200WEEKM or CInt(nCurrentTab) = g_K200MINI or CInt(nCurrentTab) = g_KSQ150 Then
		if CInt(nCurrentTab) <> g_K200WEEK and CInt(nCurrentTab) <> g_K200WEEKM then
			DATAMANAGER.RequestTranData( "ohhts_0510_001r" ) '결제월조회
		end if
		
		DATAMANAGER.RequestTranData( "ohhts_3002_002r" ) '결제월조회
	' 20190809_01 HWG END
	
	Else
		Form.triggerEvent("FormTab0.page2", "REFRESH" , "")
	End If	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	'20180308_01 KBC START : KRX300 & KSQ150상품추가
	if szTranID = "ohhts_0510_001r" then
		DATAMANAGER.CancelRealData( "ohhts_futs_cntg" )
		DATAMANAGER.CancelRealData( "ohhts_futs_cntg_1" )
		
		'선물
		if FormTab0.currenttabpageid = "page0" then 'KOSPI200
			DATAMANAGER.SetDataValue( 0, "ohhts_0510_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "510" )
		elseif FormTab0.currenttabpageid = "page1" then 'Mini KOSPI200
			DATAMANAGER.SetDataValue( 0, "ohhts_0510_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "522" )
		elseif FormTab0.currenttabpageid = "page3" then 'KSQ 150
			DATAMANAGER.SetDataValue( 0, "ohhts_0510_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "510" ) 'KSQ150선물은 KOSPI200과 같이사용 (20180313 유정식차장확인)
		end if
		
	elseif szTranID = "ohhts_3002_002r" then
	
		'옵션
		if FormTab0.currenttabpageid = "page0" then 'KOSPI200
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_002r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "509" )
		elseif FormTab0.currenttabpageid = "page1" then 'Mini KOSPI200
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_002r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "521" )
		elseif FormTab0.currenttabpageid = "page3" then 'KSQ 150
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_002r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "527" )
		' 20190809_01 HWG START : 위클리옵션추가
		elseif FormTab0.currenttabpageid = "page4" then 'KOSPI200 위클리
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_002r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "529" )
		' 20190809_01 HWG END
		' 20230628_01 KBC START : 위클리옵션(월요일) 추가
		elseif FormTab0.currenttabpageid = "page5" then 'KOSPI200 위클리(월)
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_002r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "531" )
		' 20230628_01 KBC END
