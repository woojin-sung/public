		if FormTab0.currenttabpageid = "page0" then 'KOSPI200
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "F" )
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "F" )
		elseif FormTab0.currenttabpageid = "page1" then 'Mini KOSPI200
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "MF" )
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "MF" )
		elseif FormTab0.currenttabpageid = "page3" then 'KSQ 150
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "F" )
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "F" )		
		end if
		
