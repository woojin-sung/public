			DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "WO" )
			DATAMANAGER.SetDataValue( 0, "ohhts_3002_003r", "InBlock1", "FID_INPUT_ISCD2" , 0 , "WKI" )
