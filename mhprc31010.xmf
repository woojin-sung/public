			DATAMANAGER.SetDataValue(0, "ohhts_3002_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "U")
			DATAMANAGER.SetDataValue(0, "ohhts_3002_001r", "InBlock1", "FID_INPUT_ISCD", 0 , "K2G01P")			'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 2029 -> K2G01P
		end if
	'20210630 HWG END
	
	end if 
	'20180308_01 KBC END
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "ohhts_0510_001r" then
	
		Dim sISCD, sISCD1
	
		'20180308_01 KBC START : KRX300 & KSQ150상품추가(변경)
		'0.코스피200 1.미니코스피 2.KRX300 3.KSQ150
		
		if FormTab0.currenttabpageid = "page0" then 'KOSPI200
			sISCD = Form.getFutureCodeNew(0, 0, true)
			sISCD1 = Form.getFutureCodeNew(1, 0, true)
		elseif FormTab0.currenttabpageid = "page1" then 'Mini KOSPI200
			sISCD = Form.getFutureCodeNew(0, 1, true)
			sISCD1 = Form.getFutureCodeNew(1, 1, true)
		elseif FormTab0.currenttabpageid = "page3" then 'KSQ 150
			sISCD = Form.getFutureCodeNew(0, 3, true)
			sISCD1 = Form.getFutureCodeNew(1, 3, true)
		end if
		
		'이전소스
		'sISCD = DATAMANAGER.GetDataValue( 0, "ohhts_0510_001r", "OutBlock1", "FID_SHRN_ISCD" , 0 )
		'sISCD1 = DATAMANAGER.GetDataValue( 0, "ohhts_0510_001r", "OutBlock1", "FID_SHRN_ISCD" , 1 )
		'20180308_01 KBC END
		
		DATAMANAGER.SetDataValue( 0, "ohhts_3002_004r", "InBlock1", "FID_INPUT_ISCD" , 0 , sISCD )
		DATAMANAGER.SetDataValue( 0, "ohhts_3002_004r", "InBlock2", "FID_INPUT_ISCD" , 0 , sISCD1 )

		DATAMANAGER.RequestTranData( "ohhts_3002_004r" ) '최근월물/차근월물시세조회
		
	elseif szTranID = "ohhts_3002_002r" then
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, "ohhts_3002_002r", "OutBlock1" )

		'20190809_01 HWG START : 위클리옵션추가
		if nCnt > 0 then
			Dim sYYMM
			Dim sWeek
			
			for i = 0 to nCnt-1 
				sYYMM = DATAMANAGER.GetDataValue( 0, "ohhts_3002_002r", "OutBlock1", "FID_MTRT_YYMM" , i )
				sWeek = DATAMANAGER.GetDataValue( 0, "ohhts_3002_002r", "OutBlock1", "FID_STLM_WEEK" , i )
				nWeek = Replace(sWeek, "W", "")
				
				' 20230628_01 KBC : 위클리옵션(월요일) 추가
				if FormTab0.currenttabpageid = "page4" or FormTab0.currenttabpageid = "page5" then
					ComboYYMM.cbadddatatext = sYYMM&sWeek.."`"..sYYMM&" "&nWeek&"주" '결제월콤보세팅
				else
					ComboYYMM.cbadddatatext = sYYMM.."`"..sYYMM '결제월콤보세팅
				end if
			next
			
			SetCallPutRequest()	
		end if
		'20190809_01 HWG END
	elseif szTranID = "ohhts_3002_004r" then
		Dim sISCD, sISCD1, nSign, nSign1 
		sISCD = DATAMANAGER.GetDataValue( 0, "ohhts_3002_004r", "OutBlock1", "FID_SHRN_ISCD" , 0 )
		sISCD1 = DATAMANAGER.GetDataValue( 0, "ohhts_3002_004r", "OutBlock2", "FID_SHRN_ISCD" , 0 )

		DATAMANAGER.SetDataValue( 1, "ohhts_futs_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , sISCD )
		DATAMANAGER.SetDataValue( 1, "ohhts_futs_cntg_1", "InBlock1", "FIDR_SHRN_ISCD" , 0 , sISCD1 )
		DATAMANAGER.RequestRealData( "ohhts_futs_cntg" ) '최근월물실시간조회
		DATAMANAGER.RequestRealData( "ohhts_futs_cntg_1" ) '차근월물실시간조회
	elseif szTranID = "ohhts_3002_003r" then
		if RadioGroupCP.currentindex = "0" then
			Dim nCnt, nTopRow
			nCnt = CInt(Container0.GridAllC.rowcount)
			nTopRow = 0
			
			if nCnt > 0 then
				Container0.GridAllC.height = CInt(47.2*nCnt)
				Container0.GridAllP.height = CInt(47.2*nCnt)
				Container0.SetScrollAutoSize()
				
				Dim nSign, sAtm, sCode
				
				for i = 0 to nCnt-1 
					sCode = Container0.GridAllC.GetCellData( "bd_callcode", i )
					sAtm = Container0.GridAllC.GetCellData( "bd_callatm", i )
					
					'그리드 실시간 자동업데이트 안되서 일단 세팅
					DATAMANAGER.SetDataValue( 1, "ohhts_optn_cntg", "InBlock1", "FIDR_SHRN_ISCD" , i , sCode )
					
					if sAtm = "ATM" then
'						if i > 2 then
'							nTopRow = i-3
'						end if
'
'						Container0.GridAllC.SetCellBgColor( "bd_cell2", i, "156:255253233" )
						g_nGIdx = i	'20210630 HWG : ATM 실시간 하이라이트 적용
					end if 
				next
			
'				if nTopRow ~= 0 then
'					Container0.scroll_pos = nTopRow*47
'				end if
			else
				Container0.GridAllC.height = "0"
				Container0.SetScrollAutoSize()
			end if
		else
			SetCallPutGrid()
		end if
		
		'20210630 HWG START : ATM 실시간 하이라이트 적용
		if RadioGroupCP.currentindex <> "2" then
			DATAMANAGER.RequestTranData("ohhts_3002_001r")
		end if
		'20210630 HWG END
		
		DATAMANAGER.RequestRealData( "ohhts_optn_cntg" ) '콜실시간조회
	elseif szTranID = "ohhts_3002_003r_1" then
		if RadioGroupCP.currentindex = "0" then
			Dim nCnt
			nCnt = CInt(Container0.GridAllP.rowcount)
			
			if nCnt > 0 then
				Container0.GridAllP.height = CInt(47.2*nCnt)
				
				Dim nSign, sCode
				
				for i = 0 to nCnt-1 
					sCode = Container0.GridAllP.GetCellData( "bd_putcode", i )
					
					'그리드 실시간 자동업데이트 안되서 일단 세팅
					DATAMANAGER.SetDataValue( 1, "ohhts_optn_cntg_1", "InBlock1", "FIDR_SHRN_ISCD" , i , sCode )
				next
			else
				Container0.GridAllP.height = "0"
			end if
		else
			SetCallPutGrid()
		end if
		
		'20210630 HWG START : ATM 실시간 하이라이트 적용
		if RadioGroupCP.currentindex = "2" then
			DATAMANAGER.RequestTranData("ohhts_3002_001r")
		end if
		'20210630 HWG END
		
		DATAMANAGER.RequestRealData( "ohhts_optn_cntg_1" ) '풋실시간조회
		
	'20210630 HWG START : ATM 실시간 하이라이트 적용
	elseif szTranID = "ohhts_3002_001r" then
		szHyunJisu = DATAMANAGER.GetDataValue(0, "ohhts_3002_001r", "OutBlock1", "FID_PRPR" , 0)

		Dim nTopRow
		nTopRow = 0
		
		if RadioGroupCP.currentindex = "0" then
			SetAllRealAtm(szHyunJisu)
			
			if g_nGIdx > 2 then
				nTopRow = g_nGIdx - 3
			end if
			
			if nTopRow ~= 0 then
				szOsType = Form.GetSharedData("&OS_TYPE", false )
				if szOsType = "2" then
					Container0.scroll_pos_noAni = nTopRow*47
				else
					Container0.scroll_pos = nTopRow*47
				end if
			end if
		else
			SetCallPutRealAtm(szHyunJisu)
			
			if g_nGIdx > 2 then
				nTopRow = g_nGIdx - 3
			end if
			
			if nTopRow ~= 0 then
				GridCP.toprow = nTopRow		
			end if
		end if
		
		DATAMANAGER.RequestRealData( "ohhts_nmix_cntg" ) '지수 실시간조회
		DATAMANAGER.RequestRealData( "ohhts_nmix_cntg_1" ) '지수 실시간조회
	'20210630 HWG END
	end if
End Sub

'============================================================================
' KOSPI200/Mini KOSPI200 선택
'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	Dim nCurrentTab
	nCurrentTab = FormTab0.currenttab
	
	ComboYYMM.clear = true
	
	SetControl()
	
	SetPopupUI(0)	'20230322 SWJ START
	
	' 20230628_01 KBC : 위클리옵션(월요일) 추가
	' 20190809_01 HWG START : 위클리옵션추가
	If CInt(nCurrentTab) = g_KOSPI200 or CInt(nCurrentTab) = g_K200WEEK or CInt(nCurrentTab) = g_K200WEEKM or CInt(nCurrentTab) = g_K200MINI or CInt(nCurrentTab) = g_KSQ150 Then
		if CInt(nCurrentTab) <> g_K200WEEK and CInt(nCurrentTab) <> g_K200WEEKM then
			DATAMANAGER.RequestTranData( "ohhts_0510_001r" ) '결제월조회
		end if
		DATAMANAGER.RequestTranData( "ohhts_3002_002r" ) '결제월조회
		
		RadioGroupCP_OnClick(tonumber(RadioGroupCP.currentindex))
	End If	
	' 20190809_01 HWG END
	 
End Sub
'============================================================================
' 콜/풋 조회
'============================================================================
Function SetCallPutRequest()
	DATAMANAGER.CancelRealData( "ohhts_optn_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_optn_cntg_1" )
	
	'20210630 HWG START : ATM 실시간 하이라이트 적용
	DATAMANAGER.CancelRealData( "ohhts_nmix_cntg" ) 	
	DATAMANAGER.CancelRealData( "ohhts_nmix_cntg_1" ) 
	
	DATAMANAGER.ClearInputData(1, "ohhts_nmix_cntg")
	DATAMANAGER.ClearInputData(1, "ohhts_nmix_cntg_1")
	
	if FormTab0.currenttabpageid = "page3" then
		DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", 0 , "Q5G01P")		'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 1203 -> Q5G01P
		DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg_1", "InBlock1", "FIDR_BSTP_CLS_CODE", 0 , "QGG01P")	'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 1001 -> QGG01P	
	'elseif FormTab0.currenttabpageid = "page5" then ' 20230628_01 KBC : 위클리옵션(월요일) 추가
		'주신선옵 처리 
	else
		DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg", "InBlock1", "FIDR_BSTP_CLS_CODE", 0 , "K2G01P")		'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 2029 -> K2G01P
		DATAMANAGER.SetDataValue(1, "ohhts_nmix_cntg_1", "InBlock1", "FIDR_BSTP_CLS_CODE", 0 , "KGG01P")	'20221111 SWJ START : 거래소 차세대 관련 업종코드 변경 0001 -> KGG01P
	end if
	
	g_nGIdx = 0 '인덱스값 초기화
	g_nJisu = 0
	g_bFirst = true
	'20210630 HWG END
		
	if RadioGroupCP.currentindex = "1" then
		DATAMANAGER.RequestTranData( "ohhts_3002_003r" ) '콜시세조회
	elseif RadioGroupCP.currentindex = "2" then
		DATAMANAGER.RequestTranData( "ohhts_3002_003r_1" ) '풋시세조회
	else
		DATAMANAGER.RequestTranData( "ohhts_3002_003r" ) '콜시세조회
		DATAMANAGER.RequestTranData( "ohhts_3002_003r_1" ) '풋시세조회
	end if	
End Function
'============================================================================
' 결제월 선택
'============================================================================
Sub ComboYYMM_OnEditComplete(iIndex)
	Container0.GridAllC.rowcount = "0"
	Container0.GridAllP.rowcount = "0"
	GridCP.rowcount = "0"

	SetCallPutRequest()
End Sub

'============================================================================
' 콜/풋 선택
'============================================================================
Sub RadioGroupCP_OnClick(nIndex)
	
	if nIndex = 0 then
		Container0.visible = true
		Table1.visible = true
		GridCP.visible = false
	else
		Container0.visible = false
		Table1.visible = false
		GridCP.visible = true
	end if
	
	SetCallPutRequest()
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "SCREEN_MENU" Then							' 연
		If sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns1" , "0", "")
		End If
	End if	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	g_nSNSType = Cint(sRet)
	If g_nSNSType = 2 Then
		Dim szScreenNo, szFileName
		szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
		szFileName = szScreenNo & "_ScreenShot.png"
		
		Form.SaveScreenShot( szFileName )		
		Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
	Else
		Form.triggerEvent("linkfmHoga", "sharedata", "")
	End If
End Sub

'20210630 HWG START : ATM 실시간 하이라이트 적용
'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID = "ohhts_nmix_cntg" then
		szHyunJisu = DATAMANAGER.GetDataValue(1, "ohhts_nmix_cntg", "OutBlock1", "FIDR_PRPR2" , 0)
		szHyunJisu = Round(szHyunJisu, 2)
		
		if RadioGroupCP.currentindex = "0" then
			SetAllRealAtm(szHyunJisu)
		else
			SetCallPutRealAtm(szHyunJisu)
		end if
		
	elseif szTranID = "ohhts_nmix_cntg_1" then
		g_nJisu = DATAMANAGER.GetDataValue(1, "ohhts_nmix_cntg_1", "OutBlock1", "FIDR_PRPR2", 0)
	
	'20230322 SWJ START
	elseif szTranID = "ohhts_optn_cntg_2" then
		nPrice    = DATAMANAGER.GetDataValue(1, "ohhts_optn_cntg_2", "OutBlock1", "FIDR_PRPR2", 0)
		nPrcVrss = DATAMANAGER.GetDataValue(1, "ohhts_optn_cntg_2", "OutBlock1", "FIDR_PRDY_VRSS2", 0)
		
		SetTblColor(nPrice, nPrcVrss)
	end if
End Sub

'============================================================================
Function SetCallPutRealAtm(szHyunJisu, szReal)
	nCnt = CInt(GridCP.rowcount)
	nAtm = CDbl(GridCP.GetCellData("bd_cell0", g_nGIdx))
	nDiff = ABS(szHyunJisu - nAtm) 
	
	nBaseJisu = 0
	if g_nJisu <> 0 and g_nJisu <> "" then
		nBaseJisu = Round(g_nJisu,2)
	end if
	
	nMinDiff = 0
	nMinIdx = 0
	
	for i = 0 to nCnt - 1
		nPrc = CDbl(GridCP.GetCellData("bd_cell0", i))
		nHDiff = ABS(szHyunJisu - nPrc)
		
		if nBaseJisu <> 0 then
			nJisu = Round(nBaseJisu / szHyunJisu * nPrc, 2)
			GridCP.SetCellData("bd_cell1", i, nJisu)
		end if
		
		if i = 0 then
			nMinDiff = nHDiff
		else
			if nHDiff < nMinDiff then
				nMinDiff = nHDiff
				nMinIdx = i
			end if
		end if
	next
	
	if nMinIdx <> g_nGIdx then
		if nMinDiff < nDiff then
			GridCP.SetCellBgColor( "bd_cell0", g_nGIdx, "38:255255255" )
			GridCP.SetCellBgColor( "bd_cell0", nMinIdx, "156:255253233" )
			
'			nTopRow = 0
'			if nMinIdx > 3 then
'				nTopRow = nMinIdx - 4
'			end if
'			
'			if nTopRow ~= 0 then
'				GridCP.toprow = nTopRow		
'			end if
			
			g_nGIdx = nMinIdx
		end if
	else
		if g_bFirst = true then
			GridCP.SetCellBgColor( "bd_cell0", g_nGIdx, "156:255253233" )
			g_bFirst = false
		end if
	end if
End Function

'============================================================================
Function SetAllRealAtm(szHyunJisu, szReal)
	nCnt = CInt(Container0.GridAllC.rowcount)
	nAtm = CDbl(Container0.GridAllC.GetCellData("bd_cell2", g_nGIdx))
	nDiff = ABS(szHyunJisu - nAtm) 
	nBaseJisu = 0
	if g_nJisu <> 0 and g_nJisu <> "" then
		nBaseJisu = Round(g_nJisu,2)
	end if
	nMinDiff = 0
	nMinIdx = 0

	for i = 0 to nCnt - 1
		nPrc = CDbl(Container0.GridAllC.GetCellData("bd_cell2", i))
		nHDiff = ABS(szHyunJisu - nPrc)
		
		if i = 0 then
			nMinDiff = nHDiff
		else
			if nHDiff < nMinDiff then
				nMinDiff = nHDiff
				nMinIdx = i
			end if
		end if
	next
	
	if nMinIdx <> g_nGIdx then
		if nMinDiff < nDiff then
			Container0.GridAllC.SetCellBgColor( "bd_cell2", g_nGIdx, "38:255255255" )
			Container0.GridAllC.SetCellBgColor( "bd_cell2", nMinIdx, "156:255253233")
			
'			nTopRow = 0
'			if nMinIdx > 3 then
'				nTopRow = nMinIdx - 4
'			end if
'			
'			if nTopRow ~= 0 then
'				Container0.scroll_pos = nTopRow * 47
'			end if
			
			g_nGIdx = nMinIdx
		end if
	else
		if g_bFirst = true then
			Container0.GridAllC.SetCellBgColor( "bd_cell2", g_nGIdx, "156:255253233" )
			g_bFirst = false
		end if
	end if
End Function
'20210630 HWG END
'============================================================================
'20230322 SWJ START : 매수/매도 팝업 추가 
'그리드 높이 맞추기 거의 불가함 : 기종별로 다름
'따라서, 위치 상관없이 팝업 처리하는 방식으로
'============================================================================
Sub Container0_GridAllC_OnClickUp(lRow, szCellID)
	g_szItemCode = Container0.GridAllC.GetCellData("bd_callcode" , lRow)
	g_nPrice = Container0.GridAllC.GetCellData("bd_callprc" , lRow)
	g_ndebi  = Container0.GridAllC.GetCellData("bd_calldebi" , lRow)

	DATAMANAGER.CancelRealData( "ohhts_optn_cntg_2" ) '콜실시간조회
	
	if szCellID == "bd_callprc" or szCellID == "bd_callsign" or szCellID == "bd_calldebi" then
		if g_szItemCode <> "" then
			
			szKorName = Form.GetItemCodeInfo(g_szItemCode, "name")
			lblLine.SetCellString(0, 0, szKorName)
			
			SetTblColor(g_nPrice, g_ndebi)
			
			DATAMANAGER.SetDataValue( 1, "ohhts_optn_cntg_2", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
			DATAMANAGER.RequestRealData( "ohhts_optn_cntg_2" ) '콜실시간조회
			
			SetPopupUI(1)
		end if
	end if
	
End Sub
'============================================================================
Sub Container0_GridAllP_OnClickUp(lRow, szCellID)	
	g_szItemCode = Container0.GridAllP.GetCellData("bd_putcode" , lRow)
	g_nPrice = Container0.GridAllP.GetCellData("bd_putprc" , lRow)
	g_ndebi  = Container0.GridAllP.GetCellData("bd_putdebi" , lRow)
	
	DATAMANAGER.CancelRealData( "ohhts_optn_cntg_2" ) '콜실시간조회
	
	if szCellID == "bd_putprc" or szCellID == "bd_putsign" or szCellID == "bd_putdebi" then	
		if g_szItemCode <> "" then
			szKorName = Form.GetItemCodeInfo(g_szItemCode, "name")
			lblLine.SetCellString(0, 0, szKorName)
			
			SetTblColor(g_nPrice, g_ndebi)
			
			DATAMANAGER.SetDataValue( 1, "ohhts_optn_cntg_2", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
			DATAMANAGER.RequestRealData( "ohhts_optn_cntg_2" ) '콜실시간조회
			
			SetPopupUI(1)
		end if
	end if
End Sub

'============================================================================
Sub SetPopupUI(sVisible)
	Image0.visible = sVisible
	lblLine.visible = sVisible
	btnBuy.visible = sVisible
	btnSell.visible = sVisible
	btnMado.visible = sVisible
	btnMasu.visible = sVisible
	
	Image5.left = 0
	Image0.left = 0
	lblLine.left = 111
	btnBuy.left = 267
	btnSell.left = 18
	btnMado.left = 18
	btnMasu.left = 267
End Sub
'============================================================================
Function SetTblColor(nPrice, nPrcVrss)
	if Cdbl(nPrcVrss) > 0 then
		lblLine.SetCellFgColor(1, 0, "10")
	elseif Cdbl(nPrcVrss) < 0 then
		lblLine.SetCellFgColor(1, 0, "11")
	else
		lblLine.SetCellFgColor(1, 0, "12")
	end if
		
	lblLine.SetCellString(1, 0, nPrice)
	lblLine.SetCellString(1, 1, nPrcVrss)
End Function
'============================================================================
Sub Image0_OnClick()
	SetPopupUI(0)
End Sub
'============================================================================
Sub btnMado_OnClick()
	szData = "현재가" & "★" & 1 & "★" & g_szItemCode & "★" & g_nPrice
	Form.SetSharedData("FUTHYUN_RETURN" , g_nPrice)
	
	Form.OpenScreen( "31030" , szData )
	Form.CloseForm()
End Sub

