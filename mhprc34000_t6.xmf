''''''''''''''''''''''''''''''''''''''''''''''-
' 01. 화 면 명 : 선옵현재가
' 02. 화면설명 : 선옵현재가 차트탭
' 03. 작    성 : 
''''''''''''''''''''''''''''''''''''''''''''''-
'20210223 HSZ 야간선물 제도개편 [기존 실시간 서비스 변경]
'			호가 : ohhts_cmef_aspr -> ohhts_efut_aspr
'			체결 : ohhts_cmef_cntg -> ohhts_efut_cntg

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemMarket
Dim g_szChrtType
Dim g_szToday
Dim g_szMinType
Dim g_szTicType
Dim g_flagMin
Dim g_flagTic
Dim g_flagWeek
Dim g_flagLine

g_szChrtType = "D" 	'일

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************
Function SetChart()
	Dim szValue, szValueMinTick

     szValue 			= Form.GetEnvData( "34000_CHARTSET" )
     szValueMinTick 	= Form.GetEnvData( "34000_CHARTSETMINTICK" )    
	
	if szValue = "" then
		 Form.SetEnvData( "chart_settingmintick" , "2^001" )
	     g_sPeriod 	 = "001"
	     g_sPeriodType = "2"
	else
		temp = split(szValue, "^")
		
	     g_sPeriodType = temp[0]
	     g_sPeriod 	 = temp[1]
	end if
	
	if szValueMinTick <> "" then
		temp1 = split(szValueMinTick, "^")
		g_szMinType = temp1[0]
		g_szTicType = temp1[1]
		
	else
		' 20190404 HWG START
		' 차트 분,틱 설정값 세팅 오류 수정
		szMin0 = Form.GetEnvData( "chart_min0" )
		szTic0 = Form.GetEnvData( "chart_tic0" )
	
		if szMin0 <> "" and szMin0 <> 0 then
			g_szMinType = szMin0
		else
			g_szMinType = "1"
		end if
		
		if szTic0 <> "" and szTic0 <> 0 then
			g_szTicType = szTic0
		else 
			g_szTicType = "1"
		end if
		' 20190404 HWG END    
	     
	end if
	
	'분틱 셋팅	
	tmpIndex = null 
	if g_sPeriodType = "0" or g_sPeriodType = "1" then
		if g_sPeriodType = "0" then
			g_TempIndex = 3
			g_szChrtType = "T"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			
		else
			g_TempIndex = 2
			g_szChrtType = "A"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
		end if
	
	else
		if g_sPeriodType = "2" then
			g_TempIndex = 0
			g_szChrtType = "D"		'PENTA13 START => 2023.08.08(차트성능개선)
			
		elseif g_sPeriodType = "3" then
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			RadioGroup0.SetRadioCaption( g_TempIndex, "주" )
			
		else
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			RadioGroup0.SetRadioCaption( g_TempIndex, "월" )
			
		end if
	
	end if
	 
	RadioGroup0.currentindex = g_TempIndex
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	g_flagInit = true
	g_flagMin = false
	g_flagTic = false
	g_flagWeek = false
	g_flagLine = false
	
	SetChart()
	PeriodSet(g_szChrtType)

	g_szToday = Form.GetSharedData("&HOST_DATE", 0 )
	RequestData()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	g_szItemCode   = Form.GetSharedData( "&ITEM_CMEEUREX", 0 )
	g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")	
'	ChartEx0.SetChartType("line")
	'MarketType Default : "CM"
	if Len(Trim(g_szItemMarket)) == 0 Then
		g_szItemMarket = "CM"			
	end if
	
	ChartEx0.SetLoadChart("future")
	ChartEx0.SetCMEChart("1") '20210721 HSZ 미달러 제도개선
	' 20190404 HWG START
	' 차트 분,틱 설정값 세팅 오류 수정
	szMin0 = Form.GetEnvData( "chart_min0" )
	szTic0 = Form.GetEnvData( "chart_tic0" )

	if szMin0 = "" or szMin0 = 0 then
		szMin0 = "1"
	end if
	
	if szTic0 = "" or szTic0 = 0 then
		szTic0 = "1"
	end if
	
	RadioGroup0.SetRadioCaption( 2, szMin0.."분" )
	RadioGroup0.SetRadioCaption( 3, szTic0.."틱" )
	' 20190404 HWG END
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		if g_szItemCode = sValue and g_flagInit = false then
			exit Sub
		end if
		
		If g_szItemMarket = "EM" Then
			DATAMANAGER.CancelRealData( "ohhts_efut_cntg" )
			
		elseif g_szItemMarket = "CM" then
'			DATAMANAGER.CancelRealData( "ohhts_cmef_cntg" )	'20210223 HSZ 야간선물 제도개편
			DATAMANAGER.CancelRealData( "ohhts_efut_cntg" )
		
		elseif g_szItemMarket = "CD" then
'			DATAMANAGER.CancelRealData( "ohhts_cusf_cntg" )	'20210712 HSZ 야간 미국달러선물 제도개편
			DATAMANAGER.CancelRealData( "ohhts_efut_cntg" )
			
		elseif g_szItemMarket = "EO" then
			DATAMANAGER.CancelRealData( "ohhts_eopt_cntg" )
			
		elseif g_szItemMarket = "EW" then					'20220307 HSZ 야간 위클리옵션 신규상장
			DATAMANAGER.CancelRealData( "ohhts_eopt_cntg" )
		End If
		
		g_szItemCode = sValue
		g_szItemMarket = Form.GetItemCodeInfo( g_szItemCode , "market_night")
		g_szItemName   = Form.GetItemCodeInfo( g_szItemCode , "name_night")
		
		
		'MarketType Default : "CM"로 결정
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "CM"			
		end if
		'20160705 NOHES END

		RequestData()
		
	end	if	
End Sub
'============================================================================
Function RequestData()
	if  g_szItemMarket = "CD" then
		ChartEx0.setDecimal("1") ' 미국달러인경우만 소수점 1자리
	else
		ChartEx0.setDecimal("2") ' 소수점 2자리
	end if
	
'	DATAMANAGER.CancelRealData("ohhts_cmef_cntg")	'20210223 HSZ 야간선물 제도개편
'	DATAMANAGER.CancelRealData("ohhts_cusf_cntg")	'20210712 HSZ 야간 미국달러선물 제도개편
	DATAMANAGER.CancelRealData("ohhts_efut_cntg")
	DATAMANAGER.CancelRealData("ohhts_eopt_cntg")
	
	PeriodSetChart(g_szChrtType)  '20230905 한국금융IT : 일주월분 차트 주기 설정
	
	if g_szChrtType = "T" then		' 틱		'PENTA13 START => 2023.08.08(차트성능개선)
	'if g_szChrtType = "0" then
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
	
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_DATE1" , 0,g_szToday)
			
		sTic = Split(g_szTicType, "틱", -1, 1)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_CNT1" , 0,sTic[0])  'n틱
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" , 0,"2") 
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_004r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0, "Y") 
	
		DATAMANAGER.RequestTranData("ohhts_5030_004r")	
		

	elseif g_szChrtType = "A" then	' 분		'PENTA13 START => 2023.08.08(차트성능개선)
	'elseif g_szChrtType = "1" then
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
	
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_DATE1" , 0,g_szToday)
		
		sMin = Split(g_szMinType, "분", -1, 1)
		sTemp = sMin[0] * 60

		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" , 0, sTemp)  'n분
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0,"Y")  '
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_003r", "InBlock2", "FID_INPUT_VRTL_TICK_INCU_YN" , 0,"N")
		
		DATAMANAGER.RequestTranData("ohhts_5030_003r")

	else
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock1", "FID_INPUT_ISCD" , 0,g_szItemCode)
	    
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0,g_szItemMarket)
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_ISCD" , 0,g_szItemCode)
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE" , 0,"Y")
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR" , 0,g_szChrtType)  'D/W/M/Y 일/주/월/년 
		DATAMANAGER.SetDataValue( 0, "ohhts_5030_001r", "InBlock2", "FID_INPUT_DATE1" , 0,g_szToday)
	
		DATAMANAGER.RequestTranData("ohhts_5030_001r")
	
	end if

end Function

'============================================================================
Sub BtnSave_OnClick()
	ChartEx0.SetOpenDlg("save;BtnSave")
End Sub

'============================================================================
Sub BtnIndi_OnClick()
	ChartEx0.SetOpenDlg("indicatormini;BtnIndi")
End Sub

'============================================================================
Sub BtnTool_OnClick()
	ChartEx0.SetOpenDlg("tools;BtnTool")
End Sub

'============================================================================
Sub RadioGroup0_OnClick(nIndex)
	if nIndex == 0 then  		'일
		g_flagMin = false
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "D"
		
		PeriodSet(g_szChrtType)
		
	elseif nIndex == 1 then	'주/월
		g_flagMin = false
		g_flagTic = false
		
		if g_flagWeek == false   then
			sTemp = RadioGroup0.GetRadioCaption(1)
			if sTemp == "월" then
				g_szChrtType = "M"
			else
				g_szChrtType = "W"
			end if
			
			g_flagWeek = true
			PeriodSet(g_szChrtType)
			
		else
			sTemp = RadioGroup0.GetRadioCaption(1)
			Form.OpenPopup( "mhcht13000_p3.xmf" , sTemp , "" )
			
		end if

	elseif nIndex == 2 then   '분
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "A"	'PENTA13 START => 2023.08.08(차트성능개선)
		'g_szChrtType = "1"
		
		if g_flagMin == false then
			g_flagMin = true
			tmpMin = split(RadioGroup0.GetRadioCaption(2), "분")
			g_szMinType = tmpMin[0]
			PeriodSet(g_szChrtType)
			
		else
			'g_flagMin = false
			If g_flagInit = true Then
				PeriodSet(g_szChrtType)
			Else
				Form.OpenPopup( "mhcht13000_p1.xmf" , g_szMinType , "" )
			End If
			
		end if
		
	elseif nIndex == 3 then   '틱
		g_flagMin = false
		g_flagWeek = false
		g_szChrtType = "T"	'PENTA13 START => 2023.08.08(차트성능개선)
		'g_szChrtType = "0"
		
		if g_flagTic == false then
			g_flagTic = true
			tmpTic = split(RadioGroup0.GetRadioCaption(3), "틱")
			g_szTicType = tmpTic[0]
			PeriodSet(g_szChrtType)
			
		else
			If g_flagInit = true Then
				PeriodSet(g_szChrtType)
			Else
				Form.OpenPopup( "mhcht13000_p2.xmf" , g_szTicType , "" )
			End If
			
		end if
	end if
	
End Sub

'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'============================================================================
function ChartEx0_OnGetPeriodInfo()
	Dim sPeriodType
	sPeriodType = ""
	Dim sMin, sTic
	
   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	for i = 0 to 8
		sMin = Form.GetEnvData( "chart_min"..i )	'분차트
		if sMin <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sMin&"/"
			else
				sPeriodType = sPeriodType&sMin&";"
			end if
		end if
	next
	
	for i = 0 to 8
		sTic = Form.GetEnvData( "chart_tic"..i )	'분차트
		if sTic <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sTic&"/"
			else
				sPeriodType = sPeriodType&sTic&";"
			end if
		end if
	next
	
	if sPeriodType <> "" then
		ChartEx0.setSyncPeriodValueToChart(sPeriodType)
	end if
end function

'=================================================================
function ChartEx0_OnChangePeriod(sPeriodType)
	sMinArr = {}
	sTicArr = {}
	sDataArr = {}
	
	g_sIsRequestChartEvent = "1"

   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
   if InStr(sPeriodType, "/") > 0 then
	   sTemp = split(sPeriodType, "/")
	   sMinArr = split(sTemp[0], ";")
	   sTicArr = split(sTemp[1], ";")
	   Form.Log("sPeriodType",sPeriodType)
	   
	   for i = 0 to 7 step 1
		Form.SetEnvData( 1, "chart_min"..i, sMinArr[i] )
		Form.SetEnvData( 1, "chart_tic"..i, sTicArr[i] )

	   next
   end if
   
end function
'============================================================================
' 차트 설정 개수 변경시
'============================================================================
function ChartEx0_OnByNumber(Count)
   if #Count == 1 then
	   Count = "000"..Count
   elseif #Count == 2 then
	   Count = "00"..Count
   elseif #Count == 3 then
	   Count = "0"..Count
   end if

	g_sChartCnt = Count
	
	RequestData()
end function

'============================================================================
' 분,틱 설정파일 저장
'============================================================================
function Save_ini()
	dim sMin, sTic, sflag
	
	for i = 0 to 6
		Form.SetEnvData( 1, "chart_mflag"..i, g_chartMinFlagArr[i] )
		Form.SetEnvData( 1, "chart_min"..i, g_chartMinArr[i] )
		Form.SetEnvData( 1, "chart_tflag"..i, g_chartTicFlagArr[i] )
		Form.SetEnvData( 1, "chart_tic"..i, g_chartTicArr[i] )
		
	next

'	Form.SetEnvData( 1, "chart_Count", g_sChartCnt )			' 데이터갯수...필요 없음 삭제 해도 됩니다.

end function

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "Chart_Min" then
		g_szMinType = sRet
		RadioGroup0.SetRadioCaption( 2, g_szMinType )
		tmpMin = split(RadioGroup0.GetRadioCaption( 2),"분")
		g_szMinType = tmpMin[0]
		
		PeriodSet(g_szChrtType)
		
	elseif sKeyName == "Chart_Tic" then
		g_szTicType = sRet		
		RadioGroup0.SetRadioCaption( 3, g_szTicType)
		tmpTic = split(RadioGroup0.GetRadioCaption( 3),"틱")
		g_szTicType = tmpTic[0]
		
		PeriodSet(g_szChrtType)
		
	elseif sKeyName == "Chart_WEEK" then	
		if sRet == "월" then
			g_szChrtType = "M"
		else
			g_szChrtType = "W"
		end if
		
		RadioGroup0.SetRadioCaption( 1, sRet )
		PeriodSet(g_szChrtType)
		
	end if
End Sub

'============================================================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'============================================================================
function PeriodSet(sPeriodType)
	if sPeriodType = "T" then		'PENTA13 START => 2023.08.08(차트성능개선)
	'if sPeriodType = "0" then
	   g_sPeriod = g_szTicType
	   g_sPeriodType = "0"
	
	elseif sPeriodType = "A" then	'PENTA13 START => 2023.08.08(차트성능개선)
	'elseif sPeriodType = "1" then
	   g_sPeriod = CInt(g_szMinType)
	   g_sPeriodType = "1"
	   
	elseif sPeriodType = "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod = "1"
	   
	elseif sPeriodType = "W" then 
	   g_sPeriodType = "3"
	   g_sPeriod = "1"
	    
	elseif sPeriodType = "M" then 
	   g_sPeriodType = "4"
	   g_sPeriod = "1"
	    
	end if
	
	sPeriod = CInt( g_sPeriod)
	if Len( sPeriod )= 1 then
		g_sPeriod = "00"..g_sPeriod
	elseif Len( sPeriod )= 2 then
		g_sPeriod = "0"..g_sPeriod
	end if

	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)

	' 조회TR 보내기
	RequestData()	
end function
'============================================================================
'20230905 한국금융IT START : 일주월분 차트 주기 설정
function PeriodSetChart(sPeriodType)
	if sPeriodType = "T" then
	'if sPeriodType = "0" then
	   g_sPeriod = g_szTicType
	   g_sPeriodType = "0"
	
	elseif sPeriodType = "A" then
	'elseif sPeriodType = "1" then
	   g_sPeriod = CInt(g_szMinType)
	   g_sPeriodType = "1"
	   
	elseif sPeriodType = "D" then 
	   g_sPeriodType = "2"
	   g_sPeriod = "1"
	   
	elseif sPeriodType = "W" then 
	   g_sPeriodType = "3"
	   g_sPeriod = "1"
	    
	elseif sPeriodType = "M" then 
	   g_sPeriodType = "4"
	   g_sPeriod = "1"
	    
	end if
	
	sPeriod = CInt( g_sPeriod )
	if Len( sPeriod )= 1 then
		g_sPeriod = "00"..g_sPeriod
	elseif Len( sPeriod )= 2 then
		g_sPeriod = "0"..g_sPeriod
	end if

	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
end function
'20230905 한국금융IT END : 일주월분 차트 주기 설정
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If g_szItemMarket = "EM" Then
		DATAMANAGER.SetDataValue( 1, "ohhts_efut_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_efut_cntg" )
		
	elseif g_szItemMarket = "CM" then
	'20210223 HSZ START 야간선물 제도개편 
'		DATAMANAGER.SetDataValue( 1, "ohhts_cmef_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
		DATAMANAGER.SetDataValue( 1, "ohhts_efut_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
'		DATAMANAGER.RequestRealData( "ohhts_cmef_cntg" )	'20210223 HSZ 야간선물 제도개편
		DATAMANAGER.RequestRealData( "ohhts_efut_cntg" )
	''20210223 HSZ END
	
	elseif g_szItemMarket = "CD" then
	'20210712 HSZ 야간 미국달러선물 제도개편
'		DATAMANAGER.SetDataValue( 1, "ohhts_cusf_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
		DATAMANAGER.SetDataValue( 1, "ohhts_efut_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
'		DATAMANAGER.RequestRealData( "ohhts_cusf_cntg" )
		DATAMANAGER.RequestRealData( "ohhts_efut_cntg" )
	
	Elseif g_szItemMarket = "EO" then
		DATAMANAGER.SetDataValue( 1, "ohhts_eopt_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_eopt_cntg" )
	
	Elseif g_szItemMarket = "EW" then	'20220307 HSZ 야간 위클리옵션 신규상장
		DATAMANAGER.SetDataValue( 1, "ohhts_eopt_cntg", "InBlock1", "FIDR_SHRN_ISCD" , 0 , g_szItemCode )
		DATAMANAGER.RequestRealData( "ohhts_eopt_cntg" )
	End If
	
	g_flagInit = false
	
End Sub

'============================================================================
function ChartEx0_OnRequestData(nIndex, sData)
	if sData = "" or sData = null then
		exit function
	end if
	
	Data = split(sData, ";")
	
   '현재가내의 차트에서는 종목코드를 변경하지 않는다.
	g_szItemCode    = Cstr(Trim(Data[0]))             '코드
	'Form.ShowAlert("g_szItemCode", g_szItemCode)

	g_sPeriodType	= Cstr(Trim(Data[1]))             '일주월년분틱
	g_sPeriod	= Cstr(Trim(Data[2]))             '주기(1,5,...)
	sRefresh		= Cstr(Trim(Data[3]))
	radioIndex	= ""
	
	if sRefresh = 1 or sRefresh = "1" or sRefresh = true then 
		g_sPeriodType = "2"
		g_sPeriod = "1"
		radioIndex = 0
		g_szChrtType = "D"
		
		sTic = Form.GetEnvData( "chart_tic0" )
		sMin = Form.GetEnvData( "chart_min0" )
		
		if sTic = "" then
			sTic = "1"
		end if
		
		if sMin = "" then
			sMin = "1"
		end if
		
		RadioGroup0.SetRadioCaption( 3, sTic.."틱" )
		RadioGroup0.SetRadioCaption( 2, sMin.."분" )
		
	else
		'PENTA13 START => 2023.07.04(차트성능개선)
		Select case g_sPeriodType
			case "0"
				g_szChrtType = "T"
				radioIndex = 3
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."틱")
				
			case "1"
				g_szChrtType = "A"
				radioIndex = 2
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."분")
				g_szMinType = g_sPeriod	'PENTA13 START => 2023.08.08(차트성능개선)
			
			case "2"
				g_szChrtType = "D"
				radioIndex = 0
			
			case "3"
				g_szChrtType = "W"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "주")
			
			case "4"
				g_szChrtType = "M"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "월")

		end Select
		'PENTA13 END
	end if
	
	'PENTA13 START => 2023.07.13(차트성능개선)
	if ChartEx0.GetDivideNum() == 1 then
		RadioGroup0.currentindex = radioIndex
	else
		RadioGroup0.setCurIndexSilent(radioIndex)
	end if
	
	Dim sDwmm
	sDwmm = ChartEx0.GetStateDWMM()
	if sDwmm == "0" then
		RadioGroup0.enable = 1
	end if
	'PENTA13 END
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
	
	' 종목코드 주기
	g_szItemMarket = Form.GetItemCodeInfo(g_szItemCode , "market_night")

	'MarketType Default : "CM"로 결정
	if Len(Trim(g_szItemMarket)) == 0 Then
		g_szItemMarket = "CM"			
	end if
	
	Form.SetItemCode(g_szItemCode)	
	RequestData()	
	
end function
'============================================================================
'PENTA13 START => 2023.07.25(차트성능개선)
function ChartEx0_OnSelectedChart(nIndex, sData)
	if sData == "" then
		Exit function
	end if

	if nIndex < 1 then
		Exit function
	end if

	Data = split(sData, ";")
	
	g_sPeriodType   = Cstr(Trim(Data[2]))
	g_sPeriod       = Cstr(Trim(Data[3]))
     
	if g_sPeriodType == "0" or g_sPeriodType == "1" then
		if g_sPeriodType == "0" then		'틱
			g_TempIndex = 3
			g_szChrtType = "T"
			g_szTicType = g_sPeriod
			
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			
		else								'분
			g_TempIndex = 2
			g_szChrtType = "A"
			g_szMinType = g_sPeriod
			
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
			
		end if
	
	else
		g_sPeriod = "1"
		
		if g_sPeriodType == "2" then		'일
			g_TempIndex = 0
			g_szChrtType = "D" 	'한국금융IT => 2023.07.04(차트성능개선)
			
		elseif g_sPeriodType == "3" then	'주
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			RadioGroup0.SetRadioCaption( g_TempIndex, "주" )
			
		else								'월
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			RadioGroup0.SetRadioCaption( g_TempIndex, "월" )
		
		end if
		
	end if
	
	RadioGroup0.setCurIndexSilent(g_TempIndex)

	Dim sDwmm
	sDwmm = ChartEx0.GetStateDWMM()
	if sDwmm == "1" then
		RadioGroup0.enable = 0
	end if

end function
'PENTA13 END
'============================================================================
Sub ChartEx0_OnScrollEnd()
	' Chart Next Data
	If g_szChrtType = "T" Then 							' 틱
	'If g_szChrtType = "0" Then
		DATAMANAGER.RequestNextData("ohhts_5030_004r")
	
	ElseIf g_szChrtType = "A" Then 						' 분
	'ElseIf g_szChrtType = "1" Then
		DATAMANAGER.RequestNextData("ohhts_5030_003r")
		
	Else
		DATAMANAGER.RequestNextData("ohhts_5030_001r")
		
	End If
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetEnvData( 1,"34000_CHARTSET" 			, g_sPeriodType.."^"..g_sPeriod )
	Form.SetEnvData( 1,"34000_CHARTSETMINTICK" 	, g_szMinType.."^"..g_szTicType )

	ChartEx0.SetSaveChart("3")	
End Sub
'============================================================================
Sub BtnLine_OnClick()
	if g_flagLine = false then
		g_flagLine = true
		ChartEx0.SetShowCrossLine("true")
		BtnLine.imgpath = "btn_chart01_o.9.png"
		
	else
		g_flagLine = false
		ChartEx0.SetShowCrossLine("false")
		BtnLine.imgpath = "btn_chart01_n.9.png"
		
	end if
End Sub
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "INIT_CODE" then
		g_szItemCode = sParam
		g_szItemMarket = Form.GetItemCodeInfo(g_szItemCode , "market_night")
		
		'MarketType Default : "F"로 결정
		if Len(Trim(g_szItemMarket)) == 0 Then
			g_szItemMarket = "CM"			
		end if
			
		RequestData()
	end if
End Sub

