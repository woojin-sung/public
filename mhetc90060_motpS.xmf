'============================================================================
' 2021.01.25 SWJ START : 모바일 OTP 인증 확인
' 2023.04.06 V001 양현정 휴대폰인증 맵id변경
'============================================================================
Dim g_sRetData, g_SuccFail, g_LoginType, g_OSType, sOpenFlag, g_sUserID
'============================================================================
Sub Form_OnFormInit()
	
	g_LoginType = Form.GetSharedData( "&LOGIN_TYPE", 0 )
	g_OSType = Form.GetSharedData("&OS_TYPE", false ) 'iOS("2")Android("1")
	g_sUserID = Form.GetSharedData("&USER_ID" , false)
	g_SuccFail = Form.GetOpenLinkData()
	
	if Len(g_SuccFail) < 1 then
		Exit Sub
	else
		Form.SetScreenName("모바일 OTP 인증오류")
		
		Container0.Label0.visible = false
		Container0.Label1.visible = false
		Container0.Label2.visible = false
		Container0.Label3.visible = false
		Container0.Image0.visible = false
		Container0.Button0.visible = false	
		
		Container0.Labelerror1.visible = true
		Container0.Labelerror3.visible = true
		Container0.Image1.visible = true
		Container0.ButtonCancel.visible = true
		Container0.ButtonCancel.enable = true
		
		if g_SuccFail == "motp_error5" then    '인증 비밀번호 5회 틀린 경우
			 Container0.Labelerror0.visible = true
			 Container0.Labelerror2.visible = true
			 Container0.ButtonReset.visible = true
			 Container0.ButtonReset.enable = true
		elseif g_SuccFail == "motp_error10" then	'인증 비밀번호 10회 틀린 경우/혹은 폐기상태인 경우
			 Container0.Labelerror4.visible = true
			 Container0.Labelerror5.visible = true
			 Container0.ButtonReset2.visible = true
			 Container0.ButtonReset2.enable = true
		end if
		
	end if
End Sub
'============================================================================
Sub Container0_Button0_OnClick()
	Form.CloseForm()
	Form.OpenScreen("41000", "")
End Sub
'============================================================================
Sub Container0_ButtonCancel_OnClick()
	Form.CloseForm()
	Form.OpenScreen("41000", "")
End Sub
'============================================================================
Sub Container0_ButtonReset_OnClick()
	
	if g_SuccFail == "motp_error10" then
		Form.SetSharedData( "mOTP_IntoClcd" , "MTS" )
		
		'로그인을 한번이라도 했었는지 판단
		if g_sUserID == "" or g_sUserID == null then
			Form.SetSharedData("BDM_NMETBSWRGB", "009")
			Form.OpenNextPopup("mbbdm85200","", "")
		else
			if Cint(g_LoginType) > 1 then '로그인상태
				Form.OpenNextPopup("mbotp86100","", "")
			else
				'Form.MsgBox("알림", "ID인증 또는 로그인이\n필요한 메뉴입니다.\n로그인하시겠습니까?", "LOG_FORCE", 1)
				'업무신청 화면으로 발급하도록 연결
				 Form.SetSharedData( "mOTP_IntoClcd" , "NMET_BSWR" )
				 Form.SetSharedData("BDM_FRST_MAPID", "screen41000")
				 Form.SetSharedData("BDM_NMETBSWRGB", "009")
				 
				 'V001
				 'Form.OpenNextPopup("mbbdm85110", "" , "" )
				 Form.OpenNextPopup("mbbdm86130", "" , "" )
			end if
		end if
		
	elseif g_SuccFail == "motp_error5" then
		If Cint(g_LoginType) > 1 Then '로그인 상태
			Form.SetSharedData("BDM_NMETBSWRGB", "301")
			'V001
			'Form.OpenNextPopup("mbbdm85110.xmf", "", "")
			Form.OpenNextPopup("mbbdm86130.xmf", "", "")
		else
			Form.MsgBox("알림", "ID인증 또는 인증 로그인이\n필요한 메뉴입니다.\n로그인하시겠습니까?", "LOG_REQ", 1)
		end if
	end if

End Sub
'============================================================================
Sub Container0_ButtonReset2_OnClick()
	
	'로그인을 한번이라도 했었는지 판단
	if g_sUserID == "" or g_sUserID == null then
		Form.SetSharedData("BDM_NMETBSWRGB", "009")
		Form.OpenNextPopup("mbbdm85200","", "")
	else
		Form.SetSharedData( "mOTP_IntoClcd" , "MTS" )
		
		if Cint(g_LoginType) > 1 then '로그인상태
			Form.OpenNextPopup("mbotp86100","", "")
		else
			'Form.MsgBox("알림", "ID인증 또는 로그인이\n필요한 메뉴입니다.\n로그인하시겠습니까?", "LOG_FORCE", 1)
			'업무신청 화면으로 발급하도록 연결
			Form.SetSharedData( "mOTP_IntoClcd" , "NMET_BSWR" )
			Form.SetSharedData("BDM_FRST_MAPID", "screen41000")
			Form.SetSharedData("BDM_NMETBSWRGB", "009")
			'V001
			'Form.OpenNextPopup("mbbdm85110", "" , "" )
			Form.OpenNextPopup("mbbdm86130", "" , "" )
		end if
	end if

End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "LOG_REQ" Then
		' IOS "openPrevScreen api없으므로 시장종합으로 일단 돌림.
		if g_OSType == "2" Then	'iOS("2")Android("1")
			
			if sRet == "ok" then
				Form.SetSharedData("&90060_motpS", "LOGIN_REQ")
				Form.OpenNextPopup("mhetc90021" , "" , "")
			else	
				Form.CloseForm()
				Form.OpenScreen("41000", "")
			end if
			
		else
			
			if sRet == "ok" then
				Form.SetSharedData("&90060_motpS", "LOGIN_REQ")
				Form.OpenNextPopup("mhetc90021" , "" , "")
			else
				Form.CloseForm()
				Form.openPrevScreen()			
			end if
			
		end if
		
	elseif sKeyName == "LOG_FORCE" then
		' IOS "openPrevScreen api없으므로 시장종합으로 일단 돌림.
		if g_OSType == "2" Then	'iOS("2")Android("1")
			
			if sRet == "ok" then
				Form.SetSharedData("&90060_motp", "LOG_FORCE")
				Form.OpenNextPopup("mhetc90021" , "" , "")
			else
				Form.CloseForm()
				Form.OpenScreen("41000", "")
			end if
			
		else
			
			if sRet == "ok" then
				Form.SetSharedData("&90060_motp", "LOG_FORCE")
				Form.OpenNextPopup("mhetc90021" , "" , "")
			else
				Form.CloseForm()
				Form.openPrevScreen()			
			end if
		end if
		
	End if

End Sub
'============================================================================
Sub Container0_Image5_OnClick()
	Form.CloseForm()
End Sub
