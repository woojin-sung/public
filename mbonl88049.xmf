	<SCRIPT_INFO _len="5611" _ulen="5473" >
--===========================================================================
--===========================================================================
Dim g_sPlainRm
Dim g_sPopupCheckYN
Dim g_sCheckYN
Dim g_sACNO
'============================================================================
Function f_SetBtnEnable()
	if g_sCheckYN == "Y" then
		BtnProcess.enable = false	
	else
		if g_sPopupCheckYN == "Y" then
			BtnProcess.enable = true
		else
			BtnProcess.enable = false
		end if
	end if
End Function
'============================================================================
Sub Form_OnFormInitBefore()
	g_sPlainRm = Form.GetSharedData("&PLAIN_RM", FALSE )
End Sub

'============================================================================
Sub Form_OnFormInit()
	'Image0.imgpath = "img_bgbox.9.png"
	Label1.fgcolor = "4"
	if cmbAcct.caption <> "" and cmbAcct.caption <> null then
		g_sPopupCheckYN = "N"
		DATAMANAGER.RequestTranData( "obacp_opop_065r" )
		DATAMANAGER.RequestTranData( "obpds_srvc_432r" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim nPassword
	If g_sPlainRm = "1" Then
		nPassword = edtPswd.caption
	Else
		nPassword = Form.GetEncData(edtPswd.caption)
	End If
		
	if szTranID == "obacp_opop_065r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO", 0, cmbAcct.total )
	elseif szTranID == "obpds_srvc_432r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO", 0, cmbAcct.total )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNT_PWD", 0, nPassword )
	elseif szTranID == "obpds_srvc_431a" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "PROS_CLS_CODE", 0, "I" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "CONT_CLS_CODE", 0, "4" )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNO", 0, cmbAcct.total )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ASNO", 0, g_sACNO )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "ACNT_PWD", 0, nPassword )
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacp_opop_065r" then
		dim nDataCnt
		nDataCnt = CInt( DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1"))
		
		if nDataCnt > 0 then
			dim sPRCD, szAcntState
			
			For i=0 To nDataCnt-1 
				sPRCD = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "PRCD", i )
				szAcntState = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "ACNT_STAT_CODE", i )
				if (sPRCD == "100" or sPRCD == "105" or sPRCD == "106" 
					or sPRCD == "107" or sPRCD == "117" or sPRCD == "119")
					and szAcntState == "1" then
						
					g_sACNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "ASNO", i )
					Exit For
				end if
			Next
			
			if g_sACNO == "" or g_sACNO == null then
				g_sACNO = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "ASNO", 0 )
			end if
		end if
		
		if g_sACNO == "" or g_sACNO == null then
			g_sACNO = cmbAcct.sequence
		end if
		
	elseif szTranID == "obpds_srvc_432r" then
		dim szCheckYN
		szCheckYN = Trim(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "RISK_NTIC_AGRM_YN", 0 ))
		
		if szCheckYN == "Y" then
			g_sCheckYN = "Y"
			tblState.SetCellString(0, 1, "확인")
		else
			g_sCheckYN = "N"
			tblState.SetCellString(0, 1, "미확인")
		end if
		
		f_SetBtnEnable()
	elseif szTranID == "obpds_srvc_431a" then
		DATAMANAGER.RequestTranData( "obpds_srvc_432r" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	if szSubMsg <> "" and szSubMsg <> null then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	else
		Form.ShowAlert("알림", szErrMsg )
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "mbonl82020_p6" then
		if sRet == "코넥스 투자자 위험고지문" then
			g_sPopupCheckYN = "Y"
			'Image0.imgpath = "img_bg.9.png"
			'Label1.fgcolor = "62"
			f_SetBtnEnable()
		else
			f_SetBtnEnable()
		end if
	end if
End Sub

'============================================================================
Sub Button0_OnClick()
	dim sURLheader, sURL
	
	If g_ServerMode == "1" Then	'개발기
		sURLheader = "http://home.imeritz.com/include/resource/comm/ctcn/files/"
	Else
		sURLheader = "http://home.imeritz.com/include/resource/comm/ctcn/files/"
	End If
	sURL = sURLheader & "talk_yk33.pdf"

	Form.SetSharedData("OPEN_URL", sURL )
	Form.OpenFramePopup("mbonl82020_p6" , "코넥스 투자자 위험고지문", "")
End Sub



'============================================================================
Sub BtnProcess_OnClick()
	if edtPswd.caption == "" or edtPswd.caption == null then
		Form.ShowAlert("알림", "계좌 비밀번호를 입력해 주세요.")
		
		Exit Sub
	end if
	
	if g_sPopupCheckYN == "Y" then
		DATAMANAGER.RequestTranData( "obpds_srvc_431a" )
	else
		Form.ShowAlert("알림", "코넥스 투자자 위험고지문을 확인해 주세요.")
	end if
End Sub

'============================================================================
Sub cmbAcct_ChangeAccount()
	if cmbAcct.caption <> "" and cmbAcct.caption <> null then
		g_sPopupCheckYN = "N"
		DATAMANAGER.RequestTranData( "obacp_opop_065r" )
		DATAMANAGER.RequestTranData( "obpds_srvc_432r" )
	end if
End Sub

