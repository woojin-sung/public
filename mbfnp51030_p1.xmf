	<SCRIPT_INFO _len="3958" _ulen="3514" >
'============================================================================
' 01.화면명 		: 펀드매매
' 02.화면설명		: 펀드매매_취소확인창
' 03.작성		: 2016.02.26
' 04.설명		: obacp_opop_068r	-> 공인인증 -> obsai_deal_070a(취소)	
' 05.수정		: 2020.09.15 비밀번호 메모리 평문 노출 취약점 조치 v001 
'                       : 2022.06.21 매도취소화면으로부터 '매도방법구분코드' 추가 v002
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szFullAcnt	'계좌번호 (8+2)
'dim	g_szPasswd	'계좌비밀번호
dim	g_szAlertTitle'알림타이틀

dim	g_szFundName, g_szOrdno, g_szReqDate, g_szAplDate 
dim	g_szDealDate,	g_szBuySell, g_szReqQty, g_szReqAmt,	g_szRmndSrno, g_szIiscSelnFormClsCode
	
g_szFullAcnt	=""
'g_szPasswd	=""

g_szFundName =""	'펀드명
g_szOrdno=""		'주문번호
g_szReqDate=""	'신청일자
g_szAplDate=""	'기준가적용일
g_szDealDate=""	'결제일
g_szBuySell=""	'매매구분
g_szReqQty="" 	'신청좌수
g_szReqAmt=""		'신청금액
g_szRmndSrno	=""	'잔고번호
g_szAlertTitle	="알림"
g_szIiscSelnFormClsCode = ""     ' 매도방법구분코드 v002


'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	dim	szOpenData

	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
    
		g_tData = Split(szOpenData, "★")
		
		g_szFundName		                = 	g_tData[0]	'펀드명
		g_szOrdno		                = 	g_tData[1]	'주문번호
		g_szReqDate		                =		g_tData[2]	'신청일자
		g_szAplDate		                =		g_tData[3]	'기준가적용일
		g_szDealDate		                =		g_tData[4]	'결제일
		g_szBuySell		                =		g_tData[5]	'매매구분
		g_szReqQtyAmt		                =		g_tData[6]	'신청좌수금액
		g_szRmndSrno		                =		g_tData[7]	'잔고번호		
		g_szFullAcnt		                =		g_tData[8]	'계좌번호
		g_szIiscSelnFormClsCode           =		g_tData[9]	'매도방법구분코드 v002
	
		
		'종목명 긴 경우, 멀티라인 2줄까지만 출력되도록..
		if Len(g_szFundName) > 45 then
			lblFndName.fontsize = -2
		else
			lblFndName.fontsize = 0
		end if
		
		lblFndName.caption	=	g_szFundName
		
		szProdCd 	=	Form.GetAccountInfo(g_szFullAcnt, "productcode")
		szProdText	=	Form.GetMetaData("상품코드", szProdCd)
		
		szAccountInfo = "["& szProdText & "] " & Left(g_szFullAcnt,4) & "-" & Mid(g_szFullAcnt,5,4) & "-" & Right(g_szFullAcnt,2)
		
		tbl01.SetCellString(1, 1, szAccountInfo)
		
		tbl01.SetCellString(2, 1, g_szBuySell)
		
		lblQtyAmt.caption = g_szReqQtyAmt
		if	trim(g_szBuySell)	=	"매수"	then
			lblQtyAmt.mask="0,0,,원,0,,0,1,0,0,0"
		else
		    IF TRIM(g_szIiscSelnFormClsCode) = "01" THEN '01.금액매도
			    lblQtyAmt.mask="0,0,,원,0,,0,1,0,0,0"
			ELSE	'좌수매도or전액매도
				lblQtyAmt.mask="0,0,,좌,0,,0,1,0,0,0"
			END IF
		end	if

	end if
	
End Sub

'============================================================================
'btnCloseBot_OnClick	:	닫기
'============================================================================
Sub btnCloseBot_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'btnOK_OnClick	:	확인버튼
'============================================================================
Sub btnOK_OnClick()
	Form.SendReturnToParent( "mbfnp51030_p1" , "cancel")
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
