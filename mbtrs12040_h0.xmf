'	g_szrdoCNTG = arrData(0)
'	g_szrdoMedosu = arrData(1)

End Sub

'============================================================================
Sub Form_OnFormInit()

	Dim szData, arrData

	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if
	
	g_szrdoCNTG = arrData(0)
	g_szrdoMedosu = arrData(1)
	g_szOderDate = arrData(2)
	rdoCNTG.currentindex = g_szrdoCNTG
	'rdoMedosu.currentindex = g_szrdoMedosu
	Combo0.currentindex = g_szrdoMedosu
	calOderDate.caption = g_szOderDate
	
	btnSearch_OnClick()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szDate, szACNO, szASNO
	
	szACNO = acnt0.total
	szASNO = acnt0.sequence
	'일자변수 수정(HOST_DATE==>BIZ_DT), 20160810
	'szDate = Form.GetSharedData( "&HOST_DATE", false )
	szDate = Form.GetSharedData( "&BIZ_DT", false )
	
	if rdoCNTG.currentindex == "2" then
		calOderDate.caption = szDate
		calOderDate.enable = false
	else
		szDate = calOderDate.caption
		calOderDate.enable = true
	end if
	
	If szTranID = "obtrs_cntg_638r" Then
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "ACNO"			, 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "ASNO"			, 0 , szASNO )
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "ODER_DATE"		, 0 , szDate )
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "IQRY_CLS_CODE"	, 0 , "8" ) '20160706 4->8로수정
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "PROS_CLS"		, 0 , "2" )
		DATAMANAGER.SetDataValue( 0, "obtrs_cntg_638r", "InBlock1", "DATA_CLS"		, 0 , "0" )
	
	ElseIf szTranID = "obtrs_comn_612r" Then	
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_612r", "InBlock1", "ACNO" 				, 0 , szACNO )
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_612r", "InBlock1", "ASNO" 				, 0 , szASNO )
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_612r", "InBlock1", "ODER_DATE" 			, 0 , szDate )
		DATAMANAGER.SetDataValue( 0, "obtrs_comn_612r", "InBlock1", "UI_SORT_STND_CODE"	, 0 , "1" )	'1:역순
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iCnt, szData, szData2
	Dim szItem, szMarket
	
	For iCnt = grd0.rowcount - 1 To 0 Step -1
	
		szItem = grd0.GetCellData( "bd_cell14", iCnt)
		szMarket = Form.GetItemCodeInfo(szItem, "market")
		
		If szMarket = "BN" Or szMarket = "MM" Then
			grd0.SetDeleteRow( iCnt )
		Else
			'매매구분
			szData = grd0.GetCellData( "bd_cell18", iCnt)		'매수/매도구분(1매도, 2매수)
			szData2 = grd0.GetCellData( "bd_cell15", iCnt)	'정정/취소구분(1신규,2정정, 3취소)
			szData3	= grd0.GetCellData( "bd_cell16", iCnt)		'신용주문구분코드
			szData4	= grd0.GetCellData( "bd_cell17", iCnt) 		'대출상세유형코드
					
			If szData2 = "1" Then									'정상
				Select Case szData3				'보통
					Case "10"
						If szData = "1" Then
							If szData4 = "0201" Then
								grd0.SetCellData("bd_cell2", iCnt, "예탁담보매도")
							Else
								grd0.SetCellData("bd_cell2", iCnt, "매도")
							End If
							grd0.SetCellFgColor("bd_cell2", iCnt, "11")
						Else
							grd0.SetCellData("bd_cell2", iCnt, "매수")
							grd0.SetCellFgColor("bd_cell2", iCnt, "10")
						End If
					
					Case "21", "31"								'신용매수
						grd0.SetCellData("bd_cell2", iCnt, "신용매수")
						grd0.SetCellFgColor("bd_cell2", iCnt, "10")
					
					Case "22", "32"								'신용매도
						grd0.SetCellData("bd_cell2", iCnt, "신용매도")
						grd0.SetCellFgColor("bd_cell2", iCnt, "11")
					
					Case "23", "33"								'대주매도
						grd0.SetCellData("bd_cell2", iCnt, "대주매도")
						grd0.SetCellFgColor("bd_cell2", iCnt, "11")
	
					Case "24", "34"								'대주매수
						grd0.SetCellData("bd_cell2", iCnt, "대주매수")
						grd0.SetCellFgColor("bd_cell2", iCnt, "10")
					
				End Select
			ElseIf szData2 = "2" Then								'정정
				If szData = "1" Then
					grd0.SetCellData("bd_cell2", iCnt, "매도정정")
					grd0.SetCellFgColor("bd_cell2", iCnt, "11")
				Else
					grd0.SetCellData("bd_cell2", iCnt, "매수정정")
					grd0.SetCellFgColor("bd_cell2", iCnt, "10")
				End If
				
			ElseIf szData2 = "3" Then								'취소
				If szData = "1" Then
					grd0.SetCellData("bd_cell2", iCnt, "매도취소")
					grd0.SetCellFgColor("bd_cell2", iCnt, "11")
				Else
					grd0.SetCellData("bd_cell2", iCnt, "매수취소")
					grd0.SetCellFgColor("bd_cell2", iCnt, "10")
					
				End If
			End If
		
			'원주문번호
	'		If grd0.GetCellData( "bd_cell10", iCnt) = "0" Then
	'			grd0.SetCellData("bd_cell10", iCnt, "")
	'		End If
			
			'주문종류
'			szData = grd0.GetCellData( "bd_cell3", iCnt)
'			Select Case szData
'				Case "01" grd0.SetCellData("bd_cell3", iCnt, "보통")
'				Case "05" grd0.SetCellData("bd_cell3", iCnt, "시장가")
'				Case "06" grd0.SetCellData("bd_cell3", iCnt, "조건부")
'				Case "09" grd0.SetCellData("bd_cell3", iCnt, "자사주")
'				Case "10" grd0.SetCellData("bd_cell3", iCnt, "자사주S-OPTION")
'				Case "11" grd0.SetCellData("bd_cell3", iCnt, "자사주금전신탁")
'				Case "12" grd0.SetCellData("bd_cell3", iCnt, "최유리")
'				Case "13" grd0.SetCellData("bd_cell3", iCnt, "최우선")
'				Case "20" grd0.SetCellData("bd_cell3", iCnt, "코넥스경매매")
'				Case "51" grd0.SetCellData("bd_cell3", iCnt, "장중대량")
'				Case "52" grd0.SetCellData("bd_cell3", iCnt, "장중바스켓")
'				Case "53" grd0.SetCellData("bd_cell3", iCnt, "장중경쟁대량")
'				Case "61" grd0.SetCellData("bd_cell3", iCnt, "장전시간외")
'				Case "62" grd0.SetCellData("bd_cell3", iCnt, "장전시간외대량")
'				Case "63" grd0.SetCellData("bd_cell3", iCnt, "장전시간외바스켓")
'				Case "64" grd0.SetCellData("bd_cell3", iCnt, "장전시간외경쟁대량")
'				Case "67" grd0.SetCellData("bd_cell3", iCnt, "장전시간외자사주신탁")
'				Case "69" grd0.SetCellData("bd_cell3", iCnt, "장전시간외대량")
'				Case "71" grd0.SetCellData("bd_cell3", iCnt, "시간외종가")
'				Case "72" grd0.SetCellData("bd_cell3", iCnt, "시간외대량")
'				Case "77" grd0.SetCellData("bd_cell3", iCnt, "금전신탁자사주시간외대량")
'				Case "79" grd0.SetCellData("bd_cell3", iCnt, "자사주시간외대량")
'				Case "80" grd0.SetCellData("bd_cell3", iCnt, "시간외바스켓")
'				Case "81" grd0.SetCellData("bd_cell3", iCnt, "시간외단일가")
'				Case "X1" grd0.SetCellData("bd_cell3", iCnt, "ECN")
'				Case Else grd0.SetCellData("bd_cell3", iCnt, szData)
'			End Select
			
			'처리구분
			szData = grd0.GetCellData( "bd_cell13", iCnt)
			Select Case szData
				Case "0" grd0.SetCellData("bd_cell13", iCnt, "미접수")
				Case "1" grd0.SetCellData("bd_cell13", iCnt, "접수")
				Case "2" grd0.SetCellData("bd_cell13", iCnt, "확인")
				Case "3" grd0.SetCellData("bd_cell13", iCnt, "거부")
				Case "4" grd0.SetCellData("bd_cell13", iCnt, "PT효력정지")
				Case Else grd0.SetCellData("bd_cell13", iCnt, szData)
			End Select
			
			'대출일자
			szData = grd0.GetCellData( "bd_cell12", iCnt)
			If szData = "00000000" Then
				grd0.SetCellData("bd_cell12", iCnt, "")
			End If
		End If
	Next
	
End Sub

