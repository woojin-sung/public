Sub btnClose_OnClick()
	Dim szData
	'szData = rdoCNTG.currentindex & "|" & rdoMedosu.currentindex & "|" &  acnt0.caption
	szData = rdoCNTG.currentindex & "|" & Combo0.currentindex & "|" &  acnt0.caption & "|" & calOderDate.caption
	
	Form.CloseForm()
	Form.SendReturnToParent("mbtrs12040" , szData)
End Sub

