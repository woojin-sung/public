	<SCRIPT_INFO _len="8924" _ulen="8466" >
'(증권 잔액조회)
' - 증권비밀번호 불필요
'
'(은행 잔액조회)
' - 은행비밀번호 필요
'
' (입금)
' - 은행비밀번호 필요 & 공동인증 필요
'
' (출금)
' -증권비밀번호 필요 & 공동인증 필요
'============================================================================

Dim g_szAccountNumber	'계좌번호(8자리)
Dim g_szAccountSerialNumber	'계좌일련번호(2자리)
Dim g_szAccountPassword	'계좌비밀번호
Dim g_szAccountName		'계좌이름
Dim g_szPrcd
Dim g_szPrnm
Dim g_szMangBrcd
Dim g_szMangBrcdName
Dim g_nDrngAbleAmt
Dim g_szBankCode
Dim g_szBankName
Dim g_szBankAcnt

'============================================================================
Sub Form_OnFormInit()

    g_szAccountNumber       = ""
    g_szAccountSerialNumber = ""
    g_szAccountPassword     = ""
    g_szAccountName         = ""
    g_szPrcd                = ""
    g_szPrnm                = ""
    g_szMangBrcd            = ""
    g_szMangBrcdName        = ""
    g_nDrngAbleAmt          = 0
    g_szBankCode            = ""
    g_szBankName            = ""
    g_szBankAcnt            = ""
    
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

    If sEventName == "AllAccount" Or sEventName == "Password" Then '계좌전체
    
        Dim szList
        szList = Split(sParam, "★")
		
        If UBOUND(szList) < 1 Then
            Exit Sub
        End If

        g_szAccountNumber = szList(0)
        g_szAccountSerialNumber = szList(1)
	
        If szList(2) <> "" Then
            g_szAccountPassword = szList(2)
        Else
            g_szAccountPassword = ""
        End If
		
        if szList(3) <> "" then
            g_szAccountName = szList(3)
        else
            g_szAccountName = ""
        end if

        if szList(4) <> "" then
            g_szPrcd = szList(4)
        else
            g_szPrcd = ""
        end if

        if szList(5) <> "" then
            g_szPrnm = szList(5)
        else
            g_szPrnm = ""
        end if
	
        if szList(6) <> "" then
            g_szMangBrcd = szList(6)
        else
            g_szMangBrcd = ""
        end if

        if szList(7) <> "" then
            g_szMangBrcdName = szList(7)
        else
            g_szMangBrcdName = ""
        end if

        if szList(8) <> "" then
            g_nDrngAbleAmt = szList(8)
        else
            g_nDrngAbleAmt = 0
        end if	

        if szList(9) <> "" then
            g_szBankCode = szList(9)
        else
            g_szBankCode = ""
        end if

        if szList(10) <> "" then
            g_szBankName = szList(10)
        else
            g_szBankName = ""
        end if

        if szList(11) <> "" then
            g_szBankAcnt = szList(11)
        else
            g_szBankAcnt = ""
        end if

        edtBankName.caption = g_szBankName
        edtBankAcnt.caption = g_szBankAcnt
        lblBankCode.caption = g_szBankCode		
	
        edtAbleAmt.caption  = g_nDrngAbleAmt '증권계좌잔고
        edtOutAmt01.caption = ""             '출금금액
	
        If Trim(g_szBankAcnt) <> "" Then
            btnDrng.enable = True
        Else
            btnDrng.enable = False
        End If

    End If

End Sub

'============================================================================
Sub btnIqry_OnClick()
    DATAMANAGER.SetDataValue(0, "obacb_balc_025r", "InBlock1", "ACNO", 0 , g_szAccountNumber)	'계좌번호
    DATAMANAGER.RequestTranData("obacb_balc_025r")
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
    If szTranID == "obtss_elbs_129r" Then
        lblAcnm.caption = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ACNM" , 0)
        Form.OpenPopup( "mbbnk61020_p1" , "" , "" )
    End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)	

    szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    
    If Trim(szSubMsg) == "" Then
        Form.ShowAlert( "알림", szErrMsg )
    Else
        Form.ShowAlert( "알림", szErrMsg .. "\n(" .. szSubMsg ..")")
    End If
    
End Sub

'============================================================================
' btn100_OnClick - 이체금액 100만 버튼
'============================================================================
Sub btn100_OnClick()
	Dim tempNum
	tempNum = edtOutAmt01.caption
	edtOutAmt01.caption = tempNum + 1000000
End Sub

'============================================================================
' btn50_OnClick - 이체금액 50만 버튼
'============================================================================
Sub btn50_OnClick()
	Dim tempNum
	tempNum = edtOutAmt01.caption
	edtOutAmt01.caption = tempNum + 500000
End Sub

'============================================================================
' btn10_OnClick - 이체금액 10만 버튼
'============================================================================
Sub btn10_OnClick()
	Dim tempNum
	tempNum = edtOutAmt01.caption
	edtOutAmt01.caption = tempNum + 100000
End Sub


'============================================================================
' btn5_OnClick - 이체금액 5만 버튼
'============================================================================
Sub btn5_OnClick()
	Dim tempNum
	tempNum = edtOutAmt01.caption
	edtOutAmt01.caption = tempNum + 50000
End Sub


'============================================================================
' btn1_OnClick - 이체금액 1만 버튼
'============================================================================
Sub btn1_OnClick()
	Dim tempNum
	tempNum = edtOutAmt01.caption
	edtOutAmt01.caption = tempNum + 10000
End Sub

'============================================================================
' btnAll_OnClick - 이체금액 전액버튼
'============================================================================
Sub btnAll_OnClick()
	edtOutAmt01.caption = edtAbleAmt.caption
End Sub


'============================================================================
Sub btnMod_OnClick()
	edtOutAmt01.caption =""
End Sub

'============================================================================
Sub btnDrng_OnClick()

	if Len(edtOutAmt01.caption) == 0 Or CDbl(edtOutAmt01.caption) == 0 then
		Form.MsgBox( "알림", "이체 금액을 확인하세요.", "", 0 )
		Exit Sub
	end if
	
	if Len(edtBankAcnt.caption) == 0 then
		Form.MsgBox( "알림", "은행계좌번호를 확인 하세요", "", 0 )
		Exit Sub
	end if		
	
	if Len(edtAbleAmt.caption) == 0 Or CDbl(edtAbleAmt.caption) == 0 then
		Form.MsgBox( "알림", "이체가능금액을 확인하세요.", "", 0 )
		Exit Sub
	end if
	
	if CDbl(edtAbleAmt.caption) <  CDbl(edtOutAmt01.caption) then
		Form.MsgBox( "알림", "이체 금액이 이체가능 금액보다 큽니다.", "", 0 )
		Exit Sub
	end if
	
	if Len(g_szAccountPassword) == 0 Then
		Form.MsgBox( "알림", "비밀번호를 확인 하세요.", "", 0 )
		Exit Sub
	end if	
	
	DATAMANAGER.SetDataValue(0 , "obtss_elbs_129r" , "InBlock1" , "MNRC_BANK_CODE"     , 0 , Trim(lblBankCode.caption))
	DATAMANAGER.SetDataValue(0 , "obtss_elbs_129r" , "InBlock1" , "JOB_TRNO"           , 0 , "031")
	DATAMANAGER.SetDataValue(0 , "obtss_elbs_129r" , "InBlock1" , "MNRC_ACNO"          , 0 , Trim(edtBankAcnt.caption))
	DATAMANAGER.SetDataValue(0 , "obtss_elbs_129r" , "InBlock1" , "TR_AMT"             , 0 , Trim(edtOutAmt01.caption))
	DATAMANAGER.SetDataValue(0 , "obtss_elbs_129r" , "InBlock1" , "DRNG_ACNO"          , 0 , g_szAccountNumber)
	DATAMANAGER.SetDataValue(0 , "obtss_elbs_129r" , "InBlock1" , "ACNT_PROD_CLS_CODE" , 0 , g_szAccountSerialNumber)
	DATAMANAGER.SetDataValue(0 , "obtss_elbs_129r" , "InBlock1" , "PWD"                , 0 , g_szAccountPassword)
	DATAMANAGER.SetDataValue(0 , "obtss_elbs_129r" , "InBlock1" , "RMRK"               , 0 , "")
	DATAMANAGER.RequestTranData("obtss_elbs_129r")
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

    if sKeyName = "INFO_POPUP" then
        sData = ""
        if sRet == "OK" then
            sData = g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & g_szAccountName & "★" & g_szAccountPassword & "★" &
                    edtBankName.caption & "★" & edtBankAcnt.caption & "★"& edtOutAmt01.caption  & "★" & lblBankCode.caption  & "★" & lblAcnm.caption
            Form.OpenPopup("mbbnk61020_p3" , sData , "")
        end if
	
    elseif sKeyName = "CORNFORM_POPUP" then
    
        if sRet == "OK" then
            edtOutAmt01.caption = ""
            Form.triggerEvent("#" , "CORNFORM_OK", "2")
        end if
	
    end if
    
End Sub

