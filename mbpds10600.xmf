'--===========================================================================
' 01. 화 면 명 : CFD 증거금 자동관리 신청/해지
' 02. 화면설명 : CFD 증거금 자동관리 신청/해지
' 03. 작    성 : 2022.02.17 김수진 
' 04. 수    정 : 
' 2022.05.04 : 김수진 : v0001 : CFD 증거금 자동관리 서비스 이용약관 URL 적용
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szPlain_rm		'메모리 평문적용 여부
Dim g_szTactACNO		'연결계좌
Dim g_szSvcSrno		'서비스일련번호

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_ClearData() : 초기화
'============================================================================
Function f_Clear()
	If tabChange.currenttab == 0 or tabChange.currenttab == "0" Then
		tabChange.page0.tblState.SetCellString( 0 , 2, "")	'약정등록상태
		tabChange.page0.ChkView0.chksilence = "0"			'약관 Chk
		tabChange.page0.cmbTactAcct.clear = true				'연결계좌
		tabChange.page0.cmbTactAcct.enable = false			'연결계좌
		btnOK.caption = "신청"
	Else
		tabChange.page1.grdList.SetClear()	'조회내역
		btnOK.caption = "해지"
	End If
	g_szTactACNO = ""	'연결계좌번호
	g_szSvcSrno = ""	'서비스일련번호
End Function
'===========================================================================
' f_GetPWCkeck() : 계좌비밀번호 입력체크함수
'===========================================================================
Function f_GetPWCkeck()
	Dim szACNT_PWD 
	szACNT_PWD = Form.GetCtlProp( "edtPswd", "caption" )

	If szACNT_PWD == null or szACNT_PWD == "" Then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	End If
	
	return false
End Function	
 
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnFormInit() 
'============================================================================
Sub Form_OnFormInit()
	f_Clear() 
	edtPswd.caption = ""
	
	'메모리평문적용여부(0:미적용 / 1:적용)
	g_szPlain_rm 		= Form.GetSharedData("&PLAIN_RM", false)
End Sub

'============================================================================
' Form_OnPopupReturn() 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'CFD 증거금 자동관리 서비스 이용약관 팝업에서 확인 눌렀을 경우 체크 활성 
	If sKeyName = "mbonl82020_p6" Then
		If sRet == "CFD 증거금 자동관리 서비스 이용약관" Then
			tabChange.page0.ChkView0.chksilence = "1"			
		End If
	End If
End Sub

'============================================================================
' tabChange_OnTabChanged(nCurrentTab) : 탭 변경 
'============================================================================
Sub tabChange_OnTabChanged(nCurrentTab)
	f_Clear()

	If edtPswd.caption ~= null and edtPswd.caption ~= "" Then
		DATAMANAGER.RequestTranData( "obpds_srvc_391r" )
	End If
End Sub

'============================================================================
' cmbAcct_ChangeAccount() : 계좌변경
'============================================================================
Sub cmbAcct_ChangeAccount()
	f_Clear()
	edtPswd.caption = ""
End Sub

'============================================================================
' edtPswd_OnEditComplete() : 비밀번호입력
'============================================================================
Sub edtPswd_OnEditComplete()
	f_Clear()
	DATAMANAGER.RequestTranData( "obpds_srvc_391r" )
End Sub

'============================================================================
' tabChange_page0_ChkView0_OnChange() : CFD 증거금 자동관리 서비스 유의사항
'============================================================================
Sub tabChange_page0_ChkView0_OnChange(sCheckState)
	'계좌비밀번호 입력체크함수
	If f_GetPWCkeck() Then
		tabChange.page0.ChkView0.chksilence = "0"
		Exit Sub
	End If
	
	If sCheckState == "1" Then
		tabChange.page0.ChkView0.chksilence = "0"
		Dim szURL 
		szURL = "http://home.imeritz.com/include/resource/comm/ctcn/files/cc220504.pdf"	'v0001 URL 적용
		Form.SetSharedData("OPEN_URL", szURL )
		Form.OpenFramePopup("mbonl82020_p6" , "CFD 증거금 자동관리 서비스 이용약관" , "") 	
	End If
End Sub

'============================================================================
' tabChange_page0_btnView0_OnClick() : CFD 증거금 자동관리 서비스 유의사항
'============================================================================
Sub tabChange_page0_btnView0_OnClick()
	'계좌비밀번호 입력체크함수
	If f_GetPWCkeck() Then
		Exit Sub
	End If
	
	Dim szURL 
	szURL = "http://home.imeritz.com/include/resource/comm/ctcn/files/cc220504.pdf"	'v0001 URL 적용
	Form.SetSharedData("OPEN_URL", szURL )
	Form.OpenFramePopup("mbonl82020_p6" , "CFD 증거금 자동관리 서비스 이용약관" , "") 		
End Sub

'============================================================================
' tabChange_page1_grdList_OnScrollEnd()
'============================================================================
Sub tabChange_page1_grdList_OnScrollEnd()
	If DATAMANAGER.IsMoreNextData("obpds_srvc_391r") == True Then
		DATAMANAGER.RequestNextData("obpds_srvc_391r")
	End If	
End Sub

'============================================================================
' tabChange_page1_grdList_OnClickUp(lRow, szCellID)
'============================================================================
Sub tabChange_page1_grdList_OnClickUp(lRow, szCellID)
	Dim szEnableState, szCheckState 
	szEnableState = tabChange.page1.grdList.GetCellEnable( "bd_check", lRow )	'체크Enable상태
	szCheckState = tabChange.page1.grdList.GetCellData( "bd_check", lRow )		'체크값(0: 미선택/ 1: 선택)
	If szEnableState == "1" Then
		If szCheckState == "1" Then
			'연결된 계좌번호, 서비스 일련번호 가져오기
			g_szTactACNO = tabChange.page1.grdList.GetCellData( "bd_acct", lRow ) 
			g_szSvcSrno = tabChange.page1.grdList.GetCellData( "bd_svcSrno", lRow ) 
		Else
			g_szTactACNO = ""
			g_szSvcSrno = ""
		End If
	End If
End Sub

'============================================================================
' BtnOK_OnClick() : 신청/해지 
'============================================================================
Sub BtnOK_OnClick()
	'계좌비밀번호 입력체크함수
	If f_GetPWCkeck() Then
		Exit Sub
	End If

	If tabChange.currenttab == 0 or tabChange.currenttab == "0" Then
		If tabChange.page0.cmbTactAcct.caption == "" or tabChange.page0.cmbTactAcct.caption == null Then
			Form.MsgBox( "알림", "연결계좌를 선택해주세요.", "", 6 )	
			Exit Sub		
		End If
		
		'약정확인 체크
		If tabChange.page0.ChkView0.chksilence == "0" Then
			Form.MsgBox( "알림", "CFD 증거금 자동관리 서비스 이용약관을 확인하세요.", "", 6 )	
			Exit Sub
		End If	
	Else
		'연결해지계좌 선택 체크
		If g_szTactACNO == "" or g_szTactACNO == null Then
			Form.MsgBox( "알림", "해지할 연결계좌를 선택해주세요.", "", 6 )	
			Exit Sub
		End If	
	
	End If
	
	DATAMANAGER.RequestTranData( "obpds_srvc_090a" )
End Sub

'****************************************************************************
'               		D  A  T  A  M  A  N  A  G  E  R               
'****************************************************************************
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 데이터 통신에 필요한 인풋 데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNT_PWD 
	if g_szPlain_rm == "1" then  			'MTS메모리평문 적용상태일때
	    szACNT_PWD = edtPswd.caption
	else  								'MTS메모리평문 미적용상태일때
	    szACNT_PWD = Form.GetEncData(edtPswd.caption)
	end if
	
	Dim szCSNO
	szCSNO = Form.GetSharedData("&CUST_NUM", false )	'로그인 해야만 고객번호 받아옴

	'약정 등록/해지
	If szTranID == "obpds_srvc_090a" Then
		Dim szPROS_CLS_CODE, szTactAcno, szTactAsno
		If tabChange.currenttab == 0 or tabChange.currenttab == "0" Then
			szPROS_CLS_CODE = "I"
			Dim szAcct 
			szAcct = Left(tabChange.page0.cmbTactAcct.caption, 9)
			szTactAcno = Left(szAcct, 4) & Right(szAcct, 4)
			szAcct = Left(tabChange.page0.cmbTactAcct.caption, 12)
			szTactAsno = Right(szAcct, 2)
		Else
			szPROS_CLS_CODE = "D"
			szTactAcno = Left(g_szTactACNO, 8)
			szTactAsno = Right(g_szTactACNO, 2)
		End If
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "PROS_CLS_CODE"			, 0 , szPROS_CLS_CODE		)	'처리구분코드
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TACT_SCRT_ACNO" 		, 0 , szTactAcno			)	'연결계좌번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "TACT_SCRT_ASNO" 		, 0 , szTactAsno			)	'연결계좌일련번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SVC_SRNO"      			, 0 , g_szSvcSrno			)	'서비스일련번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"      			, 0 , cmbAcct.total		)	'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO"      			, 0 , cmbAcct.sequence		)	'계좌일련번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD"      			, 0 , szACNT_PWD			)	'계좌비밀번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SVC_MANG_UNIT_CODE"		, 0 , "03"				)	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CSNO"      			, 0 , szCSNO				)	'고객번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "SVCD"         	 		, 0 , "090"				)	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "CONT_CLS_CODE" 			, 0 , "1" 				)
	
	'약정내역조회
	ElseIf szTranID == "obpds_srvc_391r" Then	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "IQRY_CLS_CODE" 	 	, 0 , CStr(tabChange.currenttab + 1)	)	'신청탭일때 "1",  조회변경탭일때 "2"
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO"         	 	, 0 , cmbAcct.total				)	'계좌번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO"         	 	, 0 , cmbAcct.sequence				)	'계좌일련번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNT_PWD"         	, 0 , szACNT_PWD					)	'계좌비밀번호
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete()
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID = "obpds_srvc_391r" Then
		If tabChange.currenttab == 0 or tabChange.currenttab == "0" Then
			Dim nDataCnt 	
			nDataCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))			
			
			If nDataCnt > 0 Then
				tabChange.page0.cmbTactAcct.clear = true
				
				Dim szStplYN, szAcno, szAsno, szAcnm
				szStplYN = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "STPL_YN" , 0)	'약정여부
				
				'약정여부 Y일 경우 첫번째 값 연결계좌콤보에 셋팅 아닐경우 내려오는 모든값 연결계좌콤보에 셋팅
				If szStplYN == "Y" Then
					tabChange.page0.tblState.SetCellString( 0 , 2, "등록")
					tabChange.page0.cmbTactAcct.enable = false
					szAcno = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ACNO"  , 0) 
					szAsno = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ASNO"  , 0)
					szAcnm = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ACNM"  , 0)
					Form.SetCtlProp("tabChange.page0.cmbTactAcct", "cbadddatatext", Left(szAcno,4) & "-" & Right(szAcno,4) & "-" & szAsno & " " & szAcnm)	
				Else
					tabChange.page0.tblState.SetCellString( 0 , 2, "미등록")
					tabChange.page0.cmbTactAcct.enable = true			
					for i = 0 to nDataCnt - 1
						szAcno = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ACNO"  , i) 
						szAsno = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ASNO"  , i)
						szAcnm = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ACNM"  , i)
						Form.SetCtlProp("tabChange.page0.cmbTactAcct", "cbadddatatext", Left(szAcno,4) & "-" & Right(szAcno,4) & "-" & szAsno & " " & szAcnm)	
					next
				End If
			End If
		Else
			If tonumber(tabChange.page1.grdList.rowcount) > 0 Then
				Dim nDataCnt, nRowCnt
				nDataCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock2" ))
				nRowCnt = tabChange.page1.grdList.rowcount - nDataCnt
				
				for i = 0 to nDataCnt - 1	
					Dim szAcct
					szAcct = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "ACNO" , i) & DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock2", "ASNO" , i)
					tabChange.page1.grdList.SetCellData( "bd_acct", nRowCnt + i, szAcct)	' 계좌번호+계좌일련번호
					
					'해지일이 있는 경우 체크박스 비활성화
					Dim szCancDate
					szCancDate = Trim(tabChange.page1.grdList.GetCellData( "bd_cancDate", nRowCnt+i )) '해지일
	
					If szCancDate == "" or szCancDate == null Then
						tabChange.page1.grdList.SetCellEnable( "bd_check", nRowCnt+i, true)
					Else 
						tabChange.page1.grdList.SetCellEnable( "bd_check", nRowCnt+i, false)
					End If
				Next
		    End If
		End If	    
	ElseIf szTranID = "obpds_srvc_090a" Then
		If tabChange.currenttab == 0 or tabChange.currenttab == "0" Then
			Form.ShowAlert( "알림" , "등록이 완료되었습니다.")
		Else
			Form.ShowAlert( "알림" , "해지가 완료되었습니다.")
		End If
		
		f_Clear()
		DATAMANAGER.RequestTranData("obpds_srvc_391r")
	End If
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError()
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubMsg ~= null and Trim(szSubMsg) ~= "" then
		szErrMsg = szErrMsg.."("..szSubMsg..")"
	end if
	
	if szTranID == "obpds_srvc_090a" then
		Form.MsgBox( "알림", szErrMsg, "", 6 )
	end if
End Sub



