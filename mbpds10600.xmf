<ROOT>
	<MAP_INFO scrno="10600" scrname="CFD 증거금 자동 관리" version="2" writer="장원혁" />
	<FORM_INFO name="Form" ly_vert="0,0,375,562,1" />
	<CONTROL_INFO>
		<TAB name="tabChange" tabheadheight="40" loadingtype="0" tabwidthtype="1" tabcount="2" ly_vert="1,0,375,562,1" >
			<PAGE name="page0" caption="신청" >
				<CONTROL_INFO>
					<TABLE name="tblState" insidelinecolor="102:255255255" colcount="4" rowcount="13" outline="0100" designorder="1" ly_vert="0,57,375,279,1" >
						<COL_INFO ly_vert_width="10,105,250,10" />
						<ROW_INFO ly_vert_height="39,39,55,10,16,16,10,16,10,16,16,16,20" />
						<CELL_INFO>
							<CELL cell_ly="0,0,1,0" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="약정등록 상태" fontsize="-2" impidxs="" />
							<CELL cell_ly="2,0,3,0" impidxs="" />
							<CELL cell_ly="0,1,1,1" fgcolor="065:102102102" bgcolor="066:238239240" halign="0" caption="연결 계좌" fontsize="-2" impidxs="" />
							<CELL cell_ly="2,1,3,1" halign="2" autofontsize="1" impidxs="" />
							<CELL cell_ly="0,2,0,2" line="0,0" impidxs="" />
							<CELL cell_ly="1,2,1,2" valign="0" halign="0" line="0,1" fontsize="-2" impidxs="" />
							<CELL cell_ly="2,2,2,2" valign="0" halign="0" line="0,1" fontsize="-2" impidxs="" />
							<CELL cell_ly="3,2,3,2" line="0,0" impidxs="" />
							<CELL cell_ly="0,3,3,3" line="0,0" impidxs="" />
							<CELL cell_ly="0,4,2,4" valign="0" halign="0" line="0,0" caption="ㆍ본 서비스는 본인명의 동일 종합계좌에 속한 개별계좌를" fontsize="-2" impidxs="" />
							<CELL cell_ly="3,4,3,4" line="0,0" impidxs="" />
							<CELL cell_ly="0,5,3,5" valign="0" halign="0" line="0,0" caption="   연결합니다." fontsize="-2" impidxs="" />
							<CELL cell_ly="0,6,3,6" line="0,0" impidxs="" />
							<CELL cell_ly="0,7,3,7" valign="0" halign="0" line="0,0" caption="ㆍ하나의 CFD 계좌는 2개 이상의 연결계좌 신청이 불가합니다." fontsize="-2" impidxs="" />
							<CELL cell_ly="0,8,3,8" line="0,0" impidxs="" />
							<CELL cell_ly="0,9,3,9" valign="0" halign="0" line="0,0" caption="ㆍ각 국가별 CFD계좌의 추가증거금을 방지하기 위해" fontsize="-2" impidxs="" />
							<CELL cell_ly="0,10,3,10" valign="0" halign="0" line="0,0" caption="   자동출금이 발생할 수 있으니, 각 국가별 추가증거금 산출 시간을" fontsize="-2" impidxs="" />
							<CELL cell_ly="0,11,3,11" valign="0" halign="0" line="0,0" caption="   숙지하시기 바랍니다." fontsize="-2" impidxs="" />
							<CELL cell_ly="0,12,3,12" line="0,0" impidxs="" />
						</CELL_INFO>
					</TABLE>
					<CHKBUTTON name="ChkView0" chkcaption="CFD 증거금 자동관리 서비스 이용약관" unchkcaption="CFD 증거금 자동관리 서비스 이용약관" ly_vert="5,148,280,32,1" />
					<BUTTON name="btnView0" caption="내용보기" fgcolor="004:000000000" btnimage="btn_02.9" ly_vert="285,148,82,32,1" />
					<COMBO name="cmbTactAcct" enable="0" popuptitle="연결계좌를 선택해주세요" ly_vert="115,96,260,39,1" />
					<CONTAINER name="Container1" vscroll="1" scroll_pos="0,0" ly_vert="0,195,375,255,1" scroll_ly_vert="0,0" >
						<CONTROL_INFO>
							<TABLE name="tblInfo" insidelinecolor="102:255255255" colcount="1" rowcount="31" outline="0001" designorder="1" ly_vert="0,0,375,580,1" >
								<COL_INFO ly_vert_width="375" />
								<ROW_INFO ly_vert_height="30,20,20,10,20,20,20,20,20,10,20,20,20,20,20,20,20,20,10,20,20,20,20,20,20,10,20,20,20,20,10" />
								<CELL_INFO>
									<CELL cell_ly="0,0,0,0" fgcolor="006:213049051" valign="0" halign="0" line="0,0" caption="※ 유의사항" fontsize="-1" fontstyle="01" impidxs="" />
									<CELL cell_ly="0,1,0,1" halign="0" line="0,0" caption="ㆍ서비스를 신청한 CFD계좌와 동일 고객이 보유한 계좌간 증거금" fontsize="-3" impidxs="" />
									<CELL cell_ly="0,2,0,2" halign="0" line="0,0" caption="   자동관리를 위한 서비스 입니다." fontsize="-3" impidxs="" />
									<CELL cell_ly="0,3,0,3" halign="0" line="0,0" fontsize="-3" impidxs="" />
									<CELL cell_ly="0,4,0,4" halign="0" line="0,0" caption="ㆍ연결계좌는 다수의 CFD계좌에 등록이 가능하나, CFD계좌에는 " fontsize="-3" impidxs="" />
									<CELL cell_ly="0,5,0,5" halign="0" line="0,0" caption="    한 개의 연결계좌만 등록할 수 있습니다." fontsize="-3" impidxs="" />
									<CELL cell_ly="0,6,0,6" halign="0" line="0,0" caption="    예)  ①국내주식CFD계좌 → A계좌 연결 (가능)" fontsize="-3" impidxs="" />
									<CELL cell_ly="0,7,0,7" halign="0" line="0,0" caption="          ②해외주식CFD계좌 → ① 실행 후 A계좌 연결 가능" fontsize="-3" impidxs="" />
									<CELL cell_ly="0,8,0,8" halign="0" line="0,0" caption="          ③국내주식CFD계좌 → ①, ② 실행 후 B계좌 연결 불가" fontsize="-3" impidxs="" />
									<CELL cell_ly="0,9,0,9" halign="0" line="0,0" fontsize="-3" impidxs="" />
									<CELL cell_ly="0,10,0,10" halign="0" line="0,0" caption="ㆍ서비스를 신청한 CFD계좌에서 추가증거금 발생이 예상되는 경우, " fontsize="-3" impidxs="" />
									<CELL cell_ly="0,11,0,11" halign="0" line="0,0" caption="    이를 방지하기 위해 연결계좌의 원화출금가능금액 범위 에서 " fontsize="-3" impidxs="" />
									<CELL cell_ly="0,12,0,12" halign="0" line="0,0" caption="    CFD계좌로 입금처리 됩니다." fontsize="-3" impidxs="" />
									<CELL cell_ly="0,13,0,13" halign="0" line="0,0" caption="    [인출금액]" fontsize="-3" fontstyle="01" impidxs="" />
									<CELL cell_ly="0,14,0,14" halign="0" line="0,0" caption="     1) 서비스를 신청한 CFD계좌의 계좌평가금액이 유지증거금보다" fontsize="-3" impidxs="" />
									<CELL cell_ly="0,15,0,15" halign="0" line="0,0" caption="      작은 경우,인출금액은 계좌평가금액과 유지증거금의 차이입니다." fontsize="-3" impidxs="" />
									<CELL cell_ly="0,16,0,16" halign="0" line="0,0" caption="     2) 연결계좌의 출금가능금액이 계좌평가금액과 유지증거금의 " fontsize="-3" impidxs="" />
									<CELL cell_ly="0,17,0,17" halign="0" line="0,0" caption="      차이보다 작은 경우, 전액 인출합니다." fontsize="-3" impidxs="" />
									<CELL cell_ly="0,18,0,18" halign="0" line="0,0" fontsize="-3" impidxs="" />
									<CELL cell_ly="0,19,0,19" halign="0" line="0,0" caption="    [유지증거금 부족금액 인출시간]" fontsize="-3" fontstyle="01" impidxs="" />
									<CELL cell_ly="0,20,0,20" halign="0" line="0,0" caption="     1) 국내CFD : 16시" fontsize="-3" impidxs="" />
									<CELL cell_ly="0,21,0,21" halign="0" line="0,0" caption="     2) 아시아CFD : 17시 30분" fontsize="-3" impidxs="" />
									<CELL cell_ly="0,22,0,22" halign="0" line="0,0" caption="     3) 미국CFD : 08시 10분" fontsize="-3" impidxs="" />
									<CELL cell_ly="0,23,0,23" halign="0" line="0,0" caption="    단, 인출시간이 같은 아시아CFD 계좌의 경우 국가별 순서(중국," fontsize="-3" impidxs="" />
									<CELL cell_ly="0,24,0,24" halign="0" line="0,0" caption="    홍콩, 일본 순)를 따르며, 동일국가는 계좌번호 순서를 따릅니다." fontsize="-3" impidxs="" />
									<CELL cell_ly="0,25,0,25" halign="0" line="0,0" fontsize="-3" impidxs="" />
									<CELL cell_ly="0,26,0,26" halign="0" line="0,0" caption="ㆍ신규주문 시 증거금이 부족한 경우, 연결계좌의 위탁예수금을" fontsize="-3" impidxs="" />
									<CELL cell_ly="0,27,0,27" halign="0" line="0,0" caption="    CFD계좌로 고객이 입금할 수 있도록 대체화면을 제공합니다." fontsize="-3" impidxs="" />
									<CELL cell_ly="0,28,0,28" halign="0" line="0,0" caption="    대체 여부는 고객의 선택사항이며, 출금가능금액이 신규주문" fontsize="-3" impidxs="" />
									<CELL cell_ly="0,29,0,29" halign="0" line="0,0" caption="    증거금보다 작은 경우 대체화면을 제공하지 않습니다." fontsize="-3" impidxs="" />
									<CELL cell_ly="0,30,0,30" halign="0" line="0,0" fontsize="-3" impidxs="" />
								</CELL_INFO>
							</TABLE>
						</CONTROL_INFO>
