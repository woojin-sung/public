'============================================================================
' 01. 화 면 명 : 빠른이체등록 확인팝업
' 02. 화면설명 : 이체_빠른이체확인 등록
' 03. 작    성 : 2016.02. 22 ~ 2016.04. 테스트3 
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szTranName	'이체명' 
Dim g_szSerialNumber	'일련번호
Dim g_szBankCode		'은행코드
Dim g_szRnDel		'사용구분
Dim g_szInName    '수취인명
Dim	g_szAmount    '금액	
Dim	g_szAccName		'계좌별칭(이름)
Dim	g_szAccOut 		' 출금계좌
Dim	g_szAccIn        ' 입금계좌
Dim	g_szMyTip ' 내통장표시값
Dim	g_szInTip ' 받는분표시값
Dim g_szBankName '기관명
Dim g_szGbn      '출입금구분값
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID)
	if szTranID == "obtss_elbs_200a" then	'등록
		DATAMANAGER.SetDataValue(0, "obtss_elbs_200a", "InBlock1", "CSNO" , 0 , "")	'고객번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_200a", "InBlock1", "PROS_CLS_CODE" , 0 , "I")	'등록삭제구분
		DATAMANAGER.SetDataValue(0, "obtss_elbs_200a", "InBlock1", "MNRC_ACNO" , 0 , g_szAccIn)	'입금계좌번호
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "MNRC_BANK_CODE", 0 , g_szBankCode)	'은행코드
		
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "DRNG_ACNO" , 0 , Left(g_szAccOut, 8))	'계좌번호
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "DRNG_ASNO", 0 , Right(g_szAccOut, 2))	'계좌일련번호
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "TR_AMT", 0 , g_szAmount)
		
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "DRNG_ACNT_BNKB_EXRS_CNTT" , 0 , g_szMyTip)	'계좌표시
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "MNRC_ACNT_BNKB_EXRS_CNTT" , 0 , g_szInTip)	'입금계좌표시
		DATAMANAGER.SetDataValue(0,  "obtss_elbs_200a", "InBlock1", "FAST_TACT_NAME", 0 , g_szTranName)	'빠른이체명(별칭)

		DATAMANAGER.SetDataValue(0, "obtss_elbs_200a", "InBlock1", "RMT_NAME" , 0 , g_szInName)	'은행계좌명(수취인계좌명)		
		
		DATAMANAGER.RequestTranData("obtss_elbs_200a")
	end if
	
'	if szTranID == "obrtd_drng_025r" then	'수취인 조회
'		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "ACNO" , 0 , "30076921")	'계좌번호
'		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "ASNO" , 0 , "01")	'계좌일련번호
'		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "USE_YN" , 0 , "N")	'사용여부(기본값)
'		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ACNO", 0 , Left(g_szAccOut, 8))	'상대계좌번호
'		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ASNO" , 0 , Right(g_szAccOut, 2))	'상대계좌일련번호		
'		
'		DATAMANAGER.RequestTranData("obrtd_drng_025r")
'	end if
	
'	if szTranID == "obtss_elbs_129r" then	'타행이체수취조회????
'		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_BANK_CODE", 0 , szValue)	'입금은행코드
'		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_ACNO" , 0 , szValue)	'입금계좌번호
'		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "TR_AMT" , 0 , szValue)		'거래금액
'		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "DRNG_ACNO" , 0 , szValue)	'출금계좌번호
'		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "ACNT_PROD_CLS_CODE" , 0 , szValue)	'계좌상품구분코드
'		DATAMANAGER.SetDataValue(0,  "obtss_elbs_129r", "InBlock1", "JOB_TRNO", 0 , "031")	'작업단말번호(기본값)
'		DATAMANAGER.RequestTranData("obtss_elbs_129r")
'	end if
	
	
End Function
Function TR_Inquiry1(g_szGbn)
     if g_szGbn == "Out" then	'출금인 조회
        DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ACNO", 0 , Left(g_szAccOut, 8))	'계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ASNO" , 0 , Right(g_szAccOut, 2))	'계좌일련번호	
	 elseif  g_szGbn == "In" then 	
	    DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ACNO", 0 , Left(g_szAccIn, 8))	'상대계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ASNO" , 0 , Right(g_szAccIn, 2))	'상대계좌일련번호	
	 end if	
	 DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "ACNO" , 0 , Left(g_szAccOut, 8))	'계좌번호
	 DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "ASNO" , 0 , Right(g_szAccOut, 2))	'계좌일련번호
	 DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "USE_YN" , 0 , "N")	'사용여부(기본값)
			
	 DATAMANAGER.RequestTranData("obrtd_drng_025r")

End Function 

Function Set_Data()

    tblQuick.SetCellString( 0, 1, g_szTranName	)
	tblQuick.SetCellString( 2, 1, g_szAccOut	)
	tblQuick.SetCellString( 2, 2, g_szAccName	)
	tblQuick.SetCellString( 3, 1, g_szAmount	)
	tblQuick.SetCellString( 5, 1, g_szBankName	)
	tblQuick.SetCellString( 6, 1, g_szAccIn		)
	tblQuick.SetCellString( 7, 1, g_szInName	)	
	tblQuick.SetCellString( 8, 1, g_szMyTip     )
	tblQuick.SetCellString( 9, 1, g_szInTip     )
End Function

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' imgClose_OnClick
'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub


'============================================================================
' btnEnroll_OnClick
'============================================================================
Sub btnEnroll_OnClick()
	
		TR_Inquiry("obtss_elbs_200a")
	
End Sub

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	g_szAccName	= ""	 '출금계좌이름 
	g_szSerialNumber = ""	'일련번호
	g_szInName = ""		'수취인명
	g_szRnDel = "I"		'등록(I) 삭제(D)
	Dim szData, arrData
	szData =  Form.GetOpenLinkData()
	' I★이체명★일련번호★출금계좌번호★이체금액★은행코드★기관명★입금계좌★내통장표시★받는분표시-> 
	' I★이체명★받는분★출금계좌번호★계좌명★이체금액★은행코드★기관명★입금계좌★내통장표시★받는분표시 
	arrData = Split(szData, "★")
	
	if UBOUND(arrData) < 1 then
		exit sub
	end if
	g_szTranName	= arrData(1)'이체명' 
    'g_szSerialNumber = arrData( 2)	'일련번호
    g_szInName = arrData(2)
    g_szBankCode	= arrData(6)	'은행코드
    g_szAmount    = arrData(5)'금액	
	g_szBankName  = arrData(7)
	g_szAccOut 	 = arrData(3) 	' 출금계좌
	g_szAccIn     = arrData(8)   ' 입금계좌
	g_szMyTip = arrData(9)' 내통장표시값
	g_szInTip = arrData(10)	' 받는분표시값
	g_szAccName = arrData(4)	
	'call TR_Inquiry1("Out")
	'call btnAccountSearch_OnClick()

    call Set_Data()
End Sub


'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtss_elbs_200a" then	'등록조회
	   if DATAMANAGER.GetDataValue( 0 , "obtss_elbs_200a", "OutBlock1", "REG_SRNO" , 0 ) <> "" then
		  Form.MsgBox("알림", "빠른이체로 등록 완료되었습니다.", "enrollok", 0)	
	   else 
	      Form.MsgBox("알림", DATAMANAGER.GetDataMsgText( szTranID ), "enrollerr" , 0)
	   end if
	 
	elseif szTranID == "obrtd_drng_025r" then '수취인 조회
		if Trim(DATAMANAGER.GetDataValue(0, "obrtd_drng_025r", "OutBlock1", "RMT_NAME", 0)) <> "" then
			btnEnroll.enable = true
			if g_szGbn == "Out" then	'출금인 조회
			    g_szAccName = DATAMANAGER.GetDataValue(0, "obrtd_drng_025r", "OutBlock1", "RMT_NAME", 0)
			else 
			    g_szInName = DATAMANAGER.GetDataValue(0, "obrtd_drng_025r", "OutBlock1", "RMT_NAME", 0)
			end if    
		else
			btnEnroll.enable = false
		end if
	
	
	elseif szTranID == "obtss_elbs_129r" then
		if DATAMANAGER.GetDataValue(0, "obtss_elbs_129r", "OutBlock1", "ACNM" , 0) <> "" then
			btnEnroll.enable = true
			g_szInName = DATAMANAGER.GetDataValue(0, "obtss_elbs_129r", "OutBlock1", "ACNM" , 0)
		else
			btnEnroll.enable = false
		end if
	end if
	
	
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.MsgBox("알림", szErrMsg, 0, 0)
End Sub


'============================================================================
' btnAccountSearch_OnClick  - 조회버튼 클릭
'============================================================================
Sub btnAccountSearch_OnClick()
	if g_szBankCode == "287" then
		if Len(g_szAccIn) < 10 then
			Form.MsgBox("알림", "계좌번호 오류입니다.", "", 0)
		else
			TR_Inquiry("In")
		end if
	else
		TR_Inquiry("obtss_elbs_129r")''''???
	end if
		
End Sub


'============================================================================
' btnCancel_OnClick - 취소버튼
'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub



'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "enrollok" then
		if sRet == "close" then
			Form.CloseForm()
			Form.SendReturnToParent("mbbnk61010_p8" , "ok")
		end if
	end if
	
	if sKeyName == "enrollerr" then
		if sRet == "close" then
			Form.CloseForm()
			Form.SendReturnToParent("mbbnk61010_p8" ,"error")
		end if
	end if
End Sub




