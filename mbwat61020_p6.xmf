'============================================================================
Sub btnReg_OnClick()
	Dim sLOGIN_TYPE
	sLOGIN_TYPE = Form.GetSharedData( "&LOGIN_TYPE", 0 )
	
	If sLOGIN_TYPE = "1" Then
		Form.MsgBox("알림", "로그인이 필요한 메뉴입니다.\n로그인하시겠습니까?", "GOTOLOGIN", 1)
		Exit Sub
	else
		if Len(g_sCode) == 1 then '지점 운용형은 운용역 선택후 진행
			if g_sEmpno <> null and g_sEmpno <> "" then '운용역을 선택하고 들어왔으면 협의확인
				DATAMANAGER.RequestTranData( "obwat_oiad_023r" )
			else
				Form.OpenPopup("mbwat61020_p3" , g_sAcnt.."|"..g_sCode.."|" , "") '운용역선택
			end if
		elseif Len(g_sCode) > 1 then
			Dim sCsno
			sCsno = Form.GetSharedData("&CUST_NUM", false)
			
			DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "WA_PRCD" , 0 , g_sCode )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "ACNO" , 0 , g_sAcnt )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "CSNO" , 0 , sCsno )
			DATAMANAGER.RequestTranData( "obwat_onln_003r" )
		end if
	end if
End Sub

Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "GOTOLOGIN" Then
		if sRet == "ok" then
			Form.OpenPopup("mhetc90021", "", "")
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obwat_oiad_023r" then
		DATAMANAGER.SetDataValue( 0, "obwat_oiad_023r", "InBlock1", "ACNO" , 0 , g_sAcnt )
		DATAMANAGER.SetDataValue( 0, "obwat_oiad_023r", "InBlock1", "WA_PRCD" , 0 , g_sCode )
		DATAMANAGER.SetDataValue( 0, "obwat_oiad_023r", "InBlock1", "EMPNO" , 0 , g_sEmpno )
		
	elseif szTranID == "obwat_csad_021r" then
		'v0002
		DATAMANAGER.SetDataValue(0, "obwat_csad_021r", "InBlock1", "IQRY_CLS_CODE", 0 , "2")
	elseif szTranID == "obwat_csad_022r" then
		DATAMANAGER.SetDataValue( 0, "obwat_csad_022r", "InBlock1", "WA_PRCD" , 0 , g_sCode )
	elseif szTranID == "obwat_csad_024r" then
		DATAMANAGER.SetDataValue( 0, "obwat_csad_024r", "InBlock1", "WA_PRCD" , 0 , g_sCode )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_oiad_023r" then
		Dim sAplyYN
		sAplyYN = DATAMANAGER.GetDataValue( 0, "obwat_oiad_023r", "OutBlock1", "APLY_YN" , 0 )
		
		if sAplyYN == "Y" then '협의완료
			Dim sCode, sCsno
			sCode = DATAMANAGER.GetDataValue( 0, "obwat_oiad_023r", "OutBlock1", "WA_PRCD" , 0 )
			sCsno = Form.GetSharedData("&CUST_NUM", false)
			
			DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "ACNO" , 0 , g_sAcnt )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "WA_PRCD" , 0 , sCode )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "CSNO" , 0 , sCsno )
			DATAMANAGER.RequestTranData( "obwat_onln_003r" )
		else
			Form.OpenPopup("mbwat61020_p5", "", "")
		end if
		
	elseif szTranID == "obwat_csad_021r" then
		Dim sName
		

		g_sCode = DATAMANAGER.GetDataValue( 0, "obwat_csad_021r", "OutBlock1", "DIV_GRP_CODE" , 0 )
		sName = DATAMANAGER.GetDataValue( 0, "obwat_csad_021r", "OutBlock1", "WA_PRNM" , 0 )
	
		lblPrdName.caption = sName

		'Form.SetCtlProp("cont"..g_sCode, "visible", "1")
		
		call ShowGdsInfo(g_sCode)
		
		DATAMANAGER.RequestTranData( "obwat_csad_022r" )
		DATAMANAGER.RequestTranData( "obwat_csad_024r" )
		
		
	elseif szTranID == "obwat_csad_024r" then
		g_sfileName1 = DATAMANAGER.GetDataValue( 0, "obwat_csad_024r", "OutBlock1", "UI_1_ATCH_FILE_NAME" , 0 )
		g_sfileName2 = DATAMANAGER.GetDataValue( 0, "obwat_csad_024r", "OutBlock1", "UI_2_ATCH_FILE_NAME" , 0 )
		g_sfileName3 = DATAMANAGER.GetDataValue( 0, "obwat_csad_024r", "OutBlock1", "UI_3_ATCH_FILE_NAME" , 0 )
		
		g_sfileName1 = Trim(g_sUrl) & Trim(g_sfileName1)
		g_sfileName2 = Trim(g_sUrl) & Trim(g_sfileName2)
		g_sfileName3 = Trim(g_sUrl) & Trim(g_sfileName3)
	elseif szTranID == "obwat_onln_003r" then
		Dim sJoinYN
		sJoinYN = DATAMANAGER.GetDataValue( 0, "obwat_onln_003r", "OutBlock1", "JOIN_ABLE_YN" , 0 )
		
		if sJoinYN == "Y" then
			g_szCode = DATAMANAGER.GetDataValue( 0, "obwat_onln_003r", "InBlock1", "WA_PRCD" , 0 )
			
'			Form.OpenPopup("mbwat61022" , sCode , "") '계약(가입)

			Form.OpenPopup("mbonl81010_p20" , "" , "")	'2023.05.22 금융소비자 팝업 추가
		else
			Dim sResultCode, sMsg
			sResultCode = DATAMANAGER.GetDataValue( 0, "obwat_onln_003r", "OutBlock1", "PROS_RSLT_CODE" , 0 )
			sMsg = DATAMANAGER.GetDataValue( 0, "obwat_onln_003r", "OutBlock1", "PROS_PRHB_DTL_CNTT" , 0 )
			
			Form.OpenPopup("mbwat61020_p9", sResultCode.."|"..sMsg, "")
		end if
		
	end if
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.OpenPopup("mbwat61020_p7" , g_sAcnt , "")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "FullCode" then
		DATAMANAGER.SetDataValue( 0, "obwat_csad_021r", "InBlock1", "WA_PRCD" , 0 , sRet )
		DATAMANAGER.RequestTranData( "obwat_csad_021r" )
		
	elseif sKeyName == "Login_Type" then
		if sRet == "3" then
			Form.PostLinkData("ReloadAccount", "mbwat61020_p6")
		else
			g_nLogin = -1
		end if
	elseif sKeyName == "mbonl81010_p20_CLOSE" then
		if sRet == "NEXT_mbonl81010_p20" then
			Form.OpenPopup("mbwat61022" , g_szCode , "") '계약(가입)
		elseif sRet == "CANCEL_mbonl81010_p20" then
		
		end if
	end if
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "mbwat61020_p6" then
		g_sAcnt = sValue
		
		if Len(g_sCode) == 1 then '지점 운용형은 운용역 선택후 진행
			if g_sEmpno <> null and g_sEmpno <> "" then '운용역을 선택하고 들어왔으면 협의확인
				DATAMANAGER.RequestTranData( "obwat_oiad_023r" )
			else
				Form.OpenPopup("mbwat61020_p3" , g_sAcnt.."|"..g_sCode.."|" , "") '운용역선택
			end if
		elseif Len(g_sCode) > 1 then
			Dim sCsno
			sCsno = Form.GetSharedData("&CUST_NUM", false)
			DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "WA_PRCD" , 0 , g_sCode )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "ACNO" , 0 , g_sAcnt )
			DATAMANAGER.SetDataValue( 0, "obwat_onln_003r", "InBlock1", "CSNO" , 0 , sCsno )
			DATAMANAGER.RequestTranData( "obwat_onln_003r" )
		end if
	end if
End Sub

