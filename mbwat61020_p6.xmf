	<SCRIPT_INFO _len="19058" _ulen="17416" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Wrap상품 목록 조회
' 02. 화면설명 : 
' 03. 이    력 : 2022.10.21 : 고승연 : v0001 : 
'                2023.05.08 : 고승연 : v0002 : [T2305030027] obwat_csad_021r IO 수정, 고객번호,조회구분 입력 추가
'                2024.01.22 : 고승연 : v0003 : [] 신규상품 추가
'                2024.06.28 : 고승연 : v0004 : 예금자보호 문구 수정
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sAcnt
Dim g_sCode
Dim g_sEmpno
Dim g_sUrl
Dim g_nMode
Dim g_sOStype
Dim g_sfileName1
Dim g_sfileName2
Dim g_sfileName3

Dim g_szCode
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


' 뒤로가기
'============================================================================
Sub btnBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim nType
	g_nMode = Form.GetSharedData( "&SERVER_MODE", false )	'0 : 운영계, 1 : 테스트계
	g_OStype = Form.GetSharedData("OS_TYPE", false)
	
	if g_nMode == "0" then
		g_sUrl = "https://home.imeritz.com/include/resource/comm/ctcn/nfiles/"	'운영계 주소
	elseif g_nMode == "1" then
		g_sUrl = "https://testhome.imeritz.com/include/resource/comm/ctcn/nfiles/"	'테스트계주소
	end if
	
	Dim sData
	sData = Form.GetOpenLinkData()
	
'sData = "|WA000467||MeritzTEST랩|WA000467"
	
	if sData <> null and sData <> "" then
		Dim tData
		tData = Split(sData, "|")
		
		g_sAcnt = tData(0)
		g_sCode = tData(1)
		g_sEmpno = tData(2)
		lblPrdName.caption = tData(3) '상품명
		
		'Form.SetCtlProp("cont"..g_sCode, "visible", "1")
		
		call ShowGdsInfo(g_sCode)
		
		DATAMANAGER.RequestTranData( "obwat_csad_022r" )
		DATAMANAGER.RequestTranData( "obwat_csad_024r" )
	end if
End Sub


'============================================================================
Sub ShowGdsInfo(gdsCode)

	Call HideCont()
		
	Form.SetCtlProp("cont"..g_sCode, "left", "0")
	Form.SetCtlProp("cont"..g_sCode, "top", "75")
	Form.SetCtlProp("cont"..g_sCode, "height", "486")
	Form.SetCtlProp("cont"..g_sCode, "width", "375")
	Form.SetCtlProp("cont"..g_sCode, "visible", "1")

	if gdsCode = "A" then	'기본형_성장지향형 02:높은위험
		contA.ImageA05.imgpath = "img_bgcircle_grade_373.9.png"
		contA.LabelA09.caption = "높은위험"
		contA.LabelA09.fgcolor = 144
	elseif gdsCode = "B" then	'기본형_고수익지향형 01:매우높은위험
		contB.ImageB05.imgpath = "img_bgcircle_grade_372.9.png"
		contB.LabelB09.caption = "매우높은위험"
		contB.LabelB09.fgcolor = 273
	elseif gdsCode = "C" then	'기본형_고수익지향형_고난도 01:매우높은위험
		contC.ImageC05.imgpath = "img_bgcircle_grade_372.9.png"
		contC.LabelC09.caption = "매우높은위험"
		contC.LabelC09.fgcolor = 273
		contC.ImageC06.imgpath = "img_bgcircle_grade_372.9.png"
		contC.LabelC10.caption = "고난도"
		contC.LabelC10.fgcolor = 273
	elseif gdsCode = "D" then	'성과보수형_성장지향형 02:높은위험
		contD.ImageD05.imgpath = "img_bgcircle_grade_373.9.png"
		contD.LabelD09.caption = "높은위험"
		contD.LabelD09.fgcolor = 144
	elseif gdsCode = "E" then	'성과보수형_고수익지향형 01:매우높은위험
		contE.ImageE05.imgpath = "img_bgcircle_grade_372.9.png"
		contE.LabelE09.caption = "매우높은위험"
		contE.LabelE09.fgcolor = 273
	elseif gdsCode = "F" then	'성과보수형_고수익지향형_고난도 01:매우높은위험
