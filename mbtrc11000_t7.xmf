	<SCRIPT_INFO _len="5653" _ulen="5525" >
'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
Sub TR_Request()
	cont0.grd0.SetClear()
	DATAMANAGER.RequestTranData("obtrc_comm_221r")
	DATAMANAGER.RequestTranData("obtrc_comm_222r")
End Sub
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	Dim szYYYY, szMM
	'조회시작 날짜 당월 1일로 세팅
	n_date = Form.GetSharedData("&HOST_DATE" , false)
	szYYYY 	= left(n_date, 4)
	szMM 	= mid(n_date, 5, 2)
	fromdate = szYYYY & szMM & "01"
	cont0.cldFrom.caption = fromdate
	
	cont0.grd1.setUseCardView(true, 10, "img_bgbox_gray.9")
	cont0.grd1.SetCellData("bd_cell0", 0, "청산손익(A)")
	cont0.grd1.SetCellData("bd_cell2", 0, "비용(B)")
	
	cont0.tbl10.visible = true  '(v001) 표기
	cont0.tbl11.visible = false '(v001) 미표기, 현재 사용하지 않음
	cont0.tbl12.visible = false '(v001) 미표기, 현재 사용하지 않음
	
	cont0.grd1.scrollenable = "0"
	cont0.setScrollBarVisible("0") 
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "RECEIVE" or sEventName == "CHANGE_ACCTNO" then
		TR_Request()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szACNO, szASNO
		
	szACNO = Form.GetCtlProp("#acnt0", "total")
	szASNO = Form.GetCtlProp("#acnt0", "sequence")
		
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0, szACNO )
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO", 0, szASNO )
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "STA_DATE", 0, cont0.cldFrom.caption )
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIN_DATE", 0, cont0.cldTo.caption )

End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
		
	if szTranID == "obtrc_comm_222r" then
		Dim szData
		
		isMore = DATAMANAGER.IsMoreNextData( szTranID )
		
		if isMore == true or isMore == 1 or isMore == "1" then
			DATAMANAGER.RequestNextData( szTranID )
			
		else
			if CInt(cont0.grd0.rowcount) > 0 then
				cont0.grd0.left = 10
				cont0.lblNone.caption = ""
				
				For i = 0 To cont0.grd0.rowcount -1	'매매구분
					szData = cont0.grd0.GetCellData( "bd_cell20", i)
						
					If szData = "1" Then
						cont0.grd0.SetCellData("bd_cell2", i, "매도")
						cont0.grd0.SetCellFgColor("bd_cell2", i, "11")
					Else
						cont0.grd0.SetCellData("bd_cell2", i, "매수")
						cont0.grd0.SetCellFgColor("bd_cell2", i, "10")
					End If
				Next	
			else
				cont0.grd0.left = 1000
				cont0.lblNone.caption = "청산내역이 없습니다."
			end if
			
		end if
	
	Elseif szTranID == "obtrc_comm_221r" then
		nNtplAmt = CDbl(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "CFD_NTPL_AMT" , 0))
		nClrnPrls0 = CDbl(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CFD_CLRN_PRLS" , 0))
		nClrnPrls1 = CDbl(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CFD_CLRN_PRLS" , 0))
		nClrnPrls2 = CDbl(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock2" , "CFD_CLRN_PRLS" , 0))
		
		if nNtplAmt > 0 then
			cont0.LblTotal.fgcolor = "10"
			cont0.LblTotal.caption = "+"..FormatNumber(nNtplAmt, 0).."원"
		elseif nNtplAmt < 0 then
			cont0.LblTotal.fgcolor = "11"
			cont0.LblTotal.caption = FormatNumber(nNtplAmt, 0).."원"
		else
			cont0.LblTotal.fgcolor = "12"
			cont0.LblTotal.caption = FormatNumber(nNtplAmt, 0).."원"
		end if
		
	
	end if
	
End Sub

'============================================================================
Sub cont0_cldFrom_OnEditComplete()
	TR_Request()
	
End Sub

'============================================================================
Sub cont0_cldTo_OnEditComplete()
	TR_Request()
	
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	cont0.imgCmb2.setMaintainingRatio("1")
End Sub

'============================================================================
Sub cont0_lblGubun2_OnClick()
	cont0.cmbGubun2.OpenList()
End Sub

'============================================================================
Sub cont0_imgCmb2_OnClick()
	cont0.cmbGubun2.OpenList()
End Sub

'============================================================================
Sub cont0_cmbGubun2_OnEditComplete(iIndex)
	cont0.lblGubun2.caption = cont0.cmbGubun2.caption
	
	Select Case CInt(iIndex)
	Case 0
		cont0.tbl10.visible = true
		cont0.tbl11.visible = false
		cont0.tbl12.visible = false
	Case 1
		cont0.tbl10.visible = false
		cont0.tbl11.visible = true
		cont0.tbl12.visible = false
	Case 2
		cont0.tbl10.visible = false
		cont0.tbl11.visible = false
		cont0.tbl12.visible = true
	End Select
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	cont0.grd0.SetClear()
	Form.ShowAlert("알림", szErrMsg)
End Sub

