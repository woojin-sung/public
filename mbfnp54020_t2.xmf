'============================================================================
' Request_Data
'============================================================================
Function Request_Price()
	DATAMANAGER.RequestTranData("ohhts_7052_001r")
End Function

'============================================================================
' Load_OrderSet : 환경설정값 정의
'============================================================================
Function Load_OrderSet() '주문설정/계좌정보/확인창
	' 환경설정값 정의...
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			' 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			' 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			' 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				' 원주문번호 자동입력

	' 주문확인창(기본값 : 사용)
	if Trim(g_szOdrPop) = "" then
		g_szOdrPop = "1"
	end if
	
	' 주문전송 후 초기화(기본값 : 사용)
	if Trim(g_szAfterInit) = "" then
		g_szAfterInit = "1"
	end if	
	
	'20170919 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	' 종목/탭 변경시 초기화(기본값 : 사용)
	if Trim(g_szChangeInit) = "" then
		g_szChangeInit = "1"
	end if	
	'20170919 HAMWG END

	' 원주문번호 자동입력(기본값 : 사용)
	if Trim(g_szAfterOrg) = "" then
		g_szAfterOrg = "1"
	end if
End Function

'============================================================================
' Check_Account
'============================================================================
Function Check_Account()
	Dim szAcnt, szPwd
	
	szAcnt = Form.GetCtlProp("#acc", "caption")
	
    If Len(szAcnt) < 10 Then
	    Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
	    return False
	End If
	
	szPwd = Form.GetCtlProp("#edtPwd", "caption")
	
	If Trim(szPwd) = "" Then
		Form.ShowAlert(g_szTitle, "비밀번호를 확인하십시오!")
		return False
	end If
	
	return True
End Function

'============================================================================
' Check_InputData
'============================================================================
Function Check_InputData()
	' 계좌번호와 계좌비밀번호 체크
	if Check_Account() == false then
		return false
	end if

	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if
	
	if Trim(contBuy.edtQty.caption) == "" or Trim(contBuy.edtQty.caption) == "0" then
		Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
		return false
	end if
	
	
	if Trim(contBuy.edtPrice.caption) == "" or Trim(contBuy.edtPrice.caption) == "0" then
		Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
		return false
	end if	
					
	if g_szOdrPop == "1" then
			Open_ConfirmPopup()
	else
	   DATAMANAGER.RequestTranData( "obtrs_oder_301a" )	
	   return true
	end if
End Function

'============================================================================
' Check_OrderQty
'============================================================================
Function Check_OrderQty(nGbn)
	' 계좌번호와 계좌비밀번호 체크
	if Check_Account() == false then
		return false
	end if

	if Trim(g_szCd) == "" then
		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
		return false
	end if
	
	if Trim(contBuy.edtPrice.caption) == "" or Trim(contBuy.edtPrice.caption) == "0" then
		Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
		return false
	end if	
End Function	

'============================================================================
' Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
'============================================================================
Function Calc_Qty(nGbn)
	Dim szQty, nUnit, szCalc, szUnit
	
	szQty = contBuy.edtQty.caption

	
	if Trim(szQty) == "" then
		szQty = 1
	else
		if Len(szQty) = 1 or Len(szQty) = 2 then
			nUnit = 1
		else
			nCnt = Len(szQty)-1
			
			For i = 0 to nCnt-1
				if i == 0 then
					szUnit = "1"
				else
					szUnit = szUnit & "0"
				end if
			Next
			
			nUnit = CInt(szUnit)
		end if
		
		if nGbn == 0 then
			szQty = CInt(szQty) + nUnit
		elseif nGbn == 1 then
			if CInt(szQty) == 0 then
				Exit Function
			else
				szQty = CInt(szQty) - nUnit
			end if
		end if
	end if
	
	contBuy.edtQty.caption = szQty
End Function

'============================================================================
' 20160602 틱단위 수정
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn, szPM)
	Dim szPrc, szUnit
'	szUnit = "1"
	If Trim(szPM) == "" or Trim(szPM) == " " or Trim(szPM) == "0" Then
		szUnit = "1"
	Else
		szUnit = Trim(szPM)
	End If
	
	szPrc  = contBuy.edtPrice.caption

	CDbl decP2
	
	'20230122_01 HWG START : 거래소차세대 대응
	decP2 = Round(Cdbl(FormatNumber(szPrc, 2)) Mod Cdbl(FormatNumber(szPM, 2)),2) 'Round(CDbl(szPrc) Mod CDbl(szUnit), 2)
	'20230122_01 HWG END
	
	'decP2 = Round(CDbl(szPrc) Mod CDbl(szPM), 2)
	
	if Trim(szPrc) <> "" then
		' + 버튼 클릭 /////////////////////////////
		if nGbn == 0 then							
			szPrc = CDbl(szPrc) + CDbl(szUnit) - decP2
		' - 버튼 클릭 ////////////////////////////
		elseif nGbn == 1 then						
			if CDbl(szPrc) > 0 then'else
				If decP2 > 0 Then
					szPrc = CDbl(szPrc) - decP2
				Else
					szPrc = CDbl(szPrc) - CDbl(szUnit) - decP2
				End If
        		end if
		end if
		
		contBuy.edtPrice.caption = szPrc
	end if
	
End Function

'============================================================================
' Open_ConfirmPopup
'============================================================================
Function Open_ConfirmPopup(szWarn)
	Dim szData
	
	szData = "1"													' 매매구분 1:매도
	szData = szData & "|" & g_szMk									' 시장구분
	szData = szData & "|" & Form.GetCtlProp("#acc", "caption")			' 계좌번호
	szData = szData & "|" & Form.GetCtlProp("#acc", "accountname")		' 계좌명
	szData = szData & "|" & g_szCd									' 종목코드
	szData = szData & "|" & Form.GetItemCodeInfo(g_szCd, "name")		' 종목명
	szData = szData & "|" & contBuy.cmbSmt.caption					' 소액매매구분
	szData = szData & "|" & ""										' 소액매매구분데이타
	szData = szData & "|" & contBuy.cmbMkt.caption					' 시장구분2
	szData = szData & "|" & contBuy.cldBuy.caption					' 매수일자
	szData = szData & "|" & contBuy.edtQty.caption					' 주문수량
	szData = szData & "|" & contBuy.edtPrice.caption					' 주문가격
	szData = szData & "|" & ""										' 원주문번호
	szData = szData & "|" & contBuy.cmbTax.caption					' 과세구분
	' 주문경고보류용 플래그 YGH EDIT 20191125
	if Trim(szWarn) <> "" then		' 경고팝업 오픈
		szData = szData & "|" & szWarn								' 경고메세지
		
		Form.OpenPopup("mbfnp54020_p9", szData , "")		
	else							
	' 주문경고보류용 플래그 YGH EDIT 20191125
		' 주문확인팝업 오픈
		Form.OpenPopup("mbfnp54020_p2", szData , "")
	end if
End Function

'============================================================================
' Set_OrdType
'============================================================================
Function Set_OrdType()	
	if g_szMK == "SB" then
		contBuy.cmbMkt.cbkeydata = "02"
	else
		contBuy.cmbMkt.cbkeydata = "01"
	end if
End Function

'============================================================================
' Set_TaxType
'============================================================================
Function Set_TaxType(szType)	
    if szType == "종합과세" then
       contBuy.cmbTax.currentindex = "0"
    else 
       contBuy.cmbTax.currentindex = "1"
    end if   
End Function
