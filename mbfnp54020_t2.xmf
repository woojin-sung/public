'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Load_OrderSet() '주문설정값 읽어오기
	'20200910 SWJ START
	'MTS메모리평문 적용유무
	'plain_rm = ( 0 : 미적용/ 1 : 적용)
	plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	'20200910 SWJ END
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "54020_HOGA" then		' 메인화면의 호가 클릭시
		if sParam <> "" then
			''''(주문유형)에 따른 '주문단가
			contBuy.edtPrice.caption = sParam
		end if
	elseif sEventName == "INIT_CODE" then	' 메인화면에서 종목코드 (&잔고) 받기
		if sParam <> "" then
			tData = Split(sParam, "★")
			
			if #tData > 0 then

				if #tData > 3 then
					g_szMK = tData(0)
					g_szCd = tData(1)
					contBuy.edtQty.caption = tData(2)
					contBuy.cldBuy.caption = tData(3)
					Set_TaxType(tData(4))
								 
					g_bBalFlag = true	'20170919 HAMWG : 채권잔고 데이터 연동
				elseif #tData == 3 then
					g_szMK = tData(0)
					g_szCd = tData(1)
					contBuy.edtPrice.caption = tData(2)
				else
					g_szMK = tData(0)
					g_szCd = tData(1)
				end if
				
				Set_OrdType()		' 종목코드에 따라 주문유형 설정
			end if
			
		end if
		
		'20170919 HAMWG START : 잔고팝업에서 리턴시 수량 세팅 유지
		if g_bBalFlag <> true then
			if g_szChangeInit == "1" then		' 종목변경시 인풋항목 초기화
				contBuy.edtQty.caption = ""
				contBuy.edtPrice.caption = ""
			end if
		end if
		
		g_bBalFlag = false
		'20170919 HAMWG END

	elseif sEventName == "54020_BALANCE_RETURN" then	
			
	    if sParam == "" then
			Exit Sub
		end if
	    
	    tData = Split(sParam, "♥")
	    if UBOUND(tData) < 1 then
	      Exit Sub
	    End if	
	   
	   
	    contBuy.edtQty.caption = tData(0)
	    contBuy.cldBuy.caption = tData(1)
	end if
End Sub

'============================================================================
Sub contBuy_btnBuy_OnClick()
	Call Check_InputData()'''0
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)'''HTS(*)
	if szTranID == "obtrs_oder_301a" then
		g_szTR = szTranID
		DATAMANAGER.ClearInputData(0, "obtrs_oder_301a")

		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "SVCD", 0, "301")				''' 서비스코드'
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "CHAN_TYPE_CLS_CODE", 0, "020")				''' 채널유형
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "BOND_MKPL_CLS_CODE" , 0, contBuy.cmbMkt.cbkeydata ) '시장콤보컨트롤
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "BOND_MKFN_CODL_YN", 0, contBuy.cmbSmt.cbkeydata)'동시매매 컨트롤
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "OVRL_SPTX_CLS_CODE", 0, contBuy.cmbTax.cbkeydata)''종합분리과세 컨트롤
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ACNO"				, 0, Form.GetCtlProp("#acc", "total"))	' 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ASNO"				, 0, Form.GetCtlProp("#acc", "sequence"))	' 계좌일련번호(2)
		
		'20200910 SWJ START
		'MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "caption"))	' 계좌 비밀번호
		'MTS메모리평문제거 미적용상태일 때
		else	
			DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ACNT_PWD"			, 0, Form.GetCtlProp("#edtPwd", "encdata"))	' 계좌 비밀번호
		end if
		'20200910 SWJ END
		
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ISCD"				, 0, g_szCd)'''szCd								' 종목코드
		'20160601 NOHES ODER_PRC -> BOND_ODER_UNPR
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "BOND_ODER_UNPR"			, 0, contBuy.edtPrice.caption)								' 주문단가
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ODQT"				, 0, contBuy.edtQty.caption)						' 주문수량
'		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "ODER_COND_CLS_CODE"		, 0, szType) '추가항목?								' 주문구분코드
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "BYOV_DATE"		, 0, contBuy.cldBuy.caption)'''?								' 매도일자
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "FEE_LEVY_YN", 0, "0")			' 수수료 징수 여부
		' 주문경고보류용 플래그 YGH EDIT 20191125
		DATAMANAGER.SetDataValue(0, "obtrs_oder_301a", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag) ' 주문경고 확인여부
		' 주문경고보류용 플래그 YGH EDIT 20191125

	elseif szTranID == "ohhts_7052_001r" then
		
		DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD"              , 0, g_szCd)
		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID == "obtrs_oder_301a" then
			Dim szOrdCd, szOrdMsg, szOrgNo, szWarnCd, szWarnMsg
			' 주문경고보류용 플래그 YGH EDIT 20191125
			szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	'경고구분코드 (0.정상, 1.경고, 2.보류)
			szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
			if szWarnCd = "1" then							' 경고
				Open_ConfirmPopup(szWarnMsg)
			elseif szWarnCd = "2" then						' 보류
				g_szTR = ""
				'Form.Toast(0, "보류 : [TR] " & szWarnMsg, true)
			else
				g_szTR = ""
				g_szWarnFlag = "N"
				
				szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
				szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
		
			    if Trim(szOrdCd) == "0001" then			' 정상주문
			    
				    Form.Toast(0, szOrdMsg, true)
			    
				    if g_szAfterInit == "1" then		' 주문후 초기화
				       contBuy.edtQty.caption = ""
				       contBuy.edtPrice.caption = ""
				    end if
			    
				    if g_szAfterOrg == "1" then			' 주문번호 연동
						szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
						Form.SetCtlProp("#edtOrgNo", "caption", szOrgNo)
					else
						Form.SetCtlProp("#edtOrgNo", "caption", "")
				    end if 
				
				end if
			end if
	
	elseIf szTranID == "ohhts_7052_001r" then
		'20160602 NOHES 채권 호가 단위
		Dim szPrc
		szPrc = DATAMANAGER.GetDataValue( 0, "ohhts_7052_001r", "OutBlock1", "FID_PRPR", 0)
		
		if szPrc ~= "" then
			contBuy.edtPrice.caption = szPrc
		end if
	
	End If
	' 주문경고보류용 플래그 YGH EDIT 20191125
	g_szWarnFlag = "N"	
	' 주문경고보류용 플래그 YGH EDIT 20191125
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
	' 주문경고보류용 플래그 YGH EDIT 20191125
	g_szWarnFlag = "N"
	' 주문경고보류용 플래그 YGH EDIT 20191125
	
    if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if

End Sub

'============================================================================
' 
'============================================================================
Sub contBuy_btnPPlus_OnClick()
	'20160602 NOHES START 채권 틱단위
	Dim szPlus
	
	If Trim(g_szCd) == "" Then
		szPlus = "1" 
	Else
		szPlus = Form.GetItemCodeInfo(g_szCd, "bondunit")
	End If
	'20160602 NOHES END
	
	Dim szPrc
	szPrc  = contBuy.edtPrice.caption

	if Trim(szPrc) == "" then
		'현재가 조회수행
		Request_Price()
	else
		Call Calc_Price(0,szPlus)
	end if

End Sub

'============================================================================
Sub contBuy_btnPMinus_OnClick()
	'20160602 NOHES START 채권 틱단위
	Dim szMinus
	
	If Trim(g_szCd) == "" Then
		szMinus = "1"
	Else
		szMinus = Form.GetItemCodeInfo(g_szCd, "bondunit")
	End If
	'20160602 NOHES END
	
	Dim szPrc
	szPrc  = contBuy.edtPrice.caption

	if Trim(szPrc) == "" then
		'현재가 조회수행
		Request_Price()
	else
		Call Calc_Price(1,szMinus)
	end if
End Sub

'============================================================================
' 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' 주문경고보류용 플래그 YGH EDIT 20191125
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		else
		    g_szWarnCd = "0"
		end if	
	' 주문경고보류용 플래그 YGH EDIT 20191125
    elseif sKeyName == "주문전송" then
	  if sRet == "1" then
	     DATAMANAGER.RequestTranData( "obtrs_oder_301a" )'''
	  end if   
    ' ----------------------------------------------------------------------
	' 가격확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then
	   contBuy.edtPrice.caption = sRet
	' ----------------------------------------------------------------------
	' 수량확인창에서 리턴
	' ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then
		contBuy.edtQty.caption = sRet	
    end if
End Sub

'============================================================================
' btnBalc_OnClick : 잔고버튼 클릭	
'============================================================================
Sub contBuy_btnBalc_OnClick()
	Form.triggerEvent("#", "54020_BALANCE_OPEN", "")
End Sub

'============================================================================
' 
'============================================================================
Sub contBuy_btnPrc_OnClick()
	Dim szPrc, szData

	szData = "0★" & contBuy.edtPrice.caption  & "★" & g_szMk & "★" & g_szCd

	Form.OpenPopup("mbfnp54020_p8", szData, "")
End Sub

'============================================================================
Sub contBuy_btnQty_OnClick()
	Dim szQty, szData

    szQty = contBuy.edtQty.caption
    szData = szQty
    Form.OpenPopup("mbfnp54020_p7", szData, "")
End Sub

'============================================================================
Sub contBuy_cmbMkt_OnEditComplete(iIndex)
	if iIndex == 0 then
		Form.triggerEvent("#", "BODY_CALLBACK", "B" & "★" & g_szCd)
	else
		Form.triggerEvent("#", "BODY_CALLBACK", "SB" & "★" & g_szCd)
	end if
End Sub

