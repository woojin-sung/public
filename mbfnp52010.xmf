'============================================================================
' 01. 화 면 명 : 발행어음CMA매수단위등록
' 02. 화면설명 : 발행어음CMA매수단위등록
' 03. 작    성 : 2016. 03. 03. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szID				'HTSID
Dim g_szPW				'비밀번호
Dim nDateCount			'데이터 개수
Dim g_nSConde				'종목세부분류코드
Dim g_szScode				'종목세부분류코드 저장변수
Dim g_szResNum			'등록일련번호

Dim g_nSNSType '1 카카오톡 , 2 카카오톡 화면 공유 , 3 트위터 , 4페이스북
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetResist() : 등록/변경 조치
'============================================================================
Function SetResist()
	FindCode()
	
	DATAMANAGER.ClearInputData( 0 , "obsan_bsop_238a" )
	
'	DATAMANAGER.SetDataValue( 0 , "obsan_bsop_238a", "InBlock1", "PROS_CLS_CODE" , 0 , edtCustCode.caption )	'1:개인, 2:법인
	DATAMANAGER.SetDataValue( 0 , "obsan_bsop_238a", "InBlock1", "ACNO" , 0 , acnt0.total )				'계좌번호
	DATAMANAGER.SetDataValue( 0 , "obsan_bsop_238a", "InBlock1", "ASNO" , 0 , acnt0.sequence )				'계좌번호 일련번호
	DATAMANAGER.SetDataValue( 0 , "obsan_bsop_238a", "InBlock1", "PWD" , 0 , g_szPW )						'비밀번호
	DATAMANAGER.SetDataValue( 0 , "obsan_bsop_238a", "InBlock1", "ISCD" , 0 , g_szScode )				'종목코드
	DATAMANAGER.SetDataValue( 0 , "obsan_bsop_238a", "InBlock1", "ISNT_BYOV_UNIT" , 0 , edtMoney.caption )	'발행어음매수단위
	if btn0.caption == "변경" then
		DATAMANAGER.SetDataValue( 0 , "obsan_bsop_238a", "InBlock1", "REG_SRNO" , 0 , g_szResNum )
		DATAMANAGER.SetDataValue( 0 , "obsan_bsop_238a", "InBlock1", "PROS_CLS_CODE" , 0 , "U" )	'I:등록, U:변경
	else
		DATAMANAGER.SetDataValue( 0 , "obsan_bsop_238a", "InBlock1", "PROS_CLS_CODE" , 0 , "I" )	'I:등록, U:변경
	end if
	
	DATAMANAGER.RequestTranData( "obsan_bsop_238a" )
	
End Function
'============================================================================
' FindCode() : 종목세부분류코드로 종목코드 찾기
'============================================================================
Function FindCode()
	
	edtsCode.caption = ""
	g_nSConde = acnt0.detailcode				'종목세부분류코드 받아오는것.
	
	Form.Log( "Start g_nSConde", g_nSConde)
	
	'종목세부분류코드
	Select Case g_nSConde
		Case "01"	'THECMA급여계좌
			edtsCode.caption = "NC30030"	'THE CMA 급여계좌
			g_szScode = "NC30030"
		Case "02"	'THECMAplus
			if edtCustCode.Caption = "2" then	 '법인
				edtsCode.caption = "NC30020"	'THE CMA plus(법인)
				g_szScode = "NC30020"
			else
				edtsCode.caption = "NC30010"	'THE CMA plus(개인)
				g_szScode = "NC30010"
			end if		    
		Case "03"	'CMA-S
			edtsCode.caption = "NC30050"	'CMA-S
			g_szScode = "NC30050"
		Case "04"	'CMA-W
			edtsCode.caption = "NC30040"	'CMA-W
			g_szScode = "NC30040"
		Case "07"	'e-CMA
		    edtsCode.caption = "NC20010"	'e-CMA
		    g_szScode = "NC20010"
	End Select
	
	Form.Log( "Final g_nSConde", g_nSConde)
	Form.Log( "Find g_szScode", g_szScode)
	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
	g_szID = Form.GetSharedData( "&USER_ID", False )

	DATAMANAGER.RequestTranData( "obsan_bsop_237r" )
	DATAMANAGER.RequestTranData( "obacp_comm_005r" )
	
'	FindCode()
	
End Sub
'============================================================================
' edtPW_OnEditComplete()
'============================================================================
Sub edtPW_OnEditComplete()
	
	g_szPW = Form.GetEncData( edtPW.caption )
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szAccount				'계좌번호
	
	DATAMANAGER.ClearInputData( 0 , "obsan_bsop_238a")
	
	edtCustCode.caption = ""
	edtsCode.caption = ""
	edtResNum.caption = ""
	
	if szTranID == "obsan_bsop_237r" then
		nDateCount = DATAMANAGER.GetDataCount( 0 , "obsan_bsop_237r", "OutBlock1") - 1
		for i = 0 to nDateCount
			szAccount = DATAMANAGER.GetDataValue( 0 , "obsan_bsop_237r", "OutBlock1", "ACNO" , i) & 
			DATAMANAGER.GetDataValue( 0 , "obsan_bsop_237r", "OutBlock1", "ASNO" , i)	
			
			grd0.SetCellData( "bd_cell0", i, szAccount)
'			grd0.SetCellData( "bd_cell6", i, "CMA 매수단위 등록 계좌")
		next
	elseif szTranID == "obsan_bsop_238a" then
		Form.ShowAlert( "알림", "정상처리 되었습니다." )
		DATAMANAGER.RequestTranData( "obsan_bsop_237r" )
	end if
	
End Sub
'============================================================================
' acnt0_ChangeAccount()
'============================================================================
Sub acnt0_ChangeAccount()
'	Dim szAccount			'계좌번호
'	
'	szAccount = anct0.total & anct0.sequence
'	FindCode()
	DATAMANAGER.RequestTranData( "obacp_comm_005r" )
	
	edtPW.caption = ""
	
	for i = 0 to nDateCount
		if acnt0.caption == grd0.GetCellData( "bd_cell0", i) then
			edtMoney.caption = grd0.GetCellData( "bd_cell3" , i)
			btn0.caption = "변경"
			Exit Sub
		else
			btn0.caption = "등록"
			edtMoney.caption = ""
		end if
	next
	
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID)
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obsan_bsop_237r" then
	
		DATAMANAGER.SetDataValue( 0 , "obsan_bsop_237r", "InBlock1", "ELFN_ID" , 0 , g_szID)
'		DATAMANAGER.SetDataValue( 0 , "obsan_bsop_237r", "InBlock1", "ACNO" , 0 , acnt0.total)
'		DATAMANAGER.SetDataValue( 0 , "obsan_bsop_237r", "InBlock1", "ASNO" , 0 , acnt0.sequence)
		
	elseif szTranID == "obacp_comm_005r" then
	
		DATAMANAGER.SetDataValue( 0 , "obacp_comm_005r", "InBlock1", "ACNO" , 0 , acnt0.total)
		DATAMANAGER.SetDataValue( 0 , "obacp_comm_005r", "InBlock1", "ASNO" , 0 , acnt0.sequence)
	
	elseif szTranID == "obsan_bsop_238a" then
		
		DATAMANAGER.SetEventFlag( "obsan_bsop_238a" , "A")
		
	end if
	
End Sub
'============================================================================
' btn0_OnClick()
'============================================================================
Sub btn0_OnClick()
	Dim szData
	
	szData = acnt0.total&acnt0.sequence & "★" & edtMoney.caption		'계좌번호, 발행어음매수단위
	
	if edtPW.caption == "" or edtPW.caption == Null then
		Form.ShowAlert( "알림", "비밀번호를 입력해주세요.")
		Exit Sub
	elseif edtMoney.caption == "" then
		Form.ShowAlert( "알림", "자동매수단위를 입력해주세요.")
		Exit Sub
	end if
	
	Form.OpenPopup( "mbfnp52010_p1" , szData , sPosInfo)
	
End Sub
'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "Ok" then
		SetResist()
	elseif sKeyName = "snsshare" Then   ' SNS공유
		g_nSNSType = Cint(sRet)
	
		If g_nSNSType = 2 Then          ' 이미지공유
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			   
			Form.SaveScreenShot( szFileName )  
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else              ' 현재가공유
			Form.triggerEvent("linkfmHoga", "sharedata", "")   
		End If
	
	End If
		
End Sub
'============================================================================
' grd0_OnClickUp(lRow, szCellID)
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szClickAcnt			'계좌번호
	Dim szClinkMoney			'자동매수단위

	
	szClickAcnt = grd0.GetCellData( "bd_cell0" , lRow)		'계좌번호
	acnt0.caption = szClickAcnt
	
	szClinkMoney = grd0.GetCellData( "bd_cell3" , lRow)		'자동매수단위
	edtMoney.caption = szClinkMoney
	
	g_szResNum = grd0.GetCellData( "bd_cell5", lRow)			'등록일련번호
	edtResNum.caption = szResNum
	btn0.caption = "변경"
	
End Sub


'============================================================================
Sub edtMoney_OnEditComplete()
	
	if edtMoney.caption == "" or edtMoney.caption == Null then
		
	elseif Int(edtMoney.caption) < 500000 then
		Form.ShowAlert( "알림", "50만원 이상만 가능합니다.")
		edtMoney.caption = ""
		Exit Sub
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szErr
	
	if szTranID == "obsan_bsop_238a" then
		szErr = DATAMANAGER.GetDataMsgSubText( "obsan_bsop_238a" )
		Form.ShowAlert( "알림", szErr)
	end if
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	If sEventName = "SCREEN_MENU" Then       ' 연결정보(상단 ...)
	
		If sParam = "SHA_SNS" Then        ' SNS공유
			Form.OpenDialog("sharesns1" , "0", "")
		End If
	
	ElseIf sEventName = "sharedata" Then
		Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
		
	End If

End Sub

