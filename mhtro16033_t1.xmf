<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="16033" scrname="증시일정_한국" version="2" writer="이재원" />
	<FORM_INFO name="Form" ly_vert="0,0,375,523,1" />
	<CONTROL_INFO>
		<WEBVIEW name="WebView0" urlpath="about:blank" ly_vert="0,0,375,523,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="606" _ulen="606" >
'============================================================================
Sub Form_OnFormInit()
	WebView0.urlpath = "http://realtimeweb.einfomax.co.kr/m/mzs_index.html#/schedule/t1"
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	WebView0.urlpath = "http://realtimeweb.einfomax.co.kr/m/mzs_index.html#/schedule/t1"
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "SCREEN_REFRESH"	then
		Form_OnRefresh()
	end if
End Sub

	</SCRIPT_INFO>
</ROOT>