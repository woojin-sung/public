	<SCRIPT_INFO _len="5766" _ulen="5552" >
Dim g_sAcno
Dim g_sAsno
Dim g_slRow
'============================================================================
Sub Form_OnFormInit()
	DATAMANAGER.RequestTranData( "obsap_smpr_010r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obsap_smpr_010r" Then
		Grid0.SetClear( )
		DATAMANAGER.SetDataValue(0, "obsap_smpr_010r", "InBlock1", "ACNO" , 0, Left(acnt.caption , 8 ))
		DATAMANAGER.SetDataValue(0, "obsap_smpr_010r", "InBlock1", "ASNO" , 0, Mid(acnt.caption, 9, 2))
	ElseIf szTranID == "obsap_smpr_004a" Then
		DATAMANAGER.SetDataValue(0, "obsap_smpr_004a", "InBlock1", "ACNO" 			, 0, Left(acnt.caption , 8 )								)
		DATAMANAGER.SetDataValue(0, "obsap_smpr_004a", "InBlock1", "ASNO" 			, 0, Mid(acnt.caption, 9, 2)								)
		DATAMANAGER.SetDataValue(0, "obsap_smpr_004a", "InBlock1", "SMPR_APLT_SRNO" 	, 0, Int(Grid0.GetCellData("bd_cell1", g_slRow))	)
		DATAMANAGER.SetDataValue(0, "obsap_smpr_004a", "InBlock1", "ACNT_PWD" 		, 0, Edit0.encdata	)
	End If
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obsap_smpr_010r" Then
		DataCnt = Grid0.rowcount

		For i = 0 to DataCnt-1
			Grid0.SetCellFgColor("bd_cell0" , i, "0")
			Grid0.SetCellFgColor("bd_cell4" , i, "1")
			Grid0.SetCellFgColor("bd_cell5" , i, "2")
			Grid0.SetCellFgColor("bd_cell10" , i, "0")
			Grid0.SetCellFgColor("bd_cell13" , i, "0")
			Grid0.SetCellData("bd_cell4" , i, "Long"			)
			Grid0.SetCellData("bd_cell5" , i, "Short"		)
			Grid0.SetCellBgColor( "bd_cell2", i, "70" ) '회색
			Grid0.SetCellBgColor( "bd_cell3", i, "70" ) '회색
			Grid0.SetCellBgColor( "bd_cell4", i, "70" ) '회색
			Grid0.SetCellBgColor( "bd_cell5", i, "70" ) '회색
			
			Grid0.SetCellData("bd_cell8" , i, DATAMANAGER.GetDataValue( 0,"obsap_smpr_010r", "OutBlock1", "SMPR_BYOV_ISNM1" , i ) ) ' Long
			Grid0.SetCellData("bd_cell9" , i, DATAMANAGER.GetDataValue( 0,"obsap_smpr_010r", "OutBlock1", "SMPR_SELN_ISNM1" , i ) ) ' Short
			
			If Len(DATAMANAGER.GetDataValue( 0,"obsap_smpr_010r", "OutBlock1", "SMPR_BYOV_ISNM2" , i )) <> 0 Then
				Grid0.SetCellData("bd_cell8" , i, DATAMANAGER.GetDataValue( 0,"obsap_smpr_010r", "OutBlock1", "SMPR_BYOV_ISNM1" , i ) & " / " & DATAMANAGER.GetDataValue( 0,"obsap_smpr_010r", "OutBlock1", "SMPR_BYOV_ISNM2" , i ) ) ' Long
			End If
			
			If Len(DATAMANAGER.GetDataValue( 0,"obsap_smpr_010r", "OutBlock1", "SMPR_SELN_ISNM2" , i )) <> 0 Then
				Grid0.SetCellData("bd_cell9" , i, DATAMANAGER.GetDataValue( 0,"obsap_smpr_010r", "OutBlock1", "SMPR_SELN_ISNM1" , i ) & " / " & DATAMANAGER.GetDataValue( 0,"obsap_smpr_010r", "OutBlock1", "SMPR_SELN_ISNM2" , i ) ) ' Long
			End If
		
			
			If DATAMANAGER.GetDataValue( 0,"obsap_smpr_010r", "OutBlock1", "SMPR_PRGS_STAT_CLCD" , i ) == "0" Then '검토대기
			
				Grid0.SetCellBgColor( "bd_cell0" , i, "100"  )
				
			ElseIf DATAMANAGER.GetDataValue( 0,"obsap_smpr_010r", "OutBlock1", "SMPR_PRGS_STAT_CLCD" , i ) == "1" Then ' 청약대기
'			
				Grid0.SetCellBgColor( "bd_cell0" , i, "8"  )'초록
				
				Grid0.SetCellBgColor( "bd_cell10", i, "1"  )'빨강
				Grid0.SetCellBgColor( "bd_cell13", i, "80" ) '회색
				
			ElseIf DATAMANAGER.GetDataValue( 0,"obsap_smpr_010r", "OutBlock1", "SMPR_PRGS_STAT_CLCD" , i ) == "5" Then
				Grid0.SetCellBgColor( "bd_cell0", i, "99" ) '노랑
			ElseIf DATAMANAGER.GetDataValue( 0,"obsap_smpr_010r", "OutBlock1", "SMPR_PRGS_STAT_CLCD" , i ) == "6" Then
				Grid0.SetCellBgColor( "bd_cell0", i, "2" ) '파랑
			ElseIf DATAMANAGER.GetDataValue( 0,"obsap_smpr_010r", "OutBlock1", "SMPR_PRGS_STAT_CLCD" , i ) == "7" Then ' 환매대기
				Grid0.SetCellBgColor( "bd_cell0", i, "100" ) '파랑
			End If
		Next
	ElseIf szTranID == "obsap_smpr_004a" Then
		Form.ShowAlert("알림", "취소가 완료되었습니다.")
		DATAMANAGER.RequestTranData( "obsap_smpr_010r" )
	End If
End Sub

'============================================================================
Sub Combo0_OnEditComplete(iIndex)
	DATAMANAGER.RequestTranData( "obsap_smpr_010r" )
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	If Grid0.GetCellData(szCellID, lRow) == "상품확정" Then
		
		If LEN(Edit0.caption) == 0 Then
			Form.ShowAlert("알림", "비밀번호를 입력하세요.")
			Exit Sub
		End If
		sOpenData = Left(acnt.caption , 8 ) & "★" & Mid(acnt.caption, 9, 2) & "★" & Edit0.encdata & "★" & Int(Grid0.GetCellData("bd_cell1", lRow))
		Form.OpenFramePopup( "mbfnp55001_p1" ,sOpenData, "" ) ' 계좌번호★계좌일련번호★계좌비밀번호★신청일련번호
	ElseIf Grid0.GetCellData(szCellID, lRow) == "취소" Then
		g_slRow = lRow
		Form.MsgBox( "취소", "상품발행을 취소하시겠습니까?", "CANCEL", 1 )
	End If
End Sub


'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	If sKeyName == "CANCEL" Then
		If sRet == "ok" Then
			DATAMANAGER.RequestTranData( "obsap_smpr_004a" )
		Else
			Exit Sub
		End If
	End If
End Sub

'============================================================================
Sub acnt_ChangeAccount()
	DATAMANAGER.RequestTranData( "obsap_smpr_010r" )
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")

End Sub


