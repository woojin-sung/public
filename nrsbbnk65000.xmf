Sub contMain_imgSwap_OnClick()
'	if g_isEnable_Total == false then
'		Exit Sub
'	end if

	if g_isEnable == false then
		Exit Sub
	end if
	
	
	if g_szSvcd_Buy == "002" then
		Exit Sub
	end if
	
	contMain.imgSwap.visible = false
	Request_Tran_obtsd_fbnk_009r("SWAP_CRCD", "3", g_szAcno, g_szAsno, "", g_szCrcd_Buy)
End Sub

'===============================================
' Form_OnTimerEvent
' 화면 진입 시, 환전가능여부 체크
'===============================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(sTimerID, 0, 0)
	
	
	if Cint(sTimerID) == 1 then
		DisplaySetting_Info()
		DisplaySetting_VndInfo()
		
		' 초기설정 값(원화>달러)
		Select_Crcd("2", "KRW", g_szLinkCrcd)
		
		if g_szAcno == "" then
			g_isEnable_Total = false
		else
			Request_Tran_obtsd_fbnk_009r("FORM_INIT", "6",g_szAcno, g_szAsno, "","")
			'Request_Tran_obtsd_fbnk_009r_TimeChk("FORM_INIT", "0")
		end if
		
	elseif Cint(sTimerID) == 2 then
'		DisplaySetting_Info()
'		DisplaySetting_VndInfo()
		
		' 초기설정 값(원화>달러)
		'Select_Crcd("2", g_szCrcd_Sell, g_szCrcd_Buy)
		
		if g_szAcno == "" then
			g_isEnable_Total = false
		else
			Request_Tran_obtsd_fbnk_009r("FORM_INIT", "6",g_szAcno, g_szAsno, "","")
			'Request_Tran_obtsd_fbnk_009r_TimeChk("FORM_INIT", "0")
		end if
	end if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "StepBack" then
		Form.Toast(2, "환율이 변동되어 환전금액을 다시 계산했습니다.", true)
		
		Input_Amt(g_szAmtGbn_Retry, g_szAmt_Retry)
'		g_szAmtGbn_Retry = ""
'		g_szAmt_Retry = ""
'		g_szExStep = "" 
		
	elseif sKeyName == "해외주식거래신청" then
		if sRet == "ok" then
			Form.OpenScreen("87051", "")
		end if
'	elseif sKeyName == "시간외불가" then
'		Request_Tran_obtsd_fbnk_009r("ONLY_ACCOUNT", "2", g_szAcno, g_szAsno, "", "")
	end if
End Sub


