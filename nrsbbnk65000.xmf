	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_201r_1" , "InBlock1" , "ASNO" , 0 , g_szAsno)
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_201r_1" , "InBlock1" , "CRCD" , 0 , szCrcd )
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_201r_1" , "InBlock1" , "SVCD" , 0 , szSvcd)
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_201r_1" , "InBlock1" , "MNEC_CLCD" , 0 , szGbn)
	
	DATAMANAGER.RequestTranData("obtsd_fbnk_201r_1")
End Function

'==============================================
' 환전 환율 조회 처리
'==============================================
Function Process_Tran_obtsd_fbnk_201r()
	szApBy =  DATAMANAGER.GetDataValue(false, "obtsd_fbnk_201r", "OutBlock1", "TLTR_APLY_BYRT" , 0)
	szApSl =  DATAMANAGER.GetDataValue(false, "obtsd_fbnk_201r", "OutBlock1", "TLTR_APLY_SLRT", 0)
	szAptm =	 DATAMANAGER.GetDataValue(false, "obtsd_fbnk_201r", "OutBlock1", "EXRT_STND_TIME" , 0)
	szDcrt =	 DATAMANAGER.GetDataValue(false, "obtsd_fbnk_201r", "OutBlock1", "DCRT", 0)
	szSpread = DATAMANAGER.GetDataValue(false,"obtsd_fbnk_201r", "OutBlock1", "SPEAD" , 0)

	g_szExRate_Time1 = szAptm
	g_szExRate_Spread1 = szSpread
	
	if g_szCrcd_Sell == "KRW" or g_szCrcd_Buy == "KRW" then
	
		if g_szCrcd_Sell == "KRW" then
			
			'재조회 케이스
			if instr(g_szExStep, "Step1") > 0  then
				if g_nExRate_1 <> Cdbl(szApBy) then
					g_szExStep = g_szExStep & "`N"
				else
					g_szExStep = g_szExStep & "`Y"
				end if
			end if
			
			g_szRateCnt = g_szRateCnt -1
			g_nExRate_1_Prev = g_nExRate_1
			g_nExRate_1 = Cdbl(szApBy)
			
			
			if Cdbl(szDcrt) == 0 or szDcrt == "" then
				contMain.lblExchangeInfo01.visible = false
			else
				contMain.lblExchangeInfo01.visible = true
				contMain.lblExchangeInfo01.bgcolor = g_szBadgeBgColor_Red
'				contMain.lblExchangeInfo01.imagefilepth = "roundbox_4r_pink.9"
				contMain.lblExchangeInfo01.fgcolor = g_szTxtColor_Red
				contMain.lblExchangeInfo01.caption = Cdbl(szDcrt) &"% 우대"
			end if
		elseif g_szCrcd_Buy = "KRW" then
			
			'재조회 케이스
			if instr(g_szExStep, "Step1") > 0 then
				if g_nExRate_1 <> Cdbl(szApSl) then
					g_szExStep = g_szExStep & "`N"
				else
					g_szExStep = g_szExStep & "`Y"
				end if
			end if
			
			g_szRateCnt = g_szRateCnt -1
			g_nExRate_1_Prev = g_nExRate_1
			g_nExRate_1 = Cdbl(szApSl)
			
			if Cdbl(szDcrt) == 0 or szDcrt == "" then
				contMain.lblExchangeInfo01.visible = false
			else
				contMain.lblExchangeInfo01.visible = true
				contMain.lblExchangeInfo01.bgcolor = g_szBadgeBgColor_Blue
'				contMain.lblExchangeInfo01.imagefilepth = "roundbox_4r_blue.9"
				contMain.lblExchangeInfo01.fgcolor = g_szTxtColor_Blue
				contMain.lblExchangeInfo01.caption = Cdbl(szDcrt) &"% 우대"
			end if
		end if
	else
		'이종통화 환전
		
		'재조회 케이스
		if instr(g_szExStep, "Step1") > 0  then
			if g_nExRate_1 <> Cdbl(szApSl) then
				g_szExStep = g_szExStep & "`N"
			else
				g_szExStep = g_szExStep & "`Y"
			end if
		end if
		
		g_szRateCnt = g_szRateCnt -1	
		g_nExRate_1_Prev = g_nExRate_1
		g_nExRate_1 = Cdbl(szApSl)
		
		if Cdbl(szDcrt) == 0 or szDcrt == "" then
			contMain.lblExchangeInfo01.visible = false
		else
			contMain.lblExchangeInfo01.visible = true
			contMain.lblExchangeInfo01.bgcolor = g_szBadgeBgColor_Blue
'			contMain.lblExchangeInfo01.imagefilepth = "roundbox_4r_blue.9"
			contMain.lblExchangeInfo01.fgcolor = g_szTxtColor_Blue
			contMain.lblExchangeInfo01.caption = Cdbl(szDcrt) &"% 우대"
		end if
	end if
	
	contMain.lblExchange00.caption = FormatNumber(g_nExRate_1, 2) & "원"
	
	contMain.imgRe0.visible = true
	
	if g_szRateCnt == 0 then
		Process_Retry_ExchangeRate()
	end if
End Function

Function Process_Tran_obtsd_fbnk_201r_1()
	szApBy =  DATAMANAGER.GetDataValue(false, "obtsd_fbnk_201r_1", "OutBlock1", "TLTR_APLY_BYRT" , 0)
	szApSl =  DATAMANAGER.GetDataValue(false, "obtsd_fbnk_201r_1", "OutBlock1", "TLTR_APLY_SLRT", 0)
	szAptm =	 DATAMANAGER.GetDataValue(false, "obtsd_fbnk_201r_1", "OutBlock1", "EXRT_STND_TIME" , 0)
	szDcrt =	 DATAMANAGER.GetDataValue(false, "obtsd_fbnk_201r_1", "OutBlock1", "DCRT", 0)
	szSpread = DATAMANAGER.GetDataValue(false,"obtsd_fbnk_201r_1", "OutBlock1", "SPEAD" , 0)
	
	g_szExRate_Time2 = szAptm
	g_szExRate_Spread2 = szSpread
	
	'재조회 케이스
	if instr(g_szExStep, "Step1") > 0 then
		if g_nExRate_2 <> Cdbl(szApBy) then
			g_szExStep = g_szExStep & "`N"
		else
			g_szExStep = g_szExStep & "`Y"
		end if
	end if
		
	g_szRateCnt = g_szRateCnt -1
	g_nExRate_2_Prev = g_nExRate_2
	g_nExRate_2 =  Cdbl(szApBy)
	
	if Cdbl(szDcrt) == 0 or szDcrt == "" then
		contMain.lblExchangeInfo11.visible = false
	else
		contMain.lblExchangeInfo11.visible = true
		contMain.lblExchangeInfo11.bgcolor = g_szBadgeBgColor_Red
'		contMain.lblExchangeInfo11.imagefilepth = "roundbox_4r_pink.9"
		contMain.lblExchangeInfo11.fgcolor = g_szTxtColor_Red
		contMain.lblExchangeInfo11.caption = Cdbl(szDcrt) &"% 우대"
	end if
		
	contMain.lblExchange10.caption = FormatNumber(g_nExRate_2, 2) & "원"
	contMain.imgRe0.visible = true
	
	if g_szRateCnt == 0 then
		Process_Retry_ExchangeRate()
	end if
End Function



