'===============================================
' Form_OnPopupReturn
'===============================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "SELECT_CRCD" then
		Select_Crcd(g_szCrcdGbn, sRet, "")
		
		Request_Tran_obtsd_fbnk_009r_TimeChk("SELECT_CRCD", "0")
		
	elseif sKeyName = "INPUT_AMT" then
		if sRet == "Cancel" then
			g_szAmtGbn = "" 
			Exit Sub
		end if
		

		g_szAmtGbn_Retry = g_szAmtGbn
		g_szAmt_Retry = sRet
		Input_Amt(g_szAmtGbn, sRet)
		
	elseif sKeyName = "EXCHANGE_INFO_RETURN" then
		'시간외환전 안내팝업 리턴
		if sRet == "0" then
'			if g_szEvent_009r == "FORM_INIT" or g_szEvent_009r == "CHANGE_ACCOUNT" then 
'				Request_Tran_obtsd_fbnk_009r(g_szEvent_009r, "6", g_szAcno, g_szAsno, "", "")
'			'elseif g_szEvent_009r == "SELECT_CRCD" then
'				'
'			else
				'컨트롤 입력 가능
				g_isEnable = true
'			end if
		end if
	
	elseif sKeyName = "EXCHANGE_STEP0" then
			
		if sRet = "OK" then
			g_szExStep = "Step1"
			
			'계좌 비밀번호 검증 전 환율 변동 체크
			Request_ExchangeRate()
		end if
		
	elseif sKeyName = "EXCHANGE_END" then
		' 초기설정 값(원화>달러)
		Select_Crcd("2", "KRW", "USD")
		
		btnOk.enable = false
		btnOk.btnimage = "btn_09.9"
		btnOk.fgcolor = g_szTxtColor_Grey
	
		'Request_Tran_obtsd_fbnk_009r("FORM_INIT", "0", "", "", "", "USD")
		Request_Tran_obtsd_fbnk_009r("FORM_INIT", "6",g_szAcno, g_szAsno, "","")
		'Request_Tran_obtsd_fbnk_009r_TimeChk("FORM_INIT", "0")
		
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim tData
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
				g_szPwd = tData(0)
			end if
			
			g_szExStep = "Step2"
			
			szCertUserType= Form.GetSharedData("&CERT_USE_TYPE", false )
			
			If szCertUserType == "1" Or szCertUserType == 1 Then 
			    Form.OpenFramePopup( "mhetc90060_px" , "" , "")
			Else
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
			End if
		end if
		
	elseif sKeyName = "mhetc90060_p5" or sKeyName = "mhetc90060_px" then
		if sRet == "ok" then
			
			g_szExStep = "Step3"
			
			if g_szCrcd_Sell == "KRW" or g_szCrcd_Buy == "KRW" then
				'환전신청(매수/매도)
				Request_Tran_obtsd_fbnk_202a()	
				
			elseif g_szCrcd_Sell == "VND" or g_szCrcd_Buy == "VND" then
				'이종통화 환전신청(베트남)
				Request_Tran_obtsd_fbnk_301a()	
				
			else
				'이종통화 환전신청(외국)
				Request_Tran_obtsd_fbnk_321a()	
				
			end if
		else
			exit sub
		end if
	elseif sKeyName == "해외주식거래신청" then
		if sRet == "ok" then
			Form.OpenScreen("87051", "")
		end if
	end if
End Sub

'============================================================================
Sub acntMain_ChangeAccount()
	g_szAcno = acntMain.total
	g_szAsno = acntMain.sequence
	g_szPwd  = ""
	
	Form.SetSharedData("65000_ACC_TYPE", acntMain.itemcodetype) 
	
	Select_Crcd("2", "KRW", "USD")
	
	if g_szAcno == "" then
		g_isEnable_Total = false
	else
		
		Request_Tran_obtsd_fbnk_009r("CHANGE_ACCOUNT", "6",g_szAcno, g_szAsno, "","")
		'Request_Tran_obtsd_fbnk_009r_TimeChk("CHANGE_ACCOUNT", "0")
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obrtd_fcur_001r" then
		Process_Tran_obrtd_fcur_001r()
		
	elseif szTranID == "obtsd_fbnk_201r" then
		Process_Tran_obtsd_fbnk_201r()
		
	elseif szTranID == "obtsd_fbnk_201r_1" then
		Process_Tran_obtsd_fbnk_201r_1()
		
	elseif szTranID == "obtsd_fbnk_202a" then	
		Process_Tran_obtsd_fbnk_202a()
		
	elseif szTranID == "obtsd_fbnk_009r" then
		Process_Tran_obtsd_fbnk_009r()
		
	elseif szTranID == "obtsd_fbnk_009r_1" then
		Process_Tran_obtsd_fbnk_009r_1()
		
	elseif szTranID == "obtsd_fbnk_009r_2" then
		Process_Tran_obtsd_fbnk_009r_2()
		
	elseif szTranID == "obtsd_fbnk_009r_3" then
		Process_Tran_obtsd_fbnk_009r_3()
		
	elseif szTranID == "obtsd_fbnk_301a" then	
		Process_Tran_obtsd_fbnk_301a()
		
	elseif szTranID == "obtsd_fbnk_321a" then		
		Process_Tran_obtsd_fbnk_321a()

	elseif szTranID == "obtsd_fbnk_008r" then		
		Process_Tran_obtsd_fbnk_008r()
		
	elseif szTranID == "obtsd_fbnk_008r_1" then		
		Process_Tran_obtsd_fbnk_008r_1()
		
	elseif szTranID == "obtsd_fbnk_008r_2" then		
		Process_Tran_obtsd_fbnk_008r_2()
		
	elseif szTranID == "obtsd_fbnk_008r_3" then		
		Process_Tran_obtsd_fbnk_008r_3()
		
	elseif szTranID == "obacp_comm_008r" then		
		Process_Tran_obacp_comm_008r()
		
	elseif szTranID == "obacp_comm_008r_1" then		
		Process_Tran_obacp_comm_008r_1()
		
	elseif szTranID == "obrtp_comn_035r" then		
		Process_Tran_obrtp_comn_035r()
		
	elseif szTranID == "obrtp_comn_035r_1" then		
		Process_Tran_obrtp_comn_035r_1()
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtsd_fbnk_202a" then
		szSubMsg = DATAMANAGER.GetDataMsgSubText("obtsd_fbnk_202a")
		Error_Tran_obtsd_fbnk_202a(szErrCode, szErrMsg, szSubMsg)

	elseif szTranID == "obtsd_fbnk_301a" then	
		szSubMsg = DATAMANAGER.GetDataMsgSubText("obtsd_fbnk_301a")
		Error_Tran_obtsd_fbnk_301a(szErrCode, szErrMsg, szSubMsg)
		
	elseif szTranID == "obtsd_fbnk_321a" then
		szSubMsg = DATAMANAGER.GetDataMsgSubText("obtsd_fbnk_321a")
		Error_Tran_obtsd_fbnk_321a(szErrCode, szErrMsg, szSubMsg)
		
	elseif szTranID == "obtsd_fbnk_009r" then
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.MsgBox("알림" , szErrMsg & "\n(" & szSubMsg & ")" , "", 0)	
		
		Error_Tran_obtsd_fbnk_009r()	
	elseif szTranID == "obtsd_fbnk_009r_1" then
		Process_Tran_obtsd_fbnk_009r_1()
	elseif szTranID == "obtsd_fbnk_009r_2" then
		Process_Tran_obtsd_fbnk_009r_2()
	elseif szTranID == "obtsd_fbnk_009r_3" then
		Process_Tran_obtsd_fbnk_009r_3()
		
	else
		szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.MsgBox("알림" , szErrMsg & "\n(" & szSubMsg & ")" , "", 0)	
	end if
End Sub


'============================================================================
Sub contMain_imgRe0_OnClick()
	if g_szCrcd_Sell == "VND" or g_szCrcd_Buy == "VND" then 
		Exit Sub
	end if
	
	contMain.imgRe0.visible = false
	
	if g_szCrcd_Sell == "KRW" or g_szCrcd_Buy == "KRW" then
		'원화 매수/매도 여부에 따라 환전환율 대응
		if g_szCrcd_Sell == "KRW" then
			g_szRateCnt = 1
			Request_Tran_obtsd_fbnk_201r(g_szCrcd_Buy, g_szSvcd_Buy, "1")	
			
		elseif g_szCrcd_Buy = "KRW" then
			g_szRateCnt = 1
			Request_Tran_obtsd_fbnk_201r(g_szCrcd_Sell, g_szSvcd_Sell, "2")	
		end if
	else
		g_szRateCnt = 2
		Request_Tran_obtsd_fbnk_201r(g_szCrcd_Sell, g_szSvcd_Sell, "2")
		Request_Tran_obtsd_fbnk_201r_1(g_szCrcd_Buy, g_szSvcd_Buy, "1")
	end if
End Sub

