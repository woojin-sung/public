		end if
	end if
	
	Request_Tran_obrtp_comn_035r()
	Request_Tran_obrtp_comn_035r_1()
	
	
	Input_Amt("0", "")
	Input_Amt("1", "")
	
	g_szCrcdGbn = ""
End Function

Function Request_ExchangeRate()
	'환전(매수/매도)
	if g_szCrcd_Sell == "KRW" or g_szCrcd_Buy == "KRW" then
		'원화 매수/매도 여부에 따라 환전환율 대응
		if g_szCrcd_Sell == "KRW" then
			g_szRateCnt = 1
			Request_Tran_obtsd_fbnk_201r(g_szCrcd_Buy, g_szSvcd_Buy, "1")	
			
		elseif g_szCrcd_Buy = "KRW" then
			g_szRateCnt = 1
			Request_Tran_obtsd_fbnk_201r(g_szCrcd_Sell, g_szSvcd_Sell, "2")	
		end if
	
	'이종통화(매수/매도)
	else
		
		if g_szCrcd_Sell == "VND" or g_szCrcd_Buy == "VND" then 
			if g_szExStep == "Step1" then
				Form.openPopupAnimation("pwdcheckpopup", g_szAcno & g_szAsno & "☆0" ,"","2")
			end if
		else
			g_szRateCnt = 2
			Request_Tran_obtsd_fbnk_201r(g_szCrcd_Sell, g_szSvcd_Sell, "2")
			Request_Tran_obtsd_fbnk_201r_1(g_szCrcd_Buy, g_szSvcd_Buy, "1")
		end if
	end if
End Function

Function Process_Retry_ExchangeRate()
	
	if g_szCrcd_Sell == "KRW" or g_szCrcd_Buy == "KRW" then
		if g_szExStep == "Step1`Y" then
			Form.openPopupAnimation("pwdcheckpopup", g_szAcno & g_szAsno & "☆0" ,"","2")
			
		elseif g_szExStep == "Step1`N" then
			Form.MsgBox("알림", "환율이 변동되었습니다.\n최근 환율로 재 조회 후 환전 신청을 진행해주세요.", "StepBack", 6)
			
		else
			if g_szAmt_Retry <> "" then
				isCalc = false
				
				if g_nExRate_1_Prev <> 0 and g_nExRate_1_Prev <> g_nExRate_1 then
					isCalc = true
				end if
			
				if g_nExRate_2_Prev <> 0 and g_nExRate_2_Prev <> g_nExRate_2 then
					isCalc = true
				end if
				
				if isCalc == true then
					Form.Toast(2, "환율이 변동되어 환전금액을 다시 계산했습니다.", true)
					Input_Amt(g_szAmtGbn_Retry, g_szAmt_Retry)
				end if
				
			end if
		end if
	
	'이종통화(매수/매도)
	else
		if g_szCrcd_Sell == "VND" or g_szCrcd_Buy == "VND" then 
			'none
		else
			if g_szExStep == "Step1`Y`Y" then
				Form.openPopupAnimation("pwdcheckpopup", g_szAcno & g_szAsno & "☆0" ,"","2")
				
			elseif g_szExStep == "Step1`N`Y" or g_szExStep == "Step1`Y`N" or g_szExStep == "Step1`N`N" then
				Form.MsgBox("알림", "환율이 변동되었습니다.\n최근 환율로 재 조회 후 환전 신청을 진행해주세요.", "StepBack", 6)
			else
				if g_szAmt_Retry <> ""  then
					isCalc = false
					if g_nExRate_1_Prev <> 0 and g_nExRate_1_Prev <> g_nExRate_1 then
						isCalc = true
					end if
				
					if g_nExRate_2_Prev <> 0 and g_nExRate_2_Prev <> g_nExRate_2 then
						isCalc = true
					end if
				
					if isCalc == true then
						Form.Toast(2, "환율이 변동되어 환전금액을 다시 계산했습니다.", true)
						Input_Amt(g_szAmtGbn_Retry, g_szAmt_Retry)
					end if
					
				end if
			end if
		end if
	end if
End Function

Function Input_Amt(szGbn, szAmt)
	if szGbn == "0" then
		if szAmt <> "" then
			szResult = ""

			szResult = Convert_FormatNumber(g_szCrcd_Sell, szAmt)
			
			contMain.lblSellAmt.fgcolor = g_szTxtColor_Normal
			contMain.lblSellAmt.caption = szResult
			
			if g_szCrcd_Sell <> "VND" and g_szCrcd_Buy <> "VND" then 
				Calc_Exchange("0", Cdbl(szAmt))
			else
				if contMain.lblSellAmt.caption <> "" and contMain.lblSellAmt.caption <> "매도금액입력" then
		
					nPrc = cdbl(replace(contMain.lblSellAmt.caption, ",", ""))
					if nPrc > 0 then
						btnOk.enable = true
						btnOk.btnimage = "btn_20.9"
						btnOk.fgcolor = g_szTxtColor_White
					else
						btnOk.enable = false
						btnOk.btnimage = "btn_09.9"
						btnOk.fgcolor = g_szTxtColor_Grey
					end if
				else
					btnOk.enable = false
					btnOk.btnimage = "btn_09.9"
					btnOk.fgcolor = g_szTxtColor_Grey
				end if
			end if
		else
			contMain.lblBuyAmt.fgcolor = g_szTxtColor_Grey2
			contMain.lblBuyAmt.caption = "매수금액입력"
			
			contMain.lblSellAmt.fgcolor = g_szTxtColor_Grey2
			contMain.lblSellAmt.caption = "매도금액입력"
			
			g_szAmtGbn_Retry = ""
			g_szAmt_Retry = ""
		
			btnOk.enable = false
			btnOk.btnimage = "btn_09.9"
			btnOk.fgcolor = g_szTxtColor_Grey
		end if
	elseif szGbn == "1" then
		contMain.lblBuyAmt.fontsize = 6
		if szAmt <> "" then
			szResult = ""

			szResult = Convert_FormatNumber(g_szCrcd_Buy, szAmt)
			
			contMain.lblBuyAmt.fgcolor = g_szTxtColor_Normal
			contMain.lblBuyAmt.caption = szResult
			
			Calc_Exchange("1", Cdbl(szAmt))
		else
			if g_szCrcd_Sell == "VND" or g_szCrcd_Buy == "VND" then 
				contMain.lblBuyAmt.fontsize = 2
				contMain.lblBuyAmt.fgcolor = g_szTxtColor_Grey2
				contMain.lblBuyAmt.caption = "현지 환전 후 금액 확정"
			else
				contMain.lblSellAmt.fgcolor = g_szTxtColor_Grey2
				contMain.lblSellAmt.caption = "매도금액입력"
			
				contMain.lblBuyAmt.fgcolor = g_szTxtColor_Grey2
				contMain.lblBuyAmt.caption = "매수금액입력"
				
				g_szAmtGbn_Retry = ""
				g_szAmt_Retry = ""
		
				btnOk.enable = false
				btnOk.btnimage = "btn_09.9"
				btnOk.fgcolor = g_szTxtColor_Grey
			end if
		end if
	end if

	g_szAmtGbn = ""
End Function

Function Calc_Exchange(szGbn, nAmt)
	'매도금액 입력
	if szGbn == "0" then
		if g_szCrcd_Sell == "KRW" then 	
			'입력한 금액이 매도금액이고 원화인 경우
			'원화(입력) -> 외화 
			Request_Tran_obtsd_fbnk_008r("1", "1", "2", nAmt)
			
		elseif g_szCrcd_Buy == "KRW" then 
			
			'입력한 금액이 매도금액이고 외화인 경우
			'외화(입력) -> 원화
			Request_Tran_obtsd_fbnk_008r("1", "2", "1", nAmt)

		else
			'입력한 금액이 매도금액이고 외화인 경우
			'외화(입력) -> 원화 -> 외화 
			g_isCrossChk = true
			Request_Tran_obtsd_fbnk_008r("2", "2", "1", nAmt)
		end if
		
	'매수금액 입력
	elseif szGbn == "1" then
		if g_szCrcd_Sell == "KRW" then 
			'입력한 금액이 매도금액이고 원화인 경우
			'원화 -> 외화(입력) 
			Request_Tran_obtsd_fbnk_008r("1", "1", "1", nAmt)
			
		elseif g_szCrcd_Buy == "KRW" then 
			Request_Tran_obtsd_fbnk_008r("1", "2", "2", nAmt)
			
		else
			'입력한 금액이 매도금액이고 외화인 경우
			'외화 -> 원화 -> 외화(입력) 
			g_isCrossChk = true
			Request_Tran_obtsd_fbnk_008r("3", "1", "1", nAmt)

		end if
	end if
	
End Function


Function truncateToDecimalPlaces(nVal, nDeimalPlaces)
	nFactor = 10 ^ nDeimalPlaces
	return int(nVal*nFactor) / nFactor
End Function

Function Convert_FormatNumber(szCrcd, szAmt)
	if szCrcd == "KRW" or szCrcd == "JPY" then
		return FormatNumber(szAmt, 0) 
	else
		return FormatNumber(szAmt, 2)
	end if
End Function


Function Swap_OrderType()	
	Select_Crcd("2", g_szCrcd_Buy, g_szCrcd_Sell)
	
	Request_Tran_obtsd_fbnk_009r_TimeChk("SELECT_CRCD_SWAP", "0")
End Function

