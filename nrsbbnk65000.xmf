	g_szLinkSubData2  = ""
End Function



'==============================================
' 환전 환율 조회
'==============================================
Function Request_Tran_obtsd_fbnk_201r(szCrcd, szSvcd, szGbn)	
	g_szExRate_Time1 = ""
	g_szExRate_Spread1 = ""
	
	if szSvcd <> "001" then
		szSvcd = "003" 
	end if
	
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_201r")
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_201r" , "InBlock1" , "ACNO" , 0 , g_szAcno)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_201r" , "InBlock1" , "ASNO" , 0 , g_szAsno)
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_201r" , "InBlock1" , "CRCD" , 0 , szCrcd )
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_201r" , "InBlock1" , "SVCD" , 0 , szSvcd)
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_201r" , "InBlock1" , "MNEC_CLCD" , 0 , szGbn)
	
	DATAMANAGER.RequestTranData("obtsd_fbnk_201r")
End Function

Function Request_Tran_obtsd_fbnk_201r_1(szCrcd, szSvcd, szGbn)	
	g_szExRate_Time2 = ""
	g_szExRate_Spread2 = ""
	
	
	if szSvcd <> "001" then
		szSvcd = "003" 
	end if
	
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_201r_1")
	
