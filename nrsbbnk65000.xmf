'			
'		elseif g_szCrcd_Buy = "KRW" then
'			Request_Tran_obtsd_fbnk_201r(g_szCrcd_Sell, g_szSvcd_Sell, "2")	
'		end if
	
	'이종통화(매수/매도)
	else
		if g_szCrcd_Sell == "VND" or g_szCrcd_Buy == "VND" then 
			contMain.contInfo.visible = false
			contMain.contInfoVND.visible = true
			
			
			'2열 환율정보 보임처리
			contMain.lblExchangeInfo10.visible = false
			contMain.lblExchangeInfo11.visible = false
			contMain.lblExchange10.visible = false
'			contMain.imgRe1.visible = false
			
			'1열 우대율 보임처리(환율정보 조회 이후 다시 표시)
			contMain.lblExchangeInfo01.visible = false
			contMain.imgRe0.visible = false
			
			'데이터 초기화
			contMain.lblExchangeInfo00.caption = g_szCrcd_Sell & "→" & g_szCrcd_Buy
			
			contMain.lblExchange00.caption = "미정"
'			contMain.lblExchange00.left = 220
			
			contMain.imgBg01.height 	= 100
			contMain.lblLink.top 		= 320
			contMain.lblBg.height 		= 360
			
			contMain.contInfo.top		= 370 
			contMain.contInfoVND.top	= 370 
			
			contMain.setScrollAutoSize()
		
		else
			contMain.contInfo.visible = true
			contMain.contInfoVND.visible = false
			
		
			'2열 환율정보 보임처리
			contMain.lblExchangeInfo10.visible = true
			contMain.lblExchangeInfo11.visible = false
			contMain.lblExchange10.visible = true
'			contMain.imgRe1.visible = true
			
			'1열 우대율 보임처리(환율정보 조회 이후 다시 표시)
			contMain.lblExchangeInfo01.visible = false
			contMain.imgRe0.visible = true
			
			'데이터 초기화
			contMain.lblExchangeInfo00.caption = g_szCrcd_Sell & "→KRW"
			contMain.lblExchangeInfo10.caption = "KRW→" & g_szCrcd_Buy
			
			contMain.imgBg01.height 	= 126
			contMain.lblLink.top 		= 345
			contMain.lblBg.height 		= 385
			
			contMain.contInfo.top		= 395 
			contMain.contInfoVND.top	= 395
			
			contMain.setScrollAutoSize()
			
