Sub contMain_lblLink_OnClick()
	if g_szCrcd_Sell == "KRW" then
		szData = g_szCrcd_Buy
	elseif g_szCrcd_Buy == "KRW" then
		szData = g_szCrcd_Sell
	elseif g_szCrcd_Buy == "VND" or g_szCrcd_Sell == "VND" then
		szData = "USD"
	else
		szData = g_szCrcd_Buy
	end if
	Form.OpenPopup("nrsbbnk65100_popup", szData, "")
End Sub

