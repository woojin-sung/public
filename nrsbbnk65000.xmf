'===============================================
' 컨트롤 초기설정
'===============================================
Function Init_Control()
	'-----------------------------------------------
	' 타이틀 초기화
	'-----------------------------------------------
	lblTitle.caption = g_szTitle
	lblTitle.paddinginfo = "0,0,0,0"
	
	nWidth = Form.GetTextWidth(g_szTitle, 3, false, false)
	
	imgTitleArrow.maintainratio = "2" 
	imgTitleArrow.imgpath = g_szArrowImg
	imgTitleArrow.visible = true
	imgTitleArrow.left = 47 + nWidth + 10
	
	'-----------------------------------------------
	' 뒤로가기 버튼 초기화
	'-----------------------------------------------
	imgBack.SetMaintainingRatio("2")
	imgBack.imgpath = g_szBackImg
	
	'-----------------------------------------------
	' 유의사항 버튼 초기화
	'-----------------------------------------------
	imgInfo.SetMaintainingRatio("3")
	imgInfo.imgpath = g_szInfoImg
	
	'-----------------------------------------------
	' 상단영역 컨트롤 초기화
	'-----------------------------------------------
	contMain.setExceptInvisibleCtl(true)
	
	contMain.contInfo.setExceptInvisibleCtl(true)
	contMain.contInfo.setEnableScroll(false)
	
	contMain.contInfoVND.setExceptInvisibleCtl(true)
	contMain.contInfoVND.setEnableScroll(false)
	
	contMain.lblBg.bgcolor = g_szContBgColor
	contMain.lblDivLine01.bgcolor = g_szLineColor
	
	contMain.lblSubTitle00.paddinginfo = "0,0,0,0"
	contMain.lblSubTitle00.fgcolor = g_szTxtColor_Grey
	contMain.lblSubTitle00.caption = "보유통화"
	
	contMain.lblSubTitle01.paddinginfo = "0,0,0,0"
	contMain.lblSubTitle01.fgcolor = g_szTxtColor_Grey
	contMain.lblSubTitle01.caption = "환전통화"
	
	contMain.lblAbleAmt.paddinginfo = "0,0,0,0"
	contMain.lblAbleAmt.fgcolor = g_szTxtColor_Grey
	contMain.lblAbleAmt.maxlinecnt = "1"
	contMain.lblAbleAmt.caption = "환전가능"
	
	contMain.imgFlag00.maintainratio = "2" 
	contMain.imgFlag01.maintainratio = "2" 

	contMain.imgArrow00.maintainratio = "1" 
	contMain.imgArrow00.imgpath = g_szArrowImg
	contMain.imgArrow01.maintainratio = "1" 
	contMain.imgArrow01.imgpath = g_szArrowImg
	
	contMain.imgSwap.maintainratio = "1"
	contMain.imgSwap.imgpath = g_szExchangeImg
	
	contMain.lblCrcd00.paddinginfo = "0,0,0,0"
	contMain.lblCrcd00.fgcolor = g_szTxtColor_Normal
	
	contMain.lblCrcd01.paddinginfo = "0,0,0,0"
	contMain.lblCrcd01.fgcolor = g_szTxtColor_Normal
	
	contMain.lblSellAmt.paddinginfo = "0,0,0,0"
	contMain.lblSellAmt.fgcolor = g_szTxtColor_Grey2
	contMain.lblSellAmt.maxlinecnt = "1"
	contMain.lblSellAmt.caption = "매도금액입력"
	
	contMain.lblBuyAmt.paddinginfo = "0,0,0,0"
	contMain.lblBuyAmt.fgcolor = g_szTxtColor_Grey2
	contMain.lblBuyAmt.maxlinecnt = "1"
	contMain.lblBuyAmt.caption = "매수금액입력"

	g_szAmtGbn_Retry = ""
	g_szAmt_Retry = ""
	'-----------------------------------------------
	' 하단영역 컨트롤 초기화
	'-----------------------------------------------
	contMain.lblSubTitle02.paddinginfo = "0,0,0,0"
	contMain.lblSubTitle02.fgcolor = g_szTxtColor_Grey
	contMain.lblSubTitle02.caption = "환전환율"
	
	contMain.lblSubTitle03.paddinginfo = "0,0,0,0"
	contMain.lblSubTitle03.maxlinecnt = "1"
	contMain.lblSubTitle03.fgcolor = g_szTxtColor_Red
	
	contMain.lblExchangeInfo00.paddinginfo = "0,0,0,0"
	contMain.lblExchangeInfo00.fgcolor = g_szTxtColor_Normal
	contMain.lblExchangeInfo00.maxlinecnt = "1"
	contMain.lblExchangeInfo00.caption = "KRW→USD"
	
	contMain.lblExchangeInfo01.paddinginfo = "0,0,0,0"
	contMain.lblExchangeInfo01.maxlinecnt = "1"
	contMain.lblExchangeInfo01.fgcolor = g_szTxtColor_Red
	
	contMain.lblExchangeInfo10.paddinginfo = "0,0,0,0"
	contMain.lblExchangeInfo10.fgcolor = g_szTxtColor_Normal
	contMain.lblExchangeInfo10.maxlinecnt = "1"
	contMain.lblExchangeInfo10.caption = "KRW→USD"
	
	contMain.lblExchangeInfo11.paddinginfo = "0,0,0,0"
	contMain.lblExchangeInfo11.maxlinecnt = "1"
	contMain.lblExchangeInfo11.fgcolor = g_szTxtColor_Red
	
	contMain.lblExchangeInfo01.bgcolor = g_szBadgeBgColor_Red	
	contMain.lblExchangeInfo11.bgcolor = g_szBadgeBgColor_Red

	contMain.lblExchange00.paddinginfo = "0,0,0,0"
	contMain.lblExchange00.maxlinecnt = "1"
	contMain.lblExchange00.fgcolor = g_szTxtColor_Normal
	
	contMain.lblExchange10.paddinginfo = "0,0,0,0"
	contMain.lblExchange10.maxlinecnt = "1"
	contMain.lblExchange10.fgcolor = g_szTxtColor_Normal
	
	contMain.imgRe0.maintainratio = "3"
	contMain.imgRe0.imgpath = g_szRefreshImg
	
	contMain.lblLink.paddinginfo = "0,0,0,0"
	contMain.lblLink.fgcolor = g_szTxtColor_Grey
	contMain.lblLink.caption = "실시간 환율 조회 >"
	
	'-----------------------------------------------
	' 유의사항 초기화
	'-----------------------------------------------
	contMain.contInfo.lblInfoTitle.paddinginfo = "0,0,0,0"
	contMain.contInfo.lblInfoTitle.fgcolor = g_szTxtColor_Grey
	
	contMain.contInfo.lblInfo0.paddinginfo = "0,0,0,0"
	contMain.contInfo.lblInfo0.fgcolor = g_szTxtColor_Grey
	contMain.contInfo.lblInfo0.caption = "환전 신청 후 취소 불가하오니 유의하시기 바랍니다."
	
	contMain.contInfo.lblGuide0.paddinginfo = "0,0,0,0"
	contMain.contInfo.lblGuide0.fgcolor = g_szTxtColor_Grey
	
	contMain.contInfo.lblInfo1.paddinginfo = "0,0,0,0"
	contMain.contInfo.lblInfo1.fgcolor = g_szTxtColor_Grey
	contMain.contInfo.lblInfo1.caption = "실시간 환율 적용으로 조회시점과 환전 처리시점의 환율이 달라질 수 있습니다."
	
	contMain.contInfo.lblGuide1.paddinginfo = "0,0,0,0"
	contMain.contInfo.lblGuide1.fgcolor = g_szTxtColor_Grey
	
	contMain.contInfo.lblInfo2.paddinginfo = "0,0,0,0"
	contMain.contInfo.lblInfo2.fgcolor = g_szTxtColor_Grey
	contMain.contInfo.lblInfo2.caption = "환전 신청 후, 반드시 환전 처리결과 여부를 확인하시기 바랍니다."
	
	contMain.contInfo.lblGuide2.paddinginfo = "0,0,0,0"
	contMain.contInfo.lblGuide2.fgcolor = g_szTxtColor_Grey
	
	contMain.contInfoVND.lblGuide1.paddinginfo = "0,0,0,0"
	contMain.contInfoVND.lblGuide1.fgcolor = g_szTxtColor_Grey
	
	contMain.contInfoVND.lblInfo1.paddinginfo = "0,0,0,0"
	contMain.contInfoVND.lblInfo1.fgcolor = g_szTxtColor_Grey
	contMain.contInfoVND.lblInfo1.caption = "베트남 현지 사정 또는 국내/현지 휴일 등의 사유로 환전 결제일이 지연될 수 있습니다."
	
	g_szAcno = acntMain.total
	g_szAsno = acntMain.sequence
	Form.SetSharedData("65000_ACC_TYPE", acntMain.itemcodetype) 
	
	btnOk.enable = false
	
	szFlag = Form.getIconImg("CRCD", "KRW")
	if szFlag = "" then
		szFlag = "flag_general"
	end if
	
	contMain.imgFlag00.imgpath = szFlag
	contMain.lblCrcd00.caption = "KRW"

	
	szFlag = Form.getIconImg("CRCD", "USD")
	if szFlag = "" then
		szFlag = "flag_general"
	end if
	
	contMain.imgFlag01.imgpath = szFlag
	contMain.lblCrcd01.caption = "USD"
	
	nTxtWidth = Form.getTextWidth(contMain.lblCrcd00.caption, "0", true, false)
	nImgLeft = 60 + nTxtWidth + 5
	contMain.imgArrow00.left = nImgLeft
	
	nTxtWidth = Form.getTextWidth(contMain.lblCrcd01.caption, "0", true, false)
	nImgLeft = 60 + nTxtWidth + 5
	contMain.imgArrow01.left = nImgLeft
End Function

'==============================================
' 일반/이종통화 환전 안내 표시
'==============================================
Function DisplaySetting_Info()
	nLineCnt0 = contMain.contInfo.lblInfo0.linecnt
	nLineCnt1 = contMain.contInfo.lblInfo1.linecnt
	nLineCnt2 = contMain.contInfo.lblInfo2.linecnt
	
	szTextSize = Form.getEnvData("common.textsize")
	szOsType = Form.GetSharedData("&OS_TYPE", false)
	
	nGap = 1
	
	if szOsType == "1" then
		nGap = 1
	elseif szOsType == "2" then
		nGap = 3
	end if
	
	nHeight = 18 + (cint(szTextSize) * nGap)
	
	contMain.contInfo.lblInfo0.height = nLineCnt0 * nHeight
	
	contMain.contInfo.lblInfo1.top = 34 + nLineCnt0 * nHeight + 2
	contMain.contInfo.lblGuide1.top = 34 + nLineCnt0 * nHeight + 2
	contMain.contInfo.lblInfo1.height = nLineCnt1 * nHeight
	
	contMain.contInfo.lblInfo2.top = 34 + nLineCnt0 * nHeight  + 2 + nLineCnt1 * nHeight + 2
	contMain.contInfo.lblGuide2.top = 34 + nLineCnt0 * nHeight + 2 + nLineCnt1 * nHeight + 2
	contMain.contInfo.lblInfo2.height = nLineCnt2 * nHeight
	
	contMain.contInfo.height = 34 + nLineCnt0 * nHeight + 2 + nLineCnt1 * nHeight + 2 + nLineCnt2 * nHeight + 20
End Function

'==============================================
' 베트남 환전 안내 표시
'==============================================
Function DisplaySetting_VndInfo()
	nLineCnt1 = contMain.contInfoVND.lblInfo1.linecnt
	
	szTextSize = Form.getEnvData("common.textsize")
	szOsType = Form.GetSharedData("&OS_TYPE", false)
	
	nGap = 1
	
	if szOsType == "1" then
		nGap = 1
	elseif szOsType == "2" then
		nGap = 3
	end if
	
	nHeight = 18 + (cint(szTextSize) * nGap)
	
	contMain.contInfo.lblInfo1.height = nLineCnt1 * nHeight
End Function

'==============================================
' 1. 환전 가능 여부 확인
'==============================================
' 매도/매수통화 환전 가능시간 체크
Function Request_Tran_obtsd_fbnk_009r_TimeChk(szEvnet, szGbnCd)
	g_isEnable = false
	g_szClsCd_009r = szGbnCd	'조회구분(비동기 처리용)
	g_szEvent_009r = szEvnet	'이벤트명(비동기 처리용)
	
	'------------------------
	' 환전 서비스코드 초기화
	'------------------------
	g_szSvcd_Sell_Prev 	= g_szSvcd_Sell	' 매도통화(이전)
	g_szSvcd_Buy_Prev 	= g_szSvcd_Buy   	' 매수통화(이전)
	g_szSvcd_VND_Prev 	= g_szSvcd_VND   	' 베트남(이전)
	
	g_szSvcd_Sell	= ""		' 매도통화
	g_szSvcd_Buy 	= ""		' 매수통화
	g_szSvcd_VND 	= ""		' 베트남 
	
	g_szExStep = "" 
	
	'-------------------------------------
	' 일반/이종통화 서비스콜 카운트 초기화
	'-------------------------------------
	g_nChk_009r = 0
	
	'-------------------------------------
	' 환전 가능시간 서비스 호출 START
	'-------------------------------------
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_009r_1")	'매도통화
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_009r_2")	'매수통화
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_009r_3")	'베트남
	
	'베트남 환전 가능시간 체크
	if g_szCrcd_Sell == "VND" or g_szCrcd_Buy == "VND" then
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_3", "InBlock1", "IQRY_CLS_CODE", 0 , "1")
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_3", "InBlock1", "ACNO", 0 , "")
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_3", "InBlock1", "ASNO", 0 , "")
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_3", "InBlock1", "SVCD", 0 , "")
		
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_3", "InBlock1", "CRCD", 0 , "VND")
		
		DATAMANAGER.RequestTranData("obtsd_fbnk_009r_3")
	
	
	'일반/이종통화 환전 가능시간 체크
	else
		' 매도통화 환전가능 시간 체크
		if g_szCrcd_Sell == "KRW" then
			g_nChk_009r = g_nChk_009r + 1
		else
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_1", "InBlock1", "IQRY_CLS_CODE", 0 , "0")
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_1", "InBlock1", "ACNO", 0 , "")
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_1", "InBlock1", "ASNO", 0 , "")
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_1", "InBlock1", "SVCD", 0 , "")
			
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_1", "InBlock1", "CRCD", 0 , g_szCrcd_Sell)
			
			DATAMANAGER.RequestTranData("obtsd_fbnk_009r_1")
		end if
		
		
		' 매수통화 환전가능 시간 체크
		if g_szCrcd_Buy == "KRW" then
			g_nChk_009r = g_nChk_009r + 1
		else
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_2", "InBlock1", "IQRY_CLS_CODE", 0 , "0")
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_2", "InBlock1", "ACNO", 0 , "")
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_2", "InBlock1", "ASNO", 0 , "")
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_2", "InBlock1", "SVCD", 0 , "")
			
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r_2", "InBlock1", "CRCD", 0 , g_szCrcd_Buy)
			
			DATAMANAGER.RequestTranData("obtsd_fbnk_009r_2")
		end if
	end if
	'-------------------------------------
	' 환전 가능시간 서비스 호출 END
	'-------------------------------------
End Function

'==============================================
' 2. 환전 가능 여부 처리
'==============================================
' 베트남 환전가능 시간 체크
Function Process_Tran_obtsd_fbnk_009r_3()
	szYn		=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r_3", "OutBlock1", "TR_ABLE_YN", 0)
	
	g_szSvcd_VND = szYn
	
	Process_Tran_obtsd_fbnk_009r()
End Function


' 매도통화 환전가능 시간 체크
Function Process_Tran_obtsd_fbnk_009r_1()
	szSVCD	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r_1", "OutBlock1", "SVCD", 0)
	
	g_szSvcd_Sell = szSVCD

	g_nChk_009r = g_nChk_009r + 1
	
	if g_nChk_009r == 2 then
		g_nChk_009r = 0
		
		Process_Tran_obtsd_fbnk_009r()
		
		if g_szEvent_009r <> "START_EXCHANGE" then
			contMain_imgRe0_OnClick()
		end if
	end if
End Function

' 매수통화 환전가능 시간 체크
Function Process_Tran_obtsd_fbnk_009r_2()
	szSVCD	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r_2", "OutBlock1", "SVCD", 0)
	
	g_szSvcd_Buy = szSVCD

	g_nChk_009r = g_nChk_009r + 1
	
	if g_nChk_009r == 2 then
		g_nChk_009r = 0
		
		Process_Tran_obtsd_fbnk_009r()
		
		if g_szEvent_009r <> "START_EXCHANGE" then
			contMain_imgRe0_OnClick()
		end if

	end if
End Function

'--------------------------------------------------------------------------------------------------------
' 화면 시작 및 초기화 : 환전 가능여부 체크 -> 사고계좌 체크 -> 해외주식 약정 체크 -> 계좌 상세정보 조회 
' 계좌변경 : 환전 가능여부 체크 -> 사고계좌 체크 -> 해외주식 약정 체크 -> 계좌 상세정보 조회
' 통화변경 : 환전 가능여부 체크
' 매수/매도 변경 : 환전 가능여부 체크 -> 잔고체크
'--------------------------------------------------------------------------------------------------------
' szClsCd(조회구분) 							
' - 2 : 계좌 해외주식 약정체크 	(szEvnet, 2, szAcno, szAsno, "", "")
' - 3 : 외화 잔고 체크 		(szEvnet, 3, szAcno, szAsno, "", szCrcd)
'--------------------------------------------------------------------------------------------------------
Function Request_Tran_obtsd_fbnk_009r(szEvnet, szGbnCd, szAcno, szAsno, szSvcd, szCrcd)
	g_isEnable = false
	g_szClsCd_009r = szGbnCd	'조회구분(비동기 처리용)
	g_szEvent_009r = szEvnet	'이벤트명(비동기 처리용)

	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_009r")
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r", "InBlock1", "IQRY_CLS_CODE", 0 , szGbnCd)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r", "InBlock1", "ACNO", 0 , szAcno)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r", "InBlock1", "ASNO", 0 , szAsno)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r", "InBlock1", "SVCD", 0 , szSvcd)
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_009r", "InBlock1", "CRCD", 0 , szCrcd)
	
	DATAMANAGER.RequestTranData("obtsd_fbnk_009r")
End Function


'==============================================
' 환전 가능 여부 처리
'==============================================
Function Process_Tran_obtsd_fbnk_009r()	

	' - 0, 1 : 서버기준 환전신청 실시간/시간외/불가 확인(이종통화&USD)
	if g_szClsCd_009r == "0" or g_szClsCd_009r == "1" then
		Check_Svcd()
		
	' - 2 : 계좌 해외주식 약정체크 						(2, szAcno, szAsno, "", "")
	elseif g_szClsCd_009r == "2" then
		szYn = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "TR_ABLE_YN", 0)		' 환전 가능여부
		szRespMsg = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "RSPN_CNTT", 0)		' 응답메시지
		
		Check_Account(szYn, szRespMsg) 
		
	' - 3 : 외화 잔고 체크 							(3, szAcno, szAsno, "", szCrcd)	
	elseif g_szClsCd_009r == "3" then
		szYn = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "TR_ABLE_YN", 0)		' 환전 가능여부
		szRespMsg = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "RSPN_CNTT", 0)		' 응답메시지
		
		Check_Balance(szYn, szRespMsg) 
		
	' - 6 : 사고계좌 체크
	elseif g_szClsCd_009r == "6" then
		szYn = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "TR_ABLE_YN", 0)		' 환전 가능여부
		szRespMsg = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "RSPN_CNTT", 0)		' 응답메시지
		
		Check_Suspend(szYn, szRespMsg) 
	end if 

End Function


Function Error_Tran_obtsd_fbnk_009r()

	' - 2 : 계좌 해외주식 약정체크 						(2, szAcno, szAsno, "", "")
	if g_szClsCd_009r == "2" then
		szYn = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "TR_ABLE_YN", 0)		' 환전 가능여부
		szRespMsg = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "RSPN_CNTT", 0)		' 응답메시지
		
		Check_Account(szYn, szRespMsg) 
		
	' - 3 : 외화 잔고 체크 							(3, szAcno, szAsno, "", szCrcd)	
	elseif g_szClsCd_009r == "3" then
		szYn = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "TR_ABLE_YN", 0)		' 환전 가능여부
		szRespMsg = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_009r", "OutBlock1", "RSPN_CNTT", 0)		' 응답메시지
		
		Check_Balance(szYn, szRespMsg) 
	end if 
	
	g_isEnable = false
End Function

Function DisableAlter(szCrcd)
	if szCrcd == "USD" then
		Form.ShowAlert("알림", "환전 가능 시간이 아닙니다\n\n·실시간환전 : 영업일09:00~익일02:00\n·시간외환전 : 익일02:00~익영업일06:00")
	else
		Form.ShowAlert("알림", "환전 가능 시간이 아닙니다\n\n·실시간환전 : 영업일09:00~영업일15:30\n·시간외환전 : 영업일:15:40~익영업일06:00")
	end if
End Function

'==============================================
' 환전가능여부 체크
'==============================================
Function Check_Svcd() 
	if g_szSvcd_Sell == "" and g_szSvcd_Buy == "" and g_szSvcd_VND == "" then
		Form.ShowAlert("안내", "환전가능시간 조회에 실패하였습니다.")
		Exit Function
	end if
	
	'시간외 환전 텍스트 표기(불가)
	contMain.lblSubTitle03.caption = ""
	contMain.lblSubTitle03.top = 267
	
	'--------------------------------------------------------------------------------------------------------
	' 베트남환전 환전가능 여부 체크 START
	'--------------------------------------------------------------------------------------------------------
	if g_szCrcd_Sell == "VND" or g_szCrcd_Buy == "VND" then

		if g_szSvcd_VND == "Y" then
			'컨트롤 입력 가능 
			g_isEnable = true
		else
			Form.ShowAlert("알림", "환전 가능 시간이 아닙니다\n\n·베트남환전 : 09:00~17:00")
			Exit Function
		end if
		
	'--------------------------------------------------------------------------------------------------------
	' 베트남환전 환전가능 여부 체크 END
	'--------------------------------------------------------------------------------------------------------
	
	else
		'--------------------------------------------------------------------------------------------------------
		' 환전(일반/이종) 환전가능 여부 체크 START
		'--------------------------------------------------------------------------------------------------------
		' 환전불가
		if g_szSvcd_Sell == "X05" or g_szSvcd_Buy == "X05" then
			Form.ShowAlert("알림", "환전 가능 시간이 아닙니다\n(23:50 ~ 00:20 환전불가)")
			g_isEnable_Total = false
			Exit Function
		end if
		
		'매도통화 선택
		if g_szLastSelGbn == "0" then
			'---------------------------------------------------
			'매도통화 선택기준
			'---------------------------------------------------
			if g_szCrcd_Sell == "USD" then
				if g_szSvcd_Sell == "X01" then
					DisableAlter(g_szCrcd_Sell)
					g_isEnable_Total = false
					Exit Function
					
				elseif g_szSvcd_Buy == "X01" then
					DisableAlter(g_szCrcd_Buy)
					g_isEnable_Total = false
					Exit Function
					
				elseif g_szSvcd_Buy == "X02" then
					Form.MsgBox("알림", "시간외환전은 USD, HKD, EUR, CHF 매수만 가능합니다.", "시간외불가", 6)
					Exit Function
					
				end if
				
			elseif g_szCrcd_Sell == "KRW" then
				szChkSvcd = g_szSvcd_Buy
				
				if szChkSvcd == "X01" then
					DisableAlter(g_szCrcd_Buy)
					g_isEnable_Total = false
					Exit Function
					
				elseif szChkSvcd == "X02" then
					Form.MsgBox("알림", "시간외환전은 USD, HKD, EUR, CHF 매수만 가능합니다.", "시간외불가", 6)
					Exit Function	
				end if
				
			else
				'실시간 시간 외 USD/KRW를 제외한 외화는 무조건 환전불가 안내
				if g_szSvcd_Sell == "X01" then
					DisableAlter(g_szCrcd_Sell)
					g_isEnable_Total = false
					Exit Function
				end if

			end if

			
		'매수통화 선택
		elseif g_szLastSelGbn == "1"  then
			if g_szCrcd_Buy == "USD" then
				if g_szSvcd_Buy == "X01" then
					DisableAlter(g_szCrcd_Buy)
					g_isEnable_Total = false
					Exit Function
					
				elseif g_szSvcd_Sell == "X01" then
					DisableAlter(g_szCrcd_Sell)
					g_isEnable_Total = false
					Exit Function
					
				elseif g_szSvcd_Sell == "X02" then
					Form.MsgBox("알림", "시간외환전은 USD, HKD, EUR, CHF 매수만 가능합니다.", "시간외불가", 6)
					Exit Function
				end if
			elseif g_szCrcd_Buy == "KRW" then
				szChkSvcd = g_szSvcd_Sell
				
				if szChkSvcd == "X01" then
					DisableAlter(g_szCrcd_Sell)
					g_isEnable_Total = false
					Exit Function
					
				elseif szChkSvcd == "X02" then
					Form.MsgBox("알림", "시간외환전은 USD, HKD, EUR, CHF 매수만 가능합니다.", "시간외불가", 6)
					'통화코드 정리
					Exit Function	
				end if
				
			elseif g_szCrcd_Buy == "HKD" or g_szCrcd_Buy == "CHF" or g_szCrcd_Buy == "EUR" then
				if g_szCrcd_Sell == "USD" and g_szSvcd_Sell == "002" and g_szSvcd_Buy == "002" then
					Form.MsgBox("알림", "시간외환전은 USD, HKD, EUR, CHF 매수만 가능합니다.", "시간외불가", 6)
					Exit Function
					
				elseif g_szSvcd_Buy == "X01" then
					DisableAlter(g_szCrcd_Buy)
					g_isEnable_Total = false
					'통화코드 정리
					Exit Function	
				end if
			else
				if g_szSvcd_Buy == "X01" then
					DisableAlter(g_szCrcd_Buy)
					g_isEnable_Total = false
					Exit Function
					
				elseif g_szSvcd_Buy == "X02" then
					Form.MsgBox("알림", "시간외환전은 USD, HKD, EUR, CHF 매수만 가능합니다.", "시간외불가", 6)
					Exit Function
				end if
			
			end if
			
		'매도/매수통화 동시 선택
		else
			if g_szCrcd_Sell == "KRW" then
				szChkSvcd = g_szSvcd_Buy
				
				if szChkSvcd == "X01" then
					DisableAlter(g_szCrcd_Buy)
					g_isEnable_Total = false
					Exit Function
					
				elseif szChkSvcd == "X02" then
					Form.MsgBox("알림", "시간외환전은 USD, HKD, EUR, CHF 매수만 가능합니다.", "시간외불가", 6)
					Exit Function	
				end if
				
			elseif g_szCrcd_Buy == "KRW" then
				szChkSvcd = g_szSvcd_Sell
				
				if szChkSvcd == "X01" then
					DisableAlter(g_szCrcd_Sell)
					g_isEnable_Total = false
					Exit Function
					
				elseif szChkSvcd == "X02" then
					Form.MsgBox("알림", "시간외환전은 USD, HKD, EUR, CHF 매수만 가능합니다.", "시간외불가", 6)
					'통화코드 정리
					Exit Function	
				end if
			else
				if g_szSvcd_Buy == "X01" or g_szSvcd_Sell == "X01" then
					if g_szSvcd_Buy == "X01" then
						DisableAlter(g_szCrcd_Buy)
					elseif g_szSvcd_Sell == "X01" then
						DisableAlter(g_szCrcd_Sell)
					end if
					
					g_isEnable_Total = false
					Exit Function
				elseif g_szSvcd_Buy == "X02" or g_szSvcd_Sell == "X02" then
				
					Form.MsgBox("알림", "시간외환전은 USD, HKD, EUR, CHF 매수만 가능합니다.", "시간외불가", 6)
					Exit Function
				end if
			end if

		end if
			
		' 시간외 환전 안내팝업
		if g_szSvcd_Buy == "002" then
			
			if g_szCrcd_Sell == "USD" then
				contMain.lblSubTitle03.top = 295
			else
				contMain.lblSubTitle03.top = 267
			end if
			
			contMain.lblSubTitle03.caption = "시간외환전"
			
			if g_szSvcd_Buy <> g_szSvcd_Buy_Prev then
				Form.OpenPopup("nrsbbnk65000_p1" , "0" ,"")
				Exit Function
			end if
		end if
	end if
	
'	'계좌 약정체크 이어서 진행(화면진입 / 계좌변경)
'	if g_szEvent_009r == "FORM_INIT" or g_szEvent_009r == "CHANGE_ACCOUNT" then
'	
'		'환전가능 계좌 체크
'		if g_szAcno <> "" and g_szAsno <> "" then
'			Request_Tran_obtsd_fbnk_009r(g_szEvent_009r, "6", g_szAcno, g_szAsno, "", "")
'		end if
		
	
	'통화코드 변경 시
	if g_szEvent_009r == "SELECT_CRCD" then
		
		'로직이 이게 맞나?
		if g_szCrcd_Sell == "VND" or g_szCrcd_Buy == "VND" then
			Form.OpenPopup("nrsbbnk65000_p1" , "1" ,"")
		end if
		
		'컨트롤 입력 가능
		g_isEnable = true
		
	elseif  g_szEvent_009r == "SELECT_CRCD_SWAP" then
		'컨트롤 입력 가능
		g_isEnable = true
		
	elseif g_szEvent_009r == "START_EXCHANGE" then
		g_isEnable = true
		
		g_szExStep = "Step0"
		
		szLinkData = ""
		
		szLinkData = g_szCrcd_Sell & "`"& contMain.lblSellAmt.caption
		szLinkData = szLinkData & "★" & g_szCrcd_Buy & "`"& contMain.lblBuyAmt.caption
		szLinkData = szLinkData & "★" & g_nExRate_1 & "`" & g_nExRate_2
		szLinkData = szLinkData & "★" & g_szSvcd_Sell & "`" & g_szSvcd_Buy
		
		Form.OpenPopup("nrsbbnk65000_p4" , szLinkData , "")
	else
	
		'컨트롤 입력 가능
		g_isEnable = true
	end if

	'--------------------------------------------------------------------------------------------------------
	' 환전(일반/이종) 환전가능 여부 체크 END
	'--------------------------------------------------------------------------------------------------------
End Function



'==============================================
' 계좌 상세정보 조회
'==============================================
Function Request_Tran_obacp_comm_008r()	
	DATAMANAGER.ClearInputData(false, "obacp_comm_008r")
	
	DATAMANAGER.SetDataValue(false, "obacp_comm_008r", "InBlock1", "ACNO", 0 , g_szAcno)
	DATAMANAGER.SetDataValue(false, "obacp_comm_008r", "InBlock1", "ASNO", 0 , g_szAsno)
	
	DATAMANAGER.RequestTranData("obacp_comm_008r")
End Function

Function Request_Tran_obacp_comm_008r_1()
	g_szCtcd = ""
	DATAMANAGER.ClearInputData(false, "obacp_comm_008r_1")
	
	DATAMANAGER.SetDataValue(false, "obacp_comm_008r_1", "InBlock1", "ACNO", 0 , g_szAcno)
	DATAMANAGER.SetDataValue(false, "obacp_comm_008r_1", "InBlock1", "ASNO", 0 , g_szAsno)
	
	DATAMANAGER.RequestTranData("obacp_comm_008r_1")
End Function

Function Process_Tran_obacp_comm_008r()	
	szPrcd = DATAMANAGER.GetDataValue(false, "obacp_comm_008r", "OutBlock1", "PRCD" , 0)
	
	if szPrcd == "100" then
		szFnprExusYn = DATAMANAGER.GetDataValue(false, "obacp_comm_008r", "OutBlock1", "FNPR_EXUS_YN" , 0)
		
		if szFnprExusYn == "Y" then
			Form.ShowAlert("알림", "외화금융상품거래 신청 후 이용 가능합니다.\n영업점 또는 HTS에서 신청 후 이용해주세요.")
			Exit Function
		end if
	end if
	
	Form.OpenPopup("nrsbbnk65000_p6" , "" , "")
	'Form.MsgBox("알림", "해외주식거래 신청 후 이용 가능합니다.\n신청화면으로 이동하시겠습니까?", "해외주식거래신청", 7, "해외주식거래 신청", "취소")
End Function


Function Process_Tran_obacp_comm_008r_1()	
	szPrcd = DATAMANAGER.GetDataValue(false, "obacp_comm_008r_1", "OutBlock1", "PRCD" , 0)
	
	if szPrcd == "137" then
		szCtcd = DATAMANAGER.GetDataValue(false, "obacp_comm_008r_1", "OutBlock1", "CTCD" , 0)
		
		'미국
		if szCtcd == "840" then
			g_szCtcd = "USD"
		'중국
		elseif szCtcd == "156" then
			g_szCtcd = "CNY"
		'홍콩
		elseif szCtcd == "344" then
			g_szCtcd = "HKD"
		'일본
		elseif szCtcd == "392" then
			g_szCtcd = "JPY"
		end if
		

		'if g_szCrcd_Buy <> g_szCtcd then
			Select_Crcd("1", g_szCtcd, "")
			Request_Tran_obtsd_fbnk_009r_TimeChk("SELECT_CRCD", "0")
		'end if
	else
		Request_Tran_obtsd_fbnk_009r_TimeChk(g_szEvent_009r, "0")
	end if
End Function

'==============================================
' 사고계좌 체크
'==============================================
Function Check_Suspend(szYN, szMsg) 
	if szYN == "N" then
		'컨트롤 입력 불가
		g_isEnable_Total = false
		g_isEnable = false
		
		'거래불가 계좌 안내팝업
		Form.ShowAlert("알림", szMsg )
	else
		'환전가능 계좌 체크
		if g_szAcno <> "" and g_szAsno <> "" then
			Request_Tran_obtsd_fbnk_009r(g_szEvent_009r, "2", g_szAcno, g_szAsno, "", "")
		end if
	end if 
End Function

'==============================================
' 해외주식 미약정 계좌 체크
'==============================================
Function Check_Account(szYN, szMsg) 
	if szYN == "N" then
		'컨트롤 입력 불가
		g_isEnable_Total = false
		g_isEnable = false
'		'거래불가 계좌 안내팝업
'		Form.ShowAlert("알림", szMsg )
		Request_Tran_obacp_comm_008r()
	else
		if g_szEvent_009r <> "ONLY_ACCOUNT" then
			'컨트롤 입력 가능
			g_isEnable_Total = true
			g_isEnable = true
			'none
		end if
		
		Request_Tran_obacp_comm_008r_1()
	end if 
End Function


'==============================================
' 외화잔고 체크
'==============================================
Function Check_Balance(szYN, szMsg) 
	contMain.imgSwap.visible = true

	if szYN == "Y" then
		'컨트롤 입력 가능
		Swap_OrderType()
	else
		Form.ShowAlert("알림", szMsg )
	end if 
	
	g_isEnable = true
	
End Function

'==============================================
' 외화신청 체크
'==============================================
Function Check_Exchange(szYN, szMsg) 
	
	if szYN == "N" then
		Form.ShowAlert("알림", szMsg )
	else
		if g_szEvent_009r == "START_EXCHANGE" then
			g_szExStep = "Step0"
			
			szLinkData = ""
			
			szLinkData = g_szCrcd_Sell & "`"& contMain.lblSellAmt.caption
			szLinkData = szLinkData & "★" & g_szCrcd_Buy & "`"& contMain.lblBuyAmt.caption
			szLinkData = szLinkData & "★" & g_nExRate_1 & "`" & g_nExRate_2
			szLinkData = szLinkData & "★" & g_szSvcd_Sell & "`" & g_szSvcd_Buy
			
			Form.OpenPopup("nrsbbnk65000_p4" , szLinkData , "")
		end if
	end if 
	
	g_isEnable = true
	
End Function

'==============================================
' 환전신청
'==============================================
Function Request_Tran_obtsd_fbnk_202a()	
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_202a")
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "ACNO" 			, 0 , g_szAcno)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "ASNO" 			, 0 , g_szAsno)

	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "ACNT_PWD" 		, 0 , g_szPwd)
	
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "WNCR_AMT" 		, 0 , "0")
	
	if g_szCrcd_Sell == "KRW" then
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "SVCD"			, 0 , g_szSvcd_Buy) '서비스코드 (001:실시간 / 002:시간외)
		
		'외화매수
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "MNEC_CLCD"		, 0 , "1") '환전구분코드 (1:외화매수 / 2:외화매도)
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "FRCR_AMT" 		, 0 , replace(contMain.lblBuyAmt.caption, ",", "")) '환전외화금액
		
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "IQRY_EXRT"		, 0 , g_nExRate_1) '조회환율
		
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "CRCD"			, 0 , g_szCrcd_Buy) '통화코드
	elseif g_szCrcd_Buy == "KRW" then
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "SVCD"			, 0 , g_szSvcd_Sell) '서비스코드 (001:실시간 / 002:시간외)
		
		'외화매도
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "MNEC_CLCD"		, 0 , "2") '환전구분코드 (1:외화매수 / 2:외화매도)
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "FRCR_AMT" 		, 0 , replace(contMain.lblSellAmt.caption, ",", "")) '환전외화금액
		
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "IQRY_EXRT"		, 0 , g_nExRate_1) '조회환율
		
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "CRCD"			, 0 , g_szCrcd_Sell) '통화코드		
	end if
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "CONT_CLS_CODE"	, 0 , "4") '접촉구분코드 4 : 온라인
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "TRMD_CLS_CODE"	, 0 , "04") '거래매체구분코드 04 : 무매체
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_202a" , "InBlock1" , "MAX_MNEC_YN" 	, 0 , g_MaxMnecYN) 'v003 최대환전여부
	
	DATAMANAGER.RequestTranData("obtsd_fbnk_202a")
End Function

'==============================================
' 환전신청 처리
'==============================================
Function Process_Tran_obtsd_fbnk_202a()

	szCRCD	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_202a", "OutBlock1", "CRCD" 		, 0)		' 통화코드
	szTRAM	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_202a", "OutBlock1", "TR_AMT" 	, 0)		' 실제환전원화금액
	
	szFCRCD	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_202a", "OutBlock1", "UI_CRCD" 		, 0)	' 외화통화코드
	szFTRAM	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_202a", "OutBlock1", "FRCR_TR_AMT" 	, 0)	' 실제환전외화금액
	
	szEXRT	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_202a", "OutBlock1", "APLY_EXRT" 	, 0)	' 적용환율
	

	szLinkData = ""
	
	szLinkData = "Complete"
	
	szSellAmt = ""
	szBuyAmt = ""
	szSvcd = ""
	
	if g_szCrcd_Sell == "KRW" then
		szSvcd = g_szSvcd_Buy
		szSellAmt = FormatNumber(szTRAM, 0)
		
		if g_szCrcd_Buy == "JPY" then
			szBuyAmt = FormatNumber(szFTRAM, 0)
		else
			szBuyAmt = FormatNumber(szFTRAM, 2)
		end if
	elseif g_szCrcd_Buy == "KRW" then
		szSvcd = g_szSvcd_Sell
		szBuyAmt = FormatNumber(szTRAM, 0)
		
		if g_szCrcd_Sell == "JPY" then
			szSellAmt = FormatNumber(szFTRAM, 0)
		else
			szSellAmt = FormatNumber(szFTRAM, 2)
		end if
	end if
	
	szLinkData = szLinkData & "★" & g_szCrcd_Sell & "`"& szSellAmt
	szLinkData = szLinkData & "★" & g_szCrcd_Buy & "`"& szBuyAmt
	szLinkData = szLinkData & "★" & szEXRT
	
	szAcc = acntMain.caption
	
	if acntMain.itemcodetype ==  "136" & acntMain.itemcodetype ==  "137" & acntMain.itemcodetype ==  "140" & acntMain.itemcodetype ==  "100" & acntMain.itemcodetype ==  "200" then 
		szLinkData = szLinkData & "★" & "["&acntMain.proclsname&"] " & left(szAcc, 4) & "-" & mid(szAcc, 5, 4) & "-" & right(szAcc, 2) 
	else
		szLinkData = szLinkData & "★" & "["&acntMain.accproductshortname&"] " & left(szAcc, 4) & "-" & mid(szAcc, 5, 4) & "-" & right(szAcc, 2) 
	end if
	
	szLinkData = szLinkData & "★" & szSvcd
	szLinkData = szLinkData & "★" & g_szLinkScrNo & "`"& g_szLinkSubData 
	
	g_szLinkData_Exchange = szLinkData
	
	Form.OpenPopup("nrsbbnk65000_p5" , g_szLinkData_Exchange, "")
	
	g_szLinkData_Exchange = ""
					
	Request_Tran_obrtd_fcur_001r()
	
	g_szLinkScrNo = ""
	g_szLinkSubData = ""
	g_szLinkSubData2  = ""

End Function

'==============================================
' 환전신청 오류처리
'==============================================
Function Error_Tran_obtsd_fbnk_202a(szErrCd, szErrMsg, szSubMsg)
	szLinkData = ""
	
	szSvcd = ""
	
	if g_szCrcd_Sell == "KRW" then
		szSvcd = g_szSvcd_Buy
		
	elseif g_szCrcd_Buy == "KRW" then
		szSvcd = g_szSvcd_Sell
		
	end if
	
	szTemp = ""
	if szSubMsg == "" then
		szTemp = szErrMsg
	else
		szTemp = szErrMsg & "(" & szSubMsg & ")"
	end if
	
	szTotalErrMsg = "처리되지 않았습니다.\n" & szTemp
	
	szLinkData = "Error"
	szLinkData = szLinkData & "★" & g_szCrcd_Sell & "`"& contMain.lblSellAmt.caption
	szLinkData = szLinkData & "★" & g_szCrcd_Buy & "`"& contMain.lblBuyAmt.caption
	szLinkData = szLinkData & "★" & szErrCd & "`"& szTotalErrMsg
	szLinkData = szLinkData & "★" & szSvcd
	szLinkData = szLinkData & "★" & g_szLinkScrNo & "`"& g_szLinkSubData
	
	g_szLinkData_Exchange = szLinkData
	
	Form.OpenPopup("nrsbbnk65000_p5" , g_szLinkData_Exchange, "")
	
	g_szLinkData_Exchange = ""
					
	Request_Tran_obrtd_fcur_001r()
	
	g_szLinkScrNo = ""
	g_szLinkSubData = ""
	g_szLinkSubData2  = ""
End Function

'==============================================
' 이종통화 환전신청 
'==============================================
Function Request_Tran_obtsd_fbnk_321a()	
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_321a")
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a" , "InBlock1" , "ACNO" 			, 0 , g_szAcno)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a" , "InBlock1" , "ASNO" 			, 0 , g_szAsno)

	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a" , "InBlock1" , "ACNT_PWD" 		, 0 , g_szPwd)

	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a", "InBlock1", "MNEC_SELN_CRCD"	, 0 , g_szCrcd_Sell)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a", "InBlock1", "MNEC_BYOV_CRCD"	, 0 , g_szCrcd_Buy)
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a", "InBlock1", "FRCR_SELN_AMT"	, 0 , replace(contMain.lblSellAmt.caption, ",", ""))
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a", "InBlock1", "FRCR_BYOV_AMT"	, 0 , replace(contMain.lblBuyAmt.caption, ",", ""))
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a", "InBlock1", "UI_STND_TIME1"	, 0 , g_szExRate_Time1)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a", "InBlock1", "UI_STND_TIME2"	, 0 , g_szExRate_Time2)
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a", "InBlock1", "UI_STND_EXRT1"	, 0 , g_nExRate_1)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a", "InBlock1", "UI_STND_EXRT2"	, 0 , g_nExRate_2)
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a", "InBlock1", "SVCD1"			, 0 , g_szSvcd_Sell)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a", "InBlock1", "SVCD2"			, 0 , g_szSvcd_Buy)
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a", "InBlock1", "PRFT_APLY_CLCD"	, 0 , "")
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a", "InBlock1", "MAX_MNEC_YN"		, 0 , g_MaxMnecYN)
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a", "InBlock1", "CONT_CLS_CODE"		, 0 , "4")
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_321a", "InBlock1", "TRMD_CLS_CODE"		, 0 , "04")
	
	DATAMANAGER.RequestTranData("obtsd_fbnk_321a")
End Function

'==============================================
' 환전신청 처리
'==============================================
Function Process_Tran_obtsd_fbnk_321a()
	'==================================================================================================================
	szCRCD1	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock1", "CRCD" 		, 0)		' 통화코드
	szTRAM1	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock1", "TR_AMT" 	, 0)		' 실제환전원화금액
	
	szFCRCD1	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock1", "UI_CRCD" 	, 0)		' 외화통화코드
	szFTRAM1	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock1", "FRCR_TR_AMT" , 0)	' 실제환전외화금액
	
	szEXRT1	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock1", "APLY_EXRT" 	, 0)		' 적용환율
	
	'==================================================================================================================
	szCRCD2	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock2", "CRCD" 		, 0)		' 통화코드
	szTRAM2	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock2", "TR_AMT" 	, 0)		' 실제환전원화금액
	
	szFCRCD2	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock2", "UI_CRCD" 	, 0)		' 외화통화코드
	szFTRAM2 =	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock2", "FRCR_TR_AMT" , 0)	' 실제환전외화금액
	
	szEXRT2	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock2", "APLY_EXRT" 	, 0)		' 적용환율
	'==================================================================================================================
	
	szResultCd		=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock3", "PROS_RSLT_CODE" 	, 1)		' 에러코드
	szResultMsg	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock3", "RSPN_CNTT"	, 1)		' 에러메시지
	
	szLinkData = ""
	
	szLinkData = "CompleteCross"
	
	szSellAmt1 = ""
	szBuyAmt1 = ""
	
	szSellAmt2 = ""
	szBuyAmt2 = ""
	
	if g_szCrcd_Sell == "JPY" then
		szSellAmt1 = FormatNumber(szFTRAM1, 0)
	else
		szSellAmt1 = FormatNumber(szFTRAM1, 2)
	end if
	
	szBuyAmt1 = FormatNumber(szTRAM1, 0)
	
	szSellAmt2 = FormatNumber(szTRAM2, 0)
	
	if g_szCrcd_Buy == "JPY" then
		szBuyAmt2 = FormatNumber(szFTRAM2, 0)
	else
		szBuyAmt2 = FormatNumber(szFTRAM2, 2)
	end if
	
'	szLinkData = szLinkData & "★" & "USD" & "`"& "3,000.55"
'	szLinkData = szLinkData & "★" & "KRW" & "`"& "3,993,612"
'	szLinkData = szLinkData & "★" & "1330.96"
'	
'	szLinkData = szLinkData & "★" & "KRW" & "`"& "3,993,612"
'	szLinkData = szLinkData & "★" & "HKD" & "`"& "23,394.13"
'	szLinkData = szLinkData & "★" & "170.71"
	
	szLinkData = szLinkData & "★" & szCRCD1 & "`"& szSellAmt1
	szLinkData = szLinkData & "★" & szFCRCD1 & "`"& szBuyAmt1
	szLinkData = szLinkData & "★" & szEXRT1
	
	szLinkData = szLinkData & "★" & szFCRCD2 & "`"& szSellAmt2
	szLinkData = szLinkData & "★" & szCRCD2 & "`"& szBuyAmt2
	szLinkData = szLinkData & "★" & szEXRT2
	
	szAcc = acntMain.caption
	
	if acntMain.itemcodetype ==  "136" & acntMain.itemcodetype ==  "137" & acntMain.itemcodetype ==  "140" & acntMain.itemcodetype ==  "100" & acntMain.itemcodetype ==  "200" then 
		szLinkData = szLinkData & "★" & "["&acntMain.proclsname&"] " & left(szAcc, 4) & "-" & mid(szAcc, 5, 4) & "-" & right(szAcc, 2) 
	else
		szLinkData = szLinkData & "★" & "["&acntMain.accproductshortname&"] " & left(szAcc, 4) & "-" & mid(szAcc, 5, 4) & "-" & right(szAcc, 2) 
	end if

	if szResultCd == "03" then		
		szTotalErrMsg = "처리되지 않았습니다.\n" & szResultMsg
		
		szLinkData = szLinkData & "★" & szResultCd
		szLinkData = szLinkData & "★" & szTotalErrMsg
		szLinkData = szLinkData & "★" & g_szLinkScrNo & "`"& g_szLinkSubData 
	else
		szLinkData = szLinkData & "★" & g_szSvcd_Sell & "★" & g_szSvcd_Buy 
		szLinkData = szLinkData & "★" & g_szLinkScrNo & "`"& g_szLinkSubData 
	end if
	
	
	g_szLinkData_Exchange = szLinkData
	
	Form.OpenPopup("nrsbbnk65000_p5" , g_szLinkData_Exchange, "")
	
	g_szLinkData_Exchange = ""
					
	Request_Tran_obrtd_fcur_001r()
	
	g_szLinkScrNo = ""
	g_szLinkSubData = ""
	g_szLinkSubData2  = ""

End Function

'==============================================
' 환전신청 오류처리
'==============================================
Function Error_Tran_obtsd_fbnk_321a(szErrCd, szErrMsg, szSubMsg)
	
	'==================================================================================================================
	szCRCD1	=	g_szCrcd_Sell'DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock1", "CRCD" 		, 0)		' 통화코드
	szTRAM1	=	""'DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock1", "TR_AMT" 	, 0)		' 실제환전원화금액
	
	szFCRCD1	=	""'DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock1", "UI_CRCD" 	, 0)		' 외화통화코드
	szFTRAM1	=	replace(contMain.lblSellAmt.caption, ",", "")'DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock1", "FRCR_TR_AMT" , 0)	' 실제환전외화금액
	
	szEXRT1	=	""'DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock1", "APLY_EXRT" 	, 0)		' 적용환율
	
	'==================================================================================================================
	szCRCD2	=	g_szCrcd_Buy'DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock2", "CRCD" 		, 0)		' 통화코드
	szTRAM2	=	""'DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock2", "TR_AMT" 	, 0)		' 실제환전원화금액
	
	szFCRCD2	=	""'DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock2", "UI_CRCD" 	, 0)		' 외화통화코드
	szFTRAM2   =	replace(contMain.lblBuyAmt.caption, ",", "")'DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock2", "FRCR_TR_AMT" , 0)	' 실제환전외화금액
	
	szEXRT2	=	""'DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock2", "APLY_EXRT" 	, 0)		' 적용환율
	'==================================================================================================================
	szResultCd	=	DATAMANAGER.GetDataValue(false, "obtsd_fbnk_321a", "OutBlock3", "PROS_RSLT_CODE" 	, 1)		' 에러코드
	szResultCd	= "01"
	
	szLinkData = ""
	
	szLinkData = "ErrorCross"
	
	szSellAmt1 = ""
	szBuyAmt1 = ""
	
	szSellAmt2 = ""
	szBuyAmt2 = ""
	
	if g_szCrcd_Sell == "JPY" then
		szSellAmt1 = FormatNumber(szFTRAM1, 0)
	else
		szSellAmt1 = FormatNumber(szFTRAM1, 2)
	end if
	
	szBuyAmt1 = FormatNumber(szTRAM1, 0)
	
	szSellAmt2 = FormatNumber(szTRAM2, 0)
	
	if g_szCrcd_Buy == "JPY" then
		szBuyAmt2 = FormatNumber(szFTRAM2, 0)
	else
		szBuyAmt2 = FormatNumber(szFTRAM2, 2)
	end if
	
'	szLinkData = szLinkData & "★" & "USD" & "`"& "3,000.55"
'	szLinkData = szLinkData & "★" & "KRW" & "`"& "3,993,612"
'	szLinkData = szLinkData & "★" & "1330.96"
'	
'	szLinkData = szLinkData & "★" & "KRW" & "`"& "3,993,612"
'	szLinkData = szLinkData & "★" & "HKD" & "`"& "23,394.13"
'	szLinkData = szLinkData & "★" & "170.71"
	
	szLinkData = szLinkData & "★" & szCRCD1 & "`"& szSellAmt1
	szLinkData = szLinkData & "★" & szFCRCD1 & "`"& szBuyAmt1
	szLinkData = szLinkData & "★" & szEXRT1
	
	szLinkData = szLinkData & "★" & szFCRCD2 & "`"& szSellAmt2
	szLinkData = szLinkData & "★" & szCRCD2 & "`"& szBuyAmt2
	szLinkData = szLinkData & "★" & szEXRT2
	
	
	szAcc = acntMain.caption
	
	szTemp = ""
	if szSubMsg == "" then
		szTemp = szErrMsg
	else
		szTemp = szErrMsg & "(" & szSubMsg & ")"
	end if
	
	szTotalErrMsg = "처리되지 않았습니다.\n" & szTemp
	
	if acntMain.itemcodetype ==  "136" & acntMain.itemcodetype ==  "137" & acntMain.itemcodetype ==  "140" & acntMain.itemcodetype ==  "100" & acntMain.itemcodetype ==  "200" then 
		szLinkData = szLinkData & "★" & "["&acntMain.proclsname&"] " & left(szAcc, 4) & "-" & mid(szAcc, 5, 4) & "-" & right(szAcc, 2) 
	else
		szLinkData = szLinkData & "★" & "["&acntMain.accproductshortname&"] " & left(szAcc, 4) & "-" & mid(szAcc, 5, 4) & "-" & right(szAcc, 2) 
	end if
	
	szLinkData = szLinkData & "★" & szResultCd 'g_szSvcd
	szLinkData = szLinkData & "★" & szErrCd & "`"& szTotalErrMsg
	szLinkData = szLinkData & "★" & g_szLinkScrNo & "`"& g_szLinkSubData 
	
	g_szLinkData_Exchange = szLinkData

	Form.OpenPopup("nrsbbnk65000_p5" , g_szLinkData_Exchange, "")
	
	g_szLinkData_Exchange = ""
					
	Request_Tran_obrtd_fcur_001r()
	
	g_szLinkScrNo = ""
	g_szLinkSubData = ""
	g_szLinkSubData2  = ""
End Function


'==============================================
' 이종통화 환전신청(베트남) 
'==============================================
Function Request_Tran_obtsd_fbnk_301a()	
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_301a")
	
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_301a" , "InBlock1" , "ACNO" 			, 0 , g_szAcno)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_301a" , "InBlock1" , "ASNO" 			, 0 , g_szAsno)

	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_301a" , "InBlock1" , "ACNT_PWD" 		, 0 , g_szPwd)
	
	DATAMANAGER.SetDataValue(false , "obtsd_fbnk_301a" , "InBlock1" , "CONT_CLS_CODE"     , 0 , "4"  )   '온라인
	DATAMANAGER.SetDataValue(false , "obtsd_fbnk_301a" , "InBlock1" , "PROS_CLS_CODE"     , 0 , "1"  )   '신청

	DATAMANAGER.SetDataValue(false , "obtsd_fbnk_301a" , "InBlock1" , "MNEC_TRGT_CRCD"    , 0 , "VND")   '환전대상통화
	DATAMANAGER.SetDataValue(false , "obtsd_fbnk_301a" , "InBlock1" , "FRCR_SELN_APLT_AMT", 0 , replace(contMain.lblSellAmt.caption, ",", "")) '환전신청금액
	
	If g_szCrcd_Buy == "VND" Then '이종통화매수
		DATAMANAGER.SetDataValue(false , "obtsd_fbnk_301a" , "InBlock1" , "MNEC_CLCD"      , 0 , "4"  ) '환전구분 : 이종통화매수
		DATAMANAGER.SetDataValue(false , "obtsd_fbnk_301a" , "InBlock1" , "MNEC_BYOV_CRCD" , 0 , "VND") '매수통화
		DATAMANAGER.SetDataValue(false , "obtsd_fbnk_301a" , "InBlock1" , "MNEC_SELN_CRCD" , 0 , "USD") '매도통화		
	ElseIf g_szCrcd_Sell == "VND" Then '이종통화매도
		DATAMANAGER.SetDataValue(false , "obtsd_fbnk_301a" , "InBlock1" , "MNEC_CLCD"      , 0 , "5"  ) '환전구분 : 이종통화매도
		DATAMANAGER.SetDataValue(false , "obtsd_fbnk_301a" , "InBlock1" , "MNEC_BYOV_CRCD" , 0 , "USD") '매수통화
		DATAMANAGER.SetDataValue(false , "obtsd_fbnk_301a" , "InBlock1" , "MNEC_SELN_CRCD" , 0 , "VND") '매도통화
	Else
		Form.MsgBox("알림" , "환전구분을 선택해주십시오." , "", 6)
		Exit Function
	End If
	
	DATAMANAGER.RequestTranData("obtsd_fbnk_301a")
End Function

'==============================================
' 환전신청 처리
'==============================================
Function Process_Tran_obtsd_fbnk_301a()
	szLinkData = "Complete"
	szLinkData = szLinkData & "★" & g_szCrcd_Sell & "`"& contMain.lblSellAmt.caption
	szLinkData = szLinkData & "★" & g_szCrcd_Buy & "`"& "현지 환전 후 확정"
	szLinkData = szLinkData & "★" & "미정"
	
	szAcc = acntMain.caption
	
	if acntMain.itemcodetype ==  "136" & acntMain.itemcodetype ==  "137" & acntMain.itemcodetype ==  "140" & acntMain.itemcodetype ==  "100" & acntMain.itemcodetype ==  "200" then 
		szLinkData = szLinkData & "★" & "["&acntMain.proclsname&"] " & left(szAcc, 4) & "-" & mid(szAcc, 5, 4) & "-" & right(szAcc, 2) 
	else
		szLinkData = szLinkData & "★" & "["&acntMain.accproductshortname&"] " & left(szAcc, 4) & "-" & mid(szAcc, 5, 4) & "-" & right(szAcc, 2) 
	end if
	
	szLinkData = szLinkData & "★" & "VND"
	szLinkData = szLinkData & "★" & g_szLinkScrNo & "`"& g_szLinkSubData 
	
	g_szLinkData_Exchange = szLinkData
	
	Form.OpenPopup("nrsbbnk65000_p5" , g_szLinkData_Exchange, "")
	
	g_szLinkData_Exchange = ""
					
	Request_Tran_obrtd_fcur_001r()
	
	g_szLinkScrNo = ""
	g_szLinkSubData = ""
	g_szLinkSubData2  = ""

End Function

