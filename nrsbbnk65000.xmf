		Exit Sub
	end if
	
	g_szCrcdGbn = "0"
	Form.OpenPopupAnimation("nrsbbnk65000_p2" , "0`"&g_szAcno&"`"&g_szAsno&"`"&g_szPwd&"`"&g_szSvcd_Buy&"`"&g_szCtcd , "", "2")
End Sub

