'==============================================
' 환전가능금액 조회 처리
'==============================================
Function Process_Tran_obrtd_fcur_001r()
	nDataCnt = DATAMANAGER.GetDataCount(false, "obrtd_fcur_001r", "OutBlock1")
	
	'최대환전 여부
	g_MaxMnecYN = DATAMANAGER.GetDataValue(false, "obrtd_fcur_001r" , "OutBlock3" , "MAX_MNEC_YN" , 0) 
	
	for i = 0 to nDataCnt-1 
		szCrcd         = DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "CRCD", i )
		szAbleAmt    = DATAMANAGER.GetDataValue(0, "obrtd_fcur_001r", "OutBlock1", "ATMT_INVT_VLTN_ADUP_FRCR_AMT", i ) 
		
		if g_szCrcd_Sell == szCrcd then
			
			contMain.lblAbleAmt.caption = "환전가능 " & Convert_FormatNumber(szCrcd, szAbleAmt)
			Exit For
		end if
	next
End Function

'==============================================
' 환전금액 가계산
'==============================================
' 외화 -> 원화
Function Request_Tran_obtsd_fbnk_008r(szClsCd, szOrdGbn, szAmtGbn, szAmt)	
	g_szClsCd_008r	= szClsCd
	g_szOrdGbn_008r	= szOrdGbn
	g_szAmtGbn_008r	= szAmtGbn
	DATAMANAGER.ClearInputData(false, "obtsd_fbnk_008r")
	
	'조회구분코드 (1:일반, 2:이종통화)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "IQRY_CLS_CODE"		, 0 , szClsCd)
	
	'매수/매도 통화코드
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "BYOV_CRCD"			, 0 , g_szCrcd_Buy)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "SELN_CRCD"			, 0 , g_szCrcd_Sell)
	
	'기관코드(287 고정)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "TACT_LNKD_ISTU_CODE"	, 0 , "287")
	
	'거래금액구분코드(1:외화, 2:원화)
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "TR_AMT_CLCD"			, 0 , szAmtGbn)
	
	'일반
	if szClsCd == "1" then
		'매수/매도 구분
		if szOrdGbn == "1" then
			'서비스코드(001:실시간 002:시간외)
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "SVCD"				, 0 , g_szSvcd_Buy)
				
			if szAmtGbn == "2" then
				'원화거래금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "WNCR_TR_AMT"			, 0 , szAmt)
			elseif szAmtGbn == "1" then
				'외화매수금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "FRCR_BYOV_AMT"		, 0 , szAmt)
			end if
			
			'환전매수환율
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_BYOV_EXRT"		, 0 , g_nExRate_1)
			'환전매수스프레드
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_BYOV_SPEAD"		, 0 , g_szExRate_Spread1)
			
		elseif szOrdGbn == "2" then
			'서비스코드(001:실시간 002:시간외)
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "SVCD"				, 0 , g_szSvcd_Sell)
				
			if szAmtGbn == "2" then
				'원화거래금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "WNCR_TR_AMT"			, 0 , szAmt)
			elseif szAmtGbn == "1" then
				'외화매도금액
				DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "FRCR_SELN_AMT"		, 0 , szAmt)
			end if
			
			'환전매도환율
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_SELN_EXRT"		, 0 , g_nExRate_1)
			'환전매도스프레드
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_SELN_SPEAD"		, 0 , g_szExRate_Spread1)
		end if
	
	'이종통화
	elseif szClsCd == "2" or szClsCd == "3"  then
		'매수/매도 구분
		if szOrdGbn == "1" then
			'외화매수금액
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "FRCR_BYOV_AMT"		, 0 , szAmt)
		elseif szOrdGbn == "2" then
			'외화매도금액
			DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "FRCR_SELN_AMT"		, 0 , szAmt)
		end if
		
		'환전매도환율
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_SELN_EXRT"		, 0 , g_nExRate_1)
		'환전매도스프레드
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_SELN_SPEAD"		, 0 , g_szExRate_Spread1)
		
		'환전매수환율
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_BYOV_EXRT"		, 0 , g_nExRate_2)
		'환전매수스프레드
		DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_BYOV_SPEAD"		, 0 , g_szExRate_Spread2)
	end if
	
	'환율기준시각
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "EXRT_STND_TIME"		, 0 , g_szExRate_Time1)
	
	'---------------------------------------------------
	'환전구분코드(1:매수, 2:매도)
	'환전구분코드는 거래 간 원화 포함시 영향있음
	'1. 원화 -> 외화 (매수)
	'2. 외화 -> 원화 (매도)
	'3. 외화 -> 외화의 경우 이종통화 처리로 서비스 내부적으로 매수/매도 처리 알아서 처리함
	'---------------------------------------------------
	DATAMANAGER.SetDataValue(false, "obtsd_fbnk_008r", "InBlock1", "MNEC_CLCD"			, 0 , szOrdGbn)

	DATAMANAGER.RequestTranData("obtsd_fbnk_008r")
End Function

'외화입력(매수/매도)
Function Process_Tran_obtsd_fbnk_008r()
	szWonAmt = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_008r", "OutBlock1", "WNCR_TR_AMT", 0)
	szForSelAmt = DATAMANAGER.GetDataValue(false,"obtsd_fbnk_008r", "OutBlock1", "FRCR_SELN_AMT" , 0)
	szForBuyAmt = DATAMANAGER.GetDataValue(false, "obtsd_fbnk_008r", "OutBlock1", "FRCR_BYOV_AMT", 0)
	
	'Form.ShowAlert("TEST", szWonAmt .. "|" .. szForSelAmt .. "|" .. szForBuyAmt)
	
	'일반
	if g_szClsCd_008r == "1" then
	
		if g_szCrcd_Sell == "KRW" then
			szResult = Convert_FormatNumber(g_szCrcd_Sell, szWonAmt)
			
			contMain.lblSellAmt.fgcolor = g_szTxtColor_Normal
			contMain.lblSellAmt.caption = szResult
			
			szResult = Convert_FormatNumber(g_szCrcd_Buy, szForBuyAmt)
			
			contMain.lblBuyAmt.fgcolor = g_szTxtColor_Normal
			contMain.lblBuyAmt.caption = szResult
		elseif g_szCrcd_Buy == "KRW" then
			szResult = Convert_FormatNumber(g_szCrcd_Sell, szForSelAmt)
			
			contMain.lblSellAmt.fgcolor = g_szTxtColor_Normal
			contMain.lblSellAmt.caption = szResult
			
			szResult = Convert_FormatNumber(g_szCrcd_Buy, szWonAmt)
			
			contMain.lblBuyAmt.fgcolor = g_szTxtColor_Normal
			contMain.lblBuyAmt.caption = szResult
		end if
	
	'이종통화
	elseif g_szClsCd_008r == "2" or g_szClsCd_008r == "3" then
		szResult = Convert_FormatNumber(g_szCrcd_Sell, szForSelAmt)
			
		contMain.lblSellAmt.fgcolor = g_szTxtColor_Normal
		contMain.lblSellAmt.caption = szResult
		
		szResult = Convert_FormatNumber(g_szCrcd_Buy, szForBuyAmt)
		
		contMain.lblBuyAmt.fgcolor = g_szTxtColor_Normal
		contMain.lblBuyAmt.caption = szResult
	end if
	
	btnOk.enable = false
	btnOk.btnimage = "btn_09.9"
	btnOk.fgcolor = g_szTxtColor_Grey

		
	if contMain.lblSellAmt.caption <> "" and contMain.lblSellAmt.caption <> "매도금액입력" and contMain.lblBuyAmt.caption <> "" and contMain.lblBuyAmt.caption <> "매수금액입력" then
		if  cdbl(replace(contMain.lblSellAmt.caption, ",", "")) > 0  and  cdbl(replace(contMain.lblBuyAmt.caption, ",", "")) > 0 then
			
			isSellChk = true
			if Cdbl(replace(contMain.lblSellAmt.caption, ",", "")) > g_nLimit_Sell and g_szCrcd_Sell <> "KRW" then
				isSellChk = false
			end if
			
			isBuyChk = true
			if Cdbl(replace(contMain.lblBuyAmt.caption, ",", "")) > g_nLimit_Buy and g_szCrcd_Buy <> "KRW" then
				isBuyChk = false
			end if
			
			if isSellChk == false or isBuyChk == false then
				if isSellChk == false and isBuyChk == false then
					szData1 = "1회 환전 한도 " & FormatNumber(g_nLimit_Sell,0) & " " & g_szCrcd_Sell
					szData2 = "1회 환전 한도 " & FormatNumber(g_nLimit_Buy,0) & " " & g_szCrcd_Buy
					
					Form.ShowAlert("알림", "입력하신 금액이 환전 한도를 초과합니다.\n확인 후 다시 입력해주세요.\n\n" & szData1 & "\n" & szData2)
				elseif isSellChk == false then
					szData1 = "1회 환전 한도 " & FormatNumber(g_nLimit_Sell,0) & " " & g_szCrcd_Sell
					Form.ShowAlert("알림", "입력하신 금액이 환전 한도를 초과합니다.\n확인 후 다시 입력해주세요.\n\n" & szData1)
				elseif isBuyChk == false then
					szData2 = "1회 환전 한도 " & FormatNumber(g_nLimit_Buy,0)  & " " & g_szCrcd_Buy
					Form.ShowAlert("알림", "입력하신 금액이 환전 한도를 초과합니다.\n확인 후 다시 입력해주세요.\n\n" & szData2)
				end if
				
				btnOk.enable = false
				btnOk.btnimage = "btn_09.9"
				btnOk.fgcolor = g_szTxtColor_Grey
			else
			
				btnOk.enable = true
				btnOk.btnimage = "btn_20.9"
				btnOk.fgcolor = g_szTxtColor_White
			end if
		end if
		
	else
		btnOk.enable = false
		btnOk.btnimage = "btn_09.9"
		btnOk.fgcolor = g_szTxtColor_Grey
	end if
	
	
End Function

'==============================================
' 1회 환전한도 조회
'==============================================
'매도통화
Function Request_Tran_obrtp_comn_035r()
	g_nLimit_Sell = 0
	
	if g_szCrcd_Sell = "KRW" or g_szCrcd_Sell = "VND" then
		Exit Function
	end if
	
	DATAMANAGER.SetDataValue(0, "obrtp_comn_035r", "InBlock1", "BASC_CODE" , 0 , "EXCAP")
	
	if g_szCrcd_Sell = "USD" Or g_szCrcd_Sell = "CNY" Or g_szCrcd_Sell = "CNH" Or g_szCrcd_Sell = "HKD" Or g_szCrcd_Sell = "JPY"  Or g_szCrcd_Sell = "CHF" then
	    DATAMANAGER.SetDataValue(0, "obrtp_comn_035r", "InBlock1", "DTL_CODE"  , 0 , g_szCrcd_Sell)
	else
	    DATAMANAGER.SetDataValue(0, "obrtp_comn_035r", "InBlock1", "DTL_CODE"  , 0 , "ETC")
	end if

	DATAMANAGER.RequestTranData("obrtp_comn_035r")
End Function

'매수통화
Function Request_Tran_obrtp_comn_035r_1()
	g_nLimit_Buy = 0
	
	if g_szCrcd_Buy = "KRW" or g_szCrcd_Buy = "VND" then
		Exit Function
	end if
	
	DATAMANAGER.SetDataValue(0, "obrtp_comn_035r_1", "InBlock1", "BASC_CODE" , 0 , "EXCAP")
	
	if g_szCrcd_Buy = "USD" Or g_szCrcd_Buy = "CNY" Or g_szCrcd_Buy = "CNH" Or g_szCrcd_Buy = "HKD" Or g_szCrcd_Buy = "JPY"  Or g_szCrcd_Buy = "CHF" then
	    DATAMANAGER.SetDataValue(0, "obrtp_comn_035r_1", "InBlock1", "DTL_CODE"  , 0 , g_szCrcd_Buy)
	else
	    DATAMANAGER.SetDataValue(0, "obrtp_comn_035r_1", "InBlock1", "DTL_CODE"  , 0 , "ETC")
	end if

	DATAMANAGER.RequestTranData("obrtp_comn_035r_1")
End Function

Function Process_Tran_obrtp_comn_035r()
	szData = DATAMANAGER.GetDataValue(false, "obrtp_comn_035r", "OutBlock1", "DTL_ASST_CODE", 0)
	
	if szData <> "" then
		g_nLimit_Sell = Cdbl(szData)
	end if
End Function

Function Process_Tran_obrtp_comn_035r_1()
	szData = DATAMANAGER.GetDataValue(false, "obrtp_comn_035r_1", "OutBlock1", "DTL_ASST_CODE", 0)
	
	if szData <> "" then
		g_nLimit_Buy = Cdbl(szData)
	end if
End Function

'==============================================
' 통화코드 변경 
'==============================================
Function Select_Crcd(szGbn, szCrcd, szCrcd2)
	szFlag = Form.getIconImg("CRCD", szCrcd)
	if szFlag = "" then
		szFlag = "flag_general"
	end if
	
	g_szLastSelGbn = szGbn
		
	'Form.ShowAlert("TEST", szGbn .. "|" .. szCrcd .. "|" .. szCrcd2)
	'매도통화 선택
	if szGbn == "0" then
		contMain.imgFlag00.imgpath = szFlag
		contMain.lblCrcd00.caption = szCrcd
		g_szCrcd_Sell = szCrcd
		
		Request_Tran_obrtd_fcur_001r()
		
		'------------------------------------------------------------------
		'베트남 통화 선택한 경우
		if g_szCrcd_Sell == "VND" then
			g_szCrcd_Buy = "USD"
			
			szFlag_Auto = Form.getIconImg("CRCD", g_szCrcd_Buy)
			if szFlag_Auto = "" then
				szFlag_Auto = "flag_general"
			end if
			
			contMain.imgFlag01.imgpath = szFlag_Auto
			contMain.lblCrcd01.caption = g_szCrcd_Buy
	
		elseif g_szCrcd_Buy == "VND" and g_szCrcd_Sell <> "USD" then
			
			if g_szCrcd_Sell == "KRW" then
				g_szCrcd_Buy = "USD"
			else
				g_szCrcd_Buy = "KRW"
			end if
				
			
			szFlag_Auto = Form.getIconImg("CRCD", g_szCrcd_Buy)
			if szFlag_Auto = "" then
				szFlag_Auto = "flag_general"
			end if
			
			contMain.imgFlag01.imgpath = szFlag_Auto
			contMain.lblCrcd01.caption = g_szCrcd_Buy
			
		elseif g_szCrcd_Sell == "USD" and g_szSvcd_Buy == "002" then
			g_szCrcd_Buy = "KRW"
			
			szFlag_Auto = Form.getIconImg("CRCD", g_szCrcd_Buy)
			if szFlag_Auto = "" then
				szFlag_Auto = "flag_general"
			end if
			
			contMain.imgFlag01.imgpath = szFlag_Auto
			contMain.lblCrcd01.caption = g_szCrcd_Buy
			
		'변경된 보유통화 코드가 환전통화코드와 동일한 경우
		elseif g_szCrcd_Sell == g_szCrcd_Buy then
			
			if g_szCrcd_Sell == "KRW" then
				'보유통화 원화 선택 시, 환전(매수)통화 미국달러 자동변경
'				g_szCrcd_Buy = "USD"
				if g_szCtcd <> "" then
					g_szCrcd_Buy = g_szCtcd
				else
					g_szCrcd_Buy = "USD"
				end if
			else
				'보유통화 외화 선택 시, 환전(매수)통화 원화 자동변경
				g_szCrcd_Buy = "KRW" 
			end if
			
			szFlag_Auto = Form.getIconImg("CRCD", g_szCrcd_Buy)
			if szFlag_Auto = "" then
				szFlag_Auto = "flag_general"
			end if
			
			contMain.imgFlag01.imgpath = szFlag_Auto
			contMain.lblCrcd01.caption = g_szCrcd_Buy
		end if
		'------------------------------------------------------------------
	'매수통화 선택	
	elseif szGbn == "1" then
		
		contMain.imgFlag01.imgpath = szFlag
		contMain.lblCrcd01.caption = szCrcd
		szPrevCrcd = g_szCrcd_Buy
		g_szCrcd_Buy = szCrcd
			
		'------------------------------------------------------------------
		'베트남 통화 선택한 경우
		if g_szCrcd_Buy == "VND" then
			g_szCrcd_Sell = "USD"
		
			szFlag_Auto = Form.getIconImg("CRCD", g_szCrcd_Sell)
			if szFlag_Auto = "" then
				szFlag_Auto = "flag_general"
			end if
		
			contMain.imgFlag00.imgpath = szFlag_Auto
			contMain.lblCrcd00.caption = g_szCrcd_Sell
			Request_Tran_obrtd_fcur_001r()
			
		elseif g_szCrcd_Sell == "VND" and g_szCrcd_Buy <> "USD" then
			if g_szCrcd_Buy == "KRW" then
				g_szCrcd_Sell = "USD"
			else
				g_szCrcd_Sell = "KRW"
			end if
		
			szFlag_Auto = Form.getIconImg("CRCD", g_szCrcd_Sell)
			if szFlag_Auto = "" then
				szFlag_Auto = "flag_general"
			end if
		
			contMain.imgFlag00.imgpath = szFlag_Auto
			contMain.lblCrcd00.caption = g_szCrcd_Sell
			Request_Tran_obrtd_fcur_001r()
			
		'변경된 보유통화 코드가 환전통화코드와 동일한 경우
		elseif g_szCrcd_Sell == g_szCrcd_Buy then

			if g_szSvcd_Buy == "002" then
				szFlag = Form.getIconImg("CRCD", szPrevCrcd)
				contMain.imgFlag01.imgpath = szFlag
				contMain.lblCrcd01.caption = szPrevCrcd
				g_szCrcd_Buy = szPrevCrcd
				
			else
				if g_szCrcd_Buy == "KRW" then
					if g_szCtcd <> "" then
						g_szCrcd_Sell = g_szCtcd
					else
						g_szCrcd_Sell = "USD"
					end if
				else
					g_szCrcd_Sell = "KRW"
				end if
			end if
			
			szFlag_Auto = Form.getIconImg("CRCD", g_szCrcd_Sell)
			if szFlag_Auto = "" then
				szFlag_Auto = "flag_general"
			end if
		
			contMain.imgFlag00.imgpath = szFlag_Auto
			contMain.lblCrcd00.caption = g_szCrcd_Sell
			'Form.ShowAlert("안내", "보유통화와 동일한 통화를 선택할 수 없습니다.")
			Request_Tran_obrtd_fcur_001r()
		end if
		
	elseif szGbn == "2" then
		contMain.imgFlag00.imgpath = szFlag
		contMain.lblCrcd00.caption = szCrcd
		g_szCrcd_Sell = szCrcd
		
		szFlag2 = Form.getIconImg("CRCD", szCrcd2)
		if szFlag2 = "" then
			szFlag2 = "flag_general"
		end if
			
		contMain.imgFlag01.imgpath = szFlag2
		contMain.lblCrcd01.caption = szCrcd2
		g_szCrcd_Buy = szCrcd2
		
		Request_Tran_obrtd_fcur_001r()
	end if
	
	nTxtWidth = Form.getTextWidth(contMain.lblCrcd00.caption, "0", true, false)
	nImgLeft = 60 + nTxtWidth + 5
	contMain.imgArrow00.left = nImgLeft
	
	nTxtWidth = Form.getTextWidth(contMain.lblCrcd01.caption, "0", true, false)
	nImgLeft = 60 + nTxtWidth + 5
	contMain.imgArrow01.left = nImgLeft
	
'	contMain.lblExchange00.left = 190
	'환전(매수/매도)
	
	if g_szCrcd_Sell == "KRW" or g_szCrcd_Buy == "KRW" then
		contMain.contInfo.visible = true
		contMain.contInfoVND.visible = false
	
		'2열 환율정보 보임처리
		contMain.lblExchangeInfo10.visible = false
		contMain.lblExchangeInfo11.visible = false
		contMain.lblExchange10.visible = false
'		contMain.imgRe1.visible = false
		
		'1열 우대율 보임처리(환율정보 조회 이후 다시 표시)
		contMain.lblExchangeInfo01.visible = false
		contMain.imgRe0.visible = true
		
		'데이터 초기화
