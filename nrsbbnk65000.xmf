'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
	btnOk.btnimage = "btn_09.9"
	
	
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	Init_Control()
	
	Dim szLinkData
	szLinkData = Form.GetOpenLinkData( )
	
	arrLinkData = split(szLinkData, "`")

	if #arrLinkData > 1 then
		if arrLinkData(0) == "매수통화" then
			g_szLinkSubData2 = replace(szLinkData, "매수통화", "환전완료")
			Form.setSharedData("65000_LINK_SUB_DATA", g_szLinkSubData2)
			g_szLinkCrcd = arrLinkData(1)
			
			if #arrLinkData > 2 then
				g_szLinkScrNo = arrLinkData(2)
			end if 
			
			if #arrLinkData > 3 then
				g_szLinkSubData = arrLinkData(3)
			end if  
			
			if g_szLinkScrNo == "16090" and g_szLinkSubData <> "" then
				szIndex = acntMain.GetIndexByAccountInfo(replace(g_szLinkSubData, "-", ""))
				acntMain.currentindex = szIndex
				
				g_szAcno = acntMain.total
				g_szAsno = acntMain.sequence
	
				'acntMain_ChangeAccount()
			end if
		end if
	end if
	
	Form.SetTimerEvent2(1, 1, 0.5)
End Sub

