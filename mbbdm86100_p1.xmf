'============================================================================
Function f_ChangeContPos(szTarget)
'	If szTarget == "H" Then
'		Exit Function
'	End If
	
	'펼쳐지는 항목의 아래에 위치한 컨트롤들을 전부 내려줌
	Dim tTargetO, tTargetA, tTargetB, tTargetC, tTargetD, tTargetE, tTargetF, tTargetG, tTargetH
	tTargetO = {"contMain.contA", "contMain.contB", "contMain.contC", "contMain.contD", "contMain.contE", "contMain.contF", "contMain.contG", "contMain.contH"}
	tTargetA = {"contMain.contB", "contMain.contC", "contMain.contD", "contMain.contE", "contMain.contF", "contMain.contG", "contMain.contH"}
	tTargetB = {"contMain.contC", "contMain.contD", "contMain.contE", "contMain.contF", "contMain.contG", "contMain.contH"}
	tTargetC = {"contMain.contD", "contMain.contE", "contMain.contF", "contMain.contG", "contMain.contH"}
	tTargetD = {"contMain.contE", "contMain.contF", "contMain.contG", "contMain.contH"}
	tTargetE = {"contMain.contF", "contMain.contG", "contMain.contH"}
	tTargetF = {"contMain.contG", "contMain.contH"}
	tTargetG = {"contMain.contH"}
	
	Dim nHeight		'각 컨테이너에 적용할 높이
	If szTarget == "O" Then
		If g_bExpand Then
			For i = 0 to #tTargetO - 1 
				nHeight = Form.GetCtlProp(tTargetO[i], "top") + g_addTop
				nHeight = CInt(nHeight) + 300	''125 '170
				Form.SetCtlProp(tTargetO[i], "top", nHeight)
			Next
		Else
			For i = 0 to #tTargetO - 1 
				nHeight = Form.GetCtlProp(tTargetO[i], "top")
				nHeight = CInt(nHeight) - 300	''125 '170
				Form.SetCtlProp(tTargetO[i], "top", nHeight)
			Next
		End If
	ElseIf szTarget == "A" Then
		If g_bExpand Then
			For i = 0 to #tTargetA - 1 
				nHeight = Form.GetCtlProp(tTargetA[i], "top") + g_addTop
				nHeight = CInt(nHeight) + 170 '170 '125
				Form.SetCtlProp(tTargetA[i], "top", nHeight)
			Next
		Else
			For i = 0 to #tTargetA - 1 
				nHeight = Form.GetCtlProp(tTargetA[i], "top")
				nHeight = CInt(nHeight) - 170 '170 '125
				Form.SetCtlProp(tTargetA[i], "top", nHeight)
			Next
		End If
	ElseIf szTarget == "B" Then
		If g_bExpand Then
			For i = 0 to #tTargetB - 1 
				nHeight = Form.GetCtlProp(tTargetB[i], "top") + g_addTop
				nHeight = CInt(nHeight) + 165
				Form.SetCtlProp(tTargetB[i], "top", nHeight)
			Next
		Else
			For i = 0 to #tTargetB - 1 
				nHeight = Form.GetCtlProp(tTargetB[i], "top")
				nHeight = CInt(nHeight) - 165
				Form.SetCtlProp(tTargetB[i], "top", nHeight)
			Next
		End If
	ElseIf szTarget == "C" Then
		If g_bExpand Then
			For i = 0 to #tTargetC - 1 
				nHeight = Form.GetCtlProp(tTargetC[i], "top") + g_addTop
				nHeight = CInt(nHeight) + 425
				Form.SetCtlProp(tTargetC[i], "top", nHeight)
			Next
		Else
			For i = 0 to #tTargetC - 1 
				nHeight = Form.GetCtlProp(tTargetC[i], "top")
				nHeight = CInt(nHeight) - 425
				Form.SetCtlProp(tTargetC[i], "top", nHeight)
			Next
		End If
		
	ElseIf szTarget == "D" Then
		If g_bExpand Then
			For i = 0 to #tTargetD - 1 
				nHeight = Form.GetCtlProp(tTargetD[i], "top") + g_addTop
				nHeight = CInt(nHeight) + 385
				Form.SetCtlProp(tTargetD[i], "top", nHeight)
			Next
		Else
			For i = 0 to #tTargetD - 1 
				nHeight = Form.GetCtlProp(tTargetD[i], "top")
				nHeight = CInt(nHeight) - 385
				Form.SetCtlProp(tTargetD[i], "top", nHeight)
			Next
		End If
	ElseIf szTarget == "E" Then
		If g_bExpand Then
			For i = 0 to #tTargetE - 1 
				nHeight = Form.GetCtlProp(tTargetE[i], "top") + g_addTop
				nHeight = CInt(nHeight) + 135
				Form.SetCtlProp(tTargetE[i], "top", nHeight)
			Next
		Else
			For i = 0 to #tTargetE - 1 
				nHeight = Form.GetCtlProp(tTargetE[i], "top")
				nHeight = CInt(nHeight) - 135
				Form.SetCtlProp(tTargetE[i], "top", nHeight)
			Next
		End If
	ElseIf szTarget == "F" Then
		If g_bExpand Then
			For i = 0 to #tTargetF - 1 
				nHeight = Form.GetCtlProp(tTargetF[i], "top") + g_addTop
				nHeight = CInt(nHeight) + 135
				Form.SetCtlProp(tTargetF[i], "top", nHeight)
			Next
		Else
			For i = 0 to #tTargetF - 1 
				nHeight = Form.GetCtlProp(tTargetF[i], "top")
				nHeight = CInt(nHeight) - 135
				Form.SetCtlProp(tTargetF[i], "top", nHeight)
			Next
		End If
	ElseIf szTarget == "G" Then
		If g_bExpand Then
			For i = 0 to #tTargetG - 1 
				nHeight = Form.GetCtlProp(tTargetG[i], "top") + g_addTop
				nHeight = CInt(nHeight) + 160
				Form.SetCtlProp(tTargetG[i], "top", nHeight)
			Next
		Else
			For i = 0 to #tTargetG - 1 
				nHeight = Form.GetCtlProp(tTargetG[i], "top")
				nHeight = CInt(nHeight) - 160
				Form.SetCtlProp(tTargetG[i], "top", nHeight)
			Next
		End If
	ElseIf szTarget == "H" Then
		'맨 아래 펼침은 처리할 내용 없음
	End If
	
	contMain.SetScrollAutoSize()
End Function

'============================================================================
Function f_ResetContPos()
	'모든 컨테이너 위치 초기화
	g_bExpand = false
	
	contMain.contO.imgArrow.imgpath = "icon_arrow_d"
	contMain.contA.imgArrow.imgpath = "icon_arrow_d"
	contMain.contB.imgArrow.imgpath = "icon_arrow_d"
	contMain.contC.imgArrow.imgpath = "icon_arrow_d"
	contMain.contD.imgArrow.imgpath = "icon_arrow_d"
	contMain.contE.imgArrow.imgpath = "icon_arrow_d"
	contMain.contF.imgArrow.imgpath = "icon_arrow_d"
	contMain.contG.imgArrow.imgpath = "icon_arrow_d"
	contMain.contH.imgArrow.imgpath = "icon_arrow_d"
	
	contMain.contO.top = 0
	contMain.contA.top = 50
	contMain.contB.top = 100
	contMain.contC.top = 150
	contMain.contD.top = 200
	contMain.contE.top = 250
	contMain.contF.top = 300
	contMain.contG.top = 350
	contMain.contH.top = 400
	
	contMain.contO.height = 50
	contMain.contA.height = 50
	contMain.contB.height = 50
	contMain.contC.height = 50
	contMain.contD.height = 50
	contMain.contE.height = 50
	contMain.contF.height = 50
	contMain.contG.height = 50
	contMain.contH.height = 50
	
	contMain.SetScrollAutoSize()
End Function 

'============================================================================
Sub ImgBackPress_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contMain_contO_lblTitle_OnClick()
	If g_bExpand and g_szFold <> "O" Then
		f_ResetContPos()
		f_ExpandArea("O")
	Else
		f_ExpandArea("O")
	End If
End Sub

