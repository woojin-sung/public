'contO 높이 220->175
'contA 높이 175->220(X 원복)
'contB 높이 215
'contC 높이 475
'contD 높이 435
'contE 높이 185
'contF 높이 185
'contG 높이 210
'contH 높이 290

Dim g_bExpand
Dim g_szFold

Dim g_addTop

'============================================================================
Sub Form_OnFormInit()
	g_bExpand = false
	
	
	osType = Form.GetSharedData("&OS_TYPE",false)
	
	if osType == "2" then
		g_addTop = 2
	else
		g_addTop = 0
		
		contMain.setScrollBarVisible("2")
	end if
	
	
	'텍스트 부분 색상 적용(슈퍼365 영역만)
	contMain.contO.lblContent1.changeTextAttr(0, 9, 6, -1, false)
	contMain.contO.lblContent2.changeTextAttr(22, 8, 6, -1, false)
	contMain.contO.lblContent3.changeTextAttr(0, 15, 6, -1, false)
	contMain.contO.lblContent4.changeTextAttr(18, 9, 6, -1, false)
	contMain.contO.lblContent5.changeTextAttr(0, 13, 6, -1, false)
	contMain.contO.lblContent6.changeTextAttr(10, 14, 6, -1, false)
	contMain.contO.lblContent7.changeTextAttr(0, 7, 6, -1, false)
	
	contMain_contO_lblTitle_OnClick()
End Sub

