Sub ContMain_btnPwd_OnClick()
	if CInt(ContMain.Combo0.currentindex) == -1 then
		Form.ShowAlert("안내", "처리하실 종합계좌번호를\n먼저 선택해주세요.")
		exit sub
	end if
	
	btnOK.enable 		= false
	if szTheme = "black" then
		btnOK.btnimage	= "btn_27.9"
	else
		btnOK.btnimage	= "btn_21.9"
	end if
	btnOK.fgcolor		= "269"
	
	ContMain.EdtPwd.caption = ""
'	ContMain.EdtPwdCnfr.caption = ""
	
	ContMain.EdtPwd.SetShowKeypad(true)
End Sub

