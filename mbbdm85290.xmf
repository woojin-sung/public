	<SCRIPT_INFO _len="26073" _ulen="23981" >
'===========================================================================
' 01. 화 면 명 : 업무신청 정보입력_계좌 비밀번호 재설정
' 02. 화면설명 : 업무신청 정보입력_계좌 비밀번호 재설정
' 03. 작    성 : 2021.01.14 성주혁
' 04. 수    정 :  

'===========================================================================
'진입점에서 설정되는 정보 ---------------------------------------
Dim g_BDM_FRST_MAPID			'최초진입점화면ID

'as-is mbact15006
Dim strRsno '주민번호
Dim strAcno '계좌번호
Dim strCsno '고객번호
Dim TEL_no  '휴대폰번호
 
Dim pwSetYn '계좌비밀번호재설정 신청여부 확인 (as-is :g_Cnt2)

'as-is mbact15007

'업무별 기 신청내역
Dim g_Chk1_007r
Dim g_Chk2_007r
Dim g_Chk3_007r
Dim g_Chk4_007r
Dim g_Chk5_007r
Dim g_Chk6_007r
Dim g_Chk7_007r

'기 신청내역 조회 (0(N):존재 1(Y):미존재)
g_Chk1_007r = 0
g_Chk2_007r = 0
g_Chk3_007r = 0
g_Chk4_007r = 0
g_Chk5_007r = 0
g_Chk6_007r = 0
g_Chk7_007r = 0

'개인정보입력 화면에서 휴대폰번호 받아옴(mbcnf15000) 
HP1 = Form.GetSharedData("BDM_HP1", False )
HP2 = Form.GetSharedData("BDM_HP2", False )
HP3 = Form.GetSharedData("BDM_HP3", False )
TEL_no = HP1 & HP2 & HP3

Dim strApltYn2 	' 비밀번호재설정체크여부
Dim strREG_UNIQ_NO

Dim g_HomeNo		'자택전화번호
Dim g_ClphNo		'휴대전화번호
Dim g_WorkNo		'직장전화번호

Dim strSTPL_YN2
Dim strT1
Dim strD1

'안내사항
Dim bWide
bWide = false

Dim szTheme
'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")

	pwSetYn = ""
	
	szTheme = Form.GetEnvData("common.theme")
	
	ContMain.Combo0.SetApplyLabel("종합계좌번호" , 0 ,268  ,"left", true,80)
	
	ContMain.EdtPwd.SetApplyLabel("신규비밀번호", 0, 268, "left", True)
	ContMain.EdtPwdCnfr.SetApplyLabel("비밀번호 확인", 0, 268, "left", True)
	
	ContMain.EdtPwdCnfr.SetUseResultLabel(true,1)
	
	ContMain.btnPwd.bringFront("1")
	ContMain.btnPwdCnfr.bringFront("1")
	
	btnOK.enable 		= false
	if szTheme = "black" then
		btnOK.btnimage	= "btn_27.9"
	else
		btnOK.btnimage	= "btn_21.9"
	end if
	btnOK.fgcolor		= "269"
	
	ContMain.Container1.Label22.bgcolor = "272"
	
	strREG_UNIQ_NO = Form.GetSharedData("BDM_REG_UNIQ_NO"        , False)
	
	
	strRsno = Form.GetSharedData("BDM_RCNO_PIP", 0)	'주민번호 v0002.난수암호화된 rcno setting
	
	'strRsno ="001342144A13CF8E3A32DD125D4636156EB3" 'dfdf
	'strRsno ="00138286775822AC8BC1DBDAA87754E82DDD"
'	strRsno ="0013E7CB1C9DEEAD3E37FBC27661077A6926" 'dfdf '외주 클린계좌
	
	g_BDM_FRST_MAPID = Form.GetSharedData("BDM_FRST_MAPID"         , false)  '최초진입화면ID
	
	
	DATAMANAGER.RequestTranData("obaci_acct_185r")
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mbbdm85200_p9_end" or  sKeyName == "mbbdm85201_end" or  sKeyName == "mbbdm85202_end" or sKeyName == "mbbdm86203_end" then 
		if sRet =="ok" then
			Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
			if g_BDM_FRST_MAPID ="screen41000" then
				Form.OpenScreen( "41000" , "")
				Form.CloseForm()	
			else
				Form.OpenNextPopup(g_BDM_FRST_MAPID, "", "")
			end if
		end if
	
	elseif sKeyName == "mbbdm86180_p1_end" then
		Form.SetTimerEvent2(1000, 1, 0.5)
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'비밀번호 유효성 검증 실패시 처리
	if sKeyName == "RESET_PWD" then
		Form.SetTimerEvent2(1000, 1, 0.5)
	end if
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if trim(sTimerID) == "9999" then
		Form.SetTimerEvent2("9999", 0, 0.5)
		ContMain.SetScrollAutoSize()
	
	elseif CInt(sTimerID) == 1000 then
		Form.SetTimerEvent2(1000, 0, 0.5)
		
		ContMain.EdtPwd.caption = ""
		ContMain.EdtPwdCnfr.caption = ""
		
		btnOK.enable 		= false
		if szTheme = "black" then
			btnOK.btnimage	= "btn_27.9"
		else
			btnOK.btnimage	= "btn_21.9"
		end if
		btnOK.fgcolor		= "269"
		
		ContMain.EdtPwd.SetShowKeypad(true)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID = "obaci_acct_185r" then
		DATAMANAGER.SetDataValue(0, "obaci_acct_185r", "InBlock1", "RCNO" 	 , 0 , "NMET")	'주민번호(은행개설계좌조회를위한 NMET전달)		
		DATAMANAGER.SetDataValue(0, "obaci_acct_185r", "InBlock1", "RCNO_PIP" , 0 , strRsno)	'주민번호
	
	elseif szTranID = "obaci_nmet_006r" then
		
		DATAMANAGER.SetDataValue(0, "obaci_nmet_006r", "InBlock1", "RCNO_PIP" , 0 , strRsno)	'주민번호
		DATAMANAGER.SetDataValue(0, "obaci_nmet_006r", "InBlock1", "ACNO" 	 , 0 , strAcno)	'계좌번호
	
	elseIf szTranID == "obaci_nmet_005a" Then
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ACNO" 				 , 0 , strAcno 	) '계좌번호
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "ASNO" 				 , 0 , ""		) 
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "DRNG_BANK_CODE" 	 , 0 , ""    		)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "BANK_ACNO" 		 , 0 , "" 		)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "THCO_MNRC_ACNO" 	 , 0 , ""   		)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "THCO_MNRC_ASNO" 	 , 0 , ""	   	)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "IDNTF_SRNO" 		 , 0 , Trim(Form.GetSharedData("BDM_IDNTF_SRNO", false) ))'신분증인증화면에서 가져옴
		'DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "IDNTF_SRNO" 		 , 0 , 9999		)'신분증인증화면에서 가져옴
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "RLNM_CNFR_MTHD_CODE" , 0 , "01"       	)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "WHOL_CPNO" 		 , 0 , TEL_no		)
		'DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "WHOL_CPNO" 		 , 0 , "01056084566")
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock1" , "REG_UNIQ_NO" 		 , 0 , strREG_UNIQ_NO	)
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN1" 			, 0 , ""			) '온라인개설계좌 실명 확인
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN2" 			, 0 , "Y"	) '비밀번호 재설정
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN3" 			, 0 , ""     		) '공인인증서 재발급 동의  신청여부 
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN4" 			, 0 , ""			) '온라인서비스 신청
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN5" 			, 0 , ""			) '온라인 이체한도 등록 및 증액
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN6" 			, 0 , ""			) '타기관OTP 등록
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN7" 			, 0 , ""			) '타기관 은행이체 등록
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "APLT_YN8" 			, 0 , ""			) '메리츠 종합계좌간 대체 등록
	
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "T1_TACT_LIMT_AMT" 	, 0 , 0			) 
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "D1_TACT_LIMT_AMT" 	, 0 , 0  		)
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "OTP_SUPL_CO_CODE" 	, 0 , "" 		)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "OTP_CARD_SRNO" 		, 0 , ""			)
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock2" , "OTP_ISNC_ISTU_CODE" , 0 , ""			)
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock3" , "ALTN_ACNO1" 		, 0 , "" 		) '메리츠계좌간대체 계좌1
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock3" , "ALTN_ACNO2" 		, 0 , "" 		) '			   계좌2
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock3" , "ALTN_ACNO3" 		, 0 , "" 		) '			   계좌3
		
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "TACT_BANK_ACNO1"	, 0 , "" 		) '타기관 은행이체 계좌1
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "TACT_BANK_ACNO2"	, 0 , "" 		) '				계좌2
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "TACT_BANK_ACNO3"	, 0 , "" 		) '				계좌3
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "BANK_CODE1"		, 0 , "" 		) '타기관 은행이체 은행1
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "BANK_CODE2"		, 0 , "" 		) '			      은행2
		DATAMANAGER.SetDataValue(0, szTranID , "InBlock4" , "BANK_CODE3" 	  	, 0 , "" 		) '			      은행3
		
	
	elseif szTranID = "obaci_nmet_011r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"  , 0 , "1")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD_PIP"        , 0 , ContMain.EdtPwd.caption2)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"           , 0 , strAcno )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "WRPL_TELNO"     , 0 , g_WorkNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CLPH_TELNO"     , 0 , g_ClphNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OWHS_TELNO"     , 0 , g_HomeNo)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "RCNO_PIP"       , 0 , strRsno      )
		
	elseif szTranID = "obaci_nmet_011r_1" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"  , 0 , "2")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD_PIP"        , 0 , ContMain.EdtPwd.caption2 ) 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CNFR_PWD_PIP"   , 0 , ContMain.EdtPwdCnfr.caption2) 
	
	elseif szTranID == "obaci_accd_004u" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_CUST_CONT_CLS_CODE"  , 0 , "8")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"        , 0 , strAcno ) 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE"   , 0 , "Y" ) 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "MDAF_PWD"  , 0 , ContMain.EdtPwdCnfr.caption )
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SELF_YN"        , 0 , "Y" ) 
	
	elseif szTranID == "obaci_acct_034u" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_CUST_CONT_CLS_CODE"  , 0 , "8")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"        , 0 , strAcno ) 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "MDAF_PWD"        , 0 , ContMain.EdtPwd.caption ) 
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "UI_CNFR_PWD"        , 0 , ContMain.EdtPwdCnfr.caption ) 
		
	elseif szTranID == "obacp_comm_004r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO"  , 0 , strAcno )
	
	elseif szTranID == "obacp_comm_058r" then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS", 0 , "A" 		 )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"    , 0 , strAcno )  '계좌번호
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOGN_ID" , 0 , "" )  'ID
		'비밀번호복호화하여 비교해야하므로 ARIA값으로 넘겨줌(caption2 API사용)
'		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MDBF_PWD_PIP", 0 , "" )  '현재비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD_PIP"     , 0 , ContMain.EdtPwd.caption2 )  		'비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFR_PWD_PIP", 0 , ContMain.EdtPwdCnfr.caption2 )	'확인비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP"		 , 0 , strRsno	)  '실명확인번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WRPL_TELNO"  , 0 , g_WorkNo        )  '직장전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLPH_TELNO"  , 0 , g_ClphNo        )  '휴대전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OWHS_TELNO"  , 0 , g_HomeNo        )  '자택전화
	End if
End Sub

'============================================================================
' 데이터 수신 
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obaci_acct_185r" Then
	
		tmp = DATAMANAGER.GetDataCount( 0 , "obaci_acct_185r", "OutBlock1")	
		for i = 0 to tmp-1
			acno 	 = DATAMANAGER.GetDataValue( 0 ,"obaci_acct_185r", "OutBlock1", "ACNO",i )
			mask_acno = Combo_AccMask(acno)
			ContMain.Combo0.cbadddatatext  = mask_acno
			
			strAcno = replace(ContMain.Combo0.caption, "-" , "")
		next 
		
		ContMain.Combo0.currentindex = -1
		
		ContMain.Combo0.caption  = "종합계좌를 선택해주세요"
		ContMain.Combo0.fgcolor = 270
		'DATAMANAGER.RequestTranData("obaci_nmet_006r")
	
	elseif szTranID = "obaci_nmet_006r" Then
		
		g_StatCd = DATAMANAGER.GetDataValue( 0 ,"obaci_nmet_006r", "OutBlock4", "ACNT_STAT_CODE",0 )
		g_ProsYN =  DATAMANAGER.GetDataValue( 0 ,"obaci_nmet_006r", "OutBlock4", "PROS_ABLE_YN",0 )
		
		Form.SetSharedData("ACNT_STAT_CODE", g_StatCd)
			
		'입력한 종합계좌 상태 체크
		if g_StatCd == "3" Then
			ShowAlert("오류","폐쇄된 종합계좌입니다.")
			Exit Sub
		End If
		
		'보유중인 계좌 중, 계좌상태가 정상인 종합계좌, 하위개별계좌 건수 확인
'		If g_ProsYN == "N" Then
'			ShowAlert("오류","정상 개별계좌가 없습니다.")
'			Exit Sub
'		End If
		
		'ShowAlert("확인", "계좌번호가 확인되었습니다.")
		
		
		DATAMANAGER.SetDataValue(0, "obacp_opop_064r", "InBlock1" , "ACNO" , 0 , strAcno)
		DATAMANAGER.RequestTranData "obacp_opop_064r"
	
	ElseIf szTranID == "obacp_opop_064r" Then
		strCsno = DATAMANAGER.GetDataValue(0, "obacp_opop_064r" , "OutBlock1" , "CSNO" , 0)
		'0203
		Form.SetSharedData("CSNO" , strCsno)
		'strRcno = DATAMANAGER.GetDataValue(0, "obacp_opop_064r" , "OutBlock1" , "RCNO" , 0) v0002. 난수암호화된 rcno setting
		
		DATAMANAGER.SetDataValue(0, "obaci_nmet_007r", "InBlock1", "ACNO" , 0 , strAcno)
		DATAMANAGER.SetDataValue(0, "obaci_nmet_007r", "InBlock1", "CSNO" , 0 , strCsno)
		DATAMANAGER.RequestTranData "obaci_nmet_007r"
		
		get_STPL_YN()
		
	ElseIf szTranID == "obaci_nmet_007r" Then '계좌비밀번호재설정 신청여부 확인
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN2", 0) == "Y" Then
			pwSetYn = 1 '신청 내역 없음
		else
			'ShowAlert("오류","이미 신청내역있음.")
		End if
		
		g_strTactLimitBfr = DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN5", 0)
		g_strOTPBf		= DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN6", 0)
			
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN4", 0) == "Y" Then
			g_Chk1_007r = 1
		Else
			g_Chk1_007r = 0
		End if
		
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN5", 0) == "Y" Then
			g_Chk2_007r = 1
		Else
			g_Chk2_007r = 0
		End if
		
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN1", 0) == "Y" Then
			g_Chk4_007r = 1
		Else
			g_Chk4_007r = 0
		End if
		
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN3", 0) == "Y" Then
			g_Chk5_007r = 1
		Else
			g_Chk5_007r = 0
		End if
		
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN7", 0) == "Y" Then
			g_Chk6_007r = 1
		Else
			g_Chk6_007r = 0
		End if
		
		If DATAMANAGER.GetDataValue(0, "obaci_nmet_007r", "OutBlock1", "PROS_ABLE_YN8", 0) == "Y" Then
			g_Chk7_007r = 1
		Else
			g_Chk7_007r = 0
		End if	
		
		If pwSetYn = 1 Then
			'
		Else
			ShowAlert("안내", "계좌비밀번호 재설정 신청내역이 존재합니다. 영업점 승인 및 재설정 완료 후 신청가능합니다.")
			btnOK.enable 		= false
			if szTheme = "black" then
				btnOK.btnimage	= "btn_27.9"
			else
				btnOK.btnimage	= "btn_21.9"
			end if
			btnOK.fgcolor		= "269"
			
			Exit Sub
		End If
		
'		ContMain.EdtPwd.SetShowKeypad(true)
		DATAMANAGER.RequestTranData( "obacp_comm_004r" )
	
		
	ElseIf szTranID == "obaci_nmet_009r" Then
		
		'은행이체한도등록및변경 
		strSTPL_YN2 = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock1" , "STPL_YN" , 0 )
		
		
		strT1 = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock1" , "T1_TACT_LIMT_AMT" , 0 )
		strD1 = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock1" , "D1_TACT_LIMT_AMT" , 0 )
		Grade = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock1" , "SECU_GRAD_CLS_CODE" , 0 )
		
		'Form.SetSharedData("15007_T1", T1)
		'Form.SetSharedData("15007_D1", D1)
		Form.SetSharedData("15007_Grade", Grade)
			
		
		'타기관 은행이체 등록
		STPL_YN6 = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock3" , "STPL_YN" , 0 )
		'Form.SetSharedData("STPL_YN6", STPL_YN6)
		
		'메리츠 종합계좌간 대체 등록
		STPL_YN7 = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock4" , "STPL_YN" , 0 )		
		'Form.SetSharedData("STPL_YN7", STPL_YN7)
		
		'제휴은행개설계좌 여부 확인
		TRGT_YN = DATAMANAGER.GetDataValue( 0 , "obaci_nmet_009r" , "OutBlock5" , "TRGT_YN" , 0 )		
		Form.SetSharedData("15007_TRGT_YN", TRGT_YN)
		
	ElseIf szTranID == "obaci_nmet_005a" Then '최종업무신청 성공
		tmp_aplt_date	= DATAMANAGER.GetDataValue( 0 ,"obaci_nmet_005a", "OutBlock1", "APLT_DATE"			,0 )
		tmp_aplt_time	= DATAMANAGER.GetDataValue( 0 ,"obaci_nmet_005a", "OutBlock1", "NMET_OPNG_APLT_TIME"	,0 )
		
		Dim szSendData
		szSendData = "계좌비밀번호 재등록이\n완료되었습니다."
		
		Form.OpenPopup("mbbdm86203", szSendData , "" ) '업무 완료 화면
	
	elseif szTranID = "obaci_nmet_011r" then
		Dim ProsClsCode , RsltCode
		ProsClsCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "PROS_CLS_CODE" , 0)
		RsltCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "IF_RSLT_CODE"  , 0)
		
		If ProsClsCode == "1" and TRIM(RsltCode) <> "00" Then
			Form.OpenPopup("mbbdm86180_p1", RsltCode , "" )
			
		Else '비밀번호 입력 성공시
'			ContMain.EdtPwdCnfr.SetShowKeypad(true)
			
			DATAMANAGER.RequestTranData( "obaci_nmet_011r_1" )
		End If
		
	elseif szTranID = "obaci_nmet_011r_1" then
		Dim ProsClsCode , RsltCode
		ProsClsCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "PROS_CLS_CODE" , 0)
		RsltCode	= DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "IF_RSLT_CODE"  , 0)
		
		if ProsClsCode == "2" and trim(RsltCode) <> "00" then
'			Form.ShowAlert("안내", "계좌비밀번호가 일치하지 않습니다.")
'			ContMain.EdtPwdCnfr.caption = ""
		
			Form.OpenPopup("mbbdm86180_p1", "09" , "" )
		else
'			btnOK.enable = true
'			btnOK.btnimage = "btn_20.9"
'			btnOK.fgcolor = "273"	
			
			'계좌비밀번호 정정처리
			DATAMANAGER.RequestTranData( "obaci_accd_004u" )
			'DATAMANAGER.RequestTranData( "obaci_acct_034u" )
		end if
	
	elseif szTranID == "obaci_accd_004u" then
		DATAMANAGER.RequestTranData( "obaci_nmet_005a" )
		
	elseif szTranID == "obaci_acct_034u" then
		DATAMANAGER.RequestTranData( "obaci_nmet_005a" )
	
	elseif szTranID == "obacp_comm_004r" then
		g_HomeNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_TELNO"      , 0)  '자택전화
		g_ClphNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CLPH_TELNO"      , 0)  '휴대전화
		g_WorkNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WRPL_WHOL_TELNO" , 0)  '직장전화
		
		'전화번호 정보까지 조회하고 키패드 띄움
		ContMain.EdtPwd.SetShowKeypad(true)
		
	elseif szTranID == "obacp_comm_058r" then
		'계좌비밀번호 정정처리
		DATAMANAGER.RequestTranData( "obaci_acct_034u" )
	end if
End Sub
'============================================================================
'데이터 오류 수신
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim sSubmsg
	sSubmsg = DATAMANAGER.GetDataMsgSubText(szTranID)
'	Form.ShowAlert(szTranID, "")
	if szTranID == "obaci_nmet_005a" then
		
		if sSubmsg ="" then
			Form.OpenPopup("mbbdm85202", szErrMsg , "" )
		else
			Form.OpenPopup("mbbdm85202", szErrMsg&"("&sSubmsg&")" , "" )
		end if
	else
		if szTranID == "obacp_comm_058r" then
			if sSubmsg ="" then
				Form.MsgBox("알림", szErrMsg, "RESET_PWD", 6)
			else
				Form.MsgBox("알림", szErrMsg .. "(" .. sSubmsg .. ")", "RESET_PWD", 6)
			end if
		else
			if sSubmsg ="" then
				Form.ShowAlert("알림", szErrMsg)
			else
				Form.ShowAlert("알림", szErrMsg .. "(" .. sSubmsg .. ")")
			end if
		end if
	end if

End Sub
'============================================================================
Function get_STPL_YN()
	DATAMANAGER.SetDataValue(0, "obaci_nmet_009r", "InBlock1", "ACNO", 0, strAcno )
	DATAMANAGER.SetDataValue(0, "obaci_nmet_009r", "InBlock1", "CSNO", 0, strCsno )
	DATAMANAGER.RequestTranData("obaci_nmet_009r")
End Function

