'안내사항
'================================
Sub ContMain_Container1_Label11_OnClick()
	
	if bWide == false then
		bWide = true
		
		'안보이는라벨위치 아래로 조정
		
		ContMain.InfoPos.top = 800
		ContMain.SetScrollAutoSize()
		ContMain.Container1.Image3.imgpath = "icon_caret_up.png"
		
		ContMain.Container1.SetHeightResize(305)
'		ContMain.scroll_pos = 165
		ContMain.scroll_pos = 250
		
	else
		
		bWide = false
'		ContMain.Container1.SetHeightResize(40)
		ContMain.Container1.height = 40
		ContMain.InfoPos.top = 0
		ContMain.scroll_pos = 0 
		ContMain.Container1.Image3.imgpath = "icon_caret_down.png"
		
'		Form.SetTimerEvent2("9999", 1, 0.5)
		
		ContMain.SetScrollAutoSize()
		
	end if
end Sub

