'============================================================================
Sub ContMain_Combo0_OnEditComplete(iIndex)
	if iIndex <> -1 then
		ContMain.Combo0.fgcolor = 4
		
		btnOK.enable 		= false
		if szTheme = "black" then
			btnOK.btnimage	= "btn_27.9"
		else
			btnOK.btnimage	= "btn_21.9"
		end if
		btnOK.fgcolor		= "269"
		
		ContMain.EdtPwd.caption = ""
		ContMain.EdtPwdCnfr.caption = ""
		
		strAcno = replace(ContMain.Combo0.caption, "-" , "")
		
		DATAMANAGER.RequestTranData("obaci_nmet_006r")
	end if
End Sub

'============================================================================
Function Combo_AccMask(szAcc)
           Combo_AccMask = Left(szAcc, 4)&"-"&Mid(szAcc, 5, 4)
End Function

'============================================================================
Sub ContMain_EdtPwd_OnEditComplete()
	'비밀번호 유효성 체크 로직 변경 
'	DATAMANAGER.RequestTranData( "obaci_nmet_011r" )

	'자릿수 모자르게 입력되었는지 체크
	Dim nLen
	nLen = CInt(ContMain.EdtPwd.pwdlen)
	if nLen < 4 then
		ContMain.EdtPwd.caption = ""
		exit sub
	end if
	
	if ContMain.EdtPwd.caption <> "" and ContMain.EdtPwd.caption <> null then
		'재입력란도 입력되어있으면 다음버튼 활성화
		if ContMain.EdtPwdCnfr.caption <> "" and ContMain.EdtPwdCnfr.caption <> null then
			btnOK.enable = true
			btnOK.btnimage = "btn_20.9"
			btnOK.fgcolor = "273"
			
		'아니면 재입력란 키패드 띄움
		else
			ContMain.EdtPwdCnfr.SetShowKeypad(true)
		end if
	end if
End Sub

'============================================================================
Sub ContMain_EdtPwdCnfr_OnEditComplete()
	'비밀번호 유효성 체크 로직 변경 
'	DATAMANAGER.RequestTranData( "obaci_nmet_011r_1" )
	
	'자릿수 모자르게 입력되었는지 체크
	Dim nLen
	nLen = CInt(ContMain.EdtPwdCnfr.pwdlen)
	if nLen < 4 then
		ContMain.EdtPwdCnfr.caption = ""
		exit sub
	end if
	
	if ContMain.EdtPwdCnfr.caption <> "" and ContMain.EdtPwdCnfr.caption <> null then
		'신규비밀번호 입력되어있으면 다음버튼 활성화
		if ContMain.EdtPwd.caption <> "" and ContMain.EdtPwd.caption <> null then
			btnOK.enable = true
			btnOK.btnimage = "btn_20.9"
			btnOK.fgcolor = "273"
			
		'아니면 신규비밀번호 입력 키패드 띄움
		else
			ContMain.EdtPwd.SetShowKeypad(true)
		end if
	end if
End Sub

