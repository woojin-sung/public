'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szFileName	'설정파일
dim	g_szNames		'설정Key
dim	g_szValues		'설정값
dim 	g_szCodes		'실제Input값
dim	g_szTRList		'TR목록
dim	g_nGridIdx		'그리드 데이터들어갈 위치
dim	g_nItemCnt		'실제들어갈 아이템사이즈

g_szNames	= Array("41000_CD", "41000_COMBOND", "41000_CNTBOND")
g_szValues	= Array()
g_szTRList	= Array("obfni_rmss_140r", "obfni_rmss_140r_1", "obfni_rmss_140r_2")	 'CD, 회사채, 국고채

g_szFileName = "41000ITEMS.ini"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
Function LoadSetting()

	for	i	=	0	to	Ubound(g_szNames)
		g_szValues(i)	=	Form.LoadConfigData(g_szFileName, g_szNames(i)	)
		if	g_szValues(i)	=	"1"	then
			g_nItemCnt = g_nItemCnt + 1
		end if 
	Next
	
'	for	i	=	0	to	Ubound(g_szNames)
'		Form.ShowAlert(i, g_szValues(i))
'	Next
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	grd01.SetClear()
	grd01.AddRow()
	'Form_OnFormInit()
	
	g_nGridIdx		=	0
	g_nItemCnt		=	0
	
	call	 LoadSetting()

	
	for	i = 0	to	Ubound(g_szNames)
		if	g_szValues(i)	=	"1"	then
			DATAMANAGER.RequestTranData(g_szTRList(i))
		end if 
	next
End Sub


'============================================================================
'Form_OnRefresh
'============================================================================
Sub Form_OnRefresh()
	Form_OnFormInit()
End Sub


'============================================================================
'DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if	szTranID	=	"obfni_rmss_140r"	then											'CD금리
			DATAMANAGER.SetDataValue(0, "obfni_rmss_140r", 	"InBlock1", "OVRS_PRMR_NMIX_CLCD", 0, "6")
	elseif	szTranID	=	"obfni_rmss_140r_1"	then
			DATAMANAGER.SetDataValue(0, "obfni_rmss_140r_1", 	"InBlock1", "OVRS_PRMR_NMIX_CLCD", 0, "5")	'회사채
	elseif	szTranID	=	"obfni_rmss_140r_2"	then
			DATAMANAGER.SetDataValue(0, "obfni_rmss_140r_2", 	"InBlock1", "OVRS_PRMR_NMIX_CLCD", 0, "4")	'국고채
	end if
End Sub


'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	dim	szName, szPrpr, szSign, szVrss, szCtrt, szDate, szCode
	dim 	szColor
	dim	n140cnt
	dim	szGrade

	if	szTranID	=	"obfni_rmss_140r"	then											'CD금리
		n140cnt	=	DATAMANAGER.GetDataCount(0, "obfni_rmss_140r" , "OutBlock1")
		
		for 	i = 0	to	n140cnt -1
			szGrade	=	DATAMANAGER.GetDataValue(0, "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_ISCD", i)
			
			if	szGrade	=	"AAA"	then
				szPrpr = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_CLPR" , i)
				szSign = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_SIGN" , i)
				szVrss = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_VRSS_VAL" , i)
				szCtrt = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_CTRT" , i)
				szDate = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_ISSU_DATE" , i)
				szCode = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r", "OutBlock1", "OVRS_PRMR_NMIX_ISCD", i)								
				
				szName = "CD금리"
			end if
		next
	elseif	szTranID	=	"obfni_rmss_140r_1"	then
		szPrpr = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r_1", "OutBlock1", "OVRS_PRMR_NMIX_CLPR" , 0)
		szSign = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r_1", "OutBlock1", "OVRS_PRMR_NMIX_SIGN" , 0)
		szVrss = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r_1", "OutBlock1", "OVRS_PRMR_NMIX_VRSS_VAL" , 0)
		szCtrt = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r_1", "OutBlock1", "OVRS_PRMR_NMIX_CTRT" , 0)
		szDate = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r_1", "OutBlock1", "OVRS_PRMR_NMIX_ISSU_DATE" , 0)
		szCode = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r_1", "OutBlock1", "OVRS_PRMR_NMIX_ISCD", 0)
		szName = "회사채"
	elseif	szTranID	=	"obfni_rmss_140r_2"	then
		szPrpr = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r_2", "OutBlock1", "OVRS_PRMR_NMIX_CLPR" , 0)
		szSign = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r_2", "OutBlock1", "OVRS_PRMR_NMIX_SIGN" , 0)
		szVrss = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r_2", "OutBlock1", "OVRS_PRMR_NMIX_VRSS_VAL" , 0)
		szCtrt = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r_2", "OutBlock1", "OVRS_PRMR_NMIX_CTRT" , 0)
		szDate = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r_2", "OutBlock1", "OVRS_PRMR_NMIX_ISSU_DATE" , 0)
		szCode = DATAMANAGER.GetDataValue(0, "obfni_rmss_140r_2", "OutBlock1", "OVRS_PRMR_NMIX_ISCD", 0)
		szName = "국고채"
		
		
	end if
	
	
	if szSign  == "1" or szSign == "2" then 
		szColor = "10"
	elseif szSign  == "4" or szSign == "5" then 
		szColor = "11"
	else
		szColor = "12"
	end if
	
	grd01.SetCellData("bd_cell0", g_nGridIdx, szCode)			
	grd01.SetCellData("bd_name", g_nGridIdx, szName)

	if  		szName == "CD금리" then
''msgbox "szName[" & szName & "], szPrpr[" & szPrpr & "], szPrpr(2)[" & FormatNumber(szPrpr, 2)  & "], szPrpr(4)[" & FormatNumber(szPrpr, 4)  & "]"
		grd01.SetCellData("bd_prpr", g_nGridIdx, FormatNumber(szPrpr, 2) )
		grd01.SetCellData("bd_vrss", g_nGridIdx, FormatNumber(szVrss, 2) )
	else
		grd01.SetCellData("bd_prpr", g_nGridIdx, FormatNumber(szPrpr, 4) )
		grd01.SetCellData("bd_vrss", g_nGridIdx, FormatNumber(szVrss, 4) )
	end if
'	grd01.SetCellData("bd_prpr", g_nGridIdx, szPrpr)
	grd01.SetCellData("bd_sign", g_nGridIdx, szSign)
'	grd01.SetCellData("bd_vrss", g_nGridIdx, szVrss)
	grd01.SetCellData("bd_ctrt", g_nGridIdx, szCtrt)
	grd01.SetCellData("bd_date", g_nGridIdx, szDate)

	grd01.SetCellFgColor( "bd_prpr", g_nGridIdx, szColor )	
	grd01.SetCellFgColor( "bd_vrss", g_nGridIdx, szColor )	
	grd01.SetCellFgColor( "bd_ctrt", g_nGridIdx, szColor )
	
	g_nGridIdx = g_nGridIdx + 1
	
	if	g_nGridIdx		<	g_nItemCnt		then
		grd01.AddRow()
	end if
End Sub


'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	grd01.SetClear()
	grd01.AddRow()
	Form_OnFormInit()
End Sub

'============================================================================
Sub grd01_OnClickUp(lRow, szCellID)
	dim szSymbol
	dim szMarket
	dim szName
	dim szDate
	
	szSymbol = grd01.GetCellData( "bd_cell0", lRow )
	szMarket = "RATE"	'grd01.GetCellData( "bd_cell1", lRow )
	szName	= grd01.GetCellData( "bd_name", lRow )
	szDate	= grd01.GetCellData( "bd_date", lRow )
	
'msgbox "금리(41000_s6).. lRow:[" & lRow & "].. szSymbol:[" & szSymbol & "], szMarket[" & szMarket & "], szName[" & szName & "], szDate[" & szDate & "]"
	
	Form.OpenFramePopup("mhidx42040_p1" , szSymbol & "★" &  szMarket & "★" & szName & "★" & szDate , sPosInfo)
End Sub

