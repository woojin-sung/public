		<EDIT name="Edit1" mask="0,0,,,0,,0,1,1" halign="1" imetype="1" ly_vert="120,120,100,25,1" />
		<EDIT name="Edit2" mask="0,0,,,0,,0,1,1" halign="1" imetype="1" ly_vert="120,170,100,25,1" />
