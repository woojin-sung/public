'============================================================================
Sub btnok_OnClick()

	if Edit0.caption <> "" and Edit1.caption <> "" and Edit2.caption <> "" then
	tmp = Edit0.caption&"●"&Edit1.caption&"●"&Edit2.caption
	Form.OpenPopup("mbetc99000_p3" , tmp , "")
	Form.CloseForm()
	
	else
	Form.Toast(0, "입력하지 않은 항목이 있습니다.", 0.5)
	
	end if
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

