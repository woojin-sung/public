'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	' ----------------------------------------------------------------------
	' 관심종목 데이터조회
	' ----------------------------------------------------------------------
	if szTranID ==  "ohhts_1020_004r" then
		grdList0.rowcount = "0"		' 종목조회그리드 초기화
		
		DATAMANAGER.ClearInputData(0, "ohhts_1020_004r")

		For i = 0 to grdCode.rowcount-1
			szMk = grdCode.GetCellData("bd_mk", i)
			
			' 시장구분이 없는것은 종목데이터 조회에서 뺀다. -> HTS는 그냥 던짐..ㅋ
			'if Trim(szMk) <> "" then
			'if i < 2 then
				szMk = Trim(grdCode.GetCellData("bd_mk", i))
				szCd = Trim(grdCode.GetCellData("bd_code", i))
				
				' MTS에서 보여주는 상품의 종목만 선택
				szMk = f_ChkMarket(szMk, szCd)

				DATAMANAGER.SetDataValue(0, "ohhts_1020_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", i, szMk)
				DATAMANAGER.SetDataValue(0, "ohhts_1020_004r", "InBlock1", "FID_INPUT_ISCD",               i, szCd)
			'end if
		 Next
	' 20190214 HWG START : 해외파생 최근조회종목 추가
	elseif szTranID ==  "ohhts_6500_002r" then
		grdGlobalList.rowcount = "0"		' 종목조회그리드 초기화
		
		Dim szExch, szCode
		For i = 0 to grdGlobalCode.rowcount-1
			szExch = Trim( grdGlobalCode.GetCellData("bd_exch", i) )
			szCode = Trim( grdGlobalCode.GetCellData("bd_code", i) )
			
			If szExch <> "" Then
				DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FID_OVDV_QTTN_EXCH_NAME" , i , szExch )
				DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FID_OVDV_ISCD"           , i , szCode )
			Else
			    DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FID_OVDV_QTTN_EXCH_NAME" , i , "" )
			    DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FID_OVDV_ISCD"           , i , "" )
			End If
		Next
	elseif szTranID ==  "ohhts_6000_012r" then
		grdExstList.rowcount = "0"		' 종목조회그리드 초기화
		
		Dim szExch, szCode, szDelay
		For i = 0 to grdExstCode.rowcount-1
			szExch = Trim( grdExstCode.GetCellData("bd_exch", i) )
			szCode = Trim( grdExstCode.GetCellData("bd_code", i) )
			
			szDelay = ""
			if szExch <> "" then
				szDelay = Form.GetSharedData("REALTIME_"..szExch, 0 )
			end if

			DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FID_INPUT_COND_MRKT_DIV_CODE" , i , "OV" )
			DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FID_INPUT_OVRS_ISCD" , i , szCode )
			DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FID_COND_MRKT_CLS_CODE" , i , szExch )
			DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FIDX_INPUT_DELY_RLTM_CLS_CODE" , i , szDelay )
		Next
	end if
	' 20190214 HWG END
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szCd, szMk, szMm
	' 종목의 시장구분은 조회데이터가 잘못된 값이 내려올수 있으므로 메인에서 받아와야한다.	''''''''''''''''''	
	
	' ----------------------------------------------------------------------
	' 관심종목 종목데이터 조회
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_1020_004r" then
		' 실시간을 위한 작업 //////////////////////////////////////////////
		For j = 0 to grdMk.rowcount - 1
			szCd = grdMk.GetCellData("bd_code", j)
			szMk = grdMk.GetCellData("bd_mk", j)
			
			if szCd <> "" and szMk <> "" then
				tCode = Split(szCd, "★")
				
				For k = 0 to #tCode-1
					' MTS에서 보여주는 상품의 종목만 선택
					szMk = f_ChkMarket(szMk, tCode(k))

					if szMk <> "" then
						Set_Real_Input(szMk, k, tCode(k))
					end if
				Next
				
				Real_RequestData(szMk)
			end if
		Next
		' //////////////////////////////////////////////////////////////////
		
	' 20190214 HWG START : 해외파생 최근조회종목 추가
	' ----------------------------------------------------------------------
	' 관심종목 종목데이터 조회(해외파생)
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_6500_002r" then
		' 메모셀 적용 ////////////////////////////////////////////////////////
		' -> MTS마스터에 없는 종목 보이지 않기 20160321
'		For i =  grdCode.rowcount - 1 to 0 step -1
		For i = 0 to grdGlobalCode.rowcount - 1
			szMemo = grdGlobalCode.GetCellData("bd_memo", i)
			szCode = grdGlobalCode.GetCellData("bd_code", i)
			szExch = grdGlobalCode.GetCellData("bd_exch", i)
			
			if Trim(szMemo) <> "" then
				grdGlobalList.SetPropGridCell("memo", "bd_code", i, szMemo)
			end if	
			
			if Trim(szExch) == "" and Trim(szCode) <> "EMPTY" then
				grdGlobalList.SetCellData("bd_name", i, szCode)
				grdGlobalList.SetCellFgColor("bd_name", i, "127")		
			end if
			' ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++		
		Next			
		' //////////////////////////////////////////////////////////////////
		
		' 실시간을 위한 작업 //////////////////////////////////////////////
		DATAMANAGER.ClearInputData( 1, "ohhts_ovdv_cntf" )
		
		For j = 0 to grdGlobalMk.rowcount - 1
			szCode = grdGlobalMk.GetCellData("bd_code", j)
			szExch = grdGlobalMk.GetCellData("bd_exch", j)

			if szCode <> "" and szExch <> "" then
				tCode = Split(szCode, "★")
	
				
				
				For k = 0 to #tCode-1
					if szExch <> "" then
						Set_Real_Global_Input(k, tCode(k))
					end if
				Next
				
				Real_Global_RequestData( )
			end if
		Next
		' //////////////////////////////////////////////////////////////////
	' ----------------------------------------------------------------------
	' 관심종목 종목데이터 조회(해외주식)
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_6000_012r" then
		For i = 0 to grdExstCode.rowcount - 1
			szCd = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FIDX_ISCD" , i )
			szExch = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "FID_COND_MRKT_CLS_CODE" , i )
			grdExstList.SetCellData("bd_code", i, szExch.."@"..szCd)
			
			if szCd <> "" and szExch <> "" then
				Set_Real_Exst_Input(i, szExch.."@"..szCd)
			end if
		Next
		grdExstList.keyall = "1"
		Real_Exst_RequestData()
	end if
	' 20190214 HWG END
End Sub
	
'============================================================================
' grdList0_OnClickUp : 현재가 그리드 클릭
'============================================================================
Sub grdList0_OnClickUp(lRow, szCellID)
	szCd = grdList0.GetCellData("bd_code", lRow)
	
	if Trim(szCd) == "" then
		Exit Sub
	end if
	
	'아이템코드 컨트롤에 박아주기 이호철
	Form.SetCtlProp( "ItemCode0", "code", szCd )
	
	' 사이드메뉴에서만 사용 ////////////////////////////////////////////////
	Form.SetItemCode(szCd)	
	
	Form.triggerEvent("#", "CLOSE_FORM", "")
	' /////////////////////////////////////////////////////////////////////
End Sub

' 20190214 HWG START : 해외파생 최근조회종목 추가
'============================================================================
' grdGlobalList_OnClickUp : 해외파생 최근조회 종목 클릭
'============================================================================
Sub grdGlobalList_OnClickUp(lRow, szCellID)
	szCd = grdGlobalList.GetCellData("bd_code", lRow)
	
	if Trim(szCd) == "" then
		Exit Sub
	end if
	
'	'아이템코드 컨트롤에 박아주기 이호철
'	Form.SetCtlProp( "ItemCode0", "code", szCd )
	
	' 사이드메뉴에서만 사용 ////////////////////////////////////////////////
	Form.SetItemCode(szCd)	
	
	Form.triggerEvent("#", "CLOSE_FORM", "")
	' /////////////////////////////////////////////////////////////////////
End Sub

'============================================================================
' grdExstList_OnClickUp : 해외주식 최근조회 종목 클릭
'============================================================================
Sub grdExstList_OnClickUp(lRow, szCellID)
	szCd = grdExstList.GetCellData("bd_code", lRow)
	szName = grdExstList.GetCellData("bd_name", lRow)

	if Trim(szCd) == "" then
		Exit Sub
	end if
			
	Form.SetSharedData( "&ITEM_OVERSTOCK" , szCd & "★" & szName & "★" & "" )		
	Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szCd & "★" & szName & "★" & "", "" )

	Form.triggerEvent("#", "CLOSE_FORM", "")
	' /////////////////////////////////////////////////////////////////////
End Sub

'============================================================================
Sub btnNext_OnClick()
	szMkIdx = cmbRecentGroup.currentindex
	if szMkIdx = "1" then
		cmbRecentGroup.currentindex = "2"
	elseif szMkIdx = "2" then
		cmbRecentGroup.currentindex = "0"
	elseif szMkIdx = "0" then
		cmbRecentGroup.currentindex = "1"
	end if
End Sub

'============================================================================
Sub btnPrev_OnClick()
	szMkIdx = cmbRecentGroup.currentindex
	if szMkIdx = "1" then
		cmbRecentGroup.currentindex = "0"
	elseif szMkIdx = "2" then
		cmbRecentGroup.currentindex = "1"
	elseif szMkIdx = "0" then
		cmbRecentGroup.currentindex = "2"
	end if
End Sub

'============================================================================
Sub cmbRecentGroup_OnEditComplete(iIndex)
	if iIndex = 0 then
		grdList0.visible = True
		grdGlobalList.visible = False
		grdExstList.visible = False
	elseif iIndex = 1 then
		grdList0.visible = False
		grdGlobalList.visible = False
		grdExstList.visible = True
	elseif iIndex = 2 then
		grdList0.visible = False
		grdGlobalList.visible = True
		grdExstList.visible = False
	end if
	
	Form.SaveConfigData("RECENTITEM", "EXST_COMBOIDX", iIndex )
End Sub
' 20190214 HWG END

'============================================================================
' null 체크
'============================================================================
Function isNull(str)
	if null == str or "" == str or Len(Trim(str)) <= 0 then
		return true
	end if
	
	return false
End Function

'============================================================================
Function f_getExchCode2(szExchCode3)
	if szExchCode3 == "NAS" then
		return "OQ"
	elseif szExchCode3 = "AMX" then
		return "AX"
	elseif szExchCode3 = "NYS" then
		return "NY"
	elseif szExchCode3 = "SHS" then
		return "SH"
	elseif szExchCode3 = "SZS" then
		return "SZ"
	elseif szExchCode3 = "HKS" then
		return "HK"
	elseif szExchCode3 = "TSE" then
		return "JP"
	end if
	
	return szExchCode3
End Function

