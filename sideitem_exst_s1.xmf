'============================================================================
' Load_RecentList :  최근조회종목 리스트
'============================================================================
Function Load_RecentList(szData)
	Dim tList
	Dim szMk
	
	grdCode.rowcount = 0

	if Trim(szData) <> "" then
		tList = Split(szData, "`")
		
		For i = 0 to #tList-1
			szMk = Form.GetItemCodeInfo(tList(i), "market")
			szMk = Change_EtcMarket(szMk)
			
			grdCode.insertrow = i

			grdCode.SetCellData("bd_code", i, tList(i))
			grdCode.SetCellData("bd_mk",   i, szMk)
			grdCode.SetCellData("bd_memo", i, "")
		Next
	
		Form.SetCtlProp("#edtListCnt", "caption", grdCode.rowcount)

		Save_grdMk()		
	end if
End Function

'============================================================================
' 20190214 HWG START : 해외파생 최근조회종목 추가
'============================================================================
' Load_GlobalRecentList :  최근조회종목 리스트
'============================================================================
Function Load_GlobalRecentList(szData)
	Dim tList
	Dim szExch, szName
	
	grdGlobalCode.rowcount = 0
	
	if Trim(szData) <> "" then
		tList = Split(szData, "`")
		
		For i = 0 to #tList-1
			szExch = Form.GetItemCodeInfo( tList(i) , "exchname" )
			szName = Form.GetItemCodeInfo( tList(i) , "name" )
			
			grdGlobalCode.insertrow = i
			grdGlobalCode.SetCellData( "bd_code" , i , tList(i) )
			grdGlobalCode.SetCellData( "bd_exch" , i , szExch   )
			grdGlobalCode.SetCellData( "bd_memo" , i , ""       )
			grdGlobalCode.SetCellData( "bd_name" , i , szName   )
		Next
	
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)

		Save_grdGlobalMk( )		
	end if
End Function
' 20190214 HWG END

'============================================================================
' Load_GlobalRecentList :  해외주식 최근조회종목 리스트
'============================================================================
Sub Load_ExstRecentList()
	Dim nHistoryCount, szItemHistory, tItemHistory, nRowCount, nCurCount, tCode
	
	grdExstCode.rowcount = 0

	nHistoryCount = Form.GetRecentHistoryIMaxCount()
	
	For i = 0 to nHistoryCount-1
		szItemHistory = Form.GetRecentHistoryIMax(i)
		if( not isNull( szItemHistory ) ) then		
			tItemHistory = Split( szItemHistory, "★" )
			if Null <> tItemHistory and #tItemHistory >= 2 then
				grdExstCode.insertrow = 0
				tCode = Split( tItemHistory[0], "@" )
				grdExstCode.SetCellData( "bd_code" , 0 , tCode[1] )
				grdExstCode.SetCellData( "bd_exch" , 0 , f_getExchCode2(tCode[0]) )
				grdExstCode.SetCellData( "bd_name" , 0 , tItemHistory[1] )
				grdExstCode.SetCellData( "bd_memo" , 0 , "" )

				if #tItemHistory >= 3 then
					grdExstCode.SetCellData( "bd_type", 0, tItemHistory[2] )
				end if
			end if
		end if
	Next
	
	szCmbIdx = Form.LoadConfigData("RECENTITEM", "EXST_COMBOIDX")
	if szCmbIdx = "" then
		szCmbIdx = "0" 
	end if
	cmbRecentGroup.currentindex = szCmbIdx
	
	' 관심종목 데이터조회
	DATAMANAGER.RequestTranData( "ohhts_6000_012r" )

End Sub

'============================================================================
' Change_EtcMarket :  해외지수(대표, 업종지수)/ 채권의 마켓구분 변경
'============================================================================
Function Change_EtcMarket(szData)
	if Trim(szData) == "UJ" then
		return "N"
	elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		return "B"
	end if	
	
	return szData
End Function

'============================================================================
' Save_grdMk : 실시간을 위해 중복되지 않는 시장구분을 저장해둔다.
'============================================================================
Function Save_grdMk()
	grdMk.rowcount = 0
	
	For i = 0 to grdCode.rowcount-1
	
		szMk = Trim(grdCode.GetCellData("bd_mk", i))
		szCd = Trim(grdCode.GetCellData("bd_code", i))
		
		' MTS에서 보여주는 상품의 종목만 선택
		szMk =  f_ChkMarket(szMk, szCd)
		
		if szMk <> "" then
			nRow2 = CInt(grdMk.rowcount)
	
			if nRow2 == 0 then
				grdMk.insertrow = 0
				grdMk.SetCellData("bd_mk", 0, szMk)
				grdMk.SetCellData("bd_code", 0, szCd)
			end if
	
			For j = 0 to nRow2 - 1
				szMk2 = Trim(grdMk.GetCellData("bd_mk", j))
				
				if szMk == szMk2 then		
					szCd2 = grdMk.GetCellData("bd_code", j) & "★" & szCd
					grdMk.SetCellData("bd_code", j, szCd2)
					
					Exit For
				end if
				
				if j == nRow2 - 1 then
					grdMk.insertrow = 0
					grdMk.SetCellData("bd_mk", 0, szMk)
					grdMk.SetCellData("bd_code", 0, szCd)
				end if
			Next		
		end if
	Next

	' 관심종목 데이터조회
	DATAMANAGER.RequestTranData( "ohhts_1020_004r" )
End Function
'============================================================================
' 20190214 HWG START : 해외파생 최근조회종목 추가
'============================================================================
' Save_grdGlobalMk : 실시간을 위해 중복되지 않는 시장구분을 저장해둔다.
'============================================================================
Function Save_grdGlobalMk()
	Dim szExch, szCode
	Dim szExch2, szCode2
	grdGlobalMk.rowcount = 0
	
	For i = 0 to grdGlobalCode.rowcount-1
	
		szExch = Trim(grdGlobalCode.GetCellData("bd_exch", i))
		szCode = Trim(grdGlobalCode.GetCellData("bd_code", i))
		
		if szExch <> "" then
			nRow2 = CInt(grdGlobalMk.rowcount)
	
			if nRow2 == 0 then
				grdGlobalMk.insertrow = 0
				grdGlobalMk.SetCellData("bd_exch", 0, szExch)
				grdGlobalMk.SetCellData("bd_code", 0, szCode)
			end if
	
			For j = 0 to nRow2 - 1
				szExch2 = Trim(grdGlobalMk.GetCellData("bd_exch", j))
				
				if szExch == szExch2 then		
					szCode2 = grdGlobalMk.GetCellData("bd_code", j) & "★" & szCode
					grdGlobalMk.SetCellData("bd_code", j, szCode2)
					
					Exit For
				end if
				
				if j == nRow2 - 1 then
					grdGlobalMk.insertrow = 0
					grdGlobalMk.SetCellData("bd_exch", 0, szExch)
					grdGlobalMk.SetCellData("bd_code", 0, szCode)
				end if
			Next		
		end if
	Next

	if CInt(grdGlobalCode.rowcount) > 0 then
'		grdList0.height = 432
'		grdList0.top = 58
'		
'		btnNext.visible = True
'		btnPrev.visible = True
'		cmbRecentGroup.visible = True
'		
'		grdGlobalList.visible = False
'		grdGlobalList.left = 0
'		grdGlobalList.top = 58
'		grdGlobalList.height = 432
		
		szCmbIdx = Form.LoadConfigData("RECENTITEM", "EXST_COMBOIDX")
		if szCmbIdx = "" then
			szCmbIdx = "0" 
		end if
		cmbRecentGroup.currentindex = szCmbIdx
		
		' 관심종목 데이터조회
		DATAMANAGER.RequestTranData( "ohhts_6500_002r" )
	else
'		btnNext.visible = False
'		btnPrev.visible = False
'		cmbRecentGroup.visible = False
'		
'		grdGlobalList.visible = False
'		grdList0.height = 490
	end if
End Function
' 20190214 HWG END

'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	Select Case szMk
		Case "J", "Q", "F", "MF", "XF", "O", "MO", "QO", "U", "T", "W", "B", "P", "EN", "EMPTY", "JF", "JO", "WO", "KF"  ' 20180103 HAMWG : 주식선옵종목 추가	'20190809_01 HWG : 위클리옵션추가	' 20240412 HSZ: 코스닥글로벌지수 추가
			return szMk
		Case "N"			' 해외지수, 환율은 같은 시장구분으로 내려오기에 분리시켜야 한다.
			If InStr(szCd, "@") == 0 then
				return "EN"
			else
				return szMk
			end if
		Case Else
			return ""
	End Select
End Function

'============================================================================
' Change_Len
'============================================================================
Function Change_Len(szData)
	if Len(szData) == 1 then
		Change_Len = "0" & CStr(szData)
	else
		Change_Len = CStr(szData)
	end if 
End Function


