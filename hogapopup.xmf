	<SCRIPT_INFO _len="6827" _ulen="6643" >

Dim g_szCode, g_szMarket, g_nSelectRow, g_PrePrc

'============================================================================
Function f_SetPrice_UI(nRow, szState)
	dim nSelectPrc, nSelectRate
	dim szColorValue
	nSelectPrc = CInt(hogaTbl.GetCellString( nRow, 2 ))
	
	if nSelectPrc > 0 then
		if nSelectPrc-g_PrePrc == 0 then
			nSelectRate = 0
		else
			nSelectRate = CDbl(FormatNumber(((nSelectPrc-g_PrePrc)/g_PrePrc) * 100 , 2))
		end if
		
		if nSelectRate > 0 then
			szColorValue = "10"
		elseif nSelectRate < 0 then
			szColorValue = "11"
		else
			szColorValue = "12"
		end if
		
		'20230420 KKM : 현재가열 색상컬러 변경 START		
		lblLine.SetCellString( 1, 1, nSelectPrc )
		lblLine.SetCellFgColor( 1, 1, szColorValue )
		
		lblLine.SetCellString(1, 2, nSelectRate )
		'20230420 KKM : 현재가열 색상컬러 변경 END		
		
		dim sStr, sFontColor
		
		if nRow < 10 then
			sStr = "매도 " & 10-nRow & "호가"
			sFontColor = "11"
		else
			sStr = "매수 " & nRow-9 & "호가"
			sFontColor = "10"
		end if

		lblLine.SetCellString(0, 1, sStr ) '20230420 KKM : 현재가열 색상컬러 변경
	'	lblLine.SetCellFgColor( 0, 1, sFontColor )
	else
		if szState == "UP" then
			g_nSelectRow = nRow + 1
		elseif szState == "DOWN" then
			g_nSelectRow = nRow - 1
		end if
	end if
	
End Function

'============================================================================
Function SendOrder( szTab, szPrice )
	Dim szData, nPrice
	if Trim(szPrice) = "" then
		nPrice = lblLine.GetCellString(1, 1)
	else
		nPrice = szPrice
	end if 
	
	'20210823 HSZ START : CFD현재가 화면 추가 
	szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
	if szScreenNo = "13100" then	
		' 전달내용/탭위치/종목코드/가격
		szData = "현재가" & "★" & szTab & "★" & g_szCode & "★" & nPrice
'		
		Form.OpenScreen( "13200" , szData )
		Form.CloseForm()
		exit Function 
	end if
	'20210823 HSZ END

	' 전달내용/탭위치/종목코드/가격
	szData = "현재가" & "★" & szTab & "★" & g_szCode & "★" & nPrice
	
	Form.OpenScreen( "12000" , szData )
	Form.CloseForm()
End Function

'============================================================================
Function f_RequestRealTran()
	If g_szMarket = "W" Then
			DATAMANAGER.RequestRealData( "ohhts_elw_aspr" )
			DATAMANAGER.RequestRealData( "ohhts_elw_cntg" )
			
	'20180712 HAMWG START : K-OTC MTS 도입
	ElseIf g_szMarket = "T" Then
		DATAMANAGER.RequestRealData( "ohhts_frbr_aspr" )
		DATAMANAGER.RequestRealData( "ohhts_frbr_cntg" )
	'20180712 HAMWG END
	
	Else
		DATAMANAGER.RequestRealData( "ohhts_stck_aspr" )
		DATAMANAGER.RequestRealData( "ohhts_stck_cntg" )
	End If
	
End Function
'============================================================================
Sub Form_OnFormInit()
	szOpen = Form.GetOpenLinkData()
	
	if szOpen <> "" and szOpen <> null then
		Dim tHogaData
		tHogaData = Split(szOpen,"★" )
		'nTop = hogaData(0)
		'btnSell.top = nTop
		'btnBuy.top  = nTop
		'lblLine.top  = nTop
		'lblLine.SetCellString(0, 0, hogaData(1))
		'lblLine.SetCellString(0, 1, hogaData(2))
		 
		g_nSelectRow = CInt(tHogaData(0))
		g_szCode = tHogaData(1)
		g_szMarket = tHogaData(2)
		DATAMANAGER.RequestTranData( "ohhts_1001_005r" )
	end if
End Sub

'============================================================================
'Sub Form_OnLinkData(sKey, sValue)
'	if sKey = "hogapopup" then
'		Form.ShowAlert("sValue", sValue)
'	end if
'End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "ohhts_1001_005r" then
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarket )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1", "FID_INPUT_ISCD", 0, g_szCode )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_1001_005r" then
		g_PrePrc = CInt(DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1", "FID_SDPR", 0 ))
		
		f_SetPrice_UI(g_nSelectRow, "")
		f_RequestRealTran()
		
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if szTranID == "ohhts_elw_aspr" or szTranID == "ohhts_elw_cntg" 
		or szTranID == "ohhts_frbr_aspr" or szTranID == "ohhts_stck_aspr"  then
		
		DATAMANAGER.SetDataValue( 1, szTranID ,"InBlock1", "FIDR_SHRN_ISCD", 0, g_szCode )
	
	elseif szTranID == "ohhts_frbr_cntg" or szTranID == "ohhts_stck_cntg" then
		DATAMANAGER.SetDataValue( 1, szTranID ,"InBlock1", "RLTM_SHRN_ISCD", 0, g_szCode )
	end if
End Sub

'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData( "ohhts_stck_aspr" )
	DATAMANAGER.CancelRealData( "ohhts_elw_aspr"  )
	DATAMANAGER.CancelRealData( "ohhts_frbr_aspr" )
	DATAMANAGER.CancelRealData( "ohhts_stck_cntg" )
	DATAMANAGER.CancelRealData( "ohhts_elw_cntg"  )
	DATAMANAGER.CancelRealData( "ohhts_frbr_cntg" )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	f_SetPrice_UI(g_nSelectRow, "")
End Sub

'============================================================================
Sub btnUp_OnClick()
	g_nSelectRow = g_nSelectRow - 1
	
	if g_nSelectRow < 0 then
		g_nSelectRow = 0
	end if
	
	
	f_SetPrice_UI(g_nSelectRow, "UP")
End Sub

'============================================================================
Sub btnDown_OnClick()
	g_nSelectRow = g_nSelectRow + 1
	
	if g_nSelectRow > 19 then
		g_nSelectRow = 19
	end if
	
	f_SetPrice_UI(g_nSelectRow, "DOWN")
End Sub

'============================================================================
Sub Label0_OnClick()
	call btnUp_OnClick()
End Sub

'============================================================================
Sub Label1_OnClick()
	call btnDown_OnClick()
End Sub

'============================================================================
Sub btnMado_OnClick()
	nPrice= lblLine.GetCellString(1, 1)
	Form.SetSharedData("HYUN_RETURN" , nPrice)
	SendOrder( "1", nPrice )
End Sub

'============================================================================
Sub btnMasu_OnClick()
	nPrice= lblLine.GetCellString(1, 1)
	Form.SetSharedData("HYUN_RETURN" , nPrice)
	SendOrder( "0", nPrice )
End Sub

'============================================================================
'20230414 KKM : 위아래이미지
Sub Form_OnFormInitBefore()
	btnUp.SetMaintainingRatio("1")
	btnDown.SetMaintainingRatio("1")	
End Sub

