End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "oblon_basc_212r" then
		Dim szCode, szMarket
		
		szCode	= f_GetInputItemCodeValue()	'종목코드(빈값이면 %로 SET)
		szMarket	= f_GetInputMarketValue() 	'%:전체 1:코스피 2:코스닥
		
		DATAMANAGER.ClearInputData( 0, szTranID )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ISCD"				, 0, szCode 	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOAN_ISSU_GR_CODE"	, 0, "%" 	)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "MRKT_CLS_CODE"		, 0, szMarket )
		
		g_szGridTran = szTranID
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "oblon_basc_212r" then
		Dim nGrdRowCnt, nDataCnt, nRowIdx
		nDataCnt = CInt(DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1"))
		nGrdRowCnt = CInt(grd0.rowcount)
		nRowIdx = nGrdRowCnt - nDataCnt
		
		if nDataCnt > 0 then
			Dim sLimitType, sLoanGrade '한도초과여부, 대주등급
			
			for i=0 to nDataCnt-1
				sLimitType = Trim(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "LIMT_SS_ALSN_YN"	, i)) 'Y / N
				sLoanGrade = Trim(DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1", "LOAN_ISSU_GR_CODE"	, i)) '0111 : A군 / 0112 : B군
				
				'한도초과여부가 Y이면 "한도초과"로 서비스 아웃풋 "LIMT_SS_ALSN_YN"의 값 변경
				if sLimitType == "Y" then
					grd0.SetCellData( "bd_over", i+nRowIdx, "한도초과")
					grd0.SetCellFgColor( "bd_over", i+nRowIdx, "10" )
				end if
				
				'0111 : A군 / 0112 : B군
				if sLoanGrade == "0111" then
					grd0.SetCellData( "bd_grade", i+nRowIdx, "A군")
				elseif sLoanGrade == "0112" then
					grd0.SetCellData( "bd_grade", i+nRowIdx, "B군")
				end if
			next
		end if
	end if
End Sub

'============================================================================
Sub ItemCode0_OnEditComplete(sCode)
'	rdoMarket.currentindex = "0"
	g_isEmpty_Code = false
	
	f_RequestTranData()
End Sub

'============================================================================
Sub rdoMarket_OnClick(nIndex)
	f_SetEmptyCode()
	f_RequestTranData()
End Sub

'============================================================================
Sub grd0_OnScrollEnd()
	DATAMANAGER.RequestNextData( g_szGridTran )
	
End Sub

'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)
	Dim szSelectCode
	szSelectCode = Trim(grd0.GetCellData("bd_code", lRow))
	
	f_ReturnPopupData(szSelectCode)
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REUPDATE" then
		if sRet == "ok" then
			Form.reUpdateFile("mts_master.crc")
		else
			exit sub
		end if
	end if
End Sub






