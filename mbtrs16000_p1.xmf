--===========================================================================
--===========================================================================
Dim g_isEmpty_Code
Dim g_szGridTran
'============================================================================
Function f_SetEmptyCode()
	ItemCode0.code = "empty"
	g_isEmpty_Code = true
End Function

'============================================================================
Function f_GetInputMarketValue()
	Dim nIdx
	nIdx = CInt(rdoMarket.currentindex)
	
	if nIdx == 1 then '1:KOSPI
		return "STK"
	elseif nIdx == 2 then '2:KOSDAQ
		return "KSQ"
	else 'ALL
		return "%" 
	end if
End Function 

'============================================================================
Function f_GetInputItemCodeValue()
	if g_isEmpty_Code then
		return "%"
	else
		dim szCode
		szCode = ItemCode0.code
		
		return "A" & szCode
	end if
	
End Function 

'============================================================================
Function f_ReturnPopupData(szCode)
	Dim errmsg, szMk, szCutCd
	
	errmsg = "종목마스터의 오류로 주문 및 시세 조회가 불가능합니다. 동일 증상 반복 시 확인 버튼을 눌러 주시기 바랍니다.\n\n ※기타문의사항은 고객지원센터 (1588-3400)로 문의하여 주시기 바랍니다."

	if szCode <> null and szCode <> "" then
		if(left(szCode,1) == "J" and len(szCode) == 9) or left(szCode,1) == "Q" or left(szCode,1) == "F" then
			szMk = Form.GetItemCodeInfo(szCode, "market")
			
		else
			szCutCd = Mid(szCode,2,len(szCode))
			szMk = Form.GetItemCodeInfo(szCutCd, "market")
		end if
		
		if Trim(szMk) == "J" or Trim(szMk) == "Q" or Trim(szMk) == "W" or Trim(szMk) == "T" then
			Form.SendReturnToParent("16000_OPEN_ABLEITEM_RETURN" , szCode)
			Form.CloseForm()
		else
			Form.MsgBox("알림", errmsg, "REUPDATE", 1)		
		end if
	end if
	
End Function

'============================================================================
Function f_RequestTranData()
	DATAMANAGER.RequestTranData("oblon_basc_212r")
End Function

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("대주 가능종목")
	f_SetEmptyCode()
	f_RequestTranData()
	
	'TEST DATA
'	grd0.AddRow( )
