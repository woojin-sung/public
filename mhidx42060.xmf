	<SCRIPT_INFO _len="6936" _ulen="6710" >
Dim g_szCd, g_szCdName
Dim g_szTitle
Dim g_Row
Dim g_szUnasName, g_szUnasCode

'3년국채:BM3 5년국채:BM5 10년국채:MBA
'미국달러:USD 엔:JPY 유로:EUR 위안:CNH
'돈육:LHG, 금:KGD

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_3083_001r" then
		
		g_szCd = Grid0.GetCellData("bd_cell0", g_Row)
		
		'20170905 NOHES START
		g_szUnasName = Grid0.GetCellData("bd_cell12", g_Row)
		g_szTitle = Mid(g_szUnasName, 5, Form.GetByteLength( g_szUnasName )-1)
		g_szUnasCode = Left(g_szUnasName, 3)
		
		g_szTitle = Replace(g_szTitle, "(", "")			
		g_szTitle = Replace(g_szTitle, ")", "")
		
		g_szCdName = Grid0.GetCellData("bd_cell1", g_Row)
		Button0.caption = g_szCdName & "    현재가 "
		'20170905 NOHES END
		
		'차트데이터
		DATAMANAGER.RequestTranData("ohhts_3081_006r")
				
	elseif szTranID = "ohhts_3081_006r" then
		
		'돈육, 금은 정수 처리
		'20170905 NOHES 돈육:LHG, 금:KGD
		if g_szUnasCode <> "LHG" and g_szUnasCode <> "KGD" then
			ChartEx0.setDecimal("2")
			ChartEx0.SetPriceFormat(g_szTitle&"^10^2")
		
		else
			ChartEx0.setDecimal("0")
		end if
		
		Form.SetSharedData("42060_index" , g_Row)	'20170905 NOHES		
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "ohhts_3083_001r" then
		' 2022.11.16 jipark 목록조회는 CF로 조회해야 수신되는듯
		DATAMANAGER.SetDataValue(0, "ohhts_3083_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "CF")
		DATAMANAGER.SetDataValue(0, "ohhts_3083_001r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE" , 0 , "3083")
	
	elseif szTranID == "ohhts_3081_006r" then
		ChartEx0.SetAccrueName(g_szTitle)
		szMarket = Form.GetItemCodeInfo(g_szCd, "market")

		DATAMANAGER.SetDataValue(0, "ohhts_3081_006r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , szMarket)
		DATAMANAGER.SetDataValue(0, "ohhts_3081_006r", "InBlock1", "FID_INPUT_ISCD" , 0 , g_szCd)
	end if
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	'20170905 NOHES START
	sIndex = Form.GetSharedData("42060_index", False )
	if sIndex == "" or sIndex == 0 then
		g_Row = 0
	else
		g_Row = sIndex
	end if
	'20170905 NOHES END
	
	ChartEx0.setDecimal("2")
	ChartEx0.setViewDataCount(-1)
	
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	
	
	g_szCd = Grid0.GetCellData("bd_cell0", lRow)
	g_Row = lRow
	'20170905 NOHES START 
	g_szUnasName = Grid0.GetCellData("bd_cell12", lRow)
	g_szTitle = Mid(g_szUnasName, 5, Form.GetByteLength( g_szUnasName)-1)
	g_szUnasCode = Left(g_szUnasName, 3)
	
	g_szTitle = Replace(g_szTitle, "(", "")	
	g_szTitle = Replace(g_szTitle, ")", "")
	
	if g_szUnasCode <> "LHG" and g_szUnasCode <> "KGD" then
		ChartEx0.setDecimal("2")
		ChartEx0.SetPriceFormat(g_szTitle&"^10^2")
		
	else
		ChartEx0.setDecimal("0")
	end if
	
	DATAMANAGER.RequestTranData("ohhts_3081_006r")
	
	'상품선물 현재가 팝업 연동
	g_szCdName = Grid0.GetCellData("bd_cell1", lRow) 
	Button0.caption = g_szCdName & "    현재가 "
	'20170905 NOHES END
End Sub

'============================================================================
Sub Form_OnFormInitBefore()

	ChartEx0.SetPeriodType(2)			'0:틱, 1:분, 2:일자
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveRealData(szTranID)
	if szTranID == "ohhts_cfut_cntg" then
	
		szCd = DATAMANAGER.GetDataValue(1, "ohhts_cfut_cntg", "OutBlock1", "FIDR_SHRN_ISCD" , 0)
		
		if szCd == g_szCd then
			szTime = DATAMANAGER.GetDataValue( 1, "ohhts_cfut_cntg", "OutBlock1", "FIDR_BSOP_HOUR" , 0 )
			szData = DATAMANAGER.GetDataValue( 1, "ohhts_cfut_cntg", "OutBlock1", "FIDR_PRPR2" , 0 )
		
		
			ChartEx0.setInvestorRealData(g_szTitle&"="&szTime&";"&szData)
		end if
		
	end if
		
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if	sEventName	=	"SCREEN_MENU"		then
		If sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns1" , "0", "")
		End If
	end	if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		
		End If
		
	end if 
End Sub

'============================================================================
Sub Button0_OnClick()
	s_gubn = 2
	
	g_szUnasName = Grid0.GetCellData("bd_cell12", g_Row)
	g_szUnasCode = Left(g_szUnasName, 3)
	
'3년국채:BM3 5년국채:BM5 10년국채:MBA
'미국달러:USD 엔:JPY 유로:EUR 위안:CNH
'돈육:LHG, 금:KGD
's_gubn : 소숫점 자리수만큼 제공.
	If g_szUnasCode == "USD" or g_szUnasCode == "JPY" or g_szUnasCode == "EUR" or g_szUnasCode == "CNH" Then
		s_gubn = 1
	elseif g_szUnasCode == "BM3" or g_szUnasCode == "BM5" or g_szUnasCode == "MBA" Then
		s_gubn = 2
	elseif g_szUnasCode == "LHG" or g_szUnasCode == "KGD" Then
		s_gubn = 0
	End If
	
	Form.OpenFramePopup("mhprc42070" , g_szCd&"★"&g_szCdName&"★"&s_gubn , "")
End Sub


'============================================================================
Sub Form_OnRefresh()
	DATAMANAGER.RequestTranData("ohhts_3083_001r")
End Sub

