<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="82010" scrname="약관동의_서브S" version="2" writer="이아영" />
	<FORM_INFO name="Form" ly_vert="0,0,335,489,1" />
	<CONTROL_INFO>
		<WEBVIEW name="WebView0" urlpath="about:blank" ly_vert="0,0,335,489,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="250" _ulen="250" >
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "InitData" then
		if trim(sParam) ~= "" then
			WebView0.urlpath = sParam
	
		end if
	end if 
End Sub

	</SCRIPT_INFO>
</ROOT>