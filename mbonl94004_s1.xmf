	<SCRIPT_INFO _len="18223" _ulen="16939" >
'--===========================================================================
' 01. 화 면 명 : 지정심사신청
' 02. 화면설명 : 자격요건확인
' 03. 작    성 : 
' 04. 수    정 : 
' 2022.04.14 : v0001 : KSJ : 신분증 등록 및 진위확인 개선
'--===========================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAplyDate, g_szAplyNum, g_szPrgsCode
Dim g_szSRNO '신분증 진위 확인 후, 받은 일련번호

Dim g_OSType

' 21.07.02 JHY : 컴플리트랑 같이 스크롤포스 조절되서 안먹도록 하기 위해 현재 포커싱 에디트와 이전 포커싱 에디트 비교하여 왓다갓다 하지 않도록 수정
Dim g_szCurKeyPad 
Dim g_szPreKeyPad

'v0001 STA
Dim g_szCnshIsncYN		'1년이상거래계좌 관련서류등록여부	
Dim g_szRmndCertIsncYN		'투자경럼 서류등록여부

Dim g_szAVRG_RMND_AMT
Dim g_szOTCO_INPUT_CSNU

Dim unPressedImgPath 
Dim PressedImgPath
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' f_ChangeBtnState() : 입력 조건 확인 후, 버튼 활성/비활성
'============================================================================
Function f_ChangeBtnState()
	Dim isAble
	
	isAble = true

	'v0001 STA
	if (Container0.edtPswd.caption == "" or Container0.edtPswd.caption == null or Container0.edtPswd.pwdlen <> 4) then
		isAble = false
	end if
	
	if g_szPrgsCode <> "" and g_szPrgsCode <> null then
		if g_szPrgsCode == "0" then
			if isAble == true then
				Form.triggerEvent("#", "BTN_NEXT_ENABLE_STATE", true)
			
			else
				Form.triggerEvent("#", "BTN_NEXT_ENABLE_STATE", false)
			end if
	
		else
			Form.triggerEvent("#", "BTN_NEXT_ENABLE_STATE", false)
			
		end if
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
	Container0.imgToolTip.setMaintainingRatio("1")
	Container0.imgToolTip2.setMaintainingRatio("1")	
	
	Container0.imgProcess.setMaintainingRatio("1")
End Sub

'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()			
	Dim szTheme
	szTheme = Form.GetEnvData("common.theme")

'	if szTheme == "white" then
'		Container0.imgProcess.imgpath = "icon_1stepthird_w"
'	else
'		Container0.imgProcess.imgpath = "icon_1stepthird_b"
'	end if

	Form.SetSharedData("124a_Aplt_Srno", "")	'신청일련번호 초기화
				
				
	g_OSType	= Form.GetSharedData("&OS_TYPE", false)
	
	'g_PlainRm
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", FALSE ) 'v005
	
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	
	
	'계좌번호 입력전 화면 초기화
	Container0_acnt0_ChangeAccount()
End Sub

'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "change_step2" then
		Form.SetSharedData("94004_S1_AcntPwd", Container0.edtPswd.caption)
	elseif sEventName == "PREV_STEP" then
		if sParam = "mbonl94004_s1" then
			g_plain_rm = Form.GetSharedData("&PLAIN_RM", FALSE )
			
			Container0.edtPswd.pwdlen = 4
			Container0.edtPswd.caption = Form.GetSharedData("94004_S1_AcntPwd")
	
			if Container0.edtPswd.caption ~= null then
				DATAMANAGER.RequestTranData( "obacp_opop_066r" ) '비밀번호검증
			end if
		end if
	end if
End Sub

'============================================================================
' Form_OnPopupReturn(sKeyName, sRet)
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "close_mbonl94004_p2" then
		Form.triggerEvent("#", "COMPLETE_SUBMIT", "")
	
	elseif sKeyName == "close_mbonl94004_p11" Then
		DATAMANAGER.SetDataValue( false, "obcsb_acif_123r" , "InBlock1" , "APLT_SRNO" , 0 , g_szAplyNum  )
		DATAMANAGER.RequestTranData( "obcsb_acif_123r" )
	
	elseif sKeyName = "CORRECT_PWD" then	'계좌비번 수신
		if sRet <> "" then
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				Container0.edtPswd.pwdlen = tData(1)
				Container0.edtPswd.caption = tData(0)
				
				DATAMANAGER.RequestTranData( "obacp_opop_066r" ) '비밀번호검증
			end if
			
		end if
	End If
	
End Sub

''****************************************************************************
''               		D A T A				M A N A G E R               
''****************************************************************************

'============================================================================
' DATAMANAGER_OnSendTranBefore(szTranID) : 인풋데이터 세팅
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szCustNum, szHostDate, szAccount
	
	szCustNum = Form.GetSharedData("&CUST_NUM", false )
	szHostDate = Form.GetSharedData("&HOST_DATE",0)
	szAccount = left(Container0.acnt0.caption,8)
	
	Dim sACNT_PWD
	'v0004
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
	    sACNT_PWD = Container0.edtPswd.caption
	else  'MTS메모리평문 미적용상태일때
	    sACNT_PWD = Form.GetEncData(Container0.edtPswd.caption)
	end if
	
		
	if szTranID == "obacp_opop_066r" then
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "ACNO" , 0 , szAccount )
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "ACNT_PWD" , 0 , sACNT_PWD )
		
	elseif szTranID == "obcsb_acif_123r" then
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "IQRY_CLS_CODE" , 0 , "1"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ACNO" , 0 , szAccount )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0 , szCustNum  )
	
	elseif szTranID == "obcsb_acif_124a" then	'장외파생투자요건 등록
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ACNO" , 0 , szAccount )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" , 0 , szCustNum  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "INVE_APLT_STCD" , 0 , "T"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "VCALL_TRGT_YN" , 0 , Form.GetSharedData( "mbonl94004_VCALL_TRGT_YN") )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "APLT_DATE" , 0 , szHostDate  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CONT_CLS_CODE" , 0 , "4"  )
		
	'v0001 STA
	elseif szTranID == "obcsb_acif_127r" then
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "CSNO" 	 , 0 , szCustNum    )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "INVT_EXPC_CLCD"	 , 0 , "1" )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "APLT_SRNO"	 , 0 , g_szAplyNum  )	
	'v0001 FIN
	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 들어왔을때
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obacp_opop_066r" then
		if Container0.edtPswd.caption ~= null then
			'20220523 LJH 센터 표기를 계좌비밀번호 입력 시점으로 변경
			Dim szBrcd
			szBrcd = Form.GetAccountInfo( Container0.acnt0.caption, "branchcode")
			Container0.lblbrNm.caption = "접수센터 : " .. Form.GetMetaData( "부서코드", szBrcd )
		
			DATAMANAGER.RequestTranData( "obcsb_acif_124a" ) '5s
'			DATAMANAGER.RequestTranData( "obcsb_acif_123r" ) '5s
		end if
	
	elseif szTranID == "obcsb_acif_123r" then
		g_szAplyDate = ""
		g_szAplyNum = ""
		g_szPrgsCode = ""
		g_szAVRG_RMND_AMT = 0
		g_szOTCO_INPUT_CSNU = 0
		szPRSN_PFIN_YN = ""
		
		szPFIN_RGNO = ""
		szDSGT_DATE = ""
		szVALD_STA_DATE = ""
		szVALD_FIN_DATE = ""
		
		g_szAplyDate  		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "APLT_DATE" , 0  ) '신청일자
		g_szAplyNum  			= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "APLT_SRNO" , 0  ) '신청일련번호
		Form.SetSharedData("124a_Aplt_Srno" , g_szAplyNum)
		
		g_szPrgsCode  		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "INVE_APLT_STCD" , 0  ) '투자셩험신청상태코드
		g_szAVRG_RMND_AMT  	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "AVRG_RMND_AMT" , 0  ) '평균잔고금액
		g_szOTCO_INPUT_CSNU  	= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "OTCO_INPUT_CSNU" , 0  ) '타사입력건수		
		szPRSN_PFIN_YN 		= DATAMANAGER.GetDataValue( false, szTranID , "OutBlock1" , "PRSN_PFIN_YN" , 0  ) 	'개인전문투자자여부
		
		szPFIN_RGNO 		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "PFIN_RGNO" , 0  ) 	'전문투자자등록번호
		szDSGT_DATE 		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "DSGT_DATE" , 0  ) 	'지정일자
		szVALD_STA_DATE_2 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "VALD_STA_DATE" , 0  ) 
		szVALD_FIN_DATE_2 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock2" , "VALD_FIN_DATE" , 0  ) 
		
		szREG_DATE 		= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock3" , "REG_DATE" , 0  ) 
		szVALD_STA_DATE 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock3" , "VALD_STA_DATE" , 0  ) 
		szVALD_FIN_DATE 	= DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock3" , "VALD_FIN_DATE" , 0  ) 

		
		'등록현황
		if szPRSN_PFIN_YN = "Y" then	'전문투자자등록번호
			
			Container0.lblNoData.visible = false
			
			Container0.Label0.visible = true
			Container0.Label1.visible = true
			Container0.Label2.visible = true
			
			Container0.lblRegNo.visible = true
			Container0.lblRegData.visible = true
			Container0.lblValdDate.visible = true
			
			Container0.lblRegNo.caption = szPFIN_RGNO	'전문투자자 지정번호
			if szREG_DATE <> "" and szREG_DATE <> "NULL" then
				Container0.lblRegData.caption = szREG_DATE	'지정일자 = 등록일자는 동일한거.. 
			elseif szDSGT_DATE <> "" and szDSGT_DATE <> "NULL" then
				Container0.lblRegData.caption = szDSGT_DATE
			else
				Container0.lblRegData.caption = "-"
			end if
	
			if (szVALD_FIN_DATE <> "" and szVALD_FIN_DATE <> "NULL") then
				szVALD_STA_DATE = Left(szVALD_STA_DATE,4) .. "." .. Mid(szVALD_STA_DATE,5,2) .. "." .. Right(szVALD_STA_DATE,2)
				szVALD_FIN_DATE = Left(szVALD_FIN_DATE,4) .. "." .. Mid(szVALD_FIN_DATE,5,2) .. "." .. Right(szVALD_FIN_DATE,2)
				Container0.lblValdDate.caption = szVALD_STA_DATE .. " ~ " .. szVALD_FIN_DATE 	'유효기간
			elseif (szVALD_FIN_DATE_2 <> "" and szVALD_FIN_DATE_2 <> "NULL") then
				szVALD_STA_DATE_2 = Left(szVALD_STA_DATE_2,4) .. "." .. Mid(szVALD_STA_DATE_2,5,2) .. "." .. Right(szVALD_STA_DATE_2,2)
				szVALD_FIN_DATE_2 = Left(szVALD_FIN_DATE_2,4) .. "." .. Mid(szVALD_FIN_DATE_2,5,2) .. "." .. Right(szVALD_FIN_DATE_2,2)
				Container0.lblValdDate.caption = szVALD_STA_DATE_2 .. " ~ " .. szVALD_FIN_DATE_2 	'유효기간			
			else
				Container0.lblValdDate.caption = "-"
			end if
			
		else
			
			Container0.lblNoData.visible = true
			
			Container0.Label0.visible = false
			Container0.Label1.visible = false
			Container0.Label2.visible = false
			
			Container0.lblRegNo.visible = false
			Container0.lblRegData.visible = false
			Container0.lblValdDate.visible = false
		
		end if
		
		'당사 투자경험 요건 확인
		if tonumber(g_szAVRG_RMND_AMT) <> NULL then
			if tonumber(g_szAVRG_RMND_AMT) >= 300000000 then
				Container0.lblOnCoSfcnYN.caption = "충족"
				Container0.lblOnCoSfcnYN.fgcolor = "2"
				Container0.lblOnCoAmt.caption = g_szAVRG_RMND_AMT
				
'				Container0.btnInvReg.btnimage = "btn_02.9"
				Container0.btnInvReg.enable = false
				
				Form.triggerEvent("#", "BTN_NEXT_ENABLE_STATE", true)
			else
				Container0.lblOnCoSfcnYN.caption = "미충족"
				Container0.lblOnCoSfcnYN.fgcolor = "6"
				Container0.lblOnCoAmt.caption = g_szAVRG_RMND_AMT
				
'				Container0.btnInvReg.btnimage = "btn_05.9"
				Container0.btnInvReg.enable = true
			end if
			
		else
			Container0.lblOnCoSfcnYN.caption = "미충족"
			Container0.lblOnCoAmt.caption = g_szAVRG_RMND_AMT
						
'			Container0.btnInvReg.btnimage = "btn_05.9"
			Container0.btnInvReg.enable = true

		end if
		
		'타사 투자경험 요건 확인
		Container0.lblOtCoCnt.caption = g_szOTCO_INPUT_CSNU
		if g_szOTCO_INPUT_CSNU = 0 then
			Container0.lblOtCoCnt.fgcolor = "146"
		else
			Container0.lblOtCoCnt.fgcolor = "4"
		end if		
		
		'전문투자자 서류등록내역
		DATAMANAGER.RequestTranData( "obcsb_acif_127r" )		
		
	elseif szTranID == "obcsb_acif_127r" then
		g_szRmndCertIsncYN = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "RMND_CERT_ISNC_YN" , 0  )	'투자경험 서류등록여부
		
		Dim nCnt
		nCnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock2" ))

		if g_szRmndCertIsncYN = "Y" and (nCnt > 0) then

			Container0.lblOtCoCnt.caption = nCnt
			if Cint(nCnt) = 0 then
				Container0.lblOtCoCnt.fgcolor = "146"
			else
				Container0.lblOtCoCnt.fgcolor = "4"
			end if
			Container0.btnInvReg.caption = "등록 완료"	'등록완료여도 파일 업로드 가능하도록 수정. (박효정과장 요청)
			
			Form.triggerEvent("#", "BTN_NEXT_ENABLE_STATE", true)
		end if
		
	
	elseif szTranID == "obcsb_acif_124a" then
		g_szAplyNum = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "APLT_SRNO" , 0  )		'신청일련번호
		Form.SetSharedData("124a_Aplt_Srno" , g_szAplyNum)
		
		DATAMANAGER.RequestTranData( "obcsb_acif_123r" ) '5s
'		If g_szAplyNum <> "" and g_szAplyNum <> null Then '5s
'			Form.OpenPopup("mbonl94004_p11", g_szAplyNum.."★" , "") '5s
'		End If '5s
		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg) : 데이터 통신 오류
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)

	if szTranID == "obcsb_acif_123r" then
		Dim szErrorMsg
		szErrorMsg = szErrMsg & "(" & szSubMsg & ")\n업무신청을 중단하시겠습니까?"
		
		Form.OpenPopup("mbonl94004_p3" , szErrorMsg , "")
	
	elseif szTranID == "obacp_opop_066r" then
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
		
	else
		Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	end if
End Sub



'============================================================================
' Container0_acnt0_ChangeAccount() : 계좌변경 'v0001
'============================================================================
Sub Container0_acnt0_ChangeAccount()
	
	Container0.edtPswd.caption = ""
	
	Container0.lblNoData.visible = false
	
	Container0.Label0.visible = true
	Container0.Label1.visible = true
	Container0.Label2.visible = true
	
	Container0.lblRegNo.visible = true
	Container0.lblRegData.visible = true
	Container0.lblValdDate.visible = true

	Container0.lblRegNo.caption = "-"
	Container0.lblRegData.caption = "-"
	Container0.lblValdDate.caption = "-"


	Container0.lblOnCoSfcnYN.caption = ""
	Container0.lblOnCoAmt.caption = ""
	Container0.lblOtCoCnt.caption = 0
	Container0.lblOtCoCnt.fgcolor = "146"
	Container0.btnInvReg.enable = false
End Sub

'============================================================================
Sub Container0_edtPswd_OnClick()
	Dim sSendData
	sSendData = Container0.acnt0.total&Container0.acnt0.sequence&"☆"&"0"
	'비밀번호 팝업 띄움..	
	Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")
End Sub

'============================================================================
' Container0_edtPswd_OnEditComplete() : 비밀번호 입력 v0001 20220519 추가
'============================================================================
Sub Container0_edtPswd_OnEditComplete()
	if Container0.edtPswd.caption ~= null then
	'if Container0.edtPswd.caption ~= null and (Container0.edtPswd.pwdlen = 4 or Container0.edtPswd.pwdlen = "4")  then
		DATAMANAGER.RequestTranData( "obacp_opop_066r" ) '비밀번호검증
	else
'		Form.triggerEvent("#", "BTN_NEXT_ENABLE_STATE", false)
	end if
End Sub


'============================================================================
Sub Container0_imgTooltip_OnClick()
	szToolTipText = "금융투자상품 잔고 충족 기준\n\n전월 기준으로 최근 5년 중 1년 이상의 기간 동안 월말 평균 잔고 기준 3억원 이상 보유\n(금융위원회가 정하여 고시하는 *금융투자상품에 한함)\n\n*지분증권(주식, 해외주식, 코넥스주식), 고난도 파생 결합증권, 장내ㆍ외 파생상품"
	
	Container0.imgTooltip.openToolTip(szToolTipText, 360, 180, 5)
End Sub

'============================================================================
Sub Container0_imgTooltip2_OnClick()
	szToolTipText = "당사 투자경험 미충족 시,\n타사 투자경험을 합산하여 요건을 충족할 수 있어요."
	
	Container0.imgTooltip2.openToolTip(szToolTipText, 340, 70, 2)
End Sub

'============================================================================
Sub Container0_btnInvReg_OnClick()
	'123r에 신청일련번호 없는경우 강제로 채번하기 위함.
	if g_szAplyNum = "00000000000" then
		DATAMANAGER.RequestTranData( "obcsb_acif_124a" )			
		Exit Sub
		
	else
		If g_szAplyNum <> "" and g_szAplyNum <> null Then
			Form.OpenPopup("mbonl94004_p11", g_szAplyNum.."★" , "")
		End If
		
	end if
End Sub

