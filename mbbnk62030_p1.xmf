'===========================================================================
' 화 면 명: 다른 금융기관 계좌 조회 팝업
' 화면설명: 
' 작    성: 2020.10.12 송기영
' 수    정:
'===========================================================================
'***************************************************************************
'     G L O B A L   V A R I A B L E
'***************************************************************************
Dim g_szID         '사용자 아이디
Dim g_szList

Dim g_szAcno
Dim g_szAccd
Dim g_szAcnm
Dim g_szAgree

'===========================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	EdtAc.enable = "0"
	EdtAcAl.enable = "0"
	EdtAcOpenD.enable = "0"
	EdtCloD.enable = "0"
	EdtCurrTrD.enable = "0"
	EdtAgr.enable = "0"
End Sub


'============================================================================
Sub imgClose_OnClick()
	Form.SendReturnToParent( "INFO_POPUP" , "CANCEL" )
	Form.CloseForm()
End Sub



'============================================================================
Sub Form_OnFormInitBefore()

	Dim szData
	szData = Form.GetOpenLinkData()
	g_szList = Split(szData, "★")

	if UBOUND(g_szList) < 1 THEN
		EXIT SUB
	END IF

	EdtAc.caption = g_szList(0)
	EdtAcAl.caption = g_szList(1)
	EdtAcOpenD.caption = g_szList(2)
	EdtCloD.caption = g_szList(3)
	EdtCurrTrD.caption = g_szList(4)
	
	g_szAcno = g_szList(0)
	g_szAccd = g_szList(8)
	g_szAcnm = g_szList(7)
	g_szAgree = g_szList(5)
	
	if g_szList(5) = "Y" then	'출금계좌 동의
		EdtAgr.caption = "동의"  
	else 					'출금계좌 미동의
		EdtAgr.caption = "미동의"
	end if
	
	' 입출금, 종합계좌 탭인경우
	if g_szList(6) = "mbbnk62030_t1" or  g_szList(6) = "mbbnk62030_t2" then
		if g_szList(5) = "Y" then	'출금계좌 동의
			btnTr.enable = "1"	'이체버튼 활성화
		else 					'출금계좌 미동의
			btnTr.enable = "0"	'이체버튼 활성화
		end if
		
	' 예적금 탭인경우
	elseif g_szList(6) = "mbbnk62030_t3" then
		btnTr.enable = "0"
		
	' 수익증권 탭인경우
	elseif g_szList(6) = "mbbnk62030_t4" then
		btnList.enable = "0"
		btnTr.enable = "0"
	end if
End Sub


'============================================================================
Sub btnList_OnClick()
	Form.OpenScreen("62031", g_szAcno & "★" & g_szAcnm & "★" & g_szAccd)
	
End Sub



'============================================================================
Sub btnTr_OnClick()
	sz_data = "mbbnk62030" & "★" &  g_szAccd & "★" & g_szAcno  & "★" & g_szAcnm & "★" & g_szAgree
	Form.OpenScreen("62020", sz_data)
End Sub



'============================================================================
Sub btnMang_OnClick()
	Form.OpenScreen("62032", g_szAcno & "★" & g_szAcnm & "★" & g_szAccd)
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranError (szTranID , szErrCode , szErrMsg)
	
	Dim SubMsg
	
	SubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if SubMsg = "" then
		Form.MsgBox("알림", szErrMsg, 0)	
	else
		Form.MsgBox("알림", szErrMsg & "(" & SubMsg & ")", 0)
	end if
	
End Sub



