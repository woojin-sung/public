'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("유의사항")
	
	dim str
	str = "이 개인종합자산관리계좌(ISA)는 예금자보호법에 따라 예금보호 대상으로 운용되는"
		.. "금융상품에 한하여 1인당 " & chr(34) & "5천만원까지" & chr(34) & "(운용되는"
		.. "금융상품 판매회사별 보호상품 합산) 보호됩니다."
	
	Container0.Label0.caption = str
	
	'Container0.Table0.SetCellString(6, 0, "소정의 이자를 합하여 1인당 " & chr(34) & "최고")
	'Container0.Table0.SetCellString(7, 0, "5천만원" & chr(34) & "이며, 5천만원을 초과하는 나머지")
End Sub


'============================================================================
'btnOK_OnClick
'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub






'============================================================================
Sub ImageClose_OnClick()
	Form.CloseForm()
