'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : Wrap상품 목록 조회
' 02. 화면설명 : 
' 03. 이    력 : 2023.06.05 : 고승연 : v0002 : [T2306080007] 주석 추가
'-------------------------------------------------------------------------------------------
' mbonl81010_p1 ( 투자성향 등급 / KYCCHK_RETURN )
' -> obcsb_acif_713r
' -> obcmm_kcdd_035r
' -> obcmm_kwlf_013a / obwat_ctad_026a
' -> obwat_ctad_026a
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szPROS_YN					'처리여부
Dim g_szKYC_INVT_INCL_GRAD_CODE 	'KYC투자성향등급코드
Dim g_szKYC_DVPD_EPMD_CODE		 	'KYC파생상품유의코드
Dim g_szKYC_PROD_GRAD_CODE 			'KYC상품등급코드
Dim g_szKYC_DRVT_PROS_YN 			'KYC파생처리여부
Dim g_szDVPD_GRAD_CODE 			'파생상품등급코드
Dim g_szJumin

Dim 	g_szCustFullName	'고객풀명				from	obcmm_kwlf_032r
Dim	g_szRCNOType		'실명확인번호유형코드	from	obcmm_kwlf_032r
Dim	g_szCTCD			'국가코드				from	obcmm_kwlf_032r
Dim 	g_szCUSTEngName		'고객영문명			from	obcmm_kwlf_032r
Dim 	g_szAlertTitle

g_szAlertTitle	=	"알림"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************




'============================================================================
Sub Form_OnFormInit()

	g_szJumin = Form.GetSharedData("&JUMIN_NUM", false )
	DATAMANAGER.RequestTranData( "obwat_ctad_011r" )
	
	btnPwd.bringfront("1") '계좌비밀번호 입력 개선
	edtPwd.caption = ""
End Sub

'============================================================================
Sub btnPwd_OnClick()
	Form.openPopupAnimation("pwdcheckpopup", acnt.total & "☆0" ,"","2")
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	dim	szToday
	Dim sACNT_PWD 
	sACNT_PWD = Form.GetCtlProp( "edtPwd", "caption" )
		
	if szTranID == "obwat_ctad_026a" then
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_026a", "InBlock1", "UI_PROS_CLS_CODE" 	, 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_026a", "InBlock1", "ACNO" 			, 0 , acnt.total )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_026a", "InBlock1", "ASNO" 			, 0 , acnt.sequence )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_026a", "InBlock1", "ACNT_PWD" 		, 0 , sACNT_PWD )
		
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_026a", "InBlock1", "PROS_YN" 			, 0 , g_szPROS_YN )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_026a", "InBlock1", "CNFR_YN" 			, 0 , g_SUCS_YN )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_026a", "InBlock1", "STND_DATE" 			, 0 , g_STND_Date )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_026a", "InBlock1", "REG_SRNO" 			, 0 , g_REG_Srno )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_026a", "InBlock1", "KYC_DVPD_EPMD_CODE" 	, 0 , g_szKYC_DVPD_EPMD_CODE )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_026a", "InBlock1", "KYC_DRVT_PROS_YN" 	, 0 , g_szKYC_DRVT_PROS_YN )
		'DATAMANAGER.SetDataValue( 0, "obwat_ctad_026a", "InBlock1", "CONT_COS_CODE" 		, 0 , sACNT_PWD )
		'DATAMANAGER.SetDataValue( 0, "obwat_ctad_026a", "InBlock1", "SNOT_EMPNO" 		, 0 , sACNT_PWD )
	
	elseif szTranID == "obwat_ctad_026r" then
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_026r", "InBlock1", "UI_PROS_CLS_CODE" 	, 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_026r", "InBlock1", "ACNO" 			, 0 , acnt.total )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_026r", "InBlock1", "ASNO" 			, 0 , acnt.sequence )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_026r", "InBlock1", "ACNT_PWD" 		, 0 , sACNT_PWD )
		
	elseif szTranID == "obwat_ctad_011a" then
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_011a", "InBlock1", "WA_ACNO" , 0 , acnt.total )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_011a", "InBlock1", "WA_CNRC_NO" , 0 , cmbWrap.cbkeydata )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_011a", "InBlock1", "DRNG_CANC_CLCD" , 0 , "02" )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_011a", "InBlock1", "CRCD" , 0 , "KRW" )
		DATAMANAGER.SetDataValue( 0, "obwat_ctad_011a", "InBlock1", "WA_CANC_CLCD" , 0 , cmbType.cbkeydata )
	elseif	szTranID	=	"obcsb_acif_713r"	then
		DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "ACNO"				, 0, acnt.total)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "ASNO"				, 0, acnt.sequence)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "BSWR_DOMN_CLCD"		, 0, "01")
		DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "PRCD"				, 0, "119")
		DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "KYC_BSWR_DIV_CODE"	, 0, "01020")
		DATAMANAGER.SetDataValue(0, "obcsb_acif_713r", "InBlock1", "BSWR_DIV_CODE"		, 0, "03")
	elseif	szTranID	=	"obcmm_kcdd_035r"	then
		szToday	= Form.GetSharedData("&HOST_DATE", 0)
		DATAMANAGER.SetDataValue(0, "obcmm_kcdd_035r", "InBlock1", "CDD_REG_DATE", 0, szToday )
		DATAMANAGER.SetDataValue(0, "obcmm_kcdd_035r", "InBlock1", "RCNO_PIP", 0, g_szJumin )
	elseif	szTranID	=	"obcmm_kwlf_032r"	then
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_032r", "InBlock1", "ACNO", 0, acnt.total )
	elseif	szTranID	=	"obcmm_kwlf_013a"	then
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock1", "RCNO_PIP", 0, g_szJumin )
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock1", "ACNO", 0, acnt.total )
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock1", "CUST_FULL_NAME", 0, g_szCustFullName )
		
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock2", "WLF_REAL_RCNO_PIP", 0, g_szJumin )
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock2", "RCNO_TYPE_CODE", 0, g_szRCNOType )
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock2", "CTCD", 0, g_szCTCD )
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock2", "CUST_FULL_NAME", 0, g_szCustFullName )
		DATAMANAGER.SetDataValue(0, "obcmm_kwlf_013a", "InBlock2", "CUST_ENG_NAME", 0, g_szCUSTEngName )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obwat_ctad_026a" then
		Form.SetSharedData("WRAP_ACNT", "[WRAP] "&left(acnt.total,4) & "-" & right(acnt.total,4) & "-" & acnt.sequence)
		Form.OpenPopup("mbwat61090_p1", "", "")
	elseif szTranID == "obwat_ctad_026r" then
	elseif	szTranID	=	"obcsb_acif_713r"	then
		g_szPROS_YN					= DATAMANAGER.GetDataValue( 0, "obcsb_acif_713r", "OutBlock1", "PROS_YN" , 0 ) '처리여부
		g_szKYC_INVT_INCL_GRAD_CODE		= DATAMANAGER.GetDataValue( 0, "obcsb_acif_713r", "OutBlock1", "KYC_INVT_INCL_GRAD_CODE	" , 0 ) 'KYC투자성향등급코드
		g_szKYC_DVPD_EPMD_CODE			= DATAMANAGER.GetDataValue( 0, "obcsb_acif_713r", "OutBlock1", "KYC_DVPD_EPMD_CODE" , 0 ) 'KYC파생상품유의코드
		g_szKYC_PROD_GRAD_CODE			= DATAMANAGER.GetDataValue( 0, "obcsb_acif_713r", "OutBlock1", "KYC_PROD_GRAD_CODE" , 0 ) 'KYC상품등급코드
		g_szKYC_DRVT_PROS_YN			= DATAMANAGER.GetDataValue( 0, "obcsb_acif_713r", "OutBlock1", "KYC_DRVT_PROS_YN" , 0 ) 'KYC파생처리여부
		g_szDVPD_GRAD_CODE			= DATAMANAGER.GetDataValue( 0, "obcsb_acif_713r", "OutBlock1", "DVPD_GRAD_CODE" , 0 ) '파생상품등급코드
		
		Call Do_WLF()
	elseif	szTranID	=	"obcmm_kcdd_035r"	then
		
		szRegYN = DATAMANAGER.GetDataValue(0, "obcmm_kcdd_035r", "OutBlock1", "REG_YN", 0)
		
		if	szRegYN	=	"Y"		then
			DATAMANAGER.RequestTranData("obwat_ctad_026a")		'최종TR 종합매매개별상품가입
		else
			DATAMANAGER.RequestTranData("obcmm_kwlf_032r")	
		end if
		
	elseif	szTranID	=	"obcmm_kwlf_032r"	then
	
		g_szRCNOType	= DATAMANAGER.GetDataValue(0, "obcmm_kwlf_032r", "OutBlock1", "RCNO_TYPE_CODE", 0)
		g_szCTCD		= DATAMANAGER.GetDataValue(0, "obcmm_kwlf_032r", "OutBlock1", "CTCD", 0)
		
		g_szCustFullName= DATAMANAGER.GetDataValue(0, "obcmm_kwlf_032r", "OutBlock1", "CUST_FULL_NAME", 0)
		g_szCUSTEngName	= DATAMANAGER.GetDataValue(0, "obcmm_kwlf_032r", "OutBlock1", "CUST_ENG_NAME", 0)
		
		DATAMANAGER.RequestTranData("obcmm_kwlf_013a")	
		
	elseif	szTranID	=	"obcmm_kwlf_013a"	then
		DATAMANAGER.RequestTranData("obwat_ctad_026a") 		'최종TR 종합매매개별상품가입
	end if
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert(g_szAlertTitle,  szErrMsg & "(" & szSubMsg & ")")
	
End Sub

'============================================================================
Sub btnCancel_OnClick()
	if GetPWCkeck() then
		Exit Sub
	end if
	Form.MsgBox("알림", "종합매매계좌를 Wrap 계좌로 전환 하시겠어요?", "Request", 1)
	'Form.openPopupAnimation("pwdcheckpopup", acnt.caption & "☆0" ,"","2")
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
			end if
		end if
	elseif sKeyName = "KYCCHK_RETURN" then '투자성향등급 리턴
		if sRet = "Y" then
			'DATAMANAGER.RequestTranData("obcsb_acif_713r")
			
			g_SUCS_YN = Form.GetSharedData( "KYC_SUCS_YN" , false )
			g_STND_Date = Form.GetSharedData( "KYC_STND_DATE", false )
			g_REG_Srno = Form.GetSharedData( "KYC_REG_SRNO", false )
			
			g_szKYC_INVT_INCL_GRAD_CODE = Form.GetSharedData( "KYC_INVT_INCL_GRAD_CODE", false )
			g_KYC_PROD_GRAD_CODE = Form.GetSharedData( "KYC_PROD_GRAD_CODE", false )
			g_szKYC_DVPD_EPMD_CODE = Form.GetSharedData( "KYC_DVPD_EPMD_CODE", false )
			g_KYC_DRVT_PROS_YN = Form.GetSharedData( "KYC_DRVT_PROS_YN", false )
			g_DVPD_GRAD_CODE = Form.GetSharedData( "DVPD_GRAD_CODE", false )
			g_KYC_INVT_RCMD_CLS_CODE = Form.GetSharedData( "KYC_INVT_RCMD_CLS_CODE", false )
			
		
			Call Do_WLF()
		end if
	end if
End Sub


'===========================================================================
' 계좌비밀번호 입력체크함수
'===========================================================================
Function GetPWCkeck()
	Dim sACNT_PWD 
	sACNT_PWD = Form.GetCtlProp( "edtPwd", "caption" )
	
	if sACNT_PWD == null or sACNT_PWD == "" then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	end if
	
	return false
End Function	
'===========================================================================
'투자성향등급비교 확인
'===========================================================================
Sub Chk_KYC()
	Dim sACNT_PWD 
	sACNT_PWD = Form.GetCtlProp( "edtPwd", "caption" )
	if	len(acnt.total) 	>	0	and	 len(acnt.sequence) 	>	0	and	 
		len(trim(sACNT_PWD)) >	0	then
		Form.OpenPopup("mbonl81010_p1" , "57090★" & acnt.total & "★" &  acnt.sequence & "★" & sACNT_PWD)
	end if	
End Sub
'===========================================================================
'WLF체크
'===========================================================================
Sub Do_WLF()
	DATAMANAGER.RequestTranData("obcmm_kcdd_035r")
End Sub

'============================================================================
' Form_OnFormClose()
'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("KYC_SUCS_YN", "")
	Form.SetSharedData("KYC_CSNO", "")
	Form.SetSharedData("KYC_STND_DATE", "")
	Form.SetSharedData("KYC_REG_SRNO", "")
	
	Form.SetSharedData("KYC_INVT_INCL_GRAD_CODE", "")
	Form.SetSharedData("KYC_PROD_GRAD_CODE", "")
	Form.SetSharedData("KYC_DVPD_EPMD_CODE", "")
	Form.SetSharedData("KYC_DRVT_PROS_YN", "")
	Form.SetSharedData("DVPD_GRAD_CODE", "")
	Form.SetSharedData("KYC_INVT_RCMD_CLS_CODE", "")
	
End Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "Request" then
		if sRet == "ok" then
			call Chk_KYC()
		end if
	end if
End Sub
