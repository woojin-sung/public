	<SCRIPT_INFO _len="6239" _ulen="5325" >
Dim g_szJoinAbleYn

'============================================================================
Sub Form_OnFormInit()
	Form.SetTitleCaption( "가입안내" )
	g_szJoinAbleYn = "N" ' 가입불가
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	If szTranID == "obcsb_acif_823r" Then
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_823r", "InBlock1", "ACNO" , 0 , Account0.caption )
	End If
	
	if szTranID == "obcsb_acif_824a" Then
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_824a", "InBlock1", "ACNO" , 0 , Account0.caption )
	End If
	
	if szTranID == "obcsb_acif_825a" Then
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_825a", "InBlock1", "ACNO" , 0 , Account0.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_acif_825a", "InBlock1", "SMPR_ATHN_CODE" , 0 , Container0.Edit0.caption )
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obcsb_acif_823r" Then
	
		KycResult    = DATAMANAGER.GetDataValue( 0, "obcsb_acif_823r", "OutBlock1", "KYC_COMP_RSLT_CODE" 			, 0 ) 'KYC 비교결과코드
		KycGradeCode = DATAMANAGER.GetDataValue( 0, "obcsb_acif_823r", "OutBlock1", "APLY_KYC_INVT_INCL_GRAD_CODE"	, 0 ) 'KYC등급코드

		EmailRegYn   = DATAMANAGER.GetDataValue( 0, "obcsb_acif_823r", "OutBlock1", "EMAIL_REG_YN"					, 0 ) '이메일등록여부
		OldtAble_Yn  = DATAMANAGER.GetDataValue( 0, "obcsb_acif_823r", "OutBlock1", "OLDT_INVT_ABLE_YN"				, 0 ) '고령자투자가능여부 (가능이면 Y)
		DeptlAble_yn = DATAMANAGER.GetDataValue( 0, "obcsb_acif_823r", "OutBlock1", "DEAL_ABLE_DEPT_YN"				, 0 ) '특정부서 매매불가여부  (가능이면 Y)
		
		'이메일인증관련 chk
		SmprAthn_Cd  = DATAMANAGER.GetDataValue( 0, "obcsb_acif_823r", "OutBlock1", "SMPR_ATHN_CODE"				, 0 ) '이메일인증코드
		EmailSndnYn  = DATAMANAGER.GetDataValue( 0, "obcsb_acif_823r", "OutBlock1", "EMAIL_SNDN_YN"					, 0 ) '이메일발송여부
		EmailRcmsYn  = DATAMANAGER.GetDataValue( 0, "obcsb_acif_823r", "OutBlock1", "EMAIL_RCMS_YN"      			, 0 ) '이메일수신여부
		
		FinDate	    = DATAMANAGER.GetDataValue( 0, "obcsb_acif_823r", "OutBlock1", "FIN_DATE"  		    			, 0 ) '인증종료일자 
		Join_Yn	    = DATAMANAGER.GetDataValue( 0, "obcsb_acif_823r", "OutBlock1", "JOIN_YN"  		    			, 0 ) '가입여부 
		
		'본사 특정부서 여부 체크 
		If DeptlAble_yn == "N" Then
			g_szJoinAbleYn = "N" ' 가입불가
			Form.MsgBox("알림", "고객님은 스마트프로에 가입하실 수 없습니다(특정부서 제한).", "", 0)
		End If
				
		'고령자 여부 체크
		If OldtAble_Yn == "N" Then
			g_szJoinAbleYn = "N" ' 가입불가
			Form.MsgBox("알림", "고객님은 고령자로 스마트프로에 가입하실 수 없습니다.", "", 0)
		End If
		
		'이메일수신여부 체크 		 		
		If (KycResult == "X" or KycResult == "N") and EmailRcmsYn == "Y" and  OldtAble_Yn == "Y" and EmailRegYn == "Y" Then
		
			g_szJoinAbleYn = "Y" ' 가입가능
			If Join_Yn = "Y" Then
				Form.OpenFramePopup("mbfnp55000_p2" , "", "")	 '종목선택 
			Else
				Form.OpenFramePopup("mbfnp55000_p1" , "", "") '입력확인
			End If
			
		Else 
			g_szJoinAbleYn = "N" ' 가입불가
			
			If KycResult == "Y" Then ' 부적합동의필요
				SELECT CASE KycGradeCode
					CASE "02"  KycGradeNm = "성장지향형"
					CASE "03"  KycGradeNm = "중립형"
					CASE "04"  KycGradeNm = "안정지향형"
					CASE "05"  KycGradeNm = "이자소득형"
				END SELECT
				Form.MsgBox("알림", "고객님의 투자성향은 "&KycGradeNm&"으로 스마트프로에 가입하실 수 없습니다.", "", 0)
				
			ElseIf KycResult == "A" Then ' 투자성향진단수행필요
				Form.MsgBox("알림", "투자성향 진단 수행이 필요합니다.", "", 0)
			End If
			
			If EmailRegYn == "N" Then ' 이메일없음
				Form.MsgBox("알림", "통보처 등록(Email)이 필요합니다.", "", 0)
			End If
			
			'이메일인증여부 chk
			If EmailRcmsYn = "F" Then
				Form.MsgBox("알림", "이메일(Email) 인증기한이 만료되었습니다. [전자메일 체크 & 보안코드 생성] 버튼을 통해 재인증해주십시요.", "", 0)
			ElseIf EmailRcmsYn = "N" Then
				Form.MsgBox("알림", "이메일(Email) 인증이 필요합니다.", "", 0)
			ElseIf EmailRcmsYn = "R" Then	
				Form.MsgBox("알림", "당일 이메일(Eamil) 인증 신청이력이 있습니다. 이메일(Email)을 확인해주세요..", "", 0)
			End If		
			
		End If
	End If
	
	If szTranID == "obcsb_acif_824a" Then
		Form.MsgBox("알림", "이메일(Email)로 인증코드 및 첨부문서를 발송하였습니다.", "", 0)
	End If
	
	If szTranID == "obcsb_acif_825a" Then  
		Form.MsgBox("알림", "이메일(Email)로 인증코드가 정상적으로 등록되었습니다.", "", 0)
	End If
End Sub

'============================================================================
Sub Button0_OnClick() ' 다음버튼
	DATAMANAGER.RequestTranData( "obcsb_acif_823r" )
End Sub

'============================================================================
Sub Container0_Label11_OnClick()
	Form.CloseForm()
	Form.OpenScreen("81010" , "") ' 투자자정보변경
End Sub

'============================================================================
Sub Container0_Label18_OnClick()
	Form.CloseForm()
	Form.OpenScreen("87010" , "") ' 개인정보변경
End Sub

'============================================================================
Sub Container0_Label24_OnClick()
	DATAMANAGER.RequestTranData( "obcsb_acif_824a" )
End Sub

'============================================================================
Sub Container0_Button1_OnClick()
	if len(Container0.Edit0.caption) = 0 Then
		Form.MsgBox("알림", "인증코드를 입력해주세요.", "", 0)
		Exit Sub
	end iF
	DATAMANAGER.RequestTranData( "obcsb_acif_825a" )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")

End Sub
