	<SCRIPT_INFO _len="9309" _ulen="8593" >
Dim szSpclYn
Dim g_szInvGrd
Dim g_DNLDYN
Dim g_szDate
'============================================================================
Sub Form_OnFormInit()
	btnReg01.enable = false
	edtPwd01.caption =  ""
	
	Dim szTheme
	szTheme = Form.GetEnvData("common.theme")
	btnReg01.fgcolor = "269"
	If szTheme == "white" Then
		btnReg01.btnimage = "btn_21.9"
	Else
		btnReg01.btnimage = "btn_27.9"
	End If
	
	If Len(acnt01.total) < 4 Then
		Form.ShowAlert("알림", "계좌번호 오류")
	Else
		'KYC고객정보조회
		DATAMANAGER.RequestTranData( "obcsb_acif_701r" )
	End If
	
	'전단채에서 투자성향 오픈시 폼 사이즈 변경
	szOpenData = Form.GetOpenLinkData()
'Form.ShowAlert("GetOpenLinkData", szOpenData)
'	szOpenData = "mbonl88060"
	if szOpenData == "mbonl88060" then
		Form.height = 605
		Container0.height = 498
		btnReg01.top = 555
	else
		Form.height = 562
		Container0.height = 453
		btnReg01.top = 508
	end if

	Container0.Table0.SetCellBgColor(1, 0, 372)
	Container0.Table0.SetCellBgColor(2, 0, 373)
	Container0.Table0.SetCellBgColor(3, 0, 375)
	Container0.Table0.SetCellBgColor(4, 0, 376)
	Container0.Table0.SetCellBgColor(5, 0, 377)

	Container0.scroll_pos = "top"
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'KYC고객정보조회
	If szTranID == "obcsb_acif_701r" Then	
		DATAMANAGER.SetDataValue(0, "obcsb_acif_701r", "InBlock1", "ACNO", 0, acnt01.total)
	End If
End Sub
	
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'KYC고객정보조회
	If szTranID == "obcsb_acif_701r" Then
		g_szDate = Form.GetSharedData("&HOST_DATE", false)
		
		g_DNLDYN = "Y"
		'투자성향
		Dim szInvGrd, szEnttGrd, szTrustGrd
		szInvGrd = Form.GetMetaData("KYC투자성향등급코드", DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "KYC_INVT_INCL_GRAD_CODE", 0))
		szEnttGrd = Form.GetMetaData("KYC투자성향등급코드", DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "ENTT_IVIC_GRCD", 0))
		szTrustGrd = Form.GetMetaData("KYC투자성향등급코드", DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "TRUST_IVIC_GRCD", 0))
		
		'전역번수에 set
		g_szInvGrd = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "KYC_INVT_INCL_GRAD_CODE", 0)
		
		'고객명
		Dim szName
		szName = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "CUST_FULL_NAME", 0)
		Container0.lblName.caption = szName & "님의 투자자성향은"
		
		'투자권유, 투자자정보 제공 여부
		Dim szRcmdCode
		szRcmdCode = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "KYC_INVT_RCMD_CLS_CODE", 0)
		
'		szRcmdCode = "1"
		If szRcmdCode == "1" Then			'권유희망 + 정보제공
			Container0.lblGrade.visible = true
			Container0.lblGrdDetail.visible = true
			
			'등급 이름이 길 경우 위치조정
			If Trim(szInvGrd) == "고수익지향형" Then
				Container0.lblText.left = 120
			Else
				Container0.lblText.left = 110
			End If
			
			Container0.lblGrade.caption = szInvGrd
			Container0.lblGrade.fgcolor = "6"
			Container0.lblGrdDetail.caption = "일임 " & szEnttGrd & " | 비지정형신탁 " & szTrustGrd 
			
			Container0.tblInfo.SetCellString(0, 1, "희망")
			Container0.tblInfo.SetCellString(1, 1, "제공")
			
			Container0.tblRcmdY.visible = true
			Container0.tblRcmdN.visible = false
			
		ElseIf szRcmdCode == "3" Then		'권유불원 + 정보제공
			Container0.lblGrade.visible = true
			Container0.lblGrdDetail.visible = false
			
			'투자권유불원 + 정보제공 케이스는 투자성향 표현
			If Trim(szInvGrd) == "고수익지향형" Then
				Container0.lblText.left = 120
			Else
				Container0.lblText.left = 110
			End If
			
			Container0.lblGrade.caption = szInvGrd
			Container0.lblGrade.fgcolor = "6"
			
			Container0.tblInfo.SetCellString(0, 1, "미희망")
			Container0.tblInfo.SetCellString(1, 1, "제공")
			
			Container0.tblRcmdY.visible = false
			Container0.tblRcmdN.visible = true
			
		ElseIf szRcmdCode == "4" Then		'권유불원 + 정보미제공
			Container0.lblGrade.visible = true
			Container0.lblGrdDetail.visible = false
			
			Container0.lblText.left = 250
			Container0.lblGrade.caption = "투자권유 미희망 / 정보 미제공"
			Container0.lblGrade.fgcolor = "6"
			
			Container0.tblInfo.SetCellString(0, 1, "미희망")
			Container0.tblInfo.SetCellString(1, 1, "미제공")
			
			Container0.tblRcmdY.visible = false
			Container0.tblRcmdN.visible = true
			
		ElseIf szRcmdCode == "" Then		'미등록상태 
			Container0.lblGrade.caption = "미등록상태"
			Container0.lblGrade.fgcolor = "4"
			Container0.lblText.left = 110		'입니다
			
			Container0.lblGrade.visible = true
			Container0.lblGrdDetail.visible = false
			
			Container0.tblInfo.SetCellString(0, 1, "-")
			Container0.tblInfo.SetCellString(1, 1, "-")
			
			Container0.tblRcmdY.visible = false
			Container0.tblRcmdN.visible = true
			
			g_DNLDYN = "N"
		End If
		
		'전문투자자여부
		szSpclYn = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "KYC_SPCL_INVR_YN", 0)
'		szSpclYn = "Y"
		If szSpclYn == "Y" Then
			Container0.lblSpclYn.visible = true
			
			'투자권유불원 + 정보미제공 케이스의 경우에는 전문투자자 표시 개행이 필요함
			If szRcmdCode <> "4" Then
				Container0.lblSpclYn.left = 185
				Container0.lblSpclYn.top = 40
			Else
				Container0.lblSpclYn.left = 10
				Container0.lblSpclYn.top = 66
			End If
			
			g_DNLDYN = "N"
		Else
			Container0.lblSpclYn.visible = false
		End If
		
		'등록일, 만기일
		Dim szRegDate, szExpDate
		szRegDate = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "PROS_DATE", 0)
		szExpDate = DATAMANAGER.GetDataValue(0, "obcsb_acif_701r", "OutBlock1", "KYC_VALD_PRD_MTRT_DATE", 0)

		If g_szDate > szExpDate Then
			g_DNLDYN = "N"
		End If
		
		If szRcmdCode <> "" Then
			szRegDate = Left(szRegDate, 4) & "." & Mid(szRegDate, 5, 2) & "." & Right(szRegDate, 2)
			szExpDate = Left(szExpDate, 4) & "." & Mid(szExpDate, 5, 2) & "." & Right(szExpDate, 2)
			Container0.tblInfo.SetCellString(2, 1, szRegDate)
			Container0.tblInfo.SetCellString(3, 1, szExpDate)
		Else
			Container0.tblInfo.SetCellString(2, 1, "-")
			Container0.tblInfo.SetCellString(3, 1, "-")
		End If

		If g_DNLDYN == "N" Then
			Container0.Label0.visible = False
			Container0.btnDownLoad.visible = False
			Container0.Image1.visible = False
		Else
			Container0.Label0.visible = True
			Container0.btnDownLoad.visible = True
			Container0.Image1.visible = True
		End If

	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	If Trim(szSubMsg) == "" Then
	    Form.ShowAlert("알림" , szErrMsg)
	Else
	    Form.ShowAlert("알림" , szErrMsg & Chr(13) & Chr(10) & "(" & szSubMsg & ")" )
	End If
End Sub

'============================================================================
Sub Container0_btnInfoPopup_OnClick()
	'성향별 적합한 상품 안내 팝업
'	Form.OpenPopup("mbbdm85145_p1" , "" , "")
	Form.OpenPopup("mbbdm86175_p1" , "" , "")
End Sub

'============================================================================
Sub acnt01_ChangeAccount()
	If edtPwd01.caption <> "" And edtPwd01.caption <> null Then
		btnReg01.enable = true
	Else
		btnReg01.enable = false
	End If
End Sub

'============================================================================
Sub edtPwd01_OnEditComplete()
	If edtPwd01.caption <> "" And edtPwd01.caption <> null Then
		btnReg01.enable = true
		
		btnReg01.btnimage = "btn_20.9"
		btnReg01.fgcolor = "273"
	Else
		btnReg01.enable = false
		
		Dim szTheme
		szTheme = Form.GetEnvData("common.theme")
		btnReg01.fgcolor = "269"
		If szTheme == "white" Then
			btnReg01.btnimage = "btn_21.9"
		Else
			btnReg01.btnimage = "btn_27.9"
		End If
	End If
End Sub

'============================================================================
Sub btnReg01_OnClick()
	If szSpclYn == "Y" Then
		Form.ShowAlert("전문금융소비자" , "투자성향 진단은 일반금융소비자만 가능합니다.")
	Else
		Form.OpenPopup("mbonl81010_s2" , acnt01.total & "★" & edtPwd01.caption , "")
	End If
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'등록완료 후 메인화면 재조회
	If sKeyName == "mbonl81010_s2" Then
		'KYC고객정보조회
		DATAMANAGER.RequestTranData( "obcsb_acif_701r" )
		
		'투자성향 변경 후 단기사채 화면의 투자성향 재조회하기 위함
		Form.PostLinkData("Change_Invest_Type", "refresh")
	End If
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'상단 유의사항 팝업
	If sEventName == "INFO_CLICK" Then
		Form.OpenFramePopup("mbonl81010_p17" , "" , "")
	End If
End Sub

'============================================================================
Sub Container0_btnDownLoad_OnClick()
	Form.OpenPopup("mbfnp51000_p16" , g_szInvGrd , "")
End Sub


