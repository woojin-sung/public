'----------------------------------------------------------------------------
' 01. 화 면 명 : 관심종목 해외뉴스
' 02. 화면설명 : 관심종목 해외뉴스 팝업화면
' 03. 작    성 : 2023.07.04 KKM
'----------------------------------------------------------------------------
'20230721 종목컨트롤에서 종목선택 변경 막음.(종목선택창에서는 2자리 시장구분코드 서비스에는 3자리 올려야됨.)


'****************************************************************************
'           GROBAL VARIABLE
'****************************************************************************
Dim g_szItemCode, g_szItemName
Dim g_szIteminfo
Dim g_szExid

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
Function Btn_Click( nIndex )
	Dim szUrl

	szUrl = g_szItemCode  & "|" &  g_szIteminfo
	Form.OpenFramePopup( "mhtro16000_p6" , szUrl, "")
	
End Function

'============================================================================
Function Transform_Exid2(sValue)
	
	if sValue = "HK" then
		Transform_Exid2 = "HKS"
		exit Function
	elseif sValue = "SH" then
		Transform_Exid2 = "SHS"
		exit Function
	elseif sValue = "SZ" then
		Transform_Exid2 = "SZS"
		exit Function
	elseif sValue = "NY" then
		Transform_Exid2 = "NYS"
		exit Function
	elseif sValue = "AX" then
		Transform_Exid2 = "AMX"
		exit Function
	elseif sValue = "OQ" then
		Transform_Exid2 = "NAS"
		exit Function
	elseif sValue = "JP" then
		Transform_Exid2 = "TSE"
		exit Function
	end if
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()

	sParam	=	Form.GetOpenLinkData()
	g_szItemCode = sParam
	If sParam = "" Then
		Exit Sub
	End If
	
	g_szItemName = Form.GetItemCodeInfo( sParam , "name")
	g_sCode = Split(g_szItemCode, "@")
	g_szIteminfo = g_sCode(0)
	g_szExid = Transform_Exid2(g_szIteminfo)
	g_szItemCode = g_sCode(1)
	
	'20230721 sParam(ex.OQ@APPL) 값 그대로 넣어주면됨
	ItemCode01.caption = sParam
	
	DATAMANAGER.RequestTranData( "ohhts_news_001r" )
	
	
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey = "ITEMCODE" then
		g_szItemCode = sValue
		g_szItemName = Form.GetItemCodeInfo( g_szItemCode , "name")
		DATAMANAGER.RequestTranData( "ohhts_news_001r" )
	end	if
End Sub

'============================================================================
Sub Form_OnCommonDialogReturn(sDlgName, sReturn1, sReturn2)
'msgbox sDlgName &" :: "& sReturn1 &" :: "& sReturn2
	if	sDlgName	=	"SEARCH"	then
		if	sReturn1	<>	NULL		AND	len(trim(sReturn1))	>	 3	then 		
			g_szItemCode	=	sReturn1
			g_szItemName = Form.GetItemCodeInfo( g_szItemCode , "name")
			g_sCode = Split(g_szItemCode, "@")
			g_szIteminfo = g_sCode(0)
			'g_szExid = Transform_Exid2(g_szIteminfo)
			g_szExid = g_sCode(0)
			g_szItemCode = g_sCode(1)
			
			ItemCode01.caption = g_sCode
			
			
			DATAMANAGER.RequestTranData( "ohhts_news_001r" )			
		end	if
	end	if
End Sub	

'20230721 주석처리
