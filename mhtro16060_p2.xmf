				end if
			
			end if
		
		end if
	' 20190502 HWG END
	end if
	
	g_szUnit = szUnit
	
End Function
'20180710 HAMWG END

'============================================================================
' 가격 호가단위 맞추기 
'============================================================================
Function ReSet_Prc(szData, nGbn)	
	if nGbn == 0 then
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))

		if nResult <> 0 and nResult <> CDbl(g_szUnit) then
			return CDbl(szData) - nResult
		else
			return szData
		end if
	else
		nResult = Round(CDbl(szData) Mod CDbl(g_szUnit), CInt(g_szDecimal))
	
		if nResult <> 0 then
			return CDbl(szData) + (CDbl(g_szUnit) - nResult)
		else
			return szData
		end if
	end if
End Function

'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
'============================================================================
Function Calc_Price(nGbn)
	Dim szPrc, szUnit, szHigh, szLow, szHyun, nResult
	
	g_szReceive = ""
	szPrc  = ReSet_Prc(edtPrc.caption, nGbn)
	GetHogaUnit(g_szMk, szPrc, nGbn)	'20180710 HAMWG : 호가단위 설정함수 변경
	szUnit = g_szUnit
	szHigh = edtHigh.caption
	szLow  = edtLow.caption
	szHyun = tblData.GetCellString(1, 1)
	
	szUnit = g_szUnit

	 ' 20160317 예외처리 추가 //////////////////////////////////////////////
	if Trim(szPrc) <> "" or CDbl(szPrc) == 0 then
		if CDbl(szPrc) >= 9900000 then
			if nGbn == 0 then
				Exit Function
			end if
		end if
	end if
	' //////////////////////////////////////////////////////////////////////
	if Trim(szPrc) == "" or CDbl(szPrc) == 0 then
		if szHyun == "" or CDbl(szHyun) == 0 then
			szPrc = 0
		else
			szPrc = CDbl(szHyun)
		end if
	else
		' + 버튼 클릭 /////////////////////////////
		if nGbn == 0 then							
			if CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if 
			elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀	
				if szLow <> "0" then
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if
			else
				
				szPrc = CDbl(szPrc) + CDbl(szUnit)
				
			end if
		' - 버튼 클릭 ////////////////////////////
		elseif nGbn == 1 then						
			if CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if 		
			elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
				if szLow <> "0" then
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if
			else
				szPrc = CDbl(szPrc) - CDbl(szUnit)
				
			end if
		end if
	end if
	
	if Cdbl(szPrc) < 0 then
		szPrc = 0
	end if

	Sum_Prc(szPrc, 0)
End Function

'============================================================================
' Calc_Plus
'============================================================================
Function Calc_Plus(nPlus)
	Dim szPrc
	
	if g_szReceive == "1" then
		g_szReceive = ""
		edtPrc.caption = nPlus
	else
		szPrc = edtPrc.caption
		
		szChk = InStr(edtPrc.caption, ".")
		
		if CStr(szChk) <> "0" then	
			szCha = CInt(Len(edtPrc.caption) - szChk)
			  
			if CStr(szCha) == g_szDecimal then
				Exit Function
			end if
		end if
		
		szPrc = szPrc & nPlus
		Sum_Prc(szPrc, 1)
	end if
End Function

'============================================================================
' Calc_Zero
'============================================================================
Function Calc_Zero(szPlus)
	Dim szPrc

	if g_szReceive == "1" then
		g_szReceive = ""
		edtPrc.caption = ""
	end if
	
	szPrc = Trim(edtPrc.caption)

	' 20160328 첫번째 0은 입력처리 필요 ////////////////////////////////////
	if szPlus == "0" or szPlus == "00" then
		if szPrc == "0" then
			Exit Function
		elseif szPrc == "" then
			edtPrc.caption = "0"
			Exit Function
		end if
	end if
	' /////////////////////////////////////////////////////////////////////
	
	' "."이 있는지 체크
	szChk = InStr(edtPrc.caption, ".")

	if CStr(szChk) <> "0" then
		if Trim(szPlus) == "." then
			Exit Function
		else
			szCha = CInt(Len(edtPrc.caption) - szChk)
			  
			if CStr(szCha) == g_szDecimal then
				Exit Function
			elseif CStr(szCha) == "1" then
				if Len(szPlus) == 1 then
					'edtPrc.caption = edtPrc.caption & szPlus
					szPrc = edtPrc.caption & szPlus
					Sum_Prc(szPrc, 1)
				end if
				
				Exit Function
			end if
		end if
	end if
	
	if Len(edtPrc.caption) > 0 then
		'edtPrc.caption = edtPrc.caption & szPlus
		szPrc = edtPrc.caption & szPlus
		Sum_Prc(szPrc, 1)
	end if
End Function

'============================================================================
' Sum_Prc
'============================================================================
Function Sum_Prc(szData, nGbn)
	'if Len(szData) < 16 then
	if Len(szData) < 10 then		' Max 7(20160317 전요셉과장)	
		if nGbn == 0 then
			szData = Set_Unit(szData)
		end if
		
		edtPrc.caption = szData
	end if
End Function	

'============================================================================
' Set_Unit
'============================================================================
Function Set_Unit(szData)
	
	sztemp = CStr(szData)
	szChk = InStr(sztemp, ".")
	
	if CStr(szChk) == "0" then
		if g_szDecimal = "1" then
			szData = szData & ".0"	
		elseif g_szDecimal = "2" then
			szData = szData & ".00"	
		elseif g_szDecimal = "3" then
			szData = szData & ".000"	
		elseif g_szDecimal = "4" then
			szData = szData & ".0000"	
		end if 
	else
		szCha = CInt(Len(szData) - szChk)
	
	
		if CStr(szCha) == "1" then 
			if g_szDecimal == "2" then
				szData = szData & "0"	
			elseif g_szDecimal == "3" then
				szData = szData & "00"	
			elseif g_szDecimal == "4" then
				szData = szData & "000"
			else 
				szData = szData
			end if 	
		elseif CStr(szCha) == "2" then 
			if g_szDecimal == "3" then
				szData = szData & "0"	
			elseif g_szDecimal == "4" then
				szData = szData & "00"
			else
				szData = szData
			end if	
		elseif CStr(szCha) == "3" then 
			if g_szDecimal == "4" then
				szData = szData & "0"
			else 
				szData = szData
			end if	
		else
			szData = szData
		end if
	end if
	
	return szData
End Function

'============================================================================
' Request_Data
'============================================================================
Function Request_Data()
	DATAMANAGER.RequestTranData("ohhts_6000_007r")		' 현재가(호가&예상체결)	
	DATAMANAGER.RequestTranData("ohhts_6000_017r")		'20221213_01 KBC 해외주식주간거래
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	
	Form.SetScreenName("가격입력기")
	szOpen = Form.GetOpenLinkData()
	if Trim(szOpen) <> "" then
		tData = Split(szOpen, "★")
		
		g_szDecimal 		= tData(7)
		
		sMask = "0,0,,,0,,"..g_szDecimal..",1,1,2,0"
		'sMask = "1,0,,,0,,"..g_szDecimal..",1,1"
		
		' 20190617 HWG START
		'안드로이드에서 소수점 가격입력 시, 정상적으로 소수점이 입력되지 않아
		'임시로 ios만 마스킹처리(안드로이드는 컨트롤 마스킹 설정대로 처리)
		
		szOstype = Form.GetSharedData("&OS_TYPE", false )  'iOS("2") Android("1") 기타("9")
		
		if szOstype = "2" then
			edtPrc.mask = sMask
		end if 
		' 20190617 HWG END
		
		tblData.SetCellMaskInfo(1, 0, sMask)
		tblData.SetCellMaskInfo(1, 1, sMask)
		tblData.SetCellMaskInfo(1, 2, sMask)
		
		'20221213_01 KBC 해외주식주간거래
		tblData0.SetCellMaskInfo(1, 0, sMask)
		tblData0.SetCellMaskInfo(1, 1, sMask)
		tblData0.SetCellMaskInfo(1, 2, sMask)		
		tblData0.SetCellMaskInfo(1, 3, sMask)		
		
		g_szReceive = "1"
		edtPrc.caption 	= tData(0)
		g_szCd   		= tData(1)
		g_szMk   		= tData(2)
		g_szUnit 		= tData(3)
		g_szType 		= tData(4)
		edtHigh.caption 	= tData(5)
		edtLow.caption  	= tData(6)
		g_szTickType		= tData(8)
		
		
		'20221213_01 KBC START 해외주식주간거래 
		Dim sCodeData
	
		sCodeData = {}	' sCodeData[1] 마켓, sCodeData[2] 코드
		sCodeData = Split( g_szCd, "@" )
		sValue = sCodeData[0]
		
		if sValue == "NY" or sValue == "AX" or sValue == "OQ" then
			tblData0.left = 0
			tblData0.top = 311
		
			tblData.visible = false
			tblData0.visible = true
		else
			tblData.visible = true
			tblData0.visible = false
		end if
		'20221213_01 KBC END		
		
		Request_Data()
	end if
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData("HOGA")
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'20221213_01 KBC 해외주식주간거래
	if szTranID == "ohhts_6000_007r" or szTranID == "ohhts_6000_017r" then
		Dim sCodeData, szDelay
	
		sCodeData = {}	' sCodeData[1] 마켓, sCodeData[2] 코드
		sCodeData = Split( g_szCd, "@" )
		
		szDelay = Form.GetSharedData("REALTIME_"..sCodeData[0], 0 )

		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" ) ' 해외주식 OV
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , sCodeData[1] ) ' 종목코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , sCodeData[0] ) ' 거래소코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szDelay ) ' 실시간구분 0 : 실시간 (Default), 1:지연
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 현재가(호가&예상체결)
	' ----------------------------------------------------------------------			
	if szTranID = "ohhts_6000_007r" then	
		DATAMANAGER.RequestRealData( "ohhts_exst_aspr" )
		DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )
	
	'20221213_01 KBC 해외주식주간거래
	elseif szTranID = "ohhts_6000_017r" then	
		DATAMANAGER.RequestRealData( "ohhts_exst_cntd" ) 
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	if szTranID == "ohhts_exst_aspr" then
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_aspr", "InBlock1", "FIDXR_ISCD" , 0 , g_szCd )
	elseif szTranID == "ohhts_exst_cntg" then
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , g_szCd )	
	'20221213_01 KBC 해외주식주간거래		
	elseif szTranID == "ohhts_exst_cntd" then 
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntd", "InBlock1", "FIDXR_ISCD" , 0 , g_szCd )		
	end if
End Sub

