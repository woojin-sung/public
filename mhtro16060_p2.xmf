'20180710 HAMWG START : 호가단위 설정함수 변경
'============================================================================
' 거래소 호가단위 설정
'============================================================================
Function GetHogaUnit(szMk, szPrc, nGbn) 
	szOrdPrc = CDbl(szPrc)
	
	if szOrdPrc == "" then
		szOrdPrc = CDbl(g_szLast)		
	end if
	
	szUnit = "1.000"
	
	'20200310 LES START 홍콩 ETF종목 호가단위 변경
	szTtype = Cint(g_szTickType)
		
	if szTtype == 0 or szTtype == "" then
		szTtype = "0"
	end if
		
	if szMk == "0215" then '상해
		szUnit = "0.010"
		
	elseif szMk == "0214" then '심천
		szUnit = "0.010"
		
	elseif szMk == "0321" or szMk == "0537" or szMk == "0066" then '뉴욕, 나스닥, 아멕스
		if szTtype == 1 then
			szUnit = "0.010"
			
		elseif szTtype == 2 then
			szUnit = "0.050"
			
		elseif szTtype == 3 then
			szUnit = "0.050"
			
		elseif szTtype == 4 then
			szUnit = "0.050"
			
		else
			szUnit = "0.010"
			
		end if
		
	elseif szMk == "0104" then '홍콩
		
		if szTtype == 3 then
			szUnit = "0.050"
			
		'20200310 LES START 홍콩 ETF종목 호가단위 변경
		'type = 5 (ETF종목) 추가
		elseif szTtype == 5 then
			
			if nGbn == 0 then
				if szOrdPrc < 1.00 then
					szUnit = "0.001"
				elseif szOrdPrc < 5.00 then
					szUnit = "0.002"
				elseif szOrdPrc < 10.00 then
					szUnit = "0.005"
				elseif szOrdPrc < 20.00 then
					szUnit = "0.010"
				elseif szOrdPrc < 100.00 then
					szUnit = "0.020"
				elseif szOrdPrc < 200.00 then
					szUnit = "0.050"
				elseif szOrdPrc < 500.00 then
					szUnit = "0.100"
				elseif szOrdPrc < 1000.00 then
					szUnit = "0.200"
				elseif szOrdPrc < 2000.00 then
					szUnit = "0.500"
				else
					szUnit = "1.000"
				end if
			
			else
				if szOrdPrc <= 1.00 then
					szUnit = "0.001"
				elseif szOrdPrc <= 5.00 then
					szUnit = "0.002"
				elseif szOrdPrc <= 10.00 then
					szUnit = "0.005"
				elseif szOrdPrc <= 20.00 then
					szUnit = "0.010"
				elseif szOrdPrc <= 100.00 then
					szUnit = "0.020"
				elseif szOrdPrc <= 200.00 then
					szUnit = "0.050"
				elseif szOrdPrc <= 500.00 then
					szUnit = "0.100"
				elseif szOrdPrc <= 1000.00 then
					szUnit = "0.200"
				elseif szOrdPrc <= 2000.00 then
					szUnit = "0.500"
				else
					szUnit = "1.000"
				end if
			
			end if
		
		'20200310 LES END
		
		else
			if nGbn == 0 then
				if szOrdPrc < 0.25 then
					szUnit = "0.001"
		
				elseif szOrdPrc < 0.50 then
					szUnit = "0.005"
		
				elseif szOrdPrc < 10.00 then
					szUnit = "0.010"
		
				elseif szOrdPrc < 20.00 then	
					szUnit = "0.020"
		
				elseif szOrdPrc < 100.00 then
					szUnit = "0.050"
					
				elseif szOrdPrc < 200.00 then
					szUnit = "0.100"
		
				elseif szOrdPrc < 500.00 then
					szUnit = "0.200"
		
				elseif szOrdPrc < 1000.00 then
					szUnit = "0.500"
		
				elseif szOrdPrc < 2000.00 then
					szUnit = "1.000"
		
				elseif szOrdPrc < 5000.00 then
					szUnit = "2.000"
		
				else
					szUnit = "5.000"
		
				end if
			else
				if szOrdPrc <= 0.25 then
					szUnit = "0.001"
		
				elseif szOrdPrc <= 0.50 then
					szUnit = "0.005"
		
				elseif szOrdPrc <= 10.00 then
					szUnit = "0.010"
		
				elseif szOrdPrc <= 20.00 then	
					szUnit = "0.020"
		
				elseif szOrdPrc <= 100.00 then
					szUnit = "0.050"
					
				elseif szOrdPrc <= 200.00 then
					szUnit = "0.100"
		
				elseif szOrdPrc <= 500.00 then
					szUnit = "0.200"
		
				elseif szOrdPrc <= 1000.00 then
					szUnit = "0.500"
		
				elseif szOrdPrc <= 2000.00 then
					szUnit = "1.000"
		
				elseif szOrdPrc <= 5000.00 then
					szUnit = "2.000"
		
				else
					szUnit = "5.000"
		
				end if
			
			end if
			
		end if
	' 20190502 HWG START
	' 해외주식 일본시장(도쿄거래소) 추가
	elseif szMk == "0106" then '도쿄
		if szTtype == 3 then
			if nGbn == 0 then
				if szOrdPrc < 1000 then
					szUnit = "0.1"
		
				elseif szOrdPrc < 3000 then
					szUnit = "0.5"
		
				elseif szOrdPrc < 5000 then
					szUnit = "1"
		
				elseif szOrdPrc < 10000 then	
					szUnit = "1"
		
				elseif szOrdPrc < 30000 then
					szUnit = "5"
					
				elseif szOrdPrc < 50000 then
					szUnit = "10"
		
				elseif szOrdPrc < 100000 then
					szUnit = "10"
		
				elseif szOrdPrc < 300000 then
					szUnit = "50"
		
				elseif szOrdPrc < 500000 then
					szUnit = "100"
		
				elseif szOrdPrc < 1000000 then
					szUnit = "100"
				
				elseif szOrdPrc < 3000000 then
					szUnit = "500"
					
				elseif szOrdPrc < 5000000 then
					szUnit = "1000"
					
				elseif szOrdPrc < 10000000 then
					szUnit = "1000"
					
				elseif szOrdPrc < 30000000 then
					szUnit = "5000"
		
				else 
					szUnit = "10000"
		
				end if
			else
				if szOrdPrc <= 1000 then
					szUnit = "0.1"
		
				elseif szOrdPrc <= 3000 then
					szUnit = "0.5"
		
				elseif szOrdPrc <= 5000 then
					szUnit = "1"
		
				elseif szOrdPrc <= 10000 then	
					szUnit = "1"
		
				elseif szOrdPrc <= 30000 then
					szUnit = "5"
					
				elseif szOrdPrc <= 50000 then
					szUnit = "10"
		
				elseif szOrdPrc <= 100000 then
					szUnit = "10"
		
				elseif szOrdPrc <= 300000 then
					szUnit = "50"
		
				elseif szOrdPrc <= 500000 then
					szUnit = "100"
		
				elseif szOrdPrc <= 1000000 then
					szUnit = "100"
		
				elseif szOrdPrc <= 3000000 then
					szUnit = "500"
					
				elseif szOrdPrc <= 5000000 then
					szUnit = "1000"
					
				elseif szOrdPrc <= 10000000 then
					szUnit = "1000"
					
				elseif szOrdPrc <= 30000000 then
					szUnit = "5000"
		
				else 
					szUnit = "10000"
		
				end if
			
			end if	
		else
			if nGbn == 0 then
				if szOrdPrc < 1000 then
					szUnit = "1"
		
				elseif szOrdPrc < 3000 then
					szUnit = "1"
		
				elseif szOrdPrc < 5000 then
					szUnit = "5"
		
				elseif szOrdPrc < 10000 then	
					szUnit = "10"
		
				elseif szOrdPrc < 30000 then
					szUnit = "10"
					
				elseif szOrdPrc < 50000 then
					szUnit = "50"
		
				elseif szOrdPrc < 100000 then
					szUnit = "100"
		
				elseif szOrdPrc < 300000 then
					szUnit = "100"
		
				elseif szOrdPrc < 500000 then
					szUnit = "500"
		
				elseif szOrdPrc < 1000000 then
					szUnit = "1000"
				
				elseif szOrdPrc < 3000000 then
					szUnit = "1000"
					
				elseif szOrdPrc < 5000000 then
					szUnit = "5000"
					
				elseif szOrdPrc < 10000000 then
					szUnit = "10000"
					
				elseif szOrdPrc < 30000000 then
					szUnit = "10000"
		
				else 
					szUnit = "50000"
		
				end if
			else
				if szOrdPrc <= 1000 then
					szUnit = "1"
		
				elseif szOrdPrc <= 3000 then
					szUnit = "1"
		
				elseif szOrdPrc <= 5000 then
					szUnit = "5"
		
				elseif szOrdPrc <= 10000 then	
					szUnit = "10"
		
				elseif szOrdPrc <= 30000 then
					szUnit = "10"
					
				elseif szOrdPrc <= 50000 then
					szUnit = "50"
		
				elseif szOrdPrc <= 100000 then
					szUnit = "100"
		
				elseif szOrdPrc <= 300000 then
					szUnit = "100"
		
				elseif szOrdPrc <= 500000 then
					szUnit = "500"
		
				elseif szOrdPrc <= 1000000 then
					szUnit = "1000"
				
				elseif szOrdPrc <= 3000000 then
					szUnit = "1000"
					
				elseif szOrdPrc <= 5000000 then
					szUnit = "5000"
					
				elseif szOrdPrc <= 10000000 then
					szUnit = "10000"
					
				elseif szOrdPrc <= 30000000 then
					szUnit = "10000"
		
				else 
