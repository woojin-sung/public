Sub DATAMANAGER_OnSendTranBefore(szTranID)
	'외화 가상계좌 정보
	if szTranID == "obtsd_fbnk_005r" or szTranID == "obtsd_fbnk_005r_1" then
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "TACT_LNKD_ISTU_CODE",	0, "701")			'이체연계기관코드
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ACNO", 				0, g_szACNO)	'계좌번호
		DATAMANAGER.SetDataValue(false, szTranID, "InBlock1", "ASNO", 				0, g_szASNO)	'계좌일련번호
	elseif szTranID == "obtss_elbs_221r" then
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "LNKD_BANK_CLS_CODE" , 0, g_szLNKD_BANK_CLS_CODE  )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TR_DATE"            , 0, g_szTR_DATE             )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "OTSD_TR_UNIQ_NO"    , 0, g_szOTSD_TR_UNIQ_NO     )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TACT_LNKD_ISTU_CODE", 0, g_szTACT_LNKD_ISTU_CODE )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "TACT_STND_TR_CODE"  , 0, g_szTACT_STND_TR_CODE   )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "LNKD_TLMS_MNNO"     , 0, g_szLNKD_TLMS_MNNO      )
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock1", "RPCS_TMNU"          , 0, g_szRcvn_iqry_tmnu      )
		
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "DRNG_ACNO"          , 0, g_szACNO      		   ) '계좌번호
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "ACNT_PROD_CLS_CODE" , 0, g_szASNO			   ) '계좌일련번호
		DATAMANAGER.SetDataValue (0, szTranID, "InBlock2", "PWD"                , 0, ""				   ) '비밀번호
	elseif szTranID == "obcsb_oimf_638r" then
		g_szUserID       = Form.GetSharedData("&USER_ID"   , False) '고객아이디
		g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
		
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ELFN_ID"          , 0 , g_szUserID        )'사용자ID
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID()) 'UI단말식별키
		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "ACNO"             , 0 , g_szACNO          )
	
'		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock1" , "PROS_CLS" , 0 , "1")	'기존
		
		'이체가 아니라서 SVCD 매핑 안해도 됨
'		If g_szCertUserType == "1" Then
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "201")	'201 SPIN 로그인 이체
'		ElseIf g_szCertUserType == "3" Or g_szCertUserType == "4" Then
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "203")	'203 바이오 로그인 이체
'		ElseIf g_szCertUserType == "5" Then 'v002
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "205")	'205 사설인증 로그인 이체
'		Else
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "SVCD" , 0 , "200")'이체	'기본 '200'  등록 '400'
'		End If
		
'		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "DRNG_ACNO"      , 0 , g_szACNO       )
'		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "DRNG_ASNO"      , 0 , g_szASNO       )
'		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_BANK_CODE" , 0 , g_szBankCode   )
'		DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TACT_AMT"       , 0 , g_szSendAmt    )
'		
'		If g_szBankCode == "287" Then
'			DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TACT_CLS_CODE" , 0 , "01"                     )'대체출금
'			DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_ACNO"     , 0 , Left(g_szBankAcno, 8) )
'			DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_ASNO"     , 0 , Right(g_szBankAcno, 2))
'		Else
'			DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "TACT_CLS_CODE" , 0 , "03"           )'이체출금
'			DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_ACNO"     , 0 , g_szBankAcno   )
'			DATAMANAGER.SetDataValue(0 , szTranID , "InBlock2" , "MNRC_ASNO"     , 0 , ""             )
'		End If
	elseif szTranID == "obpds_srvc_186r" then
		szCsno = Form.GetSharedData("61140_Csno", false )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "PROS_CLS_CODE" , 0 , "1")
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CSNO" , 0 , szCsno )
		DATAMANAGER.SetDataValue( 0, szTranID , "InBlock1" , "CUST_ENG_NAME" , 0 , g_szBankAcntNm )
	End if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	'외화 가상계좌 정보
	if szTranID == "obtsd_fbnk_005r" then
		Dim REG_YN, CUST_ENG_NAME, BANK_NAME, OPNG_DATE, VRTL_ACNO
'		REG_YN		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "REG_YN", 			0)	' 등록여부
		CUST_ENG_NAME	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "CUST_ENG_NAME",	0)	' 고객영문명
		contFor.lblEngName.caption = CUST_ENG_NAME
		
		g_szCUST_ENG_NAME = CUST_ENG_NAME
		
		f_RegistAble()
		
'	elseif szTranID == "obtsd_fbnk_005r_1" then
'		szCSNM	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "CSNM",	0)	' 고객명
'		if g_szBankAcntNm == szCSNM then
'			f_RegistAble()
'		else
'			Form.MsgBox("알림", "본인 계좌만 등록 가능합니다.", "", 6)
'			f_Reset()
'		end if
	elseif szTranID == "obpds_srvc_186r" then
		szIF_SPEC_LETT_USE_INFO	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "IF_SPEC_LETT_USE_INFO",	0)	
		
		'V001
		szENG_NAME_AGR_YN			= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "ENG_NAME_AGR_YN",	0)	
		szIF_KOR_USE_INFO			= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "IF_KOR_USE_INFO",	0)	
		szFLNM_AGR_YN				= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "FLNM_AGR_YN",	0)	
		
		if szIF_SPEC_LETT_USE_INFO == "Y" then'특수문자 포함이라 불가능=리셋
			Form.MsgBox("알림", "해당 특수 문자만 입력 가능합니다.\n/  -  ?  :  (  )  ,  .  ‘  +", "DISABLE_MSG", 6)
'			f_Reset()
			
			'20231113 세팅된 계좌정보는 유지하고 하단 버튼만 비활성화
			f_RegistAble()
			btnReg.enable = false
	
		else
			
			'V001 f_RegistAble()
			'V001 조건 추가
			if szIF_KOR_USE_INFO == "Y" then	'한글포함여부
				if szFLNM_AGR_YN == "Y" then	'한글명일치조건에 해당함.
				
				     'V001 타기관내계좌일때.. 
				     if g_szTabIdx == "1" then
						Form.SetSharedData("61140_stpl_yn" , "Y")
				     else
						Form.SetSharedData("61140_stpl_yn" , "N")
				     end if				
				
					'출금계좌번호★출금계좌순번★입금은행코드★입금은행계좌★입금은행BIC코드★통화코드
					szData = g_szACNO .."★".. g_szASNO .."★".. g_szBankCode .."★".. g_szBankAcno .."★".. g_szBicCode .."★".. g_szCurr
					Form.OpenPopupAnimation("mbbnk64010_p7" , szData , "" , "2")
				else
					Form.MsgBox("알림", "본인 계좌만 등록 가능합니다.", "btnReg_Enable_YN", 6)
					exit sub
				end if
			else
				if szENG_NAME_AGR_YN == "Y" then	'영문명일치조건에 해당함..
					f_RegistAble()
				else
					Form.MsgBox("알림", "본인 계좌만 등록 가능합니다.", "btnReg_Enable_YN", 6)
					exit sub				
				end if
			end if 
			
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = Trim(DATAMANAGER.GetDataMsgSubText( szTranID ))
	If szSubErr == "" Then
		Form.MsgBox( "알림", szErrMsg, "", 6 )		
	Else
		Form.MsgBox( "알림", szSubErr, "", 6 )
	End if
End Sub

Sub f_RegistAble()
	
'	if contInfo.edtRecAcno.caption <> "" and contInfo.lblAcntName.caption <> "" then
	if contInfo.edtRecAcno.caption <> "" then
		btnReg.enable = true
	else
		btnReg.enable = false
		exit sub
	end if
	
	if g_szRdoIdx == "1" then'외화
		if contFor.lblEngName.caption == "" or g_szCurr == "" then
			btnReg.enable = false
		else
			btnReg.enable = true
		end if
'	else
'		btnReg.enable = true
	end if
	
end Sub
'============================================================================
Sub Account0_ChangeAccount()
	szVisibleAcnt = Account0.total
	nIdx = 0
	
	for i = 0 to CInt(Account1.accountcount) - 1
		Account1.currentindex = i
		szNvisibleAcnt = Account1.total
		
		if szNvisibleAcnt == szVisibleAcnt then
			nIdx = i
		end if
	next
	
	Account1.currentindex = nIdx
	
	g_szACNO = Account1.total
	g_szASNO = Account1.sequence
	
	f_Reset()
End Sub

Sub f_Reset()
	if g_FrcrSrvcYn= "Y" then 
		contInfo.lblBankName.caption = "은행 선택"
	else
		contInfo.lblBankName.caption = "은행/증권사 선택"
	end if
	
	contInfo.lblBankName.fgcolor = "322"
	
	contInfo.imgLogo.visible = false
	
	contInfo.edtRecAcno.caption = ""
	contInfo.lblAcntName.caption = ""
	
	btnReg.enable = false
	
	g_szBankCode = ""
	g_szBankAcno = ""
	g_szBankName = ""
	g_szBankAcntNm = ""
end Sub 

Sub SendReg()
	g_szAcntName = contInfo.lblAcntName.caption

	szData = g_szBankCode.."★"..g_szBankAcno .."★"..g_szBankName .."★"..g_szBankAcntNm .."★"..g_szNickName .."★"..g_szBicCode .."★"..g_szAcntName .."★"..g_szCurr.."★"..g_szPwd.."★"..g_szPwdEnc.."★"..Account0.total

	Form.SendReturnToParent("mbbnk61140_p1" , szData)
	Form.CloseForm()
end Sub
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)

	if sKeyName == "btnReg_Enable_YN" and sRet = "close" then
		''수취조회 후, 본인계좌 아닌 경우 알림 확인하면 수취조회 결과는 화면에 표시 & 등록버튼 비활성
		
		contInfo.lblBankName.caption = "         "..g_szBankName
		contInfo.lblBankName.fgcolor = "4"
		
		contInfo.imgLogo.imgpath = "bank"..g_szBankCode
		contInfo.imgLogo.visible = true
		
		contInfo.edtRecAcno.caption = g_szBankAcno
		contInfo.lblAcntName.caption = g_szBankAcntNm
		
		
		btnReg.enable = false		
	end if
	
End Sub

