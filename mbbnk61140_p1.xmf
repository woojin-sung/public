'============================================================================
' 2024-01-15 V001 약정시 기약정고객 관련 로직 분리
'============================================================================

dim g_szBankCode, g_szBankAcno, g_szBankName, g_szBankAcntNm, g_szNickName, g_szBicCode, g_szAcntName
g_szNickName = ""
g_szBicCode = ""
dim g_szCUST_ENG_NAME
dim g_bFor
g_bFor = false
dim g_szCurr
g_szCurr = ""
dim g_szACNO, g_szASNO
dim g_szRdoIdx
dim g_szTabIdx
dim g_szPwd, g_szPwdEnc, g_szCUST_ABWR_NAME
g_szPwd = ""
g_szPwdEnc = ""
dim g_FrcrSrvcYn 

'============================================================================
Sub Form_OnFormInitBefore()
	imgClose.setmaintainingRatio("1")
	contInfo.imgLogo.setmaintainingRatio("1")
	contInfo.imgArrow.setmaintainingRatio("1")
	Image0.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
	contFor.imgLogo0.setMaintainingRatio("1")'이미지 찌그러짐 방지 API
End Sub

'============================================================================
Sub Form_OnFormInit()

	contFor.lblbNameRegist.caption = "등록하기 >"
	contFor.lblbNameRegist.fgcolor = "67"
	
	szData = Form.GetOpenLinkData( )
	
	g_FrcrSrvcYn = "N"
	
	if szData <> "" then
		tData = Split(szData,"★")
		
		g_szTabIdx = tData(0)
		g_szCUST_ENG_NAME = tData(1)
		g_szACNO = tData(2)
		g_szASNO = tData(3)
		
		g_szRdoIdx = tData(4)'0=원화 1=외화
		g_szCUST_ABWR_NAME = tData(5)
		
		dim szFindIdx
		szFindIdx = "0"'초기화
			
		for i = 0 to CInt(Account0.accountcount) - 1
		    Account0.currentindex = i
		    szAcnt = Account0.total
		    if szAcnt == g_szACNO then
		        szFindIdx = i
		    end if
		next
			
		Account0.currentindex = szFindIdx
		Account1.currentindex = szFindIdx		
		
		if g_szTabIdx == "0" then'자주
			if g_szRdoIdx == "1" then
				g_FrcrSrvcYn = "Y"
				lblTitle.caption = "외화계좌 등록"
				contFor.top = 102
				contInfo.top = 102 + 170 + 5 + 10
				contFor.visible = true
			else
				contFor.visible = false
			end if
		else'타금융
			Image0.visible = false
			Label0.caption = "내명의 계좌를 등록하고 유선으로 이체할 수 있어요."
			g_bFor = true
			Account0.visible = true
			Label0.top = 87 + 10

			if g_szRdoIdx == "1" then
				g_FrcrSrvcYn = "Y"
				lblTitle.caption = "외화계좌 등록"
				contFor.top = 102 + 35
				contInfo.top = 102 + 35 + 170 + 5 + 10
				contFor.visible = true
			else
				contInfo.top = 102 + 35
				contFor.visible = false
			end if
		end if
		
		contFor.lblEngName.caption = g_szCUST_ENG_NAME
		
		if g_szCUST_ENG_NAME = "" then
			contFor.lblbNameRegist.visible = true
		else
			contFor.lblbNameRegist.visible = false
		end if
		
		f_Reset()
	end if
	
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contInfo_btnSelectBank_OnClick()	
	if g_szRdoIdx == "1" and ( g_szCUST_ENG_NAME == "" or g_szCUST_ENG_NAME == null ) then
		Form.MsgBox("알림", "고객영문명 먼저 등록 후\n외화계좌 등록을 진행해주세요.", "", 6)
		exit sub
	end if
	
	if g_szRdoIdx == "1" then
		if g_szCurr == "" then
			Form.MsgBox("알림", "외화구분을 먼저 선택해주세요.", "", 6)
			exit sub
		else			
		     'V001 타기관내계좌일때.. 
		     if g_szTabIdx == "1" then
				Form.SetSharedData("61140_stpl_yn" , "Y")
		     else
		         Form.SetSharedData("61140_stpl_yn" , "N")
		     end if
			Form.SetSharedData("61140_CurrencyCode" , g_szCurr)
			szData = "287★★메리츠증권★KFBCKRSE★SelectBank★"..g_szTabIdx.."★".. g_szACNO .."★"..g_szASNO
			Form.OpenPopupAnimation("mbbnk61140_p4" , szData , "" , "2")
		end if		
	else
		'타기관내계좌일때 기관선택에서 메리츠증권을 제외하기 위한 플래그
		if g_szTabIdx == "1" then
			Form.SetSharedData("61140_NoMeritz", "Y")
		end if
		szData = "287★★메리츠증권★SelectBank★"
		Form.OpenPopupAnimation("mbbnk63010_p3" , szData , "" , "2")
	end if
	
	'20231120 기입력된 데이터가 삭제되지 않도록 아래 스크립트 주석처리
'	contInfo.lblAcntName.caption = ""
'	contInfo.edtRecAcno.caption = ""
'	g_szBankAcntNm = ""
'	btnReg.enable = false
End Sub

'============================================================================
Sub contInfo_btnRecAcno_OnClick()
	if g_szRdoIdx == "1" and ( g_szCUST_ENG_NAME == "" or g_szCUST_ENG_NAME == null ) then
		Form.MsgBox("알림", "고객영문명 먼저 등록 후\n외화계좌 등록을 진행해주세요.", "", 6)
		exit sub
	end if
	
	if g_szRdoIdx == "1" then
		if g_szCurr == "" then
			Form.MsgBox("알림", "외화구분을 먼저 선택해주세요.", "", 6)
			exit sub
		else
		     'V001 타기관내계좌일때.. 
		     if g_szTabIdx == "1" then
				Form.SetSharedData("61140_stpl_yn" , "Y")
		     else
		         Form.SetSharedData("61140_stpl_yn" , "N")
		     end if
		     
			'20231113 계좌 입력된 상태일 경우 입력한 계좌값 물고 팝업 띄움
			if g_szBankCode <> "" and g_szBankAcno <> "" and g_szBankName <> "" and g_szBicCode <> "" then
				szData = g_szBankCode .. "★" .. g_szBankAcno .. "★" .. g_szBankName .. "★" .. g_szBicCode .. "★EditAcno★" ..g_szTabIdx.."★".. g_szACNO .."★"..g_szASNO
				Form.OpenPopupAnimation("mbbnk61140_p4" , szData , "" , "2")
			else
				Form.SetSharedData("61140_CurrencyCode" , g_szCurr)
				szData = "287★★메리츠증권★KFBCKRSE★SelectBank★"..g_szTabIdx.."★".. g_szACNO .."★"..g_szASNO
				Form.OpenPopupAnimation("mbbnk61140_p4" , szData , "" , "2")
				
				contInfo.lblAcntName.caption = ""
				contInfo.edtRecAcno.caption = ""
				g_szBankAcntNm = ""
				btnReg.enable = false
			end if
		end if
	else
		
		'타기관내계좌일때 기관선택에서 메리츠증권을 제외하기 위한 플래그
		if g_szTabIdx == "1" then
			Form.SetSharedData("61140_NoMeritz", "Y")
		end if
		
		'20231113 계좌 입력된 상태일 경우 입력한 계좌값 물고 팝업 띄움
		if g_szBankCode <> "" and g_szBankAcno <> "" and g_szBankName <> "" then
			szData = g_szBankCode .. "★" .. g_szBankAcno .. "★" .. g_szBankName .. "★EditAcno"
			Form.OpenPopupAnimation("mbbnk63010_p3" , szData , "" , "2")
		else
			szData = "287★★메리츠증권★SelectBank"
			Form.OpenPopupAnimation("mbbnk63010_p3" , szData , "" , "2")
			
			contInfo.lblAcntName.caption = ""
			contInfo.edtRecAcno.caption = ""
			g_szBankAcntNm = ""
			btnReg.enable = false
		end if
	end if
	
'	contInfo.lblAcntName.caption = ""
'	contInfo.edtRecAcno.caption = ""
'	g_szBankAcntNm = ""
'	btnReg.enable = false
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mbbnk63010_p3" then'원화용 팝업
		if sRet <> "" then
			'g_szBankCode..★..g_szBankAcno..★..g_szBankName..★..szName
			arrBankInfo = Split(sRet, "★")
			g_szBankCode = arrBankInfo(0)
			g_szBankAcno = arrBankInfo(1)
			g_szBankName = arrBankInfo(2)
			g_szBankAcntNm = arrBankInfo(3)
			
			contInfo.lblBankName.caption = "         "..g_szBankName
			contInfo.lblBankName.fgcolor = "4"
			
			contInfo.imgLogo.imgpath = "bank"..g_szBankCode
			contInfo.imgLogo.visible = true
			
			contInfo.edtRecAcno.caption = g_szBankAcno
			contInfo.lblAcntName.caption = g_szBankAcntNm
			if g_szTabIdx == "1" then'타금융 원화
'				DATAMANAGER.RequestTranData( "obtss_elbs_221r" )
				if trim(g_szCUST_ABWR_NAME) == trim(g_szBankAcntNm) then
					f_RegistAble()
				else
					Form.MsgBox("알림", "본인 계좌만 등록 가능합니다.", "", 6)
'					f_Reset()
					
					'20231117 명의 다른 계좌라도 수취결과는 보여주게 수정(하단 등록버튼은 비활성화)
					f_RegistAble()
					btnReg.enable = false
				end if
			else
				f_RegistAble()
			end if
		end if
'	elseif sKeyName == "mbbnk64010_p3" then'외화용 팝업
	elseif sKeyName == "mbbnk61140_p4" then'외화용 팝업
		if sRet <> "" then
			'szData = g_szBankCode..g_szSeparator..g_szBankAcno..g_szSeparator..g_szBankName..g_szSeparator..szName..g_szSeparator.. szSELF_ACNT_YN..g_szSeparator.. szCUST_ENG_NAME..g_szSeparator..szIF_KOR_USE_INFO
						'0						1							2						3						4						5								6
						
			g_szBicCode = Form.GetSharedData("64010_BicCode", false )
			
			arrBankInfo = Split(sRet, "★")
			
			'외화계좌등록시 통화 CNY 는 국민은행만 등록 가능
			if (g_szRdoIdx == "1" and g_szCurr == "CNY") and arrBankInfo(0) <> "004" then
				Form.MsgBox("알림", "[CNY] 타행 이체 외화계좌는\n국민은행만 등록 가능합니다.", "", 6)
				exit sub
			end if
			
			g_szBankCode = arrBankInfo(0)
			g_szBankAcno = arrBankInfo(1)
			g_szBankName = arrBankInfo(2)
			g_szBankAcntNm = arrBankInfo(3)
			
			'V001 위치이동..
			contInfo.lblBankName.caption = "         "..g_szBankName
			contInfo.lblBankName.fgcolor = "4"
			
			contInfo.imgLogo.imgpath = "bank"..g_szBankCode
			contInfo.imgLogo.visible = true
			
			contInfo.edtRecAcno.caption = g_szBankAcno
			contInfo.lblAcntName.caption = g_szBankAcntNm			
			
'			if g_szTabIdx == "1" and arrBankInfo(4) == "N" then
			if arrBankInfo(4) == "N" then
				Form.MsgBox("알림", "본인 계좌만 등록 가능합니다.", "btnReg_Enable_YN", 6)
				exit sub
			'V001 elseif ( arrBankInfo(4) == "Y" or arrBankInfo(4) == "S" ) and arrBankInfo(6) == "Y" then'본인명의이나 수취인명=고객한글명인 경우==팝업띄우고 확인시 186r 호출
			elseif arrBankInfo(4) == "Y" and arrBankInfo(6) == "Y" then'본인명의이나 수취인명=고객한글명인 경우==팝업띄우고 확인시 186r 호출			
				'출금계좌번호★출금계좌순번★입금은행코드★입금은행계좌★입금은행BIC코드★통화코드
				szData = g_szACNO .."★".. g_szASNO .."★".. g_szBankCode .."★".. g_szBankAcno .."★".. g_szBicCode .."★".. g_szCurr
				Form.OpenPopupAnimation("mbbnk64010_p7" , szData , "" , "2")
			'V001 elseif arrBankInfo(4) == "S" or (arrBankInfo(4) == "Y" and arrBankInfo(6) == "N") then'본인명의이나 수취인명이 고객일치조건에 해당하는 영문명임=바로 186r 호출
			else
				DATAMANAGER.RequestTranData("obpds_srvc_186r")
			end if
			
'			contInfo.lblBankName.caption = "         "..g_szBankName
'			contInfo.lblBankName.fgcolor = "4"
'			
'			contInfo.imgLogo.imgpath = "bank"..g_szBankCode
'			contInfo.imgLogo.visible = true
'			
'			contInfo.edtRecAcno.caption = g_szBankAcno
'			contInfo.lblAcntName.caption = g_szBankAcntNm
			
			'출금계좌번호★출금계좌순번★입금은행코드★입금은행계좌★입금은행BIC코드★통화코드
'			szData = g_szACNO .."★".. g_szASNO .."★".. g_szBankCode .."★".. g_szBankAcno .."★".. g_szBicCode .."★".. g_szCurr
'			Form.OpenPopupAnimation("mbbnk64010_p7" , szData , "" , "2")
			
		end if
		
	elseif sKeyName == "POPUP_TEXT" then
		if Trim(sRet) <> "" then
			g_szNickName = Trim(sRet)
			contInfo.Edit0.caption = Trim(sRet)
		end if
	elseif sKeyName == "mbbnk61140_p3" then
		if Trim(sRet) <> "" then
			g_szCurr = Trim(sRet)'통화코드
			contFor.lblBankName0.caption = g_szCurr
			contFor.lblBankName0.left = 65
			contFor.lblBankName0.fgcolor = 4
			
			if g_szCurr == "USD" then
				contFor.imgLogo0.imgpath = "flag_us2.png"
				contFor.imgLogo0.visible = true
			elseif g_szCurr == "JPY" then
				contFor.imgLogo0.imgpath = "flag_jp2.png"
				contFor.imgLogo0.visible = true
			elseif g_szCurr == "HKD" then
				contFor.imgLogo0.imgpath = "flag_hk.png"
				contFor.imgLogo0.visible = true
			elseif g_szCurr == "CNY" then
				contFor.imgLogo0.imgpath = "flag_chn.png"
				contFor.imgLogo0.visible = true
			end if
			f_RegistAble()
		end if
	elseif sKeyName == "NewEngName" then	
		if sRet == "ok" then
			'영문명 등록 후에는 등록하기 버튼 숨길 처리
			contFor.lblbNameRegist.visible = false
			
			DATAMANAGER.RequestTranData("obtsd_fbnk_005r")
		else
			f_Reset()
		end if
	elseif sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			Dim szAcnt
			
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPwd.pwdlen = tData(1)
				edtPwd.caption = tData(0)
				g_szPwd = edtPwd.caption

				if edtPwd.encdata == null then
					g_szPwdEnc = ""
				else
					g_szPwdEnc = edtPwd.encdata
				end if
			end if
			DATAMANAGER.RequestTranData("obcsb_oimf_638r")
			Form.OpenFramePopup("mhetc90060_p8" , "svc_ins" , "")
		end if
	elseif sKeyName = "mhetc90060_p8" then'추가인증
		if sRet == "OK" or sRet == "ok" then
'			Form.OpenFramePopup("mhetc90060_p5" , "" , "")

			g_szCertType = Form.GetSharedData("MobileCertRadio", true )
			dim g_szOneTimeNo
			if g_szCertType == "4" or g_szCertType == "1" then
				g_szOneTimeNo = Form.GetSharedData("MobileCertNumber", true )
			else 
				g_szOneTimeNo = ""
			end if	
			
			szScrcOtpClsCode = DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0)
			if DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SPLM_ATHN_STPL_YN" , 0) == "Y" then	'추가인증약정여부
				if szScrcOtpClsCode == "0" then	'보안카드
					Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
				elseif szScrcOtpClsCode == "1" then	'부가정보
					Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
				elseif szScrcOtpClsCode == "2" then	'보안매체없음
					'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 이용단말등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
					RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
				elseif szScrcOtpClsCode == "3" then	'OTP
					Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
				elseif szScrcOtpClsCode == "4" then	'mOTP
					Form.OpenPopup( "mhetc90060_motp" , "motp_success" , sPosInfo)		'공인인증서_일반/스마트OTP
				else			'오류
					Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
				end if
			else '추가인증하지 않아도 됨
				Call SendReg()
			end if

		end if
	ElseIf sKeyName == "mbbnk64010_p7" then
		if sRet == "Y" then'정상처리 + 수취인명 변경
			contInfo.lblAcntName.caption = Form.GetSharedData("64010_EngRmtName", false)	'고객영문명
			f_RegistAble()
		else
			f_Reset()
		end if
	end if
	
	if sKeyName == "mhetc90060_p9" then	'보안카드(보안매체1)
		if sRet == "ok" then			'성공
'			if g_bDelete then
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")			
'			else
'				Call SendReg()
'			end if
		else 					'실패
			exit sub
		end if	
	end if
	
	
	if sKeyName == "mhetc90060_pa" then	'부가정보인증
		if sRet == "ok" then			'성공3
'			if g_bDelete then
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
'			else
'				Call SendReg()
'			end if			
		else 					'실패
			exit sub
		end if
	end if
	
	
	if sKeyName == "mhetc90060_pb" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
'			if g_bDelete then
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
'			else
'				Call SendReg()
'			end if
			
		else						'실패		
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_motp" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
'			if g_bDelete then
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
'			else
'				Call SendReg()
'			end if
		else						'실패		
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			Call SendReg()
		else						'실패
			exit sub
		end if	
	end if
	
'	'2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)									
'	if sKeyName == "mhetc90190_p1" then										
'		'if sRet == "ok" then									
'		'end if
'	end if 	
End Sub

