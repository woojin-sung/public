	<SCRIPT_INFO _len="6849" _ulen="6085" >

'Dim g_sUserID
'Dim g_RcnoPip
Dim g_IDRegAcno
Dim g_szMotp
Dim g_sSecurity
Dim g_sPopupCloseYn

'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	
	Dim szData, szList
	szData = Form.GetOpenLinkData()
	
	'szData = "계좌비밀번호 재등록이\n완료되었습니다." 'for TEST
  	if InStr(szData, "★") > 0 then
		szList = Split(szData, "★")
		If UBOUND(szList) < 1 then
			Exit Sub
		end if 		
		Container0.lblTitle.caption = szList(0)
		Container0.Table0.SetCellString(4, 2, szList(2)) 
		Container0.Table0.SetCellString(7, 2, szList(1)) 	
		Container0.Table0.visible = true
		Container0.lblLine.visible = true
		g_IDRegAcno = szList(3) '계좌번호		
		btnOK.caption = "확인"
		
	else
		Container0.Table0.visible = false
		Container0.lblLine.visible = false
		btnOK.caption = "홈으로"
		Container0.lblTitle.caption = szData
	End if
	
	g_szMotp = Form.GetSharedData("MeritzAuth_Security", true)	
	g_sSecurity = Form.GetSharedData("CommonNoSecurity", true )	 '간편인증과 타 업무화면 진입 구분
	g_sPopupCloseYn = Form.GetSharedData("Common_OTP_PopupCloseYn", true) '보안매체없음 팝업화면에서 타기관 OTP등록을 클릭한 경우 
End Sub

'============================================================================
Sub btnOK_OnClick()
	If btnOK.caption == "확인" Then
		'20240328 확인버튼 2번클릭방지..
		btnOK.enable = false	
		btnOK.btnimage = "btn_21.9"
		btnOK.fgcolor = "269"	
		
		if InStr(Container0.lblTitle.caption, "해지되었습니다.") > 0 then  	'해지
			if g_sSecurity == "Y" then
				Form.SetSharedData("CommonNoSecurity" , "Y")
				'Form.PostLinkData("&CommonNoSecurity" , 6)
			end if 
			Form.CloseForm()
			exit sub		
		end if 	
		
		'등록/교체
		Dim sPopupYn
		'20230803 SWJ START : OTP인증화면 팝업처리 여부 판단
		'CommonNoSecurity가 "Y"일 때까지 같이 확인해야함
		'Common_OTP_PopupYn로만 판단하면, 발급 도중 고객이 화면 이탈 시 쉐어드 변수 남아있음
		'(쉐어드 변수 CommonNoSecurity는 화면마다 Clear/Set 해줌)
		'(쉐어드 변수 Common_OTP_PopupYn는 화면마다 처리안해줌)
		sPopupYn = Form.GetSharedData("Common_OTP_PopupYn", true) 
'g_sSecurity = "Y" 'for TEST
'sPopupYn = "Y"  'for TEST
'Form.SetSharedData("Common_OTP_PopupCloseYn", "Y") 'for TEST
'msgbox "g_sSecurity :: " & g_sSecurity  & "sPopupYn :: " & sPopupYn
		'if g_sSecurity == "Y" and sPopupYn == "Y" then	
		if sPopupYn == "Y" or g_sSecurity == "N" then '진행O
			'OTP인지 스마트OTP인지 체크
			DATAMANAGER.RequestTranData("obcsb_oimf_520r")
			
		else  '진행X
		
			if g_sSecurity == "Y" then
				Form.SetSharedData("&SCREEN_AUTH" , "")				'20240321 SWJ START
				Form.SetSharedData("CommonNoSecurity" , "Y")
				'Form.PostLinkData("&CommonNoSecurity" , 6)
			end if
			Form.CloseForm()
			exit sub			
		end if 
	else
		Form.CloseForm()		
	end if 
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("BDM_NMETBSWRGB", "") '업무구분초기화 JMY
	'보안매체없음 팝업화면에서 타기관 OTP등록을 클릭한 경우
	if g_sPopupCloseYn == "Y" then
		Form.SetSharedData("Common_OTP_PopupCloseYn" , "Y") '20240329 값 재설정
	end if 
	Form.SendReturnToParent("mbbdm86203_end", "ok")
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Container0.Image0.setMaintaningRatio("1")
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()	'안드로이드전용
	btnOK_OnClick()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'20230803 SWJ START : g_sSecurity 분기 추가
'간편인증 발급 프로세스일 때만 90190_s3으로 이동 
'그 외 진입 시에는 각 업무화면 맵에서 Form_OnLinkData로 받아서 다음 프로세스 이동 제어
'(Form_OnLinkData는 모든 화면 다 받으므로 주의 필요)
	if sKeyName == "mhetc90060_otp" and sRet == "ok" then 'OTP
		if g_sSecurity == "Y" then
			Form.SetSharedData("CommonNoSecurity" , "Y")
			Form.PostLinkData("&CommonNoSecurity" , 6)
			Form.CloseForm()
		else
			Form.OpenNextPopup("mhetc90190_s3" , "" , "")
		end if
	elseif sKeyName == "mhetc90060_pb" and sRet == "ok" then '스마트OTP
		if g_sSecurity == "Y" then
			Form.SetSharedData("CommonNoSecurity" , "Y")
			Form.PostLinkData("&CommonNoSecurity" , 6)
			Form.CloseForm()
		else
			Form.OpenNextPopup("mhetc90190_s3" , "" , "")
		end if
	elseif sRet == "cancel" then  '취소일 경우 결과화면 닫기
		if g_sSecurity == "Y" then
			Form.SetSharedData("CommonNoSecurity" , "Y")
			'Form.PostLinkData("&CommonNoSecurity" , 6)
		end if 
		Form.CloseForm()	
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "3" ) 	'계좌번호
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ACNO" , 0 , g_IDRegAcno )
	End If	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_520r" then
		Dim sRSLT_CLS, sSMRT_OTP_YN 
		
		'결과구분 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
		sRSLT_CLS    = DATAMANAGER.GetDataValue( 0 ,"obcsb_oimf_520r", "OutBlock1", "RSLT_CLS"      , 0 )
		'스마트OTP 여부
		sSMRT_OTP_YN = DATAMANAGER.GetDataValue( 0 ,"obcsb_oimf_520r", "OutBlock1", "UI_SMRT_OTP_YN", 0 )
		
		'스마트OTP
		if sRSLT_CLS == "3" and sSMRT_OTP_YN == "Y" then
			Form.SetSharedData("&SCREEN_AUTH" , "")
		     '20240320 mhetc90060_pb의 "obcsb_oimf_520r" 조회를 위해 계좌번호를 넘김 
			Form.OpenPopup("mhetc90060_pb" , "MeritzOTP★" & g_IDRegAcno , "")
		'OTP
		else
			Form.SetSharedData("&SCREEN_AUTH" , "")
			
			'2024.03.22 id가 세팅안된경우 세팅.. 이미 setshared가 있을 수 있으므로 null인경우는 세팅안함
			if g_IDRegAcno == "" or g_IDRegAcno == null then
				'
			else
				Form.SetSharedData("IdRegProsAcno", g_IDRegAcno)
			end if
			Form.OpenPopup("mhetc90060_otp", "otp_success" , "")
		end if 
	end if	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	'20240328 확인버튼 다시 활성화함.
	If btnOK.caption == "확인" Then
		btnOK.enable = true
		btnOK.btnimage = "btn_20.9"
		btnOK.fgcolor = "273"		
	end if	
End Sub


