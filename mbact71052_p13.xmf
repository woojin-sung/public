	<SCRIPT_INFO _len="13155" _ulen="12197" >
'============================================================================
' 01. 화 면 명 : 고객자산평가_상품별잔고_주식/채권
' 02. 화면설명 : 고객자산평가_상품별잔고_주식/채권
' 03. 작    성 : 2016. 02. 03. 유창재
' 04. 수    정 : 2018. 08. 06. 신미정 v001 천원미만 채권잔고 표기 수정
'              : 2022. 12. 12. 김인택 v002 채권대여 추가 
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nAcntCount	'계좌 개수	
Dim g_nAllCount	'전체조회시 계좌 Index
Dim g_szList
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
Function AllSearch()
	g_nAllCount = g_nAllCount - 1
	
	if g_nAllCount > 2 then
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_156r", "InBlock1", "ACNO" , 0 , Left(g_szList(g_nAllCount), 8) )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_156r", "InBlock1", "UI_UNIT_CLS" , 0 , "1" )						'종합계좌 조회
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_156r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )				'날짜
		
		DATAMANAGER.RequestTranData( "obacb_balc_156r" )
	else
		lblVisible()
	end if

	
End Function
'============================================================================
Function VltnAmt_Request()
	DATAMANAGER.ClearInputData(0, "obacb_balc_154r")
	szCsno = Form.GetSharedData("&CUST_NUM", false )
	'Y:전체 그외:개별
	if g_szList(1) == "Y" then
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "CSNO"		  , 0 , szCsno)
	else
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ACNO"		  , 0 , Left(g_szList(3), 8))
		DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASNO"		  , 0 , Right(g_szList(3), 2))
	end if
	
	DATAMANAGER.SetDataValue(0, "obacb_balc_154r", "InBlock1", "ASET_CLS_CODE" , 0 , "05")
	DATAMANAGER.RequestTranData("obacb_balc_154r")
	
End Function
'============================================================================
Function Asset_Request()
	'--------------------------------------------------------------
	' 전역변수 초기화
	'--------------------------------------------------------------	
	'대상계좌 개수 세팅
	g_nAcntCount = g_szList(0)		'계좌개수
	g_nAllCount = 3 + g_nAcntCount	'마지막 계좌 
	'서비스 날리기전 인덱스 초기화
	g_nNextCount = 0
	
	'--------------------------------------------------------------
	'서비스 호출
	'--------------------------------------------------------------
	'Y:전체 그외:개별

	if g_szList(1) == "Y" then
		cont0.grd1.rowcount = 0
		AllSearch()
	else
		DATAMANAGER.ClearInputData(0, "obacb_balc_156r")
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_156r", "InBlock1", "UI_UNIT_CLS" , 0 , "2" )				'개별계좌 조회
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_156r", "InBlock1", "ACNO" , 0 , Left(g_szList(3), 8) )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_156r", "InBlock1", "ASNO" , 0 , Right(g_szList(3), 2) )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_156r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )		'날짜
		
		DATAMANAGER.RequestTranData( "obacb_balc_156r" )
	end if
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	cont0.grd1.SetClear()

	if sEventName == "mbact71052_p13" then			'채권
	
		g_szList = Split(sParam,"○")
		
		if UBOUND(g_szList) < 1 then
			Exit Sub
		End if
		'상단 카드뷰 평가금액 서비스 호출 후 자산조회
		call VltnAmt_Request()
	
	end if

End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp0, szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp11,
		szTemp12, TempCount, tmp_trgt_clcd
	'계좌번호블록에 계좌번호+계좌명으로 출력
	if szTranID == "obacb_balc_156r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obacb_balc_156r", "OutBlock2")-1
			
			cont0.grd1.AddRow()
			
			szTemp0 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "ACNO" , i)
			szTemp0 = Left(szTemp0, 4).."-"..Mid(szTemp0, 5, 4).."-"
			szTemp0 = szTemp0 & DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "ASNO" , i)	'계좌번호	
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "ABRV_ISNM" , i)	'종목명
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "BYOV_DATE" , i)	'매수일
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "BOND_CNTG_QTY" , i)	'체결잔고
			'szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "CNTG_QTY" , i)	'체결잔고
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "PSNT_PRC" , i)	'현재가
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "VLTN_AMT" , i)	'평가금액
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "BYNG_UNPR" , i)	'매수단가
			szTemp7 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "VLTN_PRLS_AMT" , i)	'평가손익
			szTemp8 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "ERT" , i)	'수익률
			szTemp9 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "MKSC_CLS_NAME" , i)	'잔고구분
			szTemp10 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "LOAN_DATE" , i)	'대출일자
			szTemp11 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "MTRT_DATE" , i)	'종목 만기일자
			TempCount = Len(DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "ACNT_PRNM" , i))
			szTemp12 = Mid(DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "ACNT_PRNM" , i), 3, TempCount - 2)'상품명
			szTemp0 = szTemp0 & szTemp12
			szTemp13 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "BYNG_AMT" , i)	'매입금액
			szTemp14 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "LOAN_BAL" , i)	'대출/신용금액
			szTemp15 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "LOAN_MTRT_DATE" , i)	'대출만기일자
			szTemp16 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "LOAN_DTL_TYPE_CODE" , i)	'잔고구분코드
			
			szTemp17 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "MKSC_CLS_CODE" , i)	'v002 잔고구분코드
			
			'20230920 현재가, 기준가 추가
			szTemp18 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_156r", "OutBlock2", "VLTN_UNPR" , i)
			
			if g_szList(1) == "Y" then
				cont0.grd1.SetCellData("bd_cell0", g_nNextCount , szTemp0)	'계좌번호
			end if
			cont0.grd1.SetCellData("bd_cell1", g_nNextCount , szTemp1)		'종목명
			cont0.grd1.SetCellData("bd_cell2", g_nNextCount , szTemp2)		'매수일
			cont0.grd1.SetCellData("bd_cell5", g_nNextCount , szTemp5)		'평가금액
			cont0.grd1.SetCellData("bd_cell7", g_nNextCount , szTemp7)		'평가손익
			cont0.grd1.SetCellData("bd_cell8", g_nNextCount  , szTemp8)		'수익률
			cont0.grd1.SetCellData("bd_cell10", g_nNextCount , szTemp10)	'대출일자
			cont0.grd1.SetCellData("bd_cell12", g_nNextCount  , szTemp12)	'상품명
			cont0.grd1.SetCellData("bd_cell13", g_nNextCount  , szTemp13)	'매입금액
			cont0.grd1.SetCellData("bd_cell9", g_nNextCount  , szTemp9)		'잔고구분
			cont0.grd1.SetCellData("bd_cell16", g_nNextCount  , szTemp15)	'대출만기일자
			cont0.grd1.SetCellData("bd_cell11", g_nNextCount  , szTemp11)	'종목 만기일자
			cont0.grd1.SetCellData("bd_cell9", g_nNextCount  , szTemp9)		'잔고구분
			cont0.grd1.SetCellData("bd_szDate", g_nNextCount  , "매수일 "..Right(szTemp2, 6).."  |  ".."만기일 "..Right(szTemp11, 6))	'매수일/만기일
			
			if Trim(szTemp16) = "0202" then	'예탁채권-대출표시
				cont0.grd1.SetCellData("bd_cell14", g_nNextCount  , szTemp14)	'대출/신용금액
				cont0.grd1.SetCellData("bd_img", g_nNextCount  , "대출")
				cont0.grd1.SetCellImage("bd_img", g_nNextCount, "btn_blue_bg_02.9.png")
				cont0.grd1.SetCellFgColor("bd_img", g_nNextCount, "250")
			elseif Trim(szTemp17) = "4" then 'v002	
				cont0.grd1.SetCellImage("bd_img", g_nNextCount, "btn_blue_bg_02.9.png")
				cont0.grd1.SetCellData("bd_img", g_nNextCount, "대여")
				cont0.grd1.SetCellFgColor("bd_img", g_nNextCount, "250")
			end if
				
			cont0.grd1.SetCellData("bd_cell3", g_nNextCount , CDbl(szTemp3))			'체결잔고
			cont0.grd1.SetCellData("bd_cell6", g_nNextCount , FormatNumber(szTemp6, 2))	'매수단가
			
			'20230920 현재가, 기준가 추가
			cont0.grd1.SetCellData("bd_cell15", g_nNextCount , szTemp18)
			
'			if CInt(szTemp8) > 0 then
'				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "10")
'				cont0.grd1.SetCellFgColor("bd_cell8", g_nNextCount, "10")
'			elseif CInt(szTemp8) < 0 then
'				cont0.grd1.SetCellFgColor("bd_cell7", g_nNextCount, "11")
'				cont0.grd1.SetCellFgColor("bd_cell8", g_nNextCount, "11")
'			end if	

			g_nNextCount = g_nNextCount + 1
		next
		
		cont0.grd1.rowcount = g_nNextCount
		
		if DATAMANAGER.IsMoreNextData( "obacb_balc_156r" ) == True then 
			DATAMANAGER.RequestNextData( "obacb_balc_156r" )
		else
			if g_szList(1) == "Y" then	'전체조회시
				AllSearch()
			else
				lblVisible()
			end if
		end if
	'---------------------------------------------------------
	'평가금액 조회
	'---------------------------------------------------------
	elseif szTranID == "obacb_balc_154r" then
		nPrlsamt = DATAMANAGER.GetDataValue( 0 , "obacb_balc_154r", "OutBlock1", "VLTN_PRLS_AMT" , i)	'평가손익
		if CDBL(nPrlsamt) > 0 then
			szPrls = "+"..FormatNumber(nPrlsamt,0)
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "10")
		elseif CDBL(nPrlsamt) < 0 then
			szPrls = FormatNumber(nPrlsamt,0)
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "11")
		else
			szPrls = FormatNumber(nPrlsamt,0)
			cont0.tbl0.SetCellString(0, 1, szPrls)
			cont0.tbl0.SetCellFgColor(0, 1, "4")
		end if
		call Asset_Request()
	end if
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	cont0.grd1.SetClear()
	g_nNextCount = 0
	Form.ShowAlert("알림", szErrMsg)
End Sub
'============================================================================
Sub Form_OnFormInit()
	g_nAllCount = 0
	'hsz
	g_szDate = Form.GetSharedData("&HOST_DATE",0)
	szDate = right(g_szDate, 6)
	cont0.lblDate.caption = szDate
	cont0.setScrollBarVisible("0") 
	'hsz
End Sub
'============================================================================
Function lblVisible()
	if CInt(cont0.grd1.rowcount) = 0 then
		cont0.lblNone.visible = true
	else
		cont0.lblNone.visible = false
	end if
End Function 


'============================================================================
Sub cont0_grd1_OnClickUp(lRow, szCellID)
	Dim szSendData
	Dim szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp11, szTemp12, szTemp13
	
	'종목명, 평가금액, 평가손익, 수익률, 잔고구분, 잔고수량, 매입단가, 매수일, 만기일, 대출금, 대출일, 대출만기일
	szTemp1 = cont0.grd1.GetCellData("bd_cell1", lRow)
	szTemp2 = cont0.grd1.GetCellData("bd_cell5", lRow)
	szTemp3 = cont0.grd1.GetCellData("bd_cell7", lRow)
	szTemp4 = cont0.grd1.GetCellData("bd_cell8", lRow)
	
	szTemp5 = cont0.grd1.GetCellData("bd_cell9", lRow)
	szTemp6 = cont0.grd1.GetCellData("bd_cell3", lRow)
	szTemp7 = cont0.grd1.GetCellData("bd_cell6", lRow)
	szTemp8 = cont0.grd1.GetCellData("bd_cell2", lRow)
	
	szTemp9 = cont0.grd1.GetCellData("bd_cell11", lRow)
	szTemp10 = cont0.grd1.GetCellData("bd_cell14", lRow)
	szTemp11 = cont0.grd1.GetCellData("bd_cell10", lRow)
	szTemp12 = cont0.grd1.GetCellData("bd_cell16", lRow)
	
	'20230920 현재가, 기준가 추가
	szTemp13 = cont0.grd1.GetCellData("bd_cell15", lRow)
	
	szSendData = szTemp1 & "☆" & szTemp2 & "☆" & szTemp3 & "☆" & szTemp4 & "☆" & szTemp5 & "☆" & szTemp6 & "☆" & szTemp7 & "☆" & szTemp8 & "☆" & szTemp9 & "☆" & szTemp10 & "☆" & szTemp11 & "☆" & szTemp12 & "☆" & szTemp13
	
	Form.OpenPopupAnimation("mbact71052_pg", szSendData, "", "2")
End Sub




