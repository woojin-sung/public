	<SCRIPT_INFO _len="9557" _ulen="9071" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 상품가입 의사표시 확정 처리
' 02. 화면설명 : 상품가입 의사표시 확정 처리
' 03. 작    성 : 2021.06.11 김유경
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szPassWord
Dim g_szList

Dim gApltDate
Dim gProdClsCode
Dim gChanTypeCode
Dim gPrnm
Dim gIntnDtrmDate
Dim gJoinStatCode
Dim gProdClsNm
Dim gIscd
Dim gCnrcNo
Dim gAcno
Dim gAsno

Dim gApltNo
Dim gByovApltAmt
Dim gSrno
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'Cont0.grd0.SetClear()
	if sEventName == "확정처리" then
		g_szList = Split(sParam,"★")
	
		if UBOUND(g_szList) < 1 then
			Exit Sub
		end if
	end if
	
	if g_szList(2) <> "" then
		g_szPassWord = g_szList(2)
	else
		g_szPassWord = ""
	end if	
	
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "IQRY_CLS_CODE" , 0 , "3"         )
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "ACNO"          , 0 , g_szList(0) )
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "ACNT_PWD"      , 0 , g_szPassWord)	
	DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "ASNO"          , 0 , g_szList(1))
	DATAMANAGER.RequestTranData( "obcck_dsmg_606r" )
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obcck_dsmg_606r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obcck_dsmg_606r", "OutBlock1") - 1
			'No
			Cont0.grd0.SetCellData("bd_cell3", i, i+1)
		
			'상품구분
			if DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_BSWR_CLCD" , i) == "01" then
				gProdClsCode  = "01"
				Cont0.grd0.SetCellData("bd_cell2", i, "집합투자증권")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_BSWR_CLCD" , i) == "02" then
				gProdClsCode  = "02"
				Cont0.grd0.SetCellData("bd_cell2", i, "랩(가입)")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_BSWR_CLCD" , i) == "03" then
				gProdClsCode  = "03"
				Cont0.grd0.SetCellData("bd_cell2", i, "ISA")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_BSWR_CLCD" , i) == "04" then
				gProdClsCode  = "04"
				Cont0.grd0.SetCellData("bd_cell2", i, "신탁")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_BSWR_CLCD" , i) == "05" then
				gProdClsCode  = "05"
				Cont0.grd0.SetCellData("bd_cell2", i, "청약")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_BSWR_CLCD" , i) == "06" then
				gProdClsCode  = "06"
				Cont0.grd0.SetCellData("bd_cell2", i, "파생결합증권")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_BSWR_CLCD" , i) == "07" then
				gProdClsCode  = "07"
				Cont0.grd0.SetCellData("bd_cell2", i, "랩(전환)")
		     else 
				Cont0.grd0.SetCellData("bd_cell2", i, DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_BSWR_CLCD" , i))		     
		     end if
		
			'신청채널
			if DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CHAN_TYPE_CLS_CODE" , i) == "010" then
				Cont0.grd0.SetCellData("bd_cell15", i, "창구")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CHAN_TYPE_CLS_CODE" , i) == "020" then
				Cont0.grd0.SetCellData("bd_cell15", i, "HTS")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CHAN_TYPE_CLS_CODE" , i) == "060" then
				Cont0.grd0.SetCellData("bd_cell15", i, "INTERNET(WTS)")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CHAN_TYPE_CLS_CODE" , i) == "156" then
				Cont0.grd0.SetCellData("bd_cell15", i, "아이폰(NEW)")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CHAN_TYPE_CLS_CODE" , i) == "157" then
				Cont0.grd0.SetCellData("bd_cell15", i, "안드로이드폰(NEW)")
			else
				Cont0.grd0.SetCellData("bd_cell15", i, DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CHAN_TYPE_CLS_CODE" , i))
		     end if
		     
		     '계좌번호
		     tmp = DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "ACNO" , i)..DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "ASNO" , i)
		     Cont0.grd0.SetCellData("bd_cell10", i, tmp)
		     
			'숙려구분
			if DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_CLS_CODE" , i) == "01" then
				Cont0.grd0.SetCellData("bd_cell1", i, "고난도")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_CLS_CODE" , i) == "02" then
				Cont0.grd0.SetCellData("bd_cell1", i, "적정성")
			End If 
			
		     '숙려대상
			if DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_CODE" , i) == "01" then
				Cont0.grd0.SetCellData("bd_cell8", i, "일반투자자")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_CODE" , i) == "02" then
				Cont0.grd0.SetCellData("bd_cell8", i, "고령자")
			elseif DATAMANAGER.GetDataValue( 0 , "obcck_dsmg_606r", "OutBlock1", "CAFU_TRGT_CODE" , i) == "03" then
				Cont0.grd0.SetCellData("bd_cell8", i, "부적합자")
			End If 
			SetFormatNuber(i)
		next
	end if 
End Sub 
'============================================================================
Function SetFormatNuber(i)
	gApltByovAmt = ""
	gApltByovAmt     = Cont0.grd0.GetCellData("bd_cell14", i) '신청금액
	
	if MID(gApltByovAmt,instr(gApltByovAmt,".")+1,2) = "00" then
		Cont0.grd0.SetCellData("bd_cell14", i, FormatNumber(gApltByovAmt,0))
	else
		Cont0.grd0.SetCellData("bd_cell14", i, FormatNumber(gApltByovAmt,2))
	end if
	

End Function
'============================================================================
Function SetTrigger(nIndex)	
	gApltDate     = ""
	gProdClsNm    = ""
	gChanTypeCode = ""
	gPrnm         = ""
	gIntnDtrmDate = ""
	gJoinStatCode = ""
	gIscd         = ""
	gCnrcNo       = ""
	gAcno         = ""
	gAsno         = ""
	gApltNo       = ""
	gByovApltAmt  = ""
	
	gApltDate     = Cont0.grd0.GetCellData("bd_cell0", nIndex) '신청일자
	gProdClsNm    = Cont0.grd0.GetCellData("bd_cell2", nIndex) '상품구분명
	gChanTypeCode = Cont0.grd0.GetCellData("bd_cell15", nIndex) '신청채널
	gPrnm         = Cont0.grd0.GetCellData("bd_cell17", nIndex) '투자상품
	gIntnDtrmDate = Cont0.grd0.GetCellData("bd_cell13", nIndex) '의사표시기한
	gJoinStatCode = Cont0.grd0.GetCellData("bd_cell7", nIndex) '상태
	'gProdClsCode  'OnReceiveTranComplete 에서 셋팅 '상품구분코드
	gIscd         = Cont0.grd0.GetCellData("bd_cell5", nIndex) '종목코드
	gCnrcNo       = Cont0.grd0.GetCellData("bd_cell4", nIndex) '계약번호
	gAcno         = Cont0.grd0.GetCellData("bd_cell9", nIndex)
	gAsno         = Cont0.grd0.GetCellData("bd_cell11", nIndex)
	
	gApltNo       = Cont0.grd0.GetCellData("bd_cell6", nIndex)
	gByovApltAmt  = Cont0.grd0.GetCellData("bd_cell14", nIndex)
	gSrno         = Cont0.grd0.GetCellData("bd_cell22", nIndex)
	
	szData = gApltDate & "★" & gProdClsNm  & "★" & gChanTypeCode & "★" & gPrnm & "★" & gIntnDtrmDate & "★" & gJoinStatCode & "★" & gProdClsCode & "★" & gIscd & "★" & gCnrcNo & "★" & gAcno & "★" & gAsno & "★" & g_szPassWord & "★" & gApltNo & "★" & gByovApltAmt & "★" & gSrno
	
	Form.OpenPopupAnimation("mbfnp55007_p1", szData, "","2")
End Function 
'============================================================================
Sub Cont0_grd0_OnClickUp(lRow, szCellID)
	Call SetTrigger(lRow)	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

End Sub


'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "의사표시완료" Then
		If sRet == "3" Then 
			Form.ShowAlert( "알림" , "신청하신 금융상품은 투자 확정 의사로 처리하였습니다.")
		ElseIf sRet == "4" Then 
			Form.ShowAlert( "알림" , "신청하신 금융상품은 투자취소 확정 의사로 처리하였습니다.")		
		End If 

		'If sKeyName = "의사표시완료" or sKeyName = "의사표시취소" Then 
		DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "IQRY_CLS_CODE" , 0 , "3"        )
		DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "ACNO"          , 0 , g_szList(0))
		DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "ACNT_PWD"      , 0 , g_szList(2))	
		DATAMANAGER.SetDataValue( 0 , "obcck_dsmg_606r", "InBlock1", "ASNO"          , 0 , g_szList(1))		
		DATAMANAGER.RequestTranData( "obcck_dsmg_606r" )
		'End If 
	
	End If
End Sub 
