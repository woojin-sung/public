'============================================================================
'DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if	szTranID	= "ohhts_5040_001r" or szTranID	= "ohhts_5040_002r" or szTranID	= "ohhts_5040_003r" then
		
		szSign = Trim(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FID_PRDY_VRSS_SIGN2", 0))

		if szSign  == "1" or szSign == "2" then 
			sColor = "10"
		elseif szSign  == "4" or szSign == "5" then 
			sColor = "11"
		else
			sColor = "12"
		end if
		
		tbl01.SetCellFgColor( 0, 1, sColor )
		
		DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix", "InBlock1", "FIDR_SYMB", 0, g_szIndexCode)	
		DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")
	end if

	g_flagInit = false
	g_flagMinTic = false
End Sub


'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName = "SCREEN_MENU" Then								
		If sParam = "REG_INTR" Then									' 관심종목등록
			Form.OpenPopup("mhprc11000_pd" , g_szItemCode , "")
			
		ElseIf sParam = "REG_WATCHING" Then							' Watching종목등록
			Form.OpenFramePopup("mhprc11020_p1" , g_szItemCode , "")
	
		ElseIf sParam = "SHA_SNS" Then								' SNS공유
			Form.OpenDialog("sharesns" , "1", "")
		End if
	elseif sEventName = "sharedata" Then
		Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", sParam)
		
	'20220922 SWJ START : 상단 바 종목명 클릭 시 종목선택 팝업 추가	
	ElseIf sEventName = "TITLE_CLICK" Then
		Form.OpenCommonDialog("SEARCH", "8", "")
	'20220922 SWJ END
	
	End If
'	if 	sEventName	= "42000ITEMCODE"	then
'		g_szIndexCode	=	sParam
'		RequestData()
'	end if 
End Sub


'============================================================================
'Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName = "Chart_Min" then
		g_szMinType = sRet
		rdoPeriod01.SetRadioCaption( 2, g_szMinType )
		tmpMin = split(rdoPeriod01.GetRadioCaption( 2),"분")
		g_szMinType = tmpMin[0]
		
		PeriodSet(g_szChrtType)
	elseif sKeyName = "Chart_Tic" then
		g_szTicType = sRet		
		rdoPeriod01.SetRadioCaption( 3, g_szTicType)
		tmpTic = split(rdoPeriod01.GetRadioCaption( 3),"틱")
		g_szTicType = tmpTic[0]
		
		PeriodSet(g_szChrtType)
	elseif sKeyName == "Chart_WEEK" then	
		if sRet == "월" then
			g_szChrtType = "M"
		else
			g_szChrtType = "W"
		end if
		rdoPeriod01.SetRadioCaption( 1, sRet)
		PeriodSet(g_szChrtType)			
	elseif sKeyName = "snsshare" Then			' 폼탭 초기화
		g_nSNSType = Cint(sRet)
		
		If g_nSNSType = 2 Then
			Dim szScreenNo, szFileName
			szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )
			szFileName = szScreenNo & "_ScreenShot.png"
			
			Form.SaveScreenShot( szFileName )		
			Form.SendSNSLinkage(g_nSNSType, "", "", szFileName)
		Else
			Dim szFlag
		
			sName = tbl01.GetCellString(1, 0)
			
			if g_szMarket == "EN" then
				sCurprice = FormatNumber( tbl01.GetCellString(0, 0),  4)
			else
				sCurprice = FormatNumber( tbl01.GetCellString(0, 0),  2)
			end	if
			
			
			If CDbl(tbl01.GetCellString(0, 3)) > 0 Then
				szFlag	= "▲"			
			ElseIf CDbl(tbl01.GetCellString(0, 3)) < 0 Then
				szFlag	= "▼"
			Else
				szFlag	= ""
			End If
			
			sDiff    = FormatNumber( tbl01.GetCellString(0, 3),  2)		
			sRate     = FormatNumber( tbl01.GetCellString(0, 4),  2)
			sQuqn	 = FormatNumber( tbl01.GetCellString(1, 2),  0)
			szParam = sName.."\n"..sCurprice.."\n ("..szFlag..sDiff.." / "..sRate.."% / "..sQuqn..")"
			
			Form.SendSNSLinkage(g_nSNSType, "메리츠 증권", szParam)
		End If
	end if
End Sub


'============================================================================
'Form_OnLinkData
'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if	sKey	=	"ITEMCODE"		then
		if g_szItemCode = sValue and g_flagInit = false then
			exit Sub
		end if
	
		g_szIndexCode	=	sValue
		g_szMarket		=	Change_EtcMarket(Form.GetItemCodeInfo(sValue, "market"))
	
		'Form.SetSharedData("42000INITCODE" , g_szItemCode)
		
		'20221117 LES START
		Form.SetSharedData("&ITEM_WORLD_UPJONG" , g_szIndexCode)
		'20221117 LES END
	
		RequestData()
	end if
End Sub

'============================================================================
'Chart 불러오기(기간)
' 설정창 닫을때 분,틱 주기 넘겨줌.
'================

function ChartEx0_OnGetPeriodInfo()
	Dim sPeriodType
	sPeriodType = ""
	Dim sMin, sTic
   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
	for i = 0 to 8
		sMin = Form.GetEnvData( "chart_min"..i )	'분차트
		if sMin <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sMin&"/"
			else
				sPeriodType = sPeriodType&sMin&";"
			end if
		end if
	next
	for i = 0 to 8
		sTic = Form.GetEnvData( "chart_tic"..i )	'분차트
		if sTic <> "" then
			if i == 7 then
				sPeriodType = sPeriodType&sTic&"/"
			else
				sPeriodType = sPeriodType&sTic&";"
			end if
		end if
	next
	if sPeriodType <> "" then
		ChartEx0.setSyncPeriodValueToChart(sPeriodType)
	end if
end function

function ChartEx0_OnChangePeriod(sPeriodType)
	sMinArr = {}
	sTicArr = {}
	sDataArr = {}
	
	g_sIsRequestChartEvent = "1"

   ' 차트 설정창에서 주기 값 넘어온 경우
   ' 분주기#틱주기 => 1;3;5;.../1;3;5;...
   if InStr(sPeriodType, "/") > 0 then
	   sTemp = split(sPeriodType, "/")
	   sMinArr = split(sTemp[0], ";")
	   sTicArr = split(sTemp[1], ";")
	   Form.Log("sPeriodType",sPeriodType)
	   
	   for i = 0 to 7 step 1
		Form.SetEnvData( 1, "chart_min"..i, sMinArr[i] )
		
		Form.SetEnvData( 1, "chart_tic"..i, sTicArr[i] )

	   next
   end if
end function


'============================================================================
Sub Form_OnFormClose()
	ChartEx0.SetSaveChart("1")
End Sub

'============================================================================
function ChartEx0_OnRequestData(nIndex, sData)
	if sData = "" or sData = null then
		exit function
	end if
	
	Data = split(sData, ";")
	
   '현재가내의 차트에서는 종목코드를 변경하지 않는다.
	g_szIndexCode    = Cstr(Trim(Data[0]))             '코드

	g_sPeriodType  = Cstr(Trim(Data[1]))             '일주월년분틱
	g_sPeriod      = Cstr(Trim(Data[2]))             '주기(1,5,...)
	sRefresh = Cstr(Trim(Data[3]))
	radioIndex = ""
	if sRefresh = 1 or sRefresh = "1" or sRefresh = true then 
	
		g_sPeriodType = "2"
		g_sPeriod = "1"
		radioIndex = 0
		g_szChrtType =  "D"
		
		sTic =Form.GetEnvData( "chart_tic0" )
		sMin = Form.GetEnvData( "chart_min0" )
		
		if sTic = "" then
			sTic = "1"
		end if
		if sMin = "" then
			sMin = "1"
		end if
		rdoPeriod01.SetRadioCaption( 3, sTic.."틱" )
		rdoPeriod01.SetRadioCaption( 2, sMin.."분" )
	else
	
		Select case g_sPeriodType
			case "0"
				radioIndex = 3
				rdoPeriod01.SetRadioCaption( radioIndex, g_sPeriod.."틱")
				
			case "1"
				
				radioIndex = 2
				rdoPeriod01.SetRadioCaption( radioIndex, g_sPeriod.."분")
			
			case "2"
				radioIndex = 0
	
			
			case "3"
				radioIndex = 1
				rdoPeriod01.SetRadioCaption( radioIndex, "주")
			
			case "4"
				radioIndex = 1
				rdoPeriod01.SetRadioCaption( radioIndex, "월")
		
		end Select
		
	end if
	rdoPeriod01.currentindex = radioIndex
	
	ChartEx0.SetPeriodType(g_sPeriodType)

	ChartEx0.SetPeriodTime(g_sPeriod)
	
	' 종목코드 주기
	g_szItemMarket = Form.GetItemCodeInfo(g_szIndexCode , "market")
	Form.SetItemCode(g_szIndexCode)	
	RequestData()	
end function

'============================================================================
Sub ChartEx0_OnScrollEnd()
		if	g_sPeriodType	=	"1"	then				'분
				
			DATAMANAGER.RequestNextData("ohhts_5040_002r")
			
		elseif	g_sPeriodType	=	"0"	then			'틱
		
			
			DATAMANAGER.RequestNextData("ohhts_5040_003r")
		else
		
			DATAMANAGER.RequestNextData("ohhts_5040_001r")
		end if

End Sub

Function Change_EtcMarket(szData)
	 if Trim(szData) == "UJ" then
		  return "N"
	 elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		  return "B"
	 end if 
	 
	 return szData
End Function
'============================================================================
'============================================================================
Sub BtnLine_OnClick()
	if g_flagLine = false then
		g_flagLine = true
		ChartEx0.SetShowCrossLine("true")
		BtnLine.imgpath ="btn_chart01_o.9.png"
	else
		g_flagLine = false
		ChartEx0.SetShowCrossLine("false")
		BtnLine.imgpath ="btn_chart01_n.9.png"
	end if
End Sub

'============================================================================
Sub Form_OnRefresh()
	RequestData()
End Sub
