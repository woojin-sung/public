'============================================================================
'RequestData
'========================="ohhts_5040_002r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN"===================================================
Function RequestData()
	DATAMANAGER.CancelRealData("ohhts_ovrs_nmix")	
	
	'해외환율일때 소수점 4자리로 160422 KMC 추가
	if g_szMarket == "EN" then
		ChartEx0.setDecimal("4") ' 소수점 4자리
	else
		ChartEx0.setDecimal("2") ' 소수점 2자리
	end if

	if	g_sPeriodType	=	"1"	then				'분
		DATAMANAGER.SetDataValue(0, "ohhts_5040_002r", "InBlock1", "FID_INPUT_ISCD", 0, g_szIndexCode)
		DATAMANAGER.SetDataValue(0, "ohhts_5040_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarket)
	
		DATAMANAGER.SetDataValue(0, "ohhts_5040_002r", "InBlock2", "FID_INPUT_ISCD", 0, g_szIndexCode)
		DATAMANAGER.SetDataValue(0, "ohhts_5040_002r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szMarket)
		szToday = Form.GetSharedData("&HOST_DATE", 0 )
		DATAMANAGER.SetDataValue(0, "ohhts_5040_002r", "InBlock2", "FID_INPUT_DATE1", 0, szToday)
		DATAMANAGER.SetDataValue(0, "ohhts_5040_002r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN", 0, "Y")
		
		sMin = Split(g_szMinType, "분", -1, 1)
		sTemp = sMin[0] * 60
		DATAMANAGER.SetDataValue( 0, "ohhts_5040_002r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" , 0, sTemp)

		DATAMANAGER.RequestTranData("ohhts_5040_002r")
		
	elseif	g_sPeriodType	=	"0"	then			'틱
	
		DATAMANAGER.SetDataValue(0, "ohhts_5040_003r", "InBlock1", "FID_INPUT_ISCD", 0, g_szIndexCode)
		DATAMANAGER.SetDataValue(0, "ohhts_5040_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarket)
	
		DATAMANAGER.SetDataValue(0, "ohhts_5040_003r", "InBlock2", "FID_INPUT_ISCD", 0, g_szIndexCode)
		DATAMANAGER.SetDataValue(0, "ohhts_5040_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szMarket)
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5040_003r", "InBlock2", "FID_INPUT_CNT1" , 0, g_szTicType)
		DATAMANAGER.SetDataValue( 0, "ohhts_5040_003r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE" , 0, "2")	
		DATAMANAGER.SetDataValue( 0,  "ohhts_5040_003r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0, "N")		
		
		DATAMANAGER.RequestTranData("ohhts_5040_003r")
	else
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock1", "FID_INPUT_ISCD", 0, g_szIndexCode)
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMarket)
	
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock2", "FID_INPUT_ISCD", 0, g_szIndexCode)
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0, g_szMarket)
		szToday = Form.GetSharedData("&HOST_DATE", 0 )
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock2", "FID_INPUT_DATE1", 0, szToday)
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR"	, 0, g_szChrtType)
		
		DATAMANAGER.RequestTranData("ohhts_5040_001r")
	end if
	
end function


'============================================================================
' 일,분,틱 주기별 차트 설정
' 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
'============================================================================
function PeriodSet(sPeriodType)

'	Form.ShowAlert("", sIndex..":"..sPeriod)
	
	
	if sPeriodType= "T" then
		g_sPeriod = g_szTicType
		g_sPeriodType = "0"
	elseif sPeriodType= "A" then
		g_sPeriod = g_szMinType
		g_sPeriodType = "1"
	elseif sPeriodType= "D" then 
		g_sPeriodType = "2"
		g_sPeriod ="1"
	elseif sPeriodType= "W" then 
		g_sPeriodType = "3"
		g_sPeriod ="1"
	elseif sPeriodType= "M" then 
		g_sPeriodType = "4"
		g_sPeriod ="1"
	end if
	
	sPeriod = CInt( g_sPeriod)
	
	if Len( sPeriod )= 1 then
	   g_sPeriod = "00"..g_sPeriod
	elseif Len( sPeriod )= 2 then
	   g_sPeriod = "0"..g_sPeriod
	end if
	
    ChartEx0.SetPeriodType(g_sPeriodType)
    ChartEx0.SetPeriodTime(g_sPeriod)
   
	' 조회TR 보내기
	RequestData()	
end function


