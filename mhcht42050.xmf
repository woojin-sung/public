		if Trim(sReturn1) <> "" then
			Form.SetItemCode(sReturn1)
			
			'20221117 LES START
			Form.SetSharedData("&ITEM_WORLD_UPJONG" , sReturn1)
			'20221117 LES END
			
			
		end if
	end if
End Sub
