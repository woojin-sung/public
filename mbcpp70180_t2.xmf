--===========================================================================
--===========================================================================
dim g_login

dim g_p_id
dim g_p_name
dim g_userpname
'============================================================================
Sub Form_OnFormInit()

	g_login = Form.GetSharedData("&USER_ID", false )
	
	
	
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "PRTF_NAME" , 0 , "" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "IQRY_STA_DATE" , 0 , "" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "IQRY_FIN_DATE" , 0 , "" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "IQRY_CLS_CODE" , 0 , "3" )
	DATAMANAGER.SetDataValue( 0, "obcpp_rbit_020r" , "InBlock1" , "CUST_ID" , 0 , g_login ) 'g_login
	
		
	DATAMANAGER.RequestTranData("obcpp_rbit_020r")
	
End Sub




'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	
	count = DATAMANAGER.GetDataCount( 0, "obcpp_rbit_020r" , "OutBlock1" )
	
	nRow = 0
	
	for i=0 to count-1
	
	Container0.Grid0.AddRow()
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "CUST_ID" ,i) ' 고객ID
		Container0.Grid0.SetCellData("bd_cell0",nRow, tmp )		
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "MOD_YMDH" ,i) ' 수정일시
		f_MOD_YMDH = left(tmp, 10)
	Container0.Grid0.SetCellData("bd_cell2",nRow, f_MOD_YMDH )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "PRTF_ID" ,i) ' 포트폴리오ID
		Container0.Grid0.SetCellData("bd_cell1",nRow, tmp )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "PRTF_NAME" ,i) ' 사용자가 저장한 포트폴리오 명
		Container0.Grid0.SetCellData("bd_cell7",nRow, tmp )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "M3_ERT" ,i) ' 3개월 수익률
		f_M3_ERT = mid(tmp, 16, 3)
	Container0.Grid0.SetCellData("bd_cell3",nRow, f_M3_ERT )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "M6_ERT" ,i) ' 6개월 수익률
		f_M6_ERT = mid(tmp, 16, 3)
	Container0.Grid0.SetCellData("bd_cell4",nRow, f_M6_ERT )
	
	tmp=DATAMANAGER.GetDataValue( 0, "obcpp_rbit_020r" ,"OutBlock1", "CSNM" ,i) ' 포트폴리오 명
		Container0.Grid0.SetCellData("bd_cell6",nRow, tmp )	
	
	
	nRow = nRow+1
	
	next
End Sub

'============================================================================
Sub Container0_Grid0_OnScrollEnd()
	DATAMANAGER.RequestNextData( obcpp_rbit_020r )
End Sub

'============================================================================
Sub Container0_Grid0_OnClickUp(lRow, szCellID)
	g_p_id	=	Container0.Grid0.GetCellData("bd_cell1", lRow)
	g_p_name	=	Container0.Grid0.GetCellData("bd_cell6", lRow)
	g_userpname	=	Container0.Grid0.GetCellData("bd_cell7", lRow) ' 위 3개 잘나옴 메세지 박스로 확인함
	
	
	Form.SetSharedData("selectedPid_fav" , Container0.Grid0.GetCellData("bd_cell1", lRow))
	Form.SetSharedData("selectedPname_fav", Container0.Grid0.GetCellData("bd_cell6", lRow))
	'Form.SetSharedData("selecteduserPname_fav", Container0.Grid0.GetCellData("bd_cell7", lRow))
	
	
	Form.PostLinkData( "closelink", "donefav" )			'폼탭을 닫기 위한 postlink
	
	
End Sub

