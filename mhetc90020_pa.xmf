	<SCRIPT_INFO _len="6559" _ulen="5929" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 로그인_ID조회
' 02. 화면설명 : 
' 03. 작    성 : 2016.03.15 김은숙
' 2020.10.29 : 정민영 : v0001 : [T2008250015] 메모리취약점 보완
' 2020.10.27 : 권오상 : v002 : T2008250015 : 실명확인번호 암호화 처리'
' 2023.11.14 : 양현정 : v003 : 실명번호 변수 변경..
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_plain_rm	'v0001 MTS메모리평문적용여부
Dim g_TXT
Dim g_POP_YN
g_POP_YN = "N"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
'내국인/외국인/법인 선택에 따른 실명번호
Function GetRCNO()
	Dim sRCNO
	
	if rdoGubn.currentindex == "0" then		'내국인
		sRCNO = contBirth.edt01.caption
	elseif rdoGubn.currentindex == "1" then	'외국인(재외국민)
		sRCNO = contForeign.edt02.caption
	else									'법인
		sRCNO = contLicens.edt03.caption
	end if
	
	return sRCNO
End Function

'============================================================================
'필수정보 입력 여부 확인
Function ValidatCheck()
	if rdoGubn.currentindex == "0" then		'내국인
		if Len(contBirth.edt01.caption) < 6 then
			g_TXT = "생년월일을 입력해 주세요."
			return False
		end if
	elseif rdoGubn.currentindex == "1" then	'외국인(재외국민)
		if contForeign.edt02.caption == "" then
			g_TXT = "실명확인번호를 입력해 주세요."
			return False
		end if
	else									'법인
		if contLicens.edt03.caption == "" then
			g_TXT = "사업자등록번호를 입력해 주세요."
			return False
		end if
	end if
	
	if Len(contBtm.edtAcnt.caption) < 8 then
		g_TXT = "계좌번호를 입력해 주세요."
		return False
	end if
	
	'v0001 화면단에서의 자릿수 체크는 MTS메모리평문 미적용일때만 체크
	if Len(contBtm.edtPW0.caption) == 0 then
		g_TXT = "계좌 비밀번호를 입력해주세요."
		return False
	elseif g_plain_rm ~= "1" and (Len(contBtm.edtPW0.caption) < 4 or Len(contBtm.edtPW0.caption) > 8) then
		g_TXT = "계좌 비밀번호는 4~8자리만 가능합니다."
		return False
	end if

	return True
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()

	'v0001 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)
	
	if Form.GetOpenLinkData() == "mhetc90020_pa_ELFN_ID" then
		g_POP_YN = "Y"
	end if
	
	Label1.caption = "계좌번호 찾기 >"
	contBirth.edt01.setApplyLabel	("생년월일", 			0, 268, "left", false)
	contForeign.edt02.setApplyLabel	("실명확인번호",		0, 268, "left", false)
	contLicens.edt03.setApplyLabel	("사업자등록번호", 	0, 268, "left", false)
	contBtm.edtPW0.setApplyLabel	("계좌비밀번호", 		0, 268, "left", false)
	contBtm.edtAcnt.setApplyLabel	("계좌번호", 			0, 268, "left", false)
	
	Call rdoGubn_OnClick(0)
End Sub

'============================================================================
'내국인/외국인/법인 선택에 따른 CONTAINER SWITCH
Sub rdoGubn_OnClick(nIndex)
	contBirth.visible		= False
	contForeign.visible	= False
	contLicens.visible	= False
	
	'내국인
	if nIndex == 0 then
		contBirth.visible		= True
	'외국인
	elseif nIndex == 1 then
		contForeign.visible	= True
	'법인
	elseif nIndex == 2 then
		contLicens.visible	= True
	end if
	
End Sub

'============================================================================
'확인 버튼 클릭
Sub btnOK_OnClick()
	
	if ValidatCheck() == False then		'필수정보 입력 여부 확인
		Form.MsgBox( "알림", g_TXT, "", 6)
		btnOK.enable = false
		Exit Sub
	end if

	Dim sRCNO, sACNO, sPWD
	sRCNO	= GetRCNO()
	sACNO	= contBtm.edtAcnt.caption
	sPWD		= contBtm.edtPW0.caption

	Form.SetSharedData("mhetc90020_pe_RCNO",	sRCNO)
	Form.SetSharedData("mhetc90020_pe_ACNO",	sACNO)
	Form.SetSharedData("mhetc90020_pe_PWD",	sPWD)
	
	Form.OpenPopup("mhetc90020_pe", g_POP_YN, "")
End Sub

'============================================================================
' 계좌번호 찾기
'============================================================================
Sub Button0_OnClick()
	Form.OpenPopup("mbonl85001", "", "")
End Sub

'============================================================================
Sub ImgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contBirth_edt01_OnEditComplete()
	btnOK.enable = ValidatCheck()
End Sub

'============================================================================
Sub contForeign_edt02_OnEditComplete()
	btnOK.enable = ValidatCheck()
End Sub

'============================================================================
Sub contLicens_edt03_OnEditComplete()
	btnOK.enable = ValidatCheck()
End Sub

'============================================================================
Sub contBtm_edtAcnt_OnEditComplete()
	btnOK.enable = ValidatCheck()
End Sub

'============================================================================
Sub contBtm_edtPW0_OnEditComplete()
	btnOK.enable = ValidatCheck()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "mhetc90020_pe" then
		
		if sRet == "RETURN" then
			Dim sData
			sData = Form.GetSharedData("mhetc90020_pe_ELFN_ID", true)
			
			Form.SendReturnToParent("mhetc90020_pa", sData)
		end if
		
		Form.CloseForm()
		
	' 계좌번호찾기 완료
	elseif sKeyName == "mbonl85001" then
		
		if len(sRet) > 8 then
			Dim sAcntArr
			sAcntArr = split(sRet, "-")
			
			contBtm.edtAcnt.caption = sAcntArr(0)
		else
			contBtm.edtAcnt.caption = sRet
		end if
		
	end if
	
End Sub

	</SCRIPT_INFO>
</ROOT>