	<SCRIPT_INFO _len="8034" _ulen="7814" >

Dim unPressedImgPath 
Dim PressedImgPath

Dim g_tCheckCnt
g_tCheckCnt = Array("4", "3", "10")


Dim g_szGubun		'신청구분
Dim g_szStatus	'환전현황
Dim g_szCrcd		'통화구분
Dim g_szCheck
g_szCheck = "Y"

Dim g_tGubun	'신청구분 코드값 배열				
g_tGubun = Array("%", "1", "2", "3", "4")

Dim g_tStatus	'환전현황 코드값 배열				
g_tStatus = Array("%", "1", "2", "3")

Dim g_tCrCd	'통화구분 코드값 배열				
g_tCrCd = Array("%", "USD", "JPY", "CNY", "HKD", "AUD", "CAD", "EUR", "CHF", "SGD", "VND")

'============================================================================
Sub Form_OnFormInit()
	unPressedImgPath = "btn_line2_n.9.png"
	PressedImgPath   = "btn_line2_o.9.png"
	
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	
	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")
	
		g_szGubun   = tData(0)	
		g_szStatus  = tData(1)
		g_szCrcd    = tData(2)	
		g_szCheck   = tData(3)
		if g_szCheck == "Y" then
			contMain.chkEx.checkstate = "1"	'가환전제외
		else
			contMain.chkEx.checkstate = "0"	'가환전제외
		end if
	else		
		g_szGubun   = g_tGubun[0]
		g_szStatus  = g_tStatus[0]
		g_szCrcd    = g_tCrCd[0]
		g_szCheck   = "Y"
		contMain.chkEx.checkstate = "1"	'가환전제외
	end if
	
	
	'기선택된 코드 표시
	for i = 0 to #g_tGubun - 1
		if g_szGubun = g_tGubun[i] then
			Form.SetCtlProp("contMain.imgFilter1Gb" & i, "imgpath", PressedImgPath)
		else
			Form.SetCtlProp("contMain.imgFilter1Gb" & i, "imgpath", unPressedImgPath)
		end if
	next
	
	for i = 0 to #g_tStatus - 1
		if g_szStatus = g_tStatus[i] then
			Form.SetCtlProp("contMain.imgFilter2Gb" & i, "imgpath", PressedImgPath)
		else
			Form.SetCtlProp("contMain.imgFilter2Gb" & i, "imgpath", unPressedImgPath)
		end if
	next
	
	for i = 0 to #g_tCrCd - 1
		if g_szCrcd = g_tCrCd[i] then
			Form.SetCtlProp("contMain.imgFilter3Gb" & i, "imgpath", PressedImgPath)
		else
			Form.SetCtlProp("contMain.imgFilter3Gb" & i, "imgpath", unPressedImgPath)
		end if
	next
	
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	if contMain.chkEx.checkstate = "1" then
		g_szCheck = "Y"
	else	
		g_szCheck = "N"
	end if
	Form.SendReturnToParent("nrsbbnk65020_p1", g_szGubun .. "`" .. g_szStatus  .. "`" .. g_szCrcd .. "`" .. g_szCheck) 
End Sub

'============================================================================
Sub btnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Function SetCheckFilter(szQNum, szAnswerNum)
	Dim nQNum, nTIdx ' 문항번호, 테이블 인덱스
	nQNum = CDbl(szQNum)
	nTIdx = nQNum - 1
	
	nAnswerCnt = g_tCheckCnt[nTIdx]

	Select case nQNum
	    case 1, 2, 3
		    for j = 0 to Cint(nAnswerCnt)
			    if j == Cint(szAnswerNum) then
				    Form.SetCtlProp("contMain.imgFilter" & nQNum & "Gb" & j, "imgpath", PressedImgPath)
			    else
				    Form.SetCtlProp("contMain.imgFilter" & nQNum & "Gb" & j, "imgpath", unPressedImgPath)
			    end if
		    next
    End Select
End Function


' 신청구분
'============================================================================
Sub contMain_lblFilter1Gb0_OnClick()
	contMain.chkEx.checkstate = "1"	'가환전제외
	
	g_szGubun = g_tGubun[0]	
	SetCheckFilter("1", "0")

	g_szStatus = g_tStatus[0]
	contMain.lblFilter2Gb1.enable = true
	contMain.lblFilter2Gb2.enable = true
	contMain.lblFilter2Gb3.enable = true
	SetCheckFilter("2", "0")	
End Sub

