'============================================================================
Sub Form_OnFormInit()
	Edit0.certname = "인증서 비밀번호 입력"	
'	EditInput1.certname = "보안카드 "&Label0.caption&Label1.caption
'	EditInput2.certname = "보안카드 "&Label3.caption&Label4.caption

	g_sRetData = "cancel"
	g_sUserID = Form.GetSharedData("CERT_ID" , false)
	if g_sUserID == null or g_sUserID == "" then
		g_sUserID = Form.GetSharedData("&USER_ID" , false)
	end if

	'Form.SetScreenName( "보안매체 인증" )

'	if g_sUserID ~= null and g_sUserID ~= "" then
'		DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
'	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
'	if szTranID == "obcsb_oimf_520r" then
'		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "INPUT_CLS" , 0 , "1" ) '전자금융ID
'		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_520r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
	if szTranID == "obcsb_simf_000r" then
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "INPUT_CLS" , 0 , "2" ) '전자금융ID
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "ELFN_ID" , 0 , g_sUserID )
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "SCRC_IDX_NO1" , 0 , Label0.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "SCRC_NO1" , 0 , EditInput1.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "SCRC_IDX_NO2" , 0 , Label3.caption )
		DATAMANAGER.SetDataValue( 0, "obcsb_simf_000r", "InBlock1", "SCRC_NO2" , 0 , EditInput2.caption )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	if szTranID == "obcsb_oimf_520r" then
'		Dim sRSLT_CLS, sSCRC_STAT_CODE
'		
'		'결과구분 0:보안카드, 1:부가정보, 2:없을경우, 3:OTP, 9:에러
'		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "RSLT_CLS" , 0 )
'		'보안카드상태코드 0:정상, 1:매체사고, 2:비번오류횟수초과, 6:사용등록안됨
'		sSCRC_STAT_CODE = DATAMANAGER.GetDataValue( 0, "obcsb_oimf_520r", "OutBlock1", "SCRC_STAT_CODE" , 0 )
'	
'		if sRSLT_CLS == "0" then '보안카드
'			if sSCRC_STAT_CODE == "0" then '정상
'				'ButtonOK.enable = true
'			elseif sSCRC_STAT_CODE == "1" then '매체사고	
'				Form.MsgBox( "알림", "매체사고 입니다.", "", 6 )
'			elseif sSCRC_STAT_CODE == "2" then '비번오류횟수초과	
'				Form.MsgBox( "알림", "비밀번호 오류초과 입니다.", "", 6 )
'			elseif sSCRC_STAT_CODE == "6" then '사용등록안됨	
'				Form.MsgBox( "알림", "사용등록이 안되었습니다.", "", 6 )
'			else '그외
'				Form.MsgBox( "알림", "미지정 상태입니다.", "", 6 )
'			end if
'		end if
'		
'		EditInput1.certname = "보안카드 "&CInt(Label0.caption)&Label1.caption
'		EditInput2.certname = "보안카드 "&CInt(Label3.caption)&Label4.caption
	if szTranID == "obcsb_simf_000r" then
		Dim sRSLT_CLS, sSCRC_PWD_MSTK_TMNU
		
		'결과구분 0:정상 그외에러
		sRSLT_CLS = DATAMANAGER.GetDataValue( 0, "obcsb_simf_000r", "OutBlock1", "RSLT_CLS" , 0 )
		'보안카드오류횟수
		sSCRC_PWD_MSTK_TMNU = DATAMANAGER.GetDataValue( 0, "obcsb_simf_000r", "OutBlock1", "SCRC_PWD_MSTK_TMNU" , 0 )
		
		if sRSLT_CLS == "0" then '정상
			if CInt(sSCRC_PWD_MSTK_TMNU) > 5 then '에러
				Form.MsgBox( "알림", "보안카드 입력 오류 횟수 초과입니다.", "", 6 )
			else '공인인증처리로 넘어가기
				if Edit0.caption == null or Edit0.caption == "" then
		           Form.MsgBox("알림", "인증서 비밀번호를 입력하세요", "", 6)
	            else
		           Dim sDN
		           sDN = Form.GetSharedData("&USER_CERT_DN" , false)	
		           Form.RequestCertCommand( "ReqCheckIsValidPassword", sDN, Edit0.caption )
	            end if
				'g_sRetData = "ok"		
				
			end if
		else
			Dim sMsg, sSubMsg 
			sMsg = DATAMANAGER.GetDataMsgText( szTranID )
			sSubMsg = DATAMANAGER.GetDataMsgSubText( szTranID )
			Form.MsgBox( "알림", sMsg.." "..sSubMsg, "", 6 )
		end if
	elseif szTranID == "obcpp_logn_015a" then
	
		'공인인증서 비밀번호 오류횟수
		sMstk =  DATAMANAGER.GetDataValue( 0,"obcpp_logn_015a", "OutBlock1", "PBCR_PWD_MSTK_TMNU" ,0)

		nCount = CInt(sMstk)
		if nCount >  0 then	
			'Form.ShowAlert("알림", "공인인증서 비밀번호 " & tonumber(sMstk) & "회 오류입니다.\n연속 7회 오류시 접속이 제한됩니다.")	
						'1. 공인인증 5회이상 초과
			if CInt(sMstk) >= DEF_CERT_PSWD_LIMIT_CNT then
				Form.MsgBox( "알림",  "인증 비밀번호 5회 오류 초과로 업무진행이 불가능 합니다.", "", 0)
				Edit0.visible = False
				Exit Sub
			
			
			'2. 공인인증 오류횟수 5회 미만
			else
				Form.MsgBox( "알림",  "인증 비밀번호 " + CInt(sMstk) + "회 오류입니다. 5회 오류 시 앱이 종료됩니다.)", "", 0)
			end if

	     	'3. 오류횟수 공유변수 저장 (공인인증 오류횟수는 공유변수로 앱 종료전까지 모든화면이 공유)
			Form.SetSharedData("CERT_PWD_ERR_CNT" , sMstk)
		'-----------------------------------------------------
		' 인증서 비밀번호 일치시
		'-----------------------------------------------------	
		else
			
			' 기존) 인증서 비밀번호가 5회 초과된 상태에서 인증서 비밀번호 일치시, 업무진행 가능
			' 변경) 인증서 비밀번호가 5회 초과된 상태에서 인증서 비밀번호 일치시, 업무진행 불가
			sCertErrCnt = Cint(Form.GetSharedData("CERT_PWD_ERR_CNT", false ))
			
			'4. 공유 오류횟수 > 최대 오류횟수 : 업무진행 불가 메세지
			if sCertErrCnt >= DEF_CERT_PSWD_LIMIT_CNT then
				Form.MsgBox( "알림",  "인증 비밀번호 5회 오류 초과로 업무진행이 불가능 합니다.",	""	,	0)
				Edit0.visible = False
				Exit Sub
			
			'5. 공유 오류횟수 < 최대 오류횟수 : 공유 오류횟수 초기화
			else
				Form.SetSharedData("CERT_PWD_ERR_CNT" , 0)
			end if
		end if
	
	'20160517 OCSP검증 추가
	elseif szTranID == "ohhts_ocsp_001r" then
		sStatCode =  DATAMANAGER.GetDataValue( 0,"ohhts_ocsp_001r", "OutBlock1", "STAT_CLS_CODE" ,0) '상태구분코드

		if sStatCode == "Y" then
			Request_obcpp_logn_015a("Y")
			Form.triggerEvent("#", "인증서", "Success")
		end if
	'20160517 END
	
	end if
End Sub
 
