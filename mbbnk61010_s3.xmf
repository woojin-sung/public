'            : 정민영 : v0002 : [T2011240020] 공인인증서 명칭 변경('공인'단어 삭제)
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_sRetData
Dim g_sUserID 
'20190905 LES START 공인인증 최대오류횟수 변경
Dim DEF_CERT_PSWD_LIMIT_CNT
DEF_CERT_PSWD_LIMIT_CNT = 5
'20190905 LES END
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
