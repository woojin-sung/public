' 2022.02.14 : v0002 : 김수진 : 국내/해외 CFD 계좌개설시_국가/계좌 유형 일괄개설 추가
'							국내/해외 2개가 국내(일반/안심),해외(일반/안심)_미국,중국,홍콩,일본 10개로 늘어남
'							CFD 계약서 동의가 된 경우 개설완료화며네서 절차 안내팝업 제외 반영
'-------------------------------------------------------------------------------------------

DIm aFlag  '아코디언 플래그 (펼치기/접기)

'****************************************************************************
'GetSharedData (계좌개설-본인계좌인증(2/2) mbbdm10071)
'****************************************************************************
'OutBlock1
Dim getCsno         
Dim getAcnoOutData         
Dim getAcntOpngYn   
Dim getApltAbleYn   
Dim getHtsStplApltYn
Dim getOtpIsncYn    
Dim getScrcIsncYn 
Dim getCfdCndcSgntYN	'v0002

'OutBlock2
Dim getAcno
Dim getAsno
Dim getPrnm
Dim getPrcd	'v0001
Dim getDataCnt
Dim gTempAcnt

Dim gRcno
Dim CloseFlag
CloseFlag = 0
Dim g_OsType

Dim sTail
Dim sTail1
Dim sTail2
Dim sTail3	'v0001

Dim g_FrstPos
Dim g_FrstTop
'============================================================================
Function USER_Notice(flag)  'JMY
	If flag = "down" Then
		aFlag = "down"
		ContMain.ContNotiTitle.ImgArrow.imgpath = "icon_caret_up.png"

		ContMain.ContNotiBody.setHeightResize(450) 
		ContMain.ContNotiBody.visible = True
		
		'2021.04.13. 김유경 숫자->변수 변경
'		ContMain.lblScrollPos.top = 950
'		ContMain.SetScrollAutoSize()
'		ContMain.scroll_pos = 950 'CInt(Form.calcUnResize(ContMain.Table0.top, "1"))
		ContMain.lblScrollPos.top = g_FrstPos + 480
		ContMain.SetScrollAutoSize()
		ContMain.scroll_pos = g_FrstTop + 450 - nDelHeight '950 'CInt(Form.calcUnResize(ContMain.Table0.top, "1"))
		
	Else	'up
		aFlag = "up"
		ContMain.ContNotiTitle.ImgArrow.imgpath = "icon_caret_down.png"

		ContMain.ContNotiBody.setHeightResize(0) 
		ContMain.ContNotiBody.visible = False
		
		'2021.04.13. 김유경 숫자->변수 변경
'		ContMain.lblScrollPos.top = 548
'		ContMain.SetScrollAutoSize()		
'		ContMain.scroll_pos = 0 
		ContMain.lblScrollPos.top = g_FrstPos + 20
		ContMain.SetScrollAutoSize()		
		ContMain.scroll_pos = g_FrstTop
	End If

End Function 

'============================================================================

Sub Form_OnFormInit()
	
	g_OsType = Form.GetSharedData("&OS_TYPE", False)
	
	aFlag = 0
	BtnNext.fgcolor = 269
	
	ContMain.Table0.SetCellFgColor(1, 1, 268)
	ContMain.Table0.SetCellFgColor(2, 1, 268)
	ContMain.Table0.SetCellFgColor(3, 1, 268)
	ContMain.Table0.SetCellFgColor(4, 1, 268)
	ContMain.Table0.SetCellFgColor(5, 1, 268)
	ContMain.Table0.SetCellFgColor(6, 1, 268)
	ContMain.Table0.SetCellFgColor(7, 1, 268)
	
	ContMain.Table0.SetCellFgColor(1, 3, 268)
	ContMain.Table0.SetCellFgColor(2, 3, 268)
	ContMain.Table0.SetCellFgColor(3, 3, 268)
	ContMain.Table0.SetCellFgColor(4, 3, 268)
	ContMain.Table0.SetCellFgColor(5, 3, 268)
	ContMain.Table0.SetCellFgColor(6, 3, 268)
	ContMain.Table0.SetCellFgColor(7, 3, 268)
		
	getAcno    = Form.GetSharedData("gSharedDataAcno"   , false ) 
	getAsno    = Form.GetSharedData("gSharedDataAsno"   , false ) 
	getPrnm    = Form.GetSharedData("gSharedDataPrnm"   , false ) 	
	getPrcd    = Form.GetSharedData("gSharedDataPrcd"   , false )	'v0001
	getDataCnt = Form.GetSharedData("gSharedDataCnt"    , false ) 	
	gRCNO      = Form.GetSharedData("BDM_RCNO_PIP"      , false ) '주민등록번호
	
	getCsno          = Form.GetSharedData("gCsno"          , false ) 
	getAcnoOutData   = Form.GetSharedData("gAcno"          , false ) 
	getAcntOpngYn    = Form.GetSharedData("gAcntOpngYn"    , false ) 
	getApltAbleYn    = Form.GetSharedData("gApltAbleYn"    , false ) 
	getHtsStplApltYn = Form.GetSharedData("gHtsStplApltYn" , false ) 
	getOtpIsncYn     = Form.GetSharedData("gOtpIsncYn"     , false ) 
	getScrcIsncYn    = Form.GetSharedData("gScrcIsncYn"    , false ) 
	getCfdCndcSgntYN = Form.GetSharedData("gCfdCndcSgntYN"    , false ) 'v0002 CFD 기본계약서 서명 여부
	
	ContMain.Label2.fgcolor = 	274
	
	sTail  = split(getAcno, "#")
	sTail1 = split(getAsno, "#")
	sTail2 = split(getPrnm, "#")
	sTail3 = split(getPrcd, "#")	'v0001
	Dim szIsaAcntOpngClcd			'v0001
	szIsaAcntOpngClcd	= Form.GetSharedData("BDM_ISA_ACNT_OPNG_CLCD"    , False )	'v0001
	
	'JMY 실제개설되는 건수만큼만 표시되도록 Table 높이 강제조정
    '현재 총10Row.
    '0Row.타이틀, 1~8Row.개설된계좌리스트, 9Row.패딩     
    	'v0001 해외 CFD 추가로 nNowHeight변경 Row 추가
	'v0002 국내/해외 국가/계좌유형 일괄개설 추가로 nNowHeight변경 Row 추가
	nNowHeight = 678  'ContMain.Table0.height
	nCnt = 16 - Cint(getDataCnt)
	nDelHeight = 38 * nCnt		'38=한Row당높이
	ContMain.Table0.height = CInt(nNowHeight) - CInt(nDelHeight)
	'승인관련안내 문구위치 조정
	nTop = CInt(Form.calcUnResize(ContMain.Image3.top, "1"))
	ContMain.Image3.top = nTop - CInt(nDelHeight)
	ContMain.Label2.top = nTop - CInt(nDelHeight)
	ContMain.BtnNotice.top = nTop - CInt(nDelHeight) + 53
	ContMain.ContNotiTitle.top = nTop - CInt(nDelHeight) + 53
	ContMain.ContNotiBody.top = nTop - CInt(nDelHeight) + 53 + 40
	ContMain.LblScrollPos.top = nTop - CInt(nDelHeight) + 53 + 3
	'JMY 
	If Cint(getDataCnt) == 1 Then
		If Len(Trim(getAcno)) > 0 and Len(Trim(getAsno)) > 0 and Len(Trim(getPrnm)) > 0 Then 
			ContMain.Table0.SetCellString( 1 , 1, Trim(getAcno).."-"..Trim(getAsno))
			ContMain.Table0.SetCellString( 1 , 3, Trim(getPrnm))
		End If
	Else
		For i = 0 to Cint(getDataCnt) -1 
			If ubound(sTail) > 0 and ubound(sTail1) > 0 and ubound(sTail2) > 0 Then 
				
				tempACnt = sTail[i].."-"..sTail1[i]
				
				ContMain.Table0.SetCellString( i+1 , 1, tempACnt)
				ContMain.Table0.SetCellString( i+1 , 3, sTail2[i])
			End If
			i = i + 1
		Next
	End If
	
	'v0001 sta CFD/중개형 ISA 이수 개설시 안내팝업 띄우기
	Dim szMISAYN, szCFDYN
	For i = 0 to Cint(getDataCnt) -1 
		If sTail3[i] == "140" Then	'중개형 ISA
			szMISAYN = "Y"
		Elseif sTail3[i] == "136" or sTail3[i] == "137" Then	'CFD
			szCFDYN = "Y"
		End if
	Next 
	
	'v0002 sta CFD기본계약서서명여부가 Y값 or null값일경우 팝업제외
	If szCFDYN == "Y" Then
		If getCfdCndcSgntYN == "Y" Or getCfdCndcSgntYN == "" Or getCfdCndcSgntYN == null Then
			szCFDYN = "N"
		End If
	End If

	If szMISAYN == "Y" And szCFDYN == "Y" Then
		Form.OpenPopup("mbbdm85180_p1" , "2", "")
	Else
		If szCFDYN == "Y" Then
			Form.ShowAlert("안내", "장외파생상품 거래를 위해 CFD 계약서 작성이 필요합니다.\n\n로그인 후 CFD 계약서 승인 화면에서\n계약서를 작성해주세요.")
		Elseif szMISAYN == "Y" Then 
			If szIsaAcntOpngClcd == "2" Then
				Form.ShowAlert("안내", "중개형 ISA 이수전용 계좌는\n이전or전환 신청이 필요 합니다.\n\n로그인 후 금융상품 > ISA >\n이전및전환신청화면에서 신청해주세요.")
			Else
				Form.OpenPopup("mbbdm85180_p1" , "1", "")
			End If
		End If
	End If
	'v0001 fin

	
	'JMY 안내사항
'	ContMain.ContNotiTitle.bgcolor = 271
'	ContMain.ContNotiBody.bgcolor  = 272
	
	'초기위치
	g_FrstPos = CInt(Form.calcUnResize(ContMain.lblScrollPos.top, "1"))
	g_FrstTop = 0  'CInt(Form.calcUnResize(ContMain.Image0.top, "1"))
	
	USER_Notice("up")
	
	'
	
	'2021.04.20. 김유경. 로그인 상태인 경우 계좌리스트 재조회.
	Dim sLOGIN_TYPE 
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )
	
	If CInt(sLOGIN_TYPE) > 1 then '로그인상태
		Form.RequestCommand("RE_ACCT_LIST" , "" , "")
	End If
	
End Sub


'============================================================================
Sub ContMain_BtnNotice_OnClick()	'JMY
	If aFlag = "up" Then
		USER_Notice("down")
	Else
		USER_Notice("up")
	End If
End Sub
'============================================================================
Sub BtnNext_OnClick()
	Form.OpenNextPopup("mbbdm85183", "", "" ) '진행상태확인
End Sub

'============================================================================
Sub BtnNext0_OnClick()
	closeFlag = 2
	Form.CloseForm()
End Sub


'============================================================================
Sub Form_OnFormClose()
	If closeFlag == 2 Then
		Form.OpenScreen( "41000" , "")
	End If
End Sub 

'============================================================================
Sub Form_OnFormBackKeyPressed() '안드로이드전용
    BtnNext0_OnClick()
End Sub

	</SCRIPT_INFO>
</ROOT>