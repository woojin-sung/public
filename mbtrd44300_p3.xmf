'============================================================================
Sub btnDisposition_OnClick()
	if Len(edtPrc.caption) < 9 then
		if edtPrc.caption <> "" and InStr(edtPrc.caption, "'") = 0 then
			edtPrc.caption = edtPrc.caption & "'"
		end if
	end if
	g_bInitFlag = false
End Sub

'============================================================================
Sub btnDot_OnClick()
	if Len(edtPrc.caption) < 9 then
		if edtPrc.caption <> "" and InStr(edtPrc.caption, ".") = 0 then
			edtPrc.caption = edtPrc.caption & "."
		end if
	end if
	g_bInitFlag = false
End Sub

'============================================================================
Sub btnBack_OnClick()
	Dim nLen
	nLen = Len(edtPrc.caption)

	if nLen <> 0 then
		szQty = Left(edtPrc.caption, nLen-1)
		edtPrc.caption = szQty
	end if
	
	g_bInitFlag = false
End Sub

'============================================================================
Sub btnClear_OnClick()
	edtPrc.caption = ""
	g_bInitFlag = false
End Sub

'============================================================================
Sub btnConfirm_OnClick()
	Dim szPrc
	szPrc = edtPrc.caption
	
	if szPrc = "" then
		Form.SendReturnToParent(g_szType, "")
	else
'		Dim nTempPrc, nTemp
'		nTempPrc = tonumber(Replace(Form.GetDecimalMaskData(szPrc),",",""))
'		
'		nTemp = Len(g_szTickSize) - tonumber(InStr(g_szTickSize , "." )) 
'		nTemp = math.pow(10,nTemp)
'		
'		if CInt(nTempPrc*nTemp) Mod CInt(tonumber(g_szTickSize)*nTemp) = 0 then
'			Form.SendReturnToParent(g_szType, nTempPrc)
'		end if
		
		Dim nTempPrc
		nTempPrc = tonumber(Replace(Form.GetDecimalMaskData(szPrc),",",""))
		
		Form.SendReturnToParent(g_szType, nTempPrc)
	end if
	
	Form.CloseForm()
End Sub

'============================================================================
' 숫자키패드 탭
'============================================================================
Function f_CalcPlus(szPlus)	
	if Len(edtPrc.caption) < 9 then
		if edtPrc.caption = "0" or g_bInitFlag = true then
			edtPrc.caption = szPlus
		else
			edtPrc.caption = edtPrc.caption & szPlus
		end if
	end if
	
	g_bInitFlag = false
End Function

'20200428 HWG START : 해외파생 마이너스 호가 추가
'============================================================================
' Calc_Price : +, - 버튼클릭시 호가단위로 가격계산 -> 2016.03.24 수정
'============================================================================
Function Calc_Price(nGbn, szCode)
	Dim szPrc, szUnit, szHigh, szLow, szHyun, szOld, szRight
	
	szPrc  = edtPrc.caption
	'szHigh = Form.GetCtlProp("#lblHigh", "caption")	
	'szLow  = Form.GetCtlProp("#lblLow", "caption")
	'szHyun = Form.GetCtlProp("#lblHyun", "caption")
	'szOld  = szPrc

	if CDbl(szPrc) == "" then
		szPrc = 0	
	else		
		szUnit = Form.getItemCodeInfo(szCode, "ticksize") 
		'szPrc = ReSet_Prc(szPrc, nGbn)
		'szPrc = Set_Unit(szPrc)
		
		' + 버튼 클릭 /////////////////////////////
		if nGbn == 0 then							
			szPrc = CDbl(szPrc) + CDbl(szUnit)

		' - 버튼 클릭 ////////////////////////////
		elseif nGbn == 1 then		
			szPrc = CDbl(szPrc) - CDbl(szUnit)
		end if
	end if
	
	lblTemp.caption = szPrc
	
	edtPrc.caption = lblTemp.dispcaption
End Function

'============================================================================
Sub btnPM_OnClick()
	'if Len(edtPrc.caption) < 9 then
