--===========================================================================
--===========================================================================

Dim g_szType '타입
Dim g_szItemCode '종목코드
Dim g_szTickSize '틱사이즈
Dim g_bInitFlag '이닛플레그

g_bInitFlag = true

'============================================================================
Sub Form_OnFormInit()
	Dim szData, tData
	szData = Form.GetOpenLinkData( )
	
	if szData <> "" then
		Dim szDispositionType
		tData = Split(szData, "★")

		g_szType = tData(0)
		g_szItemCode = tData(1)
		edtPrc.caption = tonumber(Replace(Form.GetDecimalMaskData(tData(2)),",",""))
		g_szTickSize = tData(3)
		szDispositionType = tData(4)
		
		if g_szType = "LIMIT_PRC" then '주문가격
			lblPrc.caption = "주문가격"
		elseif g_szType = "STOP_PRC" then '조건가격
			lblPrc.caption = "조건가격"
		end if
		
		if szDispositionType = "0" then
			btnDisposition.caption = ""
		elseif szDispositionType = "1" then
			btnHidden.visible = false
		end if
	end if
End Sub

'============================================================================
Sub btnPPlus_OnClick()
	Dim szPrc
	szPrc = edtPrc.caption
	if szPrc = "" then
		szPrc = "0"
	end if
	
	szPrc = Form.GetDecimalMaskData(szPrc)
	
	'20200428 HWG START : 해외파생 마이너스 호가 추가
	if CDbl(szPrc) > 0 then
		lblTemp.caption = Form.GetSpinPrice(g_szItemCode, szPrc, 1)
		edtPrc.caption = lblTemp.dispcaption
	else
		Calc_Price(0, g_szItemCode)
	end if
	'20200428 HWG END
	
End Sub

'============================================================================
Sub btnPMinus_OnClick()
	Dim szPrc
	szPrc = edtPrc.caption
	if CDbl(szPrc) = "" then	'20200428 HWG START : 해외파생 마이너스 호가 추가
		szPrc = "0"
		edtPrc.caption = "0"
	end if
	
	szPrc = Form.GetDecimalMaskData(szPrc)
	
	'20200428 HWG START : 해외파생 마이너스 호가 추가
'	if tonumber(szPrc) >= tonumber(g_szTickSize) then
	if CDbl(szPrc) > 0 then
		lblTemp.caption = Form.GetSpinPrice(g_szItemCode, szPrc, -1)
		edtPrc.caption = lblTemp.dispcaption
	else
		Calc_Price(1, g_szItemCode)
	end if
	'20200428 HWG END
	
End Sub

'============================================================================
Sub btnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnPlus1_OnClick()
	f_CalcPlus("1")
End Sub

