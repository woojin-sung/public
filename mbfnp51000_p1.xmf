	<SCRIPT_INFO _len="21582" _ulen="20370" >
'2024.02.26 V0001 정우희 세제상품 유형 추가

dim	g_szSettingFile		'검색내용 저장할 파일

dim	g_nTypeCnt			'펀드유형 count
dim	g_nWarnCnt			'위험등급 count
dim	g_nFeeCnt			'펀드비용 count
dim	g_nSvngCnt			'저축유형 count V0001

dim	g_szChan		'판매채널
dim	g_szArea		'투자지역
dim	g_szType		'펀드유형
dim	g_szGrade	'위험등급
dim	g_szFee		'펀드비용

dim	g_szRet
dim	g_nChanCnt			'판매채널
dim	g_szInvType			'사용자투자성향등급
Dim	g_szRcmd
Dim	g_Trgt_Cls_Code	'내성향맞춤구분(0:맞춤/1:해지)


g_nFeeCnt	=	0
g_nWarnCnt	=	0
g_nTypeCnt	=	0
g_nSvngCnt	=	0 'V0001

g_szChan		=	""
g_szArea		=	""
g_szType		=	""
g_szGrade	=	""
g_szFee		=	""
g_szSvng		=	"" 'V0001


g_szRet	=	"0"


Dim unPressedImgPath 
Dim PressedImgPath

Dim g_tAnswerCnt
g_tAnswerCnt = Array("3", "3", "14", "6", "3", "2") ' 각 문항 답변 갯수 V0001

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("상세검색")
	g_szSettingFile	="51000ITEMS.ini"

	unPressedImgPath = "btn_line_n.9.png"
	PressedImgPath   = "btn_line_o.9.png"
	
	dim szLinkedData
	szLinkedData = Form.GetOpenLinkData()

	if szLinkedData = "" then
		Form.ShowAlert("알림", "입력값이 없습니다.")
	else
		dim tData
		tData = Split(szLinkedData, "★")
		
		g_szInvType			= tData(0)
		g_szRcmd				= tData(1)
		g_Trgt_Cls_Code		= tData(2)
		g_szSpclInvrYn		= tData(3)
	end if
    
    btnClear_OnClick()	'컨트롤 초기화    
End Sub

'============================================================================
'btnClear_OnClick
'============================================================================
Sub btnClear_OnClick()
    ClearCheckAnswer("1")
    ClearCheckAnswer("2")
    ClearCheckAnswer("3")
    ClearCheckAnswer("4")
    ClearCheckAnswer("5")
    ClearCheckAnswer("6") 'V0001
    
    ClearSharedData()

	Form.SetCtlProp("Container.ImgQ1A2", "imgpath", PressedImgPath)	'판매채널 : 온라인 디폴트
	Form.SetCtlProp("Container.ImgQ2A1", "imgpath", PressedImgPath)	'투자지역 : 전체 디폴트
	
	initRiskGrade()	'위험등급별 항목 초기화
End Sub

'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("51000_SEARCH" , g_szRet)
End Sub

'============================================================================
'btnOK_OnClick
'============================================================================
Sub btnOK_OnClick()
'	IF  g_szInvType <> "00" AND g_szInvType <> "01" THEN
'		if InStr(g_szGrade, "KYCD★03★") == 0 AND InStr(g_szGrade, "KYCD★04★") == 0 AND InStr(g_szGrade, "KYCD★05★") == 0 AND InStr(g_szGrade, "KYCD★06★") == 0 then
'		   Form.MsgBox("알림", "위험등급을 선택하세요", "", 0)
'		   Exit Sub
'		end if
'	END IF 
	
	SaveSettings()
	g_szRet	=	"1"
	Form.CloseForm()
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
'SaveSettings	:	세팅값에 따라 입력값을 조합한다 
'============================================================================
Function SaveSettings()

	'1. 판매채널
	g_nChanCnt = "1"	'1건만 선택
	Form.SetSharedData("51000_CHAN",	g_nChanCnt & "★" & g_szChan)
		
	'2.	투자지역	
	Form.SetSharedData("51000_AREA",	g_szArea)
		
	'3.	펀드유형	'g_nTypeCnt
	Form.SetSharedData("51000_TYPE",	g_nTypeCnt & "★" & g_szType)
	
	'4.	위험등급	'g_nWarnCnt
	Form.SetSharedData("51000_GRADE",	g_nWarnCnt & "★" & g_szGrade)
		
	'5.	펀드비용	'g_nFeeCnt
	Form.SetSharedData("51000_FEE",		g_nFeeCnt & "★" & g_szFee)
	
	'6.  세제상품 'V0001
	Form.SetSharedData("51000_SVNG",	g_nSvngCnt & "★" & g_szSvng)

End Function

'============================================================================
'SetRiskGrade	:	위험등급별 항목 초기화
'============================================================================
Function initRiskGrade()
    
	IF LEN(TRIM(g_szInvType)) = 0 THEN 
		g_szInvType = "00"
	END IF

	if g_szSpclInvrYn = "Y" then	'전문투자자면 전체등급 선택&활성화
		Container.ImgQ4A1.enable = TRUE
		Container.ImgQ4A2.enable = TRUE
		Container.ImgQ4A3.enable = TRUE
		Container.ImgQ4A4.enable = TRUE
		Container.ImgQ4A5.enable = TRUE
		Container.ImgQ4A6.enable = TRUE
	
		Form.SetCtlProp("Container.ImgQ4A1", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A2", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A3", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A4", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A5", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A6", "imgpath", PressedImgPath)	
		
		g_nWarnCnt = 6
		g_szGrade = "KYCD★01★KYCD★02★KYCD★03★KYCD★04★KYCD★05★KYCD★06★"


	elseif g_Trgt_Cls_Code = "1" then	'내성향맞춤 해지시에는 위험등급 버튼 활성화 요청.2023.07.03 이수정과장.
		Container.ImgQ4A1.enable = TRUE
		Container.ImgQ4A2.enable = TRUE
		Container.ImgQ4A3.enable = TRUE
		Container.ImgQ4A4.enable = TRUE
		Container.ImgQ4A5.enable = TRUE
		Container.ImgQ4A6.enable = TRUE
''	if g_Trgt_Cls_Code = "1" then	'내성향맞춤 해지시에는 위험등급 모두 선택 & 사용자 변경 불가
''		Container.ImgQ4A1.enable = FALSE
''		Container.ImgQ4A2.enable = FALSE
''		Container.ImgQ4A3.enable = FALSE
''		Container.ImgQ4A4.enable = FALSE
''		Container.ImgQ4A5.enable = FALSE
''		Container.ImgQ4A6.enable = FALSE
		
		Form.SetCtlProp("Container.ImgQ4A1", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A2", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A3", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A4", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A5", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A6", "imgpath", PressedImgPath)	
		
		g_nWarnCnt = 6
		g_szGrade = "KYCD★01★KYCD★02★KYCD★03★KYCD★04★KYCD★05★KYCD★06★"


	elseif g_szInvType = "01" OR g_szRcmd = "2" OR g_szRcmd ="4"  then
		Container.ImgQ4A1.enable = TRUE
		Container.ImgQ4A2.enable = TRUE
		Container.ImgQ4A3.enable = TRUE
		Container.ImgQ4A4.enable = TRUE
		Container.ImgQ4A5.enable = TRUE
		Container.ImgQ4A6.enable = TRUE
		
		Form.SetCtlProp("Container.ImgQ4A1", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A2", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A3", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A4", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A5", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A6", "imgpath", PressedImgPath)	
		
		g_nWarnCnt = 6
		g_szGrade = "KYCD★01★KYCD★02★KYCD★03★KYCD★04★KYCD★05★KYCD★06★"


	elseif g_szInvType = "02" then
		Container.ImgQ4A1.enable = FALSE
		Container.ImgQ4A2.enable = FALSE
		Container.ImgQ4A3.enable = TRUE
		Container.ImgQ4A4.enable = TRUE
		Container.ImgQ4A5.enable = TRUE
		Container.ImgQ4A6.enable = TRUE
		
		Form.SetCtlProp("Container.ImgQ4A1", "imgpath", unPressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A2", "imgpath", unPressedImgPath)	
