'============================================================================
Function SetRiskAnswer(szData, szImage)
	if InStr(g_szGrade, szData) == 0 then
		g_nWarnCnt = g_nWarnCnt + 1
		g_szGrade	=	g_szGrade & szData
		
		Form.SetCtlProp(szImage, "imgpath", PressedImgPath)	
	else
		g_nWarnCnt = g_nWarnCnt - 1
		g_szGrade	=	Replace(g_szGrade, szData, "")

		Form.SetCtlProp(szImage, "imgpath", unPressedImgPath)
	end if	
End Function


