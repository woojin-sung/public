'============================================================================
' 펀드유형 중복체크시 카운트랑 파라미터 정리
'============================================================================
Function SetTypeAnswer(szData, szImage)
	if InStr(g_szType, szData) == 0 then
		g_nTypeCnt = g_nTypeCnt + 1
		g_szType	=	g_szType & szData
		
		Form.SetCtlProp(szImage, "imgpath", PressedImgPath)			
	else
		g_nTypeCnt = g_nTypeCnt - 1
		g_szType	=	Replace(g_szType, szData, "")
		
		Form.SetCtlProp(szImage, "imgpath", unPressedImgPath)
	end if
End Function



