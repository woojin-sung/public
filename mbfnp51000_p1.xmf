		Form.SetCtlProp("Container.ImgQ4A4", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A5", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A6", "imgpath", PressedImgPath)	

		g_nWarnCnt = 4
		g_szGrade = "KYCD★03★KYCD★04★KYCD★05★KYCD★06★"

		
	elseif g_szInvType = "03" then
		Container.ImgQ4A1.enable = FALSE
		Container.ImgQ4A2.enable = FALSE
		Container.ImgQ4A3.enable = FALSE
		Container.ImgQ4A4.enable = TRUE
		Container.ImgQ4A5.enable = TRUE
		Container.ImgQ4A6.enable = TRUE
		
		Form.SetCtlProp("Container.ImgQ4A1", "imgpath", unPressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A2", "imgpath", unPressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A3", "imgpath", unPressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A4", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A5", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A6", "imgpath", PressedImgPath)	

		g_nWarnCnt = 3
		g_szGrade = "KYCD★04★KYCD★05★KYCD★06★"

		
	elseif g_szInvType = "04" then
		Container.ImgQ4A1.enable = FALSE
		Container.ImgQ4A2.enable = FALSE
		Container.ImgQ4A3.enable = FALSE
		Container.ImgQ4A4.enable = FALSE
		Container.ImgQ4A5.enable = TRUE
		Container.ImgQ4A6.enable = TRUE
		
		Form.SetCtlProp("Container.ImgQ4A1", "imgpath", unPressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A2", "imgpath", unPressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A3", "imgpath", unPressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A4", "imgpath", unPressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A5", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A6", "imgpath", PressedImgPath)	

		g_nWarnCnt = 2
		g_szGrade = "KYCD★05★KYCD★06★"

		
	elseif g_szInvType = "05" then
		Container.ImgQ4A1.enable = FALSE
		Container.ImgQ4A2.enable = FALSE
		Container.ImgQ4A3.enable = FALSE
		Container.ImgQ4A4.enable = FALSE
		Container.ImgQ4A5.enable = FALSE
		Container.ImgQ4A6.enable = TRUE
			
		Form.SetCtlProp("Container.ImgQ4A1", "imgpath", unPressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A2", "imgpath", unPressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A3", "imgpath", unPressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A4", "imgpath", unPressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A5", "imgpath", unPressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A6", "imgpath", PressedImgPath)	

		g_nWarnCnt = 1
		g_szGrade = "KYCD★06★"

	else
		Container.ImgQ4A1.enable = TRUE
		Container.ImgQ4A2.enable = TRUE
		Container.ImgQ4A3.enable = TRUE
		Container.ImgQ4A4.enable = TRUE
		Container.ImgQ4A5.enable = TRUE
		Container.ImgQ4A6.enable = TRUE
				
		Form.SetCtlProp("Container.ImgQ4A1", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A2", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A3", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A4", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A5", "imgpath", PressedImgPath)	
		Form.SetCtlProp("Container.ImgQ4A6", "imgpath", PressedImgPath)	

		g_nWarnCnt = 6
		g_szGrade = "KYCD★01★KYCD★02★KYCD★03★KYCD★04★KYCD★05★KYCD★06★"

	end if
	
	
End Function

'============================================================================
' 이미지 초기화
'============================================================================
Function ClearCheckAnswer(szQNum)
	Dim nQNum
	nQNum = CDbl(szQNum)
	nTIdx = nQNum - 1

	Select case nQNum
		case 1, 2, 3, 4, 5, 6 'V0001
		    for j = 0 to g_tAnswerCnt[nTIdx]
			   Form.SetCtlProp("Container.ImgQ" & nQNum & "A" & j, "imgpath", unPressedImgPath)
		    next		
    End Select
End Function

'============================================================================
Function ClearSharedData()

	'1. 판매채널
	g_szChan = "SALE★2★"
	Form.SetSharedData("51000_CHAN" , g_szChan)	'온라인 디폴트
	
	'2.	투자지역	
	g_szArea = ""
	Form.SetSharedData("51000_AREA" , g_szArea)	'전체 디폴트
		
	'3.	펀드유형
	g_nTypeCnt = 0
	g_szType = ""
	Form.SetSharedData("51000_TYPE" , g_szType)
	
	'4.	위험등급
	g_szGrade = ""
	Form.SetSharedData("51000_GRADE" , g_szGrade)
		
	'5.	펀드비용
	g_nFeeCnt = 0
	g_szFee = ""
	Form.SetSharedData("51000_FEE" , g_szFee)

	'6.  세제상품 V0001
	g_nSvngCnt = 0
	g_szSvng = ""
	Form.SetSharedData("51000_SVNG" , g_szSvng)
End Function


'============================================================================
Function SetCheckAnswer(szQNum, szAnswerNum)
	Dim nQNum, nTIdx ' 문항번호, 테이블 인덱스
	nQNum = CDbl(szQNum)
	nTIdx = nQNum - 1
	
	nAnswerCnt = g_tAnswerCnt[nTIdx]
	
	Select case nQNum
	    ' 버튼형 답변
	    case 1, 2, 5, 6
		    for j = 1 to CDbl(nAnswerCnt)
			    if j == CDbl(szAnswerNum) then
				    Form.SetCtlProp("Container.ImgQ" & nQNum & "A" & j, "imgpath", PressedImgPath)
			    else
				    Form.SetCtlProp("Container.ImgQ" & nQNum & "A" & j, "imgpath", unPressedImgPath)
			    end if
		    next		    
    End Select
End Function


