		Form.OpenPdfViewer("https://d3elgidnfmqtxw.cloudfront.net/bdm_info1.pdf", "계좌개설 후 절차안내")
	else
		Form.OpenExternalBrowser("https://d3elgidnfmqtxw.cloudfront.net/bdm_info1.pdf")
	end if
End Sub

