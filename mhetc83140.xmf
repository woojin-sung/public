	<SCRIPT_INFO _len="1402" _ulen="1294" >
Dim g_OStype

'============================================================================
Sub Image0_OnClick()
	'비대면 계좌개설 가이드
	 
	 if g_OStype = "1" then	 
		 Form.OpenPdfViewer("https://d3elgidnfmqtxw.cloudfront.net/bdm_info0.pdf", "비대면 계좌개설 가이드")
	 else
		 Form.OpenExternalBrowser("https://d3elgidnfmqtxw.cloudfront.net/bdm_info0.pdf")
	 end if
	
End Sub

'============================================================================
Sub Image1_OnClick()
	'비대면계좌개설 후 절차안내
