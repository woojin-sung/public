'EditInput0->일반/스마트OTP 20221114 추가
'EditInput1->모바일OTP
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim m_sEditIndex
Dim m_bShowSwitch
Dim m_bErrorCheck
Dim m_bCloseForm
Dim m_bOpenPopup

Dim g_sRetData
Dim g_sUserID, g_nOTPCnt, g_sSmartYN '사용자ID, OTP인증처리횟수, SmartOTP여부값
Dim g_nOTPPreCnt		'OTP 사전정보전송 cnt
Dim	g_PlainRm 'v003

Dim szText
Dim g_sAthnType
Dim g_sTrData
Dim g_sTranCrpt
Dim g_sSmrtOtpYn
Dim g_szChk

Dim g_szPwd
Dim g_szPwdLen

Dim g_szSuccFail

Dim g_RcnoPip, g_Csno, g_sUserNM, g_DeviceID, g_sTRNo, g_sTrAuthMsg

Dim g_MOtpSrnoSvr

'============================================================================
'초기화 함수
'============================================================================
Function Func_Clear_Pwd()
	g_szPwd = ""
	g_szPwdLen = ""
	EditInput0.clear = true
	EditInput1.clear = true
	Container1.EditPin.clear = true
	m_sEditIndex = 0

	cont0.PwdFail0.imgpath = "pwd_gray"
	cont0.PwdFail1.imgpath = "pwd_gray"
	cont0.PwdFail2.imgpath = "pwd_gray"
	cont0.PwdFail3.imgpath = "pwd_gray"
	cont0.PwdFail4.imgpath = "pwd_gray"
	cont0.PwdFail5.imgpath = "pwd_gray"

End Function

'============================================================================
Sub Form_OnFormInit()
	Dim szData
	
	g_RcnoPip	= Form.GetSharedData( "&JUMIN_NUM"	, false )    	'주민번호 암호화 값
	g_sUserNM	= Form.GetSharedData( "&USER_NAME"	, false )	'고객명
	g_Csno		= Form.GetSharedData( "&CUST_NUM"	, false )	'고객번호
	
	g_DeviceID	= Form.GetDeviceID() 
	
	DATAMANAGER.RequestTranData("obcsb_oimf_172r")	'서버조회
	
	'v0003 메모리평문적용여부(0:미적용 / 1:적용)
	g_PlainRm = Form.GetSharedData("&PLAIN_RM", false)
	if g_PlainRm == "1" then
	     '화면 마스킹표시/평문데이터로 설정(컨트롤속성-일반비밀번호사용 적용필수)
		EditInput0.SetEncExcept()	'일반/스마트OTP만 - 20221114
	end if 
	
	EditInput0.certname = "OTP번호 입력"
	Container1.EditPin.certname = "PIN번호 입력"
	
	g_sSmartYN = "N"
	g_nOTPCnt = 0
	g_nOTPPreCnt = 0
	g_sRetData = "cancel"
	g_sAthnType = "2"		'거래연동인증
	g_szChk = "1"
	
	g_szSuccFail = "Fail"
	
	g_sTrData = Form.GetSharedData("OTP_TR_MSG_1", false )
	g_sTrAuthMsg = Form.GetSharedData("OTP_TR_AUTH_MSG", true)

	LabelSRNO.caption = ""
	LabelDATE.caption = ""
	
'	cont0.enable = TRUE
'	cont0.EditInput1.enable = TRUE
'	Container1.visible = FALSE
	

	g_sUserID = Form.GetSharedData("CERT_ID" , false)
	if g_sUserID == null or g_sUserID == "" then
		g_sUserID = Form.GetSharedData("&USER_ID" , false)
	end if
	
	if g_sUserID ~= null and g_sUserID ~= "" then
		DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
	end if
	'-------------------------------------------------------

	m_sEditIndex = 0 
	
	m_bErrorCheck 	= false	'
	m_bCloseForm 		= true	'비밀번호 검증 완료 시, 팝업종료 여부 
	m_bOpenPopup 		= false	'자동저장기능 안내팝업 여부
	
'	'0.5초 후 보안키패드 띄움 20221114
'	Form.SetTimerEvent2(1, 1, 0.5)             
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent2(sTimerID, 0, 0.5)

	if Cint(sTimerID) = 1 then	
		EditInput1.setShowKeypad(True)
	elseif Cint(sTimerID) = 2 then	
		EditInput0.setShowKeypad(True)
	end if
End Sub

'============================================================================
Sub EditInput1_OnEditComplete()
	if m_bCloseForm = true then
		g_szPwd = EditInput1.caption
		
		if g_sSmrtOtpYn = "M" then
			DATAMANAGER.RequestTranData( "obcsb_oimf_174a" )
		else
			g_nOTPCnt = 0
			DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
		end if
	else
		m_bCloseForm = true
	end if

End Sub

'============================================================================
Sub EditInput1_OnEditError()
	'비밀번호 검증 오류 발생 시, 자동저장기능 안내팝업 뜬경우 후처리 비활성화
	if m_bOpenPopup = false then
		Func_Clear_Pwd()
		
		m_bErrorCheck = true
		EditInput1.setShowKeypad(True)
		
		cont0.PwdFail0.imgpath 	= "pwd_gray"
		cont0.PwdFail1.imgpath 	= "pwd_gray"
		cont0.PwdFail2.imgpath 	= "pwd_gray"
		cont0.PwdFail3.imgpath 	= "pwd_gray"
		cont0.PwdFail4.imgpath 	= "pwd_gray"
		cont0.PwdFail5.imgpath 	= "pwd_gray"

	end if
End Sub

'============================================================================
Sub EditInput1_OnEditChar(CharCode)
	m_bCloseForm = true
	
	if m_bErrorCheck then
		m_bErrorCheck = false
		Func_Clear_Pwd()
	end if
	
	if CharCode == "0" then
		m_sEditIndex = m_sEditIndex + 1 
		
		if CInt(m_sEditIndex) = 1 then
			cont0.PwdFail0.imgpath = "pwd_blue"
		elseif CInt(m_sEditIndex) = 2 then
			cont0.PwdFail1.imgpath = "pwd_blue"
		elseif CInt(m_sEditIndex) = 3 then
			cont0.PwdFail2.imgpath = "pwd_blue"
		elseif CInt(m_sEditIndex) = 4 then
			cont0.PwdFail3.imgpath = "pwd_blue"
		elseif CInt(m_sEditIndex) = 5 then
			cont0.PwdFail4.imgpath = "pwd_blue"
		elseif CInt(m_sEditIndex) = 6 then
			cont0.PwdFail5.imgpath = "pwd_blue"
		end if
		
	elseif CharCode == "1" then
		if CInt(m_sEditIndex) > 0 then 
			m_sEditIndex = m_sEditIndex - 1
		end if
		
		if CInt(m_sEditIndex) = 0 then
			cont0.PwdFail0.imgpath = "pwd_gray"
		elseif CInt(m_sEditIndex) = 1 then
			cont0.PwdFail1.imgpath = "pwd_gray"
		elseif CInt(m_sEditIndex) = 2 then
			cont0.PwdFail2.imgpath = "pwd_gray"
		elseif CInt(m_sEditIndex) = 3 then
			cont0.PwdFail3.imgpath = "pwd_gray"
		elseif CInt(m_sEditIndex) = 4 then
			cont0.PwdFail4.imgpath = "pwd_gray"
		elseif CInt(m_sEditIndex) = 5 then
			cont0.PwdFail5.imgpath = "pwd_gray"
		end if

	elseif CharCode == "2" then
		If g_DeviceOS == "2" then
			EditInput1.setShowKeypad(True)
		End if
	end if
	
End Sub

