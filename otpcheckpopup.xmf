Sub SetSmartUI(bState)
'	Form.ShowAlert("bState", bState)
	If bState == "Y" Then
'		contMotp.visible = False
		BtnRetry.visible = TRUE
		BtnRetry.enable = TRUE
		ImageHelp01.enable = TRUE
		ImageHelp01.visible = TRUE
		Image1.top = 260
		Image1.height = 387
		cont0.top = 352
		Label0.top = 268
		BtnApp.visible = TRUE
		BtnRetry.visible = TRUE
	else	
'		contMotp.visible = False
		BtnRetry.visible = FALSE
		BtnRetry.enable = FALSE
		ImageHelp01.enable = FALSE
		ImageHelp01.visible = FALSE
		BtnApp.visible = FALSE
		'Container1.visible = FALSE
		g_sAthnType = "1"
		Image1.top = 311
		Image1.height = 335
		cont0.top = 388
		Label0.top = 323	
		BtnRetry.visible = FALSE
	END IF   
	
	cont0.visible = TRUE
End Sub
