Sub BtnRetry_OnClick()
	if g_szChk == "1" Then
		g_sAthnType = "9"
		Container1.visible = TRUE
		BtnRetry.caption = "스마트 OTP 수동입력 해제"  'v0001
		g_szChk = "0"
	else
		g_sAthnType = "2"
'		Container1.visible = FALSE
		BtnRetry.caption = "데이터통신 장애 등 비상시 스마트 OTP 수동 입력" 'v0001
		g_szChk = "1"
	end if
	Container1_ButtonRequest_OnClick()
End Sub


'============================================================================
Sub BtnApp_OnClick()
	'테스트용 인증 스킵 체크 
	nDev = Form.GetSharedData("&SERVER_MODE", 0 )
	
	Dim sTemp
	sTemp = ""
	if  Form.GetSharedData("&OS_TYPE", false ) == "2" then'iOS("2")Android("1")
		sTemp = "IOS는 금융결제원(KFTC)스마트OTP앱을 지원하지 않습니다.\n"
	else
		if nDev == "1" then
			bRtn = Form.runStoreApp("com.kftc.smartotp", "")	
		else
			bRtn = Form.runStoreApp("com.kftc.smartotp", "")
		end if
	end if
	
	'bRtn = "" 함수정의 없음, 'bRtn = "0" 설치 안됨, 'bRtn = "1" 설치 됨
	if bRtn <> "1" then
		if Trim(bRtn) == "" Then
			Form.MsgBox("알림", sTemp&"Google play 스토어에서 금융결제원(KFTC) '스마트OTP 공동앱'을 다운받으신 후 실행해주시기 바랍니다.")
		elseif bRtn == 0 or bRtn == "0" Then
			Form.MsgBox("알림", "금융결제원(KFTC) 스마트OTP 공동앱을 설치하시겠습니까?", "KFTC_OTP", "1")
		end if
	end if	
End Sub
