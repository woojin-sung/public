Sub cont0_Button1_OnClick()
	Func_Clear_Pwd()
	if g_sSmrtOtpYn == "M" then		'20221114
		EditInput1.setShowKeypad(True)
	else
		EditInput0.setShowKeypad(True)
	end if
	m_bCloseForm = false
End Sub

'============================================================================
Sub BtnRetry_OnChange(sCheckState)
	if sCheckState == "1" Then
		g_sAthnType = "9"
		EditInput1.setShowKeypad(False)
		Container1.visible = TRUE
		Form.SetTimerEvent2(2, 1, 0.5)  
		BtnRetry.chkcaption = "스마트 OTP 수동입력 해제"  'v0001
		g_szChk = "0"
	else
		g_sAthnType = "2"
		Container1.visible = FALSE
		BtnRetry.chkcaption = "데이터통신 장애 등 비상시 스마트 OTP 수동 입력" 'v0001
		g_szChk = "1"
	end if
	Container1_ButtonRequest_OnClick()
End Sub 
'============================================================================
Sub EditInput0_OnEditComplete()
	if m_bCloseForm = true then
		g_szPwd = EditInput0.caption
		
		if (Container1.EditPin.caption == null or Container1.EditPin.caption == "") and g_sAthnType = "9" then
			Form.MsgBox( "알림", "PIN번호를 재조회해주세요.", "", 6 )	
		else
			g_nOTPCnt = 0
			DATAMANAGER.RequestTranData( "obcsb_oimf_522a" ) 'OTP정보확인
		end if
		
		'Form.CloseForm()
	else
		m_bCloseForm = true
	end if
End Sub


Sub Form_OnTriggerEventMOTP(sEventName, sParam)
	if sEventName == "MOTP_GET_VERSION_RETURN_otpcheckpopup" then
		arrData = Split(sParam,"★")		'resultcode★resultMsg★mSBVersion
		
		if arrData[0] <> "00000" then
			Form.MsgBox( "알림", arrData(1), "close", 6 )
		Else
			g_mSBValue  = arrData[2]
		end if
		
	elseif sEventName == "MOTP_GETINFO_RETURN_otpcheckpopup" then
		
		arrData  = Split(sParam,"★")    'resultc ode★resultMsg★otpAlias(일련번호)-로컬
		
		if arrData[0] <> "00000" then
			Form.MsgBox( "알림", "모바일OTP가 발급된 정보가 없습니다.".."\n".."모바일OTP를 발급하시겠습니까?", "close", 6 )
		else
			g_mOTPSrno = arrData(2)
			'20221114
			If g_mOTPSrno == null or g_mOTPSrno == "" then
				Form.MsgBox( "알림", "모바일OTP가 발급된 정보가 없습니다.".."\n".."모바일OTP를 발급하시겠습니까?", "close", 6 )
			else
				if g_MOtpSrnoSvr <> Right(g_mOTPSrno, 12) then	'로컬MOTP와 서버MOTP 정보 비교
					Form.MsgBox( "알림", "모바일OTP가 발급된 정보가 없습니다.".."\n".."모바일OTP를 발급하시겠습니까?", "close", 6 )
				end if
			end if
		end if
		
	elseif sEventName == "MOTP_REQ_OTP_ENC_RETURN_otpcheckpopup" then

		arrData = Split(sParam,"★")
		
		if arrData[0] <> "00000" then
			Form.MsgBox( "알림", arrData(1), "close", 6 )
		else
			g_mOTPData = arrData[2]
			DATAMANAGER.RequestTranData("obcsb_oimf_176a")
		end if
	end if
	
End Sub


'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "close" then
		Form.SetSharedData("mOTP_IntoClcd"   , "MTS"     )  '(모바일OTP)진입구분코드 20221114
		Form.OpenNextPopup( "mbotp86100.xmf", "", "" )
	else	
		if g_sSmrtOtpYn <> "Y" then
			EditInput1.setShowKeypad(True)
		end if
	end if
End Sub

'============================================================================
Sub EditInput0_OnEditChar(CharCode)
	m_bCloseForm = true
	
	if m_bErrorCheck then
		m_bErrorCheck = false
		Func_Clear_Pwd()
	end if
	
	if CharCode == "0" then
		m_sEditIndex = m_sEditIndex + 1 
		
		if CInt(m_sEditIndex) = 1 then
			cont0.PwdFail0.imgpath = "pwd_blue"
		elseif CInt(m_sEditIndex) = 2 then
			cont0.PwdFail1.imgpath = "pwd_blue"
		elseif CInt(m_sEditIndex) = 3 then
			cont0.PwdFail2.imgpath = "pwd_blue"
		elseif CInt(m_sEditIndex) = 4 then
			cont0.PwdFail3.imgpath = "pwd_blue"
		elseif CInt(m_sEditIndex) = 5 then
			cont0.PwdFail4.imgpath = "pwd_blue"
		elseif CInt(m_sEditIndex) = 6 then
			cont0.PwdFail5.imgpath = "pwd_blue"
		end if
		
	elseif CharCode == "1" then
		if CInt(m_sEditIndex) > 0 then 
			m_sEditIndex = m_sEditIndex - 1
		end if
		
		if CInt(m_sEditIndex) = 0 then
			cont0.PwdFail0.imgpath = "pwd_gray"
		elseif CInt(m_sEditIndex) = 1 then
			cont0.PwdFail1.imgpath = "pwd_gray"
		elseif CInt(m_sEditIndex) = 2 then
			cont0.PwdFail2.imgpath = "pwd_gray"
		elseif CInt(m_sEditIndex) = 3 then
			cont0.PwdFail3.imgpath = "pwd_gray"
		elseif CInt(m_sEditIndex) = 4 then
			cont0.PwdFail4.imgpath = "pwd_gray"
		elseif CInt(m_sEditIndex) = 5 then
			cont0.PwdFail5.imgpath = "pwd_gray"
		end if

	elseif CharCode == "2" then
		If g_DeviceOS == "2" then
			EditInput0.setShowKeypad(True)
		End if
	end if
	
End Sub

'============================================================================
Sub EditInput0_OnEditError()
	'비밀번호 검증 오류 발생 시, 자동저장기능 안내팝업 뜬경우 후처리 비활성화
	if m_bOpenPopup = false then
		Func_Clear_Pwd()
		
		m_bErrorCheck = true
		EditInput0.setShowKeypad(True)
		
		cont0.PwdFail0.imgpath 	= "pwd_gray"
		cont0.PwdFail1.imgpath 	= "pwd_gray"
		cont0.PwdFail2.imgpath 	= "pwd_gray"
		cont0.PwdFail3.imgpath 	= "pwd_gray"
		cont0.PwdFail4.imgpath 	= "pwd_gray"
		cont0.PwdFail5.imgpath 	= "pwd_gray"

	end if
End Sub 
'============================================================================
Sub EditInput0_OnEditCancel()
	'20220622 아이티젠 START: 안드로이드에서 비번입력후 백버튼 탭시 부모폼으로 비번넘기는 현상 수정
	'20220622 아이티젠 END:
	Func_Clear_Pwd()
End Sub 
