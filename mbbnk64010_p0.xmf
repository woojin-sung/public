	if g_szCurrencyCode = "JPY" then
		n50_Unit = 5000
	elseif g_szCurrencyCode = "CNY" then
		n50_Unit = 500
	else
		n50_Unit = 50
	end if
	
	f_AddAmt(n50_Unit)
End Sub

