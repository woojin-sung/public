End Sub

'============================================================================
' btnBack_OnClick
'============================================================================
Sub btnBack_OnClick()
	Dim nLen
	nLen = Len(edtPrc.caption)

	if nLen <> 0 then
		szPrc = Left(edtPrc.caption, nLen-1)
		edtPrc.caption = szPrc
	end if
	
	if edtPrc.caption = "" then
		ImgPrcreset.visible = false
	end if
	
'	f_SetBtnConfirmEnable()
	btnConfirm.enable = true	
	btnConfirm.btnimage = "btn_20.9"
	btnConfirm.fgcolor = "273"
	
End Sub

'============================================================================
' btnConfirm_OnClick
'============================================================================
Sub btnConfirm_OnClick()
	szPrc = edtPrc.caption
	if szPrc <> "" and g_szCurrencyCode = "JPY" and (CDBL(szPrc) > int(szPrc)) then
		Form.MsgBox( "알림", "[JPY] 통화는 소수점 이하 금액\n이체가 불가합니다.\n보낼 금액을 다시 입력해주세요.", "", 6 )
		Exit Sub
	end if
	Form.SendReturnToParent("mbbnk64010_p0", szPrc)
	Form.CloseForm()
End Sub

'============================================================================
' BtnClose_OnClick : 닫기
'============================================================================
Sub BtnClose_OnClick()
	Form.SendReturnToParent("mbbnk64010_p0", g_szOpenPrc)						
	Form.CloseForm()	
End Sub

'============================================================================
' 10$
Sub btn10_OnClick()
	if g_szCurrencyCode = "JPY" then
		n10_Unit = 1000
	else
		n10_Unit = 10	
	end if
	
	f_AddAmt(n10_Unit)
End Sub

