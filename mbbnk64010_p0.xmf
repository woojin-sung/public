'============================================================================
' 전액 클릭시
Sub btnPlusAll_OnClick()

	edtPrc.caption = Cdbl(g_szMaxPrc)
	f_SetBtnConfirmEnable()
	
End Sub

'============================================================================
Sub f_AppendAmt(szAmt)

    If (Cdbl(edtPrc.caption..szAmt) >= 1000000000000) Then	'Max 정수기준 12자리
        return
    End If

    edtPrc.caption = edtPrc.caption..szAmt
    
    if Len(edtPrc.caption) > 10 then
	    '입력된 금액 자릿수 긴 경우 x 버튼 이미지랑 겹치지 않도록 위치 이동.
	    edtPrc.left = 10
	    ImgPrcreset.left = 335
	end if
    
    f_SetBtnConfirmEnable()
    
End Sub

'============================================================================
Sub f_AddAmt(szAmt)

    If (Cdbl(edtPrc.caption) + Cdbl(szAmt) >= 1000000000000) Then	'Max 정수기준 12자리
        return
    End If

    edtPrc.caption = Cdbl(edtPrc.caption) + Cdbl(szAmt)
    f_SetBtnConfirmEnable()
    
End Sub

'============================================================================
Function Calc_Zero(szPlus)
	Dim szPrc
	
	szPrc = edtPrc.caption	
		
	' "."이 있는지 체크
	szChk = InStr(edtPrc.caption, ".")

	if CStr(szChk) <> "0" then
		if Trim(szPlus) == "." then
			Exit Function
		else
			szCha = CInt(Len(edtPrc.caption) - szChk)
			
			if CStr(szCha) == g_szDecimal then
				Exit Function
			elseif CStr(szCha) == "1" then
				if Len(szPlus) == 1 then
					edtPrc.caption = edtPrc.caption & szPlus
					szPrc = edtPrc.caption & szPlus
				end if
				
				Exit Function
			end if
		end if
	else
'		szPrc = edtPrc.caption & szPlus
	end if
	
	if Len(edtPrc.caption) > 0 then
		szPrc = edtPrc.caption & szPlus
		
		Sum_Prc(szPrc)
	end if
	
	f_SetBtnConfirmEnable()
End Function

'============================================================================
' Sum_Prc
'============================================================================
Function Sum_Prc(szData)
	if Cdbl(szData) < 1000000000000 then		'Max 정수기준 12자리
	'if Len(szData) < 12 then		' Max 11
		edtPrc.caption = szData
	end if
End Function	

'============================================================================
Sub ImgPrcreset_OnClick()
	edtPrc.caption = ""
	lblOver.visible   = false
	
	'입력된 금액 자릿수 긴 경우 x 버튼 이미지랑 겹치지 않도록 위치 이동.
	edtPrc.left = 20
	ImgPrcreset.left = 330
	    
'	f_SetBtnConfirmEnable()
	btnConfirm.enable = true	
	btnConfirm.btnimage = "btn_20.9"
	btnConfirm.fgcolor = "273"
	
End Sub

'============================================================================
Function f_CheckAbleAmt()

	If edtPrc.caption == "" or CDBL(edtPrc.caption) = 0 Then
	'If edtPrc.caption == "" Then
		ImgPrcreset.visible = false
		btnConfirm.enable   = false
	Else
		ImgPrcreset.visible = true '금액클리어 버튼
	End If
	
'ShowAlert(edtPrc.caption, g_szMaxPrc)
	If CDBL(edtPrc.caption) > CDBL(g_szMaxPrc) Then
		lblOver.visible = true
'		btnConfirm.enable = false
	else
		lblOver.visible   = false
'		btnConfirm.enable = true
	end if

End Function

'============================================================================
Function f_SetBtnConfirmEnable()
	btnConfirm.btnimage = "btn_15.9"
	btnConfirm.enable = false

	f_CheckAbleAmt()

	if edtPrc.caption = "" or edtPrc.caption = NULL or CDBL(edtPrc.caption) = 0 then
'		btnConfirm.enable = false
		Exit Function	
	end if

	If CDBL(edtPrc.caption) > CDBL(g_szMaxPrc) Then
		btnConfirm.enable = false
		Exit Function	
	end if
	
	'이체가능
	btnConfirm.enable = true	
	btnConfirm.btnimage = "btn_20.9"
	btnConfirm.fgcolor = "273"
End Function


'============================================================================
Function f_SetScreen(g_szCurrencyCode)
'	'JPY 이외의 통화는 소수점 두자리 표현
'	if g_szCurrencyCode = "JPY" then
'		g_szDecimal = 0
'	else
		g_szDecimal = "2"
'	end if
	
	'통화별 이미지 & masking 표시
	if g_szCurrencyCode = "USD" then
		imgCurrency.imgpath = "flag_us2.png"		
	elseif g_szCurrencyCode = "HKD" then
		imgCurrency.imgpath = "flag_hk.png"
	elseif g_szCurrencyCode = "JPY" then
		imgCurrency.imgpath = "flag_jp2.png"
	elseif g_szCurrencyCode = "CNY" then
		imgCurrency.imgpath = "flag_chn.png"
	elseif g_szCurrencyCode = "EUR" then
		imgCurrency.imgpath = "flag_eu.png"
	elseif g_szCurrencyCode = "GBP" then
		imgCurrency.imgpath = "flag_uk.png"
	elseif g_szCurrencyCode = "AUD" then
		imgCurrency.imgpath = "flag_aus.png"
	elseif g_szCurrencyCode = "SGD" then
		imgCurrency.imgpath = "flag_sgp.png"
	elseif g_szCurrencyCode = "CAD" then
		imgCurrency.imgpath = "flag_can.png"
	elseif g_szCurrencyCode = "CHF" then
		imgCurrency.imgpath = "flag_swi.png"
	else
		imgCurrency.imgpath = "flag_general.png"
	end if
	
	
	'통화별 출금가능금액
	lblAbleAmt.caption = g_szMaxPrc
	sMask = "0,0,," .. " " ..g_szCurrencyCode .. ",1,,"..g_szDecimal..",1,0,0,0"
	lblAbleAmt.mask = sMask
	
	
	'보낼금액
	edtPrc.caption = g_szOpenPrc
	sMask = "0,0,," .. " " ..g_szCurrencyCode .. ",1,,"..g_szDecimal..",1,0,0,0"
	edtPrc.mask = sMask
	
	if CDBL(g_szOpenPrc) > 0 then
		ImgPrcreset.visible = true
	else
		ImgPrcreset.visible = false
	end if
	

	'통화별 기호 표시
	if g_szCurrencyCode = "JPY" or g_szCurrencyCode = "CNY" then
		szSymbol = "￥"
	elseif g_szCurrencyCode = "EUR" then
		szSymbol = "€"
	elseif g_szCurrencyCode = "GBP" then
		szSymbol = "￡"
	elseif g_szCurrencyCode = "USD" or g_szCurrencyCode = "HKD" or g_szCurrencyCode = "AUD" or g_szCurrencyCode = "SGD" or g_szCurrencyCode = "CAD" then
		szSymbol = "$"
	elseif g_szCurrencyCode = "CHF" then
		szSymbol = "Fr"
	else
		'USD, HKD, AUD, SGD, CAD
		szSymbol = ""
	end if


	'통화별 금액 단축버튼
	'' : 버튼명이 너무 길어서.. 버튼명 잘리지만 않게 너비 늘려놓은 상태!  추후 변경할꺼임!!
	if g_szCurrencyCode = "JPY" then
		btn10.caption = "1,000" & szSymbol
		btn50.caption = "5,000" & szSymbol
		btn100.caption = "10,000" & szSymbol
		btn1000.caption = "100,000" & szSymbol
		
		btn1000.width = 80
		btnPlusAll.left = 305
		btnPlusAll.width = 50
		
	elseif g_szCurrencyCode = "CNY" then
		btn10.caption = "10" & szSymbol
		btn50.caption = "500" & szSymbol
		btn100.caption = "1,000" & szSymbol
		btn1000.caption = "10,000" & szSymbol	
		
		btn1000.width = 80
		btnPlusAll.left = 305
		btnPlusAll.width = 50
		
	else
		btn10.caption = "10" & szSymbol
		btn50.caption = "50" & szSymbol
		btn100.caption = "100" & szSymbol
		btn1000.caption = "1,000" & szSymbol
	
		btn1000.width = 70
		btnPlusAll.left = 295
		btnPlusAll.width = 60
	end if
	
End Function

