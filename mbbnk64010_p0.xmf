'============================================================================
' 화 면 명 : 외화이체 금액입력키패드
'============================================================================

dim g_szOpenPrc
dim g_szMaxPrc
dim g_szCurrencyCode

dim g_szDecimal

'============================================================================
Sub Form_OnFormInitBefore()	
	imgCurrency.setMaintainingRatio("1")
	ImgPrcreset.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpen
	
	Form.SetScreenName("가격입력기")
	szOpen = Form.GetOpenLinkData()

	'사용자입력금액★출금가능금액★통화코드★
	if Trim(szOpen) <> "" then
		tData = Split(szOpen, "★")
		
		g_szOpenPrc		= tData(0)
		g_szMaxPrc		= tData(1)
		g_szCurrencyCode	= tData(2)
	
		'통화코드별 화면 셋팅
		f_SetScreen(g_szCurrencyCode)
	else
		g_szOpenPrc = 0
		g_szMaxPrc = 0
		g_szCurrencyCode = ""
	end if
	
'	f_SetBtnConfirmEnable()
End Sub

'============================================================================
Sub Form_OnRefresh()
	Form.CloseForm()
End Sub

'============================================================================
' btn1_OnClick
'============================================================================
Sub btn1_OnClick()
	f_AppendAmt(1)
End Sub

