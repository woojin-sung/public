	<CONTROL_INFO>
		<LABEL name="Label0" fgcolor="063:255255255" fontsize="5" caption="인증서 관리" bgcolor="064:188030030" transmode="0" halign="1" ly_vert="0,0,375,40,1" />
		<IMAGE name="Image0" autosize="1" imgpath="icon_main_03" ly_vert="343,8,24,24,1" />
