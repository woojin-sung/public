'============================================================================
' 화 면 명 : 관심종목_스타일3
' 화면설명 : 관심종목_스타일3
' 작    성 : 2016.03.   ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

' 관심그룹 Key
Dim g_szGSID 
g_szGSID = ""

Dim g_szCloud		' 관심동기화(0:미사용(로컬), 1:사용(서버))

' 종목선택시 연결화면(0:연결화면, 1:현재가, 2:주문, 3:차트)
DIm g_szMove
g_szMove = "0"

' 20160126 선택팝업관련 추가사항
Dim g_szSltCd', szMk

Dim g_nSum, g_nCnt1, g_nCnt2, g_nCnt3, g_nCnt4, g_nHyun
g_nSum, g_nCnt1, g_nCnt2, g_nCnt3, g_nCnt4 = 0, 0, 0, 0, 0, 0


Dim g_szPeriodType, g_szPeriod, g_szChrtType, g_szType
g_szPeriodType, g_szPeriod, g_szChrtType, g_szType = "2", "1", "D", "" ' 일
			
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' init_GWList :  관심그룹의 종목 재설정 (로컬/서버)
'============================================================================
Function init_GWList()
	' 설정에서 구분자를 받아온다.
	if g_szCloud == "1" then
		
		DATAMANAGER.RequestTranData("ohhts_intr_007r")
	else
		' 로컬 저장된 관심종목 가져오기
		Load_GWList()
	end if
End Function

'============================================================================
' Load_RecentList :  최근조회종목 리스트
'============================================================================
Function Load_RecentList(szData)
	Dim tList
	Dim szMk
	
	grdCode.rowcount = 0

	if Trim(szData) <> "" then
		tList = Split(szData, "`")
		
		nRowcount = 0		'20221025 HSZ
		
		For i = 0 to #tList-1
			szMk = Form.GetItemCodeInfo(tList(i), "market")
			szMk = Change_EtcMarket(szMk)
			'20221025 HSZ START: 최근조회종목 - 상품선물 안보이게
			'20221110 HSZ : 상품선물 "FF"분기처리 추가
			if szMk == "CF" or szMk == "FF" then

			else
				grdCode.insertrow = i
				grdCode.insertrow = nRowcount
		
'				grdCode.SetCellData("bd_code", i, tList(i))
				grdCode.SetCellData("bd_code", nRowcount, tList(i))
'				grdCode.SetCellData("bd_mk",   i, szMk)
				grdCode.SetCellData("bd_mk",   nRowcount, szMk)
'				grdCode.SetCellData("bd_memo", i, "")
				grdCode.SetCellData("bd_memo", nRowcount, "")
'				grdCode.SetCellData("bd_name", i, Form.GetItemCodeInfo(tList(i), "name"))	' 20160325 위젯위해 종목명 추가
				grdCode.SetCellData("bd_name", nRowcount, Form.GetItemCodeInfo(tList(i), "name"))	' 20160325 위젯위해 종목명 추가
				nRowcount = nRowcount + 1
			'20221025 HSZ END
			end if
		Next
	
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)

		Save_grdChart()		
	end if
End Function

'============================================================================
' Change_EtcMarket :  해외지수(대표, 업종지수)/ 채권의 마켓구분 변경
'============================================================================
Function Change_EtcMarket(szData)
	if Trim(szData) == "UJ" then
		return "N"
	elseif Trim(szData) == "BN" or Trim(szData) == "MM" then
		return "B"
	end if	
	
	return szData
End Function

'============================================================================
' Load_GWGroup :  ' 로컬 저장된 관심종목 가져오기
'============================================================================
Function Load_GWList()
	Dim tGroup, tList
	
	grdCode.rowcount = 0
	szGroup = Form.LoadConfigData("GWANSIM", g_szGSID)

	if Trim(szGroup) <> "" then
		tGroup = Split(szGroup, "♣")

		For i = 0 to #tGroup-1
			tList = Split(tGroup(i), "★")
			
			grdCode.insertrow = i
	
			grdCode.SetCellData("bd_code", i, tList(0))
			grdCode.SetCellData("bd_mk",   i, tList(1))
			grdCode.SetCellData("bd_memo", i, tList(2))
			grdCode.SetCellData("bd_name", i, tList(3))	' 20160325 위젯위해 종목명 추가
		Next
	
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)

		Save_grdChart()
	end if
End Function

'============================================================================
' Save_GWList
'============================================================================
Function Save_GWList()
	Dim szList, szCd, szMk
	
	For i = 0 to grdCode.rowcount-1
		szCd = grdCode.GetCellData("bd_code", i)
		szMk = grdCode.GetCellData("bd_mk",   i)
		
		if Trim(szMk) == "" then
			szMk = ""
		end if
		
		' 20160325 위젯위해 종목명 추가
		if i == 0 then
			szList = szCd  & "★" & szMk & "★" & grdCode.GetCellData("bd_memo", i) & "★" & grdCode.GetCellData("bd_name", i)
		else
			szList = szList & "♣" & szCd & "★" & szMk & "★" & grdCode.GetCellData("bd_memo", i) & "★" & grdCode.GetCellData("bd_name", i)
		end if
	Next

	' 동기화 시는 파일 저장만.. /////////////////////////////////////////////
	Form.SaveConfigData("GWANSIM", g_szGSID, szList)

	if g_szCloud == "0" then
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)	
		Save_grdChart()
	end if
	' ///////////////////////////////////////////////////////////////////////
End Function
'============================================================================
' Save_grdChart : 차트링크폼을 위해 다시 담아둔다.
'============================================================================
Function Save_grdChart()
	Dim nRow, nCnt
	Dim szCd, szMk
	
	nRow = grdCode.rowcount()
	g_nSum = 0
	grdChart.rowcount = 0
	
	For i = 0 to nRow -1
		szCd = Trim(grdCode.GetCellData("bd_code", i))
		szMk = Trim(grdCode.GetCellData("bd_mk", i))
		
		'if szCd <> "" and szCd <> "빈칸" and szCd <> "0" and szCd <> "EMPTY" then
		if szMk <> "" then
			grdChart.insertrow = g_nSum
			grdChart.SetCellData("bd_code", g_nSum, szCd)
			grdChart.SetCellData("bd_mk", g_nSum, szMk)
			g_nSum = g_nSum + 1
		end if
	Next
	
	'lblTitle.caption = "1/" & g_nSum	' 20160324 디자인에서 빠짐
	
	Request_FiveChart(0)
End Function

'============================================================================
' Request_FiveChart : 서브차트화면에 조회 요청
'============================================================================
Function Request_FiveChart(nCnt)
	Dim nCht, i
	nCht = 0
	
	contChart.btnTop.enable    = true
	contChart.btnBottom.enable = true

	g_nHyun = nCnt
	
	For i = nCnt to nCnt+4
		if i < g_nSum then
			szMk = Trim(grdChart.GetCellData("bd_mk", i))
			szCd = Trim(grdChart.GetCellData("bd_code", i))
			Form.SetCtlProp("contChart.linkFm" & nCht, "linkfile", "mhprc11010_so")

			Form.triggerEvent("linkFm" & nCht, "REQEUST_CHART", szCd & "★" & szMk & "★" & g_szPeriodType & "★" & g_szPeriod & "★" & g_szChrtType & "★" & g_szType)
		else
			Form.SetCtlProp("contChart.linkFm" & nCht, "linkfile", "mhprc11010_sp")
			'Form.triggerEvent("linkFm" & nCht, "REQEUST_CHART", "★★★★★")
		end if
		
		nCht = nCht + 1
		
		if i == nCnt+4 then
			g_nCnt1 = nCnt-4
			g_nCnt2 = nCnt
			g_nCnt3 = nCnt+6		
			
			if nCnt+9 < g_nSum then
				g_nCnt4 = nCnt+10
			else
				g_nCnt4 = g_nSum
			end if			
		end if
	Next

	if nCnt == 0 then
		contChart.btnTop.enable = false
		
		contChart.lblTop.caption    = "▲  더보기 "
		contChart.btnTop.caption    = "▲  더보기 "
	else
		contChart.btnTop.caption    = "▲  더보기 (" & g_nCnt1 & "/" & g_nCnt2 & ")"
		contChart.lblTop.caption    = "▲  더보기 (" & g_nCnt1 & "/" & g_nCnt2 & ")"
	end if
	
	if g_nCnt3 > g_nSum then
		contChart.btnBottom.enable = false
		
		contChart.btnBottom.caption = "▼  더보기 "
		contChart.lblBottom.caption = "▼  더보기 "
	else
		contChart.btnBottom.caption = "▼  더보기 (" & g_nCnt3 & "/" & g_nCnt4 & ")"
		contChart.lblBottom.caption = "▼  더보기 (" & g_nCnt3 & "/" & g_nCnt4 & ")"
	end if
	
	contChart.scroll_pos = "top"
End Function

'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	Select Case szMk
		Case "J", "Q", "F", "MF", "XF", "O", "MO", "QO", "U", "T", "W", "B", "P", "N", "EN", "FN", "EMPTY", "JF", "JO", "WO"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	
			return szMk
'		Case "N"			' 해외지수, 환율은 같은 시장구분으로 내려오기에 분리시켜야 한다.
'			If InStr(szCd, "@") == 0 then
'				return "EN"
'			else
'				return szMk
'			end if
		Case Else
			return ""
	End Select
End Function

'============================================================================
' Change_Len
'============================================================================
Function Change_Len(szData)
	if Len(szData) == 1 then
		Change_Len = "0" & CStr(szData)
	else
		Change_Len = CStr(szData)
	end if 
End Function

