'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	' 관심 동기화 //////////////////////////////////////////////////////////
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	
	if Trim(g_szCloud) == "" then	' 초기값 : 1(동기화 사용)
		g_szCloud = "1"
	end if
	' //////////////////////////////////////////////////////////////////////
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	' ----------------------------------------------------------------------
	' 무브팝업리턴 받아 화면 이동
	' ----------------------------------------------------------------------		
	if sKeyName == "MOVEPOP_RETURN" then
		Dim tChk
		Dim szChk
		
		if sRet == "" then
			Exit Sub
		end if
		
		tChk = Split(sRet, "★")
		
		szChk = tChk(0)
		
		if UBound(tChk) > 0 then
			Select Case szChk
				Case "J", "Q", "T", "W"		' 코스피/코스닥, ETF, 신주인수권/신주인수권증서, 수익증권, K-OTC(프리보드), ELW
					if tChk(1) == "0" then						' 현재가
						Form.OpenScreen("11000", g_szSltCd)
					elseif tChk(1) == "1" then					' 차트
						Form.OpenScreen("13000", g_szSltCd)
					elseif tChk(1) == "2" then					' 뉴스
						Form.OpenScreen("44000", g_szSltCd)
					elseif tChk(1) == "3" then					' 매수
						Form.OpenScreen("12000", "관심종목★0" & "★" & g_szSltCd)
					elseif tChk(1) == "4" then					' 매도
						Form.OpenScreen("12000", "관심종목★1" & "★" & g_szSltCd)
					end if			
				Case "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO"	' KOSPI200지수 선물/선물 스프레드(옵션), 코스닥150 선물, 미니코스피 선물/선물 스프레드(옵션)	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)
					if tChk(1) == "0" then						' 현재가
						Form.OpenScreen("31000", g_szSltCd)		
					elseif tChk(1) == "1" then					' 차트
						Form.OpenScreen("31020", g_szSltCd)
					elseif tChk(1) == "2" then					' 선옵종합
						Form.OpenScreen("31010", g_szSltCd)
					elseif tChk(1) == "3" then					' 매수
						Form.OpenScreen("31030", "관심종목★0" & "★" & g_szSltCd)
					elseif tChk(1) == "4" then					' 매도
						Form.OpenScreen("31030", "관심종목★1" & "★" & g_szSltCd)
					end if
					
					Screen_No(szData, "31000", "31030", "31020")
				Case "U"						' 업종코드
					if tChk(1) == "0" then						' 지수상세
						Form.OpenScreen("42000", g_szSltCd)
					elseif tChk(1) == "1" then					' 차트
						Form.OpenScreen("42030", g_szSltCd)
					elseif tChk(1) == "2" then					' 지수종목
						Form.OpenScreen("42020", g_szSltCd)
					end if
				Case "N", "EN", "FN"				' 해외지수(대표지수/국가별업종지수(N), 세계환율(EN), CME선물/상품선물(FN))
					if tChk(1) == "0" then						' 해외지수
						Form.OpenScreen("42040", g_szSltCd)
					elseif tChk(1) == "1" then					' 해외차트
						Form.OpenScreen("42050", g_szSltCd)
					end if
				Case "B"						' 소액채권, 장내채권
					if tChk(1) == "0" then						' 현재가
						Form.OpenScreen("54010", g_szSltCd)
					elseif tChk(1) == "1" then					' 채권시세표
						Form.OpenScreen("54000", g_szSltCd)
					elseif tChk(1) == "2" then					' 매수
						Form.OpenScreen("54020", "관심종목★0" & "★" & g_szSltCd)
					elseif tChk(1) == "3" then					' 매도
						Form.OpenScreen("54020", "관심종목★1" & "★" & g_szSltCd)
					end if
			End Select
		end if
	end if
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' ----------------------------------------------------------------------
	' 메인화면에서 관심종목 조회를 요청 Trigger
	' ----------------------------------------------------------------------	
	if sEventName == "GW_LIST" then
		if sParam <> "" then
			tData = Split(sParam, "♥")
			
			g_szGSID = tData(0)
			edtvrsnID.caption = tData(1)
			
			grdCode.rowcount = 0
			
			' 종목선택시 연결화면(0:연결화면, 1:현재가, 2:주문, 3:차트)
			g_szMove = Form.GetEnvData("GW_MOVE")
			
			if Trim(g_szMove) == "" then
				g_szMove = "0"
			end if
			
			if g_szGSID == "AA" then			' Wathcing종목
				DATAMANAGER.RequestTranData("ohhts_watch_003")
			elseif g_szGSID == "BB" then		' 최근조회 종목
				szRecent = Form.GetRecentHistory("0")
				Load_RecentList(szRecent)
			elseif g_szGSID == "CC" then		' 보유종목
				DATAMANAGER.RequestTranData("obsim_stsv_047r")
			else
				' 관심그룹의 종목을 재설정
				init_GWList()			
			end if
		end if
	' ----------------------------------------------------------------------
	' 메인화면에서 차트설정 변경후 조회를 요청 Trigger
	' ----------------------------------------------------------------------	
	elseif sEventName == "SET_CHART" then		
		if sParam <> "" then
	
			tData = Split(sParam, "★")		
			
			g_szPeriodType = tData(0)
			g_szPeriod = tData(1)
			g_szChrtType = tData(2)
			g_szType = tData(3)
		
			Request_FiveChart(g_nHyun)
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	' ----------------------------------------------------------------------
	' Wathcing종목 조회
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_watch_003" then
		grdCode.rowcount = "0"
		
		DATAMANAGER.SetDataValue(0, "ohhts_watch_003", "InBlock1", "FID_INPUT_WRTR_ID", 0, Form.GetSharedData("&CUST_NUM", false))
	' ----------------------------------------------------------------------
	' 보유종목 조회
	' ----------------------------------------------------------------------	
	elseif szTranID == "obsim_stsv_047r" then
		grdCode.rowcount = "0"
		DATAMANAGER.SetDataValue(0, "obsim_stsv_047r", "InBlock1", "ELFN_ID", 0, Form.GetSharedData("&USER_ID", false))
	' ----------------------------------------------------------------------
	' 관심종목 종목 조회
	' ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_007r" then
		grdCode.rowcount = "0"
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_USER_ID",          0, Form.GetSharedData("&USER_ID", false))	' USER ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_007r", "InBlock1", "FID_CNCN_ISSU_GRP_ID", 0, g_szGSID)								' 관심그룹ID	
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 전체 장운영 알람 자동갱신
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_whol_mkop" then
		DATAMANAGER.SetDataValue(1, "ohhts_whol_mkop", "InBlock1", "FIDR_SHRN_ISCD", 0, "*")	' 단축종목코드
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szCd, szMk, szMm
	Dim nRow
	
	' 종목의 시장구분은 조회데이터가 잘못된 값이 내려올수 있으므로 메인에서 받아와야한다.	''''''''''''''''''	
	' ----------------------------------------------------------------------
	' 보유종목/관심종목 종목/Watching종목조회
	' ----------------------------------------------------------------------	
	if szTranID == "obsim_stsv_047r" or szTranID == "ohhts_intr_007r" or szTranID == "ohhts_watch_003" then
		if szTranID == "obsim_stsv_047r" then
			nCnt = DATAMANAGER.GetDataCount(0, "obsim_stsv_047r", "OutBlock1")
			
			if nCnt > 0 then
				nRow = 0
				
				For i = 0 to nCnt -1 
					szCd = DATAMANAGER.GetDataValue(0, "obsim_stsv_047r", "OutBlock1", "ISCD", i)
					grdCode.insertrow = nRow

					'20160729 NOHES START ETN, 채권 마켓타입에 따른 처리 추가
					szMk = Form.GetItemCodeInfo(szCd, "market")
					select Case szMk
					Case "Q", "BN", "B"
					
					'20210608 SWJ START : 신주인수권 보유종목 조회 오류현상 수정
					Case "J"
						szCutCd = szCd
					'20210608 SWJ END
					
					Case Else
						szCutCd = Mid(szCd, 2, Len(szCd))
						szMk = Form.GetItemCodeInfo(szCutCd, "market")
					End Select
					'20160729 NOHES END
					
					' 보유종목리스트에서 주식종목은 종목코드 맨 앞에 "A", ELW는 "J"가 붙어서 내려옴. 예외처리 ////
					' 보유종목리스트에서 선옵종목은 종목코드 맨 앞에 "K"가 붙어서 내려옴. 예외처리 20160402
					Select Case szMk
						Case "J", "T", "W", "F", "MF", "O", "MO", "JF", "JO", "XF", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)
							grdCode.SetCellData("bd_code", nRow, szCutCd)
							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCutCd, "name"))	' 20160325 위젯위해 종목명 추가
						'20160729 NOHES START ETN, 채권 마켓타입에 따른 처리 추가
						Case "Q", "BN", "B"
							grdCode.SetCellData("bd_code", nRow, szCd)
							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))
						Case "" 										'코드가 유효하지 않은 경우, 2자리 자르지 않은 전체 종목코드로 보여줌.
							grdCode.SetCellData("bd_code", nRow, szCd)
							grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))						
						'20160729 NOHES END
						Case Else
							if Left(szCd, 1, 1) == "A" or Left(szCd, 1, 1) == "K" then
								grdCode.SetCellData("bd_code", nRow, szCutCd)
								grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCutCd, "name"))	' 20160325 위젯위해 종목명 추가
							else
								grdCode.SetCellData("bd_code", nRow, szCd)
								grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCd, "name"))	' 20160325 위젯위해 종목명 추가
							end if
					End Select
					' ////////////////////////////////////////////////////////////////////////////////////////////
					szMk = Change_EtcMarket(szMk)
					grdCode.SetCellData("bd_mk",   nRow, szMk)

					nRow = nRow + 1
				Next
			end if
			
		' 관심종목 종목 조회, Watching종목 조회
		elseif szTranID == "ohhts_intr_007r" or szTranID == "ohhts_watch_003" then
			nRow = grdCode.rowcount
			
			For i = 0 to nRow - 1 
				szCode = grdCode.GetCellData("bd_code", i)
				szMk = Form.GetItemCodeInfo(szCode, "market")
				szMk = Change_EtcMarket(szMk)			
				
				grdCode.SetCellData("bd_mk", i, szMk)
			Next
		end if

		' 메인화면에서 종목추가 가능하므로 메인화면에 종목리스트 카운트를 알린다.
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
		grdCode.SetCellData("bd_name", i, Form.GetItemCodeInfo(szCode, "name"))	' 20160325 위젯위해 종목명 추가

		Save_GWList()		' 동기화 상태일때도 파일에는 계속저장
		Save_grdChart()		
	end if
End Sub

