'============================================================================
Sub Form_OnFormInit()




Label0.visible = 0

Grid0.SetVisibleCol(3, 0)
Grid0.SetVisibleCol(4, 0)
Grid0.SetVisibleCol(5, 0)
Grid0.SetVisibleCol(6, 0)

DATAMANAGER.SetDataValue(0, "obcpp_intr_754r", "InBlock1", "INP_MEMB_SRNO" , 0 , 1) '회원일련번호 set
DATAMANAGER.SetDataValue(0, "obcpp_intr_754r", "InBlock1", "INP_CLS_CODE", 0 , 1) ' 구분코드 set  1: 가입 2: 모의투자 3: 관심등록

DATAMANAGER.RequestTranData("obcpp_intr_754r")
tmp_cnt = 0
	
End Sub





'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)


     cnt = DATAMANAGER.GetDataCount(0, "obcpp_intr_754r" ,"OutBlock1") 
     
     if cnt == 0 then
     Label0.visible = 1
     Grid0.SetDeleteRow(0)
     end if
	
	'Form.MsgBox("테스트", cnt, "", "")
	
	for i = 0 to cnt-1
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_754r", "OutBlock1", "ADCP_NAME", i)
	Grid0.SetCellData("bd_cell0", tmp_cnt+i, tmp)

	'Grid0.SetCellData('sCellID, nRowIdx, sValue)
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_754r", "OutBlock1", "PRTF_NAME", i)
	Grid0.SetCellData("bd_cell3", tmp_cnt+i, tmp)
	
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_754r", "OutBlock1", "INP_INVT_INCL_CLCD", i) '위험등급'
	
	if abs(tmp) == 1 then
	tmp = "안정형"
	  
	elseif abs(tmp) == 2 then
	tmp = "안정추구형"
	
	elseif abs(tmp) ==3 then
	tmp = "중립형"
	
	elseif abs(tmp) == 4 then
	tmp = "수익추구형"
	
	elseif abs(tmp) ==5 then
	tmp = "고수익추구형"
	
	end if
	
	
	Grid0.SetCellData("bd_cell1", tmp_cnt+i, tmp)
	Grid0.SetCellFgColor("bd_cell1", tmp_cnt+i, "91")
	
	
	
	
	
	Grid0.SetCellData("bd_cell4", tmp_cnt+i, "▶")
	
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_754r", "OutBlock1", "FERT", i) '수수료
	Grid0.SetCellData("bd_cell5", tmp_cnt+i, "수수료 : "&Cint(tmp)&"%")
	
	
	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_754r", "OutBlock1", "ANTC_ERT", i) '예상수익률
	Grid0.SetCellData("bd_cell2", tmp_cnt+i, "수익률 : "&Cint(tmp)&"%")
	
	
	tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_754r", "OutBlock1", "JOIN_DATE", i) '가입날짜
	Grid0.SetCellData("bd_cell6", tmp_cnt+i, tmp)
	
	
	tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_754r", "OutBlock1", "FRST_CNRC_AMT", i) '최초투자금액
	Grid0.SetCellData("bd_cell8", tmp_cnt+i, tmp)
	
	tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_754r", "OutBlock1", "SPLM_INVT_AMT", i) '월투자금액
	Grid0.SetCellData("bd_cell10", tmp_cnt+i, tmp)
	
	tmp = DATAMANAGER.GetDataValue(0, "obcpp_intr_754r", "OutBlock1", "PRTF_ID", i) '포폴아이디
	Grid0.SetCellData("bd_cell12", tmp_cnt+i, tmp)
	
	
'	tmp  = DATAMANAGER.GetDataValue(0, "obcpp_intr_752r", "OutBlock1", "INP_RBDV_VLPN", i) '고객평점
	
'	if abs(tmp) == 1 then
'	tmp = "★☆☆☆☆"
'	  
'	elseif abs(tmp) == 2 then
'	tmp = "★★☆☆☆"
'	
'	elseif abs(tmp) ==3 then
'	tmp = "★★★☆☆"
'	
'	elseif abs(tmp) == 4 then
'	tmp = "★★★★☆"
'	
'	elseif abs(tmp) ==5 then
'	tmp = "★★★★★"
'	
'	end if
'	
	
	
	
	
'	Grid0.SetCellData("bd_cell12", tmp_cnt+i, tmp)
'	Grid0.SetCellData("bd_cell0", tmp_cnt+i, "자문사명")
'	Grid0.SetCellData("bd_cell1", tmp_cnt+i, "포트폴리오명")
'	Grid0.SetCellData("bd_cell2", tmp_cnt+i, "위험등급")
'	Grid0.SetCellData("bd_cell3", tmp_cnt+i, "수수료")
'	Grid0.SetCellData("bd_cell4", tmp_cnt+i, "예상수익률")
'	Grid0.SetCellData("bd_cell5", tmp_cnt+i, "고객평가")
'	
'	
'	Grid0.SetCellData("bd_cell6", tmp_cnt+i, "비교선택")
'	Grid0.SetCellFgColor("bd_cell6", tmp_cnt+i, 90)
'	
'	Grid0.SetCellData("bd_cell13", tmp_cnt+i, "상세보기")
'	Grid0.SetCellFgColor("bd_cell13", tmp_cnt+i, 90)
'	
	
	'if tmp_cnt+i < cnt-1 then
 	'Grid0.AddRow()
	
'	else
'	tmp_cnt = 0
'	end if
	
	
	
	next
	



	
End Sub

'============================================================================
Sub Grid0_OnClickUp(lRow, szCellID)
	
 tmp = Grid0.selectrow
 prtf_id = Grid0.GetCellData("bd_cell12", tmp)
 
 if szCellID == "bd_cell4" then 

 Form.OpenFramePopup("mbetc99000_s19" , prtf_id , "")
 
 else
 
 join_date = Grid0.GetCellData("bd_cell6", tmp)
 frst_amt =  Grid0.GetCellData("bd_cell8", tmp)
 m_amt = Grid0.GetCellData("bd_cell10", tmp)
 prtf_id = Grid0.GetCellData("bd_cell12", tmp)
 
 Form.OpenFramePopup("mbetc99020_s1" ,join_date&"●"&round(frst_amt/10000,0)&"●"&round(m_amt/10000,0)&"●"&prtf_id, "") '모의투자 상황 화면 
 
 
 end if
 
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "side_popup" then
	Grid0.width= 50
	end if
End Sub

