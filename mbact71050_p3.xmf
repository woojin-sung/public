'============================================================================
' 01. 화 면 명 : 고객자산평가_상품별잔고_주식/채권
' 02. 화면설명 : 고객자산평가_상품별잔고_주식/채권
' 03. 작    성 : 2016. 02. 03. 유창재
' 04. 수    정 : 2018. 08. 06. 신미정 v001 천원미만 채권잔고 표기 수정
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nAcntCount	'계좌 개수	
Dim g_nAllCount	'전체조회시 계좌 Index
Dim g_szList
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
Function AllSearch()
	g_nAllCount = g_nAllCount - 1
	
	if g_nAllCount > 2 then
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_029r", "InBlock1", "ACNO" , 0 , g_szList(Int(g_nAllCount)) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_029r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
		
		DATAMANAGER.RequestTranData( "obacb_balc_029r" )

	end if

	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	grd0.SetClear()

	if sEventName == "mbact71050_p3" then			'주식/채권
	
		g_szList = Split(sParam,"○")
		
	end if
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	g_nAcntCount = g_szList(0)		'계좌개수
	
	g_nAllCount = 4 + g_nAcntCount	'마지막 계좌 
	
	g_nNextCount = 0
	
	if g_szList(1) == "Y" then
		grd0.rowcount = 0
		AllSearch()
	else
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_029r", "InBlock1", "ACNO" , 0 , g_szList(3) )		'계좌번호
	'	DATAMANAGER.SetDataValue( 0 , "obacb_balc_029r", "InBlock1", "ACNT_PWD" , 0 , g_szList(1) )	'비밀번호
		DATAMANAGER.SetDataValue( 0 , "obacb_balc_029r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
		
		DATAMANAGER.RequestTranData( "obacb_balc_029r" )
	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp0, szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp11,
		szTemp12, TempCount, tmp_trgt_clcd
	'계좌번호블록에 계좌번호+계좌명으로 출력
	if szTranID == "obacb_balc_029r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obacb_balc_029r", "OutBlock2")-1
			
			grd0.AddRow()
			
			tmp_trgt_clcd = DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "PROS_TRGT_CLS_CODE" , i)	'1:주식, 2:채권
			szTemp0 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "ACNO" , i) &
					DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "ASNO" , i)	'계좌번호	
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "ABRV_ISNM" , i)	'종목명
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "BYOV_DATE" , i)	'매수일
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "BOND_CNTG_QTY" , i)	'체결잔고
			'szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "CNTG_QTY" , i)	'체결잔고
			
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "PSNT_PRC" , i)	'현재가
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "VLTN_AMT" , i)	'평가금액
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "BYNG_UNPR" , i)	'매수단가
			szTemp7 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "VLTN_PRLS_AMT" , i)	'평가손익
			szTemp8 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "ERT" , i)	'수익률
			szTemp9 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "MKSC_CLS_NAME" , i)	'잔고구분
			szTemp10 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "LOAN_DATE" , i)	'대출일자
			szTemp11 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "MTRT_DATE" , i)	'만기일자
			TempCount = Len(DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "ACNT_PRNM" , i))
			szTemp12 = Mid(DATAMANAGER.GetDataValue( 0 , "obacb_balc_029r", "OutBlock2", "ACNT_PRNM" , i), 3, TempCount - 2)'상품명
			
			grd0.SetCellData("bd_cell0", g_nNextCount , szTemp0)
			grd0.SetCellData("bd_cell1", g_nNextCount , szTemp1)
			grd0.SetCellData("bd_cell2", g_nNextCount , szTemp2)
			'grd0.SetCellData("bd_cell3", g_nNextCount , szTemp3) v001
			grd0.SetCellData("bd_cell5", g_nNextCount , szTemp5)
			grd0.SetCellData("bd_cell7", g_nNextCount , szTemp7)
			grd0.SetCellData("bd_cell8", g_nNextCount  , szTemp8)
			grd0.SetCellData("bd_cell9", g_nNextCount  , szTemp9)
			grd0.SetCellData("bd_cell10", g_nNextCount , szTemp10)
			grd0.SetCellData("bd_cell11", g_nNextCount  , szTemp11)
			grd0.SetCellData("bd_cell12", g_nNextCount  , szTemp12)
			
			IF tmp_trgt_clcd == "1" then
			
				grd0.SetCellData("bd_cell3", g_nNextCount , CDbl(szTemp3))
				grd0.SetCellData("bd_cell4", g_nNextCount , FormatNumber(szTemp4, 0))
				grd0.SetCellData("bd_cell6", g_nNextCount , FormatNumber(szTemp6, 0))
				
			else
				grd0.SetCellData("bd_cell3", g_nNextCount , CDbl(szTemp3))
				'Form.ShowAlert( "알림",CDbl(szTemp3))
				'grd0.SetCellData("bd_cell3", g_nNextCount , FormatNumber(szTemp3, 2))
				grd0.SetCellData("bd_cell4", g_nNextCount , FormatNumber(szTemp4, 2))
				grd0.SetCellData("bd_cell6", g_nNextCount , FormatNumber(szTemp6, 2))
				
			end if

			g_nNextCount = g_nNextCount + 1
		next
		
		grd0.rowcount = g_nNextCount
		
		if DATAMANAGER.IsMoreNextData( "obacb_balc_029r" ) == True then 
			DATAMANAGER.RequestNextData( "obacb_balc_029r" )
		else
			if g_szList(1) == "Y" then	'전체조회시
				AllSearch()
			end if
		end if
	end if
	
End Sub
'============================================================================
' grd0_OnScrollEnd()
'============================================================================
Sub grd0_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obacb_balc_029r" )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	grd0.SetClear()
	g_nNextCount = 0
End Sub
'============================================================================
Sub Form_OnFormInit()
	g_nAllCount = 0
End Sub

'
	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obacb_balc_029r" trcode="obacb_balc_029r" compress="1" encryption="1" inputcheck="1" useattr="0" >
				<TRBLOCK name="InBlock1" >
					<FIELD name="UI_UNIT_CLS" idx="0" defconst="1" />
					<FIELD name="WRAP_ACNT_YN" idx="1" defconst="N" />
					<FIELD name="IQRY_CNT" idx="6" defconst="00000030" />
				</TRBLOCK>
			</TRAN>
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obacb_balc_029r" title="주식 채권 잔고 평가 조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="288" _ulen="226" >

UI_UNIT_CLS^UI 단위 구분^1^0^0^0^0^0^0
WRAP_ACNT_YN^WRAP 계좌 여부^1^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
ACNT_PWD^계좌 비밀번호^68^0^0^0^0^0^0
STND_DATE^기준 일자^8^0^0^0^0^0^0
IQRY_CNT^조회 수^8^0^7^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="InBlock2" inout="in" _len="165" _ulen="131" >

BYNG_AMT^매입 금액^19^0^7^0^0^0^0
