	<SCRIPT_INFO _len="3788" _ulen="3556" >
dim g_szAccount

'============================================================================
Sub Form_OnFormInit()

	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()

	If szOpenData <> "" And szOpenData <> null Then	
		g_szAccount = szOpenData
	
		grid0.rowcount = 0
		DATAMANAGER.RequestTranData( "obcsb_acif_125r" )
	
	end if
	
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbonl94005_p2", "close")
End Sub

'============================================================================
Sub BtnOK_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_acif_125r" then
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "ACNO" , 0 , g_szAccount  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "IQRY_STA_DATE" , 0 , "00010101"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "IQRY_FIN_DATE" , 0 , "99991231" )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "APLT_DPCD" , 0 , "%"  )
		DATAMANAGER.SetDataValue( false, szTranID , "InBlock1" , "INVE_APLT_STCD" , 0 , "%"  )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_acif_125r" then
		Dim nCnt, nGridCnt
		nCnt = CInt(DATAMANAGER.GetDataCount( 0, szTranID, "OutBlock1" ))
		nGridCnt	= CInt(Grid0.rowcount)
		
		if nCnt = 0 or nCnt = NULL  then
			Grid0.visible = false
			lblNoData.visible = true
		else
			Grid0.visible = true
			lblNoData.visible = false
		
'			for i = 0 to nCnt
			for i = (nGridCnt - nCnt) to nGridCnt - 1
				szRegYn = Trim(Grid0.GetCellData("bd_cell4", i))		'등록여부
				szCancelCode = Trim(Grid0.GetCellData("bd_cell3", i))		'취소사유(코드)

				if szRegYn = "0" then
					szStatus = "등록신청"
				elseif szRegYn = "1" then
					szStatus = "접수완료"
				elseif szRegYn = "2" then
					szStatus = "영상통화"
				elseif szRegYn = "3" then
					szStatus = "영상통화(등록요청)"
				elseif szRegYn = "4" then
					szStatus = "등록완료"
				elseif szRegYn = "9" then
					'취소인 경우, 취소사유(코드)별 내용 보여주도록 변경.
					if szCancelCode = "1" then
						szStatus = "고객취소"
					elseif szCancelCode = "2" then
						szStatus = "요건미충족 취소"
					elseif szCancelCode = "3" then
						szStatus = "서류확인불가 취소"
					elseif szCancelCode = "4" then
						szStatus = "영상통화불가 취소"
					elseif szCancelCode = "5" then
						szStatus = "본인확인불가 취소"
					elseif szCancelCode = "6" then
						szStatus = "취소(기타)"
					else
						szStatus = "고객취소"
					end if
				elseif szRegYn = "T" then
					szStatus = "임시저장"
				end if

				Grid0.SetCellData("bd_cell1", i, szStatus)
			next
		end if
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	Form.ShowAlert(szTranID.."알림", szErrMsg & "(" & szSubMsg & ")")
End Sub


'============================================================================
Sub Grid0_OnScrollEnd( )  '스크롤 끝단에서 NEXT 데이타 처리!!!
	if szTranID = "obcsb_acif_125r" then
	   if DATAMANAGER.IsMoreNextData( szTranID ) = True then
	      DATAMANAGER.RequestNextData(  "obcsb_acif_125r" )
	   end if
	end if   
End Sub

