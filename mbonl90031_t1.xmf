'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_iDataCount
Dim g_nMode, g_OStype
Dim g_szTabIndex  'Bond365:0, 상품별소식:1, My뉴스:2
Dim g_szTagIndex

Dim g_szTagList0, g_szTagList1
g_szTagList0 = {"전체", "단기사채", "장외채권", "장내채권"} '발행어음(나중에 추가예정)
g_szTagList1 = {"전체", "국채", "공사채", "회사채", "단기채", "장기채"}

'20240220 개선사항 수정
Dim g_szTagList
g_szTagList = {"채권", "국채", "공사채", "회사채", "전단채", "전환사채", "통안채", "신종자본증권", "신주인수권부사채"}
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
Sub f_setTabCtrl()
	
	FormTab0.deleteAllPage()
'	Form.ShowAlert("f_setTabCtrl1", g_szTabIndex)
	
'	if CInt(g_szTabIndex) == 0 then
'		for i = 0 to #g_szTagList0 - 1		
'			FormTab0.insertPage( FormTab0.tabcount, "page"..i, "page"..i, "empty", "1", g_szTagList0[i])
'		next
'				
'	elseif CInt(g_szTabIndex) == 1 then
'		for i = 0 to #g_szTagList1 - 1
'			FormTab0.insertPage( FormTab0.tabcount, "page"..i, "page"..i, "empty", "1", g_szTagList1[i])
'		next
'	end if
	
	for i = 0 to #g_szTagList - 1
		FormTab0.insertPage( FormTab0.tabcount, "page"..i, "page"..i, "empty", "1", g_szTagList[i])
	next
	
	FormTab0.currenttab = 0
	g_szTagIndex = 0
end sub

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
'	Form.ShowAlert("OnFormInit_t1", "")
	g_szTagIndex = 0
	g_szTabIndex = 0
	
'	FormTab0.setTabHeaderImage("bg_tab_sel.9.png" , "bg.tab_nor.9.png" , 6) '활성화/비활성화/여백
'	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
	FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 6) '활성화/비활성화/여백
	FormTab0.setTabHeaderFgColor("28" , "321") '활성화/비활성화 폰트색상
		
	f_setTabCtrl()
	gridData.rowcount = 0
	DATAMANAGER.RequestTranData( "ohhts_news_009r")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim szTab
	
	if sEventName == "INIT" then
		g_szTabIndex = sParam
		
		f_setTabCtrl()
	
	elseif sEventName == "CHANGE_TAB" then
		g_szTabIndex = sParam
	
		f_setTabCtrl()
		
	end if
	
	gridData.rowcount = 0
	DATAMANAGER.RequestTranData( "ohhts_news_009r")
End Sub

'============================================================================
Sub FormTab0_OnTabChanged(nCurrentTab)
	g_szTagIndex = CInt(nCurrentTab)
	
	gridData.selectrow = -1
	
	gridData.rowcount = 0
	DATAMANAGER.RequestTranData( "ohhts_news_009r")
End Sub


'============================================================================
Sub gridData_OnClickUp(lRow, szCellID)
	Dim szValue, szLinkData
	Dim szTitle, szDate, szTime, szNewCorpName, szNewKey, szNewsCorpCode, szCode, szName
		
	szValue = gridData.GetCellData("FID_SRNO2",	lRow )

	szTitle			= gridData.GetCellData("FID_TITL",			lRow )	' 제목			-- FID_TITL
	szDate			= Left(szValue, 8)								' 날짜   		-- FID_DATE
	szTime			= Mid(szValue, 9, 6)								' 시간    		-- FID_CNTG_HOUR
	szNewCorpName		= gridData.GetCellData("FID_KOR_ISNM",		lRow )	' 뉴스제공업체명 	-- FID_KOR_ISNM
	szNewKey			= gridData.GetCellData("FID_NEWS_KEY",		lRow )	' 뉴스키       	-- FID_NEWS_KEY
	szNewsCorpCode	= gridData.GetCellData("FID_NEWS_OFER_ENTP_CODE",	lRow )' 뉴스제공업체코드-- FID_NEWS_OFER_ENTP_CODE
	szCode			= ""
	
	szName			= Form.GetItemCodeInfo(szCode, "name")
	
	szLinkData = "mbonl90001" & "★" & 
				szTitle & "|" & 
				szDate & "|" & 
				szTime & "|" & 
				szNewCorpName & "|" & 
				szNewKey & "|" & 
				szNewsCorpCode & "|" &  
				szName 
	
	'뉴스 상세내용 보기
	Form.OpenPopup( "mbonl90031_p1" , szLinkData, "" )
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szErrCode == "9900" then
'		Form.ShowAlert(szErrCode, gridData.rowcount)
		'조회건수가 없는경우
		if CInt(gridData.rowcount) == 0 then
			tblNoData.visible = True
		else
			tblNoData.visible = False
		end if
		
	else
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		
		if szSubErr <> null and Trim(szSubErr) <> "" then
			Form.ShowAlert( "알림" , "mbonl90031_t1("..szTranID..")\n" .. szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
		else
			Form.ShowAlert( "알림" , "mbonl90031_t1("..szTranID..")\n" .. szErrCode .. " : ".. szErrMsg)
		end if
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szValue
	
	if szTranID == "ohhts_news_009r" then	
'		if CInt(FormTab0.currenttab) == 0 then		
'			'태그 값에 전체 선택시
'			select case CInt(g_szTabIndex)
'				case 0	szValue = "10"
'				case 1	szValue = "11"
'			end select
''			Form.ShowAlert("TranBefore", szValue)
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_CLS_CODE",		0 , szValue)  
'			
'		else
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_CLS_CODE",		0 , "00")  '전체 조회
'			
'			select case CInt(g_szTabIndex)
'				case 0	szValue = g_szTagList0[CInt(FormTab0.currenttab)]
'				case 1	szValue = g_szTagList1[CInt(FormTab0.currenttab)]
'			end select
'			
'			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_TITL",			0 , szValue)
'		end if
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_CLS_CODE",		0 , "00")  
		
		szValue = g_szTagList[CInt(FormTab0.currenttab)]
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_INPUT_TITL",			0 , szValue)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim iDataCount
	
	if szTranID == "ohhts_news_009r" then
		g_iDataCount = gridData.rowcount
		
		iDataCount = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1")
		
		if CInt(g_iDataCount) == 0 and CInt(iDataCount) == 0 then
			
			Exit Sub
		end if
		
		for i = 0 to iDataCount - 1			
			szTemp1  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_SRNO2",				i)
			szTemp2  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_NEWS_OFER_ENTP_CODE",	i)
			szTemp3  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_KOR_ISNM",			i)
			szTemp4  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_NEWS_KEY",			i)
			szTemp5  = DATAMANAGER.GetDataValue(0, szTranID , "OutBlock1" , "FID_TITL",				i)
			
			gridData.AddRow()
			
			gridData.SetCellData("bd_date",				g_iDataCount + i, Left(szTemp1, 8))
			gridData.SetCellData("bd_time",				g_iDataCount + i, Mid(szTemp1, 9, 6))
			
			gridData.SetCellData("FID_SRNO2",				g_iDataCount + i, szTemp1)
			gridData.SetCellData("FID_NEWS_OFER_ENTP_CODE",	g_iDataCount + i, szTemp2)
			gridData.SetCellData("FID_KOR_ISNM",				g_iDataCount + i, szTemp3)
			gridData.SetCellData("FID_NEWS_KEY",				g_iDataCount + i, szTemp4)
			gridData.SetCellData("FID_TITL",				g_iDataCount + i, szTemp5)		
		next
		
'		Form.ShowAlert("OnReceiveTranComplete", DATAMANAGER.IsMoreNextData("ohhts_news_009r"))
'		if DATAMANAGER.IsMoreNextData(szTranID) == true then
'			DATAMANAGER.RequestNextData(szTranID)
'		
'		else
			g_iDataCount = g_iDataCount + iDataCount
			gridData.rowcount = g_iDataCount
			
			if CInt(gridData.rowcount) == 0 then
				tblNoData.visible = True
			else
				tblNoData.visible = False
			end if
			
'		end if
		
	end if
End Sub


'============================================================================
Sub gridData_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("ohhts_news_009r") == true then
		DATAMANAGER.RequestNextData("ohhts_news_009r")
	end if
End Sub

