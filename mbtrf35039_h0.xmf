'============================================================================
Sub Form_OnFormInitBefore()

	
End Sub

'============================================================================
Sub Form_OnFormInit()
	btnSearch_OnClick()
End Sub


'============================================================================
Sub btnSearch_OnClick()

	DATAMANAGER.RequestTranData( "obtrf_cntg_820r" )
	
End Sub


'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szAcno, szAsno
	
	szAcno = acnt0.total
	szAsno = acnt0.sequence
	
	If szTranID = "obtrf_cntg_820r" Then
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_820r", "InBlock1", "ACNO"			, 0 , szAcno 	)
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_820r", "InBlock1", "ASNO"			, 0 , szAsno 	)
		DATAMANAGER.SetDataValue( 0, "obtrf_cntg_820r", "InBlock1", "DATA_CLS"		, 0 , "0" 	)
		
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	Dim nCnt
	nCnt = DATAMANAGER.GetDataCount( 0, "obtrf_cntg_820r", "OutBlock2" )
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	If szTranID = "obtrf_cntg_820r" Then
		
		For i = 0 To grd2.rowcount - 1 
			Dim nCLPR, nPRPR
			Dim szData
			
			szData = grd2.GetCellData( "bd_cell10", i )
			
			Select Case szData
				Case "1" grd2.SetCellData("bd_cell1", i, "매도")
						grd2.SetCellFgColor("bd_cell1", i, "11")
				Case "2" grd2.SetCellData("bd_cell1", i, "매수")
						grd2.SetCellFgColor("bd_cell1", i, "10")
			End Select
			
			
			'전일대비
			nCLPR = CDbl( grd2.GetCellData( "bd_cell9", i ) )
			nPRPR = CDbl( grd2.GetCellData( "bd_cell7" , i ) )
			
			grd2.SetCellData("bd_cell8", i, nPRPR - nCLPR)
			
		Next
	End If
	
End Sub


'============================================================================
Sub acnt0_ChangeAccount()
	btnSearch_OnClick()
End Sub


'============================================================================
Sub acnt0_ChangeAccount()
	btnSearch_OnClick()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Form.ShowAlert( szErrCode , szErrMsg )
End Sub

'============================================================================
Sub btnClose_OnClick()

	Form.CloseForm()
	Form.SendReturnToParent("mbtrf35039" , acnt0.caption )
End Sub

'============================================================================
Sub imgClose_OnClick()
	btnClose_OnClick()
	
End Sub

'============================================================================
Sub Form_OnRefresh()
	btnSearch_OnClick()
End Sub
'============================================================================
Sub grd2_OnClickUp(lRow, szCellID)
Dim szItemCode, szItemMarket, szQty, szGbn, szData

	szItemCode = grd2.GetCellData("bd_cell11", lRow)

	If Left( Trim(szItemCode), 1 ) = "K" Then
		g_szItemCode	= Right( Trim(szItemCode), Len(Trim(szItemCode)) - 1)
	Else
		g_szItemCode	= szItemCode
	End If
	
	szItemMarket 	= Form.GetItemCodeInfo(g_szItemCode, "market_night")
	
	
	
	' 지수선물/미니선물/옵션/미니옵션만 가능, 위클리옵션(EW)추가
	if Trim(szItemMarket) == "CM" or Trim(szItemMarket) == "EO" or Trim(szItemMarket) == "EM" or Trim(szItemMarket) == "EW" then
	   Dim szOdrNo, szQty, szOdrType, szOdrPrc, szClsCd
	   
		listLocation =  Split(grd2.location,":")
		nYPos = Int(listLocation[1])
		height = listLocation[3]
	
		sPopupType = "2"
		
		szQty      = grd2.GetCellData("bd_cell2" , lRow)
	
		' 전달내용/탭위치/종목코드/수량
		' 전달내용, 탭위치는 리턴받아서 처리함.	
		g_szData = g_szItemCode & "★" & szQty 
	
		Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매수" & "★" & "매도" & "★" & "" & "★" & "")	
	Else
		Form.ShowAlert(g_szTitle, "선택상품은 MTS에서 거래되지 않는 상품입니다.")
	End If
End Sub
