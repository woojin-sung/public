<ROOT>
	<MAP_INFO scrno="57090" scrname="Wrap 계좌전환 신청_완료" version="2" writer="김철중" />
	<FORM_INFO name="Form" ly_vert="0,0,375,647,1" />
	<CONTROL_INFO>
		<LABEL name="lblText" caption="계좌전환 신청이
완료 되었습니다." halign="1" multiline="1" ly_vert="19,176,335,64,1" />
		<IMAGE name="imgAcntBg" autosize="1" imgpath="img_bgbox.9.png" ly_vert="29,253,315,40,1" />
		<LABEL name="lblAcnt" caption="[Wrap] 1234-1234-01" halign="1" ly_vert="29,263,315,20,1" />
		<BUTTON name="btnContract" caption="Wrap가입하러 가기" btnimage="btn_15.9" ly_vert="10,597,175,40,1" />
		<BUTTON name="btnOk" caption="확인" btnimage="btn_15.9" ly_vert="190,597,175,40,1" />
		<IMAGE name="Image0" imgpath="check_red.png" margin="0,0,5,0" ly_vert="136,55,100,100,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1167" _ulen="1167" >
--===========================================================================
--===========================================================================

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "N")
	lblAcnt.caption = Form.GetSharedData( "WRAP_ACNT" , false )
End Sub

'============================================================================
Sub btnContract_OnClick()
	Form.OpenScreen("57020", "")
End Sub

'============================================================================
Sub btnOk_OnClick()
	Form.OpenScreen("57090", "")
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	Form.SetSharedData("&BACK_PRESS_ENABLE", "Y")
	Form.OpenScreen("57090", "")
End Sub
'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("WRAP_ACNT", "")
End Sub
