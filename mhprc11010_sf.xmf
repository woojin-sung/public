	' 해외조회(차트_분)_Chart영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_5040_002r" then	
		DATAMANAGER.SetDataValue(0, "ohhts_5040_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)	
		DATAMANAGER.SetDataValue(0, "ohhts_5040_002r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
		
		DATAMANAGER.SetDataValue(0, "ohhts_5040_002r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)	
		DATAMANAGER.SetDataValue(0, "ohhts_5040_002r", "InBlock2", "FID_INPUT_ISCD",               0, g_szCd)	
		DATAMANAGER.SetDataValue(0, "ohhts_5040_002r", "InBlock2", "FID_INPUT_DATE1",              0, Form.GetSharedData("&HOST_DATE", 0))	
		DATAMANAGER.SetDataValue(0, "ohhts_5040_002r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN",  0, "Y")	
		sMin = Split(g_szType, "분", -1, 1)
		sTemp = sMin[0] * 60		
		DATAMANAGER.SetDataValue(0, "ohhts_5040_002r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE",      0, sTemp)		
	' ----------------------------------------------------------------------
	' 해외조회(차트_틱)_Chart영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_5040_003r" then	
		DATAMANAGER.SetDataValue(0, "ohhts_5040_003r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)	
		DATAMANAGER.SetDataValue(0, "ohhts_5040_003r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
		
		DATAMANAGER.SetDataValue(0, "ohhts_5040_003r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)	
		DATAMANAGER.SetDataValue(0, "ohhts_5040_003r", "InBlock2", "FID_INPUT_ISCD",               0, g_szCd)	
		DATAMANAGER.SetDataValue(0, "ohhts_5040_003r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE",      0, "2")	
		sTic = Split(g_szType, "틱", -1, 1)
		DATAMANAGER.SetDataValue(0, "ohhts_5040_003r", "InBlock2", "FID_INPUT_CNT1",               0, sTic[0])	
		DATAMANAGER.SetDataValue(0, "ohhts_5040_003r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN",  0, "N")	
	' ----------------------------------------------------------------------
	' 채권현재가(차트)_Chart영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_7052_004r" then	
		DATAMANAGER.SetDataValue(0, "ohhts_7052_004r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)	
		DATAMANAGER.SetDataValue(0, "ohhts_7052_004r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)	
	' ----------------------------------------------------------------------
	' 채권현재가(일자차트)_Chart영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_7052_007r" then	
		DATAMANAGER.SetDataValue(0, "ohhts_7052_007r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)	
		DATAMANAGER.SetDataValue(0, "ohhts_7052_007r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)	
	' ----------------------------------------------------------------------
	' 주식현재가_상단 현재가 영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_1001_001r" then	
		DATAMANAGER.SetDataValue(0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)	
		DATAMANAGER.SetDataValue(0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)	
	' ----------------------------------------------------------------------
	' 미니선물옵션현재가_상단 현재가 영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_3050_001r" then	
		DATAMANAGER.SetDataValue(0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)	
		DATAMANAGER.SetDataValue(0, "ohhts_3050_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)	
	' ----------------------------------------------------------------------
	' 업종현재가_상단 현재가 영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_1514_001r" then	
		DATAMANAGER.SetDataValue(0, "ohhts_1514_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U")	
		DATAMANAGER.SetDataValue(0, "ohhts_1514_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
		
		temp = Form.GetItemCodeInfo(g_szCd, "indextype")
		szMkCd = setMarketType(temp)

		DATAMANAGER.SetDataValue(0, "ohhts_1514_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, "U")	
		DATAMANAGER.SetDataValue(0, "ohhts_1514_001r", "InBlock2", "FID_INPUT_COND_SCR_DIV_CODE",  0, "1514")	
		DATAMANAGER.SetDataValue(0, "ohhts_1514_001r", "InBlock2", "FID_INPUT_MRKT_CLS_CODE",      0, szMkCd)	
	' ----------------------------------------------------------------------
	' 해외주요지수_상단 현재가 영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_1682_001r" then	
		DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)	
		DATAMANAGER.SetDataValue(0, "ohhts_1682_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)	
	' ----------------------------------------------------------------------
	' 해외환율정보_상단 현재가 영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_1684_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)	
		DATAMANAGER.SetDataValue(0, "ohhts_1684_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)	
	' ----------------------------------------------------------------------
	' 채권현재가_상단 현재가 영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_7052_001r" then	
		DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)	
		DATAMANAGER.SetDataValue(0, "ohhts_7052_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)		
	
	' ----------------------------------------------------------------------
	' 주식선물옵션현재가_상단 현재가 영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_3070_001r" then	
		DATAMANAGER.SetDataValue(0, "ohhts_3070_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)	
		DATAMANAGER.SetDataValue(0, "ohhts_3070_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)	
	
	' ----------------------------------------------------------------------
	' '해외주식
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_5041_001r" or szTranID == "ohhts_5041_002r" or szTranID == "ohhts_5041_003r"  
	       or szTranID == "ohhts_5041_004r" or szTranID == "ohhts_5041_005r" or szTranID == "ohhts_5041_006r"  then 	       
		
		szStockMode = "0"
		if g_sStockMode = "0" then
			szStockMode = "1"
		end if
		
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , g_szCd )
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , g_szMk)
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
		
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock2", "FID_INPUT_OVRS_ISCD" , 0 , g_szCd )
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock2", "FID_COND_MRKT_CLS_CODE" , 0 , g_szMk)
		szRealAble = Form.GetSharedData( "REALTIME_"..g_szMk, false )
		DATAMANAGER.SetDataValue( false, szTranID, "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , szRealAble )		
	
		' ----------------------------------------------------------------------
		' 해외주식조회(차트_틱)_Chart영역
		' ----------------------------------------------------------------------	
		if szTranID == "ohhts_5041_006r" then
		
			'sTic = Split(g_szTicType, "틱", -1, 1)
			sTic = Split(g_szType, "틱", -1, 1)
			DATAMANAGER.SetDataValue( 0, "ohhts_5041_006r", "InBlock2", "FID_INPUT_CNT1" , 0, sTic[0])
			DATAMANAGER.SetDataValue( 0, "ohhts_5041_006r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0, "Y")
		
		' ----------------------------------------------------------------------
		' 해외주식조회(차트_분)_Chart영역
		' ----------------------------------------------------------------------	
		elseif szTranID == "ohhts_5041_005r" then
		
			'sMin = Split(g_szMinType, "분", -1, 1)
			sMin = Split(g_szType, "분", -1, 1)
			sTemp = sMin[0] * 60
			
			DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE", 0, sTemp )
			DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FID_INPUT_DATE1" ,0, Form.GetSharedData("&HOST_DATE", 0))	
			DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0,"Y")
		' ----------------------------------------------------------------------
		' 해외주식조회(차트_일)_Chart영역
		' ----------------------------------------------------------------------	
		elseif szTranID == "ohhts_5041_001r" then
			
			DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE", 0, szStockMode )
			DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock2", "FID_INPUT_DATE1" ,0, Form.GetSharedData("&HOST_DATE", 0))			
			
		' ----------------------------------------------------------------------
		' 해외주식조회(차트_주)_Chart영역
		' ----------------------------------------------------------------------	
		elseif szTranID == "ohhts_5041_002r" then
			DATAMANAGER.SetDataValue( 0, "ohhts_5041_002r", "InBlock2", "FID_INPUT_DATE1" ,0, Form.GetSharedData("&HOST_DATE", 0))		
		' ----------------------------------------------------------------------
		' 해외주식조회(차트_월)_Chart영역
		' ----------------------------------------------------------------------	
		elseif szTranID == "ohhts_5041_003r" then
			DATAMANAGER.SetDataValue( 0, "ohhts_5041_003r", "InBlock2", "FID_INPUT_DATE1" ,0, Form.GetSharedData("&HOST_DATE", 0))		
		' ----------------------------------------------------------------------
		' 해외주식조회(차트_년)_Chart영역
		' ----------------------------------------------------------------------			
		elseif szTranID == "ohhts_5041_004r" then
			DATAMANAGER.SetDataValue( 0, "ohhts_5041_004r", "InBlock2", "FID_INPUT_DATE1" ,0, Form.GetSharedData("&HOST_DATE", 0))
		end if 
	' ----------------------------------------------------------------------
	' 해외주식조회 현재가
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_1030_002r" then
		DATAMANAGER.ClearInputData( false, "ohhts_1030_002r" )
		' MTS에서 보여주는 상품의 종목만 선택
		szMk = f_ChkMarket(szMk, szCd)					
		DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0 , "OV" ) '해외주식			
		DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_INPUT_OVRS_ISCD", 0 , g_szCd ) ' 종목코드
		DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FID_COND_MRKT_CLS_CODE", 0 , g_szMk ) '종목시장
		' 시장별 실시간여부값
		szRealAble = Form.GetSharedData( "REALTIME_"&szMk, false )
		DATAMANAGER.SetDataValue( false, "ohhts_1030_002r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE", 0, szRealAble ) '실시간여부
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 현재가(차트[일]) / 현재가(차트[분]) / 현재가(차트[틱])
	' ----------------------------------------------------------------------
	if szTranID == "ohhts_5010_001r" or szTranID == "ohhts_5010_002r" or szTranID == "ohhts_5010_003r" then
		if g_szMk == "W" then
			DATAMANAGER.RequestRealData("ohhts_elw_cntg")

		'20180712 HAMWG START : K-OTC MTS 도입
		elseif g_szMk == "T" then
			DATAMANAGER.RequestRealData("ohhts_frbr_cntg")
		'20180712 HAMWG END			
		
		else
			DATAMANAGER.RequestRealData("ohhts_stck_cntg")
		end if
	' ----------------------------------------------------------------------
	' 업종조회(차트) / 업종조회(차트[분]) / 업종조회(차트[틱])
	' ----------------------------------------------------------------------		
	elseif szTranID == "ohhts_5020_001r" or szTranID == "ohhts_5020_002r" or szTranID == "ohhts_5020_003r" then
		DATAMANAGER.RequestRealData("ohhts_nmix_cntg")
	' ----------------------------------------------------------------------
	' 선/옵조회(차트) / 선/옵조회(차트_분) / 선/옵조회(차트_틱)
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_5030_001r" or szTranID == "ohhts_5030_003r" or szTranID == "ohhts_5030_004r" then
		if g_szMk == "F" or g_szMk == "MF" or g_szMk == "XF" or g_szMk == "KF" then	'20190809_01 HWG : 위클리옵션추가(KRX300 추가)	' 20240412 HSZ 코스닥글로벌지수 추가
			DATAMANAGER.RequestRealData("ohhts_futs_cntg")
		elseif g_szMk == "O" or g_szMk == "MO" or g_szMk == "QO" or g_szMk == "WO" then	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)
			DATAMANAGER.RequestRealData("ohhts_optn_cntg")
		elseif g_szMk == "JO" then
			DATAMANAGER.RequestRealData("ohhts_sopt_cntg")
		elseif g_szMk == "JF" then
			DATAMANAGER.RequestRealData("ohhts_sfut_cntg")
		end if
	' ----------------------------------------------------------------------
	' 해외조회(차트) / 해외조회(차트_분) / 해외조회(차트_틱)
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_5040_001r" or szTranID == "ohhts_5040_002r" or szTranID == "ohhts_5040_003r"then
		if g_szMk = "N" then
			DATAMANAGER.RequestRealData("ohhts_ovrs_nmix")
		elseif g_szMk = "FN" then
			DATAMANAGER.RequestRealData("ohhts_nfut_cntg")
		elseif g_szMk = "EN" then
			DATAMANAGER.RequestRealData("ohhts_exrt_cntg")
		end if
	' ----------------------------------------------------------------------
	' 채권현재가(차트) / 채권현재가(일자차트)
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_7052_004r" then	
		DATAMANAGER.RequestRealData("ohhts_bond_cntg")
	' ----------------------------------------------------------------------
	' 주식현재가_상단 현재가 영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_1001_001r" then	
		if g_szMk == "W" then
			DATAMANAGER.RequestRealData("ohhts_elw_cntg_1")
			
		'20180712 HAMWG START : K-OTC MTS 도입
		elseif g_szMk == "T" then
			DATAMANAGER.RequestRealData("ohhts_frbr_cntg_1")
		'20180712 HAMWG END	
		
		else
			DATAMANAGER.RequestRealData("ohhts_stck_cntg_1")
		end if
	' ----------------------------------------------------------------------
	' 미니선물옵션현재가_상단 현재가 영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_3050_001r" then	
		if g_szMk == "F" or g_szMk == "MF" or g_szMk == "XF" or g_szMk == "KF" then	'20190809_01 HWG : 위클리옵션추가(KRX300 추가)	' 20240412 HSZ 코스닥글로벌지수 추가
			DATAMANAGER.RequestRealData("ohhts_futs_cntg_1")
		elseif g_szMk == "O" or g_szMk == "MO" or g_szMk == "QO" or g_szMk == "WO" then	'20190809_01 HWG : 위클리옵션추가(코스닥150 옵션 추가)
			DATAMANAGER.RequestRealData("ohhts_optn_cntg_1")
		end if
	' ----------------------------------------------------------------------
	' 업종현재가_상단 현재가 영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_1514_001r" then	
		DATAMANAGER.RequestRealData("ohhts_nmix_cntg_1")
	' ----------------------------------------------------------------------
	' 해외주요지수_상단 현재가 영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_1682_001r" then	
		if g_szMk = "N" then
			DATAMANAGER.RequestRealData("ohhts_ovrs_nmix_1")
		elseif g_szMk = "FN" then
			DATAMANAGER.RequestRealData("ohhts_nfut_cntg_1")
		end if
	' ----------------------------------------------------------------------
	' 해외환율정보_상단 현재가 영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_1684_001r" then
		DATAMANAGER.RequestRealData("ohhts_exrt_cntg_1")
	' ----------------------------------------------------------------------
	' 채권현재가_상단 현재가 영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_7052_001r" then	
		DATAMANAGER.RequestRealData("ohhts_bond_cntg_1")
		
	' ----------------------------------------------------------------------
	' 주식선물옵션현재가_상단 현재가 영역
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_3070_001r" then	
'		if g_szMk == "JF" then
'			DATAMANAGER.RequestRealData("ohhts_sfut_cntg")
'		elseif g_szMk == "JO" then
'			DATAMANAGER.RequestRealData("ohhts_sopt_cntg")
'		end if
	
	' ----------------------------------------------------------------------
	' 해외주식
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_5041_001r" or szTranID == "ohhts_5041_002r" or szTranID == "ohhts_5041_003r"  
	       or szTranID == "ohhts_5041_004r" or szTranID == "ohhts_5041_005r" or szTranID == "ohhts_5041_006r"  then
	       
'		DATAMANAGER.RequestRealData( "ohhts_exst_ictg" )
' 	       
'		'20221213_01 KBC 해외주식주간거래
'		if szTranID = "ohhts_5041_006r" or szTranID = "ohhts_5041_005r" then
'			DATAMANAGER.RequestRealData( "ohhts_exst_cntd" )
'		end if
'
	' ----------------------------------------------------------------------
	' 해외주식조회 현재가
	' ----------------------------------------------------------------------			
	elseif szTranID == "ohhts_1030_002r" then

		code = DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_ISCD" , 0 ) 
		nDtclose	= Cdbl(DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRPR", 0 ))	'20230109 HSZ
		nAftclode = Cdbl(DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_MKT_AFT_PRPR", j )) '20240524_01 KBC : 해외주식 고도화
	
		if code == g_szCd and Trim(code) <> "" then	'20230518 HSZ : 빈값체크로직 추가		
		
			'20240524_01 KBC START : 해외주식 고도화
			if g_szMk == "AX" or g_szMk == "NY" or g_szMk == "OQ" then
				if ((g_szUSAMrktTimeCd == "001" or g_szUSAMrktTimeCd == "002") and nDtclose <> 0) then
					'001.주간개시, 002.주간종료
					sDtclose		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRPR", 0 )
					sclose		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_PRPR", 0 )
					diff			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRDY_VRSS" , 0 )
					sign			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRDY_VRSS_SIGN" , 0 )
					rate			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_PRDY_CTRT" , 0 )
					tvol			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_DYTM_ACML_VOL" ,0 )
					sdecimal		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DCPN_CNT", 0 )
					GridHyun.SetCellData( "bd_hyun" , 0, Decimal_Setting( sDtclose , sdecimal ) )
				
				elseif g_szUSAMrktTimeCd == "005" or g_szUSAMrktTimeCd == "006" then 
					'005.AFTER개시, 006.AFTER종료
					sclose		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_MKT_AFT_PRPR", 0 )
					diff			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_MKT_AFT_PRDY_VRSS" , 0 )
					sign			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_MKT_AFT_PRDY_VRSS_SIGN" , 0 )
					rate			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_MKT_AFT_PRDY_CTRT" , 0 )
					tvol			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_ACML_VOL" , 0 )
					sdecimal		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DCPN_CNT", 0 )
					GridHyun.SetCellData( "bd_hyun" , 0, Decimal_Setting( sclose , sdecimal ) )	
				else
					'000.휴장
					'003.프리마켓개시
					'004.정규
					sclose		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_PRPR", 0 )
					diff			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_VRSS" , 0 )
					sign			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_VRSS_SIGN" , 0 )
					rate			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_CTRT" , 0 )
					tvol			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_ACML_VOL" , 0 )
					sdecimal		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DCPN_CNT", 0 )
					GridHyun.SetCellData( "bd_hyun" , 0, Decimal_Setting( sclose , sdecimal ) )
				end if
			else
					sclose		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_PRPR", 0 )
					diff			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_VRSS" , 0 )
					sign			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_VRSS_SIGN" , 0 )
					rate			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_PRDY_CTRT" , 0 )
					tvol			= DATAMANAGER.GetDataValue( false, "ohhts_1030_002r", "OutBlock1", "FIDX_ACML_VOL" , 0 )
					sdecimal		= DATAMANAGER.GetDataValue( false,  "ohhts_1030_002r", "OutBlock1", "FIDX_DCPN_CNT", 0 )
					GridHyun.SetCellData( "bd_hyun" , 0, Decimal_Setting( sclose , sdecimal ) )			
			end if	
			'20240524_01 KBC END
			
			GridHyun.SetCellData( "bd_debiIcon", 0, sign&"|"&diff)
			GridHyun.SetCellData( "bd_debi" , 0, Decimal_Setting( diff , sdecimal ) )
			GridHyun.SetCellData( "bd_rate" , 0, rate )
			GridHyun.SetCellData( "bd_vol" , 0, tvol )
			GridHyun.SetCellData( "bd_decimal", 0, sdecimal )	
			
			swapItemColor( 0, CDbl(diff))			
			
			' 시장별 실시간여부값
			szRealAble = Form.GetSharedData( "REALTIME_"&g_szMk, false )
			
			'20240524_01 KBC START : 해외주식 고도화
			'20230109 HSZ: 주간거래 실시간 체크 분기처리 추가
			if g_szUSAMrktTimeCd = "001" then	'주간거래 실시간 체크 -> 미국장은 주간거래 실시간만 받도록
				if g_szMk == "AX" or g_szMk == "NY" or g_szMk == "OQ" then
					DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntd", "InBlock1", "FIDXR_ISCD" , 0 , g_szMk&"@"&g_szCd)
					DATAMANAGER.RequestRealData("ohhts_exst_cntd")
				else
					DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , 0 , g_szMk&"@"&g_szCd)
					DATAMANAGER.RequestRealData("ohhts_exst_ictg")
				end if
			
			elseif g_szUSAMrktTimeCd == "002" then
				'주간장종료는 실시간 제외 (정규장 시간에 주간장 전환 시, 정규장 시세 실시간 받지않아야 함)				
				
			elseif g_szUSAMrktTimeCd = "005" then				
				'AFTER개시		
				if g_szMk == "AX" or g_szMk == "NY" or g_szMk == "OQ" then
					DATAMANAGER.SetDataValue( 1, "ohhts_exst_cnta", "InBlock1", "FIDXR_ISCD" , 0 , g_szMk&"@"&g_szCd)
					DATAMANAGER.RequestRealData("ohhts_exst_cnta")
				else
					DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , 0 , g_szMk&"@"&g_szCd)
					DATAMANAGER.RequestRealData("ohhts_exst_ictg")
				end if			
			else
				DATAMANAGER.SetDataValue( 1, "ohhts_exst_ictg", "InBlock1", "FIDXR_ISCD" , 0 , g_szMk&"@"&g_szCd)
				DATAMANAGER.RequestRealData("ohhts_exst_ictg")
			end if		
			'20240524_01 KBC END
		end if	
	end if 
	
	if GridHyun.GetCellString(0, 0) == "" then
		Label0.left = 0
		imgNotice.left = 170
		ChartEx0.left = 500	
	end if 
End Sub


'============================================================================
' 2017.11.22 -  LSS : 종목 대비값에 따른 색상 및 대비부호 설정
'============================================================================
Function swapItemColor(nIndex, nDiff)
	GridHyun.SetCellFgColor( "bd_hyun", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
	GridHyun.SetCellFgColor( "bd_debi", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) ) 
	GridHyun.SetCellFgColor( "bd_rate", nIndex, nDiff > 0 and "1" or ( nDiff < 0 and "2" or "3" ) )
End Function

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
'Form.Log("GWANSIM DATAMANAGER_OnSendRealBefore", g_szCd & ":" & g_szNm) 'KBC임시
	' ----------------------------------------------------------------------
	' 주식체결 자동갱신
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_stck_cntg" or szTranID == "ohhts_stck_cntg_1"then
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "RLTM_SHRN_ISCD",     0, g_szCd)
	' ----------------------------------------------------------------------
	' ELW체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_elw_cntg" or szTranID == "ohhts_elw_cntg_1" then
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_SHRN_ISCD",     0, g_szCd)
	' ----------------------------------------------------------------------
	' K-OTC체결 자동갱신 '20180712 HAMWG : K-OTC MTS 도입
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_frbr_cntg" or szTranID == "ohhts_frbr_cntg_1" then
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "RLTM_SHRN_ISCD",     0, g_szCd)
	' ----------------------------------------------------------------------
	' 업종지수 체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_nmix_cntg" or szTranID == "ohhts_nmix_cntg_1" then
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_BSTP_CLS_CODE", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 선물체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_futs_cntg" or szTranID == "ohhts_futs_cntg_1" then
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_SHRN_ISCD",     0, g_szCd)
	' ----------------------------------------------------------------------
	' 옵션체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_optn_cntg" or szTranID == "ohhts_optn_cntg_1" then
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_SHRN_ISCD",     0, g_szCd)
	' ----------------------------------------------------------------------
	' 해외지수/종목 체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_ovrs_nmix" or szTranID == "ohhts_ovrs_nmix_1" then
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_SYMB",          0, g_szCd)
	' ----------------------------------------------------------------------
	' 해외선물 체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_nfut_cntg" or szTranID == "ohhts_nfut_cntg_1" then
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_SYMB",          0, g_szCd)
	' ----------------------------------------------------------------------
	' 환율체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_exrt_cntg" or szTranID == "ohhts_exrt_cntg_1" then
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_SYMB",          0, g_szCd)
	' ----------------------------------------------------------------------
	' 일반채권 체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_bond_cntg" or szTranID == "ohhts_bond_cntg_1" then
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_STND_ISCD",     0, g_szCd)
		
	' ----------------------------------------------------------------------
	' 주식선물/옵션 체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_sfut_cntg" or szTranID == "ohhts_sopt_cntg" then
		DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDR_SHRN_ISCD",     0, g_szCd)
		
	' ----------------------------------------------------------------------
	' 해외주식  체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_exst_ictg" or szTranID == "ohhts_exst_cntd" then
		'DATAMANAGER.SetDataValue(1, szTranID, "InBlock1", "FIDXR_ISCD",     0, g_szCd)
	end if
End Sub


'============================================================================
' f_ChkMarket : MTS에서 미적용 상품 막기
'============================================================================
Function f_ChkMarket(szMk, szCd)
	Select Case szMk
		Case "J", "Q", "F", "MF", "XF", "KF", "O", "MO", "QO", "U", "T", "W", "B", "P", "N", "EN", "FN", "EMPTY", "JF", "JO", "WO"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	' 20240412 HSZ 코스닥글로벌지수 추가
			return szMk
		'해외주식	
		Case "AX", "HK", "JP", "SZ", "SH", "NY", "OQ"
			return szMk
'		Case "N"			' 해외지수, 환율은 같은 시장구분으로 내려오기에 분리시켜야 한다.
'			If InStr(szCd, "@") == 0 then
'				return "EN"
'			else
'				return szMk
'			end if
		Case Else
			return ""
	End Select
	
End Function

'============================================================================
' 입력값조절
'============================================================================
Sub Decimal_Setting(sValue, sDecimalLen)
	Dim sReturn
	sReturn = sValue
	if ( sValue ~= nil and sValue ~= "" ) and ( sDecimalLen ~= nil and sDecimalLen ~= "" ) then
		Dim sSign
		Dim nDecimal
		sSign = Left(sValue, 1)
		nDecimal = CDbl(sDecimalLen)
		if CDbl( sValue ) == 0 then
			if nDecimal > 0 then
				sReturn = "0."
				for i = 0 to nDecimal-1
					sReturn = sReturn.."0"
				next
			else
				sReturn = "0"
			end if			
		else
			Dim sTemp
			sTemp = {}
			sTemp = Split( sValue, "." )
			if nDecimal > 0 then
				if #sTemp >= 2 and sTemp[1] ~= nil and sTemp[1] ~= "" then
					Dim tempLen
					tempLen = Len(sTemp[1])
					if tempLen > nDecimal then
						sReturn = sTemp[0].."."..Left(sTemp[1], nDecimal)
					elseif tempLen < nDecimal then
						sReturn = sTemp[0].."."..sTemp[1]
						for i = 0 to (nDecimal-tempLen)-1
							sReturn = sReturn.."0"
						next
					end if
				else
					sReturn = sReturn.."."
					for i = 0 to (nDecimal)-1
						sReturn = sReturn.."0"
					next
				end if
			end if			
		end if
	end if
	
	if sSign == "-" or sSign == "+" then
		sReturn = sSign..sReturn
	end if
	
	return sReturn
end Sub
