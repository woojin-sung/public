'============================================================================
' 화 면 명 : 관심종목_스타일12(Chart)
' 화면설명 : 관심종목_스타일12(Chart)
' 작    성 : 2023.06.23 KKM
'============================================================================
' 20240412 HSZ 코스닥글로벌지수 추가 (KF)

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_szCd, g_szMk, g_rtChk, g_szNm, g_szPre
Dim g_szChrtType
Dim g_szType
Dim g_szGubun  '국외구분 KR,OV 
Dim g_szOff

g_sStockMode = "1"	'수정주가 1: 0
g_szOff = "0"

'20240524_01 KBC START : 해외주식 고도화
Dim g_szUSAMrktTimeCd
g_szUSAMrktTimeCd = ""

'20230109 HSZ 주간거래 시세 추가
'Dim g_szDaysise
'g_szDaysise = "0"
'20240524_01 KBC END

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' ClearRealData()
'============================================================================
Function ClearRealData()
	DATAMANAGER.CancelRealData("ohhts_elw_cntg")
	DATAMANAGER.CancelRealData("ohhts_stck_cntg")
	DATAMANAGER.CancelRealData("ohhts_nmix_cntg")
	DATAMANAGER.CancelRealData("ohhts_futs_cntg")
	DATAMANAGER.CancelRealData("ohhts_optn_cntg")
	DATAMANAGER.CancelRealData("ohhts_ovrs_nmix")
	DATAMANAGER.CancelRealData("ohhts_nfut_cntg")
	DATAMANAGER.CancelRealData("ohhts_exrt_cntg")
	DATAMANAGER.CancelRealData("ohhts_bond_cntg")
	
	DATAMANAGER.CancelRealData("ohhts_elw_cntg_1")
	DATAMANAGER.CancelRealData("ohhts_stck_cntg_1")
	DATAMANAGER.CancelRealData("ohhts_nmix_cntg_1")
	DATAMANAGER.CancelRealData("ohhts_futs_cntg_1")
	DATAMANAGER.CancelRealData("ohhts_optn_cntg_1")
	DATAMANAGER.CancelRealData("ohhts_ovrs_nmix_1")
	DATAMANAGER.CancelRealData("ohhts_nfut_cntg_1")
	DATAMANAGER.CancelRealData("ohhts_exrt_cntg_1")
	DATAMANAGER.CancelRealData("ohhts_bond_cntg_1")
	
	DATAMANAGER.CancelRealData("ohhts_sfut_cntg")		' 주식선물
	DATAMANAGER.CancelRealData("ohhts_sopt_cntg")		' 주식옵션
	
	'20180712 HAMWG START : K-OTC MTS 도입
	DATAMANAGER.CancelRealData("ohhts_frbr_cntg")		
	DATAMANAGER.CancelRealData("ohhts_frbr_cntg_1")
	'20180712 HAMWG END
	
	'230623 KKM START : 해외추가
	DATAMANAGER.CancelRealData("ohhts_exst_ictg")		
	DATAMANAGER.CancelRealData("ohhts_exst_cntd")	
	'230623 KKM END	
	
	DATAMANAGER.CancelRealData("ohhts_exst_cnta")		'20240524_01 KBC : 해외주식 고도화
	
End Function

'============================================================================
' RequestData
'============================================================================
Function RequestData()
	ClearRealData()
	ChartEx0.SetDataClear()
	
	Select Case g_szMk
		Case "J", "Q", "W", "T"	'20180712 HAMWG : K-OTC MTS 도입

			'ChartEx0.markettype = "1"
			
			DATAMANAGER.RequestTranData("ohhts_1001_001r")
			
			if g_szChrtType == "A" then		'분차트
				DATAMANAGER.RequestTranData("ohhts_5010_002r")	
			elseif g_szChrtType == "T" then		'틱차트		
				DATAMANAGER.RequestTranData("ohhts_5010_003r")		
			else
				DATAMANAGER.RequestTranData("ohhts_5010_001r")
			end if
		Case "F", "MF", "O", "MO", "JF", "JO", "XF", "KF", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	' 20240412 HSZ 코스닥글로벌지수 추가
			'ChartEx0.markettype = "4"
			
			DATAMANAGER.RequestTranData("ohhts_3050_001r")
			
			if g_szChrtType == "A" then		'분차트
				DATAMANAGER.RequestTranData("ohhts_5030_003r")	
			elseif g_szChrtType == "T" then		'틱차트		
				DATAMANAGER.RequestTranData("ohhts_5030_004r")		
			else
				DATAMANAGER.RequestTranData("ohhts_5030_001r")
			end if
		Case "U"	
			'ChartEx0.markettype = "2"
			
			DATAMANAGER.RequestTranData("ohhts_1514_001r")
			
			if g_szChrtType == "A" then		'분차트
				DATAMANAGER.RequestTranData("ohhts_5020_002r")	
			elseif g_szChrtType == "T" then		'틱차트		
				DATAMANAGER.RequestTranData("ohhts_5020_003r")		
			else
				DATAMANAGER.RequestTranData("ohhts_5020_001r")
			end if
		Case "B"
			'ChartEx0.markettype = "1"
			
			DATAMANAGER.RequestTranData("ohhts_7052_001r")
			
			if g_szChrtType == "A" then		'분차트
				' 채권 분 없음
			elseif g_szChrtType == "T" then		'틱차트		
				DATAMANAGER.RequestTranData("ohhts_7052_004r")		
			else
				if g_szChrtType == "D" then		' W,M 없음			
					DATAMANAGER.RequestTranData("ohhts_7052_007r")
				end if
			end if
		Case "N", "FN", "EN"
			'ChartEx0.markettype = "9"
			
			if g_szMk == "EN" then
				DATAMANAGER.RequestTranData("ohhts_1684_001r")
			else
				DATAMANAGER.RequestTranData("ohhts_1682_001r")
			end if
			
			if g_szChrtType == "A" then		'분차트
				if g_szMk <> "EN" then
					DATAMANAGER.RequestTranData("ohhts_5040_002r")	
				end if
			elseif g_szChrtType == "T" then		'틱차트		
				DATAMANAGER.RequestTranData("ohhts_5040_003r")		
			else
				if g_szMk == "EN" then
					if g_szChrtType == "D" then		' W,M 없음
						DATAMANAGER.RequestTranData("ohhts_5040_001r")					
					end if
				else
					DATAMANAGER.RequestTranData("ohhts_5040_001r")
				end if
			end if
			
		'해외주식	
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
		
			DATAMANAGER.RequestTranData("ohhts_1030_002r")		

			if g_szChrtType == "A" then		'분차트
				DATAMANAGER.RequestTranData("ohhts_5041_005r")
			elseif g_szChrtType == "T" then		'틱차트		
				DATAMANAGER.RequestTranData("ohhts_5041_006r")
			elseif g_szChrtType = "W" then		'주차트
				DATAMANAGER.RequestTranData("ohhts_5041_002r")
			elseif g_szChrtType == "M" then 	'월차트
				DATAMANAGER.RequestTranData("ohhts_5041_003r")
			elseif g_szChrtType == "Y" then 	'년차트
				DATAMANAGER.RequestTranData("ohhts_5041_004r")
			else'if g_szChrtType = "D" then		'일차트
				DATAMANAGER.RequestTranData("ohhts_5041_001r")
			end if
			
'		Case "JF", "JO" 
'			DATAMANAGER.RequestTranData("ohhts_3070_001r")	
		
	End Select
end Function

'============================================================================
' Set_ChartType
'============================================================================
Function Set_ChartType()
	Select Case g_szMk
		Case "J", "Q", "W", "JO", "JF", "T"	'20180712 HAMWG : K-OTC MTS 도입
			ChartEx0.setMarketCategory(0)
			ChartEx0.setDecimal("0")
		Case "F", "MF", "O", "MO", "XF", "KF", "QO", "WO"	'20190809_01 HWG : 위클리옵션추가(KRX300, 코스닥150 옵션 추가)	' 20240412 HSZ 코스닥글로벌지수 추가
			ChartEx0.setMarketCategory(1)
			ChartEx0.setDecimal("2")
		Case "U"	
			ChartEx0.setMarketCategory(1)
			ChartEx0.setDecimal("2")
		Case "B"
			ChartEx0.setMarketCategory(0)
			ChartEx0.setDecimal("0")
		Case "N", "FN", "EN"
			ChartEx0.setMarketCategory(6)	
			
			if g_szMk == "EN" then
				ChartEx0.setDecimal("4")	' 소수점 4자리
			else
				ChartEx0.setDecimal("2")	' 소수점 2자리
			end if
			
		'해외주식	
		Case "OQ", "AX", "NY", "SH", "SZ", "HK", "JP"
		
			ChartEx0.SetMarketCategory("7")
			'ChartEx0.setDecimal("0")		
	End Select
End Function

'============================================================================
' setMarketType
'============================================================================
Function	setMarketType(szData)
	if szData == "0" then
		return "K"
	elseif szData == "1" then
		return "Q"
	elseif szData == "2" then
		return "K2"
	elseif szData = "3" then
		return "KR"
	end	if
End	Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
	ChartEx0.SetChartType("linefill")
	imgNotice.setMaintainingRatio("1")		
End Sub

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()	
	Form.SetRealBundle("1")					'20230913 HSZ: 거래소 시세증속 대응
	g_szChrtType = "D" '일
	g_szType     = ""
	'szMkTp       = ChartEx0.markettype			' 주식 :1, 선물:4, 업종2, 해외9
	GridHyun.scrollenable = "0"	
End Sub

'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	Dim tData

	if sEventName == "REQEUST_CHART" then

		if sParam <> "" then
			'20240524_01 KBC START : 해외주식 고도화
			g_szUSAMrktTimeCd = Form.LoadConfigData("11010", "GW_MKT_TIME_CD")
			
'			g_szDaysise = Form.LoadConfigData("11010", "GW_DAYTIME")
'			if g_szDaysise == "" then
'				g_szDaysise = "0"
'			end if
			'20240524_01 KBC END		
			
			For i = 0 to 4
				tblHyun.SetCellString(0, i, "")
			Next
			
			GridHyun.SetClear()
			GridHyun.insertrow = 0
			
			tData = Split(sParam, "★")
			
			if tData(0) <> "" then
			
				g_szCd       = tData(0)
				g_szMk       = tData(1)
				g_szChrtType = tData(4)
				g_szType     = tData(5)
				g_szGubun    = tData(6) '국외구분
				g_szNm       = tData(7) '20240524_01 KBC : 해외주식 고도화
				g_szPre	    = tData(8) '20240524_01 KBC : 해외주식 고도화

				ChartEx0.SetPeriodType(tData(2))
				ChartEx0.SetPeriodTime(tData(3))

				if g_szGubun == "OV" then
					szName = Form.GetItemCodeInfo(g_szMk&"@"&g_szCd, "name")
				else
					szName = Form.GetItemCodeInfo(g_szCd, "name")
				end if
				
				'20240524_01 KBC START : 해외주식 고도화
				g_szOff = "0" '1.오프라인
				
				if Trim(szName) == "" then
					g_szOff = "1" '1.오프라인
					'Form.Log("GWANSIM", g_szCd & ":" & g_szNm & ":OFFLINE") 'KBC임시
					szName = g_szNm
				end if
				'20240524_01 KBC END
				
				tblHyun.SetCellString(0, 0, szName)				

				Label0.left = 500
				imgNotice.left = 670				
				ChartEx0.left = 0
	
				'20240524_01 KBC START : 해외주식 고도화
				if g_szOff == "1" then '1.오프라인			
					ClearRealData()
					ChartEx0.SetDataClear()
					
					
					'swapItemColor(0, 0.0) '20240524_01 KBC : 해외주식 고도화
	
					GridHyun.SetCellData( "bd_hyun" , 0, g_szPre )
					
'Form.Log("GWANSIM", g_szPre) 'KBC임시
					
					GridHyun.SetCellData( "bd_debiIcon", 0, "0|0")
					GridHyun.SetCellData( "bd_debi" , 0, "0" )
					GridHyun.SetCellData( "bd_rate" , 0, "0" )
					GridHyun.SetCellData( "bd_vol" , 0, "0" )
					GridHyun.SetCellData( "bd_decimal", 0, "0" )	
					
					Label0.left = 0
					Label0.caption = "오프라인 거래 국가 종목은 차트 제공이 불가합니다."
					ChartEx0.left = 500
					exit sub
				end if
				'20240524_01 KBC END

				Set_ChartType() '차트 틱,분,일,주,월
				RequestData()   'TR요청 
			else
				Label0.left = 0
				Label0.caption = tData(1) 
				'imgNotice.left = 170
				ChartEx0.left = 500
				
			end if
		end if
	end if
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	ClearRealData()
End Sub

