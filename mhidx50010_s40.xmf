<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="41000" scrname="HOME_MY종목" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,375,290,1" />
	<CONTROL_INFO>
		<LINKFORM name="linkfm1" ly_vert="0,0,375,290,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="906" _ulen="838" >
'============================================================================


'============================================================================
Sub Form_OnFormInit()

	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName = "LOGIN" then
		Form.triggerEvent( "linkfm1", "LOGIN", sParam  )			'그대로 전달
		
	elseif sEventName == "MOVE_MORE_SCREEN" then	'껍데기화면 더보기 클릭
		Form.triggerEvent( "linkfm1", "MOVE_MORE_SCREEN", sParam  )	'그대로 전달

	elseif sEventName = "LINKFILE" then		'맵파일 세팅(MY종목 / MY뉴스)
		if trim(sParam) <> "" then	
			szData = Split(sParam, "★")
			
			linkfm1.linkfile =  szData(0)
		end if
		
	elseif sEventName = "SWIPE" then		'스와이프
		Form.triggerEvent( "linkfm1", sEventName, sParam  )
	end if
	
End Sub


	</SCRIPT_INFO>
</ROOT>