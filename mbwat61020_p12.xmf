End Sub

'============================================================================
Sub btnClear_OnClick()
	g_sGroup1_Item = "99"
	g_sGroup2_Item = "99"
	g_sGroup3_Item = "99"
	g_sGroup4_Item = "99"
	groupTogle(9, "99")
	groupTogle(2, g_KycGrad)
End Sub

'============================================================================
Sub btnSearch_OnClick()
'Form.ShowAlert(g_sGroup1_Item)
	Dim sData
	
	if g_sGroup1_Item == "" or g_sGroup1_Item == null then
		g_sGroup1_Item = "99"
	end if
	
	if g_sGroup2_Item == "" or g_sGroup2_Item == null then
		g_sGroup2_Item = "99"
	end if
	
	if g_sGroup3_Item == "" or g_sGroup3_Item == null then
		g_sGroup3_Item = "99"
	end if
	
	if g_sGroup4_Item == "" or g_sGroup4_Item == null then
		g_sGroup4_Item = "99"
	end if
	
	sData = g_sGroup1_Item.."|"..g_sGroup2_Item.."|"..g_sGroup3_Item.."|"..g_sGroup4_Item
	
	Form.SendReturnToParent("CONFIRM" , sData)
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	Form.CloseForm()
End Sub

