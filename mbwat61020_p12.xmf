'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 상세검색 조건 입력 팝업
' 02. 화면설명 : 
' 03. 이    력 : 2023.05.09 : 고승연 : v0001 : 상세검색 불가 팝업 신규
'                2023.10.27 : 고승연 : v0002 : 상품위험등급 구분 변경, obwat_pdad_065r IO 수정
'                2024.01.22 : 고승연 : v0003 : 신규상품 추가
'                2024.03.26 : 고승연 : v0004 : [T2402290007] obwat_pdad_065r IO 수정
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sGroup1_Item
Dim g_sGroup2_Item
Dim g_sGroup3_Item
Dim g_sGroup4_Item

Dim g_SpclYn
Dim g_KycGrad
Dim g_ProsRslt
Dim g_invtYn
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
'	imgDot0.setMaintainingRatio("1")
'	imgDot1.setMaintainingRatio("1")
'	imgDot2.setMaintainingRatio("1")
'	imgDot3.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Form.SetScreenName("상세검색")

	Dim sData
	sData = Form.GetOpenLinkData()
	
	if sData <> "" then
		g_tData = Split(sData, "|")
		'sData = sSpclYn.."|"..sKycGrad.."|"..sProsRslt.."|"..invtYn
		'1:전문투자자여부
		'2:일임KYC코드
		'3:투자성향결과코드
		'4:투자성향맞춤여부
		
		g_SpclYn   = g_tData(0)		' 전문투자자여부
		g_ProsRslt = g_tData(2)		' 투자성향결과코드
		g_invtYn   = g_tData(3)		' 투자성향맞춤여부
		
		if g_SpclYn = "Y" then
			g_KycGrad  = "99"			' 일임KYC코드
		else
			if g_invtYn = "Y" and g_tData(1) <> "" and int(g_tData(1)) <> 0 and g_tData(1) <> null then
				g_KycGrad  = g_tData(1)	' 일임KYC코드
			else
				g_KycGrad  = "99"			' 일임KYC코드
			end if
		end if
		
	else
		g_SpclYn   = "N"
		g_KycGrad  = "99"
		g_ProsRslt = ""
	end if
	
	btnClear_OnClick()
End Sub

