'============================================================================
Sub groupTogle(szGroup, szItem)
	'상세검색 선택값 저장
	if szGroup == 1 then
		g_sGroup1_Item = szItem
	elseif szGroup == 2 then
		g_sGroup2_Item = szItem
	elseif szGroup == 3 then
		g_sGroup3_Item = szItem
	elseif szGroup == 4 then
		g_sGroup4_Item = szItem
	end if

	'운용주체 선택
	if szGroup = 1 then
		'초기화
		cont0.group1.Label0.fgcolor = "146"
		cont0.group1.Label1.fgcolor = "146"
		cont0.group1.Label2.fgcolor = "146"
		cont0.group1.Label3.fgcolor = "146"
		cont0.group1.Label4.fgcolor = "146"
		
		cont0.group1.Image0.imgpath = "input_03_n.9.png"
		cont0.group1.Image1.imgpath = "input_03_n.9.png"
		cont0.group1.Image2.imgpath = "input_03_n.9.png"
		cont0.group1.Image3.imgpath = "input_03_n.9.png"
		cont0.group1.Image4.imgpath = "input_03_n.9.png"
		
		'선택항목 표시
		if g_sGroup1_Item == "99" then
			cont0.group1.Label0.fgcolor = "334"
			cont0.group1.Image0.imgpath = "input_03_o.9.png"
		elseif g_sGroup1_Item == "02" then
			cont0.group1.Label1.fgcolor = "334"
			cont0.group1.Image1.imgpath = "input_03_o.9.png"
		elseif g_sGroup1_Item == "01" then
			cont0.group1.Label2.fgcolor = "334"
			cont0.group1.Image2.imgpath = "input_03_o.9.png"
		elseif g_sGroup1_Item == "03" then
			cont0.group1.Label3.fgcolor = "334"
			cont0.group1.Image3.imgpath = "input_03_o.9.png"
		elseif g_sGroup1_Item == "04" then
			cont0.group1.Label4.fgcolor = "334"
			cont0.group1.Image4.imgpath = "input_03_o.9.png"
		end if
		
	'위험등급 선택
	elseif szGroup = 2 then
		'초기화
		cont0.group2.Label5.fgcolor = "146"
		cont0.group2.Label6.fgcolor = "146"
		cont0.group2.Label7.fgcolor = "146"
		cont0.group2.Label8.fgcolor = "146"
		cont0.group2.Label9.fgcolor = "146"
		cont0.group2.Label10.fgcolor = "146"
		cont0.group2.Label118.fgcolor = "146"
		
		cont0.group2.Image5.imgpath = "input_03_n.9.png"
		cont0.group2.Image6.imgpath = "input_03_n.9.png"
		cont0.group2.Image7.imgpath = "input_03_n.9.png"
		cont0.group2.Image8.imgpath = "input_03_n.9.png"
		cont0.group2.Image9.imgpath = "input_03_n.9.png"
		cont0.group2.Image10.imgpath = "input_03_n.9.png"
		cont0.group2.Image118.imgpath = "input_03_n.9.png"
		
		'선택항목 표시
		if g_sGroup2_Item == "99" then
			cont0.group2.Label5.fgcolor = "334"
			cont0.group2.Image5.imgpath = "input_03_o.9.png"
		elseif g_sGroup2_Item == "01" then
			cont0.group2.Label6.fgcolor = "334"
			cont0.group2.Image6.imgpath = "input_03_o.9.png"
		elseif g_sGroup2_Item == "02" then
			cont0.group2.Label7.fgcolor = "334"
			cont0.group2.Image7.imgpath = "input_03_o.9.png"
		elseif g_sGroup2_Item == "03" then
			cont0.group2.Label8.fgcolor = "334"
			cont0.group2.Image8.imgpath = "input_03_o.9.png"
		elseif g_sGroup2_Item == "04" then
			cont0.group2.Label9.fgcolor = "334"
			cont0.group2.Image9.imgpath = "input_03_o.9.png"
		elseif g_sGroup2_Item == "05" then
