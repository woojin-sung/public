	<SCRIPT_INFO _len="2639" _ulen="2429" >
'============================================================================
' 01.화면명 	: 온라인계좌개설
' 02.화면설명	: 온라인계좌개설_예금자보호 안내문
' 03.작성	: 2016.06.17
' 2020.03.23 : v0001 : [T2003040024] 종금영업종료 및 사명 변경 (Table0->Tbabl1컨트롤변경)
' 2021.03.07 : v0002 : 예금자 보호 제도 변경 > ISA 예금자 보호 안내문 변경(Table2 컨트롤)
'============================================================================


'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
dim	g_szRet        	'리턴값
dim	g_szAlertTitle	'알림타이틀


g_szRet        = "0"
g_szAlertTitle = "알림"

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
'Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
    dim szURL

    szURL = "84010_DpsrPron"
    
    web01.viewtype = 0
    web01.urlpath = szURL

	'v0002
	Dim szOpenData
	szOpenData = Trim(Form.GetOpenLinkData())
	If szOpenData <> "" and szOpenData <> null THen
		If szOpenData == "ISA" Then
			Table1.visible = false
			Table2.visible = true
		End If
	End If

	Form.SetScreenName("예금자보호 안내문")
End Sub


'============================================================================
'BtnOK_OnClick
'============================================================================
'============================================================================
Sub BtnOK01_OnClick()
	If Chk01.checkstate = "0" Then
	    Form.ShowAlert(g_szAlertTitle, "예금자보호 확인을 체크하지 않으셨습니다.")
	    Exit Sub
	End If
	
     g_szRet	=	"1"
	Form.CloseForm()		
End Sub


'============================================================================
'Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("DPSRPRONOK" , g_szRet)
End Sub



	</SCRIPT_INFO>
</ROOT>