				<CELL cell_ly="0,0,0,0" halign="0" line="1,0" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,1,0,1" halign="0" line="1,0" caption="이 개인종합자산관리계좌(ISA)에 편입된 금융상품 중" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,2,0,2" halign="0" line="1,0" caption="예금보호 대상으로 운용되는 금융상품에 한하여" fontsize="-1" impidxs="" />
				<CELL cell_ly="0,3,0,3" halign="0" line="1,0" caption="예금자보호법에 따라 예금자보험공사가 보호하되," fontsize="-1" impidxs="" />
				<CELL cell_ly="0,4,0,4" halign="0" line="1,0" caption="보호 한도는 금융상품을 판매한 금융회사별로 귀하의 " fontsize="-1" impidxs="" />
				<CELL cell_ly="0,5,0,5" halign="0" line="1,0" caption="모든 금융상품의 원금과 소정의 이자를 합하여 " fontsize="-1" impidxs="" />
				<CELL cell_ly="0,6,0,6" halign="0" line="1,0" caption="1인당 “최고 5천만원”이며, 5천만원을 초과하는 " fontsize="-1" impidxs="" />
				<CELL cell_ly="0,7,0,7" halign="0" line="1,0" caption="나머지 금액은 보호하지 않습니다." fontsize="-1" impidxs="" />
