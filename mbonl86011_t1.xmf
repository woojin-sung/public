'============================================================================
' 01. 화 면 명 : 중요거래단말지정서비스_이용단말등록
' 02. 화면설명 : 중요거래단말지정서비스_이용단말등록 탭
' 03. 작    성 : 2016.01.18 ~ 최지희
' 2020.11.19 : 정민영 : v0001 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obcsb_oimf_638r IO 변경분 반영
' 2021.02.18 : 권오상 : v0002 : MOTP 적용
' 2022.10.12 : 장원혁 : v0003 : 이체화면에서 이동 시 간편이체약정 없이 단말지정만 하는 로직 적용
' 2022.11.15 : 양현정 : v0004 : 간편이체약정(058)은 단말지정시 무조건 등록이므로 이체화면에서 넘어올때 처리하는 로직 제거함.
' 2024.03.22 : 전상일 : v0005 : 보안매체 미보유 & 다중 클릭 체크
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szUserId	'고객아이디
Dim g_szMacAddr	'맥주소
Dim g_szOneTimeNo	'고객인증번호
Dim g_szCertType	'인증유형코드
Dim g_szCheck	'입력 유효성 체크
Dim g_bExit	
Dim g_bNew
Dim g_szSelect
Dim g_b63010		'이체화면에서 넘어온 경우(간편이체약정을 해야함)
Dim g_b63010_p0	'이체화면에서 넘어왔으나 간편이체약정을 하지 않아야 함.
Dim sSPLM_ATHN_NCSR_YN	'추가인증필요여부
Dim g_sGubunCode '보안카드 otp구분
Dim g_nCnt '기존 등록기기 갯수
Dim g_szSendData '기존 등록기기가 5개인 경우 팝업에서 해지 할 때 사용할 data
Dim g_bDelete
Dim g_tDeleteIdx
Dim g_nDeleteTableIdx
Dim gStplYn		'058 간편이체 약정등록여부
Dim g_onClickFlag   		'다중클릭 체크 v0005
'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
' TR_Inquiry
'============================================================================
Function TR_Inquiry(szTranID )
	'고객번호
	dim szCust_Num, szMediaType
	szCust_Num  = Form.GetSharedData("&CUST_NUM", false ) '로그인 해야만 고객번호 받아옴
	szMediaType = Form.GetSharedData("&MEDIA_CODE", false )
	
	if szTranID == "obcsb_oimf_638r" then	'전자금융사기예방 고객조회'
		'v0005
		if g_onClickFlag then
		else
			edtEnrollStatus.caption = ""
			edtServiceStatus.caption = ""
			Edit0.caption = ""
			
	'		Table1.SetCellString(0, 1, "")
	'		Table1.SetCellString(2, 1, "")
			
			Label5.caption = ""
			Label7.caption = ""
		end if
		'16-03-08 YCJ Input값 수정 MAC주소 -> DeviceID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , g_szUserId)	'사용자ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID())	'UI단말식별키
'		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "MAC_ADDR" , 0 , g_szMacAddr)	'MAC 주소
		DATAMANAGER.RequestTranData("obcsb_oimf_638r")
	end if
	
	if szTranID == "obcsb_oimf_636a" then	'이용단말등록
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "PROS_CLS" , 0 , "1")	'처리구분
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "ELFN_ID" , 0 , Trim(g_szUserId))	'전자금융ID
		DATAMANAGER.SetDataValue(0,  "obcsb_oimf_636a", "InBlock1", "TERM_NAME", 0 , Trim(Edit0.caption))	'단말명
		DATAMANAGER.SetDataValue(0,  "obcsb_oimf_636a", "InBlock1", "MAC_ADDR", 0 , g_szMacAddr)	'맥주소
		if Len(g_szOneTimeNo) == 6 then
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "UI_CUST_ATHN_NO" , 0 , g_szOneTimeNo)	'고객인증번호(6자리)/1회용인증번호
		end if
		DATAMANAGER.SetDataValue(0,  "obcsb_oimf_636a", "InBlock1", "ATHN_TYPE_CODE", 0 , g_szCertType)	'인증유형코드(1자리)
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "TERM_DSGT_CLS_CODE" , 0 , CInt(g_szSelect)+1) '
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID()) 'rdoService.currentindex+1
		DATAMANAGER.RequestTranData("obcsb_oimf_636a")
	end if

	if szTranID == "obcsb_oimf_636a_1" then	'이용단말등록
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a_1", "InBlock1", "PROS_CLS" , 0 , "2")	'처리구분
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a_1", "InBlock1", "ELFN_ID" , 0 , Trim(g_szUserId))	'전자금융ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a_1", "InBlock1", "TERM_NAME" , 0 , GridPro1.GetCellData( "bd_cell0", g_tDeleteIdx[g_nDeleteTableIdx] ))
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a_1", "InBlock1", "MAC_ADDR" , 0 , GridPro1.GetCellData( "bd_cell1", g_tDeleteIdx[g_nDeleteTableIdx] ))	'맥주소
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_636a_1", "InBlock1", "DISK_SERL_NO" , 0 , GridPro1.GetCellData( "bd_cell2", g_tDeleteIdx[g_nDeleteTableIdx] ))
		
		DATAMANAGER.RequestTranData("obcsb_oimf_636a_1")
	end if
	
	if szTranID == "obpds_srvc_185a" then	'간편이체 약정 등록
		DATAMANAGER.SetDataValue(0, "obpds_srvc_185a", "InBlock1", "PROS_CLS_CODE" , 0 , "1")	'처리구분1:등록
		DATAMANAGER.SetDataValue(0, "obpds_srvc_185a", "InBlock1", "CSNO" 		  , 0 , szCust_Num)	'고객번호
		DATAMANAGER.SetDataValue(0, "obpds_srvc_185a", "InBlock1", "SVCD" 		  , 0 , "058")
		DATAMANAGER.SetDataValue(0, "obpds_srvc_185a", "InBlock1", "CHAN_TYPE_CLS_CODE" , 0 , szMediaType)	'채널유형코드
		DATAMANAGER.SetDataValue(0, "obpds_srvc_185a", "InBlock1", "MAC_ADDR" 	  , 0 , g_szMacAddr) '맥주소
		DATAMANAGER.SetDataValue(0, "obpds_srvc_185a", "InBlock1", "UI_TERM_IDNT_KEY", 0 , Form.GetDeviceID())
		
		DATAMANAGER.RequestTranData("obpds_srvc_185a")
	end if	

End Function


'============================================================================
' SendReg
'============================================================================
Function SendReg()
	if g_szMacAddr == "" then
		Form.MsgBox("알림", "단말식별 정보획득이 불가능한 단말은 이용단말등록을 할 수 없습니다.", "", 0)
	else
		'보안매체 확인처리해야함	
		if g_bDelete then'기존 5대 등록 된 상태라 삭제 팝업에서 선택한 항목들 등록 해지 이후 등록 절차 진행
			g_nDeleteTableIdx = 1
			Call TR_Inquiry("obcsb_oimf_636a_1")'해지용 TR
		else
			Call TR_Inquiry("obcsb_oimf_636a")		
		end if
		
	end if

End Function

'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	'msgbox("sEventName=("&sEventName&") sParam=("&sParam&")")
	if sEventName == "enroll" then
		btnSearch_OnClick()
	elseif sEventName == "63010" then
		g_b63010 = true
		
		btnEnroll.top = "518" '"467"
		imgInfo.visible = true
	elseif sEventName == "63010_p0" then		'v0003
		g_b63010_p0 = true

		btnEnroll.top = "518" '"467"
		imgInfo.visible = true
	end if
End Sub

'============================================================================
' btnSearch_OnClick - 조회
'============================================================================
Sub btnSearch_OnClick()
	edtServiceStatus.caption = ""
	edtEnrollStatus.caption = ""
	Edit0.caption = "" 
	
'	Table1.SetCellString(0, 1, "")
'	Table1.SetCellString(2, 1, "")
	Label5.caption = ""
	Label7.caption = ""
'	rdoService.currentindex = -1
	
	g_bDelete = false
	g_szSelect = ""
	g_bNew = true'신규=T 변경=F
	f_Choose(-1)
	
	chkLimitAgree.checkstate = "0"
	g_szCheck = "0"
	chkLimitAgree.enable = false
'	btnEnroll.enable = false
	Edit0.enable = false
	g_bExit = false
	
	g_szOneTimeNo = ""	'고객인증번호
	g_szCertType = ""	'인증유형코드
	
	g_szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID
	g_szMacAddr = Trim(Form.GetSharedData("&MAC_ADDRESS", false ))	'MAC 주소
	
	g_szOneTimeNo = ""
	g_szCertType = ""
	
	TR_Inquiry("obcsb_oimf_638r")
End Sub


