'============================================================================
' Form_OnMsgBoxClose
'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	'msgbox "sKeyName="&sKeyName&" sRet="&sRet
	if sKeyName == "keypadok" then		
		if sRet == "close" then
			Edit0.caption = ""
		end if
	
	elseif sKeyName == "mbonl86011_p1" then	'완료 팝업
	
		if g_b63010 == true then
			'Form.OpenScreen("63010" , "")
			'Form.triggerEvent("#", "63010_CLOSE", gStplYn ) JWH 주석처리
			Form.triggerEvent("#", "63010_CLOSE", "Y" ) 'JWH
			
			if sRet == "ok" then 'JWH
				btnSearch_OnClick()
			else 'JWH
				Form.triggerEvent("#", "ChangeTab", "1")
			end if
			
		elseif g_b63010_p0 == true then	'v0003
			Form.triggerEvent("#", "TERM_REG_SUCC", "Y" ) 
			
			if sRet == "ok" then 'JWH
				btnSearch_OnClick()
			else 'JWH
				Form.triggerEvent("#", "ChangeTab", "1")
			end if			

		else
			if sRet == "ok" then
				btnSearch_OnClick()
			else
				Form.triggerEvent("#", "ChangeTab", "1")
			end if
		end if
		
	elseif sKeyName == "TR_ERR" then	'TR ERR..
		if sRet == "ok" then
			if g_b63010 == true then
				Form.CloseForm()
			end if
		end if
	end if
End Sub

'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p8" then	'추가인증화면 
		if sRet == "ok" then				'추가인증 성공 -> 보안매체조회 및 인증
			g_szCertType = Form.GetSharedData("MobileCertRadio", true )
			if g_szCertType == "4" or g_szCertType == "1" then
				g_szOneTimeNo = Form.GetSharedData("MobileCertNumber", true )
			else 
				g_szOneTimeNo = ""
			end if	
			
			szScrcOtpClsCode = DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SCRC_OTP_CLS_CODE" , 0)
			if DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SPLM_ATHN_STPL_YN" , 0) == "Y" then	'추가인증약정여부
				if szScrcOtpClsCode == "0" then	'보안카드
					Form.OpenFramePopup( "mhetc90060_p9" , "" , sPosInfo)		'공인인증서_보안카드화면
				elseif szScrcOtpClsCode == "1" then	'부가정보
					Form.OpenFramePopup( "mhetc90060_pa" , "" , sPosInfo)		'공인인증서_부가정보
				elseif szScrcOtpClsCode == "2" then	'보안매체없음
					'Form.MsgBox( "알림", "이용하시는 보안매체가 없거나 이용단말등록 되어있어 온라인 처리가 불가능합니다.", "", 6 )
					RegisterOTP() '2024-02-01 : 인증매체 등록(공통 mhetc90190_p1)
				elseif szScrcOtpClsCode == "3" then	'OTP
					Form.OpenFramePopup( "mhetc90060_pb" , "" , sPosInfo)		'공인인증서_일반/스마트OTP
				elseif szScrcOtpClsCode == "4" then	'mOTP
					Form.OpenPopup( "mhetc90060_motp" , "motp_success" , sPosInfo)		'공인인증서_일반/스마트OTP
				else			'오류
					Form.MsgBox( "알림", "기타오류가 발생했습니다.", "", 6 )
				end if
			else '추가인증하지 않아도 됨
				Call SendReg()
			end if	
		else		'실패
		
		end if		
	end if
	
	if sKeyName == "mhetc90060_p9" then	'보안카드(보안매체1)
		if sRet == "ok" then			'성공
			if g_bDelete then
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")			
			else
				Call SendReg()	'이용단말등록
			end if
		else 					'실패
			exit sub
		end if	
	end if
	
	
	if sKeyName == "mhetc90060_pa" then	'부가정보인증
		if sRet == "ok" then			'성공3
			if g_bDelete then
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
			else
				Call SendReg()	'이용단말등록
			end if			
		else 					'실패
			exit sub
		end if
	end if
	
	
	if sKeyName == "mhetc90060_pb" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
			if g_bDelete then
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
			else
				Call SendReg()	'이용단말등록
			end if
			
		else						'실패		
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_motp" then	'일반/스마트OTP
		if sRet == "ok" then			'성공
			if g_bDelete then
				Form.OpenFramePopup("mhetc90060_p5" , "" , "")
			else
				Call SendReg()	'이용단말등록
			end if
		else						'실패		
			exit sub
		end if	
	end if
	
	if sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			Call SendReg()	'이용단말등록
		else						'실패
			exit sub
		end if	
	end if
	
'	if sKeyName == "mbonl86011_p1" then	'완료 팝업
'		if sRet == "OK" then
'			if g_b63010 == true then
'				Form.OpenScreen("63010" , "")
'			else
'				btnSearch_OnClick()
'			end if
'		else
'			Form.triggerEvent("#", "ChangeTab", "1")
'		end if
'	end if
	
	if sKeyName == "POPUP_TEXT" then	'별명 팝업
		Edit0.caption = sRet
		szLen = Form.GetByteLength(Edit0.caption)		
		if CDbl( szLen ) > 20 then
			Form.MsgBox("알림", "한글10자, 영문/숫자 20자까지 입력가능", "keypadok", 0)
	
		end if
		
		f_BtnEnableYn()
	end if
	
	if sKeyName == "OK" then	'확인 팝업
		Form.OpenFramePopup("mhetc90060_p8" , "mobile_enroll" , "")
	end if
	
	if sKeyName == "mbonl86011_p4" then'5대기기 삭제 후 등록 팝업
		g_bDelete = true
		
		g_tDeleteIdx = Split(sRet, "◆")
		
		Form.OpenFramePopup("mhetc90060_p8" , "mobile_enroll" , "")
		'data 에서 해지 후 등록 처리 필요
	end if
	
