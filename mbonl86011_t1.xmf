'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	
	if szTranID == "obcsb_oimf_636a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_636a" )
		'Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
		
		if len(szSubErr) > 0 then
			Form.MsgBox("알림", szErrMsg.."("..szSubErr..")", "TR_ERR", "8", "확인")
		else
			Form.MsgBox("알림", szErrMsg, "TR_ERR", "8", "확인")
		end if
	else
		szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )
		'Form.ShowAlert( "알림", szErrMsg.."("..szSubErr..")" )
		if len(szSubErr) > 0 then		
			Form.MsgBox("알림", szErrMsg.."("..szSubErr..")", "TR_ERR", "8", "확인")	
		else
			Form.MsgBox("알림", szErrMsg, "TR_ERR", "8", "확인")	
		end if
	end if
	
End Sub

