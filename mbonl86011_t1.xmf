'============================================================================
Sub Edit0_OnEditComplete()
	Dim szLen
	szLen = Form.GetByteLength(Edit0.caption)
	if CDbl( szLen ) > 20 then
		Form.MsgBox("알림", "한글10자, 영문/숫자 20자까지 입력가능", "keypadok", 0)

	end if
End Sub

'============================================================================
Sub lblChoose1_OnClick()
	f_Choose(0)
	
End Sub

'============================================================================
Sub lblChoose2_OnClick()
	f_Choose(1)
	
End Sub

Sub f_BtnEnableYn()
	btnEnroll.enable = 0
	
	if g_szSelect <> "0" and g_szSelect <> "1" then
		exit sub
	end if
	
	if Trim(Edit0.caption) == "" then		
		exit sub
	end if	
	
	btnEnroll.enable = 1
End Sub

Sub f_Choose(Idx)
	if Idx == 0 then
		Image1.imgpath = "input_01_o.9.png"'활성 이미지
		Image2.imgpath = "input_01_n.9.png"'비활성 이미지
		lblChoose1.fgcolor = "67"'활성 컬러
		lblChoose2.fgcolor = "127"'비활성 컬러
		ImageChk1.imgpath = "icon_chk_off"
		ImageChk2.imgpath = "icon_chk_on"
		Image0.imgpath = "img_useconfirm02"
		lblInfo.caption = "전자금융사기 예방을 위하여 미지정 기기에서는\n뱅킹 및 공동(공인)인증서 발급 등 주요거래가 제한됩니다."
		g_szSelect = "0"
		'btnEnroll.enable = 1
		f_BtnEnableYn()
	elseif Idx == 1 then
		Image1.imgpath = "input_01_n.9.png"'비활성 이미지
		Image2.imgpath = "input_01_o.9.png"'활성 이미지
		lblChoose1.fgcolor = "127"'비활성 컬러
		lblChoose2.fgcolor = "67"'활성 컬러
		ImageChk1.imgpath = "icon_chk_on"
		ImageChk2.imgpath = "icon_chk_off"
		Image0.imgpath = "img_useconfirm03"
		lblInfo.caption = "미지정 기기에서는 추가인증 서비스를 이용하여\n뱅킹 및 공동(공인)인증서 발급이 가능합니다."
		g_szSelect = "1"
		'btnEnroll.enable = 1
		f_BtnEnableYn()
	elseif Idx == -1 then'초기상태
		Image1.imgpath = "input_01_n.9.png"'비활성 이미지
		Image2.imgpath = "input_01_n.9.png"'비활성 이미지
		lblChoose1.fgcolor = "127"'비활성 컬러
		lblChoose2.fgcolor = "127"'비활성 컬러
		ImageChk1.imgpath = "icon_chk_on"
		ImageChk2.imgpath = "icon_chk_on"
		Image0.imgpath = "img_useconfirm01"
		lblInfo.caption = "안전한 거래를 위해 뱅킹 및 인증서(재)발급 등\n주요거래를 지정한 기기에서만 이용할 수 있어요."
		g_szSelect = "-1"
		'btnEnroll.enable = 0
		f_BtnEnableYn()
	end if
	
End Sub
