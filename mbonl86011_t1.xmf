'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_638r" then	'전자금융사기예방 고객조회
		'v0005
		if g_onClickFlag then
			g_onClickFlag = False
					
			Dim szPhoneName, szLen
			szPhoneName = Trim(Edit0.caption)
			szLen = Form.GetByteLength(szPhoneName)
			
			if szPhoneName == "" then
				Form.MsgBox("알림", "단말기 별명을 입력하세요.", "", 0)
				exit sub
			end if	
			
			if CDbl( szLen ) > 20 then
				Form.MsgBox("알림", "한글10자, 영문/숫자 20자까지 입력가능", "keypadok", 0)
			end if
			
			
			if g_szSelect <> "0" and g_szSelect <> "1" then
				Form.MsgBox("알림", "이용단말 지정 서비스 방식을 선택하시기 바랍니다.", "", 0)
				exit sub
			end if
			
			'16-03-28 YCJ 시스템개발팀 김인섭 차장님 요청, 2번째 라디오 선택이 체크박스 선택 없이도 다음으로 넘어가야함 (HTS 동일)
		'	if (chkLimitAgree.checkstate == 0 or chkLimitAgree.checkstate == "0") And rdoService.currentindex == "0" then
		'		Form.MsgBox("알림", "이용제한 동의를 확인해주세요", "", 0)
		'		exit sub
		'	end if
			
			Dim nCnt
			nCnt = GridPro1.rowcount
			g_bExit = false
			
			
			for i = 0 to nCnt -1
			    if Trim(GridPro1.GetCellData( "bd_cell0", i )) = "" then
				    exit for
				end if
		    
			    if szPhoneName = Trim(GridPro1.GetCellData( "bd_cell0", i )) then
				    g_bExit = True
			    end if 
			next
			
			if g_bNew then
				if g_nCnt == 5 then'기존 5대 + 신규등록일 경우
					
					Form.OpenPopupAnimation("mbonl86011_p4" , g_szSendData , "","2")
					exit sub
				end if
			end if
			
			Dim szText
			
			if g_szSelect == "0" then
				szText = "지정기기만 이용"
			elseif g_szSelect == "1" then
				szText = "지정기기+미지정기기 둘 다 이용"
			end if
			
			Form.OpenPopupAnimation("mbonl86011_p2" , szText.."★"..Edit0.caption , "","2")
		else
			Dim szDsgtCls
			szDsgtCls = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "TERM_DSGT_STPL_YN" , 0)) '단말지정약정여부
			if szDsgtCls == "1" then	'지정단말 only
	'			edtServiceStatus.caption = "약정 등록"
	'			Table1.SetCellFgColor(0, 1, "238")
	'			Table1.SetCellString(0, 1, "등록")
				Label5.fgcolor = "67"
				Label5.caption = "등록"
	'			rdoService.currentindex = 0
				f_Choose(0)
				chkLimitAgree.enable = true
				Edit0.enable = true
				'btnEnroll.enable = false
			elseif szDsgtCls == "2" then	'지정단말 및 미지정단말 추가인증
	'			edtServiceStatus.caption = "약정 등록"
	'			Table1.SetCellFgColor(0, 1, "238")
	'			Table1.SetCellString(0, 1, "등록")
				Label5.fgcolor = "67"
				Label5.caption = "등록"
	'			rdoService.currentindex = 1
				f_Choose(1)
				chkLimitAgree.enable = false
				Edit0.enable = true
				'btnEnroll.enable = true
			else								'N 이면 미등록/미약정
	'			edtServiceStatus.caption = "약정 미등록"
	'			Table1.SetCellFgColor(0, 1, "146")
	'			Table1.SetCellString(0, 1, "미등록")
				Label5.fgcolor = "146"
				Label5.caption = "미등록"
	'			rdoService.currentindex = -1
				f_Choose(-1)
				chkLimitAgree.enable = true
				Edit0.enable = true
				'btnEnroll.enable = false
			end if
			
			if Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "REG_YN" , 0)) == "Y" then
	'			edtEnrollStatus.caption = "등록단말"
	'			Table1.SetCellFgColor(2, 1, "238")
	'			Table1.SetCellString(2, 1, "등록")
				Label7.fgcolor = "67"
				Label7.caption = "등록"
				btnEnroll.caption = "변경하기"
				g_bNew = false'신규=T 변경=F
			else
	'			edtEnrollStatus.caption = "미등록 단말"
	'			Table1.SetCellFgColor(2, 1, "146")
	'			Table1.SetCellString(2, 1, "미등록")
				Label7.fgcolor = "146"
				Label7.caption = "미등록"
				btnEnroll.caption = "등록하기"
				g_bNew = true'신규=T 변경=F
			end if
			
			'기존 단말별명취득
			for i=0 to DATAMANAGER.GetDataCount(0, "obcsb_oimf_638r", "OutBlock2")-1
	'			Dim szTrMac
				Dim szSTAT_CLS_CODE
	'			szTrMac = Trim(DATAMANAGER.GetDataValue(0,  "obcsb_oimf_638r", "OutBlock2", "MAC_ADDR", i))
				szSTAT_CLS_CODE = DATAMANAGER.GetDataValue(0,  "obcsb_oimf_638r", "OutBlock2", "STAT_CLS_CODE", i)
				
				if szSTAT_CLS_CODE == "1" then
	'			if szTrMac == g_szMacAddr then
	'				if edtEnrollStatus.caption == "등록단말" then
	'				if Table1.GetCellString(2, 1) == "등록" then
						Edit0.caption = Trim(DATAMANAGER.GetDataValue(0,  "obcsb_oimf_638r", "OutBlock2", "TERM_NAME", i))
	'				end if
				end if			
			next	
			
			'기존에 5대가 등록되어있는 경우 + 신규인 경우
			g_nCnt = DATAMANAGER.GetDataCount(0, "obcsb_oimf_638r", "OutBlock2")
			
			if g_bNew then
				if g_nCnt == 5 then
					for i = 0 to 4
						Dim szTERM_NAME,szREG_DATE, szMAC_ADDR,szDISK_SERL_NO
						szTERM_NAME = DATAMANAGER.GetDataValue(0,  "obcsb_oimf_638r", "OutBlock2", "TERM_NAME", i)
						szREG_DATE = DATAMANAGER.GetDataValue(0,  "obcsb_oimf_638r", "OutBlock2", "REG_DATE", i)
						szMAC_ADDR = DATAMANAGER.GetDataValue(0,  "obcsb_oimf_638r", "OutBlock2", "MAC_ADDR", i)
						szDISK_SERL_NO = DATAMANAGER.GetDataValue(0,  "obcsb_oimf_638r", "OutBlock2", "DISK_SERL_NO", i)
						
						if i == 0 then
							g_szSendData = szTERM_NAME.."◆"..szREG_DATE.."◆"..szMAC_ADDR.."◆"..szDISK_SERL_NO
						else
							g_szSendData = g_szSendData.."◆"..szTERM_NAME.."◆"..szREG_DATE.."◆"..szMAC_ADDR.."◆"..szDISK_SERL_NO
						end if
					next
	
				end if
			end if
		end if
		
	end if
	
	if szTranID == "obcsb_oimf_636a" then
	
		if g_b63010 == true then
			'v0004 636a서비스에 185a처리로직 심고 주석처리함.
			'Call TR_Inquiry("obpds_srvc_185a")	'간편이체 약정 등록..
			
			gStplYn = "Y"
			Form.MsgBox("알림", "이용기기 변경이 완료되었습니다.", "mbonl86011_p1", "7", "확인", "지정기기조회")
		else			
			if g_bNew then '신규=T 변경=F
				'Form.OpenPopup("mbonl86011_p1" , "이용기기 지정이 완료되었습니다." , "")
				Form.MsgBox("알림", "이용기기 지정이 완료되었습니다.", "mbonl86011_p1", "7", "확인", "지정기기조회")
			else
				'Form.OpenPopup("mbonl86011_p1" , "이용기기 변경이 완료되었습니다." , "")
				Form.MsgBox("알림", "이용기기 변경이 완료되었습니다.", "mbonl86011_p1", "7", "확인", "지정기기조회")
			end if		
		end if	
	
'		Form.SendReturnToParent( "mbonl86010" , "Yes")
'		btnSearch_OnClick()
	end if
	
	if szTranID == "obcsb_oimf_636a_1" then
		if UBOUND(g_tDeleteIdx) > g_nDeleteTableIdx then'해지해야할 기기가 남았다면
			g_nDeleteTableIdx = g_nDeleteTableIdx + 1
			TR_Inquiry("obcsb_oimf_636a_1" )
		else'모든 기기를 해지했다면
			TR_Inquiry("obcsb_oimf_636a" )
		end if
	end if
	
	if szTranID == "obpds_srvc_185a" then
		'Form.MsgBox("알림", "간편이체 등록이 완료되었습니다.", "mbbnk63010_p1", "8", "확인")
		
		gStplYn = "Y"
		if g_bNew then '신규=T 변경=F
			'Form.OpenPopup("mbonl86011_p1" , "이용기기 지정이 완료되었습니다." , "")
			'Form.MsgBox("알림", "이용기기 지정이 완료되었습니다.", "mbonl86011_p1", "8", "확인") ', "지정기기조회")
			Form.MsgBox("알림", "이용기기 지정이 완료되었습니다.", "mbonl86011_p1", "7", "확인", "지정기기조회")
		else
			'Form.OpenPopup("mbonl86011_p1" , "이용기기 변경이 완료되었습니다." , "")
			'Form.MsgBox("알림", "이용기기 변경이 완료되었습니다.", "mbonl86011_p1", "8", "확인") ', "지정기기조회")
			Form.MsgBox("알림", "이용기기 변경이 완료되었습니다.", "mbonl86011_p1", "7", "확인", "지정기기조회")
		end if		
		
	end if
	
End Sub


