	<SCRIPT_INFO _len="1807" _ulen="1703" >
'============================================================================
' 화 면 명 : 권리화면_처리상태
' 화면설명 : 권리화면의 처리상태선택 팝업창
' 작    성 : 2023.09.12 KKM
'============================================================================

Dim g_szProcStateCd
g_szProcState = "%"

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	szData = Form.GetOpenLinkData()
	if szData <> "" then
		g_szProcState = szData	
		if g_szProcState == "2" then      '2	 예정
			RgProcState.currentindex = 1
		elseif g_szProcState == "1" then  '1 지급
			RgProcState.currentindex = 2
		else
			RgProcState.currentindex = 0
		end if 		
	else
		'디폴트 전체
		RgProcState.currentindex = 0
	end if 
End Sub

'============================================================================
' Form_OnFormClose 
'============================================================================
Sub Form_OnFormClose()
	'Form.SendReturnToParent("PROC_SET", g_szBuySellCd)
End Sub

'============================================================================
Sub RgProcState_OnClick(nIndex)

	if nIndex == 1 then      '2	 예정
		g_szProcState = "2" 
	elseif nIndex == 2 then  '1 지급
		g_szProcState = "1" 	
	else
		g_szProcState = "%" 	
	end if
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()	
End Sub

'============================================================================
Sub btnSave_OnClick()
	'매매유형선택 알림
	Form.SendReturnToParent("PROC_SET", g_szProcState)
	Form.CloseForm()	
End Sub

	</SCRIPT_INFO>
