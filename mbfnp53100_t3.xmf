'============================================================================
'20240628 SWJ START : MY ELS/DLS 청약조회
'============================================================================
Dim g_szSelectAcc, g_szSelectAccSeq
g_szSelectAcc = ""
g_szSelectAccSeq = ""

Dim g_szList, g_szAccList
g_szList = ""
g_szAccList = ""

Dim g_bEntire
g_bEntire = False

Dim g_sEntireAcc, g_sEntireAccSeq, g_sEntireSaveAcno
g_sEntireAcc = Array()
g_sEntireAccSeq = Array()
g_sEntireSaveAcno = Array()

Dim g_sEntireACNO, g_sEntireASNO
g_sEntireACNO = Array()
g_sEntireASNO = Array()

Dim g_nEntireCount
g_nEntireCount = 0
 
 Dim g_nAcnoCount
g_nAcnoCount = 0
 
Dim g_nAcntIndex
g_nAcntIndex = 0

Dim g_sHostDate
g_sHostDate = ""

Dim g_iAccountCount, g_sSaveAccountList
g_iAccountCount = ""
g_sSaveAccountList = ""

Dim g_sAcnoList
g_sAcnoList = ""

Dim g_bNextFlag
g_bNextFlag = True

Dim g_sApltDate, g_sApltSrno, g_sSBSC_APLT_SRNO, g_sSBSC_STCN, g_sISNM
g_sApltDate = ""
g_sApltSrno = ""
g_sSBSC_APLT_SRNO = ""
g_sSBSC_STCN = ""
g_sISNM = ""
g_sData2 = ""
'============================================================================

'============================================================================
Sub Form_OnFormInit()

	'Form.SetTimerEvent2(1, 1, 0.1)
	
	Pannel0.rowcount = 0
	
	g_sHostDate = Form.GetSharedData("&HOST_DATE", false)
	
End Sub
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	Form.SetTimerEvent2(sTimerID,0,0.1)
	
	if Cint(sTimerID) == 1 then
		
		DATAMANAGER.RequestTranData("obsao_rght_102r")
	
	elseif Cint(sTimerID) == 2 then
		
		RequestDataForEntire()
		
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubErr = DATAMANAGER.GetDataMsgSubText( szTranID )

	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.MsgBox("안내", szErrMsg.."("..szSubErr..")" , "", 6)
	else
		Form.MsgBox("안내", szErrMsg , "", 6)
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	g_nEntireCount = 0
	g_nAcntIndex = 0
	
	'화면 처음 열때
	if sEventName == "Init" then

		'0 종합계좌 개수
		'1 종합계좌 리스트
		'2 개별계좌개수
		'3 개별계좌 리스트(ACNo + ASNo)
		'4 개별계좌명 리스트([상품명]계좌번호)
		'5 계좌개수☆개별계좌의 그룹인덱스
		'6 선택한 계좌번호
		'7 선택한 계좌seq
		'8 비밀번호
		
		szLinkData = sParam
		g_szList = split(szLinkData, "|")
		
		g_szSelectAcc = g_szList(6)
		g_szSelectAccSeq = g_szList(7)
		
		'계좌번호전체, 계좌명을 비교하기 위해서 
		g_iAccountCount = CInt(g_szList(2))
		g_szAccountList = split(g_szList(4), "○")
		g_sSaveAccountList = g_szList(3)
		
		'종합계좌 전체개수
		g_nAcnoCount = CInt(g_szList(0))
		g_sAcnoList  = g_szList(1)
		
		ProcessAccount(sEventName)
	
	'계좌콤보 변경시
	elseif sEventName == "AccountChange" then

		'0 선택한 계좌번호		
		'1 선택한 계좌seq
		'2 비밀번호
		
		szList = split(sParam, "|")
		g_szSelectAcc = szList(0)
		g_szSelectAccSeq = szList(1)
		
		ProcessAccount(sEventName)
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "obsao_rght_102r" then
		
		if g_bEntire then
			DATAMANAGER.SetDataValue(0, "obsao_rght_102r", "InBlock1", "ACNO" 			 , 0 , g_sEntireSaveAcno(g_nAcntIndex))
			'DATAMANAGER.SetDataValue(0, "obsao_rght_102r", "InBlock1", "ASNO"		      , 0 , g_sEntireAccSeq(g_nAcntIndex))
			DATAMANAGER.SetDataValue(0, "obsao_rght_102r", "InBlock1", "IQRY_CLS_CODE"     , 0 , "1")	'전체계좌조회 (고객 기준)
		else
			DATAMANAGER.SetDataValue(0, "obsao_rght_102r", "InBlock1", "ACNO" 			 , 0 , g_szSelectAcc)
			DATAMANAGER.SetDataValue(0, "obsao_rght_102r", "InBlock1", "ASNO"		      , 0 , g_szSelectAccSeq)
			DATAMANAGER.SetDataValue(0, "obsao_rght_102r", "InBlock1", "IQRY_CLS_CODE"     , 0 , "2")	
		end if
		
		DATAMANAGER.SetDataValue(0, "obsao_rght_102r", "InBlock1", "STLM_YN"	, 0 , "%")
		DATAMANAGER.SetDataValue(0, "obsao_rght_102r", "InBlock1", "CNCL_YN"	, 0 , "%")
	
	elseif szTranID == "obsao_rght_002a" then
		
		DATAMANAGER.SetDataValue(0, "obsao_rght_002a", "InBlock1", "CONT_CLS_CODE"	, 0 , "4")
		
		DATAMANAGER.SetDataValue(0, "obsao_rght_002a", "InBlock1", "ACNO" 			 , 0 , g_szSelectAcc)
		DATAMANAGER.SetDataValue(0, "obsao_rght_002a", "InBlock1", "ASNO"		      , 0 , g_szSelectAccSeq)
		DATAMANAGER.SetDataValue(0, "obsao_rght_002a", "InBlock1", "PWD"			 , 0 , edtPassword.caption)
		
		DATAMANAGER.SetDataValue(0, "obsao_rght_002a", "InBlock1", "OTC_RPRC_APLT_DATE"		 , 0 , g_sApltDate)
		DATAMANAGER.SetDataValue(0, "obsao_rght_002a", "InBlock1", "OTC_RPRC_APLT_SRNO"		 , 0 , g_sApltSrno)
		
	end if
	
	
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	if szTranID == "obsao_rght_102r" then
			
		nDataCnt = DATAMANAGER.GetDataCount(0, szTranID, "OutBlock1" )
		
		'판넬의 OnScrollEnd를 2번 타는 현상이 있어서
		'플래그 세움
		g_bNextFlag = True
		
		Pannel0.rowcount = g_nEntireCount + Cint(nDataCnt)

		for i = 0 to Cint(nDataCnt) - 1 
			sOTC_RPRC_APLT_DATE = DATAMANAGER.GetDataValue( 0 , "obsao_rght_102r", "OutBlock1", "OTC_RPRC_APLT_DATE" , i)	'환매신청일
			sOTC_RPRC_APLT_SRNO = DATAMANAGER.GetDataValue( 0 , "obsao_rght_102r", "OutBlock1", "OTC_RPRC_APLT_SRNO", i)	'환매신청일련번호
			sAPLT_QTY           = DATAMANAGER.GetDataValue( 0 , "obsao_rght_102r", "OutBlock1", "APLT_QTY" , i)			'환매신청수량
			sLAST_RPRC_PRC      = DATAMANAGER.GetDataValue( 0 , "obsao_rght_102r", "OutBlock1", "LAST_RPRC_PRC" , i)		'환매신청금액 
			sOTC_INTG_EXCL_AMT  = DATAMANAGER.GetDataValue( 0 , "obsao_rght_102r", "OutBlock1", "OTC_INTG_EXCL_AMT" , i)	'최종지급금액/환매신청금액
			
			sPRVS_YN  		  = DATAMANAGER.GetDataValue( 0 , "obsao_rght_102r", "OutBlock1", "PRVS_YN" , i)			'상환여부
			sKOR_ISNM  		  = DATAMANAGER.GetDataValue( 0 , "obsao_rght_102r", "OutBlock1", "KOR_ISNM" , i)			'종목명
			
			sPRVS_DATE  		  = DATAMANAGER.GetDataValue( 0 , "obsao_rght_102r", "OutBlock1", "PRVS_DATE" , i)		'(상환완료)지급일자
			sRPRC_PBMN_PRVS_DATE = DATAMANAGER.GetDataValue( 0 , "obsao_rght_102r", "OutBlock1", "RPRC_PBMN_PRVS_DATE" , i)	'(상환예정)예정지급일자
			
			g_sEntireACNO(i + g_nEntireCount) = DATAMANAGER.GetDataValue( 0 , "obsao_rght_102r", "OutBlock1", "ACNO" , i)	'계좌번호
			g_sEntireASNO(i + g_nEntireCount) = DATAMANAGER.GetDataValue( 0 , "obsao_rght_102r", "OutBlock1", "ASNO" , i)	'계좌일련번호
			
			Pannel0.setPropCardCell("maxlinecnt","LblISNM", i + g_nEntireCount, "1^-3")
			Pannel0.setPropCardCell("maxlinecnt","LblData0", i + g_nEntireCount, "1^-2")
			Pannel0.setPropCardCell("maxlinecnt","LblData1", i + g_nEntireCount, "1^-4")
			Pannel0.setPropCardCell("maxlinecnt","LblData2", i + g_nEntireCount, "1^-2")
			Pannel0.setPropCardCell("maxlinecnt","LblData3", i + g_nEntireCount, "1^-2")
			Pannel0.setPropCardCell("maxlinecnt","LblData4", i + g_nEntireCount, "1^-2")
			Pannel0.setPropCardCell("maxlinecnt","LblData5", i + g_nEntireCount, "1^-2")
			Pannel0.setPropCardCell("maxlinecnt","LblGrade0", i + g_nEntireCount, "1^-2")
			
			'상환여부
			if sPRVS_YN == "" then
				Pannel0.setPropCardCell("visible","ImgGrade0", i + g_nEntireCount, 0)
				Pannel0.setPropCardCell( "visible" ,"Lbl5", i + g_nEntireCount, 0)
				Pannel0.setPropCardCell( "visible" ,"LblGrade0", i + g_nEntireCount, 0)
				Pannel0.SetCellValue("LblGrade0", i + g_nEntireCount, "")
			else
				Pannel0.setPropCardCell("visible","ImgGrade0", i + g_nEntireCount, 1)
				Pannel0.setPropCardCell("imgpath","ImgGrade0", i + g_nEntireCount, "img_bgsquare_grade_316.png")
				Pannel0.setPropCardCell( "visible" ,"LblGrade0", i + g_nEntireCount, 1)
				Pannel0.setPropCardCell( "visible" ,"Lbl5", i + g_nEntireCount, 1)
				
				'상환완료
				if sPRVS_YN == "Y" then
					Pannel0.SetCellValue("Lbl5", i + g_nEntireCount, "지급일")
					Pannel0.setPropCardCell( "singleimage" ,"Button0", i + g_nEntireCount, "btn_15_d.9.png")
					Pannel0.setPropCardCell( "fgcolor" ,"Button0", i + g_nEntireCount, 295)
					Pannel0.SetCellValue("LblGrade0", i + g_nEntireCount, "상환완료")
					Pannel0.setPropCardCell("mask","LblData4",  i + g_nEntireCount, "0,0,,원,1,,0,1,1")
					Pannel0.SetCellValue("LblData4", i + g_nEntireCount, sOTC_INTG_EXCL_AMT)
					Pannel0.SetCellValue("LblData5", i + g_nEntireCount, Right(sPRVS_DATE,6))
					
				'상환예정
				elseif sPRVS_YN == "N" then
					Pannel0.SetCellValue("Lbl5", i + g_nEntireCount, "예정지급일")
					
					Pannel0.SetCellValue("LblGrade0", i + g_nEntireCount, "상환예정")
					Pannel0.setPropCardCell("singleimage","Button0",  i + g_nEntireCount, "btn_15_o.9.png")
					Pannel0.setPropCardCell("fgcolor","Button0",  i + g_nEntireCount, 38)
					Pannel0.setPropCardCell("mask","LblData4",  i + g_nEntireCount, "1,0,,,1,,0,1,1")
					Pannel0.SetCellValue("LblData4", i + g_nEntireCount, "미확정")
					Pannel0.SetCellValue("LblData5", i + g_nEntireCount, Right(sRPRC_PBMN_PRVS_DATE,6))
				end if
			end if
					
			Pannel0.SetCellValue("LblISNM", i + g_nEntireCount, sKOR_ISNM)
			Pannel0.SetCellValue("LblData0", i + g_nEntireCount, Right(sOTC_RPRC_APLT_DATE,6))
			
			if g_bEntire then
				Pannel0.SetCellValue("LblData1", i + g_nEntireCount, FindFullAcntName(g_sEntireACNO(i + g_nEntireCount), g_sEntireASNO(i + g_nEntireCount)))
			else
				Pannel0.SetCellValue("LblData1", i + g_nEntireCount, FindFullAcntName(g_szSelectAcc, g_szSelectAccSeq))
			end if
			
			Pannel0.SetCellValue("LblData2", i + g_nEntireCount, sOTC_INTG_EXCL_AMT)	
			Pannel0.SetCellValue("LblData3", i + g_nEntireCount, sAPLT_QTY)
			
			if g_bEntire then
				Pannel0.SetCellValue("LblAcnt", i + g_nEntireCount,  g_sEntireACNO(i + g_nEntireCount))
				Pannel0.SetCellValue("LblAcntSeq", i + g_nEntireCount, g_sEntireASNO(i + g_nEntireCount))
			end if
				
			Pannel0.SetCellValue("LblApltDate", i + g_nEntireCount,  sOTC_RPRC_APLT_DATE)
			Pannel0.SetCellValue("LblApltSrno", i + g_nEntireCount,  sOTC_RPRC_APLT_SRNO)
					
		next
		
		g_nEntireCount = g_nEntireCount + Cint(nDataCnt)
		
		if g_bEntire then
			
			if DATAMANAGER.IsMoreNextData("obsao_rght_102r") then
			
				'다음 조회 요청
				DATAMANAGER.RequestNextData("obsao_rght_102r")
				
'			else
'				
'				'계좌 리스트 개수 비교 후 다음 계좌에 대한 데이터 재조회
'				if g_nAcntIndex <  CInt(g_iAccountCount) - 1 then
'					g_nAcntIndex = g_nAcntIndex + 1
'	
'					DATAMANAGER.RequestTranData("obsao_rght_102r")
'				end if
'				
			end if
		end if
		
		if Cint(g_nEntireCount) > 0 then
			
			imgNotice.visible = False
			tblNoData.visible = False
			Pannel0.visible = True
			Pannel0.left = 10
		else
			Pannel0.visible = False
			Pannel0.left = 500
			tblNoData.top = 100
			imgNotice.top = 60
					
			imgNotice.visible = True
			tblNoData.visible = True
		end if
	
	elseif szTranID == "obsao_rght_002a" then
		
		sPROS_YN  		  = DATAMANAGER.GetDataValue( 0 , "obsao_rght_002a", "OutBlock1", "PROS_YN" , 0)
		
		if sPROS_YN == "Y" then
			Form.MsgBox("안내", "환매신청 취소가\n완료되었습니다.", "CancelComplete", 6)
		end if
		
	end if
	
End Sub
'============================================================================
Sub Pannel0_OnScrollEnd()
	if DATAMANAGER.IsMoreNextData("obsao_rght_102r") then
		
		g_nEntireCount = Cint( Pannel0.rowcount )	
		
		if g_bNextFlag then
			'다음 조회 요청
			DATAMANAGER.RequestNextData("obsao_rght_102r")
			
			g_bNextFlag = False
		end if
	end if
End Sub

'============================================================================
Sub ProcessAccount(sEventName)
	
	if g_szSelectAcc == "전체" then
		
		'전체 계좌 여부
		g_bEntire = True
		
		if sEventName == "Init" then
			Form.SetTimerEvent2(2, 1, 0.2)
		else
			RequestDataForEntire()
		end if
		
	else
		
		'전체 계좌 여부
		g_bEntire = False
		
		DATAMANAGER.RequestTranData("obsao_rght_102r")
	end if
		
End Sub
'============================================================================
Sub RequestDataForEntire()
	szAccList = Split(g_sSaveAccountList, "○")
	sAcnoList = Split(g_sAcnoList, "○")
	
	for i = 0 to CInt(g_iAccountCount) - 1		
		g_sEntireAcc(i) = Left(szAccList(i), 8)
		g_sEntireAccSeq(i) = Right(szAccList(i), 2)
	next
	
	for j = 0 to Cint(g_nAcnoCount) - 1
		g_sEntireSaveAcno(j) = sAcnoList(j)
	next
	
	DATAMANAGER.RequestTranData("obsao_rght_102r")
	
End Sub
'============================================================================
Function	ProcessType(sType)

	if sType == "1" then
		return "청약신청완료"
	elseif sType == "2" then
		return "청약취소"
	elseif sType == "3" then
		return "청약확정"
	elseif sType == "4" then
		return "발행완료"
	end if
		
	return ""
	
End Function 

'============================================================================
'FULL 계좌명 찾기 함수
Function FindFullAcntName(sAccount, sAccountSeq)

	sComparedData = sAccount & sAccountSeq
	
	sSaveAccountList = Split(g_sSaveAccountList, "○")
	
	for i = 0 to #sSaveAccountList - 1
		if sComparedData == sSaveAccountList(i) then
			 return g_szAccountList(i)
		end if
	next
	
	return ""
End Function
'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	
	'취소하기
	if sCellID == "Button0" then
		
		sFgColor = Pannel0.getPropCardCell( "fgcolor" ,"Button0", nIndex)
		
		if sFgColor == "295" then
			exit sub
		end if
		
		if g_bEntire then
			g_szSelectAcc    = Pannel0.GetCellValue("LblAcnt",nIndex)
			g_szSelectAccSeq = Pannel0.GetCellValue("LblAcntSeq",nIndex)
			
			sSendData = g_szSelectAcc & g_szSelectAccSeq &"☆"&"0"
		else
			sSendData = g_szSelectAcc & g_szSelectAccSeq &"☆"&"0"
		end if 
		
  		g_sApltDate = Pannel0.GetCellValue("LblApltDate", nIndex)
		g_sApltSrno = Pannel0.GetCellValue("LblApltSrno", nIndex)
		
		if sSendData <> "" then
			Form.MsgBox("안내", "환매신청취소는 환매신청한\n수량으로 취소 가능해요.", "ReSaleCancel", 7, "환매신청 취소하기", "닫기")
		end if
	end if
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'==============================================
	'*********** 계좌비번 수신 ************
	'==============================================
	if sKeyName = "CORRECT_PWD" then
		if sRet <> "" then
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				edtPassword.pwdlen = tData(1)
				edtPassword.caption = tData(0)
				
				DATAMANAGER.RequestTranData( "obsao_rght_002a" )
			end if
		end if
		
	end	if
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "ReSaleCancel" then
		if sRet == "ok" then
			'비밀번호 팝업 띄움
			Form.openPopupAnimation("pwdcheckpopup",sSendData,"","2")
		end if
	
	elseif sKeyName == "CancelComplete" then
		
		g_nEntireCount = 0
		
		if g_bEntire then
			 RequestDataForEntire()
		else
			ProcessAccount("AccountChange")
		end if
		
	end if
End Sub

