	<SCRIPT_INFO _len="2952" _ulen="2720" >
'============================================================================
' 2021.01.25 SWJ START : 모바일OTP 온라인결제 인증 확인 화면
'============================================================================
' 2021.05.27 : 정민영 : v001 : T2105070009 : 개인신용정보동의제도 개편안 반영
'            : obcsb_efif_060a IO변경분 적용
'============================================================================

Dim szData, szMOTPData, g_Sec
g_Sec = 60
'============================================================================
Sub Form_OnFormInit()
	Container0.EditSerial.SetApplyLabel("일련번호" 				,0 , 267 , "left" , true)
	Container0.EditAuthNum.SetApplyLabel("인증번호" 				,0 , 267 , "left" , true)
	
	szMOTPData = Form.GetOpenLinkData()
	szData = Split(szMOTPData, "★")
	
		if Ubound(szData) < 1 then
			exit sub
		else	
			Container0.EditSerial.caption = szData(0)
			Container0.EditAuthNum.caption = szData(1)
			Form.SetTimerEvent(1, 1, 1) '1분 타이머 이벤트 시작
			
			Container0.EditSerial.enable = false
			Container0.EditAuthNum.enable = false
		end if
	
End Sub
'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == 1 or sTimerID == "1" then
			
		if g_Sec = 0 then
			Form.SetTimerEvent(1, 0, 1)
			
			Call InitCountTimer()         '1분 타이머 초기화					
			
			Form.MsgBox("안내", "인증시간이 만료되었습니다. \n다시 시도하여 주시기 바랍니다.", "TIME_END",0)
			
			Container0.EditSerial.enable = false
			Container0.EditAuthNum.enable = false
			Container0.EditAuthNum.caption = ""
			Container0.EditSerial.caption = ""
			
			Container0.ButtonOK.enable = false	
			
		else
			Dim nMin, nSec
			
			nMin  = int(g_Sec / 60 )
			nSec  =  g_Sec mod  60
			
			if len(nSec) == 1 then 
				nSec = "0"..nSec
				nSec = nSec
			end if 	
			
			Container0.Label1.caption = "(남은 시간: "..nMin.." 분  "..nSec.." 초)"
			
			g_Sec = g_Sec-1		
		
		end if
	end if
End Sub
'============================================================================
'1분 타이머 초기화 함수
'============================================================================
Sub InitCountTimer()
	Container0.Label1.caption	= "(남은 시간: 1 분  00 초)"
	Container0.Label1.visible  = false
	g_Sec = 60
	Form.SetTimerEvent(1, 0, 1)	'1분타이머 종료
End Sub
'============================================================================
Sub Container0_Image5_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Container0_Buttonok_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "TIME_END" then
		Form.CloseForm()
	end if
End Sub

	</SCRIPT_INFO>
