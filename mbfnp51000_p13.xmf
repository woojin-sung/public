	<SCRIPT_INFO _len="3130" _ulen="2992" >
'============================================================================
' 전문/일반 금융소비자 확인
'============================================================================

Dim	g_szRet	'리턴값

Dim	g_KYC_SPCL_INVR_YN	'전문투자자여부
Dim	g_szAccNo
Dim	g_szShortCd
Dim	g_szStndCd
Dim	g_szRmndNo
Dim	g_szGb

'============================================================================
Sub Form_OnFormInitBefore()
	ImgBackPress.setMaintainingRatio("1")
End Sub

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()

	If szOpenData <> "" And szOpenData <> null Then
		tData = Split(szOpenData, "★")

		g_KYC_SPCL_INVR_YN 			= tData[0]
		
		g_szAccNo		= tData[1]	'계좌번호
		g_szShortCd 		= tData[2]
		g_szStndCd 		= tData[3]
		g_szRmndNo		= tData[4]	'잔고일련번호
		g_szGb			= tData[5]	'매수구분(NEW/ADD)
		
'g_KYC_SPCL_INVR_YN = "Y"
'ShowAlert("", g_KYC_SPCL_INVR_YN)
		if g_KYC_SPCL_INVR_YN == "Y" then
			Container0.Table1.height = 100
			Container0.Label1.caption = "고객님은 전문금융소비자 입니다."
			Container0.Label1.changeTextAttr(5, 7, 6, 0, true)
			Container0.Label7.visible = 1			
			Container0.Label6.visible = 1		
			Container0.Label6.top = 165

			Container0.Table0.top = 200
			Container0.Label2.top = 220
			Container0.Label3.top = 280
			Container0.Label4.top = 355
			
		else
			Container0.Table1.height = 50
			Container0.Label1.caption = "고객님은 일반금융소비자 입니다."
			Container0.Label1.changeTextAttr(5, 7, 6, 0, true)			
			Container0.Label7.visible = 0			
			Container0.Label6.visible = 0

			Container0.Table0.top = 100
			Container0.Label2.top = 120
			Container0.Label3.top = 180
			Container0.Label4.top = 255

		end if
	end if
	
End Sub

'============================================================================
Sub ImgBackPress_OnClick()
	g_szRet = "GO_BACK"
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	g_szRet = "close"
	Form.CloseForm()
End Sub

'============================================================================
Sub btnOK_OnClick()
	Dim szSendData
	szSendData = g_KYC_SPCL_INVR_YN & "★" & g_szAccNo & "★" & g_szShortCd & "★" & g_szStndCd & "★" & g_szRmndNo & "★" & g_szGb
	Form.OpenPopup("mbfnp51000_p8", szSendData, "")
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("mbfnp51000_p13" ,  g_szRet)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "mbfnp51000_p8"  Then 	
		if sRet <> "" and int(sRet) <> 0 and sRet <> null then
			if sRet <> "GO_BACK" then
				Form.CloseForm()
			end if
		end if
	end if
End Sub

'============================================================================
Sub Container0_lblMore_OnClick()
	Form.openPopupAnimation("mbonl81010_p21", "" ,"","2")
End Sub

	</SCRIPT_INFO>
</ROOT>