Sub Form_OnTimerEvent(sTimerID)
'Form.showalert( Form.GetSharedData("&POPUP_SCREEN_NO", false), "TimerEvent (" & sTimerID )
	If sTimerID == 0 Or sTimerID == "0" Then
		Form.requestMOTP("MOTP_GETINFO" , "" , "86105")
		Form.SetTimerEvent2(0, 0, 0.2)
	End If
End Sub

