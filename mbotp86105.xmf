'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam) 
scr_no = Form.GetSharedData("&POPUP_SCREEN_NO", false)
'Form.ShowAlert( scr_no, sEventName & "=" & sParam )
	Dim tmpList
	tmpList = Split(sParam, "★")
	If sEventName == "MOTP_GET_VERSION_RETURN_86105" Then ' M SafeBox 버전 정보 가져오기
		If tmpList[0] == "00000" Then
			g_MsboVrsn = tmpList[2]
		Else
			Form.ShowAlert("알림", "MSB 버전 추출 오류\n"..tmpList[1])
		End If
	End If

	If sEventName == "MOTP_ISSU_RETURN_86105" Then 'M SafeBox에 MOTP정보 심기
		If tmpList[0] == "00000" Then
			rslt_data = "86102" & "☆" & g_TitleNm & "☆" & "Y" & "완료"
		Else
			rslt_data = "86102" & "☆" & g_TitleNm & "☆" & "N" & "완료"
		End If
		Form.OpenPopup( "mbotp86105_rslt.xmf", rslt_data, "" )
	End If
	
	If sEventName == "MOTP_GETINFO_RETURN_86105" Then
		If tmpList[0] == "00000" Then
			g_MotpSrno = tmpList[2]
		End If
	End If
	
	If sEventName == "MOTP_DISCARD_RETURN_86105" Then
		If tmpList[0] == "00000" Then
			Form.ShowAlert("폐기", "모바일OTP폐기완료\n" & g_MotpSrno)
		End If
	End If
	
'	If sEventName == "MOTP_DISCARD_RET" Then
'		MSGBOX sEventName & "\n" & sParam
'	End If
End Sub

