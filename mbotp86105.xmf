Sub Cont0_Button2_OnClick()
	'로그인 여부 체크
	Dim sLOGIN_TYPE  
	sLOGIN_TYPE = Form.GetSharedData("&LOGIN_TYPE", false )		
	if CInt(sLOGIN_TYPE) > 1 then '로그인상태
		If g_MotpSrno == Null Or Len(g_MotpSrno) == 0 Then
			Form.ShowAlert("알림", "스마트폰에 발급된 OTP정보가 없습니다.")
			Exit Sub
		End If
		g_btnNo = 2
		Form.OpenNextPopup( "mbotp86125.xmf" , "" , "" )
	'	Form.CloseForm( )
	else	
		g_Open = "mbotp86125"
		Form.OpenPopup("mhetc90021","","")		
	end if
End Sub

