Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Form.ShowAlert("안내", szErrMsg & "(" & DATAMANAGER.GetDataMsgSubText(szTranID) & ")" )
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	'20240311 KKM 로그인시 모바일OTP비밀번호변경, 재설정, 모바일OTP폐기
	if sKeyName == "Login_Type" then
		if Cint(sRet) > 1 then
			if g_Open == "mbotp86125" then
				If g_MotpSrno == Null Or Len(g_MotpSrno) == 0 Then
					Form.ShowAlert("알림", "스마트폰에 발급된 OTP정보가 없습니다.")
					Exit Sub
				End If
				g_btnNo = 2
				Form.OpenNextPopup( "mbotp86125.xmf" , "" , "" )			
				
			elseif g_Open == "mbbdm86130" then
				If g_MotpSrno == Null Or Len(g_MotpSrno) == 0 Then
					Form.ShowAlert("알림", "스마트폰에 발급된 OTP정보가 없습니다.")
					Exit Sub
				End If
				g_btnNo = 3
				Form.SetSharedData("BDM_NMETBSWRGB", "301")
				Form.OpenNextPopup("mbbdm86130.xmf", "", "")
		
			elseif g_Open == "mbotp86127" then
				If g_MotpSrno == Null Or Len(g_MotpSrno) == 0 Then
					Form.ShowAlert("알림", "스마트폰에 발급된 OTP정보가 없습니다.")
					Exit Sub
				End If
			'	g_btnNo = 4
				Form.OpenNextPopup("mbotp86127.xmf" , "" , "" )				
				
			end if	
		end if 
	else 
'Form.ShowAlert("mbotp86105", "Form_OnPopupReturn")
		Form.SetTimerEvent2( 0, 1, 0.2) ' 모바일OTP 정보 추출.
	end if
End Sub

