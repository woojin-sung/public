'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
'Form.ShowAlert("TranBefo", szTranID)
	If	szTranID == "obcsb_oimf_172r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO_PIP", 0, g_RcnoPIP )
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
Form.showalert( Form.GetSharedData("&POPUP_SCREEN_NO", false), "TranComp (" & szTranID )

	If	szTranID == "obcsb_oimf_172r" Then
		
		AblePrhbYn		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "ABLE_PRHB_YN"		, 0 )
		PrhbReas		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "UI_PRHB_REAS"		, 0 )
		g_Csno		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock3", "CSNO"			, 0 )
		
		g_MOtpSrnoSvr	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "MOTP_SRNO"		, 0 )
		g_CustTermIDSrvr= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CUST_TERM_ID"		, 0 )
		g_OtpSrno		= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTP_CARD_SRNO"	, 0 )
		g_OtpStatCode	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTP_STAT_CODE"	, 0 )
		g_OtpSuplCoCode	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTP_SUPL_CO_CODE"	, 0 )
		g_IsncIstuCode	= DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2", "OTP_ISNC_ISTU_CODE"	, 0 )
		'모바일OTP사용 가능여부 체크
		If AblePrhbYn <> "Y" Then
			If AblePrhbYn == "1" Then
				Form.ShowAlert("안내", "모바일 OTP 발급이 불가합니다.\n개인정보노출 등록 고객")
			ElseIf AblePrhbYn  == "2" Then
				Form.ShowAlert("안내", "모바일 OTP 발급이 불가합니다.\n미성년자 발급 불가")
			ElseIf AblePrhbYn  == "3" Then
				Form.ShowAlert("안내", "외국인은 모바일 OTP 발급이 불가능 합니다.")
			ElseIf AblePrhbYn  == "4" Then
				Form.ShowAlert("안내", "법인은 모바일 OTP 발급이 불가능 합니다.")
			End If
			Form.CloseForm()
		End If

		'발급 or 다운로드 결정
		If Len(Trim(g_MOtpSrno)) == 0 Then ' 단말에 OTP가 없는 경우
			If Len(Trim(g_MOtpSrnoSvr)) == 0 Then '서버에 등록되지 않은경우
				g_ScrNo = "R" ' 일반등록
			ElseIf g_CustTermID == g_CustTermIDSrvr Then '기기ID가 같은 경우
				g_ScrNo = "D" ' 다운로드
			Else '기기가 변경된 경우
				g_ScrNo = "M" ' 재등록
			End If
		Else '단말에 OTP가 등록되어 있는경우
			If Len(Trim(g_MOtpSrnoSvr)) == 0 Then
				
			ElseIf g_MOtpSrnoSvr ==Trim(g_MOtpSrno) Then  '일련번호가 같은경우
				g_ScrNo = "N"
			Else
				g_ScrNo = "M" '재등록
			End If
		End If
		
		'실물OTP 폐기여부
		If Len(Trim(g_OtpSrno)) > 0 And g_OtpStatCode == "01" Then
			g_DscdYN = "Y"
		Else
			g_DscdYN = "N"
		End If
		
'		Form.SetTimerEvent( 0, 0, 0.3)
'		If 	g_ScrNo == "D" Then '다운로드
'			Form.MsgBox( "안내", "이미 같은 기기에서 모바일 OTP를 발급받은 이력이 있습니다.\n새로운OTP를 발급하시겠습니까?", "dnld", 1 )
'		ElseIf 	g_ScrNo == "N" Then '정상인데 재발급
'			Form.MsgBox( "안내", "현재 기기에서 발급하신 모바일 OTP가 있습니다.\n기존 모바일 OTP는 폐기하고 새로운 OTP를 발급하시겠습니까?", "isnc", 1 )
'		ElseIf 	g_ScrNo == "M" Then '기기변경으로 재발급
'			Form.MsgBox( "안내", "기존에 등록된 기기와 발급 정보가 다릅니다.\n새로운 OTP를 발급하시겠습니까?", "mod_isnc", 1 )
'		End If

	End If
End Sub

