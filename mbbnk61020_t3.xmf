	<SCRIPT_INFO _len="4040" _ulen="3818" >
'============================================================================
'============================================================================

Dim g_szAccountNumber	'계좌번호
Dim g_szAccountSerialNumber	'계좌일련번호
Dim g_szAccountPassword	'계좌비밀번호
Dim g_szAccountName	'계좌명
Dim g_szBankName	'은행명
Dim g_nGridCnt

'============================================================================
Sub Form_OnFormInit()			
	g_nGridCnt = 0
	DATAMANAGER.RequestTranData("obtsp_cqry_901r")
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

    if sEventName == "AllAccount" Or sEventName == "Password" Then
        Dim szList
        szList = Split(sParam, "★")	
		
        if UBOUND(szList) < 1 then
            exit sub
        end if

        g_szAccountNumber = szList(0)
        g_szAccountSerialNumber = szList(1)
        if szList(2) <> "" then
            g_szAccountPassword = szList(2)
        else
            g_szAccountPassword = ""
        end if
		
        if szList(3) <> "" then
            g_szAccountName = szList(3)
        else
            g_szAccountName = ""
        end if
		
        g_nGridCnt = 0
        DATAMANAGER.RequestTranData("obtsp_cqry_901r")
    end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

	If szTranID == "obtsp_cqry_901r" Then
	
		nCnt = DATAMANAGER.GetDataCount( 0, "obtsp_cqry_901r", "OutBlock1" )
		For i = 0 To nCnt-1
			sBankCode = DATAMANAGER.GetDataValue( 0, "obtsp_cqry_901r", "OutBlock1", "CNFT_BANK_CODE" , i )'은행코드
			sBankAcc = DATAMANAGER.GetDataValue( 0, "obtsp_cqry_901r", "OutBlock1", "CNFT_BANK_ACNO" , i )'상대계좌번호
			sClsCode = DATAMANAGER.GetDataValue( 0, "obtsp_cqry_901r", "OutBlock1", "LNKD_DPDR_SHAP_CLS_CODE" , i )'연계입출금형태구분코드
			sName= DATAMANAGER.GetDataValue( 0, "obtsp_cqry_901r", "OutBlock1", "RMT_NAME" , i )'수취인명
			
			Grid0.SetCellData( "bd_cell0", i + g_nGridCnt , "거래일자" )
			Grid0.SetCellData( "bd_cell1", i + g_nGridCnt, "입금계좌" )
			Grid0.SetCellData( "bd_cell2", i + g_nGridCnt, "거래구분" )
			Grid0.SetCellData( "bd_cell3", i + g_nGridCnt, "이체금액" )
			Grid0.SetCellData( "bd_cell4", i + g_nGridCnt, "처리결과" )

			sBankName = Form.GetMetaData("은행코드", sBankCode )
			Grid0.SetCellData( "bd_cell6", i + g_nGridCnt, sBankName & " " & sBankAcc & " " & sName)
			
			sValue = Form.GetMetaData("연계입출금형태구분코드", sClsCode )
			Grid0.SetCellData( "bd_cell7", i + g_nGridCnt, sValue)
			
			if sClsCode == "04" then
				Grid0.SetCellData( "bd_cell7", i + g_nGridCnt, "은행이체출금")
			elseif sClsCode == "17" then
				Grid0.SetCellData( "bd_cell7", i + g_nGridCnt, "은행이체입금")
			end if
		next
		
		g_nGridCnt =  g_nGridCnt + nCnt
		
		Label0.caption = "총 " & g_nGridCnt & " 건"
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    
    If Trim(szSubMsg) == "" Then
        Form.ShowAlert( "알림", szErrMsg )
    Else
        Form.ShowAlert( "알림", szErrMsg .. "\n(" .. szSubMsg ..")")
    End If
End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	DATAMANAGER.RequestNextData("obtsp_cqry_901r")
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.SetDataValue(0, "obtsp_cqry_901r", "InBlock1", "ACNO", 0 , g_szAccountNumber)	'계좌번호
	DATAMANAGER.SetDataValue(0, "obtsp_cqry_901r", "InBlock1", "ASNO", 0 , g_szAccountSerialNumber)	'계좌일련번호
	DATAMANAGER.SetDataValue(0, "obtsp_cqry_901r", "InBlock1", "LNKD_DPDR_SHAP_CLS_CODE", 0 , "00")	
End Sub

