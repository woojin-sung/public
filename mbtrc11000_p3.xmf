	<SCRIPT_INFO _len="3876" _ulen="3474" >

Dim g_tData
Dim g_szCode
Dim g_szData

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	If szOpenData <> "" And szOpenData <> null Then
'		Form.ShowAlert("11", szOpenData)
		'0 종목명
		'1 평가금액
		'2 매입금액
		'3 평가손익
		'4 수익률
		'5 잔고구분
		'6 증거금율
		'7 체결잔고
		'8 매입단가
		'9 종목코드
		g_tData = Split(szOpenData, "☆")
		
		lblName.caption = g_tData[5] & " " & g_tData[0]
		
		Dim szTypeCode
		
		'타이틀텍스트 스타일 및 하단 버튼 변경
		If Trim(g_tData[5]) == "매수" Then
			lblName.changeTextAttr(0, 2, 6, 4, false)
			
			szTypeCode = "2"
			
			btnTrade.caption = "추가매수"
			btnTrade.btnimage = "btn_etc10.9.png"
			
		ElseIf Trim(g_tData[5]) == "매도" Then
			lblName.changeTextAttr(0, 2, 7, 4, false)
			
			szTypeCode = "1"
			
			btnTrade.caption = "추가매도"
			btnTrade.btnimage = "btn_etc11.9.png"
		End If
		
		tbl0.SetCellString(0, 2, g_tData[1])
		
		tbl1.SetCellString(0, 1, g_tData[2])
		tbl1.SetCellString(1, 1, g_tData[3])
		If Left(g_tData[3], 1) == "+" Then
			tbl1.SetCellFgColor(1, 1, "1")
		ElseIf Left(g_tData[3], 1) == "-" Then
			tbl1.SetCellFgColor(1, 1, "2")
		End If
		tbl1.SetCellString(2, 1, g_tData[4])
		If Left(g_tData[4], 1) == "+" Then
			tbl1.SetCellFgColor(1, 1, "1")
		ElseIf Left(g_tData[4], 1) == "-" Then
			tbl1.SetCellFgColor(1, 1, "2")
		End If
		
		tbl2.SetCellString(0, 1, g_tData[5])
		tbl2.SetCellString(1, 1, g_tData[6])
		tbl2.SetCellString(2, 1, g_tData[7])
		tbl2.SetCellString(3, 1, g_tData[8])
		
		g_szCode = g_tData[9]
		
		' 20160310 주문불가한 종목 예외처리
		' 20170502 상장수익증권 예외처리 'F'
		' case: 신주인수권/증권 (9자리)
		Dim errmsg
		errmsg = "종목마스터의 오류로 주문 및 시세 조회가 불가능합니다. 동일 증상 반복 시 확인 버튼을 눌러 주시기 바랍니다.\n\n ※기타문의사항은 고객지원센터 (1588-3400)로 문의하여 주시기 바랍니다."
		
		Dim szMk, szCutCd
		if (left(g_szCode,1) ="J" and len(g_szCode) == 9) or left(g_szCode,1) ="Q" or left(g_szCode,1) = "F" Then
			szMk = Form.GetItemCodeInfo(g_szCode, "market")
		' else: 기타
		else
			' 20160310 주문불가한 종목 예외처리
			szCutCd = Mid(g_szCode, 2, Len(g_szCode))
			szMk = Form.GetItemCodeInfo(szCutCd, "market")
		end if 
		
		If Trim(szMk) = "J" or Trim(szMk) = "Q" or Trim(szMk) = "W" or Trim(szMk) = "T" then
			g_szData = g_szCode & "★" & g_tData[7] & "♥" & szTypeCode & "♥" & "" & "♥" & "" & "♥" & ""
		Else
			Form.MsgBox("알림", errmsg, "REUPDATE", 1)		
		End if
		
'		Form.ShowAlert("g_szData", g_szData)
	End If
End Sub

'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "REUPDATE" then
		if sRet == "ok" then
			Form.reUpdateFile("mts_master.crc")
		else
			exit sub
		end if
	end if
End Sub

'============================================================================
Sub btnPrice_OnClick()
	Form.OpenScreen("13100" , g_szCode & "★" & "0")
End Sub

'============================================================================
Sub btnTrade_OnClick()
	Dim szTab
	If g_tData[5] == "매수" Then
		szTab = "0"
	ElseIf g_tData[5] == "매도" Then
		szTab = "1"
	End If
	Form.OpenScreen("13200" , "기타" & "★" & szTab & "★" & g_szCode & "★" & g_tData[0] )
End Sub

'============================================================================
Sub btnSell_OnClick()
	Form.OpenScreen("13200" , "잔고" & "★" & "2" & "★" & g_szData )
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

	</SCRIPT_INFO>
</ROOT>