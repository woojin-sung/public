<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="50700" scrname="REITs 투자가이드-리츠란-추천대상고객" version="2" writer="노일호" />
	<FORM_INFO name="Form" ly_vert="0,0,375,328,1" />
	<CONTROL_INFO>
		<LABEL name="lblTitle" fontsize="2" fontstyle="01" caption="추천 대상 고객" ly_vert="20,32,335,36,1" />
		<LABEL name="lblBg" caption=" " bgcolor="243:204204204" transmode="0" valign="0" ly_vert="20,122,335,176,1" />
		<LABEL name="lblDesc" fontsize="-2" valign="0" multiline="1" ly_vert="20,68,335,52,1" />
		<IMAGE name="imgCbx1" autosize="1" ly_vert="40,144,12,12,1" />
		<IMAGE name="imgCbx2" autosize="1" ly_vert="40,178,12,12,1" />
		<IMAGE name="imgCbx3" autosize="1" ly_vert="40,212,12,12,1" />
		<IMAGE name="imgCbx4" autosize="1" ly_vert="40,246,12,12,1" />
		<LABEL name="lblSubDesc1" fontsize="-2" valign="0" ly_vert="48,141,277,34,1" />
		<LABEL name="lblSubDesc2" fontsize="-2" valign="0" ly_vert="48,175,277,34,1" />
		<LABEL name="lblSubDesc3" fontsize="-2" valign="0" ly_vert="48,209,290,34,1" />
		<LABEL name="lblSubDesc4" fontsize="-2" valign="0" multiline="1" ly_vert="48,243,285,55,1" />
		<LABEL name="lblTopDivider" caption=" " bgcolor="263:216216216" transmode="0" ly_vert="0,0,375,10,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="2389" _ulen="2057" >
'***************************************************
'               전역 변수
'***************************************************
Dim g_szTitle

'***************************************************
'               공용 함수
'***************************************************
'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()
	call Init_Control("1")    ' Personal Function 호출시 call 붙여준다.
End Sub

'***************************************************
'               개별 함수
'***************************************************
'===============================================
' Init_Control(szCbn) 
'===============================================
Function Init_Control(szCbn) --> 리턴과 상관없이 Function으로 정의한다.
	'텍스트 설정
	lblDesc.caption = "리츠는 아래와 같은 투자를 원하시는 고객에게\n어울리는 상품이에요."
	
	lblSubDesc1.caption = "소액으로 부동산 투자를 원하는 고객"
	lblSubDesc2.caption = "안정적인 배당소득을 원하는 고객"
	lblSubDesc3.caption = "적립식이 아닌 거치식으로 투자를 희망하는 고객"
	lblSubDesc4.caption = "배당소득에 대하여 분리과세 혜택으로 절세효과\n를 원하는 고객"
	
	'topbar #F6F7F8 (RGB 246,247,248)로 색칠하기
	lblTopDivider.bgcolor = 320
	
	'여백 지우기
	lblTitle.paddinginfo = "0,0,0,0"
	lblDesc.paddinginfo = "0,0,0,0"
	
	'색칠
	lblTitle.setHighlight(332)
	lblDesc.fgcolor = "333"
	lblBg.bgcolor = "320"
	
	' 115/118/124: 333
	lblSubDesc1.fgcolor = "333"
	lblSubDesc2.fgcolor = "333"
	lblSubDesc3.fgcolor = "333"
	lblSubDesc4.fgcolor = "333"
	
	' 일부만 fontbold=true, fgcolor=black 적용
'	lblSubDesc1.fontbold = true;
	lblSubDesc1.changeTextAttr(0, 11, 334, -2, true)
	lblSubDesc2.changeTextAttr(0, 9, 334, -2, true)
	lblSubDesc3.changeTextAttr(8, 8, 334, -2, true)
	lblSubDesc4.changeTextAttr(10, 7, 334, -2, true)
	
	'체크이미지 모두 적용
	imgCbx1.setMaintainingRatio("1")
	imgCbx1.imgpath = "icon_check.png"
	imgCbx2.setMaintainingRatio("1")
	imgCbx2.imgpath = "icon_check.png"
	imgCbx3.setMaintainingRatio("1")
	imgCbx3.imgpath = "icon_check.png"
	imgCbx4.setMaintainingRatio("1")
	imgCbx4.imgpath = "icon_check.png"
End Function

	</SCRIPT_INFO>
</ROOT>