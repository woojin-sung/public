	<SCRIPT_INFO _len="3719" _ulen="3545" >
'============================================================================
' 01. 화 면 명 : 발행어음매매_잔고
' 02. 화면설명 : 발행어음매매_잔고
' 03. 작    성 : 2016. 03. 02. 유창재
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szData			'계좌번호 및 비밀번호
Dim g_szList
Dim g_szPW			'비밀번호
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "mbfnp52000" then
	
		If sParam = "" Or sParam = null Then
			Exit Sub
		End If
		
		g_szData = sParam
	end if
	
	g_szList = Split( g_szData, "★")
	if UBOUND(g_szList) < 1 then
		Exit Sub
	end if
	
	g_szPW = Form.GetEncData( g_szList(2) )			'비밀번호 암호화
	
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_222r", "InBlock1", "ACNO" , 0 , g_szList(0) )	'계좌번호
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_222r", "InBlock1", "ASNO" , 0 , g_szList(1) )	'계좌일련번호
	DATAMANAGER.SetDataValue( 0 , "obsan_deal_222r", "InBlock1", "PWD" , 0 , g_szPW )	'비밀번호
	
	DATAMANAGER.RequestTranData( "obsan_deal_222r" )
	
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim Fee				'제세금
	Dim nSubsMaesu		'매수금액합
	Dim nSubsFeeBefore	'세전이자합
	Dim nSubsFee			'제세금합
	Dim nSubsMoney		'출금가능금액합
	
	Fee = 0
	nSubsMaesu = 0
	nSubsFeeBefore = 0
	nSubsFee	= 0
	nSubsMoney = 0
	
	if szTranID == "obsan_deal_222r" then
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obsan_deal_222r", "OutBlock1") - 1

'			Fee = DATAMANAGER.GetDataValue( 0 , "obsan_deal_222r", "OutBlock1", "INT_AMT" , i)
'			
'			if Int(Fee) == 0 then
'				grd0.SetCellData( "bd_cell10" , i , Fee)
'			else
				Fee = DATAMANAGER.GetDataValue( 0 , "obsan_deal_222r", "OutBlock1", "INTX" , i) + 
				DATAMANAGER.GetDataValue( 0 , "obsan_deal_222r", "OutBlock1", "RSTX" , i) + 
				DATAMANAGER.GetDataValue( 0 , "obsan_deal_222r", "OutBlock1", "SRTX" , i)
'			end if
			grd0.SetCellData( "bd_cell10" , i , Fee)
			
			nSubsMaesu = nSubsMaesu + grd0.GetCellData( "bd_cell1", i)
			nSubsFeeBefore = nSubsFeeBefore + grd0.GetCellData( "bd_cell3", i)
			nSubsFee = nSubsFee + grd0.GetCellData( "bd_cell10", i)
			nSubsMoney = nSubsMoney + grd0.GetCellData( "bd_cell4", i)
		next
'		Form.ShowAlert("nSubsMaesu", nSubsMaesu)
		grd0.SetCellFootCaption( "fh_cell8" , nSubsMaesu)
		grd0.SetCellFootCaption( "fh_cell9" , nSubsFeeBefore)
		grd0.SetCellFootCaption( "fh_cell10" , nSubsFee)
		grd0.SetCellFootCaption( "fh_cell11" , nSubsMoney)
	end if
	
End Sub


