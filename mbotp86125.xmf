'--===========================================================================
'--===========================================================================

Dim g_MsboVrsn
Dim g_MOTPSrno
Dim aFlag '아코디언 플래그

'연락처
Dim	g_HomeNo '자택전화
Dim	g_ClphNo '휴대전화
Dim	g_WorkNo '직장전화

Dim	g_OSClcd
'============================================================================
Sub Form_OnFormInit()

	Container1.Container2.bgcolor = 271
	Container1.Container3.bgcolor = 272
	
	aFlag = 0
	
	g_IntoClcd	= Form.GetSharedData( "mOTP_IntoClcd", False )
	g_OSClcd	= Form.GetSharedData("&OS_TYPE", false)
	
	Container1.CmbAcnt.SetApplyLabel("종합계좌번호" , 0 , 268 , "left" , True)
	Container1.EdtPwd.SetApplyLabel("종합계좌비밀번호" , 0 , 268 , "left" , True)
	Container1.EdtBfPwd.SetApplyLabel("모바일 OTP 비밀번호", 0, 268, "left", True)
	Container1.EdtAfPwd.SetApplyLabel("모바일 OTP 비밀번호", 0, 268, "left", True)
	Container1.EdtAfPwdCnfr.SetApplyLabel("모바일 OTP 비밀번호 확인", 0, 268, "left", True)
	
	szTheme = Form.GetEnvData("common.theme")
	BtnNext.fgcolor = "269"
	BtnNext.enable = False
	If szTheme == "white" Then
	    BtnNext.btnimage			= "btn_21.9"
	Else
	    BtnNext.btnimage			= "btn_27.9"
	End If
	
	
	'Container1.EdtPwd.SetUseResultLabel(True , 1) help msg 사용하지 않기로 함
	
	fn_CntInit() '컨트롤 초기화

    DATAMANAGER.SetDataValue(0 , "obaci_acct_185r", "InBlock1" , "RCNO"      , 0 , "NMET")
	DATAMANAGER.SetDataValue(0 , "obaci_acct_185r", "InBlock1" , "RCNO_PIP" , 0 , Form.GetSharedData("&JUMIN_NUM", false ))
	DATAMANAGER.RequestTranData("obaci_acct_185r")
    
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

    If szTranID = "obaci_acct_185r" Then
    
        For i = 0 To DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1") - 1

            ACNO = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "ACNO"  , i)
            Form.SetCtlProp("Container1.CmbAcnt", "cbadddatatext", Left(ACNO,4) & "-" & Right(ACNO,4) )
	    
        Next
	
		Container1.CmbAcnt.Setstatus("focus")
		Container1.CmbAcnt.caption = "종합계좌를 선택해주세요"
		Container1.CmbAcnt.fgcolor = 270
			
    End If
    
    If szTranID == "obacp_comm_004r" Then
        g_HomeNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_TELNO"      , 0)  '자택전화
        g_ClphNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CLPH_TELNO"      , 0)  '휴대전화
        g_WorkNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WRPL_WHOL_TELNO" , 0)  '직장전화
    End If
    
    If szTranID = "obacp_opop_066r" Then
    
        'Container1.EdtPwd.SetResultLabel("1","complete","비밀번호 검증 성공","Container1") help msg 안쓰기로함
        'Container1.SetScrollAutoSize() help msg 안쓰기로 함
        Container1.EdtBfPwd.SetShowKeypad(true)
        Form.requestMOTP("MOTP_GET_VERSION" , "" , "86125")	  

    End If
    
    If szTranID = "obcsb_oimf_172r" Then
    
        If DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "MOTP_SRNO" , 0) == "" Then
            Form.MsgBox("OTP 정보 조회 오류" , "OTP 정보 없음" , "", 6)		    
        Else
            
            g_MOTPSrno = DATAMANAGER.GetDataValue(0 , szTranID , "OutBlock1" , "MOTP_SRNO" , 0)
	    
            Container1.EdtBfPwd.enable = True
            Container1.EdtAfPwd.enable = True
            Container1.EdtAfPwdCnfr.enable = True
	    
            BtnNext.enable   = True
            BtnNext.btnimage = "btn_20.9"
	       BtnNext.fgcolor = "273"
        End If
    End If    
	
    If szTranID = "obcsb_oimf_173a" Then
    
        Form.OpenPopup("mbotp86126" , "" , "") '완료팝업
    
    End If
    
    If szTranID == "obacp_comm_058r" Then
    
         BtnNext.enable   = True
         BtnNext.btnimage = "btn_20.9" 
         BtnNext.fgcolor = "273"
		
    End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    If szTranID = "obacp_comm_004r" Then
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        If strMsg = "" Then
            Form.ShowAlert("알림", szErrMsg)
            'Form.MsgBox("연락처 정보 조회 오류" , szErrMsg , "", 6)	
        Else
            Form.ShowAlert("알림", szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")")
            'Form.MsgBox("연락처 정보 조회 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
        End If	    	        
    End If

	If szTranID = "obacp_comm_058r" Then
		BtnNext.enable   = False
         BtnNext.fgcolor = "269"
         szTheme = Form.GetEnvData("common.theme")
         If szTheme == "white" Then 
             BtnNext.btnimage = "btn_21.9"
         Else
             BtnNext.btnimage = "btn_27.9"
         End If
		


		strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
		If strMsg = "" Then
		    Form.ShowAlert("알림", szErrMsg)
		    'Form.MsgBox("모바일OTP 비밀번호 유효성 검증 오류" , szErrMsg , "", 6)	
		Else
		    Form.ShowAlert("알림", szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")")
		    'Form.MsgBox("모바일OTP 비밀번호 유효성 검증 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
		End If
	End If	

	If szTranID = "obacp_opop_066r" Then
	
        'Container1.EdtPwd.SetResultLabel("1","error","비밀번호 검증 오류","Container1") help msg 안쓰기로 함
        'Container1.SetScrollAutoSize() help msg 안쓰기로 함
        'Container1.EdtBfPwd.SetShowKeypad(true)	
	
        subMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
        pwErrorMsg = szErrMsg & "★("&subMsg&")"
	
        Form.OpenPopup("mbbdm85203" , pwErrorMsg , "5")
	
        'If Container1.
        'If strMsg = "" Then
            'Form.MsgBox("계좌비밀번호 오류" , szErrMsg , "", 6)	
        'Else
            'Form.MsgBox("계좌비밀번호 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
        'End If	    


        Container1.EdtBfPwd.caption = ""
        Container1.EdtAfPwd.caption = ""
        Container1.EdtAfPwdCnfr.caption = ""

        Container1.EdtBfPwd.enable = False
        Container1.EdtAfPwd.enable = False
        Container1.EdtAfPwdCnfr.enable = False
	
	End If
	
	If szTranID = "obcsb_oimf_172r" Then
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        If strMsg = "" Then
            Form.ShowAlert("알림", szErrMsg)
            'Form.MsgBox("OTP 정보 조회 오류" , szErrMsg , "", 6)	
        Else
            Form.ShowAlert("알림", szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")")
            'Form.MsgBox("OTP 정보 조회 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
        End If	    	    
	End If		
	
	If szTranID = "obcsb_oimf_173a" Then
        strMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
        If strMsg = "" Then
            Form.ShowAlert("알림", szErrMsg)
            'Form.MsgBox("모바일OTP 비밀번호 변경 오류" , szErrMsg , "", 6)	
        Else
            Form.ShowAlert("알림", szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")")
            'Form.MsgBox("모바일OTP 비밀번호 변경 오류" , szErrMsg & Chr(13) & Chr(10) & "(" & strMsg & ")" , "", 6)
        End If	    	    
	End If
	
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName == "CLOSE_YN" Then
	    If sRet == "Y" Then
	        Form.CloseForm()
	    End If
	End If
End Sub

'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam) 

	Dim tmpList
	If sEventName == "MOTP_GET_VERSION_RETURN_86125" Then ' M SafeBox 버전 정보 가져오기
		tmpList = Split(sParam, "★")
		If tmpList[0] == "00000" Then
			g_MsboVrsn = tmpList[2]
			
              DATAMANAGER.SetDataValue(0 , "obcsb_oimf_172r" , "InBlock1" , "ACNO"     , 0 , Container1.CmbAcnt.caption)
              DATAMANAGER.SetDataValue(0 , "obcsb_oimf_172r" , "InBlock1" , "RCNO_PIP" , 0 , Form.GetSharedData("&JUMIN_NUM", false ))
              DATAMANAGER.RequestTranData("obcsb_oimf_172r")			
	      
		Else
			Form.ShowAlert("알림", "MSB 버전 추출 오류\n"..tmpList[1])
		End If
		
	End If

End Sub

'============================================================================
Sub Container1_EdtPwd_OnEditComplete()

    ACNO = Left(Container1.CmbAcnt.caption,4) & Right(Container1.CmbAcnt.caption,4) '작대기 제거
    PWD = Container1.EdtPwd.caption

    DATAMANAGER.SetDataValue(0, "obacp_opop_066r" , "InBlock1" , "ACNO"     , 0 , ACNO)
    DATAMANAGER.SetDataValue(0, "obacp_opop_066r" , "InBlock1" , "ACNT_PWD" , 0 , PWD )
    DATAMANAGER.RequestTranData("obacp_opop_066r")
    
End Sub

'============================================================================
Sub Container1_EdtPwd_OnClick()

    Container1.EdtBfPwd.caption = ""
    Container1.EdtAfPwd.caption = ""
    Container1.EdtAfPwdCnfr.caption = ""

    Container1.EdtBfPwd.enable = False
    Container1.EdtAfPwd.enable = False
    Container1.EdtAfPwdCnfr.enable = False
    
    BtnNext.enable   = False
    BtnNext.fgcolor = "269"
    szTheme = Form.GetEnvData("common.theme")
    If szTheme == "white" Then
        BtnNext.btnimage = "btn_21.9"
    Else
        BtnNext.btnimage = "btn_27.9"
    End If
    
    
End Sub

'============================================================================
Sub Container1_CmbAcnt_OnEditComplete(iIndex)
	
	fn_CntInit() '컨트롤 초기화
	
	tmpACNO = Left(Container1.CmbAcnt.caption , 4) & Right(Container1.CmbAcnt.caption , 4)
	DATAMANAGER.SetDataValue( 0, "obacp_comm_004r", "InBlock1", "ACNO", 0, tmpACNO )
	DATAMANAGER.SetDataValue( 0, "obacp_comm_004r", "InBlock1", "ELFN_ID", 0 , Form.GetSharedData("&USER_ID", false ))        
	DATAMANAGER.RequestTranData("obacp_comm_004r")

	Container1.EdtPwd.SetShowKeypad(true)
	
End Sub

'============================================================================
Sub BtnNext_OnClick()

    If Trim(Container1.EdtBfPwd.caption) == "" Then
        Form.MsgBox("알림", "현재 모바일OTP 비밀번호를 입력해주세요.", "" , 0)
        Exit Sub        
    End If
    
    If Trim(Container1.EdtAfPwd.caption) == "" Then
        Form.MsgBox("알림", "변경할 모바일OTP 비밀번호를 입력해주세요.", "" , 0)
        Exit Sub        
    End If    
    
    If Trim(Container1.EdtAfPwdCnfr.caption) == "" Then
        Form.MsgBox("알림", "입력확인 모바일OTP 비밀번호를 입력해주세요.", "" , 0)
        Exit Sub        
    End If        

    If Container1.EdtAfPwd.caption <> Container1.EdtAfPwdCnfr.caption Then
        Form.MsgBox("알림", "변경할 모바일OTP 비밀번호가 일치하지 않습니다.", "" , 0)
        Exit Sub
    End If
    
    If Container1.EdtBfPwd.caption == Container1.EdtAfPwd.caption Then
        Form.MsgBox("알림", "변경전후 모바일OTP 비밀번호가 동일합니다.", "" , 0)
        Exit Sub        
    End If
    
	tmpACNO = Left(Container1.CmbAcnt.caption , 4) & Right(Container1.CmbAcnt.caption , 4)
	
	DATAMANAGER.SetDataValue(0 , "obcsb_oimf_173a" , "InBlock1" , "PROS_CLS_CODE"           , 0 , "M"                       )
	DATAMANAGER.SetDataValue(0 , "obcsb_oimf_173a" , "InBlock1" , "ACNO"                    , 0 , tmpACNO                   )
	DATAMANAGER.SetDataValue(0 , "obcsb_oimf_173a" , "InBlock1" , "ACNT_PWD"                , 0 , Container1.EdtPwd.caption  )
	DATAMANAGER.SetDataValue(0 , "obcsb_oimf_173a" , "InBlock1" , "CSNO"                    , 0 , ""                        ) '서비스에서 세팅
	DATAMANAGER.SetDataValue(0 , "obcsb_oimf_173a" , "InBlock1" , "MOTP_SRNO"               , 0 , g_MOTPSrno                )
	DATAMANAGER.SetDataValue(0 , "obcsb_oimf_173a" , "InBlock1" , "MSBO_VRSN"               , 0 , g_MsboVrsn                )
	DATAMANAGER.SetDataValue(0 , "obcsb_oimf_173a" , "InBlock1" , "CUST_TERM_ID"            , 0 , Form.GetDeviceID()        )
	DATAMANAGER.SetDataValue(0 , "obcsb_oimf_173a" , "InBlock1" , "MOTP_ATHN_TYPE_CLCD"     , 0 , ""                        ) '서비스에서 세팅
	DATAMANAGER.SetDataValue(0 , "obcsb_oimf_173a" , "InBlock1" , "MOTP_ATHN_DATA_CNTT"     , 0 , Container1.EdtAfPwd.caption)
	DATAMANAGER.SetDataValue(0 , "obcsb_oimf_173a" , "InBlock1" , "PRE_MOTP_ATHN_DATA_CNTT" , 0 , Container1.EdtBfPwd.caption)
	
	DATAMANAGER.RequestTranData("obcsb_oimf_173a")        
	

End Sub

'============================================================================


'============================================================================
Sub Container1_BtnAccordion_OnClick()

	If aFlag == 0 Then
	
	    Container1.LblDummy.top = 680
	    Container1.SetScrollAutoSize()
	    Container1.Container3.setHeightResize(156)
	    Container1.scroll_pos = 185
	    
	    Container1.Container2.Image2.imgpath = "icon_caret_up.png"
	
	    aFlag = 1
	
	ElseIf aFlag == 1 Then
	
	    Container1.Container3.setHeightResize(0)
	    Container1.LblDummy.top = 485
	    Form.SetTimerEvent("9999", 1 , 1)
	    
	    Container1.Container2.Image2.imgpath = "icon_caret_down.png"
	    
	    aFlag = 0
	
	End If
	
End Sub

'============================================================================
Sub Container1_EdtAfPwdCnfr_OnClick()
	If g_OSClcd <> "1" Then '아이폰은 에디트 위치를 자동으로 올려주지 않음.
		Container1.LblDummy.top = 567 + 90
		Container1.SetScrollAutoSize()
		Container1.scroll_pos = 90
	End If
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if trim(sTimerID) == "9999" then
		Form.SetTimerEvent("9999", 0, 1)
		Container1.scroll_pos = 0
		Container1.SetScrollAutoSize()
	end if
End Sub

'============================================================================
Sub Image0_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub ButtonBack_OnClick()
    Form.CloseForm()	
End Sub

'============================================================================
Sub Container1_EdtBfPwd_OnEditComplete()
	Container1.EdtAfPwd.SetShowKeypad(true)
End Sub

'============================================================================
Sub Container1_EdtAfPwd_OnEditComplete()
	Container1.EdtAfPwdCnfr.SetShowKeypad(true)
End Sub


'============================================================================
Sub Container1_EdtAfPwdCnfr_OnEditComplete()
	If g_OSClcd <> "1" Then '아이폰은 에디트 위치를 자동으로 올려주지 않음.
		Container1.LblDummy.top = 567
		Container1.SetScrollAutoSize()
		Container1.scroll_pos = 0
	End If
	
	tmpACNO = Left(Container1.CmbAcnt.caption , 4) & Right(Container1.CmbAcnt.caption , 4)    
	
	DATAMANAGER.SetDataValue( 0, "obacp_comm_058r", "InBlock1", "PROS_CLS", 0 , "7" 		 )	'[MTS] 계좌비밀번호 변경시 체크
	DATAMANAGER.SetDataValue( 0, "obacp_comm_058r", "InBlock1", "ACNO"    , 0 , tmpACNO )  '계좌번호
	DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOGN_ID" , 0 , Form.GetSharedData("&USER_ID", false ))  'ID
	
	'비밀번호복호화하여 비교해야하므로 ARIA값으로 넘겨줌(caption2 API사용)
	DATAMANAGER.SetDataValue( 0, "obacp_comm_058r", "InBlock1", "PWD_PIP"     , 0 , Container1.EdtAfPwd.caption2     )  '비밀번호
	DATAMANAGER.SetDataValue( 0, "obacp_comm_058r", "InBlock1", "CNFR_PWD_PIP", 0 , Container1.EdtAfPwdCnfr.caption2 )  '확인비밀번호
	DATAMANAGER.SetDataValue( 0, "obacp_comm_058r", "InBlock1", "RCNO"		 , 0 , ""			)  '실명확인번호(서비스에서 조회)		
	DATAMANAGER.SetDataValue( 0, "obacp_comm_058r", "InBlock1", "WRPL_TELNO"  , 0 , g_WorkNo        )  '직장전화
	DATAMANAGER.SetDataValue( 0, "obacp_comm_058r", "InBlock1", "CLPH_TELNO"  , 0 , g_ClphNo        )  '휴대전화
	DATAMANAGER.SetDataValue( 0, "obacp_comm_058r", "InBlock1", "OWHS_TELNO"  , 0 , g_HomeNo        )  '자택전화    
	
	DATAMANAGER.RequestTranData("obacp_comm_058r")
	

End Sub

Function fn_CntInit()
    Container1.EdtPwd.caption = ""	
	
    Container1.EdtBfPwd.caption = ""
    Container1.EdtAfPwd.caption = ""
    Container1.EdtAfPwdCnfr.caption = ""

    Container1.EdtBfPwd.enable = False
    Container1.EdtAfPwd.enable = False
    Container1.EdtAfPwdCnfr.enable = False	
End Function

