						<LABEL name="Label3" caption="타인에게 유출되지 않도록 각별히 유의하
시기 바랍니다." bgcolor="272:246246246" transmode="0" multiline="1" ly_vert="32,97,287,38,1" />
					</CONTROL_INFO>
