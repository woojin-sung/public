	<SCRIPT_INFO _len="4411" _ulen="4009" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 선옵 예약주문
' 02. 화면설명 : 선옵 예약주문 주문확인창
' 03. 작    성 : 2016.04.30 LJS
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


Dim g_nCount
	g_nCount = 0

Dim g_nIndex				' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소, 10:예약매수, 11:예약매도, 13:예약취소)
Dim 	g_szOrder_Acc			' 계좌번호
Dim 	g_szOrder_AccName		' 고객명
Dim 	g_szOrd_ItmCode		' 종목코드
Dim 	g_szOrd_ItmName		' 종목명
Dim 	g_szOrd_OrdType		' 주문구분
Dim 	g_nOrd_Price			' 주문가격
Dim 	g_nOrd_Qty			' 주문수량
Dim 	g_nOrd_OrdNo			' 원주문번호	
Dim 	g_nOrd_ChkAll			' 잔량전부

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)
	
	If g_nIndex = "2" Then
		lblModifyTitle.caption = "선물옵션 정정주문"
		
	'20170421 HAMWG START : 야간선물옵션 매수주문 대응
	Elseif g_nIndex = "82" Then
		lblModifyTitle.caption = "야간선물옵션 정정주문"
	'20170421 HAMWG END
	
	Else
		lblModifyTitle.caption = "선물옵션 예약 정정주문"
	End If

	If g_nOrd_ChkAll = "1" Then
	    g_nOrd_Qty = "전부"
	End If
	
	tblModi.SetCellString( 0, 1, g_szOrder_Acc 		)
	tblModi.SetCellString( 0, 2, g_szOrder_AccName	)
	tblModi.SetCellString( 1, 1, g_szOrd_ItmCode 	)
	tblModi.SetCellString( 2, 1, g_szOrd_ItmName	)
	tblModi.SetCellString( 3, 1, g_szOrd_OrdType	)
	tblModi.SetCellString( 4, 1, g_nOrd_Qty		)
	tblModi.SetCellString( 5, 1, g_nOrd_Price 		)
	tblModi.SetCellString( 6, 1, g_nOrd_OrdNo		)

	    
End Function

'============================================================================
Function SendOrder()
    If g_nCount = 0 Then
	    Form.SendReturnToParent( "주문전송" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
    End If
    
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	Dim szData, arrData, szItemName, szMarketGubun

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if	
	
	g_nIndex				= arrData( 0) ' 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
	g_szOrder_Acc			= arrData( 1)	' 계좌번호
	g_szOrder_AccName		= arrData( 2)	' 고객명
	g_szOrd_ItmCode 		= arrData( 3)	' 종목코드
	g_szOrd_ItmName 		= arrData( 4)	' 종목명
	g_szOrd_OrdType  		= arrData( 5)	' 주문구분
	g_nOrd_Price 			= arrData( 6)	' 주문가격
	g_nOrd_Qty   			= arrData( 7)	' 주문수량	
	g_nOrd_OrdNo 			= arrData( 8)	' 원주문번호
	g_nOrd_ChkAll 		= arrData( 9)	' 잔량전부
	
	'2017.12.13 주식선물의 경우 가격 > 소수점없음
	szMarketGubun = Form.GetItemCodeInfo( g_szOrd_ItmCode , "market")
	if szMarketGubun == "JF" or szMarketGubun == "JO" then
		tblModi.SetCellMaskInfo( 5, 1, "0,0,,,0,,0,1,1" )
	else
		tblModi.SetCellMaskInfo( 5, 1, "0,0,,,0,,2,1,1" )
	end if
	
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
    Set_Data(g_nIndex)
    
End Sub

'============================================================================
Sub btnmodi_OnClick()
	SendOrder()
End Sub

'============================================================================
Sub btnModiClose_OnClick()
	Form.CloseForm( )
End Sub

'============================================================================
Sub imgClose6_OnClick()
	Form.CloseForm( )
End Sub


	</SCRIPT_INFO>
</ROOT>