							</CELL>
						</CELLINFO>
					</BODY>
				</COLUMN>
			</COLINFO>
			<UPDATETR_INFO/>
			<UPDATEBC_INFO keycellid="bd_cell0" rangecellid="bd_cell0" hlcolorcellid="bd_cell0" />
		</GRID>
		<LABEL name="Label0" visible="0" fgcolor="146:124124124" fontsize="1" caption="펀드자동이체 신청 내역이 없습니다." halign="1" ly_vert="20,185,335,20,0" />
		<IMAGE name="Image0" visible="0" autosize="1" imgpath="icon_notice_3.png" ly_vert="157,120,50,45,0" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="13449" _ulen="12781" >
'============================================================================
' 01.화면명 	: 펀드정기입금이체
' 02.화면설명	: 펀드정기입금이체 이체신청내역탭
'============================================================================
'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szData
Dim g_szArr
Dim g_szList			'
Dim g_szCustNum		'고객번호
Dim g_szTRCount		'069r TR의 Output 값 개수
Dim g_szTotalCount	'Tr
Dim g_szBankName		'은행명
Dim g_szNextCount		'Next조회시 Index Count
Dim g_szPW

'============================================================================
'							FORM 함수
'============================================================================
Sub Form_OnFormInit()
	g_szPW			= ""
	g_szData			= ""
	g_szTRCount		= 0
	g_szTotalCount	= 0

	grd0.setUseCardView(true, 15, "btn_12_n.9")
	grd0.setCellMaxLineCount("KOR_ISSU_ABWR_NAME",2)
End Sub



'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	grd0.SetClear()
	
	if sEventName == "mbfnp51020_t1" then			
		g_szList = Split(sParam, "★")
		if UBOUND(g_szList) < 1 then
			Exit Sub
		end if
	
		DATAMANAGER.RequestTranData( "obpds_srvc_070r" )
	end if

End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mbfnp51020_pc" then
	
		if sRet == "OK" then		
			g_szArr = split(g_szData, "★")
			
			if UBOUND(g_szArr) < 1 then
				g_szPW	= ""
				g_szData = ""
				
				Form.ShowAlert("알림", "해지 항목을 다시 선택해주세요.")
				Exit Sub
			else
				Form.SetTimerEvent2(1, 1, 0.5)
			end if
			
		else
			g_szPW	= ""
			g_szData = ""
		end if
		
	'계좌 비밀번호 입력 리턴
	elseif sKeyName == "CORRECT_PWD" and sRet <> "" and sRet <> null then
		Dim tData
		tData = Split(sRet, "★")

		if UBOUND(tData) > 0 Then
			g_szPW = tData[0]

			DATAMANAGER.RequestTranData( "obpds_srvc_038a" )
		end if
	
	' 해지신청 완료 리턴
	elseif sKeyName == "mbfnp51020_p9" then
		g_szPW	= ""
		g_szData	= ""
		
		DATAMANAGER.RequestTranData( "obpds_srvc_070r" )
	end if
	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if sTimerID == 1 or sTimerID == "1" then
		Form.SetTimerEvent2(1, 0, 0.5)
		
		Form.openPopupAnimation("pwdcheckpopup", g_szList(0)&g_szList(1) & "☆" & "0", "", "2")
	end if
	
End Sub

'============================================================================
'						DATAMANAGER 함수
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obpds_srvc_070r" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_070r", "InBlock1", "ACNO" , 				0 , g_szList(0) )	'계좌번호
	elseif szTranID == "obpds_srvc_333r" then	
		g_szTRCount = 0
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_333r", "InBlock1", "ACNO" , 				0 , g_szList(0) )	
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_333r", "InBlock1", "ASNO" , 				0 , g_szList(1) )	
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_333r", "InBlock1", "STPL_STAT_CLS_CODE" , 	0 , "01" )		'약정상태구분코드
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_333r", "InBlock1", "SVCD" , 				0 , "012" )	'고객번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_333r", "InBlock1", "CUST_ACNT_CLS_CODE" ,    0 , "2" )	'고객번호
	elseif szTranID == "obpds_srvc_069r" then
		g_szTRCount = 0
	
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_069r", "InBlock1", "CSNO" , 				0 , g_szCustNum )	'고객번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_069r", "InBlock1", "ACNO" , 				0 , g_szList(0) )	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_069r", "InBlock1", "CSNO" , 				0 , g_szCustNum )	'고객번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_069r", "InBlock1", "STPL_STAT_CLS_CODE" , 	0 , "01" )		'약정상태구분코드
		
	elseif szTranID == "obpds_srvc_082r" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_082r", "InBlock1", "CSNO" , 				0 , g_szCustNum )	'고객번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_082r", "InBlock1", "SVCD" , 				0 , grd0.GetCellData("SVCD", 		g_szTRCount))	'서비스코드
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_082r", "InBlock1", "SVC_SRNO" , 			0 , grd0.GetCellData("SVC_SRNO",	g_szTRCount))	'서비스일련번호

	elseif szTranID == "obpds_srvc_038a" then
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "PROS_CLS_CODE" , 		0 , "D"			)	'처리구분코드
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "CONT_CLS_CODE" , 		0 , "4"			)	'접촉구분코드
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "NXET_TIMS_ATMT_APLT_YN",	0 , "N"			)	'다음회차자동신청여부
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "SVCD" , 				0 , g_szArr(16)	)	'서비스코드
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "ACNO" , 				0 , g_szArr(0)	)	'계좌번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "ASNO" , 				0 , g_szArr(1)	)	'일련번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "CSNO" , 				0 , g_szArr(2)	)	'고객번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_AMT" , 			0 , g_szArr(3)	)	'이체금액
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "ACNT_PWD" , 			0 , g_szPW		)	'계좌비밀번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "RMND_SRNO" , 			0 , g_szArr(4)	)	'펀드 잔고번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "SVC_SRNO" , 			0 , g_szArr(5)	)	'서비스 일련번호
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_STA_DATE" , 		0 , g_szArr(6)	)	'이체 시작일자
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_FIN_DATE" , 		0 , g_szArr(7)	)	'이체 종료일자
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_HOPE_DAY_CODE" , 	0 , g_szArr(8)	)	'이체희망일
		DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "DPSR_NAME" , 			0 , g_szArr(9)	)	'예금자명
		
		if g_szArr(10) == "1" then	'메리츠일때
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_ACNT_CLS_CODE" , 	0 , "1")			'이체계좌 구분코드 -> 메리츠 : 1
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_SCRT_ACNO" , 		0 , g_szArr(11))	'계좌번호
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_SCRT_ASNO" , 		0 , g_szArr(12))	'일련번호
		else
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_ACNT_CLS_CODE" , 	0 , "2")			'이체계좌 구분코드 -> 타은행 : 2
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "BANK_CODE" , 			0 , g_szArr(13))	'타행기관코드
			DATAMANAGER.SetDataValue( 0 , "obpds_srvc_038a", "InBlock1", "TACT_BANK_ACNO" , 		0 , g_szArr(14))	'타행계좌번호
		end if
		
	end if

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim totalTemp
	
	if szTranID == "obpds_srvc_070r" then
		g_szCustNum		= DATAMANAGER.GetDataValue( 0 , "obpds_srvc_070r", "OutBlock1", "CSNO" , 0)	'고객번호
		g_szTotalCount	= 0
		g_szNextCount		= 0
		
		DATAMANAGER.RequestTranData( "obpds_srvc_333r" )
	'obpds_srvc_069r->obpds_srvc_333r 변경
	'elseif szTranID == "obpds_srvc_069r" then
	elseif szTranID == "obpds_srvc_333r" then
		totalTemp		= DATAMANAGER.GetDataCount( 0 , "obpds_srvc_333r", "OutBlock1")
		g_szTotalCount	= g_szTotalCount + totalTemp

		if CInt(g_szTotalCount) > 0 then
			Label0.visible	= false
			Image0.visible	= false
			grd0.visible		= true
		else
			Label0.visible	= true
			Image0.visible	= true
			grd0.visible		= false
		end if
		
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obpds_srvc_333r", "OutBlock1") - 1
			grd0.SetCellData( "BUTTON",					g_szNextCount, "해지")
			grd0.SetCellData( "BD_BANK_ACNO", 			g_szNextCount, "출금계좌")
			grd0.SetCellData( "BD_TACT_AMT", 			g_szNextCount, "이체금액")
			grd0.SetCellData( "BD_PERIOD",				g_szNextCount, "이체기간")
			grd0.SetCellData( "BD_TACT_HOPE_DAY_CODE",	g_szNextCount, "이체일")
			
			g_szNextCount = g_szNextCount + 1
		next
		
		if DATAMANAGER.IsMoreNextData( "obpds_srvc_333r" ) == true then
			DATAMANAGER.RequestNextData( "obpds_srvc_333r" )
			Exit Sub
		end if
		
		DATAMANAGER.RequestTranData( "obpds_srvc_082r" )
		g_szTRCount = g_szTRCount + 1
		
	elseif szTranID == "obpds_srvc_082r" then
		Dim BANK_ACNO, BANK_CODE, TACT_SCRT_ACNO, TACT_SCRT_ASNO, TACT_BANK_ACNO, PRCD
		BANK_CODE		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "BANK_CODE", 		0)
		TACT_SCRT_ACNO	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TACT_SCRT_ACNO", 	0)
		TACT_SCRT_ASNO	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TACT_SCRT_ASNO", 	0)
		TACT_BANK_ACNO	= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TACT_BANK_ACNO", 	0)
		RMND_SRNO		= DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "RMND_SRNO", 	0)
		PRCD 			= Form.GetAccountInfo(TACT_SCRT_ACNO..TACT_SCRT_ASNO, "productcode")
		
		g_szBankName		= Form.GetMetaData("은행코드", BANK_CODE)
		' 메리츠 계좌일 경우
		if DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TACT_ACNT_CLS_CODE", 0) == "1" then
			BANK_ACNO = "["..Form.GetMetaData("MTS상품코드", PRCD).."] "..MID(TACT_SCRT_ACNO,1,4).."-"..MID(TACT_SCRT_ACNO,5,4).."-"..TACT_SCRT_ASNO
		else
			BANK_ACNO = "["..g_szBankName.."] "..TACT_BANK_ACNO
		end if
		grd0.SetCellData("RMND_SRNO", 			g_szTRCount-1, RMND_SRNO)
		grd0.SetCellData("BANK_CODE",			g_szTRCount-1, BANK_CODE)
		grd0.SetCellData("TACT_BANK_ACNO",		g_szTRCount-1, TACT_BANK_ACNO)
		grd0.SetCellData("TACT_SCRT_ACNO",		g_szTRCount-1, TACT_SCRT_ACNO)
		grd0.SetCellData("TACT_SCRT_ASNO",		g_szTRCount-1, TACT_SCRT_ASNO)
		grd0.SetCellData("BANK_ACNO",			g_szTRCount-1, BANK_ACNO)
		grd0.SetCellData("TACT_HOPE_DAY_CODE", 	g_szTRCount-1, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TACT_HOPE_DAY_CODE",	0))
		grd0.SetCellData("TACT_AMT", 			g_szTRCount-1, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TACT_AMT", 		0))
		grd0.SetCellData("TACT_STA_DATE",		g_szTRCount-1, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TACT_STA_DATE", 	0))
		grd0.SetCellData("TACT_FIN_DATE",		g_szTRCount-1, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TACT_FIN_DATE", 	0))
		grd0.SetCellData("PERIOD",				g_szTRCount-1, MID(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TACT_STA_DATE", 	0),1,6) .. MID(DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TACT_FIN_DATE", 0),1,6))
		grd0.SetCellData("DPSR_NAME",			g_szTRCount-1, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "DPSR_NAME", 		0))
		grd0.SetCellData("TACT_ACNT_CLS_CODE",	g_szTRCount-1, DATAMANAGER.GetDataValue(false, szTranID, "OutBlock1", "TACT_ACNT_CLS_CODE",	0))
		
		if g_szTRCount < 	g_szTotalCount then
			DATAMANAGER.RequestTranData( "obpds_srvc_082r" )
			g_szTRCount = g_szTRCount + 1
		end if
	
	elseif szTranID == "obpds_srvc_038a" then
		g_szData = "해지@"..g_szData
		
		Form.OpenPopup("mbfnp51020_p9", g_szData, "")
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	g_szPW	= ""
	g_szData	= ""
	szSubErr	= DATAMANAGER.GetDataMsgSubText( szTranID )
	
	if szSubErr <> null and Trim(szSubErr) <> "" then
		Form.ShowAlert( "알림" , szErrCode .. " : ".. szErrMsg.."("..szSubErr..")")
	else
		Form.ShowAlert( "알림" , szErrCode .. " : ".. szErrMsg)
	end if
		
	DATAMANAGER.RequestTranData( "obpds_srvc_070r" )
End Sub

'============================================================================
'							CONTORL 함수
'============================================================================
Sub grd0_OnClickUp(lRow, szCellID)

	if szCellID == "BUTTON" then
		g_szData = 	grd0.GetCellData("ACNO",				lRow) & "★" &
					grd0.GetCellData("ASNO",				lRow) & "★" &
					grd0.GetCellData("CSNO",				lRow) & "★" &
					grd0.GetCellData("TACT_AMT",			lRow) & "★" &
					grd0.GetCellData("RMND_SRNO",			lRow) & "★" &
					grd0.GetCellData("SVC_SRNO",			lRow) & "★" &
					MID(grd0.GetCellData("TACT_STA_DATE",		lRow),1,6) & "★" &
					MID(grd0.GetCellData("TACT_FIN_DATE",		lRow),1,6) & "★" &
					grd0.GetCellData("TACT_HOPE_DAY_CODE",	lRow) & "★" &
					grd0.GetCellData("DPSR_NAME",			lRow) & "★" &
					grd0.GetCellData("TACT_ACNT_CLS_CODE",	lRow) & "★" &
					grd0.GetCellData("TACT_SCRT_ACNO",		lRow) & "★" &
					grd0.GetCellData("TACT_SCRT_ASNO",		lRow) & "★" &
					grd0.GetCellData("BANK_CODE",			lRow) & "★" &
					grd0.GetCellData("TACT_BANK_ACNO",		lRow) & "★" &
					grd0.GetCellData("KOR_ISSU_ABWR_NAME",	lRow) & "★" &
					grd0.GetCellData("SVCD",				lRow)

		Form.OpenPopupAnimation("mbfnp51020_pc", "", "", "2")
	end if
	
End Sub

