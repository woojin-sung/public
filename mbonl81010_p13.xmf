'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	Dim szData
	
	szData = Form.GetOpenLinkData()
	
	if tonumber(szData) <> NULL then
		Container0.rdoGubun.currentindex = szData
	end if
End Sub

'============================================================================
' btnOk_OnClick() : 화면 닫기
'============================================================================
Sub btnOk_OnClick()
	if tonumber(Container0.rdoGubun.currentindex) == -1 then
		Form.ShowAlert("알림", "투자권유구분을 확인해주세요")
	else
		Form.SendReturnToParent("close_mbonl81010_p13" , Container0.rdoGubun.currentindex)
		Form.CloseForm()
	end if
End Sub

'============================================================================
' btnBack_OnClick() : 화면 닫기
'============================================================================
Sub btnBack_OnClick()
	Form.CloseForm()
End Sub

