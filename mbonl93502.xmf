'============================================================================
Sub contScroll_btnChange_OnClick()
	Dim szSendData
	Dim tCtlNm
	tCtlNm = {"rdoQ3", "edtQ9", "edtQ10", "edtQ11", "rdoQ13", "rdoQ14"}
	for i = 0 to #tCtlNm - 1
		
		Dim ITEM_CNTT
		'LHR 수정
		'ITEM_CNTT    = Grid1.GetCellData("bd_item_cntt" , i) '항목내용
		Dim szIndex 		
		'if i == 1 or i == 2 or i == 3 then
		if i == 1 or i == 2 then
			szIndex = Form.GetCtlProp( "contScroll."&tCtlNm[i], "caption")
			if trim(szIndex) == "" then
				szIndex = 0
			end if
		elseif i == 3 then
			'szIndex = Form.GetCtlProp( "contScroll."&tCtlNm[i], "caption")
			tmpAmt = Form.GetCtlProp( "contScroll."&tCtlNm[i], "caption")
			'szIndex = Cdbl(Replace(tmpAmt,",",""))
			tmpAmt2 = Cdbl(Replace(tmpAmt,",",""))
			
			if tmpAmt2 >= 0 then
				szIndex = tmpAmt2
			else
				tmpAmt3 = Replace(tmpAmt2, "-", "")
				Value = ""
			    for i = 1 To 18 - len(tmpAmt3)
				    Value = Value & "0"
			    next
			    szIndex = "-" & Value & tmpAmt3	    				
			End if
			
			if trim(szIndex) == "" then
				szIndex = 0
			end if
		else
			szIndex = Form.GetCtlProp( "contScroll."&tCtlNm[i], "currentindex")
		end if 
		
		if tCtlNm[i] == "rdoQ3" then ITEM_CNTT = Form.GetCtlProp("contScroll.lblRdo3"..szIndex+1, "caption")
		elseif tCtlNm[i] == "rdoQ13" then ITEM_CNTT = Form.GetCtlProp("contScroll.lblRdo13"..szIndex+1, "caption")
		elseif tCtlNm[i] == "rdoQ14" then ITEM_CNTT = Form.GetCtlProp("contScroll.lblRdo8"..szIndex+1, "caption")
		elseif tCtlNm[i] == "edtQ9"  then ITEM_CNTT = "자본금 규모"
		elseif tCtlNm[i] == "edtQ10"  then ITEM_CNTT = "부채현황"
		elseif tCtlNm[i] == "edtQ11"  then ITEM_CNTT = "당기 순이익"
		end if
		
		if szSendData == null or szSendData == "" then			
			szSendData = tCtlNm[i] & "☆" & szIndex & "☆" & ITEM_CNTT
		else
			szSendData = szSendData & "★" & tCtlNm[i] & "☆" & szIndex & "☆" & ITEM_CNTT
		end if
	next
	
	'Form.ShowAlert("szSendData", szSendData)
	Form.triggerEvent("#", "ChangeData", szSendData)
End Sub


'============================================================================
Sub contScroll_rdoQ3_OnClick(nIndex)
	for i = 0 to 3 
		if nIndex == i then
			Form.SetCtlProp("contScroll.imgRdo3"..(i+1), "imgpath", g_szSelectRdoImage)
		else
			Form.SetCtlProp("contScroll.imgRdo3"..(i+1), "imgpath", g_szUnSelectRdoImage)
		end if
	next
End Sub

'============================================================================
Sub contScroll_rdoQ13_OnClick(nIndex)
	for i = 0 to 5 
		if nIndex == i then
			Form.SetCtlProp("contScroll.imgRdo13"..(i+1), "imgpath", g_szSelectRdoImage)
		else
			Form.SetCtlProp("contScroll.imgRdo13"..(i+1), "imgpath", g_szUnSelectRdoImage)
		end if
	next
End Sub


'============================================================================
Sub contScroll_rdoQ14_OnClick(nIndex)
	for i = 0 to 4 
		if nIndex == i then
			Form.SetCtlProp("contScroll.imgRdo14"..(i+1), "imgpath", g_szSelectRdoImage)
		else
			Form.SetCtlProp("contScroll.imgRdo14"..(i+1), "imgpath", g_szUnSelectRdoImage)
		end if
	next
End Sub


