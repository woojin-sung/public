Sub Container1_btnNext_OnClick()
	'20240710_01 HWG : 팝업 스타일 수정
	'약관동의
	Form.OpenPopup("nrsbtro16090_p1" , g_szCUST_CLS_CODE & "★" & Container1.Acnt.caption, "")	
End Sub

