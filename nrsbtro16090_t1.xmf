'다음 버튼 활성화여부 
'============================================================================
function SetEnalbeNext()
	Dim szAmt, szFee
	szAmt = Trim(Container1.Table1.GetCellString(2, 2))
	szFee = Trim(Container1.Table0.GetCellString(1, 2))
	szFee = Trim(Replace(szFee, "월", ""))
	szFee = Trim(left(szFee, Len(szFee)-3)) ' 수수료		
	
	'무료가 아니고 수수료>외화잔고 인 경우  
	if (Container1.Table1.GetCellString(2, 2) <> "무료") 
	   and (CDbl(szFee) > CDbl(szAmt)) then 
		Container1.btnNext.enable = false		
	else
		Container1.btnNext.enable = true '다음	
	end if
end function 

'============================================================================
Sub Container1_cldFromDate_OnEditComplete()
	if CInt(Left(Container1.cldFromDate.caption, 6)) > CInt(Left(Container1.cldToDate.caption, 6) ) then
		Form.ShowAlert("알림", "종료일이 시작일 이전입니다.")	
		Container1.btnNext.enable = false
	elseif CInt(Left(Container1.cldFromDate.caption, 6)) < CInt(Left(cldToday.caption, 6)) then
		Form.ShowAlert("알림", "이용기간을 확인해주세요")	
		Container1.btnNext.enable = false
	elseif CInt(Left(Container1.cldToDate.caption, 6)) < CInt(Left(cldToday.caption, 6) ) then
		Form.ShowAlert("알림", "이용기간을 확인해주세요")	
		Container1.btnNext.enable = false
	else
		SetEnalbeNext()
	end if 	
End Sub

'============================================================================
Sub Container1_cldToDate_OnEditComplete()
	Container1_cldFromDate_OnEditComplete()
End Sub

'65000 환전신청 이후 1
'============================================================================
function SetExchangeNext1()
'g_szOpenData = "환전완료`USD`16090`3008432104`미국`0" 'for TEST
'g_szOpenData = "환전완료`CNY`16095`3008432104`상해`1" 'for TEST
	if g_szOpenData <> "" then
		Dim sTemp
		sTemp  = Split(g_szOpenData, "`")
		
		for i = 0 to Pannel0.rowcount - 1 
			if Pannel0.GetCellValue("lblName", i) == sTemp(4) then
				g_nSelectRow = i
			end if 
		next
		Pannel0_OnClick(g_nSelectRow, "btnReq")
	end if 
end function 

'65000 환전신청 이후 2
'============================================================================
function SetExchangeNext2()
	if g_szOpenData <> "" then
		Dim sTemp
		sTemp  = Split(g_szOpenData, "`")
		
		'계좌번호
		CmbAcnt.cbkeydata = sTemp(3)
		Container1.Acnt.caption =  CmbAcnt.caption
		'이용기간
		Container1.RgStyle.currentindex = CInt(sTemp(5))
		Container1.RgStyleCFD.currentindex = Container1.RgStyle.currentindex
		'환전신청 이후 오픈데이터 초기화
		g_szOpenData = ""
	end if 
end function 
