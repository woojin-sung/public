'해외/해외CFD 실시간시세 신청/해지

Dim g_szCode
Dim g_szEngName			'구독자 영문이름
Dim g_szEngAddress		'구독자 영문주소
Dim g_szEngOcptName		'구독자 영문직업명 ENG_OCPT_NAME
Dim g_szEngCoName			'구독자 영문회사명 ENG_CO_NAME
Dim g_szEngCoAddr			'구독자 영문회사주소 ENG_CO_ADDR
Dim g_szEngClpsName		'구독자 영문직급명 CLPS_NAME
Dim g_szEngRsnsBswrName	'구독자 영문담당업무명 RSNS_BSWR_NAME

Dim g_szOvrsStckMrktTrClsCode
Dim g_szQttnApltClcd
Dim g_szAcntNo '신청된 결제계좌

Dim g_szAgree				'이용약관 동의여부
Dim g_szAgrm_yn			'비전문가 동의여부

Dim g_szCUST_CLS_CODE		'고객구분코드(2:법인)
g_szCUST_CLS_CODE = ""

Dim g_szCSNo '고객번호
g_szCSNo = ""

Dim g_szUserId 
g_szUserId = ""

Dim g_szFullAcnt, g_szPasswd, g_szPlainRm

g_CheckBtn3Cnt = 0  		'이용약관 카운트 횟수 - 2019.11.04

g_szEngName = ""
g_szEngAddress = ""
g_szEngOcptName = ""
g_szEngCoName = ""
g_szEngCoAddr = ""
g_szEngClpsName = ""
g_szEngRsnsBswrName = ""

g_szAgree = ""
g_szAgrm_yn = ""
g_szPlainRm = ""			'MTS메모리평문 적용여부

'211216 아이티젠 김성수 START
Dim g_nSelectRow	'선택한 행
g_nSelectRow = 0

Dim g_szOKType
g_szOKType = "2" '실시간시세신청

Dim g_szScreenNo
g_szScreenNo = ""

Dim g_szRgStyleNoClick
g_szRgStyleNoClick = false

'0: 이동 필요없음
'16095: CFD 실시간 시세신청한 고객이 해외주식 실시간 시세 신청 화면에서 해지하는 경우 
'16090: 해외주식 실시간 시세신청한 고객이 해외CFD 실시간 시세 신청 화면에서 해지하는 경우 
Dim g_szMoveScreen 
g_szMoveScreen = ""

Dim g_szConfirmMsg 
g_szConfirmMsg = ""

Dim g_szOlnyCustEdit
g_szOlnyCustEdit = "N"

'CFD관련 메시지 한번만 표기
Dim g_szDisplayMsgForCFD
'g_szDisplayMsgForCFD = true

'6500 환전신청 후 넘겨받은 데이터 
Dim g_szOpenData
g_szOpenData = ""

'이용기간 
Dim g_gzRgStyle
g_gzRgStyle = "0"

'============================================================================
Sub Form_OnFormInitBefore()
	'1: 가운데정렬, 2 : 좌측정렬
	imgTip.setMaintainingRatio("1")		
End Sub

'211216 아이티젠 김성수 END
'============================================================================
Sub Form_OnFormInit()
	
    '안드로이드-백버튼 작동Y 원복
    Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")  
    
	'화면번호
	g_szScreenNo = Form.GetSharedData( "&SCREEN_NO" , false )	
'g_szScreenNo = "16095" 'for TEST
	if g_szScreenNo == "16095" then 'CFD
		Container1.RgStyle.visible = false
		Container1.RgStyleCFD.visible = true
		
		imgTip.visible = false
		lblTitle2.visible = false
		Pannel0.top = 0
		Pannel0.height = 604
	else
		Container1.RgStyle.visible = true
		Container1.RgStyleCFD.visible = false
	end if 	

	'MTS메모리평문 적용유무 (0:미적용 / 1:적용) - 2020.09.17
	g_szPlainRm = Form.GetSharedData("&PLAIN_RM", false)
	
	'고객번호
	g_szCSNo = Form.GetSharedData("&CUST_NUM", false )'로그인 해야만 고객번호 받아옴
	g_szUserId = Form.GetSharedData("&USER_ID", false )	
	
	'등록구분/신청기간 기본세팅인 등록 및 자동연장에 맞게 컨트롤 세팅
	btnSubmit.caption = "등록"
	
	DATAMANAGER.RequestTranData( "obcsb_efif_262r" ) '법인여부 체크
End Sub

'============================================================================
'Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName	 == "INFO_REFRESH" then
		if g_szCSNo <> "" then
			g_szOpenData = sParam '6500 환전신청 후 넘겨받은 데이터
			Container1_btnBefore_OnClick()		
			
			Pannel0.rowcount = 0 '초기화
			DATAMANAGER.RequestTranData("obcsb_efif_262r")
		end if 
	elseif sEventName	== "SET_SUBSCREEN" then 
		Container1_btnBefore_OnClick()
	elseif sEventName	==  "DISPLAY_MSG_FOR_CFD" then
		if sParam == "0" then
			g_szDisplayMsgForCFD = false
		else
			g_szDisplayMsgForCFD = true
		end if 	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
		
	'법인여부 체크
	if szTranID == "obcsb_efif_262r" Then
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID" 	, 0 , g_szUserID   ) '고객ID	
		
	'해외주식 실시간 시세 조회(고객)
	elseif szTranID == "obtro_acnt_208r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 				0 , g_szCSNo) '고객번호		
		'조회구분
		if g_szScreenNo == "16095" then
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 	0 , "2") '2 : 해외CFD
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 	0 , "1") '1 : 해외주식
		end if 
		
	'해외주식 실시간 시세 신청가능 계좌 조회
	elseif szTranID == "obtro_acnt_209r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO" , 				0 , g_szCSNo) '고객번호
		'조회구분코드 - 1.해외주식가능계좌, 2. 해외CFD 가능계좌
		if g_szScreenNo == "16095" then 
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 	0 , "2") '해외CFD
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 	0 , cmbExch.cbkeydata )
		else
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE" , 	0 , "1") '해외
		end if
		
	elseif szTranID == "obtro_acnt_201r" then	'신청/해지시 조회			
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ACNO" , 			0 , Left(g_szFullAcnt,8) 	)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "ASNO" , 			0 , MID(g_szFullAcnt, 9,2)  )							
		
		If g_szPlainRm == "1" Then
		    DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD" , 		0 , g_szPasswd)
		Else
		    DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PWD" , 		0 , Form.GetEncData(g_szPasswd))
		End If
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "EMPL_YN"		  , 	0 , "N"					)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "PROS_CLS_CODE" , 	0 , "X") '계좌 비번 없이 조회
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "QTTN_REG_CLCD" , 	0 , "0"					)
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "QTTN_APLT_CLCD" ,	0 , cmbQttn.cbkeydata		)	'시세신청구분코드(1:전문가 2:비전문가)
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr
	szSubErr = DATAMANAGER.GetDataMsgSubText(szTranID)	
	Form.ShowAlert( "알림", szErrMsg.."\n(" .. szTranID .. "  "..szSubErr..")" )	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'법인여부 체크	
	'if szTranID == "obacp_comm_005r" then		
	if szTranID == "obcsb_efif_262r" Then
		g_szCUST_CLS_CODE = DATAMANAGER.GetDataValue( 0, szTranID , "OutBlock1" , "CUST_CLS_CODE" , 0 )	'고객구분코드(2:법인)
		Form.SetSharedData("16090_CUST_CLS_CODE", g_szCUST_CLS_CODE)
		
		'법인(전문가로 셋팅, 비전문가확인 비활성화)
		if g_szCUST_CLS_CODE == "2" then
			cmbQttn.cbkeydata = "1"
			chkAgrm.chksilence = "0"
			chkAgrm.unchkcaption = "전문가확인"
			chkAgrm.chkcaption = "전문가확인"
		else
			cmbQttn.cbkeydata = "2"
			chkAgrm.chksilence = "0"
			chkAgrm.chkcaption = "비전문가확인"
			chkAgrm.unchkcaption = "비전문가확인"
		end if
		Pannel0.rowcount = 0
		DATAMANAGER.RequestTranData("obtro_acnt_208r")
'		if g_szScreenNo == "16095" then 'CFD
'			'CFD의 경우 신청할 국가별 조회가 필요
'		else
'		     DATAMANAGER.RequestTranData("obtro_acnt_209r") '신청버튼클릭시 조회			
'		end if 
		
'해외주식거래신청여부
'SUPER365계좌개설여부

	'해외주식 실시간 시세 조회(고객)
	elseif szTranID == "obtro_acnt_208r" then
		

		Dim nCnt, szOvrsStckMrktTrClsCode, szQttnApltClcd, szRegPrdClcd, szQttnRegClcd, i
		nCnt = DATAMANAGER.GetDataCount( false, szTranID, "OutBlock1" )		
		if nCnt == 0 then
			Pannel0.rowcount = 0
			Exit Sub
		end if 		
		
		Dim szOVRS_QTTN_EXPN, szCRCD, szText, szStaDate, szFinDate, szExmpYN, szAcNo, szAsNo, szPrcd
		Dim sTemp, bUsedCnt
		bUsedCnt = false '신청내역 여부
		
		Pannel0.rowcount = nCnt
		for i = 0 to nCnt - 1 step 1
			'Pannel0.SetPropCardCell( "maintainratio", "imgBG", i, "1" ) '1: 가운데정렬, 2 : 좌측정렬

			'해외주식시장거래구분코드
			szOvrsStckMrktTrClsCode = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , i )
			Pannel0.SetCellValue( "lblExch", i, szOvrsStckMrktTrClsCode)
			'시세등록구분코드 
			szQttnRegClcd           = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "QTTN_REG_CLCD" , i )	
			'등록기간구분코드
			szRegPrdClcd            = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "REG_PRD_CLCD" , i )
			'시세신청구분코드
			szQttnApltClcd          = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "QTTN_APLT_CLCD" , i )
			Pannel0.SetCellValue( "lblQttnApltClcd", i, szQttnApltClcd)
			'면제여부 
			szExmpYN          = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "EXMP_YN" , i )			
			'상품코드 해외CFD '137' 
			szPrcd          = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "PRCD" , i )						
			Pannel0.SetCellValue( "lblPrcd", i, szPrcd)
			
			Select Case szOvrsStckMrktTrClsCode
				Case "01"
					'grdStatus.SetCellData("bd_cell0", i, "미국")
					Pannel0.SetCellValue( "lblName", i, "미국")
					Pannel0.SetCellVisible("imgFlagUS", i, 1) 					
					Pannel0.SetCellVisible("imgFlagHK", i, 0) 					
					Pannel0.SetCellVisible("imgFlagCHN", i, 0)  					
					Pannel0.SetCellVisible("imgFlagJP", i, 0)  					
					Pannel0.SetPropCardCell( "maintainratio", "imgFlagUS", i, "1" )
					Pannel0.SetPropCardCell( "imgpath", "imgFlagUS", i, "flag_us2" )
				Case "02"
					'grdStatus.SetCellData("bd_cell0", i, "홍콩")
					Pannel0.SetCellValue( "lblName", i, "홍콩")
					Pannel0.SetCellVisible("imgFlagUS", i, 0) 					
					Pannel0.SetCellVisible("imgFlagHK", i, 1) 					
					Pannel0.SetCellVisible("imgFlagCHN", i, 0)  					
					Pannel0.SetCellVisible("imgFlagJP", i, 0)  
					Pannel0.SetPropCardCell( "maintainratio", "imgFlagHK", i, "1" )
					Pannel0.SetPropCardCell( "imgpath", "imgFlagHK", i, "flag_hk" )
				Case "03"
					'grdStatus.SetCellData("bd_cell0", i, "상해")
					Pannel0.SetCellValue( "lblName", i, "상해")
					Pannel0.SetCellVisible("imgFlagUS", i, 0) 					
					Pannel0.SetCellVisible("imgFlagHK", i, 0) 					
					Pannel0.SetCellVisible("imgFlagCHN", i, 1)  					
					Pannel0.SetCellVisible("imgFlagJP", i, 0)  					
					Pannel0.SetPropCardCell( "maintainratio", "imgFlagCHN", i, "1" )
					Pannel0.SetPropCardCell( "imgpath", "imgFlagCHN", i, "flag_chn" )
				Case "04"
					'grdStatus.SetCellData("bd_cell0", i, "심천")
					Pannel0.SetCellValue( "lblName", i, "심천")
					Pannel0.SetCellVisible("imgFlagUS", i, 0) 					
					Pannel0.SetCellVisible("imgFlagHK", i, 0) 					
					Pannel0.SetCellVisible("imgFlagCHN", i, 1)  					
					Pannel0.SetCellVisible("imgFlagJP", i, 0)  					
					Pannel0.SetPropCardCell( "maintainratio", "imgFlagCHN", i, "1" )
					Pannel0.SetPropCardCell( "imgpath", "imgFlagCHN", i, "flag_chn" )
				Case "05"
					'grdStatus.SetCellData("bd_cell0", i, "일본")
					Pannel0.SetCellValue( "lblName", i, "일본")
					Pannel0.SetCellVisible("imgFlagUS", i, 0) 					
					Pannel0.SetCellVisible("imgFlagHK", i, 0) 					
					Pannel0.SetCellVisible("imgFlagCHN", i, 0)  					
					Pannel0.SetCellVisible("imgFlagJP", i, 1)  					
					Pannel0.SetPropCardCell( "maintainratio", "imgFlagJP", i, "1" )
					Pannel0.SetPropCardCell( "imgpath", "imgFlagJP", i, "flag_jp2" )
			End Select

'szQttnRegClcd = "0"  'for TEST
'szOvrsStckMrktTrClsCode = "01" '미국 'for TEST
'msgbox szQttnRegClcd
			if szQttnRegClcd == "0" then ' 신청
		
				Pannel0.SetPropCardCell( "height", "imgBG", i, "196" )
				Pannel0.SetCardWHAt( i, 211)
				
				Pannel0.SetCellVisible("lblSub", i, 1) 
				
				'무료대상 X
				Pannel0.SetCellVisible("Image1", i, 0)
				Pannel0.SetCellVisible("Label12", i, 0)					
				
				'신청버튼 X
				Pannel0.SetCellVisible("btnReq", i, 0) 
				
				'이용중 O
				Pannel0.SetCellVisible("Image0", i, 1) 	
				'Pannel0.SetPropCardCell( "maintainratio", "Image0", i, "1" )

				Pannel0.SetCellVisible("Label11", i, 1) 	
				bUsedCnt = true
				
				'신청기간
				'20240628 날짜는 년월까지만 표기
				sTemp = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "STA_DATE" , i ) '시작일
				szStaDate = Left(sTemp, 4) & "." & Mid(sTemp, 5, 2) 
				sTemp = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "FIN_DATE" , i ) '종료일 
				szFinDate = Left(sTemp, 4) & "." & Mid(sTemp, 5, 2)				
				Select Case szRegPrdClcd
					Case "1"
						'grdStatus.SetCellData("bd_cell10", i, "자동연장")
						Pannel0.SetCellValue( "lblDate", i, szStaDate &" ~ " & "자동연장")
					Case "2"
						'grdStatus.SetCellData("bd_cell10", i, "기간선택")
						Pannel0.SetCellValue( "lblDate", i, szStaDate &" ~ " & szFinDate)
					Case "3"
						'grdStatus.SetCellData("bd_cell10", i, "당월")		
						Pannel0.SetCellValue( "lblDate", i, szStaDate &" ~ " & szFinDate)
					Case ""
						'grdStatus.SetCellData("bd_cell10", i, "")	
						Pannel0.SetCellValue( "lblDate", i, "")
				End Select
				
'szExmpYN	= "Y" 'for TEST
'msgbox szExmpYN
				'월이용료
				if szExmpYN == "Y" then
					Pannel0.SetCellValue( "lblFee", i, "무료")
					'Pannel0.SetPropCardCell( "left", "lblFee", i, "126" )
					if szOvrsStckMrktTrClsCode == "01" and g_szScreenNo == "16090"  then '미국이고 해외CFD가 아닌 경우만 이미지 표기
						'물음표버튼 O
						Pannel0.SetCellVisible("imgQuestion", i, 1) 
						Pannel0.SetPropCardCell( "maintainratio", "imgQuestion", i, "1" )
						Pannel0.SetPropCardCell( "imgpath", "imgQuestion", i, "icon_question" )
					else
						Pannel0.SetCellVisible("imgQuestion", i, 0) 					
					end if 
				else
					'211229 아이티젠 김성수 UI변경으로 인한 추가 START
					szOVRS_QTTN_EXPN		= CInt(DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "OVRS_QTTN_EXPN" , i ))
					szCRCD				= DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "CRCD" , i )
					szText				= ""
					if szOVRS_QTTN_EXPN <> "" and szOVRS_QTTN_EXPN <> null 
						and szCRCD <> "" and szCRCD <> null then
						
						'szText = "월 " & szOVRS_QTTN_EXPN & " " & szCRCD
						szText = szOVRS_QTTN_EXPN & " " & szCRCD
						
						'grdStatus.SetCellData("bd_cell4", i, szText)
						Pannel0.SetCellValue( "lblFee", i, szText)
					end if
					Pannel0.SetPropCardCell( "left", "lblFee", i, "148" )
					'211229 아이티젠 김성수 UI변경으로 인한 추가 END						
					
					'물음표버튼 X
					Pannel0.SetCellVisible("imgQuestion", i, 0)
				end if 
				
				'결제계좌
				szAcNo = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "ACNO" , i )
				szAsNo = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "ASNO" , i )
				'Pannel0.SetCellValue( "lblAccount", i, Left(szAcNo, 4) & "-" & Mid(szAcNo, 5, Len(szAcNo))  & "-" & szAsNo)
				Pannel0.SetCellValue( "lblAccount", i, Left(szAcNo, 4) & Mid(szAcNo, 5, Len(szAcNo)) & szAsNo)

			else'if szQttnRegClcd == "1" then '미신청
				
				Pannel0.SetPropCardCell( "height", "imgBG", i, "60" )
				Pannel0.SetCardWHAt( i, 75)
				Pannel0.SetCellVisible("lblSub", i, 0) 
				
'szExmpYN= "Y"	'for TEST			
				'무료대상 
				if szExmpYN == "Y" and g_szScreenNo == "16090" then '무료대상이고 해외CFD가 아닌 경우만 이미지 표기				
					Pannel0.SetCellVisible("Image1", i, 1) 
'					Pannel0.SetPropCardCell( "maintainratio", "Image1", i, "1" )					
					Pannel0.SetCellVisible("Label12", i, 1) 	
				else					
					'X
					Pannel0.SetCellVisible("Image1", i, 0) 
					Pannel0.SetCellVisible("Label12", i, 0) 					
				end if 
				
				'신청버튼 O
				Pannel0.SetCellVisible("btnReq", i, 1) 
				'물음표버튼 X
				'Pannel0.SetCellVisible("visible", "imgQuestion", i, "false") 					
				
				'이용중 X
				Pannel0.SetCellVisible("Image0", i, 0) 	
				Pannel0.SetCellVisible("Label11", i, 0) 					
			end if 
		next
		
		Pannel0.addfooter = "nrsbtro16090_p0.xmf"
		
		if g_szScreenNo == "16095" then 'CFD"
			'해외CFD이고 신청내역이 없는 경우 알림팝업
			if (g_szScreenNo == "16095") and (bUsedCnt == false) and (g_szDisplayMsgForCFD == true) then
				g_szDisplayMsgForCFD = false
				g_szOKType = "8" 
				Form.OpenPopup("nrsbtro16090_p7", g_szOKType, "5")
				Exit Sub
			end if 		
		
			'환전이후1 
			SetExchangeNext1()
		else
		     DATAMANAGER.RequestTranData("obtro_acnt_209r") '신청버튼클릭시 조회			
		end if 		
		
		
	elseif szTranID == "obtro_acnt_209r" then
		Dim nCnt, sAcno, sAsno
		'결제 가능계좌 넣기			
		CmbAcnt.clear = 0 '초기화
		nCnt = DATAMANAGER.GetDataCount( false, szTranID, "OutBlock1" )		
		for i = 0 to nCnt - 1 step 1
			sAcno = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "ACNO" , i ) 
			sAsno = DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "ASNO" , i ) 
			if (sAcno <> "" and sAsno <> "") then
				CmbAcnt.cbadddatatext = sAcno..sAsno.."`"..Left(sAcno, 4) .. "-".. Right(sAcno, 4) .. "-".. sAsno
			end if 
		next 
'nCnt = 1 for TEST		
		'결제계좌 갯수에 따라 
		if nCnt > 1 then
			CmbAcnt.currentindex = 0
			Container1.Acnt.caption = CmbAcnt.caption
			Container1.ImgDown.visible = true
			Container1.Acnt.left = 192
		elseif nCnt == 1 then
			Container1.Acnt.caption = CmbAcnt.caption
			Container1.ImgDown.visible = false
			Container1.Acnt.left = 212
		else
			Container1.Acnt.caption = ""
			Container1.ImgDown.visible = false
		end if 

		if (g_szScreenNo == "16095") then 'CFD
			SetDataforReq()
		else
			'환전이후1 
			SetExchangeNext1()
		end if 

	elseif szTranID == "obtro_acnt_201a" then
		if g_szCode == "Y" then
'g_szConfirmMsg = "16090" & "★" & "미국" & "★" & "24.02.09 ~ 자동연장" & "★" &  "5 USD"& "★" & "1234567890"& "★" & "실시간 시세 신청이\n완료되었습니다."
			'화면번호
			g_szConfirmMsg = "16090" & "★" & g_szConfirmMsg
			'메시지 
			g_szConfirmMsg = g_szConfirmMsg& "★" & "실시간 시세 신청이\n완료되었습니다." 	
			Form.OpenPopup("nrsbtro16090_p4" , g_szConfirmMsg, "")
		elseif g_szCode == "N" then
			if g_szMoveScreen <> "" then
				if  g_szMoveScreen == "16095" then '해외CFD
					g_szOKType = "10" 
				else
					g_szOKType = "11" 
				end if 
				Form.OpenPopup("nrsbtro16090_p7", g_szOKType, "5")				
			else			
				Form.ShowAlert("알림", "해지 신청이 완료되었습니다.")
			end if 
		end if 
		
		'210607 LYI 시세조회및요청
		Form.requestOvStRealSise()		
		
		'이전
		Container1_btnBefore_OnClick()		
		
		'CFD관련 메시지 표기되지 않도록 설정
		g_szDisplayMsgForCFD = false
		
		Pannel0.rowcount = 0 '초기화
		DATAMANAGER.RequestTranData("obtro_acnt_208r")	
		
	elseif szTranID == "obrtd_fcur_008r" then ' 외화잔액 단건조회
		Dim szAmt, szFee
		szAmt = CDbl(DATAMANAGER.GetDataValue( false, szTranID, "OutBlock1", "UI_FRCR_WTMN_ABLE_AMT" , 0 )) & ""
		szFee = Trim(Container1.Table0.GetCellString(1, 2))
		szFee = Trim(Replace(szFee, "월", ""))
		szFee = Trim(left(szFee, Len(szFee)-3)) ' 수수료		
'szAmt = "0" ' for TEST
'msgbox szFee
		'무료가 아니고 수수료>외화잔고 인 경우  
		if (Container1.Table0.GetCellString(1, 2) <> "무료") 
		   and (CDbl(szFee) > CDbl(szAmt)) then 
			Container1.Label15.visible = true
			Container1.Label17.visible = true
			Container1.btnNext.enable = false '다음		
		else
			Container1.Label15.visible = false
			Container1.Label17.visible = false
			
			if CInt(Container1.RgStyle.currentindex) == 2 then '기간선택			
				if CInt(Container1.cldFromDate.caption) > CInt(Container1.cldToDate.caption ) then
					Form.ShowAlert("알림", "종료일이 시작일 이전입니다.")	
					Container1.btnNext.enable = false
				else
					Container1.btnNext.enable = true '다음
				end if 			
			else
				Container1.btnNext.enable = true '다음	
			end if 
			
		end if 
		
		Container1.Table1.SetCellMaskInfo(2, 2, "0,0,, " & DATAMANAGER.GetDataValue( false, szTranID, "InBlock1", "CRCD" , 0 ) & ",0,,2,1,0,0,0")
		Container1.Table1.SetCellString(2, 2, szAmt) '외화잔고
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

	if sKeyName == "mbtro16090_p1_RETURN" then
		g_szAgree = "Y"	'이용약관 동의여부
		g_szAgrm_yn = "Y"	'비전문가 동의여부	
		
		'고객정보 확인 및 수정 후 등록
		g_szOlnyCustEdit = "N"
		Form.OpenPopup("nrsbtro16090_p2" , "", "")
	
	'실시간시세 신청
	elseif sKeyName == "REG_SET" then 
		if sRet <> "CANCEL" then
			g_szCode = "Y"
			Form.openPopupAnimation("pwdcheckpopup", Left(Container1.Acnt.caption, 4)& Mid(Container1.Acnt.caption, 6, 4) & Right(Container1.Acnt.caption, 2) & "☆0" ,"","2")
		end if 	
		
	'계좌비번 수신
	elseif sKeyName == "CORRECT_PWD" then
		if sRet <> "" then
			Dim tData
			tData = Split(sRet, "★")
			
			if UBOUND(tData) > 0 then
				Container1.edtPwd.pwdlen = tData(1)
				Container1.edtPwd.caption = tData(0)
				
				g_szPasswd 	= Container1.edtPwd.caption
				
				If g_szPlainRm == "1" Then
				    DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "PWD" , 0 , g_szPasswd)
				Else
				    DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "PWD" , 0 , Form.GetEncData(g_szPasswd))
				End If				
				DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "EMPL_YN"	 , 0 , "N")
				if g_szCode == "Y" then '등록						
					
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "QTTN_REG_CLCD" , 0 , "0") '신청
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ACNO"		  , 0 , Left(Container1.Acnt.caption, 4)..Mid(Container1.Acnt.caption, 6, 4))
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ASNO"		  , 0 , Right(Container1.Acnt.caption, 2)) 							
					'DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "EMPNO"	       , 0 , "")  
					
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , cmbExch.cbkeydata	)
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "QTTN_APLT_CLCD" 			 , 0 , cmbQttn.cbkeydata	)
					if cmbQttn.cbkeydata == "2" then
						DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "AGRM_YN" , 0 , g_szAgrm_yn)
					end if
					if g_szScreenNo == "16095" then
						g_gzRgStyle = CStr(Container1.RgStyleCFD.currentindex + 1)
					else
						g_gzRgStyle = CStr(Container1.RgStyle.currentindex + 1)
					end if 	
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "REG_PRD_CLCD" 			 , 0 , g_gzRgStyle)
					
					'자동연장이면
					if g_gzRgStyle == "1" then
						DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "FIN_DATE" 			 , 0 , "99991231")
					else
						DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "FIN_DATE" 			 , 0 , Container1.cldToDate.caption		)
					end if 
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "STA_DATE" 			 	 , 0 , Container1.cldFromDate.caption	)
					
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "CUST_ENG_NAME" 			 , 0 , g_szEngName		)
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ENG_ADDR" 			 	 , 0 , g_szEngAddress		)	
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ENG_OCPT_NAME" 		 	 , 0 , g_szEngOcptName		)
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ENG_CO_NAME" 		 	 , 0 , g_szEngCoName		)
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ENG_CO_ADDR" 		 	 , 0 , g_szEngCoAddr		)
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "CLPS_NAME" 			 	 , 0 , g_szEngClpsName		)
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "RSNS_BSWR_NAME"		 	 , 0 , g_szEngRsnsBswrName	)	
				
				else '해지
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "QTTN_REG_CLCD" , 0 , "1") '해지 
					 
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ACNO"		  , 0 , Left(g_szAcntNo, 8))
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "ASNO"		  , 0 , Right(g_szAcntNo, 2))  
					'DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "EMPNO"	       , 0 , "")  					
					
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE" , 0 , g_szOvrsStckMrktTrClsCode	)
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "QTTN_APLT_CLCD" 			 , 0 , g_szQttnApltClcd			)	
					' 비전문가 확인 상태를 Y값으로 고정
					DATAMANAGER.SetDataValue(0, "obtro_acnt_201a", "InBlock1", "AGRM_YN" , 0 , "Y")
					
				end if 
				DATAMANAGER.RequestTranData("obtro_acnt_201a")
			end if			
		else
			'취소
			g_szPasswd = ""
			Container1.edtPwd.caption = ""		
		end if 
		
	'1.계좌가 없는 경우 비대면계좌개설	
	elseif sKeyName == "INFO_POPUP1" then 
	
		if sRet <> "CANCEL" then
			Dim sloginType
			sloginType = Form.GetSharedData( "&LOGIN_TYPE", false )
			
			if Cint(sloginType) > 1 then
				sText = "로그아웃이 필요한 메뉴입니다. 로그아웃하시겠습니까?"
				Form.MsgBox("알림",sText, "LOGOUT_MSG" , 1 )
			else
				Form.SetSharedData("&SCREEN_AUTH" , "99")
				Form.OpenPopup("mbbdm85100", "", "")
			end if				
		end if 
		
	'2.계좌는 있고 해외주식거래신청이 없는 경우
	elseif sKeyName == "INFO_POPUP2" then 
		if sRet <> "CANCEL" then
			Form.OpenScreen("87051" , "")  '해외주식거래신청
			'Form.CloseForm()
		end if 
		
	'실시간시세 해지
	elseif sKeyName == "INFO_POPUP3" then 
		
		if sRet <> "CANCEL" then
			g_szCode = "N"
			Form.openPopupAnimation("pwdcheckpopup",g_szAcntNo & "☆0" ,"","2")
		end if 			
		
	'6.CFD계좌가 없는 경우 비대면계좌개설	
	elseif sKeyName == "INFO_POPUP6" then 
		if sRet <> "CANCEL" then
			Dim sloginType
			sloginType = Form.GetSharedData( "&LOGIN_TYPE", false )
			
			if Cint(sloginType) > 1 then
				sText = "로그아웃이 필요한 메뉴입니다. 로그아웃하시겠습니까?"
				Form.MsgBox("알림",sText, "LOGOUT_MSG" , 1 )
			else
				Form.SetSharedData("&SCREEN_AUTH" , "99")
				Form.OpenPopup("mbbdm85100", "", "")
			end if	
		end if 
	
	'7.CFD계좌 있고 해외주식거래신청이 없는 경우 해외주식거래신청
	elseif sKeyName == "INFO_POPUP7" then 
		if sRet <> "CANCEL" then
			Form.OpenScreen("87051" , "")  '해외주식거래신청
			'Form.CloseForm()
		end if 
	
	elseif sKeyName == "INFO_POPUP9" then 
		if sRet = "OK" then
			g_szRgStyleNoClick = true
			Container1.RgStyle.currentindex = 0
			Container1.RgStyleCFD.currentindex = 0
		end if 
	
	'고객정보	
	elseif sKeyName == "INFO_RETURN" then
		if sRet <> "" then
			if g_szOlnyCustEdit == "Y" then
				'고객정보 변경 버튼 클릭 후, 
				'고객정보만 변경
				g_szOlnyCustEdit = "N"
				Exit Sub
			end if 
		
			Dim szSplitData			
			szSplitData = Split(sRet, "★")					
			g_szEngName 			= szSplitData[0]
			g_szEngAddress 		= szSplitData[1]			
			g_szEngOcptName 		= szSplitData[2]
			g_szEngCoName 		= szSplitData[3]
			g_szEngCoAddr 		= szSplitData[4]
			g_szEngClpsName 		= szSplitData[5]
			g_szEngRsnsBswrName 	= szSplitData[6]
			
			chkUserInfo.chksilence = "1"
						
			'신청확인
			'시장★신청타입★신청기간★월사용료★결제계좌
			g_szConfirmMsg = Container1.Table0.GetCellString(1, 1) 
			Dim sTemp, szStaDate, szFinDate, szStaDate2
			
			'20240628 날짜는 년월까지만 표기
			'신청기간 시작일
			szStaDate2 = Left(cldToday.caption, 4) & "." & Mid(cldToday.caption, 5, 2)
			szStaDate = Left(Container1.cldFromDate.caption, 4) & "." & Mid(Container1.cldFromDate.caption, 5, 2) 
			'신청기간 종료일 
			szFinDate = Left(Container1.cldToDate.caption, 4) & "." & Mid(Container1.cldToDate.caption, 5, 2)			
			
			if g_szScreenNo == "16095" then
				g_szConfirmMsg = g_szConfirmMsg & "★" & szStaDate2 &" ~ " & "자동연장"
			else	
				Select Case CInt(Container1.RgStyle.currentindex)
					Case 0   '자동연장
						sTemp = szStaDate2 &" ~ " & "자동연장"
					Case 1   '당월
						sTemp = szStaDate2 &" ~ " & szFinDate
					Case 2   '기간선택
						sTemp = szStaDate &" ~ " & szFinDate
				End Select
				g_szConfirmMsg = g_szConfirmMsg & "★" & sTemp
			end if

			'수수료
			g_szConfirmMsg = g_szConfirmMsg & "★" &  Container1.Table0.GetCellString(1, 2)
			'결제계좌
			g_szConfirmMsg = g_szConfirmMsg & "★" &  Container1.Acnt.caption
				
			Form.OpenPopupAnimation("nrsbtro16090_p3" , g_szConfirmMsg , "", "2")
		end if
		
	'CFD 실시간 시세신청한 고객이 해외주식 실시간 시세 신청 화면에서 해지하는 경우 실시신시세신청 CFD의 신청내역 탭으로 이동 
	elseif sKeyName == "INFO_POPUP10" then 
		Form.CloseForm()
		Form.OpenScreen(g_szMoveScreen, "1") '16095 신청내역탭 이동
		
	'해외주식 실시간 시세신청한 고객이 해외CFD 실시간 시세 신청 화면에서 해지하는 경우 실시신시세신청의 신청내역 탭으로 이동  
	elseif sKeyName == "INFO_POPUP11" then 
		Form.CloseForm()
		Form.OpenScreen(g_szMoveScreen, "1") '16090 신청내역탭 이동
		
	'CFD계좌 보유 고객이 해외주식 실시간 시세 신청에서 신청하는 경우   
	elseif sKeyName == "INFO_POPUP12" then 
		if sRet <> "CANCEL" then
			Form.CloseForm()
			Form.OpenScreen("16095", "") 'CFD 실시간 시세 신청
		end if 
		
	'개인(신용)정보 동의 체크
	elseif sKeyName == "ALL_YN" then
		if sRet <> "" then
			g_szAllYn = sRet
			
			'전체동의가 Y이면, 개인신용정보동의 체크처리
			if g_szAllYn == "Y" Then
				chkAgree.chksilence = "1"
			end If
		end if

	'비전문가 확인팝업 RETURN
	elseif sKeyName == "mbtro16090_p5_RETURN" then
		g_szAgrm_yn = sRet
		
		chkAgrm.chksilence = "1"

	'전문가 확인팝업 RETURN
	elseif sKeyName == "mbtro16090_p8_RETURN" then
		g_szAgrm_yn = sRet
		
		chkAgrm.chksilence = "1"
		
	END if
End Sub


'============================================================================
Sub Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "LOGOUT_MSG" then
		if sRet == "ok" then
			'1parm (0.문구없음 1.문구있음)
			'2parm (0.권한상관없이 로그아웃만 함 1.화면권한에 따라 닫을 화면 로그아웃)
			Form.LogOut(0,1)
			Form.SetSharedData("&SCREEN_AUTH" , "99")
			Form.OpenPopup("mbbdm85100", "", "")  '비대면계좌개설
		end if
	end if	
End Sub

'============================================================================
' 등록버튼 활성화 체크
'============================================================================
Sub f_RegistCheck()
	'비밀번호 체크
	if Container1.edtPwd.caption == nil or Container1.edtPwd.caption == "" then
		Form.ShowAlert("알림", "비밀번호를 확인해 주세요.")
		return false
	end if
	
	'이용약관 체크
	if chkTerms.checkstate ~= "1" then
		Form.ShowAlert("알림", "이용약관을 확인해 주세요.")
		return false
	end if
	
	'비전문가인 경우에만 체크
	if cmbQttn.cbkeydata == "2" then
		'비전문가확인 체크
		if chkAgrm.checkstate ~= "1" then
			Form.ShowAlert("알림", "비전문가확인을 확인해 주세요.")
			return false
		end if
	else
		'전문가확인 체크
		if chkAgrm.checkstate ~= "1" then
			Form.ShowAlert("알림", "전문가확인을 확인해 주세요.")
			return false
		end if
	end if
	
	'신청자정보입력 체크
	if chkUserInfo.checkstate ~= "1" then
		Form.ShowAlert("알림", "신청자정보입력을 확인해 주세요.")
		return false
	end if
	
	'개인(신용)정보 동의 체크
	if ChkAgree.checkstate ~= "1" then
		Form.ShowAlert("알림", "개인(신용)정보 동의를 확인해 주세요.")
		return false
	end if
	
	return true
End Sub

'============================================================================
' 이용약관 체크
'============================================================================
Sub chkTerms_OnChange(sCheckState)
	if sCheckState == "1" then
		Form.OpenFramePopup("mbtro16090_p1", g_szCUST_CLS_CODE , "")
		
'		g_szAgree = "Y"
		
		chkTerms.chksilence = "0"
	end if
End Sub

'============================================================================
' 비전문가확인 체크
'============================================================================
Sub chkAgrm_OnChange(sCheckState)
	if sCheckState == "1" then
		'법인(전문가)
		if g_szCUST_CLS_CODE == "2" then
			Form.OpenFramePopup("mbtro16090_p8", "" , "")
		else
			Form.OpenFramePopup("mbtro16090_p5", "" , "")
		end if
		
		chkAgrm.chksilence = "0"
	end if
End Sub

'============================================================================
' 신청자정보입력 체크
'============================================================================
Sub chkUserInfo_OnChange(sCheckState)
	if sCheckState == "1" then
		Dim szSendData
		szSendData = g_szEngName & "★" & g_szEngAddress & "★" & g_szEngOcptName & "★" & g_szEngCoName & "★" & g_szEngCoAddr & "★" & g_szEngClpsName & "★" & g_szEngRsnsBswrName
		
		Form.OpenFramePopup("mbtro16090_p2" , szSendData , "")
		
		chkUserInfo.chksilence = "0"
	end if
End Sub

'============================================================================
' 개인(신용)정보 동의 체크
'============================================================================
Sub chkAgree_OnChange(sCheckState)
	if sCheckState == "1" then
		'내용 팝업
		Dim sURL 
		sURL = "https://home.imeritz.com/include/resource/comm/ctcn/pdf/crinoferagrm6.pdf"
		
		acno = Form.GetCtlProp("#acnt01", "caption")
		
		Form.SetSharedData("ACNO"  , acno )	'계좌번호
		Form.SetSharedData("EMPLYN", "N"  )	'직원여부
		Form.SetSharedData("OPEN_URL"  , sURL )	'PDF링크
		
		Form.OpenFramePopup("mbtro16090_p6" , "해외주식 개인정보처리 요약동의서" , "")
		
		chkAgree.chksilence = "0"
	end if
End Sub

