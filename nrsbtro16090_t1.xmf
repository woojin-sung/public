'============================================================================
Sub CmbAcnt_OnEditComplete(iIndex)
'msgbox g_nSelectRow ' for TEST
'msgbox grdStatus.GetCellData("bd_crcd", g_nSelectRow) ' for TEST
	Container1.Acnt.caption = CmbAcnt.caption
	'외화 특정통화 잔액 조회
	DATAMANAGER.SetDataValue(0,"obrtd_fcur_008r", "InBlock1", "ACNO" , 	 0 , Left(CmbAcnt.caption, 4) .. Mid(CmbAcnt.caption, 6, 4) )'계좌번호
	DATAMANAGER.SetDataValue(0, "obrtd_fcur_008r", "InBlock1", "ASNO" , 	 0 , Right(CmbAcnt.caption, 2) )	'계좌일련번호
	DATAMANAGER.SetDataValue(0, "obrtd_fcur_008r" , "InBlock1" , "CRCD" , 0 , grdStatus.GetCellData("bd_crcd", g_nSelectRow)  )
	DATAMANAGER.RequestTranData("obrtd_fcur_008r") 
End Sub

'============================================================================
function SetDataforReq()	
	g_szOKType = edtStatClsCode.caption	
'g_szCUST_CLS_CODE = "2" ' for TEST
'g_szOKType = "0" ' for TEST
	'해외주식거래신청X, SUPER365 계좌개설X, 금융상품전용계좌만 존재
	if g_szOKType <> "0" then
         '---------------------------------------------------------------
		'1:SUPER365 계좌개설X, 2:해외주식거래신청(87051)X  for 해외주식
		'6:해외CDF계좌개설X, 7: 해외CFD주식거래신청(87051)X for 해외CFD
		'3:금융상품전용계좌만 존재
		'8:해외CDF계좌O, 실시간시세 신청가능계좌X (CFD계좌 보유 고객이 해외주식 실시간 시세 신청에서 신청하는 경우)
		'  화면에서는 12로 변경해 사용함, 개인,법인 구분없음	     
		'---------------------------------------------------------------
		'개인,법인- 3 : 금융상품전용계좌만 존재
		if g_szOKType == "3" then 
			Form.ShowAlert("알림", "외화금융상품거래 신청 후 이용가능합니다.\n영업점 또는 HTS에서 신청 후 이용해주세요.")
			Exit function
		end if 
		
		if g_szOKType == "8" then 
			'개인,법인 구분없음
			'해외CDF계좌O, 실시간시세 신청가능계좌X (CFD계좌 보유 고객이 해외주식 실시간 시세 신청에서 신청하는 경우)
			g_szOKType = "12"
			Form.OpenPopup("nrsbtro16090_p7", g_szOKType, "5")
		else
			'법인		
			if g_szCUST_CLS_CODE == "2" or edtCustClsCode.caption == "2" then
				'1:SUPER365 계좌개설X
				if g_szOKType == "1"then
					Form.ShowAlert("알림", "실시간 시세 신청 가능한 계좌가 없습니다.\n영업점에서 계좌개설 후 이용해주세요.")
				'2:해외주식거래신청X
				elseif g_szOKType == "2" then
					Form.ShowAlert("알림", "해외주식거래 신청 후 이용 가능합니다.\n영업점에서 신청 후 이용해주세요.")
					
				elseif g_szOKType == "6" then
					Form.ShowAlert("알림", "실시간 신청 가능한 계좌가 없습니다.\n영업점에서 계좌개설 후 이용해주세요.")
	'			elseif g_szOKType == "7" then
	'				Form.ShowAlert("알림", "해외CFD 주식거래 신청 후\n이용 가능합니다.\n영업점에서 신청 후 이용해주세요.")
				end if
				
			'개인
			else
				if g_szOKType == "1" or g_szOKType == "2" or g_szOKType == "6" or g_szOKType == "7" then
					Form.SetSharedData("16090_MRKT_NM", Pannel0.GetCellValue("lblName", g_nSelectRow))
					Form.OpenPopup("nrsbtro16090_p7", g_szOKType, "5")
				end if 
			end if 
		end if 		
	else		
		'해외주식거래신청O, SUPER365 계좌개설O
		Container1.left = 0
		'imgTitle2.left = 506
		imgTip.left  = 509
		lblTitle2.left  = 550
		Pannel0.left = 500
		
		Form.SetSharedData("nrsbtro16090_ScrNo", "2") 
		
		cmbExch.cbkeydata = Pannel0.GetCellValue("lblExch", g_nSelectRow)			
		g_szOvrsStckMrktTrClsCode  = Pannel0.GetCellValue("lblExch", g_nSelectRow)	
		g_szQttnApltClcd  = Pannel0.GetCellValue("lblQttnApltClcd", g_nSelectRow)						
		
		Container1.Table0.SetCellString(1, 1, Pannel0.GetCellValue("lblName", g_nSelectRow))
		Dim sTemp
		if grdStatus.GetCellData("bd_exmpyn", g_nSelectRow) == "Y" then '무료여부
			sTemp = "무료"
		else
			sTemp = "월 " & CDbl(grdStatus.GetCellData("bd_qttnexpn", g_nSelectRow)) & " " & grdStatus.GetCellData("bd_crcd", g_nSelectRow) '해외시세비용
		end if 
		Container1.Table0.SetCellString(1, 2, sTemp) '통화코드
		'환전이후2 
		SetExchangeNext2()
		
		if (Container1.Acnt.caption) <> "" then
			'외화 특정통화 잔액 조회
			'DATAMANAGER.SetDataValue(0,"obrtd_fcur_008r", "InBlock1", "ACNO" , 	 0 , Left(Container1.Acnt.caption ,8) )		'계좌번호
			DATAMANAGER.SetDataValue(0,"obrtd_fcur_008r", "InBlock1", "ACNO" , 	 0 , Left(Container1.Acnt.caption ,4) .. Mid(Container1.Acnt.caption ,6, 4) )		'계좌번호
			DATAMANAGER.SetDataValue(0, "obrtd_fcur_008r", "InBlock1", "ASNO" , 	 0 , Right(Container1.Acnt.caption,2) )	'계좌일련번호
			DATAMANAGER.SetDataValue(0, "obrtd_fcur_008r" , "InBlock1" , "CRCD" , 0 , grdStatus.GetCellData("bd_crcd", g_nSelectRow)  )
			DATAMANAGER.RequestTranData("obrtd_fcur_008r") 
		else
			Container1.Label15.visible = true
			Container1.Label17.visible = true
			Container1.btnNext.enable = false '다음			
		end if 
	end if
end function

'============================================================================
Sub Pannel0_OnClick(nIndex, sCellID)
	g_nSelectRow = nIndex

	if sCellID == "btnReq" then '신청	
		if g_szScreenNo == "16095" then '해외CFD		
			cmbExch.cbkeydata = Pannel0.GetCellValue("lblExch", nIndex)	
			DATAMANAGER.RequestTranData("obtro_acnt_209r")
		else
			SetDataforReq() '신청		
		end if 
		
	elseif sCellID == "btnCancel" then '해지
		'16095: CFD 실시간 시세신청한 고객이 해외주식 실시간 시세 신청 화면에서 해지하는 경우 
		'16090: 해외주식 실시간 시세신청한 고객이 해외CFD 실시간 시세 신청 화면에서 해지하는 경우 	
		if g_szScreenNo == "16095" then '해외CFD 
			if Pannel0.GetCellValue("lblPrcd", nIndex) == "137" then '해외CFD
				g_szMoveScreen =  ""
			else
				g_szMoveScreen =  "16090"
			end if 	
		else
			if Pannel0.GetCellValue("lblPrcd", nIndex) == "137" then '해외CFD
				g_szMoveScreen =  "16095"
			else
				g_szMoveScreen =  ""
			end if 
		end if 
		
		cmbExch.cbkeydata = Pannel0.GetCellValue("lblExch", nIndex)			
		g_szOvrsStckMrktTrClsCode  = Pannel0.GetCellValue("lblExch", nIndex)			
		g_szQttnApltClcd  = Pannel0.GetCellValue("lblQttnApltClcd", nIndex)			
		g_szAcntNo = Replace(Pannel0.GetCellValue("lblAccount", nIndex), "-", "") '결제계좌 
		'해지
		g_szOKType = "3"		
		Form.OpenPopup("nrsbtro16090_p7", g_szOKType, "5")

	elseif sCellID == "btnEdit" then '고객정보 변경
		'고객정보만 수정
		g_szOlnyCustEdit = "Y"
		g_szAcntNo = Replace(Pannel0.GetCellValue("lblAccount", nIndex), "-", "") '결제계좌 
		Form.OpenPopup("nrsbtro16090_p2" , "Y★"& g_szAcntNo, "")
		
	'미국주식 실시간 시세 무료지원 안내		
	elseif sCellID == "imgQuestion" or (sCellID == "Label8" and Pannel0.GetCellValue("lblName",nIndex) == "미국" ) then 
		Form.OpenPopupAnimation("nrsbtro16090_p12" , "" , "", "2")		
	end if 
End Sub

'============================================================================
Sub Container1_RgStyle_OnClick(nIndex)

	Container1.cldFromDate.caption = cldToday.caption
	Container1.cldToDate.caption = cldToday.caption
	
	if nIndex == 2 then '기간선택
		Container1.lbInfoMsg.visible = false
		Container1.cldFromDate.visible = true
		Container1.Label10.visible = true
		Container1.cldToDate.visible = true
	elseif nIndex == 1 then '당월
		Container1.cldFromDate.visible = false
		Container1.Label10.visible = false
		Container1.cldToDate.visible = false	
		'Container1.lbInfoMsg.caption = "N월 말일까지 실시간 시세를 조회할 수 있어요."
		Container1.lbInfoMsg.caption = CInt(Mid(cldToday.caption, 5, 2)) .."월 말일까지 실시간 시세를 조회할 수 있어요."
		Container1.lbInfoMsg.visible = true
	else '자동연장
		Container1.cldFromDate.visible = false
		Container1.Label10.visible = false
		Container1.cldToDate.visible = false		
		Container1.lbInfoMsg.caption = "이용 기간은 1개월 단위로 자동연장 됩니다."
		Container1.lbInfoMsg.visible = true
	end if 
	
	SetEnalbeNext() '다음버튼 활성화여부 
	g_szRgStyleNoClick = false
	
End Sub

