Sub Container1_Label17_OnClick()
'g_szOpenData = "환전완료`USD`16090`3008432104`미국`0" 'for TEST
'g_szOpenData = "환전완료`CNY`16095`3008432104`상해`1" 'for TEST
	Form.OpenScreen("65000" , "매수통화`"..grdStatus.GetCellData("bd_crcd", g_nSelectRow).."`"..g_szScreenNo.."`"..Replace(Container1.Acnt.caption, "-", "").."`"..Pannel0.GetCellValue("lblName", g_nSelectRow).."`"..g_gzRgStyle)
End Sub

