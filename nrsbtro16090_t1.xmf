Sub Container1_btnBefore_OnClick()
	Container1.left = 500			
	imgTip.left  = 9
	lblTitle2.left  = 0
	Pannel0.left = 0
	
	g_nSelectRow = 0	
	
	Container1.RgStyle.currentindex = 0
	Container1.RgStyle.RgStyleCFD = 0
	Container1.btnNext.enable = false
	
	Form.SetSharedData("nrsbtro16090_ScrNo", "1")
	
	'Pannel0.rowcount = 0 '초기화
	'DATAMANAGER.RequestTranData("obcsb_efif_262r")
End Sub

