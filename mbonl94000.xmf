'--===========================================================================

''****************************************************************************
''               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
''****************************************************************************

'============================================================================
' Tab0_page01_Container0_contNoti1_btnAlpha_OnClick() : 안내 사항 접기/열기
'============================================================================
Sub Tab0_page01_Container0_contNoti1_btnAlpha1_OnClick()
	if tonumber(Tab0.page01.Container0.contNoti1.chkArrow1.checkstate) == 1 then
		Tab0.page01.Container0.contNoti1.chkArrow1.checkstate = 0

		Tab0.page01.Container0.lblScrollPos1.top = 380
		Tab0.page01.Container0.contNoti1.setHeightResize(40)
		Tab0.page01.Container0.contNoti1.height = 40 '늘어난 뒤에 줄이는거는 제대로 적용 안되는듯, 그래서 height로 아예 설정 (AND 확인)
		
		Tab0.page01.Container0.SetScrollAutoSize()
		Tab0.page01.Container0.scroll_pos = 0
		
	else
		Tab0.page01.Container0.contNoti1.chkArrow1.checkstate = 1

		Tab0.page01.Container0.lblScrollPos1.top = 380 + 40 + 248 '안내박스 탑 + 안내 접/닫 문구 + 테이블 높이
		Tab0.page01.Container0.contNoti1.setHeightResize(248)

		Tab0.page01.Container0.SetScrollAutoSize()
		Tab0.page01.Container0.scroll_pos = 248
	end if
End Sub

'============================================================================
