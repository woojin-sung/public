		Tab0.page02.Container2.SetScrollAutoSize()
		Tab0.page02.Container2.scroll_pos = 0
		
	else
		Tab0.page02.Container2.contNoti2.chkArrow2.checkstate = 1

		Tab0.page02.Container2.lblScrollPos2.top = 380 + 40 + 202 '안내박스 탑 + 안내 접/닫 문구 + 테이블 높이
		Tab0.page02.Container2.contNoti2.setHeightResize(202)
		
		Tab0.page02.Container2.SetScrollAutoSize()
		Tab0.page02.Container2.scroll_pos = 202
	end if
End Sub

