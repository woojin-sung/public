--===========================================================================
--===========================================================================

'============================================================================
Sub Form_OnFormInit()
	Dim szOpenData
	szOpenData = Form.GetOpenLinkData()
	
	if szOpenData <> "" and szOpenData <> null then
'		전달내용 
'		0종목코드 
'		1종목명 
'		2매수매도구분코드 
'		3주문금액 
'		4체결수량 
'		5체결단가 
'		6체결금액 
'		7수수료
'		8날짜
		dim tData, tCode
		tData = Split(szOpenData, "★")
		tCode = Split(tData(0), ".")
		
		if tData(2) == "1" then
			lblOrdType.caption = "매도"
			lblOrdType.fgcolor = "11"
		elseif tData(2) == "2" then
			lblOrdType.caption = "매수"
			lblOrdType.fgcolor = "10"
		end if
		
		
		'lblItemCd.caption = Trim(tCode(0)) & " |"
		lblItemCd.caption = f_GetCode(tData(0)) & " |" 
		lblItemNm.caption = tData(1) 
		lblOrdAmt.caption = tData(3)
		lblCheQty.caption = tData(4)
		lblChePrc.caption = tData(5)
		lblCheAmt.caption = tData(6)
		lblFee.caption = tData(7)
		lblDate.caption = tData(8)
		
		dim nCdLen
		nCdLen = Len(f_GetCode(tData(0)))
		
		if nCdLen == 1 then
			lblItemNm.left = 45
		elseif nCdLen == 2 then
			lblItemNm.left = 57
		elseif nCdLen == 3 then
			lblItemNm.left = 71
		elseif nCdLen == 4 then
			lblItemNm.left = 82
		end if
	end if
End Sub

'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

Sub f_GetCode(aCode)
	aCode = Replace(aCode, ".AX", "")
	aCode = Replace(aCode, ".ET", "")
	aCode = Replace(aCode, ".NY", "")
	aCode = Replace(aCode, ".OQ", "")
	aCode = Replace(aCode, ".OT", "")
	return aCode
End Sub

