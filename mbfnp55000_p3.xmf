				<LABEL name="Label110" fontsize="-2" caption="실제 투자금액은 종목 설계시" ly_vert="12,400,190,39,1" />
				<LABEL name="Label111" fgcolor="007:030080200" fontsize="-2" caption="계산된 수량 * 매매체결일" ly_vert="180,400,200,39,1" />
				<LABEL name="Label112" fontsize="-2" caption="으로 결정됩니다." ly_vert="64,420,170,39,1" />
				<LABEL name="Label8" fontsize="-2" caption="ㆍ투자비중(%)을 입력하면 종목별 체결수량이 전일 종가와" ly_vert="0,440,370,39,1" />
				<LABEL name="Label20" fontsize="-2" caption="최소거래단위를 고려하여 자동 계산되며, 최소거래금액이 " ly_vert="12,460,370,39,1" />
				<LABEL name="Label21" fontsize="-2" caption="큰 경우 배분금액 중 최소거래금액 미만의 금액이 투자되지" ly_vert="12,480,370,39,1" />
				<LABEL name="Label22" fontsize="-2" caption="않고 남을 수 있습니다." ly_vert="12,500,370,39,1" />
				<LABEL name="Label113" fgcolor="007:030080200" fontsize="-2" caption="체결가격" ly_vert="12,420,80,39,1" />
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="14838" _ulen="14000" >
'============================================================================
' 화면명   : 02. 투자금액/비중설정하기
' 화면설명 : 	투자비중 입력하기
' 			투자금액 입력 -> 비중 입력	===> 수량, 예상투자금액, 배분금액 자동계산 
'                            			===> 예상투자금액합계 자동계산
' 종목선택 (mbfnp55000_p2) -> 비중선택(p3) -> 계약(p6)
'============================================================================
' 2018-04-03 : 신재영 : 신규개발
'============================================================================

Dim g_GridCls
Dim g_GridCellId
Dim g_GridRow
Dim g_szList

'============================================================================
Sub Form_OnFormInit()
	
	Dim sSendData
	
	'sSendData ==> 화면번호★계좌번호★계좌일련번호★계좌비밀번호★포트폴리오번호
	sSendData = Form.GetOpenLinkData()
	
	g_szList = Split(sSendData,"★")

	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	DATAMANAGER.RequestTranData("obsap_smpr_009r")
	DATAMANAGER.RequestTranData("obrtp_drab_001r")

End Sub

'============================================================================
Sub Edit0_OnClick()
	Call Label3_OnClick()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	If sKeyName = "mbfnp55000_p4" Then ' 투자금액입력
		Edit0.caption = sRet
		For i = 0 to Container0.Container1.Grid0.rowcount-1
			CalQtyAmt("0", i, Container0.Container1.Grid0.GetCellData("bd_cell1", i)  , Container0.Container1.Grid0.GetCellData("bd_cell7", i) )
		Next
		
		For j = 0 to Container0.Container1.Grid1.rowcount-1
			CalQtyAmt("1", j, Container0.Container1.Grid1.GetCellData("bd_cell1", j) , Container0.Container1.Grid1.GetCellData("bd_cell7", j) )
		Next
	ElseIf sKeyName = "mbfnp55000_p5" Then ' 비중입력
	
		If g_GridCls == "0" Then

			Container0.Container1.Grid0.SetCellData(g_GridCellId, g_GridRow, sRet)
			Call CalQtyAmt(g_GridCls, g_GridRow, sRet, Container0.Container1.Grid0.GetCellData("bd_cell7", g_GridRow) )
			
		ElseIf g_GridCls == "1" Then
		
			Container0.Container1.Grid1.SetCellData(g_GridCellId, g_GridRow, sRet)
			Call CalQtyAmt(g_GridCls, g_GridRow, sRet, Container0.Container1.Grid1.GetCellData("bd_cell7", g_GridRow) )
			
		End If
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	If szTranID == "obsap_smpr_001a" Then
	
		sOpenData = g_szList(0)                 ' 계좌번호
		sOpenData = sOpenData&"★"& g_szList(1) ' 계좌일련번호
		sOpenData = sOpenData&"★"& g_szList(2) ' 비밀번호
		sOpenData = sOpenData&"★"&Int(DATAMANAGER.GetDataValue( 0,"obsap_smpr_001a", "OutBlock1", "PRTF_SRNO"  , 0 ))
		
		Form.OpenFramePopup( "mbfnp55000_p7" , sOpenData , "" )
		
	End If
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	If szTranID == "obsap_smpr_009r" Then
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_009r", "InBlock1", "IQRY_CLS_CODE" 	, 0 , "1" 		)
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_009r", "InBlock1", "ACNO" 			, 0 , g_szList(0) )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_009r", "InBlock1", "ASNO" 			, 0 , g_szList(1) )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_009r", "InBlock1", "PRTF_SRNO" 		, 0 , g_szList(3) )
	ElseIf szTranID == "obsap_smpr_001a" Then
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock1", "PROS_CLS_CODE" 		, 0 , "U" 		)
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock1", "ACNO" 				, 0 , g_szList(0) )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock1", "ASNO" 				, 0 , g_szList(1) )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock1", "ACNT_PWD" 			, 0 , g_szList(2)	)
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock1", "SMPR_REG_STAG"		, 0 , 2 			)
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock1", "PRTF_SRNO" 			, 0 , g_szList(3) )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock1", "SMPR_TPCD"			, 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock1", "INVT_AMT" 			, 0 , Edit0.caption )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock1", "BYOV_ANTC_INVT_AMT"	, 0 , Container0.Table0.GetCellString(0, 1) 	)
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock1", "SELN_ANTC_INVT_AMT" 	, 0 , Container0.Table0.GetCellString(0, 3) 	)


		For i = 0 to Container0.Container1.Grid0.rowcount - 1
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "SMPR_PSTN_CLCD" 	, i , "2")
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "DMAB_CLS_CODE" 	, i , Container0.Container1.Grid0.GetCellData( "bd_cell8", i ))
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "SMPR_ISSU_TPCD" 	, i , Container0.Container1.Grid0.GetCellData( "bd_cell9", i ))
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "ISCD" 			, i , Container0.Container1.Grid0.GetCellData( "bd_cell6", i ))
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "INVT_RLIM" 		, i , Container0.Container1.Grid0.GetCellData( "bd_cell1", i ))
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "BEF_DAY_SDPR" 	, i , FIX(Container0.Container1.Grid0.GetCellData( "bd_cell7", i )))
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "ANTC_CALC_QTY" 	, i , Container0.Container1.Grid0.GetCellData( "bd_cell2", i ))
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "ANTC_CALC_AMT" 	, i , Container0.Container1.Grid0.GetCellData( "bd_cell4", i ))
		Next
		
		i = Container0.Container1.Grid0.rowcount
		
		For j = 0 to Container0.Container1.Grid1.rowcount - 1
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "SMPR_PSTN_CLCD" 	, i+j , "1")
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "DMAB_CLS_CODE" 	, i+j , Container0.Container1.Grid1.GetCellData( "bd_cell8", j ))
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "SMPR_ISSU_TPCD" 	, i+j , Container0.Container1.Grid1.GetCellData( "bd_cell9", j ))
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "ISCD" 			, i+j , Container0.Container1.Grid1.GetCellData( "bd_cell6", j ))
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "INVT_RLIM" 		, i+j , Container0.Container1.Grid1.GetCellData( "bd_cell1", j ))
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "BEF_DAY_SDPR" 	, i+j , FIX(Container0.Container1.Grid1.GetCellData( "bd_cell7", j )))
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "ANTC_CALC_QTY" 	, i+j , Container0.Container1.Grid1.GetCellData( "bd_cell2", j ))
			DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a", "InBlock2", "ANTC_CALC_AMT" 	, i+j , Container0.Container1.Grid1.GetCellData( "bd_cell4", j ))
		
		Next
	ElseIf szTranID == "obsap_smpr_001a_1" Then
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a_1", "InBlock1", "PROS_CLS_CODE" 		, 0 , "D" 		)
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a_1", "InBlock1", "ACNO" 				, 0 , g_szList(0) )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a_1", "InBlock1", "ASNO" 				, 0 , g_szList(1) )
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a_1", "InBlock1", "ACNT_PWD" 			, 0 , g_szList(2)	)
		DATAMANAGER.SetDataValue( 0, "obsap_smpr_001a_1", "InBlock1", "PRTF_SRNO" 			, 0 , g_szList(3) )
	ElseIf szTranID == "obrtp_drab_001r" Then
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "ACNO", 0, g_szList(0) )
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "ASNO", 0, g_szList(1) )
		DATAMANAGER.SetDataValue( 0, "obrtp_drab_001r", "InBlock1", "SUMR_DRNG_YN", 0 ,  "2" )'''적요출금여부Form.GetSharedData("#BCP_BIZ_DT", False)
	End If	
End Sub

'============================================================================
Sub Container0_Container1_Grid0_OnClickUp(lRow, szCellID)
	If szCellID == "bd_cell1" Then '비중설정
		g_GridCls    = "0"
		g_GridCellId = szCellID
		g_GridRow    = lRow

		Form.OpenDialog( "mbfnp55000_p5" , Container0.Container1.Grid0.GetCellData( sCellID, lRow ) , "" )
	End If
End Sub

'============================================================================
Sub Container0_Container1_Grid1_OnClickUp(lRow, szCellID)
	If szCellID == "bd_cell1" Then '비중설정
		g_GridCls    = "1"
		g_GridCellId = szCellID
		g_GridRow    = lRow
		
		Form.OpenDialog( "mbfnp55000_p5" , Container0.Container1.Grid1.GetCellData( sCellID, lRow ) , "" )
	End If
End Sub
'============================================================================
Sub CalQtyAmt(p_GridCls, p_Row, p_Rate, p_MinTrAmt) '수량, 금액 등 계산
	
	Dim CalQty         ' 계산수량
	Dim CalDstrAmt     ' 배분금액
	Dim CalAntcInvtAmt ' 예상투자금액
	
	CalQty         = 0
	CalDstrAmt     = 0
	CalAntcInvtAmt = 0
	
	If p_Rate == 0 or Len(p_Rate) == 0 or CDbl(Edit0.caption) == 0 Then ' 미입력
	
		CalQty         = 0
		p_MinTrAmt     = 0
		CalAntcInvtAmt = 0
		CalDstrAmt     = 0
		
	Else
	
		' <계산식>
		' 배분금액     = 투자금액 * 비중
		' 수량         = 배분금액 / 최소거래금액
		' 예상투자금액 = 수량 * 최소거래금액	

		CalDstrAmt     = Fix(CDbl(Edit0.caption) * (p_Rate /100))

		' 배분금액이 최소거래금액보다 작으면 수량이 0임.
		If CalDstrAmt < INT(p_MinTrAmt) Then
			Form.MsgBox("알림", "배분금액이 최소거래금액 미만입니다. 비중을 다시 설정해주세요.", "", 0)
			Exit Sub
		End If
		
		CalQty         = Fix(CalDstrAmt / p_MinTrAmt)
		CalAntcInvtAmt = CalQty * p_MinTrAmt
		
	End If
	

	
	'0 종목명 1 비중 2 수량 3 최소거래금액 4 예상투자금액 5 배분금액 6 종목코드 7 전일종가
	If p_GridCls = "0" Then
	
		Container0.Container1.Grid0.SetCellData("bd_cell2",  p_Row, CalQty)
		Container0.Container1.Grid0.SetCellData("bd_cell3",  p_Row, p_MinTrAmt)
		Container0.Container1.Grid0.SetCellData("bd_cell4",  p_Row, CalAntcInvtAmt)
		Container0.Container1.Grid0.SetCellData("bd_cell5",  p_Row, CalDstrAmt)
		
	ElseIf p_GridCls = "1" Then
	
		Container0.Container1.Grid1.SetCellData("bd_cell2",  p_Row, CalQty)
		Container0.Container1.Grid1.SetCellData("bd_cell3",  p_Row, p_MinTrAmt)
		Container0.Container1.Grid1.SetCellData("bd_cell4",  p_Row, CalAntcInvtAmt)
		Container0.Container1.Grid1.SetCellData("bd_cell5",  p_Row, CalDstrAmt)
	
	End If
	
	Container0.Table0.SetCellString(0, 1, Container0.Container1.Grid0.GetCellData("bd_cell4", 0) + Container0.Container1.Grid0.GetCellData("bd_cell4", 1)) 
	Container0.Table0.SetCellString(0, 3, Container0.Container1.Grid1.GetCellData("bd_cell4", 0) + Container0.Container1.Grid1.GetCellData("bd_cell4", 1))

End Sub




'============================================================================
Sub Button0_OnClick() ' 다음
	If Len(Edit0.caption) == 0 Then
		Form.MsgBox("알림", "투자금액 및 비중을\n확인하세요.", "", 0)
		Exit Sub
	End If
	
	TotRate_Long  = 0
	TotRate_Short = 0
	
	For i = 0 to Container0.Container1.Grid0.rowcount-1
		TotRate_Long = TotRate_Long + CDbl(Container0.Container1.Grid0.GetCellData( "bd_cell1", i))
		If Len(Container0.Container1.Grid0.GetCellData( "bd_cell1", i)) == 0 Then
			Form.MsgBox("알림", "투자금액 및 비중을\n확인하세요.", "", 0)
			Exit Sub
		End If
	Next
	
	For i = 0 to Container0.Container1.Grid1.rowcount-1
		TotRate_Short = TotRate_Short + CDbl(Container0.Container1.Grid1.GetCellData( "bd_cell1", i))
		If Len(Container0.Container1.Grid1.GetCellData( "bd_cell1", i)) == 0 Then
			Form.MsgBox("알림", "투자금액 및 비중을\n확인하세요.", "", 0)
			Exit Sub
		End If
		
		
	Next	

	If TotRate_Long <> 100 or
	   TotRate_Short <> 100 Then
		Form.MsgBox("알림", "롱/숏 각 포지션 비중의 합계는\n100%로 고정입니다.", "", 0)
		Exit Sub
	End If
	
	DATAMANAGER.RequestTranData("obsap_smpr_001a")
	
End Sub

'============================================================================


'============================================================================
Sub Button1_OnClick() ' 이전버튼
	Form_OnFormBackKeyPressed()
	
End Sub

'============================================================================
Sub Label3_OnClick() ' 투자금액입력
	Form.OpenPopup("mbfnp55000_p4", Edit0.caption, "")
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed() ' Back버튼

	Form.CloseForm()
	
End Sub

'============================================================================
'DATAMANAGER_OnReceiveTranError
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	Form.ShowAlert("알림", szErrMsg & "(" & szSubMsg & ")")
	
	If szTranID == "obsap_smpr_009r" OR szTranID == "obsap_smpr_009r_1" Then
		Form.CloseForm()
	End If

End Sub
'============================================================================
Sub Form_OnFormClose()
	' 계좌번호★계좌일련번호★비밀번호★포트폴리오일련번호
	'Form.SendReturnToParent( "mbfnp55000_p3" ,  g_szList(0)&"★"&g_szList(1)&"★"&g_szList(2)&"★"&g_szList(3) ) 
	DATAMANAGER.RequestTranData("obsap_smpr_001a_1")
End Sub

'============================================================================
Sub btnIqry_OnClick()
	szAcnt = g_szList(0)&g_szList(1)
    If Len(szAcnt) < 10 Then
	    Form.ShowAlert("알림", "계좌번호를 확인하십시오.")
	    exit sub 
	End If
	
	DATAMANAGER.RequestTranData( "obrtp_drab_001r" )
	
End Sub

'============================================================================
Sub btnReset_OnClick()

	For i = 0 To Container0.Container1.Grid0.rowcount-1
		Container0.Container1.Grid0.SetCellData("bd_cell2",  i, "")
		Container0.Container1.Grid0.SetCellData("bd_cell3",  i, "")
		Container0.Container1.Grid0.SetCellData("bd_cell4",  i, "")
		Container0.Container1.Grid0.SetCellData("bd_cell5",  i, "")
	Next
	
	For j = 0 To Container0.Container1.Grid1.rowcount-1
		Container0.Container1.Grid1.SetCellData("bd_cell2",  j, "")
		Container0.Container1.Grid1.SetCellData("bd_cell3",  j, "")
		Container0.Container1.Grid1.SetCellData("bd_cell4",  j, "")
		Container0.Container1.Grid1.SetCellData("bd_cell5",  j, "")
	Next
	
	Container0.Table0.SetCellString(0, 1, "") 
	Container0.Table0.SetCellString(0, 3, "")
	
	Edit0.caption = 0
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obsap_smpr_009r" trcode="obsap_smpr_009r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obsap_smpr_001a" trcode="obsap_smpr_001a" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obsap_smpr_009r_1" trcode="obsap_smpr_009r" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obsap_smpr_001a_1" trcode="obsap_smpr_001a" compress="1" encryption="1" inputcheck="1" useattr="0" />
			<TRAN tranid="obrtp_drab_001r" trcode="obrtp_drab_001r" compress="1" encryption="1" inputcheck="1" useattr="0" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obsap_smpr_009r" title="장외_스마트프로 등록된 종목 조" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="245" _ulen="173" >

IQRY_CLS_CODE^조회구분코드^1^0^0^0^0^0^0
ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
PRTF_SRNO^포트폴리오일련번호^11^0^7^0^0^0^0
SMPR_APLT_SRNO^스마트프로신청일련번호^11^0^7^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" inout="out" _len="487" _ulen="353" >

ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
PRTF_SRNO^포트폴리오일련번호^11^0^7^0^0^0^0
SMPR_TPCD^스마트프로유형코드^1^0^0^0^0^0^0
INVT_AMT^투자금액^19^0^7^0^0^0^0
