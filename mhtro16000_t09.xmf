'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szItemCode, g_szItemName
Dim g_szIteminfo
Dim g_szExid

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if (sEventName == "RequestData") then
		g_szItemCode = sParam
		If sParam = "" Then
			Exit Sub
		End If
		
		grdNews.SetClear()
		g_szItemName = Form.GetItemCodeInfo( sParam , "name")
		g_sCode = Split(g_szItemCode, "@")
		g_szIteminfo = g_sCode(0)
		g_szExid = Transform_Exid2(g_szIteminfo)
		g_szItemCode = g_sCode(1)

		DATAMANAGER.RequestTranData( "ohhts_news_001r" )
		
	 end if	
End Sub
'============================================================================
Function Transform_Exid2(sValue)
	if sValue = "HK" then
		Transform_Exid2 = "HKS"
		exit Function
	elseif sValue = "SH" then
		Transform_Exid2 = "SHS"
		exit Function
	elseif sValue = "SZ" then
		Transform_Exid2 = "SZS"
		exit Function
	elseif sValue = "NY" then
		Transform_Exid2 = "NYS"
		exit Function
	elseif sValue = "AX" then
		Transform_Exid2 = "AMX"
		exit Function
	elseif sValue = "OQ" then
		Transform_Exid2 = "NAS"
		exit Function
	elseif sValue = "JP" then
		Transform_Exid2 = "TSE"
		exit Function		
	end if
End Function
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	szDate =  Form.GetSharedData("&HOST_DATE", false)
	DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock1", "FID_INPUT_NEWS_ITN_EXCP_CLCD"	, 0 , "00" )
	DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock2", "FID_INPUT_DATE"				, 0 , szDate )
	DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock2", "FID_INPUT_NEWS_ITN_EXCP_CLCD"	, 0 , "Y" )
	DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "InBlock2", "FID_NEW_INPUT_ISCD"			, 0 , g_szExid&g_szItemCode )
End Sub

'============================================================================
Sub grdNews_OnClickUp(lRow, szCellID)
	Dim szTitle, szDate, szTime, szNewCorpName, szNewKey, szNewsCorpCode, szMsg

	szTitle			= grdNews.GetCellData( "bd_cell0", lRow )	' 제목
	szDate			= grdNews.GetCellData( "bd_cell1", lRow )	' 날짜
	szTime			= grdNews.GetCellData( "bd_cell3", lRow )	' 시간
	szNewCorpName		= grdNews.GetCellData( "bd_cell9", lRow )	' 뉴스제공업체명
	szNewKey			= grdNews.GetCellData( "bd_cell4", lRow )	' 뉴스키
	szNewsCorpCode	= grdNews.GetCellData( "bd_cell5", lRow )	' 뉴스제공업체코드

	szMsg = szTitle & "|" & szDate & "|" & szTime & "|" & szNewCorpName & "|" & szNewKey & "|" & szNewsCorpCode & "|" & g_szItemName

	Form.OpenPopup( "mhprc11000_p6" , "mhtro16000_t09"& "★" &szMsg, "" )

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)	

	If szTranID = "ohhts_news_001r" Then
		Dim nCnt, szTime
		
		nCnt = DATAMANAGER.GetDataCount( 0, "ohhts_news_001r", "OutBlock1" )
		
		For i = 0 To nCnt - 1
			szTime = DATAMANAGER.GetDataValue( 0, "ohhts_news_001r", "OutBlock1", "FID_CNTG_HOUR" , i )
			
			DATAMANAGER.SetDataValue( 0, "ohhts_news_001r", "OutBlock1", "FID_CNTG_HOUR" , i , Left(szTime, 4) )
		Next
	End If
End Sub
