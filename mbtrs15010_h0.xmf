Dim g_szCld, g_szChk

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInitBefore()
'	Dim szData, arrData
'
'	szData = Form.GetOpenLinkData()
'	arrData = Split(szData,"|")
'	
'	if UBOUND(arrData) < 1 then
'	    Exit sub
'	End if
'
'	g_szCld = arrData(0)
'	g_szChk = arrData(1)
	
End Sub


'============================================================================
Sub Form_OnFormInit()
	Dim szData, arrData

	szData = Form.GetOpenLinkData()
	arrData = Split(szData,"|")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if

	g_szCld = arrData(0)
	g_szChk = arrData(1)

	If g_szChk <> "" Then
		cld0.caption 		 = g_szCld
		chkGrid.checkstate = g_szChk
	
		chkGrid_OnChange( Cstr( g_szChk ) )	
		btnSearch_OnClick()
	End If
	
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	Dim szAcNo, szAsNo 
	
	szACNO = acnt0.total
	szASNO = acnt0.sequence
	
	DATAMANAGER.SetDataValue( false, "obtrs_cntg_532r", "InBlock1", "ACNO" , 0 , szAcNo )
	DATAMANAGER.SetDataValue( false, "obtrs_cntg_532r", "InBlock1", "ASNO" , 0 , szAsNo )
	
	DATAMANAGER.SetDataValue( false, "obtrs_cntg_532r_1", "InBlock1", "ACNO" , 0 , szAcNo )
	DATAMANAGER.SetDataValue( false, "obtrs_cntg_532r_1", "InBlock1", "ASNO" , 0 , szAsNo )

	
End Sub



'============================================================================
Sub Form_OnFormClose()
	Form.SaveConfigData("mbtrs15010", "ChkView", chkGrid.checkstate )
End Sub


'============================================================================
Sub chkGrid_OnChange(sCheckState)
	If sCheckState = "1" Then
		grd1.visible = true
		grd2.visible = false
	Else
		grd1.visible = false
		grd2.visible = true
	End If
	
End Sub

'============================================================================
Sub btnSearch_OnClick()
	DATAMANAGER.RequestTranData( "obtrs_cntg_532r"   )
	DATAMANAGER.RequestTranData( "obtrs_cntg_532r_1" )
	
End Sub

'============================================================================
Sub acnt0_ChangeAccount()
	btnSearch_OnClick()
	
End Sub

'============================================================================
Sub btnClose_OnClick()
	Dim szData
	
	szData = cld0.caption & "|" & chkGrid.checkstate  & "|" & acnt0.caption
	
	Form.CloseForm()
	Form.SendReturnToParent("mbtrs15010" , szData)
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
'	Form.ShowAlert( szErrCode , szErrMsg )
End Sub

'============================================================================
Sub imgClose_OnClick()
	btnClose_OnClick()
End Sub

'============================================================================
Sub Form_OnRefresh()
	btnSearch_OnClick()
End Sub

