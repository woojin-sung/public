' 처리버튼
'============================================================================
Sub Cont0_ButtonOK_OnClick()
	
	'동의서 읽음 여부 리턴
	DIm sDocuValue
	if Cont0.ChkButton0.checkstate == "1" and Cont0.ChkButton1.checkstate ==	"1"then
		sDocuValue = 3
	else 
		if Cont0.ChkButton0.checkstate == "1" then
			sDocuValue = 1
		elseif Cont0.ChkButton1.checkstate == "1" then
			sDocuValue = 2
		end if
	end if
	Form.SetSharedData("DOCU_VAL" , sDocuValue)
	
	Dim sScreenNo 
	sScreenNo = Form.GetSharedData("&SCREEN_NO", false )
	if sScreenNo ~= "81020" then '개인신용정보이용동의 본화면이 아닌경우
		
		'동의서 확인 여부 체크
		if Cont0.ChkButton0.checkstate ~= "1" and Cont0.ChkButton1.checkstate ~= "1" then	'16-03-23 YCJ 필수동의서 약관 체크 정민영 대리님 요청
			Form.MsgBox( "알림", "요약동의서 또는 상세동의서 중 한가지는 조회하셔야 합니다.", "", 6 )	
			Exit Sub	
		end if
	
		Form.SetSharedData("COMN_YN1" , g_sCOMN_YN1) 
		Form.SetSharedData("COMN_YN2" , g_sCOMN_YN2)

		Form.SetSharedData("PROD_YN1" , g_sPROD_YN1)
		Form.SetSharedData("PROD_YN2" , g_sPROD_YN2)
		
		Form.SetSharedData("PROD_YN3" , g_sPROD_YN3)
		Form.SetSharedData("PROD_YN4" , g_sPROD_YN4)
		
		Form.SetSharedData("PROD_YN5" , g_sPROD_YN5)
		Form.SetSharedData("PROD_YN6" , g_sPROD_YN6)
		Form.SetSharedData("PROD_YN7" , g_sPROD_YN7)
		
		Form.SetSharedData("PROD_YN8" , g_sPROD_YN8)
		Form.SetSharedData("PROD_YN9" , g_sPROD_YN9)
		
		Form.SetSharedData("PROD_YN10" , g_sPROD_YN10)
		Form.SetSharedData("PROD_YN11" , g_sPROD_YN11)
		
		Form.SetSharedData("PROD_YN12" , g_sPROD_YN12)
		Form.SetSharedData("PROD_YN13" , g_sPROD_YN13)
		
		Form.triggerEvent( "#", "Request", "page0_acct" )
	else
		if f_GetPWCkeck() then
			Exit Sub
		end if
				
		'동의서 확인 여부 체크
		if Cont0.ChkButton0.checkstate ~= "1" and Cont0.ChkButton1.checkstate ~= "1" then	'16-03-23 YCJ 필수동의서 약관 체크 정민영 대리님 요청
			Form.MsgBox( "알림", "요약동의서 또는 상세동의서 중 한가지는 조회하셔야 합니다.", "", 6 )	
			Exit Sub	
		end if
		
		'변경내역체크
		Dim sCOMN_YN1, sCOMN_YN2
		Dim sPROD_YN1, sPROD_YN2, sPROD_YN3, sPROD_YN4, sPROD_YN5, sPROD_YN6, sPROD_YN7, sPROD_YN8, sPROD_YN9, sPROD_YN10, sPROD_YN11, sPROD_YN12, sPROD_YN13
		sCOMN_YN1 = Form.GetCtlProp( "#LabelCOMNYN1", "caption" )
		sCOMN_YN2 = Form.GetCtlProp( "#LabelCOMNYN2", "caption" )
		
		sPROD_YN1 = Form.GetCtlProp( "#LabelPRODYN1", "caption" )
		sPROD_YN2 = Form.GetCtlProp( "#LabelPRODYN2", "caption" )
		sPROD_YN3 = Form.GetCtlProp( "#LabelPRODYN3", "caption" )
		sPROD_YN4 = Form.GetCtlProp( "#LabelPRODYN4", "caption" )
		sPROD_YN5 = Form.GetCtlProp( "#LabelPRODYN5", "caption" )
		sPROD_YN6 = Form.GetCtlProp( "#LabelPRODYN6", "caption" )
		sPROD_YN7 = Form.GetCtlProp( "#LabelPRODYN7", "caption" )
		sPROD_YN8 = Form.GetCtlProp( "#LabelPRODYN8", "caption" )
		sPROD_YN9 = Form.GetCtlProp( "#LabelPRODYN9", "caption" )
		sPROD_YN10 = Form.GetCtlProp( "#LabelPRODYN10", "caption" )
		sPROD_YN11 = Form.GetCtlProp( "#LabelPRODYN11", "caption" )
		sPROD_YN12 = Form.GetCtlProp( "#LabelPRODYN12", "caption" )
		sPROD_YN13 = Form.GetCtlProp( "#LabelPRODYN13", "caption" )
		'v0004
		'if Cont0.Rdo0.currentindex ~= f_GetYNState(sCOMN_YN1) or 
		'	Cont0.Rdo1.currentindex ~= f_GetYNState(sCOMN_YN2) or
		'	Cont0.Rdo2.currentindex ~= f_GetYNState(sPROD_YN1) or
		'	Cont0.Rdo3.currentindex ~= f_GetYNState(sPROD_YN2) or
		'	Cont0.Rdo4.currentindex ~= f_GetYNState(sPROD_YN3) or
		'	Cont0.Rdo5.currentindex ~= f_GetYNState(sPROD_YN4) or
		'	Cont0.Rdo6.currentindex ~= f_GetYNState(sPROD_YN5) or
		'	Cont0.Rdo7.currentindex ~= f_GetYNState(sPROD_YN6) or
		'	Cont0.Rdo8.currentindex ~= f_GetYNState(sPROD_YN7) or
		'	Cont0.Rdo9.currentindex ~= f_GetYNState(sPROD_YN8) or
		'	Cont0.Rdo10.currentindex ~= f_GetYNState(sPROD_YN9) or
		'	Cont0.Rdo11.currentindex ~= f_GetYNState(sPROD_YN10) or
		'	Cont0.Rdo12.currentindex ~= f_GetYNState(sPROD_YN11) or
		'	Cont0.Rdo13.currentindex ~= f_GetYNState(sPROD_YN12) or
		'	Cont0.Rdo14.currentindex ~= f_GetYNState(sPROD_YN13) then
			
			Form.SetSharedData("COMN_YN1" , g_sCOMN_YN1) 
			Form.SetSharedData("COMN_YN2" , g_sCOMN_YN2)
			
			Form.SetSharedData("PROD_YN1" , g_sPROD_YN1)
			Form.SetSharedData("PROD_YN2" , g_sPROD_YN2)
			Form.SetSharedData("PROD_YN3" , g_sPROD_YN3)
			Form.SetSharedData("PROD_YN4" , g_sPROD_YN4)
			Form.SetSharedData("PROD_YN5" , g_sPROD_YN5)
			Form.SetSharedData("PROD_YN6" , g_sPROD_YN6)
			Form.SetSharedData("PROD_YN7" , g_sPROD_YN7)
			Form.SetSharedData("PROD_YN8" , g_sPROD_YN8)
			Form.SetSharedData("PROD_YN9" , g_sPROD_YN9)
			Form.SetSharedData("PROD_YN10" , g_sPROD_YN10)
			Form.SetSharedData("PROD_YN11" , g_sPROD_YN11)
			Form.SetSharedData("PROD_YN12" , g_sPROD_YN12)
			Form.SetSharedData("PROD_YN13" , g_sPROD_YN13)
			
			Form.triggerEvent( "#", "Request", "page0_menu" )
		'else
		'	Form.MsgBox( "알림", "변경내역이 없습니다.", "", 6 )	
		'end if	
	end if
	
End Sub

'============================================================================
' DATAMANAGER
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obaci_acct_257r" then		
		DATAMANAGER.SetDataValue( 0, "obaci_acct_257r", "InBlock1", "CRDT_AGRM_BSWR_KIND_CLCD" , 0 , g_sKindCode )
	end if 
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obaci_acct_257r" then
		Dim sNW_AGRM_BSWR_CLCD, sUI_CLS, sNW_AGRM_KIND_CLCD, sAGRM_YN
		Dim nCnt
		nCnt = DATAMANAGER.GetDataCount( 0, "obaci_acct_257r", "OutBlock2")
		
		for i = 0 to nCnt -1 
			sNW_AGRM_BSWR_CLCD = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2" , "NW_AGRM_BSWR_CLCD" , i )
			sUI_CLS = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2" , "UI_CLS" , i )
			sNW_AGRM_KIND_CLCD = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2" , "NW_AGRM_KIND_CLCD" , i )
			sAGRM_YN = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock2" , "AGRM_YN" , i )

			f_SetAct(sNW_AGRM_BSWR_CLCD, sUI_CLS, sNW_AGRM_KIND_CLCD, sAGRM_YN)
			Form.SetCtlProp("Cont0.Label"..i, "caption", sAGRM_YN)
		next
		
		f_SetAllCheckEnable(0, 1, "Cont0.ChkAll0")
		f_SetAllCheckEnable(2, 8, "Cont0.ChkAll1")
		f_SetAllCheckEnable(9, 12, "Cont0.ChkAll2")
		f_SetAllCheckEnable(13, 14, "Cont0.ChkAll3")
	end if 
End Sub
