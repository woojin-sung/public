	<SCRIPT_INFO _len="27922" _ulen="25666" >
'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 개인신용정보이용동의
' 02. 화면설명 : 개인신용정보이용동의_필수동의
' 03. 작    성 : 2016.01.22 김보라				
' 04. 수    정 : 2016.03.07 YCJ 타이틀 내용 수정
'                2016.04.18 ESKIM : ISA 계좌개설 추가
'                2017.11.23 윤유정 : 개인신용정보제공동의서 개편(일부항목 동의>고지로 변경) v0001
'			   2019.04.23 조승행 : 개인신용정보처리 동의서 항목 변경 관련 개발 T1904100006 v0002
' 2020.11.10 : 정민영 : v0003 : 오류수정
' 2023-05-26 : 강희승 : v0004 : 필수동의서 이전 동의내역과 같아도 처리완료로 변경 => 법규준수팀 강다윤사원 T2304250010
'-------------------------------------------------------------------------------------------
'============================================================================
' v0001
' 개인(신용)정보동의서 개선 설명
'============================================================================
'	변경 내용 : 기존 "동의" 항목을 "고지"로 변경 & 각 항목 번호를 숫자>알파벳으로 변경(전 채널 통일)
'	대상 항목 : 1. 필수동의서(공통)
'					1) 수집,이용				>>> "Y"(화면에서 강제 셋팅_초기선택값 2->0으로 변경)
'			   2. 필수동의서(상품별)
'					1) 수집,이용 전체(1~7번)	>>> "Y"
'					2) 업무위탁				>>> "Y"
'					3) 고유식별정보의 처리		>>> "Y"
'			   3. 일괄동의여부
'					1) 업무위탁				>>> NULL(선택값 없이 서비스 호출_초기선택값 2 유지)
'					2) 제공					>>> NULL
'	기타 항목들은 현상 유지
'============================================================================
' 2021.05.21 : 김수진
' 개인(신용)정보동의서 공통 화면 처리
' 공통화면에서는 해당 업무에서 필요한 항목들만 활성화/ 나머지는 비활성화
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

'필수동의(공통)
Dim g_sCOMN_YN1 '수집이용 고유식별번호
Dim g_sCOMN_YN2 '수집이용 개인신용정보

'필수동의(수집/이용 상품별)
Dim g_sPROD_YN1 '수집이용_신용공여/미수/파생상품 고유식별번호
Dim g_sPROD_YN2 '수집이용_신용공여/미수/파생상품 개인신용정보

Dim g_sPROD_YN3 '수집이용_비과세종합저축/ISA/연금저축 고유식별번호
Dim g_sPROD_YN4 '수집이용_비과세종합저축/ISA/연금저축 민감정보
Dim g_sPROD_YN5 '수집이용_비과세종합저축/ISA/연금저축 개인신용정보

Dim g_sPROD_YN6 '수집이용_해외주식/해외파생/해외금융/EUREX 개인신용정보
Dim g_sPROD_YN7 '수집이용_해외주식/해외파생/해외금융/EUREX 개인신용정보

'필수동의(제공 상품별)
Dim g_sPROD_YN8 '제공_신용공여/미수/파생상품 고유식별번호
Dim g_sPROD_YN9 '제공_신용공여/미수/파생상품 개인신용정보

Dim g_sPROD_YN10 '제공_해외주식/해외파생/해외금융/EUREX 고유식별번호
Dim g_sPROD_YN11 '제공_해외주식/해외파생/해외금융/EUREX 개인신용정보

'필수동의(조회 상품별)
Dim g_sPROD_YN12 '조회_신용공여/미수/파생상품 고유식별번호 
Dim g_sPROD_YN13 '조회_신용공여/미수/파생상품 개인신용정보 

Dim g_sKindCode '신용동의업무 코드
Dim g_sColor '활성화/비활성화 색
dim g_sTemp
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'============================================================================
' 동의/미동의 상태값 리턴
'============================================================================
Function f_GetYNState(sState)
	if sState == "Y" then
		return "1" 
	elseif sState == "N" then
		return "0" 
	else
		return "-1" 
	end if
End Function

'===========================================================================
' 계좌비밀번호 입력체크함수
'===========================================================================
Function f_GetPWCkeck()
	Dim sACNT_PWD 
	sACNT_PWD = Form.GetCtlProp( "#EditPW", "caption" )
	
	if sACNT_PWD == null or sACNT_PWD == "" then
		Form.MsgBox( "알림", "비밀번호를 입력해주세요.", "", 6 )	
		return true
	end if
	
	return false
End Function	

'===========================================================================
' 신용동의 업무에 따른 활성화/비활성화 처리
'===========================================================================
Function f_SetAct(sNW_AGRM_BSWR_CLCD, sUI_CLS, sNW_AGRM_KIND_CLCD, sAGRM_YN)
	if sNW_AGRM_BSWR_CLCD ~= nil and sNW_AGRM_BSWR_CLCD ~= "" then
'		수집이용(공통)
		if sNW_AGRM_BSWR_CLCD == "1" then
			Cont0.Rdo0.enable = true		'수집이용
			Cont0.Rdo1.enable = true		'고유식별정보의처리
			
'		수집이용(상품별)
		elseif sNW_AGRM_BSWR_CLCD == "2" then
			if sUI_CLS == "1" then								'신용공여/미수/파생상품
				if sNW_AGRM_KIND_CLCD == "1" then				'수집이용	
					Cont0.Rdo2.enable = f_ReturnEnableYN(sAGRM_YN)
					Cont0.Table1.SetCellFgColor( 2, 0,  g_sColor )
				elseif sNW_AGRM_KIND_CLCD == "2" then			'고유식별정보의처리
					Cont0.Rdo3.enable = f_ReturnEnableYN(sAGRM_YN)
					Cont0.Table1.SetCellFgColor( 3, 0, g_sColor )
				end if		
			elseif sUI_CLS == "2" then							'비과세종합저축/ISA/연금저축
				if sNW_AGRM_KIND_CLCD == "1" then
					Cont0.Rdo4.enable = f_ReturnEnableYN(sAGRM_YN)
					Cont0.Table1.SetCellFgColor( 5, 0,  g_sColor )
				elseif sNW_AGRM_KIND_CLCD == "2" then
					Cont0.Rdo6.enable = f_ReturnEnableYN(sAGRM_YN)
					Cont0.Table1.SetCellFgColor( 7, 0,  g_sColor )
				elseif sNW_AGRM_KIND_CLCD == "3" then			'민감정보
					Cont0.Rdo5.enable = f_ReturnEnableYN(sAGRM_YN)
					Cont0.Table1.SetCellFgColor( 6, 0,  g_sColor )
				end if
			elseif sUI_CLS == "3" then							'해외주식/해외파생/해외금융/EUREX
				if sNW_AGRM_KIND_CLCD == "1" then
					Cont0.Rdo7.enable = f_ReturnEnableYN(sAGRM_YN)
					Cont0.Table1.SetCellFgColor( 9, 0,  g_sColor )
				elseif sNW_AGRM_KIND_CLCD == "2" then
					Cont0.Rdo8.enable = f_ReturnEnableYN(sAGRM_YN)
					Cont0.Table1.SetCellFgColor( 10, 0,  g_sColor )
				end if
			end if
'		제공(상품별)
		elseif sNW_AGRM_BSWR_CLCD == "3" then		
			if sUI_CLS == "1" then								'신용공여/미수/파생상품/해외파생
				if sNW_AGRM_KIND_CLCD == "1" then
					Cont0.Rdo9.enable = f_ReturnEnableYN(sAGRM_YN)
					Cont0.Table2.SetCellFgColor( 2, 0,  g_sColor )
				elseif sNW_AGRM_KIND_CLCD == "2" then
					Cont0.Rdo10.enable = f_ReturnEnableYN(sAGRM_YN)
					Cont0.Table2.SetCellFgColor( 3, 0,  g_sColor )
				end if
			elseif sUI_CLS == "2" then							'해외주식/해외파생/해외금융/EUREX
				if sNW_AGRM_KIND_CLCD == "1" then
					Cont0.Rdo11.enable = f_ReturnEnableYN(sAGRM_YN)
					Cont0.Table2.SetCellFgColor( 5, 0,  g_sColor )
				elseif sNW_AGRM_KIND_CLCD == "2" then
					Cont0.Rdo12.enable = f_ReturnEnableYN(sAGRM_YN)
					Cont0.Table2.SetCellFgColor( 6, 0,  g_sColor )
				end if
			end if
'		제공(공통)
		elseif sNW_AGRM_BSWR_CLCD == "4" then
			if sUI_CLS == "1" then								'신용공여/미수/파생상품/해외파생
				if sNW_AGRM_KIND_CLCD == "1" then
					Cont0.Rdo13.enable = f_ReturnEnableYN(sAGRM_YN)
					Cont0.Table3.SetCellFgColor( 2, 0,  g_sColor )
				elseif sNW_AGRM_KIND_CLCD == "2" then
					Cont0.Rdo14.enable = f_ReturnEnableYN(sAGRM_YN)
					Cont0.Table3.SetCellFgColor( 3, 0,  g_sColor )
				end if
			end if 
		end if
	end if 
	
End Function	
'===========================================================================
' 활성화 비활성화 값 리턴
'===========================================================================
Function f_ReturnEnableYN(sState)
	g_sColor = "3"
	if sState ~= nil and sState ~= "" then
		if sState == "Y" then		
			return true
		elseif sState == "N" then
			g_sColor = "272"
			return false
		end if
	else
		return
	end if
End Function	
'============================================================================
' 일괄동의
'============================================================================
Function f_SetAllCheck(nStart, nFin, sControl)
	dim sFlag
	sFlag = "0"
	for i = nStart to nFin
		if Form.GetCtlProp("Cont0.Label"..i, "caption") == "Y" then
			if Form.GetCtlProp( "Cont0.Rdo"..i, "currentindex") == "1" then
				sFlag = "1"
			else
				Form.SetCtlProp( sControl , "chksilence" , "0")
				return
			end if
		end if
	next
	if sFlag == "1" then
		Form.SetCtlProp( sControl , "chksilence" , "1")
	end if 
	
End Function
'============================================================================
' 일괄동의
'============================================================================
Function f_SetAllCheckEnable(nStart, nFin , sControl)
	dim sFlag
	sFlag = "0"
	for i = nStart to nFin
		if Form.GetCtlProp("Cont0.Label"..i, "caption") == "N" then
			sFlag = "1"
		else
			Form.SetCtlProp( sControl , "enable" , true)
			return
		end if
	next
	if sFlag == "1" then
		Form.SetCtlProp( sControl , "enable" , false)
	end if 
	
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' TriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "EnableDisableYN" then
		if sParam ~= nil and sParam ~= "" then
			g_sKindCode = sParam
			DATAMANAGER.RequestTranData( "obaci_acct_257r" ) '개인신용정보조회(계좌신용정보관리)
		end if
		
		
	end if
	
	if sEventName == "TabChange" then
		
		g_sCOMN_YN1 = Form.GetCtlProp( "#LabelCOMNYN1", "caption" )
		g_sCOMN_YN2 = Form.GetCtlProp( "#LabelCOMNYN2", "caption" )
		
		g_sPROD_YN1 = Form.GetCtlProp( "#LabelPRODYN1", "caption" )
		g_sPROD_YN2 = Form.GetCtlProp( "#LabelPRODYN2", "caption" )
		g_sPROD_YN3 = Form.GetCtlProp( "#LabelPRODYN3", "caption" )
		g_sPROD_YN4 = Form.GetCtlProp( "#LabelPRODYN4", "caption" )		'민감정보
		g_sPROD_YN5 = Form.GetCtlProp( "#LabelPRODYN5", "caption" )
		g_sPROD_YN6 = Form.GetCtlProp( "#LabelPRODYN6", "caption" )
		g_sPROD_YN7 = Form.GetCtlProp( "#LabelPRODYN7", "caption" )
		g_sPROD_YN8 = Form.GetCtlProp( "#LabelPRODYN8", "caption" )
		g_sPROD_YN9 = Form.GetCtlProp( "#LabelPRODYN9", "caption" )
		g_sPROD_YN10 = Form.GetCtlProp( "#LabelPRODYN10", "caption" )
		g_sPROD_YN11 = Form.GetCtlProp( "#LabelPRODYN11", "caption" )
		g_sPROD_YN12 = Form.GetCtlProp( "#LabelPRODYN12", "caption" )
		g_sPROD_YN13 = Form.GetCtlProp( "#LabelPRODYN13", "caption" )
		
		Cont0.Rdo0.currentindex = f_GetYNState(g_sCOMN_YN1)
		Cont0.Rdo1.currentindex = f_GetYNState(g_sCOMN_YN2)
		
		Cont0.Rdo2.currentindex = f_GetYNState(g_sPROD_YN1)
		Cont0.Rdo3.currentindex = f_GetYNState(g_sPROD_YN2)
		Cont0.Rdo4.currentindex = f_GetYNState(g_sPROD_YN3)
		Cont0.Rdo5.currentindex = f_GetYNState(g_sPROD_YN4)
		Cont0.Rdo6.currentindex = f_GetYNState(g_sPROD_YN5)
		Cont0.Rdo7.currentindex = f_GetYNState(g_sPROD_YN6)
		Cont0.Rdo8.currentindex = f_GetYNState(g_sPROD_YN7)
		Cont0.Rdo9.currentindex = f_GetYNState(g_sPROD_YN8)
		Cont0.Rdo10.currentindex = f_GetYNState(g_sPROD_YN9)
		Cont0.Rdo11.currentindex = f_GetYNState(g_sPROD_YN10)
		Cont0.Rdo12.currentindex = f_GetYNState(g_sPROD_YN11)
		Cont0.Rdo13.currentindex = f_GetYNState(g_sPROD_YN12)
		Cont0.Rdo14.currentindex = f_GetYNState(g_sPROD_YN13)
	
		for i = 0 to 14 
			Form.SetCtlProp("Cont0.Label"..i, "caption", "Y" )
		next
		
		f_SetAllCheck(0, 1, "Cont0.ChkAll0")
		f_SetAllCheck(2, 8, "Cont0.ChkAll1")
		f_SetAllCheck(9, 12, "Cont0.ChkAll2")
		f_SetAllCheck(13, 14, "Cont0.ChkAll3")
	elseif sEventName == "View" then
		Dim sTemp
		sTemp = Split(sParam, ";")	
		if sTemp[0] == "ok" then
			if sTemp[1] == "page0_common_sum" then
				Cont0.ChkButton0.checkstate = "1"
			elseif sTemp[1] == "page0_common_detail" then
				Cont0.ChkButton1.checkstate = "1"
			end if	
		else
			if sTemp[1] == "page0_common_sum" then
				Cont0.ChkButton0.checkstate = ".0"
			elseif sTemp[1] == "page0_common_detail" then
				Cont0.ChkButton1.checkstate = "0"
			end if	
		end if
	end if
End Sub

'============================================================================
' 요약동의서 확인
'============================================================================
Sub Cont0_ButtonSum_OnClick()
	Form.triggerEvent( "#", "View", "page0_common_sum" )
End Sub

'============================================================================
' 상세동의서 확인
'============================================================================
Sub Cont0_ButtonDetail_OnClick()
	Form.triggerEvent( "#", "View", "page0_common_detail" )	
End Sub

'============================================================================
' 수집이용 (공통) 일괄동의
'============================================================================
Sub Cont0_ChkAll0_OnChange(sCheckState)
	Dim sState
	
	if sCheckState == "1" then
		sState = "1"
		if Cont0.Label0.caption == "Y" then
			
			g_sCOMN_YN1 = "Y"
		end if
		if Cont0.Label1.caption == "Y" then
			g_sCOMN_YN2 = "Y"
		end if
	else
		sState = "-1"
		if Cont0.Label0.caption == "Y" then
			g_sCOMN_YN1 = ""
		end if
		if Cont0.Label1.caption == "Y" then
			g_sCOMN_YN2 = ""
		end if
	end if
	
	for i = 0 to 1
		if Form.GetCtlProp("Cont0.Label"..i, "caption") == "Y" then
			Form.SetCtlProp( "Cont0.Rdo"..i, "currentindex", sState )
		end if
	next
End Sub
'============================================================================
' 수집이용 (상품별) 일괄동의
'============================================================================
Sub Cont0_ChkAll1_OnChange(sCheckState)
	Dim sState
	
	if sCheckState == "1" then
		sState = "1"
		
		if Cont0.Label2.caption == "Y" then
			g_sPROD_YN1 = "Y"
		end if
		if Cont0.Label3.caption == "Y" then
			g_sPROD_YN2 = "Y"
		end if
		if Cont0.Label4.caption == "Y" then
			g_sPROD_YN3 = "Y"
		end if
		if Cont0.Label5.caption == "Y" then
			g_sPROD_YN4 = "Y"
		end if
		if Cont0.Label6.caption == "Y" then
			g_sPROD_YN5 = "Y"
		end if
		if Cont0.Label7.caption == "Y" then
			g_sPROD_YN6 = "Y"
		end if
		if Cont0.Label8.caption == "Y" then
			g_sPROD_YN7 = "Y"
		end if
	else
		sState = "-1"
		
		if Cont0.Label2.caption == "Y" then
			g_sPROD_YN1 = ""
		end if
		if Cont0.Label3.caption == "Y" then
			g_sPROD_YN2 = ""
		end if
		if Cont0.Label4.caption == "Y" then
			g_sPROD_YN3 = ""
		end if
		if Cont0.Label5.caption == "Y" then
			g_sPROD_YN4 = ""
		end if
		if Cont0.Label6.caption == "Y" then
			g_sPROD_YN5 = ""
		end if
		if Cont0.Label7.caption == "Y" then
			g_sPROD_YN6 = ""
		end if
		if Cont0.Label8.caption == "Y" then
			g_sPROD_YN7 = ""
		end if
	end if
	
	for i = 2 to 8
		if Form.GetCtlProp("Cont0.Label"..i, "caption") == "Y" then
			Form.SetCtlProp( "Cont0.Rdo"..i, "currentindex", sState )
		end if
	next
End Sub
