'============================================================================
'조건 그룹마다 선택되어 있는 상태를 배열에 설정해준다.
'iGroup : 조건그룹 1부터 시작
Sub f_setItemFlags(iGroup)
	Dim iIndex, iCount
	
	iGroupIndex = iGroup - 1	
	
	if (g_sGroup[iGroupIndex] <> "00") or (g_sGroup[iGroupIndex] <> "99") then
		szData = Split(g_sGroup[iGroupIndex], "|")
		
		iCount = #szData	'UBOUND(szData)		
'		Form.ShowAlert("f_setItemFlags", g_sGroup[iGroupIndex])
		for i=0 to iCount - 1
			iIndex = CInt(szData(i))
			
'			if CInt(iGroup) == 3 then
'				Form.ShowAlert("f_setItemFlags1", iGroup & "★" & g_sGroup[iGroupIndex] & "★" & 
'									  i & " : " & iIndex)
'			end if
			
			f_editGroupItemValue(iGroup, iIndex, True)
'			g_bGroup_Item[iGroupIndex][iIndex - 1] = True
		next
		
'		Form.ShowAlert("f_setItemFlags1", iGroup & "★" & g_sGroup[iGroupIndex] & "★" & 
'									  g_bGroup_Item[iGroupIndex][0] & " : " &
'									  g_bGroup_Item[iGroupIndex][1] & " : " &
'									  g_bGroup_Item[iGroupIndex][2] & " : " &
'									  g_bGroup_Item[iGroupIndex][3])
	end if	

end Sub

'============================================================================
'버튼들의 상태를 초기화 시킨다.
'iGroup : 필터 그룹 하나만 초기화   9: 전체 초기화
Sub f_setInitCtrls(iGroup)
	Dim iGroupIndex, iIndex
	
'	'버튼 상태 초기화
	if CInt(iGroup) == 9 then
		for i=0 to g_iGroupCount - 1
			
			g_cntGroup[i] = 0 'v002
			
			for j=0 to g_Max_ItemCount[i]
				Form.SetCtlProp("cont0.group" & CStr(i+1) & ".Label" & CStr(j), "fgcolor", "146")
				Form.SetCtlProp("cont0.group" & CStr(i+1) & ".Label" & CStr(j), "fontstyle", "00")
'				Form.SetCtlProp("cont0.group" & CStr(i+1) & ".Image" & CStr(j), "imgpath", "input_03_n.9.png")
				Form.SetCtlProp("cont0.group" & CStr(i+1) & ".Image" & CStr(j), "imgpath", "btn_line2_n.9.png")
				
			next
		next
		
	else
		iGroupIndex = CInt(iGroup) - 1
		
		g_cntGroup[iGroupIndex] = 0 'v002

		for i=0 to g_Max_ItemCount[iGroupIndex]
			Form.SetCtlProp("cont0.group" & CStr(iGroup) & ".Label" & CStr(i), "fgcolor", "146")
			Form.SetCtlProp("cont0.group" & CStr(iGroup) & ".Label" & CStr(i), "fontstyle", "00")
'			Form.SetCtlProp("cont0.group" & CStr(iGroup) & ".Image" & CStr(i), "imgpath", "input_03_n.9.png")
			Form.SetCtlProp("cont0.group" & CStr(iGroup) & ".Image" & CStr(i), "imgpath", "btn_line2_n.9.png")
		next
		
	end if
	
end Sub

'============================================================================
'조건 그룹별로 설정된 값으로 버튼상태를 바꾸어준다.
'배열에 저장된 값으로 버튼값  설정
Sub f_setCtrls(iGroup)
	Dim iGroupIndex
	
	if CInt(iGroup) == 9 then
		'초기화 선택했을 경우
		for i=0 to g_iGroupCount - 1
			Form.SetCtlProp("cont0.group" & CStr(i+1) & ".Label0", "fgcolor", "334")
			Form.SetCtlProp("cont0.group" & CStr(i+1) & ".Label0", "fontstyle", "01")
'			Form.SetCtlProp("cont0.group" & CStr(i+1) & ".Image0", "imgpath", "input_03_o.9.png")
			Form.SetCtlProp("cont0.group" & CStr(i+1) & ".Image0", "imgpath", "btn_line2_o.9.png")
		
			for j=0 to g_Max_ItemCount[i] - 1
				Form.SetCtlProp("cont0.group" & CStr(i+1) & ".Label" & CStr(j+1), "fgcolor", "146")
				Form.SetCtlProp("cont0.group" & CStr(i+1) & ".Label" & CStr(j+1), "fontstyle", "00")
'				Form.SetCtlProp("cont0.group" & CStr(i+1) & ".Image" & CStr(j+1), "imgpath", "input_03_n.9.png")
				Form.SetCtlProp("cont0.group" & CStr(i+1) & ".Image" & CStr(j+1), "imgpath", "btn_line2_n.9.png")
			next
		next
		
	else	
		iGroupIndex = CInt(iGroup) - 1
		if g_sGroup[iGroupIndex] == "00" then
			Form.SetCtlProp("cont0.group" & CStr(iGroup) & ".Label0", "fgcolor", "334")
			Form.SetCtlProp("cont0.group" & CStr(iGroup) & ".Label0", "fontstyle", "01")
'			Form.SetCtlProp("cont0.group" & CStr(iGroup) & ".Image0", "imgpath", "input_03_o.9.png")
			Form.SetCtlProp("cont0.group" & CStr(iGroup) & ".Image0", "imgpath", "btn_line2_o.9.png")
			
		else		'선택항목 표시
'			Form.ShowAlert("f_setCtrls1", g_bGroup_Item[iGroupIndex][0] & " : " &
'										  g_bGroup_Item[iGroupIndex][1] & " : " &
'										  g_bGroup_Item[iGroupIndex][2] & " : " &
'										  g_bGroup_Item[iGroupIndex][3])
			for i=0 to g_Max_ItemCount[iGroupIndex] - 1
				if g_bGroup_Item[iGroupIndex][i] then
					Form.SetCtlProp("cont0.group" & CStr(iGroup) & ".Label" & CStr(i+1), "fgcolor", "334")
					Form.SetCtlProp("cont0.group" & CStr(iGroup) & ".Label" & CStr(i+1), "fontstyle", "01")
'					Form.SetCtlProp("cont0.group" & CStr(iGroup) & ".Image" & CStr(i+1), "imgpath", "input_03_o.9.png")
					Form.SetCtlProp("cont0.group" & CStr(iGroup) & ".Image" & CStr(i+1), "imgpath", "btn_line2_o.9.png")
				end if
			next
					
		end if
	end if

end Sub

'============================================================================
'szGroup : 선택된 필터 그룹
'szItem : 선택된 항목 index  전체:99
Sub f_groupTogle(szGroup, szItem)
'	Form.ShowAlert("groupTogle1", szGroup & ":" & szItem)
	'상세검색 선택값 저장
	
	Dim iGroup, iIndex, iValue	
	iGroup = CInt(szGroup) - 1	
	g_sGroup[iGroup] = ""	
	
	if szItem == "00" then   '전체를 선택했을 경우
'		Form.ShowAlert("groupTogle1", szGroup & ":" & iGroup & ":" & szItem)

		if CInt(szGroup) == 9 then
			'초기화일 경우
			for i=0 to g_iGroupCount - 1 
				for j=0 to g_Max_ItemCount[i] - 1
					g_bGroup_Item[i][j] = False
				next
				
				g_sGroup[i] = szItem
			next
			
		else
			for i=0 to g_Max_ItemCount[iGroupIndex] - 1
				g_bGroup_Item[iGroup][i] = False
			next
	'		
			g_sGroup[iGroup] = szItem
		end if
'		Form.ShowAlert("groupTogle1", g_sGroup[iGroup])
		
	else
'		Form.ShowAlert("f_groupTogle1", g_sGroup[iGroup])
		
		'선택한 조건이 선택되어 있는지 값을 가지고 온다.
		iIndex = CInt(szItem) - 1
'			Form.ShowAlert("groupTogle1", iIndex & " : " & g_bGroup1_Item[iIndex] )

'		Form.ShowAlert("groupTogle1", iGroup & ":" & iIndex  & ":" & g_bGroup_Item[iGroup][iIndex])
		g_bGroup_Item[iGroup][iIndex] = not g_bGroup_Item[iGroup][iIndex]
'		Form.ShowAlert("groupTogle4", g_bGroup_Item[iGroup][iIndex])
					
'		for index, value in pairs(g_bGroup_Item[iGroup])
		
		for i = 0 to g_Max_ItemCount[iGroup] - 1
'			Form.ShowAlert("groupTogle5", i & ":" & g_bGroup_Item[iGroup][i])
			
'			Form.ShowAlert("f_groupTogle2", index .. " : " .. value .. " : " .. g_sGroup[iGroup])
			
			if g_bGroup_Item[iGroup][i] == True then
				if g_sGroup[iGroup] == "" then
					g_sGroup[iGroup] = (i+1)
				else
					g_sGroup[iGroup] = g_sGroup[iGroup] + "|" + (i+1)
				end if
				
				g_cntGroup[iGroup] = g_cntGroup[iGroup] + 1	'v002
				
			end if
			
'			Form.ShowAlert("f_groupTogle3", i .. " : " .. g_sGroup[iGroup])	
		next
'			Form.ShowAlert("groupTogle6", g_sGroup[iGroup])
		
		'아무것도 선택 안된 경우는 전체 선택으로 해줌.
'		if g_sGroup[iGroup] == "" then
		
		if g_sGroup[iGroup] == ""  then	
			g_sGroup[iGroup] = "00"
		elseif g_cntGroup[iGroup] == g_Max_ItemCount[iGroup] then' v002		
			g_sGroup[iGroup] = "00"
			f_resetGroupFilter(iGroup)	' v002
		end if
		
	end if	
	
	f_setInitCtrls( CInt(szGroup) )
	f_setCtrls( CInt(szGroup) )
	
'	szData = g_sGroup[0].."★"..g_sGroup[1].."★"..g_sGroup[2].."★"..g_sGroup[3]
'	
'	Form.ShowAlert("f_groupTogle4", szData)
End Sub



'============================================================================
' v002
Sub f_resetGroupFilter(iGroup)
	for i=0 to g_Max_ItemCount[iGroup] - 1
		g_bGroup_Item[iGroup][i] = False
	next
	
End Sub
