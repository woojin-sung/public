'============================================================================
Sub Form_OnFormInit()
'	Form.SetScreenName("상세조건 선택")
	
	Dim szData	
	
	for i=0 to g_iGroupCount-1
		table.insert(g_sGroup, "00")
		table.insert(g_sPrevGroup, "00")
	next
	
	g_bGroup_Item = {}
	for i=0 to g_iGroupCount-1
		g_bGroup_Item[i] = {}
		for j=0 to g_Max_ItemCount[i]-1
			g_bGroup_Item[i][j] = False
		next
	next
	
	f_setInitCtrls(9)
	
	szData = Form.GetOpenLinkData()
'	Form.ShowAlert("FormInit", szData)
	'1번그룹 선택조건★2번그룹 조건★3번그룹조건★4번그룹조건
'	szData = "1|2★99★3|4★1|2"
	
	if szData <> "" then
		g_tData = Split(szData, "★")
		
'		Form.ShowAlert("FormInit1", g_tData(0) & " : " & g_tData(1))
		for i=0 to g_iGroupCount-1			
			g_sGroup[i] = g_tData(i)
			g_sPrevGroup[i] = g_tData(i)
		next
'		Form.ShowAlert("FormInit1", g_sGroup[0] & " : " & g_sGroup[1] & " : " & g_sGroup[2] & " : " & g_sGroup[3])
			
'		'sData = sSpclYn.."★"..sKycGrad.."★"..sProsRslt.."★"..invtYn
'		'1:전문투자자여부
'		'2:일임KYC코드
'		'3:투자성향결과코드
'		'4:투자성향맞춤여부
'		
'		g_SpclYn   = g_tData(0)		' 전문투자자여부
'		g_ProsRslt = g_tData(2)		' 투자성향결과코드
'		g_invtYn   = g_tData(3)		' 투자성향맞춤여부
'		
'		if g_tData(0) = "Y" then
'			g_KycGrad  = "99"			' 일임KYC코드
'		else
'			if g_tData(3) = "Y" and g_tData(1) <> "" and int(g_tData(1)) <> 0 and g_tData(1) <> null then
'				g_KycGrad  = g_tData(1)	' 일임KYC코드
'			else
'				g_KycGrad  = "99"			' 일임KYC코드
'			end if
'		end if
'		
'	else
'		g_SpclYn   = "N"
'		g_KycGrad  = "99"
'		g_ProsRslt = ""
	end if
	
	'각 그룹마다 선택된 항목 설정
	f_setItemFlags(1)
	f_setItemFlags(2)
	f_setItemFlags(3)
	f_setItemFlags(4)
	
'	Form.ShowAlert("FormInit2", g_bGroup1_Item1 & ":" &
'						    g_bGroup1_Item2 & ":" &
'						    g_bGroup1_Item3 & ":" &
'						    g_bGroup1_Item4)
	'각 그룹마다 선택된 항목 표시
	f_setCtrls(1)
	f_setCtrls(2)
	f_setCtrls(3)
	f_setCtrls(4)
End Sub

