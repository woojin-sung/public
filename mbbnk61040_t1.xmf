'============================================================================
Sub cont01_imgLimit_OnClick()
	if g_szAccountNumber == "" then
		Form.ShowAlert("알림", "비밀번호를 입력해 주세요.")
	else
		Form.OpenPopup("mbbnk61040_p3" , g_szAccountNumber , sPosInfo)
	end if
End Sub

'============================================================================
Sub cont01_edtShow01_OnEditComplete()
	szLen = Form.GetByteLength(cont01.edtShow01.caption)

	if CDbl( szLen ) > 20 then
		Form.MsgBox("알림", "한글10자, 영문/숫자 20자까지 입력가능", "keypadok", 0)
		cont01.edtShow01.caption = ""
	end if	
End Sub

'============================================================================
Sub cont01_edtOutAcnt01_OnEditComplete()
	szLen = Form.GetByteLength(cont01.edtShow01.caption)

	if CDbl( szLen ) > 20 then
		Form.MsgBox("알림", "한글10자, 영문/숫자 20자까지 입력가능", "keypadok", 0)
		cont01.edtOutAcnt01.caption = ""
	end if	
End Sub

