'============================================================================
' Form_OnPopupReturn
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)

    If sKeyName == "이체기관" Then '금융기관선택에서 넘어온 데이터 
        Dim szList
        szList = Split(sRet, "★")
        If Ubound(szList) < 1 Then
			Exit Sub
        End If
		
        If Trim(szList(0)) <> "287" Then
            AccAcno.caption = g_szAccountNumber .. g_szAccountSerialNumber
            If AccAcno.caption <> g_szAccountNumber .. g_szAccountSerialNumber Then
                Form.MsgBox("알림", "타행자동이체는 CMA계좌만 가능합니다.", "", 0)
                Exit Sub
            End If		
        End If
	
        cont01.lblBankCode.caption = szList(0)
        cont01.edtOrg01.caption = szList(1)
        cont01.edtInAnct01.caption = ""
        cont01.edtAcnt01.caption = ""	
		
        If cont01.lblBankCode.caption == "287" Then 'v001
		
            cont01.btnReg01.enable      = True
            cont01.chkPolicy01.visible  = False
            cont01.btnPolicy01.visible  = False
            cont01.chkPrivacy01.visible = False
            cont01.ChkSumm.visible      = False
            cont01.BtnAgrmSumm.visible  = False
            cont01.ChkDtl.visible       = False
            cont01.BtnAgrmDtl.visible   = False
            cont01.btnReg01.top = 590
		    
        Else
	
            cont01.chkPolicy01.visible  = True
            cont01.btnPolicy01.visible  = True
            cont01.chkPrivacy01.visible = True
            cont01.ChkSumm.visible      = True
            cont01.BtnAgrmSumm.visible  = True
            cont01.ChkDtl.visible       = True
            cont01.BtnAgrmDtl.visible   = True
            cont01.btnReg01.top = 724
            CommonCheck()

        End If
		
    End If
	
	if sKeyName == "mbbnk61040_pb" then	'타행자동이체약관 
		if sRet == "ok" then	'타행자동이체약관성공
			cont01.chkPolicy01.checkstate = true
			'if cont01.chkPrivacy01.checkstate == "1" then
				'cont01.btnReg01.enable = true
			'else
				'cont01.btnReg01.enable = false
			'end if			
		else		'실패
			cont01.chkPolicy01.checkstate = false
			'cont01.btnReg01.enable = false			
		end if
		
		CommonCheck() 'v001
	end if	
	
	If sKeyName == "mbbnk61040_pc" then	'개인신용정보 요약동의서 v001
	    If sRet == "ok" Then
	        cont01.ChkSumm.checkstate = True
        Else
             cont01.ChkSumm.checkstate = False
        End If
	
	    CommonCheck()
	End If
	
	If sKeyName == "mbbnk61040_pd" then	'개인신용정보 상세동의서 v001
	    If sRet == "ok" Then
	        cont01.ChkDtl.checkstate = True
        Else
             cont01.ChkDtl.checkstate = False
        End If
	
	    CommonCheck()
	End If	
	
	if sKeyName == "61010_OFTEN" or sKeyName == "mbbnk61040_p5" then '자주쓰는계좌/최근이체계좌
		If sRet <> "" then
			tData = Split(sRet, "★")
			cont01.edtAcnt01.caption = tData(3)
			cont01.edtInAnct01.caption = Replace(tData(2),"-","")
			cont01.edtOrg01.caption = tData(4)
			cont01.lblBankCode.caption = tData(1)
			
			'메리츠일 때
			if Trim(cont01.lblBankCode.caption) == "287" then
				cont01.lblFee.caption = "0"
			else	'금융기관이 메리츠가 아닐 때(타행이체)
				DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_BANK_CODE" , 0 , Trim(cont01.lblBankCode.caption))	'입금은행코드
				DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "JOB_TRNO", 0 , "031")		'작업단말번호	
				DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_ACNO", 0 , Trim(cont01.edtInAnct01.caption))		'입금계좌번호
				
				if Trim(cont01.edtOutAmt01.caption) == "" then
					DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "TR_AMT" , 0 , "1")		'거래금액
				else
					DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "TR_AMT" , 0 , Trim(cont01.edtOutAmt01.caption))		'거래금액		
				end if
				
				DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "DRNG_ACNO", 0 , g_szAccountNumber)				'출금계좌번호
				DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "ACNT_PROD_CLS_CODE", 0 , g_szAccountSerialNumber)	'계좌상품코드
				DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "PWD", 0 , g_szAccountPassword)	'계좌비밀번호
				DATAMANAGER.RequestTranData("obtss_elbs_129r")
			end if
			
		    If cont01.lblBankCode.caption == "287" Then 'v001
		
		        cont01.btnReg01.enable = True
		        cont01.chkPolicy01.visible = False
		        cont01.btnPolicy01.visible = False
		        cont01.chkPrivacy01.visible = False
		        cont01.ChkSumm.visible = False
		        cont01.BtnAgrmSumm.visible = False
		        cont01.ChkDtl.visible = False
		        cont01.BtnAgrmDtl.visible = False
  		        cont01.btnReg01.top = 590
		    
		    Else
		        cont01.chkPolicy01.visible = True
		        cont01.btnPolicy01.visible = True
		        cont01.chkPrivacy01.visible = True
		        cont01.ChkSumm.visible = True
		        cont01.BtnAgrmSumm.visible = True
		        cont01.ChkDtl.visible = True
		        cont01.BtnAgrmDtl.visible = True
		        cont01.btnReg01.top = 724
		        CommonCheck()
		    End If
		    
		end if
		
	elseif sKeyName == "QUICK" then '빠른이체추가 
		If sRet <> "" then
			Dim tData2
			tData2 = Split(sRet, "|")
			if Form.GetCtlProp("#acnt01", "caption") <> tData2(1) then
				Form.SetCtlProp("#acnt01", "caption", tData2(1)) 
			end if
            if Ubound(tData2) > 0 then
			   cont01.edtAcnt01.caption = tData2(4)
			   cont01.edtOrg01.caption = tData2(3)
			   cont01.lblBankCode.caption = tData2(2)
			   cont01.edtOutAmt01.caption = tData2(5)
			   cont01.edtInAnct01.caption = tData2(6)
			   cont01.edtShow01.caption = tData2(7)
			   cont01.edtOutAcnt01.caption = tData2(8)
'			   Form.ShowAlert( "알림", "빠른이체로 등록 완료되었습니다.")
			end if
			
		    If cont01.lblBankCode.caption == "287" Then 'v001
		
		        cont01.btnReg01.enable = True
		        cont01.chkPolicy01.visible = False
		        cont01.btnPolicy01.visible = False
		        cont01.chkPrivacy01.visible = False
		        cont01.ChkSumm.visible = False
		        cont01.BtnAgrmSumm.visible = False
		        cont01.ChkDtl.visible = False
		        cont01.BtnAgrmDtl.visible = False
  		        cont01.btnReg01.top = 590
		    
		    Else
		        cont01.chkPolicy01.visible = True
		        cont01.btnPolicy01.visible = True
		        cont01.chkPrivacy01.visible = True
		        cont01.ChkSumm.visible = True
		        cont01.BtnAgrmSumm.visible = True
		        cont01.ChkDtl.visible = True
		        cont01.BtnAgrmDtl.visible = True
		        cont01.btnReg01.top = 724
		        CommonCheck()
		    End If			
		end if
	elseif sKeyName == "mbbnk61010_p9" then	'지정단말 등록시
		if sRet == "Yes" then
			Dim szJumin
			szJumin = Form.GetSharedData("&JUMIN_NUM", false )	'주민번호
			
			szAllInform = g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & Trim(cont01.edtOrg01.caption) & "★" & Trim(cont01.lblBankCode.caption) & "★" & Trim(cont01.edtInAnct01.caption) & "★" &
			Trim(cont01.Combo1.caption)  & "★" & Trim(cont01.edtOutAmt01.caption) & "★" & Trim(szJumin) & "★" &
			Trim(cont01.cldStartDate01.caption) & "★" & Trim(cont01.cldEndDate01.caption) & "★" & Trim(cont01.lblFee.caption) & "★" &
			Trim(g_szAccountPassword) & "★" & Trim(cont01.edtAcnt01.caption) 
			if cont01.edtOutAcnt01.caption == "" then
				szAllInform = szAllInform & "★" & g_szAccountName
		'		szAllInform = szAllInform & "★" & Trim(cont01.edtAcnt01.caption)
			else
				szAllInform = szAllInform & "★" & Trim(cont01.edtOutAcnt01.caption)
			end if
			szAllInform = szAllInform & "★" & Trim(g_szAccountName) & "★" & Trim(cont01.edtShow01.caption) & "★" & g_szPlusUI
			
			'(타사계좌실예금주명(입금계좌명)/ 예금주명(받는분통장표시)/계좌번호실예금주명(출금계좌명)/입금기관예금주명(내통장표시))
			Form.OpenPopup("mbbnk61040_p2" , szAllInform , sPosInfo)
		end if
	end if
	
	if sKeyName == "Clear" then	'성공시
		'전체 초기화
		cont01.cmmShow01.currentindex = 0	'내통장표시콤보
		cont01.edtShow01.caption = ""	'내통장표지
		cont01.edtOrg01.caption = ""	'금융기관
		cont01.edtInAnct01.caption = ""	'입금계좌번호
		cont01.edtAcnt01.caption = "" 	'계좌명조회
		cont01.edtOutAcnt01.caption = "" 	'받는분통장표시
		cont01.edtOutAble01.caption = "" 	'출금가능금액
		cont01.edtOutAmt01.caption = ""		'이체금액
		cont01.Combo1.currentindex = 0	'이체지정일콤보
		cont01.lblBankCode.caption = "" '금융기관코드
		cont01.lblFee.caption = "" '수수료
		cont01.chkPrivacy01.checkstate = "0"
		cont01.chkPolicy01.checkstate = "0"
		cont01.ChkSumm.checkstate = "0"
		cont01.ChkDtl.checkstate = "0"
		
		cont01.btnReg01.enable = false
		
		DATAMANAGER.RequestTranData("obrtp_drab_001r")	'출금가능금액조회
	end if
	
End Sub

