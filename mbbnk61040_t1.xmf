'============================================================================
Sub CommonCheck()
    
    If cont01.ChkSumm.checkstate == "1" Or cont01.ChkDtl.checkstate == "1" Then
        cont01.chkPrivacy01.checkstate = True
	Else
	    cont01.chkPrivacy01.checkstate = False
    End If
    
    If cont01.chkPolicy01.checkstate == "1" And cont01.chkPrivacy01.checkstate == "1" Then
        cont01.btnReg01.enable = True
    Else
        cont01.btnReg01.enable = False
    End If

End Sub

