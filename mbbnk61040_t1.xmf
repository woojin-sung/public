'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : 정기이체
' 02. 화면설명 : 정기이체_정기이체등록탭
' 03. 작    성 : 16.03.08
' 04. 수    정 : 21.05.21 장원혁 v001 : 개인신용정보 처리 동의 업무 변경
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szAccountNumber	'계좌번호(8자리)
Dim g_szAccountSerialNumber	'계좌일련번호(2자리)
Dim g_szAccountPassword	'계좌비밀번호
Dim g_szAccount		'계좌번호+일련번호
Dim g_szAccountName

Dim g_szPlusUI	'추가인증 팝업 여부
DIm g_szTrPass	'지정단말 등록 팝업 여부
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent - 트리거 이벤트 들어옴
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)

	if sEventName == "Password" then
		g_szAccountPassword = sParam
	end if
	
	if sEventName == "AllAccount" then
		Dim szList
		szList = Split(sParam, "★")
		
		if UBOUND(szList) < 1 then
			exit sub
		end if
		g_szAccount = szList(0) & szList(1)
		g_szAccountNumber = szList(0)
		g_szAccountSerialNumber = szList(1)
		if szList(2) == "" then
			g_szAccountPassword = ""
		else
			g_szAccountPassword = szList(2)
		end if
		
		g_szAccountName = szList(3)
		
		'전체 초기화
		cont01.cmmShow01.currentindex = 0	'내통장표시콤보
		cont01.edtShow01.caption = ""	'내통장표지
		cont01.edtOrg01.caption = ""	'금융기관
		cont01.edtInAnct01.caption = ""	'입금계좌번호
		cont01.edtAcnt01.caption = "" 	'계좌명조회
		cont01.edtOutAcnt01.caption = "" 	'받는분통장표시
		cont01.edtOutAble01.caption = "" 	'출금가능금액
		cont01.edtOutAmt01.caption = ""		'이체금액
		cont01.Combo1.currentindex = 0	'이체지정일콤보
		cont01.lblBankCode.caption = "" '금융기관코드
		cont01.lblFee.caption = "" '수수료
		
		cont01.btnReg01.enable = false
		
		
		'출금가능금액 셋팅
		'obrtp_drab_001r 조회
		
		if Len(Trim(g_szAccount)) <> 10 then
			Form.MsgBox("알림", "계좌번호를 확인후 다시 입력하십시오.", "", 0)
			exit sub
		end if			
	
		DATAMANAGER.SetDataValue(0, "obrtp_drab_001r", "InBlock1", "ACNO" , 0 , g_szAccountNumber)	'출금계좌번호
		DATAMANAGER.SetDataValue(0, "obrtp_drab_001r", "InBlock1", "ASNO" , 0 , g_szAccountSerialNumber)	'출금계좌일련번호
		DATAMANAGER.SetDataValue(0,  "obrtp_drab_001r", "InBlock1", "SMCD", 0 , "102020")
		DATAMANAGER.SetDataValue(0, "obrtp_drab_001r", "InBlock1", "SUMR_DRNG_YN" , 0 , "N")	'적요출금여부 Form.GetSharedData( "#BCP_BIZ_DT", False )
		DATAMANAGER.RequestTranData("obrtp_drab_001r")	'출금가능금액조회
	end if
	
End Sub

'============================================================================
' cont01_btnOrg01_OnClick - 금융기관 선택팝업
'============================================================================
Sub cont01_btnOrg01_OnClick()
	'은행코드와 은행이름이 넘어옴
	Form.OpenPopup("mbbnk61010_p3" , sOpenData , sPosInfo)
End Sub

'============================================================================
' cont01_btnAcnt01_OnClick - 계좌명조회
'============================================================================
Sub cont01_btnAcnt01_OnClick()
	'obtss_elbs_129r 조회
	'단 금융기관이 메리츠인 경우 obrtd_drng_025r로 조회
	'mhhts07200.xgm계좌명조회 참조
	
	if Len(Trim(g_szAccount)) <> 10 then
		Form.MsgBox("알림", "출금계좌번호가 올바르지 않습니다.", "", 0)
		exit sub
	end if
	
	if Trim(g_szAccountPassword) == "" then
		Form.MsgBox("알림", "비밀번호를 입력해 주세요.", "", 0)
		exit sub
	end if
	
	if Trim(cont01.edtOrg01.caption) == "" then
		Form.MsgBox("알림", "입급은행이 선택되지 않았습니다", "", 0)
		exit sub
	end if
	
	if Trim(cont01.edtInAnct01.caption) == "" then
		Form.MsgBox("알림", "입금계좌번호가 입력되지 않았습니다.", "", 0)
		exit sub
	end if
	
	'메리츠일 때
	if Trim(cont01.lblBankCode.caption) == "287" then
		if Len(Trim(cont01.edtInAnct01.caption)) <> 10 then
			Form.MsgBox("알림", "당행 계좌번호를 잘못 입력하셨습니다.", "", 0)
			exit sub
		end if
		
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "ACNO", 0 , g_szAccountNumber)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "ASNO" , 0 , g_szAccountSerialNumber)	'계좌일련번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "PWD" , 0 , g_szAccountPassword)			'계좌비밀번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "USE_YN", 0 , "N")	'사용여부
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ACNO", 0 , Mid(cont01.edtInAnct01.caption, 1, 8))	'상대계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r", "InBlock1", "CNFT_ASNO", 0 , Mid(cont01.edtInAnct01.caption, 9, 2))	'상대계좌일련번호
		DATAMANAGER.RequestTranData("obrtd_drng_025r")
		cont01.lblFee.caption = "0"
			
	else	'금융기관이 메리츠가 아닐 때(타행이체)
		'if Trim(cont01.edtOutAmt01.caption) == "" then
			'Form.MsgBox("Meritz", "이체금액을 입력하지 않았습니다.", "", 0)
			'exit sub
		'end if
		
		if Trim(cont01.edtInAnct01.caption) == "" then	
			Form.ShowAlert("알림", "입금계좌번호를 입력하지 않았습니다.")
			exit sub
		end if

		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_BANK_CODE" , 0 , Trim(cont01.lblBankCode.caption))	'입금은행코드
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "JOB_TRNO", 0 , "031")		'작업단말번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "MNRC_ACNO", 0 , Trim(cont01.edtInAnct01.caption))		'입금계좌번호
		
		if Trim(cont01.edtOutAmt01.caption) == "" then
			DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "TR_AMT" , 0 , "1")		'거래금액
		else
			DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "TR_AMT" , 0 , Trim(cont01.edtOutAmt01.caption))		'거래금액		
		end if
	
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "DRNG_ACNO", 0 , g_szAccountNumber)				'출금계좌번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "ACNT_PROD_CLS_CODE", 0 , g_szAccountSerialNumber)	'계좌상품코드
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r", "InBlock1", "PWD", 0 , g_szAccountPassword)	'계좌비밀번호
		DATAMANAGER.RequestTranData("obtss_elbs_129r")	
	end if	
End Sub


