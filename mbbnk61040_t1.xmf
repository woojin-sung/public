'============================================================================
' cont01_btnLimitQry01_OnClick - 이체한도조회 팝업
'============================================================================
Sub cont01_btnLimitQry01_OnClick()
	if g_szAccountNumber == "" then
		Form.ShowAlert("알림", "비밀번호를 입력해 주세요.")
	else
		Form.OpenPopup("mbbnk61040_p3" , g_szAccountNumber , sPosInfo)
	end if
End Sub


'============================================================================
' cont01_btnReg01_OnClick - 입력정보확인화면
'============================================================================
Sub cont01_btnReg01_OnClick()
	Dim szAllInform	
	
	if g_szAccountPassword == "" then
		Form.ShowAlert("알림", "비밀번호를 입력해 주세요.")
		exit sub
	end if
	
	if CInt(cont01.cldStartDate01.caption) > CInt(cont01.cldEndDate01.caption) then
		Form.MsgBox("알림", "이체개시월 설정이 잘못되었습니다.", "", 0)
		cont01.cldStartDate01.caption = cldToday.caption
		exit sub
	end if
	
	if Trim(cont01.lblBankCode.caption) == "" then	'은행코드 없다는 뜻은 은행설정안함
		Form.ShowAlert("알림", "입급은행을 선택하세요")
		exit sub
	end if
	
	if Trim(cont01.edtInAnct01.caption) == "" then	'수취계좌 없음
		Form.ShowAlert("알림", "입금계좌를 입력하세요")
		exit sub
	end if
	
	if Trim(cont01.edtOutAmt01.caption) == "" then	'이체금액이 없음
		Form.ShowAlert("알림", "이체금액을 입력하세요")
		exit sub
	end if

	
	'메리츠일 때
	if Trim(cont01.lblBankCode.caption) == "287" then
		if Len(Trim(cont01.edtInAnct01.caption)) <> 10 then
			Form.MsgBox("알림", "당행 계좌번호를 잘못 입력하셨습니다.", "", 0)
			exit sub
		end if
		
		DATAMANAGER.SetDataValue(0,  "obrtd_drng_025r_1", "InBlock1", "ACNO", 0 , g_szAccountNumber)	'계좌번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r_1", "InBlock1", "ASNO" , 0 , g_szAccountSerialNumber)	'계좌일련번호
		DATAMANAGER.SetDataValue(0, "obrtd_drng_025r_1", "InBlock1", "PWD" , 0 , g_szAccountPassword)			'계좌비밀번호
		DATAMANAGER.SetDataValue(0,  "obrtd_drng_025r_1", "InBlock1", "USE_YN", 0 , "N")	'사용여부
		DATAMANAGER.SetDataValue(0,  "obrtd_drng_025r_1", "InBlock1", "CNFT_ACNO", 0 , Mid(cont01.edtInAnct01.caption, 1, 8))	'상대계좌번호
		DATAMANAGER.SetDataValue(0,  "obrtd_drng_025r_1", "InBlock1", "CNFT_ASNO", 0 , Mid(cont01.edtInAnct01.caption, 9, 2))	'상대계좌일련번호
		DATAMANAGER.RequestTranData("obrtd_drng_025r_1")
		cont01.lblFee.caption = "0"
			
	else	'금융기관이 메리츠가 아닐 때(타행이체)
		'if Trim(cont01.edtOutAmt01.caption) == "" then
			'Form.MsgBox("Meritz", "이체금액을 입력하지 않았습니다.", "", 0)
			'exit sub
		'end if
		
		if Trim(cont01.edtInAnct01.caption) == "" then	
			Form.ShowAlert("알림", "입금계좌번호를 입력하지 않았습니다.")
			exit sub
		end if

		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r_1", "InBlock1", "MNRC_BANK_CODE" , 0 , Trim(cont01.lblBankCode.caption))	'입금은행코드
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r_1", "InBlock1", "JOB_TRNO", 0 , "031")		'작업단말번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r_1", "InBlock1", "MNRC_ACNO", 0 , Trim(cont01.edtInAnct01.caption))		'입금계좌번호
		
		if Trim(cont01.edtOutAmt01.caption) == "" then
			DATAMANAGER.SetDataValue(0, "obtss_elbs_129r_1", "InBlock1", "TR_AMT" , 0 , "1")		'거래금액
		else
			DATAMANAGER.SetDataValue(0, "obtss_elbs_129r_1", "InBlock1", "TR_AMT" , 0 , Trim(cont01.edtOutAmt01.caption))		'거래금액		
		end if
	
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r_1", "InBlock1", "DRNG_ACNO", 0 , g_szAccountNumber)				'출금계좌번호
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r_1", "InBlock1", "ACNT_PROD_CLS_CODE", 0 , g_szAccountSerialNumber)	'계좌상품코드
		DATAMANAGER.SetDataValue(0, "obtss_elbs_129r_1", "InBlock1", "PWD", 0 , g_szAccountPassword)	'계좌비밀번호
		DATAMANAGER.RequestTranData("obtss_elbs_129r_1")	
	end if	
	
	
'	g_szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID	
'	'16-03-08  Input값 수정 MAC주소 -> DeviceID
