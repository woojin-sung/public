'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)

    szSubErr = DATAMANAGER.GetDataMsgSubText(szTranID)

    If Trim(szSubErr) == "" Then
        Form.ShowAlert("알림", szErrMsg)
    Else
        Form.ShowAlert("알림", szErrMsg .. "\n(" .. szSubErr .. ")")
    End If
    
End Sub

'============================================================================
Sub Form_OnFormInit()

	cont01.btnReg01.enable = False
	cont01.chkPolicy01.visible = False
	cont01.btnPolicy01.visible = False
	cont01.chkPrivacy01.visible = False
	cont01.ChkSumm.visible = False
	cont01.BtnAgrmSumm.visible = False
	cont01.ChkDtl.visible = False
	cont01.BtnAgrmDtl.visible = False
	cont01.btnReg01.top = 590
' 그해 12월로 셋팅함.
'	sMonth = cont01.cldEndDate01.calmonth 
'	nTemp =  (12 - Cint(sMonth)) * 30
	
'	cont01.cldEndDate01.addday =  Cstr(nTemp )
	
	sYear = cont01.cldEndDate01.calyear
	cont01.cldEndDate01.caption = sYear.."1231"
	
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obcsb_oimf_638r" then
		g_szPlusUI = Trim(DATAMANAGER.GetDataValue(0, "obcsb_oimf_638r", "OutBlock1", "SPLM_ATHN_NCSR_YN", 0 ))'추가인증팝업여부
		g_szTrPass = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r", "OutBlock1", "UI_SPLM_YN" , 0)	'단말기지정팝업여부
		
		if g_szTrPass == "Y" then
			Form.OpenPopup("mbbnk61010_p9" , "" , "") '단말기지정필요--------
			Exit Sub
		end if
		
		Dim szJumin
		szJumin = Form.GetSharedData("&JUMIN_NUM", false )	'주민번호
		
		szAllInform = g_szAccountNumber & "★" & g_szAccountSerialNumber & "★" & Trim(cont01.edtOrg01.caption) & "★" & Trim(cont01.lblBankCode.caption) & "★" & Trim(cont01.edtInAnct01.caption) & "★" &
		Trim(cont01.Combo1.caption)  & "★" & Trim(cont01.edtOutAmt01.caption) & "★" & Trim(szJumin) & "★" &
		Trim(cont01.cldStartDate01.caption) & "★" & Trim(cont01.cldEndDate01.caption) & "★" & Trim(cont01.lblFee.caption) & "★" &
		Trim(g_szAccountPassword) & "★" & Trim(cont01.edtAcnt01.caption) 
		if cont01.edtOutAcnt01.caption == "" then
			szAllInform = szAllInform & "★" & g_szAccountName
	'		szAllInform = szAllInform & "★" & Trim(cont01.edtAcnt01.caption)
		else
			szAllInform = szAllInform & "★" & Trim(cont01.edtOutAcnt01.caption)
		end if
		szAllInform = szAllInform & "★" & Trim(g_szAccountName) & "★" & Trim(cont01.edtShow01.caption) & "★" & g_szPlusUI
		
		If Trim(cont01.lblBankCode.caption) == "287" then 'v001
		    Form.SetSharedData("mbbnk61040_AGRM_CLCD" , "")
		Else
		    If cont01.ChkSumm.checkstate == "1" And cont01.ChkDtl.checkstate <> "1" Then '요약동의서
		        Form.SetSharedData("mbbnk61040_AGRM_CLCD" , "1") '요약
		    ElseIf cont01.ChkSumm.checkstate <> "1" And cont01.ChkDtl.checkstate == "1" Then '상세동의서
		        Form.SetSharedData("mbbnk61040_AGRM_CLCD" , "2") '상세
		    ElseIf cont01.ChkSumm.checkstate == "1" And cont01.ChkDtl.checkstate == "1" Then '요약+상세 동의서
		        Form.SetSharedData("mbbnk61040_AGRM_CLCD" , "3") '요약+상세
		    Else
		        Form.SetSharedData("mbbnk61040_AGRM_CLCD" , "")    
		    End If
		End If
		
		'(타사계좌실예금주명(입금계좌명)/ 예금주명(받는분통장표시)/계좌번호실예금주명(출금계좌명)/입금기관예금주명(내통장표시))
		Form.OpenPopup("mbbnk61040_p2" , szAllInform , sPosInfo)
	
	'16-04-15 YCJ 박영택 과장님 전달사항, 타은행 수취 조회시 TR Output Fee 사용하지 말고 수수료에 강제로 "300" 입력, 홈페이지 동일 사항이라고함.
	'24-04-25 타행이체 수수수료 0원
	elseif szTranID == "obtss_elbs_129r" then
		cont01.lblFee.caption = "0"
	
	elseif szTranID == "obrtd_drng_025r_1" or szTranID == "obtss_elbs_129r_1" then

		if szTranID == "obtss_elbs_129r_1" then
			cont01.lblFee.caption = "0"
		end if

		g_szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID	
		'16-03-08  Input값 수정 MAC주소 -> DeviceID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , g_szUserId)	'사용자ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID())	'UI단말식별키
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "300")'이체	'기본 '200'  등록 '400'
		DATAMANAGER.SetDataValue(0,  "obcsb_oimf_638r", "InBlock2", "DRNG_ACNO" , 0, g_szAccountNumber )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "DRNG_ASNO", 0, g_szAccountSerialNumber )
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_BANK_CODE", 0 , Trim(cont01.lblBankCode.caption))		'
		if Trim(cont01.lblBankCode.caption) == "287" then '당사
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "TACT_CLS_CODE", 0 ,"01")'대체출금
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ACNO", 0, Left(cont01.edtInAnct01.caption, 8))
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ASNO", 0, Right(cont01.edtInAnct01.caption, 2))
		else
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "TACT_CLS_CODE", 0 ,"03")'이체출금
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ACNO", 0, cont01.edtInAnct01.caption)
			DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ASNO", 0, "")
		end if
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "TACT_AMT" , 0, cont01.edtOutAmt01.caption)		'대체금액
		DATAMANAGER.RequestTranData("obcsb_oimf_638r")
	end if
	
	
End Sub

