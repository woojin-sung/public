'============================================================================
' 01. 화 면 명 : 고객자산평가_상품별잔고_기타금융상품
' 02. 화면설명 : 고객자산평가_상품별잔고_기타금융상품
' 03. 작    성 : 2016. 02. 03. 유창재
'		      : 2022.03.22 김유경 : v001. 예금자보호법 관련 안내 문구 추가 (상품구분이 외화채권인 경우에만 조회)
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szList		'
Dim g_nNextCount	'NextData 조회시 grid Index값 설정을 위한 변수
Dim g_nCmbIndex	'콤보 Index값
Dim g_nAcntCount	'계좌 개수	
Dim g_nAllCount	'전체조회시 계좌 Index
'Dim g_szTranID	'계좌변경시 가장 최근 TranID
'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' AllSearch() : 데이터 전체조회시
'============================================================================
Function AllSearch(szTranID)
	g_nAllCount = g_nAllCount - 1
	
	if g_nAllCount > 2 then
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , g_szList(CDbl(g_nAllCount)) )		'계좌번호
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
		
		DATAMANAGER.RequestTranData( szTranID )
	end if

End Function
'============================================================================
' InQuery(szTranID) : TR 입력, 조회
'============================================================================
Function InQuery(szTranID)
	DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNO" , 0 , g_szList(3) )		'계좌번호
'	DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ACNT_PWD" , 0 , g_szList(1) )	'비밀번호
	DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜

	g_nNextCount = 0
	DATAMANAGER.RequestTranData( szTranID )
End Function
'============================================================================
' CleanGrd() : 모든 그리드 숨김 처리
'============================================================================
Function CleanGrd()

	grd0.visible = false
	grd1.visible = false
	grd2.visible = false
	grd3.visible = false
	grd4.visible = false
	grd5.visible = false
	grd6.visible = false
	grd7.visible = false
	grd8.visible = false
	grd9.visible = false
	grd10.visible = false
	Label0.visible = false 'v001
	
	grd0.SetClear()
	grd1.SetClear()
	grd2.SetClear()
	grd3.SetClear()
	grd4.SetClear()
	grd5.SetClear()
	grd6.SetClear()
	grd7.SetClear()
	grd8.SetClear()
	grd9.SetClear()
	grd10.SetClear()

End Function
'============================================================================
' GrdVisible(szTranID) : 그리드 보임 처리
'============================================================================
Function GrdVisible(szTranID)
	
	Select Case szTranID
		Case "obacb_balc_031r"		'RP
			CleanGrd()
			grd0.visible = true
		Case "obacb_balc_111r"		'발행어음
			CleanGrd()
			grd1.visible = true
		Case "obacb_balc_040r"		'신탁
			CleanGrd()
			grd2.visible = true
		Case "obacb_balc_032r"		'CD, CP/전단채
			CleanGrd()
			grd3.visible = true
		Case "obacb_balc_034r"		'해외증권/외화예수금
			CleanGrd()
			grd4.visible = true
		Case "obacb_balc_035r"		'MMW
			CleanGrd()
			grd5.visible = true
		Case "obacb_balc_112r"		'어음관리계좌
			CleanGrd()
			grd6.visible = true
		Case "obacb_balc_078r"		'해외뮤추얼펀드
			CleanGrd()
			grd7.visible = true
		Case "obacb_balc_079r"		'외화표시펀드
			CleanGrd()
			grd8.visible = true
		Case "obacb_balc_131r"		'외화RP
			CleanGrd()
			grd9.visible = true
		Case "obacb_balc_087r"      '외화채권 
			CleanGrd()
			grd10.visible = true
	End Select
	
End Function
'============================================================================
' CleanGrd() : 모든 TR 연결 해제
'============================================================================
Function CleanTR()
	DATAMANAGER.ClearTranConnectedCtrl("obacb_balc_031r")
	DATAMANAGER.ClearTranConnectedCtrl("obacb_balc_111r")
	DATAMANAGER.ClearTranConnectedCtrl("obacb_balc_040r")
	DATAMANAGER.ClearTranConnectedCtrl("obacb_balc_032r")
	DATAMANAGER.ClearTranConnectedCtrl("obacb_balc_034r")
	DATAMANAGER.ClearTranConnectedCtrl("obacb_balc_035r")
	DATAMANAGER.ClearTranConnectedCtrl("obacb_balc_112r")
	DATAMANAGER.ClearTranConnectedCtrl("obacb_balc_078r")
	DATAMANAGER.ClearTranConnectedCtrl("obacb_balc_079r")
	DATAMANAGER.ClearTranConnectedCtrl("obacb_balc_131r")
	DATAMANAGER.ClearTranConnectedCtrl("obacb_balc_087r")
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam)
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "mbact71050_p7" then			'기타_RP
	
		g_szList = Split(sParam,"○")
		
	end if
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if
	
	GrdVisible( cmb0.cbkeydata )
	
	g_nAcntCount = g_szList(0)		'계좌개수
	
	g_nAllCount = 4 + g_nAcntCount	'마지막 계좌 
	
	g_nNextCount = 0
	
	if g_szList(1) == "Y" then
		grd0.rowcount = 0
		AllSearch( cmb0.cbkeydata )
	else
		cmb0_OnEditComplete( g_nCmbIndex )
	end if
	
	
'	DATAMANAGER.SetDataValue( 0 , "obacb_balc_031r", "InBlock1", "ACNO" , 0 , g_szList(0) )		'계좌번호
'	DATAMANAGER.SetDataValue( 0 , "obacb_balc_031r", "InBlock1", "ACNT_PWD" , 0 , g_szList(1) )	'비밀번호
'	DATAMANAGER.SetDataValue( 0 , "obacb_balc_031r", "InBlock1", "STND_DATE" , 0 , g_szList(2) )	'날짜
'
'	DATAMANAGER.RequestTranData( "obacb_balc_031r" )
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szTemp0, szTemp1, szTemp2, szTemp3, szTemp4, szTemp5, szTemp6, szTemp7, szTemp8, szTemp9, szTemp10, szTemp11,
		szTemp11, TempCount

	'계좌번호블록에 계좌번호+계좌명으로 출력
	if szTranID == "obacb_balc_031r" then			'RP
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obacb_balc_031r", "OutBlock2")-1
			
			grd0.AddRow()
			
			szTemp0 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_031r", "OutBlock2", "ACNO" , i) &
				DATAMANAGER.GetDataValue( 0 , "obacb_balc_031r", "OutBlock2", "ASNO" , i)	'계좌번호
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_031r", "OutBlock2", "ABRV_ISNM" , i)	'종목명
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_031r", "OutBlock2", "MNRC_AMT" , i)	'매수금액
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_031r", "OutBlock2", "VLTN_AMT" , i)	'세후평가금액
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_031r", "OutBlock2", "BYOV_DATE" , i)	'매수일
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_031r", "OutBlock2", "MTRT_DATE" , i)	' 만기일
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_031r", "OutBlock2", "STPL_INTRT" , i)	'약정이율
			szTemp7 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_031r", "OutBlock2", "HLFW_RPRC_INRT" , i)	'약정전이율
			szTemp8 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_031r", "OutBlock2", "MTRT_AFT_APLY_INRT" , i)	'약정후이율
			TempCount = Len(DATAMANAGER.GetDataValue( 0 , "obacb_balc_031r", "OutBlock2", "ACNT_PRNM" , i))
			szTemp9 = Mid(DATAMANAGER.GetDataValue( 0 , "obacb_balc_031r", "OutBlock2", "ACNT_PRNM" , i), 3, TempCount - 2)'상품명
			
			grd0.SetCellData("bd_cell0", g_nNextCount , szTemp0)
			grd0.SetCellData("bd_cell1", g_nNextCount , szTemp1)
			grd0.SetCellData("bd_cell2", g_nNextCount , szTemp2)
			grd0.SetCellData("bd_cell3", g_nNextCount , szTemp3)
			grd0.SetCellData("bd_cell4", g_nNextCount , szTemp4)
			grd0.SetCellData("bd_cell5", g_nNextCount , szTemp5)
			grd0.SetCellData("bd_cell6", g_nNextCount , szTemp6)
			grd0.SetCellData("bd_cell7", g_nNextCount , szTemp7)
			grd0.SetCellData("bd_cell8", g_nNextCount  , szTemp8)
			grd0.SetCellData("bd_cell9", g_nNextCount  , szTemp9)
			
			g_nNextCount = g_nNextCount + 1
		next
		
		grd0.rowcount = g_nNextCount
	'계좌번호블록에 계좌번호+계좌명으로 출력
	elseif szTranID == "obacb_balc_111r" then			'발행어음
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obacb_balc_111r", "OutBlock2")-1
		
			grd1.AddRow()
		
			szTemp0 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_111r", "OutBlock2", "ACNO" , i) &
					DATAMANAGER.GetDataValue( 0 , "obacb_balc_111r", "OutBlock2", "ASNO" , i)	'계좌번호
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_111r", "OutBlock2", "ABRV_ISNM" , i)	'종목명
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_111r", "OutBlock2", "BYOV_AMT" , i)	'매수금액
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_111r", "OutBlock2", "PBLC_AMT" , i)	'발행금액
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_111r", "OutBlock2", "VLTN_AMT" , i)	'평가금액
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_111r", "OutBlock2", "APLY_MNRT" , i)	' 적용금리
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_111r", "OutBlock2", "BYOV_DATE" , i)	'매수일
			szTemp7 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_111r", "OutBlock2", "MTRT_DATE" , i)	'만기일
			szTemp8 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_111r", "OutBlock2", "PBLC_MNRT" , i)	'발행금리
			TempCount = Len(DATAMANAGER.GetDataValue( 0 , "obacb_balc_111r", "OutBlock2", "UI_ACNT_PRNM" , i))
			szTemp9 = Mid(DATAMANAGER.GetDataValue( 0 , "obacb_balc_111r", "OutBlock2", "UI_ACNT_PRNM" , i), 3, TempCount - 2)'상품명
			
			grd1.SetCellData("bd_cell0", g_nNextCount , szTemp0)
			grd1.SetCellData("bd_cell1", g_nNextCount , szTemp1)
			grd1.SetCellData("bd_cell2", g_nNextCount , szTemp2)
			grd1.SetCellData("bd_cell3", g_nNextCount , szTemp3)
			grd1.SetCellData("bd_cell4", g_nNextCount , szTemp4)
			grd1.SetCellData("bd_cell5", g_nNextCount , szTemp5)
			grd1.SetCellData("bd_cell6", g_nNextCount , szTemp6)
			grd1.SetCellData("bd_cell7", g_nNextCount , szTemp7)
			grd1.SetCellData("bd_cell8", g_nNextCount  , szTemp8)
			grd1.SetCellData("bd_cell9", g_nNextCount  , szTemp9)
			
			g_nNextCount = g_nNextCount + 1
		next
		
		grd1.rowcount = g_nNextCount
	'계좌번호블록에 계좌번호+계좌명으로 출력
	elseif szTranID == "obacb_balc_040r" then			'신탁
		for i = 0 to DATAMANAGER.GetDataCount( 0 , "obacb_balc_040r", "OutBlock2")-1
			
			grd2.AddRow()
			
			szTemp0 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_040r", "OutBlock2", "ACNO" , i) &
				DATAMANAGER.GetDataValue( 0 , "obacb_balc_040r", "OutBlock2", "ASNO" , i)	'계좌번호
			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_040r", "OutBlock2", "ABRV_ISNM" , i)	'펀드명
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_040r", "OutBlock2", "BYNG_AMT" , i)	'매입금액
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_040r", "OutBlock2", "VLTN_AMT" , i)	'평가금액
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_040r", "OutBlock2", "VLTN_PRLS_AMT" , i)	'평가손익 
