Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	Select Case szTranID
		Case "obacb_balc_031r"		'RP
			CleanGrd()
			grd0.visible = true
		Case "obacb_balc_111r"		'발행어음
			CleanGrd()
			grd1.visible = true
		Case "obacb_balc_040r"		'신탁
			CleanGrd()
			grd2.visible = true
		Case "obacb_balc_032r"		'CD, CP/전단채
			CleanGrd()
			grd3.visible = true
		Case "obacb_balc_034r"		'해외증권/외화예수금
			CleanGrd()
			grd4.visible = true
		Case "obacb_balc_035r"		'MMW
			CleanGrd()
			grd5.visible = true
		Case "obacb_balc_112r"		'어음관리계좌
			CleanGrd()
			grd6.visible = true
		Case "obacb_balc_078r"		'해외뮤추얼펀드
			CleanGrd()
			grd7.visible = true
		Case "obacb_balc_079r"		'외화표시펀드
			CleanGrd()
			grd8.visible = true
		Case "obacb_balc_131r"		'외화RP
			CleanGrd()
			grd9.visible = true
		Case "obacb_balc_087r"		'외화채권
			CleanGrd()
			grd10.visible = true
	End Select
	g_nNextCount = 0
End Sub
