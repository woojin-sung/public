			szTemp1 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_087r", "OutBlock1", "ABRV_ISNM" , i)	'종목명
			szTemp2 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_087r", "OutBlock1", "BYOV_DATE" , i)	'매수일
			szTemp3 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_087r", "OutBlock1", "HLDN_ISSU_RMND_QTY" , i)	'잔고수량
			szTemp4 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_087r", "OutBlock1", "BYOV_AMT" , i)	'매수금액
			szTemp5 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_087r", "OutBlock1", "VLTN_AMT" , i)	'평가금액
			szTemp6 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_087r", "OutBlock1", "CRCD" , i)	'통화코드 			
			szTemp7 = DATAMANAGER.GetDataValue( 0 , "obacb_balc_087r", "OutBlock1", "MTRT_DATE" , i)	'만기일			
			TempCount = Len(DATAMANAGER.GetDataValue( 0 , "obacb_balc_087r", "OutBlock1", "ACNT_PRNM" , i))
			szTemp8 = Mid(DATAMANAGER.GetDataValue( 0 , "obacb_balc_087r", "OutBlock1", "ACNT_PRNM" , i), 3, TempCount - 2)'상품명
			
			
			grd10.SetCellData("bd_cell0", g_nNextCount , szTemp0)
			grd10.SetCellData("bd_cell1", g_nNextCount , szTemp1)
			grd10.SetCellData("bd_cell2", g_nNextCount , szTemp2)
			grd10.SetCellData("bd_cell3", g_nNextCount , szTemp3)
			grd10.SetCellData("bd_cell4", g_nNextCount , szTemp4)
			grd10.SetCellData("bd_cell5", g_nNextCount , szTemp5)
			grd10.SetCellData("bd_cell6", g_nNextCount , szTemp6)
			grd10.SetCellData("bd_cell7", g_nNextCount , szTemp7)			
			grd10.SetCellData("bd_cell8", g_nNextCount , szTemp8)
			
			g_nNextCount = g_nNextCount + 1
		next
		
		grd10.rowcount = g_nNextCount
		
	end if
	
	if  DATAMANAGER.IsMoreNextData( szTranID ) == True then 
		DATAMANAGER.RequestNextData( szTranID )
	else
		if g_szList(1) == "Y" then	'전체조회시
			AllSearch(szTranID)
		end if
	end if
End Sub
'============================================================================
' grd0_OnScrollEnd()
'============================================================================
Sub grd0_OnScrollEnd()

	Select Case g_nCmbIndex
		Case 0			'RP
			DATAMANAGER.RequestNextData( "obacb_balc_031r" )
		Case 1			'발행어음
			DATAMANAGER.RequestNextData( "obacb_balc_111r" )
		Case 2			'신탁
			DATAMANAGER.RequestNextData( "obacb_balc_040r" )
		Case 3			'CD, CP/전단채
			DATAMANAGER.RequestNextData( "obacb_balc_032r" )
		Case 4			'해외증권/외화예수금
			DATAMANAGER.RequestNextData( "obacb_balc_034r" )
		Case 5			'MMW
			DATAMANAGER.RequestNextData( "obacb_balc_035r" )
		Case 6			'어음관리계좌
			DATAMANAGER.RequestNextData( "obacb_balc_112r" )
		Case 7			'해외뮤추얼펀드
			DATAMANAGER.RequestNextData( "obacb_balc_078r" )
		Case 8			'외화표시펀드
			DATAMANAGER.RequestNextData( "obacb_balc_079r" )
		Case 9			'외화RP
			DATAMANAGER.RequestNextData( "obacb_balc_131r" )
		Case 10			'외화채권
			DATAMANAGER.RequestNextData( "obacb_balc_087r" )			
	End Select
	
End Sub

'============================================================================
Sub cmb0_OnEditComplete(iIndex)
	
	g_nAllCount = 4 + g_nAcntCount	'마지막 계좌 
	
	g_nNextCount = 0
	g_nCmbIndex = iIndex
	CleanGrd()
	CleanTR()
	
	Select Case iIndex
		Case 0			'RP
			if g_szList(1) == "Y" then
				grd0.rowcount = 0
				AllSearch( "obacb_balc_031r" )
			else
				InQuery("obacb_balc_031r")
			end if
			grd0.visible = true
		Case 1			'발행어음
			if g_szList(1) == "Y" then
				grd1.rowcount = 0
				AllSearch( "obacb_balc_111r" )
			else
				InQuery("obacb_balc_111r")
			end if
			grd1.visible = true
		Case 2			'신탁
			if g_szList(1) == "Y" then
				grd2.rowcount = 0
				AllSearch( "obacb_balc_040r" )
			else
				InQuery("obacb_balc_040r")
			end if
			grd2.visible = true
		Case 3			'CD, CP/전단채
			if g_szList(1) == "Y" then
				grd3.rowcount = 0
				AllSearch( "obacb_balc_032r" )
			else
				InQuery("obacb_balc_032r")
			end if
			grd3.visible = true
		Case 4			'해외증권/외화예수금
			if g_szList(1) == "Y" then
				grd4.rowcount = 0
				AllSearch( "obacb_balc_034r" )
			else
				InQuery("obacb_balc_034r")
			end if
			grd4.visible = true
		Case 5			'MMW
			if g_szList(1) == "Y" then
				grd5.rowcount = 0
				AllSearch( "obacb_balc_035r" )
			else
				InQuery("obacb_balc_035r")
			end if
			grd5.visible = true
		Case 6			'어음관리계좌
			if g_szList(1) == "Y" then
				grd6.rowcount = 0
				AllSearch( "obacb_balc_112r" )
			else
				InQuery("obacb_balc_112r")
			end if
			grd6.visible = true
		Case 7			'해외뮤추얼펀드
			if g_szList(1) == "Y" then
				grd7.rowcount = 0
				AllSearch( "obacb_balc_078r" )
			else
				InQuery("obacb_balc_078r")
			end if
			grd7.visible = true
		Case 8			'외화표시펀드
			if g_szList(1) == "Y" then
				grd8.rowcount = 0
				AllSearch( "obacb_balc_079r" )
			else
				InQuery("obacb_balc_079r")
			end if
			grd8.visible = true
		Case 9			'외화RP
			if g_szList(1) == "Y" then
				grd9.rowcount = 0
				AllSearch( "obacb_balc_131r" )
			else
				InQuery("obacb_balc_131r")
			end if
			grd9.visible = true
		Case 10			'외화채권
			if g_szList(1) == "Y" then
				grd10.rowcount = 0
				AllSearch( "obacb_balc_087r" )
			else
				InQuery("obacb_balc_087r")
			end if
			grd10.visible = true	
			Label0.visible = true 'v001
	End Select
	
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	g_nAllCount = 0
	g_nCmbIndex = 0
	
End Sub

