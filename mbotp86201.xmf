Sub Form_OnFormInit()
	
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "N")
	
	Container0.EditReal.SetApplyLabel("숫자 6자리 입력", 0 , 76 , "left" , true) '호출해야 정상작동
	
	'단말정보 취합
	funcTermInfo()
	
	g_IntoClcd = "NMET_ACNT"
	szAcno = Form.GetSharedData("gAcno"          , false ) 
	g_Csno = Form.GetSharedData("gCsno"          , false ) 
	
	Container0.Label3.caption = "처음부터 다시 입력하기 >" 
	
	'test
'	g_Csno = "3000416232"
'	szAcno = "30209233"
	
	'test
'	szData = ""
'	If Len(szData) == 0 Then
	'	g_IntoClcd	= "MTS"
'		g_IntoClcd = "NMET_ACNT"
'		g_IntoClcd = "NMET_BSWR"
'		szAcno	= "30003130"
'		szData 	= "R☆N☆☆☆☆3000065693☆"
'	End If
	
'	Form.requestMOTP("MOTP_GET_VERSION"	, "" , "86101")
'	Form.requestMOTP("MOTP_GETINFO"		, "" , "86101")
	
	if g_IntoClcd == "NMET_ACNT" then
		'계좌번호 설정
		szFrAcno = Left	(szAcno, 4)
		szRrAcno = Right(szAcno, 4)
'		
		g_MOtpSrnoSvr = " "

		g_tempAcc	= szFrAcno & szRrAcno
		g_RcnoPip	= Form.GetSharedData("BDM_RCNO_PIP", false ) '암호화로 내려옴. 필요x
		DATAMANAGER.RequestTranData("obacp_comm_004r") '연락처 정보 GET
	end if
End Sub

'============================================================================
Sub Form_OnTriggerEventMOTP(sEventName, sParam) 
	Dim tmpList
'Form.ShowAlert( "debug", "EventName [" & sEventName & "], Param [" & sParam & "]" )
	If sEventName == "MOTP_GET_VERSION_RETURN_86101" Then ' M SafeBox 버전 정보 가져오기
		tmpList = Split(sParam, "★")
		If tmpList[0] == "00000" Then
			g_MsboVrsn = tmpList[2]
		Else
			Form.ShowAlert("알림", "MSB 버전 추출 오류\n"..tmpList[1])
		End If
	End If
	
	If sEventName == "MOTP_ISSUE_RETURN_86101" Then 'M SafeBox에 MOTP정보 심기
		tmpList = Split(sParam, "★")
		If tmpList[0] == "00000" Then
			'Form.ShowAlert("jsi 오류", "이건 정상일까?")
			Form.regiPUSH(g_Csno) '비로그인 고객 대상 PUSH 서비스 등록
'			Form.SetSharedData("BDM_OTP_SUPL_CO_CODE", "ATN")
'			rslt_data = "86101" & "☆" & "모바일OTP 발급" & "☆" & "Y" & "☆" & g_ProsClcd & "☆" & "모바일OTP(메리츠)" & "☆" & g_NewMotpSrno
'			Form.OpenPopup( "mbotp86105_rslt.xmf" , rslt_data , "" )
			
			'OTP 등록 완료
			Form.OpenNextPopup( "mbotp86202" , "" , "" )
		Else
			'Form.ShowAlert("jsi 오류", "세이프박스 오류인가?")
			Form.ShowAlert("오류", "모바일 OTP 발급 오류\n"..tmpList[1])
			rslt_data = "86101" & "☆" & "모바일OTP 발급" & "☆" & "N" & "☆" & "R" & "☆" & "오류" & "☆" & tmpList[1]
			Form.OpenPopup( "mbotp86105_rslt.xmf" , rslt_data , "" )
		End If
	End If

'	If sEventName == "MOTP_GETINFO_RETURN_86101" Then
'		tmpList = Split(sParam, "★")
'		If tmpList[0] == "00000" Then
'			g_MotpSrno = right(tmpList[2], 12)
'		End If
'	End If
End Sub

'============================================================================
Function funcTermInfo()
	g_CustTermID	=	Form.GetDeviceID()
	g_DeviceOS	=	Form.GetSharedData("&OS_TYPE", false)
	g_OSVrsn		=	Form.GetSharedData("&OS_VERSION", false)
	g_CustTermName	=	Form.GetDeviceModel()
End Function

'============================================================================
'인증성공 시 에디트 파란색으로 변환
'============================================================================
Sub Container0_Buttonok_OnClick()
	
	if Container0.EditReal.caption == null or Container0.EditReal.caption == "" or Container0.EditRealCnfr.caption == "" or Container0.EditRealCnfr.caption == null then
		Form.MsgBox( "알림", "모바일 OTP 비밀번호를 입력해주세요.", "", 6 )
	else	
		DATAMANAGER.RequestTranData("obcsb_oimf_170a") '모바일 OTP 발급
	end if
	
	nCnt = 0
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	
	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		Container0.EditReal.SetShowKeypad(True)
				
	elseif sTimerID == "2" or sTimerID == 2 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		
		'입력UI 다시 리셋
		nCnt = 0
		
		Container0.Label0.caption = "다시 한번 입력해 주세요."
		
		Container0.Pwdbasic0.visible = true	
		Container0.Pwdbasic1.visible = true	
		Container0.Pwdbasic2.visible = true	
		Container0.Pwdbasic3.visible = true	
		Container0.Pwdbasic4.visible = true	
		Container0.Pwdbasic5.visible = true		
		Container0.PwdInsert0.visible = false	
		Container0.PwdInsert1.visible = false	
		Container0.PwdInsert2.visible = false	
		Container0.PwdInsert3.visible = false	
		Container0.PwdInsert4.visible = false	
		Container0.PwdInsert5.visible = false	
		
		Container0.EditRealCnfr.SetShowKeypad(True)
		
		'비번 재입력 팝업
'		Form.OpenNextPopup( "mhetc90190_s4" , "" , "")
	elseif sTimerID == "9999" or sTimerID == 9999 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		DATAMANAGER.RequestTranData( "obcsb_oimf_520r" ) '보안매체상태조회
	end if
	
End Sub
