'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obacp_comm_004r" Then '고객연락처 조회
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0, g_tempAcc )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ELFN_ID", 0 , Form.GetSharedData("&USER_ID", false ))
	
	elseif szTranID == "obacp_comm_058r" Then 'OTP비밀번호 유효성 검사
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS", 0 , "7" 		 )	'[MTS] 계좌비밀번호 변경시 체크
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"    , 0 , g_tempAcc )  '계좌번호
		if g_IntoClcd == "MTS" then
			DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "LOGN_ID" , 0 , Form.GetSharedData("&USER_ID", false ))  'ID
		end if 
		'비밀번호복호화하여 비교해야하므로 ARIA값으로 넘겨줌(caption2 API사용)
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PWD_PIP"     , 0 , Container0.EditReal.caption2 )  '비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CNFR_PWD_PIP", 0 , Container0.EditRealCnfr.caption2 )  '확인비밀번호
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "RCNO"		 , 0 , ""			)  '실명확인번호(서비스에서 조회)		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "WRPL_TELNO"  , 0 , g_WorkNo        )  '직장전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "CLPH_TELNO"  , 0 , g_ClphNo        )  '휴대전화
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "OWHS_TELNO"  , 0 , g_HomeNo        )  '자택전화
	
	elseif szTranID == "obcsb_oimf_170a" Then 'OTP등록 처리'
		'Form.ShowAlert( "debug", g_MsboVrsn )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "PROS_CLS_CODE"    	, 0, "I" )  '발급
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO"    			, 0, g_tempAcc )  '계좌번호
'		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "ACNT_PWD"			, 0, cntnInput.EdtPwd.caption )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "MSBO_VRSN"			, 0, g_MsboVrsn )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "OS_CLCD"			, 0, g_DeviceOS )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "OS_VRSN"			, 0, g_OSVrsn )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "CUST_TERM_NAME"		, 0, g_CustTermName )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "CUST_TERM_ID"		, 0, g_CustTermID )
		DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "MOTP_ATHN_DATA_CNTT"	, 0, Container0.EditRealCnfr.caption )
		if Len(Trim(g_MOtpSrnoSvr)) > 1 then
			DATAMANAGER.SetDataValue( 0, szTranID ,"InBlock1", "MOTP_SRNO"			, 0, g_MOtpSrnoSvr )
		end if
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obacp_comm_004r" Then '고객연락처 조회
		g_HomeNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "OWHS_TELNO"      , 0)  '자택전화
		g_ClphNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "CLPH_TELNO"      , 0)  '휴대전화
		g_WorkNo = DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "WRPL_WHOL_TELNO" , 0)  '직장전화
		
		Form.requestMOTP("MOTP_GET_VERSION"	, "" , "86101")
		
		if g_IntoClcd == "NMET_ACNT" then
			'비밀번호 입력키패드 Show
			Form.SetTimerEvent2(1, 1, 0.6)
		end if
	
	elseif szTranID == "obacp_comm_058r" Then 'OTP비밀번호 유효성 검사
		
'		DATAMANAGER.RequestTranData("obcsb_oimf_170a") '모바일 OTP 발급
	
	elseif szTranID == "obcsb_oimf_170a" Then
		g_NewOtpKey1	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MOTP_NO_1_KEY"	, 0)  '모바일OTP번호1키
		g_NewOtpKey2	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MOTP_NO_2_KEY"	, 0)  '모바일OTP번호2키
		g_NewMotpSrno	= DATAMANAGER.GetDataValue( 0 , szTranID, "OutBlock1", "MSBO_MOTP_SRNO"	, 0)  'MOBILESAFEBOX모바일OTP일련번호
		szData = g_NewMotpSrno & "★" & g_NewOtpKey1 & "★" & g_NewOtpKey2
		Form.requestMOTP("MOTP_ISSUE" , szData , "86101")
	end if
End Sub

'============================================================================
Sub Container0_ImgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szMsgCode, szMsgText, szSubText
	szMsgCode = DATAMANAGER.GetDataMsgCode(szTranID)
	szMsgText = DATAMANAGER.GetDataMsgText(szTranID)
	szSubText = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szTranID == "obacp_comm_058r" then
		nCnt = 0
		
		Container0.Label0.caption = "다시 한번 입력해 주세요."
		
		Container0.Pwdbasic0.visible = true	
		Container0.Pwdbasic1.visible = true	
		Container0.Pwdbasic2.visible = true	
		Container0.Pwdbasic3.visible = true	
		Container0.Pwdbasic4.visible = true	
		Container0.Pwdbasic5.visible = true		
		Container0.PwdInsert0.visible = false	
		Container0.PwdInsert1.visible = false	
		Container0.PwdInsert2.visible = false	
		Container0.PwdInsert3.visible = false	
		Container0.PwdInsert4.visible = false	
		Container0.PwdInsert5.visible = false	
		
		Container0.lblError.visible = true
		Container0.lblError.caption = szMsgText & "(" & szSubText &")"
	
	
	elseif szTranID == "obcsb_oimf_170a" then 'OTP 발급
		rslt_data = "86101" & "☆" & "모바일OTP 발급" & "☆" & "N" & "☆" & "R" & "☆" & szErrMsg & "☆" & DATAMANAGER.GetDataMsgSubText(szTranID)
		Form.OpenPopup( "mbotp86105_rslt.xmf" , rslt_data , "" )
	
	else
		if szSubText <> "" and szSubText <> null then
			Form.ShowAlert("알림", szMsgText & "(" & szSubText &")")
		else
			Form.ShowAlert("알림", szMsgText)
		end if
	end if
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "rslt_ret" then
		if sRet == "OK" then
			'OTP 등록 실패시... 화면닫고 안내화면으로 돌아감
			Form.CloseForm()
		end if
	end if
End Sub

'============================================================================
Sub Form_OnFormBackKeyPressed()
	Form.OpenNextPopup("mbotp86200", "", "")
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SetSharedData("&BACK_PRESS_ENABLE" , "Y")
End Sub

'============================================================================
Sub Container0_Btnretry_OnClick()
	Container0.PwdFail0.visible = false
	Container0.PwdFail1.visible = false
	Container0.PwdFail2.visible = false
	Container0.PwdFail3.visible = false
	Container0.PwdFail4.visible = false
	Container0.PwdFail5.visible = false
	Container0.Pwdbasic0.visible = true		
	Container0.Pwdbasic1.visible = true		
	Container0.Pwdbasic2.visible = true		
	Container0.Pwdbasic3.visible = true		
	Container0.Pwdbasic4.visible = true		
	Container0.Pwdbasic5.visible = true
	Container0.PwdInsert0.visible = false	
	Container0.PwdInsert1.visible = false	
	Container0.PwdInsert2.visible = false	
	Container0.PwdInsert3.visible = false	
	Container0.PwdInsert4.visible = false	
	Container0.PwdInsert5.visible = false
	
	Container0.Label0.caption = "비밀번호 6자리를 설정해주세요."
	
	Container0.Label3.visible = false
	Container0.Btnretry.visible = false
	
	Container0.lblError.visible = false
	
	Container0.EditReal.caption = ""
	Container0.EditRealCnfr.caption = ""
	
	nCnt = 0
	
	Container0.EditReal.SetShowKeypad(True)
End Sub

