'============================================================================
' 화 면 명 : 관심종목_가로(해외지수 차트)
' 화면설명 : 관심종목_가로리스트 선택시 해외지수 차트 보여줌
' 작    성 : 201.02.22 ~ 2016.  .       ssang
'============================================================================

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szCd, g_szMk


'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************

'============================================================================
' Set_ChartType
'============================================================================
Function Set_ChartType()
	ChartEx0.setMarketCategory(1)	
		
	if g_szMk == "EN" then
		ChartEx0.setDecimal("4")	' 소수점 4자리
	else
		ChartEx0.setDecimal("2")	' 소수점 2자리
	end if
End Function


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInitBefore
'============================================================================
Sub Form_OnFormInitBefore()
'	ChartEx0.setChartType("minibong")
End Sub


'============================================================================
' Form_OnTriggerEvent
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	' 스타일2화면에서 트리거 받음
	if sEventName == "JMCODE" then
		DATAMANAGER.CancelRealData("ohhts_nfut_cntg_1")			' 해외선물 체결 자동갱신
		DATAMANAGER.CancelRealData("ohhts_ovrs_nmix_1")			' 해외지수/종목 체결 자동갱신
		DATAMANAGER.CancelRealData("ohhts_exrt_cntg_1")			' 환율 체결 자동갱신
			
		if Trim(sParam) <> "" then
			tData = Split(sParam, "★")
			
			g_szCd = tData(0)
			g_szMk = tData(1)
			
			Set_ChartType()
			DATAMANAGER.RequestTranData("ohhts_5040_001r")	' 해외조회(차트)
		end if
	end if
End Sub

'============================================================================
' Form_OnFormClose
'============================================================================
Sub Form_OnFormClose()
	DATAMANAGER.CancelRealData("ohhts_nfut_cntg_1")			' 해외선물 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_ovrs_nmix_1")			' 해외지수/종목 체결 자동갱신
	DATAMANAGER.CancelRealData("ohhts_exrt_cntg_1")			' 환율 체결 자동갱신
End Sub
		
'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	
	' ----------------------------------------------------------------------
	' 해외조회(차트)
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_5040_001r" then
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock1", "FID_INPUT_ISCD",               0, g_szCd)
		
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE", 0, g_szMk)
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock2", "FID_INPUT_ISCD",               0, g_szCd)
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock2", "FID_INPUT_DATE1",              0, Form.GetSharedData("&HOST_DATE", 0))
		DATAMANAGER.SetDataValue(0, "ohhts_5040_001r", "InBlock2", "FID_INPUT_DAY_WEEK_MONTH_YR",  0, "D")  'D/W/M/Y 일/주/월/년 
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	' ----------------------------------------------------------------------
	' 해외조회(차트)
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_5040_001r" then
		if g_szMk == "N" then				' 대표지수/국가별업종지수(N)
			DATAMANAGER.RequestRealData("ohhts_ovrs_nmix_1")
		elseif g_szMk == "FN" then			' CME선물/상품선물(FN)
			DATAMANAGER.RequestRealData("ohhts_nfut_cntg_1")	
		elseif g_szMk == "EN" then			' 세계환율(EN)
			DATAMANAGER.RequestRealData("ohhts_exrt_cntg_1")
		end if
	end if
End Sub

'============================================================================
' DATAMANAGER_OnSendRealBefore
'============================================================================
Sub DATAMANAGER_OnSendRealBefore(szTranID)
	' ----------------------------------------------------------------------
	' 해외지수/종목 체결 자동갱신
	' ----------------------------------------------------------------------	
	if szTranID == "ohhts_ovrs_nmix_1" then
		DATAMANAGER.SetDataValue(1, "ohhts_ovrs_nmix_1", "InBlock1", "FIDR_SYMB", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 해외선물 체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_nfut_cntg_1" then
		DATAMANAGER.SetDataValue(1, "ohhts_nfut_cntg_1", "InBlock1", "FIDR_SYMB", 0, g_szCd)
	' ----------------------------------------------------------------------
	' 환율 체결 자동갱신
	' ----------------------------------------------------------------------	
	elseif szTranID == "ohhts_exrt_cntg_1" then
		DATAMANAGER.SetDataValue(1, "ohhts_exrt_cntg_1", "InBlock1", "FIDR_SYMB", 0, g_szCd)		
	end if
End Sub


'============================================================================
Sub DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID == "ohhts_ovrs_nmix_1" then
		Edit0.caption = DATAMANAGER.GetDataValue(1, "ohhts_ovrs_nmix_1", "OutBlock1", "FIDR_PRPR2", 0)
	end if
End Sub

