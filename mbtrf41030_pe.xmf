'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************

Dim g_tData

'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************

'============================================================================
' RequestData
'============================================================================
Function RequestData()
	tblData.SetCellString(0, 1, "")
	tblData.SetCellString(1, 1, "")
	tblData.SetCellString(2, 1, "")
	
	DATAMANAGER.ClearInputData(0, "obtrf_cntg_835r")
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_835r", "InBlock1", "ACNO"             , 0, g_tData(0))	' 계좌번호
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_835r", "InBlock1", "ASNO"             , 0, g_tData(1))	' 계좌일련번호
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_835r", "InBlock1", "IQRY_CLS_CODE"    , 0, "1")			' 조회구분코드
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_835r", "InBlock1", "FEE_MDIA_GRP_CODE", 0, "020")		' 수수료매체그룹코드
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_835r", "InBlock1", "MKPL_CLS_CODE"    , 0, g_tData(2))	' 매매시장구분코드
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_835r", "InBlock1", "DEAL_CLS_CODE"    , 0, g_tData(3))	' 매매구분코드
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_835r", "InBlock1", "ODQT"             , 0, g_tData(4))	' 주문수량
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_835r", "InBlock1", "FTOP_ODER_UNPR"   , 0, g_tData(5))	' 주문단가
	DATAMANAGER.SetDataValue(0,	"obtrf_cntg_835r", "InBlock1", "ISCD"             , 0, g_tData(6))	' 종목코드
			
	DATAMANAGER.RequestTranData("obtrf_cntg_835r")
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
' Form_OnFormInit
'============================================================================
Sub Form_OnFormInit()
	Dim tData
	Dim szData
	
	szData = Form.GetOpenLinkData()

	tData = Split(szData, "★")
	
	if UBound(tData) > 0 then
		g_tData = tData
		
		RequestData()
	end if
End Sub


'============================================================================
' imgClose_OnClick : 닫기
