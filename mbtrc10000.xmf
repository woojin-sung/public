'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szMrkt, g_szDate, g_szRate1, g_szRate2, g_szCheck1, g_szCheck2, g_szCheck3
Dim g_bFlag '시장변경시 종목코드 입력안되도록 하는 플래그
Dim g_szCode

g_isEmpty_Code = false
'****************************************************************************
'			P  E  R  S  O  N  A  L     F  U  N  C  T  I  O  N
'****************************************************************************
'============================================================================
'f_InitFilterValue 설정 값 초기화
'============================================================================
Function f_InitFilterValue(szType)
	if szType == "0" then
		g_szMrkt = "0"
		g_szDate = cldFrom.caption
		
	elseif szType == "1" then
		g_szRate1 	= "0"
		g_szRate2 	= "100"
		g_szCheck1 	= "Y"
		g_szCheck2 	= "Y"
		g_szCheck3 	= "N"
	end if
	
End Function 

'============================================================================
'f_LoadFilterValue 설정 값 LOAD
'============================================================================
Function f_LoadFilterValue()
	Dim tData1, tData2, szTemp1, szTemp2
	
	szTemp1 = Form.LoadConfigData("SET_mbtrc10000", "SET_VALUE_MAIN") '메인화면에서 설정한 필터 값
	szTemp2 = Form.LoadConfigData("SET_mbtrc10000", "SET_VALUE_POP"	) '상세팝업에서 설정한 필터 값
	
	if szTemp1 <> "" then
		tData1 = Split(szTemp1, "★")
		'0시장콤보 인덱스|1기준일자
		
		g_szMrkt = tData1(0)
'		g_szDate = tData1(1)
		
	else '초기화
		Call f_InitFilterValue("0")
		
	end if
	
	if szTemp2 <> "" then
		tData2 = Split(szTemp2, "★")
		'0증거금률 이상 % 값|1증거금률 이하 % 값|2신규매수 불가종목 제외여부|3신규매도 불가종목 제외여부|4ETF 제외여부
		
		g_szRate1 	= tData2(0)
		g_szRate2 	= tData2(1)
		g_szCheck1 	= tData2(2)
		g_szCheck2 	= tData2(3)
		g_szCheck3 	= tData2(4)
		
	else '초기화
		Call f_InitFilterValue("1")
		
	end if
	
End Function 

'============================================================================
'f_SaveFilterValue 설정 값 SAVE
'============================================================================
Function f_SaveFilterValue()
	Dim szDate, szMarket
	
	szDate = cldFrom.caption
	szMarket = cmbMarket.currentindex

	Form.SaveConfigData("SET_mbtrc10000", "SET_VALUE_MAIN", "" )
	Form.SaveConfigData("SET_mbtrc10000", "SET_VALUE_MAIN", szMarket & "★" & szDate )
	
End Function

'============================================================================
'f_SetDataInCtrl 설정 값 SET
'============================================================================
Function f_SetDataInCtrl()
'	if g_szDate <> "" then
'		cldFrom.caption = g_szDate
'	end if

	if g_szMrkt <> "" then
		cmbMarket.currentindex = g_szMrkt
	end if
	
End Function 

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************

'============================================================================
Sub Form_OnFormInit()
	Call f_LoadFilterValue() '필터 저장 값 불러오기
	Call f_SetDataInCtrl() '저장 값을 컨트롤에 SET
	ItemCode0.code = "empty"
	DATAMANAGER.RequestTranData( "obtrc_comm_013r" )
End Sub


'============================================================================
Sub Form_OnFormClose()
	Call f_SaveFilterValue()
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "POP_SET" then
		Call f_LoadFilterValue()
		DATAMANAGER.RequestTranData( "obtrc_comm_013r" )
	elseif sKeyName = "MOVEPOP_RETURN"	then
		Dim szListItems	
		szListItems =	split(sRet,"★")
'		Form.ShowAlert(sKeyName, sRet)
'		Form.ShowAlert(szListItems, g_szCode)

		Form.SetItemCode(g_szCode)
		
		if	szListItems(1) = "0" then '현재가
			Form.OpenScreen("13100" , g_szCode & "★" & "0") 
		elseif szListItems(1) = "1" then '매수
			Form.OpenScreen("13200" , "기타" & "★" & "0" & "★" & g_szCode) 
		elseif szListItems(1) = "2" then '매도
			Form.OpenScreen("13200" , "기타" & "★" & "1" & "★" & g_szCode) 
		end if
		
		g_szCode = ""
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obtrc_comm_013r" then
		Dim szCode, szDate, szMarket
		
		if g_isEmpty_Code == false then
			szCode = ItemCode0.code
		else
			szCode = "%"
		end if
		
		szDate = cldFrom.caption
		szMarket = cmbMarket.cbkeydata
		
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_013r", "InBlock1", "ISCD"				, 0, szCode 		)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_013r", "InBlock1", "STND_DATE"			, 0, szDate 		)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_013r", "InBlock1", "MRKT_DIV_CLS_CODE"	, 0, szMarket 	)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_013r", "InBlock1", "STA_RATE"			, 0, g_szRate1 	)	
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_013r", "InBlock1", "FIN_RATE"			, 0, g_szRate2 	)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_013r", "InBlock1", "BYOV_ABLE_YN"		, 0, g_szCheck1 	)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_013r", "InBlock1", "SELN_ABLE_YN"		, 0, g_szCheck2 	)
		DATAMANAGER.SetDataValue( 0, "obtrc_comm_013r", "InBlock1", "EXLS_YN"			, 0, g_szCheck3 	)
		
	end if
End Sub

'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID) : 데이터 수신 완료
'  20240117 H그룹추가(T2401160027) :  H그룹은 E그룹으로 보이게 함
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)

        if szTranID == "obtrc_comm_013r" then
	        If tonumber(grd1.rowcount) > 0 Then
			Dim nDataCnt, nRowCnt
			nDataCnt = tonumber(DATAMANAGER.GetDataCount( 0, szTranID , "OutBlock1" ))
			nRowCnt = grd1.rowcount - nDataCnt
			
			for i = 0 to nDataCnt - 1
			        Dim GrpCode
				GrpCode = DATAMANAGER.GetDataValue( 0, szTranID, "OutBlock1", "CFD_ISSU_RISK_GRP_CODE", i)
				
				If GrpCode == "A" Then
						grd1.SetCellData( "bd_cell0", nRowCnt + i , "A")
				ElseIf GrpCode == "B" Then
						grd1.SetCellData( "bd_cell0", nRowCnt + i , "B")
				ElseIf GrpCode == "C" Then
						grd1.SetCellData( "bd_cell0", nRowCnt + i , "C")
				ElseIf GrpCode == "D" Then
						grd1.SetCellData( "bd_cell0", nRowCnt + i , "D")
				ElseIf GrpCode == "F" Then
						grd1.SetCellData( "bd_cell0", nRowCnt + i , "C-1")
				ElseIf GrpCode == "G" Then
						grd1.SetCellData( "bd_cell0", nRowCnt + i , "D-1")
				ElseIf GrpCode == "E" Then
						grd1.SetCellData( "bd_cell0", nRowCnt + i , "E")
				ElseIf GrpCode == "H" Then
						grd1.SetCellData( "bd_cell0", nRowCnt + i , "E")						
				End If
			Next
		end if
	end if

End Sub

'============================================================================
Sub cmbMarket_OnEditComplete(iIndex)
	g_isEmpty_Code = true
	ItemCode0.code = "empty"
	DATAMANAGER.RequestTranData( "obtrc_comm_013r" )
	
End Sub

'============================================================================
Sub cldFrom_OnEditComplete()
	DATAMANAGER.RequestTranData( "obtrc_comm_013r" )
	
End Sub

'============================================================================
Sub ItemCode0_OnEditComplete(sCode)
	g_isEmpty_Code = false
	DATAMANAGER.RequestTranData( "obtrc_comm_013r" )
	
End Sub

'============================================================================
Sub grd1_OnScrollEnd()
	DATAMANAGER.RequestNextData( "obtrc_comm_013r" )
	
End Sub

'============================================================================
Sub btnSet_OnClick()
	Form.OpenPopup("mbtrc10000_p1" , "", "")
	
End Sub

'============================================================================
Sub grd1_OnClickUp(lRow, szCellID)
	if lRow <> "" then
		g_szCode	= grd1.GetCellData( "bd_code", lRow )
		
		listLocation =  Split(grd1.location,":")
		nYPos = Int(listLocation[1])
		height = listLocation[3]
		
		sPopupType = "2"
	
		Form.OpenPopup("movepopup" , nYPos & "★" & height & "★" & sPopupType & "★" &  "J"  & "★" & "현재가" & "★" & "매수" & "★" & "매도" & "★" & "" & "★" & "")

	end if
End Sub

