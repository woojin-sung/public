'============================================================================
' 01. 화 면 명 : OTP관리_스마트OTP기기등록
' 02. 화면설명 : OTP관리_스마트OTP기기등록
' 03. 작    성 : 2016. 12. 01. 윤유정 
' 04. 수    정 : 2017.12.26  윤유정 : OTP 공급회사 추가 016, 401 v0001
' 2020.09.23 : 정민영 : v0002 : [T2008250015] 메모리취약점 보완
' 2020.11.19 : 정민영 : v0003 : [T2008250015] 실명확인번호 메모리 내 평문 노출 취약점 조치(HTS, MTS)
'            : - obacp_opop_064r,obcsb_oimf_161r,523a IO 변경분 반영
'============================================================================
'****************************************************************************
'					G L O B A L	V A R I A B L E
'****************************************************************************
Dim g_szList		'계좌번호, 비밀번호
Dim g_szPW		'암호화 PW
Dim g_szSRNO		'OTP 전문일련번호
Dim g_szSTND_DATE '기준일자
Dim szRCNO		'주민번호
Dim g_Flag		
Dim g_plain_rm  	'v0002 메모리평문적용여부

'****************************************************************************
'					P E R S O N A L	F U N C T I O N
'****************************************************************************
'============================================================================
' SetPIN() : PIN발급
'============================================================================
Function SetPIN()
	
	edt2.caption = ""
	edt3.caption = ""

	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_523a", "InBlock1", "INPUT_CLS" , 0 , "1")
	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_523a", "InBlock1", "RCNO_PIP" , 0 , szRCNO)  'v0003  RCNO->RCNO_PIP
	'DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_523a", "InBlock1", "ACNO" , 0 , g_szList(0))
	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_523a", "InBlock1", "TRNM_RSLT_YN" , 0 , "N")
	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_523a", "InBlock1", "ATHN_BSWR_CLCD" , 0 , "8")
	DATAMANAGER.RequestTranData("obcsb_oimf_523a")
End Function
'============================================================================
' Query() : 161r_1
'============================================================================
Function  Query()
	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_161r_1", "InBlock1", "RCNO_PIP" , 0 , szRCNO)  'v0003  RCNO->RCNO_PIP
	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_161r_1", "InBlock1", "OTP_TLMS_SRNO" , 0 , g_szSRNO)
	DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_161r_1", "InBlock1", "TLMS_PROS_DATE" , 0 , g_szSTND_DATE)
	DATAMANAGER.RequestTranData("obcsb_oimf_161r_1")
	
End Function
'============================================================================
Function Clear_tap()
	cmb0.caption = ""
	edt0.caption = ""
	edt1.caption = ""
	edt2.caption = ""
	edt3.caption = ""
	
	btn0.enable = false
	
End Function
'****************************************************************************
'					C O M M O N	F U N C T I O N
'****************************************************************************
'============================================================================
' Form_OnFormInit()
'============================================================================
Sub Form_OnFormInit()
	g_Flag = 0
	'v0002 메모리평문적용여부(0:미적용 / 1:적용)
	g_plain_rm = Form.GetSharedData("&PLAIN_RM", false)

	Clear_tap()
End Sub
'============================================================================
' Form_OnTriggerEvent(sEventName, sParam) : 조회버튼 누를시마다 조회
'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	
	if sEventName == "스마트OTP" then
		g_szList = Split(sParam, "★")
		
		'v0002 넘어온인자가 없는경우, 아래 조회TR호출 Skip
		if UBOUND(g_szList) < 1 then
			Exit Sub
		End if
	end if

	'v0002
	if g_plain_rm == "1" then	'MTS메모리평문 적용상태일때
		g_szPW = g_szList(1)
	else  'MTS메모리평문 미적용상태일때-부모(mbonl86000)에서 미암호화된정보로 넘어오므로 암호화 필요
		g_szPW = Form.GetEncData(g_szList(1))
	end if	
	
	if g_szPW == "" then	
		call Clear_tap()
	else
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_161r", "InBlock1", "APRV_YN" , 0 , "N" )
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_161r", "InBlock1", "RCNO_PIP" , 0 , szRCNO )  'v0003  RCNO->RCNO_PIP
		
		DATAMANAGER.RequestTranData("obcsb_oimf_161r")
	end if
	
	DATAMANAGER.SetDataValue( 0 , "obacp_opop_064r", "InBlock1", "ACNO" , 0 , g_szList(0))
	
	DATAMANAGER.RequestTranData("obacp_opop_064r")
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete(szTranID)
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	Dim szCSNO		'고객번호
	Dim MsgSerial, MsgStart, MsgDate		'전문일련번호, 요청시작위치, 전문처리일자
	Dim ResCode1			'치환에 사용할 OTP 응답코드
	Dim ResCode2
	Dim sDate 
	Dim sSrno
	
	if szTranID == "obacp_opop_064r" then
		szCSNO = DATAMANAGER.GetDataValue( 0 , "obacp_opop_064r", "OutBlock1", "CSNO" , 0)
		szRCNO = DATAMANAGER.GetDataValue( 0 , "obacp_opop_064r", "OutBlock1", "RCNO_PIP" , 0)  'v0003  RCNO->RCNO_PIP
		
	elseif szTranID == "obcsb_oimf_161r" then
		ResCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_161r", "OutBlock1", "OTP_RSPN_CODE" , 0)
		edt3.caption = Form.GetMetaData("OTP응답코드", ResCode)
		
		g_szSRNO = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_161r", "OutBlock1", "OTP_TLMS_SRNO" , 0)
		g_szSTND_DATE = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_161r", "OutBlock1", "TLMS_PROS_DATE" , 0)
		
		call Query()
		
	elseif szTranID == "obcsb_oimf_161r_1" then
		edt0.caption = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_161r_1", "OutBlock1", "OTP_CARD_SRNO" , 0)
		
		if Len(edt0.caption) > 0 then
			btn0.enable = true
			g_Flag = 0
		end if
		
		
		sOtpCode = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_161r_1", "OutBlock1", "OTP_SUPL_CO_CODE" , 0)
		sOtpCodeName = Form.GetMetaData("OTP공급회사코드", sOtpCode)
		cmb0.caption = sOtpCodeName
		
		ResCode1 = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_161r_1", "OutBlock1", "OTP_RSPN_CODE" , 0)
		ResCodeName1 = Form.GetMetaData("OTP응답코드", ResCode1)
		edt3.caption = ResCodeName1
		
	elseif szTranID == "obcsb_oimf_523a" then
	
		sDate = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_523a", "OutBlock1", "STND_DATE" , 0)
		sSrno = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_523a", "OutBlock1", "OTP_TLMS_SRNO" , 0)
		
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_523a_1", "InBlock1", "INPUT_CLS" , 0 , "1")
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_523a_1", "InBlock1", "RCNO_PIP" , 0 , szRCNO)  'v0003 RCNO->RCNO_PIP
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_523a_1", "InBlock1", "TRNM_RSLT_YN" , 0 , "Y" )
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_523a_1", "InBlock1", "STND_DATE" , 0 , sDate)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_523a_1", "InBlock1", "OTP_TLMS_SRNO" , 0 , sSrno)
		DATAMANAGER.SetDataValue( 0 , "obcsb_oimf_523a_1", "InBlock1", "ATHN_BSWR_CLCD" , 0 , "8")
		
		DATAMANAGER.RequestTranData("obcsb_oimf_523a_1")
	elseif szTranID == "obcsb_oimf_523a_1" then
	
		edt1.caption = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_523a_1", "OutBlock1", "PIN_NO" , 0)
		
		ResCode2 = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_523a_1", "OutBlock1", "OTP_RSPN_CODE" , 0)
		ResCodeName2 = Form.GetMetaData("OTP응답코드", ResCode2)
		edt3.caption = ResCodeName2
		
	end if 
	
End Sub

'============================================================================
Sub btn0_OnClick()

	if g_szPW == "" or g_szPW == Null then
		Form.ShowAlert( "알림", "비밀번호를 입력하세요")
		Exit Sub
	end if
	
	if Len(Trim(edt0.caption)) < 1 then
		Form.MsgBox("알림","OTP일련번호를 확인하세요.")
		Exit Sub
	else
		Form.OpenFramePopup( "mhetc90060_p5" , "" , sPosInfo)
	end if
End Sub
'============================================================================
' Form_OnPopupReturn 
'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhetc90060_p5" then	'공인인증서 성공여부;비밀번호
		Dim szTempData
		szTempData = Split(sRet, ";")	'성공여부, 비밀번호
		if szTempData(0) == "ok" then		'성공
			SetPIN()
		else						'실패
			exit sub
		end if
		
	end if
End Sub
'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	Dim szSubErr

	if szTranID == "obcsb_oimf_161r" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_161r" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	elseif szTranID == "obcsb_oimf_161r_1" then
		if szErrCode == "3021" then
			if g_Flag = 0 then
				g_Flag = 1
				Query()
			else
				szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_161r_1" )
				Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
				g_Flag = 0
			end if
		else	
			szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_161r_1" )
			Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
			g_Flag = 0
		end if
	elseif szTranID == "obcsb_oimf_523a" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_523a" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	elseif szTranID == "obcsb_oimf_523a_1" then
		szSubErr = DATAMANAGER.GetDataMsgSubText( "obcsb_oimf_523a_1" )
		Form.ShowAlert( "알림" , szErrMsg.."("..szSubErr..")")
	end if
End Sub


	</SCRIPT_INFO>
