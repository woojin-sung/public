'===============================================
' contBg_btnCancel_OnClick
'===============================================
Sub contBg_btnCancel_OnClick()
	Form.OpenScreen("65020", "0", "")
	Form.CloseForm()
End Sub

'===============================================
' contBg_btnOk_OnClick
'===============================================
Sub contBg_btnOk_OnClick()
	szData = Form.getSharedData("65000_LINK_SUB_DATA",true)
	
	if g_szLinkScrNo == "16060" or g_szLinkScrNo == "16061" then
		Form.OpenScreen(g_szLinkScrNo , g_szLinkSubData)
	elseif g_szLinkScrNo == "16090" then
		Form.OpenScreen(g_szLinkScrNo , szData)
	else
		Form.SendReturnToParent("EXCHANGE_END" , "OK")
	end if
			
	Form.CloseForm()
End Sub

