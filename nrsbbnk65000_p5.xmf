'===============================================
' 배경 컨테이너 크기 조정
'===============================================
Function DisplaySetting_ContBg(szGbn)
	nPannelHeight = 0

	nTotalHeight = 56 + nPannelHeight
	contBg.top = 755 - nTotalHeight
	contBg.height = nTotalHeight+5
	
	contBg.visible = true
End Function 


'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'===============================================
' Form_OnFormInitBefore
'===============================================
Sub Form_OnFormInitBefore()
End Sub

'===============================================
' Form_OnFormInit
'===============================================
Sub Form_OnFormInit()

	Dim szLinkData
	szLinkData = ""
	szLinkData = Form.GetOpenLinkData()
	
	if szLinkData == "" then
		Form.CloseForm()
		Exit Sub
	end if 
	
	Init_Control()
	
	arrLinkData = split(szLinkData, "★")
	
	if #arrLinkData < 1 then
		Form.CloseForm()
		Exit Sub
	else
		if #arrLinkData > 0 then
			if arrLinkData(0) == "Complete" then
				if #arrLinkData > 2 then
					contBg.imgNotice.imgpath = "icon_confirm"
					contBg.lblTitle.caption = "환전이 완료되었습니다."

					arrLinkData_1 = split(arrLinkData(1), "`")
					arrLinkData_2 = split(arrLinkData(2), "`")
					
					arrLinkData_3 = split(arrLinkData(3), "`")
					
					contBg.contTop.lblCrcd00.caption = arrLinkData_1(0)
					contBg.contTop.lblSellAmt.caption = arrLinkData_1(1)
					
					'if arrLinkData_1(0) <> "VND" then
						contBg.contBottom.lblData00.caption = arrLinkData_1(1)  & " " & arrLinkData_1(0)
					'else
					'	contBg.contBottom.lblData00.caption = arrLinkData_1(1)
					'end if
					
					szFlag1 = Form.getIconImg("CRCD", arrLinkData_1(0))
					if szFlag1 = "" then
						szFlag1 = "flag_general"
					end if
					
					contBg.contTop.imgFlag00.imgpath = szFlag1
					contBg.contBottom.imgFlag02.imgpath = szFlag1
					
					nTxtWidth = Form.getTextWidth("매도금액", "-2", false, false)
					contBg.contBottom.imgFlag02.left = nTxtWidth + 5
					
					contBg.contTop.lblCrcd01.caption = arrLinkData_2(0)
					contBg.contTop.lblBuyAmt.caption = arrLinkData_2(1)
					
					
					'if arrLinkData_2(0) <> "VND" then
					if arrLinkData_2(0) <> "VND" and arrLinkData_1(0) <> "VND" then
						contBg.contBottom.lblData01.caption = arrLinkData_2(1) & " " & arrLinkData_2(0)
					else
						contBg.contBottom.lblData01.caption = arrLinkData_2(1)
					end if
					
					
					szFlag2 = Form.getIconImg("CRCD", arrLinkData_2(0))
					if szFlag2 = "" then
						szFlag2 = "flag_general"
					end if
					
					contBg.contTop.imgFlag01.imgpath = szFlag2
					contBg.contBottom.imgFlag03.imgpath = szFlag2
					
					nTxtWidth = Form.getTextWidth("매수금액", "-2", false, false)
					contBg.contBottom.imgFlag03.left = nTxtWidth + 5
					
					contBg.contBottom.lblData02.caption = FormatNumber(arrLinkData_3(0), 2)
					
					contBg.contBottom.lblDataAcc.caption = arrLinkData(4)
					
					if arrLinkData(5) == "002" then
						contBg.lblTitle.caption = "시간외환전 신청이 완료되었습니다."
						contBg.contBottom.lblInfo0.visible = true
						szData = "익영업일 9시경 실시간 환율로 정산되오니,\n환전내역에서 처리결과를 확인해주세요."
						contBg.contBottom.lblInfo0.caption = szData
						contBg.contBottom.lblInfo0.top = 164
						
						contBg.contBottom.lblSubTitle02.caption = "예상환율"
						
					elseif arrLinkData(5) == "VND" then
						contBg.lblTitle.caption = "환전 신청이 완료되었습니다."
						contBg.contBottom.lblInfo0.visible = true
						szData = "베트남(VND) 환전은1~2영업일이 소요되므로,\n환전내역에서 처리결과를 확인해주세요."
						contBg.contBottom.lblInfo0.caption = szData
						contBg.contBottom.lblInfo0.top = 164
						
						contBg.contBottom.lblData02.caption = "미정"
					end if
					
					arrLinkData_4 = split(arrLinkData(6), "`")
					
					g_szLinkScrNo = arrLinkData_4(0)
					g_szLinkSubData = arrLinkData_4(1)
				else
				
				end if
			
			elseif arrLinkData(0) == "Error" then
				contBg.contBottomError.visible = true
				contBg.contBottom.visible = false
				
				contBg.imgNotice.imgpath = "icon_tact_caution"
				contBg.lblTitle.caption = "환전이 처리되지 않았습니다."
				
				arrLinkData_1 = split(arrLinkData(1), "`")
				arrLinkData_2 = split(arrLinkData(2), "`")
				
				arrLinkData_3 = split(arrLinkData(3), "`")
				
				contBg.contTop.lblCrcd00.caption = arrLinkData_1(0)
				contBg.contTop.lblSellAmt.caption = arrLinkData_1(1)
				
				szFlag1 = Form.getIconImg("CRCD", arrLinkData_1(0))
				if szFlag1 = "" then
					szFlag1 = "flag_general"
				end if
				
				contBg.contTop.imgFlag00.imgpath = szFlag1
			
				contBg.contTop.lblCrcd01.caption = arrLinkData_2(0)
				contBg.contTop.lblBuyAmt.caption = arrLinkData_2(1)
		
				
				szFlag2 = Form.getIconImg("CRCD", arrLinkData_2(0))
				if szFlag2 = "" then
					szFlag2 = "flag_general"
				end if
			
				contBg.contTop.imgFlag01.imgpath = szFlag2
				
'				contBg.contBottomError.lblData.caption = "["&arrLinkData_3(0)&"] " & arrLinkData_3(1)
				contBg.contBottomError.lblData.caption =  arrLinkData_3(1)
				
				contBg.btnCancel.visible = false
				contBg.btnOk.fgcolor = g_szTxtColor_White
				contBg.btnOk.left = 0
				contBg.btnOk.width = 375
				
				if arrLinkData(4) == "002" then
					contBg.lblTitle.caption = "시간외환전 신청이 불가합니다."
				end if
				
				arrLinkData_4 = split(arrLinkData(5), "`")
					
				g_szLinkScrNo = arrLinkData_4(0)
				g_szLinkSubData = arrLinkData_4(1)
				
				
			elseif arrLinkData(0) == "CompleteCross" then
				contBg.contBottom.lblLine1.visible = true
				contBg.contBottom.lblSubTitle10.visible =true
				contBg.contBottom.lblSubTitle11.visible =true
				contBg.contBottom.lblSubTitle12.visible =true
				contBg.contBottom.lblData10.visible =true
				contBg.contBottom.lblData11.visible =true
				contBg.contBottom.lblData12.visible =true
				contBg.contBottom.lblLine2.visible =true
				
'				contBg.contBottom.imgFlag04.visible = true
'				contBg.contBottom.imgFlag05.visible = true
				
				if #arrLinkData > 2 then
					if arrLinkData(8) <> "03" then
						contBg.imgNotice.imgpath = "icon_confirm"
						contBg.lblTitle.caption = "환전이 완료되었습니다."
						
						arrLinkData_1 = split(arrLinkData(1), "`")
						arrLinkData_2 = split(arrLinkData(2), "`")
						arrLinkData_3 = split(arrLinkData(3), "`")
						
						arrLinkData_4 = split(arrLinkData(4), "`")
						arrLinkData_5 = split(arrLinkData(5), "`")
						arrLinkData_6 = split(arrLinkData(6), "`")
						
						'===============================================
						'상단
						contBg.contTop.lblCrcd00.caption = arrLinkData_1(0)
						contBg.contTop.lblSellAmt.caption = arrLinkData_1(1)
						
						szFlag = Form.getIconImg("CRCD", arrLinkData_1(0))
						if szFlag = "" then
							szFlag = "flag_general"
						end if
						contBg.contTop.imgFlag00.imgpath = szFlag
						
						contBg.contTop.lblCrcd01.caption = arrLinkData_5(0)
