		<LABEL name="Label1" caption="※ 비용은 최초 매입시점부터 발생한 누적비용입니다." autofontsize="1" ly_vert="10,59,359,25,1" />
		<BUTTON name="btnFold" caption="상세" fgcolor="004:000000000" btnimage="btn_02.9.png" ly_vert="300,10,66,39,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="5444" _ulen="5254" >
'****************************************************************************
'               G  R  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_szTranID, g_szFold
g_szFold = "1"
g_szTranID = "obtrc_stlm_003r"
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
'****************************************************************************
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
'	Dim szYYYY, szMM
'	
'	szYYYY 	= cldFrom.calyear
'	szMM 	= cldFrom.calmonth
'	
'	cldFrom.caption = szYYYY & szMM & "01"
	
	szFold	 = Form.LoadConfigData( "mbtrs11000_t9", "fold" )'펼침버튼
	
	If szFold <> "" Then
		If szFold = "1" Then
			g_szFold = "0"
		Else
			g_szFold = "1"
		End If
	End If
	
	btnFold_OnClick()
	
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "RECEIVE" or sEventName == "CHANGE_ACCTNO" then
		DATAMANAGER.RequestTranData( g_szTranID )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == g_szTranID then
		Dim szACNO, szASNO
		
		szACNO = Form.GetCtlProp("#acnt0", "total")
		szASNO = Form.GetCtlProp("#acnt0", "sequence")
		
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ACNO", 0, szACNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "ASNO", 0, szASNO )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_STA_DATE", 0, cldFrom.caption )
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "IQRY_FIN_DATE", 0, cldTo.caption )
	end if
	
End Sub



'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == g_szTranID then
		'합 부분 데이터 계산식
		'비용 = 수수료 + 거래세 + 롤오버이자
		'순손익 = 매수순손익 + 매도순손익
		
		Dim nSumTax1, nFee1, nTrtx1, nRolv1
		Dim nSumTax2, nFee2, nTrtx2, nRolv2
		Dim nSumSun, nMasu, nMado
		
		nFee1  = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CFD_BYOV_FEE"		, 0)) '매수수수료
		nTrtx1 = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_BYOV_TRTX"		, 0)) '매수거래세
		nRolv1 = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CFD_BYOV_RLOV_INT"	, 0)) '매수롤오버이자
		
		nFee2  = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CFD_SELN_FEE"		, 0)) '매도수수료
		nTrtx2 = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_SELN_TRTX"		, 0)) '매도거래세
		nRolv2 = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "CFD_SELN_RLOV_INT"	, 0)) '매도롤오버이자
		
		nSumTax1 = nFee1 + nTrtx1 + nRolv1
		nSumTax2 = nFee2 + nTrtx2 + nRolv2
		
		nMasu = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "BYOV_NTPL_AMT", 0)) '매수순손익
		nMado = CInt(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "SELN_NTPL_AMT", 0)) '매도순손익
		
		nSumSun = nMasu + nMado
		
		tbl0.SetCellString( 8, 2, nSumTax1)
		tbl0.SetCellString( 8, 3, nSumTax2)
		tbl0.SetCellString( 9, 2, nSumSun )
		
		Dim szData
		
		For i = 0 To grd0.rowcount -1
			'매매구분
			szData = grd0.GetCellData( "bd_cell20", i)
			
			If szData = "1" Then
				grd0.SetCellFgColor("bd_cell2", i, "11")
			Else
				grd0.SetCellFgColor("bd_cell2", i, "10")
			End If
		Next	
		
	end if
	
End Sub

'============================================================================
Sub cldFrom_OnEditComplete()
	DATAMANAGER.RequestTranData( g_szTranID )
	
End Sub

'============================================================================
Sub cldTo_OnEditComplete()
	DATAMANAGER.RequestTranData( g_szTranID )
	
End Sub

'============================================================================
Sub Grid0_OnScrollEnd()
	Dim isMore
	isMore = DATAMANAGER.IsMoreNextData( g_szTranID )
	
	if isMore == 1 or isMore == "0" then
		DATAMANAGER.RequestNextData( g_szTranID )
	end if
	
End Sub

'============================================================================
Sub btnFold_OnClick()
	If g_szFold = "1" Then
		g_szFold = "0"
'		btnFold.btnimage = "btn_filter2.9.png"
		btnFold.caption = "상세"
		tbl0.visible = true
		
'		grd0.top = 377
'		grd0.height = 92

		grd0.visible = false
	Else
		g_szFold = "1"
'		btnFold.btnimage = "btn_filter.9.png"
		btnFold.caption = "요약"
		
		tbl0.visible = false
		
'		grd0.top = 59
'		grd0.height = 410

		grd0.visible = true
	End If
End Sub

'============================================================================
Sub Form_OnFormClose()
	Form.SaveConfigData("mbtrs11000_t9", "fold", g_szFold) 	'펼침버튼
End Sub

'============================================================================
Sub grd0_OnScrollEnd()
	Dim isMore
	isMore = DATAMANAGER.IsMoreNextData( g_szTranID )
	
	if isMore == true or isMore == 1 or isMore == "1" then
		DATAMANAGER.RequestNextData( g_szTranID )
		
	end if
End Sub



