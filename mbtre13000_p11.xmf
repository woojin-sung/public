'-------------------------------------------------------------------------------------------
' 01. 화 면 명 : CFD대체주문
' 02. 화면설명 : CFD대체주문 주문확인창
' 03. 작    성 : 2022.02.17 SWJ
'-------------------------------------------------------------------------------------------

'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************


Dim g_nCount
	g_nCount = 0

Dim g_OutAcno
Dim g_OutPrnm
Dim g_AbleAmt
Dim g_InAcno
Dim g_OutPwd
Dim g_InPrnm
Dim g_ShortAmt
Dim g_szCertUserType 	'0:일반인증서 1 : 간편로그인 3:바이오 
Dim g_sMdiaSkipYn
Dim g_OrderGbn
'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
'****************************************************************************

'============================================================================
'주문화면 데이터
'============================================================================
Function Set_Data(nIndex)
	
	if nIndex = 0 then
		tblMaesu1.SetCellString( 0, 1, g_OutAcno		)
		tblMaesu1.SetCellString( 0, 3, g_OutPrnm		)
		
		Edit2.caption = g_AbleAmt
		Edit1.caption = g_ShortAmt
		
		tblMaesu1.SetCellString( 4, 1, g_InAcno 	)	
		tblMaesu1.SetCellString( 4, 3, g_InPrnm	)	
	else
		tblMaesu2.SetCellString( 0, 1, g_OutAcno 	)
		tblMaesu2.SetCellString( 0, 3, g_OutPrnm		)
		tblMaesu2.SetCellString( 1, 1, g_AbleAmt				)
		tblMaesu2.SetCellString( 2, 1, g_ShortAmt			)
	end if 
	
End Function

'============================================================================
Function SendOrder()
	DATAMANAGER.RequestTranData("obcsb_oimf_638r")
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	
End Sub
'============================================================================
Sub Form_OnFormInit()
    ' login type get
	g_szCertUserType = Form.GetSharedData("&CERT_USE_TYPE", 0 )
	
'	Edit0.imagefilepth			= "notice_bg.9.png"
'	Edit1.imagefilepth			= "login_input.9.png"

	Dim szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = Split(szData,"@")
	
	if UBOUND(arrData) < 1 then
	    Exit sub
	End if
	
	'출금가능액 >= 증거금부족액
	if arrData(0) == "0" then
		g_OutAcno   = arrData(1)		'출금계좌번호
		g_OutPrnm   = arrData(2) 		'출금계좌 상품명
		g_AbleAmt   = arrData(3) 		'출금계좌 주문가능금액
		g_InAcno    = arrData(4) 		'입금계좌번호
		g_OutPwd    = arrData(5) 		'계좌비밀번호
		g_InPrnm    = arrData(6) 		'입금계좌 상품명
		g_ShortAmt  = arrData(7) 		'증거금 부족금액
		g_OrderGbn  = arrData(8)		'매수/매도/정정
		
		Set_Control(0)
		
	'출금가능액 < 증거금부족액
	else
		g_OutAcno   = arrData(1)		'출금계좌번호
		g_OutPrnm   = arrData(2) 		'출금계좌 상품명
		g_AbleAmt   = arrData(3) 		'출금계좌 주문가능금액
		g_ShortAmt  = arrData(4) 		'증거금 부족금액
		
		Set_Control(1)
	end if
End Sub

'============================================================================
Sub btnMaesu1Close_OnClick()
	Form.CloseForm( )	
End Sub

'============================================================================
Sub btnMaesu1_OnClick()
	SendOrder()
End Sub

'============================================================================
Sub imgClose1_OnClick()
	Form.CloseForm( )
End Sub
'============================================================================
Sub Edit0_OnEditComplete()
	'Form.SetTimerEvent2("2", 1, 0.3)
	
	'주문화면에서 비밀번호를 가져오지만
	'사용자가 직접 입력해서 비밀번호 변경해서 넣는 경우
	g_OutPwd = Edit0.caption
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(sTimerID, 0, 0.6)
		Edit0.SetShowKeypad(True)
	elseif sTimerID == "2" or sTimerID == 2 then
		Form.SetTimerEvent2(sTimerID, 0, 0.3)
		Edit1.SetShowKeypad(True)
	end if
End Sub
'============================================================================
'팝업에 따른 컨트롤 세팅
'============================================================================
Sub Set_Control(nIndex)
	
	if nIndex = 0 then
		lblMaesu1Title.caption = "CFD 주문증거금 자동관리"
		tblMaesu1.visible = true
		tblMaesu2.visible = false
		btnMaesu1.visible = True
		Label6.top = 248
		Label20.top = 249
		Label21.top = 269
		btnMaesu1.visible = True
		
		'종합계좌가 다른 경우 비밀번호 클리어해서 보여주기
		if Left(g_OutAcno,8) <> Left(g_InAcno,8) then
			Edit0.caption = ""
		else
			Edit0.caption = "●●●●"
		end if
		
		if g_OrderGbn = "매수" then
			btnMaesu1.btnimage = "btn_05.9"
		elseif g_OrderGbn = "매도" then
			btnMaesu1.btnimage = "btn_06.9"
		elseif g_OrderGbn = "청산" then
			btnMaesu1.btnimage = "btn_13.9"
		else
			btnMaesu1.btnimage = "btn_07.9"
		end if
		
		'Form.SetTimerEvent2("1", 1, 0.6)
	else
		Form.Height = 305
		lblMaesu1Title.caption = "CFD 주문증거금 자동관리"
		tblMaesu2.visible = true
		tblMaesu1.visible = false
		Label6.top = 185
		Label20.top = 186
		Label21.top = 206
		btnMaesu1.visible = False
		
		Edit0.visible = false
		Edit1.visible = false
		Edit2.visible = false
		
		Label0.visible = False
		Label1.visible = False
		Label2.visible = False
		
		Label20.caption = "사용가능증거금과 연결계좌의 출금가능금액이"
		Label21.caption = "모두 부족합니다."
		btnMaesu1Close.top = 250
		btnMaesu1Close.left = 95
		Form.resize = 355
		btnMaesu1Close.caption = "확인"
	end if
	
	Set_Data(nIndex)
End Sub
'============================================================================
' DATAMANAGER_OnSendTranBefore
'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID = "obrtd_drng_035a" then
		
		DATAMANAGER.SetDataValue(0 , "obrtd_drng_035a", "InBlock1", "ACNO" 			, 0 , Left(g_InAcno,8) )
		DATAMANAGER.SetDataValue(0 , "obrtd_drng_035a", "InBlock1", "ASNO" 			, 0 , Right(g_InAcno,2))
		DATAMANAGER.SetDataValue(0 , "obrtd_drng_035a", "InBlock1", "ACNT_PWD" 		, 0 , g_OutPwd		 )
		DATAMANAGER.SetDataValue(0 , "obrtd_drng_035a", "InBlock1", "DRNG_ACNO" 		, 0 , Left(g_OutAcno,8)  )
		DATAMANAGER.SetDataValue(0 , "obrtd_drng_035a", "InBlock1", "DRNG_ASNO" 		, 0 , Right(g_OutAcno,2) )
		DATAMANAGER.SetDataValue(0 , "obrtd_drng_035a", "InBlock1", "MNRC_AMT" 		, 0 , Edit1.caption	 )
		DATAMANAGER.SetDataValue(0 , "obrtd_drng_035a", "InBlock1", "TRMD_CLS_CODE" 	, 0 , "11"			 )
		DATAMANAGER.SetDataValue(0 , "obrtd_drng_035a", "InBlock1", "BNKB_GRP_NO" 	, 0 , g_szCertUserType & g_sMdiaSkipYn	 ) 
		
	elseif szTranID = "obcsb_oimf_638r" then
		szUserId = Trim(Form.GetSharedData("&USER_ID", false ))	'사용자ID	
		
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "ELFN_ID" , 0 , szUserId)	'사용자ID
		DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "UI_TERM_IDNT_KEY" , 0 , Form.GetDeviceID())	'UI단말식별키

		IF g_szCertUserType = "1" THEN
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "201")	'201 SPIN 로그인 이체
		ELSEIF g_szCertUserType = "3" THEN
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "203")	'203 바이오 로그인 이체
		ELSE
			DATAMANAGER.SetDataValue(0, "obcsb_oimf_638r", "InBlock1", "SVCD" , 0 , "200")'이체	'기본 '200'  등록 '400'
		END IF
		
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "TACT_CLS_CODE"	, 0, "01"					)		'대체출금
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "DRNG_ACNO" 		, 0, Left(g_OutAcno,8) 		)
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "DRNG_ASNO" 		, 0, Right(g_OutAcno,2)  		)
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_BANK_CODE"	, 0, "287"					)		'당사
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ACNO"		, 0, Left(g_InAcno,8)		 	)
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "MNRC_ASNO"		, 0, Right(g_InAcno,2)		 	)
		DATAMANAGER.SetDataValue( 0, "obcsb_oimf_638r", "InBlock2", "TACT_AMT" 		, 0, Edit1.caption			)		'대체금액
		
	end if
End Sub
'============================================================================
' DATAMANAGER_OnReceiveTranComplete
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID = "obcsb_oimf_638r" then
		g_sMdiaSkipYn = DATAMANAGER.GetDataValue( 0 , "obcsb_oimf_638r", "OutBlock3", "SECU_MDIA_EXLS_YN" , 0)	'보안매체제외여부

		DATAMANAGER.RequestTranData("obrtd_drng_035a")
		
	elseif szTranID = "obrtd_drng_035a" then
		Form.SendReturnToParent( "주문전송" , "1")
		
		Form.CloseForm( )
	end if

End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	Dim szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if Trim(szSubMsg) <> "" then
		Form.ShowAlert(g_szTitle, szErrMsg & "(" & szSubMsg & ")")
		'Form.Toast(0, szErrMsg & "(" & szSubMsg & ")", true)	
	else
		Form.ShowAlert(g_szTitle, szErrMsg)
		'Form.Toast(0, szErrMsg, true)
	end if
	
	'Form.CloseForm()
End Sub

	</SCRIPT_INFO>
