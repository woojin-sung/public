	fmtab1.setTabHeaderImage("tab_01_o.9.png","tab_01_n.9.png", 0.5)
	fmtab2.setTabHeaderImage("tab_01_o.9.png","tab_01_n.9.png", 0.5)
	fmtab3.setTabHeaderImage("tab_01_o.9.png","tab_01_n.9.png", 0.5)
	fmtab4.setTabHeaderImage("tab_01_o.9.png","tab_01_n.9.png", 0.5)
	fmtab5.setTabHeaderImage("tab_01_o.9.png","tab_01_n.9.png", 0.5)
	fmtab6.setTabHeaderImage("tab_01_o.9.png","tab_01_n.9.png", 0.5)
	fmtab7.setTabHeaderImage("tab_01_o.9.png","tab_01_n.9.png", 0.5)
	fmtab8.setTabHeaderImage("tab_01_o.9.png","tab_01_n.9.png", 0.5)
End Sub

