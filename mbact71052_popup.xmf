'20230203 HSZ START : 개별계좌 속성에 따라 폼탭 구성
'============================================================================
' TabClear()			: 폼탭 안보이게끔 이동
'============================================================================
Sub TabClear()
	for i = 1 to 8
		Form.SetCtlProp("fmtab" & CStr(i), "left", 1000)
	next
End Sub

'============================================================================
' TabUISetting(szGrp)	: 그룹인덱스에 해당되는 폼탭 보여줌
'============================================================================
Sub TabUISetting(szGrp)	
	szOsType 	= Form.GetSharedData("&OS_TYPE", False)  '1.안드로이드 2.iOS
	if szOsType = "2" and g_initFlag = "0" then 			'iOS만 currenttab 전에 세팅 -  폼탭 SetUseAnimation 활성화 위해
		SetTabImage()
	end if

	if g_szList(2) = "t1" and g_initFlag = "0" then 		'상품별 잔고탭에서 진입 시에만
		Form.SetCtlProp("fmtab" & CStr(szGrp), "currenttab", g_nTabIndex)
		Call SetTrigger(g_nTabIndex)
	else
	
		if Trim(g_nTabKey) = "" then 'v02
			Form.SetCtlProp("fmtab" & CStr(szGrp), "currenttab", 0)
			Call SetTrigger(0)
		else
			Form.SetCtlProp("fmtab" & CStr(szGrp), "currenttabpageid", CInt(g_nTabKey))
			Call SetTrigger(g_nTabIndex)
		end if
	end if
	
	Form.SetCtlProp("fmtab" & CStr(szGrp), "left", 0)
	
	Select Case CInt(szGrp)
	Case 1
		fmtab1.SetUseAnimation("1")
	Case 2
		fmtab2.SetUseAnimation("1")
	Case 3
		fmtab3.SetUseAnimation("1")
	Case 4
		fmtab4.SetUseAnimation("1")
	Case 5
		fmtab5.SetUseAnimation("1")
	Case 6
		fmtab6.SetUseAnimation("1")
	Case 8	
		fmtab8.SetUseAnimation("1")
	Case Else	
		fmtab7.SetUseAnimation("1")
	End Select

End Sub

