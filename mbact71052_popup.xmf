'============================================================================
' cmb0_OnEditComplete(iIndex)
'============================================================================
Sub cmb0_OnEditComplete(iIndex)
	g_szCmbIndex = iIndex
	
	'화면 연동시, 선택한 계좌로 세팅
	if Cint(iIndex) <> 0 then
		szAccString = cmb0.cbkeydata
		szIdx = acc0.GetIndexByAccountinfo(szAccString)
		acc0.currentindex = szIdx
	end if

'	20230203 HSZ START : 개별계좌 속성에 따라 폼탭 구성
'	SetTrigger(nTabIndex)

	if g_initFlag <> "0" then	'Form Init 이후 폼탭 세팅
		nPrevKey = Form.GetCtlProp("fmtab" & CStr(g_szTabgrp), "currenttabpageid")
'		Form.ShowAlert("nPrevKey:"..nPrevKey,"")
		if iIndex = 0 then	
			g_szTabgrp = "7"
		else
			g_szTabgrp = g_aryTabGrp(iIndex)
		end if
'		20230203-v02 HSZ START
		Dim nCtlTab
		nCtlTab = ""
		Select Case CInt(g_szTabgrp)
		Case 1
			nNumTab = #g_szTabArray1
			for i = 0 to nNumTab-1
				szPageID   = g_szTabArray1(i)
				
				if CInt(nPrevKey) = CInt(szPageID) then
					nCtlTab = szPageID
				end if
			next
		Case 2
			nNumTab = #g_szTabArray2
			for i = 0 to nNumTab-1
				szPageID   = g_szTabArray2(i)
				
				if CInt(nPrevKey) = CInt(szPageID) then
					nCtlTab = szPageID
				end if
			next
		Case 3
			nNumTab = #g_szTabArray3
			for i = 0 to nNumTab-1
				szPageID   = g_szTabArray3(i)
				
				if CInt(nPrevKey) = CInt(szPageID) then
					nCtlTab = szPageID
				end if
			next
		Case 4
			nNumTab = #g_szTabArray4
			for i = 0 to nNumTab-1
				szPageID   = g_szTabArray4(i)
				if CInt(nPrevKey) = CInt(szPageID) then
					nCtlTab = szPageID
				end if
			next
		Case 5
			nNumTab = #g_szTabArray5
			for i = 0 to nNumTab-1
				szPageID   = g_szTabArray5(i)
				
				if CInt(nPrevKey) = CInt(szPageID) then
					nCtlTab = szPageID
				end if
			next
		Case 6
			nNumTab = #g_szTabArray6
			for i = 0 to nNumTab-1
				szPageID   = g_szTabArray6(i)
				
				if CInt(nPrevKey) = CInt(szPageID) then
					nCtlTab = szPageID
				end if
			next
		Case 8	
			nNumTab = #g_szTabArray8
			for i = 0 to nNumTab-1
				szPageID   = g_szTabArray8(i)
				
				if CInt(nPrevKey) = CInt(szPageID) then
					nCtlTab = szPageID
				end if
			next
		Case Else	
			nNumTab = #g_szTabArray7
			for i = 0 to nNumTab-1
				szPageID   = g_szTabArray7(i)
				
				if CInt(nPrevKey) = CInt(szPageID) then
					nCtlTab = szPageID
				end if
			next
		End Select

		g_nTabKey = nCtlTab

'		20230203-v02 HSZ END

		TabClear()
		TabUISetting(g_szTabgrp)
	end if

'	20230203 HSZ END
	
End Sub

