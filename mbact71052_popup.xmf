'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)

	' ----------------------------------------------------------------------
	' 고객종합계좌목록조회
	' ----------------------------------------------------------------------
	if szTranID == "ooopc_cuma_093r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO", 			0, 	g_CSNO)
	
	' ----------------------------------------------------------------------
	' 고객 계별계좌별 자산현황조회
	' ----------------------------------------------------------------------
	elseif szTranID == "obacb_balc_158r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "IQRY_CLS_CODE", 	0, 	"2")
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "CSNO", 			0, 	g_CSNO)
		'v0002 : 계좌표시순서 적용을 위한 id 맵핑
		szCustID = Form.GetSharedData("&USER_ID", false)
		DATAMANAGER.SetDataValue( 0 , szTranID, "InBlock1", "ELFN_ID" , 0 , szCustID)
	end if
	
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
'	DATAMANAGER.ClearInputData(0, szTranID)
	
	' ----------------------------------------------------------------------
	' 고객종합계좌목록조회
	' ----------------------------------------------------------------------
	if szTranID == "ooopc_cuma_093r" then

		if  DATAMANAGER.IsMoreNextData( "ooopc_cuma_093r" ) == True then 
			DATAMANAGER.RequestNextData("ooopc_cuma_093r")
		else
			DATAMANAGER.RequestTranData("obacb_balc_158r")
		end if
		
	' ----------------------------------------------------------------------
	' 고객 계별계좌별 자산현황조회
	' ----------------------------------------------------------------------
	elseif szTranID == "obacb_balc_158r" then
	
		if DATAMANAGER.IsMoreNextData( "obacb_balc_158r" ) == True then
			DATAMANAGER.RequestNextData("obacb_balc_158r")
		else
		
			' 개별계좌 속성에 따라 폼탭 구성 --------------
			szGrpIdx = CInt(grdCmb.rowcount)
			for i = 0 to CInt(grdCmb.rowcount) - 1
				szidx = CInt(grdCmb.GetCellData("bd_cell3", i))
				szGrpIdx = szGrpIdx & "☆" & szidx
			next

			g_aryTabGrp = Split(szGrpIdx, "☆")	
			if UBOUND(g_aryTabGrp) < 1 then
				Exit Sub
			End if	
			g_initFlag = "0"
			' -------------------------------------------------------------------

			f_DataFormatting()
		end if	

	end if

End Sub

'============================================================================
' 데이터 포매팅 함수
'============================================================================
Sub f_DataFormatting()
	Dim szData

	'종합계좌 데이터
	szAsnoList = ""
	for i=0 to CInt(grd1.rowcount)-1
		szAcctotal = grd1.GetCellData("bd_cell0", i)
		szAsnoList = szAsnoList & "○" & szAcctotal	'종합계좌 리스트
	next
	
	'개별계좌 데이터
	szAccCmb = ""
	szAccCmbTxt = ""
	for i=0 to CInt(grdCmb.rowcount)-1
		szAcnoCmb = grdCmb.GetCellData("bd_cell0", i)
		szAsnoCmb = grdCmb.GetCellData("bd_cell1", i)
		szNameCmb = grdCmb.GetCellData("bd_cell2", i)
		szfullacc = szAcnoCmb..szAsnoCmb
		if szNameCmb <> "" then
			szaccname = "["..szNameCmb.."] "..left(szAcnoCmb, 4).."-"..right(szAcnoCmb, 4).."-"..szAsnoCmb
		else
			szaccname = left(szAcnoCmb, 4).."-"..right(szAcnoCmb, 4).."-"..szAsnoCmb
		end if
		szAccCmb = szAccCmb & "○" & szfullacc				'개별계좌 리스트
		szAccCmbTxt = szAccCmbTxt & "○" & szaccname			'개별계좌명 리스트
	next
	
	szACNO	= cmb0.caption
	szIndex	=  10

	szData = szIndex & "☆" & CInt(grd1.rowcount) & "☆" & "t1" & "☆" & szACNO & "☆" & szAsnoList& "☆" & CInt(grdCmb.rowcount) & "☆" & szAccCmb & "☆" & szAccCmbTxt 
			'tab인덱스, 종합계좌개수, 탭, 선택계좌번호, 종합계좌리스트, 개별계좌개수, 개별계좌리스트

	f_SetScrn(szData)
End Sub

'============================================================================
' 화면 세팅 함수
'============================================================================
Sub f_SetScrn(szData)
	g_szCmbAcnt = ""
	accList = ""
	
	g_szList = Split(szData, "☆")
	
	if UBOUND(g_szList) < 1 then
		Exit Sub
	End if		
	
'	'상단 콤보에 계좌 세팅
	g_accCount = CInt(g_szList(5))	
	accArray = Split(g_szList(6), "○")
	accArrayTxt = Split(g_szList(7), "○")
	for i=0 to g_accCount
		szKey = accArray(i)
		szTxt = accArrayTxt(i)
		accList = accList & "○" & left(accArray(i), 4).."-"..Mid(accArray(i),5, 4) 
		if szKey <> "" then
			cmb0.cbadddatatext = szKey.."`"..szTxt
		end if
	next
	
	
	if g_szList(2) = "t1" then 			'상품별 잔고탭
		Dim slct_ACNO
		slct_ACNO = Form.GetSharedData("mbact71052_popup_ACNO", true)
		
		if slct_ACNO <> "" then
			cmb0.cbkeydata = slct_ACNO
		else
			cmb0.currentindex = 0			'20230203 HSZ
		end if

		g_nTabIndex = CInt(g_szList(0))
		if g_nTabIndex > 2 then
			if g_nTabIndex == 11 then	'신용/대출 눌러서 진입한 경우 - 20230203 HSZ 인덱스변경
				g_nTabIndex = 0
			else
				g_nTabIndex = Cint(g_nTabIndex)- 2
			end if
		end if
		
'		20230203 HSZ START : 개별계좌 속성에 따라 폼탭 구성
'		기존 소스 주석처리
'		fmtab0.currenttab = CInt(nTabIndex)
'		
'		if g_szList(3) = "전체" then
'			cmb0.currentindex = 0
'		else	
'			for j = 1 to g_accCount
'				if CStr(Left(accArray(j), 4).."-"..Mid(accArray(j),5, 4)) == g_szList(3) then
'					cmb0.currentindex = j
'					exit Sub
'				end if
'			next
'		end if

		g_szTabgrp = "7"
		TabUISetting(g_szTabgrp)
		g_initFlag = "1"
'		20230203 HSZ END
		
	elseif g_szList(2) = "t2" then '개별계좌별 잔고탭

'		'20221110 HSZ START: 1차 추가개선 건 -> 20230203 HSZ 기존 소스 주석처리
''		nTabIndex = 0
'		nTabIndex = g_szList(0)
'		fmtab0.currenttabpageid = nTabIndex
'		'20221110 HSZ END

		for k = 1 to CInt(cmb0.rowcount)-1
			cmb0.currentindex = k
			szAccNum = cmb0.cbkeydata
			if szAccNum = g_szList(3) then
'				20230203 HSZ START : 개별계좌 속성에 따라 폼탭 구성
				cmb0.currentindex = k
				g_szTabgrp = g_aryTabGrp(k)		'20230116
				TabUISetting(g_szTabgrp)		'20230116
				g_initFlag = "1"
'				20230203 HSZ END
				exit Sub
			end if
			
		next
		
	end if
	
End Sub

'============================================================================
Sub Form_OnTimerEvent(sTimerID)
	Form.SetTimerEvent(sTimerID, 0, 1)
	DATAMANAGER.RequestTranData("ooopc_cuma_093r")	'종합계좌 리스트 조회
End Sub

'============================================================================
Sub Form_OnTriggerEvent(sEventName, sParam)
	If sEventName == "close" Then
		Form.SendReturnToParent(sEventName , "")
		Form.CloseForm()
	End If
End Sub

