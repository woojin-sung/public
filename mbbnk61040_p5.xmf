	<SCRIPT_INFO _len="2729" _ulen="2579" >
'============================================================================
' 01. 화 면 명 : 최근이체계좌
' 02. 화면설명 : 최근이체계좌
' 03. 작    성 : 2016.02.06 ~ Test3
'============================================================================

'****************************************************************************
'                       G L O B A L     V A R I A B L E
'****************************************************************************
Dim g_szAccountNumber	'계좌번호 (8)
Dim g_szUserJumin		'실명확인번호(주민번호)
Dim g_szUserNum			'고객번호
Dim g_szIRow			'선택된 행의 인덱스

'****************************************************************************
'                     P E R S O N A L     F U N C T I O N
'****************************************************************************
'============================================================================
'****************************************************************************
'                       C O M M O N     F U N C T I O N
'****************************************************************************
'============================================================================

'============================================================================
Sub Form_OnFormInit()
	g_szAccountNumber = Form.GetOpenLinkData()
	
	if g_szAccountNumber ~= null and g_szAccountNumber ~= "" then
		DATAMANAGER.RequestTranData( "obrtp_tran_032r" )
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obrtp_tran_032r" then
		DATAMANAGER.SetDataValue(0, "obrtp_tran_032r", "InBlock1", "ACNO" , 0 , Left(g_szAccountNumber, 8))
		DATAMANAGER.SetDataValue(0, "obrtp_tran_032r", "InBlock1", "ASNO" , 0 , Right(g_szAccountNumber, 2))	
	end if
End Sub

'============================================================================
Sub imgClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub grdOften_OnClickUp(lRow, szCellID)
	Dim szCd, szAccNo , szAccNm , szBank , szData
	
	if lRow > -1 then
		szCd        = grdOften.GetCellData("bd_bankcode", lRow)
		szAccNo     = grdOften.GetCellData("bd_bankacno", lRow)
		szAccNm     = grdOften.GetCellData("bd_bankacnonm", lRow)	
		szBank      = grdOften.GetCellData("bd_banknm", lRow)	

		'  전달내용/은행코드/계좌번호/수취인/은행명
		szData = "최근이체계좌" & "★" & szCd & "★" & szAccNo & "★" & szAccNm & "★" & szBank
        
		Form.SendReturnToParent("mbbnk61040_p5", szData)
		Form.CloseForm()
	end if
End Sub

	</SCRIPT_INFO>
	<DATAIO_INFO>
		<TRID_INFO>
			<TRAN tranid="obrtp_tran_032r" trcode="obrtp_tran_032r" compress="1" encryption="1" inputcheck="1" />
		</TRID_INFO>
		<TRIO_INFO>
			<TRAN name="obrtp_tran_032r" title="출납_최근이체계좌조회" realdata="0" dessvr="9" >
				<TRBLOCK name="InBlock1" inout="in" _len="173" _ulen="129" >

ACNO^계좌번호^8^0^0^0^0^0^0
ASNO^계좌일련번호^2^0^0^0^0^0^0
TACT_PROS_YN^이체처리여부^1^0^0^0^0^0^0
IQRY_CLS_CODE^조회구분코드^1^0^0^0^0^0^0

				</TRBLOCK>
				<TRBLOCK name="OutBlock1" occurs="50" inout="out" _len="247" _ulen="193" >

TACT_DATE^이체일자^8^0^0^0^0^0^0
BANK_CODE^은행코드^3^0^0^0^0^0^0
BANK_NAME^은행명^40^0^0^0^0^0^0
BANK_ACNO^은행계좌번호^16^0^0^0^0^0^0
RMT_NAME^수취인명^40^0^0^0^0^0^0
UTLZ_REG_YN^이용등록여부^1^0^0^0^0^0^0

				</TRBLOCK>
			</TRAN>
		</TRIO_INFO>
